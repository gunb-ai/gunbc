namespace gunbc.auth.tracker_web_oauth_redirect_uri_witness

import gunbc.auth.tracker_web_oauth_client {
  tracker_web_test_srv2_redirect_uri,
  tracker_web_stage_srv1_redirect_uri,
  tracker_web_test_lab_srv1_redirect_uri
}
import gunbc.hostname_allocation { HostnameAllocation, fleet_machine_srv1, fleet_machine_srv2, allocated_canonical_hostname }
import gunbc.product.host_identity { HostIdentity }
import gunbc.registry.claim_result { ClaimResult }
import gunbc.text.string_utils { contains_text }

# W2 name-witness for the tracker OAuth redirect URIs (P4, fleet_machine_authority).
#
# Each desired redirect URI must derive its host from the machine's canonical registry NAME, not a
# handle or a literal. Renaming srv1 or srv2 in the registry changes the host component of the
# matching URI through allocated_canonical_hostname; restoring the old "srvN_host.identity as String"
# handle cast, or a hard-coded host string, would leave the host pinned while the registry name moves,
# and these claims then refuse. Byte-identical while the registry still says srv1/srv2.

fn expected_redirect_host(allocation: HostnameAllocation) -> String {
  allocated_canonical_hostname(allocation: allocation) as String
}

fn redirect_uri_host_ok(uri: NonEmptyStr, allocation: HostnameAllocation) -> Bool {
  contains_text(
    needle: "//" + expected_redirect_host(allocation: allocation) + ".",
    haystack: uri
  )
}

claim tracker_web_oauth_redirect_uri_name_witness(): ClaimResult {
  match tracker_web_test_srv2_redirect_uri {
    Present{value: uri} =>
      if redirect_uri_host_ok(uri: uri, allocation: fleet_machine_srv2)
        then success
        else refusal(reason: "the test_srv2 redirect URI does not carry srv2's canonical registry host")
    Absent => refusal(reason: "the test_srv2 redirect URI is Absent")
  }
}

claim tracker_web_oauth_redirect_uri_srv1_witness(): ClaimResult {
  match tracker_web_stage_srv1_redirect_uri {
    Present{value: uri} =>
      if redirect_uri_host_ok(uri: uri, allocation: fleet_machine_srv1)
        then success
        else refusal(reason: "the stage_srv1 redirect URI does not carry srv1's canonical registry host")
    Absent => refusal(reason: "the stage_srv1 redirect URI is Absent")
  }
}
