module test.claim.harness_seat_witness

import std.types { Bool, String, Int, NonEmptyStr }
import std.measure { second_count }
import gunbc.serving.rented_replica { RentedReplicaIdentity, rented_replica_wire }
import gunbc.serving.turn_admission { ServingCoTenancyClass, InteractiveQualitySensitive, BatchQualityTolerant }
import std.resource_release_law { QuiescenceRequired, FencedResource }
import gunbc.harness.harness_seat {
  harness_seat_partition, SeatCeilingByDeclaredPolicy, AdmissionCeilingUnestablished,
  harness_seat_capacity_for, harness_interactive_quality_seats, harness_seat_reference,
  harness_placement_rounds, harness_seat_retry_law,
}
import gunbc.serving.serving_enrollment { ServingRoute, ServingRouteUnresolved, serving_replica_route, CeilingByDeclaredPolicy }
import gunbc.harness.harness_cli {
  harness_seat_policy, harness_request_deadline, harness_seat_release_allowance_seconds,
}

// A REPLICA AS FIXTURE. No replica is enrolled in production until one is rented, so the seat-ceiling
// algebra is the subject here and the route is supplied, built through serving_replica_route; the
// inhabitance that production enrolls none is test.claim.serving_routing_witness
// no_replica_is_enrolled_until_one_is_rented.
data w_replica: RentedReplicaIdentity = RentedReplicaIdentity { node: "rental-1" as NonEmptyStr, device_index: 0, served_name: "qwen-first-row" as NonEmptyStr }

data w_route_declared_ceiling: Int = 8

fn fixture_replica_route() -> ServingRoute {
  serving_replica_route(
    replica: w_replica,
    address: "10.0.0.7" as NonEmptyStr,
    port: 8000,
    ceiling: CeilingByDeclaredPolicy {
      count: 8, decider: "fixture" as NonEmptyStr, decided_on: "2026-10-12" as NonEmptyStr, basis: "witness fixture allocation" as NonEmptyStr,
    },
  )
}

fn w_ceiling() -> Int {
  match harness_seat_capacity_for(route: fixture_replica_route(), class: InteractiveQualitySensitive) {
    SeatCeilingByDeclaredPolicy { class: _, pool: p, seats: _ } => p.ledger.appropriation.ceiling.count
    AdmissionCeilingUnestablished { replica: _, cause: _ } => -1
  }
}

fn w_tolerant_ceiling() -> Int {
  match harness_seat_capacity_for(route: fixture_replica_route(), class: BatchQualityTolerant) {
    SeatCeilingByDeclaredPolicy { class: _, pool: p, seats: _ } => p.ledger.appropriation.ceiling.count
    AdmissionCeilingUnestablished { replica: _, cause: _ } => -1
  }
}

test fn each_replica_has_its_own_partition() -> Bool {
  (harness_seat_partition(replica: w_replica, class: InteractiveQualitySensitive, ceiling: harness_interactive_quality_seats) as String)
    == join(["replica-", rented_replica_wire(id: w_replica), "-quality-seat-v1"], "")
}

// THE SEAT CEILING IS A QUALITY POLICY, NOT A CAPACITY CLAIM, AND NOT THE ROUTE'S ALLOCATION. The
// quality ceiling is one by product decision about what a turn being read may be subjected to; the
// route's allocation is a different number for a different class. Asserting them different makes a
// build that re-read the quality ceiling off the route red.
test fn the_quality_ceiling_is_one_and_is_not_the_routes_allocation() -> Bool {
  harness_interactive_quality_seats == 1
    && w_ceiling() == 1
    && w_ceiling() != w_tolerant_ceiling()
}

test fn the_tolerant_pool_ceiling_is_the_routes_declared_allocation() -> Bool {
  w_tolerant_ceiling() == w_route_declared_ceiling
}

test fn an_unresolved_route_establishes_no_ceiling_and_names_its_replica() -> Bool {
  (match harness_seat_capacity_for(route: ServingRouteUnresolved { replica: w_replica, obligation: "probe" as NonEmptyStr }, class: InteractiveQualitySensitive) {
     AdmissionCeilingUnestablished { replica: r, cause: c } => (c as String) == "probe" && rented_replica_wire(id: r) == rented_replica_wire(id: w_replica)
     SeatCeilingByDeclaredPolicy { class: _, pool: _, seats: _ } => false
   })
}

// THE SEAT DEADLINE IS THE DECLARED REQUEST DEADLINE PLUS THE RELEASE ALLOWANCE, and the release
// law is quiescence-required, because the engine cannot fence a superseded holder.
test fn placement_rounds_are_the_retry_laws_whole_history_bound() -> Bool {
  harness_placement_rounds == harness_seat_retry_law.real_work_failure_bound
}

test fn the_seat_policy_is_declared_from_the_request_deadline_and_requires_quiescence() -> Bool {
  harness_seat_policy.maximum_duration_seconds == second_count(s: harness_request_deadline) + harness_seat_release_allowance_seconds
    && (match harness_seat_policy.release_law { QuiescenceRequired => true  FencedResource => false })
}

// ── AN ACQUISITION REFERENCE IS UNIQUE FOR THE LIFE OF THE PARTITION ──────────────────────────
//
// The pool refuses a duplicate reference against its WHOLE history, released entries included. A
// reference of actor-plus-epoch-seconds therefore collides with itself the moment one actor places
// twice inside one second, and stays refused for that partition forever after.
//
// THE ROUND ORDINAL IS NOT ENOUGH, and this control says so with the case that proves it: TWO
// INDEPENDENT PLACEMENTS both start at round one, so an earlier spelling minted one reference twice
// for the same actor, offer and second and turned an ordinary lost race into a permanent refusal. The
// head the partition is at is what separates them -- it moves on every append, so the loser
// re-observes a head the winner wrote. The last pair below is the discriminating one: everything else
// held equal, two different heads must give two different references.
test fn an_acquisition_reference_separates_rounds_offers_and_processes() -> Bool {
  let a1 = harness_seat_reference(attempt: "worker:/w/one" as NonEmptyStr, offer_key: "group-a@100.5" as NonEmptyStr, now: 1757200000, round: 1, head: "aaa111" as NonEmptyStr) as String
  let a2 = harness_seat_reference(attempt: "worker:/w/one" as NonEmptyStr, offer_key: "group-a@100.5" as NonEmptyStr, now: 1757200000, round: 2, head: "aaa111" as NonEmptyStr) as String
  let b1 = harness_seat_reference(attempt: "worker:/w/one" as NonEmptyStr, offer_key: "group-b@200.5" as NonEmptyStr, now: 1757200000, round: 1, head: "aaa111" as NonEmptyStr) as String
  let c1 = harness_seat_reference(attempt: "worker:/w/two" as NonEmptyStr, offer_key: "group-a@100.5" as NonEmptyStr, now: 1757200000, round: 1, head: "aaa111" as NonEmptyStr) as String
  let moved = harness_seat_reference(attempt: "worker:/w/one" as NonEmptyStr, offer_key: "group-a@100.5" as NonEmptyStr, now: 1757200000, round: 1, head: "bbb222" as NonEmptyStr) as String
  let empty = harness_seat_reference(attempt: "worker:/w/one" as NonEmptyStr, offer_key: "group-a@100.5" as NonEmptyStr, now: 1757200000, round: 1, head: "empty" as NonEmptyStr) as String
  a1 != a2 && a1 != b1 && a1 != c1 && a2 != b1 && a2 != c1 && b1 != c1
    && a1 != moved && a1 != empty && moved != empty
}
