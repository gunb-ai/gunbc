module test.claim.tmp_census_report

import std.types { String, Bool, Int }
import v2.std.algebra { fold_list }
import gunbc.compile_diagnostic_census {
  CompileDiagnosticCensus, CompileDiagnosticCensusRow, CensusObserved, CensusNotRunnable,
  census_blocking_rows
}

fn row_label(r: CompileDiagnosticCensusRow) -> String {
  concat(r.diagnostic_class as String, concat(if r.blocking { "/BLOCK/" } else { "/adv/" }, concat(r.subject_name, " ")))
}

fn report_rows(source: String) -> String {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: rows } =>
      fold_list(
        xs: rows,
        empty: "",
        cons: fn(acc, r) { concat(acc, row_label(r: r)) },
      )
    CensusNotRunnable { cause: cause } => concat("NOT-RUNNABLE: ", cause)
  }
}

data red_src: String = "module probe_callable_transitive_reach\nimport extdeps.posix.identity { PosixUserId }\nimport std.types { String, Int, Map }\nfn reads(m: Map<String, Int>) -> Int {\n  match map_get(m, \"k\") {\n    Present { value: v } => v\n    Absent => 0\n  }\n}\n"

data green1_src: String = "module probe_callable_named_authority\nimport v2.std.collection { map_get }\nimport std.types { String, Int, Map }\nfn reads(m: Map<String, Int>) -> Int {\n  match map_get(m, \"k\") {\n    Accepted { value: inner } => 0\n    Rejected { diagnostics: _ } => 0\n  }\n}\n"

data green2_src: String = "module probe_callable_own_declaration\nimport std.types { String, Int, Map, Bool }\nfn map_has(m: Map<String, Bool>, key: String) -> Bool {\n  match map_get(m, key) {\n    Present { value: v } => v\n    Absent => false\n  }\n}\nfn asks(m: Map<String, Bool>) -> Bool { map_has(m: m, key: \"k\") }\n"

fn report() -> String {
  concat("RED[", concat(report_rows(source: red_src),
  concat("]\nGREEN1[", concat(report_rows(source: green1_src),
  concat("]\nGREEN2[", concat(report_rows(source: green2_src), "]"))))))
}
