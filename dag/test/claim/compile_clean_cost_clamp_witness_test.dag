module test.claim.compile_clean_cost_clamp_witness


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data compile_clean_cost_clamp_witness_note: String = "Executing consumer for the compile-clean leg clamp (gunbc.ci_spec gunbc_ci_compile_clean_clamp_note — the prelude-coverage follow-up (a) first slice). THE PAIR IS THE PROOF (the witness_row_cost_drift discipline): a wall one millisecond over the computed clamp MUST exceed and the clamp value itself MUST NOT — either alone is satisfiable by a broken comparator. The formula pins (overhead*1000 + units*rate) keep claim_executor's Rust mirror honest: the executor reads the same two constants through the plan context and computes the same arithmetic, so a drifted mirror shows up here as a wrong pinned value. The 258000ms control is the observed basis run (30602520347, srv1-01, ~1648-unit whole-tree entry closure post-#7490) sitting WITHIN the clamp — the clamp reds runaways, not the healthy wall it was sized from. Runtime enforcement receipt: target/floor-compile-clean-wall-receipt.txt; RED control GUNBC_FLOOR_COMPILE_CLEAN_BUDGET_TIGHTEN_MS (min-only)."

test fn compile_clean_clamp_formula_whole_tree_pins() -> Bool {
  gunbc_ci_compile_clean_clamp_ms(units: 1648) == 587360
}

test fn compile_clean_clamp_formula_zero_units_is_overhead() -> Bool {
  gunbc_ci_compile_clean_clamp_ms(units: 0) == gunbc_ci_compile_clean_clamp_overhead_seconds() * 1000
}

test fn compile_clean_clamp_red_control_over_by_one_exceeds() -> Bool {
  gunbc_ci_compile_clean_wall_exceeds_clamp(observed_ms: 587361, units: 1648)
}

test fn compile_clean_clamp_boundary_at_clamp_does_not_exceed() -> Bool {
  !gunbc_ci_compile_clean_wall_exceeds_clamp(observed_ms: 587360, units: 1648)
}

test fn compile_clean_clamp_observed_basis_run_within() -> Bool {
  !gunbc_ci_compile_clean_wall_exceeds_clamp(observed_ms: 258000, units: 1648)
}

test fn compile_clean_clamp_overhead_positive() -> Bool {
  gunbc_ci_compile_clean_clamp_overhead_seconds() > 0
}

test fn compile_clean_clamp_rate_nonneg() -> Bool {
  gunbc_ci_compile_clean_clamp_rate_per_unit_ms() >= 0
}
