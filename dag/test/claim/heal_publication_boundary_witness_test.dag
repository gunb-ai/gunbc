module test.claim.heal_publication_boundary_witness

import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.optional { Present, Absent }
import std.types { String, NonEmptyStr, Bool, Int, CommitSha, List }
import std.content_hash { Sha1Digest, Sha1DigestHex }
import extdeps.github.effect { RepositoryPath }
import extdeps.github.workflow_runs { WorkflowRunConclusion, Success, Failure }
import extdeps.github.git_database { GitTreeItemWire }
import extdeps.git.object_store { GitObjectId, GitSha1ObjectId, GitTreeMode, GitRegularBlobMode, GitExecutableBlobMode }
import gunbc.heal_publication_boundary {
  PhaseCredentialStanding, PhasesIsolated,
  CandidatePhaseHoldsPublicationCredential, PublicationPhaseExecutesCandidateCode,
  phase_isolation, phases_are_isolated,
  CandidateEntry, HealRepairCandidate,
  encode_heal_repair_candidate, decode_heal_repair_candidate, CandidateDecode, CandidateDecoded, CandidateUndecodable,
  PublisherPathPolicy, publisher_path_policy, PathAdmission, PathAdmitted, PathAdmissionRefused, publisher_path_admission,
  TriggeringRunFacts, PullRequestFacts, ProposedBlobObservation, ProposedBlobComputed, ProposedBlobReadRefused,
  PublisherObservations, AdmittedHealPublication, HealPublicationAdmission, HealPublicationAdmitted, HealPublicationRefused,
  admit_heal_publication, heal_publication_refusal_token,
  HealPublicationRefusal,
  PublicationReadback, HealPublicationOutcome, HealPublished, HealPublicationWriteRefused, HealPublicationUnverified,
  publication_readback_verdict, heal_publication_is_published
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// ── fixtures: one consistent world, and each refusal changes exactly one fact of it ─────────

data head_hex: String = "1111111111111111111111111111111111111111"
data base_blob_hex: String = "2222222222222222222222222222222222222222"
data proposed_hex: String = "3333333333333333333333333333333333333333"
data other_hex: String = "4444444444444444444444444444444444444444"
data created_commit_hex: String = "5555555555555555555555555555555555555555"
data created_tree_hex: String = "6666666666666666666666666666666666666666"
data branch: String = "session/some-lane"

fn oid(hex: String) -> GitObjectId {
  GitSha1ObjectId { digest: Sha1Digest { hex: hex as Sha1DigestHex } }
}

fn design_entry(mode: GitTreeMode, base: GitObjectId?, proposed: String) -> CandidateEntry {
  CandidateEntry { path: RepositoryPath { value: "DESIGN.md" }, mode: mode, base_blob: base, proposed_blob: oid(hex: proposed) }
}

fn good_entry() -> CandidateEntry {
  design_entry(mode: GitRegularBlobMode, base: Present { value: oid(hex: base_blob_hex) }, proposed: proposed_hex)
}

fn candidate_with(entries: List<CandidateEntry>, declaration: String) -> HealRepairCandidate {
  HealRepairCandidate {
    repository_full_name: "gunb-ai/gunbc",
    pull_number: 11493,
    head_ref: branch as NonEmptyStr,
    expected_head_sha: head_hex as CommitSha,
    base_ref: "main",
    producer_run_id: "35246745255",
    repair_declaration: declaration,
    entries: entries
  }
}

fn good_candidate() -> HealRepairCandidate {
  candidate_with(entries: [good_entry()], declaration: "Ledger-Repaired: DESIGN.md\n")
}

// Main's committed artifact paths, including a workflow projection the publisher must never admit.
fn main_policy() -> PublisherPathPolicy {
  publisher_path_policy(committed_artifact_paths: ["DESIGN.md", "ROADMAP.md", ".github/workflows/witnesses.yml"])
}

fn good_run() -> TriggeringRunFacts {
  TriggeringRunFacts {
    workflow_path: ".github/workflows/heal.yml",
    originating_event: "pull_request",
    conclusion: Success,
    head_sha: head_hex,
    head_branch: branch,
    head_repository_full_name: "gunb-ai/gunbc",
    repository_full_name: "gunb-ai/gunbc"
  }
}

fn good_pull() -> PullRequestFacts {
  PullRequestFacts { number: 11493, open: true, head_ref: branch, base_ref: "main" }
}

fn design_base_item(mode: String) -> GitTreeItemWire {
  GitTreeItemWire { path: "DESIGN.md", mode: mode, type: "blob", sha: base_blob_hex, size: Present { value: 10 } }
}

fn observations_with(
  run: TriggeringRunFacts,
  pull: PullRequestFacts,
  branch_head: String,
  base_tree: List<GitTreeItemWire>,
  blobs: List<ProposedBlobObservation>
) -> PublisherObservations {
  PublisherObservations {
    repository_full_name: "gunb-ai/gunbc",
    default_branch: "main",
    heal_workflow_path: ".github/workflows/heal.yml",
    run: run,
    pull_request: pull,
    branch_head_sha: branch_head,
    base_tree_sha: "7777777777777777777777777777777777777777",
    base_tree_truncated: false,
    base_tree: base_tree,
    proposed_blobs: blobs
  }
}

fn good_blobs() -> List<ProposedBlobObservation> {
  [ProposedBlobComputed { blob_hex: proposed_hex, computed_hex: proposed_hex }]
}

fn good_observations() -> PublisherObservations {
  observations_with(run: good_run(), pull: good_pull(), branch_head: head_hex, base_tree: [design_base_item(mode: "100644")], blobs: good_blobs())
}

fn refusal_of(a: HealPublicationAdmission) -> String {
  match a {
    HealPublicationAdmitted { admitted: _ } => "admitted"
    HealPublicationRefused { refusal } => heal_publication_refusal_token(r: refusal) as String
  }
}

fn admit_with(c: HealRepairCandidate, o: PublisherObservations) -> String {
  refusal_of(a: admit_heal_publication(candidate: c, observations: o, policy: main_policy()))
}

// ── isolation, both directions ──────────────────────────────────────────────────────────────

// THE POSITIVE CONTROL. Isolation must be achievable, or the two violation arms below are
// satisfied by a predicate that never admits anything.
test fn witness_isolated_phases_are_admitted() -> Bool {
  phases_are_isolated(s: phase_isolation(
    candidate_holds_publication_credential: false, candidate_credential_detail: "none",
    publication_executes_candidate_code: false, publication_execution_detail: "none"
  ))
}

// gunbc#10887's first violation: a PR-controlled job federated to Secret Manager and read a
// long-lived App private key.
test fn witness_candidate_phase_holding_the_credential_is_a_violation() -> Bool {
  match phase_isolation(
    candidate_holds_publication_credential: true, candidate_credential_detail: "App private key read in the pull_request job",
    publication_executes_candidate_code: false, publication_execution_detail: "none"
  ) {
    CandidatePhaseHoldsPublicationCredential { detail } => detail == "App private key read in the pull_request job"
    PhasesIsolated => false
    PublicationPhaseExecutesCandidateCode { detail: _ } => false
  }
}

// THE SECOND DIRECTION IS A SEPARATE ARM, and stating only the first would admit a publisher that
// checks out the branch it publishes.
test fn witness_publisher_executing_candidate_code_is_a_distinct_violation() -> Bool {
  match phase_isolation(
    candidate_holds_publication_credential: false, candidate_credential_detail: "none",
    publication_executes_candidate_code: true, publication_execution_detail: "publisher checked out the PR head"
  ) {
    PublicationPhaseExecutesCandidateCode { detail } => detail == "publisher checked out the PR head"
    PhasesIsolated => false
    CandidatePhaseHoldsPublicationCredential { detail: _ } => false
  }
}

// ── the candidate wire ──────────────────────────────────────────────────────────────────────

// THE ROUND TRIP IS THE POSITIVE CONTROL FOR EVERY DECODE REFUSAL BELOW: a decoder that refused
// everything would satisfy each of them.
test fn witness_an_encoded_candidate_decodes_to_itself() -> Bool {
  match decode_heal_repair_candidate(text: encode_heal_repair_candidate(c: good_candidate())) {
    CandidateUndecodable { refusal: _ } => false
    CandidateDecoded { candidate } =>
      candidate.pull_number == 11493
        && (candidate.head_ref as String) == branch
        && (candidate.expected_head_sha as String) == head_hex
        && count(candidate.entries) == 1
        && candidate.repair_declaration == "Ledger-Repaired: DESIGN.md\n"
  }
}

test fn witness_an_unknown_candidate_format_refuses_by_name() -> Bool {
  match decode_heal_repair_candidate(text: "{\"format\":\"gunbc.heal_repair_candidate/0\"}") {
    CandidateUndecodable { refusal } => heal_publication_refusal_token(r: refusal) == "CandidateFormatUnsupported"
    CandidateDecoded { candidate: _ } => false
  }
}

// A blob id names the file the publisher reads, so a non-canonical spelling must refuse rather than
// be folded into a second name for the same object.
test fn witness_an_uppercase_blob_id_refuses() -> Bool {
  let text = encode_heal_repair_candidate(c: good_candidate())
  let upper = replace(s: text, from: proposed_hex, to: "333333333333333333333333333333333333333A")
  match decode_heal_repair_candidate(text: upper) {
    CandidateUndecodable { refusal } => heal_publication_refusal_token(r: refusal) == "CandidateMemberMalformed"
    CandidateDecoded { candidate: _ } => false
  }
}

// ── the publisher's own path policy ─────────────────────────────────────────────────────────

test fn witness_a_path_in_mains_registry_is_admitted() -> Bool {
  match publisher_path_admission(policy: main_policy(), path: RepositoryPath { value: "DESIGN.md" }) {
    PathAdmitted => true
    PathAdmissionRefused { refusal: _ } => false
  }
}

// A WORKFLOW FILE IS REFUSED EVEN THOUGH MAIN REGISTERS IT, because no automation may write the one
// path whose contents decide what later runs may do.
test fn witness_a_registered_workflow_projection_requires_an_author_commit() -> Bool {
  match publisher_path_admission(policy: main_policy(), path: RepositoryPath { value: ".github/workflows/witnesses.yml" }) {
    PathAdmitted => false
    PathAdmissionRefused { refusal } => heal_publication_refusal_token(r: refusal) == "PathRequiresAuthorCommit"
  }
}

// THE DECISIVE ARM FOR THE PERMIT RULE. The policy is main's registry; a path the branch might call
// generated is refused when main's registry does not contain it.
test fn witness_a_path_outside_mains_registry_is_refused() -> Bool {
  match publisher_path_admission(policy: main_policy(), path: RepositoryPath { value: "src/v1/stage0/src/main.rs" }) {
    PathAdmitted => false
    PathAdmissionRefused { refusal } => heal_publication_refusal_token(r: refusal) == "PathNotPublisherAdmitted"
  }
}

// ── admission: one consistent world, then one fact changed at a time ────────────────────────

test fn witness_a_consistent_candidate_is_admitted() -> Bool {
  match admit_heal_publication(candidate: good_candidate(), observations: good_observations(), policy: main_policy()) {
    HealPublicationRefused { refusal: _ } => false
    HealPublicationAdmitted { admitted } =>
      count(admitted.entries) == 1
        && (admitted.expected_head_sha as String) == head_hex
        && string_contains(s: admitted.message as String, pattern: "Heal-Candidate-Run: 35246745255")
  }
}

test fn witness_a_run_of_another_workflow_is_refused() -> Bool {
  let run = good_run()
  admit_with(c: good_candidate(), o: observations_with(
    run: TriggeringRunFacts { workflow_path: ".github/workflows/evil.yml", originating_event: run.originating_event, conclusion: run.conclusion, head_sha: run.head_sha, head_branch: run.head_branch, head_repository_full_name: run.head_repository_full_name, repository_full_name: run.repository_full_name },
    pull: good_pull(), branch_head: head_hex, base_tree: [design_base_item(mode: "100644")], blobs: good_blobs()
  )) == "TriggeringRunNotTheHealWorkflow"
}

test fn witness_an_unsuccessful_heal_run_is_refused() -> Bool {
  let run = good_run()
  admit_with(c: good_candidate(), o: observations_with(
    run: TriggeringRunFacts { workflow_path: run.workflow_path, originating_event: run.originating_event, conclusion: Failure, head_sha: run.head_sha, head_branch: run.head_branch, head_repository_full_name: run.head_repository_full_name, repository_full_name: run.repository_full_name },
    pull: good_pull(), branch_head: head_hex, base_tree: [design_base_item(mode: "100644")], blobs: good_blobs()
  )) == "TriggeringRunNotSuccessful"
}

// A candidate carried by a run about ANOTHER head is not a description of that run's subject.
test fn witness_a_candidate_for_a_head_its_run_did_not_judge_is_refused() -> Bool {
  let run = good_run()
  admit_with(c: good_candidate(), o: observations_with(
    run: TriggeringRunFacts { workflow_path: run.workflow_path, originating_event: run.originating_event, conclusion: run.conclusion, head_sha: other_hex, head_branch: run.head_branch, head_repository_full_name: run.head_repository_full_name, repository_full_name: run.repository_full_name },
    pull: good_pull(), branch_head: head_hex, base_tree: [design_base_item(mode: "100644")], blobs: good_blobs()
  )) == "TriggeringRunSubjectDisagreed"
}

// A FORK'S RUN NEVER REACHES A WRITE: the head repository is read from the event, not the candidate.
test fn witness_a_run_from_another_head_repository_is_refused() -> Bool {
  let run = good_run()
  admit_with(c: good_candidate(), o: observations_with(
    run: TriggeringRunFacts { workflow_path: run.workflow_path, originating_event: run.originating_event, conclusion: run.conclusion, head_sha: run.head_sha, head_branch: run.head_branch, head_repository_full_name: "someone/fork", repository_full_name: run.repository_full_name },
    pull: good_pull(), branch_head: head_hex, base_tree: [design_base_item(mode: "100644")], blobs: good_blobs()
  )) == "TriggeringRunRepositoryDisagreed"
}

test fn witness_a_closed_pull_request_is_refused() -> Bool {
  admit_with(c: good_candidate(), o: observations_with(
    run: good_run(), pull: PullRequestFacts { number: 11493, open: false, head_ref: branch, base_ref: "main" },
    branch_head: head_hex, base_tree: [design_base_item(mode: "100644")], blobs: good_blobs()
  )) == "PullRequestNotOpen"
}

test fn witness_a_pull_request_into_another_base_is_refused() -> Bool {
  admit_with(c: good_candidate(), o: observations_with(
    run: good_run(), pull: PullRequestFacts { number: 11493, open: true, head_ref: branch, base_ref: "release" },
    branch_head: head_hex, base_tree: [design_base_item(mode: "100644")], blobs: good_blobs()
  )) == "BaseRefNotTheDefaultBranch"
}

// THE COMPARE-AND-SWAP'S FIRST HALF. The fast-forward-only reference write is its second.
test fn witness_a_moved_branch_head_is_refused() -> Bool {
  admit_with(c: good_candidate(), o: observations_with(
    run: good_run(), pull: good_pull(), branch_head: other_hex, base_tree: [design_base_item(mode: "100644")], blobs: good_blobs()
  )) == "HeadMoved"
}

test fn witness_a_branch_name_that_would_misaddress_a_rest_path_is_refused() -> Bool {
  let run = good_run()
  let hashed = HealRepairCandidate {
    repository_full_name: "gunb-ai/gunbc", pull_number: 11493, head_ref: "lane#1", expected_head_sha: head_hex as CommitSha,
    base_ref: "main", producer_run_id: "35246745255", repair_declaration: "Ledger-Repaired: DESIGN.md\n", entries: [good_entry()]
  }
  admit_with(c: hashed, o: observations_with(
    run: TriggeringRunFacts { workflow_path: run.workflow_path, originating_event: run.originating_event, conclusion: run.conclusion, head_sha: run.head_sha, head_branch: "lane#1", head_repository_full_name: run.head_repository_full_name, repository_full_name: run.repository_full_name },
    pull: PullRequestFacts { number: 11493, open: true, head_ref: "lane#1", base_ref: "main" },
    branch_head: head_hex, base_tree: [design_base_item(mode: "100644")], blobs: good_blobs()
  )) == "HeadRefNotAddressable"
}

// A COMMIT MUST SAY WHAT IT REPAIRED. An empty declaration is a zero-repairs record over an unstated
// population.
test fn witness_a_candidate_without_a_repair_declaration_is_refused() -> Bool {
  admit_with(c: candidate_with(entries: [good_entry()], declaration: "  \n"), o: good_observations()) == "RepairDeclarationMissing"
}

// NOTHING TO WRITE IS NOT A SUCCESSFUL PUBLICATION.
test fn witness_an_empty_candidate_is_refused() -> Bool {
  admit_with(c: candidate_with(entries: [], declaration: "Ledger-Repaired: DESIGN.md\n"), o: good_observations()) == "CandidateEntriesEmpty"
}

test fn witness_a_duplicated_path_is_refused() -> Bool {
  admit_with(c: candidate_with(entries: [good_entry(), good_entry()], declaration: "Ledger-Repaired: DESIGN.md\n"), o: good_observations()) == "PathPopulationDuplicated"
}

// A candidate's base must be the head GitHub reports, or its repair is relative to some other tree.
test fn witness_a_candidate_whose_base_blob_disagrees_with_the_head_is_refused() -> Bool {
  admit_with(
    c: candidate_with(entries: [design_entry(mode: GitRegularBlobMode, base: Present { value: oid(hex: other_hex) }, proposed: proposed_hex)], declaration: "Ledger-Repaired: DESIGN.md\n"),
    o: good_observations()
  ) == "BaseBlobDisagreed"
}

// The publisher never changes a mode: an executable claim for a regular file refuses.
test fn witness_a_mode_change_is_refused() -> Bool {
  admit_with(
    c: candidate_with(entries: [design_entry(mode: GitExecutableBlobMode, base: Present { value: oid(hex: base_blob_hex) }, proposed: proposed_hex)], declaration: "Ledger-Repaired: DESIGN.md\n"),
    o: good_observations()
  ) == "FileModeNotAdmitted"
}

// An ABSENT path may be ADDED, and only as a regular file. The positive control is the added regular
// file; the executable variant refuses.
test fn witness_an_absent_path_may_be_added_only_as_a_regular_file() -> Bool {
  let added_regular = admit_with(
    c: candidate_with(entries: [design_entry(mode: GitRegularBlobMode, base: none, proposed: proposed_hex)], declaration: "Ledger-Repaired: DESIGN.md\n"),
    o: observations_with(run: good_run(), pull: good_pull(), branch_head: head_hex, base_tree: [], blobs: good_blobs())
  )
  let added_executable = admit_with(
    c: candidate_with(entries: [design_entry(mode: GitExecutableBlobMode, base: none, proposed: proposed_hex)], declaration: "Ledger-Repaired: DESIGN.md\n"),
    o: observations_with(run: good_run(), pull: good_pull(), branch_head: head_hex, base_tree: [], blobs: good_blobs())
  )
  added_regular == "admitted" && added_executable == "FileModeNotAdmitted"
}

test fn witness_an_entry_that_changes_nothing_is_refused() -> Bool {
  admit_with(
    c: candidate_with(entries: [design_entry(mode: GitRegularBlobMode, base: Present { value: oid(hex: base_blob_hex) }, proposed: base_blob_hex)], declaration: "Ledger-Repaired: DESIGN.md\n"),
    o: observations_with(run: good_run(), pull: good_pull(), branch_head: head_hex, base_tree: [design_base_item(mode: "100644")],
      blobs: [ProposedBlobComputed { blob_hex: base_blob_hex, computed_hex: base_blob_hex }])
  ) == "EntryProposesNoChange"
}

// THE BYTES MUST HASH TO THE ID THEY CLAIM. A single changed byte changes the recomputed id.
test fn witness_bytes_that_do_not_hash_to_the_claimed_blob_are_refused() -> Bool {
  admit_with(c: good_candidate(), o: observations_with(
    run: good_run(), pull: good_pull(), branch_head: head_hex, base_tree: [design_base_item(mode: "100644")],
    blobs: [ProposedBlobComputed { blob_hex: proposed_hex, computed_hex: other_hex }]
  )) == "ProposedBlobDisagreed"
}

test fn witness_an_unreadable_proposed_blob_is_refused() -> Bool {
  admit_with(c: good_candidate(), o: observations_with(
    run: good_run(), pull: good_pull(), branch_head: head_hex, base_tree: [design_base_item(mode: "100644")],
    blobs: [ProposedBlobReadRefused { blob_hex: proposed_hex, detail: "absent" }]
  )) == "ProposedBlobUnreadable"
}

test fn witness_a_candidate_naming_a_workflow_file_is_refused_whole() -> Bool {
  let workflow_entry = CandidateEntry {
    path: RepositoryPath { value: ".github/workflows/witnesses.yml" }, mode: GitRegularBlobMode,
    base_blob: Present { value: oid(hex: base_blob_hex) }, proposed_blob: oid(hex: proposed_hex)
  }
  admit_with(c: candidate_with(entries: [good_entry(), workflow_entry], declaration: "Ledger-Repaired: DESIGN.md\n"), o: good_observations()) == "PathRequiresAuthorCommit"
}

// ── what counts as evidence the publication happened ────────────────────────────────────────

fn admitted_design() -> AdmittedHealPublication? {
  match admit_heal_publication(candidate: good_candidate(), observations: good_observations(), policy: main_policy()) {
    HealPublicationAdmitted { admitted } => Present { value: admitted }
    HealPublicationRefused { refusal: _ } => none
  }
}

fn readback_with(branch_head: String, parents: List<String>, tree: String, changed: List<String>, head_tree: List<GitTreeItemWire>) -> PublicationReadback {
  PublicationReadback {
    branch_head_sha: branch_head,
    head_parents: parents,
    head_tree_sha: tree,
    changed_paths: changed,
    comparison_truncated: false,
    head_tree_truncated: false,
    head_tree: head_tree
  }
}

fn published_design_item() -> GitTreeItemWire {
  GitTreeItemWire { path: "DESIGN.md", mode: "100644", type: "blob", sha: proposed_hex, size: Present { value: 12 } }
}

fn verdict_token(readback: PublicationReadback) -> String {
  match admitted_design() {
    Absent => "no-admission"
    Present { value: admitted } =>
      match publication_readback_verdict(admitted: admitted, created_commit_sha: created_commit_hex, created_tree_sha: created_tree_hex, readback: readback) {
        HealPublished { receipt: _ } => "published"
        HealPublicationWriteRefused { refusal: _ } => "refused"
        HealPublicationUnverified { detail: _ } => "unverified"
      }
  }
}

test fn witness_a_confirmed_readback_is_published() -> Bool {
  verdict_token(readback: readback_with(branch_head: created_commit_hex, parents: [head_hex], tree: created_tree_hex, changed: ["DESIGN.md"], head_tree: [published_design_item()])) == "published"
}

// A SUCCESSFUL WRITE IS NOT TERMINAL EVIDENCE: a branch that names another commit is unverified.
test fn witness_a_branch_naming_another_commit_is_unverified() -> Bool {
  verdict_token(readback: readback_with(branch_head: other_hex, parents: [head_hex], tree: created_tree_hex, changed: ["DESIGN.md"], head_tree: [published_design_item()])) == "unverified"
}

test fn witness_a_published_commit_with_another_parent_is_unverified() -> Bool {
  verdict_token(readback: readback_with(branch_head: created_commit_hex, parents: [other_hex], tree: created_tree_hex, changed: ["DESIGN.md"], head_tree: [published_design_item()])) == "unverified"
}

// EXACTLY THE ADMITTED DELTA. A published head that also changed a path nobody admitted is not the
// publication this transaction built.
test fn witness_a_changed_population_wider_than_the_admission_is_unverified() -> Bool {
  verdict_token(readback: readback_with(branch_head: created_commit_hex, parents: [head_hex], tree: created_tree_hex, changed: ["DESIGN.md", "ROADMAP.md"], head_tree: [published_design_item()])) == "unverified"
}

test fn witness_a_published_path_holding_another_blob_is_unverified() -> Bool {
  verdict_token(readback: readback_with(branch_head: created_commit_hex, parents: [head_hex], tree: created_tree_hex, changed: ["DESIGN.md"],
    head_tree: [GitTreeItemWire { path: "DESIGN.md", mode: "100644", type: "blob", sha: other_hex, size: Present { value: 12 } }])) == "unverified"
}
