module test.claim.namespace_reference_derived_closure_acceptance

import gunbc.namespace_reference_derived_closure_admission {
  assess_reference_binding_observation,
  ReferenceDerivedClosureUnavailable,
  RepeatedMentionsCollapseDependency,
  UnrelatedLoadedFileExcluded,
  P2aReferenceDependencyProjection7515,
  P2aPoolIndependentDependencyProjection7515,
}
import gunbc.namespace_reference_derived_closure_contract {
  reference_derived_closure_closing_contract_holds,
}
import v1.gunbc.namespace_reference_derived_closure_production_admissions {
  namespace_structural_binding_observations_a_through_d,
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.types { Bool, List }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data namespace_reference_derived_closure_acceptance_note: String = "THE DISCRIMINATING CLOSING VALIDATION for roadmap node namespace-reference-derived-closure. RED ON PURPOSE while clauses (e-f) remain unavailable. Governed placement: dag/test/claim (not src/v1/tests/claim) because SubstrateInputsOnly requires v2.std.live_tree, which the stage0 regen closure for src/v1/*.dag cannot import; this witness still executes on v1_claim_scoped_known_red_probe_batch via known_red_probe_v1_envelope_roster. Composition lives inline in this witness (operator ruling loyal-ram-550): the contract predicate is unchanged and takes admissions as a parameter; v1 production returns neutral ReferenceBindingObservation carriers only; this witness assesses at the seam. N3-A supplies structural clauses (a-d); clauses (e-f) remain literal Unavailable rows until N3-B/N3-C land."

test fn witness_namespace_reference_derived_closure_closing_contract_holds() -> Bool {
  let structural_admissions =
    namespace_structural_binding_observations_a_through_d()
      |> map(observation => assess_reference_binding_observation(observation: observation))
  reference_derived_closure_closing_contract_holds(
    admissions: concat(
      structural_admissions,
      [
        ReferenceDerivedClosureUnavailable {
          capability: RepeatedMentionsCollapseDependency,
          trigger: P2aReferenceDependencyProjection7515,
        },
        ReferenceDerivedClosureUnavailable {
          capability: UnrelatedLoadedFileExcluded,
          trigger: P2aPoolIndependentDependencyProjection7515,
        },
      ],
    ),
  )
}
