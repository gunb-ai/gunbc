module test.claim.claim_batch_unobserved_exit_witness

import std.types { Bool, String, FilePath, List }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.algebra { string_contains }
import extdeps.filesystem.filesystem_io { Filesystem }
import extdeps.git.inspect
import extdeps.gunbc
import extdeps.shell
import extdeps.rust.cargo { cargo_default_target_dir }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// WHY THIS IS WET. The property is the EXIT STATUS and OUTPUT SHAPE of the ONE CLAIM ROUTE
// (`gunbc test`) for the two ways an entry fails to reach its subject: an entry whose closure does
// not resolve is NO OBSERVATION (`UNOBSERVED outcome=ClosureDiagnostics`, exit 2), and a label that
// names no discovered claim is also NO OBSERVATION (`the pattern selected no discovered claim`, exit
// 2) -- distinguished by their outcome classes, so collapsing `ClosureDiagnostics` into the
// not-discovered arm, or either into a verdict, goes red on exactly one row. (Dated record: the
// deleted claim_batch read the closure error as a FINDING, exit 1 FAIL line; the route reads it as
// no observation.) The in-process unit tests cover the classification of a refusal and the
// composition of two bools; neither sees the CLI wiring that maps one to the other. Only a child
// process observes it.
//
// THE CLOSURE ERROR IS PLANTED, NEVER COMMITTED: a mktemp directory under target/, laid out as
// `test/claim/<module>.dag` (the route's discovery needs the path to match the module path), handed
// to the child as an extra --source-root. The entry body references an undeclared name,
// which is a closure diagnostic and not a host or infrastructure refusal. The finding arm also walks
// `dag`, because a verdict needs `gunbc.output_policy`; the exit-2 arm is refused at the CLI before
// any walk.

// The closure error is an UNRESOLVED REFERENCE IN THE BODY, not a broken import: a module whose
// import header does not resolve is dropped at DISCOVERY (the child then reports `selected no
// discovered claim`, which is the other arm below, and the ClosureDiagnostics class is never reached).
// Measured on the route: body-level unresolved reference -> discovered, evaluated, refused as
// `UNOBSERVED outcome=ClosureDiagnostics`, exit 2.
data closure_error_entry_source: String = "module test.claim.probe_closure_error_entry

test fn closure_error_entry_holds() -> Bool {
  zz_no_such_name == true
}
"

type PlantedClosureError
  = PlantedClosureErrorReady { dir: String }
  | PlantedClosureErrorUnwritable { detail: String }

fn plant_closure_error(root: String) -> PlantedClosureError {
  let dir = shell.Mktemp.DirWithTemplate(
    template: concat(cargo_default_target_dir(build_root: root), "/closure-error-planted-XXXXXX") as FilePath,
  )
  if !dir.success {
    PlantedClosureErrorUnwritable { detail: "mktemp under target/ failed" }
  } else {
    let planted = dir.path as String
    let d = concat(planted, "/test/claim")
    let mkdir = shell.Mkdir.Parents(path: d as FilePath)
    let e = mkdir.success && Filesystem.Write(path: concat(d, "/probe_closure_error_entry.dag"), content: closure_error_entry_source)
    if e {
      PlantedClosureErrorReady { dir: planted }
    } else {
      PlantedClosureErrorUnwritable { detail: "fixture write failed" }
    }
  }
}

// The finding arm must also walk `dag`: a verdict needs gunbc.output_policy, which resolves only
// from there (measured: without it the child refuses OUTPUT-POLICY REFUSAL, exit 1, before it ever
// reaches the entry, which would pass the exit-code assertion for the wrong reason, so the FAIL line
// is asserted too). The missing-entry arm is refused at the CLI before any resolve and needs only the
// planted root.
// THE ROUTE, NOT A BINARY OF ITS OWN (see claim_batch_exit_two_unobserved_witness): the planted
// modules live in the claim universe and the child is `gunbc test`. On the route a closure
// diagnostic is NO OBSERVATION (`UNOBSERVED outcome=ClosureDiagnostics`, exit 2) rather than the
// deleted binary's FAIL/exit-1 — the pair below pins the two failure CLASSES apart by their outcome
// kinds, which is what the two rows discriminate on the route.
fn closure_error_finding_args(dir: String) -> List<String> {
  [
    "test",
    "--source-root", "dag",
    "--source-root", "src/v2",
    "--source-root", dir,
    "//test/claim/probe_closure_error_entry:closure_error_entry_holds"
  ]
}

fn closure_error_missing_entry_args(dir: String) -> List<String> {
  [
    "test",
    "--source-root", "dag",
    "--source-root", "src/v2",
    "--source-root", dir,
    "//test/claim/probe_closure_no_such_entry:closure_error_entry_holds"
  ]
}

// The finding arm. An entry whose closure does not resolve must exit 1 with a FAIL line naming
// closure diagnostics, and must not read as no observation.
test fn an_entry_with_a_closure_error_exits_2_as_unobserved() -> Bool {
  let root = git.Inspect.Toplevel().path
  match plant_closure_error(root: root) {
    PlantedClosureErrorUnwritable { detail: _ } => false
    PlantedClosureErrorReady { dir } => {
      let result = gunbc.WitnessBin.Run(
        workdir: root,
        bin_path: concat(root, "/target/release/gunbc"),
        args: closure_error_finding_args(dir: dir)
      )
      let cleaned = shell.Remove.RecursiveForce(path: dir as FilePath)
      cleaned.success
        && result.exit_code == 2
        && string_contains(s: result.stdout, pattern: "closure_error_entry_holds UNOBSERVED")
        && string_contains(s: result.stdout, pattern: "outcome=ClosureDiagnostics")
        && string_contains(s: result.stdout, pattern: "undefined variable")
    }
  }
}

// The no-observation arm, and the positive control for the arm above: the same planted root with a
// label that names no claim must exit 2 with a located refusal on stdout. On the route the refusal
// reads `the pattern selected no discovered claim`; together the two rows fix the two no-observation
// CLASSES (a closure diagnostic vs. an unresolvable label), so a route that collapses every
// refusal into one line fails exactly one of them.
test fn a_nonexistent_entry_exits_2_with_a_located_refusal() -> Bool {
  let root = git.Inspect.Toplevel().path
  match plant_closure_error(root: root) {
    PlantedClosureErrorUnwritable { detail: _ } => false
    PlantedClosureErrorReady { dir } => {
      let result = gunbc.WitnessBin.Run(
        workdir: root,
        bin_path: concat(root, "/target/release/gunbc"),
        args: closure_error_missing_entry_args(dir: dir)
      )
      let cleaned = shell.Remove.RecursiveForce(path: dir as FilePath)
      cleaned.success
        && result.exit_code == 2
        && string_contains(s: result.stderr, pattern: "selected no discovered claim")
        && !string_contains(s: result.stdout, pattern: "DID-NOT-HOLD")
    }
  }
}
