module test.claim.gha_expression_roundtrip


data live_tree_disposition: LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn core_expr() -> extdeps.github.expressions.Expression {
  extdeps.github.expressions.LogicalOr {
    left: extdeps.github.expressions.LogicalOr {
      left: extdeps.github.expressions.FunctionCall {
        function: extdeps.github.expressions.HashFiles,
        args: [ extdeps.github.expressions.StringLiteral { value: "Cargo.lock" }, extdeps.github.expressions.StringLiteral { value: "Cargo.toml" } ],
      },
      right: extdeps.github.expressions.ContextAccess { context: extdeps.github.expressions.Github, path: ["event", "number"] },
    },
    right: extdeps.github.expressions.ContextAccess { context: extdeps.github.expressions.Runner, path: ["os"] },
  }
}

fn core_template() -> extdeps.github.expressions.ExpressionTemplate {
  extdeps.github.expressions.ExpressionTemplate {
    segments: [
      extdeps.github.expressions.LiteralText { text: "cargo-ci-" },
      Interpolation { expression: extdeps.github.expressions.ContextAccess { context: extdeps.github.expressions.Runner, path: ["os"] } },
      extdeps.github.expressions.LiteralText { text: "-" },
      Interpolation { expression: extdeps.github.expressions.ContextAccess { context: extdeps.github.expressions.Runner, path: ["arch"] } },
    ],
  }
}

fn witness_roundtrip_expression() -> Bool {
  match extdeps.github.expressions.ingest_expression(src: extdeps.github.expressions.serialize_expression(expression: core_expr())) {
    Present { value: v } => v == core_expr()
    Absent => false
  }
}

fn witness_roundtrip_template() -> Bool {
  match extdeps.github.expressions.ingest_template(src: extdeps.github.expressions.serialize_template(template: core_template())) {
    Present { value: v } => v == core_template()
    Absent => false
  }
}

fn override_spellings(path_sep: String, or_op: String) -> extdeps.github.expressions.ExpressionSpellings {
  extdeps.github.expressions.ExpressionSpellings {
    path_sep: path_sep,
    call_open: extdeps.github.expressions.default_expression_spellings.call_open,
    call_close: extdeps.github.expressions.default_expression_spellings.call_close,
    arg_sep: extdeps.github.expressions.default_expression_spellings.arg_sep,
    string_quote: extdeps.github.expressions.default_expression_spellings.string_quote,
    or_op: or_op,
    interp_open: extdeps.github.expressions.default_expression_spellings.interp_open,
    interp_close: extdeps.github.expressions.default_expression_spellings.interp_close,
  }
}

fn perturbed_path_sep() -> extdeps.github.expressions.ExpressionSpellings {
  override_spellings(path_sep: "->", or_op: extdeps.github.expressions.default_expression_spellings.or_op)
}

fn perturbed_or_op() -> extdeps.github.expressions.ExpressionSpellings {
  override_spellings(path_sep: extdeps.github.expressions.default_expression_spellings.path_sep, or_op: " OR ")
}

fn roundtrips_under(sp: extdeps.github.expressions.ExpressionSpellings) -> Bool {
  match extdeps.github.expressions.ingest_expression_with(src: extdeps.github.expressions.serialize_expression_with(expression: core_expr(), sp: sp), sp: sp) {
    Present { value: v } => v == core_expr()
    Absent => false
  }
}

fn witness_roundtrip_under_perturbed_rows() -> Bool {
  roundtrips_under(sp: perturbed_path_sep()) && roundtrips_under(sp: perturbed_or_op())
}

fn ingest_reads(sp: extdeps.github.expressions.ExpressionSpellings) -> Bool {
  match extdeps.github.expressions.ingest_expression(src: extdeps.github.expressions.serialize_expression_with(expression: core_expr(), sp: sp)) {
    Present { value: v } => !(v == core_expr())
    Absent => true
  }
}

fn witness_ingest_reads_rows() -> Bool {
  ingest_reads(sp: perturbed_path_sep()) && ingest_reads(sp: perturbed_or_op())
}

fn left_nested_or() -> extdeps.github.expressions.Expression {
  extdeps.github.expressions.LogicalOr {
    left: extdeps.github.expressions.LogicalOr {
      left: extdeps.github.expressions.ContextAccess { context: extdeps.github.expressions.Runner, path: ["os"] },
      right: extdeps.github.expressions.ContextAccess { context: extdeps.github.expressions.Runner, path: ["arch"] },
    },
    right: extdeps.github.expressions.ContextAccess { context: extdeps.github.expressions.Runner, path: ["temp"] },
  }
}

fn right_nested_or() -> extdeps.github.expressions.Expression {
  extdeps.github.expressions.LogicalOr {
    left: extdeps.github.expressions.ContextAccess { context: extdeps.github.expressions.Runner, path: ["os"] },
    right: extdeps.github.expressions.LogicalOr {
      left: extdeps.github.expressions.ContextAccess { context: extdeps.github.expressions.Runner, path: ["arch"] },
      right: extdeps.github.expressions.ContextAccess { context: extdeps.github.expressions.Runner, path: ["temp"] },
    },
  }
}

fn witness_or_associativity_partition() -> Bool {
  match extdeps.github.expressions.ingest_expression(src: extdeps.github.expressions.serialize_expression(expression: left_nested_or())) {
    Present { value: left_v } =>
      match extdeps.github.expressions.ingest_expression(src: extdeps.github.expressions.serialize_expression(expression: right_nested_or())) {
        Present { value: right_v } => (left_v == left_nested_or()) && !(right_v == right_nested_or())
        Absent => false
      }
    Absent => false
  }
}

fn frontier_string_with_or() -> extdeps.github.expressions.Expression {
  extdeps.github.expressions.StringLiteral { value: "a || b" }
}

fn frontier_nested_multiarg_call() -> extdeps.github.expressions.Expression {
  extdeps.github.expressions.FunctionCall {
    function: extdeps.github.expressions.Contains,
    args: [
      extdeps.github.expressions.ContextAccess { context: extdeps.github.expressions.Github, path: ["event"] },
      extdeps.github.expressions.FunctionCall {
        function: extdeps.github.expressions.Format,
        args: [
          extdeps.github.expressions.StringLiteral { value: "v" },
          extdeps.github.expressions.ContextAccess { context: extdeps.github.expressions.Runner, path: ["os"] },
          extdeps.github.expressions.ContextAccess { context: extdeps.github.expressions.Runner, path: ["arch"] },
        ],
      },
    ],
  }
}

fn witness_frontier_not_roundtripped() -> Bool {
  match extdeps.github.expressions.ingest_expression(src: extdeps.github.expressions.serialize_expression(expression: right_nested_or())) {
    Present { value: v1 } =>
      match extdeps.github.expressions.ingest_expression(src: extdeps.github.expressions.serialize_expression(expression: frontier_string_with_or())) {
        Present { value: v2 } =>
          match extdeps.github.expressions.ingest_expression(src: extdeps.github.expressions.serialize_expression(expression: frontier_nested_multiarg_call())) {
            Present { value: v3 } =>
              !(v1 == right_nested_or())
                && !(v2 == frontier_string_with_or())
                && !(v3 == frontier_nested_multiarg_call())
            Absent => true
          }
        Absent => true
      }
    Absent => true
  }
}

fn witness_core_advertised_lossless() -> Bool {
  match extdeps.github.expressions.ingest_expression(src: extdeps.github.expressions.serialize_expression(expression: core_expr())) {
    Present { value: v } => {
      let m = extdeps.communication.fidelity_carriers.source_medium_carried(carried: v, fidelity: Lossless)
      match m.fidelity {
        Lossless => m.carried == core_expr()
        Lossy => false
      }
    }
    Absent => false
  }
}

fn witness_emit_non_regression() -> Bool {
  let e = core_expr()
  let t = core_template()
  (extdeps.github.expressions.serialize_expression(expression: e) == extdeps.github.expressions.serialize_expression_with(expression: e, sp: extdeps.github.expressions.default_expression_spellings))
    && (extdeps.github.expressions.serialize_template(template: t) == extdeps.github.expressions.serialize_template_with(template: t, sp: extdeps.github.expressions.default_expression_spellings))
    && (extdeps.github.expressions.serialize_expression(expression: e) == "hashFiles('Cargo.lock', 'Cargo.toml') || github.event.number || runner.os")
    && (extdeps.github.expressions.serialize_template(template: t) == "cargo-ci-${{ runner.os }}-${{ runner.arch }}")
}

test fn gha_expression_roundtrip_keystone_holds() -> Bool {
  witness_roundtrip_expression()
    && witness_roundtrip_template()
    && witness_roundtrip_under_perturbed_rows()
    && witness_ingest_reads_rows()
    && witness_or_associativity_partition()
    && witness_frontier_not_roundtripped()
    && witness_core_advertised_lossless()
    && witness_emit_non_regression()
}
