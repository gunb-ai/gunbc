// SUPPLIED AT THE TRIP BOUNDARY: the account trip's stdout, in the wire shapes the press witnesses
// already pin (test.claim.codex_app_server_press). The healthy trip is a chatgpt/pro account with
// capacity left in the codex bucket; the exhausted one carries the live 2026-08-06 rateLimits
// capture verbatim (usedPercent 100, rate_limit_reached). The inhabitance of the trip itself -- the
// app-server run against the custody CODEX_HOME -- is the live exercise once custody lands.
data initialize_line: String = "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"userAgent\":\"x\"}}\n"
data account_read_line: String = "{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{\"account\":{\"type\":\"chatgpt\",\"planType\":\"pro\",\"email\":\"REDACTED@example.invalid\"},\"requiresOpenaiAuth\":true}}\n"
data rate_limits_capacity_line: String = "{\"jsonrpc\":\"2.0\",\"id\":3,\"result\":{\"rateLimits\":{\"limitId\":\"codex\",\"primary\":{\"usedPercent\":12},\"secondary\":{\"usedPercent\":3},\"spendControlReached\":false}}}\n"
data rate_limits_exhausted_line: String = "{\"jsonrpc\":\"2.0\",\"id\":3,\"result\":{\"rateLimits\":{\"limitId\":\"codex\",\"limitName\":null,\"primary\":{\"usedPercent\":100,\"windowDurationMins\":10080,\"resetsAt\":1786159940},\"secondary\":null,\"spendControlReached\":false,\"planType\":\"pro\",\"rateLimitReachedType\":\"rate_limit_reached\"}}}\n"

fn trip_evidence(rate_limits_line: String) -> CodexAccountStandingEvidence {
  parse_account_trip_stdout_for_tests(stdout: concat(initialize_line, concat(account_read_line, rate_limits_line)))
}

fn observed_codex_standing(rate_limits_line: String) -> ProviderStanding {
  match first_codex_instance(inventory: provider_inventory_for_instance(instance: srv2_lab_dashboard_instance())) {
    Absent => ProviderStandingUnobserved { reason: "no codex offer on srv2 lab" as NonEmptyStr }
    Present { value: provider } =>
      provider_standing_from_observed_bundle(
        fact_id: "witness-codex-harness-trip" as RecordedFactId,
        provider: provider,
        bundle: provider_standing_bundle_from_codex_account_evidence(
          evidence: trip_evidence(rate_limits_line: rate_limits_line),
          credential: codex_harness_credential_context(),
          installation: InstallationReady,
          tool_environment: ToolEnvironmentReady,
        ),
      )
  }
}

fn first_codex_instance(inventory: ProviderInventory) -> ProviderInstance? {
  fold(inventory.offers, init: none, f: (acc, offer) =>
    match acc {
      Present { value: _ } => acc
      Absent =>
        match offer {
          OfferCodex { offer: o } => Present { value: o.instance }
          OfferClaude { offer: _ } => acc
          OfferCursor { offer: _ } => acc
        }
    }
  )
}

fn codex_selection_reason(standing: ProviderStanding) -> String {
  match resolve_dispatch_selection(
    inventory: inventory_with_codex_state_root(
      inventory: inventory_with_observed_standing(inventory: provider_inventory_for_instance(instance: srv2_lab_dashboard_instance()), kind: CodexCliProvider, standing: standing),
      account_state_root: codex_worker_turn_codex_home as FilePath,
    ),
    request: provider_selection_request_for_kind(kind: CodexCliProvider),
    sizing_expectation: NoDerivedSizingExpectation,
  ) {
    DispatchSelectionResolved { receipt: _ } => "RESOLVED"
    DispatchSelectionRefused { sizing_expectation: _, requested_selection: _, reason } => reason as String
  }
}

// THE OBSERVED STANDING REACHES SELECTION. A healthy custody trip makes the codex offer eligible, so
// selection passes eligibility and stops at the next gate, the unobserved process fingerprint (kept by
// operator ruling D1, 2026-10-05, until the wet tmux observation on srv2 is taken). The exhausted trip
// is refused at eligibility instead, with a different reason. If the observation were not reaching
// selection, the two would refuse for the same reason.
test fn a_healthy_custody_trip_passes_eligibility_and_an_exhausted_one_does_not() -> Bool {
  let healthy = codex_selection_reason(standing: observed_codex_standing(rate_limits_line: rate_limits_capacity_line))
  let exhausted = codex_selection_reason(standing: observed_codex_standing(rate_limits_line: rate_limits_exhausted_line))
  healthy == (dispatch_codex_process_fingerprint_unobserved_selection_refusal as String)
    && exhausted != healthy
    && exhausted != "RESOLVED"
}

test fn the_exhausted_custody_trip_is_not_selection_eligible_and_the_healthy_one_is() -> Bool {
  provider_standing_is_selection_eligible(
    standing: observed_codex_standing(rate_limits_line: rate_limits_capacity_line),
    draw: LimitDispatchDrawAutomatic,
  )
    && !provider_standing_is_selection_eligible(
      standing: observed_codex_standing(rate_limits_line: rate_limits_exhausted_line),
      draw: LimitDispatchDrawAutomatic,
    )
}

// THE CODEX OFFER IS JUDGED ON THE CUSTODY CODEX_HOME, not the instance's ambient account state root,
// so changing the ambient login cannot change the verdict or the root the spawn binds.
test fn the_observed_codex_offer_names_the_custody_codex_home() -> Bool {
  let inventory = inventory_with_codex_state_root(
    inventory: inventory_with_observed_standing(inventory: provider_inventory_for_instance(instance: srv2_lab_dashboard_instance()), kind: CodexCliProvider, standing: observed_codex_standing(rate_limits_line: rate_limits_capacity_line)),
    account_state_root: codex_worker_turn_codex_home as FilePath,
  )
  any(inventory.offers, offer =>
    match offer {
      OfferCodex { offer: o } => (o.account_state_root as String) == (codex_worker_turn_codex_home as String)
      OfferClaude { offer: _ } => false
      OfferCursor { offer: _ } => false
    })
}

// CURSOR: a rejected key refuses naming the rejection; an accepted key is still not selectable,
// because entitlement waits on the one-word trip (D2). Neither arm is "available".
// The key probe's two wire shapes, observed on cursor-agent 2026.09.15-d2fe57e (srv2, 2026-10-17): the
// invalid CURSOR_API_KEY exits 1 with the marker on stderr; the valid custody key exits 0 with the header
// and model rows. SUPPLIED at the probe boundary; the inhabitance claim is the wet control that runs the real
// probe under a fresh root.
data observed_invalid_key_stderr: String = "The provided API key is invalid. The API key was loaded from the CURSOR_API_KEY environment variable
"
data observed_valid_key_stdout: String = "Available models

auto - Auto
"

// THE SANDBOX PREFLIGHT, supplied at its boundary. The unsupported reading is the srv2 capture of
// 2026-10-16 verbatim (cursor-agent 2026.09.15-d2fe57e, `sandbox run printenv CURSOR_SANDBOX`, exit
// 1). The ready reading is a SUPPLIED hypothesis -- no host has yet answered it; its inhabitance is
// the pinned srv2 realization's readback.
data observed_srv2_sandbox_unsupported_stdout: String = "Executing command: printenv CURSOR_SANDBOX\nWorking directory: /tmp/c1-trip.Ff9HV3/ws\nSandbox policy: {\n  \"type\": \"workspace_readwrite\",\n  \"readBoundary\": \"system\",\n  \"networkPolicy\": {\n    \"version\": 1,\n    \"default\": \"deny\"\n  },\n  \"additionalReadwritePaths\": [],\n  \"additionalReadonlyPaths\": [],\n  \"ignoreMapping\": {}\n}\nFailed to execute command: SandboxUnsupportedError: Sandbox policy 'workspace_readwrite' is not supported on this system. Ensure the sandbox helper binary is available, or use 'insecure_none'. Reason: Linux preflight failed with exit code 2 (unsupported kernel features). stderr: Error: Failed to resolve Linux sandbox backend: Unsupported sandbox configuration: Linux auto backend selection failed. Landlock error: Unsupported sandbox configuration: IO error: Step 1-2/7 (user namespace) failed: IO error: Failed to write /proc/self/uid_map (mapping UID 0 -> 1000): Operation not permitted (os error 1) (errno 1). Bubblewrap error: Unsupported sandbox configuration: IO error: Bubblewrap namespace setup failed: IO error: Failed to write /proc/self/uid_map (mapping UID 0 -> 1000): Operation not permitted (os error 1) (errno 1)\n"
data observed_srv2_sandbox_unsupported_stderr: String = "Error: command failed unexpectedly.\n"
data supplied_sandbox_entered_stdout: String = "Executing command: printenv CURSOR_SANDBOX\nWorking directory: /w\nSandbox policy: {\n  \"type\": \"workspace_readwrite\"\n}\nnative\n"
data supplied_sandbox_not_entered_stdout: String = "Executing command: printenv CURSOR_SANDBOX\nWorking directory: /w\nSandbox policy: {\n  \"type\": \"workspace_readwrite\"\n}\n"

fn sandbox_ready() -> CursorSandboxPreflightReading {
  cursor_sandbox_preflight_reading(exit_code: 0, stdout: supplied_sandbox_entered_stdout, stderr: "")
}

fn sandbox_unsupported_on_srv2() -> CursorSandboxPreflightReading {
  cursor_sandbox_preflight_reading(exit_code: 1, stdout: observed_srv2_sandbox_unsupported_stdout, stderr: observed_srv2_sandbox_unsupported_stderr)
}

test fn the_key_reading_never_makes_the_offer_selectable_before_the_entitlement_trip() -> Bool {
  let accepted = cursor_standing_from_key(key: cursor_key_probe_reading(exit_code: 0, stdout: observed_valid_key_stdout, stderr: ""))
  let rejected = cursor_standing_from_key(key: cursor_key_probe_reading(exit_code: 1, stdout: "", stderr: observed_invalid_key_stderr))
  let unreadable = cursor_standing_from_key(key: cursor_key_probe_reading(exit_code: 3, stdout: "", stderr: "boom"))
  let accepted_pending = match accepted {
    ProviderStandingUnobserved { reason } => reason == cursor_entitlement_trip_pending_reason
    ProviderStandingFromFact { fact: _ } => false
  }
  let rejected_named = match rejected {
    ProviderStandingUnobserved { reason } => string_contains(s: reason as String, pattern: "rejected the custody key")
    ProviderStandingFromFact { fact: _ } => false
  }
  let unreadable_named = match unreadable {
    ProviderStandingUnobserved { reason } => string_contains(s: reason as String, pattern: "key probe exited 3")
    ProviderStandingFromFact { fact: _ } => false
  }
  accepted_pending && rejected_named && unreadable_named
    && !provider_standing_is_selection_eligible(standing: accepted, draw: LimitDispatchDrawAutomatic)
}

// THE srv2 CAPTURE READS UNAVAILABLE, and the host refuses with its OWN cause
// (the key is never presented), not the entitlement reason.
test fn the_srv2_sandbox_capture_refuses_the_accepted_key_with_the_host_cause() -> Bool {
  match sandbox_unsupported_on_srv2() {
    CursorSandboxReady => false
    CursorSandboxRefused { refusal } => {
      let reading_unavailable = match refusal {
        CursorSandboxUnavailable { detail } => string_contains(s: detail, pattern: "uid_map") && string_contains(s: detail, pattern: "SandboxUnsupportedError")
        CursorSandboxNotEntered { detail: _ } => false
        CursorSandboxPreflightUnreadable { exit_code: _, detail: _ } => false
      }
      let standing = cursor_standing_from_sandbox_refusal(refusal: refusal)
      let host_cause = match standing {
        ProviderStandingUnobserved { reason } =>
          string_contains(s: reason as String, pattern: cursor_sandbox_unavailable_reason_prefix)
            && reason != cursor_entitlement_trip_pending_reason
        ProviderStandingFromFact { fact: _ } => false
      }
      reading_unavailable && host_cause && !provider_standing_is_selection_eligible(standing: standing, draw: LimitDispatchDrawAutomatic)
    }
  }
}

// EXIT 0 IS NOT READY WITHOUT THE SUBJECT'S OWN READ: a run that printed no in-sandbox value is
// not-entered, and an accepted key over it still refuses.
test fn a_preflight_exit_0_without_the_in_sandbox_read_is_not_ready() -> Bool {
  let reading = cursor_sandbox_preflight_reading(exit_code: 0, stdout: supplied_sandbox_not_entered_stdout, stderr: "")
  let refused_not_entered = match reading {
    CursorSandboxReady => false
    CursorSandboxRefused { refusal } => {
      let not_entered = match refusal {
        CursorSandboxNotEntered { detail: _ } => true
        CursorSandboxUnavailable { detail: _ } => false
        CursorSandboxPreflightUnreadable { exit_code: _, detail: _ } => false
      }
      let refused = match cursor_standing_from_sandbox_refusal(refusal: refusal) {
        ProviderStandingUnobserved { reason } => string_contains(s: reason as String, pattern: "CURSOR_SANDBOX=native")
        ProviderStandingFromFact { fact: _ } => false
      }
      not_entered && refused
    }
  }
  let ready_reads_ready = match sandbox_ready() {
    CursorSandboxReady => true
    CursorSandboxRefused { refusal: _ } => false
  }
  refused_not_entered && ready_reads_ready
}

// A NON-ZERO EXIT WITHOUT THE CLI'S ERROR CLASS IS UNREADABLE, carrying its status -- 124 included,
// which is not read as the bound firing.
test fn an_unmarked_nonzero_preflight_is_unreadable_and_keeps_its_status() -> Bool {
  let on_124 = match cursor_sandbox_preflight_reading(exit_code: 124, stdout: "", stderr: "") {
    CursorSandboxRefused { refusal: CursorSandboxPreflightUnreadable { exit_code, detail: _ } } => exit_code == 124
    CursorSandboxRefused { refusal: CursorSandboxNotEntered { detail: _ } } => false
    CursorSandboxRefused { refusal: CursorSandboxUnavailable { detail: _ } } => false
    CursorSandboxReady => false
  }
  let on_other = match cursor_sandbox_preflight_reading(exit_code: 1, stdout: "Executing command: printenv CURSOR_SANDBOX\n", stderr: "boom\n") {
    CursorSandboxRefused { refusal: CursorSandboxPreflightUnreadable { exit_code, detail } } => exit_code == 1 && detail == "boom"
    CursorSandboxRefused { refusal: CursorSandboxNotEntered { detail: _ } } => false
    CursorSandboxRefused { refusal: CursorSandboxUnavailable { detail: _ } } => false
    CursorSandboxReady => false
  }
  on_124 && on_other
}

// AN INHERITED native CANNOT MAKE AN UNSANDBOXED PREFLIGHT READY. The one preflight invocation
// starts its outer process with CURSOR_SANDBOX set to the sentinel, so a caller environment that
// already holds native never reaches the command; an unsandboxed fallback then prints the sentinel
// back, and that reads not-entered, never ready.
test fn an_inherited_native_cannot_make_an_unsandboxed_preflight_ready() -> Bool {
  let argv = join(argv_words(command: cursor_sandbox_discriminating_preflight_command(program: cursor_agent_pinned_program(), root: cursor_attempt_runtime_root(instance_root: "/i", reference: "r"))), " ")
  let sentinel_set_outside = argv == concat(concat("env -u CURSOR_API_KEY CURSOR_SANDBOX=", cursor_sandbox_outside_sentinel as String), " env HOME=/i/cursor-attempt-runtime/r/home XDG_CONFIG_HOME=/i/cursor-attempt-runtime/r/config /opt/gunbc/cursor-agent/2026.09.15-d2fe57e/cursor-agent --disable-auto-update sandbox run printenv CURSOR_SANDBOX")
  let unsandboxed_stdout = concat(concat("Executing command: printenv CURSOR_SANDBOX\nWorking directory: /w\n", cursor_sandbox_outside_sentinel as String), "\n")
  let not_ready = match cursor_sandbox_preflight_reading(exit_code: 0, stdout: unsandboxed_stdout, stderr: "") {
    CursorSandboxRefused { refusal: CursorSandboxNotEntered { detail } } => string_contains(s: detail, pattern: "sentinel survived")
    CursorSandboxRefused { refusal: CursorSandboxUnavailable { detail: _ } } => false
    CursorSandboxRefused { refusal: CursorSandboxPreflightUnreadable { exit_code: _, detail: _ } } => false
    CursorSandboxReady => false
  }
  sentinel_set_outside && not_ready
}

// THE ROUTE, through the production actuator selection: on an instance that does not hold the
// credentials, both observed draws refuse before any observation runs or any spawn is planned.
test fn worker_turn_draws_on_a_non_custody_instance_refuse() -> Bool {
  let attempt = DispatchAttempt {
    instance: srv1_live_dashboard_instance(),
    node: sized_derivable(id: "node-worker-turn", prs: [], title: "Worker turn"),
    attempt_key: "0123456789abcdef",
  }
  let codex = match dispatch_actuator_worker_turn_selection_observed(
    attempt: attempt,
    provider: CodexDispatchProvider,
    sizing_expectation: NoDerivedSizingExpectation,
  ) {
    DispatchAttemptSelectionRefused { reason: _ } => true
    DispatchAttemptPrepared { prepared: _ } => false
  }
  let cursor = match dispatch_actuator_worker_turn_selection_observed(
    attempt: attempt,
    provider: CursorDispatchProvider,
    sizing_expectation: NoDerivedSizingExpectation,
  ) {
    DispatchAttemptSelectionRefused { reason: _ } => true
    DispatchAttemptPrepared { prepared: _ } => false
  }
  codex && cursor
}
