module test.claim.spatial_connectivity_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn site() -> std.coordinate_frame.CoordinateFrameIdentity { coordinate_frame_identity(occurrence: 1) }

fn box(x0: Int, y0: Int, x1: Int, y1: Int) -> std.orthogonal_topology.EnclosedSpace? {
  match orthogonal_loop2(vertices: [
    point2(frame: test.claim.spatial_connectivity_witness.site(), x: x0, y: y0),
    point2(frame: test.claim.spatial_connectivity_witness.site(), x: x1, y: y0),
    point2(frame: test.claim.spatial_connectivity_witness.site(), x: x1, y: y1),
    point2(frame: test.claim.spatial_connectivity_witness.site(), x: x0, y: y1),
  ]) {
    OrthogonalRefused { cause: _ } => none
    OrthogonalReady { value: l } =>
      match orthogonal_prism3(footprint: l, low: 0, high: 2400) {
        OrthogonalRefused { cause: _ } => none
        OrthogonalReady { value: pr } => v2.std.optional.Present { value: enclosed_space(shell: closed_shell_of_prism(prism: pr)) }
      }
  }
}

fn placed(name: String, x0: Int, y0: Int, x1: Int, y1: Int) -> product.spatial_world.PlacedSpace? {
  match test.claim.spatial_connectivity_witness.box(x0: x0, y0: y0, x1: x1, y1: y1) {
    Absent => none
    Present { value: s } => v2.std.optional.Present { value: product.spatial_world.PlacedSpace { identity: (name as product.placement_supply.RoomIdentity), space: s } }
  }
}

fn collect(rooms: List<product.spatial_world.PlacedSpace?>) -> List<product.spatial_world.PlacedSpace>? {
  fold(rooms, init: v2.std.optional.Present { value: [] }, f: (acc, r) =>
    match acc {
      Absent => none
      Present { value: got } =>
        match r {
          Absent => none
          Present { value: p } => v2.std.optional.Present { value: concat(got, [p]) }
        }
    })
}

fn world_of(rooms: List<product.spatial_world.PlacedSpace?>) -> product.spatial_world.World? {
  match collect(rooms: rooms) {
    Absent => none
    Present { value: got } =>
      match world(rooms: got) {
        WorldRefused { cause: _ } => none
        WorldReady { value: w } => v2.std.optional.Present { value: w }
      }
  }
}

// Three rooms in a row along X. kitchen | hall | study, each meeting its neighbour on a
// north-south wall. kitchen and study do NOT touch.
fn terrace() -> product.spatial_world.World? {
  test.claim.spatial_connectivity_witness.world_of(rooms: [
    test.claim.spatial_connectivity_witness.placed(name: "kitchen", x0: 0, y0: 0, x1: 3000, y1: 4000),
    test.claim.spatial_connectivity_witness.placed(name: "hall", x0: 3000, y0: 0, x1: 5000, y1: 4000),
    test.claim.spatial_connectivity_witness.placed(name: "study", x0: 5000, y0: 0, x1: 8000, y1: 4000),
  ])
}

fn door(name: String, a: String, b: String, along_low: Int, along_high: Int) -> product.spatial_connectivity.Opening {
  product.spatial_connectivity.Opening {
    identity: (name as product.spatial_connectivity.OpeningIdentity),
    first: (a as product.placement_supply.RoomIdentity),
    second: (b as product.placement_supply.RoomIdentity),
    along_low: along_low,
    along_high: along_high,
    sill: 0,
    head: 2000,
  }
}

fn plan_of(openings: List<product.spatial_connectivity.Opening>) -> product.spatial_connectivity.OpeningPlan? {
  match terrace() {
    Absent => none
    Present { value: w } =>
      match opening_plan(w: w, openings: openings) {
        ConnectivityRefused { cause: _ } => none
        ConnectivityReady { value: p } => v2.std.optional.Present { value: p }
      }
  }
}

fn plan_refusal(openings: List<product.spatial_connectivity.Opening>) -> product.spatial_connectivity.ConnectivityRefusal? {
  match terrace() {
    Absent => none
    Present { value: w } =>
      match opening_plan(w: w, openings: openings) {
        ConnectivityReady { value: _ } => none
        ConnectivityRefused { cause: c } => v2.std.optional.Present { value: c }
      }
  }
}

fn connected(openings: List<product.spatial_connectivity.Opening>, from: String, to: String) -> Bool {
  match terrace() {
    Absent => false
    Present { value: w } =>
      match plan_of(openings: openings) {
        Absent => false
        Present { value: p } =>
          match rooms_are_connected(w: w, p: p, from: (from as product.placement_supply.RoomIdentity), to: (to as product.placement_supply.RoomIdentity)) {
            ConnectivityRefused { cause: _ } => false
            ConnectivityReady { value: b } => b
          }
      }
  }
}

// A door in the wall the two rooms genuinely share is admitted, and the plan carries it.
test fn a_door_in_a_shared_wall_is_admitted() -> Bool {
  match plan_of(openings: [door(name: "d1", a: "kitchen", b: "hall", along_low: 1000, along_high: 1900)]) {
    Absent => false
    Present { value: p } => length(plan_openings(p: p)) == 1
  }
}

// REACHABILITY IS TRANSITIVE, AND THIS IS THE CLAIM THAT NEEDS MORE THAN ONE ROUND: kitchen reaches
// study only through hall, so a single relaxation would answer false.
test fn two_doors_make_the_far_rooms_reachable() -> Bool {
  let doors = [
    door(name: "d1", a: "kitchen", b: "hall", along_low: 1000, along_high: 1900),
    door(name: "d2", a: "hall", b: "study", along_low: 1000, along_high: 1900),
  ]
  connected(openings: doors, from: "kitchen", to: "study")
    && connected(openings: doors, from: "study", to: "kitchen")
}

// An opening is symmetric but reachability still needs the edge: with only the first door, the study
// is not reachable, and the world is not connected.
test fn one_door_leaves_the_third_room_unreachable() -> Bool {
  let doors = [door(name: "d1", a: "kitchen", b: "hall", along_low: 1000, along_high: 1900)]
  match terrace() {
    Absent => false
    Present { value: w } =>
      match plan_of(openings: doors) {
        Absent => false
        Present { value: p } =>
          !connected(openings: doors, from: "kitchen", to: "study")
            && connected(openings: doors, from: "kitchen", to: "hall")
            && !world_is_connected(w: w, p: p)
            && match unreachable_room(w: w, p: p) {
                 Absent => false
                 Present { value: i } => (i as String) == "study"
               }
      }
  }
}

test fn both_doors_make_the_world_connected() -> Bool {
  match terrace() {
    Absent => false
    Present { value: w } =>
      match plan_of(openings: [
        door(name: "d1", a: "kitchen", b: "hall", along_low: 1000, along_high: 1900),
        door(name: "d2", a: "hall", b: "study", along_low: 1000, along_high: 1900),
      ]) {
        Absent => false
        Present { value: p } => world_is_connected(w: w, p: p)
      }
  }
}

// THE FAILURE THIS BAND EXISTS FOR. kitchen and study are both real rooms and both have a
// north-south wall, but not the same one - they are two metres apart. A door between them looks
// entirely reasonable in a room list and is a hole into open air.
test fn a_door_between_rooms_that_do_not_touch_refuses() -> Bool {
  match plan_refusal(openings: [door(name: "d1", a: "kitchen", b: "study", along_low: 1000, along_high: 1900)]) {
    Absent => false
    Present { value: c } =>
      match c {
        OpeningRoomsShareNoWall { first: a, second: b } => (a as String) == "kitchen" && (b as String) == "study"
        _ => false
      }
  }
}

// The rooms DO share a wall, and the door runs off its end: the shared wall spans y 0..4000, and a
// door from 3500 to 4500 leaves the building. The refusal reports both rectangles.
test fn a_door_running_past_the_shared_wall_refuses_with_both_extents() -> Bool {
  match plan_refusal(openings: [door(name: "d1", a: "kitchen", b: "hall", along_low: 3500, along_high: 4500)]) {
    Absent => false
    Present { value: c } =>
      match c {
        OpeningOutsideSharedWall {
          opening: o, along_low: al, along_high: ah, sill: _, head: _,
          shared_along_low: sal, shared_along_high: sah, shared_low: _, shared_high: _,
        } => (o as String) == "d1" && al == 3500 && ah == 4500 && sal == 0 && sah == 4000
        _ => false
      }
  }
}

// The wall is 2400 high, so a door reaching 2600 does not fit in it. The vertical direction is
// checked against the same shared region as the horizontal one.
test fn a_door_taller_than_the_shared_wall_refuses() -> Bool {
  match plan_refusal(openings: [product.spatial_connectivity.Opening {
    identity: ("d1" as product.spatial_connectivity.OpeningIdentity),
    first: ("kitchen" as product.placement_supply.RoomIdentity),
    second: ("hall" as product.placement_supply.RoomIdentity),
    along_low: 1000,
    along_high: 1900,
    sill: 0,
    head: 2600,
  }]) {
    Absent => false
    Present { value: c } =>
      match c {
        OpeningOutsideSharedWall { opening: _, along_low: _, along_high: _, sill: _, head: h, shared_along_low: _, shared_along_high: _, shared_low: _, shared_high: sh } =>
          h == 2600 && sh == 2400
        _ => false
      }
  }
}

test fn a_door_with_no_area_refuses() -> Bool {
  match plan_refusal(openings: [door(name: "d1", a: "kitchen", b: "hall", along_low: 1000, along_high: 1000)]) {
    Absent => false
    Present { value: c } =>
      match c {
        OpeningHasNoArea { opening: o } => (o as String) == "d1"
        _ => false
      }
  }
}

test fn a_door_joining_a_room_to_itself_refuses() -> Bool {
  match plan_refusal(openings: [door(name: "d1", a: "kitchen", b: "kitchen", along_low: 1000, along_high: 1900)]) {
    Absent => false
    Present { value: c } =>
      match c {
        OpeningJoinsRoomToItself { identity: i } => (i as String) == "kitchen"
        _ => false
      }
  }
}

test fn a_door_naming_a_room_the_world_does_not_have_refuses() -> Bool {
  match plan_refusal(openings: [door(name: "d1", a: "kitchen", b: "cellar", along_low: 1000, along_high: 1900)]) {
    Absent => false
    Present { value: c } =>
      match c {
        OpeningRoomMissing { identity: i } => (i as String) == "cellar"
        _ => false
      }
  }
}

// Two openings with one identity are two facts claiming one name, and the plan refuses rather than
// keeping whichever came last.
test fn two_openings_with_one_identity_refuse() -> Bool {
  match plan_refusal(openings: [
    door(name: "d1", a: "kitchen", b: "hall", along_low: 1000, along_high: 1900),
    door(name: "d1", a: "hall", b: "study", along_low: 1000, along_high: 1900),
  ]) {
    Absent => false
    Present { value: c } =>
      match c {
        OpeningDeclaredTwice { opening: o } => (o as String) == "d1"
        _ => false
      }
  }
}

fn endpoint_role_is(c: product.spatial_connectivity.ConnectivityRefusal, name: String, start_expected: Bool) -> Bool {
  match c {
    ReachabilityEndpointMissing { identity: i, role: r } =>
      (i as String) == name
        && match r {
             TraversalStart => start_expected
             TraversalTarget => !start_expected
           }
    _ => false
  }
}

test fn reachability_from_a_room_the_world_does_not_have_refuses() -> Bool {
  match terrace() {
    Absent => false
    Present { value: w } =>
      match plan_of(openings: []) {
        Absent => false
        Present { value: p } =>
          match reachable_from(w: w, p: p, start: ("cellar" as product.placement_supply.RoomIdentity)) {
            ConnectivityReady { value: _ } => false
            ConnectivityRefused { cause: c } => endpoint_role_is(c: c, name: "cellar", start_expected: true)
          }
      }
  }
}

// THE ROLE IS WHAT TELLS A CALLER WHICH ARGUMENT TO FIX. An earlier revision answered a missing
// DESTINATION with the variant named for a missing start: fail-closed, and pointing at the wrong
// argument. This pair is what discriminates them - the same absent room, asked from two positions,
// must come back with two different roles.
test fn a_missing_destination_is_named_as_a_destination_not_a_start() -> Bool {
  match terrace() {
    Absent => false
    Present { value: w } =>
      match plan_of(openings: []) {
        Absent => false
        Present { value: p } =>
          match rooms_are_connected(w: w, p: p, from: ("kitchen" as product.placement_supply.RoomIdentity), to: ("cellar" as product.placement_supply.RoomIdentity)) {
            ConnectivityReady { value: _ } => false
            ConnectivityRefused { cause: c } => endpoint_role_is(c: c, name: "cellar", start_expected: false)
          }
      }
  }
}

test fn a_missing_source_is_named_as_a_start_not_a_destination() -> Bool {
  match terrace() {
    Absent => false
    Present { value: w } =>
      match plan_of(openings: []) {
        Absent => false
        Present { value: p } =>
          match rooms_are_connected(w: w, p: p, from: ("cellar" as product.placement_supply.RoomIdentity), to: ("kitchen" as product.placement_supply.RoomIdentity)) {
            ConnectivityReady { value: _ } => false
            ConnectivityRefused { cause: c } => endpoint_role_is(c: c, name: "cellar", start_expected: true)
          }
      }
  }
}
