module test.claim.animal_crossing_dialogue_witness

import std.types { Bool, Int, List, String }
import extdeps.games.animal_crossing.message {
  LineWidthRange, LineUnbounded, TextLine, message_lines,
  MessageAccepted, MessageRefused, message_table_ends, message_table_octets, message_tokens, message_text,
  steering_tokens, text_message, vanilla_control_codes,
}
import extdeps.games.animal_crossing_deluxe.control_codes { deluxe_control_codes }
import examples.animal_crossing.acmsg { AcmsgBlock, AcmsgEdit, AcmsgAccepted, AcmsgRefused, parse_acmsg, render_acmsg }
import extdeps.games.animal_crossing.dialogue_catalog { CatalogEntry, Personality, Cranky, dialogue_catalog, personalities, personality_looks, personality_of_looks }
import examples.animal_crossing.dialogue { LineFinding, LineFits, LineOverflows, LineMayOverflow, label_blocks, line_width_finding }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// Messages are supplied as literal octets. The inhabitance run over a real disc image is
// examples.animal_crossing.dialogue `show`/`build`; the repository does not carry the image.

// "Hi", the catchphrase, a line break, a pause of 0x0a, then octet 0x5B -- "ã" in the game's font,
// where ASCII would say "[".
data sample_octets: List<Int> = [72, 105, 32, 127, 28, 205, 127, 3, 10, 91, 127, 0]
data sample_text: String = "Hi \{PUT_STRING_TAIL}\n\{CURSOR_SET_TIME:0a}ã\{LAST}"

fn text_of(octets: List<Int>) -> String {
  match message_tokens(codes: vanilla_control_codes, message: octets) {
    MessageAccepted { value: t } => message_text(tokens: t)
    MessageRefused { reason: r } => concat("refused: ", r)
  }
}

fn octets_of(text: String) -> List<Int>? {
  match text_message(codes: vanilla_control_codes, text: text) {
    MessageAccepted { value: o } => Present { value: o }
    MessageRefused { reason: _ } => none
  }
}

test fn control_code_table_is_indexed_by_code() -> Bool {
  return count(vanilla_control_codes) == 123
    && count(deluxe_control_codes()) == 141
    && fold(deluxe_control_codes(), init: 0, f: (next, c) => if c.code == next { next + 1 } else { -1000 }) == 141
}

test fn message_text_round_trips_codes_breaks_and_font_glyphs() -> Bool {
  return text_of(octets: sample_octets) == sample_text && octets_of(text: sample_text) == Present { value: sample_octets }
}

test fn unprintable_octets_round_trip_as_escapes() -> Bool {
  return text_of(octets: [210, 127, 0]) == "{#d2}\{LAST}" && octets_of(text: "{#d2}\{LAST}") == Present { value: [210, 127, 0] }
}

test fn text_refuses_unknown_codes_wrong_arity_and_characters_the_font_lacks() -> Bool {
  return octets_of(text: "\{NOPE}") == none
    && octets_of(text: "\{CURSOR_SET_TIME}") == none
    && octets_of(text: "\{CURSOR_SET_TIME:01 02}") == none
    && octets_of(text: "a } b") == none
    && octets_of(text: "a { b") == none
    && octets_of(text: "[AI]") == none
}

fn all_glyph_octets(from: Int, acc: List<Int>) -> List<Int> {
  if from > 255 { acc } else if from == 127 { all_glyph_octets(from: from + 1, acc: acc) } else { all_glyph_octets(from: from + 1, acc: list_push(acc, from)) }
}

test fn every_non_control_octet_round_trips_through_the_font() -> Bool {
  let octets = all_glyph_octets(from: 0, acc: [])
  return octets_of(text: text_of(octets: octets)) == Present { value: octets }
}

test fn a_deluxe_code_tokenizes_only_with_the_deluxe_table() -> Bool {
  let octets = [127, 124, 42, 65]
  let vanilla = match message_tokens(codes: vanilla_control_codes, message: octets) {
    MessageAccepted { value: _ } => false
    MessageRefused { reason: _ } => true
  }
  let deluxe = match message_tokens(codes: deluxe_control_codes(), message: octets) {
    MessageAccepted { value: t } => message_text(tokens: t) == "\{X7C:2a}A"
    MessageRefused { reason: _ } => false
  }
  return vanilla && deluxe
}

test fn a_code_running_past_the_message_end_is_refused() -> Bool {
  return match message_tokens(codes: vanilla_control_codes, message: [65, 127, 3]) {
    MessageAccepted { value: _ } => false
    MessageRefused { reason: _ } => true
  }
}

fn steering_of(text: String) -> List<List<Int>> {
  match text_message(codes: vanilla_control_codes, text: text) {
    MessageRefused { reason: _ } => [[-1]]
    MessageAccepted { value: o } =>
      match message_tokens(codes: vanilla_control_codes, message: o) {
        MessageAccepted { value: t } => steering_tokens(tokens: t)
        MessageRefused { reason: _ } => [[-1]]
      }
  }
}

data branching: String = "Done?\{SET_SELECT_STRING_2:01 ae 01 af}\{BUTTON}\{SET_SELECT_WINDOW}\{SET_NEXT_MESSAGE_0:31 1e}\{SET_NEXT_MESSAGE_1:31 1f}\{SET_FORCE_NEXT}\{CONTINUE}"

test fn rewording_and_repacing_keep_the_steering_codes() -> Bool {
  return steering_of(text: "Hmph.\{CURSOR_SET_TIME:08} Finished?\{SET_SELECT_STRING_2:01 ae 01 af}\{SET_SELECT_WINDOW}\{SET_NEXT_MESSAGE_0:31 1e}\{SET_NEXT_MESSAGE_1:31 1f}\{SET_FORCE_NEXT}\{CONTINUE}") == steering_of(text: branching)
}

test fn dropping_a_branch_target_changes_the_steering_codes() -> Bool {
  return steering_of(text: "Done?\{SET_SELECT_STRING_2:01 ae 01 af}\{BUTTON}\{SET_SELECT_WINDOW}\{SET_NEXT_MESSAGE_0:31 1e}\{SET_FORCE_NEXT}\{CONTINUE}") != steering_of(text: branching)
}

test fn message_table_reads_end_offsets_and_writes_them_back() -> Bool {
  let table = [0, 0, 0, 3, 0, 0, 1, 0]
  return match message_table_ends(table: table) {
    MessageAccepted { value: ends } => ends == [3, 256] && message_table_octets(ends: ends) == table
    MessageRefused { reason: _ } => false
  }
}

test fn a_ragged_message_table_is_refused() -> Bool {
  return match message_table_ends(table: [0, 0, 3]) {
    MessageAccepted { value: _ } => false
    MessageRefused { reason: _ } => true
  }
}

test fn acmsg_blocks_parse_with_labels_and_keep_a_trailing_break() -> Bool {
  let content = "# comment\n\n=== 12573 cranky: done ===\nline one\nline two\n=== 0x10 ===\nends with a break\n\n"
  return match parse_acmsg(source: "f.acmsg", content: content) {
    AcmsgAccepted { value: edits } =>
      edits == [
        AcmsgEdit { block: AcmsgBlock { id: 12573, label: "cranky: done", text: "line one\nline two" }, source: "f.acmsg:3" },
        AcmsgEdit { block: AcmsgBlock { id: 16, label: "", text: "ends with a break\n" }, source: "f.acmsg:6" },
      ]
    AcmsgRefused { reason: _ } => false
  }
}

test fn acmsg_refuses_text_before_the_first_header() -> Bool {
  return match parse_acmsg(source: "f.acmsg", content: "stray\n=== 1 ===\nx\n") {
    AcmsgAccepted { value: _ } => false
    AcmsgRefused { reason: r } => r == "f.acmsg:1: text before the first '=== id ===' header"
  }
}

data render_cases: List<AcmsgBlock> = [
  AcmsgBlock { id: 12573, label: "cranky: done", text: "line one\nline two\{CONTINUE}" },
  AcmsgBlock { id: 7, label: "", text: "" },
  AcmsgBlock { id: 8, label: "ends with a break", text: "x\n" },
  AcmsgBlock { id: 9, label: "", text: "\n\nblank lines first" },
]

test fn acmsg_render_then_parse_is_the_identity() -> Bool {
  return match render_acmsg(comments: ["generated", "second note"], blocks: render_cases) {
    AcmsgRefused { reason: _ } => false
    AcmsgAccepted { value: text } =>
      match parse_acmsg(source: "r", content: text) {
        AcmsgAccepted { value: edits } => (edits |> map(e => e.block)) == render_cases
        AcmsgRefused { reason: _ } => false
      }
  }
}

fn render_refused(block: AcmsgBlock) -> Bool {
  match render_acmsg(comments: [], blocks: [block]) {
    AcmsgAccepted { value: _ } => false
    AcmsgRefused { reason: _ } => true
  }
}

test fn acmsg_render_refuses_what_would_not_read_back() -> Bool {
  return render_refused(block: AcmsgBlock { id: 1, label: "", text: "fine\n=== 2 ===\nsmuggled" })
    && render_refused(block: AcmsgBlock { id: 1, label: " padded", text: "x" })
    && render_refused(block: AcmsgBlock { id: 1, label: "two\nlines", text: "x" })
    && render_refused(block: AcmsgBlock { id: -1, label: "", text: "x" })
    && render_refused(block: AcmsgBlock { id: 1, label: "ok", text: "x" }) == false
}

fn lines_of(text: String) -> List<TextLine> {
  match text_message(codes: vanilla_control_codes, text: text) {
    MessageRefused { reason: _ } => []
    MessageAccepted { value: o } =>
      match message_tokens(codes: vanilla_control_codes, message: o) {
        MessageAccepted { value: t } => message_lines(tokens: t)
        MessageRefused { reason: _ } => []
      }
  }
}

// Digits advance 8 units and a space 5 (12 minus m_font_offset.c_inc's 4 and 7).
test fn a_plain_line_measures_the_sum_of_its_glyph_advances() -> Bool {
  return lines_of(text: "12 34\{LAST}") == [TextLine { page: 0, line: 0, extent: LineWidthRange { min: 37, max: 37 } }]
}

// PLAYER_NAME inserts up to 8 octets, each at most 12 units wide.
test fn an_inserted_name_widens_the_line_to_a_range() -> Bool {
  return lines_of(text: "1\{PUT_STRING_PLAYER_NAME}\{LAST}") == [TextLine { page: 0, line: 0, extent: LineWidthRange { min: 8, max: 104 } }]
}

test fn control_only_lines_take_no_row_and_clear_starts_a_page() -> Bool {
  let lines = lines_of(text: "1\n2\{BUTTON}\n\{CLEAR}3\n\{SET_FORCE_NEXT}\{CONTINUE}")
  return (lines |> map(l => [l.page, l.line])) == [[0, 0], [0, 1], [1, 0]]
}

test fn a_scaled_line_is_not_measured() -> Bool {
  return match get(lines_of(text: "\{SET_LINE_SCALE:10}1\{LAST}"), 0) {
    null => false
    other => match other.extent {
      LineUnbounded { reason: _ } => true
      LineWidthRange { min: _, max: _ } => false
    }
  }
}

test fn personalities_follow_looks_order() -> Bool {
  return count(personalities) == 6
    && (personalities |> all(p => personality_of_looks(looks: personality_looks(p: p)) == Present { value: p }))
    && personality_of_looks(looks: 6) == none
}

fn has_one_range_per_personality(entry: CatalogEntry) -> Bool {
  (entry.ranges |> map(r => r.looks)) == [0, 1, 2, 3, 4, 5] && (entry.ranges |> all(r => r.first_id >= 0 && r.count > 0))
}

test fn every_catalog_entry_covers_each_personality_once() -> Bool {
  return count(dialogue_catalog) > 0 && (dialogue_catalog |> all(e => has_one_range_per_personality(entry: e)))
}

test fn catalog_topics_are_unique() -> Bool {
  return fold(dialogue_catalog, init: [], f: (seen, e) => if seen |> any(t => t == e.topic) { list_push(seen, "") } else { list_push(seen, e.topic) }) |> all(t => t != "")
}

test fn dumped_blocks_are_labelled_with_topic_personality_and_position() -> Bool {
  let blocks = [AcmsgBlock { id: 10, label: "", text: "a" }, AcmsgBlock { id: 11, label: "", text: "b" }]
  return (label_blocks(blocks: blocks, topic: "chat", p: Cranky) |> map(b => b.label)) == ["chat / cranky 1 of 2", "chat / cranky 2 of 2"]
}

fn finding_kind(f: LineFinding) -> String {
  match f {
    LineFits => "fits"
    LineOverflows { reason: _ } => "overflows"
    LineMayOverflow { reason: _ } => "may overflow"
  }
}

fn width_line(min: Int, max: Int) -> TextLine {
  TextLine { page: 0, line: 0, extent: LineWidthRange { min: min, max: max } }
}

test fn line_widths_are_judged_against_the_window() -> Bool {
  return finding_kind(f: line_width_finding(line: width_line(min: 245, max: 245), units: 245)) == "fits"
    && finding_kind(f: line_width_finding(line: width_line(min: 246, max: 246), units: 245)) == "overflows"
    && finding_kind(f: line_width_finding(line: width_line(min: 100, max: 300), units: 245)) == "may overflow"
    && finding_kind(f: line_width_finding(line: TextLine { page: 0, line: 0, extent: LineUnbounded { reason: "scaled" } }, units: 245)) == "may overflow"
}
