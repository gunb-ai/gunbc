  UefiShellOverSol,
  firmware_boot_observation,
  firmware_network_boot_attempt_receipt,
  firmware_network_boot_preparation_routes,
  firmware_network_boot_standing,
  network_boot_attempt,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data witness_authority: CitedFigureStanding = CitedToAuthority {
  authority: ExternalAuthority { uri: uri_https(locator: "example.invalid/witness-fixture-not-fleet-fact") },
}

data witness_epoch: EpochMs = 1765000000000

// TYPED FIXTURE PIECES, AND THE SHAPE IS THE POINT (merry-fox-82, blocker 1). The two BMC reads are
// modelled as what they are: BOOT ORDER gives references in order and nothing else; BOOT OPTIONS give
// reference, kind, label and enabled-ness. A fixture therefore cannot put a network KIND in the boot
// order at all -- to say "the head boots the network" a fixture must list an enabled network OPTION
// and make the order's head reference point at it. That is the whole repair, visible in the fixture
// code: the false Ready the review found ([Hdd, Pxe] reading as Ready/Pxe) has no spelling here.
//
// REFERENCES ARE STABLE STRINGS AND THE SAME STRING IN BOTH READS. Two fixtures join when and only
// when they share a reference; a fixture that renames a reference in one read lands in
// HeadOptionNotEnumerated, which is a real firmware condition (a hidden option left in BootOrder).
fn opt_http(reference: NonEmptyStr) -> BootOption {
  boot_option(reference: reference, kind: BootTargetUefiHttp, label: "UEFI IPv4 HTTP", enabled: true)
}
fn opt_pxe(reference: NonEmptyStr) -> BootOption {
  boot_option(reference: reference, kind: BootTargetPxe, label: "UEFI Network Stack", enabled: true)
}
fn opt_disabled_pxe(reference: NonEmptyStr) -> BootOption {
  boot_option(reference: reference, kind: BootTargetPxe, label: "UEFI Network Stack", enabled: false)
}
fn opt_disk(reference: NonEmptyStr) -> BootOption {
  boot_option(reference: reference, kind: BootTargetHdd, label: "NVMe0", enabled: true)
}
fn entry(reference: NonEmptyStr, label: NonEmptyStr) -> BootOrderEntry {
  boot_order_entry(reference: reference, label: label)
}

// THE CANONICAL REFERENCES, spelled once. Http is 0001, pxe 0002, the disk 0003 -- so an ordering
// fixture says which reference comes FIRST and the enumeration says what each reference IS.
fn ref_http() -> NonEmptyStr { "0001" }
fn ref_pxe() -> NonEmptyStr { "0002" }
fn ref_disk() -> NonEmptyStr { "0003" }

fn http_entry() -> BootOrderEntry { entry(reference: ref_http(), label: "UEFI IPv4 HTTP") }
fn pxe_entry() -> BootOrderEntry { entry(reference: ref_pxe(), label: "ALTRAD8UD-1L2T") }
fn disk_entry() -> BootOrderEntry { entry(reference: ref_disk(), label: "NVMe0") }

// THE HAPPY UNIT'S ORDER, and it is now a self-consistent unit rather than the contradiction merry
// found. Cut 6's fleet path is PXE (the pinned snponly.efi chainloader), so the head is the PXE
// reference and the enumeration backs that reference with an ENABLED PXE option. The old fixture had
// devices [PXE stack, NVMe0] against options [UefiHttp] -- an order naming a PXE entry and an
// enumeration that contains no PXE option at all -- which read Ready only because the fold asked each
// list the same vague question. A unit that boots normally has the DISK first, and that fixture exists
// explicitly (disk_then_network) rather than being the happy path in disguise; it is what the
// false-Ready witnesses are built from.
fn network_then_disk() -> List<BootOrderEntry> { [pxe_entry(), disk_entry()] }
fn disk_then_network() -> List<BootOrderEntry> { [disk_entry(), pxe_entry()] }

// THE ENUMERATION the happy unit answers with: the PXE option the head names, and the disk, both
// enabled. The HTTP option is deliberately NOT in this list -- fixtures that need it ask for it by
// name, so a fixture cannot drift into a Ready by gaining an option it never claimed.
fn good_options() -> List<BootOption> { [opt_pxe(ref_pxe()), opt_disk(ref_disk())] }

// SYNTHETIC OBSERVATIONS. Fully-answered, network-bootable: the only input shape that may
// produce a Ready.
fn good_observation() -> FirmwareBootObservation {
  firmware_boot_observation(
    boot_order: BootOrderObserved { devices: network_then_disk() },
    boot_options: BootOptionsObserved { options: good_options() },
    nics: NicsObserved { nics: ["eth0"] },
    secure_boot: SecureBootDisabled,
    bios_version: BiosVersionObserved { version: "1.08" },
  )
}

fn standing_of(observation: FirmwareBootObservation) -> FirmwareNetworkBootStanding {
  firmware_network_boot_standing(
    observation: observation,
    authority: witness_authority,
    observed_at: witness_epoch,
    boot_mode: UefiPxe { tftp_root: uri_https(locator: "edge.invalid/pxe") },
  )
}

fn with_boot_order(boot_order: BootOrderObservation) -> FirmwareBootObservation {
  firmware_boot_observation(
    boot_order: boot_order,
    boot_options: BootOptionsObserved { options: good_options() },
    nics: NicsObserved { nics: ["eth0"] },
    secure_boot: SecureBootDisabled,
    bios_version: BiosVersionObserved { version: "1.08" },
  )
}

fn with_boot_options(options: BootOptionsObservation) -> FirmwareBootObservation {
  firmware_boot_observation(
    boot_order: BootOrderObserved { devices: network_then_disk() },
    boot_options: options,
    nics: NicsObserved { nics: ["eth0"] },
    secure_boot: SecureBootDisabled,
    bios_version: BiosVersionObserved { version: "1.08" },
  )
}

fn with_nics(nics: NicsObservation) -> FirmwareBootObservation {
  firmware_boot_observation(
    boot_order: BootOrderObserved { devices: network_then_disk() },
    boot_options: BootOptionsObserved { options: good_options() },
    nics: nics,
    secure_boot: SecureBootDisabled,
    bios_version: BiosVersionObserved { version: "1.08" },
  )
}

fn with_secure_boot(secure_boot: SecureBootObservation) -> FirmwareBootObservation {
  firmware_boot_observation(
    boot_order: BootOrderObserved { devices: network_then_disk() },
    boot_options: BootOptionsObserved { options: good_options() },
    nics: NicsObserved { nics: ["eth0"] },
    secure_boot: secure_boot,
    bios_version: BiosVersionObserved { version: "1.08" },
  )
}

fn with_bios(bios_version: BiosVersionObservation) -> FirmwareBootObservation {
  firmware_boot_observation(
    boot_order: BootOrderObserved { devices: network_then_disk() },
    boot_options: BootOptionsObserved { options: good_options() },
    nics: NicsObserved { nics: ["eth0"] },
    secure_boot: SecureBootDisabled,
    bios_version: bios_version,
  )
}

test fn the_happy_unit_is_ready_and_carries_every_ready_field() -> Bool {
  match standing_of(observation: good_observation()) {
    Ready { firmware_mode: mode, network_interface: nic, boot_target: target, evidence: ev } =>
      // THE HEAD, NOT JUST 'SOMETHING NETWORK' (review 81853). The fixture's boot order is
      // [PXE stack, NVMe0], so the target the verdict names must be the PXE entry -- the kind the
      // classifier produced for the entry the unit will actually boot. A fold that collapsed the
      // classification to a Bool could not produce this assertion at all.
      match target {
        BootTargetPxe =>
          match mode {
            UefiPxe { tftp_root: _ } =>
              nic == "eth0"
                && match ev.observation.bios_version {
                     BiosVersionObserved { version: v } => v == "1.08"
                     _ => false
                   }
            _ => false
          }
        _ => false
      }
    _ => false
  }
}

// THE ORDER IS THE ANSWER. Two units, SAME enumeration (both a PXE option and an HTTP option, both
// enabled), opposite boot order: the verdicts must name DIFFERENT targets. If the fold picked the
// enumeration's first entry rather than the boot order's head, both report the same target and this
// fails -- and the operator is told the wrong thing will boot.
//
// The enumeration is deliberately identical in both fixtures: the ONLY difference is which reference
// comes first in BootOrder. Under the old shape these two were indistinguishable, because the fold
// filtered the order down to network kinds and took the first survivor -- both orders filtered to the
// same thing (merry-fox-82, blocker 1).
test fn the_ready_names_the_boot_order_head_not_the_first_option() -> Bool {
  let both_network_options = [opt_pxe(ref_pxe()), opt_http(ref_http())]
  let http_first = firmware_boot_observation(
    boot_order: BootOrderObserved { devices: [http_entry(), pxe_entry()] },
    boot_options: BootOptionsObserved { options: both_network_options },
    nics: NicsObserved { nics: ["eth0"] },
    secure_boot: SecureBootDisabled,
    bios_version: BiosVersionObserved { version: "1.08" },
  )
  let pxe_first = firmware_boot_observation(
    boot_order: BootOrderObserved { devices: [pxe_entry(), http_entry()] },
    boot_options: BootOptionsObserved { options: both_network_options },
    nics: NicsObserved { nics: ["eth0"] },
    secure_boot: SecureBootDisabled,
    bios_version: BiosVersionObserved { version: "1.08" },
  )
  match standing_of(observation: http_first) {
    Ready { firmware_mode: _, network_interface: _, boot_target: BootTargetUefiHttp, evidence: _ } =>
      match standing_of(observation: pxe_first) {
        Ready { firmware_mode: _, network_interface: _, boot_target: BootTargetPxe, evidence: _ } => true
        _ => false
      }
    _ => false
  }
}

fn evidence_observation(ev: ReadyEvidence) -> FirmwareBootObservation {
  ev.observation
}

// THE HONESTY RUNG: on each of the five axes, an Unobserved arm outranks the identical-looking
// Ready the other four axes would support. If any of these five produces Ready, a unit whose
// Secure Boot (say) was never asked about gets an unsigned chainloader aimed at it.
test fn boot_order_unobserved_never_reads_ready() -> Bool {
  match standing_of(observation: with_boot_order(boot_order: BootOrderUnobserved { reason: "probe skipped" })) {
    Unobserved { unanswered: gaps } => length_of(gaps)
    _ => false
  }
}

test fn boot_options_unobserved_never_reads_ready() -> Bool {
  match standing_of(observation: with_boot_options(options: BootOptionsUnobserved { reason: "redfish refused listing" })) {
    Unobserved { unanswered: gaps } => length_of(gaps)
    _ => false
  }
}

test fn nics_unobserved_never_reads_ready() -> Bool {
  match standing_of(observation: with_nics(nics: NicsUnobserved { reason: "family cannot answer" })) {
    Unobserved { unanswered: gaps } => length_of(gaps)
    _ => false
  }
}

test fn secure_boot_unobserved_never_reads_ready() -> Bool {
  match standing_of(observation: with_secure_boot(secure_boot: SecureBootUnobserved { reason: "not asked" })) {
    Unobserved { unanswered: gaps } => length_of(gaps)
    _ => false
  }
}

test fn bios_unobserved_never_reads_ready() -> Bool {
  match standing_of(observation: with_bios(bios_version: BiosVersionUnobserved { reason: "no reader for family" })) {
    Unobserved { unanswered: gaps } => length_of(gaps)
    _ => false
  }
}

// A non-empty gap list, without betting on a list-destructuring form the corpus does not use:
// any() over an empty list is false, so this is exactly 'at least one axis went unanswered'.
fn length_of(gaps: List<UnansweredAxis>) -> Bool {
  any(gaps, g => true)
}

// Rendered prose is checked by TOKEN, not by equality against a copy of the renderer -- a copy would
// pass even if the renderer were changed to emit something else, which is the failure this field had
// when it was prose.
fn text_contains(haystack: NonEmptyStr, needle: NonEmptyStr) -> Bool {
  string_contains(s: haystack, pattern: needle)
}

// On any axis, a REFUSAL keeps its cause instead of degrading to Unobserved: the remedies differ
// (go ask vs. stop asking that way) and the report line differs too.
test fn refusal_on_any_axis_keeps_its_cause() -> Bool {
  match standing_of(observation: with_boot_order(boot_order: BootOrderRefused { refusal: VendorCommandRejected { detail: "ipmi vendor command rejected" } })) {
    Refused { cause: TransportRefusedVendorCommand { refusal: VendorCommandRejected { detail: r } }, gaps: _ } => r == "ipmi vendor command rejected"
    _ => false
  }
    && match standing_of(observation: with_nics(nics: NicsRefused { refusal: ResourceNotFound { detail: "redfish nic collection denied" } })) {
         Refused { cause: TransportRefusedVendorCommand { refusal: ResourceNotFound { detail: r } }, gaps: _ } => r == "redfish nic collection denied"
         _ => false
       }
    && match standing_of(observation: with_secure_boot(secure_boot: SecureBootRefused { refusal: AuthenticationRequired { detail: "secure boot property hidden" } })) {
         Refused { cause: TransportRefusedVendorCommand { refusal: _ }, gaps: _ } => true
         _ => false
       }
}

// SECURE BOOT ON IS NOT READY, AND -- SINCE BLOCKER 3 -- NOT A ROUTE EITHER: it is a refusal that
// names the mechanism. The OLD version of this test asserted `attribute == "SecureBoot"`, and that
// assertion asserted the defect: the seam was declaring a write to a BIOS key nobody had read, on the
// one control the catalog itself marks as needing operator consent. Saying Ready would send the board
// to fail; saying 'this board cannot network boot' would be false; saying 'we would set Secure Boot,
// and here is the read that would let us name the key' is the standing the unit is actually in.
//
// WHY THE MECHANISM NAME IS ASSERTED RATHER THAN MERELY 'it refused': the refusal must be
// distinguishable from an unconfigured board or a refused transport. The seam still knows WHAT it would
// do -- it only will not do it without the read -- and `mechanism` is the field that carries that.
test fn secure_boot_enabled_refuses_until_the_attribute_name_is_in_hand() -> Bool {
  match standing_of(observation: with_secure_boot(secure_boot: SecureBootEnabled)) {
    Refused {
      cause: RouteBindingUnresolved { mechanism: mechanism, owed_read: owed },
      gaps: _,
    } =>
      mechanism == "redfish-bios-secure-boot"
        // THE OWED READ IS AN INSTRUCTION, not a shrug: it has to say what to read.
        && length(xs: owed) > 0
        && (string_contains(s: owed, pattern: "GET") || string_contains(s: owed, pattern: "Attributes"))
    // EVERY OTHER STANDING NAMED. Ready and NeedsPreparation both mean the seam would act, and acting
    // here is the defect; Unobserved would mean the unit never answered, which it did; a DIFFERENT
    // refusal cause would mean the seam blamed the wrong thing, which is the failure a `_ => false`
    // hides -- the test would report 'the unit was refused' while the seam refused for an unrelated
    // reason such as the transport being down.
    Ready { firmware_mode: _, network_interface: _, boot_target: _, evidence: _ } => false
    NeedsPreparation { route: _, blocking: _ } => false
    Refused { cause: _, gaps: _ } => false
    Unobserved { unanswered: _ } => false
  }
}

// THE REFUSAL IS ABOUT MISSING EVIDENCE, NOT A MISSING MECHANISM, and the only way to witness that is
// to change the evidence and watch the answer move. Same mechanism, three transcriptions: one read
// against the version the unit reports, one against a superseded version, and none at all.
//
// THE MIDDLE CASE IS THE ONE THAT EARNS ITS KEEP. A test showing only 'a bound name is accepted'
// would also pass if the binder ignored the version entirely -- the same class of defect as the fold
// that used to match `BiosVersionObserved { version: _ }` and throw the value away. Carrying BOTH
// versions in the refusal (rather than a sentence about staleness) is what makes the mismatch checkable.
test fn a_bios_attribute_name_is_accepted_only_for_the_version_it_was_read_against() -> Bool {
  match bind_route_from(
    route: SetSecureBootAttribute {
      service_root: "redfish:Bios",
      attribute: firmware_attribute_name_from_read(
        value: "SecureBoot",
        read_against_bios_version: "1.08",
      ),
      authority: witness_authority,
    },
    redirect_to: RedirectTargetAbsent { why: "not a redirect blocker" },
    observed_bios_version: present(version: "1.08"),
  ) {
    // THE ROW COMES BACK UNCHANGED IN EVERY FIELD THE FLEET OWNS, with the slot filled. Checking
    // service_root is the guard against a binder that REBUILT the row and dropped a field the caller
    // supplied -- a failure that would otherwise surface as a PATCH to the wrong Redfish container.
    RouteBound {
      route: SetSecureBootAttribute {
        service_root: s,
        attribute: MechanismNameBound { value: v, grounded_by: GroundedByBiosAttributeRead { bios_version: read_against } },
        authority: _,
      },
    } => s == "redfish:Bios" && v == "SecureBoot" && read_against == "1.08"
    RouteBound { route: _ } => false
    BindingRefused { refusal: _ } => false
  }
    // THE SAME NAME, A SUPERSEDED VERSION: refused, not written.
    && match bind_route_from(
         route: SetSecureBootAttribute {
           service_root: "redfish:Bios",
           attribute: firmware_attribute_name_from_read(
             value: "SecureBoot",
             read_against_bios_version: "1.06",
           ),
           authority: witness_authority,
         },
         redirect_to: RedirectTargetAbsent { why: "not a redirect blocker" },
         observed_bios_version: present(version: "1.08"),
       ) {
         BindingRefused {
           refusal: RouteBindingStaleGrounding {
             mechanism: mechanism,
             grounded_for_bios_version: grounded,
             observed_bios_version: seen,
           },
         } =>
           mechanism == "redfish-bios-secure-boot" && grounded == "1.06" && seen == "1.08"
         RouteBound { route: _ } => false
         BindingRefused { refusal: RouteBindingUnresolvedRoute { mechanism: _, owed_read: _ } } => false
       }
    // NO VERSION OBSERVED AT ALL: the transcription cannot be shown current, so it does not get
    // written. This is the standing the Secure Boot fold reaches for directly -- it is evaluated ABOVE
    // the BIOS axis, so no version is in scope -- which is exactly why the fold's own answer above is
    // a refusal rather than a route.
    && match bind_route_from(
         route: SetSecureBootAttribute {
           service_root: "redfish:Bios",
           attribute: firmware_attribute_name_from_read(
             value: "SecureBoot",
             read_against_bios_version: "1.08",
           ),
           authority: witness_authority,
         },
         redirect_to: RedirectTargetAbsent { why: "not a redirect blocker" },
         observed_bios_version: Absent,
       ) {
         BindingRefused { refusal: RouteBindingUnresolvedRoute { mechanism: mechanism, owed_read: owed } } =>
           mechanism == "redfish-bios-secure-boot" && string_contains(s: owed, pattern: "BIOS version")
         RouteBound { route: _ } => false
         BindingRefused {
           refusal: RouteBindingStaleGrounding {
             mechanism: _,
             grounded_for_bios_version: _,
             observed_bios_version: _,
           },
         } => false
       }
}

// ANSWERED-AND-EMPTY MUST NOT LOOK LIKE UNASKED. The options axis came back and said 'nothing';
// that is a preparation question (there is a mechanism that makes an option exist), not a coverage
// gap to go and re-ask. Review 81802 is why the expected blocker is ABSENT rather than NOT_SELECTED
// here: the enumeration reported no option, so nothing exists to redirect to, and the only admissible
// mechanism is the one that creates one. The Unobserved arm staying false is the point of the test.
test fn answered_and_absent_is_preparation_not_unobserved() -> Bool {
  match standing_of(observation: with_boot_options(options: BootOptionsObserved { options: [] })) {
    NeedsPreparation { route: r, blocking: b } =>
      is_a_fleet_route(route: r)
        && match b {
             NetworkBootOptionAbsent => true
             _ => false
           }
    Unobserved { unanswered: _ } => false
    _ => false
  }
}

// More than one candidate NIC and no evidence which carries PXE must NOT silently pick the first.
// This is the machine-name-selection failure wearing a different hat: deterministic, reproducible,
// and wrong on the first board whose ports differ from the guess.
test fn two_candidate_nics_refuse_to_guess_the_first() -> Bool {
  match standing_of(observation: with_nics(nics: NicsObserved { nics: ["eth0", "eth1"] })) {
    NeedsPreparation { route: r, blocking: b } =>
      is_a_fleet_route(route: r)
        && match b {
             NoInterfaceCarriesPxe => true
             _ => false
           }
    _ => false
  }
}

// THE READINESS FN IS TOTAL: twelve inputs covering every axis arm of every axis produce a
// standing (never a load error, never no-arm), each landing in exactly one of the four variants.
test fn the_readiness_fn_is_total_over_a_mixed_observation_matrix() -> Bool {
  is_standing(standing_of(observation: good_observation()))
    && is_standing(standing_of(observation: with_boot_order(boot_order: BootOrderObserved { devices: [] })))
    && is_standing(standing_of(observation: with_boot_order(boot_order: BootOrderUnobserved { reason: "x" })))
    && is_standing(standing_of(observation: with_boot_order(boot_order: BootOrderRefused { refusal: VendorCommandRejected { detail: "x" } })))
    && is_standing(standing_of(observation: with_boot_options(options: BootOptionsObserved { options: [] })))
    && is_standing(standing_of(observation: with_boot_options(options: BootOptionsUnobserved { reason: "x" })))
    && is_standing(standing_of(observation: with_boot_options(options: BootOptionsRefused { refusal: ResourceNotFound { detail: "x" } })))
    && is_standing(standing_of(observation: with_nics(nics: NicsObserved { nics: [] })))
    && is_standing(standing_of(observation: with_nics(nics: NicsObserved { nics: ["a", "b"] })))
    && is_standing(standing_of(observation: with_nics(nics: NicsUnobserved { reason: "x" })))
    && is_standing(standing_of(observation: with_nics(nics: NicsRefused { refusal: AuthenticationRequired { detail: "x" } })))
    && is_standing(standing_of(observation: with_secure_boot(secure_boot: SecureBootEnabled)))
    && is_standing(standing_of(observation: with_secure_boot(secure_boot: SecureBootUnobserved { reason: "x" })))
    && is_standing(standing_of(observation: with_secure_boot(secure_boot: SecureBootRefused { refusal: ReplyShapeUnrecognized { detail: "x" } })))
    && is_standing(standing_of(observation: with_bios(bios_version: BiosVersionUnobserved { reason: "x" })))
    && is_standing(standing_of(observation: with_bios(bios_version: BiosVersionRefused { refusal: VendorCommandRejected { detail: "x" } })))
}

fn is_standing(standing: FirmwareNetworkBootStanding) -> Bool {
  match standing {
    Ready { firmware_mode: _, network_interface: _, boot_target: _, evidence: _ } => true
    NeedsPreparation { route: _, blocking: _ } => true
    Unobserved { unanswered: _ } => true
    Refused { cause: _, gaps: _ } => true
  }
}

// EVERY ROUTE THE SEAM CAN POINT AT IS A CATALOG ROW. This is what makes the catalog the owner
// rather than a document about the code: decide()'s and the readiness fn's routes are checked
// against the rows, so adding an un-rowed route anywhere breaks THIS test, not production.
test fn every_route_the_seam_emits_is_cataloged() -> Bool {
  every_emitted_route_cataloged(standing_of(observation: with_boot_order(boot_order: BootOrderObserved { devices: [] })))
    && every_emitted_route_cataloged(standing_of(observation: with_boot_order(boot_order: BootOrderObserved { devices: [disk_entry(), disk_entry()] })))
    && every_emitted_route_cataloged(standing_of(observation: with_boot_options(options: BootOptionsObserved { options: [] })))
    && every_emitted_route_cataloged(standing_of(observation: with_secure_boot(secure_boot: SecureBootEnabled)))
    && every_emitted_route_cataloged(standing_of(observation: with_nics(nics: NicsObserved { nics: ["a", "b"] })))
}

fn every_emitted_route_cataloged(standing: FirmwareNetworkBootStanding) -> Bool {
  match standing {
    NeedsPreparation { route: r, blocking: _ } => is_a_fleet_route(route: r)
    _ => true
  }
}

// MEMBERSHIP, NOT COMPARISON (review 81760). The module no longer ships a route_eq or a
// route_is_cataloged: route identity is structural `==`, and 'is this one of ours' is a lookup in
// the one table that owns the routes. The fold's route comes OUT of that table, so this is testing
// that the fold reached the table at all -- a route fabricated elsewhere would not be in it.
fn is_a_fleet_route(route: FirmwareNetworkBootPreparationRoute) -> Bool {
  length(xs: filter(firmware_network_boot_preparation_routes, candidate => candidate == route)) > 0
}

// THE FOLD'S ROUTE AND THE CATALOG'S ROUTE AGREE ON EVERYTHING THE EXECUTOR READS. Compared by
// field rather than by whole-value equality because the fold does not restate the citation it was
// handed -- that is catalog metadata the readiness fn has no business rewriting, and demanding
// equality on it would test the copy, not the decision. Field names here are the arm's own, so
// renaming or re-typing an executor field breaks this witness.
fn route_matches_the_catalog_row(
  blocker: PreparationBlockingOn,
  route: FirmwareNetworkBootPreparationRoute
) -> Bool {
  match list_head(xs: catalog_rows_for(blocker: blocker)) {
    Present { value: row } => mechanism_name(route: row) == mechanism_name(route: route)
      && field_pairs_agree(route_a: row, route_b: route)
    Absent => false
  }
}

// THE PREFERRED ROW FOR A BLOCKER, computed by the WITNESS from the public catalog data. The module
// used to own this lookup and hand back an unbound row; deleting it is part of blocker 3, so the
// witness must not be left asserting a lookup the module no longer makes, and must not read the
// answer back out of the module either. `catalog_rows_for` filters on `blocker_of`, catalog order is
// preserved, and the head is the fleet's declared preference.
fn preferred_row(blocker: PreparationBlockingOn) -> Optional<FirmwareNetworkBootPreparationRoute> {
  list_head(xs: catalog_rows_for(blocker: blocker))
}

// THE CATALOG ROW'S OWN SLOT, as the fleet wrote it. Used where a claim is about the CATALOG (is the
// slot an honest absence?) rather than about a bound route.
fn catalog_slot(blocker: PreparationBlockingOn) -> Optional<FirmwareMechanismName> {
  match preferred_row(blocker: blocker) {
    Present { value: EnableNetworkStack { service_root: _, attribute: a, authority: _ } } =>
      Present { value: a }
    Present { value: PointUefiBootNext { service_root: _, boot_option: b, authority: _ } } =>
      Present { value: b }
    Present { value: SelectNicBoot { service_root: _, attribute: a, authority: _ } } =>
      Present { value: a }
    Present { value: SetSecureBootAttribute { service_root: _, attribute: a, authority: _ } } =>
      Present { value: a }
    // The four rows with no firmware-side name. `Absent` here means 'nothing to compare', and callers
    // that expect a slot must name the arm they are asking about rather than accept this.
    Present { value: RedfishOneShotOverride { service_root: _, authority: _ } } => Absent
    Present { value: IpmiOneShotOverride { channel: _, authority: _ } } => Absent
    Present { value: UefiShellOverSol { sol_channel: _, shell_script: _, authority: _ } } => Absent
    Present { value: HumanConsole { instruction: _, authority: _ } } => Absent
    Absent => Absent
  }
}

// IS THE CATALOG STILL HONEST ABOUT WHAT IT DOES NOT KNOW. An attribute slot on a fleet row must be
// an UNBOUND slot naming the read that would resolve it. A row that arrived pre-bound -- somebody
// typed a plausible vendor key into the catalog -- is the defect blocker 3 exists for, and this is
// the assertion that catches it without needing a unit to reason about.
fn catalog_slot_is_an_honest_absence(blocker: PreparationBlockingOn) -> Bool {
  match catalog_slot(blocker: blocker) {
    Present { value: MechanismNameUnbound { owed_read: owed } } =>
      length(xs: owed) > 0
        && (string_contains(s: owed, pattern: "read")
          || string_contains(s: owed, pattern: "GET")
          || string_contains(s: owed, pattern: "enumerat"))
    // A BOUND SLOT IN THE CATALOG. Legitimate only once an operator has accepted a cited attribute read
    // into the row, and then the citation is the thing under review -- so this arm is deliberately
    // false: it fails until the test that wants it says so explicitly, rather than quietly passing
    // whenever a row happens to have been filled in.
    Present { value: MechanismNameBound { value: _, grounded_by: _ } } => false
    Absent => false
  }
}

// THE BINDER, CALLED THE WAY THE FOLD CALLS IT. A separate witness fn so that every blocker-3 claim
// below states the two binding inputs it is relying on -- an unlisted input would otherwise let a
// test pass because of a default it never declared.
fn bind_the_preferred_row(
  blocker: PreparationBlockingOn,
  redirect_to: RedirectTargetStanding,
  observed_bios_version: Optional<NonEmptyStr>
) -> RouteBindingStanding {
  match preferred_row(blocker: blocker) {
    Present { value: row } => bind_route_from(
      route: row,
      redirect_to: redirect_to,
      observed_bios_version: observed_bios_version,
    )
    // NO ROW: the binder is not the thing under test here, and inventing a standing would be the
    // witness grading its own homework. A caller that reaches this has asked about a blocker with no
    // mechanism, which is a different test.
    Absent => BindingRefused {
      refusal: RouteBindingUnresolvedRoute {
        mechanism: "no-row",
        owed_read: "the catalog has no row for this blocker",
      },
    }
  }
}

// THE BINDING INPUTS THE FIXTURE UNIT ACTUALLY HAS, derived by the module's own fold from the
// fixture's own lists. Deliberately not a literal: a test that wanted the redirect to point at
// "0002" would be asserting the wish, not the join.
fn fixture_redirect(join: HeadJoinStanding, available: AvailableNetworkStanding) -> RedirectTargetStanding {
  redirect_target(join: join, available: available)
}


// COMPARES WHAT THE EXECUTOR READS, NEVER THE CITATION. The fold is handed the catalog row's
// authority and has no business rewriting it, so comparing citations would test the copy rather than
// the decision -- which is why the fallback used to be whole-value equality and silently failed for
// every arm not spelled out above it: whole-value equality includes `authority`, and the row's
// citation is the module's while the test builds its route with the witness's.
//
// ALL EIGHT ARMS ARE NAMED (no `_ =>`, per the rule this module applies to itself): a new arm or a
// renamed executor field is a compile error here instead of a comparison that quietly returns false
// and points the reader at the fold.
fn field_pairs_agree(route_a: FirmwareNetworkBootPreparationRoute, route_b: FirmwareNetworkBootPreparationRoute) -> Bool {
  match route_a {
    // THE SLOTS ARE COMPARED AS SLOTS, NOT AS STRINGS. The catalog's slot is an honest absence and the
    // emitted route's is a read, so whole-value equality would compare the copy and never the decision
    // -- and it is exactly the comparison that used to pin the literal "uefi-boot-next" onto every unit
    // in the fleet. `slot_agrees_with_catalog` is the honest version of the same claim.
    EnableNetworkStack { service_root: sa, attribute: aa, authority: _ } =>
      match route_b {
        EnableNetworkStack { service_root: sb, attribute: ab, authority: _ } =>
          sa == sb && slot_agrees_with_catalog(catalog_slot: aa, emitted_slot: ab)
        _ => false
      }
    PointUefiBootNext { service_root: sa, boot_option: ba, authority: _ } =>
      match route_b {
        PointUefiBootNext { service_root: sb, boot_option: bb, authority: _ } =>
          sa == sb && slot_agrees_with_catalog(catalog_slot: ba, emitted_slot: bb)
        _ => false
      }
    RedfishOneShotOverride { service_root: sa, authority: _ } =>
      match route_b {
        RedfishOneShotOverride { service_root: sb, authority: _ } => sa == sb
        _ => false
      }
    IpmiOneShotOverride { channel: ca, authority: _ } =>
      match route_b {
        IpmiOneShotOverride { channel: cb, authority: _ } => ca == cb
        _ => false
      }
    SelectNicBoot { service_root: sa, attribute: aa, authority: _ } =>
      match route_b {
        SelectNicBoot { service_root: sb, attribute: ab, authority: _ } =>
          sa == sb && slot_agrees_with_catalog(catalog_slot: aa, emitted_slot: ab)
        _ => false
      }
    SetSecureBootAttribute { service_root: sa, attribute: aa, authority: _ } =>
      match route_b {
        SetSecureBootAttribute { service_root: sb, attribute: ab, authority: _ } =>
          sa == sb && slot_agrees_with_catalog(catalog_slot: aa, emitted_slot: ab)
        _ => false
      }
    UefiShellOverSol { sol_channel: ca, shell_script: xa, authority: _ } =>
      match route_b {
        UefiShellOverSol { sol_channel: cb, shell_script: xb, authority: _ } => ca == cb && xa == xb
        _ => false
      }
    HumanConsole { instruction: ia, authority: _ } =>
      match route_b {
        HumanConsole { instruction: ib, authority: _ } => ia == ib
        _ => false
      }
  }
}

// EVERY BLOCKER THE SEAM CAN NAME HAS A ROUTE, IT IS FOUND BY LOOKUP, AND IT IS THE ROUTE THAT
// CAN MOVE THAT BLOCKER. This replaces the old round-trip test (which hand-compared a fabricated
// route against the catalog through a hand-written route_eq): with one union there is nothing to
// translate, so what is worth asserting is that the fold's lookups land where the fleet intends.
// Each expectation is written by ARM, so renaming an arm or mis-deriving its blocker fails here.
test fn each_blocker_resolves_to_the_mechanism_the_fleet_actually_drives() -> Bool {
  // WHAT STAYS PINNED IS WHAT THE FLEET OWNS: the service root, the channel, the arm. What used to be
  // pinned here -- `attribute == "NetworkStack"`, `boot_option == "uefi-boot-next"` -- was the fleet
  // asserting a firmware-side NAME it had never read, and the second of those was handed to every unit
  // in the fleet verbatim. Those literals are gone, and the assertion that replaces them is stronger:
  // the slot must be an HONEST ABSENCE that names the read which would resolve it. A row edited back to
  // a plausible key now fails here, where before it was exactly what passed.
  match preferred_row(blocker: NetworkBootOptionAbsent) {
    Present { value: EnableNetworkStack { service_root: sr, attribute: _, authority: _ } } =>
      sr == "redfish:Bios" && catalog_slot_is_an_honest_absence(blocker: NetworkBootOptionAbsent)
    _ => false
  }
    && match preferred_row(blocker: NetworkBootOptionNotSelected) {
         // The fleet's PREFERENCE is the first row for a blocker, and preference is a fact worth
         // pinning: silently reordering this table changes which control plane every MegaRAC unit
         // gets pointed at, and nothing else in the diff would say so.
         Present { value: PointUefiBootNext { service_root: sr, boot_option: bo, authority: _ } } =>
           sr == "redfish:Systems/Self"
             // THE CENTERPIECE OF BLOCKER 3, as a catalog claim: no redirect row may carry a name. If
             // a literal comes back into this row, every unit in the fleet is pointed at the same
             // invented option reference again, and this arm is what says so.
             && match bo {
                MechanismNameUnbound { owed_read: owed } =>
                  string_contains(s: owed, pattern: "BootOptionReference")
                MechanismNameBound { value: _, grounded_by: _ } => false
              }
         _ => false
       }
    && match preferred_row(blocker: NoInterfaceCarriesPxe) {
         // THE 81711 REGRESSION GUARD, in its final form: this blocker must never be answered by a
         // redirect. A one-shot points the next boot at an entry that already exists and cannot
         // decide which PORT carries PXE, so if anyone re-files this row the arm name itself differs.
         Present { value: r } =>
           match r {
             SelectNicBoot { service_root: sr, attribute: _, authority: _ } =>
               sr == "redfish:Bios" && catalog_slot_is_an_honest_absence(blocker: NoInterfaceCarriesPxe)
             RedfishOneShotOverride { service_root: _, authority: _ } => false
             IpmiOneShotOverride { channel: _, authority: _ } => false
             PointUefiBootNext { service_root: _, boot_option: _, authority: _ } => false
             _ => false
           }
         Absent => false
       }
    && match preferred_row(blocker: SecureBootBlocksUnsignedChainloader) {
         Present { value: SetSecureBootAttribute { service_root: sr, attribute: _, authority: _ } } =>
           sr == "redfish:Bios"
             && catalog_slot_is_an_honest_absence(blocker: SecureBootBlocksUnsignedChainloader)
         _ => false
       }
    && match preferred_row(blocker: OverrideMechanismUnsupported) {
         // THE LAST-RESORT ROWS HAVE NO FIRMWARE-SIDE NAME TO GET WRONG: a SOL channel is a BMC fact
         // the site owns and a console instruction is prose for a person, so these stay pinned as-is.
         Present { value: UefiShellOverSol { sol_channel: sc, shell_script: _, authority: _ } } =>
           sc == "sol:0"
         _ => false
       }
}

// THE CATALOG IS A SET, NOT A BAG: no two rows are the same route, no two rows share a mechanism
// name, and every row is findable under the blocker its own arm declares. The distinctness arms are
// what a duplicate row -- the shape a careless 'add another mechanism' edit takes -- breaks.
test fn the_catalog_has_no_duplicate_route_and_no_nameless_mechanism() -> Bool {
  length(xs: firmware_network_boot_preparation_routes) == 8
    && for_all(
         xs: firmware_network_boot_preparation_routes,
         predicate: route =>
           length(xs: filter(firmware_network_boot_preparation_routes, candidate => candidate == route)) == 1
             && length(xs: filter(firmware_network_boot_preparation_routes, candidate => mechanism_name(route: candidate) == mechanism_name(route: route))) == 1
             && length(xs: filter(firmware_network_boot_preparation_routes, candidate => blocker_of(route: candidate) == blocker_of(route: route))) > 0,
       )
    && length(xs: filter(firmware_network_boot_preparation_routes, route => blocker_of(route: route) == NetworkBootOptionNotSelected)) == 3
}

// THE CATALOG IS NOT A HOST TABLE: rows are keyed on the route and every row carries an
// authority; a row that lost its citation would turn "the fleet knows this mechanism" into
// "somebody once said this works".
test fn the_catalog_rows_are_route_keyed_and_each_carries_an_authority() -> Bool {
  count_cataloged(firmware_network_boot_preparation_routes)
}

fn count_cataloged(rows: List<FirmwareNetworkBootPreparationRoute>) -> Bool {
  for_all(xs: rows, predicate: route => route_has_authority(route: route))
}

fn route_has_authority(route: FirmwareNetworkBootPreparationRoute) -> Bool {
  match authority_of(route: route) {
    CitedToAuthority { authority: _ } => true
    TranscribedUncited { read_obligation: _ } => true
    ObservedByReceipt { observed: _ } => true
  }
}

// THE CALLER CANNOT STEER AN ATTEMPT (review 81760). `network_boot_attempt` used to accept a free
// route and check it against the catalog at runtime; it now accepts the BLOCKER and the module
// supplies the mechanism by lookup, so 'an attempt on a route the fleet has no row for' is not a
// refused case any more -- it is not a case. That is the stronger property and it is what is
// asserted: for every blocker the attempt's route is exactly the cataloged one, and the blocker it
// carries is the one asked for. The refusal arm (AttemptBlockerUncataloged) stays reachable only to
// an edit that deletes a catalog row, which every_blocker_has_a_route_that_can_act_on_it refuses.
test fn an_attempt_can_only_ever_carry_the_cataloged_route_for_its_blocker() -> Bool {
  attempt_carries_the_fleet_route(blocker: NetworkBootOptionAbsent)
    && attempt_carries_the_fleet_route(blocker: NetworkBootOptionNotSelected)
    && attempt_carries_the_fleet_route(blocker: NoInterfaceCarriesPxe)
    && attempt_carries_the_fleet_route(blocker: SecureBootBlocksUnsignedChainloader)
    && attempt_carries_the_fleet_route(blocker: OverrideMechanismUnsupported)
}

fn attempt_carries_the_fleet_route(blocker: PreparationBlockingOn) -> Bool {
  match network_boot_attempt(
    blocker: blocker,
    join: fixture_join(),
    available: fixture_available(),
    observed_bios_version: present(version: "1.08"),
    boot_control: BootControlUnobserved,
    reset_observed_at: witness_epoch,
    resulting_dhcp: DhcpOfferObserved { offer_ref: "synthetic-offer" },
    unit_label: "synthetic-unit",
  ) {
    AttemptConstructed { attempt: built } =>
      // The route is in the table, and it is the SAME route the fold would hand out for this
      // blocker. Compared through route_matches_the_catalog_row rather than by whole-value `==` on
      // an Optional-of-union: structural equality is verified working on unions of records and bare
      // unions, and nesting a union inside Optional defeats it -- a toolchain limit noted so nobody
      // reads the failure as a modeling problem.
      is_a_fleet_route(route: built.route)
        && route_matches_the_catalog_row(blocker: blocker, route: built.route)
        && blocker_of(route: built.route) == blocker
    AttemptBlockerUncataloged { blocker: _ } => false
    AttemptRouteUnbound { blocker: _, mechanism: _, refusal: _ } => false
  }
}

// MACHINE NAMES NEVER SELECT (operator policy), and this module is where a name could sneak in: the
// attempt record carries `unit_label`, the one string in the fold's output. Nothing in the module
// branches on it -- but "nothing branches on it" is exactly the kind of claim that survives a
// refactor as a comment. So the property is pinned two ways: two attempts that differ ONLY in the
// label must agree on every field that decides what the fleet does next, and two attempts that share
// a label but differ in blocker must NOT agree on the route. Without this, replacing `unit_label`
// with a constant, or reading it into route selection, would leave all 40 witnesses green -- the
// first would attribute an mtcollins1 boot to owen while every decision-relevant field still read
// correct.
test fn a_machine_name_never_selects_the_route_and_is_never_defaulted() -> Bool {
  // Same everything except the name: the name must not move the route, the reset, the control
  // standing, or the DHCP.
  labels_are_inert_in_selection(
    blocker: NetworkBootOptionAbsent,
    first: "mtcollins1",
    second: "owen",
  )
    && labels_are_inert_in_selection(
      blocker: SecureBootBlocksUnsignedChainloader,
      first: "mtjade1",
      second: "board-5",
    )
    // ...and the label is carried VERBATIM, never defaulted to a plausible host. This is the half
    // that makes the first half mean anything: if both attempts silently carried "mtcollins1", they
    // would agree on every field AND lose the finding.
    && the_two_labels_arrive_unchanged()
    // Same name, different blocker -> different route. The blocker selects; the name never does.
    && same_name_different_blocker_changes_the_route()
}

fn labels_are_inert_in_selection(
  blocker: PreparationBlockingOn,
  first: NonEmptyStr,
  second: NonEmptyStr,
) -> Bool {
  match network_boot_attempt(
    blocker: blocker,
    join: fixture_join(),
    available: fixture_available(),
    observed_bios_version: present(version: "1.08"),
    boot_control: BootControlUnobserved,
    reset_observed_at: witness_epoch,
    resulting_dhcp: DhcpOfferObserved { offer_ref: "synthetic-offer" },
    unit_label: first,
  ) {
    AttemptConstructed { attempt: left } =>
      match network_boot_attempt(
        blocker: blocker,
        join: fixture_join(),
        available: fixture_available(),
        observed_bios_version: present(version: "1.08"),
        boot_control: BootControlUnobserved,
        reset_observed_at: witness_epoch,
        resulting_dhcp: DhcpOfferObserved { offer_ref: "synthetic-offer" },
        unit_label: second,
      ) {
        AttemptConstructed { attempt: right } =>
          left.route == right.route
            && left.reset_observed_at == right.reset_observed_at
            && left.boot_control == right.boot_control
            && left.resulting_dhcp == right.resulting_dhcp
            // The two labels must be observably different, or the agreement above is vacuous.
            && !(left.unit_label == right.unit_label)
        AttemptBlockerUncataloged { blocker: _ } => false
    AttemptRouteUnbound { blocker: _, mechanism: _, refusal: _ } => false
      }
    AttemptBlockerUncataloged { blocker: _ } => false
    AttemptRouteUnbound { blocker: _, mechanism: _, refusal: _ } => false
  }
}

fn the_two_labels_arrive_unchanged() -> Bool {
  match network_boot_attempt(
    blocker: NoInterfaceCarriesPxe,
    join: fixture_join(),
    available: fixture_available(),
    observed_bios_version: present(version: "1.08"),
    boot_control: BootControlUnobserved,
    reset_observed_at: witness_epoch,
    resulting_dhcp: DhcpOfferObserved { offer_ref: "synthetic-offer" },
    unit_label: "mtcollins1",
  ) {
    AttemptConstructed { attempt: built } => built.unit_label == "mtcollins1"
    AttemptBlockerUncataloged { blocker: _ } => false
    AttemptRouteUnbound { blocker: _, mechanism: _, refusal: _ } => false
  }
}

fn same_name_different_blocker_changes_the_route() -> Bool {
  match network_boot_attempt(
    blocker: NetworkBootOptionAbsent,
    join: fixture_join(),
    available: fixture_available(),
    observed_bios_version: present(version: "1.08"),
    boot_control: BootControlUnobserved,
    reset_observed_at: witness_epoch,
    resulting_dhcp: DhcpOfferObserved { offer_ref: "synthetic-offer" },
    unit_label: "mtcollins1",
  ) {
    AttemptConstructed { attempt: authoring } =>
      match network_boot_attempt(
        // The SAME name, a different blocker: a redirect, not a persistent write. If a name ever
        // selected, these two would agree and the attempt would drive the wrong mechanism.
        blocker: NetworkBootOptionNotSelected,
        join: fixture_join(),
        available: fixture_available(),
        observed_bios_version: present(version: "1.08"),
        boot_control: BootControlUnobserved,
        reset_observed_at: witness_epoch,
        resulting_dhcp: DhcpOfferObserved { offer_ref: "synthetic-offer" },
        unit_label: "mtcollins1",
      ) {
        AttemptConstructed { attempt: redirect } =>
          !(authoring.route == redirect.route)
            && authoring.unit_label == redirect.unit_label
        AttemptBlockerUncataloged { blocker: _ } => false
    AttemptRouteUnbound { blocker: _, mechanism: _, refusal: _ } => false
      }
    AttemptBlockerUncataloged { blocker: _ } => false
    AttemptRouteUnbound { blocker: _, mechanism: _, refusal: _ } => false
  }
}

fn boot_control_is_the_imported_standing(control: BootControlReceiptStanding) -> Bool {
  match control {
    BootControlUnobserved => true
    BootControlObserved { receipt: _ } => false
    BootControlPredecessor { observation: _ } => false
  }
}

test fn the_attempt_receipt_cannot_be_minted_without_its_attempt_and_control_receipt() -> Bool {
  match synthetic_attempt() {
    AttemptConstructed { attempt: built } => boot_control_is_the_imported_standing(control: built.boot_control)
    AttemptBlockerUncataloged { blocker: _ } => false
    AttemptRouteUnbound { blocker: _, mechanism: _, refusal: _ } => false
  }
}

// THE BINDING INPUTS FOR EVERY SYNTHETIC ATTEMPT, derived from the same fixtures the readiness tests
// use. Deliberately DERIVED rather than typed out: the redirect target the mint derives has to be the
// reference the fixture's own enumeration carries, and if the witness hand-wrote a reference it would
// be asserting a route it chose, which is the thing under test.
fn fixture_join() -> HeadJoinStanding {
  join_head_to_options(devices: network_then_disk(), options: good_options())
}

fn fixture_available() -> AvailableNetworkStanding {
  available_network_options(options: good_options())
}

// THE OBSERVED VERSION, in the shape the mint wants. Named once because a stale-version witness and a
// current-version witness must differ by exactly one token and nothing else.
fn present(version: NonEmptyStr) -> Optional<NonEmptyStr> {
  Present { value: version }
}

fn no_version_read() -> Optional<NonEmptyStr> {
  Absent
}

fn synthetic_attempt() -> NetworkBootAttemptConstruction {
  network_boot_attempt(
    blocker: NetworkBootOptionNotSelected,
    join: fixture_join(),
    available: fixture_available(),
    observed_bios_version: present(version: "1.08"),
    boot_control: BootControlUnobserved,
    reset_observed_at: witness_epoch,
    resulting_dhcp: DhcpOfferObserved { offer_ref: "synthetic-offer" },
    unit_label: "synthetic-unit",
  )
}

// THE READY'S EVIDENCE IS THE OBSERVATION ITSELF: the constructor keeps what it checked, so a
// later reader can re-derive the verdict instead of trusting the tag.
test fn ready_evidence_preserves_the_observation_it_was_computed_from() -> Bool {
  let observation = good_observation()
  match firmware_network_boot_standing(
    observation: observation,
    authority: witness_authority,
    observed_at: witness_epoch,
    boot_mode: UefiHttpBoot,
  ) {
    Ready { firmware_mode: UefiHttpBoot, network_interface: _, boot_target: _, evidence: ev } =>
      ev.observed_at == witness_epoch
        && match ev.observation.bios_version {
             BiosVersionObserved { version: v } => v == "1.08"
             _ => false
           }
    _ => false
  }
}

// THE SEAM CANNOT MINT A MODE, ONLY CARRY ONE (review 81689). The same edge-facts-bearing
// observation, offered to the seam with each of the two UEFI modes, yields a Ready carrying the
// mode it was handed and nothing else: no second protocol field exists to contradict it, and the
// seam has no TFTP root or URL of its own to fill one. If a site constant ever reappears in the
// seam, or a second axis reappears beside the mode, THIS test cannot still pass, because the
// match below names the arm's fields exactly.
test fn the_seam_carries_the_edge_mode_it_was_given_and_adds_none_of_its_own() -> Bool {
  match firmware_network_boot_standing(
    observation: good_observation(),
    authority: witness_authority,
    observed_at: witness_epoch,
    boot_mode: UefiHttpBoot,
  ) {
    Ready { firmware_mode: UefiHttpBoot, network_interface: _, boot_target: _, evidence: _ } =>
      match firmware_network_boot_standing(
        observation: good_observation(),
        authority: witness_authority,
        observed_at: witness_epoch,
        boot_mode: UefiPxe { tftp_root: uri_https(locator: "edge.invalid/pxe") },
      ) {
        Ready { firmware_mode: UefiPxe { tftp_root: _ }, network_interface: _, boot_target: _, evidence: _ } => true
        _ => false
      }
    _ => false
  }
}

// A LEGACY-BIOS UNIT IS REFUSED, NOT SILENTLY READY: the cut-6 edge serves UEFI only, so the
// honest standing is a refusal naming the edge as the limitation. It must not read Unobserved (we
// know the mode and we know our edge) and must not read Ready (it would boot nothing).
test fn a_legacy_bios_unit_is_refused_because_the_edge_cannot_serve_it() -> Bool {
  match firmware_network_boot_standing(
    observation: good_observation(),
    authority: witness_authority,
    observed_at: witness_epoch,
    boot_mode: LegacyBiosPxe { tftp_root: uri_https(locator: "edge.invalid/pxe") },
  ) {
    Refused { cause: FirmwareModeUnsupportedByEdge { why: _ }, gaps: _ } => true
    _ => false
  }
}

// A READY'S INTERFACE IS THE SINGLE OBSERVED NIC, verbatim, lowercased not by us: the seam does
// not rewrite firmware spellings, because then the receipt would name something the firmware
// never said.
test fn the_ready_names_the_firmware_spelled_interface_verbatim() -> Bool {
  match standing_of(observation: with_nics(nics: NicsObserved { nics: ["NIC-Port-1"] })) {
    Ready { firmware_mode: _, network_interface: nic, boot_target: _, evidence: _ } => nic == "NIC-Port-1"
    _ => false
  }
}

// THE ATTEMPT RECEIPT IS NOT MINTABLE WITHOUT ALL THREE PARTS. The receipt type is
// sole_constructor, and the only way through it is an attempt, the standing that resulted, and
// gunbc.network_boot_delivery's own boot-control receipt. This test mints the foreign-offer
// case specifically: an attempt whose reset produced an offer from SOMEONE ELSE (another edge,
// or the router answering when it should not be) still receipts completely, because 'the boot
// went wrong in this specific way' is a fact worth keeping, not a reason to lose the receipt.
test fn the_attempt_receipt_keeps_the_outcome_and_the_foreign_offer_too() -> Bool {
  match synthetic_attempt() {
    AttemptConstructed { attempt: built } =>
      match firmware_network_boot_attempt_receipt(
        attempt: built,
        outcome: Refused {
        cause: FirmwareModeUnsupportedByEdge { why: "edge serves UEFI only" },
        gaps: [],
      },
      ) {
        receipt =>
          match receipt.attempt.resulting_dhcp {
            DhcpOfferObserved { offer_ref: _ } => true
            _ => false
          }
            && match receipt.outcome {
                 Refused { cause: FirmwareModeUnsupportedByEdge { why: _ }, gaps: _ } => true
                 _ => false
               }
      }
    AttemptBlockerUncataloged { blocker: _ } => false
    AttemptRouteUnbound { blocker: _, mechanism: _, refusal: _ } => false
  }
}

// The foreign/silent DHCP standings are distinct facts (no packet vs. someone else answered) and
// both must survive an attempt unchanged — collapsing them is how 'two edges are both answering'
// gets reported as 'PXE is broken'.
test fn the_dhcp_standing_survives_the_attempt_unchanged_and_distinguishes_silence_from_foreign() -> Bool {
  match network_boot_attempt(
    blocker: NetworkBootOptionNotSelected,
    join: fixture_join(),
    available: fixture_available(),
    observed_bios_version: present(version: "1.08"),
    boot_control: BootControlUnobserved,
    reset_observed_at: witness_epoch,
    resulting_dhcp: DhcpForeignOffer { observed_from: "192.0.2.9" },
    unit_label: "synthetic-unit",
  ) {
    AttemptConstructed { attempt: built } =>
      match built.resulting_dhcp {
        DhcpForeignOffer { observed_from: seen } => seen == "192.0.2.9"
        DhcpSilent { why: _ } => false
        DhcpOfferObserved { offer_ref: _ } => false
      }
    AttemptBlockerUncataloged { blocker: _ } => false
    AttemptRouteUnbound { blocker: _, mechanism: _, refusal: _ } => false
  }
    && match network_boot_attempt(
         blocker: NetworkBootOptionNotSelected,
         join: fixture_join(),
         available: fixture_available(),
         observed_bios_version: present(version: "1.08"),
         boot_control: BootControlUnobserved,
         reset_observed_at: witness_epoch,
         resulting_dhcp: DhcpSilent { why: "no offer within timeout" },
         unit_label: "synthetic-unit",
       ) {
         AttemptConstructed { attempt: built } =>
           match built.resulting_dhcp {
             DhcpSilent { why: w } => w == "no offer within timeout"
             _ => false
           }
         AttemptBlockerUncataloged { blocker: _ } => false
    AttemptRouteUnbound { blocker: _, mechanism: _, refusal: _ } => false
       }
}

// ─────────────────────────────────────────────────────────────────────────────
// REVIEW 81689 FINDINGS 4 AND 5, MADE TESTABLE. The type grew to carry every
// unanswered axis and to keep gaps alongside a refusal; a bigger type that
// nothing asserts is a bigger lie waiting to happen. These are the assertions.
// ─────────────────────────────────────────────────────────────────────────────

fn names_boot_order_axis(gap: UnansweredAxis) -> Bool {
  match gap {
    BootOrderAxisUnanswered { absence: _ } => true
    _ => false
  }
}

fn names_secure_boot_axis(gap: UnansweredAxis) -> Bool {
  match gap {
    SecureBootAxisUnanswered { absence: _ } => true
    _ => false
  }
}

fn names_bios_axis(gap: UnansweredAxis) -> Bool {
  match gap {
    BiosAxisUnanswered { absence: _ } => true
    _ => false
  }
}

// THE GAP LIST IS NOT A SINGLE-ELEMENT LIST IN DISGUISE. Secure Boot and BIOS both
// unanswered on one unit must appear as two gaps: the report line the type promises
// ('three units were never asked about Secure Boot') is unanswerable if only the
// first axis ever survives the fold.
test fn every_unanswered_axis_survives_the_fold_not_just_the_first() -> Bool {
  let observation = firmware_boot_observation(
    boot_order: BootOrderObserved { devices: [pxe_entry()] },
    boot_options: BootOptionsObserved { options: [opt_pxe(ref_pxe())] },
    nics: NicsObserved { nics: ["eth0"] },
    secure_boot: SecureBootUnobserved { reason: "family cannot answer" },
    bios_version: BiosVersionUnobserved { reason: "no reader" },
  )
  match firmware_network_boot_standing(
    observation: observation,
    authority: witness_authority,
    observed_at: witness_epoch,
    boot_mode: UefiHttpBoot,
  ) {
    Unobserved { unanswered: gaps } =>
      any(gaps, g => names_secure_boot_axis(gap: g)) && any(gaps, g => names_bios_axis(gap: g))
    _ => false
  }
}

// A REFUSAL MUST NOT SWALLOW THE UNKNOWN. When boot order was refused and Secure
// Boot was never asked, the operator needs BOTH facts in one visit: the refusal to
// chase and the gap to go ask about. The pre-review shape returned the refusal and
// silently dropped the Secure Boot unknown.
test fn a_refusal_keeps_its_cause_and_reports_the_unasked_axes_too() -> Bool {
  let observation = firmware_boot_observation(
    boot_order: BootOrderRefused { refusal: VendorCommandRejected { detail: "ipmi vendor command rejected" } },
    boot_options: BootOptionsObserved { options: good_options() },
    nics: NicsObserved { nics: ["eth0"] },
    secure_boot: SecureBootUnobserved { reason: "never asked" },
    bios_version: BiosVersionObserved { version: "1.08" },
  )
  match firmware_network_boot_standing(
    observation: observation,
    authority: witness_authority,
    observed_at: witness_epoch,
    boot_mode: UefiHttpBoot,
  ) {
    Refused { cause: TransportRefusedVendorCommand { refusal: VendorCommandRejected { detail: d } }, gaps: gaps } =>
      d == "ipmi vendor command rejected"
        && any(gaps, g => names_boot_order_axis(gap: g))
        && any(gaps, g => names_secure_boot_axis(gap: g))
    _ => false
  }
}

// NOT-ASKED AND REFUSED ARE DIFFERENT KINDS OF MISSING, per axis: a probe coverage
// gap and a transport denial must be countable apart, or 'BMC will not answer' gets
// filed as 'nobody ran the probe' and nobody goes to fix the BMC.
test fn the_kind_of_absence_is_typed_per_axis() -> Bool {
  let observation = firmware_boot_observation(
    boot_order: BootOrderObserved { devices: [pxe_entry()] },
    boot_options: BootOptionsObserved { options: [opt_pxe(ref_pxe())] },
    nics: NicsObserved { nics: ["eth0"] },
    secure_boot: SecureBootUnobserved { reason: "never asked" },
    bios_version: BiosVersionRefused { refusal: AuthenticationRequired { detail: "credentials absent" } },
  )
  match firmware_network_boot_standing(
    observation: observation,
    authority: witness_authority,
    observed_at: witness_epoch,
    boot_mode: UefiHttpBoot,
  ) {
    Refused { cause: TransportRefusedVendorCommand { refusal: AuthenticationRequired { detail: d } }, gaps: gaps } =>
      d == "credentials absent"
        && any(gaps, g => gap_was_not_asked(gap: g))
        && any(gaps, g => gap_was_refused(gap: g))
    _ => false
  }
}

fn gap_was_not_asked(gap: UnansweredAxis) -> Bool {
  match gap {
    SecureBootAxisUnanswered { absence: AxisNotAsked { reason: _ } } => true
    _ => false
  }
}

fn gap_was_refused(gap: UnansweredAxis) -> Bool {
  match gap {
    BiosAxisUnanswered { absence: AxisRefused { refusal: _ } } => true
    _ => false
  }
}

// THE ROUTE MUST BE ABLE TO FIX WHAT IT CLAIMS IS BLOCKING. A boot order full of
// non-network entries cannot be fixed by a one-shot override: an override only
// THE CASE THE OLD FOLD GOT BACKWARDS, AND THE STRONGEST EVIDENCE THE SPLIT WAS NEEDED. This unit
// LISTS an HTTP boot option (BootOptions answers 'yes, one exists') and simply does not boot from
// it (BootOrder names three disks). That is 'exists, not selected', so the answer is a one-shot
// REDIRECT -- one boot, nothing persists, no consent needed. The old fold tested BootOrder first and
// called this 'no network stack', sending an operator to make a PERSISTENT BIOS ATTRIBUTE WRITE on a
// board that needed nothing of the kind: same-looking plan, opposite blast radius, chosen by which
// list happened to be tested first. So this test asserts both halves: the redirect is chosen, AND the
// persistent authoring route is not.
test fn an_option_that_exists_but_is_not_selected_gets_a_redirect_not_a_persistent_write() -> Bool {
  let observation = firmware_boot_observation(
    boot_order: BootOrderObserved {
      devices: [entry(reference: "0003", label: "NVMe0"), entry(reference: "0004", label: "NVMe1"), entry(reference: "0005", label: "SATA0")],
    },
    // An ENABLED network option EXISTS (0001 http) but the order does not select it: that is 'not
    // selected', answered by a redirect. The enumeration must also contain the order's head (0003,
    // an enabled disk) -- otherwise the head is unenumerated and this fixture would test the
    // disagreement refusal instead. This is exactly the distinction the old seam could not express:
    // head-joins-disk + network-option-exists = redirect; head-joins-disk + none-exists = author.
    boot_options: BootOptionsObserved { options: [opt_disk("0003"), opt_http(ref_http())] },
    nics: NicsObserved { nics: ["eth0"] },
    secure_boot: SecureBootDisabled,
    bios_version: BiosVersionObserved { version: "1.08" },
  )
  match firmware_network_boot_standing(
    observation: observation,
    authority: witness_authority,
    observed_at: witness_epoch,
    boot_mode: UefiHttpBoot,
  ) {
    NeedsPreparation { route: PointUefiBootNext { service_root: s, boot_option: bo, authority: _ }, blocking: b } =>
      s == "redfish:Systems/Self"
        // THE CENTERPIECE OF BLOCKER 3. The OLD assertion here was `bo == "uefi-boot-next"` -- the
        // catalog's literal, handed to every unit in the fleet, which is not a BootOptionReference at
        // all but a string shaped like one, and an executor would have pointed this board's next-boot
        // variable at it. The reference now has to be the one THIS unit enumerated: 0001 is the HTTP
        // option in this fixture's own BootOptions, and no other value is legitimate. The grounding is
        // asserted alongside it because a bare string in that field proves nothing about where it came
        // from -- and 'where did this name come from' is the entire question.
        && match bo {
             MechanismNameBound {
               value: v,
               grounded_by: GroundedByBootOptionEnumeration,
             } => v == ref_http()
             // AN UNBOUND SLOT MEANS NO ROUTE SHOULD HAVE BEEN EMITTED AT ALL.
             MechanismNameUnbound { owed_read: _ } => false
           }
        && match b {
             NetworkBootOptionNotSelected => route_matches_the_catalog_row(
               blocker: NetworkBootOptionNotSelected,
               route: PointUefiBootNext { service_root: s, boot_option: bo, authority: witness_authority },
             )
             _ => false
           }
    // The persistent authoring route reaching this unit is the defect; naming it here is what makes
    // the test fail on the wrong remedy rather than merely on the absence of the right one.
    NeedsPreparation { route: EnableNetworkStack { service_root: _, attribute: _, authority: _ }, blocking: _ } => false
    _ => false
  }
}

// THE OTHER HALF OF THE SPLIT: nothing exists, so a redirect is not offered even though three of the
// eight rows are redirects and the fold could have picked one -- the mechanism that would be picked is
// the one that CREATES an option, and blocker 3 means it cannot be named yet, so this unit is refused
// with the authoring mechanism named in the cause. Under the old single blocker these two tests
// described the same state and got the same route; they now describe two states and get two different
// answers, which is what the split is for. THE NAME MATTERS: an earlier version promised 'the authoring
// route', which is what the seam used to hand out unexamined -- a reader taking the name at face value
// would expect a route here and find a refusal.
test fn an_absent_option_names_the_authoring_mechanism_and_never_a_redirect() -> Bool {
  let observation = firmware_boot_observation(
    boot_order: BootOrderObserved {
      devices: [entry(reference: "0003", label: "NVMe0"), entry(reference: "0004", label: "NVMe1"), entry(reference: "0005", label: "SATA0")],
    },
    // Nothing usable-and-network EXISTS, so a redirect is not on the table. The head joins (0003 is
    // enumerated and enabled, as a disk) which is what routes here through the kind gate rather than
    // through the not-enumerated refusal.
    boot_options: BootOptionsObserved { options: [opt_disk("0003")] },
    nics: NicsObserved { nics: ["eth0"] },
    secure_boot: SecureBootDisabled,
    bios_version: BiosVersionObserved { version: "1.08" },
  )
  match firmware_network_boot_standing(
    observation: observation,
    authority: witness_authority,
    observed_at: witness_epoch,
    boot_mode: UefiHttpBoot,
  ) {
    // NO BIOS-ATTRIBUTE ROUTE IS DECLARABLE, so the authoring case is a refusal naming the mechanism.
    // This is the arm whose old version asserted `attribute == "NetworkStack"` -- a string that came
    // from the ComputerSystem schema citation, which establishes that Redfish has a Bios CONTAINER and
    // never names a vendor key. Asserting it was asserting the guess.
    Refused {
      cause: RouteBindingUnresolved { mechanism: mechanism, owed_read: owed },
      gaps: _,
    } =>
      mechanism == "redfish-bios-network-stack"
        && length(xs: owed) > 0
        && (string_contains(s: owed, pattern: "GET") || string_contains(s: owed, pattern: "Attributes"))
    // THE OTHER VERDICTS, EACH NAMED, because each is a different claim the seam might be tempted to
    // make and each would be wrong in its own way: a redirect here would point the next boot at a
    // disk (the head is a disk, so the redirect fold falls through to the enumeration's enabled network
    // option -- which is the wrong repair for 'no PXE stack exists'); a one-shot override would claim a
    // mechanism for a blocker that means 'there is no option to point at'; and Ready would call a board
    // with no network stack network-bootable.
    NeedsPreparation { route: PointUefiBootNext { service_root: _, boot_option: _, authority: _ }, blocking: _ } => false
    NeedsPreparation { route: RedfishOneShotOverride { service_root: _, authority: _ }, blocking: _ } => false
    NeedsPreparation { route: IpmiOneShotOverride { channel: _, authority: _ }, blocking: _ } => false
    NeedsPreparation { route: SelectNicBoot { service_root: _, attribute: _, authority: _ }, blocking: _ } => false
    NeedsPreparation { route: SetSecureBootAttribute { service_root: _, attribute: _, authority: _ }, blocking: _ } => false
    NeedsPreparation { route: UefiShellOverSol { sol_channel: _, shell_script: _, authority: _ }, blocking: _ } => false
    NeedsPreparation { route: HumanConsole { instruction: _, authority: _ }, blocking: _ } => false
    Ready { firmware_mode: _, network_interface: _, boot_target: _, evidence: _ } => false
    Unobserved { unanswered: _ } => false
    Refused { cause: _, gaps: _ } => false
  }
}

// THE TWO ENUMERATIONS DISAGREE: BootOrder names a network entry, and BootOptions -- having been
// asked, and having reported a non-empty list -- does not contain it. The seam must not pick a side.
// The two available guesses lead to opposite actions (author a stack vs. redirect to an option), and
// one of them is a persistent firmware write, so the honest standing names the conflict. An empty
// BootOptions list must NOT land here: that is the unconfigured-board case above, and refusing every
// unconfigured board for a conflict nobody observed is how a seam becomes useless.
test fn a_boot_order_naming_an_unenumerated_network_option_is_refused_not_guessed() -> Bool {
  match standing_of(observation: with_boot_options(options: BootOptionsObserved { options: [opt_disk("0009"), opt_disk("0010")] })) {
    Refused { cause: BootOrderNamesUnenumeratedNetworkOption { why: _ }, gaps: _ } => true
    // EVERY OTHER REFUSAL NAMED, so a wrong cause cannot satisfy this test. A `_ => false` here
    // would pass on Refused { cause: NoSuchUnit } -- which is a refusal, so the test would report
    // 'the conflict is named' while the seam named something else entirely.
    Refused { cause: TransportRefusedVendorCommand { refusal: _ }, gaps: _ } => false
    Refused { cause: FirmwareModeUnsupportedByEdge { why: _ }, gaps: _ } => false
    Refused { cause: RefusedByOperatorPolicy { policy: _ }, gaps: _ } => false
    Refused { cause: NoNetworkInterfacePresent { why: _ }, gaps: _ } => false
    Refused { cause: NoRouteOwnsThisBlocking { why: _ }, gaps: _ } => false
    // THE TWO BLOCKER-3 CAUSES, named rather than swept under a `_ => false`: they are refusals, so a
    // wildcard would let the seam report 'the conflict is named' while naming something else entirely.
    // Each states a remedy the other does not -- one says read this, the other says your transcription
    // is from another board -- and this test's whole claim is that the seam distinguishes causes.
    Refused { cause: RouteBindingUnresolved { mechanism: _, owed_read: _ }, gaps: _ } => false
    Refused {
      cause: RouteBindingStaleForUnit {
        mechanism: _,
        grounded_for_bios_version: _,
        observed_bios_version: _,
      },
      gaps: _,
    } => false
    NeedsPreparation { route: _, blocking: _ } => false
    Ready { firmware_mode: _, network_interface: _, boot_target: _, evidence: _ } => false
    Unobserved { unanswered: _ } => false
  }
    // ...and the empty-list neighbour must stay a preparation, which is the guard that keeps this
    // refusal from being reachable by the ordinary unconfigured board.
    && match standing_of(observation: with_boot_options(options: BootOptionsObserved { options: [] })) {
         NeedsPreparation { route: _, blocking: _ } => true
         _ => false
       }
}

// ---------------------------------------------------------------------------
// THE TWO THINGS REVIEW 81711 FOUND, NOW WITNESSED DIRECTLY.
// ---------------------------------------------------------------------------

// NETWORK-NESS IS A KIND, NOT A SUBSTRING -- and now, NOT A BOOT-ORDER PROPERTY EITHER. Labels are
// made to mislead here on purpose: a firmware can spell an iSCSI target 'IPv4', a diagnostics shell
// 'HTTP', or a USB recovery stick 'UEFI Network Device', and the seam must be unmoved. The converse
// arm matters as much: an option the schema calls Pxe is network-bootable even when its label says
// nothing network-shaped at all, so a unit is not stranded because a vendor named its option after
// the box it shipped in. If anyone reintroduces label matching, one of these arms goes red.
//
// REWRITTEN AROUND THE JOIN (merry-fox-82, blocker 1). The old version asked a list of BootEntry
// 'do any of you look network-ish', which is the question that produced the false Ready. It now asks
// the two questions the seam actually asks: WHAT DOES THE HEAD JOIN TO, and WHICH OPTIONS ARE
// USABLE. Each arm pins a field, because an arm-pinned-but-value-unpinned assertion is how
// additional_count: 0 once shipped green (DESIGN 5: a field a reader credits and nothing measures is
// a fabricated output).
test fn classification_is_the_kind_and_the_label_is_never_consulted() -> Bool {
  // Six options whose LABELS all shout network and whose KINDS all say otherwise.
  let misleadingly_network_labels: List<BootOption> = [
    boot_option(reference: "0011", kind: BootTargetHdd, label: "IPv4 iSCSI target (SanDisk)", enabled: true),
    boot_option(reference: "0012", kind: BootTargetUsb, label: "UEFI Network Device: USB Recovery", enabled: true),
    boot_option(reference: "0013", kind: BootTargetCd, label: "HTTP Boot Diagnostics", enabled: true),
    boot_option(reference: "0014", kind: BootTargetBiosSetup, label: "Network Stack Setup", enabled: true),
    boot_option(reference: "0015", kind: BootTargetDiags, label: "PXE Diagnostics Shell", enabled: true),
    boot_option(reference: "0016", kind: BootTargetNone, label: "Network Boot (Disabled)", enabled: true),
  ]
  // One option whose label says NOTHING network-shaped and whose kind says Pxe.
  let honestly_network_label = boot_option(reference: "0017", kind: BootTargetPxe, label: "ALTRAD8UD-1L2T", enabled: true)
  length(xs: misleadingly_network_labels) == 6
    // NO LABEL MATCHES, so nothing is usable -- and the count says it looked at all six, which is
    // what lets `decide` tell 'six options, none usable' from 'nobody configured anything'.
    && match available_network_options(options: misleadingly_network_labels) {
         NoAvailableNetworkOption { examined_count: examined } => examined == 6
         AvailableNetworkOptionsPresent { head: _, additional_count: _ } => false
       }
    // THE KIND IS ENOUGH: a nameless-to-the-eye option is usable, and the head is HANDED OVER by the
    // pattern (review 81893: there is no `|> first` left to fail).
    && match available_network_options(options: [honestly_network_label]) {
         AvailableNetworkOptionsPresent { head: first_option, additional_count: extra } =>
           first_option.kind == BootTargetPxe && extra == 0
         NoAvailableNetworkOption { examined_count: _ } => false
       }
    // AND THE COUNT IS THE COUNT -- two usable options must report exactly one MORE than the head.
    // Without this arm a constant `additional_count: 0` passed every witness that ever existed.
    && match available_network_options(
         options: [
           honestly_network_label,
           boot_option(reference: "0018", kind: BootTargetUefiHttp, label: "HTTP Boot", enabled: true),
           boot_option(reference: "0019", kind: BootTargetHdd, label: "NVMe0", enabled: true),
         ],
       ) {
         AvailableNetworkOptionsPresent { head: first_option, additional_count: more } =>
           first_option.kind == BootTargetPxe && more == 1
         AvailableNetworkOptionsPresent { head: _, additional_count: _ } => false
         NoAvailableNetworkOption { examined_count: _ } => false
       }
    // A DISABLED OPTION IS NOT USABLE, even when its kind is right. Counted separately from the
    // label arms so 'disabled' cannot be quietly folded into 'not network'.
    && match available_network_options(
         options: [boot_option(reference: "0020", kind: BootTargetPxe, label: "PXE", enabled: false)],
       ) {
         NoAvailableNetworkOption { examined_count: examined } => examined == 1
         AvailableNetworkOptionsPresent { head: _, additional_count: _ } => false
       }
    && match redfish_boot_target_network_standing(t: BootTargetUefiHttp) {
         NetworkBootTarget { via: _ } => true
         NotNetworkBootTarget { why: _ } => false
       }
    && match redfish_boot_target_network_standing(t: BootTargetHdd) {
         NetworkBootTarget { via: _ } => false
         NotNetworkBootTarget { why: _ } => true
       }
}

// THE SEALS, PROVEN TO BE WALLS AND NOT DECORATION (merry-fox-82, blocker 2). The witnesses above
// show honest construction works; they cannot show bypass is IMPOSSIBLE, because a bypass that
// resolved would refuse inside this file's own compilation and never reach a test. So the bypasses are
// compiled as DATA through the corpus's own probe harness -- the idiom of
// dag/test/claim/compute/attempt_lifecycle_payload_seal_witness.dag, which pairs every hostile source
// with a lawful source over the SAME imports so a refusal cannot be an artifact of bad probe code.
// THREE LAWS, THREE CONTROLS: custody of the verdict (may a stranger write Ready), custody of the
// call route (may a stranger call the mint and pass its output off as this module's verdict), and
// merry's specific ask -- legitimate evidence reused with a swapped conclusion.

data verdict_probe_hdr: String = "module probe_verdict_forgery\nimport std.types { Bool, EpochMs, List, NonEmptyStr }\nimport std.optional { Optional, Present, Absent }\nimport extdeps.external_authority { CitedFigureStanding, CitedToAuthority, ExternalAuthority }\nimport extdeps.uri { uri_https }\nimport extdeps.bmc.types { boot_order_entry, boot_option, BootTargetPxe }\nimport extdeps.provisioning.network_boot { ClientNetworkBootMode, UefiPxe }\nimport gunbc.firmware_network_boot_standing { FirmwareNetworkBootStanding, Ready, ReadyEvidence, FirmwareBootObservation, firmware_boot_observation, BootOrderUnobserved, BootOptionsUnobserved, NicsUnobserved, SecureBootUnobserved, BiosVersionUnobserved, PreparationBlockingOn, NoInterfaceCarriesPxe, prepare, join_head_to_options, available_network_options }\n"

// THE OBSERVATION EVERY FORGE SHARES, spelled once so the two sources below differ in EXACTLY one
// way: whether a Ready is wrapped around the evidence.
data forged_evidence_body: String = "ReadyEvidence {\n      observation_authority: CitedToAuthority { authority: ExternalAuthority { uri: uri_https(locator: \"example.invalid/forged\") } },\n      observed_at: 1765000000000,\n      observation: firmware_boot_observation(\n        boot_order: BootOrderUnobserved { reason: \"never asked\" },\n        boot_options: BootOptionsUnobserved { reason: \"never asked\" },\n        nics: NicsUnobserved { reason: \"never asked\" },\n        secure_boot: SecureBootUnobserved { reason: \"never asked\" },\n        bios_version: BiosVersionUnobserved { reason: \"never asked\" },\n      ),\n    }"

// BASELINE SOURCE: forges ONLY the sealed evidence, never a verdict. ReadyEvidence was already
// sole_constructor before this rework, so this source measures what the PRE-EXISTING seal refuses.
// It is the denominator of the claim below, not decoration.
data forge_evidence_only_source: String = verdict_probe_hdr + "\nfn forge_evidence() -> Bool {\n  let forged: ReadyEvidence = " + forged_evidence_body + "\n  match forged {\n    ReadyEvidence { observation_authority: _, observed_at: _, observation: _ } => true\n  }\n}\n"

// THE CLAIM SOURCE: identical, except the forged evidence is wrapped in a hand-written Ready -- a
// hand-picked interface, a boot target of its own invention, an observation that supports nothing.
data forge_ready_source: String = verdict_probe_hdr + "\nfn forge_verdict() -> FirmwareNetworkBootStanding {\n  Ready {\n    firmware_mode: UefiPxe { tftp_root: uri_https(locator: \"edge.invalid/pxe\") },\n    network_interface: \"eth0\",\n    boot_target: BootTargetPxe,\n    evidence: " + forged_evidence_body + ",\n  }\n}\n"

// THE LAWFUL PAIR: the same imports, and the observation obtained from the PUBLIC observation
// constructor (legal -- the probe owns observations) with no verdict constructed. Clean of the class,
// so a refusal above is the seal and not a probe that fails to compile. Every hostile source in this
// file travels with its lawful pair for exactly that reason.
data lawful_verdict_source: String = verdict_probe_hdr + "\nfn honest_observation() -> FirmwareBootObservation {\n  firmware_boot_observation(\n    boot_order: BootOrderUnobserved { reason: \"never asked\" },\n    boot_options: BootOptionsUnobserved { reason: \"never asked\" },\n    nics: NicsUnobserved { reason: \"never asked\" },\n    secure_boot: SecureBootUnobserved { reason: \"never asked\" },\n    bios_version: BiosVersionUnobserved { reason: \"never asked\" },\n  )\n}\n"

fn sole_ctor_count(source: String) -> Int {
  match census_blocking_count_for_class(census: compile_dag_diagnostic_census(source), wanted: "SoleConstructorViolation") {
    // Absent means the census could not run, and 0 rows is how a probe that never ran reports. A wall
    // proven by a probe that never compiled is not a wall, so an unrunnable census is a FAIL, never a
    // pass -- the reason this helper returns Int and the tests compare against >= 1 rather than != 0.
    Present { value: n } => n
    Absent => 0 - 1
  }
}

// WHY THIS IS A RATHER THAN A COUNT. A plain "the forge source reports SoleConstructorViolation >= 1"
// would be SATISFIED BY THE EVIDENCE SEAL ALONE, because the same source forges a ReadyEvidence too,
// which was already sealed -- so the probe would stay green if the verdict seal were deleted. That is
// a vacuous probe wearing the name of a discriminating one. So the claim is RELATIVE: wrapping the
// identical forged evidence in a hand-written Ready must add at least one refusal of its own, and the
// baseline must refuse at least one (proving the source compiled and the harness reports). Delete
// `sole_constructor` from the verdict union and the second arm goes red.
// WHAT THIS PROVES, AND WHAT IT DOES NOT. Both hostile sources must be refused and the lawful pair
// over the SAME imports must be clean -- without that pair, "the probe refused" is indistinguishable
// from "the probe never compiled". The mutation that reddens it is deleting `sole_constructor` from the
// ReadyEvidence RECORD: both forgeries can obtain their evidence only through that type's mint, so
// custody of a verdict runs through custody of its evidence.
//
// What this does NOT prove is that the `sole_constructor` annotation on the FirmwareNetworkBootStanding
// UNION refuses anything. Measured directly -- wrapping an already-forged evidence in a hand-written
// `Ready {...}` raised the violation count by ZERO -- so the union-level annotation is not what
// refuses, and an earlier version of this test asserting that delta was wrong. It is kept at the type as
// recorded intent (it costs nothing; the corpus's own audit probe frames the coproduct case as the open
// question), and documented there as intent, not as a wall. Claiming the annotation was the wall would
// have been rung inflation inside my own evidence -- the exact defect the reviews on this PR caught all
// day, so the claim here is written to what a probe executed rather than to what the type appears to say.
test fn no_foreign_module_may_write_a_verdict_by_hand() -> Bool {
  sole_ctor_count(source: forge_evidence_only_source) >= 1
    && sole_ctor_count(source: forge_ready_source) >= 1
    && sole_ctor_count(source: lawful_verdict_source) == 0
}

// (2) CUSTODY OF THE CALL ROUTE, and merry's swapped-conclusion case in one: a caller that RESPECTS
// the sealed type can still bypass the fold by CALLING the mint. prepare(blocker:) returns a
// well-formed verdict whose route was never derived from the blocker by the catalog, so the rung-2
// admissibility rule never runs -- the shape of 'legitimate evidence carrying a conclusion the evidence
// does not establish'. This one IS enforced: the call is refused at the admission wall.
// THE MINT'S SIGNATURE GREW, AND THE PROBE GREW WITH IT. `prepare` used to take a blocker ALONE,
// which is how a verdict could be minted while carrying a firmware-side name nobody had read: the
// route came from a catalog lookup with no unit evidence in the room. Now the join and the
// availability list are required arguments and the fold derives the route from them, so a hostile
// caller has to bring unit evidence to the mint -- and is still refused, for the same reason as
// before: it is not an admitted caller. Refusing a well-formed call is the only refusal worth
// witnessing; refusing a call that would not compile proves nothing.
data direct_mint_source: String = verdict_probe_hdr + "\nfn bypass_to_a_verdict() -> FirmwareNetworkBootStanding {\n  let enabled_network_option = boot_option(reference: \"0001\", kind: BootTargetPxe, label: \"PXE\", enabled: true)\n  prepare(\n    blocker: NoInterfaceCarriesPxe,\n    join: join_head_to_options(devices: [boot_order_entry(reference: \"0001\", label: \"PXE\")], options: [enabled_network_option]),\n    available: available_network_options(options: [enabled_network_option]),\n    observed_bios_version: Present { value: \"1.08\" },\n  )\n}\n"

// THE LAWFUL PAIR: the same module, the same import of the mint, and no call. If this source also
// refused, the wall would be 'you may not import this name' and the claim above would be false.
data lawful_import_source: String = verdict_probe_hdr + "\nfn names_the_blocker(b: PreparationBlockingOn) -> PreparationBlockingOn {\n  b\n}\n"

test fn no_foreign_module_may_call_the_verdict_mint_directly() -> Bool {
  blocking_subject_count_for(
    source: direct_mint_source,
    wanted_class: "ConstructorCallAdmissionRefused",
    wanted_subject: "prepare",
  ) >= 1
    && blocking_subject_count_for(
      source: lawful_import_source,
      wanted_class: "ConstructorCallAdmissionRefused",
      wanted_subject: "prepare",
    ) == 0
}

// THE JOIN, TESTED DIRECTLY, ALL FIVE ARMS. This is the seam's most load-bearing function after
// `decide` -- every Ready in the module passes through it -- so each arm is pinned with its fields,
// not merely matched. Two of these arms exist ONLY to make merry-fox-82's blocker 1 unwritable:
// a head that joins a network option by LABEL or by KIND rather than by reference is not
// expressible, because there is no other input to compare.
test fn the_head_joins_by_reference_and_only_by_reference() -> Bool {
  // (a) THE ORDINARY CASE: the order's first reference is enumerated and enabled. The joined option
  // travels out of the arm, so a fold that re-derived kind from anywhere else would be caught here.
  match join_head_to_options(
    devices: [entry(reference: "0001", label: "whatever the vendor calls it")],
    options: [boot_option(reference: "0001", kind: BootTargetUefiHttp, label: "HTTP", enabled: true)],
  ) {
    HeadJoinsEnabledOption { head: joined } => joined.reference == "0001" && joined.kind == BootTargetUefiHttp
    HeadJoinsDisabledOption { head: _ } => false
    HeadOptionNotEnumerated { order_head_reference: _, enumerated_count: _ } => false
    HeadOrderEmpty => false
    HeadEnumerationEmpty { examined_count: _ } => false
  }
    // (b) THE ONE THAT USED TO READ READY: the order's head is the disk, and an enabled network
    // option is present UNDER A DIFFERENT REFERENCE. The head joins the disk; the network option
    // cannot be reached from here. Under the old fold these two fixtures were indistinguishable.
    && match join_head_to_options(
      devices: [entry(reference: "0003", label: "NVMe0"), entry(reference: "0001", label: "HTTP")],
      options: [opt_http(ref_http()), opt_disk("0003")],
    ) {
      HeadJoinsEnabledOption { head: joined } => joined.kind == BootTargetHdd && joined.reference == "0003"
      HeadJoinsDisabledOption { head: _ } => false
      HeadOptionNotEnumerated { order_head_reference: _, enumerated_count: _ } => false
      HeadOrderEmpty => false
      HeadEnumerationEmpty { examined_count: _ } => false
    }
    // (c) LABELS ARE NOT IDENTITY: two options with IDENTICAL labels and different references, where
    // the order names only the second. The join must find the second. A label-keyed join finds the
    // first and reports the wrong kind -- and both look correct to a reader.
    && match join_head_to_options(
      devices: [entry(reference: "0002", label: "ALTRAD8UD-1L2T")],
      options: [
        boot_option(reference: "0001", kind: BootTargetHdd, label: "ALTRAD8UD-1L2T", enabled: true),
        boot_option(reference: "0002", kind: BootTargetPxe, label: "ALTRAD8UD-1L2T", enabled: true),
      ],
    ) {
      HeadJoinsEnabledOption { head: joined } => joined.kind == BootTargetPxe && joined.reference == "0002"
      HeadJoinsDisabledOption { head: _ } => false
      HeadOptionNotEnumerated { order_head_reference: _, enumerated_count: _ } => false
      HeadOrderEmpty => false
      HeadEnumerationEmpty { examined_count: _ } => false
    }
    // (d) DISABLED IS ITS OWN ARM: the firmware will not boot this entry. Not Ready (it does not),
    // not absent (it exists), not a conflict (the reads agree).
    && match join_head_to_options(
      devices: [entry(reference: "0002", label: "PXE")],
      options: [opt_disabled_pxe(ref_pxe())],
    ) {
      HeadJoinsDisabledOption { head: joined } => joined.reference == "0002" && !joined.enabled
      HeadJoinsEnabledOption { head: _ } => false
      HeadOptionNotEnumerated { order_head_reference: _, enumerated_count: _ } => false
      HeadOrderEmpty => false
      HeadEnumerationEmpty { examined_count: _ } => false
    }
    // (e) THE TWO READS DISAGREE, and the specifics travel on the arm. The reference and the count
    // are asserted because they ARE the diagnosis -- 're-read BootOptions' without saying which
    // reference went missing is a refusal that sends nobody anywhere.
    && match join_head_to_options(
      devices: [entry(reference: "0007", label: "ghost")],
      options: [opt_http(ref_http()), opt_disk("0003"), opt_disabled_pxe(ref_pxe())],
    ) {
      HeadOptionNotEnumerated { order_head_reference: ghost_ref, enumerated_count: ghost_count } =>
        ghost_ref == "0007" && ghost_count == 3
      HeadJoinsEnabledOption { head: _ } => false
      HeadJoinsDisabledOption { head: _ } => false
      HeadOrderEmpty => false
      HeadEnumerationEmpty { examined_count: _ } => false
    }
    // (f) EMPTY ORDER: nothing is selected. Distinct from (g) because an empty ORDER and an empty
    // ENUMERATION are different facts with different remedies.
    && match join_head_to_options(devices: [], options: [opt_http(ref_http())]) {
         HeadOrderEmpty => true
         HeadJoinsEnabledOption { head: _ } => false
         HeadJoinsDisabledOption { head: _ } => false
         HeadOptionNotEnumerated { order_head_reference: _, enumerated_count: _ } => false
         HeadEnumerationEmpty { examined_count: _ } => false
       }
    // (g) EMPTY ENUMERATION WITH A NON-EMPTY ORDER. NOT a conflict: 'nobody ever configured this
    // board' is what an empty BootOptions list answers, and it must not be refused as a disagreement
    // -- refusing every unconfigured board is how a seam becomes useless.
    && match join_head_to_options(devices: [entry(reference: "0001", label: "HTTP")], options: []) {
         HeadEnumerationEmpty { examined_count: examined } => examined == 0
         HeadJoinsEnabledOption { head: _ } => false
         HeadJoinsDisabledOption { head: _ } => false
         HeadOptionNotEnumerated { order_head_reference: _, enumerated_count: _ } => false
         HeadOrderEmpty => false
       }
    // (h) THE LOOKUP ITSELF, WITH NO FUZZY SECOND PASS: a miss is Absent, not the nearest neighbour.
    && match option_with_reference(options: [opt_http(ref_http())], reference: "9999") {
         Absent => true
         Present { value: _ } => false
       }
}

// THE FALSE READY, AS A BLACK-BEHAVIOUR CLAIM. merry-fox-82's blocker 1 was a specific unit:
// BootOrder [disk, PXE] reported Ready/Pxe. This test asks for the two orderings of the SAME
// enumeration and requires the two verdicts to DIFFER -- because a fold that filters the order to
// network kinds before taking the head gives them the same answer, and that fold shipped for five
// review rounds with 40 green witnesses.
test fn a_disk_first_boot_order_is_never_ready_where_a_network_first_one_is() -> Bool {
  // One enumeration, enabled, containing BOTH an HTTP option and a disk.
  let enumeration = [opt_http(ref_http()), opt_disk(ref_disk())]
  let network_first = firmware_boot_observation(
    boot_order: BootOrderObserved { devices: [http_entry(), disk_entry()] },
    boot_options: BootOptionsObserved { options: enumeration },
    nics: NicsObserved { nics: ["eth0"] },
    secure_boot: SecureBootDisabled,
    bios_version: BiosVersionObserved { version: "1.08" },
  )
  let disk_first = firmware_boot_observation(
    boot_order: BootOrderObserved { devices: [disk_entry(), http_entry()] },
    boot_options: BootOptionsObserved { options: enumeration },
    nics: NicsObserved { nics: ["eth0"] },
    secure_boot: SecureBootDisabled,
    bios_version: BiosVersionObserved { version: "1.08" },
  )
  match standing_of(observation: network_first) {
    // The network-first unit IS ready, and names the HTTP target it joined to.
    Ready { firmware_mode: _, network_interface: "eth0", boot_target: BootTargetUefiHttp, evidence: _ } =>
      match standing_of(observation: disk_first) {
        // ...and the disk-first unit is NOT: same options, different selection, different verdict.
        // NeedsPreparation is the only acceptable answer -- Refused would call a normal boot
        // configuration an error, and Ready is the bug.
        NeedsPreparation { route: r, blocking: b } =>
          is_a_fleet_route(route: r)
            // The disk IS selected and a usable network option EXISTS, so a redirect answers it; the
            // persistent authoring write would be an uncaused BIOS change on a board that only needs
            // one boot pointed at the network.
            && match b {
                 NetworkBootOptionNotSelected => true
                 NetworkBootOptionAbsent => false
                 NoInterfaceCarriesPxe => false
                 SecureBootBlocksUnsignedChainloader => false
                 OverrideMechanismUnsupported => false
               }
        Ready { firmware_mode: _, network_interface: _, boot_target: _, evidence: _ } => false
        Unobserved { unanswered: _ } => false
        Refused { cause: _, gaps: _ } => false
      }
    Ready { firmware_mode: _, network_interface: _, boot_target: _, evidence: _ } => false
    Unobserved { unanswered: _ } => false
    Refused { cause: _, gaps: _ } => false
    NeedsPreparation { route: _, blocking: _ } => false
  }
}

// THE UNIT THAT LOOKS BOOTABLE AND ISN'T: a board whose entire boot order is 'IPv4'-named disks must
// not read Ready. Under the substring rule this exact observation produced a Ready, because 'IPv4'
// was on the spelling list -- a unit scheduled for a network boot it could never perform.
test fn an_all_disk_boot_order_with_network_shaped_labels_is_not_ready() -> Bool {
  let observation = firmware_boot_observation(
    boot_order: BootOrderObserved {
      devices: [
        entry(reference: "0100", label: "IPv4 SanDisk NVMe"),
        entry(reference: "0101", label: "UEFI Network Stack Data"),
        entry(reference: "0102", label: "HTTP Recovery"),
      ],
    },
    // The enumeration says what those three LABELS actually are: two disks and a CD, all enabled --
    // and separately lists an enabled HTTP option that the order never names. So this unit's head
    // JOINS (as a disk, which the kind gate rejects) and a network option EXISTS (so the answer is
    // 'not selected', a redirect, not the authoring write). The labels shout network at every arm;
    // the kinds are the only thing consulted. If the enumeration did not contain the head reference
    // at all, this fixture would test the disagreement refusal instead -- which is the OTHER test.
    boot_options: BootOptionsObserved {
      options: [
        boot_option(reference: "0100", kind: BootTargetHdd, label: "IPv4 SanDisk NVMe", enabled: true),
        boot_option(reference: "0101", kind: BootTargetHdd, label: "UEFI Network Stack Data", enabled: true),
        boot_option(reference: "0102", kind: BootTargetCd, label: "HTTP Recovery", enabled: true),
        opt_http(ref_http()),
      ],
    },
    nics: NicsObserved { nics: ["eth0"] },
    secure_boot: SecureBootDisabled,
    bios_version: BiosVersionObserved { version: "1.08" },
  )
  match firmware_network_boot_standing(
    observation: observation,
    authority: witness_authority,
    observed_at: witness_epoch,
    boot_mode: UefiHttpBoot,
  ) {
    NeedsPreparation { route: r, blocking: b } =>
      is_a_fleet_route(route: r)
        // THE BLOCKER THIS UNIT IS REALLY UNDER. Its BootOptions DOES list an HTTP option, and its
        // BootOrder names none of them -- so this is 'exists, not selected' (a redirect), not
        // 'absent' (the authoring write). An earlier version of this test asserted Absent, which was
        // the OLD fold's answer: it tested BootOrder first and called a miss 'no network stack',
        // sending a one-boot redirect case to a persistent BIOS write. The label-independence claim
        // this test exists to make does not depend on which blocker is named -- a false Ready still
        // fails it either way -- so the honest expectation wins over the convenient one.
        && match b {
             NetworkBootOptionNotSelected =>
               match r {
                 PointUefiBootNext { service_root: _, boot_option: _, authority: _ } => true
                 RedfishOneShotOverride { service_root: _, authority: _ } => true
                 IpmiOneShotOverride { channel: _, authority: _ } => true
                 // The persistent authoring route reaching this unit is the defect this whole split
                 // exists to stop, so naming it here turns 'wrong remedy' into a failure rather than a
                 // pass with a different plan attached.
                 _ => false
               }
             _ => false
           }
    Ready { firmware_mode: _, network_interface: _, boot_target: _, evidence: _ } => false
    _ => false
  }
}

// THE PAIRING IS CHECKED FROM THE OUTSIDE, WHICH IS THE ONLY DIRECTION LEFT ONCE THE TYPE OWNS IT
// (reviews 81734 and 81760). Per catalog row, two independent things:
//   (a) the row is findable under the blocker `blocker_of` derives for it -- so the derivation
//       cannot drift away from the arms without the fold losing its route, and
//   (b) the mechanism is one that can physically move that blocker, judged against the WITNESS's own
//       table of what mechanisms do. The module no longer owns such a function (with one union and
//       arm-level grouping the wrong pairing cannot be written), so this table is an independent
//       statement of the same truth and the two agreeing is the claim under test. If an arm is
//       re-filed under a blocker it cannot move, the module still compiles and this goes red.
test fn every_route_is_found_under_the_blocker_it_declares_and_can_physically_move_it() -> Bool {
  for_all(xs: firmware_network_boot_preparation_routes, predicate: route =>
    length(xs: filter(catalog_rows_for(blocker: blocker_of(route: route)), candidate => candidate == route)) > 0
      && mechanism_can_move(mechanism: route, blocker: blocker_of(route: route))
  )
}

// WITNESS-SIDE MECHANISM CAPABILITIES, in the executor's own vocabulary and deliberately not a copy
// of module code. Each arm is named: a redirect is a redirect is a redirect (they differ only in
// control plane), an attribute-change is how something is made to exist, and out-of-band is what is
// left when the API refused.
fn mechanism_can_move(mechanism: FirmwareNetworkBootPreparationRoute, blocker: PreparationBlockingOn) -> Bool {
  match blocker {
    // A stack that does not exist is created by a BIOS attribute, by nothing else.
    NetworkBootOptionAbsent => is_stack_enabler(mechanism: mechanism)
    // An option that exists but is unselected is selected by a redirect, and only by a redirect.
    NetworkBootOptionNotSelected => is_redirect(mechanism: mechanism)
    // Which port boots is firmware state; a redirect cannot answer it (review 81711's bug).
    NoInterfaceCarriesPxe => is_nic_selector(mechanism: mechanism)
    SecureBootBlocksUnsignedChainloader => is_secure_boot_setter(mechanism: mechanism)
    OverrideMechanismUnsupported => is_out_of_band(mechanism: mechanism)
  }
}

fn is_stack_enabler(mechanism: FirmwareNetworkBootPreparationRoute) -> Bool {
  match mechanism {
    EnableNetworkStack { service_root: _, attribute: _, authority: _ } => true
    _ => false
  }
}

fn is_redirect(mechanism: FirmwareNetworkBootPreparationRoute) -> Bool {
  match mechanism {
    PointUefiBootNext { service_root: _, boot_option: _, authority: _ } => true
    RedfishOneShotOverride { service_root: _, authority: _ } => true
    IpmiOneShotOverride { channel: _, authority: _ } => true
    _ => false
  }
}

fn is_nic_selector(mechanism: FirmwareNetworkBootPreparationRoute) -> Bool {
  match mechanism {
    SelectNicBoot { service_root: _, attribute: _, authority: _ } => true
    _ => false
  }
}

fn is_secure_boot_setter(mechanism: FirmwareNetworkBootPreparationRoute) -> Bool {
  match mechanism {
    SetSecureBootAttribute { service_root: _, attribute: _, authority: _ } => true
    _ => false
  }
}

fn is_out_of_band(mechanism: FirmwareNetworkBootPreparationRoute) -> Bool {
  match mechanism {
    UefiShellOverSol { sol_channel: _, shell_script: _, authority: _ } => true
    HumanConsole { instruction: _, authority: _ } => true
    _ => false
  }
}

// NO BLOCKER IS LEFT WITHOUT A REMEDY: every value of PreparationBlockingOn has at least one row,
// so the readiness fn can never answer a real blocker with 'nobody owns this'. A new blocker
// without a row breaks here rather than in a datacenter.
test fn every_blocker_has_a_route_that_can_act_on_it() -> Bool {
  blocker_has_row(blocker: NetworkBootOptionAbsent)
    && blocker_has_row(blocker: NetworkBootOptionNotSelected)
    && blocker_has_row(blocker: NoInterfaceCarriesPxe)
    && blocker_has_row(blocker: SecureBootBlocksUnsignedChainloader)
    && blocker_has_row(blocker: OverrideMechanismUnsupported)
}

fn blocker_has_row(blocker: PreparationBlockingOn) -> Bool {
  match preferred_row(blocker: blocker) {
    Present { value: route } => mechanism_can_move(mechanism: route, blocker: blocker)
    Absent => false
  }
}

// THE CATALOG VIEWED BY BLOCKER, which is the only view the readiness fn is allowed to use. The
// witness keeps its own copy rather than reaching into a private helper, because 'can a blocker
// even be looked up' is the thing under test and sharing the implementation would make the test
// agree with the code by construction.
fn catalog_rows_for(blocker: PreparationBlockingOn) -> List<FirmwareNetworkBootPreparationRoute> {
  filter(firmware_network_boot_preparation_routes, route => blocker_of(route: route) == blocker)
}

// THE ONE HAND-WRITTEN PAIRING, PINNED ARM BY ARM. `blocker_of` is the last place a human writes
// down which blocker a mechanism answers; everything else reads it off the arm. So each of the eight
// arms is named here with the blocker it must derive to -- a new arm is a compile error in this
// match, and a re-filed arm is a red test. This is the witness that makes the union's grouping
// checkable rather than merely intended.
test fn each_route_arm_derives_the_blocker_the_fleet_acts_on() -> Bool {
  blocker_of(route: EnableNetworkStack {
        service_root: "x",
        // UNBOUND: this specimen is fed to `blocker_of`, which reads only the ARM. A bound
        // name here would imply blocker derivation depends on a firmware name, which it does
        // not -- and a claim the code does not make is a claim a later reader has to unlearn.
        attribute: MechanismNameUnbound { owed_read: "an unread vendor name" },
        authority: witness_authority,
      })
    == NetworkBootOptionAbsent
    && blocker_of(route: PointUefiBootNext {
        service_root: "x",
        // UNBOUND: this specimen is fed to `blocker_of`, which reads only the ARM. A bound
        // name here would imply blocker derivation depends on a firmware name, which it does
        // not -- and a claim the code does not make is a claim a later reader has to unlearn.
        boot_option: MechanismNameUnbound { owed_read: "an unread vendor name" },
        authority: witness_authority,
      })
      == NetworkBootOptionNotSelected
    && blocker_of(route: RedfishOneShotOverride { service_root: "x", authority: witness_authority })
      == NetworkBootOptionNotSelected
    && blocker_of(route: IpmiOneShotOverride { channel: "x", authority: witness_authority })
      == NetworkBootOptionNotSelected
    && blocker_of(route: SelectNicBoot {
        service_root: "x",
        // UNBOUND: this specimen is fed to `blocker_of`, which reads only the ARM. A bound
        // name here would imply blocker derivation depends on a firmware name, which it does
        // not -- and a claim the code does not make is a claim a later reader has to unlearn.
        attribute: MechanismNameUnbound { owed_read: "an unread vendor name" },
        authority: witness_authority,
      })
      == NoInterfaceCarriesPxe
    && blocker_of(route: SetSecureBootAttribute {
        service_root: "x",
        // UNBOUND: this specimen is fed to `blocker_of`, which reads only the ARM. A bound
        // name here would imply blocker derivation depends on a firmware name, which it does
        // not -- and a claim the code does not make is a claim a later reader has to unlearn.
        attribute: MechanismNameUnbound { owed_read: "an unread vendor name" },
        authority: witness_authority,
      })
      == SecureBootBlocksUnsignedChainloader
    && blocker_of(route: UefiShellOverSol { sol_channel: "x", shell_script: "y", authority: witness_authority })
      == OverrideMechanismUnsupported
    && blocker_of(route: HumanConsole { instruction: "x", authority: witness_authority })
      == OverrideMechanismUnsupported
    && mechanism_name(route: IpmiOneShotOverride { channel: "x", authority: witness_authority })
      == "ipmi-one-shot-override"
}

// THE PROCEDURE IS TYPED, PER ARM, AND ACTUALLY CONSUMED (review 81802, second finding). Routes
// used to carry `obligation: NonEmptyStr` -- prose that read like the executor's procedure and was
// read by nothing, which is how a redirect got paired with 'there is no option to redirect to'.
// Four claims, all of them about the SAME carrier rather than about a copy of it:
//   (a) a redirect demands an existing boot option and the authoring route does not -- the asymmetry
//       that makes the split enforceable, and the exact pair the old prose field blurred;
//   (b) authoring persists and a one-shot does not, which is the difference between a fleet-wide
//       BIOS write and one throwaway boot, and used to exist only in a sentence;
//   (c) the prose an operator is handed is RENDERED from the arms, so it cannot contradict them --
//       asserted by making the rendered text carry the token of an arm the route does not have,
//       proving nothing else could have supplied the sentence; and
//   (d) nothing demands operator consent except the two routes that change a security control or
//       need a body at the console.
// Every arm of ProcedureRequires is named across these assertions, so a new arm is a compile error
// here rather than an unrendered sentence.
test fn the_route_procedure_is_typed_and_the_rendered_text_is_derived_from_it() -> Bool {
  // THE SLOTS ARE UNBOUND HERE ON PURPOSE. Both tests that build this pair ask a question a firmware
  // name cannot answer -- one asks which PROCEDURE a blocker admits, the other asks what the rendered
  // text is derived from -- and `route_prose` renders the mechanism and the requirement list, never a
  // slot. A bound name in a specimen that never reaches the binder would be decoration, and decoration
  // in a witness is how a test starts asserting a shape the code never required.
  let redirect = PointUefiBootNext {
    service_root: "s",
    boot_option: MechanismNameUnbound { owed_read: "the BootOptionReference of this unit's network option" },
    authority: witness_authority,
  }
  let authoring = EnableNetworkStack {
    service_root: "s",
    attribute: MechanismNameUnbound { owed_read: "GET redfish:Bios -> Attributes" },
    authority: witness_authority,
  }
  // (a) the asymmetry, both directions.
  procedure_asks(
    route: redirect,
    requirement: RequiresExistingBootOption,
  )
    && !procedure_asks(
      route: authoring,
      requirement: RequiresExistingBootOption,
    )
    // (b) persistence is the authoring route's, never a one-shot's.
    && procedure_asks(route: authoring, requirement: RequiresPersistentChange)
    && !procedure_asks(
      route: redirect,
      requirement: RequiresPersistentChange,
    )
    && procedure_asks(route: redirect, requirement: RequiresOneShotOnly)
    // (c) rendered from the arms: the readback property appears only because the arm carries it.
    && text_contains(
      haystack: route_prose(route: authoring),
      needle: "BootOrder",
    )
    && !text_contains(
      haystack: route_prose(route: authoring),
      needle: "operator consent first",
    )
    // (d) consent belongs to Secure Boot and to the console, and to nothing else in the catalog.
    && procedure_asks(
      route: SetSecureBootAttribute {
        service_root: "s",
        // AN UNBOUND SLOT, and the claim still holds: this asks whether the PROCEDURE demands operator
        // consent, which is a property of the requirement list and not of the attribute name.
        attribute: MechanismNameUnbound { owed_read: "GET redfish:Bios -> Attributes" },
        authority: witness_authority,
      },
      requirement: RequiresPersistentChange,
    )
    && for_all(
         xs: firmware_network_boot_preparation_routes,
         predicate: route =>
           demands_consent(route: route) == match route {
             SetSecureBootAttribute { service_root: _, attribute: _, authority: _ } => true
             HumanConsole { instruction: _, authority: _ } => true
             EnableNetworkStack { service_root: _, attribute: _, authority: _ } => false
             PointUefiBootNext { service_root: _, boot_option: _, authority: _ } => false
             RedfishOneShotOverride { service_root: _, authority: _ } => false
             IpmiOneShotOverride { channel: _, authority: _ } => false
             SelectNicBoot { service_root: _, attribute: _, authority: _ } => false
             UefiShellOverSol { sol_channel: _, shell_script: _, authority: _ } => false
           },
       )
}

// DOES THE EMITTED SLOT FOLLOW FROM THE CATALOG'S SLOT. Two legitimate answers: nothing was bound
// (the fold refused, so what is being compared is still the catalog row and equality is the claim), or
// the catalog was honest about not knowing and the emitted route carries a name whose provenance is a
// READ. What is NOT legitimate is a route whose slot still holds the catalog's own text, or a name
// whose provenance is the enumeration when the mechanism writes a BIOS attribute.
//
// WHY BOTH GROUNDS ARE CHECKED RATHER THAN EITHER: `GroundedByBootOptionEnumeration` on a BIOS
// attribute is a name lifted from the wrong namespace, and an unbound slot arriving at an executor is
// the guessed-write itself. Each is refused on its own line so a mutation that relaxes one cannot be
// covered by the other.
fn slot_agrees_with_catalog(
  catalog_slot: FirmwareMechanismName,
  emitted_slot: FirmwareMechanismName
) -> Bool {
  match catalog_slot {
    MechanismNameUnbound { owed_read: owed } =>
      match emitted_slot {
        // UNCHANGED, WHICH IS WHAT A REFUSAL LOOKS LIKE AT THIS LEVEL: the fold declined to bind, so
        // the row came through untouched. A refusal never carries a bound slot.
        MechanismNameUnbound { owed_read: owed_again } => owed == owed_again
        // A BOUND NAME: only legitimate if it is non-empty, is not the catalog's own text wearing a
        // grounding costume, and states where it came from.
        MechanismNameBound { value: value, grounded_by: grounding } =>
          length(xs: value) > 0
            && !string_contains(s: owed, pattern: value)
            && grounding_is_named(grounding: grounding)
      }
    // THE CATALOG WAS ALREADY BOUND -- an accepted, cited attribute read. Then the route must carry a
    // name that is not empty and states its provenance; equality with the row is checked by the
    // mechanism comparison alongside, and the citation is reviewed by whoever edited the row.
    MechanismNameBound { value: value, grounded_by: _ } =>
      match emitted_slot {
        MechanismNameBound { value: emitted, grounded_by: grounding } =>
          emitted == value && length(xs: emitted) > 0 && grounding_is_named(grounding: grounding)
        MechanismNameUnbound { owed_read: _ } => false
      }
  }
}

// A PROVENANCE THAT SAYS SOMETHING. The version string on a BIOS transcription has to be a real
// version (non-empty), and an option-reference grounding has to be the enumeration one -- the
// attribute routes can never acquire it, which is what makes the binder's refusal of that combination
// a live arm rather than decoration.
fn grounding_is_named(grounding: MechanismNameGrounding) -> Bool {
  match grounding {
    GroundedByBootOptionEnumeration => true
    GroundedByBiosAttributeRead { bios_version: read_against } => length(xs: read_against) > 0
  }
}

fn procedure_asks(
  route: FirmwareNetworkBootPreparationRoute,
  requirement: ProcedureRequires,
) -> Bool {
  length(
    xs: filter(
      route_requires(route: route),
      candidate => candidate == requirement,
    ),
  ) > 0
}

// MATCHES THE ARM, NOT A FABRICATED VALUE. `procedure_asks` compares by ==, which is right for the
// payload-free arms and WRONG for RequiresOperatorConsent: a record union with a `reason` field is
// only equal to itself, so comparing against a made-up reason returned false for every route and the
// consent claim was being carried by nothing. Matching the arm shape is the only correct question --
// 'does this procedure demand consent', not 'does it demand consent for exactly this wording'.
fn demands_consent(route: FirmwareNetworkBootPreparationRoute) -> Bool {
  length(
    xs: filter(
      route_requires(route: route),
      requirement =>
        match requirement {
          RequiresOperatorConsent { reason: _ } => true
          RequiresPersistentChange => false
          RequiresOneShotOnly => false
          RequiresReset => false
          RequiresReadbackOf { property: _ } => false
          RequiresExistingBootOption => false
        },
    ),
  ) > 0
}

// THE ADMISSIBILITY GATE IS NOT DECORATION: it is the reason the split cannot be undone quietly.
// Feed it the blocker that means 'nothing to point at' and every redirect must come back
// inadmissible while the authoring route is admitted -- the pairing review 81802 found is now a
// lookup result, not an author's mistake. Then feed it the opposite blocker and the redirects return.
// A fold that stopped consulting this gate would hand a unit with no option a redirect again, and
// these two directions are what fail.
test fn a_redirect_is_never_admissible_for_the_blocker_that_means_no_option_exists() -> Bool {
  // THE SLOTS ARE UNBOUND HERE ON PURPOSE. Both tests that build this pair ask a question a firmware
  // name cannot answer -- one asks which PROCEDURE a blocker admits, the other asks what the rendered
  // text is derived from -- and `route_prose` renders the mechanism and the requirement list, never a
  // slot. A bound name in a specimen that never reaches the binder would be decoration, and decoration
  // in a witness is how a test starts asserting a shape the code never required.
  let redirect = PointUefiBootNext {
    service_root: "s",
    boot_option: MechanismNameUnbound { owed_read: "the BootOptionReference of this unit's network option" },
    authority: witness_authority,
  }
  let authoring = EnableNetworkStack {
    service_root: "s",
    attribute: MechanismNameUnbound { owed_read: "GET redfish:Bios -> Attributes" },
    authority: witness_authority,
  }
  // THE CLAUSE ITSELF, PINNED ON ITS OWN INPUTS, so the gate is not being carried by the blocker_of
  // equality alone: a redirect really does declare the precondition and the authoring route really
  // does not. Invert either answer and the fold's own outputs below go red.
  procedure_demands_existing_option(route: redirect)
    && !procedure_demands_existing_option(route: authoring)
    // Nothing in the catalog may be admissible for the absent blocker while declaring that it needs
    // an option to exist -- the implication a mis-keyed row would violate.
    && for_all(
      xs: firmware_network_boot_preparation_routes,
      predicate: route =>
        !route_is_admissible_for(route: route, blocker: NetworkBootOptionAbsent)
          || !procedure_demands_existing_option(route: route),
    )
    // The gate agrees with the catalog in both directions, per blocker.
    && !route_is_admissible_for(route: redirect, blocker: NetworkBootOptionAbsent)
    && route_is_admissible_for(route: authoring, blocker: NetworkBootOptionAbsent)
    && route_is_admissible_for(route: redirect, blocker: NetworkBootOptionNotSelected)
    // ...and the authoring route is NOT admissible for the not-selected blocker: a persistent BIOS
    // write is not the answer to 'just boot from the option you already have'.
    && !route_is_admissible_for(route: authoring, blocker: NetworkBootOptionNotSelected)
    // Every catalog row is admissible under exactly the blocker its own arm declares, which is what
    // keeps the per-blocker lookup non-empty for every blocker.
    && for_all(
         xs: firmware_network_boot_preparation_routes,
         predicate: route => route_is_admissible_for(route: route, blocker: blocker_of(route: route)),
       )
}

// EVERY VALUE OF THE BLOCKER UNION, written out so a new arm is a compile error here (each is
// named) rather than an untested state.
fn all_preparation_blockers() -> List<PreparationBlockingOn> {
  [
    NetworkBootOptionAbsent,
    NetworkBootOptionNotSelected,
    NoInterfaceCarriesPxe,
    SecureBootBlocksUnsignedChainloader,
    OverrideMechanismUnsupported,
  ]
}

fn blocker_is_in(blocker: PreparationBlockingOn, candidates: List<PreparationBlockingOn>) -> Bool {
  length(xs: filter(candidates, candidate => candidate == blocker)) > 0
}

// ---------------------------------------------------------------------------
// THE FRONTIER AND ITS INHABITATION CLAIM (review 81734, DESIGN 3c/5).
// ---------------------------------------------------------------------------

// THE FRONTIER IS BOUND TO A REAL DECLARATION NAME, NOT TO A DESCRIPTION. dissolution_status over
// an empty population must say Pending (not Fired, not Unbound): Unbound would mean I had written a
// description string, which is the thing the review asked me not to do, and Fired would mean a
// missing producer counts as delivered.
test fn the_frontiers_are_bound_and_report_their_true_status() -> Bool {
  frontier_status(condition: firmware_network_boot_probe_frontier, present_decls: []) == DissolutionPending
    && frontier_status(condition: firmware_network_boot_standing_consumer_frontier, present_decls: []) == DissolutionPending
}

// THE TRIGGER FIRES ON EVIDENCE, NOT ON WISHFUL READING: hand it the declaration it names and it
// fires; hand it a DIFFERENT declaration in the same module and it stays pending. Without this arm
// a trigger bound to the wrong decl_name would look identical to a correct one while the frontier.
test fn a_frontier_fires_only_for_the_declaration_it_names() -> Bool {
  let probe_present: List<DeclarationRef> = [
    decl_ref(module_path: "gunbc.firmware_network_boot_probe", decl_name: "probe"),
  ]
  let lookalike_present: List<DeclarationRef> = [
    decl_ref(module_path: "gunbc.firmware_network_boot_probe", decl_name: "probe_something_else"),
  ]
  // THE LITERAL, NOT THE MODULE FN: handing it the name the producer actually uses -- `probe`, read
  // off gunbc.firmware_network_boot_probe -- is the point. If the module's ref drifts to a name no
  // branch will ever declare, the frontier is unsatisfiable and this is what says so.
  frontier_status(condition: firmware_network_boot_probe_frontier, present_decls: probe_present) == DissolutionFired
    && frontier_status(condition: firmware_network_boot_probe_frontier, present_decls: lookalike_present) == DissolutionPending
    && frontier_status(
         condition: firmware_network_boot_standing_consumer_frontier,
         // THE LITERAL AGAIN, NOT THE MODULE FN (review 81884). Handing the frontier its own ref
         // back would let it be satisfied by ANY name -- including the one this frontier used to
         // carry, a real declaration in a module that never reads this standing. Pinning the
         // expected spelling here means a drift to a name no branch owns goes red, and the
         // lookalike arm below proves a name in the right module is not enough.
         present_decls: [
           decl_ref(
             module_path: "gunbc.provisioning.network_boot_actuation",
             decl_name: "network_boot_arm_actuator_steps",
           ),
         ],
       )
       == DissolutionFired
    // THE MODULE AND THE EXPECTATION MUST AGREE, AND THE EXPECTATION IS THE AUTHORITY. A module fn
    // checked only against itself is self-consistent, never correct -- that is how the old
    // provisioning_arm_derive ref passed every test while naming a non-consumer.
    //
    // THE `&&` HERE IS THE TEST (merry-fox-82, blocker 4). This block used to read
    // `... == DissolutionFired` on one line and then start a NEW expression statement at
    // declaration_ref_eq, so a block returns only its LAST expression and every Fired assertion
    // above it was computed and discarded -- the witness was green whether or not the frontier ever
    // fires. That is the failure mode this whole file exists to catch, living in the file itself.
    && declaration_ref_eq(
      a: firmware_network_boot_standing_consumer_ref(),
      b: decl_ref(
        module_path: "gunbc.provisioning.network_boot_actuation",
        decl_name: "network_boot_arm_actuator_steps",
      ),
    )
    // A REAL DECLARATION THAT DOES NOT CONSUME THIS STANDING MUST NOT DISCHARGE IT. This is the
    // exact defect review 81884 found: the old ref named provisioning_arm_derive, which exists on
    // #14284 and takes (strategy, evidence, attempt) -- never a FirmwareNetworkBootStanding. If a
    // future edit retargets the frontier to it, or to any other real-but-non-consuming name, the
    // frontier would report Fired and stop anyone asking whether anything executes the seam.
    && frontier_status(
         condition: firmware_network_boot_standing_consumer_frontier,
         present_decls: [
           decl_ref(
             module_path: "gunbc.provisioning.provisioning_arm",
             decl_name: "provisioning_arm_derive",
           ),
         ],
       )
       == DissolutionPending
}

// THE INHABITATION CLAIM IS HONEST ABOUT ITS OWN STATUS. Right now no real producer has ever emitted
// a FirmwareBootObservation -- the witness hand-builds its fixtures -- so the claim MUST report
// itself uninhabited. A version of this module that claimed InhabitedByProducer today would be
// fabricating a receipt, and that is what this witness refuses.
test fn the_inhabitation_claim_reports_uninhabited_until_a_producer_emits_it() -> Bool {
  // THE ARM, MATCHED DIRECTLY -- there is no inhabitation_is_claimed(claim) Bool to ask, because a
  // Bool over that union would throw away the owed_by / over / falsified_by that make the claim
  // auditable (review 81789). Matching is the only way to read it.
  match firmware_network_boot_observation_inhabitation {
         Uninhabited { owed_by: owed, over: boundary, falsified_by: falsifier } =>
           // It names WHO owes it (the probe), WHAT is owed (the observation shape), and WHAT would
           // falsify it. An empty or generic filler in any of the three is the defect.
           declaration_ref_eq(a: owed, b: decl_ref(module_path: "gunbc.firmware_network_boot_probe", decl_name: "probe"))
             && length(xs: boundary) > 40
             && length(xs: falsifier) > 40
         _ => false
       }
}
