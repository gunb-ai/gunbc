module test.claim.firmware_network_boot_standing_witness

// WITNESS FOR THE CUT-6 READINESS SEAM (S0). Every test builds SYNTHETIC observations inside a
// test fn; no data row here is a fleet fact. The property under test is the seam's honesty: a
// Ready must be traceable to evidence, an unanswered axis must outrank a plausible Ready, a
// refusal keeps its cause, and every route the seam emits is a route the catalog owns.

import std.types { Bool, EpochMs, List, NonEmptyStr }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import extdeps.external_authority { CitedFigureStanding, CitedToAuthority, ExternalAuthority, ObservedByReceipt, TranscribedUncited }
import extdeps.uri { uri_https }
import extdeps.provisioning.network_boot { LegacyBiosPxe, UefiPxe, UefiHttpBoot }
// THE SAME ENUM THE SEAM CLASSIFIES AGAINST, imported by the witness so a fixture states a KIND
// rather than a label the seam would have to guess about.
import extdeps.bmc.types {
  BootTargetNone,
  BootTargetPxe,
  BootTargetHdd,
  BootTargetCd,
  BootTargetUsb,
  BootTargetBiosSetup,
  BootTargetDiags,
  BootTargetUefiHttp,
}
import gunbc.network_boot_delivery { BootControlObserved, BootControlPredecessor, BootControlReceiptStanding, BootControlUnobserved }
import gunbc.firmware_network_boot_standing {
  AxisNotAsked,
  AxisRefused,
  BootOrderAxisUnanswered,
  SecureBootAxisUnanswered,
  BiosAxisUnanswered,
  NetworkInterfaceAxisUnanswered,
  BootOptionsAxisUnanswered,
  BootOptionsObserved,
  BootOptionsObservation,
  BootOptionsRefused,
  BootOptionsUnobserved,
  BootOrderObserved,
  BootOrderObservation,
  BootOrderRefused,
  BootOrderUnobserved,
  BiosVersionObserved,
  BiosVersionObservation,
  BiosVersionRefused,
  BiosVersionUnobserved,
  AttemptConstructed,
  AttemptDhcpStanding,
  AttemptRouteUncataloged,
  NetworkBootAttemptConstruction,
  DhcpOfferObserved,
  DhcpForeignOffer,
  DhcpSilent,
  FirmwareBootObservation,
  FirmwareNetworkBootAttemptReceipt,
  FirmwareNetworkBootPreparationRoute,
  FirmwareNetworkBootRefusal,
  FirmwareNetworkBootStanding,
  HumanConsole,
  IpmiOneShotOverride,
  NetworkBootAttempt,
  NicsObserved,
  NicsObservation,
  NicsRefused,
  NicsUnobserved,
  PreparationBlockingOn,
  ReadyEvidence,
  RedfishBiosAttributes,
  RedfishOneShotOverride,
  RedfishUefiBootNext,
  RouteAuthority,
  BootEntry,
  boot_entry,
  has_network_entry,
  is_network_target,
  mechanism_resolves,
  route_for_blocking,
  blocking_eq,
  SecureBootDisabled,
  SecureBootEnabled,
  SecureBootObservation,
  SecureBootRefused,
  SecureBootUnobserved,
  AuthenticationRequired,
  ReplyShapeUnrecognized,
  ResourceNotFound,
  TransportRefusedVendorCommand,
  VendorCommandRejected,
  UnansweredAxis,
  UefiShellOverSol,
  firmware_boot_observation,
  firmware_network_boot_attempt_receipt,
  firmware_network_boot_preparation_routes,
  firmware_network_boot_standing,
  network_boot_attempt,
  ready_evidence,
  route_authority,
  route_eq,
  route_is_cataloged,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data witness_authority: CitedFigureStanding = CitedToAuthority {
  authority: ExternalAuthority { uri: uri_https(locator: "example.invalid/witness-fixture-not-fleet-fact") },
}

data witness_epoch: EpochMs = 1765000000000

// TYPED FIXTURE PIECES. Every boot entry a fixture names carries the Redfish target KIND the BMC
// protocol would report for it -- no fixture asks the seam to guess what a label means.
fn pxe_stack() -> BootEntry { boot_entry(kind: BootTargetPxe, label: "UEFI Network Stack") }
fn http_option() -> BootEntry { boot_entry(kind: BootTargetUefiHttp, label: "UEFI IPv4 HTTP") }
fn disk(name: NonEmptyStr) -> BootEntry { boot_entry(kind: BootTargetHdd, label: name) }
fn network_then_disk() -> List<BootEntry> { [pxe_stack(), disk("NVMe0")] }

// SYNTHETIC OBSERVATIONS. Fully-answered, network-bootable: the only input shape that may
// produce a Ready.
fn good_observation() -> FirmwareBootObservation {
  firmware_boot_observation(
    boot_order: BootOrderObserved { devices: network_then_disk() },
    boot_options: BootOptionsObserved { options: [http_option()] },
    nics: NicsObserved { nics: ["eth0"] },
    secure_boot: SecureBootDisabled,
    bios_version: BiosVersionObserved { version: "1.08" },
  )
}

fn standing_of(observation: FirmwareBootObservation) -> FirmwareNetworkBootStanding {
  firmware_network_boot_standing(
    observation: observation,
    authority: witness_authority,
    observed_at: witness_epoch,
    boot_mode: UefiPxe { tftp_root: uri_https(locator: "edge.invalid/pxe") },
  )
}

fn with_boot_order(boot_order: BootOrderObservation) -> FirmwareBootObservation {
  firmware_boot_observation(
    boot_order: boot_order,
    boot_options: BootOptionsObserved { options: [http_option()] },
    nics: NicsObserved { nics: ["eth0"] },
    secure_boot: SecureBootDisabled,
    bios_version: BiosVersionObserved { version: "1.08" },
  )
}

fn with_boot_options(options: BootOptionsObservation) -> FirmwareBootObservation {
  firmware_boot_observation(
    boot_order: BootOrderObserved { devices: network_then_disk() },
    boot_options: options,
    nics: NicsObserved { nics: ["eth0"] },
    secure_boot: SecureBootDisabled,
    bios_version: BiosVersionObserved { version: "1.08" },
  )
}

fn with_nics(nics: NicsObservation) -> FirmwareBootObservation {
  firmware_boot_observation(
    boot_order: BootOrderObserved { devices: network_then_disk() },
    boot_options: BootOptionsObserved { options: [http_option()] },
    nics: nics,
    secure_boot: SecureBootDisabled,
    bios_version: BiosVersionObserved { version: "1.08" },
  )
}

fn with_secure_boot(secure_boot: SecureBootObservation) -> FirmwareBootObservation {
  firmware_boot_observation(
    boot_order: BootOrderObserved { devices: network_then_disk() },
    boot_options: BootOptionsObserved { options: [http_option()] },
    nics: NicsObserved { nics: ["eth0"] },
    secure_boot: secure_boot,
    bios_version: BiosVersionObserved { version: "1.08" },
  )
}

fn with_bios(bios_version: BiosVersionObservation) -> FirmwareBootObservation {
  firmware_boot_observation(
    boot_order: BootOrderObserved { devices: network_then_disk() },
    boot_options: BootOptionsObserved { options: [http_option()] },
    nics: NicsObserved { nics: ["eth0"] },
    secure_boot: SecureBootDisabled,
    bios_version: bios_version,
  )
}

test fn the_happy_unit_is_ready_and_carries_every_ready_field() -> Bool {
  match standing_of(observation: good_observation()) {
    Ready { firmware_mode: mode, network_interface: nic, evidence: ev } =>
      match mode {
        UefiPxe { tftp_root: _ } =>
          nic == "eth0"
            && match ev.observation.bios_version {
                 BiosVersionObserved { version: v } => v == "1.08"
                 _ => false
               }
        _ => false
      }
    _ => false
  }
}

fn evidence_observation(ev: ReadyEvidence) -> FirmwareBootObservation {
  ev.observation
}

// THE HONESTY RUNG: on each of the five axes, an Unobserved arm outranks the identical-looking
// Ready the other four axes would support. If any of these five produces Ready, a unit whose
// Secure Boot (say) was never asked about gets an unsigned chainloader aimed at it.
test fn boot_order_unobserved_never_reads_ready() -> Bool {
  match standing_of(observation: with_boot_order(boot_order: BootOrderUnobserved { reason: "probe skipped" })) {
    Unobserved { unanswered: gaps } => length_of(gaps)
    _ => false
  }
}

test fn boot_options_unobserved_never_reads_ready() -> Bool {
  match standing_of(observation: with_boot_options(options: BootOptionsUnobserved { reason: "redfish refused listing" })) {
    Unobserved { unanswered: gaps } => length_of(gaps)
    _ => false
  }
}

test fn nics_unobserved_never_reads_ready() -> Bool {
  match standing_of(observation: with_nics(nics: NicsUnobserved { reason: "family cannot answer" })) {
    Unobserved { unanswered: gaps } => length_of(gaps)
    _ => false
  }
}

test fn secure_boot_unobserved_never_reads_ready() -> Bool {
  match standing_of(observation: with_secure_boot(secure_boot: SecureBootUnobserved { reason: "not asked" })) {
    Unobserved { unanswered: gaps } => length_of(gaps)
    _ => false
  }
}

test fn bios_unobserved_never_reads_ready() -> Bool {
  match standing_of(observation: with_bios(bios_version: BiosVersionUnobserved { reason: "no reader for family" })) {
    Unobserved { unanswered: gaps } => length_of(gaps)
    _ => false
  }
}

// A non-empty gap list, without betting on a list-destructuring form the corpus does not use:
// any() over an empty list is false, so this is exactly 'at least one axis went unanswered'.
fn length_of(gaps: List<UnansweredAxis>) -> Bool {
  any(gaps, g => true)
}

// On any axis, a REFUSAL keeps its cause instead of degrading to Unobserved: the remedies differ
// (go ask vs. stop asking that way) and the report line differs too.
test fn refusal_on_any_axis_keeps_its_cause() -> Bool {
  match standing_of(observation: with_boot_order(boot_order: BootOrderRefused { refusal: VendorCommandRejected { detail: "ipmi vendor command rejected" } })) {
    Refused { cause: TransportRefusedVendorCommand { refusal: VendorCommandRejected { detail: r } }, gaps: _ } => r == "ipmi vendor command rejected"
    _ => false
  }
    && match standing_of(observation: with_nics(nics: NicsRefused { refusal: ResourceNotFound { detail: "redfish nic collection denied" } })) {
         Refused { cause: TransportRefusedVendorCommand { refusal: ResourceNotFound { detail: r } }, gaps: _ } => r == "redfish nic collection denied"
         _ => false
       }
    && match standing_of(observation: with_secure_boot(secure_boot: SecureBootRefused { refusal: AuthenticationRequired { detail: "secure boot property hidden" } })) {
         Refused { cause: TransportRefusedVendorCommand { refusal: _ }, gaps: _ } => true
         _ => false
       }
}

// SECURE BOOT ON IS NOT READY AND NOT REFUSED: it is preparation. The board may well boot the
// pinned chainloader once a covering certificate is enrolled; saying Ready sends it to fail, and
// saying Refused tells the operator the board cannot network boot, which is false.
test fn secure_boot_enabled_is_preparation_with_a_cataloged_attribute_route() -> Bool {
  match standing_of(observation: with_secure_boot(secure_boot: SecureBootEnabled)) {
    NeedsPreparation { route: RedfishBiosAttributes { service_root: s, attribute: a }, blocking: b } =>
      s == "redfish:Bios" && a == "SecureBoot"
        && match b {
             SecureBootBlocksUnsignedChainloader => route_is_cataloged(route: RedfishBiosAttributes { service_root: "redfish:Bios", attribute: "SecureBoot" })
             _ => false
           }
    _ => false
  }
}

// A network-less boot order gets a route AND the blocking axis that explains the route; the
// options axis being answered-and-empty must not look like the options axis being unasked.
test fn answered_and_absent_is_preparation_not_unobserved() -> Bool {
  match standing_of(observation: with_boot_options(options: BootOptionsObserved { options: [] })) {
    NeedsPreparation { route: r, blocking: b } =>
      route_is_cataloged(route: r)
        && match b {
             NoNetworkBootOptionListed => true
             _ => false
           }
    Unobserved { unanswered: _ } => false
    _ => false
  }
}

// More than one candidate NIC and no evidence which carries PXE must NOT silently pick the first.
// This is the machine-name-selection failure wearing a different hat: deterministic, reproducible,
// and wrong on the first board whose ports differ from the guess.
test fn two_candidate_nics_refuse_to_guess_the_first() -> Bool {
  match standing_of(observation: with_nics(nics: NicsObserved { nics: ["eth0", "eth1"] })) {
    NeedsPreparation { route: r, blocking: b } =>
      route_is_cataloged(route: r)
        && match b {
             NoInterfaceCarriesPxe => true
             _ => false
           }
    _ => false
  }
}

// THE READINESS FN IS TOTAL: twelve inputs covering every axis arm of every axis produce a
// standing (never a load error, never no-arm), each landing in exactly one of the four variants.
test fn the_readiness_fn_is_total_over_a_mixed_observation_matrix() -> Bool {
  is_standing(standing_of(observation: good_observation()))
    && is_standing(standing_of(observation: with_boot_order(boot_order: BootOrderObserved { devices: [] })))
    && is_standing(standing_of(observation: with_boot_order(boot_order: BootOrderUnobserved { reason: "x" })))
    && is_standing(standing_of(observation: with_boot_order(boot_order: BootOrderRefused { refusal: VendorCommandRejected { detail: "x" } })))
    && is_standing(standing_of(observation: with_boot_options(options: BootOptionsObserved { options: [] })))
    && is_standing(standing_of(observation: with_boot_options(options: BootOptionsUnobserved { reason: "x" })))
    && is_standing(standing_of(observation: with_boot_options(options: BootOptionsRefused { refusal: ResourceNotFound { detail: "x" } })))
    && is_standing(standing_of(observation: with_nics(nics: NicsObserved { nics: [] })))
    && is_standing(standing_of(observation: with_nics(nics: NicsObserved { nics: ["a", "b"] })))
    && is_standing(standing_of(observation: with_nics(nics: NicsUnobserved { reason: "x" })))
    && is_standing(standing_of(observation: with_nics(nics: NicsRefused { refusal: AuthenticationRequired { detail: "x" } })))
    && is_standing(standing_of(observation: with_secure_boot(secure_boot: SecureBootEnabled)))
    && is_standing(standing_of(observation: with_secure_boot(secure_boot: SecureBootUnobserved { reason: "x" })))
    && is_standing(standing_of(observation: with_secure_boot(secure_boot: SecureBootRefused { refusal: ReplyShapeUnrecognized { detail: "x" } })))
    && is_standing(standing_of(observation: with_bios(bios_version: BiosVersionUnobserved { reason: "x" })))
    && is_standing(standing_of(observation: with_bios(bios_version: BiosVersionRefused { refusal: VendorCommandRejected { detail: "x" } })))
}

fn is_standing(standing: FirmwareNetworkBootStanding) -> Bool {
  match standing {
    Ready { firmware_mode: _, network_interface: _, evidence: _ } => true
    NeedsPreparation { route: _, blocking: _ } => true
    Unobserved { unanswered: _ } => true
    Refused { cause: _, gaps: _ } => true
  }
}

// EVERY ROUTE THE SEAM CAN POINT AT IS A CATALOG ROW. This is what makes the catalog the owner
// rather than a document about the code: decide()'s and the readiness fn's routes are checked
// against the rows, so adding an un-rowed route anywhere breaks THIS test, not production.
test fn every_route_the_seam_emits_is_cataloged() -> Bool {
  every_emitted_route_cataloged(standing_of(observation: with_boot_order(boot_order: BootOrderObserved { devices: [] })))
    && every_emitted_route_cataloged(standing_of(observation: with_boot_order(boot_order: BootOrderObserved { devices: [disk("NVMe0"), disk("NVMe1")] })))
    && every_emitted_route_cataloged(standing_of(observation: with_boot_options(options: BootOptionsObserved { options: [] })))
    && every_emitted_route_cataloged(standing_of(observation: with_secure_boot(secure_boot: SecureBootEnabled)))
    && every_emitted_route_cataloged(standing_of(observation: with_nics(nics: NicsObserved { nics: ["a", "b"] })))
}

fn every_emitted_route_cataloged(standing: FirmwareNetworkBootStanding) -> Bool {
  match standing {
    NeedsPreparation { route: r, blocking: _ } => route_is_cataloged(route: r)
    _ => true
  }
}

// EVERY ROUTE THE CATALOG OWNS ROUND-TRIPS, and two mechanisms never collapse into one another.
// The attribute names here are the ones the catalog really rows -- the BootMode row that used to be
// asserted was removed, because it resolved no blocker and no branch reached it: data claiming a
// capability nothing could reach is the same defect as a code path with no data behind it.
test fn every_cataloged_route_round_trips_and_never_confuses_mechanisms() -> Bool {
  route_is_cataloged(route: IpmiOneShotOverride { channel: "ipmi:chassis-boot-override" })
    && route_is_cataloged(route: RedfishOneShotOverride { service_root: "redfish:Systems/Self" })
    && route_is_cataloged(route: RedfishUefiBootNext { service_root: "redfish:Systems/Self", boot_option: "uefi-boot-next" })
    && route_is_cataloged(route: RedfishBiosAttributes { service_root: "redfish:Bios", attribute: "NetworkStack" })
    && route_is_cataloged(route: RedfishBiosAttributes { service_root: "redfish:Bios", attribute: "NicBootSelection" })
    && route_is_cataloged(route: RedfishBiosAttributes { service_root: "redfish:Bios", attribute: "SecureBoot" })
    && route_is_cataloged(route: UefiShellOverSol { sol_channel: "sol:0", script: "netboot.efi" })
    && route_is_cataloged(route: HumanConsole { instruction: "attend the unit and select the network device" })
    && !route_eq(
         a: IpmiOneShotOverride { channel: "ipmi:chassis-boot-override" },
         b: RedfishOneShotOverride { service_root: "ipmi:chassis-boot-override" },
       )
    && !route_eq(
         a: RedfishBiosAttributes { service_root: "redfish:Bios", attribute: "NetworkStack" },
         b: RedfishBiosAttributes { service_root: "redfish:Bios", attribute: "SecureBoot" },
       )
}

// THE CATALOG IS NOT A HOST TABLE: rows are keyed on the route and every row carries an
// authority; a row that lost its citation would turn "the fleet knows this mechanism" into
// "somebody once said this works".
test fn the_catalog_rows_are_route_keyed_and_each_carries_an_authority() -> Bool {
  count_cataloged(firmware_network_boot_preparation_routes)
}

fn count_cataloged(rows: List<RouteAuthority>) -> Bool {
  for_all(xs: rows, predicate: row => route_has_authority(row: row))
}

fn route_has_authority(row: RouteAuthority) -> Bool {
  match row.authority {
    CitedToAuthority { authority: _ } => true
    TranscribedUncited { read_obligation: _ } => true
    ObservedByReceipt { observed: _ } => true
  }
}

// THE ATTEMPT ABSORBS, NEVER DUPLICATES: an attempt on a route the fleet has no row for is
// refused at construction (Absent), and a cataloged one keeps its BootControlReceiptStanding —
// the type delivery owns — rather than this seam minting a rival receipt.
test fn an_attempt_on_an_uncataloged_route_cannot_be_constructed() -> Bool {
  let uncataloged_refused =
    match synthetic_attempt(route: UefiShellOverSol { sol_channel: "sol:0", script: "made-up.efi" }) {
      AttemptRouteUncataloged { route: _ } => true
      AttemptConstructed { attempt: _ } => false
    }
  let cataloged_constructs =
    match synthetic_attempt(route: IpmiOneShotOverride { channel: "ipmi:chassis-boot-override" }) {
      AttemptConstructed { attempt: _ } => true
      AttemptRouteUncataloged { route: _ } => false
    }
  uncataloged_refused && cataloged_constructs
}

// The boot-control ABSORPTION is enforced at load time, not asserted here: NetworkBootAttempt's
// boot_control field is typed as gunbc.network_boot_delivery's BootControlReceiptStanding, so a
// rival spelling in this seam would not load. What this witness can say is which standing the
// synthetic attempt carries — and that the seam's own receipt cannot be minted without one.
fn boot_control_is_the_imported_standing(control: BootControlReceiptStanding) -> Bool {
  match control {
    BootControlUnobserved => true
    BootControlObserved { receipt: _ } => false
    BootControlPredecessor { observation: _ } => false
  }
}

test fn the_attempt_receipt_cannot_be_minted_without_its_attempt_and_control_receipt() -> Bool {
  match synthetic_attempt(route: IpmiOneShotOverride { channel: "ipmi:chassis-boot-override" }) {
    AttemptConstructed { attempt: built } => boot_control_is_the_imported_standing(control: built.boot_control)
    AttemptRouteUncataloged { route: _ } => false
  }
}

fn synthetic_attempt(route: FirmwareNetworkBootPreparationRoute) -> NetworkBootAttemptConstruction {
  network_boot_attempt(
    route: route,
    boot_control: BootControlUnobserved,
    reset_observed_at: witness_epoch,
    resulting_dhcp: DhcpOfferObserved { offer_ref: "synthetic-offer" },
    unit_label: "synthetic-unit",
  )
}

// THE READY'S EVIDENCE IS THE OBSERVATION ITSELF: the constructor keeps what it checked, so a
// later reader can re-derive the verdict instead of trusting the tag.
test fn ready_evidence_preserves_the_observation_it_was_computed_from() -> Bool {
  let observation = good_observation()
  match firmware_network_boot_standing(
    observation: observation,
    authority: witness_authority,
    observed_at: witness_epoch,
    boot_mode: UefiHttpBoot,
  ) {
    Ready { firmware_mode: UefiHttpBoot, network_interface: _, evidence: ev } =>
      ev.observed_at == witness_epoch
        && match ev.observation.bios_version {
             BiosVersionObserved { version: v } => v == "1.08"
             _ => false
           }
    _ => false
  }
}

// THE SEAM CANNOT MINT A MODE, ONLY CARRY ONE (review 81689). The same edge-facts-bearing
// observation, offered to the seam with each of the two UEFI modes, yields a Ready carrying the
// mode it was handed and nothing else: no second protocol field exists to contradict it, and the
// seam has no TFTP root or URL of its own to fill one. If a site constant ever reappears in the
// seam, or a second axis reappears beside the mode, THIS test cannot still pass, because the
// match below names the arm's fields exactly.
test fn the_seam_carries_the_edge_mode_it_was_given_and_adds_none_of_its_own() -> Bool {
  match firmware_network_boot_standing(
    observation: good_observation(),
    authority: witness_authority,
    observed_at: witness_epoch,
    boot_mode: UefiHttpBoot,
  ) {
    Ready { firmware_mode: UefiHttpBoot, network_interface: _, evidence: _ } =>
      match firmware_network_boot_standing(
        observation: good_observation(),
        authority: witness_authority,
        observed_at: witness_epoch,
        boot_mode: UefiPxe { tftp_root: uri_https(locator: "edge.invalid/pxe") },
      ) {
        Ready { firmware_mode: UefiPxe { tftp_root: _ }, network_interface: _, evidence: _ } => true
        _ => false
      }
    _ => false
  }
}

// A LEGACY-BIOS UNIT IS REFUSED, NOT SILENTLY READY: the cut-6 edge serves UEFI only, so the
// honest standing is a refusal naming the edge as the limitation. It must not read Unobserved (we
// know the mode and we know our edge) and must not read Ready (it would boot nothing).
test fn a_legacy_bios_unit_is_refused_because_the_edge_cannot_serve_it() -> Bool {
  match firmware_network_boot_standing(
    observation: good_observation(),
    authority: witness_authority,
    observed_at: witness_epoch,
    boot_mode: LegacyBiosPxe { tftp_root: uri_https(locator: "edge.invalid/pxe") },
  ) {
    Refused { cause: FirmwareModeUnsupportedByEdge { why: _ }, gaps: _ } => true
    _ => false
  }
}

// A READY'S INTERFACE IS THE SINGLE OBSERVED NIC, verbatim, lowercased not by us: the seam does
// not rewrite firmware spellings, because then the receipt would name something the firmware
// never said.
test fn the_ready_names_the_firmware_spelled_interface_verbatim() -> Bool {
  match standing_of(observation: with_nics(nics: NicsObserved { nics: ["NIC-Port-1"] })) {
    Ready { firmware_mode: _, network_interface: nic, evidence: _ } => nic == "NIC-Port-1"
    _ => false
  }
}

// THE ATTEMPT RECEIPT IS NOT MINTABLE WITHOUT ALL THREE PARTS. The receipt type is
// sole_constructor, and the only way through it is an attempt, the standing that resulted, and
// gunbc.network_boot_delivery's own boot-control receipt. This test mints the foreign-offer
// case specifically: an attempt whose reset produced an offer from SOMEONE ELSE (another edge,
// or the router answering when it should not be) still receipts completely, because 'the boot
// went wrong in this specific way' is a fact worth keeping, not a reason to lose the receipt.
test fn the_attempt_receipt_keeps_the_outcome_and_the_foreign_offer_too() -> Bool {
  match synthetic_attempt(route: RedfishOneShotOverride { service_root: "redfish:Systems/Self" }) {
    AttemptConstructed { attempt: built } =>
      match firmware_network_boot_attempt_receipt(
        attempt: built,
        outcome: Refused {
        cause: FirmwareModeUnsupportedByEdge { why: "edge serves UEFI only" },
        gaps: [],
      },
      ) {
        receipt =>
          match receipt.attempt.resulting_dhcp {
            DhcpOfferObserved { offer_ref: _ } => true
            _ => false
          }
            && match receipt.outcome {
                 Refused { cause: FirmwareModeUnsupportedByEdge { why: _ }, gaps: _ } => true
                 _ => false
               }
      }
    AttemptRouteUncataloged { route: _ } => false
  }
}

// The foreign/silent DHCP standings are distinct facts (no packet vs. someone else answered) and
// both must survive an attempt unchanged — collapsing them is how 'two edges are both answering'
// gets reported as 'PXE is broken'.
test fn the_dhcp_standing_survives_the_attempt_unchanged_and_distinguishes_silence_from_foreign() -> Bool {
  match network_boot_attempt(
    route: IpmiOneShotOverride { channel: "ipmi:chassis-boot-override" },
    boot_control: BootControlUnobserved,
    reset_observed_at: witness_epoch,
    resulting_dhcp: DhcpForeignOffer { observed_from: "192.0.2.9" },
    unit_label: "synthetic-unit",
  ) {
    AttemptConstructed { attempt: built } =>
      match built.resulting_dhcp {
        DhcpForeignOffer { observed_from: seen } => seen == "192.0.2.9"
        DhcpSilent { why: _ } => false
        DhcpOfferObserved { offer_ref: _ } => false
      }
    AttemptRouteUncataloged { route: _ } => false
  }
    && match network_boot_attempt(
         route: IpmiOneShotOverride { channel: "ipmi:chassis-boot-override" },
         boot_control: BootControlUnobserved,
         reset_observed_at: witness_epoch,
         resulting_dhcp: DhcpSilent { why: "no offer within timeout" },
         unit_label: "synthetic-unit",
       ) {
         AttemptConstructed { attempt: built } =>
           match built.resulting_dhcp {
             DhcpSilent { why: w } => w == "no offer within timeout"
             _ => false
           }
         AttemptRouteUncataloged { route: _ } => false
       }
}

// ─────────────────────────────────────────────────────────────────────────────
// REVIEW 81689 FINDINGS 4 AND 5, MADE TESTABLE. The type grew to carry every
// unanswered axis and to keep gaps alongside a refusal; a bigger type that
// nothing asserts is a bigger lie waiting to happen. These are the assertions.
// ─────────────────────────────────────────────────────────────────────────────

fn names_boot_order_axis(gap: UnansweredAxis) -> Bool {
  match gap {
    BootOrderAxisUnanswered { absence: _ } => true
    _ => false
  }
}

fn names_secure_boot_axis(gap: UnansweredAxis) -> Bool {
  match gap {
    SecureBootAxisUnanswered { absence: _ } => true
    _ => false
  }
}

fn names_bios_axis(gap: UnansweredAxis) -> Bool {
  match gap {
    BiosAxisUnanswered { absence: _ } => true
    _ => false
  }
}

// THE GAP LIST IS NOT A SINGLE-ELEMENT LIST IN DISGUISE. Secure Boot and BIOS both
// unanswered on one unit must appear as two gaps: the report line the type promises
// ('three units were never asked about Secure Boot') is unanswerable if only the
// first axis ever survives the fold.
test fn every_unanswered_axis_survives_the_fold_not_just_the_first() -> Bool {
  let observation = firmware_boot_observation(
    boot_order: BootOrderObserved { devices: [pxe_stack()] },
    boot_options: BootOptionsObserved { options: [http_option()] },
    nics: NicsObserved { nics: ["eth0"] },
    secure_boot: SecureBootUnobserved { reason: "family cannot answer" },
    bios_version: BiosVersionUnobserved { reason: "no reader" },
  )
  match firmware_network_boot_standing(
    observation: observation,
    authority: witness_authority,
    observed_at: witness_epoch,
    boot_mode: UefiHttpBoot,
  ) {
    Unobserved { unanswered: gaps } =>
      any(gaps, g => names_secure_boot_axis(gap: g)) && any(gaps, g => names_bios_axis(gap: g))
    _ => false
  }
}

// A REFUSAL MUST NOT SWALLOW THE UNKNOWN. When boot order was refused and Secure
// Boot was never asked, the operator needs BOTH facts in one visit: the refusal to
// chase and the gap to go ask about. The pre-review shape returned the refusal and
// silently dropped the Secure Boot unknown.
test fn a_refusal_keeps_its_cause_and_reports_the_unasked_axes_too() -> Bool {
  let observation = firmware_boot_observation(
    boot_order: BootOrderRefused { refusal: VendorCommandRejected { detail: "ipmi vendor command rejected" } },
    boot_options: BootOptionsObserved { options: [http_option()] },
    nics: NicsObserved { nics: ["eth0"] },
    secure_boot: SecureBootUnobserved { reason: "never asked" },
    bios_version: BiosVersionObserved { version: "1.08" },
  )
  match firmware_network_boot_standing(
    observation: observation,
    authority: witness_authority,
    observed_at: witness_epoch,
    boot_mode: UefiHttpBoot,
  ) {
    Refused { cause: TransportRefusedVendorCommand { refusal: VendorCommandRejected { detail: d } }, gaps: gaps } =>
      d == "ipmi vendor command rejected"
        && any(gaps, g => names_boot_order_axis(gap: g))
        && any(gaps, g => names_secure_boot_axis(gap: g))
    _ => false
  }
}

// NOT-ASKED AND REFUSED ARE DIFFERENT KINDS OF MISSING, per axis: a probe coverage
// gap and a transport denial must be countable apart, or 'BMC will not answer' gets
// filed as 'nobody ran the probe' and nobody goes to fix the BMC.
test fn the_kind_of_absence_is_typed_per_axis() -> Bool {
  let observation = firmware_boot_observation(
    boot_order: BootOrderObserved { devices: [pxe_stack()] },
    boot_options: BootOptionsObserved { options: [http_option()] },
    nics: NicsObserved { nics: ["eth0"] },
    secure_boot: SecureBootUnobserved { reason: "never asked" },
    bios_version: BiosVersionRefused { refusal: AuthenticationRequired { detail: "credentials absent" } },
  )
  match firmware_network_boot_standing(
    observation: observation,
    authority: witness_authority,
    observed_at: witness_epoch,
    boot_mode: UefiHttpBoot,
  ) {
    Refused { cause: TransportRefusedVendorCommand { refusal: AuthenticationRequired { detail: d } }, gaps: gaps } =>
      d == "credentials absent"
        && any(gaps, g => gap_was_not_asked(gap: g))
        && any(gaps, g => gap_was_refused(gap: g))
    _ => false
  }
}

fn gap_was_not_asked(gap: UnansweredAxis) -> Bool {
  match gap {
    SecureBootAxisUnanswered { absence: AxisNotAsked { reason: _ } } => true
    _ => false
  }
}

fn gap_was_refused(gap: UnansweredAxis) -> Bool {
  match gap {
    BiosAxisUnanswered { absence: AxisRefused { refusal: _ } } => true
    _ => false
  }
}

// THE ROUTE MUST BE ABLE TO FIX WHAT IT CLAIMS IS BLOCKING. A boot order full of
// non-network entries cannot be fixed by a one-shot override: an override only
// points at an entry the list already contains, and this unit has none. The route
// has to be the attribute that ENABLES a network stack, and it must not be a
// one-shot wearing the right-looking name.
test fn a_boot_order_with_no_network_entry_gets_the_route_that_can_add_one() -> Bool {
  let observation = firmware_boot_observation(
    boot_order: BootOrderObserved { devices: [disk("NVMe0"), disk("NVMe1"), disk("SATA0")] },
    boot_options: BootOptionsObserved { options: [http_option()] },
    nics: NicsObserved { nics: ["eth0"] },
    secure_boot: SecureBootDisabled,
    bios_version: BiosVersionObserved { version: "1.08" },
  )
  match firmware_network_boot_standing(
    observation: observation,
    authority: witness_authority,
    observed_at: witness_epoch,
    boot_mode: UefiHttpBoot,
  ) {
    NeedsPreparation { route: RedfishBiosAttributes { service_root: s, attribute: a }, blocking: b } =>
      s == "redfish:Bios"
        && a == "NetworkStack"
        && match b {
             NoNetworkStackInBootOrder => route_is_cataloged(route: RedfishBiosAttributes { service_root: "redfish:Bios", attribute: "NetworkStack" })
             _ => false
           }
    _ => false
  }
}

// ---------------------------------------------------------------------------
// THE TWO THINGS REVIEW 81711 FOUND, NOW WITNESSED DIRECTLY.
// ---------------------------------------------------------------------------

// NETWORK-NESS IS A KIND, NOT A SUBSTRING. Labels are made to mislead here on purpose: a firmware
// can spell an iSCSI target 'IPv4', a diagnostics shell 'HTTP', or a USB recovery stick 'UEFI
// Network Device', and the seam must be unmoved. The converse arm matters as much: an entry the
// schema calls Pxe is network-bootable even when its label says nothing network-shaped at all, so a
// unit is not stranded because a vendor named its option after the box it shipped in. If anyone
// reintroduces label matching, one of these two arms goes red.
test fn classification_is_the_kind_and_the_label_is_never_consulted() -> Bool {
  let misleadingly_network_labels: List<BootEntry> = [
    boot_entry(kind: BootTargetHdd, label: "IPv4 iSCSI target (SanDisk)"),
    boot_entry(kind: BootTargetUsb, label: "UEFI Network Device: USB Recovery"),
    boot_entry(kind: BootTargetCd, label: "HTTP Boot Diagnostics"),
    boot_entry(kind: BootTargetBiosSetup, label: "Network Stack Setup"),
    boot_entry(kind: BootTargetDiags, label: "PXE Diagnostics Shell"),
    boot_entry(kind: BootTargetNone, label: "Network Boot (Disabled)"),
  ]
  let honestly_network_label: BootEntry = boot_entry(kind: BootTargetPxe, label: "ALTRAD8UD-1L2T")
  length(xs: misleadingly_network_labels) == 6
    && !has_network_entry(entries: misleadingly_network_labels)
    && has_network_entry(entries: [honestly_network_label])
    && is_network_target(kind: BootTargetUefiHttp)
    && !is_network_target(kind: BootTargetHdd)
}

// THE UNIT THAT LOOKS BOOTABLE AND ISN'T: a board whose entire boot order is 'IPv4'-named disks must
// not read Ready. Under the substring rule this exact observation produced a Ready, because 'IPv4'
// was on the spelling list -- a unit scheduled for a network boot it could never perform.
test fn an_all_disk_boot_order_with_network_shaped_labels_is_not_ready() -> Bool {
  let observation = firmware_boot_observation(
    boot_order: BootOrderObserved {
      devices: [
        boot_entry(kind: BootTargetHdd, label: "IPv4 SanDisk NVMe"),
        boot_entry(kind: BootTargetHdd, label: "UEFI Network Stack Data"),
        boot_entry(kind: BootTargetCd, label: "HTTP Recovery"),
      ],
    },
    boot_options: BootOptionsObserved { options: [http_option()] },
    nics: NicsObserved { nics: ["eth0"] },
    secure_boot: SecureBootDisabled,
    bios_version: BiosVersionObserved { version: "1.08" },
  )
  match firmware_network_boot_standing(
    observation: observation,
    authority: witness_authority,
    observed_at: witness_epoch,
    boot_mode: UefiHttpBoot,
  ) {
    NeedsPreparation { route: r, blocking: b } =>
      route_is_cataloged(route: r)
        && match b {
             NoNetworkStackInBootOrder => true
             _ => false
           }
    Ready { firmware_mode: _, network_interface: _, evidence: _ } => false
    _ => false
  }
}

// THE ROUTE CAN FIX THE BLOCKING, AND NOTHING ELSE CAN SAY SO. Every catalog row is checked
// against the ONE table of what each mechanism physically does. This is the witness that makes the
// pairing a modeled relation instead of a comment: it fails on any edit that pairs a one-shot
// override with 'no network stack', or a BIOS attribute with nothing, anywhere in the table -- the
// two sites I got wrong are now one assertion over the data.
test fn every_catalog_row_resolves_the_blocker_it_is_keyed_on() -> Bool {
  for_all(xs: firmware_network_boot_preparation_routes, predicate: row =>
    // FINDABLE BY ITS OWN BLOCKER, among the rows for that blocker. Not 'is the first row for it':
    // a blocker may legitimately have several mechanisms that work, and the readiness fn takes the
    // first as the fleet's preference. What is not legitimate is a row whose mechanism cannot
    // physically move the blocker it is filed under -- so that is exactly what is asserted here.
    row_is_filed_under_its_blocker(row: row) && mechanism_resolves(mechanism: row.route, blocker: row.resolves)
  )
}

fn row_is_filed_under_its_blocker(row: RouteAuthority) -> Bool {
  length(xs: catalog_rows_for(blocker: row.resolves)) > 0
    && length(xs: filter(catalog_rows_for(blocker: row.resolves), candidate => route_eq(a: candidate.route, b: row.route))) > 0
}

// NO BLOCKER IS LEFT WITHOUT A REMEDY: every value of PreparationBlockingOn has at least one row,
// so the readiness fn can never answer a real blocker with 'nobody owns this'. A new blocker
// without a row breaks here rather than in a datacenter.
test fn every_blocker_has_a_route_that_can_act_on_it() -> Bool {
  blocker_has_row(blocker: NoNetworkStackInBootOrder)
    && blocker_has_row(blocker: NoNetworkBootOptionListed)
    && blocker_has_row(blocker: NoInterfaceCarriesPxe)
    && blocker_has_row(blocker: SecureBootBlocksUnsignedChainloader)
    && blocker_has_row(blocker: OverrideMechanismUnsupported)
}

fn blocker_has_row(blocker: PreparationBlockingOn) -> Bool {
  match route_for_blocking(blocker: blocker) {
    Present { value: row } => mechanism_resolves(mechanism: row.route, blocker: blocker)
    Absent => false
  }
}

// THE CATALOG VIEWED BY BLOCKER, which is the only view the readiness fn is allowed to use. The
// witness keeps its own copy rather than reaching into a private helper, because 'can a blocker
// even be looked up' is the thing under test and sharing the implementation would make the test
// agree with the code by construction.
fn catalog_rows_for(blocker: PreparationBlockingOn) -> List<RouteAuthority> {
  filter(firmware_network_boot_preparation_routes, row => blocking_eq(a: row.resolves, b: blocker))
}
