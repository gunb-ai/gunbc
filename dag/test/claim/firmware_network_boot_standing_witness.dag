  HeadJoinStanding,
  HeadJoinsEnabledOption,
  HeadJoinsDisabledOption,
  HeadOptionNotEnumerated,
  HeadOrderEmpty,
  HeadEnumerationEmpty,
  available_network_options,
  option_with_reference,
  firmware_network_boot_probe_frontier,
  firmware_network_boot_standing_consumer_frontier,
  firmware_network_boot_probe_producer_ref,
  firmware_network_boot_standing_consumer_ref,
  frontier_status,
  firmware_network_boot_observation_inhabitation,
  BoundaryInhabitation,
  Uninhabited,
  route_for_blocking,
  blocker_of,
  authority_of,
  route_prose,
