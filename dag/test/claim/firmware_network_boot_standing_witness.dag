module test.claim.firmware_network_boot_standing_witness

// WITNESS FOR THE CUT-6 READINESS SEAM (S0). Every test builds SYNTHETIC observations inside a
// test fn; no data row here is a fleet fact. The property under test is the seam's honesty: a
// Ready must be traceable to evidence, an unanswered axis must outrank a plausible Ready, a
// refusal keeps its cause, and every route the seam emits is a route the catalog owns.

import std.types { Bool, EpochMs, List, NonEmptyStr }
import std.algebra { string_contains }
// THE FRONTIER IS WITNESSED, NOT ASSERTED IN PROSE: the witness reads the bound triggers and
// states what their status is TODAY, so the day the probe lands, this is the thing that changes.
import std.dissolution { DissolutionPending, DissolutionFired }
import std.decl_ref { DeclarationRef, declaration_ref_eq, decl_ref }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import extdeps.external_authority { CitedFigureStanding, CitedToAuthority, ExternalAuthority, ObservedByReceipt, TranscribedUncited }
import extdeps.uri { uri_https }
import extdeps.provisioning.network_boot { LegacyBiosPxe, UefiPxe, UefiHttpBoot }
// THE SAME ENUM THE SEAM CLASSIFIES AGAINST, imported by the witness so a fixture states a KIND
// rather than a label the seam would have to guess about.
import extdeps.bmc.types {
  NetworkBootTarget,
  NotNetworkBootTarget,
  redfish_boot_target_network_standing,
  BootTargetNone,
  BootTargetPxe,
  BootTargetHdd,
  BootTargetCd,
  BootTargetUsb,
  BootTargetBiosSetup,
  BootTargetDiags,
  BootTargetUefiHttp,
}
import gunbc.network_boot_delivery { BootControlObserved, BootControlPredecessor, BootControlReceiptStanding, BootControlUnobserved }
import gunbc.firmware_network_boot_standing {
  AxisNotAsked,
  AxisRefused,
  BootOrderAxisUnanswered,
  SecureBootAxisUnanswered,
  BiosAxisUnanswered,
  NetworkInterfaceAxisUnanswered,
  BootOptionsAxisUnanswered,
  BootOptionsObserved,
  BootOptionsObservation,
  BootOptionsRefused,
  BootOptionsUnobserved,
  BootOrderObserved,
  BootOrderObservation,
  BootOrderRefused,
  BootOrderUnobserved,
  BiosVersionObserved,
  BiosVersionObservation,
  BiosVersionRefused,
  BiosVersionUnobserved,
  AttemptConstructed,
  AttemptDhcpStanding,
  NetworkBootAttemptConstruction,
  DhcpOfferObserved,
  DhcpForeignOffer,
  DhcpSilent,
  FirmwareBootObservation,
  FirmwareNetworkBootAttemptReceipt,
  FirmwareNetworkBootPreparationRoute,
  FirmwareNetworkBootRefusal,
  FirmwareNetworkBootStanding,
  HumanConsole,
  IpmiOneShotOverride,
  NetworkBootAttempt,
  NicsObserved,
  NicsObservation,
  NicsRefused,
  NicsUnobserved,
  PreparationBlockingOn,
  EnableNetworkStack,
  PointUefiBootNext,
  SelectNicBoot,
  SetSecureBootAttribute,
  mechanism_name,
  ReadyEvidence,
  RedfishOneShotOverride,
  BootEntry,
  boot_entry,
  network_entries_in,
  NetworkEntryStanding,
  NoNetworkEntry,
  NetworkEntriesPresent,
  firmware_network_boot_probe_frontier,
  firmware_network_boot_standing_consumer_frontier,
  firmware_network_boot_probe_producer_ref,
  firmware_network_boot_standing_consumer_ref,
  frontier_status,
  firmware_network_boot_observation_inhabitation,
  BoundaryInhabitation,
  Uninhabited,
  route_for_blocking,
  blocker_of,
  authority_of,
  route_prose,
  route_is_admissible_for,
  procedure_demands_existing_option,
  route_requires,
  ProcedureRequires,
  RequiresExistingBootOption,
  SecureBootDisabled,
  SecureBootEnabled,
  SecureBootObservation,
  SecureBootRefused,
  SecureBootUnobserved,
  AuthenticationRequired,
  ReplyShapeUnrecognized,
