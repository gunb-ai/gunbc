module test.claim.firmware_network_boot_standing_witness

// WITNESS FOR THE CUT-6 READINESS SEAM (S0). Every test builds SYNTHETIC observations inside a
// test fn; no data row here is a fleet fact. The property under test is the seam's honesty: a
// Ready must be traceable to evidence, an unanswered axis must outrank a plausible Ready, a
// refusal keeps its cause, and every route the seam emits is a route the catalog owns.

import std.types { Bool, EpochMs, List, NonEmptyStr }
import std.algebra { string_contains }
// THE FRONTIER IS WITNESSED, NOT ASSERTED IN PROSE: the witness reads the bound triggers and
// states what their status is TODAY, so the day the probe lands, this is the thing that changes.
import std.dissolution { DissolutionPending, DissolutionFired }
import std.decl_ref { DeclarationRef, declaration_ref_eq, decl_ref }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import extdeps.external_authority { CitedFigureStanding, CitedToAuthority, ExternalAuthority, ObservedByReceipt, TranscribedUncited }
import extdeps.uri { uri_https }
import extdeps.provisioning.network_boot { LegacyBiosPxe, UefiPxe, UefiHttpBoot }
// THE SAME ENUM THE SEAM CLASSIFIES AGAINST, imported by the witness so a fixture states a KIND
// rather than a label the seam would have to guess about.
import extdeps.bmc.types {
