  NicsUnobserved,
  PreparationBlockingOn,
  EnableNetworkStack,
  PointUefiBootNext,
  SelectNicBoot,
  SetSecureBootAttribute,
  mechanism_name,
  ReadyEvidence,
  RedfishOneShotOverride,
  BootOrderEntry,
  BootOption,
  boot_order_entry,
  boot_option,
  join_head_to_options,
  HeadJoinStanding,
  HeadJoinsEnabledOption,
  HeadJoinsDisabledOption,
  HeadOptionNotEnumerated,
  HeadOrderEmpty,
  HeadEnumerationEmpty,
  available_network_options,
  option_with_reference,
  FirmwareMechanismName,
  MechanismNameGrounding,
  MechanismNameBound,
  MechanismNameUnbound,
  GroundedByBootOptionEnumeration,
  GroundedByBiosAttributeRead,
  firmware_attribute_name_from_read,
  RouteBindingStanding,
