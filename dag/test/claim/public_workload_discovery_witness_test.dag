module test.claim.public_workload_discovery_witness_test

import std.types { Bool, CommitSha, Int, List, NonEmptyStr, String }
import std.bytes { utf8_encode_bytes, bytes_octets }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import extdeps.time.rfc3339 { Rfc3339Timestamp }
import extdeps.github.actions { HostedRunner, SelfHosted, RunsOnLabel, RunsOnExpression, UbuntuLatest }
import gunbc.public_workload_evidence { WorkflowSourceKey, WorkflowSourceRecord }
import gunbc.public_workload_discovery {
  arm_runner_labels, arm_label_query,
  QueryWindow, QueryWindowSelected, QueryWindowRefused, select_query_window,
  InstanceCatalogLabel, InstanceSelfHosted, InstanceUnevaluatedExpression, instance_label,
  tally_source,
}
import test.claim.gha_workflow_reverse_read_witness_test { biome_main_workflow_bytes }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// HERMETIC CONTROLS FOR THE DISCOVERY PROJECTION: the catalog-derived query roster, its window, which
// runners have a label to look up, and the per-revision tally over the pinned real Biome workflow.
// The catalogs consulted are the committed vendor snapshots, so the tally is what a run at the fixed
// observation time below would report. What these do NOT establish is the live scan or the store;
// those were exercised by execution against GitHub and a local git remote.

data observed_at: Rfc3339Timestamp = "2026-09-13T00:00:00Z" as Rfc3339Timestamp

test fn the_query_roster_is_distinct_catalog_labels() -> Bool {
  let labels = arm_runner_labels()
  count(labels) > 0
    && all(labels, l => count(filter(labels, m => m == l)) == 1)
    && arm_label_query(label: "depot-ubuntu-24.04-arm") == "depot-ubuntu-24.04-arm path:.github/workflows"
}

test fn a_window_outside_the_roster_refuses_and_one_inside_selects_exactly_its_slice() -> Bool {
  let roster = ["a", "b", "c"]
  let outside = match select_query_window(roster: roster, window: QueryWindow { offset: 3, count: 1 }) {
    QueryWindowRefused { cause: _ } => true
    QueryWindowSelected { labels: _, roster_size: _ } => false
  }
  let inside = match select_query_window(roster: roster, window: QueryWindow { offset: 1, count: 5 }) {
    QueryWindowSelected { labels, roster_size } => join(labels, ",") == "b,c" && roster_size == 3
    QueryWindowRefused { cause: _ } => false
  }
  outside && inside
}

test fn self_hosted_and_unevaluated_runners_are_not_looked_up() -> Bool {
  let hosted = match instance_label(runner: HostedRunner { label: UbuntuLatest }) {
    InstanceCatalogLabel { label } => label == "ubuntu-latest"
    InstanceSelfHosted { labels: _ } => false
    InstanceUnevaluatedExpression { expression: _ } => false
  }
  let own = match instance_label(runner: SelfHosted { labels: ["self-hosted", "ARM64"] }) {
    InstanceSelfHosted { labels: _ } => true
    InstanceCatalogLabel { label: _ } => false
    InstanceUnevaluatedExpression { expression: _ } => false
  }
  let expr = match instance_label(runner: RunsOnExpression { expression: "$\{\{ matrix.os \}\}" }) {
    InstanceUnevaluatedExpression { expression: _ } => true
    InstanceCatalogLabel { label: _ } => false
    InstanceSelfHosted { labels: _ } => false
  }
  hosted && own && expr
}

fn biome() -> WorkflowSourceRecord {
  let o = bytes_octets(b: utf8_encode_bytes(s: biome_main_workflow_bytes))
  WorkflowSourceRecord {
    key: WorkflowSourceKey { repository_id: 270299983, ref: "47d7383d049b36ff8eaba50912176928143dd9e9" as CommitSha, workflow_path: ".github/workflows/main.yml", blob_sha: "e06a945171c115274945744f65948a07f52e16f2" },
    repository_full_name_at_observation: "biomejs/biome",
    repository_is_fork: false,
    declared_size: count(o),
    octets: o,
  }
}

// Biome's main workflow at the census commit: format, lint and deny run on Depot ARM labels, and the
// test and coverage matrices each carry one Depot ARM instance beside Windows and macOS ones.
test fn biome_main_tallies_its_depot_arm_instances_and_not_its_windows_or_macos_ones() -> Bool {
  let t = tally_source(source: biome(), observed_at: observed_at)
  let arm_jobs = map(t.instances.arm, a => a.job_key)
  count(t.instances.arm) == 5
    && all(["format", "lint", "deny", "test", "coverage"], k => any(arm_jobs, j => j == k))
    && all(t.instances.arm, a => a.provider == "extdeps.ci_runner.depot")
    && t.instances.not_arm + t.instances.undetermined == 3
    && t.document_refused == false
    && t.not_utf8 == false
}
