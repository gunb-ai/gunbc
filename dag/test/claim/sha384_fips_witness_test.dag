module test.claim.sha384_fips_witness_test

import std.logic { Bool }
import std.types { String, List }
import std.integer { UInt8, uint8_octets_of_ints, QualifiedOctetsReady, QualifiedOctetsRefused }
import std.bytes { bytes_octets, utf8_encode_bytes }
import extdeps.crypto.sha2 { sha384 }
import extdeps.numeric.base16 { base16_encode_lower }

fn sha384_ascii(s: String) -> List<UInt8> {
  bytes_octets(b: utf8_encode_bytes(s: s))
}

// THE DIGEST REACHES THE ENCODER THROUGH THE ONE ADMISSION FOLD, as every consumer's list does:
// std.integer QualifiedOctets is sealed and sha384 has no production hex consumer that would earn a
// place on qualified_octets' named mint roster, so the witness admits the 48 octets it inspects
// rather than growing that roster for a test. "REFUSED" is outside the 0-9a-f alphabet, so a
// refused mint can never equal a published vector.
fn sha384_hex_of(digest: List<UInt8>) -> String {
  match uint8_octets_of_ints(values: digest) {
    QualifiedOctetsReady { value: q } => base16_encode_lower(octets: q)
    QualifiedOctetsRefused { observed: _ } => "REFUSED"
  }
}

// THREE PUBLISHED VECTORS, THREE CLAIMS, EACH PAIRED WITH ITS OWN DISCRIMINATING RED.
//
// WHAT WAS TRIED AND REJECTED (review 69978, then the design ruling that followed it). First the
// two single-block vectors were DEMOTED off the floor because each measured at or beside the 500ms
// per-subject line -- inside the band v2.workflow.floor_enrolment_margin refuses, where a typed
// admission goes stale on a faster run and BLOCKS ("at or under the line it is stale and blocks").
// That silently dropped the empty message, which is the only executing evidence of the padding-only
// path of FIPS 180-2 section 5.1.2. Then the three vectors were FOLDED into one claim so their
// summed bill cleared the line. That is worse, and the counterfactual is what condemns it: removing
// the abc vector changes no semantic fact about the other two yet can make the admission stale, and
// adding an unrelated fourth vector strengthens no existing fact yet makes the admission more
// stable. A cost ground that moves with its neighbours is not a ground for the subject it claims to
// admit -- it is the enrolment gate dodged by aggregation, and DESIGN section 3 names the shape
// directly: a conjunction of independent cases forced through one budget when splitting them loses
// no coverage.
//
// WHAT IS HERE INSTEAD. Each published vector is its own claim, paired with the mutation that
// proves that vector's equality is discriminating. The second evaluation in each pair is not
// ballast bought to clear a budget: it is the RED for the same boundary, which DESIGN section 4b
// requires of every rung claim anyway ("a discriminating RED refused on the real acceptance path
// plus an accepted positive control"). So each claim's cost is caused by its own subject, and no
// claim's admission depends on a vector belonging to a different path.
// -- SHA-384: FIPS 180-2 Appendix D, the published examples ------------------------------------

// The empty message is ALL padding: it is the only inhabitant of the padding-only path of section
// 5.1.2, and one octet of message is the smallest thing that leaves that path.
test fn sha384_of_the_empty_message_is_the_published_value_and_one_octet_discriminates() -> Bool {
  let empty = sha384(message: [])
  let one = sha384(message: sha384_ascii(s: "a"))
  sha384_hex_of(digest: empty) == "38b060a751ac96384cd9327eb1b1e36a21fdb71114be07434c0cc7bf63f6e1da274edebfe76f65fbd51ad2f14898b95b"
    && count(empty) == 48 && count(one) == 48 && empty != one
}

// One changed octet changes the digest, and the digest is 48 octets: the single-block red.
test fn sha384_of_abc_is_the_published_value_and_one_octet_discriminates() -> Bool {
  let a = sha384(message: sha384_ascii(s: "abc"))
  let b = sha384(message: sha384_ascii(s: "abd"))
  sha384_hex_of(digest: a) == "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7"
    && count(a) == 48 && count(b) == 48 && a != b
}

// 896 bits: the padding no longer fits the first 1024-bit block, so this is the two-block path, and
// the mutated octet sits in the LAST message block so the red discriminates that path specifically.
test fn sha384_of_the_896_bit_message_is_the_published_two_block_value_and_one_octet_discriminates() -> Bool {
  let msg = "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu"
  let mutated = "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstv"
  let a = sha384(message: sha384_ascii(s: msg))
  let b = sha384(message: sha384_ascii(s: mutated))
  sha384_hex_of(digest: a) == "09330c33f71147e83d192fc782cd1b4753111b173b3b05d22fa08086e3b0f712fcc7c71a557e2db966c3e9fa91746039"
    && count(a) == 48 && count(b) == 48 && a != b
}
