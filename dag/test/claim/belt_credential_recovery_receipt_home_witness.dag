module test.claim.belt_credential_recovery_receipt_home_witness

import std.types { Bool, String, NonEmptyStr }
import gunbc.roadmap.roadmap_belt_tick_cli { belt_credential_recovery_receipt_path }
import gunbc.roadmap.roadmap_dashboard_instance { HostDashboardInstance, srv1_live_dashboard_instance }
import gunbc.host.host_layout { instance_receipts_dir }

// ============================================================================
// node credential-recovery-receipt-under-declared-instance-dir
// Claim witness: the belt credential-recovery receipt lives in the instance's
// declared, install-owned receipts directory (the same directory the tick and
// obligation receipts use, created by apply_legs step instance-receipts-dir),
// NOT at the instance root top level where briansrls cannot create files.
//
// RED: at an exact main sha before the fix, `belt_credential_recovery_receipt_path`
// does not exist in `gunbc.roadmap.roadmap_belt_tick_cli` — the resolver refuses
// the import, claim_batch prints FAIL and exits 1.
// GREEN: at the fix's head, the function exists and all five claims pass (rc 0).
//
// Named negatives in this run:
//   1. An undeclared top-level path (the old receipt location) is NOT under the
//      declared receipts directory — proving the old path targeted an undeclared
//      root briansrls cannot write.
//   2. A path with traversal does not pass the receipts-dir prefix check —
//      proving a crafted path cannot escape the declared directory.
// ============================================================================

test fn the_receipt_sits_in_the_instance_receipts_directory() -> Bool {
  // The claim the fix makes true: the receipt path resolves under the declared,
  // briansrls-owned instance receipts directory.
  let instance = srv1_live_dashboard_instance()
  let receipts = instance_receipts_dir(instance_root: instance.instance_root as String) as String
  let path = belt_credential_recovery_receipt_path(instance_root: instance.instance_root as NonEmptyStr) as String
  starts_with(s: path, prefix: concat(receipts, "/"))
}

test fn the_receipt_path_is_the_expected_bytes() -> Bool {
  // The receipt is derived from instance_receipts_dir with the pinned entry name.
  // A rename must be a deliberate act, visible as a red claim, never a silent move.
  let instance = srv1_live_dashboard_instance()
  let path = belt_credential_recovery_receipt_path(instance_root: instance.instance_root as NonEmptyStr) as String
  path == "/opt/gunbc/receipts/credential-acquisition-recovery.json"
}

test fn the_old_top_level_receipt_path_is_not_under_the_receipts_dir() -> Bool {
  // NAMED NEGATIVE 1: an undeclared path at the instance root top level (the old
  // location, `/opt/gunbc/credential-acquisition-recovery.json`) is NOT under the
  // receipts directory. This is the shape the defect was: the receipt targeted a
  // root-owned directory where briansrls cannot create files. If someone relocates
  // the receipt back to the top level, this claim catches the regression.
  let instance = srv1_live_dashboard_instance()
  let top_level = "/opt/gunbc/credential-acquisition-recovery.json"
  let receipts = instance_receipts_dir(instance_root: instance.instance_root as String) as String
  !starts_with(s: top_level, prefix: concat(receipts, "/"))
}

test fn the_receipt_is_not_homed_in_the_credential_acquisition_slots() -> Bool {
  // The receipt does NOT belong inside the credential-acquisition-slots directory
  // (the store): the store is 0700 owner-only for credential material; the recovery
  // receipt is diagnostic output that must not be mistaken for slot data.
  let instance = srv1_live_dashboard_instance()
  let path = belt_credential_recovery_receipt_path(instance_root: instance.instance_root as NonEmptyStr) as String
  let slots_root = concat(instance.instance_root as String, "/credential-acquisition-slots")
  !starts_with(s: path, prefix: concat(slots_root, "/"))
}

test fn the_receipt_path_contains_no_traversal() -> Bool {
  // NAMED NEGATIVE 2: a path with `..` traversal does not pass the receipts-dir
  // prefix check, proving a crafted path cannot escape the declared directory.
  // belt_credential_recovery_receipt_path builds the path through instance_receipts_dir
  // which only concatenates instance_root + "/receipts" — it has no argument that accepts
  // a sub-path — so traversal cannot be injected. This claim proves the property:
  // the function's output contains no traversal sequence.
  let instance = srv1_live_dashboard_instance()
  let path = belt_credential_recovery_receipt_path(instance_root: instance.instance_root as NonEmptyStr) as String
  !string_contains(s: path, pattern: "..")
}
