module test.claim.phantom_marker_same_named_record_witness

import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// Executing witness for v1.compiler.emit_rust phantom_marker_decision. A
// module that declares a record and a coproduct arm of the same name (gunbc.roadmap.roadmap_model
// AcceptanceNodeReopensActiveFrontier) had the record emitted twice: once as its declaration and once
// as the unit variant's phantom ZST marker, whose derive list carries Eq (rustc E0428 and E0119; class
// 1 of stern-bat-401's emitter-debt list). The RED is the marker's derive line on the record's name;
// the control, asserted in the same row, is DispositionPending: a unit variant with no same-named
// type, which keeps its marker.

test fn same_named_record_suppresses_the_variant_marker() -> Bool {
  compile_dag_rust_emit_check(
    "module phantom_marker_witness.shadowed\n\ntype ReopensFrontier {}\ntype RemainsSuperseded {}\n\ntype Disposition = ReopensFrontier | RemainsSuperseded | DispositionPending\n\nfn reopens(d: Disposition) -> Bool {\n  match d {\n    ReopensFrontier {} => true\n    RemainsSuperseded {} => false\n    DispositionPending => false\n  }\n}\n",
    "src/phantom_marker_witness_shadowed.rs",
    ["pub struct ReopensFrontier;", "PartialEq, Eq, serde::Serialize, serde::Deserialize)]\npub struct DispositionPending;"],
    ["PartialEq, Eq, serde::Serialize, serde::Deserialize)]\npub struct ReopensFrontier;"]
  )
}

// THE SPELLING-VERSUS-IDENTITY RED. The arm GlobalKeyScope names the record std.key_relation declares
// and this module imports by name; no item of this module carries that name, so the module-local
// name comparison phantom_marker_decision replaced emitted `pub struct GlobalKeyScope;` beside the
// import of the record it denotes. The arm resolves to that declaration, so it owes no marker; the
// unit variant ScopePending, which resolves to none, keeps its own.
test fn imported_record_arm_owes_no_marker() -> Bool {
  compile_dag_rust_emit_check(
    "module phantom_marker_witness.imported\n\nimport std.key_relation { GlobalKeyScope }\n\ntype Scope = GlobalKeyScope | ScopePending\n\nfn is_global(s: Scope) -> Bool {\n  match s {\n    GlobalKeyScope {} => true\n    ScopePending => false\n  }\n}\n",
    "src/phantom_marker_witness_imported.rs",
    ["PartialEq, Eq, serde::Serialize, serde::Deserialize)]\npub struct ScopePending;"],
    ["pub struct GlobalKeyScope;", "compile_error!"]
  )
}

// THE BOUND-BUT-UNIDENTIFIED RED. The arm Pending shares its name with a data item of its own module.
// The scope binds the name (bare_occurrence_binding finds the file's declaration), but the binding is
// not a type declaration, so the type-declaration index cannot identify it and the occurrence is
// Undecided. Read as unbound, the arm owed `pub struct Pending;` beside the item the scope binds;
// the decision refuses, located, instead. The unit variant Done, which binds nothing, keeps its marker.
test fn arm_bound_to_an_unindexed_declaration_refuses() -> Bool {
  compile_dag_rust_emit_check(
    "module phantom_marker_witness.unindexed\n\ndata Pending: Int = 1\n\ntype Phase = Pending | Done\n\nfn is_done(p: Phase) -> Bool {\n  match p {\n    Pending => false\n    Done => true\n  }\n}\n",
    "src/phantom_marker_witness_unindexed.rs",
    ["compile_error!", "binds a declaration the type-declaration index does not identify", "PartialEq, Eq, serde::Serialize, serde::Deserialize)]\npub struct Done;"],
    ["pub struct Pending;"]
  )
}
