module test.claim.resource_namespace_upsert


data live_tree_disposition: LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data srv3_nbd_proxy_port: Int = 10809

data remaster_work_scope: gunbc.file_access.FileTreeScope = gunbc.file_access.FileTreeScope {
  root_path: "/tmp/gunbc-remaster-work" as std.types.NonEmptyStr,
}

data nbd_proxy_scope: gunbc.session_lease.ProcessPortScope = gunbc.session_lease.ProcessPortScope {
  listen_port: srv3_nbd_proxy_port,
  expected_owner_label: "gunbc-nbd-proxy" as std.types.NonEmptyStr,
  expected_process_fingerprint: "gunbc-nbd-proxy" as std.types.NonEmptyStr,
}

test fn foreign_process_on_10809_is_conflict_not_kill() -> Bool {
  match gunbc.session_lease.classify_process_port_upsert(
    scope: nbd_proxy_scope,
    obs: gunbc.session_lease.PortObserved {
      observed_port: srv3_nbd_proxy_port,
      pid: 424242,
      cmdline: "foreign-nbdkit" as std.types.NonEmptyStr,
      process_fingerprint: "foreign-nbdkit" as std.types.NonEmptyStr,
    },
  ) {
    std.upsert_decision.UpsertClassification { verdict: std.upsert_decision.Conflict, decision: Refuse { reason: _ } } => true
    std.upsert_decision.UpsertClassification { verdict: Drifted, decision: std.upsert_decision.Apply { plan: _ } } => false
    _ => false
  }
}

test fn stale_matching_process_on_10809_drains_then_starts() -> Bool {
  match gunbc.session_lease.classify_process_port_upsert(
    scope: nbd_proxy_scope,
    obs: gunbc.session_lease.PortObservedStaleExpected {
      observed_port: srv3_nbd_proxy_port,
      pid: 99999,
      cmdline: "gunbc-nbd-proxy" as std.types.NonEmptyStr,
      process_fingerprint: "gunbc-nbd-proxy" as std.types.NonEmptyStr,
      stale_reason: "prior-generation lease holder" as std.types.NonEmptyStr,
    },
  ) {
    std.upsert_decision.UpsertClassification {
      verdict: Drifted,
      decision: std.upsert_decision.Apply { plan: gunbc.session_lease.DrainMatchingStaleThenStart },
    } => true
    std.upsert_decision.UpsertClassification { verdict: Converged, decision: std.upsert_decision.Noop } => false
    _ => false
  }
}

test fn expected_process_on_10809_is_converged_noop() -> Bool {
  match gunbc.session_lease.classify_process_port_upsert(
    scope: nbd_proxy_scope,
    obs: gunbc.session_lease.PortObserved {
      observed_port: srv3_nbd_proxy_port,
      pid: 12345,
      cmdline: "gunbc-nbd-proxy" as std.types.NonEmptyStr,
      process_fingerprint: "gunbc-nbd-proxy" as std.types.NonEmptyStr,
    },
  ) {
    std.upsert_decision.UpsertClassification { verdict: Converged, decision: std.upsert_decision.Noop } => true
    _ => false
  }
}

test fn outside_namespace_chmod_is_refused() -> Bool {
  let outside = "/etc/passwd" as std.types.NonEmptyStr
  !gunbc.file_access.path_within_file_tree_scope(scope: remaster_work_scope, path: outside)
    && match gunbc.file_access.classify_file_access_upsert(scope: remaster_work_scope, obs: gunbc.file_access.PathOutsideNamespace) {
      std.upsert_decision.UpsertClassification { verdict: _, decision: Refuse { reason: _ } } => true
      _ => false
    }
}

test fn substring_trap_path_fails_prefix_containment() -> Bool {
  let trap = "/attacker/tmp/gunbc-remaster-work/x" as std.types.NonEmptyStr
  !gunbc.file_access.path_within_file_tree_scope(scope: remaster_work_scope, path: trap)
}

test fn dotdot_path_rejected_by_containment() -> Bool {
  let escape = "/tmp/gunbc-remaster-work/../etc/passwd" as std.types.NonEmptyStr
  !gunbc.file_access.path_within_file_tree_scope(scope: remaster_work_scope, path: escape)
}

test fn readonly_within_namespace_plans_chmod() -> Bool {
  match gunbc.file_access.classify_file_access_upsert(scope: remaster_work_scope, obs: gunbc.file_access.ReadOnlyWithinNamespace) {
    std.upsert_decision.UpsertClassification {
      verdict: Drifted,
      decision: std.upsert_decision.Apply { plan: gunbc.file_access.ChmodOwnerWriteWithinTempTree },
    } => true
    _ => false
  }
}

test fn writable_within_namespace_is_converged_noop() -> Bool {
  match gunbc.file_access.classify_file_access_upsert(scope: remaster_work_scope, obs: gunbc.file_access.WritableWithinNamespace) {
    std.upsert_decision.UpsertClassification { verdict: Converged, decision: std.upsert_decision.Noop } => true
    _ => false
  }
}

test fn drifted_seeded_iso_is_drifted_not_converged() -> Bool {
  match gunbc.install_media.classify_seeded_install_media(obs: gunbc.install_media.MediaDrifted) {
    Drifted => match gunbc.install_media.classify_seeded_install_media(obs: gunbc.install_media.MediaConverged) {
      Converged => true
      Drifted => false
      _ => false
    }
    Converged => false
    _ => false
  }
}

test fn converged_seeded_iso_is_not_drifted() -> Bool {
  match gunbc.install_media.classify_seeded_install_media(obs: gunbc.install_media.MediaConverged) {
    Converged => match gunbc.install_media.classify_seeded_install_media_upsert(obs: gunbc.install_media.MediaConverged) {
      std.upsert_decision.UpsertClassification { verdict: _, decision: std.upsert_decision.Noop } => true
      _ => false
    }
    _ => false
  }
}

test fn absent_seeded_iso_plans_replace() -> Bool {
  match gunbc.install_media.classify_seeded_install_media_upsert(obs: gunbc.install_media.MediaAbsent) {
    std.upsert_decision.UpsertClassification {
      verdict: Absent,
      decision: std.upsert_decision.Apply { plan: gunbc.install_media.ReplaceAtomically },
    } => true
    _ => false
  }
}

test fn drifted_seeded_iso_plans_remaster_not_drain() -> Bool {
  match gunbc.install_media.classify_seeded_install_media_upsert(obs: gunbc.install_media.MediaDrifted) {
    std.upsert_decision.UpsertClassification {
      verdict: Drifted,
      decision: std.upsert_decision.Apply { plan: gunbc.install_media.Remaster },
    } => true
    _ => false
  }
}
