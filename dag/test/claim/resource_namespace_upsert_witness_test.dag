module test.claim.resource_namespace_upsert

import std.types { Bool, NonEmptyStr }
import std.resource_namespace {
  FileNamespace,
  ProcessNamespace,
  ProcessPortObservation,
  PortOwnedForeign,
  PortOwnedExpected,
  FileAccessObservation,
  PathOutsideNamespace,
  ReadOnlyWithinNamespace,
  WritableWithinNamespace,
  SeededArtifactProbeObservation,
  ArtifactStale,
  ArtifactConverged,
  ArtifactAbsent,
  ResourceNamespaceClassification,
  Conflict,
  Converged,
  Stale,
  Absent,
  Refuse,
  UpsertAccess,
  Noop,
  Create,
  DrainThenStart,
  classify_process_port_upsert,
  classify_file_access_upsert,
  classify_seeded_artifact_upsert,
  classify_seeded_artifact_presence,
  path_within_file_namespace,
}

data srv3_nbd_proxy_port: Int = 10809

data remaster_work_namespace: FileNamespace = FileNamespace {
  root_path: "/tmp/gunbc-remaster-work" as NonEmptyStr,
}

test fn foreign_process_on_10809_is_conflict_not_kill() -> Bool {
  let ns = ProcessNamespace {
    listen_port: srv3_nbd_proxy_port,
    expected_owner_label: "gunbc-nbd-proxy" as NonEmptyStr,
  }
  let obs = PortOwnedForeign {
    pid: 424242,
    cmdline: "foreign-nbdkit" as NonEmptyStr,
  }
  match classify_process_port_upsert(ns: ns, obs: obs) {
    ResourceNamespaceClassification { verdict: Conflict, plan: Refuse } => true
    ResourceNamespaceClassification { verdict: _, plan: DrainThenStart } => false
    _ => false
  }
}

test fn expected_process_on_10809_is_converged_noop() -> Bool {
  let ns = ProcessNamespace {
    listen_port: srv3_nbd_proxy_port,
    expected_owner_label: "gunbc-nbd-proxy" as NonEmptyStr,
  }
  let obs = PortOwnedExpected { pid: 12345 }
  match classify_process_port_upsert(ns: ns, obs: obs) {
    ResourceNamespaceClassification { verdict: Converged, plan: Noop } => true
    _ => false
  }
}

test fn outside_namespace_chmod_is_refused() -> Bool {
  let ns = remaster_work_namespace
  let outside = "/etc/passwd" as NonEmptyStr
  !path_within_file_namespace(ns: ns, path: outside)
    && match classify_file_access_upsert(ns: ns, obs: PathOutsideNamespace) {
      ResourceNamespaceClassification { verdict: _, plan: Refuse } => true
      _ => false
    }
}

test fn substring_trap_path_fails_prefix_containment() -> Bool {
  let ns = remaster_work_namespace
  let trap = "/attacker/tmp/gunbc-remaster-work/x" as NonEmptyStr
  !path_within_file_namespace(ns: ns, path: trap)
}

test fn dotdot_path_rejected_by_containment() -> Bool {
  let ns = remaster_work_namespace
  let escape = "/tmp/gunbc-remaster-work/../etc/passwd" as NonEmptyStr
  !path_within_file_namespace(ns: ns, path: escape)
}

test fn readonly_within_namespace_plans_upsert_access() -> Bool {
  let ns = remaster_work_namespace
  match classify_file_access_upsert(ns: ns, obs: ReadOnlyWithinNamespace) {
    ResourceNamespaceClassification { verdict: Stale, plan: UpsertAccess } => true
    _ => false
  }
}

test fn writable_within_namespace_is_converged_noop() -> Bool {
  let ns = remaster_work_namespace
  match classify_file_access_upsert(ns: ns, obs: WritableWithinNamespace) {
    ResourceNamespaceClassification { verdict: Converged, plan: Noop } => true
    _ => false
  }
}

test fn stale_seeded_iso_is_stale_not_already_present() -> Bool {
  match classify_seeded_artifact_presence(obs: ArtifactStale) {
    Stale => match classify_seeded_artifact_presence(obs: ArtifactConverged) {
      Converged => true
      Stale => false
      _ => false
    }
    Converged => false
    _ => false
  }
}

test fn converged_seeded_iso_is_not_stale() -> Bool {
  match classify_seeded_artifact_presence(obs: ArtifactConverged) {
    Converged => match classify_seeded_artifact_upsert(obs: ArtifactConverged) {
      ResourceNamespaceClassification { verdict: _, plan: Noop } => true
      _ => false
    }
    _ => false
  }
}

test fn absent_seeded_iso_plans_create() -> Bool {
  match classify_seeded_artifact_upsert(obs: ArtifactAbsent) {
    ResourceNamespaceClassification { verdict: Absent, plan: Create } => true
    _ => false
  }
}
