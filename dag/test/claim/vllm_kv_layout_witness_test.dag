// The group A head's own two startup lines, 2026-09-05T20:43:56Z. A refused admission is a red
// fixture, not a second guess: the nested token_count(0) substitute and the unguarded self-call
// both violated DESIGN section 5 (refuse, never widen) and section 4 (bounded, forward).
fn w_pool_admission() -> VllmKvPoolAdmission {
  vllm_observed_kv_pool_from_reading(
    tokens: token_count(count: 11767856),
    reading: vllm_startup_reading(
      line: GpuKvCacheSize,
      captured_text: "[kv_cache_utils.py:1733] GPU KV cache size: 11,767,856 tokens" as NonEmptyStr,
      observed_at_revision: vllm_source_revision_read,
    ),
  )
}

fn w_admitted_pool() -> VllmObservedKvPool? {
  match w_pool_admission() {
    KvPoolAdmitted { pool: p } => Present { value: p }
    KvPoolRefused { cause: _ } => none
  }
}

fn w_concurrency_reading() -> VllmStartupReading {
  vllm_startup_reading(
    line: MaximumConcurrency,
    captured_text: "Maximum concurrency for 1,048,576 tokens per request: 11.22x" as NonEmptyStr,
    observed_at_revision: vllm_source_revision_read,
  )
}

fn w_reported(pool: VllmObservedKvPool) -> VllmReportedCapacity? {
  match vllm_reported_capacity(pool: pool, max_concurrency: concurrent_request_hundredths(count: 1122), reading: w_concurrency_reading()) {
    ReportedCapacityAdmitted { capacity: c } => Present { value: c }
    ReportedCapacityRefused { cause: _ } => none
  }
}

// The allocator inventory read off the same engine's cache_config_info.
fn w_layout(groups: List<KvGroupLayout>) -> ResolvedKvLayout {
  resolved_kv_layout(
    allocator_blocks: allocator_block_count(count: 54475),
    scheduler_block_size: token_count(count: 16),
    hash_block_size: token_count(count: 16),
    max_model_len: token_count(count: 1048576),
    max_num_batched_tokens: token_count(count: 8192),
    groups: groups,
    established_at_revision: vllm_source_revision_read,
  )
}

// THE ENGINE'S OWN GROUP-AWARE COST, READ BACK OUT OF ITS TWO PRINTED LINES: 54,475 blocks x
// 1,048,576 context / 11,767,856 tokens = 4,854 blocks for one full-context request. That figure is
// the engine's own group-aware arithmetic recovered, not re-derived from fields whose reductions
// differ, and it is the only per-request cost today's evidence yields.
test fn the_engines_per_request_block_cost_is_recoverable_from_its_printed_lines() -> Bool {
  match w_admitted_pool() {
    Absent => false
    Present { value: p } =>
      match w_reported(pool: p) {
        Absent => false
        Present { value: reported } =>
          match recovered_blocks_per_max_length_request(layout: w_layout(groups: []), reported: reported) {
            BlocksPerRequestRecovered { blocks: b } => allocator_block_count_value(c: b) == 4854
            BlocksPerRequestUnrecoverable { cause: _ } => false
          }
      }
  }
}

// THE LIMIT OF TODAY'S EVIDENCE, ASSERTED RATHER THAN ASSUMED. The printed-line check tests the pool
// line against the concurrency line, and the inventory CANCELS OUT of it -- so swapping in a
// different engine's inventory leaves it green. This row exists to keep that stated: it is the
// reason the layout receipt is still required, and the reason no wall here may be described as
// checking the inventory.
//
// The recovered per-request cost DOES move with the inventory (4,854 against group A's 54,475
// blocks, 4,930 against group B's 55,328), which is what makes the cost a function of the launch
// while the agreement check is not.
test fn the_printed_line_check_does_not_see_the_inventory_which_is_why_a_receipt_is_still_needed() -> Bool {
  match w_admitted_pool() {
    Absent => false
    Present { value: p } =>
      match w_reported(pool: p) {
        Absent => false
        Present { value: reported } => {
          let other = resolved_kv_layout(
            allocator_blocks: allocator_block_count(count: 55328),
            scheduler_block_size: token_count(count: 16),
            hash_block_size: token_count(count: 16),
            max_model_len: token_count(count: 1048576),
            max_num_batched_tokens: token_count(count: 8192),
            groups: [],
            established_at_revision: vllm_source_revision_read,
          )
          (match printed_lines_agree(layout: w_layout(groups: []), reported: reported) { PrintedLinesAgree => true  _ => false })
            && (match printed_lines_agree(layout: other, reported: reported) { PrintedLinesAgree => true  _ => false })
            && (match recovered_blocks_per_max_length_request(layout: other, reported: reported) {
                  BlocksPerRequestRecovered { blocks: b } => allocator_block_count_value(c: b) == 4930
                  BlocksPerRequestUnrecoverable { cause: _ } => false
                })
        }
      }
  }
}

// AND THE CHECK IS NOT VACUOUS: a mistranscribed concurrency line breaks it. Without this row the
// one above could be satisfied by a function that returns Agree unconditionally.
test fn a_mistranscribed_concurrency_line_breaks_the_printed_line_check() -> Bool {
  match w_admitted_pool() {
    Absent => false
    Present { value: p } =>
      match vllm_reported_capacity(pool: p, max_concurrency: concurrent_request_hundredths(count: 440), reading: w_concurrency_reading()) {
        ReportedCapacityRefused { cause: _ } => false
        ReportedCapacityAdmitted { capacity: wrong } =>
          match printed_lines_agree(layout: w_layout(groups: []), reported: wrong) {
            PrintedLinesDisagree { implied: i, reported: r } => concurrent_request_hundredths_count(c: i) == 1122 && concurrent_request_hundredths_count(c: r) == 440
            _ => false
          }
      }
  }
}

// THE ENGINE ROUNDS THE PRINTED Nx; INTEGER TRUNCATION OF pool*100/context IS NOT THE PRINT.
// 4,429 tokens / 1,000 context truncates to 442 hundredths; the engine would print 4.43x.
test fn a_printed_concurrency_rounded_up_one_hundredth_still_agrees() -> Bool {
  match vllm_observed_kv_pool_from_reading(
    tokens: token_count(count: 4429),
    reading: vllm_startup_reading(
      line: GpuKvCacheSize,
      captured_text: "[kv_cache_utils.py:1733] GPU KV cache size: 4,429 tokens" as NonEmptyStr,
      observed_at_revision: vllm_source_revision_read,
    ),
  ) {
    KvPoolRefused { cause: _ } => false
    KvPoolAdmitted { pool: p } =>
      match vllm_reported_capacity(
        pool: p,
        max_concurrency: concurrent_request_hundredths(count: 443),
        reading: vllm_startup_reading(
          line: MaximumConcurrency,
          captured_text: "Maximum concurrency for 1,000 tokens per request: 4.43x" as NonEmptyStr,
          observed_at_revision: vllm_source_revision_read,
        ),
      ) {
        ReportedCapacityRefused { cause: _ } => false
        ReportedCapacityAdmitted { capacity: reported } => {
          let layout = resolved_kv_layout(
            allocator_blocks: allocator_block_count(count: 54475),
            scheduler_block_size: token_count(count: 16),
            hash_block_size: token_count(count: 16),
            max_model_len: token_count(count: 1000),
            max_num_batched_tokens: token_count(count: 8192),
            groups: [],
            established_at_revision: vllm_source_revision_read,
          )
          match printed_lines_agree(layout: layout, reported: reported) {
            PrintedLinesAgree => true
            _ => false
          }
        }
      }
  }
}

test fn a_concurrency_figure_bound_to_the_pool_line_is_refused() -> Bool {
  match w_admitted_pool() {
    Absent => false
    Present { value: p } =>
      match vllm_reported_capacity(
        pool: p,
        max_concurrency: concurrent_request_hundredths(count: 1122),
        reading: vllm_startup_reading(
          line: GpuKvCacheSize,
          captured_text: "[kv_cache_utils.py:1733] GPU KV cache size: 11,767,856 tokens" as NonEmptyStr,
          observed_at_revision: vllm_source_revision_read,
        ),
      ) {
        ReportedCapacityRefused { cause: c } => string_contains(s: c as String, pattern: "MaximumConcurrency")
        ReportedCapacityAdmitted { capacity: _ } => false
      }
  }
}

// A CONCURRENCY READING FROM ANOTHER BUILD IS NOT THE POOL LINE'S REVISION. Stamping the pool's
// revision onto the capacity discarded the reading's own observation, so layout_reproduces_reported
// gated on a revision that never described the concurrency line.
test fn a_concurrency_reading_from_another_revision_is_refused() -> Bool {
  match w_admitted_pool() {
    Absent => false
    Present { value: p } =>
      match vllm_reported_capacity(
        pool: p,
        max_concurrency: concurrent_request_hundredths(count: 1122),
        reading: vllm_startup_reading(
          line: MaximumConcurrency,
          captured_text: "Maximum concurrency for 1,048,576 tokens per request: 11.22x" as NonEmptyStr,
          observed_at_revision: vllm_source_revision(
            repository: "github.com/vllm-project/vllm" as NonEmptyStr,
            full_revision: "0000000000000000000000000000000000000000" as NonEmptyStr,
          ),
        ),
      ) {
        ReportedCapacityRefused { cause: c } => string_contains(s: c as String, pattern: "do not describe one engine")
        ReportedCapacityAdmitted { capacity: _ } => false
      }
  }
}

data w_page_bytes: ByteSize = byte_size(count: 65536)

fn w_full(layers: Nat, block: Nat) -> KvGroupLayout {
  KvGroupLayout { kind: FullAttention, layer_count: attention_layer_count(count: layers), block_size: token_count(count: block), page_size_bytes: w_page_bytes }
}

fn w_window(layers: Nat, block: Nat, window: Int) -> KvGroupLayout {
  KvGroupLayout { kind: SlidingWindowAttention { window: token_count(count: window) }, layer_count: attention_layer_count(count: layers), block_size: token_count(count: block), page_size_bytes: w_page_bytes }
}

// THE DISCRIMINATING ROW FOR THE WHOLE MODULE: two layouts with the SAME allocator inventory and the
// SAME global block size admit different costs, because the windows and group sizes differ. Any
// model that reduces capacity to those two fields answers identically for both and is wrong for at
// least one. The windowed group stops growing at 128 tokens while the full-attention group grows
// with the sequence, which is exactly the asymmetry `num_gpu_blocks * block_size` erases.
test fn one_inventory_and_one_block_size_do_not_determine_the_admission_cost() -> Bool {
  let mostly_full = w_layout(groups: [w_full(layers: 40, block: 16), w_window(layers: 21, block: 16, window: 128)])
  let mostly_windowed = w_layout(groups: [w_full(layers: 4, block: 16), w_window(layers: 57, block: 16, window: 128)])
  let budget = token_count(count: 500000)
  match cold_admission_blocks(layout: mostly_full, sequence_budget: budget) {
    AdmissionCostUnestablished { cause: _ } => false
    AdmissionCostBlocks { blocks: a } =>
      match cold_admission_blocks(layout: mostly_windowed, sequence_budget: budget) {
        AdmissionCostUnestablished { cause: _ } => false
        AdmissionCostBlocks { blocks: b } =>
          allocator_block_count_value(c: a) != allocator_block_count_value(c: b)
            && allocator_block_count_value(c: a) == (31250 * 40) + (8 * 21)
            && allocator_block_count_value(c: b) == (31250 * 4) + (8 * 57)
      }
  }
}

// AND WITH NO GROUPS OBSERVED THERE IS NO COST, WHICH IS TODAY'S REAL STATE. Every incarnation this
// repository can currently observe lands here: the engine does not emit layer count or page size, so
// the layout is inventory-only and the admission cost refuses rather than guessing one.
test fn an_unobserved_group_layout_refuses_the_admission_cost() -> Bool {
  (match cold_admission_blocks(layout: w_layout(groups: []), sequence_budget: token_count(count: 500000)) {
     AdmissionCostUnestablished { cause: c } => string_contains(s: c as String, pattern: "unobserved")
     AdmissionCostBlocks { blocks: _ } => false
   })
    && (match cold_admission_blocks(layout: w_layout(groups: [w_full(layers: 61, block: 16)]), sequence_budget: token_count(count: 2000000)) {
          AdmissionCostUnestablished { cause: c } => string_contains(s: c as String, pattern: "context cap")
          AdmissionCostBlocks { blocks: _ } => false
        })
}

// THE TWO FORBIDDEN RECONSTRUCTIONS STAY FORBIDDEN, and this module offers no function that performs
// either. The usage gauge is likewise not occupancy: it counts retained prefix-cache blocks, which
// is why the group B head read a majority-used pool with nothing running. There is no occupancy
// predicate to cite; the conversion's absence is the coverage.
test fn neither_reconstruction_is_authoritative_and_usage_is_not_occupancy() -> Bool {
  !vllm_pool_reconstruction_is_authoritative(r: BlockCountTimesBlockSize)
    && !vllm_pool_reconstruction_is_authoritative(r: UtilizationTimesTotalMemory)
    && (match allocator_usage(layout: w_layout(groups: []), free_blocks: allocator_block_count(count: 545)) {
          UsageRead { usage: u } => allocator_block_count_value(c: u.referenced_or_retained_blocks) == 53930
          FreeCountImpossible { free_blocks: _, allocator_blocks: _ } => false
        })
}

// A FREE COUNT LARGER THAN THE INVENTORY REFUSES. It was clamped to zero-free, which is the most
// alarming answer available and reached by fabrication -- an impossible reading rendered as a
// saturated engine, indistinguishable from a real one. The two numbers came from different launches
// and the only honest output says so.
test fn a_free_count_exceeding_the_inventory_refuses_rather_than_reading_as_saturated() -> Bool {
  match allocator_usage(layout: w_layout(groups: []), free_blocks: allocator_block_count(count: 99999)) {
    FreeCountImpossible { free_blocks: f, allocator_blocks: a } =>
      allocator_block_count_value(c: f) == 99999 && allocator_block_count_value(c: a) == 54475
    UsageRead { usage: _ } => false
  }
}

// A WINDOWED GROUP WITH NO WINDOW IS NOT WRITABLE. The window used to sit beside the kind as an
// optional field, so that state typechecked and the cost function charged it as full attention --
// a malformed layout yielding a plausible number instead of a refusal. The constructor below is the
// only way to build a windowed group, and it demands the window.
test fn a_windowed_group_carries_its_window_by_construction() -> Bool {
  let g = w_window(layers: 1, block: 16, window: 128)
  (match g.kind { SlidingWindowAttention { window: w } => token_count_value(t: w) == 128  _ => false })
    && (match group_blocks_for(group: g, sequence: token_count(count: 1048576)) { Present { value: n } => n == 8  Absent => false })
    && (match group_blocks_for(group: w_full(layers: 1, block: 16), sequence: token_count(count: 1048576)) { Present { value: n } => n == 65536  Absent => false })
}

test fn a_zero_block_size_group_refuses_rather_than_dividing() -> Bool {
  match cold_admission_blocks(layout: w_layout(groups: [w_full(layers: 40, block: 0)]), sequence_budget: token_count(count: 500000)) {
    AdmissionCostUnestablished { cause: c } => string_contains(s: c as String, pattern: "zero block size")
    AdmissionCostBlocks { blocks: _ } => false
  }
}

test fn a_zero_layer_group_refuses_rather_than_looking_free() -> Bool {
  match cold_admission_blocks(layout: w_layout(groups: [w_full(layers: 0, block: 16)]), sequence_budget: token_count(count: 500000)) {
    AdmissionCostUnestablished { cause: c } => string_contains(s: c as String, pattern: "zero layer count")
    AdmissionCostBlocks { blocks: _ } => false
  }
}

// ── THE BYTE-LEVEL TWIN: page_size_bytes RETURNS WITH ITS CONSUMER ──────────────────────────────
//
// cold_admission_bytes is the byte projection the unified-memory admission prices against, and it
// carries the block fold's own walls: a group is its block cost times ITS OWN page size, the
// windowed group caps at its window, the mamba group is one state per sequence regardless of
// length, and the refusal arms are the same arms the block fold refuses -- an unobserved group
// population, an empty budget, a budget past the cap, a zero block size. page_size_bytes was
// removed while nothing read it; it returns here WITH this fold, which is the only shape a
// restored field should return in.
test fn a_groups_byte_cost_is_its_block_cost_times_its_page() -> Bool {
  match cold_admission_bytes(layout: w_layout(groups: [w_full(layers: 40, block: 16)]), sequence_budget: token_count(count: 500000)) {
    AdmissionByteCostBytes { bytes: b } => byte_size_count(b: b) == 81920000000
    AdmissionByteCostUnestablished { cause: _ } => false
  }
}

test fn a_windowed_groups_bytes_cap_at_its_window() -> Bool {
  (match cold_admission_bytes(layout: w_layout(groups: [w_window(layers: 4, block: 16, window: 128)]), sequence_budget: token_count(count: 500000)) {
    AdmissionByteCostBytes { bytes: b } => byte_size_count(b: b) == 2097152
    AdmissionByteCostUnestablished { cause: _ } => false
  })
    && (match cold_admission_bytes(layout: w_layout(groups: [w_full(layers: 4, block: 16)]), sequence_budget: token_count(count: 500000)) {
      AdmissionByteCostBytes { bytes: b } => byte_size_count(b: b) == 8192000000
      AdmissionByteCostUnestablished { cause: _ } => false
    })
}

test fn a_mamba_groups_bytes_are_one_state_per_sequence_at_any_length() -> Bool {
  let mamba = KvGroupLayout { kind: MambaState, layer_count: attention_layer_count(count: 3), block_size: token_count(count: 16), page_size_bytes: w_page_bytes }
  (match cold_admission_bytes(layout: w_layout(groups: [mamba]), sequence_budget: token_count(count: 500000)) {
    AdmissionByteCostBytes { bytes: b } => byte_size_count(b: b) == 196608
    AdmissionByteCostUnestablished { cause: _ } => false
  })
    && (match cold_admission_bytes(layout: w_layout(groups: [mamba]), sequence_budget: token_count(count: 4096)) {
      AdmissionByteCostBytes { bytes: b } => byte_size_count(b: b) == 196608
      AdmissionByteCostUnestablished { cause: _ } => false
    })
}

test fn a_hybrid_layout_sums_each_groups_own_page_cost() -> Bool {
  let hybrid = [
    w_full(layers: 2, block: 16),
    w_window(layers: 2, block: 16, window: 128),
    KvGroupLayout { kind: MambaState, layer_count: attention_layer_count(count: 3), block_size: token_count(count: 16), page_size_bytes: w_page_bytes },
  ]
  match cold_admission_bytes(layout: w_layout(groups: hybrid), sequence_budget: token_count(count: 500000)) {
    AdmissionByteCostBytes { bytes: b } => byte_size_count(b: b) == 4097245184
    AdmissionByteCostUnestablished { cause: _ } => false
  }
}

test fn the_byte_fold_refuses_where_the_block_fold_refuses() -> Bool {
  (match cold_admission_bytes(layout: w_layout(groups: []), sequence_budget: token_count(count: 500000)) {
    AdmissionByteCostBytes { bytes: _ } => false
    AdmissionByteCostUnestablished { cause: c } => string_contains(s: c as String, pattern: "unobserved")
  })
    && (match cold_admission_bytes(layout: w_layout(groups: [w_full(layers: 40, block: 0)]), sequence_budget: token_count(count: 500000)) {
      AdmissionByteCostBytes { bytes: _ } => false
      AdmissionByteCostUnestablished { cause: c } => string_contains(s: c as String, pattern: "zero block size")
    })
    && (match cold_admission_bytes(layout: w_layout(groups: [w_full(layers: 40, block: 16)]), sequence_budget: token_count(count: 0)) {
      AdmissionByteCostBytes { bytes: _ } => false
      AdmissionByteCostUnestablished { cause: c } => string_contains(s: c as String, pattern: "empty sequence budget")
    })
}

// ── THE RESOLVED ALLOCATION PLAN: THE EMISSION THAT CLOSES THE GROUP-METADATA GAP ────────────────
//
// THE PLAN'S CONTRACT, witnessed end to end on designed captures: a complete capture mints, and
// the plan reproduces the engine's printed capacity as an independent control -- the sum of the
// per-group blocks the EMISSION vouched for at its requested length, against the printed
// concurrency line, neither side knowing the other. THE DISCRIMINATING ARMS: an incomplete
// capture refuses naming the unvouched fields; a foreign revision refuses; a wrong printed line
// contradicts with the predicted figure carried; a revision split between plan and printed lines
// refuses as one-engine evidence; the consumer fold re-derives blocks at ANOTHER length from the
// growth parameters; and the layout projection feeds the arm-side folds without a second
// taxonomy. THE EMISSION ITSELF IS A FOLLOW-UP: no claim here asserts a live engine emitted one.

fn wp_group(identity: NonEmptyStr, kind: KvGroupKind, layers: Nat, block: Nat, page: Nat, tokens_per_state: Nat, max_use: Nat, blocks_at: Nat) -> KvAllocationPlanCaptureGroup {
  KvAllocationPlanCaptureGroup {
    identity: Present { value: identity },
    kind: Present { value: kind },
    layer_identities: Present { value: map(wp_layer_names(layers), n => n) },
    block_size: Present { value: token_count(count: block) },
    page_size_bytes: Present { value: byte_size(count: page) },
    tokens_per_state: Present { value: token_count(count: tokens_per_state) },
    max_memory_usage_bytes: Present { value: byte_size(count: max_use) },
    blocks_at_requested_length: Present { value: allocator_block_count(count: blocks_at) },
  }
}

fn wp_layer_names(layers: Nat) -> List<NonEmptyStr> {
  map(nat_range_inclusive(lo: 1, hi: layers), i => join(["layer-", to_string(i - 1)], "") as NonEmptyStr)
}

fn wp_capture(groups: List<KvAllocationPlanCaptureGroup>) -> KvAllocationPlanCapture {
  KvAllocationPlanCapture {
    observed_at_revision: vllm_source_revision_read,
    image_digest: Present { value: "sha256:1111aaaa2222bbbb3333cccc4444dddd5555eeee6666ffff0000111122223333" as NonEmptyStr },
    cache_format: Present { value: "fp8_ds_mla" as NonEmptyStr },
    allocator_blocks: Present { value: allocator_block_count(count: 65536) },
    requested_length: Present { value: token_count(count: 1048576) },
    scheduler_block_size: Present { value: token_count(count: 16) },
    groups: Present { value: groups },
    grouping_padding: Present { value: "hybrid allocator: groups share one pool at the scheduler granularity; each group's admission is rounded to its own block multiple and the padding is charged inside the group's blocks" as NonEmptyStr },
  }
}

fn wp_plan(capture: KvAllocationPlanCapture) -> ResolvedKvAllocationPlan? {
  match resolved_kv_allocation_plan_from_capture(capture: capture) {
    KvAllocationPlanAdmitted { plan: p } => Present { value: p }
    KvAllocationPlanRefused { cause: _ } => none
  }
}

// A REPORTED CAPACITY AT A GIVEN HUNDREDTHS FIGURE, bound to its MaximumConcurrency line.
fn wp_reported(tokens: Nat, hundredths: Nat) -> VllmReportedCapacity? {
  match vllm_observed_kv_pool_from_reading(
    tokens: token_count(count: tokens),
    reading: vllm_startup_reading(
      line: GpuKvCacheSize,
      captured_text: "GPU KV cache size: n tokens" as NonEmptyStr,
      observed_at_revision: vllm_source_revision_read,
    ),
  ) {
    KvPoolAdmitted { pool: p } =>
      match vllm_reported_capacity(
        pool: p,
        max_concurrency: concurrent_request_hundredths(count: hundredths),
        reading: vllm_startup_reading(
          line: MaximumConcurrency,
          captured_text: "Maximum concurrency for 1,048,576 tokens per request: Nx" as NonEmptyStr,
          observed_at_revision: vllm_source_revision_read,
        ),
      ) {
        ReportedCapacityAdmitted { capacity: c } => Present { value: c }
        ReportedCapacityRefused { cause: _ } => none
      }
    KvPoolRefused { cause: _ } => none
  }
}

// THE CLEAN CONTROL: one full-attention group admitting 65,536 blocks for the full-context
// request, an inventory of 65,536 blocks, and a printed 1.00x -- the plan reproduces the printed
// capacity from the emission's own figures, and the grouping/padding decision travels with the
// plan as a vouched field, not an inference.
test fn a_complete_plan_reproduces_the_printed_capacity_as_the_independent_control() -> Bool {
  let capture = wp_capture(groups: [
    wp_group(identity: "sparse-mla" as NonEmptyStr, kind: FullAttention, layers: 1, block: 16, page: 65536, tokens_per_state: 16, max_use: 4294967296, blocks_at: 65536),
  ])
  (match resolved_kv_allocation_plan_from_capture(capture: capture) {
    KvAllocationPlanRefused { cause: _ } => false
    KvAllocationPlanAdmitted { plan: p } =>
      p.image_digest == "sha256:1111aaaa2222bbbb3333cccc4444dddd5555eeee6666ffff0000111122223333" as NonEmptyStr
        && (p.cache_format as String) == "fp8_ds_mla"
        && string_contains(s: p.grouping_padding as String, pattern: "padding")
        && length(p.groups) == 1
  })
    && (match wp_plan(capture: capture) {
      Absent => false
      Present { value: p } =>
        match wp_reported(tokens: 1048576, hundredths: 100) {
          Absent => false
          Present { value: reported } =>
            match allocation_plan_reproduces_reported_capacity(plan: p, reported: reported) {
              AllocationPlanReproducesPrinted { blocks_per_max_request: b, predicted_concurrency_hundredths: c } =>
                allocator_block_count_value(c: b) == 65536 && c == 100
              _ => false
            }
        }
    })
}

// THE MISSING-FIELD WALLS: a group row missing its page bytes refuses naming page_size_bytes; a
// capture missing the grouping/padding decision refuses naming it; the refusal is the mint's, not
// a downstream parse.
test fn an_incomplete_capture_refuses_naming_the_unvouched_fields() -> Bool {
  let no_page = wp_capture(groups: [
    KvAllocationPlanCaptureGroup {
      identity: Present { value: "sparse-mla" as NonEmptyStr },
      kind: Present { value: FullAttention },
      layer_identities: Present { value: wp_layer_names(layers: 1) },
      block_size: Present { value: token_count(count: 16) },
      page_size_bytes: Absent,
      tokens_per_state: Present { value: token_count(count: 16) },
      max_memory_usage_bytes: Present { value: byte_size(count: 4294967296) },
      blocks_at_requested_length: Present { value: allocator_block_count(count: 65536) },
    },
  ])
  let no_padding = KvAllocationPlanCapture {
    observed_at_revision: vllm_source_revision_read,
    image_digest: "sha256:1111" as NonEmptyStr,
    cache_format: Present { value: "fp8_ds_mla" as NonEmptyStr },
    allocator_blocks: Present { value: allocator_block_count(count: 65536) },
    requested_length: Present { value: token_count(count: 1048576) },
    scheduler_block_size: Present { value: token_count(count: 16) },
    groups: Present { value: [wp_group(identity: "sparse-mla" as NonEmptyStr, kind: FullAttention, layers: 1, block: 16, page: 65536, tokens_per_state: 16, max_use: 4294967296, blocks_at: 65536)] },
    grouping_padding: Absent,
  }
  (match resolved_kv_allocation_plan_from_capture(capture: no_page) {
    KvAllocationPlanRefused { cause: c } => string_contains(s: c as String, pattern: "page_size_bytes")
    KvAllocationPlanAdmitted { plan: _ } => false
  })
    && (match resolved_kv_allocation_plan_from_capture(capture: no_padding) {
      KvAllocationPlanRefused { cause: c } => string_contains(s: c as String, pattern: "grouping_padding")
      KvAllocationPlanAdmitted { plan: _ } => false
    })
}

// THE REVISION WALL: the capture's field set is a property of the upstream revision that emitted
// it; an unread revision is not trusted.
test fn a_capture_from_an_unread_revision_refuses_instead_of_being_trusted() -> Bool {
  let foreign = vllm_source_revision(
    repository: "github.com/vllm-project/vllm" as NonEmptyStr,
    full_revision: "0000000000000000000000000000000000000000" as NonEmptyStr,
  )
  match resolved_kv_allocation_plan_from_capture(capture: KvAllocationPlanCapture {
    observed_at_revision: foreign,
    image_digest: "sha256:1111" as NonEmptyStr,
    cache_format: Present { value: "fp8_ds_mla" as NonEmptyStr },
    allocator_blocks: Present { value: allocator_block_count(count: 65536) },
    requested_length: Present { value: token_count(count: 1048576) },
    scheduler_block_size: Present { value: token_count(count: 16) },
    groups: Present { value: [wp_group(identity: "sparse-mla" as NonEmptyStr, kind: FullAttention, layers: 1, block: 16, page: 65536, tokens_per_state: 16, max_use: 4294967296, blocks_at: 65536)] },
    grouping_padding: Present { value: "fx" as NonEmptyStr },
  }) {
    KvAllocationPlanRefused { cause: c } => string_contains(s: c as String, pattern: "unread revision")
    KvAllocationPlanAdmitted { plan: _ } => false
  }
}

// THE CONTROL'S DISCRIMINATING ARMS: a printed line that does not match the plan's own figures
// contradicts with the PREDICTED figure carried (the plan says 1.00x; a garbled 11.22x print
// contradicts, predicted 100 hundredths against reported 1122); and a plan from another revision
// cannot control this revision's printed lines -- the control refuses at the revision wall, and
// the mint refuses such a capture even earlier, so a revision split has no green path. THE
// FOREIGN REVISION IS 1967a5627 — the corpus' previously-modeled revision, still cited by
// runtime_defaults and now unread at the plan mint since the 2026-09-25 advance to the patched
// 8d09804 source: a live-plan-shaped record claiming the pre-patch tree is precisely the split
// this arm exists to refuse. THE REVISION-SPLIT PLAN IS CONSTRUCTED DIRECTLY because the mint
// refuses foreign revisions by design: the only way to hold such a plan is to build it, which is
// the supplied value this claim discriminates against.
test fn the_control_contradicts_a_wrong_printed_line_and_refuses_a_revision_split() -> Bool {
  let capture = wp_capture(groups: [
    wp_group(identity: "sparse-mla" as NonEmptyStr, kind: FullAttention, layers: 1, block: 16, page: 65536, tokens_per_state: 16, max_use: 4294967296, blocks_at: 65536),
  ])
  (match wp_plan(capture: capture) {
    Absent => false
    Present { value: p } =>
      match wp_reported(tokens: 1048576, hundredths: 1122) {
        Absent => false
        Present { value: garbled } =>
          match allocation_plan_reproduces_reported_capacity(plan: p, reported: garbled) {
            AllocationPlanContradictsPrinted { predicted_concurrency_hundredths: predicted, reported_concurrency_hundredths: reported } =>
              predicted == 100 && reported == 1122
            _ => false
          }
      }
  })
    && (match wp_reported(tokens: 1048576, hundredths: 100) {
      Absent => false
      Present { value: reported } =>
        match allocation_plan_reproduces_reported_capacity(plan: wp_pre_patch_revision_plan(), reported: reported) {
          AllocationPlanControlUnavailable { cause: c } => string_contains(s: c as String, pattern: "not valid across revisions")
          _ => false
        }
    })
}

fn wp_pre_patch_revision_plan() -> ResolvedKvAllocationPlan {
  let pre_patch = vllm_source_revision(
    repository: "github.com/vllm-project/vllm" as NonEmptyStr,
    full_revision: "1967a5627bc3710b680bbec24ecb99aaddedf22b" as NonEmptyStr,
  )
  ResolvedKvAllocationPlan {
    runtime: pre_patch,
    image_digest: "sha256:1111" as NonEmptyStr,
    cache_format: "fp8_ds_mla" as NonEmptyStr,
    allocator_blocks: allocator_block_count(count: 65536),
    requested_length: token_count(count: 1048576),
    scheduler_block_size: token_count(count: 16),
    groups: [KvAllocationPlanGroup {
      identity: "sparse-mla" as NonEmptyStr,
      kind: FullAttention,
      layer_identities: wp_layer_names(layers: 1),
      block_size: token_count(count: 16),
      page_size_bytes: byte_size(count: 65536),
      tokens_per_state: token_count(count: 16),
      max_memory_usage_bytes: byte_size(count: 4294967296),
      blocks_at_requested_length: allocator_block_count(count: 65536),
    }],
    grouping_padding: "fx: designed plan row for the revision-split claim" as NonEmptyStr,
  }
}

// THE CONSUMER FOLD AT ANOTHER LENGTH: the plan's growth parameters re-derive the admission cost
// at 500,000 tokens -- the full group at 16-token blocks, the mamba states at their tokens-per-
// state width regardless of length, and the KPool group at one entry per four tokens with blocks
// counted in entries.
test fn the_consumer_fold_rederives_blocks_at_another_length_from_the_growth_parameters() -> Bool {
  let capture = wp_capture(groups: [
    wp_group(identity: "sparse-mla" as NonEmptyStr, kind: FullAttention, layers: 11, block: 16, page: 8192, tokens_per_state: 16, max_use: 5905580032, blocks_at: 720896),
    wp_group(identity: "kda-state" as NonEmptyStr, kind: MambaState, layers: 3, block: 16, page: 1048576, tokens_per_state: 1, max_use: 3145728, blocks_at: 3),
    wp_group(identity: "kpool" as NonEmptyStr, kind: KPoolIndex { pool_every: token_count(count: 4) }, layers: 1, block: 16, page: 65536, tokens_per_state: 4, max_use: 1073741824, blocks_at: 16384),
  ])
  match wp_plan(capture: capture) {
    Absent => false
    Present { value: p } =>
      match plan_admission_blocks_at_length(plan: p, at: token_count(count: 500000)) {
        AdmissionCostBlocks { blocks: b } => allocator_block_count_value(c: b) == 351566
        AdmissionCostUnestablished { cause: _ } => false
      }
  }
}

// THE LAYOUT PROJECTION: the arm-side folds consume ResolvedKvLayout, and the plan projects onto
// it by construction -- the groups carry the same growth taxonomy, the layer counts come from the
// emission's own layer identities, and the layout's revision is the plan's runtime.
test fn the_layout_projection_feeds_the_arm_side_folds_without_a_second_taxonomy() -> Bool {
  let capture = wp_capture(groups: [
    wp_group(identity: "sparse-mla" as NonEmptyStr, kind: FullAttention, layers: 11, block: 16, page: 8192, tokens_per_state: 16, max_use: 5905580032, blocks_at: 720896),
    wp_group(identity: "kda-state" as NonEmptyStr, kind: MambaState, layers: 3, block: 16, page: 1048576, tokens_per_state: 1, max_use: 3145728, blocks_at: 3),
  ])
  match wp_plan(capture: capture) {
    Absent => false
    Present { value: p } =>
      let layout = resolved_kv_layout_from_plan(plan: p)
      length(layout.groups) == 2
        && (match first(layout.groups) {
          Present { value: g } => attention_layer_count_value(c: g.layer_count) == 11
          Absent => false
        })
        && (layout.established_at_revision.full_revision as String) == (vllm_source_revision_read.full_revision as String)
  }
}

// THE ZERO WALLS TRAVEL WITH THE PLAN: a complete capture of a group with a zero-byte page is a
// complete capture of a broken engine, and the mint refuses rather than pricing it.
test fn a_zero_wall_in_a_group_refuses_the_plan() -> Bool {
  match resolved_kv_allocation_plan_from_capture(capture: wp_capture(groups: [
    wp_group(identity: "sparse-mla" as NonEmptyStr, kind: FullAttention, layers: 1, block: 16, page: 0, tokens_per_state: 16, max_use: 0, blocks_at: 65536),
  ])) {
    KvAllocationPlanRefused { cause: c } => string_contains(s: c as String, pattern: "is not a group")
    KvAllocationPlanAdmitted { plan: _ } => false
  }
}
