module test.claim.bmc_fan_converge_witness

import extdeps.bmc.openbmc_fan_control {
  OpenBmcTachAtOrAboveThreshold,
  OpenBmcTachBelowThreshold,
  OpenBmcWarningLowThreshold,
}
import extdeps.crypto.hash { sha256_digest }
import gunbc.bmc_fan_converge {
  BmcFanAppliedAndVerified,
  BmcFanAppliedWithCleanupDebt,
  BmcFanRollbackNotAttempted,
  CurveStepsParseRefused,
  bmc_fan_build_curve_steps,
  bmc_fan_first_unhealthy_tach,
  bmc_fan_live_digest_matches,
  bmc_fan_mutation_applied,
  bmc_fan_record_cleanup_debt,
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn duty_curve_cannot_fall_after_reaching_emergency_full_duty() -> Bool {
  match bmc_fan_build_curve_steps(
    readings: [90, 95],
    outputs: [100, 30],
  ) {
    CurveStepsParseRefused { reason: _ } => true
    _ => false
  }
}

test fn successful_effect_survives_cleanup_failure_as_cleanup_debt() -> Bool {
  match bmc_fan_record_cleanup_debt(
    result: bmc_fan_mutation_applied(),
    cleanup_debt: "remote stage removal failed",
  ) {
    BmcFanAppliedWithCleanupDebt {
      cleanup_debt,
      rollback: BmcFanRollbackNotAttempted,
    } => cleanup_debt == "remote stage removal failed"
    _ => false
  }
}

test fn sub_threshold_tach_is_a_discriminating_refusal() -> Bool {
  match bmc_fan_first_unhealthy_tach(
    health: [
      OpenBmcTachBelowThreshold {
        sensor: "FAN4",
        reading_rpm: 899,
        minimum_rpm: 900,
        source: OpenBmcWarningLowThreshold,
      },
    ],
    required: ["FAN4"],
  ) {
    Present { value: _ } => true
    Absent => false
  }
}

test fn threshold_satisfied_tach_is_not_refused() -> Bool {
  match bmc_fan_first_unhealthy_tach(
    health: [
      OpenBmcTachAtOrAboveThreshold {
        sensor: "FAN4",
        reading_rpm: 900,
        minimum_rpm: 900,
        source: OpenBmcWarningLowThreshold,
      },
    ],
    required: ["FAN4"],
  ) {
    Present { value: _ } => false
    Absent => true
  }
}

test fn semantically_equal_but_digest_different_config_is_not_live_exact() -> Bool {
  let admitted = sha256_digest(content: "{\"policy\":1}\n")
  let live = sha256_digest(content: "{ \"policy\": 1 }\n")
  admitted != live
    && !bmc_fan_live_digest_matches(
      live_digest: live,
      admitted_digest: admitted,
    )
}
