  "machine=altrad8ud-1l2t",
  "selected_config_path=/usr/share/swampd/config.json",
  "board_config_path=/usr/share/swampd/config-asrr.json",
  "controller_service=phosphor-pid-control.service",
  "controller_binary=/usr/bin/swampd",
  "service_active=active",
  "zone_control_path=/xyz/openbmc_project/settings/fanctrl/zone0",
  "zone_failsafe=false",
  "target_count=1",
  "minimum=30",
  "zone_failsafe_duty=75",
  "sensor_failsafe=75",
  "positive_hysteresis=1",
  "negative_hysteresis=2",
  "readings=40,75,90,93,95,97,98",
  "outputs=30,30,30,55,70,85,100",
  "fan_entries=FAN1",
  "fan_entry_count=1",
  "fan_inputs=FAN1,FAN2,FAN3,FAN4",
  "writable=true",
  "upper_override=true",
  "available_bytes=20000000",
  "observed_at=2026-07-27T20:00:00Z",
  "temperature_TEMP_SOC=74",
  "tach_FAN1=4800",
  "tach_FAN2=1200",
  "tach_FAN3=1210",
  "tach_FAN4=1190",
  "tach_FAN5=absent",
  "temperature_TEMP_Core_VRD=63",
  "temperature_TEMP_DIMM_A1=65",
  "temperature_TEMP_DIMM_B1=64",
  "temperature_TEMP_DIMM_C1=63",
  "temperature_TEMP_DIMM_D1=60",
  "temperature_TEMP_DIMM_E1=68",
  "temperature_TEMP_DIMM_F1=70",
  "temperature_TEMP_DIMM_G1=70",
  "temperature_TEMP_DIMM_H1=67",
  "temperature_TEMP_DIMM_VRD=59",
  "temperature_TEMP_MB=55",
  "temperature_TEMP_RCA_VR=60",
  "temperature_TEMP_SOC_VRD=58",
  "temperature_TEMP_VR=59",
