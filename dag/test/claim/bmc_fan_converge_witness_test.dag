}
import gunbc.fleet_bmc_state {
  srv4_bmc_fan_projection_capability,
  srv4_bmc_root_overlay_observation,
}
import std.state_durability { durability_commit_barrier_is_synchronized }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

