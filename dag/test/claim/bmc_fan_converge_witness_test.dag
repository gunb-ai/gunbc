module test.claim.bmc_fan_converge_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

data cleanup_debt_test_digest: extdeps.crypto.hash.Digest = sha256_digest(
  hex: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
)

data cleanup_debt_test_manifest: gunbc.bmc_fan_converge.BmcFanBackupManifest = bmc_fan_backup_manifest(
  target: srv4_host.identity,
  stable_bmc_identity: "srv4-bmc-machine-id",
  firmware: asrock_altrad8ud_openbmc_3_22_00_capabilities.firmware,
  config_path: "/usr/share/swampd/config-asrr.json",
  before_digest: cleanup_debt_test_digest,
  backup_digest: cleanup_debt_test_digest,
  creation_generation: 1,
  created_at: 1,
)

data cleanup_debt_test_applied_receipt: gunbc.bmc_fan_converge.BmcFanAppliedReceipt = gunbc.bmc_fan_converge.BmcFanAppliedReceipt {
  backup_manifest: cleanup_debt_test_manifest,
  projected_digest: cleanup_debt_test_digest,
  post_publication_active_digest: cleanup_debt_test_digest,
  post_restart_active_digest: cleanup_debt_test_digest,
  monitoring: gunbc.bmc_fan_monitor.BmcFanMonitoringReceipt {
    sample_count: 12,
    elapsed: second(360),
    required_elapsed: second(360),
    maximum_sample_gap: second(30),
  },
}

test fn duty_curve_cannot_fall_after_reaching_emergency_full_duty() -> Bool {
  match validate_bmc_fan_curve(
    curve: extdeps.bmc.types.BmcFanCurve {
      control_sensor: "TEMP_SOC",
      steps: [
        extdeps.bmc.types.BmcFanCurveStep { at_or_above: celsius(90), duty: percent(100) },
        extdeps.bmc.types.BmcFanCurveStep { at_or_above: celsius(95), duty: percent(30) },
      ],
      minimum_duty: percent(30),
      sensor_unavailable_duty: percent(100),
      zone_failsafe_duty: percent(100),
      positive_hysteresis: celsius_delta(1),
      negative_hysteresis: celsius_delta(1),
    },
  ) {
    BmcFanCurveInvalid { cause: _ } => true
    _ => false
  }
}

test fn successful_effect_survives_cleanup_failure_as_cleanup_debt() -> Bool {
  match bmc_fan_record_cleanup_debt(
    result: gunbc.bmc_fan_converge.BmcFanAppliedAndVerified {
      receipt: cleanup_debt_test_applied_receipt,
    },
    cleanup_debt: "remote stage removal failed",
  ) {
    BmcFanAppliedWithCleanupDebt {
      cleanup_debt,
      receipt,
    } => cleanup_debt == "remote stage removal failed"
      && receipt.post_restart_active_digest == cleanup_debt_test_digest
    _ => false
  }
}

test fn digest_mismatched_backup_manifest_is_not_admitted() -> Bool {
  let different_digest = sha256_digest(
    hex: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
  )
  let mismatched = bmc_fan_backup_manifest(
    target: srv4_host.identity,
    stable_bmc_identity: "srv4-bmc-machine-id",
    firmware: asrock_altrad8ud_openbmc_3_22_00_capabilities.firmware,
    config_path: "/usr/share/swampd/config-asrr.json",
    before_digest: cleanup_debt_test_digest,
    backup_digest: different_digest,
    creation_generation: 1,
    created_at: 1,
  )
  !bmc_fan_backup_manifest_matches_request(
    manifest: mismatched,
    target: srv4_host.identity,
    stable_bmc_identity: "srv4-bmc-machine-id",
    firmware: asrock_altrad8ud_openbmc_3_22_00_capabilities.firmware,
    config_path: "/usr/share/swampd/config-asrr.json",
    before_digest: cleanup_debt_test_digest,
    creation_generation: 1,
  )
}

test fn stale_backup_manifest_generation_is_not_admitted() -> Bool {
  !bmc_fan_backup_manifest_matches_request(
    manifest: cleanup_debt_test_manifest,
    target: srv4_host.identity,
    stable_bmc_identity: "srv4-bmc-machine-id",
    firmware: asrock_altrad8ud_openbmc_3_22_00_capabilities.firmware,
    config_path: "/usr/share/swampd/config-asrr.json",
    before_digest: cleanup_debt_test_digest,
    creation_generation: 2,
  )
}

fn backup_manifest_identity_differs(
  changed: gunbc.bmc_fan_converge.BmcFanBackupManifest,
) -> Bool {
  let baseline_identity = bmc_fan_backup_manifest_identity(
    manifest: cleanup_debt_test_manifest,
  )
  let changed_identity = bmc_fan_backup_manifest_identity(manifest: changed)
  baseline_identity != changed_identity
}

test fn backup_manifest_identity_is_derived_from_every_manifest_field() -> Bool {
  let different_digest = sha256_digest(
    hex: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
  )
  backup_manifest_identity_differs(changed: bmc_fan_backup_manifest(
    target: srv3_host.identity,
    stable_bmc_identity: cleanup_debt_test_manifest.stable_bmc_identity,
    firmware: cleanup_debt_test_manifest.firmware,
    config_path: cleanup_debt_test_manifest.config_path,
    before_digest: cleanup_debt_test_manifest.before_digest,
    backup_digest: cleanup_debt_test_manifest.backup_digest,
    creation_generation: cleanup_debt_test_manifest.creation_generation,
    created_at: cleanup_debt_test_manifest.created_at,
  ))
    && backup_manifest_identity_differs(changed: bmc_fan_backup_manifest(
      target: cleanup_debt_test_manifest.target,
      stable_bmc_identity: "different-bmc-machine-id",
      firmware: cleanup_debt_test_manifest.firmware,
      config_path: cleanup_debt_test_manifest.config_path,
      before_digest: cleanup_debt_test_manifest.before_digest,
      backup_digest: cleanup_debt_test_manifest.backup_digest,
      creation_generation: cleanup_debt_test_manifest.creation_generation,
      created_at: cleanup_debt_test_manifest.created_at,
    ))
    && backup_manifest_identity_differs(changed: bmc_fan_backup_manifest(
      target: cleanup_debt_test_manifest.target,
      stable_bmc_identity: cleanup_debt_test_manifest.stable_bmc_identity,
      firmware: extdeps.bmc.capability.BmcFirmwareVersion {
        family: OpenBmc,
        version: firmware_semantic_version(
          major: cleanup_debt_test_manifest.firmware.version.major + 1,
          minor: cleanup_debt_test_manifest.firmware.version.minor,
          patch: cleanup_debt_test_manifest.firmware.version.patch,
        ),
      },
      config_path: cleanup_debt_test_manifest.config_path,
      before_digest: cleanup_debt_test_manifest.before_digest,
      backup_digest: cleanup_debt_test_manifest.backup_digest,
      creation_generation: cleanup_debt_test_manifest.creation_generation,
      created_at: cleanup_debt_test_manifest.created_at,
    ))
    && backup_manifest_identity_differs(changed: bmc_fan_backup_manifest(
      target: cleanup_debt_test_manifest.target,
      stable_bmc_identity: cleanup_debt_test_manifest.stable_bmc_identity,
      firmware: cleanup_debt_test_manifest.firmware,
      config_path: "/usr/share/swampd/different-config.json",
      before_digest: cleanup_debt_test_manifest.before_digest,
      backup_digest: cleanup_debt_test_manifest.backup_digest,
      creation_generation: cleanup_debt_test_manifest.creation_generation,
      created_at: cleanup_debt_test_manifest.created_at,
    ))
    && backup_manifest_identity_differs(changed: bmc_fan_backup_manifest(
      target: cleanup_debt_test_manifest.target,
      stable_bmc_identity: cleanup_debt_test_manifest.stable_bmc_identity,
      firmware: cleanup_debt_test_manifest.firmware,
      config_path: cleanup_debt_test_manifest.config_path,
      before_digest: different_digest,
      backup_digest: cleanup_debt_test_manifest.backup_digest,
      creation_generation: cleanup_debt_test_manifest.creation_generation,
      created_at: cleanup_debt_test_manifest.created_at,
    ))
    && backup_manifest_identity_differs(changed: bmc_fan_backup_manifest(
      target: cleanup_debt_test_manifest.target,
      stable_bmc_identity: cleanup_debt_test_manifest.stable_bmc_identity,
      firmware: cleanup_debt_test_manifest.firmware,
      config_path: cleanup_debt_test_manifest.config_path,
      before_digest: cleanup_debt_test_manifest.before_digest,
      backup_digest: different_digest,
      creation_generation: cleanup_debt_test_manifest.creation_generation,
      created_at: cleanup_debt_test_manifest.created_at,
    ))
    && backup_manifest_identity_differs(changed: bmc_fan_backup_manifest(
      target: cleanup_debt_test_manifest.target,
      stable_bmc_identity: cleanup_debt_test_manifest.stable_bmc_identity,
      firmware: cleanup_debt_test_manifest.firmware,
      config_path: cleanup_debt_test_manifest.config_path,
      before_digest: cleanup_debt_test_manifest.before_digest,
      backup_digest: cleanup_debt_test_manifest.backup_digest,
      creation_generation: cleanup_debt_test_manifest.creation_generation + 1,
      created_at: cleanup_debt_test_manifest.created_at,
    ))
    && backup_manifest_identity_differs(changed: bmc_fan_backup_manifest(
      target: cleanup_debt_test_manifest.target,
      stable_bmc_identity: cleanup_debt_test_manifest.stable_bmc_identity,
      firmware: cleanup_debt_test_manifest.firmware,
      config_path: cleanup_debt_test_manifest.config_path,
      before_digest: cleanup_debt_test_manifest.before_digest,
      backup_digest: cleanup_debt_test_manifest.backup_digest,
      creation_generation: cleanup_debt_test_manifest.creation_generation,
      created_at: cleanup_debt_test_manifest.created_at + 1,
    ))
}

test fn identical_bmc_on_wrong_endpoint_is_not_exact_target() -> Bool {
  !bmc_fan_exact_target_admission_matches(
    target: srv4_host.identity,
    admission_target: srv3_host.identity,
  )
}

test fn sub_threshold_tach_is_a_discriminating_refusal() -> Bool {
  match bmc_fan_first_unhealthy_tach(
    health: [
      extdeps.bmc.openbmc_fan_control.OpenBmcTachBelowThreshold {
        sensor: "FAN4",
        reading_rpm: rpm(899),
        minimum_rpm: rpm(900),
        source: OpenBmcWarningLowThreshold,
      },
    ],
    required: ["FAN4"],
  ) {
    Present { value: _ } => true
    Absent => false
  }
}

test fn threshold_satisfied_tach_is_not_refused() -> Bool {
  match bmc_fan_first_unhealthy_tach(
    health: [
      extdeps.bmc.openbmc_fan_control.OpenBmcTachAtOrAboveThreshold {
        sensor: "FAN4",
        reading_rpm: rpm(900),
        minimum_rpm: rpm(900),
        source: OpenBmcWarningLowThreshold,
      },
    ],
    required: ["FAN4"],
  ) {
    Present { value: _ } => false
    Absent => true
  }
}

test fn semantically_equal_but_digest_different_config_is_not_live_exact() -> Bool {
  let admitted = sha256_digest(
    hex: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
  )
  let live = sha256_digest(
    hex: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
  )
  admitted != live
    && !bmc_fan_live_digest_matches(
      live_digest: live,
      admitted_digest: admitted,
    )
}

test fn delayed_temperature_rise_is_seen_inside_the_bounded_window() -> Bool {
  match bmc_fan_assess_monitoring_samples(
    samples: [
      gunbc.bmc_fan_monitor.BmcFanMonitoringSample { elapsed: second(30), safety_refusal: none },
      gunbc.bmc_fan_monitor.BmcFanMonitoringSample { elapsed: second(60), safety_refusal: none },
      gunbc.bmc_fan_monitor.BmcFanMonitoringSample {
        elapsed: second(90),
        safety_refusal: Present { value: "TEMP_SOC crossed rollback threshold" },
      },
      gunbc.bmc_fan_monitor.BmcFanMonitoringSample { elapsed: second(360), safety_refusal: none },
    ],
    required_elapsed: second(360),
    maximum_sample_gap: second(30),
  ) {
    BmcFanMonitoringRefused { reason: _, receipt } =>
      receipt.sample_count == 3 && second_count(receipt.elapsed) == 90
    BmcFanMonitoringCompleted { receipt: _ } => false
  }
}

test fn short_monitoring_window_cannot_claim_completion() -> Bool {
  match bmc_fan_assess_monitoring_samples(
    samples: [
      gunbc.bmc_fan_monitor.BmcFanMonitoringSample { elapsed: second(30), safety_refusal: none },
      gunbc.bmc_fan_monitor.BmcFanMonitoringSample { elapsed: second(60), safety_refusal: none },
    ],
    required_elapsed: second(360),
    maximum_sample_gap: second(30),
  ) {
    BmcFanMonitoringRefused { reason: _, receipt } =>
      receipt.sample_count == 2 && second_count(receipt.elapsed) == 60
    BmcFanMonitoringCompleted { receipt: _ } => false
  }
}

test fn empty_monitoring_window_cannot_claim_completion() -> Bool {
  match bmc_fan_assess_monitoring_samples(
    samples: [],
    required_elapsed: second(360),
    maximum_sample_gap: second(30),
  ) {
    BmcFanMonitoringRefused { reason: _, receipt } =>
      receipt.sample_count == 0 && second_count(receipt.elapsed) == 0
    BmcFanMonitoringCompleted { receipt: _ } => false
  }
}

test fn bounded_monitoring_completion_carries_the_admitted_bound() -> Bool {
  match bmc_fan_assess_monitoring_samples(
    samples: [
      gunbc.bmc_fan_monitor.BmcFanMonitoringSample { elapsed: second(30), safety_refusal: none },
      gunbc.bmc_fan_monitor.BmcFanMonitoringSample { elapsed: second(60), safety_refusal: none },
      gunbc.bmc_fan_monitor.BmcFanMonitoringSample { elapsed: second(90), safety_refusal: none },
      gunbc.bmc_fan_monitor.BmcFanMonitoringSample { elapsed: second(120), safety_refusal: none },
      gunbc.bmc_fan_monitor.BmcFanMonitoringSample { elapsed: second(150), safety_refusal: none },
      gunbc.bmc_fan_monitor.BmcFanMonitoringSample { elapsed: second(180), safety_refusal: none },
      gunbc.bmc_fan_monitor.BmcFanMonitoringSample { elapsed: second(210), safety_refusal: none },
      gunbc.bmc_fan_monitor.BmcFanMonitoringSample { elapsed: second(240), safety_refusal: none },
      gunbc.bmc_fan_monitor.BmcFanMonitoringSample { elapsed: second(270), safety_refusal: none },
      gunbc.bmc_fan_monitor.BmcFanMonitoringSample { elapsed: second(300), safety_refusal: none },
      gunbc.bmc_fan_monitor.BmcFanMonitoringSample { elapsed: second(330), safety_refusal: none },
      gunbc.bmc_fan_monitor.BmcFanMonitoringSample { elapsed: second(360), safety_refusal: none },
    ],
    required_elapsed: second(360),
    maximum_sample_gap: second(30),
  ) {
    BmcFanMonitoringCompleted { receipt } =>
      receipt.sample_count == 12
        && second_count(receipt.elapsed) == 360
        && second_count(receipt.required_elapsed) == 360
        && second_count(receipt.maximum_sample_gap) == 30
    BmcFanMonitoringRefused { reason: _, receipt: _ } => false
  }
}

test fn one_late_sample_cannot_claim_monitoring_coverage() -> Bool {
  match bmc_fan_assess_monitoring_samples(
    samples: [
      gunbc.bmc_fan_monitor.BmcFanMonitoringSample { elapsed: second(360), safety_refusal: none },
    ],
    required_elapsed: second(360),
    maximum_sample_gap: second(30),
  ) {
    BmcFanMonitoringRefused { reason, receipt } =>
      reason == "post-restart monitoring sample gap exceeded its admitted cadence"
        && receipt.sample_count == 1
        && second_count(receipt.elapsed) == 360
    BmcFanMonitoringCompleted { receipt: _ } => false
  }
}
