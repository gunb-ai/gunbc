module test.claim.extdeps_git_diff_name_status_witness

import std.logic { Bool }
import std.measure { percent_count }
import extdeps.git {
  GitDiffChangeStatus,
  GitDiffStatusEntry,
  DiffAddedStatus,
  DiffCopiedStatus,
  DiffDeletedStatus,
  DiffModifiedStatus,
  DiffRenamedStatus,
  DiffUnknownGitStatus,
  git_diff_name_status_field_separator,
  parse_git_diff_name_status_z,
  git_diff_name_status_parse_state,
  git_diff_name_status_parse_state_is_truncated,
  git_diff_status_entries_touched_paths,
  git_diff_status_entries_departed_paths,
  git_diff_status_entries_any_unknown
}

fn append_name_status_token(acc: String, token: String) -> String {
  if acc == "" { token } else { concat(acc, concat(git_diff_name_status_field_separator, token)) }
}

fn join_name_status_tokens(tokens: List<String>) -> String {
  fold(tokens, init: "", f: append_name_status_token)
}

fn list_contains_string(xs: List<String>, needle: String) -> Bool {
  fold(xs, init: false, f: (acc, x) => acc || (x == needle))
}

fn w_modified_single_entry() -> Bool {
  let raw = join_name_status_tokens(["M", "file.txt"])
  let entries = parse_git_diff_name_status_z(raw: raw)
  entries.length() == 1
    && entries.first().path == "file.txt"
    && match entries.first().old_path {
      Absent => true
      Present { value: _ } => false
    }
    && match entries.first().status {
      DiffModifiedStatus => true
      _ => false
    }
}

fn w_added_entry() -> Bool {
  let raw = join_name_status_tokens(["A", "new_file.txt"])
  let entries = parse_git_diff_name_status_z(raw: raw)
  entries.length() == 1
    && match entries.first().status {
      DiffAddedStatus => true
      _ => false
    }
}

fn w_deleted_entry() -> Bool {
  let raw = join_name_status_tokens(["D", "gone.txt"])
  let entries = parse_git_diff_name_status_z(raw: raw)
  entries.length() == 1
    && entries.first().path == "gone.txt"
    && match entries.first().status {
      DiffDeletedStatus => true
      _ => false
    }
}

fn w_renamed_entry_carries_similarity_and_old_path() -> Bool {
  let raw = join_name_status_tokens(["R100", "old_name.txt", "new_name.txt"])
  let entries = parse_git_diff_name_status_z(raw: raw)
  entries.length() == 1
    && entries.first().path == "new_name.txt"
    && match entries.first().old_path {
      Present { value: old } => old == "old_name.txt"
      Absent => false
    }
    && match entries.first().status {
      DiffRenamedStatus { similarity: sim } => percent_count(p: sim) == 100
      _ => false
    }
}

fn w_copied_entry_carries_similarity_and_old_path() -> Bool {
  let raw = join_name_status_tokens(["C87", "source.txt", "copy.txt"])
  let entries = parse_git_diff_name_status_z(raw: raw)
  entries.length() == 1
    && entries.first().path == "copy.txt"
    && match entries.first().old_path {
      Present { value: old } => old == "source.txt"
      Absent => false
    }
    && match entries.first().status {
      DiffCopiedStatus { similarity: sim } => percent_count(p: sim) == 87
      _ => false
    }
}

fn w_mixed_multi_entry_blob_preserves_order_and_arity() -> Bool {
  let raw = join_name_status_tokens([
    "M", "a.txt",
    "A", "b.txt",
    "D", "c.txt",
    "R92", "old_d.txt", "new_d.txt"
  ])
  let entries = parse_git_diff_name_status_z(raw: raw)
  entries.length() == 4
    && entries.first().path == "a.txt"
    && entries.skip(n: 1).first().path == "b.txt"
    && entries.skip(n: 2).first().path == "c.txt"
    && entries.skip(n: 3).first().path == "new_d.txt"
    && match entries.skip(n: 3).first().old_path {
      Present { value: old } => old == "old_d.txt"
      Absent => false
    }
}

fn w_unrecognized_status_letter_is_typed_not_absorbed() -> Bool {
  let raw = join_name_status_tokens(["X", "weird.txt"])
  let entries = parse_git_diff_name_status_z(raw: raw)
  entries.length() == 1
    && match entries.first().status {
      DiffUnknownGitStatus { raw: token } => token == "X"
      _ => false
    }
    && git_diff_status_entries_any_unknown(entries: entries)
}

fn w_malformed_rename_score_is_typed_unknown_not_absorbed() -> Bool {
  let raw = join_name_status_tokens(["Rxx", "old.txt", "new.txt"])
  let entries = parse_git_diff_name_status_z(raw: raw)
  match entries.first().status {
    DiffUnknownGitStatus { raw: token } => token == "Rxx"
    _ => false
  }
    && git_diff_status_entries_any_unknown(entries: entries)
}

fn w_malformed_rename_score_corruption_stays_fail_closed_downstream() -> Bool {
  let raw = join_name_status_tokens(["Rxx", "old.txt", "new.txt", "M", "trailing.txt"])
  let entries = parse_git_diff_name_status_z(raw: raw)
  git_diff_status_entries_any_unknown(entries: entries)
}

fn w_recognized_entries_are_never_flagged_unknown() -> Bool {
  let raw = join_name_status_tokens(["M", "a.txt", "A", "b.txt"])
  let entries = parse_git_diff_name_status_z(raw: raw)
  !git_diff_status_entries_any_unknown(entries: entries)
}

fn w_touched_paths_derives_both_sides_of_a_rename() -> Bool {
  let raw = join_name_status_tokens(["M", "a.txt", "R100", "old_d.txt", "new_d.txt"])
  let entries = parse_git_diff_name_status_z(raw: raw)
  let touched = git_diff_status_entries_touched_paths(entries: entries)
  touched.length() == 3
    && list_contains_string(xs: touched, needle: "a.txt")
    && list_contains_string(xs: touched, needle: "old_d.txt")
    && list_contains_string(xs: touched, needle: "new_d.txt")
}

fn w_departed_paths_names_deletions_and_rename_sources_only() -> Bool {
  let raw = join_name_status_tokens([
    "M", "a.txt",
    "D", "gone.txt",
    "R100", "old_d.txt", "new_d.txt",
    "C87", "source.txt", "copy.txt"
  ])
  let entries = parse_git_diff_name_status_z(raw: raw)
  let departed = git_diff_status_entries_departed_paths(entries: entries)
  departed.length() == 2
    && list_contains_string(xs: departed, needle: "gone.txt")
    && list_contains_string(xs: departed, needle: "old_d.txt")
    && !list_contains_string(xs: departed, needle: "source.txt")
    && !list_contains_string(xs: departed, needle: "a.txt")
    && !list_contains_string(xs: departed, needle: "new_d.txt")
    && !list_contains_string(xs: departed, needle: "copy.txt")
}

fn w_empty_raw_produces_no_entries() -> Bool {
  parse_git_diff_name_status_z(raw: "").length() == 0
}

test fn extdeps_git_diff_name_status_witnesses() -> Bool {
  w_modified_single_entry()
    && w_added_entry()
    && w_deleted_entry()
    && w_renamed_entry_carries_similarity_and_old_path()
    && w_copied_entry_carries_similarity_and_old_path()
    && w_mixed_multi_entry_blob_preserves_order_and_arity()
    && w_unrecognized_status_letter_is_typed_not_absorbed()
    && w_malformed_rename_score_is_typed_unknown_not_absorbed()
    && w_malformed_rename_score_corruption_stays_fail_closed_downstream()
    && w_recognized_entries_are_never_flagged_unknown()
    && w_touched_paths_derives_both_sides_of_a_rename()
    && w_departed_paths_names_deletions_and_rename_sources_only()
    && w_empty_raw_produces_no_entries()
}
