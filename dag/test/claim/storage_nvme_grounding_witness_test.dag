module test.claim.storage_nvme_grounding


data live_tree_disposition: LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data sample_wd_device: StorageDevice = extdeps.storage.types.nvme_storage_device(
  catalog: extdeps.storage.western_digital.wd_black_sn850x_2tb_catalog,
  persistence: Persistent,
)

test fn wd_black_sn850x_pcie_link_grounds_gen4_x4() -> Bool {
  match extdeps.storage.western_digital.wd_black_sn850x_2tb_catalog.pcie_link.generation {
    Gen4 => true
    Gen3 => false
    Gen5 => false
  }
    && extdeps.storage.western_digital.wd_black_sn850x_2tb_catalog.pcie_link.lane_count == 4
    && std.measure.bandwidth_count(extdeps.storage.types.pcie_link_bandwidth(link: extdeps.storage.western_digital.wd_black_sn850x_2tb_catalog.pcie_link)) == (16000000000 * 128 / 130 / 8 * 4)
}

test fn samsung_970_evo_plus_pcie_link_grounds_gen3_x4() -> Bool {
  match extdeps.storage.samsung.samsung_970_evo_plus_2tb_catalog.pcie_link.generation {
    Gen3 => true
    Gen4 => false
    Gen5 => false
  }
    && extdeps.storage.samsung.samsung_970_evo_plus_2tb_catalog.pcie_link.lane_count == 4
    && std.measure.bandwidth_count(extdeps.storage.types.pcie_generation_per_lane_bandwidth(g: Gen3)) == (8000000000 * 128 / 130 / 8)
}

test fn nvme_catalog_specs_decode() -> Bool {
  std.measure.byte_size_count(extdeps.storage.western_digital.wd_black_sn850x_2tb_catalog.capacity_bytes) == 2000398934016
    && std.measure.bandwidth_count(extdeps.storage.western_digital.wd_black_sn850x_2tb_catalog.sequential_read) == 7300000000
    && std.measure.bandwidth_count(extdeps.storage.western_digital.wd_black_sn850x_2tb_catalog.sequential_write) == 6300000000
    && std.measure.byte_size_count(extdeps.storage.samsung.samsung_970_evo_plus_2tb_catalog.capacity_bytes) == 2000398934016
}

test fn form_factor_is_m2_2280() -> Bool {
  match extdeps.storage.western_digital.wd_black_sn850x_2tb_catalog.form_factor {
    M2_2280 => true
    M2_2230 => false
    M2_2242 => false
    M2_2260 => false
    M2_22110 => false
    U2 => false
    AddInCard => false
  }
}

test fn nvme_storage_device_derives_from_catalog() -> Bool {
  std.measure.byte_size_count(extdeps.storage.types.storage_device_capacity(d: sample_wd_device)) == std.measure.byte_size_count(extdeps.storage.western_digital.wd_black_sn850x_2tb_catalog.capacity_bytes)
    && match extdeps.storage.types.storage_device_medium(d: sample_wd_device) {
      Nvme => true
      Ssd => false
      Hdd => false
      NetworkAttached => false
      EphemeralFs => false
    }
    && match extdeps.storage.types.storage_device_pcie_link(d: sample_wd_device) {
      Present { value: link } => link.lane_count == 4
      Absent => false
    }
    && match extdeps.storage.types.storage_device_read_bandwidth(d: sample_wd_device) {
      Present { value: bw } => std.measure.bandwidth_count(bw) == 7300000000
      Absent => false
    }
}
