module test.claim.fabric_terminal_contract_witness

data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

// The acceptance test for the terminal contract: two synthetic SCM bindings must
// project into the same core carriers without the core naming either of them.

// These fixtures stand in for a GitHub binding and a GitLab binding. Nothing
// in this file imports a provider module, and nothing in product.fabric.*
// names one - that absence IS the claim under test. The two bindings differ
// only in the provenance they carry on their Demand, and the discriminating
// assertion is that the Work identity they produce is IDENTICAL while the
// demands remain distinct. If a provider fact ever leaks into Work, this
// witness reds without anyone needing to notice the leak.
data fixture_shape: product.fabric.work.Shape = product.fabric.work.Shape { hard: product.fabric.work.HardRequirements { threads: std.measure.hardware_thread_count(8) } }

data fixture_requirements: product.fabric.work.ExecutionRequirements = product.fabric.work.ExecutionRequirements {
  shape: fixture_shape,
  capabilities: "linux-arm64",
  trust_domain: "fleet-owned",
}

data fixture_contract: product.fabric.work.WorkContract = product.fabric.work.WorkContract {
  program: "gunbc-required-floor",
  steps: [product.fabric.work.WorkStep { step_id: "floor", resumability: product.fabric.work.ReceiptSatisfiable }],
  source: "sha256:tree-abc",
  inputs: "manifest-inputs-1",
  runtime_closure: "toolchain-rust-1.89",
  effect_contract: "effects-read-only",
  output_contract: "outputs-verdict",
}

// The key is DERIVED, never authored. An earlier version of this file declared
// a constant and placed it into both synthetic demands, which made the headline
// neutrality test unfalsifiable: it would have passed against a key that
// ignored every contract input, while claiming to prove the opposite.

data fixture_work_key: product.fabric.identity.WorkKey = product.fabric.work.derive_work_key(
  contract: fixture_contract,
  requirements: fixture_requirements,
)

fn work_for_principal(p: std.types.NonEmptyStr) -> product.fabric.work.Work<std.types.NonEmptyStr> {
  product.fabric.work.work_for(principal: p, contract: fixture_contract, requirements: fixture_requirements)
}

// A contract differing in ONE semantic input - the source tree - and one
// differing only in a scheduling-irrelevant way are the two controls the
// derivation has to separate.

data other_source_contract: product.fabric.work.WorkContract = product.fabric.work.WorkContract {
  program: "gunbc-required-floor",
  steps: [product.fabric.work.WorkStep { step_id: "floor", resumability: product.fabric.work.ReceiptSatisfiable }],
  source: "sha256:tree-DIFFERENT",
  inputs: "manifest-inputs-1",
  runtime_closure: "toolchain-rust-1.89",
  effect_contract: "effects-read-only",
  output_contract: "outputs-verdict",
}

// Same contract, same capabilities and trust domain, DIFFERENT shape. Before
// the shape fed the digest these derived one key while carrying different
// machine requirements, and fungibility compares shape - so dedup identity and
// matching constraints disagreed about whether two things were the same work.

data bigger_shape_requirements: product.fabric.work.ExecutionRequirements = product.fabric.work.ExecutionRequirements {
  shape: product.fabric.work.Shape { hard: product.fabric.work.HardRequirements { threads: std.measure.hardware_thread_count(64) } },
  capabilities: "linux-arm64",
  trust_domain: "fleet-owned",
}

data other_runtime_requirements: product.fabric.work.ExecutionRequirements = product.fabric.work.ExecutionRequirements {
  shape: fixture_shape,
  capabilities: "linux-amd64",
  trust_domain: "fleet-owned",
}

fn buy_terms(reservation: std.types.Int, ceiling: std.types.Int) -> product.fabric.demand.BuyTerms {
  product.fabric.demand.BuyTerms {
    budget_account: "acct-fleet",
    currency: std.currency.Usd,
    reservation_price: std.measure.money_amount_micro(reservation),
    maximum_buy_order: std.measure.money_amount_micro(ceiling),
  }
}

fn demand_from_binding(
  key: product.fabric.identity.DemandKey,
  provenance: std.types.NonEmptyStr,
  reservation: std.types.Int,
  ceiling: std.types.Int,
) -> product.fabric.demand.Demand<std.types.NonEmptyStr> {
  product.fabric.demand.Demand {
    id: product.fabric.identity.FabricIdentity { principal: "operator", key: key },
    work: product.fabric.identity.FabricIdentity { principal: "operator", key: fixture_work_key },
    origin: provenance,
    submitted_at: "2026-08-18T00:00:00Z",
    admission: product.fabric.demand.AdmissionTerms {
      priority_class: "required-gate",
      deadline: none,
      buy: buy_terms(reservation: reservation, ceiling: ceiling),
    },
    satisfaction: product.fabric.demand.SatisfactionRequirement {
      terminal_receipt_may_satisfy: true,
      new_attempt_required: false,
      step_reuse_permitted: true,
    },
  }
}

data github_binding_demand: product.fabric.demand.Demand<std.types.NonEmptyStr> = demand_from_binding(
  key: "demand-gh-1",
  provenance: "github:pull/8387/head",
  reservation: 500,
  ceiling: 1000,
)

data gitlab_binding_demand: product.fabric.demand.Demand<std.types.NonEmptyStr> = demand_from_binding(
  key: "demand-gl-1",
  provenance: "gitlab:merge_request/42/head",
  reservation: 250,
  ceiling: 400,
)

// The load-bearing claim: two providers, one Work.

test fn two_bindings_project_into_one_work_identity() -> std.types.Bool {
  product.fabric.identity.fabric_identity_key(id: product.fabric.demand.demand_work(d: github_binding_demand))
    == product.fabric.identity.fabric_identity_key(id: product.fabric.demand.demand_work(d: gitlab_binding_demand))
    && github_binding_demand.origin != gitlab_binding_demand.origin
    && product.fabric.identity.fabric_identity_key(id: github_binding_demand.id)
      != product.fabric.identity.fabric_identity_key(id: gitlab_binding_demand.id)
}

// The derivation controls. Without these the test above is satisfied by a key
// that ignores its inputs entirely, which is what an authored constant was.

test fn one_changed_semantic_input_changes_the_work_key() -> std.types.Bool {
  product.fabric.work.derive_work_key(contract: fixture_contract, requirements: fixture_requirements)
    != product.fabric.work.derive_work_key(contract: other_source_contract, requirements: fixture_requirements)
}

// Requirements are part of the promise, not scheduling trivia: work that needs
// a different architecture does not promise the same answer, so it must not
// share a key with work that does.

test fn changed_execution_requirements_change_the_work_key() -> std.types.Bool {
  product.fabric.work.derive_work_key(contract: fixture_contract, requirements: fixture_requirements)
    != product.fabric.work.derive_work_key(contract: fixture_contract, requirements: other_runtime_requirements)
}

// And the direction that matters most for the fabric: identical semantics
// reached through two different providers derive the SAME key, so the
// deduplication the whole design rests on is a property of the function rather
// than of two fixtures happening to be given one constant.

test fn identical_contracts_derive_one_key_regardless_of_who_asked() -> std.types.Bool {
  product.fabric.work.derive_work_key(contract: fixture_contract, requirements: fixture_requirements)
    == product.fabric.work.derive_work_key(
      contract: product.fabric.work.WorkContract {
        program: "gunbc-required-floor",
        steps: [product.fabric.work.WorkStep { step_id: "floor", resumability: product.fabric.work.ReceiptSatisfiable }],
        source: "sha256:tree-abc",
        inputs: "manifest-inputs-1",
        runtime_closure: "toolchain-rust-1.89",
        effect_contract: "effects-read-only",
        output_contract: "outputs-verdict",
      },
      requirements: fixture_requirements,
    )
}

// Cost differs between the two demands while the Work they attach to does not.
// This is the structural form of cost does not enter the work key.

// A machine that cannot run one of them is not an interchangeable executor for
// both, so a differing shape must derive a differing key.

test fn a_different_machine_shape_changes_the_work_key() -> std.types.Bool {
  product.fabric.work.derive_work_key(contract: fixture_contract, requirements: fixture_requirements)
    != product.fabric.work.derive_work_key(contract: fixture_contract, requirements: bigger_shape_requirements)
}

test fn cost_terms_differ_without_forking_work() -> std.types.Bool {
  std.measure.money_amount_micro_count(m: product.fabric.demand.demand_reservation_price(d: github_binding_demand)) == 500
    && std.measure.money_amount_micro_count(m: product.fabric.demand.demand_reservation_price(d: gitlab_binding_demand)) == 250
    && std.measure.money_amount_micro_count(m: product.fabric.demand.demand_maximum_buy_order(d: github_binding_demand)) == 1000
    && (product.fabric.demand.demand_work(d: github_binding_demand).key as std.types.String)
      == (product.fabric.demand.demand_work(d: gitlab_binding_demand).key as std.types.String)
}

// Different principals are different Work, even at an identical contract.

test fn principals_do_not_share_work_identity() -> std.types.Bool {
  let mine = work_for_principal(p: "operator")
  let theirs = work_for_principal(p: "other-tenant")
  (mine.id.key as std.types.String) == (theirs.id.key as std.types.String)
    && (mine.id.principal as std.types.String) != (theirs.id.principal as std.types.String)
}

// An owned offer states zero explicitly; absence is not free.

data owned_offer: product.fabric.supply.Offer<std.types.NonEmptyStr> = product.fabric.supply.Offer {
  id: product.fabric.identity.FabricIdentity { principal: "operator", key: "offer-srv3-slot" },
  executor: "srv3",
  shape: fixture_shape,
  capabilities: "linux-arm64",
  trust_domain: "fleet-owned",
  quantity_bound: 1,
  ready_at: "2026-08-18T00:00:00Z",
  quote: product.fabric.supply.QuotedPerSecond(std.measure.MoneyRate { amount: std.measure.money_amount_micro(0), currency: std.currency.Usd }),
  evidence: product.fabric.supply.ObservedSupply { observed_at: "2026-08-18T00:00:00Z", receipt: "obs-srv3-1" },
}

data rented_offer: product.fabric.supply.Offer<std.types.NonEmptyStr> = product.fabric.supply.Offer {
  id: product.fabric.identity.FabricIdentity { principal: "operator", key: "offer-rented-1" },
  executor: "rented-pool",
  shape: fixture_shape,
  capabilities: "linux-arm64",
  trust_domain: "rented",
  quantity_bound: 64,
  ready_at: "2026-08-18T00:04:00Z",
  quote: product.fabric.supply.QuotedPerSecond(std.measure.MoneyRate { amount: std.measure.money_amount_micro(900), currency: std.currency.Usd }),
  evidence: product.fabric.supply.QuotedSupply {
    quoted_at: "2026-08-18T00:00:00Z",
    valid_until: "2026-08-18T01:00:00Z",
    receipt: "quote-rented-1",
  },
}

test fn owned_supply_states_zero_rather_than_absent() -> std.types.Bool {
  std.measure.money_amount_micro_count(m: product.fabric.supply.offer_quote_amount(q: owned_offer.quote)) == 0
    && std.measure.money_amount_micro_count(m: product.fabric.supply.offer_quote_amount(q: rented_offer.quote)) == 900
    && product.fabric.supply.offer_quote_currency(q: owned_offer.quote) == std.currency.Usd
    && owned_offer.quantity_bound == 1
    && rented_offer.quantity_bound == 64
}

// Observed and quoted supply are one type with two evidences.

test fn observed_and_quoted_supply_share_one_offer_type() -> std.types.Bool {
  match owned_offer.evidence {
    ObservedSupply { observed_at: _, receipt: _ } =>
      match rented_offer.evidence {
        QuotedSupply { quoted_at: _, valid_until: _, receipt: _ } => true
        ObservedSupply { observed_at: _, receipt: _ } => false
      }
    QuotedSupply { quoted_at: _, valid_until: _, receipt: _ } => false
  }
}

// A retry is a new attempt naming its cause, never a mutated old one.

data lease_gen_9: product.fabric.execution.LeaseIdentity = product.fabric.execution.LeaseIdentity {
  lease_key: "lease-attempt-1",
  resource_fingerprint: std.content_hash.content_hash_of_value(value: "srv3-slot-2"),
  generation: 9,
}

data first_attempt: product.fabric.execution.Attempt<std.types.NonEmptyStr> = product.fabric.execution.Attempt {
  id: product.fabric.identity.FabricIdentity { principal: "operator", key: "attempt-1" },
  work: product.fabric.identity.FabricIdentity { principal: "operator", key: fixture_work_key },
  lineage: product.fabric.execution.InitialAttempt {
    initiating_demand: product.fabric.identity.FabricIdentity { principal: "operator", key: "demand-gh-1" },
  },
  created_at: "2026-08-18T00:00:00Z",
}

data retry_attempt: product.fabric.execution.Attempt<std.types.NonEmptyStr> = product.fabric.execution.Attempt {
  id: product.fabric.identity.FabricIdentity { principal: "operator", key: "attempt-2" },
  work: product.fabric.identity.FabricIdentity { principal: "operator", key: fixture_work_key },
  lineage: product.fabric.execution.InfrastructureRetry {
    prior_attempt: product.fabric.identity.FabricIdentity { principal: "operator", key: "attempt-1" },
    cause_receipt: "obs-worker-lost-1",
  },
  created_at: "2026-08-18T00:10:00Z",
}

test fn retry_is_a_new_attempt_naming_its_cause() -> std.types.Bool {
  (first_attempt.id.key as std.types.String) != (retry_attempt.id.key as std.types.String)
    && (first_attempt.work.key as std.types.String) == (retry_attempt.work.key as std.types.String)
    && match retry_attempt.lineage {
      InfrastructureRetry { prior_attempt: prior, cause_receipt: _ } =>
        (prior.key as std.types.String) == (first_attempt.id.key as std.types.String)
      InitialAttempt { initiating_demand: _ } => false
      RequestedReexecution { initiating_demand: _ } => false
    }
}

// A receipt carries the generation it was produced under, so a stale producer is
// distinguishable from a current one.

data stale_receipt: product.fabric.execution.Receipt<std.types.NonEmptyStr> = product.fabric.execution.Receipt {
  id: product.fabric.identity.FabricIdentity { principal: "operator", key: "receipt-1" },
  attempt: product.fabric.identity.FabricIdentity { principal: "operator", key: "attempt-1" },
  lease: product.fabric.execution.LeaseIdentity {
    lease_key: "lease-attempt-1",
    resource_fingerprint: std.content_hash.content_hash_of_value(value: "srv3-slot-2"),
    generation: 8,
  },
  payload: product.fabric.execution.ExecutionReceipt {
    step_id: "floor",
    outputs: std.content_hash.content_hash_of_value(value: "outputs-1"),
    billable: std.measure.second(count: 3600),
    completed_at: "2026-08-18T01:00:00Z",
  },
}

data fixture_grant: product.fabric.execution.ExecutionGrant<std.types.NonEmptyStr> = product.fabric.execution.ExecutionGrant {
  id: product.fabric.identity.FabricIdentity { principal: "operator", key: "grant-1" },
  object: product.fabric.execution.FabricGrantObject { offer: owned_offer.id, quote: owned_offer.quote },
  context: product.fabric.execution.FabricGrantContext {
    demand: github_binding_demand.id,
    work: product.fabric.identity.FabricIdentity { principal: "operator", key: fixture_work_key },
    attempt: first_attempt.id,
    executor: "srv3",
    lease: lease_gen_9,
    issued_at: "2026-08-18T01:00:00Z",
    maximum_liability: std.measure.money_amount_micro(1000000),
  },
  evidence: product.fabric.execution.FabricGrantEvidence {
    fungibility_receipt: "fungibility-1",
    offer_authority: "offer-authority-1",
    resource_conservation: "resource-conservation-1",
    budget_conservation: "budget-conservation-1",
    principal_authority: "principal-authority-1",
  },
  resource_reservations: ["reservation-cpu-1"],
  money_reservation: "reservation-money-1",
}

// The receipt that makes the fence discriminating. It is at the SAME
// generation as the grant and names the same attempt, and differs only in
// which slice of the host it was produced against. A fence comparing
// generations alone accepts it, which is the defect this fixture exists to
// catch: generation is a small integer every lease starts at and increments
// independently, so two unrelated leases share a number almost immediately.

data other_slice_receipt: product.fabric.execution.Receipt<std.types.NonEmptyStr> = product.fabric.execution.Receipt {
  id: product.fabric.identity.FabricIdentity { principal: "operator", key: "receipt-2" },
  attempt: product.fabric.identity.FabricIdentity { principal: "operator", key: "attempt-1" },
  lease: product.fabric.execution.LeaseIdentity {
    lease_key: "lease-attempt-1",
    resource_fingerprint: std.content_hash.content_hash_of_value(value: "srv3-slot-7"),
    generation: 9,
  },
  payload: product.fabric.execution.ExecutionReceipt {
    step_id: "floor",
    outputs: std.content_hash.content_hash_of_value(value: "outputs-2"),
    billable: std.measure.second(count: 3600),
    completed_at: "2026-08-18T01:00:00Z",
  },
}

// Same attempt KEY, different principal. This is the cross-tenant case: two
// tenants naming their attempt identically must not share receipts, and a
// key-only comparison admits this one.

data foreign_principal_receipt: product.fabric.execution.Receipt<std.types.NonEmptyStr> = product.fabric.execution.Receipt {
  id: product.fabric.identity.FabricIdentity { principal: "other-tenant", key: "receipt-4" },
  attempt: product.fabric.identity.FabricIdentity { principal: "other-tenant", key: "attempt-1" },
  lease: lease_gen_9,
  payload: product.fabric.execution.ExecutionReceipt {
    step_id: "floor",
    outputs: std.content_hash.content_hash_of_value(value: "outputs-4"),
    billable: std.measure.second(count: 3600),
    completed_at: "2026-08-18T01:00:00Z",
  },
}

data foreign_attempt_receipt: product.fabric.execution.Receipt<std.types.NonEmptyStr> = product.fabric.execution.Receipt {
  id: product.fabric.identity.FabricIdentity { principal: "operator", key: "receipt-3" },
  attempt: product.fabric.identity.FabricIdentity { principal: "operator", key: "attempt-99" },
  lease: lease_gen_9,
  payload: product.fabric.execution.ExecutionReceipt {
    step_id: "floor",
    outputs: std.content_hash.content_hash_of_value(value: "outputs-3"),
    billable: std.measure.second(count: 3600),
    completed_at: "2026-08-18T01:00:00Z",
  },
}

fn admission_label(r: product.fabric.execution.Receipt<std.types.NonEmptyStr>) -> std.types.NonEmptyStr {
  match product.fabric.execution.admit_receipt_for_grant(r: r, g: fixture_grant) {
    ReceiptAdmissible => "admissible"
    ReceiptFromDifferentLease => "different-lease"
    ReceiptFromDifferentAttempt => "different-attempt"
    ReceiptFingerprintIncomparable => "fingerprint-incomparable"
    ReceiptGenerationStale { presented: _, current: _ } => "generation-stale"
  }
}

// Acceptance must compare the WHOLE lease identity. The three refusals below
// are each reachable only if a different part of that identity is checked:
// generation alone cannot tell same-generation-different-slice from current,
// and cannot tell a foreign attempt from a stale one.

test fn acceptance_compares_lease_identity_not_only_generation() -> std.types.Bool {
  admission_label(r: stale_receipt) == "generation-stale"
    && admission_label(r: other_slice_receipt) == "different-lease"
    && admission_label(r: foreign_attempt_receipt) == "different-attempt"
}

// The cross-tenant control. Identity is the pair, so an attempt key alone is
// not an attempt; a receipt carrying another principal's identically-named
// attempt is refused rather than admitted.

test fn a_receipt_from_another_principal_is_not_the_same_attempt() -> std.types.Bool {
  admission_label(r: foreign_principal_receipt) == "different-attempt"
}

// The positive control. Without it every refusal above is satisfied by an
// admission function that refuses everything.

test fn a_receipt_from_the_granted_lease_is_admissible() -> std.types.Bool {
  match product.fabric.execution.admit_receipt_for_grant(
    r: product.fabric.execution.Receipt {
      id: product.fabric.identity.FabricIdentity { principal: "operator", key: "receipt-ok" },
      attempt: first_attempt.id,
      lease: lease_gen_9,
      payload: product.fabric.execution.ExecutionReceipt {
        step_id: "floor",
        outputs: std.content_hash.content_hash_of_value(value: "outputs-ok"),
        billable: std.measure.second(count: 10),
        completed_at: "2026-08-18T01:00:00Z",
      },
    },
    g: fixture_grant,
  ) {
    ReceiptAdmissible => true
    ReceiptFromDifferentLease => false
    ReceiptFromDifferentAttempt => false
    ReceiptFingerprintIncomparable => false
    ReceiptGenerationStale { presented: _, current: _ } => false
  }
}

// Resumability is declared per step, so a step with opaque effects cannot be
// mistaken for a checkpointable one. The three tiers are discriminated
// SEPARATELY rather than folded to a Bool: "may this be replayed" has three
// answers, and idempotent-under-key differs from opaque-effects in what the
// fabric is permitted to do, so a projection that answered false for both
// would erase the distinction this type exists to carry.

fn resumability_tier_of(step: product.fabric.work.WorkStep) -> std.types.NonEmptyStr {
  match step.resumability {
    ReceiptSatisfiable => "receipt-satisfiable"
    IdempotentUnderKey { idempotency_key: _ } => "idempotent-under-key"
    OpaqueEffects { reason: _ } => "opaque-effects"
  }
}

test fn resumability_is_declared_not_assumed() -> std.types.Bool {
  let satisfiable = resumability_tier_of(step: product.fabric.work.WorkStep {
    step_id: "build",
    resumability: product.fabric.work.ReceiptSatisfiable,
  })
  let idempotent_tier = resumability_tier_of(step: product.fabric.work.WorkStep {
    step_id: "deploy",
    resumability: product.fabric.work.IdempotentUnderKey { idempotency_key: std.content_hash.content_hash_of_value(value: "deploy-1") },
  })
  let opaque = resumability_tier_of(step: product.fabric.work.WorkStep {
    step_id: "arbitrary-shell",
    resumability: product.fabric.work.OpaqueEffects { reason: "foreign workflow step declares no effects" },
  })
  satisfiable == "receipt-satisfiable"
    && idempotent_tier == "idempotent-under-key"
    && opaque == "opaque-effects"
    && idempotent_tier != opaque
}
