module test.claim.fleet_show_effective_read_witness


data live_tree_disposition: LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn per_slot_cap_wire() -> String {
  v1.compiler.emit_core_support.to_string(std.measure.byte_size_count(b: gunbc.ci_floor_measurement.gunbc_ci_runner_cgroup_memory_cap))
}

fn witness_slice_cap_parse_empty_is_absent() -> Bool {
  match extdeps.os.systemd.parse_systemd_memory_limit_show(raw: "") {
    MemoryLimitAbsent => true
    _ => false
  }
}

fn witness_slice_cap_parse_infinity_is_unbounded() -> Bool {
  match extdeps.os.systemd.parse_systemd_memory_limit_show(raw: "infinity") {
    MemoryLimitUnbounded => true
    _ => false
  }
}

fn witness_width_parse_empty_is_absent() -> Bool {
  match gunbc.fleet_show_effective_read.parse_runner_width_active_count(raw: "") {
    Absent => true
    Present { value: _ } => false
  }
}

fn witness_width_parse_count_is_typed() -> Bool {
  match gunbc.fleet_show_effective_read.parse_runner_width_active_count(raw: "10") {
    Present { value: n } => n == 10
    Absent => false
  }
}

fn witness_oom_wire_parses_to_sixty_percent() -> Bool {
  match extdeps.os.oomd.parse_managed_oom_pressure_limit_show(raw: "2576980377") {
    Present { value: gunbc.plans.md_helpers.p } =>
      std.measure.percent_count(p: gunbc.plans.md_helpers.p) == 60
        && extdeps.os.oomd.managed_oom_pressure_limit_wire_matches_percent(
          wire: 2576980377,
          desired: gunbc.oomd_install.gunbc_oomd_sessions_policy.managed_oom_memory_pressure_limit
        )
    Absent => false
  }
}

fn witness_oom_show_value_single_authority() -> Bool {
  extdeps.os.oomd.managed_oom_pressure_limit_show_value(
    p: gunbc.oomd_install.gunbc_oomd_sessions_policy.managed_oom_memory_pressure_limit
  ) == 2576980377
}

fn witness_oom_fixture_converges_to_policy_percent() -> Bool {
  match gunbc.fleet_show_effective_read.oom_pressure_limit_live_read_typed(row: gunbc.fleet_show_effective_read.gunbc_srv1_oom_pressure_limit_fixture_row) {
    Present { value: read } =>
      gunbc.fleet_show_effective_read.oom_pressure_limit_converge_verdict(
        read: read,
        desired: gunbc.oomd_install.gunbc_oomd_sessions_policy.managed_oom_memory_pressure_limit
      ) == gunbc.host_converge.VerdictConverged
    Absent => false
  }
}

fn witness_srv1_slice_cap_infinity_drifts_against_pool_budget() -> Bool {
  let read = gunbc.fleet_show_effective_read.runner_slice_cap_live_read_typed(row: gunbc.fleet_show_effective_read.gunbc_srv1_runner_slice_cap_fixture_row)
  match gunbc.fleet_show_effective_read.slice_property_memory_max_verdict(
    read: read,
    property: extdeps.os.systemd.systemd_memory_max_property,
    expected: gunbc.fleet_host_budget.gunbc_runner_pool_budget,
  ) {
    Present { value: Drifted } => true
    _ => false
  }
}

fn witness_srv2_slice_cap_converges_to_pool_budget() -> Bool {
  let read = gunbc.fleet_show_effective_read.runner_slice_cap_live_read_typed(row: gunbc.fleet_show_effective_read.gunbc_srv2_runner_slice_cap_fixture_row)
  match gunbc.fleet_show_effective_read.slice_property_memory_max_verdict(
    read: read,
    property: extdeps.os.systemd.systemd_memory_max_property,
    expected: gunbc.fleet_host_budget.gunbc_runner_pool_budget,
  ) {
    Present { value: gunbc.host_converge.VerdictConverged } => true
    _ => false
  }
}

fn witness_srv1_01_per_slot_infinity_drifts() -> Bool {
  let read = gunbc.runner_unit_live_read.runner_unit_live_read_typed(row: gunbc.runner_unit_live_read.gunbc_srv1_runner_unit_live_read_fixture)
  let target = gunbc.host_converge.PerSlotMemoryCap {
    dropin_path: gunbc.host_converge.gunbc_runner_per_slot_dropin_path,
    instance_glob: gunbc.host_converge.runner_instance_glob(host: gunbc.fleet_intent_network.operator_host_srv1),
    property: extdeps.os.systemd.systemd_memory_max_property,
    bytes_value: per_slot_cap_wire(),
  }
  match gunbc.runner_unit_live_read.converge_target_live_verdict(read: read, target: target) {
    Present { value: Drifted } => true
    _ => false
  }
}

data srv1_width_drift_note: String = "The 2026-07-03 srv1 snapshot (10 active runner units) CONVERGED against the pre-carve declaration; the 2026-07-11 slot re-carve (16GiB memory.max slots, gunbc.ci_floor_measurement live row) shrank gunbc.fleet_host_budget.declared_runner_count to floor(pool/16GiB) = 5, so the same observation now DRIFTS - and that drift is the real fact: the hosts still run the pre-carve width, the same oversubscription the falsifier exit-137 receipts located. The parse-typing claim above deliberately pins the literal (a parse fixture must not depend on a live-derived count - that fusion is why this witness went latent-red when the re-carve landed). Dissolve-on: a post-re-carve width readback replaces the fixture row and this witness flips back to asserting convergence."

fn witness_srv1_width_drifts_from_declared_count_after_recarve() -> Bool {
  match gunbc.fleet_show_effective_read.runner_width_live_read_typed(row: gunbc.fleet_show_effective_read.gunbc_srv1_runner_width_fixture_row) {
    Present { value: read } =>
      gunbc.fleet_show_effective_read.runner_width_converge_verdict(
        observed: read.active_count,
        desired: gunbc.fleet_host_budget.declared_runner_count()
      ) == gunbc.host_converge.Drifted
    Absent => false
  }
}

fn witness_srv2_width_drifts_from_declared_count() -> Bool {
  match gunbc.fleet_show_effective_read.runner_width_live_read_typed(row: gunbc.fleet_show_effective_read.gunbc_srv2_runner_width_fixture_row) {
    Present { value: read } =>
      gunbc.fleet_show_effective_read.runner_width_converge_verdict(
        observed: read.active_count,
        desired: gunbc.fleet_host_budget.declared_runner_count()
      ) == gunbc.host_converge.Drifted
    Absent => false
  }
}

fn witness_infinity_slice_read_is_read_observed_unbounded() -> Bool {
  match gunbc.fleet_show_effective_read.show_effective_read_from_slice_cap_row(row: gunbc.fleet_show_effective_read.gunbc_srv1_runner_slice_cap_fixture_row) {
    std.realization_reconcile.ReadObserved { value: gunbc.ci_floor_measurement.CapUnbounded } => true
    _ => false
  }
}

fn witness_infinity_slice_read_cannot_converge() -> Bool {
  gunbc.fleet_show_effective_read.show_effective_read_cannot_converge(
    read: gunbc.fleet_show_effective_read.show_effective_read_from_slice_cap_row(row: gunbc.fleet_show_effective_read.gunbc_srv1_runner_slice_cap_fixture_row)
  )
}

fn witness_empty_slice_read_is_read_absent() -> Bool {
  match gunbc.fleet_show_effective_read.show_effective_read_from_slice_cap_row(
    row: gunbc.fleet_show_effective_read.RunnerSliceCapLiveReadRow {
      slice_unit: "system-actions-runner.slice",
      memory_max_raw: "",
      probed_at: "2026-07-03",
    }
  ) {
    std.realization_reconcile.ReadAbsent { reason: _ } => true
    _ => false
  }
}

fn witness_srv1_grounded_receipt_lists_every_fixture_runner_unit() -> Bool {
  match gunbc.fleet_show_effective_read.fixture_srv1_host_effective_read_grounded_receipt() {
    Present { value: r } =>
      gunbc.fleet_show_effective_read.fleet_receipt_unit_count(receipt: r.effective) == 2
        && gunbc.fleet_show_effective_read.fleet_receipt_lists_unit(receipt: r.effective, unit: "actions-runner@srv1-01.service")
        && gunbc.fleet_show_effective_read.fleet_receipt_lists_unit(receipt: r.effective, unit: "actions-runner@srv1-02.service")
        && gunbc.fleet_show_effective_read.grounded_receipt_has_observed_v0_knobs(r: r)
    Absent => false
  }
}

fn witness_srv2_grounded_receipt_lists_every_fixture_runner_unit() -> Bool {
  match gunbc.fleet_show_effective_read.fixture_srv2_host_effective_read_grounded_receipt() {
    Present { value: r } =>
      gunbc.fleet_show_effective_read.fleet_receipt_unit_count(receipt: r.effective) == 2
        && gunbc.fleet_show_effective_read.fleet_receipt_lists_unit(receipt: r.effective, unit: "actions-runner@srv2-01.service")
        && gunbc.fleet_show_effective_read.fleet_receipt_lists_unit(receipt: r.effective, unit: "actions-runner@srv2-02.service")
        && gunbc.fleet_show_effective_read.grounded_receipt_has_observed_v0_knobs(r: r)
    Absent => false
  }
}

fn witness_committed_show_reads_are_fail_closed_absent() -> Bool {
  match gunbc.fleet_show_effective_read.gunbc_fleet_runner_slice_cap_show_effective_read {
    std.realization_reconcile.ReadAbsent { reason: _ } => true
    _ => false
  }
    && match gunbc.fleet_show_effective_read.gunbc_fleet_runner_units_show_effective_read {
      std.realization_reconcile.ReadAbsent { reason: _ } => true
      _ => false
    }
    && match gunbc.fleet_show_effective_read.gunbc_fleet_runner_width_show_effective_read {
      std.realization_reconcile.ReadAbsent { reason: _ } => true
      _ => false
    }
    && match gunbc.fleet_show_effective_read.gunbc_fleet_host_effective_read_show_effective_read {
      std.realization_reconcile.ReadAbsent { reason: _ } => true
      _ => false
    }
}

fn witness_runner_slot_enforcement_committed_is_fail_closed() -> Bool {
  match gunbc.runner_slot_enforcement.gunbc_runner_slot_enforcement_committed(expected_cap: gunbc.ci_floor_measurement.gunbc_ci_runner_cgroup_memory_cap) {
    RunnerSlotEnforced => false
    gunbc.runner_slot_enforcement.RunnerSlotUnenforced { reason: _ } => true
  }
}

fn witness_transport_scripts_are_read_only_systemctl() -> Bool {
  string_contains(s: gunbc.fleet_show_effective_read.fleet_runner_slice_memory_max_read_script(unit: "system-actions-runner.slice"), pattern: "systemctl show")
    && string_contains(s: gunbc.fleet_show_effective_read.fleet_runner_unit_property_read_script(unit: "actions-runner@srv1-01.service", property: extdeps.os.systemd.systemd_memory_max_property), pattern: "systemctl show")
    && string_contains(s: gunbc.fleet_show_effective_read.fleet_runner_width_count_read_script(instance_glob: "actions-runner@srv1-*.service"), pattern: "list-units")
    && !string_contains(s: gunbc.fleet_show_effective_read.fleet_runner_slice_memory_max_read_script(unit: "system-actions-runner.slice"), pattern: "set-property")
}

test fn fleet_show_effective_read_v0_knobs_ground() -> Bool {
  witness_slice_cap_parse_empty_is_absent()
    && witness_slice_cap_parse_infinity_is_unbounded()
    && witness_width_parse_empty_is_absent()
    && witness_width_parse_count_is_typed()
    && witness_oom_wire_parses_to_sixty_percent()
    && witness_oom_show_value_single_authority()
    && witness_oom_fixture_converges_to_policy_percent()
    && witness_srv1_slice_cap_infinity_drifts_against_pool_budget()
    && witness_srv2_slice_cap_converges_to_pool_budget()
    && witness_srv1_01_per_slot_infinity_drifts()
    && witness_srv1_width_drifts_from_declared_count_after_recarve()
    && witness_srv2_width_drifts_from_declared_count()
    && witness_infinity_slice_read_is_read_observed_unbounded()
    && witness_infinity_slice_read_cannot_converge()
    && witness_empty_slice_read_is_read_absent()
    && witness_srv1_grounded_receipt_lists_every_fixture_runner_unit()
    && witness_srv2_grounded_receipt_lists_every_fixture_runner_unit()
    && witness_committed_show_reads_are_fail_closed_absent()
    && witness_runner_slot_enforcement_committed_is_fail_closed()
    && witness_transport_scripts_are_read_only_systemctl()
}
