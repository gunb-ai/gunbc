module test.claim.fleet_show_effective_read_witness

import std.types { Bool, String, NonEmptyStr }
import std.measure { byte_size_count, percent, percent_count }
import extdeps.os.systemd {
  MemoryLimitUnbounded,
  MemoryLimitAbsent,
  parse_systemd_memory_limit_show,
  systemd_memory_max_property,
}
import extdeps.os.oomd {
  parse_managed_oom_pressure_limit_show,
  managed_oom_pressure_limit_show_value,
  managed_oom_pressure_limit_wire_matches_percent,
}
import gunbc.host_converge {
  PerSlotMemoryCap,
  Converged,
  Drifted,
  gunbc_runner_per_slot_dropin_path,
  runner_instance_glob,
}
import gunbc.fleet_host_budget {
  declared_runner_count,
  gunbc_runner_pool_budget,
}
import gunbc.ci_floor_measurement {
  gunbc_ci_runner_cgroup_memory_cap,
  CapUnbounded,
}
import gunbc.fleet_intent_network { operator_host_srv1, operator_host_srv2 }
import gunbc.oomd_install { gunbc_oomd_sessions_policy }
import gunbc.fleet_show_effective_read {
  RunnerSliceCapLiveReadRow,
  gunbc_srv1_runner_slice_cap_fixture_row,
  gunbc_srv2_runner_slice_cap_fixture_row,
  gunbc_srv1_runner_width_fixture_row,
  gunbc_srv2_runner_width_fixture_row,
  gunbc_srv1_oom_pressure_limit_fixture_row,
  gunbc_fleet_runner_slice_cap_show_effective_read,
  gunbc_fleet_runner_units_show_effective_read,
  gunbc_fleet_runner_width_show_effective_read,
  gunbc_fleet_host_effective_read_show_effective_read,
  runner_slice_cap_live_read_typed,
  slice_property_memory_max_verdict,
  parse_runner_width_active_count,
  runner_width_live_read_typed,
  runner_width_converge_verdict,
  oom_pressure_limit_live_read_typed,
  oom_pressure_limit_converge_verdict,
  show_effective_read_from_slice_cap_row,
  show_effective_read_cannot_converge,
  fixture_srv1_host_effective_read_grounded_receipt,
  fixture_srv2_host_effective_read_grounded_receipt,
  fleet_receipt_unit_count,
  fleet_receipt_lists_unit,
  grounded_receipt_has_observed_v0_knobs,
  fleet_runner_slice_memory_max_read_script,
  fleet_runner_unit_property_read_script,
  fleet_runner_width_count_read_script,
}
import gunbc.runner_unit_live_read {
  runner_unit_live_read_typed,
  converge_target_live_verdict,
  gunbc_srv1_runner_unit_live_read_fixture,
}
import gunbc.runner_slot_enforcement {
  RunnerSlotEnforced,
  RunnerSlotUnenforced,
  gunbc_runner_slot_enforcement_committed,
}
import std.realization_reconcile { ReadAbsent, ReadObserved }

fn per_slot_cap_wire() -> String {
  to_string(byte_size_count(b: gunbc_ci_runner_cgroup_memory_cap))
}

fn witness_slice_cap_parse_empty_is_absent() -> Bool {
  match parse_systemd_memory_limit_show(raw: "") {
    MemoryLimitAbsent => true
    _ => false
  }
}

fn witness_slice_cap_parse_infinity_is_unbounded() -> Bool {
  match parse_systemd_memory_limit_show(raw: "infinity") {
    MemoryLimitUnbounded => true
    _ => false
  }
}

fn witness_width_parse_empty_is_absent() -> Bool {
  match parse_runner_width_active_count(raw: "") {
    Absent => true
    Present { value: _ } => false
  }
}

fn witness_width_parse_count_is_typed() -> Bool {
  match parse_runner_width_active_count(raw: "10") {
    Present { value: n } => n == declared_runner_count()
    Absent => false
  }
}

fn witness_oom_wire_parses_to_sixty_percent() -> Bool {
  match parse_managed_oom_pressure_limit_show(raw: "2576980377") {
    Present { value: p } =>
      percent_count(p: p) == 60
        && managed_oom_pressure_limit_wire_matches_percent(
          wire: 2576980377,
          desired: gunbc_oomd_sessions_policy.managed_oom_memory_pressure_limit
        )
    Absent => false
  }
}

fn witness_oom_show_value_single_authority() -> Bool {
  managed_oom_pressure_limit_show_value(
    p: gunbc_oomd_sessions_policy.managed_oom_memory_pressure_limit
  ) == 2576980377
}

fn witness_oom_fixture_converges_to_policy_percent() -> Bool {
  match oom_pressure_limit_live_read_typed(row: gunbc_srv1_oom_pressure_limit_fixture_row) {
    Present { value: read } =>
      oom_pressure_limit_converge_verdict(
        read: read,
        desired: gunbc_oomd_sessions_policy.managed_oom_memory_pressure_limit
      ) == Converged
    Absent => false
  }
}

fn witness_srv1_slice_cap_infinity_drifts_against_pool_budget() -> Bool {
  let read = runner_slice_cap_live_read_typed(row: gunbc_srv1_runner_slice_cap_fixture_row)
  match slice_property_memory_max_verdict(
    read: read,
    property: systemd_memory_max_property,
    expected: gunbc_runner_pool_budget,
  ) {
    Present { value: Drifted } => true
    _ => false
  }
}

fn witness_srv2_slice_cap_converges_to_pool_budget() -> Bool {
  let read = runner_slice_cap_live_read_typed(row: gunbc_srv2_runner_slice_cap_fixture_row)
  match slice_property_memory_max_verdict(
    read: read,
    property: systemd_memory_max_property,
    expected: gunbc_runner_pool_budget,
  ) {
    Present { value: Converged } => true
    _ => false
  }
}

fn witness_srv1_01_per_slot_infinity_drifts() -> Bool {
  let read = runner_unit_live_read_typed(row: gunbc_srv1_runner_unit_live_read_fixture)
  let target = PerSlotMemoryCap {
    dropin_path: gunbc_runner_per_slot_dropin_path,
    instance_glob: runner_instance_glob(host: operator_host_srv1),
    property: systemd_memory_max_property,
    bytes_value: per_slot_cap_wire(),
  }
  match converge_target_live_verdict(read: read, target: target) {
    Present { value: Drifted } => true
    _ => false
  }
}

fn witness_srv1_width_converges_to_declared_count() -> Bool {
  match runner_width_live_read_typed(row: gunbc_srv1_runner_width_fixture_row) {
    Present { value: read } =>
      runner_width_converge_verdict(
        observed: read.active_count,
        desired: declared_runner_count()
      ) == Converged
    Absent => false
  }
}

fn witness_srv2_width_drifts_from_declared_count() -> Bool {
  match runner_width_live_read_typed(row: gunbc_srv2_runner_width_fixture_row) {
    Present { value: read } =>
      runner_width_converge_verdict(
        observed: read.active_count,
        desired: declared_runner_count()
      ) == Drifted
    Absent => false
  }
}

fn witness_infinity_slice_read_is_read_observed_unbounded() -> Bool {
  match show_effective_read_from_slice_cap_row(row: gunbc_srv1_runner_slice_cap_fixture_row) {
    ReadObserved { value: CapUnbounded } => true
    _ => false
  }
}

fn witness_infinity_slice_read_cannot_converge() -> Bool {
  show_effective_read_cannot_converge(
    read: show_effective_read_from_slice_cap_row(row: gunbc_srv1_runner_slice_cap_fixture_row)
  )
}

fn witness_empty_slice_read_is_read_absent() -> Bool {
  match show_effective_read_from_slice_cap_row(
    row: RunnerSliceCapLiveReadRow {
      slice_unit: "system-actions-runner.slice",
      memory_max_raw: "",
      probed_at: "2026-07-03",
    }
  ) {
    ReadAbsent { reason: _ } => true
    _ => false
  }
}

fn witness_srv1_grounded_receipt_lists_every_fixture_runner_unit() -> Bool {
  match fixture_srv1_host_effective_read_grounded_receipt() {
    Present { value: r } =>
      fleet_receipt_unit_count(receipt: r.effective) == 2
        && fleet_receipt_lists_unit(receipt: r.effective, unit: "actions-runner@srv1-01.service")
        && fleet_receipt_lists_unit(receipt: r.effective, unit: "actions-runner@srv1-02.service")
        && grounded_receipt_has_observed_v0_knobs(r: r)
    Absent => false
  }
}

fn witness_srv2_grounded_receipt_lists_every_fixture_runner_unit() -> Bool {
  match fixture_srv2_host_effective_read_grounded_receipt() {
    Present { value: r } =>
      fleet_receipt_unit_count(receipt: r.effective) == 2
        && fleet_receipt_lists_unit(receipt: r.effective, unit: "actions-runner@srv2-01.service")
        && fleet_receipt_lists_unit(receipt: r.effective, unit: "actions-runner@srv2-02.service")
        && grounded_receipt_has_observed_v0_knobs(r: r)
    Absent => false
  }
}

fn witness_committed_show_reads_are_fail_closed_absent() -> Bool {
  match gunbc_fleet_runner_slice_cap_show_effective_read {
    ReadAbsent { reason: _ } => true
    _ => false
  }
    && match gunbc_fleet_runner_units_show_effective_read {
      ReadAbsent { reason: _ } => true
      _ => false
    }
    && match gunbc_fleet_runner_width_show_effective_read {
      ReadAbsent { reason: _ } => true
      _ => false
    }
    && match gunbc_fleet_host_effective_read_show_effective_read {
      ReadAbsent { reason: _ } => true
      _ => false
    }
}

fn witness_runner_slot_enforcement_committed_is_fail_closed() -> Bool {
  match gunbc_runner_slot_enforcement_committed(expected_cap: gunbc_ci_runner_cgroup_memory_cap) {
    RunnerSlotEnforced => false
    RunnerSlotUnenforced { reason: _ } => true
  }
}

fn witness_transport_scripts_are_read_only_systemctl() -> Bool {
  string_contains(s: fleet_runner_slice_memory_max_read_script(unit: "system-actions-runner.slice"), pattern: "systemctl show")
    && string_contains(s: fleet_runner_unit_property_read_script(unit: "actions-runner@srv1-01.service", property: systemd_memory_max_property), pattern: "systemctl show")
    && string_contains(s: fleet_runner_width_count_read_script(instance_glob: "actions-runner@srv1-*.service"), pattern: "list-units")
    && !string_contains(s: fleet_runner_slice_memory_max_read_script(unit: "system-actions-runner.slice"), pattern: "set-property")
}

test fn fleet_show_effective_read_v0_knobs_ground() -> Bool {
  witness_slice_cap_parse_empty_is_absent()
    && witness_slice_cap_parse_infinity_is_unbounded()
    && witness_width_parse_empty_is_absent()
    && witness_width_parse_count_is_typed()
    && witness_oom_wire_parses_to_sixty_percent()
    && witness_oom_show_value_single_authority()
    && witness_oom_fixture_converges_to_policy_percent()
    && witness_srv1_slice_cap_infinity_drifts_against_pool_budget()
    && witness_srv2_slice_cap_converges_to_pool_budget()
    && witness_srv1_01_per_slot_infinity_drifts()
    && witness_srv1_width_converges_to_declared_count()
    && witness_srv2_width_drifts_from_declared_count()
    && witness_infinity_slice_read_is_read_observed_unbounded()
    && witness_infinity_slice_read_cannot_converge()
    && witness_empty_slice_read_is_read_absent()
    && witness_srv1_grounded_receipt_lists_every_fixture_runner_unit()
    && witness_srv2_grounded_receipt_lists_every_fixture_runner_unit()
    && witness_committed_show_reads_are_fail_closed_absent()
    && witness_runner_slot_enforcement_committed_is_fail_closed()
    && witness_transport_scripts_are_read_only_systemctl()
}
