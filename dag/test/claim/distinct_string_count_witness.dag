module test.claim.distinct_string_count_witness

import gunbc.guarantee_measurement { distinct_string_count }

// Does gunbc.guarantee_measurement distinct_string_count count DISTINCT strings, on every route? Its step
// once read append(acc, [v]), which std.algebra declares as append(xs, ELEMENT) and the seed interpreter
// ran as concat; the duplicate case is the discriminating input and the distinct case the control.
test fn distinct_string_count_collapses_a_duplicate() -> Bool {
  distinct_string_count(values: ["a", "a"]) == 1
}

test fn distinct_string_count_keeps_distinct_values() -> Bool {
  distinct_string_count(values: ["a", "b"]) == 2
}
