module test.claim.namespace_structural_observations_closing_contract_witness

import gunbc.namespace_structural_observations {
  ordinary_compile_structural_closing_contract_holds,
  OrdinaryCompileStructuralObservationsProduced,
  OrdinaryCompileStructuralObservationsUnavailable,
  OrdinaryCompileStructuralObservationsRefused,
}
import std.occurrence_identity { OccurrenceId }
import std.reference_binding_observation {
  ReferenceBindingObservation,
  StructuralBindingResolution,
  StructuralBindingProductionRefused,
  ReferenceBindingParserTransportRefused,
  SameFileNeighbourObservation,
  SiblingBranchObservation,
  LaterDeclarationObservation,
  DistinctHomonymObservation,
}
import std.types { Bool, List, NonEmptyStr }

data namespace_structural_observations_closing_contract_witness_note: String = "Discriminating controls for ordinary_compile_structural_closing_contract_holds Produced arm — synthetic statuses only, no parser or compile seam. Positive: all four N3-A structural clause shapes. RED: empty list and four drop-one omissions prove each include_* fold keys on its own variant."

fn n3_a_stub_resolution() -> StructuralBindingResolution {
  StructuralBindingProductionRefused {
    gap: ReferenceBindingParserTransportRefused,
  }
}

fn n3_a_clause_fixture_observations() -> List<ReferenceBindingObservation> {
  [
    SameFileNeighbourObservation {
      neighbour: OccurrenceId { value: 1 },
      resolution: n3_a_stub_resolution(),
    },
    SiblingBranchObservation {
      own_branch_declaration: OccurrenceId { value: 2 },
      sibling_branch_declaration: OccurrenceId { value: 3 },
      resolution: n3_a_stub_resolution(),
    },
    LaterDeclarationObservation {
      later_declaration: OccurrenceId { value: 4 },
      resolution: n3_a_stub_resolution(),
    },
    DistinctHomonymObservation {
      first_declaration: OccurrenceId { value: 5 },
      second_declaration: OccurrenceId { value: 6 },
      resolution: n3_a_stub_resolution(),
    },
  ]
}

fn n3_a_observations_without_same_file_neighbour() -> List<ReferenceBindingObservation> {
  [
    SiblingBranchObservation {
      own_branch_declaration: OccurrenceId { value: 2 },
      sibling_branch_declaration: OccurrenceId { value: 3 },
      resolution: n3_a_stub_resolution(),
    },
    LaterDeclarationObservation {
      later_declaration: OccurrenceId { value: 4 },
      resolution: n3_a_stub_resolution(),
    },
    DistinctHomonymObservation {
      first_declaration: OccurrenceId { value: 5 },
      second_declaration: OccurrenceId { value: 6 },
      resolution: n3_a_stub_resolution(),
    },
  ]
}

fn n3_a_observations_without_sibling_branch() -> List<ReferenceBindingObservation> {
  [
    SameFileNeighbourObservation {
      neighbour: OccurrenceId { value: 1 },
      resolution: n3_a_stub_resolution(),
    },
    LaterDeclarationObservation {
      later_declaration: OccurrenceId { value: 4 },
      resolution: n3_a_stub_resolution(),
    },
    DistinctHomonymObservation {
      first_declaration: OccurrenceId { value: 5 },
      second_declaration: OccurrenceId { value: 6 },
      resolution: n3_a_stub_resolution(),
    },
  ]
}

fn n3_a_observations_without_later_declaration() -> List<ReferenceBindingObservation> {
  [
    SameFileNeighbourObservation {
      neighbour: OccurrenceId { value: 1 },
      resolution: n3_a_stub_resolution(),
    },
    SiblingBranchObservation {
      own_branch_declaration: OccurrenceId { value: 2 },
      sibling_branch_declaration: OccurrenceId { value: 3 },
      resolution: n3_a_stub_resolution(),
    },
    DistinctHomonymObservation {
      first_declaration: OccurrenceId { value: 5 },
      second_declaration: OccurrenceId { value: 6 },
      resolution: n3_a_stub_resolution(),
    },
  ]
}

fn n3_a_observations_without_distinct_homonym() -> List<ReferenceBindingObservation> {
  [
    SameFileNeighbourObservation {
      neighbour: OccurrenceId { value: 1 },
      resolution: n3_a_stub_resolution(),
    },
    SiblingBranchObservation {
      own_branch_declaration: OccurrenceId { value: 2 },
      sibling_branch_declaration: OccurrenceId { value: 3 },
      resolution: n3_a_stub_resolution(),
    },
    LaterDeclarationObservation {
      later_declaration: OccurrenceId { value: 4 },
      resolution: n3_a_stub_resolution(),
    },
  ]
}

test fn witness_produced_all_four_clauses_closing_contract_holds() -> Bool {
  ordinary_compile_structural_closing_contract_holds(
    status: OrdinaryCompileStructuralObservationsProduced {
      observations: n3_a_clause_fixture_observations(),
    },
  )
}

test fn witness_produced_empty_observations_closing_contract_reds() -> Bool {
  !ordinary_compile_structural_closing_contract_holds(
    status: OrdinaryCompileStructuralObservationsProduced {
      observations: [],
    },
  )
}

test fn witness_produced_without_same_file_neighbour_closing_contract_reds() -> Bool {
  !ordinary_compile_structural_closing_contract_holds(
    status: OrdinaryCompileStructuralObservationsProduced {
      observations: n3_a_observations_without_same_file_neighbour(),
    },
  )
}

test fn witness_produced_without_sibling_branch_closing_contract_reds() -> Bool {
  !ordinary_compile_structural_closing_contract_holds(
    status: OrdinaryCompileStructuralObservationsProduced {
      observations: n3_a_observations_without_sibling_branch(),
    },
  )
}

test fn witness_produced_without_later_declaration_closing_contract_reds() -> Bool {
  !ordinary_compile_structural_closing_contract_holds(
    status: OrdinaryCompileStructuralObservationsProduced {
      observations: n3_a_observations_without_later_declaration(),
    },
  )
}

test fn witness_produced_without_distinct_homonym_closing_contract_reds() -> Bool {
  !ordinary_compile_structural_closing_contract_holds(
    status: OrdinaryCompileStructuralObservationsProduced {
      observations: n3_a_observations_without_distinct_homonym(),
    },
  )
}

test fn witness_unavailable_status_closing_contract_reds() -> Bool {
  !ordinary_compile_structural_closing_contract_holds(
    status: OrdinaryCompileStructuralObservationsUnavailable {
      trigger: "synthetic unavailable control" as NonEmptyStr,
    },
  )
}

test fn witness_refused_status_closing_contract_reds() -> Bool {
  !ordinary_compile_structural_closing_contract_holds(
    status: OrdinaryCompileStructuralObservationsRefused {
      cause: "synthetic refused control" as NonEmptyStr,
    },
  )
}
