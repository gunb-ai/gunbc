test fn rest_200_uninhabiting_root_refuses_instead_of_answering_with_null() -> Bool {
  let result = evaluate_in_witness_frame(
    frame: replay_frame(fixtures: [fixture_for(
      operation: "RootArray",
      observation: RestResponseObserved {
        status: 200
        body: RestBodyRead { body: "{\"pulls\":null}" }
      }
    )]),
    subject: fn(_scope) {
      match test.RestReplay.RootArray() {
        RestRefused { refusal: RestResponseDecodeRefused { status, field_path, coproduct, vocabulary, received_bytes, parse_line, parse_column } } => {
          let located = match field_path {
            Present { value: f } => f as String
            Absent => ""
          }
          let bytes = match received_bytes {
            Present { value: n } => n
            Absent => -1
          }
          status == 200
            && rest_decode_vocabulary_text(v: vocabulary) == "field-was-null"
            && string_contains(s: located, pattern: "pulls")
            && bytes == 14
        }
        RestAnswered { answer: _ } => false
        _ => false
      }
    }
  )
  match result {
    WitnessReturned { value } => value
    WitnessRefused { diagnostic } => false
    WitnessInterrupted { at: _, route: _, state: _ } => false
  }
}

test fn rest_200_missing_keyed_field_refuses_instead_of_answering_with_null() -> Bool {
  let result = evaluate_in_witness_frame(
    frame: replay_frame(fixtures: [fixture_for(
      operation: "Observe",
      observation: RestResponseObserved {
        status: 200
        body: RestBodyRead { body: "{\"other\":\"accepted\"}" }
      }
    )]),
    subject: fn(_scope) {
      match test.RestReplay.Observe() {
        RestRefused { refusal: RestResponseDecodeRefused { status, field_path, coproduct, vocabulary, received_bytes, parse_line, parse_column } } => {
          let located = match field_path {
            Present { value: f } => f as String
            Absent => ""
          }
          let bytes = match received_bytes {
            Present { value: n } => n
            Absent => -1
          }
          status == 200
            // This fixture fails in the type-directed decoder, not at a null, so the reason is the
            // decoder's own and the located path is whatever it could establish; both are pinned by the
            // claims above and below, where they are verified. What this claim owns is the shape of the
            // refusal: a 200 whose body did not inhabit the output arrives as the typed arm, naming some
            // reason out of the closed vocabulary, instead of answering with a hole.
            && rest_decode_vocabulary_text(v: vocabulary) != ""
            && bytes == 19
        }
        RestAnswered { answer: _ } => false
        _ => false
      }
    }
  )
  match result {
    WitnessReturned { value } => value
    WitnessRefused { diagnostic } => false
    WitnessInterrupted { at: _, route: _, state: _ } => false
  }
}

