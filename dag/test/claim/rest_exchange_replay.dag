// THE RESPONSE THAT A PUBLISH DEPENDS ON INHABITS THE DECLARED TYPE. This is the counter-evidence to
// the report it refused: the bytes GitHub served for pull request 16122 decode into PullRequest, with
// the fields the publish boundary reads (number, state, head.ref) at their recorded values. A decoder
// that refused them would go red here, and the publish path's own refusal would then name the field.
test fn the_recorded_pull_request_response_a_publish_depends_on_inhabits_pull_request() -> Bool {
  match evaluate_in_witness_frame(
    frame: replay_frame(fixtures: [fixture_for(
      operation: "PullGetPage",
      observation: RestResponseObserved { status: 200, body: RestBodyRead { body: pull_16122_response } }
    )]),
    subject: fn(_scope) {
      match test.RestReplay.PullGetPage() {
        RestAnswered { answer } => answer.pr.number == 16122
          && answer.pr.head.ref == "equality-admission-repair"
          && answer.pr.base.ref == "main"
        RestRefused { refusal: _ } => false
      }
    }
  ) {
    WitnessReturned { value } => value
    WitnessRefused { diagnostic: _ } => false
    WitnessInterrupted { at: _, route: _, state: _ } => false
  }
}

// A REFUSAL OF A PULL-REQUEST READ NAMES THE FIELD THAT REFUSED, IN THE LINE THE PUBLISH STEP PRINTS.
// The publish path withholds a response body and a transport cause (gunbc.heal_publication
// rest_refusal_text): it runs with a credential in hand and the text reaches stderr. What it must not
// withhold is the model's own account of which declared field the response did not inhabit -- before
// extdeps.transports.rest RestResponseDecodeRefused existed, that account was flattened into
// the free-text cause of RestBodyUndecodable and went with it, and a run that could not read its own pull
// request reported "status 200 undecodable" with no way to recover the field from the run.
test fn the_publish_line_for_a_pull_read_that_breaks_the_declared_shape_names_the_field() -> Bool {
  match evaluate_in_witness_frame(
    frame: replay_frame(fixtures: [fixture_for(
      operation: "PullGetPage",
      observation: RestResponseObserved {
        status: 200, body: RestBodyRead { body: pull_16122_response_with_unestablished_author }
      }
    )]),
    subject: fn(_scope) {
      match test.RestReplay.PullGetPage() {
        RestRefused { refusal: RestResponseDecodeRefused { status, field_path, coproduct, vocabulary, received_bytes, parse_line, parse_column } } => {
          let located = match field_path { Present { value: f } => f as String  Absent => "" }
          let named = match coproduct { Present { value: c } => c as String  Absent => "" }
          status == 200 && named == "UserType"
            && rest_decode_vocabulary_text(v: vocabulary) == "unknown-spelling"
            && string_contains(s: located, pattern: "user.type")
            && string_contains(s: rest_refusal_text(o: RestResponseDecodeRefused {
                 status: status, field_path: field_path, coproduct: coproduct, vocabulary: vocabulary
                 received_bytes: received_bytes, parse_line: parse_line, parse_column: parse_column }),
                 pattern: "pr.user.type")
        }
        RestRefused { refusal: _ } => false
        RestAnswered { answer: _ } => false
      }
    }
  ) {
    WitnessReturned { value } => value
    WitnessRefused { diagnostic: _ } => false
    WitnessInterrupted { at: _, route: _, state: _ } => false
  }
}
