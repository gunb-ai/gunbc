}

test fn rest_unreadable_body_is_not_fabricated_empty() -> Bool {
  let result = evaluate_in_witness_frame(
    frame: replay_frame(fixtures: [fixture_for(
      operation: "Observe",
      observation: RestResponseObserved {
        status: 401
        body: RestBodyReadRefused { cause: "truncated response body" }
      }
    )]),
    subject: fn(_scope) {
      match test.RestReplay.Observe() {
        RestRefused { refusal: RestResponseDecodeRefused { status, field_path, coproduct, vocabulary, received_bytes, parse_line, parse_column } } =>
          status == 401
            && rest_decode_vocabulary_text(v: vocabulary) == "body-not-utf8"
            // Nothing was established about the body: it never finished being read, so no name, no
            // count and no parser position may be claimed for it.
            && (match field_path { Absent => true, Present { value: _ } => false })
            && (match coproduct { Absent => true, Present { value: _ } => false })
            && (match received_bytes { Absent => true, Present { value: _ } => false })
            && (match parse_line { Absent => true, Present { value: _ } => false })
        _ => false
      }
    }
  )
  match result {
    WitnessReturned { value } => value
    WitnessRefused { diagnostic } => false
    WitnessInterrupted { at: _, route: _, state: _ } => false
  }
}

test fn rest_replay_missing_fixture_refuses_without_network_fallback() -> Bool {
  let result = evaluate_in_witness_frame(
    frame: replay_frame(fixtures: []),
    subject: fn(_scope) { test.RestReplay.Observe() }
  )
  match result {
    WitnessReturned { value } => false
    WitnessRefused { diagnostic } => string_contains(
      s: witness_diagnostic_rendered_reason(diagnostic: diagnostic),
      pattern: "missing exact REST replay fixture"
    )
    WitnessInterrupted { at: _, route: _, state: _ } => false
  }
}

// Field-default path 2 (the #16196 follow-up). The SAME zero-fixture op-route, but the claim is
// about the refusal TEXT, not only that it refused. RestReplayExchangeAbsent carries the
// host-computed bound invocation; until the seed renders `invocation.target` the reason is a bare
// TypeError naming no bound value. This asserts the refusal names the target the op-route actually
// bound at the real service declaration — https://rest-replay.invalid/answer — so path 2's bound
// value is observable at the refusal. On a seed that drops the invocation the target half fails;
// that base-versus-head contrast is the executed reading quick-newt-573 runs, and #16185's explicit
// Jwt fields become removable only once the head half passes.
test fn rest_replay_missing_fixture_refusal_names_the_bound_target() -> Bool {
  let result = evaluate_in_witness_frame(
    frame: replay_frame(fixtures: []),
    subject: fn(_scope) { test.RestReplay.Observe() }
  )
  match result {
    WitnessReturned { value } => false
    WitnessRefused { diagnostic } => string_contains(
      s: witness_diagnostic_rendered_reason(diagnostic: diagnostic),
      pattern: "missing exact REST replay fixture"
    ) && string_contains(
      s: witness_diagnostic_rendered_reason(diagnostic: diagnostic),
      pattern: "https://rest-replay.invalid/answer"
    )
    WitnessInterrupted { at: _, route: _, state: _ } => false
  }
}

test fn rest_replay_duplicate_exact_fixture_refuses() -> Bool {
  let fixture = fixture_for(operation: "Observe", observation: denied_observation())
  let result = evaluate_in_witness_frame(
