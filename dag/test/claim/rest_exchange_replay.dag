// TYPE-DIRECTED RESPONSE DECODE. A nullary coproduct field is decoded through its declared wire
// contract (extdeps.github.workflow_runs_contracts), so the recorded spelling becomes the arm.
data decoded_run_list_body: String = "{\"total_count\":1,\"workflow_runs\":[{\"id\":34853888826,\"name\":\"witnesses\",\"path\":\".github/workflows/witnesses.yml\",\"head_sha\":\"a8d4fdeb1c2c971fcf9b17614d80e75c63f07d50\",\"head_branch\":\"gh-readonly-queue/main/pr-11256-74627165a69024b49b4069f25ac285c9abdade5d\",\"event\":\"merge_group\",\"status\":\"completed\",\"conclusion\":\"success\",\"workflow_id\":335117115,\"run_number\":19305,\"run_attempt\":1,\"actor\":{\"login\":\"briansrls\",\"id\":11205878,\"type\":\"User\"},\"triggering_actor\":{\"login\":\"briansrls\",\"id\":11205878,\"type\":\"User\"},\"html_url\":\"https://github.com/gunb-ai/gunbc/actions/runs/34853888826\",\"created_at\":\"2026-09-14T14:10:32Z\",\"updated_at\":\"2026-09-14T15:00:21Z\",\"pull_requests\":[]}]}"

// One character of the recorded body changed: "success" -> "succeeded", a spelling that names no
// WorkflowRunConclusion arm under SnakeCase. It refuses at the located field rather than carrying
// the string into a match that would take its wildcard arm.
data misspelled_conclusion_body: String = "{\"total_count\":1,\"workflow_runs\":[{\"id\":34853888826,\"name\":\"witnesses\",\"path\":\".github/workflows/witnesses.yml\",\"head_sha\":\"a8d4fdeb1c2c971fcf9b17614d80e75c63f07d50\",\"head_branch\":\"gh-readonly-queue/main/pr-11256-74627165a69024b49b4069f25ac285c9abdade5d\",\"event\":\"merge_group\",\"status\":\"completed\",\"conclusion\":\"succeeded\",\"workflow_id\":335117115,\"run_number\":19305,\"run_attempt\":1,\"actor\":{\"login\":\"briansrls\",\"id\":11205878,\"type\":\"User\"},\"triggering_actor\":{\"login\":\"briansrls\",\"id\":11205878,\"type\":\"User\"},\"html_url\":\"https://github.com/gunb-ai/gunbc/actions/runs/34853888826\",\"created_at\":\"2026-09-14T14:10:32Z\",\"updated_at\":\"2026-09-14T15:00:21Z\",\"pull_requests\":[]}]}"

fn first_run_completed_successfully(runs: WorkflowRunList) -> Bool {
  match runs.workflow_runs |> first {
    Present { value: run } => match run.status {
      Completed => match run.conclusion {
        Present { value: Success } => true
        _ => false
      }
      _ => false
    }
    none => false
  }
}

fn run_list_frame(body: String) -> WitnessEvaluationFrame<Unit> {
  replay_frame(fixtures: [
    fixture_for(operation: "WorkflowRunsPage", observation: RestResponseObserved { status: 200, body: RestBodyRead { body: body } }),
  ])
}

test fn a_contracted_coproduct_field_decodes_to_its_arm() -> Bool {
  match evaluate_in_witness_frame(frame: run_list_frame(body: decoded_run_list_body), subject: fn(_scope) {
    match test.RestReplay.WorkflowRunsPage() {
      RestAnswered { answer } => first_run_completed_successfully(runs: answer.runs)
      RestRefused { refusal: _ } => false
    }
  }) {
    WitnessReturned { value } => value
    WitnessRefused { diagnostic: _ } => false
    WitnessInterrupted { at: _, route: _, state: _ } => false
  }
}

test fn an_unknown_spelling_refuses_at_the_located_field() -> Bool {
  match evaluate_in_witness_frame(frame: run_list_frame(body: misspelled_conclusion_body), subject: fn(_scope) {
    match test.RestReplay.WorkflowRunsPage() {
      RestRefused { refusal: RestResponseDecodeRefused { status, field_path, coproduct, vocabulary, received_bytes, parse_line, parse_column } } => {
        let located = match field_path {
          Present { value: f } => f as String
          Absent => ""
        }
        let named = match coproduct {
          Present { value: c } => c as String
          Absent => ""
        }
        status == 200
          && string_contains(s: located, pattern: "conclusion")
          && named == "WorkflowRunConclusion"
          && rest_decode_vocabulary_text(v: vocabulary) == "unknown-spelling"
          // The account names WHERE and WHY without carrying a witness to the body: the spelling that
          // broke the vocabulary never reaches the line a run would print.
          && !string_contains(s: rest_refusal_text(o: RestResponseDecodeRefused {
               status: status, field_path: field_path, coproduct: coproduct, vocabulary: vocabulary
               received_bytes: received_bytes, parse_line: parse_line, parse_column: parse_column
             }), pattern: "succeeded")
      }
      _ => false
    }
  }) {
    WitnessReturned { value } => value
    WitnessRefused { diagnostic: _ } => false
    WitnessInterrupted { at: _, route: _, state: _ } => false
  }
}

// NO LENIENT ARM FOR AN UNDECLARED SPELLING. The string "Alpha" is exactly an arm's authored name,
// so a decoder that guessed AsAuthored would accept it; the coproduct has no contract and its module
// declares no wire_contract, so it refuses.
test fn a_coproduct_with_no_declared_wire_spelling_refuses_even_an_authored_match() -> Bool {
  let result = evaluate_in_witness_frame(
    frame: replay_frame(fixtures: [fixture_for(
      operation: "RootUncontracted",
      observation: RestResponseObserved { status: 200, body: RestBodyRead { body: "{\"arm\":\"Alpha\"}" } }
    )]),
    subject: fn(_scope) {
      match test.RestReplay.RootUncontracted() {
        RestRefused { refusal: RestResponseDecodeRefused { status, field_path, coproduct, vocabulary, received_bytes, parse_line, parse_column } } => {
          let located = match field_path {
            Present { value: f } => f as String
            Absent => ""
          }
          let named = match coproduct {
            Present { value: c } => c as String
            Absent => ""
          }
          status == 200
            && located == "shape.arm"
            && named == "UncontractedArm"
            && rest_decode_vocabulary_text(v: vocabulary) == "no-wire-contract"
        }
        _ => false
      }
    }
  )
  match result {
    WitnessReturned { value } => value
    WitnessRefused { diagnostic: _ } => false
    WitnessInterrupted { at: _, route: _, state: _ } => false
  }
}

// THE TYPED RESPONSE FORMAT IS HONOURED (gunbc.recurring_failure_mode
// response_format_variant_silently_read_as_json). RED before the fix: the interpreter read
// response_format only as a string literal, so `response_format: Text` fell back to Json and this
// plain-text body answered RestResponseDecodeRefused at status 200.
test fn a_text_response_format_reads_a_plain_body_as_text() -> Bool {
  let result = evaluate_in_witness_frame(
    frame: replay_frame(fixtures: [fixture_for(
      operation: "TextBody",
      observation: RestResponseObserved { status: 200, body: RestBodyRead { body: "diff --git a/x b/x\n+plain text, not JSON" } }
    )]),
    subject: fn(_scope) {
      match test.RestReplay.TextBody() {
        RestAnswered { answer } => answer.text == "diff --git a/x b/x\n+plain text, not JSON"
        RestRefused { refusal: _ } => false
      }
    }
  )
  match result {
    WitnessReturned { value } => value
    WitnessRefused { diagnostic } => false
    WitnessInterrupted { at: _, route: _, state: _ } => false
  }
}

// ANY OTHER SPELLING REFUSES. The quoted string is the one that used to be the only working
// spelling in the interpreter and was read as Json by emitted code; now neither realization
// can take it, and the interpreter says so instead of guessing.
test fn an_unrecognized_response_format_refuses_rather_than_defaulting_to_json() -> Bool {
  let result = evaluate_in_witness_frame(
    frame: replay_frame(fixtures: [fixture_for(
      operation: "FormatUnrecognized",
      observation: RestResponseObserved { status: 200, body: RestBodyRead { body: "plain" } }
    )]),
    subject: fn(_scope) { test.RestReplay.FormatUnrecognized() }
  )
  match result {
    WitnessReturned { value } => false
    WitnessRefused { diagnostic } => contains(witness_diagnostic_rendered_reason(diagnostic: diagnostic), "response_format must be a std.serialization WireFormat variant")
    WitnessInterrupted { at: _, route: _, state: _ } => false
  }
}

// A REST-DECODED Bool? IS MATCHED THROUGH ITS PRESENT ARM (gunbc.recurring_failure_mode
// optional_bool_payload_read_as_a_native_arm). An optional REST output field is carried raw
// (value-or-Null); the interpreter's host-bool pattern arm answered Present/Absent against a raw
// Bool as a native True/False arm and missed, so gunbc.auth.gcp_iam_bootstrap
// bootstrap_operator_matches crashed with `PatternMatchFailure { value: "true" }` at the
// probe-authority stage on a real Google userinfo body. These replay that route: the decoded field
// is carried into extdeps.auth.oidc OidcStandardClaims exactly as iam_bootstrap_operator_readback
// does, then matched exactly as bootstrap_operator_matches does.
fn verified_flag_frame(body: String) -> WitnessEvaluationFrame<Unit> {
  replay_frame(fixtures: [
    fixture_for(operation: "VerifiedFlag", observation: RestResponseObserved { status: 200, body: RestBodyRead { body: body } }),
  ])
}

fn decoded_email_verified_reads(body: String, expected: Bool) -> Bool {
  match evaluate_in_witness_frame(frame: verified_flag_frame(body: body), subject: fn(_scope) {
    match test.RestReplay.VerifiedFlag() {
      RestAnswered { answer } => {
        let claims = OidcStandardClaims { picture: Absent, email: none, email_verified: answer.verified, name: none }
        match claims.email_verified { Present { value: v } => v == expected  Absent => false }
      }
      RestRefused { refusal: _ } => false
    }
  }) {
    WitnessReturned { value } => value
    WitnessRefused { diagnostic: _ } => false
    WitnessInterrupted { at: _, route: _, state: _ } => false
  }
}

// RED before the fix: both refused non-exhaustive on the raw payload.
test fn a_decoded_optional_bool_true_reads_through_its_present_arm() -> Bool {
  decoded_email_verified_reads(body: "{\"verified\":true}", expected: true)
}

test fn a_decoded_optional_bool_false_reads_through_its_present_arm() -> Bool {
  decoded_email_verified_reads(body: "{\"verified\":false}", expected: false)
}

// Controls: a null field takes the Absent arm, and a constructed Present was never affected.
// The absent value is an explicit JSON null: a body MISSING the key refuses as RestResponseDecodeRefused
// under the declared response type, which is a decode fact, not this match.
// THE ARM A REPLAY OF THE REAL BYTES CANNOT PRODUCE. A 200 whose body stops mid-object is a complete
// read of a partial response: the transport got every byte it was going to get, and the JSON parser
// stopped where the bytes stopped. This is the failure a heal-publish run sees when the same pull
// request decodes fine an hour later, so the refusal has to say how many bytes arrived and where
// parsing gave up -- both established by the realization, neither a byte of the body.
test fn a_truncated_200_body_names_itself_as_not_json_with_the_bytes_that_arrived() -> Bool {
  let result = evaluate_in_witness_frame(
    frame: replay_frame(fixtures: [fixture_for(
      operation: "Observe",
      observation: RestResponseObserved {
        status: 200
        body: RestBodyRead { body: "{\"state\":\"Open\"" }
      }
    )]),
    subject: fn(_scope) {
      match test.RestReplay.Observe() {
        RestRefused { refusal: RestResponseDecodeRefused { status, field_path, coproduct, vocabulary, received_bytes, parse_line, parse_column } } => {
          let bytes = match received_bytes {
            Present { value: n } => n
            Absent => -1
          }
          let stopped = match parse_line {
            Present { value: _ } => match parse_column {
              Present { value: _ } => true
              Absent => false
            }
            Absent => false
          }
          status == 200
            && rest_decode_vocabulary_text(v: vocabulary) == "body-not-json"
            && bytes == 15
            && stopped
            // The parser stopped at the shape, not at a declared field, so no field or coproduct is named.
            && (match field_path { Absent => true, Present { value: _ } => false })
            && (match coproduct { Absent => true, Present { value: _ } => false })
        }
        RestAnswered { answer: _ } => false
        _ => false
      }
    }
  )
  match result {
    WitnessReturned { value } => value
    WitnessRefused { diagnostic } => false
    WitnessInterrupted { at: _, route: _, state: _ } => false
  }
}

test fn a_decoded_absent_optional_bool_takes_its_absent_arm() -> Bool {
  match evaluate_in_witness_frame(frame: verified_flag_frame(body: "{\"verified\":null}"), subject: fn(_scope) {
    match test.RestReplay.VerifiedFlag() {
      RestAnswered { answer } => {
        let claims = OidcStandardClaims { picture: Absent, email: none, email_verified: answer.verified, name: none }
        match claims.email_verified { Present { value: _ } => false  Absent => true }
      }
      RestRefused { refusal: _ } => false
    }
  }) {
    WitnessReturned { value } => value
    WitnessRefused { diagnostic: _ } => false
    WitnessInterrupted { at: _, route: _, state: _ } => false
  }
}

test fn a_constructed_present_bool_reads_through_its_present_arm() -> Bool {
  let claims = OidcStandardClaims { picture: Absent, email: none, email_verified: Present { value: true }, name: none }
  match claims.email_verified { Present { value: v } => v  Absent => false }
}

// A JSON string does not inhabit the declared Bool: it refuses at the located field, typed, and
// never reaches a match.
test fn the_text_true_under_a_declared_bool_refuses_at_decode() -> Bool {
  match evaluate_in_witness_frame(frame: verified_flag_frame(body: "{\"verified\":\"true\"}"), subject: fn(_scope) {
    match test.RestReplay.VerifiedFlag() {
      RestRefused { refusal: RestResponseDecodeRefused { status, field_path, coproduct, vocabulary, received_bytes, parse_line, parse_column } } => {
        let located = match field_path {
          Present { value: f } => f as String
          Absent => ""
        }
        status == 200
          // As above: the reason and the located name belong to the decoder for this fixture, and are
          // verified in the claims that pin them. This claim owns that a String where a Bool is declared
          // is refused as the typed arm rather than answered.
          && rest_decode_vocabulary_text(v: vocabulary) != ""
      }
      _ => false
    }
  }) {
    WitnessReturned { value } => value
    WitnessRefused { diagnostic: _ } => false
    WitnessInterrupted { at: _, route: _, state: _ } => false
  }
}


