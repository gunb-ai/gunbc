  }) == "declaration_index_digest"
}

// COMPLETENESS, EXERCISED IN BOTH DIRECTIONS BECAUSE ONE DIRECTION IS NOT A LAW.
//
// The outcome vocabulary here is a two-arm test type, not X's. That is the type parameter earning
// its keep: the join is about WHICH occurrences were answered for, never about what the answer
// said, so it can be proven without the producer existing and without a stub pretending to be one.
//
// WHY BOTH ARMS ARE NECESSARY. A join that only checked for missing rows passes an observation
// that answers for occurrences belonging to some other subject -- right count, wrong identities,
// and it reads as success. A join that only checked for foreign rows passes an observation that
// silently drops the occurrences the producer found inconvenient, which is the failure the whole
// denominator discipline exists to prevent. Each arm below goes green only if its own direction is
// checked, and neither is reachable by a comparison of counts: the missing and foreign fixtures
// both carry exactly as many rows as the expected list has entries.
type LboTestOutcome
  = LboTestAnswered
  | LboTestRefused

fn lbo_row(id: Int) -> LegacyBindingObservationRow<LboTestOutcome> {
  LegacyBindingObservationRow { occurrence: OccurrenceId { value: id }, outcome: LboTestRefused }
}

fn lbo_observation(ids: List<Int>) -> LegacyBindingObservation<LboTestOutcome> {
  LegacyBindingObservation { subject: lbo_base_subject(), rows: ids |> map(id => lbo_row(id: id)) }
}

fn lbo_expected() -> List<Int> {
  [11, 22, 33]
}

test fn an_observation_answering_exactly_the_expected_occurrences_is_complete() -> Bool {
  match legacy_observation_completeness(observation: lbo_observation(ids: [11, 22, 33]), expected: lbo_expected()) {
    LegacyObservationComplete => true
    LegacyObservationMissingExpected { occurrences: _ } => false
    LegacyObservationForeignObserved { occurrences: _ } => false
    LegacyObservationRepeatedObserved { occurrences: _ } => false
  }
}

// THE ROW COUNT IS THREE ON BOTH SIDES AND THE JOIN STILL REFUSES. That is the whole difference
// between an identity join and a count equality, stated as a fixture rather than as a claim.
test fn an_observation_missing_one_expected_occurrence_refuses() -> Bool {
  match legacy_observation_completeness(observation: lbo_observation(ids: [11, 22, 99]), expected: lbo_expected()) {
    LegacyObservationMissingExpected { occurrences: missing } => (missing |> count) == 1
    LegacyObservationComplete => false
    LegacyObservationForeignObserved { occurrences: _ } => false
    LegacyObservationRepeatedObserved { occurrences: _ } => false
  }
}

test fn an_observation_answering_for_a_non_subject_occurrence_refuses() -> Bool {
  match legacy_observation_completeness(observation: lbo_observation(ids: [11, 22, 33, 44]), expected: lbo_expected()) {
    LegacyObservationForeignObserved { occurrences: foreign } => (foreign |> count) == 1
    LegacyObservationComplete => false
    LegacyObservationMissingExpected { occurrences: _ } => false
    LegacyObservationRepeatedObserved { occurrences: _ } => false
  }
}

// A WHOLLY-REFUSED OBSERVATION IS COMPLETE, AND THIS ARM IS WHY THAT IS NOT A CRISIS.
//
// Both sides of the completeness law come from the DENOMINATOR -- the expected list and the row
// keys -- and neither comes from the producer. So an observation whose every row is a production
// refusal is complete, applicable and true, which is exactly what a correct O_X(B) contains on
// today's legacy resolver: measured, X carries zero exact declaration identities to its decision,
// so every row is absent-at-decision. The next reader of an all-refused artifact will assume it is
// broken; this arm is the standing answer that it is not.
test fn an_observation_whose_every_row_is_refused_is_still_complete() -> Bool {
  match legacy_observation_completeness(observation: lbo_observation(ids: [11, 22, 33]), expected: lbo_expected()) {
    LegacyObservationComplete => true
    LegacyObservationMissingExpected { occurrences: _ } => false
    LegacyObservationForeignObserved { occurrences: _ } => false
    LegacyObservationRepeatedObserved { occurrences: _ } => false
  }
}

// ONE OCCURRENCE, ONE OUTCOME -- AND MEMBERSHIP ALONE DOES NOT SAY SO.
//
// This fixture has every expected occurrence present and no foreign one, so a two-direction
// membership check calls it complete while the artifact carries two outcomes for occurrence 11.
// That is the grain confusion the row type warns about arriving through the completeness law: an
// unreconciled producer hands over attempt-grain rows and, without this arm, they pass. Found by
// review 56288 on the first cut of this module.
test fn an_observation_answering_twice_for_one_occurrence_refuses() -> Bool {
  match legacy_observation_completeness(observation: lbo_observation(ids: [11, 11, 22, 33]), expected: lbo_expected()) {
    LegacyObservationRepeatedObserved { occurrences: repeated } => (repeated |> count) == 1
    LegacyObservationComplete => false
    LegacyObservationMissingExpected { occurrences: _ } => false
    LegacyObservationForeignObserved { occurrences: _ } => false
  }
}

// THE FIELD HALF OF THE RESOLVER REFERENCE MOVES THE COMPARISON, and it must also move the content
// address -- review 56288 and review 56285 both found the asymmetry, from opposite ends. The arm
// below is the comparison half; legacy_subject_identity now folds the field, so the two cannot
// disagree about whether these are the same base.
test fn a_moved_resolver_field_refuses() -> Bool {
  let base = lbo_base_subject()
  lbo_diverged_field(other: LegacyBindingObservationSubject {
    semantic_source_digest: base.semantic_source_digest,
    source_set_digest: base.source_set_digest,
    compiler_artifact_digest: base.compiler_artifact_digest,
    resolver_identity: decl_field_ref(module_path: "std.occurrence_identity", decl_name: "OccurrenceId", field_name: "value"),
    resolver_policy: base.resolver_policy,
    occurrence_transport_digest: base.occurrence_transport_digest,
    declaration_index_digest: base.declaration_index_digest
  }) == "resolver_identity.field"
}

// AND THE ADDRESS MOVES WITH IT. This is the arm that would have caught the original defect: two
// subjects differing only in the resolver reference's field are refused by the comparison AND carry
// different content addresses. Either alone is satisfiable by the asymmetry the reviews found.
test fn a_moved_resolver_field_also_moves_the_content_address() -> Bool {
  let base = lbo_base_subject()
  let other = LegacyBindingObservationSubject {
    semantic_source_digest: base.semantic_source_digest,
    source_set_digest: base.source_set_digest,
    compiler_artifact_digest: base.compiler_artifact_digest,
    resolver_identity: decl_field_ref(module_path: "std.occurrence_identity", decl_name: "OccurrenceId", field_name: "value"),
    resolver_policy: base.resolver_policy,
    occurrence_transport_digest: base.occurrence_transport_digest,
    declaration_index_digest: base.declaration_index_digest
  }
  legacy_subject_identity(subject: base).digest != legacy_subject_identity(subject: other).digest
}

// THE INJECTIVITY WITNESS, PER FIELD OVER ALL NINE INPUTS.
//
// The applicability arms are per-field on the stated grounds that a comparison reading eight of nine
// fields must be impossible to write. That argument applies with equal force to the ADDRESS, and on
// the first cut of this module it was not applied: the fold read seven of the nine inputs, and
// nothing here would have noticed. Two reviews found it from opposite ends within minutes of each
// other -- which is the honest reason these arms exist, and the reason a covered function's sibling
// being uncovered is worth treating as a defect rather than as missing polish.
//
// NINE INPUTS, NOT EIGHT: the resolver reference contributes three (module path, declaration name,
// field), so the identity fold has one more input than the subject has fields.
fn lbo_address_moves(other: LegacyBindingObservationSubject) -> Bool {
  legacy_subject_identity(subject: lbo_base_subject()).digest != legacy_subject_identity(subject: other).digest
}

fn lbo_with_semantic_source(d: Fnv1a64Structural) -> LegacyBindingObservationSubject {
  let b = lbo_base_subject()
  LegacyBindingObservationSubject {
    semantic_source_digest: d,
    source_set_digest: b.source_set_digest,
    compiler_artifact_digest: b.compiler_artifact_digest,
    resolver_identity: b.resolver_identity,
    resolver_policy: b.resolver_policy,
    occurrence_transport_digest: b.occurrence_transport_digest,
    declaration_index_digest: b.declaration_index_digest
  }
}

