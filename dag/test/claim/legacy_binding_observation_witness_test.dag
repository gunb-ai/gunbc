module test.claim.legacy_binding_observation_witness

import std.types { String, Bool, Int, List, NonEmptyStr }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.content_hash { Fnv1a64Structural, structural_content_hash }
import std.decl_ref { DeclarationRef, WholeDeclaration, NamedField, decl_ref, decl_field_ref }
import std.occurrence_identity { OccurrenceId }
import v2.workflow.legacy_binding_observation {
  LegacyResolutionPolicy,
  LegacyBindingObservation,
  LegacyBindingObservationRow,
  LegacyBindingObservationSubject,
  LegacyResolutionPolicy,
  ImportScopedPolicy,
  NamespaceOnlyPolicy,
  LegacyObservationCompleteness,
  LegacyObservationComplete,
  LegacyObservationMissingExpected,
  LegacyObservationForeignObserved,
  LegacyObservationRepeatedObserved,
  LegacySubjectApplicability,
  LegacySubjectApplicable,
  LegacySubjectDiverged,
  legacy_subject_applicability,
  legacy_observation_completeness,
  legacy_subject_identity,
  decl_field_label
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE APPLICABILITY WALL, EXERCISED FIELD BY FIELD.
//
// An observation is evidence about the base it was taken on. The wall that says so is only a wall
// if EVERY identity field can move it -- a subject comparison that checked six of eight fields
// would answer "applicable" across a base that differs in the seventh, and the whole point of a
// content-addressed subject is that no such gap exists.
//
// SO THE EXERCISES ARE PER FIELD, NOT ONE REPRESENTATIVE. A single "some field differs" arm is
// satisfiable by a comparison that only reads that one field, which is exactly the failure being
// guarded against; eight arms, each moving one field and holding the rest fixed, cannot be
// satisfied by anything less than a total comparison. The RED is reachable for every one of them:
// deleting any branch from legacy_subject_applicability turns its arm green-to-applicable, which
// is the wrong answer rather than a missing one.
//
// THESE ARE SUBSTRATE INPUTS ONLY, and that is the honest declaration rather than a convenience.
// Every subject here is hand-constructed and the function under test is a pure fold over it.
// Nothing calls a producer, because there is no producer yet: the tap that observes X's decisions
// is a separate authority under a separate owner, and standing a stub in for it here would be a
// second, lying authority for the one fact this module deliberately does not own.
fn lbo_digest(label: String) -> Fnv1a64Structural {
  structural_content_hash(digest: label)
}

// THE FIXTURE'S RESOLVER REFERENCE NAMES A RECORD TYPE RATHER THAN THE RESOLVER FUNCTION, and that
// is a deliberate choice about the arms below rather than a claim about what X actually is. Every
// divergence arm must perturb EXACTLY ONE axis of the compared identity, and the reason is stronger
// than picking the wrong population: a two-axis perturbation cannot discriminate WHICH axis the
// comparison reads, so its green is the same green whether the second axis is folded into the
// identity or not. It is permanently green by construction -- the decoration DESIGN section 4b calls
// worse than absent, reached from the multiplicity direction rather than the unauthorable-RED one.
// The general rule, which outlives this fixture: ANY divergence arm perturbing more than one axis of
// a compared identity is uninformative by construction.
//
// So a single-axis module move needs one declared name living in two modules, and a single-axis
// field move needs one of those declarations to carry a field. `OccurrenceId` satisfies both:
// `std.occurrence_identity` and `std.observation` each declare it and the former carries `value`.
// NO UNIQUENESS IS CLAIMED FOR IT, and an earlier revision of this annotation claimed exactly that
// -- "the only pair in the corpus" -- which was false when written: a census over `dag`, `src/v1`
// and `src/v2` at `90bfcfad293` found 47 names declared in two or more modules with at least one
// declaration carrying a field. The first measurement that produced the claim searched two roots
// and compared only adjacent rows of a sort, so it was a property of the search, not of the corpus.
// 47 against 1 is not a near miss, it is the signature of a census whose denominator was its own
// search, and the adjacent-rows filter names the mechanism: it can only ever surface PAIRS, never a
// name declared three or more times, so it was blind by construction to the widest members of the
// very population it was counting. A claim false at authorship is also worse than one that rotted,
// because a rotted claim has a moment in the tree that justified it and a re-measurement disagrees
// cleanly; this one has no such moment anywhere, so re-measuring it looks like a regression someone
// introduced and the next reader spends their time hunting for the change that broke it.
// The claim is not repaired by bounding it to a SHA, because the fixture never needed it: what the
// arms need is that THIS pair holds, and that is self-checking rather than censused -- the citation
// wall refuses this module if either declaration or the field stops existing, so the arms cannot go
// quietly green over a reference that has rotted. A second qualifying pair appearing changes
// nothing here.
//
// The resolver identity the production subject carries is a decision surface such as
// `v1.compiler.infer_env` `lookup_binding_by_name`; nothing in the envelope depends on which.
fn lbo_resolver() -> DeclarationRef {
  decl_ref(module_path: "std.occurrence_identity", decl_name: "OccurrenceId")
}

fn lbo_base_subject() -> LegacyBindingObservationSubject {
  LegacyBindingObservationSubject {
    semantic_source_digest: lbo_digest(label: "1111111111111111"),
    source_set_digest: lbo_digest(label: "2222222222222222"),
    compiler_artifact_digest: lbo_digest(label: "3333333333333333"),
    resolver_identity: lbo_resolver(),
    resolver_policy: ImportScopedPolicy,
    occurrence_transport_digest: lbo_digest(label: "4444444444444444"),
    declaration_index_digest: lbo_digest(label: "5555555555555555")
  }
}

fn lbo_diverged_field(other: LegacyBindingObservationSubject) -> String {
  match legacy_subject_applicability(left: lbo_base_subject(), right: other) {
    LegacySubjectDiverged { field: f } => f
    LegacySubjectApplicable => ""
  }
}

// THE POSITIVE CONTROL, AND IT IS NOT DECORATION. Without it every arm below is satisfied by a
// comparison that refuses unconditionally, which would be a wall that admits nothing -- useless in
// the opposite direction and just as wrong.
test fn an_identical_subject_is_applicable_to_itself() -> Bool {
  match legacy_subject_applicability(left: lbo_base_subject(), right: lbo_base_subject()) {
    LegacySubjectApplicable => true
    LegacySubjectDiverged { field: _ } => false
  }
}

test fn a_moved_semantic_source_digest_refuses() -> Bool {
  let base = lbo_base_subject()
  lbo_diverged_field(other: LegacyBindingObservationSubject {
    semantic_source_digest: lbo_digest(label: "aaaaaaaaaaaaaaaa"),
    source_set_digest: base.source_set_digest,
    compiler_artifact_digest: base.compiler_artifact_digest,
    resolver_identity: base.resolver_identity,
    resolver_policy: base.resolver_policy,
    occurrence_transport_digest: base.occurrence_transport_digest,
    declaration_index_digest: base.declaration_index_digest
  }) == "semantic_source_digest"
}

