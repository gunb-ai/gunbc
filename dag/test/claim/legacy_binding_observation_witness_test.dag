fn lbo_with_resolver(reference: DeclarationRef) -> LegacyBindingObservationSubject {
  let b = lbo_base_subject()
  LegacyBindingObservationSubject {
    semantic_source_digest: b.semantic_source_digest,
    source_set_digest: b.source_set_digest,
    compiler_artifact_digest: b.compiler_artifact_digest,
    resolver_identity: reference,
    resolver_policy: b.resolver_policy,
    occurrence_transport_digest: b.occurrence_transport_digest,
    declaration_index_digest: b.declaration_index_digest
  }
}

fn lbo_with_policy(policy: LegacyResolutionPolicy) -> LegacyBindingObservationSubject {
  let b = lbo_base_subject()
  LegacyBindingObservationSubject {
    semantic_source_digest: b.semantic_source_digest,
    source_set_digest: b.source_set_digest,
    compiler_artifact_digest: b.compiler_artifact_digest,
    resolver_identity: b.resolver_identity,
    resolver_policy: policy,
    occurrence_transport_digest: b.occurrence_transport_digest,
    declaration_index_digest: b.declaration_index_digest
  }
}

test fn the_content_address_is_stable_for_an_unchanged_subject() -> Bool {
  legacy_subject_identity(subject: lbo_base_subject()).digest == legacy_subject_identity(subject: lbo_base_subject()).digest
}

test fn every_identity_input_moves_the_content_address() -> Bool {
  lbo_address_moves(other: lbo_with_semantic_source(d: lbo_digest(label: "aaaaaaaaaaaaaaaa")))
    && lbo_address_moves(other: lbo_with_source_set(d: lbo_digest(label: "bbbbbbbbbbbbbbbb")))
    && lbo_address_moves(other: lbo_with_artifact(d: lbo_digest(label: "cccccccccccccccc")))
    && lbo_address_moves(other: lbo_with_transport(d: lbo_digest(label: "dddddddddddddddd")))
    && lbo_address_moves(other: lbo_with_decl_index(d: lbo_digest(label: "eeeeeeeeeeeeeeee")))
    && lbo_address_moves(other: lbo_with_resolver(reference: decl_ref(module_path: "std.observation", decl_name: "OccurrenceId")))
    && lbo_address_moves(other: lbo_with_resolver(reference: decl_ref(module_path: "std.occurrence_identity", decl_name: "OccurrenceIdAllocator")))
    && lbo_address_moves(other: lbo_with_resolver(reference: decl_field_ref(module_path: "std.occurrence_identity", decl_name: "OccurrenceId", field_name: "value")))
    && lbo_address_moves(other: lbo_with_policy(policy: NamespaceOnlyPolicy))
}

// THE COLLISION THE OTHER NINE ARMS CANNOT SEE, because it needs two subjects differing only in the
// DeclField ARM with the payload chosen to impersonate the nullary arm's label. Everything else
// about these two subjects is identical, and decl_field_eq reports them different, so an address
// that collided here would be the comparison and the address disagreeing -- the same defect the
// field fold was added to fix, one level down inside the fix.
test fn a_field_name_cannot_impersonate_the_whole_declaration_arm() -> Bool {
  decl_field_label(field: WholeDeclaration) != decl_field_label(field: NamedField { field_name: "whole_declaration" as NonEmptyStr })
}
