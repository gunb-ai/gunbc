// THE RESOLVER IDENTITY IS THE FIELD MOST LIKELY TO BE THOUGHT REDUNDANT WITH THE ARTIFACT DIGEST,
// and it is not: one binary contains several decision surfaces, so an observation of one of them is
// not evidence about another even though both were compiled from the same bytes. All three axes of
// the reference move it, which is why there are three arms.
test fn a_moved_resolver_module_refuses() -> Bool {
  let base = lbo_base_subject()
  lbo_diverged_field(other: LegacyBindingObservationSubject {
    semantic_source_digest: base.semantic_source_digest,
    source_set_digest: base.source_set_digest,
    compiler_artifact_digest: base.compiler_artifact_digest,
    resolver_identity: decl_ref(module_path: "std.observation", decl_name: "OccurrenceId"),
    resolver_policy: base.resolver_policy,
    occurrence_transport_digest: base.occurrence_transport_digest,
    declaration_index_digest: base.declaration_index_digest
  }) == "resolver_identity.module_path"
}

test fn a_moved_resolver_declaration_refuses() -> Bool {
  let base = lbo_base_subject()
  lbo_diverged_field(other: LegacyBindingObservationSubject {
    semantic_source_digest: base.semantic_source_digest,
    source_set_digest: base.source_set_digest,
    compiler_artifact_digest: base.compiler_artifact_digest,
    resolver_identity: decl_ref(module_path: "std.occurrence_identity", decl_name: "OccurrenceIdAllocator"),
    resolver_policy: base.resolver_policy,
    occurrence_transport_digest: base.occurrence_transport_digest,
    declaration_index_digest: base.declaration_index_digest
  }) == "resolver_identity.decl_name"
}

// THE POLICY ARM IS THE ONE THIS ENVELOPE CANNOT DERIVE, which is exactly why it must be able to
// refuse over it: the gate is a host thread-local no substrate program can read, so the producer
// states it and this comparison is the only thing standing between an ImportScoped observation and
// a NamespaceOnly one being treated as the same evidence. Same bytes, same sources, same resolver,
// different answers.
test fn a_moved_resolution_policy_refuses() -> Bool {
  let base = lbo_base_subject()
  lbo_diverged_field(other: LegacyBindingObservationSubject {
    semantic_source_digest: base.semantic_source_digest,
    source_set_digest: base.source_set_digest,
    compiler_artifact_digest: base.compiler_artifact_digest,
    resolver_identity: base.resolver_identity,
    resolver_policy: NamespaceOnlyPolicy,
    occurrence_transport_digest: base.occurrence_transport_digest,
    declaration_index_digest: base.declaration_index_digest
  }) == "resolver_policy"
}

