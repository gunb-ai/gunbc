module test.claim.materialized_secret_seal_witness

import std.types { Bool, Int, String }
import gunbc.compile_census_probe { blocking_subject_census, census_delta_verdict, census_verdict, census_verdict_all, total_blocking_census, census_exit}
import gunbc.compile_diagnostic_census { CompileDiagnosticCensus }
import std.process { ProcessExit }

// A MATERIALIZED SECRET ENTERS ONLY THROUGH ITS BRACKET. gunbc.auth.materialized_secret
// MaterializedSecret is sole_constructor, so a module that wants the handle without the bracket's
// existence and liveness checks has to spell the record, and that spelling is a located compile
// refusal. The one other constructor in the defining module, the widen sketch the red control
// executes, is sealed by admit_callers to that witness, so calling it from anywhere else is an
// admission refusal. Each RED asserts EXACTLY ONE refusal on its subject; the GREEN asserts that a
// foreign module using the bracket draws ZERO refusals on either subject (a census that did not run
// answers -1, never 0) and adds no blocking diagnostic of its own, so the seals refuse the forgeries
// and not the legitimate route. The census counts the whole compile, imported closure included
// (gunbc.compile_diagnostic_census CompileDiagnosticCensus), so "of its own" is a comparison with a
// baseline module importing the same closure and doing nothing, never a total against zero.

fn seal_violations(source: String, subject: String) -> CompileDiagnosticCensus {
  blocking_subject_census(source: source, wanted_class: "SoleConstructorViolation", wanted_subject: subject)
}

fn admission_refusals(source: String, callee: String) -> CompileDiagnosticCensus {
  blocking_subject_census(source: source, wanted_class: "ConstructorCallAdmissionRefused", wanted_subject: callee)
}

data forged_handle_source: String = "module probe_materialized_secret_forged_handle\nimport extdeps.cloud.gcp.secret_ref { SecretRef }\nimport gunbc.auth.materialized_secret { MaterializedSecret, StdinPassword }\nfn forged(r: SecretRef) -> MaterializedSecret {\n  MaterializedSecret { ref: r, binding: StdinPassword }\n}\n"

data foreign_sketch_call_source: String = "module probe_materialized_secret_sketch_call\nimport std.types { Int }\nimport extdeps.cloud.gcp.secret_ref { SecretRef }\nimport extdeps.cloud.gcp.secret_manager { SmEnabled }\nimport gunbc.auth.materialized_secret { MaterializationOutcome, StdinPassword, materialize_existence_only_widen_sketch }\nfn widened(r: SecretRef) -> MaterializationOutcome<Int> {\n  materialize_existence_only_widen_sketch(ref: r, binding: StdinPassword, existence: SmEnabled, use: fn(m) { 1 })\n}\n"

data bracket_user_source: String = "module probe_materialized_secret_bracket_user\nimport std.types { Int }\nimport extdeps.cloud.gcp.secret_ref { SecretRef }\nimport extdeps.cloud.gcp.secret_manager { SmEnabled }\nimport gunbc.auth.materialized_secret { MaterializationOutcome, StdinPassword, github_app_jwt_mint_probe, with_materialized_secret }\nfn bracketed(r: SecretRef) -> MaterializationOutcome<Int> {\n  with_materialized_secret(ref: r, binding: StdinPassword, existence: SmEnabled, probe: github_app_jwt_mint_probe, liveness_observation: none, use: fn(m) { 1 })\n}\n"

test fn a_forged_materialized_secret_literal_is_refused_at_compile() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: forged_handle_source, subject: "MaterializedSecret"), holds: fn(n) { n == 1 }))
}

test fn a_foreign_call_to_the_widen_sketch_is_an_admission_refusal() -> ProcessExit {
  census_exit(census_verdict(census: admission_refusals(source: foreign_sketch_call_source, callee: "materialize_existence_only_widen_sketch"), holds: fn(n) { n == 1 }))
}

data closure_baseline_source: String = "module probe_materialized_secret_closure_baseline\nimport extdeps.cloud.gcp.secret_ref { SecretRef }\nimport extdeps.cloud.gcp.secret_manager { SmEnabled }\nimport gunbc.auth.materialized_secret { SecretBinding, StdinPassword }\nfn baseline(r: SecretRef) -> SecretBinding {\n  StdinPassword\n}\n"

test fn a_foreign_bracket_user_is_refused_by_neither_seal() -> ProcessExit {
  census_verdict_all(verdicts: [
    census_verdict(census: seal_violations(source: bracket_user_source, subject: "MaterializedSecret"), holds: fn(n) { n == 0 }),
    census_verdict(census: admission_refusals(source: bracket_user_source, callee: "materialize_existence_only_widen_sketch"), holds: fn(n) { n == 0 }),
    // THE LEGALITY THE OLD `baseline >= 0` CONJUNCT EXISTED TO CHECK: the baseline had to have RUN,
    // and now says so itself instead of leaking a sentinel into an equality.
    census_verdict(census: total_blocking_census(source: closure_baseline_source), holds: fn(n) { true }),
    census_delta_verdict(red: total_blocking_census(source: bracket_user_source), control: total_blocking_census(source: closure_baseline_source), holds: fn(n) { n == 0 }),
  ])
}
