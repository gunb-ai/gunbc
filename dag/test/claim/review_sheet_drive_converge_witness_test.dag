module test.claim.review_sheet_drive_converge_witness

import std.types { NonEmptyStr, String, List, Bool }
import std.upsert_decision { UpsertDecision, Noop, Apply, Refuse }
import gunbc.ensure { EnsurePolicy, EnsureObserveOnly, EnsureMayApply }
import extdeps.cloud.gcp.gcp { ServiceAccountEmail }
import extdeps.google.drive {
  DrivePermission,
  DrivePermissionList,
  DriveFile,
  DriveFileList,
  DrivePermissionRole,
  RoleOrganizer,
  RoleFileOrganizer,
  RoleWriter,
  RoleReader,
  drive_permission_role_wire,
  google_sheet_mime_type,
  drive_token_env,
}
import gunbc.review_sheet_drive_converge {
  DriveMembershipObservation,
  MembershipObserved,
  MembershipAbsent,
  MembershipUnreadable,
  MembershipGrantPlan,
  membership_from_permissions,
  ensure_drive_membership,
  ReviewSpreadsheetObservation,
  SheetObservedOne,
  SheetAbsent,
  SheetDuplicated,
  SheetSearchIncomplete,
  SheetSearchUnreadable,
  spreadsheet_from_file_list,
  ensure_review_spreadsheet,
  review_sheet_search_query,
  review_sheet_marker_property_key,
}

// EVERY CLAIM HERE SUPPLIES ITS INPUTS AT ONE BOUNDARY -- a Drive response shape -- rather than
// reaching a live Drive to obtain one. That is the point: these are claims about what the FOLD
// decides for a given response, and executing the transport to get one would pay for a network
// round trip per assertion while testing something else. The pairing obligation is discharged by
// the operations' own declared response arms in extdeps.google.drive, and the inhabitance claim
// that Drive really emits these shapes is the live converge run, which is a separate receipt and
// is not claimed here.

fn w_writer() -> ServiceAccountEmail {
  "review-sheet-writer@gunbai-sheets.iam.gserviceaccount.com" as ServiceAccountEmail
}

fn w_drive() -> NonEmptyStr {
  "0ANpu9VSqUzO-Uk9PVA" as NonEmptyStr
}

fn w_permission(email: String, role: DrivePermissionRole) -> DrivePermission {
  DrivePermission {
    id: "perm-fixture",
    emailAddress: Present { value: email },
    role: drive_permission_role_wire(r: role),
    type: "user"
  }
}

fn w_file(id: String) -> DriveFile {
  DriveFile {
    id: id,
    name: "CI prospect sheet",
    mimeType: google_sheet_mime_type as String,
    properties: none
  }
}

// AN UNREAD FIELD IS NOT AN EMPTY ONE, and this is the discriminating case: if the absent
// permissions field folded to MembershipAbsent, a converge would create a permission for a writer
// that may already be a member, against a response it never actually read.
test fn absent_permissions_field_is_unreadable_not_absent() -> Bool {
  match membership_from_permissions(
    list: DrivePermissionList { permissions: none, nextPageToken: none },
    writer: w_writer(),
  ) {
    MembershipUnreadable { reason: r } => string_contains(s: r as String, pattern: "not an empty one")
    MembershipAbsent => false
    MembershipPageIncomplete { next_page_token: _ } => false
    MembershipObserved { role: _ } => false
  }
}

// An empty list IS an absence -- the field was read and carried no rows. Paired with the claim
// above so the two are held apart rather than one standing for both.
test fn empty_permission_list_is_absence() -> Bool {
  match membership_from_permissions(
    list: DrivePermissionList { permissions: Present { value: [] }, nextPageToken: none },
    writer: w_writer(),
  ) {
    MembershipAbsent => true
    MembershipPageIncomplete { next_page_token: _ } => false
    MembershipUnreadable { reason: _ } => false
    MembershipObserved { role: _ } => false
  }
}

// A role this model cannot read is not an absent member either. The writer IS there; creating a
// second permission would not change its role, so absence would authorize a pointless write and
// hide a principal we failed to understand.
test fn writer_present_with_unmodeled_role_is_unreadable() -> Bool {
  match membership_from_permissions(
    list: DrivePermissionList {
      permissions: Present {
        value: [
          DrivePermission {
            id: "perm-fixture",
            emailAddress: Present { value: w_writer() as String },
            role: "fileEditorSomethingNew",
            type: "user"
          }
        ]
      },
      nextPageToken: none
    },
    writer: w_writer(),
  ) {
    MembershipUnreadable { reason: r } => string_contains(s: r as String, pattern: "unmodeled role")
    MembershipAbsent => false
    MembershipPageIncomplete { next_page_token: _ } => false
    MembershipObserved { role: _ } => false
  }
}

test fn a_different_principal_does_not_count_as_the_writer() -> Bool {
  match membership_from_permissions(
    list: DrivePermissionList {
      permissions: Present {
        value: [w_permission(email: "someone-else@gunb.ai", role: RoleOrganizer)]
      },
      nextPageToken: none
    },
    writer: w_writer(),
  ) {
    MembershipAbsent => true
    MembershipPageIncomplete { next_page_token: _ } => false
    MembershipUnreadable { reason: _ } => false
    MembershipObserved { role: _ } => false
  }
}

// ORGANIZER IS NOT CORRECTED DOWNWARD. It is strictly more than content-manager, the writer
// already holds it, and revoking authority this converge never granted is a different decision.
test fn organizer_satisfies_and_is_not_downgraded() -> Bool {
  match ensure_drive_membership(
    policy: EnsureMayApply,
    observed: MembershipObserved { role: RoleOrganizer },
    drive_id: w_drive(),
    writer: w_writer(),
  ) {
    Noop => true
    Apply { plan: _ } => false
    Refuse { reason: _ } => false
  }
}

test fn file_organizer_is_the_converged_role() -> Bool {
  match ensure_drive_membership(
    policy: EnsureMayApply,
    observed: MembershipObserved { role: RoleFileOrganizer },
    drive_id: w_drive(),
    writer: w_writer(),
  ) {
    Noop => true
    Apply { plan: _ } => false
    Refuse { reason: _ } => false
  }
}

// A WRONG ROLE REFUSES RATHER THAN APPLYING, because a second permissions.create does not replace
// the first: Drive would answer about the same principal and the writer would stay a reader.
test fn insufficient_role_refuses_because_a_second_grant_would_not_replace_it() -> Bool {
  match ensure_drive_membership(
    policy: EnsureMayApply,
    observed: MembershipObserved { role: RoleReader },
    drive_id: w_drive(),
    writer: w_writer(),
  ) {
    Refuse { reason: r } => string_contains(s: r as String, pattern: "would not replace")
    Noop => false
    Apply { plan: _ } => false
  }
}

test fn absent_membership_under_may_apply_grants_file_organizer() -> Bool {
  match ensure_drive_membership(
    policy: EnsureMayApply,
    observed: MembershipAbsent,
    drive_id: w_drive(),
    writer: w_writer(),
  ) {
    Apply { plan: p } =>
      (p.drive_id as String) == (w_drive() as String)
        && drive_permission_role_wire(r: p.role) == "fileOrganizer"
    Noop => false
    Refuse { reason: _ } => false
  }
}

test fn absent_membership_under_observe_only_refuses() -> Bool {
  match ensure_drive_membership(
    policy: EnsureObserveOnly,
    observed: MembershipAbsent,
    drive_id: w_drive(),
    writer: w_writer(),
  ) {
    Refuse { reason: r } => string_contains(s: r as String, pattern: "observe-only")
    Noop => false
    Apply { plan: _ } => false
  }
}

// THE LOAD-BEARING ONE. incompleteSearch beside an empty file list is Drive saying it could not
// look everywhere -- not that the sheet is absent. Folding it to absent is how a converge mints a
// second spreadsheet beside one it simply failed to find, and the duplicate is unrecoverable
// because both then carry the same marker property key.
test fn incomplete_search_refuses_rather_than_creating() -> Bool {
  match ensure_review_spreadsheet(
    policy: EnsureMayApply,
    observed: spreadsheet_from_file_list(
      list: DriveFileList {
        files: Present { value: [] },
        incompleteSearch: Present { value: true },
        nextPageToken: none
      }
    ),
    drive_id: w_drive(),
    sheet_name: "CI prospect sheet" as NonEmptyStr,
    marker_value: "ci-prospect-sheet" as NonEmptyStr,
  ) {
    Refuse { reason: r } => string_contains(s: r as String, pattern: "not an observation of absence")
    Noop => false
    Apply { plan: _ } => false
  }
}

// The same empty list with a COMPLETE search is a real absence and does authorize a create. This
// is the positive control for the claim above: without it, a fold that refused everything would
// pass that test while making the converge unable to ever create anything.
test fn complete_search_with_no_files_creates() -> Bool {
  match ensure_review_spreadsheet(
    policy: EnsureMayApply,
    observed: spreadsheet_from_file_list(
      list: DriveFileList {
        files: Present { value: [] },
        incompleteSearch: Present { value: false },
        nextPageToken: none
      }
    ),
    drive_id: w_drive(),
    sheet_name: "CI prospect sheet" as NonEmptyStr,
    marker_value: "ci-prospect-sheet" as NonEmptyStr,
  ) {
    Apply { plan: p } =>
      (p.marker_property_value as String) == "ci-prospect-sheet"
        && (p.drive_id as String) == (w_drive() as String)
    Noop => false
    Refuse { reason: _ } => false
  }
}

test fn exactly_one_match_adopts_without_writing() -> Bool {
  match ensure_review_spreadsheet(
    policy: EnsureMayApply,
    observed: spreadsheet_from_file_list(
      list: DriveFileList {
        files: Present { value: [w_file(id: "sheet-one")] },
        incompleteSearch: Present { value: false },
        nextPageToken: none
      }
    ),
    drive_id: w_drive(),
    sheet_name: "CI prospect sheet" as NonEmptyStr,
    marker_value: "ci-prospect-sheet" as NonEmptyStr,
  ) {
    Noop => true
    Apply { plan: _ } => false
    Refuse { reason: _ } => false
  }
}

// DUPLICATES REFUSE AND NEVER SELECT. Two files under one key means an earlier create was retried
// after its answer was lost; picking either silently abandons whatever was written to the other,
// and only an operator can say which lineage is real.
test fn duplicate_matches_refuse_and_name_both() -> Bool {
  match ensure_review_spreadsheet(
    policy: EnsureMayApply,
    observed: spreadsheet_from_file_list(
      list: DriveFileList {
        files: Present { value: [w_file(id: "sheet-one"), w_file(id: "sheet-two")] },
        incompleteSearch: Present { value: false },
        nextPageToken: none
      }
    ),
    drive_id: w_drive(),
    sheet_name: "CI prospect sheet" as NonEmptyStr,
    marker_value: "ci-prospect-sheet" as NonEmptyStr,
  ) {
    Refuse { reason: r } =>
      string_contains(s: r as String, pattern: "sheet-one")
        && string_contains(s: r as String, pattern: "sheet-two")
    Noop => false
    Apply { plan: _ } => false
  }
}

test fn absent_files_field_is_unreadable_not_absent() -> Bool {
  match spreadsheet_from_file_list(
    list: DriveFileList { files: none, incompleteSearch: Present { value: false }, nextPageToken: none }
  ) {
    SheetSearchUnreadable { reason: r } => string_contains(s: r as String, pattern: "not an empty one")
    SheetAbsent => false
    SheetObservedOne { file_id: _ } => false
    SheetDuplicated { file_ids: _ } => false
    SheetSearchIncomplete => false
    SheetPageIncomplete { next_page_token: _ } => false
  }
}

// The query names the marker property key and the spreadsheet mime type, and excludes trashed
// files -- a trashed sheet is not a sheet to adopt, and adopting one would write into a file the
// operator has already thrown away.
test fn search_query_keys_on_properties_and_excludes_trashed() -> Bool {
  let q = review_sheet_search_query(marker_value: "ci-prospect-sheet" as NonEmptyStr)
  string_contains(s: q, pattern: review_sheet_marker_property_key as String)
    && string_contains(s: q, pattern: "trashed=false")
    && string_contains(s: q, pattern: google_sheet_mime_type as String)
    && !string_contains(s: q, pattern: "name=")
}


// The service config must spell the environment variable as a literal because the config parse
// extracts a literal rather than evaluating a reference. WHAT THIS CLAIM REACHES IS ONE SIDE OF
// THAT DUPLICATE: it joins the drive_token_env DECLARATION to a third copy of the string written
// on the line below, and it cannot read the auth_source literal in the service config, because no
// fold in this corpus can read a config's literals. So it goes red when the declaration moves and
// stays GREEN when the transport spelling moves alone -- which is the drift that actually breaks
// the call, refusing every Drive request as AuthDeclaredButUnwired and reading like a missing
// credential rather than a renamed one. The class is rostered as gunbc.recurring_failure_mode
// a_pin_claim_compares_two_copies_while_a_third_drifts; the wall that would close it is a config
// parse that evaluates a declaration reference, leaving one spelling and nothing to drift from.
test fn drive_token_env_matches_the_configured_literal() -> Bool {
  drive_token_env == "GUNBC_REVIEW_SHEET_TOKEN"
}


// The property NAME is a literal in the create body because the body builder emits field names as
// written. This claim has the SAME LIMIT as the env-var one above: it joins this declaration to a
// third copy on the line below and never reads the properties literal in CreateFile's body, so a
// drift confined to that literal stays green. It is kept beside the receipt that motivated it, and
// the receipt is the reason to state the limit rather than imply coverage -- the first live run
// failed exactly here, and a mismatch between the name written into the file and the name searched
// for produces a file that exists and cannot be found, reading as "the create did not take" rather
// than "the create wrote a different name". A claim cited as catching that, which cannot, is worse
// than no claim at all.
test fn marker_property_key_matches_the_created_property() -> Bool {
  (review_sheet_marker_property_key as String) == "gunbcReviewSheet"
}


// THE PAGINATION WALL, AND ITS CONTROL. Both Drive listings are paged, and a page is not the list:
// a writer absent from page one is not absent from the drive, and one matching file on page one is
// not one matching file in the drive. Folding either to a complete observation is the
// incompleteSearch failure reached by a different route, so a present token refuses.
test fn a_partial_permission_page_refuses_rather_than_granting() -> Bool {
  match ensure_drive_membership(
    policy: EnsureMayApply,
    observed: membership_from_permissions(
      list: DrivePermissionList {
        permissions: Present { value: [] },
        nextPageToken: Present { value: "PAGE2" }
      },
      writer: w_writer(),
    ),
    drive_id: w_drive(),
    writer: w_writer(),
  ) {
    Refuse { reason: r } => string_contains(s: r as String, pattern: "one page of several")
    Noop => false
    Apply { plan: _ } => false
  }
}

test fn a_partial_file_page_refuses_rather_than_adopting() -> Bool {
  match ensure_review_spreadsheet(
    policy: EnsureMayApply,
    observed: spreadsheet_from_file_list(
      list: DriveFileList {
        files: Present { value: [w_file(id: "sheet-one")] },
        incompleteSearch: Present { value: false },
        nextPageToken: Present { value: "PAGE2" }
      }
    ),
    drive_id: w_drive(),
    sheet_name: "CI prospect sheet" as NonEmptyStr,
    marker_value: "ci-prospect-sheet" as NonEmptyStr,
  ) {
    Refuse { reason: r } => string_contains(s: r as String, pattern: "one page of several")
    Noop => false
    Apply { plan: _ } => false
  }
}

// THE DISCRIMINATING RED FOR THE SECOND FAIL-OPEN, which the first repair of the principal-type gap
// introduced and its own annotation denied. An unreadable TYPE on a row carrying the writer's
// address used to be filtered out before any role decode, so the matched set emptied and the
// observation answered Absent -- and Absent under EnsureMayApply is Apply, a create against a
// principal that may already hold access. This is the same shape the unmodeled-ROLE claim above
// covers, one field over, and it had no claim at all.
test fn writer_present_under_unreadable_type_is_unreadable_not_absent() -> Bool {
  match membership_from_permissions(
    list: DrivePermissionList {
      permissions: Present {
        value: [
          DrivePermission {
            id: "perm-fixture",
            emailAddress: Present { value: w_writer() as String },
            role: "fileOrganizer",
            type: "serviceAccountSomethingNew"
          }
        ]
      },
      nextPageToken: none
    },
    writer: w_writer(),
  ) {
    MembershipUnreadable { reason: r } => string_contains(s: r as String, pattern: "cannot read")
    MembershipAbsent => false
    MembershipObserved { role: _ } => false
    MembershipPageIncomplete { next_page_token: _ } => false
  }
}

// AND THE CONTROL THAT KEEPS THE ROW ABOVE FROM BEING FREE. An unreadable type on a row that does
// NOT name the writer is genuinely not about this membership: it must not poison the observation,
// or any drive carrying one exotic permission would become permanently unreadable and the converge
// could never proceed.
test fn an_unreadable_type_for_another_principal_does_not_poison_the_read() -> Bool {
  match membership_from_permissions(
    list: DrivePermissionList {
      permissions: Present {
        value: [
          DrivePermission {
            id: "perm-other",
            emailAddress: Present { value: "someone-else@example.com" },
            role: "reader",
            type: "serviceAccountSomethingNew"
          }
        ]
      },
      nextPageToken: none
    },
    writer: w_writer(),
  ) {
    MembershipAbsent => true
    MembershipUnreadable { reason: _ } => false
    MembershipObserved { role: _ } => false
    MembershipPageIncomplete { next_page_token: _ } => false
  }
}
