module test.claim.actions_runner_label_witness

import std.types { Bool, String, NonEmptyStr }
import extdeps.pricing.github_actions {
  ActionsLinux,
  ActionsLinuxArm,
  Linux4Core,
  Linux16Core,
  PublicRepository,
  PrivateRepository,
}
import gunbc.actions_runner_label {
  RunnerLabelClass,
  StandardHosted,
  LabelSuggestsLargerHosted,
  ThirdPartyProvider,
  SelfHostedDeclared,
  LabelFromExpression,
  LabelUnrecognized,
  classify_runner_label,
  LabelBillability,
  LabelBillableByGithub,
  LabelFreeOnGithub,
  LabelBilledElsewhere,
  LabelBillabilityUnestablished,
  label_billability,
}

// These claims fix the readings that a live population and two billing probes established on
// 2026-09-17, so that a later edit cannot quietly move them. The labels are real spellings taken
// from the scanned corpus, not invented examples.

test fn plain_ubuntu_is_a_standard_hosted_runner() -> Bool {
  match classify_runner_label(label: "ubuntu-latest") {
    StandardHosted { sku: _ } => true
    LabelSuggestsLargerHosted { sku: _ } => false
    ThirdPartyProvider { provider: _ } => false
    SelfHostedDeclared => false
    LabelFromExpression => false
    LabelUnrecognized { raw: _ } => false
  }
}

// THE PROBE RESULT, FIXED AS A CLAIM. ubuntu-24.04-arm billed zero on a public repository beside a
// zero x86 control, and a larger runner is charged even on public repositories, so hosted ARM is
// standard. If a later edit reclassifies it as larger, this reds.
test fn hosted_arm_is_standard_not_larger() -> Bool {
  match classify_runner_label(label: "ubuntu-24.04-arm") {
    StandardHosted { sku: _ } => true
    LabelSuggestsLargerHosted { sku: _ } => false
    ThirdPartyProvider { provider: _ } => false
    SelfHostedDeclared => false
    LabelFromExpression => false
    LabelUnrecognized { raw: _ } => false
  }
}

test fn hosted_arm_is_free_on_a_public_repository() -> Bool {
  match label_billability(label: "ubuntu-24.04-arm", visibility: PublicRepository) {
    LabelFreeOnGithub => true
    LabelBillableByGithub { sku: _ } => false
    LabelBilledElsewhere { provider: _ } => false
    LabelBillabilityUnestablished { reason: _ } => false
  }
}

test fn the_same_arm_label_is_charged_on_a_private_repository() -> Bool {
  match label_billability(label: "ubuntu-24.04-arm", visibility: PrivateRepository) {
    LabelBillableByGithub { sku: _ } => true
    LabelFreeOnGithub => false
    LabelBilledElsewhere { provider: _ } => false
    LabelBillabilityUnestablished { reason: _ } => false
  }
}

// A CORE SUFFIX ONLY SUGGESTS. A self-hosted runner may be labelled anything, including this, so
// the arm is named for what a label can establish and no more.
test fn a_core_suffix_suggests_larger_and_does_not_establish_it() -> Bool {
  match classify_runner_label(label: "ubuntu-latest-16-cores") {
    LabelSuggestsLargerHosted { sku: _ } => true
    StandardHosted { sku: _ } => false
    ThirdPartyProvider { provider: _ } => false
    SelfHostedDeclared => false
    LabelFromExpression => false
    LabelUnrecognized { raw: _ } => false
  }
}

// AND IT IS CHARGED EVEN ON A PUBLIC REPOSITORY, which is the whole reason larger runners are the
// findable cost population and standard public runners are not.
test fn a_larger_runner_is_billable_on_a_public_repository() -> Bool {
  match label_billability(label: "ubuntu-latest-4-cores", visibility: PublicRepository) {
    LabelBillableByGithub { sku: _ } => true
    LabelFreeOnGithub => false
    LabelBilledElsewhere { provider: _ } => false
    LabelBillabilityUnestablished { reason: _ } => false
  }
}

// THE CONTROL FOR THE CLAIM ABOVE. Standard on public must answer free, or a fold that answered
// billable for everything would pass the larger-runner claim while being useless.
test fn a_standard_runner_is_free_on_a_public_repository() -> Bool {
  match label_billability(label: "ubuntu-latest", visibility: PublicRepository) {
    LabelFreeOnGithub => true
    LabelBillableByGithub { sku: _ } => false
    LabelBilledElsewhere { provider: _ } => false
    LabelBillabilityUnestablished { reason: _ } => false
  }
}

test fn a_provider_label_is_billed_elsewhere_not_by_github() -> Bool {
  match label_billability(label: "blacksmith-4vcpu-ubuntu-2204", visibility: PublicRepository) {
    LabelBilledElsewhere { provider: p } => (p as String) == "blacksmith"
    LabelBillableByGithub { sku: _ } => false
    LabelFreeOnGithub => false
    LabelBillabilityUnestablished { reason: _ } => false
  }
}

test fn depot_is_a_provider_not_a_hosted_ubuntu_label() -> Bool {
  match classify_runner_label(label: "depot-ubuntu-24.04-16") {
    ThirdPartyProvider { provider: p } => (p as String) == "depot-ubuntu"
    StandardHosted { sku: _ } => false
    LabelSuggestsLargerHosted { sku: _ } => false
    SelfHostedDeclared => false
    LabelFromExpression => false
    LabelUnrecognized { raw: _ } => false
  }
}

// THE STRAGGLER ARM. 17.8% of jobs in the scanned corpus name their runner through an expression,
// and that population is 3.5x more matrix-heavy than the classified one -- so it is exactly the
// population a concurrency claim would need. It answers unestablished rather than being guessed at
// or dropped, which is what keeps the gap countable.
test fn an_expression_label_is_a_straggler_not_a_guess() -> Bool {
  match classify_runner_label(label: "${{ matrix.os }}") {
    LabelFromExpression => true
    StandardHosted { sku: _ } => false
    LabelSuggestsLargerHosted { sku: _ } => false
    ThirdPartyProvider { provider: _ } => false
    SelfHostedDeclared => false
    LabelUnrecognized { raw: _ } => false
  }
}

test fn a_straggler_does_not_answer_billable() -> Bool {
  match label_billability(label: "${{ matrix.os }}", visibility: PublicRepository) {
    LabelBillabilityUnestablished { reason: r } => string_contains(s: r as String, pattern: "expression")
    LabelBillableByGithub { sku: _ } => false
    LabelFreeOnGithub => false
    LabelBilledElsewhere { provider: _ } => false
  }
}

test fn self_hosted_is_declared_and_its_cost_is_not_readable_here() -> Bool {
  match label_billability(label: "self-hosted", visibility: PublicRepository) {
    LabelBillabilityUnestablished { reason: r } => string_contains(s: r as String, pattern: "self-hosted")
    LabelBillableByGithub { sku: _ } => false
    LabelFreeOnGithub => false
    LabelBilledElsewhere { provider: _ } => false
  }
}

// An unknown spelling is named back to the reader rather than folded into a default. macos-latest
// is a real label this census does not price, and answering "standard hosted" for it would invent
// a reading of a platform whose economics are different.
test fn an_unpriced_platform_label_is_unrecognized() -> Bool {
  match classify_runner_label(label: "macos-latest") {
    LabelUnrecognized { raw: r } => r == "macos-latest"
    StandardHosted { sku: _ } => false
    LabelSuggestsLargerHosted { sku: _ } => false
    ThirdPartyProvider { provider: _ } => false
    SelfHostedDeclared => false
    LabelFromExpression => false
  }
}
