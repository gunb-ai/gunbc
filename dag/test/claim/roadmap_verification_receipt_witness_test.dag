module test.claim.roadmap_verification_receipt_witness_test


data verification_receipt_witness_note: String = "GREEN-BY-CONSTRUCTION witness for the exact-head verification model. The fixture supplies every required subject field, one structural validation operation, one realized program-plus-argv command, and separated exit/stdout/stderr evidence. The discriminating RED changes only head_sha: the old receipt remains readable and passed, but verification_evidence_moves_lamp refuses it for the new head. The legacy control supplies the old decoder's most favourable value, passed, and still cannot move the lamp because no subject can be recovered from it."

fn subject_at(head: std.types.CommitSha) -> gunbc.roadmap_verification_receipt.VerificationSubject {
  gunbc.roadmap_verification_receipt.VerificationSubject {
    node_identity: "node-identity-019" as std.types.NonEmptyStr as gunbc.roadmap_model.RoadmapNodeIdentity,
    criteria_digest: content_hash_atom(value: "criteria-v3"),
    attempt_key: "feedfacefeedface",
    branch: "dispatch/exact-head-afeedfacefeedface" as std.types.NonEmptyStr,
    head_sha: head,
    change_window_identity: git_diff_window_absent_identity(),
  }
}

fn exact_head_receipt(head: std.types.CommitSha) -> gunbc.roadmap_verification_receipt.VerificationReceipt {
  gunbc.roadmap_verification_receipt.VerificationReceipt {
    subject: subject_at(head: head),
    oracle_identity: content_hash_of_value(value: "pinned-oracle"),
    executions: [
      gunbc.roadmap_verification_receipt.ValidationExecution {
        validation: gunbc.roadmap_execution_contract.GunbcClaimValidation {
          entry: "dag/test/claim/exact_head_test.dag" as std.types.FilePath,
          function: "exact_head_holds" as std.types.NonEmptyStr,
        },
        command: gunbc.roadmap_execution_contract.ModeledValidationCommand {
          label: "gunbc-claim" as std.types.NonEmptyStr,
          program: "/opt/gunbc/bin/gunbc" as std.types.FilePath,
          args: [
            "run", "--claim-run", "--entry",
            "dag/test/claim/exact_head_test.dag", "--function", "exact_head_holds",
          ],
        },
        exit_code: 0,
        stdout: "true\n",
        stderr: "",
      },
    ],
    verdict: gunbc.roadmap_validation_oracle.ValidationPassed {
      command: "/opt/gunbc/bin/gunbc run --claim-run",
      oracle_identity: content_hash_of_value(value: "pinned-oracle"),
    },
  }
}

data head_a: std.types.CommitSha = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" as std.types.CommitSha
data head_b: std.types.CommitSha = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" as std.types.CommitSha

test fn complete_exact_head_receipt_constructs_and_matches() -> Bool {
  let expected = subject_at(head: test.claim.roadmap_verification_receipt_witness_test.head_a)
  let receipt = exact_head_receipt(head: test.claim.roadmap_verification_receipt_witness_test.head_a)
  match verification_evidence_for(
    expected: expected,
    source: gunbc.roadmap_verification_receipt.ExactHeadVerificationReceipt { receipt: receipt },
  ) {
    VerificationEvidenceForSubject { receipt: found } =>
      count(found.executions) == 1
        && found.executions.first().command.args.first() == "run"
        && verification_evidence_moves_lamp(
          evidence: gunbc.roadmap_verification_receipt.VerificationEvidenceForSubject { receipt: found },
        )
    _ => false
  }
}

test fn passed_receipt_for_old_head_refuses_to_move_new_head_lamp() -> Bool {
  let evidence = verification_evidence_for(
    expected: subject_at(head: test.claim.roadmap_verification_receipt_witness_test.head_b),
    source: gunbc.roadmap_verification_receipt.ExactHeadVerificationReceipt {
      receipt: exact_head_receipt(head: test.claim.roadmap_verification_receipt_witness_test.head_a),
    },
  )
  match evidence {
    VerificationEvidenceForAnotherSubject { field, expected, found } =>
      (field as String) == "head_sha"
        && expected == (test.claim.roadmap_verification_receipt_witness_test.head_b as String)
        && found == (test.claim.roadmap_verification_receipt_witness_test.head_a as String)
        && !verification_evidence_moves_lamp(evidence: evidence)
    _ => false
  }
}

test fn attempt_level_pass_is_typed_legacy_and_never_evidence() -> Bool {
  let evidence = verification_evidence_for(
    expected: subject_at(head: test.claim.roadmap_verification_receipt_witness_test.head_a),
    source: gunbc.roadmap_verification_receipt.LegacyAttemptValidationReceipt { verdict_key: "passed" },
  )
  match evidence {
    VerificationEvidenceLegacyAttemptLevel { verdict_key } =>
      verdict_key == "passed"
        && !verification_evidence_moves_lamp(evidence: evidence)
    _ => false
  }
}

test fn one_attempt_addresses_multiple_heads_without_overwrite() -> Bool {
  let instance = srv2_lab_dashboard_instance()
  let absent_identity = git_diff_window_absent_identity().digest as String
  let path_a = dispatch_attempt_verification_receipt_path_for_instance(
    instance: instance,
    node_id: "exact-head-node" as std.types.NonEmptyStr as gunbc.roadmap_model.RoadmapNodeId,
    attempt_key: "feedfacefeedface",
    head_sha: test.claim.roadmap_verification_receipt_witness_test.head_a as String,
    window_identity_hex: absent_identity,
  )
  let path_b = dispatch_attempt_verification_receipt_path_for_instance(
    instance: instance,
    node_id: "exact-head-node" as std.types.NonEmptyStr as gunbc.roadmap_model.RoadmapNodeId,
    attempt_key: "feedfacefeedface",
    head_sha: test.claim.roadmap_verification_receipt_witness_test.head_b as String,
    window_identity_hex: absent_identity,
  )
  path_a != path_b
    && string_contains(
      s: path_a,
      pattern: concat("/verification/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.", absent_identity, ".json"),
    )
    && string_contains(
      s: path_b,
      pattern: concat("/verification/bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb.", absent_identity, ".json"),
    )
}

test fn exact_head_receipt_round_trips_through_json_codec() -> Bool {
  let receipt = exact_head_receipt(head: test.claim.roadmap_verification_receipt_witness_test.head_a)
  let wire = verification_receipt_json(receipt: receipt)
  match verification_receipt_decode(receipt: wire) {
    VerificationReceiptDecoded { receipt: decoded } =>
      match verification_subject_match(expected: receipt.subject, found: decoded.subject) {
        VerificationSubjectMatches =>
          count(decoded.executions) == count(receipt.executions)
            && verification_evidence_moves_lamp(
              evidence: gunbc.roadmap_verification_receipt.VerificationEvidenceForSubject { receipt: decoded },
            )
        VerificationSubjectDiffers { field: _, expected: _, found: _ } => false
      }
    VerificationReceiptUndecodable { reason: _ } => false
  }
}

test fn change_window_refused_verdict_round_trips_through_json_codec() -> Bool {
  let receipt = gunbc.roadmap_verification_receipt.VerificationReceipt {
    subject: subject_at(head: test.claim.roadmap_verification_receipt_witness_test.head_a),
    oracle_identity: content_hash_of_value(value: "pinned-oracle"),
    executions: [],
    verdict: gunbc.roadmap_validation_oracle.ValidationRefused {
      cause: gunbc.roadmap_validation_oracle.ValidationChangeWindowRefused {
        cause: gunbc.git_diff_change_window.ChangeWindowPersistenceRefused {
          path: "/tmp/attempt/verification/window.json",
          cause: "merge-base observation failed (exit 128): fatal: Not a valid object name",
        },
      },
    },
  }
  let wire = verification_receipt_json(receipt: receipt)
  match verification_receipt_decode(receipt: wire) {
    VerificationReceiptDecoded { receipt: decoded } =>
      match decoded.verdict {
        ValidationRefused { cause } =>
          validation_refusal_cause_key(cause: cause) == "change-window-refused"
        _ => false
      }
    VerificationReceiptUndecodable { reason: _ } => false
  }
}

test fn verification_receipt_schema_is_v2() -> Bool {
  (verification_receipt_schema as String) == "roadmap-verification-receipt/v2"
}

test fn roadmap_verification_receipt_keystone_holds() -> Bool {
  complete_exact_head_receipt_constructs_and_matches()
    && passed_receipt_for_old_head_refuses_to_move_new_head_lamp()
    && attempt_level_pass_is_typed_legacy_and_never_evidence()
    && one_attempt_addresses_multiple_heads_without_overwrite()
    && exact_head_receipt_round_trips_through_json_codec()
    && change_window_refused_verdict_round_trips_through_json_codec()
    && verification_receipt_schema_is_v2()
}
