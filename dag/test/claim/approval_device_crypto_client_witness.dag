  DeviceCryptoAnswer, DeviceCryptoVerdict, CryptoVerified, CryptoInvalid, CryptoRefused, CryptoInfinity, CryptoFinite, NoPayload, SignedPayload, AttestedPayload, AssertedPayload, RefusedPayload, NoFields, OneField, TwoFields,
  device_crypto_arm_signature_verified, device_crypto_arm_attestation_verified, device_crypto_arm_assertion_verified,
