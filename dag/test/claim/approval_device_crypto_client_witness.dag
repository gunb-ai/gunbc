  AttestationRefusal, AttestationFormatUnexpected, AttestationChainUntrusted, AttestationNonceMismatch, AttestationKeyIdMismatch, AttestationAppIdMismatch,
  AttestationCounterNonZero, AttestationEnvironmentUnexpected, AttestationCredentialIdMismatch, AttestationValidationCategoryRefused,
  AttestationValidationCategoryAbsent, AttestationBundleVersionAbsent, AttestationBundleVersionUnexpected, AttestationUndecodable,
