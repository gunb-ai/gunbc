import gunbc.auth.approval_device_routes { DeviceRouteResponse, sidecar_failure_response }

fn admitted() -> DeviceCryptoAdmission {
  device_crypto_receipt_admission(receipt: DeviceCryptoHandlerReceipt { handler_identity: "fixture", exact_revision: "0000000", covered: device_crypto_obligations }, required: device_crypto_obligations)
}

fn receipt() -> DeviceCryptoHandlerReceipt {
  DeviceCryptoHandlerReceipt { handler_identity: device_crypto_handler_identity, exact_revision: "deadbeef", covered: device_crypto_obligations }
}

fn expectation() -> DeviceCryptoExpectation {
  DeviceCryptoExpectation { requirement: DeviceCryptoRequirement { handler_identity: device_crypto_handler_identity, required: device_crypto_obligations }, deployed_digest: "deadbeef" }
}

fn unavailable() -> DeviceCryptoAdmission {
  device_crypto_receipt_admission(receipt: DeviceCryptoHandlerReceipt { handler_identity: "fixture", exact_revision: "0000000", covered: [] }, required: device_crypto_obligations)
}

fn key() -> VerifyingKey {
  VerifyingKey { suite: EcdsaP256Sha256, encoding: Sec1Uncompressed, point_b64url: "BKEY" }
}

fn request_message() -> NonEmptyStr {
  "the message"
}

fn attestation_request() -> AttestationExpectation {
  AttestationExpectation { key_id: "kid" as AttestKeyId, client_data: "cd", app_id: "TEAM.app", environment: AppAttestProduction, observed_at: "2026-10-18T00:00:00Z", admitted_validation_categories: [1], expected_bundle_version: "1" }
}

fn assertion_request() -> AssertionExpectation {
  AssertionExpectation { key_id: "kid" as AttestKeyId, public_key_point_b64url: "BPK", client_data: "cd", app_id: "TEAM.app", admitted_validation_categories: [1], expected_bundle_version: "1" }
}

fn signed_answer() -> DeviceCryptoAnswer {
  DeviceCryptoAnswer { verdict: CryptoVerified, arm: device_crypto_arm_signature_verified, payload: SignedPayload { key: key(), message: "the message" } }
}

fn attested_answer() -> DeviceCryptoAnswer {
  DeviceCryptoAnswer {
    verdict: CryptoVerified, arm: device_crypto_arm_attestation_verified,
    payload: AttestedPayload { key_id: "kid" as AttestKeyId, public_key_point_b64url: "BPK", receipt_b64: "RCPT", environment: AppAttestProduction, client_data: "cd" },
  }
}

fn asserted_answer() -> DeviceCryptoAnswer {
  DeviceCryptoAnswer {
    verdict: CryptoVerified, arm: device_crypto_arm_assertion_verified,
    payload: AssertedPayload { key_id: "kid" as AttestKeyId, public_key_point_b64url: "BPK", counter: 3, client_data: "cd" },
  }
}

fn refused_answer() -> DeviceCryptoAnswer {
  DeviceCryptoAnswer { verdict: CryptoRefused, arm: "AttestationNonceMismatch", payload: RefusedPayload { fields: NoFields } }
}

fn order_answer(v: DeviceCryptoVerdict, arm: String) -> DeviceCryptoAnswer {
  DeviceCryptoAnswer { verdict: v, arm: arm, payload: NoPayload }
}

// THE WIRE ROUND-TRIPS EVERY VERIFIED PAYLOAD: what the service writes is what the broker decodes.
test fn witness_every_verified_payload_round_trips_the_wire() -> Bool {
  [signed_answer(), attested_answer(), asserted_answer(), refused_answer(), order_answer(v: CryptoInfinity, arm: device_crypto_arm_infinity), order_answer(v: CryptoFinite, arm: device_crypto_arm_finite), order_answer(v: CryptoRefused, arm: device_crypto_arm_scalar_unrepresentable)]
    |> all(a => match decode_device_crypto_answer(text: device_crypto_answer_json(a: a)) {
      WireDecoded { value: back } => device_crypto_answer_json(a: back) == device_crypto_answer_json(a: a)
      WireRefused { at: _, cause: _ } => false
    })
}

// THE ORDER ANSWERS DECODE AS NoPayload: the carrier is matched, not its JSON, so RefusedPayload{NoFields} cannot pass for NoPayload.
fn decodes_as_no_payload(v: DeviceCryptoVerdict, arm: String) -> Bool {
  match decode_device_crypto_answer(text: device_crypto_answer_json(a: order_answer(v: v, arm: arm))) {
    WireDecoded { value: DeviceCryptoAnswer { verdict: dv, arm: da, payload: NoPayload } } => dv == v && da == arm
    WireDecoded { value: _ } => false
    WireRefused { at: _, cause: _ } => false
  }
}

test fn witness_the_order_answers_decode_to_the_no_payload_carrier() -> Bool {
  decodes_as_no_payload(v: CryptoInfinity, arm: device_crypto_arm_infinity)
    && decodes_as_no_payload(v: CryptoFinite, arm: device_crypto_arm_finite)
    && decodes_as_no_payload(v: CryptoRefused, arm: device_crypto_arm_scalar_unrepresentable)
}

// A verified verdict whose arm names another outcome, or whose payload is missing, is refused at decode.
test fn witness_a_verified_verdict_without_its_payload_is_refused() -> Bool {
  let no_payload = DeviceCryptoAnswer { verdict: CryptoVerified, arm: device_crypto_arm_signature_verified, payload: NoPayload }
  let wrong_arm = DeviceCryptoAnswer { verdict: CryptoVerified, arm: "SignatureInvalid", payload: SignedPayload { key: key(), message: "m" } }
  [no_payload, wrong_arm]
    |> all(a => match decode_device_crypto_answer(text: device_crypto_answer_json(a: a)) {
      WireRefused { at: _, cause: _ } => true
      WireDecoded { value: _ } => false
    })
}

// DECODING MINTS ONLY UNDER AN ADMISSION: a refused admission mints nothing, for each of the three evidence types.
fn signature_failed(r: SidecarResult<SignatureVerification>) -> Bool {
  match r { SidecarFailed { cause: _ } => true  _ => false }
}

fn attestation_failed(r: SidecarResult<AttestationVerification>) -> Bool {
  match r { SidecarFailed { cause: _ } => true  _ => false }
}

fn assertion_failed(r: SidecarResult<AssertionVerification>) -> Bool {
  match r { SidecarFailed { cause: _ } => true  _ => false }
}

test fn witness_decoding_without_an_admission_mints_nothing() -> Bool {
  signature_failed(r: signature_from_answer(admission: unavailable(), answer: signed_answer(), key: key(), message: request_message()))
    && attestation_failed(r: attestation_from_answer(admission: unavailable(), answer: attested_answer(), expectation: attestation_request()))
    && assertion_failed(r: assertion_from_answer(admission: unavailable(), answer: asserted_answer(), expectation: assertion_request()))
}

// THE CONTROL: under an admission the same answers mint the fold's own verified arms.
test fn witness_decoding_under_an_admission_mints_the_verified_arms() -> Bool {
  let signature = match signature_from_answer(admission: admitted(), answer: signed_answer(), key: key(), message: request_message()) {
    SidecarAnswered { verification: SignatureVerified { verified: v } } => v.message == "the message"
    _ => false
  }
  let attestation = match attestation_from_answer(admission: admitted(), answer: attested_answer(), expectation: attestation_request()) {
    SidecarAnswered { verification: AttestationVerified { verified: _ } } => true
    _ => false
  }
  let assertion = match assertion_from_answer(admission: admitted(), answer: asserted_answer(), expectation: assertion_request()) {
    SidecarAnswered { verification: AssertionAuthentic { authentic: a } } => a.counter == 3
    _ => false
  }
  signature && attestation && assertion
}

// EVERY REFUSAL ARM maps to the fold's refusal, never to a verified value.
test fn witness_refused_and_invalid_answers_map_to_the_refusal_arms() -> Bool {
  let invalid = DeviceCryptoAnswer { verdict: CryptoInvalid, arm: "SignatureInvalid", payload: RefusedPayload { fields: NoFields } }
  let signature = match signature_from_answer(admission: admitted(), answer: invalid, key: key(), message: request_message()) {
    SidecarAnswered { verification: SignatureInvalid { suite: _ } } => true
    _ => false
  }
  let attestation = match attestation_from_answer(admission: admitted(), answer: refused_answer(), expectation: attestation_request()) {
    SidecarAnswered { verification: AttestationRefused { cause: _ } } => true
    _ => false
  }
  let assertion = match assertion_from_answer(admission: admitted(), answer: DeviceCryptoAnswer { verdict: CryptoRefused, arm: "AssertionAppIdMismatch", payload: RefusedPayload { fields: OneField { a: "TEAM.app" } } }, expectation: assertion_request()) {
    SidecarAnswered { verification: AssertionRefused { cause: _ } } => true
    _ => false
  }
  signature && attestation && assertion
}

// A verdict that is not an answer to this route is a sidecar failure, not a verification result.
test fn witness_an_unexpected_verdict_is_a_sidecar_failure() -> Bool {
  let odd = DeviceCryptoAnswer { verdict: CryptoInfinity, arm: device_crypto_arm_infinity, payload: NoPayload }
  match signature_from_answer(admission: admitted(), answer: odd, key: key(), message: request_message()) {
    SidecarFailed { cause: _ } => true
    _ => false
  }
}

// THE TRANSPORT: a timeout (curl exit 28), a non-200 status and an undecodable 200 each fail; only a decodable 200 replies.
fn reply_failed(r: SidecarReply) -> Bool {
  match r { SidecarReplyFailed { cause: _ } => true  SidecarReplied { answer: _ } => false }
}

fn reply_answered(r: SidecarReply) -> Bool {
  match r { SidecarReplied { answer: _ } => true  SidecarReplyFailed { cause: _ } => false }
}

test fn witness_a_timeout_a_bad_status_and_a_bad_body_are_sidecar_failures() -> Bool {
  let good = device_crypto_echoed_answer_json(a: signed_answer(), receipt: receipt())
  let x = expectation()
  reply_failed(r: sidecar_reply_from(exit_code: 28, stdout: "", stderr: "timed out", expectation: x))
    && reply_failed(r: sidecar_reply_from(exit_code: 0, stdout: "\{\"error\":\"x\"\}\n503", stderr: "", expectation: x))
    && reply_failed(r: sidecar_reply_from(exit_code: 0, stdout: "not json\n200", stderr: "", expectation: x))
    && reply_answered(r: sidecar_reply_from(exit_code: 0, stdout: join([good, "\n200"], ""), stderr: "", expectation: x))
}

// THE SIDECAR DOWN: curl exit 7 (connection refused) is a sidecar failure and the route maps it to the typed 503.
test fn witness_a_down_sidecar_is_a_typed_503() -> Bool {
  match sidecar_reply_from(exit_code: 7, stdout: "", stderr: "connection refused", expectation: expectation()) {
    SidecarReplyFailed { cause: c } => ((sidecar_failure_response(cause: c as String).status) as Int) == 503
    SidecarReplied { answer: _ } => false
  }
}

// THE ECHO JOIN CONTROLS: a digest differing from the deployed artifact's is refused (503), a missing echo is refused, an echo
// covering fewer than all four obligations is refused, and a matching echo passes the gate.
test fn witness_an_echo_that_differs_from_the_deployed_digest_is_refused() -> Bool {
  let other = DeviceCryptoHandlerReceipt { handler_identity: device_crypto_handler_identity, exact_revision: "cafef00d", covered: device_crypto_obligations }
  reply_failed(r: sidecar_reply_from(exit_code: 0, stdout: join([device_crypto_echoed_answer_json(a: signed_answer(), receipt: other), "\n200"], ""), stderr: "", expectation: expectation()))
}

test fn witness_an_answer_without_its_echo_is_refused() -> Bool {
  reply_failed(r: sidecar_reply_from(exit_code: 0, stdout: join([device_crypto_answer_json(a: signed_answer()), "\n200"], ""), stderr: "", expectation: expectation()))
}

test fn witness_an_echo_covering_fewer_than_all_obligations_is_refused() -> Bool {
  device_crypto_obligations |> all(dropped => {
    let partial = DeviceCryptoHandlerReceipt { handler_identity: device_crypto_handler_identity, exact_revision: "deadbeef", covered: device_crypto_obligations |> filter(o => o != dropped) }
    reply_failed(r: sidecar_reply_from(exit_code: 0, stdout: join([device_crypto_echoed_answer_json(a: signed_answer(), receipt: partial), "\n200"], ""), stderr: "", expectation: expectation()))
  })
}

test fn witness_the_echo_join_admits_the_matching_receipt() -> Bool {
  match device_crypto_echo_join(expectation: expectation(), echo: receipt()) { DeviceCryptoEchoJoined { admission: _ } => true  DeviceCryptoEchoRefused { cause: _ } => false }
}

// THE BOUND ROW MINTS NO PROOF ALONE. The production row opens the gate with only a requirement -- no revision exists on it to
// name -- so a proof needs an echo that joined the provisioned digest. RED: an unjoined echo (another digest) is refused
// and yields no admission and so no proof; a refused gate carries no requirement; the joined echo's admission names the
// echoed revision, which the join proved equals the deployed digest.
test fn witness_a_bound_row_without_a_joined_echo_yields_no_proof() -> Bool {
  let row_opens_without_a_revision = match device_crypto_gate(r: approval_device_crypto_realization) {
    DeviceCryptoGateOpen { requirement: q } => (q.handler_identity as String) == (device_crypto_handler_identity as String) && count(q.required) == count(device_crypto_obligations)
    DeviceCryptoGateRefused { status: _, reason: _ } => false
  }
  let unavailable_gate_refuses = match device_crypto_gate(r: NativeDeviceCryptoUnavailable { cause: "fixture" }) {
    DeviceCryptoGateRefused { status: st, reason: _ } => st == 503
    DeviceCryptoGateOpen { requirement: _ } => false
  }
  let wrong_digest = DeviceCryptoExpectation { requirement: expectation().requirement, deployed_digest: "feedface" }
  let unjoined_yields_no_admission = match device_crypto_echo_join(expectation: wrong_digest, echo: receipt()) {
    DeviceCryptoEchoRefused { cause: _ } => true
    DeviceCryptoEchoJoined { admission: _ } => false
  }
  let joined_names_the_echoed_revision = match device_crypto_echo_join(expectation: expectation(), echo: receipt()) {
    DeviceCryptoEchoJoined { admission: DeviceCryptoAdmitted { handler_identity: _, exact_revision: r } } => (r as String) == "deadbeef"
    _ => false
  }
  row_opens_without_a_revision && unavailable_gate_refuses && unjoined_yields_no_admission && joined_names_the_echoed_revision
}

// THE ROUTE'S MAPPING: a sidecar failure is a 503 carrying its cause, never a 200.
test fn witness_a_sidecar_failure_answers_503() -> Bool {
  let r = sidecar_failure_response(cause: "timed out")
  (r.status as Int) == 503 && string_contains(s: r.body, pattern: "timed out")
}

// THE ENDPOINT IS DERIVED FROM THE TYPED PORT.
test fn witness_the_endpoint_names_the_declared_port() -> Bool {
  (approval_device_crypto_sidecar_endpoint() as String) == "http://127.0.0.1:8086"
}

// THE STD PROOF EXISTS ONLY UNDER AN ADMISSION, and names the fold it was derived for.
test fn witness_the_native_realization_proof_is_derived_only_from_an_admission() -> Bool {
  let fold = decl_ref(module_path: "extdeps.crypto.signature", decl_name: "verify_signature")
  let refused = match device_crypto_proof_of(admission: unavailable(), fold: fold) {
    Absent => true
    Present { value: _ } => false
  }
  let granted = match device_crypto_proof_of(admission: admitted(), fold: fold) {
    Present { value: p } => p.fold == fold && (p.handler_identity as String) == "fixture"
    Absent => false
  }
  refused && granted
}

// THE EXECUTED JOIN, per refusal arm: the answer the service writes for a fold value decodes in the broker to the SAME
// value the in-process fold returned (a verdict and arm that disagree, or an arm with the wrong members, is a sidecar failure).
fn signature_joined(v: SignatureVerification) -> Bool {
  match decode_device_crypto_answer(text: signature_answer(v: v, receipt: receipt()).body) {
    WireRefused { at: _, cause: _ } => false
    WireDecoded { value: a } =>
      match signature_from_answer(admission: admitted(), answer: a, key: key(), message: request_message()) {
        SidecarAnswered { verification: back } => back == v
        SidecarFailed { cause: _ } => false
      }
  }
}

fn attestation_joined(r: AttestationRefusal) -> Bool {
  match decode_device_crypto_answer(text: attestation_answer(v: AttestationRefused { cause: r }, receipt: receipt()).body) {
    WireRefused { at: _, cause: _ } => false
    WireDecoded { value: a } =>
      match attestation_from_answer(admission: admitted(), answer: a, expectation: attestation_request()) {
        SidecarAnswered { verification: back } => back == AttestationRefused { cause: r }
        SidecarFailed { cause: _ } => false
      }
  }
}

fn assertion_joined(r: AssertionRefusal) -> Bool {
  match decode_device_crypto_answer(text: assertion_answer(v: AssertionRefused { cause: r }, receipt: receipt()).body) {
    WireRefused { at: _, cause: _ } => false
    WireDecoded { value: a } =>
      match assertion_from_answer(admission: admitted(), answer: a, expectation: assertion_request()) {
        SidecarAnswered { verification: back } => back == AssertionRefused { cause: r }
        SidecarFailed { cause: _ } => false
      }
  }
}

fn id() -> AttestKeyId {
  "kid" as AttestKeyId
}

test fn witness_every_signature_negative_arm_decodes_to_the_folds_own_value() -> Bool {
  [
    SignatureInvalid { suite: EcdsaP256Sha256 },
    SignatureMalformed { declared: byte_size(count: 63), expected: byte_size(count: 64) },
    VerifyingKeyMalformed { declared: byte_size(count: 33), expected: byte_size(count: 65) },
    SignatureSuiteMismatch { key_suite: EcdsaP256Sha256, signature_suite: EcdsaP256Sha256 },
    VerifyingKeyUndecodable { point_b64url: "not-a-point" },
    SignatureUndecodable { b64url: "not-a-signature" },
  ] |> all(v => signature_joined(v: v))
}

test fn witness_every_attestation_refusal_arm_decodes_to_the_folds_own_value() -> Bool {
  [
    AttestationFormatUnexpected { declared: "" },
    AttestationFormatUnexpected { declared: "fmt" },
    AttestationChainUntrusted { detail: "d" },
    AttestationNonceMismatch,
    AttestationKeyIdMismatch { declared: id() },
    AttestationAppIdMismatch { expected_app_id: "TEAM.app" },
    AttestationCounterNonZero { counter: 7 },
    AttestationEnvironmentUnexpected { expected: AppAttestProduction },
    AttestationEnvironmentUnexpected { expected: AppAttestDevelopment },
    AttestationCredentialIdMismatch { declared: id() },
    AttestationValidationCategoryRefused { category: 3 },
    AttestationValidationCategoryAbsent,
    AttestationBundleVersionAbsent,
    AttestationBundleVersionUnexpected { declared: "9" },
    AttestationUndecodable { cause: "bad cbor" },
  ] |> all(r => attestation_joined(r: r))
}

test fn witness_every_assertion_refusal_arm_decodes_to_the_folds_own_value() -> Bool {
  [
    AssertionSignatureInvalid,
    AssertionAppIdMismatch { expected_app_id: "TEAM.app" },
    AssertionValidationCategoryRefused { category: 3 },
    AssertionValidationCategoryAbsent,
    AssertionBundleVersionAbsent,
    AssertionBundleVersionUnexpected { declared: "9" },
    AssertionUndecodable { cause: "bad cbor" },
  ] |> all(r => assertion_joined(r: r))
}

// CONTROLS: a negative whose members do not match its arm, or whose verdict disagrees with its arm, is a sidecar
// failure, never a guessed refusal.
test fn witness_a_negative_with_the_wrong_members_or_verdict_is_a_sidecar_failure() -> Bool {
  let no_members = DeviceCryptoAnswer { verdict: CryptoRefused, arm: "SignatureMalformed", payload: RefusedPayload { fields: NoFields } }
  let extra = DeviceCryptoAnswer { verdict: CryptoRefused, arm: "AttestationNonceMismatch", payload: RefusedPayload { fields: OneField { a: "x" } } }
  let disagrees = DeviceCryptoAnswer { verdict: CryptoRefused, arm: "SignatureInvalid", payload: RefusedPayload { fields: NoFields } }
  let unknown = DeviceCryptoAnswer { verdict: CryptoRefused, arm: "NoSuchArm", payload: RefusedPayload { fields: NoFields } }
  signature_failed(r: signature_from_answer(admission: admitted(), answer: no_members, key: key(), message: request_message()))
    && attestation_failed(r: attestation_from_answer(admission: admitted(), answer: extra, expectation: attestation_request()))
    && signature_failed(r: signature_from_answer(admission: admitted(), answer: disagrees, key: key(), message: request_message()))
    && assertion_failed(r: assertion_from_answer(admission: admitted(), answer: unknown, expectation: assertion_request()))
}

// THE ORDER ANSWERS ARE STRICT: each of infinity, finite and scalar-unrepresentable decodes only as exactly its (verdict, arm)
// with no members; an unexpected member, another arm under the verdict, or the scalar arm under another verdict is refused.
fn decode_refuses(text: String) -> Bool {
  match decode_device_crypto_answer(text: text) {
    WireRefused { at: _, cause: _ } => true
    WireDecoded { value: _ } => false
  }
}

test fn witness_an_order_answer_with_a_member_or_another_arm_is_refused() -> Bool {
  decode_refuses(text: "\{\"verdict\": \"infinity\", \"arm\": \"Infinity\", \"f1\": \"x\"\}")
    && decode_refuses(text: "\{\"verdict\": \"infinity\", \"arm\": \"Finite\"\}")
    && decode_refuses(text: "\{\"verdict\": \"finite\", \"arm\": \"Infinity\"\}")
    && decode_refuses(text: "\{\"verdict\": \"refused\", \"arm\": \"ScalarUnrepresentable\", \"f1\": \"x\"\}")
    && decode_refuses(text: "\{\"verdict\": \"invalid\", \"arm\": \"ScalarUnrepresentable\"\}")
}

// THE REQUEST-TO-ANSWER JOIN, per verifier and per echoed field: a verified payload that differs from the request in any
// one of its joined fields is a sidecar failure, and the unchanged payload mints (so each failure is the field, not the fixture).
// The three routes' call sites (authenticated reads and redemption: assertion; enrolment: attestation; redemption and
// enrolment key proof: signature) each hand their own request to these same three entries.
test fn witness_a_verified_signature_for_another_request_is_a_sidecar_failure() -> Bool {
  let other_key = VerifyingKey { suite: EcdsaP256Sha256, encoding: Sec1Uncompressed, point_b64url: "BOTHER" }
  let other_key_answer = DeviceCryptoAnswer { verdict: CryptoVerified, arm: device_crypto_arm_signature_verified, payload: SignedPayload { key: other_key, message: "the message" } }
  let other_message_answer = DeviceCryptoAnswer { verdict: CryptoVerified, arm: device_crypto_arm_signature_verified, payload: SignedPayload { key: key(), message: "another message" } }
  let same = match signature_from_answer(admission: admitted(), answer: signed_answer(), key: key(), message: request_message()) {
    SidecarAnswered { verification: SignatureVerified { verified: _ } } => true
    _ => false
  }
  same
    && signature_failed(r: signature_from_answer(admission: admitted(), answer: other_key_answer, key: key(), message: request_message()))
    && signature_failed(r: signature_from_answer(admission: admitted(), answer: other_message_answer, key: key(), message: request_message()))
}

fn attested_with(id: String, env: AppAttestEnvironment, cd: String) -> DeviceCryptoAnswer {
  DeviceCryptoAnswer {
    verdict: CryptoVerified, arm: device_crypto_arm_attestation_verified,
    payload: AttestedPayload { key_id: id as AttestKeyId, public_key_point_b64url: "BPK", receipt_b64: "RCPT", environment: env, client_data: cd as NonEmptyStr },
  }
}

test fn witness_a_verified_attestation_for_another_request_is_a_sidecar_failure() -> Bool {
  let same = match attestation_from_answer(admission: admitted(), answer: attested_with(id: "kid", env: AppAttestProduction, cd: "cd"), expectation: attestation_request()) {
    SidecarAnswered { verification: AttestationVerified { verified: _ } } => true
    _ => false
  }
  same
    && attestation_failed(r: attestation_from_answer(admission: admitted(), answer: attested_with(id: "other", env: AppAttestProduction, cd: "cd"), expectation: attestation_request()))
    && attestation_failed(r: attestation_from_answer(admission: admitted(), answer: attested_with(id: "kid", env: AppAttestDevelopment, cd: "cd"), expectation: attestation_request()))
    && attestation_failed(r: attestation_from_answer(admission: admitted(), answer: attested_with(id: "kid", env: AppAttestProduction, cd: "other"), expectation: attestation_request()))
}

fn asserted_with(id: String, pk: String, cd: String) -> DeviceCryptoAnswer {
  DeviceCryptoAnswer {
    verdict: CryptoVerified, arm: device_crypto_arm_assertion_verified,
    payload: AssertedPayload { key_id: id as AttestKeyId, public_key_point_b64url: pk as NonEmptyStr, counter: 3, client_data: cd as NonEmptyStr },
  }
}

test fn witness_a_verified_assertion_for_another_request_is_a_sidecar_failure() -> Bool {
  let same = match assertion_from_answer(admission: admitted(), answer: asserted_with(id: "kid", pk: "BPK", cd: "cd"), expectation: assertion_request()) {
    SidecarAnswered { verification: AssertionAuthentic { authentic: _ } } => true
    _ => false
  }
  same
    && assertion_failed(r: assertion_from_answer(admission: admitted(), answer: asserted_with(id: "other", pk: "BPK", cd: "cd"), expectation: assertion_request()))
    && assertion_failed(r: assertion_from_answer(admission: admitted(), answer: asserted_with(id: "kid", pk: "BOTHER", cd: "cd"), expectation: assertion_request()))
    && assertion_failed(r: assertion_from_answer(admission: admitted(), answer: asserted_with(id: "kid", pk: "BPK", cd: "other"), expectation: assertion_request()))
}

// THE STARTUP VALUE CARRIES COVERAGE: an admitted startup hands the handler the receipt whole and typed, and a partial
// population is refused before any value exists, so the handler echoes what was admitted and never a restated population.
test fn witness_the_startup_value_carries_the_admitted_coverage() -> Bool {
  let whole = match device_crypto_receipt_startup(covered: device_crypto_obligations, exact_revision: "deadbeef") {
    NativeServeStartupPassed { line: _, value: r } => (r.covered |> count) == (device_crypto_obligations |> count) && (r.exact_revision as String) == "deadbeef"
    NativeServeStartupRefused { reason: _ } => false
  }
  let partial_refused = match device_crypto_receipt_startup(covered: device_crypto_obligations |> take(n: 1), exact_revision: "deadbeef") {
    NativeServeStartupRefused { reason: _ } => true
    NativeServeStartupPassed { line: _, value: _ } => false
  }
  whole && partial_refused
}
