        signals: coherent_control.signals,
        equations: [],
      },
      bonds: []
    ),
    wanted: "OutputWithNoDriver"
  )
}

test fn w_an_output_two_equations_drive_refuses() -> Bool {
  refuses_with_exactly_named_cause(
    a: fixture_article(
      analog: coherent_analog,
      reference: b_net,
      control: product.compute_board.digital_control.DigitalControlIntent {
        block_name: coherent_control.block_name,
        signals: coherent_control.signals,
        equations: concat(coherent_control.equations, [product.compute_board.digital_control.DigitalEquation {
          driven: out_signal,
          expression: product.compute_board.digital_control.SignalRef { signal: in_signal },
        }]),
      },
      bonds: []
    ),
