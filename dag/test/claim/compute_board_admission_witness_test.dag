  )
}

// TWO PLANTED DEFECTS PRODUCE TWO CAUSES. This is the claim the collected-refusal shape was
// built for, and a first-wins fold passes every test above while failing this one.
test fn w_two_defects_are_both_reported() -> Bool {
  let a = fixture_article(
    analog: duplicate_component_analog,
    reference: net_identity(design: fixture_design, local_identity: "not_a_net"),
    control: coherent_control,
    bonds: []
  )
  match admit_board_article(a: a) {
    BoardArticleAdmitted { article: _ } => false
    BoardArticleRefused { causes: s } => refusal_set_count(s: s) == 2
  }
}

// THE PRODUCTION ARTICLE, admitted. The fixtures above prove the mechanism discriminates; this
// proves it is pointed at the real root rather than only at synthetic ones.
test fn w_the_production_article_carries_no_cause() -> Bool {
  fold(article_refusals(a: power_interlock_article), init: 0, f: fn(acc, _r) { acc + 1 }) == 0
    && is_admitted(a: power_interlock_article)
}

// THE FIRMWARE CONTRACT'S PRECONDITIONS JOIN THE CONTROL LOGIC. These two fixtures are the reason
// the prose fields were replaced rather than reworded: neither defect had a representation at
// all before the establishment was typed, so neither could be refused.
fn firmware_contract_with(p: product.compute_board.article.HostFirmwareStartPrecondition) -> product.compute_board.article.PlatformFirmwareContract {
  product.compute_board.article.PlatformFirmwareContract {
    start_preconditions: [p],
    write_protection: board_power_interlock_firmware_contract.write_protection,
    development_image_trust: board_power_interlock_firmware_contract.development_image_trust,
    production_signing: board_power_interlock_firmware_contract.production_signing,
  }
}

fn fixture_with_firmware(f: product.compute_board.article.PlatformFirmwareContract) -> product.compute_board.article.BoardPowerInterfaceArticle {
  product.compute_board.article.BoardPowerInterfaceArticle {
    identity: coherent_fixture.identity,
    analog: coherent_fixture.analog,
    model_bindings: coherent_fixture.model_bindings,
    reference_net: coherent_fixture.reference_net,
    digital_control: coherent_fixture.digital_control,
    bonds: coherent_fixture.bonds,
    platform_firmware: f,
    physical: coherent_fixture.physical,
    manufacturing: coherent_fixture.manufacturing,
  }
}

test fn w_a_precondition_naming_no_signal_refuses() -> Bool {
  refuses_with_exactly_named_cause(
    a: fixture_with_firmware(f: firmware_contract_with(p: product.compute_board.article.HostFirmwareStartPrecondition {
      kind: PowerPermitAsserted,
      establishment: product.compute_board.article.EstablishedByBoardSignal { signal: "no_such_wire" as product.compute_board.digital_control.SignalName },
    })),
    wanted: "PreconditionSignalUndeclared"
  )
}

// Establishing a precondition with an INPUT is the subtler defect: the signal exists, so a
// declaration check passes, and the board would be claiming to establish a condition it only
// observes. Direction is the whole content of the distinction.
test fn w_a_precondition_established_by_an_input_refuses() -> Bool {
  refuses_with_exactly_named_cause(
    a: fixture_with_firmware(f: firmware_contract_with(p: product.compute_board.article.HostFirmwareStartPrecondition {
      kind: PowerPermitAsserted,
      establishment: product.compute_board.article.EstablishedByBoardSignal { signal: in_signal },
    })),
    wanted: "PreconditionSignalIsNotAnOutput"
  )
}

test fn w_a_precondition_on_a_declared_output_is_admitted() -> Bool {
  is_admitted(a: fixture_with_firmware(f: firmware_contract_with(p: product.compute_board.article.HostFirmwareStartPrecondition {
    kind: PowerPermitAsserted,
    establishment: product.compute_board.article.EstablishedByBoardSignal { signal: out_signal },
  })))
}

// A NET MEMBER FROM ANOTHER BOARD, WHICH THE DESIGN AXIS ALONE DOES NOT CATCH. Scoped identities
// make the two boards' terminals unequal, so a foreign member is never FOUND on this net -- and a
// membership question that always answers no, for a reason nothing states, is the silent half of
// the state space. This is the loud half. The fixture is otherwise the coherent article, so the
// only thing that changed is which design the member's component belongs to.
test fn w_a_net_member_from_another_board_refuses() -> Bool {
  let elsewhere: product.electrical.connectivity.ElectricalDesignIdentity = "test.compute_board_admission.other_board" as product.electrical.connectivity.ElectricalDesignIdentity
  let foreign = product.electrical.connectivity.ElectricalTerminalRef {
    component: component_instance_identity(design: elsewhere, local_identity: "r_top"),
    terminal: "1" as product.electrical.connectivity.TerminalIdentity,
  }
  let spliced = product.compute_board.analog.AnalogCircuitIntent {
    title: coherent_analog.title,
    components: coherent_analog.components,
    nets: [product.electrical.connectivity.ElectricalNet {
      identity: net_identity(design: fixture_design, local_identity: "spliced"),
      members: [foreign],
    }] + coherent_analog.nets,
  }
  refuses_with_exactly_named_cause(
    a: fixture_article(analog: spliced, reference: b_net, control: coherent_control, bonds: []),
    wanted: "NetMemberBelongsToAnotherDesign"
  )
}
