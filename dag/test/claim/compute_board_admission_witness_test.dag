module test.claim.compute_board_admission_witness


data fixture_design: product.electrical.connectivity.ElectricalDesignIdentity = "test.compute_board_admission.fixture" as product.electrical.connectivity.ElectricalDesignIdentity

data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

// EACH FIXTURE PLANTS EXACTLY ONE DEFECT into an otherwise coherent article, and asserts the
// cause NAMED for it rather than merely that something refused. A witness asserting only "it
// refused" passes when every planted defect trips one over-broad cause, which is how a set of
// distinct causes decays into a single catch-all nobody notices has swallowed the others.

data a_net: product.electrical.connectivity.NetIdentity = net_identity(design: fixture_design, local_identity: "a")

data b_net: product.electrical.connectivity.NetIdentity = net_identity(design: fixture_design, local_identity: "b")

data r_one: product.compute_board.analog.ElectricalComponentInstance = product.compute_board.analog.ResistorInstance {
  identity: component_instance_identity(design: fixture_design, local_identity: "r1"),
  part: "series resistor",
  positive_terminal: "1" as product.electrical.connectivity.TerminalIdentity,
  negative_terminal: "2" as product.electrical.connectivity.TerminalIdentity,
  resistance: std.measure.Measure { count: 10 },
}

data c_one: product.compute_board.analog.ElectricalComponentInstance = product.compute_board.analog.CapacitorInstance {
  identity: component_instance_identity(design: fixture_design, local_identity: "c1"),
  part: "filter capacitor",
  positive_terminal: "1" as product.electrical.connectivity.TerminalIdentity,
  negative_terminal: "2" as product.electrical.connectivity.TerminalIdentity,
  capacitance: std.measure.Measure { count: 100 },
}

// A resistor sharing r1's identity. Nothing distinguishes it downstream: a model binding, a net
// member or a receipt naming "r1" cannot say which of the two it means.
data r_one_again: product.compute_board.analog.ElectricalComponentInstance = product.compute_board.analog.ResistorInstance {
  identity: component_instance_identity(design: fixture_design, local_identity: "r1"),
  part: "second series resistor",
  positive_terminal: "1" as product.electrical.connectivity.TerminalIdentity,
  negative_terminal: "2" as product.electrical.connectivity.TerminalIdentity,
  resistance: std.measure.Measure { count: 47 },
}

data coherent_analog: product.compute_board.analog.AnalogCircuitIntent = product.compute_board.analog.AnalogCircuitIntent {
  title: "admission fixture",
  components: [r_one, c_one],
  nets: [
    product.electrical.connectivity.ElectricalNet {
      identity: a_net,
      members: [
        terminal_ref(component: component_instance_identity(design: fixture_design, local_identity: "r1"), terminal: "1" as product.electrical.connectivity.TerminalIdentity),
        terminal_ref(component: component_instance_identity(design: fixture_design, local_identity: "c1"), terminal: "1" as product.electrical.connectivity.TerminalIdentity),
      ],
    },
    product.electrical.connectivity.ElectricalNet {
      identity: b_net,
      members: [
        terminal_ref(component: component_instance_identity(design: fixture_design, local_identity: "r1"), terminal: "2" as product.electrical.connectivity.TerminalIdentity),
        terminal_ref(component: component_instance_identity(design: fixture_design, local_identity: "c1"), terminal: "2" as product.electrical.connectivity.TerminalIdentity),
      ],
    },
  ],
}

data in_signal: product.compute_board.digital_control.SignalName = "d_in" as product.compute_board.digital_control.SignalName

data out_signal: product.compute_board.digital_control.SignalName = "d_out" as product.compute_board.digital_control.SignalName

data coherent_control: product.compute_board.digital_control.DigitalControlIntent = product.compute_board.digital_control.DigitalControlIntent {
  block_name: "fixture_block" as product.compute_board.digital_control.SignalName,
  signals: [
    product.compute_board.digital_control.DigitalSignal { name: in_signal, direction: DigitalInput },
    product.compute_board.digital_control.DigitalSignal { name: out_signal, direction: DigitalOutput },
  ],
  equations: [
    product.compute_board.digital_control.DigitalEquation { driven: out_signal, expression: product.compute_board.digital_control.Negation { operand: product.compute_board.digital_control.SignalRef { signal: in_signal } } },
  ],
}

// The fixture's firmware contract deliberately establishes nothing at the board. The production
// contract names power_permit and reset_release, which this fixture's two-signal control does not
// declare — and the join refuses exactly that, so reusing the production contract here would have
// planted two extra causes in every fixture below.
data fixture_firmware_contract: product.compute_board.article.PlatformFirmwareContract = product.compute_board.article.PlatformFirmwareContract {
  start_preconditions: [],
  write_protection: board_power_interlock_firmware_contract.write_protection,
  development_image_trust: board_power_interlock_firmware_contract.development_image_trust,
  production_signing: board_power_interlock_firmware_contract.production_signing,
}

fn fixture_article(
  analog: product.compute_board.analog.AnalogCircuitIntent,
  reference: product.electrical.connectivity.NetIdentity,
  control: product.compute_board.digital_control.DigitalControlIntent,
  bonds: List<product.compute_board.article.ElectricalBond>
) -> product.compute_board.article.BoardPowerInterfaceArticle {
  product.compute_board.article.BoardPowerInterfaceArticle {
    identity: product.compute_board.article.BoardArticleIdentity { name: "admission fixture", revision: "0" },
    analog: analog,
    model_bindings: [],
    reference_net: reference,
    digital_control: control,
    bonds: bonds,
    platform_firmware: fixture_firmware_contract,
    physical: board_power_interlock_physical,
    manufacturing: board_power_interlock_manufacturing,
  }
}

data coherent_fixture: product.compute_board.article.BoardPowerInterfaceArticle = fixture_article(analog: coherent_analog, reference: b_net, control: coherent_control, bonds: [])

fn is_admitted(a: product.compute_board.article.BoardPowerInterfaceArticle) -> Bool {
  match admit_board_article(a: a) {
    BoardArticleAdmitted { article: _ } => true
    BoardArticleRefused { causes: _ } => false
  }
}

// The positive control. Without it every refusal claim below is satisfied by an admission
// function that refuses everything.
test fn w_a_coherent_fixture_is_admitted() -> Bool {
  is_admitted(a: coherent_fixture)
}

// Exactly one cause, and it is the named one. "Contains the cause" would pass on an admission
// that reports every cause for every article.
test fn w_two_components_sharing_an_identity_refuse() -> Bool {
  refuses_with_exactly_named_cause(
    a: fixture_article(analog: duplicate_component_analog, reference: b_net, control: coherent_control, bonds: []),
    wanted: "DuplicateComponentIdentity"
  )
}

data duplicate_component_analog: product.compute_board.analog.AnalogCircuitIntent = product.compute_board.analog.AnalogCircuitIntent {
  title: "admission fixture",
  components: [r_one, c_one, r_one_again],
  nets: coherent_analog.nets,
}

data duplicate_net_analog: product.compute_board.analog.AnalogCircuitIntent = product.compute_board.analog.AnalogCircuitIntent {
  title: "admission fixture",
  components: coherent_analog.components,
  nets: concat(coherent_analog.nets, [product.electrical.connectivity.ElectricalNet { identity: a_net, members: [] }]),
}

test fn w_two_nets_sharing_an_identity_refuse() -> Bool {
  refuses_with_exactly_named_cause(
    a: fixture_article(analog: duplicate_net_analog, reference: b_net, control: coherent_control, bonds: []),
    wanted: "DuplicateNetIdentity"
  )
}

data dangling_member_analog: product.compute_board.analog.AnalogCircuitIntent = product.compute_board.analog.AnalogCircuitIntent {
  title: "admission fixture",
  components: coherent_analog.components,
  nets: [
    product.electrical.connectivity.ElectricalNet {
      identity: a_net,
      members: [terminal_ref(component: component_instance_identity(design: fixture_design, local_identity: "r9"), terminal: "1" as product.electrical.connectivity.TerminalIdentity)],
    },
    product.electrical.connectivity.ElectricalNet { identity: b_net, members: [] },
  ],
}

test fn w_a_net_member_naming_no_terminal_refuses() -> Bool {
  refuses_with_exactly_named_cause(
    a: fixture_article(analog: dangling_member_analog, reference: b_net, control: coherent_control, bonds: []),
    wanted: "NetMemberNamesNoTerminal"
  )
}

// The BRAND does not catch this and was never claimed to: "r1" and "r9" are both perfectly good
// ComponentInstanceIdentity values. What the brand buys is that a chassis feature cannot be
// compared to one; what admission buys is that a typo in either is located.
test fn w_the_terminal_number_is_checked_not_only_the_component() -> Bool {
  refuses_with_exactly_named_cause(
    a: fixture_article(
      analog: product.compute_board.analog.AnalogCircuitIntent {
        title: "admission fixture",
        components: coherent_analog.components,
        nets: [
          product.electrical.connectivity.ElectricalNet {
            identity: a_net,
            members: [terminal_ref(component: component_instance_identity(design: fixture_design, local_identity: "r1"), terminal: "3" as product.electrical.connectivity.TerminalIdentity)],
          },
          product.electrical.connectivity.ElectricalNet { identity: b_net, members: [] },
        ],
      },
      reference: b_net,
      control: coherent_control,
      bonds: []
    ),
    wanted: "NetMemberNamesNoTerminal"
  )
}

test fn w_a_reference_net_that_is_not_declared_refuses() -> Bool {
  refuses_with_exactly_named_cause(
    a: fixture_article(
      analog: coherent_analog,
      reference: net_identity(design: fixture_design, local_identity: "not_a_net"),
      control: coherent_control,
      bonds: []
    ),
    wanted: "ReferenceNetNotDeclared"
  )
}

test fn w_a_bond_on_a_nonexistent_terminal_refuses() -> Bool {
  refuses_with_exactly_named_cause(
    a: fixture_article(
      analog: coherent_analog,
      reference: b_net,
      control: coherent_control,
      bonds: [product.compute_board.article.PowerReturnConnection {
        domain: b_net,
        terminal: terminal_ref(component: component_instance_identity(design: fixture_design, local_identity: "r7"), terminal: "1" as product.electrical.connectivity.TerminalIdentity),
      }]
    ),
    wanted: "BondTerminalNamesNoTerminal"
  )
}

test fn w_a_bond_on_an_undeclared_net_refuses() -> Bool {
  refuses_with_exactly_named_cause(
    a: fixture_article(
      analog: coherent_analog,
      reference: b_net,
      control: coherent_control,
      bonds: [product.compute_board.article.PowerReturnConnection {
        domain: net_identity(design: fixture_design, local_identity: "nowhere"),
        terminal: terminal_ref(component: component_instance_identity(design: fixture_design, local_identity: "r1"), terminal: "2" as product.electrical.connectivity.TerminalIdentity),
      }]
    ),
    wanted: "BondNamesUndeclaredNet"
  )
