test fn w_two_signals_sharing_a_name_refuse() -> Bool {
  refuses_with_exactly_named_cause(
    a: fixture_article(
      analog: coherent_analog,
      reference: b_net,
      control: product.compute_board.digital_control.DigitalControlIntent {
        block_name: coherent_control.block_name,
        signals: concat(coherent_control.signals, [product.compute_board.digital_control.DigitalSignal { name: out_signal, direction: DigitalOutput }]),
        equations: coherent_control.equations,
      },
      bonds: []
    ),
    wanted: "DuplicateSignalName"
  )
}

test fn w_driving_an_undeclared_signal_refuses() -> Bool {
  refuses_with_exactly_named_cause(
    a: fixture_article(
      analog: coherent_analog,
      reference: b_net,
      control: product.compute_board.digital_control.DigitalControlIntent {
        block_name: coherent_control.block_name,
        signals: coherent_control.signals,
        equations: concat(coherent_control.equations, [product.compute_board.digital_control.DigitalEquation {
          driven: "ghost" as product.compute_board.digital_control.SignalName,
          expression: product.compute_board.digital_control.SignalRef { signal: in_signal },
        }]),
      },
      bonds: []
    ),
    wanted: "DrivenSignalUndeclared"
  )
}

// Driving an INPUT is a direction contradiction, not a missing declaration, and the two have
// opposite remedies — declare the signal, or stop driving it. One cause covering both would tell
// the reader nothing about which.
test fn w_driving_an_input_refuses_as_a_direction_conflict() -> Bool {
  refuses_with_exactly_named_cause(
    a: fixture_article(
      analog: coherent_analog,
      reference: b_net,
      control: product.compute_board.digital_control.DigitalControlIntent {
        block_name: coherent_control.block_name,
        signals: coherent_control.signals,
        equations: concat(coherent_control.equations, [product.compute_board.digital_control.DigitalEquation {
          driven: in_signal,
          expression: product.compute_board.digital_control.SignalRef { signal: out_signal },
        }]),
      },
      bonds: []
    ),
    wanted: "DrivenSignalIsAnInput"
  )
}

test fn w_an_equation_over_an_undeclared_signal_refuses() -> Bool {
  refuses_with_exactly_named_cause(
    a: fixture_article(
      analog: coherent_analog,
      reference: b_net,
      control: product.compute_board.digital_control.DigitalControlIntent {
        block_name: coherent_control.block_name,
        signals: coherent_control.signals,
        equations: [product.compute_board.digital_control.DigitalEquation {
          driven: out_signal,
          expression: product.compute_board.digital_control.Conjunction {
            left: product.compute_board.digital_control.SignalRef { signal: in_signal },
            right: product.compute_board.digital_control.SignalRef { signal: "phantom" as product.compute_board.digital_control.SignalName },
          },
        }],
      },
      bonds: []
    ),
    wanted: "EquationReferencesUndeclaredSignal"
  )
}

