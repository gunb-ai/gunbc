module test.claim.githooks_pre_push_emit_residual_census

// THE PRE-PUSH CONCAT RESIDUAL IS ENROLLED IN THE PRODUCTION ROSTER FOLD. This claim runs
// gunbc.census_closure_frontier.census_closure_frontier_rows() — the fold that
// gunbc.dissolution_census.dissolution_census_verdict() resolves against the live declaration
// index — and finds exactly one row whose subject is the concat body
// (gunbc.githooks.githooks_pre_push_emit.expected_githooks_pre_push_sh), reading that row's
// trigger through dissolution_description to confirm it is the emitter-vocabulary trigger (the
// grammar module it names and the eight forms it lists). Matching the FOLD by the subject's
// decl_ref — not by a hand-authored list — is what makes it discriminating (§4b: no green-by-
// construction; §5: a discriminating input that goes red): deleting the row from
// gunbc.githooks.githooks_pre_push_frontier, or dropping the registration from
// gunbc.census_closure_frontier.census_closure_frontier_row_groups(), takes the row out of the
// fold and reddens this claim while every module still compiles. This module imports NEITHER
// gunbc.githooks.githooks_pre_push_emit nor gunbc.githooks.githooks_pre_push_frontier — the
// only githooks dependency is the subject key spelled as strings, so row deletion is a claim
// failure, not a compile error.
//
// The trigger's full text (all eight named emitter forms, the scaffold's binding) is checked by
// the sibling claim test.claim.githooks_pre_push_emit.witness_carrier_reader_reads_the_row,
// which imports the row value and executes dissolution_description on it.

import std.dissolution { dissolution_description }
import std.roster_frontier { FrontierRow, DeclSubject, PathSubject }
import std.types { Bool }
import std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import gunbc.census_closure_frontier { census_closure_frontier_rows }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

fn has(s: String, p: String) -> Bool {
  string_contains(s: s, pattern: p)
}

fn concat_body_subject(row: FrontierRow) -> Bool {
  match row.subject {
    DeclSubject { ref: r } =>
      (r.module_path as String) == "gunbc.githooks.githooks_pre_push_emit"
        && (r.decl_name as String) == "expected_githooks_pre_push_sh"
    PathSubject { path: _ } => false
  }
}

test fn witness_concat_body_is_counted_residual() -> Bool {
  let rows = filter(census_closure_frontier_rows(), row => concat_body_subject(row: row))
  (length(xs: rows) == 1)
    && all(rows, row =>
      has(s: dissolution_description(condition: row.dissolution), p: "dissolve-on")
        && has(s: dissolution_description(condition: row.dissolution), p: "gunbc.languages.bash")
        && !(row.reason as String == ""))
}
