module test.claim.githooks_pre_push_emit_residual_census

// THE PRE-PUSH CONCAT RESIDUAL IS ENROLLED IN THE PRODUCTION ROSTER FOLD. This claim runs
// gunbc.census_closure_frontier.census_closure_frontier_rows() — the fold that
// gunbc.dissolution_census.dissolution_census_verdict() resolves against the live declaration
// index — and finds the concat body's row with its trigger. Enrollment, not existence: the row
// is counted because the census reads it, the same way job_admission_witness's
// admission_frontiers_reach_the_dissolution_census counts its rows. Deleting the registration
// from gunbc.census_closure_frontier.census_closure_frontier_row_groups() — or deleting the
// frontier module's row — reddens this claim while every module still compiles (this module
// imports the row VALUES, so the fold keeps building either way; what breaks is the count).
//
// The trigger text itself is checked by the sibling claim
// test.claim.githooks_pre_push_emit.witness_carrier_reader_reads_the_row, which executes
// dissolution_description on the row and refuses when a named emitter form, the grammar module,
// or the scaffold's binding is missing from it.

import std.roster_frontier { FrontierRow }
import gunbc.census_closure_frontier { census_closure_frontier_rows }
import gunbc.githooks.githooks_pre_push_frontier { githooks_pre_push_concat_body_frontier_rows }
import std.types { Bool, List }
import std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

fn frontier_enrolled_once(row: FrontierRow) -> Bool {
  count(filter(census_closure_frontier_rows(), enrolled => enrolled == row)) == 1
}

test fn witness_concat_body_is_counted_residual() -> Bool {
  all(githooks_pre_push_concat_body_frontier_rows(), row => frontier_enrolled_once(row: row))
}
