data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn sa_email_derives_gunbai_secrets_and_operator_prose_slipped() -> Bool {
  project_id_from_sa_email_is_gunbai_secrets(email: fleet_cloud_convergence_sa_email)
    && project_id_from_sa_email_is_gunbai_secrets(email: gunbai_ci_secrets_sa_email)
    && operator_prose_disagrees_with_sa_derived_project_id()
    && operator_prose_project_name_slip as String != fleet_secrets_gcp_project as String
}

test fn unread_project_is_a_named_gap_not_an_absence() -> Bool {
  let census = operator_audit_census()
  census_gap_count(census: census) != 0
    && gunbai_auto_provider_condition_is_tight_legacy_repo()
    && match gunbai_auto_legacy_federation_hygiene() {
      CorrectlyScopedPossiblyInertUndeclared {
        pool_project_number: n,
        pool_id: _,
        provider_id: _,
        federated_repo: repo,
        modeled_repo: current,
      } =>
        n == unread_project_number_314501921854 as String
          && repo == "gunb-ai/gunb.ai"
          && current == "gunb-ai/gunbc"
    }
    && secrets_github_pool_condition_is_the_malformed_one()
}

test fn fleet_automation_has_no_wif_binding_in_the_audit() -> Bool {
  fleet_automation_has_no_principal_set_binding(census: operator_audit_census())
}

test fn github_pool_provider_id_is_a_gap_not_an_invented_row() -> Bool {
  secrets_github_pool_condition_is_the_malformed_one()
    && observed_secrets_github_pool_provider.provider_id as String == "github"
    && observed_github_oidc_provider.provider_id as String == "github-oidc"
    && operator_audit_census().wif_providers.length() == 5
    && copied_malformed_condition_has_three_instances()
}

test fn unread_project_is_enumerated_unobserved_and_a_named_gap() -> Bool {
  let census = operator_audit_census()
  let number = unread_project_number_314501921854 as String
  census_subject_is_enumerated_project_number(census: census, number: number)
    && census_subject_is_observed_project_number(census: census, number: number)
    && !census_subject_is_named_gap(census: census, subject: concat("projects/", number))
}

test fn observed_project_is_enumerated_observed_and_not_a_gap() -> Bool {
  let census = operator_audit_census()
  census_subject_is_enumerated_project_number(census: census, number: "582015116396")
    && census_subject_is_observed_project_number(census: census, number: "582015116396")
    && !census_subject_is_named_gap(census: census, subject: "projects/582015116396")
}

test fn a_project_outside_the_census_is_not_enumerated() -> Bool {
  let census = operator_audit_census()
  !census_subject_is_enumerated_project_number(census: census, number: "999999999999")
    && !census_subject_is_observed_project_number(census: census, number: "999999999999")
    && !census_subject_is_named_gap(census: census, subject: "projects/999999999999")
}

test fn cited_project_enumerated_as_gap_is_not_outstanding() -> Bool {
  census_cited_but_unenumerated_projects(census: operator_audit_census()).length() == 0
}

test fn cited_project_without_gap_is_outstanding() -> Bool {
  let outstanding = census_cited_but_unenumerated_projects(
    census: operator_audit_census_without_unread_project_gap(),
  )
  outstanding.length() == 1
    && fold(
      outstanding,
      init: false,
      f: fn(acc, n) { acc || n as String == unread_project_number_314501921854 as String },
    )
}

test fn undecomposable_principal_set_is_unparsed_not_a_non_set() -> Bool {
  match principal_set_citation(member: "principalSet://iam.googleapis.com/some/unfamiliar/shape") {
    PrincipalSetUnparsed { member: _ } => true
    MemberIsNotAPrincipalSet { member: _ } => false
    PrincipalSetCitesProject { project_number: _, pool_id: _ } => false
  }
}

test fn undecomposable_principal_set_is_rostered() -> Bool {
  census_unparsed_principal_set_members(census: census_with_unparsed_principal_set_binding()).length() == 1
}

test fn undecomposable_principal_set_is_not_a_same_project_edge() -> Bool {
  let edges = census_edges(census: census_with_unparsed_principal_set_binding())
  fold(edges, init: false, f: fn(acc, e) { acc || edge_is_unparsed_principal_set(edge: e) })
    && !fold(edges, init: false, f: fn(acc, e) { acc || edge_is_cross_project(edge: e) })
}

test fn principal_set_parser_extracts_cross_project_number() -> Bool {
  match principal_set_pool_project_number(
    member: concat(
      concat("principalSet://iam.googleapis.com/projects/", unread_project_number_314501921854 as String),
      "/locations/global/workloadIdentityPools/x/attribute.repository/gunb-ai/gunb.ai",
    ),
  ) {
    Present { value: n } => n == unread_project_number_314501921854 as String
    Absent => false
  }
}

test fn census_edges_make_the_cross_project_bindings_loud() -> Bool {
  let census = operator_audit_census()
  census_cross_project_binding_count(census: census) == 3
    && fold(
      census_edges(census: census),
      init: false,
      f: fn(acc, e) { acc || edge_is_cross_project(edge: e) },
    )
}

test fn desired_pool_is_noop_provider_unread_binding_absent() -> Bool {
  let census = operator_audit_census()
  match classify_desired_wif_pool(desired: gcp_estate_desired_github_actions_pool(), census: census) {
    UpsertClassification { verdict: Converged, decision: Noop } =>
      match classify_desired_wif_provider(desired: gcp_estate_desired_github_oidc_provider(), census: census) {
        UpsertClassification { verdict: Converged, decision: Noop } =>
          match classify_desired_binding(
            desired: gcp_estate_desired_convergence_binding(),
            census: census,
          ) {
            UpsertClassification { verdict: Converged, decision: Noop } => true
            _ => false
          }
        _ => false
      }
    _ => false
  }
}

data fixture_oidc_narrow: ObservedWifProvider = ObservedWifProvider {
  project_number: "582015116396",
  pool_id: "github-actions" as NonEmptyStr,
  provider_id: "github-oidc" as NonEmptyStr,
  issuer_uri: "https://token.actions.githubusercontent.com",
  attribute_condition: "assertion.repository == 'gunb-ai/gunbc'",
}

data fixture_oidc_wide: ObservedWifProvider = ObservedWifProvider {
  project_number: "582015116396",
  pool_id: "github-actions" as NonEmptyStr,
  provider_id: "github-oidc" as NonEmptyStr,
  issuer_uri: "https://token.actions.githubusercontent.com",
  attribute_condition: "true",
}

test fn editing_an_attribute_condition_changes_the_census_identity() -> Bool {
  let before = census_with_observed_provider(provider: fixture_oidc_narrow)
  let after = census_with_observed_provider(provider: fixture_oidc_wide)
  census_measured_fingerprint_eq(left: before, right: before)
    && !census_measured_fingerprint_eq(left: before, right: after)
}

test fn a_gap_and_an_observation_under_one_key_are_different_measurements() -> Bool {
  let observed = census_with_observed_pool(pool: observed_github_pool)
  let gapped = census_with_unread_pool_gap()
  !census_measured_fingerprint_eq(left: observed, right: gapped)
}

test fn two_gap_causes_under_one_key_are_different_measurements() -> Bool {
  !census_measured_fingerprint_eq(
    left: census_with_unread_pool_gap(),
    right: census_with_refused_pool_gap(),
  )
}

test fn github_pool_and_cross_project_bindings_are_undeclared_and_refused() -> Bool {
  let census = operator_audit_census()
  let findings = undeclared_findings(roster: gcp_estate_desired_roster(), census: census)
  findings.length() >= 3
    && fold(findings, init: true, f: fn(acc, f) { acc && undeclared_decision_never_applies(finding: f) })
    && fold(
      findings,
      init: false,
      f: fn(acc, f) {
        acc || match classify_undeclared(finding: f) {
          UpsertClassification { verdict: Conflict, decision: Refuse { reason: r } } =>
            (r as String).contains("undeclared present")
          _ => false
        }
      },
    )
}

test fn drift_policy_is_explicit_per_kind() -> Bool {
  match drift_policy_for(kind: KindWifProvider) {
    DriftApplyUpdate =>
      match drift_policy_for(kind: KindEnabledService) {
        DriftRefuse { reason: r } => (r as String).contains("disabling")
        DriftApplyUpdate => false
      }
    DriftRefuse { reason: _ } => false
  }
}

test fn inaccessible_desired_subject_does_not_look_absent() -> Bool {
  match inaccessible_desired_subject() {
    UpsertClassification { verdict: Inaccessible, decision: Refuse { reason: r } } =>
      (r as String).contains("not readable")
    _ => false
  }
}

test fn sheets_calling_home_is_unresolved_and_does_not_default_to_secrets() -> Bool {
  sheets_calling_home_is_unresolved()
    && secrets_project_is_refused_as_sheets_api_surface()
    && fleet_automation_is_refused_as_sheets_writer()
    && gunbai_auto_is_not_selected_as_sheets_home()
    && match sheets_calling_home() {
      SheetsCallingHomeUnresolved {
        refused_api_surface_project: p,
        refused_writer: w,
        candidate_writer_in_secrets: c,
        kitchen_sink_project: k,
        pool_host_without_sts: auto,
        sts_host_without_sheets: ci,
      } =>
        p == fleet_secrets_gcp_project
          && w == fleet_automation_sa_email
          && c == fleet_cloud_convergence_sa_email
          && k == gunb_test_project_id
          && auto == gunbai_auto_project_id
          && ci == gunb_ci_project_id
    }
}

test fn gunb_test_and_other_projects_are_gaps_not_observed_homes() -> Bool {
  let census = operator_audit_census()
  gunb_test_is_enumerated_not_selected(census: census)
    && observed_project_roster_count(census: census) == 5
    && gunb_test_sheets_is_absent()
    && gunb_test_has_sts()
    && none_of_the_three_sandboxes_has_sheets()
    && sheets_home_is_create_purpose_scoped_unminted()
    && !gunbai_auto_has_sts()
    && gunb_ci_has_sts()
    && gunbai_auto_is_the_only_pool_host_without_sts()
    && gunbai_auto_enabled_service_ids.length() == 32
    && gunb_ci_enabled_service_ids.length() == 40
    && gunb_test_enabled_service_ids.length() == 27
    && gunbai_secrets_enabled_service_ids.length() == 27
    && census.service_accounts.length() == 25
    && custody_sas_with_no_wif_bindings(census: census)
    && !census_subject_is_named_gap(census: census, subject: "projects/gunbai-auto/serviceAccounts")
    && !census_subject_is_named_gap(census: census, subject: "gunbai-ci-workspace-admin@gunb-ci/keys?managed-by=user")
    && census_subject_is_named_gap(census: census, subject: gap_workspace_admin_domain_wide_delegation.subject_identity as String)
    && census_subject_is_named_gap(census: census, subject: gap_gemini_project_beyond_identity.subject_identity as String)
    && census_subject_is_named_gap(census: census, subject: gap_pool_creation_timestamps.subject_identity as String)
    && census_subject_is_named_gap(census: census, subject: gap_token_creator_binding_members.subject_identity as String)
    && sheets_leading_candidate_is_not_selected()
    && gunbai_auto_lacks_sts_while_ci_and_test_have_it()
    && gunb_test_is_deranked_scratch_not_a_sheets_candidate()
    && workspace_admin_display_name_says_test()
    && workspace_admin_has_no_gunb_ci_project_roles()
    && workspace_admin_has_no_user_managed_keys()
}

test fn two_github_pools_are_keyed_by_project_not_name() -> Bool {
  four_github_pools_are_keyed_by_project_number()
    && github_pool_id_does_not_discriminate_project(
      left: observed_github_pool,
      right: observed_gunbai_auto_github_pool,
    )
    && github_pool_id_does_not_discriminate_project(
      left: observed_gunb_ci_github_pool,
      right: observed_gunb_test_github_pool,
    )
    && gunbai_auto_sts_inert_is_not_established()
}

test fn unread_pool_rows_do_not_classify_desired_pool_as_absent() -> Bool {
  match classify_desired_wif_pool(
    desired: gcp_estate_desired_github_actions_pool(),
    census: census_with_unread_pool_gap(),
  ) {
    UpsertClassification { verdict: Inaccessible, decision: Refuse { reason: r } } =>
      (r as String).contains("not readable")
    _ => false
  }
}

test fn estate_rows_name_their_producer_and_stay_hand_observed() -> Bool {
  match estate_rows_are_hand_observed() {
    HandObserved { observed_at: at, observed_by: by } =>
      at == estate_observation_observed_at
        && by == estate_observation_observed_by
        && every_named_instrument_is_a_gcloud_read()
        && hand_observed_becomes_machine_observed_by_executing_the_named_instrument()
        && estate_readonly_credential_intervention().frequency == FleetOnce
        && (estate_readonly_credential_intervention().instruction as String).contains("MachineObserved")
    MachineObserved { producer_identity: _ } => false
  }
}
