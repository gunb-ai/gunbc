module test.claim.unimported_type_import_migrate_witness

import std.types { Bool, List, String }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import tools.source_reference_repoint { SourceEdit }
import tools.unimported_type_import_migrate {
  ExtendExistingProvider,
  ImportEdge,
  ImportMigrationAlreadyPresent,
  ImportMigrationApply,
  ImportMigrationCyclicDebt,
  ImportMigrationIdentity,
  ImportMigrationNativeBare,
  ImportMigrationParseRefused,
  ImportMigrationStanding,
  NewProviderLine,
  extend_existing_provider_edit,
  plan_identity,
  spelling_is_native_bare,
  splice_import_edits,
  std_coercion_import_identities,
  std_coercion_list_is_native_bare
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn probe_identity(name: String, provider: String) -> ImportMigrationIdentity {
  ImportMigrationIdentity {
    referencing_module: "probe.m",
    source_path: "probe.dag",
    name: name,
    provider: provider
  }
}

fn no_edges() -> List<ImportEdge> {
  []
}

fn is_extend(s: ImportMigrationStanding) -> Bool {
  match s {
    ImportMigrationApply { identity: _, kind: ExtendExistingProvider } => true
    ImportMigrationApply { identity: _, kind: NewProviderLine } => false
    ImportMigrationAlreadyPresent { identity: _ } => false
    ImportMigrationNativeBare { identity: _ } => false
    ImportMigrationCyclicDebt { identity: _ } => false
    ImportMigrationParseRefused { identity: _, cause: _ } => false
  }
}

fn is_new_line(s: ImportMigrationStanding) -> Bool {
  match s {
    ImportMigrationApply { identity: _, kind: NewProviderLine } => true
    ImportMigrationApply { identity: _, kind: ExtendExistingProvider } => false
    ImportMigrationAlreadyPresent { identity: _ } => false
    ImportMigrationNativeBare { identity: _ } => false
    ImportMigrationCyclicDebt { identity: _ } => false
    ImportMigrationParseRefused { identity: _, cause: _ } => false
  }
}

test fn a_missing_name_on_an_existing_import_extends_that_provider() -> Bool {
  is_extend(s: plan_identity(
    identity: probe_identity(name: "Char", provider: "std.types"),
    source: "module probe.m\nimport std.types { Bool }\n",
    edges: no_edges()
  ))
}

test fn an_absent_provider_plans_a_new_import_line() -> Bool {
  is_new_line(s: plan_identity(
    identity: probe_identity(name: "DeclarationRef", provider: "std.decl_ref"),
    source: "module probe.m\nimport std.types { Bool }\n",
    edges: no_edges()
  ))
}

test fn an_already_imported_name_is_already_present() -> Bool {
  match plan_identity(
    identity: probe_identity(name: "Char", provider: "std.types"),
    source: "module probe.m\nimport std.types { Char }\n",
    edges: no_edges()
  ) {
    ImportMigrationAlreadyPresent { identity: _ } => true
    ImportMigrationApply { identity: _, kind: _ } => false
    ImportMigrationNativeBare { identity: _ } => false
    ImportMigrationCyclicDebt { identity: _ } => false
    ImportMigrationParseRefused { identity: _, cause: _ } => false
  }
}

test fn a_comment_is_not_an_import_member() -> Bool {
  is_extend(s: plan_identity(
    identity: probe_identity(name: "Char", provider: "std.types"),
    source: "module probe.m\n// import std.types { Char }\nimport std.types { Bool }\n",
    edges: no_edges()
  ))
}

test fn a_native_bare_name_is_not_imported() -> Bool {
  spelling_is_native_bare(name: "List")
    && match plan_identity(
      identity: std_coercion_list_is_native_bare,
      source: "module std.coercion\nimport std.literal_elaboration { LiteralHomomorphism }\n",
      edges: no_edges()
    ) {
      ImportMigrationNativeBare { identity: _ } => true
      ImportMigrationApply { identity: _, kind: _ } => false
      ImportMigrationAlreadyPresent { identity: _ } => false
      ImportMigrationCyclicDebt { identity: _ } => false
      ImportMigrationParseRefused { identity: _, cause: _ } => false
    }
}

test fn a_cyclic_edge_is_typed_debt() -> Bool {
  match plan_identity(
    identity: ImportMigrationIdentity {
      referencing_module: "a.m",
      source_path: "a.dag",
      name: "T",
      provider: "b.m"
    },
    source: "module a.m\n",
    edges: [ImportEdge { importer: "b.m", imported: "a.m" }]
  ) {
    ImportMigrationCyclicDebt { identity: _ } => true
    ImportMigrationApply { identity: _, kind: _ } => false
    ImportMigrationAlreadyPresent { identity: _ } => false
    ImportMigrationNativeBare { identity: _ } => false
    ImportMigrationParseRefused { identity: _, cause: _ } => false
  }
}

test fn std_coercion_named_edges_are_not_cyclic_on_an_empty_graph() -> Bool {
  fold(std_coercion_import_identities, init: true, f: (acc, id) =>
    acc && match plan_identity(
      identity: id,
      source: "module std.coercion\nimport std.literal_elaboration { LiteralHomomorphism }\n",
      edges: no_edges()
    ) {
      ImportMigrationCyclicDebt { identity: _ } => false
      ImportMigrationNativeBare { identity: _ } => false
      ImportMigrationParseRefused { identity: _, cause: _ } => false
      ImportMigrationAlreadyPresent { identity: _ } => true
      ImportMigrationApply { identity: _, kind: _ } => true
    })
}

test fn extend_existing_provider_edit_is_a_source_edit_at_the_brace() -> Bool {
  match extend_existing_provider_edit(rbrace_start: 12, name: "Char") {
    SourceEdit { start: start, end: end, replacement: replacement } =>
      start == 12 && end == 12 && replacement == ", Char"
  }
}

test fn splice_import_edits_uses_the_repoint_applier() -> Bool {
  splice_import_edits(
    source: "import std.types { Bool }",
    edits: [extend_existing_provider_edit(rbrace_start: 24, name: "Char")]
  ) == "import std.types { Bool, Char }"
}
