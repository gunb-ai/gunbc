module test.claim.systemd_directive_value_grain

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// WHAT THESE WITNESSES COVER, given the carrier records a residue rather than repairing one.
//
// Two of the carrier's three findings are unenforceable by construction, and this file says so
// rather than faking coverage. The byte-form loss is LATENT -- every producer emits a plain count
// today, so there is no wrong state to detect. The five unmodeled sccache variable names cannot be
// checked without spelling the same literals a second time, which would pass by construction and
// prove nothing.
//
// What CAN be asserted is the SPLIT: that one upstream interface is currently named by two
// authorities. That reds when the split closes, which is the dissolution event, and it reds if the
// roster is collapsed to one side without the underlying work being done.
//
// An earlier version of this file asserted instead that each modeled variable name appears in the
// assignment composed from it. That check could not fail -- the composer builds the assignment FROM
// the row, so both sides move together -- and it was caught by mutating the row and watching the
// witness stay green. The carrier's own annotation carries that receipt.
test fn one_upstream_interface_is_named_by_two_authorities() -> Bool {
  environment_name_authority_is_split()
}

// THE DISCRIMINATING CONTROL FOR THE PREDICATE ITSELF. Inhabitance predicates are easy to write in
// a form that returns true for any non-empty list, so the roster is asserted to actually carry both
// tags at named members. Without this, environment_name_authority_is_split could be satisfied by a
// roster where every row carried the same authority and the predicate had a bug in one arm.
test fn the_roster_carries_both_authorities_at_named_members() -> Bool {
  (build_cache_environment_variables
     |> any(v => (v.name as String) == "SCCACHE_START_SERVER"
                   && match v.authority { ModeledUpstream => true SpelledInConsumer => false }))
    && (build_cache_environment_variables
          |> any(v => (v.name as String) == "SCCACHE_DIR"
                        && match v.authority { ModeledUpstream => false SpelledInConsumer => true }))
}

// THE TRIGGER MUST STAY UNBOUND, and this is asserted rather than left to prose because the
// pressure to bind it is real: a bound trigger looks more rigorous and every reviewer reads a
// DeclarationRetires as stronger. It would be wrong here. Both named declarations SURVIVE the
// completion with changed field types, so a retirement ref would be false, and an appearance ref
// would have to name a symbol nobody has declared. If this witness ever reds because the row was
// bound, the question to ask is which declaration was named and whether it exists.
test fn the_dissolution_stays_unbound_because_the_subject_survives() -> Bool {
  match systemd_directive_value_grain_dissolution {
    UnboundDissolution { description: d } => (d as String).contains("Environment")
    BoundDissolution { trigger: _ } => false
  }
}
