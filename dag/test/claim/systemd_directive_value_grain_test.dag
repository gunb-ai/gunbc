module test.claim.systemd_directive_value_grain

import gunbc.systemd_directive_value_grain {
  environment_name_authority_is_split,
  build_cache_environment_variables,
  ModeledUpstream, SpelledInConsumer,
  systemd_directive_value_grain_dissolution,
}
import std.dissolution { DissolutionCondition, BoundDissolution, UnboundDissolution }
import std.types { String, Bool }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data value_grain_witness_doc: String = "WHAT THESE WITNESSES COVER, given the carrier records a residue rather than repairing one. Two of the three claims in that carrier are unenforceable by construction and the file says so rather than faking coverage: the byte-form loss is LATENT -- every producer emits a plain count today, so there is no wrong state to detect -- and the five unmodeled sccache variable names cannot be checked without spelling the same literals a second time, which would pass by construction and prove nothing.\n\nWhat CAN be checked is the modeled half: the three variables whose names are rows in extdeps.cache.sccache must actually appear in the assignments that module composes. That is an identity join between two facts one authority holds, so it reds if a name row is renamed without its composer following, and it reds if a composer is rewritten to spell the name inline -- which is precisely the direction the finding says the other five already went."

// THE CLAIM IS ABOUT THE SPLIT, NOT ABOUT EITHER SIDE OF IT.
//
// An earlier version of this file asserted that each modeled variable name appears in the
// assignment composed from it. That check could not fail -- the composer builds the assignment FROM
// the row, so both sides move together -- and it was caught by mutating the row and watching the
// witness stay green. The carrier's the_join_i_tried_first_was_vacuous_note carries the receipt.
//
// This asserts instead that both authorities are currently inhabited: at least one variable named
// upstream and at least one named in the consumer. It reds when the split closes, which is the
// dissolution event, and it reds if the roster is ever collapsed to one side without the underlying
// work being done.
test fn one_upstream_interface_is_named_by_two_authorities() -> Bool {
  environment_name_authority_is_split()
}

// THE DISCRIMINATING CONTROL FOR THE PREDICATE ITSELF. Inhabitance predicates are easy to write in a
// form that returns true for any non-empty list, so the roster is asserted to actually contain both
// tags at named members. Without this, environment_name_authority_is_split could be satisfied by a
// roster where every row carried the same authority and the predicate had a bug in one arm.
test fn the_roster_carries_both_authorities_at_named_members() -> Bool {
  (build_cache_environment_variables
     |> any(v => (v.name as String) == "SCCACHE_START_SERVER"
                   && match v.authority { ModeledUpstream => true SpelledInConsumer => false }))
    && (build_cache_environment_variables
          |> any(v => (v.name as String) == "SCCACHE_DIR"
                        && match v.authority { ModeledUpstream => false SpelledInConsumer => true }))
}


// THE TRIGGER MUST STAY UNBOUND, and this is asserted rather than left to prose because the
// pressure to bind it is real: a bound trigger looks more rigorous and every reviewer reads a
// DeclarationRetires as stronger. It would be wrong here. Both named declarations SURVIVE the
// completion with changed field types, so a retirement ref would be false, and an appearance ref
// would have to name a symbol nobody has declared. If this witness ever reds because the row was
// bound, the question to ask is which declaration was named and whether it exists.
test fn the_dissolution_stays_unbound_because_the_subject_survives() -> Bool {
  match systemd_directive_value_grain_dissolution {
    UnboundDissolution { description: d } => (d as String).contains("Environment")
    BoundDissolution { trigger: _ } => false
  }
}
