module test.claim.principal_projection_witness_test


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn oidc_evidence() -> extdeps.auth.oidc.OidcIdTokenClaims {
  extdeps.auth.oidc.OidcIdTokenClaims {
    issuer: extdeps.auth.jwt.JwtUriString { value: "https://issuer.example" as std.types.NonEmptyStr, scheme: "https" as std.types.NonEmptyStr },
    subject: extdeps.auth.jwt.JwtBareString { value: "external-subject" as std.types.NonEmptyStr },
    audience: extdeps.auth.jwt.JwtAudienceSingle { value: extdeps.auth.jwt.JwtBareString { value: "client" as std.types.NonEmptyStr } },
    expires_at: extdeps.auth.jwt.NumericDateWholeSeconds { seconds: 2000 },
    issued_at: extdeps.auth.jwt.NumericDateWholeSeconds { seconds: 1000 },
    auth_time: none, nonce: none, acr: none, amr: none, azp: none, session_id: none,
    standard: extdeps.auth.oidc.OidcStandardClaims { email: none, email_verified: none, name: none },
  }
}

test fn oidc_principal_is_exact_issuer_subject_projection_with_evidence_retained() -> Bool {
  let claims = oidc_evidence()
  let projection = gunbc.principal_projection.oidc_principal_projection(claims: claims)
  match gunbc.principal_projection.projected_principal(projection: projection) {
    gunbc.principal_projection.PosixPrincipal { principal: _ } => false
    gunbc.principal_projection.OidcPrincipal { principal: principal } =>
      principal.issuer == claims.issuer && principal.subject == claims.subject
        && match projection {
          gunbc.principal_projection.OidcProjection { claims: retained } => retained == claims
          gunbc.principal_projection.PosixProjection { observation: _ } => false
        }
  }
}

test fn posix_principal_is_exact_effective_name_projection_with_evidence_retained() -> Bool {
  match extdeps.access.posix_effective_principal.effective_posix_principal_observation(
    outcome: extdeps.access.posix_effective_principal.EffectivePosixPrincipalReadOutcome {
      read: extdeps.access.posix_effective_principal.EffectivePosixPrincipalRead {}, exit_code: 0, success: true,
      stdout: "ghrunner\n", stderr: "",
    },
  ) {
    extdeps.access.posix_effective_principal.EffectivePosixPrincipalObservationRefused { read: _, reason: _ } => false
    extdeps.access.posix_effective_principal.EffectivePosixPrincipalObserved { observation: observation } => {
      let projection = gunbc.principal_projection.posix_principal_projection(observation: observation)
      match gunbc.principal_projection.projected_principal(projection: projection) {
        gunbc.principal_projection.OidcPrincipal { principal: _ } => false
        gunbc.principal_projection.PosixPrincipal { principal: principal } =>
          principal.effective_name == "ghrunner"
            && match projection {
              gunbc.principal_projection.OidcProjection { claims: _ } => false
              gunbc.principal_projection.PosixProjection { observation: retained } =>
                extdeps.access.posix_effective_principal.effective_posix_principal_name(observation: retained) == "ghrunner"
            }
      }
    }
  }
}

test fn posix_principal_observation_refuses_failed_or_empty_reads() -> Bool {
  let failed = extdeps.access.posix_effective_principal.effective_posix_principal_observation(
    outcome: extdeps.access.posix_effective_principal.EffectivePosixPrincipalReadOutcome {
      read: extdeps.access.posix_effective_principal.EffectivePosixPrincipalRead {}, exit_code: 1, success: false,
      stdout: "root", stderr: "whoami failed",
    },
  )
  let empty = extdeps.access.posix_effective_principal.effective_posix_principal_observation(
    outcome: extdeps.access.posix_effective_principal.EffectivePosixPrincipalReadOutcome {
      read: extdeps.access.posix_effective_principal.EffectivePosixPrincipalRead {}, exit_code: 0, success: true,
      stdout: "\n", stderr: "",
    },
  )
  (match failed {
    extdeps.access.posix_effective_principal.EffectivePosixPrincipalObserved { observation: _ } => false
    extdeps.access.posix_effective_principal.EffectivePosixPrincipalObservationRefused { read: _, reason: reason } => reason == "whoami failed"
  }) && (match empty {
    extdeps.access.posix_effective_principal.EffectivePosixPrincipalObserved { observation: _ } => false
    extdeps.access.posix_effective_principal.EffectivePosixPrincipalObservationRefused { read: _, reason: reason } =>
      reason == "successful effective-principal read returned no name"
  }
  )
}

test fn hermetic_posix_read_cannot_become_principal_evidence() -> Bool {
  match extdeps.access.posix_effective_principal.effective_posix_principal_observation(
    outcome: extdeps.access.posix_effective_principal_read_op.effective_posix_principal_read(read: extdeps.access.posix_effective_principal.EffectivePosixPrincipalRead {}),
  ) {
    extdeps.access.posix_effective_principal.EffectivePosixPrincipalObserved { observation: _ } => false
    extdeps.access.posix_effective_principal.EffectivePosixPrincipalObservationRefused { read: _, reason: reason } =>
      reason == "hermetic effective-principal observation unavailable"
  }
}
