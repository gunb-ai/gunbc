module test.claim.undeclared_bare_type_reference_class_witness

import std.types { String, Bool, Int, List }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import tools.multi_module_compile_fixture {
  MultiModuleCompileFixture,
  MultiModuleCompileFixtureOutcome,
  FixtureInstrumentRefused,
  FixtureCompileRefused,
  FixtureCompileCompleted,
  FixtureSource,
  fixture_source,
  compile_fixture,
  fixture_has_class,
  fixture_rows_of_class
}
import gunbc.compile_diagnostic_census { CompileDiagnosticCensusRow }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE CLASS: A TYPE NAME THAT RESOLVES ONLY BECAUSE ITS DEFINER HAPPENED TO BE IN THE POOL.
//
// A bare type position resolves against the whole module pool by global uniqueness rather than by
// import binding. So a module may name a type it never imports, and a WHOLE-CORPUS compile stays
// green: the definer is in the pool anyway, dragged there by some unrelated import elsewhere, and
// the name finds it. Under any NARROWER closure the definer is absent and the same source refuses
// -- pointing at the USING module, which reads like a corpus bug and is not one. Every tool that
// compiles a SUBSET pays this: the synthetic-fixture instruments today, and any projection
// machinery that has to compute a closure.
//
// WHY THE SUBJECT IS AUTHORED MODULES AND NOT CORPUS ONES. The obvious witness -- compile a real
// module's real closure and assert it succeeds -- was written first and MEASURED RED, twice over,
// for a reason that has nothing to do with any one module: at the order of one module in six, a
// closure of any interesting size contains several independent instances of this class, so the
// claim silently becomes "the whole corpus burndown is finished". That is a different and much
// larger subject, and a witness that cannot be green until it is finished is not a wall, it is a
// hostage. tools.multi_module_compile_fixture compiles a CALLER-AUTHORED manifest with no module
// index and no corpus roots, so the subject here is the resolution rule itself, at a grain fully
// under this file's control and immune to whatever else is in the tree.
//
// WHAT THIS DOES AND DOES NOT ANSWER, because the distinction is the whole point. It witnesses THE
// CLASS: an undeclared bare type reference refuses under a narrower closure, and the SAME source
// with the import line added compiles clean. It does NOT witness the repair of any particular
// corpus module -- that is a per-module subject, and the sizing of what remains is recorded at
// gunbc.compile_clean_diagnostic_policy unlisted_import_use_burndown_sizing beside the enforcement
// row that consumes it.
//
// THE DEFINER IS SUPPLIED IN BOTH MANIFESTS AND DELETING IT IS NOT A SIMPLIFICATION. The unimported
// name is a REAL declaration of a module present in the same manifest, so the only thing missing
// from the red arm is the import EDGE. Drop the definer to "simplify" the red manifest and the
// claim still goes red -- for an unresolvable SPELLING, which is a different class with its own
// wall -- and the probe would then be green for a reason that has nothing to do with import edges.
// The cost of that edit is the entire discriminating power of this file, and it is invisible: the
// test still passes.
//
// NO std.types IMPORT IN EITHER FIXTURE, and that is load-bearing rather than terseness. The
// instrument compiles the supplied manifest with NO corpus roots, so `import std.types { Int }`
// names a module that does not exist in the subject and refuses the whole compile -- including the
// positive control. That is how the first revision of this file was written and BOTH arms came back
// false in under 4ms; the control going red with the subject is exactly the signature of a broken
// harness rather than a real class, which is why the control is read first. Int needs no import:
// it is in kernel_type_set and every module sees it.

data ubtr_definer_source: String = "module ubtr.definer\n\ntype UbtrProvenance {\n  attempt: Int\n}\n"

data ubtr_user_without_import_source: String = "module ubtr.user\n\ntype UbtrRow {\n  provenance: UbtrProvenance\n  seq: Int\n}\n"

data ubtr_user_with_import_source: String = "module ubtr.user\n\nimport ubtr.definer { UbtrProvenance }\n\ntype UbtrRow {\n  provenance: UbtrProvenance\n  seq: Int\n}\n"

fn ubtr_run(user_source: String) -> MultiModuleCompileFixtureOutcome {
  compile_fixture(MultiModuleCompileFixture {
    sources: [
      fixture_source("ubtr/definer.dag", ubtr_definer_source),
      fixture_source("ubtr/user.dag", user_source)
    ],
    entry: "ubtr/user.dag"
  })
}

// THE OUTCOME IS READ BY MATCHING, NEVER BY AN ACCESSOR, so FixtureInstrumentRefused -- the arm
// that says the HARNESS broke rather than the subject -- cannot render as "zero diagnostics" on
// either side. Both readers return false on it, so a ragged manifest fails BOTH claims rather than
// silently satisfying the control.
fn ubtr_diagnosed_as(o: MultiModuleCompileFixtureOutcome, wanted: String) -> Bool {
  match o {
    FixtureCompileRefused { module_count: n, diagnostics: rows, source_digest: sd, compiler_digest: cd } =>
      fixture_has_class(rows: rows, wanted: wanted),
    FixtureCompileCompleted { module_count: n, emitted_files: files, resolved_rust_functions: _, diagnostics: rows, source_digest: sd, compiler_digest: cd } =>
      fixture_has_class(rows: rows, wanted: wanted),
    FixtureInstrumentRefused { cause: c } => false
  }
}

fn ubtr_completed_clean(o: MultiModuleCompileFixtureOutcome) -> Bool {
  match o {
    FixtureCompileCompleted { module_count: n, emitted_files: files, resolved_rust_functions: _, diagnostics: rows, source_digest: sd, compiler_digest: cd } =>
      count(rows) == 0 && count(files) > 0 && n > 0,
    FixtureCompileRefused { module_count: n, diagnostics: rows, source_digest: sd, compiler_digest: cd } => false,
    FixtureInstrumentRefused { cause: c } => false
  }
}

// THE DISCRIMINATING RED. ubtr.user names UbtrProvenance at a field position and imports it from
// nowhere. The definer is in the manifest, so the declaration EXISTS -- what is missing is only the
// import edge, which is exactly the corpus shape.
//
// THE CLASS IS PINNED, not inferred from the refusal shape. Measured through this fixture's own
// floor run, the supplied definer remains in the manifest pool, global uniqueness resolves the
// bare name, and the missing edge is classified as UnlistedImportUse. UnresolvedType would mean
// the declaration itself was unavailable, a different mechanism that must not satisfy this claim.
test fn bare_type_reference_without_import_is_diagnosed() -> Bool {
  ubtr_diagnosed_as(ubtr_run(ubtr_user_without_import_source), "UnlistedImportUse")
}

// THE POSITIVE CONTROL, and it is the same bytes plus one import line. Without it the red above is
// satisfied by a fixture that never compiled at all, by a harness that refuses every manifest, and
// by a definer whose own declaration is malformed -- three failures that look identical from the
// red side.
test fn the_same_source_with_the_import_line_compiles_clean() -> Bool {
  ubtr_completed_clean(ubtr_run(ubtr_user_with_import_source))
    && !ubtr_diagnosed_as(ubtr_run(ubtr_user_with_import_source), "UnlistedImportUse")
}

// THE KERNEL-FORMAL ARM. The advisory exists to charge an AUTHORED reference against the
// referencing module's import list. A call to an imported generic fn resolves the callee's
// kernel-minted formal node -- span and ident_span both <kernel:N>, inferred TypeVariable, no
// ident -- as a leaf in the CALLER's masked env, where the name resolves through the ancestry
// overlay (measured: ancestry_str_bindings carries an N binding whose resolved node is the
// kernel-span TypeVariable mint, while the caller listed no such name and source_visible_names
// rightly has no entry for it: the caller's text never mentions N). Measured pre-fix through this
// exact fixture: one UnlistedImportUse row
// naming N, the same shape the whole-tree census counted as 19 rows (17x N in
// test.claim.occurrence_binding_witness_test, 1x P, 1x Subject). No import list can discharge a
// reference no author wrote, so the emission site (v1.compiler.infer_resolve resolve_node_bounded)
// guards on v1.std.core resolved_node_is_kernel_identity_for_name -- the one kernel-identity
// authority, homed beside kernel_span -- and this arm is red exactly when that guard stops
// holding. The shape below is the minimal reproduction, reached by bisecting
// test.claim.occurrence_binding_witness_test: the generic CALL is load-bearing (a field chain on
// a plain param does not reach the leaf), and the nested record pattern is load-bearing (a let
// binding does not elaborate the formal).
data ubtr_generic_definer_source: String = "module ubtr.gdef\n\ntype UbtrMonoid<N>\n  = UbtrEmpty\n  | UbtrCons { head: N, tail: UbtrMonoid<N> }\n\ntype UbtrPath<N> {\n  ancestors: UbtrMonoid<N>\n  terminal: N\n}\n\ntype UbtrWrap<N> {\n  containment: UbtrPath<N>\n}\n\ntype UbtrInner<N> {\n  occurrence: UbtrWrap<N>\n  candidate: UbtrWrap<N>\n}\n\ntype UbtrResult<N>\n  = UbtrBound { binding: UbtrInner<N> }\n  | UbtrUnbound\n\nfn ubtr_combine<N>(occurrence: UbtrWrap<N>, candidates: UbtrMonoid<UbtrWrap<N>>) -> UbtrResult<N> {\n  UbtrBound { binding: UbtrInner { occurrence: occurrence, candidate: occurrence } }\n}\n"

data ubtr_generic_user_source: String = "module ubtr.guser\n\nimport ubtr.gdef { UbtrPath, UbtrWrap, UbtrInner, UbtrResult, UbtrBound, UbtrUnbound, UbtrMonoid, UbtrEmpty, UbtrCons, ubtr_combine }\n\nfn ubtr_mk(x: Int) -> UbtrWrap<Int> {\n  UbtrWrap { containment: UbtrPath { ancestors: UbtrEmpty, terminal: x } }\n}\n\nfn ubtr_probe() -> Int {\n  match ubtr_combine(occurrence: ubtr_mk(1), candidates: UbtrEmpty) {\n    UbtrBound { binding: UbtrInner { occurrence: o, candidate: c } } => o.containment.terminal\n    _ => 0\n  }\n}\n"

fn ubtr_generic_run() -> MultiModuleCompileFixtureOutcome {
  compile_fixture(MultiModuleCompileFixture {
    sources: [
      fixture_source("ubtr/gdef.dag", ubtr_generic_definer_source),
      fixture_source("ubtr/guser.dag", ubtr_generic_user_source)
    ],
    entry: "ubtr/guser.dag"
  })
}

// THE OUTCOME IS READ BY MATCHING, as above: FixtureInstrumentRefused means the HARNESS broke, and
// both refused arms answer false so a ragged manifest fails the claim rather than silently
// satisfying it. The assertion is the whole class over this fixture, not the formal alone: every
// name the user's text references is listed or kernel, so zero UnlistedImportUse rows of any name
// is the correct post-fix state, and a future regression charging a DIFFERENT synthetic name is
// caught here too.
test fn imported_generic_call_charges_no_unlisted_import_use_on_the_formal() -> Bool {
  match ubtr_generic_run() {
    FixtureCompileCompleted { module_count: n, emitted_files: files, resolved_rust_functions: _, diagnostics: rows, source_digest: sd, compiler_digest: cd } =>
      count(fixture_rows_of_class(rows: rows, wanted: "UnlistedImportUse")) == 0,
    FixtureCompileRefused { module_count: n, diagnostics: rows, source_digest: sd, compiler_digest: cd } => false,
    FixtureInstrumentRefused { cause: c } => false
  }
}

// THE IMPORTED-ALIAS ARM, the second wrong-env attribution shape. The census (2026-09-09,
// post-kernel-guard) carries ~316 occurrences whose charged name is ABSENT from the attributed
// module's text, with the span sitting in the DEFINER's file: an imported paramless type alias
// (CodexPackageLockNode = PackageLockNode<NpmLockPathKey, ...> in gunbc.package_delivery) whose
// expansion is resolved under the IMPORTER's masked env when the importer constructs through the
// alias, charging the definer-tree argument names against an import list that could never list
// them honestly -- the names are the definer's locals, and the definer's own module compiles
// clean. The masked-boundary authority (v1.compiler.infer_resolve
// resolve_node_bounded_masked_boundary) states the invariant this violates: grounding recursions
// descend into DEFINING-module structure with masked=false, because that structure is the
// defining module's import responsibility, not the use site's. This arm is red exactly while a
// path resolves the imported alias's expansion without flipping the mask.
data ubtr_alias_definer_source: String = "module ubtr.adef\n\ntype UbtrKey {\n  raw: Int\n}\n\ntype UbtrSel {\n  picked: Int\n}\n\ntype UbtrPackNode<K, S> {\n  key: K\n  sel: S\n}\n\ntype UbtrAliasedNode = UbtrPackNode<UbtrKey, UbtrSel>\n"

// THE CONSTRUCTION THROUGH THE ALIAS IS LOAD-BEARING, as it was at
// codex_package_lock_parse_witness_test.dag:142: a bare annotation (n: UbtrAliasedNode) resolves
// the alias as a leaf and stops at the nominal brand, but CONSTRUCTING the record forces the
// expansion to resolve so its fields can be checked -- and that expansion is the definer's tree.
// The user's text names only UbtrAliasedNode, which it lists; UbtrKey and UbtrSel never appear.
data ubtr_alias_user_source: String = "module ubtr.auser\n\nimport ubtr.adef { UbtrAliasedNode }\n\nfn ubtr_rebuild(n: UbtrAliasedNode) -> UbtrAliasedNode {\n  UbtrAliasedNode { key: n.key, sel: n.sel }\n}\n"

fn ubtr_alias_run() -> MultiModuleCompileFixtureOutcome {
  compile_fixture(MultiModuleCompileFixture {
    sources: [
      fixture_source("ubtr/adef.dag", ubtr_alias_definer_source),
      fixture_source("ubtr/auser.dag", ubtr_alias_user_source)
    ],
    entry: "ubtr/auser.dag"
  })
}

test fn constructing_through_an_imported_alias_charges_no_unlisted_import_use_on_the_expansion() -> Bool {
  match ubtr_alias_run() {
    FixtureCompileCompleted { module_count: n, emitted_files: files, resolved_rust_functions: _, diagnostics: rows, source_digest: sd, compiler_digest: cd } =>
      count(fixture_rows_of_class(rows: rows, wanted: "UnlistedImportUse")) == 0,
    FixtureCompileRefused { module_count: n, diagnostics: rows, source_digest: sd, compiler_digest: cd } => false,
    FixtureInstrumentRefused { cause: c } => false
  }
}

// THE QUALIFIED-USE ARM, the third emission shape the census's definer-resolvable column measures
// (242 occurrences, 107 pairs, 2026-09-09 post-alias-peel). A type-position reference spelled
// fully qualified -- `uses net: std.resources.Network`, or a child module naming its own parent
// (`v2.lens.complexity_accumulator_copy.analyze` naming
// `v2.lens.complexity_accumulator_copy.PortReading`) -- resolves through the symbol index, and the
// leaf mask check then looks the FULL qualified text up in source_visible_names, which only ever
// carries bare names (locals + kernel + listed names + is-all exports). So the row fires on EVERY
// masked qualified use, and -- measured on this exact shape pre-fix -- keeps firing after the
// import is added: no import-list edit can discharge it, which is the defect signature the two
// arms above already carry. The design's import-scoped policy is the opposite gate: "a module's
// import list says which QUALIFIED names are visible" (namespace-resolution-design.md section 7),
// so the fix is at the visibility map's construction: v1.compiler.infer build_type_env now also
// enters each imported name under its qualified spelling (selective: the listed names; is-all: the
// module's own interface names -- never ancestry names, which do not live at that path). A
// qualified use of an unlisted name or an unimported module still fires; only the spelling the
// import honestly declares goes quiet.
data ubtr_qualified_definer_source: String = "module ubtr.qdef\n\ntype UbtrQualified {\n  tag: Int\n}\n"

data ubtr_qualified_user_listed_source: String = "module ubtr.quser\n\nimport ubtr.qdef { UbtrQualified }\n\nfn ubtr_read(q: ubtr.qdef.UbtrQualified) -> Int {\n  q.tag\n}\n"

data ubtr_qualified_user_unlisted_source: String = "module ubtr.quser\n\nfn ubtr_read(q: ubtr.qdef.UbtrQualified) -> Int {\n  q.tag\n}\n"

fn ubtr_qualified_run(user_source: String) -> MultiModuleCompileFixtureOutcome {
  compile_fixture(MultiModuleCompileFixture {
    sources: [
      fixture_source("ubtr/qdef.dag", ubtr_qualified_definer_source),
      fixture_source("ubtr/quser.dag", user_source)
    ],
    entry: "ubtr/quser.dag"
  })
}

// THE DISCRIMINATING RED, pre-fix: the user lists UbtrQualified from ubtr.qdef and references it
// as ubtr.qdef.UbtrQualified -- the most explicit spelling of the same declaration -- and the
// emitter still charges it. Post-fix the row is gone.
test fn qualified_use_of_a_listed_import_charges_no_unlisted_import_use() -> Bool {
  match ubtr_qualified_run(ubtr_qualified_user_listed_source) {
    FixtureCompileCompleted { module_count: n, emitted_files: files, resolved_rust_functions: _, diagnostics: rows, source_digest: sd, compiler_digest: cd } =>
      count(fixture_rows_of_class(rows: rows, wanted: "UnlistedImportUse")) == 0,
    FixtureCompileRefused { module_count: n, diagnostics: rows, source_digest: sd, compiler_digest: cd } => false,
    FixtureInstrumentRefused { cause: c } => false
  }
}

// THE GATE STILL GATES: the same qualified spelling with NO import edge is precisely the genuine
// class -- the dependency is real and undeclared -- and must keep firing after the fix. This is
// the control that keeps the visibility-map change from widening into "qualified names are always
// fine", which would be the absorbing-fallback arm (DESIGN 5) wearing a repair's clothes.
test fn qualified_use_without_any_import_still_charges_unlisted_import_use() -> Bool {
  ubtr_diagnosed_as(ubtr_qualified_run(ubtr_qualified_user_unlisted_source), "UnlistedImportUse")
}

// ----------------------------------------------------------------------------------------------
// FALSE-NEGATIVE CONTROLS FOR THE THREE EMISSION REPAIRS (review finding 6, 2026-09-09).
//
// The three repair arms above prove the selected false-positive rows disappear. They say nothing
// about the boundary the repair must NOT cross: each repair widens an exclusion, and a widened
// exclusion that also swallows the nearby true-positive population is the absorbing fallback
// (DESIGN 5) wearing a repair's clothes. The arms below hold that boundary, one per repair, and
// each names the mutation it exists to red.
// ----------------------------------------------------------------------------------------------

// ONE SHARED READER: the count of diagnostics of a class charging one subject name. The census
// row aggregates by (class, subject_name) with an occurrence count, so "exactly one diagnostic
// naming N" is the sum over the matching rows, never the row count -- a class aggregated
// differently would read as one row over several occurrences and pass a row-count check while
// the population it reports on grew.
fn ubtr_subject_count(rows: List<CompileDiagnosticCensusRow>, wanted: String, subject: String) -> Int {
  fixture_rows_of_class(rows: rows, wanted: wanted)
    |> filter(r => r.subject_name == subject)
    |> fold(init: 0, f: fn(acc, r) { acc + r.count })
}

// THE NAME-COLLISION CONTROL FOR THE KERNEL-IDENTITY GUARD. The guard suppresses the charge when
// the RESOLVED BINDING is a kernel-minted identity -- an identity test
// (v1.std.core resolved_node_is_kernel_identity_for_name: the resolved node's ident span file
// is the kernel mint's own), never a NAME test. This arm authors the synthetic formal's own
// spelling (N, the formal the kernel arm above measures) as a REAL declaration in the definer and
// references it bare with no import edge. The binding is the corpus declaration, whose ident span
// is the definer's file, so the guard has no purchase and the charge must fire exactly once.
// MUTATION THIS ARM REDS: broadening the exception from identity-based to name-based -- any
// spelling test in place of the identity predicate -- silences this row.
data ubtr_kernel_collision_definer_source: String = "module ubtr.kdef\n\ntype N {\n  code: Int\n}\n"

data ubtr_kernel_collision_user_source: String = "module ubtr.kuser\n\ntype UbtrRowN {\n  payload: N\n  seq: Int\n}\n"

fn ubtr_kernel_collision_run() -> MultiModuleCompileFixtureOutcome {
  compile_fixture(MultiModuleCompileFixture {
    sources: [
      fixture_source("ubtr/kdef.dag", ubtr_kernel_collision_definer_source),
      fixture_source("ubtr/kuser.dag", ubtr_kernel_collision_user_source)
    ],
    entry: "ubtr/kuser.dag"
  })
}

test fn authored_reference_spelled_like_a_kernel_formal_still_charges_unlisted_import_use() -> Bool {
  match ubtr_kernel_collision_run() {
    FixtureCompileCompleted { module_count: n, emitted_files: files, resolved_rust_functions: _, diagnostics: rows, source_digest: sd, compiler_digest: cd } =>
      ubtr_subject_count(rows: rows, wanted: "UnlistedImportUse", subject: "N") == 1,
    // A terminal unresolved/ambiguous refusal satisfies the control as well: what must not
    // happen is the authored occurrence passing SILENTLY (the widened-exclusion state).
    FixtureCompileRefused { module_count: n, diagnostics: rows, source_digest: sd, compiler_digest: cd } =>
      fixture_has_class(rows: rows, wanted: "UnresolvedType")
        || fixture_has_class(rows: rows, wanted: "AmbiguousReference")
        || fixture_has_class(rows: rows, wanted: "UnlistedImportUse"),
    FixtureInstrumentRefused { cause: c } => false
  }
}

// THE USE-SITE ARGUMENT CONTROL FOR THE ALIAS PEEL. The peel resolves the imported alias's
// EXPANSION with masked=false because that tree is the definer's import responsibility. A
// use-site type argument is the opposite half of the boundary: authored by the user, resolved at
// the use site, and masked there by the standing authority (v1.compiler.infer_resolve
// resolve_node_bounded_masked_boundary -- the generic-args recursion inherits masked=true). This
// arm lists the alias and applies it to an authored argument the user does NOT list: exactly one
// UnlistedImportUse row, naming the argument, must fire, and no row may name the definer-internal
// half of the expansion (UbtrSel, which the expansion applies on the definer's behalf).
// MUTATION THIS ARM REDS: masked=false set one level too high, so the use-site arguments are
// unmasked along with the definer tree.
data ubtr_palias_definer_source: String = "module ubtr.pdef\n\ntype UbtrKey {\n  raw: Int\n}\n\ntype UbtrSel {\n  picked: Int\n}\n\ntype UbtrPackNode<K, S> {\n  key: K\n  sel: S\n}\n\ntype UbtrAliasOf<X> = UbtrPackNode<X, UbtrSel>\n"

data ubtr_palias_user_source: String = "module ubtr.puser\n\nimport ubtr.pdef { UbtrAliasOf, UbtrSel }\n\ntype UbtrHolder {\n  packed: UbtrAliasOf<UbtrKey>\n  own: UbtrSel\n}\n"

fn ubtr_palias_run() -> MultiModuleCompileFixtureOutcome {
  compile_fixture(MultiModuleCompileFixture {
    sources: [
      fixture_source("ubtr/pdef.dag", ubtr_palias_definer_source),
      fixture_source("ubtr/puser.dag", ubtr_palias_user_source)
    ],
    entry: "ubtr/puser.dag"
  })
}

test fn use_site_type_argument_through_an_imported_alias_still_charges_unlisted_import_use() -> Bool {
  match ubtr_palias_run() {
    FixtureCompileCompleted { module_count: n, emitted_files: files, resolved_rust_functions: _, diagnostics: rows, source_digest: sd, compiler_digest: cd } =>
      ubtr_subject_count(rows: rows, wanted: "UnlistedImportUse", subject: "UbtrKey") == 1
        && count(fixture_rows_of_class(rows: rows, wanted: "UnlistedImportUse")) == 1,
    FixtureCompileRefused { module_count: n, diagnostics: rows, source_digest: sd, compiler_digest: cd } => false,
    FixtureInstrumentRefused { cause: c } => false
  }
}

// THE PROPAGATION CONTROL FOR THE ALIAS PEEL. The peel accumulates the traversal's diagnostics
// (concat(once.diagnostics, rest.diagnostics)) precisely so that flipping the mask does not also
// SILENCE the hard refusals the expansion traversal produces. This arm reads a field through an
// imported alias whose expansion names a type that exists nowhere, and asserts the EXACT row
// anatomy of the refusal, because the anatomy is where the peel's contribution lives. Measured
// 2026-09-09 on this exact fixture shape (same sources, same entry, same count reader):
//   - the definer module ALONE charges UnresolvedType(UbtrGhost) ONCE: the definer's own compile
//     resolves a paramless alias's right-hand side at definition time, with no user module and
//     no peel involved. An earlier draft of this arm claimed the opposite ("a paramless alias
//     resolves as a leaf until a use forces the expansion"); the probe measurement refuted it.
//   - a user that IMPORTS the alias but never uses it adds no row (total stays 1): no field
//     access, no construction, no peel.
//   - the field ACCESS below forces the peel, whose masked:false traversal re-resolves the
//     expansion and whose accumulation carries the SECOND UnresolvedType(UbtrGhost) row into the
//     outcome (total 2). UnresolvedType is GateBlocking (v1.std.core diagnostic_disposition), so
//     the fixture lands in FixtureCompileRefused; a Completed outcome over this manifest would be
//     a gate failure, never a pass.
// MUTATION THIS ARM REDS: dropping or filtering the accumulated diagnostics on the peel path
// takes the total 2 -> 1 (measured by running this fixture's shape against a seed whose peel
// returned an empty diagnostic list), so the == 2 assertion goes false. The same red fires if
// the DEFINER's compile ever stops diagnosing a broken alias definition (2 -> 1 for the other
// reason) -- a distinct regression this arm also catches, named here so the red is read
// correctly. Two earlier shapes of this arm did not discriminate and are recorded so they are
// not re-tried: a CONSTRUCTION through the alias (the record literal's own field type-check
// resolves the expansion beside the peel, so the row survived a peel that dropped every
// diagnostic), and a > 0 count reading (the definer's own row satisfies it with no peel at all).
data ubtr_broken_alias_definer_source: String = "module ubtr.bdef\n\ntype UbtrSel {\n  picked: Int\n}\n\ntype UbtrPackNode<K, S> {\n  key: K\n  sel: S\n}\n\ntype UbtrBrokenAlias = UbtrPackNode<UbtrGhost, UbtrSel>\n"

data ubtr_broken_alias_user_source: String = "module ubtr.buser\n\nimport ubtr.bdef { UbtrBrokenAlias }\n\nfn ubtr_probe(n: UbtrBrokenAlias) -> Int {\n  n.sel.picked\n}\n"

fn ubtr_broken_alias_run() -> MultiModuleCompileFixtureOutcome {
  compile_fixture(MultiModuleCompileFixture {
    sources: [
      fixture_source("ubtr/bdef.dag", ubtr_broken_alias_definer_source),
      fixture_source("ubtr/buser.dag", ubtr_broken_alias_user_source)
    ],
    entry: "ubtr/buser.dag"
  })
}

test fn diagnostics_from_the_alias_expansion_still_propagate() -> Bool {
  match ubtr_broken_alias_run() {
    FixtureCompileCompleted { module_count: n, emitted_files: files, resolved_rust_functions: _, diagnostics: rows, source_digest: sd, compiler_digest: cd } => false,
    FixtureCompileRefused { module_count: n, diagnostics: rows, source_digest: sd, compiler_digest: cd } =>
      ubtr_subject_count(rows: rows, wanted: "UnresolvedType", subject: "UbtrGhost") == 2,
    FixtureInstrumentRefused { cause: c } => false
  }
}
