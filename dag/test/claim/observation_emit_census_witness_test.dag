  string_contains(s: gunbc.observation_emit_census.emit_site_dissolve_on(site: gunbc.observation_emit_census.governor_site), pattern: "ci_hold_cause_text") &&
  string_contains(s: gunbc.observation_emit_census.emit_site_dissolve_on(site: gunbc.observation_emit_census.governor_site), pattern: "render_governor_hold_line_mirror")
}

