module test.claim.observation_emit_census_witness_test

data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.ReadsLiveTree

data witness_note: String = "P3 census hygiene, executable against the live seed (docs/plans/progress-observation-design.md section 5). A census that is not checked against the code it censuses is coverage-by-illusion — an inert lens is itself a lie. So every rostered marker is held against the seed file it names: a marker that has vanished reds (the roster went stale, the site was renamed or deleted without re-census), and a frontier row must carry a real, non-empty dissolve-on so the debt stays prioritizable rather than open-ended. Migrated sites keep their marker strings so the roster cannot go stale, and each has a RED that the raw byte shape is gone from the seed."

fn census_source(path: String) -> String {
  let r = filesystem_read(path: path)
  r.content
}

fn census_marker_present(site: gunbc.observation_emit_census.CensusedEmitSite) -> Bool {
  string_contains(s: census_source(path: site.source_file), pattern: site.marker)
}

test fn w_every_rostered_marker_still_exists_in_the_seed() -> Bool {
  fold(gunbc.observation_emit_census.observation_emit_roster, init: true, f: (acc, site) =>
    acc && census_marker_present(site: site))
}

test fn w_roster_staleness_check_discriminates() -> Bool {
  let bogus = gunbc.observation_emit_census.CensusedEmitSite {
    marker: "[this-marker-does-not-exist-in-the-seed]" as std.types.NonEmptyStr,
    source_file: "src/v1/stage0/src/bin/claim_executor.rs" as std.types.NonEmptyStr,
    disposition: gunbc.observation_emit_census.CountedFrontierSite {
      reason: "control" as std.types.NonEmptyStr,
      dissolution: std.dissolution.unbound_dissolution(description: "control")
    }
  }
  !census_marker_present(site: bogus)
}

test fn w_every_frontier_row_carries_a_real_dissolve_on() -> Bool {
  fold(gunbc.observation_emit_census.observation_emit_roster, init: true, f: (acc, site) =>
    if gunbc.observation_emit_census.emit_site_is_frontier(site: site) {
      acc && gunbc.observation_emit_census.emit_site_dissolve_on(site: site) != ""
    } else {
      acc
    })
}

test fn w_the_named_negative_example_has_migrated() -> Bool {
  census_marker_present(site: gunbc.observation_emit_census.floor_memory_site) &&
  !gunbc.observation_emit_census.emit_site_is_frontier(site: gunbc.observation_emit_census.floor_memory_site) &&
  string_contains(s: gunbc.observation_emit_census.floor_memory_site.marker, pattern: "floor-memory") &&
  string_contains(s: gunbc.observation_emit_census.emit_site_dissolve_on(site: gunbc.observation_emit_census.floor_memory_site), pattern: "ci_heartbeat_line")
}

