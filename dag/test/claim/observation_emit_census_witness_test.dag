  census_marker_present(site: governor_site) &&
  !emit_site_is_frontier(site: governor_site) &&
  string_contains(s: governor_site.marker, pattern: "governor") &&
  string_contains(s: emit_site_dissolve_on(site: governor_site), pattern: "ci_hold_cause_text") &&
  string_contains(s: emit_site_dissolve_on(site: governor_site), pattern: "render_governor_hold_line_mirror")
}

