data w_post_snapshot_live_tags_are_rostered_bidirectional_note: String = "Operator finding 3 (run 30142403230): hygiene is bidirectional — growth tags born after the initial census snapshot must appear on the roster, not only the reverse (rostered markers still exist). Extended for #7205 resolve/assembly split tags, #7284 witness-row-cost / witness-row-cost-drift, and the migration-disclosure gate's own [witness-row-cost-migration-disclosure] marker.\n\nA [compile-clean-cost-drift] row was added here on 2026-08-11 and RETIRED hours later in the same lane, when that tag's emit was deleted outright rather than gated — so the row is gone and this list is shorter, not longer. The WAY the hole was found is still the finding: it was not caught by this test, because a manually enumerated conjunction can only assert the rows somebody remembered to write down. [compile-clean-cost-drift] and [compile-clean-cost] had been live in the seed and absent from the roster since they were introduced, so the bidirectional rule was stated but not enforced for them — an unrostered tag is invisible to a check whose subject list IS the roster. That makes this test's own shape the residue: the durable fix is a source-level census that DISCOVERS print markers in the seed and joins them against the roster, at which point a new tag cannot escape by not being remembered. Until that lands, this conjunction is a hand-maintained approximation of a discovery it cannot perform, and every row added to it is evidence of the gap rather than closure of it."

test fn w_post_snapshot_live_tags_are_rostered_bidirectional() -> Bool {
  census_marker_present(site: gunbc.observation_emit_census.floor_drain_site) &&
  gunbc.observation_emit_census.emit_site_is_frontier(site: gunbc.observation_emit_census.floor_drain_site) &&
  census_marker_present(site: gunbc.observation_emit_census.receipt_site) &&
  gunbc.observation_emit_census.emit_site_is_frontier(site: gunbc.observation_emit_census.receipt_site) &&
  census_marker_present(site: gunbc.observation_emit_census.file_trace_site) &&
  gunbc.observation_emit_census.emit_site_is_frontier(site: gunbc.observation_emit_census.file_trace_site) &&
  census_marker_present(site: gunbc.observation_emit_census.resolve_split_site) &&
  gunbc.observation_emit_census.emit_site_is_frontier(site: gunbc.observation_emit_census.resolve_split_site) &&
  census_marker_present(site: gunbc.observation_emit_census.assembly_split_site) &&
  gunbc.observation_emit_census.emit_site_is_frontier(site: gunbc.observation_emit_census.assembly_split_site) &&
  census_marker_present(site: gunbc.observation_emit_census.witness_row_cost_site) &&
  gunbc.observation_emit_census.emit_site_is_frontier(site: gunbc.observation_emit_census.witness_row_cost_site) &&
  census_marker_present(site: gunbc.observation_emit_census.witness_row_cost_migration_disclosure_site) &&
  gunbc.observation_emit_census.emit_site_is_frontier(site: gunbc.observation_emit_census.witness_row_cost_migration_disclosure_site)
}

test fn w_the_raw_byte_dump_shape_is_gone_from_the_seed() -> Bool {
  let executor = census_source(path: "src/v1/stage0/src/bin/claim_executor.rs")
  !string_contains(s: executor, pattern: "[floor-memory] t=") &&
  !string_contains(s: executor, pattern: "current={}") &&
  string_contains(s: executor, pattern: "render_heartbeat_line_mirror")
}

test fn w_the_raw_gantt_shape_is_gone_from_the_seed() -> Bool {
  let rt = census_source(path: "src/v1/stage0/src/v1_rt.rs")
  let executor = census_source(path: "src/v1/stage0/src/bin/claim_executor.rs")
  !string_contains(s: rt, pattern: "t_ms=") &&
  !string_contains(s: rt, pattern: "rss_mib=") &&
  string_contains(s: rt, pattern: "render_phase_begin_line_mirror") &&
  string_contains(s: rt, pattern: "render_phase_concluded_line_mirror") &&
  !string_contains(s: executor, pattern: "[gantt] claim_executor wall:") &&
  string_contains(s: executor, pattern: "render_phase_concluded_line_mirror")
}

test fn w_the_raw_governor_shape_is_gone_from_the_seed() -> Bool {
  let gov = census_source(path: "src/v1/stage0/src/memory_governor.rs")
  !string_contains(s: gov, pattern: "[governor] hard back-off:") &&
  !string_contains(s: gov, pattern: "[governor] creep back-off:") &&
  !string_contains(s: gov, pattern: "[governor] receipt:") &&
  !string_contains(s: gov, pattern: "[governor] adaptive width") &&
  string_contains(s: gov, pattern: "render_governor_hold_line_mirror") &&
  string_contains(s: gov, pattern: "GOVERNOR_CENSUS_MARKER")
}

test fn w_the_raw_typecheck_attribution_shape_is_gone_from_the_seed() -> Bool {
  let cli = census_source(path: "src/v1/stage0/src/cli_run.rs")
  !string_contains(s: cli, pattern: "[typecheck-attribution] module=") &&
  string_contains(s: cli, pattern: "render_typecheck_concluded_line_mirror") &&
  string_contains(s: cli, pattern: "TYPECHECK_ATTRIBUTION_CENSUS_MARKER")
}

test fn w_the_raw_measurement_shape_is_gone_from_the_seed() -> Bool {
  let executor = census_source(path: "src/v1/stage0/src/bin/claim_executor.rs")
  let cli = census_source(path: "src/v1/stage0/src/cli_run.rs")
  !string_contains(s: executor, pattern: "bytes (VmHWM)") &&
  !string_contains(s: executor, pattern: "[measurement] floor peak RSS:") &&
  !string_contains(s: executor, pattern: "[measurement] cgroup peak:") &&
  string_contains(s: executor, pattern: "render_peak_rss_line_mirror") &&
  string_contains(s: cli, pattern: "MEASUREMENT_CENSUS_MARKER")
}

test fn w_the_raw_shell_shape_is_gone_from_the_seed() -> Bool {
  let interp = census_source(path: "src/v1/stage0/src/v1_interpreter.rs")
  !string_contains(s: interp, pattern: "[shell] done exit=") &&
  !string_contains(s: interp, pattern: "[shell] stderr (exit=") &&
  string_contains(s: interp, pattern: "render_shell_effect_failed_line_mirror") &&
  string_contains(s: interp, pattern: "SHELL_CENSUS_MARKER")
}

test fn w_the_raw_witness_claim_result_shape_is_gone_from_the_seed() -> Bool {
  let cli = census_source(path: "src/v1/stage0/src/cli_run.rs")
  !string_contains(s: cli, pattern: "falling back to legacy")
    && !string_contains(s: cli, pattern: "(\{subject\}) \{ms:.1\}ms")
    && string_contains(s: cli, pattern: "render_witness_claim_result_text_mirror")
}
