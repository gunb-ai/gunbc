  string_contains(s: gunbc.observation_emit_census.emit_site_dissolve_on(site: gunbc.observation_emit_census.gantt_site), pattern: "ci_event_line") &&
  string_contains(s: gunbc.observation_emit_census.emit_site_dissolve_on(site: gunbc.observation_emit_census.gantt_site), pattern: "phase_begin_line")
}

