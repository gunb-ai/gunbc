  !emit_site_is_frontier(site: witness_claim_result_site) &&
  string_contains(s: emit_site_dissolve_on(site: witness_claim_result_site), pattern: "ci_witness_claim_result_text") &&
  string_contains(s: emit_site_dissolve_on(site: witness_claim_result_site), pattern: "render_witness_claim_result_text_mirror")
