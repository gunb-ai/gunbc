module test.claim.heal_publisher_provision_witness

import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.types { String, Bool, Int, List }
import std.process { ProcessExit, ExitSuccess, ExitFailure, exit_failure }
import extdeps.transports.rest { RestOutcome, RestOk, RestStatusRefused, RestTransportRefused }
import extdeps.cloud.gcp.iam { GcpPolicy, GcpBinding }
import gunbc.gcp_estate_observation { role_iam_workload_identity_user }
import gunbc.auth.heal_publisher_federation { heal_publisher_wif_principal_set, heal_publisher_wif_pool_display_name }
import gunbc.auth.heal_publisher_provision {
  SubjectCreation, SubjectCreated, SubjectAlreadyPresentUnverified, SubjectCreateRefused,
  subject_creation, heal_publisher_impersonation_cell, impersonation_binding_present,
  DedicatedFederation, heal_publisher_dedicated_federation,
  PoolReading, PoolObservedAbsent, PoolObserved, ProvidersReading, ProvidersObserved, ProvidersUnreadable,
  AccountObservedAbsent, AccountObserved,
  FederationClassification, FederationClassified, FederationUnclassified,
  classify_dedicated_federation, federation_fully_present,
}
import extdeps.cloud.gcp.gcp { WifPoolWire, WifProviderWire, WifOidcWire }
import gunbc.auth.github_gcp_federation { github_wif_issuer_uri }
import v2.std.optional { Present, Absent }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE SUBJECT IS THE PROVISIONING DECISION, not the network calls around it. Three creates cannot be
// one request, so what this module decides on a PARTIAL result is the whole safety content: which
// outcomes may be called converged, which must stop the run, and which must reconcile-then-refuse.

fn ok() -> RestOutcome { RestOk }
fn conflict() -> RestOutcome { RestStatusRefused { status: 409, body: "{\"error\":{\"status\":\"ALREADY_EXISTS\"}}" } }
fn denied() -> RestOutcome { RestStatusRefused { status: 403, body: "caller lacks iam.workloadIdentityPools.create" } }

fn succeeded(e: ProcessExit) -> Bool {
  match e {
    ExitSuccess => true
    ExitFailure { code: _, reason: _ } => false
  }
}

fn refusal_text(e: ProcessExit) -> String {
  match e {
    ExitSuccess => ""
    ExitFailure { code: _, reason } => reason
  }
}

// ── what one create outcome established ─────────────────────────────────────────────────────

// THE POSITIVE CONTROL. A 200 is a creation this run performed and may rely on; without this arm
// answering Created, every refusal below is satisfied by a classifier that admits nothing.
test fn witness_a_created_subject_is_created() -> Bool {
  match subject_creation(o: ok()) {
    SubjectCreated => true
    SubjectAlreadyPresentUnverified => false
    SubjectCreateRefused { cause: _ } => false
  }
}

// A 409 IS NOT A REFUSAL AND NOT A CONVERGENCE. It says the id is taken and says nothing about the
// configuration behind it, which for the provider is the attribute condition -- the one fact that
// decides which workflows may federate at all.
test fn witness_a_conflict_is_an_unverified_presence() -> Bool {
  match subject_creation(o: conflict()) {
    SubjectAlreadyPresentUnverified => true
    SubjectCreated => false
    SubjectCreateRefused { cause: _ } => false
  }
}

test fn witness_a_denied_create_is_a_refusal_carrying_its_cause() -> Bool {
  match subject_creation(o: denied()) {
    SubjectCreateRefused { cause } => string_contains(s: cause, pattern: "403")
    SubjectCreated => false
    SubjectAlreadyPresentUnverified => false
  }
}

test fn witness_an_unreached_service_is_a_refusal_not_a_presence() -> Bool {
  match subject_creation(o: RestTransportRefused { cause: "connection reset" }) {
    SubjectCreateRefused { cause } => string_contains(s: cause, pattern: "transport")
    SubjectCreated => false
    SubjectAlreadyPresentUnverified => false
  }
}

// ── what the run may do, decided from READINGS before any write (review 5286225278) ─────────

fn heal() -> DedicatedFederation {
  heal_publisher_dedicated_federation()
}

fn declared_provider(f: DedicatedFederation) -> WifProviderWire {
  WifProviderWire {
    name: join(["projects/1/locations/global/workloadIdentityPools/", f.pool_id as String, "/providers/", f.provider_id as String], ""),
    disabled: Present { value: false },
    state: Present { value: "ACTIVE" },
    attribute_mapping: Present { value: f.attribute_mapping },
    attribute_condition: Present { value: f.attribute_condition },
    oidc: Present { value: WifOidcWire { issuer_uri: github_wif_issuer_uri as String } },
  }
}

fn declared_pool(f: DedicatedFederation) -> PoolReading {
  PoolObserved { pool: WifPoolWire { name: join(["projects/1/locations/global/workloadIdentityPools/", f.pool_id as String], ""), display_name: Present { value: f.pool_display_name as String }, disabled: Present { value: false }, state: Present { value: "ACTIVE" } } }
}

fn classified(c: FederationClassification) -> Bool {
  match c {
    FederationClassified { create_pool: _, create_provider: _, create_account: _ } => true
    FederationUnclassified { reasons: _ } => false
  }
}

fn unclassified_naming(c: FederationClassification, pattern: String) -> Bool {
  match c {
    FederationUnclassified { reasons: rs } => string_contains(s: join(rs, "; "), pattern: pattern)
    FederationClassified { create_pool: _, create_provider: _, create_account: _ } => false
  }
}

// NOTHING EXISTS: every subject is created, and nothing is granted until the readback matches.
test fn witness_nothing_present_classifies_as_create_all() -> Bool {
  match classify_dedicated_federation(f: heal(), pool: PoolObservedAbsent, providers: ProvidersObserved { providers: [] }, account: AccountObservedAbsent) {
    FederationClassified { create_pool: a, create_provider: b, create_account: c } => a && b && c
    FederationUnclassified { reasons: _ } => false
  }
}

// THE CONTROL FOR EVERY HALT BELOW: all three present and matching is fully present, so a rerun
// reaches the bindings.
test fn witness_present_and_matching_is_fully_present() -> Bool {
  let f = heal()
  let c = classify_dedicated_federation(f: f, pool: declared_pool(f: f), providers: ProvidersObserved { providers: [declared_provider(f: f)] }, account: AccountObserved { email: f.service_account as String })
  classified(c: c) && federation_fully_present(c: c)
}

// THE RED THE REVIEW NAMED: an EXISTING provider whose condition is not the declared one halts the
// run, and it halts in the classifier -- before bind_impersonation or any secret cell is reached.
test fn witness_an_existing_provider_with_another_condition_halts_before_any_grant() -> Bool {
  let f = heal()
  let p = declared_provider(f: f)
  let lax = WifProviderWire { name: p.name, disabled: p.disabled, state: p.state, attribute_mapping: p.attribute_mapping, attribute_condition: Present { value: "assertion.repository_owner == 'gunb-ai'" }, oidc: p.oidc }
  unclassified_naming(c: classify_dedicated_federation(f: f, pool: declared_pool(f: f), providers: ProvidersObserved { providers: [lax] }, account: AccountObserved { email: f.service_account as String }), pattern: "not the declared one")
}

// A SECOND PROVIDER IN THE POOL IS A SECOND ADMISSION RULE, and the pool-wide impersonation member
// would admit it; so the population must be exactly the declared provider.
test fn witness_an_extra_provider_in_the_pool_halts() -> Bool {
  let f = heal()
  let p = declared_provider(f: f)
  let extra = WifProviderWire { name: concat(p.name, "-other"), disabled: p.disabled, state: p.state, attribute_mapping: p.attribute_mapping, attribute_condition: p.attribute_condition, oidc: p.oidc }
  unclassified_naming(c: classify_dedicated_federation(f: f, pool: declared_pool(f: f), providers: ProvidersObserved { providers: [p, extra] }, account: AccountObserved { email: f.service_account as String }), pattern: "exactly one is declared")
}

// AN UNREADABLE SUBJECT IS NOT AN ABSENT ONE.
test fn witness_an_unreadable_population_halts_rather_than_creating() -> Bool {
  let f = heal()
  unclassified_naming(c: classify_dedicated_federation(f: f, pool: declared_pool(f: f), providers: ProvidersUnreadable { cause: "status 403" }, account: AccountObserved { email: f.service_account as String }), pattern: "could not be read")
}

// ── the cell this run writes ────────────────────────────────────────────────────────────────

// THE BINDING IS TO THE POOL, NOT TO A USER OR A KEY. Every identity that can impersonate the
// publisher service account is one that already satisfied the provider's attribute condition, so
// widening this member is how the whole federation stops being tight.
test fn witness_the_impersonation_cell_binds_the_publisher_pool_as_workload_identity_user() -> Bool {
  let c = heal_publisher_impersonation_cell()
  (c.role as String) == (role_iam_workload_identity_user as String)
    && (c.member as String) == heal_publisher_wif_principal_set()
}

fn policy_with(bindings: List<GcpBinding>) -> GcpPolicy {
  GcpPolicy { bindings: bindings, etag: "BwYabc123=", version: 3 }
}

// THE READBACK DISCRIMINATES. A 200 that returned a policy without this cell must not read as
// present, or the readback after setIamPolicy is a decoration.
test fn witness_the_readback_distinguishes_a_policy_carrying_the_cell_from_one_that_does_not() -> Bool {
  let c = heal_publisher_impersonation_cell()
  impersonation_binding_present(policy: policy_with(bindings: [
    GcpBinding { role: c.role, members: [c.member], condition: none }
  ]))
    && !impersonation_binding_present(policy: policy_with(bindings: [
      GcpBinding { role: "roles/viewer", members: [c.member], condition: none }
    ]))
    && !impersonation_binding_present(policy: policy_with(bindings: []))
}

// ── the upstream's own limits on what we may declare ────────────────────────────────────────

// A POOL DISPLAY NAME OVER 32 CHARACTERS IS REFUSED BY THE SERVICE, not by us: createWorkloadIdentityPool
// answers 400 INVALID_ARGUMENT. This was found the expensive way on 2026-09-17 -- a provisioning run
// that had already been authorized, tokened and launched refused on it -- and the whole cost of that
// discovery is removed by asserting the length here, where it is checked every time the floor runs.
//
// THE BOUND IS SPELLED AS A LITERAL AND THAT IS CORRECT HERE, against the ordinary rule: it is an
// EXTERNAL authority's published constraint, not a measurement of our own tree, so it is exactly the
// "external or versioned authority" case DESIGN section 5 admits as an oracle.
test fn witness_the_pool_display_name_is_within_the_services_limit() -> Bool {
  string_length(s: heal_publisher_wif_pool_display_name as String) <= 32
}

// THE DISCRIMINATOR. If string_length answered something constant, the claim above would pass for any
// name at all; a name known to be over the limit must fail the same predicate.
test fn witness_a_name_over_the_limit_would_not_pass_that_check() -> Bool {
  string_length(s: "GitHub heal publisher (protected publication only)") > 32
}
