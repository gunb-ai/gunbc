module test.claim.ci_yaml_serializer_witness


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn witness_fetch_depth_is_int_not_string() -> Bool {
  let with_block = yaml_mapping(entries: [kv(key: "fetch-depth", value: yaml_int(n: 0))])
  let out = serialize_yaml(v: with_block)
  (out == "fetch-depth: 0\n") && (out != "fetch-depth: \"0\"\n")
}

fn witness_rustflags_empty_string_quoted() -> Bool {
  let with_block = yaml_mapping(entries: [kv(key: "rustflags", value: yaml_string(s: ""))])
  serialize_yaml(v: with_block) == "rustflags: ''\n"
}

fn witness_steps_sequence_elements_are_yaml_values() -> Bool {
  let job = ci_workflow.jobs.first()
  match steps_yaml(steps: job.steps) {
    YamlSequence { elements: els } => (els.length() == job.steps.length()) && (els.length() > 0)
    _ => false
  }
}

fn witness_step_sequence_only_serializes() -> Bool {
  let step = step_yaml(step: ci_workflow.jobs.first().steps.first())
  serialize_yaml(v: yaml_sequence(elements: concat(empty_yaml_values, [step]))) != ""
}

fn witness_step_mapping_serializes() -> Bool {
  serialize_yaml(v: step_yaml(step: ci_workflow.jobs.first().steps.first())) != ""
}

fn witness_first_step_is_mapping() -> Bool {
  match steps_yaml(steps: ci_workflow.jobs.first().steps) {
    YamlSequence { elements: els } =>
      match els.first() {
        YamlMapping { entries: _ } => true
        _ => false
      }
    _ => false
  }
}

fn witness_one_step_serializes() -> Bool {
  let first = ci_workflow.jobs.first().steps.first()
  serialize_yaml(v: yaml_mapping(entries: [
    kv(key: "steps", value: yaml_sequence(elements: concat(empty_yaml_values, [step_yaml(step: first)])))
  ])) != ""
}

fn witness_steps_wrapped_serializes() -> Bool {
  serialize_yaml(v: yaml_mapping(entries: [
    kv(key: "steps", value: steps_yaml(steps: ci_workflow.jobs.first().steps))
  ])) != ""
}

fn witness_jobs_yaml_serializes() -> Bool {
  serialize_yaml(v: yaml_mapping(entries: [
    kv(key: "jobs", value: jobs_yaml(jobs: ci_workflow.jobs))
  ])) != ""
}

fn witness_project_workflow_serializes() -> Bool {
  serialize_yaml(v: project_workflow_to_yaml(workflow: ci_workflow)) != ""
}

fn witness_ci_yaml_gate_red_on_perturbed_bytes() -> Bool {
  let expected = expected_ci_yml()
  ci_yml_drifted(committed: concat(expected, "\n# perturb")) &&
    !ci_yml_drifted(committed: expected)
}

fn witness_ci_yaml_gate_red_on_wrong_fetch_depth_type() -> Bool {
  let expected = expected_ci_yml()
  ci_yml_drifted(committed: concat("fetch-depth: \"0\"\n", expected))
}

fn witness_cache_path_block_scalar() -> Bool {
  let yaml = expected_ci_yml()
  string_contains(
    s: yaml,
    pattern: "          path: |\n            ${{ runner.temp }}/cargo/registry/index/"
  ) &&
    string_contains(
      s: yaml,
      pattern: concat(
        concat(
          "            ${{ runner.temp }}/cargo/registry/cache/\n",
          "            ${{ runner.temp }}/cargo/git/db/\n"
        ),
        "            target/"
      )
    )
}

fn witness_restore_keys_block_scalar_indent() -> Bool {
  let yaml = expected_ci_yml()
  string_contains(
    s: yaml,
    pattern: "          restore-keys: |\n            cargo-ci-${{ runner.os }}-${{ runner.arch }}-\n"
  ) &&
    !string_contains(s: yaml, pattern: "          restore-keys: |\n          cargo-ci-")
}

fn witness_rustup_run_block_scalar_not_quoted() -> Bool {
  let yaml = expected_ci_yml()
  let rustup_line = concat(
    "          rustup default \"$(rustup show active-toolchain | awk '",
    concat(concat("{", "print $1; exit"), concat("}", "')\""))
  )
  string_contains(s: yaml, pattern: concat("        run: |\n", rustup_line)) &&
    !string_contains(s: yaml, pattern: "run: \"rustup default")
}

fn witness_cache_key_plain_not_quoted() -> Bool {
  let yaml = expected_ci_yml()
  string_contains(s: yaml, pattern: "          key: cargo-ci-${{ runner.os }}-${{ runner.arch }}-${{ hashFiles") &&
    !string_contains(s: yaml, pattern: "key: \"cargo-ci")
}

fn witness_multiline_without_block_scalar_is_invalid() -> Bool {
  let broken = concat(
    concat(
      "          path: ${{ runner.temp }}/cargo/registry/index/\n",
      "        ${{ runner.temp }}/cargo/registry/cache/\n"
    ),
    ""
  )
  !string_contains(s: expected_ci_yml(), pattern: broken)
}

fn witness_cache_path_not_flat_multiline_sibling() -> Bool {
  !string_contains(
    s: expected_ci_yml(),
    pattern: concat(
      "          path: ${{ runner.temp }}/cargo/registry/index/\n",
      "        ${{ runner.temp }}/cargo/registry/cache/"
    )
  )
}

fn witness_restore_keys_content_deeper_than_key() -> Bool {
  !string_contains(
    s: expected_ci_yml(),
    pattern: "          restore-keys: |\n          cargo-ci-"
  )
}

fn witness_sccache_wired_when_fleet_daemon_up() -> Bool {
  let yaml = expected_ci_yml()
  string_contains(s: yaml, pattern: "if sccache --show-stats >/dev/null 2>&1; then") &&
    string_contains(s: yaml, pattern: "RUSTC_WRAPPER=sccache") &&
    string_contains(s: yaml, pattern: "CARGO_INCREMENTAL=0") &&
    !string_contains(s: yaml, pattern: "sccache --stop-server") &&
    !string_contains(s: yaml, pattern: "sccache --start-server") &&
    !string_contains(s: yaml, pattern: "SCCACHE_DIR=$RUNNER_TEMP/sccache")
}

fn witness_cargo_jobs_derived_and_jobserver_decoupled() -> Bool {
  let yaml = expected_ci_yml()
  let n = ci_cargo_build_jobs_count()
  string_contains(s: yaml, pattern: "echo \"MAKEFLAGS=\" >> \"$GITHUB_ENV\"") &&
    string_contains(s: yaml, pattern: concat("CARGO_BUILD_JOBS=", concat(to_string(n), "\""))) &&
    !string_contains(s: yaml, pattern: "CARGO_BUILD_JOBS=1\"") &&
    !string_contains(s: yaml, pattern: "CARGO_BUILD_JOBS=2\"") &&
    n >= 2
}

fn witness_gunbc_ci_step_projects_run_script_markers() -> Bool {
  let yaml = expected_ci_yml()
  let floor_script = gunbc_ci_floor_run(spec: gunbc_ci_spec)
  let build_script = ci_release_build_script()
  string_contains(s: yaml, pattern: "Build release bins (claim_executor + gunbc)") &&
    !string_contains(s: yaml, pattern: "env -u RUSTC_WRAPPER") &&
    string_contains(s: yaml, pattern: "$ROOT/target/release/claim_executor") &&
    !string_contains(s: build_script, pattern: "env -u RUSTC_WRAPPER") &&
    !string_contains(s: floor_script, pattern: "env -u RUSTC_WRAPPER") &&
    string_contains(s: floor_script, pattern: "$ROOT/target/release/claim_executor")
}

fn witness_cache_uses_runner_context_not_env() -> Bool {
  template_uses_context(template: ci_cache_path_template, target: Runner) &&
    !template_uses_context(template: ci_cache_path_template, target: Env)
}

fn witness_cache_runner_env_scope_red_control() -> Bool {

  let bad = ExpressionTemplate { segments: [
    Interpolation { expression: ContextAccess { context: extdeps.github.expressions.Env, path: ["CARGO_HOME"] } },
    LiteralText { text: "/registry/index/" }
  ] }
  !(template_uses_context(template: bad, target: Runner) &&
    !template_uses_context(template: bad, target: Env))
}

fn witness_no_runner_vars_accessed_via_env_context() -> Bool {
  !any_template_accesses_runner_var_via_env(templates: ci_workflow_expression_templates)
}

fn witness_no_runner_env_context_red_control() -> Bool {

  let bad = concat(ci_workflow_expression_templates, [
    ExpressionTemplate { segments: [
      Interpolation { expression: ContextAccess { context: extdeps.github.expressions.Env, path: ["RUNNER_TEMP"] } }
    ] }
  ])
  any_template_accesses_runner_var_via_env(templates: bad)
}

test fn ci_yaml_serializer_keystone_holds() -> Bool {
  witness_fetch_depth_is_int_not_string() &&
    witness_rustflags_empty_string_quoted() &&
    witness_steps_sequence_elements_are_yaml_values() &&
    witness_project_workflow_serializes() &&
    witness_ci_yaml_gate_red_on_perturbed_bytes() &&
    witness_ci_yaml_gate_red_on_wrong_fetch_depth_type() &&
    witness_cache_path_block_scalar() &&
    witness_restore_keys_block_scalar_indent() &&
    witness_rustup_run_block_scalar_not_quoted() &&
    witness_cache_key_plain_not_quoted() &&
    witness_multiline_without_block_scalar_is_invalid() &&
    witness_cache_path_not_flat_multiline_sibling() &&
    witness_restore_keys_content_deeper_than_key() &&
    witness_sccache_wired_when_fleet_daemon_up() &&
    witness_cargo_jobs_derived_and_jobserver_decoupled() &&
    witness_gunbc_ci_step_projects_run_script_markers() &&
    witness_cache_uses_runner_context_not_env() &&
    witness_cache_runner_env_scope_red_control() &&
    witness_no_runner_vars_accessed_via_env_context() &&
    witness_no_runner_env_context_red_control()
}
