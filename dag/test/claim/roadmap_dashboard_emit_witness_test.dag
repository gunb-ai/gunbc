module test.claim.roadmap_dashboard_emit_witness


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn witness_route_table_serves_daily_and_roadmap() -> Bool {
  count(roadmap_dashboard_served_static_route_table().routes) == 5
}

fn witness_emitted_source_has_root_daily_workspace() -> Bool {
  let src = roadmap_dashboard_node_http_server_source()
  string_contains(s: src, pattern: "/^\\/$/")
    && string_contains(s: src, pattern: "gunbc — daily workspace")
    && string_contains(s: src, pattern: "<h2>Ready</h2>")
    && string_contains(s: src, pattern: "<h2>Upcoming</h2>")
}

fn witness_emitted_source_has_roadmap_route() -> Bool {
  let src = roadmap_dashboard_node_http_server_source()
  string_contains(s: src, pattern: "/^\\/roadmap$/")
    && string_contains(s: src, pattern: "gunbc — roadmap")
    && string_contains(s: src, pattern: "class=\"roadmap-section\"")
}

fn witness_gunbhub_emit_still_green() -> Bool {
  string_contains(s: gunbhub_node_http_server_source(), pattern: "createServer")
    && string_contains(s: gunbhub_node_http_server_source(), pattern: "listen(")
}

fn witness_emitted_source_has_dispatch_route() -> Bool {
  let src = roadmap_dashboard_node_http_server_source()
  string_contains(s: src, pattern: "/dispatch/")
    && string_contains(s: src, pattern: "execFile")
    && string_contains(s: src, pattern: "GUNBC_BELT_NODE_ID")
    && string_contains(s: src, pattern: "belt_dispatch_node_cli")
}

fn witness_gunbhub_emit_has_no_dispatch_route() -> Bool {
  !string_contains(s: gunbhub_node_http_server_source(), pattern: "execFile")
    && !string_contains(s: gunbhub_node_http_server_source(), pattern: "/dispatch/")
}

test fn roadmap_dashboard_emit_witnesses() -> Bool {
  witness_route_table_serves_daily_and_roadmap()
    && witness_emitted_source_has_root_daily_workspace()
    && witness_emitted_source_has_roadmap_route()
    && witness_gunbhub_emit_still_green()
    && witness_emitted_source_has_dispatch_route()
    && witness_gunbhub_emit_has_no_dispatch_route()
}
