module test.claim.roadmap_focus_witness_test



data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

data focus_witness_note: String = "Focus is a VIEW, so the property that matters is not what it shows but what it cannot do: it must never be able to lose work. These claims pin the two ways a filtered projection goes wrong. First, the filter must be a partition and not an edit — visible plus hidden equals the whole declared set, so a node cannot fall out of both and vanish from the roadmap entirely; that is checked by arithmetic against the same list the filter runs over, not by trusting the filter. Second, the page must not read as a shorter roadmap — the notice carries a DERIVED count, so a reader who forgot the focus was set is told what is missing rather than shown a plausible-looking complete page.\n\nThe RED control is the one that would otherwise rot: clearing the focus must restore every node. Without it, a filter that silently dropped nodes on BOTH paths would still satisfy an is-subset check and still look correct on the focused page."

fn all_nodes() -> List<gunbc.roadmap_model.RoadmapNode> {
  match accepted_roadmap_node_ids_projection() {
    AcceptedRoadmapNodeIdsProjected { ids: accepted } =>
      active_roadmap_nodes_for_accepted(accepted: accepted)
    AcceptedRoadmapNodeIdsProjectionRefused { detail: _ } => []
  }
}

fn active_roadmap_edges() -> List<gunbc.roadmap_model.RoadmapEdge> {
  match accepted_roadmap_node_ids_projection() {
    AcceptedRoadmapNodeIdsProjected { ids: accepted } =>
      active_roadmap_edges_for_accepted(accepted: accepted)
    AcceptedRoadmapNodeIdsProjectionRefused { detail: _ } => []
  }
}

fn visible() -> List<gunbc.roadmap_model.RoadmapNode> {
  focus_visible_nodes(focus: roadmap_focus_selection, nodes: all_nodes(), edges: active_roadmap_edges())
}

test fn focus_partitions_rather_than_deletes() -> Bool {
  count(visible()) + focus_hidden_node_count(
    focus: roadmap_focus_selection,
    nodes: all_nodes(),
    edges: active_roadmap_edges(),
  ) == count(all_nodes())
}

test fn clearing_focus_restores_every_node() -> Bool {
  count(focus_visible_nodes(focus: NoFocus, nodes: all_nodes(), edges: active_roadmap_edges())) == count(all_nodes())
    && focus_hidden_node_count(focus: NoFocus, nodes: all_nodes(), edges: active_roadmap_edges()) == 0
}

test fn focus_actually_narrows_the_page() -> Bool {
  focus_is_active(focus: roadmap_focus_selection)
    && count(visible()) < count(all_nodes())
    && count(visible()) > 0
}

test fn every_visible_edge_has_both_endpoints_visible() -> Bool {
  let vis = visible()
  all(
    focus_visible_edges(
      focus: roadmap_focus_selection,
      nodes: all_nodes(),
      edges: active_roadmap_edges(),
    ),
    e => any(vis, n => (n.node as String) == (e.child as String))
      && any(vis, n => (n.node as String) == (e.parent as String)),
  )
}

test fn focus_notice_states_the_derived_hidden_count() -> Bool {
  let notice = focus_notice(focus: roadmap_focus_selection, nodes: all_nodes(), edges: active_roadmap_edges())
  string_contains(
    s: notice,
    pattern: to_string(focus_hidden_node_count(
      focus: roadmap_focus_selection,
      nodes: all_nodes(),
      edges: active_roadmap_edges(),
    )),
  ) && string_contains(s: notice, pattern: "Focused view")
}

test fn unfocused_projection_emits_no_notice() -> Bool {
  focus_notice(focus: NoFocus, nodes: all_nodes(), edges: active_roadmap_edges()) == ""
}

// THE CLAIM THAT WOULD HAVE CAUGHT THE ORIGINAL BUG, stated over a SYNTHETIC graph rather than the live focus. The first focus shipped owner-membership as the whole visibility rule, and the page rendered pderive-source-slot-binding as ready while its prerequisite in a hidden lane was nowhere on it. Nothing was red; the page lied by omission, which is worse for a dispatched agent than for a person — a worker reads a ready-looking node, starts, and stalls on work the roadmap never mentioned.
//
// The discriminator is synthetic because a live-focus assertion would contradict the carrier's own promise that changing or clearing the focus is a one-row view edit. A claim like `count(pulled) > 0` against roadmap_focus_selection fails the moment the focus is set to NoFocus, or to a lane that legitimately has no cross-owner prerequisite — reporting a defect where none exists and making the focus row un-editable in practice. The fixture below owns its two lanes and its transitive cross-lane edge, so it holds no matter what the live focus is set to, and it exercises TRANSITIVITY (b3 pulls b2 pulls b1) which is the part manual inspection misses.
//
// The live-tree claim beside it is stated conditionally: whatever the current focus is, no visible node may have a hidden prerequisite. That invariant is true under every focus including NoFocus, so it constrains the projection without pinning the selection.
fn fx(id: String, owner: String) -> gunbc.roadmap_model.RoadmapNode {
  gunbc.roadmap_model.RoadmapNode {
    identity: "rnfx_J1Y305CV88R38QJXQFCY" as gunbc.roadmap_model.RoadmapNodeIdentity,
    node: id,
    line: gunbc.roadmap_status.TicketLine { done: false, ticket: gunbc.roadmap_status.TicketFields {
      headline: "fixture", brief: "fixture", displaced_cost: "fixture",
      current_state: "fixture", first_slice: "fixture", red_control: "fixture",
      out_of_scope: "fixture", handback: "fixture",
      updates: [], authored_on: "", last_verified_on: "",
    } },
    carriers: [gunbc.roadmap_model.Pointer { label: "authority", path: "DESIGN.md" }],
    sizing: gunbc.roadmap_model.Sized { intricacy: IntricacyMedium, volume: VolumeMedium, repo: "gunbc", acceptance: ManualAcceptance },
    execution: ExecutionContractUnspecified,
    owner: owner,
    signoff: Unsigned,
  }
}

fn fixture_nodes() -> List<gunbc.roadmap_model.RoadmapNode> {
  [
    fx(id: "a1", owner: "lane-a"),
    fx(id: "b1", owner: "lane-b"),
    fx(id: "b2", owner: "lane-b"),
    fx(id: "b3", owner: "lane-b"),
  ]
}

fn fixture_edges() -> List<gunbc.roadmap_model.RoadmapEdge> {
  [
    gunbc.roadmap_model.RoadmapEdge { child: "a1", parent: "b3" },
    gunbc.roadmap_model.RoadmapEdge { child: "b3", parent: "b2" },
    gunbc.roadmap_model.RoadmapEdge { child: "b2", parent: "b1" },
  ]
}

fn fixture_focus() -> gunbc.roadmap_focus.RoadmapFocus {
  gunbc.roadmap_focus.FocusOnOwners { label: "lane a", owners: ["lane-a"] }
}

test fn synthetic_closure_pulls_transitive_cross_lane_prerequisites() -> Bool {
  let pulled = focus_prerequisite_ids(
    focus: fixture_focus(), nodes: fixture_nodes(), edges: fixture_edges(),
  )
  count(pulled) == 3
    && any(pulled, p => p == "b3")
    && any(pulled, p => p == "b2")
    && any(pulled, p => p == "b1")
}

test fn synthetic_visible_set_is_lane_plus_pulled() -> Bool {
  count(focus_visible_nodes(
    focus: fixture_focus(), nodes: fixture_nodes(), edges: fixture_edges(),
  )) == 4
}

test fn synthetic_no_visible_node_has_a_hidden_prerequisite() -> Bool {
  let vis = focus_visible_nodes(
    focus: fixture_focus(), nodes: fixture_nodes(), edges: fixture_edges(),
  )
  all(
    fixture_edges() |> filter(e => any(vis, n => (n.node as String) == (e.child as String))),
    e => any(vis, n => (n.node as String) == (e.parent as String)),
  )
}

test fn synthetic_focus_with_no_external_prerequisite_pulls_nothing() -> Bool {
  count(focus_prerequisite_ids(
    focus: gunbc.roadmap_focus.FocusOnOwners { label: "lane b", owners: ["lane-b"] },
    nodes: fixture_nodes(),
    edges: fixture_edges(),
  )) == 0
}

test fn synthetic_notice_names_every_pulled_prerequisite() -> Bool {
  let notice = focus_notice(
    focus: fixture_focus(), nodes: fixture_nodes(), edges: fixture_edges(),
  )
  all(
    focus_prerequisite_ids(focus: fixture_focus(), nodes: fixture_nodes(), edges: fixture_edges()),
    id => string_contains(s: notice, pattern: id),
  )
}

test fn no_visible_node_has_a_hidden_prerequisite() -> Bool {
  let vis = visible()
  all(
    active_roadmap_edges() |> filter(e =>
      any(vis, n => (n.node as String) == (e.child as String))),
    e => any(vis, n => (n.node as String) == (e.parent as String)),
  )
}
