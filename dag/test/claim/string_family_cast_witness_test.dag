module test.claim.string_family_cast


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn string_to_secret(s: String) -> Secret {
  s as Secret
}

fn string_to_nonempty(s: String) -> std.types.NonEmptyStr {
  s as std.types.NonEmptyStr
}

fn string_to_secret_value(s: String) -> std.types.SecretValue {
  s as std.types.SecretValue
}

test fn string_family_cast_holds() -> Bool {
  string_to_secret("secret-token") == "secret-token"
    && string_to_nonempty("bmc-host") == "bmc-host"
    && string_to_secret_value("rotated") == "rotated"
}
