module test.claim.html_roundtrip


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn roundtrip_core_node() -> std.markup.Fragment {
  std.markup.Element {
    tag: "div",
    attributes: [],
    children: [
      std.markup.Element {
        tag: "p",
        attributes: [],
        children: [std.markup.FragmentText { content: "hello & world" }],
      },
      std.markup.Element {
        tag: "a",
        attributes: [std.markup.attr(name: "href", value: "https://example.com" )],
        children: [std.markup.FragmentText { content: "link" }],
      },
    ],
  }
}

test fn witness_roundtrip_core() -> Bool {
  match extdeps.languages.html.ingest_html_source(src: extdeps.languages.html.serialize_html_source(node: roundtrip_core_node())) {
    extdeps.languages.html.IngestedNode { node } => node == roundtrip_core_node()
    extdeps.languages.html.IngestRejected { reason: _ } => false
  }
}

fn perturbed_spellings() -> std.markup.MarkupBracket {
  std.markup.MarkupBracket {
    tag_open: canonical_html_spellings.tag_open,
    end_tag_open: canonical_html_spellings.end_tag_open,
    tag_close: canonical_html_spellings.tag_close,
    attr_sep: canonical_html_spellings.attr_sep,
    attr_assign: ":=",
    attr_quote: canonical_html_spellings.attr_quote,
  }
}

fn perturbed_node() -> std.markup.Fragment {
  std.markup.Element {
    tag: "a",
    attributes: [std.markup.attr(name: "href", value: "/about" )],
    children: [std.markup.FragmentText { content: "plain text" }],
  }
}

test fn witness_roundtrip_under_perturbed_rows() -> Bool {
  let sp = perturbed_spellings()
  match extdeps.languages.html.ingest_html_source_with(src: extdeps.languages.html.serialize_html_source_with(node: perturbed_node(), sp: sp), sp: sp) {
    extdeps.languages.html.IngestedNode { node } => node == perturbed_node()
    extdeps.languages.html.IngestRejected { reason: _ } => false
  }
}

fn attr_node() -> std.markup.Fragment {
  std.markup.Element {
    tag: "a",
    attributes: [std.markup.attr(name: "href", value: "https://example.com" )],
    children: [std.markup.FragmentText { content: "click" }],
  }
}

test fn witness_ingest_reads_attr_assign_row() -> Bool {
  let emitted_perturbed = extdeps.languages.html.serialize_html_source_with(node: attr_node(), sp: perturbed_spellings())
  match extdeps.languages.html.ingest_html_source(src: emitted_perturbed) {
    extdeps.languages.html.IngestedNode { node } => !(node == attr_node())
    extdeps.languages.html.IngestRejected { reason: _ } => false
  }
}

test fn witness_core_advertised_lossless() -> Bool {
  let node = roundtrip_core_node()
  let m = extdeps.languages.html.html_medium_lossless(node: node)
  match m.fidelity {
    extdeps.communication.medium.Lossless => m.carried == node
    extdeps.communication.medium.Lossy => false
  }
}

test fn witness_frontier_unsafe_href_rejected() -> Bool {
  let serialized = extdeps.languages.html.serialize_html_source(node: std.markup.Element {
    tag: "a",
    attributes: [std.markup.attr(name: "href", value: "javascript:alert(1)" )],
    children: [std.markup.FragmentText { content: "x" }],
  })
  match extdeps.languages.html.ingest_html_source(src: serialized) {
    extdeps.languages.html.IngestRejected { reason: _ } => true
    extdeps.languages.html.IngestedNode { node: _ } => false
  }
}

fn adjacent_text_node() -> std.markup.Fragment {
  std.markup.Element {
    tag: "span",
    attributes: [],
    children: [
      std.markup.FragmentText { content: "a" },
      std.markup.FragmentText { content: "b" },
    ],
  }
}

test fn witness_frontier_not_roundtripped() -> Bool {
  match extdeps.languages.html.ingest_html_source(src: extdeps.languages.html.serialize_html_source(node: adjacent_text_node())) {
    extdeps.languages.html.IngestedNode { node } => !(node == adjacent_text_node())
    extdeps.languages.html.IngestRejected { reason: _ } => false
  }
}

