module test.claim.seed_growth_admission_witness

import gunbc.observation_scoped_run_seed_growth { observation_scoped_run_seed_growth_justification }
import gunbc.seed_growth_admission {
  seed_growth_admission_g0_population_note,
  seed_growth_forward_freeze_policy_note,
  seed_growth_unjustified_additions,
  seed_growth_stale_justifications,
  seed_growth_stale_declarations,
  seed_growth_stale_over,
  seed_growth_roster_all_declarations,
  seed_growth_roster_mechanical_checks_holds,
  seed_growth_roster_well_formed_gate_holds
}
import gunbc.stage0_rust_host_observation { stage0_rust_observation_seed_growth_justification }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.roster_frontier { declaration_ref_display_key }
import v2.std.algebra { any, length }
import v2.std.text { String }

test fn seed_growth_roster_mechanical_checks_hold() -> Bool  {
  seed_growth_roster_mechanical_checks_holds()
}

// THE JOIN IS SPLIT AND THE SPLIT IS THE ASSERTION. Under the single-candidate-set form these two
// calls were one, so the population that found an unjustified addition was the same one that
// declared every untouched roster row stale. Here the SAME candidate goes to both functions and
// they must answer differently: the rogue is an unjustified addition, and passing it as the live
// population makes every real roster row stale rather than none. A reimplementation that collapsed
// them again reds on the second claim. The two answers are independent, so they are two claims
// rather than one conjunction paying both under one budget (DESIGN section 3, a witness
// discriminates at one interface).
fn seed_growth_rogue_declaration() -> DeclarationRef {
  DeclarationRef {
    module_path: "v1_compiler.cli_run",
    decl_name: "totally_unjustified_hand_rust_symbol",
    field: WholeDeclaration
  }
}

test fn seed_growth_join_refuses_unknown_declaration() -> Bool  {
  length(xs: seed_growth_unjustified_additions(added: [seed_growth_rogue_declaration()])) == 1
}

// THE ROSTER IS SUPPLIED, THE RELATION IS REAL. Rendering every roster row's display key put the
// whole-roster form of this claim over the new-witness cost requirement (re-derive:
// claim_executor --required-floor, its COMPLETED-OVER-COST-REQUIREMENT line), and the assertion
// inspects none of the keys. The generic relation is discriminated here on a supplied roster; the
// next claim holds the real binding to the complete roster.
test fn an_unknown_live_population_reports_every_roster_row_stale() -> Bool  {
  let roster = [
    DeclarationRef { module_path: "v1_compiler.a", decl_name: "first", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.b", decl_name: "second", field: WholeDeclaration }
  ]
  length(xs: seed_growth_stale_over(roster: roster, live_items: [seed_growth_rogue_declaration()])) == 2
    && length(xs: seed_growth_stale_over(roster: roster, live_items: roster)) == 0
}

// THE REAL BINDING RANGES OVER THE COMPLETE ROSTER. Against a live population that names no roster
// row, every row is stale -- so a staleness function bound to an empty roster or any strict subset
// reds here, which a_live_roster_declaration_is_not_reported_stale cannot detect (an empty binding
// also reports nothing stale). seed_growth_stale_justifications is this list rendered to keys.
test fn the_real_staleness_binding_covers_every_roster_row() -> Bool  {
  length(xs: seed_growth_stale_declarations(live_items: [seed_growth_rogue_declaration()]))
    == length(xs: seed_growth_roster_all_declarations())
}

// A ROSTER ROW THAT STILL NAMES A LIVE ITEM IS NOT STALE. Without this control the staleness
// function above is satisfied by one that reports everything stale, which reports nothing.
test fn a_live_roster_declaration_is_not_reported_stale() -> Bool  {
  let live = seed_growth_roster_all_declarations()
  length(xs: seed_growth_stale_justifications(live_items: live)) == 0
}

test fn forward_freeze_policy_requires_item_enumeration() -> Bool  {
  string_contains(s: seed_growth_forward_freeze_policy_note, pattern: "exact item identity")
    && string_contains(s: seed_growth_forward_freeze_policy_note, pattern: "no netting")
}

test fn witness_seed_growth_roster_well_formed_gate_holds() -> Bool  {
  seed_growth_roster_well_formed_gate_holds()
}

// WHAT REPLACED THE TWO SCAFFOLD WITNESSES, AND WHY THIS IS NOT AN EQUIVALENT CHECK IN A NEW
// SPELLING. Two arms asserted that seed_growth_admission_join_scaffold and
// seed_growth_g0_census_host_scaffold were Scaffold dispositions; a third asserted a prose row
// CONTAINED two substrings. All three are gone with their subjects: the scaffolds retired when their
// triggers fired, and the prose assertion was the prose-self-match antipattern -- its only content
// was that someone had written a sentence, so it could not tell a repair from a regression. The g0
// population note is now asserted through the mechanism it describes: the census host it names is a
// function, and the arms above and in rust_item_host_observation_witness_test execute it.
test fn the_g0_population_note_names_a_host_that_resolves_to_a_function() -> Bool  {
  string_contains(s: seed_growth_admission_g0_population_note, pattern: "gunbc.rust_item_host_observation")
    && seed_growth_roster_well_formed_gate_holds()
}

test fn stage0_justification_rows_are_in_roster() -> Bool  {
  let roster = seed_growth_roster_all_declarations()
  let stage0 = stage0_rust_observation_seed_growth_justification.hand_authored_declarations
  let scoped = observation_scoped_run_seed_growth_justification().hand_authored_declarations
  (stage0 |> all(r => roster |> any(x => declaration_ref_display_key(ref: r) == declaration_ref_display_key(ref: x))))
    && (scoped |> all(r => roster |> any(x => declaration_ref_display_key(ref: r) == declaration_ref_display_key(ref: x))))
}
