module test.claim.fleet_converge_plan_witness

data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data witness_host_srv1: std.types.NonEmptyStr = "srv1" as std.types.NonEmptyStr

data witness_host_srv2: std.types.NonEmptyStr = "srv2" as std.types.NonEmptyStr

test fn timer_retirement_plan_shows_refused_removal_for_foreign_cap() -> Bool {
  let foreign = gunbc.host_axis_caps.CapMember {
    dropin_path: "/etc/systemd/system/foo.service.d/99-foreign.conf" as std.types.NonEmptyStr,
    content: "[Service]\nMemoryMax=1\n",
  }
  match gunbc.fleet_converge_plan.fleet_converge_plan_artifact(
    host: witness_host_srv1,
    prior_generation: 0,
    observed_timers: [],
    observed_caps: [foreign],
  ) {
    Present { value: artifact } =>
      string_contains(s: artifact.plan_body, pattern: "REFUSED-REMOVAL cap ")
        && string_contains(s: artifact.plan_body, pattern: "MemberNotOwned")
    Absent => false
  }
}

test fn timer_retirement_plan_lists_removed_legacy_timer() -> Bool {
  let observed = [
    gunbc.fleet_converge_plan.TimerRetirementMember { unit_name: "ctrl-fleet-converge.timer" as std.types.NonEmptyStr },
  ]
  let plan = gunbc.fleet_converge_plan.timer_retirement_plan(observed: observed)
  any(plan.actions, a => match a { MemberRemoved { at: _, from: m } => m.unit_name as String == "ctrl-fleet-converge.timer"  _ => false })
}

test fn plan_artifact_hash_is_stable_for_fixed_observation() -> Bool {
  let observed_cap = gunbc.host_axis_caps.CapMember {
    dropin_path: gunbc.host_converge.gunbc_runner_per_slot_dropin_path as std.types.NonEmptyStr,
    content: "[Service]\nMemoryMax=15032385536\n",
  }
  match gunbc.fleet_converge_plan.fleet_converge_plan_artifact(
    host: witness_host_srv1,
    prior_generation: 3,
    observed_timers: [],
    observed_caps: [observed_cap],
  ) {
    Present { value: a1 } =>
      match gunbc.fleet_converge_plan.fleet_converge_plan_artifact(
        host: witness_host_srv1,
        prior_generation: 3,
        observed_timers: [],
        observed_caps: [observed_cap],
      ) {
        Present { value: a2 } =>
          match gunbc.fleet_converge_plan.fleet_converge_plan_artifact_hash(artifact: a1) {
            Present { value: h1 } =>
              match gunbc.fleet_converge_plan.fleet_converge_plan_artifact_hash(artifact: a2) {
                Present { value: h2 } => h1 == h2
                Absent => false
              }
            Absent => false
          }
        Absent => false
      }
    Absent => false
  }
}

test fn observed_baseline_cas_refuses_after_drift() -> Bool {
  let observed_cap = gunbc.host_axis_caps.CapMember {
    dropin_path: gunbc.host_converge.gunbc_runner_per_slot_dropin_path as std.types.NonEmptyStr,
    content: "[Service]\nMemoryMax=15032385536\n",
  }
  match gunbc.fleet_converge_plan.fleet_converge_plan_artifact(
    host: witness_host_srv1,
    prior_generation: 0,
    observed_timers: [],
    observed_caps: [observed_cap],
  ) {
    Present { value: artifact } => {
      let drifted = gunbc.host_axis_caps.CapMember {
        dropin_path: gunbc.host_converge.gunbc_runner_per_slot_dropin_path as std.types.NonEmptyStr,
        content: "[Service]\nMemoryMax=17179869184\n",
      }
      !gunbc.fleet_converge_plan.fleet_converge_observed_baseline_matches(
        host: witness_host_srv1,
        observed_baseline_hex: artifact.observed_baseline_hex,
        observed_timers: [],
        observed_caps: [drifted],
      )
    }
    Absent => false
  }
}

test fn plan_body_names_subject_host_and_generation() -> Bool {
  match gunbc.fleet_converge_plan.fleet_converge_plan_artifact(
    host: witness_host_srv1,
    prior_generation: 4,
    observed_timers: [],
    observed_caps: [],
  ) {
    Present { value: artifact } =>
      string_contains(s: artifact.plan_body, pattern: "subject_host:srv1")
        && string_contains(s: artifact.plan_body, pattern: "plan_generation:5")
        && string_contains(s: artifact.plan_body, pattern: "lease_key:fleet-converge-plan:srv1")
        && artifact.plan_lease.epoch.generation == 5
        && artifact.observed_baseline_hex != "0000000000000000"
    Absent => false
  }
}

test fn cross_host_apply_refuses_subject_identity() -> Bool {
  let observed_cap = gunbc.host_axis_caps.CapMember {
    dropin_path: gunbc.host_converge.gunbc_runner_per_slot_dropin_path as std.types.NonEmptyStr,
    content: "[Service]\nMemoryMax=15032385536\n",
  }
  match gunbc.fleet_converge_plan.fleet_converge_plan_artifact(
    host: witness_host_srv1,
    prior_generation: 0,
    observed_timers: [],
    observed_caps: [observed_cap],
  ) {
    Present { value: artifact } =>
      !gunbc.fleet_converge_plan.fleet_converge_apply_subject_admits(
        planned_subject: artifact.subject,
        observed_host: witness_host_srv2,
        observed_timers: [],
        observed_caps: [observed_cap],
      )
    Absent => false
  }
}

test fn same_host_different_generation_changes_plan_hash() -> Bool {
  let observed_cap = gunbc.host_axis_caps.CapMember {
    dropin_path: gunbc.host_converge.gunbc_runner_per_slot_dropin_path as std.types.NonEmptyStr,
    content: "[Service]\nMemoryMax=15032385536\n",
  }
  match gunbc.fleet_converge_plan.fleet_converge_plan_artifact(
    host: witness_host_srv1,
    prior_generation: 0,
    observed_timers: [],
    observed_caps: [observed_cap],
  ) {
    Present { value: gen0 } =>
      match gunbc.fleet_converge_plan.fleet_converge_plan_artifact(
        host: witness_host_srv1,
        prior_generation: 1,
        observed_timers: [],
        observed_caps: [observed_cap],
      ) {
        Present { value: gen1 } =>
          match gunbc.fleet_converge_plan.fleet_converge_plan_artifact_hash(artifact: gen0) {
            Present { value: h0 } =>
              match gunbc.fleet_converge_plan.fleet_converge_plan_artifact_hash(artifact: gen1) {
                Present { value: h1 } => h0 != h1
                Absent => false
              }
            Absent => false
          }
        Absent => false
      }
    Absent => false
  }
}

test fn second_concurrent_apply_refuses_generation_gate() -> Bool {
  let prior = 5
  let planned = 6
  gunbc.fleet_converge_plan.fleet_converge_apply_generation_admits(prior_generation: prior, store_generation: prior)
    && !gunbc.fleet_converge_plan.fleet_converge_apply_generation_admits(prior_generation: prior, store_generation: planned)
    && gunbc.fleet_converge_plan.fleet_converge_apply_generation_stale(planned_generation: planned, store_generation: planned)
}

test fn member_set_fingerprint_mismatch_refuses_identity() -> Bool {
  let observed_cap = gunbc.host_axis_caps.CapMember {
    dropin_path: gunbc.host_converge.gunbc_runner_per_slot_dropin_path as std.types.NonEmptyStr,
    content: "[Service]\nMemoryMax=15032385536\n",
  }
  match gunbc.fleet_converge_plan.fleet_converge_plan_artifact(
    host: witness_host_srv1,
    prior_generation: 0,
    observed_timers: [],
    observed_caps: [observed_cap],
  ) {
    Present { value: artifact } => {
      let drifted = gunbc.host_axis_caps.CapMember {
        dropin_path: gunbc.host_converge.gunbc_runner_per_slot_dropin_path as std.types.NonEmptyStr,
        content: "[Service]\nMemoryMax=17179869184\n",
      }
      !gunbc.fleet_converge_plan.fleet_converge_member_set_fingerprint_matches(
        planned_fingerprint_text: std.content_hash.serialize_content_hash(hash: artifact.subject.member_set_fingerprint) as String,
        host: witness_host_srv1,
        observed_timers: [],
        observed_caps: [drifted],
      )
    }
    Absent => false
  }
}

test fn plan_content_hash_path_is_apply_interlock_sidecar() -> Bool {
  gunbc.fleet_converge_plan.fleet_converge_plan_content_hash_path == "/tmp/fleet-converge-plan/plan_content.hex"
}

test fn plan_cli_surfaces_content_hash_for_apply_dispatch() -> Bool {
  string_contains(s: gunbc.fleet_converge_plan_cli.fleet_converge_plan_cli_note, pattern: "plan_content.hex")
    && string_contains(s: gunbc.fleet_converge_plan_cli.fleet_converge_plan_cli_note, pattern: "plan_artifact_hash")
    && string_contains(s: gunbc.fleet_converge_plan_cli.fleet_converge_plan_cli_note, pattern: "apply.sh")
}

test fn bundle_hash_binds_apply_shell_not_plan_body_only() -> Bool {
  match gunbc.fleet_converge_plan.fleet_converge_plan_artifact(
    host: witness_host_srv1,
    prior_generation: 0,
    observed_timers: [],
    observed_caps: [],
  ) {
    Present { value: artifact } =>
      match gunbc.fleet_converge_plan.fleet_converge_plan_bundle_digest_hex(
        plan_body: artifact.plan_body,
        apply_shell: artifact.apply_shell,
        spark_typed_actions_wire: "",
      ) {
        Present { value: hex } =>
          gunbc.fleet_converge_plan.fleet_converge_plan_bundle_matches(
            plan_body: artifact.plan_body,
            apply_shell: artifact.apply_shell,
            spark_typed_actions_wire: "",
            claimed_hex: hex as String,
          )
            && !gunbc.fleet_converge_plan.fleet_converge_plan_bundle_matches(
              plan_body: artifact.plan_body,
              apply_shell: concat(artifact.apply_shell, "# tamper"),
              spark_typed_actions_wire: "",
              claimed_hex: hex as String,
            )
        Absent => false
      }
    Absent => false
  }
}

test fn parse_nonneg_generation_refuses_corrupt_and_negative() -> Bool {
  match gunbc.fleet_converge_plan.fleet_converge_parse_nonneg_generation_text(content: "42") {
    Present { value: n } => n == 42
    Absent => false
  }
    && match gunbc.fleet_converge_plan.fleet_converge_parse_nonneg_generation_text(content: "") {
      Absent => true
      Present { value: _ } => false
    }
    && match gunbc.fleet_converge_plan.fleet_converge_parse_nonneg_generation_text(content: "-1") {
      Absent => true
      Present { value: _ } => false
    }
    && match gunbc.fleet_converge_plan.fleet_converge_parse_nonneg_generation_text(content: "abc") {
      Absent => true
      Present { value: _ } => false
    }
}

test fn generation_from_store_content_missing_is_zero_corrupt_refuses() -> Bool {
  match gunbc.fleet_converge_plan.fleet_converge_generation_from_store_content(store_present: false, content: "") {
    Present { value: 0 } => true
    _ => false
  }
    && match gunbc.fleet_converge_plan.fleet_converge_generation_from_store_content(store_present: true, content: "garbage") {
      Absent => true
      Present { value: _ } => false
    }
}

test fn locked_apply_script_serializes_generation_under_flock() -> Bool {
  let script = gunbc.fleet_converge_plan.fleet_converge_locked_apply_script(
    prior_generation: 4,
    planned_generation: 5,
    apply_shell_path: gunbc.fleet_converge_plan.fleet_converge_plan_apply_shell_path,
  )
  string_contains(s: script, pattern: "flock -x")
    && string_contains(s: script, pattern: "[ \"$CURRENT\" != \"4\" ]")
    && string_contains(s: script, pattern: "LeaseGenerationStale planned=5")
    && string_contains(s: script, pattern: "LeaseGenerationStale")
    && string_contains(s: script, pattern: gunbc.fleet_converge_plan.fleet_converge_plan_apply_shell_path)
}

test fn subject_host_matches_same_host() -> Bool {
  gunbc.fleet_converge_plan.fleet_converge_apply_subject_host_matches(planned_host: witness_host_srv1, observed_host: witness_host_srv1)
}

test fn subject_host_matches_refuses_cross_host() -> Bool {
  !gunbc.fleet_converge_plan.fleet_converge_apply_subject_host_matches(planned_host: witness_host_srv1, observed_host: witness_host_srv2)
}

test fn apply_shell_carries_dissolve_on_marker_not_host_gate() -> Bool {
  match gunbc.fleet_converge_plan.fleet_converge_plan_artifact(
    host: witness_host_srv1,
    prior_generation: 0,
    observed_timers: [],
    observed_caps: [],
  ) {
    Present { value: artifact } =>
      string_contains(s: artifact.apply_shell, pattern: "dissolve-on: fleet_converge_apply_shell")
        && !string_contains(s: artifact.apply_shell, pattern: "HOST_SHORT=$(hostname -s)")
        && !string_contains(s: artifact.apply_shell, pattern: "SubjectHostMismatch")
        && !string_contains(s: artifact.apply_shell, pattern: "GEN_STORE")
        && !string_contains(s: artifact.apply_shell, pattern: "printf '%s'")
        && !string_contains(s: artifact.apply_shell, pattern: "/etc/systemd/system/")
    Absent => false
  }
}
