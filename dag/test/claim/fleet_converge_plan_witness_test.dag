    observed_spark: [],
    observed_slots: [],
  ) {
    Present { value: artifact } => {
      let drifted = CapMember {
        dropin_path: gunbc_runner_per_slot_dropin_path as NonEmptyStr,
        content: "[Service]\nMemoryMax=17179869184\n",
      }
      !fleet_converge_member_set_fingerprint_matches(
        planned_fingerprint_text: serialize_content_hash(hash: artifact.subject.member_set_fingerprint) as String,
        host: witness_host_srv1,
        observed_timers: [],
        observed_caps: [drifted],
        observed_spark: [],
        observed_slots: [],
      )
