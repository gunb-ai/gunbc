module test.claim.probe_stall_clear_selection

import gunbc.auth.authorization_pattern_selection {
  PrivilegedEffect, ApiSurface, WorkloadIdentityBindable, WorkloadIdentityUnbindable,
  MintsNoCredential, MintsResourceScopedCredential, MintsHostRootReach, ReversibleByReapply,
  NoBillingConsequence, NoWitnessDischarge,
  FederatedScopedGrant, OperatorApprovedCapability, HumanOnlyStep, OperatorOwnSession, AdministratorEdge,
  PatternSelected, ManualStepRequired, NoAdmissiblePattern, PatternSelectionNeedsEvidence, PatternSelectionNeedsPolicy, PatternSelectionRefused,
  AuthorizationPatternSelection, select_authorization_pattern,
}
import std.human_intervention { EveryProvision, BreakGlassOnly }
import std.types { NonEmptyStr, String, Int, List }

fn shown(s: AuthorizationPatternSelection) -> String {
  match s {
    PatternSelected { pattern: FederatedScopedGrant, receipt: _ } => "Selected FederatedScopedGrant"
    PatternSelected { pattern: OperatorApprovedCapability, receipt: _ } => "Selected OperatorApprovedCapability"
    PatternSelected { pattern: OperatorOwnSession, receipt: _ } => "Selected OperatorOwnSession"
    PatternSelected { pattern: AdministratorEdge, receipt: _ } => "Selected AdministratorEdge"
    PatternSelected { pattern: HumanOnlyStep { step: _ }, receipt: _ } => "Selected HumanOnlyStep"
    ManualStepRequired { step: _, receipt: _ } => "ManualStepRequired"
    NoAdmissiblePattern { causes, scope: _ } => join(["NoAdmissiblePattern: ", join(causes |> map(c => c as String), " | ")], "")
    PatternSelectionNeedsEvidence { needs: _ } => "NeedsEvidence"
    PatternSelectionNeedsPolicy { survivors: _ } => "NeedsPolicy"
    PatternSelectionRefused { defects } => join(["Refused: ", join(defects |> map(c => c as String), " | ")], "")
  }
}

fn probe() -> String {
  join([
    "every/none/unbindable: ", shown(s: select_authorization_pattern(e: PrivilegedEffect { subject: "re-own one recorded foreign-owned exit-spool entry" as NonEmptyStr, frequency: EveryProvision, reversibility: ReversibleByReapply, surface: ApiSurface, workload_identity: WorkloadIdentityUnbindable { cause: "no cloud workload identity names a root write on a fleet host" as NonEmptyStr }, minted_reach: MintsNoCredential, billing: NoBillingConsequence, witness_discharge: NoWitnessDischarge })),
    "\nevery/scoped/bindable: ", shown(s: select_authorization_pattern(e: PrivilegedEffect { subject: "re-own one recorded foreign-owned exit-spool entry" as NonEmptyStr, frequency: EveryProvision, reversibility: ReversibleByReapply, surface: ApiSurface, workload_identity: WorkloadIdentityBindable { member: "the operator's host principal" as NonEmptyStr }, minted_reach: MintsResourceScopedCredential, billing: NoBillingConsequence, witness_discharge: NoWitnessDischarge })),
    "\nevery/hostroot/unbindable: ", shown(s: select_authorization_pattern(e: PrivilegedEffect { subject: "re-own one recorded foreign-owned exit-spool entry" as NonEmptyStr, frequency: EveryProvision, reversibility: ReversibleByReapply, surface: ApiSurface, workload_identity: WorkloadIdentityUnbindable { cause: "no cloud workload identity names a root write on a fleet host" as NonEmptyStr }, minted_reach: MintsHostRootReach, billing: NoBillingConsequence, witness_discharge: NoWitnessDischarge })),
    "\nbreakglass/none/unbindable: ", shown(s: select_authorization_pattern(e: PrivilegedEffect { subject: "re-own one recorded foreign-owned exit-spool entry" as NonEmptyStr, frequency: BreakGlassOnly, reversibility: ReversibleByReapply, surface: ApiSurface, workload_identity: WorkloadIdentityUnbindable { cause: "no cloud workload identity names a root write on a fleet host" as NonEmptyStr }, minted_reach: MintsNoCredential, billing: NoBillingConsequence, witness_discharge: NoWitnessDischarge })),
  ], "")
}
