module test.claim.input_envelope_admission


data live_tree_disposition: LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data test_envelope: InputEnvelope = gunbc.ci_input_envelope.BoundedInput {
  bounds: [
    gunbc.ci_input_envelope.InputBound { axis: gunbc.ci_input_envelope.WitnessCount, max: std.measure.Measure { count: 100 } },
    gunbc.ci_input_envelope.InputBound { axis: gunbc.ci_input_envelope.SourceNodeCount, max: std.measure.Measure { count: 10000 } },
  ]
}

test fn admitted_when_actual_at_envelope() -> Bool {
  let actual = [
    gunbc.ci_input_envelope.InputBound { axis: gunbc.ci_input_envelope.WitnessCount, max: std.measure.Measure { count: 100 } },
    gunbc.ci_input_envelope.InputBound { axis: gunbc.ci_input_envelope.SourceNodeCount, max: std.measure.Measure { count: 10000 } },
  ]
  match gunbc.ci_input_envelope.input_admitted(envelope: test_envelope, actual: actual) {
    Admitted => true
    gunbc.ci_input_envelope.RefusedOverEnvelope { axis: _ } => false
    RefusedUndeclared => false
  }
}

test fn refused_when_actual_over_envelope() -> Bool {
  let actual = [
    gunbc.ci_input_envelope.InputBound { axis: gunbc.ci_input_envelope.WitnessCount, max: std.measure.Measure { count: 101 } },
    gunbc.ci_input_envelope.InputBound { axis: gunbc.ci_input_envelope.SourceNodeCount, max: std.measure.Measure { count: 10000 } },
  ]
  match gunbc.ci_input_envelope.input_admitted(envelope: test_envelope, actual: actual) {
    gunbc.ci_input_envelope.RefusedOverEnvelope { axis: a } => a == gunbc.ci_input_envelope.WitnessCount
    Admitted => false
    RefusedUndeclared => false
  }
}

test fn refused_when_actual_axis_not_declared() -> Bool {
  let actual = [
    gunbc.ci_input_envelope.InputBound { axis: gunbc.ci_input_envelope.CorpusNodeCount, max: std.measure.Measure { count: 1 } },
  ]
  match gunbc.ci_input_envelope.input_admitted(envelope: test_envelope, actual: actual) {
    gunbc.ci_input_envelope.RefusedOverEnvelope { axis: a } => a == gunbc.ci_input_envelope.CorpusNodeCount
    Admitted => false
    RefusedUndeclared => false
  }
}

test fn refused_undeclared_when_envelope_unknown() -> Bool {
  let actual = [
    gunbc.ci_input_envelope.InputBound { axis: gunbc.ci_input_envelope.WitnessCount, max: std.measure.Measure { count: 1 } },
  ]
  match gunbc.ci_input_envelope.input_admitted(envelope: gunbc.ci_input_envelope.EnvelopeUnknown, actual: actual) {
    RefusedUndeclared => true
    Admitted => false
    gunbc.ci_input_envelope.RefusedOverEnvelope { axis: _ } => false
  }
}

test fn red_on_revert_bound_change() -> Bool {
  let at_limit = [
    gunbc.ci_input_envelope.InputBound { axis: gunbc.ci_input_envelope.WitnessCount, max: std.measure.Measure { count: 100 } },
  ]
  let one_over = [
    gunbc.ci_input_envelope.InputBound { axis: gunbc.ci_input_envelope.WitnessCount, max: std.measure.Measure { count: 101 } },
  ]
  let at_admitted = match gunbc.ci_input_envelope.input_admitted(envelope: test_envelope, actual: at_limit) {
    Admitted => true
    gunbc.ci_input_envelope.RefusedOverEnvelope { axis: _ } => false
    RefusedUndeclared => false
  }
  let over_refused = match gunbc.ci_input_envelope.input_admitted(envelope: test_envelope, actual: one_over) {
    gunbc.ci_input_envelope.RefusedOverEnvelope { axis: _ } => true
    Admitted => false
    RefusedUndeclared => false
  }
  at_admitted && over_refused
}

test fn ci_corpus_envelope_is_bounded() -> Bool {
  match gunbc.ci_input_envelope.gunbc_ci_corpus_envelope {
    gunbc.ci_input_envelope.BoundedInput { bounds: b } => b.length() > 0
    EnvelopeUnknown => false
  }
}
