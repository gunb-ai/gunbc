module test.claim.tailscale_serve_route_key_witness

import std.types { Bool, NonEmptyStr, String, List }
import std.key_relation {
  KeyRelation,
  GlobalKeyScope,
  key_relation_global,
  ScopedKey,
  KeyedResourceRelation,
  StateRelation,
  key_relation_scoped_key,
  SubjectKey,
}
import extdeps.tailscale.serve {
  TailscaleServeEndpoint,
  ServeRootMount,
  ServeSetPath,
  tailscale_serve_route_key,
  tailscale_serve_route_key_label,
  TailscaleServeRouteKey,
  tailscale_serve_endpoint_flags,
  tailscale_serve_mount_eq,
  tailscale_serve_enable_argv,
}
import gunbc.tailscale_serve_scope {
  TailscaleServeRouteSubject,
  TailscaleServeScope,
  TailscaleServeScopeIdentity,
  tailscale_serve_route_key_relation,
  tailscale_serve_resource_relation,
  tailscale_serve_route_subject,
  tailscale_serve_scope,
  TailscaleServeRouteKeyRelation,
}
import gunbc.fleet.fleet_intent_network { srv1_tailscale_endpoint, srv2_tailscale_endpoint }
import gunbc.membership_reconcile {
  MembershipPlan,
  MemberAction,
  MemberAdded,
  MemberChanged,
  MemberRemoved,
  membership_reconcile_scoped,
  membership_plan_admitting_scoped_outcome,
  membership_change_count,
  membership_added_count,
  membership_removal_count,
}
import product.network_topology { NetworkEndpoint }
import gunbc.ownership { Ownership, Owned }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

type RetiredFlattenedServeFlagsKeyRelation
type TailscaleEnableArgvIdentityKeyRelation
type GlobalCollapseDemonstrationRelation

type TailscaleServeRouteMemberAt = ScopedKey<TailscaleServeRouteKeyRelation, TailscaleServeScopeIdentity, TailscaleServeRouteKey>

type TailscaleEnableArgvMemberAt = ScopedKey<TailscaleEnableArgvIdentityKeyRelation, GlobalKeyScope, NonEmptyStr>

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// Step-1 discriminating controls for extdeps.tailscale.serve TailscaleServeRouteKey. The
// load-bearing law: same listener x mount + different backend is a re-point (Modified), never
// Remove+Add. A key that embeds backend classifies that drift as different keys and produces
// teardown+reinstall — the membership_reconcile failure mode the design note names.

fn tailscale_route_subject(endpoint: TailscaleServeEndpoint) -> TailscaleServeRouteSubject {
  tailscale_serve_route_subject(
    scope: tailscale_serve_scope(node: srv1_tailscale_endpoint),
    endpoint: endpoint,
  )
}

fn tailscale_endpoint_value_eq(a: TailscaleServeRouteSubject, b: TailscaleServeRouteSubject) -> Bool {
  a.endpoint.https_port == b.endpoint.https_port
    && tailscale_serve_mount_eq(a: a.endpoint.mount, b: b.endpoint.mount)
    && a.endpoint.backend as String == b.endpoint.backend as String
}

fn tailscale_endpoint_ownership(_: TailscaleServeRouteSubject) -> Ownership? {
  Present { value: Owned }
}

fn retired_flattened_serve_flags_key(subject: TailscaleServeRouteSubject) -> NonEmptyStr {
  join(tailscale_serve_endpoint_flags(endpoint: subject.endpoint), " ") as NonEmptyStr
}

data retired_flattened_serve_flags_key_relation: KeyRelation<RetiredFlattenedServeFlagsKeyRelation, TailscaleServeRouteSubject, GlobalKeyScope, NonEmptyStr> = key_relation_global(
  key_of: retired_flattened_serve_flags_key,
)

fn tailscale_enable_argv_identity_key(subject: TailscaleServeRouteSubject) -> NonEmptyStr {
  join(tailscale_serve_enable_argv(endpoint: subject.endpoint), " ") as NonEmptyStr
}

data tailscale_enable_argv_identity_key_relation: KeyRelation<TailscaleEnableArgvIdentityKeyRelation, TailscaleServeRouteSubject, GlobalKeyScope, NonEmptyStr> = key_relation_global(
  key_of: tailscale_enable_argv_identity_key,
)

fn plan_has_change_between_backends(
  plan: MembershipPlan<TailscaleServeRouteSubject, TailscaleServeRouteMemberAt>,
  from_backend: String,
  to_backend: String,
) -> Bool {
  any(plan.actions, a =>
    match a {
      MemberChanged { at: _, from: f, to: t } =>
        f.endpoint.backend as String == from_backend && t.endpoint.backend as String == to_backend
      _ => false
    }
  )
}

fn plan_has_remove_add_not_change(plan: MembershipPlan<TailscaleServeRouteSubject, TailscaleEnableArgvMemberAt>) -> Bool {
  let has_remove = any(plan.actions, a => match a { MemberRemoved { at: _, from: _ } => true  _ => false })
  let has_add = any(plan.actions, a => match a { MemberAdded { at: _, to: _ } => true  _ => false })
  let has_change = any(plan.actions, a => match a { MemberChanged { at: _, from: _, to: _ } => true  _ => false })
  has_remove && has_add && !has_change
}

fn root_endpoint(backend: String) -> TailscaleServeEndpoint {
  TailscaleServeEndpoint {
    https_port: 443,
    mount: ServeRootMount,
    backend: backend as NonEmptyStr,
  }
}

// THE STEP-1 POSITIVE CONTROL. Same listener x mount, different backend: TailscaleServeRouteKey is
// unchanged, so membership_reconcile must emit exactly one MemberChanged carrying both sides — a
// re-point, not teardown+reinstall.

test fn w_route_key_backend_repoint_is_modified_not_remove_add() -> Bool {
  let observed = [tailscale_route_subject(endpoint: root_endpoint(backend: "8080"))]
  let desired = [tailscale_route_subject(endpoint: root_endpoint(backend: "18081"))]
  let plan = membership_plan_admitting_scoped_outcome(
    outcome: membership_reconcile_scoped(
      desired: desired,
      observed: observed,
      resource: tailscale_serve_resource_relation,
      ownership_of: tailscale_endpoint_ownership,
    ),
  )
  plan_has_change_between_backends(plan: plan, from_backend: "8080", to_backend: "18081")
    && membership_change_count(plan: plan) == 1
    && membership_added_count(plan: plan) == 0
    && membership_removal_count(plan: plan) == 0
}

fn tailscale_enable_argv_endpoint_state_of(subject: TailscaleServeRouteSubject) -> NonEmptyStr {
  subject.endpoint.backend
}

fn tailscale_enable_argv_endpoint_state_eq(a: NonEmptyStr, b: NonEmptyStr) -> Bool {
  a == b
}

data tailscale_enable_argv_resource_relation: KeyedResourceRelation<TailscaleEnableArgvIdentityKeyRelation, TailscaleServeRouteSubject, GlobalKeyScope, NonEmptyStr, NonEmptyStr> = KeyedResourceRelation {
  key: tailscale_enable_argv_identity_key_relation,
  state: StateRelation {
    state_of: tailscale_enable_argv_endpoint_state_of,
    state_eq: tailscale_enable_argv_endpoint_state_eq,
  },
}

// RED CONTROL for the Remove+Add failure class. Using the rendered enable argv (which includes
// backend) as identity makes a backend re-point look like two different members — Remove+Add with
// zero MemberChanged. This is the discriminating half the step-1 witness must pin; a key-equality
// test alone cannot catch it.

test fn w_enable_argv_key_backend_repoint_is_remove_add_not_modified() -> Bool {
  let observed = [tailscale_route_subject(endpoint: root_endpoint(backend: "8080"))]
  let desired = [tailscale_route_subject(endpoint: root_endpoint(backend: "18081"))]
  let plan = membership_plan_admitting_scoped_outcome(
    outcome: membership_reconcile_scoped(
      desired: desired,
      observed: observed,
      resource: tailscale_enable_argv_resource_relation,
      ownership_of: tailscale_endpoint_ownership,
    ),
  )
  plan_has_remove_add_not_change(plan: plan)
    && membership_change_count(plan: plan) == 0
    && membership_added_count(plan: plan) == 1
    && membership_removal_count(plan: plan) == 1
}

// The deleted tailscale_serve_endpoint_key joined endpoint FLAGS only (listener + mount argv), so
// it did NOT trigger Remove+Add on backend drift — it shares the route key's listener x mount axis.
// Its defect class is argv-as-locator/path (design note 3a), not backend-as-identity. This row pins
// that the retired carrier is route-stable across backend re-point, so the step-1 Modified law is
// about structured route keys vs keys that embed mutable content (enable argv), not about
// flags-only flattening alone.

test fn w_retired_flags_key_is_route_stable_across_backend_repoint() -> Bool {
  let a = tailscale_route_subject(endpoint: root_endpoint(backend: "8080"))
  let b = tailscale_route_subject(endpoint: root_endpoint(backend: "18081"))
  retired_flattened_serve_flags_key(subject: a) as String
    == retired_flattened_serve_flags_key(subject: b) as String
}

test fn backend_change_preserves_route_key() -> Bool {
  let root = root_endpoint(backend: "8080")
  let repointed = root_endpoint(backend: "18081")
  tailscale_serve_route_key(endpoint: root) == tailscale_serve_route_key(endpoint: repointed)
}

test fn distinct_mounts_have_distinct_keys() -> Bool {
  let root = tailscale_serve_route_key(endpoint: root_endpoint(backend: "8080"))
  let lab = tailscale_serve_route_key(endpoint: TailscaleServeEndpoint {
    https_port: 443,
    mount: ServeSetPath { path: "/srv1-lab" as NonEmptyStr },
    backend: "18081" as NonEmptyStr,
  })
  root != lab
}

test fn membership_label_is_not_rendered_argv() -> Bool {
  let endpoint = TailscaleServeEndpoint {
    https_port: 443,
    mount: ServeSetPath { path: "/srv1-lab" as NonEmptyStr },
    backend: "18081" as NonEmptyStr,
  }
  let label = tailscale_serve_route_key_label(key: tailscale_serve_route_key(endpoint: endpoint)) as String
  let argv = join(tailscale_serve_endpoint_flags(endpoint: endpoint), " ")
  label != argv
}

// THE SCOPE DEFECT NO EXISTING WITNESS COULD SEE. Two tailnet devices may each own the same
// listener×mount route; GlobalKeyScope collapses them into one ScopedKey — the identity-collapse
// class the twin witnesses name when one deployment's teardown deletes another's live resource.
// This control must go red against GlobalKeyScope and green only after TailscaleServeScope lands.

fn srv1_root_route_subject() -> TailscaleServeRouteSubject {
  tailscale_serve_route_subject(
    scope: tailscale_serve_scope(node: srv1_tailscale_endpoint),
    endpoint: root_endpoint(backend: "8080"),
  )
}

fn srv2_root_route_subject() -> TailscaleServeRouteSubject {
  tailscale_serve_route_subject(
    scope: tailscale_serve_scope(node: srv2_tailscale_endpoint),
    endpoint: root_endpoint(backend: "8080"),
  )
}

test fn w_per_device_scope_preserves_distinct_nodes_same_route() -> Bool {
  let key_a = key_relation_scoped_key(relation: tailscale_serve_route_key_relation, subject: srv1_root_route_subject())
  let key_b = key_relation_scoped_key(relation: tailscale_serve_route_key_relation, subject: srv2_root_route_subject())
  key_a != key_b
}

fn global_collapse_route_key_of(subject: TailscaleServeRouteSubject) -> TailscaleServeRouteKey {
  tailscale_serve_route_key(endpoint: subject.endpoint)
}

data global_collapse_demonstration_relation: KeyRelation<GlobalCollapseDemonstrationRelation, TailscaleServeRouteSubject, GlobalKeyScope, TailscaleServeRouteKey> = key_relation_global(
  key_of: global_collapse_route_key_of,
)

test fn w_global_scope_collapses_distinct_nodes_same_route() -> Bool {
  let key_a = key_relation_scoped_key(relation: global_collapse_demonstration_relation, subject: srv1_root_route_subject())
  let key_b = key_relation_scoped_key(relation: global_collapse_demonstration_relation, subject: srv2_root_route_subject())
  key_a == key_b
}

// CONDITION 1 RED: the scope compares node label plus service only, so two endpoints at the same
// label that differ ONLY in an uncompared field (address) must still collide as one scoped key.
test fn w_scope_differing_only_in_uncompared_endpoint_field_still_collides() -> Bool {
  let moved = NetworkEndpoint {
    label: srv1_tailscale_endpoint.label,
    subject: srv1_tailscale_endpoint.subject,
    address: srv2_tailscale_endpoint.address,
    role: srv1_tailscale_endpoint.role,
    locality: srv1_tailscale_endpoint.locality,
  }
  let a = tailscale_route_subject(endpoint: root_endpoint(backend: "8080"))
  let b = tailscale_serve_route_subject(
    scope: tailscale_serve_scope(node: moved),
    endpoint: root_endpoint(backend: "8080"),
  )
  key_relation_scoped_key(relation: tailscale_serve_route_key_relation, subject: a)
    == key_relation_scoped_key(relation: tailscale_serve_route_key_relation, subject: b)
}

// Same wall for the keyed index itself, over the SAME a/b pair as the Condition 1 RED above (same
// label and service, different address): collision must come from the scope projection, not from
// building the key twice from one value (review 80283).
fn w_endpoint_moved_address() -> NetworkEndpoint {
  NetworkEndpoint {
    label: srv1_tailscale_endpoint.label,
    subject: srv1_tailscale_endpoint.subject,
    address: srv2_tailscale_endpoint.address,
    role: srv1_tailscale_endpoint.role,
    locality: srv1_tailscale_endpoint.locality,
  }
}

fn w_pair_a() -> TailscaleServeRouteSubject {
  tailscale_route_subject(endpoint: root_endpoint(backend: "8080"))
}

fn w_pair_b() -> TailscaleServeRouteSubject {
  tailscale_serve_route_subject(scope: tailscale_serve_scope(node: w_endpoint_moved_address()), endpoint: root_endpoint(backend: "8080"))
}

fn w_subject_key_of(subject: TailscaleServeRouteSubject) -> SubjectKey<ScopedKey<TailscaleServeRouteKeyRelation, TailscaleServeScopeIdentity, TailscaleServeRouteKey>> {
  SubjectKey { subject: key_relation_scoped_key(relation: tailscale_serve_route_key_relation, subject: subject) }
}

test fn w_subject_key_over_scoped_key_collides_on_uncompared_field() -> Bool {
  w_subject_key_of(subject: w_pair_a()) == w_subject_key_of(subject: w_pair_b())
}

// Mirror: a pair differing in LABEL stays distinct, so the collision above is not everything collapsing.
test fn w_subject_key_over_scoped_key_stays_distinct_on_label() -> Bool {
  let other = tailscale_serve_route_subject(
    scope: tailscale_serve_scope(node: srv2_tailscale_endpoint),
    endpoint: root_endpoint(backend: "8080"),
  )
  w_subject_key_of(subject: tailscale_route_subject(endpoint: root_endpoint(backend: "8080"))) != w_subject_key_of(subject: other)
}

// Discrimination: a FULL-NetworkEndpoint scope projection would NOT collide this pair, so the collision
// test above fails the moment scope_of widens to the whole endpoint.
test fn w_full_endpoint_scope_projection_would_distinguish_the_pair() -> Bool {
  w_pair_a().scope.node != w_pair_b().scope.node
}
  let b = SubjectKey { subject: key_relation_scoped_key(relation: tailscale_serve_route_key_relation, subject: srv1_root_route_subject()) }
  a == b
}
