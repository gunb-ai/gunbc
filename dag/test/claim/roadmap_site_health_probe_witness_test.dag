module test.claim.roadmap_site_health_probe

import gunbc.roadmap_site_health_probe {
  roadmap_site_health_probe_port,
  roadmap_site_health_probe_url,
  roadmap_site_health_probe_get_spec,
}
import gunbc.roadmap_static_site { roadmap_site_health_path }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn witness_health_probe_url_matches_local_healthz() -> Bool {
  roadmap_site_health_probe_url(port: 8080) == "http://127.0.0.1:8080/healthz"
}

fn witness_health_probe_spec_path_is_authority() -> Bool {
  roadmap_site_health_probe_get_spec(port: 8080).path == roadmap_site_health_path
}

fn witness_health_probe_port_matches_service_shape() -> Bool {
  roadmap_site_health_probe_port() == 8080
}

fn witness_health_probe_rest_get_path_wired() -> Bool {
  string_contains(s: roadmap_site_health_probe_url(port: roadmap_site_health_probe_port()), pattern: roadmap_site_health_path as String)
}

test fn roadmap_site_health_probe_witnesses() -> Bool {
  witness_health_probe_url_matches_local_healthz()
    && witness_health_probe_spec_path_is_authority()
    && witness_health_probe_port_matches_service_shape()
    && witness_health_probe_rest_get_path_wired()
}
