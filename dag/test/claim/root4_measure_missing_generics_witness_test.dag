module test.claim.root4_measure_missing_generics_witness

import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data root4_measure_missing_generics_witness_note: String = "Root-4 measure_missing_generics bucket (sharp-bee-290 / PR #7289): fn-generic List<Measure<Time, S, Nat>> params must forward applied Q/S/M through render_rust_decl_type container-arg rendering. Positive control (green when fixed, red when generics drop): w_measure_list_param_preserves_applied_generics. Negative control (wrong_generic_arity bucket must stay untouched): w_zero_param_alias_list_param_unchanged. Fixtures import std.measure / std.realization_measurement — never fork Quantity, Scale, Measure, or ByteSize."

fn w_measure_list_param_preserves_applied_generics() -> Bool {
  compile_dag_rust_emit_check(
    "module root4_measure_list\nimport std.measure { Measure, Time, time_measure }\nimport std.nat { Nat }\nimport std.realization_measurement { time_measure_list_total }\n\nfn witness<S>(times: List<Measure<Time, S, Nat>>) -> Measure<Time, S, Nat> {\n  time_measure_list_total(times: times)\n}\n",
    "src/root4_measure_list.rs",
    ["Vec<Rc<Measure<(), S, Nat>>", "-> Rc<Measure<(), S, Nat>>"],
    ["Vec<Rc<Measure>>", "Rc<Measure>>"]
  )
}

fn w_zero_param_alias_list_param_unchanged() -> Bool {
  compile_dag_rust_emit_check(
    "module root4_zero_param_alias\nimport std.measure { ByteSize }\nimport std.realization_measurement { space_measure_list_seq }\n\nfn witness(spaces: List<ByteSize>) -> ByteSize {\n  space_measure_list_seq(spaces: spaces)\n}\n",
    "src/root4_zero_param_alias.rs",
    ["Vec<ByteSize>"],
    ["ByteSize<", "Vec<Rc<Measure"]
  )
}

test fn root4_measure_missing_generics_witness_holds() -> Bool {
  w_measure_list_param_preserves_applied_generics()
    && w_zero_param_alias_list_param_unchanged()
}
