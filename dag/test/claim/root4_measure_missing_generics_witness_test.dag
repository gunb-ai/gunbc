module test.claim.root4_measure_missing_generics_witness

import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data root4_measure_missing_generics_witness_note: String = "Root-4 measure_missing_generics family: a function-generic container argument must preserve its applied arguments through render_rust_decl_type overlay resolution. The executable emitter-level fixtures use deliberately synthetic Root4AppliedCarrier and Root4AliasCarrier names, so they exercise the structural shape without re-declaring the canonical std.measure.Measure authority; canonical Measure behavior is covered by the stamped canonical-seven receipt. The decision is structural (__applied_type_args or resolved-type children), never a Measure name check. RED controls: w_zero_param_alias_list_param_unchanged preserves the existing closed-alias realization; w_homonym_measure_zero_param_list_unchanged proves an unrelated zero-parameter homonym does not gain arguments."

fn w_applied_generic_carrier_preserves_arguments() -> Bool {
  compile_dag_rust_emit_check(
    "module root4_applied_carrier\n\ntype ProbeQuantity { value: Int }\ntype ProbeMagnitude { value: Int }\ntype Root4AppliedCarrier<Q, S, M> { payload: M }\n\nfn witness<S>(items: List<Root4AppliedCarrier<ProbeQuantity, S, ProbeMagnitude>>) -> List<Root4AppliedCarrier<ProbeQuantity, S, ProbeMagnitude>> {\n  items\n}\n",
    "src/root4_applied_carrier.rs",
    ["Vec<Rc<Root4AppliedCarrier<ProbeQuantity, S, ProbeMagnitude>>"],
    ["Vec<Rc<Root4AppliedCarrier>>", "Rc<Root4AppliedCarrier>>"]
  )
}

fn w_zero_param_alias_list_param_unchanged() -> Bool {
  compile_dag_rust_emit_check(
    "module root4_closed_alias\n\ntype ProbeQuantity\ntype ProbeScale\ntype ProbeMagnitude\ntype Root4AliasCarrier<Q, S, M> { payload: M }\ntype ClosedCarrierAlias = Root4AliasCarrier<ProbeQuantity, ProbeScale, ProbeMagnitude>\n\nfn witness(items: List<ClosedCarrierAlias>) -> List<ClosedCarrierAlias> {\n  items\n}\n",
    "src/root4_closed_alias.rs",
    ["Rc<Vec<ClosedCarrierAlias<ProbeQuantity, ProbeScale, ProbeMagnitude>>"],
    ["Vec<Rc<Root4AliasCarrier"]
  )
}

fn w_homonym_measure_zero_param_list_unchanged() -> Bool {
  compile_dag_rust_emit_check(
    "module root4.homonym_measure\nimport std.nat { Nat }\n\ntype Measure { count: Nat }\n\nfn witness(items: List<Measure>) -> Measure {\n  Measure { count: 0 }\n}\n",
    "src/root4_homonym_measure.rs",
    ["Vec<Rc<Measure>>"],
    ["Measure<(),", "Measure<Time", "< S,", "<Memory"]
  )
}

test fn root4_measure_missing_generics_witness_holds() -> Bool {
  w_applied_generic_carrier_preserves_arguments()
    && w_zero_param_alias_list_param_unchanged()
    && w_homonym_measure_zero_param_list_unchanged()
}
