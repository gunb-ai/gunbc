module test.claim.guarantee_rung_drop_witness_test

import std.types { String, List, Bool }
import gunbc.guarantee_rung_drop {
  GuaranteeRungDrop, GuaranteeRung,
  OutsideTheLadder, Mitigatable, MechanicallyPreventable,
  LostAsPassenger, DeletedWithoutReplacement,
  rung_drop_refusal_message, rung_drop_is_off_ladder, guarantee_rung_label,
  GuaranteeStall,
  CannotClimbFurther, ClimbableButUnbuilt,
  BoundedPopulation, UncountedNotEnumerable,
  StructurallyGuaranteed, StructurallyImpossible,
  guarantee_rung_index, stall_is_below_ceiling, stall_is_permanent, stall_report_message,
  next_rung_trigger_enforcement_stall,
}
import tools.ci_gates { source_root_ingest_gate_rung_drop }

// A CONTROL DROP THAT DIFFERS FROM THE LIVE ROW IN EVERY DECIDED FIELD. Its purpose is to make
// the assertions below discriminating: a renderer that ignored its argument, or an off-ladder
// predicate that answered a constant, would agree with the live row here and be caught.
data control_rung_drop: GuaranteeRungDrop = GuaranteeRungDrop {
    subject: "control.subject",
    previous: MechanicallyPreventable,
    temporary: Mitigatable,
    reason: DeletedWithoutReplacement,
    population: ["control.population.one"],
    restoration_trigger: "control restoration trigger"
  }

// Local one-liner over the builtin rather than an import: three test files already declare their
// own `string_contains`, so a fourth would make the bare name ambiguous corpus-wide. This is a
// witness's incidental helper, not a shared authority, and it is named distinctly for that reason.
fn contains_text(haystack: String, needle: String) -> Bool {
  haystack.contains(needle)
}

// THE LIVE ROW IS OFF THE LADDER AND THE CONTROL IS NOT. Both directions asserted, because a
// predicate stuck at true and a predicate stuck at false are different defects and one assertion
// only sees one of them.
test fn source_root_ingest_gate_drop_is_off_ladder() -> Bool {
  rung_drop_is_off_ladder(d: source_root_ingest_gate_rung_drop)
    && !rung_drop_is_off_ladder(d: control_rung_drop)
}

// THE RENDERED REFUSAL CARRIES THE ROW'S OWN FIELDS. This is what makes the gate arm a projection
// of the declaration rather than a second authority restating it: if the row's subject or
// restoration trigger is edited and the message stops naming them, this reds.
test fn rung_drop_message_names_subject_and_trigger() -> Bool {
  let m = rung_drop_refusal_message(d: source_root_ingest_gate_rung_drop)
  contains_text(haystack: m, needle: "v2.workflow.source_root_ingest_gate")
    && contains_text(haystack: m, needle: "outside the ladder")
    && contains_text(haystack: m, needle: "lost as a passenger of")
    && contains_text(haystack: m, needle: "a live workflow reaches")
}

// THE RENDERER READS ITS ARGUMENT. The control's text must NOT appear in the live row's message
// and vice versa -- the assertion a constant-returning renderer fails.
test fn rung_drop_message_discriminates_between_rows() -> Bool {
  let live = rung_drop_refusal_message(d: source_root_ingest_gate_rung_drop)
  let ctl = rung_drop_refusal_message(d: control_rung_drop)
  !contains_text(haystack: live, needle: "control.subject")
    && !contains_text(haystack: ctl, needle: "v2.workflow.source_root_ingest_gate")
    && contains_text(haystack: ctl, needle: "deleted without replacement")
}

// EVERY RUNG HAS A DISTINCT LABEL. A label fold that collapsed two rungs would make a census over
// rung drops silently wrong, and nothing else in this module would notice.
test fn guarantee_rung_labels_are_distinct() -> Bool {
  let a = guarantee_rung_label(r: OutsideTheLadder)
  let b = guarantee_rung_label(r: Mitigatable)
  let c = guarantee_rung_label(r: MechanicallyPreventable)
  (a != b) && (b != c) && (a != c)
}

// A CONTROL STALL DIFFERING FROM THE LIVE ROW IN EVERY DECIDED FIELD, for the reason the control
// drop above gives: a renderer that ignored its argument, or a predicate that answered a constant,
// would agree with the live row and go unseen.
data control_stall: GuaranteeStall = GuaranteeStall {
  subject: "control.stall.subject",
  current: StructurallyGuaranteed,
  ceiling: StructurallyGuaranteed,
  blocker: CannotClimbFurther { why: "control why" },
  population: BoundedPopulation { members: ["control.stall.member"] },
  next_rung_trigger: "control stall trigger"
}

// THE PERMANENCE FOLD READS THE BLOCKER, in both directions. Only CannotClimbFurther is permanent,
// and a fold stuck at either constant is a different defect, so one assertion sees only one of them.
test fn stall_permanence_follows_the_blocker() -> Bool {
  stall_is_permanent(s: control_stall)
    && !stall_is_permanent(s: next_rung_trigger_enforcement_stall)
}

// THE LIVE ROW IS BELOW ITS CEILING AND THE CONTROL IS NOT. This is the assertion that makes the
// live row a stall rather than a class that already arrived: if it is ever edited so that current
// equals ceiling, the row stops describing a stall and this reds.
test fn live_stall_is_below_its_ceiling() -> Bool {
  stall_is_below_ceiling(s: next_rung_trigger_enforcement_stall)
    && !stall_is_below_ceiling(s: control_stall)
}

// THE LADDER ORDER IS STRICT AND TOTAL. A rung index that collapsed two rungs would make
// stall_is_below_ceiling silently wrong for exactly the pair it collapsed, and nothing else here
// would notice.
test fn guarantee_rung_index_is_strictly_ordered() -> Bool {
  guarantee_rung_index(r: OutsideTheLadder) < guarantee_rung_index(r: Mitigatable)
    && guarantee_rung_index(r: Mitigatable) < guarantee_rung_index(r: MechanicallyPreventable)
    && guarantee_rung_index(r: MechanicallyPreventable) < guarantee_rung_index(r: StructurallyGuaranteed)
    && guarantee_rung_index(r: StructurallyGuaranteed) < guarantee_rung_index(r: StructurallyImpossible)
}

// AN UNCOUNTED POPULATION RENDERS AS UNCOUNTED, NEVER AS EMPTY. This is the discriminating claim
// against the empty-observation narrow: a renderer that folded UncountedNotEnumerable through the
// same path as a bounded list would emit nothing here and the stall would read as affecting no one.
test fn uncounted_population_does_not_render_as_empty() -> Bool {
  let live = stall_report_message(s: next_rung_trigger_enforcement_stall)
  let ctl = stall_report_message(s: control_stall)
  contains_text(haystack: live, needle: "UNCOUNTED, not enumerable")
    && !contains_text(haystack: ctl, needle: "UNCOUNTED, not enumerable")
    && contains_text(haystack: ctl, needle: "control.stall.member")
}

// THE REPORT READS ITS ARGUMENT AND CARRIES THE ROW'S OWN TRIGGER. The trigger half is the point of
// the carrier: if the required field is ever emptied or the renderer stops projecting it, the fact
// section 4b(2) obliges becomes invisible again and this reds.
test fn stall_report_names_subject_and_trigger() -> Bool {
  let live = stall_report_message(s: next_rung_trigger_enforcement_stall)
  let ctl = stall_report_message(s: control_stall)
  contains_text(haystack: live, needle: "DESIGN section 4b(2) next-rung trigger enforcement")
    && contains_text(haystack: live, needle: "GuaranteeStall rather than in prose")
    && contains_text(haystack: live, needle: "climbable now but unbuilt")
    && !contains_text(haystack: live, needle: "control.stall.subject")
    && !contains_text(haystack: ctl, needle: "DESIGN section 4b(2)")
}
