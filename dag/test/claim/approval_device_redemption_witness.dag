data key_a: VerifyingKey = VerifyingKey { suite: EcdsaP256Sha256, encoding: Sec1Uncompressed, point_b64url: "BKEYA" }
data key_b: VerifyingKey = VerifyingKey { suite: EcdsaP256Sha256, encoding: Sec1Uncompressed, point_b64url: "BKEYB" }
data sig: SignatureBytes = SignatureBytes { suite: EcdsaP256Sha256, encoding: P1363FixedWidth, b64url: "SIG" }

// ── Push outcomes ────────────────────────────────────────────────────────────────────────────

// 410 IS THE ONE STATUS THAT IS NOT A RETRY: the registration is dead.
test fn witness_apns_410_becomes_registration_invalid() -> Bool {
  match push_outcome_of_apns(o: apns_send_outcome_of(rest: RestRefused { refusal: RestStatusRefused { status: 410, body: "{\"reason\":\"Unregistered\"}" } })) {
    PushRegistrationInvalid { provider: _, detail } => detail != ""
    _ => false
  }
}

test fn witness_apns_429_stays_a_retryable_refusal_carrying_its_status() -> Bool {
  match push_outcome_of_apns(o: apns_send_outcome_of(rest: RestRefused { refusal: RestStatusRefused { status: 429, body: "{\"reason\":\"TooManyRequests\"}" } })) {
    PushProviderRefused { provider: _, status, detail: _, retryable } => status == 429 && retryable
    _ => false
  }
}

test fn witness_apns_ok_carries_apns_id() -> Bool {
  match push_outcome_of_apns(o: apns_send_outcome_of(rest: RestAnswered { answer: "id-7" })) {
    PushProviderAccepted { provider: _, receipt } => receipt as String == "id-7"
    _ => false
  }
}

// A 200 WITHOUT apns-id IS NOT AN ACCEPTANCE: it must not become PushProviderAccepted on an empty id.
test fn witness_apns_ok_without_apns_id_is_undecodable() -> Bool {
  match push_outcome_of_apns(o: apns_send_outcome_of(rest: RestAnswered { answer: "" })) {
    PushProviderUndecodable { provider: _, status, cause: _ } => status == 200
    _ => false
  }
}

test fn witness_apns_transport_refusal_has_no_status() -> Bool {
  match push_outcome_of_apns(o: apns_send_outcome_of(rest: RestRefused { refusal: RestTransportRefused { cause: "connect refused" } })) {
    PushProviderUnreached { provider: _, cause } => cause == "connect refused"
    _ => false
  }
}


// ── The enrolment the redemption fixtures decide under ───────────────────────────────────────
data fx_observed_at: Timestamp = "2026-09-17T10:00:00Z"

fn fx_enrollment_id() -> NonEmptyStr {
  google_enrollment_id(subject: fx_subject, decision_key: key_a)
}

// EVIDENCE-RETURNING FIXTURES ARE CALLER-SEALED DOWN TO THE TERMINAL CLAIMS: the enrolment is
// minted by the real production fold in approval_google_enrolment_witness (fx_brian_enrolment), and
// this wrapper admits only the declarations of this module that use it.
fn fx_admitted_enrollment() -> GoogleDeviceEnrollment?
  admit_callers: [
    decl_ref(module_path: "test.claim.approval_device_redemption_witness", decl_name: "admit"),
    decl_ref(module_path: "test.claim.approval_device_redemption_witness", decl_name: "witness_device_redemption_refuses_a_revoked_enrollment_before_the_store"),
    decl_ref(module_path: "test.claim.approval_device_redemption_witness", decl_name: "witness_enrolment_readback_projects_the_stored_standing"),
    decl_ref(module_path: "test.claim.approval_device_redemption_witness", decl_name: "witness_enrolment_record_at_the_wrong_generation_is_unreadable"),
    decl_ref(module_path: "test.claim.approval_device_redemption_witness", decl_name: "witness_enrolment_record_round_trips_at_generation_one"),
    decl_ref(module_path: "test.claim.approval_device_redemption_witness", decl_name: "witness_enrolment_record_round_trips_revoked_at_generation_two"),
  ]
{
  fx_brian_enrolment()
}

// ── Redemption admission: every gate, real MACs, no store ────────────────────────────────────
// The key and request are the store witness's fixtures (approval_decision_store_witness_test); the
// challenge nonce and capability tag are minted here by mac_sign under that key, so each refusal
// differs from the admitted control in exactly one input.
data fx_key_hex: String = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

fn fx_key() -> MacKey {
  MacKey { id: approval_mac_key_id, suite: HmacSha256, material: fx_key_hex as Secret }
}

fn fx_request() -> StoredApprovalRequest {
  StoredApprovalRequest {
    escalation_id: "esc-mtc1-boot-1",
    request_revision: "sha256:abababababababababababababababababababababababababababababababab",
    attempt: "mtc1-boot-attempt-1" as AttemptIdentity,
    requester: "eager-owl-205",
    purpose: "Boot Mt. Collins unit 1 once from the diskless image over BMC virtual media.",
    destructive: true,
    issued_at: "2026-09-16T20:00:00Z",
    expires_at: "2026-09-17T20:00:00Z",
    key_id: approval_mac_key_id,
  }
}

data fx_challenge_expiry: Timestamp = "2026-09-17T10:05:00Z"

fn mac_hex(message: NonEmptyStr) -> NonEmptyStr {
  match mac_sign(key: fx_key(), message: message) {
    MacSigned { tag: t } => t.hex
    MacKeyMaterialNotHex { key_id: _ } => "not-hex"
  }
}

fn fx_signing_input(request_text: NonEmptyStr, expiry: Timestamp, nonce: NonEmptyStr, tag: NonEmptyStr) -> DeviceRedemptionSigningInput {
  DeviceRedemptionSigningInput {
    audience: approval_device_audience,
    enrollment_id: fx_enrollment_id(),
    challenge: RedemptionChallenge { expires_at: expiry, nonce_hex: nonce },
    escalation_id: fx_request().escalation_id,
    request_revision: fx_request().request_revision,
    stored_request_text: request_text,
    decision: ProposeApprove,
    capability_text: approval_capability_signing_input(c: claims_for(request: fx_request(), decision: ProposeApprove)),
    capability_tag_b64url: tag,
  }
}

fn fx_nonce() -> NonEmptyStr {
  mac_hex(message: redemption_challenge_message(escalation_id: fx_request().escalation_id, request_revision: fx_request().request_revision, enrollment_id: fx_enrollment_id(), expires_at: fx_challenge_expiry))
}

// THE TAG COMES FROM REAL ISSUANCE, in its canonical base64url wire spelling -- the same route the
// server's links take -- so admission's capability_tag_hex conversion is exercised, not bypassed.
fn issued_tag(decision: ProposedDecision) -> NonEmptyStr {
  match issue_capability(claims: claims_for(request: fx_request(), decision: decision), key: fx_key()) {
    CapabilityIssued { capability: c } => c.tag_b64url
    CapabilityIssuanceRefused { cause: _ } => "issuance-refused"
  }
}

fn fx_tag() -> NonEmptyStr {
  issued_tag(decision: ProposeApprove)
}

fn fx_good_input() -> DeviceRedemptionSigningInput {
  fx_signing_input(request_text: stored_request_json(r: fx_request()) as NonEmptyStr, expiry: fx_challenge_expiry, nonce: fx_nonce(), tag: fx_tag())
}

fn verdict(key: VerifyingKey, message: NonEmptyStr) -> SignatureVerification
  admit_callers: [
    decl_ref(module_path: "test.claim.approval_device_redemption_witness", decl_name: "good_signature"),
    decl_ref(module_path: "test.claim.approval_device_redemption_witness", decl_name: "witness_device_admission_refuses_a_capability_for_the_other_verb"),
    decl_ref(module_path: "test.claim.approval_device_redemption_witness", decl_name: "witness_device_admission_refuses_a_challenge_not_issued_here"),
    decl_ref(module_path: "test.claim.approval_device_redemption_witness", decl_name: "witness_device_admission_refuses_a_different_displayed_request"),
    decl_ref(module_path: "test.claim.approval_device_redemption_witness", decl_name: "witness_device_admission_refuses_a_hex_tag_in_the_base64url_field"),
    decl_ref(module_path: "test.claim.approval_device_redemption_witness", decl_name: "witness_device_admission_refuses_a_signature_over_other_bytes"),
    decl_ref(module_path: "test.claim.approval_device_redemption_witness", decl_name: "witness_device_admission_refuses_a_signature_under_another_key"),
    decl_ref(module_path: "test.claim.approval_device_redemption_witness", decl_name: "witness_device_admission_refuses_an_expired_challenge"),
  ]
{
  signature_verification_from_implementation(key: key, key_size: byte_size(count: 65), signature: sig, signature_size: byte_size(count: 64), message: message, implementation_verified: true)
}

fn assertion_over(key_id: NonEmptyStr, client_data: NonEmptyStr) -> AssertionVerification
  admit_callers: [
    decl_ref(module_path: "test.claim.approval_device_redemption_witness", decl_name: "good_assertion"),
    decl_ref(module_path: "test.claim.approval_device_redemption_witness", decl_name: "witness_device_admission_refuses_a_capability_for_the_other_verb"),
    decl_ref(module_path: "test.claim.approval_device_redemption_witness", decl_name: "witness_device_admission_refuses_a_challenge_not_issued_here"),
    decl_ref(module_path: "test.claim.approval_device_redemption_witness", decl_name: "witness_device_admission_refuses_a_different_displayed_request"),
    decl_ref(module_path: "test.claim.approval_device_redemption_witness", decl_name: "witness_device_admission_refuses_a_hex_tag_in_the_base64url_field"),
    decl_ref(module_path: "test.claim.approval_device_redemption_witness", decl_name: "witness_device_admission_refuses_an_assertion_from_another_app_key"),
    decl_ref(module_path: "test.claim.approval_device_redemption_witness", decl_name: "witness_device_admission_refuses_an_assertion_over_other_bytes"),
    decl_ref(module_path: "test.claim.approval_device_redemption_witness", decl_name: "witness_device_admission_refuses_an_expired_challenge"),
  ]
{
  assertion_verification_from_implementation(key_id: key_id, public_key_point_b64url: "BATTEST", counter: 1, client_data: client_data, refusal: none)
}

fn admit(input: DeviceRedemptionSigningInput, signature: SignatureVerification, assertion: AssertionVerification) -> DeviceAdmission
  admit_callers: [
    decl_ref(module_path: "test.claim.approval_device_redemption_witness", decl_name: "witness_device_admission_refuses_a_sidecar_assertion_for_another_key_id"),
    decl_ref(module_path: "test.claim.approval_device_redemption_witness", decl_name: "witness_device_admission_admits_a_sidecar_assertion_for_the_enrolled_key_id"),
    decl_ref(module_path: "test.claim.approval_device_redemption_witness", decl_name: "witness_device_admission_admits_the_exact_signed_request"),
    decl_ref(module_path: "test.claim.approval_device_redemption_witness", decl_name: "witness_device_admission_refuses_a_capability_for_the_other_verb"),
    decl_ref(module_path: "test.claim.approval_device_redemption_witness", decl_name: "witness_device_admission_refuses_a_challenge_not_issued_here"),
    decl_ref(module_path: "test.claim.approval_device_redemption_witness", decl_name: "witness_device_admission_refuses_a_different_displayed_request"),
    decl_ref(module_path: "test.claim.approval_device_redemption_witness", decl_name: "witness_device_admission_refuses_a_hex_tag_in_the_base64url_field"),
    decl_ref(module_path: "test.claim.approval_device_redemption_witness", decl_name: "witness_device_admission_refuses_a_refused_assertion"),
    decl_ref(module_path: "test.claim.approval_device_redemption_witness", decl_name: "witness_device_admission_refuses_a_signature_over_other_bytes"),
    decl_ref(module_path: "test.claim.approval_device_redemption_witness", decl_name: "witness_device_admission_refuses_a_signature_under_another_key"),
    decl_ref(module_path: "test.claim.approval_device_redemption_witness", decl_name: "witness_device_admission_refuses_an_assertion_from_another_app_key"),
    decl_ref(module_path: "test.claim.approval_device_redemption_witness", decl_name: "witness_device_admission_refuses_an_assertion_over_other_bytes"),
    decl_ref(module_path: "test.claim.approval_device_redemption_witness", decl_name: "witness_device_admission_refuses_an_assertion_under_another_public_key"),
    decl_ref(module_path: "test.claim.approval_device_redemption_witness", decl_name: "witness_device_admission_refuses_an_expired_challenge"),
  ]
{
  match fx_admitted_enrollment() {
    Absent => DeviceNotAdmitted { outcome: DeviceEnrollmentUnknown }
    Present { value: e } =>
      device_redemption_admission(key: fx_key(), enrollment: e, request: fx_request(), signed: input, signature: signature, assertion: assertion, observed_at: fx_observed_at)
  }
}

fn good_signature() -> SignatureVerification
  admit_callers: [
    decl_ref(module_path: "test.claim.approval_device_redemption_witness", decl_name: "witness_device_admission_refuses_a_sidecar_assertion_for_another_key_id"),
    decl_ref(module_path: "test.claim.approval_device_redemption_witness", decl_name: "witness_device_admission_admits_a_sidecar_assertion_for_the_enrolled_key_id"),
    decl_ref(module_path: "test.claim.approval_device_redemption_witness", decl_name: "witness_device_admission_admits_the_exact_signed_request"),
    decl_ref(module_path: "test.claim.approval_device_redemption_witness", decl_name: "witness_device_admission_refuses_a_refused_assertion"),
    decl_ref(module_path: "test.claim.approval_device_redemption_witness", decl_name: "witness_device_admission_refuses_an_assertion_from_another_app_key"),
    decl_ref(module_path: "test.claim.approval_device_redemption_witness", decl_name: "witness_device_admission_refuses_an_assertion_over_other_bytes"),
    decl_ref(module_path: "test.claim.approval_device_redemption_witness", decl_name: "witness_device_admission_refuses_an_assertion_under_another_public_key"),
    decl_ref(module_path: "test.claim.approval_device_redemption_witness", decl_name: "witness_device_admission_refuses_an_enrollment_for_another_operator"),
    decl_ref(module_path: "test.claim.approval_device_redemption_witness", decl_name: "witness_device_admission_refuses_an_enrollment_for_an_email_off_the_roster"),
    decl_ref(module_path: "test.claim.approval_device_redemption_witness", decl_name: "witness_device_redemption_refuses_a_revoked_enrollment_before_the_store"),
    decl_ref(module_path: "test.claim.approval_device_redemption_witness", decl_name: "witness_device_redemption_refuses_an_unknown_enrollment_before_the_store"),
  ]
{
  verdict(key: key_a, message: device_redemption_signing_input(i: fx_good_input()))
}

fn good_assertion() -> AssertionVerification
  admit_callers: [
    decl_ref(module_path: "test.claim.approval_device_redemption_witness", decl_name: "witness_device_admission_admits_the_exact_signed_request"),
    decl_ref(module_path: "test.claim.approval_device_redemption_witness", decl_name: "witness_device_admission_refuses_a_signature_over_other_bytes"),
    decl_ref(module_path: "test.claim.approval_device_redemption_witness", decl_name: "witness_device_admission_refuses_a_signature_under_another_key"),
    decl_ref(module_path: "test.claim.approval_device_redemption_witness", decl_name: "witness_device_admission_refuses_an_enrollment_for_another_operator"),
    decl_ref(module_path: "test.claim.approval_device_redemption_witness", decl_name: "witness_device_admission_refuses_an_enrollment_for_an_email_off_the_roster"),
    decl_ref(module_path: "test.claim.approval_device_redemption_witness", decl_name: "witness_device_redemption_refuses_a_revoked_enrollment_before_the_store"),
    decl_ref(module_path: "test.claim.approval_device_redemption_witness", decl_name: "witness_device_redemption_refuses_an_unknown_enrollment_before_the_store"),
  ]
{
  assertion_over(key_id: "ATTESTKEY", client_data: device_redemption_signing_input(i: fx_good_input()))
}

// THE POSITIVE CONTROL: every gate passes; the admitted value names the ENROLMENT'S login.
test fn witness_device_admission_admits_the_exact_signed_request() -> Bool {
  match admit(input: fx_good_input(), signature: good_signature(), assertion: good_assertion()) {
    DeviceAdmitted { admitted: a } => (a.decided_by as String) == "brian@gunb.ai" && a.claims.escalation_id == fx_request().escalation_id
    DeviceNotAdmitted { outcome: _ } => false
  }
}

test fn witness_device_admission_refuses_a_different_displayed_request() -> Bool {
  let i = fx_signing_input(request_text: "{\"kind\":\"request\"}", expiry: fx_challenge_expiry, nonce: fx_nonce(), tag: fx_tag())
  match admit(input: i, signature: verdict(key: key_a, message: device_redemption_signing_input(i: i)), assertion: assertion_over(key_id: "ATTESTKEY", client_data: device_redemption_signing_input(i: i))) {
    DeviceNotAdmitted { outcome: DeviceSignedForAnotherRequest { field: f } } => f as String == "stored_request_text"
    _ => false
  }
}

test fn witness_device_admission_refuses_an_expired_challenge() -> Bool {
  let i = fx_signing_input(request_text: stored_request_json(r: fx_request()) as NonEmptyStr, expiry: "2026-09-17T09:59:00Z", nonce: fx_nonce(), tag: fx_tag())
  match admit(input: i, signature: verdict(key: key_a, message: device_redemption_signing_input(i: i)), assertion: assertion_over(key_id: "ATTESTKEY", client_data: device_redemption_signing_input(i: i))) {
    DeviceNotAdmitted { outcome: DeviceChallengeExpired { expires_at: _, observed_at: _ } } => true
    _ => false
  }
}

test fn witness_device_admission_refuses_a_challenge_not_issued_here() -> Bool {
  let forged = mac_hex(message: redemption_challenge_message(escalation_id: fx_request().escalation_id, request_revision: fx_request().request_revision, enrollment_id: fx_enrollment_id(), expires_at: "2026-09-17T11:00:00Z"))
  let i = fx_signing_input(request_text: stored_request_json(r: fx_request()) as NonEmptyStr, expiry: fx_challenge_expiry, nonce: forged, tag: fx_tag())
  match admit(input: i, signature: verdict(key: key_a, message: device_redemption_signing_input(i: i)), assertion: assertion_over(key_id: "ATTESTKEY", client_data: device_redemption_signing_input(i: i))) {
    DeviceNotAdmitted { outcome: DeviceChallengeNotIssuedHere } => true
    _ => false
  }
}

test fn witness_device_admission_refuses_a_capability_for_the_other_verb() -> Bool {
  let deny_tag = issued_tag(decision: ProposeDeny)
  let i = fx_signing_input(request_text: stored_request_json(r: fx_request()) as NonEmptyStr, expiry: fx_challenge_expiry, nonce: fx_nonce(), tag: deny_tag)
  match admit(input: i, signature: verdict(key: key_a, message: device_redemption_signing_input(i: i)), assertion: assertion_over(key_id: "ATTESTKEY", client_data: device_redemption_signing_input(i: i))) {
    DeviceNotAdmitted { outcome: DeviceCapabilityRefused { cause: _ } } => true
    _ => false
  }
}

test fn witness_device_admission_refuses_a_signature_over_other_bytes() -> Bool {
  match admit(input: fx_good_input(), signature: verdict(key: key_a, message: "something else"), assertion: good_assertion()) {
    DeviceNotAdmitted { outcome: DeviceSignatureRefused { verification: _ } } => true
    _ => false
  }
}

test fn witness_device_admission_refuses_a_signature_under_another_key() -> Bool {
  match admit(input: fx_good_input(), signature: verdict(key: key_b, message: device_redemption_signing_input(i: fx_good_input())), assertion: good_assertion()) {
    DeviceNotAdmitted { outcome: DeviceSignatureRefused { verification: _ } } => true
    _ => false
  }
}

test fn witness_device_admission_refuses_a_refused_assertion() -> Bool {
  let refused = assertion_verification_from_implementation(key_id: "ATTESTKEY", public_key_point_b64url: "BATTEST", counter: 1, client_data: device_redemption_signing_input(i: fx_good_input()), refusal: Present { value: AssertionSignatureInvalid })
  match admit(input: fx_good_input(), signature: good_signature(), assertion: refused) {
    DeviceNotAdmitted { outcome: DevicePlatformProofRefused { cause: _ } } => true
    _ => false
  }
}

test fn witness_device_admission_refuses_an_assertion_from_another_app_key() -> Bool {
  match admit(input: fx_good_input(), signature: good_signature(), assertion: assertion_over(key_id: "attest-other", client_data: device_redemption_signing_input(i: fx_good_input()))) {
    DeviceNotAdmitted { outcome: DevicePlatformProofWrongKey } => true
    _ => false
  }
}

test fn witness_device_admission_refuses_an_assertion_over_other_bytes() -> Bool {
  match admit(input: fx_good_input(), signature: good_signature(), assertion: assertion_over(key_id: "ATTESTKEY", client_data: "other")) {
    DeviceNotAdmitted { outcome: DevicePlatformProofForOtherBytes } => true
    _ => false
  }
}

// These refuse on the enrolment slot, before any store read, so the nonexistent root is untouched.
test fn witness_device_redemption_refuses_a_revoked_enrollment_before_the_store() -> Bool {
  match fx_admitted_enrollment() {
    Absent => false
    Present { value: e } =>
      match redeem_device_over_store(
        root: "/nonexistent/approvals",
        keyring: ApprovalKeyLoaded { key: fx_key() },
        enrolment: GoogleEnrolmentRevoked { enrollment: e, revoked_at: "2026-09-17T09:59:00Z" },
        signed: fx_good_input(),
        signature: good_signature(),
        assertion: good_assertion(),
        observed_at: fx_observed_at,
      ) {
        DeviceEnrollmentRevoked { enrollment_id: id } => (id as String) == (fx_enrollment_id() as String)
        _ => false
      }
  }
}

test fn witness_device_redemption_refuses_an_unknown_enrollment_before_the_store() -> Bool {
  match redeem_device_over_store(
    root: "/nonexistent/approvals",
    keyring: ApprovalKeyLoaded { key: fx_key() },
    enrolment: GoogleEnrolmentAbsent,
    signed: fx_good_input(),
    signature: good_signature(),
    assertion: good_assertion(),
    observed_at: fx_observed_at,
  ) {
    DeviceEnrollmentUnknown => true
    _ => false
  }
}

// An enrolment whose email is off the approver roster is refused even with every proof valid. The
// enrolment is minted by the real fold under the witness roster (operator@gunb.ai), which the
// production roster does not name.
test fn witness_device_admission_refuses_an_enrollment_for_an_email_off_the_roster() -> Bool {
  match first_write() {
    GoogleEnrolmentWrites { enrollment: e } =>
      match device_redemption_admission(key: fx_key(), enrollment: e, request: fx_request(), signed: fx_good_input(), signature: good_signature(), assertion: good_assertion(), observed_at: fx_observed_at) {
        DeviceNotAdmitted { outcome: DeviceEnrollmentNotAnApprover { email: _ } } => true
        _ => false
      }
    _ => false
  }
}

// ── The enrolment store's records ────────────────────────────────────────────────────────────
// A persisted enrolment reads back as the SAME verified enrolment, and a record at the wrong
// generation for its kind is unreadable -- never reinterpreted as a live enrolment.
test fn witness_enrolment_record_round_trips_at_generation_one() -> Bool {
  match fx_admitted_enrollment() {
    Absent => false
    Present { value: e } =>
      match parse_google_enrolment_record(text: google_enrolment_json(e: e), generation: google_enrolment_record_kind_generation(k: GoogleEnrolledRecord)) {
        GoogleEnrolmentActive { enrollment: r } =>
          r.enrollment_id == e.enrollment_id && r.google_email == e.google_email && r.google_subject == e.google_subject && r.decision_key.point_b64url == e.decision_key.point_b64url
        _ => false
      }
  }
}

test fn witness_enrolment_record_round_trips_revoked_at_generation_two() -> Bool {
  match fx_admitted_enrollment() {
    Absent => false
    Present { value: e } =>
      match parse_google_enrolment_record(text: google_revocation_json(e: e, revoked_at: "2026-09-17T11:00:00Z"), generation: google_enrolment_record_kind_generation(k: GoogleRevokedRecord)) {
        GoogleEnrolmentRevoked { enrollment: r, revoked_at: t } => r.enrollment_id == e.enrollment_id && t == "2026-09-17T11:00:00Z"
        _ => false
      }
  }
}

test fn witness_enrolment_record_at_the_wrong_generation_is_unreadable() -> Bool {
  match fx_admitted_enrollment() {
    Absent => false
    Present { value: e } =>
      match parse_google_enrolment_record(text: google_enrolment_json(e: e), generation: google_enrolment_record_kind_generation(k: GoogleRevokedRecord)) {
        GoogleEnrolmentUnreadable { detail: _ } => true
        _ => false
      }
  }
}

// THE ENCODING THE REVIEW CAUGHT: the raw lowercase-hex tag placed where the canonical base64url
// spelling belongs is refused, never verified as if it were the tag.
test fn witness_device_admission_refuses_a_hex_tag_in_the_base64url_field() -> Bool {
  let hex = mac_hex(message: approval_capability_signing_input(c: claims_for(request: fx_request(), decision: ProposeApprove)))
  let i = fx_signing_input(request_text: stored_request_json(r: fx_request()) as NonEmptyStr, expiry: fx_challenge_expiry, nonce: fx_nonce(), tag: hex)
  match admit(input: i, signature: verdict(key: key_a, message: device_redemption_signing_input(i: i)), assertion: assertion_over(key_id: "ATTESTKEY", client_data: device_redemption_signing_input(i: i))) {
    DeviceNotAdmitted { outcome: DeviceCapabilityTagMalformed } => true
    DeviceNotAdmitted { outcome: DeviceCapabilityRefused { cause: _ } } => true
    _ => false
  }
}

// An assertion under the enrolled key id but a DIFFERENT public key is not the enrolled app instance.
test fn witness_device_admission_refuses_an_assertion_under_another_public_key() -> Bool {
  let other = assertion_verification_from_implementation(key_id: "ATTESTKEY", public_key_point_b64url: "BOTHER", counter: 1, client_data: device_redemption_signing_input(i: fx_good_input()), refusal: none)
  match admit(input: fx_good_input(), signature: good_signature(), assertion: other) {
    DeviceNotAdmitted { outcome: DevicePlatformProofWrongKey } => true
    _ => false
  }
}

// THE SIDECAR'S ASSERTION ANSWER IS JOINED TO ITS REQUEST BY THE CLIENT BEFORE ANY MINT (gunbc.auth.approval_device_crypto_client
// assertion_from_answer): key id, public key and client data must be the request's own, so an answer for another key id is a
// sidecar failure there, never a verification this module's join has to catch. The admitted case is the control: the same payload
// for the enrolled key id mints, and platform_proof_disagreement then reads it as it reads one the in-process fold minted.
fn fx_assertion_request() -> AssertionExpectation {
  AssertionExpectation { key_id: "ATTESTKEY" as AttestKeyId, public_key_point_b64url: "BATTEST", client_data: device_redemption_signing_input(i: fx_good_input()), app_id: "TEAM.app", admitted_validation_categories: [1], expected_bundle_version: "1" }
}

fn fx_sidecar_answer(key_id: String) -> DeviceCryptoAnswer {
  DeviceCryptoAnswer {
    verdict: CryptoVerified, arm: device_crypto_arm_assertion_verified,
    payload: AssertedPayload { key_id: key_id as AttestKeyId, public_key_point_b64url: "BATTEST", counter: 1, client_data: device_redemption_signing_input(i: fx_good_input()) },
  }
}

fn fx_sidecar_admission() -> DeviceCryptoAdmission {
  device_crypto_receipt_admission(receipt: DeviceCryptoHandlerReceipt { handler_identity: "fixture", exact_revision: "0000000", covered: device_crypto_obligations }, required: device_crypto_obligations)
}

fn fx_sidecar_assertion() -> AssertionVerification
  admit_callers: [
    decl_ref(module_path: "test.claim.approval_device_redemption_witness", decl_name: "witness_device_admission_admits_a_sidecar_assertion_for_the_enrolled_key_id"),
  ]
{
  match assertion_from_answer(admission: fx_sidecar_admission(), answer: fx_sidecar_answer(key_id: "ATTESTKEY"), expectation: fx_assertion_request()) {
    SidecarAnswered { verification: v } => v
    _ => AssertionRefused { cause: AssertionSignatureInvalid }
  }
}

test fn witness_the_client_refuses_a_sidecar_assertion_for_another_key_id() -> Bool {
  match assertion_from_answer(admission: fx_sidecar_admission(), answer: fx_sidecar_answer(key_id: "attest-other"), expectation: fx_assertion_request()) {
    SidecarFailed { cause: _ } => true
    _ => false
  }
}

// THE READ PATH (admit_device_read_realized) AND THE ENROLMENT PATH (enrolment_admission) CONSUME WHAT THE CLIENT RETURNS, SO A VERIFIED
// ANSWER FOR ANOTHER REQUEST NEVER REACHES THEM: the client turns it into SidecarFailed (the routes' typed 503) before any mint.
test fn witness_a_read_assertion_under_another_public_key_or_client_data_is_a_sidecar_failure() -> Bool {
  let x = fx_assertion_request()
  let other_pk = DeviceCryptoAnswer { verdict: CryptoVerified, arm: device_crypto_arm_assertion_verified, payload: AssertedPayload { key_id: "ATTESTKEY" as AttestKeyId, public_key_point_b64url: "BOTHER", counter: 1, client_data: x.client_data } }
  let other_cd = DeviceCryptoAnswer { verdict: CryptoVerified, arm: device_crypto_arm_assertion_verified, payload: AssertedPayload { key_id: "ATTESTKEY" as AttestKeyId, public_key_point_b64url: "BATTEST", counter: 1, client_data: "another" } }
  match assertion_from_answer(admission: fx_sidecar_admission(), answer: other_pk, expectation: x) {
    SidecarFailed { cause: _ } =>
      match assertion_from_answer(admission: fx_sidecar_admission(), answer: other_cd, expectation: x) {
        SidecarFailed { cause: _ } => true
        _ => false
      }
    _ => false
  }
}

fn fx_attestation_request() -> AttestationExpectation {
  AttestationExpectation { key_id: "ATTESTKEY" as AttestKeyId, client_data: "cd", app_id: "TEAM.app", environment: AppAttestProduction, observed_at: fx_observed_at, admitted_validation_categories: [1], expected_bundle_version: "1" }
}

fn fx_attested(id: String, env: AppAttestEnvironment, cd: String) -> DeviceCryptoAnswer {
  DeviceCryptoAnswer { verdict: CryptoVerified, arm: device_crypto_arm_attestation_verified, payload: AttestedPayload { key_id: id as AttestKeyId, public_key_point_b64url: "BATTEST", receipt_b64: "RCPT", environment: env, client_data: cd as NonEmptyStr } }
}

fn fx_attestation_failed(r: SidecarResult<AttestationVerification>) -> Bool {
  match r {
    SidecarFailed { cause: _ } => true
    _ => false
  }
}

test fn witness_an_enrolment_attestation_for_another_key_id_environment_or_client_data_is_a_sidecar_failure() -> Bool {
  let x = fx_attestation_request()
  fx_attestation_failed(r: attestation_from_answer(admission: fx_sidecar_admission(), answer: fx_attested(id: "attest-other", env: AppAttestProduction, cd: "cd"), expectation: x))
    && fx_attestation_failed(r: attestation_from_answer(admission: fx_sidecar_admission(), answer: fx_attested(id: "ATTESTKEY", env: AppAttestDevelopment, cd: "cd"), expectation: x))
    && fx_attestation_failed(r: attestation_from_answer(admission: fx_sidecar_admission(), answer: fx_attested(id: "ATTESTKEY", env: AppAttestProduction, cd: "other"), expectation: x))
}

test fn witness_device_admission_admits_a_sidecar_assertion_for_the_enrolled_key_id() -> Bool {
  match admit(input: fx_good_input(), signature: good_signature(), assertion: fx_sidecar_assertion()) {
    DeviceAdmitted { admitted: _ } => true
    _ => false
  }
}

// THE READBACK PROJECTS THE STORED STANDING: live -> active, revoked -> revoked, and no enrolment
// (absent, unreadable) -> no readback at all.
test fn witness_enrolment_readback_projects_the_stored_standing() -> Bool {
  match fx_admitted_enrollment() {
    Absent => false
    Present { value: e } =>
      match enrolment_readback_of(slot: GoogleEnrolmentActive { enrollment: e }) { Present { value: r } => enrolment_standing_wire(s: r.standing) == enrolment_standing_wire(s: EnrolmentStandingActive) && r.enrollment_id == e.enrollment_id  Absent => false }
        && match enrolment_readback_of(slot: GoogleEnrolmentRevoked { enrollment: e, revoked_at: "2026-09-17T11:00:00Z" }) { Present { value: r } => enrolment_standing_wire(s: r.standing) == enrolment_standing_wire(s: EnrolmentStandingRevoked)  Absent => false }
        && enrolment_readback_of(slot: GoogleEnrolmentAbsent) == none
        && enrolment_readback_of(slot: GoogleEnrolmentUnreadable { detail: "x" }) == none
  }
}
