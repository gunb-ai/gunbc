module test.claim.materialization_provider_consumer_hand_rust_witness

import std.dissolution { dissolution_description }

import gunbc.materialization_provider_consumer_scaffold {
  materialization_provider_consumer_hand_rust_scaffold,
  materialization_provider_consumer_dissolve_trigger,
  materialization_provider_consumer_hand_rust_loc_delta_net,
  materialization_provider_consumer_hand_rust_paths,
  materialization_provider_consumer_receipt_plan_anchor,
  materialization_provider_consumer_roadmap_lane_anchor,
  materialization_provider_consumer_witness_entry,
}
import std.disposition { Scaffold, SingleAuthority }
import std.types { Bool }
import v2.std.algebra { length }

// Model-layer control only: the scaffold anchor is asserted, so this row does not exercise the Rust bridge.
test fn materialization_provider_consumer_hand_rust_scaffold_is_seed_retained() -> Bool {
  match materialization_provider_consumer_hand_rust_scaffold {
    Scaffold { dissolves_to: SingleAuthority, bind: _ } => true
    _ => false
  }
}

test fn materialization_provider_consumer_scaffold_names_dissolve_trigger() -> Bool {
  !(dissolution_description(condition: materialization_provider_consumer_dissolve_trigger) == "")
    && !(materialization_provider_consumer_receipt_plan_anchor == "")
    && !(materialization_provider_consumer_roadmap_lane_anchor == "")
    && materialization_provider_consumer_witness_entry ==
      "dag/test/claim/materialization_provider_consumer_hand_rust_witness_test.dag"
    && length(xs: materialization_provider_consumer_hand_rust_paths) == 2
    && materialization_provider_consumer_hand_rust_loc_delta_net == 469
}
