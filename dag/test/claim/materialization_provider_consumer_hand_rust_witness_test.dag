module test.claim.materialization_provider_consumer_hand_rust_witness

import gunbc.materialization_provider_consumer_scaffold {
  materialization_provider_consumer_hand_rust_scaffold,
  materialization_provider_consumer_dissolve_trigger,
  materialization_provider_consumer_receipt_plan_anchor,
  materialization_provider_consumer_roadmap_lane_anchor
}
import std.disposition { Scaffold }

test fn materialization_provider_consumer_hand_rust_scaffold_is_seed_retained() -> Bool {
  match materialization_provider_consumer_hand_rust_scaffold {
    Scaffold { .. } => true
    _ => false
  }
}

test fn materialization_provider_consumer_scaffold_names_dissolve_trigger() -> Bool {
  !(materialization_provider_consumer_dissolve_trigger == "")
    && !(materialization_provider_consumer_receipt_plan_anchor == "")
    && !(materialization_provider_consumer_roadmap_lane_anchor == "")
}
