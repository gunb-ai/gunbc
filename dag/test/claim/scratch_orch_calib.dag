module test.claim.scratch_orch_calib

import v2.std.orchestration {
  Pipeline, PipelineStep, Do, If, Run,
  FailFast, ExitZero, Not
}
import v2.std.collection { Absent, Present }
import v2.std.diagnostic { Accepted, Rejected, None }
import v2.compiler.emit_orchestration { orch_emit_pipeline }
import v2.extdeps.languages.bash_orchestration_emit { bash_orchestration_emit_medium }

fn calib_intent() -> Pipeline {
  Pipeline {
    steps: [
      If {
        cond: Not { inner: ExitZero {
          run: Run {
            command: concat("dpkg -s ", "tailscale"),
            env: [],
            redirect: Absent,
            capture: Absent
          }
        } },
        then_: Pipeline {
          steps: [
            Do { run: Run {
              command: concat("apt-get install -y ", "tailscale"),
              env: [],
              redirect: Absent,
              capture: Absent
            } }
          ],
          on_failure: FailFast
        },
        else_: Absent
      }
    ],
    on_failure: FailFast
  }
}

fn calib_emit() -> String {
  match orch_emit_pipeline(p: calib_intent(), medium: bash_orchestration_emit_medium()) {
    Accepted { value: source, diagnostics: d } =>
      match d {
        None => source.carried
        Some { diagnostics: _ } => "__REFUSED_WITH_DIAG__"
      }
    Rejected { diagnostics: _ } => "__REJECTED__"
  }
}

test fn scratch_orch_calib_show() -> Bool {
  string_contains(s: calib_emit(), pattern: "dpkg -s tailscale")
}
