module test.claim.transparent_alias_identity_witness_test

// THE CLASS THIS FILE HOLDS OPEN. v1.compiler.infer judges direct-call argument types by
// comparing AUTHORED TYPE NAMES, and before the transparent-alias identity relation landed it
// had no way to know that `type Handle = Payload` makes Handle and Payload one type. Measured
// on the src/v2/compiler/03_ingest closure, that single missing fact produced 115 would-be
// diagnostics at 78 call sites, 92 of them through v2.std.node's `type Hash = Fnv1a64Structural`
// -- every one a refusal of correct code, and collectively the reason the compiler's own
// argument-type judgment is switched off for the whole v2 corpus by
// module_skips_direct_call_arg_check. This witness is the executing evidence that the relation
// holds in BOTH directions at once: it must exculpate an alias and it must keep refusing
// everything that is not one.
//
// WHY EACH ARM IS HERE, and what each would catch. The first arm is the climb: it is RED on any
// build without the relation (measured against the committed binary before this change:
// "expected 'Product(Payload)', got 'Primitive(Handle)'") and green with it. On its own it is
// satisfiable by a compiler that has stopped refusing anything, which is why it never stands
// alone -- the second and third arms are its positive controls, and both were measured RED on
// that same pre-change binary, so all three arms discriminate rather than one.
//
// The third arm is the boundary the relation could most plausibly get wrong: `type IntHandle =
// Int` IS a transparent alias, so the relation must agree that IntHandle and Int are one type --
// and must NOT thereby let an IntHandle stand where a String is declared. A relation that
// over-agreed (peeled to "some ground type" and stopped comparing) would turn this arm green,
// which is exactly the erasure the class exists to prevent.
//
// dissolve-on: none. Per DESIGN section 4b(4) the production machinery a climb obsoletes is
// deleted, but the discriminating evidence stays enrolled permanently -- deleting these arms
// when they turn green would recreate specification-without-execution one rung up.

fn transparent_alias_identity_fixture_source() -> String {
  "module aliasid.probe\n\ntype Payload {\n  digest: String\n}\n\ntype Handle = Payload\n\nfn consume(p: Payload) -> String {\n  p.digest\n}\n\nfn alias_actual_at_declared_formal(h: Handle) -> String {\n  consume(p: h)\n}\n"
}

fn transparent_alias_genuine_mismatch_source() -> String {
  "module aliasid.genuine\n\nfn take_int(n: Int) -> Int {\n  n\n}\n\nfn pass_a_string(s: String) -> Int {\n  take_int(n: s)\n}\n"
}

fn transparent_alias_wrong_ground_source() -> String {
  "module aliasid.wrongground\n\ntype IntHandle = Int\n\nfn take_str(s: String) -> String {\n  s\n}\n\nfn pass_an_int_alias(i: IntHandle) -> String {\n  take_str(s: i)\n}\n"
}

// CORPUS-DERIVED SHAPES. The two sources below were not invented from this lane's hypothesis --
// they come from gunbc#8879, which attempted the same semantics at the RESOLVE seam, carried six
// enrolled witnesses green by execution including a discriminating RED and a destruction control,
// and whose corpus run then reddened 38 diagnostics in shapes neither author had conceived. Both
// of these were absent from that PR's six arms AND from this file's original five, and both were
// measured RED on the pre-relation binary and green with it, so each is a climb in its own right
// rather than a restatement of the first arm.
//
// An EMPTY RECORD is the dangerous one for this relation specifically: `type MtJadeRev1_0 {}` has
// NoConnective and zero children, which is structurally indistinguishable from the childless leaf
// transparent_alias_target_name keys on. If the relation could not tell an empty record apart from
// an alias it would mint a bogus edge here.
fn transparent_alias_empty_record_source() -> String {
  "module aliasid.emptyrec\n\ntype MtJadeRev1_0 {}\n\ntype SpecRevision = MtJadeRev1_0\n\nfn consume_rev(r: MtJadeRev1_0) -> Int {\n  1\n}\n\nfn pass_alias_of_empty_record(s: SpecRevision) -> Int {\n  consume_rev(r: s)\n}\n"
}

// A VARIANT PROJECTION position, which every other arm in this file and every arm in gunbc#8879
// missed -- all of them exercise the call-argument seam only. This one carries an alias-typed
// value into a `match`, so it exercises a DIFFERENT consumer of the same relation.
fn transparent_alias_variant_projection_source() -> String {
  "module aliasid.variantproj\n\ntype Runtime = | Local\n\ntype RuntimeAlias = Runtime\n\nfn project(r: RuntimeAlias) -> Int {\n  match r {\n    Local => 1\n  }\n}\n\nfn consume_rt(r: Runtime) -> Int {\n  project(r: r)\n}\n"
}

// HARNESS CONTROLS FOR THE TWO REFUSAL ARMS. compile_dag_rust_emit_check returns false for
// more than one reason -- a refused compile, but also a fixture the harness could not place or
// read -- so a bare `!check(...)` is satisfiable by a broken harness. Each refusal arm below is
// therefore paired with the SAME module, at the same emitted path, with only the offending call
// removed: if the pair does not split (green here, red there), the refusal arm is measuring the
// harness rather than the judgment.
fn transparent_alias_genuine_mismatch_control_source() -> String {
  "module aliasid.genuine\n\nfn take_int(n: Int) -> Int {\n  n\n}\n\nfn pass_an_int(i: Int) -> Int {\n  take_int(n: i)\n}\n"
}

fn transparent_alias_wrong_ground_control_source() -> String {
  "module aliasid.wrongground\n\ntype IntHandle = Int\n\nfn take_str(s: String) -> String {\n  s\n}\n\nfn pass_a_string(s: String) -> String {\n  take_str(s: s)\n}\n"
}

test fn w_genuine_mismatch_fixture_compiles_without_the_bad_call_test() -> Bool {
  compile_dag_rust_emit_check(
    transparent_alias_genuine_mismatch_control_source(),
    "src/aliasid_genuine.rs",
    [],
    ["compile_error"]
  )
}

test fn w_wrong_ground_fixture_compiles_without_the_bad_call_test() -> Bool {
  compile_dag_rust_emit_check(
    transparent_alias_wrong_ground_control_source(),
    "src/aliasid_wrongground.rs",
    [],
    ["compile_error"]
  )
}

// THE CLIMB. An actual whose declared type is a transparent alias of the formal's declared type
// is the same type, and the direct-call argument judgment must accept it.
test fn w_transparent_alias_actual_conforms_to_aliased_formal_test() -> Bool {
  compile_dag_rust_emit_check(
    transparent_alias_identity_fixture_source(),
    "src/aliasid_probe.rs",
    ["Payload"],
    ["compile_error"]
  )
}

// POSITIVE CONTROL 1. The judgment still refuses an argument whose type is unrelated to the
// formal's. Without this arm the arm above is satisfiable by a compiler that refuses nothing.
test fn w_genuine_argument_type_mismatch_still_refused_test() -> Bool {
  !compile_dag_rust_emit_check(
    transparent_alias_genuine_mismatch_source(),
    "src/aliasid_genuine.rs",
    [],
    []
  )
}

// POSITIVE CONTROL 2, the alias/non-alias boundary. IntHandle IS a transparent alias -- of Int,
// not of String -- so the relation must agree it is Int and must still refuse it at a String
// formal. An over-peeling relation turns this green.
test fn w_alias_of_a_different_ground_type_still_refused_test() -> Bool {
  !compile_dag_rust_emit_check(
    transparent_alias_wrong_ground_source(),
    "src/aliasid_wrongground.rs",
    [],
    []
  )
}

// CORPUS-DERIVED CLIMB 1 -- empty-record base. Measured on the pre-relation binary:
// "expected 'Product(MtJadeRev1_0)', got 'Primitive(SpecRevision)'". Green with the relation.
// This arm is the executing evidence that an empty record is not mistaken for an alias leaf.
test fn w_alias_of_an_empty_record_conforms_test() -> Bool {
  compile_dag_rust_emit_check(
    transparent_alias_empty_record_source(),
    "src/aliasid_emptyrec.rs",
    ["MtJadeRev1_0"],
    ["compile_error"]
  )
}

// CORPUS-DERIVED CLIMB 2 -- variant projection, a consumer no other arm here exercises. Measured
// on the pre-relation binary: "expected 'Primitive(RuntimeAlias)', got 'Coproduct(Runtime)'".
test fn w_alias_at_a_variant_projection_position_test() -> Bool {
  compile_dag_rust_emit_check(
    transparent_alias_variant_projection_source(),
    "src/aliasid_variantproj.rs",
    ["Local"],
    ["compile_error"]
  )
}
