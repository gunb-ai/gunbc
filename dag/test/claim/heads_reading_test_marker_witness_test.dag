module test.claim.heads_reading_test_marker_witness_test

import gunbc.compile_diagnostic_census { CensusObserved, CensusNotRunnable, census_blocking_rows }

// WHERE A DATA VALUE ENDS IN THE HEADS READING. `v1.compiler.parse` `heads_skip_data_value_tokens_at`
// skips a data value at token grain and stops at a newline that is followed by the start of an
// item. That start was decided by a hand-written keyword list beside the grammar's own item forms,
// and the list had no test marker, which `parse_item` peels before the forms. So a `test fn` or
// `test data` declared after a top-level data value was consumed as part of that value: the heads
// reading silently lost the declaration, and every pool census built on it (the name census a
// bare reference resolves through) lost its name. The repair asks the one authority
// (`heads_stream_starts_item`: the syntax spec's item forms plus `leads_with_test_marker`).
//
// The probes reference the fixture's two test functions by BARE name from an import-less module,
// so the only route to the provider is the pool name census the heads reading feeds. The
// after-data row is red on the old reading (the name is undeclared in the census, so the reference
// is a blocking diagnostic) and green on the repaired one. The before-data row was already green
// and stays green: it is what separates a repaired census from one that stopped refusing. The
// unknown-name row is the census's own refusal, kept so the helper is shown able to go red. A
// census that could not run answers a negative sentinel, never zero, so could-not-measure is not
// read as measured-nothing. dissolve-on: never -- permanent regression control for the heads
// reading's item boundary.

data heads_after_data_probe_source: String = "module heads_after_data_probe_mod\n\ntest fn heads_after_data_consumer() -> Bool \{\n  heads_after_data_marked_probe()\n}\n"

data heads_before_data_probe_source: String = "module heads_before_data_probe_mod\n\ntest fn heads_before_data_consumer() -> Bool \{\n  heads_before_data_marked_probe()\n}\n"

data heads_unknown_name_probe_source: String = "module heads_unknown_name_probe_mod\n\ntest fn heads_unknown_name_consumer() -> Bool \{\n  heads_reading_name_nobody_declares()\n}\n"

fn heads_probe_blocking_count(source: String) -> Int {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: rows } => count(census_blocking_rows(rows: rows))
    CensusNotRunnable { cause: _ } => 0 - 1
  }
}

test fn a_test_item_after_a_data_value_is_in_the_heads_census() -> Bool {
  heads_probe_blocking_count(source: heads_after_data_probe_source) == 0
}

test fn a_test_item_before_a_data_value_is_in_the_heads_census() -> Bool {
  heads_probe_blocking_count(source: heads_before_data_probe_source) == 0
}

test fn an_undeclared_bare_name_still_refuses() -> Bool {
  heads_probe_blocking_count(source: heads_unknown_name_probe_source) > 0
}
