        kind: extdeps.llm.cli_lifecycle.CodexCliProvider,
        host: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
        executable: "codex" as std.types.NonEmptyStr,
        observed_version: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
        state_directory: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
        credential_storage_method: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
        service_identity: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
      },
      bundle: gunbc.provider_standing.fixture_standing_bundle_authenticated_available(),
    ),
    claude_standing: gunbc.provider_standing.provider_standing_from_fixture_bundle(
      provider: extdeps.llm.cli_lifecycle.ProviderInstance {
        kind: extdeps.llm.cli_lifecycle.ClaudeCliProvider,
        host: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved {
          reason: "eager-raven-845 live claude credential home" as std.types.NonEmptyStr,
        },
        executable: "claude" as std.types.NonEmptyStr,
        observed_version: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved {
          reason: "eager-raven-845 live claude credential home" as std.types.NonEmptyStr,
        },
        state_directory: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved {
          reason: "eager-raven-845 live claude credential home" as std.types.NonEmptyStr,
        },
        credential_storage_method: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved {
          reason: "eager-raven-845 live claude credential home" as std.types.NonEmptyStr,
        },
        service_identity: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved {
          reason: "eager-raven-845 live claude credential home" as std.types.NonEmptyStr,
        },
      },
      bundle: gunbc.provider_standing.fixture_standing_bundle_claude_profile_present_token_absent(),
    ),
  )
  match gunbc.dispatch_selection.automatic_selection_selected_kind(inventory: inventory) {
    Present { value: kind } => kind == extdeps.llm.cli_lifecycle.CodexCliProvider
    Absent => false
  }
}

test fn witness_turn_outcome_unobserved_is_ineligible() -> Bool {
  let bundle = gunbc.provider_standing.ProviderStandingBundle {
    installation: gunbc.provider_standing.InstallationReady,
    authentication: gunbc.provider_standing.AuthenticationAuthenticated,
    entitlement: gunbc.provider_standing.EntitlementObservedAvailable,
    limits: [
      gunbc.provider_standing.LimitObservedAvailable {
        subject: gunbc.provider_standing.ProviderAccountLimit { credential: gunbc.provider_standing.LimitCredentialUnspecified },
      },
    ],
    turn: gunbc.provider_standing.TurnOutcomeUnobserved {
      reason: "no turn outcome observed at selection time" as std.types.NonEmptyStr,
    },
    tool_environment: gunbc.provider_standing.ToolEnvironmentReady,
  }
  !gunbc.provider_standing.provider_standing_is_selection_eligible(
    standing: gunbc.provider_standing.provider_standing_from_fixture_bundle(
      provider: extdeps.llm.cli_lifecycle.ProviderInstance {
        kind: extdeps.llm.cli_lifecycle.CodexCliProvider,
        host: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
        executable: "codex" as std.types.NonEmptyStr,
        observed_version: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
        state_directory: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
        credential_storage_method: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
        service_identity: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
      },
      bundle: bundle,
    ),
    draw: gunbc.provider_standing.LimitDispatchDrawAutomatic,
  )
}

test fn provider_standing_keystone_holds() -> Bool {
  witness_limit_warning_does_not_block_selection()
    && witness_model_limit_rejection_does_not_block_account_selection()
    && witness_claude_native_bucket_exhaustion_blocks_model_draw()
    && witness_model_limit_rejection_does_not_block_unspecified_draw()
    && witness_unspecified_draw_refuses_selection_eligibility()
    && witness_native_bucket_rejection_blocks_automatic_draw()
    && witness_native_bucket_exhaustion_automatic_fail_closed_explicit_bengalfox_admitted()
    && witness_unobserved_standing_is_ineligible()
    && witness_turn_outcome_unobserved_is_ineligible()
    && witness_cursor_capability_gap_is_eligible()
    && witness_codex_unavailable_prefers_claude_over_codex()
    && witness_offer_list_order_does_not_change_automatic_selection()
    && witness_standing_ineligible_codex_selects_claude_before_resolve()
    && witness_profile_present_token_absent_not_selection_eligible()
    && witness_profile_present_token_absent_not_authenticated_standing()
    && witness_profile_present_token_absent_claude_skipped_for_codex()
}
