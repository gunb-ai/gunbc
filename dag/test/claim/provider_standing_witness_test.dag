}

test fn witness_model_limit_rejection_does_not_block_unspecified_draw() -> Bool {
  let limits = [
    gunbc.provider_standing.LimitRejected {
      subject: gunbc.provider_standing.ProviderModelLimit {
        credential: gunbc.provider_standing.LimitCredentialUnspecified,
        model: "fable" as std.types.NonEmptyStr,
      },
      native_token: "fable" as std.types.NonEmptyStr,
      reason: "fable bucket rejected" as std.types.NonEmptyStr,
    },
    gunbc.provider_standing.LimitObservedAvailable {
      subject: gunbc.provider_standing.ProviderAccountLimit { credential: gunbc.provider_standing.LimitCredentialUnspecified },
    },
  ]
  gunbc.provider_standing.limit_observations_are_selection_eligible(
    observations: limits,
    draw: gunbc.provider_standing.LimitDispatchDrawUnspecified,
  )
}

