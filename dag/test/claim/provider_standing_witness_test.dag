test fn witness_codex_unavailable_prefers_claude_over_codex() -> Bool {
  let instance = gunbc.roadmap_dashboard_instance.srv1_live_dashboard_instance()
  let inventory = gunbc.dispatch_selection.fixture_inventory_codex_then_claude(
    instance: instance,
    codex_standing: gunbc.provider_standing.provider_standing_from_fixture_bundle(
      provider: extdeps.llm.cli_lifecycle.ProviderInstance {
        kind: extdeps.llm.cli_lifecycle.CodexCliProvider,
        host: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
        executable: "codex" as std.types.NonEmptyStr,
        observed_version: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
        state_directory: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
        credential_storage_method: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
        service_identity: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
      },
      bundle: gunbc.provider_standing.fixture_standing_bundle_authenticated_unavailable_until_reset(),
    ),
    claude_standing: gunbc.provider_standing.provider_standing_from_fixture_bundle(
      provider: extdeps.llm.cli_lifecycle.ProviderInstance {
        kind: extdeps.llm.cli_lifecycle.ClaudeCliProvider,
        host: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
        executable: "claude" as std.types.NonEmptyStr,
        observed_version: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
        state_directory: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
        credential_storage_method: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
        service_identity: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
      },
      bundle: gunbc.provider_standing.fixture_standing_bundle_authenticated_available(),
    ),
  )
  match gunbc.dispatch_selection.automatic_selection_selected_kind(inventory: inventory) {
    Present { value: kind } => kind == extdeps.llm.cli_lifecycle.ClaudeCliProvider
    Absent => false
  }
}

test fn witness_offer_list_order_does_not_change_automatic_selection() -> Bool {
  let instance = gunbc.roadmap_dashboard_instance.srv1_live_dashboard_instance()
  let codex_standing = gunbc.provider_standing.provider_standing_from_fixture_bundle(
    provider: extdeps.llm.cli_lifecycle.ProviderInstance {
      kind: extdeps.llm.cli_lifecycle.CodexCliProvider,
      host: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
      executable: "codex" as std.types.NonEmptyStr,
      observed_version: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
      state_directory: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
      credential_storage_method: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
      service_identity: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
    },
    bundle: gunbc.provider_standing.fixture_standing_bundle_authenticated_unavailable_until_reset(),
  )
  let claude_standing = gunbc.provider_standing.provider_standing_from_fixture_bundle(
    provider: extdeps.llm.cli_lifecycle.ProviderInstance {
      kind: extdeps.llm.cli_lifecycle.ClaudeCliProvider,
      host: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
      executable: "claude" as std.types.NonEmptyStr,
      observed_version: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
      state_directory: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
      credential_storage_method: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
      service_identity: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
    },
    bundle: gunbc.provider_standing.fixture_standing_bundle_authenticated_available(),
  )
  let codex_first = gunbc.dispatch_selection.fixture_inventory_codex_then_claude(
    instance: instance,
    codex_standing: codex_standing,
    claude_standing: claude_standing,
  )
  let claude_first = gunbc.dispatch_selection.fixture_inventory_claude_then_codex(
    instance: instance,
    codex_standing: codex_standing,
    claude_standing: claude_standing,
  )
  let codex_first_kind = gunbc.dispatch_selection.automatic_selection_selected_kind(inventory: codex_first)
  let claude_first_kind = gunbc.dispatch_selection.automatic_selection_selected_kind(inventory: claude_first)
  match codex_first_kind {
    Present { value: a } =>
      match claude_first_kind {
        Present { value: b } => a == b && a == extdeps.llm.cli_lifecycle.ClaudeCliProvider
        Absent => false
      }
    Absent => false
  }
}

test fn witness_standing_ineligible_codex_selects_claude_before_resolve() -> Bool {
  let instance = gunbc.roadmap_dashboard_instance.srv1_live_dashboard_instance()
  let inventory = gunbc.dispatch_selection.fixture_inventory_codex_then_claude(
    instance: instance,
    codex_standing: gunbc.provider_standing.provider_standing_from_fixture_bundle(
      provider: extdeps.llm.cli_lifecycle.ProviderInstance {
        kind: extdeps.llm.cli_lifecycle.CodexCliProvider,
        host: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
        executable: "codex" as std.types.NonEmptyStr,
        observed_version: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
        state_directory: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
        credential_storage_method: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
        service_identity: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
      },
      bundle: gunbc.provider_standing.fixture_standing_bundle_authenticated_unavailable_until_reset(),
    ),
    claude_standing: gunbc.provider_standing.provider_standing_from_fixture_bundle(
      provider: extdeps.llm.cli_lifecycle.ProviderInstance {
        kind: extdeps.llm.cli_lifecycle.ClaudeCliProvider,
        host: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
        executable: "claude" as std.types.NonEmptyStr,
        observed_version: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
        state_directory: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
        credential_storage_method: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
        service_identity: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
      },
      bundle: gunbc.provider_standing.fixture_standing_bundle_authenticated_available(),
    ),
  )
  match gunbc.dispatch_selection.resolve_dispatch_selection(
    inventory: inventory,
    request: gunbc.dispatch_selection.default_provider_selection_request(),
    node_sizing: gunbc.roadmap_model.Unsized,
  ) {
    gunbc.dispatch_selection.DispatchSelectionResolved { receipt } => receipt.provider_kind == extdeps.llm.cli_lifecycle.ClaudeCliProvider
    gunbc.dispatch_selection.DispatchSelectionRefused { node_sizing: _, requested_selection: _, reason: _ } => false
  }
}

