  let bundle = gunbc.provider_standing.ProviderStandingBundle {
    installation: gunbc.provider_standing.InstallationReady,
    authentication: gunbc.provider_standing.AuthenticationAuthenticated,
    entitlement: gunbc.provider_standing.EntitlementObservedAvailable,
    limits: [
      gunbc.provider_standing.LimitExhausted {
        subject: gunbc.provider_standing.ProviderNativeLimitBucket {
          credential: gunbc.provider_standing.LimitCredentialUnspecified,
          native_key: "seven_day_opus" as std.types.NonEmptyStr,
        },
        native_token: "seven_day_opus" as std.types.NonEmptyStr,
      },
      gunbc.provider_standing.LimitObservedAvailable {
        subject: gunbc.provider_standing.ProviderAccountLimit { credential: gunbc.provider_standing.LimitCredentialUnspecified },
      },
    ],
    turn: gunbc.provider_standing.TurnNotStarted,
    tool_environment: gunbc.provider_standing.ToolEnvironmentReady,
  }
  !gunbc.provider_standing.provider_standing_is_selection_eligible(
    standing: gunbc.provider_standing.provider_standing_from_fixture_bundle(
      provider: extdeps.llm.cli_lifecycle.ProviderInstance {
        kind: extdeps.llm.cli_lifecycle.ClaudeCliProvider,
        host: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
        executable: "claude" as std.types.NonEmptyStr,
        observed_version: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
        state_directory: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
        credential_storage_method: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
        service_identity: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
