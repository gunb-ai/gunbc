module test.claim.perturbation_kernel


data live_tree_disposition: LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn is_consistent(reading: std.perturbation.PerturbationReading, responded: Bool) -> Bool {
  match std.perturbation.perturbation_verdict(reading: reading, output_responded: responded) {
    ResponseConsistent => true
    ResponseViolation => false
  }
}

fn witness_forward_silent_is_consistent() -> Bool {
  is_consistent(reading: std.perturbation.ForwardSameInSameOut, responded: false)
}

fn witness_forward_responded_is_violation() -> Bool {
  std.perturbation.perturbation_is_violation(reading: std.perturbation.ForwardSameInSameOut, output_responded: true)
}

fn witness_backward_responded_is_consistent() -> Bool {
  std.perturbation.perturbation_consistent(reading: std.perturbation.BackwardDiffInDiffOut, output_responded: true)
}

fn witness_backward_silent_is_violation() -> Bool {
  std.perturbation.perturbation_is_violation(reading: std.perturbation.BackwardDiffInDiffOut, output_responded: false)
}

fn witness_readings_are_dual() -> Bool {
  (is_consistent(reading: std.perturbation.ForwardSameInSameOut, responded: false)
    && (is_consistent(reading: std.perturbation.BackwardDiffInDiffOut, responded: false) == false))
  && (is_consistent(reading: std.perturbation.BackwardDiffInDiffOut, responded: true)
    && (is_consistent(reading: std.perturbation.ForwardSameInSameOut, responded: true) == false))
}

test fn perturbation_kernel_witnesses() -> Bool {
  witness_forward_silent_is_consistent()
    && witness_forward_responded_is_violation()
    && witness_backward_responded_is_consistent()
    && witness_backward_silent_is_violation()
    && witness_readings_are_dual()
}
