module test.claim.host_memory_qualification_witness_test

import std.types { Bool, List, NonEmptyStr }
import extdeps.boards.types {
  AsrockRackAltrad8ud1l2t,
  DimmPopulation,
  PopulationSupported,
  PopulationUnsupported,
  admit_population,
}
import extdeps.boards.asrock_rack { asrock_altrad8ud_documented_dimm_populations }
import extdeps.vendor.samsung { samsung }
import extdeps.memory.types {
  DramModuleCatalogRow,
  LoadReduced,
  Registered,
  bit_width,
  dram_generation_ddr4,
}
import extdeps.memory.training { LrdimmDataBufferMrep, module_executes_step }
import std.measure { ByteSize, byte_size }
import extdeps.cpu.ampere { ampere_altra_avl_authority }
import extdeps.ampere.scp_diagnostic {
  AmpereScpConsoleToken,
  ScpECode,
  ScpPCode,
  ReadSnapshot,
  ReadConsumesOldestRecord,
  ampere_smpro_boot_progress_interface,
  ReadAcknowledgesBootProgress,
  scp_token_is_error_class,
}
import gunbc.host_memory_qualification {
  BootReachedOperatingSystem,
  ClassSupportedByBoard,
  HostMemoryStanding,
  HostBootOutcome,
  NotListedInVendorAvl,
  RepeatingFirmwareReset,
  TrainingOperational,
  host_boot_is_established,
  DecodedFromPlatformSyndrome,
  EvidenceUnobserved,
  PartImplicatedByFailingStep,
  PartNotImplicated,
  PartSampleQualificationRequired,
  PlatformTrainingFailure,
  altrad8ud_mrep_failure_observation,
  part_implication,
}
import gunbc.host_diagnostic_channel {
  projection_absence_establishes_source_absence,
  redfish_only_observation_is_complete,
}

// A four-module ALTRAD8UD population must be exactly A1+B1+E1+F1. The
// one-per-channel population that was about to be tested on 2026-08-11 is
// REFUSED, so an unsupported configuration cannot produce a verdict.
test fn four_dimm_population_must_be_a1_b1_e1_f1() -> Bool {
  admit_population(
    candidate: ["A1", "B1", "E1", "F1"],
    documented: asrock_altrad8ud_documented_dimm_populations,
  ) == PopulationSupported
}

test fn one_per_channel_four_dimm_population_is_refused() -> Bool {
  match admit_population(
    candidate: ["A1", "C1", "E1", "G1"],
    documented: asrock_altrad8ud_documented_dimm_populations,
  ) {
    PopulationUnsupported { slots: _ } => true
    PopulationSupported => false
  }
}

test fn single_and_dual_populations_are_supported() -> Bool {
  admit_population(candidate: ["A1"], documented: asrock_altrad8ud_documented_dimm_populations) == PopulationSupported
    && admit_population(candidate: ["A1", "E1"], documented: asrock_altrad8ud_documented_dimm_populations) == PopulationSupported
}

// RED control: a two-module population in the WRONG slots is refused, so the
// check is discriminating on slot identity rather than on module count.
test fn two_dimm_population_in_wrong_slots_is_refused() -> Bool {
  match admit_population(
    candidate: ["A1", "B1"],
    documented: asrock_altrad8ud_documented_dimm_populations,
  ) {
    PopulationUnsupported { slots: _ } => true
    PopulationSupported => false
  }
}

// DDR training success does not construct host boot success. The srv3
// standing carries trained memory AND a repeating reset simultaneously, and
// the boot question still answers false.
// On scp_token_is_error_class:
// E588 (observed followed by reset on srv3/srv4) and E559 (observed on a
// same-family machine that continues booting) are the SAME class. Fatality
// therefore cannot be a function of the class.
data srv3_post_bios_310_standing: gunbc.host_memory_qualification.HostMemoryStanding = gunbc.host_memory_qualification.HostMemoryStanding {
  host: "srv3",
  part_number: "M386A4G40DM0-CPB",
  population: ["A1", "B1", "C1", "D1", "E1", "F1", "G1", "H1"],
  class_support: ClassSupportedByBoard,
  part_qualification: gunbc.host_memory_qualification.NotListedInVendorAvl {
    avl_authority: ampere_altra_avl_authority,
    avl_issue: "1.15 (December 2025)",
  },
  training: gunbc.host_memory_qualification.TrainingOperational { dimm_mask: "0x00005555" },
  boot: gunbc.host_memory_qualification.RepeatingFirmwareReset { token: "E588", cycles: 6 },
  observed_at: 1786580000000,
}

test fn ddr_training_success_does_not_establish_host_boot() -> Bool {
  !host_boot_is_established(standing: srv3_post_bios_310_standing)
}

// Positive control: the ONLY thing that establishes boot is the boot axis.
test fn only_reached_operating_system_establishes_boot() -> Bool {
  host_boot_is_established(
    standing: gunbc.host_memory_qualification.HostMemoryStanding {
      host: "srv3",
      part_number: "M386A4G40DM0-CPB",
      population: ["A1"],
      class_support: ClassSupportedByBoard,
      part_qualification: gunbc.host_memory_qualification.NotListedInVendorAvl {
        avl_authority: ampere_altra_avl_authority,
        avl_issue: "1.15 (December 2025)",
      },
      training: gunbc.host_memory_qualification.TrainingOperational { dimm_mask: "0x00000001" },
      boot: BootReachedOperatingSystem,
      observed_at: 1786580000000,
    },
  )
}

// Generic class support does not construct exact-part qualification: the same
// standing is ClassSupportedByBoard AND NotListedInVendorAvl.
test fn class_support_does_not_establish_part_qualification() -> Bool {
  srv3_post_bios_310_standing.class_support == ClassSupportedByBoard
    && match srv3_post_bios_310_standing.part_qualification {
      NotListedInVendorAvl { avl_authority: _, avl_issue: _ } => true
      _ => false
    }
}

// A P token is not an error and an E token is not a verdict: the classifier
// answers NAMESPACE only, and no token-to-meaning function exists to call.
test fn p_token_is_not_an_error() -> Bool {
  !scp_token_is_error_class(token: extdeps.ampere.scp_diagnostic.AmpereScpConsoleToken { class: ScpPCode, number: 12 })
}

test fn e_token_class_is_namespace_not_fatality() -> Bool {
  scp_token_is_error_class(token: extdeps.ampere.scp_diagnostic.AmpereScpConsoleToken { class: ScpECode, number: 588 })
    && scp_token_is_error_class(token: extdeps.ampere.scp_diagnostic.AmpereScpConsoleToken { class: ScpECode, number: 559 })
}

// A missing projection does not establish a missing source.
test fn projection_absence_does_not_establish_source_absence() -> Bool {
  !projection_absence_establishes_source_absence()
}

test fn redfish_only_observation_is_not_complete() -> Bool {
  !redfish_only_observation_is_complete()
}

// A destructive or acknowledging read cannot be modeled as a pure snapshot.
test fn boot_progress_read_is_not_a_snapshot() -> Bool {
  ampere_smpro_boot_progress_interface.read_effect == ReadAcknowledgesBootProgress
    && ampere_smpro_boot_progress_interface.read_effect != ReadSnapshot
}

// A duplicated slot is refused. This passed under the previous
// equal-length-plus-subset form too, but for an incidental reason — a
// duplicate shrinks the candidate's distinct set, so the subset test failed.
// It is kept because the property is the one callers rely on.
test fn a_duplicated_candidate_slot_is_refused() -> Bool {
  match admit_population(
    candidate: ["A1", "A1", "B1", "E1"],
    documented: asrock_altrad8ud_documented_dimm_populations,
  ) {
    PopulationUnsupported { slots: _ } => true
    PopulationSupported => false
  }
}

// THE CONTROL FOR THE CASE THAT WAS ACTUALLY BROKEN. Under equal-length-plus-
// subset, a DOCUMENTED row carrying a duplicate would admit a candidate that
// merely covers its distinct slots: ["A1","A1"] admitted ["A1","B1"], because
// both documented entries are found and the lengths agree. Multiset equality
// refuses it. Synthetic on purpose — no real board row has a duplicate, which
// is exactly why the defect was latent and why the guard must not depend on
// that staying true.
data duplicated_documented_population: extdeps.boards.types.DimmPopulation = extdeps.boards.types.DimmPopulation {
  board: AsrockRackAltrad8ud1l2t,
  slots: ["A1", "A1"],
  authority: ampere_altra_avl_authority,
}

test fn a_duplicated_documented_row_does_not_admit_a_distinct_pair() -> Bool {
  match admit_population(
    candidate: ["A1", "B1"],
    documented: [duplicated_documented_population],
  ) {
    PopulationUnsupported { slots: _ } => true
    PopulationSupported => false
  }
}

// Positive control on the same synthetic row: the multiset it really names is
// still admitted, so the refusal above is multiset discrimination rather than
// a blanket rejection of duplicated rows.
test fn a_duplicated_documented_row_still_admits_its_own_multiset() -> Bool {
  admit_population(
    candidate: ["A1", "A1"],
    documented: [duplicated_documented_population],
  ) == PopulationSupported
}


// --- RELOCATED 2026-08-19: the training-implication claims -----------------------------------------
//
// These five claims came from test.claim.memory_part_selection_witness when
// gunbc.memory_part_selection was deleted at the root. They test the evidence
// grading, which moved INTACT to gunbc.host_memory_qualification, so they are
// re-enrolled here rather than retired.
//
// RETIRED WITH THIS RECEIPT, and not re-enrolled anywhere, because they tested
// behaviour the replacement pipeline deliberately does not have:
//   cross_currency_candidate_is_refused_not_ranked and
//   same_candidate_in_declared_currency_is_admissible tested PartCandidate's
//   local currency admission. The pipeline still refuses a cross-currency
//   comparison, in the two places that now compare: build_fulfillment's
//   incremental_cash_now (w_cross_currency_purchase_refuses_rather_than_summing)
//   and build_selection's cash axis (a candidate priced in an undeclared
//   currency declares a missing input). The CLAIM survives; the carrier it was
//   written against does not.
//   an_association_leaves_both_candidates_on_the_frontier and
//   a_decoded_refusal_does_drop_the_candidate_from_the_frontier tested the
//   deleted local pareto_frontier over PartCandidate rows with authored stick
//   counts and prices. Their content — an association must not remove a part
//   from the market, a decoded syndrome must — is re-enrolled against the
//   replacement in test.claim.build_fulfillment_witness, where a sample-required
//   verdict resolves to pending evidence and a decoded refusal stops the line.

data stick_32g: ByteSize = byte_size(count: 34359738368)

// The family observed failing MREP on this board: load-reduced, so it must
// execute the data-buffer step.
data lrdimm_32g: DramModuleCatalogRow = DramModuleCatalogRow {
  part_number: "M386A4G40DM0-CPB",
  manufacturer: samsung,
  generation: dram_generation_ddr4,
  capacity_bytes: stick_32g,
  data_rate_mts: 2133,
  ecc: true,
  buffering: LoadReduced,
  chip_width: bit_width(count: 4),
  rank_count: 4,
}

// Same capacity, same vendor, same generation — registered rather than load
// reduced. The ONLY axis that differs is the one the rule reads.
data rdimm_32g: DramModuleCatalogRow = DramModuleCatalogRow {
  part_number: "M393A4K40DB2-CTD",
  manufacturer: samsung,
  generation: dram_generation_ddr4,
  capacity_bytes: stick_32g,
  data_rate_mts: 2666,
  ecc: true,
  buffering: Registered,
  chip_width: bit_width(count: 4),
  rank_count: 2,
}

data observed_failures: List<PlatformTrainingFailure> = [altrad8ud_mrep_failure_observation]

// The same failure at DECODED standing. Only the evidence differs, which is
// what makes the severity comparison below discriminating.
data decoded_failure: PlatformTrainingFailure = PlatformTrainingFailure {
  board: AsrockRackAltrad8ud1l2t,
  step: LrdimmDataBufferMrep,
  standing: DecodedFromPlatformSyndrome { register: "B5" },
  observed_population: ["A1"],
  observed_at: 1786590000000,
}

// The same failure with NO evidence behind it.
data unobserved_failure: PlatformTrainingFailure = PlatformTrainingFailure {
  board: AsrockRackAltrad8ud1l2t,
  step: LrdimmDataBufferMrep,
  standing: EvidenceUnobserved,
  observed_population: ["A1"],
  observed_at: 1786590000000,
}


// WHAT AN ASSOCIATION LICENSES. gunbc holds MREP at
// AssociatedByIdenticalSignature, so another load-reduced module is a
// buy-one-and-test candidate — NOT a refusal. An earlier revision answered
// PartImplicatedByFailingStep here, which is how a single association
// removed most of the 64GB DDR4 market by construction.
test fn an_association_requires_a_sample_rather_than_refusing() -> Bool {
  match part_implication(
    candidate: lrdimm_32g,
    failures: observed_failures,
    target_board: AsrockRackAltrad8ud1l2t,
  ) {
    PartSampleQualificationRequired { step: _, standing: _ } => true
    PartImplicatedByFailingStep { step: _, standing: _ } => false
    PartNotImplicated => false
  }
}

// The severity is a function of EVIDENCE, not of the step. Same board, same
// step, same module — decoded from this platform's own syndrome register, so
// the refusal is earned.
test fn a_decoded_syndrome_does_refuse() -> Bool {
  match part_implication(
    candidate: lrdimm_32g,
    failures: [decoded_failure],
    target_board: AsrockRackAltrad8ud1l2t,
  ) {
    PartImplicatedByFailingStep { step: _, standing: _ } => true
    _ => false
  }
}

// FAIL-OPEN CONTROL IN THE OTHER DIRECTION: an unevidenced row must not
// implicate anything at all. Refusing on EvidenceUnobserved would let a row
// nobody measured remove parts from the market.
test fn an_unobserved_standing_implicates_nothing() -> Bool {
  match part_implication(
    candidate: lrdimm_32g,
    failures: [unobserved_failure],
    target_board: AsrockRackAltrad8ud1l2t,
  ) {
    PartNotImplicated => true
    _ => false
  }
}

// RED control on the structural axis: an otherwise identical registered module
// has no data buffer, cannot execute MREP, and is untouched at ANY standing.
test fn registered_module_is_untouched_even_by_a_decoded_failure() -> Bool {
  match part_implication(
    candidate: rdimm_32g,
    failures: [decoded_failure],
    target_board: AsrockRackAltrad8ud1l2t,
  ) {
    PartNotImplicated => true
    _ => false
  }
}

test fn only_the_load_reduced_module_executes_mrep() -> Bool {
  module_executes_step(module: lrdimm_32g, step: LrdimmDataBufferMrep)
    && !module_executes_step(module: rdimm_32g, step: LrdimmDataBufferMrep)
}
