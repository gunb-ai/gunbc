module test.claim.host_memory_qualification_witness_test

import std.types { Bool, List, NonEmptyStr }
import extdeps.boards.types {
  AsrockRackAltrad8ud1l2t,
  DimmPopulation,
  PopulationSupported,
  PopulationUnsupported,
  admit_population,
}
import extdeps.boards.asrock_rack { asrock_altrad8ud_documented_dimm_populations }
import extdeps.cpu.ampere { ampere_altra_avl_authority }
import extdeps.ampere.scp_diagnostic {
  AmpereScpConsoleToken,
  ScpECode,
  ScpPCode,
  ReadSnapshot,
  ReadConsumesOldestRecord,
  ampere_smpro_boot_progress_interface,
  ReadAcknowledgesBootProgress,
  scp_token_is_error_class,
}
import gunbc.host_memory_qualification {
  BootReachedOperatingSystem,
  ClassSupportedByBoard,
  HostMemoryStanding,
  HostBootOutcome,
  NotListedInVendorAvl,
  RepeatingFirmwareReset,
  TrainingOperational,
  host_boot_is_established,
}
import gunbc.host_diagnostic_channel {
  projection_absence_establishes_source_absence,
  redfish_only_observation_is_complete,
}

// A four-module ALTRAD8UD population must be exactly A1+B1+E1+F1. The
// one-per-channel population that was about to be tested on 2026-08-11 is
// REFUSED, so an unsupported configuration cannot produce a verdict.
test fn four_dimm_population_must_be_a1_b1_e1_f1() -> Bool {
  admit_population(
    candidate: ["A1", "B1", "E1", "F1"],
    documented: asrock_altrad8ud_documented_dimm_populations,
  ) == PopulationSupported
}

test fn one_per_channel_four_dimm_population_is_refused() -> Bool {
  match admit_population(
    candidate: ["A1", "C1", "E1", "G1"],
    documented: asrock_altrad8ud_documented_dimm_populations,
  ) {
    PopulationUnsupported { slots: _ } => true
    PopulationSupported => false
  }
}

test fn single_and_dual_populations_are_supported() -> Bool {
  admit_population(candidate: ["A1"], documented: asrock_altrad8ud_documented_dimm_populations) == PopulationSupported
    && admit_population(candidate: ["A1", "E1"], documented: asrock_altrad8ud_documented_dimm_populations) == PopulationSupported
}

// RED control: a two-module population in the WRONG slots is refused, so the
// check is discriminating on slot identity rather than on module count.
test fn two_dimm_population_in_wrong_slots_is_refused() -> Bool {
  match admit_population(
    candidate: ["A1", "B1"],
    documented: asrock_altrad8ud_documented_dimm_populations,
  ) {
    PopulationUnsupported { slots: _ } => true
    PopulationSupported => false
  }
}

// DDR training success does not construct host boot success. The srv3
// standing carries trained memory AND a repeating reset simultaneously, and
// the boot question still answers false.
// On scp_token_is_error_class:
// E588 (observed followed by reset on srv3/srv4) and E559 (observed on a
// same-family machine that continues booting) are the SAME class. Fatality
// therefore cannot be a function of the class.
data srv3_post_bios_310_standing: HostMemoryStanding = HostMemoryStanding {
  host: "srv3",
  part_number: "M386A4G40DM0-CPB",
  population: ["A1", "B1", "C1", "D1", "E1", "F1", "G1", "H1"],
  class_support: ClassSupportedByBoard,
  part_qualification: NotListedInVendorAvl {
    avl_authority: ampere_altra_avl_authority,
    avl_issue: "1.15 (December 2025)",
  },
  training: TrainingOperational { dimm_mask: "0x00005555" },
  boot: RepeatingFirmwareReset { token: "E588", cycles: 6 },
  observed_at: 1786580000000,
}

test fn ddr_training_success_does_not_establish_host_boot() -> Bool {
  !host_boot_is_established(standing: srv3_post_bios_310_standing)
}

// Positive control: the ONLY thing that establishes boot is the boot axis.
test fn only_reached_operating_system_establishes_boot() -> Bool {
  host_boot_is_established(
    standing: HostMemoryStanding {
      host: "srv3",
      part_number: "M386A4G40DM0-CPB",
      population: ["A1"],
      class_support: ClassSupportedByBoard,
      part_qualification: NotListedInVendorAvl {
        avl_authority: ampere_altra_avl_authority,
        avl_issue: "1.15 (December 2025)",
      },
      training: TrainingOperational { dimm_mask: "0x00000001" },
      boot: BootReachedOperatingSystem,
      observed_at: 1786580000000,
    },
  )
}

// Generic class support does not construct exact-part qualification: the same
// standing is ClassSupportedByBoard AND NotListedInVendorAvl.
test fn class_support_does_not_establish_part_qualification() -> Bool {
  srv3_post_bios_310_standing.class_support == ClassSupportedByBoard
    && match srv3_post_bios_310_standing.part_qualification {
      NotListedInVendorAvl { avl_authority: _, avl_issue: _ } => true
      _ => false
    }
}

// A P token is not an error and an E token is not a verdict: the classifier
// answers NAMESPACE only, and no token-to-meaning function exists to call.
test fn p_token_is_not_an_error() -> Bool {
  !scp_token_is_error_class(token: AmpereScpConsoleToken { class: ScpPCode, number: 12 })
}

test fn e_token_class_is_namespace_not_fatality() -> Bool {
  scp_token_is_error_class(token: AmpereScpConsoleToken { class: ScpECode, number: 588 })
    && scp_token_is_error_class(token: AmpereScpConsoleToken { class: ScpECode, number: 559 })
}

// A missing projection does not establish a missing source.
test fn projection_absence_does_not_establish_source_absence() -> Bool {
  !projection_absence_establishes_source_absence()
}

test fn redfish_only_observation_is_not_complete() -> Bool {
  !redfish_only_observation_is_complete()
}

// A destructive or acknowledging read cannot be modeled as a pure snapshot.
test fn boot_progress_read_is_not_a_snapshot() -> Bool {
  ampere_smpro_boot_progress_interface.read_effect == ReadAcknowledgesBootProgress
    && ampere_smpro_boot_progress_interface.read_effect != ReadSnapshot
}
