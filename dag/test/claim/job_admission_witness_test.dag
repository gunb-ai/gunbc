module test.claim.job_admission_witness

import std.types { Bool, NonEmptyStr }
import std.roster_frontier { FrontierRow }
import gunbc.census_closure_frontier { census_closure_frontier_rows }
import std.measure { MoneyAmountMicro, money_amount_micro, money_amount_micro_count }
import v2.std.optional { Present, Absent }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import product.fabric.identity { FabricIdentity, WorkKey, fabric_identity_eq }
import product.fabric.job_admission {
  classification_receipt_issuer_frontier, job_admission_billing_frontier, job_admission_runner_frontier,
  JobAdmission, JobClassification, JobClassificationReceipt, JobAdmitted, JobHeld, JobRefused,
  DeclaredNonEphi, DeclaredEphi, ClassificationUnresolved,
  EphiHandlingAuthorityHasNoProducer, ClassificationReceiptMissing,
  ClassificationReceiptSubjectMismatch, classify_job, admit_job,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data subject: FabricIdentity<NonEmptyStr, WorkKey> = FabricIdentity {
  principal: "pilot-customer",
  key: "job-a" as WorkKey,
}

fn receipt() -> JobClassificationReceipt<NonEmptyStr>? {
  match classify_job(subject: subject, classification: DeclaredNonEphi) {
    JobAdmitted { receipt: r } => Present { value: r }
    _ => Absent
  }
}

// A receipt is present in both classification controls, so neither can pass
// collaterally through ClassificationReceiptMissing.
test fn declared_ephi_refuses_for_absent_handling_authority() -> Bool {
  match admit_job(subject: subject, classification: DeclaredEphi, receipt: receipt()) {
    JobRefused { subject: s, reason: EphiHandlingAuthorityHasNoProducer } => fabric_identity_eq(left: s, right: subject)
    _ => false
  }
}

test fn unresolved_classification_holds_with_a_receipt() -> Bool {
  match admit_job(subject: subject, classification: ClassificationUnresolved, receipt: receipt()) {
    JobHeld { subject: s } => fabric_identity_eq(left: s, right: subject)
    _ => false
  }
}

test fn ordinary_job_without_receipt_refuses_for_missing_receipt() -> Bool {
  match admit_job(subject: subject, classification: DeclaredNonEphi, receipt: Absent) {
    JobRefused { subject: s, reason: ClassificationReceiptMissing } => fabric_identity_eq(left: s, right: subject)
    _ => false
  }
}

test fn ordinary_job_with_its_receipt_is_admitted() -> Bool {
  match admit_job(subject: subject, classification: DeclaredNonEphi, receipt: receipt()) {
    JobAdmitted { receipt: r } => fabric_identity_eq(left: r.subject, right: subject)
    _ => false
  }
}

test fn unresolved_without_receipt_still_holds() -> Bool {
  match admit_job(subject: subject, classification: ClassificationUnresolved, receipt: Absent) {
    JobHeld { subject: s } => fabric_identity_eq(left: s, right: subject)
    _ => false
  }
}

test fn receipt_cannot_cross_customer_boundary() -> Bool {
  match admit_job(subject: FabricIdentity { principal: "other-customer", key: subject.key }, classification: DeclaredNonEphi, receipt: receipt()) {
    JobRefused { subject: _, reason: ClassificationReceiptSubjectMismatch } => true
    _ => false
  }
}

// Controlled USD fixture, not the billing model. billing-receipts replaces
// this integration boundary with its metered gross/credit/net invoice carrier.
// The fixture exercises no credit and a credit exactly equal to gross. Excess
// credit has no constructor here; the real invoice policy belongs to billing.
type FixturePromotionalCredit
  = NoFixtureCredit
  | FullFixtureCredit

type InvoiceFixture {
  gross_charge: MoneyAmountMicro
  promotional_credit: FixturePromotionalCredit
}

fn applied_credit(invoice: InvoiceFixture) -> MoneyAmountMicro {
  match invoice.promotional_credit {
    NoFixtureCredit => money_amount_micro(count: 0)
    FullFixtureCredit => invoice.gross_charge
  }
}

fn net_due(invoice: InvoiceFixture) -> MoneyAmountMicro {
  match invoice.promotional_credit {
    NoFixtureCredit => invoice.gross_charge
    FullFixtureCredit => money_amount_micro(count: 0)
  }
}

type InvoiceAdmissionFixture {
  invoice: InvoiceFixture
  admission: JobAdmission<NonEmptyStr>
}

fn submit_invoice_fixture(invoice: InvoiceFixture, classification: JobClassification, admission_receipt: JobClassificationReceipt<NonEmptyStr>?) -> InvoiceAdmissionFixture {
  InvoiceAdmissionFixture {
    invoice: invoice,
    admission: admit_job(subject: subject, classification: classification, receipt: admission_receipt),
  }
}

// This fourth red is independently discriminating: classification is decided,
// handling is ordinary, and a receipt EXISTS. It belongs to another job. A pilot
// bypass on net == 0 would turn this precise refusal into admission.
test fn zero_dollar_net_invoice_cannot_admit_a_job_with_another_jobs_receipt() -> Bool {
  let invoice = InvoiceFixture { gross_charge: money_amount_micro(count: 12000000), promotional_credit: FullFixtureCredit }
  let other_job = FabricIdentity { principal: subject.principal, key: "job-b" as WorkKey }
  match classify_job(subject: other_job, classification: DeclaredNonEphi) {
    JobAdmitted { receipt: r } => match submit_invoice_fixture(invoice: invoice, classification: DeclaredNonEphi, admission_receipt: Present { value: r }).admission {
      JobRefused { subject: s, reason: ClassificationReceiptSubjectMismatch } =>
        money_amount_micro_count(m: invoice.gross_charge) > 0 && net_due(invoice: invoice) == money_amount_micro(count: 0) && fabric_identity_eq(left: s, right: subject)
      _ => false
    }
    _ => false
  }
}

test fn zero_dollar_invoice_keeps_an_admitted_customer_admitted() -> Bool {
  let invoice = InvoiceFixture { gross_charge: money_amount_micro(count: 12000000), promotional_credit: FullFixtureCredit }
  match submit_invoice_fixture(invoice: invoice, classification: DeclaredNonEphi, admission_receipt: receipt()).admission {
    JobAdmitted { receipt: r } => net_due(invoice: invoice) == money_amount_micro(count: 0) && fabric_identity_eq(left: r.subject, right: subject)
    _ => false
  }
}

test fn zero_dollar_invoice_does_not_resolve_classification() -> Bool {
  match submit_invoice_fixture(invoice: InvoiceFixture { gross_charge: money_amount_micro(count: 12000000), promotional_credit: FullFixtureCredit }, classification: ClassificationUnresolved, admission_receipt: receipt()).admission {
    JobHeld { subject: s } => fabric_identity_eq(left: s, right: subject)
    _ => false
  }
}

test fn paid_invoice_does_not_supply_an_admission_receipt() -> Bool {
  match submit_invoice_fixture(invoice: InvoiceFixture { gross_charge: money_amount_micro(count: 12000000), promotional_credit: NoFixtureCredit }, classification: DeclaredNonEphi, admission_receipt: Absent).admission {
    JobRefused { subject: _, reason: ClassificationReceiptMissing } => true
    _ => false
  }
}

// Changing only the invoice preserves all three dispositions, including the
// missing-receipt and ePHI refusals. This prevents a zero-only pilot exception.
fn credit_preserves_admission(classification: JobClassification, admission_receipt: JobClassificationReceipt<NonEmptyStr>?) -> Bool {
  let paid = submit_invoice_fixture(invoice: InvoiceFixture { gross_charge: money_amount_micro(count: 12000000), promotional_credit: NoFixtureCredit }, classification: classification, admission_receipt: admission_receipt)
  let credited = submit_invoice_fixture(invoice: InvoiceFixture { gross_charge: money_amount_micro(count: 12000000), promotional_credit: FullFixtureCredit }, classification: classification, admission_receipt: admission_receipt)
  applied_credit(invoice: paid.invoice) == money_amount_micro(count: 0) && applied_credit(invoice: credited.invoice) == credited.invoice.gross_charge &&
  net_due(invoice: paid.invoice) == money_amount_micro(count: 12000000) && net_due(invoice: credited.invoice) == money_amount_micro(count: 0) && paid.admission == credited.admission
}

test fn promotional_credit_preserves_every_admission_disposition() -> Bool {
  credit_preserves_admission(classification: DeclaredNonEphi, admission_receipt: receipt()) &&
  credit_preserves_admission(classification: DeclaredEphi, admission_receipt: receipt()) &&
  credit_preserves_admission(classification: ClassificationUnresolved, admission_receipt: receipt()) &&
  credit_preserves_admission(classification: DeclaredNonEphi, admission_receipt: Absent)
}

fn frontier_enrolled_once(row: FrontierRow) -> Bool {
  count(filter(census_closure_frontier_rows(), enrolled => enrolled == row)) == 1
}

test fn admission_frontiers_reach_the_dissolution_census() -> Bool {
  frontier_enrolled_once(row: classification_receipt_issuer_frontier) &&
  frontier_enrolled_once(row: job_admission_billing_frontier) &&
  frontier_enrolled_once(row: job_admission_runner_frontier)
}
