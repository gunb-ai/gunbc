module test.claim.std_checkpointed_workspace

import std.types { String, NonEmptyStr, Int, Bool, List }
import v2.std.optional { Present, Absent }
import std.algebra { Cons, Empty }
import std.measure { byte_size, Nanosecond, nanosecond, nanosecond_count, ObservationInstant, ProcessMonotonic, SharedMonotonic, WallClock, InstantAfter, InstantIncomparable }
import std.content_hash { Sha256Digest, Sha256DigestHex }
import std.durable_compare_and_set { cas_generation_first }
import std.fabric_blob { FabricBlobAddress }
import std.fabric_storage {
  FabricObject, FabricObjectRef, fabric_object_ref_of, fabric_object_ref_eq,
  ExpectHeadAbsent, ExpectHeadAt, FabricHeadAbsent, FabricHeadAt,
  FabricHeadAdvanced, FabricHeadMoved, FabricHeadAdvanceRefused, FabricStoreUnreachable,
}
import std.checkpointed_workspace {
  WorkspaceWriterEpoch, WorkspaceEntry, WorkspaceHeadEntry, WorkspaceRevision, WorkspaceFence,
  workspace_head_entry_object, workspace_advance_plan, workspace_head_name,
  WorkspaceCommitted, WorkspaceCommitStaleEpoch, WorkspaceCommitRaced, WorkspaceCommitObservedUndecoded, WorkspaceCommitFailed, workspace_commit_classify,
  WorkspaceAdvancePlanned, WorkspaceAdvanceStaleEpoch,
  WorkspaceStoredEntry, WorkspaceRestoreRevision, WorkspaceRestoreEmpty, workspace_restore_point,
  WorkspaceAge, WorkspaceCoverage, WorkspaceClean, WorkspaceDirty, oldest_uncommitted_write_age, WorkspaceAgeOf, WorkspaceAgeUndefined,
  workspace_coverage_after_write, workspace_coverage_after_commit,
  WorkspaceDurabilityPolicy, workspace_durability_policy, WorkspacePolicyAdmission, WorkspacePolicyAdmitted, WorkspacePolicyRefused, PolicyTargetNotBeforeDeadline, PolicyDeadlineNotBeforeWindow,
  WorkspaceWritable, WorkspaceCommitDue, WorkspaceStorageOutage, WorkspaceCoverageUndecidable, workspace_write_standing,
  WorkspaceLossWithinWindow, WorkspaceCompoundFailure, WorkspaceLossUnclassifiable, LostDuringDeclaredOutage, CoverageLapsedBeforeOutage, workspace_loss_classify,
}

// Supplied values at the interface this module owns (DESIGN 3 witness rule): the head advance, the
// observed entry and the instants are what the store and the clock return, constructed here. The
// real store path is demo stage 1's restore entry (frontier, see the module's PR).

// The chunk address is a literal of the refined hex type, so a malformed fixture is refused where it
// is written rather than replaced by some other digest.
fn chunk_digest() -> Sha256Digest { Sha256Digest { hex: "89427e487454c1b5b3cafc50013e056c2d496587b9922f4e8600a3b3c7e3be4f" as Sha256DigestHex } }

fn secs(n: Int) -> Nanosecond { nanosecond(count: n * 1000000000) }

fn at(n: Int) -> ObservationInstant { ObservationInstant { domain: ProcessMonotonic { process: "writer" }, basis: WallClock, since_origin: secs(n: n) } }

fn age_is(a: WorkspaceAge, n: Int) -> Bool {
  match a { WorkspaceAgeOf { age: x } => nanosecond_count(n: x) == nanosecond_count(n: secs(n: n))  WorkspaceAgeUndefined { order: _ } => false }
}

fn epoch(n: Int) -> WorkspaceWriterEpoch { WorkspaceWriterEpoch { workspace: "ops", epoch: n } }

fn one_entry() -> List<WorkspaceEntry> {
  [WorkspaceEntry { path: "src/main.rs", chunk: FabricBlobAddress { key: chunk_digest() }, size: byte_size(count: 12) }]
}

fn rev1() -> WorkspaceHeadEntry { WorkspaceRevision { writer: epoch(n: 1), parent: none, entries: one_entry() } }
fn ref_of(e: WorkspaceHeadEntry) -> FabricObjectRef { fabric_object_ref_of(object: workspace_head_entry_object(entry: e)) }
fn fence2() -> WorkspaceHeadEntry { WorkspaceFence { writer: epoch(n: 2), parent: Present { value: ref_of(e: rev1()) } } }

// The witness policy comes through the one constructor; a refusal fails every claim that needs it.
fn witness_policy() -> WorkspacePolicyAdmission {
  workspace_durability_policy(checkpoint_target: secs(n: 10), outage_deadline: secs(n: 45), window: secs(n: 60))
}
fn stored(e: WorkspaceHeadEntry) -> WorkspaceStoredEntry { WorkspaceStoredEntry { ref: ref_of(e: e), entry: e } }

test fn a_revision_links_its_parent_and_a_first_revision_expects_no_head() -> Bool {
  let o = workspace_head_entry_object(entry: fence2())
  let linked = match o.links { Cons { head: p, tail: _ } => fabric_object_ref_eq(a: p, b: ref_of(e: rev1()))  Empty => false }
  let first = match workspace_advance_plan(entry: rev1(), built_on: none) { WorkspaceAdvancePlanned { plan: p } => match p.expected { ExpectHeadAbsent => true  ExpectHeadAt { object: _ } => false }  WorkspaceAdvanceStaleEpoch { writer_epoch: _, current_epoch: _ } => false }
  linked && first && (workspace_head_name(workspace: "ops") as String) == "workspace.ops.committed"
}

test fn a_moved_head_at_a_later_epoch_is_a_stale_writer_not_a_race() -> Bool {
  let moved = FabricHeadMoved { expected: ExpectHeadAt { object: ref_of(e: rev1()) }, observed: FabricHeadAt { object: ref_of(e: fence2()), generation: cas_generation_first() } }
  let stale = match workspace_commit_classify(writer: epoch(n: 1), advance: moved, observed_entry: Present { value: stored(e: fence2()) }) {
    WorkspaceCommitStaleEpoch { writer_epoch: w, current_epoch: c } => w == 1 && c == 2
    _ => false
  }
  let race = match workspace_commit_classify(writer: epoch(n: 2), advance: moved, observed_entry: Present { value: stored(e: fence2()) }) {
    WorkspaceCommitRaced { observed: _ } => true
    _ => false
  }
  let ok = match workspace_commit_classify(writer: epoch(n: 1), advance: FabricHeadAdvanced { object: ref_of(e: rev1()), generation: cas_generation_first() }, observed_entry: none) {
    WorkspaceCommitted { revision: r } => fabric_object_ref_eq(a: r, b: ref_of(e: rev1()))
    _ => false
  }
  let failed = match workspace_commit_classify(writer: epoch(n: 1), advance: FabricHeadAdvanceRefused { fault: FabricStoreUnreachable { detail: "down" } }, observed_entry: none) {
    WorkspaceCommitFailed { fault: _ } => true
    _ => false
  }
  // THE FENCE HOLDS WHEN THE ENTRY CANNOT BE DECODED: no observed entry, or one under a different
  // ref than the head the store reported, is undecoded and never a retryable race.
  let undecoded = match workspace_commit_classify(writer: epoch(n: 1), advance: moved, observed_entry: none) {
    WorkspaceCommitObservedUndecoded { observed: _ } => true
    _ => false
  }
  let mismatched = match workspace_commit_classify(writer: epoch(n: 1), advance: moved, observed_entry: Present { value: stored(e: rev1()) }) {
    WorkspaceCommitObservedUndecoded { observed: _ } => true
    _ => false
  }
  stale && race && ok && failed && undecoded && mismatched
}

// A WRITER MAY NOT BUILD ON A LATER EPOCH'S ENTRY: rebuilding on the fence would make the fence its
// expectation and the advance would succeed, so the plan refuses before any put.
test fn a_stale_writer_cannot_plan_on_top_of_a_fence() -> Bool {
  let next = WorkspaceRevision { writer: epoch(n: 1), parent: Present { value: ref_of(e: fence2()) }, entries: one_entry() }
  let refused = match workspace_advance_plan(entry: next, built_on: Present { value: stored(e: fence2()) }) {
    WorkspaceAdvanceStaleEpoch { writer_epoch: w, current_epoch: c } => w == 1 && c == 2
    WorkspaceAdvancePlanned { plan: _ } => false
  }
  let current = WorkspaceRevision { writer: epoch(n: 2), parent: Present { value: ref_of(e: fence2()) }, entries: one_entry() }
  let admitted = match workspace_advance_plan(entry: current, built_on: Present { value: stored(e: fence2()) }) {
    WorkspaceAdvancePlanned { plan: p } => match p.expected { ExpectHeadAt { object: o } => fabric_object_ref_eq(a: o, b: ref_of(e: fence2()))  ExpectHeadAbsent => false }
    WorkspaceAdvanceStaleEpoch { writer_epoch: _, current_epoch: _ } => false
  }
  refused && admitted
}

test fn restore_skips_fences_to_the_last_committed_revision() -> Bool {
  let through_fence = match workspace_restore_point(newest_first: [stored(e: fence2()), stored(e: rev1())]) {
    WorkspaceRestoreRevision { revision: r, entries: es } => fabric_object_ref_eq(a: r, b: ref_of(e: rev1())) && length(es) == 1
    WorkspaceRestoreEmpty => false
  }
  let only_fence = match workspace_restore_point(newest_first: [stored(e: fence2())]) {
    WorkspaceRestoreEmpty => true
    WorkspaceRestoreRevision { revision: _, entries: _ } => false
  }
  through_fence && only_fence
}

test fn the_age_is_zero_while_clean_and_starts_at_the_first_pending_write() -> Bool {
  let dirty = workspace_coverage_after_write(coverage: workspace_coverage_after_write(coverage: WorkspaceClean, at: at(n: 100)), at: at(n: 105))
  age_is(a: oldest_uncommitted_write_age(coverage: WorkspaceClean, now: at(n: 1000)), n: 0)
    && age_is(a: oldest_uncommitted_write_age(coverage: dirty, now: at(n: 110)), n: 10)
    && age_is(a: oldest_uncommitted_write_age(coverage: workspace_coverage_after_commit(first_write_after_snapshot: Present { value: at(n: 108) }), now: at(n: 110)), n: 2)
    && age_is(a: oldest_uncommitted_write_age(coverage: workspace_coverage_after_commit(first_write_after_snapshot: none), now: at(n: 110)), n: 0)
}

// NO AGE ACROSS CLOCKS OR BACKWARDS IN TIME: the standing refuses to decide rather than reading the
// workspace as writable, and a loss with no computable age is unclassifiable, never "within window".
test fn an_age_needs_one_clock_and_forward_time() -> Bool {
  match witness_policy() {
    WorkspacePolicyRefused { refusal: _ } => false
    WorkspacePolicyAdmitted { policy: pol } => {
  let other = ObservationInstant { domain: SharedMonotonic { origin: "fleet" }, basis: WallClock, since_origin: secs(n: 200) }
  let backwards = match oldest_uncommitted_write_age(coverage: WorkspaceDirty { oldest_uncommitted_write_at: at(n: 50) }, now: at(n: 40)) { WorkspaceAgeUndefined { order: InstantAfter } => true  other_arm => false }
  let crossed = match workspace_write_standing(policy: pol, workspace: "ops", coverage: WorkspaceDirty { oldest_uncommitted_write_at: at(n: 0) }, now: other) {
    WorkspaceCoverageUndecidable { order: InstantIncomparable { left: _, right: _ } } => true
    other_arm => false
  }
  let unclassified = match workspace_loss_classify(policy: pol, standing: WorkspaceWritable, coverage: WorkspaceDirty { oldest_uncommitted_write_at: at(n: 50) }, lost_at: at(n: 40)) {
    WorkspaceLossUnclassifiable { order: _ } => true
    other_arm => false
  }
  backwards && crossed && unclassified
    }
  }
}

test fn an_idle_workspace_stays_writable_and_a_stuck_one_declares_an_outage() -> Bool {
  match witness_policy() {
    WorkspacePolicyRefused { refusal: _ } => false
    WorkspacePolicyAdmitted { policy: pol } => {
  let idle = match workspace_write_standing(policy: pol, workspace: "ops", coverage: WorkspaceClean, now: at(n: 100000)) { WorkspaceWritable => true  _ => false }
  let due = match workspace_write_standing(policy: pol, workspace: "ops", coverage: WorkspaceDirty { oldest_uncommitted_write_at: at(n: 0) }, now: at(n: 12)) { WorkspaceCommitDue { age: a } => nanosecond_count(n: a) == nanosecond_count(n: secs(n: 12))  _ => false }
  let fresh = match workspace_write_standing(policy: pol, workspace: "ops", coverage: WorkspaceDirty { oldest_uncommitted_write_at: at(n: 0) }, now: at(n: 5)) { WorkspaceWritable => true  _ => false }
  let outage = match workspace_write_standing(policy: pol, workspace: "ops", coverage: WorkspaceDirty { oldest_uncommitted_write_at: at(n: 0) }, now: at(n: 45)) { WorkspaceStorageOutage { outage: _ } => true  _ => false }
  idle && due && fresh && outage
    }
  }
}

test fn loss_during_an_outage_or_past_the_window_is_the_compound_failure() -> Bool {
  match witness_policy() {
    WorkspacePolicyRefused { refusal: _ } => false
    WorkspacePolicyAdmitted { policy: pol } => {
  let d = WorkspaceDirty { oldest_uncommitted_write_at: at(n: 0) }
  let within = match workspace_loss_classify(policy: pol, standing: workspace_write_standing(policy: pol, workspace: "ops", coverage: d, now: at(n: 20)), coverage: d, lost_at: at(n: 20)) {
    WorkspaceLossWithinWindow { uncovered_age: a } => nanosecond_count(n: a) == nanosecond_count(n: secs(n: 20))
    _ => false
  }
  let during = match workspace_loss_classify(policy: pol, standing: workspace_write_standing(policy: pol, workspace: "ops", coverage: d, now: at(n: 50)), coverage: d, lost_at: at(n: 50)) {
    WorkspaceCompoundFailure { cause: LostDuringDeclaredOutage { outage: _ } } => true
    _ => false
  }
  let lapsed = match workspace_loss_classify(policy: pol, standing: WorkspaceWritable, coverage: d, lost_at: at(n: 70)) {
    WorkspaceCompoundFailure { cause: CoverageLapsedBeforeOutage { oldest_uncommitted_write_age: a, window: _ } } => nanosecond_count(n: a) == nanosecond_count(n: secs(n: 70))
    _ => false
  }
  within && during && lapsed
    }
  }
}

test fn a_policy_must_order_target_deadline_and_window() -> Bool {
  let ok = match workspace_durability_policy(checkpoint_target: secs(n: 10), outage_deadline: secs(n: 45), window: secs(n: 60)) { WorkspacePolicyAdmitted { policy: _ } => true  WorkspacePolicyRefused { refusal: _ } => false }
  let bad_target = match workspace_durability_policy(checkpoint_target: secs(n: 50), outage_deadline: secs(n: 45), window: secs(n: 60)) {
    WorkspacePolicyRefused { refusal: PolicyTargetNotBeforeDeadline { target: _, deadline: _ } } => true
    _ => false
  }
  let bad_window = match workspace_durability_policy(checkpoint_target: secs(n: 10), outage_deadline: secs(n: 60), window: secs(n: 60)) {
    WorkspacePolicyRefused { refusal: PolicyDeadlineNotBeforeWindow { deadline: _, window: _ } } => true
    _ => false
  }
  ok && bad_target && bad_window
}
