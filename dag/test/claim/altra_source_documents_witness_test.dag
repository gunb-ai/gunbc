module test.claim.altra_source_documents_witness

import std.types { Bool, String, NonEmptyStr, List, list_length }
import std.integer { Int }
import extdeps.uri { Uri, Https }
import product.altra_motherboard.source_documents {
  DocumentRead,
  DocumentObservation,
  FetchRefused,
  NeverAttempted,
  ObtainedButTextNotExtractable,
  SourceDocument,
  outstanding_documents,
  outstanding_document_count,
  source_documents,
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn probe(o: DocumentObservation) -> SourceDocument {
  SourceDocument {
    title: "planted probe document",
    publisher: "planted probe publisher",
    locator: Uri { scheme: Https, locator: "example.invalid/probe" },
    wanted_for: "a controlled fixture, so the filter is tested against a document this witness authored rather than against whatever the roster happens to hold today",
    observation: o,
  }
}

fn is_outstanding(o: DocumentObservation) -> Bool {
  match probe(o: o).observation {
    DocumentRead { facts_now_cited_at: _ } => false
    FetchRefused { observed: _ } => true
    ObtainedButTextNotExtractable { observed: _ } => true
    NeverAttempted => true
  }
}

// THE PROPERTY, STATED WITHOUT A COUNT. Asserting that the roster holds eight documents would be
// a measurement of the current tree compared against itself, which DESIGN section 5 rules is not
// an oracle: it would go red the next time somebody found a document, which is the roster working
// rather than breaking. What must hold at any size is that nothing already read is still owed.
test fn w_no_document_that_was_read_is_still_outstanding() -> Bool {
  fold(outstanding_documents(), init: true, f: fn(acc, d) {
    acc && match d.observation {
      DocumentRead { facts_now_cited_at: _ } => false
      FetchRefused { observed: _ } => true
      ObtainedButTextNotExtractable { observed: _ } => true
      NeverAttempted => true
    }
  })
}

// AND THE ROSTER IS NOT EMPTY, so the claim above cannot pass vacuously. A filter over nothing
// satisfies every universal statement made about its output.
test fn w_the_roster_is_nonempty_so_the_claim_above_is_not_vacuous() -> Bool {
  list_length(items: source_documents()) > 0 && outstanding_document_count() > 0
}

// THE DISCRIMINATING CONTROL, on a document this witness authored rather than on the live roster.
// Each of the four states is asserted in the direction that would break if any two collapsed: a
// read document must drop out, and each of the three unread states must survive. An earlier
// revision reduced this coproduct through a Bool helper, and that is exactly the shape that lets
// two states quietly become one.
test fn w_only_a_read_document_leaves_the_queue() -> Bool {
  !is_outstanding(o: DocumentRead { facts_now_cited_at: "extdeps.some.module" })
    && is_outstanding(o: FetchRefused { observed: "HTTP 403" })
    && is_outstanding(o: ObtainedButTextNotExtractable { observed: "no extractable text" })
    && is_outstanding(o: NeverAttempted)
}

// NO TWO ROWS NAME THE SAME DOCUMENT. This replaces a witness that asserted every row carried a
// nonempty title and reason -- which review 51945 correctly called a tautology, because both
// fields are NonEmptyStr and the type already makes the empty case unwritable. A check that
// cannot fail is worse than no check: it occupies the slot where a real one would go and reports
// green forever. What the types do NOT carry is uniqueness, and a duplicated row is the exact
// failure this roster is exposed to -- two sessions adding the same document under slightly
// different titles is how one document acquires two read-states that can disagree.
//
// ON THE PAIRWISE SHAPE: counting how many rows share a title is quadratic because the QUESTION
// is pairwise, which is not the defect review 51939 flagged in the module. That one built a
// linear answer -- a filtered list and its length -- with a copying accumulator. Here the
// comparison itself is the work.
fn rows_with_title(t: NonEmptyStr) -> Int {
  list_length(items: filter(source_documents(), d => (d.title as String) == (t as String)))
}

test fn w_no_two_rows_name_the_same_document() -> Bool {
  fold(source_documents(), init: true, f: fn(acc, d) {
    acc && rows_with_title(t: d.title) == 1
  })
}

// THE DISCRIMINATING CONTROL FOR THE CHECK ABOVE, on a pair this witness authors rather than on
// the live roster: two rows sharing one title must be counted as two, so the uniqueness claim is
// known to be capable of failing.
fn duplicate_pair() -> List<SourceDocument> {
  [probe(o: NeverAttempted), probe(o: FetchRefused { observed: "HTTP 403" })]
}

test fn w_a_duplicated_title_is_counted_twice() -> Bool {
  list_length(items: filter(duplicate_pair(), d => (d.title as String) == "planted probe document")) == 2
    && rows_with_title(t: "planted probe document") == 0
}
