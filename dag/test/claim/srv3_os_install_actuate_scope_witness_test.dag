module test.claim.srv3_os_install_actuate_scope


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn srv3_autoinstall_seed_gap_is_explicitly_fail_closed() -> Bool {
  match srv3_autoinstall_seed_delivery_refusal() {
    Present { value: refusal } =>
      fleet_install_server_specs.length() == 0
        && refusal.install_server_count == 0
        && string_contains(s: refusal.refusal as String, pattern: "fail-closed")
        && string_contains(s: refusal.refusal as String, pattern: "NoCloudNet")
        && srv3_autoinstall_seed_gap_is_fail_closed()
    Absent => false
  }
}

test fn srv3_os_install_actuate_credential_resolution_is_wired_in_scope() -> Bool {
  srv3_os_install_actuate_credential_resolution_is_wired()
    && srv3_os_install_actuate_credential_debt_grounds_bmc_secret_ref()
}

test fn srv3_actuator_prep_binds_seeded_delivery_and_iso_path() -> Bool {
  srv3_actuator_prep_uses_seeded_autoinstall_delivery()
    && srv3_actuator_prep_binds_seeded_iso_path()
}

test fn srv3_os_install_actuate_scope_is_prep_not_install_solved() -> Bool {
  srv3_os_install_actuate_is_actuator_prep_not_install_solved()
}
