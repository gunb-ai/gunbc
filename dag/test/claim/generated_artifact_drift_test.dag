data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data perturb: String = "\n# gunbc-generated-artifact-drift-receipt-perturb"

fn artifact_drifted(a: GeneratedArtifact, committed: String) -> Bool {
  match artifact_generate(a: a) {
    ArtifactGenerationRefused { reason: _ } => true
    ArtifactGenerated { content } => !(committed == content)
  }
}

fn artifact_red_receipt(a: GeneratedArtifact) -> Bool {
  match artifact_generate(a: a) {
    ArtifactGenerationRefused { reason: _ } => false
    ArtifactGenerated { content } =>
      !artifact_drifted(a: a, committed: content)
        && artifact_drifted(a: a, committed: concat(content, perturb))
  }
}

test fn witness_per_artifact_red_receipts() -> Bool {
  count(committed_generated_artifacts()) > 0
    && all(committed_generated_artifacts(), a => artifact_red_receipt(a: a))
}

data fixed_point_witness_long_lane_note: String = "witness_committed_is_fixed_point and witness_committed_fixed_point_red_control rehomed to dag/test/claim/long/generated_artifact_drift_fixed_point_witness_test.dag (operator 5-second rule, 2026-08-03): measured 1005ms warm but flaked at 5004ms in falsifier discovery-corpus under host contention — see generated_artifact_drift_fixed_point_long_note there. The drift gate run_generated_artifact_drift_gate_body still reads the same bytes as one conjunct; the long-lane witness ISOLATES the fixed-point property as a separately-falsifiable claim with its own RED control."

test fn witness_all_known_committed() -> Bool {
  artifact_is_committed(a: CiYamlArtifact)
    && artifact_is_committed(a: FalsifierYamlArtifact)
    && artifact_is_committed(a: GitignoreArtifact)
    && artifact_is_committed(a: GitattributesArtifact)
    && artifact_is_committed(a: RoadmapArtifact)
    && artifact_is_committed(a: DesignArtifact)
    && artifact_is_committed(a: GithooksPrePushArtifact)
    && artifact_is_committed(a: GithooksPreCommitArtifact)
    && artifact_is_committed(a: PlanArtifact { plan: idea_machine_plan })
    && !artifact_is_committed(a: RunnerDeployArtifact)
    && !artifact_is_committed(a: AutoinstallUserDataArtifact { spec: srv3_autoinstall_spec })
    && !artifact_is_committed(a: ProxyDhcpDnsmasqArtifact { spec: srv3_install_server_spec })
    && !path_is_ignored(path: ".github/workflows/ci.yml")
    && !path_is_ignored(path: ".github/workflows/falsifier.yml")
    && !path_is_ignored(path: ".gitignore")
    && !path_is_ignored(path: ".gitattributes")
    && !path_is_ignored(path: "ROADMAP.md")
    && !path_is_ignored(path: "DESIGN.md")
    && !path_is_ignored(path: ".githooks/pre-push")
    && !path_is_ignored(path: ".githooks/pre-commit")
    && !path_is_ignored(path: "dag/gunbc/stage0_crate_layout_generated.dag")
    && !path_is_ignored(path: "dag/gunbc/stage0_crate_partition_generated.dag")
    && !path_is_ignored(path: "dag/gunbc/stage0_emit_plan_generated.dag")
    && !path_is_ignored(path: "src/v1/stage0/src/v1_interpreter_dispatch_generated.rs")
    && !path_is_ignored(path: "src/v1/stage0/src/bootstrap_stage0_crate_layout_generated.rs")
    && !path_is_ignored(path: "docs/plans/idea-machine.md")
    && !path_is_ignored(path: ".github/live-deploy-srv1-apply.sh")
    && !path_is_ignored(path: ".github/live-deploy-srv1-retract.sh")
}

test fn witness_ignored_paths_excluded() -> Bool {
  path_is_ignored(path: "target/release/gunbc")
    && path_is_ignored(path: "foo/.DS_Store")
    && path_is_ignored(path: "src/scratch.swp")
    && path_is_ignored(path: "node_modules/pkg/index.js")
    && path_is_ignored(path: ".github/fleet-runner-deploy.manifest")
    && path_is_ignored(path: "provisioning/srv3/user-data")
    && !path_is_ignored(path: "provisioning/srv3/dnsmasq.conf")
}

