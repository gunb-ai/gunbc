
module test.claim.generated_artifact_drift

data live_tree_disposition: LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data perturb: String = "\n# gunbc-generated-artifact-drift-receipt-perturb"

fn artifact_drifted(a: gunbc.generated_artifact.GeneratedArtifact, committed: String) -> Bool {
  !(committed == artifact_generate(a: a))
}

fn witness_per_artifact_red_receipts() -> Bool {
  count(committed_generated_artifacts()) > 0
    && all(committed_generated_artifacts(), a =>
         !artifact_drifted(a: a, committed: artifact_generate(a: a))
           && artifact_drifted(a: a, committed: concat(artifact_generate(a: a), perturb)))
}

fn witness_all_known_committed() -> Bool {
  artifact_is_committed(a: CiYamlArtifact)
    && artifact_is_committed(a: FalsifierYamlArtifact)
    && artifact_is_committed(a: GitignoreArtifact)
    && artifact_is_committed(a: RoadmapArtifact)
    && artifact_is_committed(a: gunbc.generated_artifact.DesignArtifact)
    && artifact_is_committed(a: GithooksPrePushArtifact)
    && artifact_is_committed(a: GithooksPreCommitArtifact)
    && artifact_is_committed(a: PlanArtifact { plan: gunbc.plans.idea_machine.idea_machine_plan })
    && artifact_is_committed(a: FleetConvergeArtifact)
    && !artifact_is_committed(a: RunnerDeployArtifact)
    && !artifact_is_committed(a: AutoinstallUserDataArtifact { spec: gunbc.os_install.srv3_autoinstall_spec })
    && !artifact_is_committed(a: ProxyDhcpDnsmasqArtifact { spec: gunbc.os_install.srv3_install_server_spec })
    && !gunbc.gitignore_emit.path_is_ignored(path: ".github/workflows/ci.yml")
    && !gunbc.gitignore_emit.path_is_ignored(path: ".github/workflows/falsifier.yml")
    && !gunbc.gitignore_emit.path_is_ignored(path: ".gitignore")
    && !gunbc.gitignore_emit.path_is_ignored(path: "ROADMAP.md")
    && !gunbc.gitignore_emit.path_is_ignored(path: "DESIGN.md")
    && !gunbc.gitignore_emit.path_is_ignored(path: ".githooks/pre-push")
    && !gunbc.gitignore_emit.path_is_ignored(path: ".githooks/pre-commit")
    && !gunbc.gitignore_emit.path_is_ignored(path: ".github/fleet-converge.sh")
    && !gunbc.gitignore_emit.path_is_ignored(path: "dag/gunbc/stage0_crate_layout_generated.dag")
    && !gunbc.gitignore_emit.path_is_ignored(path: "dag/gunbc/stage0_crate_partition_generated.dag")
    && !gunbc.gitignore_emit.path_is_ignored(path: "src/v1/stage0/src/bootstrap_stage0_crate_layout_generated.rs")
    && !gunbc.gitignore_emit.path_is_ignored(path: "docs/plans/idea-machine.md")
    && !gunbc.gitignore_emit.path_is_ignored(path: ".github/live-deploy-srv1-apply.sh")
    && !gunbc.gitignore_emit.path_is_ignored(path: ".github/live-deploy-srv1-retract.sh")
}

fn witness_ignored_paths_excluded() -> Bool {
  gunbc.gitignore_emit.path_is_ignored(path: "target/release/gunbc")
    && gunbc.gitignore_emit.path_is_ignored(path: "foo/.DS_Store")
    && gunbc.gitignore_emit.path_is_ignored(path: "src/scratch.swp")
    && gunbc.gitignore_emit.path_is_ignored(path: "node_modules/pkg/index.js")
    && gunbc.gitignore_emit.path_is_ignored(path: ".github/fleet-runner-deploy.manifest")
    && gunbc.gitignore_emit.path_is_ignored(path: "provisioning/srv3/user-data")
    && !gunbc.gitignore_emit.path_is_ignored(path: "provisioning/srv3/dnsmasq.conf")
}

fn witness_registry_complete() -> Bool {
  count(generated_artifact_registry) == (14 + count(gunbc.os_install.fleet_autoinstall_specs) + count(gunbc.os_install.fleet_install_server_specs) + count(gunbc.plan_registry.all_plans))
    && registry_contains(a: CiYamlArtifact)
    && registry_contains(a: FalsifierYamlArtifact)
    && registry_contains(a: GitignoreArtifact)
    && registry_contains(a: RoadmapArtifact)
    && registry_contains(a: gunbc.generated_artifact.DesignArtifact)
    && registry_contains(a: GithooksPrePushArtifact)
    && registry_contains(a: GithooksPreCommitArtifact)
    && registry_contains(a: RunnerDeployArtifact)
    && registry_contains(a: FleetConvergeArtifact)
    && registry_contains(a: Stage0CrateLayoutGeneratedDagArtifact)
    && registry_contains(a: Stage0CrateLayoutGeneratedRsArtifact)
    && registry_contains(a: Stage0CratePartitionGeneratedDagArtifact)
    && registry_contains(a: LiveDeployApplyScriptArtifact)
    && registry_contains(a: LiveDeployRetractScriptArtifact)
    && registry_contains(a: AutoinstallUserDataArtifact { spec: gunbc.os_install.srv3_autoinstall_spec })
    && registry_contains(a: PlanArtifact { plan: gunbc.plans.idea_machine.idea_machine_plan })
    && gunbc.os_install.fleet_install_server_specs.length() == 0
    && artifact_is_committed(a: CiYamlArtifact)
    && artifact_is_committed(a: FalsifierYamlArtifact)
    && artifact_is_committed(a: GitignoreArtifact)
    && artifact_is_committed(a: RoadmapArtifact)
    && artifact_is_committed(a: gunbc.generated_artifact.DesignArtifact)
    && artifact_is_committed(a: GithooksPrePushArtifact)
    && artifact_is_committed(a: GithooksPreCommitArtifact)
    && artifact_is_committed(a: PlanArtifact { plan: gunbc.plans.idea_machine.idea_machine_plan })
    && artifact_is_committed(a: FleetConvergeArtifact)
    && artifact_is_committed(a: Stage0CrateLayoutGeneratedDagArtifact)
    && artifact_is_committed(a: Stage0CrateLayoutGeneratedRsArtifact)
    && artifact_is_committed(a: Stage0CratePartitionGeneratedDagArtifact)
    && artifact_is_committed(a: LiveDeployApplyScriptArtifact)
    && artifact_is_committed(a: LiveDeployRetractScriptArtifact)
    && !artifact_is_committed(a: RunnerDeployArtifact)
    && !artifact_is_committed(a: AutoinstallUserDataArtifact { spec: gunbc.os_install.srv3_autoinstall_spec })
    && !artifact_is_committed(a: ProxyDhcpDnsmasqArtifact { spec: gunbc.os_install.srv3_install_server_spec })
}

fn consumer_is(a: gunbc.generated_artifact.GeneratedArtifact, expected: RepoConsumer) -> Bool {
  match artifact_commit_policy(a: a) {
    CommitRequired { v2.test.resolve.qualified_module_projection_g1b_fixture.consumer } => match v2.test.resolve.qualified_module_projection_g1b_fixture.consumer {
      GitProtocol => match expected { GitProtocol => true  _ => false }
      GithubActionsWorkflow => match expected { GithubActionsWorkflow => true  _ => false }
      ProjectDocumentation => match expected { ProjectDocumentation => true  _ => false }
      HostReconciler => match expected { HostReconciler => true  _ => false }
    }
    NotCommitted => false
  }
}

fn witness_commit_policy_reasons() -> Bool {
  consumer_is(a: GitignoreArtifact, expected: GitProtocol)
    && consumer_is(a: GithooksPrePushArtifact, expected: GitProtocol)
    && consumer_is(a: GithooksPreCommitArtifact, expected: GitProtocol)
    && consumer_is(a: CiYamlArtifact, expected: GithubActionsWorkflow)
    && consumer_is(a: FalsifierYamlArtifact, expected: GithubActionsWorkflow)
    && consumer_is(a: RoadmapArtifact, expected: ProjectDocumentation)
    && consumer_is(a: gunbc.generated_artifact.DesignArtifact, expected: ProjectDocumentation)
    && consumer_is(a: PlanArtifact { plan: gunbc.plans.idea_machine.idea_machine_plan }, expected: ProjectDocumentation)
    && consumer_is(a: FleetConvergeArtifact, expected: HostReconciler)
    && consumer_is(a: Stage0CrateLayoutGeneratedDagArtifact, expected: GitProtocol)
    && consumer_is(a: Stage0CrateLayoutGeneratedRsArtifact, expected: GitProtocol)
    && consumer_is(a: Stage0CratePartitionGeneratedDagArtifact, expected: GitProtocol)
    && consumer_is(a: LiveDeployApplyScriptArtifact, expected: HostReconciler)
    && consumer_is(a: LiveDeployRetractScriptArtifact, expected: HostReconciler)
    && match artifact_commit_policy(a: RunnerDeployArtifact) { NotCommitted => true  _ => false }
    && match artifact_commit_policy(a: AutoinstallUserDataArtifact { spec: gunbc.os_install.srv3_autoinstall_spec }) { NotCommitted => true  _ => false }
    && match artifact_commit_policy(a: ProxyDhcpDnsmasqArtifact { spec: gunbc.os_install.srv3_install_server_spec }) { NotCommitted => true  _ => false }
}

fn witness_extra_validation_wired() -> Bool {
  artifact_extra_valid(a: GitignoreArtifact)
    && artifact_extra_valid(a: RoadmapArtifact)
    && artifact_extra_valid(a: gunbc.generated_artifact.DesignArtifact)
    && artifact_extra_valid(a: CiYamlArtifact)
    && artifact_extra_valid(a: FalsifierYamlArtifact)
    && artifact_extra_valid(a: Stage0CrateLayoutGeneratedDagArtifact)
    && artifact_extra_valid(a: Stage0CrateLayoutGeneratedRsArtifact)
}

test fn generated_artifact_drift_witnesses() -> Bool {
  witness_per_artifact_red_receipts()
    && witness_all_known_committed()
    && witness_ignored_paths_excluded()
    && witness_registry_complete()
    && witness_commit_policy_reasons()
    && witness_extra_validation_wired()
}
