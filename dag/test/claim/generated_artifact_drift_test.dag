
module test.claim.generated_artifact_drift

import gunbc.generated_artifact {
  GeneratedArtifact, CiYamlArtifact, FalsifierYamlArtifact, GitignoreArtifact, RoadmapArtifact, DesignArtifact, GithooksPrePushArtifact, GithooksPreCommitArtifact, RunnerDeployArtifact, Stage0CrateLayoutGeneratedDagArtifact, Stage0CrateLayoutGeneratedRsArtifact, Stage0CratePartitionGeneratedDagArtifact, LiveDeployApplyScriptArtifact, LiveDeployRetractScriptArtifact, AutoinstallUserDataArtifact, ProxyDhcpDnsmasqArtifact, PlanArtifact,
  RepoConsumer, GitProtocol, GithubActionsWorkflow, ProjectDocumentation, HostReconciler,
  CommitPolicy, CommitRequired, NotCommitted,
  generated_artifact_registry,
  committed_generated_artifacts, artifact_path, artifact_commit_policy, artifact_is_committed, registry_contains
}
import gunbc.generated_artifact_emit { artifact_generate, artifact_extra_valid }
import gunbc.os_install { srv3_autoinstall_spec, fleet_autoinstall_specs, srv3_install_server_spec, fleet_install_server_specs }
import gunbc.gitignore_emit { path_is_ignored }
import gunbc.plan_registry { all_plans }
import gunbc.plans.idea_machine { idea_machine_plan }
import extdeps.filesystem.filesystem_io { Filesystem }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data perturb: String = "\n# gunbc-generated-artifact-drift-receipt-perturb"

fn artifact_drifted(a: GeneratedArtifact, committed: String) -> Bool {
  !(committed == artifact_generate(a: a))
}

fn witness_per_artifact_red_receipts() -> Bool {
  count(committed_generated_artifacts()) > 0
    && all(committed_generated_artifacts(), a =>
         !artifact_drifted(a: a, committed: artifact_generate(a: a))
           && artifact_drifted(a: a, committed: concat(artifact_generate(a: a), perturb)))
}

data fixed_point_witness_note: String = "Fixed-point / byte-idempotence leg (ci-chores P0, 2026-07-22): witness_committed_is_fixed_point reads the REAL committed bytes off disk (Filesystem.Read, ReadsLiveTree) and asserts a fresh artifact_generate reproduces them byte-for-byte for every committed artifact. This is the executable form of `regen yields zero diff` — the property the automated chore commit relies on. It differs from witness_per_artifact_red_receipts (which compares generate-to-generate and so is blind to a committed-vs-generated mismatch such as the missing-trailing-newline defect P0 chased). RED control: witness_committed_fixed_point_red_control perturbs the read bytes and requires the equality to fail, so a false-green fixed point is unwritable. Note (§2): the drift gate run_generated_artifact_drift_gate_body already reads the same bytes as one conjunct; this witness ISOLATES the fixed-point property as a separately-falsifiable claim with its own control, rather than re-deriving the gate's pass/fail. Determinism of artifact_generate ACROSS processes (map-key iteration order) is a distinct property and is enforced by construction by v2.lens.determinism.determinism_compile_gate — not re-checked here."

fn artifact_committed_matches(a: GeneratedArtifact) -> Bool {
  let committed = Filesystem.Read(path: artifact_path(a: a))
  committed.success && (committed.content == artifact_generate(a: a))
}

fn witness_committed_is_fixed_point() -> Bool {
  count(committed_generated_artifacts()) > 0
    && all(committed_generated_artifacts(), a => artifact_committed_matches(a: a))
}

fn witness_committed_fixed_point_red_control() -> Bool {
  let a = CiYamlArtifact
  let committed = Filesystem.Read(path: artifact_path(a: a))
  committed.success
    && !(concat(committed.content, perturb) == artifact_generate(a: a))
}

fn witness_all_known_committed() -> Bool {
  artifact_is_committed(a: CiYamlArtifact)
    && artifact_is_committed(a: FalsifierYamlArtifact)
    && artifact_is_committed(a: GitignoreArtifact)
    && artifact_is_committed(a: RoadmapArtifact)
    && artifact_is_committed(a: DesignArtifact)
    && artifact_is_committed(a: GithooksPrePushArtifact)
    && artifact_is_committed(a: GithooksPreCommitArtifact)
    && artifact_is_committed(a: PlanArtifact { plan: idea_machine_plan })
    && !artifact_is_committed(a: RunnerDeployArtifact)
    && !artifact_is_committed(a: AutoinstallUserDataArtifact { spec: srv3_autoinstall_spec })
    && !artifact_is_committed(a: ProxyDhcpDnsmasqArtifact { spec: srv3_install_server_spec })
    && !path_is_ignored(path: ".github/workflows/ci.yml")
    && !path_is_ignored(path: ".github/workflows/falsifier.yml")
    && !path_is_ignored(path: ".gitignore")
    && !path_is_ignored(path: "ROADMAP.md")
    && !path_is_ignored(path: "DESIGN.md")
    && !path_is_ignored(path: ".githooks/pre-push")
    && !path_is_ignored(path: ".githooks/pre-commit")
    && !path_is_ignored(path: "dag/gunbc/stage0_crate_layout_generated.dag")
    && !path_is_ignored(path: "dag/gunbc/stage0_crate_partition_generated.dag")
    && !path_is_ignored(path: "src/v1/stage0/src/bootstrap_stage0_crate_layout_generated.rs")
    && !path_is_ignored(path: "docs/plans/idea-machine.md")
    && !path_is_ignored(path: ".github/live-deploy-srv1-apply.sh")
    && !path_is_ignored(path: ".github/live-deploy-srv1-retract.sh")
}

fn witness_ignored_paths_excluded() -> Bool {
  path_is_ignored(path: "target/release/gunbc")
    && path_is_ignored(path: "foo/.DS_Store")
    && path_is_ignored(path: "src/scratch.swp")
    && path_is_ignored(path: "node_modules/pkg/index.js")
    && path_is_ignored(path: ".github/fleet-runner-deploy.manifest")
    && path_is_ignored(path: "provisioning/srv3/user-data")
    && !path_is_ignored(path: "provisioning/srv3/dnsmasq.conf")
}

fn witness_registry_complete() -> Bool {
  count(generated_artifact_registry) == (13 + count(fleet_autoinstall_specs) + count(fleet_install_server_specs) + count(all_plans))
    && registry_contains(a: CiYamlArtifact)
    && registry_contains(a: FalsifierYamlArtifact)
    && registry_contains(a: GitignoreArtifact)
    && registry_contains(a: RoadmapArtifact)
    && registry_contains(a: DesignArtifact)
    && registry_contains(a: GithooksPrePushArtifact)
    && registry_contains(a: GithooksPreCommitArtifact)
    && registry_contains(a: RunnerDeployArtifact)
    && registry_contains(a: Stage0CrateLayoutGeneratedDagArtifact)
    && registry_contains(a: Stage0CrateLayoutGeneratedRsArtifact)
    && registry_contains(a: Stage0CratePartitionGeneratedDagArtifact)
    && registry_contains(a: LiveDeployApplyScriptArtifact)
    && registry_contains(a: LiveDeployRetractScriptArtifact)
    && registry_contains(a: AutoinstallUserDataArtifact { spec: srv3_autoinstall_spec })
    && registry_contains(a: PlanArtifact { plan: idea_machine_plan })
    && fleet_install_server_specs.length() == 0
    && artifact_is_committed(a: CiYamlArtifact)
    && artifact_is_committed(a: FalsifierYamlArtifact)
    && artifact_is_committed(a: GitignoreArtifact)
    && artifact_is_committed(a: RoadmapArtifact)
    && artifact_is_committed(a: DesignArtifact)
    && artifact_is_committed(a: GithooksPrePushArtifact)
    && artifact_is_committed(a: GithooksPreCommitArtifact)
    && artifact_is_committed(a: PlanArtifact { plan: idea_machine_plan })
    && artifact_is_committed(a: Stage0CrateLayoutGeneratedDagArtifact)
    && artifact_is_committed(a: Stage0CrateLayoutGeneratedRsArtifact)
    && artifact_is_committed(a: Stage0CratePartitionGeneratedDagArtifact)
    && artifact_is_committed(a: LiveDeployApplyScriptArtifact)
    && artifact_is_committed(a: LiveDeployRetractScriptArtifact)
    && !artifact_is_committed(a: RunnerDeployArtifact)
    && !artifact_is_committed(a: AutoinstallUserDataArtifact { spec: srv3_autoinstall_spec })
    && !artifact_is_committed(a: ProxyDhcpDnsmasqArtifact { spec: srv3_install_server_spec })
}

fn consumer_is(a: GeneratedArtifact, expected: RepoConsumer) -> Bool {
  match artifact_commit_policy(a: a) {
    CommitRequired { consumer } => match consumer {
      GitProtocol => match expected { GitProtocol => true  _ => false }
      GithubActionsWorkflow => match expected { GithubActionsWorkflow => true  _ => false }
      ProjectDocumentation => match expected { ProjectDocumentation => true  _ => false }
      HostReconciler => match expected { HostReconciler => true  _ => false }
    }
    NotCommitted => false
  }
}

fn witness_commit_policy_reasons() -> Bool {
  consumer_is(a: GitignoreArtifact, expected: GitProtocol)
    && consumer_is(a: GithooksPrePushArtifact, expected: GitProtocol)
    && consumer_is(a: GithooksPreCommitArtifact, expected: GitProtocol)
    && consumer_is(a: CiYamlArtifact, expected: GithubActionsWorkflow)
    && consumer_is(a: FalsifierYamlArtifact, expected: GithubActionsWorkflow)
    && consumer_is(a: RoadmapArtifact, expected: ProjectDocumentation)
    && consumer_is(a: DesignArtifact, expected: ProjectDocumentation)
    && consumer_is(a: PlanArtifact { plan: idea_machine_plan }, expected: ProjectDocumentation)
    && consumer_is(a: Stage0CrateLayoutGeneratedDagArtifact, expected: GitProtocol)
    && consumer_is(a: Stage0CrateLayoutGeneratedRsArtifact, expected: GitProtocol)
    && consumer_is(a: Stage0CratePartitionGeneratedDagArtifact, expected: GitProtocol)
    && consumer_is(a: LiveDeployApplyScriptArtifact, expected: HostReconciler)
    && consumer_is(a: LiveDeployRetractScriptArtifact, expected: HostReconciler)
    && match artifact_commit_policy(a: RunnerDeployArtifact) { NotCommitted => true  _ => false }
    && match artifact_commit_policy(a: AutoinstallUserDataArtifact { spec: srv3_autoinstall_spec }) { NotCommitted => true  _ => false }
    && match artifact_commit_policy(a: ProxyDhcpDnsmasqArtifact { spec: srv3_install_server_spec }) { NotCommitted => true  _ => false }
}

fn witness_extra_validation_wired() -> Bool {
  artifact_extra_valid(a: GitignoreArtifact)
    && artifact_extra_valid(a: RoadmapArtifact)
    && artifact_extra_valid(a: DesignArtifact)
    && artifact_extra_valid(a: CiYamlArtifact)
    && artifact_extra_valid(a: FalsifierYamlArtifact)
    && artifact_extra_valid(a: Stage0CrateLayoutGeneratedDagArtifact)
    && artifact_extra_valid(a: Stage0CrateLayoutGeneratedRsArtifact)
}

test fn generated_artifact_drift_witnesses() -> Bool {
  witness_per_artifact_red_receipts()
    && witness_committed_is_fixed_point()
    && witness_committed_fixed_point_red_control()
    && witness_all_known_committed()
    && witness_ignored_paths_excluded()
    && witness_registry_complete()
    && witness_commit_policy_reasons()
    && witness_extra_validation_wired()
}
