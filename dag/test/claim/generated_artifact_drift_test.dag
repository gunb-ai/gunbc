
module test.claim.generated_artifact_drift


data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data pure_perturb_control_note: String = "P0 (operator-directed, 2026-08-05): the former per-artifact live perturb loop called artifact_generate three times per committed artifact just to prove generated != generated + suffix — a GENERIC string-inequality fact, re-proved once per generator, that never touched a real committed byte (DESIGN section 6: do not test that the processor does math well). Deleted. The pure leaf (assess_generated_artifact_observation) and pure group (assess_generated_artifact_population) policies in gunbc.generated_artifact_assessment are exercised below with tiny CONSTRUCTED receipts — no producer call, no Filesystem, no artifact_generate — covering clean, drift, generation-refusal, committed-read-refusal, extra-validation-refusal and group-identity (missing/duplicate/unknown) verdicts. gunbc.generated_artifact_assessment imports gunbc.generated_artifact ONLY — it cannot import Filesystem or the generator, so purity here is by construction, not by convention (loyal-ram-550 review of #7823). The one remaining LIVE fact — every registered committed artifact observed exactly once, byte-clean, against real disk state — is the production drift gate itself (dag/tools/generated_artifact_gate.dag, run_generated_artifact_drift_gate_body), which now calls the live producer exactly once per artifact per run; its byte-for-byte fixed point is additionally isolated at dag/test/claim/long/generated_artifact_drift_fixed_point_witness_test.dag."

data perturb: String = "\n# gunbc-generated-artifact-drift-receipt-perturb"

fn constructed_clean(a: GeneratedArtifact, content: String) -> GeneratedArtifactObservation {
  GeneratedArtifactObserved { artifact: a, path: "fixture/path", generated_content: content, committed_content: content, extra_validation: true }
}

test fn witness_pure_leaf_clean_when_bytes_match_and_extra_valid_holds() -> Bool {
  assess_generated_artifact_observation(o: constructed_clean(CiYamlArtifact, "same bytes"))
}

test fn witness_pure_leaf_drifts_on_perturbed_committed_bytes() -> Bool {
  !assess_generated_artifact_observation(o: GeneratedArtifactObserved {
    artifact: CiYamlArtifact, path: "fixture/path", generated_content: "same bytes", committed_content: concat("same bytes", perturb), extra_validation: true
  })
}

test fn witness_pure_leaf_refuses_on_generation_refusal() -> Bool {
  !assess_generated_artifact_observation(o: GeneratedArtifactObservationRefused {
    artifact: CiYamlArtifact, path: "fixture/path", cause: "generation refused: boom"
  })
}

test fn witness_pure_leaf_refuses_on_committed_read_refusal() -> Bool {
  !assess_generated_artifact_observation(o: GeneratedArtifactObservationRefused {
    artifact: CiYamlArtifact, path: "fixture/path", cause: "committed read failed: no such file"
  })
}

test fn witness_pure_leaf_refuses_on_extra_validation_failure() -> Bool {
  !assess_generated_artifact_observation(o: GeneratedArtifactObserved {
    artifact: CiYamlArtifact, path: "fixture/path", generated_content: "same bytes", committed_content: "same bytes", extra_validation: false
  })
}

test fn witness_pure_group_passes_when_every_expected_identity_observed_once_and_clean() -> Bool {
  assess_generated_artifact_population(
    expected: [CiYamlArtifact, GitignoreArtifact],
    observations: [constructed_clean(CiYamlArtifact, "a"), constructed_clean(GitignoreArtifact, "b")]
  )
}

test fn witness_pure_group_refuses_on_missing_identity() -> Bool {
  !assess_generated_artifact_population(
    expected: [CiYamlArtifact, GitignoreArtifact],
    observations: [constructed_clean(CiYamlArtifact, "a")]
  )
}

test fn witness_pure_group_refuses_on_duplicate_identity() -> Bool {
  !assess_generated_artifact_population(
    expected: [CiYamlArtifact],
    observations: [constructed_clean(CiYamlArtifact, "a"), constructed_clean(CiYamlArtifact, "a")]
  )
}

test fn witness_pure_group_refuses_on_unknown_identity() -> Bool {
  !assess_generated_artifact_population(
    expected: [CiYamlArtifact],
    observations: [constructed_clean(CiYamlArtifact, "a"), constructed_clean(GitignoreArtifact, "b")]
  )
}

test fn witness_pure_group_refuses_when_a_retained_leaf_is_dirty() -> Bool {
  !assess_generated_artifact_population(
    expected: [CiYamlArtifact],
    observations: [GeneratedArtifactObserved { artifact: CiYamlArtifact, path: "fixture/path", generated_content: "a", committed_content: "b", extra_validation: true }]
  )
}

test fn witness_first_failing_observation_path_names_the_dirty_leaf() -> Bool {
  first_failing_observation_path(observations: [
    constructed_clean(GitignoreArtifact, "a"),
    GeneratedArtifactObserved { artifact: CiYamlArtifact, path: "dirty/path", generated_content: "a", committed_content: "b", extra_validation: true }
  ]) == "dirty/path"
}

test fn witness_first_failing_observation_path_empty_when_all_leaves_clean() -> Bool {
  first_failing_observation_path(observations: [constructed_clean(CiYamlArtifact, "a")]) == ""
}

test fn witness_first_failing_diagnostic_path_falls_back_to_missing_identity() -> Bool {
  first_failing_diagnostic_path(expected: [CiYamlArtifact], observations: []) == artifact_path(a: CiYamlArtifact)
}

test fn witness_committed_registry_nonempty() -> Bool {
  count(committed_generated_artifacts()) > 0
}

data fixed_point_witness_long_lane_note: String = "witness_committed_is_fixed_point and witness_committed_fixed_point_red_control rehomed to dag/test/claim/long/generated_artifact_drift_fixed_point_witness_test.dag (operator 5-second rule, 2026-08-03). This note is the ONE home for why; the sibling note there and the falsifier_substrate_long_lane_rows reason field in gunbc.ci_layer_roots carry the enrollment fact and point here, so the cause cannot drift across three copies (DESIGN 3). THE REHOME IS CORRECT AND DOES NOT REST ON A MEASUREMENT: the witness reads the live tree — Filesystem.Read at artifact_path for every row of committed_generated_artifacts(), then artifact_generate regenerating each — so its cost scales with the number and size of the generated artifacts and with the carrier rows their generators fold, quantities that grow with the repository and that this witness's own source does not determine. A flat per-witness ceiling is the wrong SHAPE of bound for that, whatever number it is set to. (Stated precisely because a looser version of it was wrong: committed_generated_artifacts() filters the static generated_artifact_registry, so the enumeration is not a tree walk and is fully visible to the compiled closure. The live-tree dependence is in the bytes read and compared, not in the row count.) MEASURED, and this one IS a like-for-like comparison in a way the 1005-versus-5004 pair never was: on a local claim_batch run at head 01564d73 the witness returned 7944ms while witness_committed_fixed_point_red_control — same file, same receipt path, same clock, same process, but reading and regenerating ONE artifact instead of all of them — returned 91ms, with the run's expectation frontier reporting 70 Filesystem.Read dispatches. Both figures come from the same producer, so the ratio carries information even though neither figure is CPU, and it makes the scaling claim above a measurement rather than an argument (loosely, not a constant per artifact: generating DESIGN.md is not the same work as generating a githook script). It says nothing about the cap, and deliberately so: 7944ms is ABOVE 5000, and by residual finding one a wall figure OVER the cap proves nothing about CPU. What it does establish is that the dissolve-on trigger below is not satisfied today. THE CAUSE PREVIOUSLY RECORDED BESIDE IT IS RETRACTED (2026-08-04, sessions wise-ram-22 / still-bat-561 / merry-raven-690): three prose copies attributed the 5004ms crossing to host contention. That is false and could not have been true. cli_run.rs run_claim_measured arms the budget through v1_interpreter.rs arm_eval_deadline, which seeds thread_cpu_nanos() — CLOCK_THREAD_CPUTIME_ID — so neither co-residence nor cold page cache accrues against it; run_claim_measured's own comment states that insulation as the reason the clock was chosen. THREE SUSPECTS FALSIFIED, recorded so nobody re-raises them: (1) contention or cold I/O — wrong clock, above, and the two-budget discriminator settles that rather than assuming it. cli_run.rs BudgetKind is Cpu or Wall and run_claim_measured applies BOTH completion arms, so a Wall crossing would put contention back in play; but the Wall arm is armed only from wet_receipt_wall_budget_ms, which is populated solely when plan_function is gunbc_falsifier_plan and valued at gunbc_falsifier_self_host_wet_receipt_wall_budget_ms = 600000ms. A 5004ms crossing is the 5000ms gunbc_ci_fast_lane_eval_budget_ms — the CPU arm, two orders of magnitude under the wall ceiling — so the kind is Cpu and contention cannot reach it (discriminator raised by still-bat-561, checked here); (2) corpus-index construction — v1 load_bare_edge_index / build_both_closure_edge_index sit on the RESOLVE path and all four set_witness_eval_budget call sites (cli_run.rs x2, bin/claim_batch.rs x2) arm the budget after resolve completes, so index cost is outside the budget on every path; (3) budget accumulating across a batch — run_claim_measured arms and clears per witness, so a late witness inherits no earlier witness's CPU. WHAT IS NOT ESTABLISHED, said plainly rather than filled in: the positive cause of 1005ms versus 5004ms. Those two figures are NOT ON THE SAME CLOCK, which has to be said before any ratio is quoted from them. 1005ms comes from the receipt, and v1_interpreter.rs performance_receipt_from_witness is handed wall_nanos; cli_run.rs run_claim_measured computes cpu_nanos beside it, spends it on budget_completion_outcome, and persists it nowhere, so no CPU column exists in the tree and witness_row_cost_basis's eval_ms is WALL despite the name. 5004ms comes from the kill path, and that is CPU: v1_interpreter.rs eval_expr stride-polls thread_cpu_nanos every 4096 evals against the armed baseline and raises InterpError EvalBudgetExceeded from inside eval — a prose-carried arm, not the typed TimedOut, which is only the completion-side backstop for rows that finish. So the 5x is a wall-to-CPU ratio, not a like-for-like one (found by still-bat-561 running the log grep after the wiring argument had already settled the budget kind). Beyond the clock, three variables still move at once — host (srv_fleet_arm64 vs the falsifier runner), head, and route (a narrow single-entry claim_batch vs discovery-corpus batch 1 over a far larger pool, run 30550328673) — and a further candidate, that the generators simply do more work as the corpus grows, is untested. So the gap is an OBSERVATION, not a diagnosis. The discriminating experiment is one host, one head, both routes; it cannot be run off today's receipts, because comparing them measures wall on both sides and answers the route question while leaving the cap question untouched. AND IT NEEDS REPEATS, NOT ONE PAIR — measured, not assumed (still-bat-561, off the falsifier row-cost receipt): the RED control reads 731ms on the discovery route against 91ms on the narrow one, a factor of 8.0 on a row whose work is 91ms. That figure is unambiguous — 731ms is nowhere near any cap, so it is a completed row's cost — and 8x of route-attributable swing is wide enough to swamp any single paired comparison. The witness row on the same receipt reads 5018ms against 7944ms narrow, which would be a factor in the OPPOSITE direction; that one is NOT quotable as a cost, because 5018 sits 18ms past the 5000 cap and a killed row records where the kill landed rather than what the row costs, so its true value is unbounded above and its sign is unknown. The variance case therefore rests on the control alone, which is enough: the experiment above settles nothing if it is run once. RESIDUAL FINDING ONE, larger than this witness and not fixed here: fast-lane eligibility is decided on the wrong clock. The cap is enforced on CPU and every recorded measurement is wall, so admitting or re-homing any witness compares one quantity against a bound on another; cpu_nanos already exists at the run_claim_measured call site and is dropped. This does NOT kill the dissolve-on triggers that name that budget, and the asymmetry is the point: eval is single-threaded, so thread CPU is bounded above by wall, and a recorded wall figure UNDER the cap does prove CPU under the cap. The triggers therefore stay decidable in exactly the direction that fires them. What is not available is the other direction — how near the cap a row sits, and whether an over-cap wall figure reflects CPU at all — which is the diagnostic direction, and the one every re-measurement of this row would want. The mismatch also has a second half that the cap cannot report, because it is the half the cap is blind to by construction: nothing bounds waiting, so a row with small CPU and large wait NEVER crosses the cap — never killed, never counted, never ranked — while still costing the corpus its full wall on every run. The cap and the receipt therefore measure different populations, and the wall receipt is the poor instrument for the first and the only instrument for the second (extension by still-bat-561 off this note's own counterexample; a structural convergence claim in the other direction — that near-cap wall must approximate CPU — was raised and withdrawn, since wall is an unbounded sum and not a budget being consumed). That belongs to the witness-cost lane. Dissolve-on: PerformanceReceipt persists cpu_nanos and the cost basis carries a CPU column, at which point the diagnostic direction opens too. RESIDUAL FINDING TWO, which the rehome mitigates but does not close: a per-witness CPU budget is applied to a witness whose cost grows with the repository. That is a SCOPE mismatch, not a tolerance one — no threshold is correct for a quantity that grows with the corpus — and it belongs to the cost-envelope work rather than to this file. Dissolve-on: witnesses declare an input envelope and route derives from it, at which point a live-tree reader is admitted on its declared input rather than measured against a flat per-witness ceiling. The drift gate run_generated_artifact_drift_gate_body still reads the same bytes as one conjunct; the long-lane witness ISOLATES the fixed-point property as a separately-falsifiable claim with its own RED control."

test fn witness_all_known_committed() -> Bool {
  artifact_is_committed(a: CiYamlArtifact)
    && artifact_is_committed(a: FalsifierYamlArtifact)
    && artifact_is_committed(a: GitignoreArtifact)
    && artifact_is_committed(a: GitattributesArtifact)
    && artifact_is_committed(a: RoadmapArtifact)
    && artifact_is_committed(a: DesignArtifact)
    && artifact_is_committed(a: GithooksPrePushArtifact)
    && artifact_is_committed(a: GeneratedArtifactMergeDriverArtifact)
    && artifact_is_committed(a: GithooksPreCommitArtifact)
    && artifact_is_committed(a: PlanArtifact { plan: idea_machine_plan })
    && !artifact_is_committed(a: RunnerDeployArtifact)
    && !artifact_is_committed(a: AutoinstallUserDataArtifact { spec: srv3_autoinstall_spec })
    && !artifact_is_committed(a: ProxyDhcpDnsmasqArtifact { spec: srv3_install_server_spec })
    && !path_is_ignored(path: ".github/workflows/ci.yml")
    && !path_is_ignored(path: ".github/workflows/falsifier.yml")
    && !path_is_ignored(path: ".gitignore")
    && !path_is_ignored(path: ".gitattributes")
    && !path_is_ignored(path: "ROADMAP.md")
    && !path_is_ignored(path: "DESIGN.md")
    && !path_is_ignored(path: ".githooks/pre-push")
    && !path_is_ignored(path: ".githooks/pre-commit")
    && !path_is_ignored(path: "dag/gunbc/stage0_crate_layout_generated.dag")
    && !path_is_ignored(path: "dag/gunbc/stage0_crate_partition_generated.dag")
    && !path_is_ignored(path: "dag/gunbc/stage0_emit_plan_generated.dag")
    && !path_is_ignored(path: "src/v1/stage0/src/v1_interpreter_dispatch_generated.rs")
    && !path_is_ignored(path: "src/v1/stage0/src/bootstrap_stage0_crate_layout_generated.rs")
    && !path_is_ignored(path: "docs/plans/idea-machine.md")
