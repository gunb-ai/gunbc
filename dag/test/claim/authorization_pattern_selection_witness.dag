module test.claim.authorization_pattern_selection_witness

// THE SELECTION IS THE FACT THAT WAS MISSING, so the selection is what has to execute. Each probe
// supplies one privileged effect at the interface (§3: a witness discriminates at one interface)
// and asserts which pattern the fold selects; the census probes at the end run the real roster
// through the real fold, which is the inhabitance claim the fixtures owe.
import gunbc.auth.authorization_pattern_selection {
  PrivilegedEffect, ApiSurface, HumanSurfaceOnly,
  WorkloadIdentityBindable, WorkloadIdentityUnbindable,
  MintsNoCredential, MintsResourceScopedCredential, MintsAccountWideCredential, MintsHostRootReach,
  ReversibleByReapply, IrreversibleEffect,
  BillsExternally, NoBillingConsequence, BillingConsequence,
  NoWitnessDischarge, StandingRulingUnderInterlock, WitnessDischarge, EntailedByApprovedConvergence, ConvergenceRoot,
  FederatedScopedGrant, OperatorApprovedCapability, HumanOnlyStep, OperatorOwnSession, AdministratorEdge, ApprovedConvergenceGrant,
  PatternSelected, ManualStepRequired, NoAdmissiblePattern,
  PatternSelectionNeedsEvidence, PatternSelectionNeedsPolicy, PatternSelectionRefused,
  AuthorizationPatternSelection,
  InterlockPending, InterlockedBy,
  select_authorization_pattern, witness_required,

}
import gunbc.auth.privileged_effect_census {
  privileged_effect_census, census_verdicts, undecidable_sites,
  unrostered_unreasoned_divergences, rostered_but_not_diverging, follow_up_sites,
  reasoned_divergences, reasoned_divergences_with_fired_triggers,
  site_verdict, SiteVerdict, DivergenceReason, Conforms, DivergesWithReason, Diverges, SiteNotDecidable,
  mtcollins1_boot_effect, privileged_effect_interlocks, privileged_effect_interlock_hold, interlocked_sites_missing_from_census, rulings_without_a_rostered_interlock,
  ruling_roots_missing_from_census, census_sites_outside_ruling_roots,
  runner_lifecycle_scope_ruling, runner_lifecycle_operator_ruling, OperatorScopeRuling, ruling_discharge_for,
  mtcollins1_operator_ruling,
  RealizedFederatedGrant, RealizedRunSelected, RealizedApprovalCapability, RealizedHumanStep, RealizedOperatorSession, RealizedUnauthorized, RealizedAdministratorEdge,
  RealizedUnderApprovedConvergence, PrivilegedEffectSite, convergence_lineage_defects, srv1_root_mutation_approval_root,
}
import gunbc.ci.deploy_route_requirement {
  srv1_deploy_route_requirement, SharesJobUidWithPullRequestJobs, deploy_route_switch_admitted, SoleTenantOfJobUid,
}
import std.human_intervention {
  HumanIntervention, HumanInterventionIdentity, HumanInterventionFrequency, FleetOnce, DeviceOnce, EveryProvision, EveryOperatorRequest, BreakGlassOnly,
  NoDischargeSiteModeled,
}
import gunbc.auth.privileged_effect_census {
  manual_api_effect_beside_unlanded_approval_adapter,
  fleet_host_file_converge_edge_beside_the_broker_route,
}
import gunbc.cloudflare.r2_origin { cloudflare_account_allocation_intervention }
import gunbc.spark.dgx_pxe_boot { spark_pxe_firmware_enablement_intervention }
import std.decl_ref { decl_ref, declaration_ref_eq, declaration_ref_display_key }
import std.scoped_authorization { AuthorizationScope, AuthorizedAction }
import std.effect_grant { Write, filesystem_position }
import std.types { NonEmptyStr, String, Int, List }
import std.logic { Bool }

fn recurring_read() -> PrivilegedEffect {
  PrivilegedEffect {
    subject: "a credential read on every provision" as NonEmptyStr,
    frequency: EveryProvision,
    reversibility: ReversibleByReapply,
    surface: ApiSurface,
    workload_identity: WorkloadIdentityBindable { member: "serviceAccount:fixture@fixture.invalid" as NonEmptyStr },
    minted_reach: MintsNoCredential,
    billing: NoBillingConsequence,
    witness_discharge: NoWitnessDischarge,
  }
}

fn one_off_irreversible_mint() -> PrivilegedEffect {
  PrivilegedEffect {
    subject: "a one-off token mint whose value is returned once" as NonEmptyStr,
    frequency: FleetOnce,
    reversibility: IrreversibleEffect { what_is_lost: "the value" as NonEmptyStr },
    surface: ApiSurface,
    workload_identity: WorkloadIdentityBindable { member: "serviceAccount:fixture@fixture.invalid" as NonEmptyStr },
    minted_reach: MintsResourceScopedCredential,
    billing: NoBillingConsequence,
    witness_discharge: NoWitnessDischarge,
  }
}

fn one_off_grant_unbindable() -> PrivilegedEffect {
  PrivilegedEffect {
    subject: "a one-off accessor-cell grant the workload may not perform" as NonEmptyStr,
    frequency: FleetOnce,
    reversibility: ReversibleByReapply,
    surface: ApiSurface,
    workload_identity: WorkloadIdentityUnbindable { cause: "grant administrator only" as NonEmptyStr },
    minted_reach: MintsNoCredential,
    billing: NoBillingConsequence,
    witness_discharge: NoWitnessDischarge,
  }
}

fn dashboard_step() -> HumanIntervention {
  HumanIntervention {
    identity: "fixture-dashboard-step" as HumanInterventionIdentity,
    frequency: FleetOnce,
    subject: "a checkout-only activation" as NonEmptyStr,
    instruction: "click the button" as NonEmptyStr,
    completion_evidence: NoDischargeSiteModeled,
  }
}

fn dashboard_only() -> PrivilegedEffect {
  PrivilegedEffect {
    subject: "an activation no API performs" as NonEmptyStr,
    frequency: FleetOnce,
    reversibility: ReversibleByReapply,
    surface: HumanSurfaceOnly { step: dashboard_step() },
    workload_identity: WorkloadIdentityUnbindable { cause: "no API" as NonEmptyStr },
    minted_reach: MintsNoCredential,
    billing: BillsExternally,
    witness_discharge: NoWitnessDischarge,
  }
}

fn recurring_but_witnessed() -> PrivilegedEffect {
  PrivilegedEffect {
    subject: "a per-provision effect that bills externally" as NonEmptyStr,
    frequency: EveryProvision,
    reversibility: ReversibleByReapply,
    surface: ApiSurface,
    workload_identity: WorkloadIdentityBindable { member: "serviceAccount:fixture@fixture.invalid" as NonEmptyStr },
    minted_reach: MintsNoCredential,
    billing: BillsExternally,
    witness_discharge: NoWitnessDischarge,
  }
}

fn selected_federated(s: AuthorizationPatternSelection) -> Bool {
  match s {
    PatternSelected { pattern: FederatedScopedGrant, receipt: _ } => true
    _ => false
  }
}

fn selected_approved(s: AuthorizationPatternSelection) -> Bool {
  match s {
    PatternSelected { pattern: OperatorApprovedCapability, receipt: _ } => true
    _ => false
  }
}

// (a) A recurring, reversible, bindable read is federated -- zero human actions, and the approval
// pattern is dominated rather than excluded.
test fn a_recurring_reversible_bindable_read_is_federated() -> Bool {
  selected_federated(s: select_authorization_pattern(e: recurring_read()))
}

// (b) An irreversible one-off is approved per effect, and the federated pattern is NOT selected
// even though the identity is bindable: no human witnessed it.
test fn an_irreversible_one_off_is_operator_approved_not_federated() -> Bool {
  let s = select_authorization_pattern(e: one_off_irreversible_mint())
  selected_approved(s: s) && !selected_federated(s: s)
}

// (b) A one-off grant the workload may not perform is approved -- the accessor-cell converges
// select this over the operator's own token.
test fn an_unbindable_one_off_grant_is_operator_approved() -> Bool {
  selected_approved(s: select_authorization_pattern(e: one_off_grant_unbindable()))
}

// (c) A dashboard-only effect is a typed refusal naming the modeled step.
test fn a_dashboard_only_effect_names_its_manual_step() -> Bool {
  match select_authorization_pattern(e: dashboard_only()) {
    ManualStepRequired { step: st, receipt: _ } => (st.identity as String) == "fixture-dashboard-step"
    _ => false
  }
}

// THE OPERATOR'S OWN SESSION IS NEVER SELECTED: it is always dominated, so across every fixture
// the selected pattern is one of the three others.
fn selection_is_admissible(s: AuthorizationPatternSelection) -> Bool {
  match s {
    PatternSelected { pattern: p, receipt: _ } =>
      match p {
        OperatorOwnSession => false
        AdministratorEdge => true
        ApprovedConvergenceGrant => true
        FederatedScopedGrant => true
        OperatorApprovedCapability => true
        HumanOnlyStep { step: _ } => true
      }
    ManualStepRequired { step: _, receipt: _ } => true
    NoAdmissiblePattern { causes: _, scope: _ } => true
    PatternSelectionNeedsEvidence { needs: _ } => false
    PatternSelectionNeedsPolicy { survivors: _ } => false
    PatternSelectionRefused { defects: _ } => false
  }
}

test fn no_fixture_selects_an_operator_session() -> Bool {
  all([recurring_read(), one_off_irreversible_mint(), one_off_grant_unbindable(), dashboard_only(), recurring_but_witnessed()],
    e => selection_is_admissible(s: select_authorization_pattern(e: e)))
}

// A RECURRING EFFECT THAT OWES A WITNESS IS A DESIGN CONTRADICTION, and the fold refuses it rather
// than picking the least bad pattern: the author makes it reversible or makes it one-off.
test fn a_recurring_effect_that_owes_a_witness_has_no_admissible_pattern() -> Bool {
  match select_authorization_pattern(e: recurring_but_witnessed()) {
    NoAdmissiblePattern { causes: cs, scope: _ } => (cs |> count) > 0
    _ => false
  }
}

// THE WITNESS OBLIGATION IS DERIVED, and each of its four grounds fires on its own.
test fn each_witness_ground_fires_alone() -> Bool {
  let base = recurring_read()
  let wide = PrivilegedEffect {
    subject: base.subject, frequency: FleetOnce, reversibility: ReversibleByReapply, surface: ApiSurface,
    workload_identity: base.workload_identity, minted_reach: MintsAccountWideCredential, billing: NoBillingConsequence, witness_discharge: NoWitnessDischarge,
  }
  let break_glass = PrivilegedEffect {
    subject: base.subject, frequency: BreakGlassOnly, reversibility: ReversibleByReapply, surface: ApiSurface,
    workload_identity: base.workload_identity, minted_reach: MintsNoCredential, billing: NoBillingConsequence, witness_discharge: NoWitnessDischarge,
  }
  !witness_required(e: base)
    && witness_required(e: one_off_irreversible_mint())
    && witness_required(e: wide)
    && witness_required(e: dashboard_only())
    && witness_required(e: break_glass)
}

// THE FABRIC STORE'S PROTECTED-HEAD WRITERS (operator ruling A, 2026-09-27). Each writer's
// selection is the credential the store door will verify for it; asserting it here is what makes
// the tap count the operator was told a derived fact. D0's door gates on the approval it selects,
// but the store does not verify it, so its store write diverges like every other writer's. The recurring host-effect lanes select the workload's own identity -- no human per run -- and the
// operator's recovery and establishment entries select one approval each; all diverge today under
// the one stated reason, because the store verifies nothing for any of them.
// THE ROW'S OWN VERDICT through the real per-row fold (site_verdict), not the whole census folded
// and then filtered: each claim is about one site, and the census fold is already run by the
// roster claims above (§3: a witness discriminates at one interface).
fn fabric_writer_verdict(key: String, want_approval: Bool) -> Bool {
  any(map(filter(privileged_effect_census, row => declaration_ref_display_key(ref: row.site) == key), row => site_verdict(row: row)), v =>
    (if want_approval { selected_approved(s: v.selection) } else { selected_federated(s: v.selection) })
      && match v.conformance {
        Conforms => false
        DivergesWithReason { reason: _ } => true
        Diverges => false
        SiteNotDecidable { standing: _ } => false
      })
}

test fn the_host_effect_lanes_select_workload_identity_and_state_the_unverified_store() -> Bool {
  fabric_writer_verdict(key: "gunbc.spark.host_commitment::claim_host_effect_live", want_approval: false)
    && fabric_writer_verdict(key: "gunbc.spark.host_commitment::settle_host_effect_live_over", want_approval: false)
}

test fn the_fabric_operator_entries_select_one_approval_each_and_state_the_unverified_store() -> Bool {
  fabric_writer_verdict(key: "gunbc.spark.host_commitment::host_effect_recover_wet", want_approval: true)
    && fabric_writer_verdict(key: "gunbc.spark.pair_serving_authority_log::pair_serving_authority_establish_wet", want_approval: true)
    && fabric_writer_verdict(key: "gunbc.spark.pair_serving_authority_log::host_placement_finalize_wet", want_approval: true)
    && fabric_writer_verdict(key: "gunbc.spark.pair_serving_authority_log::host_placement_abort_wet", want_approval: true)
}

// ── The census, run through the real fold ────────────────────────────────────────────────────
test fn every_census_site_is_decidable() -> Bool {
  (undecidable_sites() |> count) == 0
}

// THE FOLLOW-UP ROSTER IS AN IDENTITY JOIN IN BOTH DIRECTIONS: an unrostered unreasoned divergence
// is undeclared debt; a rostered site that now conforms is a paid debt whose row must be retired.
test fn unreasoned_divergences_join_the_follow_up_roster_exactly() -> Bool {
  (unrostered_unreasoned_divergences() |> count) == 0 && (rostered_but_not_diverging() |> count) == 0
}

// THE TRIGGER'S ANSWER: the R2 mint selects per-effect operator approval, and its row states why it
// diverges today.
test fn the_r2_mint_selects_operator_approval_and_states_its_divergence() -> Bool {
  any(census_verdicts(), v =>
    declaration_ref_display_key(ref: v.site) == "gunbc.cloudflare.r2_token_mint_run::r2_mint_bootstrap"
      && selected_approved(s: v.selection)
      && match v.conformance {
        DivergesWithReason { reason: _ } => true
        Conforms => false
        Diverges => false
        SiteNotDecidable { standing: _ } => false
      })
}

// THE CONFORMING POPULATION IS NON-EMPTY: at least one federated exemplar and the dashboard-only
// exemplar conform, so the fold is not refusing everything and calling it rigor.
test fn the_census_has_conforming_exemplars_of_two_patterns() -> Bool {
  let federated = any(census_verdicts(), v =>
    selected_federated(s: v.selection) && match v.conformance { Conforms => true _ => false })
  let manual = any(census_verdicts(), v =>
    match v.selection { ManualStepRequired { step: _, receipt: _ } => match v.conformance { Conforms => true _ => false } _ => false })
  federated && manual
}

// EVERY STATED REASON CARRIES A DISSOLUTION, AND NONE HAS FIRED. A fired trigger means the site
// belongs in follow_up_sites rather than behind a statement (review 68720).
test fn no_reasoned_divergence_has_a_fired_trigger() -> Bool {
  (reasoned_divergences() |> count) > 0 && (reasoned_divergences_with_fired_triggers() |> count) == 0
}

// THE FIRST SITE REALIZED THROUGH THE APPROVAL CAPABILITY CONFORMS. The runner-group create's row is
// run through the real fold: its characteristics select per-effect operator approval, and it
// realizes exactly that, so its verdict is Conforms with no stated reason -- the census's first
// conforming exemplar of the approval pattern.
test fn the_publication_helper_selects_federation_and_states_the_host_key_divergence() -> Bool {
  any(census_verdicts(), v =>
    declaration_ref_display_key(ref: v.site) == "gunbc.roadmap.roadmap_publication_helper::publication_helper_publish_if_unpublished"
      && selected_federated(s: v.selection)
      && match v.conformance {
        DivergesWithReason { reason: _ } => true
        Conforms => false
        Diverges => false
        SiteNotDecidable { standing: _ } => false
      })
}

test fn the_runner_group_create_selects_and_realizes_operator_approval() -> Bool {
  any(census_verdicts(), v =>
    declaration_ref_display_key(ref: v.site) == "gunbc.runner.runner_group_restriction_ensure_run::microvm_runner_group_after_gate"
      && selected_approved(s: v.selection)
      && match v.conformance { Conforms => true _ => false })
}

// THE MT. COLLINS BOOT (operator ruling 2026-09-23): the census row runs through the real fold and
// DERIVES the federated pattern, and the site's realization conforms -- the boot is no longer an
// unrostered per-run approval.
test fn the_mtcollins1_boot_selects_federation_and_conforms() -> Bool {
  any(census_verdicts(), v =>
    declaration_ref_display_key(ref: v.site) == "gunbc.machine_intake.mtcollins1_boot_run::mtcollins1_boot_wet"
      && selected_federated(s: v.selection)
      && match v.conformance {
        Conforms => true
        DivergesWithReason { reason: _ } => false
        Diverges => false
        SiteNotDecidable { standing: _ } => false
      })
}

// THE STANDING RULING IS WHAT THE DERIVATION RESTS ON, so the mutation is that one field. The boot is
// declared IrreversibleEffect (a power cycle destroys RAM and session state). Under the operator's
// standing authorization, conditional on the unit hold, it selects federation; strip the ruling and
// the same effect owes a witness AND must run unattended, so no pattern is admissible -- the fold
// refuses rather than quietly picking one. The label is not what decides; the ruling is.
test fn the_mtcollins1_boot_is_irreversible_and_federated_only_under_its_standing_ruling() -> Bool {
  let e = mtcollins1_boot_effect()
  let without_ruling = PrivilegedEffect {
    subject: e.subject,
    frequency: e.frequency,
    reversibility: e.reversibility,
    surface: e.surface,
    workload_identity: e.workload_identity,
    minted_reach: e.minted_reach,
    billing: e.billing,
    witness_discharge: NoWitnessDischarge,
  }
  let declared_irreversible = match e.reversibility {
    IrreversibleEffect { what_is_lost: _ } => true
    ReversibleByReapply => false
  }
  declared_irreversible
    && selected_federated(s: select_authorization_pattern(e: e))
    && match select_authorization_pattern(e: without_ruling) {
      NoAdmissiblePattern { causes: _, scope: _ } => true
      _ => false
    }
}

// THE RULING DISCHARGES IRREVERSIBILITY AND NOTHING ELSE: an irreversible effect that also mints an
// account-wide credential still owes a per-instance witness under the same ruling.
test fn a_standing_ruling_does_not_discharge_a_wide_credential() -> Bool {
  let e = mtcollins1_boot_effect()
  let wide = PrivilegedEffect {
    subject: e.subject, frequency: e.frequency, reversibility: e.reversibility, surface: e.surface,
    workload_identity: e.workload_identity, minted_reach: MintsAccountWideCredential, billing: e.billing,
    witness_discharge: e.witness_discharge,
  }
  !witness_required(e: e) && witness_required(e: wide)
}

// EVERY STANDING RULING IN THE CENSUS NAMES AN INTERLOCK ROSTERED AGAINST ITS OWN SITE.
test fn every_standing_ruling_has_its_interlock_rostered() -> Bool {
  (rulings_without_a_rostered_interlock() |> count) == 1
    && match rulings_without_a_rostered_interlock().first() {
      Present { value: s } =>
        declaration_ref_display_key(ref: s) == "gunbc.auth.mtjade1_arrival_federation::mtjade1_arrival_firmware_qualification_effect"
      Absent => false
    }
}

test fn pending_rulings_do_not_invent_a_rostered_hold() -> Bool {
  match privileged_effect_interlock_hold(interlock: InterlockPending { obligation: "unnamed" as NonEmptyStr }) {
    Absent => true
    Present { value: _ } => false
  }
    && match privileged_effect_interlock_hold(interlock: mtcollins1_operator_ruling.interlock) {
      Absent => false
      Present { value: h } => (h.decl_name as String) == "UnitHoldProof"
    }
}

// THE CENSUS SHOWS THE INTERLOCK: every interlocked site is a census row, and the boot's names the
// unit hold and the refusal fold that honors it.
test fn the_mtcollins1_boot_interlock_is_rostered_against_a_census_row() -> Bool {
  (interlocked_sites_missing_from_census() |> count) == 0
    && any(privileged_effect_interlocks, i =>
      declaration_ref_display_key(ref: i.site) == "gunbc.machine_intake.mtcollins1_boot_run::mtcollins1_boot_wet"
        && declaration_ref_display_key(ref: i.refusal) == "gunbc.host.managed_host_unit_hold::unit_hold_acquire"
        && any(i.hold_owning_roots, r => declaration_ref_display_key(ref: r.root) == "gunbc.machine_intake.mtcollins1_boot_run::mtcollins1_boot_wet")
        && any(i.hold_owning_roots, r => declaration_ref_display_key(ref: r.root) == "gunbc.host.host_reset_return_run::host_reset_return_wet"))
}

// ONE RULING, EVERY ROOT A CENSUS ROW AT THE SAME GRAIN (side-chat review 5288466573): the ruling's
// roots and the census sites carrying its discharge are the same set, both roots select the federated
// pattern and conform, and both carry an interlock row.
test fn every_root_of_the_standing_ruling_is_a_conforming_census_row() -> Bool {
  (ruling_roots_missing_from_census() |> count) == 0
    && (census_sites_outside_ruling_roots() |> count) == 0
    && any(census_verdicts(), v =>
      declaration_ref_display_key(ref: v.site) == "gunbc.host.host_reset_return_run::host_reset_return_wet"
        && selected_federated(s: v.selection)
        && match v.conformance { Conforms => true  _ => false })
    && any(privileged_effect_interlocks, i => declaration_ref_display_key(ref: i.site) == "gunbc.host.host_reset_return_run::host_reset_return_wet")
}

// THE 2026-10-03 PRE-APPROVAL IS A SELECTION, NOT A NEW VOCABULARY. JIT registration,
// deregistration, the qualification dispatch and its per-attempt branch pin are each a
// recurring automated effect under the dispatching run's federated identity (the pin and its removal
// on their own parameters, with no ruling discharge), so the selection must
// answer the federated scoped grant and the row must conform; rowing it as an approval capability or
// a per-registration ntfy approval turns this red.
test fn the_jit_registration_deregistration_and_dispatch_sites_select_the_federated_grant_and_conform() -> Bool {
  ["dispatch_jit_mint", "ensure_jit_runner_deregistered", "dispatch_qualification_floor", "ensure_qualification_ref_pin", "remove_qualification_ref_pin"] |> all(name =>
    any(census_verdicts(), v =>
      (v.site.decl_name as String) == name
        && selected_federated(s: v.selection)
        && match v.conformance { Conforms => true _ => false }))
}

// THE OPERATOR'S SCOPE RULING IS THE ONE SOURCE OF WHERE THE RUNNER-LIFECYCLE DISCHARGE MAY APPLY: a
// census row takes it only when covers names its site, and every covered site is a census row. The
// red is a row claiming the ruling outside the operator's scope, or a covers entry naming no site. A
// covered row that does not consume the discharge is admitted: the selection federates it on its own
// parameters, so it owes no interlock (the converse direction is not a wall, by design).
fn discharged_by_runner_lifecycle_ruling(d: WitnessDischarge) -> Bool {
  match d {
    NoWitnessDischarge => false
    EntailedByApprovedConvergence { root: _, required_scopes: _ } => false
    StandingRulingUnderInterlock { ruling: g } => (g.ruling_text as String) == (runner_lifecycle_operator_ruling.ruling_text as String)
  }
}

test fn a_row_takes_the_runner_lifecycle_ruling_only_where_the_operator_scope_ruling_covers_it() -> Bool {
  privileged_effect_census |> all(r =>
    !discharged_by_runner_lifecycle_ruling(d: r.effect.witness_discharge)
      || any(runner_lifecycle_scope_ruling.covers, c => declaration_ref_eq(a: c, b: r.site)))
    && runner_lifecycle_scope_ruling.covers |> all(c => any(privileged_effect_census, r => declaration_ref_eq(a: c, b: r.site)))
}

// THE DISPATCH'S COVERAGE IS THE OPERATOR'S 2026-10-05 SCOPE RULING, NOT THE 10-03 TEXT. The census
// row's discharge reads runner_lifecycle_scope_ruling; narrowed to registration and deregistration --
// the 10-03 ruling's own words -- the same irreversible dispatch effect is no longer discharged and
// the selection stops answering the federated grant. The 10-03 text is unchanged either way, and its
// interlock is the host-generic unit hold.
test fn the_dispatch_is_federated_only_while_the_scope_ruling_names_it() -> Bool {
  let row = first(filter(privileged_effect_census, r => (r.site.decl_name as String) == "dispatch_qualification_floor"))
  let narrowed = OperatorScopeRuling {
    ruling: runner_lifecycle_operator_ruling,
    scope_text: "narrowed to the 2026-10-03 ruling's own words" as NonEmptyStr,
    decided_on: runner_lifecycle_scope_ruling.decided_on,
    decided_through: runner_lifecycle_scope_ruling.decided_through,
    covers: [
      decl_ref(module_path: "gunbc.runner.runner_jit_perform", decl_name: "dispatch_jit_mint"),
      decl_ref(module_path: "gunbc.runner.runner_jit_deregistration", decl_name: "ensure_jit_runner_deregistered"),
    ],
  }
  (runner_lifecycle_scope_ruling.decided_through as String) == "escalation msg_5756a200-fcb5-470a-87eb-40867bfe9cdb"
    && match runner_lifecycle_operator_ruling.interlock {
      InterlockedBy { hold } =>
        (hold.decl_name as String) == "UnitHoldProof"
          && (hold.module_path as String) == "gunbc.host.managed_host_unit_hold"
      InterlockPending { obligation: _ } => false
    }
    && match row {
      Present { value: r } =>
        selected_federated(s: select_authorization_pattern(e: r.effect))
          && !selected_federated(s: select_authorization_pattern(e: PrivilegedEffect {
            subject: r.effect.subject,
            frequency: r.effect.frequency,
            reversibility: r.effect.reversibility,
            surface: r.effect.surface,
            workload_identity: r.effect.workload_identity,
            minted_reach: r.effect.minted_reach,
            billing: r.effect.billing,
            witness_discharge: ruling_discharge_for(scope: narrowed, site_ref: r.site),
          }))
      Absent => false
    }
}

// THE R2 MINT CUSTODY CELLS ARE REALIZED BY THE FEDERATED GCP IAM ROUTE, NOT AN OPERATOR SESSION:
// no census site remains in gunbc.cloudflare.r2_mint_secret_access (its gcloud converges were
// deleted), and the gcp-iam-converge apply site that now grants them is a federated grant naming the
// R2 custody cells. The RED is the operator-session row restored.
test fn the_r2_custody_cells_are_realized_by_the_federated_iam_route() -> Bool {
  !any(privileged_effect_census, row => starts_with(s: declaration_ref_display_key(ref: row.site), prefix: "gunbc.cloudflare.r2_mint_secret_access::"))
    && any(privileged_effect_census, row =>
      declaration_ref_display_key(ref: row.site) == "gunbc.auth.gcp_iam_converge_run::gcp_iam_converge_apply_wet"
        && string_contains(s: row.effect.subject as String, pattern: "R2 mint custody cells")
        && match row.realized {
          RealizedFederatedGrant => true
          RealizedRunSelected => false
          RealizedApprovalCapability => false
          RealizedHumanStep => false
          RealizedOperatorSession { arm: _ } => false
          RealizedUnauthorized => false
          RealizedAdministratorEdge => false
          RealizedUnderApprovedConvergence => false
        })
}

// THE RUNNER-RETIREMENT MASK IS A SELECTION: reversible, recurring, bindable and resource-scoped, so the
// fold selects the federated scoped grant and the row conforms. The discriminating
// control for the irreversible variant is a_recurring_effect_that_owes_a_witness_has_no_admissible_pattern.
test fn the_runner_retirement_mask_selects_the_federated_grant_and_conforms() -> Bool {
  any(census_verdicts(), v =>
    (v.site.decl_name as String) == "retirement_mask_line"
      && selected_federated(s: v.selection)
      && match v.conformance { Conforms => true _ => false })
}

// ── THE srv1 DEPLOY EFFECTS, CLASSIFIED BY EXECUTION (gunbc.plans.srv1_deploy_principal_split) ─────────
// A recurring root write on a fleet host owes a witness and must run unattended. The federated pattern
// is unwitnessed and unbindable, the approval pattern is attended, the operator's session is both, so
// before the arm existed the only honest filing was a cloud reach the effect does not have.
fn recurring_host_root_write() -> PrivilegedEffect {
  PrivilegedEffect {
    subject: "a recurring root write on a fleet host" as NonEmptyStr,
    frequency: EveryProvision,
    reversibility: ReversibleByReapply,
    surface: ApiSurface,
    workload_identity: WorkloadIdentityUnbindable { cause: "fixture" as NonEmptyStr },
    minted_reach: MintsHostRootReach,
    billing: NoBillingConsequence,
    witness_discharge: NoWitnessDischarge,
  }
}

fn selected_administrator_edge(s: AuthorizationPatternSelection) -> Bool {
  match s {
    PatternSelected { pattern: AdministratorEdge, receipt: _ } => true
    _ => false
  }
}

// THE POSITIVE CONTROL: with the arm, the selection names the administrator edge.
test fn a_recurring_host_root_write_selects_the_administrator_edge() -> Bool {
  selected_administrator_edge(s: select_authorization_pattern(e: recurring_host_root_write()))
}

// THE RED: the same effect filed at the widest reach the model had before the arm is refused, which
// is the silent refusal the arm removes. Deleting MintsHostRootReach or the candidate flips the
// control above and leaves this one standing, so the pair discriminates.
test fn the_same_effect_without_the_host_root_arm_has_no_admissible_pattern() -> Bool {
  let before_the_arm = PrivilegedEffect {
    subject: recurring_host_root_write().subject, frequency: EveryProvision, reversibility: ReversibleByReapply,
    surface: ApiSurface, workload_identity: WorkloadIdentityUnbindable { cause: "fixture" as NonEmptyStr },
    minted_reach: MintsAccountWideCredential, billing: NoBillingConsequence, witness_discharge: NoWitnessDischarge,
  }
  match select_authorization_pattern(e: before_the_arm) {
    NoAdmissiblePattern { causes: cs, scope: _ } => (cs |> count) > 0
    _ => false
  }
}

// THE EDGE IS A CANDIDATE ONLY FOR HOST-ROOT REACH: no other fixture may select it.
test fn no_other_reach_selects_the_administrator_edge() -> Bool {
  !selected_administrator_edge(s: select_authorization_pattern(e: recurring_read()))
    && !selected_administrator_edge(s: select_authorization_pattern(e: one_off_irreversible_mint()))
}

fn selected_approved_convergence_grant(s: AuthorizationPatternSelection) -> Bool {
  match s {
    PatternSelected { pattern: ApprovedConvergenceGrant, receipt: _ } => true
    _ => false
  }
}

fn site_inherits_the_root_mutation_approval_and_diverges_with_reason(decl: String) -> Bool {
  any(census_verdicts(), v =>
    (v.site.decl_name as String) == decl
      && selected_approved_convergence_grant(s: v.selection)
      && match v.conformance { DivergesWithReason { reason: _ } => true _ => false })
}

fn site_inherits_the_root_mutation_approval_and_conforms(decl: String) -> Bool {
  any(census_verdicts(), v =>
    (v.site.decl_name as String) == decl
      && selected_approved_convergence_grant(s: v.selection)
      && match v.conformance { Conforms => true _ => false })
}

// THE INHABITANCE CLAIM: the real roster through the real fold. Operator ruling 2026-10-25
// (the_initial_convergence_is_the_only_approval): the four srv1 host-root writes inherit the approval of
// the root-mutation job that entails them, so each selects ApprovedConvergenceGrant, never the edge. The
// three deploy writes diverge under their stated reason; the microVM controller install realizes the
// inherited approval and conforms. The per-unit systemctl effect still selects the federated scoped grant.
test fn the_srv1_host_root_deploy_effects_inherit_the_root_mutation_approval() -> Bool {
  site_inherits_the_root_mutation_approval_and_diverges_with_reason(decl: "deploy_stage_install_command")
    && site_inherits_the_root_mutation_approval_and_diverges_with_reason(decl: "deploy_stage_visudo_check_command")
    && site_inherits_the_root_mutation_approval_and_diverges_with_reason(decl: "deploy_access_apt_get_privileged_command")
    && site_inherits_the_root_mutation_approval_and_conforms(decl: "microvm_controller_staged_write_steps")
}

// ── THE INITIAL CONVERGENCE IS THE ONLY APPROVAL (operator ruling 2026-10-25) ─────────────────
// The same host-root write, with and without a lineage root. Without one it keeps the edge (the control
// a_recurring_host_root_write_selects_the_administrator_edge); with one it selects the inherited
// approval, at every frequency a human could otherwise be asked at, except break-glass, which is
// witnessed per instance by declaration.
fn fixture_write_scope(path: List<String>) -> AuthorizationScope {
  AuthorizationScope { verb: Write, resource: filesystem_position(path: path), action: "install" as AuthorizedAction }
}

// Every fixture root approves writes under /etc; an inheriting fixture exercises /etc/fixture unless a
// claim says otherwise.
fn root_at(decl: String, e: PrivilegedEffect) -> ConvergenceRoot {
  ConvergenceRoot { site: decl_ref(module_path: "fixture.convergence", decl_name: decl), effect: e, approved_scopes: [fixture_write_scope(path: ["etc"])] }
}

fn inheriting_requiring(e: PrivilegedEffect, root: ConvergenceRoot, required: List<AuthorizationScope>) -> PrivilegedEffect {
  PrivilegedEffect {
    subject: e.subject, frequency: e.frequency, reversibility: e.reversibility, surface: e.surface,
    workload_identity: e.workload_identity, minted_reach: e.minted_reach, billing: e.billing,
    witness_discharge: EntailedByApprovedConvergence { root: root, required_scopes: required },
  }
}

fn inheriting_under(e: PrivilegedEffect, root: ConvergenceRoot) -> PrivilegedEffect {
  inheriting_requiring(e: e, root: root, required: [fixture_write_scope(path: ["etc", "fixture"])])
}

// The approved root is an effect the selection sends to the approval capability on its own.
fn inheriting(e: PrivilegedEffect) -> PrivilegedEffect {
  inheriting_under(e: e, root: root_at(decl: "approved_root", e: one_off_grant_unbindable()))
}

fn refused_naming(s: AuthorizationPatternSelection, fragment: String) -> Bool {
  match s {
    PatternSelectionRefused { defects: ds } => (ds |> count) == 1 && any(ds, d => string_contains(s: d as String, pattern: fragment))
    _ => false
  }
}

test fn a_recurring_host_root_write_with_a_lineage_root_inherits_the_approval_not_the_edge() -> Bool {
  let s = select_authorization_pattern(e: inheriting(e: recurring_host_root_write()))
  selected_approved_convergence_grant(s: s) && !selected_administrator_edge(s: s)
}

test fn an_attendable_effect_with_a_lineage_root_is_not_asked_again() -> Bool {
  all([FleetOnce, DeviceOnce, EveryOperatorRequest], f =>
    selected_approved_convergence_grant(s: select_authorization_pattern(e: inheriting(e: host_root_effect_at(f: f)))))
}

test fn a_break_glass_effect_may_not_inherit_and_says_so() -> Bool {
  selected_approved_capability(s: select_authorization_pattern(e: host_root_effect_at(f: BreakGlassOnly)))
    && refused_naming(s: select_authorization_pattern(e: inheriting(e: host_root_effect_at(f: BreakGlassOnly))), fragment: "break-glass")
}

// AN IRREVERSIBLE RECURRING EFFECT, which has no admissible pattern on its own, is admitted once the
// operator approved the convergence that entails it: the witness is per instance, not per class.
test fn an_irreversible_recurring_effect_is_admitted_only_under_a_lineage_root() -> Bool {
  match select_authorization_pattern(e: recurring_but_witnessed()) { NoAdmissiblePattern { causes: _, scope: _ } => true _ => false }
    && selected_approved_convergence_grant(s: select_authorization_pattern(e: inheriting(e: recurring_but_witnessed())))
}

// THE LINEAGE ROOT MUST BE SOMETHING THE OPERATOR APPROVES, decided by the selection itself (review
// 85926): a root the selection federates, or a root that inherits in turn, refuses the inheriting effect
// with a located defect instead of falling back to another pattern, and the same effect under an approved
// root is the green control. The census adds only the roster join: the real census has no defect and its
// srv1 root is a row that selects the approval capability; the red is a fixture roster whose root names
// no rostered site.
test fn a_root_the_selection_does_not_send_to_approval_refuses_the_inheriting_effect() -> Bool {
  let approved = root_at(decl: "approved_root", e: one_off_grant_unbindable())
  let federated = root_at(decl: "federated_root", e: recurring_read())
  let chained = root_at(decl: "middle", e: inheriting_under(e: one_off_grant_unbindable(), root: approved))
  selected_approved_convergence_grant(s: select_authorization_pattern(e: inheriting_under(e: recurring_host_root_write(), root: approved)))
    && refused_naming(s: select_authorization_pattern(e: inheriting_under(e: recurring_host_root_write(), root: federated)), fragment: "does not select OperatorApprovedCapability")
    && refused_naming(s: select_authorization_pattern(e: inheriting_under(e: recurring_host_root_write(), root: chained)), fragment: "declares a lineage of its own")
}

// ENTAILMENT IS SCOPE COVERAGE (review 85948): the same effect under the same approved root is admitted
// only while the root's approval covers every scope it exercises. A scope outside the approved tree, and
// an effect that states no scope at all, each refuse with a located defect.
test fn an_effect_inherits_only_the_scopes_the_approval_grants() -> Bool {
  let approved = root_at(decl: "approved_root", e: one_off_grant_unbindable())
  selected_approved_convergence_grant(s: select_authorization_pattern(e: inheriting_requiring(e: recurring_host_root_write(), root: approved, required: [fixture_write_scope(path: ["etc", "fixture"])])))
    && refused_naming(s: select_authorization_pattern(e: inheriting_requiring(e: recurring_host_root_write(), root: approved, required: [fixture_write_scope(path: ["etc", "fixture"]), fixture_write_scope(path: ["var", "lib"])])), fragment: "does not grant")
    && refused_naming(s: select_authorization_pattern(e: inheriting_requiring(e: recurring_host_root_write(), root: approved, required: [])), fragment: "states no scope")
}

fn fixture_row(decl: String, e: PrivilegedEffect) -> PrivilegedEffectSite {
  PrivilegedEffectSite { site: decl_ref(module_path: "fixture.convergence", decl_name: decl), effect: e, realized: RealizedUnauthorized, divergence_reason: none }
}

test fn every_lineage_root_in_the_census_is_a_rostered_approval_row() -> Bool {
  (convergence_lineage_defects(census: privileged_effect_census) |> count) == 0
    && any(census_verdicts(), v => declaration_ref_eq(a: v.site, b: srv1_root_mutation_approval_root.site) && selected_approved(s: v.selection))
}

test fn a_lineage_root_outside_the_roster_is_a_census_defect() -> Bool {
  let approved = fixture_row(decl: "approved_root", e: one_off_grant_unbindable())
  let child = fixture_row(decl: "child", e: inheriting(e: recurring_host_root_write()))
  (convergence_lineage_defects(census: [approved, child]) |> count) == 0
    && any(convergence_lineage_defects(census: [child]), d => (d.decl_name as String) == "child")
    && (convergence_lineage_defects(census: [child]) |> count) == 1
}

test fn the_srv1_per_unit_systemctl_effect_selects_the_federated_grant_and_diverges_with_reason() -> Bool {
  any(census_verdicts(), v =>
    (v.site.decl_name as String) == "systemctl_restart_command"
      && selected_federated(s: v.selection)
      && match v.conformance { DivergesWithReason { reason: _ } => true _ => false })
}

test fn the_belt_exit_stall_rearm_selects_the_federated_grant_and_diverges_with_reason() -> Bool {
  any(census_verdicts(), v =>
    (v.site.decl_name as String) == "belt_exit_stall_rearm_at"
      && selected_federated(s: v.selection)
      && match v.conformance { DivergesWithReason { reason: _ } => true _ => false })
}

// ONE site serves both stalled spools: attempt_unit_stall_release_cli re-arms through the same
// belt_exit_stall_rearm_at, so the selection run for it is this row's (federated scoped grant, diverging under the
// interim reason), and the row's subject names both path units.
test fn the_attempt_unit_stall_release_shares_the_rearm_site_and_its_selection() -> Bool {
  any(census_verdicts(), v =>
    (v.site.decl_name as String) == "belt_exit_stall_rearm_at"
      && selected_federated(s: v.selection))
}

// D3: the deploy route's root may not switch while the job uid is shared with pull request jobs.
test fn the_deploy_route_switch_is_refused_while_the_job_uid_is_shared() -> Bool {
  !deploy_route_switch_admitted(r: srv1_deploy_route_requirement, observed: SharesJobUidWithPullRequestJobs)
    && deploy_route_switch_admitted(r: srv1_deploy_route_requirement, observed: SoleTenantOfJobUid)
}

// ── THE MANUAL-STEP ROWS (node adhoc-28759c44-922), run through the real fold ────────────────
// Each claim reads the row's OWN verdict (site_verdict) and pins the exact reason authority, so
// swapping a row's divergence_reason for another turns the claim red, as does deleting the row or
// editing its characteristics until the selection moves.
fn row_verdicts(key: String) -> List<SiteVerdict> {
  map(filter(privileged_effect_census, row => declaration_ref_display_key(ref: row.site) == key), row => site_verdict(row: row))
}

fn row_diverges_for_exactly(key: String, expected: DivergenceReason, selects_approved: Bool) -> Bool {
  let vs = row_verdicts(key: key)
  (vs |> count) == 1
    && any(vs, v =>
      (if selects_approved { selected_approved(s: v.selection) } else { selected_administrator_edge(s: v.selection) })
        && match v.conformance {
          DivergesWithReason { reason: r } => (r.statement as String) == (expected.statement as String)
          Conforms => false
          Diverges => false
          SiteNotDecidable { standing: _ } => false
        })
}

test fn manual_operator_api_effects_select_the_approval_route_for_the_unlanded_adapter_reason() -> Bool {
  row_diverges_for_exactly(key: "gunbc.secret_provision::gcp_fleet_secrets_wif_binding_intervention", expected: manual_api_effect_beside_unlanded_approval_adapter, selects_approved: true)
    && row_diverges_for_exactly(key: "gunbc.cloudflare.r2_origin::cloudflare_bootstrap_custody_intervention", expected: manual_api_effect_beside_unlanded_approval_adapter, selects_approved: true)
    && row_diverges_for_exactly(key: "gunbc.review_sheet_operator::shared_drive_create_intervention", expected: manual_api_effect_beside_unlanded_approval_adapter, selects_approved: true)
    && row_diverges_for_exactly(key: "gunbc.review_sheet_operator::spreadsheet_create_intervention", expected: manual_api_effect_beside_unlanded_approval_adapter, selects_approved: true)
}

// THE ENVIRONMENT IS ONLY ITS BRANCH RULE NOW (operator, 2026-10-28): the GitHub-gate reason dissolved
// when the required reviewer was removed after the device approval was witnessed approving and denying.
// What remains is a repository-admin setting applied by hand, the manual-API reason.
test fn the_srv1_production_protection_row_selects_the_approval_route_for_the_by_hand_setting_reason() -> Bool {
  row_diverges_for_exactly(key: "gunbc.auth.github_deployment_environment::srv1_production_protection_standing", expected: manual_api_effect_beside_unlanded_approval_adapter, selects_approved: true)
}


// OPERATOR RULING 2026-10-26 (srv1_root_mutation_approval_is_filed_by_the_job): the per-dispatch gate is
// the job's own broker filing, so the row selects the approval capability and CONFORMS -- no reason --
// and the old GitHub-environment site is no longer a census row at all.
test fn the_per_dispatch_srv1_root_mutation_gate_conforms_through_the_broker() -> Bool {
  let vs = row_verdicts(key: "gunbc.fleet.srv1_root_mutation_approval_run::srv1_root_mutation_after_gate")
  (vs |> count) == 1
    && all(vs, v => selected_approved(s: v.selection) && match v.conformance {
      Conforms => true
      DivergesWithReason { reason: _ } => false
      Diverges => false
      SiteNotDecidable { standing: _ } => false
    })
    && (row_verdicts(key: "gunbc.fleet.fleet_converge_workflow::fleet_converge_srv1_root_mutation_environment") |> count) == 0
}

fn host_root_effect_at(f: HumanInterventionFrequency) -> PrivilegedEffect {
  PrivilegedEffect {
    subject: "a root write on a fleet host" as NonEmptyStr, frequency: f, reversibility: ReversibleByReapply,
    surface: ApiSurface, workload_identity: WorkloadIdentityUnbindable { cause: "fixture" as NonEmptyStr },
    minted_reach: MintsHostRootReach, billing: NoBillingConsequence, witness_discharge: NoWitnessDischarge,
  }
}

fn selected_approved_capability(s: AuthorizationPatternSelection) -> Bool {
  match s {
    PatternSelected { pattern: OperatorApprovedCapability, receipt: _ } => true
    _ => false
  }
}

// THE RULING ITSELF, over every frequency a human can attend; EveryProvision keeps the edge (control above).
test fn an_attendable_host_root_effect_selects_the_approval_capability_never_the_edge() -> Bool {
  all([FleetOnce, DeviceOnce, EveryOperatorRequest, BreakGlassOnly], f => selected_approved_capability(s: select_authorization_pattern(e: host_root_effect_at(f: f))))
}

// THE FLEET HOST FILE CONVERGE, run through the real fold. Both of its entries realize the administrator
// edge; because the operator names the host on every dispatch the selection names the approval capability,
// so each row diverges under the stated reason. Filing the effect as EveryProvision would select the edge
// and make the row conform, which this claim refuses, as it refuses a changed realization or a dropped row.
fn row_realizes_the_edge(key: String) -> Bool {
  let rows = filter(privileged_effect_census, row => declaration_ref_display_key(ref: row.site) == key)
  (rows |> count) == 1 && all(rows, row => match row.realized { RealizedAdministratorEdge => true _ => false })
}

test fn the_fleet_host_file_converge_realizes_the_edge_and_selects_the_approval_route() -> Bool {
  row_realizes_the_edge(key: "gunbc.runner.runner_host_file_converge::runner_host_file_converge_ci_wet")
    && row_realizes_the_edge(key: "gunbc.runner.runner_host_file_converge::runner_host_cap_release_ci_wet")
    && row_diverges_for_exactly(key: "gunbc.runner.runner_host_file_converge::runner_host_file_converge_ci_wet", expected: fleet_host_file_converge_edge_beside_the_broker_route, selects_approved: true)
    && row_diverges_for_exactly(key: "gunbc.runner.runner_host_file_converge::runner_host_cap_release_ci_wet", expected: fleet_host_file_converge_edge_beside_the_broker_route, selects_approved: true)
}

fn frequency_name(f: HumanInterventionFrequency) -> String {
  match f {
    FleetOnce => "FleetOnce"
    DeviceOnce => "DeviceOnce"
    EveryProvision => "EveryProvision"
    EveryOperatorRequest => "EveryOperatorRequest"
    BreakGlassOnly => "BreakGlassOnly"
  }
}

fn billing_name(b: BillingConsequence) -> String {
  match b {
    BillsExternally => "BillsExternally"
    NoBillingConsequence => "NoBillingConsequence"
  }
}

// A human-only row conforms ONLY as the exact named step: the selection carries this intervention's
// identity, the effect's surface names the same intervention, and the effect's frequency and billing
// are the stated values (the frequency is read from the intervention, never fixed by the helper).
fn human_row_is(key: String, step: HumanIntervention, frequency: String, billing: String) -> Bool {
  let rows = filter(privileged_effect_census, row => declaration_ref_display_key(ref: row.site) == key)
  (rows |> count) == 1
    && any(rows, row =>
      frequency_name(f: row.effect.frequency) == frequency
        && frequency_name(f: row.effect.frequency) == frequency_name(f: step.frequency)
        && billing_name(b: row.effect.billing) == billing
        && match row.effect.surface {
          HumanSurfaceOnly { step: es } => (es.identity as String) == (step.identity as String)
          ApiSurface => false
        }
        && any(row_verdicts(key: key), v =>
          match v.selection {
            ManualStepRequired { step: s, receipt: _ } => (s.identity as String) == (step.identity as String)
            _ => false
          }
          && match v.conformance { Conforms => true _ => false }))
}

test fn the_cloudflare_account_signup_is_the_named_fleet_once_billed_step() -> Bool {
  human_row_is(key: "gunbc.cloudflare.r2_origin::cloudflare_account_allocation_intervention", step: cloudflare_account_allocation_intervention(), frequency: "FleetOnce", billing: "BillsExternally")
}

test fn the_spark_pxe_console_step_is_the_named_device_once_unbilled_step() -> Bool {
  human_row_is(key: "gunbc.spark.dgx_pxe_boot::spark_pxe_firmware_enablement_intervention", step: spark_pxe_firmware_enablement_intervention(), frequency: "DeviceOnce", billing: "NoBillingConsequence")
}

test fn the_mtcollins_power_cycle_step_conforms_as_a_named_step() -> Bool {
  any(row_verdicts(key: "gunbc.fleet.mtcollins_firmware_converge::mtcollins1_ac_power_cycle_effect"), v =>
    match v.selection { ManualStepRequired { step: s, receipt: _ } => (s.identity as String) == "mtcollins1_ac_power_cycle_after_firmware_step" _ => false }
      && match v.conformance { Conforms => true _ => false })
}
