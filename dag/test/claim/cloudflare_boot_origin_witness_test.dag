  BootReadbackAt,
  BootReadbackRefusedR2Dev,
  BootReadbackRefusedNotHttps,
  BootReadbackRefusedNotAHostName,
  classify_boot_readback,
  BootReadbackServed,
  BootReadbackUnserved,
  BootObjectReadBackConfirmed,
  BootObjectReadBackMismatch,
  BootObjectReadBackUnavailable,
  boot_origin_hostname_standing,
  BootOriginHostnameAllocated,
  BootOriginHostnameUnallocated,
