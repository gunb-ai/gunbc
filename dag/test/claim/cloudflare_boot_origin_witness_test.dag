  fabric_boot_origin_standing,
  fabric_durable_origin_standing,
  R2OriginAllocated,
  R2OriginUnallocated,
  OriginCredentialPinned,
  OriginCredentialUnminted,
  OriginCredentialMintEntryUnbuilt,
  DigestKeyedBootArtifacts,
  bucket_purpose_admission,
  FabricCommitManifestsAndContentAddressedOutputs,
  fabric_boot_origin_read_secret_id,
  fabric_boot_origin_write_secret_id,
  fabric_durable_origin_read_secret_id,
  fabric_durable_origin_write_secret_id,
}
import gunbc.cloudflare.boot_origin {
  BootBundleObject,
  BootPublicationCandidate,
  BootPutAnswer,
  BootPutCreated,
  BootPutKeyOccupied,
  BootPutFailed,
  BootObjectPublished,
  BootObjectAlreadyIdentical,
  BootObjectOccupiedByDifferentBytes,
  BootObjectPublishFailed,
