module test.claim.workspace_checkpoint_instrument

import std.types { String, NonEmptyStr, Int, Bool, List }
import v2.std.optional { Present, Absent }
import std.algebra { Cons, Empty }
import std.measure { byte_size, measure_count, Nanosecond, nanosecond, nanosecond_count }
import std.content_hash { Sha256Digest, sha256_hex_digest }
import std.fabric_blob { FabricBlobAddress }
import std.fabric_storage { FabricObject, fabric_object_ref_of, fabric_object_ref_eq }
import std.checkpointed_workspace {
  WorkspaceWriterEpoch, WorkspaceEntry, WorkspaceHeadEntry, WorkspaceRevision, WorkspaceFence,
  workspace_head_entry_object, workspace_head_entry_decode, workspace_stored_entry_of, WorkspaceStoredEntryAdmitted,
  WorkspaceCommitRevision, workspace_advance_plan, WorkspaceAdvancePlanned,
}
import extdeps.cloudflare.r2 { R2ObjectLocator, R2S3Endpoint, R2JurisdictionDefault }
import extdeps.tools.kopia { kopia_snapshot_summary_of }
import gunbc.secret_provision { fleet_secret_ref }
import gunbc.auth.access_token_source { WorkloadIdentityToken }
import gunbc.fabric_storage_r2_head { R2HeadCredential, r2_head_binding, R2HeadCasNotGrounded }
import gunbc.fabric.workspace_source {
  WorkspaceSourceRoot, workspace_credential_exclusions, workspace_path_exclusion, workspace_source_tally,
  workspace_pack_readback, WorkspacePackClean, WorkspacePackCarriesExcluded,
}
import gunbc.fabric.workspace_checkpoint_instrument {
  workspace_snapshot_capability, WorkspaceSnapshotBtrfs, WorkspaceSnapshotAbsent, WorkspaceSnapshotUnobserved,
  WorkspaceMeasuredPart, PartMeasured, PartUnmeasured, workspace_bound_verdict, BoundHolds, BoundExceeded, BoundUndecided,
  workspace_quota_verdict, QuotaHolds, QuotaExceeded,
  workspace_instrument_commit, InstrumentCommitCasNotGrounded,
  WorkspaceRestoredFile, workspace_restore_compare, RestoreByteEqual, RestoreMissingFile, RestoreExtraFile, RestoreBytesDiffer, RestoreCarriesUncommittedChunk,
}

// Every claim supplies its inputs at the interface it discriminates (DESIGN 3: a witness
// discriminates at one interface). The real-path pairing -- a committed barrier restored byte-equal
// from the head's closure -- is the dispatched stage-1 entry workspace_checkpoint_restore_wet, which
// refuses until the R2 head's CAS ground is cited; the gate's refusal is claimed below.

fn digest(c: String) -> Sha256Digest {
  match sha256_hex_digest(hex: join([c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c], "")) {
    Present { value: d } => d
    Absent => digest(c: "0")
  }
}

fn ms(n: Int) -> Nanosecond {
  nanosecond(count: n * 1000000)
}

fn address(c: String) -> FabricBlobAddress {
  FabricBlobAddress { key: digest(c: c) }
}

fn entry(path: String, c: String) -> WorkspaceEntry {
  WorkspaceEntry { path: path as NonEmptyStr, chunk: address(c: c), size: byte_size(count: 3) }
}

// ── SNAPSHOT CAPABILITY ────────────────────────────────────────────────────────────────────────

test fn btrfs_is_the_realized_snapshot_capability() -> Bool {
  match workspace_snapshot_capability(parent: "/home/runner/w", observed: true, type_word: "btrfs\n") {
    WorkspaceSnapshotBtrfs { parent: p } => (p as String) == "/home/runner/w"
    WorkspaceSnapshotAbsent { parent: _, filesystem_type: _ } => false
    WorkspaceSnapshotUnobserved { parent: _, detail: _ } => false
  }
}

test fn a_filesystem_without_snapshots_is_refused_naming_its_type() -> Bool {
  match workspace_snapshot_capability(parent: "/home/runner/w", observed: true, type_word: "ext2/ext3") {
    WorkspaceSnapshotAbsent { parent: _, filesystem_type: t } => t == "ext2/ext3"
    WorkspaceSnapshotBtrfs { parent: _ } => false
    WorkspaceSnapshotUnobserved { parent: _, detail: _ } => false
  }
}

test fn an_unread_filesystem_is_unobserved_never_btrfs() -> Bool {
  match workspace_snapshot_capability(parent: "/home/runner/w", observed: false, type_word: "btrfs") {
    WorkspaceSnapshotUnobserved { parent: _, detail: _ } => true
    WorkspaceSnapshotBtrfs { parent: _ } => false
    WorkspaceSnapshotAbsent { parent: _, filesystem_type: _ } => false
  }
}

// ── THE CREDENTIAL EXCLUSION ───────────────────────────────────────────────────────────────────

fn excluded_by(path: String) -> String {
  match workspace_path_exclusion(exclusions: workspace_credential_exclusions, path: path) {
    Present { value: x } => x.spelling as String
    Absent => ""
  }
}

test fn the_session_credentials_file_is_refused() -> Bool {
  excluded_by(path: "session-home/.claude/.credentials.json") == "~/.claude/.credentials.json"
}

test fn every_listed_credential_shape_is_refused() -> Bool {
  excluded_by(path: "home/u/.netrc") == ".netrc"
    && excluded_by(path: "home/u/gh_token.txt") == "*token*"
    && excluded_by(path: "home/u/tls/server.pem") == "*.pem"
    && excluded_by(path: "home/u/tls/server.key") == "*.key"
    && excluded_by(path: "home/u/keys/id_ed25519") == "id_*"
    && excluded_by(path: "home/u/.config/gh/hosts.yml") == ".config/gh"
    && excluded_by(path: "home/u/.ssh/known_hosts") == ".ssh"
    && excluded_by(path: "home/u/.gnupg/pubring.kbx") == ".gnupg"
    && excluded_by(path: "home/u/.aws/config") == ".aws"
    && excluded_by(path: "home/u/.config/gcloud/configurations/config_default") == ".config/gcloud"
    && excluded_by(path: "home/u/repo/.env") == ".env"
    && excluded_by(path: "home/u/repo/.env.local") == ".env.*"
    && excluded_by(path: "home/u/repo/service_credentials.json") == "*credentials*"
}

test fn ordinary_workspace_paths_are_not_excluded() -> Bool {
  excluded_by(path: "home/briansrls/gunbc/dag/std/fabric_blob.dag") == ""
    && excluded_by(path: "home/u/.configx/gh/hosts.yml") == ""
    && excluded_by(path: "home/u/repo/environment.dag") == ""
    && excluded_by(path: "home/u/repo/keyboard.md") == ""
}

data tally_root: WorkspaceSourceRoot = WorkspaceSourceRoot { label: "clone", path: "/home/u/gunbc", build_output: ["target/"] }

test fn the_tally_admits_only_unexcluded_non_build_files() -> Bool {
  let listing = join([
    "f\t644\tREADME.md\t",
    "l\t777\tlatest\tREADME.md",
    "f\t600\t.env\t",
    "f\t644\ttarget/release/gunbc\t",
    "f\t600\tkeys/id_rsa\t",
  ], "\n")
  let t = workspace_source_tally(root: tally_root, exclusions: workspace_credential_exclusions, listing: listing)
  let members = map(t.members, m => m as String)
  members == ["home/u/gunbc/README.md", "home/u/gunbc/latest"] && t.files == 1 && t.symlinks == 1 && t.excluded == 2 && t.build_output == 1 && t.unparsed == []
}

// THE PACK READBACK'S RED: an archive that carries a credential refuses the upload, whatever list
// built it.
test fn an_archive_carrying_a_credential_refuses_the_upload() -> Bool {
  match workspace_pack_readback(exclusions: workspace_credential_exclusions, archive_listing: "home/u/gunbc/README.md\nsession-home/.claude/.credentials.json\n") {
    WorkspacePackCarriesExcluded { member: m, by: x } => (m as String) == "session-home/.claude/.credentials.json" && (x.spelling as String) == "~/.claude/.credentials.json"
    WorkspacePackClean { members: _ } => false
  }
}

test fn a_clean_archive_reads_back_its_member_count() -> Bool {
  match workspace_pack_readback(exclusions: workspace_credential_exclusions, archive_listing: "home/u/gunbc/README.md\nhome/u/gunbc/src/a.rs\n") {
    WorkspacePackClean { members: n } => n == 2
    WorkspacePackCarriesExcluded { member: _, by: _ } => false
  }
}

// ── VERDICTS ───────────────────────────────────────────────────────────────────────────────────

test fn every_part_measured_under_the_bound_holds() -> Bool {
  match workspace_bound_verdict(parts: [PartMeasured { label: "snapshot", elapsed: ms(n: 40) }, PartMeasured { label: "upload", elapsed: ms(n: 9000) }, PartMeasured { label: "commit", elapsed: ms(n: 200) }], bound: ms(n: 10000)) {
    BoundHolds { total: t, bound: b } => nanosecond_count(n: t) == 9240000000 && nanosecond_count(n: b) == 10000000000
    BoundExceeded { at_least: _, bound: _, complete: _ } => false
    BoundUndecided { measured: _, bound: _, missing: _ } => false
  }
}

test fn a_missing_part_leaves_a_fitting_sum_undecided() -> Bool {
  match workspace_bound_verdict(parts: [PartMeasured { label: "snapshot", elapsed: ms(n: 40) }, PartUnmeasured { label: "commit", reason: "cas not grounded" }], bound: ms(n: 10000)) {
    BoundUndecided { measured: m, bound: _, missing: missing } => nanosecond_count(n: m) == 40000000 && missing == ["commit: cas not grounded"]
    BoundHolds { total: _, bound: _ } => false
    BoundExceeded { at_least: _, bound: _, complete: _ } => false
  }
}

test fn measured_parts_over_the_bound_exceed_it_whatever_is_missing() -> Bool {
  match workspace_bound_verdict(parts: [PartMeasured { label: "upload", elapsed: ms(n: 70000) }, PartUnmeasured { label: "commit", reason: "cas not grounded" }], bound: ms(n: 60000)) {
    BoundExceeded { at_least: m, bound: b, complete: c } => nanosecond_count(n: m) == 70000000000 && nanosecond_count(n: b) == 60000000000 && !c
    BoundHolds { total: _, bound: _ } => false
    BoundUndecided { measured: _, bound: _, missing: _ } => false
  }
}

test fn the_quota_verdict_compares_bytes_to_the_quota() -> Bool {
  let under = match workspace_quota_verdict(size: byte_size(count: 1600000000), quota: byte_size(count: 10000000000)) { QuotaHolds { size: _, quota: _ } => true  QuotaExceeded { size: _, quota: _ } => false }
  let over = match workspace_quota_verdict(size: byte_size(count: 10000000001), quota: byte_size(count: 10000000000)) { QuotaExceeded { size: _, quota: _ } => true  QuotaHolds { size: _, quota: _ } => false }
  under && over
}

// ── THE COMMIT GATE ────────────────────────────────────────────────────────────────────────────

// WHILE THE HEAD'S CAS GROUND IS A BET, THE COMMIT REFUSES WITH ITS READ OBLIGATION AND MOVES
// NOTHING: the binding names no reachable store, so any put or advance would not return this arm.
test fn an_ungrounded_cas_refuses_the_commit_with_its_read_obligation() -> Bool {
  let writer = WorkspaceWriterEpoch { workspace: "w", epoch: 1 }
  let loc = R2ObjectLocator { endpoint: R2S3Endpoint { account_id: "acct", jurisdiction: R2JurisdictionDefault }, bucket_name: "gunbai-fabric-workspace", key: "heads/workspace.w.committed" }
  let binding = r2_head_binding(locator: loc,
    read: R2HeadCredential { access_key_id: "read-key", token_value: fleet_secret_ref(secret_id: "cloudflare-r2-workspace-read-token") },
    write: R2HeadCredential { access_key_id: "write-key", token_value: fleet_secret_ref(secret_id: "cloudflare-r2-workspace-write-token") })
  match workspace_advance_plan(writer: writer, change: WorkspaceCommitRevision { entries: [entry(path: "a", c: "a")] }, built_on: none) {
    WorkspaceAdvancePlanned { plan: plan } =>
      match workspace_instrument_commit(admission: R2HeadCasNotGrounded { read_obligation: "race two If-Match puts on one tag" }, plan: plan, binding: binding, token_source: WorkloadIdentityToken) {
        InstrumentCommitCasNotGrounded { read_obligation: o } => (o as String) == "race two If-Match puts on one tag"
        other => false
      }
    other => false
  }
}

// ── RESTORE ────────────────────────────────────────────────────────────────────────────────────

fn restored(path: String, c: String) -> WorkspaceRestoredFile {
  WorkspaceRestoredFile { path: path as NonEmptyStr, digest: digest(c: c) }
}

data barrier_entries: List<WorkspaceEntry> = [entry(path: "README.md", c: "a"), entry(path: "src/a.txt", c: "b")]

test fn an_identical_tree_restores_byte_equal() -> Bool {
  match workspace_restore_compare(barrier: barrier_entries, restored: [restored(path: "src/a.txt", c: "b"), restored(path: "README.md", c: "a")], uncommitted: address(c: "f")) {
    RestoreByteEqual { files: n } => n == 2
    other => false
  }
}

test fn a_missing_extra_or_changed_file_is_its_own_refusal() -> Bool {
  let missing = match workspace_restore_compare(barrier: barrier_entries, restored: [restored(path: "README.md", c: "a")], uncommitted: address(c: "f")) { RestoreMissingFile { path: p } => (p as String) == "src/a.txt"  other => false }
  let extra = match workspace_restore_compare(barrier: barrier_entries, restored: [restored(path: "README.md", c: "a"), restored(path: "src/a.txt", c: "b"), restored(path: "stray", c: "c")], uncommitted: address(c: "f")) { RestoreExtraFile { path: p } => (p as String) == "stray"  other => false }
  let changed = match workspace_restore_compare(barrier: barrier_entries, restored: [restored(path: "README.md", c: "c"), restored(path: "src/a.txt", c: "b")], uncommitted: address(c: "f")) { RestoreBytesDiffer { path: p } => (p as String) == "README.md"  other => false }
  missing && extra && changed
}

test fn a_restored_file_holding_the_uncommitted_chunk_refuses() -> Bool {
  match workspace_restore_compare(barrier: barrier_entries, restored: [restored(path: "README.md", c: "a"), restored(path: "src/a.txt", c: "f")], uncommitted: address(c: "f")) {
    RestoreCarriesUncommittedChunk { path: p } => (p as String) == "src/a.txt"
    other => false
  }
}

// ── THE HEAD ENTRY DECODER (std.checkpointed_workspace) ────────────────────────────────────────

fn round_trips(e: WorkspaceHeadEntry) -> Bool {
  let object = workspace_head_entry_object(entry: e)
  match workspace_head_entry_decode(object: object) {
    Absent => false
    Present { value: d } =>
      fabric_object_ref_eq(a: fabric_object_ref_of(object: workspace_head_entry_object(entry: d)), b: fabric_object_ref_of(object: object))
        && match workspace_stored_entry_of(asked: fabric_object_ref_of(object: object), content: object, decoded: d) { WorkspaceStoredEntryAdmitted { stored: _ } => true  other => false }
  }
}

test fn a_revision_and_a_fence_decode_to_what_they_encode() -> Bool {
  let w = WorkspaceWriterEpoch { workspace: "ops", epoch: 3 }
  let first = WorkspaceRevision { writer: w, parent: none, entries: [entry(path: "a dir/with; odd:name", c: "a"), entry(path: "b", c: "b")] }
  let parent = fabric_object_ref_of(object: workspace_head_entry_object(entry: first))
  round_trips(e: first)
    && round_trips(e: WorkspaceRevision { writer: w, parent: Present { value: parent }, entries: [] })
    && round_trips(e: WorkspaceFence { writer: WorkspaceWriterEpoch { workspace: "ops", epoch: 4 }, parent: Present { value: parent } })
}

test fn a_body_that_is_not_a_head_entry_does_not_decode() -> Bool {
  let wrong_kind = workspace_head_entry_decode(object: FabricObject { links: [], body: "workspace.other;W3:ops;epoch=1;" })
  let truncated = workspace_head_entry_decode(object: FabricObject { links: [], body: "workspace.revision;W3:ops;epoch=1;F5:ab" })
  match wrong_kind { Absent => true  Present { value: _ } => false } && match truncated { Absent => true  Present { value: _ } => false }
}

// ── THE KOPIA MANIFEST SUMMARY ─────────────────────────────────────────────────────────────────

// The manifest is the one kopia 0.23.1 printed for a one-file, three-byte source (extdeps.tools.kopia
// names the run); only rootEntry.summ is read.
test fn the_kopia_manifest_summary_reads_files_and_bytes() -> Bool {
  let manifest = "{\"id\":\"d2eb\",\"rootEntry\":{\"name\":\"src\",\"type\":\"d\",\"obj\":\"kafe\",\"summ\":{\"size\":3,\"files\":1,\"symlinks\":0,\"dirs\":1,\"numFailed\":0}}}"
  let read = match kopia_snapshot_summary_of(manifest: manifest) { Present { value: s } => s.files == 1 && measure_count(m: s.bytes) == 3  Absent => false }
  let unread = match kopia_snapshot_summary_of(manifest: "{\"id\":\"d2eb\"}") { Absent => true  Present { value: _ } => false }
  read && unread
}
