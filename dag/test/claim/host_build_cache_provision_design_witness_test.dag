module test.claim.host_build_cache_provision_design

data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

test fn design_witness_read_back_fails_closed_in_shell() -> Bool {
  build_cache_provision_read_back_fails_closed()
}

test fn design_witness_unknown_catalog_refuses_at_gate() -> Bool {
  match provision_build_cache_catalog_gate_verdict(
    catalog_id: provision_build_cache_unknown_catalog_fixture,
  ) {
    ProvisionBuildCacheCatalogRefused { reason: _ } => true
    ProvisionBuildCacheCatalogRealizable => false
  }
}

test fn design_witness_known_non_sccache_catalog_refuses_at_gate() -> Bool {
  match provision_build_cache_catalog_gate_verdict(catalog_id: extdeps.cache.github_actions.gha_actions_cache_id) {
    ProvisionBuildCacheCatalogRefused { reason: reason } =>
      string_contains(s: reason as String, pattern: "not yet realized")
    ProvisionBuildCacheCatalogRealizable => false
  }
}

test fn design_witness_known_non_sccache_catalog_refuses_at_verdict() -> Bool {
  match provision_build_cache_verdict(
    catalog_id: extdeps.cache.github_actions.gha_actions_cache_id,
    observed: gunbc.build_cache_provision_verdict.DaemonStatsOk {
      stats_line: "compile_requests=1",
      placement: gunbc.build_cache_instance.ServerManagedUnitOwned { unit: managed_compile_pool_slice_fixture },
    },
  ) {
    BuildCacheProvisionRefused { cause: RefusalCatalogUnknown, reason: reason } =>
      string_contains(s: reason as String, pattern: "not yet realized")
    BuildCacheProvisionConverged { catalog_id: _, stats_line: _ } => false
  }
}

test fn design_witness_sccache_catalog_passes_gate() -> Bool {
  match provision_build_cache_catalog_gate_verdict(catalog_id: sccache_local_id) {
    ProvisionBuildCacheCatalogRealizable => true
    ProvisionBuildCacheCatalogRefused { reason: _ } => false
  }
}

