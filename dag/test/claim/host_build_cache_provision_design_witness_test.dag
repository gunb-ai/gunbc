test fn design_witness_converged_not_refused_on_ok_stats() -> Bool {
  match provision_build_cache_verdict(
    catalog_id: sccache_local_id,
    observed: gunbc.build_cache_provision_verdict.DaemonStatsOk {
      stats_line: "compile_requests=42",
      placement: gunbc.build_cache_instance.ServerManagedUnitOwned { unit: managed_compile_pool_slice_fixture },
    },
  ) {
    BuildCacheProvisionConverged { catalog_id: id, stats_line: _ } => id == sccache_local_id
    BuildCacheProvisionRefused { cause: _, reason: _ } => false
