module test.claim.host_build_cache_provision_design


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn design_witness_read_back_fails_closed_in_shell() -> Bool {
  build_cache_provision_read_back_fails_closed()
}

fn design_witness_unknown_catalog_refuses_at_gate() -> Bool {
  match provision_build_cache_catalog_gate_verdict(
    catalog_id: provision_build_cache_unknown_catalog_fixture,
  ) {
    ProvisionBuildCacheCatalogRefused { reason: _ } => true
    ProvisionBuildCacheCatalogRealizable => false
  }
}

fn design_witness_known_non_sccache_catalog_refuses_at_gate() -> Bool {
  match provision_build_cache_catalog_gate_verdict(catalog_id: gha_actions_cache_id) {
    ProvisionBuildCacheCatalogRefused { reason: reason } =>
      string_contains(s: reason as String, pattern: "not yet realized")
    ProvisionBuildCacheCatalogRealizable => false
  }
}

fn design_witness_known_non_sccache_catalog_refuses_at_verdict() -> Bool {
  match provision_build_cache_verdict(
    catalog_id: gha_actions_cache_id,
    observed: DaemonStatsOk {
      stats_line: "compile_requests=1",
      placement: ServerUnitOwned { slice_unit: managed_compile_pool_slice_fixture },
    },
  ) {
    ProvisionRefused { cause: RefusalCatalogUnknown, reason: reason } =>
      string_contains(s: reason as String, pattern: "not yet realized")
    ProvisionConverged { catalog_id: _, stats_line: _ } => false
  }
}

fn design_witness_sccache_catalog_passes_gate() -> Bool {
  match provision_build_cache_catalog_gate_verdict(catalog_id: sccache_local_id) {
    ProvisionBuildCacheCatalogRealizable => true
    ProvisionBuildCacheCatalogRefused { reason: _ } => false
  }
}

fn design_witness_routes_through_host_effect_apply() -> Bool {
  provision_build_cache_routes_through_host_effect_apply()
}

fn design_witness_default_effect_pins_sccache_catalog() -> Bool {
  match provision_build_cache_default_effect() {
    ProvisionBuildCache { catalog_id: id } => id == sccache_local_id
    _ => false
  }
}

fn design_witness_absent_daemon_fail_closed() -> Bool {
  daemon_absent_refuses_fail_closed()
}

fn design_witness_authority_gate_accepts_absent_refusal() -> Bool {
  build_cache_provision_gate_accepts(
    verdict: provision_build_cache_verdict(
      catalog_id: sccache_local_id,
      observed: DaemonAbsent,
    ),
    observed: DaemonAbsent,
  )
}

fn design_witness_cited_fatal_error_fragment() -> Bool {
  misconfigured_matches_cited_fragment()
}

fn design_witness_converged_not_refused_on_ok_stats() -> Bool {
  match provision_build_cache_verdict(
    catalog_id: sccache_local_id,
    observed: DaemonStatsOk {
      stats_line: "compile_requests=42",
      placement: ServerUnitOwned { slice_unit: managed_compile_pool_slice_fixture },
    },
  ) {
    ProvisionConverged { catalog_id: id, stats_line: _ } => id == sccache_local_id
    ProvisionRefused { cause: _, reason: _ } => false
  }
}

fn design_witness_stats_ok_lazy_spawned_refuses() -> Bool {
  stats_ok_lazy_spawned_refuses()
}

fn design_witness_stats_ok_placement_unknown_refuses() -> Bool {
  stats_ok_placement_unknown_refuses()
}

fn design_witness_stats_ok_unit_owned_converges() -> Bool {
  stats_ok_unit_owned_converges()
}

fn witness_widen_sketch_fabricates_converged_on_lazy_spawned() -> Bool {
  match provision_build_cache_absorbing_fallback_widen_sketch(
    catalog_id: sccache_local_id,
    observed: DaemonStatsOk {
      stats_line: "compile_requests=42",
      placement: ServerLazySpawned { observed_cgroup: srv1_stranded_server_cgroup_fixture },
    },
  ) {
    ProvisionConverged { catalog_id: _, stats_line: _ } => true
    ProvisionRefused { cause: _, reason: _ } => false
  }
}

fn witness_red_control_widen_on_lazy_spawned_rejected_by_gate() -> Bool {
  witness_widen_sketch_fabricates_converged_on_lazy_spawned()
    && !build_cache_provision_gate_accepts(
      verdict: provision_build_cache_absorbing_fallback_widen_sketch(
        catalog_id: sccache_local_id,
        observed: DaemonStatsOk {
          stats_line: "compile_requests=42",
          placement: ServerLazySpawned { observed_cgroup: srv1_stranded_server_cgroup_fixture },
        },
      ),
      observed: DaemonStatsOk {
        stats_line: "compile_requests=42",
        placement: ServerLazySpawned { observed_cgroup: srv1_stranded_server_cgroup_fixture },
      },
    )
    && build_cache_provision_gate_accepts(
      verdict: provision_build_cache_verdict(
        catalog_id: sccache_local_id,
        observed: DaemonStatsOk {
          stats_line: "compile_requests=42",
          placement: ServerLazySpawned { observed_cgroup: srv1_stranded_server_cgroup_fixture },
        },
      ),
      observed: DaemonStatsOk {
        stats_line: "compile_requests=42",
        placement: ServerLazySpawned { observed_cgroup: srv1_stranded_server_cgroup_fixture },
      },
    )
}

fn witness_widen_sketch_fabricates_converged_on_absent() -> Bool {
  match provision_build_cache_absorbing_fallback_widen_sketch(
    catalog_id: sccache_local_id,
    observed: DaemonAbsent,
  ) {
    ProvisionConverged { catalog_id: _, stats_line: _ } => true
    ProvisionRefused { cause: _, reason: _ } => false
  }
}

fn witness_red_control_widen_on_absent_rejected_by_gate() -> Bool {
  witness_widen_sketch_fabricates_converged_on_absent()
    && !build_cache_provision_gate_accepts(
      verdict: provision_build_cache_absorbing_fallback_widen_sketch(
        catalog_id: sccache_local_id,
        observed: DaemonAbsent,
      ),
      observed: DaemonAbsent,
    )
    && design_witness_authority_gate_accepts_absent_refusal()
}

test fn host_build_cache_provision_design_witnesses() -> Bool {
  design_witness_read_back_fails_closed_in_shell()
    && design_witness_unknown_catalog_refuses_at_gate()
    && design_witness_known_non_sccache_catalog_refuses_at_gate()
    && design_witness_known_non_sccache_catalog_refuses_at_verdict()
    && design_witness_sccache_catalog_passes_gate()
    && design_witness_routes_through_host_effect_apply()
    && design_witness_default_effect_pins_sccache_catalog()
    && design_witness_absent_daemon_fail_closed()
    && design_witness_authority_gate_accepts_absent_refusal()
    && design_witness_cited_fatal_error_fragment()
    && design_witness_converged_not_refused_on_ok_stats()
    && witness_red_control_widen_on_absent_rejected_by_gate()
    && design_witness_stats_ok_lazy_spawned_refuses()
    && design_witness_stats_ok_placement_unknown_refuses()
    && design_witness_stats_ok_unit_owned_converges()
    && witness_red_control_widen_on_lazy_spawned_rejected_by_gate()
}
