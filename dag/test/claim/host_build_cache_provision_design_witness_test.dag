  provision_build_cache_routes_through_host_effect_apply()
}

test fn design_witness_default_effect_pins_sccache_catalog() -> Bool {
  match provision_build_cache_default_effect(host: "srv1") {
    EnsureBuildCacheInstance { desired: instance } => instance.implementation == sccache_local_id
    _ => false
  }
}

test fn design_witness_absent_daemon_fail_closed() -> Bool {
  daemon_absent_refuses_fail_closed()
