}

test fn design_witness_stats_ok_lazy_spawned_refuses() -> Bool {
  stats_ok_lazy_spawned_refuses()
}

test fn design_witness_stats_ok_active_slot_runner_owned_refuses() -> Bool {
  match provision_build_cache_verdict(
    catalog_id: sccache_local_id,
    observed: gunbc.build_cache_provision_verdict.DaemonStatsOk {
      stats_line: "compile_requests=42",
      placement: gunbc.build_cache_instance.ServerRunnerOwned {
        slot: gunbc.build_cache_instance.RunnerSlotIdentity { host: "srv1", slot_index: 2 },
        lifecycle: DesiredRunnerSlot,
      },
    },
  ) {
    BuildCacheProvisionRefused { cause: RefusalServerRunnerOwned, reason: _ } => true
    BuildCacheProvisionRefused { cause: _, reason: _ } => false
    BuildCacheProvisionConverged { catalog_id: _, stats_line: _ } => false
  }
}

