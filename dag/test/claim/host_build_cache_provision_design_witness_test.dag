}

fn witness_widen_sketch_fabricates_converged_on_lazy_spawned() -> Bool {
  match provision_build_cache_absorbing_fallback_widen_sketch(
    catalog_id: sccache_local_id,
    observed: gunbc.build_cache_provision_verdict.DaemonStatsOk {
      stats_line: "compile_requests=42",
      placement: gunbc.build_cache_instance.ServerRunnerOwned { slot: gunbc.build_cache_instance.RunnerSlotIdentity { host: "srv1", slot_index: 10 }, lifecycle: RetiredRunnerSlot },
    },
  ) {
    BuildCacheProvisionConverged { catalog_id: _, stats_line: _ } => true
    BuildCacheProvisionRefused { cause: _, reason: _ } => false
  }
}

test fn witness_red_control_widen_on_lazy_spawned_rejected_by_gate() -> Bool {
  witness_widen_sketch_fabricates_converged_on_lazy_spawned()
    && !build_cache_provision_gate_accepts(
      catalog_id: sccache_local_id,
      verdict: provision_build_cache_absorbing_fallback_widen_sketch(
        catalog_id: sccache_local_id,
        observed: gunbc.build_cache_provision_verdict.DaemonStatsOk {
          stats_line: "compile_requests=42",
          placement: gunbc.build_cache_instance.ServerRunnerOwned { slot: gunbc.build_cache_instance.RunnerSlotIdentity { host: "srv1", slot_index: 10 }, lifecycle: RetiredRunnerSlot },
        },
      ),
      observed: gunbc.build_cache_provision_verdict.DaemonStatsOk {
        stats_line: "compile_requests=42",
        placement: gunbc.build_cache_instance.ServerRunnerOwned { slot: gunbc.build_cache_instance.RunnerSlotIdentity { host: "srv1", slot_index: 10 }, lifecycle: RetiredRunnerSlot },
      },
    )
    && build_cache_provision_gate_accepts(
      catalog_id: sccache_local_id,
      verdict: provision_build_cache_verdict(
        catalog_id: sccache_local_id,
        observed: gunbc.build_cache_provision_verdict.DaemonStatsOk {
          stats_line: "compile_requests=42",
          placement: gunbc.build_cache_instance.ServerRunnerOwned { slot: gunbc.build_cache_instance.RunnerSlotIdentity { host: "srv1", slot_index: 10 }, lifecycle: RetiredRunnerSlot },
        },
      ),
      observed: gunbc.build_cache_provision_verdict.DaemonStatsOk {
        stats_line: "compile_requests=42",
        placement: gunbc.build_cache_instance.ServerRunnerOwned { slot: gunbc.build_cache_instance.RunnerSlotIdentity { host: "srv1", slot_index: 10 }, lifecycle: RetiredRunnerSlot },
      },
    )
}

fn witness_widen_sketch_fabricates_converged_on_absent() -> Bool {
  match provision_build_cache_absorbing_fallback_widen_sketch(
    catalog_id: sccache_local_id,
    observed: DaemonAbsent,
  ) {
    BuildCacheProvisionConverged { catalog_id: _, stats_line: _ } => true
    BuildCacheProvisionRefused { cause: _, reason: _ } => false
  }
}

test fn witness_red_control_widen_on_absent_rejected_by_gate() -> Bool {
  witness_widen_sketch_fabricates_converged_on_absent()
    && !build_cache_provision_gate_accepts(
      catalog_id: sccache_local_id,
      verdict: provision_build_cache_absorbing_fallback_widen_sketch(
        catalog_id: sccache_local_id,
        observed: DaemonAbsent,
      ),
      observed: DaemonAbsent,
    )
    && design_witness_authority_gate_accepts_absent_refusal()
}

fn path_shadow_observation_fixture() -> gunbc.build_cache_provision_verdict.BuildCacheDaemonObservation {
  gunbc.build_cache_provision_verdict.DaemonPathShadowed { resolved: "/usr/bin/sccache", expected: "/usr/local/bin/sccache" }
}

test fn design_witness_path_shadow_refuses_fail_closed() -> Bool {
  match provision_build_cache_verdict(
    catalog_id: sccache_local_id,
    observed: path_shadow_observation_fixture(),
  ) {
    BuildCacheProvisionRefused { cause: RefusalPathShadowed, reason: reason } =>
      string_contains(s: reason as String, pattern: "/usr/bin/sccache")
        && string_contains(s: reason as String, pattern: "/usr/local/bin/sccache")
        && string_contains(s: reason as String, pattern: "Fail-closed")
    BuildCacheProvisionRefused { cause: _, reason: _ } => false
    BuildCacheProvisionConverged { catalog_id: _, stats_line: _ } => false
  }
}

test fn design_witness_red_control_widen_on_path_shadow_rejected_by_gate() -> Bool {
  match provision_build_cache_absorbing_fallback_widen_sketch(
    catalog_id: sccache_local_id,
    observed: path_shadow_observation_fixture(),
  ) {
    BuildCacheProvisionConverged { catalog_id: _, stats_line: _ } => true
    BuildCacheProvisionRefused { cause: _, reason: _ } => false
  } && !build_cache_provision_gate_accepts(
      catalog_id: sccache_local_id,
      verdict: provision_build_cache_absorbing_fallback_widen_sketch(
        catalog_id: sccache_local_id,
        observed: path_shadow_observation_fixture(),
      ),
      observed: path_shadow_observation_fixture(),
    )
    && build_cache_provision_gate_accepts(
      catalog_id: sccache_local_id,
      verdict: provision_build_cache_verdict(
        catalog_id: sccache_local_id,
        observed: path_shadow_observation_fixture(),
      ),
      observed: path_shadow_observation_fixture(),
    )
}

test fn design_witness_path_authority_observation_not_emitted_as_shell() -> Bool {
  !string_contains(
    s: build_cache_observe_stats_body(),
    pattern: "path_authority=SHADOWED",
  ) && !string_contains(
    s: build_cache_read_back_body(binary: sccache_installed_binary_path),
    pattern: "path_authority=SHADOWED",
  ) && !string_contains(
    s: build_cache_provision_script_body(
      instance: ci_cache_instance(host: "srv1"),
      arch_token: "aarch64" as std.types.NonEmptyStr,
      digest: sccache_release_0_15_0.digest_aarch64,
    ),
    pattern: "command -v sccache",
  )
}

test fn design_witness_install_is_cited_not_package_manager() -> Bool {
  build_cache_install_is_cited_not_package_manager()
}

data build_cache_unit_construction_checks_superseded_note: String = "The unit-body-specific construction checks formerly here (execstart-matches-install-path, foreground-supervised, daemon-runs-until-stopped, plus the RED-control unit_self_exiting_sketch fixture reproducing #7206's self-exiting unit) are DROPPED, not relocated, per the A5 grain swap (ProvisionBuildCache -> EnsureBuildCacheInstance): they asserted properties of gunbc.host_build_cache_provision_script's hand-rolled build_cache_systemd_user_unit_body, which no longer exists. The same properties are now independently regression-tested against the real render, gunbc.build_cache_unit render_build_cache_unit, in test.claim.build_cache_ensure (witness_the_rendered_unit_is_foreground_supervised, witness_the_generated_unit_reproduces_the_captured_environment) — asserted against a live srv1 capture (2026-08-01) rather than a hand-authored sketch, which is a stronger oracle than this file's own string-matching RED control ever was. The incident history (#7206, srv3 2026-07-25, Duration 10min 8.215s status 0) is preserved in gunbc.build_cache_unit's own foreground_supervision_note, not duplicated here a second time."

fn unsupervised_observation_fixture() -> gunbc.build_cache_provision_verdict.BuildCacheDaemonObservation {
  gunbc.build_cache_provision_verdict.DaemonUnsupervised { unit: "sccache.service", unit_state: "inactive (dead)" }
}

test fn design_witness_unsupervised_refuses_fail_closed() -> Bool {
  match provision_build_cache_verdict(
    catalog_id: sccache_local_id,
    observed: unsupervised_observation_fixture(),
  ) {
    BuildCacheProvisionRefused { cause: RefusalDaemonUnsupervised, reason: reason } =>
      string_contains(s: reason as String, pattern: "sccache.service")
        && string_contains(s: reason as String, pattern: "inactive (dead)")
        && string_contains(s: reason as String, pattern: "Fail-closed")
    BuildCacheProvisionRefused { cause: _, reason: _ } => false
    BuildCacheProvisionConverged { catalog_id: _, stats_line: _ } => false
  }
}

test fn design_witness_red_control_widen_on_unsupervised_rejected_by_gate() -> Bool {
  match provision_build_cache_absorbing_fallback_widen_sketch(
    catalog_id: sccache_local_id,
    observed: unsupervised_observation_fixture(),
  ) {
    BuildCacheProvisionConverged { catalog_id: _, stats_line: _ } => true
    BuildCacheProvisionRefused { cause: _, reason: _ } => false
  } && !build_cache_provision_gate_accepts(
      catalog_id: sccache_local_id,
      verdict: provision_build_cache_absorbing_fallback_widen_sketch(
        catalog_id: sccache_local_id,
        observed: unsupervised_observation_fixture(),
      ),
      observed: unsupervised_observation_fixture(),
    )
    && build_cache_provision_gate_accepts(
      catalog_id: sccache_local_id,
      verdict: provision_build_cache_verdict(
        catalog_id: sccache_local_id,
        observed: unsupervised_observation_fixture(),
      ),
      observed: unsupervised_observation_fixture(),
    )
}

