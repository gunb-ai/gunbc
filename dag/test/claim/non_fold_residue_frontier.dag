module test.claim.non_fold_residue_frontier

import std.types { NonEmptyStr }
import gunbc.non_fold_residue {
  non_fold_residue_frontier,
  nfr_reason_variant_test_predicate,
  nfr_dissolve_derived_variant_test,
}
import std.roster_frontier {
  FrontierRow,
  PathSubject,
  frontier_row_well_formed,
  frontier_rows_well_formed,
  frontier_rows_keyed_roster_build,
}
import std.dissolution { DissolutionCondition, unbound_dissolution }
import std.keyed_roster { KeyedRosterBuilt, KeyedRosterBuildDuplicateKey }

// GREEN: the observing-layer exception list (`gunbc.non_fold_residue` `non_fold_residue_frontier`)
// is well-formed and constructs as a keyed roster. Co-located subject lists join through the
// seed walk `nfr_live_union_is_populated_unique_and_tripled`. RED controls: a synthetic row
// with an empty trigger fails well-formedness; a synthetic duplicate path key yields
// KeyedRosterBuildDuplicateKey (DESIGN 4b(4): production machinery dissolves on a climb, the
// evidence stays enrolled).

test fn non_fold_residue_frontier_rows_well_formed_holds() -> Bool {
  frontier_rows_well_formed(rows: non_fold_residue_frontier)
}

test fn non_fold_residue_frontier_keyed_roster_build_admits() -> Bool {
  match frontier_rows_keyed_roster_build(rows: non_fold_residue_frontier) {
    KeyedRosterBuilt { rows: _ } => true
    KeyedRosterBuildDuplicateKey { key: _, first: _, duplicate: _ } => false
  }
}

// Constructs the empty condition through the NON-LITERAL path deliberately: the literal form
// `unbound_dissolution(description: "")` is refused at compile (the parameter is NonEmptyStr) --
// the wall. Refinement at non-literal positions is still deferred, so that gap is exactly what the
// downstream well-formedness guard defends, and this control must reach it through the gap to keep
// proving the guard works (DESIGN 4b(4)).
fn synthetic_nonliteral_text(text: String) -> NonEmptyStr {
  concat(text, "")
}

fn synthetic_empty_condition(text: String) -> DissolutionCondition {
  unbound_dissolution(description: synthetic_nonliteral_text(text: text))
}

test fn non_fold_residue_frontier_red_control_empty_trigger_reds() -> Bool {
  let verdict = frontier_row_well_formed(
    row: FrontierRow {
      subject: PathSubject { path: "synthetic.dag::f" },
      reason: "a reason without a trigger is not a frontier row",
      dissolution: synthetic_empty_condition(text: "")
    }
  )
  verdict == false
}

test fn non_fold_residue_frontier_red_control_duplicate_path_reds() -> Bool {
  match frontier_rows_keyed_roster_build(
    rows: [
      FrontierRow {
        subject: PathSubject { path: "synthetic/a.dag::f" },
        reason: "r1",
        dissolution: unbound_dissolution(description: "d1"),
      },
      FrontierRow {
        subject: PathSubject { path: "synthetic/a.dag::f" },
        reason: "r2",
        dissolution: unbound_dissolution(description: "d2"),
      },
    ]
  ) {
    KeyedRosterBuilt { rows: _ } => false
    KeyedRosterBuildDuplicateKey { key: _, first: _, duplicate: _ } => true
  }
}

// THE TAXONOMY IS A MEANING, AND A MEANING NEEDS A GUARD. The variant-test pairing
// (nfr_reason_variant_test_predicate with nfr_dissolve_derived_variant_test) is the roster's one
// reason/dissolution PAIRING: the reason names what the arm IS (a closed-coproduct constructor test
// whose wildcard is the residue) and the dissolution names the CAPABILITY that retires it (a derived
// `x is V` test, per DESIGN 4b meta-obligation 3: "a drop is retired by its trigger and nothing
// else"). Filing a variant-test predicate under the generic wildcard reason instead makes it a
// member of a class whose own reason text says such a row is not a variant-test predicate -- a
// second meaning under one name (DESIGN 3) -- and it then never retires when the capability lands,
// because its dissolution names an artifact (the owning file's fold) instead of that capability.
// This claim is the wall review 86021 asked for: every roster row carries the pairing together or
// carries neither. A row mutated onto half the pairing (the RED) reds this witness; the same
// witness is the positive control at a paired head.
fn row_is_variant_test_reason(row: FrontierRow) -> Bool {
  match row { FrontierRow { subject: _, reason: r, dissolution: _ } => r == nfr_reason_variant_test_predicate }
}

fn row_is_variant_test_dissolution(row: FrontierRow) -> Bool {
  match row { FrontierRow { subject: _, reason: _, dissolution: d } => d == nfr_dissolve_derived_variant_test }
}

test fn non_fold_residue_frontier_variant_test_pairing_holds() -> Bool {
  fold(non_fold_residue_frontier, init: true, f: fn(acc, row) {
    acc && (row_is_variant_test_reason(row: row) == row_is_variant_test_dissolution(row: row))
  })
}
