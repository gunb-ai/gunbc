module test.claim.asrock_live_probe

import std.types { NonEmptyStr, String, Bool, list_length }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import extdeps.boards.asrock_rack {
  asrock_srv3_live_bmc_host,
  asrock_srv3_live_probe_firmware_version,
  asrock_srv3_live_readonly_probe_rows,
  asrock_altrad8ud_shipped_bmc_firmware_capabilities,
  asrock_altrad8ud_openbmc_2_07_00_nbd_proxy_primary_endpoint,
  live_probe_confirms_shipped_firmware_version,
  live_probe_confirms_redfish_virtual_media_absent,
  live_probe_confirms_nbd_proxy_vm_slot_ws_present,
  live_probe_confirms_nbd_slot_ws_absent,
  ProbeAbsent,
}
import extdeps.bmc.capability {
  firmware_has_capability,
  CapabilityVirtualMedia,
  CapabilityNbdProxyVirtualMedia,
}
import extdeps.bmc.webui.nbd_proxy { VmSlotIndexEndpoint }

data asrock_live_probe_binding_note: String = "review-cycle repair, gunbc#7398: this file previously declared no imports at all and bound every name by bare reference. That resolves only when an unrelated module elsewhere in the assembled closure happens to drag extdeps.boards.asrock_rack into the pool — the Class B pool-membership coincidence DESIGN.md records as blocking further import-stripping. Adding one witness root in an unrelated lane re-shaped witness_layer_roots and ProbeAbsent stopped resolving, with the other names in this same file still binding by luck. The imports above make the binding closure-independent, which is the remedy that thread names; they restore explicit dependency edges rather than removing any."

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn srv3_live_bmc_host_is_grounded() -> Bool {
  asrock_srv3_live_bmc_host == "192.168.1.192"
}

test fn live_probe_firmware_matches_shipped_catalog_row() -> Bool {
  live_probe_confirms_shipped_firmware_version()
    && asrock_srv3_live_probe_firmware_version == "2.07.00"
    && asrock_altrad8ud_shipped_bmc_firmware_capabilities.firmware.version == "2.07.00"
}

test fn live_probe_redfish_virtual_media_absent_matches_catalog() -> Bool {
  live_probe_confirms_redfish_virtual_media_absent()
    && firmware_has_capability(
      row: asrock_altrad8ud_shipped_bmc_firmware_capabilities,
      cap: CapabilityVirtualMedia
    ) == false
}

test fn live_probe_rows_cover_vm_and_nbd_get_surfaces() -> Bool {
  list_length(items: asrock_srv3_live_readonly_probe_rows) == 7
    && live_probe_confirms_nbd_proxy_vm_slot_ws_present()
    && live_probe_confirms_nbd_slot_ws_absent()
    && asrock_altrad8ud_openbmc_2_07_00_nbd_proxy_primary_endpoint == VmSlotIndexEndpoint
    && fold(
      asrock_srv3_live_readonly_probe_rows,
      init: false,
      f: (acc, row) =>
        acc || (row.locator == ("/redfish/v1/Systems/system/VirtualMedia" as NonEmptyStr)
          && row.verdict == ProbeAbsent)
    )
}

test fn shipped_row_nbd_proxy_capability_requires_ws_dry_run_receipt() -> Bool {
  firmware_has_capability(
    row: asrock_altrad8ud_shipped_bmc_firmware_capabilities,
    cap: CapabilityNbdProxyVirtualMedia
  )
}
