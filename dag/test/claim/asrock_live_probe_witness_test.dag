module test.claim.asrock_live_probe


data asrock_live_probe_binding_note: String = "gunbc#7398 collateral repair. This file declared NO imports and bound every cross-module name by bare reference, which resolves only when some unrelated module elsewhere in the assembled closure happens to drag extdeps.boards.asrock_rack into the pool — the Class B pool-membership coincidence DESIGN.md records as blocking further import-stripping. Adding one witness root in an unrelated lane re-shaped witness_layer_roots and ProbeAbsent stopped resolving, while every other name in this same file still bound by luck. MEASURED: merged roadmap PRs #7393 and #7395 hit the same whole-tree baseline and passed, so the baseline is not generally broken — a NEW witness root is what perturbs it. The imports above make the binding closure-independent, which is the remedy that thread names; they restore explicit dependency edges rather than removing any."

data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

test fn srv3_live_bmc_host_is_grounded() -> Bool {
  extdeps.boards.asrock_rack.asrock_srv3_live_bmc_host == "192.168.1.192"
}

test fn live_probe_firmware_matches_shipped_catalog_row() -> Bool {
  let expected = extdeps.firmware.types.firmware_semantic_version(major: 2, minor: 7, patch: 0)
  extdeps.boards.asrock_rack.live_probe_confirms_shipped_firmware_version()
    && extdeps.boards.asrock_rack.asrock_srv3_live_probe_firmware_version == expected
    && asrock_altrad8ud_shipped_bmc_firmware_capabilities.firmware.version == expected
}

test fn live_probe_redfish_virtual_media_absent_matches_catalog() -> Bool {
  extdeps.boards.asrock_rack.live_probe_confirms_redfish_virtual_media_absent()
    && extdeps.bmc.capability.firmware_has_capability(
      row: extdeps.boards.asrock_rack.asrock_altrad8ud_shipped_bmc_firmware_capabilities,
      cap: extdeps.bmc.capability.CapabilityVirtualMedia
    ) == false
}

test fn live_probe_rows_cover_vm_and_nbd_get_surfaces() -> Bool {
  std.types.list_length(items: extdeps.boards.asrock_rack.asrock_srv3_live_readonly_probe_rows) == 7
    && extdeps.boards.asrock_rack.live_probe_confirms_nbd_proxy_vm_slot_ws_present()
    && extdeps.boards.asrock_rack.live_probe_confirms_nbd_slot_ws_absent()
    && extdeps.boards.asrock_rack.asrock_altrad8ud_openbmc_2_07_00_nbd_proxy_primary_endpoint == extdeps.bmc.webui.nbd_proxy.VmSlotIndexEndpoint
    && fold(
      extdeps.boards.asrock_rack.asrock_srv3_live_readonly_probe_rows,
      init: false,
      f: (acc, row) =>
        acc || (row.locator == ("/redfish/v1/Systems/system/VirtualMedia" as std.types.NonEmptyStr)
          && row.verdict == extdeps.boards.asrock_rack.ProbeAbsent)
    )
}

test fn shipped_row_nbd_proxy_capability_requires_ws_dry_run_receipt() -> Bool {
  extdeps.bmc.capability.firmware_has_capability(
    row: extdeps.boards.asrock_rack.asrock_altrad8ud_shipped_bmc_firmware_capabilities,
    cap: extdeps.bmc.capability.CapabilityNbdProxyVirtualMedia
  )
}
