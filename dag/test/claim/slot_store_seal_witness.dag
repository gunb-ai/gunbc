module test.claim.slot_store_seal_witness

import std.types { Bool, Int, String }
import gunbc.compile_census_probe { blocking_subject_census, census_delta_verdict, census_verdict, census_verdict_all, total_blocking_census, census_exit, CensusVerdict }
import gunbc.compile_diagnostic_census { CompileDiagnosticCensus }
import std.process { ProcessExit }

// A CLAIM STORE IS MINTED FROM ITS DECLARATION AND CANNOT BE SPELLED OR MINTED FROM A PATH.
// gunbc.durable_cas_file_store SlotStore and gunbc.roadmap.roadmap_attempt_worktree_claim_root WorktreeClaimStore
// are sole_constructor; the claim domain takes WorktreeClaimStore, which only worktree_claim_store builds, from the
// instance alone (the root is derived there from worktree_claim_slots). Each RED hands the compiler a module
// outside the defining files and asserts the refusal on the real acceptance path:
//   - a forged SlotStore literal, a forged cast, a forged claim store, and a claim store built around a LITERAL PATH:
//     each EXACTLY ONE SoleConstructorViolation on its subject;
//   - a path-taking claim minter (the deleted slot_root_observe), a bare-root store passed where a claim store is
//     required, and a root read out of a claim store: each at least one blocking diagnostic beyond a baseline
//     importing the same closure, which cancels the shared closure (gunbc.compile_diagnostic_census).
// The GREEN is the lawful route, worktree_claim_store into worktree_claim_record_before_add, which adds no blocking
// diagnostic and draws no seal violation. NOT witnessed, because it is not expressible: a store minted for instance
// A refused where B is required (one type for both; see WorktreeClaimStore). NOT closed here: any module can still
// build a plain SlotStore over its own path through file_slot_store_over, because Filesystem.* and local_filesystem
// are ambient; that store is not a claim store. Seal residuals: variant construction
// (test.claim.sole_constructor_completeness_audit_probe f13) and parameter defaults (f19), so neither record is
// generic or a variant arm.

fn seal_violations(source: String, subject: String) -> CompileDiagnosticCensus {
  blocking_subject_census(source: source, wanted_class: "SoleConstructorViolation", wanted_subject: subject)
}

fn blocking_delta(hostile: String, safe: String, holds: fn(Int) -> Bool) -> CensusVerdict {
  census_delta_verdict(red: total_blocking_census(source: hostile), control: total_blocking_census(source: safe), holds: holds)
}

data forged_store_literal_source: String = "module probe_slot_store_literal\nimport std.types { NonEmptyStr }\nimport gunbc.roadmap.roadmap_dashboard_instance { HostDashboardInstance }\nimport gunbc.roadmap.roadmap_attempt_worktree_claim_root { WorktreeClaimStore, WorktreeClaimStoreReady, WorktreeClaimStoreUnready, worktree_claim_store }\nimport gunbc.roadmap.roadmap_attempt_worktree_claim { WorktreeClaim, WorktreeClaimWritten, WorktreeClaimNotRecorded, worktree_claim_record_before_add }\nimport gunbc.filesystem_interface { local_filesystem }\nimport gunbc.durable_cas_file_store { SlotStore, file_slot_store_over }\nfn f(s: SlotStore) -> SlotStore {\n  SlotStore { observe: s.observe, commit: s.commit, keys: s.keys }\n}\n"

data forged_store_cast_source: String = "module probe_slot_store_cast\nimport std.types { NonEmptyStr }\nimport gunbc.roadmap.roadmap_dashboard_instance { HostDashboardInstance }\nimport gunbc.roadmap.roadmap_attempt_worktree_claim_root { WorktreeClaimStore, WorktreeClaimStoreReady, WorktreeClaimStoreUnready, worktree_claim_store }\nimport gunbc.roadmap.roadmap_attempt_worktree_claim { WorktreeClaim, WorktreeClaimWritten, WorktreeClaimNotRecorded, worktree_claim_record_before_add }\nimport gunbc.filesystem_interface { local_filesystem }\nimport gunbc.durable_cas_file_store { SlotStore, file_slot_store_over }\nfn f(r: NonEmptyStr) -> SlotStore {\n  r as SlotStore\n}\n"

data forged_claim_store_source: String = "module probe_claim_store_literal\nimport std.types { NonEmptyStr }\nimport gunbc.roadmap.roadmap_dashboard_instance { HostDashboardInstance }\nimport gunbc.roadmap.roadmap_attempt_worktree_claim_root { WorktreeClaimStore, WorktreeClaimStoreReady, WorktreeClaimStoreUnready, worktree_claim_store }\nimport gunbc.roadmap.roadmap_attempt_worktree_claim { WorktreeClaim, WorktreeClaimWritten, WorktreeClaimNotRecorded, worktree_claim_record_before_add }\nimport gunbc.filesystem_interface { local_filesystem }\nimport gunbc.durable_cas_file_store { SlotStore, file_slot_store_over }\nfn f(r: NonEmptyStr) -> WorktreeClaimStore {\n  WorktreeClaimStore { instance: \"srv1-lab\", slots: file_slot_store_over(fs: local_filesystem, root: r) }\n}\n"

data literal_path_claim_store_source: String = "module probe_claim_store_literal_path\nimport std.types { NonEmptyStr }\nimport gunbc.roadmap.roadmap_dashboard_instance { HostDashboardInstance }\nimport gunbc.roadmap.roadmap_attempt_worktree_claim_root { WorktreeClaimStore, WorktreeClaimStoreReady, WorktreeClaimStoreUnready, worktree_claim_store }\nimport gunbc.roadmap.roadmap_attempt_worktree_claim { WorktreeClaim, WorktreeClaimWritten, WorktreeClaimNotRecorded, worktree_claim_record_before_add }\nimport gunbc.filesystem_interface { local_filesystem }\nimport gunbc.durable_cas_file_store { SlotStore, file_slot_store_over }\nfn f() -> WorktreeClaimStore {\n  WorktreeClaimStore { instance: \"srv1-lab\", slots: file_slot_store_over(fs: local_filesystem, root: \"/tmp/forged-worktree-claims\") }\n}\n"

data path_minter_source: String = "module probe_claim_store_path_minter\nimport std.types { NonEmptyStr }\nimport gunbc.roadmap.roadmap_dashboard_instance { HostDashboardInstance }\nimport gunbc.roadmap.roadmap_attempt_worktree_claim_root { WorktreeClaimStore, WorktreeClaimStoreReady, WorktreeClaimStoreUnready, worktree_claim_store }\nimport gunbc.roadmap.roadmap_attempt_worktree_claim { WorktreeClaim, WorktreeClaimWritten, WorktreeClaimNotRecorded, worktree_claim_record_before_add }\nimport gunbc.filesystem_interface { local_filesystem }\nimport gunbc.durable_cas_file_store { SlotStore, file_slot_store_over }\nfn f() -> NonEmptyStr {\n  match slot_root_observe(fs: local_filesystem, declaration: \"worktree-claims\", root: \"/tmp/forged-worktree-claims\") {\n    _ => \"minted\"\n  }\n}\n"

data bare_store_as_claim_store_source: String = "module probe_bare_store_as_claims\nimport std.types { NonEmptyStr }\nimport gunbc.roadmap.roadmap_dashboard_instance { HostDashboardInstance }\nimport gunbc.roadmap.roadmap_attempt_worktree_claim_root { WorktreeClaimStore, WorktreeClaimStoreReady, WorktreeClaimStoreUnready, worktree_claim_store }\nimport gunbc.roadmap.roadmap_attempt_worktree_claim { WorktreeClaim, WorktreeClaimWritten, WorktreeClaimNotRecorded, worktree_claim_record_before_add }\nimport gunbc.filesystem_interface { local_filesystem }\nimport gunbc.durable_cas_file_store { SlotStore, file_slot_store_over }\nfn f(r: NonEmptyStr, c: WorktreeClaim) -> WorktreeClaimWritten {\n  worktree_claim_record_before_add(claims: file_slot_store_over(fs: local_filesystem, root: r), claim: c)\n}\n"

data root_out_of_claim_store_source: String = "module probe_root_out_of_claims\nimport std.types { NonEmptyStr }\nimport gunbc.roadmap.roadmap_dashboard_instance { HostDashboardInstance }\nimport gunbc.roadmap.roadmap_attempt_worktree_claim_root { WorktreeClaimStore, WorktreeClaimStoreReady, WorktreeClaimStoreUnready, worktree_claim_store }\nimport gunbc.roadmap.roadmap_attempt_worktree_claim { WorktreeClaim, WorktreeClaimWritten, WorktreeClaimNotRecorded, worktree_claim_record_before_add }\nimport gunbc.filesystem_interface { local_filesystem }\nimport gunbc.durable_cas_file_store { SlotStore, file_slot_store_over }\nfn f(c: WorktreeClaimStore) -> NonEmptyStr {\n  c.slots.root\n}\n"

data lawful_claim_store_source: String = "module probe_lawful_claim_store\nimport std.types { NonEmptyStr }\nimport gunbc.roadmap.roadmap_dashboard_instance { HostDashboardInstance }\nimport gunbc.roadmap.roadmap_attempt_worktree_claim_root { WorktreeClaimStore, WorktreeClaimStoreReady, WorktreeClaimStoreUnready, worktree_claim_store }\nimport gunbc.roadmap.roadmap_attempt_worktree_claim { WorktreeClaim, WorktreeClaimWritten, WorktreeClaimNotRecorded, worktree_claim_record_before_add }\nimport gunbc.filesystem_interface { local_filesystem }\nimport gunbc.durable_cas_file_store { SlotStore, file_slot_store_over }\nfn f(i: HostDashboardInstance, c: WorktreeClaim) -> WorktreeClaimWritten {\n  match worktree_claim_store(instance: i) {\n    WorktreeClaimStoreReady { store } => worktree_claim_record_before_add(claims: store, claim: c)\n    WorktreeClaimStoreUnready { detail } => WorktreeClaimNotRecorded { detail: detail }\n  }\n}\n"

data closure_baseline_source: String = "module probe_claim_store_baseline\nimport std.types { NonEmptyStr }\nimport gunbc.roadmap.roadmap_dashboard_instance { HostDashboardInstance }\nimport gunbc.roadmap.roadmap_attempt_worktree_claim_root { WorktreeClaimStore, WorktreeClaimStoreReady, WorktreeClaimStoreUnready, worktree_claim_store }\nimport gunbc.roadmap.roadmap_attempt_worktree_claim { WorktreeClaim, WorktreeClaimWritten, WorktreeClaimNotRecorded, worktree_claim_record_before_add }\nimport gunbc.filesystem_interface { local_filesystem }\nimport gunbc.durable_cas_file_store { SlotStore, file_slot_store_over }\nfn f(n: NonEmptyStr) -> NonEmptyStr {\n  n\n}\n"

test fn a_forged_slot_store_literal_is_refused_at_compile() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: forged_store_literal_source, subject: "SlotStore"), holds: fn(n) { n == 1 }))
}

test fn a_forged_slot_store_cast_is_refused_at_compile() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: forged_store_cast_source, subject: "SlotStore"), holds: fn(n) { n == 1 }))
}

test fn a_forged_claim_store_is_refused_at_compile() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: forged_claim_store_source, subject: "WorktreeClaimStore"), holds: fn(n) { n == 1 }))
}

test fn a_claim_store_from_a_literal_path_is_refused_at_compile() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: literal_path_claim_store_source, subject: "WorktreeClaimStore"), holds: fn(n) { n == 1 }))
}

test fn no_path_taking_minter_resolves() -> ProcessExit {
  census_exit(blocking_delta(hostile: path_minter_source, safe: closure_baseline_source, holds: fn(n) { n >= 1 }))
}

test fn a_bare_root_store_is_not_a_claim_store() -> ProcessExit {
  census_exit(blocking_delta(hostile: bare_store_as_claim_store_source, safe: closure_baseline_source, holds: fn(n) { n >= 1 }))
}

test fn claim_code_has_no_route_to_a_root() -> ProcessExit {
  census_exit(blocking_delta(hostile: root_out_of_claim_store_source, safe: closure_baseline_source, holds: fn(n) { n >= 1 }))
}

test fn the_lawful_mint_route_is_admitted() -> ProcessExit {
  census_verdict_all(verdicts: [
    blocking_delta(hostile: lawful_claim_store_source, safe: closure_baseline_source, holds: fn(n) { n <= 0 }),
    census_verdict(census: seal_violations(source: lawful_claim_store_source, subject: "WorktreeClaimStore"), holds: fn(n) { n == 0 }),
    census_verdict(census: seal_violations(source: lawful_claim_store_source, subject: "SlotStore"), holds: fn(n) { n == 0 }),
  ])
}
