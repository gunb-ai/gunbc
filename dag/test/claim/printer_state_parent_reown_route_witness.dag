module test.claim.printer_state_parent_reown_route_witness

import std.types { Bool }
import std.algebra { string_contains }
import gunbc.ci.ci_spec { gunbc_ci_printer_workflow_target, gunbc_ci_printer_workflow_invoke }
import gunbc.fleet.fleet_converge_workflow { PrinterWorkflow, fleet_converge_workflow_mode_wire, fleet_converge_mode_job_id }

// WHICH DISPATCH CARRIES THE LEG, claimed rather than trusted. The operator's order says the re-own runs in
// the same window as printing and before printing, so the route matters as much as the transition: the mode
// word an operator types at fleet-converge, the job that word selects, the run step the model projects for
// that job, and the entry whose converge operation reaches ensure_printer_state_directories -- the function
// the leg was inserted into, ahead of the directory fold -- are ONE named chain. The leg lives in
// gunbc.fleet.printer_state_parent_reown; its host binding, and therefore its reach from a pass, in
// gunbc.fleet.printer_state_parent_reown_host, which is what gunbc.fleet.print_converge imports. Change the
// printer mode's wire word, its job id, the projected target's entry, or move the leg out of that entry, and
// a row here goes false.
test fn witness_the_dispatched_printer_mode_names_the_entry_that_carries_the_leg() -> Bool {
  let invoke_script = gunbc_ci_printer_workflow_invoke()
  fleet_converge_workflow_mode_wire(mode: PrinterWorkflow) == "printer"
    && fleet_converge_mode_job_id(mode: PrinterWorkflow) == "printer" as NonEmptyStr
    && gunbc_ci_printer_workflow_target.entry as String == "dag/gunbc/fleet/printer_workflow_run.dag"
    && gunbc_ci_printer_workflow_target.function as String == "run"
    && string_contains(s: invoke_script, pattern: "printer_workflow_run")
}
