module test.claim.gcp_iam_bootstrap_trust_root_wall_witness

import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.types { Bool, List, NonEmptyStr, String }
import std.optional { Present, Absent }
import extdeps.cloud.gcp.gcp { ServiceAccountEmail }
import extdeps.cloud.gcp.iam { IamCondition, GcpTagBindingWire, gcp_tag_condition_expression, gcp_service_account_tag_detach_requirement }
import extdeps.cloud.gcp.iam_deny { GcpDenyRule, GcpDenyPolicyRule }
import gunbc.auth.gcp_iam_converge { gcp_iam_converge_targets, iam_converge_service_account, iam_observe_service_account }
import gunbc.auth.gcp_iam_bootstrap_federation { iam_bootstrap_service_account }
import gunbc.auth.gcp_iam_bootstrap_model {
  iam_bootstrap_trust_root_tag_condition, iam_bootstrap_trust_root_tagged_accounts, iam_bootstrap_delta_principal,
  iam_bootstrap_deny_policies, iam_bootstrap_trust_root_wall_policy_id,
  iam_bootstrap_deny_rules_match, iam_bootstrap_trust_root_wall_rule,
  TagBindingEstablished, TagBindingAbsent, TagBindingIncomplete, trust_root_tag_binding_reading,
  iam_bootstrap_probe_accounts, iam_bootstrap_tag_detach_permissions, iam_bootstrap_tag_value_detach_permissions,
  TagDetachProbeVerdict, TagDetachAbsent, TagDetachUndiscriminating, TagDetachHeld, tag_detach_probe_verdict,
  TrustRootTagAdmission, TrustRootTagAdmitted, TrustRootTagRefused, trust_root_tag_value_admission, iam_bootstrap_trust_root_tag_value_namespaced,
}
import gunbc.auth.gcp_iam_bootstrap { BootstrapTrustRootTags, BootstrapDeny, BootstrapIdentities, BootstrapProbeAuthority, BootstrapPrivilegeReadback, BootstrapWorkflowTrust, BootstrapCapabilities, BootstrapAuthorityCleanup, BootstrapProbeCleanup, iam_bootstrap_stage_admitted }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// ── THE TRUST-ROOT WALL IN THE CREDENTIAL LAYER (the replacement gunbc.rung_drop
// gcp_iam_bootstrap_trust_root_wall_in_code stages; the drop retires on its readback trigger, not here)
// What the DECLARED deny policies, taken together, refuse iam-bootstrap on an account: the boundary's
// unconditioned rules apply everywhere, and a rule conditioned on the trust-root tag applies exactly on
// the accounts the tag stage binds it to. A rule with any other condition is not counted as denying
// (fail-closed: this reading cannot evaluate it). Whether GCP enforces these policies is the live
// readback the drop's trigger names; these claims pin what the declarations say.

fn tagged(account: ServiceAccountEmail) -> Bool {
  any(iam_bootstrap_trust_root_tagged_accounts(), a => (a as String) == (account as String))
}

fn rule_denies(rule: GcpDenyPolicyRule, principal: String, permission: String, account: ServiceAccountEmail) -> Bool {
  match rule.deny_rule {
    Absent => false
    Present { value: r } => any(r.denied_principals, p => p == principal) && any(r.denied_permissions, x => x == permission)
      && match r.denial_condition {
        Absent => true
        Present { value: c } => c.expression == gcp_tag_condition_expression(c: iam_bootstrap_trust_root_tag_condition()) && tagged(account: account)
      }
  }
}

fn declared_deny_refuses(principal: String, permission: String, account: ServiceAccountEmail) -> Bool {
  any(iam_bootstrap_deny_policies(), d => any(d.rules, r => rule_denies(rule: r, principal: principal, permission: permission, account: account)))
}

data trust_roots: List<ServiceAccountEmail> = [iam_converge_service_account, iam_observe_service_account, iam_bootstrap_service_account]

data set_policy: String = "iam.googleapis.com/serviceAccounts.setIamPolicy"

// EVERY WAY TO REWRITE A TRUST ROOT (the wall) AND TO BECOME ONE (the boundary), each named.
data account_writes: List<String> = [
  "iam.googleapis.com/serviceAccounts.setIamPolicy", "iam.googleapis.com/serviceAccounts.update",
  "iam.googleapis.com/serviceAccounts.delete", "iam.googleapis.com/serviceAccounts.disable",
  "iam.googleapis.com/serviceAccounts.enable", "iam.googleapis.com/serviceAccounts.undelete",
]
data account_impersonation: List<String> = [
  "iam.googleapis.com/serviceAccounts.actAs", "iam.googleapis.com/serviceAccounts.getAccessToken",
  "iam.googleapis.com/serviceAccounts.getOpenIdToken", "iam.googleapis.com/serviceAccounts.implicitDelegation",
  "iam.googleapis.com/serviceAccounts.signBlob", "iam.googleapis.com/serviceAccounts.signJwt",
  "iam.googleapis.com/serviceAccountKeys.create",
]

test fn iam_bootstrap_set_iam_policy_on_a_tagged_trust_root_account_is_denied() -> Bool {
  all(trust_roots, a => declared_deny_refuses(principal: iam_bootstrap_delta_principal(), permission: set_policy, account: a))
}

// THE DROP'S TRIGGER PERMISSIONS AND THEIR SIBLINGS: iam-bootstrap can neither rewrite nor become a
// trust root under the declared policies.
test fn iam_bootstrap_can_neither_rewrite_nor_become_a_trust_root() -> Bool {
  all(trust_roots, a => all(account_writes + account_impersonation, p => declared_deny_refuses(principal: iam_bootstrap_delta_principal(), permission: p, account: a)))
}

// THE WALL'S CONDITION IS LOAD-BEARING: on a target account iam-bootstrap may still write the policy
// (its delta does), while impersonating it stays refused everywhere.
test fn the_wall_leaves_target_account_policies_writable_and_other_principals_alone() -> Bool {
  count(gcp_iam_converge_targets) > 0
    && all(gcp_iam_converge_targets, t => !declared_deny_refuses(principal: iam_bootstrap_delta_principal(), permission: set_policy, account: t.service_account)
      && all(account_impersonation, p => declared_deny_refuses(principal: iam_bootstrap_delta_principal(), permission: p, account: t.service_account)))
    && !declared_deny_refuses(principal: "principal://iam.googleapis.com/someone-else", permission: set_policy, account: iam_converge_service_account)
}

test fn the_tagged_population_is_exactly_the_three_own_trust_accounts() -> Bool {
  let tagged_names = map(iam_bootstrap_trust_root_tagged_accounts(), a => a as String)
  count(tagged_names) == 3 && all(trust_roots, a => any(tagged_names, x => x == (a as String)))
    && !any(gcp_iam_converge_targets, t => any(tagged_names, x => x == (t.service_account as String)))
}

test fn the_wall_is_its_own_deny_policy_with_the_rendered_tag_condition() -> Bool {
  any(iam_bootstrap_deny_policies(), d => (d.policy_id as String) == (iam_bootstrap_trust_root_wall_policy_id as String) && count(d.rules) == 1)
    && gcp_tag_condition_expression(c: iam_bootstrap_trust_root_tag_condition()) == "resource.matchTag('gunbai-secrets/gunbc-trust-root', 'root')"
}

test fn the_tags_exist_before_the_deny_that_names_them() -> Bool {
  !iam_bootstrap_stage_admitted(stage: BootstrapDeny, completed: [BootstrapIdentities])
    && iam_bootstrap_stage_admitted(stage: BootstrapDeny, completed: [BootstrapIdentities, BootstrapTrustRootTags])
}

// ── BLOCKER 1 (side chat at db00846da5): the PRODUCTION deny matcher compares conditions exactly ──
// A correctly created wall must read back; the wall stripped of its condition (which would refuse
// target-account writes too) and a condition naming another tag value must not.
fn wall_with_condition(c: IamCondition?) -> GcpDenyPolicyRule {
  match iam_bootstrap_trust_root_wall_rule().deny_rule {
    Absent => iam_bootstrap_trust_root_wall_rule()
    Present { value: r } => GcpDenyPolicyRule { deny_rule: Present { value: GcpDenyRule { denied_principals: r.denied_principals,
      denied_permissions: r.denied_permissions, exception_principals: r.exception_principals, exception_permissions: r.exception_permissions,
      denial_condition: c } } }
  }
}

fn wall_condition() -> IamCondition? {
  match iam_bootstrap_trust_root_wall_rule().deny_rule { Absent => none  Present { value: r } => r.denial_condition }
}

test fn the_exact_conditioned_wall_reads_back() -> Bool {
  iam_bootstrap_deny_rules_match(observed: Present { value: [iam_bootstrap_trust_root_wall_rule()] }, declared: [iam_bootstrap_trust_root_wall_rule()])
}

test fn the_wall_without_its_condition_is_refused() -> Bool {
  !iam_bootstrap_deny_rules_match(observed: Present { value: [wall_with_condition(c: none)] }, declared: [iam_bootstrap_trust_root_wall_rule()])
}

test fn a_wall_naming_another_tag_value_is_refused() -> Bool {
  match wall_condition() {
    Absent => false
    Present { value: c } => !iam_bootstrap_deny_rules_match(
      observed: Present { value: [wall_with_condition(c: Present { value: IamCondition { title: c.title, description: c.description,
        expression: "resource.matchTag('gunbai-secrets/gunbc-trust-root', 'other')" } })] },
      declared: [iam_bootstrap_trust_root_wall_rule()])
  }
}

test fn the_unconditioned_boundary_policies_still_read_back_and_refuse_a_condition() -> Bool {
  let unconditioned = filter(iam_bootstrap_deny_policies(), d => (d.policy_id as String) != (iam_bootstrap_trust_root_wall_policy_id as String))
  count(unconditioned) == 2
    && all(unconditioned, d => iam_bootstrap_deny_rules_match(observed: Present { value: d.rules }, declared: d.rules))
    && match wall_condition() {
      Absent => false
      Present { value: c } => all(unconditioned, d => !iam_bootstrap_deny_rules_match(observed: Present { value: map(d.rules, r => match r.deny_rule {
        Absent => r
        Present { value: x } => GcpDenyPolicyRule { deny_rule: Present { value: GcpDenyRule { denied_principals: x.denied_principals, denied_permissions: x.denied_permissions,
          exception_principals: x.exception_principals, exception_permissions: x.exception_permissions, denial_condition: Present { value: c } } } }
      }) }, declared: d.rules))
    }
}

// ── BLOCKER 2: a tag binding is established only by an exact row of a complete-enough listing ──────
data parent_a: String = "//iam.googleapis.com/projects/gunbai-secrets/serviceAccounts/a@gunbai-secrets.iam.gserviceaccount.com"
data parent_b: String = "//iam.googleapis.com/projects/gunbai-secrets/serviceAccounts/b@gunbai-secrets.iam.gserviceaccount.com"
data wanted_value: NonEmptyStr = "tagValues/281475000000001"

fn binding_row(parent: String, value: String) -> GcpTagBindingWire {
  GcpTagBindingWire { name: none, parent: parent, tag_value: Present { value: value }, tag_value_namespaced_name: none }
}

test fn a_row_with_the_value_on_another_parent_establishes_nothing() -> Bool {
  match trust_root_tag_binding_reading(parent: parent_a, value_name: wanted_value, bindings: Present { value: [binding_row(parent: parent_b, value: wanted_value as String)] }, next_page_token: none) {
    TagBindingEstablished => false  TagBindingAbsent => true  TagBindingIncomplete => false
  }
}

test fn the_exact_row_establishes_the_binding() -> Bool {
  match trust_root_tag_binding_reading(parent: parent_a, value_name: wanted_value, bindings: Present { value: [binding_row(parent: parent_b, value: "tagValues/9"), binding_row(parent: parent_a, value: wanted_value as String)] }, next_page_token: Present { value: "more" }) {
    TagBindingEstablished => true  TagBindingAbsent => false  TagBindingIncomplete => false
  }
}

test fn an_unmatched_page_with_another_page_is_incomplete_never_absent() -> Bool {
  (match trust_root_tag_binding_reading(parent: parent_a, value_name: wanted_value, bindings: Present { value: [binding_row(parent: parent_a, value: "tagValues/9")] }, next_page_token: Present { value: "more" }) {
    TagBindingEstablished => false  TagBindingAbsent => false  TagBindingIncomplete => true })
    && (match trust_root_tag_binding_reading(parent: parent_a, value_name: wanted_value, bindings: Absent, next_page_token: Present { value: "" }) {
    TagBindingEstablished => false  TagBindingAbsent => true  TagBindingIncomplete => false })
}

// ── BLOCKER 3: iam-bootstrap's effective tag-detach authority is probed on every trust root ─────────
test fn the_detach_probe_runs_as_iam_bootstrap_on_every_trust_root_before_workflow_trust() -> Bool {
  any(iam_bootstrap_probe_accounts, a => (a as String) == (iam_bootstrap_service_account as String))
    && all(iam_bootstrap_trust_root_tagged_accounts(), t => any(iam_bootstrap_probe_accounts, a => (a as String) == (t as String)))
    && iam_bootstrap_stage_admitted(stage: BootstrapPrivilegeReadback, completed: [BootstrapCapabilities, BootstrapTrustRootTags, BootstrapProbeAuthority])
    && !iam_bootstrap_stage_admitted(stage: BootstrapPrivilegeReadback, completed: [BootstrapCapabilities, BootstrapProbeAuthority])
    && !iam_bootstrap_stage_admitted(stage: BootstrapWorkflowTrust, completed: [BootstrapDeny, BootstrapAuthorityCleanup, BootstrapProbeCleanup, BootstrapTrustRootTags])
}

// ── THE TAG-VALUE AXIS (closes the UNMET half of the drop's detach obligation) ──────────────────────
// One verdict serves both detach axes. A probe whose discriminating control (the operator's answer)
// lacks the permission establishes nothing; iam-bootstrap holding any of it refuses.
test fn the_detach_verdict_needs_the_control_and_refuses_a_holder() -> Bool {
  let p = iam_bootstrap_tag_value_detach_permissions
  (match tag_detach_probe_verdict(requested: p, control: p, subject: []) { TagDetachAbsent => true  TagDetachUndiscriminating => false  TagDetachHeld => false })
    && (match tag_detach_probe_verdict(requested: p, control: [], subject: []) { TagDetachAbsent => false  TagDetachUndiscriminating => true  TagDetachHeld => false })
    && (match tag_detach_probe_verdict(requested: p, control: p, subject: p) { TagDetachAbsent => false  TagDetachUndiscriminating => false  TagDetachHeld => true })
}

// INHABITANCE, not a literal: each axis probes exactly its half of the cited upstream fact, so a probe
// of any other permission (tagValueBindings.create, say) has nowhere to land but the cited fact itself.
test fn each_detach_axis_probes_its_half_of_the_cited_upstream_requirement() -> Bool {
  iam_bootstrap_tag_detach_permissions == [gcp_service_account_tag_detach_requirement.service_account_permission]
    && iam_bootstrap_tag_value_detach_permissions == [gcp_service_account_tag_detach_requirement.tag_value_permission]
}

// ── ONE IDENTITY FOLD FOR THE TRUST-ROOT TAG VALUE (side chat at 8cd119d93f) ──────────────────────
// The tag stage and the detach probe admit the value through the SAME fold: short name root, the declared
// namespaced name, the exact trust-root key as parent, and a tagValues/<id> name. A lookup answering
// another valid TagValue is refused before either permission probe can count.
data trust_root_key_name: String = "tagKeys/281479000000001"

fn value_admitted(name: String, parent: String, short_name: String, namespaced: String?) -> Bool {
  match trust_root_tag_value_admission(key_name: trust_root_key_name, name: name, parent: parent, short_name: short_name, namespaced_name: namespaced) {
    TrustRootTagAdmitted { name: _ } => true  TrustRootTagRefused { reason: _ } => false }
}

data declared_value_namespaced: String = "gunbai-secrets/gunbc-trust-root/root"

test fn the_declared_trust_root_value_is_admitted() -> Bool {
  iam_bootstrap_trust_root_tag_value_namespaced() as String == declared_value_namespaced
    && value_admitted(name: "tagValues/281479000000002", parent: trust_root_key_name, short_name: "root", namespaced: Present { value: declared_value_namespaced })
}

test fn another_valid_tag_value_is_refused_before_any_probe() -> Bool {
  !value_admitted(name: "tagValues/281479000000099", parent: trust_root_key_name, short_name: "other", namespaced: Present { value: "gunbai-secrets/gunbc-trust-root/other" })
    && !value_admitted(name: "tagValues/281479000000099", parent: "tagKeys/281479000000077", short_name: "root", namespaced: Present { value: declared_value_namespaced })
    && !value_admitted(name: "tagValues/281479000000099", parent: trust_root_key_name, short_name: "root", namespaced: Present { value: "gunbai-secrets/other-key/root" })
    && !value_admitted(name: "tagValues/281479000000099", parent: trust_root_key_name, short_name: "root", namespaced: Absent)
}

test fn only_a_tag_values_id_name_is_admitted() -> Bool {
  !value_admitted(name: "", parent: trust_root_key_name, short_name: "root", namespaced: Present { value: declared_value_namespaced })
    && !value_admitted(name: "tagValues/", parent: trust_root_key_name, short_name: "root", namespaced: Present { value: declared_value_namespaced })
    && !value_admitted(name: "tagKeys/281479000000002", parent: trust_root_key_name, short_name: "root", namespaced: Present { value: declared_value_namespaced })
    && !value_admitted(name: "tagValues/2/extra", parent: trust_root_key_name, short_name: "root", namespaced: Present { value: declared_value_namespaced })
}
