module test.claim.service_effect_expansion_budget_witness

import std.types { String, Bool, Int, List }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import tools.multi_module_compile_fixture {
  MultiModuleCompileFixture,
  MultiModuleCompileFixtureOutcome,
  FixtureInstrumentRefused,
  FixtureCompileRefused,
  FixtureCompileCompleted,
  FixtureSource,
  fixture_source,
  compile_fixture
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE SUBJECT. v1.compiler.infer_service expand_transitive_services propagates each declaration's
// service set to its callers, and it runs under a fixed pass budget. A call chain deeper than that
// budget stops mid-propagation, and before this change the exhausted budget returned an ORDINARY
// registry -- indistinguishable from a fixed point. The callers above the cut then emitted without
// the service parameter their callees required, so the emitted Rust carried an unrealized-host-seam
// panic where a working call belonged: a truncation published as a finished answer, which is the
// absorbing-fallback shape DESIGN section 5 forbids. The analysis now returns EffectsComplete or
// EffectsIncomplete, so the registry is reachable only through the complete arm and an exhausted
// budget surfaces as a typed cause instead.
//
// WHY THE FIXTURE. The RED is a property of chain DEPTH against the budget, so it is authorable
// only as source whose depth the test controls. The live corpus decides nothing here: it is either
// under the budget, in which case it proves the wall never fires, or over it, in which case the
// tree is already red for an unrelated reason.

data deep_chain_source: String = "module setsw.chain\nservice setsw.Probe \{\n  operation Ping \{\n    input \{ tag: String \}\n    output \{ line: String from \"stdout\" \}\n    readonly\n    transport shell \{ argv: [\"echo\", \"\{tag\}\"] \}\n    exit \{\n      0 => Unit\n    \}\n  \}\n\}\nfn f0(tag: String) -> String \{ f1(tag: tag) \}\nfn f1(tag: String) -> String \{ f2(tag: tag) \}\nfn f2(tag: String) -> String \{ f3(tag: tag) \}\nfn f3(tag: String) -> String \{ f4(tag: tag) \}\nfn f4(tag: String) -> String \{ f5(tag: tag) \}\nfn f5(tag: String) -> String \{ f6(tag: tag) \}\nfn f6(tag: String) -> String \{ f7(tag: tag) \}\nfn f7(tag: String) -> String \{ f8(tag: tag) \}\nfn f8(tag: String) -> String \{ setsw.Probe.Ping(tag: tag).line \}\n"

data shallow_chain_source: String = "module setsw.chain\nservice setsw.Probe \{\n  operation Ping \{\n    input \{ tag: String \}\n    output \{ line: String from \"stdout\" \}\n    readonly\n    transport shell \{ argv: [\"echo\", \"\{tag\}\"] \}\n    exit \{\n      0 => Unit\n    \}\n  \}\n\}\nfn f0(tag: String) -> String \{ f1(tag: tag) \}\nfn f1(tag: String) -> String \{ f2(tag: tag) \}\nfn f2(tag: String) -> String \{ setsw.Probe.Ping(tag: tag).line \}\n"

fn deep_run() -> MultiModuleCompileFixtureOutcome {
  compile_fixture(MultiModuleCompileFixture {
    sources: [fixture_source("setsw/chain.dag", deep_chain_source)],
    entry: "setsw/chain.dag"
  })
}

fn shallow_run() -> MultiModuleCompileFixtureOutcome {
  compile_fixture(MultiModuleCompileFixture {
    sources: [fixture_source("setsw/chain.dag", shallow_chain_source)],
    entry: "setsw/chain.dag"
  })
}


fn completed(o: MultiModuleCompileFixtureOutcome) -> Bool {
  match o {
    FixtureCompileCompleted { module_count: n, emitted_files: files, diagnostics: rows, source_digest: sd, compiler_digest: cd } =>
      count(files) > 0 && n > 0,
    FixtureCompileRefused { module_count: n, diagnostics: rows, source_digest: sd, compiler_digest: cd } => false,
    FixtureInstrumentRefused { cause: c } => false
  }
}

// WHAT THIS WITNESS ESTABLISHES NOW, AND WHAT IT DOES NOT.
//
// The pass budget used to be the literal 5. A chain deeper than that stopped mid-propagation and
// the callers above the cut emitted without the service parameter their callees required. The
// first repair made that exhaustion REFUSE, which replaced a silent truncation with a loud one --
// and the loud one blocked the generated-artifact actuator, because the live corpus is deeper than
// five. The budget is now DERIVED (expansion_pass_bound): the ascent is monotone, so a bound of
// item count x distinct service count cannot be reached before convergence has already stopped it.
// A chain deeper than any chosen number therefore converges rather than truncating or refusing.
//
// So the old RED is no longer authorable: there is no depth at which the budget cuts. Per DESIGN
// section 4b(4) the probe does not retire -- it flips to a permanent regression control, which is
// what these two tests are. Reintroducing a chosen pass count turns the deep one red again.
//
// THE CEILING, STATED BECAUSE IT IS NOT OBVIOUS. Neither test establishes that the service reached
// the TOP of the chain. compile_fixture returns emitted file names and diagnostic census rows; it
// returns no emitted contents and no rustc result, so the signature of f0 is not observable here
// and the original defect -- which COMPLETED, emitting an unrealized-host-seam panic with no
// diagnostic at all -- would satisfy `completed` exactly as the repair does. What these controls
// discriminate is the refusing and the truncating-at-a-chosen-depth behaviours, not the emitted
// parameter list. The next-rung trigger is a fixture instrument that can assert over emitted
// content; until it exists this class is a regression control and is reported as one.
test fn chain_deeper_than_any_chosen_pass_count_still_converges() -> Bool {
  completed(deep_run())
}

// THE SHALLOW CONTROL. Without it the test above is satisfied by an analysis that never refuses
// anything, including one that has stopped propagating altogether.
test fn chain_within_a_single_pass_still_emits() -> Bool {
  completed(shallow_run())
}
