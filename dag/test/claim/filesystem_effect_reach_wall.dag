}
// THE REAL ROSTER AND THE WALL ITSELF, from the module that owns the row identity, the roster and the
// predicate (review 98562 finding 2: no second row type, no hand-written adapter, no restated
// predicate -- gunbc.design_argument::single_authority). The witness exercises the real producer over
// an executing route (gunbc.design_argument::consumption).
import gunbc.demand_engine_restatement_follow_up {
  demand_restatement_retained_fn_rows,
  demand_restatement_authorized_roster,
  DemandRestatementRowIdentity,
  AuthorizedRow,
  NewRestatementRowRefused,
  demand_restatement_retained_identity,
  demand_restatement_identity_eq,
  demand_restatement_row_verdict,
  demand_restatement_new_row_refusals,
  demand_restatement_wall_holds
}
// THE ARRIVING PRODUCER FOR WALL 1: the same ingest, tokenize and parse authorities the compiler
// itself runs -- NOT a second parser, and no roster field re-spelled here.
import v2.compiler.source_root_eval { native_lane_census_ingest }
import v2.compiler.source_authority { DagSourceReadWitness }
import v2.compiler.parse { parse_module }
import v2.compiler.tokenize { tokenize_prepared }
import v2.compiler.program_assembly { dag_prepared_lex }
