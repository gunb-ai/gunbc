module test.claim.host_effect_plan_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

data hermetic_witness_home_doc: String = "Hermetic-safe Wave A2 host_effect_plan_apply witnesses: control-flow and empty-plan refusal arms only (no shell.Exec.Run). Shell converge/failure/sequential poles live in host_effect_plan_real_execution_witness_test.dag (Wet bin batch)."

fn witness_host_os_target() -> gunbc.host_effect.NodeControlPlane {
  gunbc.host_effect.HostOs { node: srv1_host }
}

fn witness_plan_ctx() -> gunbc.host_effect_plan.HostEffectPlanContext {
  gunbc.host_effect_plan.HostEffectPlanContext {
    target: witness_host_os_target(),
    evidence: host_effect_identity_evidence,
    transport: LocalShell,
  }
}

fn witness_empty_plan() -> gunbc.host_effect_plan.HostEffectPlan {
  v2.std.effect_plan.EffectPlan { steps: [], on_failure: FailFast }
}

fn witness_if_control_flow_plan() -> gunbc.host_effect_plan.HostEffectPlan {
  v2.std.effect_plan.EffectPlan {
    steps: [
      v2.std.effect_plan.If {
        cond: v2.std.orchestration.ExitZero {
          run: v2.std.orchestration.Run { command: "true", env: [], redirect: Absent, capture: Absent }
        },
        then_: v2.std.effect_plan.EffectPlan { steps: [], on_failure: FailFast },
        else_: Absent,
      },
    ],
    on_failure: FailFast,
  }
}

test fn witness_empty_plan_refuses_fail_closed() -> Bool {
  !reconciliation_converged(r: host_effect_plan_apply(
    plan: witness_empty_plan(),
    ctx: witness_plan_ctx(),
  ))
}

test fn witness_control_flow_step_refuses_fail_closed() -> Bool {
  !reconciliation_converged(r: host_effect_plan_apply(
    plan: witness_if_control_flow_plan(),
    ctx: witness_plan_ctx(),
  ))
}



