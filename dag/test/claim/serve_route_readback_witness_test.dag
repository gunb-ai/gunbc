module test.claim.serve_route_readback_witness_test

import std.types { Bool }
import gunbc.auth.serve_route_readback { serve_backend_route_readback }

test fn witness_backend_is_exact() -> Bool {
  let status = "{\"Web\":{\"srv2.example:18082\":{\"Handlers\":{\"/\":{\"Proxy\":\"http://127.0.0.1:18082\"}}}}}"
  match serve_backend_route_readback(status_json: status, listen_host: "127.0.0.1", listen_port: 18082) {
    Present { value: route } => route.https_port == 18082 && serve_backend_route_readback(status_json: status, listen_host: "127.0.0.1", listen_port: 18083) == none
    Absent => false
  }
}

test fn witness_funnel_and_ambiguous_routes_refuse() -> Bool {
  let public_status = "{\"AllowFunnel\":{\"srv2.example:18082\":true},\"Web\":{\"srv2.example:18082\":{\"Handlers\":{\"/\":{\"Proxy\":\"http://127.0.0.1:18082\"}}}}}"
  let duplicate = "{\"Web\":{\"one:18082\":{\"Handlers\":{\"/\":{\"Proxy\":\"http://127.0.0.1:18082\"}}},\"two:18083\":{\"Handlers\":{\"/\":{\"Proxy\":\"http://127.0.0.1:18082\"}}}}}"
  serve_backend_route_readback(status_json: public_status, listen_host: "127.0.0.1", listen_port: 18082) == none
    && serve_backend_route_readback(status_json: duplicate, listen_host: "127.0.0.1", listen_port: 18082) == none
    && serve_backend_route_readback(status_json: "garbage", listen_host: "127.0.0.1", listen_port: 18082) == none
}

test fn witness_duplicated_funnel_policy_is_unreadable() -> Bool {
  let status = "{\"AllowFunnel\":{},\"AllowFunnel\":{\"srv2.example:18082\":true},\"Web\":{\"srv2.example:18082\":{\"Handlers\":{\"/\":{\"Proxy\":\"http://127.0.0.1:18082\"}}}}}"
  serve_backend_route_readback(status_json: status, listen_host: "127.0.0.1", listen_port: 18082) == none
}
