data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// ── The discriminating RED: a TestRisk deployment never reaches the prod attachments ────────────
// THE REAL ROW AND THE REAL TABLE. The srv1 lab shares a host with the prod deployment and, before
// this model, shared its ntfy topic and publication app. Through the model it derives TestRisk,
// finds no TestRisk set, and REFUSES -- it does not receive the ProdRisk set that exists one row
// away.
test fn a_test_deployment_refuses_rather_than_resolving_the_prod_bindings() -> Bool {
  match resolve_deployment_bindings(
    selection: prod_role_selection,
    table: deployment_external_binding_table,
    deployment: srv1_lab_codex_feedback_deployment,
  ) {
    DeploymentBindingSetAbsent { deployment: d, class: TestRisk } => d == srv1_lab_codex_feedback_deployment
    _ => false
  }
}

// THE POSITIVE CONTROL, same row and table: the prod-role holder resolves today's topic and app.
// Without it the RED above would pass for a resolver that refuses everyone.
test fn the_prod_role_holder_resolves_the_prod_topic_and_app() -> Bool {
  match resolve_deployment_bindings(
    selection: prod_role_selection,
    table: deployment_external_binding_table,
    deployment: srv1_daily_workspace_deployment,
  ) {
    DeploymentBindingsResolved { deployment: _, class: _, bindings: b } =>
      b.approval_ntfy_topic == approval_ntfy_topic && b.publication_app == gunbai_bot_declared
    _ => false
  }
}

// NO BORROWING EVEN WHEN A TEST SET EXISTS. A fixture table carrying both classes: the test
// deployment gets ITS set's topic and app, and the prod one never leaks across. A resolver that
// returned "the first set" or "the prod set" would fail one of the two conjuncts.
data fx_test_topic: NtfyTopic = "gunbc-approvals-test" as NtfyTopic

data fx_both_classes: DeploymentExternalBindingTable = DeploymentExternalBindingTable {
  prod: Present { value: DeploymentExternalBindingSet { approval_ntfy_topic: approval_ntfy_topic, publication_app: gunbai_bot_declared } },
  test: Present { value: DeploymentExternalBindingSet { approval_ntfy_topic: fx_test_topic, publication_app: gunbai_ci_declared } },
}

test fn each_class_resolves_only_its_own_set() -> Bool {
  let test_side = match resolve_deployment_bindings(selection: prod_role_selection, table: fx_both_classes, deployment: srv1_lab_codex_feedback_deployment) {
    DeploymentBindingsResolved { deployment: _, class: _, bindings: b } => b.approval_ntfy_topic == fx_test_topic && b.publication_app != gunbai_bot_declared
    _ => false
  }
  let prod_side = match resolve_deployment_bindings(selection: prod_role_selection, table: fx_both_classes, deployment: srv1_daily_workspace_deployment) {
    DeploymentBindingsResolved { deployment: _, class: _, bindings: b } => b.approval_ntfy_topic == approval_ntfy_topic
    _ => false
  }
  test_side && prod_side
}

// ── The switch: one row moves prod, or turns it off ─────────────────────────────────────────────
test fn no_prod_role_makes_the_former_holder_test_risk_and_it_refuses() -> Bool {
  deployment_risk_class(selection: NoProdRole, deployment: srv1_daily_workspace_deployment) == TestRisk
    && match resolve_deployment_bindings(selection: NoProdRole, table: deployment_external_binding_table, deployment: srv1_daily_workspace_deployment) {
      DeploymentBindingSetAbsent { deployment: _, class: TestRisk } => true
      _ => false
    }
}

test fn moving_the_role_moves_the_class_and_nothing_else_decides_it() -> Bool {
  let moved = ProdRoleHeldBy { deployment: srv2_deploy_deployment }
  deployment_risk_class(selection: moved, deployment: srv2_deploy_deployment) == ProdRisk
    && deployment_risk_class(selection: moved, deployment: srv1_daily_workspace_deployment) == TestRisk
}

// ── Every dashboard instance answers, through its deployment ────────────────────────────────────
// All six constructors, against the real row: exactly the daily workspace derives ProdRisk.
fn dashboard_instances() -> List<HostDashboardInstance> {
  [
    macbook_local_dashboard_instance(),
    srv1_live_dashboard_instance(),
    srv1_lab_dashboard_instance(),
    srv2_preview_dashboard_instance(),
    srv2_deploy_dashboard_instance(),
    srv2_lab_dashboard_instance(),
  ]
}

test fn exactly_one_dashboard_instance_derives_prod_risk_and_it_is_the_daily_workspace() -> Bool {
  let prod = filter(dashboard_instances(), i => dashboard_instance_risk_class(instance: i) == ProdRisk)
  count(prod) == 1 && all(prod, i => i.deployment == srv1_daily_workspace_deployment)
}

// THE FAILURE-MODE ROW RESOLVES AND NAMES THIS WITNESS AS ITS EVIDENCE, so a rename here cannot
// leave the row citing a declaration that no longer exists.
test fn the_wrong_instance_failure_mode_row_cites_this_red() -> Bool {
  any(a_test_deployment_acts_on_the_prod_deployments_state.evidence, r => r.decl_name == "a_test_deployment_refuses_rather_than_resolving_the_prod_bindings")
}

// ── The role-following singletons, at the TRANSITION boundary ───────────────────────────────────
// Every claim below reads what an apply would actually be handed: the roster's specs built under a
// supplied realization (deployment_spec_for_under), the convergence decision over supplied per-host
// readings, and the emitted GCP IAM job. The production entry points run the same functions over
// prod_role_selection and a real observation; the positive control at the end is over those.
fn fx_moved() -> ProdRoleRealization {
  prod_role_realization_in(selection: ProdRoleHeldBy { deployment: srv2_deploy_deployment }, instances: public_builtin_dashboard_instances())
}

fn fx_unheld() -> ProdRoleRealization {
  prod_role_realization_in(selection: NoProdRole, instances: public_builtin_dashboard_instances())
}

fn roster_specs_under(realization: ProdRoleRealization) -> List<DeploymentSpec> {
  map(desired_deployment_roster(), r => deployment_spec_for_under(realization: realization, instance: r.instance, target: r.target, names: r.names))
}

fn spec_store_directory_count(spec: DeploymentSpec) -> Int {
  count(spec.steps |> filter(s => match s {
    Dependency { step } => match step.kind { FabricStorageStoreDirectory => true  _ => false }
    ArtifactStep { step: _ } => false
  }))
}

fn spec_store_artifact_count(spec: DeploymentSpec) -> Int {
  count(spec.steps |> filter(s => match s {
    ArtifactStep { step } => match step.kind { FabricStorageServeUnit => true  FabricStorageServeMapping => true  _ => false }
    Dependency { step: _ } => false
  }))
}

fn spec_holds_no_singleton(spec: DeploymentSpec) -> Bool {
  spec_store_directory_count(spec: spec) == 0
    && spec_store_artifact_count(spec: spec) == 0
    && !deployment_owns_the_host_approval_broker(spec: spec)
    && match deployment_fabric_storage_door_socket(spec: spec) { Absent => true  Present { value: _ } => false }
}

fn is_srv2_deploy(spec: DeploymentSpec) -> Bool {
  (spec.instance_id as String) == (srv2_deploy_dashboard_instance().instance_id as String)
}

// THE DISCRIMINATING RED. Move the role to srv2-deploy: the srv2 spec carries EVERY store directory,
// the unit and route, the broker, and its own door socket; both srv1 specs carry none of them. A pin
// back to srv1 by name, or directories left on the srv1 target, fails it.
test fn moving_the_prod_role_moves_every_role_singleton_member_to_the_new_holders_spec() -> Bool {
  let specs = roster_specs_under(realization: fx_moved())
  let srv2 = specs |> filter(s => is_srv2_deploy(spec: s))
  let others = specs |> filter(s => !is_srv2_deploy(spec: s))
  let want_dirs = count(fabric_storage_store_directories_for(instance: srv2_deploy_dashboard_instance()))
  count(srv2) == 1
    && count(others) > 0
    && want_dirs > 0
    && all(srv2, s =>
      spec_store_directory_count(spec: s) == want_dirs
        && spec_store_artifact_count(spec: s) == 2
        && deployment_owns_the_host_approval_broker(spec: s)
        && match deployment_fabric_storage_door_socket(spec: s) {
          Present { value: k } => (k as String) == (fabric_storage_door_socket(instance: srv2_deploy_dashboard_instance()) as String)
          Absent => false
        }
    )
    && all(others, s => spec_holds_no_singleton(spec: s))
}

// UNDER NoProdRole NO TARGET GETS A DIRECTORY, A UNIT, A ROUTE OR THE BROKER, and every role-follower
// refuses with the realization's typed cause.
test fn under_no_prod_role_no_spec_holds_a_role_singleton_and_every_follower_refuses() -> Bool {
  let unheld = fx_unheld()
  let placement_refused = match fabric_storage_placement_under(realization: unheld) {
    FabricStoragePlacementRefused { cause: ProdRoleUnheld } => true
    _ => false
  }
  let origin_refused = match approval_loopback_origin_under(realization: unheld) {
    ApprovalLoopbackOriginRefused { cause: ProdRoleUnheld } => true
    _ => false
  }
  all(roster_specs_under(realization: unheld), s => spec_holds_no_singleton(spec: s))
    && placement_refused
    && origin_refused
}

// A HOLDER WITH NO REALIZATION REFUSES TOO, rather than resolving "the first instance".
test fn a_prod_role_holder_with_no_instance_refuses_as_unrealized() -> Bool {
  let ghost = deployment_id(name: "no-such-deployment" as NonEmptyStr)
  match prod_role_realization_in(selection: ProdRoleHeldBy { deployment: ghost }, instances: public_builtin_dashboard_instances()) {
    ProdRoleRealizationRefused { cause: ProdRoleHolderUnrealized { deployment: d } } => d == ghost
    _ => false
  }
}

// ── The convergence transitions, over supplied per-host readings ────────────────────────────────
fn read_on(host: String, holders: List<DeploymentId>, broker: Bool) -> HostRoleSingletonReading {
  HostRoleSingletonsRead { host: host as NonEmptyStr, holders: holders, broker_present: broker }
}

fn decide(desired: ProdRoleRealization, readings: List<HostRoleSingletonReading>) -> RoleSingletonConvergence {
  role_singleton_convergence(desired: desired, observed: role_singleton_observation_of(readings: readings))
}

test fn a_moved_role_with_the_old_holder_still_observed_refuses_as_a_move() -> Bool {
  match decide(desired: fx_moved(), readings: [read_on(host: "srv1", holders: [srv1_daily_workspace_deployment], broker: true), read_on(host: "srv2", holders: [], broker: false)]) {
    RoleSingletonRefused { cause: RoleSingletonMoveUnimplemented { observed: o, desired: d } } => o == srv1_daily_workspace_deployment && d == srv2_deploy_deployment
    _ => false
  }
}

test fn no_prod_role_with_a_holder_observed_refuses_as_a_removal() -> Bool {
  match decide(desired: fx_unheld(), readings: [read_on(host: "srv1", holders: [srv1_daily_workspace_deployment], broker: true)]) {
    RoleSingletonRefused { cause: RoleSingletonRemovalUnimplemented { observed: o } } => o == srv1_daily_workspace_deployment
    _ => false
  }
}

// UNOBSERVED IS NOT ABSENT: with srv1 unreadable and srv2 empty, the moved role must NOT install.
test fn an_unobservable_roster_host_refuses_rather_than_reading_as_absent() -> Bool {
  match decide(desired: fx_moved(), readings: [HostRoleSingletonsUnobservable { host: "srv1" as NonEmptyStr, cause: "ssh refused" }, read_on(host: "srv2", holders: [], broker: false)]) {
    RoleSingletonRefused { cause: RoleSingletonHostUnobservable { host: h, cause: _ } } => (h as String) == "srv1"
    _ => false
  }
}

test fn nothing_observed_and_a_valid_holder_installs_on_that_holder() -> Bool {
  match decide(desired: fx_moved(), readings: [read_on(host: "srv1", holders: [], broker: false), read_on(host: "srv2", holders: [], broker: false)]) {
    RoleSingletonInstall { holder } => holder.instance.deployment == srv2_deploy_deployment
    _ => false
  }
}

test fn the_observed_holder_equal_to_the_desired_one_is_a_noop() -> Bool {
  match decide(desired: fx_moved(), readings: [read_on(host: "srv1", holders: [], broker: false), read_on(host: "srv2", holders: [srv2_deploy_deployment], broker: true)]) {
    RoleSingletonNoop => true
    _ => false
  }
}

test fn two_observed_holders_or_an_ownerless_broker_refuse() -> Bool {
  let two = match decide(desired: fx_moved(), readings: [read_on(host: "srv1", holders: [srv1_daily_workspace_deployment], broker: true), read_on(host: "srv2", holders: [srv2_deploy_deployment], broker: true)]) {
    RoleSingletonRefused { cause: RoleSingletonHoldersAmbiguous { observed: os } } => count(os) == 2
    _ => false
  }
  let ownerless = match decide(desired: fx_moved(), readings: [read_on(host: "srv1", holders: [], broker: true), read_on(host: "srv2", holders: [], broker: false)]) {
    RoleSingletonRefused { cause: RoleSingletonOwnerUnmapped { host: h } } => (h as String) == "srv1"
    _ => false
  }
  two && ownerless
}

// ── The emitted GCP IAM job follows the holder ──────────────────────────────────────────────────
test fn the_gcp_iam_job_runs_on_the_holders_host_and_is_refused_under_no_prod_role() -> Bool {
  let moved = fleet_converge_gcp_iam_converge_job_under(realization: fx_moved())
  let unheld = fleet_converge_gcp_iam_converge_job_under(realization: fx_unheld())
  let srv2_host = srv2_deploy_dashboard_instance().host_identity as String
  let srv1_host = srv1_live_dashboard_instance().host_identity as String
  let moved_labels = match moved.runner { SelfHosted { labels } => labels  _ => [] }
  let unheld_labels = match unheld.runner { SelfHosted { labels } => labels  _ => [] }
  let unheld_refuses = any(unheld.steps, st => match st {
    RunStep { name: _, id: _, run, shell: _, env: _, working_directory: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } =>
      string_contains(s: run, pattern: "REFUSED") && string_contains(s: run, pattern: "NoProdRole")
    _ => false
  })
  any(moved_labels, l => l == srv2_host)
    && !any(moved_labels, l => l == srv1_host)
    && !any(unheld_labels, l => l == srv1_host || l == srv2_host)
    && count(unheld.steps) == 1
    && unheld_refuses
}

// ── THE POSITIVE CONTROL, over the REAL selection and roster ────────────────────────────────────
// Today the daily-workspace deployment (srv1-live) holds the role: its spec carries every singleton
// member, srv1's lab and srv2-deploy carry none, the GCP IAM job runs on srv1, and the real
// realization with the role's singletons observed on srv1-live is a Noop. Without it the REDs above
// would pass for constructions that place nothing anywhere.
test fn the_real_selection_places_every_singleton_on_its_holder_and_converges_as_noop() -> Bool {
  let real = prod_role_realization()
  let specs = roster_specs_under(realization: real)
  let live_id = srv1_live_dashboard_instance().instance_id as String
  let live = specs |> filter(s => (s.instance_id as String) == live_id)
  let others = specs |> filter(s => !((s.instance_id as String) == live_id))
  let job_labels = match fleet_converge_gcp_iam_converge_job_under(realization: real).runner { SelfHosted { labels } => labels  _ => [] }
  let noop = match decide(desired: real, readings: [read_on(host: "srv1", holders: [srv1_daily_workspace_deployment], broker: true), read_on(host: "srv2", holders: [], broker: false)]) {
    RoleSingletonNoop => true
    _ => false
  }
  count(live) == 1
    && all(live, s => spec_store_directory_count(spec: s) > 0 && spec_store_artifact_count(spec: s) == 2 && deployment_owns_the_host_approval_broker(spec: s))
    && all(others, s => spec_holds_no_singleton(spec: s))
    && any(job_labels, l => l == (srv1_live_dashboard_instance().host_identity as String))
    && noop
}

// ── The broker is GIVEN its address, at the emitted-unit boundary ───────────────────────────────
// The broker unit's Environment= line is built from the spec's holder token: srv2's base URL when the
// role moves to srv2-deploy, srv1's under today's selection, and the refusal marker -- which the
// broker's own read rejects as not an https URL -- for a spec holding no role.
fn broker_env_assignment(spec: DeploymentSpec) -> String {
  match approval_broker_base_url_environment(spec: spec) {
    Environment { assignment } => assignment as String
    _ => ""
  }
}

fn bound(value: String) -> String {
  join([approval_broker_base_url_env_name as String, "=", value], "")
}

test fn the_broker_unit_is_given_the_holders_base_url_and_a_non_holder_gets_a_refusal() -> Bool {
  let moved = roster_specs_under(realization: fx_moved())
  let real = roster_specs_under(realization: prod_role_realization())
  let srv2_moved = moved |> filter(s => is_srv2_deploy(spec: s))
  let srv1_moved = moved |> filter(s => (s.instance_id as String) == (srv1_live_dashboard_instance().instance_id as String))
  let live_real = real |> filter(s => (s.instance_id as String) == (srv1_live_dashboard_instance().instance_id as String))
  count(srv2_moved) == 1 && count(srv1_moved) == 1 && count(live_real) == 1
    && all(srv2_moved, s => starts_with(s: broker_env_assignment(spec: s), prefix: bound(value: "https://srv2.")))
    && all(live_real, s => starts_with(s: broker_env_assignment(spec: s), prefix: bound(value: "https://srv1.")))
    && all(srv1_moved, s => broker_env_assignment(spec: s) == bound(value: approval_broker_base_url_unbound_marker))
    && match approval_broker_serving_base_url_of(bound: Present { value: approval_broker_base_url_unbound_marker }) { ApprovalBrokerAddressRefused { detail: _ } => true  _ => false }
    && match approval_broker_serving_base_url_of(bound: none) { ApprovalBrokerAddressRefused { detail: _ } => true  _ => false }
}
