  approval_loopback_origin_under,
  approval_loopback_origin_of,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// ── The discriminating RED: a TestRisk deployment never reaches the prod attachments ────────────
// THE REAL ROW AND THE REAL TABLE. The srv1 lab shares a host with the prod deployment and, before
// this model, shared its ntfy topic and publication app. Through the model it derives TestRisk,
// finds no TestRisk set, and REFUSES -- it does not receive the ProdRisk set that exists one row
// away.
test fn a_test_deployment_refuses_rather_than_resolving_the_prod_bindings() -> Bool {
  match resolve_deployment_bindings(
    selection: prod_role_selection,
    sets: deployment_external_binding_sets,
    deployment: srv1_lab_codex_feedback_deployment,
  ) {
    DeploymentBindingSetAbsent { deployment: d, class: TestRisk } => d == srv1_lab_codex_feedback_deployment
    _ => false
  }
}

// THE POSITIVE CONTROL, same row and table: the prod-role holder resolves today's topic and app.
// Without it the RED above would pass for a resolver that refuses everyone.
test fn the_prod_role_holder_resolves_the_prod_topic_and_app() -> Bool {
  match resolve_deployment_bindings(
    selection: prod_role_selection,
    sets: deployment_external_binding_sets,
    deployment: srv1_daily_workspace_deployment,
  ) {
    DeploymentBindingsResolved { deployment: _, bindings: b } =>
      b.approval_ntfy_topic == approval_ntfy_topic && b.publication_app == gunbai_bot_declared
    _ => false
  }
}

// NO BORROWING EVEN WHEN A TEST SET EXISTS. A fixture table carrying both classes: the test
// deployment gets ITS set's topic and app, and the prod one never leaks across. A resolver that
// returned "the first set" or "the prod set" would fail one of the two conjuncts.
data fx_test_topic: NtfyTopic = "gunbc-approvals-test" as NtfyTopic

data fx_prod_set: DeploymentExternalBindingSet = DeploymentExternalBindingSet { class: ProdRisk, approval_ntfy_topic: approval_ntfy_topic, publication_app: gunbai_bot_declared }

data fx_both_classes: List<DeploymentExternalBindingSet> = [
  fx_prod_set,
  DeploymentExternalBindingSet { class: TestRisk, approval_ntfy_topic: fx_test_topic, publication_app: gunbai_ci_declared },
]

test fn each_class_resolves_only_its_own_set() -> Bool {
  let test_side = match resolve_deployment_bindings(selection: prod_role_selection, sets: fx_both_classes, deployment: srv1_lab_codex_feedback_deployment) {
    DeploymentBindingsResolved { deployment: _, bindings: b } => b.approval_ntfy_topic == fx_test_topic && b.publication_app != gunbai_bot_declared
    _ => false
  }
  let prod_side = match resolve_deployment_bindings(selection: prod_role_selection, sets: fx_both_classes, deployment: srv1_daily_workspace_deployment) {
    DeploymentBindingsResolved { deployment: _, bindings: b } => b.approval_ntfy_topic == approval_ntfy_topic
    _ => false
  }
  test_side && prod_side
}

// TWO SETS FOR ONE CLASS IS A REFUSAL, not a first-match.
test fn two_sets_for_one_class_refuse_as_ambiguous() -> Bool {
  let doubled = [fx_prod_set, fx_prod_set]
  match resolve_deployment_bindings(selection: prod_role_selection, sets: doubled, deployment: srv1_daily_workspace_deployment) {
    DeploymentBindingSetAmbiguous { deployment: _, class: ProdRisk, count: 2 } => true
    _ => false
  }
}

// ── The switch: one row moves prod, or turns it off ─────────────────────────────────────────────
test fn no_prod_role_makes_the_former_holder_test_risk_and_it_refuses() -> Bool {
  deployment_risk_class(selection: NoProdRole, deployment: srv1_daily_workspace_deployment) == TestRisk
    && match resolve_deployment_bindings(selection: NoProdRole, sets: deployment_external_binding_sets, deployment: srv1_daily_workspace_deployment) {
      DeploymentBindingSetAbsent { deployment: _, class: TestRisk } => true
      _ => false
    }
}

test fn moving_the_role_moves_the_class_and_nothing_else_decides_it() -> Bool {
  let moved = ProdRoleHeldBy { deployment: srv2_deploy_deployment }
  deployment_risk_class(selection: moved, deployment: srv2_deploy_deployment) == ProdRisk
    && deployment_risk_class(selection: moved, deployment: srv1_daily_workspace_deployment) == TestRisk
}

// ── Every dashboard instance answers, through its deployment ────────────────────────────────────
// All six constructors, against the real row: exactly the daily workspace derives ProdRisk.
fn dashboard_instances() -> List<HostDashboardInstance> {
  [
    macbook_local_dashboard_instance(),
    srv1_live_dashboard_instance(),
    srv1_lab_dashboard_instance(),
    srv2_preview_dashboard_instance(),
    srv2_deploy_dashboard_instance(),
    srv2_lab_dashboard_instance(),
  ]
}

test fn exactly_one_dashboard_instance_derives_prod_risk_and_it_is_the_daily_workspace() -> Bool {
  let prod = filter(dashboard_instances(), i => dashboard_instance_risk_class(instance: i) == ProdRisk)
  count(prod) == 1 && all(prod, i => i.deployment == srv1_daily_workspace_deployment)
}

// THE FAILURE-MODE ROW RESOLVES AND NAMES THIS WITNESS AS ITS EVIDENCE, so a rename here cannot
// leave the row citing a declaration that no longer exists.
test fn the_wrong_instance_failure_mode_row_cites_this_red() -> Bool {
  any(a_test_deployment_acts_on_the_prod_deployments_state.evidence, r => r.decl_name == "a_test_deployment_refuses_rather_than_resolving_the_prod_bindings")
}

// ── The role-following singletons: broker owner, fabric storage placement, approval origin ──────
// THE DISCRIMINATING RED (deployment-risk plan, deliverable 2). A FIXTURE selection moves the role
// to srv2-deploy over the REAL instance roster, and every singleton that follows the role moves with
// it: the broker owner is srv2-deploy and no longer srv1-live, the fabric store is placed on
// srv2-deploy and not on srv1-live, and approvals are reached at srv2-deploy's listen address. A pin
// back to srv1 by name -- an instance_id literal, srv1_live_dashboard_instance(), operator_host_srv1
// -- keeps answering srv1-live and fails the srv1-negative conjuncts.
fn fx_moved_realization() -> ProdRoleRealization {
  prod_role_realization_in(
    selection: ProdRoleHeldBy { deployment: srv2_deploy_deployment },
    instances: public_builtin_dashboard_instances(),
  )
}

test fn moving_the_prod_role_moves_the_broker_owner_and_the_fabric_storage_placement() -> Bool {
  let moved = fx_moved_realization()
  let srv2 = srv2_deploy_dashboard_instance()
  let srv1 = srv1_live_dashboard_instance()
  let origin_moved = match approval_loopback_origin_under(realization: moved) {
    ApprovalLoopbackOriginResolved { origin } =>
      (origin as String) == (approval_loopback_origin_of(instance: srv2) as String)
        && !((origin as String) == (approval_loopback_origin_of(instance: srv1) as String))
    ApprovalLoopbackOriginRefused { cause: _ } => false
  }
  instance_owns_the_host_approval_broker_under(realization: moved, instance_id: srv2.instance_id)
    && !instance_owns_the_host_approval_broker_under(realization: moved, instance_id: srv1.instance_id)
    && fabric_storage_placed_on_under(realization: moved, instance: srv2)
    && !fabric_storage_placed_on_under(realization: moved, instance: srv1)
    && origin_moved
}

// UNDER NoProdRole EVERY ROLE-FOLLOWER REFUSES WITH THE TYPED CAUSE -- nobody owns the broker, the
// store is not placed anywhere, and approvals have no origin. A fallback to srv1 fails every conjunct.
test fn under_no_prod_role_the_broker_owner_and_the_fabric_storage_placement_refuse() -> Bool {
  let none = prod_role_realization_in(selection: NoProdRole, instances: public_builtin_dashboard_instances())
  let realization_refused = match none {
    ProdRoleRealizationRefused { cause: ProdRoleUnheld } => true
    _ => false
  }
  let placement_refused = match fabric_storage_placement_under(realization: none) {
    FabricStoragePlacementRefused { cause: ProdRoleUnheld } => true
    _ => false
  }
  let origin_refused = match approval_loopback_origin_under(realization: none) {
    ApprovalLoopbackOriginRefused { cause: ProdRoleUnheld } => true
    _ => false
  }
  realization_refused
    && placement_refused
    && origin_refused
    && all(public_builtin_dashboard_instances(), i =>
      !instance_owns_the_host_approval_broker_under(realization: none, instance_id: i.instance_id)
        && !fabric_storage_placed_on_under(realization: none, instance: i)
    )
}

// A HOLDER WITH NO REALIZATION REFUSES TOO, rather than resolving "the first instance".
test fn a_prod_role_holder_with_no_instance_refuses_as_unrealized() -> Bool {
  let ghost = deployment_id(name: "no-such-deployment" as NonEmptyStr)
  match prod_role_realization_in(selection: ProdRoleHeldBy { deployment: ghost }, instances: public_builtin_dashboard_instances()) {
    ProdRoleRealizationRefused { cause: ProdRoleHolderUnrealized { deployment: d } } => d == ghost
    _ => false
  }
}

// THE POSITIVE CONTROL, over the REAL selection and the production entry points: today srv1-live
// realizes the holder, owns the broker and holds the placement, and srv1's lab does neither. Without
// it the REDs above would pass for resolvers that refuse everyone.
test fn the_real_selection_places_the_broker_and_the_store_on_its_holder() -> Bool {
  let real = prod_role_realization()
  let live = srv1_live_dashboard_instance()
  let lab = srv1_lab_dashboard_instance()
  let holder_is_live = match real {
    ProdRoleRealizedBy { instance } => (instance.instance_id as String) == (live.instance_id as String)
    ProdRoleRealizationRefused { cause: _ } => false
  }
  holder_is_live
    && instance_owns_the_host_approval_broker_under(realization: real, instance_id: live.instance_id)
    && !instance_owns_the_host_approval_broker_under(realization: real, instance_id: lab.instance_id)
    && fabric_storage_placed_on_under(realization: real, instance: live)
    && !fabric_storage_placed_on_under(realization: real, instance: lab)
}
