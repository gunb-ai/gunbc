module test.claim.type_argument_kind_inhabitance_witness

import gunbc.compile_diagnostic_census {
  CompileDiagnosticCensusRow,
  CensusObserved,
  CensusNotRunnable,
  census_blocking_rows,
  census_rows_of_class,
  census_total_count,
  censuses_differ_by_exactly_the_target_key,
}
import std.types { String, Bool, Int }

// THE WALL THAT MAKES A KINDED TYPE PARAMETER MEAN SOMETHING, AND ITS POSITIVE CONTROL.
// Class rows: gunbc.recurring_failure_mode.single_arm_sum_parses_as_an_alias_and_becomes_unreadable
// and .type_variable_means_both_declared_generic_and_inference_variable.
//
// WHY THIS FILE EXISTS AT ALL. gunbc#11819 recorded three refusals firing with located
// diagnostics AND the kind's own declared inhabitant refusing alongside them. A wall that refuses
// everything has meaningless reds, so none of those three were citable -- the PR said so itself.
// The discriminating pair is therefore the whole point: the same wall must refuse a non-inhabitant
// and ADMIT the declared one, on one run, or it has established nothing in either direction.
//
// THE ORACLE NAMES THE CLASS, NOT THE OUTCOME, for the reason
// test.claim.optional_at_required_position_witness states at its own oracle: a
// compiles/does-not-compile boolean stays red through ANY refusal, so a RED here would keep
// reporting this wall while TypeArgumentKindMismatch never fired. Each RED counts blocking rows of
// the named class; each control asserts ZERO of that class. -1 on the not-runnable arm keeps
// could-not-measure out of both >= 1 and == 0.
//
// THE SOURCES DECLARE THEIR OWN KIND AND DO NOT IMPORT std.machine_constraints. That is
// deliberate and it is what lets this file run: compile_dag_diagnostic_census resolves synthetic
// sources against the live checkout, and a module that leans on live-tree CONTENT must declare
// ReadsLiveTree, which the required floor declines before the fold sees it -- authored evidence
// rather than enrolled. A self-contained kind tests the MECHANISM (does a kinded position consult
// the kind's declared arms) rather than one corpus declaration, so it is both stronger evidence
// and executable. The corpus-level reading -- that std.integer's four live
// MachineWidth<PointerWidth> sites compile -- is integration evidence reported in the PR, not a
// second copy of this claim.
//
// TWO ARMS, NOT ONE, AND DO NOT SIMPLIFY IT. WidthResolution is a two-arm coproduct here for the
// same measured reason std.machine_constraints gives: a single-arm `type K = A` parses as a TYPE
// ALIAS, reaches the check as a bare nominal with no resolved target and no children, and the wall
// then refuses its own inhabitant with no diagnostic saying why.
//
// dissolve-on: none -- permanent regression control per DESIGN 4b(4).

fn kind_mismatch_blocking_count(source: String) -> Int {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: rows } =>
      census_total_count(rows: census_blocking_rows(rows: census_rows_of_class(rows: rows, wanted: "TypeArgumentKindMismatch")))
    CensusNotRunnable { cause: _ } => -1
  }
}

// ONE COUNTER PER CAUSE CLASS. Each forwarded refusal now mints its OWN CompilerDiagnostic
// constructor (src/v1/00_core.dag), so a row asserts on the class that names its own cause instead
// of on the inhabitant-list class. That is what makes the negatives discriminate: with the judgment
// removed, main's refusal lands under TypeArgumentKindMismatch, a DIFFERENT class, so a row counting
// ForwardedParameterUnkinded goes green when the machinery is taken away and stays red while it runs.
// Counting the shared class would have measured "some kind refusal happened", which the wall that
// refuses everything also satisfies.
fn forwarded_cause_blocking_count(source: String, cause: String) -> Int {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: rows } =>
      census_total_count(rows: census_blocking_rows(rows: census_rows_of_class(rows: rows, wanted: cause)))
    CensusNotRunnable { cause: _ } => -1
  }
}

fn type_param_value_position_blocking_count(source: String) -> Int {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: rows } =>
      census_total_count(rows: census_blocking_rows(rows: census_rows_of_class(rows: rows, wanted: "TypeParameterInValuePosition")))
    CensusNotRunnable { cause: _ } => -1
  }
}

fn kind_named_non_inhabitant_source() -> String {
  "module kindprobe.neg_named\n\nimport std.types { Int, String }\n\ntype WidthResolution\n  = StaticWidthIndex\n  | PointerWidth\n\ntype Phantom\ntype Width<bits: WidthResolution> = Phantom\n\ntype Use = Width<String>\n\n"
}

// A plain String where the kind admits StaticWidthIndex or PointerWidth.
test fn a_named_non_inhabitant_at_a_kinded_position_must_refuse() -> Bool {
  kind_mismatch_blocking_count(source: kind_named_non_inhabitant_source()) >= 1
}

fn kind_unrelated_type_source() -> String {
  "module kindprobe.neg_unrelated\n\nimport std.types { Int, String }\n\ntype WidthResolution\n  = StaticWidthIndex\n  | PointerWidth\n\ntype Phantom\ntype Width<bits: WidthResolution> = Phantom\n\ntype UnrelatedType\ntype Use = Width<UnrelatedType>\n\n"
}

// THE RED THAT SEPARATES THIS WALL FROM A SHAPE PROXY. UnrelatedType is bodyless and therefore
// STRUCTURALLY IDENTICAL to the arms it is being offered against. Only a check consulting the
// kind's DECLARED arms can refuse it; a check reading variant shape admits it. This is the
// property five candidate carriers were chasing, and it is the reason the kind is a coproduct.
test fn a_bodyless_type_of_the_same_shape_as_an_arm_must_still_refuse() -> Bool {
  kind_mismatch_blocking_count(source: kind_unrelated_type_source()) >= 1
}

fn type_param_in_value_position_source() -> String {
  "module kindprobe.neg_valuepos\n\nimport std.types { Int, String }\n\ntype WidthResolution\n  = StaticWidthIndex\n  | PointerWidth\n\ntype Phantom\ntype Width<bits: WidthResolution> = Phantom\n\nfn any_param<T>(x: T) -> Int {\n  T\n}\n\n"
}

// THIS IS A REGRESSION CONTROL FOR A WALL THAT NOW FIRES. The assertion reads forwards.
//
// A type parameter is not a value: `T` in the body of `fn any_param<T>(x: T) -> Int` names a TYPE
// where a value is required. v1.std.core declares TypeParameterInValuePosition with SeverityError
// and GateBlocking, and v1.compiler.infer constructs it at two sites, guarded by
// name_is_enclosing_declared_type_parameter, which asks the DECLARED type-parameter roster carried
// on InferScope rather than a binding's inferred provenance. So a lambda binder whose inferred type
// is still a variable is never mistaken for a type parameter.
//
// THIS CLAIM WAS A PINNED HOLE AND IT CLIMBED. Until the stage0 mirror carried that predicate, the
// seed stood a literal-`false` stub in its place, the refusal was unreachable, and this claim
// asserted the silence (== 0) so that its red would be the signal. The regen that carried
// v1.compiler.infer into the seed (gunbc#12045) removed the stub. The pinned assertion then went
// red on a built compiler: claim_batch on a clean tree at ada85b9 FAILED it, while
// a_generic_function_not_misusing_its_parameter_still_compiles and
// a_named_non_inhabitant_at_a_kinded_position_must_refuse PASSED on the same run. Per the hole's
// own instruction the assertion flips to the refusal and STAYS as the permanent regression control
// (DESIGN 4b(4): dissolution on climb retires production handling, never the evidence).
//
// WHY >= 1 AND NOT == 1: the claim is that the wall FIRES at its own location, not how many
// construction sites reach this fixture. The -1 arm (CensusNotRunnable) fails >= 1, so a harness
// that cannot reach the judgment is red here rather than read as a refusal.
//
// ITS POSITIVE CONTROL is a_generic_function_not_misusing_its_parameter_still_compiles below: the
// same shape of generic function, returning its VALUE parameter, compiles and emits. Without it a
// wall that refused every generic function would pass this claim.
test fn a_type_parameter_in_value_position_must_refuse() -> Bool {
  type_param_value_position_blocking_count(source: type_param_in_value_position_source()) >= 1
}

fn kind_declared_inhabitant_source() -> String {
  "module kindprobe.pos_inhabitant\n\nimport std.types { Int, String }\n\ntype WidthResolution\n  = StaticWidthIndex\n  | PointerWidth\n\ntype Phantom\ntype Width<bits: WidthResolution> = Phantom\n\ntype Use = Width<PointerWidth>\n\n"
}

// ── WHY THE POSITIVES ALSO REQUIRE EMISSION, AND WHY A DIFFERENTIAL DOES NOT WORK HERE ───────
//
// AN EXTERNAL REVIEW RAISED A REAL HOLE: a positive control asserting ZERO rows of ONE named class
// stays green when its fixture is rejected for some OTHER blocking reason. It measures the absence
// of one diagnostic, not admission. That is this PR's own subject one layer out.
//
// THE REPAIR IS compile_dag_rust_emit_check, the same instrument
// test.claim.optional_at_required_position_witness uses on its own positives. Emission cannot
// succeed over ANY blocking diagnostic, so a fixture rejected for an unrelated reason now fails
// instead of passing as a control -- and it is the stronger reading besides, since it establishes
// that the admitted program EMITS rather than merely that one diagnostic is absent.
//
// THE REVIEW'S OTHER SUGGESTION -- require zero TOTAL blocking diagnostics -- IS REFUSED, in
// gunbc.compile_diagnostic_census's own words: the row set is the whole compile's, closure
// included, so "a witness reading census_total_count == 0 as 'the fixture still compiles' is
// asserting a property of the corpus, and on any importing fixture that assertion is permanently
// false: a check whose RED is unauthorable, which DESIGN 4b names a decoration rather than a weak
// wall." These fixtures import std.types, so they import a closure.
//
// A DIFFERENTIAL WAS TRIED AND DOES NOT HOLD HERE. RECORDED SO THE NEXT READER DOES NOT RE-WALK IT.
// That module names a second exact form: a differential between two censuses whose sources differ
// on one axis, where the shared closure cancels. Two sources identical but for the type argument
// were built and compared with censuses_differ_by_exactly_the_target_key. It FAILED, and bisecting
// it by execution showed the comparator was right and the claim was wrong:
//   red_has_the_key_once                 PASS  (class, subject 'Width' and blocking are scoped right)
//   green_has_the_key_zero               PASS  (the wall genuinely admits the inhabitant)
//   blocking_totals_differ_by_exactly_one FAIL
//   total_row_counts_differ_by_exactly_one FAIL
// So the substitution changes MORE than the one key: a refused type argument leaves the declaration
// that used it unresolved, and that cascades further rows in the same compile. The refusal is not
// its own only consequence, which is precisely the condition a one-axis differential requires.
// Anchoring the unused declaration in both sources did not fix it, because the cascade is
// downstream of the refusal rather than of the spelling. The differential was removed rather than
// widened -- a comparator tuned until it agrees is the defect this file exists to catch.
// THE POSITIVE CONTROL, AND THE DEFECT gunbc#11819 LEFT OPEN. Until this passes, every red above
// is meaningless: a wall that refuses its own declared inhabitant refuses everything, and refusing
// everything is not discrimination. This claim is what makes the other three citable.
test fn the_kinds_own_declared_inhabitant_must_be_admitted() -> Bool {
  kind_mismatch_blocking_count(source: kind_declared_inhabitant_source()) == 0
    && compile_dag_rust_emit_check(kind_declared_inhabitant_source(), "src/kindprobe_pos_inhabitant.rs", [], [])
}

fn kind_second_arm_source() -> String {
  "module kindprobe.pos_other_arm\n\nimport std.types { Int, String }\n\ntype WidthResolution\n  = StaticWidthIndex\n  | PointerWidth\n\ntype Phantom\ntype Width<bits: WidthResolution> = Phantom\n\ntype Use = Width<StaticWidthIndex>\n\n"
}

// THE SECOND ARM, because admitting exactly ONE name is indistinguishable from a hardcoded
// special case for that name. Both declared arms being admitted is what shows the check reads the
// kind's children rather than matching a spelling.
test fn the_kinds_other_arm_is_admitted_too_so_the_wall_is_not_pinned_to_one_name() -> Bool {
  kind_mismatch_blocking_count(source: kind_second_arm_source()) == 0
    && compile_dag_rust_emit_check(kind_second_arm_source(), "src/kindprobe_pos_other_arm.rs", [], [])
}

fn generic_fn_positive_source() -> String {
  "module kindprobe.pos_generic_fn\n\nimport std.types { Int, String }\n\ntype WidthResolution\n  = StaticWidthIndex\n  | PointerWidth\n\ntype Phantom\ntype Width<bits: WidthResolution> = Phantom\n\nfn passes_through<T>(x: T) -> T {\n  x\n}\n\n"
}

// The value-position wall's own control: a generic function that uses T only as a TYPE is
// ordinary and must not be caught.
test fn a_generic_function_not_misusing_its_parameter_still_compiles() -> Bool {
  type_param_value_position_blocking_count(source: generic_fn_positive_source()) == 0
    && compile_dag_rust_emit_check(generic_fn_positive_source(), "src/kindprobe_pos_generic_fn.rs", [], [])
}

// ================================================================================================
// THE FORWARDED-PARAMETER TIER: A PARAMETER OF THE ENCLOSING DECLARATION, USED AS A TYPE ARGUMENT.
// Class rows: gunbc.recurring_failure_mode.kind_wall_receives_a_de_identified_type_argument and
// .type_variable_means_both_declared_generic_and_inference_variable.
//
// WHAT THESE FOUR ROWS EXIST FOR. Until this PR, an argument that was a bound type parameter was
// ADMITTED because it was a type variable (arm 1) or because its bare name resolved to a binder
// (arm 4). Neither arm read a kind. So a parameter declared `Other` could be forwarded into a slot
// whose kind is `WidthResolution`, and nothing refused it: the silent widen DESIGN section 5 bans,
// and the defect PR #14327 deleted on the v2 side (`ArgumentTypeParameterUnjudged => acc`). The
// judgment now reads the kind the parameter's own declaration gives it and compares the two kinds
// by the declaration EACH ONE RESOLVES TO.
//
// WHY THE POSITIVE IS THE LOAD-BEARING ROW AND IS RED ON MAIN. Matching-kind forwarding is the
// obligation PR #14327 left named and unproduced: a parameter declared Quantity forwarded into a
// Quantity slot MUST be admitted, or the wall is a refusal machine. On main it is refused, because
// the binder the seed installed for a declaration's own parameters (`nominal_type_binding`, deleted
// here) carried no inferred type at all, so neither arm could see a parameter and the wall answered
// KindNotInhabited. That is what these rows measure: main refuses the one case that must pass, and
// this head admits it while still refusing the three that must not.
//
// THE THREE NEGATIVES ARE NOT GREEN ON MAIN FOR THE RIGHT REASON, and being told so is the point of
// running the revert in the PR. On main they refuse because nothing was ever recognized; with THIS
// PR'S REPAIR ALONE (the binder routed through env_with_type_variable_bindings, the judgment
// reverted to arm 1's old `if arg_is_type_var { KindInhabited }` and arm 4 restored) all three are
// ADMITTED, so each row goes red. That revert run is the discriminating evidence that the refusals
// come from the judgment and not from the fixture failing to reach resolve.
//
// EVERY FIXTURE MUST REACH RESOLVE, and no row here is greenable by a parse refusal: a fixture that
// never got to resolve yields ZERO rows of TypeArgumentKindMismatch, which fails each negative's
// `>= 1` and fails the positive's emit check as well. CensusNotRunnable answers -1, which fails
// both polarities. So a broken fixture is red on all five arms, never silently satisfied.
//
// THE GEOMETRY IS A TYPE DECLARATION'S OWN PARAMETER, deliberately. v1 indexes a type declaration's
// header parameters; an fn header's binder conjunct at its declaring path is the gap PR #14327 filed
// as gunbc.recurring_failure_mode.fn_type_parameter_header_is_never_indexed, and an fn-header forward
// is refused there as ForwardedParameterUnidentified. Asserting the positive over an fn header would
// therefore witness a different, still-open defect rather than this judgment.

fn forward_same_kind_source() -> String {
  "module kindprobe.pos_forward\n\nimport std.types { Int, String }\n\ntype WidthResolution\n  = StaticWidthIndex\n  | PointerWidth\n\ntype Phantom\ntype Width<bits: WidthResolution> = Phantom\n\ntype Box<T: WidthResolution> {\n  value: Width<T>\n}\n\n"
}

// THE MATCHING-KIND POSITIVE. `T` is Box's own parameter, declared `WidthResolution`, forwarded into
// Width's slot of that same kind. MUST ADMIT: zero rows of the class, and the module emits.
test fn a_forwarded_parameter_declaring_the_slots_kind_is_admitted() -> Bool {
  kind_mismatch_blocking_count(source: forward_same_kind_source()) == 0
    && compile_dag_rust_emit_check(forward_same_kind_source(), "src/kindprobe_pos_forward.rs", [], [])
}

fn forward_other_kind_source() -> String {
  "module kindprobe.neg_forward_kind\n\nimport std.types { Int, String }\n\ntype WidthResolution\n  = StaticWidthIndex\n  | PointerWidth\n\ntype Other\n  = Left\n  | Right\n\ntype Phantom\ntype Width<bits: WidthResolution> = Phantom\n\nfn uses_width(w: Width<StaticWidthIndex>) -> Int {\n  1\n}\n\ntype Box<T: Other> {\n  value: Width<T>\n}\n\n"
}

// THE DIFFERENT-KIND NEGATIVE. `T` is declared `Other`; the slot demands `WidthResolution`. MUST
// REFUSE, and it refuses at the judgment (ForwardedParameterKindUnresolved is impossible here -- both
// kinds resolve; the two declaring positions simply differ).
test fn a_forwarded_parameter_declaring_a_different_kind_must_refuse() -> Bool {
  forwarded_cause_blocking_count(source: forward_other_kind_source(), cause: "ForwardedParameterKindDiffers") >= 1
}

fn forward_unkinded_source() -> String {
  "module kindprobe.neg_forward_unkinded\n\nimport std.types { Int, String }\n\ntype WidthResolution\n  = StaticWidthIndex\n  | PointerWidth\n\ntype Phantom\ntype Width<bits: WidthResolution> = Phantom\n\nfn uses_width(w: Width<StaticWidthIndex>) -> Int {\n  1\n}\n\ntype Box<T> {\n  value: Width<T>\n}\n\n"
}

// THE UNKINDED NEGATIVE. `T` declares no kind at all, so inhabiting `WidthResolution` cannot be shown.
// MUST REFUSE, with its own cause (ForwardedParameterUnkinded) rather than the different-kind one:
// an unknown is not a mismatch, and collapsing them would hide which link in the chain was missing.
test fn a_forwarded_unkinded_parameter_must_refuse() -> Bool {
  forwarded_cause_blocking_count(source: forward_unkinded_source(), cause: "ForwardedParameterUnkinded") >= 1
}

fn forward_lookalike_kind_source() -> String {
  "module kindprobe.neg_forward_lookalike\n\nimport std.types { Int, String }\n\ntype WidthResolution\n  = StaticWidthIndex\n  | PointerWidth\n\ntype Lookalike\n  = StaticWidthIndex\n  | PointerWidth\n\ntype Phantom\ntype Width<bits: WidthResolution> = Phantom\n\nfn uses_width(w: Width<StaticWidthIndex>) -> Int {\n  1\n}\n\ntype Box<T: Lookalike> {\n  value: Width<T>\n}\n\n"
}

// THE IDENTITY ROW, and the reason the comparison is by resolved declaration. `Lookalike` declares
// EXACTLY the arm names `WidthResolution` declares. Any check that compared kinds by spelling, or by
// the set of inhabitant names a kind admits, would ADMIT this forward -- that is the spelling
// fallback the operator's 2026-10-15 ruling refuses, and the reason this row is separate from the
// different-kind row above: `Other` could be refused by a shape or name proxy, `Lookalike` cannot.
test fn a_forwarded_parameter_whose_kind_only_looks_like_the_slots_kind_must_refuse() -> Bool {
  forwarded_cause_blocking_count(source: forward_lookalike_kind_source(), cause: "ForwardedParameterKindDiffers") >= 1
}

// THE IMPORTED-KIND POSITIVE, and the discriminating row for the binding kernel. `Bool` is declared
// by std.types and reached here through the file's NAMED import; both the slot's kind and Box's
// parameter kind are that authored token. Under the deleted composed-name lookup the binder side
// queried <this synthetic module>.Bool, found nothing, and the forward refused with
// ForwardedParameterKindUnresolved; under the kernel route the same-name import chain lands on
// std.types' Bool on BOTH sides, the two resolved declarations share a source location, and the
// forward is admitted. It is self-contained (std.types is a closure the fixtures already import),
// so no ReadsLiveTree floor is touched. This is exactly the corpus class: std.realization_measurement's
// `S: Scale` reaching std.measure's Scale through `import std.measure { Scale }`.
fn forward_imported_kind_source() -> String {
  "module kindprobe.pos_forward_imported\n\nimport std.types { Int, String, Bool }\n\ntype Phantom\ntype Width<bits: Bool> = Phantom\n\ntype Box<T: Bool> {\n  value: Width<T>\n}\n\n"
}

test fn a_forwarded_parameter_whose_kind_comes_by_import_is_admitted() -> Bool {
  kind_mismatch_blocking_count(source: forward_imported_kind_source()) == 0
    && forwarded_cause_blocking_count(source: forward_imported_kind_source(), cause: "ForwardedParameterKindUnresolved") == 0
    && compile_dag_rust_emit_check(forward_imported_kind_source(), "src/kindprobe_pos_forward_imported.rs", [], [])
}

// THE UNIMPORTED-KIND NEGATIVE. `Nowhere` is declared by no module this file reaches and named by no
// import it holds, so the chain ends Undecided and the kind cannot be resolved to a declaring
// position. MUST REFUSE, under ForwardedParameterKindUnresolved: a kind name is an ordinary name, and
// an unimported one has no declaration in scope -- the kernel admits nothing ambiently, and there is
// no composed-name path left beside it for this name to leak through.
fn forward_unimported_kind_source() -> String {
  "module kindprobe.neg_forward_unimported\n\nimport std.types { Int, String }\n\ntype WidthResolution\n  = StaticWidthIndex\n  | PointerWidth\n\ntype Phantom\ntype Width<bits: WidthResolution> = Phantom\n\ntype Box<T: Nowhere> {\n  value: Width<T>\n}\n\n"
}

test fn a_forwarded_parameter_naming_an_unimported_kind_must_refuse() -> Bool {
  forwarded_cause_blocking_count(source: forward_unimported_kind_source(), cause: "ForwardedParameterKindUnresolved") >= 1
}
