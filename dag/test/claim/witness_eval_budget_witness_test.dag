module test.claim.witness_eval_budget_witness

import gunbc.witness_eval_budget {
  DeclaredWitnessEvalBudget,
  declared_witness_eval_budgets,
  declared_witness_eval_budget_duplicate_count,
  declared_witness_eval_budget_duplicate_count_in,
  declared_witness_eval_budgets_well_formed,
  declared_witness_eval_budgets_well_formed_in,
  witness_long_eval_budget_roster,
  witness_eval_budget_for,
  witness_declares_long_eval_budget,
  long_eval_budget
}
import gunbc.explicit_witness_admission { explicit_witness_admission_covers }
import v2.workflow.witness_admission { witness_row_excluded_from_discovery }
import v2.workflow.required_floor {
  required_floor_claim_cpu_safety_limit_ms,
  required_floor_declared_long_budget_claim_cpu_safety_limit_ms,
  required_floor_claim_cpu_safety_limit_for,
  required_floor_declared_claim_cpu_ceilings
}
import std.realization_schedule { ScheduleWitnessEntry, CorpusWitnessKind }
import std.witness_admission {
  SubstrateLongLaneEvalBudget,
  FastLaneEvalBudget
}
import std.dissolution { unbound_dissolution }
import v2.std.algebra { any, fold_list, length }
import v2.std.collection { List }
import v2.std.integer { Int, int_gt }
import v2.std.logic { Bool }
import v2.std.text { String }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE WITNESS FOR THE BUDGET AXIS'S OWN CARRIER. What it has to establish is not that a roster
// exists — a roster's length is not a claim — but the two properties the carrier was split out to
// obtain, each with an input that goes red when the property is broken:
//
//   a witness may declare a longer envelope WITHOUT leaving per-PR discovery and WITHOUT an
//   admission row (the property gunbc.explicit_witness_admission structurally cannot provide); and
//
//   the required floor's per-claim ceiling is DECIDED BY that declaration rather than by a single
//   corpus-wide constant (the property that makes the axis executed rather than described).

data live_gate_entry: String = "dag/test/claim/self_host_compile_phase_live_gate_witness_test.dag"

fn live_gate_functions() -> List<String> {
  [
    "a_live_census_equal_to_the_latest_receipt_holds",
    "a_live_tree_that_gained_an_identity_refuses_and_names_it",
    "a_live_tree_that_swapped_an_identity_at_equal_cardinality_refuses",
    "a_live_tree_that_removed_an_identity_holds",
    "a_live_observation_from_another_host_target_is_unmeasured_not_held",
    "a_pinned_live_invocation_is_incomparable_to_a_defaulted_receipt",
    "a_live_observation_on_the_receipts_own_toolchain_is_comparable",
    "an_empty_receipt_series_leaves_the_live_tree_unmeasured_rather_than_held",
    "a_non_validating_receipt_series_refuses_the_live_tree",
    "a_live_observation_folded_under_another_classification_policy_is_unmeasured",
    "a_measurement_that_never_reached_cargo_is_unmeasured_and_never_held",
    "an_unreached_measurement_yields_no_observation_at_all",
    "an_empty_census_from_a_completed_measurement_still_holds"
  ]
}

// THE THIRTEEN ARE NAMED HERE RATHER THAN COUNTED. A count would be satisfied by any thirteen
// identities, including thirteen the carrier invented; the join below is at identity grain in both
// directions — every named cell declares the long envelope, and the roster carries no live-gate
// identity this list does not name — so a row added to or dropped from the carrier reds by name.
// The list is not a second authority for which cells exist: the module's own test declarations are
// that, and a name here that the module does not declare is caught by the floor's discovery join
// (an enrolled identity the tree does not declare cannot execute).

test fn every_live_gate_cell_declares_the_long_envelope() -> Bool {
  fold_list(
    xs: live_gate_functions(),
    empty: true,
    cons: fn(ok, f) {
      ok && witness_declares_long_eval_budget(entry: live_gate_entry, function: f)
    }
  )
}

fn declared_live_gate_row_count() -> Int {
  fold_list(
    xs: witness_long_eval_budget_roster(),
    empty: 0,
    cons: fn(n, w) { if w.entry == live_gate_entry { n + 1 } else { n } }
  )
}

test fn the_roster_carries_no_live_gate_identity_this_witness_does_not_name() -> Bool {
  declared_live_gate_row_count() == length(xs: live_gate_functions())
}

// THE LOAD-BEARING CLAIM, AND THE REASON THE CARRIER EXISTS. Under the representation this
// replaced, the only way to declare an envelope was an admission row, and
// v2.workflow.witness_admission witness_row_excluded_from_discovery drops every admitted
// (entry, function) pair out of discovery — so declaring a budget for these cells would have
// removed them from the required floor, deleting the coverage the declaration exists to protect.
// Both negatives are asserted at identity grain: no admission covers them, and discovery does not
// exclude them. If a future edit re-fuses the axis onto the admission row, this reds.

test fn declaring_the_envelope_did_not_remove_the_cells_from_discovery() -> Bool {
  fold_list(
    xs: live_gate_functions(),
    empty: true,
    cons: fn(ok, f) {
      ok
        && !explicit_witness_admission_covers(entry: live_gate_entry, function: f)
        && !witness_row_excluded_from_discovery(entry: live_gate_entry, function: f)
    }
  )
}

// THE RESIDUAL IS FAST, AND IT IS ANSWERED RATHER THAN ASSUMED. An identity with no row must read
// FastLaneEvalBudget — the tighter arm — so a lane that forgets to declare narrows rather than
// widens. The red control is the same predicate over a declared identity: if the lookup answered
// fast for everything (a matcher that never matches), the first clause would still pass and the
// second would fail.

data unlisted_identity_function: String = "an_identity_no_budget_row_names"

test fn an_undeclared_identity_reads_the_fast_lane_residual() -> Bool {
  let residual = witness_eval_budget_for(
    entry: "dag/test/claim/synthetic_budget_witness_test.dag",
    function: unlisted_identity_function
  )
  let declared = witness_eval_budget_for(
    entry: live_gate_entry,
    function: "a_live_census_equal_to_the_latest_receipt_holds"
  )
  match residual {
    FastLaneEvalBudget =>
      match declared {
        SubstrateLongLaneEvalBudget => true
        FastLaneEvalBudget => false
      }
    SubstrateLongLaneEvalBudget => false
  }
}

// THE LOOKUP IS KEYED ON BOTH HALVES OF THE IDENTITY. A function name declared in one entry must
// not carry its envelope into another — the exact-grain property the admission authority pays for
// separately, asserted here because this carrier answers a different question with the same key.

test fn the_envelope_does_not_follow_a_function_name_into_another_entry() -> Bool {
  !witness_declares_long_eval_budget(
    entry: "dag/test/claim/synthetic_budget_witness_test.dag",
    function: "a_live_census_equal_to_the_latest_receipt_holds"
  )
}

// WELL-FORMEDNESS, WITH ITS RED. A file-grain row (empty function) would grant an envelope to
// every cell an entry gains later, including ones nobody has written; an empty entry names
// nothing. Both are refused, and the planted rows are what prove the refusal fires rather than
// the predicate being vacuously true over a live population that happens to contain neither.

fn synthetic_row(entry: String, f: String) -> DeclaredWitnessEvalBudget {
  long_eval_budget(
    entry: entry,
    f: f,
    kind: CorpusWitnessKind,
    reason: "synthetic",
    dissolution: unbound_dissolution(description: "synthetic")
  )
}

test fn red_control_file_grain_and_empty_entry_budget_rows_are_malformed() -> Bool {
  declared_witness_eval_budgets_well_formed()
    && declared_witness_eval_budgets_well_formed_in(
      rows: [synthetic_row(entry: "dag/test/claim/x_test.dag", f: "a_holds")]
    )
    && !declared_witness_eval_budgets_well_formed_in(
      rows: [synthetic_row(entry: "dag/test/claim/x_test.dag", f: "")]
    )
    && !declared_witness_eval_budgets_well_formed_in(
      rows: [synthetic_row(entry: "", f: "a_holds")]
    )
}

test fn red_control_duplicate_budget_rows_red() -> Bool {
  (declared_witness_eval_budget_duplicate_count() == 0)
    && (declared_witness_eval_budget_duplicate_count_in(
      rows: [
        synthetic_row(entry: "dag/test/claim/x_test.dag", f: "a_holds"),
        synthetic_row(entry: "dag/test/claim/x_test.dag", f: "a_holds")
      ]
    ) > 0)
    && (declared_witness_eval_budget_duplicate_count_in(
      rows: [
        synthetic_row(entry: "dag/test/claim/x_test.dag", f: "a_holds"),
        synthetic_row(entry: "dag/test/claim/x_test.dag", f: "b_holds")
      ]
    ) == 0)
}

// THE FLOOR SIDE: THE DECLARATION DECIDES THE CEILING. The first clause is the one that would go
// green by accident if the two ceilings were equal — a projection that stamped the ordinary limit
// on every row would satisfy every other clause here — so it is asserted first and separately.

test fn the_declared_envelope_is_larger_than_the_ordinary_ceiling() -> Bool {
  int_gt(
    a: required_floor_declared_long_budget_claim_cpu_safety_limit_ms(),
    b: required_floor_claim_cpu_safety_limit_ms()
  )
    && int_gt(
      a: required_floor_claim_cpu_safety_limit_for(budget: SubstrateLongLaneEvalBudget),
      b: required_floor_claim_cpu_safety_limit_for(budget: FastLaneEvalBudget)
    )
}

// EVERY DECLARED IDENTITY IS STAMPED WITH THE LONGER CEILING, AND NOTHING ELSE IS. The projection
// is what the runner reads, so this is the assertion that the number reaching the executor came
// from the declaration: the row count equals the declared roster's, and every stamped ceiling is
// the long one. A projection that dropped a row, or stamped the ordinary limit, fails here rather
// than silently handing the floor a 500ms line for a witness that declared otherwise.

test fn the_floor_projection_stamps_the_declared_ceiling_on_every_declared_identity() -> Bool {
  let ceilings = required_floor_declared_claim_cpu_ceilings()
  (length(xs: ceilings) == length(xs: witness_long_eval_budget_roster()))
    && (length(xs: ceilings) > 0)
    && fold_list(
      xs: ceilings,
      empty: true,
      cons: fn(ok, c) {
        ok
          && (c.cpu_limit_ms == required_floor_declared_long_budget_claim_cpu_safety_limit_ms())
          && witness_declares_long_eval_budget(entry: c.entry, function: c.function)
      }
    )
}

test fn every_declared_identity_reaches_the_floor_projection() -> Bool {
  fold_list(
    xs: witness_long_eval_budget_roster(),
    empty: true,
    cons: fn(ok, w) {
      ok
        && any(
          xs: required_floor_declared_claim_cpu_ceilings(),
          predicate: fn(c) { (c.entry == w.entry) && (c.function == w.function) }
        )
    }
  )
}
