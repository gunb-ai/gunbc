module test.claim.v1_test_migration_dispositions

import std.types { List, Bool, String, string_non_empty }
import test.retirement.model { retained_legacy_rust_test_modules, RetainedLegacyRustTestModule }
import std.dissolution { DissolutionCondition, BoundDissolution, UnboundDissolution }
import gunbc.v1.v1_deletion_plan { v1_migrated_test_modules, V1TestMigrationDisposition, ReplacedByWitness, RetainedRustTest }
import v2.lens.test_migration_debt { discovered_rust_test_modules, list_contains_name, names_are_duplicate_free }

// The mapping-completeness control for the v1 test migration. The retention wall
// (v2.test.claim.manual.test_migration_debt) judges the Rust side and is deliberately untouched; this
// judges the disposition rows in gunbc.v1.v1_deletion_plan::v1_migrated_test_modules, so a row cannot
// name a replacement that the discovery does not honour. A Rust module is discharged by a floor
// witness only on an exact .dag file-stem match (test_migration_debt_stem_covered), so a row whose
// module is still discovered as debt names a witness the wall does not accept.

fn migrated_rust_files() -> List<String> {
  v1_migrated_test_modules() |> map(m => concat(m.rust_module, ".rs"))
}

fn is_replaced(d: V1TestMigrationDisposition) -> Bool {
  match d {
    ReplacedByWitness { coverage_gap: _ } => true
    RetainedRustTest => false
  }
}

fn replaced_rust_files() -> List<String> {
  v1_migrated_test_modules() |> filter(m => is_replaced(d: m.disposition)) |> map(m => concat(m.rust_module, ".rs"))
}

// Each module is dispositioned exactly once.
test fn every_migrated_module_appears_exactly_once() -> Bool {
  names_are_duplicate_free(xs: migrated_rust_files()) && !is_empty(migrated_rust_files())
}

// A replaced module no longer appears in the discovered debt: its exact-stem floor witness exists.
test fn every_replaced_module_is_discharged_by_an_exact_stem_witness() -> Bool {
  replaced_rust_files() |> all(f => !list_contains_name(xs: discovered_rust_test_modules(), needle: f))
}

// RED control: a planted duplicate must be refused by the exactly-once judgment.
test fn a_duplicated_module_is_refused() -> Bool {
  !names_are_duplicate_free(xs: ["a_test.rs", "a_test.rs"])
}

// A retained row must state both what stays in Rust (check) and why it cannot move (why), as text that is not
// empty. The row type declares NonEmptyStr, but a where-refinement is not enforced at construction, so the
// judgment is made here, once, over a (check, why) pair; the live rows are projected into the same pair.
fn retained_row_is_complete(check: String, why: String) -> Bool {
  string_non_empty(value: check) && string_non_empty(value: why)
}

fn dissolution_text(d: DissolutionCondition) -> String {
  match d {
    UnboundDissolution { description: t } => t
    BoundDissolution { trigger: _ } => "bound"
  }
}

// The live rows: every retained module states a check (purpose) and a reason it cannot move (dissolution).
test fn every_retained_row_names_its_check_and_why() -> Bool {
  retained_legacy_rust_test_modules() |> all(r => retained_row_is_complete(check: r.purpose, why: dissolution_text(d: r.dissolution)))
}

// Plant 1: a populated row is admitted.
test fn planted_populated_retained_row_is_admitted() -> Bool {
  retained_row_is_complete(check: "asserts the message text", why: "the census carries no message text")
}

// Plant 2: a row with either field empty is refused.
test fn planted_retained_row_with_empty_check_or_why_is_refused() -> Bool {
  !retained_row_is_complete(check: "", why: "the census carries no message text") && !retained_row_is_complete(check: "asserts the message text", why: "")
}
