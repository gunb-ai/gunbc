module test.claim.gcp_oauth_access_token_witness


// THIS FILE ASSERTS NOTHING TODAY, AND ITS PRESENCE IN `dag/test/claim` IS NOT COVERAGE.
// Stated first and positively, because the failure it would otherwise cause is a later reader
// counting it. Measured on this tree: 0 `test fn`, so floor discovery folds nothing from it;
// no other module imports it, so the support-module pattern that legitimises a zero-`test fn`
// file does not apply; and no `live_tree_disposition`, so the fail-closed default would decline
// it even if it were discovered. Its 11 entries are plain `fn`, reachable by nothing.
//
// AND IT CANNOT BE FIXED BY DECLARING ONE, which is the part worth recording rather than the
// three above. The obvious repair -- convert to `test fn`, declare `SubstrateInputsOnly`, rename
// to `_test.dag` -- would declare something false. Both roll-ups reach
// `gcp_oauth_access_token_via_gcloud`, whose body is `shell.GCloud.AuthPrintAccessToken()`, a host
// effect; the ADC leaves declare `uses net: std.resources.Network`. Neither is substrate-only.
// Run directly, the gcloud leaf answers `Unimplemented { what: "unknown service operation:
// shell.GCloud.AuthPrintAccessToken" }` -- the call exists and nothing is behind it. Enrolled under
// a false disposition it would be refused at the hermetic boundary, counted `executed`, and assert
// nothing, while a `_test.dag` name made `BarrenTestSidecar` vouch for it: a silently inert witness
// converted into a loudly enrolled one. That is strictly worse than this comment.
//
// WHAT WOULD ACTUALLY MAKE IT EXECUTE is modeling the gcloud service operation, or restructuring
// the assertions onto a subject that carries no host effect. Neither is done here.
//
// WHY THE IMPORT EDGE IS STILL RIGHT: the edge is a fact about REFERENCE, not about execution.
// This module names `gcp_oauth_access_token` and both leaf patterns and resolved them through the
// flat whole-tree namespace, so it was depended-upon-but-unimported -- the same accidental pool
// coverage this change repairs in `gunbc.tailscale_acl_phase2_credential`. Recording the edge is
// correct whether or not the assertions ever run, and an earlier revision of this comment claimed
// they run. They do not; that claim was asserted without being measured, in a change whose whole
// subject is evidence that is cited but never executed.
//
// ADDING THE EDGE CANNOT CHANGE WHICH DECLARATION BINDS, and that is measured rather than assumed:
// each of the four names below is declared in exactly one module across `dag/` and `src/v2`, so the
// candidate set is a singleton and there is no second arm for an import to reorder. This says
// nothing about bare-name resolution where a name IS multiply declared; that question does not
// arise here.
import gunbc.auth.credentials {
  gcp_oauth_access_token,
  gcp_oauth_access_token_via_gcloud,
  gcp_oauth_access_token_via_adc_refresh,
  GcpAdcTokenOutcome,
  GcpAdcTokenReady,
  GcpAdcReadRefused,
  GcpAdcDocumentRefused,
}

data witness_adc_path: std.types.FilePath = "/tmp/gunbc_gcp_oauth_witness_adc.json"

data null_adc_path: std.types.FilePath? = none

fn secret_eq(a: Secret, b: Secret) -> Bool {
  (a as String) == (b as String)
}

// These witnesses assert ROUTE EQUIVALENCE -- that the strategy dispatch reaches
// the same leaf the leaf pattern reaches directly. Since gcp_oauth_access_token
// now returns an outcome, equivalence is asserted on the OUTCOME, which compares
// refusals as well as tokens: two routes that both refuse for the same cause are
// equivalent, and a route that refuses where its leaf succeeds is not. Projecting
// to a token and defaulting the refusals would have made every witness green
// whenever both sides failed.
fn adc_outcome_eq(a: GcpAdcTokenOutcome, b: GcpAdcTokenOutcome) -> Bool {
  match a {
    GcpAdcTokenReady { token: ta } =>
      match b {
        GcpAdcTokenReady { token: tb } => secret_eq(a: ta, b: tb)
        GcpAdcReadRefused { path: _, cause: _ } => false
        GcpAdcDocumentRefused { path: _, cause: _ } => false
      }
    GcpAdcReadRefused { path: pa, cause: ca } =>
      match b {
        GcpAdcReadRefused { path: pb, cause: cb } => pa == pb && ca == cb
        GcpAdcTokenReady { token: _ } => false
        GcpAdcDocumentRefused { path: _, cause: _ } => false
      }
    GcpAdcDocumentRefused { path: pa, cause: _ } =>
      match b {
        GcpAdcDocumentRefused { path: pb, cause: _ } => pa == pb
        GcpAdcTokenReady { token: _ } => false
        GcpAdcReadRefused { path: _, cause: _ } => false
      }
  }
}

fn witness_gcloud_cli_routes_to_gcloud_leaf() -> Bool {
  adc_outcome_eq(
    a: gcp_oauth_access_token(strategy: GcloudCli),
    b: gcp_oauth_access_token_via_gcloud()
  )
}

fn witness_adc_refresh_absent_routes_to_adc_leaf() -> Bool {
  adc_outcome_eq(
    a: gcp_oauth_access_token(strategy: AdcRefresh { adc_path: Absent }),
    b: gcp_oauth_access_token_via_adc_refresh()
  )
}

fn witness_adc_refresh_present_routes_to_adc_leaf() -> Bool {
  adc_outcome_eq(
    a: gcp_oauth_access_token(
      strategy: AdcRefresh { adc_path: Present { value: witness_adc_path } }
    ),
    b: gcp_oauth_access_token_via_adc_refresh(adc_path: witness_adc_path)
  )
}

fn witness_adc_refresh_null_optional_routes_to_adc_leaf() -> Bool {
  adc_outcome_eq(
    a: gcp_oauth_access_token(strategy: AdcRefresh { adc_path: null_adc_path }),
    b: gcp_oauth_access_token_via_adc_refresh()
  )
}

fn witness_leaves_are_distinguishable() -> Bool {
  !adc_outcome_eq(
    a: gcp_oauth_access_token_via_gcloud(),
    b: gcp_oauth_access_token_via_adc_refresh()
  )
}

// The deliberately mis-wired control: it must remain a real discriminator, so it
// returns the same outcome type the correct dispatch does. Had it kept a token
// record, these two witnesses would compare different types and the control
// would stop being able to go red.
pattern gcp_oauth_access_token_dispatch_swapped(strategy: GcpOAuth2AccessTokenStrategy) -> GcpAdcTokenOutcome
{
  node result = match strategy {
    GcloudCli => gcp_oauth_access_token_via_adc_refresh()
    AdcRefresh { adc_path: _path } => gcp_oauth_access_token_via_gcloud()
  }
  return result
}

fn witness_swapped_gcloud_hits_adc_leaf() -> Bool {
  adc_outcome_eq(
    a: gcp_oauth_access_token_dispatch_swapped(strategy: GcloudCli),
    b: gcp_oauth_access_token_via_adc_refresh()
  )
}

fn witness_swapped_adc_hits_gcloud_leaf() -> Bool {
  adc_outcome_eq(
    a: gcp_oauth_access_token_dispatch_swapped(
      strategy: AdcRefresh { adc_path: Absent }
    ),
    b: gcp_oauth_access_token_via_gcloud()
  )
}

fn gcp_oauth_access_token_materializer_green_holds() -> Bool {
  witness_gcloud_cli_routes_to_gcloud_leaf()
    && witness_adc_refresh_absent_routes_to_adc_leaf()
    && witness_adc_refresh_present_routes_to_adc_leaf()
    && witness_adc_refresh_null_optional_routes_to_adc_leaf()
    && witness_leaves_are_distinguishable()
}

fn gcp_oauth_access_token_dispatch_discriminator_is_red_holds() -> Bool {
  witness_swapped_gcloud_hits_adc_leaf()
    && witness_swapped_adc_hits_gcloud_leaf()
}
