module test.claim.roadmap_model

import gunbc.roadmap_status {
  RoadmapItem, DerivableLine, AuthoredLine,
  DriftVerdict, Drifted, Clean, Underivable,
}
import gunbc.roadmap_execution_contract { ExecutionContractUnspecified }
import gunbc.roadmap_model {
  RoadmapNodeId,
  Pointer,
  RoadmapNode, RoadmapEdge,
  RoadmapParent, TopLevel, UnderParent,
  NodeSizing, Unsized,
  roadmap_primary_parent, roadmap_parent_ids, is_top_level,
  node_carrier_clean,
  node_status_drift,
}
import gunbc.roadmap_status { Signoff, Unsigned }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data parent_node: RoadmapNodeId = "invert-hand-maintained"
data second_parent_node: RoadmapNodeId = "model-before-implement"
data child_node: RoadmapNodeId = "pr-checkbox-status"
data orphan_node: RoadmapNodeId = "no-parent-node"

fn edges() -> List<RoadmapEdge> {
  [RoadmapEdge { child: child_node, parent: parent_node }]
}

fn verdict_is_drifted(v: DriftVerdict) -> Bool {
  match v { Drifted => true  Clean => false  Underivable => false }
}
test fn witness_child_has_parent() -> Bool {
  match roadmap_primary_parent(edges: edges(), node: child_node) {
    UnderParent { parent: p } => p == parent_node
    TopLevel => false
  }
}

test fn witness_multi_parent_dependencies_are_not_flattened() -> Bool {
  let es = [
    RoadmapEdge { child: child_node, parent: parent_node },
    RoadmapEdge { child: child_node, parent: second_parent_node },
  ]
  roadmap_parent_ids(edges: es, node: child_node) == [parent_node, second_parent_node]
    && match roadmap_primary_parent(edges: es, node: child_node) {
      UnderParent { parent: p } => p == parent_node
      TopLevel => false
    }
}

test fn witness_orphan_is_top_level() -> Bool {
  is_top_level(edges: edges(), node: orphan_node)
}

test fn witness_parent_is_top_level() -> Bool {
  is_top_level(edges: edges(), node: parent_node)
}

data existing_docs: List<String> = [
  "docs/plans/invert-hand-maintained.md",
  "DESIGN.md",
]

fn node_with_carriers(cs: List<Pointer>) -> RoadmapNode {
  RoadmapNode {
    node: child_node,
    line: AuthoredLine { done: false, content: "PR→checkbox status" },
    carriers: cs,
    sizing: Unsized,
    execution: ExecutionContractUnspecified,
    owner: "",
    signoff: Unsigned,
  }
}

test fn witness_resolving_carrier_clean() -> Bool {
  node_carrier_clean(
    rn: node_with_carriers(cs: [Pointer { label: "plan", path: "docs/plans/invert-hand-maintained.md" }]),
    existing_docs: existing_docs,
  )
}

test fn witness_dangling_carrier_caught() -> Bool {
  !node_carrier_clean(
    rn: node_with_carriers(cs: [Pointer { label: "plan", path: "docs/plans/does-not-exist.md" }]),
    existing_docs: existing_docs,
  )
}

test fn witness_no_carrier_clean() -> Bool {
  node_carrier_clean(rn: node_with_carriers(cs: []), existing_docs: existing_docs)
}

test fn witness_node_status_drifts() -> Bool {
  let rn = RoadmapNode {
    node: child_node,
    line: DerivableLine { prs: [5491], title: "stale", description: "" },
    carriers: [],
    sizing: Unsized,
    execution: ExecutionContractUnspecified,
    owner: "",
    signoff: Unsigned,
  }
  verdict_is_drifted(v: node_status_drift(rn: rn, committed_box: true, merged: [5491]))
}

test fn witness_node_unsigned_box_clean() -> Bool {
  let rn = RoadmapNode {
    node: child_node,
    line: AuthoredLine { done: false, content: "partial evidence" },
    carriers: [],
    sizing: Unsized,
    execution: ExecutionContractUnspecified,
    owner: "",
    signoff: Unsigned,
  }
  match node_status_drift(rn: rn, committed_box: false, merged: [5491]) {
    Clean => true
    Drifted => false
    Underivable => false
  }
}
