module test.claim.roadmap_model


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data parent_node: gunbc.roadmap_model.RoadmapNodeId = "invert-hand-maintained"
data second_parent_node: gunbc.roadmap_model.RoadmapNodeId = "model-before-implement"
data roadmap_model_child_node: gunbc.roadmap_model.RoadmapNodeId = "pr-checkbox-status"
data orphan_node: gunbc.roadmap_model.RoadmapNodeId = "no-parent-node"

fn edges() -> List<gunbc.roadmap_model.RoadmapEdge> {
  [gunbc.roadmap_model.RoadmapEdge { child: roadmap_model_child_node, parent: parent_node }]
}

fn verdict_is_drifted(v: gunbc.roadmap_status.DriftVerdict) -> Bool {
  match v { gunbc.roadmap_status.Drifted => true  gunbc.roadmap_status.Clean => false  gunbc.roadmap_status.Underivable => false }
}
test fn witness_child_has_parent() -> Bool {
  match gunbc.roadmap_model.roadmap_primary_parent(edges: edges(), node: roadmap_model_child_node) {
    gunbc.roadmap_model.UnderParent { parent: p } => p == parent_node
    gunbc.roadmap_model.TopLevel => false
  }
}

test fn witness_multi_parent_dependencies_are_not_flattened() -> Bool {
  let es = [
    gunbc.roadmap_model.RoadmapEdge { child: roadmap_model_child_node, parent: parent_node },
    gunbc.roadmap_model.RoadmapEdge { child: roadmap_model_child_node, parent: second_parent_node },
  ]
  gunbc.roadmap_model.roadmap_parent_ids(edges: es, node: roadmap_model_child_node) == [parent_node, second_parent_node]
    && match gunbc.roadmap_model.roadmap_primary_parent(edges: es, node: roadmap_model_child_node) {
      gunbc.roadmap_model.UnderParent { parent: p } => p == parent_node
      gunbc.roadmap_model.TopLevel => false
    }
}

test fn witness_orphan_is_top_level() -> Bool {
  gunbc.roadmap_model.is_top_level(edges: edges(), node: orphan_node)
}

test fn witness_parent_is_top_level() -> Bool {
  gunbc.roadmap_model.is_top_level(edges: edges(), node: parent_node)
}

data existing_docs: List<String> = [
  "docs/plans/invert-hand-maintained.md",
  "DESIGN.md",
]

fn node_with_carriers(cs: List<gunbc.roadmap_model.Pointer>) -> gunbc.roadmap_model.RoadmapNode {
  gunbc.roadmap_model.RoadmapNode {
    identity: "rnfx_P8CGH3E7ERD8M55W9X49" as RoadmapNodeIdentity,
    node: roadmap_model_child_node,
    line: gunbc.roadmap_status.AuthoredLine { done: false, content: "PR→checkbox status" },
    carriers: cs,
    sizing: gunbc.roadmap_model.Unsized,
    execution: gunbc.roadmap_execution_contract.ExecutionContractUnspecified,
    owner: "",
    signoff: gunbc.roadmap_status.Unsigned,
  }
}

test fn witness_resolving_carrier_clean() -> Bool {
  gunbc.roadmap_model.node_carrier_clean(
    rn: node_with_carriers(cs: [gunbc.roadmap_model.Pointer { label: "plan", path: "docs/plans/invert-hand-maintained.md" }]),
    existing_docs: existing_docs,
  )
}

test fn witness_dangling_carrier_caught() -> Bool {
  !gunbc.roadmap_model.node_carrier_clean(
    rn: node_with_carriers(cs: [gunbc.roadmap_model.Pointer { label: "plan", path: "docs/plans/does-not-exist.md" }]),
    existing_docs: existing_docs,
  )
}

test fn witness_no_carrier_clean() -> Bool {
  gunbc.roadmap_model.node_carrier_clean(rn: node_with_carriers(cs: []), existing_docs: existing_docs)
}

test fn witness_node_status_drifts() -> Bool {
  let rn = gunbc.roadmap_model.RoadmapNode {
    identity: "rnfx_WZ1MVE2JJZ2CCAWP2TVM" as RoadmapNodeIdentity,
    node: roadmap_model_child_node,
    line: gunbc.roadmap_status.DerivableLine { prs: [5491], title: "stale", description: "" },
    carriers: [],
    sizing: gunbc.roadmap_model.Unsized,
    execution: gunbc.roadmap_execution_contract.ExecutionContractUnspecified,
    owner: "",
    signoff: gunbc.roadmap_status.Unsigned,
  }
  verdict_is_drifted(v: gunbc.roadmap_model.node_status_drift(rn: rn, committed_box: true, merged: [5491]))
}

test fn witness_node_unsigned_box_clean() -> Bool {
  let rn = gunbc.roadmap_model.RoadmapNode {
    identity: "rnfx_Q203PA6K5BSTTSCXR7JB" as RoadmapNodeIdentity,
    node: roadmap_model_child_node,
    line: gunbc.roadmap_status.AuthoredLine { done: false, content: "partial evidence" },
    carriers: [],
    sizing: gunbc.roadmap_model.Unsized,
    execution: gunbc.roadmap_execution_contract.ExecutionContractUnspecified,
    owner: "",
    signoff: gunbc.roadmap_status.Unsigned,
  }
  match gunbc.roadmap_model.node_status_drift(rn: rn, committed_box: false, merged: [5491]) {
    gunbc.roadmap_status.Clean => true
    gunbc.roadmap_status.Drifted => false
    gunbc.roadmap_status.Underivable => false
  }
}
