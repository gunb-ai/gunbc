module test.claim.deploy_revision_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data sha_older: std.types.CommitSha = "1111111111111111111111111111111111111111"
data sha_newer: std.types.CommitSha = "2222222222222222222222222222222222222222"

data all_relations: List<gunbc.live_deploy.revision.DeployRevisionRelation> = [
  gunbc.live_deploy.revision.SameRevision,
  gunbc.live_deploy.revision.DeployedIsAncestor,
  gunbc.live_deploy.revision.CandidateIsAncestor,
  gunbc.live_deploy.revision.UnrelatedHistories,
  gunbc.live_deploy.revision.RelationUnverifiable { cause: "probe failed" as std.types.NonEmptyStr },
]

test fn deployed_ancestor_of_candidate_advances() -> Bool {
  match gunbc.live_deploy.revision.classify_deploy_revision(relation: gunbc.live_deploy.revision.DeployedIsAncestor) {
    gunbc.live_deploy.revision.RevisionAdvance => true
    _ => false
  }
}

test fn same_revision_is_already_converged() -> Bool {
  match gunbc.live_deploy.revision.classify_deploy_revision(relation: gunbc.live_deploy.revision.SameRevision) {
    gunbc.live_deploy.revision.RevisionAlreadyConverged => true
    _ => false
  }
}

test fn candidate_ancestor_of_deployed_is_superseded_noop() -> Bool {
  match gunbc.live_deploy.revision.classify_deploy_revision(relation: gunbc.live_deploy.revision.CandidateIsAncestor) {
    gunbc.live_deploy.revision.RevisionSupersededNoOp => true
    _ => false
  }
}

test fn superseded_run_is_success_not_a_refusal() -> Bool {
  let v = gunbc.live_deploy.revision.classify_deploy_revision(relation: gunbc.live_deploy.revision.CandidateIsAncestor)
  gunbc.live_deploy.revision.deploy_revision_terminal_success(verdict: v)
    && !gunbc.live_deploy.revision.deploy_revision_refuses(verdict: v)
    && !gunbc.live_deploy.revision.deploy_revision_proceeds(verdict: v)
}

test fn unrelated_histories_refuse() -> Bool {
  let v = gunbc.live_deploy.revision.classify_deploy_revision(relation: gunbc.live_deploy.revision.UnrelatedHistories)
  gunbc.live_deploy.revision.deploy_revision_refuses(verdict: v)
    && !gunbc.live_deploy.revision.deploy_revision_proceeds(verdict: v)
    && !gunbc.live_deploy.revision.deploy_revision_terminal_success(verdict: v)
}

test fn unverifiable_relation_refuses_and_keeps_its_cause() -> Bool {
  let why = "no persisted revision on host" as std.types.NonEmptyStr
  match gunbc.live_deploy.revision.classify_deploy_revision(relation: gunbc.live_deploy.revision.RelationUnverifiable { cause: why }) {
    gunbc.live_deploy.revision.RevisionRefused { cause: c } => c == why
    _ => false
  }
}

test fn only_advance_performs_the_mutation() -> Bool {
  fold(all_relations, init: true, f: fn(ok, rel) {
    let v = gunbc.live_deploy.revision.classify_deploy_revision(relation: rel)
    ok && (gunbc.live_deploy.revision.deploy_revision_proceeds(verdict: v) == match rel {
      gunbc.live_deploy.revision.DeployedIsAncestor => true
      _ => false
    })
  })
}

test fn every_relation_lands_in_exactly_one_disposition() -> Bool {
  fold(all_relations, init: true, f: fn(ok, rel) {
    let v = gunbc.live_deploy.revision.classify_deploy_revision(relation: rel)
    let p = gunbc.live_deploy.revision.deploy_revision_proceeds(verdict: v)
    let t = gunbc.live_deploy.revision.deploy_revision_terminal_success(verdict: v)
    let r = gunbc.live_deploy.revision.deploy_revision_refuses(verdict: v)
    ok && ((p && !t && !r) || (!p && t && !r) || (!p && !t && r))
  })
}

test fn probe_pair_folds_to_the_four_cases() -> Bool {
  match gunbc.live_deploy.revision.deploy_revision_relation_from_probes(
    deployed: sha_older, candidate: sha_newer,
    deployed_is_ancestor_of_candidate: true, candidate_is_ancestor_of_deployed: false
  ) { gunbc.live_deploy.revision.DeployedIsAncestor => true  _ => false }
    && match gunbc.live_deploy.revision.deploy_revision_relation_from_probes(
      deployed: sha_newer, candidate: sha_older,
      deployed_is_ancestor_of_candidate: false, candidate_is_ancestor_of_deployed: true
    ) { gunbc.live_deploy.revision.CandidateIsAncestor => true  _ => false }
    && match gunbc.live_deploy.revision.deploy_revision_relation_from_probes(
      deployed: sha_older, candidate: sha_newer,
      deployed_is_ancestor_of_candidate: false, candidate_is_ancestor_of_deployed: false
    ) { gunbc.live_deploy.revision.UnrelatedHistories => true  _ => false }
}

test fn equal_shas_short_circuit_before_the_probes() -> Bool {
  match gunbc.live_deploy.revision.deploy_revision_relation_from_probes(
    deployed: sha_newer, candidate: sha_newer,
    deployed_is_ancestor_of_candidate: false, candidate_is_ancestor_of_deployed: false
  ) { gunbc.live_deploy.revision.SameRevision => true  _ => false }
}

test fn mutex_group_is_the_deployment_domain_not_the_job_name() -> Bool {
  let g = gunbc.live_deploy.revision.deploy_target_mutex_group(target: gunbc.live_deploy.revision.srv1_dashboard_target)
  string_contains(s: g, pattern: "gunbc-dashboard")
    && !string_contains(s: g, pattern: "deploy_dashboard_srv1")
}

test fn revision_state_lives_outside_the_rsynced_tree() -> Bool {
  let p = gunbc.live_deploy.revision.deploy_revision_state_path(target: gunbc.live_deploy.revision.srv1_dashboard_target) as String
  !string_contains(s: p, pattern: srv1_dashboard_target.destination as String)
    && string_contains(s: p, pattern: "/var/lib/gunbc/")
}
