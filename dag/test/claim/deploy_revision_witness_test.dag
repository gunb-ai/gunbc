module test.claim.deploy_revision_witness

import gunbc.live_deploy.revision {
  DeploymentTarget,
  Srv1Dashboard,
  DeployRevisionRelation,
  SameRevision,
  DeployedIsAncestor,
  CandidateIsAncestor,
  UnrelatedHistories,
  RelationUnverifiable,
  DeployDecision,
  Keep,
  Advance,
  Refuse,
  KeepReason,
  AlreadyActive,
  CandidateSuperseded,
  UnrelatedRevisionHistories,
  RevisionRelationUnverifiable,
  decide_deploy_revision,
  decide_deploy_for_observation,
  ActiveRevisionUngrounded,
  ObservedDeployedRevision,
  DeployedRevisionRecorded,
  DeployedRevisionUnrecorded,
  DeployedRevisionUnreadable,
  deploy_advance_text,
  deploy_revision_relation_from_probes,
  deploy_slot_revision_receipt_path,
  deploy_target_queue_group,
  deploy_target_lease_path,
  deploy_target_blue_slot,
  deploy_target_green_slot,
}
import std.types { NonEmptyStr, CommitSha, String }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data permutation_acceptance_note: String = "THE ORDERING LAW, ASSERTED AS AN ACCEPTANCE RATHER THAN AS A SPELLING. The witness this file replaces pinned the emitted concurrency YAML substring — a test that greens in the exact production state that cancelled the newest candidate, because it verified that serialization TEXT exists and said nothing about monotonicity, candidate retention, or final convergence. That is the wrong RED boundary for the property, which is 'cutovers cannot overlap AND the final state is the newest admitted revision'.\\n\\nSo the law is executed instead: for revisions A < B < C, EVERY permutation of [A,B,C] is folded against the same initial active state and the final active revision must be C. That single assertion covers idempotence, order-independence and monotonicity at once, and it fails if any arm mutates when it should not."

data sha_a: CommitSha = "1111111111111111111111111111111111111111"
data sha_b: CommitSha = "2222222222222222222222222222222222222222"
data sha_c: CommitSha = "3333333333333333333333333333333333333333"
data sha_unrelated: CommitSha = "9999999999999999999999999999999999999999"

data linear_history: List<CommitSha> = [sha_a, sha_b, sha_c]

fn revision_index(sha: CommitSha) -> Int {
  if sha == sha_a { 0 } else { if sha == sha_b { 1 } else { if sha == sha_c { 2 } else { 0 - 1 } } }
}

data linear_relation_note: String = "The ancestry ORACLE for the fixture is a position in a declared linear history, not a call to git. That keeps the acceptance hermetic while exercising the real decision function: deploy_revision_relation_from_probes takes the two probe Booleans, so the fixture supplies what `git merge-base --is-ancestor` would answer for a linear main. A revision outside the declared history yields index -1 and is ancestor of nothing in either direction, which is exactly the UnrelatedHistories observation."

fn linear_is_ancestor(earlier: CommitSha, later: CommitSha) -> Bool {
  let i = revision_index(sha: earlier)
  let j = revision_index(sha: later)
  i >= 0 && j >= 0 && i <= j
}

fn linear_relation(deployed: CommitSha, candidate: CommitSha) -> DeployRevisionRelation {
  deploy_revision_relation_from_probes(
    deployed: deployed,
    candidate: candidate,
    deployed_is_ancestor_of_candidate: linear_is_ancestor(earlier: deployed, later: candidate),
    candidate_is_ancestor_of_deployed: linear_is_ancestor(earlier: candidate, later: deployed),
  )
}

data step_is_the_join_note: String = "One step of `next_active = active ⊔ candidate`. ONLY the Advance arm moves the active revision — Keep and Refuse return the active revision unchanged, which is the executable statement of 'performs zero deployment effects'. The admission payload is destructured here rather than the candidate being re-read from the caller's scope, so the step advances to the revision the DECISION admitted, never to whatever the caller happened to be holding."

fn deploy_step(active: CommitSha, candidate: CommitSha) -> CommitSha {
  match decide_deploy_revision(
    deployed: active,
    candidate: candidate,
    relation: linear_relation(deployed: active, candidate: candidate),
  ) {
    Advance { admission: adm } => adm.to
    Keep { reason: _ } => active
    Refuse { cause: _ } => active
  }
}

fn deploy_fold(initial: CommitSha, candidates: List<CommitSha>) -> CommitSha {
  fold(candidates, initial, (acc, c) => deploy_step(active: acc, candidate: c))
}

data all_permutations: List<List<CommitSha>> = [
  [sha_a, sha_b, sha_c],
  [sha_a, sha_c, sha_b],
  [sha_b, sha_a, sha_c],
  [sha_b, sha_c, sha_a],
  [sha_c, sha_a, sha_b],
  [sha_c, sha_b, sha_a],
]

test fn every_permutation_converges_to_the_newest_revision() -> Bool {
  all(all_permutations, p => deploy_fold(initial: sha_a, candidates: p) == sha_c)
}

test fn permutation_fixture_is_non_degenerate() -> Bool {
  count(all_permutations) == 6
    && all(all_permutations, p => count(p) == 3)
    && sha_a != sha_b && sha_b != sha_c && sha_a != sha_c
}

data red_control_note: String = "THE DISCRIMINATING RED. If the decision were not monotonic — if a superseded candidate advanced instead of keeping — the permutation law would break, and this control proves the fixture can express that break. Folding the newest revision first and then an OLDER one must NOT move the active revision backward; a mutation-on-superseded regression turns this red while the permutation test above would also fail, so the two fail together rather than one masking the other."

test fn an_older_candidate_after_a_newer_active_does_not_move_the_active_revision() -> Bool {
  deploy_step(active: sha_c, candidate: sha_a) == sha_c
    && deploy_step(active: sha_c, candidate: sha_b) == sha_c
}

test fn an_equal_candidate_performs_no_mutation() -> Bool {
  deploy_step(active: sha_b, candidate: sha_b) == sha_b
}

test fn a_forward_candidate_advances_to_exactly_that_candidate() -> Bool {
  deploy_step(active: sha_a, candidate: sha_b) == sha_b
    && deploy_step(active: sha_a, candidate: sha_c) == sha_c
}

test fn deploying_the_same_candidate_twice_is_idempotent() -> Bool {
  let once = deploy_step(active: sha_a, candidate: sha_b)
  deploy_step(active: once, candidate: sha_b) == once
}

test fn an_unrelated_revision_refuses_and_mutates_nothing() -> Bool {
  match decide_deploy_revision(
    deployed: sha_b,
    candidate: sha_unrelated,
    relation: linear_relation(deployed: sha_b, candidate: sha_unrelated),
  ) {
    Refuse { cause: c } => match c {
      UnrelatedRevisionHistories => deploy_step(active: sha_b, candidate: sha_unrelated) == sha_b
      RevisionRelationUnverifiable { cause: _ } => false
      ActiveRevisionUngrounded => false
    }
    Keep { reason: _ } => false
    Advance { admission: _ } => false
  }
}

test fn an_unverifiable_relation_refuses_rather_than_assuming_newer() -> Bool {
  match decide_deploy_revision(
    deployed: sha_a,
    candidate: sha_c,
    relation: RelationUnverifiable { cause: "ancestry probe could not answer" as NonEmptyStr },
  ) {
    Refuse { cause: c } => match c {
      RevisionRelationUnverifiable { cause: why } => why == ("ancestry probe could not answer" as NonEmptyStr)
      UnrelatedRevisionHistories => false
      ActiveRevisionUngrounded => false
    }
    Keep { reason: _ } => false
    Advance { admission: _ } => false
  }
}

data decision_totality_note: String = "Every observation lands in exactly one disposition, asserted rather than trusted. This is what makes the three-way split real: a new relation variant fails to compile until it states which disposition it belongs to, and the counts below fail if two arms ever collapse into one."

data all_relations: List<DeployRevisionRelation> = [
  SameRevision,
  DeployedIsAncestor,
  CandidateIsAncestor,
  UnrelatedHistories,
  RelationUnverifiable { cause: "probe failed" as NonEmptyStr },
]

fn decision_is_advance(d: DeployDecision) -> Bool {
  match d {
    Advance { admission: _ } => true
    Keep { reason: _ } => false
    Refuse { cause: _ } => false
  }
}

fn decision_is_keep(d: DeployDecision) -> Bool {
  match d {
    Keep { reason: _ } => true
    Advance { admission: _ } => false
    Refuse { cause: _ } => false
  }
}

fn decision_is_refuse(d: DeployDecision) -> Bool {
  match d {
    Refuse { cause: _ } => true
    Advance { admission: _ } => false
    Keep { reason: _ } => false
  }
}

test fn exactly_one_relation_advances_and_two_refuse() -> Bool {
  let ds = map(all_relations, r => decide_deploy_revision(deployed: sha_a, candidate: sha_b, relation: r))
  count(filter(ds, d => decision_is_advance(d: d))) == 1
    && count(filter(ds, d => decision_is_keep(d: d))) == 2
    && count(filter(ds, d => decision_is_refuse(d: d))) == 2
}

test fn every_relation_lands_in_exactly_one_disposition() -> Bool {
  all(all_relations, r => {
    let d = decide_deploy_revision(deployed: sha_a, candidate: sha_b, relation: r)
    let n = count(filter([decision_is_advance(d: d), decision_is_keep(d: d), decision_is_refuse(d: d)], b => b))
    n == 1
  })
}


test fn probe_pair_folds_to_the_four_observations() -> Bool {
  match deploy_revision_relation_from_probes(
    deployed: sha_a, candidate: sha_b,
    deployed_is_ancestor_of_candidate: true, candidate_is_ancestor_of_deployed: false,
  ) { DeployedIsAncestor => true, _ => false }
  && match deploy_revision_relation_from_probes(
    deployed: sha_b, candidate: sha_a,
    deployed_is_ancestor_of_candidate: false, candidate_is_ancestor_of_deployed: true,
  ) { CandidateIsAncestor => true, _ => false }
  && match deploy_revision_relation_from_probes(
    deployed: sha_a, candidate: sha_unrelated,
    deployed_is_ancestor_of_candidate: false, candidate_is_ancestor_of_deployed: false,
  ) { UnrelatedHistories => true, _ => false }
  && match deploy_revision_relation_from_probes(
    deployed: sha_a, candidate: sha_a,
    deployed_is_ancestor_of_candidate: true, candidate_is_ancestor_of_deployed: true,
  ) { SameRevision => true, _ => false }
}

data target_derivation_note: String = "The target derivations are asserted at identity grain rather than by spelling a literal, so the queue group and lease are proven to come from ONE target. The blue and green slots must be distinct — a target whose two slots collapsed to one unit would serialize against nothing and would make the cutover restart the slot it is replacing."

test fn the_queue_group_and_lease_derive_from_the_target() -> Bool {
  deploy_target_queue_group(target: Srv1Dashboard) == "srv1-dashboard-deploy"
    && string_contains(deploy_target_lease_path(target: Srv1Dashboard) as String, "srv1-dashboard")
}

test fn the_two_slots_are_distinct_and_carry_distinct_receipts() -> Bool {
  let blue = deploy_target_blue_slot(target: Srv1Dashboard)
  let green = deploy_target_green_slot(target: Srv1Dashboard)
  blue.names.unit_name != green.names.unit_name
    && deploy_slot_revision_receipt_path(slot: blue) != deploy_slot_revision_receipt_path(slot: green)
}

data receipt_outside_tree_note: String = "The receipt path must not live under the slot's rsynced repo_root, because `rsync --delete` would destroy the record whose whole purpose is to survive a partial sync. Asserted rather than commented, since the two paths are derived independently and could drift."

test fn the_revision_receipt_lives_outside_the_rsynced_tree() -> Bool {
  let blue = deploy_target_blue_slot(target: Srv1Dashboard)
  let receipt = deploy_slot_revision_receipt_path(slot: blue) as String
  !string_contains(receipt, blue.service.repo_root as String)
}

data observation_arms_note: String = "THE THREE OBSERVATIONS THE ROUTED SLOT CAN MAKE, each asserted to reach a different disposition. This is the half #7462 never had: the decision no longer starts from a CommitSha somebody already found, it starts from what the host actually said — including the two things a host can say that are not a revision at all."


data unreadable_is_the_discriminating_red_note: String = "THE DISCRIMINATING RED FOR THE ⊥-PAIR. An unreadable receipt and an unrecorded one differ by exactly one thing — whether the host answered or failed to answer — and this pair asserts they reach OPPOSITE dispositions from otherwise identical inputs. If the two were ever folded together, the test above would still pass while this one goes red, which is what makes the collapse detectable rather than merely discouraged."

test fn an_unreadable_slot_refuses_and_never_advances() -> Bool {
  match decide_deploy_for_observation(
    observed: DeployedRevisionUnreadable { cause: "planted read failure" as NonEmptyStr },
    candidate: sha_c,
    deployed_is_ancestor_of_candidate: false,
    candidate_is_ancestor_of_deployed: false,
  ) {
    Refuse { cause: _ } => true
    Advance { admission: _ } => false
    Keep { reason: _ } => false
  }
}


data unrecorded_predecessor_is_not_a_fake_sha_note: String = "The bootstrap predecessor must not render as something a reader could mistake for a revision. An empty string or a run of zeroes would read as 'advancing from 0000…' in the deploy log, which is exactly the reading that would let the bootstrap arm fire on every deploy without anyone noticing."


data advance_text_helper_note: String = "The non-Advance arms return the empty string rather than recursing or fabricating an admission: the assertion below is that the text NAMES both endpoints, and an empty string fails it. A helper that looped to satisfy the type would be an unbounded fold standing where a total one was available."

fn advance_text_or_empty(deployed: CommitSha, candidate: CommitSha) -> String {
  match decide_deploy_revision(
    deployed: deployed,
    candidate: candidate,
    relation: linear_relation(deployed: deployed, candidate: candidate),
  ) {
    Advance { admission: adm } => deploy_advance_text(admission: adm) as String
    Keep { reason: _ } => ""
    Refuse { cause: _ } => ""
  }
}

test fn the_advance_text_names_both_endpoints() -> Bool {
  let text = advance_text_or_empty(deployed: sha_a, candidate: sha_c)
  text != "" && text.length() > 80
}

data migration_red_note: String = "THE PLANTED MIGRATION RED THE OPERATOR ASKED FOR (2026-08-05): actual active is C, the receipt is missing, an older candidate A arrives. The result must NOT be an advance. An earlier revision of this file certified the opposite — it asserted that an unrecorded slot advances — so the witness was pinning the unsafe assumption rather than the invariant. That is the worse failure mode, because a green witness over a wrong premise reads as coverage.\n\nThe rollback it prevents is concrete: C routed, C's receipt write failed, older B arrives, 'unrecorded' authorizes B, the public route moves C→B."

test fn an_unrecorded_routed_slot_refuses_and_never_advances() -> Bool {
  match decide_deploy_for_observation(
    observed: DeployedRevisionUnrecorded,
    candidate: sha_a,
    deployed_is_ancestor_of_candidate: false,
    candidate_is_ancestor_of_deployed: false,
  ) {
    Refuse { cause: c } =>
      match c {
        ActiveRevisionUngrounded => true
        UnrelatedRevisionHistories => false
        RevisionRelationUnverifiable { cause: _ } => false
      }
    Advance { admission: _ } => false
    Keep { reason: _ } => false
  }
}

test fn the_advance_admission_carries_both_endpoints() -> Bool {
  match decide_deploy_revision(deployed: sha_a, candidate: sha_c, relation: DeployedIsAncestor) {
    Advance { admission: adm } => adm.from == sha_a && adm.to == sha_c
    Keep { reason: _ } => false
    Refuse { cause: _ } => false
  }
}

test fn a_recorded_slot_still_routes_through_the_ancestry_relation() -> Bool {
  match decide_deploy_for_observation(
    observed: DeployedRevisionRecorded { revision: sha_a },
    candidate: sha_c,
    deployed_is_ancestor_of_candidate: true,
    candidate_is_ancestor_of_deployed: false,
  ) {
    Advance { admission: adm } => adm.from == sha_a && adm.to == sha_c
    Keep { reason: _ } => false
    Refuse { cause: _ } => false
  }
  && match decide_deploy_for_observation(
    observed: DeployedRevisionRecorded { revision: sha_c },
    candidate: sha_a,
    deployed_is_ancestor_of_candidate: false,
    candidate_is_ancestor_of_deployed: true,
  ) {
    Keep { reason: _ } => true
    Advance { admission: _ } => false
    Refuse { cause: _ } => false
  }
}

data three_observations_three_dispositions_note: String = "EVERY OBSERVATION LANDS SOMEWHERE, and only one of the three can advance. Recorded routes through ancestry; unrecorded and unreadable both refuse, for different typed causes — different because their remedies differ: one needs the routed slot's revision grounded, the other needs the read fixed."

test fn only_a_recorded_observation_can_ever_advance() -> Bool {
  let advanced = filter(
    [
      decide_deploy_for_observation(observed: DeployedRevisionRecorded { revision: sha_a }, candidate: sha_c,
        deployed_is_ancestor_of_candidate: true, candidate_is_ancestor_of_deployed: false),
      decide_deploy_for_observation(observed: DeployedRevisionUnrecorded, candidate: sha_c,
        deployed_is_ancestor_of_candidate: false, candidate_is_ancestor_of_deployed: false),
      decide_deploy_for_observation(observed: DeployedRevisionUnreadable { cause: "planted" as NonEmptyStr }, candidate: sha_c,
        deployed_is_ancestor_of_candidate: false, candidate_is_ancestor_of_deployed: false),
    ],
    d => match d { Advance { admission: _ } => true, _ => false }
  )
  count(advanced) == 1
}

data unbound_grounding_note: String = "AN UNRECORDED ROUTED SLOT REFUSES WITH ITS OWN TYPED CAUSE, AND THE PREVIOUS ROUND'S AUTOMATIC GROUNDING IS DELETED (operator review 2026-08-05). Grounding from the slot's disk HEAD was found unbound: `gunbc serve` binds its graph at process start, so the tree can name a revision the running process is not serving, and recording it manufactures a predecessor that readmits a backward public move.\\n\\nTHIS IS THE PRODUCTION PATH AND NOT A NEIGHBOURING ONE, which is the half an earlier draft of the repair lost. That draft rewrote Unrecorded into Unreadable at the observation site, so the deploy refused with RevisionRelationUnverifiable while this witness went on asserting ActiveRevisionUngrounded — a passing assertion about a decision production no longer reached. The observation is now passed through unmodified, so the cause asserted here is the cause the deploy produces, and a future wrapper that degrades it reds."

test fn an_unrecorded_routed_slot_refuses_as_ungrounded() -> Bool {
  match decide_deploy_for_observation(
    observed: DeployedRevisionUnrecorded,
    candidate: sha_b,
    deployed_is_ancestor_of_candidate: true,
    candidate_is_ancestor_of_deployed: false,
  ) {
    Refuse { cause: c } =>
      match c {
        ActiveRevisionUngrounded => true
        UnrelatedRevisionHistories => false
        RevisionRelationUnverifiable { cause: _ } => false
      }
    Advance { admission: _ } => false
    Keep { reason: _ } => false
  }
}
