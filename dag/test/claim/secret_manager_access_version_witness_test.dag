module test.claim.secret_manager_access_version_witness


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data fixture_wire_provenance_note: String = "SYNTHETIC BY CONSTRUCTION — fictional AccessSecretVersion wire fields exercising the \{name, payload:\{data\}\} response shape with hard-coded base64 that decodes to an obviously non-credential plaintext. Capturing live API payloads into witnesses is FORBIDDEN."

data fixture_access_version_wire_name: String = "projects/example-fixture/secrets/wire-decode-lab/versions/7"
data fixture_access_version_wire_payload_data: String = "c3ludGhldGljLWZpeHR1cmUtd2lyZS1kZWNvZGUtbGFi"

test fn access_version_wire_response_decodes_synthetic_shape() -> Bool {
  match decode_sm_access_version_wire_response(
    name: fixture_access_version_wire_name,
    data_b64: fixture_access_version_wire_payload_data
  ) {
    SmAccessVersionWireDecoded { identity: identity, payload: payload } => {
      let decoded = utf8_secret_from_access_payload(payload: payload)
      identity as String == fixture_access_version_wire_name
        && decoded == ("synthetic-fixture-wire-decode-lab" as Secret)
    }
    SmAccessVersionWireDecodeRefused { identity_cause: _, payload_cause: _ } => false
  }
}

test fn access_version_payload_refuses_empty() -> Bool {
  match decode_sm_access_version_payload_wire(data_b64: "") {
    SmAccessVersionPayloadDecodeRefused { cause: SmAccessVersionPayloadEmpty } => true
    _ => false
  }
}

test fn access_version_payload_refuses_invalid_base64() -> Bool {
  match decode_sm_access_version_payload_wire(data_b64: "Zm9*") {
    SmAccessVersionPayloadDecodeRefused { cause: SmAccessVersionPayloadInvalidBase64 } => true
    _ => false
  }
}

test fn resolved_version_identity_decodes_well_formed_name() -> Bool {
  match decode_sm_resolved_version_identity_wire(name: fixture_access_version_wire_name) {
    SmResolvedVersionIdentityDecoded { identity: identity } =>
      identity as String == fixture_access_version_wire_name
    SmResolvedVersionIdentityDecodeRefused { cause: _ } => false
  }
}

test fn resolved_version_identity_refuses_empty() -> Bool {
  match decode_sm_resolved_version_identity_wire(name: "") {
    SmResolvedVersionIdentityDecodeRefused { cause: SmResolvedVersionIdentityEmpty } => true
    _ => false
  }
}

test fn resolved_version_identity_refuses_malformed() -> Bool {
  match decode_sm_resolved_version_identity_wire(name: "not-a-version-resource") {
    SmResolvedVersionIdentityDecodeRefused { cause: SmResolvedVersionIdentityMalformed } => true
    _ => false
  }
}

test fn resolved_version_identity_refuses_wrong_segment_order() -> Bool {
  match decode_sm_resolved_version_identity_wire(
    name: "/versions/7/secrets/wire-decode-lab/projects/example-fixture"
  ) {
    SmResolvedVersionIdentityDecodeRefused { cause: SmResolvedVersionIdentityMalformed } => true
    _ => false
  }
}
