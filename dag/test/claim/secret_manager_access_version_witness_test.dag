module test.claim.secret_manager_access_version_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

// SYNTHETIC BY CONSTRUCTION — fictional AccessSecretVersion wire fields for generic transport and
// base64 encoding tests. The name and payload.data values are authored inputs only; they do not
// observe, imply, or prove any production secret or credential state.
data fixture_access_version_wire_name: String = "projects/example-fixture/secrets/wire-decode-lab/versions/7"
data fixture_access_version_wire_payload_data: String = "c3ludGhldGljLWZpeHR1cmUtd2lyZS1kZWNvZGUtbGFi"

test fn access_version_wire_response_decodes_synthetic_shape() -> Bool {
  match decode_sm_access_version_wire_response(
    name: fixture_access_version_wire_name,
    data_b64: fixture_access_version_wire_payload_data
  ) {
    SmAccessVersionWireDecoded { identity: identity, payload: payload } => {
      let decoded = utf8_secret_from_access_payload(payload: payload)
      identity as String == fixture_access_version_wire_name
        && decoded == ("synthetic-fixture-wire-decode-lab" as Secret)
    }
    SmAccessVersionWireDecodeRefused { identity_cause: _, payload_cause: _ } => false
  }
}

test fn access_version_payload_refuses_empty() -> Bool {
  match decode_sm_access_version_payload_wire(data_b64: "") {
    SmAccessVersionPayloadDecodeRefused { cause: SmAccessVersionPayloadEmpty } => true
    _ => false
  }
}

test fn access_version_payload_refuses_invalid_base64() -> Bool {
  match decode_sm_access_version_payload_wire(data_b64: "Zm9*") {
    SmAccessVersionPayloadDecodeRefused { cause: SmAccessVersionPayloadInvalidBase64 } => true
    _ => false
  }
}

test fn resolved_version_identity_decodes_well_formed_name() -> Bool {
  match decode_sm_resolved_version_identity_wire(name: fixture_access_version_wire_name) {
    SmResolvedVersionIdentityDecoded { identity: identity } =>
      identity as String == fixture_access_version_wire_name
    SmResolvedVersionIdentityDecodeRefused { cause: _ } => false
  }
}

test fn resolved_version_identity_refuses_empty() -> Bool {
  match decode_sm_resolved_version_identity_wire(name: "") {
    SmResolvedVersionIdentityDecodeRefused { cause: SmResolvedVersionIdentityEmpty } => true
    _ => false
  }
}

test fn resolved_version_identity_refuses_malformed() -> Bool {
  match decode_sm_resolved_version_identity_wire(name: "not-a-version-resource") {
    SmResolvedVersionIdentityDecodeRefused { cause: SmResolvedVersionIdentityMalformed } => true
    _ => false
  }
}

test fn resolved_version_identity_refuses_wrong_segment_order() -> Bool {
  match decode_sm_resolved_version_identity_wire(
    name: "/versions/7/secrets/wire-decode-lab/projects/example-fixture"
  ) {
    SmResolvedVersionIdentityDecodeRefused { cause: SmResolvedVersionIdentityMalformed } => true
    _ => false
  }
}

test fn encode_payload_wire_roundtrips_through_decode() -> Bool {
  let credential = "synthetic-fixture-wire-decode-lab" as Secret
  let wire = encode_sm_access_version_payload_wire(credential: credential)
  match decode_sm_access_version_payload_wire(data_b64: wire) {
    SmAccessVersionPayloadDecoded { payload: payload } =>
      utf8_secret_from_access_payload(payload: payload) == credential
    SmAccessVersionPayloadDecodeRefused { cause: _ } => false
  }
}

test fn access_version_secret_wire_decodes_synthetic_fixture() -> Bool {
  match decode_sm_access_version_secret_wire(data_b64: fixture_access_version_wire_payload_data) {
    SmAccessVersionSecretDecoded { credential: credential } =>
      credential == ("synthetic-fixture-wire-decode-lab" as Secret)
    SmAccessVersionSecretDecodeRefused { cause: _ } => false
  }
}

// SYNTHETIC. The permission strings below are authored inputs describing a fictional probe
// exchange; they observe no live principal and prove nothing about any real grant.
data fixture_probe_requested: List<String> = [
  "secretmanager.versions.access",
  "secretmanager.secrets.getIamPolicy",
  "secretmanager.secrets.setIamPolicy"
]

data fixture_probe_returned: List<String> = ["secretmanager.versions.access"]

// A RETURNED permission is positive evidence and decodes to Held.
test fn probe_returns_held_for_a_returned_permission() -> Bool {
  match sm_probe_cells(requested: fixture_probe_requested, returned: fixture_probe_returned) |> first {
    Absent => false
    Present { value: cell } =>
      match cell {
        SmPermissionHeld { permission: p } => (p as String) == "secretmanager.versions.access"
        SmPermissionUndetermined { permission: _, cause: _ } => false
      }
  }
}

// THE POINT OF THE TYPE. A permission the probe did NOT return decodes to Undetermined and carries
// a cause. There is no constructor for "not held", so this instrument cannot be used to write down
// an absence claim at all -- the class is structurally unwritable rather than merely discouraged.
// A revision that added an Absent arm to make an "exact missing set" expressible would red here.
test fn probe_cannot_express_absence_for_an_unreturned_permission() -> Bool {
  v2.std.algebra.fold_list(
    xs: sm_probe_cells(requested: fixture_probe_requested, returned: fixture_probe_returned),
    empty: true,
    cons: fn(acc, cell) {
      match cell {
        SmPermissionHeld { permission: p } => acc && (p as String) == "secretmanager.versions.access"
        SmPermissionUndetermined { permission: p, cause: c } =>
          acc && (p as String) != "secretmanager.versions.access" && (c as String) != ""
      }
    }
  )
}

// The probe classifies exactly what it was ASKED about -- never more. A permission outside the
// requested list is not reported as Undetermined, because the instrument never considered it.
test fn probe_classifies_only_requested_permissions() -> Bool {
  sm_probe_cells(requested: fixture_probe_requested, returned: fixture_probe_returned).length() == 3
}
