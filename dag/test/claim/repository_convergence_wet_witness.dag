module test.claim.repository_convergence_wet_witness

import std.types { String, Bool, FilePath, GitRef }
import std.process { ProcessExit, ExitSuccess, ExitFailure }
import gunbc.live_deploy.repository_convergence { repository_converge_wet }
import extdeps.shell
import extdeps.shell.exec
import extdeps.git
import extdeps.filesystem.filesystem_io
import std.algebra { trim }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// FIRST REAL EXECUTION EVIDENCE FOR repository_converge_wet. The fixture is rebuilt per row from
// ordinary git commands in a fresh mktemp directory; the function under test then performs its own
// ForEachRef/WorktreeList/rev-parse/reflog/write-tree/diff/fetch/update-ref/reset/readback chain —
// none of those answers is authored by this witness. Hermetic execution must refuse this file.
// Local recipe: claim_batch --wet --source-root dag --source-root src/v2 --entry
// dag/test/claim/repository_convergence_wet_witness.dag --functions <comma-joined>:
//   detached_primary_transition_executes_and_preserves_packed_loose_refs_and_linked_worktree,
//   already_at_candidate_repairs_a_stale_index,
//   a_legacy_derived_roster_file_is_retired_and_read_back_absent
// Scratch-repository WET matrix over the real git transport.

// Record/replay receipt recipe (the setup invocation is stable; its recorded stdout carries the
// original mktemp path into every subsequent operation key): run the roster above with `--wet
// --record --fixture-store target/repository-convergence-fixtures`; replay the same roster with
// `--hermetic`; then replay against an EMPTY store. The populated replay must pass all rows and the
// empty-store control must refuse every row with `missing recorded fixture` — the asymmetry proving
// replay consumed the recorded observations instead of silently reaching live git.
// Populated replay passes; empty-store replay refuses every effectful row.

type ScratchRepository {
  root: String
  repo: String
  remote_path: String
  old: String
  candidate: String
}

fn scratch_repository(already_candidate: Bool) -> ScratchRepository? {
  let dir = shell.Mktemp.Dir()
  let root = dir.path as String
  let remote = concat(root, "/remote.git")
  let repo = concat(root, "/repo")
  let linked = concat(root, "/linked")
  let repo_path = repo as FilePath
  let bare = shell.Exec.RunArgv(program: "git", arguments: ["init", "-q", "--bare", remote])
  let init = shell.Exec.RunArgv(program: "git", arguments: ["init", "-q", repo])
  let email = git.Core.ConfigLocalSetInRepo(repo: repo_path, key: "user.email", value: "witness@example.invalid")
  let name = git.Core.ConfigLocalSetInRepo(repo: repo_path, key: "user.name", value: "witness")
  let wrote_old = Filesystem.Write(path: concat(repo, "/tracked"), content: "old")
  let added_old = git.Core.AddAllInRepo(repo: repo_path)
  let committed_old = git.Core.CommitInRepo(repo: repo_path, message: "old")
  let old = git.Core.RevParseInRepo(repo: repo_path, target: "HEAD" as GitRef)
  let wrote_new = Filesystem.Write(path: concat(repo, "/tracked"), content: "new")
  let added_new = git.Core.AddAllInRepo(repo: repo_path)
  let committed_new = git.Core.CommitInRepo(repo: repo_path, message: "new")
  let candidate = git.Core.RevParseInRepo(repo: repo_path, target: "HEAD" as GitRef)
  let old_sha = trim(s: old.revision)
  let candidate_sha = trim(s: candidate.revision)
  let branch = shell.Exec.RunArgv(program: "git", arguments: ["-C", repo, "branch", "dispatch-linked", old_sha])
  let worktree = git.Core.WorktreeAddInRepo(repo: repo_path, path: linked as FilePath, start_point: "dispatch-linked")
  let packed_ref = shell.Exec.RunArgv(program: "git", arguments: ["-C", repo, "update-ref", "refs/dispatch/packed", old_sha])
  let pack = shell.Exec.RunArgv(program: "git", arguments: ["-C", repo, "pack-refs", "--all", "--prune"])
  let loose_ref = shell.Exec.RunArgv(program: "git", arguments: ["-C", repo, "update-ref", "refs/dispatch/loose", old_sha])
  let remote_add = shell.Exec.RunArgv(program: "git", arguments: ["-C", repo, "remote", "add", "origin", remote])
  let pushed = shell.Exec.RunArgv(program: "git", arguments: ["-C", repo, "push", "-q", "origin", concat(candidate_sha, ":refs/heads/main")])
  let detached = shell.Exec.RunArgv(program: "git", arguments: ["-C", repo, "checkout", "-q", "--detach", old_sha])
  let tracking = shell.Exec.RunArgv(program: "git", arguments: ["-C", repo, "update-ref", "refs/remotes/origin/main", old_sha])
  let positioned = if already_candidate {
    git.Core.ResetHardInRepo(repo: repo_path, target: candidate_sha).exit_code == 0
      && shell.Copy.File(source: concat(repo, "/.git/index") as FilePath, destination: concat(root, "/good-index") as FilePath).success
      && shell.Exec.RunArgv(program: "git", arguments: ["-C", repo, "read-tree", old_sha]).exit_code == 0
  } else {
    git.Core.ResetHardInRepo(repo: repo_path, target: old_sha).exit_code == 0
  }
  if dir.success && bare.exit_code == 0 && init.exit_code == 0 && email.success && name.success && wrote_old.success && added_old.exit_code == 0 && committed_old.exit_code == 0 && old.exit_code == 0 && wrote_new.success && added_new.exit_code == 0 && committed_new.exit_code == 0 && candidate.exit_code == 0 && branch.exit_code == 0 && worktree.exit_code == 0 && packed_ref.exit_code == 0 && pack.exit_code == 0 && loose_ref.exit_code == 0 && remote_add.exit_code == 0 && pushed.exit_code == 0 && detached.exit_code == 0 && tracking.exit_code == 0 && positioned {
    Present { value: ScratchRepository { root: root, repo: repo, remote_path: remote, old: old_sha, candidate: candidate_sha } }
  } else { none }
}

fn remove_scratch(s: ScratchRepository) -> Bool {
  shell.Remove.RecursiveForce(path: s.root as FilePath).success
}

fn run_scratch(s: ScratchRepository) -> ProcessExit {
  repository_converge_wet(repo: s.repo, remote: "origin", base_ref: "refs/remotes/origin/main", candidate: s.candidate)
}

// THE WET BOUNDARY RETURNS ProcessExit, NOT RepositoryConvergenceOutcome, so these witnesses
// discriminate refusal ownership through repository_convergence_detail's rendered cause. The
// coupling is deliberate: repository_converge_wet consumes the typed outcome internally and exposes
// only the process contract production receives. Pure witnesses separately match the coproduct
// arms; changing human-facing text can red these integration witnesses even with adjudication
// intact, because the exposed process diagnostic is part of the end-to-end contract executed here.
// WET assertions inspect the only refusal carrier repository_converge_wet exposes:
// ProcessExit.reason.

test fn detached_primary_transition_executes_and_preserves_packed_loose_refs_and_linked_worktree() -> Bool {
  match scratch_repository(already_candidate: false) {
    Absent => false
    Present { value: s } => {
      let outcome = run_scratch(s: s)
      let cleaned = remove_scratch(s: s)
      match outcome { ExitSuccess => cleaned _ => false }
    }
  }
}

test fn already_at_candidate_repairs_a_stale_index() -> Bool {
  match scratch_repository(already_candidate: true) {
    Absent => false
    Present { value: s } => {
      let outcome = run_scratch(s: s)
      let cleaned = remove_scratch(s: s)
      match outcome { ExitSuccess => cleaned _ => false }
    }
  }
}

// DROPPED CASES: cas_race_is_observed_after_fetch and reset_refusal_after_successful_cas_is_nonzero
// lived here. Both needed code to run BETWEEN the repository pre-state observation and the reset, and
// their only interposition point was remote.origin.uploadpack, which the production fetch's explicit
// --upload-pack overrides (#12279); a lock planted before the run is instead refused by the pre-state
// observation, a different cause. Both were red on main. Declared at
// gunbc.rung_drop.convergence_fetch_window_fixture_interposition.

test fn unreadable_head_refuses_before_fetch_or_mutation() -> Bool {
  match scratch_repository(already_candidate: false) {
    Absent => false
    Present { value: s } => {
      let changed = Filesystem.Write(path: concat(s.repo, "/.git/HEAD"), content: "ref: refs/heads/missing\n").success
      let outcome = run_scratch(s: s)
      let cleaned = remove_scratch(s: s)
      changed && cleaned && match outcome { ExitFailure { code: _, reason: why } => string_contains(s: why, pattern: "before the transition could not be observed") _ => false }
    }
  }
}

test fn undecodable_worktree_roster_refuses_before_mutation() -> Bool {
  match scratch_repository(already_candidate: false) {
    Absent => false
    Present { value: s } => {
      let changed = Filesystem.Write(path: concat(s.repo, "/.git/worktrees/linked/HEAD"), content: "invalid").success
      let outcome = run_scratch(s: s)
      let cleaned = remove_scratch(s: s)
      changed && cleaned && match outcome { ExitFailure { code: _, reason: why } => string_contains(s: why, pattern: "worktree") _ => false }
    }
  }
}

test fn wrong_primary_standing_refuses_from_gits_roster() -> Bool {
  match scratch_repository(already_candidate: false) {
    Absent => false
    Present { value: s } => {
      let linked_repo = concat(s.root, "/linked")
      let outcome = repository_converge_wet(repo: linked_repo, remote: "origin", base_ref: "refs/remotes/origin/main", candidate: s.candidate)
      let cleaned = remove_scratch(s: s)
      cleaned && match outcome { ExitFailure { code: _, reason: _ } => true _ => false }
    }
  }
}

// A LEGACY DERIVED ROSTER LEFT BY AN OLDER gunbc IS RETIRED BY CONVERGENCE AND READ BACK ABSENT.
// The fixture plants the file the old binary wrote; convergence must remove it (the loader never
// does) and only then report success.
test fn a_legacy_derived_roster_file_is_retired_and_read_back_absent() -> Bool {
  match scratch_repository(already_candidate: false) {
    Absent => false
    Present { value: s } => {
      let roster = join([s.repo, "/dag/gunbc/rung_drop/roster.dag"], "")
      let planted = shell.Exec.RunArgv(program: "mkdir", arguments: ["-p", concat(s.repo, "/dag/gunbc/rung_drop")]).exit_code == 0 && Filesystem.Write(path: roster, content: "legacy").success
      let outcome = run_scratch(s: s)
      let absent = shell.Exec.RunArgv(program: "test", arguments: ["!", "-e", roster]).exit_code == 0
      let cleaned = remove_scratch(s: s)
      let converged = match outcome { ExitSuccess => true _ => false }
      planted && converged && absent && cleaned
    }
  }
}
