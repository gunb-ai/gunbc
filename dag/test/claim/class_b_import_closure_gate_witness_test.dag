module test.claim.class_b_import_closure_gate_witness

import v2.workflow.class_b_import_closure_transport {
  class_b_declared_import_closure_lists_rust_import,
  class_b_ambient_pool_provider_preserves_listed_import
}
import std.types { Bool }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data class_b_gate_witness_note: String = "Required-floor executing consumer for Class B rows 1-2 (#6985). One witness replaces the deleted rust_test_fixtures_import_closure thin wrappers: same transport funcs, one fold, enrolled on required-floor discovery (not path-excluded). Rows 1-2 call observe_declared_import_closure_symbol_binding over class_b_declared_import_pool_roots only (no git/shell overlay path); SubstrateInputsOnly admits the row to the hermetic claim manifest. Rows 3-4 predicate unit controls stay in class_b_import_closure_binding_refusal_witness_test.dag and class_b_strip_receipt_witness_test.dag; rows 3-4 integration remains in run_class_b_import_closure_gate (source_root_ingest_gate when that gate returns to required floor)."

test fn class_b_rows_1_and_2_hold() -> Bool {
  class_b_declared_import_closure_lists_rust_import()
    && class_b_ambient_pool_provider_preserves_listed_import()
}
