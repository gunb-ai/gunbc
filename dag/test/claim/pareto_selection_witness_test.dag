module test.claim.pareto_selection_witness

import std.types { Bool, List, NonEmptyStr, Int, String }
import std.process { ProcessExit, ExitSuccess, ExitFailure }
import std.decl_ref { DeclarationRef, WholeDeclaration, declaration_ref_eq }
import std.interval { degenerate_interval, closed_interval, IntervalConstruction, IntervalReady, IntervalRefused, OrderedClosedInterval }
import std.pareto {
  axis_roster_contradiction,
  AxisGoal, HigherIsBetter, LowerIsBetter,
  SelectionAxis, AxisReading, ParetoEntry, ParetoStanding, Domination,
  ProvisionallyNonDominated, DominatedBy, NotComputable, PendingEvidence, SelectionRefused,
  PairStanding, PairDominates, PairNoDominance, PairRefused, PairPendingEvidence,
  PairEvidenceIncomplete,
  AxisComparison, Better, Same, Worse, UndecidedOnEvidence, axis_comparison_interval,
  compare_pair, entry_standing, pareto_label, entry_contradicts_its_declaration,
  AxisGap,
}

// SYNTHETIC FIXTURES ONLY. The spine is domain-blind, so its witness plants exact entries
// and asserts exact standings - including the refusal arms a real corpus may not exercise
// on the day the wall matters. Identity is a DeclarationRef pointing at the fixture row
// itself; display labels are deliberately reused across distinct identities to prove the
// label carries no authority.

data axis_cost_id: DeclarationRef = DeclarationRef { module_path: "test.claim.pareto_selection_witness", decl_name: "axis_cost", field: WholeDeclaration }
data axis_power_id: DeclarationRef = DeclarationRef { module_path: "test.claim.pareto_selection_witness", decl_name: "axis_power", field: WholeDeclaration }

data axis_cost: SelectionAxis = SelectionAxis { identity: axis_cost_id, goal: LowerIsBetter }
data axis_power: SelectionAxis = SelectionAxis { identity: axis_power_id, goal: HigherIsBetter }

data both_axes: List<SelectionAxis> = [axis_cost, axis_power]
data cost_only: List<SelectionAxis> = [axis_cost]
data power_only: List<SelectionAxis> = [axis_power]

// A second axis row carrying the SAME identity under a different goal - the duplicate the
// selection must refuse rather than resolve first-one-wins.
data axis_cost_duplicate: SelectionAxis = SelectionAxis { identity: axis_cost_id, goal: HigherIsBetter }
data axis_power_duplicate: SelectionAxis = SelectionAxis { identity: axis_power_id, goal: LowerIsBetter }
data duplicated_axes: List<SelectionAxis> = [axis_cost, axis_cost_duplicate, axis_power]

data no_missing: List<AxisGap> = []

data id_cheap_strong: DeclarationRef = DeclarationRef { module_path: "test.claim.pareto_selection_witness", decl_name: "entry_cheap_strong", field: WholeDeclaration }
data id_dear_weak: DeclarationRef = DeclarationRef { module_path: "test.claim.pareto_selection_witness", decl_name: "entry_dear_weak", field: WholeDeclaration }
data id_dear_strong: DeclarationRef = DeclarationRef { module_path: "test.claim.pareto_selection_witness", decl_name: "entry_dear_strong", field: WholeDeclaration }
data id_quote_pending: DeclarationRef = DeclarationRef { module_path: "test.claim.pareto_selection_witness", decl_name: "entry_quote_pending", field: WholeDeclaration }
data id_reading_hole: DeclarationRef = DeclarationRef { module_path: "test.claim.pareto_selection_witness", decl_name: "entry_reading_hole", field: WholeDeclaration }
data id_twin_dominated: DeclarationRef = DeclarationRef { module_path: "test.claim.pareto_selection_witness", decl_name: "entry_twin_dominated", field: WholeDeclaration }
data id_double_reading: DeclarationRef = DeclarationRef { module_path: "test.claim.pareto_selection_witness", decl_name: "entry_double_reading", field: WholeDeclaration }

data entry_cheap_strong: ParetoEntry = ParetoEntry {
  identity: id_cheap_strong,
  display_label: "twin",
  readings: [
    AxisReading { axis: axis_cost_id, interval_micro: degenerate_interval(point: 100) },
    AxisReading { axis: axis_power_id, interval_micro: degenerate_interval(point: 500) },
  ],
  missing_inputs: no_missing,
}

data entry_dear_weak: ParetoEntry = ParetoEntry {
  identity: id_dear_weak,
  display_label: "dear-weak",
  readings: [
    AxisReading { axis: axis_cost_id, interval_micro: degenerate_interval(point: 200) },
    AxisReading { axis: axis_power_id, interval_micro: degenerate_interval(point: 400) },
  ],
  missing_inputs: no_missing,
}

// The dominated twin: SAME display label as entry_cheap_strong, DIFFERENT identity, worse
// on both axes. If the fold excluded self-comparison by label, this entry would be skipped
// and wrongly survive on the frontier.
data entry_twin_dominated: ParetoEntry = ParetoEntry {
  identity: id_twin_dominated,
  display_label: "twin",
  readings: [
    AxisReading { axis: axis_cost_id, interval_micro: degenerate_interval(point: 300) },
    AxisReading { axis: axis_power_id, interval_micro: degenerate_interval(point: 300) },
  ],
  missing_inputs: no_missing,
}

data entry_dear_strong: ParetoEntry = ParetoEntry {
  identity: id_dear_strong,
  display_label: "dear-strong",
  readings: [
    AxisReading { axis: axis_cost_id, interval_micro: degenerate_interval(point: 200) },
    AxisReading { axis: axis_power_id, interval_micro: degenerate_interval(point: 600) },
  ],
  missing_inputs: no_missing,
}

data entry_quote_pending: ParetoEntry = ParetoEntry {
  identity: id_quote_pending,
  display_label: "quote-pending",
  readings: [
    AxisReading { axis: axis_cost_id, interval_micro: degenerate_interval(point: 1) },
    AxisReading { axis: axis_power_id, interval_micro: degenerate_interval(point: 1) },
  ],
  missing_inputs: [AxisGap { axis: axis_cost_id, cause: "a written quote is outstanding" }],
}

data entry_reading_hole: ParetoEntry = ParetoEntry {
  identity: id_reading_hole,
  display_label: "reading-hole",
  readings: [
    AxisReading { axis: axis_cost_id, interval_micro: degenerate_interval(point: 50) },
  ],
  missing_inputs: no_missing,
}

// Two readings on ONE axis identity - the duplicate the pair must refuse rather than take
// the first.
data entry_double_reading: ParetoEntry = ParetoEntry {
  identity: id_double_reading,
  display_label: "double-reading",
  readings: [
    AxisReading { axis: axis_cost_id, interval_micro: degenerate_interval(point: 10) },
    AxisReading { axis: axis_cost_id, interval_micro: degenerate_interval(point: 999) },
    AxisReading { axis: axis_power_id, interval_micro: degenerate_interval(point: 700) },
  ],
  missing_inputs: no_missing,
}

// The CLEAN field for the domination and trade-off controls; the holed field adds the
// reading-hole entry for the fail-closed control; the reversed field proves order
// invariance; the duplicated field plants one identity twice.
// THE DANGEROUS CASE, AND IT NEEDED ITS OWN ROW. entry_quote_pending declares a gap but is the
// WORST entry on power (that axis is HigherIsBetter), so it could never dominate anything and
// proves nothing about whether the gate is load-bearing. This row is the one that matters: cost 1
// and power 999 make it beat every other entry on both funded axes, and it declares an outstanding
// quote. Reading-only dominance and declared-gap ineligibility point in opposite directions here,
// which is exactly the case a silent gate cannot be trusted on.
//
// It is deliberately NOT a member of clean_field - the other controls pin that field's standings -
// and lives in gap_best_field with the entries it is compared against.
data id_gap_but_best: DeclarationRef = DeclarationRef { module_path: "test.claim.pareto_selection_witness", decl_name: "entry_gap_but_best", field: WholeDeclaration }

data entry_gap_but_best: ParetoEntry = ParetoEntry {
  identity: id_gap_but_best,
  display_label: "gap-but-best",
  readings: [
    AxisReading { axis: axis_cost_id, interval_micro: degenerate_interval(point: 1) },
    AxisReading { axis: axis_power_id, interval_micro: degenerate_interval(point: 999) },
  ],
  missing_inputs: [AxisGap { axis: axis_cost_id, cause: "a written quote is outstanding, so this row's cost is not evidence" }],
}

// THE PROBE FOR AN AXIS-BLIND EXEMPTION. entry_contradicts_its_declaration computes
// declares_its_gaps ONCE for the whole entry, outside its per-axis fold, so a gap declared about
// ONE axis exempts the absent-reading check on EVERY axis. This row declares power unmeasured and
// carries a power reading anyway, while silently having no COST reading - a projector defect on an
// axis its declaration says nothing about. Its honest twin below declares the same gap and is
// complete on the funded axes.
//
// The claim under test is NOT that dominance fails open: both rows reach NotComputable, which is
// fail-shut and correct. What is lost is DISTINGUISHABILITY - the defective row and the honest row
// produce the same empty contradiction list, so a dropped reading is indistinguishable from a
// declaration. That is the exact conflation the per-defect-class split was made to end, one level
// down: the split separated DUPLICATE from ABSENT, and left ABSENT blind to WHICH AXIS was excused.
data id_gap_hides_a_hole: DeclarationRef = DeclarationRef { module_path: "test.claim.pareto_selection_witness", decl_name: "entry_gap_hides_a_hole", field: WholeDeclaration }
data id_gap_declared_and_complete: DeclarationRef = DeclarationRef { module_path: "test.claim.pareto_selection_witness", decl_name: "entry_gap_declared_and_complete", field: WholeDeclaration }

data entry_gap_hides_a_hole: ParetoEntry = ParetoEntry {
  identity: id_gap_hides_a_hole,
  display_label: "gap-hides-a-hole",
  readings: [
    AxisReading { axis: axis_power_id, interval_micro: degenerate_interval(point: 700) },
  ],
  missing_inputs: [AxisGap { axis: axis_power_id, cause: "power is unmeasured pending a metered pilot" }],
}

// THE HONEST TWIN MUST ACTUALLY EXERCISE THE EXEMPTION, and the first version of this fixture did
// not. It carried BOTH readings, so no absent-reading branch was ever reached for it and the
// "never exempt" mutation left it green - a conjunct that discriminated nothing while reading as
// though it guarded the over-scoping direction. It now has NO power reading, exactly the absence
// its declared gap is about, so the exemption is on the executed path and removing it goes red.
data entry_gap_declared_and_complete: ParetoEntry = ParetoEntry {
  identity: id_gap_declared_and_complete,
  display_label: "gap-covers-its-own-hole",
  readings: [
    AxisReading { axis: axis_cost_id, interval_micro: degenerate_interval(point: 50) },
  ],
  missing_inputs: [AxisGap { axis: axis_power_id, cause: "power is unmeasured pending a metered pilot" }],
}

data id_gap_names_an_unfunded_axis: DeclarationRef = DeclarationRef { module_path: "test.claim.pareto_selection_witness", decl_name: "entry_gap_names_an_unfunded_axis", field: WholeDeclaration }
data axis_bandwidth_id: DeclarationRef = DeclarationRef { module_path: "test.claim.pareto_selection_witness", decl_name: "axis_bandwidth", field: WholeDeclaration }

// A REAL AXIS THIS SELECTION DOES NOT FUND. Declared, well-formed, and deliberately absent from
// both_axes -- because UNFUNDED means "not among the axes this selection weighs", never "names
// nothing". Pointing the gap at a decl_name no module declares would have tested the citation
// checker rather than the fold, and CI refused exactly that: `CITED-DECLARATION-ABSENT ... cites
// axis_bandwidth, which that module does not declare` (DESIGN section 3, cite the symbol).
data axis_bandwidth: SelectionAxis = SelectionAxis { identity: axis_bandwidth_id, goal: HigherIsBetter }

// COMPLETE on every axis this selection funds, and carrying a gap that names an axis it does not.
// Nothing here is incomplete: both folds over both_axes find their reading. The only defect is the
// gap itself, which is why this fixture isolates the unfunded-axis clause from the other two.
data entry_gap_names_an_unfunded_axis: ParetoEntry = ParetoEntry {
  identity: id_gap_names_an_unfunded_axis,
  display_label: "gap-names-an-unfunded-axis",
  readings: [
    AxisReading { axis: axis_cost_id, interval_micro: degenerate_interval(point: 120) },
    AxisReading { axis: axis_power_id, interval_micro: degenerate_interval(point: 480) },
  ],
  missing_inputs: [AxisGap { axis: axis_bandwidth_id, cause: "uplink is unmeasured pending a carrier turn-up" }],
}

data gap_best_field: List<ParetoEntry> = [
  entry_gap_but_best,
  entry_dear_weak,
  entry_cheap_strong,
]

data clean_field: List<ParetoEntry> = [
  entry_cheap_strong,
  entry_dear_weak,
  entry_dear_strong,
  entry_quote_pending,
  entry_twin_dominated,
]

data clean_field_reversed: List<ParetoEntry> = [
  entry_twin_dominated,
  entry_quote_pending,
  entry_dear_strong,
  entry_dear_weak,
  entry_cheap_strong,
]

data holed_field: List<ParetoEntry> = [
  entry_cheap_strong,
  entry_dear_weak,
  entry_dear_strong,
  entry_quote_pending,
  entry_reading_hole,
]

// The same poisoned field with the hole FIRST: refusal precedence must not depend on where
// the malformed entry sits relative to a valid dominator.
data holed_field_hole_first: List<ParetoEntry> = [
  entry_reading_hole,
  entry_cheap_strong,
  entry_dear_weak,
  entry_dear_strong,
  entry_quote_pending,
]

data duplicated_field: List<ParetoEntry> = [
  entry_cheap_strong,
  entry_dear_weak,
  entry_cheap_strong,
]

data spine_sensitivities: List<NonEmptyStr> = ["a planted sensitivity so frontier survivors carry their caveat"]

fn dominators_of(s: ParetoStanding) -> List<Domination> {
  match s {
    DominatedBy { dominators } => dominators,
    ProvisionallyNonDominated { sensitivities } => no_dominations,
    NotComputable { missing } => no_dominations,
    PendingEvidence { undecided } => no_dominations,
    SelectionRefused { cause } => no_dominations,
  }
}

data no_dominations: List<Domination> = []

fn has_dominator(s: ParetoStanding, expected: DeclarationRef) -> Bool {
  fold(dominators_of(s: s), init: false, f: fn(acc, d) { acc || declaration_ref_eq(a: d.candidate, b: expected) })
}

fn winning_axis_count_of(s: ParetoStanding, dominator: DeclarationRef) -> Int {
  fold(dominators_of(s: s), init: 0, f: fn(acc, d) {
    if declaration_ref_eq(a: d.candidate, b: dominator) { acc + count(d.winning_axes) } else { acc }
  })
}

// THE HONEST GAP, and only that. This asks whether the SUBJECT declared an input it does not have
// -- nothing is broken and nothing is being hidden. It deliberately answers false for a projector
// contradiction, which std.pareto now routes to SelectionRefused, and false for readings that are
// present but merely too coarse. Folding any of those together would silently widen every claim
// below, which is what the single old arm did.
fn standing_is_incomparable(s: ParetoStanding) -> Bool {
  match s {
    NotComputable { missing } => true,
    PendingEvidence { undecided } => false,
    ProvisionallyNonDominated { sensitivities } => false,
    DominatedBy { dominators } => false,
    SelectionRefused { cause } => false,
  }
}

fn standing_is_refused(s: ParetoStanding) -> Bool {
  match s {
    SelectionRefused { cause } => true,
    NotComputable { missing } => false,
    PendingEvidence { undecided } => false,
    ProvisionallyNonDominated { sensitivities } => false,
    DominatedBy { dominators } => false,
  }
}

fn witness_not_dominated(s: ParetoStanding) -> Bool {
  match s {
    DominatedBy { dominators } => false,
    ProvisionallyNonDominated { sensitivities } => true,
    NotComputable { missing } => false,
    PendingEvidence { undecided } => false,
    SelectionRefused { cause } => false,
  }
}

// CONTROL 1. Strict domination lands DominatedBy with EVERY dominator named BY IDENTITY
// and its winning axes carried as axis identities: cheap-strong beats dear-weak on both
// axes, dear-strong beats it on power alone, and the fold reports both rather than
// latching whichever the field order presented first. The label derivation renders the
// identities, never the display labels.
test fn witness_dominated_entry_names_its_dominator() -> Bool {
  let standing = entry_standing(subject: entry_dear_weak, field: clean_field, axes: both_axes, sensitivities: spine_sensitivities)
  count(dominators_of(s: standing)) == 2
    && has_dominator(s: standing, expected: id_cheap_strong)
    && has_dominator(s: standing, expected: id_dear_strong)
    && winning_axis_count_of(s: standing, dominator: id_cheap_strong) == 2
    && winning_axis_count_of(s: standing, dominator: id_dear_strong) == 1
    && string_contains(s: pareto_label(s: standing), pattern: "dominated by ")
    && string_contains(s: pareto_label(s: standing), pattern: "test.claim.pareto_selection_witness::entry_cheap_strong")
}

// CONTROL 2. A genuine trade-off keeps both entries on the frontier with the sensitivities
// attached - the spine refuses to rank what the axes do not decide.
test fn witness_tradeoff_pair_both_survive() -> Bool {
  let cheap = entry_standing(subject: entry_cheap_strong, field: clean_field, axes: both_axes, sensitivities: spine_sensitivities)
  let strong = entry_standing(subject: entry_dear_strong, field: clean_field, axes: both_axes, sensitivities: spine_sensitivities)
  let cheap_carries_sensitivities = match cheap {
    ProvisionallyNonDominated { sensitivities } => count(sensitivities) > 0,
    DominatedBy { dominators } => false,
    NotComputable { missing } => false,
    PendingEvidence { undecided } => false,
    SelectionRefused { cause } => false,
  }
  witness_not_dominated(s: cheap) && witness_not_dominated(s: strong)
    && cheap_carries_sensitivities
}

// CONTROL 3. Declared-missing inputs land incomparable, never dominated and never dominating:
// the quote-pending entry's too-good-to-be-true planted readings must not knock anything off
// the frontier, and its own standing must name the outstanding quote.
test fn witness_missing_inputs_neither_dominate_nor_die() -> Bool {
  let pending = entry_standing(subject: entry_quote_pending, field: clean_field, axes: both_axes, sensitivities: spine_sensitivities)
  let cheap_unmoved = witness_not_dominated(s: entry_standing(subject: entry_cheap_strong, field: clean_field, axes: both_axes, sensitivities: spine_sensitivities))
  standing_is_incomparable(s: pending) && cheap_unmoved && pareto_label(s: pending) == "not computable"
}

// RE-ENROLLED 2026-08-19 against the standing path: pair_dominates is deleted.
// Its Bool answered false for PairRefused, so the hole_never_dominates line
// below used to be satisfied by the very conflation this control was written to
// catch. The hole must not merely fail to dominate — the comparison must
// REFUSE, and the arm is named.
//
// CONTROL 4 - THE FAIL-CLOSED DISCRIMINATOR. An entry that claims complete inputs while
// lacking a compared reading REFUSES the pair, and the refusal reaches the standing rather than
// being skipped: a partial comparison never silently survives. The refusal poisons the field
// WHEREVER the hole sits - before or after a valid dominator.
//
// IT NOW REACHES SelectionRefused, NOT NotComputable, and the change is the point rather than a
// relabelling. An entry declaring COMPLETE inputs while lacking a reading is not short of evidence:
// it contradicts its own declaration, which is a projector defect and belongs with the other
// structural contradictions. entry_quote_pending, two controls above, declares what it lacks and
// still lands in NotComputable -- so this pair of claims is what makes the two states observably
// different rather than two spellings of one.
test fn witness_absent_reading_refuses_the_pair() -> Bool {
  let pair = compare_pair(a: entry_cheap_strong, b: entry_reading_hole, axes: both_axes)
  let pair_refuses = match pair {
    PairRefused { cause } => true,
    PairDominates { winning_axes } => false,
    PairNoDominance => false,
    PairPendingEvidence { undecided_axes } => false,
    PairEvidenceIncomplete { missing } => false,
  }
  let standing_surfaces_it = standing_is_refused(s: entry_standing(subject: entry_reading_hole, field: holed_field, axes: both_axes, sensitivities: spine_sensitivities))
  let hole_never_dominates = match compare_pair(a: entry_reading_hole, b: entry_dear_weak, axes: both_axes) {
    PairRefused { cause } => true,
    PairDominates { winning_axes } => false,
    PairNoDominance => false,
    PairPendingEvidence { undecided_axes } => false,
    PairEvidenceIncomplete { missing } => false,
  }
  let hole_poisons_the_field = standing_is_refused(s: entry_standing(subject: entry_cheap_strong, field: holed_field, axes: both_axes, sensitivities: spine_sensitivities))
  let hole_poisons_from_the_front = standing_is_refused(s: entry_standing(subject: entry_dear_weak, field: holed_field_hole_first, axes: both_axes, sensitivities: spine_sensitivities))
  pair_refuses && standing_surfaces_it && hole_never_dominates && hole_poisons_the_field && hole_poisons_from_the_front
}

// CONTROL 5. Orientation: the same pair flips winner when the axis flips direction, so
// the axis goal orientation is provably consulted rather than decorative.
test fn witness_axis_orientation_is_consulted() -> Bool {
  standing_dominates(a: entry_cheap_strong, b: entry_dear_strong, axes: cost_only)
    && standing_dominates(a: entry_dear_strong, b: entry_cheap_strong, axes: power_only)
    && !standing_dominates(a: entry_dear_strong, b: entry_cheap_strong, axes: cost_only)
}

// The local helper the deleted pair_dominates used to be, EXCEPT that it is
// local to a witness that has already established what a refusal does: a
// refusal here is false because this claim compares two entries with complete
// readings, and a refusal would be a fixture defect the claim above catches.
fn standing_dominates(a: ParetoEntry, b: ParetoEntry, axes: List<SelectionAxis>) -> Bool {
  match compare_pair(a: a, b: b, axes: axes) {
    PairDominates { winning_axes } => true,
    PairNoDominance => false,
    PairRefused { cause } => false,
    PairPendingEvidence { undecided_axes } => false,
    PairEvidenceIncomplete { missing } => false,
  }
}

// CONTROL 6 - LABEL CARRIES NO AUTHORITY. Two entries share the display label "twin" with
// distinct identities; the worse one is still challenged and lands dominated by the better
// one. Under the retired label-keyed exclusion this comparison was skipped as
// self-comparison and the twin wrongly survived.
test fn witness_shared_label_still_compares() -> Bool {
  let twin = entry_standing(subject: entry_twin_dominated, field: clean_field, axes: both_axes, sensitivities: spine_sensitivities)
  has_dominator(s: twin, expected: id_cheap_strong) && count(dominators_of(s: twin)) == 3
}

// CONTROL 7 - ORDER INVARIANCE. Reversing the field changes neither the standing class nor
// the identified dominator: the fold accumulates every challenge instead of latching the
// first.
test fn witness_field_order_is_irrelevant() -> Bool {
  let forward = entry_standing(subject: entry_dear_weak, field: clean_field, axes: both_axes, sensitivities: spine_sensitivities)
  let reversed = entry_standing(subject: entry_dear_weak, field: clean_field_reversed, axes: both_axes, sensitivities: spine_sensitivities)
  count(dominators_of(s: forward)) == 2 && count(dominators_of(s: reversed)) == 2
    && has_dominator(s: forward, expected: id_cheap_strong) && has_dominator(s: reversed, expected: id_cheap_strong)
    && has_dominator(s: forward, expected: id_dear_strong) && has_dominator(s: reversed, expected: id_dear_strong)
    && witness_not_dominated(s: entry_standing(subject: entry_cheap_strong, field: clean_field_reversed, axes: both_axes, sensitivities: spine_sensitivities))
}

// CONTROL 8 - DUPLICATE AXIS IDENTITY REFUSES. One axis identity appearing twice (here
// under opposite goals) must refuse the selection outright, never resolve first-one-wins.
test fn witness_duplicate_axis_identity_refuses() -> Bool {
  standing_is_refused(s: entry_standing(subject: entry_dear_weak, field: clean_field, axes: duplicated_axes, sensitivities: spine_sensitivities))
    && pareto_label(s: entry_standing(subject: entry_dear_weak, field: clean_field, axes: duplicated_axes, sensitivities: spine_sensitivities)) == "selection refused"
}

// CONTROL 9 - DUPLICATE CANDIDATE IDENTITY REFUSES. A field carrying one identity twice
// refuses: the duplicate would otherwise be silently skipped as self-comparison.
test fn witness_duplicate_candidate_identity_refuses() -> Bool {
  standing_is_refused(s: entry_standing(subject: entry_dear_weak, field: duplicated_field, axes: both_axes, sensitivities: spine_sensitivities))
}

// CONTROL 10 - DUPLICATE READING REFUSES THE PAIR. Two readings on one axis identity
// refuse rather than take the first: 10 would dominate on cost, 999 would not, and the
// spine must not pick.
test fn witness_duplicate_reading_refuses_the_pair() -> Bool {
  match compare_pair(a: entry_double_reading, b: entry_dear_weak, axes: both_axes) {
    PairRefused { cause } => true,
    PairDominates { winning_axes } => false,
    PairNoDominance => false,
    PairPendingEvidence { undecided_axes } => false,
    PairEvidenceIncomplete { missing } => false,
  }
}

fn flag(b: Bool) -> NonEmptyStr { if b { "pass" } else { "FAIL" } }

// CONTROL 11 - A DECLARED GAP IS NOT ELIGIBLE TO DOMINATE, AND THE PAIR API SAYS SO. This is the
// defect that closed here, found while migrating a private consumer: compare_pair computed the
// dominance question from readings alone and never read missing_inputs, while entry_standing
// excluded exactly those challengers through challenger_applies. Two answers to one question, and
// the exported one was the permissive arm - a caller reaching the pair API directly got
// PairDominates for a candidate whose own standing is NotComputable.
//
// entry_gap_but_best is the fixture that makes the gate load-bearing rather than merely stated: it
// beats every other entry on BOTH funded axes and declares an outstanding quote, so readings and
// declaration point opposite ways. Turning the gate off makes both halves of this control red.
//
// The arm is its own, not PairNoDominance and not PairRefused: nothing was shown about this
// candidate either way, and declaring your missing inputs is the honest behaviour the spine asks
// for rather than a malformed entry. The cause names the entry and its obligations, so a caller
// learns what would make the question answerable.
//
// The control runs the OTHER direction too: an entry that cannot be evaluated cannot be shown
// DOMINATED either, so both operands are gated rather than just the challenger.
test fn a_declared_gap_is_ineligible_to_dominate() -> Bool {
  let would_win_on_readings = match compare_pair(a: entry_gap_but_best, b: entry_dear_weak, axes: both_axes) {
    PairEvidenceIncomplete { missing } => count(missing) > 0
    PairDominates { winning_axes } => false
    PairNoDominance => false
    PairPendingEvidence { undecided_axes } => false
    PairRefused { cause } => false
  }
  let not_shown_dominated = match compare_pair(a: entry_cheap_strong, b: entry_gap_but_best, axes: both_axes) {
    PairEvidenceIncomplete { missing } => true
    PairDominates { winning_axes } => false
    PairNoDominance => false
    PairPendingEvidence { undecided_axes } => false
    PairRefused { cause } => false
  }
  would_win_on_readings && not_shown_dominated
}

// THE TWO PATHS NOW AGREE, which is the actual repair. Before this cut the pair API and the standing
// path disagreed about the same candidate. entry_gap_but_best would dominate both peers on readings
// alone, so if the field fold ever stopped excluding it, dear_weak would name it as a dominator -
// a candidate whose own standing is NotComputable being cited as the reason another row died.
//
// Its second half is what the eligibility read now DERIVES from the pair arm rather than restating
// beside it: challenger_applies is down to the self-comparison guard, so this control is the only
// thing standing between that deletion and a silent behaviour change.
test fn the_pair_api_and_the_standing_path_agree_about_a_gap() -> Bool {
  let gapped_row_is_not_computable = match entry_standing(subject: entry_gap_but_best, field: gap_best_field, axes: both_axes, sensitivities: spine_sensitivities) {
    NotComputable { missing } => count(missing) > 0
    ProvisionallyNonDominated { sensitivities } => false
    DominatedBy { dominators } => false
    PendingEvidence { undecided } => false
    SelectionRefused { cause } => false
  }
  let never_a_dominator = match entry_standing(subject: entry_dear_weak, field: gap_best_field, axes: both_axes, sensitivities: spine_sensitivities) {
    DominatedBy { dominators } => count(filter(dominators, d => declaration_ref_eq(a: d.candidate, b: id_gap_but_best))) == 0
    ProvisionallyNonDominated { sensitivities } => false
    NotComputable { missing } => false
    PendingEvidence { undecided } => false
    SelectionRefused { cause } => false
  }
  gapped_row_is_not_computable && never_a_dominator
}

// AN HONEST GAP MUST NOT MASK A PROJECTOR DEFECT ON THE OTHER OPERAND, IN EITHER DIRECTION. This is
// the control for review 5091604216, and it is the one the pre-existing duplicate-focused controls
// could not express: entry_reading_hole declares COMPLETE inputs while missing a funded reading -- a
// projector contradiction, not an honest gap -- and entry_gap_but_best declares a gap truthfully.
// Pairing them is the case where the old duplicate-only pre-scan found nothing malformed, took the
// declared-gap arm, and returned an honest PairEvidenceIncomplete while the field path returned
// SelectionRefused on the very same evidence.
//
// Both operand orders are required because the pre-scan reads a and b through one shared reader now;
// a repair that only fixed the subject side would leave the challenger side answering differently,
// which is the same disagreement one argument position over.
//
// THE KILLING MUTATION, named so a later reader can re-run it: restore the duplicate-only pre-scan
// (match ReadingAbsent => acc in the function compare_pair consults) and this control goes red while
// every duplicate-based control stays green -- which is precisely why those controls did not catch it.
test fn an_honest_gap_does_not_mask_a_contradiction_on_the_other_side() -> Bool {
  let hole_as_challenger = match compare_pair(a: entry_reading_hole, b: entry_gap_but_best, axes: both_axes) {
    PairRefused { cause } => count(cause) > 0
    PairEvidenceIncomplete { missing } => false
    PairDominates { winning_axes } => false
    PairNoDominance => false
    PairPendingEvidence { undecided_axes } => false
  }
  let hole_as_subject = match compare_pair(a: entry_gap_but_best, b: entry_reading_hole, axes: both_axes) {
    PairRefused { cause } => count(cause) > 0
    PairEvidenceIncomplete { missing } => false
    PairDominates { winning_axes } => false
    PairNoDominance => false
    PairPendingEvidence { undecided_axes } => false
  }
  hole_as_challenger && hole_as_subject
}

// THE PAIR PATH MUST REFUSE A MALFORMED AXIS ROSTER TOO, and until review 5092638535 it did not.
// witness_duplicate_axis_identity_refuses exercises only entry_standing, so it stayed green with no
// pair-layer guard existing at all -- the control was real but its subject was narrower than the
// claim it appeared to make. With duplicated_axes, compare_pair used to return an ordinary
// PairNoDominance: the first cost row said Better, the same cost identity repeated under the
// opposite goal said Worse, the power row said Better, and nothing recorded a refusal.
//
// KILLING MUTATION: delete the axis_roster_contradiction gate from compare_pair. This control goes
// red while witness_duplicate_axis_identity_refuses stays green -- which is the whole point, and the
// reason the pre-existing control could not have caught it.
test fn a_duplicated_axis_roster_refuses_the_pair_too() -> Bool {
  let refused = match compare_pair(a: entry_cheap_strong, b: entry_dear_weak, axes: duplicated_axes) {
    PairRefused { cause } => count(cause) > 0
    PairNoDominance => false
    PairDominates { winning_axes } => false
    PairEvidenceIncomplete { missing } => false
    PairPendingEvidence { undecided_axes } => false
  }
  let standing_agrees = standing_is_refused(s: entry_standing(subject: entry_cheap_strong, field: clean_field, axes: duplicated_axes, sensitivities: spine_sensitivities))
  refused && standing_agrees
}

// A CAUSE POPULATION MUST BE SIZED BY DISTINCT DEFECTS, NOT BY MALFORMED ROWS. This is the whole
// reason the Bool was replaced: if the returned causes are the authority, their CARDINALITY tells a
// caller how many separate repairs are owed, and a count that follows occurrences misstates that.
// One identity duplicated three times is ONE defect to fix, not three.
//
// The cases below are the discriminator, and the middle one is why counting is not enough on its own:
// a two-copy duplicate and a three-copy duplicate must both yield exactly one cause, so a scan that
// merely halved the count, or emitted n-1, would pass [A,A] and fail [A,A,A].
//   [A, A]        -> exactly one cause, naming A
//   [A, A, A]     -> exactly one cause, naming A
//   [A, A, B, B]  -> exactly two causes, one naming each
//   [A, B]        -> none
// Identity is the authority, so this is a structural scan carrying a seen-identity population, NOT
// string deduplication of rendered messages -- two defects that happened to render alike must still
// count twice, and one defect rendered under two spellings must still count once.
//
// KILLING MUTATION: restore the per-occurrence append (drop the seen-identity guard in
// axis_roster_contradiction). [A,A] then yields two causes and this control reds, while every other
// axis control stays green because they only ask whether a refusal occurred.
fn names_identity(causes: List<NonEmptyStr>, id: DeclarationRef) -> Int {
  count(filter(causes, c => string_contains(s: c as String, pattern: declaration_ref_display_key(ref: id))))
}

test fn a_cause_population_is_sized_by_distinct_defects() -> Bool {
  let two_copies = axis_roster_contradiction(axes: [axis_cost, axis_cost_duplicate])
  let three_copies = axis_roster_contradiction(axes: [axis_cost, axis_cost_duplicate, axis_cost])
  let two_defects = axis_roster_contradiction(axes: [axis_cost, axis_cost_duplicate, axis_power, axis_power_duplicate])
  count(two_copies) == 1 && names_identity(causes: two_copies, id: axis_cost_id) == 1
    && count(three_copies) == 1 && names_identity(causes: three_copies, id: axis_cost_id) == 1
    && count(two_defects) == 2
    && names_identity(causes: two_defects, id: axis_cost_id) == 1
    && names_identity(causes: two_defects, id: axis_power_id) == 1
    && count(axis_roster_contradiction(axes: both_axes)) == 0
}

// A SUBJECT DOES NOT DOMINATE ITSELF, AND THIS CONTROL OWNS THE WHOLE PRECEDENCE IT DESCRIBES.
// The source states an order:
//
//   malformed axis roster > malformed projector > self relation > honest gap > evidence fold
//
// Three cases established the self-relation ANSWER. They did not pin its POSITION, and a control
// that runs the headline behaviour while leaving every boundary un-executed is the same defect this
// PR keeps producing in prose: the comment "a gap cannot make a subject fail to tie with itself" was
// true of the code and asserted by nothing. Reported on review 5095502958, whose rule is the sharper
// form of my own tally -- every CLAUSE in a precedence claim needs a mutation that can cross that
// boundary, because running the headline is not running the order.
//
// Six observations, and each of the last three exists to make one reordering visible:
//   1. wide reading vs itself            -> PairNoDominance   (kills the fall-through: identical
//                                                              wide intervals are UndecidedOnEvidence
//                                                              between INDEPENDENT subjects)
//   2. same identity, differing readings -> PairNoDominance   (kills the fall-through harder: it
//                                                              answered PairDominates -- a candidate
//                                                              dominating itself)
//   3. both rows together in one field   -> SelectionRefused  (keeps 1 and 2 from reading as
//                                                              "duplicates are fine now")
//   4. self under a DUPLICATED AXIS ROSTER -> PairRefused     (moving self above axis admission
//                                                              makes this PairNoDominance; 1-3 stay green)
//   5. PROJECTOR-MALFORMED self            -> PairRefused     (moving self above projector admission
//                                                              makes this PairNoDominance; 1-3 stay green)
//   6. HONESTLY GAPPED self                -> PairNoDominance (moving self BELOW declared_gap_cause
//                                                              makes this PairEvidenceIncomplete;
//                                                              1-3 stay green. This is the sentence
//                                                              the comment asserted and nothing ran.)
//
// Killing mutations, all executed: the intermediate refusal implementation; the fall-through with no
// identity arm; and each of the three reorderings above.
fn pair_is_no_dominance(p: PairStanding) -> Bool {
  match p {
    PairNoDominance => true
    PairDominates { winning_axes } => false
    PairPendingEvidence { undecided_axes } => false
    PairRefused { cause } => false
    PairEvidenceIncomplete { missing } => false
  }
}

fn pair_is_refused(p: PairStanding) -> Bool {
  match p {
    PairRefused { cause } => count(cause) > 0
    PairNoDominance => false
    PairDominates { winning_axes } => false
    PairPendingEvidence { undecided_axes } => false
    PairEvidenceIncomplete { missing } => false
  }
}

test fn a_subject_does_not_dominate_itself() -> Bool {
  let wide_vs_self = pair_is_no_dominance(p: compare_pair(a: entry_wide_twin, b: entry_wide_twin, axes: both_axes))
  let same_id_differing_readings = pair_is_no_dominance(p: compare_pair(a: entry_same_id_other_readings, b: entry_cheap_strong, axes: both_axes))
  let field_still_refuses = standing_is_refused(s: entry_standing(subject: entry_cheap_strong, field: [entry_cheap_strong, entry_same_id_other_readings], axes: both_axes, sensitivities: spine_sensitivities))
  let malformed_axes_outrank_self = pair_is_refused(p: compare_pair(a: entry_cheap_strong, b: entry_cheap_strong, axes: duplicated_axes))
  let malformed_projector_outranks_self = pair_is_refused(p: compare_pair(a: entry_reading_hole, b: entry_reading_hole, axes: both_axes))
  let self_outranks_an_honest_gap = pair_is_no_dominance(p: compare_pair(a: entry_gap_but_best, b: entry_gap_but_best, axes: both_axes))
  wide_vs_self && same_id_differing_readings && field_still_refuses
    && malformed_axes_outrank_self && malformed_projector_outranks_self && self_outranks_an_honest_gap
}

// CONTROL - A GAP DECLARED ABOUT ONE AXIS MAY NOT EXCUSE A HOLE ON ANOTHER. Red today: the
// exemption is entry-wide, so both rows below yield an EMPTY contradiction list and the projector
// defect is unnameable. Green requires the exemption to be scoped to the axis the gap names.
//
// BOTH KILLING MUTATIONS WERE EXECUTED, in opposite directions, because a one-sided control here
// would pass under an over-scoping that named everything:
//   restore declares_its_gaps to a whole-entry Bool  -> defect row unnamed, first half red
//   never exempt (drop the gap_on_axis test)         -> honest row named, second half red
// The second mutation did NOT go red on the first version of the honest fixture, which carried both
// readings and so never reached the absent-reading branch at all - the conjunct read as a guard and
// discriminated nothing. The fixture now omits exactly the reading its gap is about.
test fn a_gap_on_one_axis_does_not_excuse_a_hole_on_another() -> Bool {
  let defect_is_named = count(entry_contradicts_its_declaration(e: entry_gap_hides_a_hole, axes: both_axes)) > 0
  let honest_row_is_not_named = count(entry_contradicts_its_declaration(e: entry_gap_declared_and_complete, axes: both_axes)) == 0
  defect_is_named && honest_row_is_not_named
}

// CONTROL - A GAP MUST NAME A FUNDED AXIS. This is the THIRD semantic clause the scoped-gap repair
// introduces, and the two mutations above cross neither of it: deleting the unfunded_gaps fold left
// both of them green, so the arm had no falsifier and the rung it claims was not established by
// executed evidence (DESIGN.md 4b(1)).
//
// The clause is a fail-closed arm, not a preservation. A gap whose axis ref is a typo names no
// funded axis, so it excuses nothing and blocks nothing: under the entry-wide reading the row was
// merely INCOMPLETE and stayed comparable-with-refusal. It now REFUSES. That verdict change is the
// point of the arm and is stated on the PR rather than claimed away as "every verdict preserved".
//
// KILLING MUTATION EXECUTED: drop the unfunded_gaps fold -> the typo row is named by nobody and the
// first half goes red. The second half pairs it against a row whose gap names a FUNDED axis on an
// otherwise-complete entry, so an over-scoping that refused every gap-bearing row cannot pass either.
test fn a_gap_must_name_an_axis_this_selection_funds() -> Bool {
  let typo_gap_refuses = count(entry_contradicts_its_declaration(e: entry_gap_names_an_unfunded_axis, axes: both_axes)) > 0
  let funded_gap_is_not_named = count(entry_contradicts_its_declaration(e: entry_quote_pending, axes: both_axes)) == 0
  typo_gap_refuses && funded_gap_is_not_named
}

fn pareto_witness_report() -> NonEmptyStr {
  join([
    "dominated_names_dominator=", flag(b: witness_dominated_entry_names_its_dominator()),
    " tradeoff_both_survive=", flag(b: witness_tradeoff_pair_both_survive()),
    " missing_neither_dominates_nor_dies=", flag(b: witness_missing_inputs_neither_dominate_nor_die()),
    " absent_reading_refuses=", flag(b: witness_absent_reading_refuses_the_pair()),
    " orientation_consulted=", flag(b: witness_axis_orientation_is_consulted()),
    " shared_label_still_compares=", flag(b: witness_shared_label_still_compares()),
    " field_order_irrelevant=", flag(b: witness_field_order_is_irrelevant()),
    " duplicate_axis_refuses=", flag(b: witness_duplicate_axis_identity_refuses()),
    " duplicate_candidate_refuses=", flag(b: witness_duplicate_candidate_identity_refuses()),
    " duplicate_reading_refuses=", flag(b: witness_duplicate_reading_refuses_the_pair()),
    " gap_ineligible_to_dominate=", flag(b: a_declared_gap_is_ineligible_to_dominate()),
    " pair_and_standing_agree=", flag(b: the_pair_api_and_the_standing_path_agree_about_a_gap()),
    " duplicate_outranks_gap=", flag(b: a_duplicate_reading_outranks_a_declared_gap_in_the_pair_api()),
    " gap_does_not_mask_contradiction=", flag(b: an_honest_gap_does_not_mask_a_contradiction_on_the_other_side()),
    " dup_axes_refuse_the_pair=", flag(b: a_duplicated_axis_roster_refuses_the_pair_too()),
    " causes_sized_by_defects=", flag(b: a_cause_population_is_sized_by_distinct_defects()),
    " no_self_dominance=", flag(b: a_subject_does_not_dominate_itself()),
    " gap_scoped_to_its_axis=", flag(b: a_gap_on_one_axis_does_not_excuse_a_hole_on_another()),
    " gap_names_a_funded_axis=", flag(b: a_gap_must_name_an_axis_this_selection_funds()),
  ], "")
}

fn pareto_witness_main() -> ProcessExit {
  let report = pareto_witness_report()
  let all_pass = witness_dominated_entry_names_its_dominator()
    && witness_tradeoff_pair_both_survive()
    && witness_missing_inputs_neither_dominate_nor_die()
    && witness_absent_reading_refuses_the_pair()
    && witness_axis_orientation_is_consulted()
    && witness_shared_label_still_compares()
    && witness_field_order_is_irrelevant()
    && a_declared_gap_is_ineligible_to_dominate()
    && the_pair_api_and_the_standing_path_agree_about_a_gap()
    && a_duplicate_reading_outranks_a_declared_gap_in_the_pair_api()
    && an_honest_gap_does_not_mask_a_contradiction_on_the_other_side()
    && a_duplicated_axis_roster_refuses_the_pair_too()
    && a_cause_population_is_sized_by_distinct_defects()
    && a_subject_does_not_dominate_itself()
    && witness_duplicate_axis_identity_refuses()
    && witness_duplicate_candidate_identity_refuses()
    && witness_duplicate_reading_refuses_the_pair()
  if all_pass { ExitSuccess } else { ExitFailure { code: 1, reason: report } }
}


// ---------------------------------------------------------------------------
// INTERVAL EVIDENCE. The controls below are the discriminating reds for the state this
// vocabulary could not previously express, and they stay enrolled now that it can
// (DESIGN 4b(4)): each one returned a CONFIDENT answer before the cut.

fn le_int(a: Int, b: Int) -> Bool { a <= b }

// SELF-COMPARISON FIXTURES. entry_wide_twin carries a genuinely WIDE reading, which is what makes
// case 1 discriminating: identical wide intervals are UndecidedOnEvidence between two independent
// subjects, so a fall-through implementation answers PairPendingEvidence here and only a
// constructed self-comparison answer reaches PairNoDominance. entry_same_id_other_readings shares
// one identity with entry_cheap_strong while carrying strictly better exact readings, so a
// fall-through implementation reports a candidate DOMINATING ITSELF.
data entry_wide_twin: ParetoEntry = ParetoEntry {
  identity: id_wide_twin,
  display_label: "wide twin",
  readings: [
    AxisReading { axis: axis_cost_id, interval_micro: span(low: 10, high: 20) },
    AxisReading { axis: axis_power_id, interval_micro: span(low: 30, high: 40) },
  ],
  missing_inputs: no_missing,
}

data entry_same_id_other_readings: ParetoEntry = ParetoEntry {
  identity: id_cheap_strong,
  display_label: "same identity, better readings",
  readings: [
    AxisReading { axis: axis_cost_id, interval_micro: degenerate_interval(point: 50) },
    AxisReading { axis: axis_power_id, interval_micro: degenerate_interval(point: 900) },
  ],
  missing_inputs: no_missing,
}

data id_wide_twin: DeclarationRef = DeclarationRef { module_path: "test.claim.pareto_selection_witness", decl_name: "entry_wide_twin", field: WholeDeclaration }



// A widening fixture. A refused construction would be a fixture defect, and it is surfaced as an
// obviously-wrong degenerate rather than silently swapped into order -- the refusal arm belongs to
// std.interval's own witness, not this one.
fn span(low: Int, high: Int) -> OrderedClosedInterval<Int> {
  match closed_interval(low: low, high: high, le: le_int) {
    IntervalReady { interval } => interval
    IntervalRefused { reason } => degenerate_interval(point: 0)
  }
}

fn cmp_lower_better(a: OrderedClosedInterval<Int>, b: OrderedClosedInterval<Int>) -> AxisComparison {
  axis_comparison_interval(goal: LowerIsBetter, a: a, b: b)
}

fn is_undecided(c: AxisComparison) -> Bool {
  match c { UndecidedOnEvidence => true  Better => false  Same => false  Worse => false }
}

fn is_same(c: AxisComparison) -> Bool {
  match c { Same => true  Better => false  Worse => false  UndecidedOnEvidence => false }
}

fn is_better(c: AxisComparison) -> Bool {
  match c { Better => true  Same => false  Worse => false  UndecidedOnEvidence => false }
}

// SEPARATION DECIDES; TOUCHING DOES NOT. [10,20] vs [30,40] is decided because every value one
// could take beats every value the other could. [10,20] vs [20,30] is NOT: both true values could
// be exactly 20.
test fn separated_intervals_decide_and_touching_ones_do_not() -> Bool {
  is_better(c: cmp_lower_better(a: span(low: 10, high: 20), b: span(low: 30, high: 40)))
    && is_undecided(c: cmp_lower_better(a: span(low: 10, high: 20), b: span(low: 20, high: 30)))
    && is_undecided(c: cmp_lower_better(a: span(low: 10, high: 30), b: span(low: 20, high: 40)))
}

// THE CASE MOST EASILY GOT WRONG, and the reason `Same` is reserved for degenerates. Two readings
// of [10,20] say both true values lie in one region; they do NOT say the true values are equal.
// Answering Same here would manufacture an equality the measurement never established -- and it is
// exactly what a point-valued reading did to every coarse measurement before this cut.
test fn identical_wide_intervals_are_undecided_not_same() -> Bool {
  is_undecided(c: cmp_lower_better(a: span(low: 10, high: 20), b: span(low: 10, high: 20)))
    && is_same(c: cmp_lower_better(a: degenerate_interval(point: 15), b: degenerate_interval(point: 15)))
}

data entry_wide_a: ParetoEntry = ParetoEntry {
  identity: DeclarationRef { module_path: "test.claim.pareto_selection_witness", decl_name: "entry_wide_a", field: WholeDeclaration },
  display_label: "wide a",
  readings: [
    AxisReading { axis: axis_cost_id, interval_micro: span(low: 100, high: 200) },
    AxisReading { axis: axis_power_id, interval_micro: degenerate_interval(point: 500) },
  ],
  missing_inputs: no_missing,
}

data entry_wide_b: ParetoEntry = ParetoEntry {
  identity: DeclarationRef { module_path: "test.claim.pareto_selection_witness", decl_name: "entry_wide_b", field: WholeDeclaration },
  display_label: "wide b",
  readings: [
    AxisReading { axis: axis_cost_id, interval_micro: span(low: 150, high: 250) },
    AxisReading { axis: axis_power_id, interval_micro: degenerate_interval(point: 400) },
  ],
  missing_inputs: no_missing,
}

// entry_wide_c is known WORSE on power than wide_a while its cost overlaps: the directional
// question is already settled against it, whatever the cost turns out to be.
data entry_wide_c: ParetoEntry = ParetoEntry {
  identity: DeclarationRef { module_path: "test.claim.pareto_selection_witness", decl_name: "entry_wide_c", field: WholeDeclaration },
  display_label: "wide c",
  readings: [
    AxisReading { axis: axis_cost_id, interval_micro: span(low: 150, high: 250) },
    AxisReading { axis: axis_power_id, interval_micro: degenerate_interval(point: 100) },
  ],
  missing_inputs: no_missing,
}

// NO KNOWN WORSE AXIS + AN UNDECIDED ONE IS PENDING, because sharpening the undecided axis really
// can decide it either way. Before the cut this compared as a confident dominance on the point
// estimates alone.
test fn overlap_with_no_worse_axis_is_pending_not_dominance() -> Bool {
  match compare_pair(a: entry_wide_a, b: entry_wide_b, axes: both_axes) {
    PairPendingEvidence { undecided_axes } => count(undecided_axes) == 1
    PairDominates { winning_axes } => false
    PairNoDominance => false
    PairRefused { cause } => false
    PairEvidenceIncomplete { missing } => false
  }
}

// A KNOWN WORSE AXIS ENDS THE DIRECTIONAL QUESTION, and this is the asymmetry that keeps pending
// from over-reporting. wide_c is worse on power; no sharpening of its overlapping cost can make it
// dominate, because dominance requires NO worse axis at all. So this is ordinary no-dominance, and
// reporting it as pending would send someone to measure a question whose answer cannot matter.
test fn a_known_worse_axis_is_no_dominance_not_pending() -> Bool {
  match compare_pair(a: entry_wide_c, b: entry_wide_a, axes: both_axes) {
    PairNoDominance => true
    PairPendingEvidence { undecided_axes } => false
    PairDominates { winning_axes } => false
    PairRefused { cause } => false
    PairEvidenceIncomplete { missing } => false
  }
}

// entry_wide_d overlaps wide_a on cost and TIES it on power, so neither is known worse anywhere:
// this is the field-grain shape that is genuinely pending. wide_b will not do, because it is known
// WORSE on power, which the directional law correctly resolves to plain no-dominance.
data entry_wide_d: ParetoEntry = ParetoEntry {
  identity: DeclarationRef { module_path: "test.claim.pareto_selection_witness", decl_name: "entry_wide_d", field: WholeDeclaration },
  display_label: "wide d",
  readings: [
    AxisReading { axis: axis_cost_id, interval_micro: span(low: 150, high: 250) },
    AxisReading { axis: axis_power_id, interval_micro: degenerate_interval(point: 500) },
  ],
  missing_inputs: no_missing,
}

// PENDING REACHES THE STANDING RATHER THAN THE FRONTIER, which is why the state is carried this far
// instead of being resolved inside the pair fold. Before the cut, a challenger that could not be
// separated read as ordinary non-dominance and the subject came back ProvisionallyNonDominated --
// on the frontier, asserted from evidence that had not established it.
test fn pending_evidence_reaches_the_standing_rather_than_the_frontier() -> Bool {
  match entry_standing(subject: entry_wide_a, field: [entry_wide_a, entry_wide_d], axes: both_axes, sensitivities: spine_sensitivities) {
    PendingEvidence { undecided } => true
    NotComputable { missing } => false
    ProvisionallyNonDominated { sensitivities } => false
    DominatedBy { dominators } => false
    SelectionRefused { cause } => false
  }
}

// AND A PROVEN DOMINATOR STILL SETTLES IT. entry_wide_c is dominated outright by wide_a on power
// with cost overlapping, so its standing is DominatedBy -- not pending. Being dominated is
// established by that one comparison, and uncertainty elsewhere cannot un-establish it. Without
// this control the precedence could invert and every dominated candidate would read as pending.
test fn a_proven_domination_outranks_pending_evidence_at_field_grain() -> Bool {
  match entry_standing(subject: entry_wide_c, field: [entry_wide_a, entry_wide_c], axes: [axis_power], sensitivities: spine_sensitivities) {
    DominatedBy { dominators } => count(dominators) == 1
    NotComputable { missing } => false
    PendingEvidence { undecided } => false
    ProvisionallyNonDominated { sensitivities } => false
    SelectionRefused { cause } => false
  }
}


// THE THREE NON-STANDINGS ARE OBSERVABLY DIFFERENT, and this is the control that keeps them so. All
// three refuse to name a winner, which is why one arm could carry all of them unnoticed; they are
// separated because their remedies are not the same. Supply the input; fix the projector; measure
// more sharply. If any two of these ever collapse, this goes red.
test fn the_three_non_standings_are_distinct() -> Bool {
  let honest_gap = entry_standing(subject: entry_quote_pending, field: clean_field, axes: both_axes, sensitivities: spine_sensitivities)
  let contradiction = entry_standing(subject: entry_reading_hole, field: holed_field, axes: both_axes, sensitivities: spine_sensitivities)
  let too_coarse = entry_standing(subject: entry_wide_a, field: [entry_wide_a, entry_wide_d], axes: both_axes, sensitivities: spine_sensitivities)
  standing_is_incomparable(s: honest_gap) && !standing_is_refused(s: honest_gap)
    && standing_is_refused(s: contradiction) && !standing_is_incomparable(s: contradiction)
    && match too_coarse {
         PendingEvidence { undecided } => true
         NotComputable { missing } => false
         SelectionRefused { cause } => false
         ProvisionallyNonDominated { sensitivities } => false
         DominatedBy { dominators } => false
       }
    && pareto_label(s: honest_gap) == "not computable"
    && pareto_label(s: too_coarse) == "pending evidence"
    && pareto_label(s: contradiction) == "selection refused"
}


// ONE CONTRADICTION IS REPORTED ONCE. Callers normally include the subject in the field, so an
// unconditional append scanned it twice and named its defect twice in a single cause. The two
// spellings of the same question must produce the same cause; before the repair the in-field form
// carried the sentence twice while the out-of-field form carried it once.
test fn a_contradiction_is_named_once_not_once_per_spelling() -> Bool {
  let subject_in_field = entry_standing(subject: entry_reading_hole, field: holed_field, axes: both_axes, sensitivities: spine_sensitivities)
  let subject_outside_field = entry_standing(subject: entry_reading_hole, field: [entry_cheap_strong], axes: both_axes, sensitivities: spine_sensitivities)
  match subject_in_field {
    SelectionRefused { cause: c_in } => match subject_outside_field {
      SelectionRefused { cause: c_out } => c_in == c_out
      NotComputable { missing } => false
      PendingEvidence { undecided } => false
      ProvisionallyNonDominated { sensitivities } => false
      DominatedBy { dominators } => false
    }
    NotComputable { missing } => false
    PendingEvidence { undecided } => false
    ProvisionallyNonDominated { sensitivities } => false
    DominatedBy { dominators } => false
  }
}


// entry_gap_and_duplicate declares a missing input AND carries two readings on one axis. The
// declaration explains the gap; it explains nothing about the duplicate.
data entry_gap_and_duplicate: ParetoEntry = ParetoEntry {
  identity: DeclarationRef { module_path: "test.claim.pareto_selection_witness", decl_name: "entry_gap_and_duplicate", field: WholeDeclaration },
  display_label: "declares a gap and hides a duplicate",
  readings: [
    AxisReading { axis: axis_cost_id, interval_micro: degenerate_interval(point: 10) },
    AxisReading { axis: axis_cost_id, interval_micro: degenerate_interval(point: 999) },
  ],
  missing_inputs: [AxisGap { axis: axis_power_id, cause: "the power quote has not come back" }],
}

// A DECLARED GAP DOES NOT EXCUSE MALFORMED EVIDENCE, and the exemption used to be per ENTRY rather
// than per DEFECT CLASS, so it did. An entry declaring any missing input skipped the whole
// structural scan, and a duplicate reading rode in behind the unrelated declared gap to surface as
// NotComputable -- a projector defect wearing the report of an honest one, which is the conflation
// the three-way split exists to end. The spine would still have had to pick between 10 and 999.
//
// The control is directional: the SAME entry with its duplicate removed must land NotComputable, or
// this would pass by refusing everything that declares a gap.
test fn a_declared_gap_does_not_excuse_a_duplicate_reading() -> Bool {
  let with_duplicate = entry_standing(subject: entry_gap_and_duplicate, field: [entry_gap_and_duplicate, entry_cheap_strong], axes: both_axes, sensitivities: spine_sensitivities)
  let honest_gap = entry_standing(subject: entry_quote_pending, field: clean_field, axes: both_axes, sensitivities: spine_sensitivities)
  standing_is_refused(s: with_duplicate)
    && !standing_is_incomparable(s: with_duplicate)
    && standing_is_incomparable(s: honest_gap)
    && !standing_is_refused(s: honest_gap)
}

// CONTROL 12 - MALFORMED BEATS INCOMPLETE AT THE PAIR LAYER TOO, IN BOTH OPERAND POSITIONS.
// The precedence above is not new; what was new is that this cut broke it one layer down. The gap
// gate added to compare_pair returned before any reading was examined, so entry_gap_and_duplicate
// stopped reporting PairRefused and started reporting an honest incompleteness - the same defect the
// control above forbids at the standing layer, reintroduced at the pair layer where no control
// watched. Reported on review of this change (review 58743).
//
// It reuses the fixture directly above rather than minting a second one: the two controls are the
// same claim asked at the two layers, so they must be asked of the same entry or they can drift.
test fn a_duplicate_reading_outranks_a_declared_gap_in_the_pair_api() -> Bool {
  let as_challenger = match compare_pair(a: entry_gap_and_duplicate, b: entry_dear_weak, axes: both_axes) {
    PairRefused { cause } => count(cause) > 0
    PairEvidenceIncomplete { missing } => false
    PairDominates { winning_axes } => false
    PairNoDominance => false
    PairPendingEvidence { undecided_axes } => false
  }
  let as_subject = match compare_pair(a: entry_cheap_strong, b: entry_gap_and_duplicate, axes: both_axes) {
    PairRefused { cause } => true
    PairEvidenceIncomplete { missing } => false
    PairDominates { winning_axes } => false
    PairNoDominance => false
    PairPendingEvidence { undecided_axes } => false
  }
  as_challenger && as_subject
}
