module test.claim.cassette_residential_joinery_witness
import std.types {Bool}
import std.affine_space {signed_frame_component_count}
import product.printed_chassis.cassette {printed_parts,tray_w}
import product.printed_chassis.rear_cooling {select_rear_fans,rear_fan_candidates,RearOpening,RearFanGeometry,RearCoolingInvalidInput,RearCoolingNoFit}
import product.printed_chassis.rear_fan_assembly {rear_assembly,RearAssemblyGeometry,RearAssemblyUnsupportedBank,RearAssemblyMountRefused}
import product.printed_chassis.stack_joinery {stack_joinery,StackJoineryGeometry,StackJoineryHeightUnsupported,stack_service,TopUnitMayLift,UpperUnitsNeedIndependentSupport,InvalidStackService,post_wall_area_mm2,shoe_bearing_area_um2}
import product.printed_chassis.assembly_review_checks {within_bed,primitive_positive,review_model_checks}
import product.printed_chassis.assembly_geometry {Printed,Purchased,Metal,Clearance}
test fn rear_bank_has_bed_sized_connected_interfaces_and_only_two_bolts() -> Bool {
 match select_rear_fans(candidates:rear_fan_candidates,opening:RearOpening {width_um:tray_w-40000,height_um:190000,depth_um:60000},bed_um:170000) {
 RearCoolingInvalidInput=>false RearCoolingNoFit=>false
 RearFanGeometry {bank:b}=>match rear_assembly(bank:b) {
 RearAssemblyUnsupportedBank=>false RearAssemblyMountRefused=>false
 RearAssemblyGeometry {parts:p,interfaces:i}=>{
 let tray=filter(printed_parts(),p=>p.id=="P1"||p.id=="P2"||p.id=="P3"||p.id=="P4")
 count(p)==13 && review_model_checks(parts:concat(tray,p),interfaces:i) && any(i,j=>j.id=="fan-and-guard-140"&&j.quantity==2)
 }
 }
 }
}
test fn posts_fit_bed_and_invalid_height_cannot_produce_solids() -> Bool {
 let valid=match stack_joinery(pitch_um:230000) {StackJoineryHeightUnsupported=>false StackJoineryGeometry {parts:p}=>count(p)==12 && all(p,q=>within_bed(p:q) && all(concat(q.adds,q.cuts),a=>primitive_positive(p:a)))}
 let low=match stack_joinery(pitch_um:189999) {StackJoineryHeightUnsupported=>true StackJoineryGeometry {parts:_}=>false}
 let high=match stack_joinery(pitch_um:280001) {StackJoineryHeightUnsupported=>true StackJoineryGeometry {parts:_}=>false}
 valid && low && high && post_wall_area_mm2()==256 && shoe_bearing_area_um2()==127750000
}
test fn middle_pop_needs_support_and_top_pop_does_not_borrow_it() -> Bool {
 let middle=match stack_service(node_count:4,index_from_bottom:1) {UpperUnitsNeedIndependentSupport {count:n}=>n==2 TopUnitMayLift=>false InvalidStackService=>false}
 let top=match stack_service(node_count:4,index_from_bottom:3) {TopUnitMayLift=>true UpperUnitsNeedIndependentSupport {count:_}=>false InvalidStackService=>false}
 let invalid=match stack_service(node_count:4,index_from_bottom:4) {InvalidStackService=>true TopUnitMayLift=>false UpperUnitsNeedIndependentSupport {count:_}=>false}
 middle && top && invalid
}
