module test.claim.extdeps_scope_placement_gate_loudness_witness


data loudness_witness_note: String = "Floor loudness for tools.extdeps_scope_placement_gate (gunbc#7644): lands the seed-runner loudness path + extdeps_scope_placement_gate production companion only; six other production _passes gates remain mute (counted frontier in tools.floor_effect_gate_witness floor_gate_failure_receipt_note). Per-arm fixtures exercise gate REASON GENERATION with synthetic observations (supporting evidence). Executed RED: red_seed_runner_failure_detail_projects_located_receipt calls production seed_runner_bool_false_failure_detail against scope_placement_gate_loudness_seed_probe_passes on tools.floor_effect_gate_witness. Mutation control executed 2026-08-05 at b0a17f608a: disposable detached worktree, removed _passes handling from production failure_receipt_companion (holds-only), rebuilt claim_batch, re-ran witness — FAIL red_seed_runner_failure_detail_projects_located_receipt (eval_self 0ms, resolved; not resolution); detail collapsed to bare returned Bool(false) without THIS CHANGE or dag/extdeps/browser/opera.dag. Current head PASS; head detail includes returned Bool(false) | extdeps scope placement gate: THIS CHANGE ... dag/extdeps/browser/opera.dag. Guarantee rung: observed validation on the production seed_runner path; no construction wall claimed for seed/.dag mirror parity (DESIGN section 7 seed retention)."

fn read_manifest_rows() -> List<String> {
  parse_frontier_manifest(
    content: filesystem_read(path: legacy_extdeps_scope_frontier_manifest_path).content
  )
}

fn exit_reason_of(e: std.process.ProcessExit) -> String {
  scope_placement_failure_reason(exit: e)
}

fn exit_is_failure(e: std.process.ProcessExit) -> Bool {
  match e { ExitSuccess => false  _ => true }
}

fn reason_names_all(exit: std.process.ProcessExit, markers: List<String>) -> Bool {
  let reason = exit_reason_of(e: exit)
  reason != "" && all(markers, m => string_contains(s: reason, pattern: m))
}

test fn red_floor_entry_companion_names_declared_failure_receipt_fn() -> Bool {
  extdeps_scope_placement_gate_failure_receipt_companion_name() == "extdeps_scope_placement_gate_failure_receipt"
}

test fn red_seed_runner_failure_detail_projects_located_receipt() -> Bool {
  let detail = seed_runner_bool_false_failure_detail(
    witness: scope_placement_gate_loudness_seed_probe_passes_name
  )
  detail != "returned Bool(false)"
    && string_contains(s: detail, pattern: "returned Bool(false) | ")
    && string_contains(s: detail, pattern: "THIS CHANGE")
    && string_contains(s: detail, pattern: "dag/extdeps/browser/opera.dag")
}

test fn red_membership_fixture_names_change_and_path() -> Bool {
  reason_names_all(
    exit: scope_placement_membership_verdict(
      observation: gunbc.extdeps_scope_frontier.AddedPathsObserved { paths: ["dag/extdeps/browser/opera.dag"] }
    ),
    markers: ["THIS CHANGE", "dag/extdeps/browser/opera.dag"]
  )
}

test fn red_freeze_fixture_names_manifest_smuggling() -> Bool {
  let probe = read_manifest_rows().first()
  reason_names_all(
    exit: scope_placement_freeze_verdict(
      observation: gunbc.extdeps_scope_frontier.AddedPathsObserved { paths: [probe] }
    ),
    markers: ["frozen-manifest", "legacy_manifest_freeze_sha"]
  )
}

fn synthetic_manifest_add_diff() -> String {
  let manifest = legacy_extdeps_scope_frontier_manifest_path
  join([
    concat("diff --git a/", manifest, " b/", manifest),
    "index 1111111..2222222 100644",
    concat("--- a/", manifest),
    concat("+++ b/", manifest),
    "@@ -0,0 +1 @@",
    "+dag/extdeps/vendor/reverted_module.dag",
    "diff --git a/dag/gunbc/other.dag b/dag/gunbc/other.dag",
    "--- a/dag/gunbc/other.dag",
    "+++ b/dag/gunbc/other.dag",
    "@@ -1 +1 @@",
    "+data unrelated: String"
  ], "\n")
}

test fn red_manifest_lines_added_fixture_names_row() -> Bool {
  let observation = manifest_line_observation(diff_text: synthetic_manifest_add_diff())
  match observation {
    ManifestLinesAdded { rows: rows } =>
      (rows |> count) == 1
        && contains(
             xs: rows,
             item: "dag/extdeps/vendor/reverted_module.dag",
             eq: fn(a, b) { a == b }
           )
        && reason_names_all(
             exit: manifest_remove_only_exit(observation: observation),
             markers: ["ADDS row(s)", "dag/extdeps/vendor/reverted_module.dag"]
           )
    _ => false
  }
}

test fn red_manifest_diff_unreadable_fixture_refuses() -> Bool {
  let manifest = legacy_extdeps_scope_frontier_manifest_path
  let truncated = join([
    concat("diff --git a/", manifest, " b/", manifest),
    "index 1111111..2222222 100644",
    concat("--- a/", manifest)
  ], "\n")
  let observation = manifest_line_observation(diff_text: truncated)
  match observation {
    ManifestDiffUnreadable =>
      reason_names_all(
        exit: manifest_remove_only_exit(observation: observation),
        markers: ["remove-only", "unreadable"]
      )
    _ => false
  }
}

test fn red_failure_reason_never_empty_on_refusal() -> Bool {
  exit_is_failure(
    e: scope_placement_membership_verdict(
      observation: gunbc.extdeps_scope_frontier.AddedPathsObserved { paths: ["dag/extdeps/browser/opera.dag"] }
    )
  )
    && exit_reason_of(
         e: scope_placement_membership_verdict(
           observation: gunbc.extdeps_scope_frontier.AddedPathsObserved { paths: ["dag/extdeps/browser/opera.dag"] }
         )
       ) != ""
}
