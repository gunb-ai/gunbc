module test.claim.systemd_unit_run_identity_witness

import std.types { Bool, String, NonEmptyStr }
import extdeps.systemd.invocation_id { systemd_invocation_id_of }
import extdeps.linux.kernel_random { kernel_boot_id_of }
import gunbc.systemd_unit_run_identity {
  SystemManager, UserManager, UnitRunRead, UnitRunUnreadable, UnitRunIsRecordedRun, UnitRunIsDifferentRun,
  UnitRunStandingUnobservable, unit_run_reading, unit_run_standing, unit_run_same,
}

data boot_a: String = "73c8153e-0e0e-4480-a36c-bc7560c50e8b\n"
data boot_b: String = "11111111-0e0e-4480-a36c-bc7560c50e8b\n"
data stat_a: String = "cpu 1 2 3\nbtime 1792000000\nprocesses 5\n"
data inv_a: String = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
data inv_b: String = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

fn recorded_run() -> UnitRunReading {
  unit_run_reading(manager: SystemManager, boot_id_text: boot_a, proc_stat_text: stat_a, invocation_text: inv_a)
}

fn standing_against(boot: String, inv: String, uid_user: Bool) -> String {
  match recorded_run() {
    UnitRunUnreadable { cause: _ } => "recorded unreadable"
    UnitRunRead { run: r } => match unit_run_standing(
      recorded: r,
      observed: unit_run_reading(manager: if uid_user { UserManager { uid: 1000 } } else { SystemManager }, boot_id_text: boot, proc_stat_text: stat_a, invocation_text: inv),
    ) {
      UnitRunIsRecordedRun => "same"
      UnitRunIsDifferentRun { differs: d } => d as String
      UnitRunStandingUnobservable { cause: _ } => "unobservable"
    }
  }
}

// RED: a mismatched boot id, invocation or manager is never "same run"; LAWFUL CONTROL: the identical triple is.
test fn a_reading_with_a_mismatched_component_is_refused_as_the_same_run() -> Bool {
  standing_against(boot: boot_a, inv: inv_a, uid_user: false) == "same"
    && standing_against(boot: boot_b, inv: inv_a, uid_user: false) == "boot_id"
    && standing_against(boot: boot_a, inv: inv_b, uid_user: false) == "invocation_id"
    && standing_against(boot: boot_a, inv: inv_a, uid_user: true) == "manager"
}

test fn a_malformed_or_absent_reading_is_unobservable_never_a_default() -> Bool {
  standing_against(boot: boot_a, inv: "", uid_user: false) == "unobservable"
    && standing_against(boot: boot_a, inv: "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", uid_user: false) == "unobservable"
    && standing_against(boot: boot_a, inv: "aaaa", uid_user: false) == "unobservable"
    && standing_against(boot: "", inv: inv_a, uid_user: false) == "unobservable"
    && stat_unreadable()
    && standing_against(boot: "not-a-uuid\n", inv: inv_a, uid_user: false) == "unobservable"
}

fn stat_unreadable() -> Bool {
  match unit_run_reading(manager: SystemManager, boot_id_text: boot_a, proc_stat_text: "cpu 1\n", invocation_text: inv_a) {
    UnitRunUnreadable { cause: _ } => true
    UnitRunRead { run: _ } => false
  }
}

test fn the_boot_start_instant_is_observed_from_proc_stat() -> Bool {
  match recorded_run() {
    UnitRunRead { run: r } => r.boot_started_at == 1792000000
    UnitRunUnreadable { cause: _ } => false
  }
}
