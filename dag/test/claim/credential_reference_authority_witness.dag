module test.claim.credential_reference_authority_witness

// FOREIGN-MODULE AUTHORITY WITNESS (side-chat REQUEST_CHANGES, sealed stores PR 2, 2026-11-20).
// The finding: cursor_attempt_runtime_root(credentials, reference) and the observe/remove routes joined a
// CALLER-CHOSEN reference into a path with no segment admission, so a module outside gunbc could obtain a
// sealed CursorAttemptRuntimeRoot for "../x" and reach the recursive remove. The fix admits the reference as
// a path segment at every boundary: the only carrier is CredentialAttemptReference, a brand of std.types
// PathSegment minted by credential_attempt_reference through path_segment_is_safe (the one law), refused
// rather than sanitized. These claims run FROM THIS FOREIGN MODULE and pin both halves: what the law refuses
// (no carrier exists), and what therefore no longer TYPE-CHECKS anywhere (the hostile call shapes, counted
// against safe twins that still compile clean).

import std.types { String, Bool, NonEmptyStr, PathSegment, path_segment_is_safe }
import std.optional { Present, Absent }
import gunbc.compile_diagnostic_census { compile_dag_diagnostic_census }
import gunbc.dispatch_credential_acquisition {
  CredentialAttemptReference, CredentialAcquisitionStore, credential_attempt_reference,
  credential_slot_observe, CasObservedUnreadable, CasObservedReadable,
  CursorAttemptRuntimeRoot, cursor_attempt_runtime_root, cursor_attempt_runtime_root_path,
}

// Equality against the REAL authority: a carrier exists exactly when path_segment_is_safe holds, and it
// round-trips. Not containment of a chosen list -- the two spellings must agree for every input.
fn mints_agree_with_the_law(raw: String) -> Bool {
  match credential_attempt_reference(raw: raw) {
    Absent => !path_segment_is_safe(raw: raw)
    Present { value: carrier } => (carrier as String) == raw && path_segment_is_safe(raw: raw)
  }
}

test fn hostile_spellings_never_mint_a_carrier() -> Bool {
  // percent-encoded separators are NOT filesystem separators: "..%2fx" is a legal literal file name, so the law
  // -- and this claim -- treat it as benign, never as traversal.
  let hostile = ["../x", "..", ".", "a/b", "/etc", "", "a//b", "x/", "../.."]
  all(hostile, h => mints_agree_with_the_law(raw: h))
    && all(hostile, h => match credential_attempt_reference(raw: h) { Absent => true, Present { value: _ } => false })
}

test fn benign_spellings_mint_and_round_trip() -> Bool {
  let benign = ["att-1-cursor", "attempt-42_codex", "a", "2026.11.20", "..%2fx"]
  all(benign, b => mints_agree_with_the_law(raw: b))
    && all(benign, b => match credential_attempt_reference(raw: b) {
         Absent => false
         Present { value: carrier } => (carrier as String) == b
       })
}

// The one join, pinned by equality against the layout formula, for a carried reference: the sealed root is
// exactly <instance_root>/cursor-attempt-runtime/<reference>. No other shape is reachable.
test fn the_carrier_joins_at_exactly_one_place() -> Bool {
  match credential_attempt_reference(raw: "att-7-codex") {
    Absent => false
    Present { value: carrier } =>
      cursor_attempt_runtime_root_path(instance_root: "/tmp/sealed-instance", reference: carrier)
        == "/tmp/sealed-instance/cursor-attempt-runtime/att-7-codex"
  }
}

// ── THE REDS: the hostile call shapes no longer type-check, and safe twins do. ─────────────────────────
// One effect per probe module so a count is meaningful. CensusNotRunnable scores -1 so an unavailable
// census fails the claim rather than passing it (precedent: alias_identity_every_check_witness).

data hostile_observe_source: String = "module probe_cra_hostile_observe\nimport std.types { NonEmptyStr }\nimport std.durable_compare_and_set { CasSlotObservation }\nimport gunbc.dispatch_credential_acquisition { CredentialAcquisitionStore, credential_slot_observe }\nfn f(credentials: CredentialAcquisitionStore) -> CasSlotObservation<NonEmptyStr> { credential_slot_observe(credentials: credentials, reference: \"../x\" as NonEmptyStr) }\n"

data safe_observe_source: String = "module probe_cra_safe_observe\nimport std.types { NonEmptyStr }\nimport std.durable_compare_and_set { CasSlotObservation }\nimport std.optional { Present, Absent }\nimport gunbc.dispatch_credential_acquisition { CredentialAcquisitionStore, credential_slot_observe, credential_attempt_reference }\nfn f(credentials: CredentialAcquisitionStore) -> CasSlotObservation<NonEmptyStr>? { match credential_attempt_reference(raw: \"att-1-cursor\") { Absent => none, Present { value: carrier } => Present { value: credential_slot_observe(credentials: credentials, reference: carrier) } } }\n"

data hostile_root_source: String = "module probe_cra_hostile_root\nimport std.types { NonEmptyStr }\nimport gunbc.dispatch_credential_acquisition { CredentialAcquisitionStore, cursor_attempt_runtime_root, CursorAttemptRuntimeRoot }\nfn f(credentials: CredentialAcquisitionStore) -> CursorAttemptRuntimeRoot { cursor_attempt_runtime_root(credentials: credentials, reference: \"../x\" as NonEmptyStr) }\n"

data safe_root_source: String = "module probe_cra_safe_root\nimport std.types { NonEmptyStr }\nimport std.optional { Present, Absent }\nimport gunbc.dispatch_credential_acquisition { CredentialAcquisitionStore, cursor_attempt_runtime_root, CursorAttemptRuntimeRoot, credential_attempt_reference }\nfn g(credentials: CredentialAcquisitionStore) -> CursorAttemptRuntimeRoot? { match credential_attempt_reference(raw: \"att-1-cursor\") { Absent => none, Present { value: carrier } => Present { value: cursor_attempt_runtime_root(credentials: credentials, reference: carrier) } } }\n"

// The refusal is asserted through the CENSUS, which compiles the source against the live checkout
// (the fixture is corpus-isolated BY CONSTRUCTION and cannot resolve a source that imports the corpus --
// the first version of this claim reached for the wrong instrument). Arms are matched, so an instrument
// that could not run is a visible false on BOTH sides, never an empty row list wearing a verdict. Only
// BLOCKING rows of the brand-law class (WhereRefinementUnenforced) or the shape class (TypeMismatch)
// count: a safe source may carry non-blocking advisories and still complete the real pipeline clean.
fn hostile_refused(source: String) -> Bool {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: rows } =>
      count(rows |> filter(r => r.blocking && ((r.diagnostic_class as String) == "WhereRefinementUnenforced" || (r.diagnostic_class as String) == "TypeMismatch"))) >= 1
    CensusNotRunnable { cause: _ } => false
  }
}

fn safe_clean(source: String) -> Bool {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: rows } =>
      count(rows |> filter(r => r.blocking && ((r.diagnostic_class as String) == "WhereRefinementUnenforced" || (r.diagnostic_class as String) == "TypeMismatch"))) == 0
    CensusNotRunnable { cause: _ } => false
  }
}

// If a route for either hostile shape ever opens again (an unadmitted parameter, an escape-hatch overload,
// a sanitized String drop-in), the corresponding `>= 1` goes red even if the twins stay green.
test fn a_caller_chosen_reference_reaches_no_observe_or_remove_route() -> Bool {
  hostile_refused(source: hostile_observe_source)
    && safe_clean(source: safe_observe_source)
    && hostile_refused(source: hostile_root_source)
    && safe_clean(source: safe_root_source)
}
