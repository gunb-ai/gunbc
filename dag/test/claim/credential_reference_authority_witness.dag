module test.claim.credential_reference_authority_witness

// FOREIGN-MODULE AUTHORITY WITNESS (side-chat REQUEST_CHANGES, sealed stores PR 2, 2026-11-20).
// The finding: cursor_attempt_runtime_root(credentials, reference) and the observe/remove routes joined a
// CALLER-CHOSEN reference into a path with no segment admission, so a module outside gunbc could obtain a
// sealed CursorAttemptRuntimeRoot for "../x" and reach the recursive remove. The fix admits the reference as
// a path segment at every boundary: the only carrier is CredentialAttemptReference, a brand of std.types
// PathSegment minted by credential_attempt_reference through path_segment_is_safe (the one law), refused
// rather than sanitized. These claims run FROM THIS FOREIGN MODULE and pin both halves: what the law refuses
// (no carrier exists), and what therefore no longer TYPE-CHECKS anywhere (the hostile call shapes, counted
// against safe twins that still compile clean).

import std.types { String, Bool, NonEmptyStr, PathSegment, path_segment_is_safe }
import std.optional { Present, Absent }
import gunbc.compile_diagnostic_census { compile_dag_diagnostic_census }
import gunbc.dispatch_credential_acquisition {
  CredentialAttemptReference, CredentialAcquisitionStore, credential_attempt_reference,
  credential_slot_observe, CasObservedUnreadable, CasObservedReadable,
  CursorAttemptRuntimeRoot, cursor_attempt_runtime_root, cursor_attempt_runtime_root_path, credential_attempt_reference_segment
}

// Equality against the REAL authority: a carrier exists exactly when path_segment_is_safe holds, and it
// round-trips. Not containment of a chosen list -- the two spellings must agree for every input.
fn mints_agree_with_the_law(raw: String) -> Bool {
  match credential_attempt_reference(raw: raw) {
    Absent => !path_segment_is_safe(raw: raw)
    Present { value: carrier } => credential_attempt_reference_segment(reference: carrier) == raw && path_segment_is_safe(raw: raw)
  }
}

test fn hostile_spellings_never_mint_a_carrier() -> Bool {
  // percent-encoded separators are NOT filesystem separators: "..%2fx" is a legal literal file name, so the law
  // -- and this claim -- treat it as benign, never as traversal.
  let hostile = ["../x", "..", ".", "a/b", "/etc", "", "a//b", "x/", "../.."]
  all(hostile, h => mints_agree_with_the_law(raw: h))
    && all(hostile, h => match credential_attempt_reference(raw: h) { Absent => true, Present { value: _ } => false })
}

test fn benign_spellings_mint_and_round_trip() -> Bool {
  let benign = ["att-1-cursor", "attempt-42_codex", "a", "2026.11.20", "..%2fx"]
  all(benign, b => mints_agree_with_the_law(raw: b))
    && all(benign, b => match credential_attempt_reference(raw: b) {
         Absent => false
         Present { value: carrier } => credential_attempt_reference_segment(reference: carrier) == b
       })
}

// The one join, pinned by equality against the layout formula, for a carried reference: the sealed root is
// exactly <instance_root>/cursor-attempt-runtime/<reference>. No other shape is reachable.
test fn the_carrier_joins_at_exactly_one_place() -> Bool {
  match credential_attempt_reference(raw: "att-7-codex") {
    Absent => false
    Present { value: carrier } =>
      cursor_attempt_runtime_root_path(instance_root: "/tmp/sealed-instance", reference: carrier)
        == "/tmp/sealed-instance/cursor-attempt-runtime/att-7-codex"
  }
}

// ── THE REDS: the hostile call shapes no longer type-check, and safe twins do. ─────────────────────────
// One effect per probe module so a count is meaningful. CensusNotRunnable scores -1 so an unavailable
// census fails the claim rather than passing it (precedent: alias_identity_every_check_witness).

data hostile_observe_source: String = "module probe_cra_hostile_observe\nimport std.types { NonEmptyStr }\nimport std.durable_compare_and_set { CasSlotObservation }\nimport gunbc.dispatch_credential_acquisition { CredentialAcquisitionStore, credential_slot_observe }\nfn f(credentials: CredentialAcquisitionStore) -> CasSlotObservation<NonEmptyStr> { credential_slot_observe(credentials: credentials, reference: \"../x\" as NonEmptyStr) }\n"

data safe_observe_source: String = "module probe_cra_safe_observe\nimport std.types { NonEmptyStr }\nimport std.durable_compare_and_set { CasSlotObservation }\nimport std.optional { Present, Absent }\nimport gunbc.dispatch_credential_acquisition { CredentialAcquisitionStore, credential_slot_observe, credential_attempt_reference }\nfn f(credentials: CredentialAcquisitionStore) -> CasSlotObservation<NonEmptyStr>? { match credential_attempt_reference(raw: \"att-1-cursor\") { Absent => none, Present { value: carrier } => Present { value: credential_slot_observe(credentials: credentials, reference: carrier) } } }\n"

data hostile_root_source: String = "module probe_cra_hostile_root\nimport std.types { NonEmptyStr }\nimport gunbc.dispatch_credential_acquisition { CredentialAcquisitionStore, cursor_attempt_runtime_root, CursorAttemptRuntimeRoot }\nfn f(credentials: CredentialAcquisitionStore) -> CursorAttemptRuntimeRoot { cursor_attempt_runtime_root(credentials: credentials, reference: \"../x\" as NonEmptyStr) }\n"

data safe_root_source: String = "module probe_cra_safe_root\nimport std.types { NonEmptyStr }\nimport std.optional { Present, Absent }\nimport gunbc.dispatch_credential_acquisition { CredentialAcquisitionStore, cursor_attempt_runtime_root, CursorAttemptRuntimeRoot, credential_attempt_reference }\nfn g(credentials: CredentialAcquisitionStore) -> CursorAttemptRuntimeRoot? { match credential_attempt_reference(raw: \"att-1-cursor\") { Absent => none, Present { value: carrier } => Present { value: cursor_attempt_runtime_root(credentials: credentials, reference: carrier) } } }\n"

// The refusal is asserted through the CENSUS, arms matched: an instrument that cannot run is a
// visible false, never a silent 0. What this text-level claim pins is only what the census can
// establish: the compiler FLAGS the boundary violation (a blocking or advisory row of the brand-law
// class WhereRefinementUnenforced or the shape class TypeMismatch appears when a plain NonEmptyStr
// is handed to the sealed parameter). Absolute counts are NOT asserted, because the census module
// itself says they are properties of the closure, not the probe (gunbc::compile_diagnostic_census:
// "THE ROW SET IS THE WHOLE COMPILE'S... a CensusObserved is not evidence that the fixture itself
// compiled clean"); the same-source-minus-the-axis direction -- that the minted carrier flows the
// same routes to a real effect -- is evidenced by the WET group, which EXECUTES those routes
// (cursor_runtime_root_wet_witness, including the hostile-key refusal that creates no directory).
// The class set is the six classes the compiler actually reports for an unadmitted
// crossing at this head — verified row-present by probe claims probe_root and
// probe_obs (scratch entry, author-run, 2026-11-21: both PASS, >=1 row each), not
// guessed. An unadmitted hostile shape that compiles to NO diagnostic of any class
// is what this claim forbids; which of the six fires is the compiler's choice.
// ONE class, not a union: a twelve-claim per-class probe (one claim per candidate class per hostile
// shape, author-run) established that the compiler reports the unadmitted crossing on BOTH hostile
// shapes as exactly one class, WhereRefinementUnenforced (root_whererefine and obs_whererefine PASS;
// the other ten FAIL). Those two probes now live in this file as the fold-in claims
// a_hostile_root_shape_is_flagged_by_the_type_checker and
// a_hostile_observe_shape_is_flagged_by_the_type_checker, each asserting this one class (review 97142).
fn boundary_flagged(source: String) -> Bool {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: rows } =>
      count(rows |> filter(r => (r.diagnostic_class as String) == "WhereRefinementUnenforced")) >= 1
    CensusNotRunnable { cause: _ } => false
  }
}

fn census_observed(source: String) -> Bool {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: _ } => true
    CensusNotRunnable { cause: _ } => false
  }
}

// If a route for either hostile shape ever opens again (an unadmitted parameter, an escape-hatch overload,
// a sanitized String drop-in), the corresponding `>= 1` goes red even if the twins stay green.
test fn a_caller_chosen_reference_reaches_no_observe_or_remove_route() -> Bool {
  boundary_flagged(source: hostile_observe_source)
    && boundary_flagged(source: hostile_root_source)
    && census_observed(source: safe_observe_source)
    && census_observed(source: safe_root_source)
}

// FOLD-IN PROBES (review 97142): each asserts the ONE diagnostic class the compiler actually reports
// for its hostile shape, established claim-per-class by the per-class probe battery. They replace the
// deleted scratch probe entry. A hostile crossing that compiles WITHOUT a WhereRefinementUnenforced row
// is a red here, and a_caller_chosen below consumes the same fact through boundary_flagged.

test fn a_hostile_root_shape_is_flagged_by_the_type_checker() -> Bool {
  boundary_flagged(source: hostile_root_source)
}

test fn a_hostile_observe_shape_is_flagged_by_the_type_checker() -> Bool {
  boundary_flagged(source: hostile_observe_source)
}

// THE CARRIER SEAL, BY TWIN (review 97160). The same two forged casts -- a traversal spelling and a
// WELL-FORMED spelling, so the evidence is about the SEAL and not about segment checks -- are written
// against two definer fixtures that differ in nothing but the sole_constructor keyword. Sealed: BOTH
// forgeries are refused construction (>=1 row each, class SoleConstructorViolation). Stripped: the seal
// is gone and the SAME sources compile with NO such row. If the stripped twin ever flags, the claim is
// red and the seal keyword is not what refused.

data car_forged_cast_sealed_twin_source: String = "module probe_car_twin_sealed\nimport test.fixture.c_roadmap2_credential_reference_authority.car_definer { CredentialAttemptReference, forge_target }\nfn forged_traversal() -> Bool { forge_target(reference: \"../x\" as CredentialAttemptReference) }\nfn forged_wellformed() -> Bool { forge_target(reference: \"k\" as CredentialAttemptReference) }\n"

data car_forged_cast_stripped_twin_source: String = "module probe_car_twin_stripped\nimport test.fixture.c_roadmap2_credential_reference_authority.car_stripped_definer { CredentialAttemptReference, forge_target }\nfn forged_traversal() -> Bool { forge_target(reference: \"../x\" as CredentialAttemptReference) }\nfn forged_wellformed() -> Bool { forge_target(reference: \"k\" as CredentialAttemptReference) }\n"

fn sole_ctor_rows(source: String) -> Int {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: rows } => count(rows |> filter(r => (r.diagnostic_class as String) == "SoleConstructorViolation"))
    CensusNotRunnable { cause: _ } => -1
  }
}

fn census_ran(source: String) -> Bool {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: _ } => true
    CensusNotRunnable { cause: _ } => false
  }
}

test fn the_carrier_seal_is_what_refuses_forged_casts() -> Bool {
  census_ran(source: car_forged_cast_sealed_twin_source)
    && census_ran(source: car_forged_cast_stripped_twin_source)
    && sole_ctor_rows(source: car_forged_cast_sealed_twin_source) >= 1
    && sole_ctor_rows(source: car_forged_cast_stripped_twin_source) == 0
}

// THE KEY-SEGMENT CARRIER SEAL, BY TWIN (DESIGN 4b rung honesty: per subject). The take-path key carrier
// DispatchAttemptKeySegment is a DIFFERENT sealed type from CredentialAttemptReference, so it gets its own
// discriminating RED and its own stripped twin -- precedent from the credential carrier is not evidence
// about this one. Same two forged spellings (a traversal and a well-formed one), written against the two
// definer fixtures that differ only in the seal keyword.

data key_forged_cast_sealed_twin_source: String = "module probe_key_twin_sealed\nimport test.fixture.c_roadmap2_dispatch_attempt_key.key_definer { DispatchAttemptKeySegment, forge_target }\nfn forged_traversal() -> Bool { forge_target(segment: \"../x\" as DispatchAttemptKeySegment) }\nfn forged_wellformed() -> Bool { forge_target(segment: \"k\" as DispatchAttemptKeySegment) }\n"

data key_forged_cast_stripped_twin_source: String = "module probe_key_twin_stripped\nimport test.fixture.c_roadmap2_dispatch_attempt_key.key_stripped_definer { DispatchAttemptKeySegment, forge_target }\nfn forged_traversal() -> Bool { forge_target(segment: \"../x\" as DispatchAttemptKeySegment) }\nfn forged_wellformed() -> Bool { forge_target(segment: \"k\" as DispatchAttemptKeySegment) }\n"

test fn the_key_segment_carrier_seal_is_what_refuses_forged_casts() -> Bool {
  census_ran(source: key_forged_cast_sealed_twin_source)
    && census_ran(source: key_forged_cast_stripped_twin_source)
    && sole_ctor_rows(source: key_forged_cast_sealed_twin_source) >= 1
    && sole_ctor_rows(source: key_forged_cast_stripped_twin_source) == 0
}

// THE PRODUCTION SEALS THEMSELVES, NOT JUST THE FIXTURE SHAPE. The same forged spellings, cast against
// the REAL production carriers imported from their declaring modules. Sealed at the reported head, each
// forging is refused construction (>=1 SoleConstructorViolation row). The battery runs these same claims
// under a BROKEN mutant that strips sole_constructor from the production declarations -- type-checking
// mutants (the type stays a record; only the seal keyword goes) -- where both must go red, and again
// after the restore where both must go green. Precedent from the sibling carrier is NOT reused here:
// each subject carries its own RED (DESIGN 4b).

data production_reference_forgery_source: String = "module probe_prod_ref_forge\nimport gunbc.dispatch_credential_acquisition { CredentialAttemptReference }\nfn forged() -> CredentialAttemptReference { \"../x\" as CredentialAttemptReference }\n"

data production_key_forgery_source: String = "module probe_prod_key_forge\nimport gunbc.dispatch_attempt_key { DispatchAttemptKeySegment }\nfn forged() -> DispatchAttemptKeySegment { \"../x\" as DispatchAttemptKeySegment }\n"

test fn the_production_reference_seal_refuses_a_forged_cast() -> Bool {
  census_ran(source: production_reference_forgery_source)
    && sole_ctor_rows(source: production_reference_forgery_source) >= 1
}

test fn the_production_key_segment_seal_refuses_a_forged_cast() -> Bool {
  census_ran(source: production_key_forgery_source)
    && sole_ctor_rows(source: production_key_forgery_source) >= 1
}
