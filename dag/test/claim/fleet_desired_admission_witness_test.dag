module test.claim.fleet_desired_admission_witness_test

import std.types { String, Bool, CommitSha, NonEmptyStr }
import extdeps.git.object_store { GitObjectId, git_object_id_from_untagged_hex, git_object_id_wire_hex }
import extdeps.github.workflow_runs {
  WorkflowRunConclusion, Success, Failure, Cancelled, Skipped, TimedOut, Neutral, ActionRequired, StartupFailure,
}
import extdeps.github.workflow_run_event { WorkflowRunEvent }
import gunbc.witness_floor_workflow { witness_floor_workflow_name }
import gunbc.repo_identity { gunbc_default_branch_name }
import gunbc.fleet_main_revision {
  FleetDesiredRevision, FleetDesiredAdmitted, FleetDesiredUnobserved,
}
import gunbc.fleet_desired_admission {
  FleetDesiredAdmissionOutcome, AdmissionAdvanceAuthorized, AdmissionRefused,
  fleet_desired_admission_decide,
  fleet_desired_floor_green,
  fleet_desired_authorized_push_script,
  fleet_desired_admission_authorized_push_path,
}
import gunbc.fleet_desired_admission_workflow { expected_fleet_desired_yml }
import gunbc.live_deploy_workflow { expected_deploy_yml }

data fixture_prior_hex: String = "1111111111111111111111111111111111111111"
data fixture_candidate_hex: String = "2222222222222222222222222222222222222222"
data fixture_repo: String = "gunb-ai/gunbc"

fn fixture_oid(hex: String) -> GitObjectId {
  match git_object_id_from_untagged_hex(hex: hex) {
    Present { value: oid } => oid
    Absent => "0000000000000000000000000000000000000000" as GitObjectId
  }
}

fn fixture_prior() -> FleetDesiredRevision {
  FleetDesiredAdmitted { revision: fixture_oid(hex: fixture_prior_hex) }
}

fn fixture_event(workflow_name: String, conclusion: WorkflowRunConclusion, branch: String, head_repo: String, activity: String) -> WorkflowRunEvent {
  WorkflowRunEvent {
    activity: activity,
    run_id: "1" as NonEmptyStr,
    workflow_name: workflow_name,
    workflow_id: "2" as NonEmptyStr,
    workflow_path: ".github/workflows/witnesses.yml",
    conclusion: conclusion,
    html_url: "https://example.invalid/run" as NonEmptyStr,
    run_started_at: "2026-08-20T00:00:00Z" as NonEmptyStr,
    head_sha: fixture_candidate_hex as CommitSha,
    head_branch: branch,
    head_repository_full_name: head_repo,
    originating_event: "push",
    repository_full_name: fixture_repo,
  }
}

fn admitting_event() -> WorkflowRunEvent {
  fixture_event(
    workflow_name: witness_floor_workflow_name,
    conclusion: Success,
    branch: gunbc_default_branch_name,
    head_repo: fixture_repo,
    activity: "completed",
  )
}

fn decided(event: WorkflowRunEvent, observed: FleetDesiredRevision) -> FleetDesiredAdmissionOutcome {
  fleet_desired_admission_decide(event: event, observed: observed)
}

fn is_refused(o: FleetDesiredAdmissionOutcome) -> Bool {
  match o {
    AdmissionRefused { cause: _ } => true
    AdmissionAdvanceAuthorized { from: _, to: _ } => false
  }
}

// THE POSITIVE CONTROL. Every refusal claim below removes exactly one fact from THIS event, so a
// refusal that fired for an unrelated reason would show up here as a failure to admit at all.
test fn a_floor_green_default_branch_run_admits_the_candidate() -> Bool {
  match decided(event: admitting_event(), observed: fixture_prior()) {
    AdmissionRefused { cause: _ } => false
    AdmissionAdvanceAuthorized { from: f, to: t } =>
      (git_object_id_wire_hex(oid: f) as String == fixture_prior_hex)
        && (git_object_id_wire_hex(oid: t) as String == fixture_candidate_hex)
  }
}

// THE KEYSTONE. This is the defect the emitted deploy.yml carried: a candidate whose floor is not
// green was advanced anyway. The refusal must come from the modeled authority, so the claim pins
// the authority's own prevented-class wording rather than merely observing that something refused.
test fn a_floor_red_candidate_is_refused_by_the_modeled_authority() -> Bool {
  match decided(
    event: fixture_event(
      workflow_name: witness_floor_workflow_name,
      conclusion: Failure,
      branch: gunbc_default_branch_name,
      head_repo: fixture_repo,
      activity: "completed",
    ),
    observed: fixture_prior(),
  ) {
    AdmissionAdvanceAuthorized { from: _, to: _ } => false
    AdmissionRefused { cause: c } =>
      string_contains(s: c, pattern: "raw-HEAD simultaneous fleet-bricking")
        && string_contains(s: c, pattern: "failure")
  }
}

// Every non-Success conclusion is red. Cancelled and Skipped are the two that most invite a
// "close enough" arm — a cancelled floor proves nothing and a skipped one ran nothing.
test fn only_success_is_floor_green() -> Bool {
  fleet_desired_floor_green(conclusion: Success)
    && !fleet_desired_floor_green(conclusion: Failure)
    && !fleet_desired_floor_green(conclusion: Cancelled)
    && !fleet_desired_floor_green(conclusion: Skipped)
    && !fleet_desired_floor_green(conclusion: TimedOut)
    && !fleet_desired_floor_green(conclusion: Neutral)
    && !fleet_desired_floor_green(conclusion: ActionRequired)
    && !fleet_desired_floor_green(conclusion: StartupFailure)
}

test fn a_conclusion_from_another_workflow_is_refused() -> Bool {
  is_refused(o: decided(
    event: fixture_event(
      workflow_name: "deploy",
      conclusion: Success,
      branch: gunbc_default_branch_name,
      head_repo: fixture_repo,
      activity: "completed",
    ),
    observed: fixture_prior(),
  ))
}

test fn a_non_default_branch_run_is_refused() -> Bool {
  is_refused(o: decided(
    event: fixture_event(
      workflow_name: witness_floor_workflow_name,
      conclusion: Success,
      branch: "session/nimble-fox-671",
      head_repo: fixture_repo,
      activity: "completed",
    ),
    observed: fixture_prior(),
  ))
}

test fn a_fork_head_repository_is_refused() -> Bool {
  is_refused(o: decided(
    event: fixture_event(
      workflow_name: witness_floor_workflow_name,
      conclusion: Success,
      branch: gunbc_default_branch_name,
      head_repo: "someone-else/gunbc",
      activity: "completed",
    ),
    observed: fixture_prior(),
  ))
}

test fn an_incomplete_activity_is_refused() -> Bool {
  is_refused(o: decided(
    event: fixture_event(
      workflow_name: witness_floor_workflow_name,
      conclusion: Success,
      branch: gunbc_default_branch_name,
      head_repo: fixture_repo,
      activity: "requested",
    ),
    observed: fixture_prior(),
  ))
}

// THE EMPTY-OBSERVATION NARROW, AS A CLAIM. An unreadable prior must refuse, not be treated as an
// absent one — the arm that would create the ref from scratch and overwrite an admitted revision
// nobody could read. This is the discriminating input: the event is otherwise fully admitting.
test fn an_unobservable_prior_refuses_rather_than_creating_the_ref() -> Bool {
  match decided(
    event: admitting_event(),
    observed: FleetDesiredUnobserved { cause: "ls-remote refused: network unreachable" },
  ) {
    AdmissionAdvanceAuthorized { from: _, to: _ } => false
    AdmissionRefused { cause: c } =>
      string_contains(s: c, pattern: "never read as an absent one")
  }
}

// The authorized push names the observed prior as the compare-and-swap expectation, so a
// concurrent admission refuses at the remote instead of overwriting.
test fn the_authorized_push_carries_the_observed_prior_as_the_cas_expectation() -> Bool {
  let script = fleet_desired_authorized_push_script(
    from: fixture_oid(hex: fixture_prior_hex),
    to: fixture_oid(hex: fixture_candidate_hex),
  )
  string_contains(s: script, pattern: concat("--force-with-lease=refs/fleet/desired:", fixture_prior_hex))
    && string_contains(s: script, pattern: concat(fixture_candidate_hex, ":refs/fleet/desired"))
}

// THE EMISSION HALF. The pure decision above proves the gate decides correctly; it proves nothing
// about what the workflow actually runs, so these read the emitted bytes.
test fn the_admission_workflow_triggers_on_the_floor_workflow_completing() -> Bool {
  let yml = expected_fleet_desired_yml()
  string_contains(s: yml, pattern: "workflow_run:")
    && string_contains(s: yml, pattern: witness_floor_workflow_name)
    && string_contains(s: yml, pattern: "admit_fleet_desired_from_floor_event_wet")
}

// THE ACTUATION CARRIES NO DECISION. If the push step ever names the ref or a revision expression
// of its own, it has re-acquired the ability to push something the gate did not admit.
test fn the_admission_workflow_push_step_names_no_revision_of_its_own() -> Bool {
  let yml = expected_fleet_desired_yml()
  string_contains(s: yml, pattern: fleet_desired_admission_authorized_push_path)
    && !string_contains(s: yml, pattern: "GITHUB_SHA")
    && !string_contains(s: yml, pattern: "force-with-lease")
    && !string_contains(s: yml, pattern: "ls-remote")
}

// THE REGRESSION CONTROL FOR THE DEFECT ITSELF. deploy.yml must no longer advance the ref, and the
// positive half proves the file is still the deploy workflow rather than empty or broken — an
// assertion of absence alone would pass against a file that lost everything.
test fn the_deploy_workflow_no_longer_advances_the_fleet_revision() -> Bool {
  let yml = expected_deploy_yml()
  string_contains(s: yml, pattern: "live_deploy_apply_srv1_wet")
    && string_contains(s: yml, pattern: "materialize_codex_runtime_on_local_host")
    && !string_contains(s: yml, pattern: "refs/fleet/desired")
    && !string_contains(s: yml, pattern: "force-with-lease")
}
