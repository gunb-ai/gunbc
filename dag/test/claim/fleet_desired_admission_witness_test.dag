module test.claim.fleet_desired_admission_witness_test


data fixture_prior_hex: String = "1111111111111111111111111111111111111111"
data fixture_candidate_hex: String = "2222222222222222222222222222222222222222"
data fixture_judge_hex: String = "4444444444444444444444444444444444444444"
data fixture_repo: String = "gunb-ai/gunbc"

fn fixture_oid(hex: String) -> extdeps.git.object_store.GitObjectId {
  match extdeps.git.object_store.git_object_id_from_untagged_hex(hex: hex) {
    Present { value: oid } => oid
    Absent => "0000000000000000000000000000000000000000" as extdeps.git.object_store.GitObjectId
  }
}

fn fixture_event(workflow_name: String, conclusion: extdeps.github.workflow_runs.WorkflowRunConclusion, branch: String, head_repo: String, activity: String, workflow_path: String, originating: String) -> extdeps.github.workflow_run_event.WorkflowRunEvent {
  extdeps.github.workflow_run_event.WorkflowRunEvent {
    activity: activity,
    run_id: "1" as std.types.NonEmptyStr,
    workflow_name: workflow_name,
    workflow_id: "2" as std.types.NonEmptyStr,
    workflow_path: workflow_path,
    conclusion: conclusion,
    html_url: "https://example.invalid/run" as std.types.NonEmptyStr,
    run_started_at: "2026-08-20T00:00:00Z" as std.types.NonEmptyStr,
    head_sha: fixture_candidate_hex as std.types.CommitSha,
    head_branch: branch,
    head_repository_full_name: head_repo,
    originating_event: originating,
    repository_full_name: fixture_repo,
  }
}

fn admitting_event() -> extdeps.github.workflow_run_event.WorkflowRunEvent {
  fixture_event(
    workflow_name: gunbc.witness_floor_workflow.witness_floor_workflow_name,
    conclusion: extdeps.github.workflow_runs.Success,
    branch: gunbc.repo_identity.gunbc_default_branch_name,
    head_repo: fixture_repo,
    activity: "completed",
    workflow_path: ".github/workflows/witnesses.yml",
    originating: "push",
  )
}

fn is_event_refused(o: gunbc.fleet_desired_admission.FleetDesiredAcceptedRevision) -> Bool {
  match o {
    gunbc.fleet_desired_admission.FleetDesiredRevisionRefused { cause: _ } => true
    gunbc.fleet_desired_admission.FleetDesiredRevisionAccepted { accepted: _ } => false
  }
}

// THE POSITIVE CONTROL. Every refusal claim below removes exactly one fact from THIS event, so a
// refusal that fired for an unrelated reason would show up here as a failure to accept at all.
// It also pins the revision, because an acceptance naming the wrong one would advance the fleet
// to something the floor never proved.
test fn a_floor_green_default_branch_run_accepts_the_candidate_revision() -> Bool {
  match gunbc.fleet_desired_admission.fleet_desired_accepted_from_event(event: admitting_event()) {
    gunbc.fleet_desired_admission.FleetDesiredRevisionRefused { cause: _ } => false
    gunbc.fleet_desired_admission.FleetDesiredRevisionAccepted { accepted: a } =>
      extdeps.git.object_store.git_object_id_wire_hex(oid: a.revision) as String == fixture_candidate_hex
  }
}

// AN UNDECODABLE ADVERTISEMENT REFUSES WITHOUT WRITING OVER THE REF, and this row is PORTED from
// main rather than dropped with the vocabulary it was written against. It arrived here through a
// clean auto-merge -- no conflict marker -- still spelled in main's deleted `decided` /
// AdmissionAdvanceAuthorized terms, so it would not have compiled; the tempting resolution was to
// delete it with its siblings. But the CLAIM is real and this branch had no equivalent, and a
// replacement that quietly drops a refusal has erased a correctness distinction rather than
// completed a migration.
//
// The claim: the ref EXISTS holding something unreadable, so a write would destroy it and a retry
// will not fix it. The assertion pins the remedy-bearing wording AND denies the unobserved arm's,
// because the two refusals must stay distinguishable -- an operator repairs a corrupt ref and
// retries an unreachable one. Wording follows THIS branch's authority
// (gunbc.fleet_main_revision fleet_desired_advance_refusal_message), not main's, since porting a
// claim means re-asserting it against the live message rather than copying a string that no
// longer exists.
test fn an_undecodable_desired_ref_refuses_without_writing_over_it() -> Bool {
  match action_for(input: gunbc.fleet_main_revision.FleetDesiredExpectationRefusedInput {
    accepted: accepted_fixture(),
    cause: gunbc.fleet_main_revision.FleetDesiredRefUndecodable { advertised: "not-a-sha refs/fleet/desired" },
  }) {
    gunbc.fleet_desired_admission.AdmissionActionAuthorized { action: _ } => false
    gunbc.fleet_desired_admission.AdmissionRefused { cause: c } =>
      string_contains(s: c, pattern: "must not be written over")
        && string_contains(s: c, pattern: "not-a-sha refs/fleet/desired")
        && !string_contains(s: c, pattern: "could not be observed")
  }
}

// THE KEYSTONE. This is the defect the emitted deploy.yml carried: a candidate whose floor is not
// green was advanced anyway. Every non-Success conclusion is red -- Cancelled and Skipped are the
// two that most invite a "close enough" arm, since a cancelled floor proves nothing and a skipped
// one ran nothing. Enumerated rather than sampled, because the arm that admits one of these is
// exactly the arm that never fires in testing.
fn accepted_with_conclusion(conclusion: extdeps.github.workflow_runs.WorkflowRunConclusion) -> Bool {
  !is_event_refused(o: gunbc.fleet_desired_admission.fleet_desired_accepted_from_event(event: fixture_event(
    workflow_name: gunbc.witness_floor_workflow.witness_floor_workflow_name,
    conclusion: conclusion,
    branch: gunbc.repo_identity.gunbc_default_branch_name,
    head_repo: fixture_repo,
    activity: "completed",
    workflow_path: ".github/workflows/witnesses.yml",
    originating: "push",
  )))
}

test fn only_a_success_conclusion_is_accepted() -> Bool {
  accepted_with_conclusion(conclusion: extdeps.github.workflow_runs.Success)
    && !accepted_with_conclusion(conclusion: extdeps.github.workflow_runs.Failure)
    && !accepted_with_conclusion(conclusion: extdeps.github.workflow_runs.Cancelled)
    && !accepted_with_conclusion(conclusion: extdeps.github.workflow_runs.Skipped)
    && !accepted_with_conclusion(conclusion: extdeps.github.workflow_runs.TimedOut)
    && !accepted_with_conclusion(conclusion: extdeps.github.workflow_runs.Neutral)
    && !accepted_with_conclusion(conclusion: extdeps.github.workflow_runs.ActionRequired)
    && !accepted_with_conclusion(conclusion: extdeps.github.workflow_runs.StartupFailure)
}

// The floor is identified by PATH, not by name. A workflow that renames itself "witnesses" does
// not become the floor, and the old wall -- which matched on the name -- would have admitted it.
test fn a_run_of_another_workflow_path_is_refused() -> Bool {
  is_event_refused(o: gunbc.fleet_desired_admission.fleet_desired_accepted_from_event(event: fixture_event(
    workflow_name: gunbc.witness_floor_workflow.witness_floor_workflow_name,
    conclusion: extdeps.github.workflow_runs.Success,
    branch: gunbc.repo_identity.gunbc_default_branch_name,
    head_repo: fixture_repo,
    activity: "completed",
    workflow_path: ".github/workflows/deploy.yml",
    originating: "push",
  )))
}

test fn a_non_default_branch_run_is_refused() -> Bool {
  is_event_refused(o: gunbc.fleet_desired_admission.fleet_desired_accepted_from_event(event: fixture_event(
    workflow_name: gunbc.witness_floor_workflow.witness_floor_workflow_name,
    conclusion: extdeps.github.workflow_runs.Success,
    branch: "session/nimble-fox-671",
    head_repo: fixture_repo,
    activity: "completed",
    workflow_path: ".github/workflows/witnesses.yml",
    originating: "push",
  )))
}

test fn a_fork_head_repository_is_refused() -> Bool {
  is_event_refused(o: gunbc.fleet_desired_admission.fleet_desired_accepted_from_event(event: fixture_event(
    workflow_name: gunbc.witness_floor_workflow.witness_floor_workflow_name,
    conclusion: extdeps.github.workflow_runs.Success,
    branch: gunbc.repo_identity.gunbc_default_branch_name,
    head_repo: "someone-else/gunbc",
    activity: "completed",
    workflow_path: ".github/workflows/witnesses.yml",
    originating: "push",
  )))
}

test fn an_incomplete_activity_is_refused() -> Bool {
  is_event_refused(o: gunbc.fleet_desired_admission.fleet_desired_accepted_from_event(event: fixture_event(
    workflow_name: gunbc.witness_floor_workflow.witness_floor_workflow_name,
    conclusion: extdeps.github.workflow_runs.Success,
    branch: gunbc.repo_identity.gunbc_default_branch_name,
    head_repo: fixture_repo,
    activity: "requested",
    workflow_path: ".github/workflows/witnesses.yml",
    originating: "push",
  )))
}

// A refusal the OLD wall did not make at all. A floor run triggered by anything but a push to the
// default branch -- a manual dispatch, a schedule -- proves the floor green for a tree that was
// never merged, so its head_sha is not a landed revision.
test fn a_non_push_originating_event_is_refused() -> Bool {
  is_event_refused(o: gunbc.fleet_desired_admission.fleet_desired_accepted_from_event(event: fixture_event(
    workflow_name: gunbc.witness_floor_workflow.witness_floor_workflow_name,
    conclusion: extdeps.github.workflow_runs.Success,
    branch: gunbc.repo_identity.gunbc_default_branch_name,
    head_repo: fixture_repo,
    activity: "completed",
    workflow_path: ".github/workflows/witnesses.yml",
    originating: "workflow_dispatch",
  )))
}

// ---------------------------------------------------------------------------------------------
// THE JOIN. The rows above prove the event is classified; gunbc.fleet_main_revision's own witness
// proves the advance decision. These prove the seam BETWEEN them -- that each decision becomes
// exactly one action, and that a refusal becomes no action at all.

// The refusing arm is unreachable while the positive control above holds -- it recurses rather
// than fabricating an accepted revision, because a fabricated one would let every row below pass
// against a fixture the producers never admitted.
fn accepted_fixture() -> gunbc.fleet_revision_acceptance.AcceptedFleetRevision<std.types.NonEmptyStr, std.types.NonEmptyStr> {
  match gunbc.fleet_desired_admission.fleet_desired_accepted_from_event(event: admitting_event()) {
    gunbc.fleet_desired_admission.FleetDesiredRevisionAccepted { accepted: a } => a
    gunbc.fleet_desired_admission.FleetDesiredRevisionRefused { cause: _ } => accepted_fixture()
  }
}

fn action_for(input: gunbc.fleet_main_revision.FleetDesiredAdvanceInput<std.types.NonEmptyStr, std.types.NonEmptyStr>) -> gunbc.fleet_desired_admission.FleetDesiredAdmissionOutcome {
  gunbc.fleet_desired_admission.fleet_desired_action_from_decision(decision: gunbc.fleet_main_revision.decide_fleet_desired_advance(input: input))
}

// The relation is carried as an OBSERVATION -- which two revisions were compared -- rather than as
// a bare verdict, so these fixtures name both endpoints. Building it any other way would let a
// relation computed for one pair be applied to another, which is the refusal the last row here
// pins down.
fn observed_input(current_hex: String, relation: gunbc.live_deploy.revision.DeployRevisionRelation) -> gunbc.fleet_main_revision.FleetDesiredAdvanceInput<std.types.NonEmptyStr, std.types.NonEmptyStr> {
  gunbc.fleet_main_revision.FleetDesiredObservedCurrentInput {
    accepted: accepted_fixture(),
    current: fixture_oid(hex: current_hex),
    relation: gunbc.fleet_main_revision.FleetRevisionRelationObservation {
      current: fixture_oid(hex: current_hex),
      accepted: fixture_oid(hex: fixture_candidate_hex),
      relation: relation,
    },
  }
}

// A candidate descending from the current ref is the advancing case, and the authorized action must carry BOTH
// operands: the revision to publish and the prior it expects. An action naming only the target is
// a blind overwrite wearing a compare-and-swap's name.
test fn a_descendant_candidate_authorizes_an_advance_carrying_the_observed_prior() -> Bool {
  match action_for(input: observed_input(current_hex: fixture_prior_hex, relation: gunbc.live_deploy.revision.DeployedIsAncestor)) {
    gunbc.fleet_desired_admission.AdmissionRefused { cause: _ } => false
    gunbc.fleet_desired_admission.AdmissionActionAuthorized { action: a } =>
      match a {
        gunbc.fleet_desired_admission.FleetDesiredRemoteAdvance { accepted: to, expected_prior: prior } =>
          (extdeps.git.object_store.git_object_id_wire_hex(oid: to) as String == fixture_candidate_hex)
            && (extdeps.git.object_store.git_object_id_wire_hex(oid: prior) as String == fixture_prior_hex)
        gunbc.fleet_desired_admission.FleetDesiredAlreadyConvergedAction { revision: _ } => false
        gunbc.fleet_desired_admission.FleetDesiredSupersededAction { accepted: _, current: _ } => false
      }
  }
}

// THE TWO NO-OP ARMS ARE AUTHORIZED, NOT REFUSED, and the distinction is the whole point of the
// action type: "the fleet is already where it should be" is a successful admission that mutates
// nothing, while a refusal means the gate could not decide. Collapsing them would make a healthy
// converged fleet report as a broken one on every floor run.
test fn an_already_converged_fleet_authorizes_a_no_op_rather_than_refusing() -> Bool {
  match action_for(input: observed_input(current_hex: fixture_candidate_hex, relation: gunbc.live_deploy.revision.SameRevision)) {
    gunbc.fleet_desired_admission.AdmissionRefused { cause: _ } => false
    gunbc.fleet_desired_admission.AdmissionActionAuthorized { action: a } =>
      match a {
        gunbc.fleet_desired_admission.FleetDesiredAlreadyConvergedAction { revision: r } =>
          extdeps.git.object_store.git_object_id_wire_hex(oid: r) as String == fixture_candidate_hex
        gunbc.fleet_desired_admission.FleetDesiredRemoteAdvance { accepted: _, expected_prior: _ } => false
        gunbc.fleet_desired_admission.FleetDesiredSupersededAction { accepted: _, current: _ } => false
      }
  }
}

// A superseded candidate must never roll the fleet backwards. The relation says the accepted
// revision is an ancestor of what the fleet already runs, so publishing it would be a rewind
// dressed as an advance.
test fn a_superseded_candidate_authorizes_a_no_op_and_never_an_advance() -> Bool {
  match action_for(input: observed_input(current_hex: fixture_candidate_hex, relation: gunbc.live_deploy.revision.CandidateIsAncestor)) {
    gunbc.fleet_desired_admission.AdmissionRefused { cause: _ } => false
    gunbc.fleet_desired_admission.AdmissionActionAuthorized { action: a } =>
      match a {
        gunbc.fleet_desired_admission.FleetDesiredSupersededAction { accepted: _, current: _ } => true
        gunbc.fleet_desired_admission.FleetDesiredRemoteAdvance { accepted: _, expected_prior: _ } => false
        gunbc.fleet_desired_admission.FleetDesiredAlreadyConvergedAction { revision: _ } => false
      }
  }
}

// THE EMPTY-OBSERVATION NARROW, AS A CLAIM. An unreadable prior must refuse, not be treated as an
// absent one -- the arm that would create the ref from scratch and overwrite an admitted revision
// nobody could read. The event is otherwise fully admitting, so this is discriminating.
test fn an_unobservable_prior_refuses_rather_than_authorizing_a_creation() -> Bool {
  match action_for(input: gunbc.fleet_main_revision.FleetDesiredExpectationRefusedInput {
    accepted: accepted_fixture(),
    cause: gunbc.fleet_main_revision.FleetDesiredRefUnobserved { cause: "ls-remote refused: network unreachable" },
  }) {
    gunbc.fleet_desired_admission.AdmissionActionAuthorized { action: _ } => false
    gunbc.fleet_desired_admission.AdmissionRefused { cause: c } => string_contains(s: c, pattern: "fleet_desired_admission: ")
  }
}

// AN ABSENT REF REFUSES, AND THIS ROW WAS INVERTED AND THEN INVERTED BACK WITHIN ONE DAY.
//
// The policy it asserts -- absence is a STATE, creation is a CAPABILITY, and no observation of
// absence can supply a mint authority -- is gunbc.fleet_main_revision's, authored deliberately
// under the title "creation is not implied by absence". gunbc#8746 landed the opposite policy on
// main four and a half hours later, so merging main here was a policy DIVERGENCE. I then flipped
// this row to assert creation, calling my own position an accidental regression. It was not, and
// the flip is reverted with the reasoning recorded rather than quietly undone.
//
// WHY THIS PARTICULAR ROW IS DANGEROUS IN BOTH DIRECTIONS, which is the reusable part: a witness
// about a capability that SHOULD NOT EXIST and a witness about one that WAS LOST look identical
// when red. Restoring the action greens either. Only the policy says which repair is correct --
// so this annotation states the policy, and a future red here is answered by reading it, not by
// making the row pass.
test fn an_absent_ref_refuses_because_creation_needs_a_mint_authority() -> Bool {
  match action_for(input: gunbc.fleet_main_revision.FleetDesiredRefAbsentInput { accepted: accepted_fixture() }) {
    gunbc.fleet_desired_admission.AdmissionActionAuthorized { action: _ } => false
    gunbc.fleet_desired_admission.AdmissionRefused { cause: c } => string_contains(s: c, pattern: "mint the fleet root")
  }
}

// ---------------------------------------------------------------------------------------------
// THE RENDERED ACTION.

// The authorized advance names the observed prior as the compare-and-swap expectation, so a
// concurrent admission refuses at the remote instead of overwriting.
test fn the_authorized_advance_carries_the_observed_prior_as_the_cas_expectation() -> Bool {
  let script = gunbc.fleet_desired_admission.fleet_desired_authorized_action_script(
    action: gunbc.fleet_desired_admission.FleetDesiredRemoteAdvance {
      accepted: fixture_oid(hex: fixture_candidate_hex),
      expected_prior: fixture_oid(hex: fixture_prior_hex),
    },
    judge_source_observed: fixture_oid(hex: fixture_judge_hex),
  ) as String
  string_contains(s: script, pattern: concat("--force-with-lease=refs/fleet/desired:", fixture_prior_hex))
    && string_contains(s: script, pattern: concat(fixture_candidate_hex, ":refs/fleet/desired"))
}

// THE RECEIPT MUST NAME THE EXPECTED PRIOR, NOT ONLY THE TARGET. The regression this guards
// shipped upstream as collateral of a correct change: when main's admitted decision widened from
// a prior oid to an expectation, the echo could no longer print `from` on the absent arm, and
// dropping it for BOTH arms was the path of least resistance. What actually happened stays
// recoverable from git's range line; what was EXPECTED then appeared nowhere in the run.
//
// This gate has one authorized action, so there is one arm to check -- and the check is the
// contiguous pattern rather than the two hexes separately, because a script naming both revisions
// in unrelated positions would satisfy a looser assertion while telling the reader nothing about
// which was expected. Found by nimble-fox-671.
test fn the_receipt_names_the_expected_prior_beside_the_target() -> Bool {
  let script = gunbc.fleet_desired_admission.fleet_desired_authorized_action_script(
    action: gunbc.fleet_desired_admission.FleetDesiredRemoteAdvance {
      accepted: fixture_oid(hex: fixture_candidate_hex),
      expected_prior: fixture_oid(hex: fixture_prior_hex),
    },
    judge_source_observed: fixture_oid(hex: fixture_judge_hex),
  ) as String
  string_contains(s: script, pattern: concat(concat("admitted ", fixture_candidate_hex), concat(" expected-prior ", fixture_prior_hex)))
}

// THE WALL THE EXECUTING STEP DEPENDS ON. `test -s` distinguishes "authorization produced
// nothing" -- a writer or transport failure -- from "authorization said do nothing". That
// distinction survives only while a no-op action renders a NONEMPTY script, and it must hold by
// the renderer's shape rather than by an author remembering to echo. These two rows are the
// discriminating half: if either no-op arm is ever simplified to an empty string, the executing
// step reads a dropped authorization as a converged fleet.
test fn a_no_op_action_still_renders_a_nonempty_script() -> Bool {
  let converged = gunbc.fleet_desired_admission.fleet_desired_authorized_action_script(
    action: gunbc.fleet_desired_admission.FleetDesiredAlreadyConvergedAction { revision: fixture_oid(hex: fixture_candidate_hex) },
    judge_source_observed: fixture_oid(hex: fixture_judge_hex),
  ) as String
  let superseded = gunbc.fleet_desired_admission.fleet_desired_authorized_action_script(
    action: gunbc.fleet_desired_admission.FleetDesiredSupersededAction {
      accepted: fixture_oid(hex: fixture_prior_hex),
      current: fixture_oid(hex: fixture_candidate_hex),
    },
    judge_source_observed: fixture_oid(hex: fixture_judge_hex),
  ) as String
  (string_length(s: converged) > 0) && (string_length(s: superseded) > 0)
}

// A no-op must mutate no ref. The renderer is the last place a stray push could be introduced,
// and the executing step runs whatever it produces without inspecting it.
test fn a_no_op_action_renders_no_ref_mutation() -> Bool {
  let converged = gunbc.fleet_desired_admission.fleet_desired_authorized_action_script(
    action: gunbc.fleet_desired_admission.FleetDesiredAlreadyConvergedAction { revision: fixture_oid(hex: fixture_candidate_hex) },
    judge_source_observed: fixture_oid(hex: fixture_judge_hex),
  ) as String
  let superseded = gunbc.fleet_desired_admission.fleet_desired_authorized_action_script(
    action: gunbc.fleet_desired_admission.FleetDesiredSupersededAction {
      accepted: fixture_oid(hex: fixture_prior_hex),
      current: fixture_oid(hex: fixture_candidate_hex),
    },
    judge_source_observed: fixture_oid(hex: fixture_judge_hex),
  ) as String
  !string_contains(s: converged, pattern: "git push")
    && !string_contains(s: superseded, pattern: "git push")
}

// THE EMISSION HALF. The pure decision above proves the gate decides correctly; it proves nothing
// about what the workflow actually runs, so these read the emitted bytes.
test fn the_admission_workflow_triggers_on_the_floor_workflow_completing() -> Bool {
  let yml = gunbc.fleet_desired_admission_workflow.expected_fleet_desired_yml()
  string_contains(s: yml, pattern: "workflow_run:")
    && string_contains(s: yml, pattern: gunbc.witness_floor_workflow.witness_floor_workflow_name)
    && string_contains(s: yml, pattern: "admit_fleet_desired_from_floor_event_wet")
}

// THE TRIGGER MUST FILTER ON THE BRANCH, NOT ONLY THE JOB. A workflow_run trigger naming no
// branches creates a run for EVERY branch's floor completion; each one enters the single constant
// concurrency group before the job-level condition can skip it, and in the default group an
// arriving entry evicts the pending one. So an unfiltered trigger lets an irrelevant branch cancel
// a pending admission for a green main revision and then do nothing -- the drop this row exists to
// keep closed. It reads the emitted bytes because the defect was in the emission, not the model:
// the branch was checked in two places that both ran too late.
test fn the_admission_workflow_filters_the_trigger_to_the_default_branch() -> Bool {
  let yml = gunbc.fleet_desired_admission_workflow.expected_fleet_desired_yml()
  let workflow_run_block = split(s: yml, delimiter: "workflow_run:").last()
  let trigger = split(s: workflow_run_block, delimiter: "jobs:").first()
  string_contains(s: trigger, pattern: "branches:")
    && string_contains(s: trigger, pattern: gunbc.repo_identity.gunbc_default_branch_name)
}

// MAIN-FLOOR COMPLETIONS ARE RETAINED FOR ADJUDICATION RATHER THAN PENDING-REPLACED, AND THE
// CLAIM IS BOUNDED BY THE PLATFORM'S QUEUE CAPACITY.
//
// The default concurrency group holds one running and one PENDING entry, and an arriving entry
// CANCELS the pending one -- so under it a green admission could be dropped by a later run that
// cannot advance (a red floor, a manual dispatch, an older rerun). The trigger filter cannot close
// that half: those all carry head_branch main, and whether they can advance is decided in-model,
// after the run exists. So the emitted mapping must carry `queue: max`.
//
// THIS ROW WAS NAMED `..._queues_every_admissible_completion_...` AND THAT WAS AN OVERCLAIM.
// GitHub documents the ceiling explicitly: "Up to 100 jobs or workflow runs can be `pending` in
// the concurrency group. When the queue is full, any additional jobs or workflow runs are
// canceled." (docs.github.com, workflow syntax, concurrency; read 2026-08-21.) So the honest claim
// is retention-instead-of-replacement WHILE THE GROUP SITS BELOW 100 PENDING -- not "every".
//
// The overclaim was not observable from the bytes this row reads, which is exactly why the NAME
// mattered: at 100 pending the mechanism cancels and this row still greens, because a queue depth
// is not a fact about an emitted mapping. A name is the claim the next reader inherits, and this
// one promised something the witness cannot witness.
//
// IF ABSOLUTE LOSSLESSNESS EVER BECOMES REQUIRED, THE NEXT RUNG IS NOT A BIGGER QUEUE. It is
// durable reconciliation over (eligible floor-green revisions MINUS recorded admission decisions).
// `queue: max` is a strong bounded transport, not an unbounded event ledger -- and it cannot buy
// ordering either, since GitHub processes pending entries by when they began waiting and does not
// guarantee order. Found by side-chat review, relayed by nimble-fox-671; the 100-entry cap and the
// cancel-when-full half were both verified against the documentation rather than taken on report.
//
// cancel-in-progress must ALSO be false, and it is a separate assertion rather than an implied
// one: it is what keeps a RUNNING admission from being interrupted between the compare-and-swap
// decision and the push, which is the one property the default group was genuinely providing.
test fn the_admission_workflow_uses_the_maximum_pending_queue_instead_of_pending_replacement() -> Bool {
  let yml = gunbc.fleet_desired_admission_workflow.expected_fleet_desired_yml()
  let concurrency = split(s: split(s: yml, delimiter: "concurrency:").last(), delimiter: "jobs:").first()
  string_contains(s: concurrency, pattern: "queue: max")
    && string_contains(s: concurrency, pattern: "cancel-in-progress: false")
}

// THE ACTUATION CARRIES NO DECISION. If the action step ever names the ref or a revision
// expression of its own, it has re-acquired the ability to push something the gate did not admit.
test fn the_admission_workflow_action_step_names_no_revision_of_its_own() -> Bool {
  let yml = gunbc.fleet_desired_admission_workflow.expected_fleet_desired_yml()
  string_contains(s: yml, pattern: gunbc.fleet_desired_admission.fleet_desired_admission_authorized_action_path)
    && !string_contains(s: yml, pattern: "GITHUB_SHA")
    && !string_contains(s: yml, pattern: "force-with-lease")
    && !string_contains(s: yml, pattern: "ls-remote")
}

// the_deploy_workflow_no_longer_advances_the_fleet_revision WAS HERE and is deleted, not
// relocated. It asserted that deploy.yml still ran the modeled apply while no longer mutating
// refs/fleet/desired -- a claim about a workflow that no longer exists, since the root cut
// deleted the deploy workflow authority outright. A claim whose subject is gone cannot be kept
// alive by repointing it at something else; that would be a witness named for one fact
// asserting another.
//
// The property it guarded is not lost, it is subsumed: a workflow that does not exist cannot
// advance the ref, and test.claim.deploy_workflow_retirement_witness asserts the retired path
// is absent from the committed artifact roster -- which is what stops the file being
// regenerated, and is strictly stronger than "the file exists but no longer pushes".
//
// Found by a dangling import after merging the root cut: this file had NO merge conflict, so
// git reported nothing. The enumeration has to be re-run after every refresh for exactly this
// reason -- the hazard was in a file neither side touched.

// WHAT THESE TWO CLAIMS ARE, STATED HONESTLY, because their first names asserted more than
// they establish. They are TEXTUAL PROJECTION SENTINELS over the emitted yaml, not proofs
// that a Cargo consumer is dominated by a Cargo provider.
//
// The motivating defect is real: deploy.yml invoked cargo on this same srv1 runner with no
// toolchain and never reached actuation on any observed run -- 30 runs between
// 2026-08-20T03:55:43Z and 2026-08-20T17:14:32Z, 29 failure and 1 cancelled, zero successes
// ever (dated receipt, not a live count). The actuator never once reached its own
// terminal step -- and this workflow builds on that runner too. Both claims were observed RED
// against a model with the toolchain step removed before being accepted green.
//
// But the predicate is `split(yml, "cargo build")`, and that has two unequal failure modes:
//
//   the literal spelling changes (for example to "$CARGO_BIN" build, which is exactly how
//   fleet-converge.yml already invokes cargo)  ->  first conjunct false  ->  RED.
//   A false alarm, but fail-CLOSED.
//
//   a second, non-literal invocation appears BEFORE the provider while a later literal one
//   remains  ->  .first() spans both the variable invocation and the provider  ->  PASS.
//   A false green, and fail-OPEN.
//
// Adding "$CARGO_BIN" to the match would not fix that; it would enlarge the set of spellings
// the search happens to recognise and move the hole one substitution along. A text search over
// emitted bytes cannot see what a step executes. That is the ceiling, not a gap in effort.
//
// RUNG: mitigatable. NEXT-RUNG TRIGGER: workflow capability closure -- a typed step operation
// deriving CargoCapability (the derivation already exists for validations in
// gunbc.roadmap_execution_contract) and a projection that refuses to emit a job whose derived
// capabilities are unclosed. The permanent control then becomes structural -- a Cargo operation
// with no dominating provider REFUSES -- which is invariant under every spelling above because
// it never inspects one. When that lands these two claims are deleted or demoted to a byte
// regression fixture for this particular yaml; they must not accumulate beside it as though
// both were safety mechanisms.
test fn the_emitted_admission_yaml_places_a_setup_action_before_its_literal_cargo_build() -> Bool {
  let yml = gunbc.fleet_desired_admission_workflow.expected_fleet_desired_yml()
  let before_cargo = split(s: yml, delimiter: "cargo build").first()
  string_contains(s: yml, pattern: "cargo build")
    && string_contains(s: before_cargo, pattern: "setup-rust-toolchain")
}

test fn the_emitted_admission_yaml_disables_the_shared_home_cache_on_its_setup_action() -> Bool {
  let yml = gunbc.fleet_desired_admission_workflow.expected_fleet_desired_yml()
  let after_toolchain = split(s: yml, delimiter: "setup-rust-toolchain").last()
  string_contains(s: after_toolchain, pattern: "cache: false")
}

// WHAT THIS FIELD IS, AND WHAT IT IS NOT. The receipt records the revision of the SOURCE TREE the
// admission checkout was sitting on, OBSERVED AFTER the authorized action was derived and BEFORE
// that action was materialized -- nothing stronger, and in particular not an atomic reading taken
// at the instant of adjudication. The wet entry point derives the action first and only then reads
// HEAD, so a tree mutated in between would be reported rather than the tree that actually decided;
// nothing in today's single-checkout job does that, which is a property of the CALLER again.
// It is NOT the revision of the binary that ran (nothing embeds that yet), NOT the candidate
// being admitted, and NOT the workflow transport identity that GITHUB_WORKFLOW_SHA carries.
// Those four coincide in today's workflow only because the job checks out one tree, builds the
// deciding binary from it in the same job, and adjudicates in that same checkout -- a property
// of the CALLER, not of this function. They diverge the moment the binary is pinned or prebuilt,
// which is exactly the cut this recording exists to make falsifiable. The field is named for the
// observation, not for the inference, so the later pinning work has something to contradict.
test fn the_advance_receipt_names_the_observed_judge_source_revision() -> Bool {
  let script = gunbc.fleet_desired_admission.fleet_desired_authorized_action_script(
    action: gunbc.fleet_desired_admission.FleetDesiredRemoteAdvance {
      accepted: fixture_oid(hex: fixture_candidate_hex),
      expected_prior: fixture_oid(hex: fixture_prior_hex),
    },
    judge_source_observed: fixture_oid(hex: fixture_judge_hex),
  ) as String
  string_contains(s: script, pattern: concat(" judge-source-observed ", fixture_judge_hex))
}

// PRESENCE BEFORE DISTINCTNESS, AND THE FIRST CONJUNCT IS NOT REDUNDANT. An earlier form of this
// row asserted only the two negations. Both are satisfied VACUOUSLY by deleting the operand
// altogether, so the row returned PASS against a receipt carrying no judge field at all while its
// sibling above returned FAIL -- a claim that could not fail for the reason it existed. Caught by
// a deliberately-emptied receipt, not by review.
test fn the_observed_judge_source_is_present_and_distinct_from_target_and_prior() -> Bool {
  let script = gunbc.fleet_desired_admission.fleet_desired_authorized_action_script(
    action: gunbc.fleet_desired_admission.FleetDesiredRemoteAdvance {
      accepted: fixture_oid(hex: fixture_candidate_hex),
      expected_prior: fixture_oid(hex: fixture_prior_hex),
    },
    judge_source_observed: fixture_oid(hex: fixture_judge_hex),
  ) as String
  string_contains(s: script, pattern: " judge-source-observed ")
    && !string_contains(s: script, pattern: concat(" judge-source-observed ", fixture_candidate_hex))
    && !string_contains(s: script, pattern: concat(" judge-source-observed ", fixture_prior_hex))
}

// A NO-OP IS ALSO AN ADJUDICATION. Both no-op arms carry the field too: "this source decided not
// to mutate" is exactly as attributable a decision as an advance, and recording it only on the
// mutating arm would leave the two most common outcomes unattributable.
test fn both_no_op_receipts_also_name_the_observed_judge_source() -> Bool {
  let converged = gunbc.fleet_desired_admission.fleet_desired_authorized_action_script(
    action: gunbc.fleet_desired_admission.FleetDesiredAlreadyConvergedAction { revision: fixture_oid(hex: fixture_candidate_hex) },
    judge_source_observed: fixture_oid(hex: fixture_judge_hex),
  ) as String
  let superseded = gunbc.fleet_desired_admission.fleet_desired_authorized_action_script(
    action: gunbc.fleet_desired_admission.FleetDesiredSupersededAction {
      accepted: fixture_oid(hex: fixture_prior_hex),
      current: fixture_oid(hex: fixture_candidate_hex),
    },
    judge_source_observed: fixture_oid(hex: fixture_judge_hex),
  ) as String
  string_contains(s: converged, pattern: concat(" judge-source-observed ", fixture_judge_hex))
    && string_contains(s: superseded, pattern: concat(" judge-source-observed ", fixture_judge_hex))
}

// THE REFUSAL NAMES THE FIELD IT COULD NOT FILL. An operator reading this line at 3am needs to
// know WHICH receipt field is missing, not merely that something was unobservable -- the string is
// the only artifact they get, because the process exits here. Naming `judge-source-observed`
// joins the failure to the receipt grammar the successful arms emit.
test fn the_unobservable_judge_source_refusal_names_the_field_it_could_not_record() -> Bool {
  let reason = gunbc.fleet_desired_admission.fleet_desired_unobservable_judge_source_refusal_reason()
  string_contains(s: reason, pattern: "judge-source-observed")
    && string_contains(s: reason, pattern: "could not be observed")
}

// AND IT CLAIMS NOTHING ABOUT THE BINARY. This row exists because the sentence outran the
// mechanism TWICE and execution caught neither time. It first said the run could not record
// "which code adjudicated" the advance; narrowed, it said "which source this run was running
// from". Both invite the reader to infer the provenance of the EXECUTING BINARY, which nothing
// here establishes -- the mechanism reads the admission checkout's HEAD after the action is
// derived and before it is materialized, and no binary embeds its own source revision.
//
// PRESENCE BEFORE ABSENCE, for the same reason the distinctness row upstream carries it: three
// bare negations are satisfied by a reason string that is empty, or that was deleted outright.
// The positive conjunct pins the subject so the negations have something to be true OF.
// Discriminating control: restore either older phrasing and this row goes red.
test fn the_unobservable_judge_source_refusal_claims_no_binary_provenance() -> Bool {
  let reason = gunbc.fleet_desired_admission.fleet_desired_unobservable_judge_source_refusal_reason()
  string_contains(s: reason, pattern: "after adjudication")
    && !string_contains(s: reason, pattern: "adjudicated from")
    && !string_contains(s: reason, pattern: "was running from")
    && !string_contains(s: reason, pattern: "which code")
}
