// ── the retired writers are gone ───────────────────────────────────────────────────────────────────────

data deleted_verification_receipt_writer_source: String = "module probe_r8\nimport std.types { String, NonEmptyStr }\nimport gunbc.roadmap.roadmap_verify { persist_verification_receipt }\nimport gunbc.roadmap.roadmap_dashboard_instance { HostDashboardInstance }\nimport gunbc.roadmap.roadmap_model { RoadmapNode }\nfn f(i: HostDashboardInstance, n: RoadmapNode) -> Int { match persist_verification_receipt(instance: i, node: n, receipt: \"{}\" as NonEmptyStr) { _ => 0 } }\n"

test fn the_legacy_verification_receipt_writer_is_gone() -> ProcessExit {
  census_verdict(census: missing_export(source: deleted_verification_receipt_writer_source, subject: "persist_verification_receipt"), holds: fn(n) { n == 1 })
}

// ── the lawful routes are admitted ─────────────────────────────────────────────────────────────────────

data lawful_view_preference_route_source: String = "module probe_g1\nimport std.types { NonEmptyStr, FilePath }\nimport gunbc.roadmap.roadmap_view_preference_store { issue_view_preference_store, issue_view_preference_read }\nimport gunbc.roadmap.roadmap_dashboard_instance { HostDashboardInstance, isolated_dashboard_instance, DashboardActuating, DashboardLocalProvision }\nimport gunbc.host.host_layout { srv1_host_layout }\nimport gunbc.deployment_risk { deployment_id }\nfn f() -> Int {\n  let i = isolated_dashboard_instance(deployment: deployment_id(name: \"witness\" as NonEmptyStr), instance_id: \"witness\" as NonEmptyStr, layout: srv1_host_layout(), root: \"/tmp/witness\" as FilePath, serve_function: \"roadmap_serve_handle_srv1_lab\" as NonEmptyStr, listen_port: 18097, source_anchor_ref: \"refs/heads/main\" as NonEmptyStr, actuation: DashboardActuating, provision_transport: DashboardLocalProvision)\n  match issue_view_preference_store(instance: i) {\n    IssueViewPreferenceStoreReady { store } => match issue_view_preference_read(store: store, key: "v0" as NonEmptyStr) { _ => 0 }\n    IssueViewPreferenceStoreUnready { detail: _ } => 2\n  }\n}\n"

data lawful_census_route_source: String = "module probe_g2\nimport std.types { NonEmptyStr, FilePath, String }\nimport gunbc.roadmap.roadmap_event_snapshot_census { snapshot_census_receipt_store, snapshot_census_receipt_content, SnapshotCensusReceiptStoreReady, SnapshotCensusReceiptStoreUnready, SnapshotCensusReceiptContent }\nimport gunbc.roadmap.roadmap_dashboard_instance { isolated_dashboard_instance, DashboardActuating, DashboardLocalProvision }\nimport gunbc.host.host_layout { srv1_host_layout }\nimport gunbc.deployment_risk { deployment_id }\nfn f() -> Int {\n  let i = isolated_dashboard_instance(deployment: deployment_id(name: \"witness2\" as NonEmptyStr), instance_id: \"witness2\" as NonEmptyStr, layout: srv1_host_layout(), root: \"/tmp/witness2\" as FilePath, serve_function: \"roadmap_serve_handle_srv1_lab\" as NonEmptyStr, listen_port: 18098, source_anchor_ref: \"refs/heads/main\" as NonEmptyStr, actuation: DashboardActuating, provision_transport: DashboardLocalProvision)\n  match snapshot_census_receipt_store(instance: i) {\n    SnapshotCensusReceiptStoreReady { store } => match snapshot_census_receipt_content(store: store) { _ => 0 }\n    SnapshotCensusReceiptStoreUnready { detail: _ } => 1\n  }\n}\n"

test fn the_lawful_view_preference_route_is_admitted() -> ProcessExit {
  census_verdict_all(verdicts: [
    blocking_delta(hostile: lawful_view_preference_route_source, safe: closure_baseline_source, holds: fn(n) { n <= 0 }),
    census_verdict(census: seal_violations(source: lawful_view_preference_route_source, subject: "IssueViewPreferenceStore"), holds: fn(n) { n == 0 }),
  ])
}

test fn the_lawful_census_receipt_route_is_admitted() -> ProcessExit {
  census_verdict_all(verdicts: [
    blocking_delta(hostile: lawful_census_route_source, safe: closure_baseline_source, holds: fn(n) { n <= 0 }),
    census_verdict(census: seal_violations(source: lawful_census_route_source, subject: "SnapshotCensusReceiptStore"), holds: fn(n) { n == 0 }),
  ])
}
