module test.claim.tool_pin_witness

import std.types { NonEmptyStr, String, Bool, Int, ContentHash }
import extdeps.version { VersionIdentity, VersionConstraint }
import extdeps.tools { CliTool, SourceApt }
import extdeps.pin {
  Pin,
  PinSelection,
  ExactPin,
  TrackedChannel,
  CurrencyGap,
  AuthoredPinHasNoReviewDate,
  TrackedPinHasNoResolutionDate,
  PinAdmission,
  PinIntegrityAdmitted,
  PinRefused,
  PinRefusalCause,
  ConstraintIsNotIdentity,
  PinAbsent,
  TrackedResolutionUnrecorded,
  ObservedIdentityMismatch,
  pin_currency_gap,
  admit_pin_integrity,
  pin_value_eq,
}
import extdeps.tools.pin { admit_legacy_cli_tool, cli_tool_pin_key_of }
import extdeps.container.oci.descriptor { OciDescriptor }
import extdeps.container.oci.types { OciMediaType, OciImageLayerV1TarGzip }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data cargo_identity: ContentHash = "sha256-cargo-1930-aarch64" as ContentHash
data other_identity: ContentHash = "sha256-cargo-1920-aarch64" as ContentHash

data cargo_tool: CliTool = CliTool {
  name: "cargo",
  min_version: Absent,
  installable_via: [SourceApt],
}

data jq_tool: CliTool = CliTool {
  name: "jq",
  min_version: Absent,
  installable_via: [SourceApt],
}

data authored_pin: Pin<CliTool> = Pin {
  subject: cargo_tool,
  version: "1.93.0" as VersionIdentity,
  expected_identity: cargo_identity,
  selection: ExactPin,
}

data tracked_pin: Pin<CliTool> = Pin {
  subject: jq_tool,
  version: "1.7.1" as VersionIdentity,
  expected_identity: cargo_identity,
  selection: TrackedChannel {
    channel: "latest",
    refresh_window_days: 30,
  },
}

data currency_family_note: String = "Currency family, REWRITTEN after review 44274 found that ExactPin returned PinFresh unconditionally — a fabricated positive. Authorship proves reproducibility, not currency: an exact pin authored three years ago is exactly as reproducible and exactly as rotten. pin_currency_gap is now TOTAL and never returns a positive verdict for either variant. RED CONTROLS are the two below: each fails if its variant ever reports anything other than a named gap, which is exactly the 'pinned and never updated' silence the refresh axis exists to break."

test fn exact_pin_currency_is_an_unfilled_gap() -> Bool {
  match pin_currency_gap(pin: authored_pin) {
    AuthoredPinHasNoReviewDate => true
    TrackedPinHasNoResolutionDate { channel: _ } => false
  }
}

test fn tracked_pin_currency_is_an_unfilled_gap() -> Bool {
  match pin_currency_gap(pin: tracked_pin) {
    TrackedPinHasNoResolutionDate { channel: c } => (c as String) == "latest"
    AuthoredPinHasNoReviewDate => false
  }
}

data integrity_family_note: String = "Integrity family: admission establishes ONLY that the observed binary is the one the pin declares, and is named admit_pin_integrity so it cannot be misread as a currency verdict (review 44274). RED CONTROL mismatched_identity_refuses covers what a location-based resolver cannot see at all — it finds 'a cargo' at the declared version and proceeds, where digest comparison refuses. RED CONTROL tracked_pin_refuses_even_when_identity_matches is the standing regression control for review 44242: a tracked pin whose observed digest matches EXACTLY is still refused, because its expected_identity was resolved from a moving reference with no record of that resolution."

test fn matching_identity_admits_integrity() -> Bool {
  match admit_pin_integrity(pin: authored_pin, observed_identity: cargo_identity) {
    PinIntegrityAdmitted { pin: p } => (p.subject.name as String) == "cargo"
    PinRefused { subject: _, cause: _ } => false
  }
}

test fn mismatched_identity_refuses() -> Bool {
  match admit_pin_integrity(pin: authored_pin, observed_identity: other_identity) {
    PinRefused { subject: subj, cause: c } =>
      ((subj.name as String) == "cargo") && match c {
        ObservedIdentityMismatch { expected: e, observed: o } =>
          (e == cargo_identity) && (o == other_identity)
        ConstraintIsNotIdentity { constraint: _ } => false
        PinAbsent => false
        TrackedResolutionUnrecorded { channel: _ } => false
      }
    PinIntegrityAdmitted { pin: _ } => false
  }
}

test fn tracked_pin_refuses_even_when_identity_matches() -> Bool {
  match admit_pin_integrity(pin: tracked_pin, observed_identity: cargo_identity) {
    PinRefused { subject: subj, cause: c } =>
      ((subj.name as String) == "jq") && match c {
        TrackedResolutionUnrecorded { channel: ch } => (ch as String) == "latest"
        ObservedIdentityMismatch { expected: _, observed: _ } => false
        ConstraintIsNotIdentity { constraint: _ } => false
        PinAbsent => false
      }
    PinIntegrityAdmitted { pin: _ } => false
  }
}

data legacy_ranged_tool: CliTool = CliTool {
  name: "curl",
  min_version: Present { value: ">= 7.68" as VersionConstraint },
  installable_via: [SourceApt { package: "curl" }],
}

data legacy_unversioned_tool: CliTool = CliTool {
  name: "jq",
  min_version: Absent,
  installable_via: [SourceApt { package: "jq" }],
}

data legacy_ingest_family_note: String = "Migration-frontier family, and the load-bearing RED for P1: EVERY CliTool row in the corpus today refuses conversion, which is the correct answer rather than a gap. ranged_legacy_tool_refuses_as_not_an_identity fails if a range is silently promoted to an identity — two hosts satisfying '>= 7.68' run different binaries, exactly the variance a pin removes, so widening here would be the absorbing fallback DESIGN section 5 forbids. unversioned_legacy_tool_refuses_as_absent keeps 'no version stated' a DISTINCT cause from 'a range stated'; collapsing the two would be a state-space conflation and would hide which deficit a given row actually has."

test fn ranged_legacy_tool_refuses_as_not_an_identity() -> Bool {
  match admit_legacy_cli_tool(tool: legacy_ranged_tool) {
    PinRefused { subject: subj, cause: c } =>
      ((subj.name as String) == "curl") && match c {
        ConstraintIsNotIdentity { constraint: k } => (k as String) == ">= 7.68"
        PinAbsent => false
        TrackedResolutionUnrecorded { channel: _ } => false
        ObservedIdentityMismatch { expected: _, observed: _ } => false
      }
    PinIntegrityAdmitted { pin: _ } => false
  }
}

test fn unversioned_legacy_tool_refuses_as_absent() -> Bool {
  match admit_legacy_cli_tool(tool: legacy_unversioned_tool) {
    PinRefused { subject: subj, cause: c } =>
      ((subj.name as String) == "jq") && match c {
        PinAbsent => true
        ConstraintIsNotIdentity { constraint: _ } => false
        TrackedResolutionUnrecorded { channel: _ } => false
        ObservedIdentityMismatch { expected: _, observed: _ } => false
      }
    PinIntegrityAdmitted { pin: _ } => false
  }
}

data reconcile_bundle_family_note: String = "The (key_of, value_eq) bundle P2 hands to gunbc.membership_reconcile. key_is_identity_so_a_version_bump_is_a_modify pins the identity-vs-content split that spine's authority note requires: the key stays the tool name across a version bump, so the hunk is Modified and the ensure re-upserts in place rather than tearing the tool down and reinstalling it. RED CONTROL value_eq_covers_digest_not_only_version fails if value_eq compares only the version string — a rebuilt binary at the same declared version would then compare equal and the ensure would never re-upsert, which is the exact silent-staleness this lane exists to close."

test fn key_is_identity_so_a_version_bump_is_a_modify() -> Bool {
  let bumped = Pin {
    subject: cargo_tool,
    version: "1.94.0" as VersionIdentity,
    expected_identity: other_identity,
    selection: ExactPin,
  }
  ((cli_tool_pin_key_of(pin: authored_pin) as String) == (cli_tool_pin_key_of(pin: bumped) as String))
    && !pin_value_eq(a: authored_pin, b: bumped)
}

test fn value_eq_covers_digest_not_only_version() -> Bool {
  let same_version_new_binary = Pin {
    subject: cargo_tool,
    version: "1.93.0" as VersionIdentity,
    expected_identity: other_identity,
    selection: ExactPin,
  }
  !pin_value_eq(a: authored_pin, b: same_version_new_binary)
}

data selection_is_reconcile_content_note: String = "Added after review 44329, which found pin_value_eq comparing only version and expected_identity while ignoring selection. That was a real reconcile gap, not a style point: membership_reconcile treats value_eq as presence-plus-content, so a pin whose refresh POLICY changed — ExactPin flipped to TrackedChannel, a different channel, a different window — produced no Modified hunk and would never re-upsert. The refresh policy is exactly the content this lane exists to carry, so omitting it from equality silently exempted the feature from reconciliation. RED CONTROLS below cover all three shapes of that change; each fails if value_eq ignores selection again."

test fn value_eq_detects_exact_to_tracked_flip() -> Bool {
  let flipped = Pin {
    subject: cargo_tool,
    version: "1.93.0" as VersionIdentity,
    expected_identity: cargo_identity,
    selection: TrackedChannel { channel: "stable", refresh_window_days: 30 },
  }
  !pin_value_eq(a: authored_pin, b: flipped)
}

test fn value_eq_detects_channel_change() -> Bool {
  let other_channel = Pin {
    subject: jq_tool,
    version: "1.7.1" as VersionIdentity,
    expected_identity: cargo_identity,
    selection: TrackedChannel { channel: "beta", refresh_window_days: 30 },
  }
  !pin_value_eq(a: tracked_pin, b: other_channel)
}

test fn value_eq_detects_refresh_window_change() -> Bool {
  let wider_window = Pin {
    subject: jq_tool,
    version: "1.7.1" as VersionIdentity,
    expected_identity: cargo_identity,
    selection: TrackedChannel { channel: "latest", refresh_window_days: 90 },
  }
  !pin_value_eq(a: tracked_pin, b: wider_window)
}

test fn value_eq_still_holds_for_identical_pins() -> Bool {
  let same = Pin {
    subject: jq_tool,
    version: "1.7.1" as VersionIdentity,
    expected_identity: cargo_identity,
    selection: TrackedChannel { channel: "latest", refresh_window_days: 30 },
  }
  pin_value_eq(a: tracked_pin, b: same)
    && (tracked_pin.selection == same.selection)
}

data pin_composes_over_a_second_subject_note: String = "THE DISCRIMINATING EVIDENCE that Pin is a DIMENSION and not a renamed ToolPin (operator, 2026-07-29). A generic type proves nothing by existing — it earns the claim only when a structurally DIFFERENT subject instantiates it with zero edits to the dimension. OciDescriptor is that subject and it is deliberately unlike CliTool: no name field, NO VERSION FIELD AT ALL, and its own mediaType and size instead. It instantiates Pin, pin_value_eq, and admit_pin_integrity unchanged — extdeps.pin was not touched to admit it. Under the old ToolPin shape this was unrepresentable: the carrier demanded a tool_name string, so a descriptor with no name would have been given a fabricated one or a second pin type would have been minted, which is exactly the N-types-for-one-axis failure the re-model removes. That the subject carries no version while the PIN carries one is the point rather than a gap: the version is the pin's own declared fact, not a projection of the subject, so the dimension supplies it for subjects that have none."

data pin_second_subject_soundness_note: String = "review 44662, and the reviewer was right twice about my first attempt. The original second-subject proof instantiated Pin<SccacheBinaryRelease>, which was unsound in two independent ways. (1) GRAIN: one SccacheBinaryRelease carries TWO architecture-specific digests while Pin carries ONE expected_identity, so the model could associate either artifact's digest with the undifferentiated release — an ambiguous substrate state. I had recorded that as a tracked dissolve-on and treated the deferral as sufficient; it is not, and the reason is specific to what this witness IS. A trigger-only deferral is a legitimate way to carry a known gap on a PRODUCTION row, but this row's entire job is to PROVE the dimension composes, and a proof built on an ambiguous instantiation demonstrates ambiguity rather than composition. (2) PARALLEL AUTHORITY: it re-minted the aarch64 hex already owned by dag/extdeps/cache/sccache.dag and re-spelled the release version as a second literal, so two independent copies of one fact could drift — the consume-never-fork violation this whole lane exists to remove, committed inside the witness meant to demonstrate the lane. Both are fixed by CHOOSING A SOUND SUBJECT rather than defending the unsound one: OciDescriptor describes exactly ONE blob by construction, so the grain question cannot arise, and it carries digest: ContentHash natively, so expected_identity is DERIVED from the subject below rather than copied — one fact, one home. It also sidesteps a real fork rather than papering over it: extdeps.crypto.hash.Digest and std.types.ContentHash are two digest concepts in this corpus, and the sccache route would have needed a conversion between them, which is exactly where the fork would have been laundered into this witness. That fork is recorded as an unfixed section 3 candidate belonging to no lane here."

data multi_artifact_pin_grain_finding_note: String = "A REAL FINDING kept even though its specimen is no longer instantiated above — the observation stands on the corpus, not on the witness. extdeps.cache.sccache SccacheBinaryRelease carries TWO digests because one release publishes two artifacts, while Pin.expected_identity is one ContentHash. So for multi-artifact subjects the pin subject is the ARTIFACT (release x platform), NOT the release, and any future Pin over such a subject must model that product first. This is precisely why sccache was rejected as the second-consumer proof (review 44662) rather than pinned with a declared caveat. dissolve-on: feature:pin-artifact-grain — a release x platform artifact projection exists at its own authority, at which point Pin over an sccache artifact becomes sound and this note deletes."

data oci_layer_descriptor: OciDescriptor = OciDescriptor {
  mediaType: OciImageLayerV1TarGzip
  digest: "sha256:5b0bcabd1ed22e9fb1310cf6c2dec7cdef19f0ad69efa1f392e94a4333501270" as ContentHash
  size: 32654
}

data oci_descriptor_pin: Pin<OciDescriptor> = Pin {
  subject: oci_layer_descriptor,
  version: "1.0.0" as VersionIdentity,
  expected_identity: oci_layer_descriptor.digest,
  selection: ExactPin,
}

test fn pin_composes_over_a_structurally_different_subject() -> Bool {
  match admit_pin_integrity(
    pin: oci_descriptor_pin,
    observed_identity: oci_layer_descriptor.digest,
  ) {
    PinIntegrityAdmitted { pin: p } => p.subject.size == 32654
    PinRefused { subject: _, cause: _ } => false
  }
}

test fn second_subject_expected_identity_is_derived_not_reminted() -> Bool {
  (oci_descriptor_pin.expected_identity as String) == (oci_layer_descriptor.digest as String)
}

test fn second_subject_refuses_on_digest_mismatch_too() -> Bool {
  match admit_pin_integrity(pin: oci_descriptor_pin, observed_identity: other_identity) {
    PinIntegrityAdmitted { pin: _ } => false
    PinRefused { subject: subj, cause: c } =>
      (subj.size == 32654)
        && match c {
             ObservedIdentityMismatch { expected: e, observed: o } =>
               ((e as String) == (oci_layer_descriptor.digest as String))
                 && ((o as String) == (other_identity as String))
             ConstraintIsNotIdentity { constraint: _ } => false
             PinAbsent => false
             TrackedResolutionUnrecorded { channel: _ } => false
           }
  }
}
