module test.claim.markdown_source_emit
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.markdown {
  MarkdownDocument, MarkdownInline, MarkdownBlock, MarkdownListItem, MarkdownTaskItem,
  MarkdownTableCell, MarkdownTableRow, HeadingLevel,
  H1, H2, H3, H4, H5, H6,
  HeadingBlock, ParagraphBlock, UnorderedListBlock, OrderedListBlock, TaskListBlock,
  CodeBlock, CodeText, CodeSymbolRef, SymbolRefInline, BlockquoteBlock, TableBlock,
  TextInline, EmphasisInline, StrongInline, CodeInline, LinkInline, ImageInline,
  CheckboxState, Checked, Unchecked,
  MarkdownAlignment, AlignNone, AlignLeft, AlignCenter, AlignRight,
}
import std.decl_ref { DeclarationSymbol, ModuleSymbol, ModuleIdentity, decl_ref, decl_field_ref, decl_type_parameter_ref }
import extdeps.languages.markdown {
  MarkdownSpellings, commonmark_gfm_spellings,
  ingest_markdown_source, ingest_markdown_source_with,
  serialize_markdown_source, serialize_markdown_source_with,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn sample_doc() -> MarkdownDocument {
  MarkdownDocument {
    blocks: [
      HeadingBlock { level: H1, inlines: [ TextInline { text: "Roadmap" } ] },
      ParagraphBlock {
        inlines: [
          TextInline { text: "See " },
          LinkInline {
            inlines: [ TextInline { text: "plan" } ],
            url: "docs/plan.md",
          },
          TextInline { text: "." },
        ],
      },
      TaskListBlock {
        items: [
          MarkdownTaskItem {
            state: Checked,
            blocks: [ ParagraphBlock { inlines: [ TextInline { text: "done item" } ] } ],
          },
          MarkdownTaskItem {
            state: Unchecked,
            blocks: [
              ParagraphBlock { inlines: [ TextInline { text: "todo item" } ] },
              UnorderedListBlock {
                items: [
                  MarkdownListItem {
                    blocks: [ ParagraphBlock { inlines: [ TextInline { text: "subnote" } ] } ],
                  },
                ],
              },
            ],
          },
        ],
      },
      UnorderedListBlock {
        items: [
          MarkdownListItem {
            blocks: [
              ParagraphBlock {
                inlines: [
                  StrongInline { inlines: [ TextInline { text: "bold" } ] },
                  TextInline { text: " and " },
                  EmphasisInline { inlines: [ TextInline { text: "italic" } ] },
                ],
              },
            ],
          },
        ],
      },
      OrderedListBlock {
        items: [
          MarkdownListItem { blocks: [ ParagraphBlock { inlines: [ TextInline { text: "one" } ] } ] },
          MarkdownListItem { blocks: [ ParagraphBlock { inlines: [ TextInline { text: "two" } ] } ] },
        ],
      },
      CodeBlock { segments: [CodeText { text: "let x = 1;\n" }] },
      TableBlock {
        header: MarkdownTableRow {
          cells: [
            MarkdownTableCell { inlines: [ TextInline { text: "h1" } ] },
            MarkdownTableCell { inlines: [ TextInline { text: "h2" } ] },
          ],
        },
        alignments: [ AlignNone, AlignCenter ],
        rows: [
          MarkdownTableRow {
            cells: [
              MarkdownTableCell { inlines: [ TextInline { text: "a" } ] },
              MarkdownTableCell { inlines: [ TextInline { text: "b" } ] },
            ],
          },
        ],
      },
      BlockquoteBlock {
        blocks: [
          ParagraphBlock {
            inlines: [
              TextInline { text: "quote " },
              CodeInline { text: "code" },
            ],
          },
        ],
      },
    ],
  }
}

fn expected_markdown() -> String {
  join([
    "# Roadmap\n",
    "\n",
    "See [plan](docs/plan.md).\n",
    "\n",
    "- [x] done item\n",
    "- [ ] todo item\n",
    "  - subnote\n",
    "\n",
    "- **bold** and *italic*\n",
    "\n",
    "1. one\n",
    "2. two\n",
    "\n",
    "```\n",
    "let x = 1;\n",
    "```\n",
    "\n",
    "| h1 | h2 |\n",
    "| --- | :-: |\n",
    "| a | b |\n",
    "\n",
    "> quote `code`\n"
  ], "")
}

test fn witness_exact_bytes() -> Bool {
  serialize_markdown_source(doc: sample_doc()) == expected_markdown()
}

fn code_only_doc(code: String) -> MarkdownDocument {
  MarkdownDocument { blocks: [ CodeBlock { segments: [CodeText { text: code }] } ] }
}

test fn witness_code_block_closing_fence_on_own_line() -> Bool {
  let no_nl = serialize_markdown_source(doc: code_only_doc(code: "let x = 1;"))
  let with_nl = serialize_markdown_source(doc: code_only_doc(code: "let x = 1;\n"))
  (no_nl == "```\nlet x = 1;\n```\n") && (no_nl == with_nl)
}

fn perturbed_bullet_spellings() -> MarkdownSpellings {
  MarkdownSpellings {
    heading_marker: commonmark_gfm_spellings.heading_marker,
    heading_sep: commonmark_gfm_spellings.heading_sep,
    unordered_bullet: "+ ",
    ordered_suffix: commonmark_gfm_spellings.ordered_suffix,
    task_checked: commonmark_gfm_spellings.task_checked,
    task_unchecked: commonmark_gfm_spellings.task_unchecked,
    emphasis_delim: commonmark_gfm_spellings.emphasis_delim,
    strong_delim: commonmark_gfm_spellings.strong_delim,
    code_span_delim: commonmark_gfm_spellings.code_span_delim,
    code_fence: commonmark_gfm_spellings.code_fence,
    link_text_open: commonmark_gfm_spellings.link_text_open,
    link_text_close: commonmark_gfm_spellings.link_text_close,
    link_url_open: commonmark_gfm_spellings.link_url_open,
    link_url_close: commonmark_gfm_spellings.link_url_close,
    image_marker: commonmark_gfm_spellings.image_marker,
    table_pipe: commonmark_gfm_spellings.table_pipe,
    table_cell_pad: commonmark_gfm_spellings.table_cell_pad,
    table_align_none: commonmark_gfm_spellings.table_align_none,
    table_align_left: commonmark_gfm_spellings.table_align_left,
    table_align_center: commonmark_gfm_spellings.table_align_center,
    table_align_right: commonmark_gfm_spellings.table_align_right,
    blockquote_marker: commonmark_gfm_spellings.blockquote_marker,
    list_indent: commonmark_gfm_spellings.list_indent,
    block_separator: commonmark_gfm_spellings.block_separator,
    thematic_break: commonmark_gfm_spellings.thematic_break,
  }
}

fn tiny_list_doc() -> MarkdownDocument {
  MarkdownDocument {
    blocks: [
      UnorderedListBlock {
        items: [
          MarkdownListItem { blocks: [ ParagraphBlock { inlines: [ TextInline { text: "x" } ] } ] },
        ],
      },
    ],
  }
}

test fn witness_row_driven_bullet() -> Bool {
  let canonical = serialize_markdown_source_with(doc: tiny_list_doc(), sp: commonmark_gfm_spellings)
  let perturbed = serialize_markdown_source_with(doc: tiny_list_doc(), sp: perturbed_bullet_spellings())
  (canonical == "- x\n") && (perturbed == "+ x\n") && !(canonical == perturbed)
}

// A CITED SYMBOL IS SERIALIZED AS A CODE SPAN OF ITS ONE CANONICAL SPELLING, so typing a citation that
// was hand-spelled in the spaced form changes no byte of a projected document. Each arm of CitedSymbol
// (module; declaration; declaration field) is compared with the CodeInline the author used to write,
// in a paragraph and inside a code block, and the field arm's spelling is asserted literally so a
// renderer that dropped the field would not compare equal to itself.
fn one_paragraph(inlines: List<MarkdownInline>) -> String {
  serialize_markdown_source(doc: MarkdownDocument { blocks: [ParagraphBlock { inlines: inlines }] })
}

test fn witness_symbol_ref_serializes_as_its_canonical_code_span() -> Bool {
  one_paragraph(inlines: [TextInline { text: "see " }, SymbolRefInline { symbol: ModuleSymbol { module: ModuleIdentity { name: "std.markdown" } } }])
    == one_paragraph(inlines: [TextInline { text: "see " }, CodeInline { text: "std.markdown" }])
  && one_paragraph(inlines: [SymbolRefInline { symbol: DeclarationSymbol { reference: decl_ref(module_path: "std.markdown", decl_name: "CodeBlock") } }])
    == one_paragraph(inlines: [CodeInline { text: "std.markdown CodeBlock" }])
  && one_paragraph(inlines: [SymbolRefInline { symbol: DeclarationSymbol { reference: decl_field_ref(module_path: "std.markdown", decl_name: "CodeText", field_name: "text") } }])
    == "`std.markdown CodeText.text`\n"
}

test fn witness_code_symbol_ref_serializes_as_its_canonical_spelling() -> Bool {
  serialize_markdown_source(doc: MarkdownDocument { blocks: [CodeBlock { segments: [CodeText { text: "x // " }, CodeSymbolRef { symbol: DeclarationSymbol { reference: decl_ref(module_path: "std.markdown", decl_name: "CodeBlock") } }, CodeText { text: "\n" }] }] })
    == serialize_markdown_source(doc: code_only_doc(code: "x // std.markdown CodeBlock\n"))
}

// A FIELD AND A TYPE PARAMETER ARE DIFFERENT COMPONENTS OF A DECLARATION, so they must not render in
// one form (a dot for a field, angle brackets for a type parameter): the typed carrier distinguishes them, and a renderer that collapsed them would make a
// reader unable to tell which one a document names.
test fn witness_field_and_type_parameter_citations_render_distinctly() -> Bool {
  let field = one_paragraph(inlines: [SymbolRefInline { symbol: DeclarationSymbol { reference: decl_field_ref(module_path: "std.decl_ref", decl_name: "ModuleIdentity", field_name: "name") } }])
  let parameter = one_paragraph(inlines: [SymbolRefInline { symbol: DeclarationSymbol { reference: decl_type_parameter_ref(module_path: "std.optional", decl_name: "Optional", parameter: "T") } }])
  field == "`std.decl_ref ModuleIdentity.name`\n" && parameter == "`std.optional Optional<T>`\n"
}
