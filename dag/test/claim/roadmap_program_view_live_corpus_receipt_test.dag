module test.claim.roadmap_program_view_live_corpus_receipt

import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import gunbc.roadmap_program_view {
  V1ProgramViewResult, ProgramViewDerived, ProgramViewRefused, v1_program_view,
  v1_convergence_fronts,
}
import gunbc.v1_deletion_plan { v1_exit_finish_lines }
import gunbc.roadmap_authority {
  declared_roadmap_nodes, declared_roadmap_edges, roadmap_acceptance_receipts,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data live_corpus_receipt_note: String = "LIVE-CORPUS OBSERVATION RECEIPT (operator verdict 2026-08-05, PR #7822): ONE integration receipt proving the live roadmap authority projects through gunbc.roadmap_program_view — every authored finish line and front gate resolves against declared nodes and the projection derives rather than refusing. This is NOT an ordinary business witness: it exercises the full live authority closure (declared_roadmap_nodes, declared_roadmap_edges, roadmap_acceptance_receipts) and remains expensive (~430-490ms measured on claim_batch) because it proves real wiring, not fixture algebra. Scheduled on the falsifier substrate long lane (gunbc.ci_layer_roots falsifier_substrate_long_lane_rows), excluded from per-PR discovery. Business-logic properties — acceptance algebra, dependency hold, duplicate refusal, constraint tie-break — live in test.claim.roadmap_program_view_witness on planted fixtures only."

test fn live_roadmap_program_view_corpus_projection_receipt() -> Bool {
  match v1_program_view(
    nodes: declared_roadmap_nodes(),
    edges: declared_roadmap_edges(),
    receipts: roadmap_acceptance_receipts(),
    in_flight: [],
  ) {
    ProgramViewDerived { view } =>
      count(view.finish_lines) == 4 && count(view.fronts) == 5
    ProgramViewRefused { causes: _ } => false
  }
}
