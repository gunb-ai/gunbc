module test.claim.fleet_observation_seal

import gunbc.compile_census_probe { blocking_subject_count_for }
import std.types { String, Bool, Int }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// THE DISCRIMINATING REDS FOR THE ACQUISITION SEALS, ENROLLED RATHER THAN RUN ONCE.
//
// gunbc.fleet_observation_capture_chunk and gunbc.fleet_observation_observation_envelope claim that
// four values cannot be SPELLED outside their owning modules: the durable-commit proof, the
// continuity reach, the committed chunk, and the silence proof that the one dangerous arm of
// SourceByteFact must carry. Those refusals were measured once, by hand, in scratch files that were
// then deleted -- so the annotations asserting them were TRANSCRIBED OUTPUT, which DESIGN section 6
// forbids and which section 4b(4) says decays the moment nobody re-runs it. Nothing would have gone
// red if a sole_constructor were later removed. This file is that evidence, enrolled.
//
// COUNTS ARE KEYED (class, subject_name, blocking) AND NEVER BY CLASS ALONE. gunbc.compile_diagnostic_census
// states that CensusObserved carries every diagnostic the compile produced, THE IMPORTED CLOSURE
// INCLUDED -- so a class-only count over a fixture that imports production modules can be satisfied by
// an unrelated refusal elsewhere in the closure, and a class-only zero is a property of the corpus
// rather than of the probe. Each probe below names its own subject.
//
// EXACTLY ONE refusal is the proposition in each case, so each assertion says one. `>= 1` would hide a
// second, unintended refusal on the same key and let a probe pass for the wrong reason.
//
// WHY THE SEALS ARE ON RECORDS AND NOT ON THE SUMS: sole_constructor on a COPRODUCT does not refuse
// cross-module variant construction -- the declared hole measured by
// test.claim.sole_constructor_completeness_audit_probe f13_variant_construction_refuses, which is red.
// Sealing SourceByteFact or LocalCommitStanding directly would have been permanently green by
// construction, which is worse than absent. The records the arms CARRY are the form the wall refuses.
//
// WHAT THESE PROBES DO NOT ESTABLISH, stated here so the file cannot be cited for more than it shows:
// they establish that the arms cannot be SPELLED. They say nothing about whether the arms can be
// OBTAINED through an admitted mint whose own input is caller-authored -- which they can, because
// std.durable_compare_and_set leaves CasSlotVersion unsealed. That is the open half of the rung split
// recorded at gunbc.fleet_observation_capture_chunk, and it is a different proposition.
// THE COUNT COMES FROM THE DECLARED HOME, NOT FROM A LOCAL COPY. An earlier version of this file
// declared census_of / keyed_count / seal_violations -- "compile this source string and count the
// blocking diagnostics of class C at subject S, -1 when the census did not run" -- which is exactly
// gunbc.compile_census_probe blocking_subject_count_for, down to the -1-never-0 rule and the reason
// for it. That module's own header says it is THE SINGLE HOME for this fact and that copying it makes
// one concept answer from two authorities. Four witnesses already consume it; this is the fifth. The
// local trio was the second-instance drift the census module documents, written while DFS-ing
// carefully before minting StreamPosition and not at all before minting this.
fn seal_violations(source: String, subject: String) -> Int {
  blocking_subject_count_for(source: source, wanted_class: "SoleConstructorViolation", wanted_subject: subject)
}

// RAN AT ALL, read through the home's own sentinel rather than a second census call: the contract is
// that a census which did not run answers -1 and never 0, so a non-negative count IS the ran-check.
fn census_ran(source: String) -> Bool {
  seal_violations(source: source, subject: "SoleConstructorViolation") >= 0
}

// ── RED 1: the durable-commit proof ────────────────────────────────────────────────────────────

data forged_commit_proof_source: String = "module probe_fleet_obs_forged_commit\nimport gunbc.fleet_observation_capture_chunk { LocalCommitStanding, LocallyCommitted, DurableCommitProof }\nimport std.content_hash { ContentHash, content_hash_of_value }\nfn forged() -> LocalCommitStanding {\n  LocallyCommitted { proof: DurableCommitProof { committed_content: content_hash_of_value(value: \"nothing-was-ever-stored\") } }\n}\n"

test fn a_forged_durable_commit_proof_is_refused_at_compile() -> Bool {
  seal_violations(source: forged_commit_proof_source, subject: "DurableCommitProof") == 1
}

// ── RED 2: the continuity reach ────────────────────────────────────────────────────────────────

data forged_continuity_reach_source: String = "module probe_fleet_obs_forged_reach\nimport gunbc.fleet_observation_capture_chunk { StreamContinuity, ContinuityEstablished, ContinuityReach, SourceStreamId, stream_position }\nimport std.measure { byte_size }\nfn forged() -> StreamContinuity {\n  ContinuityEstablished { reach: ContinuityReach { verified_through: stream_position(stream: SourceStreamId { enrolled_machine: \"m\", source_identity: \"s\" }, since_stream_origin: byte_size(count: 999999)) } }\n}\n"

test fn a_forged_continuity_reach_is_refused_at_compile() -> Bool {
  seal_violations(source: forged_continuity_reach_source, subject: "ContinuityReach") == 1
}

// ── RED 3: the committed chunk ─────────────────────────────────────────────────────────────────

data forged_committed_chunk_source: String = "module probe_fleet_obs_forged_chunk\nimport gunbc.fleet_observation_capture_chunk { CommittedChunk, CaptureChunk }\nfn forged(c: CaptureChunk) -> CommittedChunk {\n  CommittedChunk { chunk: c, committed_content: c.payload_digest }\n}\n"

test fn a_forged_committed_chunk_is_refused_at_compile() -> Bool {
  seal_violations(source: forged_committed_chunk_source, subject: "CommittedChunk") == 1
}

// ── RED 4: the silence proof, and this is the one the lane exists for ───────────────────────────

// "The host produced no bytes" must not be spellable without a token only source_byte_fact mints.
// This is the 2026-09-12 reading -- a quiet channel published as a successful boot -- as a compile
// refusal rather than as a review comment.
data forged_silence_source: String = "module probe_fleet_obs_forged_silence\nimport gunbc.fleet_observation_capture_chunk { SourceStreamRange, SourceStreamId, stream_position }\nimport gunbc.fleet_observation_observation_envelope { SourceByteFact, SourceProducedNoBytesInRange, SilenceProof }\nimport std.measure { byte_size }\nfn forged() -> SourceByteFact {\n  SourceProducedNoBytesInRange { proof: SilenceProof { range: SourceStreamRange { first: stream_position(stream: SourceStreamId { enrolled_machine: \"m\", source_identity: \"s\" }, since_stream_origin: byte_size(count: 0)), length: byte_size(count: 100) } } }\n}\n"

test fn a_forged_silence_proof_is_refused_at_compile() -> Bool {
  seal_violations(source: forged_silence_source, subject: "SilenceProof") == 1
}

// ── THE GREEN CONTROLS ─────────────────────────────────────────────────────────────────────────

// WITHOUT THESE THE REDS ABOVE CARRY NO INFORMATION. A probe that refuses because the module failed
// to resolve, or because a name was misspelled, looks identical to one that refuses because the wall
// fired. Each control imports the SAME modules and reaches the SAME types through the sanctioned
// route, and must draw ZERO violations on the same key.
data sanctioned_commit_source: String = "module probe_fleet_obs_sanctioned_commit\nimport gunbc.fleet_observation_capture_chunk { LocalCommitStanding, local_commit_from_cas }\nimport std.durable_compare_and_set { CasOutcome }\nimport std.types { NonEmptyStr }\nfn sanctioned(o: CasOutcome<NonEmptyStr>) -> LocalCommitStanding {\n  local_commit_from_cas(outcome: o)\n}\n"

test fn the_sanctioned_commit_route_draws_no_violation() -> Bool {
  seal_violations(source: sanctioned_commit_source, subject: "DurableCommitProof") == 0
}

data sanctioned_chunk_source: String = "module probe_fleet_obs_sanctioned_chunk\nimport gunbc.fleet_observation_capture_chunk { CommittedChunk, CaptureChunk, LocalCommitStanding, committed_chunk }\nfn sanctioned(c: CaptureChunk, s: LocalCommitStanding) -> CommittedChunk? {\n  committed_chunk(chunk: c, standing: s)\n}\n"

test fn the_sanctioned_chunk_route_draws_no_violation() -> Bool {
  seal_violations(source: sanctioned_chunk_source, subject: "CommittedChunk") == 0
}

// GREEN CONTROLS FOR THE TWO SUBJECTS THAT LACKED ONE, and their absence is why two stale fixtures
// went unnoticed: when commit 6d30414 retyped ContinuityReach.verified_through to StreamPosition and
// SourceStreamRange.first_offset to first, both forged strings kept the OLD field shapes. They still
// counted one SoleConstructorViolation -- the seal refuses during resolution, alongside the field
// error -- so the assertions stayed green while the probes had stopped isolating the wall. A control
// on the sanctioned route is what separates "refused because the wall fired" from "refused because
// the fixture is stale", which is the distinction this file's own header claims to keep.
data sanctioned_reach_source: String = "module probe_fleet_obs_sanctioned_reach\nimport gunbc.fleet_observation_capture_chunk { ContinuityDerivation, CommittedChunk, SourceStreamId, StreamPosition, continuity_from_committed_chunks }\nimport std.types { List }\nfn sanctioned(cs: List<CommittedChunk>, subj: SourceStreamId, from: StreamPosition) -> ContinuityDerivation {\n  continuity_from_committed_chunks(committed: cs, subject: subj, from: from)\n}\n"

test fn the_sanctioned_continuity_route_draws_no_violation() -> Bool {
  seal_violations(source: sanctioned_reach_source, subject: "ContinuityReach") == 0
}

data sanctioned_silence_source: String = "module probe_fleet_obs_sanctioned_silence\nimport gunbc.fleet_observation_capture_chunk { SourceStreamRange }\nimport gunbc.fleet_observation_observation_envelope { SourceByteFact, ObservationEnvelope, source_byte_fact }\nfn sanctioned(e: ObservationEnvelope, r: SourceStreamRange) -> SourceByteFact {\n  source_byte_fact(envelope: e, requested: r)\n}\n"

test fn the_sanctioned_silence_route_draws_no_violation() -> Bool {
  seal_violations(source: sanctioned_silence_source, subject: "SilenceProof") == 0
}

// BOTH ARMS MUST ACTUALLY HAVE COMPILED. blocking_subject_count_for returns -1 on a census that did
// not run, never 0, so a probe that
// never ran would otherwise be indistinguishable from one that ran and found nothing.
test fn every_probe_in_this_file_actually_compiled() -> Bool {
  census_ran(source: forged_commit_proof_source)
  && census_ran(source: forged_continuity_reach_source)
  && census_ran(source: forged_committed_chunk_source)
  && census_ran(source: forged_silence_source)
  && census_ran(source: sanctioned_commit_source)
  && census_ran(source: sanctioned_chunk_source)
  && census_ran(source: sanctioned_reach_source)
  && census_ran(source: sanctioned_silence_source)
}

