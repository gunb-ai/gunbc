module test.claim.aspeed_ast2500_management_paths_witness

import std.types { Bool, String, List, list_length }
import std.integer { Int }
import extdeps.bmc.aspeed_ast2500 {
  AdcAnalogInput,
  Ast2500ManagementAcquisitionPath,
  FanTachPulseCounter,
  GpioDigitalTripInput,
  HardwiredTripLine,
  I2cSmbusSensorBus,
  PeciProcessorTelemetry,
  PollableSensorReading,
  SgpioShiftRegisterTripInput,
  aspeed_ast2500_catalog,
  ast2500_hardwired_trip_line_path_count,
  ast2500_management_acquisition_mode,
  ast2500_management_acquisition_path_is_hardwired_trip_line,
  ast2500_management_acquisition_path_is_pollable_sensor_reading,
  ast2500_management_acquisition_paths,
  ast2500_pollable_sensor_reading_path_count,
}
import extdeps.vendor.aspeed { aspeed }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn path_eq(a: Ast2500ManagementAcquisitionPath, b: Ast2500ManagementAcquisitionPath) -> Bool {
  match a {
    GpioDigitalTripInput { gpio_pin_count: ac } =>
      match b {
        GpioDigitalTripInput { gpio_pin_count: bc } => ac == bc
        _ => false
      }
    SgpioShiftRegisterTripInput { sgpio_input_port_count: ac } =>
      match b {
        SgpioShiftRegisterTripInput { sgpio_input_port_count: bc } => ac == bc
        _ => false
      }
    I2cSmbusSensorBus { controller_count: ac } =>
      match b {
        I2cSmbusSensorBus { controller_count: bc } => ac == bc
        _ => false
      }
    AdcAnalogInput { channel_count: ac } =>
      match b {
        AdcAnalogInput { channel_count: bc } => ac == bc
        _ => false
      }
    PeciProcessorTelemetry { max_cpu_count: acpu, max_domain_per_cpu: adom } =>
      match b {
        PeciProcessorTelemetry { max_cpu_count: bcpu, max_domain_per_cpu: bdom } =>
          acpu == bcpu && adom == bdom
        _ => false
      }
    FanTachPulseCounter { tach_input_count: ac } =>
      match b {
        FanTachPulseCounter { tach_input_count: bc } => ac == bc
        _ => false
      }
  }
}

fn list_contains_path(
  paths: List<Ast2500ManagementAcquisitionPath>,
  wanted: Ast2500ManagementAcquisitionPath,
) -> Bool {
  fold(paths, init: false, f: fn(acc, p) { acc || path_eq(a: p, b: wanted) })
}

// THE CATALOG JOINS THE ASPEED VENDOR AUTHORITY RATHER THAN RE-TYPING THE NAME.
test fn w_the_catalog_names_ast2500_and_the_aspeed_vendor() -> Bool {
  (aspeed_ast2500_catalog.ordering_part_number as String) == "AST2500"
    && aspeed_ast2500_catalog.manufacturer == aspeed
}

// SIX PATHS, TWO MODES — THE SPLIT THE BRIEF ASKED FOR.
test fn w_six_management_acquisition_paths_split_two_hardwired_and_four_pollable() -> Bool {
  list_length(items: ast2500_management_acquisition_paths) == 6
    && ast2500_hardwired_trip_line_path_count(paths: ast2500_management_acquisition_paths) == 2
    && ast2500_pollable_sensor_reading_path_count(paths: ast2500_management_acquisition_paths) == 4
}

// EACH PATH CLASSIFIES EXACTLY ONE WAY.
test fn w_mode_projection_matches_the_two_predicates() -> Bool {
  fold(ast2500_management_acquisition_paths, init: true, f: fn(acc, p) {
    acc
      && ast2500_management_acquisition_path_is_hardwired_trip_line(path: p)
        != ast2500_management_acquisition_path_is_pollable_sensor_reading(path: p)
      && match ast2500_management_acquisition_mode(path: p) {
        HardwiredTripLine =>
          ast2500_management_acquisition_path_is_hardwired_trip_line(path: p)
        PollableSensorReading =>
          ast2500_management_acquisition_path_is_pollable_sensor_reading(path: p)
      }
  })
}

// CITED CAPACITIES FROM THE DATASHEET SECTIONS, NOT ROUNDED PROSE.
test fn w_cited_path_capacities_match_the_datasheet_rows() -> Bool {
  list_contains_path(
    paths: ast2500_management_acquisition_paths,
    wanted: GpioDigitalTripInput { gpio_pin_count: 228 },
  )
    && list_contains_path(
      paths: ast2500_management_acquisition_paths,
      wanted: SgpioShiftRegisterTripInput { sgpio_input_port_count: 80 },
    )
    && list_contains_path(
      paths: ast2500_management_acquisition_paths,
      wanted: I2cSmbusSensorBus { controller_count: 14 },
    )
    && list_contains_path(
      paths: ast2500_management_acquisition_paths,
      wanted: AdcAnalogInput { channel_count: 16 },
    )
    && list_contains_path(
      paths: ast2500_management_acquisition_paths,
      wanted: PeciProcessorTelemetry { max_cpu_count: 8, max_domain_per_cpu: 2 },
    )
    && list_contains_path(
      paths: ast2500_management_acquisition_paths,
      wanted: FanTachPulseCounter { tach_input_count: 16 },
    )
}

// THE CATALOG CARRIES THE SAME PATH ROSTER AS THE CHIP AUTHORITY.
test fn w_catalog_management_paths_match_the_authority_roster() -> Bool {
  list_length(items: aspeed_ast2500_catalog.management_acquisition_paths) == 6
    && fold(aspeed_ast2500_catalog.management_acquisition_paths, init: true, f: fn(acc, p) {
      acc && list_contains_path(paths: ast2500_management_acquisition_paths, wanted: p)
    })
}
