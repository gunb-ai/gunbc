module test.claim.frame_boundary_witness_test


// Discriminating witnesses for the frame-boundary SPEC (std.frame_boundary). The claim is fail-closed boundary admission (DESIGN 5): a frame runs only when every layer it requires closed is covered by the provided materialization; an uncovered required layer is a located BoundaryUnmaterialized naming that tree, never a silent pass. The build's common case: require the network layer (UriTree) closed; the Simulated/mock handler closes it at LifecycleByConvention (admissible, honestly weaker). RED control = refuses_uncovered_layer: if the coverage check were dropped, an uncovered UriTree would admit. Grade is the MEET across covered layers (only as strong as the weakest), pinned by grade_is_meet.
data net_convention_provided: std.frame_boundary.BoundaryMaterialization = std.frame_boundary.BoundaryMaterialization {
  closures: [std.frame_boundary.BoundaryClosure { tree: std.effect_grant.UriTree, grade: std.effect_grant.LifecycleByConvention }]
}

data fs_only_provided: std.frame_boundary.BoundaryMaterialization = std.frame_boundary.BoundaryMaterialization {
  closures: [std.frame_boundary.BoundaryClosure { tree: std.effect_grant.FilesystemPathTree, grade: std.effect_grant.LifecycleByConvention }]
}

data net_construction_fs_convention_provided: std.frame_boundary.BoundaryMaterialization = std.frame_boundary.BoundaryMaterialization {
  closures: [
    std.frame_boundary.BoundaryClosure { tree: std.effect_grant.UriTree, grade: std.effect_grant.LifecycleByConstruction },
    std.frame_boundary.BoundaryClosure { tree: std.effect_grant.FilesystemPathTree, grade: std.effect_grant.LifecycleByConvention }
  ]
}

data require_network: List<std.effect_grant.NamespaceTree> = [std.effect_grant.UriTree]
data require_network_and_fs: List<std.effect_grant.NamespaceTree> = [std.effect_grant.UriTree, std.effect_grant.FilesystemPathTree]
data require_nothing: List<std.effect_grant.NamespaceTree> = []

fn is_materialized_convention(a: std.frame_boundary.BoundaryAdmission) -> Bool {
  match a {
    std.frame_boundary.BoundaryMaterialized { grade: g } =>
      match g {
        std.effect_grant.LifecycleByConvention => true
        std.effect_grant.LifecycleByConstruction => false
      }
    std.frame_boundary.BoundaryUnmaterialized { tree: t } => false
  }
}

fn is_materialized_construction(a: std.frame_boundary.BoundaryAdmission) -> Bool {
  match a {
    std.frame_boundary.BoundaryMaterialized { grade: g } =>
      match g {
        std.effect_grant.LifecycleByConstruction => true
        std.effect_grant.LifecycleByConvention => false
      }
    std.frame_boundary.BoundaryUnmaterialized { tree: t } => false
  }
}

fn is_unmaterialized_for(a: std.frame_boundary.BoundaryAdmission, tree: std.effect_grant.NamespaceTree) -> Bool {
  match a {
    std.frame_boundary.BoundaryMaterialized { grade: g } => false
    std.frame_boundary.BoundaryUnmaterialized { tree: t } => std.effect_grant.namespace_tree_eq(a: t, b: tree)
  }
}

test fn frame_boundary_admits_covered_layer() -> Bool {
  is_materialized_convention(
    a: std.frame_boundary.boundary_admits(required_trees: require_network, provided: net_convention_provided)
  )
}

test fn frame_boundary_refuses_uncovered_layer() -> Bool {
  is_unmaterialized_for(
    a: std.frame_boundary.boundary_admits(required_trees: require_network, provided: fs_only_provided),
    tree: std.effect_grant.UriTree
  )
}

test fn frame_boundary_grade_is_meet() -> Bool {
  is_materialized_convention(
    a: std.frame_boundary.boundary_admits(
      required_trees: require_network_and_fs,
      provided: net_construction_fs_convention_provided
    )
  )
}

test fn frame_boundary_full_construction_stays_construction() -> Bool {
  is_materialized_construction(
    a: std.frame_boundary.boundary_admits(
      required_trees: require_network,
      provided: std.frame_boundary.BoundaryMaterialization {
        closures: [std.frame_boundary.BoundaryClosure { tree: std.effect_grant.UriTree, grade: std.effect_grant.LifecycleByConstruction }]
      }
    )
  )
}

test fn frame_boundary_empty_requirement_admits() -> Bool {
  is_materialized_construction(
    a: std.frame_boundary.boundary_admits(required_trees: require_nothing, provided: fs_only_provided)
  )
}

test fn frame_boundary_refusal_is_located() -> Bool {
  is_unmaterialized_for(
    a: std.frame_boundary.boundary_admits(required_trees: require_network, provided: fs_only_provided),
    tree: std.effect_grant.UriTree
  )
    && !is_unmaterialized_for(
         a: std.frame_boundary.boundary_admits(required_trees: require_network, provided: fs_only_provided),
         tree: std.effect_grant.ProcTree
       )
}
