module test.claim.self_host_parse_engine_hooks_behavioral_witness

import tools.self_host_module_behavioral_transport_roster { compiler_module_behavioral_receipt_for }

// Wet self-host behavioral receipt (parse_engine_hooks): the module declares no function and its
// closure reaches only v2.std.node, so the driver (the roster's driver_rel) runs
// parse_engine_hooks_test's assertions over the EMITTED realization with no seed oracle -- the three
// hooks carry their declared production symbols and no two collapse onto one production;
// --inject-fault asserts only that the match-arm body hook names the expr production. It used to
// compare each hook against a hand copy in v1_compiler (gunbc.recurring_failure_mode
// hand_shim_shadows_an_emitted_module).

test fn self_host_parse_engine_hooks_behavioral_receipt_holds() -> Bool {
  compiler_module_behavioral_receipt_for(module_path: "src/v2/compiler/parse_engine_hooks.dag")
}
