module test.claim.live_deploy_workflow_witness

import std.types { Bool, String }
import gunbc.live_deploy_workflow { expected_deploy_yml }
import gunbc.fleet_desired_admission_workflow { expected_fleet_desired_yml }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE DEPLOY WORKFLOW EMITS, AND WHAT IT EMITS IS THE ACTUATION THAT WAS MISSING.
//
// These claims read the emitted YAML rather than the Workflow value, because the value being
// well-formed was never in doubt -- gunbc.ci_spec described a correct deploy stage for weeks while
// nothing performed it. What was missing is a file GitHub reads. The subject here is therefore the
// serialized artifact.
test fn the_deploy_workflow_emits_a_job_that_runs_the_modeled_apply() -> Bool {
  let yml = expected_deploy_yml()
  string_contains(s: yml, pattern: "name: deploy")
    && string_contains(s: yml, pattern: "dag/gunbc/live_deploy/apply.dag")
    && string_contains(s: yml, pattern: "live_deploy_apply_srv1_wet")
}

// It must run ON the host it deploys. The apply admits LocalShell with principal ghrunner and
// refuses every other transport by construction (gunbc.host_effect_realize
// live_deploy_apply_candidate_locus_refusal), so a workflow scheduled onto a hosted runner would
// emit a file that can never converge -- it would refuse at the access gate on every run.
test fn the_deploy_job_is_pinned_to_the_target_host_runner() -> Bool {
  string_contains(s: expected_deploy_yml(), pattern: "srv1")
}

// PUSH ON MAIN, NEVER ON A PULL REQUEST. A deploy is a host mutation and a proposed change is not
// an admitted one; a pull_request trigger would put every open branch on the production host. This
// asserts the presence of the push trigger AND the absence of the pull_request one, because the
// dangerous direction is the one that is easy to add by accident.
test fn the_deploy_workflow_triggers_on_main_and_never_on_a_pull_request() -> Bool {
  let yml = expected_deploy_yml()
  string_contains(s: yml, pattern: "push:")
    && string_contains(s: yml, pattern: "branches: [main]")
    && !string_contains(s: yml, pattern: "pull_request")
}

// THE TOKEN MUST BE ABLE TO WRITE, and this claim's NAME was a lie the moment the advance moved --
// it read the_deploy_job_can_write_the_ref_it_advances, and this job now advances no ref. A claim
// named for a subject it no longer has is the witness-named-for-X-claiming-Y class, so it is
// renamed rather than left to read as coverage of something that is gone.
//
// The grant is still write, for a different and now-primary reason: the apply step mutates the
// host through the checkout whose credentials the checkout action persists. Asserted against the
// emitted permission rather than the model field so a serializer that dropped it reds.
test fn the_deploy_job_carries_the_write_grant_its_apply_needs() -> Bool {
  string_contains(s: expected_deploy_yml(), pattern: "contents: write")
}

// ORDER IS THE CLAIM, and it is the one the outage taught. The provider runtime is materialized
// before the deploy, because a dashboard whose provider binary is absent serves but cannot
// dispatch -- srv1's exact state.
//
// THE SECOND HALF OF THIS CLAIM CHANGED SUBJECT, and it is rewritten rather than deleted. It used
// to assert that the fleet-desired advance came LAST in this workflow, on the grounds that
// announcing a revision as desired before the deploy converges is a fabricated answer. That
// ordering argument still holds and is now enforced by a stronger fact: the advance is not in this
// workflow at all. It moved to gunbc.fleet_desired_admission_workflow, which cannot start until the
// required floor completes -- strictly after this workflow has finished or failed. So the claim
// asserts ABSENCE here, with the runtime-before-apply ordering as its positive control, and the
// admission witness carries the gated advance's own claims.
test fn the_deploy_steps_run_in_the_order_the_outage_taught() -> Bool {
  let yml = expected_deploy_yml()
  let before_apply = split(s: yml, delimiter: "live_deploy_apply_srv1_wet").first()
  string_contains(s: yml, pattern: "materialize_codex_runtime_on_local_host")
    && string_contains(s: before_apply, pattern: "materialize_codex_runtime_on_local_host")
    && !string_contains(s: yml, pattern: "refs/fleet/desired")
    && !string_contains(s: yml, pattern: "force-with-lease")
}

// THE REGRESSION CONTROL FOR A DEFECT THAT MADE THIS WORKFLOW NEVER RUN ONCE.
//
// The first cut of this module omitted the Rust toolchain install. The job targets a self-hosted
// runner where cargo is NOT on the default PATH, so every deploy run from the moment the workflow
// landed died at its first build step with `cargo: command not found`, exit 127. There was never a
// successful deploy run, and nothing in the repository noticed: the workflow emitted, parsed,
// registered as a generated artifact, and passed review, because every one of those checks reads
// the artifact rather than a run of it.
//
// ORDER IS THE CLAIM, not presence. A toolchain step emitted AFTER the build is exactly as useless
// as no toolchain step, and a containment check for the action name cannot tell the two apart. So
// this splits the document at the first cargo invocation and requires the install to appear in the
// prefix. The positive half -- that a cargo invocation exists at all -- keeps the claim from passing
// vacuously against a document that lost its build step.
test fn the_deploy_workflow_installs_a_toolchain_before_its_first_cargo_invocation() -> Bool {
  let yml = expected_deploy_yml()
  let before_cargo = split(s: yml, delimiter: "cargo build").first()
  string_contains(s: yml, pattern: "cargo build")
    && string_contains(s: before_cargo, pattern: "setup-rust-toolchain")
}

// cache:false travels with the step rather than being re-decided here. gunbc.witness_floor_workflow
// records why at length: setup-rust-toolchain's default cache registers a post step whose cleanBin
// and cleanRegistry delete against a /home/ghrunner/.cargo shared by every slot on a self-hosted
// host, so it removes files other concurrently-running jobs are building against. That reasoning is
// about the fleet, not about the witness floor, and it applies to this job for the same reason. A
// hand-copied toolchain step here would very plausibly have dropped the flag as an unexplained
// default, which is why the step is imported rather than restated -- and why this claim pins the
// emitted flag rather than trusting the import to have carried it.
test fn the_deploy_toolchain_step_disables_the_shared_home_cache() -> Bool {
  let yml = expected_deploy_yml()
  let after_toolchain = split(s: yml, delimiter: "setup-rust-toolchain").last()
  string_contains(s: after_toolchain, pattern: "cache: false")
}

// THE INTEGRATION CLAIM. Everything else in this file, and in the admission
// witness file, is a claim about ONE workflow. This is the only claim about the
// PAIR, and the pair is where the hazard lived: the deploy job's ungated raw
// GITHUB_SHA push onto the fleet ref was unreachable ONLY because cargo was
// missing, so installing the toolchain without deleting that push would have
// armed it. Two changes, each correct read alone, defective in composition --
// which is exactly what no single-diff review examines. Neither source PR could
// state this claim, because neither tree contained both halves.
//
// A first draft of this claim asserted that the admission workflow's yaml
// CONTAINS refs/fleet/desired. It does not, and the reason is the property worth
// asserting instead: the ref, the revision and the expected prior never appear in
// the admission shell at all -- the modeled decision writes an authorized push
// script and the shell only executes what it was handed. So the conjunct below
// checks that the advance is REACHED THROUGH the modeled decision, which is a
// stronger statement than a ref name appearing in a file, and would have been
// silently satisfied by neither a literal ref nor a hand-built push.
test fn the_deploy_and_admission_workflows_form_one_safe_cut() -> Bool {
  let deploy = expected_deploy_yml()
  let admit = expected_fleet_desired_yml()
  let deploy_before_cargo = split(s: deploy, delimiter: "cargo build").first()
  let admit_before_cargo = split(s: admit, delimiter: "cargo build").first()

  // both jobs can start at all
  string_contains(s: deploy_before_cargo, pattern: "setup-rust-toolchain")
    && string_contains(s: admit_before_cargo, pattern: "setup-rust-toolchain")
    // the deploy job cannot touch the fleet ref by any route
    && !string_contains(s: deploy, pattern: "refs/fleet/desired")
    && !string_contains(s: deploy, pattern: "force-with-lease")
    && !string_contains(s: deploy, pattern: "git push")
    // and the advance exists only behind the modeled admission decision
    && string_contains(s: admit, pattern: "admit_fleet_desired_from_floor_event_wet")
    && string_contains(s: admit, pattern: "fleet-desired-authorized-push.sh")
    && !string_contains(s: admit, pattern: "force-with-lease")
}
