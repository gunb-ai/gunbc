module test.claim.compute_unit_stop_observation_witness

import std.types { Bool, String }
import gunbc.compile_census_probe { total_blocking_count_for }

// NEGATIVE CONTROL: compute_run_unit takes a CLOSED ComputeUnitStopObservation, never a property list,
// so a caller cannot append MemoryMax/WorkingDirectory/Slice/KillMode against the grant that
// compute_unit_properties ties to the unit. The forged source passes a raw SystemdRunProperty
// (MemoryMax) at the observation operand and must fail to compile; the accepted source passes the
// closed arm and must compile, proving the census ran and the refusal is the operand.
data forged_raw_property_source: String = "module probe_forged_raw_unit_property\nimport gunbc.compute.work_provider_local { compute_run_unit, ComputeUnitRunReading, ComputeLayout }\nimport gunbc.dashboard_instance { HostDashboardInstance }\nimport extdeps.systemd { MemoryMax }\nimport extdeps.systemd.systemd_run { SystemdRunProperty }\nimport std.types { String, FilePath }\nfn forged(instance: HostDashboardInstance, layout: ComputeLayout, dir: FilePath) -> ComputeUnitRunReading {\n  compute_run_unit(instance: instance, layout: layout, identity_hex: \"x\", argv: [], env: [], launcher_env: [], granted: 1, user_runtime_dir: dir, stop_observation: SystemdRunProperty { property: MemoryMax, value: \"infinity\" })\n}\n"

data accepted_closed_observation_source: String = "module probe_accepted_closed_observation\nimport gunbc.compute.work_provider_local { compute_run_unit, ComputeUnitRunReading, ComputeLayout, SccacheStatsAtStop }\nimport gunbc.dashboard_instance { HostDashboardInstance }\nimport std.types { String, FilePath }\nfn accepted(instance: HostDashboardInstance, layout: ComputeLayout, dir: FilePath) -> ComputeUnitRunReading {\n  compute_run_unit(instance: instance, layout: layout, identity_hex: \"x\", argv: [], env: [], launcher_env: [], granted: 1, user_runtime_dir: dir, stop_observation: SccacheStatsAtStop)\n}\n"

test fn a_compute_unit_cannot_take_a_raw_property_at_stop() -> Bool {
  (total_blocking_count_for(source: forged_raw_property_source) > 0)
    && (total_blocking_count_for(source: accepted_closed_observation_source) == 0)
}
