module test.claim.devboot_fleet_proof_harvest_witness

import std.types { Bool, Int, NonEmptyStr }
import v2.std.optional { Present, Absent }
import gunbc.devboot.subject { git_tree_object_id_wire_hex }
import gunbc.devboot.fleet_proof_capture {
  capture_fleet_proof_harvest_bundle,
  devboot_fleet_proof_fixture_observation_sites,
  devboot_fleet_proof_fixture_observation_sites_with_compile_count,
}
import gunbc.devboot.fleet_proof_harvest {
  harvest_modeled_fleet_proof,
  parse_client_receipt,
  parse_capture_provenance,
  producer_compile_count_from_log,
}
import gunbc.devboot.vertical_receipt { devboot_vertical_receipt_from_proof }

test fn witness_capture_reads_fixture_observations() -> Bool {
  let bundle = capture_fleet_proof_harvest_bundle(
    sites: devboot_fleet_proof_fixture_observation_sites,
  )
  string_contains(s: bundle.srv1_client_receipt, pattern: "reused: false")
    && string_contains(s: bundle.srv2_client_receipt, pattern: "reused: true")
    && string_contains(s: bundle.store_for_each_ref, pattern: "refs/devboot/produced/")
}

test fn witness_historical_fixture_refuses_without_compile_count_in_log() -> Bool {
  match harvest_modeled_fleet_proof(
    bundle: capture_fleet_proof_harvest_bundle(sites: devboot_fleet_proof_fixture_observation_sites),
  ) {
    Present { value: _ } => false
    Absent => true
  }
}

test fn witness_harvest_from_fixture_with_compile_count_seam_field() -> Bool {
  match harvest_modeled_fleet_proof(
    bundle: capture_fleet_proof_harvest_bundle(
      sites: devboot_fleet_proof_fixture_observation_sites_with_compile_count,
    ),
  ) {
    Present { value: proof } =>
      proof.tested_commit == devboot_fleet_proof_fixture_observation_sites_with_compile_count.corpus_head
        && (git_tree_object_id_wire_hex(oid: proof.tested_tree) as String) == "918953e9eb1ccbc60e6b91f64d5612a0fffd4871"
        && proof.request_identity == ("fnv1a64-dfd0b4abb44e30e7" as NonEmptyStr)
        && proof.producer_compile_count == 1
        && proof.produced_commit == ("180beeb95ef8dab53c7abf8aa59a728ffc00e4e9" as NonEmptyStr)
        && length(proof.clients) == 2
        && proof.observation_capture.modeled_serve_log_host == ("srv3" as NonEmptyStr)
        && proof.observation_capture.srv1_client_receipt_host == ("srv1" as NonEmptyStr)
    Absent => false
  }
}

test fn witness_producer_compile_count_sums_seam_not_served_line_count() -> Bool {
  let log = "2026-08-09T22:13:23+00:00 exit=0 SERVED token-a sha256=abc compile_count=1\n2026-08-09T22:14:00+00:00 exit=0 SERVED token-a sha256=abc compile_count=0"
  match producer_compile_count_from_log(log: log) {
    Present { value: count } => count == 1
    Absent => false
  }
}

test fn witness_served_line_without_compile_count_refuses_compile_count() -> Bool {
  match producer_compile_count_from_log(
    log: "2026-08-09T22:13:23+00:00 exit=0 SERVED token-a sha256=abc",
  ) {
    Present { value: _ } => false
    Absent => true
  }
}

test fn witness_vertical_projection_matches_harvested_proof() -> Bool {
  match harvest_modeled_fleet_proof(
    bundle: capture_fleet_proof_harvest_bundle(
      sites: devboot_fleet_proof_fixture_observation_sites_with_compile_count,
    ),
  ) {
    Present { value: proof } => {
      let vertical = devboot_vertical_receipt_from_proof(proof: proof)
      vertical.evaluated_commit == proof.tested_commit
        && vertical.evaluated_tree == proof.tested_tree
        && vertical.subject_ref_token == proof.request_identity
        && vertical.artifact_sha256 == proof.artifact_sha256
    }
    Absent => false
  }
}

test fn witness_capture_provenance_refuses_without_manifest() -> Bool {
  match parse_capture_provenance(
    prose: "capture_runner_host: only-field\n",
  ) {
    Present { value: _ } => false
    Absent => true
  }
}

test fn witness_client_receipt_parser_refuses_missing_execution_fields() -> Bool {
  match parse_client_receipt(prose: "BUILT\nsha256: 976728c5d2029799f1d89843dfdd70c3b3ed132211126d2752ef8af23b5c146e\nproducer_host: srv3\nreused: false") {
    Present { value: _ } => false
    Absent => true
  }
}
