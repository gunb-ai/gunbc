}

// WITNESS-LOCAL TABLE ONLY. These numbers are not Ampere publications and are not the retracted
// 2933/2400 transcription. They exist so the admitted 2DPC path (a matching rank row) stays
// executable after the production table was emptied. The citation names this controlled fixture,
// never an Ampere authority: these are synthetic inputs to the derivation.
data fixture_admitted_two_dpc_ceilings: TwoDpcRateCeilingTable = TwoDpcRateCeilingTable {
  rows: [
    TwoDpcRateCeiling { min_rank_count: 2, ceiling: megatransfers_per_second(count: 4000) },
    TwoDpcRateCeiling { min_rank_count: 4, ceiling: megatransfers_per_second(count: 2500) },
  ],
  evidence: CitedToAuthority {
    authority: ExternalAuthority {
      uri: Uri {
        scheme: File,
        locator: "dag/test/claim/node_power_envelope_witness.dag#fixture_admitted_two_dpc_ceilings",
      },
    },
  },
}

data fixture_admitted_two_dpc_context: MemoryElectricalContext = MemoryElectricalContext {
  geometry: mt_collins_per_socket_geometry,
  max_data_rate: altra_memory_max_data_rate,
  two_dpc_ceilings: fixture_admitted_two_dpc_ceilings,
}

data fixture_uncited_two_dpc_context: MemoryElectricalContext = MemoryElectricalContext {
  geometry: mt_collins_per_socket_geometry,
  max_data_rate: altra_memory_max_data_rate,
  two_dpc_ceilings: TwoDpcRateCeilingTable {
    rows: fixture_admitted_two_dpc_ceilings.rows,
    evidence: TranscribedUncited {
      read_obligation: "fixture rank rows lack an operating-rate authority" as NonEmptyStr,
    },
  },
}

