module test.claim.approval_request_submission_witness

import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.types { Bool, NonEmptyStr, String, Secret }
import std.algebra { length }
import std.optional { Present }
import std.scoped_authorization { AttemptIdentity }
import extdeps.crypto.mac { MacKey, HmacSha256, MacSigned, MacKeyMaterialNotHex, MacVerified, mac_verify }
import gunbc.auth.approval_decision_store {
  ApprovalKeyringRead, ApprovalKeyLoaded, ApprovalKeyringRefused, ApprovalKeyFileAbsent, StoredApprovalRequest, stored_request_json, claims_for,
  approval_mac_key_id, EscalationUnreadable, EscalationPending, EscalationDecided, EscalationNotFiled,
}
import gunbc.auth.approval_broker { BrokerDenied }
import gunbc.auth.approval_apns_publish {
  DevicePushTargets, DevicePushTargetsListed, DevicePushTarget, ApnsSender, ApnsSenderReady, ApnsSenderUnavailable,
  DeviceNotification, DeviceNotificationAttempted, DeviceNotificationNoRecipient, DeviceNotificationNotAttempted, DevicePushSent, DevicePushNotSent, hermetic_apns_id,
  device_notification_sentence,
}
import gunbc.auth.approval_device_wire { ApnsRegistration }
import gunbc.auth.approval_device_redemption { PushProviderAccepted, ProviderApns }
import extdeps.apple.apns { ApnsDevelopment }
import extdeps.auth.jwt { JwtCompactSerialization }
import gunbc.auth.approval_request_submission {
  approval_submission_mac_key_id,
  sign_submission, submission_envelope_json, parse_submission_envelope, SubmissionEnvelopeParsed, SubmissionEnvelopeUnreadable,
  admit_parsed_submission, SubmissionVerdict, SubmissionVerified, SubmissionNotAdmitted, SubmissionUnreadable, SubmissionKeyUnavailable, SubmissionNotEnrolled,
  escalation_status, escalation_status_of,
  SubmissionOutcome, notify_filed, occupied_slot_standing, OccupiedRenotifiable, OccupiedConflict, OccupiedUnreadable, SubmissionFiledCapabilityKeyUnavailable, SubmissionFiledAndNotified, SubmissionFiledNotNotified,
  SubmissionStoreRefused, submission_outcome_admits_poll,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data submission_key_hex: String = "fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210"
data capability_key_hex: String = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

fn submission_key() -> MacKey {
  MacKey { id: approval_submission_mac_key_id, suite: HmacSha256, material: submission_key_hex as Secret }
}

fn capability_key() -> MacKey {
  MacKey { id: approval_mac_key_id, suite: HmacSha256, material: capability_key_hex as Secret }
}

fn request() -> StoredApprovalRequest {
  StoredApprovalRequest {
    escalation_id: "esc-mtc1-boot-1",
    request_revision: "sha256:abababababababababababababababababababababababababababababababab",
    attempt: "mtc1-boot-attempt-1" as AttemptIdentity,
    requester: "fleet-converge mtcollins1_boot",
    purpose: "Boot Mt. Collins unit 1 once from the diskless image over BMC virtual media.",
    destructive: true,
    issued_at: "2026-09-16T20:00:00Z",
    expires_at: "2026-09-17T20:00:00Z",
    key_id: approval_mac_key_id,
  }
}

// THE DEVICE SIDE OF THE FILING, SUPPLIED: one enrolled approver whose phone registered a
// development-signed token for this app, and a sender holding a provider token. The fold runs THROUGH
// apns.Http2.Send, whose hermetic arm is Apple's 200 shape; the provider token's own route (the ES256
// mint and its CAS slot) is test.claim.approval_apns_publish_witness's.
fn one_registered_device() -> DevicePushTargets {
  DevicePushTargetsListed {
    targets: [DevicePushTarget { enrollment_id: "genr-witness", registration: ApnsRegistration { environment: ApnsDevelopment, topic: "ai.gunb.approve", token: "a1b2c3d4" } }],
    unregistered: [],
    unreadable: [],
  }
}

fn no_registered_device() -> DevicePushTargets {
  DevicePushTargetsListed { targets: [], unregistered: ["genr-unregistered" as NonEmptyStr], unreadable: [] }
}

fn ready_sender() -> ApnsSender {
  ApnsSenderReady { token: "eyJhbGciOiJFUzI1NiJ9.eyJpc3MiOiJ3In0.c2ln" as JwtCompactSerialization }
}

fn signed_envelope() -> String {
  match sign_submission(key: submission_key(), request: request()) {
    MacSigned { tag: t } => submission_envelope_json(request: request(), tag_hex: t.hex)
    MacKeyMaterialNotHex { key_id: _ } => ""
  }
}

// ── the envelope authenticates the canonical record ────────────────────────────────────────────

test fn a_signed_envelope_parses_back_to_the_same_request_and_tag() -> Bool {
  match parse_submission_envelope(text: signed_envelope()) {
    SubmissionEnvelopeParsed { tag_hex: t, request: r } =>
      stored_request_json(r: r) == stored_request_json(r: request())
        && match mac_verify(key: submission_key(), message: stored_request_json(r: r) as NonEmptyStr, tag_hex: t) { MacVerified { verified: _ } => true  _ => false }
    SubmissionEnvelopeUnreadable { detail: _ } => false
  }
}

test fn a_non_canonical_record_is_refused_before_it_is_verified() -> Bool {
  match parse_submission_envelope(text: "{\"tag\":\"00\",\"request\":\"{\\\"kind\\\": \\\"request\\\", \\\"escalation_id\\\": \\\"e\\\", \\\"request_revision\\\": \\\"r\\\", \\\"attempt\\\": \\\"a\\\", \\\"requester\\\": \\\"q\\\", \\\"purpose\\\": \\\"p\\\", \\\"destructive\\\": true, \\\"issued_at\\\": \\\"2026-09-16T20:00:00Z\\\", \\\"expires_at\\\": \\\"2026-09-17T20:00:00Z\\\", \\\"key_id\\\": \\\"k\\\", \\\"authority\\\": \\\"gunbc.auth.approval_capability\\\",  \\\"extra\\\": 1}\"}") {
    SubmissionEnvelopeUnreadable { detail: _ } => true
    SubmissionEnvelopeParsed { tag_hex: _, request: _ } => false
  }
    && match parse_submission_envelope(text: "{\"request\":\"{}\"}") { SubmissionEnvelopeUnreadable { detail: _ } => true  _ => false }
    && match parse_submission_envelope(text: "nope") { SubmissionEnvelopeUnreadable { detail: _ } => true  _ => false }
}

// THE ROUTE THE SERVER RUNS, composed the way gunbc.roadmap.roadmap_serve composes it: parse, then admit
// the parsed envelope. A wrapper doing this in the production module had no production caller.
fn admit(text: String, keyring: ApprovalKeyringRead) -> SubmissionVerdict {
  match parse_submission_envelope(text: text) {
    SubmissionEnvelopeUnreadable { detail: d } => SubmissionNotAdmitted { refusal: SubmissionUnreadable { detail: d } }
    SubmissionEnvelopeParsed { tag_hex: tag, request: r } => admit_parsed_submission(tag_hex: tag, request: r, keyring: keyring)
  }
}

// ── admission: the submission key IS enrolment ─────────────────────────────────────────────────

test fn a_correctly_signed_submission_is_admitted_and_a_wrong_key_is_not_enrolled() -> Bool {
  let other = MacKey { id: approval_submission_mac_key_id, suite: HmacSha256, material: capability_key_hex as Secret }
  match admit(text: signed_envelope(), keyring: ApprovalKeyLoaded { key: submission_key() }) { SubmissionVerified { request: r } => r.escalation_id == "esc-mtc1-boot-1"  _ => false }
    && match admit(text: signed_envelope(), keyring: ApprovalKeyLoaded { key: other }) { SubmissionNotAdmitted { refusal: SubmissionNotEnrolled { detail: _ } } => true  _ => false }
    && match admit(text: signed_envelope(), keyring: ApprovalKeyringRefused { cause: ApprovalKeyFileAbsent { path: "/etc/gunbc-roadmap/approval-submission-mac-key" } }) { SubmissionNotAdmitted { refusal: SubmissionKeyUnavailable { cause: _ } } => true  _ => false }
    && match admit(text: "garbage", keyring: ApprovalKeyLoaded { key: submission_key() }) { SubmissionNotAdmitted { refusal: SubmissionUnreadable { detail: _ } } => true  _ => false }
}

test fn a_slot_with_no_minted_capability_does_not_admit_poll() -> Bool {
  let no_key = SubmissionFiledCapabilityKeyUnavailable { escalation_id: "esc-mtc1-boot-1" as NonEmptyStr, cause: ApprovalKeyFileAbsent { path: "/etc/gunbc-roadmap/approval-mac-key" } }
  !submission_outcome_admits_poll(o: no_key)
    && submission_outcome_admits_poll(o: SubmissionFiledAndNotified { escalation_id: "esc-mtc1-boot-1" as NonEmptyStr, devices: DeviceNotificationNotAttempted { detail: "witness" } })
    && !submission_outcome_admits_poll(o: SubmissionStoreRefused { detail: "disk" as NonEmptyStr })
}

// THE CAPABILITY KEY MUST NOT FILE: a runner holding only the key that mints consent is exactly
// the requester the broker refuses to let reach the operator.
test fn the_capability_key_cannot_file_a_request() -> Bool {
  match sign_submission(key: capability_key(), request: request()) {
    MacSigned { tag: t } =>
      match admit(text: submission_envelope_json(request: request(), tag_hex: t.hex), keyring: ApprovalKeyLoaded { key: submission_key() }) {
        SubmissionNotAdmitted { refusal: SubmissionNotEnrolled { detail: _ } } => true
        _ => false
      }
    MacKeyMaterialNotHex { key_id: _ } => false
  }
}

// ── the links: issued with mac_sign, redeemable by the store's verifier ────────────────────────




// THE STATUS TEXT A POLLING RUN READS, over a store root under the checkout that holds no slot:
// the not-filed standing is the filesystem's absence, read through the CAS probe, never inferred
// from empty content. The pending and decided renderings are covered by the live probe over a real
// store; this is the one arm the hermetic frame can reach.
test fn status_text_reports_not_filed_for_an_absent_slot_and_unreadable_off_the_success_channel() -> Bool {
  let absent = escalation_status(root: "dag/test/claim", escalation_id: "esc-no-such-escalation")
  let unreadable = escalation_status_of(slot: EscalationUnreadable { detail: "gen1 record is not a request" })
  absent.status == 200 && absent.body == "standing=not-filed\n"
    && unreadable.status == 503 && contains(unreadable.body, "standing=unreadable")
}


// THE PHONE IS PUSHED, AND IT IS THE ONLY NOTIFICATION. With one registered approver device and a
// ready sender, the filing reaches apns.Http2.Send and reads back Apple's acceptance under the
// hermetic apns-id, keyed by the enrolment it went to; deleting the device fan-out, or the send,
// fails this control.
fn accepted_by_the_one_device(n: DeviceNotification) -> Bool {
  match n {
    DeviceNotificationAttempted { outcomes: os, unregistered: _, unreadable: _ } =>
      length(os) == 1 && match os.get(index: 0) {
        Present { value: DevicePushSent { enrollment_id: e, outcome: PushProviderAccepted { provider: ProviderApns, receipt: r } } } => e == "genr-witness" && (r as String) == hermetic_apns_id
        _ => false
      }
    DeviceNotificationNoRecipient { unregistered: _, unreadable: _ } => false
    DeviceNotificationNotAttempted { detail: _ } => false
  }
}

test fn a_filed_request_pushes_every_registered_approver_device_through_apns() -> Bool {
  match notify_filed(capability_keyring: ApprovalKeyLoaded { key: capability_key() }, devices: one_registered_device(), sender: ready_sender(), request: request()) {
    SubmissionFiledAndNotified { escalation_id: e, devices: n } => e == "esc-mtc1-boot-1" && accepted_by_the_one_device(n: n)
    _ => false
  }
}

// NOBODY WOKEN IS NOT NOTIFIED, AND SAYS WHY: an unavailable sender, or no registered device, files
// the request and answers not-notified naming the cause -- never a notified answer with nothing behind it.
fn not_notified_naming(o: SubmissionOutcome, fragment: String) -> Bool {
  match o {
    SubmissionFiledNotNotified { escalation_id: _, devices: n } => contains(device_notification_sentence(n: n), fragment)
    _ => false
  }
}

test fn an_unavailable_sender_or_no_registered_device_is_filed_but_not_notified() -> Bool {
  not_notified_naming(o: notify_filed(capability_keyring: ApprovalKeyLoaded { key: capability_key() }, devices: one_registered_device(), sender: ApnsSenderUnavailable { detail: "no key file" }, request: request()), fragment: "no key file")
    && not_notified_naming(o: notify_filed(capability_keyring: ApprovalKeyLoaded { key: capability_key() }, devices: no_registered_device(), sender: ready_sender(), request: request()), fragment: "1 unregistered")
}

// A FAILED NOTIFY IS RETRIED BY RESUBMITTING: an occupied slot re-notifies only while pending with
// exactly these bytes; a decided slot or a pending slot for other bytes is a conflict; an
// unreadable slot -- or one that reads absent after the write said occupied -- is the store's own
// refusal and never a conflict that would tell the filer its request is on file.
test fn an_occupied_slot_is_renotifiable_only_while_pending_with_the_same_bytes() -> Bool {
  let same = request()
  let other = StoredApprovalRequest {
    escalation_id: "esc-mtc1-boot-1",
    request_revision: "sha256:cdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcd",
    attempt: "mtc1-boot-attempt-2" as AttemptIdentity,
    requester: "fleet-converge mtcollins1_boot",
    purpose: "Boot Mt. Collins unit 1 once from the diskless image over BMC virtual media.",
    destructive: true,
    issued_at: "2026-09-16T20:00:00Z",
    expires_at: "2026-09-17T20:00:00Z",
    key_id: approval_mac_key_id,
  }
  match occupied_slot_standing(slot: EscalationPending { request: same }, request: request()) { OccupiedRenotifiable => true  _ => false }
    && match occupied_slot_standing(slot: EscalationPending { request: other }, request: request()) { OccupiedConflict => true  _ => false }
    && match occupied_slot_standing(slot: EscalationDecided { decision: BrokerDenied { escalation_id: "esc-mtc1-boot-1", revision: "sha256:abababababababababababababababababababababababababababababababab", decided_by: "briansrls@gmail.com", decided_at: "2026-09-16T21:00:00Z", reason: "no" } }, request: request()) { OccupiedConflict => true  _ => false }
    && match occupied_slot_standing(slot: EscalationUnreadable { detail: "gen1 unreadable" }, request: request()) { OccupiedUnreadable { detail: _ } => true  _ => false }
    && match occupied_slot_standing(slot: EscalationNotFiled, request: request()) { OccupiedUnreadable { detail: _ } => true  _ => false }
}

// A CAPABILITY-KEY REFUSAL AFTER THE WRITE STILL SAYS WHICH ESCALATION WAS FILED, like every other
// post-write arm, so the filer retries the same bytes instead of minting a new id (review 67295).
test fn a_capability_key_refusal_after_filing_names_the_filed_escalation() -> Bool {
  match notify_filed(capability_keyring: ApprovalKeyringRefused { cause: ApprovalKeyFileAbsent { path: "/etc/gunbc-roadmap/approval-mac-key" } }, devices: one_registered_device(), sender: ready_sender(), request: request()) {
    SubmissionFiledCapabilityKeyUnavailable { escalation_id: e, cause: _ } => e == "esc-mtc1-boot-1"
    _ => false
  }
}
