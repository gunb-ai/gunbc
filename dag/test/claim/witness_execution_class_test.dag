module gunbc.test.claim.witness_execution_class_test

import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree, SubstrateInputsOnly }
import v2.std.optional { Optional, Present, Absent }
import std.types { Bool, List }
import gunbc.witness_execution_class {
  NativeBlockedCause,
  GeneralWitnessTargetModelUnavailable,
  HostCapabilityUnavailable,
  WitnessExecutionClass,
  NativeRequired,
  NativeLiveObservation,
  EffectObligation,
  InterpreterSubjectTest,
  NativeBlocked,
  WitnessClassRow,
  classify_witness,
  census_of,
  census_accounts_for_every_row,
  every_identity_classified_exactly_once
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn pure_disposition() -> Optional<LiveTreeDisposition> {
  Present { value: SubstrateInputsOnly }
}

fn live_disposition() -> Optional<LiveTreeDisposition> {
  Present { value: ReadsLiveTree }
}

test fn witness_classifier_precedence_effect_then_interpreter_subject() -> Bool {
  let effect_wins = classify_witness(disposition: pure_disposition(), effect_obligation: true, interpreter_subject: true, emitter_carries: true, blocked_cause: GeneralWitnessTargetModelUnavailable)
  let interp_wins = classify_witness(disposition: pure_disposition(), effect_obligation: false, interpreter_subject: true, emitter_carries: true, blocked_cause: GeneralWitnessTargetModelUnavailable)
  match effect_wins {
    EffectObligation => match interp_wins {
      InterpreterSubjectTest => true
      _ => false
    }
    _ => false
  }
}

test fn witness_classifier_live_and_undeclared_both_classify_as_live_observation() -> Bool {
  let declared = classify_witness(disposition: live_disposition(), effect_obligation: false, interpreter_subject: false, emitter_carries: true, blocked_cause: GeneralWitnessTargetModelUnavailable)
  let undeclared = classify_witness(disposition: Absent, effect_obligation: false, interpreter_subject: false, emitter_carries: true, blocked_cause: GeneralWitnessTargetModelUnavailable)
  match declared {
    NativeLiveObservation => match undeclared {
      NativeLiveObservation => true
      _ => false
    }
    _ => false
  }
}

test fn witness_classifier_hermetic_splits_on_emitter_carriage_with_typed_cause() -> Bool {
  let carried = classify_witness(disposition: pure_disposition(), effect_obligation: false, interpreter_subject: false, emitter_carries: true, blocked_cause: GeneralWitnessTargetModelUnavailable)
  let blocked = classify_witness(disposition: pure_disposition(), effect_obligation: false, interpreter_subject: false, emitter_carries: false, blocked_cause: HostCapabilityUnavailable { capability: "linux-only procfs read" })
  match carried {
    NativeRequired => match blocked {
      NativeBlocked { cause: c } => match c {
        HostCapabilityUnavailable { capability: _ } => true
        _ => false
      }
      _ => false
    }
    _ => false
  }
}

fn census_fixture_rows() -> List<WitnessClassRow> {
  [
    WitnessClassRow { entry: "a_test.dag", function: "w_meet", class: NativeRequired },
    WitnessClassRow { entry: "a_test.dag", function: "w_live", class: NativeLiveObservation },
    WitnessClassRow { entry: "b_test.dag", function: "w_wet", class: EffectObligation },
    WitnessClassRow { entry: "c_test.dag", function: "w_interp", class: InterpreterSubjectTest },
    WitnessClassRow { entry: "d_test.dag", function: "w_blocked", class: NativeBlocked { cause: GeneralWitnessTargetModelUnavailable } }
  ]
}

test fn witness_census_partitions_the_population_exactly() -> Bool {
  let c = census_of(rows: census_fixture_rows())
  census_accounts_for_every_row(rows: census_fixture_rows())
    && c.total == 5
    && c.native_required == 1
    && c.native_live_observation == 1
    && c.effect_obligation == 1
    && c.interpreter_subject == 1
    && c.native_blocked == 1
}

test fn witness_census_RED_planted_duplicate_identity_refuses_exactly_once() -> Bool {
  let planted = concat(census_fixture_rows(), [WitnessClassRow { entry: "a_test.dag", function: "w_meet", class: EffectObligation }])
  every_identity_classified_exactly_once(rows: census_fixture_rows())
    && !every_identity_classified_exactly_once(rows: planted)
}
