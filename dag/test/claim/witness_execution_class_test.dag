module gunbc.test.claim.witness_execution_class_test


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn pure_disposition() -> v2.std.optional.Optional<v2.std.live_tree.LiveTreeDisposition> {
  v2.std.optional.Present { value: v2.std.live_tree.SubstrateInputsOnly }
}

fn live_disposition() -> v2.std.optional.Optional<v2.std.live_tree.LiveTreeDisposition> {
  v2.std.optional.Present { value: v2.std.live_tree.ReadsLiveTree }
}

test fn witness_classifier_precedence_effect_then_interpreter_subject() -> Bool {
  let effect_wins = gunbc.witness_execution_class.classify_witness(disposition: pure_disposition(), effect_obligation: true, interpreter_subject: true, carriage: gunbc.witness_execution_class.CarriedInEnrolledBundle { bundle_identity: "09d7d2e53554c783", member: "meet" })
  let interp_wins = gunbc.witness_execution_class.classify_witness(disposition: pure_disposition(), effect_obligation: false, interpreter_subject: true, carriage: gunbc.witness_execution_class.CarriedInEnrolledBundle { bundle_identity: "09d7d2e53554c783", member: "meet" })
  match effect_wins {
    gunbc.witness_execution_class.EffectObligation => match interp_wins {
      gunbc.witness_execution_class.InterpreterSubjectTest => true
      _ => false
    }
    _ => false
  }
}

test fn witness_classifier_live_and_undeclared_both_classify_as_live_observation() -> Bool {
  let declared = gunbc.witness_execution_class.classify_witness(disposition: live_disposition(), effect_obligation: false, interpreter_subject: false, carriage: gunbc.witness_execution_class.CarriedInEnrolledBundle { bundle_identity: "09d7d2e53554c783", member: "meet" })
  let undeclared = gunbc.witness_execution_class.classify_witness(disposition: v2.std.optional.Absent, effect_obligation: false, interpreter_subject: false, carriage: gunbc.witness_execution_class.CarriedInEnrolledBundle { bundle_identity: "09d7d2e53554c783", member: "meet" })
  match declared {
    gunbc.witness_execution_class.NativeLiveObservation => match undeclared {
      gunbc.witness_execution_class.NativeLiveObservation => true
      _ => false
    }
    _ => false
  }
}

test fn witness_classifier_hermetic_splits_on_emitter_carriage_with_typed_cause() -> Bool {
  let carried = gunbc.witness_execution_class.classify_witness(disposition: pure_disposition(), effect_obligation: false, interpreter_subject: false, carriage: gunbc.witness_execution_class.CarriedInEnrolledBundle { bundle_identity: "09d7d2e53554c783", member: "meet" })
  let blocked = gunbc.witness_execution_class.classify_witness(disposition: pure_disposition(), effect_obligation: false, interpreter_subject: false, carriage: gunbc.witness_execution_class.NoEmitterCarriage { cause: gunbc.witness_execution_class.HostCapabilityUnavailable { capability: "linux-only procfs read" } })
  match carried {
    gunbc.witness_execution_class.NativeRequired => match blocked {
      gunbc.witness_execution_class.NativeBlocked { cause: c } => match c {
        gunbc.witness_execution_class.HostCapabilityUnavailable { capability: _ } => true
        _ => false
      }
      _ => false
    }
    _ => false
  }
}

fn census_fixture_rows() -> List<gunbc.witness_execution_class.WitnessClassRow> {
  [
    gunbc.witness_execution_class.WitnessClassRow { entry: "a_test.dag", function: "w_meet", class: gunbc.witness_execution_class.NativeRequired },
    gunbc.witness_execution_class.WitnessClassRow { entry: "a_test.dag", function: "w_live", class: gunbc.witness_execution_class.NativeLiveObservation },
    gunbc.witness_execution_class.WitnessClassRow { entry: "b_test.dag", function: "w_wet", class: gunbc.witness_execution_class.EffectObligation },
    gunbc.witness_execution_class.WitnessClassRow { entry: "c_test.dag", function: "w_interp", class: gunbc.witness_execution_class.InterpreterSubjectTest },
    gunbc.witness_execution_class.WitnessClassRow { entry: "d_test.dag", function: "w_blocked", class: gunbc.witness_execution_class.NativeBlocked { cause: gunbc.witness_execution_class.GeneralWitnessTargetModelUnavailable } }
  ]
}

test fn witness_census_partitions_the_population_exactly() -> Bool {
  let c = gunbc.witness_execution_class.census_of(rows: census_fixture_rows())
  gunbc.witness_execution_class.census_accounts_for_every_row(rows: census_fixture_rows())
    && c.total == 5
    && c.native_required == 1
    && c.native_live_observation == 1
    && c.effect_obligation == 1
    && c.interpreter_subject == 1
    && c.native_blocked == 1
}

test fn witness_census_RED_planted_duplicate_identity_refuses_exactly_once() -> Bool {
  let planted = concat(census_fixture_rows(), [gunbc.witness_execution_class.WitnessClassRow { entry: "a_test.dag", function: "w_meet", class: gunbc.witness_execution_class.EffectObligation }])
  gunbc.witness_execution_class.every_identity_classified_exactly_once(rows: census_fixture_rows())
    && !gunbc.witness_execution_class.every_identity_classified_exactly_once(rows: planted)
}

fn first_declared_axis() -> gunbc.witness_execution_class.ClassificationAxis {
  match declared_class_precedence.first() {
    v2.std.optional.Present { value: axis } => axis
    v2.std.optional.Absent => gunbc.witness_execution_class.CarriageAxis
  }
}

test fn witness_declared_precedence_decides_dual_descriptions() -> Bool {
  let effect_and_interp = gunbc.witness_execution_class.classify_witness(disposition: live_disposition(), effect_obligation: true, interpreter_subject: true, carriage: gunbc.witness_execution_class.NoEmitterCarriage { cause: gunbc.witness_execution_class.GeneralWitnessTargetModelUnavailable })
  let interp_and_live = gunbc.witness_execution_class.classify_witness(disposition: live_disposition(), effect_obligation: false, interpreter_subject: true, carriage: gunbc.witness_execution_class.NoEmitterCarriage { cause: gunbc.witness_execution_class.GeneralWitnessTargetModelUnavailable })
  let live_and_carried = gunbc.witness_execution_class.classify_witness(disposition: live_disposition(), effect_obligation: false, interpreter_subject: false, carriage: gunbc.witness_execution_class.CarriedInEnrolledBundle { bundle_identity: "09d7d2e53554c783", member: "meet" })
  gunbc.witness_execution_class.axis_of_class(class: effect_and_interp) == first_declared_axis()
    && (gunbc.witness_execution_class.axis_rank(axis: gunbc.witness_execution_class.axis_of_class(class: effect_and_interp)) < gunbc.witness_execution_class.axis_rank(axis: gunbc.witness_execution_class.InterpreterSubjectAxis))
    && (gunbc.witness_execution_class.axis_rank(axis: gunbc.witness_execution_class.axis_of_class(class: interp_and_live)) < gunbc.witness_execution_class.axis_rank(axis: gunbc.witness_execution_class.LiveObservationAxis))
    && (gunbc.witness_execution_class.axis_rank(axis: gunbc.witness_execution_class.axis_of_class(class: live_and_carried)) < gunbc.witness_execution_class.axis_rank(axis: gunbc.witness_execution_class.CarriageAxis))
}

test fn witness_declared_precedence_RED_reversed_order_would_lose() -> Bool {
  let live_and_carried = gunbc.witness_execution_class.classify_witness(disposition: live_disposition(), effect_obligation: false, interpreter_subject: false, carriage: gunbc.witness_execution_class.CarriedInEnrolledBundle { bundle_identity: "09d7d2e53554c783", member: "meet" })
  !(gunbc.witness_execution_class.axis_of_class(class: live_and_carried) == gunbc.witness_execution_class.CarriageAxis)
}
