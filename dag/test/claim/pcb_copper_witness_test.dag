module test.claim.pcb_copper_witness

import std.logic { Bool }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.measure { micrometer }
import product.compute_board.analog { ElectricalNet, NetIdentity }
import product.pcb.stackup {
  AdmittedStackup,
  CopperLayer,
  DielectricLayer,
  GroundPlane,
  SignalLayer,
  Stackup,
  StackupPly,
  StackupAdmitted,
  StackupRefused,
  admit_stackup,
}
import product.pcb.copper {
  CopperAdmitted,
  CopperLayerRef,
  CopperRefused,
  LayerOutsideStackup,
  LayerSelected,
  NetCopperRealization,
  NetHasTwoConductorsOnOneLayer,
  NetSplitAcrossLayersWithoutAVia,
  Via,
  ViaJoinsALayerToItself,
  ViaNamesNoSuchNet,
  ViaSelectedAgainstAnotherStackup,
  RealizationNamesNoSuchNet,
  RealizationSelectedAgainstAnotherStackup,
  admit_copper,
  copper_is_complete_over_nets,
  copper_layer_function,
  copper_layer_ordinal,
  select_copper_layer,
  unrealized_nets,
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data sig: CopperLayer = CopperLayer { function: SignalLayer, thickness: micrometer(count: 17) }
data gnd: CopperLayer = CopperLayer { function: GroundPlane, thickness: micrometer(count: 17) }
data core: DielectricLayer = DielectricLayer { thickness: micrometer(count: 100), material: "FR-4" }

// Top signal, then ground, then signal: three copper layers, ordinals 0, 1, 2.
data three_layer: Stackup = Stackup {
  top: sig,
  plies: [
    StackupPly { dielectric: core, copper: gnd },
    StackupPly { dielectric: core, copper: sig },
  ],
}

data board_authority: DeclarationRef = DeclarationRef {
  module_path: "test.claim.pcb_copper_witness",
  decl_name: "three_layer",
  field: WholeDeclaration,
}

data vcc: NetIdentity = "VCC" as NetIdentity
data gnd_net: NetIdentity = "GND" as NetIdentity
data absent_net: NetIdentity = "SPI_CLK" as NetIdentity

// THE FIXTURE IS A BARE NET ROSTER, AND THAT IS THE POINT. Copper takes the nets, not a circuit
// intent, so this witness hands it a roster belonging to no analog article at all. If the carrier
// still required an AnalogCircuitIntent this file would not compile, which makes the decoupling a
// fact the suite depends on rather than a claim in a comment.
data board_nets: List<ElectricalNet> = [
  ElectricalNet { identity: vcc, members: [] },
  ElectricalNet { identity: gnd_net, members: [] },
]

// A SECOND, DIFFERENT BOARD. Same layer count and same functions at every ordinal, differing only
// in copper thickness and in the declaration admission judged - so an ordinal alone cannot tell the
// two apart, which is exactly the confusion the binding has to catch.
data thick: CopperLayer = CopperLayer { function: SignalLayer, thickness: micrometer(count: 35) }
data thick_gnd: CopperLayer = CopperLayer { function: GroundPlane, thickness: micrometer(count: 35) }

data other_board: Stackup = Stackup {
  top: thick,
  plies: [
    StackupPly { dielectric: core, copper: thick_gnd },
    StackupPly { dielectric: core, copper: thick },
  ],
}

data other_authority: DeclarationRef = DeclarationRef {
  module_path: "test.claim.pcb_copper_witness",
  decl_name: "other_board",
  field: WholeDeclaration,
}

fn admitted_board(s: Stackup, authority: DeclarationRef) -> AdmittedStackup? {
  match admit_stackup(s: s, authority: authority) {
    StackupAdmitted { admitted: a } => Present { value: a }
    StackupRefused { causes: _ } => none
  }
}

fn admitted_three_layer_selection(ordinal: Int) -> Bool {
  match admit_stackup(s: three_layer, authority: board_authority) {
    StackupRefused { causes: _ } => false
    StackupAdmitted { admitted: a } =>
      match select_copper_layer(a: a, ordinal: ordinal) {
        LayerSelected { layer: _ } => true
        LayerOutsideStackup { requested: _, layer_count: _ } => false
      }
  }
}

// A layer reference reports the ordinal asked for AND the function of the layer that is actually
// there — the second is what makes the reference a read of the stackup rather than a restatement of
// the request. Ordinal 1 is the ground plane, and the reference knows it.
test fn w_a_selected_layer_carries_the_function_it_found() -> Bool {
  match admit_stackup(s: three_layer, authority: board_authority) {
    StackupRefused { causes: _ } => false
    StackupAdmitted { admitted: a } =>
      match select_copper_layer(a: a, ordinal: 1) {
        LayerOutsideStackup { requested: _, layer_count: _ } => false
        LayerSelected { layer: l } =>
          copper_layer_ordinal(r: l) == 1
            && match copper_layer_function(r: l) {
              GroundPlane => true
              SignalLayer => false
              PowerPlane => false
              MixedSignalAndPlane => false
            }
      }
  }
}

// The top layer is signal and the bottom layer is signal, so reading only ordinal 1 could not
// distinguish a real lookup from a constant. Reading 0 and 2 as well pins that the fold walks.
test fn w_selection_distinguishes_the_layers_it_walks_past() -> Bool {
  match admit_stackup(s: three_layer, authority: board_authority) {
    StackupRefused { causes: _ } => false
    StackupAdmitted { admitted: a } =>
      match select_copper_layer(a: a, ordinal: 0) {
        LayerOutsideStackup { requested: _, layer_count: _ } => false
        LayerSelected { layer: top } =>
          match select_copper_layer(a: a, ordinal: 2) {
            LayerOutsideStackup { requested: _, layer_count: _ } => false
            LayerSelected { layer: bottom } =>
              copper_layer_ordinal(r: top) == 0
                && copper_layer_ordinal(r: bottom) == 2
                && match copper_layer_function(r: top) {
                  SignalLayer => true
                  GroundPlane => false
                  PowerPlane => false
                  MixedSignalAndPlane => false
                }
          }
      }
  }
}

// RED control: an ordinal past the last layer refuses and reports BOTH numbers, rather than
// clamping to the nearest real layer. A clamp would put copper on a layer nobody asked for.
test fn w_red_an_ordinal_outside_the_stackup_refuses_with_both_numbers() -> Bool {
  match admit_stackup(s: three_layer, authority: board_authority) {
    StackupRefused { causes: _ } => false
    StackupAdmitted { admitted: a } =>
      match select_copper_layer(a: a, ordinal: 3) {
        LayerSelected { layer: _ } => false
        LayerOutsideStackup { requested: r, layer_count: n } => r == 3 && n == 3
      }
  }
}

test fn w_red_a_negative_ordinal_refuses() -> Bool {
  !admitted_three_layer_selection(ordinal: 0 - 1)
    && admitted_three_layer_selection(ordinal: 0)
}

fn realization_against(s: Stackup, authority: DeclarationRef, net: NetIdentity, ordinal: Int) -> List<NetCopperRealization> {
  match admit_stackup(s: s, authority: authority) {
    StackupRefused { causes: _ } => []
    StackupAdmitted { admitted: a } =>
      match select_copper_layer(a: a, ordinal: ordinal) {
        LayerOutsideStackup { requested: _, layer_count: _ } => []
        LayerSelected { layer: l } => [NetCopperRealization { net: net, layer: l }]
      }
  }
}

fn realization_on(net: NetIdentity, ordinal: Int) -> List<NetCopperRealization> {
  match admit_stackup(s: three_layer, authority: board_authority) {
    StackupRefused { causes: _ } => []
    StackupAdmitted { admitted: a } =>
      match select_copper_layer(a: a, ordinal: ordinal) {
        LayerOutsideStackup { requested: _, layer_count: _ } => []
        LayerSelected { layer: l } => [NetCopperRealization { net: net, layer: l }]
      }
  }
}

test fn w_copper_naming_real_nets_admits() -> Bool {
  match admitted_board(s: three_layer, authority: board_authority) {
    Absent => false
    Present { value: board } => {
  let rs = realization_on(net: vcc, ordinal: 0) + realization_on(net: gnd_net, ordinal: 1)
  match admit_copper(nets: board_nets, board: board, rs: rs, vs: []) {
    CopperAdmitted { realizations: out } => count(out) == 2
    CopperRefused { causes: _ } => false
  }
}
  }
}

// RED control: THE RENAMED-NET CLASS. Copper naming a net the schematic does not carry is a
// conductor belonging to nothing. A count would not see it — two nets, two realizations — which is
// why admission joins on identity.
test fn w_red_copper_naming_a_net_the_schematic_lacks_is_refused() -> Bool {
  match admitted_board(s: three_layer, authority: board_authority) {
    Absent => false
    Present { value: board } => {
  let rs = realization_on(net: vcc, ordinal: 0) + realization_on(net: absent_net, ordinal: 1)
  count(rs) == count(board_nets)
    && match admit_copper(nets: board_nets, board: board, rs: rs, vs: []) {
      CopperAdmitted { realizations: _ } => false
      CopperRefused { causes: c } =>
        count(c) == 1
          && count(filter(c, x => match x {
            RealizationNamesNoSuchNet { net: n } => n == absent_net
            NetHasTwoConductorsOnOneLayer { net: _ } => false
            NetHasTwoConductorsOnOneLayer { net: _ } => false
          NetSplitAcrossLayersWithoutAVia { net: _ } => false
            ViaNamesNoSuchNet { net: _ } => false
            ViaSelectedAgainstAnotherStackup { net: _ } => false
            ViaJoinsALayerToItself { net: _, ordinal: _ } => false
            RealizationSelectedAgainstAnotherStackup { net: _ } => false
          })) == 1
    }
}
  }
}

// RED control: one net on two layers with NO via is two conductors claiming one name. Exactly ONE
// cause, because the problem is a fact about the net rather than about either row - the same net
// reported twice would be a duplicate, not a second finding.
test fn w_red_a_net_split_across_layers_without_a_via_is_refused() -> Bool {
  match admitted_board(s: three_layer, authority: board_authority) {
    Absent => false
    Present { value: board } => {
  let rs = realization_on(net: vcc, ordinal: 0) + realization_on(net: vcc, ordinal: 2)
  match admit_copper(nets: board_nets, board: board, rs: rs, vs: []) {
    CopperAdmitted { realizations: _ } => false
    CopperRefused { causes: c } =>
      count(rs) == 2
        && count(c) == 1
        && count(filter(c, x => match x {
          NetHasTwoConductorsOnOneLayer { net: _ } => false
          NetSplitAcrossLayersWithoutAVia { net: n } => n == vcc
          RealizationNamesNoSuchNet { net: _ } => false
          RealizationSelectedAgainstAnotherStackup { net: _ } => false
          ViaNamesNoSuchNet { net: _ } => false
          ViaSelectedAgainstAnotherStackup { net: _ } => false
          ViaJoinsALayerToItself { net: _, ordinal: _ } => false
        })) == 1
  }
}
  }
}

// ADMISSION AND COVERAGE ARE SEPARATE AXES. An empty copper set is internally consistent — nothing
// wrong is realized — and covers nothing. If one arm carried both, an unrouted board would report
// as admitted-and-therefore-done.
test fn w_an_empty_board_admits_and_covers_nothing() -> Bool {
  match admitted_board(s: three_layer, authority: board_authority) {
    Absent => false
    Present { value: board } => {
  match admit_copper(nets: board_nets, board: board, rs: [], vs: []) {
    CopperRefused { causes: _ } => false
    CopperAdmitted { realizations: _ } =>
      count(unrealized_nets(nets: board_nets, rs: [])) == 2
        && !copper_is_complete_over_nets(nets: board_nets, rs: [])
  }
}
  }
}

test fn w_coverage_completes_only_when_every_net_is_realized() -> Bool {
  let partial = realization_on(net: vcc, ordinal: 0)
  let full = partial + realization_on(net: gnd_net, ordinal: 1)
  count(unrealized_nets(nets: board_nets, rs: partial)) == 1
    && !copper_is_complete_over_nets(nets: board_nets, rs: partial)
    && copper_is_complete_over_nets(nets: board_nets, rs: full)
}

// RED control: THE CROSS-STACKUP CLASS. Both boards have three layers with identical functions at
// every ordinal, so the layer reference selected against other_board is indistinguishable from one
// selected against three_layer by ordinal or function - only the bound declaration separates them.
// Admitting it against three_layer must refuse, or the seal proved the ref came from SOME admitted
// stackup and never which one.
test fn w_red_copper_selected_against_another_stackup_is_refused() -> Bool {
  match admitted_board(s: three_layer, authority: board_authority) {
    Absent => false
    Present { value: board } => {
      let foreign = realization_against(s: other_board, authority: other_authority, net: vcc, ordinal: 1)
      let native = realization_on(net: vcc, ordinal: 1)
      count(foreign) == 1
        && count(native) == 1
        && match admit_copper(nets: board_nets, board: board, rs: native, vs: []) {
          CopperRefused { causes: _ } => false
          CopperAdmitted { realizations: _ } =>
            match admit_copper(nets: board_nets, board: board, rs: foreign, vs: []) {
              CopperAdmitted { realizations: _ } => false
              CopperRefused { causes: c } =>
                count(filter(c, x => match x {
                  RealizationSelectedAgainstAnotherStackup { net: n } => n == vcc
                  RealizationNamesNoSuchNet { net: _ } => false
                  NetHasTwoConductorsOnOneLayer { net: _ } => false
            NetHasTwoConductorsOnOneLayer { net: _ } => false
          NetSplitAcrossLayersWithoutAVia { net: _ } => false
            ViaNamesNoSuchNet { net: _ } => false
            ViaSelectedAgainstAnotherStackup { net: _ } => false
            ViaJoinsALayerToItself { net: _, ordinal: _ } => false
                })) == 1
            }
        }
    }
  }
}

fn layer_of(a: AdmittedStackup, ordinal: Int) -> CopperLayerRef? {
  match select_copper_layer(a: a, ordinal: ordinal) {
    LayerSelected { layer: l } => Present { value: l }
    LayerOutsideStackup { requested: _, layer_count: _ } => none
  }
}

// THE POINT OF THE WHOLE INCREMENT, asserted in BOTH directions in one run: the identical split
// realization refuses with no via and admits with one. If only the admitting half were asserted, a
// refusal that had quietly stopped firing would read as success.
test fn w_a_via_makes_a_split_net_admissible() -> Bool {
  match admitted_board(s: three_layer, authority: board_authority) {
    Absent => false
    Present { value: board } => {
      let split = realization_on(net: vcc, ordinal: 0) + realization_on(net: vcc, ordinal: 2)
      match layer_of(a: board, ordinal: 0) {
        Absent => false
        Present { value: top } =>
          match layer_of(a: board, ordinal: 2) {
            Absent => false
            Present { value: bottom } => {
              let joined = [Via { net: vcc, from_layer: top, to_layer: bottom }]
              count(split) == 2
                && match admit_copper(nets: board_nets, board: board, rs: split, vs: []) {
                  CopperAdmitted { realizations: _ } => false
                  CopperRefused { causes: _ } =>
                    match admit_copper(nets: board_nets, board: board, rs: split, vs: joined) {
                      CopperRefused { causes: _ } => false
                      CopperAdmitted { realizations: out } => count(out) == 2
                    }
                }
            }
          }
      }
    }
  }
}

// RED control: a via belonging to a DIFFERENT net does not route this one. Same two layers, same
// count of vias — only the net identity differs, so a check that merely counted vias would pass.
test fn w_red_a_via_on_another_net_does_not_route_this_one() -> Bool {
  match admitted_board(s: three_layer, authority: board_authority) {
    Absent => false
    Present { value: board } => {
      let split = realization_on(net: vcc, ordinal: 0) + realization_on(net: vcc, ordinal: 2)
      match layer_of(a: board, ordinal: 0) {
        Absent => false
        Present { value: top } =>
          match layer_of(a: board, ordinal: 2) {
            Absent => false
            Present { value: bottom } => {
              let wrong_net = [Via { net: gnd_net, from_layer: top, to_layer: bottom }]
              match admit_copper(nets: board_nets, board: board, rs: split, vs: wrong_net) {
                CopperAdmitted { realizations: _ } => false
                CopperRefused { causes: c } =>
                  count(filter(c, x => match x {
                    NetHasTwoConductorsOnOneLayer { net: _ } => false
          NetSplitAcrossLayersWithoutAVia { net: n } => n == vcc
                    RealizationNamesNoSuchNet { net: _ } => false
                    RealizationSelectedAgainstAnotherStackup { net: _ } => false
                    ViaNamesNoSuchNet { net: _ } => false
                    ViaSelectedAgainstAnotherStackup { net: _ } => false
                    ViaJoinsALayerToItself { net: _, ordinal: _ } => false
                  })) > 0
              }
            }
          }
      }
    }
  }
}

// RED control: a via whose endpoints are the same layer is a drilled hole connecting nothing, and
// it reports the ordinal so the author knows which one.
test fn w_red_a_via_from_a_layer_to_itself_is_refused() -> Bool {
  match admitted_board(s: three_layer, authority: board_authority) {
    Absent => false
    Present { value: board } =>
      match layer_of(a: board, ordinal: 1) {
        Absent => false
        Present { value: mid } => {
          let degenerate = [Via { net: vcc, from_layer: mid, to_layer: mid }]
          match admit_copper(nets: board_nets, board: board, rs: realization_on(net: vcc, ordinal: 1), vs: degenerate) {
            CopperAdmitted { realizations: _ } => false
            CopperRefused { causes: c } =>
              count(filter(c, x => match x {
                ViaJoinsALayerToItself { net: n, ordinal: o } => n == vcc && o == 1
                NetHasTwoConductorsOnOneLayer { net: _ } => false
            NetHasTwoConductorsOnOneLayer { net: _ } => false
          NetSplitAcrossLayersWithoutAVia { net: _ } => false
                RealizationNamesNoSuchNet { net: _ } => false
                RealizationSelectedAgainstAnotherStackup { net: _ } => false
                ViaNamesNoSuchNet { net: _ } => false
                ViaSelectedAgainstAnotherStackup { net: _ } => false
              })) == 1
          }
        }
      }
  }
}

// RED control: a via inherits the stackup binding through its endpoints, so one selected against
// another board refuses without the via model needing its own check for it.
test fn w_red_a_via_selected_against_another_stackup_is_refused() -> Bool {
  match admitted_board(s: three_layer, authority: board_authority) {
    Absent => false
    Present { value: board } =>
      match admitted_board(s: other_board, authority: other_authority) {
        Absent => false
        Present { value: elsewhere } =>
          match layer_of(a: board, ordinal: 0) {
            Absent => false
            Present { value: here } =>
              match layer_of(a: elsewhere, ordinal: 2) {
                Absent => false
                Present { value: there } => {
                  let crossed = [Via { net: vcc, from_layer: here, to_layer: there }]
                  match admit_copper(nets: board_nets, board: board, rs: realization_on(net: vcc, ordinal: 0), vs: crossed) {
                    CopperAdmitted { realizations: _ } => false
                    CopperRefused { causes: c } =>
                      count(filter(c, x => match x {
                        ViaSelectedAgainstAnotherStackup { net: n } => n == vcc
                        NetHasTwoConductorsOnOneLayer { net: _ } => false
            NetHasTwoConductorsOnOneLayer { net: _ } => false
          NetSplitAcrossLayersWithoutAVia { net: _ } => false
                        RealizationNamesNoSuchNet { net: _ } => false
                        RealizationSelectedAgainstAnotherStackup { net: _ } => false
                        ViaNamesNoSuchNet { net: _ } => false
                        ViaJoinsALayerToItself { net: _, ordinal: _ } => false
                      })) == 1
                  }
                }
              }
          }
      }
  }
}

// RED control: TWO CONDUCTORS ON ONE LAYER, WITH A VIA PRESENT. This is the case the split refusal
// stopped catching when it narrowed to via-reachability: both rows sit on layer 0, a vcc via touches
// layer 0, so every realized layer IS via-reached and the routing question is satisfied. It is still
// two rows claiming one net on one layer. Confirmed admitted by a probe before this refusal existed.
test fn w_red_two_conductors_on_one_layer_are_refused_even_with_a_via() -> Bool {
  match admitted_board(s: three_layer, authority: board_authority) {
    Absent => false
    Present { value: board } => {
      let dup = realization_on(net: vcc, ordinal: 0) + realization_on(net: vcc, ordinal: 0)
      match layer_of(a: board, ordinal: 0) {
        Absent => false
        Present { value: top } =>
          match layer_of(a: board, ordinal: 1) {
            Absent => false
            Present { value: mid } => {
              let v = [Via { net: vcc, from_layer: top, to_layer: mid }]
              count(dup) == 2
                && match admit_copper(nets: board_nets, board: board, rs: dup, vs: v) {
                  CopperAdmitted { realizations: _ } => false
                  CopperRefused { causes: c } =>
                    count(filter(c, x => match x {
                      NetHasTwoConductorsOnOneLayer { net: n } => n == vcc
                      NetSplitAcrossLayersWithoutAVia { net: _ } => false
                      RealizationNamesNoSuchNet { net: _ } => false
                      RealizationSelectedAgainstAnotherStackup { net: _ } => false
                      ViaNamesNoSuchNet { net: _ } => false
                      ViaSelectedAgainstAnotherStackup { net: _ } => false
                      ViaJoinsALayerToItself { net: _, ordinal: _ } => false
                    })) == 1
                }
            }
          }
      }
    }
  }
}
