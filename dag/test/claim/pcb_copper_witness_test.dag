module test.claim.pcb_copper_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data sig: product.pcb.stackup.CopperLayer = product.pcb.stackup.CopperLayer { function: product.pcb.stackup.SignalLayer, thickness: std.measure.micrometer(count: 17) }
data gnd: product.pcb.stackup.CopperLayer = product.pcb.stackup.CopperLayer { function: product.pcb.stackup.GroundPlane, thickness: std.measure.micrometer(count: 17) }
data core: product.pcb.stackup.DielectricLayer = product.pcb.stackup.DielectricLayer { thickness: std.measure.micrometer(count: 100), material: "FR-4" }

// Top signal, then ground, then signal: three copper layers, ordinals 0, 1, 2.
data three_layer: product.pcb.stackup.Stackup = product.pcb.stackup.Stackup {
  top: sig,
  plies: [
    product.pcb.stackup.StackupPly { dielectric: core, copper: gnd },
    product.pcb.stackup.StackupPly { dielectric: core, copper: sig },
  ],
}

data board_authority: std.decl_ref.DeclarationRef = std.decl_ref.DeclarationRef {
  module_path: "test.claim.pcb_copper_witness",
  decl_name: "three_layer",
  field: std.decl_ref.WholeDeclaration,
}

data vcc: product.compute_board.analog.NetIdentity = "VCC" as product.compute_board.analog.NetIdentity
data gnd_net: product.compute_board.analog.NetIdentity = "GND" as product.compute_board.analog.NetIdentity
data absent_net: product.compute_board.analog.NetIdentity = "SPI_CLK" as product.compute_board.analog.NetIdentity

// THE FIXTURE IS A BARE NET ROSTER, AND THAT IS THE POINT. Copper takes the nets, not a circuit
// intent, so this witness can hand it a roster that belongs to no analog article at all. If the
// carrier still required an AnalogCircuitIntent, this file would not compile -- which makes the
// decoupling a fact the suite depends on rather than a claim in a comment. The identities are
// motherboard rails rather than the RC specimen's, for the same reason.
data board_nets: List<product.compute_board.analog.ElectricalNet> = [
  product.compute_board.analog.ElectricalNet { identity: vcc, members: [] },
  product.compute_board.analog.ElectricalNet { identity: gnd_net, members: [] },
]

// A SECOND, DIFFERENT BOARD. Same layer count and same functions at every ordinal, differing only
// in copper thickness and in the declaration admission judged - so an ordinal alone cannot tell the
// two apart, which is exactly the confusion the binding has to catch.
data thick: product.pcb.stackup.CopperLayer = product.pcb.stackup.CopperLayer { function: product.pcb.stackup.SignalLayer, thickness: std.measure.micrometer(count: 35) }
data thick_gnd: product.pcb.stackup.CopperLayer = product.pcb.stackup.CopperLayer { function: product.pcb.stackup.GroundPlane, thickness: std.measure.micrometer(count: 35) }

data other_board: product.pcb.stackup.Stackup = product.pcb.stackup.Stackup {
  top: thick,
  plies: [
    product.pcb.stackup.StackupPly { dielectric: core, copper: thick_gnd },
    product.pcb.stackup.StackupPly { dielectric: core, copper: thick },
  ],
}

data other_authority: std.decl_ref.DeclarationRef = std.decl_ref.DeclarationRef {
  module_path: "test.claim.pcb_copper_witness",
  decl_name: "other_board",
  field: std.decl_ref.WholeDeclaration,
}

fn admitted_board(s: product.pcb.stackup.Stackup, authority: std.decl_ref.DeclarationRef) -> product.pcb.stackup.AdmittedStackup? {
  match product.pcb.stackup.admit_stackup(s: s, authority: authority) {
    product.pcb.stackup.StackupAdmitted { admitted: a } => Present { value: a }
    product.pcb.stackup.StackupRefused { causes: _ } => none
  }
}

fn admitted_three_layer_selection(ordinal: Int) -> Bool {
  match product.pcb.stackup.admit_stackup(s: three_layer, authority: board_authority) {
    product.pcb.stackup.StackupRefused { causes: _ } => false
    product.pcb.stackup.StackupAdmitted { admitted: a } =>
      match product.pcb.copper.select_copper_layer(a: a, ordinal: ordinal) {
        product.pcb.copper.LayerSelected { layer: _ } => true
        product.pcb.copper.LayerOutsideStackup { requested: _, layer_count: _ } => false
      }
  }
}

// A layer reference reports the ordinal asked for AND the function of the layer that is actually
// there — the second is what makes the reference a read of the stackup rather than a restatement of
// the request. Ordinal 1 is the ground plane, and the reference knows it.
test fn w_a_selected_layer_carries_the_function_it_found() -> Bool {
  match product.pcb.stackup.admit_stackup(s: three_layer, authority: board_authority) {
    product.pcb.stackup.StackupRefused { causes: _ } => false
    product.pcb.stackup.StackupAdmitted { admitted: a } =>
      match product.pcb.copper.select_copper_layer(a: a, ordinal: 1) {
        product.pcb.copper.LayerOutsideStackup { requested: _, layer_count: _ } => false
        product.pcb.copper.LayerSelected { layer: l } =>
          product.pcb.copper.copper_layer_ordinal(r: l) == 1
            && match product.pcb.copper.copper_layer_function(r: l) {
              product.pcb.stackup.GroundPlane => true
              product.pcb.stackup.SignalLayer => false
              PowerPlane => false
              MixedSignalAndPlane => false
            }
      }
  }
}

// The top layer is signal and the bottom layer is signal, so reading only ordinal 1 could not
// distinguish a real lookup from a constant. Reading 0 and 2 as well pins that the fold walks.
test fn w_selection_distinguishes_the_layers_it_walks_past() -> Bool {
  match product.pcb.stackup.admit_stackup(s: three_layer, authority: board_authority) {
    product.pcb.stackup.StackupRefused { causes: _ } => false
    product.pcb.stackup.StackupAdmitted { admitted: a } =>
      match product.pcb.copper.select_copper_layer(a: a, ordinal: 0) {
        product.pcb.copper.LayerOutsideStackup { requested: _, layer_count: _ } => false
        product.pcb.copper.LayerSelected { layer: top } =>
          match product.pcb.copper.select_copper_layer(a: a, ordinal: 2) {
            product.pcb.copper.LayerOutsideStackup { requested: _, layer_count: _ } => false
            product.pcb.copper.LayerSelected { layer: bottom } =>
              product.pcb.copper.copper_layer_ordinal(r: top) == 0
                && product.pcb.copper.copper_layer_ordinal(r: bottom) == 2
                && match product.pcb.copper.copper_layer_function(r: top) {
                  product.pcb.stackup.SignalLayer => true
                  product.pcb.stackup.GroundPlane => false
                  PowerPlane => false
                  MixedSignalAndPlane => false
                }
          }
      }
  }
}

// RED control: an ordinal past the last layer refuses and reports BOTH numbers, rather than
// clamping to the nearest real layer. A clamp would put copper on a layer nobody asked for.
test fn w_red_an_ordinal_outside_the_stackup_refuses_with_both_numbers() -> Bool {
  match product.pcb.stackup.admit_stackup(s: three_layer, authority: board_authority) {
    product.pcb.stackup.StackupRefused { causes: _ } => false
    product.pcb.stackup.StackupAdmitted { admitted: a } =>
      match product.pcb.copper.select_copper_layer(a: a, ordinal: 3) {
        product.pcb.copper.LayerSelected { layer: _ } => false
        product.pcb.copper.LayerOutsideStackup { requested: r, layer_count: n } => r == 3 && n == 3
      }
  }
}

test fn w_red_a_negative_ordinal_refuses() -> Bool {
  !admitted_three_layer_selection(ordinal: 0 - 1)
    && admitted_three_layer_selection(ordinal: 0)
}

fn realization_against(s: product.pcb.stackup.Stackup, authority: std.decl_ref.DeclarationRef, net: product.compute_board.analog.NetIdentity, ordinal: Int) -> List<product.pcb.copper.NetCopperRealization> {
  match product.pcb.stackup.admit_stackup(s: s, authority: authority) {
    product.pcb.stackup.StackupRefused { causes: _ } => []
    product.pcb.stackup.StackupAdmitted { admitted: a } =>
      match product.pcb.copper.select_copper_layer(a: a, ordinal: ordinal) {
        product.pcb.copper.LayerOutsideStackup { requested: _, layer_count: _ } => []
        product.pcb.copper.LayerSelected { layer: l } => [product.pcb.copper.NetCopperRealization { net: net, layer: l }]
      }
  }
}

fn realization_on(net: product.compute_board.analog.NetIdentity, ordinal: Int) -> List<product.pcb.copper.NetCopperRealization> {
  match product.pcb.stackup.admit_stackup(s: three_layer, authority: board_authority) {
    product.pcb.stackup.StackupRefused { causes: _ } => []
    product.pcb.stackup.StackupAdmitted { admitted: a } =>
      match product.pcb.copper.select_copper_layer(a: a, ordinal: ordinal) {
        product.pcb.copper.LayerOutsideStackup { requested: _, layer_count: _ } => []
        product.pcb.copper.LayerSelected { layer: l } => [product.pcb.copper.NetCopperRealization { net: net, layer: l }]
      }
  }
}

test fn w_copper_naming_real_nets_admits() -> Bool {
  match admitted_board(s: three_layer, authority: board_authority) {
    Absent => false
    Present { value: board } => {
  let rs = realization_on(net: vcc, ordinal: 0) + realization_on(net: gnd_net, ordinal: 1)
  match product.pcb.copper.admit_copper(nets: board_nets, board: board, rs: rs) {
    product.pcb.copper.CopperAdmitted { realizations: out } => count(out) == 2
    product.pcb.copper.CopperRefused { causes: _ } => false
  }
}
  }
}

// RED control: THE RENAMED-NET CLASS. Copper naming a net the schematic does not carry is a
// conductor belonging to nothing. A count would not see it — two nets, two realizations — which is
// why admission joins on identity.
test fn w_red_copper_naming_a_net_the_schematic_lacks_is_refused() -> Bool {
  match admitted_board(s: three_layer, authority: board_authority) {
    Absent => false
    Present { value: board } => {
  let rs = realization_on(net: vcc, ordinal: 0) + realization_on(net: absent_net, ordinal: 1)
  count(rs) == count(board_nets)
    && match product.pcb.copper.admit_copper(nets: board_nets, board: board, rs: rs) {
      product.pcb.copper.CopperAdmitted { realizations: _ } => false
      product.pcb.copper.CopperRefused { causes: c } =>
        count(c) == 1
          && count(filter(c, x => match x {
            product.pcb.copper.RealizationNamesNoSuchNet { net: n } => n == absent_net
            product.pcb.copper.NetRealizedMoreThanOnce { net: _ } => false
            product.pcb.copper.RealizationSelectedAgainstAnotherStackup { net: _ } => false
          })) == 1
    }
}
  }
}

// RED control: one net realized on two layers is two conductors claiming one name. Exactly ONE
// cause, because the problem is a fact about the net rather than about either row -- the same net
// reported twice would be a duplicate finding, not a second one.
test fn w_red_a_net_realized_twice_is_refused() -> Bool {
  match admitted_board(s: three_layer, authority: board_authority) {
    Absent => false
    Present { value: board } => {
  let rs = realization_on(net: vcc, ordinal: 0) + realization_on(net: vcc, ordinal: 2)
  match product.pcb.copper.admit_copper(nets: board_nets, board: board, rs: rs) {
    product.pcb.copper.CopperAdmitted { realizations: _ } => false
    product.pcb.copper.CopperRefused { causes: c } =>
      count(rs) == 2
        && count(c) == 1
        && count(filter(c, x => match x {
          product.pcb.copper.NetRealizedMoreThanOnce { net: n } => n == vcc
          product.pcb.copper.RealizationNamesNoSuchNet { net: _ } => false
          product.pcb.copper.RealizationSelectedAgainstAnotherStackup { net: _ } => false
        })) == 1
  }
}
  }
}

// ADMISSION AND COVERAGE ARE SEPARATE AXES. An empty copper set is internally consistent — nothing
// wrong is realized — and covers nothing. If one arm carried both, an unrouted board would report
// as admitted-and-therefore-done.
test fn w_an_empty_board_admits_and_covers_nothing() -> Bool {
  match admitted_board(s: three_layer, authority: board_authority) {
    Absent => false
    Present { value: board } => {
  match product.pcb.copper.admit_copper(nets: board_nets, board: board, rs: []) {
    product.pcb.copper.CopperRefused { causes: _ } => false
    product.pcb.copper.CopperAdmitted { realizations: _ } =>
      count(product.pcb.copper.unrealized_nets(nets: board_nets, rs: [])) == 2
        && !product.pcb.copper.copper_is_complete_over_nets(nets: board_nets, rs: [])
  }
}
  }
}

test fn w_coverage_completes_only_when_every_net_is_realized() -> Bool {
  let partial = realization_on(net: vcc, ordinal: 0)
  let full = partial + realization_on(net: gnd_net, ordinal: 1)
  count(product.pcb.copper.unrealized_nets(nets: board_nets, rs: partial)) == 1
    && !product.pcb.copper.copper_is_complete_over_nets(nets: board_nets, rs: partial)
    && product.pcb.copper.copper_is_complete_over_nets(nets: board_nets, rs: full)
}

// RED control: THE CROSS-STACKUP CLASS. Both boards have three layers with identical functions at
// every ordinal, so the layer reference selected against other_board is indistinguishable from one
// selected against three_layer by ordinal or function - only the bound declaration separates them.
// Admitting it against three_layer must refuse, or the seal proved the ref came from SOME admitted
// stackup and never which one.
test fn w_red_copper_selected_against_another_stackup_is_refused() -> Bool {
  match admitted_board(s: three_layer, authority: board_authority) {
    Absent => false
    Present { value: board } => {
      let foreign = realization_against(s: other_board, authority: other_authority, net: vcc, ordinal: 1)
      let native = realization_on(net: vcc, ordinal: 1)
      count(foreign) == 1
        && count(native) == 1
        && match product.pcb.copper.admit_copper(nets: board_nets, board: board, rs: native) {
          product.pcb.copper.CopperRefused { causes: _ } => false
          product.pcb.copper.CopperAdmitted { realizations: _ } =>
            match product.pcb.copper.admit_copper(nets: board_nets, board: board, rs: foreign) {
              product.pcb.copper.CopperAdmitted { realizations: _ } => false
              product.pcb.copper.CopperRefused { causes: c } =>
                count(filter(c, x => match x {
                  product.pcb.copper.RealizationSelectedAgainstAnotherStackup { net: n } => n == vcc
                  product.pcb.copper.RealizationNamesNoSuchNet { net: _ } => false
                  product.pcb.copper.NetRealizedMoreThanOnce { net: _ } => false
                })) == 1
            }
        }
    }
  }
}
