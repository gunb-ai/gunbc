module test.claim.compute.host_capacity_seal_witness

import std.types { Bool, Int, String, NonEmptyStr }
import std.measure { ByteSize, byte_size, kibibyte_count, kibibyte_from_byte_size_floor }
import product.host_identity { HostIdentity }
import gunbc.compile_census_probe { blocking_subject_census, census_delta_verdict, census_verdict, census_verdict_all, total_blocking_census, census_exit, CensusVerdict }
import gunbc.compile_diagnostic_census { CompileDiagnosticCensus }
import std.process { ProcessExit }
import gunbc.compute.host_capacity {
  compute_root, compute_capacity_root, host_capacity_subject, host_capacity_subject_in,
  host_capacity_home_for_host, host_capacity_build_seat, capacity_seat_for_reservation,
  ComputeSubjectResolution, ComputeSubjectResolved,
  ComputeSubjectHostUnresolved, ComputeBuildPool,
}
import gunbc.roadmap.roadmap_dashboard_instance { host_capacity_home, compute_build_memory_ceiling_default, DashboardInstanceForHost, DashboardInstanceHostUnknown }
import gunbc.runner.runner_slot_desired { gunbc_runner_slot_memory_max, host_build_pool_reservation, build_pool_carve_is_due }
import test.claim.fabric.fabric_storage_fixture { fabric_fixture_instance }

// THE HOST CAPACITY SUBJECT IS MINTED FROM ITS DECLARATION AND CANNOT BE SPELLED OR HANDED OVER A PATH.
// gunbc.compute.host_capacity ComputeCapacitySubject is sole_constructor, built in one place
// (host_capacity_subject_in, reached from host_capacity_subject for a resolved host and from a witness with an
// isolated instance), its root derived there from compute_capacity_slots. Each RED hands the compiler a module
// outside the declaring file and asserts the refusal on the real acceptance path: a forged literal and a forged
// cast are EXACTLY ONE SoleConstructorViolation on ComputeCapacitySubject; the mint handed a path adds at least one
// blocking diagnostic beyond a baseline importing the same closure. Claimed rung: a consumer cannot be handed a
// forged subject or one over the wrong root. NOT claimed: that business code cannot read subject.root (field
// reads are not module-private; the declared residual gunbc.recurring_failure_mode
// a_slot_store_is_built_over_a_literal_path_by_any_module, recorded below by an expecting-red probe).

fn seal_violations(source: String, subject: String) -> CompileDiagnosticCensus {
  blocking_subject_census(source: source, wanted_class: "SoleConstructorViolation", wanted_subject: subject)
}

fn blocking_delta(hostile: String, safe: String, holds: fn(Int) -> Bool) -> CensusVerdict {
  census_delta_verdict(red: total_blocking_census(source: hostile), control: total_blocking_census(source: safe), holds: holds)
}

data capacity_baseline_source: String = "module probe_capacity_baseline\nimport std.types { NonEmptyStr }\nimport product.capacity.event_chain { PartitionId }\nimport gunbc.roadmap.roadmap_dashboard_instance { HostDashboardInstance }\nimport gunbc.compute.host_capacity { ComputeCapacitySubject, ComputeCapacityLedger, ComputeBuildPool, host_capacity_subject_in }\nfn f(n: NonEmptyStr) -> NonEmptyStr {\n  n\n}\n"
data capacity_forged_literal_source: String = "module probe_capacity_literal\nimport std.types { NonEmptyStr }\nimport product.capacity.event_chain { PartitionId }\nimport gunbc.roadmap.roadmap_dashboard_instance { HostDashboardInstance }\nimport gunbc.compute.host_capacity { ComputeCapacitySubject, ComputeCapacityLedger, ComputeBuildPool, host_capacity_subject_in }\nfn f(i: HostDashboardInstance, p: PartitionId) -> ComputeCapacitySubject {\n  ComputeCapacitySubject { instance: i, partition: p }\n}\n"
data capacity_forged_cast_source: String = "module probe_capacity_cast\nimport std.types { NonEmptyStr }\nimport product.capacity.event_chain { PartitionId }\nimport gunbc.roadmap.roadmap_dashboard_instance { HostDashboardInstance }\nimport gunbc.compute.host_capacity { ComputeCapacitySubject, ComputeCapacityLedger, ComputeBuildPool, host_capacity_subject_in }\nfn f(r: NonEmptyStr) -> ComputeCapacitySubject {\n  r as ComputeCapacitySubject\n}\n"
data capacity_path_minter_source: String = "module probe_capacity_path_minter\nimport std.types { NonEmptyStr }\nimport gunbc.fabric.fabric_storage_file_store { fabric_storage_file_root }\nimport product.capacity.event_chain { PartitionId }\nimport gunbc.roadmap.roadmap_dashboard_instance { HostDashboardInstance }\nimport gunbc.compute.host_capacity { ComputeCapacitySubject, ComputeCapacityLedger, ComputeBuildPool, host_capacity_subject_in }\nfn f(i: HostDashboardInstance) -> NonEmptyStr {\n  \"the subject mint takes no path; the deleted path mint is unreachable\"\n}\n"
data capacity_root_out_source: String = "module probe_capacity_root_out\nimport std.types { NonEmptyStr }\nimport product.capacity.event_chain { PartitionId }\nimport gunbc.roadmap.roadmap_dashboard_instance { HostDashboardInstance }\nimport gunbc.compute.host_capacity { ComputeCapacitySubject, ComputeCapacityLedger, ComputeBuildPool, host_capacity_subject_in }\nfn f(i: HostDashboardInstance) -> NonEmptyStr {\n  host_capacity_subject_in(requesting: i, host_instance: i, pool: ComputeBuildPool).instance.instance_id as NonEmptyStr\n}\n"
data capacity_lawful_source: String = "module probe_capacity_lawful\nimport std.types { NonEmptyStr }\nimport product.capacity.event_chain { PartitionId }\nimport gunbc.roadmap.roadmap_dashboard_instance { HostDashboardInstance }\nimport gunbc.compute.host_capacity { ComputeCapacitySubject, ComputeCapacityLedger, ComputeBuildPool, host_capacity_subject_in }\nfn f(i: HostDashboardInstance) -> ComputeCapacityLedger {\n  host_capacity_subject_in(requesting: i, host_instance: i, pool: ComputeBuildPool)\n}\n"

test fn a_forged_capacity_subject_literal_is_refused_at_compile() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: capacity_forged_literal_source, subject: "ComputeCapacitySubject"), holds: fn(n) { n == 1 }))
}

test fn a_forged_capacity_subject_cast_is_refused_at_compile() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: capacity_forged_cast_source, subject: "ComputeCapacitySubject"), holds: fn(n) { n == 1 }))
}

// THE PATH ROUTE IS GONE, attributed by name: the probe that used to mint a capacity store over a path now
// asks for the deleted fabric path mint, and the compiler refuses with exactly one MissingExport keyed on
// fabric_storage_file_root. The subject mint itself takes no path (host_capacity_subject_in's signature no
// longer has a root parameter), so there is nothing left to refuse.
test fn no_capacity_subject_mint_takes_a_path() -> ProcessExit {
  census_exit(census_verdict(census: blocking_subject_census(source: capacity_path_minter_source, wanted_class: "MissingExport", wanted_subject: "fabric_storage_file_root"), holds: fn(n) { n == 1 }))
}

// WHAT THE SEAL DOES NOT CLOSE, restated for the new record: ComputeCapacitySubject no longer carries a
// root at all (it was the deleted path mint's input), so a root is not reachable through a subject. What IS
// reachable is the business key -- the resolved instance -- and a holder could rebuild a path from it: the
// same declared residual (field reads are not module-private), now on the instance rather than on a root.
test fn no_root_is_reachable_through_a_capacity_subject_and_the_instance_is() -> ProcessExit {
  census_exit(blocking_delta(hostile: capacity_root_out_source, safe: capacity_baseline_source, holds: fn(n) { n == 1 }))
}

test fn the_lawful_capacity_subject_mint_is_admitted() -> ProcessExit {
  census_verdict_all(verdicts: [
    blocking_delta(hostile: capacity_lawful_source, safe: capacity_baseline_source, holds: fn(n) { n <= 0 }),
    census_verdict(census: seal_violations(source: capacity_lawful_source, subject: "ComputeCapacitySubject"), holds: fn(n) { n == 0 }),
  ])
}

// THE DECLARATION CONTROL: the provisioned compute directory (compute_root_directory, which the census and
// deployment rows ask for) and the ledger's store chain read ONE member row, compute_root_member. The
// ledger root is exactly the provisioned directory plus this module's own member, so renaming that one row
// moves the mint and the provisioning together; either one spelling its own "compute" would make this false.
test fn the_ledger_root_is_the_provisioned_compute_directory_plus_its_own_member() -> Bool {
  let instance = fabric_fixture_instance(root: "/tmp/gunbc_capacity_decl")
  (compute_capacity_root(host_instance: instance) as String) == join([compute_root(instance: instance) as String, "/capacity"], "")
}

// THE LEDGER HOME IS FOUND BY HOST, NOT BY WALKING A DASHBOARD INSTANCE (remote-build PR 4). The three
// available hosts that are NOT yet admitted -- srv2, srv3, srv4 -- are each given a home by
// host_capacity_home, and the home must (a) root at the ONE host capacity home /opt/gunbc, and (b) carry
// the HOST's OWN identity (host_identity and actuator_host both equal the host), never another host's.
// This is the DISCRIMINATING control for the host-scoped home and it runs on the model alone (dry, a pure
// function): srv3 and srv4 resolve NO dashboard instance at all, so on the old
// gunbc.roadmap.roadmap_dashboard_instance.dashboard_instance_for_host walk they would come back unknown
// and never root at /opt/gunbc; srv2 resolves a /home/briansrls dashboard instance, so the old walk rooted
// its ledger under /home, which the gunbc-build account cannot traverse. If resolution ever goes back to
// walking the instance, srv2's root becomes /home (not /opt/gunbc) and srv3/srv4 stop rooting at
// /opt/gunbc -- this cell reds. It also pins the review fix (review 38602 / artifact 95775) that the home
// is host-derived: host_identity == actuator_host == the host, so no host borrows srv1's identity.
test fn a_host_with_no_dashboard_instance_still_resolves_its_ledger_by_host() -> Bool {
  ["srv2", "srv3", "srv4"] |> all(h => {
    let home = host_capacity_home(host: (h as String) as NonEmptyStr, build_seat: host_capacity_build_seat(host: (h as String) as HostIdentity))
    ((home.instance_root as String) == "/opt/gunbc")
      && ((home.host_identity as String) == (h as String))
      && ((home.actuator_host as String) == (h as String))
  })
}

// THE ADMITTED HOST'S LEDGER IS THE HOST HOME, NOT ITS OWN DASHBOARD INSTANCE. srv1 is the only host on
// the roster today (PR 5 admits the others as it creates and reads back their homes). Its dashboard
// instance ALSO lives at /opt/gunbc, so a root check alone cannot tell the host home from a walk of
// srv1's dashboard instance -- they share the root. The identity fields tell them apart: host home
// carries actuator_host == the host ("srv1"); srv1's live dashboard instance is actuated from the
// operator laptop ("macbook"). host_capacity_home_for_host is the one table; for an admitted host it MUST
// return the host home carrier. If it regressed to walking dashboard_instance_for_host, srv1's ledger
// would resolve through srv1's macbook-actuated dashboard instance and this cell reds even though the
// root still reads /opt/gunbc. This is the control that catches a root-equal walk regression.
test fn an_admitted_host_resolves_its_ledger_to_the_host_carrier_not_its_dashboard_instance() -> Bool {
  match host_capacity_home_for_host(host: "srv1") {
    DashboardInstanceHostUnknown { host: _ } => false
    DashboardInstanceForHost { instance: i } =>
      ((i.instance_root as String) == "/opt/gunbc")
        && ((i.actuator_host as String) == "srv1")
        && ((i.host_identity as String) == "srv1")
  }
}

// A HOST OFF THE ROSTER IS NOT CARVED, SO NO CI MEMORY IS LOST (PR 4, review 95809 -- the conservation
// invariant). The build-pool carve (gunbc.runner runner_slot_desired host_build_pool_reservation) is gated
// on the host being ON the serving roster AND resolving no dashboard instance. srv3/srv4 are not yet admitted
// (PR 5 admits each as it creates and reads back its /opt/gunbc home), so NOTHING is carved for them: their
// reservation is byte_size(0) and their seat is the host default ceiling -- NOT a phantom carved slot. This
// is the red control for the carve gate: were the carve an ungated srv3/srv4 test (as it was), their
// reservation would come back one slot while no rostered pool held it, this cell's zero-check would fail,
// and a full slot per host would be lost to neither side. When PR 5 admits srv3/srv4 the carve and the pool
// appropriation fire in that same change -- host_capacity_build_seat then reads the carved slot and the pool
// equals it (the derived-once mechanism host_capacity_build_seat -> host_build_pool_reservation).
test fn a_host_off_the_roster_is_not_carved_and_keeps_its_full_ci_width() -> Bool {
  let default_kib = kibibyte_count(k: kibibyte_from_byte_size_floor(b: compute_build_memory_ceiling_default))
  kibibyte_count(k: kibibyte_from_byte_size_floor(b: host_build_pool_reservation(host: "srv3" as HostIdentity))) == 0
    && kibibyte_count(k: kibibyte_from_byte_size_floor(b: host_build_pool_reservation(host: "srv4" as HostIdentity))) == 0
    && kibibyte_count(k: kibibyte_from_byte_size_floor(b: host_capacity_build_seat(host: "srv3" as HostIdentity))) == default_kib
    && kibibyte_count(k: kibibyte_from_byte_size_floor(b: host_capacity_build_seat(host: "srv4" as HostIdentity))) == default_kib
}

// THE POSITIVE CASE, PROVEN BEFORE PR 5 EXERCISES IT (manager, review 95809). The carve rule
// (build_pool_carve_is_due) and the seat derivation (capacity_seat_for_reservation) are PURE over the host
// facts / the reservation, so both are witnessed even though PR 4 carves nothing. A host that IS on the
// roster and carries no ledger carves exactly one slot; a rostered host that DOES carry its ledger (srv1)
// and an off-roster host (srv3 today) do NOT. And a full carved slot becomes a seat that, split across the
// pool's seats, is re-multiplied by host_capacity_pool_appropriation back to EXACTLY the carved slot -- the
// slot leaves CI and is held by the ledger pool. PR 5's admission of srv3/srv4 (rostered, no dashboard
// instance) flips THIS proven rule, so it is not an unexercised one when it lands.
test fn a_rostered_host_with_no_instance_carves_one_slot_and_the_seat_is_derived() -> Bool {
  let one_slot_kib = kibibyte_count(k: kibibyte_from_byte_size_floor(b: gunbc_runner_slot_memory_max))
  let carved_seat = capacity_seat_for_reservation(reservation: gunbc_runner_slot_memory_max)
  let home = host_capacity_home(host: "srv3", build_seat: carved_seat)
  let pool_kib = kibibyte_count(k: host_capacity_subject_in(requesting: home, host_instance: home, pool: ComputeBuildPool).appropriation)
  build_pool_carve_is_due(rostered: true, carries_own_ledger: false)
    && !build_pool_carve_is_due(rostered: true, carries_own_ledger: true)
    && !build_pool_carve_is_due(rostered: false, carries_own_ledger: false)
    && one_slot_kib > 0
    && pool_kib == one_slot_kib
    && kibibyte_count(k: kibibyte_from_byte_size_floor(b: carved_seat)) < one_slot_kib
}

// A NON-ROSTER HOST STILL RESOLVES ITS SUBJECT THROUGH ITS DASHBOARD INSTANCE (PR 4, review fix --
// review 38602 / artifact 95775). host_capacity_home_for_host is ONE table covering EVERY host: a roster
// host's home is the /opt/gunbc host home (the two cells above); every OTHER host keeps the dashboard
// instance it resolved BEFORE this PR. macbook (host_identity "macbook"; instance_id
// macbook_local_dashboard_id) is off-roster, so its ledger resolves through dashboard_instance_for_host
// and lands under ITS OWN instance root, NOT the host home. This pins the defect clever-raven caught: the
// first cut returned ComputeSubjectHostUnresolved for any host off the roster, which would have made the
// local compute provider on macbook refuse. If host_capacity_subject refuses a non-roster host that has a
// dashboard instance, this cell reds -- while the two roster cells above stay green -- so BOTH arms of the
// one table are pinned, and "found by host" cannot silently collapse back to "found only on the roster."
test fn a_host_off_the_roster_still_resolves_a_subject_through_its_instance() -> Bool {
  match host_capacity_subject(instance: host_capacity_home(host: "macbook", build_seat: byte_size(0)), pool: ComputeBuildPool) {
    ComputeSubjectHostUnresolved { host: _ } => false
    ComputeSubjectResolved { subject: s, appropriation: _ } =>
      (compute_capacity_root(host_instance: s.instance) as String) != "/opt/gunbc/compute/capacity"
  }
}
