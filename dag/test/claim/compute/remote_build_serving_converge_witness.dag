        scratch_root: est_ok(), scratch_root_mode: scratch_mode_ok(d: d),
        checkout: est_ok(), toolchain: est_absent(), rustup: est_ok(),
        serve_binary_sha256: Present { value: est_s(pin_sha()) }, checkout_revision: Present { value: est_s(pin_rev()) },
        authorized_keys_mode: Present { value: est_s(text: file_mode_octal(mode: d.authorized_keys_mode)) },
        serve_binary_mode: Present { value: est_s(text: file_mode_octal(mode: d.serve_binary_mode)) },
    user_work_slice_max: settled_slice_max(ceiling: user_work_slice_memory_max_for_host(host: d.host)),
    user_work_slice_high: settled_slice_high(ceiling: user_work_slice_memory_max_for_host(host: d.host)),
    user_work_slice_swap: ObservationEstablished { observed: CgroupMemoryLimited { bytes: user_work_slice_memory_swap_max } },
    user_manager_linger: ObservationEstablished { observed: true },
        target_arch: est_s(pin_arch()), ledger_rows: matched_ledger(d: d),
      
        serve_identity: Absent,
    seat_census: RecoverCatalogLegEstablished { entries: [] },)
      let ws = plan_writes(converge_plan(d: d, a: serving_assess(d: d, o: o, pin: pin_ok()), pin: pin_ok(), target_arch: est_s(pin_arch()), rustup: est_ok()))
      length(ws) == 1 && has_toolchain_write(ws: ws, channel: pin_ok().toolchain_channel, as_user: d.account_name) && rank_of_rustup(ws: ws) == -1
    }
  }
}

// ORDER + DEDUPE red control: a fresh host's writes (groups, account, membership, dirs, authorized_keys,
// checkout, rustup, toolchain, binary) are in NON-DECREASING rank order (a reverse-fold order would set bad>0), and carry no duplicate identity.
test fn fresh_host_writes_are_ordered_by_action_kind_and_deduped() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
  match d.forced_command_line {
    Absent => false
    Present { value: line } => {
      let a = serving_assess(d: d, o: fresh_absent_observed(line, d), pin: pin_ok())
      let plan = converge_plan(d: d, a: a, pin: pin_ok(), target_arch: est_s(pin_arch()), rustup: est_absent())
      let ws = plan_writes(plan)
      match first_duplicate_by_key(xs: ws, key: converge_action_key) {
        // A fresh host must get groupadd for the account's OWN group at account_gid AND for the ledger
        // group at group_gid (both proven absent), with NO write pairing a group name with the OTHER
        // group's gid (the merge bug review 95905 flagged: creating gunbc-compute at 1005). Exactly two
        // group writes; the account's primary group is its own; all writes in kind order; no duplicates.
        none => plan_is_refused(plan) == false
          && writes_sorted_by_kind(ws)
          && all_group_writes(ws) == 2
          && group_writes_at(ws, d.account_group_name, d.account_gid) == 1
          && group_writes_at(ws, d.group_name, d.group_gid) == 1
          && group_writes_at(ws, d.account_group_name, d.group_gid) == 0
          && group_writes_at(ws, d.group_name, d.account_gid) == 0
          && has_account_primary(ws, d.account_group_name)
        Present { value: _ } => false
      }
    }
  }
    }
  }
}

// UID-MISMATCH red control (review 5b #3 / review 95905 #2): an EXISTING account with the wrong uid is not
// a useradd away from fixed — useradd refuses an existing name, usermod -u would orphan its files. So the
// plan records it UNHANDLED and writes NOTHING; the wet apply's unhandled gate then refuses the host and
// mutates nothing (a human reconciles), rather than applying every other write and failing only at
// re-observe. A genuinely ABSENT account (PresentAbsent) IS handled by the account arm; a MISMATCH is not.
test fn uid_mismatch_is_unhandled_not_planned_as_useradd() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
  match d.forced_command_line {
    Absent => false
    Present { value: line } => {
      let o = serving_observed_from_reads(
        elevation: est_elevation(),
        account_name: d.account_name,
        passwd: est_s("gunbc-build:x:9999:1005:remote-build:/home/gunbc-build:/bin/bash\n"),
        group: est_s(converged_groups()),
        authorized_keys: est_s(line),
        store_root: est_ok(), store_staging: est_ok(), store_root_mode: store_mode_ok(d: d), store_staging_mode: store_mode_ok(d: d), serve_binary: est_ok(),
        scratch_root: est_ok(), scratch_root_mode: scratch_mode_ok(d: d),
        checkout: est_ok(), toolchain: est_ok(), rustup: est_ok(),
        serve_binary_sha256: Present { value: est_s(pin_sha()) }, checkout_revision: Present { value: est_s(pin_rev()) },
        authorized_keys_mode: Present { value: est_s(text: file_mode_octal(mode: d.authorized_keys_mode)) },
        serve_binary_mode: Present { value: est_s(text: file_mode_octal(mode: d.serve_binary_mode)) },
    user_work_slice_max: settled_slice_max(ceiling: user_work_slice_memory_max_for_host(host: d.host)),
    user_work_slice_high: settled_slice_high(ceiling: user_work_slice_memory_max_for_host(host: d.host)),
    user_work_slice_swap: ObservationEstablished { observed: CgroupMemoryLimited { bytes: user_work_slice_memory_swap_max } },
    user_manager_linger: ObservationEstablished { observed: true },
        target_arch: est_s(pin_arch()), ledger_rows: matched_ledger(d: d),
      
        serve_identity: Absent,
    seat_census: RecoverCatalogLegEstablished { entries: [] },)
      let a = serving_assess(d: d, o: o, pin: pin_ok())
      let plan = converge_plan(d: d, a: a, pin: pin_ok(), target_arch: est_s(pin_arch()), rustup: est_ok())
      plan_is_unhandled(plan) && length(plan_writes(plan)) == 0
    }
  }
    }
  }
}

// ── elevation precondition red control (review 95915, carried into 5(b)) ──────────
// If 'sudo -n' refused, observe reports every sudo-dependent item unread (Indeterminate); the apply
// must therefore plan NOTHING and refuse, so it can never write over files it never read. Paired with
// fresh_host (established elevation plans the writes): the elevation field is load-bearing on the
// apply side too, not just the observe.
test fn refused_elevation_plans_nothing_and_refuses() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      let o = serving_observed_from_reads(
        elevation: refused_elevation(),
        account_name: d.account_name,
        passwd: est_s("gunbc-build:x:1005:1005:remote-build:/home/gunbc-build:/bin/bash\n"),
        group: est_s(converged_groups()),
        authorized_keys: est_s(forced_line(d)),
        store_root: est_absent(), store_staging: est_absent(), store_root_mode: store_mode_absent(), store_staging_mode: store_mode_absent(), serve_binary: est_absent(),
        scratch_root: est_absent(), scratch_root_mode: store_mode_absent(),
        checkout: est_absent(), toolchain: est_absent(), rustup: est_absent(),
        serve_binary_sha256: Absent, checkout_revision: Absent,
        authorized_keys_mode: Absent, serve_binary_mode: Absent,
    user_work_slice_max: settled_slice_max(ceiling: user_work_slice_memory_max_for_host(host: d.host)),
    user_work_slice_high: settled_slice_high(ceiling: user_work_slice_memory_max_for_host(host: d.host)),
    user_work_slice_swap: ObservationEstablished { observed: CgroupMemoryLimited { bytes: user_work_slice_memory_swap_max } },
    user_manager_linger: ObservationEstablished { observed: true },
        target_arch: est_s(pin_arch()), ledger_rows: matched_ledger(d: d),
      
        serve_identity: Absent,
    seat_census: RecoverCatalogLegEstablished { entries: [] },)
      let a = serving_assess(d: d, o: o, pin: pin_ok())
      let plan = converge_plan(d: d, a: a, pin: pin_ok(), target_arch: est_s(pin_arch()), rustup: est_ok())
      plan_is_refused(plan) && length(plan_writes(plan)) == 0
    }
  }
}

// ── the execute path is typed to the plan arm (review 95922 #2 / review 95928) ───────
// 'A refusal or an unhandled divergence executes nothing' is not a gate the caller remembers: the
// executor takes the ConvergePlan arm's non-empty FreeSemigroup, and the other arms carry no such
// value. This cell is the discriminating half of that claim — the SAME desired state, with ONE
// deviation changed, flips between 'carries write work' (a confirmed-absent store dir) and 'carries
// none' (an unhandled host.arch, a refused elevation leg). A refactor that let an unhandled item ride
// into a plan, or a refusal carry writes, reddens THIS cell while diverged_store_plans_a_matching_write
// stays green: that gap is exactly the defect this control exists to catch.
test fn a_refusal_or_unhandled_divergence_carries_nothing_to_execute() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      let line = forced_line(d)
      let unhandled = converge_plan(
        d: d,
        a: serving_assess(d: d, o: serving_observed_from_reads(
          elevation: est_elevation(),
          account_name: d.account_name,
          passwd: est_s("gunbc-build:x:1005:1005:remote-build:/home/gunbc-build:/bin/bash\n"),
          group: est_s(converged_groups()),
          authorized_keys: est_s(line),
          store_root: est_ok(), store_staging: est_ok(), store_root_mode: store_mode_ok(d: d), store_staging_mode: store_mode_ok(d: d), serve_binary: est_ok(),
          scratch_root: est_ok(), scratch_root_mode: scratch_mode_ok(d: d),
          checkout: est_ok(), toolchain: est_ok(), rustup: est_ok(),
          serve_binary_sha256: Present { value: est_s(pin_sha()) }, checkout_revision: Present { value: est_s(pin_rev()) },
          authorized_keys_mode: Present { value: est_s(text: file_mode_octal(mode: d.authorized_keys_mode)) },
          serve_binary_mode: Present { value: est_s(text: file_mode_octal(mode: d.serve_binary_mode)) },
    user_work_slice_max: settled_slice_max(ceiling: user_work_slice_memory_max_for_host(host: d.host)),
    user_work_slice_high: settled_slice_high(ceiling: user_work_slice_memory_max_for_host(host: d.host)),
    user_work_slice_swap: ObservationEstablished { observed: CgroupMemoryLimited { bytes: user_work_slice_memory_swap_max } },
    user_manager_linger: ObservationEstablished { observed: true },
          target_arch: est_s("x86_64"), ledger_rows: matched_ledger(d: d),
        
          serve_identity: Absent,
    seat_census: RecoverCatalogLegEstablished { entries: [] },), pin: pin_ok()),
        pin: pin_ok(), target_arch: est_s("x86_64"), rustup: est_ok())
      let refused = converge_plan(
        d: d,
        a: serving_assess(d: d, o: serving_observed_from_reads(
          elevation: refused_elevation(),
          account_name: d.account_name,
          passwd: est_s("gunbc-build:x:1005:1005:remote-build:/home/gunbc-build:/bin/bash\n"),
          group: est_s(converged_groups()),
          authorized_keys: est_s(line),
          store_root: est_ok(), store_staging: est_ok(), store_root_mode: store_mode_ok(d: d), store_staging_mode: store_mode_ok(d: d), serve_binary: est_ok(),
          scratch_root: est_ok(), scratch_root_mode: scratch_mode_ok(d: d),
          checkout: est_ok(), toolchain: est_ok(), rustup: est_ok(),
          serve_binary_sha256: Present { value: est_s(pin_sha()) }, checkout_revision: Present { value: est_s(pin_rev()) },
          authorized_keys_mode: Present { value: est_s(text: file_mode_octal(mode: d.authorized_keys_mode)) },
          serve_binary_mode: Present { value: est_s(text: file_mode_octal(mode: d.serve_binary_mode)) },
    user_work_slice_max: settled_slice_max(ceiling: user_work_slice_memory_max_for_host(host: d.host)),
    user_work_slice_high: settled_slice_high(ceiling: user_work_slice_memory_max_for_host(host: d.host)),
    user_work_slice_swap: ObservationEstablished { observed: CgroupMemoryLimited { bytes: user_work_slice_memory_swap_max } },
    user_manager_linger: ObservationEstablished { observed: true },
          target_arch: est_s(pin_arch()), ledger_rows: matched_ledger(d: d),
        
          serve_identity: Absent,
    seat_census: RecoverCatalogLegEstablished { entries: [] },), pin: pin_ok()),
        pin: pin_ok(), target_arch: est_s(pin_arch()), rustup: est_ok())
      let planned = converge_plan(
        d: d,
        a: serving_assess(d: d, o: serving_observed_from_reads(
          elevation: est_elevation(),
          account_name: d.account_name,
          passwd: est_s("gunbc-build:x:1005:1005:remote-build:/home/gunbc-build:/bin/bash\n"),
          group: est_s(converged_groups()),
          authorized_keys: est_s(line),
          store_root: est_absent(), store_staging: est_ok(), store_root_mode: store_mode_absent(), store_staging_mode: store_mode_ok(d: d), serve_binary: est_ok(),
          scratch_root: est_ok(), scratch_root_mode: scratch_mode_ok(d: d),
          checkout: est_ok(), toolchain: est_ok(), rustup: est_ok(),
          serve_binary_sha256: Present { value: est_s(pin_sha()) }, checkout_revision: Present { value: est_s(pin_rev()) },
          authorized_keys_mode: Present { value: est_s(text: file_mode_octal(mode: d.authorized_keys_mode)) },
          serve_binary_mode: Present { value: est_s(text: file_mode_octal(mode: d.serve_binary_mode)) },
    user_work_slice_max: settled_slice_max(ceiling: user_work_slice_memory_max_for_host(host: d.host)),
    user_work_slice_high: settled_slice_high(ceiling: user_work_slice_memory_max_for_host(host: d.host)),
    user_work_slice_swap: ObservationEstablished { observed: CgroupMemoryLimited { bytes: user_work_slice_memory_swap_max } },
    user_manager_linger: ObservationEstablished { observed: true },
          target_arch: est_s(pin_arch()), ledger_rows: matched_ledger(d: d),
        
          serve_identity: Absent,
    seat_census: RecoverCatalogLegEstablished { entries: [] },), pin: pin_ok()),
        pin: pin_ok(), target_arch: est_s(pin_arch()), rustup: est_ok())
      // The two non-plan arms must offer the executor nothing, and the plan arm must offer it
      // something — otherwise the two assertions above are vacuous.
      plan_is_unhandled(unhandled) && length(plan_writes(unhandled)) == 0
        && plan_is_refused(refused) && length(plan_writes(refused)) == 0
        && length(plan_writes(planned)) == 1
    }
  }
}

// ── review 95935: the desired-state modes + shell, observed and planned ────────────

// A host that is correct in EVERY respect (all pins, account, group, keys, ledger, both store dirs
// present at the declared mode) except the ONE fact a caller names. The two control pairs below build
// off this so a reddening can only be the fact under test, never a stray deviation. store-root-mode is
// driven by 'store_root_mode'; the account shell by 'passwd'.
fn fully_matched_store(d: RemoteBuildServingDesired, line: String, store_root_mode: ObservationAttempt<String, ServingLegFailure>) -> ServingObserved {
  serving_observed_from_reads(
    elevation: est_elevation(),
    account_name: d.account_name,
    passwd: est_s("gunbc-build:x:1005:1005:remote-build:/home/gunbc-build:/bin/bash\n"),
    group: est_s(converged_groups()),
    authorized_keys: est_s(line),
    store_root: est_ok(), store_staging: est_ok(), store_root_mode: store_root_mode, store_staging_mode: store_mode_ok(d: d), serve_binary: est_ok(),
    scratch_root: est_ok(), scratch_root_mode: scratch_mode_ok(d: d),
    checkout: est_ok(), toolchain: est_ok(), rustup: est_ok(),
    serve_binary_sha256: Present { value: est_s(pin_sha()) }, checkout_revision: Present { value: est_s(pin_rev()) },
    authorized_keys_mode: Present { value: est_s(text: file_mode_octal(mode: d.authorized_keys_mode)) },
    serve_binary_mode: Present { value: est_s(text: file_mode_octal(mode: d.serve_binary_mode)) },
    user_work_slice_max: settled_slice_max(ceiling: user_work_slice_memory_max_for_host(host: d.host)),
    user_work_slice_high: settled_slice_high(ceiling: user_work_slice_memory_max_for_host(host: d.host)),
    user_work_slice_swap: ObservationEstablished { observed: CgroupMemoryLimited { bytes: user_work_slice_memory_swap_max } },
    user_manager_linger: ObservationEstablished { observed: true },
    target_arch: est_s(pin_arch()), ledger_rows: matched_ledger(d: d),
  
    serve_identity: Absent,
    seat_census: RecoverCatalogLegEstablished { entries: [] },)
}

fn fully_matched_passwd(d: RemoteBuildServingDesired, line: String, passwd: String) -> ServingObserved {
  serving_observed_from_reads(
    elevation: est_elevation(),
    account_name: d.account_name,
    passwd: est_s(passwd),
    group: est_s(converged_groups()),
    authorized_keys: est_s(line),
    store_root: est_ok(), store_staging: est_ok(), store_root_mode: store_mode_ok(d: d), store_staging_mode: store_mode_ok(d: d), serve_binary: est_ok(),
    scratch_root: est_ok(), scratch_root_mode: scratch_mode_ok(d: d),
    checkout: est_ok(), toolchain: est_ok(), rustup: est_ok(),
    serve_binary_sha256: Present { value: est_s(pin_sha()) }, checkout_revision: Present { value: est_s(pin_rev()) },
    authorized_keys_mode: Present { value: est_s(text: file_mode_octal(mode: d.authorized_keys_mode)) },
    serve_binary_mode: Present { value: est_s(text: file_mode_octal(mode: d.serve_binary_mode)) },
    user_work_slice_max: settled_slice_max(ceiling: user_work_slice_memory_max_for_host(host: d.host)),
    user_work_slice_high: settled_slice_high(ceiling: user_work_slice_memory_max_for_host(host: d.host)),
    user_work_slice_swap: ObservationEstablished { observed: CgroupMemoryLimited { bytes: user_work_slice_memory_swap_max } },
    user_manager_linger: ObservationEstablished { observed: true },
    target_arch: est_s(pin_arch()), ledger_rows: matched_ledger(d: d),
  
    serve_identity: Absent,
    seat_census: RecoverCatalogLegEstablished { entries: [] },)
}

// A host settled in EVERY leg except the scratch root's presence and mode, which the caller supplies.
// The sibling of fully_matched_store for the scratch item: the pair of claims below share one fixture and
// differ only in these two legs, so a passing green cell cannot come from some other deviation.
fn fully_matched_scratch(d: RemoteBuildServingDesired, line: String, scratch_root: ObservationAttempt<Bool, ServingLegFailure>, scratch_root_mode: ObservationAttempt<String, ServingLegFailure>) -> ServingObserved {
  serving_observed_from_reads(
    elevation: est_elevation(),
    account_name: d.account_name,
    passwd: est_s("gunbc-build:x:1005:1005:remote-build:/home/gunbc-build:/bin/bash\n"),
    group: est_s(converged_groups()),
    authorized_keys: est_s(line),
    store_root: est_ok(), store_staging: est_ok(), store_root_mode: store_mode_ok(d: d), store_staging_mode: store_mode_ok(d: d),
    serve_binary: est_ok(),
    scratch_root: scratch_root, scratch_root_mode: scratch_root_mode,
    checkout: est_ok(), toolchain: est_ok(), rustup: est_ok(),
    serve_binary_sha256: Present { value: est_s(pin_sha()) }, checkout_revision: Present { value: est_s(pin_rev()) },
    authorized_keys_mode: Present { value: est_s(text: file_mode_octal(mode: d.authorized_keys_mode)) },
    serve_binary_mode: Present { value: est_s(text: file_mode_octal(mode: d.serve_binary_mode)) },
    user_work_slice_max: settled_slice_max(ceiling: user_work_slice_memory_max_for_host(host: d.host)),
    user_work_slice_high: settled_slice_high(ceiling: user_work_slice_memory_max_for_host(host: d.host)),
    user_work_slice_swap: ObservationEstablished { observed: CgroupMemoryLimited { bytes: user_work_slice_memory_swap_max } },
    user_manager_linger: ObservationEstablished { observed: true },
    target_arch: est_s(pin_arch()), ledger_rows: matched_ledger(d: d),
    serve_identity: Absent,
    seat_census: RecoverCatalogLegEstablished { entries: [] },)
}

// An EnsureDirectory write carrying EXACTLY this path, owner pair and mode. The owner pair is asserted,
// not assumed: the point of the scratch root is that the serving ACCOUNT can write in it, so a write that
// re-creates it root-owned would fix nothing and this helper would go red.
fn has_account_owned_directory(ws: List<ConvergeAction>, path: String, owner_user: String, owner_group: String, mode: String) -> Bool {
  length(filter(ws, a => match a {
    EnsureDirectory { path: p, owner_user: u, owner_group: g, mode: m } =>
      p == path && u == owner_user && g == owner_group && file_mode_octal(mode: m) == mode
    _ => false
  })) > 0
}

// Whether the write list contains an EnsureDirectory on PATH carrying exactly MODE. The declared mode is
// asserted HERE (on the planned action) so a per-arm literal that ignored d.store_dir_mode reddens it.
fn has_ensure_directory_mode(ws: List<ConvergeAction>, path: String, mode: String) -> Bool {
  length(filter(ws, a => match a {
    EnsureDirectory { path: p, owner_user: _, owner_group: _, mode: m } => p == path && file_mode_octal(mode: m) == mode
    _ => false
  })) > 0
}

// The login shell the planned useradd (EnsureAccount) would write, or none when no EnsureAccount is planned.
fn account_write_shell(ws: List<ConvergeAction>) -> String? {
  match first_where(ws, keep: a => match a { EnsureAccount { name: _, uid: _, gid: _, primary_group: _, home: _, shell: _, supplementary: _ } => true  _ => false }) {
    Absent => Absent
    Present { value: a } => match a {
      EnsureAccount { name: _, uid: _, gid: _, primary_group: _, home: _, shell: sh, supplementary: _ } => Present { value: sh }
      _ => Absent
    }
  }
}

// GREEN (review 95935): a store directory that EXISTS at the wrong mode is no longer invisible to the
// observe (it used to be a bare 'test -d'). It raises a deviation that routes to EnsureDirectory carrying
// the DECLARED store-dir mode — the same authority the desired state carries, not a per-arm "0755".
test fn store_mode_drift_plans_ensure_directory_at_declared_mode() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      let line = forced_line(d)
      let declared = serving_store_dir_mode_octal(d: d)
      // "0700" parses as an octal mode but differs from the declared 0755: a genuine MODE drift on a present dir.
      let a = serving_assess(d: d, o: fully_matched_store(d: d, line: line, store_root_mode: est_s(text: "0700")), pin: pin_ok())
      let plan = converge_plan(d: d, a: a, pin: pin_ok(), target_arch: est_s(pin_arch()), rustup: est_ok())
      plan_is_refused(plan) == false
        && plan_is_unhandled(plan) == false
        && length(plan_writes(plan)) == 1
        && has_ensure_directory_mode(ws: plan_writes(plan), path: d.store_root, mode: declared)
    }
  }
}

// THE red control: the SAME host with the store dir at the DECLARED mode is settled — it plans NOTHING.
// If the mode check were absent (the old 'test -d' only), the green cell above would go green AND this
// would too; the pair together prove the mode leg, not the presence leg, is what produced the write.
test fn store_mode_matched_plans_no_store_directory() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      let line = forced_line(d)
      let a = serving_assess(d: d, o: fully_matched_store(d: d, line: line, store_root_mode: store_mode_ok(d: d)), pin: pin_ok())
      let plan = converge_plan(d: d, a: a, pin: pin_ok(), target_arch: est_s(pin_arch()), rustup: est_ok())
      plan_is_refused(plan) == false && plan_is_unhandled(plan) == false && length(plan_writes(plan)) == 0
    }
  }
}

// ---------------------------------------------------------------------------
// THE ACCOUNT'S SCRATCH ROOT (the one directory of the serving account's own tree the converge owns
// into existence). Every remote compile on BOTH serving hosts died here, one step after the ledger and
// principal checks passed:
//   mkdir: cannot create directory '/home/gunbc-build/.local/share/gunbc-remote-build/compute':
//   Permission denied        (receipt /tmp/live-compile-receipt.json, runs 44915773851 / 44917055618)
// The parents of that tree are root-owned BY DESIGN (InstallServeBinary / RecordServeIdentity install the
// binary the forced command execs, and a build the account runs must never be able to replace it), so no
// amount of account-side effort can create the provider's compute root: only the converge can, and it
// must create it AS THE ACCOUNT. These claims are the difference between "a directory the model names"
// and "a directory the apply will create with the right owner, and will not create on a guess".
// ---------------------------------------------------------------------------

// The provider's own root, not a path this witness re-derives: the declared scratch dir is exactly what
// gunbc.compute.work_provider_local::compute_resolve_subject runs 'mkdir -p <it>/subject' on, read from
// the same host_capacity call. If the converge ever spells its own path, the write lands somewhere the
// serve route never asks for and this goes red.
test fn the_scratch_root_is_the_provider_s_own_compute_root() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      let provider_root = compute_root(instance: remote_build_serving_instance(host: operator_host_srv1)) as String
      d.scratch_root_dir == provider_root
        // ...and it is NOT one of the ledger dirs: that list is judged as ledger ROWS, and no ledger row
        // lives under a scratch root. Riding there would have the row judge demand a name/slot posture
        // this directory can never satisfy.
        && length(filter(d.ledger_dirs, t => owned_directory_path(t: t) == d.scratch_root_dir)) == 0
    }
  }
}

// A confirmed-absent scratch root plans EXACTLY ONE write, and that write carries the serving account as
// owner and its primary group as group -- the account-writability the serve route needs, asserted field by
// field rather than assumed from "a directory was planned".
test fn a_missing_scratch_root_plans_one_account_owned_write() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      let line = forced_line(d)
      let a = serving_assess(
        d: d,
        o: fully_matched_scratch(d: d, line: line, scratch_root: est_absent(), scratch_root_mode: store_mode_absent()),
        pin: pin_ok())
      let plan = converge_plan(d: d, a: a, pin: pin_ok(), target_arch: est_s(pin_arch()), rustup: est_ok())
      plan_is_refused(plan) == false
        && plan_is_unhandled(plan) == false
        && length(plan_writes(plan)) == 1
        && has_account_owned_directory(
             ws: plan_writes(plan),
             path: d.scratch_root_dir,
             owner_user: d.account_name,
             owner_group: d.account_group_name,
             mode: serving_scratch_root_mode_octal(d: d))
    }
  }
}

// THE red control for the presence leg: the same host, scratch root PRESENT at the declared mode, plans
// NOTHING. Without this pair the cell above proves only that "some host state" produced a write.
test fn scratch_root_present_at_declared_mode_plans_nothing() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      let line = forced_line(d)
      let a = serving_assess(
        d: d,
        o: fully_matched_scratch(d: d, line: line, scratch_root: est_ok(), scratch_root_mode: scratch_mode_ok(d: d)),
        pin: pin_ok())
      let plan = converge_plan(d: d, a: a, pin: pin_ok(), target_arch: est_s(pin_arch()), rustup: est_ok())
      plan_is_refused(plan) == false && plan_is_unhandled(plan) == false && length(plan_writes(plan)) == 0
    }
  }
}

// A scratch root that exists at the WRONG mode (0700 declared, something looser observed) is a proved mode
// drift, remediated through the SAME builder at the declared owner and mode -- not unhandled, and never a
// per-arm literal mode.
test fn scratch_root_mode_drift_plans_the_same_write_at_the_declared_mode() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      let line = forced_line(d)
      let declared = serving_scratch_root_mode_octal(d: d)
      let a = serving_assess(
        d: d,
        o: fully_matched_scratch(d: d, line: line, scratch_root: est_ok(), scratch_root_mode: est_s(text: "0777")),
        pin: pin_ok())
      let plan = converge_plan(d: d, a: a, pin: pin_ok(), target_arch: est_s(pin_arch()), rustup: est_ok())
      plan_is_refused(plan) == false
        && plan_is_unhandled(plan) == false
        && length(plan_writes(plan)) == 1
        && has_account_owned_directory(
             ws: plan_writes(plan),
             path: d.scratch_root_dir,
             owner_user: d.account_name,
             owner_group: d.account_group_name,
             mode: declared)
    }
  }
}

// THE red control that no write is minted from an unread leg: the scratch root's presence read is REFUSED
// while every other leg settles, so the assessment is indeterminate and the plan writes nothing and
// refuses (gunbc.design_argument::fail_closed -- an apply never writes an item it never observed).
test fn an_unread_scratch_root_leg_writes_nothing_and_refuses() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      let line = forced_line(d)
      let a = serving_assess(
        d: d,
        o: fully_matched_scratch(
          d: d,
          line: line,
          scratch_root: ObservationRefused { cause: ServingLegFailure { item: "scratch.root", cause: "ssh refused" } },
          scratch_root_mode: store_mode_absent()),
        pin: pin_ok())
      let plan = converge_plan(d: d, a: a, pin: pin_ok(), target_arch: est_s(pin_arch()), rustup: est_ok())
      plan_is_refused(plan) && length(plan_writes(plan)) == 0
    }
  }
}

// GREEN (review 95935): an EXISTING account (its passwd row came back) whose login shell differs from the
// account model's is UNHANDLED — the plan records it and writes NOTHING, so the wet apply REFUSES rather
// than running usermod on a live account (fail_closed: never mutate a running system's account behind its back).
test fn wrong_shell_on_existing_account_is_unhandled() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      let line = forced_line(d)
      // uid/gid match (1005/1005), only the shell (field 7) is /bin/sh — the ONLY deviation is the shell.
      let a = serving_assess(d: d, o: fully_matched_passwd(d: d, line: line, passwd: "gunbc-build:x:1005:1005:remote-build:/home/gunbc-build:/bin/sh\n"), pin: pin_ok())
      let plan = converge_plan(d: d, a: a, pin: pin_ok(), target_arch: est_s(pin_arch()), rustup: est_ok())
      plan_is_unhandled(plan) && length(plan_writes(plan)) == 0
    }
  }
}

// THE red control: the SAME host with the account's shell at the model's declared path is settled — NOT
// unhandled, and plans nothing. Proves the unhandled verdict above came from the SHELL, not from the row.
test fn declared_shell_on_existing_account_is_settled() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      let line = forced_line(d)
      let a = serving_assess(d: d, o: fully_matched_passwd(d: d, line: line, passwd: "gunbc-build:x:1005:1005:remote-build:/home/gunbc-build:/bin/bash\n"), pin: pin_ok())
      let plan = converge_plan(d: d, a: a, pin: pin_ok(), target_arch: est_s(pin_arch()), rustup: est_ok())
      plan_is_unhandled(plan) == false && length(plan_writes(plan)) == 0
    }
  }
}

// GREEN (review 95935): the plan's useradd carries the login shell FROM THE ACCOUNT MODEL (d.account_shell),
// never a reauthored literal — so a fresh account is created with the model's shell. The write arm's old
// hardcoded "-s /bin/bash" is gone; this is what replaced it, read off the desired state.
test fn planned_useradd_carries_the_model_shell() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      let a = serving_assess(d: d, o: fresh_absent_observed(forced_line(d), d), pin: pin_ok())
      let plan = converge_plan(d: d, a: a, pin: pin_ok(), target_arch: est_s(pin_arch()), rustup: est_absent())
      match account_write_shell(ws: plan_writes(plan)) {
        Absent => false
        Present { value: sh } => sh == d.account_shell
      }
    }
  }
}

// THE red control: the model's shell is a NON-EMPTY concrete path (/bin/bash), and the planned shell EQUALS
// it while the plan is NOT otherwise the wrong-shell refusal — i.e. the shell is genuinely sourced, not the
// empty string an unwired field would yield. A plan that dropped the shell ("" ) or a literal that drifted
// from the model reddens this while the green cell above stays green.
test fn planned_useradd_shell_is_the_model_value_not_empty() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      let a = serving_assess(d: d, o: fresh_absent_observed(forced_line(d), d), pin: pin_ok())
      let plan = converge_plan(d: d, a: a, pin: pin_ok(), target_arch: est_s(pin_arch()), rustup: est_absent())
      d.account_shell != ""
        && match account_write_shell(ws: plan_writes(plan)) {
             Absent => false
             Present { value: sh } => sh == d.account_shell && sh != ""
           }
    }
  }
}

// GREEN + red in one (review 95935, cause carried per review 96096): the checkout's VERDICT is the detach,
// but a failed fetch that blocks the detach NAMES THE FETCH, with the fetch's own cause; a failed detach
// with a good fetch names the detach and its cause; and a good detach is done no matter what the fetch
// did. The clone result is irrelevant to all four.
fn checkout_cause_of(step: ConvergeStep) -> String {
  match step {
    StepDone => ""
    StepFailed { cause: c } => c
  }
}

test fn checkout_cause_names_the_fetch_only_when_it_blocked_the_detach() -> Bool {
  let fetch_failed = StepFailed { cause: "exit 128: fatal: couldn't find remote ref deadbeef" }
  let detach_failed = StepFailed { cause: "exit 1: error: pathspec did not match" }
  let both = checkout_cause_of(step: converge_checkout_step(fetch: fetch_failed, detach: detach_failed))
  let fetch_named = string_contains(s: both, pattern: "fetch") && string_contains(s: both, pattern: "couldn't find remote ref")
  let only_detach = checkout_cause_of(step: converge_checkout_step(fetch: StepDone, detach: detach_failed))
  let detach_named = string_contains(s: only_detach, pattern: "detach")
    && string_contains(s: only_detach, pattern: "pathspec did not match")
    && string_contains(s: only_detach, pattern: "fetch") == false
  // The detach is the verdict: a good detach is done even when the fetch failed.
  let detach_is_verdict = match converge_checkout_step(fetch: fetch_failed, detach: StepDone) {
    StepDone => true
    StepFailed { cause: _ } => false
  } && match converge_checkout_step(fetch: StepDone, detach: StepDone) {
    StepDone => true
    StepFailed { cause: _ } => false
  }
  fetch_named && detach_named && detach_is_verdict
}

// ── side-chat review of 2026-11-16, finding B1: the toolchain has a remediation ─────────────────────
//
// PresentAbsent "toolchain" used to fall to unhandled and ServingPlanInput.toolchain_channel was
// never consumed — a fresh host could never settle, and the pin's channel governed nothing. It now
// plans EnsureToolchain at its own rank: after the account and the checkout it depends on, before
// the serve binary; and NOTHING builds a release (the executor's own binary rides the install arm —
// see converge_install_binary's upload_path).

fn has_toolchain_write(ws: List<ConvergeAction>, channel: String, as_user: String) -> Bool {
  length(filter(ws, a => match a {
    EnsureToolchain { channel: c, as_user: u } => c == channel && u == as_user
    _ => false
  })) == 1
}

fn rank_of_toolchain(ws: List<ConvergeAction>) -> Int {
  match first_where(ws, keep: a => match a {
    EnsureToolchain { channel: _, as_user: _ } => true
    _ => false
  }) {
    Absent => -1
    Present { value: a } => converge_kind_rank(a)
  }
}

fn rank_of_checkout(ws: List<ConvergeAction>) -> Int {
  match first_where(ws, keep: a => match a {
    EnsureCheckout { dir: _, clone_url: _, revision: _, as_user: _ } => true
    _ => false
  }) {
    Absent => -1
    Present { value: a } => converge_kind_rank(a)
  }
}

fn rank_of_serve_binary(ws: List<ConvergeAction>) -> Int {
  match first_where(ws, keep: a => match a {
    InstallServeBinary { upload_path: _, install_path: _, expected_sha256: _ } => true
    _ => false
  }) {
    Absent => -1
    Present { value: a } => converge_kind_rank(a)
  }
}

fn rank_of_directory_on(ws: List<ConvergeAction>, path: String) -> Int {
  match first_where(ws, keep: a => match a {
    EnsureDirectory { path: p, owner_user: _, owner_group: _, mode: _ } => p == path
    _ => false
  }) {
    Absent => -1
    Present { value: a } => converge_kind_rank(a)
  }
}

fn plan_is_settled(plan: ConvergeDecision) -> Bool {
  match plan { ConvergeSettled => true  _ => false }
}

test fn fresh_host_plans_the_pinned_toolchain_after_checkout_before_binary() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      let a = serving_assess(d: d, o: fresh_absent_observed(forced_line(d), d), pin: pin_ok())
      let plan = converge_plan(d: d, a: a, pin: pin_ok(), target_arch: est_s(pin_arch()), rustup: est_absent())
      let ws = plan_writes(plan)
      // Diverged-and-runnable, never Indeterminate, and it carries the toolchain write.
      length(ws) > 0
        && has_toolchain_write(ws: ws, channel: pin_ok().toolchain_channel, as_user: d.account_name)
        && 0 <= rank_of_checkout(ws: ws) && rank_of_checkout(ws: ws) < rank_of_toolchain(ws: ws)
        && rank_of_toolchain(ws: ws) < rank_of_serve_binary(ws: ws)
        && writes_sorted_by_kind(ws)
    }
  }
}

// ── side-chat review of 2026-11-16, finding B2: the installs' parents are planned, from the desired state ──

fn has_directory_write(ws: List<ConvergeAction>, path: String, owner: String, mode: String) -> Bool {
  length(filter(ws, a => match a {
    EnsureDirectory { path: p, owner_user: ou, owner_group: _, mode: m } => p == path && ou == owner && file_mode_octal(mode: m) == mode
    _ => false
  })) == 1
}

fn rank_of_authorized_keys(ws: List<ConvergeAction>) -> Int {
  match first_where(ws, keep: a => match a {
    EnsureAuthorizedKeys { path: _, owner_user: _, content: _ } => true
    _ => false
  }) {
    Absent => -1
    Present { value: a } => converge_kind_rank(a)
  }
}

test fn fresh_host_plans_the_parents_before_the_installs_they_parent() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      let a = serving_assess(d: d, o: fresh_absent_observed(forced_line(d), d), pin: pin_ok())
      let plan = converge_plan(d: d, a: a, pin: pin_ok(), target_arch: est_s(pin_arch()), rustup: est_absent())
      let ws = plan_writes(plan)
      // Both parents are planned with the DESIRED state's declared owner and mode — the octal string
      // the write carries is file_mode_octal of the declared FileMode, so a per-arm literal that
      // ignored d.account_ssh_dir_mode / d.serve_binary_dir_mode reddens this cell.
      has_directory_write(ws: ws, path: d.account_ssh_dir, owner: d.account_name, mode: file_mode_octal(mode: d.account_ssh_dir_mode))
        && has_directory_write(ws: ws, path: d.serve_binary_dir, owner: d.serve_binary_dir_owner_user, mode: file_mode_octal(mode: d.serve_binary_dir_mode))
        && 0 <= rank_of_directory_on(ws: ws, path: d.account_ssh_dir) && rank_of_directory_on(ws: ws, path: d.account_ssh_dir) < rank_of_authorized_keys(ws: ws)
        && 0 <= rank_of_directory_on(ws: ws, path: d.serve_binary_dir) && rank_of_directory_on(ws: ws, path: d.serve_binary_dir) < rank_of_serve_binary(ws: ws)
    }
  }
}

// ── side-chat review of 2026-11-16, finding B3; review 96096: ONE execution fold, with causes ──
//
// converge_execute_plan stops at the FIRST failed write so no later write runs against an absent
// prerequisite; the failed write's cause and the skipped suffix land in the receipt. The fold is
// converge_execute_with, parameterized by the write-runner: the wet apply passes converge_run_write over
// the fleet SSH edge, and these claims pass an injected runner, so they exercise the fold the apply runs.

fn b3_group() -> ConvergeAction {
  EnsureGroup { name: "gunbc-compute", gid: 1006 }
}

fn b3_ak(ak_path: String) -> ConvergeAction {
  EnsureAuthorizedKeys { path: ak_path, owner_user: "gunbc-build", content: "ssh-ed25519 AAAAtest" }
}

fn b3_checkout() -> ConvergeAction {
  EnsureCheckout { dir: "/srv/gunbc/checkout", clone_url: "https://example.invalid/repo", revision: "deadbeef", as_user: "gunbc-build" }
}

fn b3_toolchain() -> ConvergeAction {
  EnsureToolchain { channel: "1.90.0", as_user: "gunbc-build" }
}

fn b3_binary() -> ConvergeAction {
  InstallServeBinary { upload_path: "target/release/gunbc", install_path: "/srv/gunbc/bin/gunbc", expected_sha256: "abc" }
}

fn b3_order(ak_path: String) -> List<ConvergeAction> {
  [b3_group(), b3_ak(ak_path: ak_path), b3_checkout(), b3_toolchain(), b3_binary()]
}

data b3_injected_cause: String = "exit 1: install: cannot change owner of '/home/gunbc-build/.ssh/authorized_keys': Operation not permitted"

// The injected write-runner: the write keyed `failing` fails with b3_injected_cause, every other settles.
fn b3_run_failing(failing: String, a: ConvergeAction) -> ConvergeWriteOutcome {
  let key = converge_action_key(a)
  if key == failing { WriteFailed { failure: ConvergeWriteFailure { key: key, cause: b3_injected_cause } } } else { WriteSettled }
}

test fn execution_stops_at_first_failure_and_skips_the_dependents() -> Bool {
  let ak_path = "/home/gunbc-build/.ssh/authorized_keys"
  let ak_key = converge_action_key(b3_ak(ak_path: ak_path))
  let m = converge_execute_with(remaining: b3_order(ak_path: ak_path), attempted: [], applied: [], run: a => b3_run_failing(failing: ak_key, a: a))
  // The failing write itself IS attempted, with its cause kept; everything ordered after it is skipped.
  let failed_with_cause = match m.failed {
    Cons { head: f, tail: more } => f.key == ak_key && f.cause == b3_injected_cause && length(more) == 0
    Empty => false
  }
  failed_with_cause
    && m.skipped == map([b3_checkout(), b3_toolchain(), b3_binary()], a => converge_action_key(a))
    && m.attempted == [converge_action_key(b3_group()), ak_key]
    // Only the write that settled BEFORE the failure is `applied`; the failed one and the skipped suffix are not.
    && m.applied == [converge_action_key(b3_group())]
}

test fn execution_with_no_failure_attempts_everything() -> Bool {
  let ak_path = "/home/gunbc-build/.ssh/authorized_keys"
  let m = converge_execute_with(remaining: b3_order(ak_path: ak_path), attempted: [], applied: [], run: a => b3_run_failing(failing: "no-such-write", a: a))
  m.failed == [] && m.skipped == []
    && m.attempted == map(b3_order(ak_path: ak_path), a => converge_action_key(a))
    && m.applied == map(b3_order(ak_path: ak_path), a => converge_action_key(a))
}

// Review 96096 (fail_closed): the receipt names the failed write WITH ITS CAUSE, not only its key, and
// still names the skipped writes. A settled pass adds no execution lines.
test fn the_apply_receipt_names_the_failed_write_and_its_cause() -> Bool {
  let ak_path = "/home/gunbc-build/.ssh/authorized_keys"
  let ak_key = converge_action_key(b3_ak(ak_path: ak_path))
  let failing = converge_execute_with(remaining: b3_order(ak_path: ak_path), attempted: [], applied: [], run: a => b3_run_failing(failing: ak_key, a: a))
  let clean = converge_execute_with(remaining: b3_order(ak_path: ak_path), attempted: [], applied: [], run: a => b3_run_failing(failing: "no-such-write", a: a))
  let lines = converge_apply_receipt_lines(executed: failing, terminal: ApplyStillNeedsWrites { count: 3 })
  let settled = converge_apply_receipt_lines(executed: clean, terminal: ApplySettled)
  string_contains(s: lines, pattern: ak_key)
    && string_contains(s: lines, pattern: "Operation not permitted")
    && string_contains(s: lines, pattern: converge_action_key(b3_toolchain()))
    && settled == ""
}

// THE applied-then-refused receipt (the srv3 converge 45762320308 shape): every write settled — the apply
// mutated every arm — and THEN the re-observe refused at recover-catalog. The receipt must name the applied
// arms AND the refusal, and must NOT read like a converge that mutated nothing.
test fn the_apply_receipt_names_applied_arms_then_the_refusal() -> Bool {
  let ak_path = "/home/gunbc-build/.ssh/authorized_keys"
  let executed = converge_execute_with(remaining: b3_order(ak_path: ak_path), attempted: [], applied: [], run: a => b3_run_failing(failing: "no-such-write", a: a))
  let refusal = "the re-observe refused after apply: recover-catalog: the seat census could not be read"
  let lines = converge_apply_receipt_lines(executed: executed, terminal: ApplyRefused { reason: refusal })
  string_contains(s: lines, pattern: "applied-then-refused")
    && string_contains(s: lines, pattern: refusal)
    && string_contains(s: lines, pattern: converge_action_key(b3_group()))
    && string_contains(s: lines, pattern: converge_action_key(b3_binary()))
    && !string_contains(s: lines, pattern: "refused-before-apply")
}

// RED CONTROL: the SAME refusal, but the apply mutated nothing (no arm settled). It must read
// "refused-before-apply", name NO applied arm, and be a DIFFERENT receipt from the one above. Without the
// applied/terminal split these two receipts are byte-identical — that conflation is the defect.
test fn a_refusal_with_no_applied_arm_is_a_different_receipt() -> Bool {
  let ak_path = "/home/gunbc-build/.ssh/authorized_keys"
  let refusal = "the re-observe refused after apply: recover-catalog: the seat census could not be read"
  let nothing = converge_apply_receipt_lines(executed: ConvergeExecuted { attempted: [], applied: [], failed: [], skipped: [] }, terminal: ApplyRefused { reason: refusal })
  let executed = converge_execute_with(remaining: b3_order(ak_path: ak_path), attempted: [], applied: [], run: a => b3_run_failing(failing: "no-such-write", a: a))
  let applied_then = converge_apply_receipt_lines(executed: executed, terminal: ApplyRefused { reason: refusal })
  string_contains(s: nothing, pattern: "refused-before-apply")
    && !string_contains(s: nothing, pattern: "applied-then-refused")
    && !string_contains(s: nothing, pattern: converge_action_key(b3_group()))
    && nothing != applied_then
}

// ── side-chat review of 2026-11-16, finding B4: an EXTRA ledger-group member is unhandled, not "fixed" ──
//
// serving_group_deviations flags a group whose members are not EXACTLY the declared roster, but the
// only remediation is usermod -aG; no removal is modelled (removing a member could evict someone a
// human added on purpose). So an extra member must route to unhandled — and an unhandled plan carries
// NO writes: the red control is that the apply refuses this host rather than half-fixing it.

fn converged_groups_with_intruder() -> String {
  "gunbc-compute:x:1006:briansrls,gunbc-build,intruder\ngunbc-build:x:1005:\n"
}

fn matched_with_group(d: RemoteBuildServingDesired, line: String, group_text: String) -> ServingObserved {
  serving_observed_from_reads(
    elevation: est_elevation(),
    account_name: d.account_name,
    passwd: est_s("gunbc-build:x:1005:1005:remote-build:/home/gunbc-build:/bin/bash\n"),
    group: est_s(group_text),
    authorized_keys: est_s(line),
    store_root: est_ok(), store_staging: est_ok(), store_root_mode: store_mode_ok(d: d), store_staging_mode: store_mode_ok(d: d), serve_binary: est_ok(),
    scratch_root: est_ok(), scratch_root_mode: scratch_mode_ok(d: d),
    checkout: est_ok(), toolchain: est_ok(), rustup: est_ok(),
    serve_binary_sha256: Present { value: est_s(pin_sha()) }, checkout_revision: Present { value: est_s(pin_rev()) },
    authorized_keys_mode: Present { value: est_s(text: file_mode_octal(mode: d.authorized_keys_mode)) },
    serve_binary_mode: Present { value: est_s(text: file_mode_octal(mode: d.serve_binary_mode)) },
    user_work_slice_max: settled_slice_max(ceiling: user_work_slice_memory_max_for_host(host: d.host)),
    user_work_slice_high: settled_slice_high(ceiling: user_work_slice_memory_max_for_host(host: d.host)),
    user_work_slice_swap: ObservationEstablished { observed: CgroupMemoryLimited { bytes: user_work_slice_memory_swap_max } },
    user_manager_linger: ObservationEstablished { observed: true },
    target_arch: est_s(pin_arch()), ledger_rows: matched_ledger(d: d),
  
    serve_identity: Absent,
    seat_census: RecoverCatalogLegEstablished { entries: [] },)
}

test fn ledger_group_extra_member_is_unhandled_not_planned() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      let line = forced_line(d)
      // GREEN half: the exact roster plans nothing (this deviation is absent).
      let settled = converge_plan(d: d, a: serving_assess(d: d, o: matched_with_group(d: d, line: line, group_text: converged_groups()), pin: pin_ok()), pin: pin_ok(), target_arch: est_s(pin_arch()), rustup: est_ok())
      // RED half: ONE extra observed member — everything else identical — is UNHANDLED with zero writes.
      let extra = converge_plan(d: d, a: serving_assess(d: d, o: matched_with_group(d: d, line: line, group_text: converged_groups_with_intruder()), pin: pin_ok()), pin: pin_ok(), target_arch: est_s(pin_arch()), rustup: est_ok())
      plan_is_settled(settled) && plan_is_unhandled(extra) && length(plan_writes(extra)) == 0
    }
  }
}

// ── InstallUserWorkSlice: the cap the reader reads ──
//
// The reader wraps build work into the slice with systemd-run --user at a --user launch
// (gunbc.compute.unit_bounds user_work_slice_binding_properties); its admission decides from the
// slice's own cgroup memory, not from a systemctl view. The leg therefore installs where that reader
// looks and settles on the same read. These claims hold the plan side: an uncapped slice is a real
// deviation, it plans exactly one InstallUserWorkSlice, that write names the reader's own unit, and
// it sorts ahead of InstallServeBinary (rank 8 before 9), so a slice that never settles halts the
// pass before the binary is touched.

fn slice_uncapped_observed(d: RemoteBuildServingDesired, line: String) -> ServingObserved {
  serving_observed_from_reads(
    elevation: est_elevation(),
    account_name: d.account_name,
    passwd: est_s("gunbc-build:x:1005:1005:remote-build:/home/gunbc-build:/bin/bash\n"),
    group: est_s(converged_groups()),
    authorized_keys: est_s(line),
    store_root: est_ok(), store_staging: est_ok(), store_root_mode: store_mode_ok(d: d), store_staging_mode: store_mode_ok(d: d), serve_binary: est_ok(),
    scratch_root: est_ok(), scratch_root_mode: scratch_mode_ok(d: d),
    checkout: est_ok(), toolchain: est_ok(), rustup: est_ok(),
    serve_binary_sha256: Present { value: est_s(pin_sha()) }, checkout_revision: Present { value: est_s(pin_rev()) },
    authorized_keys_mode: Present { value: est_s(text: file_mode_octal(mode: d.authorized_keys_mode)) },
    serve_binary_mode: Present { value: est_s(text: file_mode_octal(mode: d.serve_binary_mode)) },
    user_work_slice_max: ObservationEstablished { observed: CgroupMemoryUnlimited },
    user_work_slice_high: ObservationEstablished { observed: CgroupMemoryUnlimited },
    user_work_slice_swap: ObservationEstablished { observed: CgroupMemoryUnlimited },
    user_manager_linger: ObservationEstablished { observed: true },
    target_arch: est_s(pin_arch()), ledger_rows: matched_ledger(d: d),
  
    serve_identity: Absent,
    seat_census: RecoverCatalogLegEstablished { entries: [] },)
}

fn is_install_slice(a: ConvergeAction) -> Bool {
  match a {
    InstallUserWorkSlice { unit_name: _, unit_path: _, memory_max: _, memory_high: _, memory_swap_max: _, expected_content: _ } => true
    _ => false
  }
}

fn is_install_binary(a: ConvergeAction) -> Bool {
  match a {
    InstallServeBinary { upload_path: _, install_path: _, expected_sha256: _ } => true
    _ => false
  }
}

// An uncapped slice assesses as a real drift and plans exactly one InstallUserWorkSlice, refused and
// unhandled both false. The single-drift fixture keeps the count an assertion, not a "some write
// appeared".
test fn uncapped_slice_plans_exactly_one_install_leg() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      match d.forced_command_line {
        Absent => false
        Present { value: line } => {
          let asmt = serving_assess(d: d, o: slice_uncapped_observed(d: d, line: line), pin: pin_ok())
          let plan = converge_plan(d: d, a: asmt, pin: pin_ok(), target_arch: est_s(pin_arch()), rustup: est_ok())
          plan_is_refused(plan) == false
            && plan_is_unhandled(plan) == false
            && length(filter(plan_writes(plan), x => is_install_slice(x))) == 1
        }
      }
    }
  }
}

// The planned write names the reader's own unit: the path srv1 installs to and the Slice= value
// unit_bounds wraps with. The leg and the reader's wrap are pinned to one declaration so they cannot
// drift apart.
test fn install_slice_names_the_readers_unit() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      match d.forced_command_line {
        Absent => false
        Present { value: line } => {
          let asmt = serving_assess(d: d, o: slice_uncapped_observed(d: d, line: line), pin: pin_ok())
          let plan = converge_plan(d: d, a: asmt, pin: pin_ok(), target_arch: est_s(pin_arch()), rustup: est_ok())
          match filter(plan_writes(plan), x => is_install_slice(x)) {
            Cons { head: InstallUserWorkSlice { unit_name: n, unit_path: up, memory_max: _, memory_high: _, memory_swap_max: _, expected_content: _ }, tail: _ } =>
              n == user_work_slice_unit_name && up == (gunbc_user_work_slice_unit_path() as String)
            _ => false
          }
        }
      }
    }
  }
}

// The write carries the reservation's ceiling as MemoryMax, the model's zero as the swap floor, and a
// rendered unit — the ceiling is read from the reservation row (never a hardcoded seat count), so the
// srv3/srv4 cap moves when the row does.
test fn install_slice_carries_ceiling_swap_floor_and_unit() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      match d.forced_command_line {
        Absent => false
        Present { value: line } => {
          let asmt = serving_assess(d: d, o: slice_uncapped_observed(d: d, line: line), pin: pin_ok())
          let plan = converge_plan(d: d, a: asmt, pin: pin_ok(), target_arch: est_s(pin_arch()), rustup: est_ok())
          match filter(plan_writes(plan), x => is_install_slice(x)) {
            Cons { head: InstallUserWorkSlice { unit_name: _, unit_path: _, memory_max: mmax, memory_high: _, memory_swap_max: mswap, expected_content: content }, tail: _ } =>
              byte_size_count(b: mmax) == byte_size_count(b: user_work_slice_memory_max_for_host(host: d.host))
                && byte_size_count(b: mswap) == 0
                && string_contains(s: content, pattern: "MemoryMax")
                && string_contains(s: content, pattern: "MemorySwapMax")
            _ => false
          }
        }
      }
    }
  }
}

// The slice write sorts ahead of the binary write: converge_order places rank 8 before rank 9, so the
// executor reaches the slice first and a slice that never settles stops the pass before the binary.
test fn install_slice_sorts_before_serve_binary() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      match d.forced_command_line {
        Absent => false
        Present { value: line } => {
          let asmt = serving_assess(d: d, o: slice_uncapped_observed(d: d, line: line), pin: pin_ok())
          let plan = converge_plan(d: d, a: asmt, pin: pin_ok(), target_arch: est_s(pin_arch()), rustup: est_ok())
          match filter(plan_writes(plan), x => is_install_slice(x)) {
            Cons { head: slice, tail: _ } => {
              let ranked = converge_kind_rank(slice) < converge_kind_rank(b3_binary())
              match converge_order([b3_binary(), slice]) {
                Cons { head: h0, tail: Cons { head: h1, tail: _ } } => ranked && is_install_slice(h0) && is_install_binary(h1)
                _ => false
              }
            }
            Empty => false
          }
        }
      }
    }
  }
}

// RED CONTROL. A slice control nobody could read is an UNKNOWN, not drift: the same host with only the
// memory.max read REFUSED (an ssh/sudo failure -- high/swap unchanged from the uncapped control) must plan
// NO InstallUserWorkSlice. This is the minimal-delta opposite of uncapped_slice_plans_exactly_one_install_leg
// (there max is established-unbounded -> exactly one install; here it is refused -> none), so a refused read
// can never masquerade as 'uncapped' and drive an install toward a cgroup nobody read.
fn slice_refused_max_observed(d: RemoteBuildServingDesired, line: String) -> ServingObserved {
  serving_observed_from_reads(
    elevation: est_elevation(),
    account_name: d.account_name,
    passwd: est_s("gunbc-build:x:1005:1005:remote-build:/home/gunbc-build:/bin/bash\n"),
    group: est_s(converged_groups()),
    authorized_keys: est_s(line),
    store_root: est_ok(), store_staging: est_ok(), store_root_mode: store_mode_ok(d: d), store_staging_mode: store_mode_ok(d: d), serve_binary: est_ok(),
    scratch_root: est_ok(), scratch_root_mode: scratch_mode_ok(d: d),
    checkout: est_ok(), toolchain: est_ok(), rustup: est_ok(),
    serve_binary_sha256: Present { value: est_s(pin_sha()) }, checkout_revision: Present { value: est_s(pin_rev()) },
    authorized_keys_mode: Present { value: est_s(text: file_mode_octal(mode: d.authorized_keys_mode)) },
    serve_binary_mode: Present { value: est_s(text: file_mode_octal(mode: d.serve_binary_mode)) },
    user_work_slice_max: ObservationRefused { cause: ServingLegFailure { item: "user_work.slice.memory_max", cause: "ssh refused" } },
    user_work_slice_high: ObservationEstablished { observed: CgroupMemoryUnlimited },
    user_work_slice_swap: ObservationEstablished { observed: CgroupMemoryUnlimited },
    user_manager_linger: ObservationEstablished { observed: true },
    target_arch: est_s(pin_arch()), ledger_rows: matched_ledger(d: d),
  
    serve_identity: Absent,
    seat_census: RecoverCatalogLegEstablished { entries: [] },)
}

test fn refused_slice_max_plans_no_install_leg() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      match d.forced_command_line {
        Absent => false
        Present { value: line } => {
          let asmt = serving_assess(d: d, o: slice_refused_max_observed(d: d, line: line), pin: pin_ok())
          let plan = converge_plan(d: d, a: asmt, pin: pin_ok(), target_arch: est_s(pin_arch()), rustup: est_ok())
          length(filter(plan_writes(plan), x => is_install_slice(x))) == 0
        }
      }
    }
  }
}

// After the unit file is installed, the leg hands systemd exactly two verbs in order: daemon-reload (so
// systemd reads the new unit) THEN start (so the slice is active under the account's manager and work can
// be placed into it). Both reach the serving ACCOUNT's user manager via the --machine=UID@ connector (bare
// --user would reload root's manager), and the start names the reader's own slice. The readback that
// follows reads the slice's DECLARED properties (systemctl show, witnessed separately), so an installed,
// active-but-empty slice settles from what the loaded unit declares rather than waiting on a cgroup file
// its empty membership never creates. install (upload) and the readback bracket these two verbs
// structurally in the wet leg; this fixes their order and content so leg and reader cannot drift.
test fn install_slice_reloads_then_starts_the_reader_unit() -> Bool {
  let uid = 4242
  let verbs = user_work_slice_install_command_argv(uid: uid)
  let connector = systemctl_user_machine_connector(uid: uid)
  let reload_is_first = match verbs.first() {
    Absent => false
    Present { value: v } => {
      let j = join(v, " ")
      string_contains(s: j, pattern: "daemon-reload") && string_contains(s: j, pattern: "--user") && string_contains(s: j, pattern: connector) && string_contains(s: j, pattern: "start") == false
    }
  }
  let start_is_last = match reverse(verbs).first() {
    Absent => false
    Present { value: v } => {
      let j = join(v, " ")
      string_contains(s: j, pattern: "start") && string_contains(s: j, pattern: user_work_slice_unit_name) && string_contains(s: j, pattern: "--user") && string_contains(s: j, pattern: connector)
    }
  }
  verbs.length() == 2 && reload_is_first && start_is_last
}

// Fixture caps: a settled observation carries the ceiling's value, its derived high, and the forbidden
// swap; these build the two value caps the settle demands (a settled slice reads capped, an uncapped one
// is built directly with unbounded caps).
fn settled_slice_max(ceiling: ByteSize) -> ObservationAttempt<CgroupMemoryLimitValue, ServingLegFailure> { ObservationEstablished { observed: CgroupMemoryLimited { bytes: ceiling } } }
fn settled_slice_high(ceiling: ByteSize) -> ObservationAttempt<CgroupMemoryLimitValue, ServingLegFailure> {
  match user_work_slice_memory_high_of(memory_max: ceiling) {
    UserWorkSliceHighDerived { bytes: h } => ObservationEstablished { observed: CgroupMemoryLimited { bytes: h } }
    UserWorkSliceHighGapExceedsMax => ObservationEstablished { observed: CgroupMemoryLimited { bytes: byte_size(0) } }
  }
}

// ── EnsureUserManagerLinger: the live manager the slice cgroup needs ──
//
// An empty user slice does not persist its cgroup unless the serving account's user manager is lingering;
// the transient manager can tear the slice's cgroup down before the readback, so a daemon-reload and start
// that both succeed still read back uncapped. The converge therefore enables lingering BEFORE the
// slice, and the executor halts at the first failed write -- so a manager that never lingers stops the pass
// before a slice is ever written behind it. These claims pin the plan side: the not-lingering arm is a real
// deviation that plans exactly one enable leg, that leg sorts ahead of the slice, and a REFUSED linger read
// is an unknown that plans nothing (UNKNOWNs WIN -- a state nobody read never drives a write).

fn is_enable_linger(a: ConvergeAction) -> Bool {
  match a {
    EnsureUserManagerLinger { account: _ } => true
    _ => false
  }
}

fn is_ensure_account(a: ConvergeAction) -> Bool {
  match a {
    EnsureAccount { name: _ } => true
    _ => false
  }
}

// Everything but the slice cap is correct AND the user manager is proven not lingering: the minimal-delta
// positive for the enable arm. It carries BOTH deviations (uncapped slice + not-lingering), so one plan
// proves the enable leg appears and (via the order cell) that it lands ahead of the slice it unblocks.
fn not_lingering_uncapped_observed(d: RemoteBuildServingDesired, line: String) -> ServingObserved {
  serving_observed_from_reads(
    elevation: est_elevation(),
    account_name: d.account_name,
    passwd: est_s("gunbc-build:x:1005:1005:remote-build:/home/gunbc-build:/bin/bash\n"),
    group: est_s(converged_groups()),
    authorized_keys: est_s(line),
    store_root: est_ok(), store_staging: est_ok(), store_root_mode: store_mode_ok(d: d), store_staging_mode: store_mode_ok(d: d), serve_binary: est_ok(),
    scratch_root: est_ok(), scratch_root_mode: scratch_mode_ok(d: d),
    checkout: est_ok(), toolchain: est_ok(), rustup: est_ok(),
    serve_binary_sha256: Present { value: est_s(pin_sha()) }, checkout_revision: Present { value: est_s(pin_rev()) },
    authorized_keys_mode: Present { value: est_s(text: file_mode_octal(mode: d.authorized_keys_mode)) },
    serve_binary_mode: Present { value: est_s(text: file_mode_octal(mode: d.serve_binary_mode)) },
    user_work_slice_max: ObservationEstablished { observed: CgroupMemoryUnlimited },
    user_work_slice_high: ObservationEstablished { observed: CgroupMemoryUnlimited },
    user_work_slice_swap: ObservationEstablished { observed: CgroupMemoryUnlimited },
    user_manager_linger: ObservationEstablished { observed: false },
    target_arch: est_s(pin_arch()), ledger_rows: matched_ledger(d: d),
  
    serve_identity: Absent,
    seat_census: RecoverCatalogLegEstablished { entries: [] },)
}

// The same host, but the Linger read is REFUSED (an ssh/sudo failure): the minimal-delta control. An
// unlingering manager that was READ is a drift the converge fixes; one nobody could read is an unknown the
// converge refuses to write toward -- so exactly this fixture plans NO enable leg.
fn refused_linger_observed(d: RemoteBuildServingDesired, line: String) -> ServingObserved {
  serving_observed_from_reads(
    elevation: est_elevation(),
    account_name: d.account_name,
    passwd: est_s("gunbc-build:x:1005:1005:remote-build:/home/gunbc-build:/bin/bash\n"),
    group: est_s(converged_groups()),
    authorized_keys: est_s(line),
    store_root: est_ok(), store_staging: est_ok(), store_root_mode: store_mode_ok(d: d), store_staging_mode: store_mode_ok(d: d), serve_binary: est_ok(),
    scratch_root: est_ok(), scratch_root_mode: scratch_mode_ok(d: d),
    checkout: est_ok(), toolchain: est_ok(), rustup: est_ok(),
    serve_binary_sha256: Present { value: est_s(pin_sha()) }, checkout_revision: Present { value: est_s(pin_rev()) },
    authorized_keys_mode: Present { value: est_s(text: file_mode_octal(mode: d.authorized_keys_mode)) },
    serve_binary_mode: Present { value: est_s(text: file_mode_octal(mode: d.serve_binary_mode)) },
    user_work_slice_max: ObservationEstablished { observed: CgroupMemoryUnlimited },
    user_work_slice_high: ObservationEstablished { observed: CgroupMemoryUnlimited },
    user_work_slice_swap: ObservationEstablished { observed: CgroupMemoryUnlimited },
    user_manager_linger: ObservationRefused { cause: ServingLegFailure { item: "user_manager.linger", cause: "ssh refused" } },
    target_arch: est_s(pin_arch()), ledger_rows: matched_ledger(d: d),
  
    serve_identity: Absent,
    seat_census: RecoverCatalogLegEstablished { entries: [] },)
}

// A proven-not-lingering manager assesses as a real drift and plans exactly ONE enable leg (refused and
// unhandled both false), alongside the slice leg the same fixture still needs.
test fn not_lingering_plans_exactly_one_enable_leg() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      match d.forced_command_line {
        Absent => false
        Present { value: line } => {
          let asmt = serving_assess(d: d, o: not_lingering_uncapped_observed(d: d, line: line), pin: pin_ok())
          let plan = converge_plan(d: d, a: asmt, pin: pin_ok(), target_arch: est_s(pin_arch()), rustup: est_ok())
          plan_is_refused(plan) == false
            && plan_is_unhandled(plan) == false
            && length(filter(plan_writes(plan), x => is_enable_linger(x))) == 1
        }
      }
    }
  }
}

// The enable leg sorts ahead of the slice write: converge_order places its rank (7) before the slice's (8),
// so the executor keeps the manager live first and a slice that never settles is stopped behind a manager
// that never lingered, never ahead of one.
test fn install_linger_sorts_before_slice() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      match d.forced_command_line {
        Absent => false
        Present { value: line } => {
          let asmt = serving_assess(d: d, o: not_lingering_uncapped_observed(d: d, line: line), pin: pin_ok())
          let plan = converge_plan(d: d, a: asmt, pin: pin_ok(), target_arch: est_s(pin_arch()), rustup: est_ok())
          match filter(plan_writes(plan), x => is_enable_linger(x)) {
            Cons { head: linger, tail: _ } => {
              match filter(plan_writes(plan), x => is_install_slice(x)) {
                Cons { head: slice, tail: _ } =>
                  converge_kind_rank(linger) < converge_kind_rank(slice)
                    && match converge_order([slice, linger]) {
                         Cons { head: h0, tail: Cons { head: h1, tail: _ } } => is_enable_linger(h0) && is_install_slice(h1)
                         _ => false
                       }
                Empty => false
              }
            }
            Empty => false
          }
        }
      }
    }
  }
}

// RED CONTROL. A Linger state nobody could read is an UNKNOWN, not drift: this host (slice still unbounded,
// Linger REFUSED) must plan NO enable leg. The minimal-delta opposite of not_lingering_plans_exactly_one_-
// enable_leg (there linger is established-false -> exactly one enable; here it is refused -> none), so a
// refused read can never masquerade as 'not lingering' and drive an enable toward an unread manager.
test fn refused_linger_writes_no_enable_leg() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      match d.forced_command_line {
        Absent => false
        Present { value: line } => {
          let asmt = serving_assess(d: d, o: refused_linger_observed(d: d, line: line), pin: pin_ok())
          let plan = converge_plan(d: d, a: asmt, pin: pin_ok(), target_arch: est_s(pin_arch()), rustup: est_ok())
          length(filter(plan_writes(plan), x => is_enable_linger(x))) == 0
        }
      }
    }
  }
}

// RED-CONTROL PARTNER for the account-presence gate on the linger read. On a fresh host the serving account
// is proven absent (passwd ''), so the linger read is gated OFF and yields established-false -- never an
// unknown. The plan must therefore still run and carry the enable leg beside the account leg. If a future
// change let an absent account's linger read refuse, this host would go indeterminate and this cell goes red.
test fn fresh_host_with_absent_account_plans_enable_not_refused() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      let a = serving_assess(d: d, o: fresh_absent_observed(forced_line(d), d), pin: pin_ok())
      let plan = converge_plan(d: d, a: a, pin: pin_ok(), target_arch: est_s(pin_arch()), rustup: est_ok())
      plan_is_refused(plan) == false
        && plan_is_unhandled(plan) == false
        && length(plan_writes(plan)) > 0
        && length(filter(plan_writes(plan), x => is_enable_linger(x))) == 1
        && length(filter(plan_writes(plan), x => is_ensure_account(x))) != 0
    }
  }
}

// ── the serving binary's identity sidecar (PR-1b: RecordServeIdentity) ──────────────────────────────
// The identity the converge step records beside the binary must be exactly the grammar the serve reader
// (gunbc.compute.remote_build_serve) parses, must be RANKED after the binary install it documents, and
// must dedupe under its own key so the binary's key never absorbs it.

// The bytes the converge writer produces are one JSON object with string members `revision` and
// `sha256`, verbatim -- the contract the PR-1a reader parses. Held to the REAL producer, not a copy.
test fn the_recorded_identity_is_the_documented_two_member_object() -> Bool {
  match parse_json_document(s: serve_identity_document(revision: pin_rev(), sha256: pin_sha())) {
    JsonDocumentUnreadable { gap: _ } => false
    JsonDocumentParsed { value: doc } => match json_object_unique_member(v: doc, key: "revision") {
      JsonMemberFound { value: JsonString { value: r } } => r == pin_rev() &&
        match json_object_unique_member(v: doc, key: "sha256") {
          JsonMemberFound { value: JsonString { value: s } } => s == pin_sha()
          _ => false
        }
      _ => false
    }
  }
}

// RED CONTROL on ordering: the identity is ranked STRICTLY after the binary install, so converge_order
// emits it after the install and the executor's stop-at-first-failure never writes provenance for a
// binary that did not land.
test fn the_identity_is_ranked_after_the_binary_install() -> Bool {
  let ident = RecordServeIdentity { install_path: "/srv/gunbc/bin/gunbc", revision: pin_rev(), sha256: pin_sha() }
  converge_kind_rank(ident) == 10 && converge_kind_rank(b3_binary()) == 9 && converge_kind_rank(ident) > converge_kind_rank(b3_binary())
}

// RED CONTROL on dedup: the identity keyed by its path is NOT the binary's key for that same path, so
// distinct_by_key collapses two identities but never lets the binary's write absorb (erase) the identity.
test fn the_identity_key_is_distinct_from_the_binary_key() -> Bool {
  let ident = RecordServeIdentity { install_path: "/srv/gunbc/bin/gunbc", revision: pin_rev(), sha256: pin_sha() }
  converge_action_key(ident) == concat("identity:", "/srv/gunbc/bin/gunbc")
    && converge_action_key(ident) != converge_action_key(b3_binary())
}

// ── the slice cap is read from the UNIT's declared properties, not its cgroup files ───────────────────
// An installed, ACTIVE-but-empty slice has no memory.max cgroup file (systemd materialises a slice's cgroup
// only when a member unit starts), so reading the cgroup file refused a correctly-capped slice forever --
// the srv3 failure. The leg now reads `systemctl --user --machine=UID@ show <slice>` of the unit's OWN
// MemoryMax / MemoryHigh / MemorySwapMax, which the manager answers from the loaded unit whether or not the
// cgroup has populated. These witnesses pin that read: the ceiling decodes to capped, an unbounded/absent
// control to uncapped (which licenses the install), an unreachable manager to uncapped (never an unknown),
// and the read-back argv is the user-bus `show` of the three properties.

// The body a `systemctl show` prints for a slice that carries exactly the ceiling: MemoryMax the ceiling,
// MemoryHigh its derived value, MemorySwapMax the forbidden-swap value -- the same three values the settled
// observation fixtures hand-build, so 'reads capped' agrees between the property read and the direct field.
fn capped_show_body(ceiling: ByteSize) -> String {
  let max_line = concat("MemoryMax=", to_string(byte_size_count(ceiling)))
  let high_line = match user_work_slice_memory_high_of(memory_max: ceiling) {
    UserWorkSliceHighDerived { bytes: h } => concat("MemoryHigh=", to_string(byte_size_count(h)))
    UserWorkSliceHighGapExceedsMax => "MemoryHigh=infinity"
  }
  let swap_line = concat("MemorySwapMax=", to_string(byte_size_count(user_work_slice_memory_swap_max)))
  concat(max_line, concat("\n", concat(high_line, concat("\n", swap_line))))
}

fn ceiling_high_expected(ceiling: ByteSize) -> ByteSize? {
  match user_work_slice_memory_high_of(memory_max: ceiling) {
    UserWorkSliceHighDerived { bytes: h } => Present { value: h }
    UserWorkSliceHighGapExceedsMax => Absent
  }
}

fn slice_value_unbounded(v: CgroupMemoryLimitValue) -> Bool {
  match v {
    CgroupMemoryUnlimited => true
    _ => false
  }
}

// The ceiling the loaded unit DECLARES decodes to SliceCapped: this is the reading that lets an installed,
// active-but-empty slice settle where the cgroup-file read refused it. RED today: serving_slice_cap_of_show
// does not exist on the old code (the slice was read from cgroup files).
test fn the_declared_ceiling_read_back_settles_the_slice() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      let ceiling = user_work_slice_memory_max_for_host(host: d.host)
      let cap = serving_slice_cap_of_show(text: capped_show_body(ceiling: ceiling))
      match user_work_slice_cgroup_admission(max: cap.max, high: cap.high, swap: cap.swap, ceiling: ceiling, high_expected: ceiling_high_expected(ceiling: ceiling)) {
        SliceCapped => true
        SliceUncapped { reason: _ } => false
        SliceUnknown { control: _, cause: _ } => false
      }
    }
  }
}

// RED CONTROL: a control spelling 'infinity' (systemctl's unbounded) is a control we DID read that is not the
// ceiling -> SliceUncapped, which licenses the install -- it is NOT an unknown. A slice nobody started must
// install, not stall the whole converge on indeterminacy.
test fn an_infinity_ceiling_read_back_is_uncapped_not_unread() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      let ceiling = user_work_slice_memory_max_for_host(host: d.host)
      let cap = serving_slice_cap_of_show(text: "MemoryMax=infinity\nMemoryHigh=infinity\nMemorySwapMax=infinity")
      match user_work_slice_cgroup_admission(max: cap.max, high: cap.high, swap: cap.swap, ceiling: ceiling, high_expected: ceiling_high_expected(ceiling: ceiling)) {
        SliceUncapped { reason: _ } => true
        SliceCapped => false
        SliceUnknown { control: _, cause: _ } => false
      }
    }
  }
}

// RED CONTROL: a PRESENT account whose user manager is unreachable has no cap in force, so the read is
// established-UNCAPPED (installs), never an unknown that would make the host indeterminate. This is the
// one-way direction the leg guarantees: an unreachable manager installs the slice; it is never silently capped.
test fn an_unreachable_manager_reads_uncapped_never_unknown() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      let ceiling = user_work_slice_memory_max_for_host(host: d.host)
      let cap = serving_slice_cap_unreachable_manager()
      match user_work_slice_cgroup_admission(max: cap.max, high: cap.high, swap: cap.swap, ceiling: ceiling, high_expected: ceiling_high_expected(ceiling: ceiling)) {
        SliceUncapped { reason: _ } => true
        SliceCapped => false
        SliceUnknown { control: _, cause: _ } => false
      }
    }
  }
}

// The systemctl value for an unbounded control ('infinity', 'max', empty, or an absent key) is the slice's
// OWN unlimited value -- systemctl's spellings map onto the same unbounded the cgroup file spells 'max'.
test fn the_property_value_maps_every_unbounded_spelling() -> Bool {
  slice_value_unbounded(serving_slice_property_value(value: Absent))
    && slice_value_unbounded(serving_slice_property_value(value: Present { value: "infinity" }))
    && slice_value_unbounded(serving_slice_property_value(value: Present { value: "max" }))
    && slice_value_unbounded(serving_slice_property_value(value: Present { value: "   " }))
}

// RED CONTROL (fail_closed, review 96983): a NON-ZERO `systemctl show` is classified by WHAT the command
// said, not by the exit code alone. The same exit 1 -- a proven user-bus-down spelling -- reads established
// UNCAPPED (an unreachable manager has no cap in force, so it installs + enables linger); a sudo denial or a
// malformed invocation is REFUSED, so on a host that is ALREADY capped a failure nobody read cannot mint an
// install + linger write. Goes RED the moment the non-zero arm is blanket-uncapped again.
test fn a_non_zero_read_is_classified_by_stderr_not_the_exit_code() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      let ceiling = user_work_slice_memory_max_for_host(host: d.host)
      let high_expected = ceiling_high_expected(ceiling: ceiling)
      let down = serving_slice_cap_of_exec(exit_code: 1, stdout: "", stderr: "Failed to connect to bus: Host is down")
      let down_uncapped = match user_work_slice_cgroup_admission(max: down.max, high: down.high, swap: down.swap, ceiling: ceiling, high_expected: high_expected) {
        SliceUncapped { reason: _ } => true
        SliceCapped => false
        SliceUnknown { control: _, cause: _ } => false
      }
      let denied = serving_slice_cap_of_exec(exit_code: 1, stdout: "", stderr: "sudo: a password is required")
      let denied_unknown = match user_work_slice_cgroup_admission(max: denied.max, high: denied.high, swap: denied.swap, ceiling: ceiling, high_expected: high_expected) {
        SliceUnknown { control: _, cause: _ } => true
        SliceCapped => false
        SliceUncapped { reason: _ } => false
      }
      let malformed = serving_slice_cap_of_exec(exit_code: 1, stdout: "", stderr: "systemctl: unknown operation 'shwo'")
      let malformed_unknown = match user_work_slice_cgroup_admission(max: malformed.max, high: malformed.high, swap: malformed.swap, ceiling: ceiling, high_expected: high_expected) {
        SliceUnknown { control: _, cause: _ } => true
        SliceCapped => false
        SliceUncapped { reason: _ } => false
      }
      down_uncapped && denied_unknown && malformed_unknown
    }
  }
}

// The read-back is the user-bus `show` of the three named properties of the reader's own slice, through the
// account's --machine=UID@ connector. RED today: user_work_slice_show_command_argv does not exist on the old
// code. It is the LAST step (a read), distinct from the install/reload/start writes, so 'settled' is judged
// by what the unit declares -- exactly what the reader admits the wrap against.
test fn the_slice_readback_shows_the_units_declared_properties() -> Bool {
  let uid = 4242
  let j = join(user_work_slice_show_command_argv(uid: uid), " ")
  let connector = systemctl_user_machine_connector(uid: uid)
  string_contains(s: j, pattern: "systemctl")
    && string_contains(s: j, pattern: "--user")
    && string_contains(s: j, pattern: connector)
    && string_contains(s: j, pattern: "show")
    && string_contains(s: j, pattern: "--property=MemoryMax,MemoryHigh,MemorySwapMax")
    && string_contains(s: j, pattern: user_work_slice_unit_name)
}

// The full ordered shape of the leg: install hands [daemon-reload, start] and the read-back is a separate
// `show` (a read, never a second start). Together with install_slice_reloads_then_starts_the_reader_unit
// (which fixes reload-then-start), this witnesses install -> reload -> start -> read-back end to end.
test fn the_slice_leg_orders_install_reload_start_then_readback() -> Bool {
  let uid = 4242
  let install = user_work_slice_install_command_argv(uid: uid)
  let readback = user_work_slice_show_command_argv(uid: uid)
  let first_is_reload = match install.first() {
    Absent => false
    Present { value: v } => string_contains(s: join(v, " "), pattern: "daemon-reload")
  }
  let start_is_last = match reverse(install).first() {
    Absent => false
    Present { value: v } => string_contains(s: join(v, " "), pattern: "start")
  }
  let readback_join = join(readback, " ")
  let readback_is_show = string_contains(s: readback_join, pattern: "show") && string_contains(s: readback_join, pattern: "start") == false
  install.length() == 2 && first_is_reload && start_is_last && readback_is_show
}

// ── the identity sidecar drifts on a SETTLED binary (PR-1c: record alone) ────────────────────────────
// The gap PR-1c closes: a host already at the desired binary (no reinstall) never recorded its identity
// sidecar, so its receipts read as unattested. These controls hold the REAL producer (serving_assess ->
// converge_plan) to the rule: a MISSING, MALFORMED, or STALE-sha sidecar on a settled binary plans
// RecordServeIdentity ALONE -- no InstallServeBinary -- and a matching sha (even at an older revision)
// is a NO-OP, while a REFUSED read is an unknown that writes nothing. A settled host with the sidecar
// simply not spoken to (skipped) stays a no-op, so the pre-PR-1c tallies are untouched.

// A fully-settled host (binary present at the pin sha, ledger matched, slice capped, lingering) with the
// identity leg supplied EXPLICITLY. `sidecar` is Absent to leave it unspoken (a no-op), else the decoded
// SidecarRead reading (SidecarAbsent / SidecarMalformed / SidecarRecorded{sha256}).
fn fully_matched_identity(d: RemoteBuildServingDesired, line: String, sidecar: ObservationAttempt<SidecarRead, ServingLegFailure>?) -> ServingObserved {
  serving_observed_from_reads(
    elevation: est_elevation(), account_name: d.account_name,
    passwd: est_s("gunbc-build:x:1005:1005:remote-build:/home/gunbc-build:/bin/bash\n"),
    group: est_s(converged_groups()), authorized_keys: est_s(line),
    store_root: est_ok(), store_staging: est_ok(), store_root_mode: store_mode_ok(d: d), store_staging_mode: store_mode_ok(d: d), serve_binary: est_ok(),
    scratch_root: est_ok(), scratch_root_mode: scratch_mode_ok(d: d),
    checkout: est_ok(), toolchain: est_ok(), rustup: est_ok(),
    serve_binary_sha256: Present { value: est_s(pin_sha()) }, checkout_revision: Present { value: est_s(pin_rev()) },
    authorized_keys_mode: Present { value: est_s(text: file_mode_octal(mode: d.authorized_keys_mode)) },
    serve_binary_mode: Present { value: est_s(text: file_mode_octal(mode: d.serve_binary_mode)) },
    serve_identity: sidecar,
    user_work_slice_max: settled_slice_max(ceiling: user_work_slice_memory_max_for_host(host: d.host)),
    user_work_slice_high: settled_slice_high(ceiling: user_work_slice_memory_max_for_host(host: d.host)),
    user_work_slice_swap: ObservationEstablished { observed: CgroupMemoryLimited { bytes: user_work_slice_memory_swap_max } },
    user_manager_linger: ObservationEstablished { observed: true },
    target_arch: est_s(pin_arch()), ledger_rows: matched_ledger(d: d),
  
  seat_census: RecoverCatalogLegEstablished { entries: [] },)
}

fn sidecar_absent() -> ObservationAttempt<SidecarRead, ServingLegFailure> { ObservationEstablished { observed: SidecarAbsent } }
fn sidecar_malformed() -> ObservationAttempt<SidecarRead, ServingLegFailure> { ObservationEstablished { observed: SidecarMalformed } }
// Upload-host fixture: the revision is irrelevant there (the pin sha carries the binding), so this records
// the sha with a placeholder revision. Native-host fixtures use sidecar_recorded_at, where revision matters.
fn sidecar_recorded(sha: String) -> ObservationAttempt<SidecarRead, ServingLegFailure> { ObservationEstablished { observed: SidecarRecorded { revision: "irrelevant-for-upload", sha256: sha } } }
fn sidecar_recorded_at(revision: String, sha: String) -> ObservationAttempt<SidecarRead, ServingLegFailure> { ObservationEstablished { observed: SidecarRecorded { revision: revision, sha256: sha } } }
fn sidecar_refused() -> ObservationAttempt<SidecarRead, ServingLegFailure> { ObservationRefused { cause: ServingLegFailure { item: "serve.binary.identity", cause: "ssh read refused" } } }

fn count_identity(ws: List<ConvergeAction>) -> Int { length(filter(ws, a => match a { RecordServeIdentity { install_path: _, revision: _, sha256: _ } => true  _ => false })) }
fn count_binary_install(ws: List<ConvergeAction>) -> Int { length(filter(ws, a => match a { InstallServeBinary { upload_path: _, install_path: _, expected_sha256: _ } => true  _ => false })) }
// RB-M3: the native-build action (build on the host, not upload) -- the route a native identity drift must take.
fn count_binary_build(ws: List<ConvergeAction>) -> Int { length(filter(ws, a => match a { BuildServeBinary { checkout_dir: _, revision: _, package: _, bin: _, target_dir: _, install_path: _ } => true  _ => false })) }
fn planned_identity_sha(ws: List<ConvergeAction>) -> String {
  match first_where(ws, keep: a => match a { RecordServeIdentity { install_path: _, revision: _, sha256: _ } => true  _ => false }) {
    Absent => ""
    Present { value: a } => match a { RecordServeIdentity { install_path: _, revision: _, sha256: s } => s  _ => "" }
  }
}

fn plan_identity(d: RemoteBuildServingDesired, line: String, sidecar: ObservationAttempt<SidecarRead, ServingLegFailure>?) -> ConvergeDecision {
  converge_plan(d: d, a: serving_assess(d: d, o: fully_matched_identity(d: d, line: line, sidecar: sidecar), pin: pin_ok()), pin: pin_ok(), target_arch: est_s(pin_arch()), rustup: est_ok())
}

// GREEN: a settled binary with a CONFIRMED-ABSENT sidecar plans the identity ALONE -- one RecordServeIdentity
// carrying the binary's sha + the dispatched revision, and NO reinstall.
test fn a_missing_sidecar_records_the_identity_alone() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      let plan = plan_identity(d: d, line: forced_line(d), sidecar: Present { value: sidecar_absent() })
      let ws = plan_writes(plan)
      plan_is_refused(plan) == false && plan_is_unhandled(plan) == false
        && count_identity(ws) == 1 && count_binary_install(ws) == 0 && planned_identity_sha(ws) == pin_sha()
    }
  }
}

// GREEN: a sidecar recording a sha OTHER than the binary's is stale -> re-recorded (alone).
test fn a_stale_sha_sidecar_re_records_the_identity() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      let other = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
      let plan = plan_identity(d: d, line: forced_line(d), sidecar: Present { value: sidecar_recorded(other) })
      let ws = plan_writes(plan)
      count_identity(ws) == 1 && count_binary_install(ws) == 0 && planned_identity_sha(ws) == pin_sha()
    }
  }
}

// RED CONTROL: a sidecar whose sha MATCHES the binary is settled even though its recorded revision is not
// the dispatched one (revision is NOT a drift signal: a .dag-only main yields a byte-identical binary and
// would rewrite the sidecar for nothing). The identity leg carries only the sha, so a matching sha here IS
// 'same sha, older revision' -> NO identity write at all (the host stays settled).
test fn a_matching_sha_sidecar_is_a_no_op_regardless_of_revision() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      let plan = plan_identity(d: d, line: forced_line(d), sidecar: Present { value: sidecar_recorded(pin_sha()) })
      plan_is_settled(plan) && count_identity(plan_writes(plan)) == 0 && count_binary_install(plan_writes(plan)) == 0
    }
  }
}

// GREEN: a sidecar present but NOT the documented two-member object is malformed -> re-recorded.
test fn a_malformed_sidecar_re_records_the_identity() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      let plan = plan_identity(d: d, line: forced_line(d), sidecar: Present { value: sidecar_malformed() })
      count_identity(plan_writes(plan)) == 1 && count_binary_install(plan_writes(plan)) == 0
    }
  }
}

// RED CONTROL: a REFUSED sidecar read is an unknown, NEVER a rewrite -- a bug that conflated 'unreadable'
// with 'absent' would mint an identity write here and go red.
test fn a_refused_sidecar_read_writes_nothing() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      let plan = plan_identity(d: d, line: forced_line(d), sidecar: Present { value: sidecar_refused() })
      count_identity(plan_writes(plan)) == 0 && count_binary_install(plan_writes(plan)) == 0
    }
  }
}

// RED CONTROL on the gate: with the sidecar simply NOT spoken to (skipped), a settled host stays a no-op --
// so PR-1c did not start recording an identity it has no reading of, and the pre-PR-1c tallies are intact.
test fn an_unspoken_sidecar_on_a_settled_binary_stays_a_no_op() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      let plan = plan_identity(d: d, line: forced_line(d), sidecar: Absent)
      plan_is_settled(plan) && count_identity(plan_writes(plan)) == 0 && count_binary_install(plan_writes(plan)) == 0
    }
  }
}

// ---- NATIVE-BUILD IDENTITY BINDING (review 97463 finding 1) ----
// ken (operator_host_e2d4b7, an X86_64 row) against an Aarch64 executor (pin_ok) is a NATIVE-build host: it
// builds its own serve binary, so there is no pinned pool sha to bind the binary to a revision -- the
// sidecar's recorded REVISION is that binding. A native host must therefore drift (and rebuild) when the
// recorded revision is not the dispatched one, and must NEVER be "fixed" by re-recording a sidecar over a
// stale binary (that would fabricate a revision binding: silent wrongness below the guarantee ladder).
// Upload hosts keep the opposite behaviour (an identical sha at an older revision is settled; a missing
// sidecar is re-recorded alone) -- proved by the witnesses above on operator_host_srv1.
// The on-host uname is the host's OWN arch ("x86_64") so the host.arch consistency check PASSES (it agrees
// with the X86_64 row); only the identity revision leg varies across these fixtures.
fn native_arch() -> String { "x86_64" }

fn fully_matched_native_identity(d: RemoteBuildServingDesired, line: String, sidecar: ObservationAttempt<SidecarRead, ServingLegFailure>?) -> ServingObserved {
  serving_observed_from_reads(
    elevation: est_elevation(), account_name: d.account_name,
    passwd: est_s("gunbc-build:x:1005:1005:remote-build:/home/gunbc-build:/bin/bash\n"),
    group: est_s(native_converged_groups()), authorized_keys: est_s(line),
    store_root: est_ok(), store_staging: est_ok(), store_root_mode: store_mode_ok(d: d), store_staging_mode: store_mode_ok(d: d), serve_binary: est_ok(),
    scratch_root: est_ok(), scratch_root_mode: scratch_mode_ok(d: d),
    checkout: est_ok(), toolchain: est_ok(), rustup: est_ok(),
    serve_binary_sha256: Present { value: est_s(pin_sha()) }, checkout_revision: Present { value: est_s(pin_rev()) },
    authorized_keys_mode: Present { value: est_s(text: file_mode_octal(mode: d.authorized_keys_mode)) },
    serve_binary_mode: Present { value: est_s(text: file_mode_octal(mode: d.serve_binary_mode)) },
    serve_identity: sidecar,
    user_work_slice_max: settled_slice_max(ceiling: user_work_slice_memory_max_for_host(host: d.host)),
    user_work_slice_high: settled_slice_high(ceiling: user_work_slice_memory_max_for_host(host: d.host)),
    user_work_slice_swap: ObservationEstablished { observed: CgroupMemoryLimited { bytes: user_work_slice_memory_swap_max } },
    user_manager_linger: ObservationEstablished { observed: true },
    target_arch: est_s(native_arch()), ledger_rows: matched_ledger(d: d),
  
  seat_census: RecoverCatalogLegEstablished { entries: [] },)
}

fn plan_native_identity(d: RemoteBuildServingDesired, line: String, sidecar: ObservationAttempt<SidecarRead, ServingLegFailure>?) -> ConvergeDecision {
  converge_plan(d: d, a: serving_assess(d: d, o: fully_matched_native_identity(d: d, line: line, sidecar: sidecar), pin: pin_ok()), pin: pin_ok(), target_arch: est_s(native_arch()), rustup: est_ok())
}

// THE BLOCKING BUG, NOW RED-CAUGHT: a native host whose sidecar sha matches the running binary but whose
// recorded revision is OLDER than the dispatched one reads settled under the old code. It must instead plan
// a REBUILD (BuildServeBinary), and must NOT re-record the sidecar (count_identity==0) nor upload (install==0).
test fn a_stale_native_revision_rebuilds_rather_than_rerecords() -> Bool {
  match remote_build_serving_desired(host: operator_host_e2d4b7) {
    Absent => false
    Present { value: d } => {
      let plan = plan_native_identity(d: d, line: forced_line(d), sidecar: Present { value: sidecar_recorded_at("ffffffffffffffffffffffffffffffffffffffff", pin_sha()) })
      let ws = plan_writes(plan)
      plan_is_refused(plan) == false && plan_is_unhandled(plan) == false
        && count_binary_build(ws) == 1 && count_binary_install(ws) == 0 && count_identity(ws) == 0
    }
  }
}

// POSITIVE CONTROL: the same native host, sidecar recorded AT the dispatched revision and matching the
// binary sha -> fully settled, nothing written.
test fn a_native_revision_matching_the_pin_settles() -> Bool {
  match remote_build_serving_desired(host: operator_host_e2d4b7) {
    Absent => false
    Present { value: d } => {
      let plan = plan_native_identity(d: d, line: forced_line(d), sidecar: Present { value: sidecar_recorded_at(pin_rev(), pin_sha()) })
      let ws = plan_writes(plan)
      plan_is_settled(plan) && count_binary_build(ws) == 0 && count_binary_install(ws) == 0 && count_identity(ws) == 0
    }
  }
}

// RED: a native host with a CONFIRMED-ABSENT sidecar must rebuild (its binary is unbound to any revision),
// NOT take the upload-host route of re-recording the identity alone. Contrast a_missing_sidecar_records_the_
// identity_alone (srv1, upload) which asserts count_identity==1.
test fn a_missing_native_sidecar_rebuilds_not_rerecords() -> Bool {
  match remote_build_serving_desired(host: operator_host_e2d4b7) {
    Absent => false
    Present { value: d } => {
      let plan = plan_native_identity(d: d, line: forced_line(d), sidecar: Present { value: sidecar_absent() })
      let ws = plan_writes(plan)
      plan_is_refused(plan) == false && plan_is_unhandled(plan) == false
        && count_binary_build(ws) == 1 && count_identity(ws) == 0 && count_binary_install(ws) == 0
    }
  }
}

// ---- THE SEAT RECOVERY LEG (increment 2) ----
// The census arrives ALREADY JUDGED: its entries come from
// gunbc.compute.attempt_lifecycle::recovery_write_authorization through the recovery door
// (gunbc.compute.work_provider_local::compute_recover_catalog_serving_cli), rendered and parsed back through
// the door's own grammar. The plan only RENDERS them, and only when the identity leg is Met. These
// cells hold the red controls: a live holder plans nothing, an unreadable slot refuses the plan, and
// an unmet identity refuses the recovery alongside it.

fn fully_matched_census(d: RemoteBuildServingDesired, line: String, sidecar: ObservationAttempt<SidecarRead, ServingLegFailure>?, census: RecoverCatalogLegReading, checkout_rev: String) -> ServingObserved {
  serving_observed_from_reads(
    elevation: est_elevation(), account_name: d.account_name,
    passwd: est_s("gunbc-build:x:1005:1005:remote-build:/home/gunbc-build:/bin/bash\n"),
    group: est_s(converged_groups()), authorized_keys: est_s(line),
    store_root: est_ok(), store_staging: est_ok(), store_root_mode: store_mode_ok(d: d), store_staging_mode: store_mode_ok(d: d), serve_binary: est_ok(),
    scratch_root: est_ok(), scratch_root_mode: scratch_mode_ok(d: d),
    checkout: est_ok(), toolchain: est_ok(), rustup: est_ok(),
    serve_binary_sha256: Present { value: est_s(pin_sha()) }, checkout_revision: Present { value: est_s(checkout_rev) },
    authorized_keys_mode: Present { value: est_s(text: file_mode_octal(mode: d.authorized_keys_mode)) },
    serve_binary_mode: Present { value: est_s(text: file_mode_octal(mode: d.serve_binary_mode)) },
    serve_identity: sidecar,
    user_work_slice_max: settled_slice_max(ceiling: user_work_slice_memory_max_for_host(host: d.host)),
    user_work_slice_high: settled_slice_high(ceiling: user_work_slice_memory_max_for_host(host: d.host)),
    user_work_slice_swap: ObservationEstablished { observed: CgroupMemoryLimited { bytes: user_work_slice_memory_swap_max } },
    user_manager_linger: ObservationEstablished { observed: true },
    target_arch: est_s(pin_arch()), ledger_rows: matched_ledger(d: d),
    seat_census: census,
  )
}

fn plan_census(d: RemoteBuildServingDesired, census: RecoverCatalogLegReading, sidecar: ObservationAttempt<SidecarRead, ServingLegFailure>?) -> ConvergeDecision {
  converge_plan(d: d, a: serving_assess(d: d, o: fully_matched_census(d: d, line: forced_line(d), sidecar: sidecar, census: census, checkout_rev: pin_rev()), pin: pin_ok()), pin: pin_ok(), target_arch: est_s(pin_arch()), rustup: est_ok())
}

fn count_recover(ws: List<ConvergeAction>) -> Int { length(filter(ws, a => match a { RecoverStaleSeat { reference: _ } => true  _ => false })) }
fn planned_recover_reference(ws: List<ConvergeAction>) -> String {
  match first_where(ws, keep: a => match a { RecoverStaleSeat { reference: _ } => true  _ => false }) {
    Absent => ""
    Present { value: a } => match a { RecoverStaleSeat { reference: r } => r as String  _ => "" }
  }
}

// GREEN: an established census entry the model AUTHORIZED — a terminal unit whose release is due —
// plans the recovery: exactly one RecoverStaleSeat carrying that reference, no identity write, when the
// identity leg is Met (a sidecar recording the binary's own sha).
test fn a_stale_seat_plans_the_recovery_when_identity_is_met() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      let plan = plan_census(d: d, census: RecoverCatalogLegEstablished { entries: [CatalogLegStale { reference: "gunbc-build.job#1" as NonEmptyStr }] }, sidecar: Present { value: sidecar_recorded(pin_sha()) })
      let ws = plan_writes(plan)
      plan_is_refused(plan) == false && plan_is_unhandled(plan) == false && count_recover(ws) == 1 && count_identity(ws) == 0 && planned_recover_reference(ws) == "gunbc-build.job#1"
    }
  }
}

// GREEN (measured stall, srv1 run 44984397614): a checkout NOT at the dispatched revision DEFERS the
// census — the recovery door is carried by that checkout, so it does not exist to ask. The plan carries
// NO recovery write, is neither refused nor unhandled (the assessment stays reportable, not
// indeterminate), and the checkout detach that CARRIES the door is written this run; the next assessment
// asks the door. The census is never fabricated as empty, and the deferral is never dressed as an
// unknown — an unknown would dominate the assessment, plan nothing, and strand the door forever.
test fn a_checkout_not_at_the_pin_defers_the_census_and_plans_no_recovery() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      let observed = fully_matched_census(d: d, line: forced_line(d), sidecar: Present { value: sidecar_recorded(pin_sha()) }, census: RecoverCatalogLegDeferred { reason: "the checkout is not at the pin" }, checkout_rev: "0000000000000000000000000000000000000000")
      let plan = converge_plan(d: d, a: serving_assess(d: d, o: observed, pin: pin_ok()), pin: pin_ok(), target_arch: est_s(pin_arch()), rustup: est_ok())
      let ws = plan_writes(plan)
      plan_is_refused(plan) == false && plan_is_unhandled(plan) == false && count_recover(ws) == 0
        && length(filter(ws, w => string_contains(s: converge_action_key(w), pattern: "checkout:"))) == 1
    }
  }
}

// THE GATE ITSELF, over supplied reads: ASK only when the checkout is established AT the dispatched
// revision; DEFER otherwise, naming what made it unaskable — the stale revision it stands at, the
// refusal of the revision read, or the revision never being established. The door the checkout does not
// yet carry is never asked, and its absence is never dressed as an unknown (an unknown would dominate
// the assessment and strand the checkout write that carries the door).
test fn the_census_gate_asks_only_at_the_dispatched_revision() -> Bool {
  let pin_sha = "0000000000000000000000000000000000000000"
  let stale = "1111111111111111111111111111111111111111"
  let asked = match census_door_gate(checkout_revision: Present { value: ObservationEstablished { observed: pin_sha } }, dispatched_revision: pin_sha) {
    CensusGateAsk => true
    CensusGateDefer { reason: _ } => false
  }
  let deferred_stale = match census_door_gate(checkout_revision: Present { value: ObservationEstablished { observed: stale } }, dispatched_revision: pin_sha) {
    CensusGateAsk => false
    CensusGateDefer { reason: r } => string_contains(s: r, pattern: stale) && string_contains(s: r, pattern: pin_sha)
  }
  let deferred_refused = match census_door_gate(checkout_revision: Present { value: ObservationRefused { cause: ServingLegFailure { item: "checkout.revision", cause: "the revision read was refused" } } }, dispatched_revision: pin_sha) {
    CensusGateAsk => false
    CensusGateDefer { reason: r } => string_contains(s: r, pattern: "refused")
  }
  let deferred_unrun = match census_door_gate(checkout_revision: Absent, dispatched_revision: pin_sha) {
    CensusGateAsk => false
    CensusGateDefer { reason: r } => string_contains(s: r, pattern: "not established")
  }
  asked && deferred_stale && deferred_refused && deferred_unrun
}

// RED CONTROL (live holder): an established 'hold' entry — a live or too-early holder, which the model
// DECLINED — is legitimately held and plans NOTHING. The host stays settled; recovering it would take
// a seat from under its holder, which is the exact harm #16827's authorization exists to prevent.
test fn a_legitimately_held_seat_plans_nothing() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      let plan = plan_census(d: d, census: RecoverCatalogLegEstablished { entries: [CatalogLegHeld { reference: "gunbc-build.job#2" as NonEmptyStr }] }, sidecar: Present { value: sidecar_recorded(pin_sha()) })
      plan_is_settled(plan) && count_recover(plan_writes(plan)) == 0
    }
  }
}

// RED CONTROL (unreadable slot): a census that could not establish itself — an unreadable slot, or one
// reference sitting in two seat directories — is an unknown; unknowns dominate, the assessment is
// indeterminate, and the plan REFUSES. The ARM is the assertion: a refused plan has nothing to
// execute, so recovery never runs against a half-read seat pool (fail_closed).
test fn an_unreadable_seat_census_refuses_the_plan() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      let plan = plan_census(d: d, census: RecoverCatalogLegUnknown { detail: "one reference sits in two seat directories" }, sidecar: Present { value: sidecar_recorded(pin_sha()) })
      plan_is_refused(plan) && length(plan_writes(plan)) == 0
    }
  }
}

// RED CONTROL (the identity gate, deferred not refused): the recovery is planned ONLY when the identity
// leg is Met. With the sidecar absent the identity leg still needs its write, and the recovery CLI IS
// the binary the identity documents — so THIS run carries the identity write and defers the recovery
// (review 97280, finding 1: refusing the whole plan would stall the host on every run). The deferral
// is not a loss: the next assessment, with identity Met, plans the recovery — which is what the green
// cell above asserts.
test fn a_stale_seat_with_an_unmet_identity_defers_the_recovery() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      let plan = plan_census(d: d, census: RecoverCatalogLegEstablished { entries: [CatalogLegStale { reference: "gunbc-build.job#3" as NonEmptyStr }] }, sidecar: Present { value: sidecar_absent() })
      let ws = plan_writes(plan)
      plan_is_refused(plan) == false && plan_is_unhandled(plan) == false && count_identity(ws) == 1 && count_recover(ws) == 0
    }
  }
}

// ---- converge_order regression guard (rank-bucket drop; clever-raven-401) ----
// converge_order once concatenated a FIXED list of rank buckets (r0..r9), so every ConvergeAction kind
// past the largest bucket was silently filtered out of the ordered plan -- the rank-10 identity write,
// and any rank added later (e.g. a seat-recovery leg landing after rank 10). The fix orders by rank with
// a STABLE sort so a kind at ANY rank survives. This is the net that catches that class of regression:
// build ONE representative of EVERY ConvergeAction kind, order them, and JOIN the output back to the
// input by structural equality -- plan in = writes out. A kind filtered out by a missing bucket fails
// the join, which a bare count would not distinguish.
fn every_converge_action(d: RemoteBuildServingDesired) -> List<ConvergeAction> {
  [
    EnsureGroup { name: "gunbc-serve", gid: 900 },
    EnsureAccount { name: "gunbc-serve", uid: 900, gid: 900, primary_group: "gunbc-serve", home: "/home/gunbc-serve", shell: "/bin/sh", supplementary: [] },
    EnsureGroupMembership { group_name: "gunbc-serve", group_gid: 900, member: "gunbc-serve" },
    EnsureDirectory { path: "/srv/gunbc/store", owner_user: "gunbc-serve", owner_group: "gunbc-serve", mode: d.serve_binary_mode },
    EnsureAuthorizedKeys { path: "/home/gunbc-serve/.ssh/authorized_keys", owner_user: "gunbc-serve", content: "ssh-ed25519 AAAAKEY gunbc-serve" },
    EnsureLedgerDirectory { path: "/srv/gunbc/ledger", owner_user: "gunbc-serve", owner_group: "gunbc-serve", mode: d.authorized_keys_mode },
    EnsureCheckout { dir: "/srv/gunbc/checkout", clone_url: "https://example.invalid/gunbc.git", revision: "deadbeef", as_user: "gunbc-serve" },
    EnsureToolchain { channel: "1.95.0", as_user: "gunbc-serve" },
    EnsureRustup { installer_url: "https://static.rust-lang.org/rustup-init", expected_sha256: "aaa", as_user: "gunbc-serve", rustup_home: "/home/gunbc-serve/.rustup", cargo_home: "/home/gunbc-serve/.cargo" },
    EnsureUserManagerLinger { account: "gunbc-serve" },
    InstallUserWorkSlice { unit_name: user_work_slice_unit_name, unit_path: "/run/systemd/user/gunbc-user-work.slice", memory_max: byte_size(1), memory_high: byte_size(1), memory_swap_max: byte_size(1), expected_content: "[Unit]" },
    InstallServeBinary { upload_path: "/tmp/up", install_path: "/opt/gunbc/bin/gunbc", expected_sha256: "aaa" },
    RecordServeIdentity { install_path: "/opt/gunbc/bin/gunbc", revision: "deadbeef", sha256: "aaa" },
    // A DISTINCT install_path here so the "every kind" ordering test keeps every action: BuildServeBinary
    // shares InstallServeBinary's "binary:"+path dedup key, so on the SAME path the two collapse (the
    // dedicated dedup witness below proves that); on a different path both survive as distinct kinds.
    BuildServeBinary { checkout_dir: "/srv/gunbc/checkout", revision: "deadbeef", package: "gunbc", bin: "gunbc", target_dir: "/home/gunbc-serve/.cache/gunbc-build-target", install_path: "/opt/gunbc/bin/gunbc-native" },
    RecoverStaleSeat { reference: "gunbc-build.identity#1" as NonEmptyStr },
  ]
}
// The recovery doors are RUN AS THE SERVING ACCOUNT through sudo, and two measured refusals on srv1
// (runs 44976395909, 44980662577, 2026-11-22) name the two seams this claim holds shut. (1) A door that
// bears host effects is refused by its OWN user-work-scope gate unless the account's user manager is
// reachable to wrap it into the capped gunbc-user-work.slice — exit 2 "cannot wrap into
// gunbc-user-work.slice (UserSessionAbsent)" — so the argv binds the account's own session environment
// (gunbc.host.user_session_runtime). (2) The seed's workspace-root scaffold treats a SET
// GUNBC_WORKSPACE_ROOT as the release-locus authority and refuses a plain checkout for lack of a tree
// receipt — so the argv binds NOTHING there and instead STARTS the door in the serving checkout
// (env -C), where the .git walk binds the root, exactly as the admitted serve route's forced command
// starts its door (gunbc.compute.remote_build_serve remote_build_forced_command_words). GREEN: "-C
// <checkout>" and the two session bindings form one contiguous env-prefix block ahead of the door, and
// GUNBC_WORKSPACE_ROOT appears nowhere in it.
test fn the_recovery_door_argv_binds_the_accounts_own_user_session() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => match converge_gunbc_door_argv(
      d: d,
      function: "compute_recover_catalog_serving_cli",
      arguments: [NamedArgumentRequest { name: "host", value: d.host as String }],
      runtime_dir: user_session_runtime_dir(uid: 999)
    ) {
      Absent => false
      Present { value: argv } => {
        let words = join(argv, " ")
        string_contains(s: words, pattern: concat(concat(concat("-C ", d.checkout_dir as String), " XDG_RUNTIME_DIR=/run/user/999"), " DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/999/bus"))
          && (!string_contains(s: words, pattern: concat(gunbc_workspace_root_env_name, "=")))
          && string_contains(s: words, pattern: "compute_recover_catalog_serving_cli")
          && string_contains(s: words, pattern: "host")
          && (!string_contains(s: words, pattern: "repo_root"))
      }
    }
  }
}

// THE THREE RECOVERY DOOR LEGS RIDE THE DOOR CEILING, not the actuation ceiling. A door is a gunbc
// CLI run whose wall-clock begins with the host engine's cold entry resolution; converge apply
// 45354782930 proved the mismatch on srv1: the seat census was killed at the 60s ActuationLeg ceiling
// "before the host could answer" while the door was still resolving its entry, and the overrun folded
// — correctly — into an unknown census that refused the plan. The serve route had already classified
// its host-side gunbc leg as ProvisioningLeg (gunbc.compute.remote_build_client); the doors ride the
// same kind, decided once by serving_door_leg_kind, and this claim goes red the moment a door leg is
// reclassified back down (or the kind drifts to something whose ceiling equals the actuation one).
test fn the_recovery_door_legs_ride_the_door_ceiling() -> Bool {
  match serving_door_leg_kind() {
    ProvisioningLeg => fleet_leg_wall_deadline(kind: serving_door_leg_kind()) != fleet_leg_wall_deadline(kind: ActuationLeg)
    _ => false
  }
}

test fn converge_order_preserves_every_action_kind() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      let all = every_converge_action(d)
      let ordered = converge_order(all)
      length(ordered) == length(all) && length(filter(all, e => list_member(xs: ordered, x: e, eq: (a, b) => converge_action_key(a) == converge_action_key(b)))) == length(all)
    }
  }
}

// RB-M3 native-build arm: the native build and the pool upload are the SAME binary leg of a path -- they
// share the "binary:"+install_path dedup key, so a host settles its serve binary through exactly ONE of
// them. If both were ever drafted for one path (a plan bug, or a flip-flopping host), converge_order
// collapses them to a single write rather than letting the host receive a pool binary AND build its own.
// Arch-independent (pure model), so it is written before the architecture authority lands.
test fn native_build_and_upload_collapse_on_one_path() -> Bool {
  let up = InstallServeBinary { upload_path: "/tmp/up", install_path: "/opt/gunbc/bin/gunbc", expected_sha256: "aaa" }
  let native = BuildServeBinary { checkout_dir: "/srv/gunbc/checkout", revision: "deadbeef", package: "gunbc", bin: "gunbc", target_dir: "/home/gunbc-serve/.cache/gunbc-build-target", install_path: "/opt/gunbc/bin/gunbc" }
  converge_action_key(up) == converge_action_key(native) && length(converge_dedupe([up, native])) == 1
}

// The native build must still be ORDERED as a binary-leg write: after the checkout (rank 5) and the
// pinned toolchain (ranks 6/7) it builds from, so a build can never be dispatched ahead of the source it
// compiles. This pins the rank arm I added for BuildServeBinary (rank 9, the binary leg).
test fn native_build_ranks_after_its_checkout_and_toolchain() -> Bool {
  let checkout = EnsureCheckout { dir: "/srv/gunbc/checkout", clone_url: "https://example.invalid/gunbc.git", revision: "deadbeef", as_user: "gunbc-serve" }
  let toolchain = EnsureToolchain { channel: "1.95.0", as_user: "gunbc-serve" }
  let native = BuildServeBinary { checkout_dir: "/srv/gunbc/checkout", revision: "deadbeef", package: "gunbc", bin: "gunbc", target_dir: "/home/gunbc-serve/.cache/gunbc-build-target", install_path: "/opt/gunbc/bin/gunbc-native" }
  converge_kind_rank(native) > converge_kind_rank(checkout) && converge_kind_rank(native) > converge_kind_rank(toolchain)
}

// Manager red (RB-M3): an UNREAD host architecture must REFUSE, never default to the upload install.
// The dispatch's target_arch arm refuses on ObservationRefused BEFORE consulting the host arch row, so
// the draft gains the serve-binary refusal in `unhandled` and plans NO install/build write for the
// serve path (length(writes)==0 proves it did not silently fall through to InstallServeBinary/upload).
test fn unread_host_architecture_refuses_never_uploads() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      let r = converge_install_binary(
        acc: converge_draft(),
        d: d,
        pin: pin_ok(),
        target_arch: ObservationRefused { cause: ServingLegFailure { item: "target_arch", cause: "uname -m unread" } }
      )
      any(r.unhandled, x => x == "serve_binary.sha256") && length(r.writes) == 0
    }
  }
}

// ── RB-M3 ken: a CONFIRMED-ABSENT account has a proven-absent slice, not an unread one ──────────────
//
// A brand-new serving host (ken, butch) has no serving account yet. The account leg reads that as a proven
// absence (passwd Established, row absent) and plans EnsureAccount. Its per-user user-work slice is a proven
// absence TOO -- there is no slice without the account -- so the slice leg must contribute an install-target
// DEVIATION, not an unknown. ServingUnknown stays reserved for where nobody read the account (a refused passwd
// read) or systemctl was refused with the account present. This is the fresh-host bootstrap the wet observe
// was refusing (goal_indeterminate), which both serving_assessment_runnable and converge_plan reject, so a
// fresh host could never be converged to create the very account+slice it was waiting on. These fixtures pin
// the contract at the assess/plan level; the live ken observe is the end-to-end acceptance.

fn fresh_host_proven_absent_slice_observed(d: RemoteBuildServingDesired) -> ServingObserved {
  serving_observed_from_reads(
    elevation: est_elevation(),
    account_name: d.account_name,
    passwd: est_s(""),
    group: est_s("root:x:0:\n"),
    authorized_keys: est_s(""),
    store_root: est_absent(), store_staging: est_absent(), store_root_mode: store_mode_absent(), store_staging_mode: store_mode_absent(), serve_binary: est_absent(),
    scratch_root: est_absent(), scratch_root_mode: store_mode_absent(),
    checkout: est_absent(), toolchain: est_absent(), rustup: est_absent(),
    serve_binary_sha256: Absent, checkout_revision: Absent,
    authorized_keys_mode: Absent, serve_binary_mode: Absent,
    user_work_slice_max: ObservationEstablished { observed: CgroupMemoryUnlimited },
    user_work_slice_high: ObservationEstablished { observed: CgroupMemoryUnlimited },
    user_work_slice_swap: ObservationEstablished { observed: CgroupMemoryUnlimited },
    user_manager_linger: ObservationEstablished { observed: false },
    target_arch: est_s(pin_arch()), ledger_rows: matched_ledger(d: d),
    serve_identity: Absent,
    seat_census: RecoverCatalogLegEstablished { entries: [] },)
}

fn rank_account_write(ws: List<ConvergeAction>) -> Int {
  match first_where(ws, keep: a => is_ensure_account(a)) {
    Absent => -1
    Present { value: a } => converge_kind_rank(a)
  }
}

fn rank_slice_install(ws: List<ConvergeAction>) -> Int {
  match first_where(ws, keep: a => is_install_slice(a)) {
    Absent => -1
    Present { value: a } => converge_kind_rank(a)
  }
}

// DOWNSTREAM GUARANTEE (the pure gate claims at the foot of this section are the discriminator for this
// PR): a confirmed-absent account with a proven-absent slice is RUNNABLE drift, and the plan
// drafts the account BEFORE the slice it lives under (EnsureAccount rank 1 < InstallUserWorkSlice rank 8),
// exactly one slice install, the whole list ordered by kind. This is the host the observe used to refuse.
test fn fresh_host_proven_absent_slice_plans_useradd_before_slice_install() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      let asmt = serving_assess(d: d, o: fresh_host_proven_absent_slice_observed(d: d), pin: pin_ok())
      let plan = converge_plan(d: d, a: asmt, pin: pin_ok(), target_arch: est_s(pin_arch()), rustup: est_absent())
      let ws = plan_writes(plan)
      plan_is_refused(plan) == false && plan_is_unhandled(plan) == false
        && length(filter(ws, x => is_install_slice(x))) == 1
        && length(filter(ws, x => is_ensure_account(x))) == 1
        && rank_account_write(ws: ws) >= 0 && rank_slice_install(ws: ws) >= 0
        && rank_account_write(ws: ws) < rank_slice_install(ws: ws)
        && writes_sorted_by_kind(ws)
    }
  }
}

// The two cap builders are ONE-WAY apart, and that asymmetry is the whole gate: the proven-absent read is
// established-unbounded (it LICENSES an install), the refused read is refused everywhere (an unknown). A
// confirmed-absent account must use the former; the reserved unreadable cases use the latter.
test fn the_proven_absent_slice_read_is_established_and_the_refused_read_is_refused() -> Bool {
  let a = serving_slice_cap_account_absent()
  let all_established = match a.max { ObservationEstablished { observed: CgroupMemoryUnlimited } => true _ => false }
    && match a.high { ObservationEstablished { observed: CgroupMemoryUnlimited } => true _ => false }
    && match a.swap { ObservationEstablished { observed: CgroupMemoryUnlimited } => true _ => false }
  let r = serving_slice_cap_refused(cause: "passwd read refused; slice not locatable")
  let all_refused = match r.max { ObservationRefused { cause: _ } => true _ => false }
    && match r.high { ObservationRefused { cause: _ } => true _ => false }
    && match r.swap { ObservationRefused { cause: _ } => true _ => false }
  all_established && all_refused
}

// RESERVED-BEHAVIOUR GUARD (not the discriminator for this PR — it holds with or without the gate): an
// account that is PRESENT but whose slice systemctl
// could not be read (all three controls refused) is indeterminate -- the converge refuses and writes nothing,
// exactly as before. The fix does NOT turn a genuinely-unread slice into an install.
fn all_slice_refused_account_present_observed(d: RemoteBuildServingDesired, line: String) -> ServingObserved {
  serving_observed_from_reads(
    elevation: est_elevation(),
    account_name: d.account_name,
    passwd: est_s("gunbc-build:x:1005:1005:remote-build:/home/gunbc-build:/bin/bash\n"),
    group: est_s(converged_groups()),
    authorized_keys: est_s(line),
    store_root: est_ok(), store_staging: est_ok(), store_root_mode: store_mode_ok(d: d), store_staging_mode: store_mode_ok(d: d), serve_binary: est_ok(),
    scratch_root: est_ok(), scratch_root_mode: scratch_mode_ok(d: d),
    checkout: est_ok(), toolchain: est_ok(), rustup: est_ok(),
    serve_binary_sha256: Present { value: est_s(pin_sha()) }, checkout_revision: Present { value: est_s(pin_rev()) },
    authorized_keys_mode: Present { value: est_s(text: file_mode_octal(mode: d.authorized_keys_mode)) },
    serve_binary_mode: Present { value: est_s(text: file_mode_octal(mode: d.serve_binary_mode)) },
    user_work_slice_max: ObservationRefused { cause: ServingLegFailure { item: "user_work.slice", cause: "systemctl refused, account present" } },
    user_work_slice_high: ObservationRefused { cause: ServingLegFailure { item: "user_work.slice", cause: "systemctl refused, account present" } },
    user_work_slice_swap: ObservationRefused { cause: ServingLegFailure { item: "user_work.slice", cause: "systemctl refused, account present" } },
    user_manager_linger: ObservationEstablished { observed: true },
    target_arch: est_s(pin_arch()), ledger_rows: matched_ledger(d: d),
    serve_identity: Absent,
    seat_census: RecoverCatalogLegEstablished { entries: [] },)
}

test fn all_slice_controls_refused_with_account_present_is_indeterminate() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      match d.forced_command_line {
        Absent => false
        Present { value: line } => {
          let asmt = serving_assess(d: d, o: all_slice_refused_account_present_observed(d: d, line: line), pin: pin_ok())
          let plan = converge_plan(d: d, a: asmt, pin: pin_ok(), target_arch: est_s(pin_arch()), rustup: est_ok())
          plan_is_refused(plan) && length(plan_writes(plan)) == 0
        }
      }
    }
  }
}

// RESERVED-BEHAVIOUR GUARD (the chain claim refused_passwd_read_drives_the_gate_to_the_systemd_read is the
// discriminator; this is the end-to-end consequence): a refused /etc/passwd read (nobody read the account at all) is indeterminate, NOT a
// fabricated proven-absent install. The slice is capped/settled here so the refused passwd is the only
// unread leg -- if the gate confused 'passwd refused' with 'account confirmed absent' this host would plan a
// useradd+slice install off a read nobody completed, which is the fabrication the contract forbids.
fn refused_passwd_settled_slice_observed(d: RemoteBuildServingDesired, line: String) -> ServingObserved {
  serving_observed_from_reads(
    elevation: est_elevation(),
    account_name: d.account_name,
    passwd: ObservationRefused { cause: ServingLegFailure { item: "account.uid", cause: "/etc/passwd read refused" } },
    group: est_s(converged_groups()),
    authorized_keys: est_s(line),
    store_root: est_ok(), store_staging: est_ok(), store_root_mode: store_mode_ok(d: d), store_staging_mode: store_mode_ok(d: d), serve_binary: est_ok(),
    scratch_root: est_ok(), scratch_root_mode: scratch_mode_ok(d: d),
    checkout: est_ok(), toolchain: est_ok(), rustup: est_ok(),
    serve_binary_sha256: Present { value: est_s(pin_sha()) }, checkout_revision: Present { value: est_s(pin_rev()) },
    authorized_keys_mode: Present { value: est_s(text: file_mode_octal(mode: d.authorized_keys_mode)) },
    serve_binary_mode: Present { value: est_s(text: file_mode_octal(mode: d.serve_binary_mode)) },
    user_work_slice_max: settled_slice_max(ceiling: user_work_slice_memory_max_for_host(host: d.host)),
    user_work_slice_high: settled_slice_high(ceiling: user_work_slice_memory_max_for_host(host: d.host)),
    user_work_slice_swap: ObservationEstablished { observed: CgroupMemoryLimited { bytes: user_work_slice_memory_swap_max } },
    user_manager_linger: ObservationEstablished { observed: true },
    target_arch: est_s(pin_arch()), ledger_rows: matched_ledger(d: d),
    serve_identity: Absent,
    seat_census: RecoverCatalogLegEstablished { entries: [] },)
}

test fn refused_passwd_read_is_indeterminate_not_a_fabricated_install() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      match d.forced_command_line {
        Absent => false
        Present { value: line } => {
          let asmt = serving_assess(d: d, o: refused_passwd_settled_slice_observed(d: d, line: line), pin: pin_ok())
          let plan = converge_plan(d: d, a: asmt, pin: pin_ok(), target_arch: est_s(pin_arch()), rustup: est_ok())
          plan_is_refused(plan) && length(plan_writes(plan)) == 0
        }
      }
    }
  }
}

// ── THE DISCRIMINATOR for this PR: the pure slice-leg gate over account_gate ─────────────────────────
//
// The whole behaviour this PR adds lives in serving_slice_leg_choice: which cap the observe's slice leg
// reads, decided over the account gate. These claims execute THAT function (and, in the chain claims, the
// real path from the /etc/passwd read through serving_account_presence_gate into it), so they go red the
// moment the gate is reverted to always reading systemd -- which is the fresh-host indeterminate this PR
// fixes. The fixtures above feed the assessment/plan a slice reading and so are downstream guarantees; these
// are the reds for the change itself (fail_closed: "green by execution plus a discriminating input").

fn is_proven_absent_choice(c: ServingSliceLegChoice) -> Bool {
  match c { SliceLegProvenAbsentCap => true _ => false }
}

fn is_read_systemd_choice(c: ServingSliceLegChoice) -> Bool {
  match c { SliceLegReadSystemd => true _ => false }
}

test fn slice_gate_established_false_picks_the_proven_absent_cap() -> Bool {
  is_proven_absent_choice(serving_slice_leg_choice(account_gate: ObservationEstablished { observed: false }))
}

test fn slice_gate_established_true_picks_the_systemd_read() -> Bool {
  is_read_systemd_choice(serving_slice_leg_choice(account_gate: ObservationEstablished { observed: true }))
}

test fn slice_gate_refused_passwd_picks_the_systemd_read() -> Bool {
  is_read_systemd_choice(serving_slice_leg_choice(account_gate: ObservationRefused { cause: ServingLegFailure { item: "account.uid", cause: "passwd refused" } }))
}

// Chain claims: the gate is not driven from a hand-built gate value but from the SAME reads the observe
// feeds it, so they pin the real decision end-to-end without a host (witness_one_interface).

test fn fresh_host_passwd_read_drives_the_gate_to_the_proven_absent_cap() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      // passwd established with the account row simply not present
      let gate = serving_account_presence_gate(account_name: d.account_name, passwd: est_s("root:x:0:0:root:/root:/bin/bash\n"))
      is_proven_absent_choice(serving_slice_leg_choice(account_gate: gate))
    }
  }
}

test fn present_account_passwd_read_drives_the_gate_to_the_systemd_read() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      let row = join([d.account_name, ":x:1005:1005:", d.account_name, ":/home/", d.account_name, ":/bin/bash\n"], "")
      let gate = serving_account_presence_gate(account_name: d.account_name, passwd: est_s(row))
      is_read_systemd_choice(serving_slice_leg_choice(account_gate: gate))
    }
  }
}

test fn refused_passwd_read_drives_the_gate_to_the_systemd_read() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      let gate = serving_account_presence_gate(account_name: d.account_name, passwd: ObservationRefused { cause: ServingLegFailure { item: "account.uid", cause: "/etc/passwd read refused" } })
      is_read_systemd_choice(serving_slice_leg_choice(account_gate: gate))
    }
  }
}

// ── serving-observe-reads-absent-toolchain-as-drift (RB-M3 follow-up, lively-owl-722) ──
//
// End-to-end half of the follow-up: the OBSERVE now reads a fresh account's 127 toolchain listing as
// DRIFT (see the setup witness), so the CONVERGE plans the bootstrap on exactly the host the live ken /
// butch converges could not (rustup proven absent + `rustup toolchain list` exit 127). Before the fix
// the assessment was indeterminate and converge_plan refused with ZERO writes; this claim is the red for
// that: it requires the verified EnsureRustup before the EnsureToolchain on a refused-toolchain fresh host.

// The fresh host (account absent, everything absent) with the toolchain listing REFUSED (the 127) rather
// than merely established-absent -- the shape a real `rustup toolchain list` on an account with no rustup
// produces. rustup itself is proven absent (the test -x leg).
fn fresh_absent_observed_refused_toolchain(dline: String, d: RemoteBuildServingDesired) -> ServingObserved {
  serving_observed_from_reads(
    elevation: est_elevation(),
    account_name: d.account_name,
    passwd: est_s(""),
    group: est_s("root:x:0:\n"),
    authorized_keys: est_s(""),
    store_root: est_absent(), store_staging: est_absent(), store_root_mode: store_mode_absent(), store_staging_mode: store_mode_absent(), serve_binary: est_absent(),
    scratch_root: est_absent(), scratch_root_mode: store_mode_absent(),
    checkout: est_absent(), toolchain: refused_b(), rustup: est_absent(),
    serve_binary_sha256: Absent, checkout_revision: Absent,
    authorized_keys_mode: Absent, serve_binary_mode: Absent,
    user_work_slice_max: settled_slice_max(ceiling: user_work_slice_memory_max_for_host(host: d.host)),
    user_work_slice_high: settled_slice_high(ceiling: user_work_slice_memory_max_for_host(host: d.host)),
    user_work_slice_swap: ObservationEstablished { observed: CgroupMemoryLimited { bytes: user_work_slice_memory_swap_max } },
    user_manager_linger: ObservationEstablished { observed: false },
    target_arch: est_s(pin_arch()), ledger_rows: matched_ledger(d: d),
    serve_identity: Absent,
    seat_census: RecoverCatalogLegEstablished { entries: [] },)
}

test fn a_fresh_account_with_a_refused_toolchain_listing_still_plans_the_bootstrap() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => match rustup_init_release(version: serving_rustup_init_version, triple: "aarch64-unknown-linux-gnu") {
      Absent => false
      Present { value: r } => {
        let a = serving_assess(d: d, o: fresh_absent_observed_refused_toolchain(forced_line(d), d), pin: pin_ok())
        let ws = plan_writes(converge_plan(d: d, a: a, pin: pin_ok(), target_arch: est_s(pin_arch()), rustup: est_absent()))
        let carries = match rustup_write(ws) {
          Absent => false
          Present { value: w } => match w {
            EnsureRustup { installer_url: u, expected_sha256: h, as_user: usr, rustup_home: rh, cargo_home: ch } =>
              u == (rustup_init_url(r: r) as String) && string_contains(s: u, pattern: "/aarch64-unknown-linux-gnu/")
                && h == (r.sha256 as String) && usr == d.account_name && rh == d.rustup_home && ch == d.cargo_home
            _ => false
          }
        }
        carries
          && rank_of_rustup(ws: ws) < rank_of_toolchain(ws: ws)
          && has_toolchain_write(ws: ws, channel: pin_ok().toolchain_channel, as_user: d.account_name)
      }
    }
  }
}

// THE CENSUS UNKNOWN REASON NAMES THE CENSUS, NOT THE TRANSPORT (plan node
// remote-build-census-unknown-reason-names-the-census-not-the-transport). The leg's exit-2 arm takes
// its reason from the census's own declared stdout words; stderr -- where the user-work-scope
// trampoline's pre-wrap diagnostics print on EVERY census leg that must wrap into the capped slice --
// is structurally invisible to it: recover_catalog_unknown_leg_reason's signature receives only
// stdout. The second half pins the arm itself: the compose-from-stderr literal is gone from this
// module's source, and the arm reads through the stdout-only function. Run 45762320308 logged
// "user_work_scope: observed-bound arm did not admit (chain-unbounded)" -- printed before a SUCCESSFUL
// wrap, beside a census that had answered in full -- as the census's cause; that conflation is red
// here.
test fn the_census_unknown_reason_names_the_census_not_the_transport() -> Bool {
  let w = recover_catalog_words()
  let census_words = "2c56092770fe88b27a6fb4c2baf546a5520ab42518314397904d2f0bd744b346#1: the attempt is already terminal:recovered"
  let read = Filesystem.Read(path: "dag/gunbc/compute/remote_build_serving_converge.dag")
  (match recover_catalog_unknown_leg_reason(stdout: join([w.unknown_header, " ", census_words, "\n"], "")) {
    RecoverCatalogLegUnknown { detail: d } =>
      string_contains(s: d, pattern: "terminal:recovered")
        && !string_contains(s: d, pattern: "user_work_scope")
    _ => false
  })
    && (match recover_catalog_unknown_leg_reason(stdout: join([w.established_header, "\n"], "")) {
        RecoverCatalogLegUnknown { detail: d } => string_contains(s: d, pattern: "exited unknown")
        _ => false
      })
    && read.success
    && string_contains(s: read.content, pattern: "recover_catalog_unknown_leg_reason(stdout: r.stdout)")
    && !string_contains(s: read.content, pattern: "the census door answered unknown: ")
}
