module test.claim.compute.remote_build_serving_converge_witness

// PR 5(a): the read-only observe arm's receipt COMPOSITION. It lives in the converge module
// so importing it forces the whole observe entry (the fleet-converge workflow --function) to
// type-check; the cells prove the receipt carries the host/probe header and the terminal
// state, and that it NEVER leaks a secret (the authorized_keys forced-command line is printed
// only by NAME, never by value). The value-comparison and the indeterminate-vs-drift red
// controls live in test.claim.compute.remote_build_serving_setup_witness. Run:
//   gunbc run --source-root dag --source-root src/v2 \
//     --entry dag/test/claim/compute/remote_build_serving_converge_witness.dag --claim-run

import std.optional { Present, Absent }
import std.algebra { string_contains, non_empty_to_list }
import std.goal_assessment { ObservationAttempt, ObservationEstablished, ObservationRefused }
import std.list { first_duplicate_by_key, first_where }
import gunbc.fleet.fleet_host_identity { operator_host_srv1 }
import gunbc.owned_directory { OwnedDirectoryTarget, owned_directory_owner, owned_directory_path }
import gunbc.compute.remote_build_serving_setup {
  remote_build_serving_desired, RemoteBuildServingDesired, serving_assess, serving_observed_from_reads, ServingObserved,
  ServingLegFailure, serving_forced_command_line,
  ServingPlanInput, ServingLedgerRowObserved, serving_ledger_declared_mode_octal,
  serving_store_dir_mode_octal,
}
import gunbc.compute.remote_build_serving_converge { serving_receipt_body, converge_plan, ConvergeAction, ConvergeDecision, ConvergePlan, ConvergeSettled, ConvergeUnhandled, ConvergeRefused, converge_kind_rank, converge_action_key, converge_checkout_cause }

fn est_s(text: String) -> ObservationAttempt<String, ServingLegFailure> {
  ObservationEstablished { observed: text }
}

fn est_ok() -> ObservationAttempt<Bool, ServingLegFailure> {
  ObservationEstablished { observed: true }
}

// The elevation precondition (review 95915). est_elevation() = the sudo grant works;
// refused_elevation() = 'sudo -n' refused, so every sudo-dependent leg must become unread
// (Indeterminate) rather than "confirmed absent".
fn est_elevation() -> ObservationAttempt<Bool, ServingLegFailure> {
  ObservationEstablished { observed: true }
}

fn refused_elevation() -> ObservationAttempt<Bool, ServingLegFailure> {
  ObservationRefused { cause: ServingLegFailure { item: "elevation", cause: "sudo -n refused" } }
}

fn est_absent() -> ObservationAttempt<Bool, ServingLegFailure> {
  ObservationEstablished { observed: false }
}

// The executor plan-time pin, and matched pins so the ONLY drift in a drifted fixture is the one
// the cell breaks (here: a confirmed-absent store dir). The three string legs stand equal to the
// pin, and every ledger row reads its declared owner/group/mode, so no spurious deviation.
fn pin_sha() -> String { "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }
fn pin_rev() -> String { "0123456789abcdef0123456789abcdef01234567" }
fn pin_arch() -> String { "aarch64" }
fn pin_ok() -> ServingPlanInput {
  ServingPlanInput { dispatched_revision: pin_rev(), executor_arch: pin_arch(), local_binary_sha256: pin_sha(), toolchain_channel: "1.90.0" }
}
fn matched_ledger(d: RemoteBuildServingDesired) -> List<ServingLedgerRowObserved> {
  map(d.ledger_dirs, t => ServingLedgerRowObserved {
    path: owned_directory_path(t: t),
    user: est_s(owned_directory_owner(t: t).user as String),
    group: est_s(owned_directory_owner(t: t).group as String),
    mode: est_s(serving_ledger_declared_mode_octal(t: t)),
  })
}

// The store-mode legs, derived from the SAME declared store-dir mode the desired state carries (never a
// bare octal reauthored per cell), so a "correct" fixture proves the mode and only the mode drifts.
fn store_mode_ok(d: RemoteBuildServingDesired) -> ObservationAttempt<String, ServingLegFailure> {
  est_s(text: serving_store_dir_mode_octal(d: d))
}

fn store_mode_absent() -> ObservationAttempt<String, ServingLegFailure> {
  est_s(text: "")
}

fn store_mode_refused(item: String) -> ObservationAttempt<String, ServingLegFailure> {
  ObservationRefused { cause: ServingLegFailure { item: item, cause: "stat failed" } }
}

// A host that is correct except a confirmed-absent store directory: a real drift, whose
// assessment carries the secret forced-command line in its structured deviation but which the
// receipt must render by NAME only.
fn drifted_observed(dline: String, d: RemoteBuildServingDesired) -> ServingObserved {
  serving_observed_from_reads(
    elevation: est_elevation(),
    passwd: est_s("gunbc-build:x:1005:1005:remote-build:/home/gunbc-build:/bin/bash\n"),
    group: est_s(converged_groups()),
    authorized_keys: est_s(dline),
    store_root: est_absent(), store_staging: est_ok(), store_root_mode: store_mode_absent(), store_staging_mode: store_mode_ok(d: d), serve_binary: est_ok(),
    checkout: est_ok(), toolchain: est_ok(),
    serve_binary_sha256: est_s(pin_sha()), checkout_revision: est_s(pin_rev()),
    target_arch: est_s(pin_arch()), ledger_rows: matched_ledger(d: d),
  )
}

// A converged /etc/group carries BOTH required groups at their declared gids: the ledger group
// (gunbc-compute @ 1006, with the members) and the account's own PRIMARY group (gunbc-build @ 1005).
// Fixtures that mean "everything but <the one tested drift> is correct" must include both, or the
// observe reports a spurious GroupAbsent and the plan picks up an extra groupadd the cell didn't mean.
fn converged_groups() -> String {
  "gunbc-compute:x:1006:briansrls,gunbc-build\ngunbc-build:x:1005:\n"
}

// The authorized_keys content AS THE DESIRED STATE DECLARES IT, so a fixture that breaks some other leg
// keeps this leg matched and tests only the leg it means to break (the refused-elevation cell below is
// about elevation, not about keys). An absent desired line renders as the empty string — never as a
// fabricated command line (gunbc.design_argument::fail_closed: "no plausible output is fabricated").
fn forced_line(d: RemoteBuildServingDesired) -> String {
  match d.forced_command_line {
    Present { value: line } => line
    Absent => ""
  }
}

// How a cell reads a decision: by WHICH ARM it is, never by a Bool tag. A ConvergePlan carries the only
// non-empty write list there is; the other three arms have nothing to execute — the empty list below is
// not a field that was left empty, it is the absence of the arm that could carry one.
fn plan_writes(plan: ConvergeDecision) -> List<ConvergeAction> {
  match plan {
    ConvergePlan { writes: ws } => non_empty_to_list(ws)
    ConvergeSettled => []
    ConvergeUnhandled { items: _ } => []
    ConvergeRefused { reason: _ } => []
  }
}

fn plan_is_refused(plan: ConvergeDecision) -> Bool {
  match plan {
    ConvergeRefused { reason: _ } => true
    ConvergeSettled => false
    ConvergeUnhandled { items: _ } => false
    ConvergePlan { writes: _ } => false
  }
}

fn plan_is_unhandled(plan: ConvergeDecision) -> Bool {
  match plan {
    ConvergeUnhandled { items: _ } => true
    ConvergeSettled => false
    ConvergePlan { writes: _ } => false
    ConvergeRefused { reason: _ } => false
  }
}

// The header names the host and the probed_at context; the body names the terminal state.
test fn the_receipt_body_names_the_host_and_the_drift() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
  match d.forced_command_line {
    Absent => false
    Present { value: line } => {
      let a = serving_assess(d: d, o: drifted_observed(line, d), pin: pin_ok())
      let body = serving_receipt_body(host_name: "srv1.example", probed_at: "2026-11-16T00:00:00Z", context_receipt: "fleet ssh receipt\n", assessment: a)
      string_contains(s: body, pattern: "srv1.example") && string_contains(s: body, pattern: "remote-build-serving-plan: drift")
    }
  }
    }
  }
}

// LEAK CONTROL: the receipt must carry the unmet item by NAME but never the value of the
// secret forced-command line (the candidate public key / command). A naive renderer that
// printed deviations' observed/desired strings would leak the key into a CI artifact.
test fn the_receipt_body_leaks_no_forced_command_material() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
  match d.forced_command_line {
    Absent => false
    Present { value: line } => {
      let a = serving_assess(d: d, o: drifted_observed(line, d), pin: pin_ok())
      let body = serving_receipt_body(host_name: "srv1.example", probed_at: "T", context_receipt: "", assessment: a)
      string_contains(s: body, pattern: "store.root") && string_contains(s: body, pattern: line) == false
    }
  }
    }
  }
}

// An already-converged host's receipt is the settled/adopt wording — the observe reports the
// host as a no-op rather than planning to rebuild it.
test fn a_converged_host_receipt_reports_settled() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
  match d.forced_command_line {
    Absent => false
    Present { value: line } => {
      let a = serving_assess(d: d, o: serving_observed_from_reads(
        elevation: est_elevation(),
        passwd: est_s("gunbc-build:x:1005:1005:remote-build:/home/gunbc-build:/bin/bash\n"),
        group: est_s(converged_groups()),
        authorized_keys: est_s(line),
        store_root: est_ok(), store_staging: est_ok(), store_root_mode: store_mode_ok(d: d), store_staging_mode: store_mode_ok(d: d), serve_binary: est_ok(),
        checkout: est_ok(), toolchain: est_ok(),
        serve_binary_sha256: est_s(pin_sha()), checkout_revision: est_s(pin_rev()),
        target_arch: est_s(pin_arch()), ledger_rows: matched_ledger(d: d),
      ), pin: pin_ok())
      let body = serving_receipt_body(host_name: "srv1.example", probed_at: "T", context_receipt: "", assessment: a)
      string_contains(s: body, pattern: "remote-build-serving-plan: settled")
    }
  }
    }
  }
}

fn refused_b() -> ObservationAttempt<Bool, ServingLegFailure> {
  ObservationRefused { cause: ServingLegFailure { item: "store.root", cause: "ssh refused" } }
}

// converge_plan: a host that is correct except a confirmed-absent store dir plans exactly ONE write
// (that directory), records nothing unhandled, and is not refused. The single-drift fixture means the
// count is a real assertion, not a "some writes appeared" — a spurious deviation would inflate it.
test fn diverged_store_plans_a_matching_write() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
  match d.forced_command_line {
    Absent => false
    Present { value: line } => {
      let a = serving_assess(d: d, o: drifted_observed(line, d), pin: pin_ok())
      let plan = converge_plan(d: d, a: a, pin: pin_ok(), target_arch: est_s(pin_arch()))
      plan_is_refused(plan) == false && plan_is_unhandled(plan) == false && length(plan_writes(plan)) == 1
    }
  }
    }
  }
}

// THE red control: an unread leg makes the assessment indeterminate, and the plan then writes
// NOTHING and refuses. An apply must never write an item it never observed — a host nobody fully
// read is not a host to mutate (std.goal_assessment paragraph ONE; gunbc.design_argument::fail_closed).
test fn unread_leg_plans_nothing_and_refuses() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
  match d.forced_command_line {
    Absent => false
    Present { value: line } => {
      let o = serving_observed_from_reads(
        elevation: est_elevation(),
        passwd: est_s("gunbc-build:x:1005:1005:remote-build:/home/gunbc-build:/bin/bash\n"),
        group: est_s(converged_groups()),
        authorized_keys: est_s(line),
        store_root: refused_b(), store_staging: est_ok(), store_root_mode: store_mode_refused(item: "store.root.mode"), store_staging_mode: store_mode_ok(d: d), serve_binary: est_ok(),
        checkout: est_ok(), toolchain: est_ok(),
        serve_binary_sha256: est_s(pin_sha()), checkout_revision: est_s(pin_rev()),
        target_arch: est_s(pin_arch()), ledger_rows: matched_ledger(d: d),
      )
      let a = serving_assess(d: d, o: o, pin: pin_ok())
      let plan = converge_plan(d: d, a: a, pin: pin_ok(), target_arch: est_s(pin_arch()))
      plan_is_refused(plan) && length(plan_writes(plan)) == 0
    }
  }
    }
  }
}

// The no-arch-arm guarantee: an arch mismatch is a divergence with NO remediation arm, so the plan
// records host.arch as unhandled (the wet apply then refuses rather than installing an off-arch
// binary) and plans no writes. host.arch must never be silently "fixed".
test fn host_arch_mismatch_is_unhandled_not_written() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
  match d.forced_command_line {
    Absent => false
    Present { value: line } => {
      let o = serving_observed_from_reads(
        elevation: est_elevation(),
        passwd: est_s("gunbc-build:x:1005:1005:remote-build:/home/gunbc-build:/bin/bash\n"),
        group: est_s(converged_groups()),
        authorized_keys: est_s(line),
        store_root: est_ok(), store_staging: est_ok(), store_root_mode: store_mode_ok(d: d), store_staging_mode: store_mode_ok(d: d), serve_binary: est_ok(),
        checkout: est_ok(), toolchain: est_ok(),
        serve_binary_sha256: est_s(pin_sha()), checkout_revision: est_s(pin_rev()),
        target_arch: est_s("x86_64"), ledger_rows: matched_ledger(d: d),
      )
      let a = serving_assess(d: d, o: o, pin: pin_ok())
      let plan = converge_plan(d: d, a: a, pin: pin_ok(), target_arch: est_s("x86_64"))
      plan_is_unhandled(plan) && length(plan_writes(plan)) == 0
    }
  }
    }
  }
}

// ── review 5b: write ordering + dedupe, and uid/gid-mismatch refusal ───────────────────────────────

// A write list is ordered iff no element has a rank lower than the max seen so far. converge_plan
// re-derives order by action KIND (groups, account, membership, dirs+ledger, ak, checkout, binary), so on
// a fresh host useradd always precedes the checkout / authorized_keys / store writes that depend on it —
// instead of the reverse-deviation-order the fold's prepend produced.
type WRankState { prev: Int, bad: Int }

fn writes_sorted_by_kind(ws: List<ConvergeAction>) -> Bool {
  let st = fold(ws, init: WRankState { prev: -1, bad: 0 }, f: (s, a) => {
    let r = converge_kind_rank(a)
    if r < s.prev { WRankState { prev: s.prev, bad: s.bad + 1 } } else { WRankState { prev: r, bad: s.bad } }
  })
  st.bad == 0
}

// Count EnsureGroup writes by name+gid / by name / at all, and whether the account's EnsureAccount names
// the account's OWN primary group. These drive the fresh-host red control (review 95905 follow-up): the
// two groups are created at their OWN gids and never cross-paired.
fn all_group_writes(ws: List<ConvergeAction>) -> Int {
  length(filter(ws, a => match a { EnsureGroup { name: _, gid: _ } => true  _ => false }))
}

fn group_writes_at(ws: List<ConvergeAction>, name: String, gid: Int) -> Int {
  length(filter(ws, a => match a { EnsureGroup { name: n, gid: g } => n == name && g == gid  _ => false }))
}

fn has_account_primary(ws: List<ConvergeAction>, pg: String) -> Bool {
  length(filter(ws, a => match a {
    EnsureAccount { name: _, uid: _, gid: _, primary_group: p, home: _, shell: _, supplementary: _ } => p == pg
    _ => false
  })) > 0
}

// A fresh host: the account is absent (empty /etc/passwd), NEITHER required group exists, and the store
// dirs + checkout + serve binary are confirmed-absent — so the plan must create, in dependency order, both
// groups (at their own gids), the account (primary group = its own), the ledger-group membership, the dirs,
// the checkout and the binary. This is the fixture the ORDER + CROSS-PAIRING controls below act on.
fn fresh_absent_observed(dline: String, d: RemoteBuildServingDesired) -> ServingObserved {
  serving_observed_from_reads(
    elevation: est_elevation(),
    passwd: est_s(""),
    group: est_s("root:x:0:\n"),
    authorized_keys: est_s(dline),
    store_root: est_absent(), store_staging: est_absent(), store_root_mode: store_mode_absent(), store_staging_mode: store_mode_absent(), serve_binary: est_absent(),
    checkout: est_absent(), toolchain: est_ok(),
    serve_binary_sha256: est_s(pin_sha()), checkout_revision: est_s(pin_rev()),
    target_arch: est_s(pin_arch()), ledger_rows: matched_ledger(d: d),
  )
}

// ORDER + DEDUPE red control: a fresh host's writes are dirs(rank3) x2, checkout(rank5), binary(rank6) in
// NON-DECREASING rank order (a reverse-fold order would set bad>0), and carry no duplicate identity.
test fn fresh_host_writes_are_ordered_by_action_kind_and_deduped() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
  match d.forced_command_line {
    Absent => false
    Present { value: line } => {
      let a = serving_assess(d: d, o: fresh_absent_observed(line, d), pin: pin_ok())
      let plan = converge_plan(d: d, a: a, pin: pin_ok(), target_arch: est_s(pin_arch()))
      let ws = plan_writes(plan)
      match first_duplicate_by_key(xs: ws, key: converge_action_key) {
        // A fresh host must get groupadd for the account's OWN group at account_gid AND for the ledger
        // group at group_gid (both proven absent), with NO write pairing a group name with the OTHER
        // group's gid (the merge bug review 95905 flagged: creating gunbc-compute at 1005). Exactly two
        // group writes; the account's primary group is its own; all writes in kind order; no duplicates.
        none => plan_is_refused(plan) == false
          && writes_sorted_by_kind(ws)
          && all_group_writes(ws) == 2
          && group_writes_at(ws, d.account_group_name, d.account_gid) == 1
          && group_writes_at(ws, d.group_name, d.group_gid) == 1
          && group_writes_at(ws, d.account_group_name, d.group_gid) == 0
          && group_writes_at(ws, d.group_name, d.account_gid) == 0
          && has_account_primary(ws, d.account_group_name)
        Present { value: _ } => false
      }
    }
  }
    }
  }
}

// UID-MISMATCH red control (review 5b #3 / review 95905 #2): an EXISTING account with the wrong uid is not
// a useradd away from fixed — useradd refuses an existing name, usermod -u would orphan its files. So the
// plan records it UNHANDLED and writes NOTHING; the wet apply's unhandled gate then refuses the host and
// mutates nothing (a human reconciles), rather than applying every other write and failing only at
// re-observe. A genuinely ABSENT account (PresentAbsent) IS handled by the account arm; a MISMATCH is not.
test fn uid_mismatch_is_unhandled_not_planned_as_useradd() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
  match d.forced_command_line {
    Absent => false
    Present { value: line } => {
      let o = serving_observed_from_reads(
        elevation: est_elevation(),
        passwd: est_s("gunbc-build:x:9999:1005:remote-build:/home/gunbc-build:/bin/bash\n"),
        group: est_s(converged_groups()),
        authorized_keys: est_s(line),
        store_root: est_ok(), store_staging: est_ok(), store_root_mode: store_mode_ok(d: d), store_staging_mode: store_mode_ok(d: d), serve_binary: est_ok(),
        checkout: est_ok(), toolchain: est_ok(),
        serve_binary_sha256: est_s(pin_sha()), checkout_revision: est_s(pin_rev()),
        target_arch: est_s(pin_arch()), ledger_rows: matched_ledger(d: d),
      )
      let a = serving_assess(d: d, o: o, pin: pin_ok())
      let plan = converge_plan(d: d, a: a, pin: pin_ok(), target_arch: est_s(pin_arch()))
      plan_is_unhandled(plan) && length(plan_writes(plan)) == 0
    }
  }
    }
  }
}

// ── elevation precondition red control (review 95915, carried into 5(b)) ──────────
// If 'sudo -n' refused, observe reports every sudo-dependent item unread (Indeterminate); the apply
// must therefore plan NOTHING and refuse, so it can never write over files it never read. Paired with
// fresh_host (established elevation plans the writes): the elevation field is load-bearing on the
// apply side too, not just the observe.
test fn refused_elevation_plans_nothing_and_refuses() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      let o = serving_observed_from_reads(
        elevation: refused_elevation(),
        passwd: est_s("gunbc-build:x:1005:1005:remote-build:/home/gunbc-build:/bin/bash\n"),
        group: est_s(converged_groups()),
        authorized_keys: est_s(forced_line(d)),
        store_root: est_absent(), store_staging: est_absent(), store_root_mode: store_mode_absent(), store_staging_mode: store_mode_absent(), serve_binary: est_absent(),
        checkout: est_absent(), toolchain: est_ok(),
        serve_binary_sha256: est_s(pin_sha()), checkout_revision: est_s(pin_rev()),
        target_arch: est_s(pin_arch()), ledger_rows: matched_ledger(d: d),
      )
      let a = serving_assess(d: d, o: o, pin: pin_ok())
      let plan = converge_plan(d: d, a: a, pin: pin_ok(), target_arch: est_s(pin_arch()))
      plan_is_refused(plan) && length(plan_writes(plan)) == 0
    }
  }
}

// ── the execute path is typed to the plan arm (review 95922 #2 / review 95928) ───────
// 'A refusal or an unhandled divergence executes nothing' is not a gate the caller remembers: the
// executor takes the ConvergePlan arm's non-empty FreeSemigroup, and the other arms carry no such
// value. This cell is the discriminating half of that claim — the SAME desired state, with ONE
// deviation changed, flips between 'carries write work' (a confirmed-absent store dir) and 'carries
// none' (an unhandled host.arch, a refused elevation leg). A refactor that let an unhandled item ride
// into a plan, or a refusal carry writes, reddens THIS cell while diverged_store_plans_a_matching_write
// stays green: that gap is exactly the defect this control exists to catch.
test fn a_refusal_or_unhandled_divergence_carries_nothing_to_execute() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      let line = forced_line(d)
      let unhandled = converge_plan(
        d: d,
        a: serving_assess(d: d, o: serving_observed_from_reads(
          elevation: est_elevation(),
          passwd: est_s("gunbc-build:x:1005:1005:remote-build:/home/gunbc-build:/bin/bash\n"),
          group: est_s(converged_groups()),
          authorized_keys: est_s(line),
          store_root: est_ok(), store_staging: est_ok(), store_root_mode: store_mode_ok(d: d), store_staging_mode: store_mode_ok(d: d), serve_binary: est_ok(),
          checkout: est_ok(), toolchain: est_ok(),
          serve_binary_sha256: est_s(pin_sha()), checkout_revision: est_s(pin_rev()),
          target_arch: est_s("x86_64"), ledger_rows: matched_ledger(d: d),
        ), pin: pin_ok()),
        pin: pin_ok(), target_arch: est_s("x86_64"))
      let refused = converge_plan(
        d: d,
        a: serving_assess(d: d, o: serving_observed_from_reads(
          elevation: refused_elevation(),
          passwd: est_s("gunbc-build:x:1005:1005:remote-build:/home/gunbc-build:/bin/bash\n"),
          group: est_s(converged_groups()),
          authorized_keys: est_s(line),
          store_root: est_ok(), store_staging: est_ok(), store_root_mode: store_mode_ok(d: d), store_staging_mode: store_mode_ok(d: d), serve_binary: est_ok(),
          checkout: est_ok(), toolchain: est_ok(),
          serve_binary_sha256: est_s(pin_sha()), checkout_revision: est_s(pin_rev()),
          target_arch: est_s(pin_arch()), ledger_rows: matched_ledger(d: d),
        ), pin: pin_ok()),
        pin: pin_ok(), target_arch: est_s(pin_arch()))
      let planned = converge_plan(
        d: d,
        a: serving_assess(d: d, o: serving_observed_from_reads(
          elevation: est_elevation(),
          passwd: est_s("gunbc-build:x:1005:1005:remote-build:/home/gunbc-build:/bin/bash\n"),
          group: est_s(converged_groups()),
          authorized_keys: est_s(line),
          store_root: est_absent(), store_staging: est_ok(), store_root_mode: store_mode_absent(), store_staging_mode: store_mode_ok(d: d), serve_binary: est_ok(),
          checkout: est_ok(), toolchain: est_ok(),
          serve_binary_sha256: est_s(pin_sha()), checkout_revision: est_s(pin_rev()),
          target_arch: est_s(pin_arch()), ledger_rows: matched_ledger(d: d),
        ), pin: pin_ok()),
        pin: pin_ok(), target_arch: est_s(pin_arch()))
      // The two non-plan arms must offer the executor nothing, and the plan arm must offer it
      // something — otherwise the two assertions above are vacuous.
      plan_is_unhandled(unhandled) && length(plan_writes(unhandled)) == 0
        && plan_is_refused(refused) && length(plan_writes(refused)) == 0
        && length(plan_writes(planned)) == 1
    }
  }
}

// ── review 95935: the desired-state modes + shell, observed and planned ────────────

// A host that is correct in EVERY respect (all pins, account, group, keys, ledger, both store dirs
// present at the declared mode) except the ONE fact a caller names. The two control pairs below build
// off this so a reddening can only be the fact under test, never a stray deviation. store-root-mode is
// driven by 'store_root_mode'; the account shell by 'passwd'.
fn fully_matched_store(d: RemoteBuildServingDesired, line: String, store_root_mode: ObservationAttempt<String, ServingLegFailure>) -> ServingObserved {
  serving_observed_from_reads(
    elevation: est_elevation(),
    passwd: est_s("gunbc-build:x:1005:1005:remote-build:/home/gunbc-build:/bin/bash\n"),
    group: est_s(converged_groups()),
    authorized_keys: est_s(line),
    store_root: est_ok(), store_staging: est_ok(), store_root_mode: store_root_mode, store_staging_mode: store_mode_ok(d: d), serve_binary: est_ok(),
    checkout: est_ok(), toolchain: est_ok(),
    serve_binary_sha256: est_s(pin_sha()), checkout_revision: est_s(pin_rev()),
    target_arch: est_s(pin_arch()), ledger_rows: matched_ledger(d: d),
  )
}

fn fully_matched_passwd(d: RemoteBuildServingDesired, line: String, passwd: String) -> ServingObserved {
  serving_observed_from_reads(
    elevation: est_elevation(),
    passwd: est_s(passwd),
    group: est_s(converged_groups()),
    authorized_keys: est_s(line),
    store_root: est_ok(), store_staging: est_ok(), store_root_mode: store_mode_ok(d: d), store_staging_mode: store_mode_ok(d: d), serve_binary: est_ok(),
    checkout: est_ok(), toolchain: est_ok(),
    serve_binary_sha256: est_s(pin_sha()), checkout_revision: est_s(pin_rev()),
    target_arch: est_s(pin_arch()), ledger_rows: matched_ledger(d: d),
  )
}

// Whether the write list contains an EnsureDirectory on PATH carrying exactly MODE. The declared mode is
// asserted HERE (on the planned action) so a per-arm literal that ignored d.store_dir_mode reddens it.
fn has_ensure_directory_mode(ws: List<ConvergeAction>, path: String, mode: String) -> Bool {
  length(filter(ws, a => match a {
    EnsureDirectory { path: p, owner_user: _, owner_group: _, mode: m } => p == path && m == mode
    _ => false
  })) > 0
}

// The login shell the planned useradd (EnsureAccount) would write, or none when no EnsureAccount is planned.
fn account_write_shell(ws: List<ConvergeAction>) -> String? {
  match first_where(ws, keep: a => match a { EnsureAccount { name: _, uid: _, gid: _, primary_group: _, home: _, shell: _, supplementary: _ } => true  _ => false }) {
    Absent => Absent
    Present { value: a } => match a {
      EnsureAccount { name: _, uid: _, gid: _, primary_group: _, home: _, shell: sh, supplementary: _ } => Present { value: sh }
      _ => Absent
    }
  }
}

// GREEN (review 95935): a store directory that EXISTS at the wrong mode is no longer invisible to the
// observe (it used to be a bare 'test -d'). It raises a deviation that routes to EnsureDirectory carrying
// the DECLARED store-dir mode — the same authority the desired state carries, not a per-arm "0755".
test fn store_mode_drift_plans_ensure_directory_at_declared_mode() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      let line = forced_line(d)
      let declared = serving_store_dir_mode_octal(d: d)
      // "0700" parses as an octal mode but differs from the declared 0755: a genuine MODE drift on a present dir.
      let a = serving_assess(d: d, o: fully_matched_store(d: d, line: line, store_root_mode: est_s(text: "0700")), pin: pin_ok())
      let plan = converge_plan(d: d, a: a, pin: pin_ok(), target_arch: est_s(pin_arch()))
      plan_is_refused(plan) == false
        && plan_is_unhandled(plan) == false
        && length(plan_writes(plan)) == 1
        && has_ensure_directory_mode(ws: plan_writes(plan), path: d.store_root, mode: declared)
    }
  }
}

// THE red control: the SAME host with the store dir at the DECLARED mode is settled — it plans NOTHING.
// If the mode check were absent (the old 'test -d' only), the green cell above would go green AND this
// would too; the pair together prove the mode leg, not the presence leg, is what produced the write.
test fn store_mode_matched_plans_no_store_directory() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      let line = forced_line(d)
      let a = serving_assess(d: d, o: fully_matched_store(d: d, line: line, store_root_mode: store_mode_ok(d: d)), pin: pin_ok())
      let plan = converge_plan(d: d, a: a, pin: pin_ok(), target_arch: est_s(pin_arch()))
      plan_is_refused(plan) == false && plan_is_unhandled(plan) == false && length(plan_writes(plan)) == 0
    }
  }
}

// GREEN (review 95935): an EXISTING account (its passwd row came back) whose login shell differs from the
// account model's is UNHANDLED — the plan records it and writes NOTHING, so the wet apply REFUSES rather
// than running usermod on a live account (fail_closed: never mutate a running system's account behind its back).
test fn wrong_shell_on_existing_account_is_unhandled() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      let line = forced_line(d)
      // uid/gid match (1005/1005), only the shell (field 7) is /bin/sh — the ONLY deviation is the shell.
      let a = serving_assess(d: d, o: fully_matched_passwd(d: d, line: line, passwd: "gunbc-build:x:1005:1005:remote-build:/home/gunbc-build:/bin/sh\n"), pin: pin_ok())
      let plan = converge_plan(d: d, a: a, pin: pin_ok(), target_arch: est_s(pin_arch()))
      plan_is_unhandled(plan) && length(plan_writes(plan)) == 0
    }
  }
}

// THE red control: the SAME host with the account's shell at the model's declared path is settled — NOT
// unhandled, and plans nothing. Proves the unhandled verdict above came from the SHELL, not from the row.
test fn declared_shell_on_existing_account_is_settled() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      let line = forced_line(d)
      let a = serving_assess(d: d, o: fully_matched_passwd(d: d, line: line, passwd: "gunbc-build:x:1005:1005:remote-build:/home/gunbc-build:/bin/bash\n"), pin: pin_ok())
      let plan = converge_plan(d: d, a: a, pin: pin_ok(), target_arch: est_s(pin_arch()))
      plan_is_unhandled(plan) == false && length(plan_writes(plan)) == 0
    }
  }
}

// GREEN (review 95935): the plan's useradd carries the login shell FROM THE ACCOUNT MODEL (d.account_shell),
// never a reauthored literal — so a fresh account is created with the model's shell. The write arm's old
// hardcoded "-s /bin/bash" is gone; this is what replaced it, read off the desired state.
test fn planned_useradd_carries_the_model_shell() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      let a = serving_assess(d: d, o: fresh_absent_observed(forced_line(d), d), pin: pin_ok())
      let plan = converge_plan(d: d, a: a, pin: pin_ok(), target_arch: est_s(pin_arch()))
      match account_write_shell(ws: plan_writes(plan)) {
        Absent => false
        Present { value: sh } => sh == d.account_shell
      }
    }
  }
}

// THE red control: the model's shell is a NON-EMPTY concrete path (/bin/bash), and the planned shell EQUALS
// it while the plan is NOT otherwise the wrong-shell refusal — i.e. the shell is genuinely sourced, not the
// empty string an unwired field would yield. A plan that dropped the shell ("" ) or a literal that drifted
// from the model reddens this while the green cell above stays green.
test fn planned_useradd_shell_is_the_model_value_not_empty() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      let a = serving_assess(d: d, o: fresh_absent_observed(forced_line(d), d), pin: pin_ok())
      let plan = converge_plan(d: d, a: a, pin: pin_ok(), target_arch: est_s(pin_arch()))
      d.account_shell != ""
        && match account_write_shell(ws: plan_writes(plan)) {
             Absent => false
             Present { value: sh } => sh == d.account_shell && sh != ""
           }
    }
  }
}

// GREEN + red in one (review 95935): the checkout's VERDICT is the detach, but a failed fetch that blocks
// the detach NAMES THE FETCH as the cause; a failed detach with a good fetch names the detach; and a good
// detach is settled no matter what the fetch did. The clone result is irrelevant to all four.
test fn checkout_cause_names_the_fetch_only_when_it_blocked_the_detach() -> Bool {
  let fetch_named = string_contains(s: converge_checkout_cause(fetch_ok: false, detach_ok: false), pattern: "fetch")
  let detach_named = string_contains(s: converge_checkout_cause(fetch_ok: true, detach_ok: false), pattern: "detach")
    && string_contains(s: converge_checkout_cause(fetch_ok: true, detach_ok: false), pattern: "fetch") == false
  // The detach is the verdict: a good detach settles even when the fetch failed.
  let detach_is_verdict = converge_checkout_cause(fetch_ok: false, detach_ok: true) == ""
    && converge_checkout_cause(fetch_ok: true, detach_ok: true) == ""
  fetch_named && detach_named && detach_is_verdict
}
