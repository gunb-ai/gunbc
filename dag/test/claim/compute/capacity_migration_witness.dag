module test.claim.compute.capacity_migration_witness

import std.types { Bool, String, NonEmptyStr, CommitSha, List }
import std.error_primitives { Result, Ok, Err }
import std.decl_ref { decl_ref }
import std.measure { kibibyte }
import product.capacity.event_chain { PartitionId }
import extdeps.systemd.manager { SystemManager, UserManager }
import gunbc.compute.capacity_migration {
  CapacityManagedUnit, CapacityTransientFamily, CapacityFamilyParents, CapacityActivationFamily, capacity_migration_enumerate_family, CapacityMigrationChild, CapacityConfirmedWriter, CapacityConfirmedNonWriter, CapacityUnclassified, capacity_migration_family_parent_requirements,
  CapacityMigrationPopulation, CapacityUnitDrain, CapacityMigrationAdmission, capacity_migration_admit,
}
import gunbc.compute.host_capacity { ComputeCapacityStanding, ComputeCapacityStandingRead }
import gunbc.compute.recorded_cgroup_drain { RecordedPathEmpty, RecordedPathPopulated }
import gunbc.deploy_transition_bootstrap {
  observe_unit_quiescence, UnitObservedInactive, ActivationObservedRefused, MaskRuntimeOnlyObserved,
}

fn migration_fixture_unit(name: NonEmptyStr) -> CapacityManagedUnit {
  CapacityManagedUnit { manager: SystemManager, unit: name }
}

fn migration_fixture_population(placement_known: Bool) -> CapacityMigrationPopulation {
  let activator = migration_fixture_unit(name: "fixture.path")
  CapacityMigrationPopulation {
    source: decl_ref(module_path: "test.claim.compute.capacity_migration_witness", decl_name: "migration_fixture_population"),
    installed: [activator], writer_parents: [],
    transients: [CapacityTransientFamily {
      standing: CapacityConfirmedWriter,
      manager: SystemManager,
      source: decl_ref(module_path: "test.claim.compute.capacity_migration_witness", decl_name: "migration_fixture_unit"),
      patterns: ["fixture-*.service"], exclude_patterns: [], activators: [activator],
      placement: CapacityFamilyParents { parents: if placement_known { Ok { value: [migration_fixture_unit(name: "fixture.slice")] } }
        else { Err { value: "self-wrap destination unobserved" } } },
    }],
    children: [CapacityMigrationChild { root: "/fixture", partition: "child" as PartitionId }],
  }
}

fn migration_fixture_drain(name: NonEmptyStr, populated: Bool) -> CapacityUnitDrain {
  CapacityUnitDrain {
    subject: migration_fixture_unit(name: name),
    quiescence: observe_unit_quiescence(unit: name,
      inactive: UnitObservedInactive { unit: name },
      activation: ActivationObservedRefused { unit: name, detail: "masked" },
      persistence: MaskRuntimeOnlyObserved { unit: name, path: "/run/systemd/system" }),
    descendants: if populated { RecordedPathPopulated } else { RecordedPathEmpty },
  }
}

fn migration_fixture_empty() -> ComputeCapacityStanding {
  ComputeCapacityStandingRead {
    committed: kibibyte(count: 0), ceiling: kibibyte(count: 1), headroom: kibibyte(count: 1),
    observed_available: kibibyte(count: 1), observed_total: kibibyte(count: 1),
  }
}

fn migration_fixture_admits(observed: List<CapacityUnitDrain>, placement_known: Bool, listing_known: Bool) -> Bool {
  match capacity_migration_admit(population: migration_fixture_population(placement_known: placement_known),
    target_revision: "0123456789012345678901234567890123456789" as CommitSha,
    observed: observed,
    enumerate: family => if listing_known { Ok { value: [] } } else { Err { value: "manager unavailable" } },
    read_child: child => migration_fixture_empty()) {
    Ok { value: _ } => true
    Err { value: _ } => false
  }
}

test fn empty_ledgers_do_not_replace_inhibition_or_descendant_drain() -> Bool {
  let good = [migration_fixture_drain(name: "fixture.path", populated: false), migration_fixture_drain(name: "fixture.slice", populated: false)]
  migration_fixture_admits(observed: good, placement_known: true, listing_known: true)
    && !migration_fixture_admits(observed: [], placement_known: true, listing_known: true)
    && !migration_fixture_admits(observed: [migration_fixture_drain(name: "fixture.path", populated: false), migration_fixture_drain(name: "fixture.slice", populated: true)], placement_known: true, listing_known: true)
    && !migration_fixture_admits(observed: good, placement_known: false, listing_known: true)
    && !migration_fixture_admits(observed: good, placement_known: true, listing_known: false)
}

test fn a_different_manager_cannot_supply_the_unit_drain() -> Bool {
  let original = migration_fixture_drain(name: "fixture.path", populated: false)
  let wrong = CapacityUnitDrain {
    subject: CapacityManagedUnit { manager: UserManager { uid: 1000 }, unit: original.subject.unit },
    quiescence: original.quiescence, descendants: original.descendants,
  }
  !migration_fixture_admits(observed: [wrong, migration_fixture_drain(name: "fixture.slice", populated: false)], placement_known: true, listing_known: true)
}

// New sound negative evidence can shrink the drain without changing activation.
// The same unknown placement must remain visible while the root is unclassified.
test fn only_confirmed_nonwriters_leave_the_family_parent_requirements() -> Bool {
  let base = migration_fixture_population(placement_known: true)
  let source = base.source
  let family = CapacityTransientFamily {
    manager: SystemManager, source: source, patterns: ["fixture-*.service"], exclude_patterns: [], activators: base.installed,
    standing: CapacityConfirmedNonWriter, placement: CapacityFamilyParents { parents: Err { value: "unobserved parent" } },
  }
  let unknown = CapacityTransientFamily {
    manager: family.manager, source: source, patterns: family.patterns, exclude_patterns: family.exclude_patterns, activators: family.activators,
    standing: CapacityUnclassified { detail: "service-call reach not covered" }, placement: family.placement,
  }
  count(capacity_migration_family_parent_requirements(families: [family])) == 0
    && count(capacity_migration_family_parent_requirements(families: [unknown])) == 1
}

// Unclassified is a drain obligation, not an activation refusal of its own.
test fn an_unclassified_family_can_admit_only_after_its_known_parent_is_drained() -> Bool {
  let base = migration_fixture_population(placement_known: true)
  let population = CapacityMigrationPopulation {
    source: base.source, installed: base.installed, writer_parents: base.writer_parents,
    transients: map(base.transients, family => CapacityTransientFamily {
      manager: family.manager, source: family.source, patterns: family.patterns, exclude_patterns: family.exclude_patterns, activators: family.activators,
      placement: family.placement, standing: CapacityUnclassified { detail: "service edge unresolved" },
    }), children: base.children,
  }
  match capacity_migration_admit(population: population,
    target_revision: "0123456789012345678901234567890123456789" as CommitSha,
    observed: [migration_fixture_drain(name: "fixture.path", populated: false), migration_fixture_drain(name: "fixture.slice", populated: false)],
    enumerate: family => Ok { value: [] }, read_child: child => migration_fixture_empty()) {
    Err { value: _ } => false
    Ok { value: _ } => match capacity_migration_admit(population: population,
      target_revision: "0123456789012345678901234567890123456789" as CommitSha,
      observed: [migration_fixture_drain(name: "fixture.path", populated: false)],
      enumerate: family => Ok { value: [] }, read_child: child => migration_fixture_empty()) {
      Err { value: _ } => true
      Ok { value: _ } => false
    }
  }
}

// Exclusion failure or cross-manager data must never erase a live population.
test fn exclusion_read_failures_refuse_instead_of_becoming_empty() -> Bool {
  let base = migration_fixture_population(placement_known: true)
  let family = CapacityTransientFamily {
    manager: SystemManager, source: base.source, standing: CapacityConfirmedWriter,
    patterns: ["fixture-*.service"], exclude_patterns: ["fixture-*-handin.service"],
    activators: base.installed,
    placement: CapacityFamilyParents { parents: Ok { value: [migration_fixture_unit(name: "fixture.slice")] } },
  }
  let unread = capacity_migration_enumerate_family(family: family, read_matches: (manager, patterns) =>
    if patterns == family.patterns { Ok { value: [migration_fixture_unit(name: "fixture-worker.service")] } }
    else { Err { value: "exclusion listing unavailable" } })
  let wrong = capacity_migration_enumerate_family(family: family, read_matches: (manager, patterns) =>
    Ok { value: [CapacityManagedUnit { manager: UserManager { uid: 1000 }, unit: "fixture-worker.service" }] })
  match unread { Err { value: _ } => true Ok { value: _ } => false }
    && match wrong { Err { value: _ } => true Ok { value: _ } => false }
}

// Activation-only removes a parent requirement, never the family drain or its
// destination's inhibition. A missing destination makes this admission refuse.
test fn an_activation_family_requires_its_destination_in_the_installed_drain() -> Bool {
  let base = migration_fixture_population(placement_known: true)
  let population = CapacityMigrationPopulation {
    source: base.source, installed: base.installed, writer_parents: [], children: base.children,
    transients: [CapacityTransientFamily {
      manager: SystemManager, source: base.source, standing: CapacityUnclassified { detail: "activation edge" },
      patterns: ["fixture-handin.*"], exclude_patterns: [], activators: base.installed,
      placement: CapacityActivationFamily { targets: [migration_fixture_unit(name: "missing.service")] },
    }],
  }
  let bound = CapacityMigrationPopulation {
    source: population.source, installed: population.installed, writer_parents: [], children: population.children,
    transients: map(population.transients, family => CapacityTransientFamily {
      manager: family.manager, source: family.source, standing: family.standing,
      patterns: family.patterns, exclude_patterns: family.exclude_patterns, activators: family.activators,
      placement: CapacityActivationFamily { targets: base.installed },
    }),
  }
  let admitted = capacity_migration_admit(population: bound,
    target_revision: "0123456789012345678901234567890123456789" as CommitSha,
    observed: [migration_fixture_drain(name: "fixture.path", populated: false)],
    enumerate: family => Ok { value: [] }, read_child: child => migration_fixture_empty())
  let live = capacity_migration_admit(population: bound,
    target_revision: "0123456789012345678901234567890123456789" as CommitSha,
    observed: [migration_fixture_drain(name: "fixture.path", populated: false)],
    enumerate: family => Ok { value: [migration_fixture_unit(name: "fixture-handin.service")] }, read_child: child => migration_fixture_empty())
  (match admitted { Ok { value: _ } => true Err { value: _ } => false })
    && (match live { Err { value: _ } => true Ok { value: _ } => false })
    && match capacity_migration_admit(population: population,
    target_revision: "0123456789012345678901234567890123456789" as CommitSha,
    observed: [migration_fixture_drain(name: "fixture.path", populated: false)],
    enumerate: family => Ok { value: [] }, read_child: child => migration_fixture_empty()) {
    Err { value: _ } => true
    Ok { value: _ } => false
  }
}
