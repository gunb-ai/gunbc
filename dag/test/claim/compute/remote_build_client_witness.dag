// HERMETIC CONTROLS for the requesting side of gunbc.compute.remote_build. The wet control -- the
// session's key, srv1, a real compile answered through the serving entry -- is the live run recorded
// with the change that added this module; these pin the parts that decide what is published and to
// whom.

data w_commit_hex: String = "0123456789abcdef0123456789abcdef01234567"

fn w_commit() -> GitObjectId {
  match git_object_id_from_untagged_hex(hex: w_commit_hex) {
    Present { value: c } => c
    Absent => match git_object_id_from_untagged_hex(hex: "ffffffffffffffffffffffffffffffffffffffff") { Present { value: c } => c  Absent => w_commit() }
  }
}

fn w_source() -> RemoteBuildSourceRef? {
  remote_build_client_source_ref(commit: w_commit(), clock: ClockUnixMillisObserved { millis: 1763200000123 })
}

// The hidden ref is one level under refs/remote-build/, named by the commit and the clock reading,
// and an unreadable clock forms no ref rather than a fixed one two requests would share.
test fn the_source_ref_is_the_commit_and_the_clock() -> Bool {
  match w_source() {
    Present { value: r } => remote_build_source_ref_name(r: r) as String == concat("refs/remote-build/", concat(w_commit_hex, ".1763200000123"))
    Absent => false
  }
    && match remote_build_client_source_ref(commit: w_commit(), clock: ClockUnixMillisRefused { detail: "no clock" }) { Absent => true  Present { value: _ } => false }
}

// Both pushes name the repository the serving side fetches by its clone URL, never a remote name;
// the publication maps the commit onto the ref, and the deletion pushes nothing onto it.
test fn the_push_and_the_deletion_name_the_served_repository() -> Bool {
  match w_source() {
    Absent => false
    Present { value: r } => {
      let name = remote_build_source_ref_name(r: r) as String
      remote_build_client_push_argv(commit: w_commit(), source: r) == ["push", "--quiet", "https://github.com/gunb-ai/gunbc.git", join([w_commit_hex, ":", name], "")]
        && remote_build_client_delete_argv(source: r) == ["push", "--quiet", "https://github.com/gunb-ai/gunbc.git", concat(":", name)]
    }
  }
}

// srv1 is reached as the remote-build account, at the address its host key is anchored at; a host
// with no anchored row refuses rather than dialing a name the network resolves.
test fn a_roster_host_is_reached_as_the_build_account_at_its_anchored_address() -> Bool {
  match remote_build_client_target(host: "srv1" as HostIdentity) {
    SshTargetResolved { target } =>
      target.principal as String == "gunbc-build"
        && match anchored_host_key_row(host: "srv1" as HostIdentity) { Present { value: row } => ssh_target_wire(target: target) as String == known_hosts_host_field(address: row.address) as String  Absent => false }
    SshTargetRefused { endpoint: _, refusal: _ } => false
  }
    && match remote_build_client_target(host: "no-such-host" as HostIdentity) { SshTargetRefused { endpoint: _, refusal: _ } => true  SshTargetResolved { target: _ } => false }
}

fn w_run(results: List<RemoteBuildRequestResult>) -> RemoteBuildRun {
  RemoteBuildRan { commit: w_commit_hex, source_ref: "refs/remote-build/x", results: results, cleanup: RemoteBuildRefDeleted }
}

// A run is served only when every request was answered served; a work failure, a full roster or a
// run that sent nothing is not.
test fn a_run_is_served_only_when_every_request_was_served() -> Bool {
  let op = RemoteCompileEntry { entry: "dag/x.dag" as FilePath }
  let served = RemoteBuildRequestResult { operation: op, step: RemoteBuildAnswered { host: "srv1" as HostIdentity, answer: HostServed { receipt: "{}" } } }
  let failed = RemoteBuildRequestResult { operation: op, step: RemoteBuildAnswered { host: "srv1" as HostIdentity, answer: HostWorkFailed { receipt: "{}" } } }
  let full = RemoteBuildRequestResult { operation: op, step: RemoteBuildNoHostAvailable { attempts: [RemoteBuildAttempt { host: "srv1" as HostIdentity, answer: HostCapacityFull { detail: "full" } }] } }
  remote_build_run_served(r: w_run(results: [served, served]))
    && !remote_build_run_served(r: w_run(results: [served, failed]))
    && !remote_build_run_served(r: w_run(results: [full]))
    && !remote_build_run_served(r: w_run(results: []))
    && !remote_build_run_served(r: RemoteBuildNotSent { step: "push", detail: "refused" })
}

// A selected module that could not be sent counts against the run, as the local route counts an
// unreadable module (gunbc.compute.test_run::module_run_succeeded => false): a pattern selecting one
// module that ran served and one the snapshot could not read is NOT clean, while a module the floor
// wholly declined or that is not a witness is reported and does not fail the run. The red half is
// the mixed case that used to exit 0 with the unreadable module only in a note.
test fn a_selected_module_that_could_not_be_sent_fails_the_run() -> Bool {
  let op = RemoteCompileEntry { entry: "dag/x.dag" as FilePath }
  let served = RemoteBuildRequestResult { operation: op, step: RemoteBuildAnswered { host: "srv1" as HostIdentity, answer: HostServed { receipt: "{}" } } }
  let unreadable = RemoteSelectionFailed { note: remote_not_sent_json(label: "//dag/y", reason: "git show could not read the file from the snapshot") }
  let declined = RemoteSelectionDeclined { note: remote_not_sent_json(label: "//dag/z", reason: "not a witness") }
  let sent = RemoteSelectionSent { operation: op }
  let selections = [sent, unreadable, declined]
  let failed = flat_map(selections, remote_selection_failed)
  count(flat_map(selections, remote_selection_operation)) == 1
    && count(flat_map(selections, remote_selection_declined)) == 1
    && count(failed) == 1
    && remote_build_run_served(r: w_run(results: [served]))
    && !remote_build_run_clean(run: w_run(results: [served]), failed: failed)
    && remote_build_run_clean(run: w_run(results: [served]), failed: flat_map([sent, declined], remote_selection_failed))
}

// THE CLIENT'S OWN JOB ROOT, decided over supplied readback facts (the effect lives in
// remote_build_client_job_root_decision's caller, materialize_remote_build_client_job_root). A directory the
// running principal owns is ready; a non-directory, a foreign owner, or an unreadable principal refuses with
// its own cause, so a fresh worktree or hosted runner whose root cannot be ensured stops AT the job-root step
// rather than later at the multiplex step with a misleading cause. Mode is deliberately NOT consulted: the job
// root is cargo's own target directory, created 0755 under the normal umask and left there on adopt -- the 700
// rule belongs to the sun_path multiplex child, not this parent (gunbc.design_argument::epistemic_humility).
fn w_job_root_ready(r: RemoteBuildClientJobRoot) -> Bool {
  match r { JobRootReady { path: _ } => true  JobRootRefused { cause: _ } => false }
}

// GREEN, and the regression the mode gate once was: an EXISTING checkout's job root -- cargo's target dir,
// adopted unchanged at whatever mode umask gave it (0755), owned by the running principal -- is admitted,
// because ownership is the only variable the parent's contract supports.
test fn an_owner_owned_job_root_is_adopted() -> Bool {
  w_job_root_ready(r: remote_build_client_job_root_decision(path: "target", is_dir: true, owner: "gunbc-build", principal: Present { value: "gunbc-build" }))
}

// RED, the case the wildcard once let through: a path that is not a directory -- a regular file where the
// root should be -- refuses AT the job-root step, because a file is never a root. This is the "root path
// that is a regular file must refuse at the job-root step" control.
test fn red_a_regular_file_at_the_job_root_refuses() -> Bool {
  !w_job_root_ready(r: remote_build_client_job_root_decision(path: "target", is_dir: false, owner: "gunbc-build", principal: Present { value: "gunbc-build" }))
}

test fn red_a_foreign_job_root_owner_refuses() -> Bool {
  !w_job_root_ready(r: remote_build_client_job_root_decision(path: "target", is_dir: true, owner: "mallory", principal: Present { value: "gunbc-build" }))
}

// A principal that cannot be read is not "ours" by default -- the read fails closed, it does not pass the
// run through unverified (gunbc.design_argument::fail_closed).
test fn red_a_job_root_of_unreadable_principal_refuses() -> Bool {
  !w_job_root_ready(r: remote_build_client_job_root_decision(path: "target", is_dir: true, owner: "gunbc-build", principal: Absent))
}

// INHABITANCE (gunbc.design_argument::witness_one_interface, fail_closed: a real consumer green by
// execution). The two sides the decision compares come from two REAL producers -- shell.Stat.OwnerOf
// (`stat -c %U`, a user NAME) and shell.Id.UserName (`id -un`, that user's NAME). The hermetic controls above
// supply matching strings, so they cannot catch the producers drifting into DIFFERENT shapes -- the defect
// this claim exists to catch is `%U` compared against `id -u` (a numeric uid), which refuses every directory
// the user owns because the two producers emit different representations. Running the real route over the
// directory the client runs in -- a real directory owned by the running principal -- shows the producers
// emit the one comparable representation the decision relies on.
test fn the_real_readback_admits_a_directory_the_principal_owns() -> Bool {
  w_job_root_ready(r: materialize_remote_build_client_job_root(root: "."))
}

// AN OVERRAN LEG IS A CAPACITY FACT, NEVER A VERDICT ON THE CODE. The ceiling travels as std.measure's
// Second and is projected to text only where a human reads it (review 96999); the walk moves on to the
// next candidate because a probe that overran sent nothing (review 96994); and the CI routing class is
// the one an unreachable host gets -- never the code-verdict class, which would mark a commit failed
// over wall clock.
test fn an_overran_leg_carries_its_ceiling_and_never_judges_the_code() -> Bool {
  let overran = HostLegOverran { deadline: second(count: 15) }
  let step = RemoteBuildAnswered { host: "srv1" as HostIdentity, answer: overran }
  remote_build_answer_word(a: overran) == "probe-leg-overran-at-15s"
    && string_contains(s: remote_build_answer_text(a: overran), pattern: "15s wall-clock deadline")
    && remote_build_answer_moves_on(a: overran)
    && match remote_gate_step_outcome(s: step) { GateNoHostAdmitted => true  _ => false }
    && !match remote_gate_step_outcome(s: step) { GateVerdictOnCode => true  _ => false }
}

// THE HOST PIN -- the operator's/runner's choice to send ONE request to ONE named host. These pin
// the pure decision (gunbc.compute.remote_build.remote_build_host_pin / _pinned_candidates /
// _pin_refusal) that remote_build_run applies before any effect; the drive then walks exactly what
// it returns, so the route is settled here without a live socket.

// THE ROUTE, asserted. The pinned host is read FROM the DISPATCH roster (its last entry), never
// transcribed (§fail_closed). Pinning it must narrow the walk to EXACTLY that one host -- not the
// whole roster -- so the claim is discriminating (a widening bug leaves the full roster) and a roster
// edit changes the SUBJECT of the check, not a hard-coded expectation.
test fn a_rostered_pin_walks_exactly_that_one_host() -> Bool {
  // THE ROUTE, asserted with NOTHING transcribed from the tree (DESIGN §fail_closed: "a count copied
  // from the current tree is a change detector"). The pinned host is read FROM the DISPATCH roster --
  // its last entry -- so a roster edit changes the subject, not the expectation. Pinning it must walk
  // EXACTLY that one host: a widening bug would leave the whole roster here, so this is discriminating.
  let roster = remote_build_serving_hosts()
  count(roster) > 0
    && match roster |> skip(n: count(roster) - 1) |> first {
         Absent => false
         Present { value: target } => match remote_build_host_pin(text: target as String) {
           Absent => false
           Present { value: carrier } => match carrier {
             PinRostered { host } =>
               host == target
                 && remote_build_pinned_candidates(pin: Present { value: carrier }) |> map(c => c.host as String) == [target as String]
             PinOffRoster { pin: _, roster: _ } => false
           }
         }
       }
}

// NO PIN is the ordinary roster walk, UNCHANGED: the whole roster in order, identical to the
// unpinned candidates the existing selection claims already rely on, and in DISPATCH-roster order.
// Green here means the pin did not disturb the path every request without a --arg host= still takes.
// The expected order is read FROM remote_build_serving_hosts (the roster is the authority for both
// membership and order), never transcribed as a literal -- a roster change stays a roster fact, not
// a witness edit.
test fn no_pin_walks_the_whole_roster_in_order() -> Bool {
  let walked = remote_build_pinned_candidates(pin: none) |> map(c => c.host as String)
  let roster = remote_build_serving_hosts() |> map(h => h as String)
  walked == roster && count(walked) == count(roster)
}

// THE RED CONTROL. The refused host is derived as the SET DIFFERENCE of the serving CANDIDATE row
// (remote_build_serving_candidate_hosts) minus the DISPATCH roster (remote_build_serving_hosts) -- a
// host that may hold a checkout but the dispatch gate does not admit -- so no name is transcribed
// (§fail_closed). Pinning it must REFUSE, the refusal must name BOTH the refused pin AND every roster
// host checked (mapped from the roster), and the walk must contact NOTHING: a candidate-only host is
// never a silent fall-through to the admitted roster.
test fn a_candidate_only_pin_refuses_naming_the_pin_and_the_roster() -> Bool {
  // THE RED CONTROL -- no host name transcribed (§fail_closed forbids comparing live population to a
  // copied literal). The candidate-only host is the SET DIFFERENCE of the candidate row minus the
  // DISPATCH roster (a host that may hold a checkout but the dispatch gate does not admit). Pinning it
  // must refuse, walk NOTHING (never fall through to the whole roster), and the refusal must name BOTH
  // the refused pin AND every roster host checked -- names mapped FROM the roster, never spelled.
  let roster = remote_build_serving_hosts() |> map(h => h as String)
  let candidate_only = remote_build_serving_candidate_hosts()
    |> map(h => h as String)
    |> filter(h => !any(roster, r => r == h))
  match candidate_only |> first {
    Absent => false
    Present { value: off } => match remote_build_host_pin(text: off) {
      Absent => false
      Present { value: carrier } => match carrier {
        PinRostered { host: _ } => false
        PinOffRoster { pin: p, roster: r } =>
          p == off
            && count(remote_build_pinned_candidates(pin: Present { value: carrier })) == 0
            && contains(haystack: remote_build_pin_refusal(pin: p, roster: r), needle: off)
            && all(roster, h => contains(haystack: remote_build_pin_refusal(pin: p, roster: r), needle: h))
      }
    }
  }
}

// CLOSURE. A name on NEITHER roster -- a typo, a host that does not exist -- is refused the same way
// and its pinned walk is empty, so a pin is a closed decision on the DISPATCH roster alone rather
// than a lookup that could widen to some other host source.
test fn an_unrostered_host_pin_is_refused_and_walks_nothing() -> Bool {
  let pin = remote_build_host_pin(text: "srv-not-a-rostered-host")
  match pin {
    Absent => false
    Present { value: carrier } => match carrier {
      PinRostered { host: _ } => false
      PinOffRoster { pin: p, roster: _ } =>
        p == "srv-not-a-rostered-host" && count(remote_build_pinned_candidates(pin: pin)) == 0
    }
  }
}

// The snapshot commit carries its identity IN THE ARGV, not from the box. A runner with no git config
// at all (GitHub-hosted runner, run 45003889136: 'empty ident name (for <runner@...>) not allowed')
// dies in the snapshot before a byte is sent, and ambient config is also forgeable input on shared
// boxes. The `-c user.name=` / `-c user.email=` pair rides the commit-tree invocation itself, before
// the subcommand; this pins the shape AND the modeled values.
test fn the_snapshot_commit_argv_carries_its_identity_not_the_box_s() -> Bool {
  snapshot_commit_tree_args(tree: "TREE", message: "msg") ==
    [
      "-c", join(["user.name=", compute_snapshot_author_name], ""),
      "-c", join(["user.email=", compute_snapshot_author_email], ""),
      "commit-tree", "TREE", "-p", "HEAD", "-m", "msg",
    ]
  && compute_snapshot_author_email == "snapshot@compute.gunbc.invalid"
}

// ── THE DISPATCH LEG'S WALL-CLOCK CEILING ───────────────────────────────────────────────────────────
//
// THE CLASS THIS IS FOR, REPRODUCED 2026-11-25 (quiet-pike-440, three runs: 46 m, 1 h, 3 h of silence,
// no receipt, no HostComputeCapacityFull). The client resolved its closure and then sat inside
// ssh.Session.ExecPortableWords. That leg carries no ceiling at the deployed client pin: ConnectTimeout
// bounds only the TCP connect and ServerAliveInterval x ServerAliveCountMax (60 s) bounds only a path that
// goes DARK, and sshd answers keepalives itself -- so a remote command that is merely SILENT is never cut,
// and there is no ssh keyword for a session's total wall time. The ceiling is armed by the runtime, at the
// transport's declaration, from the ceiling the CALLER passes; a wait with no deadline is the defect, not a
// configuration choice. These claims hold that the remote-build route PASSES one, that it is sized by this
// route's own read rather than by a fleet-converge leg's, and that overrunning it refuses typed.
//
// Every claim here is hermetic: the ceiling authority, the wire decode and the answer routing are all pure
// readings, so no claim goes red because a host is down, and none can pass because a host happened to answer.

// A leg of THIS route, at the route's own kind, with the fleet authority's ceiling read back off it.
fn w_route_leg(kind: FleetLegKind) -> FleetRemoteLeg? {
  match remote_build_client_target(host: "srv1" as HostIdentity) {
    SshTargetResolved { target } =>
      match portable_remote_words(raws: ["true"]) {
        Present { value: w } => Present { value: FleetBareWordLeg { target: target, words: w, kind: kind } }
        Absent => Absent
      }
    SshTargetRefused { endpoint: _, refusal: _ } => Absent
  }
}

// THE DISPATCH LEG CARRIES A WALL-CLOCK DEADLINE, and the ceiling it carries is the one the authority
// gives its declared kind -- not a caller's guess, and never Absent. The work leg's ceiling sits above the
// probe's because its far side builds the pushed revision before it answers.
test fn a_remote_build_dispatch_leg_arms_a_ceiling_at_the_one_authority() -> Bool {
  let probe_ceiling = fleet_leg_wall_deadline(kind: remote_build_probe_leg_kind())
  let work_ceiling = fleet_leg_wall_deadline(kind: remote_build_work_leg_kind())
  second_count(s: probe_ceiling) > 0
    && match w_route_leg(kind: remote_build_work_leg_kind()) {
      Absent => false
      Present { value: leg } => match fleet_remote_leg_wall_deadline(leg: leg) {
        Absent => false
        Present { value: armed } =>
          second_count(s: armed) == second_count(s: work_ceiling)
            && second_count(s: work_ceiling) > second_count(s: probe_ceiling)
      }
    }
}

// RED CONTROL -- THE PROBE IS NOT SIZED BY A FLEET-CONVERGE PROBE. ProbeLeg's ceiling comes from a 0.26 s
// `git rev-parse HEAD` read; the far side of a remote-build probe cannot answer at all until the serving
// interpreter has resolved its own closure, read at 240 s wall on srv1 (resolve_entry_graph_inclusive
// ms=248554, 895 modules, max_rss 3.7 GiB) -- the same 4 minutes the client log watched with no ceiling
// armed. So the measured cold answer must sit AT OR UNDER this route's probe ceiling and STRICTLY ABOVE
// ProbeLeg's: re-pointing the route at ProbeLeg turns every roster host into probe-leg-overran, which is
// fail-closed and serves nothing, and this claim goes red the moment that re-point happens.
test fn red_the_remote_build_probe_leg_is_not_sized_by_a_fleet_converge_probe() -> Bool {
  let cold_read = second_count(s: serving_probe_cold_answer_read)
  let route_ceiling = second_count(s: fleet_leg_wall_deadline(kind: remote_build_probe_leg_kind()))
  let fleet_probe_ceiling = second_count(s: fleet_leg_wall_deadline(kind: ProbeLeg))
  fleet_probe_ceiling < cold_read && cold_read <= route_ceiling
}

// RED CONTROL -- A CEILING THAT IS ZERO, OR THAT RUNS THE WHOLE RECEIPT, IS NOT A DEADLINE. The outer
// bound is the receipt's own step bound (the incident's backstop), so a leg allowed to use all of it
// re-creates the no-receipt failure inside a number. Both ceilings are DERIVED (from the cold read and
// from that bound), so the relations -- not the numbers -- are what hold: non-zero, clearing the measured
// read, and strictly inside the bound.
test fn red_no_remote_build_leg_is_allowed_to_run_the_whole_receipt() -> Bool {
  let bound = fleet_whole_receipt_step_bound
  let probe = fleet_leg_wall_deadline(kind: remote_build_probe_leg_kind())
  let work = fleet_leg_wall_deadline(kind: remote_build_work_leg_kind())
  second_count(s: probe) > 0 && second_count(s: work) > 0
    && measure_le(a: probe, b: bound) && measure_le(a: work, b: bound)
    && measure_le(a: serving_probe_cold_answer_read, b: probe)
    && !measure_le(a: work, b: probe)
}

// AN OVERRUN IS A VALUE THAT CARRIES THE CEILING IT TRIPPED ON. The sink sets overran ONLY when its own
// kill fired, so the decode -- one site, extdeps.ssh.session ssh_session_exec_outcome -- turns the wire
// into SessionOverran{deadline}, and the route answers with a capacity fact that moves the walk on: a
// probe sends no work, so the next candidate is still safe to try.
test fn an_overran_probe_leg_decodes_to_its_ceiling_and_moves_the_walk_on() -> Bool {
  let ceiling = fleet_leg_wall_deadline(kind: remote_build_probe_leg_kind())
  let outcome = ssh_session_exec_outcome(
    result: ssh_session_exec_result_from_service(
      exit_code: 255, success: false, stdout: "", stderr: "",
      overran: true, wall_deadline_seconds: Present { value: ceiling },
    ),
  )
  match outcome {
    SessionOverran { deadline: d } =>
      second_count(s: d) == second_count(s: ceiling)
        && remote_build_answer_moves_on(a: HostLegOverran { deadline: d })
        && string_contains(
          s: remote_build_answer_text(a: HostLegOverran { deadline: d }),
          pattern: join([nat_to_decimal_string(value: second_count(s: d)), "s wall-clock deadline"], ""),
        )
    SessionCompleted { exit_code: _, success: _, stdout: _, stderr: _ } => false
    SessionWireInconsistent { fault: _ } => false
  }
}

// RED CONTROL -- AN OVERRUN THAT ECHOES NO CEILING IS REFUSED, NEVER COMPLETED. A sink that killed the
// group but lost the deadline would otherwise hand the consumer an overrun it cannot report, and the
// route's older shape turned a killed leg into "the host answered 255" (review 96994). There is no arm
// here that reads an exit code out of a killed leg.
test fn red_an_overrun_that_echoes_no_ceiling_is_never_routed_as_an_answer() -> Bool {
  let outcome = ssh_session_exec_outcome(
    result: ssh_session_exec_result_from_service(
      exit_code: 255, success: false, stdout: "", stderr: "",
      overran: true, wall_deadline_seconds: Absent,
    ),
  )
  match outcome {
    SessionWireInconsistent { fault: _ } => true
    SessionCompleted { exit_code: _, success: _, stdout: _, stderr: _ } => false
    SessionOverran { deadline: _ } => false
  }
}

// RED CONTROL -- AN OVERRUN ON THE WORK LEG REFUSES TYPED AND STOPS THE WALK. Unlike the probe, this leg
// SENT work: a second host would be a second producer of one identity, so the refusal is final, names the
// ceiling the authority armed, and is never routed as a verdict on the code (a commit is not failed over a
// wall clock).
test fn red_an_overran_work_leg_refuses_typed_and_stops_the_walk() -> Bool {
  let ceiling = fleet_leg_wall_deadline(kind: remote_build_work_leg_kind())
  let answer = HostOutcomeUnknown { detail: remote_build_work_leg_overrun_detail(deadline: ceiling) }
  let step = RemoteBuildAnswered { host: "srv3" as HostIdentity, answer: answer }
  remote_build_answer_word(a: answer) == "outcome-unknown"
    && !remote_build_answer_moves_on(a: answer)
    && string_contains(
      s: remote_build_answer_text(a: answer),
      pattern: join([nat_to_decimal_string(value: second_count(s: ceiling)), "s wall-clock deadline"], ""),
    )
    && string_contains(s: remote_build_answer_text(a: answer), pattern: "walk stops")
    && !match remote_gate_step_outcome(s: step) { GateVerdictOnCode => true  _ => false }
}
