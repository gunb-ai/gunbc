  remote_build_answer_word, remote_build_answer_text, remote_gate_step_outcome,
  GateNoHostAdmitted, GateVerdictOnCode,
  remote_build_client_source_ref, remote_build_client_push_argv, remote_build_client_delete_argv,
  remote_build_client_target, remote_build_step_served, remote_build_run_served, remote_build_run_clean,
  RemoteBuildRun, RemoteBuildRan, RemoteBuildNotSent, RemoteBuildRequestResult, RemoteBuildRefDeleted,
  RemoteSelectionSent, RemoteSelectionDeclined, RemoteSelectionFailed,
  remote_selection_operation, remote_selection_declined, remote_selection_failed, remote_not_sent_json,
  RemoteBuildClientJobRoot, JobRootReady, JobRootRefused, remote_build_client_job_root_decision,
