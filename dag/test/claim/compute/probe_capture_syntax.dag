module test.claim.compute.probe_capture_syntax

import std.types { Bool, Int, String, List }

// THROWAWAY SYNTAX PROBE (deleted before merge): which lambda / function-parameter /
// sum-as-field spellings the v1 parser and resolver accept.

fn take_one(n: Int, k: fn(Int) -> Int) -> Int {
  k(n)
}

fn take_two(n: Int, m: Int, k: fn(Int, Int) -> Int) -> Int {
  k(n, m)
}

// Is a declared sum usable as a FIELD type (the 3-arm readings shape review 7 asks for)?
type ProbeReading
  = HashFailed { exit_code: Int, stderr: String }
  | Hashed { blob_stdout: String, install_exit: Int, install_stderr: String }

type ProbePair {
  declared: String
  readings: ProbeReading
}

data probe_pair_failed: ProbePair = ProbePair { declared: "a", readings: HashFailed { exit_code: 128, stderr: "no such file" } }
data probe_pair_hashed: ProbePair = ProbePair { declared: "b", readings: Hashed { blob_stdout: " abc ", install_exit: 0, install_stderr: "" } }

fn probe_verdict(p: ProbePair) -> String {
  match p.readings {
    HashFailed { exit_code, stderr } => join(["failed ", to_string(value: exit_code), ": ", stderr], "")
    Hashed { blob_stdout, install_exit: _, install_stderr: _ } => blob_stdout
  }
}

fn take_nullary(k: fn() -> Int) -> Int {
  k()
}

test fn w_nullary_block_closure() -> Bool {
  take_nullary(k: fn() { 9 }) == 9
}

test fn w_nullary_arrow_closure() -> Bool {
  take_nullary(k: fn() => 9) == 9
}

test fn w_unparenthesized_single_param_lambda() -> Bool {
  take_one(n: 3, k: x => x + 1) == 4
}

test fn w_parenthesized_multi_param_lambda() -> Bool {
  take_two(n: 3, m: 4, k: (a, b) => a + b) == 7
}

test fn w_sum_as_field_type() -> Bool {
  probe_verdict(p: probe_pair_failed) == "failed 128: no such file"
}

test fn w_sum_as_field_type_success_arm() -> Bool {
  probe_verdict(p: probe_pair_hashed) == " abc "
}
