module test.claim.compute.compute_run_unit_cold_witness

import std.types { Bool, FilePath }
import std.algebra { all, starts_with }
import gunbc.roadmap.roadmap_dashboard_instance {
  fleet_compute_hermetic_dashboard_instance_at, srv1_live_dashboard_instance,
}
import gunbc.compute.host_capacity { compute_root }
import gunbc.compute.work_provider_local { compute_store, compute_staging_dir }
import std.materialization_store_grant {
  DurableHostVolumeRoot, EphemeralHostVolumeRoot, WitnessScratchRoot,
  materialization_store_root_path, materialization_store_durability,
  DurableAcrossRuns, EphemeralToFrame,
}
import gunbc.instrument_targets { compute_run_unit_cold_label }
import gunbc.instruments.compute_run_unit_cold {
  compute_run_unit_cold_unit_grant_bytes, compute_run_unit_cold_unit_grant,
  compute_run_unit_cold_launcher_headroom, compute_run_unit_cold_job_memory_demand,
}
import gunbc.emitted_subject_build_gate { emitted_subject_build_rows }
import extdeps.bazel.label { render_label, label_eq }
import std.measure { byte_size_count, kibibyte_count }

test fn the_hermetic_instance_is_not_srv1_live() -> Bool {
  let h = fleet_compute_hermetic_dashboard_instance_at(workspace: "/job-workspace" as FilePath)
  let live = srv1_live_dashboard_instance()
  (h.instance_id != live.instance_id)
    && (h.host_identity != live.host_identity)
    && ((h.repo_root as String) != (live.repo_root as String))
    && ((h.instance_root as String) != (live.instance_root as String))
}

test fn the_hermetic_compute_root_is_inside_the_job_workspace_not_opt_gunbc() -> Bool {
  let workspace = "/job-workspace"
  let h = fleet_compute_hermetic_dashboard_instance_at(workspace: workspace as FilePath)
  let root = compute_root(instance: h) as String
  let live_root = srv1_live_dashboard_instance().instance_root as String
  ((h.instance_root as String) == workspace)
    && starts_with(s: root, prefix: join([workspace, "/"], ""))
    && (root != "/opt/gunbc")
    && !starts_with(s: root, prefix: "/opt/gunbc/")
    && !starts_with(s: h.instance_root as String, prefix: "/opt/gunbc/")
    && !starts_with(s: root, prefix: live_root)
    && !starts_with(s: live_root, prefix: root)
}

test fn the_hermetic_store_root_is_the_instance_field_and_not_srv1_live() -> Bool {
  let workspace = "/job-workspace"
  let h = fleet_compute_hermetic_dashboard_instance_at(workspace: workspace as FilePath)
  let live = srv1_live_dashboard_instance()
  let hermetic_root = compute_store(instance: h).root
  let live_root = compute_store(instance: live).root
  let hermetic_path = materialization_store_root_path(root: h.materialization_store_root)
  let live_path = materialization_store_root_path(root: live.materialization_store_root)
  (hermetic_path == join([workspace, "/materialization-store"], ""))
    && (live_path == "/var/lib/gunbc/materialization-store")
    && (hermetic_path != live_path)
    && (compute_staging_dir(instance: h) == join([hermetic_path, "-staging"], ""))
    && (compute_staging_dir(instance: live) == join([live_path, "-staging"], ""))
    && match hermetic_root {
      EphemeralHostVolumeRoot { root: r } => r == hermetic_path
      DurableHostVolumeRoot { root: _ } => false
      WitnessScratchRoot { root: _ } => false
    }
    && match live_root {
      DurableHostVolumeRoot { root: r } => r == live_path
      EphemeralHostVolumeRoot { root: _ } => false
      WitnessScratchRoot { root: _ } => false
    }
    && match materialization_store_durability(root: hermetic_root) {
      EphemeralToFrame => true
      DurableAcrossRuns => false
    }
    && match materialization_store_durability(root: live_root) {
      DurableAcrossRuns => true
      EphemeralToFrame => false
    }
}

test fn the_job_memory_demand_is_the_unit_grant_plus_declared_launcher_headroom() -> Bool {
  let grant = byte_size_count(b: compute_run_unit_cold_unit_grant_bytes)
  let headroom = byte_size_count(b: compute_run_unit_cold_launcher_headroom)
  let demand = byte_size_count(b: compute_run_unit_cold_job_memory_demand())
  (kibibyte_count(k: compute_run_unit_cold_unit_grant()) == 16777216)
    && (grant == 17179869184)
    && (headroom == 1073741824)
    && (demand == grant + headroom)
    && (demand > grant)
}

test fn the_cold_instrument_is_not_a_required_emit_build_row() -> Bool {
  let want = compute_run_unit_cold_label()
  all(emitted_subject_build_rows(), row => !label_eq(a: row.label, b: want))
    && (render_label(l: want) == "//gunbc/instruments:compute-run-unit-cold")
}
