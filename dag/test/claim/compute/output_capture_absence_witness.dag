module test.claim.compute.output_capture_absence_witness

// THE CAPTURE REFUSAL OF AN ABSENT BUILD OUTPUT HAS AN EXECUTING CONTROL.
//
// The build-output capture -- compute_return_outputs in gunbc.compute.work_provider_local -- is
// what turns a declared output that is NOT THERE into a refusal (OutputsMismatch) rather than a
// success with a hole. Before this witness no control executed that refusal: the capture runs
// inside compute_spawn_and_collect, whose neighbours execute systemd-run and the host transport,
// and the hermetic envelope refuses the transport (no mock_response for operation Run; adding one
// is forbidden, operator ruling 2026-08-23). The capture's verdict is therefore decided from two
// EXECUTION READINGS -- the typed outcome of `git hash-object` on the output and of the install
// that stages it -- and readings are data (ComputeOutputCaptureReading). That is what makes the
// refusal controllable hermetically: a control supplies the reading an absent output produces
// (hash-object failing with its real exit and stderr) and the REAL fold, not a copy, decides.
//
// WHAT DISCRIMINATES WHAT (each row fails on a specific mutation, listed at its body):
//  - the refusal rows fail if the step accepts a failed or never-taken reading;
//  - the positive controls fail if the step refuses everything (a refusal that cannot be told
//    apart from a working capture is no capture at all -- DESIGN 5: unknown never reads as absent
//    and a refusal never flattens to []/Bool);
//  - the detail rows fail if the refusal drops the exit code or the execution's own stderr -- the
//    reading does not distinguish absent from unreadable from not-a-repo, so naming "absent" would
//    INVENT a cause the host never reported;
//  - the fold rows fail if the fold keeps collecting after a refusal or reorders;
//  - the inhabittance rows fail if a production caller stops calling the step -- see their section
//    header for exactly what they do and do not establish.
//
// WHAT THIS FILE CANNOT DO, said plainly: the capture's EXECUTIONS cannot run here. The route goes
// through compute_exec -> gunbc.WitnessBin.Run, and the hermetic envelope refuses that operation
// (no mock arm may be added -- operator ruling 2026-08-23). So this file controls the capture's
// DECISIONS (the step and the fold, executed for real on supplied readings), and pins the ROUTE's
// shape with the compiler-reflected call walk below. No row here runs systemd-run or git.
//
// THE REDs THIS FILE KILLS, and which must FAIL when planted (see the PR witness output):
//  - replacing the step's CaptureReadingFailed hash arm with `OutputsReturned` -- capture ACCEPTING
//    an absent output -- turns the three absence rows red while every other row, including both
//    positive controls, stays green;
//  - forking the verdict inside the fold (compute_return_outputs_over_readings deciding its own
//    answer instead of asking the step) turns the three inhabittance rows red;
//  - making the executions stop on a builder-owned exit-code test instead of asking the step turns
//    the executions row red. That row proves the executions CONSULT the step; read its body for
//    what it cannot prove.

import std.types { Bool, Int, String, List }
import std.algebra { string_contains, length, list_map, FreeMonoid }
import gunbc.compute.work_request { DeclaredOutput, WorkOutput, CheckoutRoot, TargetRoot }
import gunbc.compute.work_provider_local {
  OutputsReturn, OutputsMismatch, OutputsReturned,
  ComputeOutputCaptureReading, CaptureReadingOk, CaptureReadingFailed, CaptureReadingNotRun,
  ComputeOutputCapturePair,
  compute_output_capture_step, compute_return_outputs_over_readings
}
import v2.std.fn_index { FnArrowDecl, CallReach, call_reachable_decls_from_root, fn_arrow_decl_facts_live }

// ── supplied data ─────────────────────────────────────────────────────────────────────────────

// The reading `git hash-object <path>` actually gives when <path> is not there: exit 128 and the
// command's own stderr. This is a SUPPLIED INPUT to the real fold -- the shape the capture route
// hands the step when compute_exec reports the failure (work_provider_local.dag
// compute_capture_executions) -- and nothing below relabels it.
// Built from the path so a refusal row can assert WHICH output the fold refused and that no OTHER
// output's name leaked into the detail -- the reading is the host's, and it names only what failed.
fn absent_hash_reading_for(rel: String) -> ComputeOutputCaptureReading {
  CaptureReadingFailed {
    exit_code: 128,
    stdout: "",
    stderr: join(["fatal: could not read '", rel, "': No such file or directory"], "")
  }
}

data absent_hash_reading: ComputeOutputCaptureReading = CaptureReadingFailed {
  exit_code: 128,
  stdout: "",
  stderr: "fatal: could not read 'target/out/plan.json': No such file or directory"
}

data present_hash_reading: ComputeOutputCaptureReading = CaptureReadingOk { stdout: "  e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\n", stderr: "" }
data install_ok_reading: ComputeOutputCaptureReading = CaptureReadingOk { stdout: "", stderr: "" }
data install_failed_reading: ComputeOutputCaptureReading = CaptureReadingFailed { exit_code: 1, stdout: "", stderr: "cannot create '/store/.staged/plan.json': Read-only file system" }
data never_taken: ComputeOutputCaptureReading = CaptureReadingNotRun

fn plan_output() -> DeclaredOutput {
  DeclaredOutput { path: "target/out/plan.json", root: TargetRoot }
}

fn model_output() -> DeclaredOutput {
  DeclaredOutput { path: "target/out/model.bin", root: CheckoutRoot }
}

fn mismatch_detail(r: OutputsReturn) -> String {
  match r {
    OutputsMismatch { detail } => detail
    OutputsReturned { outputs: _ } => ""
  }
}

fn returned_outputs(r: OutputsReturn) -> List<WorkOutput> {
  match r {
    OutputsMismatch { detail: _ } => []
    OutputsReturned { outputs } => outputs
  }
}

// What the capture returned, rendered as "declared=blob" cells joined by '|'. Rendering rather
// than indexing keeps the rows off the resolver's weak spot (a value bound from a recursive tail
// field) and states the ORDER in one equality.
fn returned_shape(outputs: List<WorkOutput>) -> String {
  let cells = list_map(xs: outputs, f: fn(o) { join([o.declared, "=", o.blob], "") })
  join(cells, "|")
}

// ── the refusal, driven on the real fold with a supplied absent output ─────────────────────────

// REFUSAL + THE REAL CAUSE, NOT THE WORD "ABSENT". Fails if the step accepts the failed reading,
// drops the exit code, or drops the execution's own stderr. The detail must carry 128 and the
// git-reported text -- the reading alone cannot tell absence from a permission or not-a-repo
// error, so an honest refusal reports what happened and invents no cause (DESIGN 5).
test fn an_absent_declared_output_is_refused_with_the_executions_real_exit_and_stderr() -> Bool {
  let verdict = compute_output_capture_step(
    declared: "target/out/plan.json",
    returned: [],
    hash: absent_hash_reading,
    install: never_taken
  )
  let detail = mismatch_detail(r: verdict)
  match verdict {
    OutputsMismatch { detail: _ } =>
      string_contains(s: detail, pattern: "target/out/plan.json")
        && string_contains(s: detail, pattern: "could not be hashed")
        && string_contains(s: detail, pattern: "128")
        && string_contains(s: detail, pattern: "No such file or directory")
    OutputsReturned { outputs: _ } => false
  }
}

// AN UNREADABLE OUTPUT REFUSES THE SAME WAY AND READS DIFFERENTLY: same fold, a permission
// failure's reading. Fails if the refusal is keyed to the absence text instead of the exit code.
test fn an_unreadable_declared_output_refuses_through_the_same_fold_naming_its_own_cause() -> Bool {
  let permission_denied = CaptureReadingFailed { exit_code: 128, stdout: "", stderr: "fatal: could not read 'target/out/plan.json': Permission denied" }
  let detail = mismatch_detail(r: compute_output_capture_step(declared: "target/out/plan.json", returned: [], hash: permission_denied, install: never_taken))
  string_contains(s: detail, pattern: "Permission denied")
    && string_contains(s: detail, pattern: "could not be hashed")
}

// A READING THAT WAS NEVER TAKEN REFUSES, IT IS NOT A HOLE: an absent reading never reads as an
// absent output's refusal, and never as success. Fails if NotRun is treated as passed.
test fn a_hash_reading_never_taken_is_refused_never_a_hole() -> Bool {
  match compute_output_capture_step(declared: "target/out/plan.json", returned: [], hash: never_taken, install: never_taken) {
    OutputsMismatch { detail } => string_contains(s: detail, pattern: "was never hashed")
    OutputsReturned { outputs: _ } => false
  }
}

test fn an_install_reading_never_taken_refuses_even_after_a_successful_hash() -> Bool {
  match compute_output_capture_step(declared: "target/out/plan.json", returned: [], hash: present_hash_reading, install: never_taken) {
    OutputsMismatch { detail } => string_contains(s: detail, pattern: "was never stored")
    OutputsReturned { outputs: _ } => false
  }
}

test fn a_failing_install_is_refused_with_its_real_exit_and_stderr() -> Bool {
  let detail = mismatch_detail(r: compute_output_capture_step(declared: "target/out/plan.json", returned: [], hash: present_hash_reading, install: install_failed_reading))
  string_contains(s: detail, pattern: "could not be stored")
    && string_contains(s: detail, pattern: "exited 1")
    && string_contains(s: detail, pattern: "Read-only file system")
}

// THE POSITIVE CONTROLS. Without these, a step that refused every reading would pass every refusal
// row above -- a refusal that cannot be told apart from a working capture is no capture (DESIGN 5).
test fn a_present_output_with_both_readings_ok_is_returned_with_its_trimmed_blob() -> Bool {
  match compute_output_capture_step(declared: "target/out/plan.json", returned: [], hash: present_hash_reading, install: install_ok_reading) {
    OutputsReturned { outputs } =>
      length(xs: outputs) == 1
        && returned_shape(outputs: outputs) == "target/out/plan.json=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
    OutputsMismatch { detail: _ } => false
  }
}

// ── the fold: order, stop-at-first-refusal, and what an empty declaration list means ───────────

test fn the_fold_returns_every_present_output_in_declaration_order() -> Bool {
  let returned = returned_outputs(r: compute_return_outputs_over_readings(pairs: [
    ComputeOutputCapturePair { declared: plan_output(), hash: present_hash_reading, install: install_ok_reading },
    ComputeOutputCapturePair { declared: model_output(), hash: present_hash_reading, install: install_ok_reading }
  ]))
  length(xs: returned) == 2 && returned_shape(outputs: returned) == "target/out/plan.json=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855|target/out/model.bin=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
}

// FAILS IF THE FOLD IGNORES A REFUSAL: the absent second output must stop the fold, and nothing
// collected for a LATER output may survive the refusal (no flattening to a partial success).
test fn the_fold_refuses_at_the_first_absent_output_and_keeps_nothing_after_it() -> Bool {
  let verdict = compute_return_outputs_over_readings(pairs: [
    ComputeOutputCapturePair { declared: plan_output(), hash: present_hash_reading, install: install_ok_reading },
    ComputeOutputCapturePair { declared: model_output(), hash: absent_hash_reading_for(rel: "target/out/model.bin"), install: never_taken },
    ComputeOutputCapturePair { declared: model_output(), hash: present_hash_reading, install: install_ok_reading }
  ])
  match verdict {
    OutputsMismatch { detail } =>
      string_contains(s: detail, pattern: "target/out/model.bin")
        && (string_contains(s: detail, pattern: "target/out/plan.json") == false)
    OutputsReturned { outputs } => false
  }
}

// AN EMPTY DECLARED-OUTPUT LIST RETURNS THE EMPTY LIST AND ONLY THE EMPTY LIST -- it is not the
// shape a refusal takes, and a refusal is never the shape an empty list takes.
test fn no_declared_outputs_is_the_empty_return_never_a_refusal() -> Bool {
  match compute_return_outputs_over_readings(pairs: []) {
    OutputsReturned { outputs } => length(xs: outputs) == 0
    OutputsMismatch { detail: _ } => false
  }
}

// ── inhabittance: production CALLS this fold, per the parser's own call graph ───────────────────
//
// What these rows are, precisely (they do NOT "execute the capture" -- nothing hermetic can; see
// the file header): each runs the compiler-reflected call walk v2.std.fn_index
// (call_reachable_decls_from_root) over the REAL parsed source of gunbc.compute.work_provider_local
// and asks whether a production caller reaches the step. This is not text matching -- the walk is
// built by the compiler's own parser, so a call that does not exist in the AST is not in the graph
// -- but it is a STATIC reachability fact, not an execution of the route.
//
// What they establish: the moment production stops calling the step (a forked verdict in the fold,
// a route that stops routing through the executions), the step drops out of the caller's reachable
// set and the row goes red. What they do NOT establish: that a caller who calls the step does
// nothing else to decide -- reachability cannot see an ADDITIONAL private decision. The builder
// row's body says which half of that the fold rows and the shared accumulator close.

data compute_pool_roots: List<String> = ["dag/gunbc/compute"]
data provider_module: String = "gunbc.compute.work_provider_local"

fn reached_names_from(entry: String) -> List<String> {
  let reach = call_reachable_decls_from_root(
    entry_module: provider_module,
    fn_name: entry,
    terminal_callee_symbols: [],
    closure_modules: [provider_module],
    decls: fn_arrow_decl_facts_live(pool_roots: compute_pool_roots, pool_files: [])
  )
  list_map(xs: reach.reached, f: fn(d) { d.qualified_name })
}

fn reached_contains(entry: String, fn_name: String) -> Bool {
  any(xs: reached_names_from(entry: entry), predicate: fn(q) { q == join(["gunbc.compute.work_provider_local.", fn_name], "") })
}

// POSITIVE CONTROL FIRST: the walk reaches the deepest leaf from the route, so the rows below are
// excluding a reachable thing from a non-empty walk, not passing over an empty answer.
test fn the_capture_route_reaches_the_capture_step_through_production() -> Bool {
  reached_contains(entry: "compute_spawn_and_collect", fn_name: "compute_output_capture_step")
}

// ONE ANSWER, FROM THE STEP: compute_return_outputs -- what every capture call site calls,
// including compute_spawn_and_collect -- reaches the step, with the executions builder the only
// path between them. RED if production forks its own copy of the decision, or answers without
// asking the step.
test fn production_reaches_the_same_capture_fold() -> Bool {
  reached_contains(entry: "compute_return_outputs", fn_name: "compute_output_capture_step")
}

// THE ROUTE ASKS THE ONE FOLD, NOT ITSELF: the capture route reaches the executions, the
// executions reach the fold (which is the only site that asks the step), and the step is reachable
// from the executions only through that fold. HONEST SCOPE: reachability sees calls, not extra
// state, so this cannot prove the executions keep no private stop of their own; that half is closed
// structurally -- the executions' accumulator is the readings plus the FOLD'S OutputsReturn, with no
// Bool and no verdict of their own to keep -- and behaviorally, by the RED that gives the executions
// an exit-code stop of their own (this row goes red, because the fold-call edge disappears).
test fn the_capture_route_runs_its_executions_through_the_fold() -> Bool {
  reached_contains(entry: "compute_spawn_and_collect", fn_name: "compute_capture_executions")
    && reached_contains(entry: "compute_capture_executions", fn_name: "compute_return_outputs_over_readings")
    && reached_contains(entry: "compute_capture_executions", fn_name: "compute_output_capture_step")
}

// THE STEP DECIDES FOR THE FOLD: the fold reaches the step -- so no fold-side copy of the verdict
// can hide from the controls above.
test fn the_fold_asks_the_step_and_never_decides_itself() -> Bool {
  reached_contains(entry: "compute_return_outputs_over_readings", fn_name: "compute_output_capture_step")
}
