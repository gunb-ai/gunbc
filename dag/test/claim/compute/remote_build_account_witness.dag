// HERMETIC CONTROLS for the remote-build account (operator, 2026-11-15): the account row, the principal
// the serving entry admits, the serving instance it owns, and the one ledger it shares with the service
// user. They do NOT establish that the account exists on a host with these ids: it is created by hand,
// and the serving entry's own principal read-back (remote_build_serve_principal) is the check that runs
// there on every request.

// ── the account ────────────────────────────────────────────────────────────────────────────────────

test fn the_remote_build_account_holds_no_root_equivalent_group() -> Bool {
  fleet_posix_remote_build_user.uid != 0
    && fleet_posix_remote_build_supplementary_groups |> all(g => !(fleet_root_equivalent_group_names |> any(r => r as String == g as String)))
}

// sshd runs a forced command through the login shell, so a nologin shell would accept the key and run
// nothing.
test fn the_remote_build_account_can_run_a_forced_command() -> Bool {
  posix_shell_permits_command_execution(shell: fleet_posix_remote_build_user.shell)
}

test fn the_remote_build_ids_collide_with_no_known_principal() -> Bool {
  let ids = [fleet_posix_remote_build_user.uid, fleet_posix_remote_build_user.gid, fleet_posix_compute_ledger_group_gid]
  let taken = concat(fleet_srv1_observed_numeric_ids, [fleet_posix_worker_user.uid, fleet_posix_worker_user.gid, fleet_posix_worker_shared_group_gid, fleet_posix_operator_user.uid])
  ids |> all(i => !(taken |> any(t => t == i)))
    && fleet_posix_compute_ledger_group_gid != fleet_posix_remote_build_user.gid
}

// ── the principal the serving entry admits ─────────────────────────────────────────────────────────

data w_group_file: String = "briansrls:x:1000:\ngunbc-build:x:1005:\ngunbc-compute:x:1006:briansrls,gunbc-build\ndocker:x:998:gunbc-build\n"

fn w_status(uid: Int, groups: String) -> String {
  join(["Name:\tgunbc\nUid:\t", to_string(value: uid), "\t", to_string(value: uid), "\t", to_string(value: uid), "\t", to_string(value: uid), "\nGroups:\t", groups, "\n"], "")
}

fn w_admitted(p: RemoteBuildServePrincipal) -> Bool {
  match p {
    RemoteBuildServePrincipalAdmitted => true
    RemoteBuildServePrincipalRefused { reason: _ } => false
  }
}

test fn the_account_in_its_own_and_the_ledger_group_is_admitted() -> Bool {
  w_admitted(p: remote_build_serve_principal_of(status: w_status(uid: 1005, groups: "1005 1006 "), group_file: w_group_file, service_user: fleet_posix_operator_user.name))
}

// A key installed in the operator's authorized_keys serves nothing.
test fn the_operator_is_not_admitted() -> Bool {
  !w_admitted(p: remote_build_serve_principal_of(status: w_status(uid: fleet_posix_operator_user.uid, groups: "1000 1006 "), group_file: w_group_file, service_user: fleet_posix_operator_user.name))
}

test fn the_account_in_a_root_equivalent_group_is_not_admitted() -> Bool {
  !w_admitted(p: remote_build_serve_principal_of(status: w_status(uid: 1005, groups: "1005 1006 998 "), group_file: w_group_file, service_user: fleet_posix_operator_user.name))
}

// The hand step can miss each half of the ledger share, and each miss refuses at the principal check
// rather than at the first reservation (review 95574).
test fn the_account_outside_the_ledger_group_is_not_admitted() -> Bool {
  !w_admitted(p: remote_build_serve_principal_of(status: w_status(uid: 1005, groups: "1005 "), group_file: w_group_file, service_user: fleet_posix_operator_user.name))
}

test fn a_ledger_group_at_another_gid_is_not_admitted() -> Bool {
  let moved = "briansrls:x:1000:\ngunbc-build:x:1005:\ngunbc-compute:x:1007:briansrls,gunbc-build\n"
  !w_admitted(p: remote_build_serve_principal_of(status: w_status(uid: 1005, groups: "1005 1007 "), group_file: moved, service_user: fleet_posix_operator_user.name))
}

// The declared gid held under another name is not the declared group: only the by-name check sees it.
test fn the_ledger_gid_under_another_name_is_not_admitted() -> Bool {
  let renamed = "briansrls:x:1000:\ngunbc-build:x:1005:\nbuilders:x:1006:briansrls,gunbc-build\ngunbc-compute:x:1007:briansrls\n"
  !w_admitted(p: remote_build_serve_principal_of(status: w_status(uid: 1005, groups: "1005 1006 "), group_file: renamed, service_user: fleet_posix_operator_user.name))
}

test fn a_ledger_group_without_the_service_user_is_not_admitted() -> Bool {
  let without = "briansrls:x:1000:\ngunbc-build:x:1005:\ngunbc-compute:x:1006:gunbc-build\n"
  !w_admitted(p: remote_build_serve_principal_of(status: w_status(uid: 1005, groups: "1005 1006 "), group_file: without, service_user: fleet_posix_operator_user.name))
}

// ── whose ledger the serving entry authorizes ──────────────────────────────────────────────────────
// The service user the principal check demands is the owner of the capacity home the ledger lives in --
// the same carrier the ledger subject resolves through -- and NOT a separate dashboard-instance lookup.
// A host that runs a dashboard instance keeps that instance's owner; a serving host with none takes the
// host home's declared owner; a host with neither names no owner and is refused.

fn w_owner_matches_instance_owner(host: String) -> Bool {
  match dashboard_instance_for_host(host: host) {
    DashboardInstanceForHost { instance: ledger } =>
      match remote_build_serve_ledger_owner(host: host) {
        ServeLedgerOwnerDeclared { service_user: owner } => (owner as String) == (ledger.directory_owner.user as String)
        ServeLedgerOwnerUndeclared { host: _ } => false
      }
    DashboardInstanceHostUnknown { host: _ } => false
  }
}

// srv1 and srv2 RUN a dashboard instance, so their ledger is that instance's home and its owner names the
// service user -- the name the instance lookup returned before, unchanged.
test fn a_dashboard_host_keeps_its_instance_owner_as_the_ledger_service_user() -> Bool {
  ["srv1", "srv2"] |> all(name => w_owner_matches_instance_owner(host: name))
}

// srv3 and srv4 have NO dashboard instance to ask, and that used to end the request: the serving entry
// refused with "no ledger instance is declared for host" while the ledger subject it would have written
// resolved happily at the host home. Red control: this reds the moment the owner comes from an instance
// lookup again -- the instance arm here is proven absent, so only the host home can answer.
test fn a_serving_host_with_no_dashboard_instance_names_its_host_home_owner() -> Bool {
  ["srv3", "srv4"] |> all(name => {
    match dashboard_instance_for_host(host: name) {
      DashboardInstanceForHost { instance: _ } => false
      DashboardInstanceHostUnknown { host: _ } => {
        let home = host_capacity_ledger_home(host: (name as String) as NonEmptyStr, build_seat: host_capacity_build_seat(host: (name as String) as HostIdentity))
        match remote_build_serve_ledger_owner(host: name) {
          ServeLedgerOwnerUndeclared { host: _ } => false
          ServeLedgerOwnerDeclared { service_user: owner } =>
            (owner as String) == (home.directory_owner.user as String)
              && w_admitted(p: remote_build_serve_principal_of(status: w_status(uid: 1005, groups: "1005 1006 "), group_file: w_group_file, service_user: owner))
        }
      }
    }
  })
}

// A host that is neither rostered nor runs an instance has no ledger to authorize: the owner is not
// defaulted to the remote-build account or to any instance, it is refused.
test fn a_host_with_neither_a_home_nor_an_instance_names_no_ledger_owner() -> Bool {
  match remote_build_serve_ledger_owner(host: "srv14") {
    ServeLedgerOwnerUndeclared { host: other } => other == "srv14"
    ServeLedgerOwnerDeclared { service_user: _ } => false
  }
}

// ── the serving instance ───────────────────────────────────────────────────────────────────────────

fn w_under_account_home(path: FilePath) -> Bool {
  starts_with(s: path as String, prefix: concat(fleet_posix_remote_build_home(), "/"))
}

// Every roster instance is the account's own: owned by it, rooted in its home, and sharing no owned
// path with any declared dashboard instance.
test fn every_serving_instance_is_the_accounts_own() -> Bool {
  count(remote_build_candidates()) > 0
    && remote_build_candidates() |> all(c =>
      c.instance.directory_owner.user as String == fleet_posix_remote_build_user.name as String
        && w_under_account_home(path: c.instance.repo_root)
        && w_under_account_home(path: c.instance.instance_root)
        && w_under_account_home(path: c.instance.serve_binary)
        && dashboard_instance_is_disjoint_from_public_builtins(candidate: c.instance))
}

// ── the one ledger ─────────────────────────────────────────────────────────────────────────────────

fn w_shared(s: ComputeLedgerSharing) -> Bool {
  match s {
    ComputeLedgerSharedWithRemoteBuild => true
    ComputeLedgerServiceOnly => false
  }
}

// THE SHARED LEDGER IS THE HOST HOME, so the sharing test asks the subject (resolved BY HOST), not the
// host's dashboard instance. The subject on a roster host carries the host home at /opt/gunbc, which
// compute_ledger_sharing groups to the ledger group; a host that resolved through the old
// dashboard_instance_for_host path -- srv2 to /home, srv3/srv4 to nothing -- would report unshared here.
fn w_host_ledger_is_shared(host: HostIdentity) -> Bool {
  match host_capacity_subject(instance: remote_build_serving_instance(host: host), pool: ComputeBuildPool) {
    ComputeSubjectHostUnresolved { host: _ } => false
    ComputeSubjectResolved { subject: s, appropriation: _ } => w_shared(s: compute_ledger_sharing_carrier(home: s.home))
  }
}

// THE JOIN THE SHARE EXISTS FOR: every host the roster serves resolves to a ledger its directories
// share with the remote-build account, so a request never reserves in a ledger it cannot write. A roster
// derived from anything but the serving-host row would break this.
test fn every_roster_host_resolves_to_a_shared_ledger() -> Bool {
  count(remote_build_candidates()) == count(remote_build_serving_hosts())
    && remote_build_candidates() |> all(c => w_host_ledger_is_shared(host: c.host))
}

// Only the ledger the host resolves to is shared: srv1's lab and every srv2 instance keep theirs.
test fn a_ledger_off_the_serving_route_stays_the_service_users() -> Bool {
  !w_shared(s: compute_ledger_sharing(instance: srv1_lab_dashboard_instance()))
    && !w_shared(s: compute_ledger_sharing(instance: srv2_deploy_dashboard_instance()))
    && !w_shared(s: compute_ledger_sharing(instance: remote_build_serving_instance(host: "srv1" as HostIdentity)))
}

fn w_area_is_group_shared(t: OwnedDirectoryTarget) -> Bool {
  match t {
    OwnedDirectoryDeclared { member: _, path: _, owner, mode, group_adoption } =>
      owner.group as String == fleet_posix_compute_ledger_group_name as String
        && owner.user as String == fleet_posix_operator_user.name as String
        && match mode { DirectoryOwnerGroupWritableSetgidSticky => true  _ => false }
        && match group_adoption { SameUserRegroupToDeclaredGroup => true  ForeignOwnershipRefuses => false }
    OwnedDirectoryManaged { directory: _ } => false
  }
}

fn w_area_is_service_only(t: OwnedDirectoryTarget, instance: HostDashboardInstance) -> Bool {
  match t {
    OwnedDirectoryDeclared { member: _, path: _, owner, mode, group_adoption } =>
      owner.group as String == instance.directory_owner.group as String
        && match mode { DirectoryOwnerAllEveryoneTraverse => true  _ => false }
        && match group_adoption { SameUserRegroupToDeclaredGroup => false  ForeignOwnershipRefuses => true }
    OwnedDirectoryManaged { directory: _ } => false
  }
}

// On srv1-live the ledger root stays traverse-only and its two areas are group-writable setgid in the
// ledger group, re-grouped rather than re-owned; srv2-deploy's three stay the service user's.
test fn the_shared_ledger_grants_exactly_its_two_areas() -> Bool {
  let live = compute_capacity_directories(instance: srv1_live_dashboard_instance())
  let deploy = srv2_deploy_dashboard_instance()
  let other = compute_capacity_directories(instance: deploy)
  count(live) == 3
    && match live |> first { Present { value: root } => !w_area_is_group_shared(t: root)  Absent => false }
    && count(live |> filter(t => w_area_is_group_shared(t: t))) == 2
    && count(other |> filter(t => w_area_is_group_shared(t: t))) == 0
    && count(other |> filter(t => w_area_is_service_only(t: t, instance: deploy))) == 3
}

// A SUSPENDED DISPATCH STANDING IS NOT A WITHDRAWN SERVING ROUTE. The two questions now have separate rows to
// answer (gunbc.compute.remote_build_hosts: remote_build_serving_hosts is the live dispatch gate,
// remote_build_serving_candidate_hosts is where the serving route is provisioned), and srv1 sits on one and not
// the other. Both halves asserted, because a reader who conflates them re-keys the ledger posture and silently
// rewrites a live host's permissions: the account, the capacity home and an unsettled seat are still on that
// disk, and the remote-build account still has to reach its own ledger. The claim above is this one's red
// control -- key the posture back to the dispatch gate and srv1's areas stop being group-shared.
test fn a_suspended_host_is_still_a_provisioned_candidate() -> Bool {
  !remote_build_host_is_serving(host: operator_host_srv1)
    && remote_build_host_is_serving_candidate(host: operator_host_srv1)
    && match compute_ledger_sharing(instance: srv1_live_dashboard_instance()) {
      ComputeLedgerSharedWithRemoteBuild => true
      ComputeLedgerServiceOnly => false
    }
}

// THE LEDGER MUST BE REACHABLE BY AN ACCOUNT THAT IS NOT ITS OWNER, and a ledger inside another
// account's home is not: a home is closed to other accounts (the srv1 lab's 200/CHDIR on
// /home/briansrls/.local/share, gunbc.recurring_failure_mode
// a_foreign_uid_is_handed_a_path_it_cannot_reach_or_a_manager_creates_one_its_consumer_cannot_use).
//
// THE LEDGER IS FOUND BY HOST NOW, so the question is asked of the HOST-SHARED home, not of whatever
// instance the host happens to resolve. It is asked through gunbc.compute.host_capacity
// host_capacity_subject, which resolves the carrying instance BY HOST. THIS IS THE RED CONTROL. srv1's
// host home and srv1's own dashboard instance BOTH live at /opt/gunbc, so the root alone cannot tell the
// host home from a walk of srv1's dashboard instance -- the host home carries actuator_host == the host,
// while srv1's dashboard instance is actuated from the operator laptop ("macbook"). If
// host_capacity_subject ever goes back to walking gunbc.roadmap.roadmap_dashboard_instance
// dashboard_instance_for_host, srv1's ledger resolves through its macbook-actuated dashboard instance and
// the actuator_host check reds even though the root still reads /opt/gunbc. (The seal witness
// a_host_with_no_dashboard_instance_still_resolves_its_ledger_by_host carries the same claim for the
// not-yet-admitted srv2/srv3/srv4 on the model home; PR 5 adds each of them to this roster as it creates
// its home on disk, at which point they are checked here too.)
test fn every_roster_hosts_ledger_is_the_host_home_not_an_instance_tree() -> Bool {
  remote_build_serving_hosts() |> all(h => match host_capacity_subject(instance: remote_build_serving_instance(host: h), pool: ComputeBuildPool) {
    ComputeSubjectHostUnresolved { host: _ } => false
    ComputeSubjectResolved { subject: s, appropriation: _ } =>
      (s.home.instance_root as String) == "/opt/gunbc"
        && (compute_capacity_root_carrier(home: s.home) as String) == "/opt/gunbc/compute/capacity"
        && !starts_with(s: compute_capacity_root_carrier(home: s.home) as String, prefix: "/home/")
  })
}

// ONE LEDGER PER HOST, NOT ONE PER INSTANCE. The requesting instance here is a remote-build SERVING
// instance whose own root is NOT /opt/gunbc (line 156 above already asserts it is not the shared ledger);
// the ledger it mints on srv2 -- which has several dashboard instances scattered under /home/briansrls --
// is the single host home. srv2 is not on the roster yet (PR 5 admits it the day it creates and reads
// back its home), so this asks the claim of the host home directly through host_capacity_subject_in,
// forcing srv2's host_capacity_home as the carrying instance. If the ledger followed the requesting
// instance, or any one of srv2's several /home instances instead of the host home, it lands outside
// /opt/gunbc/compute/capacity and this reds. This is the "every instance on a host reserves in that one
// ledger" claim, discriminated.
test fn every_instance_on_a_host_reserves_in_the_one_host_ledger() -> Bool {
  let srv2_home = host_capacity_ledger_home(host: "srv2" as NonEmptyStr, build_seat: host_capacity_build_seat(host: "srv2" as HostIdentity))
  let ledger = host_capacity_subject_in(requesting: remote_build_serving_instance(host: "srv2" as HostIdentity), host_home: srv2_home, pool: ComputeBuildPool)
  (ledger.subject.home.instance_root as String) == "/opt/gunbc"
    && (compute_capacity_root_carrier(home: ledger.subject.home) as String) == "/opt/gunbc/compute/capacity"
}

// srv3/srv4 HAVE NO DASHBOARD INSTANCE TO CARRY THEIR LEDGER, yet the remote-build account's reservation
// still lands in the SINGLE host ledger -- asked of the host home directly through
// host_capacity_subject_in, forcing srv3/srv4's host_capacity_home. The root must be the one host home
// /opt/gunbc/compute/capacity, not any per-instance tree. The build-pool carve that admission brings is
// witnessed in the seal witness (the_admitted_hosts_carve_one_slot_into_the_build_pool).
test fn srv3_and_srv4_reserve_in_the_one_host_ledger() -> Bool {
  ["srv3", "srv4"] |> all(name => {
    let home = host_capacity_ledger_home(host: (name as String) as NonEmptyStr, build_seat: host_capacity_build_seat(host: (name as String) as HostIdentity))
    let ledger = host_capacity_subject_in(requesting: remote_build_serving_instance(host: (name as String) as HostIdentity), host_home: home, pool: ComputeBuildPool)
    (ledger.subject.home.instance_root as String) == "/opt/gunbc"
      && (compute_capacity_root_carrier(home: ledger.subject.home) as String) == "/opt/gunbc/compute/capacity"
  })
}

// ── per-host ledger owner: the single-authority witnesses ─────────────────────────────────────────

// (1) srv3/srv4's ledger rows are BYTE-IDENTICAL to what the old universal rule produced. The legacy
// frontier keeps them under the operator login; if the frontier were removed or the discriminator
// changed, this reds. This is the byte-identity preservation witness.
test fn srv3_and_srv4_ledger_owner_is_legacy_operator_preserving_byte_identity() -> Bool {
  ["srv3", "srv4"] |> all(name => {
    let owner = capacity_ledger_directory_owner(host: (name as String) as NonEmptyStr)
    (owner.user as String) == (fleet_posix_operator_user.name as String)
      && (owner.group as String) == (fleet_posix_operator_user.name as String)
  })
}

// (2) The serving-model claims (fresh-host group members are all converge-ensured; the deduped desired
// settles against the single observed member; a stray member deviates) live in the SERVING sweep,
// test.claim.compute.remote_build_serving_setup_witness, which imports the serving model this exercises
// (partition by module). They are kept out of the account sweep deliberately: pulling remote_build_serving_setup
// into the account graph blew its compile from ~65s past timeout, and they are serving-model claims, not
// account-model claims.

// (3) The discriminator IS THE FRONTIER'S OWN MEMBERSHIP — never the live-roster or candidate row. A
// fresh host joins the candidate row and then the serving roster as it converges; if the ledger owner
// were keyed on either, a freshly-converged host would re-own (gunbc-build → briansrls) on the next run.
fn owner_is_build_account(o: PosixOwnerNames) -> Bool { (o.user as String) == (fleet_posix_remote_build_user.name as String) }
fn owner_is_operator(o: PosixOwnerNames) -> Bool { (o.user as String) == (fleet_posix_operator_user.name as String) }

// Discriminating control: ken and butch ARE serving candidates (remote_build_host_is_serving_candidate is
// true — that is the very status that "flips on admission"), yet their owner is the remote-build account,
// NOT the operator. An implementation keyed on remote_build_host_is_serving_candidate would return the
// operator for them and go red here. And srv3/srv4 — which ARE on the live roster AND in the frontier —
// resolve to the operator only because they are in the frontier. So the owner is the operator iff the
// host is in the frontier (and carries no dashboard instance); candidate/roster status never decides it.
test fn the_owner_discriminator_is_the_frontier_not_the_candidate_or_roster_row() -> Bool {
  // ken/butch are serving CANDIDATES, yet not operator-owned — candidate/roster status does not decide.
  remote_build_host_is_serving_candidate(host: operator_host_e2d4b7)
    && remote_build_host_is_serving_candidate(host: operator_host_srv14)
    && owner_is_build_account(capacity_ledger_directory_owner(host: "host-e2d4b7" as NonEmptyStr))
    && owner_is_build_account(capacity_ledger_directory_owner(host: "srv14" as NonEmptyStr))
    // the frontier members (srv3/srv4) ARE operator-owned, and they are exactly the non-instance hosts
    // whose owner is the operator — the frontier is the authority, not the roster.
    && owner_is_operator(capacity_ledger_directory_owner(host: "srv3" as NonEmptyStr))
    && owner_is_operator(capacity_ledger_directory_owner(host: "srv4" as NonEmptyStr))
    && all(capacity_ledger_legacy_owner_frontier.members, h => owner_is_operator(capacity_ledger_directory_owner(host: (h as String) as NonEmptyStr)))
}

// (4) The frontier's retirement condition is CONSUMED DATA, not a comment or a dangling field
// (source_annotations: a dissolution condition belongs in a typed carrier AND is exercised; consumption: a
// row no fold reads is dangling; guarantee_ladder: discriminating reds). The single consumer
// capacity_ledger_frontier_confers_operator_ownership reads ALL THREE discharge fields on the route the
// owner function runs — entry_owner_read, read_instrument (compared against the designated instrument), and
// re_own_ruling — and the frontier retires only when all three say so. This witness drives every arm so no
// gate can be gutted to a constant or the instrument check removed without going red.
//   - positive control: the LIVE discharge confers operator ownership (srv3/srv4 stay byte-identical);
//   - all three gates satisfied → does NOT confer (the frontier CAN discharge);
//   - RED (instrument gate): proved-clear by a WRONG instrument still confers → read_instrument is load-bearing;
//   - RED (read gate): right instrument + landed ruling but read NOT yet performed still confers → the read
//     is required;
//   - RED (ruling gate): right instrument + proved-clear read but NO landed ruling still confers → a read
//     alone cannot re-own a live ledger; the ruling is required. Each gate is independently discriminated.
test fn the_frontier_discharge_is_consumed_and_falsifiable() -> Bool {
  let live = capacity_ledger_legacy_owner_frontier.discharge
  // The fixture ruling names THIS witness module, not a fabricated gunbc.design_ruling row (epistemic
  // humility: do not assert a citation that exists nowhere) — any ReOwnRulingMade value exercises the gate.
  let fixture_ruling = decl_ref(module_path: "test.claim.compute.remote_build_account_witness", decl_name: "the_frontier_discharge_is_consumed_and_falsifiable")
  // positive control: the live discharge keeps the frontier operator-owned.
  capacity_ledger_frontier_confers_operator_ownership(discharge: live)
    // the live state is precisely un-discharged on all three gates.
    && match live.entry_owner_read { ReadNotYetPerformed => true ReadProvedClear => false }
    && match live.re_own_ruling { ReOwnRulingNotYetMade => true ReOwnRulingMade { ruling: _ } => false }
    && declaration_ref_eq(a: live.read_instrument, b: capacity_ledger_entry_owner_read_instrument)
    // FULL discharge — all three gates satisfied — does NOT confer operator ownership. Discriminating: a
    // consumer that ignored any gate (always true) fails here.
    && !capacity_ledger_frontier_confers_operator_ownership(discharge: CapacityLedgerFrontierDischarge {
         entry_owner_read: ReadProvedClear,
         read_instrument: capacity_ledger_entry_owner_read_instrument,
         re_own_ruling: ReOwnRulingMade { ruling: fixture_ruling },
       })
    // RED: a proved-clear read by the WRONG instrument still confers ownership (the instrument gate is live).
    && capacity_ledger_frontier_confers_operator_ownership(discharge: CapacityLedgerFrontierDischarge {
         entry_owner_read: ReadProvedClear,
         read_instrument: decl_ref(module_path: "test.claim.compute.remote_build_account_witness", decl_name: "not_the_designated_read_instrument"),
         re_own_ruling: ReOwnRulingMade { ruling: fixture_ruling },
       })
    // RED: right instrument + landed ruling but the read has NOT yet been performed still confers ownership.
    && capacity_ledger_frontier_confers_operator_ownership(discharge: CapacityLedgerFrontierDischarge {
         entry_owner_read: ReadNotYetPerformed,
         read_instrument: capacity_ledger_entry_owner_read_instrument,
         re_own_ruling: ReOwnRulingMade { ruling: fixture_ruling },
       })
    // RED: right instrument + a proved-clear read but NO landed ruling still confers ownership — a
    // read alone cannot re-own a live ledger; the ruling gate is required, not inferred.
    && capacity_ledger_frontier_confers_operator_ownership(discharge: CapacityLedgerFrontierDischarge {
         entry_owner_read: ReadProvedClear,
         read_instrument: capacity_ledger_entry_owner_read_instrument,
         re_own_ruling: ReOwnRulingNotYetMade,
       })
}

// (4b) The frontier decision keys on the DECLARED MEMBERSHIP, not the live serving roster. The shipped
// frontier [srv3, srv4] is coincident with remote_build_serving_hosts, so the real data cannot separate the
// two authorities; capacity_ledger_owner_for_membership is the pure frontier decision and this witness drives
// it with a membership list that DISAGREES with the roster. srv3 IS on the serving roster (red control below
// confirms remote_build_host_is_serving(srv3)), yet with an EMPTY membership the pure decision hands srv3 the
// build account — a roster-keyed implementation would instead hand srv3 the operator login and go red here.
test fn the_frontier_keys_on_membership_not_the_serving_roster() -> Bool {
  let empty_members: List<HostIdentity> = []
  // positive: a real member, un-discharged, gets the operator login.
  owner_is_operator(capacity_ledger_owner_for_membership(host: "srv3" as NonEmptyStr, members: [operator_host_srv3], discharge: capacity_ledger_legacy_owner_frontier.discharge))
    // RED CONTROL: srv3 is on the live serving roster (so a roster-keyed authority would call it operator)…
    && remote_build_host_is_serving(host: "srv3" as NonEmptyStr)
    // …but the frontier decision, given an empty membership, hands srv3 the BUILD account. A roster-keyed
    // implementation returns operator here regardless of the members argument — this is the discriminator.
    && owner_is_build_account(capacity_ledger_owner_for_membership(host: "srv3" as NonEmptyStr, members: empty_members, discharge: capacity_ledger_legacy_owner_frontier.discharge))
    // a rostered-in-name host that is a member with the membership list given gets operator (membership wins
    // over any roster read, in both directions).
    && owner_is_operator(capacity_ledger_owner_for_membership(host: "srv4" as NonEmptyStr, members: [operator_host_srv4], discharge: capacity_ledger_legacy_owner_frontier.discharge))
}
