  compute_capacity_directories, ComputeLedgerSharing, ComputeLedgerSharedWithRemoteBuild, ComputeLedgerServiceOnly, compute_ledger_sharing,
  compute_ledger_sharing_carrier, compute_capacity_root_carrier,
