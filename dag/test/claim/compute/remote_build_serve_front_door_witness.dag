// THE FRONT DOOR: what a probe leg costs, what it establishes, and what a request still pays.
//
// WHY THIS WITNESS EXISTS. A remote-build leg resolved the WHOLE request entry's import closure before
// any function ran -- srv1, 2026-11-25 (calm-wren-314): resolve_entry_graph_inclusive 248,554 ms over
// 895 modules, max_rss 3.8 GiB, for a probe that prints a constant. The cause was placement, not
// machinery: `gunbc run` already scopes its resolve to the requested ENTRY MODULE
// (src/v1/stage0/src/main.rs run_verb -> cli_run::resolve_entry_graph_demand_acquired_scoped), and the
// probe's words and its answer were declared inside the request module, so the probe's demand graph
// included fetch, the seed build, the provider and the ledger. The fix is an entry, not a cache
// (gunbc.design_argument::demand_before_materialization: remove the demand; do not cache, floor a count,
// or hold a process open to amortize what should not be asked for).
//
// MEASURED on this repository's head, same machine, same command, differing only in --entry
// (`gunbc run --source-root dag --source-root src/v2 --entry <file> --function __no_such_function__`,
// which resolves and refuses before evaluating, so the pre-entry receipt is the whole cost):
//   dag/gunbc/compute/remote_build_serve.dag                  closure_files=897  resolve 143,398 ms  max_rss 3,421,140 KiB
//   dag/gunbc/compute/remote_build_serve_front_door.dag        closure_files=151  resolve   9,755 ms  max_rss   379,164 KiB
// RE-MEASURED 2026-11-27 after the PRE-HAND-OFF ADMISSION (the gate whose claims sit below): the door
// now also reads the seat ledger, so its demand graph carries gunbc.compute.host_capacity (352 modules
// on its own). The measured door entry at this head: closure_files=375, resolve 44,557 ms -- still a
// third of the request entry's wall and a tenth of its modules, and the probe answer itself is still
// minted from the principal leaf alone. Two widening attempts were measured and REJECTED on the way:
// importing the roster module for the serving-instance mint (closure_files=913, resolve 129,846 ms --
// fixed by moving the mint to the gunbc.compute.remote_build_serving_identity leaf), and importing the
// systemctl/host-effect machinery for the hand-off's slice diagnostic (closure_files=866 and 874 --
// fixed by reading the cgroup's own interface files through extdeps.linux.cgroup_v2_memory instead).
// 14.4x the wall, 9.2x the memory, 6.0x the modules. A probe leg now resolves 151 modules instead of
// 897; a REQUEST leg resolves the door (9.8 s) and then the serving entry, so its own cost is unchanged
// in kind -- it still needs the request closure -- and that is the honest reading: this cut is the probe's,
// and the request leg's remaining resolve is the one the fabric dispatch/seat route converges on.
// The door now also reads extdeps.clock (the accept instant the wall bounds measure from), which is a
// one-file leaf: the probe closure moved 150 -> 151, not by a request-path import.
//
// WHAT IS NOT ASSERTED AS A NUMBER. No claim here floors or ceilings a module count: a count is not the
// property (gunbc.integration_concern debt_payoff section 3 -- "a count floor, a widened budget or a
// cache is never payoff"). The claims are about WHAT THE DOOR READS: which imports it may name, which
// half of the principal judgment answers a probe, which bytes a hand-off may carry, and which entry may
// mint "ready". The instrument in the closure claim discriminates on its own -- its red arm is the entry
// this door exists to keep out.

// ── the readings the door decides on ──────────────────────────────────────────────────────────────

data w_bin: String = "/opt/gunbc/bin/gunbc"
data w_repo: String = "/opt/gunbc/gunbc"
// A fixture wall bound for the door's hand-off: the ceiling and the accept instant the door would carry.
data w_leg_ceiling: String = "900"
data w_accept_instant: String = "1700000000"
data w_group_file: String = "briansrls:x:1000:\ngunbc-build:x:1005:\ngunbc-compute:x:1006:briansrls,gunbc-build\ndocker:x:998:gunbc-build\n"
// The same host, with the ledger group no longer listing the host's ledger service user. Everything the
// PROBE checks still holds on it; only the ledger half -- a reservation's fact -- has gone.
data w_group_file_without_ledger_member: String = "briansrls:x:1000:\ngunbc-build:x:1005:\ngunbc-compute:x:1006:gunbc-build\ndocker:x:998:gunbc-build\n"

fn w_status(uid: Int, groups: String) -> String {
  join(["Name:\tgunbc\nUid:\t", to_string(value: uid), "\t", to_string(value: uid), "\t", to_string(value: uid), "\t", to_string(value: uid), "\nGroups:\t", groups, "\n"], "")
}

fn w_serving_host() -> String {
  match remote_build_serving_hosts() |> first {
    Present { value: h } => h as String
    Absent => ""
  }
}

fn w_principal_admitted() -> RemoteBuildServePrincipal {
  // The declared uid and the declared group ids, read from the fleet's own rows rather than invented here.
  remote_build_serve_principal_account_of(
    status: w_status(uid: fleet_posix_remote_build_user.uid, groups: join([to_string(value: fleet_posix_remote_build_user.uid), " ", to_string(value: fleet_posix_compute_ledger_group_gid)], "")),
    group_file: w_group_file,
  )
}

fn w_principal_refused() -> RemoteBuildServePrincipal {
  remote_build_serve_principal_refused_for_a_group_the_account_does_not_hold()
}

// REFUSED, for a reason the account half really checks -- the account is missing one of its declared
// supplementary groups. Fabricating a reason string here would witness the door's mapping only; this
// asks the one judgment that makes the refusal.
fn remote_build_serve_principal_refused_for_a_group_the_account_does_not_hold() -> RemoteBuildServePrincipal {
  remote_build_serve_principal_account_of(
    status: w_status(uid: fleet_posix_remote_build_user.uid, groups: to_string(value: fleet_posix_remote_build_user.uid)),
    group_file: w_group_file,
  )
}

// THE LEDGER STANDING THE TURN DECIDES AGAINST. The turn is pure, so every claim below supplies the
// standing itself; the wet reader (remote_build_serve_front_door_admission) resolves the same standing
// from the host's own ledger and is witnessed red-side at the gate lane, not here.
fn w_admission_admitted() -> RemoteBuildDoorAdmission {
  DoorAdmitted { held: 0, seats: 2 }
}

fn w_turn(raw: String?, principal: RemoteBuildServePrincipal) -> RemoteBuildFrontDoorTurn {
  remote_build_serve_front_door_turn(
    host: w_serving_host(),
    serve_binary: w_bin,
    repo_root: w_repo,
    leg_ceiling: w_leg_ceiling,
    accept_instant: w_accept_instant,
    raw_command: raw,
    principal: principal,
    ask_admission: _ => w_admission_admitted(),
  )
}

// A WORK REQUEST AT THE DOOR, under a supplied ledger standing -- the arm the admission gate guards.
fn w_request_turn(admission: RemoteBuildDoorAdmission) -> RemoteBuildFrontDoorTurn {
  remote_build_serve_front_door_turn(
    host: w_serving_host(),
    serve_binary: w_bin,
    repo_root: w_repo,
    leg_ceiling: w_leg_ceiling,
    accept_instant: w_accept_instant,
    raw_command: Present { value: join([remote_build_protocol_word as String, " compile abc build"], "") },
    principal: w_principal_admitted(),
    ask_admission: _ => admission,
  )
}

// THE CLIENT'S OWN READING OF A PROBE ANSWER, applied to what the door would print for that ending. This
// is the pairing the route depends on and the one thing a narrowed probe must never break: an ending the
// client reads as "try the next host", never an absence (which reads as unreachable and costs the walk).
fn w_client_probe_reading(ending: RemoteBuildServeEnding) -> RemoteBuildProbe {
  match remote_build_serve_answer(ending: ending, text: "witness") {
    CliWirePrintable { bytes: bytes, exit: _ } =>
      remote_build_probe_from_exit(exit_code: remote_build_serve_exit_code(e: ending), stdout: bytes, stderr: "")
    CliWireUnprintable { cause: _ } => ProbeUnreachable { detail: "the answer could not be printed" }
  }
}

// ── THE PROBE, ANSWERED AT THE DOOR ───────────────────────────────────────────────────────────────

// An admitted principal makes the probe answer ready, and the client's reading of those exact bytes and
// that exact code is "send the request" -- the probe costs what a probe sees and still means what it meant.
test fn an_admitted_principal_answers_the_probe_ready_and_the_client_sends_the_request() -> Bool {
  count(remote_build_serving_hosts()) > 0
    && w_admitted(p: w_principal_admitted())
    && match w_turn(raw: Present { value: remote_build_probe_text as String }, principal: w_principal_admitted()) {
         FrontDoorAnswer { ending: ServeReady, detail: _ } => w_client_probe_reading(ending: ServeReady) == ProbeReady
         _ => false
       }
}

// THE MANAGER'S CONDITION, WITNESSED (clever-raven-401, 2026-11-25). A probe the door will not answer --
// here, a principal whose account does not hold its declared group -- comes back as ServeHostCannotServe,
// which the client reads as "this host is not serving, ask the next one". It must never arrive as an
// absence (unreachable), and it must never arrive as HostOutcomeUnknown, which STOPS the walk: a cheap
// probe miss turning into a dead walk is the failure this narrowing would otherwise have introduced.
test fn a_refused_principal_moves_the_request_on_and_never_stops_the_walk() -> Bool {
  match w_turn(raw: Present { value: remote_build_probe_text as String }, principal: w_principal_refused()) {
    FrontDoorAnswer { ending: ServeHostCannotServe, detail: d } =>
      detail_names_a_principal(d: d)
        && match remote_build_probe_answer(p: w_client_probe_reading(ending: ServeHostCannotServe)) {
             Present { value: HostCannotServe { detail: _ } } => true
             _ => false
           }
    _ => false
  }
}

// THE NARROWING ITSELF, ON ONE READING OF ONE FILE. This /etc/group keeps everything the probe checks --
// the uid, both declared supplementary groups, the ledger group held by its declared gid -- and drops the
// one fact the probe no longer reads: that the host's ledger service user is a member. The probe's half
// admits; the request path's gate refuses. And the ending that refusal produces for a REQUEST is the one
// that moves the walk on, not the one that stops it.
test fn the_ledger_membership_the_probe_no_longer_checks_still_refuses_the_request() -> Bool {
  let status = w_status(uid: fleet_posix_remote_build_user.uid, groups: join([to_string(value: fleet_posix_remote_build_user.uid), " ", to_string(value: fleet_posix_compute_ledger_group_gid)], ""))
  w_admitted(p: remote_build_serve_principal_account_of(status: status, group_file: w_group_file_without_ledger_member))
    && !w_admitted(p: remote_build_serve_principal_of(
         status: status,
         group_file: w_group_file_without_ledger_member,
         service_user: fleet_posix_operator_user.name,
       ))
    // and the request path's refusal is a typed "next host", never an unknown outcome.
    && match remote_build_answer_of_ending(ending: ServeHostCannotServe, body: "the ledger's service user is not a member", stderr: "") {
         HostCannotServe { detail: _ } => true
         _ => false
       }
}

// THE OTHER DIRECTION OF THE SAME PAIR, so the arm above is a measurement and not an accident of one
// file: put the membership back and the request path's gate admits too.
test fn the_ledger_membership_the_request_path_still_checks_admits_when_it_is_there() -> Bool {
  let status = w_status(uid: fleet_posix_remote_build_user.uid, groups: join([to_string(value: fleet_posix_remote_build_user.uid), " ", to_string(value: fleet_posix_compute_ledger_group_gid)], ""))
  w_admitted(p: remote_build_serve_principal_of(status: status, group_file: w_group_file, service_user: fleet_posix_operator_user.name))
    && !w_admitted(p: remote_build_serve_principal_account_of(status: w_status(uid: fleet_posix_operator_user.uid, groups: "1000 1006"), group_file: w_group_file))
}

// THE PROBE IS RECOGNIZED BY ITS WHOLE TEXT, and only by it. The client sends these exact words
// (gunbc.compute.remote_build_client remote_build_try_host splits remote_build_probe_text); anything
// that is not that text is a request and goes to the serving entry, which is the only place a request's
// grammar is judged.
test fn the_probe_is_recognized_by_its_whole_text() -> Bool {
  remote_build_leg_is_probe(raw: remote_build_probe_text as String)
    && remote_build_leg_is_probe(raw: concat(remote_build_probe_text as String, "  "))
    && !remote_build_leg_is_probe(raw: concat(remote_build_probe_text as String, " extra"))
    && !remote_build_leg_is_probe(raw: "remote-build-v1 probe-and-build")
    && !remote_build_leg_is_probe(raw: "")
    && match w_turn(raw: Present { value: "remote-build-v1 probe-and-build" }, principal: w_principal_admitted()) {
         FrontDoorHandOffToChild { hand_off: _ } => true
         _ => false
       }
}

// ── THE HAND-OFF ────────────────────────────────────────────────────────────────────────────────────

// A request is RUN, not interpreted: the door hands off to the serving entry, with the binary, the
// checkout and the words the authorized_keys line itself carries. The child is the REQUEST entry -- the
// ending vocabulary for a request has one author, and it is not this module.
test fn a_work_request_hands_off_to_the_serving_entry_with_the_forced_commands_words() -> Bool {
  match w_turn(
    raw: Present { value: join([remote_build_protocol_word as String, " compile 0123456789abcdef0123456789abcdef01234567 build claims"], "") },
    principal: w_principal_admitted(),
  ) {
    FrontDoorHandOffToChild { hand_off } =>
      hand_off.program as String == w_bin
        && hand_off.workdir as String == w_repo
        && any(hand_off.arguments, a => a == concat(w_repo, "/dag/gunbc/compute/remote_build_serve.dag"))
        && any(hand_off.arguments, a => a == "remote_build_serve_cli")
        && any(hand_off.arguments, a => a == concat("host=", w_serving_host()))
        // THE WALL BOUND RIDES TO THE CHILD: the door hands the host-declared ceiling and its own accept
        // instant to the request entry, which runs the granted unit under the remaining budget.
        && any(hand_off.arguments, a => a == concat("leg_ceiling=", w_leg_ceiling))
        && any(hand_off.arguments, a => a == concat("accept_instant=", w_accept_instant))
        // THE CHILD IS FIXED DATA, NOT SOMETHING THE DOOR WAS TOLD: the door's own words name the front
        // door; the hand-off names the request entry and nothing else.
        && !(any(hand_off.arguments, a => contains(haystack: a, needle: "front_door")))
    _ => false
  }
}

// THE CLIENT CANNOT AIM THE HAND-OFF. The request text is read only to recognize the probe; it never
// travels to the child, whose request arrives only as the inherited SSH_ORIGINAL_COMMAND sshd set.
test fn the_hand_off_names_nothing_the_client_could_have_written() -> Bool {
  let client_words = "0123456789abcdef0123456789abcdef01234567"
  match w_turn(
    raw: Present { value: join([remote_build_protocol_word as String, " compile ", client_words, " build"], "") },
    principal: w_principal_admitted(),
  ) {
    FrontDoorHandOffToChild { hand_off } => !(any(hand_off.arguments, a => contains(haystack: a, needle: client_words)))
    _ => false
  }
}

// ONE RENDERING, TWO CONSUMERS: the authorized_keys line and the hand-off come from the same projection
// of the same argv (gunbc.compute.remote_build_wire remote_build_run_words). If they could drift, a host
// would answer at one entry and run another.
test fn the_hand_off_and_the_request_legs_words_are_one_rendering() -> Bool {
  let hand_off = remote_build_serve_hand_off(
    serve_binary: w_bin as NonEmptyStr,
    repo_root: w_repo as NonEmptyStr,
    host: w_serving_host(),
    leg_ceiling: w_leg_ceiling as NonEmptyStr,
    accept_instant: w_accept_instant as NonEmptyStr,
  )
  let serve_words = map(remote_build_serve_run_words(serve_binary: w_bin as NonEmptyStr, repo_root: w_repo as NonEmptyStr, host: w_serving_host()), w => w as String)
  let door_words = map(remote_build_serve_front_door_run_words(serve_binary: w_bin as NonEmptyStr, repo_root: w_repo as NonEmptyStr, host: w_serving_host(), leg_ceiling: w_leg_ceiling as NonEmptyStr), w => w as String)
  hand_off.program as String == w_bin
    // The hand-off runs the request entry with the request leg's OWN words, then appends the host-declared
    // ceiling and the door's accept instant -- two words the client never sends, so an old client cannot
    // bypass the bound and the wait is measured from the host's own clock.
    && join(hand_off.arguments, "\n") == join(concat(skip(xs: serve_words, n: 1), ["--arg", concat("leg_ceiling=", w_leg_ceiling), "--arg", concat("accept_instant=", w_accept_instant)]), "\n")
    && any(door_words, w => w == "remote_build_serve_front_door_cli")
    && !any(door_words, w => w == "remote_build_serve_cli")
    && any(door_words, w => w == concat("serve_binary=", w_bin))
    && any(door_words, w => w == concat("repo_root=", w_repo))
    && any(door_words, w => w == concat("leg_ceiling=", w_leg_ceiling))
}

// ── WHAT THE DOOR REFUSES, AND HOW ────────────────────────────────────────────────────────────────

// Words that do not name the contract never reach the build binary, and an absent request is refused
// rather than answered as nothing. Both refusals carry a header, because the client's reading of an
// answer with no header is "this host did not run the contract" -- a door that went silent on a bad
// request would be indistinguishable from a wedged host.
test fn words_that_do_not_name_the_contract_are_refused_with_a_header() -> Bool {
  match w_turn(raw: Present { value: "ls -la /opt/gunbc" }, principal: w_principal_admitted()) {
    FrontDoorAnswer { ending: ServeRequestRefused, detail: _ } =>
      // THE REFUSAL CARRIES A HEADER THE CLIENT'S OWN READING FINDS, and it round-trips to the ending the
      // door decided on -- read through the ONE reading production uses, not a second recognizer.
      match remote_build_ending_of_answer(stdout: w_answer_bytes(ending: ServeRequestRefused)) {
        Present { value: ServeRequestRefused } => true
        _ => false
      }
        && match remote_build_answer_of_ending(ending: ServeRequestRefused, body: "witness", stderr: "") {
             HostRefusedRequest { detail: _ } => true
             _ => false
           }
    _ => false
  }
    && match w_turn(raw: Absent, principal: w_principal_admitted()) {
         FrontDoorAnswer { ending: ServeRequestRefused, detail: _ } => true
         _ => false
       }
}

// A HOST THE ROSTER DOES NOT SERVE is refused at the door, from the row the roster itself is built from
// (gunbc.compute.remote_build_hosts remote_build_serving_hosts) -- before any request entry runs. The
// ending is the one that moves the walk on.
test fn a_host_off_the_serving_row_is_refused_at_the_door() -> Bool {
  match remote_build_serve_front_door_turn(
    host: "not-a-serving-host",
    serve_binary: w_bin,
    repo_root: w_repo,
    leg_ceiling: w_leg_ceiling,
    accept_instant: w_accept_instant,
    raw_command: Present { value: remote_build_probe_text as String },
    principal: w_principal_admitted(),
    ask_admission: _ => w_admission_admitted(),
  ) {
    FrontDoorAnswer { ending: ServeHostCannotServe, detail: d } =>
      contains(haystack: d, needle: "not-a-serving-host")
        && match remote_build_probe_answer(p: w_client_probe_reading(ending: ServeHostCannotServe)) {
             Present { value: HostCannotServe { detail: _ } } => true
             _ => false
           }
    _ => false
  }
}

// A HAND-OFF THAT WAS NOT TOLD WHAT TO RUN runs nothing. The door may not guess a path.
test fn a_door_rendered_without_a_binary_or_a_checkout_runs_nothing() -> Bool {
  match w_turn(raw: Present { value: join([remote_build_protocol_word as String, " compile abc build"], "") }, principal: w_principal_admitted()) {
    FrontDoorHandOffToChild { hand_off: _ } => true
    _ => false
  }
    && match remote_build_serve_front_door_turn(host: w_serving_host(), serve_binary: "", repo_root: w_repo, leg_ceiling: w_leg_ceiling, accept_instant: w_accept_instant, raw_command: Present { value: remote_build_protocol_word as String }, principal: w_principal_admitted(), ask_admission: _ => w_admission_admitted()) {
         FrontDoorAnswer { ending: ServeHostCannotServe, detail: _ } => true
         _ => false
       }
    && match remote_build_serve_front_door_turn(host: w_serving_host(), serve_binary: "gunbc", repo_root: w_repo, leg_ceiling: w_leg_ceiling, accept_instant: w_accept_instant, raw_command: Present { value: remote_build_protocol_word as String }, principal: w_principal_admitted(), ask_admission: _ => w_admission_admitted()) {
         FrontDoorAnswer { ending: ServeHostCannotServe, detail: _ } => true
         _ => false
       }
}

// ── THE PRE-HAND-OFF ADMISSION (the gate that replaced the client-side probe) ─────────────────────
//
// WHY THESE CLAIMS EXIST. Before this gate the door handed off every request and the SERVING CHILD
// discovered at acquisition that the pool was full -- after booting a 150-module resolve that could
// OOM before it ever reached the ledger (srv3's pool-full class, gunbc.live_deploy.serving_child_
// observations). The gate asks the ledger's own charge scan BEFORE the boot. The red arms below are
// the two wrong directions: a full pool that still hands off (the OOM this closes), and an unreadable
// ledger that guesses headroom (gunbc.design_argument::fail_closed -- only the ledger knows whether an
// empty-looking pool is empty or unreadable).

// PASSING CONTROL: an admitted ledger hands off, exactly as the door did before the gate.
test fn an_admitted_ledger_hands_off() -> Bool {
  match w_request_turn(admission: w_admission_admitted()) {
    FrontDoorHandOffToChild { hand_off: _ } => true
    _ => false
  }
}

// RED: A FULL SEAT POOL REFUSES THE HAND-OFF, in the ONE capacity vocabulary the request path also
// mints -- the room/readiness ending that MOVES THE WALK ON, the declared retry allowance readable
// by the client's own reader, and the seat counts named. Never a hand-off, never a request's-fault
// refusal.
test fn a_full_seat_pool_refuses_the_hand_off_with_the_capacity_vocabulary() -> Bool {
  match w_request_turn(admission: DoorPoolFull { held: 2, seats: 2 }) {
    FrontDoorAnswer { ending: ServeHostFull, detail: detail } =>
      contains(haystack: detail, needle: remote_build_retry_after_word as String)
        && contains(haystack: detail, needle: "seat pool is full")
        && contains(haystack: detail, needle: "2 of 2")
        // The client reads this answer as capacity-full AND moves on: the walk is not stopped by a
        // host that is merely full.
        && match remote_build_answer_of_ending(ending: ServeHostFull, body: detail, stderr: "") {
             HostCapacityFull { detail: _, retry: RetryHintDelay { delay: delay } } =>
               second_count(s: delay) == second_count(s: remote_build_capacity_retry_floor)
               && remote_build_answer_moves_on(a: remote_build_answer_of_ending(ending: ServeHostFull, body: detail, stderr: ""))
             _ => false
           }
        // The allowance round-trips through the ONE body reader, not a second recognizer.
        && match remote_build_retry_hint_of_body(body: detail) {
             RetryHintDelay { delay: _ } => true
             _ => false
           }
    _ => false
  }
}

// RED: A LEDGER THE DOOR CANNOT READ REFUSES THE HAND-OFF rather than guessing headroom. The ending
// is the room/readiness class -- the request moves to the next host; a guess here is what booted the
// pile-up that OOMed.
test fn an_unreadable_seat_ledger_refuses_the_hand_off() -> Bool {
  match w_request_turn(admission: DoorLedgerUnreadable { detail: "the seat charge scan could not be read" }) {
    FrontDoorAnswer { ending: ServeHostCannotServe, detail: detail } =>
      contains(haystack: detail, needle: "the seat charge scan could not be read")
        && match remote_build_answer_of_ending(ending: ServeHostCannotServe, body: detail, stderr: "") {
             HostCannotServe { detail: _ } => remote_build_answer_moves_on(a: remote_build_answer_of_ending(ending: ServeHostCannotServe, body: detail, stderr: ""))
             _ => false
           }
    _ => false
  }
}

// RED: AN UNRESOLVABLE CAPACITY SUBJECT (no capacity home for this host) refuses the hand-off for
// the same reason -- with no subject there is no ledger, and no ledger means no admission.
test fn an_unresolvable_capacity_subject_refuses_the_hand_off() -> Bool {
  match w_request_turn(admission: DoorSubjectUnresolved { detail: "host srv-test has no capacity home" }) {
    FrontDoorAnswer { ending: ServeHostCannotServe, detail: detail } =>
      contains(haystack: detail, needle: "capacity home")
    _ => false
  }
}

// RED CONTROL FOR THE LAZY GATE (review 99441): THE PROBE ARM NEVER ASKS THE LEDGER. A poison
// thunk -- a ledger standing that would refuse any hand-off -- is supplied where the probe arm runs.
// The probe does not consult it and still answers ready. Were the ledger read eager again, or the
// gate moved above the probe arm, the poison would mint host_full for a probe and this claim goes
// red. (gunbc.design_argument::demand_before_materialization -- the probe pays for the probe.)
test fn a_probe_never_asks_the_ledger() -> Bool {
  match remote_build_serve_front_door_turn(
    host: w_serving_host(), serve_binary: w_bin, repo_root: w_repo, leg_ceiling: w_leg_ceiling,
    accept_instant: w_accept_instant,
    raw_command: Present { value: remote_build_probe_text as String },
    principal: w_principal_admitted(),
    ask_admission: _ => DoorPoolFull { held: 9, seats: 2 },
  ) {
    FrontDoorAnswer { ending: ServeReady, detail: _ } => true
    _ => false
  }
}

// THE RENDERER TRAP: A CONTRACT-LEGAL READY EXITS NON-ZERO. The exit law gives ServeReady the code 6
// -- non-zero -- so whatever prints the leg's exit renders it like a failure (the "✗ (exit=6)" line an
// operator read as a dead host on 2026-11-27 while the walk was healthy). The law, not the rendering,
// decides: those same bytes and that same code are, to the client's one reading, a ready. If the exit
// law ever moves ServeReady, this claim is the red that says so.
test fn a_contract_legal_ready_exits_six_and_the_client_still_reads_it_ready() -> Bool {
  remote_build_serve_exit_code(e: ServeReady) == 6
    && match w_client_probe_reading(ending: ServeReady) {
         ProbeReady => true
         _ => false
       }
}

// ── THE ANSWER'S BYTES ──────────────────────────────────────────────────────────────────────────────

// A RECEIPT GOES OUT BYTE-EXACT; everywhere else the child's stderr is kept, because it is the only
// account of what happened. This is the one loss the two-process door pays (no stdio-inheriting seam
// exists in this repository's tool vocabulary), and it is bounded to the case where nothing is decided
// on the text.
test fn a_receipt_goes_out_byte_exact_and_a_refusal_keeps_its_stderr() -> Bool {
  let served = join([remote_build_serve_header(e: ServeServed), "\n{\"ok\":true}"], "")
  let refused = join([remote_build_serve_header(e: ServeRequestRefused), "\nthe claims are not admitted"], "")
  let empty = ""
  !remote_build_answer_body_is_a_receipt(stdout: refused)
    && remote_build_answer_body_is_a_receipt(stdout: served)
    && remote_build_answer_body_is_a_receipt(stdout: join([remote_build_serve_header(e: ServeWorkInFlight), "\n{}"], ""))
    && remote_build_answer_body_is_a_receipt(stdout: join([remote_build_serve_header(e: ServeWorkEndedUnsuccessfully), "\n{}"], ""))
    && !remote_build_answer_body_is_a_receipt(stdout: empty)
    // THE SAME READING THE CLIENT READS AN ANSWER WITH, on the same bytes: no header is no ending, and a
    // receipt header is that ending. (Before this the witness checked a Bool the door did not use; the
    // review that caught it is the point -- evidence must be about the interface production runs.)
    && match remote_build_ending_of_answer(stdout: empty) { Absent => true  _ => false }
    && match remote_build_ending_of_answer(stdout: served) {
         Present { value: ServeServed } => true
         _ => false
       }
}

// ── THE CLOSURE LEDGER: what the probe entry may read ─────────────────────────────────────────────

// THE COST CLAIM, STRUCTURAL. The probe entry may not import the request path: not the roster, not the
// provider, not the capacity ledger, not the dashboard instance the instance record lives in, not git,
// not systemd, not ssh. THE SAME READING OVER THE ENTRY THIS DOOR EXISTS TO KEEP OUT FINDS THEM, which
// is what makes the green arms measurements rather than vacuous passes (the four-arm shape of
// test.claim.import_admission_closure_membership_witness: a claim that cannot go red on its own
// proposition proves nothing).
test fn the_probe_entry_imports_none_of_the_request_path() -> Bool {
  let door = w_import_lines(path: "dag/gunbc/compute/remote_build_serve_front_door.dag")
  let request_entry = w_import_lines(path: "dag/gunbc/compute/remote_build_serve.dag")
    // THE INSTRUMENT IS READ: an empty reading would satisfy every arm below.
  if count(door) == 0 || count(request_entry) == 0 { return false }
  let forbidden = w_forbidden_probe_imports()
  forbidden |> all(m => !(door |> any(l => contains(haystack: l, needle: m))))
    && forbidden |> any(m => (request_entry |> any(l => contains(haystack: l, needle: m))))
      // and the door reads the leaves it is made of: the wire's answer mint, the principal leaf, the
      // capacity ledger (the PRE-HAND-OFF ADMISSION asks the ledger directly -- it may not route the
      // admission through the request module, which would re-widen the closure to exactly what this
      // claim keeps out) and the systemd property leaf (the hand-off's slice diagnostic).
    && (door |> any(l => contains(haystack: l, needle: "gunbc.compute.remote_build_wire")))
    && (door |> any(l => contains(haystack: l, needle: "gunbc.compute.remote_build_serve_principal {")))
    && (door |> any(l => contains(haystack: l, needle: "gunbc.compute.host_capacity {")))
    && (door |> any(l => contains(haystack: l, needle: "extdeps.linux.cgroup_v2_memory {")))
      // it is not a second authority for anything: it never imports the serving entry or the client.
      // (The roster's serving-instance mint it DOES import comes from the roster module -- the same
      // mint the request path uses, which is why the admission and the request describe one host.)
    && !(door |> any(l => contains(haystack: l, needle: "gunbc.compute.remote_build_serve {")))
    && !(door |> any(l => contains(haystack: l, needle: "gunbc.compute.remote_build_client")))
}

// "READY" HAS ONE AUTHOR, AND IT IS NOT THE REQUEST ENTRY. The client reads a ready probe as the licence
// to send work, so the entry that mints it must be the entry whose closure stops at the probe. A host
// whose authorized_keys still names the request entry is a host that has not converged the door, and it
// answers ServeHostCannotServe -- which moves the walk on -- rather than pretending to be ready.
test fn the_request_entry_never_mints_ready() -> Bool {
  let door = w_source(path: "dag/gunbc/compute/remote_build_serve_front_door.dag")
  let request_entry = w_source(path: "dag/gunbc/compute/remote_build_serve.dag")
  contains(haystack: door, needle: "ending: ServeReady")
    && !contains(haystack: request_entry, needle: "ending: ServeReady")
    && contains(haystack: request_entry, needle: "remote_build_leg_is_probe")
    && contains(haystack: request_entry, needle: "the probe is answered by the front door")
      // one recognizer, in the leaf both ends read.
    && contains(haystack: w_source(path: "dag/gunbc/compute/remote_build_wire.dag"), needle: "fn remote_build_leg_is_probe")
}

// ── the readings the claims above decide on ───────────────────────────────────────────────────────

fn w_admitted(p: RemoteBuildServePrincipal) -> Bool {
  match p {
    RemoteBuildServePrincipalAdmitted => true
    RemoteBuildServePrincipalRefused { reason: _ } => false
  }
}

fn detail_names_a_principal(d: String) -> Bool {
  contains(haystack: d, needle: "group")
}

fn w_answer_bytes(ending: RemoteBuildServeEnding) -> String {
  match remote_build_serve_answer(ending: ending, text: "witness") {
    CliWirePrintable { bytes: bytes, exit: _ } => bytes
    CliWireUnprintable { cause: _ } => ""
  }
}

// THE IMPORT LINES ONLY. Comments in these modules NAME the modules they keep out -- this door's own
// header cites the roster, the provider and the ledger to explain the cut -- so a substring reading of
// the whole file would judge prose. Import lines are what decides a closure.
fn w_import_lines(path: String) -> List<String> {
  w_source_lines(path: path) |> filter(l => starts_with(s: l, prefix: "import "))
}

fn w_source_lines(path: String) -> List<String> {
  let read = Filesystem.Read(path: path)
  if !read.success { return [] }
  split(s: read.content, delimiter: "\n")
}

fn w_source(path: String) -> String {
  let read = Filesystem.Read(path: path)
  if !read.success { return "" }
  read.content
}

// THE REQUEST PATH, BY NAME. Each of these is a module a probe has no business resolving: the roster and
// its instance record, the provider and its seat machinery, the capacity ledger, git, systemd, ssh.
fn w_forbidden_probe_imports() -> List<String> {
  [
    "gunbc.compute.work_provider_local",
    "gunbc.compute.work_provider",
    "gunbc.compute.work_request",
    "gunbc.compute.attempt_lifecycle",
    "gunbc.roadmap.roadmap_dashboard_instance",
    "gunbc.host.host_effect",
    "gunbc.systemctl_show_read",
    "extdeps.git",
    "extdeps.ssh.",
    "gunbc.compute.remote_build_serving_setup",
    "gunbc.fleet.fleet_known_hosts_anchor",
  ]
}

// ── THE DOOR ────────────────────────────────────────────────────────────────────────────────────────
//
// WHY AN AGGREGATE ENTRY, AND WHY THE ROSTER CLAIM BELOW IS NOT DEBT. Some claims here reach a real
// Filesystem.Read (the import-line claims read the door's own source), so they ride no hermetic lane
// that fakes the read -- an aggregate entry run with --function is how they get run, and the posted
// manual receipt is the evidence (the schedule has no runner for them today). The roster is a call
// list, which the module cannot enumerate at runtime; THE IDENTITY JOIN CLAIM makes the second copy
// honest: it reads this module's own source and refuses when the set of `test fn` declarations and
// the set of rostered calls disagree in either direction (gunbc.design_argument::fail_closed:
// completeness is an identity join, not a count equality; gunbc.design_argument::single_authority).
// The one deletion the join cannot catch from inside is deleting THIS claim with its roster line --
// that deletion is itself a roster/declaration disagreement the next CI pass surfaces as a missing
// claim, and the wet schedule rows that run this module name claims by hand besides.


// THE DOOR'S OOM EVIDENCE READS THE NESTED SLICE CGROUP DIR (review 99502). A dashed slice is
// nested under its ancestors by systemd; a flat path would make both reads refuse in exactly the
// headerless-death case the diagnostic exists for. The nesting rule has ONE home -- the door must
// borrow extdeps.systemd's, not re-derive it, and the rendered path must be the nested one.
test fn the_diagnostic_borrows_the_nested_slice_path_from_systemd() -> Bool {
  let src = Filesystem.Read(path: "dag/gunbc/compute/remote_build_serve_front_door.dag")
  if !src.success { return false }
  let uses_home = string_contains(s: src.content, pattern: "systemd_slice_cgroup_path(mount_point: cgroup_v2_mount_point, slice: unit)")
  let no_fork = !string_contains(s: src.content, pattern: "cgroup_v2_child_path(parent: cgroup_v2_mount_point, child: unit)")
  let nested = match systemd_slice_cgroup_path(mount_point: cgroup_v2_mount_point, slice: serving_child_slice_unit_name) {
    SliceCgroupPath { path: p } => (p as String) == "/sys/fs/cgroup/gunbc.slice/gunbc-user.slice/gunbc-user-work.slice"
    SliceNameNotASlice { spelling: _ } => false
  }
  uses_home && no_fork && nested
}

fn door_source_lines() -> List<String> {
  let src = Filesystem.Read(path: "dag/test/claim/compute/remote_build_serve_front_door_witness.dag")
  if !src.success { return [] }
  return split(s: src.content, delimiter: "\n")
}

fn door_test_fn_name(line: String) -> String {
  let t = trim(line)
  if !starts_with(s: t, prefix: "test fn ") { return "" }
  let after = substring(s: t, start: length("test fn "), end: length(t))
  let parts: List<String> = split(s: after, delimiter: "(")
  return match parts |> first { Present { value: v } => v  Absent => "" }
}

fn door_roster_name(line: String) -> String {
  let t = trim(line)
  if !starts_with(s: t, prefix: "check_or_name(name: \"") { return "" }
  let parts: List<String> = split(s: t, delimiter: "\"")
  return match parts |> skip(n: 1) |> first { Present { value: v } => v  Absent => "" }
}

// THE JOIN BOTH WAYS: every declaration called, every call a declaration. Add a claim without
// rostering it, roster a name that is not a claim, or rename either side, and THIS goes red.
test fn the_door_roster_lists_every_test_fn_and_nothing_else() -> Bool {
  let lines = door_source_lines()
  let fns = filter(map(lines, door_test_fn_name), n => n != "")
  let rostered = filter(map(lines, door_roster_name), n => n != "")
  length(fns) > 0
    && !any(fns, n => first_where(rostered, r => r == n) == Absent)
    && !any(rostered, r => first_where(fns, n => n == r) == Absent)
}

fn check_or_name(name: String, held: Bool) -> String {
  if held { return "" }
  return concat(name, "\n")
}

fn run_remote_build_serve_front_door_witness() -> ProcessExit {
  let red = join([
    check_or_name(name: "the_door_roster_lists_every_test_fn_and_nothing_else", held: the_door_roster_lists_every_test_fn_and_nothing_else()),
    check_or_name(name: "the_diagnostic_borrows_the_nested_slice_path_from_systemd", held: the_diagnostic_borrows_the_nested_slice_path_from_systemd()),
    check_or_name(name: "an_admitted_principal_answers_the_probe_ready_and_the_client_sends_the_request", held: an_admitted_principal_answers_the_probe_ready_and_the_client_sends_the_request()),
    check_or_name(name: "a_refused_principal_moves_the_request_on_and_never_stops_the_walk", held: a_refused_principal_moves_the_request_on_and_never_stops_the_walk()),
    check_or_name(name: "the_ledger_membership_the_probe_no_longer_checks_still_refuses_the_request", held: the_ledger_membership_the_probe_no_longer_checks_still_refuses_the_request()),
    check_or_name(name: "the_ledger_membership_the_request_path_still_checks_admits_when_it_is_there", held: the_ledger_membership_the_request_path_still_checks_admits_when_it_is_there()),
    check_or_name(name: "the_probe_is_recognized_by_its_whole_text", held: the_probe_is_recognized_by_its_whole_text()),
    check_or_name(name: "a_work_request_hands_off_to_the_serving_entry_with_the_forced_commands_words", held: a_work_request_hands_off_to_the_serving_entry_with_the_forced_commands_words()),
    check_or_name(name: "the_hand_off_names_nothing_the_client_could_have_written", held: the_hand_off_names_nothing_the_client_could_have_written()),
    check_or_name(name: "the_hand_off_and_the_request_legs_words_are_one_rendering", held: the_hand_off_and_the_request_legs_words_are_one_rendering()),
    check_or_name(name: "words_that_do_not_name_the_contract_are_refused_with_a_header", held: words_that_do_not_name_the_contract_are_refused_with_a_header()),
    check_or_name(name: "a_host_off_the_serving_row_is_refused_at_the_door", held: a_host_off_the_serving_row_is_refused_at_the_door()),
    check_or_name(name: "a_door_rendered_without_a_binary_or_a_checkout_runs_nothing", held: a_door_rendered_without_a_binary_or_a_checkout_runs_nothing()),
    check_or_name(name: "an_admitted_ledger_hands_off", held: an_admitted_ledger_hands_off()),
    check_or_name(name: "a_full_seat_pool_refuses_the_hand_off_with_the_capacity_vocabulary", held: a_full_seat_pool_refuses_the_hand_off_with_the_capacity_vocabulary()),
    check_or_name(name: "an_unreadable_seat_ledger_refuses_the_hand_off", held: an_unreadable_seat_ledger_refuses_the_hand_off()),
    check_or_name(name: "an_unresolvable_capacity_subject_refuses_the_hand_off", held: an_unresolvable_capacity_subject_refuses_the_hand_off()),
    check_or_name(name: "a_probe_never_asks_the_ledger", held: a_probe_never_asks_the_ledger()),
    check_or_name(name: "a_contract_legal_ready_exits_six_and_the_client_still_reads_it_ready", held: a_contract_legal_ready_exits_six_and_the_client_still_reads_it_ready()),
    check_or_name(name: "a_receipt_goes_out_byte_exact_and_a_refusal_keeps_its_stderr", held: a_receipt_goes_out_byte_exact_and_a_refusal_keeps_its_stderr()),
    check_or_name(name: "the_probe_entry_imports_none_of_the_request_path", held: the_probe_entry_imports_none_of_the_request_path()),
    check_or_name(name: "the_request_entry_never_mints_ready", held: the_request_entry_never_mints_ready()),
  ], "")
  if red == "" {
    ExitSuccess {}
  } else {
    ExitFailure { code: 1, reason: concat("remote_build_serve_front_door_witness claims red: ", red) }
  }
}
