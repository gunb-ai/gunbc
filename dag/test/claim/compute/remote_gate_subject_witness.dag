  emitted_subject_v2_native_cli_step_id, EmittedSubjectBuildRow, EmittedSubjectRowLookup,
  EmittedSubjectNoRow, EmittedSubjectOneRow, EmittedSubjectDuplicateRows, native_step_memory_inputs,
