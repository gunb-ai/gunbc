  opened(root: root, reference: "r-lg", owner: dispatch_owner())
    && reserved(subject: subject, reference: "r-lg")
    && launching(root: root, reference: "r-lg")
    && lease_written(root: root, content: "deadbeef 1800\n")
    && ensured(o: ensure(root: root, reference: "r-lg", source: ended()), check: is_refused)
    && lease_listed(root: root)
    && committed(subject: subject) == 0
