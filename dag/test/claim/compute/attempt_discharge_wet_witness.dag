    && launching(root: root, reference: "r-oa")
    && ensured(o: ensure(root: root, reference: "r-oa", source: ended()), check: is_released)
    && lease_written(root: root, content: join([compute_seat_holder_line(instance: instance_at(root: root), seat: ComputeDispatchSeat { attempt_key: "key-b" }), "abc 1\n"], ""))
    && ensured(o: ensure(root: root, reference: "r-oa", source: ended()), check: is_noop)
