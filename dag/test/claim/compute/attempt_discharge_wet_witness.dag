// A LISTING THAT CANNOT BE READ IS NOT "NO LIVE SEATS": the pass refuses.
test fn a_driver_refuses_the_pass_when_the_attempts_directory_cannot_be_listed() -> Bool {
  let root = fresh_root()
  let ok = a_driver_refuses_the_pass_when_the_attempts_directory_cannot_be_listed_cell(root: root)
  let removed = shell.Remove.RecursiveForce(path: root)
  ok && removed.success
}

fn a_driver_refuses_the_pass_when_the_attempts_directory_cannot_be_listed_cell(root: String) -> Bool {
  match compute_seat_discharge_all(instance: instance_at(root: absent_of(root: root)), leases_dir: leases_at(root: root), subject: subject_at(root: root), source: ended()) {
    SeatDischargeRefused { reason: _ } => true
    SeatDischargeRan { outcomes: _ } => false
    SeatDischargeSkipped { why: _ } => false
  }
}

// A WHOLE-PASS REFUSAL IS NOT A REFUSAL OF ONE UNNAMED SEAT: it keeps its own standing and its cause.
test fn a_refused_pass_is_its_own_standing_not_a_seat_refusal() -> Bool {
  match seat_discharge_pass_standing(p: SeatDischargeRefused { reason: "attempts unreadable" }) {
    SeatDischargePassRefused { reason: r } => r == "attempts unreadable"
    _ => false
  }
}

fn retried(root: String, first: AttemptGate) -> AttemptGate {
  compute_open_retry_attempt(instance: instance_at(root: root), identity: "feedfacefeedface", reference: "r-a#2" as NonEmptyStr, granted: kibibyte(count: granted_kib), first: first)
}

// A CEILING RETRY INHERITS THE FIRST ATTEMPT'S RECORDED OWNER OR IS REFUSED: it never mints one.
test fn a_ceiling_retry_inherits_the_recorded_owner_and_is_refused_without_one() -> Bool {
  let root = fresh_root()
  let ok = a_ceiling_retry_inherits_the_recorded_owner_and_is_refused_without_one_cell(root: root)
  let removed = shell.Remove.RecursiveForce(path: root)
  ok && removed.success
}

fn a_ceiling_retry_inherits_the_recorded_owner_and_is_refused_without_one_cell(root: String) -> Bool {
  let first = AttemptGateReady { record: record_of(reference: "r-a", state: AttemptReserved, owner: dispatch_owner()), generation: cas_generation_first() }
  let inherited = made(path: attempts_at(root: root) as String) && match retried(root: root, first: first) {
    AttemptGateReady { record: r, generation: _ } => match r.owner {
      DispatchOwned { node_id: _, attempt_key: k } => k == "key-a"
      _ => false
    }
    AttemptGateRefused { detail: _ } => false
  }
  let refused = match retried(root: root, first: AttemptGateRefused { detail: "first gate never opened" }) {
    AttemptGateRefused { detail: _ } => true
    AttemptGateReady { record: _, generation: _ } => false
  }
  inherited && refused
}

fn minted_reference(root: String, key: String) -> String {
  match compute_open_attempt_minted(instance: instance_at(root: root), identity: "feedfacefeedface", granted: kibibyte(count: granted_kib), owner: DispatchOwned { node_id: "node-a", attempt_key: key }, ordinal: 1) {
    AttemptGateReady { record: r, generation: _ } => r.reference as String
    AttemptGateRefused { detail: _ } => ""
  }
}

fn reserved_and_released(subject: ComputeCapacitySubject, reference: String) -> Bool {
  let r = compute_reserve_against(subject: subject, reference: reference as NonEmptyStr, term_seconds: 60, total: supplied_host, available: supplied_host)
  match r {
    ComputeReserved { parent_partition: _, grant: _, partition: _, amount: _, store: _ } => match compute_release(reservation: r, reason: "control release" as NonEmptyStr) {
      ComputeReleased { partition: _, reference: _, reason: _ } => true
      _ => false
    }
    _ => false
  }
}

// A REFERENCE IS UNIQUE IN THE LEDGER'S NAMESPACE, NOT ONLY IN ONE SEAT DIRECTORY: the ledger keeps a
// released reference forever, so a second dispatch attempt of the SAME work identity -- its own seat
// directory, its own ordinal 1 -- must still be admitted after the first reserved and released.
test fn a_second_dispatch_attempt_of_one_work_identity_is_admitted_after_the_first_released() -> Bool {
  let root = fresh_root()
  let ok = a_second_dispatch_attempt_of_one_work_identity_is_admitted_after_the_first_released_cell(root: root)
  let removed = shell.Remove.RecursiveForce(path: root)
  ok && removed.success
}

fn a_second_dispatch_attempt_of_one_work_identity_is_admitted_after_the_first_released_cell(root: String) -> Bool {
  let subject = subject_at(root: root)
  let ref_a = made(path: seat_dir_of(root: root, key: "key-a") as String) && made(path: seat_dir_of(root: root, key: "key-b") as String)
  let a = minted_reference(root: root, key: "key-a")
  let b = minted_reference(root: root, key: "key-b")
  ref_a && a != "" && b != "" && reserved_and_released(subject: subject, reference: a) && reserved_and_released(subject: subject, reference: b) && a != b
}

// THE OPERATOR DOOR FINDS A DISPATCH-OWNED SEAT. The belt's seats live under attempts/dispatch-<key>/;
// a door that read only the flat attempts root could not see them. The resolver returns exactly the
// directory holding a slot for the reference, nothing for a reference no slot names, and REFUSES (does
// not read as "none") when the attempts directory cannot be listed.
test fn the_operator_door_resolves_a_dispatch_owned_seat_and_refuses_an_unreadable_attempts_directory() -> Bool {
  let root = fresh_root()
  let ok = the_operator_door_resolves_a_dispatch_owned_seat_and_refuses_an_unreadable_attempts_directory_cell(root: root)
  let removed = shell.Remove.RecursiveForce(path: root)
  ok && removed.success
}

fn the_operator_door_resolves_a_dispatch_owned_seat_and_refuses_an_unreadable_attempts_directory_cell(root: String) -> Bool {
  let made_dirs = made(path: seat_dir_of(root: root, key: "key-a") as String) && made(path: seat_dir_of(root: root, key: "key-b") as String)
  let a = minted_reference(root: root, key: "key-a")
  let found = made_dirs && a != "" && match compute_recover_seats(instance: instance_at(root: root), reference: a as NonEmptyStr) {
    RecoverSeatsFound { holders: hs } => count(hs) == 1 && all(hs, h => match h.seat { ComputeDispatchSeat { attempt_key: k } => k == "key-a"  _ => false })
    RecoverSeatsUnreadable { reason: _ } => false
  }
  let nothing = match compute_recover_seats(instance: instance_at(root: root), reference: "no-such#1" as NonEmptyStr) {
    RecoverSeatsFound { holders: hs } => count(hs) == 0
    RecoverSeatsUnreadable { reason: _ } => false
  }
  let refused = match compute_recover_seats(instance: instance_at(root: absent_of(root: root)), reference: a as NonEmptyStr) {
    RecoverSeatsUnreadable { reason: _ } => true
    RecoverSeatsFound { holders: _ } => false
  }
  found && nothing && refused
}

fn absent_of(root: String) -> String {
  join([root, "/absent"], "")
}
