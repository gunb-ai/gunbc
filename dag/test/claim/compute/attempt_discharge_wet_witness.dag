// KILL-AT-EACH-TRANSITION CONTROLS FOR THE COMPUTE SEAT (gunbc.recurring_failure_mode
// a_held_compute_seat_has_no_in_corpus_discharge). Every cell builds the state a process killed at one
// transition leaves behind -- in a real temporary store, through the real attempt slot and the real
// capacity ledger -- and then asks the one discharge door (compute_recover_attempt_in) through the
// ensure what becomes of the seat. The unit's lifecycle is SUPPLIED (a unit is not available in a
// tempdir); the supplied value is one the real observation produces, and the route is the door's.
//
// open -> reserve -> unit start -> unit end -> settle -> release are the transitions. A kill after
// each one leaves: no seat | seat held, attempt Reserved | seat held, attempt Launching | seat held,
// unit ended | seat held, attempt terminal. The seat is only ever held, never lost; the ensure returns
// it once the owner is proven ended and keeps it otherwise.
//
// THIS FILE RUNS ON THE LOCAL-REPO WET LANE: rows in local_repo_wet_terminal, floor_route_gap (chunk
// 21, the identities that reach fresh_root()) and ci_layer_roots witness_exclusion_frontier.

data granted_kib: Int = 1048576
data supplied_host: Kibibyte = kibibyte(count: 67108864)

fn fresh_root() -> String {
  shell.Mktemp.DirWithTemplate(template: "/tmp/gunbc_seat_discharge.XXXXXX").path
}

fn subject_at(root: String) -> ComputeCapacitySubject {
  ComputeCapacitySubject {
    root: join([trim(s: root), "/capacity"], "") as NonEmptyStr,
    partition: "compute-seat-discharge-wet-witness" as PartitionId,
    appropriation: kibibyte(count: granted_kib * 4),
    parent_partition: "fixture-parent-memory" as PartitionId,
    parent_appropriation: kibibyte(count: granted_kib * 4),
    request: kibibyte(count: granted_kib),
  }
}

// THE SEAT LOCATION FOLLOWS THE OWNER: the dispatch attempt's slot store is its own directory. The stores are
// the production mint (gunbc.compute.compute_attempt_slots_root compute_seat_store) over an instance rooted in
// the witness's own directory, so every step reads a store minted from a real observation of its seat.
fn instance_at(root: String) -> HostDashboardInstance {
  isolated_dashboard_instance(
    deployment: deployment_id(name: "seat-discharge-wet" as NonEmptyStr),
    instance_id: "seat-discharge-wet" as NonEmptyStr,
    layout: srv1_host_layout(),
    root: root as FilePath,
    serve_function: "roadmap_serve_handle_srv1_lab" as NonEmptyStr,
    listen_port: 18097,
    source_anchor_ref: "refs/heads/main" as NonEmptyStr,
    actuation: DashboardActuating,
    provision_transport: DashboardLocalProvision,
  )
}

fn attempts_at(root: String) -> NonEmptyStr {
  seat_dir_of(root: root, key: "key-a")
}

fn seat_dir_of(root: String, key: String) -> NonEmptyStr {
  compute_seat_path(instance: instance_at(root: root), seat: ComputeDispatchSeat { attempt_key: key })
}

fn seat_at(root: String, key: String) -> ComputeSeatStore? {
  match compute_seat_store(instance: instance_at(root: root), seat: ComputeDispatchSeat { attempt_key: key }) {
    ComputeSeatStoreReady { store } => Present { value: store }
    ComputeSeatStoreUnready { detail: _ } => none
  }
}

// A seat whose store the mint refuses answers false, so no control reads an unready store as green.
fn with_seat(root: String, key: String, f: fn(SlotStore) -> Bool) -> Bool {
  match seat_at(root: root, key: key) {
    Absent => false
    Present { value: seat } => f(seat.slots)
  }
}

fn made(path: String) -> Bool {
  shell.Mkdir.Parents(path: path).success
}

// A REAL EXIT-SPOOL ENTRY, written the way the spool writes it: the entry's directory NAME is the record
// (roadmap_attempt_exit_spool's own seven-part codec), placed in a stage directory.
fn exit_recorded(root: String, key: String) -> Bool {
  made(path: attempt_exit_spool_stage_dir(instance_root: root, stage: AttemptExitInbox))
    && made(path: attempt_exit_spool_stage_dir(instance_root: root, stage: AttemptExitQueued))
    && made(path: attempt_exit_spool_stage_dir(instance_root: root, stage: AttemptExitRunning))
    && made(path: attempt_exit_spool_stage_dir(instance_root: root, stage: AttemptExitRefused))
    && made(path: join([attempt_exit_spool_stage_dir(instance_root: root, stage: AttemptExitDone), "/node-a+", key, "+worker+0123456789abcdef0123456789abcdef+success+exited+0"], ""))
}

fn spool_unrecorded(root: String) -> Bool {
  made(path: attempt_exit_spool_stage_dir(instance_root: root, stage: AttemptExitInbox))
    && made(path: attempt_exit_spool_stage_dir(instance_root: root, stage: AttemptExitQueued))
    && made(path: attempt_exit_spool_stage_dir(instance_root: root, stage: AttemptExitRunning))
    && made(path: attempt_exit_spool_stage_dir(instance_root: root, stage: AttemptExitDone))
    && made(path: attempt_exit_spool_stage_dir(instance_root: root, stage: AttemptExitRefused))
}

fn record_of(reference: String, state: AttemptState, owner: AttemptOwner) -> AttemptRecord {
  AttemptRecord {
    identity: "feedfacefeedface",
    reference: reference,
    unit: join(["gunbc-compute-feedfacefeedface-", reference], ""),
    granted: kibibyte(count: granted_kib),
    opened_at: 1800,
    launch_deadline: 2000,
    state: state,
    owner: owner,
  }
}

fn dispatch_owner() -> AttemptOwner {
  DispatchOwned { node_id: "node-a", attempt_key: "key-a" }
}

fn reserved(subject: ComputeCapacitySubject, reference: String) -> Bool {
  match compute_reserve_against(subject: subject, reference: reference as NonEmptyStr, term_seconds: 60, total: supplied_host, available: supplied_host) {
    ComputeReserved { parent_partition: _, grant: _, partition: _, amount: _, store: _ } => true
    _ => false
  }
}

fn committed(subject: ComputeCapacitySubject) -> Int {
  match compute_capacity_standing_on(subject: subject) {
    ComputeCapacityStandingRead { committed: c, ceiling: _, headroom: _, observed_available: _, observed_total: _ } => kibibyte_count(k: c)
    ComputeCapacityStandingUnread { detail: _ } => 0 - 1
  }
}

fn opened(root: String, reference: String, owner: AttemptOwner) -> Bool {
  made(path: attempts_at(root: root) as String) && with_seat(root: root, key: "key-a", f: slots => match attempt_open(store: slots, record: record_of(reference: reference, state: AttemptReserved, owner: owner)) {
    AttemptAdvanced { state: _, generation: _ } => true
    _ => false
  })
}

fn launching(root: String, reference: String) -> Bool {
  launching_in(root: root, key: "key-a", reference: reference)
}

fn launching_in(root: String, key: String, reference: String) -> Bool {
  with_seat(root: root, key: key, f: slots => match attempt_slot_read(store: slots, reference: reference as NonEmptyStr) {
    AttemptSlotHeld { record: rec, generation: g } =>
      match attempt_begin_launch(store: slots, reference: rec.reference as NonEmptyStr, expected: g) {
        AttemptAdvanced { state: _, generation: _ } => true
        _ => false
      }
    _ => false
  })
}

fn ended() -> UnitLifecycleSource {
  SuppliedUnitLifecycle { lifecycle: UnitTerminatedSuccess { detail: "supplied: the unit ended" } }
}

fn running() -> UnitLifecycleSource {
  SuppliedUnitLifecycle { lifecycle: UnitStillRunning { detail: "supplied: the unit is running" } }
}

fn unknown() -> UnitLifecycleSource {
  SuppliedUnitLifecycle { lifecycle: UnitLifecycleUnknown { detail: "supplied: the manager did not answer" } }
}

fn stoppable() -> UnitLifecycleSource {
  SuppliedStoppableUnit { before: UnitStillRunning { detail: "supplied: the unit is running" }, after_stop: UnitTerminatedSuccess { detail: "supplied: the unit ended after the stop" } }
}

fn leases_at(root: String) -> String {
  join([trim(s: root), "/leases"], "")
}

// THE PRODUCER LEASE of the fixture record (identity feedfacefeedface), written as the provider writes it.
fn lease_held(root: String) -> Bool {
  lease_written(root: root, content: join([compute_seat_holder_line(instance: instance_at(root: root), seat: ComputeDispatchSeat { attempt_key: "key-a" }), "abc 1\n"], ""))
}

fn lease_written(root: String, content: String) -> Bool {
  made(path: leases_at(root: root)) && Filesystem.Write(path: join([leases_at(root: root), "/feedfacefeedface"], ""), content: content).success
}

fn lease_listed(root: String) -> Bool {
  string_contains(s: Filesystem.List(path: leases_at(root: root)).entries, pattern: "feedfacefeedface")
}

// A FIXTURE THAT COULD NOT BE BUILT IS NO OUTCOME, never a refusal: the seat store unminted or the leases
// directory not created answers none, and ensured reads none as false, so a control expecting the production
// refusal cannot be satisfied by the fixture's own failure.
fn ensure_owner(root: String, reference: String, source: UnitLifecycleSource, owner: SeatOwnerStanding) -> SeatEnsureOutcome? {
  if made(path: leases_at(root: root)) {
    match seat_at(root: root, key: "key-a") {
      Absent => none
      Present { value: seat } => Present { value: compute_seat_ensure_in(instance: instance_at(root: root), store: seat, leases_dir: leases_at(root: root), subject: subject_at(root: root), reference: reference as NonEmptyStr, source: source, owner: owner) }
    }
  } else {
    none
  }
}

fn ensure(root: String, reference: String, source: UnitLifecycleSource) -> SeatEnsureOutcome? {
  ensure_owner(root: root, reference: reference, source: source, owner: SeatOwnerLive)
}

fn ensured(o: SeatEnsureOutcome?, check: fn(SeatEnsureOutcome) -> Bool) -> Bool {
  match o {
    Absent => false
    Present { value: outcome } => check(outcome)
  }
}

fn is_released(o: SeatEnsureOutcome) -> Bool {
  match o { SeatEnsureReleased { reference: _, committed_before: b, committed_after: a } => kibibyte_count(k: b) - kibibyte_count(k: a) == granted_kib  _ => false }
}

fn is_noop(o: SeatEnsureOutcome) -> Bool {
  match o { SeatEnsureNoop { reference: _, why: _ } => true  _ => false }
}

fn is_refused(o: SeatEnsureOutcome) -> Bool {
  match o { SeatEnsureRefused { reference: _, reason: _ } => true  _ => false }
}

fn is_terminal(root: String, reference: String) -> Bool {
  is_terminal_in(root: root, key: "key-a", reference: reference)
}

// THE REGRESSION CONTROL, ENROLLED AND PERMANENT: the failure state itself. A killed attempt's seat is
// held, and nothing in the attempt's own terminal path returns it; only the ensure does. If this goes
// false, the seat is being returned by something other than the door and the other cells here are
// asserting the wrong route.
test fn a_killed_reserved_attempt_keeps_its_seat_charged_until_the_ensure_runs() -> Bool {
  let root = fresh_root()
  let ok = a_killed_reserved_attempt_keeps_its_seat_charged_until_the_ensure_runs_cell(root: root)
  let removed = shell.Remove.RecursiveForce(path: root)
  ok && removed.success
}

fn a_killed_reserved_attempt_keeps_its_seat_charged_until_the_ensure_runs_cell(root: String) -> Bool {
  let subject = subject_at(root: root)
  opened(root: root, reference: "r-kill", owner: dispatch_owner())
    && reserved(subject: subject, reference: "r-kill")
    && committed(subject: subject) == granted_kib
    && committed(subject: subject) == granted_kib
}

// KILL AFTER OPEN, BEFORE RESERVE: the record exists, the ledger holds nothing. The ensure closes the
// attempt and reports that nothing was held; it releases no seat it never reserved. An unrelated seat keeps the ledger present (an empty ledger is unreadable, which the ensure refuses on) and must stay charged.
test fn a_kill_after_open_before_reserve_holds_no_seat_and_the_ensure_closes_the_attempt() -> Bool {
  let root = fresh_root()
  let ok = a_kill_after_open_before_reserve_holds_no_seat_and_the_ensure_closes_the_attempt_cell(root: root)
  let removed = shell.Remove.RecursiveForce(path: root)
  ok && removed.success
}

fn a_kill_after_open_before_reserve_holds_no_seat_and_the_ensure_closes_the_attempt_cell(root: String) -> Bool {
  let subject = subject_at(root: root)
  reserved(subject: subject, reference: "r-other")
    && opened(root: root, reference: "r-open", owner: dispatch_owner())
    && ensured(o: ensure(root: root, reference: "r-open", source: ended()), check: is_noop)
    && committed(subject: subject) == granted_kib
    && is_terminal(root: root, reference: "r-open")
}

// KILL AFTER RESERVE, BEFORE UNIT START: the seat is held and the launch deadline has passed.
test fn a_kill_after_reserve_is_discharged_once_the_launch_deadline_passes() -> Bool {
  let root = fresh_root()
  let ok = a_kill_after_reserve_is_discharged_once_the_launch_deadline_passes_cell(root: root)
  let removed = shell.Remove.RecursiveForce(path: root)
  ok && removed.success
}

fn a_kill_after_reserve_is_discharged_once_the_launch_deadline_passes_cell(root: String) -> Bool {
  let subject = subject_at(root: root)
  opened(root: root, reference: "r-res", owner: dispatch_owner())
    && reserved(subject: subject, reference: "r-res")
    && ensured(o: ensure(root: root, reference: "r-res", source: running()), check: is_released)
    && committed(subject: subject) == 0
    && is_terminal(root: root, reference: "r-res")
}

// KILL AFTER UNIT START WITH THE UNIT ENDED: Launching, the unit proven ended -> the seat comes back.
test fn a_kill_after_unit_start_with_an_ended_unit_is_discharged() -> Bool {
  let root = fresh_root()
  let ok = a_kill_after_unit_start_with_an_ended_unit_is_discharged_cell(root: root)
  let removed = shell.Remove.RecursiveForce(path: root)
  ok && removed.success
}

fn a_kill_after_unit_start_with_an_ended_unit_is_discharged_cell(root: String) -> Bool {
  let subject = subject_at(root: root)
  opened(root: root, reference: "r-end", owner: dispatch_owner())
    && reserved(subject: subject, reference: "r-end")
    && launching(root: root, reference: "r-end")
    && ensured(o: ensure(root: root, reference: "r-end", source: ended()), check: is_released)
    && committed(subject: subject) == 0
}

// A LIVE OWNER IS NEVER DISCHARGED: Launching with the unit running is a Noop and the seat stays.
test fn a_live_unit_keeps_its_seat_and_the_ensure_is_a_noop() -> Bool {
  let root = fresh_root()
  let ok = a_live_unit_keeps_its_seat_and_the_ensure_is_a_noop_cell(root: root)
  let removed = shell.Remove.RecursiveForce(path: root)
  ok && removed.success
}

fn a_live_unit_keeps_its_seat_and_the_ensure_is_a_noop_cell(root: String) -> Bool {
  let subject = subject_at(root: root)
  opened(root: root, reference: "r-live", owner: dispatch_owner())
    && reserved(subject: subject, reference: "r-live")
    && launching(root: root, reference: "r-live")
    && ensured(o: ensure(root: root, reference: "r-live", source: running()), check: is_noop)
    && committed(subject: subject) == granted_kib
    && !is_terminal(root: root, reference: "r-live")
}

// AN UNKNOWN LIFECYCLE IS A REFUSAL AND THE CHARGE IS KEPT: no free on doubt.
test fn an_unknown_unit_lifecycle_refuses_and_keeps_the_charge() -> Bool {
  let root = fresh_root()
  let ok = an_unknown_unit_lifecycle_refuses_and_keeps_the_charge_cell(root: root)
  let removed = shell.Remove.RecursiveForce(path: root)
  ok && removed.success
}

fn an_unknown_unit_lifecycle_refuses_and_keeps_the_charge_cell(root: String) -> Bool {
  let subject = subject_at(root: root)
  opened(root: root, reference: "r-unk", owner: dispatch_owner())
    && reserved(subject: subject, reference: "r-unk")
    && launching(root: root, reference: "r-unk")
    && ensured(o: ensure(root: root, reference: "r-unk", source: unknown()), check: is_refused)
    && committed(subject: subject) == granted_kib
}

// KILL BETWEEN THE TERMINAL GENERATION AND THE RELEASE: the attempt is already settled and the seat is
// still charged. The old door declined this as "already terminal", making the window permanent.
test fn a_kill_after_settle_before_release_is_discharged_from_the_terminal_record() -> Bool {
  let root = fresh_root()
  let ok = a_kill_after_settle_before_release_is_discharged_from_the_terminal_record_cell(root: root)
  let removed = shell.Remove.RecursiveForce(path: root)
  ok && removed.success
}

fn a_kill_after_settle_before_release_is_discharged_from_the_terminal_record_cell(root: String) -> Bool {
  let subject = subject_at(root: root)
  let ok = opened(root: root, reference: "r-set", owner: dispatch_owner())
    && reserved(subject: subject, reference: "r-set")
    && launching(root: root, reference: "r-set")
  let settled = with_seat(root: root, key: "key-a", f: slots => match attempt_slot_read(store: slots, reference: "r-set" as NonEmptyStr) {
    AttemptSlotHeld { record: rec, generation: g } =>
      match attempt_terminate(store: slots, reference: rec.reference as NonEmptyStr, expected: g, verdict: AttemptRecovered, detail: "wet witness settle") {
        AttemptAdvanced { state: _, generation: _ } => true
        _ => false
      }
    _ => false
  })
  ok && settled
    && committed(subject: subject) == granted_kib
    && ensured(o: ensure(root: root, reference: "r-set", source: ended()), check: is_released)
    && committed(subject: subject) == 0
}

// A SECOND ENSURE FINDS NOTHING HELD AND RELEASES NOTHING TWICE.
test fn a_second_ensure_over_a_discharged_seat_releases_nothing() -> Bool {
  let root = fresh_root()
  let ok = a_second_ensure_over_a_discharged_seat_releases_nothing_cell(root: root)
  let removed = shell.Remove.RecursiveForce(path: root)
  ok && removed.success
}

fn a_second_ensure_over_a_discharged_seat_releases_nothing_cell(root: String) -> Bool {
  let subject = subject_at(root: root)
  opened(root: root, reference: "r-twice", owner: dispatch_owner())
    && reserved(subject: subject, reference: "r-twice")
    && ensured(o: ensure(root: root, reference: "r-twice", source: ended()), check: is_released)
    && ensured(o: ensure(root: root, reference: "r-twice", source: ended()), check: is_noop)
    && committed(subject: subject) == 0
}

// AN ABSENT SLOT IS NOT A RELEASE: the ensure refuses a reference no record names. The seat's directory exists
// and lists empty, so the store is minted and the refusal is the production one; with no directory the fixture
// mints no store, which answers false (this control was green on that fixture refusal until the pass kept it).
test fn a_reference_no_record_names_is_refused_and_nothing_is_released() -> Bool {
  let root = fresh_root()
  let ok = a_reference_no_record_names_is_refused_and_nothing_is_released_cell(root: root)
  let removed = shell.Remove.RecursiveForce(path: root)
  ok && removed.success
}

fn a_reference_no_record_names_is_refused_and_nothing_is_released_cell(root: String) -> Bool {
  let subject = subject_at(root: root)
  made(path: attempts_at(root: root) as String)
    && reserved(subject: subject, reference: "r-orphan")
    && ensured(o: ensure(root: root, reference: "r-orphan", source: ended()), check: is_refused)
    && committed(subject: subject) == granted_kib
}

// THE DRIVER'S PASS KEEPS ITS REFUSAL: only a pass that RAN is judged; a skipped or refused pass (a seat store
// the mint refuses among them) answers false, never an empty outcome list a negative control would read as green.
fn driver_ran(root: String, source: UnitLifecycleSource, check: fn(List<SeatEnsureOutcome>) -> Bool) -> Bool {
  match compute_seat_discharge_all(instance: instance_at(root: root), leases_dir: leases_at(root: root), subject: subject_at(root: root), source: source) {
    SeatDischargeRan { outcomes: os } => check(os)
    SeatDischargeSkipped { why: _ } => false
    SeatDischargeRefused { reason: _ } => false
  }
}

// THE DRIVER KEEPS THE CHARGE WHEN NO EXIT RECORD PROVES THE ATTEMPT ENDED.
test fn the_driver_does_not_discharge_a_seat_without_an_exit_record() -> Bool {
  let root = fresh_root()
  let ok = the_driver_does_not_discharge_a_seat_without_an_exit_record_cell(root: root)
  let removed = shell.Remove.RecursiveForce(path: root)
  ok && removed.success
}

fn the_driver_does_not_discharge_a_seat_without_an_exit_record_cell(root: String) -> Bool {
  let subject = subject_at(root: root)
  opened(root: root, reference: "r-drv", owner: dispatch_owner())
    && reserved(subject: subject, reference: "r-drv")
    && launching(root: root, reference: "r-drv")
    && spool_unrecorded(root: root)
    && driver_ran(root: root, source: stoppable(), check: os => !any(os, o => is_released(o: o)))
    && committed(subject: subject) == granted_kib
}

// THE DRIVER'S POSITIVE PATH, EXECUTED: a real exit-spool entry for the attempt, an ended unit, a held
// seat under the attempt's own directory -> Apply -> Released with the independent readback at zero.
test fn the_driver_releases_the_seat_of_an_attempt_whose_exit_record_exists_and_unit_ended() -> Bool {
  let root = fresh_root()
  let ok = the_driver_releases_the_seat_of_an_attempt_whose_exit_record_exists_and_unit_ended_cell(root: root)
  let removed = shell.Remove.RecursiveForce(path: root)
  ok && removed.success
}

fn the_driver_releases_the_seat_of_an_attempt_whose_exit_record_exists_and_unit_ended_cell(root: String) -> Bool {
  let subject = subject_at(root: root)
  opened(root: root, reference: "r-pos", owner: dispatch_owner())
    && reserved(subject: subject, reference: "r-pos")
    && exit_recorded(root: root, key: "key-a")
    && committed(subject: subject) == granted_kib
    && driver_ran(root: root, source: ended(), check: os => count(os) == 1)
    && committed(subject: subject) == 0
    && is_terminal(root: root, reference: "r-pos")
}

// AN EXIT RECORD IS THE REASON TO LOOK, NOT THE PROOF: the unit is running -> the charge stays.
test fn an_exit_record_with_a_live_unit_keeps_the_charge() -> Bool {
  let root = fresh_root()
  let ok = an_exit_record_with_a_live_unit_keeps_the_charge_cell(root: root)
  let removed = shell.Remove.RecursiveForce(path: root)
  ok && removed.success
}

fn an_exit_record_with_a_live_unit_keeps_the_charge_cell(root: String) -> Bool {
  let subject = subject_at(root: root)
  opened(root: root, reference: "r-liv", owner: dispatch_owner())
    && reserved(subject: subject, reference: "r-liv")
    && launching(root: root, reference: "r-liv")
    && exit_recorded(root: root, key: "key-a")
    && driver_ran(root: root, source: running(), check: os => !any(os, o => is_released(o: o)))
    && committed(subject: subject) == granted_kib
}

// THE TERMINATION PROOF IS THE OBSERVED LIFECYCLE, NOT THE TERMINAL RECORD: a settled attempt whose unit
// lifecycle is unknown keeps its charge; the same attempt with the unit proven ended is released.
test fn a_terminal_record_releases_only_when_the_unit_is_proven_ended() -> Bool {
  let root = fresh_root()
  let ok = a_terminal_record_releases_only_when_the_unit_is_proven_ended_cell(root: root)
  let removed = shell.Remove.RecursiveForce(path: root)
  ok && removed.success
}

fn a_terminal_record_releases_only_when_the_unit_is_proven_ended_cell(root: String) -> Bool {
  let subject = subject_at(root: root)
  let ok = opened(root: root, reference: "r-tm", owner: dispatch_owner())
    && reserved(subject: subject, reference: "r-tm")
    && launching(root: root, reference: "r-tm")
  let settled = with_seat(root: root, key: "key-a", f: slots => match attempt_slot_read(store: slots, reference: "r-tm" as NonEmptyStr) {
    AttemptSlotHeld { record: rec, generation: g } =>
      match attempt_terminate(store: slots, reference: rec.reference as NonEmptyStr, expected: g, verdict: AttemptRecovered, detail: "wet witness settle") {
        AttemptAdvanced { state: _, generation: _ } => true
        _ => false
      }
    _ => false
  })
  ok && settled
    && ensured(o: ensure(root: root, reference: "r-tm", source: unknown()), check: is_refused)
    && committed(subject: subject) == granted_kib
    && ensured(o: ensure(root: root, reference: "r-tm", source: running()), check: is_noop)
    && committed(subject: subject) == granted_kib
    && ensured(o: ensure(root: root, reference: "r-tm", source: ended()), check: is_released)
    && committed(subject: subject) == 0
}

// A RECORD WITH NO RECORDED OWNER IS NOT A DIRECT INVOCATION: the ensure refuses and keeps the charge.
test fn an_unrecorded_owner_refuses_and_keeps_the_charge() -> Bool {
  let root = fresh_root()
  let ok = an_unrecorded_owner_refuses_and_keeps_the_charge_cell(root: root)
  let removed = shell.Remove.RecursiveForce(path: root)
  ok && removed.success
}

fn an_unrecorded_owner_refuses_and_keeps_the_charge_cell(root: String) -> Bool {
  let subject = subject_at(root: root)
  opened(root: root, reference: "r-old", owner: OwnerUnrecorded { why: "legacy record" })
    && reserved(subject: subject, reference: "r-old")
    && launching(root: root, reference: "r-old")
    && ensured(o: ensure(root: root, reference: "r-old", source: ended()), check: is_refused)
    && committed(subject: subject) == granted_kib
}

// THE LOCATION FOLLOWS THE OWNER, AND NOTHING IS SCANNED: attempt A's exit record discharges only the
// seat under A's directory; another attempt's seat, held under its own directory, is never visited.
test fn a_dispatch_attempts_exit_discharges_only_the_seat_under_its_own_directory() -> Bool {
  let root = fresh_root()
  let ok = a_dispatch_attempts_exit_discharges_only_the_seat_under_its_own_directory_cell(root: root)
  let removed = shell.Remove.RecursiveForce(path: root)
  ok && removed.success
}

fn a_dispatch_attempts_exit_discharges_only_the_seat_under_its_own_directory_cell(root: String) -> Bool {
  let subject = subject_at(root: root)
  let other_dir = seat_dir_of(root: root, key: "key-b") as String
  let other_open = made(path: other_dir)
    && with_seat(root: root, key: "key-b", f: slots => match attempt_open(store: slots, record: record_of(reference: "r-b", state: AttemptReserved, owner: DispatchOwned { node_id: "node-a", attempt_key: "key-b" })) {
      AttemptAdvanced { state: _, generation: _ } => true
      _ => false
    })
  opened(root: root, reference: "r-a", owner: dispatch_owner())
    && reserved(subject: subject, reference: "r-a")
    && launching(root: root, reference: "r-a")
    && other_open
    && reserved(subject: subject, reference: "r-b")
    && launching_in(root: root, key: "key-b", reference: "r-b")
    && exit_recorded(root: root, key: "key-a")
    && driver_ran(root: root, source: stoppable(), check: os => count(os) == 2)
    && committed(subject: subject) == granted_kib
    && !is_terminal_in(root: root, key: "key-b", reference: "r-b")
}

fn is_terminal_in(root: String, key: String, reference: String) -> Bool {
  with_seat(root: root, key: key, f: slots => match attempt_slot_read(store: slots, reference: reference as NonEmptyStr) {
    AttemptSlotHeld { record: rec, generation: _ } => match rec.state { AttemptTerminal { verdict: _, detail: _ } => true  _ => false }
    _ => false
  })
}

// THE RESERVATION REFERENCE IS THE OWNER'S IDENTITY PLUS A RECORDED ORDINAL, NEVER A CLOCK: the same
// identity at ordinal n and n+1 differ, the same pair is the same reference on every call, and no
// `@` clock suffix survives.
test fn the_reservation_reference_is_the_identity_and_its_ordinal() -> Bool {
  let owner_a = DispatchOwned { node_id: "node-a", attempt_key: "key-a" }
  let owner_b = DispatchOwned { node_id: "node-a", attempt_key: "key-b" }
  let a = compute_reservation_reference(identity: "feedfacefeedface", owner: owner_a, ordinal: 0) as String
  let b = compute_reservation_reference(identity: "feedfacefeedface", owner: owner_a, ordinal: 1) as String
  let other_attempt = compute_reservation_reference(identity: "feedfacefeedface", owner: owner_b, ordinal: 0) as String
  a != b
    && a == (compute_reservation_reference(identity: "feedfacefeedface", owner: owner_a, ordinal: 0) as String)
    && !string_contains(s: a, pattern: "@")
    && string_contains(s: a, pattern: "feedfacefeedface")
    && a != other_attempt
}

// DEAD OWNER, LIVE COMPUTE UNIT (Apply): the owner is proven ended and the unit its own slot names is still
// live. The unit is STOPPED, the door re-proves termination and the seat comes back. Cross-attempt safety:
// a joiner attaches only to a stored outcome (compute_attach_under_lease), never to this running unit.
test fn a_dead_owners_live_compute_unit_is_stopped_and_its_seat_released() -> Bool {
  let root = fresh_root()
  let ok = a_dead_owners_live_compute_unit_is_stopped_and_its_seat_released_cell(root: root)
  let removed = shell.Remove.RecursiveForce(path: root)
  ok && removed.success
}

fn a_dead_owners_live_compute_unit_is_stopped_and_its_seat_released_cell(root: String) -> Bool {
  let subject = subject_at(root: root)
  opened(root: root, reference: "r-dead", owner: dispatch_owner())
    && reserved(subject: subject, reference: "r-dead")
    && launching(root: root, reference: "r-dead")
    && ensured(o: ensure_owner(root: root, reference: "r-dead", source: stoppable(), owner: SeatOwnerEnded), check: is_released)
    && committed(subject: subject) == 0
}

// THE CONTROL: the same live unit under a LIVE owner is a Noop -- the unit is not stopped, the seat stays.
// (The stoppable source would answer "ended" only after a stop, so a release here would prove a stop ran.)
test fn a_live_owners_live_compute_unit_is_not_stopped() -> Bool {
  let root = fresh_root()
  let ok = a_live_owners_live_compute_unit_is_not_stopped_cell(root: root)
  let removed = shell.Remove.RecursiveForce(path: root)
