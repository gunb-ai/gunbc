}

// FINISHED COMPUTE UNDER A LIVE OWNER: no worker exit record exists, the compute unit ended, the seat is
// held. The driver enumerates the attempt's own seat directory and releases it.
test fn a_finished_compute_unit_under_a_live_owner_is_released_by_the_driver() -> Bool {
  let root = fresh_root()
  let ok = a_finished_compute_unit_under_a_live_owner_is_released_by_the_driver_cell(root: root)
