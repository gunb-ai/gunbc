  opened(root: root, reference: "r-lv", owner: dispatch_owner())
    && reserved(subject: subject, reference: "r-lv")
    && launching(root: root, reference: "r-lv")
    && ensured(o: ensure_owner(root: root, reference: "r-lv", source: stoppable(), owner: SeatOwnerLive), check: is_noop)
    && committed(subject: subject) == granted_kib
    && !is_terminal(root: root, reference: "r-lv")
}

// AN UNKNOWN LIFECYCLE IS NEVER STOPPED, even for a dead owner: the charge is kept.
test fn a_dead_owners_unknown_unit_is_refused_not_stopped() -> Bool {
