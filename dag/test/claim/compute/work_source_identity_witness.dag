module test.claim.compute.work_source_identity_witness

// CANONICAL WORK AND SOURCE IDENTITY (remote-build PR 2). Each claim has a RED control inside it.
// Files enter the identity by digest (ruling B); the digests here are supplied. What these supply: file sets and toolchain fixtures at the pure boundary. What they do NOT show: that
// the provider's git listing (ls-files --cached --others --exclude-standard) yields the file set; that
// route is the provider's wet run. The pure half is the identity rule both adapters share.

import extdeps.crypto.hash { sha256_digest }
import std.algebra { string_contains }
import std.types { String, Bool, NonEmptyStr, List }
import std.optional { Optional, Present, Absent }
import product.fabric.work { SourceManifestRef }
import extdeps.git.object_store { git_null_sha1_object_id }
import gunbc.compute.work_request {
  WorkSubject, GitTreeProvenance, WorktreeProvenance, work_default_build, work_declared_source, work_toolchain_requirement, work_toolchain_requirement_refusal,
  WorkToolchainRequirement, work_toolchain_admit, ToolchainAdmitted, ToolchainMismatch, AdmittedToolchain,
}
import gunbc.fabric.fabric_source_snapshot {
  SnapshotSourceFile, SnapshotIdentity, SnapshotIdentified, SnapshotIdentityRefused, snapshot_manifest_identity, source_manifest_ref,
}
import test.claim.compute.work_request_witness { key_with, tc_default }

// A file is its digest: the 64-hex digest is supplied, standing for the sha256 of the file's bytes.
// "d" repeated stands for distinct byte contents; `empty` and a binary digest are ordinary members.
fn file(directory: String, name: String, content: String) -> SnapshotSourceFile {
  SnapshotSourceFile { directory: directory as NonEmptyStr, name: name as NonEmptyStr, digest: sha256_digest(hex: digest_of(content: content) as NonEmptyStr) }
}

fn digest_of(content: String) -> String {
  match content {
    "module a" => "1111111111111111111111111111111111111111111111111111111111111111"
    "module b" => "2222222222222222222222222222222222222222222222222222222222222222"
    "fn main() {}" => "3333333333333333333333333333333333333333333333333333333333333333"
    "[package]" => "4444444444444444444444444444444444444444444444444444444444444444"
    "module n" => "5555555555555555555555555555555555555555555555555555555555555555"
    "binary" => "6666666666666666666666666666666666666666666666666666666666666666"
    "binary flipped" => "6666666666666666666666666666666666666666666666666666666666667666"
    "empty" => "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
    _ => "9999999999999999999999999999999999999999999999999999999999999999"
  }
}

fn clean_files() -> List<SnapshotSourceFile> {
  [file(directory: "dag", name: "a.dag", content: "module a"), file(directory: "src", name: "main.rs", content: "fn main() {}"), file(directory: ".", name: "Cargo.toml", content: "[package]")]
}

fn manifest_of(files: List<SnapshotSourceFile>) -> String {
  match snapshot_manifest_identity(composition: work_declared_source, files: files) {
    SnapshotIdentified { manifest: m, files: _, composition: _ } => source_manifest_ref(manifest: m) as String
    SnapshotIdentityRefused { cause: _ } => "refused"
  }
}

fn git_subject(manifest: String) -> WorkSubject {
  WorkSubject { manifest: manifest as SourceManifestRef, provenance: GitTreeProvenance { tree: git_null_sha1_object_id } }
}

fn worktree_subject(manifest: String) -> WorkSubject {
  WorkSubject { manifest: manifest as SourceManifestRef, provenance: WorktreeProvenance { path: "/work/dirty" } }
}

fn identity_key(s: WorkSubject) -> String {
  key_with(subject: s, op: work_default_build(), toolchain: tc_default(rustc: "rustc 1.93.0"))
}

// (1) Equal bytes, different representation (listing order; clean tree vs dirty worktree provenance) are
// ONE identity. RED control: a one-byte content change is a different manifest and key.
test fn clean_and_dirty_representations_of_equal_bytes_share_one_identity() -> Bool {
  let files = clean_files()
  let reordered = [file(directory: ".", name: "Cargo.toml", content: "[package]"), file(directory: "src", name: "main.rs", content: "fn main() {}"), file(directory: "dag", name: "a.dag", content: "module a")]
  let m = manifest_of(files: files)
  let changed = manifest_of(files: [file(directory: "dag", name: "a.dag", content: "module b"), file(directory: "src", name: "main.rs", content: "fn main() {}"), file(directory: ".", name: "Cargo.toml", content: "[package]")])
  m != "refused" && m == manifest_of(files: reordered)
    && identity_key(s: git_subject(manifest: m)) == identity_key(s: worktree_subject(manifest: m))
    && m != changed && identity_key(s: git_subject(manifest: m)) != identity_key(s: git_subject(manifest: changed))
}

// (2) A changed declared input changes the identity: operation, and a declared root.
test fn a_changed_declared_input_changes_the_identity() -> Bool {
  let m = manifest_of(files: clean_files())
  let s = git_subject(manifest: m)
  let base = identity_key(s: s)
  base == identity_key(s: s)
    && base != key_with(subject: s, op: work_default_build(), toolchain: tc_default(rustc: "rustc 1.93.1"))
    && manifest_of(files: clean_files()) != manifest_of(files: concat(clean_files(), [file(directory: ".", name: "rust-toolchain.toml", content: "x")]))
}

// (3) An observed toolchain that differs from the declared requirement refuses; the matching one is admitted.
test fn an_observed_toolchain_mismatch_refuses() -> Bool {
  let file = "[toolchain]\nchannel = \"1.93.0\"\ncomponents = [\"clippy\"]\n"
  let observed = tc_default(rustc: "rustc 1.93.0 (abc)").observed
  let wrong_release = tc_default(rustc: "rustc 1.90.0 (abc)").observed
  match work_toolchain_requirement(toolchain_file: Present { value: file }) {
    Absent => false
    Present { value: req } =>
      (match work_toolchain_admit(requirement: req, observed: observed) { ToolchainAdmitted { admitted: _ } => true  ToolchainMismatch { field: _, declared: _, observed: _ } => false })
        && (match work_toolchain_admit(requirement: req, observed: wrong_release) { ToolchainAdmitted { admitted: _ } => false  ToolchainMismatch { field: _, declared: _, observed: _ } => true })
        && (req.rustc_release_prefix as String) == "1.93.0"
        && (match work_toolchain_requirement(toolchain_file: Present { value: "[toolchain]\nchannel = \"1.90.0\"\n" }) { Present { value: other } => match work_toolchain_admit(requirement: other, observed: observed) { ToolchainAdmitted { admitted: _ } => false  ToolchainMismatch { field: _, declared: _, observed: _ } => true }  Absent => false })
        && (match work_toolchain_requirement(toolchain_file: Present { value: "[toolchain]\ncomponents = []\n" }) { Present { value: _ } => false  Absent => true })
  }
}

// (4) A new untracked file under a declared root is in the identity; one outside the roots refuses typed.
test fn a_new_untracked_file_is_in_the_identity() -> Bool {
  let base = manifest_of(files: clean_files())
  let with_new = manifest_of(files: concat(clean_files(), [file(directory: "dag", name: "new_untracked.dag", content: "module n")]))
  let outside = manifest_of(files: concat(clean_files(), [file(directory: "docs", name: "n.md", content: "x")]))
  with_new != "refused" && with_new != base && outside == "refused"
}

// (5) RULING B: a binary file and the empty file are ordinary members, identical under both adapters
// (provenance only differs), and one flipped byte (a different digest) is a different identity.
test fn binary_and_empty_files_are_digest_members_of_the_identity() -> Bool {
  let with_binary = concat(clean_files(), [file(directory: "dag", name: "blob.bin", content: "binary"), file(directory: "dag", name: "empty.dag", content: "empty")])
  let flipped = concat(clean_files(), [file(directory: "dag", name: "blob.bin", content: "binary flipped"), file(directory: "dag", name: "empty.dag", content: "empty")])
  let m = manifest_of(files: with_binary)
  m != "refused" && m != manifest_of(files: clean_files())
    && identity_key(s: git_subject(manifest: m)) == identity_key(s: worktree_subject(manifest: m))
    && m != manifest_of(files: flipped)
    && identity_key(s: git_subject(manifest: m)) != identity_key(s: git_subject(manifest: manifest_of(files: flipped)))
}

fn toolchain_file_names_requirement(t: String) -> Bool {
  match work_toolchain_requirement(toolchain_file: Present { value: t }) { Present { value: _ } => true  Absent => false }
}

// (6) The toolchain-file channel reader (extdeps.rust.rustup): exact key, [toolchain] table, both quote
// styles. RED controls: a prefix key, a channel outside the table and an unquoted value name no channel.
test fn the_toolchain_file_channel_is_read_by_exact_key_in_its_table() -> Bool {
  toolchain_file_names_requirement("[toolchain]\nchannel = \"1.93.0\"\n") && toolchain_file_names_requirement("[toolchain]\nchannel = '1.93.0'\n")
    && !toolchain_file_names_requirement("[toolchain]\nchannel_override = \"1.93.0\"\n")
    && !toolchain_file_names_requirement("channel = \"1.93.0\"\n")
    && !toolchain_file_names_requirement("[other]\nchannel = \"1.93.0\"\n[toolchain]\ncomponents = []\n")
    && !toolchain_file_names_requirement("[toolchain]\nchannel = 1.93.0\n")
    && toolchain_file_names_requirement("[toolchain] # pinned\nchannel = \"1.93.0\" # now\n") && toolchain_file_names_requirement("[ toolchain ]\nchannel = \"1.93.0\"\n")
    && toolchain_file_names_requirement("[toolchain]\nchannel = \"nightly#x\"\n") && !toolchain_file_names_requirement("[toolchain]\nchannel = \"a\\\"b\"\n") && !toolchain_file_names_requirement("[toolchain]\nchannel = \"\"\"x\"\"\"\n")
    && string_contains(s: work_toolchain_requirement_refusal(toolchain_file: Present { value: "[toolchain]\nchannel = \"a\\\"b\"\n" }), pattern: "escape sequence")
    && (match work_toolchain_requirement(toolchain_file: none) { Present { value: _ } => false  Absent => true })
    && toolchain_file_names_requirement("toolchain.channel = \"1.93.0\"\n")
    && !toolchain_file_names_requirement("[foo]\ntoolchain.channel = \"nightly\"\n") && !toolchain_file_names_requirement("[toolchain]\nchannel = \"nightly\n")
    && string_contains(s: work_toolchain_requirement_refusal(toolchain_file: Present { value: "[toolchain]\nchannel = \"nightly\n" }), pattern: "unterminated")
}
