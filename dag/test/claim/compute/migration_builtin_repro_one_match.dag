module test.claim.compute.migration_builtin_repro_one_match

import std.types { String, List, Bool }
import std.error_primitives { Result, Ok, Err }

fn selected(read: fn() -> Result<List<String>, String>) -> Result<List<String>, String> {
  match read() {
    Err { value: why } => Err { value: why }
    Ok { value: excluded } => Ok { value: filter(["x"], unit => fold(excluded, init: true, f: (keep, other) => keep && other != unit)) }
  }
}

test fn repro() -> Bool { selected(read: fn() { Ok { value: ["x"] } }) == Ok { value: [] } }
