      is_indeterminate(a: a) && has_unknown(a: a, item: "authorized_keys.mode")
    }
  }
}

// ── A2 (side-chat review of 2026-11-16): the serving desired ledger IS the post-admission
//    posture, derived from host_capacity's shared-posture authority. The discriminating witness
//    runs on srv2 — NOT on the remote-build roster — and the red control is the pre-admission
//    (roster-gated) spelling, which must NOT be what the serving desired state carries. ────────

fn ledger_row_signature(t: OwnedDirectoryTarget) -> String {
  concat(
    (owned_directory_path(t: t) as String),
    "|", (owned_directory_owner(t: t).user as String),
    "|", (owned_directory_owner(t: t).group as String),
    "|", serving_ledger_declared_mode_octal(t: t),
    "|", (owned_directory_member(t: t) as String),
  )
}

fn ledger_signatures(rows: List<OwnedDirectoryTarget>) -> List<String> {
  map(rows, t => ledger_row_signature(t: t))
}

fn ledger_rows_equal(a: List<OwnedDirectoryTarget>, b: List<OwnedDirectoryTarget>) -> Bool {
  let sa = ledger_signatures(rows: a)
  let sb = ledger_signatures(rows: b)
  count(sa) == count(sb) && all(sa, s => any(sb, o => o == s)) && all(sb, s => any(sa, o => o == s))
}

// For the NON-ROSTERED candidate srv2, the serving desired ledger rows EQUAL what host_capacity
// yields for that host once admitted — and the host is proven not-yet-rostered, so the witness
// actually discriminates (a vacuous srv1 pass would prove nothing).
test fn candidate_host_serving_ledger_rows_equal_the_admitted_host_capacity_rows() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv2) {
    Absent => false
    Present { value: d } =>
      !remote_build_host_is_serving(host: operator_host_srv2)
        && ledger_rows_equal(a: d.ledger_dirs, b: host_capacity_home_directories_admitted(host: operator_host_srv2))
        // and the posture is the SHARED one: an area row carries the ledger group.
        && any(d.ledger_dirs, t => (owned_directory_owner(t: t).group as String) == "gunbc-compute")
  }
}

// RED CONTROL, re-keyed with this PR. Before it, the roster alone set a host's host-home ledger
// posture, so the non-rostered srv2 answered the SERVICE-ONLY rows and differed from what a converge
// installs. The posture now follows the CANDIDATE row (the provisioning authority: a converge has to
// create a traversable, compute-grouped /opt/gunbc/compute/capacity home BEFORE the roster admits the
// host), so for a candidate the roster-gated route AGREES with the converge — that agreement is the
// change, and pinning it here is what stops the old claim from being quietly satisfied by the new
// authority. The discriminating host is the one on NEITHER list: srv9 is neither candidate nor
// rostered, so its host-home rows must stay service-only (no row carries the ledger group) and must
// differ from what a converge installs for the candidate. If candidacy ever stops changing anything
// here, THIS cell goes red, not the settled receipt.
test fn pre_admission_ledger_posture_is_not_the_serving_posture() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv2) {
    Absent => false
    Present { value: d } => {
      let srv2_home_dirs = host_capacity_home_directories(host: operator_host_srv2)
      let srv9_home_dirs = host_capacity_home_directories(host: operator_host_srv9)
      // srv2 is a candidate but is never live-dispatched, and its home carries the shared grouping.
      !remote_build_host_is_serving(host: operator_host_srv2)
        && remote_build_host_is_serving_candidate(host: operator_host_srv2)
        && ledger_rows_equal(a: d.ledger_dirs, b: srv2_home_dirs)
        && any(srv2_home_dirs, t => (owned_directory_owner(t: t).group as String) == "gunbc-compute")
        // srv9 is on neither serving row, so nothing groups its home for the compute pool.
        && !remote_build_host_is_serving_candidate(host: operator_host_srv9)
        && !remote_build_host_is_serving(host: operator_host_srv9)
        && !any(srv9_home_dirs, t => (owned_directory_owner(t: t).group as String) == "gunbc-compute")
        && !ledger_rows_equal(a: d.ledger_dirs, b: srv9_home_dirs)
    }
  }
}

// Fixture caps: a settled observation carries the ceiling's value, its derived high, and the forbidden
// swap; these build the two value caps the settle demands (a settled slice reads capped, an uncapped one
// is built directly with unbounded caps).
fn settled_slice_max(ceiling: ByteSize) -> ObservationAttempt<CgroupMemoryLimitValue, ServingLegFailure> { ObservationEstablished { observed: CgroupMemoryLimited { bytes: ceiling } } }
fn settled_slice_high(ceiling: ByteSize) -> ObservationAttempt<CgroupMemoryLimitValue, ServingLegFailure> {
  match user_work_slice_memory_high_of(memory_max: ceiling) {
    UserWorkSliceHighDerived { bytes: h } => ObservationEstablished { observed: CgroupMemoryLimited { bytes: h } }
    UserWorkSliceHighGapExceedsMax => ObservationEstablished { observed: CgroupMemoryLimited { bytes: byte_size(0) } }
  }
}

// KEN'S CANDIDATE ROW DOES NOT OPEN THE LIVE GATE. ken (operator_host_e2d4b7) is in the candidate set -- that
// enables the OBSERVE/CONVERGE arm so the converge can create its /opt/gunbc/compute/capacity home -- but it is
// NOT on gunbc.compute.remote_build_hosts::remote_build_serving_hosts, so it is not in client dispatch either:
// remote_build_host_is_serving reads that roster, the ONE live dispatch gate. Red control: srv9 (retired) is
// neither candidate nor serving, so the candidate arm is not vacuously true; if candidacy ever leaked straight
// into the roster, ken's !remote_build_host_is_serving goes red.
test fn ken_candidate_row_does_not_admit_to_roster_or_dispatch() -> Bool {
  any(remote_build_serving_candidate_hosts(), h => h == operator_host_e2d4b7)
    && !remote_build_host_is_serving(host: operator_host_e2d4b7)
    && !any(remote_build_serving_candidate_hosts(), h => h == operator_host_srv9)
    && !remote_build_host_is_serving(host: operator_host_srv9)
}

// ── the fresh-host ledger owner: a single deduped, converge-ensured member ──────────────────────────
//
// ken (operator_host_e2d4b7) and butch (operator_host_srv14) carry NO operator login. Their ledger is
// owned by the remote-build account (capacity_ledger_directory_owner's third arm), so the ledger service
// user and the serving account are the SAME name. remote_build_serving_desired therefore emits
// group_members = DEDUPED([service_user, account]) = a single "gunbc-build". An UNDEDUPED
// [gunbc-build, gunbc-build] never settles against the one real member the apply's usermod creates
// (serving_group_deviations compares counts), trading the usermod crash for a permanent
// GroupMembersMismatch. These witnesses (relocated from the account sweep — they are serving-model claims)
// pin the dedupe and prove the settle comparison is live. (guarantee_ladder: positive + discriminating red.)

// Positive: on a fresh host the desired gunbc-compute has EXACTLY ONE member, the remote-build account —
// the only principal the converge itself ensures (converge_add_account creates fleet_posix_remote_build_user).
test fn fresh_host_group_members_are_a_single_converge_ensured_principal() -> Bool {
  all([operator_host_e2d4b7, operator_host_srv14], h => {
    match remote_build_serving_desired(host: h) {
      Absent => false
      Present { value: d } => {
        count(d.group_members) == 1
          && all(d.group_members, m => m == (fleet_posix_remote_build_user.name as String))
      }
    }
  })
}

// Positive (the settle, per lively-owl-722): serving_group_deviations over the REAL deduped desired for
// ken, against an /etc/group whose gunbc-compute carries exactly the single ensured member, is empty —
// the comparison the wet receipt takes returns no drift. This is the claim the dedupe exists to make true.
test fn fresh_host_deduped_desired_settles_against_the_single_observed_member() -> Bool {
  match remote_build_serving_desired(host: operator_host_e2d4b7) {
    Absent => false
    Present { value: d } => {
      let single = concat(
        concat(concat(concat("gunbc-compute:x:", to_string(value: fleet_posix_compute_ledger_group_gid)), ":"),
          fleet_posix_remote_build_user.name as String),
        "",
      )
      count(serving_group_deviations(d: d, group: ObservationEstablished { observed: single })) == 0
    }
  }
}

// RED CONTROL (the discriminating red for the dedupe, per lively-owl-722): against the SAME deduped desired,
// an /etc/group whose gunbc-compute lists the member TWICE — the state the undeduped [gunbc-build,
// gunbc-build] desired would demand, which is what the model would now compare against — must NOT be
// drift-free, proving serving_group_deviations's count check is live. The empty deviation list in the
// settle witness is therefore meaningful, not vacuous: had the dedupe been removed, the desired's two
// members against the apply's single real member diverge the same way this red diverges.
test fn a_undeduped_second_member_diverges_at_plan_time() -> Bool {
  match remote_build_serving_desired(host: operator_host_e2d4b7) {
    Absent => false
    Present { value: d } => {
      let dup = concat(
        concat(concat(concat("gunbc-compute:x:", to_string(value: fleet_posix_compute_ledger_group_gid)), ":"),
          fleet_posix_remote_build_user.name as String),
        concat(",", fleet_posix_remote_build_user.name as String),
      )
      count(serving_group_deviations(d: d, group: ObservationEstablished { observed: dup })) > 0
    }
  }
}

// ── serving-observe-reads-absent-toolchain-as-drift (RB-M3 follow-up, lively-owl-722) ──
//
// On a FRESH serving account (ken host-e2d4b7 run 45823194417, butch run 45823189449) rustup has never
// been installed, so `rustup toolchain list` cannot run and exits 127 -- the toolchain leg reads Refused.
// The observe used to fold that 127 into an unknown and answer INDETERMINATE, which blocked the whole
// converge. But rustup PROVEN ABSENT (the `test -x` leg Established false) makes that 127 the EXPECTED
// consequence, and bootstrapping rustup then the pinned channel is the converge's work -- so the toolchain
// leg must report DRIFT, not unknown. The three claims below pin the rule and its two fail-closed edges:
//   (1) fresh (rustup proven absent, list refused 127) -> toolchain DRIFT, runnable, NOT indeterminate;
//   (2) rustup PRESENT but the listing refused (present-but-failing) -> toolchain UNKNOWN (indeterminate);
//   (3) rustup itself UNREADABLE (elevation refused) with the listing refused -> toolchain UNKNOWN.
// The base is a fully settled, sidecar-coherent host, so the toolchain legs are the only thing that moves.

// The settled host with the rustup and toolchain legs supplied independently (so a claim can move just
// those two out from under an otherwise-settled observation).
fn toolchain_probe_observed(dline: String, d: RemoteBuildServingDesired, rustup_leg: ObservationAttempt<Bool, ServingLegFailure>, toolchain_leg: ObservationAttempt<Bool, ServingLegFailure>) -> ServingObserved {
  serving_observed_from_reads(
    elevation: est_elevation(),
    account_name: d.account_name,
    passwd: est_s(converged_passwd()),
    group: est_s(converged_group()),
    authorized_keys: est_s(dline),
    store_root: est_ok(), store_staging: est_ok(), store_root_mode: store_mode_ok(d: d), store_staging_mode: store_mode_ok(d: d), serve_binary: est_ok(),
    scratch_root: est_ok(), scratch_root_mode: scratch_mode_ok(d: d),
    checkout: est_ok(), toolchain: toolchain_leg, rustup: rustup_leg,
    serve_binary_sha256: Present { value: est_s(settled_sha()) }, checkout_revision: Present { value: est_s(settled_rev()) }, authorized_keys_mode: Present { value: ak_mode_ok(d: d) }, serve_binary_mode: Present { value: binary_mode_ok(d: d) }, target_arch: pin_arch_leg(),
    user_work_slice_max: settled_slice_max(ceiling: user_work_slice_memory_max_for_host(host: d.host)),
    user_work_slice_high: settled_slice_high(ceiling: user_work_slice_memory_max_for_host(host: d.host)),
    user_work_slice_swap: ObservationEstablished { observed: CgroupMemoryLimited { bytes: user_work_slice_memory_swap_max } },
    user_manager_linger: ObservationEstablished { observed: true },
    ledger_rows: converged_ledger(d: d),
    serve_identity: Present { value: ObservationEstablished { observed: SidecarRecorded { revision: settled_rev(), sha256: settled_sha() } } },
    seat_census: RecoverCatalogLegEstablished { entries: [] },)
}

// (1) THE RED CONTROL (the follow-up row, verbatim): a fresh account -- rustup proven absent, toolchain
// listing refused (the 127) -- reports toolchain DRIFT and is runnable, NOT indeterminate. Reverting the
// gate (always fold a refused toolchain into an unknown) makes this red: is_indeterminate flips true.
test fn a_fresh_accounts_refused_toolchain_read_is_drift_not_indeterminate() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      match d.forced_command_line {
        Absent => false
        Present { value: line } => {
          let o = toolchain_probe_observed(dline: line, d: d, rustup_leg: ObservationEstablished { observed: false }, toolchain_leg: refused_b(item: "toolchain"))
          let a = serving_assess_readiness(d: d, o: o, pin: pin_ok())
          is_diverged(a) && has_deviation(a: a, item: "toolchain") && serving_assessment_runnable(a: a)
            && is_indeterminate(a) == false && has_unknown(a: a, item: "toolchain") == false
        }
      }
    }
  }
}

// (2) RESERVATION (fail-closed): rustup PRESENT (the test -x leg established true) but `toolchain list`
// REFUSED is a present-but-failing rustup -- a genuinely unreadable channel -- so it stays UNKNOWN, never
// silently a plan. Widening this arm to drift would make this red.
test fn a_present_but_failing_rustup_listing_stays_unknown_under_readiness() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      match d.forced_command_line {
        Absent => false
        Present { value: line } => {
          let o = toolchain_probe_observed(dline: line, d: d, rustup_leg: est_ok(), toolchain_leg: refused_b(item: "toolchain"))
          let a = serving_assess_readiness(d: d, o: o, pin: pin_ok())
          is_indeterminate(a) && has_unknown(a: a, item: "toolchain")
        }
      }
    }
  }
}

// (3) RESERVATION (fail-closed): rustup itself UNREADABLE (elevation refused) with the listing refused is
// an unreadable fact, not a proven absence -- it stays UNKNOWN. The gate reads rustup's ESTABLISHED false,
// never its refused, so this arm is unaffected by the fix.
test fn an_unreadable_rustup_presence_with_a_refused_listing_stays_unknown_under_readiness() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      match d.forced_command_line {
        Absent => false
        Present { value: line } => {
          let o = toolchain_probe_observed(dline: line, d: d, rustup_leg: refused_b(item: "rustup"), toolchain_leg: refused_b(item: "toolchain"))
          let a = serving_assess_readiness(d: d, o: o, pin: pin_ok())
          is_indeterminate(a) && has_unknown(a: a, item: "toolchain")
        }
      }
    }
  }
}
