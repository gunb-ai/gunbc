// ── elevation precondition (review 95915) ─────────────────────────────────────────
// 'sudo -n' exits 1 when IT refuses — the same exit the 'test' legs read as "confirmed absent".
// A drifted sudo grant must therefore make every sudo-dependent item UNREAD (Indeterminate),
// never "confirmed absent" that 5(b) would then write over. The elevation precondition is the
// single gate: refused => sudo-dependent legs unread + an elevation unknown => GoalIndeterminate.
// RED CONTROL: a store dir that would otherwise be proven-absent (drift) is NOT reported as a
// store.root deviation when elevation is refused; the verdict is Indeterminate, and the run is
// not runnable, so the apply is never dispatched.
test fn refused_elevation_is_indeterminate_never_drift() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      let o = serving_observed_from_reads(
        elevation: refused_elevation(),
        account_name: d.account_name,
        passwd: est_s(converged_passwd()),
        group: est_s(converged_group()),
        authorized_keys: est_s(forced_line(d)),
        store_root: est_absent(), store_staging: est_ok(), store_root_mode: store_mode_absent(), store_staging_mode: store_mode_ok(d: d), serve_binary: est_ok(),
        scratch_root: est_absent(), scratch_root_mode: store_mode_absent(),
        checkout: est_ok(), toolchain: est_ok(), rustup: est_ok(),
        serve_binary_sha256: Present { value: pin_sha_leg() }, checkout_revision: Present { value: pin_rev_leg() }, authorized_keys_mode: Present { value: ak_mode_ok(d: d) }, serve_binary_mode: Present { value: binary_mode_ok(d: d) }, target_arch: pin_arch_leg(),
    user_work_slice_max: settled_slice_max(ceiling: user_work_slice_memory_max_for_host(host: d.host)),
    user_work_slice_high: settled_slice_high(ceiling: user_work_slice_memory_max_for_host(host: d.host)),
    user_work_slice_swap: ObservationEstablished { observed: CgroupMemoryLimited { bytes: user_work_slice_memory_swap_max } },
    user_manager_linger: ObservationEstablished { observed: true },
        ledger_rows: converged_ledger(d: d),
      
        serve_identity: Absent,
    seat_census: RecoverCatalogLegEstablished { entries: [] },)
      let a = serving_assess(d: d, o: o, pin: pin_ok())
      is_indeterminate(a)
        && serving_assessment_terminal(a: a) == "indeterminate"
        && serving_assessment_runnable(a: a) == false
        && has_deviation(a: a, item: "store.root") == false
        && has_deviation(a: a, item: "elevation") == false
    }
  }
}

// The elevation refusal must dominate even when a NON-sudo leg genuinely drifts: unknowns take
// priority over deviations, so a real (passwd-readable) account drift + refused elevation is still
// Indeterminate, never Diverged — the apply never acts on a host whose sudo-dependent state it could
// not have written.
test fn refused_elevation_beats_a_real_drift() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      let o = serving_observed_from_reads(
        elevation: refused_elevation(),
        account_name: d.account_name,
        passwd: est_s("gunbc-build:x:9999:1005:remote-build:/home/gunbc-build:/bin/bash\n"),
        group: est_s(converged_group()),
        authorized_keys: est_s(forced_line(d)),
        store_root: est_absent(), store_staging: est_ok(), store_root_mode: store_mode_absent(), store_staging_mode: store_mode_ok(d: d), serve_binary: est_ok(),
        scratch_root: est_absent(), scratch_root_mode: store_mode_absent(),
        checkout: est_ok(), toolchain: est_ok(), rustup: est_ok(),
        serve_binary_sha256: Present { value: pin_sha_leg() }, checkout_revision: Present { value: pin_rev_leg() }, authorized_keys_mode: Present { value: ak_mode_ok(d: d) }, serve_binary_mode: Present { value: binary_mode_ok(d: d) }, target_arch: pin_arch_leg(),
    user_work_slice_max: settled_slice_max(ceiling: user_work_slice_memory_max_for_host(host: d.host)),
    user_work_slice_high: settled_slice_high(ceiling: user_work_slice_memory_max_for_host(host: d.host)),
    user_work_slice_swap: ObservationEstablished { observed: CgroupMemoryLimited { bytes: user_work_slice_memory_swap_max } },
    user_manager_linger: ObservationEstablished { observed: true },
        ledger_rows: converged_ledger(d: d),
      
        serve_identity: Absent,
    seat_census: RecoverCatalogLegEstablished { entries: [] },)
      let a = serving_assess(d: d, o: o, pin: pin_ok())
      is_indeterminate(a) && !is_diverged(a) && serving_assessment_runnable(a: a) == false
    }
  }
}

