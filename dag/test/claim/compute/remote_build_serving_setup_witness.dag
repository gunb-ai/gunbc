        serve_identity: Absent,
    seat_census: RecoverCatalogLegEstablished { entries: [] },)
      let a = serving_assess(d: d, o: o, pin: pin_ok())
      is_diverged(a) && has_deviation(a: a, item: "store.root")
    }
  }
}

// ── A1 (side-chat review of 2026-11-16): the subject/value dependency, through the full
//    observe-to-assess composition. PAIRED witnesses: the FRESH HOST (subjects confirmed
//    absent) is Diverged and runnable with no value-leg unknowns, while the INSTALLED host
//    whose value read is unreadable stays Indeterminate. The middle case — presence itself
//    unread — is the third arm and stays Indeterminate too. ──────────────────────────────────

// The fresh host's reads: no gunbc-build line in passwd, no serving groups, no authorized_keys
// file, no store dirs, no serve binary, no checkout, no rustup home — each confirmed ABSENT
// (established, not refused), so every dependent value leg is Skipped and NOT read.
fn fresh_host_passwd() -> String { "root:x:0:root:/root:/bin/bash\nsystemd:x:100:\n" }

fn fresh_host_group_table() -> String { "root:x:0:\nsudo:x:27:\n" }

fn absent_ledger(d: RemoteBuildServingDesired) -> List<ServingLedgerRowObserved> {
  map(d.ledger_dirs, t => row_est(t: t, u: "", g: "", m: ""))
}

fn fresh_host_observed(d: RemoteBuildServingDesired) -> ServingObserved {
  serving_observed_from_reads(
    elevation: est_elevation(),
    account_name: d.account_name,
    passwd: est_s(text: fresh_host_passwd()),
    group: est_s(text: fresh_host_group_table()),
    authorized_keys: est_s(text: ""),
    store_root: est_absent(), store_staging: est_absent(),
    store_root_mode: store_mode_absent(), store_staging_mode: store_mode_absent(),
    scratch_root: est_absent(), scratch_root_mode: store_mode_absent(),
    serve_binary: est_absent(), checkout: est_absent(), toolchain: est_absent(), rustup: est_absent(),
    // the dependent legs were NEVER READ — the subjects are confirmed absent, so Absent is the
    // honest read-state and from_reads turns it into SubjectValueSkipped (no unknown).
    serve_binary_sha256: Absent, checkout_revision: Absent,
    authorized_keys_mode: Absent, serve_binary_mode: Absent,
    user_work_slice_max: settled_slice_max(ceiling: user_work_slice_memory_max_for_host(host: d.host)),
    user_work_slice_high: settled_slice_high(ceiling: user_work_slice_memory_max_for_host(host: d.host)),
    user_work_slice_swap: ObservationEstablished { observed: CgroupMemoryLimited { bytes: user_work_slice_memory_swap_max } },
    user_manager_linger: ObservationEstablished { observed: false },
    target_arch: pin_arch_leg(),
    ledger_rows: absent_ledger(d: d),
  
    serve_identity: Absent,
    seat_census: RecoverCatalogLegEstablished { entries: [] },)
}

// THE FRESH-HOST WITNESS: every absence is PROVEN, so the assessment is Diverged (the presence
// deviations alone drive the plan), carries NO value-leg unknown, and is RUNNABLE — 5(b)'s
// converge accepts a fresh host instead of refusing it as nobody-read (finding A1).
test fn fresh_host_with_confirmed_absent_subjects_is_diverged_and_runnable() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      let a = serving_assess(d: d, o: fresh_host_observed(d: d), pin: pin_ok())
      is_diverged(a: a) && !is_indeterminate(a: a) && serving_assessment_runnable(a: a)
        && !has_unknown(a: a, item: "serve_binary.sha256")
        && !has_unknown(a: a, item: "checkout.revision")
        && !has_unknown(a: a, item: "authorized_keys.mode")
        && !has_unknown(a: a, item: "serve.binary.mode")
        && has_deviation(a: a, item: "seed.serve_binary")
        && has_deviation(a: a, item: "checkout")
    }
  }
}

// THE PAIRED WITNESS: the binary is PRESENT (test -x established) but its hash read was REFUSED
// — the value leg stays an account to take, and unknowns win: Indeterminate, not runnable.
// Skipping the read here would be the bug in the other direction.
// RED CONTROL (side-chat review follow-up, finding B1-observe): a host that HAS a ~/.rustup but
// NOT the pinned channel is a DEVIATION, not settled — the toolchain leg establishes the channel
// itself via `rustup toolchain list`, so "rustup home exists" no longer satisfies the pin.
fn wrong_channel_observed(dline: String, d: RemoteBuildServingDesired) -> ServingObserved {
  serving_observed_from_reads(
    elevation: est_elevation(),
    account_name: d.account_name,
    passwd: est_s(converged_passwd()),
    group: est_s(converged_group()),
    authorized_keys: est_s(text: dline),
    store_root: est_ok(), store_staging: est_ok(), store_root_mode: store_mode_ok(d: d), store_staging_mode: store_mode_ok(d: d), serve_binary: est_ok(),
    scratch_root: est_ok(), scratch_root_mode: scratch_mode_ok(d: d),
    checkout: est_ok(), toolchain: est_absent(), rustup: est_ok(),
    serve_binary_sha256: Present { value: pin_sha_leg() }, checkout_revision: Present { value: pin_rev_leg() }, authorized_keys_mode: Present { value: ak_mode_ok(d: d) }, serve_binary_mode: Present { value: binary_mode_ok(d: d) }, target_arch: pin_arch_leg(),
    user_work_slice_max: settled_slice_max(ceiling: user_work_slice_memory_max_for_host(host: d.host)),
    user_work_slice_high: settled_slice_high(ceiling: user_work_slice_memory_max_for_host(host: d.host)),
    user_work_slice_swap: ObservationEstablished { observed: CgroupMemoryLimited { bytes: user_work_slice_memory_swap_max } },
    user_manager_linger: ObservationEstablished { observed: true },
    ledger_rows: converged_ledger(d: d),
  
    serve_identity: Absent,
    seat_census: RecoverCatalogLegEstablished { entries: [] },)
}

test fn rustup_home_with_wrong_channel_is_a_toolchain_deviation() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      let a = serving_assess(d: d, o: wrong_channel_observed(forced_line(d: d), d), pin: pin_ok())
      match a {
        GoalDiverged { deviations: ds } => any(non_empty_to_list(ds), x => serving_deviation_item(dev: x) == "toolchain")
        _ => false
      }
    }
  }
}

// The other arm of the pair: rustup present AND the pinned channel present reports no toolchain
// deviation — the leg establishes the channel, not merely the rustup home's existence.
test fn pinned_channel_present_is_settled_on_toolchain() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      let a = serving_assess(d: d, o: converged_observed(forced_line(d: d), d), pin: pin_ok())
      match a {
        GoalDiverged { deviations: ds } => !any(non_empty_to_list(ds), x => serving_deviation_item(dev: x) == "toolchain")
        GoalSatisfied { evidence: _ } => true
        _ => false
      }
    }
  }
}

// RUSTUP UNREADABLE while the account is present: the remediation runner is unknown, so the
// toolchain remediation is an UNKNOWN (fail-closed: never a plan built on an unproven runner).
test fn rustup_leg_unreadable_is_an_unknown() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
    Present { value: d } => {
      let o = serving_observed_from_reads(
        elevation: est_elevation(),
        account_name: d.account_name,
        passwd: est_s(converged_passwd()),
        group: est_s(converged_group()),
        authorized_keys: est_s(text: forced_line(d: d)),
        store_root: est_ok(), store_staging: est_ok(), store_root_mode: store_mode_ok(d: d), store_staging_mode: store_mode_ok(d: d), serve_binary: est_ok(),
        scratch_root: est_ok(), scratch_root_mode: scratch_mode_ok(d: d),
        checkout: est_ok(), toolchain: est_absent(),
        rustup: ObservationRefused { cause: ServingLegFailure { item: "rustup", cause: "ssh refused" } },
        serve_binary_sha256: Present { value: pin_sha_leg() }, checkout_revision: Present { value: pin_rev_leg() }, authorized_keys_mode: Present { value: ak_mode_ok(d: d) }, serve_binary_mode: Present { value: binary_mode_ok(d: d) }, target_arch: pin_arch_leg(),
    user_work_slice_max: settled_slice_max(ceiling: user_work_slice_memory_max_for_host(host: d.host)),
    user_work_slice_high: settled_slice_high(ceiling: user_work_slice_memory_max_for_host(host: d.host)),
    user_work_slice_swap: ObservationEstablished { observed: CgroupMemoryLimited { bytes: user_work_slice_memory_swap_max } },
    user_manager_linger: ObservationEstablished { observed: true },
        ledger_rows: converged_ledger(d: d),
      
        serve_identity: Absent,
    seat_census: RecoverCatalogLegEstablished { entries: [] },)
      match serving_assess(d: d, o: o, pin: pin_ok()) {
        GoalIndeterminate { known_deviations: _, unknowns: us } => any(non_empty_to_list(us), x => x.item == "toolchain.remediation")
        _ => false
      }
    }
  }
}

// The channel matcher is boundary-exact: a channel that merely LOOKS LIKE A PREFIX of an
// installed toolchain ("1.9" against "1.90.0") never matches — a prefix is not a match — while
// the exact channel and the channel plus its "-<host triple>" suffix do.
test fn toolchain_channel_matcher_is_prefix_red() -> Bool {
  !serving_toolchain_line_names_channel(line: "1.90.0-x86_64-unknown-linux-gnu", channel: "1.9")
    && serving_toolchain_line_names_channel(line: "1.9.0-aarch64-unknown-linux-gnu (default)", channel: "1.9.0")
    && !serving_toolchain_line_names_channel(line: "stable-x86_64-unknown-linux-gnu", channel: "1.9.0")
    && serving_toolchain_line_names_channel(line: "1.9.0", channel: "1.9.0")
}

