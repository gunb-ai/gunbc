// The third arm: subject PRESENCE unread (the test leg itself was refused) leaves the value leg
// unread too — Indeterminate, never Skipped. An unread subject never settles its value.
test fn unread_subject_presence_leaves_the_value_leg_unread() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv1) {
    Absent => false
