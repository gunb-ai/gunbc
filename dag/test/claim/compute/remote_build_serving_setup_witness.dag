// ── an unrenderable host (off the candidate row) is REFUSED, not written ────────

test fn a_host_outside_the_candidate_row_refuses_the_assessment() -> Bool {
  match remote_build_serving_desired(host: operator_host_srv9) {
    Absent => true
    Present { value: d } => {
      let o = converged_observed("", d)
      match serving_assess(d: d, o: o, pin: pin_ok()) {
        GoalAssessmentRefused { cause: _ } => serving_assessment_runnable(a: serving_assess(d: d, o: o, pin: pin_ok())) == false
        _ => false
      }
    }
  }
}

// ── PR 5 owns the candidate set so the OBSERVE arm covers hosts the roster has not ─
// A host is admitted to remote_build_serving_hosts only after its serving setup is converged
// (admitting early is fail-open, review 95791), so the observe must render a per-host forced-command
// line off the PR 5-owned candidate row whether or not the host is listed, and the lines must differ
// (a per-host render, not a constant) — proving the observe is decoupled from the roster.
test fn a_not_yet_rostered_candidate_still_renders_a_forced_command() -> Bool {
  match serving_forced_command_line(host: operator_host_srv3) {
    Present { value: l3 } => match serving_forced_command_line(host: operator_host_srv4) {
      Present { value: l4 } => l4 != "" && l3 != l4
      Absent => false
    }
    Absent => false
  }
}

// ── PR 5(a) single comparator: the pin legs + the ledger, one leg per fact ───────
//
// The observe now compares the executor's plan-time pin to the host-read binary sha, checkout
// revision and arch, and reads the host_capacity ledger per row keyed by path. The red controls
// below prove the SAME two directions on the new legs as the std.goal_assessment contract, and
// the ledger-specific ones prove the three traps that make it correct:
//   * an unread sha/rev/arch/ledger-field leg is an UNKNOWN (Indeterminate), never a drift;
//   * a confirmed-absent ledger row (the owner-user leg established EMPTY = stat 'No such file')
//     IS a drift the apply creates — PAIRED against the same host with every row matched (no
//     ledger deviation), so absence has not collapsed into indeterminate either;
//   * a desired row the observe never read is an UNKNOWN, NOT an absence-to-create (fail closed);
//   * the mode is compared by VALUE, so stat's '755' and the declared '0755' are the SAME mode
//     (a raw octal string-compare would report a drift that does not exist).

fn forced_line(d: RemoteBuildServingDesired) -> String {
  match d.forced_command_line {
    Present { value: l } => l
    Absent => ""
  }
}

// the eight host legs all settled, with the four single-comparator legs supplied by the caller.
fn reads_over(
  d: RemoteBuildServingDesired,
  sha: ObservationAttempt<String, ServingLegFailure>,
  rev: ObservationAttempt<String, ServingLegFailure>,
  arch: ObservationAttempt<String, ServingLegFailure>,
  ledger: List<ServingLedgerRowObserved>,
) -> ServingObserved {
  serving_observed_from_reads(
    elevation: est_elevation(),
    account_name: d.account_name,
    passwd: est_s(converged_passwd()), group: est_s(converged_group()), authorized_keys: est_s(forced_line(d)),
    store_root: est_ok(), store_staging: est_ok(), store_root_mode: store_mode_ok(d: d), store_staging_mode: store_mode_ok(d: d), serve_binary: est_ok(),
    scratch_root: est_ok(), scratch_root_mode: scratch_mode_ok(d: d),
    checkout: est_ok(), toolchain: est_ok(), rustup: est_ok(),
    serve_binary_sha256: Present { value: sha }, checkout_revision: Present { value: rev }, authorized_keys_mode: Present { value: ak_mode_ok(d: d) }, serve_binary_mode: Present { value: binary_mode_ok(d: d) }, target_arch: arch,
    user_work_slice_max: settled_slice_max(ceiling: user_work_slice_memory_max_for_host(host: d.host)),
    user_work_slice_high: settled_slice_high(ceiling: user_work_slice_memory_max_for_host(host: d.host)),
    user_work_slice_swap: ObservationEstablished { observed: CgroupMemoryLimited { bytes: user_work_slice_memory_swap_max } },
    user_manager_linger: ObservationEstablished { observed: true },
    ledger_rows: ledger,
  
    serve_identity: Absent,
    seat_census: RecoverCatalogLegEstablished { entries: [] },)
}

// the settled baseline: pin legs established to the pin, ledger every row matched.
fn converged_reads(d: RemoteBuildServingDesired) -> ServingObserved {
  reads_over(d, pin_sha_leg(), pin_rev_leg(), pin_arch_leg(), converged_ledger(d: d))
}

// The store ROOT is the one non-area row (group != the ledger group); the AREAS are the
// group-writable sticky rows (group == gunbc-compute). Predicates, not single-target picks:
// the red controls rewrite every row of a kind, so no head/first-of-two is needed.
fn is_area_target(t: OwnedDirectoryTarget) -> Bool { (owned_directory_owner(t: t).group as String) == "gunbc-compute" }

fn is_root_target(t: OwnedDirectoryTarget) -> Bool { !is_area_target(t: t) }

// a guard, not a red control: some desired ledger row really declares this canonical octal, so a
// fixture that silently lost the sticky areas or the 0755 root cannot let a mode control pass.
fn any_row_declares(d: RemoteBuildServingDesired, mode: String) -> Bool {
  // count_where is the authority for "how many satisfy P"; the builtin `count` is 1-argument and a
  // surplus predicate actual is now refused at type check (it was silently dropped, so this was vacuously
  // `non-empty(ledger_dirs)`). The guard's intent -- some desired row really declares this octal -- is what
  // count_where actually judges.
  count_where(d.ledger_dirs, t => serving_ledger_declared_mode_octal(t: t) == mode) > 0
}

// a row built with explicit established field values.
fn row_est(t: OwnedDirectoryTarget, u: String, g: String, m: String) -> ServingLedgerRowObserved {
  ServingLedgerRowObserved { path: owned_directory_path(t: t), user: est_s(u), group: est_s(g), mode: est_s(m) }
}

fn row_user_refused(t: OwnedDirectoryTarget) -> ServingLedgerRowObserved {
  ServingLedgerRowObserved {
    path: owned_directory_path(t: t),
    user: refused_s("ledger", "stat could not be run"),
    group: est_s(owned_directory_owner(t: t).group as String),
    mode: est_s(serving_ledger_declared_mode_octal(t: t)),
  }
}

// every ledger row read AS DECLARED, except those `pick` selects, which `over` rewrites — how a
// red control breaks exactly one field of exactly the rows it means to (the areas, or the root).
fn ledger_rewrite(d: RemoteBuildServingDesired, pick: fn(OwnedDirectoryTarget) -> Bool, over: fn(OwnedDirectoryTarget) -> ServingLedgerRowObserved) -> List<ServingLedgerRowObserved> {
  map(d.ledger_dirs, t => match pick(t) { true => over(t)  false => matched_ledger_row(t: t) })
}

// the observe's reads MINUS every row `drop` selects — the desired rows left unprobed. A desired
// row with no read is an unknown, never an absence (serving_ledger_row_judge), which is exactly
// what the unknown-vs-absent control exercises.
fn ledger_without(d: RemoteBuildServingDesired, drop: fn(OwnedDirectoryTarget) -> Bool) -> List<ServingLedgerRowObserved> {
  map(filter(d.ledger_dirs, t => !drop(t)), t => matched_ledger_row(t: t))
}

