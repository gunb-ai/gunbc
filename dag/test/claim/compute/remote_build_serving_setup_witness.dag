module test.claim.compute.remote_build_serving_setup_witness

// PR 5: the desired-state derivation for the remote-build serving setup, plus its
// discriminating RED CONTROLS, judged through std.goal_assessment::GoalAssessment. The
// central red control is the one std.goal_assessment exists to protect: an UNREADABLE read
// must make the host GoalIndeterminate (and the observe REFUSE), never a GoalDiverged the
// apply would "write" against a host nobody read (std.goal_assessment paragraph ONE;
// gunbc.design_argument::fail_closed). The paired control proves the opposite direction:
// a CONFIRMED-absent read (test exit 1) IS a divergence the apply should write — so we have
// not collapsed real drift into indeterminate either. Run:
//   gunbc run --source-root dag --source-root src/v2 \
//     --entry dag/test/claim/compute/remote_build_serving_setup_witness.dag --claim-run

import std.types { Bool, String }
import std.optional { Present, Absent }
import std.algebra { non_empty_to_list }
import std.goal_assessment {
  ObservationAttempt, ObservationEstablished, ObservationRefused,
  GoalSatisfied, GoalDiverged, GoalIndeterminate, GoalAssessmentRefused,
}
import gunbc.fleet.fleet_host_identity { operator_host_srv1, operator_host_srv2, operator_host_srv3, operator_host_srv4, operator_host_srv9 }
import gunbc.compute.remote_build_serving_setup {
  remote_build_serving_desired, RemoteBuildServingDesired,
  serving_forced_command_line, serving_observed_from_reads, serving_assess, ServingAssessment,
  serving_assessment_settled, serving_assessment_terminal, serving_assessment_runnable,
  serving_assessment_receipt_text, ServingLegFailure, ServingObserved,
}
import gunbc.compute.remote_build { remote_build_serving_instance }
import gunbc.owned_directory { owned_directory_owner }

// ── the declared principal is the serving account ──────────────────────────────

test fn srv1_desired_account_is_the_declared_principal() -> Bool {
  let d = remote_build_serving_desired(host: operator_host_srv1)
  d.account_uid == 1005 && d.account_gid == 1005 && d.account_name == "gunbc-build"
    && d.group_name == "gunbc-compute" && d.group_gid == 1006
}

test fn the_serving_account_is_not_root() -> Bool {
  let d = remote_build_serving_desired(host: operator_host_srv1)
  d.account_uid != 0 && d.account_gid != 0
}

// ── the ledger is shared with the host's service user, group-owned ──────────────

test fn srv1_ledger_is_shared_with_its_service_user() -> Bool {
  let d = remote_build_serving_desired(host: operator_host_srv1)
  d.ledger_service_user == "briansrls" && any(d.group_members, m => m == d.account_name)
}

// The ledger is [root, objects-area, heads-area]. The root stays traverse-only and is
// owned service_user:service_user; ONLY the two 03770 areas are grouped to gunbc-compute
// so both principals' reservations survive. This is the discriminating control for the
// ledger sharing: if the areas lost the group (ComputeLedgerServiceOnly) count==0 fails
// it; if the model over-grouped the root, count==3 fails it.
test fn the_two_ledger_areas_are_service_user_shared_with_the_compute_group() -> Bool {
  let d = remote_build_serving_desired(host: operator_host_srv1)
  let shared = filter(d.ledger_dirs, t => (owned_directory_owner(t: t).group as String) == "gunbc-compute")
  count(shared) == 2 && all(shared, t => (owned_directory_owner(t: t).user as String) == d.ledger_service_user)
}

// ── the serving paths are derived from the admitted serving instance ────────────

test fn srv1_serving_paths_match_the_serving_instance() -> Bool {
  let d = remote_build_serving_desired(host: operator_host_srv1)
  let inst = remote_build_serving_instance(host: operator_host_srv1)
  d.serve_binary == (inst.serve_binary as String)
    && d.checkout_dir == (inst.repo_root as String)
    && d.store_root == concat(inst.instance_root as String, "/materialization-store")
    && d.store_staging == concat(inst.instance_root as String, "/materialization-store-staging")
}

// ── every candidate host renders a forced-command line ─────────────────────────

fn line_present(d: RemoteBuildServingDesired) -> Bool {
  match d.forced_command_line {
    Present { value: l } => l != ""
    Absent => false
  }
}

test fn every_pr5_candidate_host_renders_a_forced_command() -> Bool {
  all(
    [
      remote_build_serving_desired(host: operator_host_srv1),
      remote_build_serving_desired(host: operator_host_srv2),
      remote_build_serving_desired(host: operator_host_srv3),
      remote_build_serving_desired(host: operator_host_srv4)
    ],
    line_present
  )
}

// ── RED CONTROL: a host off the candidate row carries NO forced-command line ────

test fn a_host_outside_the_candidate_row_has_no_forced_command() -> Bool {
  let d = remote_build_serving_desired(host: operator_host_srv9)
  match d.forced_command_line {
    Absent => true
    Present { value: l } => false
  }
}

// ── observation builders for the assessment cells ───────────────────────────────
//
// Each leg is established (a value was read) or refused (no usable snapshot). The
// converged fixtures below hardcode the ADMITTED constants (uid/gid 1005, group 1006,
// members briansrls+gunbc-build) and are guarded against the model so the controls are
// never vacuous.

fn est_s(text: String) -> ObservationAttempt<String, ServingLegFailure> {
  ObservationEstablished { observed: text }
}

fn refused_s(item: String, cause: String) -> ObservationAttempt<String, ServingLegFailure> {
  ObservationRefused { cause: ServingLegFailure { item: item, cause: cause } }
}

fn est_ok() -> ObservationAttempt<Bool, ServingLegFailure> {
  ObservationEstablished { observed: true }
}

fn est_absent() -> ObservationAttempt<Bool, ServingLegFailure> {
  ObservationEstablished { observed: false }
}

fn refused_b(item: String) -> ObservationAttempt<Bool, ServingLegFailure> {
  ObservationRefused { cause: ServingLegFailure { item: item, cause: "leg failed" } }
}

fn converged_passwd() -> String {
  "gunbc-build:x:1005:1005:remote-build:/home/gunbc-build:/bin/bash\nroot:x:0:0:root:/root:/bin/bash\n"
}

fn converged_group() -> String {
  "gunbc-compute:x:1006:briansrls,gunbc-build\ngunbc-build:x:1005:\n"
}

// An observation in which every fact was READ SUCCESSFULLY and every value matches the
// declaration (the ADOPT / converged host). `dline` is the host's forced-command line.
fn converged_observed(dline: String) -> ServingObserved {
  serving_observed_from_reads(
    passwd: est_s(converged_passwd()),
    group: est_s(converged_group()),
    authorized_keys: est_s(dline),
    store_root: est_ok(), store_staging: est_ok(), serve_binary: est_ok(),
    checkout: est_ok(), toolchain: est_ok(),
  )
}

fn has_deviation(a: ServingAssessment, item: String) -> Bool {
  match a {
    GoalDiverged { deviations: ds } => any(non_empty_to_list(ds), x => x.item == item)
    _ => false
  }
}

fn is_indeterminate(a: ServingAssessment) -> Bool {
  match a { GoalIndeterminate { known_deviations: _, unknowns: _ } => true  _ => false }
}

fn is_diverged(a: ServingAssessment) -> Bool {
  match a { GoalDiverged { deviations: _ } => true  _ => false }
}

// ── ADOPT: an already-correct host is settled, never rebuilt ────────────────────

test fn a_matching_host_is_adopted_as_a_settled_assessment() -> Bool {
  let d = remote_build_serving_desired(host: operator_host_srv1)
  match d.forced_command_line {
    Absent => false
    Present { value: line } => serving_assessment_settled(a: serving_assess(d: d, o: converged_observed(line)))
  }
}

// ── RED CONTROLS: a PROVEN wrong value must diverge, and be reported as runnable ─

test fn wrong_uid_diverges_the_account() -> Bool {
  let d = remote_build_serving_desired(host: operator_host_srv1)
  match d.forced_command_line {
    Absent => false
    Present { value: line } => {
      let o = serving_observed_from_reads(
        passwd: est_s("gunbc-build:x:9999:1005:remote-build:/home/gunbc-build:/bin/bash\n"),
        group: est_s(converged_group()),
        authorized_keys: est_s(line),
        store_root: est_ok(), store_staging: est_ok(), serve_binary: est_ok(),
        checkout: est_ok(), toolchain: est_ok(),
      )
      let a = serving_assess(d: d, o: o)
      is_diverged(a) && has_deviation(a: a, item: "account.uid") && serving_assessment_runnable(a: a)
    }
  }
}

test fn group_without_the_account_diverges() -> Bool {
  let d = remote_build_serving_desired(host: operator_host_srv1)
  match d.forced_command_line {
    Absent => false
    Present { value: line } => {
      let o = serving_observed_from_reads(
        passwd: est_s(converged_passwd()),
        group: est_s("gunbc-compute:x:1006:briansrls\n"),
        authorized_keys: est_s(line),
        store_root: est_ok(), store_staging: est_ok(), serve_binary: est_ok(),
        checkout: est_ok(), toolchain: est_ok(),
      )
      let a = serving_assess(d: d, o: o)
      is_diverged(a) && has_deviation(a: a, item: "group.members")
    }
  }
}

test fn authorized_keys_with_a_stray_key_diverges() -> Bool {
  let d = remote_build_serving_desired(host: operator_host_srv1)
  match d.forced_command_line {
    Absent => false
    Present { value: line } => {
      let o = serving_observed_from_reads(
        passwd: est_s(converged_passwd()),
        group: est_s(converged_group()),
        authorized_keys: est_s(concat(line, " ssh-rsa STRAY stray@host")),
        store_root: est_ok(), store_staging: est_ok(), serve_binary: est_ok(),
        checkout: est_ok(), toolchain: est_ok(),
      )
      let a = serving_assess(d: d, o: o)
      is_diverged(a) && has_deviation(a: a, item: "authorized_keys.forced_command")
    }
  }
}

// A CONFIRMED-absent authorized_keys (the file was tested present-and-empty, or a
// confirmed no-key) is a PROVEN divergence the apply writes — distinct from an unreadable
// file. This is the positive half: real drift is still reported as drift (runnable).
test fn confirmed_absent_authorized_keys_is_drift_not_indeterminate() -> Bool {
  let d = remote_build_serving_desired(host: operator_host_srv1)
  match d.forced_command_line {
    Absent => false
    Present { value: line } => {
      let o = serving_observed_from_reads(
        passwd: est_s(converged_passwd()),
        group: est_s(converged_group()),
        authorized_keys: est_s(""),
        store_root: est_ok(), store_staging: est_ok(), serve_binary: est_ok(),
        checkout: est_ok(), toolchain: est_ok(),
      )
      let a = serving_assess(d: d, o: o)
      is_diverged(a) && serving_assessment_terminal(a: a) == "drift" && has_deviation(a: a, item: "authorized_keys.forced_command")
    }
  }
}

// A CONFIRMED-absent directory (test exit 1) is proven drift, NOT indeterminate. This is
// the paired control to the unreadable-leg control: we refuse on UNREAD, we still report
// drift on a confirmed absence — the two are not collapsed into each other.
test fn confirmed_absent_store_dir_is_drift_not_indeterminate() -> Bool {
  let d = remote_build_serving_desired(host: operator_host_srv1)
  match d.forced_command_line {
    Absent => false
    Present { value: line } => {
      let o = serving_observed_from_reads(
        passwd: est_s(converged_passwd()),
        group: est_s(converged_group()),
        authorized_keys: est_s(line),
        store_root: est_absent(), store_staging: est_ok(), serve_binary: est_ok(),
        checkout: est_ok(), toolchain: est_ok(),
      )
      let a = serving_assess(d: d, o: o)
      is_diverged(a) && !is_indeterminate(a) && serving_assessment_runnable(a: a) && has_deviation(a: a, item: "store.root")
    }
  }
}

// ── THE central red control (std.goal_assessment paragraph ONE) ─────────────────
// An UNREADABLE read — here a refused `cat /etc/passwd` — must make the host
// GoalIndeterminate (a ServingUnknown), NOT GoalDiverged and NOT settled. If the code
// wrongly read "could not read" as "the account is absent", this assessment would be
// Diverged and the apply would WRITE an account on a host nobody could read. A presence-
// only or naive model returns drift here and this cell FAILS.

test fn an_unreadable_passwd_is_indeterminate_not_drift() -> Bool {
  let d = remote_build_serving_desired(host: operator_host_srv1)
  match d.forced_command_line {
    Absent => false
    Present { value: line } => {
      let o = serving_observed_from_reads(
        passwd: refused_s("account", "sudo: no tty"),
        group: est_s(converged_group()),
        authorized_keys: est_s(line),
        store_root: est_ok(), store_staging: est_ok(), serve_binary: est_ok(),
        checkout: est_ok(), toolchain: est_ok(),
      )
      let a = serving_assess(d: d, o: o)
      is_indeterminate(a) && !is_diverged(a) && !serving_assessment_settled(a: a)
        && serving_assessment_runnable(a: a) == false && serving_assessment_terminal(a: a) == "indeterminate"
    }
  }
}

// Same doctrine for a presence test: a store dir whose `test` leg ERRORED (not a clean
// 0/1) is UNREADABLE -> indeterminate, never a proven absence the apply would create.
test fn an_unreadable_store_leg_is_indeterminate() -> Bool {
  let d = remote_build_serving_desired(host: operator_host_srv1)
  match d.forced_command_line {
    Absent => false
    Present { value: line } => {
      let o = serving_observed_from_reads(
        passwd: est_s(converged_passwd()),
        group: est_s(converged_group()),
        authorized_keys: est_s(line),
        store_root: refused_b("store.root"), store_staging: est_ok(), serve_binary: est_ok(),
        checkout: est_ok(), toolchain: est_ok(),
      )
      let a = serving_assess(d: d, o: o)
      is_indeterminate(a) && serving_assessment_runnable(a: a) == false
    }
  }
}

// The receipt for an indeterminate host says "indeterminate", never "drift" — so the CI
// consumer never sees a plan it could hand the apply for a host that was not read.
test fn the_receipt_names_indeterminate_never_drift_for_an_unread_leg() -> Bool {
  let d = remote_build_serving_desired(host: operator_host_srv1)
  match d.forced_command_line {
    Absent => false
    Present { value: line } => {
      let o = serving_observed_from_reads(
        passwd: refused_s("account", "ssh refused"),
        group: est_s(converged_group()),
        authorized_keys: est_s(line),
        store_root: est_ok(), store_staging: est_ok(), serve_binary: est_ok(),
        checkout: est_ok(), toolchain: est_ok(),
      )
      let r = serving_assessment_receipt_text(a: serving_assess(d: d, o: o))
      starts_with(s: r, prefix: "remote-build-serving-plan: indeterminate")
        && starts_with(s: r, prefix: "remote-build-serving-plan: drift") == false
    }
  }
}

// ── an unrenderable host (off the candidate row) is REFUSED, not written ────────

test fn a_host_outside_the_candidate_row_refuses_the_assessment() -> Bool {
  let d = remote_build_serving_desired(host: operator_host_srv9)
  let o = converged_observed("")
  match serving_assess(d: d, o: o) {
    GoalAssessmentRefused { cause: _ } => serving_assessment_runnable(a: serving_assess(d: d, o: o)) == false
    _ => false
  }
}

// ── PR 5 owns the candidate set so the OBSERVE arm covers hosts the roster has not ─
// PR 4 keeps remote_build_serving_hosts at srv1 only (admitting early is fail-open,
// review 95791), and srv3/srv4 are admitted by PR 5(b) LAST, once their home/store/account
// exist. They must still render a per-host forced-command line off the PR 5-owned candidate
// row, and the lines must differ (a per-host render, not a constant) — proving the observe is
// decoupled from the roster it does not yet gate.
test fn a_not_yet_rostered_candidate_still_renders_a_forced_command() -> Bool {
  match serving_forced_command_line(host: operator_host_srv3) {
    Present { value: l3 } => match serving_forced_command_line(host: operator_host_srv4) {
      Present { value: l4 } => l3 != l4
      Absent => false
    }
    Absent => false
  }
}
