        scratch_root: est_ok(), scratch_root_mode: scratch_mode_ok(d: d),
        serve_binary: refused_b(item: "seed.serve_binary"), checkout: est_ok(), toolchain: est_ok(), rustup: est_ok(),
        // the observe ran NO read under the unread subject; even a matching value could not rescue it.
        serve_binary_sha256: Absent,
