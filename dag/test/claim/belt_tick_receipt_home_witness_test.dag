module test.claim.belt_tick_receipt_home_witness

// THE KEYSTONE. srv1-live resolves the dispatch attempt-state root to a path it does not own
// alone — it is DispatchStateHostShared, so that root answers for the host, not for this instance.
// A receipt homed there would be a per-host file pretending to be a per-instance one, and the UI
// would render whatever wrote last. Asserted as an inequality against the ACTUAL shared value
// rather than against a literal, so it keeps discriminating if that root is ever re-pointed.
// NARROWED when the second slot was deleted: the first conjunct used to assert that the blue/green
// pair really did share one root, which was the premise the rest defended. One production instance
// remains, so that premise has no subject and asserting it would be asserting a self-equality.
//
// The first cut of that narrowing left `receipt != shared`, and review caught that it is a
// TAUTOLOGY dressed as this claim's law. The shared root is /opt/gunbc/attempt-state and the
// receipt is /opt/gunbc/receipts/belt-last-tick.json, so the inequality holds for a reason unrelated
// to the claim — and the exact defect the claim is NAMED for, a receipt homed IN the shared root at
// /opt/gunbc/attempt-state/belt-last-tick.json, ALSO satisfies it. The narrowing had removed the one
// conjunct carrying content and left the empty one standing.
//
// Containment is the predicate that states the law, and it is the same one
// host_shared_slots_are_exempt_from_containment_but_labs_are_not uses: the receipt must not be
// UNDER the shared attempt-state root. This reds for the real defect.
// The second conjunct is the CONTROL, and it is in the claim rather than in this comment on
// purpose: it constructs the defect -- the receipt homed inside the shared root -- and asserts the
// predicate CATCHES it. Without it, `!dashboard_path_is_under(...)` would be one predicate change
// away from being vacuous again in a way no reader could see, which is exactly how the tautology
// got here. With it, a predicate that stopped detecting containment reds this claim from the
// positive side even while the negative side still looks satisfied.
test fn the_receipt_is_not_homed_in_the_shared_attempt_state_root() -> Bool {
  let shared = gunbc.roadmap_dashboard_instance.dashboard_instance_dispatch_attempt_state_root(instance: gunbc.roadmap_dashboard_instance.srv1_live_dashboard_instance())
  let receipt = gunbc.roadmap_belt_actuate.belt_tick_receipt_path_for_instance(instance: gunbc.roadmap_dashboard_instance.srv1_live_dashboard_instance())
  let homed_in_shared = join([shared as String, "/belt-last-tick.json"], "") as std.types.FilePath
  !gunbc.roadmap_dashboard_instance.dashboard_path_is_under(path: receipt as std.types.FilePath, root: shared)
    && gunbc.roadmap_dashboard_instance.dashboard_path_is_under(path: homed_in_shared, root: shared)
}

// Two instances on one host must not fuse. The receipt is per-instance by construction because it
// derives from instance_root, which is the one root two instances never share.
// RE-ENROLLED, not retired: the deleted green slot was this claim's second instance, but it was not
// its subject. srv1-lab is a real second instance on the same host, so the property still has a
// population to hold over and this stays a live claim rather than a tautology.
test fn two_instances_on_one_host_get_distinct_receipts() -> Bool {
  let live = gunbc.roadmap_belt_actuate.belt_tick_receipt_path_for_instance(instance: gunbc.roadmap_dashboard_instance.srv1_live_dashboard_instance())
  let lab = gunbc.roadmap_belt_actuate.belt_tick_receipt_path_for_instance(instance: gunbc.roadmap_dashboard_instance.srv1_lab_dashboard_instance())
  live != lab
}

// The receipt sits INSIDE the instance's receipts directory — the directory the deploy bootstraps
// with install -d -o <service-user>. A receipt written anywhere else is written into a root-owned
// directory and fails EACCES, which is the defect this change repairs.
test fn the_receipt_sits_in_the_instance_receipts_directory() -> Bool {
  let live = gunbc.roadmap_belt_actuate.belt_tick_receipt_path_for_instance(instance: gunbc.roadmap_dashboard_instance.srv1_live_dashboard_instance())
  let dir = gunbc.host_layout.instance_receipts_dir(instance_root: "/opt/gunbc")
  live == join([dir, "/belt-last-tick.json"], "")
}

// The exact bytes. Pinned because the deploy's install -d and the tick's write must agree on one
// path: a derivation that drifted would create the directory in one place and write the receipt in
// another, and both halves would look correct in isolation.
test fn the_receipt_paths_are_the_expected_bytes() -> Bool {
  let live = gunbc.roadmap_belt_actuate.belt_tick_receipt_path_for_instance(instance: gunbc.roadmap_dashboard_instance.srv1_live_dashboard_instance())
  live == "/opt/gunbc/receipts/belt-last-tick.json"
}

// The directory projection is a function of its argument, not a literal wearing a parameter.
// A body that ignored instance_root and returned production's path would pass every claim above
// that only reads one instance, so several roots are asserted here.
test fn the_receipts_directory_derives_from_its_instance_root() -> Bool {
  gunbc.host_layout.instance_receipts_dir(instance_root: "/opt/gunbc") == "/opt/gunbc/receipts"
    && gunbc.host_layout.instance_receipts_dir(instance_root: "/srv/elsewhere") == "/srv/elsewhere/receipts"
    && gunbc.host_layout.instance_receipts_dir(instance_root: "/var/tmp/x") == "/var/tmp/x/receipts"
}

// ── The deploy-side half: the directory is actually created, and owned by the service user ─────
//
// Without this the tick half above is a path that still cannot be written. These two claims are
// the pair — where the receipt goes, and who owns the directory it goes in — and either alone
// leaves the defect intact.

fn step_commands(steps: List<v2.std.orchestration.PipelineStep>) -> List<String> {
  fold(steps, init: [], f: (acc, s) => match s {
    Do { run: r } => concat(acc, [r.command])
    _ => acc
  })
}

fn has_command(cmds: List<String>, want: String) -> Bool {
  fold(cmds, init: false, f: (acc, c) => acc || c == want)
}

fn belt_upsert_commands() -> List<String> {
  let spec = gunbc.live_deploy.spec.deployment_spec_srv1()
  let art = gunbc.live_deploy.spec.DeploymentArtifactStep {
    kind: gunbc.live_deploy.spec.BeltTimerUnit,
    path: gunbc.live_deploy.spec.deployment_belt_timer_unit_path(
      names: gunbc.live_deploy.spec.srv1_live_deployment_names(instance: gunbc.roadmap_dashboard_instance.srv1_live_dashboard_instance()),
    ) as String as std.types.NonEmptyStr,
  }
  step_commands(steps: gunbc.live_deploy.emit.emit_artifact_upsert(
    art: art,
    spec: spec,
    revision: gunbc.live_deploy.emit.RevisionBoundAtEmission { revision: "0000000000000000000000000000000000000000" as std.types.CommitSha },
  ))
}

// The bootstrap is emitted, it targets THIS instance's receipts directory, and it carries the
// service-user ownership. Asserted as exact bytes because all three facts live in one command and
// a witness that only checked for "install -d" would pass on production's path or on a root-owned
// directory — the two ways this fix can be silently wrong.
test fn the_belt_member_bootstraps_its_own_receipts_directory() -> Bool {
  has_command(cmds: belt_upsert_commands(), want: "sudo -n install -d -m 0755 -o briansrls -g briansrls /opt/gunbc/receipts")
}

// The directory the deploy creates is the directory the tick writes into. Stated as a join between
// the two derivations rather than as two literals, so a drift in either one reds here instead of
// producing a created-but-unused directory beside an unwritable receipt.
test fn the_bootstrapped_directory_is_where_the_receipt_goes() -> Bool {
  let dir = gunbc.host_layout.instance_receipts_dir(instance_root: "/opt/gunbc")
  let receipt = gunbc.roadmap_belt_actuate.belt_tick_receipt_path_for_instance(instance: gunbc.roadmap_dashboard_instance.srv1_live_dashboard_instance())
  has_command(cmds: belt_upsert_commands(), want: join(["sudo -n install -d -m 0755 -o briansrls -g briansrls ", dir], ""))
    && receipt == join([dir, "/belt-last-tick.json"], "")
}
