module test.claim.typed_argv_exec_realization_witness

import extdeps.access.posix_effective_principal
import extdeps.access.posix_effective_principal { EffectivePosixPrincipalRead }
import extdeps.access.posix_effective_principal_read_op { posix_effective_principal_read_argv }
import extdeps.sudo.nopasswd_execute_probe {
  SudoNopasswdExecuteProbeShape,
  SudoNopasswdGrantListProbeShape,
  NopasswdExecuteCheck,
  NopasswdGrantListCheck,
}
import extdeps.sudo.nopasswd_execute_probe_check_op {
  sudo_nopasswd_execute_probe_argv,
  sudo_nopasswd_grant_list_probe_argv,
}
import gunbc.typed_argv_exec {
  typed_argv_exec_over_ssh,
  typed_argv_shell_safe_refusal_argv,
  TypedArgvExecConverged,
  TypedArgvExecRefused,
}
import gunbc.host_effect {
  HostOs,
  LocalShell,
  SudoNopasswdGrantListProbe,
  host_effect_read_evidence,
}
import gunbc.ci_deploy_access {
  deploy_access_read_principal_effect,
  deploy_access_sudo_probe_effect,
  deploy_access_apt_get_privileged_command,
  ci_deploy_srv1_access,
}
import gunbc.host_effect_realize { host_effect_apply }
import std.realization_reconcile { reconciliation_converged }
import gunbc.fleet_intent { srv1_host }
import gunbc.fleet_intent_network { operator_host_srv1 }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data typed_argv_exec_realization_note: String = "Wave C5 receipt: deploy-preflight probe effects realize through typed argv service operations (access.PosixEffectivePrincipal.Read, sudo.NopasswdExecuteProbe.Check, sudo.NopasswdGrantListProbe.Check) on LocalShell and gunbc.typed_argv_exec_over_ssh on SshShell — one argv shape per op, N transport handlers, no concat-shell. Package-managed binaries that may be absent use the grant-list operation rather than an execute check. Argv tokens outside the portable allowlist fail closed before ssh spawn."

test fn witness_posix_effective_principal_read_typed_argv_holds() -> Bool {
  let result = access.PosixEffectivePrincipal.Read(read: EffectivePosixPrincipalRead {})
  result.success && result.stdout == "ghrunner"
}

test fn witness_sudo_nopasswd_probe_typed_argv_holds() -> Bool {
  let cmd = deploy_access_apt_get_privileged_command()
  match cmd.grant.probe {
    NopasswdExecuteCheck { check_argv: check } => {
      let result = sudo.NopasswdExecuteProbe.Check(
        probe: SudoNopasswdExecuteProbeShape {
          command_path: cmd.grant.command_path,
          check_argv: check,
        }
      )
      result.success
    }
    NopasswdGrantListCheck => false
  }
}

test fn witness_sudo_nopasswd_grant_list_probe_typed_argv_holds() -> Bool {
  let probe = SudoNopasswdGrantListProbeShape {
    command_path: "/usr/bin/tailscale" as NonEmptyStr
  }
  let result = sudo.NopasswdGrantListProbe.Check(probe: probe)
  let argv = sudo_nopasswd_grant_list_probe_argv(probe: probe)
  result.success && argv == ["sudo", "-n", "-l", "/usr/bin/tailscale"]
}

test fn witness_read_principal_host_effect_apply_typed_argv_holds() -> Bool {
  reconciliation_converged(
    r: host_effect_apply(
      target: HostOs { node: srv1_host },
      effect: deploy_access_read_principal_effect(),
      evidence: host_effect_read_evidence,
      transport: LocalShell,
    )
  )
}

test fn witness_sudo_probe_host_effect_apply_typed_argv_holds() -> Bool {
  reconciliation_converged(
    r: host_effect_apply(
      target: HostOs { node: srv1_host },
      effect: deploy_access_sudo_probe_effect(cmd: deploy_access_apt_get_privileged_command()),
      evidence: host_effect_read_evidence,
      transport: LocalShell,
    )
  )
}

test fn witness_tailscale_grant_list_host_effect_apply_typed_argv_holds() -> Bool {
  reconciliation_converged(
    r: host_effect_apply(
      target: HostOs { node: srv1_host },
      effect: deploy_access_sudo_probe_effect(
        cmd: ci_deploy_srv1_access.privileged_commands.skip(n: 4).first()
      ),
      evidence: host_effect_read_evidence,
      transport: LocalShell,
    )
  )
}

test fn witness_tailscale_roster_selects_grant_list_not_execute_probe() -> Bool {
  match deploy_access_sudo_probe_effect(
    cmd: ci_deploy_srv1_access.privileged_commands.skip(n: 4).first()
  ) {
    SudoNopasswdGrantListProbe { probe: p } =>
      p.command_path == "/usr/bin/tailscale"
    _ => false
  }
}

test fn witness_ssh_argv_exec_clean_token_holds() -> Bool {
  match typed_argv_exec_over_ssh(
    host: operator_host_srv1 as NonEmptyStr,
    argv: posix_effective_principal_read_argv(),
  ) {
    TypedArgvExecConverged { result: r } => r.success
    TypedArgvExecRefused { reason: _ } => false
  }
}

test fn witness_ssh_argv_allowlist_semicolon_red_holds() -> Bool {
  match typed_argv_shell_safe_refusal_argv(argv: ["whoami;rm"]) {
    Present { value: why } => string_contains(s: why, pattern: "allowlist")
    Absent => false
  }
}

test fn witness_ssh_argv_allowlist_pipe_red_holds() -> Bool {
  match typed_argv_shell_safe_refusal_argv(argv: ["echo", "a|b"]) {
    Present { value: _ } => true
    Absent => false
  }
}

test fn witness_ssh_argv_allowlist_dollar_red_holds() -> Bool {
  match typed_argv_shell_safe_refusal_argv(argv: ["$(whoami)"]) {
    Present { value: _ } => true
    Absent => false
  }
}

test fn witness_ssh_argv_allowlist_backtick_red_holds() -> Bool {
  match typed_argv_shell_safe_refusal_argv(argv: ["whoami`id`"]) {
    Present { value: why } => string_contains(s: why, pattern: "allowlist")
    Absent => false
  }
}

test fn witness_ssh_argv_allowlist_ampersand_red_holds() -> Bool {
  match typed_argv_shell_safe_refusal_argv(argv: ["echo", "a&b"]) {
    Present { value: _ } => true
    Absent => false
  }
}

test fn witness_ssh_argv_allowlist_redirect_red_holds() -> Bool {
  match typed_argv_shell_safe_refusal_argv(argv: ["echo", "a>b"]) {
    Present { value: _ } => true
    Absent => false
  }
}

test fn witness_ssh_argv_allowlist_whitespace_red_holds() -> Bool {
  match typed_argv_shell_safe_refusal_argv(argv: ["a b"]) {
    Present { value: _ } => true
    Absent => false
  }
}

test fn witness_ssh_sudo_probe_argv_shape_matches_local_authority() -> Bool {
  let cmd = deploy_access_apt_get_privileged_command()
  match cmd.grant.probe {
    NopasswdExecuteCheck { check_argv: check } => {
      let probe = SudoNopasswdExecuteProbeShape {
        command_path: cmd.grant.command_path,
        check_argv: check,
      }
      match typed_argv_exec_over_ssh(
        host: operator_host_srv1 as NonEmptyStr,
        argv: sudo_nopasswd_execute_probe_argv(probe: probe),
      ) {
        TypedArgvExecConverged { result: r } => r.success
        TypedArgvExecRefused { reason: _ } => false
      }
    }
    NopasswdGrantListCheck => false
  }
}

test fn witness_ssh_sudo_grant_list_argv_shape_matches_local_authority() -> Bool {
  match typed_argv_exec_over_ssh(
    host: operator_host_srv1 as NonEmptyStr,
    argv: sudo_nopasswd_grant_list_probe_argv(
      probe: SudoNopasswdGrantListProbeShape {
        command_path: "/usr/bin/tailscale" as NonEmptyStr
      }
    ),
  ) {
    TypedArgvExecConverged { result: r } => r.success
    TypedArgvExecRefused { reason: _ } => false
  }
}

test fn witness_ssh_sudo_grant_list_unsafe_path_refuses() -> Bool {
  match typed_argv_exec_over_ssh(
    host: operator_host_srv1 as NonEmptyStr,
    argv: sudo_nopasswd_grant_list_probe_argv(
      probe: SudoNopasswdGrantListProbeShape {
        command_path: "/usr/bin/not safe" as NonEmptyStr
      }
    ),
  ) {
    TypedArgvExecConverged { result: _ } => false
    TypedArgvExecRefused { reason: why } => string_contains(s: why, pattern: "allowlist")
  }
}
