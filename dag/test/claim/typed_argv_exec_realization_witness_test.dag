module test.claim.typed_argv_exec_realization_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

data typed_argv_exec_realization_note: String = "Wave C5 receipt: deploy-preflight probe effects realize through typed argv service operations (access.PosixEffectivePrincipal.Read, sudo.NopasswdExecuteProbe.Check, sudo.NopasswdGrantList.Read) on LocalShell and gunbc.typed_argv_exec_over_ssh on SshShell — one argv shape per op, N transport handlers, no concat-shell. Package-managed binaries that may be absent use the grant-list read plus exact NOPASSWD-row parser rather than an execute check. The list query's exit status alone is never treated as authorization. Argv tokens outside the portable allowlist fail closed before ssh spawn."

test fn witness_posix_effective_principal_read_typed_argv_holds() -> Bool {
  let result = access.PosixEffectivePrincipal.Read(read: extdeps.access.posix_effective_principal.EffectivePosixPrincipalRead {})
  result.exit_code == 1
    && !result.success
    && result.stdout == ""
    && result.stderr == "hermetic effective-principal observation unavailable"
}

test fn witness_sudo_nopasswd_probe_typed_argv_holds() -> Bool {
  let cmd = deploy_access_apt_get_privileged_command()
  match cmd.grant.probe {
    NopasswdExecuteCheck { check_argv: check } => {
      let result = sudo.NopasswdExecuteProbe.Check(
        probe: extdeps.sudo.nopasswd_execute_probe.SudoNopasswdExecuteProbeShape {
          command_path: cmd.grant.command_path,
          check_argv: check,
        }
      )
      result.success
    }
    NopasswdGrantListCheck => false
  }
}

test fn witness_sudo_nopasswd_grant_list_probe_typed_argv_holds() -> Bool {
  let probe = "/usr/bin/tailscale" as extdeps.sudo.nopasswd_execute_probe.SudoNopasswdGrantListProbeShape
  let result = sudo.NopasswdGrantList.Read()
  let argv = sudo_nopasswd_grant_list_argv()
  result.success
    && sudo_nopasswd_grant_list_admits_probe(
      listing: result.stdout,
      probe: probe,
    )
    && argv == ["sudo", "-n", "-l"]
}

test fn witness_sudo_grant_list_password_only_refuses() -> Bool {
  !sudo_nopasswd_grant_list_admits_probe(
    listing: "User ghrunner may run the following commands:\n    (ALL) PASSWD: /usr/bin/tailscale",
    probe: "/usr/bin/tailscale" as extdeps.sudo.nopasswd_execute_probe.SudoNopasswdGrantListProbeShape,
  )
}

test fn witness_sudo_grant_list_other_nopasswd_does_not_admit_target() -> Bool {
  !sudo_nopasswd_grant_list_admits_probe(
    listing: "User ghrunner may run the following commands:\n    (ALL) NOPASSWD: /usr/bin/apt-get\n    (ALL) PASSWD: /usr/bin/tailscale",
    probe: "/usr/bin/tailscale" as extdeps.sudo.nopasswd_execute_probe.SudoNopasswdGrantListProbeShape,
  )
}

test fn witness_sudo_grant_list_prefix_collision_refuses() -> Bool {
  !sudo_nopasswd_grant_list_admits_probe(
    listing: "    (ALL) NOPASSWD: /usr/bin/tailscale-helper",
    probe: "/usr/bin/tailscale" as extdeps.sudo.nopasswd_execute_probe.SudoNopasswdGrantListProbeShape,
  )
}

test fn witness_read_principal_host_effect_apply_typed_argv_holds() -> Bool {
  match host_effect_apply(
    target: gunbc.host_effect.HostOs { node: srv1_host },
    effect: deploy_access_read_principal_effect(),
    evidence: host_effect_read_evidence,
    transport: LocalShell,
  ) {
    Converged { evidence: _, applied: _ } => false
    NotConverged { reason: reason, applied: _ } =>
      string_contains(s: reason, pattern: "hermetic effective-principal observation unavailable")
  }
}

test fn witness_sudo_probe_host_effect_apply_typed_argv_holds() -> Bool {
  reconciliation_converged(
    r: host_effect_apply(
      target: gunbc.host_effect.HostOs { node: srv1_host },
      effect: deploy_access_sudo_probe_effect(cmd: deploy_access_apt_get_privileged_command()),
      evidence: host_effect_read_evidence,
      transport: LocalShell,
    )
  )
}

test fn witness_tailscale_grant_list_host_effect_apply_typed_argv_holds() -> Bool {
  reconciliation_converged(
    r: host_effect_apply(
      target: gunbc.host_effect.HostOs { node: srv1_host },
      effect: deploy_access_sudo_probe_effect(
        cmd: ci_deploy_srv1_access.privileged_commands.skip(n: 4).first()
      ),
      evidence: host_effect_read_evidence,
      transport: LocalShell,
    )
  )
}

test fn witness_tailscale_roster_selects_grant_list_not_execute_probe() -> Bool {
  match deploy_access_sudo_probe_effect(
    cmd: ci_deploy_srv1_access.privileged_commands.skip(n: 4).first()
  ) {
    SudoNopasswdGrantListProbe { probe: p } =>
      p as String == "/usr/bin/tailscale"
    _ => false
  }
}

test fn witness_ssh_argv_exec_clean_token_holds() -> Bool {
  match typed_argv_exec_over_ssh(
    host: operator_host_srv1 as std.types.NonEmptyStr,
    argv: posix_effective_principal_read_argv(),
  ) {
    TypedArgvExecConverged { result: r } => r.success
    TypedArgvExecRefused { reason: _ } => false
  }
}

test fn witness_ssh_argv_allowlist_semicolon_red_holds() -> Bool {
  match typed_argv_shell_safe_refusal_argv(argv: ["whoami;rm"]) {
    Present { value: why } => string_contains(s: why, pattern: "allowlist")
    Absent => false
  }
}

test fn witness_ssh_argv_allowlist_pipe_red_holds() -> Bool {
  match typed_argv_shell_safe_refusal_argv(argv: ["echo", "a|b"]) {
    Present { value: _ } => true
    Absent => false
  }
}

test fn witness_ssh_argv_allowlist_dollar_red_holds() -> Bool {
  match typed_argv_shell_safe_refusal_argv(argv: ["$(whoami)"]) {
    Present { value: _ } => true
    Absent => false
  }
}

test fn witness_ssh_argv_allowlist_backtick_red_holds() -> Bool {
  match typed_argv_shell_safe_refusal_argv(argv: ["whoami`id`"]) {
    Present { value: why } => string_contains(s: why, pattern: "allowlist")
    Absent => false
  }
}

test fn witness_ssh_argv_allowlist_ampersand_red_holds() -> Bool {
  match typed_argv_shell_safe_refusal_argv(argv: ["echo", "a&b"]) {
    Present { value: _ } => true
    Absent => false
  }
}

test fn witness_ssh_argv_allowlist_redirect_red_holds() -> Bool {
  match typed_argv_shell_safe_refusal_argv(argv: ["echo", "a>b"]) {
    Present { value: _ } => true
    Absent => false
  }
}

test fn witness_ssh_argv_allowlist_whitespace_red_holds() -> Bool {
  match typed_argv_shell_safe_refusal_argv(argv: ["a b"]) {
    Present { value: _ } => true
    Absent => false
  }
}

test fn witness_ssh_sudo_probe_argv_shape_matches_local_authority() -> Bool {
  let cmd = deploy_access_apt_get_privileged_command()
  match cmd.grant.probe {
    NopasswdExecuteCheck { check_argv: check } => {
      let probe = extdeps.sudo.nopasswd_execute_probe.SudoNopasswdExecuteProbeShape {
        command_path: cmd.grant.command_path,
        check_argv: check,
      }
      match typed_argv_exec_over_ssh(
        host: operator_host_srv1 as std.types.NonEmptyStr,
        argv: sudo_nopasswd_execute_probe_argv(probe: probe),
      ) {
        TypedArgvExecConverged { result: r } => r.success
        TypedArgvExecRefused { reason: _ } => false
      }
    }
    NopasswdGrantListCheck => false
  }
}

test fn witness_ssh_sudo_grant_list_argv_shape_matches_local_authority() -> Bool {
  match typed_argv_exec_over_ssh(
    host: operator_host_srv1 as std.types.NonEmptyStr,
    argv: sudo_nopasswd_grant_list_argv(),
  ) {
    TypedArgvExecConverged { result: r } => r.success
    TypedArgvExecRefused { reason: _ } => false
  }
}

test fn witness_sudo_grant_list_exact_nopasswd_row_accepts() -> Bool {
  sudo_nopasswd_grant_list_admits_probe(
    listing: "    (ALL) NOPASSWD: /usr/bin/tailscale",
    probe: "/usr/bin/tailscale" as extdeps.sudo.nopasswd_execute_probe.SudoNopasswdGrantListProbeShape,
  )
}
