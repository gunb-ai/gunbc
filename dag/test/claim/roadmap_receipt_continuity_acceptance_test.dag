module test.claim.roadmap_receipt_continuity_acceptance


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

data unreadable_carrier_text_fixture: String = "{ not json"

fn fixture_history() -> List<gunbc.roadmap_model.RoadmapAcceptanceEvent> {
  match load_roadmap_acceptance_event_history_from_carrier_text(
    text: receipt_continuity_acceptance_carrier_fixture_text,
  ) {
    RoadmapAcceptanceEventHistoryLoaded { events: events } => events
    RoadmapAcceptanceEventHistoryLoadRefused { detail: _ } => []
  }
}

fn namespace_occurrence_transport_receipt() -> gunbc.roadmap_model.RoadmapAcceptanceReceipt {
  first(
    project_live_acceptance_receipts(history: fixture_history())
      |> filter(r => r.node == nid(s: "namespace-occurrence-transport")),
  )
}

fn history_without_namespace_occurrence_transport() -> List<gunbc.roadmap_model.RoadmapAcceptanceEvent> {
  fixture_history()
    |> filter(e =>
      match e {
        AcceptanceRecorded { receipt: r } => r.node != nid(s: "namespace-occurrence-transport")
        AcceptanceRevoked { exact_prior_receipt: _, disposition: _, reason: _, revoked_by: _, revoked_on: _ } => true
      }
    )
}

fn exact_revocation_for(receipt: gunbc.roadmap_model.RoadmapAcceptanceReceipt) -> gunbc.roadmap_model.RoadmapAcceptanceEvent {
  gunbc.roadmap_model.AcceptanceRevoked {
    exact_prior_receipt: receipt,
    disposition: gunbc.roadmap_model.AcceptanceNodeReopensActiveFrontier {},
    reason: "fixture revocation witness" as std.types.NonEmptyStr,
    revoked_by: "operator" as std.types.NonEmptyStr,
    revoked_on: "2026-08-04" as std.types.NonEmptyStr,
  }
}

fn history_with_exact_revocation_for_namespace_occurrence_transport() -> List<gunbc.roadmap_model.RoadmapAcceptanceEvent> {
  let receipt = namespace_occurrence_transport_receipt()
  concat(fixture_history(), [exact_revocation_for(receipt: receipt)])
}

fn history_with_mutated_first_event_accepted_on() -> List<gunbc.roadmap_model.RoadmapAcceptanceEvent> {
  let events = fixture_history()
  match first(events) {
    Absent => events
    Present { value: event } =>
      match event {
        AcceptanceRecorded { receipt: r } =>
          concat(
            [gunbc.roadmap_model.AcceptanceRecorded {
              receipt: gunbc.roadmap_model.RoadmapAcceptanceReceipt {
                node: r.node,
                criteria_digest: r.criteria_digest,
                red_control: r.red_control,
                handback: r.handback,
                accepted_by: r.accepted_by,
                accepted_on: "1970-01-01" as std.types.NonEmptyStr,
              },
            }],
            drop_first_acceptance_event(events: events),
          )
        AcceptanceRevoked { exact_prior_receipt: _, disposition: _, reason: _, revoked_by: _, revoked_on: _ } =>
          events
      }
  }
}

test fn roadmap_receipt_continuity_acceptance_contract_holds() -> Bool {
  witness_deleted_history_event_refuses()
    && witness_deleted_event_and_prior_prefix_refuses()
    && witness_wrong_prior_digest_in_revocation_refuses()
    && witness_revocation_while_exact_receipt_live_refuses()
    && witness_duplicate_revocations_refuse()
    && witness_exact_revocation_admits_vanished_receipt()
    && witness_criteria_rewrite_with_receipt_retained_refuses_node_acceptance()
    && witness_git_refusal_observation_refuses_integrity()
    && witness_non_empty_prior_prefix_law_catches_deletion_without_seal_coedit()
    && witness_changed_history_empty_prior_bypass_admits_deletion_observed_prior_refuses()
    && witness_digest_field_mutation_without_revocation_refuses_prefix()
    && witness_accepted_node_ids_projection_refuses_when_receipts_projection_refuses()
    && witness_receipts_projection_refuses_when_history_load_refuses()
    && witness_unreadable_carrier_text_refuses_load_with_line_parse_detail()
    && witness_unreadable_merge_base_carrier_parse_refuses_prior_observation()
    && witness_missing_carrier_prevents_silent_empty_authority_projection()
    && witness_dispatch_never_presents_empty_frontier_on_authority_refusal()
}

test fn witness_deleted_history_event_refuses() -> Bool {
  let prior = fixture_history()
  let current = drop_first_acceptance_event(events: prior)
  !acceptance_history_integrity_holds(
    history: current,
    prior_history: prior,
  )
}

test fn witness_deleted_event_and_prior_prefix_refuses() -> Bool {
  let prior = fixture_history()
  let current = history_without_namespace_occurrence_transport()
  !acceptance_history_integrity_holds(
    history: current,
    prior_history: prior,
  )
    && !acceptance_history_extends_prior(prior: prior, current: current)
}

test fn witness_wrong_prior_digest_in_revocation_refuses() -> Bool {
  let receipt = namespace_occurrence_transport_receipt()
  let wrong = gunbc.roadmap_model.RoadmapAcceptanceReceipt {
    node: receipt.node,
    criteria_digest: receipt.criteria_digest,
    red_control: receipt.red_control,
    handback: receipt.handback,
    accepted_by: receipt.accepted_by,
    accepted_on: "1970-01-01" as std.types.NonEmptyStr,
  }
  let history = concat(
    fixture_history(),
    [exact_revocation_for(receipt: wrong)],
  )
  !acceptance_history_integrity_holds(
    history: history,
    prior_history: [],
  )
}

test fn witness_revocation_while_exact_receipt_live_refuses() -> Bool {
  let receipt = namespace_occurrence_transport_receipt()
  let history = concat(
    history_without_namespace_occurrence_transport(),
    [exact_revocation_for(receipt: receipt)],
  )
  !acceptance_history_integrity_holds(
    history: history,
    prior_history: [],
  )
}

test fn witness_duplicate_revocations_refuse() -> Bool {
  let receipt = namespace_occurrence_transport_receipt()
  let revoke = exact_revocation_for(receipt: receipt)
  let history = concat(fixture_history(), [revoke, revoke])
  !acceptance_history_integrity_holds(
    history: history,
    prior_history: [],
  )
}

test fn witness_criteria_rewrite_with_receipt_retained_refuses_node_acceptance() -> Bool {
  let victims = declared_roadmap_nodes()
    |> filter(n => n.node == nid(s: "namespace-occurrence-transport"))
  count(victims) == 1
    && all(victims, n => {
      let receipt = namespace_occurrence_transport_receipt()
      let wrong_digest = first(
        project_live_acceptance_receipts(history: fixture_history())
          |> filter(r => r.node != receipt.node),
      ).criteria_digest
      let planted = gunbc.roadmap_model.RoadmapAcceptanceReceipt {
        node: receipt.node,
        criteria_digest: wrong_digest,
        red_control: receipt.red_control,
        handback: receipt.handback,
        accepted_by: receipt.accepted_by,
        accepted_on: receipt.accepted_on,
      }
      let history = fixture_history() |> map(e =>
        match e {
          AcceptanceRecorded { receipt: r } =>
            if r.node == receipt.node {
              gunbc.roadmap_model.AcceptanceRecorded { receipt: planted }
            } else {
              e
            }
          AcceptanceRevoked { exact_prior_receipt: _, disposition: _, reason: _, revoked_by: _, revoked_on: _ } => e
        }
      )
      !node_accepted(
        receipts: project_live_acceptance_receipts(history: history),
        rn: n,
      )
    })
}

test fn witness_exact_revocation_admits_vanished_receipt() -> Bool {
  let prior = fixture_history()
  let history = history_with_exact_revocation_for_namespace_occurrence_transport()
  acceptance_history_integrity_holds(
    history: history,
    prior_history: prior,
  )
    && acceptance_history_extends_prior(prior: prior, current: history)
    && !(
      project_live_acceptance_receipts(history: history)
        |> any(r => r.node == nid(s: "namespace-occurrence-transport"))
    )
}

test fn witness_git_show_exists_on_disk_but_not_in_ref_counts_as_path_absent() -> Bool {
  git_show_path_absent_at_ref(
    stderr: "fatal: path 'dag/gunbc/roadmap_acceptance_event_history.jsonl' exists on disk, but not in '9ce6526c528'",
  )
    && git_show_path_absent_at_ref(
      stderr: "fatal: path 'dag/gunbc/roadmap_acceptance_event_history.jsonl' does not exist in '9ce6526c528'",
    )
}

test fn witness_git_refusal_observation_refuses_integrity() -> Bool {
  !acceptance_history_integrity_holds_from_prior_observation_with_prior(
    observation: gunbc.roadmap_acceptance_history_observation.PriorHistoryGitObservationRefused {
      detail: "fixture planted git refusal",
    },
    history: fixture_history(),
  )
}

test fn witness_non_empty_prior_prefix_law_catches_deletion_without_seal_coedit() -> Bool {
  let prior = fixture_history()
  let current = drop_first_acceptance_event(events: prior)
  count(prior) > 0
    && !acceptance_history_integrity_holds(history: current, prior_history: prior)
}

test fn witness_changed_history_empty_prior_bypass_admits_deletion_observed_prior_refuses() -> Bool {
  let prior = fixture_history()
  let current = drop_first_acceptance_event(events: prior)
  count(prior) > count(current)
    && acceptance_history_integrity_holds(history: current, prior_history: [])
    && !acceptance_history_integrity_holds(history: current, prior_history: prior)
    && !acceptance_history_integrity_holds_from_prior_observation_with_prior(
      observation: gunbc.roadmap_acceptance_history_observation.PriorHistoryObserved { prior: prior },
      history: current,
    )
}

test fn witness_digest_field_mutation_without_revocation_refuses_prefix() -> Bool {
  let prior = fixture_history()
  let current = history_with_mutated_first_event_accepted_on()
  count(prior) > 0
    && !acceptance_history_extends_prior(prior: prior, current: current)
    && !acceptance_history_integrity_holds(history: current, prior_history: prior)
}

test fn witness_receipts_projection_refuses_when_history_load_refuses() -> Bool {
  match load_roadmap_acceptance_event_history_from_carrier_text(text: unreadable_carrier_text_fixture) {
    RoadmapAcceptanceEventHistoryLoaded { events: _ } => false
    RoadmapAcceptanceEventHistoryLoadRefused { detail: history_detail } =>
      match roadmap_acceptance_receipts_from_carrier_text(text: unreadable_carrier_text_fixture) {
        RoadmapAcceptanceReceiptsProjected { receipts: _ } => false
        RoadmapAcceptanceReceiptsProjectionRefused { detail: receipt_detail } =>
          receipt_detail == history_detail
            && string_contains(s: history_detail, pattern: "line 1:")
      }
  }
}

test fn witness_unreadable_carrier_text_refuses_load_with_line_parse_detail() -> Bool {
  match load_roadmap_acceptance_event_history_from_carrier_text(text: unreadable_carrier_text_fixture) {
    RoadmapAcceptanceEventHistoryLoaded { events: _ } => false
    RoadmapAcceptanceEventHistoryLoadRefused { detail: detail } =>
      string_contains(s: detail, pattern: "line 1:")
  }
}

test fn witness_accepted_node_ids_projection_refuses_when_receipts_projection_refuses() -> Bool {
  match roadmap_acceptance_receipts_from_carrier_text(text: unreadable_carrier_text_fixture) {
    RoadmapAcceptanceReceiptsProjected { receipts: _ } => false
    RoadmapAcceptanceReceiptsProjectionRefused { detail: receipt_detail } =>
      match accepted_roadmap_node_ids_projection_from_carrier_text(text: unreadable_carrier_text_fixture) {
        AcceptedRoadmapNodeIdsProjected { ids: _ } => false
        AcceptedRoadmapNodeIdsProjectionRefused { detail: node_detail } =>
          node_detail == receipt_detail
            && string_contains(s: node_detail, pattern: "line 1:")
      }
  }
}

test fn witness_unreadable_merge_base_carrier_parse_refuses_prior_observation() -> Bool {
  match prior_history_from_carrier_text(carrier_text: "not-jsonl-carrier\n") {
    PriorHistoryObserved { prior: _ } => false
    PriorHistoryGitObservationRefused { detail: detail } =>
      string_contains(s: detail, pattern: "merge-base carrier parse refused")
  }
}

test fn witness_missing_carrier_prevents_silent_empty_authority_projection() -> Bool {
  match roadmap_authority_projection_from_carrier_text(text: unreadable_carrier_text_fixture) {
    RoadmapAuthorityProjectionRefused { detail: detail } =>
      string_contains(s: detail, pattern: "line 1:")
    RoadmapAuthorityProjected { doc: doc, accepted: _ } => count(doc_all_nodes(doc: doc)) == 0
  }
    && match roadmap_authority_projection_from_carrier_text(
      text: receipt_continuity_acceptance_carrier_fixture_text,
    ) {
      RoadmapAuthorityProjected { doc: doc, accepted: _ } => count(doc_all_nodes(doc: doc)) > 0
      RoadmapAuthorityProjectionRefused { detail: _ } => false
    }
}

test fn witness_dispatch_never_presents_empty_frontier_on_authority_refusal() -> Bool {
  let refused = gunbc.roadmap_authority.RoadmapAuthorityProjectionRefused { detail: "fixture planted projection refusal" }
  let projected = roadmap_authority_projection_from_carrier_text(
    text: receipt_continuity_acceptance_carrier_fixture_text,
  )
  let refused_dispatch = roadmap_dispatch_file_content_for_projection(proj: refused)
  string_contains(s: refused_dispatch, pattern: "fixture planted projection refusal")
    && string_contains(s: refused_dispatch, pattern: "\"refused\": true")
    && !string_contains(s: refused_dispatch, pattern: "\"brief_template\": ")
    && match projected {
      RoadmapAuthorityProjected { doc: _, accepted: _ } => {
        let dispatch = roadmap_dispatch_file_content_for_projection(proj: projected)
        string_contains(s: dispatch, pattern: "\"brief_template\": ")
          && string_contains(s: dispatch, pattern: "\"dispatch\": ")
          && string_contains(s: dispatch, pattern: "\"schema\": \"roadmap-dispatch/v1\"")
          && !string_contains(s: dispatch, pattern: "\"refused\": true")
      }
      RoadmapAuthorityProjectionRefused { detail: _ } => false
    }
}
