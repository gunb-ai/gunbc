module test.claim.falsifier_workflow_witness_test



data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn falsifier_cron_renders_every_four_hours_utc() -> Bool {
  render_cron_schedule(s: falsifier_cadence_cron) == "0 0,4,8,12,16,20 * * *"
}

test fn falsifier_cron_render_discriminates() -> Bool {
  !(render_cron_schedule(s: falsifier_cadence_cron) == "0 7 * * *")
}

test fn falsifier_concurrency_queues_not_cancels() -> Bool {
  match falsifier_workflow.concurrency {
    Present { value: spec } =>
      match spec {
        ConcurrencyMappingQueueNotMax { group: g, cancel_in_progress: cip, explicit_single: _ } =>
          g == "affected-set-falsifier" &&
            match cip {
              Present { value: c } =>
                match c {
                  CancelInProgressBool { value: v } => !v
                  _ => false
                }
              _ => false
            }
        _ => false
      }
    _ => false
  }
}

test fn falsifier_step_timeout_basis_is_measured_not_composed() -> Bool {
  gunbc_falsifier_step_timeout_basis_is_measured_not_composed()
}

test fn falsifier_backstop_is_step_sum_plus_prelude() -> Bool {
  gunbc_falsifier_job_backstop_timeout_minutes() == (gunbc_ci_release_build_step_timeout_minutes + gunbc_ci_aux_step_timeout_minutes + gunbc_ci_artifact_transfer_step_timeout_minutes + gunbc_ci_prelude_allowance_minutes + gunbc_ci_artifact_transfer_step_timeout_minutes + gunbc_ci_aux_step_timeout_minutes + gunbc_ci_selection_control_step_timeout_minutes + gunbc_ci_prelude_allowance_minutes + gunbc_ci_artifact_transfer_step_timeout_minutes + gunbc_ci_aux_step_timeout_minutes + gunbc_ci_aux_step_timeout_minutes + gunbc_falsifier_step_timeout_minutes + gunbc_ci_artifact_transfer_step_timeout_minutes + gunbc_ci_artifact_transfer_step_timeout_minutes + gunbc_ci_aux_step_timeout_minutes + gunbc_falsifier_compile_clean_cold_control_timeout_minutes + gunbc_falsifier_native_cache_cold_control_timeout_minutes + gunbc_ci_aux_step_timeout_minutes + gunbc_ci_prelude_allowance_minutes + gunbc_ci_artifact_transfer_step_timeout_minutes + gunbc_ci_aux_step_timeout_minutes + gunbc_ci_prelude_allowance_minutes)
    && gunbc_falsifier_job_backstop_timeout_minutes() == (gunbc_falsifier_build_job_backstop_timeout_minutes() + gunbc_falsifier_selection_control_job_backstop_timeout_minutes() + gunbc_falsifier_cold_corpus_job_backstop_timeout_minutes() + gunbc_falsifier_aggregate_verdict_job_backstop_timeout_minutes())
    && !(gunbc_falsifier_job_backstop_timeout_minutes() == gunbc_falsifier_step_timeout_minutes)
}

data falsifier_soft_deadline_witness_note: String = "The soft deadline's ONE correctness property is an ordering, not a value: it must fall strictly inside the step cap it is subtracted from, because a deadline at or past the runner's SIGKILL cannot fire and would be a mechanism that exists without ever executing. Asserting the derivation rather than the number 167 is what makes that survive a re-basis of the cap — the pair below moves together by construction, and a witness pinned to a literal would have to be edited in the same change and could be edited wrongly. The strict-inequality half is the load-bearing one; the positive-allowance half is what forbids the degenerate derivation where allowance is zero and the two collapse onto the same instant."

test fn falsifier_soft_deadline_is_derived_and_strictly_inside_the_hard_cap() -> Bool {
  gunbc_falsifier_soft_deadline_precedes_the_hard_kill()
    && gunbc_falsifier_soft_deadline_minutes() == (gunbc_falsifier_step_timeout_minutes - gunbc_falsifier_receipt_flush_allowance_minutes)
    && gunbc_falsifier_soft_deadline_minutes() < gunbc_falsifier_step_timeout_minutes
}

data selection_control_step_name: String = "Affected-set selection control (floor_skip_discovery_witness)"

test fn selection_control_rides_falsifier_not_per_pr_ci() -> Bool {
  string_contains(s: expected_falsifier_yml(), pattern: selection_control_step_name)
    && !string_contains(s: expected_ci_yml(), pattern: selection_control_step_name)
}

data selection_control_order_witness_note: String = "STRUCTURAL order pin (2026-08-07 four-job topology): selection-control job holds exactly one control step after release-bin unpack; cold-corpus job holds peak bracket + falsifier_step + cold controls. cold-corpus needs only falsifier-build so selector RED cannot skip the corpus."

fn step_index_of(steps: List<Step>, name: String) -> Int {
  let seen = fold(steps, init: { idx: 0, hit: 0 - 1 }, f: fn(acc, s) {
    if step_display_name(s: s) == name {
      if acc.hit >= 0 { { idx: acc.idx + 1, hit: acc.hit } } else { { idx: acc.idx + 1, hit: acc.idx } }
    } else {
      { idx: acc.idx + 1, hit: acc.hit }
    }
  })
  seen.hit
}

fn step_count_named(steps: List<Step>, name: String) -> Int {
  fold(steps, init: 0, f: fn(n, s) {
    if step_display_name(s: s) == name { n + 1 } else { n }
  })
}

fn falsifier_job_steps(job_id: String) -> List<Step> {
  fold(falsifier_workflow.jobs, init: [], f: fn(acc, j) {
    if j.id == job_id { j.steps } else { acc }
  })
}

fn falsifier_build_job_steps() -> List<Step> {
  falsifier_job_steps(job_id: "falsifier-build")
}

fn falsifier_selection_control_job_steps() -> List<Step> {
  falsifier_job_steps(job_id: "selection-control")
}

fn falsifier_cold_corpus_job_steps() -> List<Step> {
  falsifier_job_steps(job_id: "cold-corpus")
}

fn ci_job_steps() -> List<Step> {
  fold(ci_workflow.jobs, init: [], f: fn(acc, j) {
    if j.id == "ci" { j.steps } else { acc }
  })
}

test fn selection_control_sits_after_unpack_in_selection_job() -> Bool {
  let steps = falsifier_selection_control_job_steps()
  let unpack = step_index_of(steps: steps, name: "Unpack + verify release bins (claim_executor --verify-build-artifacts; fail-closed)")
  let control = step_index_of(steps: steps, name: selection_control_step_name)
  (unpack >= 0) && (control >= 0) && (unpack < control)
}

test fn cold_corpus_job_needs_build_only_not_selection() -> Bool {
  fold(falsifier_workflow.jobs, init: false, f: fn(acc, j) {
    if j.id == falsifier_cold_corpus_job_id {
      any(j.needs, n => n == "falsifier-build")
        && !any(j.needs, n => n == "selection-control")
    } else {
      acc
    }
  })
}

test fn falsifier_has_four_jobs_in_topology_order() -> Bool {
  count(falsifier_workflow.jobs) == 4
    && falsifier_workflow.jobs[0].id == "falsifier-build"
    && falsifier_workflow.jobs[1].id == "selection-control"
    && falsifier_workflow.jobs[2].id == falsifier_cold_corpus_job_id
    && falsifier_workflow.jobs[3].id == "aggregate-verdict"
}

test fn selection_control_enrolled_exactly_once_on_falsifier_and_never_on_ci() -> Bool {
  step_count_named(steps: falsifier_build_job_steps(), name: selection_control_step_name) == 0
    && step_count_named(steps: falsifier_selection_control_job_steps(), name: selection_control_step_name) == 1
    && step_count_named(steps: falsifier_cold_corpus_job_steps(), name: selection_control_step_name) == 0
    && step_count_named(steps: ci_job_steps(), name: selection_control_step_name) == 0
}

test fn peak_bracket_brackets_only_cold_corpus_floor_path() -> Bool {
  let steps = falsifier_cold_corpus_job_steps()
  let peak_pre = step_index_of(steps: steps, name: "Floor cgroup peak pre-read (calibration; reset if permitted)")
  let falsifier = step_index_of(steps: steps, name: "affected-set falsifier (predict-only cold run)")
  (peak_pre >= 0) && (falsifier >= 0) && (peak_pre < falsifier)
}

test fn falsifier_artifact_path_is_workflow_file() -> Bool {
  artifact_path(a: FalsifierYamlArtifact) == ".github/workflows/falsifier.yml"
}

test fn falsifier_yaml_projection_evaluates() -> Bool {
  length_of(s: expected_falsifier_yml()) > 0
}

test fn falsifier_cold_control_steps_follow_floor_in_job_order() -> Bool {
  let steps = falsifier_cold_corpus_job_steps()
  let floor = step_index_of(steps: steps, name: "affected-set falsifier (predict-only cold run)")
  let compile_clean = step_index_of(steps: steps, name: "compile-clean whole-tree cold control (scoped-PR admission counterpart)")
  let native_cache = step_index_of(steps: steps, name: "native-cache cold control (warm-tier admission counterpart)")
  (floor >= 0) && (compile_clean >= 0) && (native_cache >= 0)
    && (floor < compile_clean)
    && (compile_clean < native_cache)
}

data red_floor_cold_control_fixture_note: String = "Discriminating workflow fixture (operator ruling 2026-08-05, P0 merge condition on #7812): verified defect run 30935833427 — affected-set floor step reddened and compile-clean + native-cache cold controls SKIPPED because they inherited default success(). The repair is always()+release_bins success, NOT floor success."

test fn red_floor_workflow_fixture_cold_controls_still_execute() -> Bool {
  falsifier_cold_control_steps_follow_floor_in_job_order()
    && string_contains(s: expected_falsifier_yml(), pattern: falsifier_control_prerequisite_if)
    && string_contains(s: falsifier_control_prerequisite_if, pattern: "always()")
    && !string_contains(s: falsifier_control_prerequisite_if, pattern: "steps.floor")
}

test fn falsifier_red_floor_fixture_reds_if_prerequisite_requires_floor_success() -> Bool {
  let broken_gate = "success() && steps.floor.outcome == 'success'"
  falsifier_control_prerequisite_if != broken_gate
    && !string_contains(s: falsifier_control_prerequisite_if, pattern: "steps.floor.outcome == 'success'")
}

test fn aggregate_verdict_job_waits_for_all_arms() -> Bool {
  fold(falsifier_workflow.jobs, init: false, f: fn(acc, j) {
    if j.id == "aggregate-verdict" {
      j.if_condition == Present { value: falsifier_aggregate_verdict_if }
        && any(j.needs, n => n == "falsifier-build")
        && any(j.needs, n => n == "selection-control")
        && any(j.needs, n => n == falsifier_cold_corpus_job_id)
    } else {
      acc
    }
  })
}

test fn aggregate_verdict_shell_has_dissolve_on_marker() -> Bool {
  string_contains(s: expected_falsifier_yml(), pattern: dissolution_description(condition: falsifier_aggregate_verdict_shell_emit_dissolution_trigger))
}

test fn aggregate_verdict_shell_receipt_literals_match_model() -> Bool {
  let yml = expected_falsifier_yml()
  string_contains(s: yml, pattern: bash_escape_for_double_quotes(s: aggregate_shell_receipt_build_failed()))
    && string_contains(s: yml, pattern: bash_escape_for_double_quotes(s: aggregate_shell_receipt_build_cancelled()))
    && string_contains(s: yml, pattern: bash_escape_for_double_quotes(s: aggregate_shell_receipt_build_skipped()))
    && string_contains(s: yml, pattern: bash_escape_for_double_quotes(s: aggregate_shell_receipt_cold_skipped()))
    && string_contains(s: yml, pattern: bash_escape_for_double_quotes(s: aggregate_shell_receipt_cold_cancelled()))
    && string_contains(s: yml, pattern: bash_escape_for_double_quotes(s: aggregate_shell_receipt_cold_failed_before_receipt()))
    && string_contains(s: yml, pattern: bash_escape_for_double_quotes(s: aggregate_shell_receipt_cold_receipt_artifact_absent()))
    && string_contains(s: yml, pattern: bash_escape_for_double_quotes(s: aggregate_shell_receipt_corpus_executed()))
}

test fn aggregate_shell_receipt_builders_are_receipt_json_authority() -> Bool {
  aggregate_shell_receipt_build_failed() == cold_corpus_execution_receipt_json(
    c: classify_cold_corpus_execution(build: JobOutcomeFailure, cold: JobOutcomeSkipped, floor_receipt_present: false)
  )
    && aggregate_shell_receipt_build_cancelled() == cold_corpus_execution_receipt_json(
      c: classify_cold_corpus_execution(build: JobOutcomeCancelled, cold: JobOutcomeSkipped, floor_receipt_present: false)
    )
    && aggregate_shell_receipt_build_skipped() == cold_corpus_execution_receipt_json(
      c: classify_cold_corpus_execution(build: JobOutcomeSkipped, cold: JobOutcomeSkipped, floor_receipt_present: false)
    )
    && aggregate_shell_receipt_cold_skipped() == cold_corpus_execution_receipt_json(
      c: classify_cold_corpus_execution(build: JobOutcomeSuccess, cold: JobOutcomeSkipped, floor_receipt_present: false)
    )
    && aggregate_shell_receipt_cold_cancelled() == cold_corpus_execution_receipt_json(
      c: classify_cold_corpus_execution(build: JobOutcomeSuccess, cold: JobOutcomeCancelled, floor_receipt_present: false)
    )
    && aggregate_shell_receipt_cold_failed_before_receipt() == cold_corpus_execution_receipt_json(
      c: classify_cold_corpus_execution(build: JobOutcomeSuccess, cold: JobOutcomeFailure, floor_receipt_present: false)
    )
    && aggregate_shell_receipt_cold_receipt_artifact_absent() == cold_corpus_execution_receipt_json(
      c: classify_cold_corpus_execution(build: JobOutcomeSuccess, cold: JobOutcomeSuccess, floor_receipt_present: false)
    )
    && aggregate_shell_receipt_corpus_executed() == cold_corpus_execution_receipt_json(
      c: classify_cold_corpus_execution(build: JobOutcomeSuccess, cold: JobOutcomeFailure, floor_receipt_present: true)
    )
}

test fn aggregate_verdict_shell_distinguishes_build_cancelled_from_failed() -> Bool {
  string_contains(s: expected_falsifier_yml(), pattern: corpus_not_run_build_cancelled_tag)
    && string_contains(s: expected_falsifier_yml(), pattern: corpus_not_run_build_skipped_tag)
}

test fn aggregate_verdict_writes_cold_corpus_execution_receipt() -> Bool {
  string_contains(s: expected_falsifier_yml(), pattern: falsifier_cold_corpus_execution_receipt_path)
}

test fn cold_corpus_job_id_is_not_legacy_falsifier_job() -> Bool {
  !any(falsifier_workflow.jobs, j => j.id == "falsifier")
}

test fn aggregate_verdict_downloads_floor_component_receipt() -> Bool {
  string_contains(s: expected_falsifier_yml(), pattern: "Download floor component receipt (cold-corpus execution witness)")
    && string_contains(s: expected_falsifier_yml(), pattern: floor_component_receipt_artifact_name)
    && string_contains(s: expected_falsifier_yml(), pattern: "continue-on-error: true")
}

test fn cold_corpus_uploads_floor_phase_journal() -> Bool {
  string_contains(s: expected_falsifier_yml(), pattern: "Upload floor phase journal (survives killed floor)")
    && string_contains(s: expected_falsifier_yml(), pattern: ci_floor_phase_journal_artifact_name)
    && string_contains(s: expected_falsifier_yml(), pattern: "if-no-files-found: warn")
    && string_contains(s: expected_falsifier_yml(), pattern: "if: always()")
}

test fn aggregate_verdict_shell_checks_floor_receipt_schema() -> Bool {
  string_contains(s: expected_falsifier_yml(), pattern: floor_component_receipt_schema)
    && string_contains(s: expected_falsifier_yml(), pattern: corpus_not_run_cold_failed_before_receipt_tag)
}

test fn aggregate_verdict_floor_receipt_presence_test_has_no_spurious_bracket() -> Bool {
  string_contains(
    s: expected_falsifier_yml(),
    pattern: concat("grep -q ", concat(floor_component_receipt_schema, " target/floor-component-receipt.json; then"))
  )
    && !string_contains(s: expected_falsifier_yml(), pattern: "floor-component-receipt.json ]; then")
}

test fn aggregate_verdict_write_receipt_redirects_printf_on_same_line() -> Bool {
  let line = falsifier_aggregate_verdict_write_receipt(json: "{\"schema\":\"test\"}")
  string_contains(s: line, pattern: "> target/falsifier-cold-corpus-execution.json")
    && !string_contains(s: line, pattern: "\n > ")
}

test fn cold_corpus_executed_when_cold_job_ran_even_if_red() -> Bool {
  match classify_cold_corpus_execution(build: JobOutcomeSuccess, cold: JobOutcomeFailure, floor_receipt_present: true) {
    CorpusExecuted { receipt_path: path } => path == floor_component_receipt_path
    _ => false
  }
}

test fn cold_corpus_not_run_when_failed_before_receipt() -> Bool {
  match classify_cold_corpus_execution(build: JobOutcomeSuccess, cold: JobOutcomeFailure, floor_receipt_present: false) {
    CorpusNotRun { cause: ColdCorpusFailedBeforeReceipt } => true
    _ => false
  }
}

test fn cold_corpus_not_run_when_receipt_artifact_absent_on_success() -> Bool {
  match classify_cold_corpus_execution(build: JobOutcomeSuccess, cold: JobOutcomeSuccess, floor_receipt_present: false) {
    CorpusNotRun { cause: ColdCorpusReceiptArtifactAbsent } => true
    _ => false
  }
}

test fn cold_success_without_receipt_is_not_failed_before_receipt() -> Bool {
  match classify_cold_corpus_execution(build: JobOutcomeSuccess, cold: JobOutcomeSuccess, floor_receipt_present: false) {
    CorpusNotRun { cause: ColdCorpusFailedBeforeReceipt } => false
    CorpusNotRun { cause: ColdCorpusReceiptArtifactAbsent } => true
    _ => false
  }
}

test fn cold_failure_without_receipt_is_not_receipt_artifact_absent() -> Bool {
  match classify_cold_corpus_execution(build: JobOutcomeSuccess, cold: JobOutcomeFailure, floor_receipt_present: false) {
    CorpusNotRun { cause: ColdCorpusReceiptArtifactAbsent } => false
    CorpusNotRun { cause: ColdCorpusFailedBeforeReceipt } => true
    _ => false
  }
}

test fn cold_failure_without_receipt_is_not_corpus_executed() -> Bool {
  !cold_corpus_execution_is_executed(
    c: classify_cold_corpus_execution(build: JobOutcomeSuccess, cold: JobOutcomeFailure, floor_receipt_present: false)
  )
}

test fn cold_failure_with_receipt_is_corpus_executed_even_when_red() -> Bool {
  cold_corpus_execution_is_executed(
    c: classify_cold_corpus_execution(build: JobOutcomeSuccess, cold: JobOutcomeFailure, floor_receipt_present: true)
  )
}

test fn cold_corpus_not_run_when_build_failed() -> Bool {
  match classify_cold_corpus_execution(build: JobOutcomeFailure, cold: JobOutcomeSkipped, floor_receipt_present: false) {
    CorpusNotRun { cause: BuildJobFailed } => true
    _ => false
  }
}

test fn cold_corpus_not_run_is_not_regression_evidence() -> Bool {
  !cold_corpus_execution_is_executed(
    c: classify_cold_corpus_execution(build: JobOutcomeFailure, cold: JobOutcomeSkipped, floor_receipt_present: false)
  )
}

test fn selection_red_with_corpus_executed_still_counts_as_executed() -> Bool {
  cold_corpus_execution_is_executed(
    c: classify_cold_corpus_execution(build: JobOutcomeSuccess, cold: JobOutcomeFailure, floor_receipt_present: true)
  )
    && cadence_verdict_should_fail(
      build: JobOutcomeSuccess,
      selection: JobOutcomeFailure,
      cold: JobOutcomeFailure,
      floor_receipt_present: true
    )
}

test fn failed_before_receipt_still_fails_cadence() -> Bool {
  cadence_verdict_should_fail(
    build: JobOutcomeSuccess,
    selection: JobOutcomeSuccess,
    cold: JobOutcomeFailure,
    floor_receipt_present: false
  )
}

test fn cold_corpus_execution_receipt_json_discriminates_build_failed() -> Bool {
  string_contains(
    s: cold_corpus_execution_receipt_json(
      c: classify_cold_corpus_execution(build: JobOutcomeFailure, cold: JobOutcomeSkipped, floor_receipt_present: false)
    ),
    pattern: corpus_not_run_build_failed_tag
  )
    && cold_corpus_execution_tag(
      c: classify_cold_corpus_execution(build: JobOutcomeFailure, cold: JobOutcomeSkipped, floor_receipt_present: false)
    ) == corpus_not_run_tag
}

test fn cold_corpus_execution_receipt_json_discriminates_failed_before_receipt() -> Bool {
  string_contains(
    s: cold_corpus_execution_receipt_json(
      c: classify_cold_corpus_execution(build: JobOutcomeSuccess, cold: JobOutcomeFailure, floor_receipt_present: false)
    ),
    pattern: corpus_not_run_cold_failed_before_receipt_tag
  )
    && !string_contains(
      s: cold_corpus_execution_receipt_json(
        c: classify_cold_corpus_execution(build: JobOutcomeSuccess, cold: JobOutcomeFailure, floor_receipt_present: false)
      ),
      pattern: corpus_not_run_cold_receipt_artifact_absent_tag
    )
}

test fn cold_corpus_execution_receipt_json_discriminates_receipt_artifact_absent() -> Bool {
  string_contains(
    s: cold_corpus_execution_receipt_json(
      c: classify_cold_corpus_execution(build: JobOutcomeSuccess, cold: JobOutcomeSuccess, floor_receipt_present: false)
    ),
    pattern: corpus_not_run_cold_receipt_artifact_absent_tag
  )
    && !string_contains(
      s: cold_corpus_execution_receipt_json(
        c: classify_cold_corpus_execution(build: JobOutcomeSuccess, cold: JobOutcomeSuccess, floor_receipt_present: false)
      ),
      pattern: corpus_not_run_cold_failed_before_receipt_tag
    )
}

fn length_of(s: String) -> Int {
  s.length()
}

fn string_contains(s: String, pattern: String) -> Bool {
  s.contains(pattern)
}
