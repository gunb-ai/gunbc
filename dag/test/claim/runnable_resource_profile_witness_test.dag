module test.claim.runnable_resource_profile

data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

test fn witness_negligible_profile_is_not_heavy() -> Bool {
  !runnable_heavy_whole_tree_resolve(profile: runnable_resource_profile_negligible())
}

test fn witness_negligible_profile_declares_hermetic() -> Bool {
  let p = runnable_resource_profile_negligible()
  execution_mode_eq(left: p.execution_mode, right: std.execution_mode.Hermetic)
}

test fn witness_profile_eq_discriminates_execution_mode() -> Bool {
  let hermetic = runnable_resource_profile(
    heavy_whole_tree_resolve: false,
    spawns_host_compiler: false,
    memory: runnable_memory_substantial(),
    execution_mode: Hermetic
  )
  let wet = runnable_resource_profile(
    heavy_whole_tree_resolve: false,
    spawns_host_compiler: false,
    memory: runnable_memory_substantial(),
    execution_mode: Wet
  )
  runnable_resource_profile_eq(left: hermetic, right: hermetic)
    && !runnable_resource_profile_eq(left: hermetic, right: wet)
}

test fn witness_substantial_memory_forbids_corpus_co_residence() -> Bool {
  let heavy = std.realization_schedule.RunnableSingleClaim {
    entry: "e"
    function: "f"
    profile: runnable_resource_profile(
      heavy_whole_tree_resolve: false,
      spawns_host_compiler: false,
      memory: runnable_memory_substantial(),
      execution_mode: Wet
    )
  }
  runnable_forbids_corpus_co_residence(r: heavy)
}

test fn witness_corpus_never_forbids_co_residence() -> Bool {
  let corpus = std.realization_schedule.RunnableDiscoveryBatch {
    source_roots: []
    scan_dirs: []
    explicit_entries: []
    profile: runnable_resource_profile(
      heavy_whole_tree_resolve: true,
      spawns_host_compiler: false,
      memory: runnable_memory_substantial(),
      execution_mode: Wet
    )
    exclude_substrings: []
    discovery_scope_dirs: []
  }
  !runnable_forbids_corpus_co_residence(r: corpus)
}

test fn witness_memory_class_eq_discriminates_variants() -> Bool {
  runnable_memory_class_eq(left: runnable_memory_negligible(), right: runnable_memory_negligible())
    && runnable_memory_class_eq(left: runnable_memory_substantial(), right: runnable_memory_substantial())
    && !runnable_memory_class_eq(left: runnable_memory_negligible(), right: runnable_memory_substantial())
}

