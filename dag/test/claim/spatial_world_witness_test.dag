module test.claim.spatial_world_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn site() -> std.coordinate_frame.CoordinateFrameIdentity { std.coordinate_frame.coordinate_frame_identity(occurrence: 1) }

// The world's spaces are millimetre-framed, which is what makes a cubic-millimetre volume a true
// label rather than an assumed one.
fn mm_registry() -> std.spatial_frame.SpatialFrameRegistry {
  match std.spatial_frame.register_frame(r: std.spatial_frame.empty_frame_registry(), identity: site(), length_scale: std.measure.Milli) {
    std.spatial_frame.FrameRegistered { frame: f } => std.spatial_frame.registry_with(r: std.spatial_frame.empty_frame_registry(), f: f)
    std.spatial_frame.FrameRegistrationRefused { cause: _ } => std.spatial_frame.empty_frame_registry()
  }
}

fn rect(x0: Int, y0: Int, x1: Int, y1: Int) -> std.orthogonal_topology.EnclosedSpace? {
  match std.orthogonal_geometry.orthogonal_loop2(vertices: [
    std.affine_space.point2(frame: site(), x: x0, y: y0),
    std.affine_space.point2(frame: site(), x: x1, y: y0),
    std.affine_space.point2(frame: site(), x: x1, y: y1),
    std.affine_space.point2(frame: site(), x: x0, y: y1),
  ]) {
    std.orthogonal_geometry.OrthogonalRefused { cause: _ } => none
    std.orthogonal_geometry.OrthogonalReady { value: l } =>
      match std.orthogonal_geometry.orthogonal_prism3(footprint: l, low: 0, high: 2400) {
        std.orthogonal_geometry.OrthogonalRefused { cause: _ } => none
        std.orthogonal_geometry.OrthogonalReady { value: pr } => v2.std.optional.Present { value: std.orthogonal_topology.enclosed_space(shell: std.orthogonal_topology.closed_shell_of_prism(prism: pr)) }
      }
  }
}

fn placed(name: String, x0: Int, y0: Int, x1: Int, y1: Int) -> product.spatial_world.PlacedSpace? {
  match rect(x0: x0, y0: y0, x1: x1, y1: y1) {
    v2.std.optional.Absent => none
    v2.std.optional.Present { value: s } => v2.std.optional.Present { value: product.spatial_world.PlacedSpace { identity: (name as product.placement_supply.RoomIdentity), space: s } }
  }
}

// Fixtures travel as optionals for the reason the 3B witness threads constructions: an unwrap
// helper would need something to return on a refusal, and every candidate is a fabrication that
// makes a claim pass or fail for a reason unrelated to what it tests.
fn rooms_of(a: product.spatial_world.PlacedSpace?, b: product.spatial_world.PlacedSpace?) -> List<product.spatial_world.PlacedSpace>? {
  match a {
    v2.std.optional.Absent => none
    v2.std.optional.Present { value: pa } =>
      match b {
        v2.std.optional.Absent => none
        v2.std.optional.Present { value: pb } => v2.std.optional.Present { value: [pa, pb] }
      }
  }
}

fn kitchen() -> product.spatial_world.PlacedSpace? { placed(name: "kitchen", x0: 0, y0: 0, x1: 3000, y1: 3000) }
fn hall() -> product.spatial_world.PlacedSpace? { placed(name: "hall", x0: 3000, y0: 0, x1: 6000, y1: 3000) }

fn two_room_world() -> product.spatial_world.World? {
  match rooms_of(a: kitchen(), b: hall()) {
    v2.std.optional.Absent => none
    v2.std.optional.Present { value: rooms } =>
      match product.spatial_world.world(rooms: rooms) {
        product.spatial_world.WorldRefused { cause: _ } => none
        product.spatial_world.WorldReady { value: w } => v2.std.optional.Present { value: w }
      }
  }
}

fn volume_of(w: product.spatial_world.World) -> Int {
  match product.spatial_world.world_total_volume(registry: mm_registry(), w: w) {
    product.spatial_world.WorldRefused { cause: _ } => 0 - 1
    product.spatial_world.WorldReady { value: v } => std.measure.cubic_millimeter_count(m: v)
  }
}

test fn a_world_joins_identity_to_geometry_and_sums_its_rooms() -> Bool {
  match two_room_world() {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: w } => product.spatial_world.world_room_count(w: w) == 2 && volume_of(w: w) == 2 * 9000000 * 2400
  }
}

// Identity is allocated, never derived from shape: two rooms with byte-identical geometry in
// different places are different rooms, and the same identity twice is refused even when the two
// shapes are legal on their own.
test fn duplicate_room_identity_refuses() -> Bool {
  match rooms_of(a: kitchen(), b: placed(name: "kitchen", x0: 3000, y0: 0, x1: 6000, y1: 3000)) {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: rooms } =>
      match product.spatial_world.world(rooms: rooms) {
        product.spatial_world.WorldReady { value: _ } => false
        product.spatial_world.WorldRefused { cause: c } =>
          match c { product.spatial_world.DuplicateRoomIdentity { identity: _ } => true  _ => false }
      }
  }
}

// The geometry wall is not re-implemented here; it is the complex's, reached through the world
// mint and reported with the lower layer's own cause.
test fn overlapping_rooms_refuse_through_the_geometry_layer() -> Bool {
  match rooms_of(a: kitchen(), b: placed(name: "pantry", x0: 1000, y0: 1000, x1: 4000, y1: 2000)) {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: rooms } =>
      match product.spatial_world.world(rooms: rooms) {
        product.spatial_world.WorldReady { value: _ } => false
        product.spatial_world.WorldRefused { cause: c } =>
          match c {
            product.spatial_world.WorldGeometryRefused { cause: g } => match g { std.orthogonal_geometry.SpacesInterpenetrate => true  _ => false }
            _ => false
          }
      }
  }
}

fn empty_patch() -> std.change.KeyedPatch<product.placement_supply.RoomIdentity, std.orthogonal_topology.EnclosedSpace> {
  std.change.KeyedPatch { hunks: [] }
}

fn realized_room_count(v: product.spatial_world.WorldVariant) -> Int {
  match product.spatial_world.realize_variant(v: v) {
    product.spatial_world.WorldRefused { cause: _ } => 0 - 1
    product.spatial_world.WorldReady { value: w } => product.spatial_world.world_room_count(w: w)
  }
}

test fn an_empty_delta_realizes_to_the_base() -> Bool {
  match two_room_world() {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: base } =>
      let v = product.spatial_world.world_variant(base: base, delta: empty_patch())
      realized_room_count(v: v) == 2
        && match product.spatial_world.realize_variant(v: v) {
             product.spatial_world.WorldRefused { cause: _ } => false
             product.spatial_world.WorldReady { value: w } => volume_of(w: w) == volume_of(w: base)
           }
  }
}

test fn adding_a_room_through_a_delta_extends_the_world_and_leaves_the_base_alone() -> Bool {
  match two_room_world() {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: base } =>
      match rect(x0: 0, y0: 3000, x1: 3000, y1: 6000) {
        v2.std.optional.Absent => false
        v2.std.optional.Present { value: study } =>
          let v = product.spatial_world.world_variant(
            base: base,
            delta: std.change.KeyedPatch { hunks: [std.change.KeyedDiffAddedHunk { hunk_key: ("study" as product.placement_supply.RoomIdentity), to: study }] },
          )
          realized_room_count(v: v) == 3 && product.spatial_world.world_room_count(w: product.spatial_world.variant_base(v: v)) == 2
      }
  }
}

// THE WALL SURVIVES THE DELTA. A variant that slides one room into another is refused at
// realization by the same geometry authority a hand-built world meets, so there is no route to an
// overlapping world through the variant path.
test fn a_delta_that_makes_rooms_overlap_refuses_at_realization() -> Bool {
  match two_room_world() {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: base } =>
      match kitchen() {
        v2.std.optional.Absent => false
        v2.std.optional.Present { value: current } =>
          match rect(x0: 2000, y0: 0, x1: 5000, y1: 3000) {
            v2.std.optional.Absent => false
            v2.std.optional.Present { value: widened } =>
              let v = product.spatial_world.world_variant(
                base: base,
                delta: std.change.KeyedPatch { hunks: [std.change.KeyedDiffModifiedHunk {
                  hunk_key: ("kitchen" as product.placement_supply.RoomIdentity),
                  from: current.space,
                  to: widened,
                }] },
              )
              match product.spatial_world.realize_variant(v: v) {
                product.spatial_world.WorldReady { value: _ } => false
                product.spatial_world.WorldRefused { cause: c } =>
                  match c {
                    product.spatial_world.WorldGeometryRefused { cause: g } => match g { std.orthogonal_geometry.SpacesInterpenetrate => true  _ => false }
                    _ => false
                  }
              }
          }
      }
  }
}

// A MODIFIED HUNK IS A COMPARE-AND-SWAP. The `from` is checked against what is actually there, so a
// delta computed against a different base refuses instead of overwriting. This is the fact an
// upsert collapse discards, and the reason std.change's modified arm carries `from` at all.
test fn a_delta_computed_against_a_stale_base_refuses() -> Bool {
  match two_room_world() {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: base } =>
      match rect(x0: 0, y0: 0, x1: 2500, y1: 2500) {
        v2.std.optional.Absent => false
        v2.std.optional.Present { value: stale_from } =>
          match rect(x0: 0, y0: 0, x1: 2000, y1: 2000) {
            v2.std.optional.Absent => false
            v2.std.optional.Present { value: to } =>
              let v = product.spatial_world.world_variant(
                base: base,
                delta: std.change.KeyedPatch { hunks: [std.change.KeyedDiffModifiedHunk {
                  hunk_key: ("kitchen" as product.placement_supply.RoomIdentity),
                  from: stale_from,
                  to: to,
                }] },
              )
              match product.spatial_world.realize_variant(v: v) {
                product.spatial_world.WorldReady { value: _ } => false
                product.spatial_world.WorldRefused { cause: c } => match c { product.spatial_world.VariantBaseChanged { identity: _ } => true  _ => false }
              }
          }
      }
  }
}

// Neither absent-target arm absorbs: removing what is not there is not a no-op and adding what is
// already there is not a replace. Both would let a delta from another base apply cleanly.
test fn absent_and_present_targets_refuse_rather_than_absorbing() -> Bool {
  match two_room_world() {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: base } =>
      match kitchen() {
        v2.std.optional.Absent => false
        v2.std.optional.Present { value: k } =>
          let remove_missing = product.spatial_world.world_variant(
            base: base,
            delta: std.change.KeyedPatch { hunks: [std.change.KeyedDiffRemovedHunk { hunk_key: ("cellar" as product.placement_supply.RoomIdentity), from: k.space }] },
          )
          let add_existing = product.spatial_world.world_variant(
            base: base,
            delta: std.change.KeyedPatch { hunks: [std.change.KeyedDiffAddedHunk { hunk_key: ("kitchen" as product.placement_supply.RoomIdentity), to: k.space }] },
          )
          match product.spatial_world.realize_variant(v: remove_missing) {
            product.spatial_world.WorldReady { value: _ } => false
            product.spatial_world.WorldRefused { cause: c1 } =>
              match c1 {
                product.spatial_world.VariantTargetMissing { identity: _ } =>
                  match product.spatial_world.realize_variant(v: add_existing) {
                    product.spatial_world.WorldReady { value: _ } => false
                    product.spatial_world.WorldRefused { cause: c2 } =>
                      match c2 { product.spatial_world.VariantTargetAlreadyPresent { identity: _ } => true  _ => false }
                  }
                _ => false
              }
          }
      }
  }
}

test fn removing_a_room_shrinks_the_realized_world_only() -> Bool {
  match two_room_world() {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: base } =>
      match hall() {
        v2.std.optional.Absent => false
        v2.std.optional.Present { value: h } =>
          let v = product.spatial_world.world_variant(
            base: base,
            delta: std.change.KeyedPatch { hunks: [std.change.KeyedDiffRemovedHunk { hunk_key: ("hall" as product.placement_supply.RoomIdentity), from: h.space }] },
          )
          realized_room_count(v: v) == 1 && product.spatial_world.world_room_count(w: product.spatial_world.variant_base(v: v)) == 2
      }
  }
}

// Two variants over ONE base are independent because neither owns the base's rooms - the base is
// shared and unmodified, which is the property a copy-and-edit representation cannot offer.
test fn two_variants_over_one_base_do_not_see_each_other() -> Bool {
  match two_room_world() {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: base } =>
      match rect(x0: 0, y0: 3000, x1: 3000, y1: 6000) {
        v2.std.optional.Absent => false
        v2.std.optional.Present { value: study } =>
          match hall() {
            v2.std.optional.Absent => false
            v2.std.optional.Present { value: h } =>
              let grown = product.spatial_world.world_variant(base: base, delta: std.change.KeyedPatch { hunks: [std.change.KeyedDiffAddedHunk { hunk_key: ("study" as product.placement_supply.RoomIdentity), to: study }] })
              let shrunk = product.spatial_world.world_variant(base: base, delta: std.change.KeyedPatch { hunks: [std.change.KeyedDiffRemovedHunk { hunk_key: ("hall" as product.placement_supply.RoomIdentity), from: h.space }] })
              realized_room_count(v: grown) == 3
                && realized_room_count(v: shrunk) == 1
                && product.spatial_world.world_room_count(w: base) == 2
          }
      }
  }
}

fn rect_from(vs: List<std.affine_space.Point2>) -> std.orthogonal_topology.EnclosedSpace? {
  match std.orthogonal_geometry.orthogonal_loop2(vertices: vs) {
    std.orthogonal_geometry.OrthogonalRefused { cause: _ } => none
    std.orthogonal_geometry.OrthogonalReady { value: l } =>
      match std.orthogonal_geometry.orthogonal_prism3(footprint: l, low: 0, high: 2400) {
        std.orthogonal_geometry.OrthogonalRefused { cause: _ } => none
        std.orthogonal_geometry.OrthogonalReady { value: pr } => v2.std.optional.Present { value: std.orthogonal_topology.enclosed_space(shell: std.orthogonal_topology.closed_shell_of_prism(prism: pr)) }
      }
  }
}

fn corner(x: Int, y: Int) -> std.affine_space.Point2 { std.affine_space.point2(frame: site(), x: x, y: y) }

// THE SAME REGION WRITTEN THREE WAYS. orthogonal_loop2 keeps the caller's vertex sequence, choosing
// neither a canonical start nor a canonical winding, so a positional comparison called these three
// different spaces - and because space_eq is the compare-and-swap judgment, a geometrically
// identical patch was refusable as stale purely for starting at another corner.
test fn equal_regions_written_from_different_corners_and_windings_are_equal() -> Bool {
  match rect_from(vs: [corner(x: 0, y: 0), corner(x: 3000, y: 0), corner(x: 3000, y: 3000), corner(x: 0, y: 3000)]) {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: a } =>
      match rect_from(vs: [corner(x: 3000, y: 0), corner(x: 3000, y: 3000), corner(x: 0, y: 3000), corner(x: 0, y: 0)]) {
        v2.std.optional.Absent => false
        v2.std.optional.Present { value: shifted } =>
          match rect_from(vs: [corner(x: 0, y: 3000), corner(x: 3000, y: 3000), corner(x: 3000, y: 0), corner(x: 0, y: 0)]) {
            v2.std.optional.Absent => false
            v2.std.optional.Present { value: reversed } =>
              match rect_from(vs: [corner(x: 0, y: 0), corner(x: 3001, y: 0), corner(x: 3001, y: 3000), corner(x: 0, y: 3000)]) {
                v2.std.optional.Absent => false
                v2.std.optional.Present { value: moved_vertex } =>
                  std.orthogonal_topology.space_eq(a: a, b: shifted)
                    && std.orthogonal_topology.space_eq(a: a, b: reversed)
                    && !std.orthogonal_topology.space_eq(a: a, b: moved_vertex)
              }
          }
      }
  }
}

// A modification must not reorder the world. The delta describes a geometry change; realization
// performing an additional ordering change is a change with no hunk behind it.
test fn modifying_a_room_preserves_the_room_order() -> Bool {
  match rooms_of(a: kitchen(), b: hall()) {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: two } =>
      match placed(name: "study", x0: 0, y0: 3000, x1: 3000, y1: 6000) {
        v2.std.optional.Absent => false
        v2.std.optional.Present { value: st } =>
          match product.spatial_world.world(rooms: concat(two, [st])) {
            product.spatial_world.WorldRefused { cause: _ } => false
            product.spatial_world.WorldReady { value: base } =>
              match hall() {
                v2.std.optional.Absent => false
                v2.std.optional.Present { value: h } =>
                  match rect(x0: 3000, y0: 0, x1: 5500, y1: 3000) {
                    v2.std.optional.Absent => false
                    v2.std.optional.Present { value: narrower } =>
                      let v = product.spatial_world.world_variant(
                        base: base,
                        delta: std.change.KeyedPatch { hunks: [std.change.KeyedDiffModifiedHunk {
                          hunk_key: ("hall" as product.placement_supply.RoomIdentity),
                          from: h.space,
                          to: narrower,
                        }] },
                      )
                      match product.spatial_world.realize_variant(v: v) {
                        product.spatial_world.WorldRefused { cause: _ } => false
                        product.spatial_world.WorldReady { value: w } => room_names(w: w) == "kitchen|hall|study|"
                      }
                  }
              }
          }
      }
  }
}

fn room_names(w: product.spatial_world.World) -> String {
  fold(product.spatial_world.world_rooms(w: w), init: "", f: (acc, r) => concat(concat(acc, (r.identity as String)), "|"))
}

test fn space_equality_is_structural_and_frame_aware() -> Bool {
  match rect(x0: 0, y0: 0, x1: 3000, y1: 3000) {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: a } =>
      match rect(x0: 0, y0: 0, x1: 3000, y1: 3000) {
        v2.std.optional.Absent => false
        v2.std.optional.Present { value: b } =>
          match rect(x0: 0, y0: 0, x1: 3001, y1: 3000) {
            v2.std.optional.Absent => false
            v2.std.optional.Present { value: c } => std.orthogonal_topology.space_eq(a: a, b: b) && !std.orthogonal_topology.space_eq(a: a, b: c)
          }
      }
  }
}
