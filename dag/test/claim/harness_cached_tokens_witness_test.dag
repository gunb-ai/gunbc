module test.claim.harness_cached_tokens_witness

import std.measure { token_count, token_count_value }
import std.types { Bool, String, NonEmptyStr, List }
import std.nat { Nat }
import std.optional { Present, Absent }
import gunbc.harness.harness_reasoning_wire { DeepseekV4FlashOnVllm }
import gunbc.harness.harness_wire { harness_chat_completion_session_entry }
import gunbc.serving.turn_admission {
  ServingSessionResidency, ReusedAtTurn, MustReconstruct, TokenPrefixBroken, ResidencyUnread, serving_session_standing,
  HostTierUnread, GpuPrefixUnread,
}
import gunbc.serving.session_store {
  serving_session_record_for_request, cached_tokens_unobserved_obligation, PromptTokensDetailsNotAnObject, CachedTokensNotANumber,
}

fn reported_body() -> String {
  "{\"choices\":[{\"finish_reason\":\"stop\",\"message\":{\"role\":\"assistant\",\"content\":\"ok\"}}],\"usage\":{\"prompt_tokens\":900,\"completion_tokens\":4,\"prompt_tokens_details\":{\"cached_tokens\":768}}}"
}

fn null_details_body() -> String {
  "{\"choices\":[{\"finish_reason\":\"stop\",\"message\":{\"role\":\"assistant\",\"content\":\"ok\"}}],\"usage\":{\"prompt_tokens\":900,\"completion_tokens\":4,\"prompt_tokens_details\":null}}"
}

fn cold_body() -> String {
  "{\"choices\":[{\"finish_reason\":\"stop\",\"message\":{\"role\":\"assistant\",\"content\":\"ok\"}}],\"usage\":{\"prompt_tokens\":900,\"completion_tokens\":4,\"prompt_tokens_details\":{\"cached_tokens\":0}}}"
}

fn l1() -> NonEmptyStr { "L1" as NonEmptyStr }

fn standing_after(body: String, next: List<String>) -> ServingSessionResidency? {
  match harness_chat_completion_session_entry(unit: DeepseekV4FlashOnVllm, body: body, launch: l1(), turn: "t1" as NonEmptyStr, inputs_and_reply: ["sys", "user", "assistant-1"]) {
    Absent => none
    Present { value: e } =>
      Present { value: serving_session_standing(record: serving_session_record_for_request(entry: Present { value: e }, next_inputs: next), current_launch: l1(), host: HostTierUnread, gpu: GpuPrefixUnread) }
  }
}

test fn a_reported_cached_tokens_flows_from_the_wire_to_reused_at_the_recorded_turn() -> Bool {
  match standing_after(body: reported_body(), next: ["sys", "user", "assistant-1", "tool-result"]) {
    Present { value: ReusedAtTurn { cached_tokens: n, launch: _, turn: t } } => token_count_value(t: n) == 768 && (t as String) == "t1"
    _ => false
  }
}

test fn a_null_prompt_tokens_details_reads_unread_never_warm() -> Bool {
  match standing_after(body: null_details_body(), next: ["sys", "user", "assistant-1", "tool-result"]) {
    Present { value: ResidencyUnread { obligation: _ } } => true
    _ => false
  }
}

test fn a_broken_prefix_after_a_reported_turn_must_reconstruct() -> Bool {
  match standing_after(body: reported_body(), next: ["sys", "EDITED", "assistant-1", "tool-result"]) {
    Present { value: MustReconstruct { cause: TokenPrefixBroken } } => true
    _ => false
  }
}

test fn a_body_that_is_not_a_document_records_nothing() -> Bool {
  match harness_chat_completion_session_entry(unit: DeepseekV4FlashOnVllm, body: "not json", launch: l1(), turn: "t1" as NonEmptyStr, inputs_and_reply: ["a"]) {
    Absent => true
    Present { value: _ } => false
  }
}

test fn an_unread_turn_carries_the_typed_cause_of_the_wire_gap_not_a_flattened_string() -> Bool {
  match standing_after(body: null_details_body(), next: ["sys", "user", "assistant-1", "tool-result"]) {
    Present { value: ResidencyUnread { obligation: o } } =>
      (o as String) == (cached_tokens_unobserved_obligation(cause: PromptTokensDetailsNotAnObject) as String)
        && (o as String) != (cached_tokens_unobserved_obligation(cause: CachedTokensNotANumber) as String)
    _ => false
  }
}

fn prior_entry_standing(body: String) -> Bool {
  match harness_chat_completion_session_entry(unit: DeepseekV4FlashOnVllm, body: body, launch: l1(), turn: "t1" as NonEmptyStr, inputs_and_reply: ["a"]) {
    Absent => true
    Present { value: _ } => false
  }
}

test fn an_error_body_and_a_usage_only_body_and_empty_choices_record_nothing() -> Bool {
  prior_entry_standing(body: "{\"error\":{\"message\":\"overloaded\"}}")
    && prior_entry_standing(body: "{\"usage\":{\"prompt_tokens\":9,\"prompt_tokens_details\":{\"cached_tokens\":768}}}")
    && prior_entry_standing(body: "{\"choices\":[],\"usage\":{\"prompt_tokens_details\":{\"cached_tokens\":768}}}")
}

test fn a_valid_completion_with_no_details_still_yields_an_unread_entry() -> Bool {
  match harness_chat_completion_session_entry(unit: DeepseekV4FlashOnVllm, body: "{\"choices\":[{\"finish_reason\":\"stop\",\"message\":{\"role\":\"assistant\",\"content\":\"ok\"}}],\"usage\":{\"prompt_tokens\":9}}", launch: l1(), turn: "t1" as NonEmptyStr, inputs_and_reply: ["a"]) {
    Present { value: _ } => true
    Absent => false
  }
}
