module test.claim.namespace_pool_independence_witness_test


data namespace_pool_independence_witness_note: String = "N3-C witnesses for gunbc.namespace_pool_independence. Pool independence proper: unrelated_loaded_unrelated_spellings_preserves_full_carrier_holds assembles baseline vs perturbed (+unrelated loaded file, different spelling) via B0+B1 and compares full carriers. Class B silent-reselection discriminator: colliding_root_exported_homonym_refuses_ambiguity_holds — adding a colliding root-exported homonym must typed-refuse (ReferenceBindingProjectionAmbiguous on both consumer references), never produce Ready, never alternate-select, never add a dependency edge. Load-bearing RED: same-file reselection with unchanged file-deps. Per-clause RED controls exercise each PoolIndependenceFailure arm."

data npi_decoy_same_spelled_substrate_finding_note: String = "EXECUTED CONCLUSION (loyal-ram-550 routing 2026-08-07): colliding decoy fixture (app.provider + app.decoy both root-export helper) — perturbed B1 projection is AssembledClosureDependencyProjectionBindingRefused with ReferenceBindingProjectionAmbiguous on BOTH consumer references; no Ready projection, no alternate selection, no extra dependency edge. Substrate behaviour is CORRECT under namespace-only double-bound-is-error; prior equality expectation was wrong. Stronger Class B control: proves silent pool-driven reselection does NOT occur. OPEN (operator, non-blocking): CrossFileProviderExportedExposure => RootExposure may be wrong exposure model if cross-module access is projection (provider.helper) not bare-name root injection — if exposure model changes later this control remains as regression evidence."

data npi_cross_file_export_exposure_open_question_note: String = "OPEN QUESTION (loyal-ram-550 escalation 2026-08-07, operator-signed territory): fixture models cross-file provider export as CrossFileProviderExportedExposure => RootExposure, injecting helper into root scope. Namespace-only design says cross-module access is projection — sibling module visible, members reached as provider.helper, not bare-name injection. If projection governs, app.provider.helper and app.decoy.helper never collide at root and the decoy collision may be a fixture exposure artifact. Does not block N3-C; colliding_root_exported_homonym_refuses_ambiguity_holds stays enrolled regardless."

fn npi_witness_consumer_file() -> std.types.FilePath {
  "app/consumer.dag"
}

fn npi_witness_ref_one() -> std.occurrence_identity.OccurrenceId {
  std.occurrence_identity.OccurrenceId { value: 200 }
}

fn npi_witness_ref_two() -> std.occurrence_identity.OccurrenceId {
  std.occurrence_identity.OccurrenceId { value: 201 }
}

fn npi_witness_declaration() -> std.occurrence_identity.OccurrenceId {
  std.occurrence_identity.OccurrenceId { value: 300 }
}

fn npi_witness_declaration_alt() -> std.occurrence_identity.OccurrenceId {
  std.occurrence_identity.OccurrenceId { value: 301 }
}

fn npi_witness_provenance(
  reference_occurrence: std.occurrence_identity.OccurrenceId,
  declaration_occurrence: std.occurrence_identity.OccurrenceId,
) -> std.occurrence_binding_candidates.CrossFileBindingProvenance {
  std.occurrence_binding_candidates.CrossFileBindingProvenance {
    reference_occurrence: reference_occurrence,
    declaration_occurrence: declaration_occurrence,
    consumer_file: npi_witness_consumer_file(),
    provider_file: test.fixture.cross_file_clause_e_fixture.cross_file_clause_e_fixture_provider_file(),
  }
}

fn npi_witness_provider(
  reference_occurrence: std.occurrence_identity.OccurrenceId,
  declaration_occurrence: std.occurrence_identity.OccurrenceId,
) -> std.occurrence_binding_candidates.BoundReferenceProvider {
  std.occurrence_binding_candidates.BoundReferenceProvider {
    reference_occurrence: reference_occurrence,
    declaration_occurrence: declaration_occurrence,
    consumer_module: "app.consumer",
    provider_module: "app.provider",
  }
}

fn npi_witness_file_dependency() -> std.occurrence_binding_candidates.DirectFileDependency {
  std.occurrence_binding_candidates.DirectFileDependency {
    consumer_file: npi_witness_consumer_file(),
    provider_file: test.fixture.cross_file_clause_e_fixture.cross_file_clause_e_fixture_provider_file(),
  }
}

fn npi_witness_projection(
  provenances: List<std.occurrence_binding_candidates.CrossFileBindingProvenance>,
  dependencies: List<std.occurrence_binding_candidates.DirectFileDependency>,
  providers: List<std.occurrence_binding_candidates.BoundReferenceProvider>,
) -> std.occurrence_binding_candidates.ReferenceDerivedDependencyProjection {
  std.occurrence_binding_candidates.ReferenceDerivedDependencyProjectionReady {
    binding_provenance: provenances,
    file_dependencies: dependencies,
    bound_population: std.occurrence_binding_candidates.AllReferencesBound { providers: providers },
  }
}

fn npi_witness_baseline_projection() -> std.occurrence_binding_candidates.ReferenceDerivedDependencyProjection {
  npi_witness_projection(
    provenances: [
      npi_witness_provenance(
        reference_occurrence: npi_witness_ref_one(),
        declaration_occurrence: npi_witness_declaration(),
      ),
      npi_witness_provenance(
        reference_occurrence: npi_witness_ref_two(),
        declaration_occurrence: npi_witness_declaration(),
      ),
    ],
    dependencies: [npi_witness_file_dependency()],
    providers: [
      npi_witness_provider(
        reference_occurrence: npi_witness_ref_one(),
        declaration_occurrence: npi_witness_declaration(),
      ),
      npi_witness_provider(
        reference_occurrence: npi_witness_ref_two(),
        declaration_occurrence: npi_witness_declaration(),
      ),
    ],
  )
}

fn npi_projection_for_assembled_closure(
  closure: std.occurrence_binding_candidates.AssembledCrossFileBindingClosure,
) -> std.occurrence_binding_candidates.ReferenceDerivedDependencyProjection? {
  match std.occurrence_binding_candidates.reference_derived_dependency_projection_for_assembled_closure(closure: closure) {
    std.occurrence_binding_candidates.AssembledClosureDependencyProjectionReady { projection: projection } =>
      Present { value: projection }
    _ => Absent
  }
}

fn npi_pool_perturbation_preserves_full_carrier(
  unrelated_loaded_provider: std.occurrence_binding_candidates.CrossFileBindingClosureRow,
) -> Bool {
  let baseline_closure = test.fixture.cross_file_clause_e_fixture.cross_file_clause_e_fixture_baseline_assembled_closure()
  let perturbed_closure = test.fixture.cross_file_clause_e_fixture.cross_file_clause_e_fixture_perturbed_assembled_closure(
    unrelated_loaded_provider: unrelated_loaded_provider,
  )
  match npi_projection_for_assembled_closure(closure: baseline_closure) {
    Present { value: baseline } =>
      match npi_projection_for_assembled_closure(closure: perturbed_closure) {
        Present { value: perturbed } =>
          match gunbc.namespace_pool_independence.assess_pool_independent_projection_equality(
            source_subject: npi_witness_consumer_file(),
            baseline: baseline,
            perturbed: perturbed,
          ) {
            gunbc.namespace_pool_independence.PoolIndependenceEstablished => true
            _ => false
          }
        Absent => false
      }
    Absent => false
  }
}

test fn unrelated_loaded_unrelated_spellings_preserves_full_carrier_holds() -> Bool {
  npi_pool_perturbation_preserves_full_carrier(
    unrelated_loaded_provider: test.fixture.cross_file_clause_e_fixture.cross_file_clause_e_fixture_unrelated_loaded_provider_row(
      declaration_authored_name: "unrelated_noise",
      module_dotted: "app.unrelated",
      file_path: "app/unrelated.dag",
    ),
  )
}

fn npi_reference_occurrence_in_transport(
  occurrence: std.occurrence_identity.OccurrenceId,
  references: List<std.occurrence_identity.ReferenceOccurrence>,
) -> Bool {
  fold(
    references,
    init: false,
    f: (acc, reference) => acc || (reference.occurrence == occurrence),
  )
}

fn npi_colliding_decoy_row() -> std.occurrence_binding_candidates.CrossFileBindingClosureRow {
  test.fixture.cross_file_clause_e_fixture.cross_file_clause_e_fixture_unrelated_loaded_provider_row(
    declaration_authored_name: "helper",
    module_dotted: "app.decoy",
    file_path: "app/decoy.dag",
  )
}

test fn colliding_root_exported_homonym_refuses_ambiguity_holds() -> Bool {
  let baseline_closure = test.fixture.cross_file_clause_e_fixture.cross_file_clause_e_fixture_baseline_assembled_closure()
  let perturbed_closure = test.fixture.cross_file_clause_e_fixture.cross_file_clause_e_fixture_perturbed_assembled_closure(
    unrelated_loaded_provider: npi_colliding_decoy_row(),
  )
  match std.occurrence_binding_candidates.reference_derived_dependency_projection_for_assembled_closure(closure: baseline_closure) {
    std.occurrence_binding_candidates.AssembledClosureDependencyProjectionReady { projection: _ } =>
      match perturbed_closure {
        std.occurrence_binding_candidates.AssembledCrossFileBindingClosureReady {
          transport: transport,
          inputs: _,
          module_files: _,
          consumer_file: _,
        } =>
          match std.occurrence_binding_candidates.reference_derived_dependency_projection_for_assembled_closure(
            closure: perturbed_closure,
          ) {
            std.occurrence_binding_candidates.AssembledClosureDependencyProjectionRefused {
              refusal: std.occurrence_binding_candidates.AssembledClosureDependencyProjectionBindingRefused {
                population: std.occurrence_binding_candidates.ReferencePopulationRefused {
                  first_failure: std.occurrence_binding_candidates.ReferenceBindingProjectionAmbiguous {
                    occurrence: first_ambiguous,
                  },
                  more_failures: more_failures,
                },
              },
            } =>
              (transport.references |> count) == 2
                && npi_reference_occurrence_in_transport(
                  occurrence: first_ambiguous,
                  references: transport.references,
                )
                && match more_failures |> first {
                  Present {
                    value: std.occurrence_binding_candidates.ReferenceBindingProjectionAmbiguous {
                      occurrence: second_ambiguous,
                    },
                  } =>
                    (more_failures |> count) == 1
                      && npi_reference_occurrence_in_transport(
                        occurrence: second_ambiguous,
                        references: transport.references,
                      )
                      && first_ambiguous != second_ambiguous
                  Absent => false
                }
            _ => false
          }
        _ => false
      }
    _ => false
  }
}

test fn same_file_reselection_red_refuses_full_carrier_holds() -> Bool {
  let baseline = npi_witness_baseline_projection()
  let perturbed = npi_witness_projection(
    provenances: [
      npi_witness_provenance(
        reference_occurrence: npi_witness_ref_one(),
        declaration_occurrence: npi_witness_declaration(),
      ),
      npi_witness_provenance(
        reference_occurrence: npi_witness_ref_two(),
        declaration_occurrence: npi_witness_declaration_alt(),
      ),
    ],
    dependencies: [npi_witness_file_dependency()],
    providers: [
      npi_witness_provider(
        reference_occurrence: npi_witness_ref_one(),
        declaration_occurrence: npi_witness_declaration(),
      ),
      npi_witness_provider(
        reference_occurrence: npi_witness_ref_two(),
        declaration_occurrence: npi_witness_declaration_alt(),
      ),
    ],
  )
  match gunbc.namespace_pool_independence.assess_pool_independent_projection_equality(
    source_subject: npi_witness_consumer_file(),
    baseline: baseline,
    perturbed: perturbed,
  ) {
    gunbc.namespace_pool_independence.PoolIndependenceRefused {
      failure: gunbc.namespace_pool_independence.DeclarationOccurrenceIdentityMismatch,
    } => gunbc.namespace_pool_independence.assess_file_dependencies_only_equality(baseline: baseline, perturbed: perturbed)
    _ => false
  }
}

test fn red_source_subject_mismatch_holds() -> Bool {
  match gunbc.namespace_pool_independence.assess_pool_independent_projection_equality(
    source_subject: "app/wrong.dag",
    baseline: npi_witness_baseline_projection(),
    perturbed: npi_witness_baseline_projection(),
  ) {
    gunbc.namespace_pool_independence.PoolIndependenceRefused {
      failure: gunbc.namespace_pool_independence.SourceSubjectConsumerFileMismatch { expected: _, found: _ },
    } => true
    _ => false
  }
}

test fn red_reference_occurrence_identity_mismatch_holds() -> Bool {
  let baseline = npi_witness_baseline_projection()
  let perturbed = npi_witness_projection(
    provenances: [
      npi_witness_provenance(
        reference_occurrence: npi_witness_ref_two(),
        declaration_occurrence: npi_witness_declaration(),
      ),
      npi_witness_provenance(
        reference_occurrence: npi_witness_ref_one(),
        declaration_occurrence: npi_witness_declaration(),
      ),
    ],
    dependencies: [npi_witness_file_dependency()],
    providers: [
      npi_witness_provider(
        reference_occurrence: npi_witness_ref_two(),
        declaration_occurrence: npi_witness_declaration(),
      ),
      npi_witness_provider(
        reference_occurrence: npi_witness_ref_one(),
        declaration_occurrence: npi_witness_declaration(),
      ),
    ],
  )
  match gunbc.namespace_pool_independence.assess_pool_independent_projection_equality(
    source_subject: npi_witness_consumer_file(),
    baseline: baseline,
    perturbed: perturbed,
  ) {
    gunbc.namespace_pool_independence.PoolIndependenceRefused {
      failure: gunbc.namespace_pool_independence.ReferenceOccurrenceIdentityMismatch,
    } => true
    _ => false
  }
}

test fn red_bound_population_mismatch_holds() -> Bool {
  let baseline = npi_witness_baseline_projection()
  let perturbed = npi_witness_projection(
    provenances: [
      npi_witness_provenance(
        reference_occurrence: npi_witness_ref_one(),
        declaration_occurrence: npi_witness_declaration(),
      ),
      npi_witness_provenance(
        reference_occurrence: npi_witness_ref_two(),
        declaration_occurrence: npi_witness_declaration(),
      ),
    ],
    dependencies: [npi_witness_file_dependency()],
    providers: [
      npi_witness_provider(
        reference_occurrence: npi_witness_ref_one(),
        declaration_occurrence: npi_witness_declaration(),
      ),
      std.occurrence_binding_candidates.BoundReferenceProvider {
        reference_occurrence: npi_witness_ref_two(),
        declaration_occurrence: npi_witness_declaration(),
        consumer_module: "app.other",
        provider_module: "app.provider",
      },
    ],
  )
  match gunbc.namespace_pool_independence.assess_pool_independent_projection_equality(
    source_subject: npi_witness_consumer_file(),
    baseline: baseline,
    perturbed: perturbed,
  ) {
    gunbc.namespace_pool_independence.PoolIndependenceRefused {
      failure: gunbc.namespace_pool_independence.BoundReferencePopulationMismatch,
    } => true
    _ => false
  }
}

test fn red_file_dependency_mismatch_holds() -> Bool {
  let baseline = npi_witness_baseline_projection()
  let perturbed = std.occurrence_binding_candidates.ReferenceDerivedDependencyProjectionReady {
    binding_provenance: [
      npi_witness_provenance(
        reference_occurrence: npi_witness_ref_one(),
        declaration_occurrence: npi_witness_declaration(),
      ),
      npi_witness_provenance(
        reference_occurrence: npi_witness_ref_two(),
        declaration_occurrence: npi_witness_declaration(),
      ),
    ],
    file_dependencies: [
      npi_witness_file_dependency(),
      std.occurrence_binding_candidates.DirectFileDependency {
        consumer_file: npi_witness_consumer_file(),
        provider_file: "app/unrelated.dag",
      },
    ],
    bound_population: std.occurrence_binding_candidates.AllReferencesBound {
      providers: [
        npi_witness_provider(
          reference_occurrence: npi_witness_ref_one(),
          declaration_occurrence: npi_witness_declaration(),
        ),
        npi_witness_provider(
          reference_occurrence: npi_witness_ref_two(),
          declaration_occurrence: npi_witness_declaration(),
        ),
      ],
    },
  }
  match gunbc.namespace_pool_independence.assess_pool_independent_projection_equality(
    source_subject: npi_witness_consumer_file(),
    baseline: baseline,
    perturbed: perturbed,
  ) {
    gunbc.namespace_pool_independence.PoolIndependenceRefused { failure: gunbc.namespace_pool_independence.FileDependencyMismatch } => true
    _ => false
  }
}

test fn red_refusal_outcome_mismatch_holds() -> Bool {
  let baseline = npi_witness_baseline_projection()
  let perturbed = std.occurrence_binding_candidates.ReferenceDerivedDependencyProjectionBindingRefused {
    population: std.occurrence_binding_candidates.ReferencePopulationRefused {
      first_failure: std.occurrence_binding_candidates.ReferenceBindingProjectionUnbound {
        occurrence: npi_witness_ref_one(),
      },
      more_failures: [],
    },
  }
  match gunbc.namespace_pool_independence.assess_pool_independent_projection_equality(
    source_subject: npi_witness_consumer_file(),
    baseline: baseline,
    perturbed: perturbed,
  ) {
    gunbc.namespace_pool_independence.PoolIndependenceRefused { failure: gunbc.namespace_pool_independence.RefusalOutcomeMismatch } => true
    _ => false
  }
}
