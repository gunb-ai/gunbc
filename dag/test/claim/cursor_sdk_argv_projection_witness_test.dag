module test.claim.cursor_sdk_argv_projection_witness_test


data witness_key: std.types.NonEmptyStr = "synthetic-not-a-real-key" as std.types.NonEmptyStr

fn witness_invocation(auth: extdeps.llm.cursor_cli.CursorAuth) -> extdeps.llm.cursor_cli.CursorInvocation {
  extdeps.llm.cursor_cli.CursorInvocation {
    auth: auth,
    model: extdeps.llm.cursor_cli.cursor_model_auto,
    mode: CursorDefaultEditMode,
    sandbox: CursorSandboxEnabled,
    output_format: CursorStreamJson,
    force: false,
    trust_workspace: true,
    workspace: "/srv/attempt" as std.types.FilePath,
    prompt: "do the work" as std.types.NonEmptyStr,
  }
}

test fn environment_materialization_binds_env_not_argv() -> Bool {
  let projection = cursor_sdk_project_materialization(
    materialization: cursor_sdk_environment_api_key_materialization(),
    environment_key_plaintext: witness_key,
  )
  cursor_sdk_projection_binds_environment(
    projection: projection,
    env_var: cursor_api_key_env_var,
  )
    && cursor_sdk_projection_argv_excludes_token(
      projection: projection,
      forbidden_token: witness_key as String,
    )
}

test fn argv_api_key_projection_refuses() -> Bool {
  match cursor_sdk_refuse_argv_api_key_projection(key: witness_key) {
    CursorSdkCredentialProjectionRefused { reason } =>
      string_contains(s: reason as String, pattern: "argv")
    _ => false
  }
}

test fn cli_argument_arm_leaks_key_into_argv_red_control() -> Bool {
  cursor_argv_contains(
    argv: shape_cursor_invocation(
      inv: test.claim.cursor_sdk_argv_projection_witness_test.witness_invocation(auth: extdeps.llm.cursor_cli.CursorApiKeyArgument { key: witness_key }),
    ).argv,
    token: witness_key as String,
  )
    && cursor_argv_contains(
      argv: shape_cursor_invocation(
        inv: test.claim.cursor_sdk_argv_projection_witness_test.witness_invocation(auth: extdeps.llm.cursor_cli.CursorApiKeyArgument { key: witness_key }),
      ).argv,
      token: "--api-key",
    )
}

test fn cursor_sdk_argv_projection_witness_keystone_holds() -> Bool {
  environment_materialization_binds_env_not_argv()
    && argv_api_key_projection_refuses()
    && cli_argument_arm_leaks_key_into_argv_red_control()
}
