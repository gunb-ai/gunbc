module test.claim.codex_app_server_press_wet_witness_test

import extdeps.filesystem.filesystem_io
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import std.types { Bool, String, FilePath }
import gunbc.package_delivery {
  codex_runtime_lock_path,
  codex_runtime_manifest_path,
  materialize_codex_runtime_bundle,
  CodexRuntimeMaterialized,
}
import gunbc.codex_app_server_press {
  press_codex_app_server_for_bundle,
  codex_press_specimen_node_identity,
  codex_press_outcome_wire_status,
  codex_press_outcome_operator_caption,
  CodexPressAccountReady,
  CodexPressLoginRequired,
  CodexPressUnavailable,
  CodexPressRefused,
}
import gunbc.codex_runtime_bundle { codex_bundle_executable_path }
import extdeps.shell

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data witness_note: String = "WET: materialize content-addressed Codex runtime, then observe account standing via initialize → account/read → account/rateLimits/read. Accepts account_ready OR typed login_required / quota press_refused. Must NEVER claim turn_started. Standing summaries are redacted projections, not raw NDJSON. Excluded from hermetic discovery."

fn committed_codex_lock_text() -> String {
  filesystem_read(path: codex_runtime_lock_path as String).content
}

fn standing_is_redacted(redacted: String) -> Bool {
  redacted.contains("@") == false
    && redacted.contains("access_token") == false
    && redacted.contains("refresh_token") == false
    && redacted.contains("email") == false
}

fn press_account_trip_outcome_is_attributable(status: String, reason: String) -> Bool {
  if status == "account_ready" {
    true
  } else if status == "login_required" {
    true
  } else if status == "press_refused" {
    reason.contains("quota") || reason.contains("incomplete") || reason.contains("initialize")
  } else {
    false
  }
}

test fn press_account_trip_yields_standing_or_typed_refusal_never_turn_started() -> Bool {
  match materialize_codex_runtime_bundle(
    lock_text: committed_codex_lock_text(),
    manifest_src: codex_runtime_manifest_path as FilePath,
    lock_src: codex_runtime_lock_path as FilePath,
  ) {
    CodexRuntimeMaterialized { bundle } => {
      let path = codex_bundle_executable_path(bundle: bundle)
      if shell.Test.IsFile(path: path).is_file == false {
        false
      } else {
        match press_codex_app_server_for_bundle(
          bundle: bundle,
          node_identity: codex_press_specimen_node_identity,
          attempt_key: "wet-account-trip-1",
          turn_key: "wet-account-trip-1-turn-pending",
          workspace_root: "/tmp" as FilePath,
          head_sha: "wet",
        ) {
          CodexPressAccountReady { receipt } => {
            let status = codex_press_outcome_wire_status(
              outcome: CodexPressAccountReady { receipt: receipt },
            )
            let caption = codex_press_outcome_operator_caption(
              outcome: CodexPressAccountReady { receipt: receipt },
            )
            status == "account_ready"
              && status != "turn_started"
              && caption == "account ready"
              && caption != "turn started"
              && standing_is_redacted(redacted: receipt.standing.redacted_standing)
              && receipt.standing.redacted_standing.contains("account_read_ok")
          }
          CodexPressLoginRequired { reason, standing } =>
            codex_press_outcome_wire_status(
              outcome: CodexPressLoginRequired { reason: reason, standing: standing },
            ) == "login_required"
              && standing_is_redacted(redacted: standing.redacted_standing)
          CodexPressRefused { reason, standing } =>
            press_account_trip_outcome_is_attributable(
              status: "press_refused",
              reason: reason as String,
            )
              && standing_is_redacted(redacted: standing.redacted_standing)
              && (
                (reason as String).contains("quota")
                  || (reason as String).contains("incomplete")
              )
          CodexPressUnavailable { reason: _ } => false
        }
      }
    }
    _ => false
  }
}
