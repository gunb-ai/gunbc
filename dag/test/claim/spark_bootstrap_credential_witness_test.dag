module test.claim.spark_bootstrap_credential_witness

import std.types { Bool, String, NonEmptyStr, List }
import extdeps.cloud.gcp.secret_ref { secret_ref_secret_resource }
import gunbc.spark_managed_access_bootstrap { RebootThisHost, EnableLingerForOwnAccount }
import gunbc.spark_bootstrap_credential {
  spark_bootstrap_credential_lease,
  spark_bootstrap_credential_secret,
  admitted_root_argv_words,
  admitted_root_argv_label,
  privileged_step_succeeded,
  privileged_step_outcome_wire,
  sudo_rejected_the_credential,
  ValidateStagedSudoers,
  InstallStagedSudoers,
  CredentialUnavailable,
  CredentialRejected,
  PrivilegedCommandFailed,
  PrivilegedCommandSucceeded,
  OperatorBootstrapCredentialLease,
}

fn lease() -> OperatorBootstrapCredentialLease {
  spark_bootstrap_credential_lease(
    host: "srv6",
    grant: RebootThisHost,
    attempt_identity: "fixture-attempt" as NonEmptyStr,
  )
}

// THE PASSWORD GOES OVER STDIN AND NOWHERE ELSE. `sudo -S` reads it from stdin; an argv-borne
// credential would land in the process table, in any command log, and in this repo's own receipts,
// which print argv verbatim. The lease names WHERE the secret lives; nothing in the argv can carry
// what it holds.
test fn the_privileged_argv_reads_its_credential_from_stdin() -> Bool {
  let words = admitted_root_argv_words(command: ValidateStagedSudoers { staged_path: "/home/briansrls/staged" as NonEmptyStr })
  any(words, w => w == "-S")
    && !any(words, w => w == "-n")
    && any(words, w => w == "--")
}

// The prompt is suppressed so nothing resembling a credential prompt reaches a captured terminal,
// and `--` terminates option parsing so a path can never be read as a flag.
test fn the_prompt_is_suppressed_and_options_are_terminated() -> Bool {
  let words = admitted_root_argv_words(command: InstallStagedSudoers {
    staged_path: "/home/briansrls/staged" as NonEmptyStr,
    dropin_path: "/etc/sudoers.d/gunbc-reboot" as NonEmptyStr,
  })
  any(words, w => w == "-p")
    && any(words, w => w == "--")
    && any(words, w => w == "install")
    && any(words, w => w == "0440")
}

// THE ADMITTED SET IS CLOSED, and this is the reason the operation is not a generic
// { argv, stdin } carrier. Widening it would reopen arbitrary script bodies through stdin under
// root -- a far larger hole than the one being closed. Only the two commands this bootstrap needs
// have constructors, so a third cannot be passed through.
test fn only_the_two_bootstrap_commands_can_run_as_root() -> Bool {
  admitted_root_argv_label(command: ValidateStagedSudoers { staged_path: "p" as NonEmptyStr }) == "validate-staged-sudoers"
    && admitted_root_argv_label(command: InstallStagedSudoers {
         staged_path: "p" as NonEmptyStr, dropin_path: "d" as NonEmptyStr,
       }) == "install-staged-sudoers"
}

// One secret per host: an administrator credential is a fact about a machine, and a single
// fleet-wide password would make one compromise total.
test fn each_host_names_its_own_bootstrap_secret() -> Bool {
  secret_ref_secret_resource(ref: spark_bootstrap_credential_secret(host: "srv5"))
    != secret_ref_secret_resource(ref: spark_bootstrap_credential_secret(host: "srv6"))
}

// The lease names the exact grant it authorizes, so a credential materialized for one purpose
// cannot be read as authorization for another.
test fn the_lease_names_the_exact_grant_it_authorizes() -> Bool {
  string_contains(lease().authorized_purpose as String, "reboot this host")
    && string_contains(lease().authorized_purpose as String, "/usr/bin/systemctl reboot")
    && string_contains(lease().authorized_purpose as String, "not retained")
    && (lease().bootstrap_principal as String) == "briansrls"
}

// THE LAYERS STAY DISTINCT because their remedies differ: a credential that could not be fetched is
// an enrolment problem, a credential sudo rejected is a wrong password, and a command that failed
// after sudo admitted it is a host problem. One taxonomy would send a reader to the wrong place.
test fn the_three_failure_layers_are_distinguishable() -> Bool {
  let unavailable = privileged_step_outcome_wire(outcome: CredentialUnavailable {
    lease: lease(), cause: "no enrolled version" as NonEmptyStr,
  })
  let rejected = privileged_step_outcome_wire(outcome: CredentialRejected {
    lease: lease(), stderr: "sudo: 1 incorrect password attempt",
  })
  let failed = privileged_step_outcome_wire(outcome: PrivilegedCommandFailed {
    command: ValidateStagedSudoers { staged_path: "p" as NonEmptyStr },
    exit_code: 1,
    stderr: "parse error",
  })
  string_contains(unavailable, "CREDENTIAL-UNAVAILABLE")
    && string_contains(rejected, "CREDENTIAL-REJECTED")
    && string_contains(failed, "FAILED validate-staged-sudoers")
}

// THE RECEIPT CANNOT PRINT THE CREDENTIAL, and no arm of the renderer can reach it: the lease holds
// a reference, never bytes, so leaking the password is not a matter of discipline about what to
// print. The secret RESOURCE name is safe and is what an operator needs in order to fix enrolment.
test fn the_receipt_names_where_the_secret_lives_and_never_what_it_holds() -> Bool {
  let text = privileged_step_outcome_wire(outcome: CredentialRejected {
    lease: lease(), stderr: "sudo: 1 incorrect password attempt",
  })
  string_contains(text, "/secrets/spark-srv6-bootstrap-admin")
    && !string_contains(text, "incorrect password attempt")
}

// Only the succeeded arm is success; a rejected credential never reads as a converged step.
test fn only_a_succeeded_command_counts_as_success() -> Bool {
  privileged_step_succeeded(outcome: PrivilegedCommandSucceeded {
    command: ValidateStagedSudoers { staged_path: "p" as NonEmptyStr },
  })
    && !privileged_step_succeeded(outcome: CredentialRejected { lease: lease(), stderr: "" })
    && !privileged_step_succeeded(outcome: CredentialUnavailable { lease: lease(), cause: "x" as NonEmptyStr })
    && !privileged_step_succeeded(outcome: PrivilegedCommandFailed {
         command: ValidateStagedSudoers { staged_path: "p" as NonEmptyStr }, exit_code: 1, stderr: "",
       })
}

// A wrong password is read off sudo's own diagnostic, not the exit code: sudo exits 1 for a rejected
// credential AND for a malformed sudoers file, and those have entirely different remedies.
test fn a_rejected_credential_is_read_from_sudos_diagnostic_not_its_exit_code() -> Bool {
  sudo_rejected_the_credential(stderr: "sudo: 1 incorrect password attempt")
    && sudo_rejected_the_credential(stderr: "sudo: a password is required")
    && !sudo_rejected_the_credential(stderr: "visudo: /home/briansrls/staged: parse error near line 1")
}
