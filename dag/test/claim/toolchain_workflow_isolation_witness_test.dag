module test.claim.toolchain_workflow_isolation_witness_test

import extdeps.github.actions { Job, Step, UsesStep, setup_rust_action }
import extdeps.languages.yaml.types { yaml_bool, yaml_string, kv }
import gunbc.ci_deploy_target_host { gunbc_ci_deploy_srv1_runner_spec }
import gunbc.fleet_converge_workflow { fleet_converge_workflow }
import gunbc.fleet_desired_admission_workflow { fleet_desired_admission_workflow }
import gunbc.generated_artifact {
  WitnessFloorYamlArtifact,
  FleetConvergeYamlArtifact,
  FleetDesiredAdmissionYamlArtifact,
}
import gunbc.generated_artifact_emit {
  ArtifactGenerated,
  ArtifactGenerationRefused,
  artifact_generate,
}
import gunbc.toolchain_workflow_isolation {
  PrivateMutableHome,
  ImmutableToolchain,
  ToolchainJobUnclassified,
  classify_toolchain_writer_job,
}
import gunbc.toolchain_workflow_steps { toolchain_home_isolation_step }
import gunbc.witness_floor_workflow { witness_floor_workflow }
import v2.std.optional { Present }
import std.types { List }

fn every_toolchain_writer_is_isolated(jobs: List<Job>) -> Bool {
  fold(jobs, init: true, f: fn(acc, job) {
    acc && match classify_toolchain_writer_job(job: job) {
      PrivateMutableHome => true
      ImmutableToolchain => true
      ToolchainJobUnclassified { job_id: _, unisolated_writer_count: _ } => false
    }
  })
}

test fn live_witness_jobs_derive_as_isolated_from_the_workflow_authority() -> Bool {
  every_toolchain_writer_is_isolated(jobs: witness_floor_workflow.jobs)
}

test fn live_fleet_desired_jobs_derive_as_isolated_from_the_workflow_authority() -> Bool {
  every_toolchain_writer_is_isolated(jobs: fleet_desired_admission_workflow.jobs)
}

test fn live_fleet_converge_jobs_derive_as_isolated_from_the_workflow_authority() -> Bool {
  every_toolchain_writer_is_isolated(jobs: fleet_converge_workflow.jobs)
}

fn generated_yaml_has_private_homes_and_no_superseded_cooperation_protocol(content: String) -> Bool {
  string_contains(s: content, pattern: "CARGO_HOME=$RUNNER_TEMP/cargo") &&
    string_contains(s: content, pattern: "RUSTUP_HOME=$RUNNER_TEMP/rustup") &&
    !string_contains(s: content, pattern: "Expose installed rustup to setup guard") &&
    !string_contains(s: content, pattern: "gunbc-rustup-before.stat") &&
    !string_contains(s: content, pattern: "gunbc-rustup-after.stat")
}

test fn generated_workflow_yaml_is_checked_against_the_derived_classification() -> Bool {
  fold(
    [WitnessFloorYamlArtifact, FleetConvergeYamlArtifact, FleetDesiredAdmissionYamlArtifact],
    init: true,
    f: fn(acc, artifact) {
      acc && match artifact_generate(a: artifact) {
        ArtifactGenerated { content } =>
          generated_yaml_has_private_homes_and_no_superseded_cooperation_protocol(content: content)
        ArtifactGenerationRefused { reason: _ } => false
      }
    },
  )
}

fn hostile_legacy_writer_step() -> Step {
  UsesStep {
    name: Present { value: "Hostile legacy writer" },
    id: none,
    uses: setup_rust_action,
    with: Present {
      value: [
        kv(key: "components", value: yaml_string(s: "rustfmt")),
        kv(key: "cache", value: yaml_bool(b: false)),
      ]
    },
    env: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none,
  }
}

fn hostile_legacy_writer_job(steps: List<Step>) -> Job {
  Job {
    id: "hostile-legacy-writer",
    name: none,
    runner: gunbc_ci_deploy_srv1_runner_spec(),
    steps: steps,
    needs: [],
    env: none,
    outputs: none,
    if_condition: none,
    timeout_minutes: none,
    continue_on_error: none,
    concurrency: none,
    permissions: none,
  }
}

// DISCRIMINATING RED: a job-name roster never sees this planted job and therefore remains green.
// The structural classifier must find the writer itself. Isolation placed AFTER it stays hostile,
// proving that mere membership of both steps is not sufficient.
test fn hostile_legacy_writer_before_isolation_is_discriminated() -> Bool {
  match classify_toolchain_writer_job(
    job: hostile_legacy_writer_job(
      steps: [hostile_legacy_writer_step(), toolchain_home_isolation_step()],
    ),
  ) {
    ToolchainJobUnclassified { job_id: "hostile-legacy-writer", unisolated_writer_count: 1 } => true
    _ => false
  }
}

test fn the_same_writer_after_isolation_is_admitted() -> Bool {
  match classify_toolchain_writer_job(
    job: hostile_legacy_writer_job(
      steps: [toolchain_home_isolation_step(), hostile_legacy_writer_step()],
    ),
  ) {
    PrivateMutableHome => true
    _ => false
  }
}
