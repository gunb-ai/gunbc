module test.claim.heal_revalidation_witness


data prior_head: std.types.CommitSha = "1111111111111111111111111111111111111111"
data healed_head: std.types.CommitSha = "2222222222222222222222222222222222222222"
data other_head: std.types.CommitSha = "3333333333333333333333333333333333333333"
data required_roster: std.content_hash.ContentHash = std.content_hash.Fnv1a64(std.content_hash.content_hash_atom(value: "heal-roster"))
data required_gate: std.content_hash.ContentHash = std.content_hash.Fnv1a64(std.content_hash.content_hash_atom(value: "heal-gate"))

fn produced() -> gunbc.heal_revalidation.HealOutcome {
  gunbc.heal_revalidation.HealProduced {
    prior_head: prior_head,
    healed_head: healed_head,
    changed_artifacts: [".github/workflows/ci.yml"]
  }
}

fn successful_coverage(head: std.types.CommitSha) -> CheckCoverage {
  gunbc.merge_admission.CheckCoverageComplete {
    head: head,
    roster: required_roster,
    conclusions: [gunbc.merge_admission.CoveredGateConclusion { gate: required_gate, conclusion: extdeps.github.checks.Success }]
  }
}

test fn heal_no_change_creates_no_revalidation_obligation() -> Bool {
  gunbc.heal_revalidation.heal_revalidation_admits(
    state: gunbc.heal_revalidation.heal_revalidation_initial(outcome: gunbc.heal_revalidation.HealNoChange { head: prior_head }),
    required_roster: required_roster,
    required_gates: [required_gate]
  )
}

test fn heal_author_commit_required_creates_no_revalidation_obligation() -> Bool {
  gunbc.heal_revalidation.heal_revalidation_admits(
    state: gunbc.heal_revalidation.heal_revalidation_initial(outcome: gunbc.heal_revalidation.HealAuthorCommitRequired {
      head: prior_head,
      author_commit_paths: [".github/workflows/ci.yml"]
    }),
    required_roster: required_roster,
    required_gates: [required_gate]
  )
}

test fn author_commit_required_does_not_supersede_prior_run() -> Bool {
  match gunbc.heal_revalidation.prior_run_disposition(outcome: gunbc.heal_revalidation.HealAuthorCommitRequired {
    head: prior_head,
    author_commit_paths: [".github/workflows/ci.yml", ".github/workflows/falsifier.yml"]
  }) {
    gunbc.heal_revalidation.PriorRunStillCurrent { head } => head == prior_head
    gunbc.heal_revalidation.SupersededByHealedHead { prior_head: _, healed_head: _ } => false
  }
}

test fn heal_produced_is_immediately_revalidation_required() -> Bool {
  let state = gunbc.heal_revalidation.heal_revalidation_initial(outcome: produced())
  match state {
    gunbc.heal_revalidation.HealRevalidationRequired { prior_head: prior, healed_head: healed, changed_artifacts, dispatch } =>
      prior == prior_head
        && healed == healed_head
        && changed_artifacts == [".github/workflows/ci.yml"]
        && match dispatch {
          gunbc.heal_revalidation.HealDispatchPending { healed_head: pending } => pending == healed_head
          gunbc.heal_revalidation.HealDispatchAccepted { healed_head: _, run: _ } => false
          gunbc.heal_revalidation.HealDispatchRefused { healed_head: _, cause: _ } => false
        }
    gunbc.heal_revalidation.HealRevalidationNotRequired { head: _ } => false
    gunbc.heal_revalidation.HealRevalidationCoverageObserved { prior_head: _, healed_head: _, changed_artifacts: _, coverage: _ } => false
  }
}

test fn produced_head_supersedes_prior_run() -> Bool {
  match gunbc.heal_revalidation.prior_run_disposition(outcome: produced()) {
    gunbc.heal_revalidation.SupersededByHealedHead { prior_head: prior, healed_head: healed } =>
      prior == prior_head && healed == healed_head
    gunbc.heal_revalidation.PriorRunStillCurrent { head: _ } => false
  }
}

test fn accepted_dispatch_is_not_revalidation() -> Bool {
  !gunbc.heal_revalidation.heal_revalidation_admits(
    state: gunbc.heal_revalidation.HealRevalidationRequired {
      prior_head: prior_head,
      healed_head: healed_head,
      changed_artifacts: [".github/workflows/ci.yml"],
      dispatch: gunbc.heal_revalidation.HealDispatchAccepted { healed_head: healed_head, run: "run-42" }
    },
    required_roster: required_roster,
    required_gates: [required_gate]
  )
}

test fn refused_dispatch_stays_required_and_located() -> Bool {
  let verdict = gunbc.heal_revalidation.classify_heal_revalidation_admission(
    state: gunbc.heal_revalidation.HealRevalidationRequired {
      prior_head: prior_head,
      healed_head: healed_head,
      changed_artifacts: [".github/workflows/ci.yml"],
      dispatch: gunbc.heal_revalidation.HealDispatchRefused {
        healed_head: healed_head,
        cause: "CreateWorkflowDispatch permission denied"
      }
    },
    required_roster: required_roster,
    required_gates: [required_gate]
  )
  match verdict {
    gunbc.heal_revalidation.HealRevalidationDeniedRequired { healed_head: denied, dispatch } =>
      denied == healed_head && match dispatch {
        gunbc.heal_revalidation.HealDispatchRefused { healed_head: refused, cause } =>
          refused == healed_head && string_contains(s: cause, pattern: "permission denied")
        gunbc.heal_revalidation.HealDispatchPending { healed_head: _ } => false
        gunbc.heal_revalidation.HealDispatchAccepted { healed_head: _, run: _ } => false
      }
    gunbc.heal_revalidation.HealRevalidationAdmittedNoChange { head: _ } => false
    gunbc.heal_revalidation.HealRevalidationAdmittedExactCoverage { healed_head: _ } => false
    gunbc.heal_revalidation.HealRevalidationDeniedCoverage { healed_head: _, coverage: _ } => false
  }
}

test fn only_exact_healed_head_complete_coverage_admits() -> Bool {
  gunbc.heal_revalidation.heal_revalidation_admits(
    state: gunbc.heal_revalidation.HealRevalidationCoverageObserved {
      prior_head: prior_head,
      healed_head: healed_head,
      changed_artifacts: [".github/workflows/ci.yml"],
      coverage: successful_coverage(head: healed_head)
    },
    required_roster: required_roster,
    required_gates: [required_gate]
  ) && !gunbc.heal_revalidation.heal_revalidation_admits(
    state: gunbc.heal_revalidation.HealRevalidationCoverageObserved {
      prior_head: prior_head,
      healed_head: healed_head,
      changed_artifacts: [".github/workflows/ci.yml"],
      coverage: successful_coverage(head: prior_head)
    },
    required_roster: required_roster,
    required_gates: [required_gate]
  )
}

test fn manual_dispatch_without_expected_sha_cannot_masquerade_as_heal_revalidation() -> Bool {
  match gunbc.heal_revalidation.classify_workflow_dispatch_preflight(
    expected_healed_head: none,
    checkout_head: healed_head,
    run_subject_head: healed_head
  ) {
    gunbc.heal_revalidation.OrdinaryWorkflowDispatch { checkout_head, run_subject_head } =>
      checkout_head == healed_head && run_subject_head == healed_head
    gunbc.heal_revalidation.HealWorkflowDispatchSubjectMatched { expected_head: _ } => false
    gunbc.heal_revalidation.HealWorkflowDispatchCheckoutMismatch { expected_head: _, checkout_head: _, run_subject_head: _ } => false
    gunbc.heal_revalidation.HealWorkflowDispatchRunSubjectMismatch { expected_head: _, checkout_head: _, run_subject_head: _ } => false
  }
}

test fn expected_sha_preflight_binds_run_subject_and_checkout_exactly() -> Bool {
  let matched = gunbc.heal_revalidation.classify_workflow_dispatch_preflight(
    expected_healed_head: Present { value: healed_head },
    checkout_head: healed_head,
    run_subject_head: healed_head
  )
  let checkout_mismatch = gunbc.heal_revalidation.classify_workflow_dispatch_preflight(
    expected_healed_head: Present { value: healed_head },
    checkout_head: other_head,
    run_subject_head: healed_head
  )
  let run_subject_mismatch = gunbc.heal_revalidation.classify_workflow_dispatch_preflight(
    expected_healed_head: Present { value: healed_head },
    checkout_head: healed_head,
    run_subject_head: other_head
  )
  match matched {
    gunbc.heal_revalidation.HealWorkflowDispatchSubjectMatched { expected_head } => expected_head == healed_head
    gunbc.heal_revalidation.OrdinaryWorkflowDispatch { checkout_head: _, run_subject_head: _ } => false
    gunbc.heal_revalidation.HealWorkflowDispatchCheckoutMismatch { expected_head: _, checkout_head: _, run_subject_head: _ } => false
    gunbc.heal_revalidation.HealWorkflowDispatchRunSubjectMismatch { expected_head: _, checkout_head: _, run_subject_head: _ } => false
  } && match checkout_mismatch {
    gunbc.heal_revalidation.HealWorkflowDispatchCheckoutMismatch { expected_head, checkout_head, run_subject_head } =>
      expected_head == healed_head && checkout_head == other_head && run_subject_head == healed_head
    gunbc.heal_revalidation.OrdinaryWorkflowDispatch { checkout_head: _, run_subject_head: _ } => false
    gunbc.heal_revalidation.HealWorkflowDispatchSubjectMatched { expected_head: _ } => false
    gunbc.heal_revalidation.HealWorkflowDispatchRunSubjectMismatch { expected_head: _, checkout_head: _, run_subject_head: _ } => false
  } && match run_subject_mismatch {
    gunbc.heal_revalidation.HealWorkflowDispatchRunSubjectMismatch { expected_head, checkout_head, run_subject_head } =>
      expected_head == healed_head && checkout_head == healed_head && run_subject_head == other_head
    gunbc.heal_revalidation.OrdinaryWorkflowDispatch { checkout_head: _, run_subject_head: _ } => false
    gunbc.heal_revalidation.HealWorkflowDispatchSubjectMatched { expected_head: _ } => false
    gunbc.heal_revalidation.HealWorkflowDispatchCheckoutMismatch { expected_head: _, checkout_head: _, run_subject_head: _ } => false
  }
}

data heal_revalidation_closed_denominator_witness_note: String = "These executing witnesses enumerate every current HealOutcome arm (including HealAuthorCommitRequired) and every HealDispatchOutcome arm through exhaustive matches. A newly added heal path or dispatch classification makes this file and the admission folds fail to compile until it is explicitly classified; unclassified cannot become success. The RED controls discriminate dispatch accepted from coverage complete, refused dispatch from an in-flight run, old-head green from healed-head green, ordinary manual dispatch from heal revalidation, and author-commit-required workflow drift from produced heal heads."
