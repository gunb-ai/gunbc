module test.claim.review_sheet_converge_workflow_witness

import std.types { Bool, List, String }
import std.optional { Present, Absent }
import extdeps.github.actions { Job, Step, RunStep, UsesStep, Workflow, WorkflowTrigger, Push, Schedule, PullRequest, WorkflowDispatch, WorkflowCall, WorkflowRunTriggered, MergeGroup }
import extdeps.languages.yaml.types { YamlKeyValue, YamlString, YamlBool }
import extdeps.google.sheets { sheets_token_env }
import gunbc.fleet.fleet_converge_workflow {
  fleet_converge_workflow_of, fleet_converge_review_sheet_converge_job, fleet_converge_review_sheet_writer_token_step,
  fleet_converge_build_job_if, fleet_converge_dispatch_event_if, ReviewSheetConverge,
  fleet_converge_review_sheet_event_admitted,
  fleet_converge_build_job, fleet_converge_plan_revision_job, fleet_converge_build_job_condition, fleet_converge_plan_revision_job_condition,
  fleet_converge_workflow_mode_wire, MtCollins1Boot, FleetApply, Srv1RootMutation, DesiredInstanceDeploy,
}
import extdeps.github.expressions {
  Expression, evaluate_expression, ExpressionValue, ExpressionEvaluationRefused, GithubPathResolution, GithubPathValue, GithubPathUnmodeled,
  gha_value_is_truthy, serialize_expression,
}
import v2.std.diagnostic { outcome_accepted_value }

fn job_if(j: Job) -> String {
  match j.if_condition { Present { value: v } => v  Absent => "" }
}

fn with_value(fields: List<YamlKeyValue>, key: String) -> String {
  match filter(fields, f => f.key == key).first() {
    Present { value: f } => match f.value { YamlString { value: v } => v  _ => "" }
    Absent => ""
  }
}

// THE SCHEDULED GRAPH: on a schedule or push, no host-actuating job can start. Every job other than plan-revision
// and build -- the review-sheet converge included, since it was disabled
// (gunbc.design_ruling::review_sheet_converge_disabled_2026_11_24) -- has a condition that is gated to a dispatch outright, or tests inputs.mode for equality
// with a named mode (empty on a schedule or push, so false). This is a structural reading of the emitted
// conditions; the two conditions the daily build changed are EVALUATED below.
fn admits_only_a_dispatch(j: Job) -> Bool {
  let c = job_if(j: j)
  string_contains(s: c, pattern: fleet_converge_dispatch_event_if)
    || string_contains(s: c, pattern: "github.event.inputs.mode == '")
}

fn is_a_pack_producer(j: Job) -> Bool {
  let build_is = match outcome_accepted_value(fleet_converge_build_job()) {
    Present { value: b } => b.id == j.id
    Absent => false
  }
  let plan_is = match outcome_accepted_value(fleet_converge_plan_revision_job()) {
    Present { value: p } => p.id == j.id
    Absent => false
  }
  build_is || plan_is
}

test fn no_actuating_job_can_start_on_a_schedule_or_push() -> Bool {
  match outcome_accepted_value(fleet_converge_workflow_of()) {
    Absent => false
    Present { value: wf } =>
      { let others = filter(wf.jobs, j => !is_a_pack_producer(j: j))
      others.length() > 0 && all(others, j => admits_only_a_dispatch(j: j)) }
  }
}

// CONTROL: a job with no condition (plan-revision before this change) is exactly what the reading
// refuses; and build's own condition leads with the dispatch gate.
test fn a_job_with_no_condition_is_caught() -> Bool {
  match outcome_accepted_value(fleet_converge_review_sheet_converge_job()) {
    Absent => false
    Present { value: zj } =>
      !admits_only_a_dispatch(j: Job {
        id: "bare", name: none, runner: zj.runner, environment: none,
        steps: [], needs: [], env: none, outputs: none, if_condition: none, timeout_minutes: none,
        continue_on_error: none, concurrency: none, permissions: none,
      })
      && starts_with(s: fleet_converge_build_job_if, prefix: fleet_converge_dispatch_event_if)
  }
}

// ── THE DAILY RELEASE PACK, EVALUATED (gunbc.design_ruling::lab_release_pack_built_daily_2026_11_23) ─────────
// The two conditions are evaluated as GitHub would evaluate them, by extdeps.github.expressions evaluate_expression,
// over the github context of each event: event_name, and event.inputs.mode (absent on a schedule or push, which
// GitHub reads as empty). The emitted job conditions are the serializations of these same values.
fn path_value(p: List<String>, event_name: String, mode: String) -> GithubPathResolution {
  let key = join(p, ".")
  if key == "event_name" { GithubPathValue { value: event_name } }
  else if key == "event.inputs.mode" { GithubPathValue { value: mode } }
  else { GithubPathUnmodeled }
}

fn on_schedule(p: List<String>) -> GithubPathResolution { path_value(p: p, event_name: "schedule", mode: "") }
fn on_push(p: List<String>) -> GithubPathResolution { path_value(p: p, event_name: "push", mode: "") }
fn on_apply_dispatch(p: List<String>) -> GithubPathResolution { path_value(p: p, event_name: "workflow_dispatch", mode: fleet_converge_workflow_mode_wire(mode: FleetApply)) }
fn on_desired_instance_deploy_dispatch(p: List<String>) -> GithubPathResolution { path_value(p: p, event_name: "workflow_dispatch", mode: fleet_converge_workflow_mode_wire(mode: Srv1RootMutation(DesiredInstanceDeploy))) }
fn on_review_sheet_dispatch(p: List<String>) -> GithubPathResolution { path_value(p: p, event_name: "workflow_dispatch", mode: fleet_converge_workflow_mode_wire(mode: ReviewSheetConverge)) }
fn on_boot_dispatch(p: List<String>) -> GithubPathResolution { path_value(p: p, event_name: "workflow_dispatch", mode: fleet_converge_workflow_mode_wire(mode: MtCollins1Boot)) }

// Admitted only when the evaluator yields a truthy value; a refusal to evaluate is never an admission.
fn admits(condition: Expression, github: fn(List<String>) -> GithubPathResolution) -> Bool {
  match evaluate_expression(expression: condition, github_path: github) {
    ExpressionValue { value: v } => gha_value_is_truthy(s: v)
    ExpressionEvaluationRefused { cause: _ } => false
  }
}

// Evaluated to a value (false or true), not refused: a "not admitted" below is a real false, not an unmodeled read.
fn evaluates(condition: Expression, github: fn(List<String>) -> GithubPathResolution) -> Bool {
  match evaluate_expression(expression: condition, github_path: github) {
    ExpressionValue { value: _ } => true
    ExpressionEvaluationRefused { cause: _ } => false
  }
}

test fn the_schedule_builds_the_pack_and_runs_its_prerequisite() -> Bool {
  admits(condition: fleet_converge_build_job_condition, github: on_schedule)
    && admits(condition: fleet_converge_plan_revision_job_condition, github: on_schedule)
}

// RED: a push (the review-sheet sources) builds nothing and resolves nothing -- evaluated to false, not refused.
test fn a_push_builds_nothing() -> Bool {
  evaluates(condition: fleet_converge_build_job_condition, github: on_push)
    && !admits(condition: fleet_converge_build_job_condition, github: on_push)
    && evaluates(condition: fleet_converge_plan_revision_job_condition, github: on_push)
    && !admits(condition: fleet_converge_plan_revision_job_condition, github: on_push)
}

// A dispatch keeps its old reading: a mode that consumes the pack builds it; a mode whose own job builds what it runs
// (the boot) does not, while plan-revision still runs as a checkout.
test fn a_dispatch_builds_only_for_a_mode_that_consumes_the_pack() -> Bool {
  admits(condition: fleet_converge_build_job_condition, github: on_apply_dispatch)
    && admits(condition: fleet_converge_build_job_condition, github: on_desired_instance_deploy_dispatch)
    && evaluates(condition: fleet_converge_build_job_condition, github: on_boot_dispatch)
    && !admits(condition: fleet_converge_build_job_condition, github: on_boot_dispatch)
    && admits(condition: fleet_converge_plan_revision_job_condition, github: on_boot_dispatch)
}

// The emitted conditions ARE these values, and the scheduled path to the artifact is plan-revision -> build only:
// build needs nothing a schedule skips.
test fn the_emitted_conditions_are_the_evaluated_values_and_build_needs_only_plan_revision() -> Bool {
  match outcome_accepted_value(fleet_converge_build_job()) {
    Absent => false
    Present { value: bj } => match outcome_accepted_value(fleet_converge_plan_revision_job()) {
      Absent => false
      Present { value: pj } =>
        job_if(j: bj) == serialize_expression(expression: fleet_converge_build_job_condition)
          && job_if(j: bj) == fleet_converge_build_job_if
          && job_if(j: pj) == serialize_expression(expression: fleet_converge_plan_revision_job_condition)
          && join(bj.needs, ",") == pj.id
    }
  }
}

// THE REVIEW-SHEET CONVERGE IS DISABLED (gunbc.design_ruling::review_sheet_converge_disabled_2026_11_24): its condition,
// evaluated, admits neither the schedule nor a push -- a real false, not a refusal to evaluate -- and still admits its
// own dispatch, so the mode stays usable by hand. The emitted job condition is that value's serialization.
test fn the_review_sheet_converge_starts_only_on_its_own_dispatch() -> Bool {
  let c = fleet_converge_review_sheet_event_admitted()
  let zj = outcome_accepted_value(fleet_converge_review_sheet_converge_job())
  evaluates(condition: c, github: on_schedule)
    && !admits(condition: c, github: on_schedule)
    && evaluates(condition: c, github: on_push)
    && !admits(condition: c, github: on_push)
    && admits(condition: c, github: on_review_sheet_dispatch)
    && !admits(condition: c, github: on_apply_dispatch)
    && match zj {
         Present { value: j } => job_if(j: j) == serialize_expression(expression: c) && j.needs == []
         Absent => false
       }
}

fn is_autonomous_other_than_the_schedule(t: WorkflowTrigger) -> Bool {
  match t {
    Push { branches: _, paths: _ } => true
    PullRequest { branches: _, types: _, paths: _ } => true
    MergeGroup => true
    WorkflowCall { inputs: _ } => true
    WorkflowRunTriggered { workflows: _, branches: _, activity: _ } => true
    Schedule { cron: _ } => false
    WorkflowDispatch { inputs: _ } => false
  }
}

fn is_schedule(t: WorkflowTrigger) -> Bool {
  match t {
    Schedule { cron: _ } => true
    Push { branches: _, paths: _ } => false
    PullRequest { branches: _, types: _, paths: _ } => false
    MergeGroup => false
    WorkflowCall { inputs: _ } => false
    WorkflowRunTriggered { workflows: _, branches: _, activity: _ } => false
    WorkflowDispatch { inputs: _ } => false
  }
}

// THE ONLY AUTONOMOUS TRIGGER IS THE DAILY SCHEDULE: the push trigger left with the review-sheet converge, and
// fleet-converge has no pull-request or merge-group trigger, so it can never post a context on the required path.
test fn the_daily_schedule_is_the_only_autonomous_trigger() -> Bool {
  match outcome_accepted_value(fleet_converge_workflow_of()) {
    Absent => false
    Present { value: wf } =>
      filter(wf.on, t => is_schedule(t: t)).length() == 1
        && !any(wf.on, t => is_autonomous_other_than_the_schedule(t: t))
  }
}

// THE TOKEN ROUTE: the delegation step continues on error (so the refusal is the converge's own,
// typed), names the writer as the account and review-sheet-converge as the delegate, and its output
// reaches the converge step's environment under the transport's variable and nowhere on a command line.
test fn the_writer_token_is_delegated_and_reaches_only_the_environment() -> Bool {
  let auth_ok = match fleet_converge_review_sheet_writer_token_step() {
    UsesStep { name: _, id: _, uses: _, with: w, env: _, if_condition: _, continue_on_error: coe, timeout_minutes: _ } =>
      coe == Present { value: true } && match w {
        Present { value: fields } =>
          with_value(fields: fields, key: "service_account") == "review-sheet-writer@gunbai-sheets.iam.gserviceaccount.com"
            && with_value(fields: fields, key: "delegates") == "review-sheet-converge@gunbai-secrets.iam.gserviceaccount.com"
            && with_value(fields: fields, key: "token_format") == "access_token"
        Absent => false
      }
    RunStep { name: _, id: _, run: _, shell: _, env: _, working_directory: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } => false
  }
  let runs = match outcome_accepted_value(fleet_converge_review_sheet_converge_job()) {
    Present { value: zj } => filter(zj.steps, s => match s {
      RunStep { name: _, id: _, run: _, shell: _, env: _, working_directory: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } => true
      UsesStep { name: _, id: _, uses: _, with: _, env: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } => false
    })
    Absent => []
  }
  let env_carried = any(runs, s => match s {
    RunStep { name: _, id: _, run: _, shell: _, env: e, working_directory: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } =>
      match e { Present { value: kvs } => with_value(fields: kvs, key: sheets_token_env) == "${{ steps.writer_token.outputs.access_token }}"  Absent => false }
    UsesStep { name: _, id: _, uses: _, with: _, env: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } => false
  })
  let never_in_a_script = all(runs, s => match s {
    RunStep { name: _, id: _, run: r, shell: _, env: _, working_directory: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } =>
      !string_contains(s: r, pattern: "writer_token") && !string_contains(s: r, pattern: sheets_token_env)
    UsesStep { name: _, id: _, uses: _, with: _, env: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } => true
  })
  auth_ok && env_carried && never_in_a_script
}
