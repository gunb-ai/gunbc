module test.claim.typescript_program_serializer


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn minimal_add_program() -> extdeps.languages.typescript.program.TsProgram {
  extdeps.languages.typescript.program.TsProgram {
    ts_nocheck: false,
    header_lines: [],
    statements: [
      ts_const(
        name: "x",
        value: ts_binop(
          left: ts_lit_num(text: "1"),
          op: "+",
          right: ts_lit_num(text: "2")
        )
      ),
    ],
  }
}

fn regex_literal_program() -> extdeps.languages.typescript.program.TsProgram {
  extdeps.languages.typescript.program.TsProgram {
    ts_nocheck: false,
    header_lines: [],
    statements: [
      ts_const(name: "re", value: ts_lit_regex(source: "^\\/$")),
    ],
  }
}

test fn typescript_program_serialize_const_holds() -> Bool {
  serialize_typescript_program(p: minimal_add_program()) == "const x = 1 + 2;"
}

test fn typescript_program_serialize_regex_holds() -> Bool {
  serialize_typescript_program(p: regex_literal_program()) == "const re = /^\\/$/;"
}

test fn typescript_program_serialize_arrow_expr_body_holds() -> Bool {
  serialize_typescript_program(p: extdeps.languages.typescript.program.TsProgram {
    ts_nocheck: false,
    header_lines: [],
    statements: [
      ts_const(
        name: "ok",
        value: ts_call(
          callee: ts_member(object: ts_ident(name: "routes"), property: "some"),
          args: [
            ts_arrow(
              params: ["r"],
              body: ts_expr_stmt(expr: ts_call(
                callee: ts_member(
                  object: ts_member(object: ts_ident(name: "r"), property: "pathRe"),
                  property: "test"
                ),
                args: [ts_ident(name: "path")]
              ))
            ),
          ]
        )
      ),
    ],
  }) == "const ok = routes.some((r) => r.pathRe.test(path));"
}

test fn typescript_program_serialize_create_server_fragment_holds() -> Bool {
  let src = serialize_typescript_program(p: extdeps.languages.typescript.program.TsProgram {
    ts_nocheck: true,
    header_lines: ["test"],
    statements: [
      ts_expr_stmt(expr: ts_call(
        callee: ts_member(
          object: ts_call(callee: ts_ident(name: "require"), args: [ts_lit_str(value: "http")]),
          property: "createServer"
        ),
        args: [
          ts_arrow(
            params: ["req", "res"],
            body: ts_block(stmts: [
              ts_expr_stmt(expr: ts_call(
                callee: ts_member(object: ts_ident(name: "res"), property: "end"),
                args: [ts_lit_str(value: "ok")]
              )),
            ])
          ),
        ]
      )),
    ],
  })
  string_contains(s: src, pattern: "createServer")
    && string_contains(s: src, pattern: "@ts-nocheck")
    && string_contains(s: src, pattern: "require('http')")
}

data operator_precedence_witness_note: String = "The printer's grouping proven by SERIALIZED TEXT, not by reading the table, because the defect these witnesses close was invisible in the model and visible only in the output. Each assertion is a whole-string equality, which is the strongest available discrimination here: a printer that stopped grouping reds the three grouping witnesses, and a printer that grouped indiscriminately reds the three bare witnesses, so neither direction of regression can pass. The two grouping shapes are the exact shapes found live in gunbc.roadmap_component on 2026-07-30 — a conditional and a disjunction as the right operand of a concatenation — rather than invented ones, so the RED is the real defect rather than a strawman."

fn precedence_const_program(value: extdeps.languages.typescript.program.TsExpr) -> extdeps.languages.typescript.program.TsProgram {
  extdeps.languages.typescript.program.TsProgram {
    ts_nocheck: false,
    header_lines: [],
    statements: [ts_const(name: "x", value: value)],
  }
}

fn precedence_stmt_program(expr: extdeps.languages.typescript.program.TsExpr) -> extdeps.languages.typescript.program.TsProgram {
  extdeps.languages.typescript.program.TsProgram {
    ts_nocheck: false,
    header_lines: [],
    statements: [ts_expr_stmt(expr: expr)],
  }
}

test fn typescript_precedence_groups_conditional_under_concat() -> Bool {
  let e = ts_binop(
    left: ts_lit_str(value: "a"),
    op: "+",
    right: ts_cond(
      test: ts_ident(name: "c"),
      consequent: ts_lit_str(value: "y"),
      alternate: ts_lit_str(value: "z")))
  serialize_typescript_program(p: precedence_const_program(value: e)) == "const x = 'a' + (c ? 'y' : 'z');"
}

test fn typescript_precedence_groups_disjunction_under_concat() -> Bool {
  let e = ts_binop(
    left: ts_lit_str(value: "a"),
    op: "+",
    right: ts_binop(
      left: ts_ident(name: "b"),
      op: "||",
      right: ts_lit_str(value: "z")))
  serialize_typescript_program(p: precedence_const_program(value: e)) == "const x = 'a' + (b || 'z');"
}

test fn typescript_precedence_groups_nonassociative_right_nesting() -> Bool {
  let e = ts_binop(
    left: ts_ident(name: "a"),
    op: "-",
    right: ts_binop(left: ts_ident(name: "b"), op: "-", right: ts_ident(name: "c")))
  serialize_typescript_program(p: precedence_const_program(value: e)) == "const x = a - (b - c);"
}

test fn typescript_precedence_leaves_assignment_conditional_bare() -> Bool {
  let e = ts_binop(
    left: ts_member(object: ts_ident(name: "el"), property: "title"),
    op: "=",
    right: ts_cond(
      test: ts_ident(name: "c"),
      consequent: ts_lit_str(value: "y"),
      alternate: ts_lit_str(value: "z")))
  serialize_typescript_program(p: precedence_stmt_program(expr: e)) == "el.title = c ? 'y' : 'z';"
}

test fn typescript_precedence_leaves_associative_chain_bare() -> Bool {
  let e = ts_binop(
    left: ts_ident(name: "a"),
    op: "&&",
    right: ts_binop(left: ts_ident(name: "b"), op: "&&", right: ts_ident(name: "c")))
  serialize_typescript_program(p: precedence_const_program(value: e)) == "const x = a && b && c;"
}

test fn typescript_precedence_leaves_tighter_child_bare() -> Bool {
  let e = ts_binop(
    left: ts_binop(left: ts_ident(name: "a"), op: "===", right: ts_ident(name: "b")),
    op: "&&",
    right: ts_binop(left: ts_ident(name: "c"), op: "===", right: ts_ident(name: "d")))
  serialize_typescript_program(p: precedence_const_program(value: e)) == "const x = a === b && c === d;"
}

data unrecognized_operator_note: String = "An operator the table does not know claims the tightest binding as a parent, so any COMPOUND operand under it is grouped — `b + c` here — while an atom is left bare, because an identifier has nothing to re-associate and parenthesizing it would be noise with no property behind it. The first version of this witness asserted `(a) ?? (b + c)` and was simply wrong about the printer; it is recorded because the correction is the interesting part. Over-parenthesizing is the safe direction for an unknown operator, but 'safe direction' is not a licence to group things that cannot be misgrouped."

test fn typescript_precedence_groups_unrecognized_operator_operands() -> Bool {
  let e = ts_binop(
    left: ts_ident(name: "a"),
    op: "??",
    right: ts_binop(left: ts_ident(name: "b"), op: "+", right: ts_ident(name: "c")))
  serialize_typescript_program(p: precedence_const_program(value: e)) == "const x = a ?? (b + c);"
}

test fn typescript_precedence_groups_unrecognized_operator_as_child() -> Bool {
  let e = ts_binop(
    left: ts_lit_str(value: "a"),
    op: "+",
    right: ts_binop(left: ts_ident(name: "b"), op: "??", right: ts_ident(name: "c")))
  serialize_typescript_program(p: precedence_const_program(value: e)) == "const x = 'a' + (b ?? c);"
}

data receiver_grouping_witness_note: String = "The receiver arm of the precedence family, added on a live silent defect (2026-08-01): ts_member over a `||` binop serialized as `a || [].forEach(cb)` — valid JavaScript that never runs the callback when `a` is truthy, discovered as an empty obligation ledger with zero console errors. The discriminating pair: an operator receiver GROUPS (member, index, and call each asserted); an atom receiver (call result, plain member chain) stays bare, so the fix cannot hide behind blanket parentheses. The RED is the exact live shape: the ungrouped spelling must not be what the printer emits."

test fn typescript_receiver_binop_groups_under_member() -> Bool {
  let e = ts_call(
    callee: ts_member(
      object: ts_binop(
        left: ts_member(object: ts_ident(name: "attempt"), property: "segments"),
        op: "||",
        right: ts_array(elements: [])),
      property: "forEach"),
    args: [ts_ident(name: "cb")])
  serialize_typescript_program(p: precedence_const_program(value: e)) == "const x = (attempt.segments || []).forEach(cb);"
}

test fn typescript_receiver_cond_groups_under_index() -> Bool {
  let e = ts_index(
    object: ts_cond(
      test: ts_ident(name: "p"),
      consequent: ts_ident(name: "xs"),
      alternate: ts_ident(name: "ys")),
    index: ts_lit_num(text: "0"))
  serialize_typescript_program(p: precedence_const_program(value: e)) == "const x = (p ? xs : ys)[0];"
}

test fn typescript_receiver_atom_stays_bare() -> Bool {
  let e = ts_call(
    callee: ts_member(
      object: ts_call(
        callee: ts_member(object: ts_ident(name: "document"), property: "querySelectorAll"),
        args: [ts_lit_str(value: ".row")]),
      property: "forEach"),
    args: [ts_ident(name: "cb")])
  serialize_typescript_program(p: precedence_const_program(value: e)) == "const x = document.querySelectorAll('.row').forEach(cb);"
}

data try_serialization_receipt_note: String = "THE TRY ARM'S OWN EXECUTION RECEIPT (review finding, 2026-08-07). The grammar grew a Try statement and the only thing exercising it was a witness asserting that two substrings appeared somewhere in a large emitted program — which proves the arm was reached and proves nothing about what it produced. A serializer arm is pinned by its bytes or it is not pinned: an arm that dropped the catch parameter, emitted the handler before the body, or lost a brace would satisfy a contains-check and produce a file no engine would parse.

Three fixtures, each naming what would survive without it: the exact bytes of a try/catch; a nested try inside a catch, because serialize_ts_stmt_body routes Try back through serialize_ts_stmt and a missing arm there is a silent structural change; and a try whose body is a bare expression statement rather than a block, which is the shape that would emit an unbraced clause the grammar does not permit."

fn try_program(body: extdeps.languages.typescript.program.TsStmt, catch_param: String, handler: extdeps.languages.typescript.program.TsStmt) -> extdeps.languages.typescript.program.TsProgram {
  extdeps.languages.typescript.program.TsProgram {
    ts_nocheck: false,
    header_lines: [],
    statements: [ts_try(body: body, catch_param: catch_param, handler: handler)],
  }
}

test fn typescript_try_serializes_to_exact_bytes() -> Bool {
  serialize_typescript_program(p: try_program(
    body: ts_block(stmts: [ts_expr_stmt(expr: ts_call(callee: ts_ident(name: "risky"), args: []))]),
    catch_param: "err",
    handler: ts_block(stmts: [ts_expr_stmt(expr: ts_call(
      callee: ts_ident(name: "note"),
      args: [ts_member(object: ts_ident(name: "err"), property: "name")],
    ))]),
  )) == "try {   risky(); } catch (err) {   note(err.name); }"
}

test fn typescript_try_nested_in_a_handler_serializes() -> Bool {
  serialize_typescript_program(p: try_program(
    body: ts_block(stmts: [ts_expr_stmt(expr: ts_call(callee: ts_ident(name: "a"), args: []))]),
    catch_param: "e1",
    handler: ts_block(stmts: [ts_try(
      body: ts_block(stmts: [ts_expr_stmt(expr: ts_call(callee: ts_ident(name: "b"), args: []))]),
      catch_param: "e2",
      handler: ts_block(stmts: [ts_expr_stmt(expr: ts_call(callee: ts_ident(name: "c"), args: []))]),
    )]),
  )) == "try {   a(); } catch (e1) {   try {   b(); } catch (e2) {   c(); } }"
}

test fn typescript_try_with_a_bare_body_still_braces_nothing_it_should_not() -> Bool {
  serialize_typescript_program(p: try_program(
    body: ts_expr_stmt(expr: ts_call(callee: ts_ident(name: "a"), args: [])),
    catch_param: "e",
    handler: ts_expr_stmt(expr: ts_call(callee: ts_ident(name: "b"), args: [])),
  )) == "try a() catch (e) b()"
}
