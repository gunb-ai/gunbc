module test.claim.typescript_program_serializer


data live_tree_disposition: LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn minimal_add_program() -> extdeps.languages.typescript.program.TsProgram {
  extdeps.languages.typescript.program.TsProgram {
    ts_nocheck: false,
    header_lines: [],
    statements: [
      extdeps.languages.typescript.program.ts_const(
        name: "x",
        value: extdeps.languages.typescript.program.ts_binop(
          left: extdeps.languages.typescript.program.ts_lit_num(text: "1"),
          op: "+",
          right: extdeps.languages.typescript.program.ts_lit_num(text: "2")
        )
      ),
    ],
  }
}

fn regex_literal_program() -> extdeps.languages.typescript.program.TsProgram {
  extdeps.languages.typescript.program.TsProgram {
    ts_nocheck: false,
    header_lines: [],
    statements: [
      extdeps.languages.typescript.program.ts_const(name: "re", value: extdeps.languages.typescript.program.ts_lit_regex(source: "^\\/$")),
    ],
  }
}

test fn typescript_program_serialize_const_holds() -> Bool {
  extdeps.languages.typescript.program.serialize_typescript_program(p: minimal_add_program()) == "const x = 1 + 2;"
}

test fn typescript_program_serialize_regex_holds() -> Bool {
  extdeps.languages.typescript.program.serialize_typescript_program(p: regex_literal_program()) == "const re = /^\\/$/;"
}

test fn typescript_program_serialize_arrow_expr_body_holds() -> Bool {
  extdeps.languages.typescript.program.serialize_typescript_program(p: extdeps.languages.typescript.program.TsProgram {
    ts_nocheck: false,
    header_lines: [],
    statements: [
      extdeps.languages.typescript.program.ts_const(
        name: "ok",
        value: extdeps.languages.typescript.program.ts_call(
          callee: extdeps.languages.typescript.program.ts_member(object: extdeps.languages.typescript.program.ts_ident(name: "routes"), property: "some"),
          args: [
            extdeps.languages.typescript.program.ts_arrow(
              params: ["r"],
              body: extdeps.languages.typescript.program.ts_expr_stmt(expr: extdeps.languages.typescript.program.ts_call(
                callee: extdeps.languages.typescript.program.ts_member(
                  object: extdeps.languages.typescript.program.ts_member(object: extdeps.languages.typescript.program.ts_ident(name: "r"), property: "pathRe"),
                  property: "test"
                ),
                args: [extdeps.languages.typescript.program.ts_ident(name: "path")]
              ))
            ),
          ]
        )
      ),
    ],
  }) == "const ok = routes.some((r) => r.pathRe.test(path));"
}

test fn typescript_program_serialize_create_server_fragment_holds() -> Bool {
  let src = extdeps.languages.typescript.program.serialize_typescript_program(p: extdeps.languages.typescript.program.TsProgram {
    ts_nocheck: true,
    header_lines: ["test"],
    statements: [
      extdeps.languages.typescript.program.ts_expr_stmt(expr: extdeps.languages.typescript.program.ts_call(
        callee: extdeps.languages.typescript.program.ts_member(
          object: extdeps.languages.typescript.program.ts_call(callee: extdeps.languages.typescript.program.ts_ident(name: "require"), args: [extdeps.languages.typescript.program.ts_lit_str(value: "http")]),
          property: "createServer"
        ),
        args: [
          extdeps.languages.typescript.program.ts_arrow(
            params: ["req", "res"],
            body: extdeps.languages.typescript.program.ts_block(stmts: [
              extdeps.languages.typescript.program.ts_expr_stmt(expr: extdeps.languages.typescript.program.ts_call(
                callee: extdeps.languages.typescript.program.ts_member(object: extdeps.languages.typescript.program.ts_ident(name: "res"), property: "end"),
                args: [extdeps.languages.typescript.program.ts_lit_str(value: "ok")]
              )),
            ])
          ),
        ]
      )),
    ],
  })
  string_contains(s: src, pattern: "createServer")
    && string_contains(s: src, pattern: "@ts-nocheck")
    && string_contains(s: src, pattern: "require('http')")
}
