module test.claim.affine_space_witness


// TWO DISTINCT FRAMES, AS MINTED IDENTITIES THE VALUES CARRY. They were type-level tags, and the
// witness said the cross-frame error was unwritable; measured on the production compile-and-run
// path 2026-08-11, the cross-frame subtraction compiled clean and returned 9. std.coordinate_frame
// records the full account. The room's origin is its southwest floor corner, the building's is
// elsewhere, and a coordinate means nothing without saying which.
fn room() -> std.coordinate_frame.CoordinateFrameIdentity { std.coordinate_frame.coordinate_frame_identity(occurrence: 1) }

// THE METRIC OPERATIONS NOW ASK THE REGISTRY WHAT THE FRAME'S QUANTUM IS, because they are the
// operations that put a millimetre label back on a unit-neutral component. This registry declares
// the room in millimetres, which is what makes that label true here.
fn mm_registry() -> std.spatial_frame.SpatialFrameRegistry {
  match std.spatial_frame.register_frame(r: std.spatial_frame.empty_frame_registry(), identity: room(), length_scale: std.measure.Milli) {
    std.spatial_frame.FrameRegistered { frame: f } => std.spatial_frame.registry_with(r: std.spatial_frame.empty_frame_registry(), f: f)
    std.spatial_frame.FrameRegistrationRefused { cause: _ } => std.spatial_frame.empty_frame_registry()
  }
}
fn building() -> std.coordinate_frame.CoordinateFrameIdentity { std.coordinate_frame.coordinate_frame_identity(occurrence: 2) }

fn desk_a() -> std.affine_space.Point3 { std.affine_space.point3(frame: room(), x: 1200, y: 800, z: 0) }

// Nothing physically negative about this desk: it is 300 mm on the negative side of the chosen
// x-origin. That is the whole point of the affine layer.
fn desk_b() -> std.affine_space.Point3 { std.affine_space.point3(frame: room(), x: 0 - 300, y: 2600, z: 0) }

fn vector_equals(a: std.affine_space.Vector3, b: std.affine_space.Vector3) -> Bool {
  std.affine_space.signed_frame_component_count(c: a.x) == std.affine_space.signed_frame_component_count(c: b.x)
    && std.affine_space.signed_frame_component_count(c: a.y) == std.affine_space.signed_frame_component_count(c: b.y)
    && std.affine_space.signed_frame_component_count(c: a.z) == std.affine_space.signed_frame_component_count(c: b.z)
}

fn point_equals(a: std.affine_space.Point3, b: std.affine_space.Point3) -> Bool {
  std.affine_space.signed_frame_component_count(c: a.x) == std.affine_space.signed_frame_component_count(c: b.x)
    && std.affine_space.signed_frame_component_count(c: a.y) == std.affine_space.signed_frame_component_count(c: b.y)
    && std.affine_space.signed_frame_component_count(c: a.z) == std.affine_space.signed_frame_component_count(c: b.z)
}

// THE READY SIDE IS ASSERTED, NEVER ASSUMED. Every claim below that expects an ordinary
// architectural value goes through one of these: a refusal makes the claim FALSE rather than being
// silently skipped, so an implementation that started refusing everything could not read as green.
fn ready_vector_equals(r: std.affine_space.SpatialResult<std.affine_space.Vector3>, b: std.affine_space.Vector3) -> Bool {
  match r {
    std.affine_space.SpatialArithmeticRefused { cause: _ } => false
    std.affine_space.SpatialFrameRefused { refusal: _ } => false
    std.affine_space.SpatialReady { value: v } => vector_equals(a: v, b: b)
  }
}

fn ready_point_equals(r: std.affine_space.SpatialResult<std.affine_space.Point3>, b: std.affine_space.Point3) -> Bool {
  match r {
    std.affine_space.SpatialArithmeticRefused { cause: _ } => false
    std.affine_space.SpatialFrameRefused { refusal: _ } => false
    std.affine_space.SpatialReady { value: p } => point_equals(a: p, b: b)
  }
}

fn norm_squared_is(v: std.affine_space.Vector3, expected: std.nat.Nat) -> Bool {
  match std.euclidean_geometry.norm_squared3(registry: mm_registry(), v: v) {
    std.affine_space.SpatialArithmeticRefused { cause: _ } => false
    std.affine_space.SpatialFrameRefused { refusal: _ } => false
    std.affine_space.SpatialReady { value: s } => std.measure.square_millimeter_count(m: s) == expected
  }
}

fn ready_bool_is(r: std.affine_space.SpatialResult<Bool>, expected: Bool) -> Bool {
  match r {
    std.affine_space.SpatialArithmeticRefused { cause: _ } => false
    std.affine_space.SpatialFrameRefused { refusal: _ } => false
    std.affine_space.SpatialReady { value: b } => b == expected
  }
}

// Point - Point -> Vector, with signed components. desk_b - desk_a = (-1500, 1800, 0).
fn witness_point_difference_is_signed_displacement() -> Bool {
  ready_vector_equals(
    r: std.affine_space.displacement_between3(from: desk_a(), to: desk_b()),
    b: std.affine_space.vector3(frame: room(), x: 0 - 1500, y: 1800, z: 0),
  )
}

// Point + Vector -> Point, and it inverts the difference: a + (b - a) == b.
fn witness_translate_inverts_difference() -> Bool {
  match std.affine_space.displacement_between3(from: desk_a(), to: desk_b()) {
    std.affine_space.SpatialArithmeticRefused { cause: _ } => false
    std.affine_space.SpatialFrameRefused { refusal: _ } => false
    std.affine_space.SpatialReady { value: d } =>
      ready_point_equals(r: std.affine_space.translate_point3(point: desk_a(), by: d), b: desk_b())
  }
    && ready_point_equals(r: std.affine_space.translate_point3(point: desk_a(), by: std.affine_space.zero_vector3(frame: room())), b: desk_a())
}

// Vector +/- Vector -> Vector, and negation is the additive inverse.
fn witness_vectors_compose() -> Bool {
  let u = std.affine_space.vector3(frame: room(), x: 100, y: 0 - 50, z: 25)
  let v = std.affine_space.vector3(frame: room(), x: 0 - 30, y: 70, z: 0 - 5)
  match std.affine_space.add_vector3(a: u, b: v) {
    std.affine_space.SpatialArithmeticRefused { cause: _ } => false
    std.affine_space.SpatialFrameRefused { refusal: _ } => false
    std.affine_space.SpatialReady { value: sum } =>
      ready_vector_equals(r: std.affine_space.subtract_vector3(a: sum, b: v), b: u)
  }
    && match std.affine_space.negate_vector3(v: u) {
         std.affine_space.SpatialArithmeticRefused { cause: _ } => false
         std.affine_space.SpatialFrameRefused { refusal: _ } => false
         std.affine_space.SpatialReady { value: nu } =>
           ready_vector_equals(r: std.affine_space.add_vector3(a: u, b: nu), b: std.affine_space.zero_vector3(frame: room()))
       }
    && ready_vector_equals(r: std.affine_space.scale_vector3(v: u, factor: 2), b: std.affine_space.vector3(frame: room(), x: 200, y: 0 - 100, z: 50))
}

// A quarter turn about +Z is exact: (x, y) -> (-y, x); four of them are the identity.
//
// BOTH x AND y ARE NONZERO ON PURPOSE. An earlier version used (1000, 0, 7), where a reflection
// (x, y) -> (y, x) and a rotation (x, y) -> (-y, x) produce the SAME answer, so the claim passed
// while the operation was a reflection. The defect was found by mutating the implementation and
// watching this witness stay green; an asymmetric vector is what makes the sign observable.
fn witness_quarter_turns_are_exact_and_close() -> Bool {
  let v = std.affine_space.vector3(frame: room(), x: 1000, y: 300, z: 7)
  ready_vector_equals(r: std.affine_space.rotate_quarter_turns_about_z(v: v, turns: std.affine_space.OneQuarter), b: std.affine_space.vector3(frame: room(), x: 0 - 300, y: 1000, z: 7))
    && ready_vector_equals(r: std.affine_space.rotate_quarter_turns_about_z(v: v, turns: std.affine_space.TwoQuarters), b: std.affine_space.vector3(frame: room(), x: 0 - 1000, y: 0 - 300, z: 7))
    && ready_vector_equals(r: std.affine_space.rotate_quarter_turns_about_z(v: v, turns: std.affine_space.ThreeQuarters), b: std.affine_space.vector3(frame: room(), x: 300, y: 0 - 1000, z: 7))
    && ready_vector_equals(r: std.affine_space.rotate_quarter_turns_about_z(v: v, turns: std.affine_space.NoTurn), b: v)
    && match std.affine_space.rotate_quarter_turns_about_z(v: v, turns: std.affine_space.TwoQuarters) {
         std.affine_space.SpatialArithmeticRefused { cause: _ } => false
         std.affine_space.SpatialFrameRefused { refusal: _ } => false
         std.affine_space.SpatialReady { value: half } =>
           ready_vector_equals(r: std.affine_space.rotate_quarter_turns_about_z(v: half, turns: std.affine_space.TwoQuarters), b: v)
       }
}

// Squared magnitudes are exact wherever they are representable, including the diagonal case norm3
// must leave unresolved.
fn witness_norm_squared_is_exact() -> Bool {
  norm_squared_is(v: std.affine_space.vector3(frame: room(), x: 3, y: 4, z: 0), expected: 25)
    && norm_squared_is(v: std.affine_space.vector3(frame: room(), x: 0 - 3, y: 0 - 4, z: 0), expected: 25)
    && norm_squared_is(v: std.affine_space.zero_vector3(frame: room()), expected: 0)
    && match std.euclidean_geometry.distance_squared3(registry: mm_registry(), from: desk_a(), to: desk_b()) {
         std.affine_space.SpatialArithmeticRefused { cause: _ } => false
         std.affine_space.SpatialFrameRefused { refusal: _ } => false
         std.affine_space.SpatialReady { value: s } =>
           std.measure.square_millimeter_count(m: s) == (1500 * 1500) + (1800 * 1800)
       }
}

// THE NUMERIC POLICY, made executable. Axis-aligned magnitudes are exact; a diagonal is UNRESOLVED
// and carries the exact squared magnitude so a richer kernel can finish.
fn witness_norm_exact_on_axis_unresolved_on_diagonal() -> Bool {
  match std.euclidean_geometry.norm3(registry: mm_registry(), v: std.affine_space.vector3(frame: room(), x: 0, y: 0 - 2500, z: 0)) {
    std.affine_space.SpatialArithmeticRefused { cause: _ } => false
    std.affine_space.SpatialFrameRefused { refusal: _ } => false
    std.affine_space.SpatialReady { value: l } =>
      match l {
        std.euclidean_geometry.LengthExact { value: v } => std.measure.millimeter_count(m: v) == 2500
        std.euclidean_geometry.LengthRootUnresolvedInExactKernel { squared: _, reason: _ } => false
      }
  }
    && match std.euclidean_geometry.norm3(registry: mm_registry(), v: std.affine_space.vector3(frame: room(), x: 3, y: 4, z: 0)) {
         std.affine_space.SpatialArithmeticRefused { cause: _ } => false
         std.affine_space.SpatialFrameRefused { refusal: _ } => false
         std.affine_space.SpatialReady { value: l } =>
           match l {
             std.euclidean_geometry.LengthExact { value: _ } => false
             std.euclidean_geometry.LengthRootUnresolvedInExactKernel { squared: s, reason: _ } =>
               std.measure.square_millimeter_count(m: s) == 25
           }
       }
    && match std.euclidean_geometry.distance3(registry: mm_registry(), from: desk_a(), to: desk_b()) {
         std.affine_space.SpatialArithmeticRefused { cause: _ } => false
         std.affine_space.SpatialFrameRefused { refusal: _ } => false
         std.affine_space.SpatialReady { value: l } =>
           match l {
             std.euclidean_geometry.LengthExact { value: _ } => false
             std.euclidean_geometry.LengthRootUnresolvedInExactKernel { squared: s, reason: _ } =>
               std.measure.square_millimeter_count(m: s) == (1500 * 1500) + (1800 * 1800)
           }
       }
}

// Comparison needs no square root, and is exact where norm leaves the magnitude unresolved.
fn witness_comparison_resolves_where_norm_does_not() -> Bool {
  ready_bool_is(
    r: std.euclidean_geometry.closer_than3(registry: mm_registry(), a_from: std.affine_space.point3(frame: room(), x: 0, y: 0, z: 0), a_to: std.affine_space.point3(frame: room(), x: 3, y: 4, z: 0),
                    b_from: std.affine_space.point3(frame: room(), x: 0, y: 0, z: 0), b_to: std.affine_space.point3(frame: room(), x: 30, y: 40, z: 0)),
    expected: true,
  )
    && ready_bool_is(
         r: std.euclidean_geometry.closer_than3(registry: mm_registry(), a_from: std.affine_space.point3(frame: room(), x: 0, y: 0, z: 0), a_to: std.affine_space.point3(frame: room(), x: 30, y: 40, z: 0),
                         b_from: std.affine_space.point3(frame: room(), x: 0, y: 0, z: 0), b_to: std.affine_space.point3(frame: room(), x: 3, y: 4, z: 0)),
         expected: false,
       )
}

// Zero has magnitude but no direction: a DIFFERENT arm from "this kernel did not resolve it", and
// both are different again from "the machine could not compute it".
fn witness_normalize_separates_no_direction_from_unresolved() -> Bool {
  match std.euclidean_geometry.normalize3(registry: mm_registry(), v: std.affine_space.zero_vector3(frame: room())) {
    std.affine_space.SpatialArithmeticRefused { cause: _ } => false
    std.affine_space.SpatialFrameRefused { refusal: _ } => false
    std.affine_space.SpatialReady { value: d } =>
      match d {
        std.euclidean_geometry.DirectionZeroVectorHasNone => true
        std.euclidean_geometry.DirectionExact { direction: _ } => false
        std.euclidean_geometry.DirectionUnresolvedInAxisKernel { squared_magnitude: _, reason: _ } => false
      }
  }
    && match std.euclidean_geometry.normalize3(registry: mm_registry(), v: std.affine_space.vector3(frame: room(), x: 0, y: 0 - 900, z: 0)) {
         std.affine_space.SpatialArithmeticRefused { cause: _ } => false
         std.affine_space.SpatialFrameRefused { refusal: _ } => false
         std.affine_space.SpatialReady { value: d } =>
           match d {
             std.euclidean_geometry.DirectionExact { direction: a } => is_negative_y(d: a)
             std.euclidean_geometry.DirectionZeroVectorHasNone => false
             std.euclidean_geometry.DirectionUnresolvedInAxisKernel { squared_magnitude: _, reason: _ } => false
           }
       }
    && match std.euclidean_geometry.normalize3(registry: mm_registry(), v: std.affine_space.vector3(frame: room(), x: 3, y: 4, z: 0)) {
         std.affine_space.SpatialArithmeticRefused { cause: _ } => false
         std.affine_space.SpatialFrameRefused { refusal: _ } => false
         std.affine_space.SpatialReady { value: d } =>
           match d {
             std.euclidean_geometry.DirectionUnresolvedInAxisKernel { squared_magnitude: s, reason: _ } =>
               std.measure.square_millimeter_count(m: s) == 25
             std.euclidean_geometry.DirectionExact { direction: _ } => false
             std.euclidean_geometry.DirectionZeroVectorHasNone => false
           }
       }
}

// dot and cross are exact AND dimensionally honest: a dot of two displacements is a signed AREA,
// and a cross is an AREA VECTOR. Neither can be fed back into translate_point3, which takes a
// displacement - that is a type error, not a runtime refusal, which is why there is no claim here
// asserting it: the code expressing it does not compile.
fn witness_dot_and_cross_are_exact_and_dimensioned() -> Bool {
  let u = std.affine_space.vector3(frame: room(), x: 1000, y: 0, z: 0)
  let v = std.affine_space.vector3(frame: room(), x: 0, y: 1000, z: 0)
  dot_is(a: u, b: v, expected: 0)
    && dot_is(a: u, b: u, expected: 1000000)
    && match std.euclidean_geometry.cross3(registry: mm_registry(), a: u, b: v) {
         std.affine_space.SpatialArithmeticRefused { cause: _ } => false
         std.affine_space.SpatialFrameRefused { refusal: _ } => false
         std.affine_space.SpatialReady { value: c } => area_vector_equals(a: c, x: 0, y: 0, z: 1000000)
       }
    && match std.affine_space.negate_vector3(v: u) {
         std.affine_space.SpatialArithmeticRefused { cause: _ } => false
         std.affine_space.SpatialFrameRefused { refusal: _ } => false
         std.affine_space.SpatialReady { value: nu } => dot_is(a: u, b: nu, expected: 0 - 1000000)
       }
}

fn dot_is(a: std.affine_space.Vector3, b: std.affine_space.Vector3, expected: Int) -> Bool {
  match std.euclidean_geometry.dot3(registry: mm_registry(), a: a, b: b) {
    std.affine_space.SpatialFrameRefused { refusal: _ } => false
    std.affine_space.SpatialArithmeticRefused { cause: _ } => false
    std.affine_space.SpatialReady { value: d } => std.measure.signed_square_millimeter_count(m: d) == expected
  }
}

fn area_vector_equals(a: std.euclidean_geometry.AreaVector3, x: Int, y: Int, z: Int) -> Bool {
  std.measure.signed_square_millimeter_count(m: a.x) == x
    && std.measure.signed_square_millimeter_count(m: a.y) == y
    && std.measure.signed_square_millimeter_count(m: a.z) == z
}

fn is_negative_y(d: std.euclidean_geometry.AxisDirection3) -> Bool {
  match d {
    std.euclidean_geometry.NegativeY => true
    std.euclidean_geometry.PositiveY => false
    std.euclidean_geometry.PositiveX => false
    std.euclidean_geometry.NegativeX => false
    std.euclidean_geometry.PositiveZ => false
    std.euclidean_geometry.NegativeZ => false
  }
}

// A transform carries a room point into the building frame. It DECLARES both frames and apply
// checks them; the result carries the destination identity, so a building-frame point cannot be
// silently consumed by a room-frame operation - it is refused, not unwritable.
fn room_to_building() -> std.affine_space.ZQuarterTurnTransform3 {
  std.affine_space.ZQuarterTurnTransform3 {
    from_frame: room(),
    to_frame: building(),
    rotation_about_z: std.affine_space.OneQuarter,
    translation: std.affine_space.vector3(frame: building(), x: 10000, y: 20000, z: 0),
  }
}

fn witness_transform_crosses_frames_exactly() -> Bool {
  match std.affine_space.apply_z_quarter_turn_transform3(transform: room_to_building(), point: std.affine_space.point3(frame: room(), x: 1000, y: 0, z: 500)) {
    std.affine_space.SpatialFrameRefused { refusal: _ } => false
    std.affine_space.SpatialArithmeticRefused { cause: _ } => false
    std.affine_space.SpatialReady { value: moved } =>
      std.affine_space.signed_frame_component_count(c: moved.x) == 10000
        && std.affine_space.signed_frame_component_count(c: moved.y) == 21000
        && std.affine_space.signed_frame_component_count(c: moved.z) == 500
        && std.coordinate_frame.coordinate_frame_identity_eq(a: moved.frame, b: building())
  }
}

// THE REGRESSION CONTROL FOR THE ENTIRE RECUT, and the one witness whose absence let a false claim
// merge. Each arm below is a program that SPATIAL-2 asserted could not be written and that was
// measured compiling clean and producing a plausible number. They must now refuse, and the refusal
// must name which frame was expected and which arrived - a bare "false" would be a verdict on a
// meaningless question rather than a refusal of it.
fn frame_refusal_is(r: std.affine_space.SpatialResult<std.affine_space.Vector3>, left: std.coordinate_frame.CoordinateFrameIdentity, right: std.coordinate_frame.CoordinateFrameIdentity) -> Bool {
  match r {
    std.affine_space.SpatialReady { value: _ } => false
    std.affine_space.SpatialArithmeticRefused { cause: _ } => false
    std.affine_space.SpatialFrameRefused { refusal: fr } =>
      std.coordinate_frame.coordinate_frame_identity_eq(a: fr.left_frame, b: left)
        && std.coordinate_frame.coordinate_frame_identity_eq(a: fr.right_frame, b: right)
        && relation_is_same_frame(r: fr.relation)
  }
}

fn relation_is_same_frame(r: std.affine_space.SpatialFrameRelation) -> Bool {
  match r {
    std.affine_space.SameFrameOperandsRequired => true
    std.affine_space.TransformSourceFrameRequired => false
    MillimetreFrameRequired => false
    std.affine_space.TransformTranslationInDestinationRequired => false
    std.affine_space.ProjectionSourceFrameRequired => false
  }
}

fn relation_is_transform_source(r: std.affine_space.SpatialFrameRelation) -> Bool {
  match r {
    std.affine_space.SameFrameOperandsRequired => false
    std.affine_space.TransformSourceFrameRequired => true
    MillimetreFrameRequired => false
    std.affine_space.TransformTranslationInDestinationRequired => false
    std.affine_space.ProjectionSourceFrameRequired => false
  }
}

fn witness_cross_frame_operations_refuse_and_name_both_frames() -> Bool {
  let room_point = std.affine_space.point3(frame: room(), x: 1, y: 2, z: 3)
  let building_point = std.affine_space.point3(frame: building(), x: 10, y: 20, z: 30)
  let room_vector = std.affine_space.vector3(frame: room(), x: 1, y: 1, z: 1)
  let building_vector = std.affine_space.vector3(frame: building(), x: 1, y: 1, z: 1)
  frame_refusal_is(r: std.affine_space.displacement_between3(from: room_point, to: building_point), left: room(), right: building())
    && frame_refusal_is(r: std.affine_space.add_vector3(a: room_vector, b: building_vector), left: room(), right: building())
    && frame_refusal_is(r: std.affine_space.subtract_vector3(a: room_vector, b: building_vector), left: room(), right: building())
    && match std.affine_space.translate_point3(point: room_point, by: building_vector) {
      std.affine_space.SpatialFrameRefused { refusal: fr } =>
        std.coordinate_frame.coordinate_frame_identity_eq(a: fr.left_frame, b: room())
          && std.coordinate_frame.coordinate_frame_identity_eq(a: fr.right_frame, b: building())
      _ => false
    }
    && match std.affine_space.apply_z_quarter_turn_transform3(transform: room_to_building(), point: building_point) {
      std.affine_space.SpatialFrameRefused { refusal: fr } =>
        std.coordinate_frame.coordinate_frame_identity_eq(a: fr.left_frame, b: room())
          && std.coordinate_frame.coordinate_frame_identity_eq(a: fr.right_frame, b: building())
          && relation_is_transform_source(r: fr.relation)
      _ => false
    }
}

// THE POSITIVE SIBLING. Without it the witness above is satisfied by an operation that refuses
// everything, which is the failure mode a refusal-only control cannot see.
fn witness_same_frame_operations_still_answer() -> Bool {
  let a = std.affine_space.point3(frame: room(), x: 1, y: 2, z: 3)
  let b = std.affine_space.point3(frame: room(), x: 11, y: 22, z: 33)
  match std.affine_space.displacement_between3(from: a, to: b) {
    std.affine_space.SpatialFrameRefused { refusal: _ } => false
    std.affine_space.SpatialReady { value: d } =>
      std.affine_space.signed_frame_component_count(c: d.x) == 10
        && std.affine_space.signed_frame_component_count(c: d.y) == 20
        && std.affine_space.signed_frame_component_count(c: d.z) == 30
        && std.coordinate_frame.coordinate_frame_identity_eq(a: d.frame, b: room())
    _ => false
  }
}

// A FRAME MISMATCH IS NOT AN OVERFLOW, asserted in both directions so the two causes cannot be
// collapsed into one "failed" arm later without this going red: operands that disagree on frame AND
// would also overflow report the frame, because there is no question to overflow.
fn witness_frame_and_overflow_are_distinct_causes() -> Bool {
  let big_room = std.affine_space.vector3(frame: room(), x: std.checked_arithmetic.int_inclusive_max(), y: 0, z: 0)
  let big_building = std.affine_space.vector3(frame: building(), x: std.checked_arithmetic.int_inclusive_max(), y: 0, z: 0)
  let big_room_2 = std.affine_space.vector3(frame: room(), x: std.checked_arithmetic.int_inclusive_max(), y: 0, z: 0)
  frame_refusal_is(r: std.affine_space.add_vector3(a: big_room, b: big_building), left: room(), right: building())
    && match std.affine_space.add_vector3(a: big_room, b: big_room_2) {
      std.affine_space.SpatialArithmeticRefused { cause: _ } => true
      _ => false
    }
}

// THE BOUND IS REAL AND EACH OPERATION CROSSES IT ITS OWN WAY. One enormous value proves one path;
// these prove that add, subtract, negate, multiply, the squaring inside a squared norm, and the
// two-stage transform each refuse where they individually must, and that the refusal names the
// operation that actually failed rather than a generic one.
//
// The identification matters more than the count: before this, every one of these produced a
// wrapped i64 and the surrounding comment called the operation total and exact.
fn refusal_names(r: std.affine_space.SpatialResult<std.affine_space.Vector3>, op: std.checked_arithmetic.IntegerArithmeticOperation) -> Bool {
  match r {
    std.affine_space.SpatialReady { value: _ } => false
    std.affine_space.SpatialArithmeticRefused { cause: c } => operation_equals(a: c.operation, b: op)
    std.affine_space.SpatialFrameRefused { refusal: _ } => false
  }
}

fn operation_equals(a: std.checked_arithmetic.IntegerArithmeticOperation, b: std.checked_arithmetic.IntegerArithmeticOperation) -> Bool {
  match a {
    std.checked_arithmetic.IntegerAdd => match b { std.checked_arithmetic.IntegerAdd => true, std.checked_arithmetic.IntegerSubtract => false, std.checked_arithmetic.IntegerMultiply => false, std.checked_arithmetic.IntegerNegate => false }
    std.checked_arithmetic.IntegerSubtract => match b { std.checked_arithmetic.IntegerAdd => false, std.checked_arithmetic.IntegerSubtract => true, std.checked_arithmetic.IntegerMultiply => false, std.checked_arithmetic.IntegerNegate => false }
    std.checked_arithmetic.IntegerMultiply => match b { std.checked_arithmetic.IntegerAdd => false, std.checked_arithmetic.IntegerSubtract => false, std.checked_arithmetic.IntegerMultiply => true, std.checked_arithmetic.IntegerNegate => false }
    std.checked_arithmetic.IntegerNegate => match b { std.checked_arithmetic.IntegerAdd => false, std.checked_arithmetic.IntegerSubtract => false, std.checked_arithmetic.IntegerMultiply => false, std.checked_arithmetic.IntegerNegate => true }
  }
}

fn max_vector() -> std.affine_space.Vector3 {
  std.affine_space.vector3(frame: room(), x: std.checked_arithmetic.int_inclusive_max(), y: 0, z: 0)
}

fn min_vector() -> std.affine_space.Vector3 {
  std.affine_space.vector3(frame: room(), x: std.checked_arithmetic.int_inclusive_min(), y: 0, z: 0)
}

fn witness_each_operation_refuses_at_its_own_bound() -> Bool {
  refusal_names(r: std.affine_space.add_vector3(a: max_vector(), b: std.affine_space.vector3(frame: room(), x: 1, y: 0, z: 0)), op: std.checked_arithmetic.IntegerAdd)
    && refusal_names(r: std.affine_space.subtract_vector3(a: min_vector(), b: std.affine_space.vector3(frame: room(), x: 1, y: 0, z: 0)), op: std.checked_arithmetic.IntegerSubtract)
    && refusal_names(r: std.affine_space.negate_vector3(v: min_vector()), op: std.checked_arithmetic.IntegerNegate)
    && refusal_names(r: std.affine_space.scale_vector3(v: max_vector(), factor: 2), op: std.checked_arithmetic.IntegerMultiply)
    && refusal_names(r: std.affine_space.rotate_quarter_turns_about_z(v: min_vector(), turns: std.affine_space.TwoQuarters), op: std.checked_arithmetic.IntegerNegate)
    && match std.affine_space.displacement_between3(from: std.affine_space.point3(frame: room(), x: std.checked_arithmetic.int_inclusive_min(), y: 0, z: 0), to: std.affine_space.point3(frame: room(), x: std.checked_arithmetic.int_inclusive_max(), y: 0, z: 0)) {
         std.affine_space.SpatialReady { value: _ } => false
         std.affine_space.SpatialArithmeticRefused { cause: c } => operation_equals(a: c.operation, b: std.checked_arithmetic.IntegerSubtract)
         std.affine_space.SpatialFrameRefused { refusal: _ } => false
       }
    && match std.euclidean_geometry.norm_squared3(registry: mm_registry(), v: std.affine_space.vector3(frame: room(), x: 4000000000, y: 0, z: 0)) {
         std.affine_space.SpatialReady { value: _ } => false
         std.affine_space.SpatialArithmeticRefused { cause: c } => operation_equals(a: c.operation, b: std.checked_arithmetic.IntegerMultiply)
         std.affine_space.SpatialFrameRefused { refusal: _ } => false
       }
    && match std.euclidean_geometry.dot3(registry: mm_registry(), a: std.affine_space.vector3(frame: room(), x: 3000000000, y: 3000000000, z: 0), b: std.affine_space.vector3(frame: room(), x: 3000000000, y: 3000000000, z: 0)) {
         std.affine_space.SpatialReady { value: _ } => false
         std.affine_space.SpatialArithmeticRefused { cause: c } => operation_equals(a: c.operation, b: std.checked_arithmetic.IntegerAdd)
         std.affine_space.SpatialFrameRefused { refusal: _ } => false
       }
    && match std.affine_space.apply_z_quarter_turn_transform3(
              transform: std.affine_space.ZQuarterTurnTransform3 { from_frame: room(), to_frame: room(), rotation_about_z: std.affine_space.NoTurn, translation: std.affine_space.vector3(frame: room(), x: 1, y: 0, z: 0) },
              point: std.affine_space.point3(frame: room(), x: std.checked_arithmetic.int_inclusive_max(), y: 0, z: 0),
            ) {
         std.affine_space.SpatialReady { value: _ } => false
         std.affine_space.SpatialArithmeticRefused { cause: c } => operation_equals(a: c.operation, b: std.checked_arithmetic.IntegerAdd)
         std.affine_space.SpatialFrameRefused { refusal: _ } => false
       }
}

// THE OPERANDS TRAVEL WITH THE CAUSE. A refusal that named only the operation would tell a caller
// that an addition failed somewhere in a three-component fold; this says which two numbers.
fn witness_refusal_carries_its_operands() -> Bool {
  match std.affine_space.add_vector3(a: max_vector(), b: std.affine_space.vector3(frame: room(), x: 1, y: 0, z: 0)) {
    std.affine_space.SpatialReady { value: _ } => false
    std.affine_space.SpatialFrameRefused { refusal: _ } => false
    std.affine_space.SpatialArithmeticRefused { cause: c } =>
      match c.operands {
        std.checked_arithmetic.UnaryOperand { value: _ } => false
        std.checked_arithmetic.BinaryOperands { lhs: l, rhs: r } => l == std.checked_arithmetic.int_inclusive_max() && r == 1
      }
  }
    && match std.affine_space.negate_vector3(v: min_vector()) {
         std.affine_space.SpatialReady { value: _ } => false
         std.affine_space.SpatialFrameRefused { refusal: _ } => false
         std.affine_space.SpatialArithmeticRefused { cause: c } =>
           match c.operands {
             std.checked_arithmetic.UnaryOperand { value: v } => v == std.checked_arithmetic.int_inclusive_min()
             std.checked_arithmetic.BinaryOperands { lhs: _, rhs: _ } => false
           }
       }
}

// THE POSITIVE CONTROL FOR THE BOUND ITSELF. Every refusal above would also be produced by an
// implementation that refused everything, so the boundary must be shown to be exactly where it is:
// the maximum is reachable, and one past it is not.
fn witness_bound_is_reached_not_merely_approached() -> Bool {
  ready_vector_equals(
    r: std.affine_space.add_vector3(a: std.affine_space.vector3(frame: room(), x: std.checked_arithmetic.int_inclusive_max() - 1, y: 0, z: 0), b: std.affine_space.vector3(frame: room(), x: 1, y: 0, z: 0)),
    b: max_vector(),
  )
    && ready_vector_equals(r: std.affine_space.negate_vector3(v: std.affine_space.vector3(frame: room(), x: std.checked_arithmetic.int_inclusive_max(), y: 0, z: 0)),
                           b: std.affine_space.vector3(frame: room(), x: 0 - std.checked_arithmetic.int_inclusive_max(), y: 0, z: 0))
    && ready_vector_equals(r: std.affine_space.scale_vector3(v: std.affine_space.vector3(frame: room(), x: std.checked_arithmetic.int_inclusive_max() / 2, y: 0, z: 0), factor: 2),
                           b: std.affine_space.vector3(frame: room(), x: (std.checked_arithmetic.int_inclusive_max() / 2) * 2, y: 0, z: 0))
}

// THE LYING-PRODUCER CONTROL, and it is the reason the carried identity exists at all rather than
// being a nicety beside the static wall. Producer-side return conformance is open
// (feature:conformance-produced-type-identity), so a function may DECLARE a building-frame result
// while handing back a value minted in the room frame. Nothing at a call boundary can catch that:
// the consumer sees only the declared type, and the separate compiler repair judges ARGUMENTS.
//
// What this asserts is that the lie does not propagate. The value still carries room(), so the next
// frame-sensitive operation refuses and names both frames - the guarantee survives a false
// annotation precisely because it derives from the value rather than from what was written above it.
// If this ever passes by the value actually being in building(), the carried identity has stopped
// being the authority and the claim in std.coordinate_frame is false again.
fn falsely_reframed_point() -> std.affine_space.Point3 {
  std.affine_space.point3(frame: room(), x: 5, y: 5, z: 5)
}

fn witness_false_return_annotation_cannot_rewrite_carried_frame() -> Bool {
  let claimed_building = falsely_reframed_point()
  let genuine_building = std.affine_space.point3(frame: building(), x: 0, y: 0, z: 0)
  std.coordinate_frame.coordinate_frame_identity_eq(a: claimed_building.frame, b: room())
    && frame_refusal_is(
      r: std.affine_space.displacement_between3(from: genuine_building, to: claimed_building),
      left: building(),
      right: room())
}

// THE TRANSFORM'S SECOND FRAME OBLIGATION, distinct from the first and invisible to it. A transform
// whose translation is not expressed in its destination frame is a construction error the
// source-frame check cannot see, so it carries its own relation and its own control.
fn misframed_transform() -> std.affine_space.ZQuarterTurnTransform3 {
  std.affine_space.ZQuarterTurnTransform3 {
    from_frame: room(),
    to_frame: building(),
    rotation_about_z: std.affine_space.NoTurn,
    translation: std.affine_space.vector3(frame: room(), x: 1, y: 1, z: 1),
  }
}

fn witness_transform_translation_must_be_in_destination_frame() -> Bool {
  match std.affine_space.apply_z_quarter_turn_transform3(transform: misframed_transform(), point: std.affine_space.point3(frame: room(), x: 0, y: 0, z: 0)) {
    std.affine_space.SpatialFrameRefused { refusal: fr } =>
      std.coordinate_frame.coordinate_frame_identity_eq(a: fr.left_frame, b: building())
        && std.coordinate_frame.coordinate_frame_identity_eq(a: fr.right_frame, b: room())
        && match fr.relation {
          MillimetreFrameRequired => false
    std.affine_space.TransformTranslationInDestinationRequired => true
          std.affine_space.SameFrameOperandsRequired => false
          std.affine_space.TransformSourceFrameRequired => false
          std.affine_space.ProjectionSourceFrameRequired => false
        }
    std.affine_space.SpatialFrameRefused { refusal: _ } => false
    std.affine_space.SpatialReady { value: _ } => false
    std.affine_space.SpatialArithmeticRefused { cause: _ } => false
  }
}

test fn affine_space_witnesses() -> Bool {
  witness_point_difference_is_signed_displacement()
    && witness_translate_inverts_difference()
    && witness_vectors_compose()
    && witness_quarter_turns_are_exact_and_close()
    && witness_norm_squared_is_exact()
    && witness_norm_exact_on_axis_unresolved_on_diagonal()
    && witness_comparison_resolves_where_norm_does_not()
    && witness_normalize_separates_no_direction_from_unresolved()
    && witness_dot_and_cross_are_exact_and_dimensioned()
    && witness_transform_crosses_frames_exactly()
    && witness_cross_frame_operations_refuse_and_name_both_frames()
    && witness_same_frame_operations_still_answer()
    && witness_frame_and_overflow_are_distinct_causes()
    && witness_false_return_annotation_cannot_rewrite_carried_frame()
    && witness_transform_translation_must_be_in_destination_frame()
    && witness_each_operation_refuses_at_its_own_bound()
    && witness_refusal_carries_its_operands()
    && witness_bound_is_reached_not_merely_approached()
}

// A MICROMETRE FRAME REFUSES RATHER THAN ANSWERING IN MILLIMETRES. This is the wall, and the
// number is chosen so the lie would be maximally plausible: a vector of a thousand micrometre
// counts along one axis is a real board-scale displacement, and the unguarded arithmetic returned
// millimeter(1000) for it - arithmetic that is right, a label that is wrong by a factor of a
// thousand, and nothing about the result that looks suspicious. The millimetre frame is the
// positive control on the same vector, so this asserts the frame decides the outcome rather than
// the operation refusing everything.
fn micro_registry() -> std.spatial_frame.SpatialFrameRegistry {
  match std.spatial_frame.register_frame(r: std.spatial_frame.empty_frame_registry(), identity: room(), length_scale: std.measure.Micro) {
    std.spatial_frame.FrameRegistered { frame: f } => std.spatial_frame.registry_with(r: std.spatial_frame.empty_frame_registry(), f: f)
    std.spatial_frame.FrameRegistrationRefused { cause: _ } => std.spatial_frame.empty_frame_registry()
  }
}

// AND AN UNREGISTERED FRAME REFUSES TOO, because a frame with no declared quantum has no unit to
// check the label against - assuming the default is the convention this layer exists to remove.
// CROSS PRODUCT IS THE SAME WALL, censused rather than waited for: it labels THREE components
// in square millimetres, so an unguarded micrometre frame mislabels a whole vector at once.
test fn w_metric_operations_refuse_a_frame_they_cannot_label() -> Bool {
  let v = std.affine_space.vector3(frame: room(), x: 1000, y: 0, z: 0)
  let refused_in_micrometres = match std.euclidean_geometry.norm3(registry: micro_registry(), v: v) {
    std.affine_space.SpatialFrameRefused { refusal: r } =>
      match r.relation {
        MillimetreFrameRequired => true
        std.affine_space.SameFrameOperandsRequired => false
        std.affine_space.TransformSourceFrameRequired => false
        std.affine_space.TransformTranslationInDestinationRequired => false
        std.affine_space.ProjectionSourceFrameRequired => false
      }
    std.affine_space.SpatialReady { value: _ } => false
    std.affine_space.SpatialArithmeticRefused { cause: _ } => false
  }
  let answered_in_millimetres = match std.euclidean_geometry.norm3(registry: mm_registry(), v: v) {
    std.affine_space.SpatialReady { value: l } =>
      match l {
        std.euclidean_geometry.LengthExact { value: mm } => std.measure.millimeter_count(m: mm) == 1000
        std.euclidean_geometry.LengthRootUnresolvedInExactKernel { squared: _, reason: _ } => false
      }
    std.affine_space.SpatialFrameRefused { refusal: _ } => false
    std.affine_space.SpatialArithmeticRefused { cause: _ } => false
  }
  let refused_when_unregistered = match std.euclidean_geometry.norm3(registry: std.spatial_frame.empty_frame_registry(), v: v) {
    std.affine_space.SpatialFrameRefused { refusal: _ } => true
    std.affine_space.SpatialReady { value: _ } => false
    std.affine_space.SpatialArithmeticRefused { cause: _ } => false
  }
  let cross_refused_in_micrometres = match std.euclidean_geometry.cross3(registry: micro_registry(), a: v, b: std.affine_space.vector3(frame: room(), x: 0, y: 1000, z: 0)) {
    std.affine_space.SpatialFrameRefused { refusal: r } =>
      match r.relation {
        MillimetreFrameRequired => true
        std.affine_space.SameFrameOperandsRequired => false
        std.affine_space.TransformSourceFrameRequired => false
        std.affine_space.TransformTranslationInDestinationRequired => false
        std.affine_space.ProjectionSourceFrameRequired => false
      }
    std.affine_space.SpatialReady { value: _ } => false
    std.affine_space.SpatialArithmeticRefused { cause: _ } => false
  }
  let cross_answers_in_millimetres = match std.euclidean_geometry.cross3(registry: mm_registry(), a: v, b: std.affine_space.vector3(frame: room(), x: 0, y: 1000, z: 0)) {
    std.affine_space.SpatialReady { value: av } => std.measure.signed_square_millimeter_count(m: av.z) == 1000000
    std.affine_space.SpatialFrameRefused { refusal: _ } => false
    std.affine_space.SpatialArithmeticRefused { cause: _ } => false
  }
  refused_in_micrometres && answered_in_millimetres && refused_when_unregistered
    && cross_refused_in_micrometres && cross_answers_in_millimetres
}
