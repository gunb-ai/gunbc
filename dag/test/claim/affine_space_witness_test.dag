module test.claim.affine_space_witness

import std.types { Bool }
import std.integer { Int }
import std.nat { Nat }
import std.checked_arithmetic {
  IntegerOverflow,
  IntegerArithmeticOperation, IntegerAdd, IntegerSubtract, IntegerMultiply, IntegerNegate,
  CheckedIntOperands, UnaryOperand, BinaryOperands,
  int_inclusive_max, int_inclusive_min,
}
import std.measure {
  millimeter_count, signed_millimeter_component_count,
  square_millimeter_count, signed_square_millimeter_count,
}
import std.affine_space {
  Vector3, Point3, vector3, point3, zero_vector3,
  translate_point3, displacement_between3, add_vector3, subtract_vector3,
  negate_vector3, scale_vector3, rotate_quarter_turns_about_z,
  QuarterTurns, NoTurn, OneQuarter, TwoQuarters, ThreeQuarters,
  ZQuarterTurnTransform3, apply_z_quarter_turn_transform3,
  SpatialArithmeticResult, SpatialArithmeticReady, SpatialArithmeticRefused,
}
import std.euclidean_geometry {
  ExactLength, LengthExact, LengthRootUnresolvedInExactKernel,
  Direction3Result, DirectionExact, DirectionZeroVectorHasNone, DirectionUnresolvedInAxisKernel,
  AxisDirection3, PositiveX, NegativeX, PositiveY, NegativeY, PositiveZ, NegativeZ,
  AreaVector3,
  dot3, cross3, norm_squared3, norm3, distance3, distance_squared3, closer_than3, normalize3,
}

// Two distinct frames. They exist only as type-level tags: the room's origin is its southwest
// floor corner, the building's is elsewhere, and a coordinate means nothing without saying which.
type RoomFrame
type BuildingFrame

fn desk_a() -> Point3<RoomFrame> { point3(x: 1200, y: 800, z: 0) }

// Nothing physically negative about this desk: it is 300 mm on the negative side of the chosen
// x-origin. That is the whole point of the affine layer.
fn desk_b() -> Point3<RoomFrame> { point3(x: 0 - 300, y: 2600, z: 0) }

fn vector_equals(a: Vector3<RoomFrame>, b: Vector3<RoomFrame>) -> Bool {
  signed_millimeter_component_count(m: a.x) == signed_millimeter_component_count(m: b.x)
    && signed_millimeter_component_count(m: a.y) == signed_millimeter_component_count(m: b.y)
    && signed_millimeter_component_count(m: a.z) == signed_millimeter_component_count(m: b.z)
}

fn point_equals(a: Point3<RoomFrame>, b: Point3<RoomFrame>) -> Bool {
  signed_millimeter_component_count(m: a.x) == signed_millimeter_component_count(m: b.x)
    && signed_millimeter_component_count(m: a.y) == signed_millimeter_component_count(m: b.y)
    && signed_millimeter_component_count(m: a.z) == signed_millimeter_component_count(m: b.z)
}

// THE READY SIDE IS ASSERTED, NEVER ASSUMED. Every claim below that expects an ordinary
// architectural value goes through one of these: a refusal makes the claim FALSE rather than being
// silently skipped, so an implementation that started refusing everything could not read as green.
fn ready_vector_equals(r: SpatialArithmeticResult<Vector3<RoomFrame>>, b: Vector3<RoomFrame>) -> Bool {
  match r {
    SpatialArithmeticRefused { cause: _ } => false
    SpatialArithmeticReady { value: v } => vector_equals(a: v, b: b)
  }
}

fn ready_point_equals(r: SpatialArithmeticResult<Point3<RoomFrame>>, b: Point3<RoomFrame>) -> Bool {
  match r {
    SpatialArithmeticRefused { cause: _ } => false
    SpatialArithmeticReady { value: p } => point_equals(a: p, b: b)
  }
}

fn ready_square_millimeter_is(r: SpatialArithmeticResult<Nat>, expected: Nat) -> Bool {
  match r {
    SpatialArithmeticRefused { cause: _ } => false
    SpatialArithmeticReady { value: n } => n == expected
  }
}

fn norm_squared_is(v: Vector3<RoomFrame>, expected: Nat) -> Bool {
  match norm_squared3(v: v) {
    SpatialArithmeticRefused { cause: _ } => false
    SpatialArithmeticReady { value: s } => square_millimeter_count(m: s) == expected
  }
}

fn ready_bool_is(r: SpatialArithmeticResult<Bool>, expected: Bool) -> Bool {
  match r {
    SpatialArithmeticRefused { cause: _ } => false
    SpatialArithmeticReady { value: b } => b == expected
  }
}

// Point - Point -> Vector, with signed components. desk_b - desk_a = (-1500, 1800, 0).
fn witness_point_difference_is_signed_displacement() -> Bool {
  ready_vector_equals(
    r: displacement_between3(from: desk_a(), to: desk_b()),
    b: vector3(x: 0 - 1500, y: 1800, z: 0),
  )
}

// Point + Vector -> Point, and it inverts the difference: a + (b - a) == b.
fn witness_translate_inverts_difference() -> Bool {
  match displacement_between3(from: desk_a(), to: desk_b()) {
    SpatialArithmeticRefused { cause: _ } => false
    SpatialArithmeticReady { value: d } =>
      ready_point_equals(r: translate_point3(point: desk_a(), by: d), b: desk_b())
  }
    && ready_point_equals(r: translate_point3(point: desk_a(), by: zero_vector3()), b: desk_a())
}

// Vector +/- Vector -> Vector, and negation is the additive inverse.
fn witness_vectors_compose() -> Bool {
  let u = vector3(x: 100, y: 0 - 50, z: 25)
  let v = vector3(x: 0 - 30, y: 70, z: 0 - 5)
  match add_vector3(a: u, b: v) {
    SpatialArithmeticRefused { cause: _ } => false
    SpatialArithmeticReady { value: sum } =>
      ready_vector_equals(r: subtract_vector3(a: sum, b: v), b: u)
  }
    && match negate_vector3(v: u) {
         SpatialArithmeticRefused { cause: _ } => false
         SpatialArithmeticReady { value: nu } =>
           ready_vector_equals(r: add_vector3(a: u, b: nu), b: zero_vector3())
       }
    && ready_vector_equals(r: scale_vector3(v: u, factor: 2), b: vector3(x: 200, y: 0 - 100, z: 50))
}

// A quarter turn about +Z is exact: (x, y) -> (-y, x); four of them are the identity.
//
// BOTH x AND y ARE NONZERO ON PURPOSE. An earlier version used (1000, 0, 7), where a reflection
// (x, y) -> (y, x) and a rotation (x, y) -> (-y, x) produce the SAME answer, so the claim passed
// while the operation was a reflection. The defect was found by mutating the implementation and
// watching this witness stay green; an asymmetric vector is what makes the sign observable.
fn witness_quarter_turns_are_exact_and_close() -> Bool {
  let v = vector3(x: 1000, y: 300, z: 7)
  ready_vector_equals(r: rotate_quarter_turns_about_z(v: v, turns: OneQuarter), b: vector3(x: 0 - 300, y: 1000, z: 7))
    && ready_vector_equals(r: rotate_quarter_turns_about_z(v: v, turns: TwoQuarters), b: vector3(x: 0 - 1000, y: 0 - 300, z: 7))
    && ready_vector_equals(r: rotate_quarter_turns_about_z(v: v, turns: ThreeQuarters), b: vector3(x: 300, y: 0 - 1000, z: 7))
    && ready_vector_equals(r: rotate_quarter_turns_about_z(v: v, turns: NoTurn), b: v)
    && match rotate_quarter_turns_about_z(v: v, turns: TwoQuarters) {
         SpatialArithmeticRefused { cause: _ } => false
         SpatialArithmeticReady { value: half } =>
           ready_vector_equals(r: rotate_quarter_turns_about_z(v: half, turns: TwoQuarters), b: v)
       }
}

// Squared magnitudes are exact wherever they are representable, including the diagonal case norm3
// must leave unresolved.
fn witness_norm_squared_is_exact() -> Bool {
  norm_squared_is(v: vector3(x: 3, y: 4, z: 0), expected: 25)
    && norm_squared_is(v: vector3(x: 0 - 3, y: 0 - 4, z: 0), expected: 25)
    && norm_squared_is(v: zero_vector3(), expected: 0)
    && match distance_squared3(from: desk_a(), to: desk_b()) {
         SpatialArithmeticRefused { cause: _ } => false
         SpatialArithmeticReady { value: s } =>
           square_millimeter_count(m: s) == (1500 * 1500) + (1800 * 1800)
       }
}

// THE NUMERIC POLICY, made executable. Axis-aligned magnitudes are exact; a diagonal is UNRESOLVED
// and carries the exact squared magnitude so a richer kernel can finish.
fn witness_norm_exact_on_axis_unresolved_on_diagonal() -> Bool {
  match norm3(v: vector3(x: 0, y: 0 - 2500, z: 0)) {
    SpatialArithmeticRefused { cause: _ } => false
    SpatialArithmeticReady { value: l } =>
      match l {
        LengthExact { value: v } => millimeter_count(m: v) == 2500
        LengthRootUnresolvedInExactKernel { squared: _, reason: _ } => false
      }
  }
    && match norm3(v: vector3(x: 3, y: 4, z: 0)) {
         SpatialArithmeticRefused { cause: _ } => false
         SpatialArithmeticReady { value: l } =>
           match l {
             LengthExact { value: _ } => false
             LengthRootUnresolvedInExactKernel { squared: s, reason: _ } =>
               square_millimeter_count(m: s) == 25
           }
       }
    && match distance3(from: desk_a(), to: desk_b()) {
         SpatialArithmeticRefused { cause: _ } => false
         SpatialArithmeticReady { value: l } =>
           match l {
             LengthExact { value: _ } => false
             LengthRootUnresolvedInExactKernel { squared: s, reason: _ } =>
               square_millimeter_count(m: s) == (1500 * 1500) + (1800 * 1800)
           }
       }
}

// Comparison needs no square root, and is exact where norm leaves the magnitude unresolved.
fn witness_comparison_resolves_where_norm_does_not() -> Bool {
  ready_bool_is(
    r: closer_than3(a_from: point3(x: 0, y: 0, z: 0), a_to: point3(x: 3, y: 4, z: 0),
                    b_from: point3(x: 0, y: 0, z: 0), b_to: point3(x: 30, y: 40, z: 0)),
    expected: true,
  )
    && ready_bool_is(
         r: closer_than3(a_from: point3(x: 0, y: 0, z: 0), a_to: point3(x: 30, y: 40, z: 0),
                         b_from: point3(x: 0, y: 0, z: 0), b_to: point3(x: 3, y: 4, z: 0)),
         expected: false,
       )
}

// Zero has magnitude but no direction: a DIFFERENT arm from "this kernel did not resolve it", and
// both are different again from "the machine could not compute it".
fn witness_normalize_separates_no_direction_from_unresolved() -> Bool {
  match normalize3(v: zero_vector3()) {
    SpatialArithmeticRefused { cause: _ } => false
    SpatialArithmeticReady { value: d } =>
      match d {
        DirectionZeroVectorHasNone => true
        DirectionExact { direction: _ } => false
        DirectionUnresolvedInAxisKernel { squared_magnitude: _, reason: _ } => false
      }
  }
    && match normalize3(v: vector3(x: 0, y: 0 - 900, z: 0)) {
         SpatialArithmeticRefused { cause: _ } => false
         SpatialArithmeticReady { value: d } =>
           match d {
             DirectionExact { direction: a } => is_negative_y(d: a)
             DirectionZeroVectorHasNone => false
             DirectionUnresolvedInAxisKernel { squared_magnitude: _, reason: _ } => false
           }
       }
    && match normalize3(v: vector3(x: 3, y: 4, z: 0)) {
         SpatialArithmeticRefused { cause: _ } => false
         SpatialArithmeticReady { value: d } =>
           match d {
             DirectionUnresolvedInAxisKernel { squared_magnitude: s, reason: _ } =>
               square_millimeter_count(m: s) == 25
             DirectionExact { direction: _ } => false
             DirectionZeroVectorHasNone => false
           }
       }
}

// dot and cross are exact AND dimensionally honest: a dot of two displacements is a signed AREA,
// and a cross is an AREA VECTOR. Neither can be fed back into translate_point3, which takes a
// displacement - that is a type error, not a runtime refusal, which is why there is no claim here
// asserting it: the code expressing it does not compile.
fn witness_dot_and_cross_are_exact_and_dimensioned() -> Bool {
  let u = vector3(x: 1000, y: 0, z: 0)
  let v = vector3(x: 0, y: 1000, z: 0)
  dot_is(a: u, b: v, expected: 0)
    && dot_is(a: u, b: u, expected: 1000000)
    && match cross3(a: u, b: v) {
         SpatialArithmeticRefused { cause: _ } => false
         SpatialArithmeticReady { value: c } => area_vector_equals(a: c, x: 0, y: 0, z: 1000000)
       }
    && match negate_vector3(v: u) {
         SpatialArithmeticRefused { cause: _ } => false
         SpatialArithmeticReady { value: nu } => dot_is(a: u, b: nu, expected: 0 - 1000000)
       }
}

fn dot_is(a: Vector3<RoomFrame>, b: Vector3<RoomFrame>, expected: Int) -> Bool {
  match dot3(a: a, b: b) {
    SpatialArithmeticRefused { cause: _ } => false
    SpatialArithmeticReady { value: d } => signed_square_millimeter_count(m: d) == expected
  }
}

fn area_vector_equals(a: AreaVector3<RoomFrame>, x: Int, y: Int, z: Int) -> Bool {
  signed_square_millimeter_count(m: a.x) == x
    && signed_square_millimeter_count(m: a.y) == y
    && signed_square_millimeter_count(m: a.z) == z
}

fn is_negative_y(d: AxisDirection3<RoomFrame>) -> Bool {
  match d {
    NegativeY => true
    PositiveY => false
    PositiveX => false
    NegativeX => false
    PositiveZ => false
    NegativeZ => false
  }
}

// A transform carries a room point into the building frame. Its RESULT TYPE is Point3<BuildingFrame>,
// so it cannot be fed back into a RoomFrame operation - the cross-frame error is unwritable rather
// than refused at runtime.
fn room_to_building() -> ZQuarterTurnTransform3<RoomFrame, BuildingFrame> {
  ZQuarterTurnTransform3 { rotation_about_z: OneQuarter, translation: vector3(x: 10000, y: 20000, z: 0) }
}

fn witness_transform_crosses_frames_exactly() -> Bool {
  match apply_z_quarter_turn_transform3(transform: room_to_building(), point: point3(x: 1000, y: 0, z: 500)) {
    SpatialArithmeticRefused { cause: _ } => false
    SpatialArithmeticReady { value: moved } =>
      signed_millimeter_component_count(m: moved.x) == 10000
        && signed_millimeter_component_count(m: moved.y) == 21000
        && signed_millimeter_component_count(m: moved.z) == 500
  }
}

// THE BOUND IS REAL AND EACH OPERATION CROSSES IT ITS OWN WAY. One enormous value proves one path;
// these prove that add, subtract, negate, multiply, the squaring inside a squared norm, and the
// two-stage transform each refuse where they individually must, and that the refusal names the
// operation that actually failed rather than a generic one.
//
// The identification matters more than the count: before this, every one of these produced a
// wrapped i64 and the surrounding comment called the operation total and exact.
fn refusal_names(r: SpatialArithmeticResult<Vector3<RoomFrame>>, op: IntegerArithmeticOperation) -> Bool {
  match r {
    SpatialArithmeticReady { value: _ } => false
    SpatialArithmeticRefused { cause: c } => operation_equals(a: c.operation, b: op)
  }
}

fn operation_equals(a: IntegerArithmeticOperation, b: IntegerArithmeticOperation) -> Bool {
  match a {
    IntegerAdd => match b { IntegerAdd => true, IntegerSubtract => false, IntegerMultiply => false, IntegerNegate => false }
    IntegerSubtract => match b { IntegerAdd => false, IntegerSubtract => true, IntegerMultiply => false, IntegerNegate => false }
    IntegerMultiply => match b { IntegerAdd => false, IntegerSubtract => false, IntegerMultiply => true, IntegerNegate => false }
    IntegerNegate => match b { IntegerAdd => false, IntegerSubtract => false, IntegerMultiply => false, IntegerNegate => true }
  }
}

fn max_vector() -> Vector3<RoomFrame> {
  vector3(x: int_inclusive_max(), y: 0, z: 0)
}

fn min_vector() -> Vector3<RoomFrame> {
  vector3(x: int_inclusive_min(), y: 0, z: 0)
}

fn witness_each_operation_refuses_at_its_own_bound() -> Bool {
  refusal_names(r: add_vector3(a: max_vector(), b: vector3(x: 1, y: 0, z: 0)), op: IntegerAdd)
    && refusal_names(r: subtract_vector3(a: min_vector(), b: vector3(x: 1, y: 0, z: 0)), op: IntegerSubtract)
    && refusal_names(r: negate_vector3(v: min_vector()), op: IntegerNegate)
    && refusal_names(r: scale_vector3(v: max_vector(), factor: 2), op: IntegerMultiply)
    && refusal_names(r: rotate_quarter_turns_about_z(v: min_vector(), turns: TwoQuarters), op: IntegerNegate)
    && match displacement_between3(from: point3(x: int_inclusive_min(), y: 0, z: 0), to: point3(x: int_inclusive_max(), y: 0, z: 0)) {
         SpatialArithmeticReady { value: _ } => false
         SpatialArithmeticRefused { cause: c } => operation_equals(a: c.operation, b: IntegerSubtract)
       }
    && match norm_squared3(v: vector3(x: 4000000000, y: 0, z: 0)) {
         SpatialArithmeticReady { value: _ } => false
         SpatialArithmeticRefused { cause: c } => operation_equals(a: c.operation, b: IntegerMultiply)
       }
    && match dot3(a: vector3(x: 3000000000, y: 3000000000, z: 0), b: vector3(x: 3000000000, y: 3000000000, z: 0)) {
         SpatialArithmeticReady { value: _ } => false
         SpatialArithmeticRefused { cause: c } => operation_equals(a: c.operation, b: IntegerAdd)
       }
    && match apply_z_quarter_turn_transform3(
              transform: ZQuarterTurnTransform3 { rotation_about_z: NoTurn, translation: vector3(x: 1, y: 0, z: 0) },
              point: point3(x: int_inclusive_max(), y: 0, z: 0),
            ) {
         SpatialArithmeticReady { value: _ } => false
         SpatialArithmeticRefused { cause: c } => operation_equals(a: c.operation, b: IntegerAdd)
       }
}

// THE OPERANDS TRAVEL WITH THE CAUSE. A refusal that named only the operation would tell a caller
// that an addition failed somewhere in a three-component fold; this says which two numbers.
fn witness_refusal_carries_its_operands() -> Bool {
  match add_vector3(a: max_vector(), b: vector3(x: 1, y: 0, z: 0)) {
    SpatialArithmeticReady { value: _ } => false
    SpatialArithmeticRefused { cause: c } =>
      match c.operands {
        UnaryOperand { value: _ } => false
        BinaryOperands { lhs: l, rhs: r } => l == int_inclusive_max() && r == 1
      }
  }
    && match negate_vector3(v: min_vector()) {
         SpatialArithmeticReady { value: _ } => false
         SpatialArithmeticRefused { cause: c } =>
           match c.operands {
             UnaryOperand { value: v } => v == int_inclusive_min()
             BinaryOperands { lhs: _, rhs: _ } => false
           }
       }
}

// THE POSITIVE CONTROL FOR THE BOUND ITSELF. Every refusal above would also be produced by an
// implementation that refused everything, so the boundary must be shown to be exactly where it is:
// the maximum is reachable, and one past it is not.
fn witness_bound_is_reached_not_merely_approached() -> Bool {
  ready_vector_equals(
    r: add_vector3(a: vector3(x: int_inclusive_max() - 1, y: 0, z: 0), b: vector3(x: 1, y: 0, z: 0)),
    b: max_vector(),
  )
    && ready_vector_equals(r: negate_vector3(v: vector3(x: int_inclusive_max(), y: 0, z: 0)),
                           b: vector3(x: 0 - int_inclusive_max(), y: 0, z: 0))
    && ready_vector_equals(r: scale_vector3(v: vector3(x: int_inclusive_max() / 2, y: 0, z: 0), factor: 2),
                           b: vector3(x: (int_inclusive_max() / 2) * 2, y: 0, z: 0))
}

test fn affine_space_witnesses() -> Bool {
  witness_point_difference_is_signed_displacement()
    && witness_translate_inverts_difference()
    && witness_vectors_compose()
    && witness_quarter_turns_are_exact_and_close()
    && witness_norm_squared_is_exact()
    && witness_norm_exact_on_axis_unresolved_on_diagonal()
    && witness_comparison_resolves_where_norm_does_not()
    && witness_normalize_separates_no_direction_from_unresolved()
    && witness_dot_and_cross_are_exact_and_dimensioned()
    && witness_transform_crosses_frames_exactly()
    && witness_each_operation_refuses_at_its_own_bound()
    && witness_refusal_carries_its_operands()
    && witness_bound_is_reached_not_merely_approached()
}
