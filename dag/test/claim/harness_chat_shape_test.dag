module test.claim.harness_chat_shape

import std.types { list_length, Bool, String, Int, List }
import std.measure { TokenCount, token_count_value }
import extdeps.languages.json.emit { JsonValue, json_object, json_kv, json_string, json_int, serialize_json }
import extdeps.llm.anthropic_messages_api { ToolUse, EndTurn, MaxTokens }
import gunbc.harness.harness_wire {
  HarnessWireBlock, WireTextBlock, WireThinkingBlock, WireToolUseBlock,
  HarnessResponseRead, HarnessResponseParsed, HarnessResponseUnreadable,
  HarnessWireShape, AnthropicMessagesShape, OpenAiChatCompletionsShape,
  HarnessUsageRead, UsageRead, UsageUnreadable,
  harness_decode_response,
  harness_decode_chat_completion, harness_backend_path, harness_backend_url_for_address, harness_engine_replica_roster, HarnessReplicaRoster, HarnessReplicasResolved, HarnessReplicasUnresolved }
import gunbc.harness.harness_reasoning_wire { HarnessServingUnit, DeepseekV4FlashOnVllm }
import gunbc.spark.pair_serving_desired { spark_pair_serving_groups, spark_pair_serving_head }
import gunbc.fleet_intent_network { host_lan_address }
import gunbc.harness.harness_turn {
  HarnessToolResult, harness_assistant_message_json, harness_tool_result_messages_json,
  harness_user_text_message_json,
}

// THE CHAT SHAPE IS A SECOND REALIZATION OF ONE INTERFACE. These witnesses decode a fixture chat
// completion into the same blocks the messages shape yields, and encode the same blocks back into
// the chat shape's envelopes. The fixture's reasoning_content is the field the encoder re-renders
// when tools are defined; its tool call carries arguments as the JSON STRING vLLM emits.
data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn fixture_completion() -> String {
  "{\"choices\":[{\"finish_reason\":\"tool_calls\",\"message\":{\"role\":\"assistant\",\"content\":\"Listing now.\",\"reasoning_content\":\"The user wants files, so list them.\",\"tool_calls\":[{\"id\":\"chatcmpl-tool-1\",\"type\":\"function\",\"function\":{\"name\":\"run_command\",\"arguments\":\"{\\\"command\\\": \\\"ls\\\"}\"}}]}}],\"usage\":{\"prompt_tokens\":365,\"completion_tokens\":41}}"
}

test fn a_chat_completion_decodes_to_thinking_text_and_tool_use() -> Bool {
  match harness_decode_chat_completion(unit: DeepseekV4FlashOnVllm, body: fixture_completion()) {
    HarnessResponseUnreadable { cause: _ } => false
    HarnessResponseParsed { blocks, stop_reason, usage } =>
      list_length(items: blocks) == 3
        && (match blocks.first() { Present { value: WireThinkingBlock { thinking: r } } => r.contains("wants files")  _ => false })
        && (match blocks.last() { Present { value: WireToolUseBlock { id, name, input: _ } } => id == "chatcmpl-tool-1" && name == "run_command"  _ => false })
        && (match stop_reason { ToolUse => true  _ => false })
        && (match usage { UsageRead { input_tokens: i, output_tokens: o } => token_count_value(t: i) == 365 && token_count_value(t: o) == 41  UsageUnreadable { cause: _ } => false })
  }
}

// THE ARGUMENTS STRING IS PARSED INTO THE SAME INPUT SHAPE THE MESSAGES DECODER DELIVERS, so the
// tool dispatcher reads command off one JsonValue regardless of wire.
test fn tool_call_arguments_are_parsed_from_their_json_string() -> Bool {
  match harness_decode_chat_completion(unit: DeepseekV4FlashOnVllm, body: fixture_completion()) {
    HarnessResponseParsed { blocks, stop_reason: _, usage: _ } =>
      match blocks.last() {
        Present { value: WireToolUseBlock { id: _, name: _, input } } => serialize_json(v: input).contains("\"command\": \"ls\"")
        _ => false
      }
    HarnessResponseUnreadable { cause: _ } => false
  }
}

// AN UNRECOGNISED finish_reason REFUSES rather than reading as completion.
test fn an_unknown_finish_reason_is_unreadable() -> Bool {
  match harness_decode_chat_completion(unit: DeepseekV4FlashOnVllm, body: "{\"choices\":[{\"finish_reason\":\"banana\",\"message\":{\"content\":\"x\"}}],\"usage\":{\"prompt_tokens\":1,\"completion_tokens\":1}}") {
    HarnessResponseUnreadable { cause: c } => c.contains("banana")
    HarnessResponseParsed { blocks: _, stop_reason: _, usage: _ } => false
  }
}

// THE REPLAY CARRIES REASONING AS reasoning_content AND THE CALL WITH ITS ARGUMENTS RE-SERIALIZED.
test fn the_chat_replay_carries_reasoning_content_and_tool_calls() -> Bool {
  let wire = serialize_json(v: harness_assistant_message_json(unit: DeepseekV4FlashOnVllm, shape: OpenAiChatCompletionsShape, blocks: [
    WireThinkingBlock { thinking: "think first" },
    WireTextBlock { text: "Listing now." },
    WireToolUseBlock { id: "chatcmpl-tool-1", name: "run_command", input: json_object([json_kv(key: "command", value: json_string(s: "ls"))]) },
  ]))
  wire.contains("\"reasoning_content\": \"think first\"")
    && wire.contains("\"content\": \"Listing now.\"")
    && wire.contains("\"tool_calls\"") && wire.contains("\"arguments\"") && wire.contains("run_command")
}

// THE MESSAGES-SHAPE REPLAY IS UNCHANGED BY THE NEW REALIZATION: a thinking block still rides as a
// thinking block, and no reasoning_content key appears.
test fn the_messages_replay_is_untouched() -> Bool {
  let wire = serialize_json(v: harness_assistant_message_json(unit: DeepseekV4FlashOnVllm, shape: AnthropicMessagesShape, blocks: [WireThinkingBlock { thinking: "think first" }]))
  wire.contains("\"type\": \"thinking\"") && !wire.contains("reasoning_content")
}

// TOOL RESULTS ARE role=tool MESSAGES KEYED BY THE CALL ID, FOLLOWED BY THE BUDGET NOTICE.
test fn chat_tool_results_are_tool_messages_then_the_notice() -> Bool {
  let msgs = harness_tool_result_messages_json(
    shape: OpenAiChatCompletionsShape,
    results: [HarnessToolResult { tool_use_id: "chatcmpl-tool-1", text: "a b c\n[exit 0]", is_error: false }],
    steps_remaining: 7,
  )
  list_length(items: msgs) == 2
    && (match msgs.first() { Present { value: m } => serialize_json(v: m).contains("\"role\": \"tool\"") && serialize_json(v: m).contains("chatcmpl-tool-1")  Absent => false })
    && (match msgs.last() { Present { value: m } => serialize_json(v: m).contains("\"role\": \"user\"") && serialize_json(v: m).contains("7")  Absent => false })
}

test fn the_messages_shape_still_sends_one_user_message_of_results() -> Bool {
  list_length(items: harness_tool_result_messages_json(
    shape: AnthropicMessagesShape,
    results: [HarnessToolResult { tool_use_id: "t1", text: "x", is_error: false }],
    steps_remaining: 7,
  )) == 1
}

test fn the_brief_is_a_plain_string_on_the_chat_shape() -> Bool {
  serialize_json(v: harness_user_text_message_json(shape: OpenAiChatCompletionsShape, text: "do it")).contains("\"content\": \"do it\"")
    && serialize_json(v: harness_user_text_message_json(shape: AnthropicMessagesShape, text: "do it")).contains("\"type\": \"text\"")
}

test fn each_shape_posts_to_its_own_path() -> Bool {
  harness_backend_path(shape: OpenAiChatCompletionsShape) == "/v1/chat/completions"
    && harness_backend_path(shape: AnthropicMessagesShape) == "/v1/messages"
}

// The roster is DERIVED from the pair heads through the fleet topology: one address per serving
// pair, every head carrying a LAN endpoint row, and the backend URL rendering on the engine port.
// RED if a head loses its endpoint row (Unresolved) or the derivation drops a pair.
//
// THE TWO TRANSCRIBED ADDRESSES THAT USED TO BE HERE ARE DELETED, and their rot is the reason this
// witness is worth reading. It asserted `count == 2` with the literals ".225" and ".236" against a
// roster whose authority -- `gunbc.spark.pair_serving_desired` `spark_pair_serving_groups` -- now
// carries ONE group. The assertion had been false for as long as that row has been a singleton and
// nothing said so, because this module had no standing consumer to say it in (review 63385; the
// enrollment is now `gunbc.commit_workflow` `commit_gate_roster`). DESIGN section 6: name the
// instrument, never transcribe its output. The count is read from the groups roster and each
// address is joined against the head's own endpoint row, so a fleet move moves the witness with it.
test fn the_replica_roster_derives_from_the_pair_heads() -> Bool {
  match harness_engine_replica_roster() {
    HarnessReplicasUnresolved { hosts: _ } => false
    HarnessReplicasResolved { addresses } =>
      count(addresses) == count(spark_pair_serving_groups)
        && count(addresses) > 0
        && all(map(spark_pair_serving_groups, g => spark_pair_serving_head(group: g)), h =>
             match host_lan_address(host: h) {
               Present { value: a } => any(addresses, x => x == (a as String))
               Absent => false
             })
        && all(addresses, a =>
             string_contains(
               s: harness_backend_url_for_address(shape: OpenAiChatCompletionsShape, address: a),
               pattern: join(["http://", a, ":30000/v1/chat/completions"], ""),
             ))
  }
}


// THE DECODER'S FABRICATION ARMS, EACH WITH ITS OWN DISCRIMINATING RED (DSV41-3).
//
// Every fixture below decoded SUCCESSFULLY before this repair, and that is what makes these reds
// discriminating rather than decorative: the old decoder answered `{}` for absent or unparseable
// tool arguments, `""` for an absent tool id, and `0` for an absent or non-numeric usage member.
// None of those is a marker -- each is a legal, dispatchable, plausible value -- so the harness ran
// argument-less commands, wrote tool results addressed to an id that matches no call, and compared
// a fabricated 0 against its context budget. Reverting any arm of the repair turns its fixture back
// into a green parse, which is exactly what these witnesses are enrolled to prevent.
//
// The positive control is a_chat_completion_decodes_to_thinking_text_and_tool_use above: the same
// decoder on a well-formed body still yields three blocks, a tool call with its arguments, and both
// token counts.

fn chat_with_tool_call(call: String) -> String {
  join(["{\"choices\":[{\"finish_reason\":\"tool_calls\",\"message\":{\"role\":\"assistant\",\"content\":\"x\",\"tool_calls\":[", call, "]}}],\"usage\":{\"prompt_tokens\":1,\"completion_tokens\":2}}"], "")
}

fn chat_decode_cause(body: String) -> String {
  match harness_decode_chat_completion(unit: DeepseekV4FlashOnVllm, body: body) {
    HarnessResponseUnreadable { cause: c } => c
    HarnessResponseParsed { blocks: _, stop_reason: _, usage: _ } => ""
  }
}

test fn unparseable_tool_call_arguments_refuse_rather_than_decoding_to_an_empty_object() -> Bool {
  let c = chat_decode_cause(body: chat_with_tool_call(call: "{\"id\":\"c1\",\"function\":{\"name\":\"run_command\",\"arguments\":\"{\\\"command\\\": \"}}"))
  c.contains("run_command") && c.contains("not a JSON document")
}

test fn a_tool_call_without_arguments_refuses_rather_than_dispatching_an_empty_call() -> Bool {
  let c = chat_decode_cause(body: chat_with_tool_call(call: "{\"id\":\"c1\",\"function\":{\"name\":\"run_command\"}}"))
  c.contains("run_command") && c.contains("no arguments member")
}

test fn a_tool_call_without_an_id_refuses_rather_than_addressing_its_result_to_the_empty_string() -> Bool {
  let c = chat_decode_cause(body: chat_with_tool_call(call: "{\"function\":{\"name\":\"run_command\",\"arguments\":\"{}\"}}"))
  c.contains("run_command") && c.contains("no string id member")
}

// USAGE STAYS UNAVAILABLE RATHER THAN BECOMING ZERO. The response itself is readable -- the model
// produced text and stopped -- so the turn is not refused at the codec; what refuses is the arm in
// gunbc.harness.harness_turn that would otherwise compare a fabricated 0 against the context budget.
fn chat_usage_of(body: String) -> HarnessUsageRead {
  match harness_decode_chat_completion(unit: DeepseekV4FlashOnVllm, body: body) {
    HarnessResponseParsed { blocks: _, stop_reason: _, usage } => usage
    HarnessResponseUnreadable { cause: c } => UsageUnreadable { cause: c }
  }
}

fn usage_is_unavailable_naming(usage: HarnessUsageRead, fragment: String) -> Bool {
  match usage {
    UsageUnreadable { cause: c } => c.contains(fragment)
    UsageRead { input_tokens: _, output_tokens: _ } => false
  }
}

test fn a_completion_without_a_usage_object_reads_as_unavailable_not_as_zero() -> Bool {
  usage_is_unavailable_naming(
    usage: chat_usage_of(body: "{\"choices\":[{\"finish_reason\":\"stop\",\"message\":{\"content\":\"done\"}}]}"),
    fragment: "no usage object",
  )
}

test fn a_usage_member_that_is_not_a_number_reads_as_unavailable_not_as_zero() -> Bool {
  usage_is_unavailable_naming(
    usage: chat_usage_of(body: "{\"choices\":[{\"finish_reason\":\"stop\",\"message\":{\"content\":\"done\"}}],\"usage\":{\"prompt_tokens\":\"many\",\"completion_tokens\":2}}"),
    fragment: "prompt_tokens",
  )
}

test fn a_usage_object_missing_one_count_reads_as_unavailable_rather_than_half_a_measurement() -> Bool {
  usage_is_unavailable_naming(
    usage: chat_usage_of(body: "{\"choices\":[{\"finish_reason\":\"stop\",\"message\":{\"content\":\"done\"}}],\"usage\":{\"prompt_tokens\":7}}"),
    fragment: "completion_tokens",
  )
}

// A NEGATIVE COUNT IS NOT A COUNT. TokenCount is Nat-valued, so the Int-to-Nat crossing has to
// happen somewhere in the decoder; this red holds it on the refusing side of the sign check, because
// the tempting spelling -- take the magnitude and move on -- turns "-3 tokens" into "3 tokens",
// which is this module's own failure class one field over.
test fn a_negative_usage_count_reads_as_unavailable_rather_than_as_its_magnitude() -> Bool {
  usage_is_unavailable_naming(
    usage: chat_usage_of(body: "{\"choices\":[{\"finish_reason\":\"stop\",\"message\":{\"content\":\"done\"}}],\"usage\":{\"prompt_tokens\":-3,\"completion_tokens\":2}}"),
    fragment: "negative",
  )
}

// THE MESSAGES SHAPE CARRIES THE SAME REPAIR, because it carried the same fabrication: a tool_use
// block with no input member decoded to an empty object there too.
fn messages_decode_cause(body: String) -> String {
  match harness_decode_response(body: body) {
    HarnessResponseUnreadable { cause: c } => c
    HarnessResponseParsed { blocks: _, stop_reason: _, usage: _ } => ""
  }
}

test fn a_messages_tool_use_block_without_input_refuses() -> Bool {
  let c = messages_decode_cause(body: "{\"stop_reason\":\"tool_use\",\"content\":[{\"type\":\"tool_use\",\"id\":\"t1\",\"name\":\"run_command\"}],\"usage\":{\"input_tokens\":1,\"output_tokens\":2}}")
  c.contains("run_command") && c.contains("no input member")
}

test fn a_messages_tool_use_block_without_an_id_refuses() -> Bool {
  let c = messages_decode_cause(body: "{\"stop_reason\":\"tool_use\",\"content\":[{\"type\":\"tool_use\",\"name\":\"run_command\",\"input\":{}}],\"usage\":{\"input_tokens\":1,\"output_tokens\":2}}")
  c.contains("no string id member")
}

// THE POSITIVE CONTROL FOR THE MESSAGES SHAPE: a well-formed body still decodes, carries its
// tool_use input, and reads both counts. Without this the reds above would be satisfied by a decoder
// that refused everything.
test fn a_well_formed_messages_response_still_decodes_with_its_input_and_counts() -> Bool {
  match harness_decode_response(body: "{\"stop_reason\":\"tool_use\",\"content\":[{\"type\":\"tool_use\",\"id\":\"t1\",\"name\":\"run_command\",\"input\":{\"command\":\"ls\"}}],\"usage\":{\"input_tokens\":11,\"output_tokens\":22}}") {
    HarnessResponseUnreadable { cause: _ } => false
    HarnessResponseParsed { blocks, stop_reason: _, usage } =>
      list_length(items: blocks) == 1
        && (match blocks.first() {
              Present { value: WireToolUseBlock { id, name, input } } =>
                id == "t1" && name == "run_command" && serialize_json(v: input).contains("ls")
              _ => false
            })
        && (match usage { UsageRead { input_tokens: i, output_tokens: o } => token_count_value(t: i) == 11 && token_count_value(t: o) == 22  UsageUnreadable { cause: _ } => false })
  }
}

// AN UNKNOWN BLOCK KIND IS STILL SKIPPED RATHER THAN REFUSED, which is the boundary this repair
// deliberately did not cross: a vendor adding a block type we do not model is not a malformed
// response. Without this control the repair would read as "refuse anything unfamiliar".
test fn an_unmodelled_block_kind_is_skipped_not_refused() -> Bool {
  match harness_decode_response(body: "{\"stop_reason\":\"end_turn\",\"content\":[{\"type\":\"server_tool_use\",\"id\":\"s1\"},{\"type\":\"text\",\"text\":\"hi\"}],\"usage\":{\"input_tokens\":1,\"output_tokens\":2}}") {
    HarnessResponseUnreadable { cause: _ } => false
    HarnessResponseParsed { blocks, stop_reason: _, usage: _ } => list_length(items: blocks) == 1
  }
}
