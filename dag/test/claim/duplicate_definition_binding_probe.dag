module test.claim.duplicate_definition_binding_probe

import gunbc.compile_diagnostic_census {
  CompileDiagnosticCensus,
  CensusObserved,
  CensusNotRunnable,
  census_blocking_rows,
  census_total_count
}
import std.types { String, Bool, Int }

// WHAT THIS PROBE MEASURES, and why its RED is the point rather than a defect in the probe.
// A module that defines one name TWICE is accepted by the source -> .dag acceptance path with
// ZERO diagnostics, and the SECOND definition silently wins. Measured on a controlled fixture
// in both directions: with `fn which_one() -> Bool { false }` first and `{ true }` second the
// program answers true; with the order swapped it answers false. Nothing is reported at either
// ordering. That is not a rung that slipped -- it is BELOW FLOOR (DESIGN section 4b): a name
// binding to two definitions with no refusal is silent wrongness, which is outside the ladder,
// not a weak rung on it.
//
// THE ASSERTION HERE IS THE CORRECT BEHAVIOUR, NOT THE OBSERVED ONE. Written the other way --
// "assert the second definition binds" -- the row would go GREEN today and become a DEFENDER OF
// THE DEFECT, cited forever after as coverage of a wall that does not exist. So the row asserts
// that the compiler REFUSES a module carrying two definitions of one name, is enrolled as an
// expected red with the wrong answer recorded above as the observed state, and flips to green of
// its own accord when the wall lands. Per DESIGN section 4b meta-obligation (4) it does not
// retire at that point: it converts to a permanent regression control.
//
// THE FIX IS A WALL, NOT A RATCHET. Membership is decidable at ingestion, where the module's
// own declarations are already being folded: two declarations sharing one name in one module is
// a property of one module's source, needing no corpus walk, no resolution and no type
// information. DESIGN section 5's decidability test is met, so a lens counting occurrences would
// be validation standing where construction was available.
//
// THE BOUNDARY THIS ROW MEASURES, stated so no receipt reads coverage it does not have
// (DESIGN section 4b: a class's rung is the MINIMUM across its in-scope paths): source -> .dag
// acceptance, through our own binary, single module, function declarations. NOT measured here:
// the Rust emission path, `type`/`data` declarations, cross-module collisions, and whether a
// `test fn` collides with a plain `fn` of the same name. Each is its own row when someone
// measures it; none is claimed by this one.

fn census_of(source: String) -> CompileDiagnosticCensus {
  compile_dag_diagnostic_census(source)
}

// -1 on CensusNotRunnable, so could-not-measure REDS both rows below and greens neither
// (DESIGN section 5: bottom-as-answer must never be readable as bottom-as-ignorance).
fn blocking_count(source: String) -> Int {
  match census_of(source: source) {
    CensusObserved { rows: rows } => census_total_count(rows: census_blocking_rows(rows: rows))
    CensusNotRunnable { cause: _ } => 0 - 1
  }
}

// The discriminating RED: two definitions of one name, differing in body so that which one
// binds is observable rather than benign.
data duplicate_definition_source: String = "module probe_duplicate_definition\nimport std.types { Bool }\nfn which_one() -> Bool { false }\nfn which_one() -> Bool { true }\n"

test fn duplicate_definition_in_one_module_is_refused() -> Bool {
  blocking_count(source: duplicate_definition_source) >= 1
}

// The positive control: the same module with ONE definition must stay at zero blocking
// diagnostics, so the row above cannot pass by the probe source being broken in some other way.
data single_definition_source: String = "module probe_single_definition\nimport std.types { Bool }\nfn which_one() -> Bool { true }\n"

test fn single_definition_module_is_clean() -> Bool {
  blocking_count(source: single_definition_source) == 0
}
