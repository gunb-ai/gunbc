module test.claim.rung_climb_witness

import std.types { Bool, String }
import gunbc.compile_census_probe { blocking_class_count_for, total_blocking_count_for }

// A CLASS BELOW ITS CEILING CANNOT BE HANDED "CANNOT CLIMB FURTHER", AND THE COMPILER, NOT A CENSUS, IS
// WHAT SAYS SO. gunbc.rung_climb ClimbBlocker has only the two can-climb arms, so a BelowCeiling
// (gunbc.recurring_failure_mode RungStanding) or a GuaranteeStall carrying CannotClimbFurther has no
// constructor to be written with (DESIGN section 4b rung 4, section 5 construction over validation).
// The RED is fixture source handed to the compiler: it imports the retired arm and must draw exactly one
// MissingExport. The GREEN builds the same standing with a surviving arm and must draw no more blocking
// diagnostics than a module importing the same closure and doing nothing, so the RED reds for the arm
// and not for the closure or the shape of the fixture. Both the retired census refusal and its fixture
// were dissolved by this climb; this witness is the RED that stays enrolled (section 4b, obligation 4).

data cannot_climb_below_ceiling_source: String = "module probe_cannot_climb_below_ceiling\nimport gunbc.guarantee_rung { Mitigatable, StructurallyGuaranteed }\nimport gunbc.rung_climb { CannotClimbFurther }\nimport gunbc.recurring_failure_mode { RungStanding, BelowCeiling, FoundOnRung }\ndata s: RungStanding = BelowCeiling { current: FoundOnRung { rung: Mitigatable }, ceiling: StructurallyGuaranteed, blocker: CannotClimbFurther { why: \"x\" }, trigger_capability: \"capability\" }\n"

data can_climb_below_ceiling_source: String = "module probe_can_climb_below_ceiling\nimport gunbc.guarantee_rung { Mitigatable, StructurallyGuaranteed }\nimport gunbc.rung_climb { AwaitsOneGrounding, Undeclared }\nimport gunbc.recurring_failure_mode { RungStanding, BelowCeiling, FoundOnRung }\ndata s: RungStanding = BelowCeiling { current: FoundOnRung { rung: Mitigatable }, ceiling: StructurallyGuaranteed, blocker: AwaitsOneGrounding { grounding: Undeclared }, trigger_capability: \"capability\" }\n"

data duplicate_prose_grounding_source: String = "module probe_duplicate_prose_grounding\nimport gunbc.guarantee_rung { Mitigatable, StructurallyGuaranteed }\nimport gunbc.rung_climb { AwaitsOneGrounding }\nimport gunbc.recurring_failure_mode { RungStanding, BelowCeiling, FoundOnRung }\ndata s: RungStanding = BelowCeiling { current: FoundOnRung { rung: Mitigatable }, ceiling: StructurallyGuaranteed, blocker: AwaitsOneGrounding { grounding: \"x\" }, trigger_capability: \"capability\" }\n"

data closure_baseline_source: String = "module probe_climb_closure_baseline\nimport gunbc.guarantee_rung { Mitigatable }\nimport gunbc.rung_climb { AwaitsOneGrounding }\nimport gunbc.recurring_failure_mode { RungStanding, BelowCeiling, FoundOnRung }\n"

test fn a_cannot_climb_further_standing_below_its_ceiling_is_refused_at_compile() -> Bool {
  blocking_class_count_for(source: cannot_climb_below_ceiling_source, wanted_class: "MissingExport") == 1
}

test fn a_can_climb_standing_below_its_ceiling_adds_no_refusal() -> Bool {
  let baseline = total_blocking_count_for(source: closure_baseline_source)
  baseline >= 0 && total_blocking_count_for(source: can_climb_below_ceiling_source) == baseline
}

test fn a_prose_grounding_beside_the_trigger_capability_is_unwritable() -> Bool {
  total_blocking_count_for(source: duplicate_prose_grounding_source) > total_blocking_count_for(source: closure_baseline_source)
}
