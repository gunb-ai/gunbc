module test.claim.fabric_budget_encumbrance_witness

import std.types { NonEmptyStr, String, Bool, Int, Timestamp, List }
import std.measure { MoneyAmountMicro, money_amount_micro, money_amount_micro_count, measure_le }
import std.currency { CurrencyCode, Usd, Eur }
import extdeps.accounting.budget { Appropriation }
import extdeps.accounting.encumbrance {
  EncumbranceLedger, Encumbrance, EncumbranceState, Held, Expended, Released,
  EncumbranceOutcome, LedgerAdvanced, EncumbranceRefused,
  ExceedsAppropriation, UnknownEncumbrance, StaleGeneration,
  ExpenditureExceedsEncumbrance, AlreadyTerminal,
  committed_total,
}
import product.fabric.budget {
  MoneyAccount, MoneyReservationRequest, MoneySettlementRequest,
  MoneyOutcome, AccountAdvanced, MoneyRefused, MoneyRefusal,
  CurrencyMismatch, LedgerRefused,
  reserve_money, settle_money, release_money, account_committed,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// Budget is modeled as a lease over money: something is held exclusively,
// the holder can be superseded while still believing it holds, and a late
// settlement from a superseded holder must not be honoured. These witnesses
// exercise that claim at the two boundaries where it is decidable - the
// ceiling and the generation fence - plus the currency wall the generic
// kernel deliberately cannot carry.

data usd_account: MoneyAccount = MoneyAccount {
  account: "fleet-ci",
  currency: Usd,
  ledger: EncumbranceLedger {
    appropriation: Appropriation { ceiling: money_amount_micro(count: 1000000) },
    entries: [],
  },
}

fn advanced_account(o: MoneyOutcome) -> List<MoneyAccount> {
  match o {
    AccountAdvanced { account: a } => [a]
    MoneyRefused { refusal: _ } => []
  }
}

fn is_refused(o: MoneyOutcome) -> Bool {
  match o {
    AccountAdvanced { account: _ } => false
    MoneyRefused { refusal: _ } => true
  }
}

fn reserve_on(a: MoneyAccount, reference: NonEmptyStr, generation: Int, micros: Nat) -> MoneyOutcome {
  reserve_money(
    a: a,
    request: MoneyReservationRequest {
      reference: reference,
      generation: generation,
      maximum_liability: money_amount_micro(count: micros),
      currency: Usd,
    },
  )
}

fn settle_on(a: MoneyAccount, reference: NonEmptyStr, generation: Int, micros: Nat) -> MoneyOutcome {
  settle_money(
    a: a,
    request: MoneySettlementRequest {
      reference: reference,
      generation: generation,
      actual_spend: money_amount_micro(count: micros),
      currency: Usd,
      settled_at: "2026-08-18T02:00:00Z",
    },
  )
}

// Reserving the maximum liability encumbers the full amount up front. This is
// the property that makes the ceiling meaningful: an outstanding commitment
// counts against the budget before any money moves, so a second reservation
// cannot be admitted against headroom the first one has already spoken for.

test fn a_held_reservation_encumbers_its_full_liability() -> Bool {
  match advanced_account(o: reserve_on(a: usd_account, reference: "grant-1", generation: 1, micros: 400000)) {
    Empty {} => false
    Cons { head: a, tail: _ } =>
      money_amount_micro_count(m: account_committed(a: a)) == 400000
  }
}

// The ceiling refuses rather than admitting a partial hold. A caller that
// asked to hold 700000 against 600000 of headroom and received a smaller hold
// would proceed believing it was covered for the larger amount.

test fn a_reservation_over_the_ceiling_refuses_rather_than_partially_holding() -> Bool {
  match advanced_account(o: reserve_on(a: usd_account, reference: "grant-1", generation: 1, micros: 400000)) {
    Empty {} => false
    Cons { head: a, tail: _ } => {
      let second = reserve_on(a: a, reference: "grant-2", generation: 1, micros: 700000)
      is_refused(o: second)
        && money_amount_micro_count(m: account_committed(a: a)) == 400000
    }
  }
}

// Settling below the held liability is the ordinary case, and the released
// residue returns to the appropriation. Without that, reserving a
// conservative maximum would permanently consume headroom it never used, and
// callers would be pushed toward under-reserving instead.

test fn settling_under_the_hold_returns_the_residue() -> Bool {
  match advanced_account(o: reserve_on(a: usd_account, reference: "grant-1", generation: 1, micros: 400000)) {
    Empty {} => false
    Cons { head: held, tail: _ } =>
      match advanced_account(o: settle_on(a: held, reference: "grant-1", generation: 1, micros: 250000)) {
        Empty {} => false
        Cons { head: settled, tail: _ } =>
          money_amount_micro_count(m: account_committed(a: held)) == 400000
            && money_amount_micro_count(m: account_committed(a: settled)) == 250000
      }
  }
}

// Spending above what was encumbered refuses instead of expanding the hold.
// Expanding it would cross the ceiling through the settle path rather than the
// reserve path, which is the one place the conservation argument assumed it
// could not be crossed.

test fn spending_above_the_hold_refuses_instead_of_expanding_it() -> Bool {
  match advanced_account(o: reserve_on(a: usd_account, reference: "grant-1", generation: 1, micros: 400000)) {
    Empty {} => false
    Cons { head: held, tail: _ } =>
      is_refused(o: settle_on(a: held, reference: "grant-1", generation: 1, micros: 400001))
  }
}

// The generation fence is the lease half. A superseded holder settling late
// must not be honoured, and the check is decidable at settlement rather than
// racing, because the reservation carries the generation it was made under.

test fn a_superseded_holder_cannot_settle() -> Bool {
  match advanced_account(o: reserve_on(a: usd_account, reference: "grant-1", generation: 7, micros: 400000)) {
    Empty {} => false
    Cons { head: held, tail: _ } =>
      is_refused(o: settle_on(a: held, reference: "grant-1", generation: 6, micros: 100000))
        && !is_refused(o: settle_on(a: held, reference: "grant-1", generation: 7, micros: 100000))
  }
}

// A terminal entry cannot be settled twice. Double settlement would charge one
// commitment against the appropriation two times, and the second charge would
// be invisible in a ledger that only stored a running total.

test fn a_settled_reservation_cannot_settle_again() -> Bool {
  match advanced_account(o: reserve_on(a: usd_account, reference: "grant-1", generation: 1, micros: 400000)) {
    Empty {} => false
    Cons { head: held, tail: _ } =>
      match advanced_account(o: settle_on(a: held, reference: "grant-1", generation: 1, micros: 250000)) {
        Empty {} => false
        Cons { head: settled, tail: _ } =>
          is_refused(o: settle_on(a: settled, reference: "grant-1", generation: 1, micros: 100000))
      }
  }
}

// Releasing frees the whole hold, so the headroom it occupied becomes
// available to a later reservation that would otherwise have been refused.

test fn releasing_a_hold_frees_its_headroom() -> Bool {
  match advanced_account(o: reserve_on(a: usd_account, reference: "grant-1", generation: 1, micros: 900000)) {
    Empty {} => false
    Cons { head: held, tail: _ } => {
      let blocked = reserve_on(a: held, reference: "grant-2", generation: 1, micros: 500000)
      match advanced_account(
        o: release_money(
          a: held,
          reference: "grant-1",
          generation: 1,
          reason: "attempt abandoned before execution",
          released_at: "2026-08-18T02:00:00Z",
        )
      ) {
        Empty {} => false
        Cons { head: freed, tail: _ } =>
          is_refused(o: blocked)
            && money_amount_micro_count(m: account_committed(a: freed)) == 0
            && !is_refused(o: reserve_on(a: freed, reference: "grant-2", generation: 1, micros: 500000))
      }
    }
  }
}

// The currency wall. MoneyAmountMicro carries no currency code, so a generic
// ledger would add euros to dollars silently and check the ceiling against a
// quantity denominating nothing. The account binds the code once and refuses
// anything presented in another - and it never converts, because a conversion
// needs a rate, and a rate invented at an admission boundary fabricates the
// exact fact the refusal exists to demand.

test fn a_foreign_currency_reservation_refuses_and_never_converts() -> Bool {
  let foreign = reserve_money(
    a: usd_account,
    request: MoneyReservationRequest {
      reference: "grant-eu",
      generation: 1,
      maximum_liability: money_amount_micro(count: 100000),
      currency: Eur,
    },
  )
  is_refused(o: foreign)
    && money_amount_micro_count(m: account_committed(a: usd_account)) == 0
}

// The refusal must be the CURRENCY one specifically. A euro amount inside the
// ceiling would be admitted by the kernel on the numbers alone, so if the wall
// were merely ordering the mismatch would surface as some other refusal, or as
// none - which is how a silent cross-currency sum gets in.

test fn the_currency_refusal_is_distinct_from_a_ceiling_refusal() -> Bool {
  let foreign = reserve_money(
    a: usd_account,
    request: MoneyReservationRequest {
      reference: "grant-eu",
      generation: 1,
      maximum_liability: money_amount_micro(count: 100000),
      currency: Eur,
    },
  )
  match foreign {
    AccountAdvanced { account: _ } => false
    MoneyRefused { refusal: r } =>
      match r {
        CurrencyMismatch { account: _, account_currency: ac, presented_currency: pc } =>
          ac == Usd && pc == Eur
        LedgerRefused { account: _, refusal: _ } => false
      }
  }
}
