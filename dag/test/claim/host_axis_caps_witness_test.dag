module test.claim.host_axis_caps


data path20: std.types.NonEmptyStr = gunbc.host_converge.gunbc_runner_per_slot_dropin_path as std.types.NonEmptyStr
data path30: std.types.NonEmptyStr = gunbc.host_converge.gunbc_runner_per_slot_swap_dropin_path as std.types.NonEmptyStr
data foreign_path: std.types.NonEmptyStr = "/etc/systemd/system/actions-runner@.service.d/99-foreign.conf"
data mem_max: std.types.NonEmptyStr = "MemoryMax"
data swap_max: std.types.NonEmptyStr = "MemorySwapMax"
data bytes16g: std.types.NonEmptyStr = "17179869184"
data bytes32g: std.types.NonEmptyStr = "34359738368"
data bytes8g: std.types.NonEmptyStr = "8589934592"

fn srv_caps_desired() -> List<gunbc.host_axis_caps.CapMember> {
  [
    gunbc.host_axis_caps.desired_cap_member(dropin_path: path20, property: mem_max, bytes_value: bytes16g),
    gunbc.host_axis_caps.desired_cap_member(dropin_path: path30, property: swap_max, bytes_value: bytes32g),
  ]
}

test fn caps_idempotence_zero_effects() -> Bool {
  let d = srv_caps_desired()
  gunbc.host_axis_caps.caps_upsert_count(desired: d, observed: d) == 0
    && gunbc.host_axis_caps.caps_teardown_count(desired: d, observed: d) == 0
    && gunbc.host_axis_caps.caps_refusal_count(desired: d, observed: d) == 0
    && match gunbc.host_axis_caps.caps_effects(desired: d, observed: d) {
         gunbc.membership_reconcile.EffectsReady { effects: e } => std.types.list_length(items: e) == 0
         gunbc.membership_reconcile.ApplyRefused { refusals: _ } => false
       }
}

test fn caps_perturb_names_exactly_the_drifted_row() -> Bool {
  let d = srv_caps_desired()
  let observed = [
    gunbc.host_axis_caps.CapMember { dropin_path: path20, content: gunbc.host_axis_caps.cap_dropin_content(property: mem_max, bytes_value: bytes8g) },
    gunbc.host_axis_caps.desired_cap_member(dropin_path: path30, property: swap_max, bytes_value: bytes32g),
  ]
  gunbc.host_axis_caps.caps_upsert_count(desired: d, observed: observed) == 1
    && gunbc.host_axis_caps.caps_teardown_count(desired: d, observed: observed) == 0
    && gunbc.host_axis_caps.caps_refusal_count(desired: d, observed: observed) == 0
    && gunbc.host_axis_caps.caps_upsert_count(desired: d, observed: d) == 0
}

test fn caps_foreign_occupant_refuses_never_deletes() -> Bool {
  let d = srv_caps_desired()
  let foreign = gunbc.host_axis_caps.CapMember { dropin_path: foreign_path, content: "[Service]\nMemoryMax=1\n" }
  let observed = [
    gunbc.host_axis_caps.desired_cap_member(dropin_path: path20, property: mem_max, bytes_value: bytes16g),
    gunbc.host_axis_caps.desired_cap_member(dropin_path: path30, property: swap_max, bytes_value: bytes32g),
    foreign,
  ]
  gunbc.host_axis_caps.caps_refusal_count(desired: d, observed: observed) == 1
    && gunbc.host_axis_caps.caps_teardown_count(desired: d, observed: observed) == 0
    && match gunbc.host_axis_caps.caps_effects(desired: d, observed: observed) {
         gunbc.membership_reconcile.ApplyRefused { refusals: r } => std.types.list_length(items: r) == 1
         gunbc.membership_reconcile.EffectsReady { effects: _ } => false
       }
    && gunbc.host_axis_caps.caps_teardown_count(
         desired: [gunbc.host_axis_caps.desired_cap_member(dropin_path: path20, property: mem_max, bytes_value: bytes16g)],
         observed: d,
       ) == 1
}

test fn caps_content_is_derived_not_handspelled() -> Bool {
  gunbc.host_axis_caps.cap_dropin_content(property: mem_max, bytes_value: bytes16g) == "[Service]\nMemoryMax=17179869184\n"
    && gunbc.host_axis_caps.cap_dropin_content(property: swap_max, bytes_value: bytes32g) == "[Service]\nMemorySwapMax=34359738368\n"
    && gunbc.host_axis_caps.cap_dropin_content(property: mem_max, bytes_value: bytes8g) != gunbc.host_axis_caps.cap_dropin_content(property: mem_max, bytes_value: bytes16g)
}

data shadow_unit: std.types.NonEmptyStr = "actions-runner@srv1-01.service"

test fn control_shadow_residue_teardowns_owned_unit() -> Bool {
  let observed = [gunbc.host_axis_caps.control_shadow_unit(unit: shadow_unit)]
  gunbc.host_axis_caps.control_shadow_teardown_count(desired: [], observed: observed) == 1
    && gunbc.host_axis_caps.control_shadow_refusal_count(desired: [], observed: observed) == 0
    && match gunbc.host_axis_caps.control_shadow_effects(desired: [], observed: observed) {
         gunbc.membership_reconcile.EffectsReady { effects: e } => std.types.list_length(items: e) == 1
         gunbc.membership_reconcile.ApplyRefused { refusals: _ } => false
       }
    && gunbc.host_axis_caps.control_shadow_revert_script_matches_extdeps_argv(u: gunbc.host_axis_caps.control_shadow_unit(unit: shadow_unit))
}

test fn control_shadow_idempotence_zero_effects() -> Bool {
  gunbc.host_axis_caps.control_shadow_teardown_count(desired: [], observed: []) == 0
    && gunbc.host_axis_caps.control_shadow_refusal_count(desired: [], observed: []) == 0
}

test fn witness_derived_memory_caps_match_allocation_authority() -> Bool {
  let max = gunbc.host_axis_caps.derived_runner_memory_max_cap_member()
  let high = gunbc.host_axis_caps.derived_runner_memory_high_cap_member()
  let desired = gunbc.runner_slot_allocation.gunbc_runner_slot_desired()
  string_contains(s: max.content, pattern: to_string(std.measure.byte_size_count(b: desired.memory_max)))
    && string_contains(s: max.dropin_path as String, pattern: "20-fleet-width")
    && string_contains(s: high.content, pattern: to_string(std.measure.byte_size_count(b: desired.memory_high)))
    && string_contains(s: high.dropin_path as String, pattern: "40-fleet-high")
}

test fn witness_control_shadow_revert_script_matches_extdeps_argv() -> Bool {
  gunbc.host_axis_caps.control_shadow_revert_script_matches_extdeps_argv(u: gunbc.host_axis_caps.control_shadow_unit(unit: shadow_unit))
}

test fn witness_shadow_revert_not_ready_without_derived_dropins() -> Bool {
  !gunbc.host_axis_caps.runner_memory_cap_author_ready_for_shadow_revert(observed: [])
    && gunbc.host_axis_caps.runner_memory_cap_author_ready_for_shadow_revert(observed: gunbc.host_axis_caps.derived_runner_memory_cap_members())
}

// witness_runner_memory_cap_author_script_derived WAS HERE. Its subject
// (runner_memory_cap_author_script, the converge-side authoring script) is deleted along with the
// converge apply arm, so the witness goes with it. What it actually checked — that the authored
// bytes are derived from gunbc.runner_slot_allocation and carry no revert — is still checked on
// the deploy-side script, which is the one that executes, by
// witness_cap_author_before_shadow_revert_enforced_in_axis_caps and the two wrong-order REDs
// below.
test fn witness_deploy_memory_cap_author_script_derives_allocation_bytes() -> Bool {
  let desired = gunbc.runner_slot_allocation.gunbc_runner_slot_desired()
  string_contains(s: gunbc.host_axis_caps.deploy_runner_memory_cap_author_script(), pattern: to_string(std.measure.byte_size_count(b: desired.memory_max)))
    && string_contains(s: gunbc.host_axis_caps.deploy_runner_memory_cap_author_script(), pattern: to_string(std.measure.byte_size_count(b: desired.memory_high)))
    && !string_contains(
      s: gunbc.host_axis_caps.deploy_runner_memory_cap_author_script(),
      pattern: gunbc.host_axis_caps.deploy_memory_cap_shadow_revert_script(units: [shadow_unit]),
    )
}

test fn witness_cap_author_before_shadow_revert_enforced_in_axis_caps() -> Bool {
  let units = [shadow_unit]
  gunbc.host_axis_caps.host_axis_caps_author_before_revert_enforced
    && gunbc.host_axis_caps.deploy_memory_cap_script_author_precedes_shadow_revert(
      script: gunbc.host_axis_caps.deploy_memory_cap_apply_script_ordered(units: units),
      units: units,
    )
}

test fn witness_reversed_deploy_script_fails_author_before_shadow_revert_gate() -> Bool {
  let units = [shadow_unit]
  let author = gunbc.host_axis_caps.deploy_runner_memory_cap_author_script()
  let reverts = gunbc.host_axis_caps.deploy_memory_cap_shadow_revert_script(units: units)
  !gunbc.host_axis_caps.deploy_memory_cap_script_author_precedes_shadow_revert(script: concat(reverts, author), units: units)
}

test fn witness_padded_wrong_order_script_fails_author_before_shadow_revert_gate() -> Bool {
  let units = [shadow_unit]
  let author = gunbc.host_axis_caps.deploy_runner_memory_cap_author_script()
  let reverts = gunbc.host_axis_caps.deploy_memory_cap_shadow_revert_script(units: units)
  !gunbc.host_axis_caps.deploy_memory_cap_script_author_precedes_shadow_revert(
    script: concat(concat(reverts, author), "padding"),
    units: units,
  )
}


// The quoting these three witnesses pin is the SERIALIZER'S, not this module's: the cap
// content is a word handed to a bash grammar tree, so an apostrophe inside it is encoded by
// extdeps.posix.shell_command_language posix_single_quote. Under the former hand-joined
// spelling ("printf '%s' '" ++ content ++ "' > path") the same content closed the quoting
// early and the rest of the drop-in became shell words — so each RED below is a real
// discriminator against that spelling returning, not a restatement of the emitter.
data apostrophe_cap_content: String = "[Service]\nEnvironment=CAP='quoted'\n"

data apostrophe_cap_member: gunbc.host_axis_caps.CapMember = gunbc.host_axis_caps.CapMember {
  dropin_path: path20,
  content: apostrophe_cap_content,
}

test fn witness_cap_upsert_script_quotes_content_through_posix_authority() -> Bool {
  string_contains(
    s: gunbc.host_axis_caps.cap_upsert_script(m: apostrophe_cap_member),
    pattern: extdeps.posix.shell_command_language.posix_single_quote(spelling: apostrophe_cap_content),
  )
}

test fn witness_cap_upsert_script_does_not_emit_raw_apostrophe_content() -> Bool {
  !string_contains(
    s: gunbc.host_axis_caps.cap_upsert_script(m: apostrophe_cap_member),
    pattern: concat("'", concat(apostrophe_cap_content, "'")),
  )
}

test fn witness_cap_upsert_script_carries_no_hand_spelled_printf_quoting() -> Bool {
  !string_contains(s: gunbc.host_axis_caps.cap_upsert_script(m: apostrophe_cap_member), pattern: "printf '%s' '")
    && !string_contains(s: gunbc.host_axis_caps.deploy_runner_memory_cap_author_script(), pattern: "printf '%s' '")
}
