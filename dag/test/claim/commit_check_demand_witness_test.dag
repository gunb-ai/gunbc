fn discovery_entry_matches(
  discovery: gunbc.commit_workflow.EntryDeclarationDiscovery,
  entry: String,
) -> Bool {
  match discovery {
    gunbc.commit_workflow.DiscoveryComplete { entry: candidate, module_path: _, declarations: _ } =>
      candidate == entry
    gunbc.commit_workflow.DiscoveryIncomplete { entry: candidate, cause: _ } => candidate == entry
  }
}

fn demand_row_matches_complete_discovery(
  row: gunbc.commit_workflow.EnrollmentWitnessDemand,
  discoveries: List<gunbc.commit_workflow.EntryDeclarationDiscovery>,
) -> Bool {
  match row.check {
    gunbc.commit_workflow.CommitWitnessClaim { entry, check_fns: _, kind: _, span: _ } =>
      let matching = filter(
        discoveries,
        discovery => discovery_entry_matches(discovery: discovery, entry: entry)
      )
      if matching.count() != 1 {
        false
      } else {
        match matching.first() {
          v2.std.optional.Absent => false
          v2.std.optional.Present { value: discovery } =>
            match discovery {
              gunbc.commit_workflow.DiscoveryIncomplete { entry: _, cause: _ } => false
              gunbc.commit_workflow.DiscoveryComplete { entry: _, module_path: _, declarations } =>
                gunbc.commit_workflow.declaration_ref_lists_eq(
                  left: row.declarations,
                  right: declarations
                )
            }
        }
      }
    gunbc.commit_workflow.CommitSpecGate { gate: _ } => false
    gunbc.commit_workflow.CommitCargoFmtCheck => false
  }
}

fn qualified_rows_match_complete_discoveries(
  rows: List<gunbc.commit_workflow.EnrollmentWitnessDemand>,
  discoveries: List<gunbc.commit_workflow.EntryDeclarationDiscovery>,
) -> Bool {
  rows.count() == discoveries.count()
    && fold(rows, init: true, f: fn(acc, row) {
      acc && demand_row_matches_complete_discovery(
        row: row,
        discoveries: discoveries
      )
    })
}

// `first()` answers an Optional and field access through it stays optional, so reading the name back
// with `as String` compared the WRAPPER against the expected name: on an empty list the assertion
// failed by comparing the literal text `Absent`, and on a differently-shaped one it could have
// compared `Present { value: ... }`. The compiler now refuses that cast. The absent arms return a
// name no declaration can carry, so a shape mismatch still fails -- loudly, and for its own reason.
fn nth_declaration_name(rows: List<gunbc.commit_workflow.EnrollmentWitnessDemand>, row: Int, declaration: Int) -> String {
  match rows.skip(n: row).first() {
    v2.std.optional.Absent => "(no such demand row)"
    v2.std.optional.Present { value: demand } =>
      match demand.declarations.skip(n: declaration).first() {
        v2.std.optional.Absent => "(no such declaration)"
        v2.std.optional.Present { value: decl } => decl.decl_name as String
      }
  }
}

test fn commit_check_demand_live_roster_identities_are_unique_and_kind_partitioned() -> Bool {
  match gunbc.commit_workflow.first_duplicate_commit_check(roster: gunbc.commit_workflow.commit_gate_roster) {
    gunbc.commit_workflow.NoDuplicateCommitCheck => {
      let gates = filter(gunbc.commit_workflow.commit_gate_roster, row => check_is_gate(check: row.check))
      let witnesses = filter(gunbc.commit_workflow.commit_gate_roster, row => check_is_witness(check: row.check))
      let fmt = filter(gunbc.commit_workflow.commit_gate_roster, row => check_is_fmt(check: row.check))
      (gates.count() + witnesses.count() + fmt.count() == commit_gate_roster.count())
        && fold(gunbc.commit_workflow.commit_gate_roster, init: true, f: fn(acc, row) {
          let is_gate = check_is_gate(check: row.check)
          let is_witness = check_is_witness(check: row.check)
          let is_fmt = check_is_fmt(check: row.check)
          acc
            && (is_gate || is_witness || is_fmt)
            && !(is_gate && is_witness)
            && !(is_gate && is_fmt)
            && !(is_witness && is_fmt)
        })
    }
    gunbc.commit_workflow.DuplicateCommitCheckFound { check: _ } => false
  }
}

test fn commit_check_demand_canonical_roster_refuses_empty_or_truncated_discovery() -> Bool {
  match gunbc.commit_workflow.project_enrollment_witness_demands(discoveries: []) {
    gunbc.commit_workflow.DemandMissing { check: _, cause: _ } =>
      match gunbc.commit_workflow.project_enrollment_witness_demands(
        discoveries: live_file_grain_discoveries()
      ) {
        gunbc.commit_workflow.DemandMissing { check: _, cause: _ } => true
        gunbc.commit_workflow.DemandQualified { rows: _ } => false
        gunbc.commit_workflow.DemandAmbiguous { check: _, cause: _ } => false
        gunbc.commit_workflow.DemandIncomplete { check: _, cause: _ } => false
        gunbc.commit_workflow.DemandRosterAmbiguous { cause: _ } => false
      }
    gunbc.commit_workflow.DemandQualified { rows: _ } => false
    gunbc.commit_workflow.DemandAmbiguous { check: _, cause: _ } => false
    gunbc.commit_workflow.DemandIncomplete { check: _, cause: _ } => false
    gunbc.commit_workflow.DemandRosterAmbiguous { cause: _ } => false
  }
}

test fn commit_check_demand_all_six_file_grain_rows_expand_complete_discoveries() -> Bool {
  let roster = filter(
    gunbc.commit_workflow.commit_gate_roster,
    row => check_is_file_grain_witness(check: row.check)
  )
  let discoveries = live_file_grain_discoveries()
  roster.count() == 6
    && match gunbc.commit_workflow.project_enrollment_witness_demands_unchecked(
      roster: roster,
      discoveries: discoveries
    ) {
      gunbc.commit_workflow.DemandQualified { rows } =>
        gunbc.commit_workflow.demand_rows_match_roster(roster: roster, rows: rows)
          && qualified_rows_match_complete_discoveries(
            rows: rows,
            discoveries: discoveries
          )
      gunbc.commit_workflow.DemandMissing { check: _, cause: _ } => false
      gunbc.commit_workflow.DemandAmbiguous { check: _, cause: _ } => false
      gunbc.commit_workflow.DemandIncomplete { check: _, cause: _ } => false
      gunbc.commit_workflow.DemandRosterAmbiguous { cause: _ } => false
    }
}

test fn commit_check_demand_named_multi_function_is_exact_and_permutation_invariant() -> Bool {
  let check = synthetic_witness_check(
    entry: "dag/test/claim/synthetic_multi_test.dag",
    check_fns: ["beta_holds", "alpha_holds"]
  )
  let roster = [synthetic_enrollment(check: check)]
  let first = gunbc.commit_workflow.project_enrollment_witness_demands_unchecked(
    roster: roster,
    discoveries: [
      complete_discovery(
        entry: "dag/test/claim/synthetic_multi_test.dag",
        module_path: "test.claim.synthetic_multi",
        declaration_names: ["alpha_holds", "extra_holds", "beta_holds"]
      )
    ]
  )
  let permuted = gunbc.commit_workflow.project_enrollment_witness_demands_unchecked(
    roster: roster,
    discoveries: [
      complete_discovery(
        entry: "dag/test/claim/synthetic_multi_test.dag",
        module_path: "test.claim.synthetic_multi",
        declaration_names: ["beta_holds", "alpha_holds", "extra_holds"]
      )
    ]
  )
  match first {
    gunbc.commit_workflow.DemandQualified { rows: left } =>
      match permuted {
        gunbc.commit_workflow.DemandQualified { rows: right } =>
          left.count() == 1
            && right.count() == 1
            && left.first().declarations.count() == 2
            && nth_declaration_name(rows: left, row: 0, declaration: 0) == "beta_holds"
            && nth_declaration_name(rows: left, row: 0, declaration: 1) == "alpha_holds"
            && gunbc.commit_workflow.declaration_ref_lists_eq(
              left: left.first().declarations,
              right: right.first().declarations
            )
        gunbc.commit_workflow.DemandMissing { check: _, cause: _ } => false
        gunbc.commit_workflow.DemandAmbiguous { check: _, cause: _ } => false
        gunbc.commit_workflow.DemandIncomplete { check: _, cause: _ } => false
        gunbc.commit_workflow.DemandRosterAmbiguous { cause: _ } => false
      }
    gunbc.commit_workflow.DemandMissing { check: _, cause: _ } => false
    gunbc.commit_workflow.DemandAmbiguous { check: _, cause: _ } => false
    gunbc.commit_workflow.DemandIncomplete { check: _, cause: _ } => false
    gunbc.commit_workflow.DemandRosterAmbiguous { cause: _ } => false
  }
}

test fn commit_check_demand_gate_and_fmt_rows_stay_typed_and_empty() -> Bool {
  let gate = gunbc.commit_workflow.CommitSpecGate { gate: gunbc.ci_gate.EmitHostGate }
  let fmt = gunbc.commit_workflow.CommitCargoFmtCheck
  let roster = [
    synthetic_enrollment(check: gate),
    synthetic_enrollment(check: fmt)
  ]
  match gunbc.commit_workflow.project_enrollment_witness_demands_unchecked(roster: roster, discoveries: []) {
    gunbc.commit_workflow.DemandQualified { rows } =>
      rows.count() == 2
        && rows.first().declarations.count() == 0
        && rows.skip(n: 1).first().declarations.count() == 0
        && gunbc.commit_workflow.commit_check_kind_eq(a: rows.first().check, b: gate)
        && gunbc.commit_workflow.commit_check_kind_eq(a: rows.skip(n: 1).first().check, b: fmt)
    gunbc.commit_workflow.DemandMissing { check: _, cause: _ } => false
    gunbc.commit_workflow.DemandAmbiguous { check: _, cause: _ } => false
    gunbc.commit_workflow.DemandIncomplete { check: _, cause: _ } => false
    gunbc.commit_workflow.DemandRosterAmbiguous { cause: _ } => false
  }
}

test fn commit_check_demand_unowned_discovery_is_roster_ambiguous() -> Bool {
  match gunbc.commit_workflow.project_enrollment_witness_demands(
    discoveries: [
      complete_discovery(
        entry: "dag/test/claim/unowned_test.dag",
        module_path: "test.claim.unowned",
        declaration_names: ["unowned_holds"]
      )
    ]
  ) {
    gunbc.commit_workflow.DemandRosterAmbiguous { cause } =>
      cause == ("declaration discovery has no owning witness enrollment" as std.types.NonEmptyStr)
    gunbc.commit_workflow.DemandQualified { rows: _ } => false
    gunbc.commit_workflow.DemandMissing { check: _, cause: _ } => false
    gunbc.commit_workflow.DemandAmbiguous { check: _, cause: _ } => false
    gunbc.commit_workflow.DemandIncomplete { check: _, cause: _ } => false
  }
}

test fn commit_check_demand_absent_named_declaration_is_missing() -> Bool {
  let check = synthetic_witness_check(
    entry: "dag/test/claim/missing_test.dag",
    check_fns: ["required_holds"]
  )
  match gunbc.commit_workflow.project_enrollment_witness_demands_unchecked(
    roster: [synthetic_enrollment(check: check)],
    discoveries: [
      complete_discovery(
        entry: "dag/test/claim/missing_test.dag",
        module_path: "test.claim.missing",
        declaration_names: ["other_holds"]
      )
    ]
  ) {
    gunbc.commit_workflow.DemandMissing { check: failed, cause: _ } =>
      gunbc.commit_workflow.commit_check_kind_eq(a: failed, b: check)
    gunbc.commit_workflow.DemandQualified { rows: _ } => false
    gunbc.commit_workflow.DemandAmbiguous { check: _, cause: _ } => false
    gunbc.commit_workflow.DemandIncomplete { check: _, cause: _ } => false
    gunbc.commit_workflow.DemandRosterAmbiguous { cause: _ } => false
  }
}

