        declaration_names: ["holds"]
      )
    ]
  ) {
    DemandAmbiguous { check: failed, cause: _ } =>
      commit_check_kind_eq(a: failed, b: check)
    DemandQualified { rows: _ } => false
    DemandMissing { check: _, cause: _ } => false
    DemandIncomplete { check: _, cause: _ } => false
  }
}

test fn commit_check_demand_overlapping_output_membership_is_ambiguous() -> Bool {
  let first = synthetic_witness_check(
    entry: "dag/test/claim/overlap_test.dag",
    check_fns: ["same_holds"]
  )
  let second = CommitWitnessClaim {
    entry: "dag/test/claim/overlap_test.dag",
    check_fns: ["same_holds"],
    kind: ExecutionWitnessKind,
    span: SpanUndeclared
  }
  match project_enrollment_witness_demands(
    roster: [
      synthetic_enrollment(check: first),
      synthetic_enrollment(check: second)
    ],
    discoveries: [
      complete_discovery(
        entry: "dag/test/claim/overlap_test.dag",
        module_path: "test.claim.overlap",
        declaration_names: ["same_holds"]
      )
    ]
  ) {
    DemandAmbiguous { check: _, cause: _ } => true
    DemandQualified { rows: _ } => false
    DemandMissing { check: _, cause: _ } => false
    DemandIncomplete { check: _, cause: _ } => false
  }
}

test fn commit_check_demand_roster_and_expansion_set_equality_has_teeth() -> Bool {
  let gate = CommitSpecGate { gate: EmitHostGate }
  let fmt = CommitCargoFmtCheck
  let roster = [
    synthetic_enrollment(check: gate),
    synthetic_enrollment(check: fmt)
  ]
  let gate_row = EnrollmentWitnessDemand { check: gate, declarations: [] }
  let fmt_row = EnrollmentWitnessDemand { check: fmt, declarations: [] }
  let complete = [
    demand_decl(module_path: "test.claim.expansion", decl_name: "a_holds"),
    demand_decl(module_path: "test.claim.expansion", decl_name: "b_holds")
  ]
  demand_rows_match_roster(roster: roster, rows: [gate_row, fmt_row])
    && !demand_rows_match_roster(roster: roster, rows: [gate_row])
    && !demand_rows_match_roster(roster: roster, rows: [gate_row, gate_row])
    && !declaration_ref_lists_eq(left: complete, right: [complete.first()])
    && !declaration_ref_lists_eq(
      left: complete,
      right: [complete.first(), complete.first()]
    )
}

test fn commit_check_demand_rejects_non_whole_or_wrong_module_discovery() -> Bool {
  let check = synthetic_witness_check(
    entry: "dag/test/claim/wrong_identity_test.dag",
    check_fns: ["holds"]
  )
  let wrong_field = DeclarationRef {
    module_path: "test.claim.wrong_identity" as NonEmptyStr,
    decl_name: "holds" as NonEmptyStr,
    field: NamedField { field_name: "body" as NonEmptyStr }
  }
  match project_enrollment_witness_demands(
    roster: [synthetic_enrollment(check: check)],
    discoveries: [
      DiscoveryComplete {
        entry: "dag/test/claim/wrong_identity_test.dag",
        module_path: "test.claim.supplied_module" as NonEmptyStr,
        declarations: [wrong_field]
      }
    ]
  ) {
    DemandAmbiguous { check: _, cause: _ } => true
    DemandQualified { rows: _ } => false
    DemandMissing { check: _, cause: _ } => false
    DemandIncomplete { check: _, cause: _ } => false
  }
}
