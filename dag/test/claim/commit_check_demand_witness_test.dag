test fn commit_check_demand_incomplete_discovery_stays_incomplete() -> Bool {
  let check = synthetic_witness_check(
    entry: "dag/test/claim/incomplete_test.dag",
    check_fns: []
  )
  match gunbc.commit_workflow.project_enrollment_witness_demands_unchecked(
    roster: [synthetic_enrollment(check: check)],
    discoveries: [
      gunbc.commit_workflow.DiscoveryIncomplete {
        entry: "dag/test/claim/incomplete_test.dag",
        cause: "source scan refused" as std.types.NonEmptyStr
      }
    ]
  ) {
    gunbc.commit_workflow.DemandIncomplete { check: failed, cause } =>
      gunbc.commit_workflow.commit_check_kind_eq(a: failed, b: check)
        && cause == ("source scan refused" as std.types.NonEmptyStr)
    gunbc.commit_workflow.DemandQualified { rows: _ } => false
    gunbc.commit_workflow.DemandMissing { check: _, cause: _ } => false
    gunbc.commit_workflow.DemandAmbiguous { check: _, cause: _ } => false
    gunbc.commit_workflow.DemandRosterAmbiguous { cause: _ } => false
  }
}

test fn commit_check_demand_duplicate_roster_identity_is_ambiguous() -> Bool {
  let check = synthetic_witness_check(
    entry: "dag/test/claim/duplicate_roster_test.dag",
    check_fns: ["holds"]
  )
  let row = synthetic_enrollment(check: check)
  match gunbc.commit_workflow.first_duplicate_commit_check(roster: [row, row]) {
    gunbc.commit_workflow.DuplicateCommitCheckFound { check: failed } =>
      gunbc.commit_workflow.commit_check_kind_eq(a: failed, b: check)
    gunbc.commit_workflow.NoDuplicateCommitCheck => false
  }
}

test fn commit_check_demand_overlapping_output_membership_is_ambiguous() -> Bool {
  let first = synthetic_witness_check(
    entry: "dag/test/claim/overlap_test.dag",
    check_fns: ["same_holds"]
  )
  let second = gunbc.commit_workflow.CommitWitnessClaim {
    entry: "dag/test/claim/overlap_test.dag",
    check_fns: ["same_holds"],
    kind: std.realization_schedule.ExecutionWitnessKind,
    span: std.realization_schedule.SpanUndeclared
  }
  match gunbc.commit_workflow.project_enrollment_witness_demands_unchecked(
    roster: [
      synthetic_enrollment(check: first),
      synthetic_enrollment(check: second)
    ],
    discoveries: [
      complete_discovery(
        entry: "dag/test/claim/overlap_test.dag",
        module_path: "test.claim.overlap",
        declaration_names: ["same_holds"]
      )
    ]
  ) {
    gunbc.commit_workflow.DemandAmbiguous { check: _, cause: _ } => true
    gunbc.commit_workflow.DemandQualified { rows: _ } => false
    gunbc.commit_workflow.DemandMissing { check: _, cause: _ } => false
    gunbc.commit_workflow.DemandIncomplete { check: _, cause: _ } => false
    gunbc.commit_workflow.DemandRosterAmbiguous { cause: _ } => false
  }
}

test fn commit_check_demand_roster_and_expansion_set_equality_has_teeth() -> Bool {
  let gate = gunbc.commit_workflow.CommitSpecGate { gate: gunbc.ci_gate.EmitHostGate }
  let fmt = gunbc.commit_workflow.CommitCargoFmtCheck
  let roster = [
    synthetic_enrollment(check: gate),
    synthetic_enrollment(check: fmt)
  ]
  let gate_row = gunbc.commit_workflow.EnrollmentWitnessDemand { check: gate, declarations: [] }
  let fmt_row = gunbc.commit_workflow.EnrollmentWitnessDemand { check: fmt, declarations: [] }
  let complete = [
    demand_decl(module_path: "test.claim.expansion", decl_name: "a_holds"),
    demand_decl(module_path: "test.claim.expansion", decl_name: "b_holds")
  ]
  gunbc.commit_workflow.demand_rows_match_roster(roster: roster, rows: [gate_row, fmt_row])
    && !gunbc.commit_workflow.demand_rows_match_roster(roster: roster, rows: [gate_row])
    && !gunbc.commit_workflow.demand_rows_match_roster(roster: roster, rows: [gate_row, gate_row])
    && !gunbc.commit_workflow.declaration_ref_lists_eq(left: complete, right: [complete.first()])
    && !gunbc.commit_workflow.declaration_ref_lists_eq(
      left: complete,
      right: [complete.first(), complete.first()]
    )
    && !gunbc.commit_workflow.declaration_ref_lists_eq(
      left: [complete.first(), complete.first(), complete.skip(n: 1).first()],
      right: [complete.first(), complete.skip(n: 1).first(), complete.skip(n: 1).first()]
    )
}

test fn commit_check_demand_rejects_non_whole_discovery() -> Bool {
  let check = synthetic_witness_check(
    entry: "dag/test/claim/wrong_identity_test.dag",
    check_fns: ["holds"]
  )
  let wrong_field = std.decl_ref.DeclarationRef {
    module_path: "test.claim.wrong_identity" as std.types.NonEmptyStr,
    decl_name: "holds" as std.types.NonEmptyStr,
    field: std.decl_ref.NamedField { field_name: "body" as std.types.NonEmptyStr }
  }
  gunbc.commit_workflow.declaration_ref_lists_eq(left: [wrong_field], right: [wrong_field])
    && match gunbc.commit_workflow.project_enrollment_witness_demands_unchecked(
    roster: [synthetic_enrollment(check: check)],
    discoveries: [
      gunbc.commit_workflow.DiscoveryComplete {
        entry: "dag/test/claim/wrong_identity_test.dag",
        module_path: "test.claim.wrong_identity" as std.types.NonEmptyStr,
        declarations: [wrong_field]
      }
    ]
  ) {
    gunbc.commit_workflow.DemandAmbiguous { check: _, cause: _ } => true
    gunbc.commit_workflow.DemandQualified { rows: _ } => false
    gunbc.commit_workflow.DemandMissing { check: _, cause: _ } => false
    gunbc.commit_workflow.DemandIncomplete { check: _, cause: _ } => false
    gunbc.commit_workflow.DemandRosterAmbiguous { cause: _ } => false
  }
}

