test fn commit_check_demand_duplicate_module_is_ambiguous() -> Bool {
  let first = synthetic_witness_check(
    entry: "dag/test/claim/module_a_test.dag",
    check_fns: ["a_holds"]
  )
  let second = synthetic_witness_check(
    entry: "dag/test/claim/module_b_test.dag",
    check_fns: ["b_holds"]
  )
  match gunbc.commit_workflow.project_enrollment_witness_demands_unchecked(
    roster: [
      synthetic_enrollment(check: first),
      synthetic_enrollment(check: second)
    ],
    discoveries: [
      complete_discovery(
        entry: "dag/test/claim/module_a_test.dag",
        module_path: "test.claim.shared_module",
        declaration_names: ["a_holds"]
      ),
      complete_discovery(
        entry: "dag/test/claim/module_b_test.dag",
        module_path: "test.claim.shared_module",
        declaration_names: ["b_holds"]
      )
    ]
  ) {
    gunbc.commit_workflow.DemandAmbiguous { check: failed, cause: _ } =>
      gunbc.commit_workflow.commit_check_kind_eq(a: failed, b: first)
        || gunbc.commit_workflow.commit_check_kind_eq(a: failed, b: second)
    gunbc.commit_workflow.DemandQualified { rows: _ } => false
    gunbc.commit_workflow.DemandMissing { check: _, cause: _ } => false
    gunbc.commit_workflow.DemandIncomplete { check: _, cause: _ } => false
    gunbc.commit_workflow.DemandRosterAmbiguous { cause: _ } => false
  }
}

