test fn commit_check_demand_incomplete_discovery_stays_incomplete() -> Bool {
  let check = synthetic_witness_check(
    entry: "dag/test/claim/incomplete_test.dag",
    check_fns: []
  )
  match project_enrollment_witness_demands(
    roster: [synthetic_enrollment(check: check)],
    discoveries: [
      DiscoveryIncomplete {
        entry: "dag/test/claim/incomplete_test.dag",
        cause: "source scan refused" as NonEmptyStr
      }
    ]
  ) {
    DemandIncomplete { check: failed, cause } =>
      commit_check_kind_eq(a: failed, b: check)
        && cause == ("source scan refused" as NonEmptyStr)
    DemandQualified { rows: _ } => false
    DemandMissing { check: _, cause: _ } => false
    DemandAmbiguous { check: _, cause: _ } => false
  }
}

