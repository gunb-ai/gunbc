module test.claim.commit_check_demand_witness

import gunbc.commit_workflow {
  CommitCheckKind,
  CommitSpecGate,
  CommitWitnessClaim,
  CommitCargoFmtCheck,
  CommitCheckEnrollment,
  EntryDeclarationDiscovery,
  DiscoveryComplete,
  DiscoveryIncomplete,
  EnrollmentWitnessDemand,
  DemandQualified,
  DemandMissing,
  DemandAmbiguous,
  DemandIncomplete,
  commit_gate_roster,
  commit_check_kind_eq,
  demand_rows_match_roster,
  declaration_ref_lists_eq,
  project_enrollment_witness_demands,
}
import gunbc.ci_gate { EmitHostGate }
import std.decl_ref { DeclarationRef, WholeDeclaration, NamedField }
import std.realization_schedule {
  CorpusWitnessKind,
  ExecutionWitnessKind,
  SpanUndeclared,
}
import std.types { NonEmptyStr }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

fn demand_decl(module_path: String, decl_name: String) -> DeclarationRef {
  DeclarationRef {
    module_path: module_path as NonEmptyStr,
    decl_name: decl_name as NonEmptyStr,
    field: WholeDeclaration
  }
}

fn complete_discovery(
  entry: String,
  module_path: String,
  declaration_names: List<String>,
) -> EntryDeclarationDiscovery {
  DiscoveryComplete {
    entry: entry,
    module_path: module_path as NonEmptyStr,
    declarations: map(
      declaration_names,
      name => demand_decl(module_path: module_path, decl_name: name)
    )
  }
}

fn synthetic_witness_check(
  entry: String,
  check_fns: List<String>,
) -> CommitCheckKind {
  CommitWitnessClaim {
    entry: entry,
    check_fns: check_fns,
    kind: CorpusWitnessKind,
    span: SpanUndeclared
  }
}

fn synthetic_enrollment(check: CommitCheckKind) -> CommitCheckEnrollment {
  CommitCheckEnrollment { check: check, surfaces: [] }
}

fn check_is_gate(check: CommitCheckKind) -> Bool {
  match check {
    CommitSpecGate { gate: _ } => true
    CommitWitnessClaim { entry: _, check_fns: _, kind: _, span: _ } => false
    CommitCargoFmtCheck => false
  }
}

fn check_is_witness(check: CommitCheckKind) -> Bool {
  match check {
    CommitSpecGate { gate: _ } => false
    CommitWitnessClaim { entry: _, check_fns: _, kind: _, span: _ } => true
    CommitCargoFmtCheck => false
  }
}

fn check_is_fmt(check: CommitCheckKind) -> Bool {
  match check {
    CommitSpecGate { gate: _ } => false
    CommitWitnessClaim { entry: _, check_fns: _, kind: _, span: _ } => false
    CommitCargoFmtCheck => true
  }
}

fn check_is_file_grain_witness(check: CommitCheckKind) -> Bool {
  match check {
    CommitWitnessClaim { entry: _, check_fns, kind: _, span: _ } =>
      check_fns.count() == 0
    CommitSpecGate { gate: _ } => false
    CommitCargoFmtCheck => false
  }
}

fn live_file_grain_discoveries() -> List<EntryDeclarationDiscovery> {
  [
    complete_discovery(
      entry: "src/v2/test/claim/execution/bind_eval_by_execution_test.dag",
      module_path: "v2.test.execution.bind_eval_by_execution",
      declaration_names: [
        "bind_source_pipeline_admits_holds",
        "bind_source_driven_executes_holds"
      ]
    ),
    complete_discovery(
      entry: "src/v2/test/claim/execution/loop_eval_by_execution_test.dag",
      module_path: "v2.test.execution.loop_eval_by_execution",
      declaration_names: [
        "loop_source_pipeline_admits_holds",
        "loop_source_driven_executes_holds"
      ]
    ),
    complete_discovery(
      entry: "src/v2/test/claim/manual/bind_demand_driven_eval_test.dag",
      module_path: "v2.test.manual.bind_demand_driven_eval",
      declaration_names: [
        "bind_eval_counted_value_body_holds",
        "bind_eval_divergent_value_rejects_holds"
      ]
    ),
    complete_discovery(
      entry: "src/v2/test/claim/host_language_transport_script/lens_unit/transport_script_position_test.dag",
      module_path: "v2.test.host_language_transport_script.lens_unit.transport_script_position",
      declaration_names: [
        "witness_computed_green",
        "witness_bare_literal_red"
      ]
    ),
    complete_discovery(
      entry: "src/v2/test/claim/host_language_transport_script/corpus/facts_readback_verdict_perturb_test.dag",
      module_path: "v2.test.host_language_transport_script.corpus.facts_readback_verdict_perturb",
      declaration_names: [
        "witness_computed_facts_readback_holds",
        "witness_literal_perturb_facts_readback_red"
      ]
    ),
    complete_discovery(
      entry: "dag/test/claim/orchestration_if_emit_test.dag",
      module_path: "test.claim.orchestration_if_emit",
      declaration_names: [
        "orch_if_streq_empty_then_holds",
        "orch_if_streq_empty_then_has_teeth_holds"
      ]
    )
  ]
}

fn qualified_rows_have_two_declarations(rows: List<EnrollmentWitnessDemand>) -> Bool {
  rows.count() == 6
    && fold(rows, init: true, f: fn(acc, row) {
      acc && row.declarations.count() == 2
    })
}

test fn commit_check_demand_live_roster_is_exactly_48_typed_rows() -> Bool {
  let gates = filter(commit_gate_roster, row => check_is_gate(check: row.check))
  let witnesses = filter(commit_gate_roster, row => check_is_witness(check: row.check))
  let fmt = filter(commit_gate_roster, row => check_is_fmt(check: row.check))
  commit_gate_roster.count() == 48
    && gates.count() == 9
    && witnesses.count() == 38
    && fmt.count() == 1
    && commit_gate_roster.count() == gates.count() + witnesses.count() + fmt.count()
}

test fn commit_check_demand_all_six_file_grain_rows_expand_complete_discoveries() -> Bool {
  let roster = filter(
    commit_gate_roster,
    row => check_is_file_grain_witness(check: row.check)
  )
  roster.count() == 6
    && match project_enrollment_witness_demands(
      roster: roster,
      discoveries: live_file_grain_discoveries()
    ) {
      DemandQualified { rows } =>
        demand_rows_match_roster(roster: roster, rows: rows)
          && qualified_rows_have_two_declarations(rows: rows)
      DemandMissing { check: _, cause: _ } => false
      DemandAmbiguous { check: _, cause: _ } => false
      DemandIncomplete { check: _, cause: _ } => false
    }
}

test fn commit_check_demand_named_multi_function_is_exact_and_permutation_invariant() -> Bool {
  let check = synthetic_witness_check(
    entry: "dag/test/claim/synthetic_multi_test.dag",
    check_fns: ["beta_holds", "alpha_holds"]
  )
  let roster = [synthetic_enrollment(check: check)]
  let first = project_enrollment_witness_demands(
    roster: roster,
    discoveries: [
      complete_discovery(
        entry: "dag/test/claim/synthetic_multi_test.dag",
        module_path: "test.claim.synthetic_multi",
        declaration_names: ["alpha_holds", "extra_holds", "beta_holds"]
      )
    ]
  )
  let permuted = project_enrollment_witness_demands(
    roster: roster,
    discoveries: [
      complete_discovery(
        entry: "dag/test/claim/synthetic_multi_test.dag",
        module_path: "test.claim.synthetic_multi",
        declaration_names: ["beta_holds", "alpha_holds", "extra_holds"]
      )
    ]
  )
  match first {
    DemandQualified { rows: left } =>
      match permuted {
        DemandQualified { rows: right } =>
          left.count() == 1
            && right.count() == 1
            && left.first().declarations.count() == 2
            && (left.first().declarations.first().decl_name as String) == "beta_holds"
            && (left.first().declarations.skip(n: 1).first().decl_name as String) == "alpha_holds"
            && declaration_ref_lists_eq(
              left: left.first().declarations,
              right: right.first().declarations
            )
        DemandMissing { check: _, cause: _ } => false
        DemandAmbiguous { check: _, cause: _ } => false
        DemandIncomplete { check: _, cause: _ } => false
      }
    DemandMissing { check: _, cause: _ } => false
    DemandAmbiguous { check: _, cause: _ } => false
    DemandIncomplete { check: _, cause: _ } => false
  }
}

test fn commit_check_demand_gate_and_fmt_rows_stay_typed_and_empty() -> Bool {
  let gate = CommitSpecGate { gate: EmitHostGate }
  let fmt = CommitCargoFmtCheck
  let roster = [
    synthetic_enrollment(check: gate),
    synthetic_enrollment(check: fmt)
  ]
  match project_enrollment_witness_demands(roster: roster, discoveries: []) {
    DemandQualified { rows } =>
      rows.count() == 2
        && rows.first().declarations.count() == 0
        && rows.skip(n: 1).first().declarations.count() == 0
        && commit_check_kind_eq(a: rows.first().check, b: gate)
        && commit_check_kind_eq(a: rows.skip(n: 1).first().check, b: fmt)
    DemandMissing { check: _, cause: _ } => false
    DemandAmbiguous { check: _, cause: _ } => false
    DemandIncomplete { check: _, cause: _ } => false
  }
}

test fn commit_check_demand_absent_named_declaration_is_missing() -> Bool {
  let check = synthetic_witness_check(
    entry: "dag/test/claim/missing_test.dag",
    check_fns: ["required_holds"]
  )
  match project_enrollment_witness_demands(
    roster: [synthetic_enrollment(check: check)],
    discoveries: [
      complete_discovery(
        entry: "dag/test/claim/missing_test.dag",
        module_path: "test.claim.missing",
        declaration_names: ["other_holds"]
      )
    ]
  ) {
    DemandMissing { check: failed, cause: _ } =>
      commit_check_kind_eq(a: failed, b: check)
    DemandQualified { rows: _ } => false
    DemandAmbiguous { check: _, cause: _ } => false
    DemandIncomplete { check: _, cause: _ } => false
  }
}

test fn commit_check_demand_duplicate_discovery_entry_is_ambiguous() -> Bool {
  let check = synthetic_witness_check(
    entry: "dag/test/claim/duplicate_entry_test.dag",
    check_fns: ["holds"]
  )
  match project_enrollment_witness_demands(
    roster: [synthetic_enrollment(check: check)],
    discoveries: [
      complete_discovery(
        entry: "dag/test/claim/duplicate_entry_test.dag",
        module_path: "test.claim.duplicate_entry",
        declaration_names: ["holds"]
      ),
      complete_discovery(
        entry: "dag/test/claim/duplicate_entry_test.dag",
        module_path: "test.claim.duplicate_entry_other",
        declaration_names: ["holds"]
      )
    ]
  ) {
    DemandAmbiguous { check: failed, cause: _ } =>
      commit_check_kind_eq(a: failed, b: check)
    DemandQualified { rows: _ } => false
    DemandMissing { check: _, cause: _ } => false
    DemandIncomplete { check: _, cause: _ } => false
  }
}

