module test.claim.commit_check_demand_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.ReadsLiveTree

fn demand_decl(module_path: String, decl_name: String) -> std.decl_ref.DeclarationRef {
  std.decl_ref.DeclarationRef {
    module_path: module_path as std.types.NonEmptyStr,
    decl_name: decl_name as std.types.NonEmptyStr,
    field: std.decl_ref.WholeDeclaration
  }
}

fn complete_discovery(
  entry: String,
  module_path: String,
  declaration_names: List<String>,
) -> gunbc.commit_workflow.EntryDeclarationDiscovery {
  gunbc.commit_workflow.DiscoveryComplete {
    entry: entry,
    module_path: module_path as std.types.NonEmptyStr,
    declarations: map(
      declaration_names,
      name => demand_decl(module_path: module_path, decl_name: name)
    )
  }
}

fn synthetic_witness_check(
  entry: String,
  check_fns: List<String>,
) -> gunbc.commit_workflow.CommitCheckKind {
  gunbc.commit_workflow.CommitWitnessClaim {
    entry: entry,
    check_fns: check_fns,
    kind: std.realization_schedule.CorpusWitnessKind,
    span: std.realization_schedule.SpanUndeclared
  }
}

fn synthetic_enrollment(check: gunbc.commit_workflow.CommitCheckKind) -> gunbc.commit_workflow.CommitCheckEnrollment {
  gunbc.commit_workflow.CommitCheckEnrollment { check: check, surfaces: [] }
}

fn check_is_gate(check: gunbc.commit_workflow.CommitCheckKind) -> Bool {
  match check {
    gunbc.commit_workflow.CommitSpecGate { gate: _ } => true
    gunbc.commit_workflow.CommitWitnessClaim { entry: _, check_fns: _, kind: _, span: _ } => false
    gunbc.commit_workflow.CommitCargoFmtCheck => false
  }
}

fn check_is_witness(check: gunbc.commit_workflow.CommitCheckKind) -> Bool {
  match check {
    gunbc.commit_workflow.CommitSpecGate { gate: _ } => false
    gunbc.commit_workflow.CommitWitnessClaim { entry: _, check_fns: _, kind: _, span: _ } => true
    gunbc.commit_workflow.CommitCargoFmtCheck => false
  }
}

fn check_is_fmt(check: gunbc.commit_workflow.CommitCheckKind) -> Bool {
  match check {
    gunbc.commit_workflow.CommitSpecGate { gate: _ } => false
    gunbc.commit_workflow.CommitWitnessClaim { entry: _, check_fns: _, kind: _, span: _ } => false
    gunbc.commit_workflow.CommitCargoFmtCheck => true
  }
}

fn check_is_file_grain_witness(check: gunbc.commit_workflow.CommitCheckKind) -> Bool {
  match check {
    gunbc.commit_workflow.CommitWitnessClaim { entry: _, check_fns, kind: _, span: _ } =>
      check_fns.count() == 0
    gunbc.commit_workflow.CommitSpecGate { gate: _ } => false
    gunbc.commit_workflow.CommitCargoFmtCheck => false
  }
}

