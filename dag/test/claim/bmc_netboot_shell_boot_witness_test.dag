module test.claim.bmc_netboot_shell_boot


test fn srv4_shell_boot_sequence_direct_kernel() -> Bool {
  let all = fold(srv4_shell_boot_commands, init: "", f: (acc, c) => join([acc, uefi_shell_command_line(cmd: c), "\n"], ""))
  string_contains(s: all, pattern: "ifconfig -s eth2 dhcp")
    && string_contains(s: all, pattern: "ping 192.168.1.195")
    && string_contains(s: all, pattern: "tftp -i eth2 192.168.1.195 vmlinuz fs0:\\vmlinuz")
    && string_contains(s: all, pattern: "tftp -i eth2 192.168.1.195 initrd fs0:\\initrd")
    && string_contains(s: all, pattern: "fs0:\\vmlinuz initrd=\\initrd ip=dhcp url=https://cdimage.ubuntu.com")
    && string_contains(s: all, pattern: "autoinstall ds=nocloud-net;s=http://192.168.1.195:8080/nocloud/")
    && list_length(items: srv4_shell_boot_commands) == 5
}

test fn srv4_tftpd_serve_command_grounded() -> Bool {
  string_contains(s: shell_command_render(command: bmc_tftpd_serve_command(plan: srv4_bmc_netboot_serve_plan)), pattern: "'/tmp/netboot/busybox' 'udpsvd' '-E' '0.0.0.0' '69' '/tmp/netboot/busybox' 'tftpd' '-r' '/tmp/netboot'")
}
