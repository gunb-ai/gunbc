module test.claim.platform_document_roster_witness

import std.types { Bool, String, List }
import std.integer { Int }
import product.altra_motherboard.platform_document_roster {
  PlatformDocumentFetchRefused,
  PlatformDocumentMarketingOnlyDeadEnd,
  PlatformDocumentOperatorSupplied,
  PlatformDocumentTextUnread,
  platform_document_roster,
  platform_document_roster_count,
  roster_includes_marketing_dead_end,
  mt_collins_engineering_route_is_nda,
}
import extdeps.cpu.ampere_altra_package { mt_collins_public_brief_is_marketing_only }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn roster_row_matches_platform_design_spec_unread() -> Bool {
  fold(platform_document_roster, init: false, f: fn(acc, r) {
    acc || ((r.marketing_name as String) == "Ampere Altra Platform Hardware Design Specification" && match r.read_state {
      PlatformDocumentTextUnread => true
      PlatformDocumentFetchRefused => false
      PlatformDocumentOperatorSupplied => false
      PlatformDocumentMarketingOnlyDeadEnd => false
    })
  })
}

fn roster_row_matches_mt_mitchell_fetch_refused() -> Bool {
  fold(platform_document_roster, init: false, f: fn(acc, r) {
    acc || ((r.marketing_name as String) == "Mt. Mitchell" && match r.read_state {
      PlatformDocumentFetchRefused => true
      PlatformDocumentTextUnread => false
      PlatformDocumentOperatorSupplied => false
      PlatformDocumentMarketingOnlyDeadEnd => false
    })
  })
}

fn roster_row_matches_mt_jade_operator_supplied() -> Bool {
  fold(platform_document_roster, init: false, f: fn(acc, r) {
    acc || ((r.marketing_name as String) == "Mt. Jade" && match r.read_state {
      PlatformDocumentOperatorSupplied => true
      PlatformDocumentTextUnread => false
      PlatformDocumentFetchRefused => false
      PlatformDocumentMarketingOnlyDeadEnd => false
    })
  })
}

test fn w_the_roster_lists_four_platform_documents() -> Bool {
  platform_document_roster_count(rows: platform_document_roster) == 4
}

test fn w_the_altra_platform_design_spec_is_cited_but_unread() -> Bool {
  roster_row_matches_platform_design_spec_unread()
}

test fn w_mt_mitchell_is_fetch_refused_and_mt_jade_is_operator_supplied() -> Bool {
  roster_row_matches_mt_mitchell_fetch_refused() && roster_row_matches_mt_jade_operator_supplied()
}

test fn w_mt_collins_is_a_marketing_dead_end_with_an_nda_engineering_route() -> Bool {
  roster_includes_marketing_dead_end(rows: platform_document_roster)
    && mt_collins_engineering_route_is_nda()
    && mt_collins_public_brief_is_marketing_only()
}

test fn w_every_roster_row_carries_a_nonempty_locator() -> Bool {
  fold(platform_document_roster, init: true, f: fn(acc, r) {
    acc && (r.authority.uri.locator as String) != ""
  })
}
