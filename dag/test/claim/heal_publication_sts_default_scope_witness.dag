module test.claim.heal_publication_sts_default_scope_witness

import std.types { Bool }
import extdeps.cloud.gcp.sts { Jwt, RequestAccessToken }

// Verifies that the constructors backing gcp.STS.Exchange field defaults
// (subject_token_type = Jwt, requested_token_type = RequestAccessToken) resolve
// in this module's scope. At base (heal_publication lacked the named import),
// the same call context produced NoSuchVariable{Jwt}; the paired base run
// removes the import and this fn is red. Green at head confirms the
// constructors are in scope and the Exchange defaults resolve.
test fn sts_exchange_defaults_resolve_in_heal_publication_scope() -> Bool {
  match Jwt {
    Jwt => match RequestAccessToken {
      RequestAccessToken => true
    }
  }
}
