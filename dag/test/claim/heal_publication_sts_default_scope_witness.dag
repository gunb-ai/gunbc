module test.claim.heal_publication_sts_default_scope_witness

import std.types { Bool }
import gunbc.heal_publication { sts_exchange_defaults_resolve }

// Discriminating witness for the #16160 regression: evaluates Jwt and
// RequestAccessToken inside gunbc.heal_publication's module scope. At base
// (4aad92f8, bare module import only), those constructors are unbound in
// heal_publication → NoSuchVariable. At head (named import present), they
// resolve → true.
test fn sts_exchange_defaults_resolve_in_heal_publication_scope() -> Bool {
  sts_exchange_defaults_resolve()
}
