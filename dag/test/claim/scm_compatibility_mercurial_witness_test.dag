module test.claim.scm_compatibility_mercurial_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn mercurial_fixture_observation() -> extdeps.mercurial.MercurialReadBackObservation {
  extdeps.mercurial.MercurialReadBackObservation {
    projection: test.claim.mercurial_upstream_model_witness.mercurial_r0_fixture_projection(),
    observed_by: "mercurial-r1-independent-fixture",
  }
}

fn mercurial_fixture_binding() -> gunbc.scm_compatibility.mercurial.MercurialCompatibilityBindingOutcome {
  gunbc.scm_compatibility.mercurial.mercurial_compatibility_bind(
    projection: test.claim.mercurial_upstream_model_witness.mercurial_r0_fixture_projection(),
    target: "default",
    read_back: mercurial_fixture_observation(),
  )
}

test fn witness_mercurial_r1_consumes_native_projection_and_readback() -> Bool {
  match mercurial_fixture_binding() {
    gunbc.scm_compatibility.mercurial.MercurialCompatibilityBindingRefused { cause: _ } => false
    gunbc.scm_compatibility.mercurial.MercurialCompatibilityBound { receipt } =>
      receipt.target == "default"
        && count(receipt.portable_history) == 3
        && count(receipt.target_history) == 3
        && match gunbc.scm_compatibility.mercurial.mercurial_compatibility_projection_receipt(
          receipt: receipt,
        ).advance {
          gunbc.scm_compatibility_shape.CompatibilityAdvanceUnavailable { cause: _ } => true
          _ => false
        }
  }
}

test fn witness_mercurial_realization_preserves_c0_primary_behavior() -> Bool {
  let original = test.claim.native_scm_interaction_scenario_fixture.native_scm_receipt_for(
    scenario: test.claim.native_scm_interaction_scenario_fixture.TwoIndependentChangesLand,
  )
  match mercurial_fixture_binding() {
    gunbc.scm_compatibility.mercurial.MercurialCompatibilityBindingRefused { cause: _ } => false
    gunbc.scm_compatibility.mercurial.MercurialCompatibilityBound { receipt } => {
      let projection = gunbc.scm_compatibility_shape.compatibility_projection_from_handler(
        handler: gunbc.scm_compatibility.mercurial.mercurial_compatibility_projection_handler(),
        receipt: receipt,
      )
      let attached = gunbc.native_scm_interaction_contract.native_scm_attach_projection(
        receipt: original,
        projection: projection,
      )
      attached.identity == original.identity
        && attached.transition == original.transition
        && attached.primary == original.primary
        && gunbc.native_scm_interaction_contract.native_scm_primary_label(primary: attached.primary) == "Landed"
        && projection.realization == "mercurial-r0"
    }
  }
}

test fn witness_mercurial_missing_advance_refuses_required_capability() -> Bool {
  match mercurial_fixture_binding() {
    gunbc.scm_compatibility.mercurial.MercurialCompatibilityBindingRefused { cause: _ } => false
    gunbc.scm_compatibility.mercurial.MercurialCompatibilityBound { receipt } => {
      let capability = gunbc.scm_compatibility.mercurial.mercurial_compatibility_projection_receipt(
        receipt: receipt,
      ).advance
      match gunbc.scm_compatibility_shape.compatibility_check_advance_requirement(
        requirement: gunbc.scm_compatibility_shape.CompatibilityObservationOnly,
        observed: capability,
      ) {
        gunbc.scm_compatibility_shape.CompatibilityCapabilitySatisfied =>
          match gunbc.scm_compatibility_shape.compatibility_check_advance_requirement(
            requirement: gunbc.scm_compatibility_shape.CompatibilityModeledAdvanceRequired {
              guarantee: gunbc.scm_compatibility_shape.CompatibilityExactCompareAndAdvance,
            },
            observed: capability,
          ) {
            gunbc.scm_compatibility_shape.CompatibilityCapabilityRefused {
              requirement: _,
              observed: _,
            } => true
            gunbc.scm_compatibility_shape.CompatibilityCapabilitySatisfied => false
          }
        gunbc.scm_compatibility_shape.CompatibilityCapabilityRefused {
          requirement: _,
          observed: _,
        } => false
      }
    }
  }
}

test fn witness_mercurial_history_does_not_claim_authored_operation() -> Bool {
  match mercurial_fixture_binding() {
    gunbc.scm_compatibility.mercurial.MercurialCompatibilityBindingRefused { cause: _ } => false
    gunbc.scm_compatibility.mercurial.MercurialCompatibilityBound { receipt } => {
      let profile = gunbc.scm_compatibility.mercurial.mercurial_compatibility_projection_receipt(
        receipt: receipt,
      ).fidelity
      match profile.upstream_change_evidence {
        gunbc.scm_compatibility_shape.CompatibilityFidelityDowngraded { cause: _ } => true
        _ => false
      }
    }
  }
}

test fn witness_mercurial_unavailable_readback_refuses_binding() -> Bool {
  match gunbc.scm_compatibility.mercurial.mercurial_compatibility_bind(
    projection: test.claim.mercurial_upstream_model_witness.mercurial_r0_fixture_projection(),
    target: "default",
    read_back: extdeps.mercurial.MercurialReadBackObservation {
      projection: extdeps.mercurial.MercurialInaccessibleProjection {
        reason: "fixture unavailable",
      },
      observed_by: "mercurial-r1-independent-fixture",
    },
  ) {
    gunbc.scm_compatibility.mercurial.MercurialCompatibilityBindingRefused { cause: _ } => true
    gunbc.scm_compatibility.mercurial.MercurialCompatibilityBound { receipt: _ } => false
  }
}

test fn witness_mercurial_readback_identity_changes_with_observed_state() -> Bool {
  let other_projection = test.claim.mercurial_upstream_model_witness.projection_with_publishing(
    projection: test.claim.mercurial_upstream_model_witness.mercurial_r0_fixture_projection(),
    publishing: extdeps.mercurial.MercurialPublishingServer,
  )
  match mercurial_fixture_binding() {
    gunbc.scm_compatibility.mercurial.MercurialCompatibilityBindingRefused { cause: _ } => false
    gunbc.scm_compatibility.mercurial.MercurialCompatibilityBound { receipt: expected } =>
      match gunbc.scm_compatibility.mercurial.mercurial_compatibility_bind(
        projection: other_projection,
        target: "default",
        read_back: extdeps.mercurial.MercurialReadBackObservation {
          projection: other_projection,
          observed_by: "mercurial-r1-independent-fixture",
        },
      ) {
        gunbc.scm_compatibility.mercurial.MercurialCompatibilityBindingRefused { cause: _ } => false
        gunbc.scm_compatibility.mercurial.MercurialCompatibilityBound { receipt: other_state } => {
          let expected_projection = gunbc.scm_compatibility.mercurial.mercurial_compatibility_projection_receipt(
            receipt: expected,
          )
          let other_state_projection = gunbc.scm_compatibility.mercurial.mercurial_compatibility_projection_receipt(
            receipt: other_state,
          )
          expected_projection.generation_evidence == other_state_projection.generation_evidence
            && expected_projection.read_back != other_state_projection.read_back
            && expected_projection.projection != other_state_projection.projection
        }
      }
  }
}
