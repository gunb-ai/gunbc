module test.claim.ci_floor_on_success_materialization_receipt_hand_rust_witness

import gunbc.ci_materialization {
  ci_floor_on_success_materialization_receipt_path,
  ci_floor_on_success_materialization_receipt_claim_executor_seed_disposition,
  ci_floor_on_success_materialization_receipt_claim_executor_seed_note,
}
import std.disposition { Scaffold, SingleAuthority }
import std.types { Bool, String }

data ci_floor_on_success_materialization_receipt_hand_rust_witness_note: String = "HAND-RUST checkable receipt for #7499 blocker 6: pins the seed-retained scaffold bind to ci_floor_on_success_materialization_receipt_path and the attempt-scoped receipt path constant. Behavioral population separation (ordinary vs on-success) is cross-checked by cargo test on_success_materialization_receipt_separates_from_ordinary_floor in claim_executor.rs (serialized on PROCESS_EVAL_RECOMPUTE_TEST_LOCK). Dissolve-on: emitted claim_executor when the stage0 host bin crosses the self-host frontier (DESIGN §7), same trigger as ci_floor_materialization_receipt_note."

test fn scaffold_is_seed_retained_on_path_authority() -> Bool {
  match ci_floor_on_success_materialization_receipt_claim_executor_seed_disposition {
    Scaffold { dissolves_to: SingleAuthority, bind: _ } => true
    _ => false
  }
}

test fn attempt_scoped_path_names_attempt_id() -> Bool {
  ci_floor_on_success_materialization_receipt_path ==
    "target/floor-attempt-<attempt_id>/floor-on-success-materialization-receipt.txt"
}

test fn seed_note_is_non_empty() -> Bool {
  !(ci_floor_on_success_materialization_receipt_claim_executor_seed_note == "")
}
