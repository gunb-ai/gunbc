module test.claim.npm_sri_witness_test

import std.types { NonEmptyStr, Bool, String }
import std.content_hash {
  ContentHash,
  compare_content_hash,
  ContentHashEqual,
  ContentHashDifferent,
  ContentHashCrossFamilyIncomparable,
  content_hash_of_value,
}
import extdeps.npm { npm_subresource_integrity_sha512_base64 }

data witness_note: String = "Measured npm SRI from docs/probes/provider_interface_acquisition_2026-08-03.json @anthropic-ai/claude-agent-sdk — not a tree-copied oracle."

data claude_agent_sdk_integrity: String = "sha512-glc7SdwPkOkLw8oxwLo9PKTdLJGqW/PIR4urWXFoRtX9YllwozsEVc5Tc1+EvLSkfrsxPJqQWqOgpjUOQXf1oA=="

test fn npm_sri_parses_measured_claude_agent_sdk_integrity() -> Bool {
  match npm_subresource_integrity_sha512_base64(wire: claude_agent_sdk_integrity) {
    Present { value: hash } =>
      match hash {
        Sha512Hash(_) => true
        Fnv1a64(_) => false
        Sha256Hash(_) => false
        Sha1Hash(_) => false
      }
    Absent => false
  }
}

test fn npm_sri_refuses_structural_expectation() -> Bool {
  match npm_subresource_integrity_sha512_base64(wire: claude_agent_sdk_integrity) {
    Present { value: parsed } =>
      match compare_content_hash(
        left: parsed,
        right: content_hash_of_value(value: "not-a-digest" as NonEmptyStr),
      ) {
        ContentHashCrossFamilyIncomparable => true
        ContentHashEqual => false
        ContentHashDifferent => false
      }
    Absent => false
  }
}

test fn npm_sri_refuses_wrong_prefix() -> Bool {
  match npm_subresource_integrity_sha512_base64(wire: "sha256-deadbeef") {
    Present { value: _ } => false
    Absent => true
  }
}

test fn npm_sri_roundtrip_is_stable() -> Bool {
  match npm_subresource_integrity_sha512_base64(wire: claude_agent_sdk_integrity) {
    Present { value: a } =>
      match npm_subresource_integrity_sha512_base64(wire: claude_agent_sdk_integrity) {
        Present { value: b } =>
          match compare_content_hash(left: a, right: b) {
            ContentHashEqual => true
            ContentHashDifferent => false
            ContentHashCrossFamilyIncomparable => false
          }
        Absent => false
      }
    Absent => false
  }
}
