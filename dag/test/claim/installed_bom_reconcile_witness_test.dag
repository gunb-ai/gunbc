module test.claim.installed_bom_reconcile_witness_test

import std.types { Bool, Int, List, NonEmptyStr }
import product.placement_supply { HostIdentity }
import product.installed_bom_reconcile {
  AtPopulationGrain,
  AtSlot,
  DimmCountDiffers,
  DimmCountMatches,
  DimmObservationAbsent,
  DimmObservationHostMismatch,
  DimmPopulationConfirmed,
  DimmPopulationObserved,
  DimmPopulationRefused,
  DimmPopulationUnconfirmed,
  DimmSlotLocator,
  DimmSlotsObserved,
  HostDimmExpectation,
  HostProcessorExpectation,
  ObservedDimmCataloged,
  ObservedDimmSlot,
  ObservedDimmUncataloged,
  ProcessorModelConfirmed,
  ProcessorModelObserved,
  ProcessorModelRefused,
  ProcessorModelUnconfirmed,
  ProcessorObservationAbsent,
  ProcessorObservationHostMismatch,
  dimm_discrepancy_report,
  dimm_reconcile_verdict,
  dimm_refusal_is_grounded,
  dimm_verdict_is_confirmed,
  processor_reconcile_verdict,
  processor_verdict_is_confirmed,
}
import extdeps.memory.types { MemoryPopulationRow }
import extdeps.memory.sk_hynix { hma82gr7afr4n_vk_catalog, hma82gr7afr8n_vk_catalog }
import extdeps.memory.samsung { m386a4g40dm0_cpb_catalog }
import extdeps.cpu.ampere { altra_max_m12830_catalog, altra_q6430_catalog }
import gunbc.fleet_physical_inventory {
  fleet_dimm_verdicts,
  fleet_processor_verdicts,
  srv1_dimm_observation,
  srv3_dimm_observation,
  srv4_dimm_observation,
}

data w_host_a: HostIdentity = "srv1" as HostIdentity
data w_host_b: HostIdentity = "srv2" as HostIdentity

fn uniform_expectation(host: HostIdentity, count: Int) -> HostDimmExpectation {
  HostDimmExpectation { host: host, catalog: hma82gr7afr4n_vk_catalog, stick_count: count }
}

fn cataloged_slot(locator: NonEmptyStr, part_is_expected: Bool) -> ObservedDimmSlot {
  ObservedDimmSlot {
    locator: locator as DimmSlotLocator,
    identity: if part_is_expected {
      ObservedDimmCataloged { catalog: hma82gr7afr4n_vk_catalog }
    } else {
      ObservedDimmCataloged { catalog: hma82gr7afr8n_vk_catalog }
    },
    serial: none,
  }
}

// LIVE SPECIMEN, NOT A FIXTURE. srv1's 2026-07-16 BMC population is eight sticks of the expected
// part, so the fleet's own first row confirms.
test fn srv1_live_population_confirms_the_expectation() -> Bool {
  match dimm_reconcile_verdict(
    expectation: uniform_expectation(host: w_host_a, count: 8),
    observation: srv1_dimm_observation,
  ) {
    DimmPopulationConfirmed { host: _, stick_count: n } => n == 8
    DimmPopulationRefused { host: _, discrepancies: _, count: _ } => false
    DimmObservationHostMismatch { expectation_host: _, observation_host: _ } => false
    DimmPopulationUnconfirmed { host: _, cause: _ } => false
  }
}

// THE REFUSAL FIRES ON REAL DATA. srv3's observed population is seven HMA82GR7AFR8N-VK plus one
// HMA82GR7AFR4N-VK against a uniform AFR4N expectation, so exactly ONE row differs, it is located
// at population grain because the BMC reported no slot, and the stick total still matches — which
// is the discrimination this witness exists for: a refusal whose count axis says Matches proves
// the part axis alone produced it.
test fn srv3_live_population_refuses_with_a_located_part_difference() -> Bool {
  match dimm_reconcile_verdict(
    expectation: HostDimmExpectation {
      host: "srv3" as HostIdentity,
      catalog: hma82gr7afr4n_vk_catalog,
      stick_count: 8,
    },
    observation: srv3_dimm_observation,
  ) {
    DimmPopulationRefused { host: _, discrepancies, count } => {
      let one = discrepancies.length() == 1
      let counted = match count {
        DimmCountMatches { count: n } => n == 8
        DimmCountDiffers { expected: _, observed: _ } => false
      }
      let located = match discrepancies.first() {
        Absent => false
        Present { value: d } =>
          d.expected_part == hma82gr7afr4n_vk_catalog.part_number
            && match d.observed {
              ObservedDimmCataloged { catalog: c } => c.part_number == hma82gr7afr8n_vk_catalog.part_number
              ObservedDimmUncataloged { part_number: _ } => false
            }
            && match d.location {
              AtPopulationGrain => true
              AtSlot { locator: _ } => false
            }
      }
      one && counted && located
    }
    DimmPopulationConfirmed { host: _, stick_count: _ } => false
    DimmObservationHostMismatch { expectation_host: _, observation_host: _ } => false
    DimmPopulationUnconfirmed { host: _, cause: _ } => false
  }
}

// EVERY DIFFERING SLOT IS REPORTED, NOT THE FIRST. Two of four slots carry the wrong part; a fold
// that stopped early would report one, and this claim asserts the exact number and both locators.
test fn every_differing_slot_appears_in_the_report() -> Bool {
  match dimm_reconcile_verdict(
    expectation: uniform_expectation(host: w_host_a, count: 4),
    observation: DimmSlotsObserved {
      host: w_host_a,
      slots: [
        cataloged_slot(locator: "DIMM_A1", part_is_expected: true),
        cataloged_slot(locator: "DIMM_B1", part_is_expected: false),
        cataloged_slot(locator: "DIMM_E1", part_is_expected: true),
        cataloged_slot(locator: "DIMM_F1", part_is_expected: false),
      ],
    },
  ) {
    DimmPopulationRefused { host: _, discrepancies, count } =>
      discrepancies.length() == 2
        && match count {
          DimmCountMatches { count: n } => n == 4
          DimmCountDiffers { expected: _, observed: _ } => false
        }
        && match discrepancies.first() {
          Absent => false
          Present { value: d } =>
            match d.location {
              AtSlot { locator: l } => l == ("DIMM_B1" as DimmSlotLocator)
              AtPopulationGrain => false
            }
        }
        && match discrepancies.skip(n: 1).first() {
          Absent => false
          Present { value: d } =>
            match d.location {
              AtSlot { locator: l } => l == ("DIMM_F1" as DimmSlotLocator)
              AtPopulationGrain => false
            }
        }
    DimmPopulationConfirmed { host: _, stick_count: _ } => false
    DimmObservationHostMismatch { expectation_host: _, observation_host: _ } => false
    DimmPopulationUnconfirmed { host: _, cause: _ } => false
  }
}

// An observed part with no catalog row is a grounding obligation and refuses. It must not be
// silently skipped, and it must not be reported as a part difference either, so the arm is asserted
// by constructor and not merely by the discrepancy count.
test fn an_uncataloged_observed_part_refuses() -> Bool {
  match dimm_reconcile_verdict(
    expectation: uniform_expectation(host: w_host_a, count: 1),
    observation: DimmSlotsObserved {
      host: w_host_a,
      slots: [
        ObservedDimmSlot {
          locator: "DIMM_A1" as DimmSlotLocator,
          identity: ObservedDimmUncataloged { part_number: "MTA36ASF8G72PZ-3G2R" },
          serial: none,
        },
      ],
    },
  ) {
    DimmPopulationRefused { host: _, discrepancies, count: _ } =>
      discrepancies.length() == 1
        && match discrepancies.first() {
          Absent => false
          Present { value: d } =>
            match d.observed {
              ObservedDimmUncataloged { part_number: p } => p == "MTA36ASF8G72PZ-3G2R"
              ObservedDimmCataloged { catalog: _ } => false
            }
        }
    DimmPopulationConfirmed { host: _, stick_count: _ } => false
    DimmObservationHostMismatch { expectation_host: _, observation_host: _ } => false
    DimmPopulationUnconfirmed { host: _, cause: _ } => false
  }
}

// The count axis alone can refuse: every observed part is the expected one, so the discrepancy list
// is EMPTY and only the count differs. Asserting the empty list is what distinguishes this from the
// part-difference refusal above.
test fn a_short_population_of_the_right_part_refuses_on_count_alone() -> Bool {
  match dimm_reconcile_verdict(
    expectation: uniform_expectation(host: w_host_a, count: 8),
    observation: DimmPopulationObserved {
      host: w_host_a,
      rows: [MemoryPopulationRow { module: hma82gr7afr4n_vk_catalog, stick_count: 6 }],
    },
  ) {
    DimmPopulationRefused { host: _, discrepancies, count } =>
      discrepancies.length() == 0
        && match count {
          DimmCountDiffers { expected: e, observed: o } => e == 8 && o == 6
          DimmCountMatches { count: _ } => false
        }
    DimmPopulationConfirmed { host: _, stick_count: _ } => false
    DimmObservationHostMismatch { expectation_host: _, observation_host: _ } => false
    DimmPopulationUnconfirmed { host: _, cause: _ } => false
  }
}

// An observation of a DIFFERENT host cannot answer for this one. Without this arm the fold would
// reconcile srv2's sticks against srv1's expectation and report a confident verdict about a host
// nobody read.
test fn an_observation_of_another_host_refuses() -> Bool {
  match dimm_reconcile_verdict(
    expectation: uniform_expectation(host: w_host_a, count: 8),
    observation: DimmPopulationObserved {
      host: w_host_b,
      rows: [MemoryPopulationRow { module: hma82gr7afr4n_vk_catalog, stick_count: 8 }],
    },
  ) {
    DimmObservationHostMismatch { expectation_host: e, observation_host: o } => e == w_host_a && o == w_host_b
    DimmPopulationConfirmed { host: _, stick_count: _ } => false
    DimmPopulationRefused { host: _, discrepancies: _, count: _ } => false
    DimmPopulationUnconfirmed { host: _, cause: _ } => false
  }
}

// AN UNOBSERVED HOST STAYS UNOBSERVED. srv4 has no read at either grain, and the verdict must be
// neither a pass nor a refusal — a pass would zero the observation deficit's frequency by
// construction, and a refusal would accuse hardware nobody has looked at.
test fn srv4_unobserved_reaches_neither_confirmed_nor_refused() -> Bool {
  match dimm_reconcile_verdict(
    expectation: HostDimmExpectation {
      host: "srv4" as HostIdentity,
      catalog: hma82gr7afr4n_vk_catalog,
      stick_count: 8,
    },
    observation: srv4_dimm_observation,
  ) {
    DimmPopulationUnconfirmed { host: h, cause: _ } => h == ("srv4" as HostIdentity)
    DimmPopulationConfirmed { host: _, stick_count: _ } => false
    DimmPopulationRefused { host: _, discrepancies: _, count: _ } => false
    DimmObservationHostMismatch { expectation_host: _, observation_host: _ } => false
  }
}

// A confirmed population contributes nothing to the report, so the report's length counts real
// contradictions only. Over the four live fleet verdicts that is exactly srv3's single row: srv1
// and srv2 confirm and srv4 is unobserved, so a report of any other length would mean silence had
// leaked into it.
test fn the_fleet_report_carries_exactly_the_live_contradiction() -> Bool {
  dimm_discrepancy_report(verdicts: fleet_dimm_verdicts).length() == 1
}

// Every verdict the fold produces is grounded: no refusal names an empty discrepancy list with a
// matching count. Asserted over the live fleet AND over a constructed contradiction so the claim
// is not carried by a population that happens to contain no refusal.
test fn every_fold_produced_verdict_is_grounded() -> Bool {
  let live = fleet_dimm_verdicts.length() == 4
    && all(fleet_dimm_verdicts, v => dimm_refusal_is_grounded(verdict: v))
  let constructed = dimm_refusal_is_grounded(
    verdict: dimm_reconcile_verdict(
      expectation: uniform_expectation(host: w_host_a, count: 2),
      observation: DimmPopulationObserved {
        host: w_host_a,
        rows: [MemoryPopulationRow { module: m386a4g40dm0_cpb_catalog, stick_count: 2 }],
      },
    ),
  )
  live && constructed
}

test fn confirmation_predicate_separates_the_two_live_hosts() -> Bool {
  dimm_verdict_is_confirmed(
    verdict: dimm_reconcile_verdict(
      expectation: uniform_expectation(host: w_host_a, count: 8),
      observation: srv1_dimm_observation,
    ),
  ) && !dimm_verdict_is_confirmed(
    verdict: dimm_reconcile_verdict(
      expectation: HostDimmExpectation {
        host: "srv3" as HostIdentity,
        catalog: hma82gr7afr4n_vk_catalog,
        stick_count: 8,
      },
      observation: srv3_dimm_observation,
    ),
  )
}

// --- processor half --------------------------------------------------------------------------

test fn an_observed_matching_processor_model_confirms() -> Bool {
  match processor_reconcile_verdict(
    expectation: HostProcessorExpectation { host: w_host_a, catalog: altra_max_m12830_catalog },
    observation: ProcessorModelObserved { host: w_host_a, model_number: "M128-30" },
  ) {
    ProcessorModelConfirmed { host: _, model_number: m } => m == "M128-30"
    ProcessorModelRefused { host: _, expected: _, observed: _ } => false
    ProcessorObservationHostMismatch { expectation_host: _, observation_host: _ } => false
    ProcessorModelUnconfirmed { host: _, cause: _ } => false
  }
}

// The RED that settles the stale fleet-processor claim: if a host actually reported Q64-30, the
// reconciliation names both models rather than quietly accepting either.
test fn an_observed_q64_30_refuses_against_the_m128_30_expectation() -> Bool {
  match processor_reconcile_verdict(
    expectation: HostProcessorExpectation { host: w_host_a, catalog: altra_max_m12830_catalog },
    observation: ProcessorModelObserved { host: w_host_a, model_number: altra_q6430_catalog.model_number },
  ) {
    ProcessorModelRefused { host: _, expected: e, observed: o } => e == "M128-30" && o == "Q64-30"
    ProcessorModelConfirmed { host: _, model_number: _ } => false
    ProcessorObservationHostMismatch { expectation_host: _, observation_host: _ } => false
    ProcessorModelUnconfirmed { host: _, cause: _ } => false
  }
}

test fn a_processor_observation_of_another_host_refuses() -> Bool {
  match processor_reconcile_verdict(
    expectation: HostProcessorExpectation { host: w_host_a, catalog: altra_max_m12830_catalog },
    observation: ProcessorModelObserved { host: w_host_b, model_number: "M128-30" },
  ) {
    ProcessorObservationHostMismatch { expectation_host: e, observation_host: o } => e == w_host_a && o == w_host_b
    ProcessorModelConfirmed { host: _, model_number: _ } => false
    ProcessorModelRefused { host: _, expected: _, observed: _ } => false
    ProcessorModelUnconfirmed { host: _, cause: _ } => false
  }
}

// All four fleet hosts stand unconfirmed on the processor axis, because the fleet processor is
// modeled intent and no host has been read. This is the claim that would go green the moment a
// dmidecode receipt lands, so it is stated as an exact count rather than as an existence check.
test fn every_fleet_processor_verdict_is_unconfirmed_today() -> Bool {
  fleet_processor_verdicts.length() == 4
    && all(fleet_processor_verdicts, v => !processor_verdict_is_confirmed(verdict: v))
}
