module test.claim.generic_coproduct_return_argument_witness

import gunbc.compile_diagnostic_census {
  CensusObserved,
  CensusNotRunnable,
  census_rows_of_class,
  census_total_count
}
import std.types { String, Bool, Int }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

fn mismatch_count(source: String) -> Int {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: rows } => census_total_count(rows: census_rows_of_class(rows: rows, wanted: "TypeMismatch"))
    CensusNotRunnable { cause: _ } => 0 - 1
  }
}

// gunbc#12432: helpers declared `-> Outcome<Node>` returned an Outcome over a different record and
// nothing refused, because v1.compiler.infer_types declared_type_conformance_diags compared a
// generic coproduct application by nothing. The RED and the positive control differ only in the
// argument the body instantiates, so the census's corpus term cancels in the comparison.
data return_argument_red_source: String = "module probe_generic_coproduct_return_red\nimport std.types { Int, String }\ntype Alpha { a: Int }\ntype Beta { b: String }\ntype Result<T> = Good { value: T } | Bad { reason: String }\nfn make_beta() -> Result<Beta> { Good { value: Beta { b: \"x\" } } }\nfn probe() -> Result<Alpha> { make_beta() }\n"

data return_argument_positive_source: String = "module probe_generic_coproduct_return_ok\nimport std.types { Int, String }\ntype Alpha { a: Int }\ntype Beta { b: String }\ntype Result<T> = Good { value: T } | Bad { reason: String }\nfn make_alpha() -> Result<Alpha> { Good { value: Alpha { a: 1 } } }\nfn probe() -> Result<Alpha> { make_alpha() }\n"

test fn w_distinct_argument_of_one_generic_coproduct_at_return_refuses() -> Bool {
  let ok = mismatch_count(source: return_argument_positive_source)
  ok >= 0 && mismatch_count(source: return_argument_red_source) > ok
}

// A type VARIABLE argument is not a disagreement: a generic fn returning its own parameter's
// instantiation must stay admitted.
data return_argument_type_variable_source: String = "module probe_generic_coproduct_return_var\nimport std.types { Int, String }\ntype Result<T> = Good { value: T } | Bad { reason: String }\nfn wrap<T>(v: T) -> Result<T> { Good { value: v } }\n"

test fn w_matching_and_type_variable_arguments_at_return_are_admitted() -> Bool {
  mismatch_count(source: return_argument_positive_source)
    == mismatch_count(source: return_argument_type_variable_source)
}
