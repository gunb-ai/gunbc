module test.claim.guarantee_stall_witness

import std.types { String, Bool }
import gunbc.guarantee_rung {
  OutsideTheLadder, Mitigatable, MechanicallyPreventable,
  StructurallyGuaranteed, StructurallyImpossible, guarantee_rung_index,
}
import gunbc.guarantee_stall { GuaranteeStall, BoundedPopulation, UncountedNotEnumerable, stall_is_below_ceiling, stall_report_message, every_stall_is_below_its_ceiling, every_stall_names_a_trigger, stall_roster_size, NextRungTrigger, climbs_when, climbs_when_awaiting, stall_trigger_admission, every_stall_trigger_is_admitted }
import gunbc.rung_climb { AwaitsOneGrounding, ClimbableButUnbuilt, TriggerAdmission, TriggerAdmitted, TriggerCapabilityEmpty, TriggerCapabilitySpellsAReferent, GroundingUndeclared, GroundingDeclared }
import std.types { List, NonEmptyStr }
import std.algebra { fold_list, length }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import gunbc.ci.ci_layer_roots { witness_layer_roots }
import v2.std.decl_ref_resolution_host { cited_declaration_ref_refusal_count_live }
import gunbc.lifecycle_bounded_referent { dashboard_work_item_referent }
import gunbc.roadmap.roadmap_model { RoadmapNodeId }
import gunbc.guarantee_stall.next_rung_trigger_enforcement_stall { next_rung_trigger_enforcement_stall }
import gunbc.guarantee_stall.roster {
  all_guarantee_stalls, restored_stalls, every_restored_stall_is_rostered_once,
}

// Local one-liner over the builtin rather than an import: three test files already declare their
// own `string_contains`, so a fourth would make the bare name ambiguous corpus-wide. This is a
// witness's incidental helper, not a shared authority, and it is named distinctly for that reason.
fn contains_text(haystack: String, needle: String) -> Bool {
  haystack.contains(needle)
}

// A CONTROL STALL DIFFERING FROM THE LIVE ROW IN EVERY DECIDED FIELD, for the reason the control
// drop above gives: a renderer that ignored its argument, or a predicate that answered a constant,
// would agree with the live row and go unseen.
data control_stall: GuaranteeStall = GuaranteeStall {
  subject: "control.stall.subject",
  current: StructurallyGuaranteed,
  ceiling: StructurallyGuaranteed,
  blocker: AwaitsOneGrounding { grounding: GroundingUndeclared },
  population: BoundedPopulation { members: ["control.stall.member"] },
  next_rung_trigger: climbs_when(capability: "control stall trigger")
}

// THE BLOCKER FOLD READS THE ARM, in both directions. A stall is below its ceiling by definition, so
// "cannot climb further" is not an arm here (gunbc.rung_climb ClimbBlocker): the control is the
// grounding arm and the live row the unbuilt arm, and a fold stuck at either constant is a
// different defect, so one assertion sees only one of them.
test fn stall_blocker_fold_follows_the_arm() -> Bool {
  match control_stall.blocker {
    ClimbableButUnbuilt => false
    AwaitsOneGrounding { grounding: _ } => true
  } && match next_rung_trigger_enforcement_stall.blocker {
    ClimbableButUnbuilt => true
    AwaitsOneGrounding { grounding: _ } => false
  }
}

// THE LIVE ROW IS BELOW ITS CEILING AND THE CONTROL IS NOT. This is the assertion that makes the
// live row a stall rather than a class that already arrived: if it is ever edited so that current
// equals ceiling, the row stops describing a stall and this reds.
test fn live_stall_is_below_its_ceiling() -> Bool {
  stall_is_below_ceiling(s: next_rung_trigger_enforcement_stall)
    && !stall_is_below_ceiling(s: control_stall)
}


// AN UNCOUNTED POPULATION RENDERS AS UNCOUNTED, NEVER AS EMPTY. This is the discriminating claim
// against the empty-observation narrow: a renderer that folded UncountedNotEnumerable through the
// same path as a bounded list would emit nothing here and the stall would read as affecting no one.
test fn uncounted_population_does_not_render_as_empty() -> Bool {
  let live = stall_report_message(s: next_rung_trigger_enforcement_stall)
  let ctl = stall_report_message(s: control_stall)
  contains_text(haystack: live, needle: "UNCOUNTED, not enumerable")
    && !contains_text(haystack: ctl, needle: "UNCOUNTED, not enumerable")
    && contains_text(haystack: ctl, needle: "control.stall.member")
}

// THE REPORT READS ITS ARGUMENT AND CARRIES THE ROW'S OWN TRIGGER. The trigger half is the point of
// the carrier: if the required field is ever emptied or the renderer stops projecting it, the fact
// section 4b(2) obliges becomes invisible again and this reds.
test fn stall_report_names_subject_and_trigger() -> Bool {
  let live = stall_report_message(s: next_rung_trigger_enforcement_stall)
  let ctl = stall_report_message(s: control_stall)
  contains_text(haystack: live, needle: "DESIGN section 4b(2) next-rung trigger enforcement")
    && contains_text(haystack: live, needle: "GuaranteeStall rather than in prose")
    && contains_text(haystack: live, needle: "climbable now but unbuilt")
    && !contains_text(haystack: live, needle: "control.stall.subject")
    && !contains_text(haystack: ctl, needle: "DESIGN section 4b(2)")
}

// THE ROSTER FOLD IS WHAT MAKES EVERY ROW LOAD-BEARING, and it is the repair for a defect this
// file had since it was written: it exercised ONE stall by name, so every other row in the carrier
// was consumed by nothing. Found in review of the third row and true of the first two all along.
//
// EACH ARM CARRIES ITS OWN DISCRIMINATOR rather than trusting the live roster to be interesting.
// A fold that ignored its argument, or an && that collapsed to a constant, agrees with the live
// roster and is caught by the control list beside it -- which is the same reason the control drop
// at the top of this file exists.
data stall_at_its_ceiling: GuaranteeStall = GuaranteeStall {
  subject: "control.stall.at.ceiling",
  current: StructurallyImpossible,
  ceiling: StructurallyImpossible,
  blocker: ClimbableButUnbuilt,
  population: BoundedPopulation { members: ["control.member"] },
  next_rung_trigger: climbs_when(capability: "control trigger")
}

data stall_missing_its_trigger: GuaranteeStall = GuaranteeStall {
  subject: "control.stall.no.trigger",
  current: Mitigatable,
  ceiling: StructurallyGuaranteed,
  blocker: ClimbableButUnbuilt,
  population: BoundedPopulation { members: ["control.member"] },
  next_rung_trigger: climbs_when(capability: "")
}

// THE LIVE ROSTER PASSES AND A ROSTER CARRYING AN ARRIVED CLASS DOES NOT. A row whose current
// equals its ceiling is not a stall -- it describes work that is finished, and any consumer
// reading it as outstanding reads a false claim.
test fn every_live_stall_is_below_its_ceiling() -> Bool {
  every_stall_is_below_its_ceiling(ss: all_guarantee_stalls)
    && !every_stall_is_below_its_ceiling(ss: [stall_at_its_ceiling])
}

// SECTION 4b(2), MADE DECIDABLE: a class below its ceiling must name its next-rung trigger, so
// that "cannot climb further" stays separable from "unbuilt". An empty trigger is the untracked
// stall the clause forbids, and it reds here instead of surviving review.
test fn every_live_stall_names_a_next_rung_trigger() -> Bool {
  every_stall_names_a_trigger(ss: all_guarantee_stalls)
    && !every_stall_names_a_trigger(ss: [stall_missing_its_trigger])
}

// THE ROSTER IS NOT EMPTY, and this arm is the one that stops the two folds above from being
// satisfiable by DELETION. Both return TRUE on an empty list -- correctly, since the obligation is
// universally quantified -- so a roster that lost its rows would satisfy every other assertion in
// this file while observing nothing. That is the vacuous green DESIGN section 4b names: permanently
// passing, carrying no information, and cited as coverage. Asserting the SIZE is what makes the
// quantifier's domain load-bearing; asserting a property of one named row would not, because a row
// can be well-formed and absent from the roster at the same time.
test fn the_stall_roster_is_not_empty() -> Bool {
  stall_roster_size(ss: all_guarantee_stalls) > 0
    && stall_roster_size(ss: []) == 0
    && every_stall_is_below_its_ceiling(ss: [])
}

// THE FOUR RESTORED SUBJECTS STAY ROSTERED, AND THIS DOES NOT RETIRE WHEN THIS PR LANDS.
//
// Four stalls were declared in gunbc.guarantee_stall and left out of all_guarantee_stalls, so the
// three walls above ranged over 21 of the 25 rows that module declares. Nothing was red: a wall
// whose input is short is green for the same reason a wall over a clean corpus is green. Widening
// the roster is the repair; this arm is what stops the repair from being undone silently, since a
// row dropped from the roster again would restore the green and change no assertion in this file.
//
// WHAT IT COVERS, stated so the coverage is falsifiable rather than assumed: exactly the four named
// subjects, each required to appear EXACTLY ONCE. It does NOT detect a new stall declared and left
// unrostered -- that needs a corpus-wide census of GuaranteeStall declarations, which is a separate
// obligation gated on whether its RED is authorable at all, since a stall declared in a module the
// roster cannot import may not be expressible in any fixture.
//
// THE NEGATIVE ARM IS THE WHOLE POINT: over an empty roster the fold must REFUSE, which is what
// distinguishes this from the universally-quantified walls above that are vacuously true on [].
test fn every_restored_stall_is_still_rostered() -> Bool {
  every_restored_stall_is_rostered_once(ss: all_guarantee_stalls)
    && !every_restored_stall_is_rostered_once(ss: [])
    && every_restored_stall_is_rostered_once(ss: restored_stalls)
}

// THE SECOND DECIDABLE SUB-CASE OF `stale_claim_survives_its_own_correct_edit`, WITH THE RED THAT
// MAKES IT REAL. Four live rows spelled `node://<work item>` into their trigger sentence, so the
// condition a later reader must re-measure and the lane that was asked to deliver it were one
// opaque string -- and the roster's own dated reading records three such lanes reaching done with
// their conditions unmet. The two arms below differ in exactly one property: whether the referent
// sits INSIDE the capability or beside it in `awaiting`. A predicate that answered a constant, or
// one that keyed on the presence of an `awaiting` row rather than on the capability's text, agrees
// with one arm and is caught by the other.
data stall_spelling_a_referent_into_its_capability: GuaranteeStall = GuaranteeStall {
  subject: "control.stall.referent.in.capability",
  current: Mitigatable,
  ceiling: StructurallyGuaranteed,
  blocker: ClimbableButUnbuilt,
  population: BoundedPopulation { members: ["control.member"] },
  next_rung_trigger: climbs_when(capability: "node://adhoc-00000000-000 lands: the control capability arrives")
}

data stall_carrying_its_referent_beside_the_capability: GuaranteeStall = GuaranteeStall {
  subject: "control.stall.referent.beside.capability",
  current: Mitigatable,
  ceiling: StructurallyGuaranteed,
  blocker: ClimbableButUnbuilt,
  population: BoundedPopulation { members: ["control.member"] },
  next_rung_trigger: climbs_when_awaiting(
    capability: "the control capability arrives",
    awaiting: [dashboard_work_item_referent(node: "adhoc-00000000-000" as RoadmapNodeId)],
  )
}

// THE ADMISSION ARM IS ASSERTED BY CAUSE AND NOT BY REFUSAL. A row can refuse for the wrong
// reason -- an empty capability and a capability resting on a lane's ending are different defects
// with different repairs -- so each arm is matched rather than read through a Bool.
test fn a_trigger_resting_on_a_lifecycle_bounded_referent_refuses_by_cause() -> Bool {
  match stall_trigger_admission(s: stall_spelling_a_referent_into_its_capability) {
    TriggerCapabilitySpellsAReferent { subject: _, scheme: sch } => sch == "node://"
    TriggerCapabilityEmpty { subject: _ } => false
    TriggerAdmitted => false
  } && match stall_trigger_admission(s: stall_missing_its_trigger) {
    TriggerCapabilityEmpty { subject: subj } => subj == "control.stall.no.trigger"
    TriggerCapabilitySpellsAReferent { subject: _, scheme: _ } => false
    TriggerAdmitted => false
  } && match stall_trigger_admission(s: stall_carrying_its_referent_beside_the_capability) {
    TriggerAdmitted => true
    TriggerCapabilityEmpty { subject: _ } => false
    TriggerCapabilitySpellsAReferent { subject: _, scheme: _ } => false
  }
}

// THE LIVE ROSTER IS ADMITTED AND A ROSTER CARRYING EITHER DEFECT IS NOT. This is the fold that
// makes the property scale with the population instead of with how many rows an author remembered,
// and it is the arm that would have redded on main against all four unmigrated rows.
test fn every_live_stall_trigger_is_admitted() -> Bool {
  every_stall_trigger_is_admitted(ss: all_guarantee_stalls)
    && !every_stall_trigger_is_admitted(ss: [stall_spelling_a_referent_into_its_capability])
    && !every_stall_trigger_is_admitted(ss: [stall_missing_its_trigger])
    && every_stall_trigger_is_admitted(ss: [stall_carrying_its_referent_beside_the_capability])
}

// THE ASKED LANE SURVIVES INTO THE REPORT, AND ONLY FROM THE FIELD. The migration would be a loss
// if the provenance stopped being readable, so the rendering is asserted in both directions: a row
// with an awaited lane names it, a row without one does not, and the URI comes from the referent's
// own module rather than from a second spelling in the renderer.
test fn the_report_names_the_asked_lane_only_when_one_is_carried() -> Bool {
  let asked = stall_report_message(s: stall_carrying_its_referent_beside_the_capability)
  let unasked = stall_report_message(s: control_stall)
  contains_text(haystack: asked, needle: "[asked: node://adhoc-00000000-000]")
    && contains_text(haystack: asked, needle: "the control capability arrives")
    && !contains_text(haystack: unasked, needle: "[asked:")
}

// A GROUNDING IS A TYPED REFERENCE THAT MUST RESOLVE, not prose beside the trigger capability. The
// capability is carried once, by the trigger (DESIGN section 4b); the blocker can only point at an
// authority, and a pointer to a declaration that does not exist is refused here.
fn stall_grounding_refs(ss: List<GuaranteeStall>) -> List<DeclarationRef> {
  fold_list(
    xs: ss,
    empty: [],
    cons: fn(acc, s) {
      match s.blocker {
        AwaitsOneGrounding { grounding: GroundingDeclared { reference: r } } => concat(acc, [r])
        AwaitsOneGrounding { grounding: GroundingUndeclared } => acc
        ClimbableButUnbuilt => acc
      }
    },
  )
}

test fn every_declared_grounding_of_a_rostered_stall_resolves() -> Bool {
  let refs = stall_grounding_refs(ss: all_guarantee_stalls)
  length(xs: refs) > 0 && cited_declaration_ref_refusal_count_live(refs: refs, pool_roots: witness_layer_roots) == 0
}

test fn a_declared_grounding_naming_no_declaration_is_refused() -> Bool {
  let dangling = GuaranteeStall {
    subject: "control.dangling",
    current: Mitigatable,
    ceiling: StructurallyGuaranteed,
    blocker: AwaitsOneGrounding {
      grounding: GroundingDeclared {
        reference: DeclarationRef { module_path: "std.algebra" as NonEmptyStr, decl_name: "NoSuchDecl_Grounding_RED" as NonEmptyStr, field: WholeDeclaration },
      },
    },
    population: BoundedPopulation { members: ["control"] },
    next_rung_trigger: climbs_when(capability: "control capability arrives"),
  }
  cited_declaration_ref_refusal_count_live(refs: stall_grounding_refs(ss: [dangling]), pool_roots: witness_layer_roots) == 1
}
