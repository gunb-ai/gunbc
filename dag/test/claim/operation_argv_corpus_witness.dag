fn operation_argv_closed_unevaluated_executable_operations() -> List<ArgvClassifiedOperation> {
  list_map(
    xs: match rung_drop_population(d: operation_argv_closed_unevaluated_executable_unjudged) {
      Present { value: Enumerated { members: m } } => non_empty_to_list(xs: m)
      Present { value: DerivedBy { label: _ } } => []
      Present { value: NotYetCounted { cause: _ } } => []
      Absent => []
    },
    f: fn(label) { ArgvClassifiedOperation { operation: label, reason: operation_argv_reason_catalog } }
  )
}

data operation_argv_unbound_data_reference_operations: List<ArgvClassifiedOperation> = [
  ArgvClassifiedOperation { operation: "dag/gunbc/machine_intake/sol_hold.dag gunbc.machine_intake.sol_hold.ActivateHeld", reason: operation_argv_reason_data_ref },
  ArgvClassifiedOperation { operation: "dag/gunbc/machine_intake/sol_hold.dag gunbc.machine_intake.sol_hold.ReleaseHeld", reason: operation_argv_reason_data_ref },
  ArgvClassifiedOperation { operation: "dag/gunbc/owned_process.dag gunbc.owned_process.launch.LaunchOwned", reason: operation_argv_reason_data_ref }
]

data operation_argv_legacy_vocabulary: List<String> = ["package", "bin", "args", "unit", "property"]

data operation_argv_fixture_path: String = "dag/test/fixture/argv_executable_position_probe.dag"

type ArgvCorpusTally {
  rows: Int
  materialized: Int
  expression_residue: Int
  input_reading_executable: Int
  closed_unevaluated_executable: Int
  unbound_data_reference: Int
  other_refusal_not_unbound: Int
  unlisted: Int
  outside_legacy: Int
  outside_legacy_materialized: Int
}

data operation_argv_empty_tally: ArgvCorpusTally = ArgvCorpusTally {
  rows: 0,
  materialized: 0,
  expression_residue: 0,
  input_reading_executable: 0,
  closed_unevaluated_executable: 0,
  unbound_data_reference: 0,
  other_refusal_not_unbound: 0,
  unlisted: 0,
  outside_legacy: 0,
  outside_legacy_materialized: 0
}

fn operation_argv_flag(b: Bool) -> Int {
  if b { 1 } else { 0 }
}

fn operation_argv_name_is_legacy_vocabulary(name: String) -> Bool {
  any(xs: operation_argv_legacy_vocabulary, predicate: fn(v) { v == name })
}

fn operation_argv_row_is_outside_legacy_vocabulary(row: ShellTransportOperationRow) -> Bool {
  any(
    xs: row.argv_input_refs,
    predicate: fn(n) { !operation_argv_name_is_legacy_vocabulary(name: n as String) }
  )
}

fn operation_argv_row_materialization(row: ShellTransportOperationRow) -> ArgvMaterialization {
  shell_materialize_operation_argv(
    row.at.path,
    row.at.service,
    row.at.operation,
    operation_argv_row_bindings(row: row)
  )
}

fn operation_argv_is_listed(list: List<ArgvClassifiedOperation>, label: String) -> Bool {
  any(xs: list, predicate: fn(entry) { entry.operation == label })
}

fn operation_argv_tally_row(acc: ArgvCorpusTally, row: ShellTransportOperationRow) -> ArgvCorpusTally {
  let m = operation_argv_row_materialization(row: row)
  let classification = operation_argv_row_classify(row: row, m: m)
  let label = operation_argv_ref_label(at: row.at)
  let materialized = match classification { ArgvRowMaterialized => true, ArgvRowExpressionResidue => false, ArgvRowExecutablePositionRefused => false, ArgvRowExecutableClosedUnevaluated => false, ArgvRowOtherRefusal => false }
  let residue = match classification { ArgvRowMaterialized => false, ArgvRowExpressionResidue => true, ArgvRowExecutablePositionRefused => false, ArgvRowExecutableClosedUnevaluated => false, ArgvRowOtherRefusal => false }
  let input_exec = match classification { ArgvRowMaterialized => false, ArgvRowExpressionResidue => false, ArgvRowExecutablePositionRefused => true, ArgvRowExecutableClosedUnevaluated => false, ArgvRowOtherRefusal => false }
  let catalog = match classification { ArgvRowMaterialized => false, ArgvRowExpressionResidue => false, ArgvRowExecutablePositionRefused => false, ArgvRowExecutableClosedUnevaluated => true, ArgvRowOtherRefusal => false }
  let other = match classification { ArgvRowMaterialized => false, ArgvRowExpressionResidue => false, ArgvRowExecutablePositionRefused => false, ArgvRowExecutableClosedUnevaluated => false, ArgvRowOtherRefusal => true }
  let listed = match classification {
    ArgvRowMaterialized => true
    ArgvRowExpressionResidue => operation_argv_is_listed(list: operation_argv_expression_residue_operations, label: label)
    ArgvRowExecutablePositionRefused => operation_argv_is_listed(list: operation_argv_input_reading_executable_operations, label: label)
    ArgvRowExecutableClosedUnevaluated => operation_argv_is_listed(list: operation_argv_closed_unevaluated_executable_operations(), label: label)
    ArgvRowOtherRefusal => operation_argv_is_listed(list: operation_argv_unbound_data_reference_operations, label: label)
  }
  let other_unbound = other && string_contains(operation_argv_refusal_label(m: m), "=> DeclaredInputUnbound:")
  let outside = operation_argv_row_is_outside_legacy_vocabulary(row: row)
  ArgvCorpusTally {
    rows: acc.rows + 1,
    materialized: acc.materialized + operation_argv_flag(b: materialized),
    expression_residue: acc.expression_residue + operation_argv_flag(b: residue),
    input_reading_executable: acc.input_reading_executable + operation_argv_flag(b: input_exec),
    closed_unevaluated_executable: acc.closed_unevaluated_executable + operation_argv_flag(b: catalog),
    unbound_data_reference: acc.unbound_data_reference + operation_argv_flag(b: other),
    other_refusal_not_unbound: acc.other_refusal_not_unbound + operation_argv_flag(b: other && !other_unbound),
    unlisted: acc.unlisted + operation_argv_flag(b: !listed),
    outside_legacy: acc.outside_legacy + operation_argv_flag(b: outside),
    outside_legacy_materialized: acc.outside_legacy_materialized + operation_argv_flag(b: outside && materialized)
  }
}

fn operation_argv_corpus_tally() -> ArgvCorpusTally {
  fold_list(
    xs: shell_transport_operation_rows(),
    empty: operation_argv_empty_tally,
    cons: fn(acc, row) { operation_argv_tally_row(acc: acc, row: row) }
  )
}

test fn operation_argv_corpus_is_non_vacuous() -> Bool {
  operation_argv_corpus_tally().rows >= 139
}

test fn operation_argv_corpus_every_row_is_materialized_or_counted() -> Bool {
  let t = operation_argv_corpus_tally()
  t.unlisted == 0 && t.other_refusal_not_unbound == 0
}

test fn operation_argv_corpus_tally_is_total() -> Bool {
  let t = operation_argv_corpus_tally()
  (t.materialized + t.expression_residue + t.input_reading_executable + t.closed_unevaluated_executable + t.unbound_data_reference) == t.rows
}

// The identity join: every unmaterialized row is in its class's list (unlisted == 0, in
// every_row_is_materialized_or_counted) and every listed name is a live member (the derived class
// count equals the list length). Counts here are DERIVED from the lists, never a number in this file.
test fn operation_argv_corpus_classified_set_equals_the_named_lists() -> Bool {
  let t = operation_argv_corpus_tally()
  t.unlisted == 0
    && t.expression_residue == length(xs: operation_argv_expression_residue_operations)
    && t.input_reading_executable == length(xs: operation_argv_input_reading_executable_operations)
    && t.closed_unevaluated_executable == length(xs: operation_argv_closed_unevaluated_executable_operations())
    && t.unbound_data_reference == length(xs: operation_argv_unbound_data_reference_operations)
}

// The wall's true scope: it fires on the negative-control fixture plus exactly the named list of
// operations whose argv[0] reads a declared input, each carrying its reason.
// closed-unevaluated executables are NOT in this claim: the wall cannot judge them (declared drop).
test fn operation_argv_corpus_executable_position_wall_fires_on_the_fixture_and_the_named_input_readers() -> Bool {
  let t = operation_argv_corpus_tally()
  t.unlisted == 0
    && t.input_reading_executable == length(xs: operation_argv_input_reading_executable_operations)
    && operation_argv_is_listed(
      list: operation_argv_input_reading_executable_operations,
      label: "dag/test/fixture/argv_executable_position_probe.dag ArgvExecutablePositionProbe.SmuggleExecutable"
    )
}

// Positive control by symbol: a closed-unevaluated row (the bytes of a literal executable are controlled by
// RED_literal_executable_control_materializes; such a row cannot materialize, which is the drop). Its executable is a ProgramIdentity the
// wall cannot judge, so it is classified as such (not as the wall firing on an input).
test fn operation_argv_corpus_closed_unevaluated_row_is_classified_and_not_an_input_reader() -> Bool {
  operation_argv_is_listed(
    list: operation_argv_closed_unevaluated_executable_operations(),
    label: "dag/extdeps/tools/curl.dag curl.HttpSignature.SignedGet"
  ) && !operation_argv_is_listed(
    list: operation_argv_input_reading_executable_operations,
    label: "dag/extdeps/tools/curl.dag curl.HttpSignature.SignedGet"
  )
}

test fn operation_argv_corpus_outside_legacy_vocabulary_now_materializes() -> Bool {
  operation_argv_corpus_tally().outside_legacy_materialized >= 92
}

test fn operation_argv_corpus_outside_legacy_vocabulary_is_the_majority() -> Bool {
  let t = operation_argv_corpus_tally()
  t.outside_legacy >= 96 && (t.outside_legacy + t.outside_legacy) > t.rows
}

test fn operation_argv_corpus_RED_smuggled_executable_is_refused_and_located() -> Bool {
  let label = operation_argv_refusal_label(
    m: shell_materialize_operation_argv(
      operation_argv_fixture_path,
      "ArgvExecutablePositionProbe",
      "SmuggleExecutable",
      [operation_argv_bind_text(name: "bin", text: "/usr/bin/curl")]
    )
  )
  string_contains(label, "ExecutablePositionNotLiteral") && string_contains(label, "ArgvExecutablePositionProbe.SmuggleExecutable")
}

test fn operation_argv_corpus_RED_literal_executable_control_materializes() -> Bool {
  match shell_materialize_operation_argv(
    operation_argv_fixture_path,
    "ArgvExecutablePositionProbe",
    "LiteralExecutable",
    [operation_argv_bind_text(name: "flag", text: "--version")]
  ) {
    ArgvMaterialized { argv: argv } =>
      length(xs: argv) == 2
        && match list_head(xs: argv) {
          Present { value: head } => head == "true"
          Absent => false
        }
    ArgvMaterializationRefused { at: _, cause: _ } => false
  }
}
