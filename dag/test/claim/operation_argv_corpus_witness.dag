module test.claim.operation_argv_corpus_witness
import std.optional { Absent, Optional, Present }


import std.types { String, List, Bool, Int }
import gunbc.rung_drop { rung_drop_population, Enumerated, DerivedBy, NotYetCounted }
import std.algebra { fold_list, length, list_head, list_map, non_empty_to_list }
import gunbc.rung_drop.operation_argv_closed_unevaluated_executable_unjudged { operation_argv_closed_unevaluated_executable_unjudged }
import std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import std.operation_argv {
  ArgvMaterialization,
  ArgvMaterialized,
  ArgvMaterializationRefused,
  ArgvRowClassification,
  ArgvRowMaterialized,
  ArgvRowExpressionResidue,
  ArgvRowExecutablePositionRefused,
  ArgvRowExecutableClosedUnevaluated,
  ArgvRowOtherRefusal,
  operation_argv_row_classify,
  operation_argv_ref_label,
  ShellTransportOperationRow,
  operation_argv_bind_text,
  operation_argv_classify,
  operation_argv_refusal_label,
  operation_argv_row_bindings,
}

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// The RED corpus for argv materializer route (b), DERIVED rather than rostered:
// shell_transport_operation_rows() enumerates every shell-transport operation declared under dag/
// and src/v2/ from the declarations themselves, so a newly authored operation enrolls by existing
// and coverage is a corpus fact rather than a claim (DESIGN 3 and 6 -- a hand roster would be the
// parallel-ledger form of exactly this fact). Each row is bound GENERICALLY: every input the
// operation declares, and nothing else. Row cardinality is the live enumerator
// (shell_transport_operation_rows / ArgvCorpusTally.rows), not a number copied into this note.
// An earlier authoring-time transcription of 141 rows is withdrawn: it was a snapshot, not an
// authority, and it drifted from the enumerator on the same witness (DESIGN 6: name the
// instrument, never transcribe its output).
// Pins below are the executing floor (non-vacuous lower bound, residue count, unexplained == 0),
// not a restated census total. The expression_residue pin is ArgvRowExpressionResidue only.
// Materialization also refuses composed argv (calls and coproduct helpers) on operations that
// this pin does not name; git.Plumbing.ReadTreeIntoIndex is the exemplar. Do not read the residue
// pin as the set of operations whose argv is too composed to compare.
// Argv-list identity cannot be walled as its own merge-blocking witness identity UNDER
// THE CURRENT COST MODEL, in which every claim identity pays its own full-corpus
// rematerialization. DESIGN 4b next-rung, measured: witness_duplicate_authority_pairs_are_well_formed
// hit changed-witness interrupted_before_verdict against the required-floor claim CPU
// deadline (retired 2026-09-12; the claim ceiling is claim_eval_step_budget_for_identity). The obstacle is that second
// rematerialization against that deadline, not the analysis and not the absence of a check.
// Sampling is not a wall. A count or closed roster over pairs is the absorbing fallback.
// Cite claim_batch's [witness] cpu= line against that deadline function; do not copy
// milliseconds into this note. A declaration-only fold over the same enumerator (output
// from-keys, no argv expansion) has been observed under the deadline as its own claim
// identity; that is a different class and does not retire this rung.
// Next-rung trigger (the capability, not an artifact): materialization results shared
// across claim identities, or an argv identity derivable without rematerializing. Either
// makes the wall affordable; writing another witness does not.
// E0S0 is not a defect class. No stdout product plus branchable failure (exit_code,
// stderr) is a legitimate contract; git.Plumbing is the exemplar. Reading the A0B0C0
// empty E0S0 cell as corpus-wide emptiness treats a slice as the table. Browser effect
// operations with output {} (Close, Click, Fill, UploadFile, Screenshot, Wait) are a
// finding for that upstream, not a floor witness.
// A Hamming-1 relation (same program and flags; one position a declaration literal vs a
// generic bound-slot) would catch the class this join cannot see: an operation that bakes
// its parameter in as a literal never shares an argv with the general operation it
// duplicates, so the identity join reports a LOWER BOUND and is blind in the direction of
// the worst offenders -- the more policy an operation hardcodes, the less likely it is to
// join. It is a second named relation, not list identity, not "same policy" (undecidable),
// and was not built. The specimen that motivated it was deleted rather than repaired: it
// had no consumer, so deletion cost nothing the relation would have protected. That
// disposition is why the relation stays unbuilt AND why its absence is not evidence the
// class is empty -- the census found this one by reading the module, not by joining.
// The relation remains blind on composed argv regardless.

// THE UNMATERIALIZED POPULATION IS FOUR NAMED CLASSES, each a symbol-named list below and each
// derived from the declarations at row identity (std.operation_argv operation_argv_row_classify),
// not a count: a count copied from the tree is a change detector (DESIGN 5). A claim joins the
// classified corpus against these lists by identity, so a new unclassified row, a removed member
// and a member that changed class each red.
//  - expression residue: an argv element past position 0 is a call or field access, which
//    materialization does not evaluate (a deficit held constant; dissolves with argv element
//    evaluation over the declaring module's closure in the native v2 materializer).
//  - closed-unevaluated executable: argv[0] reads no declared input and is not evaluated (observed: ProgramIdentity catalog
//    call, moved there by #14174), which the wall cannot judge. LOST COVERAGE, declared as
//    gunbc.rung_drop operation_argv_closed_unevaluated_executable_unjudged, whose population this list projects (one source) as its
//    bounded population.
//  - input-reading executable: argv[0] reads a declared input, so the wall correctly refuses.
//  - unbound data reference: an argv element names a module `data` declaration; the materializer
//    reports it as DeclaredInputUnbound because it only resolves declared inputs.

type ArgvClassifiedOperation {
  operation: String
  reason: String
}

data operation_argv_reason_catalog: String = "argv[0] reads no declared input and is not evaluated (observed: a ProgramIdentity catalog call, extdeps.exec.command / extdeps.exec.program; the callee is not checked); materialization does not evaluate it, so the executable-position wall cannot judge the program"
data operation_argv_reason_residue_call: String = "an argv element after position 0 is a call expression, which materialization binds around but does not evaluate"
data operation_argv_reason_residue_field: String = "an argv element is a field access on a bound input (TransportScript.body), which materialization does not evaluate"
data operation_argv_reason_data_ref: String = "an argv element names a module data declaration, which materialization reads as an unbound declared input"
data operation_argv_reason_env_assignment: String = "argv[0] is an env-assignment expansion over a declared input (GIT_INDEX_FILE=<index> or HOME=<home> inside the executable position); the wall fires correctly, and the assignment belongs in the env binding, not the executable (modeling smell, follow-up)"
data operation_argv_reason_caller_program: String = "argv[0] is the caller-supplied program input by design (general runner); the wall fires correctly"
data operation_argv_reason_interp_path: String = "argv[0] interpolates the declared executable input path; the wall fires correctly"
data operation_argv_reason_fixture: String = "the negative-control fixture whose argv[0] interpolates input `bin`; the wall must fire here"

