module test.claim.cross_pr_contradiction_witness_test

import std.types { Bool, Int, String }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import gunbc.cross_pr_contradiction {
  EveryFileInDiff,
  QuotedDottedName,
  DiffFileHeader,
  DiffAddedLine,
  DiffRemovedLine,
  DiffOtherLine,
  NetAdd,
  NetDelete,
  NetBoth,
  NetAbsent,
  NetDirection,
  PrIdentityDirection,
  PrDiffObservation,
  PrDiffRead,
  PrDiffEmptyDerived,
  PrDiffEmptyCorroborated,
  PrDiffUnobserved,
  DiffEmptyUnderived,
  HeadRefStale,
  changed_identities,
  pr_identity_directions,
  diff_line_class,
  net_direction,
  net_direction_text,
  line_identity_keys,
  cross_pr_contradictions,
  ContradictionReport,
  contradiction_report,
  cross_pr_contradictions,
  KeyMainPresence,
  PresentOnMain,
  AbsentFromMain,
  MainPresenceUnobserved,
  AddSideKeyPresentOnTarget,
  DeleteSideKeyAbsentFromTarget,
  StandingUndecided,
  contradiction_standing,
  contradiction_standing_text,
  line_is_annotation,
  content_identity_keys,
  content_holds_identity,
  diff_line_body,
  contradiction_remedy,
  contradiction_remedy_text,
  ContradictionRemedy,
  RebaseAddingBranch,
  RebaseDeletingBranch,
  RemedyUndecided,
  ContradictionStanding,
  ContradictionRow,
  MainPresence,
  report_undecided,
  contradiction_report_text,
  report_is_complete,
  report_unobserved,
  cross_pr_extraction_rule,
  identity_lookup_pattern
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE DISCRIMINATING FIXTURES FOR THE CROSS-PR CONTRADICTION PREDICATE.
//
// Every subject here is authored in this file. That is deliberate: the live population is the open
// pull requests, which change hourly, so a witness reading them would assert whatever the fleet
// happened to be doing and could not fail on a defect. These fixtures cannot lose their subject.
//
// THE PAIR THAT MATTERS IS THE FIRST TWO. `both directions present on one key` and `two pull
// requests in opposite net directions` agree on the live corpus's positives and disagree on seven
// of the eight the weaker predicate reported. The first witness is that disagreement: a single
// pull request carrying a `+` and a `-` for one key -- an edited or moved line -- must NOT be a
// contradiction, and must still be REPORTED as NetBoth so the evidence for the verdict survives.
// It goes red the moment the predicate is relaxed back to `both directions present`.

data adding_side_diff: String = "--- a/src/v2/workflow/floor_expected_red.dag\n+++ b/src/v2/workflow/floor_expected_red.dag\n+  Cons { head: \"test.fixture.contradiction_alpha.some_claim_holds\", tail: Empty {} }\n"

data deleting_side_diff: String = "--- a/src/v2/workflow/floor_expected_red.dag\n+++ b/src/v2/workflow/floor_expected_red.dag\n-  Cons { head: \"test.fixture.contradiction_alpha.some_claim_holds\", tail: Empty {} }\n"

// One pull request, one key, both directions: the line moved between two chunks.
data moved_line_diff: String = "--- a/src/v2/workflow/floor_expected_red.dag\n+++ b/src/v2/workflow/floor_expected_red.dag\n-  Cons { head: \"test.fixture.contradiction_beta.row_that_only_moved\", tail: Empty {} }\n+  Cons { head: \"test.fixture.contradiction_beta.row_that_only_moved\", tail: Empty {} }\n"

fn observation_of(pull_number: Int, diff: String) -> PrDiffObservation {
  PrDiffRead {
    pull_number: pull_number,
    head_oid: concat("oid-", to_string(pull_number)),
    changed_lines: changed_identities(diff: diff, rule: cross_pr_extraction_rule).changed_lines,
    directions: pr_identity_directions(
      pull_number: pull_number,
      changed: changed_identities(diff: diff, rule: cross_pr_extraction_rule)
    )
  }
}

// THE ALARMING DIRECTION IS THE ONE THAT COSTS OTHER LANES THEIR TIME, so this witness asserts both
// halves: no contradiction is reported, AND the pull request is still visible on the key as
// NetBoth. Asserting only the first would pass equally over a detector that dropped the row.
test fn single_pr_moving_a_line_is_not_a_contradiction() -> Bool {
  let observations = [observation_of(pull_number: 9999, diff: moved_line_diff)]
  let directions = pr_identity_directions(
    pull_number: 9999,
    changed: changed_identities(diff: moved_line_diff, rule: cross_pr_extraction_rule)
  )
  cross_pr_contradictions(observations: observations).length() == 0
    && directions.length() == 1
    && net_direction_text(direction: get_direction(directions: directions)) == "BOTH"
}

fn get_direction(directions: List<PrIdentityDirection>) -> NetDirection {
  match get(xs: directions, index: 0) {
    Absent => NetAbsent
    Present { value: row } => row.direction
  }
}

// THE POSITIVE CONTROL, and it is the live shape rather than an invented one: #9569 net-ADDS the
// identity, #9589 net-REMOVES it, and the merged tree carries a roster row for a passing witness.
test fn opposite_net_directions_across_two_prs_contradict() -> Bool {
  let found = cross_pr_contradictions(
    observations: [
      observation_of(pull_number: 9569, diff: adding_side_diff),
      observation_of(pull_number: 9589, diff: deleting_side_diff)
    ]
  )
  found.length() == 1
    && filter(found, key => key.net_add.length() == 1 && key.net_delete.length() == 1).length() == 1
}

// SAME-DIRECTION OVERLAP DISAGREES WITH NOBODY. 45 of the 53 multi-pull-request keys the hand run
// found were this shape; reporting them would bury the one row that matters.
test fn same_net_direction_across_two_prs_does_not_contradict() -> Bool {
  cross_pr_contradictions(
    observations: [
      observation_of(pull_number: 9589, diff: deleting_side_diff),
      observation_of(pull_number: 9591, diff: deleting_side_diff)
    ]
  ).length() == 0
}

// EMPTY IS NOT ABSENT, ASSERTED AS A DISCRIMINATING PAIR. Both arms contribute no directions; only
// one of them leaves the report complete. A detector that rendered an unread pull request as a
// contentless one would make these two indistinguishable, and this witness is what fails when it
// does.
test fn unread_pull_request_and_contentless_one_are_different_states() -> Bool {
  let derived = contradiction_report(
    file_scope: EveryFileInDiff,
    extraction: cross_pr_extraction_rule,
    observations: [PrDiffEmptyDerived { pull_number: 1, head_oid: "oid-1" }],
    presences: []
  )
  let corroborated = contradiction_report(
    file_scope: EveryFileInDiff,
    extraction: cross_pr_extraction_rule,
    observations: [PrDiffEmptyCorroborated { pull_number: 3, head_oid: "oid-3" }],
    presences: []
  )
  let unread = contradiction_report(
    file_scope: EveryFileInDiff,
    extraction: cross_pr_extraction_rule,
    observations: [
      PrDiffUnobserved {
        pull_number: 2,
        cause: DiffEmptyUnderived { head_oid: "oid-2", forge_changed_files: 4 }
      }
    ],
    presences: []
  )
  report_is_complete(report: derived)
    && report_is_complete(report: corroborated)
    && !report_is_complete(report: unread)
    && report_unobserved(report: unread).length() == 1
}

// THE THREE EMPTY DIFFS ARE THREE STATES, NOT ONE. The forge is the authority for what a branch
// contains; the local clone is the authority for what its commits say. When they agree on zero the
// emptiness is an OBSERVATION, and when they disagree it is an unmade one. A detector holding only
// the ancestry derivation refuses a branch whose commits net to nothing -- correct in the sense
// that it does not fabricate, and useless in the sense that its report is permanently incomplete
// over pull requests that are genuinely empty. The live scan carried exactly two of those.
test fn a_forge_disagreement_over_an_empty_diff_is_not_an_observation() -> Bool {
  let disagreement = contradiction_report(
    file_scope: EveryFileInDiff,
    extraction: cross_pr_extraction_rule,
    observations: [
      PrDiffUnobserved {
        pull_number: 7,
        cause: DiffEmptyUnderived { head_oid: "oid-7", forge_changed_files: 12 }
      }
    ],
    presences: []
  )
  !report_is_complete(report: disagreement)
    && string_contains(
         s: contradiction_report_text(report: disagreement),
         pattern: "the forge reports 12 changed file(s)"
       )
}

// A STALE LOCAL REF IS AN UNMADE OBSERVATION, not a branch that touches nothing.
test fn stale_head_ref_is_unobserved() -> Bool {
  let report = contradiction_report(
    file_scope: EveryFileInDiff,
    extraction: cross_pr_extraction_rule,
    observations: [
      PrDiffUnobserved {
        pull_number: 3,
        cause: HeadRefStale { ref_name: "origin/session/x", expected_oid: "aaa", local_oid: "bbb" }
      }
    ],
    presences: []
  )
  !report_is_complete(report: report) && report_unobserved(report: report).length() == 1
}

// FILE HEADERS ARE NOT CHANGED LINES. `+++ b/path` and `--- a/path` begin with the two characters
// this reader treats as directions, so an ordering mistake here turns every header into a changed
// line and every path into a candidate key.
test fn diff_file_headers_are_not_changed_lines() -> Bool {
  let changed = changed_identities(
    diff: "--- a/dag/gunbc/a.b.c.dag\n+++ b/dag/gunbc/a.b.c.dag\n context\n",
    rule: cross_pr_extraction_rule
  )
  changed.changed_lines == 0 && changed.added.length() == 0 && changed.removed.length() == 0
}

test fn diff_line_classes_are_assigned_by_the_longest_prefix() -> Bool {
  match diff_line_class(line: "+++ b/x") { DiffFileHeader => true, DiffAddedLine => false, DiffRemovedLine => false, DiffOtherLine => false }
    && match diff_line_class(line: "--- a/x") { DiffFileHeader => true, DiffAddedLine => false, DiffRemovedLine => false, DiffOtherLine => false }
    && match diff_line_class(line: "+  row") { DiffAddedLine => true, DiffFileHeader => false, DiffRemovedLine => false, DiffOtherLine => false }
    && match diff_line_class(line: "-  row") { DiffRemovedLine => true, DiffFileHeader => false, DiffAddedLine => false, DiffOtherLine => false }
    && match diff_line_class(line: "@@ -1 +1 @@") { DiffOtherLine => true, DiffFileHeader => false, DiffAddedLine => false, DiffRemovedLine => false }
}

// THE EXTRACTION RULE IS AN UPPER BOUND AND IT IS STILL NOT A FREE-FOR-ALL: an unquoted mention and
// a two-segment name are both outside it, and a path is excluded by its separator.
test fn extraction_keeps_quoted_qualified_names_only() -> Bool {
  line_identity_keys(line: "+ // see test.fixture.lookup.prose_mention in prose", rule: cross_pr_extraction_rule).length() == 0
    && line_identity_keys(line: "+ \"gunbc.only_two\"", rule: cross_pr_extraction_rule).length() == 0
    && line_identity_keys(line: "+ \"dag/gunbc/a.b.c\"", rule: cross_pr_extraction_rule).length() == 0
    && line_identity_keys(line: "+ \"test.fixture.lookup.probe\"", rule: cross_pr_extraction_rule).length() == 1
}

test fn net_direction_is_total_over_the_two_observations() -> Bool {
  net_direction_text(direction: net_direction(in_added: true, in_removed: false)) == "ADD"
    && net_direction_text(direction: net_direction(in_added: false, in_removed: true)) == "DEL"
    && net_direction_text(direction: net_direction(in_added: true, in_removed: true)) == "BOTH"
    && net_direction_text(direction: net_direction(in_added: false, in_removed: false)) == "ABSENT"
}

// THE SCOPE TRAVELS WITH THE REPORT. An overlap index computed over a filtered subset is blind to
// everything outside the filter; stating the scope in a footnote instead of in the output is how
// that blindness stops being visible to whoever reads the numbers.
test fn report_states_its_file_scope_and_extraction_rule() -> Bool {
  let text = contradiction_report_text(
    report: contradiction_report(
      file_scope: EveryFileInDiff,
      extraction: cross_pr_extraction_rule,
      observations: [observation_of(pull_number: 9569, diff: adding_side_diff)],
      presences: []
    )
  )
  string_contains(s: text, pattern: "file_scope\tevery file in every diff (unfiltered)")
    && string_contains(s: text, pattern: "extraction\tdouble-quoted dotted name of at least 3 segments")
}

fn nine_five_six_nine_against_nine_five_eight_nine() -> List<PrDiffObservation> {
  [
    observation_of(pull_number: 9569, diff: adding_side_diff),
    observation_of(pull_number: 9589, diff: deleting_side_diff)
  ]
}

fn contradiction_fixture_key() -> String {
  "test.fixture.contradiction_alpha.some_claim_holds"
}

fn report_with_presence(presence: MainPresence) -> ContradictionReport {
  contradiction_report(
    file_scope: EveryFileInDiff,
    extraction: cross_pr_extraction_rule,
    observations: nine_five_six_nine_against_nine_five_eight_nine(),
    presences: [KeyMainPresence { identity: contradiction_fixture_key(), presence: presence }]
  )
}

fn only_standing(report: ContradictionReport) -> ContradictionStanding {
  match get(xs: report.contradictions, index: 0) {
    Absent => StandingUndecided
    Present { value: row } => row.standing
  }
}

// THE SAME CONTRADICTION, THE SAME TWO PULL REQUESTS, TWO DIFFERENT REMEDIES. The net direction is
// computed against each branch's own merge base and cannot tell a proposal from a stale re-add; the
// merge target decides it. Both arms are asserted here because one alone would pass over a standing
// that always answered the same way.
test fn the_merge_target_decides_which_side_is_stale() -> Bool {
  let present = report_with_presence(presence: PresentOnMain)
  let absent = report_with_presence(presence: AbsentFromMain)
  match only_standing(report: present) {
    AddSideKeyPresentOnTarget => true
    DeleteSideKeyAbsentFromTarget => false
    StandingUndecided => false
  }
    && match only_standing(report: absent) {
         DeleteSideKeyAbsentFromTarget => true
         AddSideKeyPresentOnTarget => false
         StandingUndecided => false
       }
    && report_is_complete(report: present)
    && report_is_complete(report: absent)
}

// A LOOKUP THAT DID NOT HAPPEN IS NOT AN ANSWER, one level in from the empty-diff pair above. A
// contradiction whose side is undecided names no action, so the report is incomplete and says so
// rather than presenting the row as if it did.
test fn an_undecided_standing_makes_the_report_incomplete() -> Bool {
  let unobserved = report_with_presence(
    presence: MainPresenceUnobserved { detail: "the merge target could not be read" }
  )
  match only_standing(report: unobserved) {
    StandingUndecided => true
    AddSideKeyPresentOnTarget => false
    DeleteSideKeyAbsentFromTarget => false
  }
    && !report_is_complete(report: unobserved)
    && report_undecided(report: unobserved).length() == 1
}

// A CONTRADICTION WITH NO LOOKUP SUPPLIED AT ALL FAILS CLOSED, rather than defaulting to either
// side. This is the arm an instrument reaches when it forgets to ask, and it must not be the arm
// that quietly reports a remedy.
test fn a_missing_lookup_is_undecided_not_absent() -> Bool {
  let no_lookup = contradiction_report(
    file_scope: EveryFileInDiff,
    extraction: cross_pr_extraction_rule,
    observations: nine_five_six_nine_against_nine_five_eight_nine(),
    presences: []
  )
  no_lookup.contradictions.length() == 1
    && !report_is_complete(report: no_lookup)
    && string_contains(s: contradiction_report_text(report: no_lookup), pattern: "UNDECIDED")
}

// THE STANDING TRAVELS ON THE ROW, beside the net-add and net-delete lists that justify it. A
// reader who gets the identity without the remedy has to re-derive the remedy, and the whole point
// of the distinction is that it names an action.
test fn the_report_row_carries_the_standing_beside_the_directions() -> Bool {
  let text = contradiction_report_text(report: report_with_presence(presence: PresentOnMain))
  string_contains(s: text, pattern: "net_add\t9569")
    && string_contains(s: text, pattern: "net_delete\t9589")
    && string_contains(s: text, pattern: "standing\tADD-SIDE-PRESENT-ON-TARGET")
    && string_contains(s: text, pattern: "undecided\t0")
}

// THE STANDING STATES AN OBSERVATION AND THE REMEDY STATES AN ACTION, and they are different rows
// of the report on purpose. An earlier revision folded the rebase recommendation into the standing
// name, which asserts at ROW grain a redundancy the scan established at KEY grain -- confidently
// wrong in exactly the case the model's own limitation note describes, and wrong in the direction
// that tells someone to discard real work. This witness fails if the standing text ever asserts an
// action again, and if the remedy text ever drops the condition that qualifies it.
test fn the_standing_asserts_no_remedy_and_the_remedy_carries_its_condition() -> Bool {
  let present = contradiction_standing_text(standing: AddSideKeyPresentOnTarget)
  let absent = contradiction_standing_text(standing: DeleteSideKeyAbsentFromTarget)
  !string_contains(s: present, pattern: "rebase")
    && !string_contains(s: absent, pattern: "rebase")
    && !string_contains(s: present, pattern: "stale")
    && string_contains(s: contradiction_remedy_text(remedy: RebaseAddingBranch), pattern: "IF the two diffs touch the same row in the same file")
    && string_contains(s: contradiction_remedy_text(remedy: RebaseAddingBranch), pattern: "does not establish row grain")
    && string_contains(s: contradiction_remedy_text(remedy: RebaseDeletingBranch), pattern: "does not establish row grain")
}

// THE CONDITIONAL TRAVELS WITH THE ROW, not with the model comment. A reader who trusts the report
// and never opens the source is exactly the reader the grain gap catches, so the caveat has to be
// in the bytes they read.
test fn the_report_row_carries_the_remedy_and_its_caveat() -> Bool {
  let text = contradiction_report_text(report: report_with_presence(presence: PresentOnMain))
  string_contains(s: text, pattern: "standing\tADD-SIDE-PRESENT-ON-TARGET")
    && string_contains(s: text, pattern: "remedy\tIF the two diffs touch the same row")
    && string_contains(s: text, pattern: "rebase the ADDING branch")
}

test fn an_undecided_row_recommends_nothing() -> Bool {
  match contradiction_remedy(standing: StandingUndecided) {
    RemedyUndecided => true
    RebaseAddingBranch => false
    RebaseDeletingBranch => false
  }
    && !string_contains(s: contradiction_remedy_text(remedy: RemedyUndecided), pattern: "rebase the")
}

// THE MERGE-TARGET LOOKUP ASKS THE QUESTION THE EXTRACTION ANSWERS. An earlier cut searched for the
// bare identity, which matches a SHORTER key inside a LONGER one and matches an unquoted mention in
// prose -- either produces a present-on-target answer for a key the target does not carry, and the
// standing derived from it is confidently wrong while the report still calls itself complete
// (review 57265). The delimiters the extraction stripped are put back by the model, so the two
// cannot drift.
test fn the_merge_target_lookup_uses_the_extraction_semantics() -> Bool {
  let pattern = identity_lookup_pattern(identity: "test.fixture.lookup.probe", rule: cross_pr_extraction_rule)
  let quoted_exact = "  Cons { head: \"test.fixture.lookup.probe\", tail: Empty {} }"
  let quoted_longer = "  Cons { head: \"test.fixture.lookup.probe_extended\", tail: Empty {} }"
  let unquoted_prose = "  // see test.fixture.lookup.probe for the reason"
  string_contains(s: quoted_exact, pattern: pattern)
    && !string_contains(s: quoted_longer, pattern: pattern)
    && !string_contains(s: unquoted_prose, pattern: pattern)
}

// AND THE EXTRACTION IS THE INVERSE OF THE LOOKUP ON THE SAME LINE: a key this rule extracts from a
// changed line is a key whose lookup pattern that line contains. Asserting the pair is what makes
// them one authority rather than two spellings that happen to agree today.
test fn extraction_and_lookup_agree_on_the_same_line() -> Bool {
  let line = "+  Cons { head: \"test.fixture.lookup.probe\", tail: Empty {} }"
  let keys = line_identity_keys(line: line, rule: cross_pr_extraction_rule)
  keys.length() == 1
    && match get(xs: keys, index: 0) {
         Absent => false
         Present { value: key } =>
           string_contains(
             s: line,
             pattern: identity_lookup_pattern(identity: key, rule: cross_pr_extraction_rule)
           )
       }
}

// AN IDENTITY CITED IN AN ANNOTATION IS A REFERENCE, NOT AN ENROLMENT, and DESIGN 4c is the reason
// rather than a convenience: a `//` block is prose no semantic pass sees, so a reader that counted
// it would report a pull request as net-adding a key it only WROTE ABOUT. The merge-target
// direction is worse, because it never expires: one annotation anywhere in the corpus would make
// the presence oracle answer PRESENT for that key forever, and the derived remedy would tell a
// future author to rebase a branch that is not stale. This repository cites identities in
// annotations constantly, so the arm is reachable on ordinary source rather than only on a fixture.
test fn an_identity_cited_in_an_annotation_is_not_a_key() -> Bool {
  let annotated = "+  // see \"test.fixture.contradiction_alpha.some_claim_holds\" for the reason"
  let enrolled = "+  Cons { head: \"test.fixture.contradiction_alpha.some_claim_holds\", tail: Empty {} }"
  changed_identities(diff: concat(annotated, "\n"), rule: cross_pr_extraction_rule).added.length() == 0
    && changed_identities(diff: concat(enrolled, "\n"), rule: cross_pr_extraction_rule).added.length() == 1
    && line_is_annotation(body: "  // a note")
    && !line_is_annotation(body: "  Cons { head: \"a.b.c\" }")
}

// THE DIFF MARKER IS STRIPPED BEFORE THE ANNOTATION TEST, because `+  // note` is an annotation and
// the leading `+` would otherwise hide it from the check above.
test fn the_diff_marker_does_not_hide_an_annotation() -> Bool {
  line_is_annotation(body: diff_line_body(line: "+  // a note"))
    && line_is_annotation(body: diff_line_body(line: "-  // a note"))
    && !line_is_annotation(body: diff_line_body(line: "+  Cons { head: \"a.b.c\" }"))
}

// THE MERGE-TARGET SIDE READS THE SAME EXTRACTION, NOT THE RAW BYTES. A file whose ONLY occurrence
// of the key is an annotation does not hold it; the same file with an enrolled row does. `git grep`
// cannot tell those apart, which is why it is a prefilter and this is the decision.
test fn merge_target_content_is_read_through_the_extraction() -> Bool {
  let annotation_only = "module a.b\n// cites \"test.fixture.contradiction_alpha.some_claim_holds\"\n"
  let enrolled = "module a.b\ndata rows: List<String> = [\"test.fixture.contradiction_alpha.some_claim_holds\"]\n"
  !content_holds_identity(
      content: annotation_only,
      identity: contradiction_fixture_key(),
      rule: cross_pr_extraction_rule
    )
    && content_holds_identity(
         content: enrolled,
         identity: contradiction_fixture_key(),
         rule: cross_pr_extraction_rule
       )
    && content_identity_keys(content: annotation_only, rule: cross_pr_extraction_rule).length() == 0
}

// THE FIXTURES NAME NO REAL IDENTITY, and this witness is what keeps that true. Every quoted key in
// this file is `test.fixture.*`, which no roster holds and no pull request touches. An earlier cut
// used the live identity the instrument was built on -- and because a witness fixture is ordinary
// source, merging it would have put that identity on the merge target PERMANENTLY, so the presence
// oracle would answer PRESENT for it forever and a future pull request legitimately enrolling it
// would be told to rebase a branch that is not stale. A self-inflicted false positive that never
// expires, sitting on the instrument's own headline example.
test fn the_fixtures_use_synthetic_identities_only() -> Bool {
  let keys = append(
    content_identity_keys(content: adding_side_diff, rule: cross_pr_extraction_rule),
    items: append(
      content_identity_keys(content: deleting_side_diff, rule: cross_pr_extraction_rule),
      items: content_identity_keys(content: moved_line_diff, rule: cross_pr_extraction_rule)
    )
  )
  keys.length() > 0
    && filter(keys, key => starts_with(s: key, prefix: "test.fixture.") == false).length() == 0
    && filter(keys, key => starts_with(s: key, prefix: "test.fixture.")).length() == keys.length()
}


// PROSE IS NOT AN ENROLMENT, AND THE RULE THAT SEPARATES THEM IS WHOLE-LITERAL EQUALITY.
//
// `//` is not this corpus's only prose carrier. DESIGN 4c records why: while `//` was a parse
// error the corpus hoisted commentary into `data <name>: String` rows, and 126 of the survivors
// quote a `test.claim.*` identity inside a sentence. Excluding the CARRIER would be the wrong fix
// and strictly worse than the pollution -- roster enrolments ARE string data, so blinding the
// reader to `data ... String` rows would blind it to real enrolments.
//
// The discriminator is that a key must be the WHOLE literal, never a substring of one, and this
// extraction already is that rule: a quoted segment qualifies only if it is itself a spaceless
// dotted name. Measured over `dag/` and `src/v2` at 7b507a0b: 126 prose rows quoting a test
// identity, ZERO yielding a key. These witnesses are what keep that true -- the RED is authorable
// by relaxing the whole-literal test, which is exactly how someone would break it.
test fn a_prose_sentence_quoting_an_identity_is_not_an_enrolment() -> Bool {
  let prose = "+data note: String = \"These six rows lived in test.fixture.contradiction_alpha.some_claim_holds until the lens died\""
  let enrolment = "+data rows: List<String> = [\"test.fixture.contradiction_alpha.some_claim_holds\"]"
  changed_identities(diff: concat(prose, "\n"), rule: cross_pr_extraction_rule).added.length() == 0
    && changed_identities(diff: concat(enrolment, "\n"), rule: cross_pr_extraction_rule).added.length() == 1
}

// A LITERAL WHOSE VALUE IS EXACTLY AN IDENTITY IS AN ENROLMENT, WHATEVER ITS CARRIER. The corpus
// holds such rows -- a module name or a qualified name stored as `data x: String = "<identity>"` --
// and reading them is correct rather than pollution. Stating it as a witness is what stops a future
// author from "fixing" the prose class by excluding the carrier.
test fn an_identity_valued_data_row_is_a_key() -> Bool {
  changed_identities(
    diff: "+data witness_module: String = \"test.fixture.lookup.probe\"\n",
    rule: cross_pr_extraction_rule
  ).added.length() == 1
}

// AN ESCAPED-QUOTED IDENTITY INSIDE A PROSE LITERAL CANNOT LEAK, and the reason is structural
// rather than lucky: the literal's own opening quote takes the first delimiter, so an escaped
// fragment inside it always lands at EVEN parity, which the quoted-segment fold skips. This witness
// records that argument as an executable fact, because it is the shape a reader would otherwise
// expect to be a hole.
test fn an_escaped_quoted_identity_inside_prose_does_not_leak() -> Bool {
  let prose = "+data note: String = \"removed \\\"a\\\" and \\\"test.fixture.contradiction_beta.row_that_only_moved\\\" because both pass\""
  changed_identities(diff: concat(prose, "\n"), rule: cross_pr_extraction_rule).added.length() == 0
}
