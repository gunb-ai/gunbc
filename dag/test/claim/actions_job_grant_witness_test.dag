data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// ── THE SUBJECT IS THE GRANT FOLD, SO THE GRANT IS SUPPLIED HERE ────────────────────────────
//
// Every arm in this file asks what effective_actions_grant / actions_job_capability answer for a
// grant of a given SHAPE. Those folds read nothing of a job but the grant they are handed, so the
// grant belongs at this boundary as a constructed value. It used to be read off a live production
// workflow row instead, which made this file's subject that row's producer as well: an edit to
// some other module's `permissions:` key could move what these arms establish about the fold, and
// the fold itself would never have changed. DESIGN §3: a witness discriminates at ONE interface,
// and its inputs belong at that interface as supplied values.
//
// The paired inhabitance claim for the shape is gunbc.auth.github_credential's own consumers --
// credential_authorizes and unsatisfied_capabilities take exactly this EffectiveActionsJobGrant --
// and the fork arm below runs credential_authorizes for real against a real control plane value.

data a_pull_request_workflow_ref: DeclarationRef = DeclarationRef {
  module_path: "test.claim.actions_job_grant_witness",
  decl_name: "a_pull_request_job_grant",
  field: WholeDeclaration
}

data a_pull_request_job_ref: DeclarationRef = DeclarationRef {
  module_path: "test.claim.actions_job_grant_witness",
  decl_name: "a_pull_request_job_permissions",
  field: WholeDeclaration
}

// `contents: write` is the only level any arm below reads off this row; the other keys are here
// because WorkflowPermissions is a closed record and a witness may not leave one half-stated.
data a_pull_request_job_permissions: WorkflowPermissions = WorkflowPermissions {
  contents: Present { value: PermWrite },
  pull_requests: none,
  issues: none,
  actions: Present { value: PermWrite },
  id_token: none
}

data a_pull_request_job_grant: EffectiveActionsJobGrant = EffectiveActionsJobGrant {
  workflow: a_pull_request_workflow_ref,
  job: a_pull_request_job_ref,
  event: PullRequestEvent,
  origin: SameRepositoryOrigin,
  repository_policy: ActionsRepositoryPolicyUnobserved,
  permissions: a_pull_request_job_permissions
}

// THE SAME JOB, SEEN FROM A FORK'S PULL REQUEST. Exactly one field differs from the row above,
// and that single difference is the whole content of the fork arm: keeping the two grants
// otherwise identical is what makes the refusal attributable to the origin and to nothing else.
data a_forked_pull_request_job_grant: EffectiveActionsJobGrant = EffectiveActionsJobGrant {
  workflow: a_pull_request_workflow_ref,
  job: a_pull_request_job_ref,
  event: PullRequestEvent,
  origin: ForkedRepositoryOrigin,
  repository_policy: ActionsRepositoryPolicyUnobserved,
  permissions: a_pull_request_job_permissions
}

data a_pull_request_job_credential: GitHubCredentialAuthority = ActionsJobCredential {
  grant: a_pull_request_job_grant
}

// A REAL CONTROL PLANE VALUE, AND THE FORK ARM IS ABOUT ITS IRRELEVANCE. credential_capability
// routes an ActionsJobCredential to actions_job_capability, which never consults the control
// plane -- so an App's grant cannot rescue a job token. Building this through the real
// app_control_plane_state fold over the real gunbai_bot_signer_custody row keeps that arm a
// statement about the routing rather than about a shape assembled to agree with it.
data bot_app_control_plane: GitHubAppControlPlaneState = app_control_plane_state(
  app: gunbai_bot_declared,
  custody: gunbai_bot_signer_custody,
  registration: AppRegistrationReadbackUnavailable,
  observed: InstallationReadbackUnavailable { cause: InstallationReadbackNotAttempted },
  required: [contents_write, workflows_write],
  reason: "branch advance over .github/workflows/**"
)

fn grant_with(
  contents: PermissionLevel?,
  origin: PullRequestOrigin,
  policy: ActionsRepositoryPolicyObservation
) -> EffectiveActionsJobGrant {
  EffectiveActionsJobGrant {
    workflow: a_pull_request_workflow_ref,
    job: a_pull_request_job_ref,
    event: PullRequestEvent,
    origin: origin,
    repository_policy: policy,
    permissions: WorkflowPermissions {
      contents: contents,
      pull_requests: none,
      issues: none,
      actions: Present { value: PermWrite },
      id_token: none
    }
  }
}

fn contents_resolution(
  contents: PermissionLevel?,
  origin: PullRequestOrigin,
  policy: ActionsRepositoryPolicyObservation
) -> ActionsGrantResolution {
  effective_actions_grant(
    grant: grant_with(contents: contents, origin: origin, policy: policy),
    name: ContentsAxis
  )
}

fn is_none(r: ActionsGrantResolution) -> Bool {
  match r { ActionsGrantNone => true  _ => false }
}

fn is_write(r: ActionsGrantResolution) -> Bool {
  match r {
    ActionsGrantResolved { access } => match access { AppAccessWrite => true  _ => false }
    _ => false
  }
}

fn is_read(r: ActionsGrantResolution) -> Bool {
  match r {
    ActionsGrantResolved { access } => match access { AppAccessRead => true  _ => false }
    _ => false
  }
}

fn is_fork_policy_unobserved(r: ActionsGrantResolution) -> Bool {
  match r { ActionsGrantForkPolicyUnobserved => true  _ => false }
}

fn is_scope_unavailable(r: ActionsGrantResolution) -> Bool {
  match r { ActionsGrantScopeUnavailable => true  _ => false }
}

fn is_axis_not_modeled(r: ActionsGrantResolution) -> Bool {
  match r { ActionsGrantAxisNotModeled => true  _ => false }
}

data same_repo_policy: ActionsRepositoryPolicyObservation = ActionsRepositoryPolicyUnobserved
data fork_policy_denies: ActionsRepositoryPolicyObservation = ActionsRepositoryPolicyObserved {
  visibility: PrivateRepository,
  send_write_tokens_to_fork_pull_requests: false
}
data fork_policy_allows: ActionsRepositoryPolicyObservation = ActionsRepositoryPolicyObserved {
  visibility: PrivateRepository,
  send_write_tokens_to_fork_pull_requests: true
}
data public_fork_policy_allows: ActionsRepositoryPolicyObservation = ActionsRepositoryPolicyObserved {
  visibility: PublicRepository,
  send_write_tokens_to_fork_pull_requests: true
}

test fn witness_public_repository_fork_write_is_unreachable() -> Bool {
  is_read(r: contents_resolution(contents: Present { value: PermWrite }, origin: ForkedRepositoryOrigin, policy: public_fork_policy_allows))
    && is_write(r: contents_resolution(contents: Present { value: PermWrite }, origin: ForkedRepositoryOrigin, policy: fork_policy_allows))
    && !fork_write_tokens_reachable(policy: public_fork_policy_allows)
    && fork_write_tokens_reachable(policy: fork_policy_allows)
    && !fork_write_tokens_reachable(policy: ActionsRepositoryPolicyUnobserved)
}

test fn witness_declared_level_decides_the_grant_not_the_scope_name() -> Bool {
  is_none(r: contents_resolution(contents: none, origin: SameRepositoryOrigin, policy: same_repo_policy))
    && is_none(r: contents_resolution(contents: Present { value: PermNone }, origin: SameRepositoryOrigin, policy: same_repo_policy))
    && is_read(r: contents_resolution(contents: Present { value: PermRead }, origin: SameRepositoryOrigin, policy: same_repo_policy))
    && is_write(r: contents_resolution(contents: Present { value: PermWrite }, origin: SameRepositoryOrigin, policy: same_repo_policy))
}

test fn witness_fork_origin_downgrades_write_to_read() -> Bool {
  is_read(r: contents_resolution(contents: Present { value: PermWrite }, origin: ForkedRepositoryOrigin, policy: fork_policy_denies))
    && is_read(r: contents_resolution(contents: Present { value: PermRead }, origin: ForkedRepositoryOrigin, policy: fork_policy_denies))
    && is_write(r: contents_resolution(contents: Present { value: PermWrite }, origin: ForkedRepositoryOrigin, policy: fork_policy_allows))
}

test fn witness_unobserved_fork_policy_refuses_rather_than_assuming() -> Bool {
  is_fork_policy_unobserved(
    r: contents_resolution(contents: Present { value: PermWrite }, origin: ForkedRepositoryOrigin, policy: ActionsRepositoryPolicyUnobserved)
  ) && is_write(
    r: contents_resolution(contents: Present { value: PermWrite }, origin: SameRepositoryOrigin, policy: ActionsRepositoryPolicyUnobserved)
  ) && is_write(
    r: contents_resolution(contents: Present { value: PermWrite }, origin: OriginNotApplicable, policy: ActionsRepositoryPolicyUnobserved)
  )
}

test fn witness_scope_unavailable_is_not_scope_none() -> Bool {
  let g = grant_with(contents: Present { value: PermWrite }, origin: SameRepositoryOrigin, policy: same_repo_policy)
  is_scope_unavailable(r: effective_actions_grant(grant: g, name: WorkflowsAxis))
    && is_scope_unavailable(r: effective_actions_grant(grant: g, name: RepositoryProjectsAxis))
    && is_scope_unavailable(r: effective_actions_grant(grant: g, name: AdministrationAxis))
    && is_scope_unavailable(r: effective_actions_grant(grant: g, name: OrganizationSelfHostedRunnersAxis))
    && is_none(r: effective_actions_grant(grant: g, name: IssuesAxis))
    && is_none(r: effective_actions_grant(grant: g, name: IdTokenAxis))
    && is_axis_not_modeled(r: effective_actions_grant(grant: g, name: ChecksAxis))
}

// A configurable `permissions:` key and an intrinsic job-token grant are
// different facts (operator correction 2026-08-06). The exact-head Actions job
// reports `Metadata: read` while Metadata has NO configurable key, so mapping
// "no key" to ScopeUnavailable declared an observed grant structurally
// impossible. Both polarities are fixed here: Metadata is undeclarable AND
// granted read, while the keyless axes that carry no intrinsic grant stay
// unavailable — so re-fusing the two facts in either direction reds.
test fn witness_undeclarable_axis_may_still_be_granted() -> Bool {
  let g = grant_with(contents: Present { value: PermWrite }, origin: SameRepositoryOrigin, policy: same_repo_policy)
  !actions_token_may_declare_permission(name: MetadataAxis)
    && is_read(r: effective_actions_grant(grant: g, name: MetadataAxis))
    && !is_scope_unavailable(r: effective_actions_grant(grant: g, name: MetadataAxis))
    && is_scope_unavailable(r: effective_actions_grant(grant: g, name: WorkflowsAxis))
    && is_scope_unavailable(r: effective_actions_grant(grant: g, name: RepositoryProjectsAxis))
    && is_scope_unavailable(r: effective_actions_grant(grant: g, name: AdministrationAxis))
}

// The correction resolves an intrinsic grant at its OBSERVED access and no
// higher. A read grant satisfies a read request and refuses a write one, so
// widening the intrinsic carrier to write would red here rather than silently
// authorizing a write the live token does not carry.
test fn witness_intrinsic_read_grant_refuses_a_write_request() -> Bool {
  let g = grant_with(contents: Present { value: PermWrite }, origin: SameRepositoryOrigin, policy: same_repo_policy)
  match actions_job_capability(grant: g, required: GitHubAppPermission { name: MetadataAxis, access: AppAccessRead }) {
    CredentialGrants => true
    _ => false
  } && match actions_job_capability(grant: g, required: GitHubAppPermission { name: MetadataAxis, access: AppAccessWrite }) {
    CredentialScopeNotGranted { missing: _ } => true
    _ => false
  }
}

test fn witness_permissions_key_table_matches_cited_vocabulary() -> Bool {
  actions_token_may_declare_permission(name: ActionsAxis)
    && actions_token_may_declare_permission(name: ArtifactMetadataAxis)
    && actions_token_may_declare_permission(name: AttestationsAxis)
    && actions_token_may_declare_permission(name: ChecksAxis)
    && actions_token_may_declare_permission(name: CodeQualityAxis)
    && actions_token_may_declare_permission(name: ContentsAxis)
    && actions_token_may_declare_permission(name: DeploymentsAxis)
    && actions_token_may_declare_permission(name: DiscussionsAxis)
    && actions_token_may_declare_permission(name: IdTokenAxis)
    && actions_token_may_declare_permission(name: IssuesAxis)
    && actions_token_may_declare_permission(name: PackagesAxis)
    && actions_token_may_declare_permission(name: PagesAxis)
    && actions_token_may_declare_permission(name: PullRequestsAxis)
    && actions_token_may_declare_permission(name: SecurityEventsAxis)
    && actions_token_may_declare_permission(name: StatusesAxis)
    && actions_token_may_declare_permission(name: VulnerabilityAlertsAxis)
    && !actions_token_may_declare_permission(name: MetadataAxis)
    && !actions_token_may_declare_permission(name: RepositoryProjectsAxis)
    && !actions_token_may_declare_permission(name: WorkflowsAxis)
    && !actions_token_may_declare_permission(name: AdministrationAxis)
    && !actions_token_may_declare_permission(name: OrganizationSelfHostedRunnersAxis)
}

test fn witness_two_access_vocabularies_differ_only_by_the_absence_level() -> Bool {
  match permission_level_access(level: PermRead) {
    Absent => false
    Present { value: a } => match a { AppAccessRead => true  _ => false }
  }
    && match permission_level_access(level: PermWrite) {
      Absent => false
      Present { value: a } => match a { AppAccessWrite => true  _ => false }
    }
    && match permission_level_access(level: PermNone) {
      Absent => true
      Present { value: _ } => false
    }
}

test fn witness_cited_access_levels_are_not_uniformly_read_write() -> Bool {
  actions_access_set_admits(set: axis_allowed_actions_access(axis: IdTokenAxis), access: AppAccessWrite)
    && !actions_access_set_admits(set: axis_allowed_actions_access(axis: IdTokenAxis), access: AppAccessRead)
    && actions_access_set_admits(set: axis_allowed_actions_access(axis: VulnerabilityAlertsAxis), access: AppAccessRead)
    && !actions_access_set_admits(set: axis_allowed_actions_access(axis: VulnerabilityAlertsAxis), access: AppAccessWrite)
    && actions_access_set_admits(set: axis_allowed_actions_access(axis: ContentsAxis), access: AppAccessWrite)
    && actions_access_set_admits(set: axis_allowed_actions_access(axis: ContentsAxis), access: AppAccessRead)
}

data workflow_effect: GitHubEffect = AdvanceRepositoryBranch {
  repository: gunbc_repository,
  branch: GitBranchRef { name: "refs/heads/attempt" },
  changed_paths: [RepositoryPath { value: ".github/workflows/ci.yml" }]
}

data ordinary_effect: GitHubEffect = AdvanceRepositoryBranch {
  repository: gunbc_repository,
  branch: GitBranchRef { name: "refs/heads/attempt" },
  changed_paths: [RepositoryPath { value: ".gitignore" }]
}

test fn witness_fork_pull_request_cannot_advance_any_branch() -> Bool {
  let fork_credential = ActionsJobCredential { grant: a_forked_pull_request_job_grant }
  !credential_authorizes(
    authority: fork_credential,
    control_plane: bot_app_control_plane,
    effect: ordinary_effect
  ) && !credential_authorizes(
    authority: fork_credential,
    control_plane: bot_app_control_plane,
    effect: workflow_effect
  ) && credential_authorizes(
    authority: a_pull_request_job_credential,
    control_plane: bot_app_control_plane,
    effect: ordinary_effect
  )
}

test fn witness_invalid_declared_access_refuses_rather_than_capping() -> Bool {
  let id_token_read = EffectiveActionsJobGrant {
    workflow: a_pull_request_workflow_ref,
    job: a_pull_request_job_ref,
    event: PullRequestEvent,
    origin: SameRepositoryOrigin,
    repository_policy: ActionsRepositoryPolicyUnobserved,
    permissions: WorkflowPermissions {
      contents: none,
      pull_requests: none,
      issues: none,
      actions: none,
      id_token: Present { value: PermRead }
    }
  }
  match effective_actions_grant(grant: id_token_read, name: IdTokenAxis) {
    ActionsGrantDeclaredAccessInvalid { axis: _, declared, allowed } =>
      match declared { AppAccessRead => true  _ => false }
        && match allowed { ActionsAccessWriteOnly => true  _ => false }
    _ => false
  } && match axis_allowed_actions_access(axis: ModelsAxis) {
    ActionsAccessReadOnly => true
    _ => false
  } && match axis_allowed_actions_access(axis: ContentsAxis) {
    ActionsAccessReadOrWrite => true
    _ => false
  }
}

test fn witness_unmodeled_axis_is_not_reported_as_scope_none() -> Bool {
  let g = grant_with(contents: Present { value: PermWrite }, origin: SameRepositoryOrigin, policy: same_repo_policy)
  match effective_actions_grant(grant: g, name: ChecksAxis) {
    ActionsGrantAxisNotModeled => true
    _ => false
  } && match effective_actions_grant(grant: g, name: IssuesAxis) {
    ActionsGrantNone => true
    _ => false
  }
}

test fn witness_fork_policy_is_required_only_for_a_declared_write() -> Bool {
  is_read(r: contents_resolution(contents: Present { value: PermRead }, origin: ForkedRepositoryOrigin, policy: ActionsRepositoryPolicyUnobserved))
    && is_fork_policy_unobserved(
         r: contents_resolution(contents: Present { value: PermWrite }, origin: ForkedRepositoryOrigin, policy: ActionsRepositoryPolicyUnobserved)
       )
    && is_none(r: contents_resolution(contents: Present { value: PermNone }, origin: ForkedRepositoryOrigin, policy: ActionsRepositoryPolicyUnobserved))
}
