module test.claim.actions_job_grant_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn live_heal_push_authority() -> gunbc.auth.github_credential.GitHubCredentialAuthority {
  match gunbc.ci_heal_credential.push_binding_authority(resolution: gunbc.ci_heal_credential.live_heal_push_binding_resolution) {
    Present { value: a } => a
    Absent => gunbc.auth.github_credential.ActionsJobCredential { grant: gunbc.ci_heal_credential.fork_origin_grant() }
  }
}

fn grant_with(
  contents: extdeps.github.actions.PermissionLevel?,
  origin: extdeps.github.actions_token.PullRequestOrigin,
  policy: extdeps.github.actions_token.ActionsRepositoryPolicyObservation
) -> extdeps.github.actions_token.EffectiveActionsJobGrant {
  extdeps.github.actions_token.EffectiveActionsJobGrant {
    workflow: ci_heal_effective_grant.workflow,
    job: ci_heal_effective_grant.job,
    event: extdeps.github.actions_token.PullRequestEvent,
    origin: origin,
    repository_policy: policy,
    permissions: extdeps.github.actions.WorkflowPermissions {
      contents: contents,
      pull_requests: none,
      issues: none,
      actions: Present { value: extdeps.github.actions.PermWrite },
      id_token: none
    }
  }
}

fn contents_resolution(
  contents: extdeps.github.actions.PermissionLevel?,
  origin: extdeps.github.actions_token.PullRequestOrigin,
  policy: extdeps.github.actions_token.ActionsRepositoryPolicyObservation
) -> extdeps.github.actions_token.ActionsGrantResolution {
  extdeps.github.actions_token.effective_actions_grant(
    grant: grant_with(contents: contents, origin: origin, policy: policy),
    name: extdeps.github.app.ContentsAxis
  )
}

fn is_none(r: extdeps.github.actions_token.ActionsGrantResolution) -> Bool {
  match r { extdeps.github.actions_token.ActionsGrantNone => true  _ => false }
}

fn is_write(r: extdeps.github.actions_token.ActionsGrantResolution) -> Bool {
  match r {
    extdeps.github.actions_token.ActionsGrantResolved { access } => match access { extdeps.github.app.AppAccessWrite => true  _ => false }
    _ => false
  }
}

fn is_read(r: extdeps.github.actions_token.ActionsGrantResolution) -> Bool {
  match r {
    extdeps.github.actions_token.ActionsGrantResolved { access } => match access { extdeps.github.app.AppAccessRead => true  _ => false }
    _ => false
  }
}

fn is_fork_policy_unobserved(r: extdeps.github.actions_token.ActionsGrantResolution) -> Bool {
  match r { extdeps.github.actions_token.ActionsGrantForkPolicyUnobserved => true  _ => false }
}

fn is_scope_unavailable(r: extdeps.github.actions_token.ActionsGrantResolution) -> Bool {
  match r { extdeps.github.actions_token.ActionsGrantScopeUnavailable => true  _ => false }
}

fn is_axis_not_modeled(r: extdeps.github.actions_token.ActionsGrantResolution) -> Bool {
  match r { extdeps.github.actions_token.ActionsGrantAxisNotModeled => true  _ => false }
}

data same_repo_policy: extdeps.github.actions_token.ActionsRepositoryPolicyObservation = extdeps.github.actions_token.ActionsRepositoryPolicyUnobserved
data fork_policy_denies: extdeps.github.actions_token.ActionsRepositoryPolicyObservation = extdeps.github.actions_token.ActionsRepositoryPolicyObserved {
  visibility: extdeps.github.actions_token.PrivateRepository,
  send_write_tokens_to_fork_pull_requests: false
}
data fork_policy_allows: extdeps.github.actions_token.ActionsRepositoryPolicyObservation = extdeps.github.actions_token.ActionsRepositoryPolicyObserved {
  visibility: extdeps.github.actions_token.PrivateRepository,
  send_write_tokens_to_fork_pull_requests: true
}
data public_fork_policy_allows: extdeps.github.actions_token.ActionsRepositoryPolicyObservation = extdeps.github.actions_token.ActionsRepositoryPolicyObserved {
  visibility: extdeps.github.actions_token.PublicRepository,
  send_write_tokens_to_fork_pull_requests: true
}

test fn witness_public_repository_fork_write_is_unreachable() -> Bool {
  is_read(r: contents_resolution(contents: Present { value: extdeps.github.actions.PermWrite }, origin: extdeps.github.actions_token.ForkedRepositoryOrigin, policy: public_fork_policy_allows))
    && is_write(r: contents_resolution(contents: Present { value: extdeps.github.actions.PermWrite }, origin: extdeps.github.actions_token.ForkedRepositoryOrigin, policy: fork_policy_allows))
    && !extdeps.github.actions_token.fork_write_tokens_reachable(policy: public_fork_policy_allows)
    && extdeps.github.actions_token.fork_write_tokens_reachable(policy: fork_policy_allows)
    && !extdeps.github.actions_token.fork_write_tokens_reachable(policy: extdeps.github.actions_token.ActionsRepositoryPolicyUnobserved)
}

test fn witness_declared_level_decides_the_grant_not_the_scope_name() -> Bool {
  is_none(r: contents_resolution(contents: none, origin: extdeps.github.actions_token.SameRepositoryOrigin, policy: same_repo_policy))
    && is_none(r: contents_resolution(contents: Present { value: extdeps.github.actions.PermNone }, origin: extdeps.github.actions_token.SameRepositoryOrigin, policy: same_repo_policy))
    && is_read(r: contents_resolution(contents: Present { value: extdeps.github.actions.PermRead }, origin: extdeps.github.actions_token.SameRepositoryOrigin, policy: same_repo_policy))
    && is_write(r: contents_resolution(contents: Present { value: extdeps.github.actions.PermWrite }, origin: extdeps.github.actions_token.SameRepositoryOrigin, policy: same_repo_policy))
}

test fn witness_fork_origin_downgrades_write_to_read() -> Bool {
  is_read(r: contents_resolution(contents: Present { value: extdeps.github.actions.PermWrite }, origin: extdeps.github.actions_token.ForkedRepositoryOrigin, policy: fork_policy_denies))
    && is_read(r: contents_resolution(contents: Present { value: extdeps.github.actions.PermRead }, origin: extdeps.github.actions_token.ForkedRepositoryOrigin, policy: fork_policy_denies))
    && is_write(r: contents_resolution(contents: Present { value: extdeps.github.actions.PermWrite }, origin: extdeps.github.actions_token.ForkedRepositoryOrigin, policy: fork_policy_allows))
}

test fn witness_unobserved_fork_policy_refuses_rather_than_assuming() -> Bool {
  is_fork_policy_unobserved(
    r: contents_resolution(contents: Present { value: extdeps.github.actions.PermWrite }, origin: extdeps.github.actions_token.ForkedRepositoryOrigin, policy: extdeps.github.actions_token.ActionsRepositoryPolicyUnobserved)
  ) && is_write(
    r: contents_resolution(contents: Present { value: extdeps.github.actions.PermWrite }, origin: extdeps.github.actions_token.SameRepositoryOrigin, policy: extdeps.github.actions_token.ActionsRepositoryPolicyUnobserved)
  ) && is_write(
    r: contents_resolution(contents: Present { value: extdeps.github.actions.PermWrite }, origin: extdeps.github.actions_token.OriginNotApplicable, policy: extdeps.github.actions_token.ActionsRepositoryPolicyUnobserved)
  )
}

test fn witness_scope_unavailable_is_not_scope_none() -> Bool {
  let g = grant_with(contents: Present { value: extdeps.github.actions.PermWrite }, origin: extdeps.github.actions_token.SameRepositoryOrigin, policy: same_repo_policy)
  is_scope_unavailable(r: extdeps.github.actions_token.effective_actions_grant(grant: g, name: extdeps.github.app.WorkflowsAxis))
    && is_scope_unavailable(r: extdeps.github.actions_token.effective_actions_grant(grant: g, name: extdeps.github.app.RepositoryProjectsAxis))
    && is_scope_unavailable(r: extdeps.github.actions_token.effective_actions_grant(grant: g, name: extdeps.github.app.AdministrationAxis))
    && is_scope_unavailable(r: extdeps.github.actions_token.effective_actions_grant(grant: g, name: extdeps.github.app.OrganizationSelfHostedRunnersAxis))
    && is_none(r: extdeps.github.actions_token.effective_actions_grant(grant: g, name: extdeps.github.app.IssuesAxis))
    && is_none(r: extdeps.github.actions_token.effective_actions_grant(grant: g, name: extdeps.github.app.IdTokenAxis))
    && is_axis_not_modeled(r: extdeps.github.actions_token.effective_actions_grant(grant: g, name: extdeps.github.app.ChecksAxis))
}

// A configurable `permissions:` key and an intrinsic job-token grant are
// different facts (operator correction 2026-08-06). The exact-head Actions job
// reports `Metadata: read` while Metadata has NO configurable key, so mapping
// "no key" to ScopeUnavailable declared an observed grant structurally
// impossible. Both polarities are fixed here: Metadata is undeclarable AND
// granted read, while the keyless axes that carry no intrinsic grant stay
// unavailable — so re-fusing the two facts in either direction reds.
test fn witness_undeclarable_axis_may_still_be_granted() -> Bool {
  let g = grant_with(contents: Present { value: extdeps.github.actions.PermWrite }, origin: extdeps.github.actions_token.SameRepositoryOrigin, policy: same_repo_policy)
  !extdeps.github.actions_token.actions_token_may_declare_permission(name: extdeps.github.app.MetadataAxis)
    && is_read(r: extdeps.github.actions_token.effective_actions_grant(grant: g, name: extdeps.github.app.MetadataAxis))
    && !is_scope_unavailable(r: extdeps.github.actions_token.effective_actions_grant(grant: g, name: extdeps.github.app.MetadataAxis))
    && is_scope_unavailable(r: extdeps.github.actions_token.effective_actions_grant(grant: g, name: extdeps.github.app.WorkflowsAxis))
    && is_scope_unavailable(r: extdeps.github.actions_token.effective_actions_grant(grant: g, name: extdeps.github.app.RepositoryProjectsAxis))
    && is_scope_unavailable(r: extdeps.github.actions_token.effective_actions_grant(grant: g, name: extdeps.github.app.AdministrationAxis))
}

// The correction resolves an intrinsic grant at its OBSERVED access and no
// higher. A read grant satisfies a read request and refuses a write one, so
// widening the intrinsic carrier to write would red here rather than silently
// authorizing a write the live token does not carry.
test fn witness_intrinsic_read_grant_refuses_a_write_request() -> Bool {
  let g = grant_with(contents: Present { value: extdeps.github.actions.PermWrite }, origin: extdeps.github.actions_token.SameRepositoryOrigin, policy: same_repo_policy)
  match gunbc.auth.github_credential.actions_job_capability(grant: g, required: extdeps.github.app.GitHubAppPermission { name: extdeps.github.app.MetadataAxis, access: extdeps.github.app.AppAccessRead }) {
    gunbc.auth.github_credential.CredentialGrants => true
    _ => false
  } && match gunbc.auth.github_credential.actions_job_capability(grant: g, required: extdeps.github.app.GitHubAppPermission { name: extdeps.github.app.MetadataAxis, access: extdeps.github.app.AppAccessWrite }) {
    gunbc.auth.github_credential.CredentialScopeNotGranted { missing: _ } => true
    _ => false
  }
}

test fn witness_permissions_key_table_matches_cited_vocabulary() -> Bool {
  extdeps.github.actions_token.actions_token_may_declare_permission(name: extdeps.github.app.ActionsAxis)
    && extdeps.github.actions_token.actions_token_may_declare_permission(name: extdeps.github.app.ArtifactMetadataAxis)
    && extdeps.github.actions_token.actions_token_may_declare_permission(name: extdeps.github.app.AttestationsAxis)
    && extdeps.github.actions_token.actions_token_may_declare_permission(name: extdeps.github.app.ChecksAxis)
    && extdeps.github.actions_token.actions_token_may_declare_permission(name: extdeps.github.app.CodeQualityAxis)
    && extdeps.github.actions_token.actions_token_may_declare_permission(name: extdeps.github.app.ContentsAxis)
    && extdeps.github.actions_token.actions_token_may_declare_permission(name: extdeps.github.app.DeploymentsAxis)
    && extdeps.github.actions_token.actions_token_may_declare_permission(name: extdeps.github.app.DiscussionsAxis)
    && extdeps.github.actions_token.actions_token_may_declare_permission(name: extdeps.github.app.IdTokenAxis)
    && extdeps.github.actions_token.actions_token_may_declare_permission(name: extdeps.github.app.IssuesAxis)
    && extdeps.github.actions_token.actions_token_may_declare_permission(name: extdeps.github.app.PackagesAxis)
    && extdeps.github.actions_token.actions_token_may_declare_permission(name: extdeps.github.app.PagesAxis)
    && extdeps.github.actions_token.actions_token_may_declare_permission(name: extdeps.github.app.PullRequestsAxis)
    && extdeps.github.actions_token.actions_token_may_declare_permission(name: extdeps.github.app.SecurityEventsAxis)
    && extdeps.github.actions_token.actions_token_may_declare_permission(name: extdeps.github.app.StatusesAxis)
    && extdeps.github.actions_token.actions_token_may_declare_permission(name: extdeps.github.app.VulnerabilityAlertsAxis)
    && !extdeps.github.actions_token.actions_token_may_declare_permission(name: extdeps.github.app.MetadataAxis)
    && !extdeps.github.actions_token.actions_token_may_declare_permission(name: extdeps.github.app.RepositoryProjectsAxis)
    && !extdeps.github.actions_token.actions_token_may_declare_permission(name: extdeps.github.app.WorkflowsAxis)
    && !extdeps.github.actions_token.actions_token_may_declare_permission(name: extdeps.github.app.AdministrationAxis)
    && !extdeps.github.actions_token.actions_token_may_declare_permission(name: extdeps.github.app.OrganizationSelfHostedRunnersAxis)
}

test fn witness_two_access_vocabularies_differ_only_by_the_absence_level() -> Bool {
  match extdeps.github.actions_token.permission_level_access(level: extdeps.github.actions.PermRead) {
    Absent => false
    Present { value: a } => match a { extdeps.github.app.AppAccessRead => true  _ => false }
  }
    && match extdeps.github.actions_token.permission_level_access(level: extdeps.github.actions.PermWrite) {
      Absent => false
      Present { value: a } => match a { extdeps.github.app.AppAccessWrite => true  _ => false }
    }
    && match extdeps.github.actions_token.permission_level_access(level: extdeps.github.actions.PermNone) {
      Absent => true
      Present { value: _ } => false
    }
}

test fn witness_cited_access_levels_are_not_uniformly_read_write() -> Bool {
  extdeps.github.actions_token.actions_access_set_admits(set: extdeps.github.actions_token.axis_allowed_actions_access(axis: extdeps.github.app.IdTokenAxis), access: extdeps.github.app.AppAccessWrite)
    && !extdeps.github.actions_token.actions_access_set_admits(set: extdeps.github.actions_token.axis_allowed_actions_access(axis: extdeps.github.app.IdTokenAxis), access: extdeps.github.app.AppAccessRead)
    && extdeps.github.actions_token.actions_access_set_admits(set: extdeps.github.actions_token.axis_allowed_actions_access(axis: extdeps.github.app.VulnerabilityAlertsAxis), access: extdeps.github.app.AppAccessRead)
    && !extdeps.github.actions_token.actions_access_set_admits(set: extdeps.github.actions_token.axis_allowed_actions_access(axis: extdeps.github.app.VulnerabilityAlertsAxis), access: extdeps.github.app.AppAccessWrite)
    && extdeps.github.actions_token.actions_access_set_admits(set: extdeps.github.actions_token.axis_allowed_actions_access(axis: extdeps.github.app.ContentsAxis), access: extdeps.github.app.AppAccessWrite)
    && extdeps.github.actions_token.actions_access_set_admits(set: extdeps.github.actions_token.axis_allowed_actions_access(axis: extdeps.github.app.ContentsAxis), access: extdeps.github.app.AppAccessRead)
}

data workflow_effect: extdeps.github.effect.GitHubEffect = extdeps.github.effect.AdvanceRepositoryBranch {
  repository: gunbc.repository.gunbc_repository,
  branch: extdeps.github.effect.GitBranchRef { name: "refs/heads/attempt" },
  changed_paths: [extdeps.github.effect.RepositoryPath { value: ".github/workflows/ci.yml" }]
}

data ordinary_effect: extdeps.github.effect.GitHubEffect = extdeps.github.effect.AdvanceRepositoryBranch {
  repository: gunbc.repository.gunbc_repository,
  branch: extdeps.github.effect.GitBranchRef { name: "refs/heads/attempt" },
  changed_paths: [extdeps.github.effect.RepositoryPath { value: ".gitignore" }]
}

test fn witness_fork_pull_request_cannot_advance_any_branch() -> Bool {
  let fork_credential = gunbc.auth.github_credential.ActionsJobCredential { grant: gunbc.ci_heal_credential.fork_origin_grant() }
  !gunbc.auth.github_credential.credential_authorizes(
    authority: fork_credential,
    control_plane: gunbc.ci_heal_credential.live_heal_control_plane,
    effect: ordinary_effect
  ) && !gunbc.auth.github_credential.credential_authorizes(
    authority: fork_credential,
    control_plane: gunbc.ci_heal_credential.live_heal_control_plane,
    effect: workflow_effect
  ) && gunbc.auth.github_credential.credential_authorizes(
    authority: live_heal_push_authority(),
    control_plane: gunbc.ci_heal_credential.live_heal_control_plane,
    effect: ordinary_effect
  )
}

fn checkout_variant(rows: List<extdeps.languages.yaml.types.YamlKeyValue>) -> extdeps.github.actions.Step {
  extdeps.github.actions.UsesStep {
    name: Present { value: "Checkout" },
    id: none,
    uses: extdeps.github.actions.checkout_action,
    with: Present { value: rows },
    env: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}

test fn witness_push_binding_is_projected_from_the_actual_checkout_step() -> Bool {
  match gunbc.ci_heal_credential.resolve_push_binding(step: gunbc.ci_heal_credential.ci_heal_branch_head_checkout_step(), grant: gunbc.ci_heal_credential.ci_heal_effective_grant) {
    gunbc.auth.github_credential.PushBindingResolved { binding, authority } =>
      match binding {
        gunbc.auth.github_credential.CheckoutPersistedActionsCredential { checkout_step } =>
          checkout_step.decl_name == "ci_heal_branch_head_checkout_step"
      } && match authority {
        gunbc.auth.github_credential.ActionsJobCredential { grant } => grant.permissions == gunbc.ci_heal_credential.ci_heal_job_permissions
        _ => false
      }
    _ => false
  }
}

test fn witness_persist_credentials_false_unbinds_the_push_credential() -> Bool {
  let disabled = checkout_variant(rows: [
    extdeps.languages.yaml.types.kv(key: "fetch-depth", value: extdeps.languages.yaml.types.yaml_int(n: 0)),
    extdeps.languages.yaml.types.kv(key: "persist-credentials", value: extdeps.languages.yaml.types.yaml_bool(b: false))
  ])
  let disabled_string = checkout_variant(rows: [
    extdeps.languages.yaml.types.kv(key: "persist-credentials", value: extdeps.languages.yaml.types.yaml_string(s: "false"))
  ])
  let leased = checkout_variant(rows: [
    extdeps.languages.yaml.types.kv(key: "token", value: extdeps.languages.yaml.types.yaml_string(s: "${{ steps.app_token.outputs.token }}"))
  ])
  match gunbc.ci_heal_credential.resolve_push_binding(step: disabled, grant: gunbc.ci_heal_credential.ci_heal_effective_grant) {
    gunbc.auth.github_credential.PushCredentialBindingMissing { checkout_step: _ } => true
    _ => false
  } && match gunbc.ci_heal_credential.resolve_push_binding(step: disabled_string, grant: gunbc.ci_heal_credential.ci_heal_effective_grant) {
    gunbc.auth.github_credential.PushCredentialBindingMissing { checkout_step: _ } => true
    _ => false
  } && match gunbc.ci_heal_credential.resolve_push_binding(step: leased, grant: gunbc.ci_heal_credential.ci_heal_effective_grant) {
    gunbc.auth.github_credential.PushCredentialLeaseUnresolved { checkout_step: _ } => true
    _ => false
  } && match gunbc.ci_heal_credential.push_binding_authority(
    resolution: gunbc.ci_heal_credential.resolve_push_binding(step: disabled, grant: gunbc.ci_heal_credential.ci_heal_effective_grant)
  ) {
    Absent => true
    Present { value: _ } => false
  }
}

test fn witness_heal_condition_and_origin_share_one_binding() -> Bool {
  let no_dependabot_clause = gunbc.ci_heal_credential.heal_origin_binding(
    guard: gunbc.ci_heal_credential.HealOriginGuard { exclude_dependabot: false }
  )
  string_contains(s: gunbc.ci_heal_credential.ci_regen_heal_if, pattern: "github.event_name == 'pull_request'")
    && string_contains(s: gunbc.ci_heal_credential.ci_regen_heal_if, pattern: "github.event.pull_request.head.repo.full_name == github.repository")
    && string_contains(s: gunbc.ci_heal_credential.ci_regen_heal_if, pattern: "github.actor != 'dependabot[bot]'")
    && (gunbc.ci_heal_credential.ci_regen_heal_if == ci_heal_origin_binding.condition)
    && match gunbc.ci_heal_credential.ci_heal_pull_request_origin { extdeps.github.actions_token.SameRepositoryOrigin => true  _ => false }
    && string_contains(s: no_dependabot_clause.condition, pattern: "head.repo.full_name")
    && !string_contains(s: no_dependabot_clause.condition, pattern: "dependabot")
    && match no_dependabot_clause.origin { extdeps.github.actions_token.SameRepositoryOrigin => true  _ => false }
}

test fn witness_only_a_real_checkout_action_binds_the_push_credential() -> Bool {
  let run_step = extdeps.github.actions.RunStep {
    name: Present { value: "not a checkout" },
    id: none,
    run: "echo hi",
    shell: none,
    env: none,
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
  let other_action = extdeps.github.actions.UsesStep {
    name: Present { value: "upload" },
    id: none,
    uses: extdeps.github.actions.upload_artifact_action,
    with: none,
    env: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
  let duplicate_token = checkout_variant(rows: [
    extdeps.languages.yaml.types.kv(key: "token", value: extdeps.languages.yaml.types.yaml_string(s: "a")),
    extdeps.languages.yaml.types.kv(key: "token", value: extdeps.languages.yaml.types.yaml_string(s: "b"))
  ])
  let duplicate_persist = checkout_variant(rows: [
    extdeps.languages.yaml.types.kv(key: "persist-credentials", value: extdeps.languages.yaml.types.yaml_bool(b: true)),
    extdeps.languages.yaml.types.kv(key: "persist-credentials", value: extdeps.languages.yaml.types.yaml_bool(b: false))
  ])
  match gunbc.ci_heal_credential.resolve_push_binding(step: run_step, grant: gunbc.ci_heal_credential.ci_heal_effective_grant) {
    gunbc.auth.github_credential.PushBindingStepKindUnsupported { checkout_step: _ } => true
    _ => false
  } && match gunbc.ci_heal_credential.resolve_push_binding(step: other_action, grant: gunbc.ci_heal_credential.ci_heal_effective_grant) {
    gunbc.auth.github_credential.PushBindingActionMismatch { checkout_step: _ } => true
    _ => false
  } && match gunbc.ci_heal_credential.resolve_push_binding(step: duplicate_token, grant: gunbc.ci_heal_credential.ci_heal_effective_grant) {
    gunbc.auth.github_credential.PushBindingInputDuplicated { checkout_step: _, input } => input == "token"
    _ => false
  } && match gunbc.ci_heal_credential.resolve_push_binding(step: duplicate_persist, grant: gunbc.ci_heal_credential.ci_heal_effective_grant) {
    gunbc.auth.github_credential.PushBindingInputDuplicated { checkout_step: _, input } =>
      input == "persist-credentials"
    _ => false
  }
}

test fn witness_malformed_checkout_input_is_not_reported_as_duplicated() -> Bool {
  let malformed = checkout_variant(rows: [
    extdeps.languages.yaml.types.kv(key: "persist-credentials", value: extdeps.languages.yaml.types.yaml_string(s: "maybe"))
  ])
  let sequence_valued = checkout_variant(rows: [
    extdeps.languages.yaml.types.kv(key: "persist-credentials", value: extdeps.languages.yaml.types.YamlSequence { elements: [] })
  ])
  match gunbc.ci_heal_credential.resolve_push_binding(step: malformed, grant: gunbc.ci_heal_credential.ci_heal_effective_grant) {
    gunbc.auth.github_credential.PushBindingInputUnsupported { checkout_step: _, input, observed_kind } =>
      input == "persist-credentials"
        && extdeps.languages.yaml.types.yaml_value_kind_token(k: observed_kind) == "str"
    _ => false
  } && match gunbc.ci_heal_credential.resolve_push_binding(step: sequence_valued, grant: gunbc.ci_heal_credential.ci_heal_effective_grant) {
    gunbc.auth.github_credential.PushBindingInputUnsupported { checkout_step: _, input: _, observed_kind } =>
      extdeps.languages.yaml.types.yaml_value_kind_token(k: observed_kind) == "seq"
    _ => false
  } && !match gunbc.ci_heal_credential.resolve_push_binding(step: malformed, grant: gunbc.ci_heal_credential.ci_heal_effective_grant) {
    gunbc.auth.github_credential.PushBindingInputDuplicated { checkout_step: _, input: _ } => true
    _ => false
  }
}

test fn witness_invalid_declared_access_refuses_rather_than_capping() -> Bool {
  let id_token_read = extdeps.github.actions_token.EffectiveActionsJobGrant {
    workflow: ci_heal_effective_grant.workflow,
    job: ci_heal_effective_grant.job,
    event: extdeps.github.actions_token.PullRequestEvent,
    origin: extdeps.github.actions_token.SameRepositoryOrigin,
    repository_policy: extdeps.github.actions_token.ActionsRepositoryPolicyUnobserved,
    permissions: extdeps.github.actions.WorkflowPermissions {
      contents: none,
      pull_requests: none,
      issues: none,
      actions: none,
      id_token: Present { value: extdeps.github.actions.PermRead }
    }
  }
  match extdeps.github.actions_token.effective_actions_grant(grant: id_token_read, name: extdeps.github.app.IdTokenAxis) {
    extdeps.github.actions_token.ActionsGrantDeclaredAccessInvalid { axis: _, declared, allowed } =>
      match declared { extdeps.github.app.AppAccessRead => true  _ => false }
        && match allowed { extdeps.github.actions_token.ActionsAccessWriteOnly => true  _ => false }
    _ => false
  } && match extdeps.github.actions_token.axis_allowed_actions_access(axis: extdeps.github.app.ModelsAxis) {
    extdeps.github.actions_token.ActionsAccessReadOnly => true
    _ => false
  } && match extdeps.github.actions_token.axis_allowed_actions_access(axis: extdeps.github.app.ContentsAxis) {
    extdeps.github.actions_token.ActionsAccessReadOrWrite => true
    _ => false
  }
}

test fn witness_unmodeled_axis_is_not_reported_as_scope_none() -> Bool {
  let g = grant_with(contents: Present { value: extdeps.github.actions.PermWrite }, origin: extdeps.github.actions_token.SameRepositoryOrigin, policy: same_repo_policy)
  match extdeps.github.actions_token.effective_actions_grant(grant: g, name: extdeps.github.app.ChecksAxis) {
    extdeps.github.actions_token.ActionsGrantAxisNotModeled => true
    _ => false
  } && match extdeps.github.actions_token.effective_actions_grant(grant: g, name: extdeps.github.app.IssuesAxis) {
    extdeps.github.actions_token.ActionsGrantNone => true
    _ => false
  }
}

test fn witness_fork_policy_is_required_only_for_a_declared_write() -> Bool {
  is_read(r: contents_resolution(contents: Present { value: extdeps.github.actions.PermRead }, origin: extdeps.github.actions_token.ForkedRepositoryOrigin, policy: extdeps.github.actions_token.ActionsRepositoryPolicyUnobserved))
    && is_fork_policy_unobserved(
         r: contents_resolution(contents: Present { value: extdeps.github.actions.PermWrite }, origin: extdeps.github.actions_token.ForkedRepositoryOrigin, policy: extdeps.github.actions_token.ActionsRepositoryPolicyUnobserved)
       )
    && is_none(r: contents_resolution(contents: Present { value: extdeps.github.actions.PermNone }, origin: extdeps.github.actions_token.ForkedRepositoryOrigin, policy: extdeps.github.actions_token.ActionsRepositoryPolicyUnobserved))
}
