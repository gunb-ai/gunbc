module test.claim.direct_process_observation_witness_test

import std.types { Bool }
import gunbc.direct_process_observation {
  DirectProviderEventsObserved,
  DirectProviderEventsRefused,
  direct_provider_events_observation_readable,
  direct_provider_events_observation_content,
  direct_provider_events_observation_error,
}

data direct_process_observation_witness_note: String = "The direct-read substrate is pure projection over Filesystem.Read semantics: success exposes content, failure carries a located reason and never fabricates an empty stream. These witnesses pin the three accessors the belt consumes so a refusal cannot be misread as readable-with-empty."

test fn observed_content_is_readable_and_round_trips() -> Bool {
  let observation = DirectProviderEventsObserved { content: "{\"type\":\"turn.started\"}\n" }
  direct_provider_events_observation_readable(observation: observation)
    && direct_provider_events_observation_content(observation: observation)
      == "{\"type\":\"turn.started\"}\n"
    && direct_provider_events_observation_error(observation: observation) == ""
}

test fn refused_observation_is_not_readable_and_carries_reason() -> Bool {
  let observation = DirectProviderEventsRefused {
    reason: "provider event stream is unreadable at /missing: no such file" as NonEmptyStr,
  }
  !direct_provider_events_observation_readable(observation: observation)
    && direct_provider_events_observation_content(observation: observation) == ""
    && string_contains(
      s: direct_provider_events_observation_error(observation: observation),
      pattern: "/missing",
    )
}

test fn direct_process_observation_keystone_holds() -> Bool {
  observed_content_is_readable_and_round_trips()
    && refused_observation_is_not_readable_and_carries_reason()
}
