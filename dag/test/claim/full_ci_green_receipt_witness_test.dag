}

test fn witness_manual_merge_denies_same_head_different_workflow_run() -> Bool {
  match classify_full_ci_green_from_receipt_text(
    text: witness_prior_run_ci_green_receipt_text(),
    roster: current_gate_roster_hash,
  ) {
    FullCiGreenAdmitted { receipt: prior_full_ci } => {
      let base = merge_admission_witness_git_tree(label: "merge-admission-witness-base-b0")
      match compose_walk_attempt_id(run_id: witness_run_id as String, run_attempt: "1", job: "ci") {
        Absent => false
        Present { value: attempt_id } => {
          let subject = TestedSubject {
            attempt_id: attempt_id,
            head_sha: witness_head_sha,
            base_ref: "origin/main",
            base_tree_hash: base,
          }
          match classify_full_ci_green_from_receipt_text(
            text: witness_ci_green_receipt_text(),
            roster: current_gate_roster_hash,
          ) {
            FullCiGreenAdmitted { receipt: current_full_ci } =>
              match mint_merge_admission_receipt_v2_from_full_ci_green(
                full_ci: current_full_ci,
                attempt_id: attempt_id,
                tested_subject: subject,
                pr_number: none,
              ) {
                FullCiGreenMergeAdmissionMintDeniedSubjectMismatch { receipt_head_sha: _, subject_head_sha: _ } => false
                FullCiGreenMergeAdmissionMintDeniedWorkflowRunMismatch { workflow_run_id: _, attempt_id: _ } => false
                FullCiGreenMergeAdmissionMintDeniedAttemptMismatch { mint_attempt_id: _, subject_attempt_id: _ } => false
                FullCiGreenMergeAdmissionMinted { receipt: receipt } => {
                  let verdict = classify_merge_admission_verdict_v2(
                    current_attempt_id: attempt_id,
                    tested_subject: subject,
                    receipt: receipt,
                    merge_target_tree_hash: base,
                    current_roster_hash: current_gate_roster_hash,
                  )
                  !manual_merge_admits(
                    full_ci: prior_full_ci,
                    tested_subject: subject,
                    merge_admission_receipt: receipt,
                    merge_verdict: verdict,
                  )
                    && verdict == MergeAdmitted
                    && prior_full_ci.head_sha == witness_head_sha
                    && (prior_full_ci.workflow_run_id as String) == (witness_prior_run_id as String)
                }
              }
            _ => false
          }
        }
      }
    }
    _ => false
  }
}

