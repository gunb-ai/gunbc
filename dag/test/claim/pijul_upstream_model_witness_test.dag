module test.claim.pijul_upstream_model_witness


data pijul_change_root: extdeps.pijul.PijulChangeHash = "2QVMZO2O2KDKOW7OGJ7F3KPCPG26ZNXPS7ZJ4GWSB3MJOZTAC6RQC"
data pijul_change_left: extdeps.pijul.PijulChangeHash = "E44VZEK2SLDRWUDOWRT77OTHT4JPRPIECA2CBSTXCLHSRNF5HCJAC"
data pijul_change_right: extdeps.pijul.PijulChangeHash = "T3IOCG4HN7LXJZ5KKE7EMBAKB7CISZBYURRR6IQ52YSVR4266ZRQC"
data pijul_change_missing: extdeps.pijul.PijulChangeHash = "EXKC67TCSWSPRG4JP5AK2MYSRG6RCC3N5W3N62KESUUFN3FN6R4AC"
data pijul_change_dependent: extdeps.pijul.PijulChangeHash = "5PI4BUI3SDD23P7V3NNCA3FR6NA7YCMF7PJRIJNMZH5TGDA7AGWQC"

data pijul_state_root: extdeps.pijul.PijulStateHash = "SZI2BZ2Z3WAXEYFTQUJ2PXJRJFSCAWS5S4FOQRRUS24FZAAISFYAC"
data pijul_state_combined: extdeps.pijul.PijulStateHash = "4PUVTHWGVI3KPYJ7SSWTHUXASLJS5QOGH3D2RYOXUBWCDI62SB3QC"
data pijul_state_partial: extdeps.pijul.PijulStateHash = "PARTIALSTATE5QOGH3D2RYOXUBWCDI62SB3QCPARTIALSTATE5QO"
data pijul_state_wrong: extdeps.pijul.PijulStateHash = "WRONGSTATE15QOGH3D2RYOXUBWCDI62SB3QCWRONGSTATE15Q"

data pijul_path_source: extdeps.pijul.PijulPath = extdeps.pijul.PijulPath {
  octets: [115, 114, 99, 47, 109, 97, 105, 110, 46, 100, 97, 103]
}
data pijul_path_scratch: extdeps.pijul.PijulPath = extdeps.pijul.PijulPath {
  octets: [255, 46, 116, 109, 112]
}
data pijul_path_missing: extdeps.pijul.PijulPath = extdeps.pijul.PijulPath {
  octets: [118, 101, 110, 100, 111, 114]
}

test fn witness_pijul_upstream_authority_and_receipt_share_one_version() -> Bool {
  pijul_upstream_version.major == 1
    && pijul_upstream_version.minor == 0
    && pijul_upstream_version.patch == 0
    && pijul_upstream_version.beta == 20
    && extdeps.pijul.pijul_upstream_cli_version == "pijul 1.0.0-beta.20"
}

data pijul_vertex_root: extdeps.pijul.PijulVertexId = extdeps.pijul.PijulVertexId {
  introduced_by: pijul_change_root,
  position: extdeps.pijul.PijulVertexPosition { value: 0 },
}
data pijul_vertex_left: extdeps.pijul.PijulVertexId = extdeps.pijul.PijulVertexId {
  introduced_by: pijul_change_left,
  position: extdeps.pijul.PijulVertexPosition { value: 0 },
}
data pijul_vertex_right: extdeps.pijul.PijulVertexId = extdeps.pijul.PijulVertexId {
  introduced_by: pijul_change_right,
  position: extdeps.pijul.PijulVertexPosition { value: 0 },
}
data pijul_vertex_missing: extdeps.pijul.PijulVertexId = extdeps.pijul.PijulVertexId {
  introduced_by: pijul_change_missing,
  position: extdeps.pijul.PijulVertexPosition { value: 0 },
}

fn fixture_identity(hash: extdeps.pijul.PijulChangeHash) -> extdeps.pijul.PijulChangeIdentity {
  extdeps.pijul.PijulChangeIdentity {
    hash: hash,
    producer: extdeps.pijul.PijulChangeFileObserved {
      pijul_version: extdeps.pijul.pijul_upstream_version,
    },
  }
}

fn fixture_changes() -> List<extdeps.pijul.PijulRecordedChange> {
  [
    extdeps.pijul.PijulRecordedChange {
      identity: fixture_identity(hash: pijul_change_root),
      dependencies: [],
      actions: [
        extdeps.pijul.PijulNewVertex {
          vertex: pijul_vertex_root,
          up_context: [],
          down_context: [],
          content: std.bytes.octets_bytes(o: [114, 111, 111, 116]),
        },
      ],
      authors: ["Fixture Author"],
      message: "root",
      recorded_at: "provenance-only-root",
    },
    extdeps.pijul.PijulRecordedChange {
      identity: fixture_identity(hash: pijul_change_left),
      dependencies: [
        extdeps.pijul.PijulDependency {
          change: pijul_change_root,
          kind: extdeps.pijul.PijulStructuralDependency,
        },
      ],
      actions: [
        extdeps.pijul.PijulNewVertex {
          vertex: pijul_vertex_left,
          up_context: [extdeps.pijul.PijulContext { vertex: pijul_vertex_root }],
          down_context: [],
          content: std.bytes.octets_bytes(o: [108, 101, 102, 116]),
        },
      ],
      authors: ["Fixture Author"],
      message: "left",
      recorded_at: "provenance-only-left",
    },
    extdeps.pijul.PijulRecordedChange {
      identity: fixture_identity(hash: pijul_change_right),
      dependencies: [
        extdeps.pijul.PijulDependency {
          change: pijul_change_root,
          kind: extdeps.pijul.PijulStructuralDependency,
        },
      ],
      actions: [
        extdeps.pijul.PijulNewVertex {
          vertex: pijul_vertex_right,
          up_context: [extdeps.pijul.PijulContext { vertex: pijul_vertex_root }],
          down_context: [],
          content: std.bytes.octets_bytes(o: [114, 105, 103, 104, 116]),
        },
      ],
      authors: ["Fixture Author"],
      message: "right",
      recorded_at: "provenance-only-right",
    },
  ]
}

fn fixture_pristine() -> extdeps.pijul.PijulPristineState {
  extdeps.pijul.PijulPristineState {
    vertices: [
      extdeps.pijul.PijulGraphVertex {
        id: pijul_vertex_root,
        content: std.bytes.octets_bytes(o: [114, 111, 111, 116]),
      },
      extdeps.pijul.PijulGraphVertex {
        id: pijul_vertex_left,
        content: std.bytes.octets_bytes(o: [108, 101, 102, 116]),
      },
      extdeps.pijul.PijulGraphVertex {
        id: pijul_vertex_right,
        content: std.bytes.octets_bytes(o: [114, 105, 103, 104, 116]),
      },
    ],
    edges: [
      extdeps.pijul.PijulGraphEdge {
        source: pijul_vertex_root,
        target: pijul_vertex_left,
        introduced_by: pijul_change_left,
        disposition: extdeps.pijul.PijulAliveEdge,
      },
      extdeps.pijul.PijulGraphEdge {
        source: pijul_vertex_root,
        target: pijul_vertex_right,
        introduced_by: pijul_change_right,
        disposition: extdeps.pijul.PijulAliveEdge,
      },
    ],
    conflicts: [
      extdeps.pijul.PijulOrderConflict {
        left: pijul_change_left,
        right: pijul_change_right,
        at: pijul_vertex_root,
      },
    ],
  }
}

fn pijul_r0_fixture_tree() -> extdeps.pijul.PijulTree {
  extdeps.pijul.PijulTree {
    entries: [
      extdeps.pijul.PijulTreeEntry {
        inode: "inode-source",
        path: pijul_path_source,
        kind: extdeps.pijul.PijulFileEntry,
        introduced_by: pijul_change_root,
      },
    ]
  }
}

fn fixture_working_copy() -> extdeps.pijul.PijulWorkingCopy {
  extdeps.pijul.PijulWorkingCopy {
    entries: [
      extdeps.pijul.PijulWorkingCopyEntry {
        path: pijul_path_source,
        content: std.bytes.octets_bytes(o: [114, 111, 111, 116, 10, 108, 101, 102, 116, 10, 114, 105, 103, 104, 116]),
        disposition: extdeps.pijul.PijulWorkingCopyModified,
      },
      extdeps.pijul.PijulWorkingCopyEntry {
        path: pijul_path_scratch,
        content: std.bytes.octets_bytes(o: [115, 99, 114, 97, 116, 99, 104]),
        disposition: extdeps.pijul.PijulWorkingCopyUntracked,
      },
    ]
  }
}

fn fixture_channels() -> List<extdeps.pijul.PijulChannel> {
  [
    extdeps.pijul.PijulChannel {
      name: "main",
      state_identity: extdeps.pijul.PijulChannelStateIdentity {
        state: pijul_state_combined,
        changes: [pijul_change_root, pijul_change_left, pijul_change_right],
        producer: extdeps.pijul.PijulLogStateObserved {
          pijul_version: extdeps.pijul.pijul_upstream_version,
        },
      },
    },
    extdeps.pijul.PijulChannel {
      name: "review",
      state_identity: extdeps.pijul.PijulChannelStateIdentity {
        state: pijul_state_combined,
        changes: [pijul_change_root, pijul_change_right, pijul_change_left],
        producer: extdeps.pijul.PijulLogStateObserved {
          pijul_version: extdeps.pijul.pijul_upstream_version,
        },
      },
    },
    extdeps.pijul.PijulChannel {
      name: "base",
      state_identity: extdeps.pijul.PijulChannelStateIdentity {
        state: pijul_state_root,
        changes: [pijul_change_root],
        producer: extdeps.pijul.PijulLogStateObserved {
          pijul_version: extdeps.pijul.pijul_upstream_version,
        },
      },
    },
  ]
}

fn pijul_r0_fixture_repository() -> extdeps.pijul.PijulRepositoryState {
  extdeps.pijul.PijulRepositoryState {
    changes: fixture_changes(),
    pristine: fixture_pristine(),
    tree: pijul_r0_fixture_tree(),
    working_copy: fixture_working_copy(),
    channels: fixture_channels(),
    current_channel: "main",
  }
}

fn pijul_fixture_repository() -> extdeps.pijul.PijulRepositoryState {
  pijul_r0_fixture_repository()
}

fn pijul_r0_fixture_projection() -> extdeps.pijul.PijulRepositoryProjection {
  extdeps.pijul.PijulPartialProjection {
    candidate: pijul_r0_fixture_repository(),
    missing_changes: [pijul_change_missing],
    missing_vertices: [pijul_vertex_missing],
    missing_paths: [pijul_path_missing],
  }
}

fn fixture_projection() -> extdeps.pijul.PijulRepositoryProjection {
  pijul_r0_fixture_projection()
}

fn projection_with_channels(
  projection: extdeps.pijul.PijulRepositoryProjection,
  channels: List<extdeps.pijul.PijulChannel>,
) -> extdeps.pijul.PijulRepositoryProjection {
  extdeps.pijul.pijul_repository_projection_fold(
    projection: projection,
    fold: extdeps.pijul.PijulRepositoryProjectionFold {
      complete: fn(candidate) {
        extdeps.pijul.PijulCompleteProjection {
          candidate: extdeps.pijul.PijulRepositoryState {
            changes: candidate.changes,
            pristine: candidate.pristine,
            tree: candidate.tree,
            working_copy: candidate.working_copy,
            channels: channels,
            current_channel: candidate.current_channel,
          },
        }
      },
      partial: fn(candidate, missing_changes, missing_vertices, missing_paths) {
        extdeps.pijul.PijulPartialProjection {
          candidate: extdeps.pijul.PijulRepositoryState {
            changes: candidate.changes,
            pristine: candidate.pristine,
            tree: candidate.tree,
            working_copy: candidate.working_copy,
            channels: channels,
            current_channel: candidate.current_channel,
          },
          missing_changes: missing_changes,
          missing_vertices: missing_vertices,
          missing_paths: missing_paths,
        }
      },
      inaccessible: fn(reason) {
        extdeps.pijul.PijulInaccessibleProjection { reason: reason }
      },
    },
  )
}

test fn witness_pijul_fixture_uniqueness_frontier_is_clear() -> Bool {
  let state = pijul_fixture_repository()
  match extdeps.pijul.pijul_duplicate_change(changes: state.changes) {
    Present { value: _ } => false
    Absent => match extdeps.pijul.pijul_duplicate_channel(channels: state.channels) {
      Present { value: _ } => false
      Absent => match extdeps.pijul.pijul_duplicate_channel_member(channels: state.channels) {
        Present { value: _ } => false
        Absent => match extdeps.pijul.pijul_duplicate_vertex(pristine: state.pristine) {
          Present { value: _ } => false
          Absent => match extdeps.pijul.pijul_duplicate_tree_path(tree: state.tree) {
            Present { value: _ } => false
            Absent => match extdeps.pijul.pijul_duplicate_tree_inode(tree: state.tree) {
              Present { value: _ } => false
              Absent => match extdeps.pijul.pijul_duplicate_working_copy_path(
                working_copy: state.working_copy,
              ) {
                Present { value: _ } => false
                Absent => true
              }
            }
          }
        }
      }
    }
  }
}

test fn witness_pijul_fixture_has_no_duplicate_change_identity() -> Bool {
  match extdeps.pijul.pijul_duplicate_change(changes: pijul_fixture_repository().changes) {
    Present { value: _ } => false
    Absent => true
  }
}

test fn witness_pijul_fixture_reference_frontier_is_clear() -> Bool {
  match extdeps.pijul.pijul_decode_projection(projection: fixture_projection()) {
    extdeps.pijul.PijulDecoded { repository: _ } => true
    extdeps.pijul.PijulDecodeRefused { cause: _ } => false
  }
}

test fn witness_pijul_fixture_has_no_self_dependency() -> Bool {
  match extdeps.pijul.pijul_self_dependency(changes: pijul_fixture_repository().changes) {
    Present { value: _ } => false
    Absent => true
  }
}

test fn witness_pijul_fixture_state_identity_frontier_is_clear() -> Bool {
  let state = pijul_fixture_repository()
  match extdeps.pijul.pijul_state_identity_issue(channels: state.channels) {
    Present { value: _ } => false
    Absent => match extdeps.pijul.pijul_find_channel(
      channels: state.channels,
      name: state.current_channel,
    ) {
      Present { value: _ } => true
      Absent => false
    }
  }
}

test fn witness_pijul_bounded_projection_decodes_with_conflict_and_partial_facts() -> Bool {
  match extdeps.pijul.pijul_decode_projection(projection: fixture_projection()) {
    extdeps.pijul.PijulDecoded { repository } =>
      count(repository.state.changes) == 3
        && count(repository.state.pristine.conflicts) == 1
        && count(repository.state.channels) == 3
        && match repository.availability {
          extdeps.pijul.PijulDecodedPartial {
            missing_changes,
            missing_vertices,
            missing_paths,
          } =>
            missing_changes == [pijul_change_missing]
              && missing_vertices == [pijul_vertex_missing]
              && missing_paths == [pijul_path_missing]
          _ => false
        }
    extdeps.pijul.PijulDecodeRefused { cause: _ } => false
  }
}

test fn witness_pijul_projects_and_assesses_caller_supplied_readback() -> Bool {
  let repository = pijul_fixture_repository()
  match extdeps.pijul.pijul_project_repository(repository: repository) {
    extdeps.pijul.PijulProjected { projection } =>
      match extdeps.pijul.pijul_assess_read_back(
        expected: projection,
        observation: extdeps.pijul.PijulReadBackObservation {
          pijul_version: extdeps.pijul.pijul_upstream_version,
          projection: extdeps.pijul.PijulCompleteProjection {
            candidate: pijul_fixture_repository(),
          },
        },
      ) {
        extdeps.pijul.PijulReadBackMatches { observation: _ } => true
        _ => false
      }
    _ => false
  }
}

test fn witness_pijul_readback_rejects_perturbed_working_copy() -> Bool {
  let expected = pijul_fixture_repository()
  let perturbed = extdeps.pijul.PijulPartialProjection {
    candidate: extdeps.pijul.PijulRepositoryState {
      changes: expected.changes,
      pristine: expected.pristine,
      tree: expected.tree,
      working_copy: extdeps.pijul.PijulWorkingCopy { entries: [] },
      channels: expected.channels,
      current_channel: expected.current_channel,
    },
    missing_changes: [pijul_change_missing],
    missing_vertices: [pijul_vertex_missing],
    missing_paths: [pijul_path_missing],
  }
  match extdeps.pijul.pijul_assess_read_back(
    expected: fixture_projection(),
    observation: extdeps.pijul.PijulReadBackObservation {
      pijul_version: extdeps.pijul.pijul_upstream_version,
      projection: perturbed,
    },
  ) {
    extdeps.pijul.PijulReadBackMismatch { axis: extdeps.pijul.PijulReadBackWorkingCopyMismatch } => true
    _ => false
  }
}

test fn witness_pijul_change_identity_is_channel_independent() -> Bool {
  let channels = fixture_channels()
  match channels |> filter(channel => channel.name == "main") |> first {
    Present { value: main } =>
      match channels |> filter(channel => channel.name == "review") |> first {
        Present { value: review } =>
          extdeps.pijul.pijul_hash_count(
            changes: main.state_identity.changes,
            target: pijul_change_left,
          ) == 1
            && extdeps.pijul.pijul_hash_count(
              changes: review.state_identity.changes,
              target: pijul_change_left,
            ) == 1
        Absent => false
      }
    Absent => false
  }
}

test fn witness_pijul_channel_state_is_set_valued_not_delivery_order() -> Bool {
  let channels = fixture_channels()
  match channels |> filter(channel => channel.name == "main") |> first {
    Present { value: main } =>
      match channels |> filter(channel => channel.name == "review") |> first {
        Present { value: review } =>
          main.state_identity.state == review.state_identity.state
            && extdeps.pijul.pijul_change_sets_equal(
              left: main.state_identity.changes,
              right: review.state_identity.changes,
            )
            && count(main.state_identity.changes) == 3
        Absent => false
      }
    Absent => false
  }
}

test fn witness_pijul_log_wire_constructs_independent_channel_readback() -> Bool {
  let head = join(
    [
      concat("Change ", pijul_change_right as String),
      "Author: fixture",
      concat("State: ", pijul_state_combined as String),
      "",
      "    right",
    ],
    "\n",
  )
  let hashes = join(
    [
      pijul_change_right as String,
      pijul_change_root as String,
      pijul_change_left as String,
    ],
    "\n",
  )
  match extdeps.pijul.pijul_decode_channel_log_observation(
    pijul_version: extdeps.pijul.pijul_upstream_version,
    channel: "read-back",
    head_plaintext: head,
    hash_only: hashes,
  ) {
    extdeps.pijul.PijulChannelLogInvalid { cause: _ } => false
    extdeps.pijul.PijulChannelLogObserved { observation } =>
      match extdeps.pijul.pijul_assess_channel_log_read_back(
        expected: extdeps.pijul.PijulChannelStateIdentity {
          state: pijul_state_combined,
          changes: [pijul_change_root, pijul_change_left, pijul_change_right],
          producer: extdeps.pijul.PijulLogStateObserved {
            pijul_version: extdeps.pijul.pijul_upstream_version,
          },
        },
        observation: observation,
      ) {
        extdeps.pijul.PijulChannelLogReadBackMatches { observation: matched } =>
          matched.channel == "read-back"
            && matched.head.change == pijul_change_right
        extdeps.pijul.PijulChannelLogReadBackMismatch { axis: _ } => false
      }
  }
}

test fn witness_pijul_log_wire_refuses_duplicate_state_and_hash_rows() -> Bool {
  let duplicated_state = join(
    [
      concat("Change ", pijul_change_left as String),
      concat("State: ", pijul_state_combined as String),
      concat("State: ", pijul_state_wrong as String),
    ],
    "\n",
  )
  let duplicated_hash = join(
    [pijul_change_left as String, pijul_change_left as String],
    "\n",
  )
  match extdeps.pijul.pijul_decode_log_head_plaintext(text: duplicated_state) {
    extdeps.pijul.PijulLogHeadDecoded { head: _ } => false
    extdeps.pijul.PijulLogHeadDecodeRefused { cause: _ } =>
      match extdeps.pijul.pijul_decode_hash_only_log(text: duplicated_hash) {
        extdeps.pijul.PijulLogHashSetDecoded { changes: _ } => false
        extdeps.pijul.PijulLogHashSetDecodeRefused { cause: _ } => true
      }
  }
}

test fn witness_pijul_rendered_conflict_grounds_only_observed_conflict_shape() -> Bool {
  let rendered = join(
    [
      concat(">>>>>>> 1 [", substring(
        s: pijul_change_left as String,
        start: 0,
        end: 8,
      )),
      "left",
      "=======",
      concat("right [", substring(
        s: pijul_change_right as String,
        start: 0,
        end: 8,
      )),
      "<<<<<<< 1",
    ],
    "\n",
  )
  match extdeps.pijul.pijul_assess_rendered_order_conflict(
    observation: extdeps.pijul.PijulRenderedOrderConflictObservation {
      path: pijul_path_source,
      left: pijul_change_left,
      right: pijul_change_right,
      rendered_working_copy: rendered,
    },
  ) {
    extdeps.pijul.PijulRenderedOrderConflictGrounded { path, left, right } =>
      path == pijul_path_source
        && left == pijul_change_left
        && right == pijul_change_right
    extdeps.pijul.PijulRenderedConflictNotGrounded => false
  }
}

test fn witness_pijul_dependency_must_appear_inside_dependency_section() -> Bool {
  let grounded = extdeps.pijul.PijulDependencyTextObservation {
    change: pijul_change_left,
    dependency: pijul_change_root,
    change_text: join(
      [
        "# Dependencies",
        concat("[2] ", pijul_change_root as String),
        "# Hunks",
        "1. File addition",
      ],
      "\n",
    ),
  }
  let only_hunk_mentions = extdeps.pijul.PijulDependencyTextObservation {
    change: pijul_change_left,
    dependency: pijul_change_root,
    change_text: join(
      [
        "# Dependencies",
        "",
        "# Hunks",
        concat("context ", pijul_change_root as String),
      ],
      "\n",
    ),
  }
  match extdeps.pijul.pijul_assess_dependency_text(observation: grounded) {
    extdeps.pijul.PijulDependencyMentionGrounded { change, dependency } =>
      change == pijul_change_left
        && dependency == pijul_change_root
        && match extdeps.pijul.pijul_assess_dependency_text(observation: only_hunk_mentions) {
          extdeps.pijul.PijulDependencyMentionNotGrounded => true
          _ => false
        }
    extdeps.pijul.PijulDependencyMentionNotGrounded => false
  }
}

test fn witness_pijul_independent_delivery_permutations_have_one_change_set() -> Bool {
  let left_then_right = extdeps.pijul.pijul_plan_delivery(
    projection: fixture_projection(),
    channel_name: "base",
    delivered: [pijul_change_left, pijul_change_right],
  )
  let right_then_left = extdeps.pijul.pijul_plan_delivery(
    projection: fixture_projection(),
    channel_name: "base",
    delivered: [pijul_change_right, pijul_change_left],
  )
  match left_then_right {
    extdeps.pijul.PijulDeliveryAdmissible {
      channel: _,
      resulting_changes: left,
    } => match right_then_left {
      extdeps.pijul.PijulDeliveryAdmissible {
        channel: _,
        resulting_changes: right,
      } => extdeps.pijul.pijul_change_sets_equal(left: left, right: right)
      _ => false
    }
    _ => false
  }
}

test fn witness_pijul_duplicate_delivery_contributes_once() -> Bool {
  match extdeps.pijul.pijul_plan_delivery(
    projection: fixture_projection(),
    channel_name: "base",
    delivered: [pijul_change_left, pijul_change_left],
  ) {
    extdeps.pijul.PijulDeliveryAdmissible {
      channel: _,
      resulting_changes,
    } =>
      extdeps.pijul.pijul_hash_count(
        changes: resulting_changes,
        target: pijul_change_left,
      ) == 1
    _ => false
  }
}

test fn witness_pijul_missing_dependency_refuses_delivery() -> Bool {
  let base = pijul_fixture_repository()
  let dependent = extdeps.pijul.PijulRecordedChange {
    identity: fixture_identity(hash: pijul_change_dependent),
    dependencies: [
      extdeps.pijul.PijulDependency {
        change: pijul_change_left,
        kind: extdeps.pijul.PijulStructuralDependency,
      },
    ],
    actions: [],
    authors: ["Fixture Author"],
    message: "depends on unavailable change",
    recorded_at: "provenance-only-dependent",
  }
  let repository = extdeps.pijul.PijulRepositoryState {
    changes: append(base.changes, items: [dependent]),
    pristine: base.pristine,
    tree: base.tree,
    working_copy: base.working_copy,
    channels: base.channels,
    current_channel: base.current_channel,
  }
  let projection = extdeps.pijul.PijulCompleteProjection { candidate: repository }
  match extdeps.pijul.pijul_plan_delivery(
    projection: projection,
    channel_name: "base",
    delivered: [pijul_change_dependent],
  ) {
    extdeps.pijul.PijulDeliveryRefused {
      cause: extdeps.pijul.PijulDeliveryMissingDependency { change, dependency },
    } =>
      change == pijul_change_dependent
        && dependency == pijul_change_left
    _ => false
  }
}

test fn witness_pijul_unknown_change_never_applies_as_empty() -> Bool {
  match extdeps.pijul.pijul_plan_delivery(
    projection: fixture_projection(),
    channel_name: "base",
    delivered: [pijul_change_missing],
  ) {
    extdeps.pijul.PijulDeliveryRefused {
      cause: extdeps.pijul.PijulDeliveryChangeUnavailable { change },
    } => change == pijul_change_missing
    _ => false
  }
}

test fn witness_pijul_present_change_cannot_also_be_declared_missing() -> Bool {
  let invalid = extdeps.pijul.PijulPartialProjection {
    candidate: pijul_fixture_repository(),
    missing_changes: [pijul_change_root],
    missing_vertices: [],
    missing_paths: [],
  }
  match extdeps.pijul.pijul_decode_projection(projection: invalid) {
    extdeps.pijul.PijulDecodeRefused {
      cause: extdeps.pijul.PijulPresentChangeDeclaredMissing { change },
    } => change == pijul_change_root
    _ => false
  }
}

test fn witness_pijul_delivery_revalidates_raw_projection() -> Bool {
  let invalid = extdeps.pijul.PijulPartialProjection {
    candidate: pijul_fixture_repository(),
    missing_changes: [pijul_change_root],
    missing_vertices: [],
    missing_paths: [],
  }
  match extdeps.pijul.pijul_plan_delivery(
    projection: invalid,
    channel_name: "base",
    delivered: [pijul_change_left],
  ) {
    extdeps.pijul.PijulDeliveryRefused {
      cause: extdeps.pijul.PijulDeliveryRepositoryInvalid {
        cause: extdeps.pijul.PijulPresentChangeDeclaredMissing { change },
      },
    } => change == pijul_change_root
    _ => false
  }
}

test fn witness_pijul_missing_dependency_in_channel_still_refuses_delivery() -> Bool {
  let base = pijul_fixture_repository()
  let dependent = extdeps.pijul.PijulRecordedChange {
    identity: fixture_identity(hash: pijul_change_dependent),
    dependencies: [
      extdeps.pijul.PijulDependency {
        change: pijul_change_missing,
        kind: extdeps.pijul.PijulStructuralDependency,
      },
    ],
    actions: [],
    authors: ["Fixture Author"],
    message: "depends on a channel member whose change object is unavailable",
    recorded_at: "provenance-only-partial-dependent",
  }
  let partial_channel = extdeps.pijul.PijulChannel {
    name: "partial",
    state_identity: extdeps.pijul.PijulChannelStateIdentity {
      state: pijul_state_partial,
      changes: [pijul_change_root, pijul_change_missing],
      producer: extdeps.pijul.PijulLogStateObserved {
        pijul_version: extdeps.pijul.pijul_upstream_version,
      },
    },
  }
  let projection = extdeps.pijul.PijulPartialProjection {
    candidate: extdeps.pijul.PijulRepositoryState {
      changes: append(base.changes, items: [dependent]),
      pristine: base.pristine,
      tree: base.tree,
      working_copy: base.working_copy,
      channels: append(base.channels, items: [partial_channel]),
      current_channel: base.current_channel,
    },
    missing_changes: [pijul_change_missing],
    missing_vertices: [pijul_vertex_missing],
    missing_paths: [pijul_path_missing],
  }
  match extdeps.pijul.pijul_plan_delivery(
    projection: projection,
    channel_name: "partial",
    delivered: [pijul_change_dependent],
  ) {
    extdeps.pijul.PijulDeliveryRefused {
      cause: extdeps.pijul.PijulDeliveryMissingDependency { change, dependency },
    } =>
      change == pijul_change_dependent
        && dependency == pijul_change_missing
    _ => false
  }
}

test fn witness_pijul_existing_channel_member_dependency_gap_refuses_delivery() -> Bool {
  let base = pijul_fixture_repository()
  let existing = extdeps.pijul.PijulRecordedChange {
    identity: fixture_identity(hash: pijul_change_left),
    dependencies: [
      extdeps.pijul.PijulDependency {
        change: pijul_change_missing,
        kind: extdeps.pijul.PijulStructuralDependency,
      },
    ],
    actions: [],
    authors: ["Fixture Author"],
    message: "existing channel member depends on unavailable history",
    recorded_at: "provenance-only-transitive-gap",
  }
  let partial_channel = extdeps.pijul.PijulChannel {
    name: "partial-transitive",
    state_identity: extdeps.pijul.PijulChannelStateIdentity {
      state: pijul_state_partial,
      changes: [
        pijul_change_root,
        pijul_change_left,
        pijul_change_missing,
      ],
      producer: extdeps.pijul.PijulLogStateObserved {
        pijul_version: extdeps.pijul.pijul_upstream_version,
      },
    },
  }
  let projection = extdeps.pijul.PijulPartialProjection {
    candidate: extdeps.pijul.PijulRepositoryState {
      changes: append(
        base.changes
          |> filter(change =>
            !(change.identity.hash == pijul_change_left)
          ),
        items: [existing],
      ),
      pristine: base.pristine,
      tree: base.tree,
      working_copy: base.working_copy,
      channels: append(base.channels, items: [partial_channel]),
      current_channel: base.current_channel,
    },
    missing_changes: [pijul_change_missing],
    missing_vertices: [pijul_vertex_missing],
    missing_paths: [pijul_path_missing],
  }
  match extdeps.pijul.pijul_plan_delivery(
    projection: projection,
    channel_name: "partial-transitive",
    delivered: [pijul_change_right],
  ) {
    extdeps.pijul.PijulDeliveryRefused {
      cause: extdeps.pijul.PijulDeliveryMissingDependency { change, dependency },
    } =>
      change == pijul_change_left
        && dependency == pijul_change_missing
    _ => false
  }
}

test fn witness_pijul_duplicate_channel_member_refuses_capture() -> Bool {
  let base = fixture_projection()
  let duplicate = extdeps.pijul.PijulChannel {
    name: "main",
    state_identity: extdeps.pijul.PijulChannelStateIdentity {
      state: pijul_state_combined,
      changes: [pijul_change_root, pijul_change_left, pijul_change_left],
      producer: extdeps.pijul.PijulLogStateObserved {
        pijul_version: extdeps.pijul.pijul_upstream_version,
      },
    },
  }
  match extdeps.pijul.pijul_decode_projection(
    projection: projection_with_channels(
      projection: base,
      channels: [duplicate],
    ),
  ) {
    extdeps.pijul.PijulDecodeRefused {
      cause: extdeps.pijul.PijulDuplicateChannelMember { channel, change },
    } => channel == "main" && change == pijul_change_left
    _ => false
  }
}

