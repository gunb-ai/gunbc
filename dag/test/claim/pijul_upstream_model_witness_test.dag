}

test fn witness_pijul_undeclared_context_refuses_capture() -> Bool {
  let base = pijul_fixture_repository()
  let bad_change = extdeps.pijul.PijulRecordedChange {
    identity: fixture_identity(hash: pijul_change_dependent),
    dependencies: [],
    actions: [
      extdeps.pijul.PijulNewVertex {
        vertex: extdeps.pijul.PijulVertexId {
          introduced_by: pijul_change_dependent,
          position: extdeps.pijul.PijulVertexPosition { value: 0 },
        },
        up_context: [extdeps.pijul.PijulContext { vertex: pijul_vertex_missing }],
        down_context: [],
        content: std.bytes.octets_bytes(o: [98, 97, 100]),
      },
    ],
    authors: ["Fixture Author"],
    message: "bad context",
    recorded_at: "provenance-only-bad",
  }
  let changed = extdeps.pijul.PijulCompleteProjection {
    candidate: extdeps.pijul.PijulRepositoryState {
      changes: append(base.changes, items: [bad_change]),
      pristine: base.pristine,
      tree: base.tree,
      working_copy: base.working_copy,
      channels: base.channels,
      current_channel: base.current_channel,
    },
  }
  match extdeps.pijul.pijul_decode_projection(projection: changed) {
    extdeps.pijul.PijulDecodeRefused {
      cause: extdeps.pijul.PijulMissingContext { owner, vertex },
    } => owner == pijul_change_dependent && vertex == pijul_vertex_missing
    _ => false
  }
}

test fn witness_pijul_declared_partial_change_is_not_fabricated() -> Bool {
  let projection = fixture_projection()
  let partial_channel = extdeps.pijul.PijulChannel {
    name: "partial",
    state_identity: extdeps.pijul.PijulChannelStateIdentity {
      state: pijul_state_partial,
      changes: [pijul_change_root, pijul_change_missing],
      producer: extdeps.pijul.PijulLogStateObserved {
        pijul_version: extdeps.pijul.pijul_upstream_version,
      },
    },
  }
  let changed = projection_with_channels(
    projection: projection,
    channels: append(pijul_fixture_repository().channels, items: [partial_channel]),
  )
  match extdeps.pijul.pijul_decode_projection(projection: changed) {
    extdeps.pijul.PijulDecoded { repository } =>
      repository.state.changes
        |> filter(change => change.identity.hash == pijul_change_missing)
        |> count == 0
    _ => false
  }
}

test fn witness_pijul_graph_conflict_is_retained_without_capture_refusal() -> Bool {
  match extdeps.pijul.pijul_decode_projection(projection: fixture_projection()) {
    extdeps.pijul.PijulDecoded { repository } =>
      match repository.state.pristine.conflicts |> first {
        Present {
          value: extdeps.pijul.PijulOrderConflict { left, right, at },
        } =>
          left == pijul_change_left
            && right == pijul_change_right
            && at == pijul_vertex_root
        _ => false
      }
    _ => false
  }
}

test fn witness_pijul_tree_pristine_and_working_copy_remain_distinct() -> Bool {
  let state = pijul_fixture_repository()
  count(state.tree.entries) == 1
    && count(state.pristine.vertices) == 3
    && count(state.working_copy.entries) == 2
    && match state.working_copy.entries |> filter(entry =>
      entry.path == pijul_path_scratch
    ) |> first {
      Present { value: scratch } =>
        scratch.disposition == extdeps.pijul.PijulWorkingCopyUntracked
      Absent => false
    }
}

test fn witness_pijul_r0_write_capability_remains_unavailable() -> Bool {
  match extdeps.pijul.pijul_r0_conditional_advance() {
    extdeps.pijul.PijulConditionalAdvanceUnavailable { reason } =>
      string_contains(s: reason, pattern: "No executing upstream operation")
  }
}
