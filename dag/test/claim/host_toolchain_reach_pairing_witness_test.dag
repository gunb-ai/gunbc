module test.claim.host_toolchain_reach_pairing


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data host_toolchain_reach_pairing_witness_note: String = "Discriminating witnesses for the 2026-07-24 target/access pairing in gunbc.host_toolchain_ensure. The defect being walled: access used to be looked up from the REQUESTED host while the target was resolved kind-aware, so a BuildCache request for srv3 targeted srv3 and authenticated to srv1 — the effect lands on the wrong machine and reports success. A test that merely asserts the reach resolves would pass under the old code too, so the load-bearing row here is reach_access_host_is_the_target_host, which compares the two sides of the pair and is red exactly when they disagree. Its negative control is reach_wrong_machine_pairing_is_unwritable: the old behaviour is reconstructed by hand and shown to violate the same predicate, so the predicate is proven to discriminate rather than assumed to."

fn reach_or_absent(kind: HostToolchainKind, host: HostIdentity) -> HostToolchainReach? {
  match host_toolchain_ensure_reach(kind: kind, host: host) {
    ReachResolved { reach: reach } => Present { value: reach }
    ReachTargetAbsent => none
    ReachAccessAbsent { target_identity: _ } => none
  }
}

fn reach_pair_agrees(kind: HostToolchainKind, host: HostIdentity) -> Bool {
  match reach_or_absent(kind: kind, host: host) {
    Present { value: reach } => reach.access.host.identity == reach.target.identity
    Absent => false
  }
}

test fn reach_access_host_is_the_target_host() -> Bool {
  reach_pair_agrees(kind: BuildCache, host: operator_host_srv1)
    && reach_pair_agrees(kind: BuildCache, host: operator_host_srv2)
    && reach_pair_agrees(kind: BuildCache, host: operator_host_srv3)
    && reach_pair_agrees(kind: BuildCache, host: operator_host_srv4)
    && reach_pair_agrees(kind: OsInstallActuator, host: operator_host_srv3)
}

test fn reach_build_cache_on_srv3_targets_srv3_not_the_actuator() -> Bool {
  match reach_or_absent(kind: BuildCache, host: operator_host_srv3) {
    Present { value: reach } =>
      reach.target.identity == operator_host_srv3
        && reach.access.host.identity == operator_host_srv3
    Absent => false
  }
}

test fn reach_os_install_actuator_on_srv3_runs_from_the_actuator_host() -> Bool {
  match reach_or_absent(kind: OsInstallActuator, host: operator_host_srv3) {
    Present { value: reach } =>
      reach.target.identity == srv3_os_install_actuator_host.identity
        && reach.access.host.identity == srv3_os_install_actuator_host.identity
    Absent => false
  }
}

fn reach_pair_agrees_for(reach: HostToolchainReach) -> Bool {
  reach.access.host.identity == reach.target.identity
}

test fn reach_wrong_machine_pairing_is_unwritable() -> Bool {
  let old_shape = HostToolchainReach {
    target: srv3_host,
    access: host_identity_srv1_access,
  }
  let old_disagrees = reach_pair_agrees_for(reach: old_shape) == false
  let honest_agrees = match reach_or_absent(kind: BuildCache, host: operator_host_srv3) {
    Present { value: reach } => reach_pair_agrees_for(reach: reach)
    Absent => false
  }
  old_disagrees && honest_agrees
}

test fn host_toolchain_srv1_access_rows_are_one_concept() -> Bool {
  let a = host_identity_srv1_access
  let b = ci_deploy_srv1_operator_access
  a.host.identity == b.host.identity
    && a.transport == b.transport
    && a.principal == b.principal
    && a.privileged_commands == b.privileged_commands
}

test fn direct_access_covers_every_modeled_fleet_host() -> Bool {
  match host_toolchain_direct_access(host: operator_host_srv3) {
    Present { value: a } => a.host.identity == operator_host_srv3
    Absent => false
  }
}
