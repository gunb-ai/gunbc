module test.claim.e0599_probe_census_witness_test

import tools.e0599_probe_census {
  MissingMethod,
  BoundsUnsatisfied,
  NoVariant,
  R1CloneBoundOnTypeParam,
  R2VectorMethodBounds,
  R3ContainerCloneBounds,
  R4OptionalCoproductGrounding,
  R5AsDerefUnit,
  e0599_canonical_seven_module_count,
  e0599_message_pattern_row_count,
  e0599_root_family_for,
  e0599_root_family_label_for_row,
}

data e0599_probe_census_witness_note: String = "Witness for tools.e0599_probe_census authority: pattern row census + root-family rollup used by docs/probes/e0599_census_extract.sh (SCAFFOLD realization). RED: misclassified GlobalBare or type-parameter clone tuple."

test fn e0599_probe_census_pattern_rows_complete() -> Bool {
  e0599_message_pattern_row_count() == 5
}

test fn e0599_probe_census_canonical_seven_roster() -> Bool {
  e0599_canonical_seven_module_count() == 7
}

test fn e0599_root_family_clone_type_param_is_r1() -> Bool {
  e0599_root_family_for(
    shape: MissingMethod,
    method: "clone",
    receiver: "type parameter `T`"
  ) == R1CloneBoundOnTypeParam
}

test fn e0599_root_family_vector_is_empty_is_r2() -> Bool {
  e0599_root_family_for(
    shape: BoundsUnsatisfied,
    method: "is_empty",
    receiver: "struct `Rc<im::Vector<T>>`"
  ) == R2VectorMethodBounds
}

test fn e0599_root_family_outcome_clone_is_r3() -> Bool {
  e0599_root_family_for(
    shape: BoundsUnsatisfied,
    method: "clone",
    receiver: "enum `Outcome<T>`"
  ) == R3ContainerCloneBounds
}

test fn e0599_root_family_global_bare_is_r4() -> Bool {
  e0599_root_family_for(
    shape: NoVariant,
    method: "GlobalBareUnique",
    receiver: "enum `std::option::Option<_>`"
  ) == R4OptionalCoproductGrounding
}

test fn e0599_root_family_as_deref_unit_is_r5() -> Bool {
  e0599_root_family_for(
    shape: MissingMethod,
    method: "as_deref",
    receiver: "unit type `()`"
  ) == R5AsDerefUnit
}

test fn e0599_root_family_red_control_generic_diff_not_r1() -> Bool {
  e0599_root_family_for(
    shape: MissingMethod,
    method: "clone",
    receiver: "struct `im::Vector<T>`"
  ) != R1CloneBoundOnTypeParam
}

test fn e0599_root_family_label_for_row_log_shape_bridge() -> Bool {
  e0599_root_family_label_for_row(
    shape_str: "bounds_unsatisfied",
    method: "is_empty",
    receiver: "struct `Rc<im::Vector<T>>`"
  ) == "R2VectorMethodBounds"
}
