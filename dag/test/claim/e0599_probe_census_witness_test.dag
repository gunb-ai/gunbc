module test.claim.e0599_probe_census_witness_test


data e0599_probe_census_witness_note: String = "Witness for tools.e0599_probe_census authority: pattern row census, canonical-seven roster blob, and root-family rollup used by docs/probes/e0599_census_extract.sh (SCAFFOLD realization). Aggregate path refuses unless inputs match e0599_canonical_seven_modules exactly (missing/duplicate/extra). Export boundary refuses unknown failure-shape labels (fail-closed). RED: misclassified GlobalBare or type-parameter clone tuple; drifted shape_str."

test fn e0599_message_pattern_rows_blob_first_row_is_missing_method() -> Bool {
  match tools.e0599_probe_census.e0599_message_pattern_rows_blob() |> split(delimiter: "\n") |> first {
    Present { value: line } => string_contains(s: line, pattern: "missing_method\t")
    Absent => false
  }
}

test fn e0599_root_family_clone_type_param_is_r1() -> Bool {
  tools.e0599_probe_census.e0599_root_family_for(
    shape: tools.e0599_probe_census.MissingMethod,
    method: "clone",
    receiver: "type parameter `T`"
  ) == tools.e0599_probe_census.R1CloneBoundOnTypeParam
}

test fn e0599_root_family_vector_is_empty_is_r2() -> Bool {
  tools.e0599_probe_census.e0599_root_family_for(
    shape: tools.e0599_probe_census.BoundsUnsatisfied,
    method: "is_empty",
    receiver: "struct `Rc<im::Vector<T>>`"
  ) == tools.e0599_probe_census.R2VectorMethodBounds
}

test fn e0599_root_family_outcome_clone_is_r3() -> Bool {
  tools.e0599_probe_census.e0599_root_family_for(
    shape: tools.e0599_probe_census.BoundsUnsatisfied,
    method: "clone",
    receiver: "enum `Outcome<T>`"
  ) == tools.e0599_probe_census.R3ContainerCloneBounds
}

test fn e0599_root_family_global_bare_is_r4() -> Bool {
  tools.e0599_probe_census.e0599_root_family_for(
    shape: tools.e0599_probe_census.NoVariant,
    method: "GlobalBareUnique",
    receiver: "enum `std::option::Option<_>`"
  ) == tools.e0599_probe_census.R4OptionalCoproductGrounding
}

test fn e0599_root_family_as_deref_unit_is_r5() -> Bool {
  tools.e0599_probe_census.e0599_root_family_for(
    shape: tools.e0599_probe_census.MissingMethod,
    method: "as_deref",
    receiver: "unit type `()`"
  ) == tools.e0599_probe_census.R5AsDerefUnit
}

test fn e0599_root_family_red_control_generic_diff_not_r1() -> Bool {
  tools.e0599_probe_census.e0599_root_family_for(
    shape: tools.e0599_probe_census.MissingMethod,
    method: "clone",
    receiver: "struct `im::Vector<T>`"
  ) != tools.e0599_probe_census.R1CloneBoundOnTypeParam
}

test fn e0599_root_family_label_for_row_log_shape_bridge() -> Bool {
  match tools.e0599_probe_census.e0599_root_family_label_for_row(
    shape_str: "bounds_unsatisfied",
    method: "is_empty",
    receiver: "struct `Rc<im::Vector<T>>`"
  ) {
    std.error_primitives.Ok { value: label } => label == "R2VectorMethodBounds"
    std.error_primitives.Err { value: _ } => false
  }
}

test fn e0599_failure_shape_unknown_label_refused() -> Bool {
  match tools.e0599_probe_census.e0599_failure_shape_from_log_shape(shape_str: "bogus_shape") {
    std.error_primitives.Err { value: _ } => true
    std.error_primitives.Ok { value: _ } => false
  }
}

test fn e0599_root_family_labels_from_blob_unknown_shape_refused() -> Bool {
  match tools.e0599_probe_census.e0599_root_family_labels_from_blob(blob: "bogus_shape\tclone\ttype parameter `T`") {
    std.error_primitives.Err { value: _ } => true
    std.error_primitives.Ok { value: _ } => false
  }
}

test fn e0599_root_family_labels_from_blob_malformed_tuple_two_fields_refused() -> Bool {
  match tools.e0599_probe_census.e0599_root_family_labels_from_blob(blob: "missing_method\tclone") {
    std.error_primitives.Err { value: _ } => true
    std.error_primitives.Ok { value: _ } => false
  }
}

test fn e0599_root_family_labels_from_blob_malformed_tuple_four_fields_refused() -> Bool {
  match tools.e0599_probe_census.e0599_root_family_labels_from_blob(
    blob: "missing_method\tclone\ttype parameter `T`\textra"
  ) {
    std.error_primitives.Err { value: _ } => true
    std.error_primitives.Ok { value: _ } => false
  }
}

test fn e0599_root_family_labels_from_blob_batch() -> Bool {
  match tools.e0599_probe_census.e0599_root_family_labels_from_blob(
    blob: "missing_method\tclone\ttype parameter `T`\nbounds_unsatisfied\tis_empty\tstruct `Rc<im::Vector<T>>`"
  ) {
    std.error_primitives.Ok { value: labels } => labels == "R1CloneBoundOnTypeParam\nR2VectorMethodBounds"
    std.error_primitives.Err { value: _ } => false
  }
}
