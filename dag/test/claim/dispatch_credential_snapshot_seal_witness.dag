module test.claim.dispatch_credential_snapshot_seal_witness

import std.types { Bool, Int, String }
import gunbc.compile_census_probe { blocking_subject_census, census_delta_verdict, census_verdict, census_verdict_all, total_blocking_census, census_exit}
import gunbc.compile_diagnostic_census { CompileDiagnosticCensus }
import std.process { ProcessExit }

// A TAKEN CREDENTIAL SNAPSHOT IS EARNED BY THE TAKE, AND A PREPARED LAUNCH BY THE JOIN; NEITHER CAN BE
// SPELLED. gunbc.dispatch_credential_snapshot TakenCredentialSnapshot and gunbc.dispatch_attempt_launch
// PreparedAttemptLaunch are sole_constructor, and the launch legs take the prepared launch rather than
// a path or an attempt, so a module that wants a launch no take and no join produced has to spell one
// of the records -- as a literal, as a cast, or nested inside the launch alternative -- or call the
// mint from outside its admitted producer, and each is a located compile refusal. Each RED asserts
// EXACTLY ONE refusal on the subject; the GREEN asserts that a foreign module carrying a taken snapshot
// from the take's result into a launch alternative draws ZERO refusals on either subject (a census that
// did not run answers -1, never 0) and adds no blocking diagnostic of its own. The census counts the
// whole compile, imported closure included (gunbc.compile_diagnostic_census CompileDiagnosticCensus),
// so "of its own" is a comparison against a baseline module importing the same closure and doing
// nothing, never a total against zero. The seal sits on records, not on the coproduct alternatives,
// because variant construction does not reach the seed's sole_constructor check
// (test.claim.sole_constructor_completeness_audit_probe f13).

fn seal_violations(source: String, subject: String) -> CompileDiagnosticCensus {
  blocking_subject_census(source: source, wanted_class: "SoleConstructorViolation", wanted_subject: subject)
}

fn admission_refusals(source: String, callee: String) -> CompileDiagnosticCensus {
  blocking_subject_census(source: source, wanted_class: "ConstructorCallAdmissionRefused", wanted_subject: callee)
}

data forged_literal_source: String = "module probe_snapshot_forged_literal\nimport std.types { NonEmptyStr }\nimport gunbc.dispatch_attempt { DispatchAttempt }\nimport gunbc.dispatch_credential_snapshot { TakenCredentialSnapshot, ClaudeFromSnapshot }\nfn forged(a: DispatchAttempt, p: NonEmptyStr) -> TakenCredentialSnapshot {\n  TakenCredentialSnapshot { attempt: a, executor: ClaudeFromSnapshot, path: p }\n}\n"

data forged_cast_source: String = "module probe_snapshot_forged_cast\nimport std.types { NonEmptyStr }\nimport gunbc.dispatch_credential_snapshot { TakenCredentialSnapshot }\nfn forged(p: NonEmptyStr) -> TakenCredentialSnapshot {\n  p as TakenCredentialSnapshot\n}\n"

data forged_nested_source: String = "module probe_snapshot_forged_nested\nimport std.types { NonEmptyStr }\nimport gunbc.dispatch_attempt { DispatchAttempt }\nimport gunbc.dispatch_credential_snapshot { TakenCredentialSnapshot, CursorFromSnapshot }\nimport gunbc.dispatch_attempt_launch { AttemptLaunch, SnapshotLaunch }\nfn forged(a: DispatchAttempt, p: NonEmptyStr) -> AttemptLaunch {\n  SnapshotLaunch { snapshot: TakenCredentialSnapshot { attempt: a, executor: CursorFromSnapshot, path: p } }\n}\n"

data forged_prepared_source: String = "module probe_snapshot_forged_prepared\nimport std.types { NonEmptyStr }\nimport extdeps.llm.cli { ReasoningMedium, ProviderAccountDefaultModel }\nimport gunbc.dispatch_attempt_launch { AttemptLaunch, PreparedAttemptLaunch }\nfn forged(l: AttemptLaunch, f: NonEmptyStr) -> PreparedAttemptLaunch {\n  PreparedAttemptLaunch { launch: l, effort: ReasoningMedium, model: ProviderAccountDefaultModel, process_fingerprint: f }\n}\n"

data foreign_mint_source: String = "module probe_snapshot_foreign_mint\nimport std.types { NonEmptyStr }\nimport gunbc.dispatch_attempt { DispatchAttempt }\nimport extdeps.llm.cli { ReasoningMedium, ProviderAccountDefaultModel }\nimport gunbc.dispatch_attempt_launch { AttemptLaunch, AttemptLaunchPreparation, prepare_attempt_launch }\nfn minted(a: DispatchAttempt, l: AttemptLaunch, f: NonEmptyStr) -> AttemptLaunchPreparation {\n  prepare_attempt_launch(requested: a, launch: l, effort: ReasoningMedium, model: ProviderAccountDefaultModel, process_fingerprint: f)\n}\n"

data lawful_carry_source: String = "module probe_snapshot_lawful_carry\nimport std.types { NonEmptyStr }\nimport std.optional { Present }\nimport gunbc.dispatch_attempt { DispatchAttempt }\nimport gunbc.host_custody_export_receipt { SnapshotCustodyDeclaration }\nimport gunbc.dispatch_credential_snapshot { DispatchCredentialSnapshot, DispatchSnapshotTaken, DispatchSnapshotRefused, ClaudeFromSnapshot, dispatch_credential_snapshot_take, taken_credential_snapshot_path }\nimport gunbc.dispatch_attempt_launch { AttemptLaunch, SnapshotLaunch, attempt_launch_attempt }\nfn carried(a: DispatchAttempt, custody: SnapshotCustodyDeclaration) -> AttemptLaunch? {\n  match dispatch_credential_snapshot_take(attempt: a, executor: ClaudeFromSnapshot, custody: custody) {\n    DispatchSnapshotTaken { snapshot: s } => Present { value: SnapshotLaunch { snapshot: s } }\n    DispatchSnapshotRefused { reason: _ } => none\n  }\n}\nfn path_of(d: DispatchCredentialSnapshot) -> NonEmptyStr? {\n  match d {\n    DispatchSnapshotTaken { snapshot: s } => Present { value: taken_credential_snapshot_path(snapshot: s) }\n    DispatchSnapshotRefused { reason: _ } => none\n  }\n}\nfn attempt_of(l: AttemptLaunch) -> DispatchAttempt {\n  attempt_launch_attempt(launch: l)\n}\n"

data foreign_belt_staging_source: String = "module probe_belt_staging_foreign_call\nimport std.types { NonEmptyStr }\nimport gunbc.dispatch_attempt_launch { PreparedAttemptLaunch }\nimport gunbc.roadmap.roadmap_launch_admission { LaunchIdentity }\nimport gunbc.roadmap.roadmap_attempt_continuation { AttemptOrigin }\nimport gunbc.roadmap.roadmap_dispatch_actuator { DispatchSpawnCommands }\nimport gunbc.roadmap.roadmap_alignment { AlignmentBinding }\nimport gunbc.roadmap.roadmap_attempt_request_binding { AttemptLaunchRequest }\nimport gunbc.roadmap.roadmap_belt_actuate { BeltSpawnOutcome, belt_spawn_admitted }\nfn staged(p: PreparedAttemptLaunch, l: LaunchIdentity, o: AttemptOrigin, c: DispatchSpawnCommands, b: AlignmentBinding, r: AttemptLaunchRequest, f: NonEmptyStr) -> BeltSpawnOutcome {\n  belt_spawn_admitted(prepared: p, workdir: \"/w\", admission_receipt: \"\", provider_wire_label: \"claude\", launch: l, origin: o, cmds: c, binding: b, placement: none, request: r, process_fingerprint: f)\n}\n"

data closure_baseline_source: String = "module probe_snapshot_closure_baseline\nimport std.types { NonEmptyStr }\nimport std.optional { Present }\nimport gunbc.dispatch_attempt { DispatchAttempt }\nimport gunbc.dispatch_credential_snapshot { ClaudeFromSnapshot }\nimport gunbc.dispatch_attempt_launch { AttemptLaunch }\nfn baseline(a: DispatchAttempt, p: NonEmptyStr) -> NonEmptyStr? {\n  Present { value: p }\n}\n"

test fn a_forged_snapshot_literal_is_refused_at_compile() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: forged_literal_source, subject: "TakenCredentialSnapshot"), holds: fn(n) { n == 1 }))
}

test fn a_forged_snapshot_cast_is_refused_at_compile() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: forged_cast_source, subject: "TakenCredentialSnapshot"), holds: fn(n) { n == 1 }))
}

test fn a_forged_snapshot_nested_in_the_launch_is_refused_at_compile() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: forged_nested_source, subject: "TakenCredentialSnapshot"), holds: fn(n) { n == 1 }))
}

test fn a_forged_prepared_launch_is_refused_at_compile() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: forged_prepared_source, subject: "PreparedAttemptLaunch"), holds: fn(n) { n == 1 }))
}

test fn the_launch_mint_called_outside_its_producer_is_refused_at_compile() -> ProcessExit {
  census_exit(census_verdict(census: admission_refusals(source: foreign_mint_source, callee: "prepare_attempt_launch"), holds: fn(n) { n == 1 }))
}

// THE BELT'S STAGING HELPER RECEIVES THE COMMANDS BESIDE THE LAUNCH THEY WERE BUILT FROM, so only the
// route that builds both from one prepared launch may call it (gunbc.roadmap.roadmap_belt_actuate
// belt_spawn_admitted, admit_callers belt_actuate_spawn_with_origin). A module that would pair one
// launch with another's commands is refused at compile.
test fn the_belt_staging_helper_called_outside_its_route_is_refused_at_compile() -> ProcessExit {
  census_exit(census_verdict(census: admission_refusals(source: foreign_belt_staging_source, callee: "belt_spawn_admitted"), holds: fn(n) { n == 1 }))
}

test fn a_foreign_module_carrying_a_taken_snapshot_into_a_launch_is_not_refused() -> ProcessExit {
  census_verdict_all(verdicts: [
    census_verdict(census: seal_violations(source: lawful_carry_source, subject: "TakenCredentialSnapshot"), holds: fn(n) { n == 0 }),
    census_verdict(census: seal_violations(source: lawful_carry_source, subject: "PreparedAttemptLaunch"), holds: fn(n) { n == 0 }),
    // THE LEGALITY THE OLD `baseline >= 0` CONJUNCT EXISTED TO CHECK: the baseline had to have RUN.
    // It now says so itself -- a baseline that never ran refuses this claim with its own cause,
    // instead of being caught only when its sentinel happened to break an equality.
    census_verdict(census: total_blocking_census(source: closure_baseline_source), holds: fn(n) { true }),
    // SAME-NOISE FLOOR, typed: the delta between the lawful carrier and the baseline must be ZERO,
    // and it is only judged when both censuses ran.
    census_delta_verdict(red: total_blocking_census(source: lawful_carry_source), control: total_blocking_census(source: closure_baseline_source), holds: fn(n) { n == 0 }),
  ])
}
