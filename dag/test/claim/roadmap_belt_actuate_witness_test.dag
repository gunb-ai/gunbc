module test.claim.roadmap_belt_actuate_witness

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn roadmap_belt_actuate_nid(s: String) -> gunbc.roadmap_model.RoadmapNodeId { s }

fn ready_node(id: String) -> gunbc.roadmap_model.RoadmapNode {
  gunbc.roadmap_model.RoadmapNode {
    identity: "rnfx_RWT4XRCGS4GR90YZXK0Y" as gunbc.roadmap_model.RoadmapNodeIdentity,
    node: roadmap_belt_actuate_nid(s: id),
    line: gunbc.roadmap_status.DerivableLine { prs: [1], title: id, description: "" },
    carriers: [],
    sizing: gunbc.roadmap_model.Sized { intricacy: gunbc.roadmap_model.IntricacyHigh, volume: gunbc.roadmap_model.VolumeMedium, repo: "gunbc", acceptance: gunbc.roadmap_model.PrsMerged },
    execution: gunbc.roadmap_execution_contract.ExecutionContractUnspecified,
    owner: "",
    signoff: gunbc.roadmap_status.Unsigned,
  }
}

fn live_session(node_id: String, verdict: std.upsert_decision.ObservationVerdict) -> gunbc.roadmap_dispatch_actuator.DispatchLiveSession {
  gunbc.roadmap_dispatch_actuator.DispatchLiveSession {
    session_name: "gunbc-dispatch-{node_id}",
    node_id: node_id,
    windows: 1,
    lease_verdict: verdict,
    worker: gunbc.worker_lifecycle.worker_observation_without_provider_probe(
      instance: gunbc.roadmap_dispatch_actuator.dispatch_provider_instance_for(provider: gunbc.roadmap_dispatch_actuator.CodexDispatchProvider),
    ),
  }
}

fn live_session_with_process(
  node_id: String,
  process: gunbc.worker_lifecycle.WorkerProcessEvidence,
) -> gunbc.roadmap_dispatch_actuator.DispatchLiveSession {
  gunbc.roadmap_dispatch_actuator.DispatchLiveSession {
    session_name: "gunbc-dispatch-{node_id}",
    node_id: node_id,
    windows: 1,
    lease_verdict: std.upsert_decision.Converged,
    worker: gunbc.worker_lifecycle.worker_observation_without_provider_probe_for_process(
      instance: gunbc.roadmap_dispatch_actuator.dispatch_provider_instance_for(provider: gunbc.roadmap_dispatch_actuator.CodexDispatchProvider),
      process: process,
    ),
  }
}

fn is_exec_ok(o: gunbc.roadmap_belt_actuate.BeltExecOutcome) -> Bool {
  match o {
    ExecOk { stdout: _ } => true
    ExecFailed { program: _, exit_code: _, stderr: _ } => false
    ExecRefused { program: _, reason: _ } => false
  }
}

fn exec_ok_stdout_contains(o: gunbc.roadmap_belt_actuate.BeltExecOutcome, pattern: String) -> Bool {
  match o {
    ExecOk { stdout: out } => string_contains(s: out, pattern: pattern)
    ExecFailed { program: _, exit_code: _, stderr: _ } => false
    ExecRefused { program: _, reason: _ } => false
  }
}

fn is_exec_failed(o: gunbc.roadmap_belt_actuate.BeltExecOutcome) -> Bool {
  match o {
    ExecFailed { program: _, exit_code: _, stderr: _ } => true
    ExecOk { stdout: _ } => false
    ExecRefused { program: _, reason: _ } => false
  }
}

fn is_exec_refused(o: gunbc.roadmap_belt_actuate.BeltExecOutcome) -> Bool {
  match o {
    ExecRefused { program: _, reason: _ } => true
    ExecOk { stdout: _ } => false
    ExecFailed { program: _, exit_code: _, stderr: _ } => false
  }
}

fn is_spawn_failed(o: gunbc.roadmap_belt_actuate.BeltSpawnOutcome) -> Bool {
  match o {
    SpawnFailed { node_id: _, step: _, detail: _, provider: _ } => true
    Spawned { node_id: _, session_name: _, provider: _ } => false
  }
}

fn is_teardown_failed(o: gunbc.roadmap_belt_actuate.BeltTeardownOutcome) -> Bool {
  match o {
    TeardownFailed { session_name: _, detail: _ } => true
    ReapedSession { session_name: _ } => false
  }
}

test fn witness_exec_ok_runs_echo() -> Bool {
  let o = gunbc.roadmap_belt_actuate.belt_exec(cmd: gunbc.roadmap_dispatch_actuator.host_exec_argv(program: "echo", args: ["belt-ok"]), workdir: "/")
  is_exec_ok(o: o) && exec_ok_stdout_contains(o: o, pattern: "belt-ok")
}

test fn witness_exec_refuses_missing_program() -> Bool {
  let o = gunbc.roadmap_belt_actuate.belt_exec(
    cmd: gunbc.roadmap_dispatch_actuator.host_exec_argv(program: "belt-nonexistent-program-xyz", args: []),
    workdir: "/",
  )
  is_exec_refused(o: o)
}

test fn witness_exec_fails_on_nonzero_exit() -> Bool {
  let o = gunbc.roadmap_belt_actuate.belt_exec(cmd: gunbc.roadmap_dispatch_actuator.host_exec_argv(program: "false", args: []), workdir: "/")
  is_exec_failed(o: o)
}

test fn witness_exec_all_runs_every_step_when_ok() -> Bool {
  let o = gunbc.roadmap_belt_actuate.belt_exec_all(
    cmds: [
      gunbc.roadmap_dispatch_actuator.host_exec_argv(program: "echo", args: ["first"]),
      gunbc.roadmap_dispatch_actuator.host_exec_argv(program: "echo", args: ["second"]),
    ],
    workdir: "/",
  )
  is_exec_ok(o: o) && exec_ok_stdout_contains(o: o, pattern: "second")
}

test fn witness_exec_all_short_circuits_after_failure() -> Bool {
  let o = gunbc.roadmap_belt_actuate.belt_exec_all(
    cmds: [
      gunbc.roadmap_dispatch_actuator.host_exec_argv(program: "false", args: []),
      gunbc.roadmap_dispatch_actuator.host_exec_argv(program: "echo", args: ["should-not-run"]),
    ],
    workdir: "/",
  )
  is_exec_failed(o: o) && !exec_ok_stdout_contains(o: o, pattern: "should-not-run")
}

test fn witness_exec_all_fails_on_later_step() -> Bool {
  let o = gunbc.roadmap_belt_actuate.belt_exec_all(
    cmds: [
      gunbc.roadmap_dispatch_actuator.host_exec_argv(program: "echo", args: ["ok"]),
      gunbc.roadmap_dispatch_actuator.host_exec_argv(program: "false", args: []),
    ],
    workdir: "/",
  )
  is_exec_failed(o: o)
}

test fn witness_named_exec_steps_locate_the_first_failure() -> Bool {
  match gunbc.roadmap_belt_actuate.belt_exec_steps(
    steps: [
      gunbc.roadmap_belt_actuate.BeltExecStep {
        step: "prepare",
        command: gunbc.roadmap_dispatch_actuator.host_exec_argv(program: "/usr/bin/true", args: []),
      },
      gunbc.roadmap_belt_actuate.BeltExecStep {
        step: "tmux-event-pipe",
        command: gunbc.roadmap_dispatch_actuator.host_exec_argv(program: "/usr/bin/false", args: []),
      },
      gunbc.roadmap_belt_actuate.BeltExecStep {
        step: "provider-start",
        command: gunbc.roadmap_dispatch_actuator.host_exec_argv(program: "/usr/bin/true", args: []),
      },
    ],
    workdir: "/",
  ) {
    ExecStepsOk => false
    ExecStepFailed { step, detail } =>
      step == "tmux-event-pipe"
        && string_contains(s: detail, pattern: "exit 1")
  }
}

test fn witness_spawn_member_refuses_observed_shape() -> Bool {
  let m = gunbc.roadmap_belt.ObservedMember { node_id: "z", session: live_session(node_id: "z", verdict: std.upsert_decision.Converged) }
  is_spawn_failed(o: gunbc.roadmap_belt_actuate.belt_actuate_spawn_member(m: m, workdir: "/"))
}

test fn witness_teardown_member_refuses_desired_shape() -> Bool {
  let m = gunbc.roadmap_belt.DesiredMember { node_id: "a", node: ready_node(id: "a") }
  is_teardown_failed(o: gunbc.roadmap_belt_actuate.belt_actuate_teardown_member(m: m))
}

fn observe_live_count(o: gunbc.roadmap_belt_actuate.BeltObserve) -> Int {
  match o {
    Observed { live: live } => count(live)
    ObserveRefused { reason: _ } => -1
  }
}

fn is_observe_refused(o: gunbc.roadmap_belt_actuate.BeltObserve) -> Bool {
  match o {
    ObserveRefused { reason: _ } => true
    Observed { live: _ } => false
  }
}

test fn witness_observe_parses_live_on_success() -> Bool {
  match extdeps.tmux.classify_tmux_session_list(
    exit_ok: true,
    stdout: "gunbc-dispatch-a: 1 windows",
    stderr: "",
  ) {
    TmuxSessionsListed { entries } =>
      count(gunbc.roadmap_dispatch_actuator.filter_dispatch_tmux_sessions(entries: entries)) == 1
    _ => false
  }
}

test fn witness_observe_empty_on_no_server() -> Bool {
  observe_live_count(o: gunbc.roadmap_belt_actuate.belt_observe_from_result(
    success: false,
    stdout: "",
    stderr: "no server running on /tmp/tmux-1000/default",
  )) == 0
}

test fn witness_observe_empty_on_no_sessions() -> Bool {
  observe_live_count(o: gunbc.roadmap_belt_actuate.belt_observe_from_result(
    success: false,
    stdout: "",
    stderr: "no sessions",
  )) == 0
}

test fn witness_observe_empty_on_no_server_enoent() -> Bool {
  observe_live_count(o: gunbc.roadmap_belt_actuate.belt_observe_from_result(
    success: false,
    stdout: "",
    stderr: "error connecting to /tmp/tmux-1000/srv1-green (No such file or directory)",
  )) == 0
}

test fn witness_observe_refuses_connection_refused() -> Bool {
  let stderr = "error connecting to /tmp/tmux-1000/srv1-green (Connection refused)"
  match gunbc.roadmap_belt_actuate.belt_observe_from_result(success: false, stdout: "", stderr: stderr) {
    ObserveRefused { reason } => string_contains(s: reason, pattern: stderr)
    Observed { live: _ } => false
  }
}

test fn witness_observe_refuses_permission_error() -> Bool {
  is_observe_refused(o: gunbc.roadmap_belt_actuate.belt_observe_from_result(
    success: false,
    stdout: "",
    stderr: "error connecting to /tmp/tmux-1000/default (Permission denied)",
  ))
}

test fn witness_observe_refuses_malformed_stdout() -> Bool {
  match gunbc.roadmap_belt_actuate.belt_observe_from_result(
    success: true,
    stdout: "gunbc-dispatch-a: malformed\n",
    stderr: "",
  ) {
    ObserveRefused { reason } =>
      string_contains(s: reason, pattern: "stdout parse refused")
        && string_contains(s: reason, pattern: "malformed")
    Observed { live: _ } => false
  }
}

test fn witness_observe_refuses_empty_stderr_failure() -> Bool {
  is_observe_refused(o: gunbc.roadmap_belt_actuate.belt_observe_from_result(
    success: false,
    stdout: "",
    stderr: "",
  ))
}

fn uuid_char(u: String, i: Int) -> String {
  substring(s: u, start: i, end: i + 1)
}

test fn witness_uuid_deterministic() -> Bool {
  let a = gunbc.roadmap_belt_actuate.belt_spawn_session_uuid(node_id: "5-regen-cutover", probed_at: "2026-07-25T20:00:00Z")
  let b = gunbc.roadmap_belt_actuate.belt_spawn_session_uuid(node_id: "5-regen-cutover", probed_at: "2026-07-25T20:00:00Z")
  a == b
}

test fn witness_uuid_distinct_nodes() -> Bool {
  let a = gunbc.roadmap_belt_actuate.belt_spawn_session_uuid(node_id: "node-a", probed_at: "2026-07-25T20:00:00Z")
  let b = gunbc.roadmap_belt_actuate.belt_spawn_session_uuid(node_id: "node-b", probed_at: "2026-07-25T20:00:00Z")
  !(a == b)
}

test fn witness_uuid_rfc4122_shape() -> Bool {
  let u = gunbc.roadmap_belt_actuate.belt_spawn_session_uuid(node_id: "5-regen-cutover", probed_at: "2026-07-25T20:00:00Z")
  string_length(s: u) == 36
    && uuid_char(u: u, i: 8) == "-"
    && uuid_char(u: u, i: 13) == "-"
    && uuid_char(u: u, i: 18) == "-"
    && uuid_char(u: u, i: 23) == "-"
    && uuid_char(u: u, i: 14) == "4"
    && uuid_char(u: u, i: 19) == "8"
}

fn is_node_found(l: gunbc.roadmap_belt_actuate.BeltNodeLookup) -> Bool {
  match l {
    NodeFound { node: _ } => true
    NodeMissing => false
    AuthorityProjectionRefused { detail: _ } => false
  }
}

test fn witness_find_node_hits() -> Bool {
  is_node_found(l: gunbc.roadmap_belt_actuate.belt_find_node_in(nodes: [ready_node(id: "a"), ready_node(id: "b")], node_id: "b"))
}

test fn witness_find_node_misses() -> Bool {
  !is_node_found(l: gunbc.roadmap_belt_actuate.belt_find_node_in(nodes: [ready_node(id: "a"), ready_node(id: "b")], node_id: "z"))
}

fn owned_node(id: String, owner: String) -> gunbc.roadmap_model.RoadmapNode {
  gunbc.roadmap_model.RoadmapNode {
    identity: "rnfx_F2RWDMNTDKS0ZR1P4VNZ" as gunbc.roadmap_model.RoadmapNodeIdentity,
    node: roadmap_belt_actuate_nid(s: id),
    line: gunbc.roadmap_status.DerivableLine { prs: [1], title: id, description: "" },
    carriers: [],
    sizing: gunbc.roadmap_model.Sized { intricacy: gunbc.roadmap_model.IntricacyHigh, volume: gunbc.roadmap_model.VolumeMedium, repo: "gunbc", acceptance: gunbc.roadmap_model.PrsMerged },
    execution: gunbc.roadmap_execution_contract.ExecutionContractUnspecified,
    owner: owner,
    signoff: gunbc.roadmap_status.Unsigned,
  }
}

fn found_owner(l: gunbc.roadmap_belt_actuate.BeltNodeLookup) -> String {
  match l {
    NodeFound { node: n } => n.owner
    NodeMissing => ""
    AuthorityProjectionRefused { detail: _ } => ""
  }
}

test fn witness_find_node_first_wins_on_duplicate() -> Bool {
  found_owner(l: gunbc.roadmap_belt_actuate.belt_find_node_in(
    nodes: [owned_node(id: "dup", owner: "first"), owned_node(id: "dup", owner: "second")],
    node_id: "dup",
  )) == "first"
}

// LIVENESS IS DERIVED FROM PROCESS EVIDENCE, NOT FROM A SESSION NAME. The prior pair of
// witnesses asserted that a session row matching the node id IS live, over a helper whose
// worker evidence is the placeholder whose own reason reads "tmux name presence does not
// observe pane liveness or exit". They therefore pinned the defect: a retained dead pane
// answered live, DispatchAlreadyLive returned through the accepted band, and the operator
// got a positive acknowledgement with no agent. Both are replaced rather than kept beside
// the new ones, because the true arm asserted the exact behaviour that is now wrong.
test fn witness_node_session_running_is_live() -> Bool {
  match gunbc.roadmap_belt_actuate.belt_node_session_liveness(
    live: [live_session_with_process(
      node_id: "a",
      process: gunbc.worker_lifecycle.WorkerProcessRunning { command: "codex" as std.types.NonEmptyStr },
    )],
    node_id: "a",
  ) {
    BeltSessionRunning { session_name: _, command: c } => c == "codex"
    _ => false
  }
}

test fn witness_node_session_absent_is_not_live() -> Bool {
  match gunbc.roadmap_belt_actuate.belt_node_session_liveness(
    live: [live_session_with_process(
      node_id: "a",
      process: gunbc.worker_lifecycle.WorkerProcessRunning { command: "codex" as std.types.NonEmptyStr },
    )],
    node_id: "b",
  ) {
    BeltSessionAbsent => true
    _ => false
  }
}

// THE DISCRIMINATING RED for the dead-pane defect: a present session whose pane exited is
// NOT live, so it cannot suppress a spawn. Under the prior any(node_id) check this returned
// true and the click was answered "already_live".
test fn witness_retained_dead_pane_is_not_live() -> Bool {
  match gunbc.roadmap_belt_actuate.belt_node_session_liveness(
    live: [live_session_with_process(
      node_id: "a",
      process: gunbc.worker_lifecycle.WorkerProcessExited { exit_code: 0, last_command: "codex" },
    )],
    node_id: "a",
  ) {
    BeltSessionStaleTerminal { session_name: _, detail: _ } => true
    _ => false
  }
}

// The honest third state refuses in BOTH directions: it is not live (so it never reports a
// running agent) and it is not the absent path either — the dispatch fold routes it to
// DispatchSessionLivenessUnobserved rather than spawning blind.
test fn witness_unobserved_liveness_is_not_live() -> Bool {
  match gunbc.roadmap_belt_actuate.belt_node_session_liveness(
    live: [live_session(node_id: "a", verdict: std.upsert_decision.Converged)],
    node_id: "a",
  ) {
    BeltSessionLivenessUnobserved { session_name: _, reason: _ } => true
    _ => false
  }
}

test fn witness_session_liveness_is_four_valued() -> Bool {
  let running = gunbc.roadmap_belt_actuate.belt_node_session_liveness(
    live: [live_session_with_process(
      node_id: "a",
      process: gunbc.worker_lifecycle.WorkerProcessRunning { command: "codex" as std.types.NonEmptyStr },
    )],
    node_id: "a",
  )
  let dead = gunbc.roadmap_belt_actuate.belt_node_session_liveness(
    live: [live_session_with_process(
      node_id: "a",
      process: gunbc.worker_lifecycle.WorkerProcessExited { exit_code: 3, last_command: "codex" },
    )],
    node_id: "a",
  )
  let unobserved = gunbc.roadmap_belt_actuate.belt_node_session_liveness(
    live: [live_session(node_id: "a", verdict: std.upsert_decision.Converged)],
    node_id: "a",
  )
  let absent = gunbc.roadmap_belt_actuate.belt_node_session_liveness(live: [], node_id: "a")
  (match running { BeltSessionRunning { session_name: _, command: c } => c == "codex" _ => false })
    && (match dead { BeltSessionStaleTerminal { session_name: _, detail: d } => string_contains(s: d, pattern: "status 3") _ => false })
    && (match unobserved { BeltSessionLivenessUnobserved { session_name: _, reason: _ } => true _ => false })
    && (match absent { BeltSessionAbsent => true _ => false })
}

// The stale and unobserved arms must never reach the ok band — an accepted no-op is the
// failure this change exists to remove, and the band is the single ok-authority.
test fn witness_stale_session_is_never_ok() -> Bool {
  !gunbc.roadmap_belt_actuate.belt_dispatch_result_ok(r: gunbc.roadmap_belt_actuate.DispatchStaleSession { node_id: "a", session_name: "s", detail: "d" })
    && !gunbc.roadmap_belt_actuate.belt_dispatch_result_ok(r: gunbc.roadmap_belt_actuate.DispatchSessionLivenessUnobserved { node_id: "a", session_name: "s", reason: "r" })
    && gunbc.roadmap_belt_actuate.belt_dispatch_status_label(r: gunbc.roadmap_belt_actuate.DispatchStaleSession { node_id: "a", session_name: "s", detail: "d" }) == "stale_session"
}

test fn witness_dispatch_result_ok_spawned_and_live() -> Bool {
  gunbc.roadmap_belt_actuate.belt_dispatch_result_ok(r: gunbc.roadmap_belt_actuate.DispatchSpawned { node_id: "a", session_name: "gunbc-dispatch-a", provider: "codex" })
    && gunbc.roadmap_belt_actuate.belt_dispatch_result_ok(r: gunbc.roadmap_belt_actuate.DispatchAlreadyLive { node_id: "a", session_name: "gunbc-dispatch-a" })
}

test fn witness_dispatch_result_refusals_not_ok() -> Bool {
  !gunbc.roadmap_belt_actuate.belt_dispatch_result_ok(r: gunbc.roadmap_belt_actuate.DispatchDisabled { node_id: "a", instance_id: "preview", reason: "observe-only" })
    && !gunbc.roadmap_belt_actuate.belt_dispatch_result_ok(r: gunbc.roadmap_belt_actuate.DispatchNodeNotFound { node_id: "a" })
    && !gunbc.roadmap_belt_actuate.belt_dispatch_result_ok(r: gunbc.roadmap_belt_actuate.DispatchNodeAlreadyDone { node_id: "a" })
    && !gunbc.roadmap_belt_actuate.belt_dispatch_result_ok(r: gunbc.roadmap_belt_actuate.DispatchObserveRefused { node_id: "a", reason: "x" })
    && !gunbc.roadmap_belt_actuate.belt_dispatch_result_ok(r: gunbc.roadmap_belt_actuate.DispatchSpawnFailed { node_id: "a", step: "git", detail: "x", provider: "codex" })
}

fn status_label_glued_to_ok(r: gunbc.roadmap_belt_actuate.BeltDispatchResult) -> Bool {
  let ok = gunbc.roadmap_belt_actuate.belt_dispatch_result_ok(r: r)
  let label_in_ok_set = any(gunbc.roadmap_belt_actuate.belt_dispatch_ok_status_labels(), l => l == gunbc.roadmap_belt_actuate.belt_dispatch_status_label(r: r))
  ok == label_in_ok_set
}

test fn witness_dispatch_status_labels_glued_to_ok_set() -> Bool {
  status_label_glued_to_ok(r: gunbc.roadmap_belt_actuate.DispatchSpawned { node_id: "a", session_name: "s", provider: "codex" })
    && status_label_glued_to_ok(r: gunbc.roadmap_belt_actuate.DispatchAlreadyLive { node_id: "a", session_name: "s" })
    && status_label_glued_to_ok(r: gunbc.roadmap_belt_actuate.DispatchDisabled { node_id: "a", instance_id: "preview", reason: "observe-only" })
    && status_label_glued_to_ok(r: gunbc.roadmap_belt_actuate.DispatchNodeNotFound { node_id: "a" })
    && status_label_glued_to_ok(r: gunbc.roadmap_belt_actuate.DispatchNodeAlreadyDone { node_id: "a" })
    && status_label_glued_to_ok(r: gunbc.roadmap_belt_actuate.DispatchObserveRefused { node_id: "a", reason: "x" })
    && status_label_glued_to_ok(r: gunbc.roadmap_belt_actuate.DispatchSpawnFailed { node_id: "a", step: "git", detail: "x", provider: "codex" })
}

test fn witness_dispatch_status_labels_pin_wire_contract() -> Bool {
  gunbc.roadmap_belt_actuate.belt_dispatch_status_label(r: gunbc.roadmap_belt_actuate.DispatchSpawned { node_id: "a", session_name: "s", provider: "codex" }) == "spawned"
    && gunbc.roadmap_belt_actuate.belt_dispatch_status_label(r: gunbc.roadmap_belt_actuate.DispatchAlreadyLive { node_id: "a", session_name: "s" }) == "already_live"
    && gunbc.roadmap_belt_actuate.belt_dispatch_status_label(r: gunbc.roadmap_belt_actuate.DispatchDisabled { node_id: "a", instance_id: "preview", reason: "observe-only" }) == "disabled"
    && gunbc.roadmap_belt_actuate.belt_dispatch_status_label(r: gunbc.roadmap_belt_actuate.DispatchNodeNotFound { node_id: "a" }) == "node_not_found"
    && gunbc.roadmap_belt_actuate.belt_dispatch_status_label(r: gunbc.roadmap_belt_actuate.DispatchNodeAlreadyDone { node_id: "a" }) == "already_done_signed_off"
    && gunbc.roadmap_belt_actuate.belt_dispatch_status_label(r: gunbc.roadmap_belt_actuate.DispatchObserveRefused { node_id: "a", reason: "x" }) == "observe_refused"
    && gunbc.roadmap_belt_actuate.belt_dispatch_status_label(r: gunbc.roadmap_belt_actuate.DispatchAuthorityRefused { node_id: "a", detail: "x" }) == "authority_refused"
    && gunbc.roadmap_belt_actuate.belt_dispatch_status_label(r: gunbc.roadmap_belt_actuate.DispatchSpawnFailed { node_id: "a", step: "git", detail: "x", provider: "codex" }) == "spawn_failed"
}

test fn witness_fresh_spawn_wire_names_selected_provider() -> Bool {
  string_contains(
    s: extdeps.languages.json.emit.serialize_json(v: gunbc.roadmap_belt_actuate.belt_dispatch_result_json_value(
      r: gunbc.roadmap_belt_actuate.DispatchSpawned { node_id: "a", session_name: "s", provider: "codex" })),
    pattern: "\"provider\": \"codex\"")
    && string_contains(
      s: extdeps.languages.json.emit.serialize_json(v: gunbc.roadmap_belt_actuate.belt_dispatch_result_json_value(
        r: gunbc.roadmap_belt_actuate.DispatchSpawnFailed { node_id: "a", step: "codex-auth", detail: "not logged in", provider: "codex" })),
      pattern: "\"provider\": \"codex\"")
}

fn band_key_for_label(label: String) -> String {
  let hit = gunbc.roadmap_belt_actuate.belt_dispatch_label_band_rows() |> filter(row => row.wire_label == label) |> first
  match hit {
    Present { value: row } => row.band_key
    Absent => "band-row-missing"
  }
}

test fn witness_band_fold_pins_operator_vocabulary() -> Bool {
  gunbc.roadmap_belt_actuate.belt_dispatch_label_band_rows().length() == 13
    && band_key_for_label(label: "stale_session") == "loud"
    && band_key_for_label(label: "session_liveness_unobserved") == "loud"
    && band_key_for_label(label: "deployed_revision_drifted") == "loud"
    && band_key_for_label(label: "deployed_revision_unobserved") == "loud"
    && band_key_for_label(label: "session_multiplicity_conflict") == "loud"
    && band_key_for_label(label: "spawned") == "ok"
    && band_key_for_label(label: "already_live") == "ok"
    && band_key_for_label(label: "disabled") == "fail"
    && band_key_for_label(label: "node_not_found") == "fail"
    && band_key_for_label(label: "already_done_signed_off") == "fail"
    && band_key_for_label(label: "observe_refused") == "loud"
    && band_key_for_label(label: "authority_refused") == "loud"
    && band_key_for_label(label: "spawn_failed") == "loud"
}

test fn witness_no_result_maps_to_in_progress() -> Bool {
  all(gunbc.roadmap_belt_actuate.belt_dispatch_label_band_rows(), row => row.band_key != "in-progress")
}

test fn witness_ok_labels_derive_from_band_fold() -> Bool {
  gunbc.roadmap_belt_actuate.belt_dispatch_ok_status_labels() == ["spawned", "already_live"]
}

test fn witness_label_band_cover_reds_on_missing_row() -> Bool {
  let rows = gunbc.roadmap_belt_actuate.belt_dispatch_label_band_rows()
  let labels = gunbc.roadmap_belt_actuate.belt_dispatch_all_status_labels()
  let truncated = filter(rows, row => row.wire_label != "spawned")
  gunbc.roadmap_belt_actuate.label_band_rows_cover(rows: rows, labels: labels)
    && !gunbc.roadmap_belt_actuate.label_band_rows_cover(rows: truncated, labels: labels)
}

data d4_exemplar_reconcile_note: String = "D4: belt_dispatch_result_exemplars is a HAND roster (one exemplar per BeltDispatchResult arm), enrolled DeclaredFrontier in gunbc.roster_registry. belt_dispatch_status_label's total match walls a new VARIANT at compile time, but nothing ties the exemplar LIST to the variant set — a missed exemplar silently narrows belt_dispatch_all_status_labels AND the component wire-total that reads it, while the live server emits the unmodeled label. This reconciles the exemplar-derived label set against the independent wire-contract pin (the same labels witness_dispatch_status_labels_pin_wire_contract pins), and the RED control proves a missing-variant list reds. Dissolves when inhabitance enumeration or the serve-JSON total match replaces the hand list."

fn d4_wire_contract_labels() -> List<String> {
  [
    "spawned",
    "already_live",
    "disabled",
    "node_not_found",
    "already_done_signed_off",
    "observe_refused",
    "authority_refused",
    "spawn_failed",
    "stale_session",
    "session_liveness_unobserved",
    "deployed_revision_drifted",
    "deployed_revision_unobserved",
    "session_multiplicity_conflict",
  ]
}

fn d4_exemplars_reconcile(exemplars: List<gunbc.roadmap_belt_actuate.BeltDispatchResult>) -> Bool {
  map(exemplars, r => gunbc.roadmap_belt_actuate.belt_dispatch_status_label(r: r)) == d4_wire_contract_labels()
}

test fn witness_exemplar_roster_reconciles_variant_set() -> Bool {
  d4_exemplars_reconcile(exemplars: gunbc.roadmap_belt_actuate.belt_dispatch_result_exemplars())
    && gunbc.roadmap_belt_actuate.belt_dispatch_all_status_labels() == d4_wire_contract_labels()
}

fn d4_exemplars_missing_one() -> List<gunbc.roadmap_belt_actuate.BeltDispatchResult> {
  [
    gunbc.roadmap_belt_actuate.DispatchSpawned { node_id: "a", session_name: "s", provider: "codex" },
    gunbc.roadmap_belt_actuate.DispatchAlreadyLive { node_id: "a", session_name: "s" },
    gunbc.roadmap_belt_actuate.DispatchDisabled { node_id: "a", instance_id: "preview", reason: "observe-only" },
    gunbc.roadmap_belt_actuate.DispatchNodeNotFound { node_id: "a" },
    gunbc.roadmap_belt_actuate.DispatchNodeAlreadyDone { node_id: "a" },
    gunbc.roadmap_belt_actuate.DispatchObserveRefused { node_id: "a", reason: "x" },
  ]
}

test fn witness_exemplar_roster_missing_variant_reds() -> Bool {
  !d4_exemplars_reconcile(exemplars: d4_exemplars_missing_one())
}

fn preflight_refused_step(p: gunbc.roadmap_belt_actuate.BeltClaudePreflight) -> String {
  match p {
    ClaudePreflightRefused { step: st, detail: _ } => st
    ClaudePreflightOk => ""
  }
}

fn preflight_ok(p: gunbc.roadmap_belt_actuate.BeltClaudePreflight) -> Bool {
  match p {
    ClaudePreflightOk => true
    ClaudePreflightRefused { step: _, detail: _ } => false
  }
}

fn seeded_trust_config() -> String {
  "\{\"projects\":\{\"/opt/x/worktrees\":\{\"hasTrustDialogAccepted\":true\}\}\}"
}

fn preflight_with_config(config: String) -> gunbc.roadmap_belt_actuate.BeltClaudePreflight {
  gunbc.roadmap_belt_actuate.belt_claude_preflight_decision(
    claude_on_path: true,
    home: "/home/u",
    trust_store_path: "/home/u/.claude.json",
    trust_store_readable: true,
    trust_store_text: config,
    trust_root: "/opt/x/worktrees",
  )
}

