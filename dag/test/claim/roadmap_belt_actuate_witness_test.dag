      spawn_failure_present: false,
      spawn_failure: "",
      provider_events_readable: true,
      provider_events: "",
      provider_events_error: "",
      process: gunbc.worker_lifecycle.WorkerProcessRunning { command: "codex" },
      validation_summary: "gunbc run --claim-run",
      verification_subject: gunbc.roadmap_verification_receipt.VerificationSubjectUnobserved {
        reason: "fixture verification subject not established",
      },
      verification_selection: gunbc.roadmap_verification_receipt.SelectionAbsent,
      verification_source: gunbc.roadmap_verification_receipt.VerificationReceiptAbsent,
      publication_subject: gunbc.roadmap_publish.PublicationSubjectObserved {
        subject: gunbc.roadmap_publish.RoadmapPublicationSubject {
          node_id: "pub-fixture-node",
          attempt_key: "feedfacefeedface",
          repository: extdeps.github.github.Repository {
            owner: "gunb-ai",
            name: "gunbc",
            full_name: "gunb-ai/gunbc",
            private: false,
            default_branch: "main",
          },
          branch: "dispatch/pub-fixture-node-afeedfacefeedface" as std.types.NonEmptyStr,
          expected_base: "main" as std.types.NonEmptyStr,
          expected_head: "cafecafecafecafecafecafecafecafecafecafe" as std.types.CommitSha,
        },
      },
      publication_source: gunbc.roadmap_publish.ReceiptSourceAbsent,
    }),
  ) {
    VerifyDeferred { node_id: _, reason } =>
      string_contains(s: reason, pattern: "agent obligation is not satisfied")
    VerifyEvidenceUnreadable { node_id: _, detail: _ } => false
    VerifyRefused { node_id: _, cause: _ } => false
    VerifyRecorded { node_id: _, verdict_key: _, detail: _ } => false
    VerifyWriteFailed { node_id: _, detail: _ } => false
  }
}

test fn dashboard_instance_dispatch_contract_keystone_holds() -> Bool {
  witness_dispatch_result_ok_spawned_and_live()
    && witness_dispatch_result_refusals_not_ok()
    && witness_dispatch_status_labels_glued_to_ok_set()
    && witness_dispatch_status_labels_pin_wire_contract()
    && witness_band_fold_pins_operator_vocabulary()
    && witness_no_result_maps_to_in_progress()
    && witness_ok_labels_derive_from_band_fold()
    && witness_label_band_cover_reds_on_missing_row()
    && witness_exemplar_roster_reconciles_variant_set()
    && witness_exemplar_roster_missing_variant_reds()
    && codex_provider_v0_preflight_keystone_holds()
    && oracle_refs_projection_runs_and_selects_pinnable_scopes()
    && verify_without_observable_subject_defers_instead_of_rerunning()
    && agent_incomplete_attempt_defers_verification()
    && observe_refused_spawn_does_not_zero_verify_pass()
    && observe_refused_with_empty_verify_is_deferred_not_recorded()
    && unknown_spawn_workdir_refuses_instance_resolution()
    && the_known_spawn_workdir_resolves_to_its_own_instance()
    && verification_presentation_absent_receipt_is_queued()
    && verification_presentation_unreadable_receipt_is_blocked()
    && verification_presentation_decouples_verify_from_spawn_observe_refusal()
    && verification_presentation_verify_refused_is_blocked()
    && verification_presentation_verify_failed_is_failed()
    && verification_presentation_wire_carries_detail()
    && malformed_pass_reason_makes_receipt_unreadable()
    && belt_tick_receipt_missing_file_read_is_absent()
    && belt_tick_receipt_io_failure_read_is_unreadable()
}

test fn unknown_spawn_workdir_refuses_instance_resolution() -> Bool {
  match gunbc.roadmap_belt_actuate.belt_dashboard_instance_lookup_for_spawn_workdir(workdir: "/typo/gunbc") {
    UnknownSpawnWorkdir { workdir: w } => w == "/typo/gunbc"
    SpawnWorkdirInstanceResolved { instance: _ } => false
  }
}

// NARROWED, and the first attempt at this was wrong in a way worth recording. The claim used to
// assert that two known spawn workdirs resolve to DIFFERENT instances, with the deleted green slot
// as the second one. Re-enrolling it against srv1-lab looked right and failed by execution: the
// lookup's population is the instances this belt actuates, and the lab was never in it, so the lab
// root resolves to UnknownSpawnWorkdir. Distinctness is not something the lookup can be asked about
// any more -- it knows exactly one workdir -- and that is a consequence of the single deployment
// rather than a guarantee that was dropped.
//
// So this asserts the arm that still exists: the known workdir resolves, and it resolves to the
// instance that owns it. Retiring outright would have left only
// unknown_spawn_workdir_refuses_instance_resolution enrolled, and a lookup that refused EVERY
// workdir would then pass the file -- the resolved arm needs its own claim precisely because the
// refusal arm cannot detect its absence.
test fn the_known_spawn_workdir_resolves_to_its_own_instance() -> Bool {
  let live = gunbc.roadmap_dashboard_instance.srv1_live_dashboard_instance()
  match gunbc.roadmap_belt_actuate.belt_dashboard_instance_lookup_for_spawn_workdir(workdir: live.repo_root as String) {
    SpawnWorkdirInstanceResolved { instance: resolved } =>
      (resolved.instance_id as String) == (live.instance_id as String)
    UnknownSpawnWorkdir { workdir: _ } => false
  }
}

data belt_tick_decouple_witness_note: String = "RED control (operator P1, 2026-08-02): a tmux-list refusal must NOT zero the verify pass. The defect class was belt_tick returning empty verify_outcomes on ObserveRefused — an absorbing fallback that made the whole tick look like verification never ran. The witness constructs the post-fix shape synthetically: spawn_pass is Refused while verify_pass is still Recorded when verify outcomes exist."

test fn observe_refused_spawn_does_not_zero_verify_pass() -> Bool {
  let result = gunbc.roadmap_belt_actuate.BeltTickResult {
    observe_refused: true,
    observe_refusal_reason: "belt_observe: tmux ls failed; session containers are unknowable",
    reconcile: gunbc.roadmap_belt_actuate.belt_tick_empty_reconcile(state: gunbc.roadmap_belt.Running),
    spawn_outcomes: [],
    teardown_outcomes: [],
    verify_outcomes: [
      gunbc.roadmap_belt_actuate.VerifyRecorded {
        node_id: "v2-emitter-producer-provenance",
        verdict_key: "refused",
        detail: "validation refused",
      },
    ],
    publish_outcomes: [],
  }
  let receipt = gunbc.roadmap_belt_actuate.belt_tick_receipt_from_result(
    result: result,
    observed_at: "2026-08-02T02:00:00Z",
  )
  match receipt.spawn_pass {
    BeltPassRefused { reason: _ } => true
    _ => false
  }
    && match receipt.verify_pass {
      BeltPassRecorded => true
      _ => false
    }
}

test fn observe_refused_with_empty_verify_is_deferred_not_recorded() -> Bool {
  let result = gunbc.roadmap_belt_actuate.BeltTickResult {
    observe_refused: true,
    observe_refusal_reason: "tmux refused",
    reconcile: gunbc.roadmap_belt_actuate.belt_tick_empty_reconcile(state: gunbc.roadmap_belt.Running),
    spawn_outcomes: [],
    teardown_outcomes: [],
    verify_outcomes: [
      gunbc.roadmap_belt_actuate.VerifyDeferred {
        node_id: "node-a",
        reason: "agent obligation is not satisfied",
      },
    ],
    publish_outcomes: [],
  }
  match gunbc.roadmap_belt_actuate.belt_tick_receipt_from_result(
    result: result,
    observed_at: "2026-08-02T02:00:00Z",
  ).verify_pass {
    BeltPassDeferred { reason: _ } => true
    BeltPassRecorded => false
    BeltPassRefused { reason: _ } => false
    BeltPassFailed { reason: _ } => false
  }
}

data verification_presentation_witness_note: String = "review 47210 spec-without-execution: decoupling is witnessed at the receipt layer but the presentation join had no executing consumer. These rows execute belt_verification_presentation_detail and the wire join against synthetic tick reads so the headline strings ('Verification queued - next belt tick', 'Verification blocked · …', observe-refusal vs verify-recorded at the UI layer) cannot drift without going red."

test fn verification_presentation_absent_receipt_is_queued() -> Bool {
  gunbc.roadmap_belt_actuate.belt_verification_presentation_detail(
    progress: completed_attempt_progress(node_id: "pres-absent-node"),
    tick_read: gunbc.roadmap_belt_actuate.BeltTickReceiptAbsent,
  ) == "Verification queued - next belt tick"
}

test fn verification_presentation_unreadable_receipt_is_blocked() -> Bool {
  let detail = gunbc.roadmap_belt_actuate.belt_verification_presentation_detail(
    progress: completed_attempt_progress(node_id: "pres-unreadable-node"),
    tick_read: gunbc.roadmap_belt_actuate.BeltTickReceiptUnreadable { reason: "belt tick receipt schema is unknown" },
  )
  string_contains(s: detail, pattern: "Verification blocked · belt tick receipt unreadable: ")
    && string_contains(s: detail, pattern: "schema is unknown")
}

test fn verification_presentation_decouples_verify_from_spawn_observe_refusal() -> Bool {
  let receipt = gunbc.roadmap_belt_actuate.belt_tick_receipt_from_result(
    result: gunbc.roadmap_belt_actuate.BeltTickResult {
      observe_refused: true,
      observe_refusal_reason: "belt_observe: tmux ls failed; session containers are unknowable",
      reconcile: gunbc.roadmap_belt_actuate.belt_tick_empty_reconcile(state: gunbc.roadmap_belt.Running),
      spawn_outcomes: [],
      teardown_outcomes: [],
      verify_outcomes: [
        gunbc.roadmap_belt_actuate.VerifyRecorded {
          node_id: "v2-emitter-producer-provenance",
          verdict_key: "refused",
          detail: "validation refused",
        },
      ],
      publish_outcomes: [],
    },
    observed_at: "2026-08-02T02:00:00Z",
  )
  let detail = gunbc.roadmap_belt_actuate.belt_verification_presentation_detail(
    progress: completed_attempt_progress(node_id: "pres-decouple-node"),
    tick_read: gunbc.roadmap_belt_actuate.BeltTickReceiptPresent { receipt: receipt },
  )
  !string_contains(s: detail, pattern: "tmux ls failed")
    && string_contains(s: detail, pattern: "Verification queued")
}

test fn verification_presentation_verify_refused_is_blocked() -> Bool {
  let receipt = gunbc.roadmap_belt_actuate.BeltTickReceipt {
    observed_at: "2026-08-02T02:00:00Z",
    spawn_pass: gunbc.roadmap_belt_actuate.BeltPassRecorded,
    teardown_pass: gunbc.roadmap_belt_actuate.BeltPassRecorded,
    verify_pass: gunbc.roadmap_belt_actuate.BeltPassRefused { reason: "validation receipt could not be read" },
    publish_pass: gunbc.roadmap_belt_actuate.BeltPassDeferred { reason: "publish waits on verify" },
  }
  let detail = gunbc.roadmap_belt_actuate.belt_verification_presentation_detail(
    progress: completed_attempt_progress(node_id: "pres-verify-refused-node"),
    tick_read: gunbc.roadmap_belt_actuate.BeltTickReceiptPresent { receipt: receipt },
  )
  detail == "Verification blocked · validation receipt could not be read"
}

test fn verification_presentation_verify_failed_is_failed() -> Bool {
  let receipt = gunbc.roadmap_belt_actuate.BeltTickReceipt {
    observed_at: "2026-08-02T02:00:00Z",
    spawn_pass: gunbc.roadmap_belt_actuate.BeltPassRecorded,
    teardown_pass: gunbc.roadmap_belt_actuate.BeltPassRecorded,
    verify_pass: gunbc.roadmap_belt_actuate.BeltPassFailed { reason: "validation verdict failed" },
    publish_pass: gunbc.roadmap_belt_actuate.BeltPassDeferred { reason: "publish waits on verify" },
  }
  let detail = gunbc.roadmap_belt_actuate.belt_verification_presentation_detail(
    progress: completed_attempt_progress(node_id: "pres-verify-failed-node"),
    tick_read: gunbc.roadmap_belt_actuate.BeltTickReceiptPresent { receipt: receipt },
  )
  detail == "Verification failed · validation verdict failed"
}

test fn verification_presentation_wire_carries_detail() -> Bool {
  let j = extdeps.languages.json.emit.serialize_json(v: gunbc.roadmap_belt_actuate.belt_workflow_attempt_presentation_json_with_tick_read(
    progress: completed_attempt_progress(node_id: "pres-wire-node"),
    tick_read: gunbc.roadmap_belt_actuate.BeltTickReceiptAbsent,
  ))
  string_contains(s: j, pattern: "\"verification_presentation\": \"Verification queued - next belt tick\"")
}

test fn malformed_pass_reason_makes_receipt_unreadable() -> Bool {
  let raw = join([
    "{\"schema\":\"roadmap-belt-tick-receipt/v2\",",
    "\"observed_at\":\"2026-08-02T02:00:00Z\",",
    "\"spawn_pass\":{\"outcome\":\"recorded\"},",
    "\"teardown_pass\":{\"outcome\":\"recorded\"},",
    "\"verify_pass\":{\"outcome\":\"refused\"},",
    "\"publish_pass\":{\"outcome\":\"recorded\"}}",
  ], "")
  match gunbc.roadmap_belt_actuate.belt_tick_receipt_decode(raw: raw) {
    BeltTickReceiptUnreadable { reason: r } =>
      string_contains(s: r, pattern: "refused without reason")
    BeltTickReceiptPresent { receipt: _ } => false
    BeltTickReceiptAbsent => false
  }
}

test fn belt_tick_receipt_missing_file_read_is_absent() -> Bool {
  match gunbc.roadmap_belt_actuate.belt_tick_receipt_read_from_filesystem(
    success: false,
    content: "",
    error: "No such file or directory (os error 2)",
  ) {
    BeltTickReceiptAbsent => true
    BeltTickReceiptPresent { receipt: _ } => false
    BeltTickReceiptUnreadable { reason: _ } => false
  }
}

test fn belt_tick_receipt_io_failure_read_is_unreadable() -> Bool {
  match gunbc.roadmap_belt_actuate.belt_tick_receipt_read_from_filesystem(
    success: false,
    content: "",
    error: "Permission denied (os error 13)",
  ) {
    BeltTickReceiptUnreadable { reason: r } =>
      string_contains(s: r, pattern: "Permission denied")
    BeltTickReceiptPresent { receipt: _ } => false
    BeltTickReceiptAbsent => false
  }
}

data attempt_grain_home_note: String = "The attempt-grain claim (U1) is PURE — content hashes and string derivations, no host reach — so it lives in dag/test/claim/dispatch_attempts_witness_test.dag, which discovery scans on every affected PR. This file is BinWitnessWet-excluded because its witnesses execute real host commands; a pure row parked here is enrolled with zero executing consumers, which is exactly what the Phase 0(b) admission invariant refused (CI 30184138800). Deferral is a property of the EXECUTION the row needs, never of the module it happens to name."

data observe_only_posture_behavioral_note: String = "review 44039/44043 predicate dissolution. dashboard_instance_can_actuate was a Bool nickname for a two-variant coproduct test, so both belt entrypoints now match DashboardActuationPosture directly. Deleting the predicate would have deleted its only assertions with it, and those assertions never proved the wiring anyway — they restated the posture field. This proves the behaviour instead: an observe-only instance REFUSES at both entrypoints, before any observation, provider preflight, or worktree creation. Only the refusing arm is exercised because it short-circuits; the actuating arm would reach live tmux."

test fn observe_only_instance_refuses_dispatch_and_stop() -> Bool {
  let preview = srv2_preview_dashboard_instance()
  let dispatched = gunbc.roadmap_belt_actuate.belt_dispatch_node_for_instance(
    instance: preview,
    node_id: "namespace-canonical-binding",
  )
  let stopped = gunbc.roadmap_belt_actuate.belt_stop_node_for_instance(
    instance: preview,
    node_id: "namespace-canonical-binding",
  )
  match dispatched {
    DispatchDisabled { node_id, instance_id, reason: _ } =>
      node_id == "namespace-canonical-binding"
        && instance_id == (preview.instance_id as String)
    _ => false
  }
    && match stopped {
      StopDisabled { node_id, instance_id, reason: _ } =>
        node_id == "namespace-canonical-binding"
          && instance_id == (preview.instance_id as String)
      _ => false
    }
}

data footprint_admission_witness_note: String = "Every arm of belt_footprint_admission_decision is exercised on SYNTHETIC observations, the same discipline belt_claude_preflight_decision and belt_observe_from_result already follow: the decision is a pure fn over facts, so its arms are witnessable without a host, and the live half (belt_footprint_observe) only threads real probe results into it. The arms are not interchangeable and the tests say why — absent, unwritable, and unsearchable name three different remedies (converge the member, fix ownership drift, fix the mode), which is the whole point of not collapsing them into one `unusable` Bool. The short-circuit witness is the load-bearing one for operator experience: with two bad roots the FIRST is reported rather than the last, so the refusal names the member a human should look at first rather than whichever happened to sort last."

fn footprint_obs(
  member: String,
  present: Bool,
  writable: Bool,
  searchable: Bool,
) -> gunbc.roadmap_belt_actuate.BeltFootprintObservation {
  gunbc.roadmap_belt_actuate.BeltFootprintObservation {
    member: member,
    path: join(["/opt/gunbc/", member], ""),
    present: present,
    writable: writable,
    searchable: searchable,
  }
}

fn footprint_refusal_step(admission: gunbc.roadmap_belt_actuate.BeltFootprintAdmission) -> String {
  match admission {
    FootprintAdmitted => "admitted"
    FootprintRefused { step: st, detail: _ } => st
  }
}

test fn witness_footprint_all_roots_usable_admits() -> Bool {
  let verdict = gunbc.roadmap_belt_actuate.belt_footprint_admission_decision(observations: [
    footprint_obs(member: "dispatch-worktrees", present: true, writable: true, searchable: true),
    footprint_obs(member: "attempt-state", present: true, writable: true, searchable: true),
  ])
  footprint_refusal_step(admission: verdict) == "admitted"
}

test fn witness_footprint_absent_root_refuses() -> Bool {
  let verdict = gunbc.roadmap_belt_actuate.belt_footprint_admission_decision(observations: [
    footprint_obs(member: "dispatch-worktrees", present: true, writable: true, searchable: true),
    footprint_obs(member: "attempt-state", present: false, writable: false, searchable: false),
  ])
  footprint_refusal_step(admission: verdict) == "footprint-root-absent"
}

test fn witness_footprint_unwritable_root_refuses() -> Bool {
  let verdict = gunbc.roadmap_belt_actuate.belt_footprint_admission_decision(observations: [
    footprint_obs(member: "attempt-state", present: true, writable: false, searchable: true),
  ])
  footprint_refusal_step(admission: verdict) == "footprint-root-unwritable"
}

test fn witness_footprint_unsearchable_root_refuses() -> Bool {
  let verdict = gunbc.roadmap_belt_actuate.belt_footprint_admission_decision(observations: [
    footprint_obs(member: "attempt-state", present: true, writable: true, searchable: false),
  ])
  footprint_refusal_step(admission: verdict) == "footprint-root-unsearchable"
}

test fn witness_footprint_refusal_names_the_first_bad_root() -> Bool {
  let verdict = gunbc.roadmap_belt_actuate.belt_footprint_admission_decision(observations: [
    footprint_obs(member: "dispatch-worktrees", present: false, writable: false, searchable: false),
    footprint_obs(member: "attempt-state", present: true, writable: false, searchable: true),
  ])
  let step_is_first = footprint_refusal_step(admission: verdict) == "footprint-root-absent"
  let names_first = match verdict {
    FootprintRefused { step: _, detail: d } =>
      string_contains(s: d, pattern: "dispatch-worktrees")
    FootprintAdmitted => false
  }
  step_is_first && names_first
}

test fn witness_footprint_roots_cover_both_belt_write_targets() -> Bool {
  let roots = gunbc.roadmap_belt_actuate.belt_dispatch_footprint_roots(instance: srv2_preview_dashboard_instance())
  let paths = join(map(roots, r => r.path), "|")
  let has_worktrees = string_contains(s: paths, pattern: "attempts")
  let has_attempt_state = string_contains(s: paths, pattern: "attempt-state")
  has_worktrees && has_attempt_state
}

data belt_publish_producer_witness_note: String = "THE PRODUCER'S DECISION, EXERCISED WITHOUT A NETWORK OR A FILESYSTEM. belt_publish_attempt_for_instance performs three effects - read the existing receipt, observe the two remote surfaces, write the judgment - and every branch it takes is decided by belt_publish_gate and belt_publish_write_outcome, both pure. That split is what makes these claims possible at all: an arm that fires when a receipt on disk turns out to be about another attempt would otherwise be reachable only by arranging that state on a real host.\\n\\nTHE GATE'S JOB IS TO DECIDE WHETHER TO OBSERVE. Three of the five outcomes are settled by what is already on disk, and none of them should cost a GitHub read or risk overwriting evidence. The claims below pin each: a receipt for this exact subject halts as already-recorded, an undecodable one halts rather than being replaced, one about another subject halts rather than being corrected, and only genuine absence proceeds.\\n\\nTHE SUBJECT IS BUILT FROM AN OBSERVED HEAD OR NOT AT ALL. An attempt whose worktree head cannot be read has no subject, so the producer defers with the reason rather than adjudicating against a branch name - which is the lookup this whole lane replaced."

data belt_pub_head: std.types.CommitSha = "1111111111111111111111111111111111111111"
data belt_pub_other_head: std.types.CommitSha = "2222222222222222222222222222222222222222"

fn belt_pub_subject(head: std.types.CommitSha, node_id: String) -> gunbc.roadmap_publish.RoadmapPublicationSubject {
  gunbc.roadmap_publish.RoadmapPublicationSubject {
    node_id: node_id,
    attempt_key: "feedfacefeedface",
    repository: extdeps.github.github.Repository {
      owner: "gunb-ai",
      name: "gunbc",
      full_name: "gunb-ai/gunbc",
      private: false,
      default_branch: "main",
    },
    branch: "dispatch/belt-pub-node-afeedfacefeedface" as std.types.NonEmptyStr,
    expected_base: "main" as std.types.NonEmptyStr,
    expected_head: head,
  }
}

fn belt_pub_receipt(head: std.types.CommitSha, node_id: String) -> String {
  gunbc.roadmap_publish.publication_receipt_json(
    receipt: gunbc.roadmap_publish.publication_receipt_of(
      subject: belt_pub_subject(head: head, node_id: node_id),
      outcome: gunbc.roadmap_publish.adjudicate_publication(
        pulls: gunbc.roadmap_publish.PullRequestsRead {
          pulls: [
            extdeps.github.pulls.PullRequest {
              number: 1234,
              title: "a change",
              body: none,
              state: extdeps.github.pulls.Open,
              html_url: "https://github.com/gunb-ai/gunbc/pull/1234" as std.types.NonEmptyStr,
              user: extdeps.github.github.GitHubUser { login: "someone", id: 1, type: extdeps.github.github.User },
              head: extdeps.github.pulls.PullRequestRef {
                ref: "dispatch/belt-pub-node-afeedfacefeedface",
                sha: head,
                label: "head",
              },
              base: extdeps.github.pulls.PullRequestRef { ref: "main", sha: belt_pub_other_head, label: "base" },
              created_at: "2026-08-01T00:00:00Z",
              updated_at: "2026-08-01T00:00:00Z",
              merged_at: none,
              draft: false,
            },
          ],
        },
        remotes: gunbc.roadmap_publish.RemoteBranchesRead { branches: [] },
        remote: "https://github.com/gunb-ai/gunbc.git" as std.types.NonEmptyStr,
        branch: "dispatch/belt-pub-node-afeedfacefeedface" as std.types.NonEmptyStr,
        expected_base: "main" as std.types.NonEmptyStr,
        expected_head: head,
      ),
    ),
  )
}

fn belt_pub_gate_key(gate: gunbc.roadmap_belt_actuate.BeltPublishGate) -> String {
  match gate {
    PublishProceed => "proceed"
    PublishHalted { outcome } =>
      match outcome {
        PublishAlreadyRecorded { node_id: _, head_sha: _ } => "already-recorded"
        PublishEvidenceUnreadable { node_id: _, detail: _ } => "evidence-unreadable"
        PublishRecorded { node_id: _, head_sha: _, outcome_key: _ } => "recorded"
        PublishWriteFailed { node_id: _, detail: _ } => "write-failed"
        PublishDeferred { node_id: _, reason: _ } => "deferred"
      }
  }
}

test fn an_absent_receipt_lets_the_publish_producer_proceed() -> Bool {
  belt_pub_gate_key(
    gate: gunbc.roadmap_belt_actuate.belt_publish_gate(
      node_id: "belt-pub-node",
      subject: belt_pub_subject(head: belt_pub_head, node_id: "belt-pub-node"),
      existing: gunbc.roadmap_publish.ReceiptSourceAbsent,
    ),
  ) == "proceed"
}

test fn a_receipt_for_this_head_halts_the_publish_producer() -> Bool {
  belt_pub_gate_key(
    gate: gunbc.roadmap_belt_actuate.belt_publish_gate(
      node_id: "belt-pub-node",
      subject: belt_pub_subject(head: belt_pub_head, node_id: "belt-pub-node"),
      existing: gunbc.roadmap_publish.ReceiptSourcePresent { text: belt_pub_receipt(head: belt_pub_head, node_id: "belt-pub-node") },
    ),
  ) == "already-recorded"
}

test fn a_receipt_about_another_subject_is_not_overwritten() -> Bool {
  match gunbc.roadmap_belt_actuate.belt_publish_gate(
    node_id: "belt-pub-node",
    subject: belt_pub_subject(head: belt_pub_head, node_id: "belt-pub-node"),
    existing: gunbc.roadmap_publish.ReceiptSourcePresent { text: belt_pub_receipt(head: belt_pub_head, node_id: "another-node") },
  ) {
    PublishProceed => false
    PublishHalted { outcome } =>
      match outcome {
        PublishEvidenceUnreadable { node_id, detail } =>
          node_id == "belt-pub-node"
            && string_contains(s: detail, pattern: "another subject")
            && string_contains(s: detail, pattern: "node_id")
            && string_contains(s: detail, pattern: "refuses to overwrite")
        PublishAlreadyRecorded { node_id: _, head_sha: _ } => false
        PublishRecorded { node_id: _, head_sha: _, outcome_key: _ } => false
        PublishWriteFailed { node_id: _, detail: _ } => false
        PublishDeferred { node_id: _, reason: _ } => false
      }
  }
}

data unreadable_is_not_absent_note: String = "THE DEFECT THIS REFUSES, from review 46148: an I/O failure reading an existing receipt used to arrive at the gate as `readable=false`, which the evidence layer classified as EvidenceAbsent and the gate turned into PublishProceed - so a transient read fault would have OVERWRITTEN a receipt the belt could not read. Absent and unreadable have opposite correct actions, so the two are now distinct constructors and there is no spelling for the conflation.\\n\\nThese two claims are the pair, and only the pair discriminates: absent proceeds, unreadable halts. Asserting either alone would pass under the defect - the old code proceeded on both."

test fn an_unreadable_receipt_halts_rather_than_being_overwritten() -> Bool {
  match gunbc.roadmap_belt_actuate.belt_publish_gate(
    node_id: "belt-pub-node",
    subject: belt_pub_subject(head: belt_pub_head, node_id: "belt-pub-node"),
    existing: gunbc.roadmap_publish.ReceiptSourceUnreadable { detail: "input/output error" },
  ) {
    PublishProceed => false
    PublishHalted { outcome } =>
      match outcome {
        PublishEvidenceUnreadable { node_id: _, detail } =>
          string_contains(s: detail, pattern: "cannot read")
            && string_contains(s: detail, pattern: "input/output error")
        PublishAlreadyRecorded { node_id: _, head_sha: _ } => false
        PublishRecorded { node_id: _, head_sha: _, outcome_key: _ } => false
        PublishWriteFailed { node_id: _, detail: _ } => false
        PublishDeferred { node_id: _, reason: _ } => false
      }
  }
}

test fn a_present_but_empty_receipt_is_a_fault_not_an_absence() -> Bool {
  match gunbc.roadmap_belt_actuate.belt_publish_gate(
    node_id: "belt-pub-node",
    subject: belt_pub_subject(head: belt_pub_head, node_id: "belt-pub-node"),
    existing: gunbc.roadmap_publish.ReceiptSourcePresent { text: "  " },
  ) {
    PublishProceed => false
    PublishHalted { outcome } =>
      match outcome {
        PublishEvidenceUnreadable { node_id: _, detail: _ } => true
        PublishAlreadyRecorded { node_id: _, head_sha: _ } => false
        PublishRecorded { node_id: _, head_sha: _, outcome_key: _ } => false
        PublishWriteFailed { node_id: _, detail: _ } => false
        PublishDeferred { node_id: _, reason: _ } => false
      }
  }
}

data listing_membership_note: String = "The line-exact membership test is what makes every ABSENCE conclusion in belt_publication_receipt_source a fact rather than a spelling coincidence. A plain substring test would find a head sha inside a longer one, or a receipt name inside its own .tmp sibling, and would then report a receipt PRESENT that is not there - or, worse under the opposite skew, miss one that is. The prefix and suffix cases are asserted, not just the positive."

test fn listing_membership_is_line_exact_not_substring() -> Bool {
  let listing = join(["alpha.json", "beta.json", "beta.json.tmp"], "\n")
  gunbc.roadmap_belt_actuate.belt_listing_names_entry(listing: listing, name: "alpha.json")
    && gunbc.roadmap_belt_actuate.belt_listing_names_entry(listing: listing, name: "beta.json")
    && gunbc.roadmap_belt_actuate.belt_listing_names_entry(listing: listing, name: "beta.json.tmp")
    && !gunbc.roadmap_belt_actuate.belt_listing_names_entry(listing: listing, name: "eta.json")
    && !gunbc.roadmap_belt_actuate.belt_listing_names_entry(listing: listing, name: "beta")
    && !gunbc.roadmap_belt_actuate.belt_listing_names_entry(listing: listing, name: "gamma.json")
    && !gunbc.roadmap_belt_actuate.belt_listing_names_entry(listing: "", name: "alpha.json")
}

test fn an_undecodable_receipt_is_not_overwritten_either() -> Bool {
  match gunbc.roadmap_belt_actuate.belt_publish_gate(
    node_id: "belt-pub-node",
    subject: belt_pub_subject(head: belt_pub_head, node_id: "belt-pub-node"),
    existing: gunbc.roadmap_publish.ReceiptSourcePresent { text: "not a receipt" },
  ) {
    PublishProceed => false
    PublishHalted { outcome } =>
      match outcome {
        PublishEvidenceUnreadable { node_id: _, detail } =>
          string_contains(s: detail, pattern: "cannot read")
            && !string_contains(s: detail, pattern: "another subject")
        PublishAlreadyRecorded { node_id: _, head_sha: _ } => false
        PublishRecorded { node_id: _, head_sha: _, outcome_key: _ } => false
        PublishWriteFailed { node_id: _, detail: _ } => false
        PublishDeferred { node_id: _, reason: _ } => false
      }
  }
}

data write_failure_is_not_a_judgment_note: String = "A JUDGMENT REACHED AND THEN LOST IS NOT A JUDGMENT RECORDED. The write is the only thing that makes the adjudication durable, so a failed write must not report the outcome it computed - the next tick will find nothing on disk, and a caller told the head was published would be reading a fact that exists nowhere. The pair below asserts the same receipt produces different producer outcomes purely on whether the write succeeded."

test fn a_failed_write_reports_loss_rather_than_the_outcome_it_computed() -> Bool {
  let subject = belt_pub_subject(head: belt_pub_head, node_id: "belt-pub-node")
  let receipt = gunbc.roadmap_publish.publication_receipt_of(
    subject: subject,
    outcome: gunbc.roadmap_publish.adjudicate_publication(
      pulls: gunbc.roadmap_publish.PullRequestsRead { pulls: [] },
      remotes: gunbc.roadmap_publish.RemoteBranchesRead { branches: [] },
      remote: "https://github.com/gunb-ai/gunbc.git" as std.types.NonEmptyStr,
      branch: "dispatch/belt-pub-node-afeedfacefeedface" as std.types.NonEmptyStr,
      expected_base: "main" as std.types.NonEmptyStr,
      expected_head: belt_pub_head,
    ),
  )
  let ok = gunbc.roadmap_belt_actuate.belt_publish_write_outcome(
    node_id: "belt-pub-node",
    subject: subject,
    receipt: receipt,
    write_success: true,
    write_error: "",
  )
  let lost = gunbc.roadmap_belt_actuate.belt_publish_write_outcome(
    node_id: "belt-pub-node",
    subject: subject,
    receipt: receipt,
    write_success: false,
    write_error: "read-only file system",
  )
  match ok {
    PublishRecorded { node_id: _, head_sha, outcome_key } =>
      head_sha == (belt_pub_head as String)
        && outcome_key == "branch-not-published"
        && match lost {
          PublishWriteFailed { node_id: _, detail } =>
            string_contains(s: detail, pattern: "read-only file system")
              && string_contains(s: detail, pattern: "reached and then lost")
          PublishRecorded { node_id: _, head_sha: _, outcome_key: _ } => false
          PublishAlreadyRecorded { node_id: _, head_sha: _ } => false
          PublishEvidenceUnreadable { node_id: _, detail: _ } => false
          PublishDeferred { node_id: _, reason: _ } => false
        }
    PublishWriteFailed { node_id: _, detail: _ } => false
    PublishAlreadyRecorded { node_id: _, head_sha: _ } => false
    PublishEvidenceUnreadable { node_id: _, detail: _ } => false
    PublishDeferred { node_id: _, reason: _ } => false
  }
}

fn subject_key(observation: gunbc.roadmap_publish.PublicationSubjectObservation) -> String {
  match observation {
    PublicationSubjectObserved { subject } => subject.expected_head as String
    PublicationSubjectUnobserved { reason: _ } => ""
  }
}

test fn an_unreadable_worktree_head_yields_no_publication_subject() -> Bool {
  let missing = gunbc.roadmap_belt_actuate.belt_publication_subject_for(
    node_id: "belt-pub-node",
    attempt_key: "feedfacefeedface",
    branch: "dispatch/belt-pub-node-afeedfacefeedface",
    head: gunbc.roadmap_belt_actuate.worktree_head_observation_of(
      outcome: gunbc.roadmap_belt_actuate.ExecFailed {
        program: "git",
        exit_code: 128,
        stderr: "not a git repository",
      },
    ),
  )
  let observed = gunbc.roadmap_belt_actuate.belt_publication_subject_for(
    node_id: "belt-pub-node",
    attempt_key: "feedfacefeedface",
    branch: "dispatch/belt-pub-node-afeedfacefeedface",
    head: gunbc.roadmap_belt_actuate.worktree_head_observation_of(
      outcome: gunbc.roadmap_belt_actuate.ExecOk { stdout: (belt_pub_head as String) },
    ),
  )
  subject_key(observation: missing) == ""
    && subject_key(observation: observed) == (belt_pub_head as String)
    && match missing {
      PublicationSubjectUnobserved { reason } =>
        string_contains(s: reason, pattern: "exact head")
          && string_contains(s: reason, pattern: "not a git repository")
      PublicationSubjectObserved { subject: _ } => false
    }
}

data zero_exit_empty_stdout_is_unobserved_note: String = "THE DISCRIMINATING CONTROL FOR THE HEAD READ, and the reason the exit code alone is not the test. git rev-parse HEAD exits zero and prints nothing on a worktree whose branch carries no commit yet, which a freshly created dispatch worktree is until the worker commits. A reader that trusted the exit code would cast an empty string into a CommitSha, producing a subject whose head matches no commit and compares equal to every other empty head - so a receipt written for it would be evidence for any attempt in the same state."

test fn a_zero_exit_with_no_revision_is_unobserved_not_an_empty_head() -> Bool {
  match gunbc.roadmap_belt_actuate.worktree_head_observation_of(outcome: gunbc.roadmap_belt_actuate.ExecOk { stdout: "\n" }) {
    WorktreeHeadUnobserved { reason } =>
      string_contains(s: reason, pattern: "no revision")
    WorktreeHeadObserved { revision: _ } => false
  }
}

data unsettled_receipt_must_not_freeze_the_row_note: String = "THE CLAIM THAT PINS THE IDEMPOTENCE KEY, and the defect it would have caught. The obvious key is `a receipt exists for this head`, and under it the belt's FIRST observation of a head - which normally happens before the worker has pushed - records branch-not-published and then halts on its own record forever. The row would report `not published` for the rest of the attempt's life, and the halt would be caused by the very receipt that observed the absence.\\n\\nSo the pair below drives the gate with two receipts for the SAME subject, differing only in what the remote showed: a bound one halts, an unpublished one proceeds. A gate keyed on existence rather than on settlement returns already-recorded for both, and this goes red."

fn belt_pub_unpublished_receipt(head: std.types.CommitSha, node_id: String) -> String {
  gunbc.roadmap_publish.publication_receipt_json(
    receipt: gunbc.roadmap_publish.publication_receipt_of(
      subject: belt_pub_subject(head: head, node_id: node_id),
      outcome: gunbc.roadmap_publish.adjudicate_publication(
        pulls: gunbc.roadmap_publish.PullRequestsRead { pulls: [] },
        remotes: gunbc.roadmap_publish.RemoteBranchesRead { branches: [] },
        remote: "https://github.com/gunb-ai/gunbc.git" as std.types.NonEmptyStr,
        branch: "dispatch/belt-pub-node-afeedfacefeedface" as std.types.NonEmptyStr,
        expected_base: "main" as std.types.NonEmptyStr,
        expected_head: head,
      ),
    ),
  )
}

test fn an_unsettled_receipt_is_re_observed_rather_than_halting_the_row() -> Bool {
  let settled = belt_pub_gate_key(
    gate: gunbc.roadmap_belt_actuate.belt_publish_gate(
      node_id: "belt-pub-node",
      subject: belt_pub_subject(head: belt_pub_head, node_id: "belt-pub-node"),
      existing: gunbc.roadmap_publish.ReceiptSourcePresent { text: belt_pub_receipt(head: belt_pub_head, node_id: "belt-pub-node") },
    ),
  )
  let unsettled = belt_pub_gate_key(
    gate: gunbc.roadmap_belt_actuate.belt_publish_gate(
      node_id: "belt-pub-node",
      subject: belt_pub_subject(head: belt_pub_head, node_id: "belt-pub-node"),
      existing: gunbc.roadmap_publish.ReceiptSourcePresent { text: belt_pub_unpublished_receipt(head: belt_pub_head, node_id: "belt-pub-node") },
    ),
  )
  settled == "already-recorded" && unsettled == "proceed" && settled != unsettled
}

// ---------------------------------------------------------------------------
// PRESS-0 step 1 — the deployed-revision gate, at the grain it is actually proven.
//
// SCOPE, STATED FIRST because the honest rung is the point: these witness the
// PROJECTION of the two new arms, not the live gate. `fleet_revision_standing`
// reads a real git tree, so whether the gate FIRES on a drifted srv1 is a wet
// fact and is owed a wet receipt — it is not established here and must not be
// read as established. What IS established by execution: neither arm can reach
// the ok band, both carry a loud band, the drifted receipt names BOTH revisions,
// and the unobserved receipt names its cause.
//
// The `desired`/`local` assertion is the discriminating one. A refusal that
// dropped one side would still refuse, still label correctly, still be loud —
// and would be useless to the operator who has to decide whether to catch the
// host up or roll it back. The membership-diff `from` ruling is exactly this:
// a receipt must name what it observed, not merely that it disagreed.
data revision_gate_witness_scope_note: String = "Projection-grain only; the live gate is owed a wet srv1 receipt."

test fn witness_revision_refusals_are_never_ok() -> Bool {
  !gunbc.roadmap_belt_actuate.belt_dispatch_result_ok(r: gunbc.roadmap_belt_actuate.DispatchRevisionDrifted { node_id: "a", desired: "aaa", local: "bbb" })
    && !gunbc.roadmap_belt_actuate.belt_dispatch_result_ok(r: gunbc.roadmap_belt_actuate.DispatchRevisionUnobserved { node_id: "a", cause: "no git" })
}

test fn witness_revision_refusal_labels_pin_wire_contract() -> Bool {
  gunbc.roadmap_belt_actuate.belt_dispatch_status_label(r: gunbc.roadmap_belt_actuate.DispatchRevisionDrifted { node_id: "a", desired: "aaa", local: "bbb" }) == "deployed_revision_drifted"
    && gunbc.roadmap_belt_actuate.belt_dispatch_status_label(r: gunbc.roadmap_belt_actuate.DispatchRevisionUnobserved { node_id: "a", cause: "no git" }) == "deployed_revision_unobserved"
    && status_label_glued_to_ok(r: gunbc.roadmap_belt_actuate.DispatchRevisionDrifted { node_id: "a", desired: "aaa", local: "bbb" })
    && status_label_glued_to_ok(r: gunbc.roadmap_belt_actuate.DispatchRevisionUnobserved { node_id: "a", cause: "no git" })
}

test fn witness_drift_receipt_names_both_revisions() -> Bool {
  let wire = extdeps.languages.json.emit.serialize_json(v: gunbc.roadmap_belt_actuate.belt_dispatch_result_json_value(
    r: gunbc.roadmap_belt_actuate.DispatchRevisionDrifted { node_id: "a", desired: "deadbeef", local: "cafebabe" }))
  string_contains(s: wire, pattern: "\"desired\": \"deadbeef\"")
    && string_contains(s: wire, pattern: "\"local\": \"cafebabe\"")
}

test fn witness_unobserved_receipt_names_its_cause() -> Bool {
  string_contains(
    s: extdeps.languages.json.emit.serialize_json(v: gunbc.roadmap_belt_actuate.belt_dispatch_result_json_value(
      r: gunbc.roadmap_belt_actuate.DispatchRevisionUnobserved { node_id: "a", cause: "HEAD undecodable" })),
    pattern: "\"cause\": \"HEAD undecodable\"")
}

// Handback items 3 and 4 (review artifact 51237).

fn dup_running() -> gunbc.roadmap_dispatch_actuator.DispatchLiveSession {
  live_session_with_process(
    node_id: "a", process: gunbc.worker_lifecycle.WorkerProcessRunning { command: "codex" as std.types.NonEmptyStr })
}

fn dup_stale() -> gunbc.roadmap_dispatch_actuator.DispatchLiveSession {
  live_session_with_process(
    node_id: "a", process: gunbc.worker_lifecycle.WorkerProcessExited { exit_code: 0, last_command: "codex" })
}

test fn witness_two_sessions_for_one_node_refuse_and_name_both() -> Bool {
  match gunbc.roadmap_belt_actuate.belt_node_session_liveness(live: [dup_running(), dup_stale()], node_id: "a") {
    BeltSessionMultiplicityConflict { session_names: names, session_count: n } =>
      n == 2 && string_contains(s: names, pattern: ",")
    _ => false
  }
}

// THE DISCRIMINATING ONE: under first() these two orders answered gunbc.roadmap_belt_actuate.Running and
// StaleTerminal respectively — same observation, different verdict, no signal.
test fn witness_multiplicity_verdict_is_order_independent() -> Bool {
  let forward = gunbc.roadmap_belt_actuate.belt_node_session_liveness(live: [dup_running(), dup_stale()], node_id: "a")
  let reverse = gunbc.roadmap_belt_actuate.belt_node_session_liveness(live: [dup_stale(), dup_running()], node_id: "a")
  (match forward { BeltSessionMultiplicityConflict { session_names: _, session_count: a } =>
    match reverse { BeltSessionMultiplicityConflict { session_names: _, session_count: b } => a == b _ => false }
    _ => false })
}

fn witness_oid_or_refuse(hex: String) -> extdeps.git.object_store.GitObjectId? {
  extdeps.git.object_store.git_object_id_from_untagged_hex(hex: hex)
}

data witness_desired_hex: String = "1111111111111111111111111111111111111111"
data witness_local_hex: String = "2222222222222222222222222222222222222222"

// The gate itself, not its output arms: deleting the fleet_revision_standing match
// would leave every constructed-arm witness green, so drive the fold directly.
test fn witness_revision_admission_fold_drives_all_three_arms() -> Bool {
  let unobserved = gunbc.roadmap_belt_actuate.belt_revision_admission(
    standing: gunbc.fleet_desired_observe.RevisionUnobserved { cause: "HEAD undecodable" })
  match witness_oid_or_refuse(hex: witness_desired_hex) {
    Present { value: d_oid } =>
      match witness_oid_or_refuse(hex: witness_local_hex) {
        Present { value: l_oid } => {
          let converged = gunbc.roadmap_belt_actuate.belt_revision_admission(
            standing: gunbc.fleet_desired_observe.RevisionConverged { revision: d_oid })
          let drifted = gunbc.roadmap_belt_actuate.belt_revision_admission(
            standing: gunbc.fleet_desired_observe.RevisionDrifted { desired: d_oid, local: l_oid })
          (match converged { BeltRevisionAdmitted { revision: _ } => true _ => false })
            && (match drifted {
              BeltRevisionRefusedDrifted { desired: d, local: l } => d != l
              _ => false
            })
            && (match unobserved {
              BeltRevisionRefusedUnobserved { cause: c } => c == "HEAD undecodable"
              _ => false
            })
        }
        Absent => false
      }
    Absent => false
  }
}

// THE BELT-GRAIN CONTROL (review artifact 51237, P0 #2). The previous
// dead-pane witness proved a helper Boolean and said nothing about the
// continuously running reconciler, which received the whole session list and
// counted every present row as an occupied member. This asserts the partition
// the tick actually feeds to belt_reconcile: a stale pane is NOT running, so it
// neither occupies capacity nor reads as Unchanged, and an unobserved pane is
// in neither bucket — it is a counted refusal, because tearing it down could
// kill live work and spawning beside it could double-run the node.
test fn witness_tick_partition_is_lifecycle_aware_not_presence_aware() -> Bool {
  let part = gunbc.roadmap_belt_actuate.belt_tick_classify_sessions(live: [
    live_session_with_process(
      node_id: "run", process: gunbc.worker_lifecycle.WorkerProcessRunning { command: "codex" as std.types.NonEmptyStr }),
    live_session_with_process(
      node_id: "dead", process: gunbc.worker_lifecycle.WorkerProcessExited { exit_code: 0, last_command: "codex" }),
    live_session(node_id: "unknown", verdict: std.upsert_decision.Converged),
  ])
  part.running.length() == 1
    && part.stale.length() == 1
    && part.refused.length() == 1
    && part.conflicted.length() == 0
    && all(part.running, s => s.node_id == "run")
    && all(part.stale, s => s.node_id == "dead")
    && all(part.refused, s => s.node_id == "unknown")
}

// Review artifact 51285, finding 1: `refused` was partitioned and never read, so an
// unobserved-but-present session left its node looking ABSENT to belt_reconcile and
// spawnable — beside a pane that might be running. Nothing running means nothing
// occupies capacity; the point is that nothing is spawned either.
test fn witness_tick_defers_every_non_running_class() -> Bool {
  let part = gunbc.roadmap_belt_actuate.belt_tick_classify_sessions(live: [
    live_session(node_id: "unknown", verdict: std.upsert_decision.Converged),
  ])
  part.running.length() == 0
    && part.refused.length() == 1
    && part.stale.length() == 0
    && part.conflicted.length() == 0
}

// Finding 2: multiplicity is a NODE fact. Two rows for one node landed in two buckets
// because each row's process state was read in isolation, so the tick acted on an
// ambiguity the click path refuses. Neither row may be classified running.
test fn witness_tick_multiplicity_is_a_node_fact() -> Bool {
  let part = gunbc.roadmap_belt_actuate.belt_tick_classify_sessions(live: [
    live_session_with_process(
      node_id: "a", process: gunbc.worker_lifecycle.WorkerProcessRunning { command: "codex" as std.types.NonEmptyStr }),
    live_session_with_process(
      node_id: "a", process: gunbc.worker_lifecycle.WorkerProcessExited { exit_code: 0, last_command: "codex" }),
  ])
  part.conflicted.length() == 2
    && part.running.length() == 0
    && part.stale.length() == 0
}

// ── The located spawn cause reaches the receipt ─────────────────────────────────────────────────
//
// THE DEFECT THIS CLOSES: gunbc.roadmap_belt_actuate.SpawnFailed carries node_id, step, detail and provider, and the pass fold
// discarded all four for the sentence "one or more spawn outcomes failed". The receipt is a tick's
// only durable record, so the cause was computed and erased every time. On srv1 that turned a
// missing provider binary into weeks of a dashboard saying "belt fault" with no way to ask why —
// and the obvious host probes answer about a different object than the preflight tests, so the
// available evidence pointed away from the cause rather than at it.
//
// Each conjunct names one of the four facts, so a fold that dropped any single field reds here
// rather than passing on the other three.
test fn a_failed_spawn_names_its_node_gate_and_detail_in_the_receipt() -> Bool {
  match gunbc.roadmap_belt_actuate.belt_spawn_pass_outcome_from(
    observe_refused: false,
    observe_reason: "",
    spawn_outcomes: [
      gunbc.roadmap_belt_actuate.SpawnFailed {
        node_id: "v2-emitter-direct-rust-door",
        step: "codex-cli",
        detail: "codex not found at the pinned bundled path",
        provider: "codex",
      },
    ],
  ) {
    BeltPassFailed { reason: r } =>
      string_contains(s: r, pattern: "v2-emitter-direct-rust-door")
        && string_contains(s: r, pattern: "codex-cli")
        && string_contains(s: r, pattern: "codex not found at the pinned bundled path")
        && string_contains(s: r, pattern: "codex")
    BeltPassRecorded => false
    BeltPassDeferred { reason: _ } => false
    BeltPassRefused { reason: _ } => false
  }
}

// THE CONTROL, and it is the one that makes the claim above mean something. A reason string is easy
// to satisfy by concatenating every outcome unconditionally, which would also "name the detail" of
// a successful spawn and report failure for a tick that had none. So: an all-Spawned list must
// reach BeltPassRecorded, with no reason at all.
test fn a_tick_with_no_failed_spawn_records_instead_of_reporting_a_cause() -> Bool {
  match gunbc.roadmap_belt_actuate.belt_spawn_pass_outcome_from(
    observe_refused: false,
    observe_reason: "",
    spawn_outcomes: [
      gunbc.roadmap_belt_actuate.Spawned { node_id: "n1", session_name: "s1", provider: "codex" },
      gunbc.roadmap_belt_actuate.Spawned { node_id: "n2", session_name: "s2", provider: "codex" },
    ],
  ) {
    BeltPassRecorded => true
    BeltPassFailed { reason: _ } => false
    BeltPassDeferred { reason: _ } => false
    BeltPassRefused { reason: _ } => false
  }
}

// Mixed list: the failed one is named and the succeeded one is not dragged into the cause. This is
// what distinguishes "report the failures" from "report everything that happened".
test fn a_mixed_tick_names_only_the_failed_spawn() -> Bool {
  match gunbc.roadmap_belt_actuate.belt_spawn_pass_outcome_from(
    observe_refused: false,
    observe_reason: "",
    spawn_outcomes: [
      gunbc.roadmap_belt_actuate.Spawned { node_id: "healthy-node", session_name: "s1", provider: "codex" },
      gunbc.roadmap_belt_actuate.SpawnFailed {
        node_id: "broken-node",
        step: "codex-auth",
        detail: "login status exited nonzero",
        provider: "codex",
      },
    ],
  ) {
    BeltPassFailed { reason: r } =>
      string_contains(s: r, pattern: "broken-node")
        && string_contains(s: r, pattern: "codex-auth")
        && !string_contains(s: r, pattern: "healthy-node")
    BeltPassRecorded => false
    BeltPassDeferred { reason: _ } => false
    BeltPassRefused { reason: _ } => false
  }
}

// An observation refusal still wins over the spawn summary — the pre-existing arm, asserted here so
// the new reason-building cannot quietly displace it.
test fn an_observation_refusal_still_outranks_the_spawn_summary() -> Bool {
  match gunbc.roadmap_belt_actuate.belt_spawn_pass_outcome_from(
    observe_refused: true,
    observe_reason: "tmux list refused",
    spawn_outcomes: [
      gunbc.roadmap_belt_actuate.SpawnFailed { node_id: "n", step: "codex-cli", detail: "d", provider: "codex" },
    ],
  ) {
    BeltPassRefused { reason: r } => r == "tmux list refused"
    BeltPassFailed { reason: _ } => false
    BeltPassRecorded => false
    BeltPassDeferred { reason: _ } => false
  }
}
