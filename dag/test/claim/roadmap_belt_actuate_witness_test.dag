test fn witness_codex_preflight_separates_broken_runtime_from_auth() -> Bool {
  match gunbc.roadmap_belt_actuate.belt_codex_preflight_decision_observed_for_home(
    codex_home: "/state/codex",
    codex_on_path: true,
    env_on_path: true,
