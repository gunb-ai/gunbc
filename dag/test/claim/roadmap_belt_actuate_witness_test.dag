}

data codex_preflight_ok_dissolution_note: String = "review 44110. The codex_preflight_ok helper was a Bool fold over the two-variant BeltCodexPreflight — a variant test, the is_hermetic shape the 2026-07-12 predicate dissolution removed, and every sibling witness here already matches the coproduct directly. Matching in place also recovers what the Bool discarded: the accepted arm CARRIES the auth_method it derived, and asserting that it survives unparsed is the actual claim this witness makes about wording-independence."

test fn witness_codex_preflight_accepts_cli_auth_verdict_without_parsing_wording() -> Bool {
  match gunbc.roadmap_belt_actuate.belt_codex_preflight_decision_observed_for_home(
    codex_home: "/state/codex",
    codex_on_path: true,
    env_on_path: true,
    identity_command_success: true,
    identity_stdout: "codex-cli 0.146.0",
    identity_stderr: "non-fatal runtime warning",
    login_status_success: true,
    login_status_stdout: "future CLI auth method wording",
    login_status_stderr: "",
  ) {
    CodexPreflightOk { auth_method } =>
      string_contains(s: auth_method as String, pattern: "future CLI auth method wording")
    CodexPreflightRefused { step: _, detail: _ } => false
  }
}

test fn codex_provider_v0_preflight_keystone_holds() -> Bool {
  witness_codex_preflight_refuses_missing_cli_before_auth()
    && witness_codex_preflight_refuses_missing_env_binding()
    && witness_codex_preflight_separates_broken_runtime_from_auth()
    && witness_codex_preflight_refuses_wrong_executable_identity()
    && witness_codex_preflight_refuses_login_status_nonzero()
    && witness_codex_preflight_accepts_cli_auth_verdict_without_parsing_wording()
    && witness_fresh_spawn_wire_names_selected_provider()
}

data oracle_refs_execution_note: String = "This witness exists because its subject SHIPPED BROKEN and a whole-tree compile with 0 blocking errors said otherwise. belt_oracle_refs_for_contract called filter_map, a primitive std.primitives declares a contract for and the seed implements nothing for, so the call type-checked and died as `not yet implemented` the first time a real dispatch reached it — a 500, found on the lab. The lane's other witnesses covered the pure oracle carrier thoroughly and never drove THIS function, which is the whole lesson: a projection that only the effectful path calls needs a witness even when it is itself pure, because purity is what makes it cheap to witness, not what makes it covered. The assertions deliberately RUN the fold and read its output rather than checking a type: a version calling any unregistered primitive fails here at execution, which is the only place that class of defect is observable."

test fn oracle_refs_projection_runs_and_selects_pinnable_scopes() -> Bool {
  let claim_contract = gunbc.roadmap_execution_contract.gunbc_claim_execution_contract(
    entry: "dag/test/claim/probe_witness_test.dag" as std.types.FilePath,
    function: "probe_holds" as std.types.NonEmptyStr,
  )
  let claim_refs = gunbc.roadmap_belt_actuate.belt_oracle_refs_for_contract(contract: claim_contract)
  let cargo_refs = gunbc.roadmap_belt_actuate.belt_oracle_refs_for_contract(
    contract: gunbc.roadmap_execution_contract.cargo_test_execution_contract(filter: "roadmap_" as std.types.NonEmptyStr),
  )
  let unspecified_refs = gunbc.roadmap_belt_actuate.belt_oracle_refs_for_contract(
    contract: gunbc.roadmap_execution_contract.ExecutionContractUnspecified,
  )
  count(claim_refs) == 1
    && count(cargo_refs) == 0
    && count(unspecified_refs) == 0
    && match claim_refs.first() {
      Absent => false
      Present { value: oracle } =>
        (oracle.entry as String) == "dag/test/claim/probe_witness_test.dag"
          && (oracle.function as String) == "probe_holds"
    }
}

data unreadable_receipt_refuses_note: String = "review 45271, updated for exact-head wiring. The belt now observes the worktree head before reading a receipt, so an instance with no attempt filesystem cannot reach the unreadable-receipt arm through a failed legacy read alone. This witness instead drives the real fn against srv2 preview where neither the node nor the worktree exist, and asserts verification defers with an exact-head or missing-node reason rather than actuating against an unobserved subject."

data fixture_verification_head: std.types.CommitSha = "cafecafecafecafecafecafecafecafecafecafe" as std.types.CommitSha

fn fixture_verification_subject(node_id: String) -> gunbc.roadmap_verification_receipt.VerificationSubject {
  gunbc.roadmap_verification_receipt.VerificationSubject {
    node_identity: node_id as std.types.NonEmptyStr as gunbc.roadmap_model.RoadmapNodeIdentity,
    criteria_digest: std.content_hash.content_hash_atom(value: "belt-actuate-fixture"),
    attempt_key: "feedfacefeedface",
    branch: join(["dispatch/", node_id, "-afeedfacefeedface"], "") as std.types.NonEmptyStr,
    head_sha: fixture_verification_head,
    change_window_identity: gunbc.git_diff_change_window.git_diff_window_absent_identity(),
  }
}

fn completed_attempt_progress(node_id: String) -> gunbc.roadmap_workflow_progress.WorkflowAttemptProgress {
  gunbc.roadmap_workflow_progress.workflow_attempt_progress(evidence: gunbc.roadmap_workflow_progress.WorkflowAttemptEvidence {
    node_id: node_id,
    attempt_key: "feedfacefeedface",
    branch: join(["dispatch/", node_id, "-afeedfacefeedface"], ""),
    modeled_state_present: true,
    admission_receipt_readable: true,
    admission_receipt: "{\"schema\": \"roadmap-dispatch-environment/v1\", \"status\": \"admitted\"}",
    spawn_failure_present: false,
    spawn_failure: "",
    provider_events_readable: true,
    provider_events: "{\"type\":\"turn.completed\",\"usage\":\{\}\}\n",
    provider_events_error: "",
    process: gunbc.worker_lifecycle.WorkerProcessExited { exit_code: 0, last_command: "codex" },
    validation_summary: "gunbc run --claim-run",
    verification_subject: gunbc.roadmap_verification_receipt.VerificationSubjectObserved {
      subject: fixture_verification_subject(node_id: node_id),
    },
    verification_selection: gunbc.roadmap_verification_receipt.SelectionObserved {
      head: fixture_verification_head,
      window_identity: gunbc.git_diff_change_window.git_diff_window_absent_identity(),
    },
    verification_source: gunbc.roadmap_verification_receipt.VerificationReceiptAbsent,
    publication_subject: gunbc.roadmap_publish.PublicationSubjectObserved {
      subject: gunbc.roadmap_publish.RoadmapPublicationSubject {
        node_id: "pub-fixture-node",
        attempt_key: "feedfacefeedface",
        repository: extdeps.github.github.Repository {
          owner: "gunb-ai",
          name: "gunbc",
          full_name: "gunb-ai/gunbc",
          private: false,
          default_branch: "main",
        },
        branch: "dispatch/pub-fixture-node-afeedfacefeedface" as std.types.NonEmptyStr,
        expected_base: "main" as std.types.NonEmptyStr,
        expected_head: "cafecafecafecafecafecafecafecafecafecafe" as std.types.CommitSha,
      },
    },
    publication_source: gunbc.roadmap_publish.ReceiptSourceAbsent,
  })
}

data attempt_wire_carries_decided_activity_note: String = "The A2 single-projection-authority receipt at the wire: each attempt object on /workflow.json carries the DECIDED activity view beside the progress members, so the client paints without composing. The fixture is a completed agent turn with process exited and four pending obligations — the falsifier's own shape — and the assertions pin the decided fields (arm, the consequence-first summary composed by gunbc.roadmap_presentation, the reconcile-derived remaining count, the evidence rows) landing as JSON, plus the progress members surviving beside them. A client that had to rebuild any of these from segments would have nothing to rebuild them FROM being asserted here — the decided strings are the contract."

test fn attempt_wire_carries_decided_activity() -> Bool {
  let j = extdeps.languages.json.emit.serialize_json(v: gunbc.roadmap_belt_actuate.belt_workflow_attempt_presentation_json(
    progress: completed_attempt_progress(node_id: "belt-wire-activity-node")))
  string_contains(s: j, pattern: "\"activity\": {")
    && string_contains(s: j, pattern: "\"arm\": \"active\"")
    && string_contains(s: j, pattern: "Agent turn completed; the retained session is no longer running · Verification next · 4 remaining")
    && string_contains(s: j, pattern: "\"remaining_obligation_count\": 4")
    && string_contains(s: j, pattern: "\"attention\": \"routine\"")
    && string_contains(s: j, pattern: "\"label\": \"session container\"")
    && string_contains(s: j, pattern: "\"value\": \"present\"")
    && string_contains(s: j, pattern: "\"label\": \"worker process\"")
    && string_contains(s: j, pattern: "\"value\": \"process exited\"")
    && string_contains(s: j, pattern: "\"node_id\": \"belt-wire-activity-node\"")
    && string_contains(s: j, pattern: "\"segments\": [")
}

test fn verify_without_observable_subject_defers_instead_of_rerunning() -> Bool {
  match gunbc.roadmap_belt_actuate.belt_verify_attempt_for_instance(
    instance: srv2_preview_dashboard_instance(),
    progress: completed_attempt_progress(node_id: "belt-verify-probe-node"),
  ) {
    VerifyDeferred { node_id, reason } =>
      node_id == "belt-verify-probe-node"
        && (string_contains(s: reason, pattern: "exact head")
            || string_contains(s: reason, pattern: "no node"))
    VerifyEvidenceUnreadable { node_id: _, detail: _ } => false
    VerifyRefused { node_id: _, cause: _ } => false
    VerifyRecorded { node_id: _, verdict_key: _, detail: _ } => false
    VerifyWriteFailed { node_id: _, detail: _ } => false
  }
}

