data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn nid(s: String) -> RoadmapNodeId { s }

fn ready_node(id: String) -> RoadmapNode {
  RoadmapNode {
    node: nid(s: id),
    line: DerivableLine { prs: [1], title: id, description: "" },
    carriers: [],
    sizing: Sized { intricacy: IntricacyHigh, volume: VolumeMedium, repo: "gunbc", acceptance: PrsMerged },
    execution: ExecutionContractUnspecified,
    owner: "",
    signoff: Unsigned,
  }
}

fn live_session(node_id: String, verdict: ObservationVerdict) -> DispatchLiveSession {
  DispatchLiveSession {
    session_name: "gunbc-dispatch-{node_id}",
    node_id: node_id,
    windows: 1,
    lease_verdict: verdict,
    worker: dispatch_worker_observation(),
  }
}

fn is_exec_ok(o: BeltExecOutcome) -> Bool {
  match o {
    ExecOk { stdout: _ } => true
    ExecFailed { program: _, exit_code: _, stderr: _ } => false
    ExecRefused { program: _, reason: _ } => false
  }
}

fn exec_ok_stdout_contains(o: BeltExecOutcome, pattern: String) -> Bool {
  match o {
    ExecOk { stdout: out } => string_contains(s: out, pattern: pattern)
    ExecFailed { program: _, exit_code: _, stderr: _ } => false
    ExecRefused { program: _, reason: _ } => false
  }
}

fn is_exec_failed(o: BeltExecOutcome) -> Bool {
  match o {
    ExecFailed { program: _, exit_code: _, stderr: _ } => true
    ExecOk { stdout: _ } => false
    ExecRefused { program: _, reason: _ } => false
  }
}

fn is_exec_refused(o: BeltExecOutcome) -> Bool {
  match o {
    ExecRefused { program: _, reason: _ } => true
    ExecOk { stdout: _ } => false
    ExecFailed { program: _, exit_code: _, stderr: _ } => false
  }
}

fn is_spawn_failed(o: BeltSpawnOutcome) -> Bool {
  match o {
    SpawnFailed { node_id: _, step: _, detail: _ } => true
    Spawned { node_id: _, session_name: _ } => false
  }
}

fn is_teardown_failed(o: BeltTeardownOutcome) -> Bool {
  match o {
    TeardownFailed { session_name: _, detail: _ } => true
    ReapedSession { session_name: _ } => false
  }
}

test fn witness_exec_ok_runs_echo() -> Bool {
  let o = belt_exec(cmd: host_exec_argv(program: "echo", args: ["belt-ok"]), workdir: "/")
  is_exec_ok(o: o) && exec_ok_stdout_contains(o: o, pattern: "belt-ok")
}

test fn witness_exec_refuses_missing_program() -> Bool {
  let o = belt_exec(
    cmd: host_exec_argv(program: "belt-nonexistent-program-xyz", args: []),
    workdir: "/",
  )
  is_exec_refused(o: o)
}

test fn witness_exec_fails_on_nonzero_exit() -> Bool {
  let o = belt_exec(cmd: host_exec_argv(program: "false", args: []), workdir: "/")
  is_exec_failed(o: o)
}

test fn witness_exec_all_runs_every_step_when_ok() -> Bool {
  let o = belt_exec_all(
    cmds: [
      host_exec_argv(program: "echo", args: ["first"]),
      host_exec_argv(program: "echo", args: ["second"]),
    ],
    workdir: "/",
  )
  is_exec_ok(o: o) && exec_ok_stdout_contains(o: o, pattern: "second")
}

test fn witness_exec_all_short_circuits_after_failure() -> Bool {
  let o = belt_exec_all(
    cmds: [
      host_exec_argv(program: "false", args: []),
      host_exec_argv(program: "echo", args: ["should-not-run"]),
    ],
    workdir: "/",
  )
  is_exec_failed(o: o) && !exec_ok_stdout_contains(o: o, pattern: "should-not-run")
}

test fn witness_exec_all_fails_on_later_step() -> Bool {
  let o = belt_exec_all(
    cmds: [
      host_exec_argv(program: "echo", args: ["ok"]),
      host_exec_argv(program: "false", args: []),
    ],
    workdir: "/",
  )
  is_exec_failed(o: o)
}

test fn witness_named_exec_steps_locate_the_first_failure() -> Bool {
  match belt_exec_steps(
    steps: [
      BeltExecStep {
        step: "prepare",
        command: host_exec_argv(program: "/usr/bin/true", args: []),
      },
      BeltExecStep {
        step: "tmux-event-pipe",
        command: host_exec_argv(program: "/usr/bin/false", args: []),
      },
      BeltExecStep {
        step: "provider-start",
        command: host_exec_argv(program: "/usr/bin/true", args: []),
      },
    ],
    workdir: "/",
  ) {
    ExecStepsOk => false
    ExecStepFailed { step, detail } =>
      step == "tmux-event-pipe"
        && string_contains(s: detail, pattern: "exit 1")
  }
}

test fn witness_spawn_member_refuses_observed_shape() -> Bool {
  let m = ObservedMember { node_id: "z", session: live_session(node_id: "z", verdict: Converged) }
  is_spawn_failed(o: belt_actuate_spawn_member(m: m, workdir: "/"))
}

test fn witness_teardown_member_refuses_desired_shape() -> Bool {
  let m = DesiredMember { node_id: "a", node: ready_node(id: "a") }
  is_teardown_failed(o: belt_actuate_teardown_member(m: m))
}

fn observe_live_count(o: BeltObserve) -> Int {
  match o {
    Observed { live: live } => count(live)
    ObserveRefused { reason: _ } => -1
  }
}

fn is_observe_refused(o: BeltObserve) -> Bool {
  match o {
    ObserveRefused { reason: _ } => true
    Observed { live: _ } => false
  }
}

test fn witness_observe_parses_live_on_success() -> Bool {
  observe_live_count(o: belt_observe_from_result(
    success: true,
    stdout: "gunbc-dispatch-a: 1 windows",
    stderr: "",
  )) == 1
}

test fn witness_observe_empty_on_no_server() -> Bool {
  observe_live_count(o: belt_observe_from_result(
    success: false,
    stdout: "",
    stderr: "no server running on /tmp/tmux-1000/default",
  )) == 0
}

test fn witness_observe_empty_on_no_sessions() -> Bool {
  observe_live_count(o: belt_observe_from_result(
    success: false,
    stdout: "",
    stderr: "no sessions",
  )) == 0
}

test fn witness_observe_refuses_permission_error() -> Bool {
  is_observe_refused(o: belt_observe_from_result(
    success: false,
    stdout: "",
    stderr: "error connecting to /tmp/tmux-1000/default (Permission denied)",
  ))
}

test fn witness_observe_refuses_empty_stderr_failure() -> Bool {
  is_observe_refused(o: belt_observe_from_result(
    success: false,
    stdout: "",
    stderr: "",
  ))
}

fn uuid_char(u: String, i: Int) -> String {
  substring(s: u, start: i, end: i + 1)
}

test fn witness_uuid_deterministic() -> Bool {
  let a = belt_spawn_session_uuid(node_id: "5-regen-cutover", probed_at: "2026-07-25T20:00:00Z")
  let b = belt_spawn_session_uuid(node_id: "5-regen-cutover", probed_at: "2026-07-25T20:00:00Z")
  a == b
}

test fn witness_uuid_distinct_nodes() -> Bool {
  let a = belt_spawn_session_uuid(node_id: "node-a", probed_at: "2026-07-25T20:00:00Z")
  let b = belt_spawn_session_uuid(node_id: "node-b", probed_at: "2026-07-25T20:00:00Z")
  !(a == b)
}

test fn witness_uuid_rfc4122_shape() -> Bool {
  let u = belt_spawn_session_uuid(node_id: "5-regen-cutover", probed_at: "2026-07-25T20:00:00Z")
  string_length(s: u) == 36
    && uuid_char(u: u, i: 8) == "-"
    && uuid_char(u: u, i: 13) == "-"
    && uuid_char(u: u, i: 18) == "-"
    && uuid_char(u: u, i: 23) == "-"
    && uuid_char(u: u, i: 14) == "4"
    && uuid_char(u: u, i: 19) == "8"
}

fn is_node_found(l: BeltNodeLookup) -> Bool {
  match l {
    NodeFound { node: _ } => true
    NodeMissing => false
  }
}

test fn witness_find_node_hits() -> Bool {
  is_node_found(l: belt_find_node_in(nodes: [ready_node(id: "a"), ready_node(id: "b")], node_id: "b"))
}

test fn witness_find_node_misses() -> Bool {
  !is_node_found(l: belt_find_node_in(nodes: [ready_node(id: "a"), ready_node(id: "b")], node_id: "z"))
}

fn owned_node(id: String, owner: String) -> RoadmapNode {
  RoadmapNode {
    node: nid(s: id),
    line: DerivableLine { prs: [1], title: id, description: "" },
    carriers: [],
    sizing: Sized { intricacy: IntricacyHigh, volume: VolumeMedium, repo: "gunbc", acceptance: PrsMerged },
    execution: ExecutionContractUnspecified,
    owner: owner,
    signoff: Unsigned,
  }
}

fn found_owner(l: BeltNodeLookup) -> String {
  match l {
    NodeFound { node: n } => n.owner
    NodeMissing => ""
  }
}

test fn witness_find_node_first_wins_on_duplicate() -> Bool {
  found_owner(l: belt_find_node_in(
    nodes: [owned_node(id: "dup", owner: "first"), owned_node(id: "dup", owner: "second")],
    node_id: "dup",
  )) == "first"
}

test fn witness_node_session_live_true() -> Bool {
  belt_node_session_live(live: [live_session(node_id: "a", verdict: Converged)], node_id: "a")
}

test fn witness_node_session_live_false() -> Bool {
  !belt_node_session_live(live: [live_session(node_id: "a", verdict: Converged)], node_id: "b")
}

test fn witness_dispatch_result_ok_spawned_and_live() -> Bool {
  belt_dispatch_result_ok(r: DispatchSpawned { node_id: "a", session_name: "gunbc-dispatch-a" })
    && belt_dispatch_result_ok(r: DispatchAlreadyLive { node_id: "a", session_name: "gunbc-dispatch-a" })
}

test fn witness_dispatch_result_refusals_not_ok() -> Bool {
  !belt_dispatch_result_ok(r: DispatchDisabled { node_id: "a", instance_id: "preview", reason: "observe-only" })
    && !belt_dispatch_result_ok(r: DispatchNodeNotFound { node_id: "a" })
    && !belt_dispatch_result_ok(r: DispatchNodeAlreadyDone { node_id: "a" })
    && !belt_dispatch_result_ok(r: DispatchObserveRefused { node_id: "a", reason: "x" })
    && !belt_dispatch_result_ok(r: DispatchSpawnFailed { node_id: "a", step: "git", detail: "x" })
}

fn status_label_glued_to_ok(r: BeltDispatchResult) -> Bool {
  let ok = belt_dispatch_result_ok(r: r)
  let label_in_ok_set = any(belt_dispatch_ok_status_labels(), l => l == belt_dispatch_status_label(r: r))
  ok == label_in_ok_set
}

test fn witness_dispatch_status_labels_glued_to_ok_set() -> Bool {
  status_label_glued_to_ok(r: DispatchSpawned { node_id: "a", session_name: "s" })
    && status_label_glued_to_ok(r: DispatchAlreadyLive { node_id: "a", session_name: "s" })
    && status_label_glued_to_ok(r: DispatchDisabled { node_id: "a", instance_id: "preview", reason: "observe-only" })
    && status_label_glued_to_ok(r: DispatchNodeNotFound { node_id: "a" })
    && status_label_glued_to_ok(r: DispatchNodeAlreadyDone { node_id: "a" })
    && status_label_glued_to_ok(r: DispatchObserveRefused { node_id: "a", reason: "x" })
    && status_label_glued_to_ok(r: DispatchSpawnFailed { node_id: "a", step: "git", detail: "x" })
}

test fn witness_dispatch_status_labels_pin_wire_contract() -> Bool {
  belt_dispatch_status_label(r: DispatchSpawned { node_id: "a", session_name: "s" }) == "spawned"
    && belt_dispatch_status_label(r: DispatchAlreadyLive { node_id: "a", session_name: "s" }) == "already_live"
    && belt_dispatch_status_label(r: DispatchDisabled { node_id: "a", instance_id: "preview", reason: "observe-only" }) == "disabled"
    && belt_dispatch_status_label(r: DispatchNodeNotFound { node_id: "a" }) == "node_not_found"
    && belt_dispatch_status_label(r: DispatchNodeAlreadyDone { node_id: "a" }) == "already_done_signed_off"
    && belt_dispatch_status_label(r: DispatchObserveRefused { node_id: "a", reason: "x" }) == "observe_refused"
    && belt_dispatch_status_label(r: DispatchSpawnFailed { node_id: "a", step: "git", detail: "x" }) == "spawn_failed"
}

test fn witness_fresh_spawn_wire_names_selected_provider() -> Bool {
  belt_dispatch_provider_label() == "codex"
    && string_contains(
      s: serialize_json(v: belt_dispatch_result_json_value(
        r: DispatchSpawned { node_id: "a", session_name: "s" })),
      pattern: "\"provider\": \"codex\"")
    && string_contains(
      s: serialize_json(v: belt_dispatch_result_json_value(
        r: DispatchSpawnFailed { node_id: "a", step: "codex-auth", detail: "not logged in" })),
      pattern: "\"provider\": \"codex\"")
}

fn band_key_for_label(label: String) -> String {
  let hit = belt_dispatch_label_band_rows() |> filter(row => row.wire_label == label) |> first
  match hit {
    Present { value: row } => row.band_key
    Absent => "band-row-missing"
  }
}

test fn witness_band_fold_pins_operator_vocabulary() -> Bool {
  belt_dispatch_label_band_rows().length() == 7
    && band_key_for_label(label: "spawned") == "ok"
    && band_key_for_label(label: "already_live") == "ok"
    && band_key_for_label(label: "disabled") == "fail"
    && band_key_for_label(label: "node_not_found") == "fail"
    && band_key_for_label(label: "already_done_signed_off") == "fail"
    && band_key_for_label(label: "observe_refused") == "loud"
    && band_key_for_label(label: "spawn_failed") == "loud"
}

test fn witness_no_result_maps_to_in_progress() -> Bool {
  all(belt_dispatch_label_band_rows(), row => row.band_key != "in-progress")
}

test fn witness_ok_labels_derive_from_band_fold() -> Bool {
  belt_dispatch_ok_status_labels() == ["spawned", "already_live"]
}

test fn witness_label_band_cover_reds_on_missing_row() -> Bool {
  let rows = belt_dispatch_label_band_rows()
  let labels = belt_dispatch_all_status_labels()
  let truncated = filter(rows, row => row.wire_label != "spawned")
  label_band_rows_cover(rows: rows, labels: labels)
    && !label_band_rows_cover(rows: truncated, labels: labels)
}

data d4_exemplar_reconcile_note: String = "D4: belt_dispatch_result_exemplars is a HAND roster (one exemplar per BeltDispatchResult arm), enrolled DeclaredFrontier in gunbc.roster_registry. belt_dispatch_status_label's total match walls an 8th VARIANT at compile time, but nothing ties the exemplar LIST to the variant set — a missed exemplar silently narrows belt_dispatch_all_status_labels AND the component wire-total that reads it, while the live server emits the unmodeled label. This reconciles the exemplar-derived label set against the independent wire-contract pin (the same seven labels witness_dispatch_status_labels_pin_wire_contract pins), and the RED control proves a missing-variant list reds. Dissolves when inhabitance enumeration or the serve-JSON total match replaces the hand list."

fn d4_wire_contract_labels() -> List<String> {
  ["spawned", "already_live", "disabled", "node_not_found", "already_done_signed_off", "observe_refused", "spawn_failed"]
}

fn d4_exemplars_reconcile(exemplars: List<BeltDispatchResult>) -> Bool {
  map(exemplars, r => belt_dispatch_status_label(r: r)) == d4_wire_contract_labels()
}

test fn witness_exemplar_roster_reconciles_variant_set() -> Bool {
  d4_exemplars_reconcile(exemplars: belt_dispatch_result_exemplars())
    && belt_dispatch_all_status_labels() == d4_wire_contract_labels()
}

fn d4_exemplars_missing_one() -> List<BeltDispatchResult> {
  [
    DispatchSpawned { node_id: "a", session_name: "s" },
    DispatchAlreadyLive { node_id: "a", session_name: "s" },
    DispatchDisabled { node_id: "a", instance_id: "preview", reason: "observe-only" },
    DispatchNodeNotFound { node_id: "a" },
    DispatchNodeAlreadyDone { node_id: "a" },
    DispatchObserveRefused { node_id: "a", reason: "x" },
  ]
}

test fn witness_exemplar_roster_missing_variant_reds() -> Bool {
  !d4_exemplars_reconcile(exemplars: d4_exemplars_missing_one())
}

fn preflight_refused_step(p: BeltClaudePreflight) -> String {
  match p {
    ClaudePreflightRefused { step: st, detail: _ } => st
    ClaudePreflightOk => ""
  }
}

fn preflight_ok(p: BeltClaudePreflight) -> Bool {
  match p {
    ClaudePreflightOk => true
    ClaudePreflightRefused { step: _, detail: _ } => false
  }
}

fn seeded_trust_config() -> String {
  "\{\"projects\":\{\"/opt/x/worktrees\":\{\"hasTrustDialogAccepted\":true\}\}\}"
}

fn preflight_with_config(config: String) -> BeltClaudePreflight {
  belt_claude_preflight_decision(
    claude_on_path: true,
    home: "/home/u",
    trust_store_path: "/home/u/.claude.json",
    trust_store_readable: true,
    trust_store_text: config,
    trust_root: "/opt/x/worktrees",
  )
}

test fn witness_preflight_refuses_missing_claude() -> Bool {
  preflight_refused_step(p: belt_claude_preflight_decision(
    claude_on_path: false,
    home: "/home/u",
    trust_store_path: "",
    trust_store_readable: false,
    trust_store_text: "",
    trust_root: "/opt/x/worktrees",
  )) == "claude-cli"
}

test fn witness_preflight_refuses_unknown_home() -> Bool {
  preflight_refused_step(p: belt_claude_preflight_decision(
    claude_on_path: true,
    home: "",
    trust_store_path: "",
    trust_store_readable: false,
    trust_store_text: "",
    trust_root: "/opt/x/worktrees",
  )) == "claude-trust-home"
}

test fn witness_preflight_refuses_unreadable_store() -> Bool {
  preflight_refused_step(p: belt_claude_preflight_decision(
    claude_on_path: true,
    home: "/home/u",
    trust_store_path: "/home/u/.claude.json",
    trust_store_readable: false,
    trust_store_text: "",
    trust_root: "/opt/x/worktrees",
  )) == "claude-trust-store"
}

test fn witness_preflight_refuses_unseeded_root() -> Bool {
  preflight_refused_step(p: preflight_with_config(
    config: "\{\"projects\":\{\"/opt/other\":\{\"hasTrustDialogAccepted\":true\}\}\}",
  )) == "claude-trust-seed"
    && preflight_refused_step(p: preflight_with_config(
      config: "\{\"projects\":\{\"/opt/x/worktrees\":\{\"hasTrustDialogAccepted\":false\}\}\}",
    )) == "claude-trust-seed"
}

test fn witness_preflight_ok_when_seeded() -> Bool {
  preflight_ok(p: preflight_with_config(config: seeded_trust_config()))
}

test fn witness_preflight_ok_on_enriched_entry() -> Bool {
  preflight_ok(p: preflight_with_config(
    config: "\{\"projects\":\{\"/opt/x/worktrees\":\{\"mcpServers\":\{\},\"allowedTools\":[\"a\}b\"],\"hasTrustDialogAccepted\":true\}\}\}",
  ))
}

fn codex_preflight_refused_step(p: BeltCodexPreflight) -> String {
  match p {
    CodexPreflightRefused { step: st, detail: _ } => st
    CodexPreflightOk { auth_method: _ } => ""
  }
}

fn codex_preflight_ok(p: BeltCodexPreflight) -> Bool {
  match p {
    CodexPreflightOk { auth_method: _ } => true
    CodexPreflightRefused { step: _, detail: _ } => false
  }
}

test fn witness_codex_preflight_refuses_missing_cli_before_auth() -> Bool {
  codex_preflight_refused_step(p: belt_codex_preflight_decision_observed_for_home(
    codex_home: "/state/codex",
    codex_on_path: false,
    env_on_path: true,
    identity_command_success: true,
    identity_stdout: "codex-cli 0.145.0",
    identity_stderr: "",
    login_status_success: true,
    login_status_stdout: "Logged in using ChatGPT",
    login_status_stderr: "",
  )) == "codex-cli"
}

test fn witness_codex_preflight_refuses_missing_env_binding() -> Bool {
  codex_preflight_refused_step(p: belt_codex_preflight_decision_observed_for_home(
    codex_home: "/state/codex",
    codex_on_path: true,
    env_on_path: false,
    identity_command_success: true,
    identity_stdout: "codex-cli 0.145.0",
    identity_stderr: "",
    login_status_success: true,
    login_status_stdout: "Logged in using ChatGPT",
    login_status_stderr: "",
  )) == "codex-env"
}

test fn witness_codex_preflight_refuses_login_status_nonzero() -> Bool {
  codex_preflight_refused_step(p: belt_codex_preflight_decision_observed_for_home(
    codex_home: "/state/codex",
    codex_on_path: true,
    env_on_path: true,
    identity_command_success: true,
    identity_stdout: "codex-cli 0.145.0",
    identity_stderr: "",
    login_status_success: false,
    login_status_stdout: "",
    login_status_stderr: "Not logged in",
  )) == "codex-auth"
}

test fn witness_codex_preflight_separates_broken_runtime_from_auth() -> Bool {
  match belt_codex_preflight_decision_observed_for_home(
    codex_home: "/state/codex",
    codex_on_path: true,
    env_on_path: true,
    identity_command_success: false,
    identity_stdout: "",
    identity_stderr: "/usr/bin/env: node: No such file or directory",
    login_status_success: false,
    login_status_stdout: "",
    login_status_stderr: "",
  ) {
    CodexPreflightOk { auth_method: _ } => false
    CodexPreflightRefused { step, detail } =>
      step == "codex-identity"
        && string_contains(s: detail, pattern: "node")
  }
}

test fn witness_codex_preflight_refuses_wrong_executable_identity() -> Bool {
  match belt_codex_preflight_decision_observed_for_home(
    codex_home: "/state/codex",
    codex_on_path: true,
    env_on_path: true,
    identity_command_success: true,
    identity_stdout: "some-other-cli 1.0",
    identity_stderr: "",
    login_status_success: true,
    login_status_stdout: "Logged in using ChatGPT",
    login_status_stderr: "",
  ) {
    CodexPreflightOk { auth_method: _ } => false
    CodexPreflightRefused { step, detail } =>
      step == "codex-identity"
        && string_contains(s: detail, pattern: "codex-cli")
  }
}

test fn witness_codex_preflight_accepts_cli_auth_verdict_without_parsing_wording() -> Bool {
  codex_preflight_ok(p: belt_codex_preflight_decision_observed_for_home(
    codex_home: "/state/codex",
    codex_on_path: true,
    env_on_path: true,
    identity_command_success: true,
    identity_stdout: "codex-cli future",
    identity_stderr: "non-fatal runtime warning",
    login_status_success: true,
    login_status_stdout: "future CLI auth method wording",
    login_status_stderr: "",
  ))
}

test fn codex_provider_v0_preflight_keystone_holds() -> Bool {
  witness_codex_preflight_refuses_missing_cli_before_auth()
    && witness_codex_preflight_refuses_missing_env_binding()
    && witness_codex_preflight_separates_broken_runtime_from_auth()
    && witness_codex_preflight_refuses_wrong_executable_identity()
    && witness_codex_preflight_refuses_login_status_nonzero()
    && witness_codex_preflight_accepts_cli_auth_verdict_without_parsing_wording()
    && witness_fresh_spawn_wire_names_selected_provider()
}

test fn dashboard_instance_dispatch_contract_keystone_holds() -> Bool {
  witness_dispatch_result_ok_spawned_and_live()
    && witness_dispatch_result_refusals_not_ok()
    && witness_dispatch_status_labels_glued_to_ok_set()
    && witness_dispatch_status_labels_pin_wire_contract()
    && witness_band_fold_pins_operator_vocabulary()
    && witness_no_result_maps_to_in_progress()
    && witness_ok_labels_derive_from_band_fold()
    && witness_label_band_cover_reds_on_missing_row()
    && witness_exemplar_roster_reconciles_variant_set()
    && witness_exemplar_roster_missing_variant_reds()
    && codex_provider_v0_preflight_keystone_holds()
}

data attempt_grain_home_note: String = "The attempt-grain claim (U1) is PURE — content hashes and string derivations, no host reach — so it lives in dag/test/claim/dispatch_attempts_witness_test.dag, which discovery scans on every affected PR. This file is BinWitnessWet-excluded because its witnesses execute real host commands; a pure row parked here is enrolled with zero executing consumers, which is exactly what the Phase 0(b) admission invariant refused (CI 30184138800). Deferral is a property of the EXECUTION the row needs, never of the module it happens to name."
