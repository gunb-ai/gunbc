fn retract_plan_is_safe(
  plan: List<gunbc.roadmap_dashboard_instance.DashboardInstanceRetractOp>,
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
) -> Bool {
  count(plan) == 5
    && any(plan, op => match op {
      gunbc.roadmap_dashboard_instance.DashboardStopService { instance_id, tmux_server: _ } =>
        instance_id == instance.instance_id
      _ => false
    })
    && any(plan, op => match op {
      gunbc.roadmap_dashboard_instance.DashboardRefuseUnlessAttemptsEmpty { path } =>
        path == gunbc.roadmap_dashboard_instance.dashboard_instance_dispatch_worktree_root(instance: instance)
      _ => false
    })
    && any(plan, op => match op {
      gunbc.roadmap_dashboard_instance.DashboardRemoveSourceRepo { path } => path == instance.repo_root
      _ => false
    })
    && any(plan, op => match op {
      gunbc.roadmap_dashboard_instance.DashboardRemoveLocalOrigin { path } => path == instance.local_origin_root
      _ => false
    })
    && any(plan, op => match op {
      gunbc.roadmap_dashboard_instance.DashboardPreserveSourceBundle { path } =>
        string_contains(s: path as String, pattern: "/inbox/source.bundle")
      _ => false
    })
}

test fn dashboard_retract_preserves_recovery_anchor_and_provider_state() -> Bool {
  let lab = gunbc.roadmap_dashboard_instance.srv1_lab_dashboard_instance()
  match gunbc.roadmap_dashboard_instance.dashboard_instance_retract_plan(instance: lab) {
    gunbc.roadmap_dashboard_instance.DashboardInstanceRetractPlan { plan } =>
      retract_plan_is_safe(plan: plan, instance: lab)
        && all(plan, op => match op {
          gunbc.roadmap_dashboard_instance.DashboardRemoveSourceRepo { path } =>
            path != gunbc.roadmap_dashboard_instance.dashboard_instance_provider_state_root(instance: lab)
          gunbc.roadmap_dashboard_instance.DashboardRemoveLocalOrigin { path } =>
            path != gunbc.roadmap_dashboard_instance.dashboard_instance_provider_state_root(instance: lab)
          _ => true
        })
    gunbc.roadmap_dashboard_instance.DashboardInstanceRetractRefused { reason: _ } => false
  }
}

test fn dashboard_retract_refuses_production_existing_repo() -> Bool {
  match gunbc.roadmap_dashboard_instance.dashboard_instance_retract_plan(instance: gunbc.roadmap_dashboard_instance.srv1_live_dashboard_instance()) {
    gunbc.roadmap_dashboard_instance.DashboardInstanceRetractPlan { plan: _ } => false
    gunbc.roadmap_dashboard_instance.DashboardInstanceRetractRefused { reason } =>
      string_contains(s: reason as String, pattern: "not owned")
  }
}

// THE CLAIM THAT GOES RED IF THE HOST FACTS ARE RE-PINNED, and it has to be built from synthetic values to say anything at all. srv1 and srv2 run the same layout convention, so their rows carry byte-identical strings; asserting that srv2's instance holds srv2's serve binary is therefore true whether the constructor reads the layout argument or ignores it and substitutes srv1's row. Every value-comparison against the real instances is blind to exactly the defect this change fixes.\n\nSo the layout below names paths no host row carries. If the constructor propagates its argument, the instance holds them; if anyone re-pins a literal — the state it was in before this change — that field reverts to srv1's row and this claim fails on it. The final three conjuncts assert non-equality with the srv1 rows explicitly, so the failure names which fact regressed rather than reporting a bare false.
fn witness_synthetic_layout() -> gunbc.host_layout.GunbcHostLayout {
  gunbc.host_layout.GunbcHostLayout {
    host_identity: "witness-host" as std.types.NonEmptyStr,
    gunbc_serve_binary: "/witness/bin/gunbc" as std.types.FilePath,
    roadmap_codex_home: "/witness/codex-home" as std.types.FilePath,
    controller_repo: "/witness/controller-repo" as std.types.FilePath,
    codex_bundled_executable: Present { value: "/witness/codex-bundled" as std.types.FilePath },
  }
}

fn witness_synthetic_instance() -> gunbc.roadmap_dashboard_instance.HostDashboardInstance {
  gunbc.roadmap_dashboard_instance.isolated_dashboard_instance(
    instance_id: "witness-synthetic" as std.types.NonEmptyStr,
    layout: witness_synthetic_layout(),
    root: "/witness/root" as std.types.FilePath,
    serve_function: "witness_handler" as std.types.NonEmptyStr,
    listen_port: 19999,
    source_anchor_ref: "refs/heads/witness-anchor" as std.types.NonEmptyStr,
    actuation: gunbc.roadmap_dashboard_instance.DashboardActuating,
    provision_transport: gunbc.roadmap_dashboard_instance.DashboardLocalProvision,
  )
}

data anchor_ref_witness_note: String = "THE LITERAL THAT WOULD HAVE SERVED THE WRONG BRANCH SILENTLY. Every isolated instance inherited the constructor's hardcoded refs/heads/session/codex-provider-feedback-v0, so a new lab provisioned itself from another lane's stale feedback branch while its instance id, posture and page all read correctly — no refusal, just unintended content rendered plausibly. Unlike the host facts, which produced identical values on both hosts and therefore no wrong output at all, this one produces a page that looks right and is not.\\n\\nThe claim asserts the anchors are per-instance and DIFFER, so collapsing them back to one shared literal fails whichever way it collapses."

test fn source_anchor_is_per_instance_not_one_shared_literal() -> Bool {
  let synthetic = instance_anchor_ref(i: witness_synthetic_instance())
  let srv2_lab = instance_anchor_ref(i: gunbc.roadmap_dashboard_instance.srv2_lab_dashboard_instance())
  let srv1_lab = instance_anchor_ref(i: gunbc.roadmap_dashboard_instance.srv1_lab_dashboard_instance())
  synthetic == "refs/heads/witness-anchor"
    && srv2_lab == "refs/remotes/origin/main"
    && srv1_lab == "refs/heads/session/codex-provider-feedback-v0"
    && !(srv2_lab == srv1_lab)
}

data layout_no_longer_supplies_the_binary_note: String = "serve_binary MOVED OFF THE LAYOUT AND THIS CLAIM CAUGHT IT, which is the whole reason it exists. It used to assert the synthetic layout's /witness/bin/gunbc reached the instance; once binaries became instance-derived it asserts /witness/root/bin/gunbc instead — derived from the instance ROOT, not from the host row. The claim went red on the change rather than quietly continuing to pass, so the behaviour shift was visible at the point it happened instead of at the point something downstream broke.\\n\\nThe remaining conjuncts still prove the original property for the two fields the layout genuinely still supplies — provider state root and controller repo — and still assert non-equality with the srv1 rows, so re-pinning either to a host literal fails here. GunbcHostLayout.gunbc_serve_binary now has exactly one consumer left, srv1-live's own declaration, which is the dissolution trigger recorded on that row: it is a per-instance fact wearing a per-host name."

test fn isolated_instance_carries_the_layout_it_was_given() -> Bool {
  let i = witness_synthetic_instance()
  i.host_identity == "witness-host"
    && i.serve_binary == "/witness/root/bin/gunbc"
    && gunbc.roadmap_dashboard_instance.dashboard_instance_provider_state_root(instance: i) == "/witness/codex-home"
    && match gunbc.roadmap_dashboard_instance.dashboard_instance_provider_executable(instance: i) {
      Present { value: executable } => executable == "/witness/codex-bundled"
      Absent => false
    }
    && match i.source_seed {
      gunbc.roadmap_dashboard_instance.DashboardGitBundle {
        controller_repo,
        staged_bundle: _,
        anchor_ref: _,
        history_remote: _,
      } => controller_repo == "/witness/controller-repo"
      gunbc.roadmap_dashboard_instance.DashboardExistingRepo { anchor_ref: _ } => false
    }
    && !(i.serve_binary == gunbc.host_layout.srv1_gunbc_serve_binary)
    && !(gunbc.roadmap_dashboard_instance.dashboard_instance_provider_state_root(instance: i) == gunbc.host_layout.srv1_roadmap_codex_home)
    && !(match i.source_seed {
      gunbc.roadmap_dashboard_instance.DashboardGitBundle {
        controller_repo,
        staged_bundle: _,
        anchor_ref: _,
        history_remote: _,
      } => controller_repo == gunbc.host_layout.srv1_dashboard_controller_repo
      gunbc.roadmap_dashboard_instance.DashboardExistingRepo { anchor_ref: _ } => false
    })
}

// srv2's lab differs from its preview sibling in the two ways that made the preview unusable, and both are asserted here rather than left to the reader of a posture field. It is DashboardActuating, so the dispatch endpoint is admitted instead of refusing by construction; and it produces a non-empty provision plan bound to its own paths, which is what the preview's declaration never had an actuation entry to execute. Owned-path disjointness from BOTH the preview and production is asserted because two instances on one machine sharing a root would have them provisioning over each other — the preview's root and this one's are siblings under the same parent directory.
test fn srv2_lab_is_actuating_unlike_its_preview_sibling() -> Bool {
  let lab = gunbc.roadmap_dashboard_instance.srv2_lab_dashboard_instance()
  let preview = gunbc.roadmap_dashboard_instance.srv2_preview_dashboard_instance()
  lab.actuation == gunbc.roadmap_dashboard_instance.DashboardActuating
    && preview.actuation == gunbc.roadmap_dashboard_instance.DashboardObserveOnly
    && lab.host_identity == "srv2"
    && preview.host_identity == "srv2"
    && !(lab.listen_port == preview.listen_port)
    && !(lab.serve_function == preview.serve_function)
}

test fn srv2_lab_owns_paths_disjoint_from_preview_and_production() -> Bool {
  gunbc.roadmap_dashboard_instance.dashboard_instance_paths_are_owned(instance: gunbc.roadmap_dashboard_instance.srv2_lab_dashboard_instance())
    && gunbc.roadmap_dashboard_instance.dashboard_instances_have_disjoint_owned_paths(
      a: gunbc.roadmap_dashboard_instance.srv2_lab_dashboard_instance(),
      b: gunbc.roadmap_dashboard_instance.srv2_preview_dashboard_instance(),
    )
    && gunbc.roadmap_dashboard_instance.dashboard_instances_have_disjoint_owned_paths(
      a: gunbc.roadmap_dashboard_instance.srv2_lab_dashboard_instance(),
      b: gunbc.roadmap_dashboard_instance.srv1_live_dashboard_instance(),
    )
    && extdeps.tmux.shape_tmux_ls_argv_for(scope: gunbc.roadmap_dashboard_instance.srv2_lab_dashboard_instance().tmux_server) == [
      "-L", "srv2-lab-v1-deletion", "ls",
    ]
}

test fn srv2_lab_has_a_provision_plan_bound_to_itself() -> Bool {
  let lab = gunbc.roadmap_dashboard_instance.srv2_lab_dashboard_instance()
  let plan = gunbc.roadmap_dashboard_instance.dashboard_instance_provision_plan(instance: lab)
  count(plan) == 16
    && plan_binds_instance_paths(plan: plan, instance: lab)
    && plan_binds_source_ref_translation(plan: plan, instance: lab)
}

test fn dashboard_instance_model_keystone_holds() -> Bool {
  isolated_instance_carries_the_layout_it_was_given()
    && a_refused_observation_never_derives_a_plan()
    && derived_codex_home_matches_the_authenticated_directory()
    && the_plan_creates_every_path_it_later_verifies()
    && each_instance_ensures_its_own_binary_not_a_shared_one()
    && source_anchor_is_per_instance_not_one_shared_literal()
    && srv2_lab_is_actuating_unlike_its_preview_sibling()
    && srv2_lab_owns_paths_disjoint_from_preview_and_production()
    && srv2_lab_has_a_provision_plan_bound_to_itself()
    && dashboard_instance_paths_move_as_one_owned_root()
    && dashboard_lab_and_production_owned_paths_are_disjoint()
    && dashboard_actuation_posture_is_instance_data()
    && dashboard_tmux_server_is_namespaced_off_production()
    && dashboard_provision_plan_consumes_one_instance()
    && dashboard_reconcile_converges_only_after_independent_readback()
    && dashboard_reconcile_plans_missing_health_without_claiming_convergence()
    && dashboard_reconcile_refuses_production_overlap()
    && dashboard_reconcile_refuses_destructive_source_replacement()
    && dashboard_reconcile_refreshes_owned_clean_stale_revision()
    && dashboard_reconcile_refuses_unreadable_source_revision()
    && dashboard_bundle_is_required_for_convergence()
    && dashboard_source_capture_has_no_manual_await_step()
    && dashboard_reconcile_refuses_unmarked_existing_source()
    && dashboard_retract_preserves_recovery_anchor_and_provider_state()
    && dashboard_retract_refuses_production_existing_repo()
}

// TWO PATHS THE PLAN VERIFIED WITHOUT EVER CREATING, both found by running the thing rather than reading it. The provider state root: DashboardVerifyProviderAuth reads it, nothing made it, so the only command that can populate it failed with 'that path does not exist' before any OAuth began — an operator hitting a CLI error instead of a typed refusal. The serve binary: instances used to BORROW production's, which is why no install step existed; making each instance own its own closed a retract hazard and left the install with no owner.\n\nBoth claims are stated as containment in the plan rather than as a count, because a count says the plan has sixteen things and nothing about whether the right two are among them. Each asserts the op targets the INSTANCE's own path — a plan that ensured some other instance's binary would satisfy a count and fail here.
fn plan_ensures_provider_state_root(
  plan: List<gunbc.roadmap_dashboard_instance.DashboardInstanceProvisionOp>,
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
) -> Bool {
  any(plan, op => match op {
    gunbc.roadmap_dashboard_instance.DashboardEnsureProviderStateRoot { path } =>
      path == gunbc.roadmap_dashboard_instance.dashboard_instance_provider_state_root(instance: instance)
    _ => false
  })
}

fn plan_ensures_serve_binary(
  plan: List<gunbc.roadmap_dashboard_instance.DashboardInstanceProvisionOp>,
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
) -> Bool {
  any(plan, op => match op {
    gunbc.roadmap_dashboard_instance.DashboardEnsureServeBinary { controller_repo: _, built_binary: _, path } =>
      path == instance.serve_binary
    _ => false
  })
}

test fn the_plan_creates_every_path_it_later_verifies() -> Bool {
  let lab = gunbc.roadmap_dashboard_instance.srv1_lab_dashboard_instance()
  let srv2 = gunbc.roadmap_dashboard_instance.srv2_lab_dashboard_instance()
  let lab_plan = gunbc.roadmap_dashboard_instance.dashboard_instance_provision_plan(instance: lab)
  let srv2_plan = gunbc.roadmap_dashboard_instance.dashboard_instance_provision_plan(instance: srv2)
  plan_ensures_provider_state_root(plan: lab_plan, instance: lab)
    && plan_ensures_serve_binary(plan: lab_plan, instance: lab)
    && plan_ensures_provider_state_root(plan: srv2_plan, instance: srv2)
    && plan_ensures_serve_binary(plan: srv2_plan, instance: srv2)
}

test fn each_instance_ensures_its_own_binary_not_a_shared_one() -> Bool {
  let lab = gunbc.roadmap_dashboard_instance.srv1_lab_dashboard_instance()
  let srv2 = gunbc.roadmap_dashboard_instance.srv2_lab_dashboard_instance()
  !(lab.serve_binary == srv2.serve_binary)
    && !(lab.serve_binary == gunbc.roadmap_dashboard_instance.srv1_live_dashboard_instance().serve_binary)
    && !(srv2.serve_binary == gunbc.roadmap_dashboard_instance.srv1_live_dashboard_instance().serve_binary)
}

// THE DERIVED PATH MUST EQUAL THE DIRECTORY THAT ACTUALLY HOLDS THE CREDENTIAL, which is the only thing that makes the derivation an improvement rather than a rewrite. gunbc.provider_account composes it from three facts owned at three layers — the operator home, codex's default root name, and the @label convention — and if that composition produced anything other than /home/briansrls/.codex@gunbc-roadmap the provider would preflight against an empty directory and report unauthenticated forever while a perfectly good login sat one path away.\n\nThe literal here is deliberate and is not a duplicate of the derivation. It is the OBSERVED path on srv2, recorded independently so the claim compares a computation against a measurement; asserting the derivation equals itself would pass unconditionally and prove nothing. Both hosts are checked because they share the convention and a divergence between them would mean the shared label had stopped being shared.
test fn derived_codex_home_matches_the_authenticated_directory() -> Bool {
  let observed = "/home/briansrls/.codex@gunbc-roadmap"
  (gunbc.host_layout.srv1_host_layout().roadmap_codex_home as String) == observed
    && (gunbc.host_layout.srv2_host_layout().roadmap_codex_home as String) == observed
    && (gunbc.provider_account.codex_account_state_root(
         home: "/home/briansrls" as std.types.FilePath,
         selection: gunbc.provider_account.CodexDefaultAccount,
       ) as String) == "/home/briansrls/.codex"
}

// THE CLAIM THAT SEPARATES 'NOT THERE' FROM 'COULD NOT LOOK'. Both observations carry identical Bools — every presence field false — and they differ only in whether a probe refused. Before the refusal channel existed they were the same value, so a transport failure derived a full Apply plan: create the root, clone the source, install the service. Every one of those operations against a host whose state was never read.\n\nThe pairing is what makes it discriminating. Asserting only that a refused observation refuses would pass in a world where EVERYTHING refuses; asserting only that an absent observation plans would pass in a world where nothing does. Holding the Bools identical and varying just the channel isolates the single fact under test, and the claim fails the moment reconcile reads a field before the channel.\n\nThis is the operator-facing harm, not a modeling nicety: told a state root is absent, a human creates it — which is a real action taken on a fact nobody established.
fn observed_all_absent(refusals: List<String>) -> gunbc.roadmap_dashboard_instance.DashboardInstanceObserved {
  gunbc.roadmap_dashboard_instance.DashboardInstanceObserved {
    observation_refusals: refusals,
    root_present: false,
    ownership_marker_present: false,
    bundle_present: false,
    origin_present: false,
    source_present: false,
    source_revision_observed: false,
    source_revision_current: false,
    source_revision_detail: "",
    attempts_present: false,
    attempt_state_present: false,
    provider_runtime_ready: false,
    provider_runtime_detail: "",
    provider_authenticated: false,
    provider_auth_detail: "",
    service_present: false,
    health_current: false,
    production_untouched: true,
    source_anchor_matches: false,
  }
}

test fn a_refused_observation_never_derives_a_plan() -> Bool {
  let lab = gunbc.roadmap_dashboard_instance.srv1_lab_dashboard_instance()
  let genuinely_absent = observed_all_absent(refusals: [])
  let could_not_look = observed_all_absent(
    refusals: ["path observation could not run for /x: ssh: connect refused"],
  )
  match gunbc.roadmap_dashboard_instance.dashboard_instance_reconcile(instance: lab, observed: could_not_look) {
    gunbc.roadmap_dashboard_instance.DashboardInstanceRefused { reason } =>
      string_contains(s: reason as String, pattern: "observation incomplete")
        && match gunbc.roadmap_dashboard_instance.dashboard_instance_reconcile(instance: lab, observed: genuinely_absent) {
          gunbc.roadmap_dashboard_instance.DashboardInstanceApply { plan } => count(plan) > 0
          gunbc.roadmap_dashboard_instance.DashboardInstanceRefused { reason: _ } => false
          gunbc.roadmap_dashboard_instance.DashboardInstanceConverged => false
        }
    gunbc.roadmap_dashboard_instance.DashboardInstanceApply { plan: _ } => false
    gunbc.roadmap_dashboard_instance.DashboardInstanceConverged => false
  }
}

// THE DISCRIMINATORS FOR HOST-SHARED DISPATCH STATE, built around a counterfactual rather than around the declared slots alone. Asserting only that the declared slots agree would pass for a reason that has nothing to do with the law: they are authored correctly, so the assertion cannot tell a working law from an absent one. That is also why the deletion of the second production slot cost this file no discrimination — the pair claim it removed was the weak half, and the counterfactual pair below is the strong one. witness_production_slot takes the two dispatch roots as parameters, so the SAME constructor produces the agreeing slot and the slot that keeps its own attempt-state root, and the pair goes green and red respectively off one definition.\n\nThe red control is the shape the outage actually had: a production slot deriving dispatch roots under its own instance root. That is what put a teardown of live dispatch evidence on the per-push cutover path, and it is what must never typecheck-and-pass again. The lab control is its mirror — a host-shared root handed to an instance-owned lab breaks the isolation labs exist for, so consistency must refuse that direction too.
fn witness_production_slot(
  instance_id: std.types.NonEmptyStr,
  root: std.types.FilePath,
  scope: gunbc.roadmap_dashboard_instance.DispatchStateScope,
  host_identity: std.types.NonEmptyStr,
) -> gunbc.roadmap_dashboard_instance.HostDashboardInstance {
  let binary = gunbc.roadmap_dashboard_instance.dashboard_instance_child(root: root, child: "bin/gunbc")
  gunbc.roadmap_dashboard_instance.HostDashboardInstance {
    instance_id: instance_id,
    host_identity: host_identity,
    provision_parent_root: "/opt" as std.types.FilePath,
    instance_root: root,
    local_origin_root: gunbc.roadmap_dashboard_instance.dashboard_instance_child(root: root, child: "gunbc"),
    local_origin_publish_ref: "refs/heads/main" as std.types.NonEmptyStr,
    repo_root: gunbc.roadmap_dashboard_instance.dashboard_instance_child(root: root, child: "gunbc"),
    dispatch_base_ref: "origin/main" as std.types.NonEmptyStr,
    dispatch_state_scope: scope,
    execution_environment: gunbc.roadmap_dashboard_instance.dashboard_execution_environment(serve_binary: binary),
    provider_state: gunbc.roadmap_dashboard_instance.DashboardExistingProviderState {
      root: gunbc.host_layout.srv1_roadmap_codex_home,
      executable: gunbc.host_layout.srv1_codex_bundled_executable(),
      binding: gunbc.provider_account.admitted_single_session_binding(
        selection: gunbc.provider_account.codex_roadmap_account_selection(),
        evidence: gunbc.provider_account.codex_roadmap_account_evidence,
      ),
    },
    serve_binary: binary,
    serve_function: "witness_handler" as std.types.NonEmptyStr,
    listen_host: "0.0.0.0" as std.types.NonEmptyStr,
    listen_port: 18081,
    tmux_server: extdeps.tmux.DefaultTmuxServer,
    actuation: gunbc.roadmap_dashboard_instance.DashboardActuating,
    provision_transport: gunbc.roadmap_dashboard_instance.DashboardSshProvision { host: "srv1" as std.types.NonEmptyStr },
    source_seed: gunbc.roadmap_dashboard_instance.DashboardExistingRepo { anchor_ref: "origin/main" as std.types.NonEmptyStr },
  }
}

fn witness_agreeing_slot() -> gunbc.roadmap_dashboard_instance.HostDashboardInstance {
  witness_production_slot(
    instance_id: "srv1-witness-agreeing" as std.types.NonEmptyStr,
    root: "/opt/gunbc-witness" as std.types.FilePath,
    scope: gunbc.roadmap_dashboard_instance.DispatchStateHostShared {
      worktree_root: gunbc.host_layout.srv1_dispatch_worktree_root,
      attempt_state_root: gunbc.host_layout.srv1_dispatch_attempt_state_root,
    },
    host_identity: "srv1" as std.types.NonEmptyStr,
  )
}

fn witness_slot_keeping_its_own_dispatch_state() -> gunbc.roadmap_dashboard_instance.HostDashboardInstance {
  let root = "/opt/gunbc-witness" as std.types.FilePath
  witness_production_slot(
    instance_id: "srv1-witness-own-state" as std.types.NonEmptyStr,
    root: root,
    scope: gunbc.roadmap_dashboard_instance.DispatchStateHostShared {
      worktree_root: gunbc.roadmap_dashboard_instance.dashboard_instance_child(root: root, child: "dispatch-worktrees"),
      attempt_state_root: gunbc.roadmap_dashboard_instance.dashboard_instance_child(root: root, child: "attempt-state"),
    },
    host_identity: "srv1" as std.types.NonEmptyStr,
  )
}

// NARROWED with the second slot's deletion. This used to assert that the two production slots
// agreed with each other AND with the host roots; the agreement half has no second operand now, and
// asserting it against one instance would be a self-equality. What survives is the half that was
// always the law: a production slot resolves dispatch state to the HOST's roots, not to its own.
// The pair-disagreement direction is not lost — the counterfactual constructor below still produces
// an agreeing slot and a self-rooted one off one definition, which is where that discrimination
// actually lived (see the discriminator note above).
test fn a_production_slot_resolves_dispatch_state_to_the_host_roots() -> Bool {
  let live = gunbc.roadmap_dashboard_instance.srv1_live_dashboard_instance()
  gunbc.roadmap_dashboard_instance.dashboard_instance_dispatch_worktree_root(instance: live) == gunbc.host_layout.srv1_dispatch_worktree_root
    && gunbc.roadmap_dashboard_instance.dashboard_instance_dispatch_attempt_state_root(instance: live) == gunbc.host_layout.srv1_dispatch_attempt_state_root
}

test fn a_production_slot_keeping_its_own_dispatch_state_is_refused() -> Bool {
  let live = gunbc.roadmap_dashboard_instance.srv1_live_dashboard_instance()
  let agreeing = witness_agreeing_slot()
  let own_state = witness_slot_keeping_its_own_dispatch_state()
  gunbc.roadmap_dashboard_instance.dashboard_instances_dispatch_state_is_consistent(a: live, b: agreeing)
    && !gunbc.roadmap_dashboard_instance.dashboard_instances_dispatch_state_is_consistent(a: live, b: own_state)
}

data lab_shared_root_became_unrepresentable_note: String = "THIS PAIR USED TO CONSTRUCT THE INVALID STATE AND ASSERT THE LAW CAUGHT IT. It no longer can, and that is the climb rather than a gap: an instance-owned scope carries only CHILD NAMES, so its roots are derived beneath its own instance_root and there is no way to author a lab pointing at the host-shared roots. The DESIGN §4b rule is that a climb deletes the lower-rung production machinery but keeps the evidence enrolled, so these assert the DERIVATION that makes the old red unwritable instead of pretending to still construct it — a witness whose invalid input became unrepresentable must change what it asserts, not keep a name that no longer describes it.\\n\\nWHAT REMAINS LAW-CAUGHT, stated so the residue is not mistaken for a wall: a host-shared scope still carries two free FilePath values, so a production slot CAN be authored with roots that are not the layout rows. That state is representable and dashboard_instances_dispatch_state_is_consistent is what refuses it — rung two, not rung four — and a_production_slot_keeping_its_own_dispatch_state_is_refused is its live discriminating red. Closing it needs host-shared roots DERIVED from a total host-identity-to-layout lookup rather than carried, which is a host_layout change; dissolve-on: feature:host-dispatch-roots-derived."

test fn an_instance_owned_scope_cannot_reach_the_shared_roots() -> Bool {
  let lab = gunbc.roadmap_dashboard_instance.srv1_lab_dashboard_instance()
  let live = gunbc.roadmap_dashboard_instance.srv1_live_dashboard_instance()
  gunbc.roadmap_dashboard_instance.dashboard_path_is_under(
    path: gunbc.roadmap_dashboard_instance.dashboard_instance_dispatch_attempt_state_root(instance: lab),
    root: lab.instance_root,
  )
    && gunbc.roadmap_dashboard_instance.dashboard_path_is_under(
      path: gunbc.roadmap_dashboard_instance.dashboard_instance_dispatch_worktree_root(instance: lab),
      root: lab.instance_root,
    )
    && gunbc.roadmap_dashboard_instance.dashboard_instance_dispatch_attempt_state_root(instance: lab) != gunbc.host_layout.srv1_dispatch_attempt_state_root
    && gunbc.roadmap_dashboard_instance.dashboard_instances_dispatch_state_is_consistent(a: live, b: lab)
}

// The exemption is asserted over the COUNTERFACTUAL host-shared slot, not over srv1-live, and the
// reason is a measured one rather than a preference. This claim's discriminating half is that a
// host-shared instance's attempt-state root is NOT under its own instance root. srv1-live is
// host-shared, but the host's dispatch roots live under /opt/gunbc, which IS srv1-live's instance
// root -- so on the surviving production instance the exemption is invisible, and the negation
// reads false. The deleted green slot was the instance where the two roots differed, which is why
// this claim was written against it and why repointing it at srv1-live failed by execution.
// witness_agreeing_slot is a host-shared slot rooted at /opt/gunbc-witness carrying srv1's dispatch
// roots -- the same shape the deleted slot had, built from the constructor this file already uses
// for exactly this purpose. Per the discriminator note above, the counterfactual pair is where this
// law's discrimination has always lived; the declared slots were only ever a convenient instance.
test fn host_shared_slots_are_exempt_from_containment_but_labs_are_not() -> Bool {
  let shared = witness_agreeing_slot()
  let lab = gunbc.roadmap_dashboard_instance.srv1_lab_dashboard_instance()
  gunbc.roadmap_dashboard_instance.dashboard_instance_paths_are_owned(instance: shared)
    && gunbc.roadmap_dashboard_instance.dashboard_instance_paths_are_owned(instance: lab)
    && !gunbc.roadmap_dashboard_instance.dashboard_path_is_under(
      path: gunbc.roadmap_dashboard_instance.dashboard_instance_dispatch_attempt_state_root(instance: shared),
      root: shared.instance_root,
    )
}

data different_host_shared_slots_are_valid_note: String = "The finding-3 red: two host-shared instances on DIFFERENT hosts carry byte-identical layout paths, and the first cut routed them into path-disjointness where identical strings refuse. Same-host disagreement must still refuse, so this asserts both directions off one pair — collapsing the different-host arm back into disjointness reds the first conjunct, and dropping the same-host equality check reds the second."

test fn host_shared_slots_on_different_hosts_are_consistent() -> Bool {
  let live = gunbc.roadmap_dashboard_instance.srv1_live_dashboard_instance()
  let other_host = witness_production_slot(
    instance_id: "srv2-witness-live" as std.types.NonEmptyStr,
    root: "/opt/gunbc" as std.types.FilePath,
    scope: gunbc.roadmap_dashboard_instance.DispatchStateHostShared {
      worktree_root: gunbc.host_layout.srv1_dispatch_worktree_root,
      attempt_state_root: gunbc.host_layout.srv1_dispatch_attempt_state_root,
    },
    host_identity: "srv2" as std.types.NonEmptyStr,
  )
  gunbc.roadmap_dashboard_instance.dashboard_instances_dispatch_state_is_consistent(a: live, b: other_host)
    && !gunbc.roadmap_dashboard_instance.dashboard_instances_dispatch_state_is_consistent(
      a: live,
      b: witness_slot_keeping_its_own_dispatch_state(),
    )
}

// RE-ENROLLED against srv1-lab rather than retired. The deleted green slot was this claim's second
// operand, but the hazard is not a property of that slot: two instances sharing a serve_binary,
// repo root or origin root on one host is the defect, and srv1-lab is a real second instance to
// hold it over. Retiring this with the slot would have deleted a live obligation along with its
// most recent example.
test fn the_binary_hazard_stays_closed_across_instances_on_one_host() -> Bool {
  let live = gunbc.roadmap_dashboard_instance.srv1_live_dashboard_instance()
  let lab = gunbc.roadmap_dashboard_instance.srv1_lab_dashboard_instance()
  live.serve_binary != lab.serve_binary
    && live.repo_root != lab.repo_root
    && live.local_origin_root != lab.local_origin_root
    && gunbc.roadmap_dashboard_instance.dashboard_instances_have_disjoint_owned_paths(a: live, b: lab)
}
