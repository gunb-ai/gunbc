test fn dashboard_source_capture_has_no_manual_await_step() -> Bool {
  let lab = gunbc.roadmap_dashboard_instance.srv1_lab_dashboard_instance()
  let plan = gunbc.roadmap_dashboard_instance.dashboard_instance_provision_plan(instance: lab)
  any(plan, op => match op {
    gunbc.roadmap_dashboard_instance.DashboardHydrateControllerHistory {
      controller_repo,
      history_remote,
    } =>
      controller_repo == gunbc.host_layout.srv1_dashboard_controller_repo
        && history_remote == "origin"
    _ => false
  })
    && any(plan, op => match op {
    gunbc.roadmap_dashboard_instance.DashboardPrepareGitBundle {
      controller_repo,
      anchor_ref,
    } =>
      controller_repo == gunbc.host_layout.srv1_dashboard_controller_repo
        && anchor_ref == "refs/heads/session/codex-provider-feedback-v0"
    _ => false
  })
    && any(plan, op => match op {
      gunbc.roadmap_dashboard_instance.DashboardStageGitBundle {
        controller_repo,
        staged_bundle,
      } =>
        controller_repo == gunbc.host_layout.srv1_dashboard_controller_repo
          && staged_bundle == "/home/briansrls/.local/share/gunbc-dashboard-instances/codex-provider-feedback-v0/inbox/source.bundle"
      _ => false
    })
}

