module test.claim.roadmap_dashboard_instance_witness


test fn dashboard_instance_paths_move_as_one_owned_root() -> Bool {
  let lab = gunbc.roadmap_dashboard_instance.srv1_lab_dashboard_instance()
  gunbc.roadmap_dashboard_instance.dashboard_instance_paths_are_owned(instance: lab)
    && lab.provision_parent_root == "/home/briansrls/.local/share"
    && lab.repo_root == "/home/briansrls/.local/share/gunbc-dashboard-instances/codex-provider-feedback-v0/source"
    && gunbc.roadmap_dashboard_instance.dashboard_instance_dispatch_worktree_root(instance: lab) == "/home/briansrls/.local/share/gunbc-dashboard-instances/codex-provider-feedback-v0/attempts"
    && lab.local_origin_root == "/home/briansrls/.local/share/gunbc-dashboard-instances/codex-provider-feedback-v0/origin.git"
}

test fn dashboard_lab_and_production_owned_paths_are_disjoint() -> Bool {
  gunbc.roadmap_dashboard_instance.dashboard_instances_have_disjoint_owned_paths(
    a: gunbc.roadmap_dashboard_instance.srv1_lab_dashboard_instance(),
    b: gunbc.roadmap_dashboard_instance.srv1_live_dashboard_instance(),
  )
}

test fn dashboard_actuation_posture_is_instance_data() -> Bool {
  let live = gunbc.roadmap_dashboard_instance.srv1_live_dashboard_instance()
  let lab = gunbc.roadmap_dashboard_instance.srv1_lab_dashboard_instance()
  let preview = gunbc.roadmap_dashboard_instance.srv2_preview_dashboard_instance()
  live.actuation == gunbc.roadmap_dashboard_instance.DashboardActuating
    && lab.actuation == gunbc.roadmap_dashboard_instance.DashboardActuating
    && preview.actuation == gunbc.roadmap_dashboard_instance.DashboardObserveOnly
}

test fn dashboard_tmux_server_is_namespaced_off_production() -> Bool {
  let live = gunbc.roadmap_dashboard_instance.srv1_live_dashboard_instance()
  let lab = gunbc.roadmap_dashboard_instance.srv1_lab_dashboard_instance()
  let preview = gunbc.roadmap_dashboard_instance.srv2_preview_dashboard_instance()
  extdeps.tmux.shape_tmux_ls_argv_for(scope: live.tmux_server) == ["ls"]
    && extdeps.tmux.shape_tmux_ls_argv_for(scope: lab.tmux_server) == [
      "-L", "srv1-lab-codex-feedback-v0", "ls",
    ]
    && extdeps.tmux.shape_tmux_ls_argv_for(scope: preview.tmux_server) == [
      "-L", "srv2-preview-codex-feedback-v0", "ls",
    ]
}

fn instance_anchor_ref(i: gunbc.roadmap_dashboard_instance.HostDashboardInstance) -> String {
  match i.source_seed {
    gunbc.roadmap_dashboard_instance.DashboardGitBundle {
      controller_repo: _,
      staged_bundle: _,
      anchor_ref,
      history_remote: _,
    } => anchor_ref as String
    gunbc.roadmap_dashboard_instance.DashboardExistingRepo { anchor_ref } => anchor_ref as String
  }
}

fn plan_binds_instance_paths(
  plan: List<gunbc.roadmap_dashboard_instance.DashboardInstanceProvisionOp>,
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
) -> Bool {
  let source_bound = any(plan, op => match op {
    gunbc.roadmap_dashboard_instance.DashboardEnsureSourceRepo { origin, repo, anchor_ref: _ } =>
      origin == instance.local_origin_root && repo == instance.repo_root
    _ => false
  })
  let attempts_bound = any(plan, op => match op {
    gunbc.roadmap_dashboard_instance.DashboardEnsureDirectory { path } => path == gunbc.roadmap_dashboard_instance.dashboard_instance_dispatch_worktree_root(instance: instance)
    _ => false
  })
  let attempt_state_bound = any(plan, op => match op {
    gunbc.roadmap_dashboard_instance.DashboardEnsureDirectory { path } => path == gunbc.roadmap_dashboard_instance.dashboard_instance_dispatch_attempt_state_root(instance: instance)
    _ => false
  })
  let marker_bound = any(plan, op => match op {
    gunbc.roadmap_dashboard_instance.DashboardEnsureOwnershipMarker { path, instance_id } =>
      path == gunbc.roadmap_dashboard_instance.dashboard_instance_ownership_marker_path(instance: instance)
        && instance_id == instance.instance_id
    _ => false
  })
  let auth_bound = any(plan, op => match op {
    gunbc.roadmap_dashboard_instance.DashboardVerifyProviderAuth { executable, state_root } =>
      state_root == gunbc.roadmap_dashboard_instance.dashboard_instance_provider_state_root(instance: instance)
        && gunbc.roadmap_dashboard_instance.dashboard_instance_provider_executable_matches(
          executable: executable,
          instance: instance,
        )
    _ => false
  })
  let runtime_bound = any(plan, op => match op {
    gunbc.roadmap_dashboard_instance.DashboardVerifyProviderRuntime { executable, state_root } =>
      state_root == gunbc.roadmap_dashboard_instance.dashboard_instance_provider_state_root(instance: instance)
        && gunbc.roadmap_dashboard_instance.dashboard_instance_provider_executable_matches(
          executable: executable,
          instance: instance,
        )
    _ => false
  })
  let service_bound = any(plan, op => match op {
    gunbc.roadmap_dashboard_instance.DashboardEnsureService {
      instance_id,
      binary,
      workdir,
      handler,
      host,
      port,
      tmux_server: _,
    } =>
      instance_id == instance.instance_id
        && binary == instance.serve_binary
        && workdir == instance.repo_root
        && handler == instance.serve_function
        && host == instance.listen_host
        && port == instance.listen_port
    _ => false
  })
  source_bound
    && attempts_bound
    && attempt_state_bound
    && marker_bound
    && runtime_bound
    && auth_bound
    && service_bound
}

fn plan_binds_source_ref_translation(
  plan: List<gunbc.roadmap_dashboard_instance.DashboardInstanceProvisionOp>,
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
) -> Bool {
  any(plan, op => match op {
    gunbc.roadmap_dashboard_instance.DashboardEnsureLocalOrigin {
      bundle: _,
      origin,
      source_ref,
      publish_ref,
    } =>
      origin == instance.local_origin_root
        && source_ref == instance_anchor_ref(i: instance)
        && publish_ref == instance.local_origin_publish_ref
    _ => false
  })
    && any(plan, op => match op {
      gunbc.roadmap_dashboard_instance.DashboardEnsureSourceRepo { origin: _, repo: _, anchor_ref } =>
        anchor_ref == instance.dispatch_base_ref
      _ => false
    })
}

test fn dashboard_provision_plan_consumes_one_instance() -> Bool {
  let lab = gunbc.roadmap_dashboard_instance.srv1_lab_dashboard_instance()
  let plan = gunbc.roadmap_dashboard_instance.dashboard_instance_provision_plan(instance: lab)
  count(plan) == 16
    && plan_binds_instance_paths(plan: plan, instance: lab)
    && plan_binds_source_ref_translation(plan: plan, instance: lab)
}

fn lab_observed(
  production_untouched: Bool,
  source_anchor_matches: Bool,
  source_revision_observed: Bool,
  source_revision_current: Bool,
  health_current: Bool,
) -> gunbc.roadmap_dashboard_instance.DashboardInstanceObserved {
  gunbc.roadmap_dashboard_instance.DashboardInstanceObserved {
    observation_refusals: [],
    root_present: true,
    ownership_marker_present: true,
    bundle_present: true,
    origin_present: true,
    source_present: true,
    source_revision_observed: source_revision_observed,
    source_revision_current: source_revision_current,
    source_revision_detail: if !source_revision_observed {
      "git rev-parse HEAD refused"
    } else if source_revision_current {
      "desired=abc observed=abc"
    } else {
      "source revision drift: desired=abc observed=def"
    },
    attempts_present: true,
    attempt_state_present: true,
    provider_runtime_ready: true,
    provider_runtime_detail: "codex-cli test",
    provider_authenticated: true,
    provider_auth_detail: "Logged in using ChatGPT",
    service_present: true,
    health_current: health_current,
    production_untouched: production_untouched,
    source_anchor_matches: source_anchor_matches,
  }
}

test fn dashboard_reconcile_converges_only_after_independent_readback() -> Bool {
  match gunbc.roadmap_dashboard_instance.dashboard_instance_reconcile(
    instance: gunbc.roadmap_dashboard_instance.srv1_lab_dashboard_instance(),
    observed: lab_observed(
      production_untouched: true,
      source_anchor_matches: true,
      source_revision_observed: true,
      source_revision_current: true,
      health_current: true,
    ),
  ) {
    gunbc.roadmap_dashboard_instance.DashboardInstanceConverged => true
    _ => false
  }
}

test fn dashboard_reconcile_plans_missing_health_without_claiming_convergence() -> Bool {
  match gunbc.roadmap_dashboard_instance.dashboard_instance_reconcile(
    instance: gunbc.roadmap_dashboard_instance.srv1_lab_dashboard_instance(),
    observed: lab_observed(
      production_untouched: true,
      source_anchor_matches: true,
      source_revision_observed: true,
      source_revision_current: true,
      health_current: false,
    ),
  ) {
    gunbc.roadmap_dashboard_instance.DashboardInstanceApply { plan } => count(plan) > 0
    _ => false
  }
}

test fn dashboard_reconcile_refuses_production_overlap() -> Bool {
  match gunbc.roadmap_dashboard_instance.dashboard_instance_reconcile(
    instance: gunbc.roadmap_dashboard_instance.srv1_lab_dashboard_instance(),
    observed: lab_observed(
      production_untouched: false,
      source_anchor_matches: true,
      source_revision_observed: true,
      source_revision_current: true,
      health_current: false,
    ),
  ) {
    gunbc.roadmap_dashboard_instance.DashboardInstanceRefused { reason } => reason == "production isolation read-back failed"
    _ => false
  }
}

test fn dashboard_reconcile_refuses_destructive_source_replacement() -> Bool {
  match gunbc.roadmap_dashboard_instance.dashboard_instance_reconcile(
    instance: gunbc.roadmap_dashboard_instance.srv1_lab_dashboard_instance(),
