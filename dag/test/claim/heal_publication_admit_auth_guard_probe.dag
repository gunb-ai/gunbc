module test.claim.heal_publication_admit_auth_guard_probe

// COND-3 PROBE + RED CONTROL for the heal publisher admit fix.
//
// 1. admit_auth_declared_unwired(): reproduces the BASE defect -- an auth-declaring GitHub read reached
//    with auth_token:"" and no credential in the environment. github.Pulls declares `auth: Bearer` sourced
//    from GITHUB_TOKEN; resolve_auth falls through to the env source, finds nothing (GITHUB_TOKEN unset),
//    and the PRE-SEND guard fails CLOSED with AuthDeclaredButUnwired -- no request leaves the process. The
//    base observe_candidate_world_wet performed four such reads, so EVERY non-empty candidate died at admit.
//    Run WITHOUT GITHUB_TOKEN in the environment this entry MUST be refused by that guard (the run exits
//    non-zero carrying AuthDeclaredButUnwired). It is a negative control: its correct behaviour is refusal.
//
// 2. env_token_visibility(): reports which branch of resolve_env_var_token the wet run takes -- whether
//    the modelled shell.Env.Get sees GITHUB_TOKEN in the process environment at all. This is the fact the
//    DESIGN-5 decision rests on: if the admit step's `GITHUB_TOKEN: ${{ github.token }}` line is not
//    readable by the interpreter, it is dead decoration and is deleted from the emitter rather than left
//    cited as a safeguard it does not provide.

import extdeps.github.pulls { Open, Closed }
import extdeps.shell
import std.types { Secret }
import std.optional { Present, Absent }
import std.process { ProcessExit, ExitSuccess, exit_failure }

fn admit_auth_declared_unwired() -> ProcessExit {
  match github.Pulls.Get(auth_token: "" as Secret, owner: "gunb-ai", repo: "gunbc", pull_number: 15669) {
    RestAnswered { answer: _ } => exit_failure(reason: "RED control UNEXPECTED: a credential-less bearer read was answered; the guard did not fire")
    RestRefused { refusal } => exit_failure(reason: "RED control UNEXPECTED: credential-less bearer read was refused at the transport, not by the pre-send auth guard")
  }
}

fn env_token_visibility() -> ProcessExit {
  match shell.Env.Get(name: "GITHUB_TOKEN").value {
    Absent => exit_failure(reason: "GITHUB_TOKEN_ABSENT: the interpreter's modelled shell.Env.Get does not see GITHUB_TOKEN -- a step env line setting it is dead decoration")
    Present { value: v } => if v == "" { exit_failure(reason: "GITHUB_TOKEN_EMPTY: modelled shell.Env.Get sees GITHUB_TOKEN but it is empty") } else { ExitSuccess }
  }
}
