module test.claim.secret_rotation_actuate_witness_test

import std.types { Bool }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import gunbc.auth.secret_rotation_actuate {
  version_number_from_resolved_identity,
  secret_rotation_actuate_frontier_note,
}
import extdeps.cloud.gcp.secret_manager { SmResolvedVersionIdentity }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn version_number_extracted_from_resolved_identity() -> Bool {
  match version_number_from_resolved_identity(
    identity: "projects/example-project/secrets/example-secret/versions/3" as SmResolvedVersionIdentity,
  ) {
    Present { value: n } => n as String == "3"
    Absent => false
  }
}

test fn frontier_note_documents_closed_pr_not_unmerged_branch() -> Bool {
  string_contains(s: secret_rotation_actuate_frontier_note, pattern: "#7971")
    && string_contains(s: secret_rotation_actuate_frontier_note, pattern: "operator decision")
    && string_contains(s: secret_rotation_actuate_frontier_note, pattern: "github_actions_wif")
    && string_contains(s: secret_rotation_actuate_frontier_note, pattern: "HOST SCOPE")
    && string_contains(s: secret_rotation_actuate_frontier_note, pattern: "dead work")
}
