// ── THE POSITIVE CONTROLS: ONE NUMBER, BOTH ENDS ──────────────────────────────────────────────────

fn launch_slots(launch: ReplicaEngineLaunch) -> Int {
  match launch {
    EngineLaunchDerived { slots: s } => positive_slot_count_value(slots: s)
    EngineLaunchEstimated { slots: s, standings: _ } => positive_slot_count_value(slots: s)
    EngineLaunchRefused { deployment: _, reason: _ } => 0
  }
}

fn launch_flags(launch: ReplicaEngineLaunch) -> StrataServeFlags {
  match launch {
    EngineLaunchDerived { flags: f, slots: _ } => f
    EngineLaunchEstimated { flags: f, slots: _, standings: _ } => f
    EngineLaunchRefused { deployment: _, reason: _ } => srv3_strata_flags
  }
}

fn launch_is_estimated(launch: ReplicaEngineLaunch) -> Bool {
  match launch {
    EngineLaunchEstimated { flags: _, slots: _, standings: ss } => count(ss) > 0
    EngineLaunchDerived { flags: _, slots: _ } => false
    EngineLaunchRefused { deployment: _, reason: _ } => false
  }
}

fn is_shape_refusal(launch: ReplicaEngineLaunch, want: ServingShapeRefusalReason) -> Bool {
  match launch {
    EngineLaunchRefused { deployment: _, reason: LaunchShapeRefused { reason: r } } => reason_is(r: r, want: want)
    EngineLaunchRefused { deployment: _, reason: _ } => false
    EngineLaunchDerived { flags: _, slots: _ } => false
    EngineLaunchEstimated { flags: _, slots: _, standings: _ } => false
  }
}

fn reason_is(r: ServingShapeRefusalReason, want: ServingShapeRefusalReason) -> Bool {
  match r {
    ShapeLeastRateBelowPolicyAtConcurrency => match want { ShapeLeastRateBelowPolicyAtConcurrency => true _ => false }
    _ => match want { ShapeLeastRateBelowPolicyAtConcurrency => false _ => true }
  }
}

// Words of a flag after its literal: "--parallel 2" renders as ["--parallel", "2"].
type FlagScan {
  prev: String
  found: String
}

fn flag_value(words: List<String>, flag: String) -> String {
  let last = fold(words, init: FlagScan { prev: "", found: "" }, f: (acc, w) =>
    if acc.found != "" {
      acc
    } else if acc.prev == flag {
      FlagScan { prev: w, found: w }
    } else {
      FlagScan { prev: w, found: "" }
    })
  last.found
}

// POSITIVE CONTROL 1: srv3's production engine launch carries 2 slots -- the shape's turns from the one
// 26 tok/s-at-2-way reading and the policy's 10 tok/s floor -- and its argv renders --parallel 2. The
// figure is a borrowed reading, so the reservation is an ESTIMATE launch carrying its standing; the
// derivation never promotes an estimate into a derived figure.
test fn srv3_engine_launch_derives_two_slots_from_the_shape() -> Bool {
  let launch = replica_engine_launch(p: srv3_strata_profile)
  launch_slots(launch: launch) == 2
    && launch_is_estimated(launch: launch)
    && flag_value(words: strata_serve_flag_words(flags: launch_flags(launch: launch)), flag: "--parallel") == "2"
}

// POSITIVE CONTROL 2: the shape's turns and the engine's slots are the SAME derivation, not two numbers
// that happen to agree: ask the shape and the launch on one profile and compare.
test fn engine_slots_and_shape_turns_are_one_number() -> Bool {
  match replica_shape_named(p: srv3_strata_profile, deployment: "srv3-strata") {
    ServingShapeEstimated { deployment: _, turns: t, held: _, bound: _, cold_reread: _, standings: _ } =>
      launch_slots(launch: replica_engine_launch(p: srv3_strata_profile)) == (t as Int)
    ServingShapeDerived { deployment: _, turns: t, held: _, bound: _, cold_reread: _ } =>
      launch_slots(launch: replica_engine_launch(p: srv3_strata_profile)) == (t as Int)
    ServingShapeRefused { deployment: _, reason: _ } => false
  }
}

// A STRATA ROW WITH NO READ PARAMETERS RENDERS NO LAUNCH: srv4's launched parameters sit in its memory
// rows' prose with a read obligation; the derivation refuses to name them rather than invent argv.
test fn unread_parameters_refuse_the_launch_rather_than_inventing_argv() -> Bool {
  match replica_engine_launch(p: srv4_strata_profile) {
    EngineLaunchRefused { deployment: d, reason: LaunchParametersUnread { obligation: o } } =>
      d == "srv4-strata" && (o as String) != ""
    EngineLaunchRefused { deployment: _, reason: _ } => false
    EngineLaunchDerived { flags: _, slots: _ } => false
    EngineLaunchEstimated { flags: _, slots: _, standings: _ } => false
  }
}

// ── THE DISCRIMINATING REDS: THE 2026-11-24 OPERATING POINT REFUSES THE SHAPE AND THE LAUNCH ──

// The fixture: srv3's row with the throughput read at FOUR-way -- the shape the fleet actually ran
// before 19:56 UTC on 2026-11-24 (router cap 4 with the engine reserving 8 slots). The same 26 tok/s
// aggregate read at 4 puts every stream at ~6.5, below the policy's 10 tok/s floor, so the arm must
// refuse: no production row can reserve 4 slots for a fleet whose policy asks 10 tok/s per stream. What
// this refusal establishes is exactly the rung the failure-mode row declares: the 2026-11-24 OPERATING
// POINT can no longer be the shape of a production launch through replica_engine_launch -- the turns
// derive from the readings and the readings fail the policy floor at 4-way. It does NOT establish that a
// second slot count cannot be written anywhere: strata_launch_with_parallel is public and a raw
// StrataServeFlags is still constructible (the cell record does exactly that, with 8). Mechanically-
// Preventable, witnesses-kept; the structural rung needs the host read-back join the row's standing names.
fn srv3_variant_read_at(concurrency: Nat, aggregate: Nat) -> ServingReplicaProfile {
  ServingReplicaProfile {
    id: "srv3-strata",
    host: operator_host_srv3,
    engine_kind: StrataEngine,
    model: StrataModel {
      artifact: srv3_iq3_s_artifact,
      artifact_standing: TranscribedUncited { read_obligation: "fixture: digests read on srv3" },
      flags: Present { value: srv3_strata_launch_parameters },
      flags_standing: Present { value: TranscribedUncited { read_obligation: "fixture" } },
    },
    gpu: map(srv3_grant.devices, d => card_of(d: d)),
    parallelism: ReplicaAcrossDevices { devices: srv3_grant.devices.length() },
    context_window: serving_fleet_context_cap,
    figures: FiguresOnRow {
      context: token_count(count: 100000),
      throughput: ThroughputOperatorReading {
        tokens_per_second: tokens_per_second(count: aggregate),
        at_concurrency: concurrency,
        standing: TranscribedUncited { read_obligation: "fixture reading at the named concurrency" },
      },
      cold_prefill: Present { value: tokens_per_second(count: 838) },
      cold_prefill_standing: TranscribedUncited { read_obligation: "fixture" },
    },
    warm_ladder: [engine_warm_swap(e: srv3_strata_engine_memory, cost: srv3_strata_snapshot_cost, restore: millisecond(count: 300), standing: TranscribedUncited { read_obligation: "fixture" })],
    grant: GrantAdmits { conversations: 4 },
    engine_memory: Present { value: srv3_strata_engine_memory },
    expert_artifact: Present { value: srv3_routed_expert_artifact },
    monthly_cost: Absent,
    monthly_cost_standing: Absent,
  }
}

// RED 1 (the misconfiguration, refused): the 4-way arm sits below the per-stream floor and the engine
// launch refuses rather than rendering a slot count the policy cannot price.
test fn the_2026_11_24_four_way_state_refuses_the_engine_launch() -> Bool {
  is_shape_refusal(
    launch: replica_engine_launch(p: srv3_variant_read_at(concurrency: 4, aggregate: 26)),
    want: ShapeLeastRateBelowPolicyAtConcurrency,
  )
}

// RED 2 (the accepted positive control beside it): the SAME aggregate read at the concurrency the
// operator chose -- 2-way, where the 2026-11-24 readings sat 13.6-15.8 tok/s per stream, above the
// floor -- derives exactly the 2 slots the host now runs. This goes red if slots ever decouple from
// turns again, in either direction.
test fn the_two_way_operating_point_derives_two_slots() -> Bool {
  launch_slots(launch: replica_engine_launch(p: srv3_variant_read_at(concurrency: 2, aggregate: 26))) == 2
}

// THE BENCHMARK CELL KEEPS ITS OWN CONCURRENCY: the cell measures throughput AT a concurrency, so its
// --parallel is the experiment's independent variable, not an admission. The repair removed the writable
// number from PRODUCTION rows only; cutting it from the cell would delete the experiment.
test fn the_benchmark_cell_still_writes_its_own_concurrency() -> Bool {
  positive_slot_count_value(slots: srv3_strata_flags.parallel) == 8
}

// ── THE PRICE THE ROWS CARRY (observations, not facts) ────────────────────────────────────────────
// The stream figures read at 4-way -- the concurrency the hand-written router cap imposed -- sit BELOW
// the conversation policy's floor; the figures read at the 2-way operating point sit above it. The
// comparison is made HERE, against serving_conversation_policy.min_stream_rate, on every arm these
// claims select: no reading is exempted by its concurrency and no threshold is hard-coded beside the
// policy's own number. The shape's refusal arithmetic and the operator's hand tuning agree because they
// are the same arithmetic -- that is what prices concurrency as a selection rather than a knob
// (gunbc.design_argument::selection_precedes_convergence).

fn is_n_way_stream(o: ConcurrencyObservation, n: Nat) -> Bool {
  match o {
    PerStreamAtConcurrency { deployment: _, concurrency: c, tokens_per_second: _, window: _, standing: _ } => positive_slot_count_value(slots: c) == n
    AggregatePerMachine { deployment: _, concurrency: _, tokens_per_second: _, window: _, standing: _ } => false
  }
}

fn every_stream_below(o: List<ConcurrencyObservation>, rate: Nat) -> Bool {
  fold(o, init: true, f: (acc, x) => acc && match x {
    PerStreamAtConcurrency { deployment: _, concurrency: _, tokens_per_second: r, window: _, standing: _ } => tokens_per_second_count(r: r) < rate
    AggregatePerMachine { deployment: _, concurrency: _, tokens_per_second: _, window: _, standing: _ } => true
  })
}

fn every_stream_at_or_above(o: List<ConcurrencyObservation>, rate: Nat) -> Bool {
  fold(o, init: true, f: (acc, x) => acc && match x {
    PerStreamAtConcurrency { deployment: _, concurrency: _, tokens_per_second: r, window: _, standing: _ } => tokens_per_second_count(r: r) >= rate
    AggregatePerMachine { deployment: _, concurrency: _, tokens_per_second: _, window: _, standing: _ } => true
  })
}

fn floor_rate() -> Nat {
  tokens_per_second_count(r: serving_conversation_policy.min_stream_rate)
}

test fn four_way_streams_measured_below_the_policy_floor() -> Bool {
  let four = filter(strata_concurrency_price_observations, o => is_n_way_stream(o: o, n: 4))
  count(four) > 0 && every_stream_below(o: four, rate: floor_rate())
}

test fn two_way_streams_measured_at_or_above_the_policy_floor() -> Bool {
  let two = filter(strata_concurrency_price_observations, o => is_n_way_stream(o: o, n: 2))
  count(two) > 0 && every_stream_at_or_above(o: two, rate: floor_rate())
}

// THE AGGREGATE PRICE, as the addendum pairs it: a machine at 4-way (srv3, 14 tok/s relayed) barely beat
// a machine at 1-way (srv4, 11) -- quadrupling the streams bought barely one stream's more. If a future
// edit makes concurrent streams look like a multiplier on these cards, this claim goes red: the rows
// themselves falsify the claim of "little aggregate gain", as the reconciled instrument must.
fn machine_aggregate(deployment: String, concurrency: Nat) -> Optional<Nat> {
  fold(strata_concurrency_price_observations, init: Absent, f: (acc, x) =>
    match acc {
      Present { value: n } => Present { value: n }
      Absent => match x {
        AggregatePerMachine { deployment: d, concurrency: c, tokens_per_second: r, window: _, standing: _ } =>
          if d == deployment && positive_slot_count_value(slots: c) == concurrency { Present { value: tokens_per_second_count(r: r) } } else { Absent }
        PerStreamAtConcurrency { deployment: _, concurrency: _, tokens_per_second: _, window: _, standing: _ } => Absent
      }
    })
}

test fn four_streams_barely_beat_one_stream_per_machine() -> Bool {
  match machine_aggregate(deployment: "srv3-strata", concurrency: 4) {
    Present { value: four_way } => match machine_aggregate(deployment: "srv4-strata", concurrency: 1) {
      Present { value: one_way } => four_way > one_way && four_way < 2 * one_way
      Absent => false
    }
    Absent => false
  }
}

// -- the recurring_failure_mode row this PR files, read back through its module.

// The row exists, names the class once, and carries its rung reading: found below the
// ladder (the fleet ran the state), standing on MechanicallyPreventable with the ceiling
// StructurallyGuaranteed -- the host read-back join that would close it is named, not built.
fn the_failure_mode_row_names_the_class_and_its_rung() -> Bool {
  let row = engine_slots_written_beside_the_admission_that_bounds_them
  let named = row.identity == "engine_slots_written_beside_the_admission_that_bounds_them"
  let rung_ok = match row.rung {
    RungRead { found_at: FoundBelowTheLadder, standing: BelowCeiling { current: FoundOnRung { rung: MechanicallyPreventable }, ceiling: StructurallyGuaranteed, blocker: ClimbableButUnbuilt, trigger_capability: _ } } => true
    _ => false
  }
  let receipt_count = fold_list(xs: row.receipts, empty: 0, cons: (acc, r) => acc + 1)
  named && rung_ok && (receipt_count >= 6)
}
