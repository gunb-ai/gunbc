// CLAIMS THE CANDIDATE FIELD OWNS. The configurations a host COULD run, composed from rows the fleet already
// has -- pinned so a candidate cannot silently become a deployment (the empty `replicas` list is the fact that
// the fleet has never run it), cannot silently gain a byte (the ladders are composed from the roster's own
// rungs), and cannot silently borrow a rate (an unmeasured candidate names the reading it needs).
module test.claim.serving.serving_replica_configuration_witness

import std.types { Bool, List, NonEmptyStr, String }
import std.algebra { string_contains }
import std.measure {
  PositiveMeasureCountBuilt, PositiveMeasureCountNonPositive, PositiveMeasureCountRefused, byte_size_count,
  gibibyte, gibibyte_to_byte_size, permille_count, positive_measure_count_nat, token_count_value,
}
import std.optional { Optional, Present, Absent }
import std.decl_ref { DeclarationRef, declaration_ref_identity }
import gunbc.fleet.fleet_host_identity { HostIdentity, operator_host_6ce85c, operator_host_srv1, operator_host_srv3, operator_host_srv4 }
import product.host_identity { host_identity_eq }
import gunbc.serving.serving_capacity_anchor { ServingWarmSwap, SwapTierDisk, SwapTierHostRam, WarmSwapRestores }
import gunbc.serving.serving_replica_profile {
  FiguresUnmeasured, ServingReplicaProfile, srv1_vllm_replica_0_profile,
}
import extdeps.external_authority { TranscribedUncited }
import gunbc.serving.serving_replica_configuration {
  ReplicaConfiguration, configuration_expert_rungs, configuration_figures_refusal,
  configuration_figures_resolved, configuration_host_charges, configuration_run_identity,
  configuration_prefix_cache_capacity, configuration_warm_session_capacity,
  host_configurations, prefix_cache_capacity_against, prefix_cache_pass_ratio, prefix_cache_ratio_denominator,
  prefix_cache_ratio_permille,
  replica_configuration_field, h11_pass_prefix_cache_ratio,
  CapacityExceededByPopulation, CapacityFromAssumedRung, CapacityFromReadRung, CapacityHoldsPopulation,
  CapacityUndetermined, WarmSessionCapacityFigure,
  PopulationObserved, PopulationUnread, RatioEmptyOnPass, RatioObserved, RatioUnread,
  srv1_pair_l1_l2_configuration, srv1_pair_l1_only_configuration, srv1_tp2_l1_l2_configuration,
  srv3_batch8_ram_only_configuration, srv3_batch1_slotfile_configuration, srv4_batch1_slotfile_configuration,
  srv4_batch8_ram_only_configuration, h11_four_engines_configuration, h11_two_engines_configuration,
}

// THE FIELD IS PER HOST, WITH THE CANDIDATES THE OPERATOR ACTUALLY CHOOSES BETWEEN: srv1's pair against TP=2
// against the pair without the disk tier; srv3's batch-8 RAM tier against the batch-1 slot file; srv4's running
// slot file against a batched refusal; h11's four engines against two. Nine rows over four hosts, and every
// candidate belongs to the host it is a way of running.
fn all_on_host(host: HostIdentity, candidates: List<ReplicaConfiguration>) -> Bool {
  fold(candidates, init: true, f: (acc, c) => acc && host_identity_eq(a: c.host, b: host))
}

test fn the_field_is_per_host_with_its_configurations() -> Bool {
  replica_configuration_field.length() == 9
    && host_configurations(host: operator_host_srv1).length() == 3
    && host_configurations(host: operator_host_srv3).length() == 2
    && host_configurations(host: operator_host_srv4).length() == 2
    && host_configurations(host: operator_host_6ce85c).length() == 2
    && all_on_host(host: operator_host_srv1, candidates: host_configurations(host: operator_host_srv1))
}

// THE QUESTION IS WHICH CONFIGURATION THIS HOST RUNS, not which host runs next: srv1's three candidates all
// carry srv1's host and differ in what srv1 would do -- its parallelism, or which warm tiers it keeps.
test fn srv1_candidates_are_the_three_shapes_it_could_run() -> Bool {
  srv1_pair_l1_l2_configuration.id as String == "srv1-pair-l1-l2" as String
    && srv1_pair_l1_only_configuration.id as String == "srv1-pair-l1-only" as String
    && srv1_tp2_l1_l2_configuration.id as String == "srv1-tp2-l1-l2" as String
    && srv1_pair_l1_l2_configuration.replica_count == 2
    && srv1_tp2_l1_l2_configuration.replica_count == 1
}

// A deployed candidate's replicas ARE the roster's rows for that host -- the same rows, not a copy -- and a
// never-run candidate says so with an empty list rather than inventing a deployment. The distinction is the
// fleet's, and a witness that let a candidate claim a deployment it never had would be worse than no field.
test fn deployed_candidates_reuse_the_roster_and_never_run_ones_say_so() -> Bool {
  srv1_pair_l1_l2_configuration.replicas.length() == 2
    && srv3_batch8_ram_only_configuration.replicas.length() == 1
    && h11_four_engines_configuration.replicas.length() == 4
    && srv1_tp2_l1_l2_configuration.replicas.length() == 0
    && srv3_batch1_slotfile_configuration.replicas.length() == 0
    && srv4_batch8_ram_only_configuration.replicas.length() == 0
    && h11_two_engines_configuration.replicas.length() == 2
}

// THE RAM-ONLY VARIANT IS THE PAIR MINUS ITS DISK RUNG: same replicas, same checkpoint, one fewer tier. The
// ladder is composed from the roster's own rungs, so the only thing that differs between the two candidates is
// the tier LMCache was not configured with -- which is exactly the trade the selector is asked to weigh.
test fn the_ram_only_variant_is_the_pair_without_its_disk_tier() -> Bool {
  srv1_pair_l1_l2_configuration.warm_ladder.length() == 2
    && srv1_pair_l1_only_configuration.warm_ladder.length() == 1
    && match srv1_pair_l1_only_configuration.warm_ladder.first() {
      Present { value: r } => match r {
        WarmSwapRestores { tier: SwapTierHostRam } => true
        _ => false
      }
      Absent => false
    }
}

// THE CHARGES FOLLOW THE LADDERS. srv4 reads its tiers, so both of its candidates charge the host real bytes;
// the slot-file candidate holds warm disk the batched one does not, and that difference comes from the rungs
// rather than from prose. The engine base, the cache and the expert floor are all read rows on this host, so
// the RAM axis resolves and the disk axis DISAGREES between the two candidates.
test fn srv4_candidates_charge_equal_ram() -> Bool {
  let with_rung = configuration_host_charges(c: srv4_batch1_slotfile_configuration)
  let without = configuration_host_charges(c: srv4_batch8_ram_only_configuration)
  match with_rung.ram {
    Present { value: a } =>
      match without.ram {
        Present { value: b } =>
          byte_size_count(b: a) == byte_size_count(b: b) && byte_size_count(b: a) > 0
        Absent => false
      }
    Absent => false
  }
}

test fn srv4_ram_only_config_holds_no_warm_disk() -> Bool {
  let without = configuration_host_charges(c: srv4_batch8_ram_only_configuration)
  match without.disk {
    Present { value: zeroed } => byte_size_count(b: zeroed) == 0
    Absent => false
  }
}

// The slot-file candidate's disk axis REFUSES -- srv4's parked budget is declared, not read -- and the refusal
// is an obligation naming the budget, not a quiet zero. That gap is the difference between the two
// configurations, stated honestly.
test fn srv4_slotfile_disk_axis_refuses_with_an_obligation() -> Bool {
  let with_rung = configuration_host_charges(c: srv4_batch1_slotfile_configuration)
  match with_rung.disk {
    Absent => with_rung.obligations.length() > 0
    Present { value: _ } => false
  }
}

test fn h11_candidates_refuse_to_charge_ram_they_have_not_read() -> Bool {
  let four = configuration_host_charges(c: h11_four_engines_configuration)
  let two = configuration_host_charges(c: h11_two_engines_configuration)
  match four.ram {
    Absent => four.obligations.length() > 0
      && match two.ram { Absent => two.obligations.length() > 0 Present { value: _ } => false }
    Present { value: _ } => false
  }
}

// A candidate the fleet has never run either has a reading for its exact shape or names the one it needs.
// srv3's batch-1 slot file and srv4's batched engine have never been measured, so their figures resolve to
// nothing and the refusal is the reading to take -- at the fleet's window, not "somewhere".
test fn unmeasured_candidates_name_the_reading_they_need() -> Bool {
  match configuration_figures_resolved(c: srv3_batch1_slotfile_configuration) {
    Absent => match configuration_figures_refusal(c: srv3_batch1_slotfile_configuration) {
      Present { value: reason } => string_contains(s: reason as String, pattern: "batch 1" as String)
        && string_contains(s: reason as String, pattern: "229376" as String)
      Absent => false
    }
    Present { value: _ } => false
  }
}

// TP=2 IS MEASURED AND STILL UNQUOTABLE AT THE ANCHOR: srv1_topology_readings has it at 150k, so the figure
// resolves through the run-keyed resolver rather than being absent -- and a selector asking at the pool's
// window must still refuse it, which is the choice module's test, not this one. What this pins is that the
// candidate carries the measurement it has rather than pretending it has none.
test fn tp2_carries_its_150k_measurement() -> Bool {
  match configuration_figures_resolved(c: srv1_tp2_l1_l2_configuration) {
    Present { value: f } => token_count_value(t: f.context) == 150000
    Absent => false
  }
}

// A never-run candidate is still keyed by a run: its identity comes from the host's live deployment row,
// because the only thing that differs between it and what runs today is the shape it would launch in. Absent
// that, a reading could not be checked against it and the coordinate figures would refuse -- which is the
// fail-closed direction, but not the honest one.
test fn never_run_candidates_still_carry_a_run_identity() -> Bool {
  match configuration_run_identity(c: srv1_tp2_l1_l2_configuration) {
    Present { value: want } => want.kv_cache_dtype as String == "fp8" as String
    Absent => false
  }
}

// The expert placement each candidate runs, as its host's artifact row states it: srv4's candidate carries the
// capped, disk-backed ladder, h11's carries the mlocked one, and srv1's carries nothing at all -- which the
// charge reports as an obligation.
test fn candidates_carry_their_hosts_expert_placement() -> Bool {
  configuration_expert_rungs(c: srv4_batch1_slotfile_configuration).length() == 3
    && configuration_expert_rungs(c: h11_four_engines_configuration).length() == 1
    && configuration_expert_rungs(c: srv1_pair_l1_l2_configuration).length() == 0
}

// ── THE CACHE CAPACITY AGAINST THE POPULATION, AND THE RATIO A PASS LEAVES ──────────────────────
//
// RED CONTROL, planted before the carrier grew the fields
// (gunbc.recurring_failure_mode::a_capacity_default_sized_for_one_workload_shape_inherited_by_another):
// a configuration serving more concurrent agents than its own cache rows can hold warm must read a refusal
// that carries BOTH numbers, and a pass that printed no hit ratio must read a refusal rather than a fine.
// Every arm below is reachable because the join's boundary takes supplied numbers; the field's rows supply
// the rest. An empty population here would be VOID, not green, so each claim names the rows it counted.

// THE CAPACITY IS STATED IN AGENTS, FROM THE ROWS THAT ALREADY CARRY CACHE BYTES AND SLOTS: h11's engine
// row parks a conversation at 750 MiB plus 10 KiB per token, holds 8192 MiB and 6 slots, and at the fleet's
// 229376-token window that is two warm sessions per engine -- four engines eight, two engines four.
// THE FIGURE TRAVELS WITH ITS BASIS. h11's cache figure is a ServingMemoryRead whose provenance names one
// bus's config file and the script that set that value on every bus -- which is a generalization over
// buses nobody read, and the capacity says so instead of reporting a bare 8.
test fn the_warm_session_capacity_is_read_from_the_rows() -> Bool {
  match configuration_warm_session_capacity(c: h11_four_engines_configuration) {
    Present { value: four } => four.value == 8
      && match four.basis {
        CapacityFromReadRung { provenance: provenance } =>
          string_contains(s: provenance as String, pattern: "cfg-87.json" as String)
        CapacityFromAssumedRung { reason: _ } => false
      }
      && match configuration_warm_session_capacity(c: h11_two_engines_configuration) {
        Present { value: two } => two.value == 4
        Absent => false
      }
    Absent => false
  }
}

// THE JOIN ON SUPPLIED NUMBERS, WHICH IS WHERE THE RED CONTROL LIVES: five admitted sessions against a
// cache that
// holds four warm is Exceeded and says both numbers out loud; four against four is not exceeded, because
// the capacity is a count of what fits, not a margin.
// THE STANDINGS GO THROUGH THE JOIN, NOT AROUND IT. The numbers here are witness-supplied -- a count this
// claim made up to exercise the arithmetic -- and the verdict still carries the standing it was handed, so
// a decided arm cannot be produced by quietly dropping the provenance on the way in.
test fn an_over_capacity_population_refuses_and_names_both_numbers() -> Bool {
  let supplied_standing = TranscribedUncited { read_obligation: "witness-supplied: a population this claim invented to exercise the join" as NonEmptyStr }
  let supplied_capacity = WarmSessionCapacityFigure {
    value: 4,
    basis: CapacityFromAssumedRung { reason: "witness-supplied: an allowance, not a reading" as NonEmptyStr },
  }
  match prefix_cache_capacity_against(sessions_admitted: 5, population_standing: supplied_standing, capacity: supplied_capacity) {
    CapacityExceededByPopulation { sessions_admitted: admitted_held, warm_sessions: warm_held, population_standing: standing_held, capacity_basis: basis_held } =>
      admitted_held == 5 && warm_held == 4
        && match standing_held {
          TranscribedUncited { read_obligation: why } => string_contains(s: why as String, pattern: "witness-supplied" as String)
          _ => false
        }
        && match basis_held {
          CapacityFromAssumedRung { reason: _ } => true
          CapacityFromReadRung { provenance: _ } => false
        }
    _ => false
  }
    && match prefix_cache_capacity_against(sessions_admitted: 4, population_standing: supplied_standing, capacity: supplied_capacity) {
      CapacityHoldsPopulation { sessions_admitted: admitted_held, warm_sessions: warm_held, population_standing: _, capacity_basis: _ } =>
        admitted_held == 4 && warm_held == 4
      _ => false
    }
}

// THE FIELD'S OWN ROWS JOIN THE SAME WAY. h11 carries the population the 2026-11-21 pass reported there
// (four concurrent agents) against the cache its engine rows state, so it lands on a decided arm. Every
// host nobody counted lands on Undetermined carrying an obligation -- which is the fail-closed direction,
// not a pass: an uncounted population never becomes a Fits.
// AND THE DECIDED ARM SAYS WHAT IT WAS BUILT FROM. h11's Holds carries the population's standing (a relay's
// counters from the operator's report of 2026-11-21) and the capacity's basis (one bus's config file,
// generalized across engines). A Holds whose provenance was dropped at the join fails here, which is the
// point: the bet is typed, not prose (gunbc.design_argument::epistemic_humility).
test fn the_field_joins_where_it_can_and_refuses_where_it_cannot() -> Bool {
  match configuration_prefix_cache_capacity(c: h11_four_engines_configuration) {
    CapacityHoldsPopulation { sessions_admitted: admitted_held, warm_sessions: warm_held, population_standing: standing_held, capacity_basis: basis_held } =>
      admitted_held == 4 && warm_held == 8
        && match standing_held {
          TranscribedUncited { read_obligation: why } => string_contains(s: why as String, pattern: "2026-11-21" as String)
          _ => false
        }
        && match basis_held {
          CapacityFromReadRung { provenance: provenance } => string_contains(s: provenance as String, pattern: "conversation-cache-mib" as String)
          CapacityFromAssumedRung { reason: _ } => false
        }
    _ => false
  }
    && match configuration_prefix_cache_capacity(c: srv3_batch8_ram_only_configuration) {
      CapacityUndetermined { obligations: obligations } => obligations.length() > 0
      _ => false
    }
    && match configuration_prefix_cache_capacity(c: srv4_batch1_slotfile_configuration) {
      CapacityUndetermined { obligations: obligations } => obligations.length() > 0
      _ => false
    }
}

// THE POPULATION IS A STANDING ON EVERY CANDIDATE, NEVER A DEFAULT. Only the h11 configuration the 2026-11-21
// pass actually ran on carries an observed count; the other eight say nobody counted them. A field that
// defaulted the population to one would be the failure mode written into the model: the capacity would stay
// right for a workload shape that no longer exists.
test fn the_population_is_a_standing_on_every_candidate() -> Bool {
  let unread = filter(replica_configuration_field, c => match c.concurrent_agents {
    PopulationUnread { obligation: _ } => true
    PopulationObserved { admitted_sessions: _, standing: _ } => false
  })
  replica_configuration_field.length() == 9 && unread.length() == 8
}

// AN UN-RUN CONFIGURATION DOES NOT INHERIT ANOTHER PASS'S OBSERVATION. h11's two-engine candidate shares the
// host and the engine rows of the four-engine pass, and its own provenance says it was never served; so it
// carries the unread verdict on both sides, each obligation naming the four-engine pass as where the only read
// on that host lives. Its capacity in sessions is still stated -- four warm sessions, half of the four-engine
// configuration's eight -- which is exactly why the refusal matters: the capacity is decidable while the
// population is not, and the join refuses rather than filling the gap with the other configuration's count.
test fn an_unrun_configuration_refuses_the_other_passes_observation() -> Bool {
  match h11_two_engines_configuration.concurrent_agents {
    PopulationUnread { obligation: obligation } =>
      string_contains(s: obligation as String, pattern: "four-engine" as String)
    PopulationObserved { admitted_sessions: _, standing: _ } => false
  }
    && match h11_two_engines_configuration.prefix_cache_ratio {
      RatioUnread { obligation: obligation } =>
        string_contains(s: obligation as String, pattern: "four-engine" as String)
      RatioEmptyOnPass { pass: _, obligation: _ } => false
      RatioObserved { counts: _, standing: _ } => false
    }
    && match configuration_prefix_cache_capacity(c: h11_two_engines_configuration) {
      // One obligation, and it is the population's: the capacity side resolves (four warm sessions), so the
      // only thing missing is the count this configuration never produced.
      CapacityUndetermined { obligations: obligations } =>
        obligations.length() == 1
          && filter(obligations, o => string_contains(s: o as String, pattern: "four-engine" as String)).length() == 1
      CapacityHoldsPopulation { sessions_admitted: _, warm_sessions: _, population_standing: _, capacity_basis: _ } => false
      CapacityExceededByPopulation { sessions_admitted: _, warm_sessions: _, population_standing: _, capacity_basis: _ } => false
    }
    && match configuration_warm_session_capacity(c: h11_two_engines_configuration) {
      Present { value: two } => two.value == 4
      Absent => false
    }
    // And the pass itself is not lost: the configuration that ran still carries it, once.
    && match h11_four_engines_configuration.concurrent_agents {
      PopulationObserved { admitted_sessions: sessions, standing: _ } => sessions == 4
      PopulationUnread { obligation: _ } => false
    }
}

// THE HIT RATIO IS A TYPED OBSERVATION ON THE ROW. h11 carries the pass it ran -- three hits against fifty
// misses, standing named as the relay it is -- and every other candidate carries the obligation to take
// one. A pass that counted nothing has no ratio: the permille is Absent, never zero, because zero hits is
// a measurement and no measurement is not.
test fn the_pass_ratio_is_carried_or_refused_never_absent_as_fine() -> Bool {
  match h11_four_engines_configuration.prefix_cache_ratio {
    RatioObserved { counts: counts, standing: _ } =>
      counts.hits == 3 && counts.misses == 50
        && positive_measure_count_nat(count: counts.total) == counts.hits + counts.misses
    // An empty-on-a-pass receipt or no producer at all would contradict what this row carries, and either
    // way the claim does not hold: the arm is named rather than left to a wildcard, because the elaborator
    // refuses a match that hides a variant (the route's own error at this line was exactly that).
    RatioEmptyOnPass { pass: _, obligation: _ } => false
    RatioUnread { obligation: _ } => false
  }
    && match prefix_cache_ratio_permille(ratio: h11_four_engines_configuration.prefix_cache_ratio) {
      Present { value: permille_value } => permille_count(p: permille_value) == 56
      Absent => false
    }
    && match srv3_batch8_ram_only_configuration.prefix_cache_ratio {
      RatioUnread { obligation: obligation } => string_contains(s: obligation as String, pattern: "hit" as String)
      RatioEmptyOnPass { pass: _, obligation: _ } => false
      RatioObserved { counts: _, standing: _ } => false
    }
    // THE EMPTY COLUMN IS REFUSED A DENOMINATOR, so it is refused a ratio: the constructor names the 0 it
    // saw rather than handing back a value the read path would then have to paper over. This is the wall
    // review 99335 asked for, executed here instead of asserted in a comment.
    && match prefix_cache_ratio_denominator(hits: 0, misses: 0) {
      PositiveMeasureCountRefused { cause: PositiveMeasureCountNonPositive { observed: observed } } => observed == 0
      PositiveMeasureCountBuilt { count: _ } => false
    }
    && match prefix_cache_ratio_denominator(hits: 3, misses: 50) {
      PositiveMeasureCountBuilt { count: count } => positive_measure_count_nat(count: count) == 53
      PositiveMeasureCountRefused { cause: _ } => false
    }
    // And an empty column on a pass that DID run is still refused a number: RatioEmptyOnPass is a verdict,
    // not a zero.
    && match prefix_cache_ratio_permille(ratio: RatioEmptyOnPass {
      pass: "witness-supplied: a completed pass whose hit column came back empty" as NonEmptyStr,
      obligation: "read the engine's prefix counters over a named interval" as NonEmptyStr,
    }) {
      Absent => true
      Present { value: _ } => false
    }
}

// THE OTHER HOSTS STATE THEIR CAPACITY IN AGENTS TOO, whether or not anyone has counted their population:
// srv3's 64 GiB RAM tier over its own 1240 MiB plus 10 KiB-per-token snapshot is 18 warm sessions against
// its 24 declared slots, and srv4's two candidates differ by their ladder -- 43 with the parked disk tier,
// 5 with the RAM tier alone. The ladder, not the prose, is what moves the number.
test fn the_capacity_of_the_other_hosts_is_stated_in_sessions_too() -> Bool {
  match configuration_warm_session_capacity(c: srv3_batch8_ram_only_configuration) {
    Present { value: n } => n.value == 18
    Absent => false
  }
    && match configuration_warm_session_capacity(c: srv4_batch8_ram_only_configuration) {
      Present { value: n } => n.value == 5
      Absent => false
    }
    && match configuration_warm_session_capacity(c: srv4_batch1_slotfile_configuration) {
      Present { value: n } => n.value == 43
      Absent => false
    }
}

// EMPTY IS NOT ABSENT, AND NEITHER IS FINE. The row's RED case is a pass that produced a receipt with an
// empty hit column; the other way a ratio is missing is that no pass ever carried the counters, which is a
// missing producer rather than an instrument that shrugged. Collapsing the two is the failure mode this row
// is about, so the two arms are different values, both refuse the ratio, and the unread arm's obligation
// names the producer that would settle it.
test fn an_empty_pass_column_is_not_the_same_verdict_as_no_producer() -> Bool {
  let empty_column = RatioEmptyOnPass {
    pass: "witness-supplied: a completed pass whose hit column came back empty" as NonEmptyStr,
    obligation: "read the engine's prefix counters over a named interval" as NonEmptyStr,
  }
  let no_producer = RatioUnread { obligation: "witness-supplied: no pass carried the counters" as NonEmptyStr }
  match prefix_cache_ratio_permille(ratio: empty_column) {
    Absent => true
    Present { value: _ } => false
  }
    && match prefix_cache_ratio_permille(ratio: no_producer) {
      Absent => true
      Present { value: _ } => false
    }
    && match empty_column {
      RatioEmptyOnPass { pass: pass_text, obligation: _ } => string_contains(s: pass_text as String, pattern: "empty" as String)
      RatioUnread { obligation: _ } => false
      RatioObserved { counts: _, standing: _ } => false
    }
    && match no_producer {
      RatioUnread { obligation: _ } => true
      RatioEmptyOnPass { pass: _, obligation: _ } => false
      RatioObserved { counts: _, standing: _ } => false
    }
    && match srv3_batch8_ram_only_configuration.concurrent_agents {
      PopulationUnread { obligation: obligation } => string_contains(s: obligation as String, pattern: "fleet_host_truth_read" as String)
      PopulationObserved { admitted_sessions: _, standing: _ } => false
    }
}

// THE TYPE ITSELF REFUSES THE EMPTY COLUMN, AND THE DOOR OWNS THE TOTAL. The three figures sit in a
// sole_constructor record whose total is a #std.measure::PositiveMeasureCount, whose only constructor is a
// successor, so there is no spelling of a zero total to write: the empty pass belongs to RatioEmptyOnPass and
// nowhere else. And the total is not a field a row types in beside its counts -- prefix_cache_ratio_counts
// builds it from hits + misses, and a record literal for that type outside its module is refused by the
// checker (test.claim.sole_constructor_completeness_audit_probe f1 to f4 execute that refusal; review 99382
// is what closed the second door). WHAT THIS CLAIM PROVES HAS CHANGED and is stated, not glossed: the
// identity below no longer guards a hand-typed total, because that spelling no longer exists; it pins the
// DOOR's arithmetic, checked over EVERY row that carries a ratio rather than over the one real row, and it
// flips if prefix_cache_ratio_denominator stops summing the two counters.
test fn an_empty_column_cannot_be_written_as_an_observed_ratio() -> Bool {
  let carrying_a_ratio = filter(replica_configuration_field, c => match c.prefix_cache_ratio {
    RatioObserved { counts: _, standing: _ } => true
    RatioEmptyOnPass { pass: _, obligation: _ } => false
    RatioUnread { obligation: _ } => false
  })
  let total_matches_its_counts = filter(replica_configuration_field, c => match c.prefix_cache_ratio {
    RatioObserved { counts: counts, standing: _ } =>
      positive_measure_count_nat(count: counts.total) == counts.hits + counts.misses
    RatioEmptyOnPass { pass: _, obligation: _ } => true
    RatioUnread { obligation: _ } => true
  })
  carrying_a_ratio.length() == 1 && total_matches_its_counts.length() == replica_configuration_field.length()
    && match h11_pass_prefix_cache_ratio {
      RatioObserved { counts: counts, standing: _ } =>
        positive_measure_count_nat(count: counts.total) == counts.hits + counts.misses
          && positive_measure_count_nat(count: counts.total) == 53
      RatioEmptyOnPass { pass: _, obligation: _ } => false
      RatioUnread { obligation: _ } => false
    }
    && match prefix_cache_ratio_denominator(hits: 0, misses: 0) {
      PositiveMeasureCountRefused { cause: PositiveMeasureCountNonPositive { observed: observed } } => observed == 0
      PositiveMeasureCountBuilt { count: _ } => false
    }
    // THE CONSTRUCTOR, NOT A VALIDATOR STANDING AFTER CONSTRUCTION: a pair of zeroes does not yield an
    // observation with a hidden zero inside it. It yields the empty-pass verdict, which is the row's RED
    // case named in the type.
    && match prefix_cache_pass_ratio(
      hits: 0,
      misses: 0,
      pass_label: "witness-supplied: a completed pass whose hit column came back empty" as NonEmptyStr,
      empty_column_obligation: "read the engine's prefix counters over a named interval" as NonEmptyStr,
      standing: TranscribedUncited { read_obligation: "witness-supplied: no counters at all" as NonEmptyStr },
    ) {
      RatioEmptyOnPass { pass: pass_text, obligation: _ } => string_contains(s: pass_text as String, pattern: "empty" as String)
      RatioObserved { counts: _, standing: _ } => false
      RatioUnread { obligation: _ } => false
    }
}
