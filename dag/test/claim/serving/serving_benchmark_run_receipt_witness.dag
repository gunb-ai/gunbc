data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE ADMISSION BOUNDARY, DRIVEN WITH SUPPLIED VALUES (DESIGN section 3, a witness discriminates at
// one interface). The version is a two-session cut of serving-benchmark/1's contract (same retained
// context, tool delta and output length, levels 1 and 2, one round each) so a run is five request/v4
// lines; admission is parametric in the version, and the pinned serving_benchmark_v1 is exercised by
// test.claim.serving.serving_benchmark_v4_inhabitance against the kit's real committed run.

data fx_version: ServingBenchmarkVersion = ServingBenchmarkVersion {
  name: "serving-benchmark/fixture" as NonEmptyStr,
  workload: ServingBenchmarkWorkload {
    retained_context: token_count(count: 199466),
    retained_context_band: basis_point(count: 100),
    tool_delta: token_count(count: 2000),
    tool_delta_template_allowance: token_count(count: 64),
    max_output: token_count(count: 1024),
    retained_sessions: 2,
    active_levels: [1, 2],
    warmup_rounds_per_level: 0,
    rounds_per_level: 1,
    submission_spread_bound: millisecond(count: 1000),
  },
  quantities: [AggregateEndToEnd, DecodeRate, CompletedTurnsPerHour],
  telemetry: [GpuPower, GpuClocks, GpuTemperature, GpuClocksEventReasons, GpuPcieLinkAndThroughput, EngineCpuBusyThreads, EngineCgroupMemoryCurrent, WallPower],
  gpu_sample_interval: millisecond(count: 500),
  pcie_sample_interval: second(count: 1),
}

// The run, in seconds on the client's wall clock. Primes 199,466 and 199,500 tokens; each follow-up's
// prompt is the previous prompt + previous reply + 2,000 tool tokens + 20 template tokens.
//   level 1, round 1: session 0, 230.00 -> first 231.00 -> end 251.46: window 21.46 s, 1,024 tokens
//   level 2, round 2: sessions 0 and 1 submitted at 260.0 and 260.1, last completion 301.0: window 41 s
data fx_prime: String = "{\"schema\":\"gpu-bench/request/v4\",\"run\":\"fx\",\"phase\":\"prime\",\"round\":0,\"n_active\":2,\"retained\":2,\"session\":0,\"max_tokens\":1,\"delta_tokens\":0,\"delta_words\":0,\"tokens_per_word_milli\":null,\"delta_sha256\":null,\"messages_sha256\":\"1111111111111111111111111111111111111111111111111111111111111111\",\"t_start\":100.0,\"t_first\":160.0,\"t_end\":160.1,\"prompt_tokens\":199466,\"completion_tokens\":1,\"cached_tokens\":null,\"status\":\"ok\",\"error\":null,\"engine_cpu_usage_usec_start\":100000000,\"engine_cpu_usage_usec_end\":160000000,\"engine_memory_current_start\":60000000000,\"engine_memory_current_end\":60000000000,\"engine_memory_peak\":null}\n{\"schema\":\"gpu-bench/request/v4\",\"run\":\"fx\",\"phase\":\"prime\",\"round\":0,\"n_active\":2,\"retained\":2,\"session\":1,\"max_tokens\":1,\"delta_tokens\":0,\"delta_words\":0,\"tokens_per_word_milli\":null,\"delta_sha256\":null,\"messages_sha256\":\"2222222222222222222222222222222222222222222222222222222222222222\",\"t_start\":160.2,\"t_first\":220.0,\"t_end\":220.1,\"prompt_tokens\":199500,\"completion_tokens\":1,\"cached_tokens\":null,\"status\":\"ok\",\"error\":null,\"engine_cpu_usage_usec_start\":160000000,\"engine_cpu_usage_usec_end\":220000000,\"engine_memory_current_start\":60000000000,\"engine_memory_current_end\":60000000000,\"engine_memory_peak\":null}\n"

