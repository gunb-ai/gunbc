module test.claim.serving.turn_demand_witness

import std.types { Bool, String, NonEmptyStr }
import v2.std.optional { Present, Absent }
import product.fabric.work {
  SourceManifestRef, ArtifactManifestRef, EffectContractRef, OutputContractRef, ExecutionRequirements,
  ControlPlaneCapacity, Shape, HardRequirements, CapabilityManifestRef, TrustDomainRef, OpaqueEffects,
  OutputArtifactObligation, TerminalResultObligation,
}
import product.fabric.envelope { unstated_envelope }
import product.fabric.isolation { IsolationProfile }
import product.fabric.demand { ObservationReceiptRef }
import std.measure { hardware_thread_count }
import std.content_hash { content_hash_of_value }
import gunbc.serving.incarnation_provenance {
  ServingTurnExecutionClosure, ServingCoordinateReading, CoordinateObserved, CoordinateAbsentByObservation,
  ServingSourceEvidenceRung, RevisionAddressedUpstreamVerification,
  SourceManifestResolved, SourceManifestUnestablished, RuntimeManifestResolved, RuntimeManifestUnestablished,
  ExecutionClosureResolved, ExecutionClosureUnestablished,
  resolve_serving_source, resolve_serving_runtime, seal_serving_execution_closure,
}
import gunbc.serving.turn_demand {
  ServingTurnRequest, ServingTurnExecution, TurnExecutionBound, serving_turn_source_unestablished,
  serving_turn_steps, serving_turn_output_obligations, TurnWorkBound, TurnWorkUnestablished,
  serving_turn_work, serving_turn_requirements, serving_turn_satisfaction,
}

fn probe_requirements() -> ExecutionRequirements {
  serving_turn_requirements(
    capacity_class: ControlPlaneCapacity,
    capabilities: "gunbc.capabilities.spark-serving.probe" as CapabilityManifestRef,
    trust_domain: "gunbc.trust.spark-fleet" as TrustDomainRef,
    isolation: IsolationProfile { guarantees: [] },
    shape: Shape { hard: HardRequirements { threads: hardware_thread_count(count: 0) }, envelope: unstated_envelope() },
  )
}

fn request_with(execution: ServingTurnExecution) -> ServingTurnRequest {
  ServingTurnRequest {
    execution: execution,
    inputs: "probe.inputs" as ArtifactManifestRef,
    effect_contract: "probe.effects" as EffectContractRef,
    output_contract: "probe.outputs" as OutputContractRef,
  }
}


// A CLOSURE BUILT THROUGH THE REAL SEAL, NOT ASSEMBLED HERE. ServingTurnExecutionClosure is
// sole_constructor in its own module, so a fixture cannot fabricate one: these go through the same
// resolution the Spark observer uses, which is what makes the positive control below a control over
// the production path rather than over a shape invented in this file.
fn t_closure(checkpoint: String) -> ServingTurnExecution {
  let source = resolve_serving_source(
    checkpoint: CoordinateObserved { hash: content_hash_of_value(value: checkpoint as NonEmptyStr) },
    model_config: CoordinateObserved { hash: content_hash_of_value(value: "model-config" as NonEmptyStr) },
    tokenizer: CoordinateObserved { hash: content_hash_of_value(value: "tokenizer" as NonEmptyStr) },
    tokenizer_config: CoordinateObserved { hash: content_hash_of_value(value: "tokenizer-config" as NonEmptyStr) },
    special_tokens: CoordinateAbsentByObservation,
    chat_template: CoordinateObserved { hash: content_hash_of_value(value: "chat-template" as NonEmptyStr) },
    model_side_code: CoordinateAbsentByObservation,
    generation_defaults: CoordinateObserved { hash: content_hash_of_value(value: "generation-defaults" as NonEmptyStr) },
    processor_config: CoordinateObserved { hash: content_hash_of_value(value: "processor-config" as NonEmptyStr) },
    rung: RevisionAddressedUpstreamVerification {
      authority: "probe/repo" as NonEmptyStr, revision: "0000000000000000000000000000000000000000" as NonEmptyStr,
    },
  )
  let runtime = resolve_serving_runtime(
    runtime_image: CoordinateObserved { hash: content_hash_of_value(value: "runtime-image" as NonEmptyStr) },
    runtime_extensions: CoordinateAbsentByObservation,
    runtime_configuration: CoordinateAbsentByObservation,
  )
  match seal_serving_execution_closure(source: source, runtime: runtime, receipt: "test.claim.serving.turn_demand_witness" as ObservationReceiptRef) {
    ExecutionClosureUnestablished { obligations: _ } => serving_turn_source_unestablished()
    ExecutionClosureResolved { closure: c } =>
      TurnExecutionBound { closure: c }
  }
}

// ── AN ALIAS IS NOT A SOURCE MANIFEST, AND THE REFUSAL IS THE WHOLE POINT ─────────────────────
//
// What shipped before cast the served model alias straight into SourceManifestRef, which gave one
// Work identity to engines that may be serving different weights, tokenizers or quantizations. There
// is no arm here that turns an unestablished source into a Work: the turn has no exact identity
// until something observes what the launch loaded, and the obligation says which consumer is waiting
// and what would discharge it.
test fn an_unestablished_source_refuses_to_mint_work() -> Bool {
  let w = serving_turn_work(principal: "gunbc" as NonEmptyStr, request: request_with(execution: serving_turn_source_unestablished()), requirements: probe_requirements())
  match w {
    TurnWorkUnestablished { obligation: o } =>
      string_contains(s: o as String, pattern: "no observation establishes the exact model package")
        && string_contains(s: o as String, pattern: "vllm_incarnation_provenance")
    TurnWorkBound { work: _ } => false
  }
}

// AND THE POSITIVE CONTROL, so the refusal above is a wall and not a function that cannot succeed. A
// request carrying an observed manifest mints Work, and its key comes from the fabric's own
// constructor rather than from a second derivation here.
test fn an_observed_manifest_mints_work_through_the_fabric_constructor() -> Bool {
  match serving_turn_work(principal: "gunbc" as NonEmptyStr, request: request_with(execution: t_closure(checkpoint: "probe.model-manifest")), requirements: probe_requirements()) {
    TurnWorkBound { work: work } => length(work.contract.steps) == 1 && length(work.id.key as String) > 0
    TurnWorkUnestablished { obligation: _ } => false
  }
}

// TWO SOURCES ARE TWO WORKS. This is what the alias cast destroyed: the identity is derived from the
// contract, so a different manifest is a different key without anyone deciding it should be.
test fn two_source_manifests_are_two_works() -> Bool {
  match serving_turn_work(principal: "gunbc" as NonEmptyStr, request: request_with(execution: t_closure(checkpoint: "probe.model-a")), requirements: probe_requirements()) {
    TurnWorkUnestablished { obligation: _ } => false
    TurnWorkBound { work: a } =>
      match serving_turn_work(principal: "gunbc" as NonEmptyStr, request: request_with(execution: t_closure(checkpoint: "probe.model-b")), requirements: probe_requirements()) {
        TurnWorkUnestablished { obligation: _ } => false
        TurnWorkBound { work: b } => (a.id.key as String) != (b.id.key as String)
      }
  }
}

// ── A STREAMED TURN IS NOT RESUMABLE AND ITS STEP IS NOT REUSABLE ─────────────────────────────
//
// The one declared step is the entire streamed turn with opaque effects. An earlier spelling set
// step_reuse_permitted from a "warm prefix is fine" flag, which is a different permission at a
// different grain: the warm prefix is an internal subcomputation of this step, and permitting reuse
// of the STEP would permit answering from a previous turn's recorded execution.
test fn a_turn_step_is_opaque_and_never_reused() -> Bool {
  let steps = serving_turn_steps()
  let s = serving_turn_satisfaction()
  (match first(steps) {
     Present { value: st } => match st.resumability { OpaqueEffects { reason: r } => string_contains(s: r as String, pattern: "partial stream")  _ => false }
     Absent => false
   })
    && !s.step_reuse_permitted
    && !s.terminal_receipt_may_satisfy
    && s.new_attempt_required
}

// WHAT THE TURN OWES IS A TERMINAL RESULT, AND THE KIND IS PART OF THE IDENTITY. An artifact
// obligation with the same id is a different owed subject, which is why the roster is typed rather
// than a list of names.
test fn a_turn_owes_one_terminal_result() -> Bool {
  let owed = serving_turn_output_obligations()
  length(owed.required) == 1
    && fold(owed.required, init: true, f: (acc, o) => acc && (match o.kind { TerminalResultObligation {} => true  OutputArtifactObligation {} => false }))
}
