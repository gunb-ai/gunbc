module test.claim.serving.turn_demand_witness

import std.types { Bool, String, NonEmptyStr, List }
import v2.std.optional { Present, Absent }
import product.fabric.work {
  ArtifactManifestRef, EffectContractRef, OutputContractRef, ExecutionRequirements,
  ControlPlaneCapacity, Shape, HardRequirements, CapabilityManifestRef, TrustDomainRef, OpaqueEffects,
  OutputArtifactObligation, TerminalResultObligation,
}
import product.fabric.envelope { unstated_envelope }
import product.fabric.isolation { IsolationProfile }
import product.fabric.demand { ObservationReceiptRef }
import std.measure { hardware_thread_count }
import gunbc.serving.turn_demand {
  ServingTurnRequest, ServingTurnSource, TurnComponentStanding, TurnComponentObserved, TurnComponentUnobserved,
  ServingTurnComponent, TurnWeights, TurnTokenizer, TurnRuntime,
  serving_turn_weights_obligation, serving_turn_tokenizer_obligation,
  serving_turn_steps, serving_turn_output_obligations, TurnWorkBound, TurnWorkUnestablished,
  serving_turn_work, serving_turn_requirements, serving_turn_satisfaction,
}
import std.content_hash { ContentHash, Sha256Hash, Sha256Digest, Sha256DigestHex, compare_content_hash, ContentHashEqual }
import gunbc.spark.serving_offer { spark_serving_turn_runtime, spark_serving_incarnation_unobserved_obligation }
import gunbc.spark.vllm_serving_launch {
  vllm_serving_launch, endpoint_incarnation_observation, EndpointIncarnationObserved, EndpointIncarnationUnobserved,
}
import gunbc.spark.vllm_endpoint_process_launch { vllm_endpoint_process_launch }
import gunbc.spark.fabric_switch_observed { FabricGroupA }
import gunbc.fleet_intent_network { operator_host_srv5 }

fn probe_requirements() -> ExecutionRequirements {
  serving_turn_requirements(
    capacity_class: ControlPlaneCapacity,
    capabilities: "gunbc.capabilities.spark-serving.probe" as CapabilityManifestRef,
    trust_domain: "gunbc.trust.spark-fleet" as TrustDomainRef,
    isolation: IsolationProfile { guarantees: [] },
    shape: Shape { hard: HardRequirements { threads: hardware_thread_count(count: 0) }, envelope: unstated_envelope() },
  )
}

fn request_with(source: ServingTurnSource) -> ServingTurnRequest {
  ServingTurnRequest {
    source: source,
    runtime_closure: "probe.runtime" as ArtifactManifestRef,
    inputs: "probe.inputs" as ArtifactManifestRef,
    effect_contract: "probe.effects" as EffectContractRef,
    output_contract: "probe.outputs" as OutputContractRef,
  }
}

// ── A SOURCE IS THREE COMPONENTS, EACH REFUSABLE ON ITS OWN ───────────────────────────────────
//
// What shipped before cast the served model alias straight into SourceManifestRef, and after that the
// source was one unestablished-or-not value. Now weights, tokenizer and runtime are separate standings,
// and the refusal names every one that is missing. The observed digests below are FIXTURE EVIDENCE:
// nothing in this repository observes loaded weight or tokenizer bytes.

fn t_sha256(hex: String) -> ContentHash {
  Sha256Hash(Sha256Digest { hex: hex as Sha256DigestHex })
}

fn t_observed(hex: String) -> TurnComponentStanding {
  TurnComponentObserved { digest: t_sha256(hex: hex), receipt: "test.claim.serving.turn_demand_witness fixture" as ObservationReceiptRef }
}

fn t_source(weights: TurnComponentStanding, tokenizer: TurnComponentStanding, runtime: TurnComponentStanding) -> ServingTurnSource {
  ServingTurnSource { weights: weights, tokenizer: tokenizer, runtime: runtime }
}

data t_w1: String = "1111111111111111111111111111111111111111111111111111111111111111"
data t_w2: String = "2222222222222222222222222222222222222222222222222222222222222222"
data t_tok: String = "3333333333333333333333333333333333333333333333333333333333333333"
data t_rt: String = "4444444444444444444444444444444444444444444444444444444444444444"

fn t_all_observed(weights_hex: String) -> ServingTurnSource {
  t_source(weights: t_observed(hex: weights_hex), tokenizer: t_observed(hex: t_tok), runtime: t_observed(hex: t_rt))
}

fn t_component_is(c: ServingTurnComponent, want: ServingTurnComponent) -> Bool {
  match c {
    TurnWeights => match want { TurnWeights => true  _ => false }
    TurnTokenizer => match want { TurnTokenizer => true  _ => false }
    TurnRuntime => match want { TurnRuntime => true  _ => false }
  }
}

fn t_missing_exactly(source: ServingTurnSource, want: List<ServingTurnComponent>) -> Bool {
  match serving_turn_work(principal: "gunbc" as NonEmptyStr, request: request_with(source: source), requirements: probe_requirements()) {
    TurnWorkBound { work: _ } => false
    TurnWorkUnestablished { missing: m, obligation: _ } =>
      length(m) == length(want)
        && fold(want, init: true, f: (acc, w) => acc && any(m, x => t_component_is(c: x, want: w)))
  }
}

// POSITIVE CONTROL. Every component observed mints Work through the fabric's own constructor.
test fn three_observed_components_mint_work_through_the_fabric_constructor() -> Bool {
  match serving_turn_work(principal: "gunbc" as NonEmptyStr, request: request_with(source: t_all_observed(weights_hex: t_w1)), requirements: probe_requirements()) {
    TurnWorkBound { work: work } => length(work.contract.steps) == 1 && length(work.id.key as String) > 0
    TurnWorkUnestablished { missing: _, obligation: _ } => false
  }
}

// RED, ONE PER COMPONENT. Each drops exactly one observation and must name exactly that component.
test fn unobserved_weights_refuse_and_name_only_weights() -> Bool {
  t_missing_exactly(
    source: t_source(weights: TurnComponentUnobserved { obligation: serving_turn_weights_obligation }, tokenizer: t_observed(hex: t_tok), runtime: t_observed(hex: t_rt)),
    want: [TurnWeights],
  )
}

test fn unobserved_tokenizer_refuses_and_names_only_tokenizer() -> Bool {
  t_missing_exactly(
    source: t_source(weights: t_observed(hex: t_w1), tokenizer: TurnComponentUnobserved { obligation: serving_turn_tokenizer_obligation }, runtime: t_observed(hex: t_rt)),
    want: [TurnTokenizer],
  )
}

test fn unobserved_runtime_refuses_and_names_only_runtime() -> Bool {
  t_missing_exactly(
    source: t_source(weights: t_observed(hex: t_w1), tokenizer: t_observed(hex: t_tok), runtime: TurnComponentUnobserved { obligation: spark_serving_incarnation_unobserved_obligation }),
    want: [TurnRuntime],
  )
}

// RED -- THE PRODUCTION STANDING OF TODAY: weights and tokenizer have no observer, and the runtime is
// read through spark_serving_turn_runtime from the incarnation standing production carries, which is
// unobserved. All three are named.
test fn todays_standing_refuses_naming_all_three_components() -> Bool {
  t_missing_exactly(
    source: t_source(
      weights: TurnComponentUnobserved { obligation: serving_turn_weights_obligation },
      tokenizer: TurnComponentUnobserved { obligation: serving_turn_tokenizer_obligation },
      runtime: spark_serving_turn_runtime(incarnation: EndpointIncarnationUnobserved { obligation: spark_serving_incarnation_unobserved_obligation }),
    ),
    want: [TurnWeights, TurnTokenizer, TurnRuntime],
  )
}

// THE RUNTIME READS THE IMAGE DIGEST OF THE OBSERVED INCARNATION, and nothing else. Fixture evidence:
// no production producer constructs the observation.
test fn the_runtime_component_is_the_observed_incarnations_image_digest() -> Bool {
  let launch = vllm_serving_launch(
    group: FabricGroupA, head: operator_host_srv5,
    systemd_invocation: "fixture-invocation-1" as NonEmptyStr, container_id: "fixture-container-1" as NonEmptyStr,
    executable_digest: t_sha256(hex: t_rt), unit_digest: t_sha256(hex: t_tok), started_at: 1788907506,
  )
  let endpoint = vllm_endpoint_process_launch(group: FabricGroupA, endpoint: "http://10.0.0.1:8000" as NonEmptyStr, process_start_field: "1" as NonEmptyStr)
  match spark_serving_turn_runtime(incarnation: EndpointIncarnationObserved { observation: endpoint_incarnation_observation(endpoint: endpoint, launch: launch, receipt: "fixture" as ObservationReceiptRef) }) {
    TurnComponentObserved { digest: d, receipt: _ } => match compare_content_hash(left: d, right: t_sha256(hex: t_rt)) { ContentHashEqual => true  _ => false }
    TurnComponentUnobserved { obligation: _ } => false
  }
}

// TWO WEIGHT DIGESTS ARE TWO WORKS. A manifest bound to content makes different loaded bytes a
// different key without anyone deciding it should be.
test fn different_weight_bytes_are_different_works() -> Bool {
  match serving_turn_work(principal: "gunbc" as NonEmptyStr, request: request_with(source: t_all_observed(weights_hex: t_w1)), requirements: probe_requirements()) {
    TurnWorkUnestablished { missing: _, obligation: _ } => false
    TurnWorkBound { work: a } =>
      match serving_turn_work(principal: "gunbc" as NonEmptyStr, request: request_with(source: t_all_observed(weights_hex: t_w2)), requirements: probe_requirements()) {
        TurnWorkUnestablished { missing: _, obligation: _ } => false
        TurnWorkBound { work: b } => (a.id.key as String) != (b.id.key as String)
      }
  }
}

// ── A STREAMED TURN IS NOT RESUMABLE AND ITS STEP IS NOT REUSABLE ─────────────────────────────
//
// The one declared step is the entire streamed turn with opaque effects. An earlier spelling set
// step_reuse_permitted from a "warm prefix is fine" flag, which is a different permission at a
// different grain: the warm prefix is an internal subcomputation of this step, and permitting reuse
// of the STEP would permit answering from a previous turn's recorded execution.
test fn a_turn_step_is_opaque_and_never_reused() -> Bool {
  let steps = serving_turn_steps()
  let s = serving_turn_satisfaction()
  (match first(steps) {
     Present { value: st } => match st.resumability { OpaqueEffects { reason: r } => string_contains(s: r as String, pattern: "partial stream")  _ => false }
     Absent => false
   })
    && !s.step_reuse_permitted
    && !s.terminal_receipt_may_satisfy
    && s.new_attempt_required
}

// WHAT THE TURN OWES IS A TERMINAL RESULT, AND THE KIND IS PART OF THE IDENTITY. An artifact
// obligation with the same id is a different owed subject, which is why the roster is typed rather
// than a list of names.
test fn a_turn_owes_one_terminal_result() -> Bool {
  let owed = serving_turn_output_obligations()
  length(owed.required) == 1
    && fold(owed.required, init: true, f: (acc, o) => acc && (match o.kind { TerminalResultObligation {} => true  OutputArtifactObligation {} => false }))
}
