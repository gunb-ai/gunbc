module test.claim.serving.turn_demand_witness

import std.types { Bool, String, NonEmptyStr }
import v2.std.optional { Present, Absent }
import product.fabric.work {
  SourceManifestRef, ArtifactManifestRef, EffectContractRef, OutputContractRef, ExecutionRequirements,
  ControlPlaneCapacity, Shape, HardRequirements, CapabilityManifestRef, TrustDomainRef, OpaqueEffects,
  OutputArtifactObligation, TerminalResultObligation,
}
import product.fabric.envelope { unstated_envelope }
import product.fabric.isolation { IsolationProfile }
import product.fabric.demand { ObservationReceiptRef }
import std.measure { hardware_thread_count }
import gunbc.serving.turn_demand {
  ServingTurnRequest, ServingTurnExecution, serving_turn_source_unestablished,
  serving_turn_steps, serving_turn_output_obligations, TurnWorkBound, TurnWorkUnestablished,
  serving_turn_work, serving_turn_requirements, serving_turn_satisfaction,
}

fn probe_requirements() -> ExecutionRequirements {
  serving_turn_requirements(
    capacity_class: ControlPlaneCapacity,
    capabilities: "gunbc.capabilities.spark-serving.probe" as CapabilityManifestRef,
    trust_domain: "gunbc.trust.spark-fleet" as TrustDomainRef,
    isolation: IsolationProfile { guarantees: [] },
    shape: Shape { hard: HardRequirements { threads: hardware_thread_count(count: 0) }, envelope: unstated_envelope() },
  )
}

fn request_with(execution: ServingTurnExecution) -> ServingTurnRequest {
  ServingTurnRequest {
    execution: execution,
    inputs: "probe.inputs" as ArtifactManifestRef,
    effect_contract: "probe.effects" as EffectContractRef,
    output_contract: "probe.outputs" as OutputContractRef,
  }
}


// ── AN ALIAS IS NOT A SOURCE MANIFEST, AND THE REFUSAL IS THE WHOLE POINT ─────────────────────
//
// What shipped before cast the served model alias straight into SourceManifestRef, which gave one
// Work identity to engines that may be serving different weights, tokenizers or quantizations. There
// is no arm here that turns an unestablished source into a Work: the turn has no exact identity
// until something observes what the launch loaded, and the obligation says which consumer is waiting
// and what would discharge it.
test fn an_unestablished_source_refuses_to_mint_work() -> Bool {
  let w = serving_turn_work(principal: "gunbc" as NonEmptyStr, request: request_with(execution: serving_turn_source_unestablished()), requirements: probe_requirements())
  match w {
    TurnWorkUnestablished { obligation: o } =>
      string_contains(s: o as String, pattern: "no observation establishes the exact model package")
        && string_contains(s: o as String, pattern: "vllm_incarnation_provenance")
    TurnWorkBound { work: _ } => false
  }
}

// ── THE POSITIVE CONTROLS MOVED, BECAUSE A CLOSURE CANNOT BE FORGED HERE ANY MORE ─────────────
//
// gunbc.serving.incarnation_provenance seal_serving_execution_closure admits only the incarnation
// producer, and that producer is reachable only through gunbc.spark.vllm_incarnation_provenance
// observe_native_incarnation, so this module cannot mint a ServingTurnExecutionClosure -- which is the
// point of that wall and not an obstacle to work around. The rows that need one (an observed closure
// mints Work, and different member bytes are two Works) live in
// test.claim.spark.vllm_incarnation_transaction_witness_test, where a closure is obtained by running the
// observation transaction over an authored world.
//
// WHAT STAYS HERE IS EVERYTHING THAT NEEDS NO CLOSURE: the unestablished arm, the step shape and the
// output obligations. A refusal is still testable without the ability to forge the thing refused.

// ── A STREAMED TURN IS NOT RESUMABLE AND ITS STEP IS NOT REUSABLE ─────────────────────────────
//
// The one declared step is the entire streamed turn with opaque effects. An earlier spelling set
// step_reuse_permitted from a "warm prefix is fine" flag, which is a different permission at a
// different grain: the warm prefix is an internal subcomputation of this step, and permitting reuse
// of the STEP would permit answering from a previous turn's recorded execution.
test fn a_turn_step_is_opaque_and_never_reused() -> Bool {
  let steps = serving_turn_steps()
  let s = serving_turn_satisfaction()
  (match first(steps) {
     Present { value: st } => match st.resumability { OpaqueEffects { reason: r } => string_contains(s: r as String, pattern: "partial stream")  _ => false }
     Absent => false
   })
    && !s.step_reuse_permitted
    && !s.terminal_receipt_may_satisfy
    && s.new_attempt_required
}

// WHAT THE TURN OWES IS A TERMINAL RESULT, AND THE KIND IS PART OF THE IDENTITY. An artifact
// obligation with the same id is a different owed subject, which is why the roster is typed rather
// than a list of names.
test fn a_turn_owes_one_terminal_result() -> Bool {
  let owed = serving_turn_output_obligations()
  length(owed.required) == 1
    && fold(owed.required, init: true, f: (acc, o) => acc && (match o.kind { TerminalResultObligation {} => true  OutputArtifactObligation {} => false }))
}
