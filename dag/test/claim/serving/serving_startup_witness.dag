module test.claim.serving.serving_startup_witness

import std.types { String, Bool, NonEmptyStr, List, list_length }
import std.measure { byte_size }
import std.content_hash { Sha256Digest }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import extdeps.exec.command { ArgvCommand }
import extdeps.tools.gnu_coreutils { rm_force_command }
import extdeps.ninfer.ninfer_serve { NinferModelsAdvertised, ninfer_serve_launch_argv }
import gunbc.harness.operator_pod_launch { operator_pod_listen_port }
import gunbc.harness.operator_pod_launch { operator_pod_ninfer_launch }
import gunbc.serving.rented_ninfer_source {
  rented_engine_source, rented_ninfer_81c8ce09_sm120_engine_artifact, rented_weights_source, rented_qwen3_8_27b_nvfp4_weights_placement,
  ninfer_serve_81c8ce09_sm120_release,
}
import gunbc.serving.serving_artifact_placement {
  ServingStoreRoots, ServingProtectedPaths, ServingCopyVerified, ServingCopyAbsent, ServingFetchFailed, ServingFetchSucceeded,
  ServingFetchRefusedMintEntryUnbuilt, serving_fetch_leg, serving_digest_path, serving_artifact_sequence, serving_sequence_endangers,
  ServingInstalledFileRead, ServingEngineVerified, ServingEngineFileDigestDiffers, serving_engine_verdict,
}
import gunbc.serving.serving_launch {
  ServingServeNotListening, ServingServeAnswering, ServingServeUnreadable, ServingServeNoop, ServingServeStart, ServingServeRefused, serving_serve_decision,
  ServingServeKeyUnbound, ServingLaunchRefusedUnmetCauses, serving_startup_program, serving_startup_program_text,
}
import gunbc.serving.serving_artifact_placement { ServingLinkAbsent }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data w_roots: ServingStoreRoots = ServingStoreRoots {
  root: "/root/serve/store" as NonEmptyStr,
  model_link: "/root/serve/model/model.ninfer" as NonEmptyStr,
}

data w_digest: Sha256Digest = Sha256Digest { hex: "74d2c57145e6ff11d1d2faa79594477f9bc903a611af1fb20218189fbbb77d82" }

data w_protected: ServingProtectedPaths = ServingProtectedPaths {
  paths: [serving_digest_path(roots: w_roots, digest: w_digest)],
  model_link: "/root/serve/model/model.ninfer",
  model_link_next: "/root/serve/model/model.ninfer.next",
}

// THE RED: a failed fetch beside a verified copy removes only its own partial.
test fn a_failed_fetch_beside_a_verified_copy_endangers_nothing() -> Bool {
  !serving_sequence_endangers(
    commands: serving_artifact_sequence(roots: w_roots, digest: w_digest, attempt: "1" as NonEmptyStr, existing: ServingCopyVerified, fetch: ServingFetchFailed { cause: "connection reset" as NonEmptyStr }),
    protected: w_protected,
  )
}

test fn a_succeeded_fetch_beside_a_verified_copy_never_renames_over_it() -> Bool {
  !serving_sequence_endangers(
    commands: serving_artifact_sequence(roots: w_roots, digest: w_digest, attempt: "1" as NonEmptyStr, existing: ServingCopyVerified, fetch: ServingFetchSucceeded),
    protected: w_protected,
  )
}

test fn an_absent_copy_promotes_by_rename_and_endangers_nothing_when_unprotected() -> Bool {
  !serving_sequence_endangers(
    commands: serving_artifact_sequence(roots: w_roots, digest: w_digest, attempt: "1" as NonEmptyStr, existing: ServingCopyAbsent, fetch: ServingFetchSucceeded),
    protected: ServingProtectedPaths { paths: [], model_link: "/root/serve/model/model.ninfer", model_link_next: "/root/serve/model/model.ninfer.next" },
  )
}

// THE CONTROL: run.sh's shape, rm -f on the model path, is refused by the same predicate.
test fn a_run_sh_shaped_sequence_is_refused() -> Bool {
  serving_sequence_endangers(commands: [rm_force_command(path: "/root/serve/model/model.ninfer")], protected: w_protected)
}

test fn removing_a_verified_digest_path_or_its_parent_is_refused() -> Bool {
  serving_sequence_endangers(commands: [rm_force_command(path: serving_digest_path(roots: w_roots, digest: w_digest))], protected: w_protected)
    && serving_sequence_endangers(commands: [rm_force_command(path: "/root/serve/store/sha256")], protected: w_protected)
}

// THE FETCH LEG REFUSES TYPED ON THE UNBUILT MINT.
test fn the_fetch_leg_refuses_on_the_unbuilt_mint_for_both_artifacts() -> Bool {
  let engine = serving_fetch_leg(source: rented_engine_source(artifact: rented_ninfer_81c8ce09_sm120_engine_artifact))
  let weights = serving_fetch_leg(source: rented_weights_source(placement: rented_qwen3_8_27b_nvfp4_weights_placement))
  (match engine { ServingFetchRefusedMintEntryUnbuilt { secret_id: s } => (s as String) == "cloudflare-r2-models-read-token"  _ => false })
    && (match weights { ServingFetchRefusedMintEntryUnbuilt { secret_id: s } => (s as String) == "cloudflare-r2-models-read-token"  _ => false })
}

// ENGINE VERIFICATION REFUSES WHEN THE INSTALLED BINARY'S DIGEST DIFFERS FROM THE PIN.
test fn engine_verification_passes_on_the_pinned_files() -> Bool {
  let r = ninfer_serve_81c8ce09_sm120_release
  match serving_engine_verdict(
    engine: r,
    binary: ServingInstalledFileRead { bytes: r.binary.bytes, sha256: r.binary.sha256 },
    rev_file: ServingInstalledFileRead { bytes: r.rev_file.bytes, sha256: r.rev_file.sha256 },
  ) {
    ServingEngineVerified => true
    _ => false
  }
}

test fn engine_verification_refuses_a_binary_whose_digest_differs() -> Bool {
  let r = ninfer_serve_81c8ce09_sm120_release
  match serving_engine_verdict(
    engine: r,
    binary: ServingInstalledFileRead { bytes: r.binary.bytes, sha256: Sha256Digest { hex: "00" } },
    rev_file: ServingInstalledFileRead { bytes: r.rev_file.bytes, sha256: r.rev_file.sha256 },
  ) {
    ServingEngineFileDigestDiffers { relative_path: _, pinned: _, observed: _ } => true
    _ => false
  }
}

// CONVERGENCE: converged is a Noop, absent starts, a mismatch or an unreadable answer refuses.
test fn a_converged_readback_is_a_noop() -> Bool {
  match serving_serve_decision(launch: operator_pod_ninfer_launch, reading: ServingServeAnswering { healthy: true, models: NinferModelsAdvertised { ids: ["qwen"] } }) {
    ServingServeNoop => true
    _ => false
  }
}

test fn an_absent_readback_starts_exactly_once() -> Bool {
  match serving_serve_decision(launch: operator_pod_ninfer_launch, reading: ServingServeNotListening) {
    ServingServeStart => true
    _ => false
  }
}

test fn a_mismatch_or_unreadable_readback_refuses() -> Bool {
  (match serving_serve_decision(launch: operator_pod_ninfer_launch, reading: ServingServeAnswering { healthy: true, models: NinferModelsAdvertised { ids: ["other"] } }) { ServingServeRefused { cause: _ } => true  _ => false })
    && (match serving_serve_decision(launch: operator_pod_ninfer_launch, reading: ServingServeAnswering { healthy: false, models: NinferModelsAdvertised { ids: ["qwen"] } }) { ServingServeRefused { cause: _ } => true  _ => false })
    && (match serving_serve_decision(launch: operator_pod_ninfer_launch, reading: ServingServeUnreadable { cause: "timeout" as NonEmptyStr }) { ServingServeRefused { cause: _ } => true  _ => false })
}

fn argv_has(argv: List<String>, flag: String) -> Bool {
  any(xs: argv, predicate: fn(a) { a == flag })
}

// THE LAUNCH ARGV: every flag the card's line carries, and neither unread one, and no credential.
test fn the_launch_argv_has_every_read_flag_and_omits_the_unread_ones() -> Bool {
  let argv = ninfer_serve_launch_argv(launch: operator_pod_ninfer_launch, model_path: "/root/serve/model/model.ninfer" as NonEmptyStr, listen_port: operator_pod_listen_port)
  argv_has(argv: argv, flag: "--host") && argv_has(argv: argv, flag: "--port") && argv_has(argv: argv, flag: "--model-id") && argv_has(argv: argv, flag: "--max-context") && argv_has(argv: argv, flag: "--kv-capacity") && argv_has(argv: argv, flag: "--max-concurrency")
    && argv_has(argv: argv, flag: "--kv-dtype") && argv_has(argv: argv, flag: "--device-state-slots") && argv_has(argv: argv, flag: "--spec") && argv_has(argv: argv, flag: "--draft-tokens") && argv_has(argv: argv, flag: "--lm-head-draft")
    && argv_has(argv: argv, flag: "--preserve-thinking") && argv_has(argv: argv, flag: "--host-context-mib")
    && !argv_has(argv: argv, flag: "--max-pending-requests") && !argv_has(argv: argv, flag: "--pending-timeout-ms") && !argv_has(argv: argv, flag: "--default-max-tokens") && !argv_has(argv: argv, flag: "--api-key")
}

// THE FULL SEQUENCE: an absent engine reaches the launch leg, which refuses on the unbound key grant, AFTER the
// placement legs emitted the link switch (two commands).
test fn the_full_sequence_refuses_at_the_launch_leg_with_no_earlier_leg_skipped() -> Bool {
  let p = serving_startup_program(
    roots: w_roots, digest: w_digest, link: ServingLinkAbsent,
    launch: operator_pod_ninfer_launch, launch_argv: ninfer_serve_launch_argv(launch: operator_pod_ninfer_launch, model_path: "/root/serve/model/model.ninfer" as NonEmptyStr, listen_port: operator_pod_listen_port), reading: ServingServeNotListening,
    key: ServingServeKeyUnbound { grant_name: "serve-api-key" as NonEmptyStr },
  )
  (match p.launch { ServingLaunchRefusedUnmetCauses { key_grant: _, detach: _ } => true  _ => false })
    && !serving_sequence_endangers(commands: p.placement_commands, protected: w_protected)
    && list_length(items: p.placement_commands) == 2
}

// THE RECEIPT TEXT on the real producer: it names both unmet causes and carries the link switch it emitted.
test fn the_receipt_text_names_both_unmet_causes_and_the_link_switch() -> Bool {
  let p = serving_startup_program(
    roots: w_roots, digest: w_digest, link: ServingLinkAbsent,
    launch: operator_pod_ninfer_launch, launch_argv: ninfer_serve_launch_argv(launch: operator_pod_ninfer_launch, model_path: "/root/serve/model/model.ninfer" as NonEmptyStr, listen_port: operator_pod_listen_port), reading: ServingServeNotListening,
    key: ServingServeKeyUnbound { grant_name: "serve-api-key" as NonEmptyStr },
  )
  let t = serving_startup_program_text(program: p)
  string_contains(s: t, pattern: "serve key grant unbound") && string_contains(s: t, pattern: "no modeled stdout-to-file route") && string_contains(s: t, pattern: "model.ninfer")
}
