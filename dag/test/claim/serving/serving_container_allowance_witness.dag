module test.claim.serving.serving_container_allowance_witness

import std.types { String, NonEmptyStr, Bool }
import std.nat { Nat }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.optional { Present, Absent }
import std.measure { ByteSize, byte_size, byte_size_count, gibibyte, gibibyte_count, gibibyte_to_byte_size }
import gunbc.serving.serving_container_allowance {
  ServingContainerAllowance, srv1_serving_allowance, srv1_serving_allowance_pre_resize, srv1_inference_slice_limit, srv1_serving_non_reclaimable_demand,
  srv1_serving_non_reclaimable_demand_resized, srv1_l1_tier_sizing, lmcache_l1_gib,
  ParentSliceLimit, ParentSliceLimitRead, ParentSliceLimitUnread,
  ContainerClaimVerdict, ContainerFitsParent, ContainerExceedsParentMax, ContainerSwapExceedsParent, ParentLimitUnread,
  NonReclaimableDemand, NonReclaimableVerdict, NonReclaimableFits, NonReclaimableExceedsAllowance, ShmResidentExceedsShmLimit,
  WrapperAllowanceVerdict, WrapperCarriesAllowance, WrapperDisagreesWithAllowance, AllowanceNotRenderable,
  ServingContainerHostClaim, ServingContainerClaimResolved, ServingContainerClaimRefused,
  container_claim_under_parent, non_reclaimable_verdict, non_reclaimable_floor, wrapper_allowance_verdict,
  serving_container_host_claim, allowance_swap,
}
import gunbc.serving.srv1_serving_launch { srv1_serving_wrapper, srv1_serving_wrapper_resized, srv1_serving_wrapper_allowance_verdict, srv1_wrapper_relaunch_state, Srv1WrapperRelaunchPending, Srv1WrapperRelaunchDone }
import gunbc.serving.serving_host_memory { srv1_vllm_engine_memory, ServingMemoryRead, ServingMemoryAssumed, ServingMemoryUnread }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn gib(n: Nat) -> ByteSize {
  gibibyte_to_byte_size(g: gibibyte(count: n))
}

fn allowance_of(memory: ByteSize, total: ByteSize, shm: ByteSize) -> ServingContainerAllowance {
  ServingContainerAllowance { memory: memory, memory_swap_total: total, shm: shm, cgroup_parent: "srv1-inference.slice" as NonEmptyStr }
}

fn parent_of(max: ByteSize, high: ByteSize, swap: ByteSize) -> ParentSliceLimit {
  ParentSliceLimitRead { name: "srv1-inference.slice" as NonEmptyStr, memory_max: max, memory_high: high, swap_max: swap, provenance: "witness fixture" as NonEmptyStr }
}

fn wrapper_agrees(v: WrapperAllowanceVerdict) -> Bool {
  match v { WrapperCarriesAllowance => true  _ => false }
}

fn wrapper_disagrees(v: WrapperAllowanceVerdict) -> Bool {
  match v { WrapperDisagreesWithAllowance { missing_flags: _ } => true  _ => false }
}

fn not_renderable(v: WrapperAllowanceVerdict) -> Bool {
  match v { AllowanceNotRenderable { figure: _ } => true  _ => false }
}

// THE REAL CONSUMER READS THE ALLOWANCE: the verdict reads the body pinned to the host copy, which still
// carries the 130 GiB flags, so it disagrees with the 71 GiB allowance until the relaunch (pending state).
test fn the_host_wrapper_disagrees_with_the_allowance_until_the_relaunch() -> Bool {
  wrapper_disagrees(v: srv1_serving_wrapper_allowance_verdict())
}

// THE CHECK DISCRIMINATES: a larger allowance, a larger shm, and an unrenderable (non-GiB) allowance each
// disagree with the same wrapper body.
test fn an_allowance_the_wrapper_does_not_carry_is_a_typed_disagreement() -> Bool {
  wrapper_disagrees(v: wrapper_allowance_verdict(body: srv1_serving_wrapper_resized.body, a: allowance_of(memory: gib(n: 140), total: gib(n: 140), shm: gib(n: 66))))
    && wrapper_disagrees(v: wrapper_allowance_verdict(body: srv1_serving_wrapper_resized.body, a: allowance_of(memory: gib(n: 71), total: gib(n: 71), shm: gib(n: 70))))
    && wrapper_disagrees(v: wrapper_allowance_verdict(body: srv1_serving_wrapper_resized.body, a: allowance_of(memory: gib(n: 71), total: gib(n: 100), shm: gib(n: 66))))
    && not_renderable(v: wrapper_allowance_verdict(body: srv1_serving_wrapper_resized.body, a: allowance_of(memory: byte_size(count: 76235669505), total: gib(n: 71), shm: gib(n: 66))))
}

// THE RUNNING WRAPPER IS THE RELAUNCH OBLIGATION, TYPED: the body the host still runs (sha256 pinned by the
// startup receipt) disagrees with the resized allowance, and the pending state names both shas. When the
// operator-gated relaunch records a receipt whose wrapper sha256 equals the resized body's, the state is
// Done and this claim is the one to retire.
test fn the_pinned_wrapper_is_the_pre_resize_entrypoint_a_typed_relaunch_obligation() -> Bool {
  wrapper_disagrees(v: wrapper_allowance_verdict(body: srv1_serving_wrapper.body, a: srv1_serving_allowance))
    && wrapper_agrees(v: wrapper_allowance_verdict(body: srv1_serving_wrapper.body, a: srv1_serving_allowance_pre_resize))
    && match srv1_wrapper_relaunch_state() {
      Srv1WrapperRelaunchPending { running_sha256: r, pending_sha256: p } =>
        r == "b8b73d186a43d56c54eae5985ef0b8d1751b06af08dbf7f7013b885ba49e62bd"
          && p == "9994ac3ecc6ac66a51f0890bdee5c0a2e35d107fc1180f1af2474c3d9058006f"
      Srv1WrapperRelaunchDone => false
    }
}

// INDEPENDENT ORACLE: the three figures `docker inspect lil-flash-next` returned on 2026-11-07T17:39Z
// (HostConfig.Memory 139586437120, MemorySwap 139586437120, ShmSize 118111600640) as literals, so the
// allowance is compared with the live container and not with a restatement of itself.
test fn the_pre_resize_allowance_equals_what_docker_inspect_read_before_the_relaunch() -> Bool {
  byte_size_count(b: srv1_serving_allowance_pre_resize.memory) == 139586437120
    && byte_size_count(b: srv1_serving_allowance_pre_resize.memory_swap_total) == 139586437120
    && byte_size_count(b: srv1_serving_allowance_pre_resize.shm) == 118111600640
    && (srv1_serving_allowance_pre_resize.cgroup_parent as String) == "srv1-inference.slice"
}

// THE RESIZED ALLOWANCE IN BYTES, hand-derived: 71 * 1073741824 = 76235669504 (memory and swap total),
// 66 * 1073741824 = 70866960384 (shm).
test fn the_resized_allowance_is_71_71_66_gib() -> Bool {
  byte_size_count(b: srv1_serving_allowance.memory) == 76235669504
    && byte_size_count(b: srv1_serving_allowance.memory_swap_total) == 76235669504
    && byte_size_count(b: srv1_serving_allowance.shm) == 70866960384
}

fn fits(v: ContainerClaimVerdict) -> Bool {
  match v { ContainerFitsParent { parent_spare: s } => byte_size_count(b: s) == 206158430208 - 76235669504  _ => false }
}

fn exceeds_max(v: ContainerClaimVerdict) -> Bool {
  match v { ContainerExceedsParentMax { child: _, parent_max: _ } => true  _ => false }
}

fn swap_exceeds(v: ContainerClaimVerdict) -> Bool {
  match v { ContainerSwapExceedsParent { child_swap: _, parent_swap_max: _ } => true  _ => false }
}

fn unread_parent(v: ContainerClaimVerdict) -> Bool {
  match v { ParentLimitUnread { reason: _ } => true  _ => false }
}

fn claim_resolved_at(c: ServingContainerHostClaim, n: Nat) -> Bool {
  match c { ServingContainerClaimResolved { memory: m } => byte_size_count(b: m) == n  _ => false }
}

fn claim_refused(c: ServingContainerHostClaim) -> Bool {
  match c { ServingContainerClaimRefused { cause: _ } => true  _ => false }
}

// THE PARENT LIMIT IS MODELED AND A SMALLER PARENT REFUSES THE LARGER CHILD. The effective 192 GiB slice
// admits the 130 GiB container; the unit file's 80G (still on disk on srv1, overridden by a drop-in) does
// not, and the host claim is then Refused with the parent's cause rather than charged at 130 GiB.
test fn a_smaller_parent_slice_refuses_the_larger_container_claim() -> Bool {
  fits(v: container_claim_under_parent(a: srv1_serving_allowance, parent: srv1_inference_slice_limit))
    && exceeds_max(v: container_claim_under_parent(a: srv1_serving_allowance, parent: parent_of(max: gib(n: 64), high: gib(n: 64), swap: byte_size(count: 0))))
    && swap_exceeds(v: container_claim_under_parent(a: allowance_of(memory: gib(n: 130), total: gib(n: 140), shm: gib(n: 110)), parent: srv1_inference_slice_limit))
    && unread_parent(v: container_claim_under_parent(a: srv1_serving_allowance, parent: ParentSliceLimitUnread { name: "srv1-inference.slice" as NonEmptyStr, reason: "not read" as NonEmptyStr }))
}

test fn the_host_charge_is_the_allowance_once_and_only_under_an_admitting_parent() -> Bool {
  claim_resolved_at(c: serving_container_host_claim(a: srv1_serving_allowance, parent: srv1_inference_slice_limit), n: 76235669504)
    && claim_refused(c: serving_container_host_claim(a: srv1_serving_allowance, parent: parent_of(max: gib(n: 64), high: gib(n: 64), swap: byte_size(count: 0))))
}

// THE HOST-BUDGET ENGINE ROW READS THE ALLOWANCE: its cap and swap are the allowance's, with no literal
// of its own (the superseded row authored 130 GiB separately).
test fn the_host_budget_engine_row_reads_the_allowance() -> Bool {
  match srv1_vllm_engine_memory.memory_cap {
    ServingMemoryRead { bytes: b, provenance: _ } =>
      byte_size_count(b: b) == byte_size_count(b: srv1_serving_allowance.memory)
    ServingMemoryAssumed { bytes: _, reason: _ } => false
    ServingMemoryUnread { reason: _ } => false
  } && match srv1_vllm_engine_memory.swap_cap {
    ServingMemoryRead { bytes: b, provenance: _ } => byte_size_count(b: b) == 0
    ServingMemoryAssumed { bytes: _, reason: _ } => false
    ServingMemoryUnread { reason: _ } => false
  }
}

fn nr_fits_margin(v: NonReclaimableVerdict, n: Nat) -> Bool {
  match v { NonReclaimableFits { margin: m } => byte_size_count(b: m) == n  _ => false }
}

fn nr_exceeds(v: NonReclaimableVerdict) -> Bool {
  match v { NonReclaimableExceedsAllowance { demand: _, allowance: _ } => true  _ => false }
}

fn nr_shm_over(v: NonReclaimableVerdict) -> Bool {
  match v { ShmResidentExceedsShmLimit { shm_resident: _, shm: _ } => true  _ => false }
}

// THE FLOOR UNDER THE CAP, from the 2026-11-07T17:39Z read: shmem 107538624512 plus anon 7952486400 is
// 115491110912 (the literal below is the hand sum), against 139586437120: 24095326208 B of margin. The
// container sits AT memory.max only on reclaimable page cache, which is why memory.current is not the demand.
test fn the_non_reclaimable_floor_fits_the_live_allowance_with_a_stated_margin() -> Bool {
  byte_size_count(b: non_reclaimable_floor(d: srv1_serving_non_reclaimable_demand)) == 115491110912
    && nr_fits_margin(v: non_reclaimable_verdict(a: srv1_serving_allowance_pre_resize, d: srv1_serving_non_reclaimable_demand), n: 24095326208)
}

// THE OLD READING DOES NOT FIT THE RESIZED CAP (the reason the tier shrinks), and the derived tier does.
// L1 = floor((76235669504 - 2*7952486400 - 164442112) / 1073741824) = floor(60165254592 / 1073741824) = 56.
// Floor at 56 = 56*1073741824 + 164442112 + 7952486400 = 68246470656; margin = 76235669504 - 68246470656
// = 7989198848, which is at least the anon reading (7952486400) it is meant to absorb doubling.
test fn the_derived_cache_tier_fits_the_resized_cap_where_the_running_tier_does_not() -> Bool {
  nr_shm_over(v: non_reclaimable_verdict(a: srv1_serving_allowance, d: srv1_serving_non_reclaimable_demand))
    && gibibyte_count(g: lmcache_l1_gib(a: srv1_serving_allowance, z: srv1_l1_tier_sizing)) == 56
    && byte_size_count(b: non_reclaimable_floor(d: srv1_serving_non_reclaimable_demand_resized)) == 68246470656
    && nr_fits_margin(v: non_reclaimable_verdict(a: srv1_serving_allowance, d: srv1_serving_non_reclaimable_demand_resized), n: 7989198848)
}

test fn a_floor_past_the_allowance_or_a_tier_past_shm_is_refused() -> Bool {
  nr_exceeds(v: non_reclaimable_verdict(a: srv1_serving_allowance, d: NonReclaimableDemand { shm_resident: gib(n: 60), anon: gib(n: 30), provenance: "witness fixture" as NonEmptyStr }))
    && nr_shm_over(v: non_reclaimable_verdict(a: srv1_serving_allowance, d: NonReclaimableDemand { shm_resident: gib(n: 67), anon: gib(n: 1), provenance: "witness fixture" as NonEmptyStr }))
}
