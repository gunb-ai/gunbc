module test.claim.serving.serving_butch_fixture_witness

// THE BUTCH-SHAPE FIXTURE, EXECUTED ON A SYNTHETIC REPLICA SET. butch (srv14) -- the operator's hand-deployed
// two-engine host (2026-11-10, operator facts msg_cc2ab16d) -- is the shape that first proves the N-replica model:
// one host, priced ONCE PER REPLICA, no per-host fork. srv14's PRODUCTION reservation row is B4b's (it is also a
// committed runner host via #16313, and its per-engine memory is unmeasured -- see the roster note in
// gunbc.serving.serving_reservation). So this witness does NOT read srv14 from the roster; it builds the OPERATOR'S
// STATED butch shape as a synthetic replica set and drives the PURE folds over it, discriminating the one thing the
// reservation model can be asked about that shape:
//
//   TWO REPLICAS, EACH PRICED PER REPLICA. The two cpusets (0-39, 40-79) are AFFINITY -- disjoint, bookable -- so
//   the fold withholds NO cores (the affinity price), and because the per-engine MEMORY was never measured the fold
//   returns Absent (the width would fail CLOSED, not charge a fabricated zero). A model that summed slots per host,
//   priced an affinity pin as exclusive, or invented a memory figure fails here.
//
// The card/power-cap, API-key and Strata-release facts (four A2 cards, 35 W, ports 18081/18082, ~/strata-pool/api_key)
// are recorded for B4b's fixtures; nothing in production consumes them yet, so modelling them here would dangle.
//
// Run (the whole floor is CI's job; this file runs alone):
//   claim_batch --hermetic --source-root dag --source-root src \
//     --entry dag/test/claim/serving/serving_butch_fixture_witness.dag \
//     --functions witness_butch_shape_runs_two_priced_replicas_whose_affinity_pins_are_disjoint
import std.types { Bool, List, NonEmptyStr }
import std.optional { Present, Absent }
import std.measure { hardware_thread_count_value }
import gunbc.serving.serving_host_memory { ServingMemoryUnread }
import gunbc.serving.serving_reservation {
  cores_withheld_from_replicas, memory_reserved_by_replicas,
  ReplicaReservation, CpuRange, CpuAffinity, CpuRanges,
}

// THE OPERATOR'S butch SHAPE (msg_cc2ab16d), SYNTHETIC -- not read from srv14's roster (which is B4b's). Two engines,
// cpuset 0-39 and 40-79 as AFFINITY pins, per-engine memory UNMEASURED (B4b reads it from the running box).
fn butch_shape() -> List<ReplicaReservation> {
  [
    ReplicaReservation {
      // cpuset 0-39 is an operator-stated AFFINITY pin (butch-a CPUs 0-39).
      cpu: Present { value: CpuAffinity { set: CpuRanges { ranges: [ CpuRange { first: 0, width: 40 } ] } } },
      memory: ServingMemoryUnread { reason: "synthetic butch-shape fixture: operator stated cpusets/cards (msg_cc2ab16d), not a per-engine memory figure; B4b reads it from the running box" as NonEmptyStr },
    },
    ReplicaReservation {
      // cpuset 40-79 is an operator-stated AFFINITY pin (butch-b CPUs 40-79).
      cpu: Present { value: CpuAffinity { set: CpuRanges { ranges: [ CpuRange { first: 40, width: 40 } ] } } },
      memory: ServingMemoryUnread { reason: "synthetic butch-shape fixture: operator stated cpusets/cards (msg_cc2ab16d), not a per-engine memory figure; B4b reads it from the running box" as NonEmptyStr },
    },
  ]
}

// TWO REPLICAS, EACH PRICED; AFFINITY PINS DISJOINT AND THE RUNNER KEEPS EVERY CORE; UNREAD MEMORY FAILS CLOSED.
test fn witness_butch_shape_runs_two_priced_replicas_whose_affinity_pins_are_disjoint() -> Bool {
  let reps = butch_shape()
  let two = count(reps) == 2
  // butch-a is pinned 0-39 and butch-b 40-79, each an AFFINITY arm (a CpuExclusive would not match these arms,
  // and would price cores away -- contradicted by cores_whole below). The operator's two-engine shape, one fold.
  let butch_a_pin = any(reps, r => match r.cpu {
    Present { value: CpuAffinity { set: CpuRanges { ranges: rs } } } => any(rs, rg => rg.first == 0 && rg.width == 40)
    _ => false
  })
  let butch_b_pin = any(reps, r => match r.cpu {
    Present { value: CpuAffinity { set: CpuRanges { ranges: rs } } } => any(rs, rg => rg.first == 40 && rg.width == 40)
    _ => false
  })
  // DISJOINT: the lower pin ends at 39 and the upper starts at 40, and no single replica spans the seam -- no
  // replica's range has first <= 39 and first+width >= 41. (A collapsed/host-pinned model could not keep both pins.)
  let seam_open = all(reps, r => match r.cpu {
    Present { value: CpuAffinity { set: CpuRanges { ranges: rs } } } => all(rs, rg => !(rg.first <= 39 && rg.first + rg.width >= 41))
    _ => true
  })
  // AFFINITY leaves the runner whole: the fold withholds no cores. The memory is UNMEASURED, so the fold returns
  // Absent -- the width would fail CLOSED rather than charge a fabricated figure. Both are the pure folds, so this
  // witnesses the mechanism without a real host occupying the production roster.
  let cores_whole = hardware_thread_count_value(t: cores_withheld_from_replicas(replicas: reps)) == 0
  let memory_fail_closed = match memory_reserved_by_replicas(replicas: reps) {
    Absent => true
    Present { value: _ } => false
  }
  two && butch_a_pin && butch_b_pin && seam_open && cores_whole && memory_fail_closed
}
