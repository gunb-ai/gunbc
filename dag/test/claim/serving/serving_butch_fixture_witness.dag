module test.claim.serving.serving_butch_fixture_witness

// THE FIRST REAL SERVING ROW, EXECUTED: butch (srv14), the operator's hand-deployed two-engine host (2026-11-10).
// srv3 and srv4 run one engine each; butch runs TWO, so it is the first row that proves the N-replica model --
// one host, priced once per replica, no per-host fork. This witness drives gunbc.serving.serving_reservation and
// says the one thing the kept reservation model can be asked about butch, discriminating:
//
//   TWO REPLICAS, EACH PRICED PER REPLICA. butch's two cpusets (0-39, 40-79) are AFFINITY -- disjoint, bookable,
//   so the runner keeps every core (host_cores_withheld is zero, the affinity price), and because its per-engine
//   MEMORY was never measured the width FAILS CLOSED on it (host_memory_reserved returns Absent, not a fabricated
//   zero). A model that summed slots per host, priced an affinity pin as exclusive, or invented a memory figure
//   fails here.
//
// The card/power-cap, API-key and Strata-release facts B4a once modelled for butch are NOT here: nothing in
// production consumes them yet, so they are B4b's, re-added WITH the deploy that reads them. (The operator's
// facts -- four A2 cards, 35 W, ports 18081/18082, the shared ~/strata-pool/api_key -- are recorded for B4b's
// fixtures; modelling them with no consumer would be a guess.)
//
// Run (the whole floor is CI's job; this file runs alone):
//   claim_batch --hermetic --source-root dag --source-root src/v2 \
//     --entry dag/test/claim/serving/serving_butch_fixture_witness.dag \
//     --functions witness_butch_runs_two_priced_replicas_whose_affinity_pins_are_disjoint
import std.types { Bool, List }
import std.optional { Present, Absent }
import gunbc.fleet.fleet_host_identity { operator_host_srv14 }
import gunbc.serving.serving_reservation {
  host_reservations_for, host_memory_reserved, host_cores_withheld_from_runner,
  ReplicaReservation, CpuRange, CpuAffinity, CpuRanges,
}

fn butch_replicas() -> List<ReplicaReservation> {
  match host_reservations_for(operator_host_srv14) {
    Present { value: r } => r.replicas
    Absent => []
  }
}

// TWO REPLICAS, EACH PRICED; AFFINITY PINS DISJOINT AND THE RUNNER KEEPS EVERY CORE.
test fn witness_butch_runs_two_priced_replicas_whose_affinity_pins_are_disjoint() -> Bool {
  let reps = butch_replicas()
  let two = count(reps) == 2
  // butch-a is pinned 0-39 and butch-b 40-79, each an AFFINITY arm (a CpuExclusive would not match these arms,
  // and would price cores away -- contradicted by cores_whole below). The operator's two-engine shape, one row.
  let butch_a_pin = any(reps, r => match r.cpu {
    Present { value: CpuAffinity { set: CpuRanges { ranges: rs } } } => any(rs, rg => rg.first == 0 && rg.last == 39)
    _ => false
  })
  let butch_b_pin = any(reps, r => match r.cpu {
    Present { value: CpuAffinity { set: CpuRanges { ranges: rs } } } => any(rs, rg => rg.first == 40 && rg.last == 79)
    _ => false
  })
  // DISJOINT: the lower pin ends at 39 and the upper starts at 40, and no single replica spans the seam -- no
  // replica's range has first <= 39 and last >= 40. (A collapsed/host-pinned model could not keep both pins.)
  let seam_open = all(reps, r => match r.cpu {
    Present { value: CpuAffinity { set: CpuRanges { ranges: rs } } } => all(rs, rg => !(rg.first <= 39 && rg.last >= 40))
    _ => true
  })
  // AFFINITY leaves the runner whole: butch withholds no cores. Its memory is UNMEASURED, so host_memory_reserved
  // returns Absent -- the width fails CLOSED rather than charge butch a fabricated figure.
  let cores_whole = host_cores_withheld_from_runner(operator_host_srv14) == 0
  let memory_fail_closed = match host_memory_reserved(operator_host_srv14) {
    Absent => true
    Present { value: _ } => false
  }
  two && butch_a_pin && butch_b_pin && seam_open && cores_whole && memory_fail_closed
}
