module test.claim.serving.serving_provision_derivation_witness

import std.types { String, NonEmptyStr, Bool }
import std.optional { Present, Absent }
import std.content_hash { Sha256Digest }
import std.decl_ref { decl_ref }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import extdeps.ninfer.ninfer_serve { ninfer_serve_launch_argv }
import gunbc.harness.operator_pod_launch { operator_pod_ninfer_launch, operator_pod_listen_port }
import gunbc.serving.rented_ninfer_source { ninfer_serve_81c8ce09_sm120_release, rented_weights_source, rented_qwen3_8_27b_nvfp4_weights_placement }
import gunbc.serving.serving_artifact_placement { ServingStoreRoots, ServingLinkAbsent }
import gunbc.serving.serving_launch {
  ServingServeNotListening, ServingServeKeyUnbound, serving_startup_program, serving_startup_program_text,
}
import gunbc.serving.serving_provision_derivation {
  ServingProvisionDerived, ServingProvisionDerivedVllm, ServingProvisionRefusedStartSource, ServingProvisionRefusedVllmDeployment, ServingProvisionRefusedNoServedModelId,
  serving_provision_derive,
}
import std.algebra { length }
import product.fabric.serving_recipe {
  ServingRecipe, ServingModelArtifact, ServingStartRoute, WeightsNamedUnpinned, StartRouteUnread, StartFromObjectStoreObserved,
  SettingOperatorPolicy, serving_recipe_qwen3_8_27b_nvfp4_ninfer, serving_recipe_flash_next_lab_vllm,
}
import extdeps.vllm.local_inference_lab_build { local_inference_lab_vllm_image }
import extdeps.local_inference_lab.qwen3_8_flash_next { qwen3_8_flash_next_manifest, qwen3_8_flash_next_pins_cohere }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data w_roots: ServingStoreRoots = ServingStoreRoots {
  root: "/root/serve/store" as NonEmptyStr,
  model_link: "/root/serve/model/model.ninfer" as NonEmptyStr,
  serve_log: "/root/serve/serve.log" as NonEmptyStr,
}

// The digest the S3c witness (test.claim.serving.serving_startup_witness) supplies as a literal.
data w_pinned_digest: Sha256Digest = Sha256Digest { hex: "74d2c57145e6ff11d1d2faa79594477f9bc903a611af1fb20218189fbbb77d82" }

fn qwen_with_start(start: ServingStartRoute) -> ServingRecipe {
  ServingRecipe {
    id: serving_recipe_qwen3_8_27b_nvfp4_ninfer.id,
    model: serving_recipe_qwen3_8_27b_nvfp4_ninfer.model,
    engine: serving_recipe_qwen3_8_27b_nvfp4_ninfer.engine,
    catalog_unit: serving_recipe_qwen3_8_27b_nvfp4_ninfer.catalog_unit,
    published_tcp_port: serving_recipe_qwen3_8_27b_nvfp4_ninfer.published_tcp_port,
    cards: serving_recipe_qwen3_8_27b_nvfp4_ninfer.cards,
    driver_floor: serving_recipe_qwen3_8_27b_nvfp4_ninfer.driver_floor,
    disk: serving_recipe_qwen3_8_27b_nvfp4_ninfer.disk,
    cache: serving_recipe_qwen3_8_27b_nvfp4_ninfer.cache,
    start: start,
    throughput: serving_recipe_qwen3_8_27b_nvfp4_ninfer.throughput,
    settings: serving_recipe_qwen3_8_27b_nvfp4_ninfer.settings,
  }
}

fn qwen_with_model(model: ServingModelArtifact) -> ServingRecipe {
  ServingRecipe {
    id: serving_recipe_qwen3_8_27b_nvfp4_ninfer.id,
    model: model,
    engine: serving_recipe_qwen3_8_27b_nvfp4_ninfer.engine,
    catalog_unit: serving_recipe_qwen3_8_27b_nvfp4_ninfer.catalog_unit,
    published_tcp_port: serving_recipe_qwen3_8_27b_nvfp4_ninfer.published_tcp_port,
    cards: serving_recipe_qwen3_8_27b_nvfp4_ninfer.cards,
    driver_floor: serving_recipe_qwen3_8_27b_nvfp4_ninfer.driver_floor,
    disk: serving_recipe_qwen3_8_27b_nvfp4_ninfer.disk,
    cache: serving_recipe_qwen3_8_27b_nvfp4_ninfer.cache,
    start: serving_recipe_qwen3_8_27b_nvfp4_ninfer.start,
    throughput: serving_recipe_qwen3_8_27b_nvfp4_ninfer.throughput,
    settings: serving_recipe_qwen3_8_27b_nvfp4_ninfer.settings,
  }
}

// THE INHABITANCE CLAIM: the qwen ninfer recipe derives exactly the pins the S3c witness supplies by hand.
test fn the_qwen_ninfer_recipe_derives_the_pinned_s3c_inputs() -> Bool {
  match serving_provision_derive(recipe: serving_recipe_qwen3_8_27b_nvfp4_ninfer) {
    ServingProvisionDerived { inputs: i } =>
      (i.engine.release_name as String) == (ninfer_serve_81c8ce09_sm120_release.release_name as String)
        && (i.engine.binary.sha256.hex as String) == (ninfer_serve_81c8ce09_sm120_release.binary.sha256.hex as String)
        && (i.engine.rev_file.sha256.hex as String) == (ninfer_serve_81c8ce09_sm120_release.rev_file.sha256.hex as String)
        && (i.digest.hex as String) == (w_pinned_digest.hex as String)
        && (i.source.locator.key as String) == (rented_weights_source(placement: rented_qwen3_8_27b_nvfp4_weights_placement).locator.key as String)
        && (i.launch.model_id as String) == (operator_pod_ninfer_launch.model_id as String)
        && i.listen_port == operator_pod_listen_port
    _ => false
  }
}

// THE ROUTE, not only the answer: the derived inputs drive the real S3c program to the same receipt text as the
// hand-supplied pins do. Were the derivation to hand back anything else, the two texts would differ.
test fn the_derived_inputs_drive_the_s3c_program_to_the_hand_pinned_receipt() -> Bool {
  match serving_provision_derive(recipe: serving_recipe_qwen3_8_27b_nvfp4_ninfer) {
    ServingProvisionDerived { inputs: i } => {
      let derived = serving_startup_program(
        roots: w_roots, digest: i.digest, link: ServingLinkAbsent,
        launch: i.launch, launch_argv: ninfer_serve_launch_argv(launch: i.launch, model_path: "/root/serve/model/model.ninfer" as NonEmptyStr, listen_port: i.listen_port),
        reading: ServingServeNotListening, key: ServingServeKeyUnbound { grant_name: "serve-api-key" as NonEmptyStr },
      )
      let pinned = serving_startup_program(
        roots: w_roots, digest: w_pinned_digest, link: ServingLinkAbsent,
        launch: operator_pod_ninfer_launch, launch_argv: ninfer_serve_launch_argv(launch: operator_pod_ninfer_launch, model_path: "/root/serve/model/model.ninfer" as NonEmptyStr, listen_port: operator_pod_listen_port),
        reading: ServingServeNotListening, key: ServingServeKeyUnbound { grant_name: "serve-api-key" as NonEmptyStr },
      )
      serving_startup_program_text(program: derived) == serving_startup_program_text(program: pinned)
    }
    _ => false
  }
}

// ONE AUTHORITY: the served model id is the recipe's, not a copy held by the launch.
test fn the_launch_model_id_follows_the_recipe() -> Bool {
  let other = qwen_with_model(model: ServingModelArtifact { source: serving_recipe_qwen3_8_27b_nvfp4_ninfer.model.source, served_model_id: Present { value: "other-id" as NonEmptyStr } })
  (match serving_provision_derive(recipe: other) {
    ServingProvisionDerived { inputs: i } => (i.launch.model_id as String) == "other-id"
    _ => false
  })
    && (match serving_provision_derive(recipe: qwen_with_model(model: ServingModelArtifact { source: serving_recipe_qwen3_8_27b_nvfp4_ninfer.model.source, served_model_id: Absent })) {
      ServingProvisionRefusedNoServedModelId => true
      _ => false
    })
}

// 2026-10-25: ServingProvisionRefusedEngineVllm is DISSOLVED — the vllm launch is modeled
// (gunbc.serving.srv1_serving_launch), so the flash recipe now DERIVES. What still must hold: the
// derived inputs read their one authority each (the release's own image pin, the recipe's Hub pin, the
// modeled launch at the recipe's port), and nothing fell back to the ninfer arm.
test fn a_vllm_recipe_derives_from_the_modeled_launch_and_never_falls_back() -> Bool {
  match serving_provision_derive(recipe: serving_recipe_flash_next_lab_vllm) {
    ServingProvisionDerivedVllm { inputs: i } =>
      (i.image.digest_sha256 as String) == (local_inference_lab_vllm_image.digest_sha256 as String)
        && (i.weights.revision as String) == (qwen3_8_flash_next_manifest.revision as String)
        && i.listen_port == serving_recipe_flash_next_lab_vllm.published_tcp_port
        && (match i.launch.engine.max_model_len { Absent => true, _ => false })
        && (match i.launch.engine.kv_cache_dtype { Absent => true, _ => false })
        && (match i.launch.engine.served_model_name { Absent => true, _ => false })
        // The provision names the bytes it starts from shard by shard: the derived per-file roster is
        // the publisher's pinned 23, and it folds against the manifest it accompanies.
        && length(xs: i.weights_digests) == 23
        && qwen3_8_flash_next_pins_cohere()
    _ => false
  }
}

// THE LAUNCH BINDS TO THE RECIPE BY IDENTITY, NOT BY ENGINE (review 86738). A SECOND vLLM recipe — a
// different checkpoint, a different host — must not be handed srv1's deployment: its wrapper models one
// host, one key file, one TLS pair and one LMCache sizing, so borrowing it would produce a provision
// contradicting that recipe's own weights, with no refusal. This is the fabricated-plausible-output
// path DESIGN §5 rules out; it refuses with a typed cause instead.
test fn a_second_vllm_recipe_does_not_borrow_srv1_s_launch() -> Bool {
  let flash = serving_recipe_flash_next_lab_vllm
  let other_host = ServingRecipe {
    id: decl_ref(module_path: "product.fabric.serving_recipe", decl_name: "serving_recipe_a_second_vllm_deployment"),
    model: flash.model, engine: flash.engine, catalog_unit: flash.catalog_unit,
    published_tcp_port: flash.published_tcp_port, cards: flash.cards, driver_floor: flash.driver_floor,
    disk: flash.disk, cache: flash.cache,
    start: flash.start, throughput: flash.throughput,
  }
  match serving_provision_derive(recipe: other_host) {
    ServingProvisionRefusedVllmDeployment { cause: c } => (c as String) != ""
    _ => false
  }
}

// The refusal side keeps its teeth: a vllm recipe on an OBSERVED object-store start refuses with its
// cause instead of borrowing the Hub route, and an unpinned-weights recipe cannot start at all.
test fn a_vllm_recipe_on_an_unread_or_observed_start_refuses_with_its_cause() -> Bool {
  let flash = serving_recipe_flash_next_lab_vllm
  let observed = ServingRecipe {
    id: flash.id, model: flash.model, engine: flash.engine, catalog_unit: flash.catalog_unit,
    published_tcp_port: flash.published_tcp_port, cards: flash.cards, driver_floor: flash.driver_floor,
    disk: flash.disk, cache: flash.cache,
    start: StartFromObjectStoreObserved { store: "r2://weights" as NonEmptyStr, hub_fallback: true, standing: SettingOperatorPolicy { ruling: decl_ref(module_path: "gunbc.design_ruling", decl_name: "flex_first_recipe_is_flash_next") } },
    throughput: flash.throughput,
  }
  let unpinned = ServingRecipe {
    id: flash.id,
    model: ServingModelArtifact { source: WeightsNamedUnpinned { weights: "unpinned" as NonEmptyStr, quantization: Absent }, served_model_id: flash.model.served_model_id },
    engine: flash.engine, catalog_unit: flash.catalog_unit,
    published_tcp_port: flash.published_tcp_port, cards: flash.cards, driver_floor: flash.driver_floor,
    disk: flash.disk, cache: flash.cache,
    start: flash.start, throughput: flash.throughput,
  }
  (match serving_provision_derive(recipe: observed) {
    ServingProvisionRefusedStartSource { cause: _ } => true
    _ => false
  })
    && (match serving_provision_derive(recipe: unpinned) {
      ServingProvisionRefusedStartSource { cause: _ } => true
      _ => false
    })
}

test fn an_unread_or_unplaced_start_source_refuses_typed() -> Bool {
  (match serving_provision_derive(recipe: qwen_with_start(start: StartRouteUnread { read_obligation: "read the route" as NonEmptyStr })) {
    ServingProvisionRefusedStartSource { cause: _ } => true
    _ => false
  })
    && (match serving_provision_derive(recipe: qwen_with_start(start: StartFromObjectStoreObserved {
      store: "models" as NonEmptyStr,
      hub_fallback: false,
      standing: SettingOperatorPolicy { ruling: decl_ref(module_path: "gunbc.design_ruling", decl_name: "flex_operator_template_v2") },
    })) {
      ServingProvisionRefusedStartSource { cause: _ } => true
      _ => false
    })
    && (match serving_provision_derive(recipe: qwen_with_model(model: ServingModelArtifact {
      source: WeightsNamedUnpinned { weights: "qwen" as NonEmptyStr, quantization: Absent },
      served_model_id: serving_recipe_qwen3_8_27b_nvfp4_ninfer.model.served_model_id,
    })) {
      ServingProvisionRefusedStartSource { cause: _ } => true
      _ => false
    })
}
