module test.claim.serving.butch_serving_retirement_witness

// THE WITNESS FOR THE OPERATOR'S HAND RETIREMENT OF BUTCH'S SERVING STACK -- the first real consumer of
// gunbc.serving.serving_reservation srv14_serving_unit_boot_states, and the control that says butch's DESIRED STATE
// now declares NO serving engine (step 1 of the butch admission program, work item adhoc-fb73153b-838).
//
// WHY IT EXISTS. The operator retired butch's serving engines BY HAND on 2026-11-21, outside the fleet-converge
// route (ruling gunbc.design_ruling::butch_serving_retirement_is_operator_handled_2026_11_21). That ruling records
// WHO retires, never THAT it happened -- the model may only follow the host once the host has been READ. This
// witness is the consumer that makes the operator's before/after host read true by execution: it reads the three
// units the operator's hand retirement reached (strata-pool@a.service, strata-pool@b.service and
// strata-expert-lock.service) and asserts every one is DISABLED at boot, so no converge -- and there is no butch CI
// runner lane, and the host_unit_retirement mode is expressly not the route -- recreates a serving engine.
//
// THE RED CONTROL. On main the boot-state rows do not exist yet, so this module does not resolve and every claim
// below is red; the change that lands them is what turns it green. Within the branch each claim still discriminates
// at a real interface: re-enabling any unit (flipping a row to UnitEnabled), emptying the population, dropping the
// provenance that ties a row to the operator's read, or widening the boot-state set onto another host, each reds a
// specific claim below -- not by counting prose, but by deciding a value over the rows the operator read.
//
// WHAT IT DELIBERATELY DOES NOT CLAIM. It does NOT carry the 192 GiB release itself: the reservation row, the
// two engine rows and the two-trigger retirement frontier were DISCHARGED on 2026-11-24 (both triggers landed;
// the operator ruled the release, gunbc.design_ruling::
// srv14_serving_memory_charge_retirement_operator_approved_2026_11_24). The discharged numbers are pinned by
// test.claim.serving.serving_reservation_witness and test.claim.runner.srv14_runner_capacity_witness; this
// unit's claims ride on the BOOT STATES alone.
//
// Run (this witness runs alone):
//   claim_batch --hermetic --source-root dag --source-root src/v2 \
//     --entry dag/test/claim/serving/butch_serving_retirement_witness.dag \
//     --functions <the test fn names, comma-joined>
import std.types { Bool }
import std.algebra { string_contains }
import std.optional { Present, Absent }
import gunbc.fleet.fleet_host_identity { operator_host_srv14 }
import extdeps.systemd.systemctl { UnitFileState, UnitEnabled, UnitDisabled }
import gunbc.serving.serving_reservation {
  srv14_serving_unit_boot_states, serving_unit_boot_states_on,
}

// The systemd carrier's own value domain decides it: UnitFileState is the single authority for a unit's file state
// (gunbc.design_argument::single_authority -- the witness does NOT re-invent a two-arm enum). A retired unit reads
// UnitDisabled; any other arm (e.g. the model left declaring UnitEnabled) fails here rather than widening silently.
fn is_unit_disabled(s: UnitFileState) -> Bool {
  match s {
    UnitDisabled => true
    _ => false
  }
}

// THE RED CONTROL: SRV14'S DESIRED UNITS CONTAIN NO SERVING ENGINE. Every boot-state the model holds for butch
// reads UnitDisabled, AND the population really covers the pool engines the operator disabled (so an empty or gutted
// set cannot pass by saying nothing). Discriminating reds: any row whose unit_file_state is not UnitDisabled (an
// engine still declared at boot), or the set emptied so no strata-pool@ engine is represented at all.
test fn butch_desired_state_declares_no_serving_engine() -> Bool {
  let on_butch = serving_unit_boot_states_on(host: operator_host_srv14)
  length(on_butch) == 3
    && all(on_butch, u => is_unit_disabled(u.unit_file_state))
    && any(on_butch, u => string_contains(s: u.unit, pattern: "strata-pool@a.service"))
    && any(on_butch, u => string_contains(s: u.unit, pattern: "strata-pool@b.service"))
    && any(on_butch, u => string_contains(s: u.unit, pattern: "strata-expert-lock.service"))
}

// THE RECEIPT IS A TYPED HOST READ, NOT THE RULING ROW. Each row's provenance is the typed ServingUnitRetirementRead
// -- reader, date, prior file state -- and the witness reads those FIELDS, not a substring of prose
// (gunbc.design_argument::source_annotations). Every row was read by the operator on 2026-11-21 and reads
// UnitDisabled; the two pool instances read UnitEnabled before the hand action (that is the before/after that makes
// this a host read the ruling alone cannot be), and strata-expert-lock's prior state was not recorded -- Absent, not
// guessed. Discriminating reds: a bare assertion (prior state absent where the pools record it), a wrong reader, or
// a wrong date.
test fn every_boot_state_is_a_typed_operator_read() -> Bool {
  let rows = srv14_serving_unit_boot_states
  length(rows) == 3
    && all(rows, u => is_unit_disabled(u.unit_file_state))
    && all(rows, u => (u.read.reader as String) == "operator")
    && all(rows, u => (u.read.read_on as String) == "2026-11-21")
    && all(filter(rows, r => string_contains(s: r.unit, pattern: "strata-pool@")), r =>
      match r.read.prior_unit_file_state {
        Present { value: UnitEnabled } => true
        _ => false
      })
    && any(filter(rows, r => string_contains(s: r.unit, pattern: "strata-expert-lock")), r =>
      match r.read.prior_unit_file_state {
        Absent => true
        _ => false
      })
}

// THE CHARGE RELEASE LEFT THE UNITS RETIRED. Step 1 retired the UNITS; the quiescent peer re-read (run
// 45321352046) and the operator's 2026-11-24 ruling then released the 192 GiB charge with them -- the
// reservation row, the two engine rows and the retirement frontier are gone and host_memory_reserved(srv14)
// reads Present(0). The DISCHARGED NUMBERS are pinned by test.claim.serving.serving_reservation_witness and
// test.claim.runner.srv14_runner_capacity_witness; this unit keeps its hands on the BOOT STATES. Discriminating
// red: a unit returning to UnitEnabled while the model charges srv14 nothing would mean serving is back on a
// host the build pool now owns -- this claim goes red while the charge witness stays green, exactly the drift
// this pair must catch.
test fn the_charge_release_left_the_units_retired() -> Bool {
  all(srv14_serving_unit_boot_states, u => is_unit_disabled(u.unit_file_state))
    && length(srv14_serving_unit_boot_states) == 4
}

// THE BOOT-STATE SET IS SCOPED TO BUTCH ALONE. This is a boot-enable reading of butch's units, not a fleet-wide
// claim: a row leaking onto another host (a fabricated host, or a copy-paste) would make the model assert a boot
// state it never read there. Discriminating red: any row whose host is not srv14 empties nothing here but breaks
// the scoping, so the whole population must resolve through the srv14 lookup.
test fn the_boot_states_are_butch_only() -> Bool {
  length(srv14_serving_unit_boot_states) == length(serving_unit_boot_states_on(host: operator_host_srv14))
    && length(srv14_serving_unit_boot_states) > 0
}
