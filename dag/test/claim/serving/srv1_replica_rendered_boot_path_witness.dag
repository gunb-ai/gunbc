// ── the capture ─────────────────────────────────────────────────────────────────────────────────────
//
// Run identity for every value below: srv1, `docker inspect -f '{{json .Config.Cmd}}' lil-flash-next` and
// `... lil-flash-next-1`, taken read-only before any change to the unit, the helper or either container — on
// 2026-11-09 for every field except the KV tier and the container's memory trio, and RE-BASED on 2026-11-24
// for those, from the bytes the host had installed (the launcher and both args files, digested below). Both
// containers report the same shape; the per-replica fields (card, name, published port, host directories)
// differ by the roster rows. What the 2026-11-09 capture read for the fields that moved: `LMCACHE_L1_GB=12`,
// `L1 12G` in the START line, `--memory=32g --memory-swap=32g --shm-size 16g`. Those figures are the ones
// class B4 refuses to render today, and they are kept in this comment rather than deleted so the red control
// below has a named original to be the same configuration as.

// The engine argv as the running container ran it, one token per line: the same token sequence the captured
// `-lc` string carries after `exec`, with `$D` expanded to its value on that line (`D=/root/serve`), and
// with the bearer-key slot REMOVED -- the two tokens `--api-key` and `"$(cat /root/.pool_key)"`. That
// removal is the switch's security content, so it is the one difference the positive control excuses by
// name rather than by silence.
data golden_engine_argv: String =
  "/usr/local/bin/lil-serve\n--profile\nqwen38-flash-next\n--hardware\nrtx-pro-6000-pcie\n--env\nLMCACHE_MODE=ram-disk\n--env\nLMCACHE_L1_GB=48\n--env\nLMCACHE_L2_GB=125\n--env\nLMCACHE_L2_ROOT=/cache/kv\n--env\nLMCACHE_L2_WORKERS=16\n--env\nLMCACHE_L2_ODIRECT=1\n--env\nLMCACHE_CHECKPOINT_PROTECTED_SHARE=0.5\n--env\nLMCACHE_CHECKPOINT_PROTECTION_WINDOW_SECONDS=1800\n--\n--port\n18000\n--ssl-keyfile\n/root/serve/tls.key\n--ssl-certfile\n/root/serve/tls.crt\n--max-model-len\n229376\n"

// The container command's first line, verbatim from the capture: the serve directory and the event logger.
// The `$D`, `$*` and `$(...)` spellings are the CONTAINER-side shell's, kept exactly as captured -- they are
// what `docker inspect` reports, so a render that "cleaned them up" would be a render that stopped matching
// the thing it claims to produce.
data golden_command_logger_line: String =
  "D=/root/serve; ev(){ echo \"$(date -u +%FT%TZ) $*\" >> $D/events.log; }"

// The TLS guard line, verbatim -- including the three spaces before `-days`, a line-continuation artifact of
// the operator's script. Kept because a control that normalizes whitespace is a control that can wave
// through a real difference.
data golden_command_tls_line: String =
  "[ -s $D/tls.key ] && [ -s $D/tls.crt ] || openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes   -days 3650 -subj /CN=pool-card -keyout $D/tls.key -out $D/tls.crt >> $D/events.log 2>&1"

// The START event line as the running container reported it. Written here for replica 0; the claim derives
// replica 1's by the same substitution, so a wrong card on either replica is caught, not assumed away.
data golden_start_line_gpu0: String =
  "ev \"START srv1 gpu0 GPU-7b58568e-8bc9-4e4b-bc6c-c414b08936c3 (driver $(nvidia-smi --query-gpu=driver_version --format=csv,noheader), TP1, cache ram-disk, L1 48G, L2 125G, disk-first, TLS)\""

data golden_start_line_gpu1: String =
  "ev \"START srv1 gpu1 GPU-96b749dc-e2ea-5b6f-2e45-ee868b1a9750 (driver $(nvidia-smi --query-gpu=driver_version --format=csv,noheader), TP1, cache ram-disk, L1 48G, L2 125G, disk-first, TLS)\""

// ── positive controls ───────────────────────────────────────────────────────────────────────────────

// THE POSITIVE CONTROL. The args file the boot path mounts is, token for token, the engine command the
// running replica executed -- minus the bearer key, which no longer travels in argv at all. If this goes
// red, the render does not describe what is serving, and the switch must not happen.
// WHAT A RENDER ANSWERS, AND WHAT EVERY CONTROL BELOW READS.
//
// Both renders answer Accepted (the lines, with any diagnostics the emitter carried) or
// Rejected (the reason nothing was rendered). Every control reads the Accepted arm through
// these rows, and every control that reads one also NAMES the arm it read — the
// `render_answered` conjunct. That conjunct is not decoration: a control that read a
// Rejected arm as an empty list would go green on a refusal, and "this line is absent" and
// "this statement was refused" are different facts. The witness used to be unable to tell
// them apart because the render could not refuse; now it can, and the controls have to say
// which answer they are looking at.
fn render_answered(render: Outcome<List<String>>) -> Bool {
  match render {
    Accepted { value: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn render_answered_text(render: Outcome<String>) -> Bool {
  match render {
    Accepted { value: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

// The Accepted arm's lines, for the controls that compare bytes. Read it only under
// `render_answered`, which is what makes a refusal fail instead of quietly matching an
// absence.
fn render_lines(render: Outcome<List<String>>) -> List<String> {
  match render {
    Accepted { value: lines } => lines
    Rejected { diagnostics: _ } => [] as List<String>
  }
}

fn render_text(render: Outcome<String>) -> String {
  match render {
    Accepted { value: bytes } => bytes
    Rejected { diagnostics: _ } => ""
  }
}

test fn the_rendered_engine_argv_is_the_captured_container_command() -> Bool {
  render_text(srv1_render_replica_engine_args()) == golden_engine_argv
}

// The container command still sets up its serve directory, its event log and its TLS guard exactly as the
// running container does. These three lines are the whole of what the container itself does before exec'ing
// the engine, so pinning them pins the boot behaviour that the crash and cold-start tests then exercise.
// THE CONTAINER COMMAND HEAD, LINE FOR LINE. Executed on 2026-11-09 the first rendered container exited 2
// within a second: the START line had gained a trailing `)` from being CONCATENATED with the args-file guard,
// and every control on that line asked whether the captured line appeared INSIDE it -- a question a line made
// of the captured line plus one extra token answers yes. So this control compares LINES: a captured line must
// occur as a whole line of the render, and the START line must be the only one of its kind.
test fn the_container_command_head_is_the_captured_command() -> Bool {
  let render_answer_24 = srv1_replica_container_command_lines(replica: srv1_replica_0, config: srv1_admitted_launch_config)
  let l0 = render_lines(render_answer_24)
  let render_answer_23 = srv1_replica_container_command_lines(replica: srv1_replica_1, config: srv1_admitted_launch_config)
  let l1 = render_lines(render_answer_23)
  let logger0 = filter(l0, x => x == golden_command_logger_line)
  let logger1 = filter(l1, x => x == golden_command_logger_line)
  let tls0 = filter(l0, x => x == golden_command_tls_line)
  let tls1 = filter(l1, x => x == golden_command_tls_line)
  let start0 = filter(l0, x => string_contains(s: x, pattern: "ev \"START srv1"))
  let start1 = filter(l1, x => string_contains(s: x, pattern: "ev \"START srv1"))
render_answered(render_answer_24) && render_answered(render_answer_23) && (
  length(logger0) == 1 && length(logger1) == 1
    && length(tls0) == 1 && length(tls1) == 1
    && length(start0) == 1 && length(start1) == 1
    && string_concat_join(start0, "") == golden_start_line_gpu0
    && string_concat_join(start1, "") == golden_start_line_gpu1
    && !string_contains(s: string_concat_join(start0, ""), pattern: "TLS)\";")
    && !string_contains(s: string_concat_join(start1, ""), pattern: "TLS)\";")
  )}

// THE ARGS-FILE REFUSAL IS ITS OWN LINE, spelled exactly. It exists so a replica whose rendered argv file did
// not install refuses instead of starting an engine with an empty argv; gluing it to another line made it
// untestable, which is the bug above.
data golden_args_guard_line: String =
  "[ -s /root/engine.args ] || { ev \"FATAL rendered engine argv file missing: /root/engine.args\"; exit 3; }"

test fn the_args_file_refusal_is_a_line_of_the_container_command() -> Bool {
  let render_answer_22 = srv1_replica_container_command_lines(replica: srv1_replica_0, config: srv1_admitted_launch_config)
  let l0 = render_lines(render_answer_22)
  let render_answer_21 = srv1_replica_container_command_lines(replica: srv1_replica_1, config: srv1_admitted_launch_config)
  let l1 = render_lines(render_answer_21)
render_answered(render_answer_22) && render_answered(render_answer_21) && (
  length(filter(l0, x => x == golden_args_guard_line)) == 1
    && length(filter(l1, x => x == golden_args_guard_line)) == 1
    && length(filter(l0, x => string_contains(s: x, pattern: "mapfile -t ENGINE_ARGS < /root/engine.args"))) == 1
    && length(filter(l0, x => string_contains(s: x, pattern: "exec \"$\{ENGINE_ARGS[@]}\""))) == 1
  )}


// THE TWO DOCUMENTED DIFFERENCES, asserted rather than described. The engine is exec'd from the mounted args
// file (so the inline flag list is gone), and the bearer key is gone from every artifact the host can read.
// A claim that the render "has no key" is worth nothing unless it also fails to find the OLD route: the
// captured command did contain `--api-key "$(cat /root/.pool_key)"`, and its absence here is the point.
test fn the_bearer_key_left_argv_and_the_render_carries_only_a_reference() -> Bool {
  let render_answer_20 = srv1_replica_container_command_lines(replica: srv1_replica_0, config: srv1_admitted_launch_config)
  let cmd0 = string_concat_join(render_lines(render_answer_20), "\n")
  let render_answer_19 = srv1_replica_docker_argv(replica: srv1_replica_0, config: srv1_admitted_launch_config)
  let docker0 = string_concat_join(render_lines(render_answer_19), " ")
  let render_answer_18 = srv1_render_replica_launcher()
  let launcher = render_text(render_answer_18)
  let no_key_flag = !string_contains(s: cmd0, pattern: "--api-key")
    && !string_contains(s: docker0, pattern: "--api-key")
    && !string_contains(s: launcher, pattern: "--api-key")
  let no_command_substitution_read = !string_contains(s: cmd0, pattern: "$(cat")
    && !string_contains(s: docker0, pattern: "$(cat")
    && !string_contains(s: launcher, pattern: "$(cat")
  let engine_comes_from_the_file = string_contains(s: cmd0, pattern: "mapfile -t ENGINE_ARGS < /root/engine.args")
    && string_contains(s: cmd0, pattern: "exec \"$\{ENGINE_ARGS[@]}\" >> $D/serve.log 2>&1")
  // The key's only route is the engine's own environment, read from a host file this module names but never
  // fills. env_name is VLLM_API_KEY because that is the name the engine's own env table defines.
  let key_route_is_a_reference = string_contains(s: docker0, pattern: "--env-file /home/briansrls/lil/replica.env")
    && (srv1_admitted_launch_config.api_key_reference.env_name as String) == "VLLM_API_KEY"
render_answered(render_answer_20) && render_answered(render_answer_19) && render_answered_text(render_answer_18) && (
  no_key_flag && no_command_substitution_read && engine_comes_from_the_file && key_route_is_a_reference
  )}

// THE CONTAINER SHAPE, token by token, against what `docker inspect` reported. The flags are the retained
// launcher's own spellings, so this is a comparison of like with like; `--env-file` and the args mount are
// the two additions the switch makes, and they are pinned here too rather than waved through as "additive".
test fn the_docker_command_is_the_observed_container_shape() -> Bool {
  let render_answer_17 = srv1_replica_docker_argv(replica: srv1_replica_0, config: srv1_admitted_launch_config)
  let argv0 = string_concat_join(render_lines(render_answer_17), " ")
  let render_answer_16 = srv1_replica_docker_argv(replica: srv1_replica_1, config: srv1_admitted_launch_config)
  let argv1 = string_concat_join(render_lines(render_answer_16), " ")
  let per_replica = string_contains(s: argv0, pattern: "--name lil-flash-next ")
    && string_contains(s: argv1, pattern: "--name lil-flash-next-1 ")
    && string_contains(s: argv0, pattern: "--device nvidia.com/gpu=GPU-7b58568e-8bc9-4e4b-bc6c-c414b08936c3")
    && string_contains(s: argv1, pattern: "--device nvidia.com/gpu=GPU-96b749dc-e2ea-5b6f-2e45-ee868b1a9750")
    && string_contains(s: argv0, pattern: "-p 18000:18000")
    && string_contains(s: argv1, pattern: "-p 18001:18000")
    && string_contains(s: argv0, pattern: "-v /home/briansrls/lil/kv:/cache/kv")
    && string_contains(s: argv1, pattern: "-v /home/briansrls/lil/kv-gpu1:/cache/kv")
    && string_contains(s: argv0, pattern: "-v /home/briansrls/lil/serve:/root/serve")
    && string_contains(s: argv1, pattern: "-v /home/briansrls/lil/serve-gpu1:/root/serve")
  let shared_shape = string_contains(s: argv0, pattern: "--restart no")
    && string_contains(s: argv0, pattern: "--cgroup-parent=srv1-inference.slice")
    && string_contains(s: argv0, pattern: "--memory=72g")
    && string_contains(s: argv0, pattern: "--memory-swap=72g")
    && string_contains(s: argv0, pattern: "--shm-size 56g")
    && string_contains(s: argv0, pattern: "-e PORT=18000")
    && string_contains(s: argv0, pattern: "-e HF_HOME=/root/.cache/huggingface")
    && string_contains(s: argv0, pattern: "-v /home/briansrls/lil/hf:/root/.cache/huggingface")
    && string_contains(s: argv0, pattern: "-v /home/briansrls/lil/jit:/cache/jit")
    && string_contains(s: argv0, pattern: "-v /home/briansrls/lil/pool_key:/root/.pool_key:ro")
    && string_contains(s: argv0, pattern: "--entrypoint bash")
    && string_contains(s: argv0, pattern: "sha256:2ad6245e058de7b4d0b973b08d60f67b18f563e4bd63d6a0e9b0406222a098e9")
    && string_contains(s: argv0, pattern: "-lc ")
  // The sixth mount is the new one, and it is per-replica: a shared args file would let one replica serve
  // another replica's configuration after a partial re-render.
  let args_mounted = string_contains(s: argv0, pattern: "-v /usr/local/etc/lil-replica/replica-0.args:/root/engine.args:ro")
    && string_contains(s: argv1, pattern: "-v /usr/local/etc/lil-replica/replica-1.args:/root/engine.args:ro")
    && (srv1_replica_engine_args_host_path(replica: srv1_replica_0) as String) == "/usr/local/etc/lil-replica/replica-0.args"
  // Arity is pinned so a silently dropped flag cannot pass the containment checks above: 16 identity and
  // budget tokens (docker, run, -d as THREE argv elements -- an argv element is one word, so the row does not
  // glue the invocation together any more, and each element reaches the launcher's docker-run statement as one
  // word through a checked word builder -- plus --name + value, --restart + value, --device + selector, the
  // cgroup/memory/swap trio, --shm-size + value, --env-file + value), 6 published (-p + mapping, two -e pairs),
  // 12 mount tokens (six -v flags and their six values), and 5 entrypoint/image/-lc tokens with the one joined
  // command string -- 39 elements, each one word of the command the arm runs.
  let render_answer_15 = srv1_replica_docker_argv(replica: srv1_replica_0, config: srv1_admitted_launch_config)
  let arity = length(xs: render_lines(render_answer_15)) == 39
  // The launcher passes the index and nothing else; the command line itself carries no host variable that an
  // empty environment could silently blank out. That is the `$EXTRA` class of defect, closed structurally.
  let no_unbound_variables = !string_contains(s: argv0, pattern: "$EXTRA")
    && !string_contains(s: argv0, pattern: "$NAME")
    && !string_contains(s: argv0, pattern: "$GPU")
render_answered(render_answer_17) && render_answered(render_answer_16) && render_answered(render_answer_15) && (
  per_replica && shared_shape && args_mounted && arity && no_unbound_variables
  )}

// THE LAUNCHER REFUSES. Each refusal is the reason a boot path silently serving the wrong thing stops being
// possible: an unknown index, an absent or empty args file, an absent key file, and a key file whose mode
// anyone could have written. The removal loop is here too because its absence would turn every crash
// restart into a name conflict -- the failure the operator hit on 2026-11-08.
test fn the_launcher_refuses_stale_inputs_and_keeps_the_removal_race_ahead_of_the_run() -> Bool {
  let render_answer_14 = srv1_render_replica_launcher()
  let l = render_text(render_answer_14)
  let refuses = string_contains(s: l, pattern: "unknown replica index")
    && string_contains(s: l, pattern: "rendered engine argv $ARGS is missing or empty")
    && string_contains(s: l, pattern: "engine key env file $ENV_FILE is missing or empty")
    && string_contains(s: l, pattern: "must be mode 0600")
  let races_ahead = string_contains(s: l, pattern: "for i in $(seq 1 150); do docker container inspect lil-flash-next")
    && string_contains(s: l, pattern: "for i in $(seq 1 150); do docker container inspect lil-flash-next-1")
  let discipline = string_contains(s: l, pattern: "set -u")
    && string_contains(s: l, pattern: "ARGS_DIR=/usr/local/etc/lil-replica")
    && string_contains(s: l, pattern: "ENV_FILE=/home/briansrls/lil/replica.env")
    && string_contains(s: l, pattern: "KNOWN_INDEXES=\"0 1\"")
  // What must NOT be in the installed file: the old launcher's path (it stays on the host as the restore
  // path, referenced only in comments), an unbound extra-args channel, or a bare command name resolved
  // through $PATH -- the engine is addressed absolutely, as it is on the host.
  let clean = !string_contains(s: l, pattern: "$EXTRA")
    && !string_contains(s: l, pattern: "exec /usr/local/bin/lil-serve")
    && string_contains(s: l, pattern: "srv1_lil_serve_gpu.sh stays on")
    && string_contains(s: l, pattern: "/usr/local/etc/lil-replica/replica-0.args")
render_answered_text(render_answer_14) && (
  refuses && races_ahead && discipline && clean
  )}

// The launcher is one file for both replicas and dispatches on the index systemd passes as %i, so the arms
// must exist for exactly the roster and nothing else.
test fn the_launcher_has_one_arm_per_roster_row_and_none_other() -> Bool {
  let render_answer_13 = srv1_render_replica_launcher()
  let l = render_text(render_answer_13)
render_answered_text(render_answer_13) && (
  length(xs: srv1_serving_replica_roster) == 2
    && string_contains(s: l, pattern: "case $IDX in")
    && string_contains(s: l, pattern: "  0)\n")
    && string_contains(s: l, pattern: "  1)\n")
    && !string_contains(s: l, pattern: "  2)")
  )}

// ── red controls ────────────────────────────────────────────────────────────────────────────────────
//
// Each control changes exactly ONE field and requires the render to change. Together they are the evidence
// that the typed fields are load-bearing: a field the render ignores would let the .dag describe a
// configuration the container does not run, which is the same defect the retained launcher had, only
// tidier. The builder below is the only place a control may reach the config, and it takes every field
// except the two that no control varies (profile and hardware, both pinned by the positive control above).

fn cfg_over(
  l2: Srv1LmCacheL2Placement,
  retention: Srv1CheckpointRetentionPolicy,
  tls: Srv1TlsMaterial,
  key: Srv1ApiKeyReference,
  exe: FilePath,
  port: Port,
  model_len: Nat,
  l1: ByteSize
) -> Srv1LaunchConfig {
  let a = srv1_admitted_launch_config
  Srv1LaunchConfig {
    tensor_parallel_size: a.tensor_parallel_size,
    kv_cache_dtype: a.kv_cache_dtype,
    profile: a.profile,
    hardware: a.hardware,
    lmcache_l1: l1,
    max_model_len: model_len,
    image_digest: a.image_digest,
    lil_replicas: a.lil_replicas,
    host_gpu_p2p: a.host_gpu_p2p,
    engine_executable: exe,
    lmcache_l2_placement: l2,
    checkpoint_retention: retention,
    tls_material: tls,
    api_key_reference: key,
    container_port: port,
  }
}

fn cfg_admitted() -> Srv1LaunchConfig {
  let a = srv1_admitted_launch_config
  cfg_over(
    l2: a.lmcache_l2_placement,
    retention: a.checkpoint_retention,
    tls: a.tls_material,
    key: a.api_key_reference,
    exe: a.engine_executable,
    port: a.container_port,
    model_len: a.max_model_len,
    l1: a.lmcache_l1
  )
}

// Every typed engine field, one at a time. The `&&` chain names each field next to its control, so a field
// that stops discriminating points at itself by which conjunct goes red.
test fn dropping_or_changing_any_single_engine_field_changes_the_render() -> Bool {
  let a = srv1_admitted_launch_config
  let base = render_text(srv1_replica_engine_args_body(config: cfg_admitted()))
  let r_l2_root = render_text(srv1_replica_engine_args_body(config: cfg_over(
    l2: Srv1LmCacheL2Placement { root: "/cache/other" as FilePath, workers: a.lmcache_l2_placement.workers, uses_direct_io: a.lmcache_l2_placement.uses_direct_io },
    retention: a.checkpoint_retention, tls: a.tls_material, key: a.api_key_reference, exe: a.engine_executable,
    port: a.container_port, model_len: a.max_model_len, l1: a.lmcache_l1)))
  let r_l2_workers = render_text(srv1_replica_engine_args_body(config: cfg_over(
    l2: Srv1LmCacheL2Placement { root: a.lmcache_l2_placement.root, workers: 8, uses_direct_io: a.lmcache_l2_placement.uses_direct_io },
    retention: a.checkpoint_retention, tls: a.tls_material, key: a.api_key_reference, exe: a.engine_executable,
    port: a.container_port, model_len: a.max_model_len, l1: a.lmcache_l1)))
  let r_l2_direct = render_text(srv1_replica_engine_args_body(config: cfg_over(
    l2: Srv1LmCacheL2Placement { root: a.lmcache_l2_placement.root, workers: a.lmcache_l2_placement.workers, uses_direct_io: false },
    retention: a.checkpoint_retention, tls: a.tls_material, key: a.api_key_reference, exe: a.engine_executable,
    port: a.container_port, model_len: a.max_model_len, l1: a.lmcache_l1)))
  let r_share = render_text(srv1_replica_engine_args_body(config: cfg_over(
    l2: a.lmcache_l2_placement,
    retention: Srv1CheckpointRetentionPolicy { protected_share: basis_point(count: 2500), protection_window: a.checkpoint_retention.protection_window },
    tls: a.tls_material, key: a.api_key_reference, exe: a.engine_executable,
    port: a.container_port, model_len: a.max_model_len, l1: a.lmcache_l1)))
  let r_window = render_text(srv1_replica_engine_args_body(config: cfg_over(
    l2: a.lmcache_l2_placement,
    retention: Srv1CheckpointRetentionPolicy { protected_share: a.checkpoint_retention.protected_share, protection_window: second(count: 900) },
    tls: a.tls_material, key: a.api_key_reference, exe: a.engine_executable,
    port: a.container_port, model_len: a.max_model_len, l1: a.lmcache_l1)))
  let r_tls_dir = render_text(srv1_replica_engine_args_body(config: cfg_over(
    l2: a.lmcache_l2_placement, retention: a.checkpoint_retention,
    tls: Srv1TlsMaterial { container_dir: "/root/other" as FilePath, key_path: a.tls_material.key_path, cert_path: a.tls_material.cert_path },
    key: a.api_key_reference, exe: a.engine_executable,
    port: a.container_port, model_len: a.max_model_len, l1: a.lmcache_l1)))
  let r_tls_key = render_text(srv1_replica_engine_args_body(config: cfg_over(
    l2: a.lmcache_l2_placement, retention: a.checkpoint_retention,
    tls: Srv1TlsMaterial { container_dir: a.tls_material.container_dir, key_path: "other.key" as FilePath, cert_path: a.tls_material.cert_path },
    key: a.api_key_reference, exe: a.engine_executable,
    port: a.container_port, model_len: a.max_model_len, l1: a.lmcache_l1)))
  let r_tls_cert = render_text(srv1_replica_engine_args_body(config: cfg_over(
    l2: a.lmcache_l2_placement, retention: a.checkpoint_retention,
    tls: Srv1TlsMaterial { container_dir: a.tls_material.container_dir, key_path: a.tls_material.key_path, cert_path: "other.crt" as FilePath },
    key: a.api_key_reference, exe: a.engine_executable,
    port: a.container_port, model_len: a.max_model_len, l1: a.lmcache_l1)))
  let r_exe = render_text(srv1_replica_engine_args_body(config: cfg_over(
    l2: a.lmcache_l2_placement, retention: a.checkpoint_retention, tls: a.tls_material, key: a.api_key_reference,
    exe: "lil-serve" as FilePath,
    port: a.container_port, model_len: a.max_model_len, l1: a.lmcache_l1)))
  let r_port = render_text(srv1_replica_engine_args_body(config: cfg_over(
    l2: a.lmcache_l2_placement, retention: a.checkpoint_retention, tls: a.tls_material, key: a.api_key_reference,
    exe: a.engine_executable, port: 18100, model_len: a.max_model_len, l1: a.lmcache_l1)))
  let r_len = render_text(srv1_replica_engine_args_body(config: cfg_over(
    l2: a.lmcache_l2_placement, retention: a.checkpoint_retention, tls: a.tls_material, key: a.api_key_reference,
    exe: a.engine_executable, port: a.container_port, model_len: 131072, l1: a.lmcache_l1)))
  // L1 shows up twice in the boot path -- as the engine's own --env token and in the START line -- and both
  // derive from the one ByteSize field, so halving it must move the engine render too.
  let r_l1 = render_text(srv1_replica_engine_args_body(config: cfg_over(
    l2: a.lmcache_l2_placement, retention: a.checkpoint_retention, tls: a.tls_material, key: a.api_key_reference,
    exe: a.engine_executable, port: a.container_port, model_len: a.max_model_len,
    l1: gibibyte_to_byte_size(g: gibibyte(count: 6)))))
  concat(base, "\n") == golden_engine_argv
    && r_l2_root != base && r_l2_workers != base && r_l2_direct != base
    && r_share != base && r_window != base
    && r_tls_dir != base && r_tls_key != base && r_tls_cert != base
    && r_exe != base && r_port != base && r_len != base
    && r_l1 != base
}

// The two ways the retention policy's share reaches the wire, pinned as boundary encodings rather than as
// strings someone could edit into agreement: 5000 basis points is "0.5" and 2500 is "0.25", and the engine
// token is that encoding with the flag prefix -- no hand-typed decimal anywhere in the render.
test fn the_retention_policy_reaches_the_engine_as_a_typed_boundary_encoding() -> Bool {
  let a = srv1_admitted_launch_config
  let admitted_share = fixed_point_trimmed_wire(value: basis_point_count(bp: a.checkpoint_retention.protected_share) as Int, decimals: 4)
  let half_share = fixed_point_trimmed_wire(value: 2500 as Int, decimals: 4)
  let window = to_string(second_count(s: a.checkpoint_retention.protection_window))
  admitted_share == "0.5" && half_share == "0.25" && window == "1800"
    && string_contains(s: render_text(srv1_render_replica_engine_args()), pattern: concat(lil_serve_environment_key_checkpoint_protected_share as String, concat("=", admitted_share)))
    && string_contains(s: render_text(srv1_render_replica_engine_args()), pattern: concat("LMCACHE_CHECKPOINT_PROTECTION_WINDOW_SECONDS=", window))
}

// The container-side fields the shape rows own. Changing any one of them must move the docker command --
// these are the fields whose absence fails quietly (a container outside its slice, a 64 MiB /dev/shm, a
// second restart owner), so a control that did not discriminate on them would leave the quiet failures
// exactly where they were.
test fn changing_any_single_container_shape_field_changes_the_docker_command() -> Bool {
  let s = srv1_replica_container_run_shape
  let a = srv1_admitted_launch_config
  let render_answer_12 = srv1_replica_docker_argv(replica: srv1_replica_0, config: a)
  let base = string_concat_join(render_lines(render_answer_12), " ")
  let over_cgroup = string_contains(s: base, pattern: "--cgroup-parent=srv1-inference.slice")
    && s.cgroup_parent as String == "srv1-inference.slice"
  let over_shm = string_contains(s: base, pattern: "--shm-size 56g")
  let over_restart = string_contains(s: base, pattern: "--restart no") && s.restart_policy as String == "no"
  let over_entry = string_contains(s: base, pattern: "--entrypoint bash") && s.entrypoint as String == "bash"
  let over_args_path = string_contains(s: base, pattern: ":/root/engine.args:ro")
    && s.engine_args_container_path as String == "/root/engine.args"
  let over_pool_key = string_contains(s: base, pattern: ":/root/.pool_key:ro")
    && s.pool_key_container_path as String == "/root/.pool_key"
  // The TLS mint parameters are in the container command, not in the shape's docker flags: a certificate the
  // router's pinned CA would reject is a boot-path failure, so these three are pinned where they appear.
  let render_answer_11 = srv1_replica_container_command_lines(replica: srv1_replica_0, config: a)
  let cmd = string_concat_join(render_lines(render_answer_11), "\n")
  let over_tls = string_contains(s: cmd, pattern: "ec_paramgen_curve:prime256v1")
    && string_contains(s: cmd, pattern: "-days 3650")
    && string_contains(s: cmd, pattern: "-subj /CN=pool-card")
    && s.tls_curve as String == "prime256v1" && second_count(s.tls_validity) == 3650 * seconds_per_day() && srv1_tls_validity_days_for_flag() == 3650
    && (s.tls_subject_common_name as String) == "pool-card"
render_answered(render_answer_12) && render_answered(render_answer_11) && (
  over_cgroup && over_shm && over_restart && over_entry && over_args_path && over_pool_key && over_tls
  )}

// THE CHANNEL THE INSTALL USES IS A PRINTED STRING, so the render must be printable without ambiguity. The
// installed bytes are produced by asking gunbc to print the render and redirecting that output into a file;
// if a rendered byte could be confused with the channel's own delimiters, the installed file would silently
// differ from the render, which is the exact failure this switch is meant to close. Newlines and backticks are
// therefore excluded by claim, not by inspection: a future row that puts either in the launcher or the args
// file goes red here instead of installing a corrupted boot path.
test fn the_render_survives_the_printed_channel_that_installs_it() -> Bool {
  let render_answer_10 = srv1_render_replica_launcher()
  let l = render_text(render_answer_10)
  let a = render_text(srv1_render_replica_engine_args())
render_answered_text(render_answer_10) && (
  !string_contains(s: l, pattern: "`")
    && !string_contains(s: a, pattern: "`")
    && string_contains(s: l, pattern: "\n")
    && string_contains(s: a, pattern: "\n")
  )}

// THE REFUSALS PRECEDE THE LAUNCHES. A guard rendered after the `case` still exits non-zero, but only after
// `docker run` has started a container on inputs it was supposed to refuse -- leaving a stale container and a
// unit that reports a start. The bytes before the first `docker run` must therefore already contain every
// refusal the launcher makes.
test fn the_launcher_refuses_before_it_touches_docker() -> Bool {
  let render_answer_9 = srv1_render_replica_launcher()
  let l = render_text(render_answer_9)
  // The refusal block is IMMEDIATELY FOLLOWED BY the case, and nothing that talks to docker sits between
  // them. Inside an arm the removal poll does come before its `docker run`, which is correct and is not
  // what this pins: what must never happen is a guard that only fires after a container was started.
render_answered_text(render_answer_9) && (
  string_contains(s: l, pattern: "exit 3; }\n[ -s \"$ENV_FILE\" ]")
    && string_contains(s: l, pattern: "must be mode 0600\" >&2; exit 5; }\nKNOWN_INDEXES=")
    && string_contains(s: l, pattern: "\ncase $IDX in\n")
    && !string_contains(s: l, pattern: "esac\n[ -s \"$ARGS\" ]")
    && !string_contains(s: l, pattern: "esac\n[ \"$(stat")
  )}

// THE HELPER IS THE RETAINED HELPER, MODULO THE THREE LINES THAT HAVE TO CHANGE. The unit is Type=simple and
// Restart=on-failure, so the restart semantics the operator is relying on come from the helper blocking on
// `docker wait` and exiting with the container's status -- the render may not quietly drop that while it is
// repointing LAUNCH=. Comparing line LISTS (not substrings) is what makes "only these lines changed" a fact
// rather than an impression: adding, dropping or editing any other line fails this.
test fn the_helper_render_is_the_retained_helper_except_where_it_must_change() -> Bool {
  let golden = filter(split(s: srv1_replica_helper.body, delimiter: "\n"), l =>
    !any(srv1_replica_helper_retired_lines, r => r == l) && l != "")
  let rendered = filter(split(s: srv1_render_replica_helper(), delimiter: "\n"), l =>
    !any(srv1_replica_helper_replacement_lines, r => r == l) && l != "")
  golden == rendered
    && length(xs: srv1_replica_helper_retired_lines) == 4
    && length(xs: srv1_replica_helper_replacement_lines) == 5
}

// THE HALF THE LAUNCHER CANNOT DO. A detached `docker run -d` returns 0, which under Restart=on-failure means
// "clean exit, do not restart" -- a crash test would show a unit that never came back and every crash would
// look like a shutdown. These lines are why the helper exists; they must survive the render verbatim.
test fn the_helper_keeps_adoption_the_wait_and_the_graceful_stop() -> Bool {
  let h = srv1_render_replica_helper()
  string_contains(s: h, pattern: "if [ \"$(docker container inspect -f '{{.State.Running}}' \"$NAME\" 2>/dev/null)\" = true ]; then")
    && string_contains(s: h, pattern: "rc=$(docker wait \"$NAME\") || exit 1")
    && string_contains(s: h, pattern: "echo \"$NAME exited with status $rc\"; exit \"$rc\" ;;")
    && string_contains(s: h, pattern: "exec docker stop -t 240 \"$NAME\" ;;")
    && string_contains(s: h, pattern: "\"$LAUNCH\" \"$IDX\" || exit 1")
}

// THE OLD BOOT PATH IS GONE, NOT COMMENTED OUT. The point of the switch is that nothing in the systemd path
// can reach ~/strata-test/srv1_lil_serve_gpu.sh or an $EXTRA any more -- so the helper must not merely stop
// exec'ing it, it must not mention it at all.
test fn the_helper_launches_only_the_rendered_launcher() -> Bool {
  let h = srv1_render_replica_helper()
  string_contains(s: h, pattern: concat("LAUNCH=", srv1_replica_launcher_host_path as String))
    && !string_contains(s: h, pattern: "strata-test")
    && !string_contains(s: h, pattern: "srv1_lil_serve_gpu.sh")
    && !string_contains(s: h, pattern: "EXTRA")
    && !string_contains(s: h, pattern: "$LAUNCH \"$IDX\" $")
}

// ONE NAME TABLE, NOT TWO. The helper used to hand-maintain its own index -> container map, which is a second
// place for a replica to be renamed. It is rendered from the roster, so a roster row is the only source.
test fn the_helper_name_table_comes_from_the_roster() -> Bool {
  let h = srv1_render_replica_helper()
  let line = srv1_replica_helper_name_table_line(replicas: srv1_serving_replica_roster)
  string_contains(s: h, pattern: line)
    && string_contains(s: line, pattern: "case $IDX in 0) NAME=lil-flash-next ;; 1) NAME=lil-flash-next-1 ;;")
    && string_contains(s: line, pattern: "unknown GPU index")
    && all(srv1_serving_replica_roster, r => string_contains(s: line, pattern: concat("NAME=", r.container_name)))
}

// THE RECEIPTS ABOUT THE INSTALL AND THE RUNS ARE THEMSELVES CHECKABLE. Every artifact row must claim the
// digest the interpreter computed and the digest the host read back as the SAME value -- a row that says the
// install succeeded while the two differ cannot be written without failing this. And the executed-runs list
// must not be allowed to overstate: four runs (two cold starts, two crashes), every one inside the readiness
// deadline AS DEFINED on srv1_boot_path_ready_deadline, every crash's replacement container at or after the
// unit's restart delay AS DEFINED on the contract row, and no run may claim the reboot kind, because no reboot
// was run. The bars are read from the rows, not copied: a deadline or a RestartSec that changes moves this
// test, which is the whole point of the closed kind and the typed durations.
test fn the_install_and_run_receipts_hold_their_own_claim() -> Bool {
  // The 2026-11-09 rows are the dated capture the cold-start and crash witnesses cite; the 2026-11-24 rows are
  // what today's render must equal (install_row_digest_matches). Both lists are checked for internal agreement
  // between "what the renderer emitted" and "what the host read back", because a row that claims an install
  // while its two halves differ is the window's own incident written into the model.
  let arts = srv1_installed_boot_path_artifacts_2026_11_09
  let arts_now = srv1_installed_boot_path_artifacts_2026_11_24
  let runs = srv1_boot_path_runs_executed_2026_11_09
  let launcher_digest_answer = srv1_render_replica_launcher_sha256()
  let deadline = srv1_boot_path_ready_deadline_seconds()
  let floor = srv1_boot_path_crash_restart_floor_seconds()
  length(arts) == 4
    && all(arts, a => lower_hex_64(value: a.render_sha256) && a.render_sha256 == a.installed_sha256_computed_on_host)
    && length(runs) == 4
    && deadline == 600 && floor == 30
    && all(runs, r => match srv1_boot_path_run_ready_duration(run: r) { Absent => false Present { value: e } => second_count(e) >= 1 && second_count(e) <= deadline })
    && length(arts_now) == 4
    && all(arts_now, a => lower_hex_64(value: a.render_sha256) && a.render_sha256 == a.installed_sha256_computed_on_host)
    && !any(runs, r => srv1_boot_path_run_claims_reboot(r))
    && all(filter(runs, r => srv1_boot_path_run_is_cold_start(r)), r => string_contains(s: r.note, pattern: "NOT a host reboot"))
    && all(filter(runs, r => srv1_boot_path_run_is_crash(r)), r => second_count(r.container_created) >= floor)
    && length(filter(runs, r => srv1_boot_path_run_is_cold_start(r))) == 2
    && length(filter(runs, r => srv1_boot_path_run_is_crash(r))) == 2
    && srv1_boot_path_incident_2026_11_09.replica_index == 1
    && match srv1_boot_path_incident_downtime(incident: srv1_boot_path_incident_2026_11_09) {
      Absent => false
      Present { value: d } => second_count(d) == 756
    }
    && host_text_matches(instant: srv1_boot_path_incident_2026_11_09.down_from, host_text: "2026-11-09T21:04:54Z")
    && host_text_matches(instant: srv1_boot_path_incident_2026_11_09.down_to, host_text: "2026-11-09T21:17:30Z")
    && srv1_boot_path_incident_2026_11_09.container_exit_status == 2
    && srv1_boot_path_incident_2026_11_09.failed_starts == 4
    && srv1_router_window_count_balances(record: srv1_boot_path_window_router_counting_2026_11_09)
    && render_answered_text(launcher_digest_answer)
    && install_row_digest_matches(host_path: "/usr/local/sbin/lil-replica-launch", render_digest: render_text(launcher_digest_answer))
    && install_row_digest_matches(host_path: "/usr/local/etc/lil-replica/replica-0.args", render_digest: render_text(srv1_render_replica_engine_args_sha256()))
    && install_row_digest_matches(host_path: "/usr/local/etc/lil-replica/replica-1.args", render_digest: render_text(srv1_render_replica_engine_args_sha256()))
    && install_row_digest_matches(host_path: "/usr/local/sbin/lil-replica", render_digest: srv1_render_replica_helper_sha256())
}

// The install rows say "the renderer emitted these bytes and the host holds them". The first half is only true
// as long as the renderer STILL emits them, and nothing re-checks that after an edit to the module: a render
// that drifts after an install leaves the host holding bytes no row can name a source for, which is the same
// shape as the window's own incident (installed bytes that disagreed with every claim about them) one step
// earlier. So the digest computed HERE, from the current renderer, is compared against the digest each row
// records the host reading back over the file it holds.
// WHICH ROW the render is compared against is itself a fact: the render must equal the bytes the CURRENT
// window installed, which is srv1_installed_boot_path_artifacts_2026_11_24 -- not the 2026-11-09 row, which is
// kept as the dated capture of an earlier render (its digest pair describes bytes the tier had when they were
// 12 GiB). Comparing today's render against the older capture would make every tier change a red test, which
// is how a capture gets silently re-based and stops being evidence.
fn install_row_digest_matches(host_path: String, render_digest: String) -> Bool {
  any(
    srv1_installed_boot_path_artifacts_2026_11_24,
    a => a.host_path as String == host_path
      && a.render_sha256 as String == render_digest
      && a.installed_sha256_computed_on_host as String == render_digest
  )
}

// EVERY HAND-COMPOSED SCRIPT THIS MODULE SHIPS CARRIES A MARKER OF ITS OWN, and each marker names the carrier
// it covers. A comment may claim "this is tracked as X" and mean nothing: the launcher's debt was pointed at
// srv1_serving_gpu_launcher_bash_emit_dissolution (which covers the RETAINED gpu.sh, now the restore path) and
// at srv1_replica_launcher_shape_dissolution, which no row declared (review 92788). This claim references each
// marker by name, so an undeclared one fails to resolve, and it refuses a marker that does not name what it
// covers, so a marker cannot be a generic paragraph about debt.
fn marker_text(condition: DissolutionCondition) -> String {
  match condition {
    BoundDissolution { trigger: _ } => ""
    UnboundDissolution { description: d } => d as String
  }
}

// The unit rows no longer carry a GPU UUID (#16167 moved the pin onto the profile's card row), so both renders
// that print a UUID read it through srv1_replica_gpu_uuid_text. This says the render cannot lose the pin
// silently: every unit's card UUID appears in the launcher, the two cards differ, and the fail-closed token a
// UUID-less profile would print appears in NO rendered artifact.
test fn the_rendered_boot_path_pins_the_card_from_the_profile_row() -> Bool {
  let render_answer_7 = srv1_render_replica_launcher()
  let launcher = render_text(render_answer_7)
  let units = srv1_serving_replica_roster
render_answered_text(render_answer_7) && (
  length(units) == 2
    && all(units, r => string_contains(s: launcher, pattern: srv1_replica_gpu_uuid_text(replica: r)))
    && any(units, a => any(units, b => srv1_replica_gpu_uuid_text(replica: a) != srv1_replica_gpu_uuid_text(replica: b)))
    && !string_contains(s: launcher, pattern: "NO_CARD_UUID_IN_PROFILE")
    && !string_contains(s: render_text(srv1_render_replica_engine_args()), pattern: "NO_CARD_UUID_IN_PROFILE")
    && !string_contains(s: srv1_render_replica_helper(), pattern: "NO_CARD_UUID_IN_PROFILE")
  )}

// THE HAND-SHELL THAT REMAINS CARRIES ITS OWN MARKER. Two of the five markers this module carried are gone,
// and they are gone because the renders they marked are emitted as built statements now: the container command
// and the launcher render (srv1_replica_launcher_lines) are produced by the bash_build constructors and the
// serializer, and the digest the host read back for the installed launcher — c4ef7314… in
// srv1_installed_boot_path_artifacts_2026_11_09 — is what the render produces (the_install_and_run_receipts_
// hold_their_own_claim re-derives it and compares, which is the control that can say so). What is left here is
// hand shell still: the retained gpu.sh restore path (kept untouched, by the operator's decision, as the way
// back if this render is wrong), the host helper, and the docker argv shape, whose concrete syntax lives with
// the docker spec input rather than with bash.
test fn every_hand_composed_script_carries_its_own_marker() -> Bool {
  let shape_marker = marker_text(condition: srv1_replica_launcher_shape_dissolution)
  let gpu_sh_marker = marker_text(condition: srv1_serving_gpu_launcher_bash_emit_dissolution)
  let helper_marker = marker_text(condition: srv1_replica_helper_bash_emit_dissolution)
  string_contains(s: shape_marker, pattern: "Srv1ContainerRunShape")
    && string_contains(s: gpu_sh_marker, pattern: "srv1_serving_gpu_launcher")
    && string_contains(s: helper_marker, pattern: "srv1_replica_helper")
    // every marker states its trigger, and names the modeled route it waits on: the shell bodies point at
    // v2.workflow.bash_emit, the docker argv points at the docker spec input -- a marker that named NEITHER
    // route is a paragraph, not a dissolution
    && all([shape_marker, gpu_sh_marker, helper_marker], m =>
      string_contains(s: m, pattern: "dissolve-on:")
        && (string_contains(s: m, pattern: "v2.workflow.bash_emit") || string_contains(s: m, pattern: "extdeps.docker.create_spec")))
}

// A DURATION CANNOT DISAGREE WITH THE INSTANTS IT MEASURES. Each run row keeps its two instants and one
// independent stopwatch phase; readiness is computed from the pair through the same ISO 8601 calendar the fleet
// module reads its NCCL spans through. That dependency earned its keep: replica 1's crash row had been
// transcribed with the kill 7 s late (the host recorded 22:11:01Z, epoch 1794262261; the row said 22:11:08Z),
// and the hand-typed ready duration agreed with the WRONG instant. With the duration derived, the row can only
// say what the instants say -- and the instants arrive through the calendar's checked constructor, so a malformed
// instant (`2026-11-9T…`, a missing leading zero) or an out-of-range clock face (`hour: 99`, `minute: 61`) is not
// a value a receipt can hold: the constructor answers Absent where the instant is made. The red controls here are
// the errors that remain possible: a pair in the wrong order, which must answer Absent, and the 7-second slip
// this window actually made, which must produce 505 -- a different duration -- so the claim over 512 goes red
// instead of agreeing with the mistyped instant.
// A receipt's instants arrive through the calendar's checked constructor, so a comparison with a host read cases
// on the Optional: an absent instant fails the comparison rather than becoming a string that looks like a date.
fn host_text_matches(instant: Iso8601UtcInstant?, host_text: String) -> Bool {
  match instant {
    Absent => false
    Present { value: v } => iso8601_utc_instant_text(i: v) == host_text
  }
}

fn is_instant_present(instant: Iso8601UtcInstant?) -> Bool {
  match instant {
    Absent => false
    Present { value: _ } => true
  }
}

test fn the_ready_duration_is_the_instants_and_not_a_third_copy() -> Bool {
  let runs = srv1_boot_path_runs_executed_2026_11_09
  let r1_crash = filter(runs, r => srv1_boot_path_run_is_crash(r) && r.replica_index == 1)
  length(r1_crash) == 1
    // the parts render back to the exact text the host printed, which is what ties the typed instant to the read
    && all(r1_crash, r => host_text_matches(instant: r.trigger_at, host_text: "2026-11-09T22:11:01Z")
      && host_text_matches(instant: r.ready_at, host_text: "2026-11-09T22:19:33Z")
      && match srv1_boot_path_run_ready_duration(run: r) { Absent => false Present { value: e } => second_count(e) == 512 })
    // RED control: the same pair the other way round refuses.
    && all(r1_crash, r => match iso8601_utc_instant_seconds_between(earlier: r.ready_at, later: r.trigger_at) {
      Absent => true
      Present { value: _ } => false
    })
    // RED control: the exact slip this window made -- the kill typed 7 s late -- must yield 505, not 512. A
    // duration stored beside the instants would have been true of the wrong pair and this claim would not have
    // noticed, which is how the drift got past a review round.
    && all(r1_crash, r => match iso8601_utc_instant_seconds_between(
      earlier: iso8601_utc_instant(year: 2026, month: 11, day: 9, hour: 22, minute: 11, second: 8),
      later: r.ready_at,
    ) {
      Absent => false
      Present { value: e } => second_count(e) == 505
    })
    // RED controls: the range is decided by the CONSTRUCTOR, not by whichever consumer noticed. Each part
    // outside what its name claims answers Absent where the instant is made, so a receipt cannot hold one and no
    // reader downstream has to be clever about it.
    && match iso8601_utc_instant(year: 2026, month: 11, day: 9, hour: 99, minute: 11, second: 1) {
      Absent => true
      Present { value: _ } => false
    }
    && match iso8601_utc_instant(year: 2026, month: 11, day: 9, hour: 22, minute: 11, second: 61) {
      Absent => true
      Present { value: _ } => false
    }
    && match iso8601_utc_instant(year: 2026, month: 0, day: 9, hour: 22, minute: 11, second: 1) {
      Absent => true
      Present { value: _ } => false
    }
    // the in-range side builds the instant the host printed, which ties the parts back to the reading
    && match iso8601_utc_instant(year: 2026, month: 11, day: 9, hour: 22, minute: 19, second: 33) {
      Absent => false
      Present { value: v } => iso8601_utc_instant_text(i: v) == "2026-11-09T22:19:33Z"
    }
    // and every recorded instant is the Present side, which is what the green durations rest on
    && all(srv1_boot_path_runs_executed_2026_11_09, r => is_instant_present(instant: r.trigger_at) && is_instant_present(instant: r.ready_at))
}

// THE BARS THEMSELVES ARE NOT FREE NUMBERS. The crash floor must be the CONTRACT's restart delay, so a unit
// whose RestartSec changed drags this test along with it; and the readiness deadline must stay a duration, not
// a count that can be compared against a port number or a byte size.
test fn the_bars_come_from_the_rows_not_from_the_test() -> Bool {
  let runs = srv1_boot_path_runs_executed_2026_11_09
  let crashes = filter(runs, r => srv1_boot_path_run_is_crash(r))
  srv1_boot_path_crash_restart_floor_seconds() == second_count(srv1_replica_unit_contract.restart_delay)
    && srv1_boot_path_ready_deadline_seconds() == second_count(srv1_boot_path_ready_deadline)
    && length(crashes) == 2
    && all(crashes, r => match srv1_boot_path_run_ready_duration(run: r) { Absent => false Present { value: e } => second_count(r.container_created) < second_count(e) })
}

// ONE CERTIFICATE IDENTITY FOR BOTH REPLICAS, enforced by the render rather than by the operator remembering
// to copy. The router pins a single upstream_ca.pem for both upstreams, so a replica that minted its own pair
// would pass every container-local check and still be refused by the router -- an outage that looks like an
// engine failure from the inside. The retained gpu.sh did this copy on the host before `docker run`; the
// launcher renders it, and the source of the copy is pinned to a REPLICA ROW rather than to a literal that
// could drift away from the replica that actually owns the identity.
// The substring an arm shows when it is the replica that OWNS the identity: the two paths in its `[ a != b ]`
// test are the same path, so the copy branch cannot be taken.
fn srv1_self_test(src: String, file_name: String) -> String {
  let path = concat(concat(src, "/"), file_name)
  concat(
    concat(concat("[ \"", path), "\" != \""),
    concat(path, "\"")
  )
}

test fn the_launcher_carries_the_shared_tls_identity_forward() -> Bool {
  let render_answer_6 = srv1_render_replica_launcher()
  let l = render_text(render_answer_6)
  let src = srv1_tls_identity_source_dir as String
  let key = srv1_tls_key_file_name as String
  let cert = srv1_tls_cert_file_name as String
  // The copy source is the primary replica's own serve directory, not a directory that merely happens to
  // hold a pair today.
  let source_is_a_replica_row = src == (srv1_replica_0.host_serve_dir as String)
  // The second replica's arm copies BOTH halves from it, by name, and only when its own copy is missing.
  let gpu1_copies = string_contains(s: l, pattern: concat(concat("sudo -n cp -p \"", concat(concat(src, "/"), key)), "\" \"/home/briansrls/lil/serve-gpu1/tls.key\""))
    && string_contains(s: l, pattern: concat(concat("sudo -n cp -p \"", concat(concat(src, "/"), cert)), "\" \"/home/briansrls/lil/serve-gpu1/tls.crt\""))
  // The owning replica's arm must not copy onto itself: `cp` refuses, and the guard would decide the arm's exit.
  let gpu0_does_not_self_copy = string_contains(s: l, pattern: srv1_self_test(src: src, file_name: key))
    && string_contains(s: l, pattern: srv1_self_test(src: src, file_name: cert))
render_answered_text(render_answer_6) && (
  source_is_a_replica_row && gpu1_copies && gpu0_does_not_self_copy
  )}

// THE CONTAINER COMMAND IS ONE ARGUMENT, not a run-on host command line. The rendered `-lc` word is single
// quoted, so the container's bash is the only thing that ever sees its newlines, `$(...)` and `${...}`; and the
// quoting is only sound because no line of that script contains a single quote, which is what the last conjunct
// pins. Without it, a row that put a `'` into a path or a log line would close the quote early and the tail of
// the container's own startup script would be executed by the HOST shell inside the launcher's arm.
test fn the_container_command_is_quoted_as_one_argument_and_cannot_break_its_own_quotes() -> Bool {
  let render_answer_5 = srv1_render_replica_launcher()
  let l = render_text(render_answer_5)
  let render_answer_4 = srv1_replica_container_command_lines(replica: srv1_replica_0, config: srv1_admitted_launch_config)
  let cmd0 = string_concat_join(render_lines(render_answer_4), "\n")
  let render_answer_3 = srv1_replica_container_command_lines(replica: srv1_replica_1, config: srv1_admitted_launch_config)
  let cmd1 = string_concat_join(render_lines(render_answer_3), "\n")
render_answered_text(render_answer_5) && render_answered(render_answer_4) && render_answered(render_answer_3) && (
  string_contains(s: l, pattern: "-lc 'D=/root/serve")
    && string_contains(s: l, pattern: ">> $D/serve.log 2>&1'")
    && !string_contains(s: cmd0, pattern: "'")
    && !string_contains(s: cmd1, pattern: "'")
  )}

// EACH ARM IS ONE CASE BRANCH, terminated and labelled: the label carries its closing paren and every arm ends
// in `;;`, because an unterminated arm silently swallows the next one and a launcher that runs replica 1's
// command for index 0 would put two replicas on one card.
test fn every_arm_is_terminated_and_labelled() -> Bool {
  let render_answer_2 = srv1_render_replica_launcher()
  let l = render_text(render_answer_2)
  let arms = string_contains(s: l, pattern: "\n  0)\n")
    && string_contains(s: l, pattern: "\n  1)\n")
    && !string_contains(s: l, pattern: "\n  0\n")
    && !string_contains(s: l, pattern: "\n  1\n")
  let terminated = string_contains(s: l, pattern: ";;\n  1)")
    && string_contains(s: l, pattern: ";;\nesac")
render_answered_text(render_answer_2) && (
  arms && terminated
  )}

// The args file is where the render lands, so the file's identity -- root-owned directory, per-replica name,
// read-only mount -- is part of the boot path and is pinned rather than left to the install step.
test fn the_rendered_args_file_is_per_replica_root_owned_and_read_only() -> Bool {
  let a = srv1_admitted_launch_config
  // The launcher render is read here as the place the args FILES get their directory, and it
  // is read on its Accepted arm: a launcher that refused names no args file.
  let launcher_answer = srv1_replica_launcher_lines(replicas: srv1_serving_replica_roster, config: a)
  render_answered(launcher_answer)
    && (srv1_replica_rendered_args_dir as String) == "/usr/local/etc/lil-replica"
    && (srv1_replica_engine_args_host_path(replica: srv1_replica_0) as String) == "/usr/local/etc/lil-replica/replica-0.args"
    && (srv1_replica_engine_args_host_path(replica: srv1_replica_1) as String) == "/usr/local/etc/lil-replica/replica-1.args"
    && srv1_replica_engine_args_host_path(replica: srv1_replica_0) != srv1_replica_engine_args_host_path(replica: srv1_replica_1)
    && concat(render_text(srv1_replica_engine_args_body(config: a)), "\n") == render_text(srv1_render_replica_engine_args())
    && length(xs: render_lines(launcher_answer)) > 10
}

// A REFUSED WORD IS THE RENDER'S REFUSAL, NOT A LINE INSIDE IT.
//
// The bad input is the one the fold witness uses at the builder itself — `bash_build_word_var(
// name: "1x")`, which answers the diagnostic `bash_build_refused_var_name`
// (src/v2/test/claim/bash_command_fold.dag::bash_fold_bad_var_name_is_refused_holds) — reached
// here the way a bad input reaches a real render: through a CONFIG value, not through a
// hand-built node. One value, one refused builder: a container-side TLS directory holding a
// space, which the `bare` word row will not spell. It refuses inside the container command,
// and the launcher refuses THROUGH it, because the arm that starts this replica runs the very
// script that render produced.
//
// Before this conversion the same input produced an otherwise valid script carrying
// `GUNBC-BASH-EMIT-REFUSED`, a digest of that script recorded as computed on a host, and no
// type in the path able to tell the install step that a statement was missing. The two answers
// below are the refusal and its reason; neither of them is a line.
fn refused_naming_the_site(render: Outcome<List<String>>, site: String) -> Bool {
  match render {
    // An accepted render is the wrong answer here even when no marker line is visible in it:
    // what it accepted would be a script with a statement missing, which is precisely what a
    // caller cannot see and cannot be expected to guard against.
    Accepted { value: _ } => false
    Rejected { diagnostics: d } => string_contains(
      s: diagnostics_reason_lexemes(diagnostics: d),
      pattern: concat("srv1_bash_refused:", site)
    )
  }
}

test fn one_unspellable_config_value_makes_both_renders_refuse_instead_of_rendering_a_marker() -> Bool {
  let a = srv1_admitted_launch_config
  let broken_tls = Srv1TlsMaterial {
    container_dir: "/root/serve dirs" as FilePath,
    key_path: a.tls_material.key_path,
    cert_path: a.tls_material.cert_path,
  }
  let broken = cfg_over(
    l2: a.lmcache_l2_placement, retention: a.checkpoint_retention, tls: broken_tls,
    key: a.api_key_reference, exe: a.engine_executable, port: a.container_port,
    model_len: a.max_model_len, l1: a.lmcache_l1
  )
  let command = srv1_replica_container_command_lines(replica: srv1_replica_0, config: broken)
  let launcher = srv1_replica_launcher_lines(replicas: srv1_serving_replica_roster, config: broken)
  refused_naming_the_site(render: command, site: "container command: serve directory")
    && refused_naming_the_site(render: launcher, site: "container command: serve directory")
}


// ── the L1 staging contract (class B4, 2026-11-24) ──────────────────────────────────────────────────
//
// WHY THESE CONTROLS EXIST, AND WHAT THEY ARE FOR. Under the store policy srv1's engines run with, a checkpoint
// reaches the NVMe tier only as it leaves L1, so L1 is not a cache whose undersizing costs a hit: it is the
// staging buffer on the ONLY path a checkpoint has to disk, in both directions. Size it below what the
// concurrent population can hold and the eviction that was supposed to persist a checkpoint is the operation
// that deletes it. Until this section, the tier, the /dev/shm carrying it and the cgroup charging it were three
// unrelated numbers and every shape below was writable, renderable and installable — it failed inside the
// engine at checkpoint time, the furthest place from the edit at which it could be seen.
//
// THE DISCRIMINATING RED IS NOT A MADE-UP CONFIGURATION: it is the one the host ran. `cfg_tier_as_before` puts
// the admitted config's tier back to 12 GiB — the figure this repository carried from 2026-11-08 to 2026-11-24,
// sized as a cache in front of a big disk — and asks the real producers for bytes. They must refuse, by name,
// and the accepted arm must be a failure in its own right, not an empty list: the lesson of
// gunbc.recurring_failure_mode::a_refused_emission_is_rendered_as_a_poison_string_inside_otherwise_valid_output
// is that a refusal read as an absence turns this defect one level up.

// The refusal's site, read from the diagnostic rather than from a line: the term is interned INTO the reason by
// srv1_kv_tier_refusal, which is what lets a control say WHICH term refused instead of only that one did.
fn kv_refused_lines(render: Outcome<List<String>>, term: String) -> Bool {
  match render {
    Accepted { value: _ } => false
    Rejected { diagnostics: d } => string_contains(
      s: diagnostics_reason_lexemes(diagnostics: d),
      pattern: concat("srv1_kv_tier_refused:", term)
    )
  }
}

fn kv_refused_text(render: Outcome<String>, term: String) -> Bool {
  match render {
    Accepted { value: _ } => false
    Rejected { diagnostics: d } => string_contains(
      s: diagnostics_reason_lexemes(diagnostics: d),
      pattern: concat("srv1_kv_tier_refused:", term)
    )
  }
}

// The 2026-11-08 configuration: the admitted config in every field except the tier, which is the size the host
// actually ran for sixteen days. Nothing else is varied, so the only thing this control can be failing on is the
// tier — which is the point.
fn cfg_tier_as_before() -> Srv1LaunchConfig {
  let a = srv1_admitted_launch_config
  cfg_over(
    l2: a.lmcache_l2_placement, retention: a.checkpoint_retention, tls: a.tls_material, key: a.api_key_reference,
    exe: a.engine_executable, port: a.container_port, model_len: a.max_model_len,
    l1: gibibyte_to_byte_size(g: gibibyte(count: 12))
  )
}

test fn the_tier_the_host_ran_until_2026_11_24_refuses_both_renders_by_name() -> Bool {
  let before = cfg_tier_as_before()
  kv_refused_lines(render: srv1_replica_launcher_lines(replicas: srv1_serving_replica_roster, config: before), term: "l1-staging-floor")
    && kv_refused_text(render: srv1_replica_engine_args_body(config: before), term: "l1-staging-floor")
}

// The refusal is not only a render opinion: the boot admission carries it, under its own named identity, so
// convergence cannot arm the replica. A config that cannot be rendered AND cannot be booted is the pair that
// makes the bad state unreachable rather than merely inconvenient.
test fn the_refused_tier_refuses_the_boot_admission_under_the_contract_identity() -> Bool {
  match srv1_launch_admission(config: cfg_tier_as_before()) {
    Srv1LaunchAdmitted { } => false
    Srv1LaunchRefused { cause: c, defect_identity: id } =>
      (id == srv1_l1_staging_contract_identity)
        && string_contains(s: c, pattern: "l1-staging-floor")
  }
}

// The positive control, and it is the host's configuration: 48 GiB clears every term, and the bytes that DO
// render -- the per-replica args file, which is where LMCACHE_L1_GB=48 lives -- hash to the digest the install
// row holds against the host's own sha256sum readback (install_row_digest_matches reads the 2026-11-24 row, and
// compares three strings from
// two sources, so it is not a restatement of its subject). The LAUNCHER render is deliberately not called
// here: rendering the 5,771-byte launcher as one string trips the pre-existing CallDepthExceeded in
// std.host_text's text_of_chars -- identically on pristine main at this pin -- so the launcher's own digest is
// carried from the host read and executed by the_install_and_run_receipts_hold_their_own_claim under CI's
// tree-pinned seed. What is pinned here is the half of the pair this interpreter can actually evaluate.
test fn the_admitted_tier_is_admitted_by_the_contract_and_renders() -> Bool {
  let args = srv1_render_replica_engine_args()
  match srv1_kv_tier_verdict(
    config: srv1_admitted_launch_config,
    shape: srv1_replica_container_run_shape,
    budget: srv1_replica_host_budget
  ) {
    KvTiersAdmitted => match args {
      Accepted { value: body, diagnostics: _ } => install_row_digest_matches(
        host_path: "/usr/local/etc/lil-replica/replica-0.args",
        render_digest: sha256_hex_of_text(text: body)
      )
      Rejected { diagnostics: _ } => false
    }
    KvTierRefused { term: _, cause: _ } => false
  }
}

// The REQUIREMENT is a DERIVED figure and this pins it: four conversations in flight on a replica (the srv1
// coordinate's 8 sessions over a share width of 2), each at the 229,376-token context the engine admits, priced
// by the engine's own KV density, and priced TWICE because the tier is the only path in both directions -- a
// checkpoint leaving for disk, and a returning conversation landing before the engine can read it. 4 x 4.906
// GiB x 2 = 39.25 GiB, so the ceiling is 40, not the 20 a single-direction bound would give. It is stated as a
// GiB ceiling rather than recomputed from the same helper the row uses, so the control is not a restatement of
// its subject
// (gunbc.recurring_failure_mode::a_control_that_shares_its_derivation_with_its_subject).
test fn the_staging_requirement_is_the_population_priced_both_ways_at_the_admitted_context() -> Bool {
  match srv1_l1_staging_floor(contract: srv1_kv_staging_contract, config: srv1_admitted_launch_config) {
    Accepted { value: floor, diagnostics: _ } => gibibyte_count(g: gibibyte_ceiling(b: floor)) == 40
    Rejected { diagnostics: _ } => false
  }
}

// What the population is, and how it was obtained: 4 turns per replica, and a MEASURED AVERAGE rather than an
// admitted cap. The second half is what keeps the row honest about its own ceiling — the day a row admits a
// per-replica population, this control goes red and the contract has to be re-read, not quietly closed.
test fn the_population_is_four_turns_read_as_a_measured_average() -> Bool {
  let population = match srv1_kv_tier_population() {
    Absent => false
    Present { value: n } => n == 4
  }
  let source = match srv1_kv_tier_population_source {
    MeasuredAverage { source: _ } => true
    AdmittedByRow { source: _ } => false
  }
  population && source
}

// The policy the whole contract turns on, carried as a read with the flag's own spelling. If this ever changes
// arm, the floor must stop binding — which is the point of modelling the policy instead of hard-coding a wall.
test fn the_store_policy_row_is_the_read_that_makes_l1_the_only_path_to_disk() -> Bool {
  match srv1_l2_store_policy_reading.policy {
    CheckpointOnEvict { flag_value: v } => v == "checkpoint_on_evict" as NonEmptyStr
    StoreAtCreation { flag_value: _ } => false
    StorePolicyUnread { obligation: _ } => false
  }
}

// ADMITTED IS NOT THE SAME AS KEEPING THE PROMISE, and this is the control that refuses to let the model
// conflate them: at 48 GiB every priced term holds, and the contract still reports itself undischarged, naming
// both unpriced terms. The host's own 2026-11-25 read — fresh checkpoints still deleted before their store at
// 06:00 UTC, 187 events on GPU1 and 56 on GPU0 per 15 minutes — is the observation this conjunct exists to
// stay honest about. A future edit that deletes it has to explain that read, not just the green.
test fn the_admitted_tier_is_admitted_and_still_reports_the_contract_undischarged() -> Bool {
  match srv1_l1_staging_discharge(config: srv1_admitted_launch_config) {
    Accepted { value: d, diagnostics: _ } => match d {
      ContractDischarged { holds: _, requires: _ } => false
      ContractUndischarged { holds: h, requires_at_least: r, missing: m } =>
        byte_size_count(b: h) == byte_size_count(b: srv1_lmcache_l1_bytes)
          // the priced requirement is the population STAGEABLE IN BOTH DIRECTIONS (a checkpoint being stored, and
          // a returning conversation landing before the engine reads it), and it fits -- with the margin that
          // makes the burst sensitivity above the thing to watch, not a rounding error.
          && byte_size_count(b: r) < byte_size_count(b: h)
          && byte_size_count(b: r) > byte_size_count(b: srv1_lmcache_l1_bytes) / 2
          && length(m) == 4
          // Four distinct named terms, and all four of them: an indexed read would be optional (List indexing
          // returns T?), so the list is pinned by cardinality plus presence of each name — with length 3 and
          // three distinct names present, there is no fourth state. Dropping any term from the model's list
          // takes this red, which is the point: the 2026-11-25 host read says the contract is not discharged,
          // and the model is not allowed to answer that observation with a shorter gap list. The third is the
          // newest one -- the price is spent past the context it was read at (observed_up_to 150,000 against the
          // admitted 229,376), which is a degradation the reading must show rather than fold into the number.
          // THE GAP LIST IS A DECLARED COPRODUCT (srv1_serving_replica_layout::Srv1L1MissingTerm), so this control
          // binds the VARIANTS -- precedent for `==` on a fieldless coproduct is srv1_boot_path_run_is_cold_start
          // in the same module. Until this head it compared the whole PARAGRAPHS for equality, which meant a
          // sentence edit silently changed which term was missing (review 98748). Renaming a variant is now a
          // compile error here; rewording a reason cannot move a term.
          && any(m, g => g.term == AdmittedPopulationUnbounded)
          && any(m, g => g.term == StoreWindowHeadroomUnpriced)
          && any(m, g => g.term == PriceExtrapolatedPastItsRead)
          // THE FOURTH, and the one class B4's follow-up files: the promise's TAIL — that a checkpoint which
          // reached the disk tier is still there when its conversation returns — is held by a knob nobody has
          // read and one run found inert. Dropping it from the model's list takes this control red, which is
          // the point: the model may not answer "the fleet lost fresh checkpoints" with a gap list that omits
          // the only mechanism standing between a checkpoint and the eviction path.
          && any(m, g => g.term == CheckpointProtectionUnbacked)
          && any(m, g => g.term == CheckpointProtectionUnbacked
            && string_contains(s: g.reason as String, pattern: "2172 of 2173"))
          // and the reasons still travel with them, non-empty and specific where specificity is the claim
          && any(m, g => g.term == PriceExtrapolatedPastItsRead
            && string_contains(s: g.reason as String, pattern: "150,000"))
    }
    Rejected { diagnostics: _ } => false
  }
}

// The arena term, exercised at the verdict (the shape is a row, so a control varies it here rather than through
// the render). A tier docker cannot carve is refused with lil's own reason, not rendered to die at engine init.
test fn a_dev_shm_smaller_than_the_tier_is_refused_as_the_arena_term() -> Bool {
  let a = srv1_admitted_launch_config
  let s0 = srv1_replica_container_run_shape
  let tight_arena = Srv1ContainerRunShape {
    cgroup_parent: s0.cgroup_parent,
    shm_size: gibibyte_to_byte_size(g: gibibyte(count: 12)),
    restart_policy: s0.restart_policy,
    entrypoint: s0.entrypoint,
    engine_args_container_path: s0.engine_args_container_path,
    pool_key_container_path: s0.pool_key_container_path,
    tls_curve: s0.tls_curve,
    tls_validity: s0.tls_validity,
    tls_subject_common_name: s0.tls_subject_common_name,
  }
  match srv1_kv_tier_verdict(config: a, shape: tight_arena, budget: srv1_replica_host_budget) {
    KvTiersAdmitted => false
    KvTierRefused { term: term, cause: _ } => term == L1CheckpointArena
  }
}

// The cgroup term, at the same boundary: a --memory that cannot charge the tier's shmem plus the process is
// refused, so the render cannot produce a docker line that OOM-kills its own replica mid-checkpoint.
test fn a_cgroup_that_cannot_charge_the_tier_is_refused_as_the_cgroup_term() -> Bool {
  let a = srv1_admitted_launch_config
  let b = srv1_replica_host_budget
  let tight_cgroup = Srv1ReplicaHostBudget {
    l1_shm: b.l1_shm,
    ple_pinned: b.ple_pinned,
    anon: b.anon,
    cgroup_memory_limit: gibibyte_to_byte_size(g: gibibyte(count: 32)),
  }
  match srv1_kv_tier_verdict(config: a, shape: srv1_replica_container_run_shape, budget: tight_cgroup) {
    KvTiersAdmitted => false
    KvTierRefused { term: term, cause: _ } => term == L1CgroupCarriesTier
  }
}

// The three numbers that were, until this class, three separate hand-written values — the tier, the /dev/shm
// that carries it, and the cgroup that charges it — are checked here as one fact with its consequences: the
// budget's shmem charge IS the tier row (not a copy of it), the arena sits above it, and the cgroup covers the
// tier plus the process. Each conjunct fails if someone restates one of the three by hand.
test fn the_tier_its_arena_and_its_cgroup_are_one_fact_not_three_numbers() -> Bool {
  byte_size_count(b: srv1_replica_host_budget.l1_shm) == byte_size_count(b: srv1_lmcache_l1_bytes)
    && byte_size_count(b: srv1_replica_container_run_shape.shm_size) > byte_size_count(b: srv1_lmcache_l1_bytes)
    && byte_size_count(b: srv1_replica_host_budget.cgroup_memory_limit)
      >= byte_size_count(b: srv1_lmcache_l1_bytes) + byte_size_count(b: srv1_replica_host_budget.anon)
    && srv1_admitted_launch_config.lmcache_l1 == srv1_lmcache_l1_bytes
}

// What the pair costs the host. Held as a control and not as a refusal, because this render has no business
// deciding srv1's whole budget: 2 replicas at the cgroup ceiling plus one PLE table each must stay inside the
// host's admitted memory, and if that ever stops being true the finding belongs here rather than in a launcher
// edit that quietly lowers a limit nobody agreed.
// THE PAIR STILL FITS SRV1 -- against the host's OWN RAM row, and against the quantity this control claims to
// check. An earlier arm of this control compared an ESTIMATED footprint (L1 + PLE + anon, 161.6 GiB for the
// pair) against a 502 GiB literal copied into the test, while its comment said it was checking two cgroup
// ceilings plus two PLE tables. The ceilings are the enforceable quantity -- what the kernel will let the two
// containers hold, plus what the nvidia driver pins outside every cgroup -- and they are the larger number,
// 197.6 GiB. So this checks THAT, and against gunbc.host.host_memory_observation::gunbc_ci_srv1_memtotal_measured,
// the row the host itself read off /proc/meminfo (539,281,129,472 bytes, 2026-08-23), not a transcription of it
// into a test. The estimate is still stated, labelled as the estimate it is, because it is the figure the
// operator's read of a working host supports and the ceiling is the figure the model must admit against.
//
// THE FLEET RESERVATION TERM IS MISSING, AND STAYS EXPLICIT. gunbc.serving.serving_reservation carries no srv1
// entry, so host_memory_reserved(operator_host_srv1) answers Present { bytes: 0 } -- the host budgets its
// replicas with NOTHING withheld for the runner, sshd, or page cache. The comparison therefore includes
// whatever the row says rather than assuming zero: the day a srv1 reservation is authored, this control starts
// charging it, and if it goes red the fit has genuinely narrowed. Asserting the zero instead would have made
// the model's improvement a test failure.
test fn the_two_replicas_still_fit_srv1s_admitted_memory() -> Bool {
  let ceiling = byte_size_count(b: srv1_replica_host_budget.cgroup_memory_limit)
  let ple = byte_size_count(b: srv1_replica_host_budget.ple_pinned)
  let pair_ceilings = (ceiling * 2) + (ple * 2)
  let reservation = match host_memory_reserved(host: operator_host_srv1) {
    Absent => 0
    Present { value: v } => byte_size_count(b: v)
  }
  let host_ram = byte_size_count(b: serving_usable_ram_bytes_or_zero(r: gunbc_ci_srv1_memtotal_measured))
  let estimate = byte_size_count(b: srv1_replica_total_host_claim(budget: srv1_replica_host_budget)) * 2
  host_ram > 0
    && pair_ceilings + reservation < host_ram
    // the estimate is the smaller quantity, so the ceiling check is the binding one and not a restatement of it
    && estimate < pair_ceilings
    && ceiling == 72 * 1073741824
    && byte_size_count(b: srv1_replica_container_run_shape.shm_size) == 56 * 1073741824
    && byte_size_count(b: srv1_lmcache_l2_bytes) == 125 * 1073741824
}

// ── class B4, review 98546 ───────────────────────────────────────────────────────────────
//
// Two findings from the review of the first head, each turned into the control that would have caught it
// rather than into a sentence agreeing with it.

// A launch config in every field except the tier, which the caller supplies. Same shape the pre-2026-11-24
// control uses, so a tier varied here cannot be varied against a different configuration by accident.
fn cfg_tier(bytes: ByteSize) -> Srv1LaunchConfig {
  let a = srv1_admitted_launch_config
  cfg_over(
    l2: a.lmcache_l2_placement,
    retention: a.checkpoint_retention,
    tls: a.tls_material,
    key: a.api_key_reference,
    exe: a.engine_executable,
    port: a.container_port,
    model_len: a.max_model_len,
    l1: bytes
  )
}

// FINDING 2, and the counterexample it named is now a control. A tier that holds ONE direction's worth -- 24 GiB,
// above the 19.625 GiB single-direction figure and below the 39.25 GiB the contract needs -- used to be ADMITTED
// by the boot gate while the safety reading called the same configuration undischarged. Two answers to one
// question, "how much L1 does this contract require", is how a tier that cannot stage a restore boots anyway.
// There is one requirement now, and the tier that cannot hold both directions is refused by the gate AND by boot
// admission. The other two terms hold by construction at 24 GiB (/dev/shm is 56 GiB, the cgroup 72 GiB), so this
// control can only fail on the staging term.
test fn a_tier_that_holds_only_one_direction_is_refused_by_the_gate_and_the_admission() -> Bool {
  let half = cfg_tier(bytes: gibibyte_to_byte_size(g: gibibyte(count: 24)))
  let gate = match srv1_kv_tier_verdict(config: half, shape: srv1_replica_container_run_shape, budget: srv1_replica_host_budget) {
    KvTiersAdmitted => false
    KvTierRefused { term: L1StagingFloor, cause: _ } => true
    KvTierRefused { term: _, cause: _ } => false
  }
  let admission = match srv1_launch_admission(config: half) {
    Srv1LaunchAdmitted { } => false
    Srv1LaunchRefused { cause: _, defect_identity: id } => id == srv1_l1_staging_contract_identity
  }
  gate && admission
}

// The same requirement from both readings at its exact boundary: one byte short refuses, the requirement itself
// admits, and the safety reading's stated requirement IS that integer. Holds the gate and the reading to a
// number rather than to prose -- if they ever grow separate requirements again, this is the control that goes red.
test fn the_gate_and_the_safety_reading_demand_the_same_number() -> Bool {
  match srv1_l1_staging_floor(contract: srv1_kv_staging_contract, config: srv1_admitted_launch_config) {
    Rejected { diagnostics: _ } => false
    Accepted { value: floor, diagnostics: _ } => {
      let need = byte_size_count(b: floor)
      let whole_gib = byte_size_count(b: gibibyte_to_byte_size(g: gibibyte(count: 1)))
      // THE BOUNDARY THE OPERATOR CAN ACTUALLY SPELL. The tier is named in whole GiB — an engine argument takes a
      // whole number, so a tier at the byte-exact floor is not authorable at all (see
      // gunbc.serving.srv1_serving_replica_layout::srv1_tier_is_whole_gib). The gate's first admissible tier is
      // therefore the floor rounded UP to a whole GiB, and this control tests that tier and the one GiB below it
      // rather than pretending a byte-exact boundary is reachable. The byte-exact floor itself must still be
      // refused, and refused for the whole-GiB reason — a tier the engine cannot be told is not a staging answer.
      let admissible_count = ((need + whole_gib - 1) / whole_gib) * whole_gib
      let short = cfg_tier(bytes: byte_size(count: admissible_count - whole_gib))
      let exact = cfg_tier(bytes: byte_size(count: admissible_count))
      let byte_floor_term = match srv1_kv_tier_verdict(config: cfg_tier(bytes: byte_size(count: need)), shape: srv1_replica_container_run_shape, budget: srv1_replica_host_budget) {
        KvTiersAdmitted => "admitted" as String
        KvTierRefused { term: t, cause: _ } => srv1_kv_tier_term_name(term: t) as String
      }
      let short_refused = match srv1_kv_tier_verdict(config: short, shape: srv1_replica_container_run_shape, budget: srv1_replica_host_budget) {
        KvTiersAdmitted => false
        KvTierRefused { term: _, cause: _ } => true
      }
      let exact_admitted = match srv1_kv_tier_verdict(config: exact, shape: srv1_replica_container_run_shape, budget: srv1_replica_host_budget) {
        KvTiersAdmitted => true
        KvTierRefused { term: _, cause: _ } => false
      }
      let reading_agrees = match srv1_l1_staging_discharge(config: exact) {
        Accepted { value: d, diagnostics: _ } => match d {
          ContractDischarged { requires: requires } => byte_size_count(b: requires) == need
          ContractUndischarged { holds: _, requires_at_least: requires_at_least, missing: _ } => byte_size_count(b: requires_at_least) == need
        }
        Rejected { diagnostics: _ } => false
      }
      short_refused && exact_admitted && reading_agrees
        && byte_floor_term == "l1-tier-not-whole-gib"
        && admissible_count >= need
        && admissible_count - need < whole_gib
    }
  }
}

// FINDING 1: the population is the population of a LOWER bound, so the share width divides UP, not down.
// 8 over 2 is 4 -- srv1's own coordinate, unchanged, which is why the host is unaffected. 8 over 3 is 3, not the
// 2 that truncating division returned: a whole conversation snapshot silently missing from the requirement, on
// the unsafe side of a bound. And a share width of zero has no quotient rather than a guessed one.
test fn the_population_rounds_up_because_it_bounds_a_buffer() -> Bool {
  let exact = match concurrent_turns_shared(sessions: 8, share_width: 2) {
    Present { value: a } => a == 4
    Absent => false
  }
  let rounds_up = match concurrent_turns_shared(sessions: 8, share_width: 3) {
    Present { value: b } => b == 3
    Absent => false
  }
  let no_divisor = match concurrent_turns_shared(sessions: 8, share_width: 0) {
    Absent => true
    Present { value: _ } => false
  }
  exact && rounds_up && no_divisor
}

// ── class B4, operator review 2026-11-25 ───────────────────────────────────
//
// Three findings from the operator's read of the head, each landed as the control that would have caught it.
// Together they say the same thing about a different seam: a number that lives in two places is two numbers as
// soon as one of them is edited, and a price that does not name the shape it was read under is a number that
// will be spent on a shape it never measured.

// (1) PROVISIONING AND BOOT MUST AGREE ON THE TIER, because they are two different consumers of it and only one
// of them is the launcher. The provisioning record (gunbc.serving.srv1_serving_launch::srv1_serving_launch) is
// copied verbatim into a provisioned container's environment by
// gunbc.serving.serving_provision_derivation::srv1_serving_launch_for_port, and it carried LMCACHE_L1_GB=12 --
// the 2026-11-08 reading -- for two days after the boot path had moved to 48. A container built from the model
// would have come up with a quarter of the tier the contract requires, and no control could have seen it,
// because the only comparison that existed read the boot render. This reads the operand out of BOTH producers
// and requires them to be the same text as the authority row's, so the copy has nowhere to lag.
test fn the_tier_operand_is_the_same_number_in_the_provisioning_launch_and_the_boot_render() -> Bool {
  let provisioned = first_where(
    xs: srv1_serving_launch.environment,
    keep: e => (e.key as String) == "LMCACHE_L1_GB"
  )
  let args = srv1_replica_engine_args_body(config: srv1_admitted_launch_config)
  let token = concat("LMCACHE_L1_GB=", srv1_lmcache_l1_gb_value() as String)
  let boot_carries_the_authority = match args {
    Accepted { value: body, diagnostics: _ } => string_contains(s: body, pattern: token)
    Rejected { diagnostics: _ } => false
  }
  let provisioned_carries_the_authority = match provisioned {
    Absent => false
    Present { value: e } => (e.value as String) == (srv1_lmcache_l1_gb_value() as String)
  }
  // The disk tier travels the same route and had the same exposure: one authority, both consumers.
  let l2_provisioned = first_where(
    xs: srv1_serving_launch.environment,
    keep: e => (e.key as String) == "LMCACHE_L2_GB"
  )
  let l2_token = concat("LMCACHE_L2_GB=", srv1_lmcache_l2_gb_value() as String)
  let l2_boot = match args {
    Accepted { value: body, diagnostics: _ } => string_contains(s: body, pattern: l2_token)
    Rejected { diagnostics: _ } => false
  }
  let l2_provisioned_ok = match l2_provisioned {
    Absent => false
    Present { value: e } => (e.value as String) == (srv1_lmcache_l2_gb_value() as String)
  }
  gibibyte_count(g: srv1_lmcache_l1_configured) == 48
    && provisioned_carries_the_authority
    && boot_carries_the_authority
    && l2_provisioned_ok
    && l2_boot
}

// A launch config that differs from the admitted shape ONLY in the fields the snapshot price was read under.
fn cfg_shape(dtype: Srv1KvCacheDtype, width: Nat) -> Srv1LaunchConfig {
  let a = srv1_admitted_launch_config
  Srv1LaunchConfig {
    tensor_parallel_size: width,
    kv_cache_dtype: dtype,
    profile: a.profile,
    hardware: a.hardware,
    lmcache_l1: a.lmcache_l1,
    max_model_len: a.max_model_len,
    image_digest: a.image_digest,
    lil_replicas: a.lil_replicas,
    host_gpu_p2p: a.host_gpu_p2p,
    engine_executable: a.engine_executable,
    lmcache_l2_placement: a.lmcache_l2_placement,
    checkpoint_retention: a.checkpoint_retention,
    tls_material: a.tls_material,
    api_key_reference: a.api_key_reference,
    container_port: a.container_port,
  }
}

// (2) THE CHECKPOINT PRICE IS BOUND TO THE SHAPE IT WAS READ UNDER. The operator changed exactly ONE field --
// kv_cache_dtype to Bf16 -- and admission went on pricing the conversation at 20,625 bytes per token, the figure
// read off the FP8 K/V pool at tensor-parallel width 1, while the renderer emitted `--kv-cache-dtype bf16`. A
// price spent on a shape it never measured fabricates the margin between them, and there is no honest multiplier
// for bf16 KV in this tree to substitute, so the term goes unpriced and the boot refuses. The refusing term is
// its OWN term (L1StagingPriceUnpriced), not a reuse of the too-small-tier term: "your tier is too small" and "I
// cannot price your tier" are different findings and a consumer must be able to tell them apart. The last arm is
// the discrimination: the admitted FP8 TP=1 shape IS priced, so this control can only be failing on the dtype.
test fn the_price_refuses_a_launch_it_was_never_read_under() -> Bool {
  let bf16 = cfg_shape(dtype: Bf16, width: 1)
  let floor_refuses = match srv1_l1_staging_floor(contract: srv1_kv_staging_contract, config: bf16) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } => string_contains(
      s: diagnostics_reason_lexemes(diagnostics: d),
      pattern: "srv1_kv_tier_refused:l1-staging-price-unpriced"
    )
  }
  let args_refuse = kv_refused_text(
    render: srv1_replica_engine_args_body(config: bf16),
    term: "l1-staging-price-unpriced"
  )
  let gate_refuses = match srv1_kv_tier_verdict(
    config: bf16,
    shape: srv1_replica_container_run_shape,
    budget: srv1_replica_host_budget
  ) {
    KvTiersAdmitted => false
    KvTierRefused { term: t, cause: _ } => match t {
      L1StagingPriceUnpriced => true
      _ => false
    }
  }
  let boot_refuses = match srv1_launch_admission(config: bf16) {
    Srv1LaunchAdmitted { } => false
    Srv1LaunchRefused { cause: c, defect_identity: id } =>
      (id == srv1_l1_staging_contract_identity)
        && string_contains(s: c, pattern: "l1-staging-price-unpriced")
  }
  floor_refuses
    && args_refuse
    && gate_refuses
    && boot_refuses
    && srv1_snapshot_cost_applies_to(config: srv1_admitted_launch_config)
    && !srv1_snapshot_cost_applies_to(config: bf16)
    // and the tensor-parallel width is a priced dimension too: the same dtype at width 2 is a different pool
    && !srv1_snapshot_cost_applies_to(config: cfg_shape(dtype: Fp8E4m3, width: 2))
}

// (3) A PRICED HEADROOM RAISES THE GATE AND THE READING TO THE SAME NUMBER. The review caught the discharge
// comparing holds against floor+headroom while REPORTING the floor: with 8 GiB priced and 40 GiB held it said
// "39.25 GiB required" with an empty missing list, while the requirement it had actually tested was 47.25. So
// the priced total is what is quoted now, and a shortfall against it is a named term. The gate reads the same
// requirement function, so the 40 GiB tier that boots with the headroom unpriced is refused once it is priced --
// the two consumers move together, which is the property, not the number.
//
// WITH THE ROW Absent AS IT STANDS, WHAT BOOT ENFORCES IS THE STAGED POPULATION AND NOTHING MORE: the row is
// srv1_l2_store_window_headroom, boot reads it through srv1_kv_tier_verdict, and an unpriced term adds zero.
// That is deliberate -- an unknown is not a quantity an operator can be refused for -- but it is named here
// rather than left to be discovered, because the same silence is what made the old reading report a requirement
// it had not tested.
test fn a_priced_store_window_raises_the_gate_and_the_reading_to_the_same_number() -> Bool {
  let eight = gibibyte_to_byte_size(g: gibibyte(count: 8))
  let floor_only = match srv1_l1_staging_requirement(config: srv1_admitted_launch_config, headroom: Absent) {
    Accepted { value: v, diagnostics: _ } => byte_size_count(b: v)
    Rejected { diagnostics: _ } => 0
  }
  let priced = match srv1_l1_staging_requirement(
    config: srv1_admitted_launch_config,
    headroom: Present { value: eight }
  ) {
    Accepted { value: v, diagnostics: _ } => byte_size_count(b: v)
    Rejected { diagnostics: _ } => 0
  }
  let forty = cfg_tier(bytes: gibibyte_to_byte_size(g: gibibyte(count: 40)))
  let boots_unpriced = match srv1_kv_tier_verdict_with_headroom(
    config: forty,
    shape: srv1_replica_container_run_shape,
    budget: srv1_replica_host_budget,
    headroom: Absent
  ) {
    KvTiersAdmitted => true
    KvTierRefused { term: _, cause: _ } => false
  }
  let gate_term = match srv1_kv_tier_verdict_with_headroom(
    config: forty,
    shape: srv1_replica_container_run_shape,
    budget: srv1_replica_host_budget,
    headroom: Present { value: eight }
  ) {
    KvTiersAdmitted => "admitted" as String
    KvTierRefused { term: t, cause: _ } => srv1_kv_tier_term_name(term: t) as String
  }
  // what the reading QUOTES, and what it names as missing -- read apart and combined below, because a
  // requirement number and a gap list are two different claims and the review's finding was that one of them
  // was being computed and the other reported
  let discharge = srv1_l1_staging_discharge_with(config: forty, headroom: Present { value: eight })
  let quoted = match discharge {
    Accepted { value: d, diagnostics: _ } => match d {
      ContractDischarged { holds: _, requires: r } => Present { value: byte_size_count(b: r) }
      ContractUndischarged { holds: _, requires_at_least: r, missing: _ } => Present { value: byte_size_count(b: r) }
    }
    Rejected { diagnostics: _ } => Absent
  }
  let missing = match discharge {
    Accepted { value: ContractUndischarged { holds: _, requires_at_least: _, missing: m }, diagnostics: _ } => m
    _ => [] as List<Srv1L1MissingGap>
  }
  // the shortfall is the DECLARED variant carrying a computed reason with both numbers in it -- the identity is
  // typed and the legibility is the reason, and this control checks each of them for what it is
  let names_the_shortfall = any(
    missing,
    g => g.term == HoldsShortOfPricedRequirement
      && string_contains(s: g.reason as String, pattern: "short by ")
      && string_contains(s: g.reason as String, pattern: "48 GiB")
  )
  priced == floor_only + byte_size_count(b: eight)
    && floor_only > 0
    && boots_unpriced
    && gate_term == "l1-staging-floor"
    // the reading quotes the PRICED TOTAL, the same number the gate tested against, and it says so in the gap
    // list rather than reporting an empty one
    && match quoted {
      Present { value: v } => v == priced && names_the_shortfall
      Absent => false
    }
}

// A tier the engine cannot be TOLD about, refused before any sizing question is asked. LMCACHE_L1_GB takes a
// whole number of gibibytes, so a tier that is not one has no rendering: ceiling would install more tier than
// the authority row names, flooring less than the gate just admitted, and both leave the installed bytes
// describing a configuration the model does not hold. srv1's tier is whole by construction (the authority IS a
// GiB count), so this is the guard against the next edit, exercised against a byte that is not a GiB.
test fn a_tier_the_engine_cannot_be_told_in_whole_gibibytes_is_refused() -> Bool {
  let ragged = cfg_tier(bytes: byte_size(count: (48 * 1073741824) + 1))
  let gate = match srv1_kv_tier_verdict(
    config: ragged,
    shape: srv1_replica_container_run_shape,
    budget: srv1_replica_host_budget
  ) {
    KvTiersAdmitted => "admitted" as String
    KvTierRefused { term: t, cause: _ } => srv1_kv_tier_term_name(term: t) as String
  }
  gate == "l1-tier-not-whole-gib"
    && kv_refused_text(render: srv1_replica_engine_args_body(config: ragged), term: "l1-tier-not-whole-gib")
    && srv1_tier_is_whole_gib(value: srv1_lmcache_l1_bytes)
    && srv1_tier_is_whole_gib(value: srv1_lmcache_l2_bytes)
}

// THE DATED CAPTURES MUST STAY DISTINCT. The 2026-11-09 list is the evidence the cold-start and crash witnesses
// cite; the 2026-11-24 list is what today's render must equal. Written over one another, either the crash
// witness starts certifying bytes that were never crashed against, or the render stops being checkable -- which
// is how the 2026-11-09 window got its incident in the first place. So: same paths, same count, the helper
// unchanged by the window (it moved the tier and the ceiling, not the helper), and the launcher moved.
test fn the_two_dated_install_receipts_stay_distinct_captures() -> Bool {
  let before = srv1_installed_boot_path_artifacts_2026_11_09
  let now_row = srv1_installed_boot_path_artifacts_2026_11_24
  let helper_before = first_where(
    xs: before,
    keep: a => (a.host_path as String) == "/usr/local/sbin/lil-replica"
  )
  let helper_now = first_where(
    xs: now_row,
    keep: a => (a.host_path as String) == "/usr/local/sbin/lil-replica"
  )
  let launcher_before = first_where(
    xs: before,
    keep: a => (a.host_path as String) == "/usr/local/sbin/lil-replica-launch"
  )
  let launcher_now = first_where(
    xs: now_row,
    keep: a => (a.host_path as String) == "/usr/local/sbin/lil-replica-launch"
  )
  let helper_same = match helper_before {
    Absent => false
    Present { value: b } => match helper_now {
      Absent => false
      Present { value: n } => (b.render_sha256 as String) == (n.render_sha256 as String)
    }
  }
  let launcher_moved = match launcher_before {
    Absent => false
    Present { value: b } => match launcher_now {
      Absent => false
      Present { value: n } => (b.render_sha256 as String) != (n.render_sha256 as String)
    }
  }
  length(before) == length(now_row) && helper_same && launcher_moved
}

// THE MISSING FLEET RESERVATION, AS ITS OWN CLAIM. gunbc.serving.serving_reservation has no srv1 entry, so the
// host's replica budget is charged against its whole usable RAM with nothing withheld for the runner, sshd or
// page cache. Carried as a control rather than only a comment because the fit above is what makes it safe to
// forget: 197.6 GiB of ceilings against 502.25 GiB of MemTotal leaves room, and a reader who sees only the
// margin will not go looking for the term that is missing. If this goes red, a srv1 reservation has been
// AUTHORED -- that is the model getting better, and this claim retires with the finding, it does not get
// reverted.
test fn srv1_has_no_fleet_memory_reservation_row_yet() -> Bool {
  match host_memory_reserved(host: operator_host_srv1) {
    Absent => true
    Present { value: v } => byte_size_count(b: v) == 0
  }
}


// ── THE EMERGENCY VALVE ON THE LAUNCHER'S OWN FACE ────────────────────────────────────────────
//
// WHY THESE CONTROLS EXIST. Under --l2-store-policy checkpoint_on_evict the RAM tier is the only path to
// disk, and --emergency-evict-for-prefetch is the flag that would make room in it for a checkpoint
// arriving FROM disk. The host passes it for GLM models and not for qwen38-flash-next (operator's
// 2026-11-24 reading), so srv1 runs without it. Two failures had to be made impossible, and each control
// below kills one of them:
//   (a) SILENCE. An empty launcher-face list says the same thing whether somebody declined or nobody ever
//       asked. So the per-profile answer is a closed sum, and the boot path refuses bytes for a profile
//       whose answer is Unstated — `an_unanswered_profile_gets_no_engine_bytes`.
//   (b) A RENDER THAT INVENTS THE FLAG. The host's bytes are the authority for what the host runs, so the
//       decline must contribute NO token: `the_declined_valve_adds_no_token_to_the_argv` is what keeps the
//       digests pinned above from moving, and it is the reason the decline is an accepted state rather
//       than a refusal.
// The gate itself must not be walkable by choosing the other byte producer: `both_byte_producers_bind_the_
// valve_gate` checks the one function the launcher and the args file both bind.

// The admitted config with ONLY its profile changed, so a control over the per-profile answer can vary
// exactly the field the answer is keyed on (the cfg_shape pattern above, for the same reason).
fn cfg_profile(name: NonEmptyStr) -> Srv1LaunchConfig {
  let a = srv1_admitted_launch_config
  Srv1LaunchConfig {
    tensor_parallel_size: a.tensor_parallel_size,
    kv_cache_dtype: a.kv_cache_dtype,
    profile: name,
    hardware: a.hardware,
    lmcache_l1: a.lmcache_l1,
    max_model_len: a.max_model_len,
    image_digest: a.image_digest,
    lil_replicas: a.lil_replicas,
    host_gpu_p2p: a.host_gpu_p2p,
    engine_executable: a.engine_executable,
    lmcache_l2_placement: a.lmcache_l2_placement,
    checkpoint_retention: a.checkpoint_retention,
    tls_material: a.tls_material,
    api_key_reference: a.api_key_reference,
    container_port: a.container_port,
  }
}

fn valve_rejects(render: Outcome<String>) -> Bool {
  match render {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } => string_contains(
      s: diagnostics_reason_lexemes(diagnostics: d),
      pattern: "srv1_emergency_valve_unstated"
    )
  }
}

// THE RED. A profile nobody has answered for — a GLM one included, the family the operator DOES pass the
// valve for — gets no engine bytes at all: no args file, so nothing to install and no digest to record.
// The refusal is typed and names itself; and the discrimination is that the SAME config with srv1's own
// profile still renders, so this control can only be failing on the profile's answer.
test fn an_unanswered_profile_gets_no_engine_bytes() -> Bool {
  let glm = cfg_profile(name: "glm-5.3-flash" as NonEmptyStr)
  valve_rejects(render: srv1_replica_engine_args_body(config: glm))
    && !srv1_emergency_evict_decision_is_stated(d: srv1_emergency_valve_decision(config: glm))
    && match srv1_replica_engine_args_body(config: srv1_admitted_launch_config) {
      Accepted { value: _, diagnostics: _ } => true
      Rejected { diagnostics: _ } => false
    }
    && srv1_emergency_evict_decision_is_stated(d: srv1_emergency_valve_decision(config: srv1_admitted_launch_config))
    && srv1_emergency_evict_decision_is_stated(d: srv1_emergency_evict_decision_for(profile: srv1_admitted_launch_config.profile))
    && !srv1_emergency_evict_decision_is_stated(d: srv1_emergency_evict_decision_for(profile: "glm-5.3-flash" as NonEmptyStr))
    && srv1_emergency_valve_must_be_stated()
}

// THE GATE IS NOT WALKABLE. The launcher and the engine args file bind ONE check; an unanswered profile
// fails it, srv1's admitted config passes it. A second producer with its own (weaker) check is exactly
// how the tier contract was walked around before it moved inside the byte producers.
test fn both_byte_producers_bind_the_valve_gate() -> Bool {
  let glm = cfg_profile(name: "glm-5.3-flash" as NonEmptyStr)
  match srv1_boot_bytes_check(config: glm) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } => string_contains(
      s: diagnostics_reason_lexemes(diagnostics: d),
      pattern: "srv1_emergency_valve_unstated"
    )
  }
    && match srv1_boot_bytes_check(config: srv1_admitted_launch_config) {
      Accepted { value: v, diagnostics: _ } => v
      Rejected { diagnostics: _ } => false
    }
    && match srv1_emergency_valve_check(config: glm) {
      Accepted { value: _, diagnostics: _ } => false
      Rejected { diagnostics: _ } => true
    }
}

// THE FINDING IS LEGIBLE, AND IT NAMES WHOSE READING IT RESTS ON. srv1's profile declines the valve; the
// decline carries a standing whose read obligation points at the lab launcher's source, because nothing
// here claims to know what the flag does. An obligation-free decline would be the flag name read off a
// brief and dressed as a decision.
test fn the_declined_valve_carries_the_reading_it_rests_on() -> Bool {
  match srv1_emergency_valve_decline_standing(config: srv1_admitted_launch_config) {
    Absent => false
    Present { value: st } => match cited_figure_read_obligation(standing: st) {
      Absent => false
      Present { value: o } => string_contains(s: o as String, pattern: "launcher.py")
        && string_contains(s: o as String, pattern: "--emergency-evict-for-prefetch")
        && string_contains(s: o as String, pattern: "GLM")
    }
  }
    && string_contains(s: srv1_emergency_evict_read_obligation as String, pattern: "admitted image")
}

// THE DECLINE ADDS NOTHING, WHICH IS WHY THE PINNED DIGESTS DID NOT MOVE. No token on any face, and the
// flags the launch record carries are empty — but derived from the answer, never written as [] (which is
// the silence this whole section exists to remove).
test fn the_declined_valve_adds_no_token_to_the_argv() -> Bool {
  let argv = srv1_replica_engine_argv(config: srv1_admitted_launch_config)
  !any(argv, t => (t as String) == "--emergency-evict-for-prefetch")
    && length(srv1_emergency_evict_launcher_tokens(d: srv1_emergency_evict_decision_for(profile: srv1_admitted_launch_config.profile))) == 0
    && length(srv1_emergency_evict_launcher_flags(d: srv1_emergency_evict_decision_for(profile: srv1_admitted_launch_config.profile))) == 0
    && length(srv1_serving_launch.launcher_flags) == 0
    && length(srv1_emergency_evict_launcher_flags(d: EmergencyEvictDeclined {
      why: "x" as NonEmptyStr,
      standing: TranscribedUncited { read_obligation: srv1_emergency_evict_read_obligation },
    })) == 0
    && length(srv1_emergency_evict_launcher_flags(d: EmergencyEvictUnstated {
      obligation: srv1_emergency_evict_read_obligation,
    })) == 0
}


// ── class B4 follow-up: the checkpoint-protection knob, and the disk end of the same contract ───────
//
// THE UNDISCHARGED PART OF CLASS B4. The staging contract prices getting a checkpoint OUT of L1; nothing
// priced its being there when the conversation came back. The only thing between a fresh L2 checkpoint and
// the eviction path is LMCACHE_CHECKPOINT_PROTECTED_SHARE, whose mechanism no row had read and whose one
// measured run (2026-11-24, ad hoc on srv1's LMCache log) reported outcome=none for 2172 of 2173 requests.
// These controls hold the three things that repair has to keep true: the observation stays an observation
// with its instrument and obligation; the contract cannot be reported kept while the mechanism is unread,
// however large the tier; and the contradiction between our two declared numbers is priced rather than
// noted. The disk-end controls beside them hold the anchor: the guard's floor is the tier authority, the
// requirement is a SUM over the roster, and an unread filesystem is not an admissible one.

// The reading is carried with the standing and the instrument that make it checkable at all: the outcome
// string, both counts, the log it came from, and an obligation naming the file to read and the field whose
// meaning the counts depend on. A figure without its instrument is how this class survives review.
test fn the_protection_knob_carries_the_run_that_refuted_it() -> Bool {
  match srv1_checkpoint_protection_reading {
    ProtectionRefutedByRun {
      outcome: o, outcome_count: n, observed_total: t, instrument: i, standing: _
    } =>
      (o as String) == "none"
        && n == 2172
        && t == 2173
        && string_contains(s: i as String, pattern: "serve.log")
        && string_contains(s: i as String, pattern: "2026-11-24")
        && match srv1_checkpoint_protection_standing(r: srv1_checkpoint_protection_reading) {
          Present { value: st } => match cited_figure_read_obligation(standing: st) {
            Present { value: ob } =>
              string_contains(s: ob as String, pattern: "/opt/lil/runtime/cache.py")
                && string_contains(s: ob as String, pattern: "outcome=none")
                && string_contains(s: ob as String, pattern: "admitted image digest")
            Absent => false
          }
          Absent => false
        }
    ProtectionConfirmedByUpstreamRead { instrument: _, standing: _ } => false
    ProtectionUnread { obligation: _ } => false
  }
}

// The gap list the discharge reports for a given protection reading, at a fixed config and a priced
// headroom. A plain fn, because the only difference between the three arms a control can name is which
// reading it hands the discharge — production is not among them, it can only pass the row.
fn gaps_with_protection(reading: Srv1CheckpointProtectionReading) -> List<Srv1L1MissingGap> {
  match srv1_l1_staging_discharge_with_reading(
    config: srv1_admitted_launch_config,
    headroom: Present { value: gibibyte_to_byte_size(g: gibibyte(count: 8)) },
    protection: reading
  ) {
    Accepted { value: d, diagnostics: _ } => match d {
      ContractDischarged { holds: _, requires: _ } => [] as List<Srv1L1MissingGap>
      ContractUndischarged { holds: _, requires_at_least: _, missing: m } => m
    }
    Rejected { diagnostics: _ } => [] as List<Srv1L1MissingGap>
  }
}

// THE LADDER, authorable: only a read of the mechanism retires the term. Production can pass nothing but
// the row; these controls pass the arms a reading would land in, which is what makes the honest arm provable
// and the dishonest one unavailable.
test fn only_a_read_of_the_mechanism_retires_the_protection_term() -> Bool {
  let obligation = "read the eviction controller in the admitted image digest" as NonEmptyStr
  let confirmed = ProtectionConfirmedByUpstreamRead {
    instrument: "the eviction controller's source, read in the admitted image digest" as NonEmptyStr,
    standing: TranscribedUncited { read_obligation: obligation },
  }
  let refuted = ProtectionRefutedByRun {
    outcome: "none" as NonEmptyStr,
    outcome_count: 2172,
    observed_total: 2173,
    instrument: "srv1 serve.log, ad hoc" as NonEmptyStr,
    standing: TranscribedUncited { read_obligation: obligation },
  }
  let unread = ProtectionUnread { obligation: obligation }
  let with_confirmed = gaps_with_protection(reading: confirmed)
  let with_refuted = gaps_with_protection(reading: refuted)
  let with_unread = gaps_with_protection(reading: unread)
  // the term retires ONLY under the read arm, and the other three terms are unaffected by it
  !any(with_confirmed, g => g.term == CheckpointProtectionUnbacked)
    && any(with_refuted, g => g.term == CheckpointProtectionUnbacked)
    && any(with_unread, g => g.term == CheckpointProtectionUnbacked)
    && length(with_refuted) == length(with_confirmed) + 1
    && length(with_unread) == length(with_confirmed) + 1
    && srv1_checkpoint_protection_is_backed(r: confirmed)
    && !srv1_checkpoint_protection_is_backed(r: refuted)
    && !srv1_checkpoint_protection_is_backed(r: unread)
}

// THE DISCRIMINATING RED: a tier large enough for every priced term, and a priced store window, still do not
// buy "the contract is kept" while the protection link is unread. This is the half the 2026-11-25 host read
// demanded — 48 GiB moved the problem without discharging the contract, and the model must not be able to
// say otherwise at any size.
test fn no_tier_size_buys_the_contract_while_the_knob_is_unread() -> Bool {
  let huge = cfg_tier(bytes: gibibyte_to_byte_size(g: gibibyte(count: 200)))
  let priced = Present { value: gibibyte_to_byte_size(g: gibibyte(count: 8)) }
  match srv1_l1_staging_discharge_with(config: huge, headroom: priced) {
    Accepted { value: d, diagnostics: _ } => match d {
      // 200 GiB clears every priced term, so the ONLY thing keeping this from ContractDischarged is the
      // unread knob — and the arm that reports it names the term rather than shrugging
      ContractDischarged { holds: _, requires: _ } => false
      ContractUndischarged { holds: _, requires_at_least: _, missing: m } =>
        any(m, g => g.term == CheckpointProtectionUnbacked)
          && !any(m, g => g.term == HoldsShortOfPricedRequirement)
    }
    Rejected { diagnostics: _ } => false
  }
}

// The two numbers WE declared, priced against each other: 5000 bp protected leaves 5000 bp evictable, under
// the 8000 bp the 0.80 watermark tells the controller to hold. And the two arms beside it prove the verdict
// is arithmetic and not a verdict about the setting's name: a share small enough to leave the watermark
// reachable is consistent, and a profile that declares no protection at all is not called contradictory.
test fn the_two_declared_numbers_are_priced_against_each_other() -> Bool {
  let srv1_verdict_ok = match srv1_checkpoint_protection_verdict_for_srv1 {
    ContradictUnderTheirPlainReading { evictable_share: e, watermark_target: w, why: reason } =>
      basis_point_count(bp: e) == 5000
        && basis_point_count(bp: w) == 8000
        && string_contains(s: reason as String, pattern: "outcome=none")
    KnobsConsistentUnderTheirPlainReading => false
  }
  let reachable = match srv1_checkpoint_protection_verdict(
    retention: Srv1CheckpointRetentionPolicy {
      protected_share: basis_point(count: 1500),
      protection_window: second(count: 1800),
    },
    watermark: srv1_lmcache_l2_eviction_watermark
  ) {
    KnobsConsistentUnderTheirPlainReading => true
    ContradictUnderTheirPlainReading { evictable_share: _, watermark_target: _, why: _ } => false
  }
  let unprotected = match srv1_checkpoint_protection_verdict(
    retention: Srv1CheckpointRetentionPolicy {
      protected_share: basis_point(count: 0),
      protection_window: second(count: 1800),
    },
    watermark: srv1_lmcache_l2_eviction_watermark
  ) {
    KnobsConsistentUnderTheirPlainReading => true
    ContradictUnderTheirPlainReading { evictable_share: _, watermark_target: _, why: _ } => false
  }
  srv1_verdict_ok
    && reachable
    && unprotected
    && basis_point_count(bp: srv1_checkpoint_protected_share) == 5000
    && permille_count(p: srv1_lmcache_l2_eviction_watermark) == 800
    && second_count(s: srv1_checkpoint_protection_window) == 1800
}

// ONE AUTHORITY FOR THE KNOB, both paths to the same container. The boot args and the provisioned launch
// used to hold it twice — typed 5000 bp on one path, the literal "0.5" on the other — so a change on either
// side would have produced two different retention policies from one model. The key is now the upstream's
// single spelling too, which is the same defect one level down (a name written twice drifts silently).
test fn the_retention_knob_renders_from_one_authority_on_both_paths() -> Bool {
  let operand = fixed_point_trimmed_wire(
    value: basis_point_count(bp: srv1_checkpoint_protected_share) as Int,
    decimals: 4
  )
  let boot = match srv1_render_replica_engine_args() {
    Accepted { value: body, diagnostics: _ } =>
      string_contains(s: body, pattern: concat(lil_serve_environment_key_checkpoint_protected_share as String, concat("=", operand)))
    Rejected { diagnostics: _ } => false
  }
  let provisioned = first_where(
    xs: srv1_serving_launch.environment,
    keep: e => (e.key as String) == (lil_serve_environment_key_checkpoint_protected_share as String)
  )
  let provisioned_ok = match provisioned {
    Absent => false
    Present { value: e } => (e.value as String) == operand
  }
  boot && provisioned_ok && operand == "0.5"
}

// The guard's floor IS the tier authority, not a literal that can be moved without moving what it guards;
// and what the anchor prices is the SUM over the roster, which is the quantity a per-card reading can never
// discharge. Both are equality on derived values, so the day someone re-introduces a copy this goes red.
test fn the_disk_floor_is_the_tier_authority_and_the_requirement_is_a_sum() -> Bool {
  byte_size_count(b: srv1_disk_guard_contract.required_free_per_replica)
    == byte_size_count(b: srv1_lmcache_l2_bytes)
    && byte_size_count(b: srv1_l2_capacity_requirement())
      == byte_size_count(b: srv1_lmcache_l2_bytes) * length(srv1_serving_replica_roster)
    && byte_size_count(b: srv1_disk_guard_contract.required_free_per_replica) == 125 * 1073741824
}

// THE ANCHOR, arm by arm. srv1 today is admitted on the row it actually has; a tier the filesystem cannot
// hold is refused; an UNREAD filesystem is refused rather than treated as roomy; and two replicas on one KV
// directory are refused until somebody reads what that does to LMCache's store — which lifts the moment the
// permission is stated, so the refusal is a reading obligation and not a prohibition.
test fn the_l2_anchor_refuses_a_sum_the_disk_cannot_hold() -> Bool {
  let tier = srv1_lmcache_l2_bytes
  let replicas = length(srv1_serving_replica_roster)
  let free = srv1_l2_free_space()
  // The anchor must be an ACTUAL reading today, or the whole gate below is vacuous: an unread filesystem would
  // make every arm here refuse, including the one that is supposed to admit srv1 as it stands.
  let anchor_is_a_reading = match free {
    Present { value: f } => byte_size_count(b: f) > 0
    Absent => false
  }
  let srv1_admitted = match srv1_l2_capacity_verdict(
    tier: tier,
    replicas: replicas,
    free: free,
    sharing_permission_read: false,
    roster_shares_one_store: false
  ) {
    AnchorAdmitted { requires: requires, free: f } =>
      byte_size_count(b: requires) == byte_size_count(b: tier) * replicas
        // The margin is real and THIN: it holds the two tiers and less than one more. That is what says the
        // anchor is the ONE FILESYSTEM's reading and not a card's — price the same requirement against a
        // card's own free space (125 GiB, the other figure in circulation) and this arm comes back
        // AnchorExceeded, not admitted. Written without a subtraction so no negative count can be formed.
        && byte_size_count(b: f) >= byte_size_count(b: requires)
        && byte_size_count(b: f) < byte_size_count(b: requires) + byte_size_count(b: tier)
    AnchorUnread { why: _ } => false
    AnchorExceeded { requires: _, free: _ } => false
    StoreLayoutUnread { replicas: _ } => false
  }
  let too_big = match srv1_l2_capacity_verdict(
    tier: gibibyte_to_byte_size(g: gibibyte(count: 200)),
    replicas: replicas,
    free: free,
    sharing_permission_read: false,
    roster_shares_one_store: false
  ) {
    AnchorExceeded { requires: _, free: _ } => true
    _ => false
  }
  let unread_is_not_admissible = match srv1_l2_capacity_verdict(
    tier: tier,
    replicas: replicas,
    free: Absent,
    sharing_permission_read: false,
    roster_shares_one_store: false
  ) {
    AnchorUnread { why: _ } => true
    _ => false
  }
  let shared_store_unread_refuses = match srv1_l2_capacity_verdict(
    tier: tier,
    replicas: replicas,
    free: free,
    sharing_permission_read: false,
    roster_shares_one_store: true
  ) {
    StoreLayoutUnread { replicas: _ } => true
    _ => false
  }
  let shared_store_read_is_admitted = match srv1_l2_capacity_verdict(
    tier: tier,
    replicas: replicas,
    free: free,
    sharing_permission_read: true,
    roster_shares_one_store: true
  ) {
    AnchorAdmitted { requires: _, free: _ } => true
    _ => false
  }
  // the production gate reads the rows, and srv1 passes it today (so the host's pinned bytes still render)
  let production_admits = match srv1_l2_capacity_check() {
    Accepted { value: v, diagnostics: _ } => v
    Rejected { diagnostics: _ } => false
  }
  // ...and the permission really is unread: the refusal above is a reading obligation, not a policy ban
  let permission_unread = !srv1_l2_store_sharing_is_read(s: srv1_l2_store_sharing)
    && match srv1_l2_store_sharing {
      SharingUnread { obligation: o } =>
        string_contains(s: o as String, pattern: "namespace")
          && string_contains(s: o as String, pattern: "ADMITTED IMAGE DIGEST")
      MayShareOneStore { evidence: _, standing: _ } => false
      MayNotShareOneStore { evidence: _, standing: _ } => false
    }
  anchor_is_a_reading
    && srv1_admitted
    && too_big
    && unread_is_not_admissible
    && shared_store_unread_refuses
    && shared_store_read_is_admitted
    && production_admits
    && permission_unread
    && !srv1_l2_roster_shares_one_store()
}
