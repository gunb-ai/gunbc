module test.claim.serving.turn_admission_witness

import std.types { Bool, String, NonEmptyStr }
import v2.std.optional { Present, Absent }
import product.fabric.demand { ObservationReceiptRef }
import product.fabric.selection { AvailableIndefinitely, NoTransitionRequired, NoFeasibleAlternativeUse }
import gunbc.spark.fabric_switch_observed { FabricGroupA, FabricGroupB }
import gunbc.spark.vllm_endpoint_process_launch {
  vllm_endpoint_process_launch, vllm_endpoint_process_launch_key, vllm_endpoint_process_launch_is,
  LaunchObserved, LaunchUnobserved,
}
import gunbc.serving.turn_admission {
  ServingQueueReading, QueueDepthRead, QueueDepthUnread, GroupIdle, serving_co_tenancy,
  ServingSeatOccupancy, NoSeatHeld, SeatsHeldForTurns, SeatOccupancyUnread, ServingGroupAdmission,
  AdmissibleForColdPrefill, InadmissibleActiveInteractiveTurn, AdmissibilityUnread,
  serving_group_admission, serving_admission_detail, serving_availability, serving_transition_cost,
  serving_opportunity_cost,
}
import gunbc.harness.harness_backend {
  harness_gauge_count, harness_queue_from_body, harness_launch_from_body,
}

data probe_receipt: ObservationReceiptRef = "test.claim.serving.turn_admission_witness" as ObservationReceiptRef

fn admission_of(reading: ServingQueueReading) -> ServingGroupAdmission {
  serving_group_admission(tenancy: serving_co_tenancy(reading: reading), seats: NoSeatHeld, receipt: probe_receipt)
}

fn admission_with_seats(reading: ServingQueueReading, seats: ServingSeatOccupancy) -> ServingGroupAdmission {
  serving_group_admission(tenancy: serving_co_tenancy(reading: reading), seats: seats, receipt: probe_receipt)
}

fn metrics_body(waiting: String, running: String, start: String) -> String {
  join([
    "# HELP vllm:num_requests_waiting Number of requests waiting.\n",
    "# TYPE vllm:num_requests_waiting gauge\n",
    "vllm:num_requests_waiting\{model_name=\"deepseek\"} ", waiting, "\n",
    "# TYPE vllm:num_requests_running gauge\n",
    "vllm:num_requests_running\{model_name=\"deepseek\"} ", running, "\n",
    "# HELP process_start_time_seconds Start time of the process since unix epoch in seconds.\n",
    "# TYPE process_start_time_seconds gauge\n",
    "process_start_time_seconds ", start, "\n",
  ], "")
}

// ── A POSITIVE FLOAT IS A COUNT, WHICH IS THE REGRESSION THIS CONTROL EXISTS FOR ──────────────
//
// The reading that shipped parsed the gauge value as an integer, failed on the ordinary float
// rendering, and returned 1 for every positive value. So waiting=4.0 and running=3.0 both read as 1,
// and those ones were used as counts. This control is discriminating in exactly that direction: it
// goes red on the collapse, and it goes red on a parser that refuses floats altogether.
test fn positive_float_gauges_parse_exactly() -> Bool {
  match harness_queue_from_body(body: metrics_body(waiting: "4.0", running: "3.0", start: "1757200000.5")) {
    QueueDepthRead { waiting: w, running: r } => w == 4 && r == 3
    QueueDepthUnread { obligation: _ } => false
  }
}

test fn a_zero_float_gauge_is_zero_and_not_unread() -> Bool {
  match harness_queue_from_body(body: metrics_body(waiting: "0.0", running: "0.0", start: "1757200000.5")) {
    QueueDepthRead { waiting: w, running: r } => w == 0 && r == 0
    QueueDepthUnread { obligation: _ } => false
  }
}

// A COUNT WITH A FRACTION IS NOT A COUNT THIS READER CAN NAME, so it produces no reading rather than
// a plausible integer. The arm that rounded it to something would be the fabrication the whole
// admission rule depends on not doing.
test fn a_non_integral_gauge_is_unread_rather_than_rounded() -> Bool {
  (match harness_queue_from_body(body: metrics_body(waiting: "1.5", running: "0.0", start: "1757200000.5")) {
     QueueDepthUnread { obligation: o } => string_contains(s: o as String, pattern: "not an exact count")
     QueueDepthRead { waiting: _, running: _ } => false
   })
    && (match harness_gauge_count(text: "1.5") { Absent => true  Present { value: _ } => false })
    && (match harness_gauge_count(text: "12") { Present { value: n } => n == 12  Absent => false })
    && (match harness_gauge_count(text: " 7.00 ") { Present { value: n } => n == 7  Absent => false })
}

// BOTH GAUGES OR NEITHER. A body carrying waiting and not running leaves the admission rule with
// half an observation, and the half that would be defaulted is the one that decides.
test fn a_body_missing_one_gauge_reads_neither() -> Bool {
  let half = join([
    "vllm:num_requests_waiting\{model_name=\"deepseek\"} 0.0\n",
    "process_start_time_seconds 1757200000.5\n",
  ], "")
  match harness_queue_from_body(body: half) {
    QueueDepthUnread { obligation: o } => string_contains(s: o as String, pattern: "running-requests series")
    QueueDepthRead { waiting: _, running: _ } => false
  }
}

// THE DISPOSITION IS READ BY ONE EXHAUSTIVE MATCH, not by a pair of Bool predicates over the same
// coproduct. Production branches on the arms directly (gunbc.harness.harness_seat
// harness_add_candidate); this witness needs a comparable value, so it derives one here, and because
// the match is exhaustive a fourth admission arm reds this file instead of defaulting quietly.
fn t_disposition(a: ServingGroupAdmission) -> String {
  match a {
    AdmissibleForColdPrefill { receipt: _ } => "admissible"
    InadmissibleActiveInteractiveTurn { occupied_by: _, basis: _ } => "pending-retry"
    AdmissibilityUnread { obligation: _ } => "pending-measure"
  }
}

// ── UNREAD IS NOT IDLE ────────────────────────────────────────────────────────────────────────
//
// The discriminating case for the third state. A consumer that cannot read the gauges is refused,
// its cause says it was UNREAD rather than occupied, and the refusal is not retryable -- waiting
// does not turn an unreadable group into a readable one, so the remedy is instrumentation.
test fn unreadable_admission_evidence_never_admits() -> Bool {
  let a = admission_of(reading: QueueDepthUnread { obligation: "the metrics endpoint did not answer" as NonEmptyStr })
  (match a { AdmissibilityUnread { obligation: o } => string_contains(s: o as String, pattern: "did not answer")  _ => false })
    && (t_disposition(a: a) != "admissible")
    && (t_disposition(a: a) != "pending-retry")
    && string_contains(s: serving_admission_detail(group: FabricGroupA, admission: a), pattern: "occupancy unread, which is not idle")
}

// ── AN OCCUPIED GROUP IS NOT A WORSE CANDIDATE; IT IS NOT A CANDIDATE ─────────────────────────
//
// This is the whole reversal. The design this replaces bound the occupied group, priced its
// co-tenancy on the opportunity axis, and let the ranking decide -- which places the arriving cold
// prefill beside a live decode whenever the alternatives look worse. Here it is refused, and the
// refusal is RETRYABLE, because the group frees itself.
test fn an_occupied_group_refuses_a_fresh_cold_prefill() -> Bool {
  let a = admission_of(reading: QueueDepthRead { waiting: 0, running: 1 })
  (match a { InadmissibleActiveInteractiveTurn { occupied_by: n, basis: _ } => n == 1  _ => false })
    && (t_disposition(a: a) != "admissible")
    && (t_disposition(a: a) == "pending-retry")
    && string_contains(s: serving_admission_detail(group: FabricGroupB, admission: a), pattern: "stall a decode already being read")
}

// A GROUP WITH WORK WAITING IS NOT IDLE EITHER. The request admitted and waiting starts the moment
// the engine frees, so a cold prefill placed in front of it produces the same overlap one scheduler
// step later. A reading that looked only at the running gauge would admit here.
test fn a_queued_group_is_not_idle() -> Bool {
  let a = admission_of(reading: QueueDepthRead { waiting: 2, running: 0 })
  (match a { InadmissibleActiveInteractiveTurn { occupied_by: n, basis: _ } => n == 2  _ => false })
    && (t_disposition(a: a) != "admissible")
}

test fn an_idle_group_is_admissible_and_a_read_zero_is_a_reading() -> Bool {
  let a = admission_of(reading: QueueDepthRead { waiting: 0, running: 0 })
  (t_disposition(a: a) == "admissible")
    && (t_disposition(a: a) != "pending-retry")
    && (match serving_co_tenancy(reading: QueueDepthRead { waiting: 0, running: 0 }) { GroupIdle => true  _ => false })
}

// ── NOTHING IS PLACED WHEN NOTHING IS ADMISSIBLE, AND THE TWO REASONS STAY APART ──────────────
//
// A consumer that reads nothing gets neither group. A consumer whose groups are all busy gets
// neither group either -- but the two answers differ in whether a retry is the remedy, and fusing
// them would make an unreadable fleet look like a busy one.
test fn no_admissible_group_and_the_reasons_do_not_fuse() -> Bool {
  let unread = admission_of(reading: QueueDepthUnread { obligation: "this consumer does not read the served metrics" as NonEmptyStr })
  let busy = admission_of(reading: QueueDepthRead { waiting: 0, running: 3 })
  (t_disposition(a: unread) != "admissible")
    && (t_disposition(a: busy) != "admissible")
    && (t_disposition(a: busy) == "pending-retry")
    && (t_disposition(a: unread) != "pending-retry")
}

// ── THE COST AXES CARRY NO ESTIMATE, WHICH IS THE OTHER HALF OF THE CUT ───────────────────────
//
// The refuted execution model priced a transition as a per-token cold prefill and an opportunity as
// a whole-prefill victim stall. Both are withdrawn. An admitted candidate is idle, so it displaces
// nothing and requires no transition, and nothing here can spell a measured number it did not
// measure -- in particular there is no incumbency arm that would return a zero transition cost for a
// conversation whose prefix nobody observed.
test fn an_admitted_candidate_carries_no_priced_estimate() -> Bool {
  (match serving_transition_cost() { NoTransitionRequired => true  _ => false })
    && (match serving_opportunity_cost(receipt: probe_receipt) { NoFeasibleAlternativeUse { receipt: _ } => true  _ => false })
    && (match serving_availability(receipt: probe_receipt) { AvailableIndefinitely { delay: d, receipt: _ } => d.count == 0  _ => false })
}

// ── A RESTART IS A NEW OFFER SUBJECT ──────────────────────────────────────────────────────────
//
// Keyed on the group, group A's first invocation and its successor are one offer, and the
// predecessor's readiness, queue and capacity evidence price the successor. Keyed on the launch they
// are two, which is what lets a seat taken against one engine fail to authorize a request against
// the engine that replaced it.
test fn a_restarted_engine_is_a_different_offer_subject() -> Bool {
  let first = vllm_endpoint_process_launch(group: FabricGroupA, endpoint: "192.168.1.232" as NonEmptyStr, process_start_field: "1757200000.5" as NonEmptyStr)
  let second = vllm_endpoint_process_launch(group: FabricGroupA, endpoint: "192.168.1.232" as NonEmptyStr, process_start_field: "1757209999.25" as NonEmptyStr)
  let other_group = vllm_endpoint_process_launch(group: FabricGroupB, endpoint: "192.168.1.233" as NonEmptyStr, process_start_field: "1757200000.5" as NonEmptyStr)
  !vllm_endpoint_process_launch_is(launch: first, other: second)
    && !vllm_endpoint_process_launch_is(launch: first, other: other_group)
    && vllm_endpoint_process_launch_is(launch: first, other: first)
    && ((vllm_endpoint_process_launch_key(launch: first) as String) != (vllm_endpoint_process_launch_key(launch: second) as String))
}

// AND A LAUNCH THAT CANNOT BE NAMED IS NOT OFFERED, because the alternative is an offer keyed on the
// group -- the identity the launch key exists to replace.
test fn an_unnameable_launch_is_not_offered() -> Bool {
  let no_process_line = join([
    "vllm:num_requests_waiting\{model_name=\"deepseek\"} 0.0\n",
    "vllm:num_requests_running\{model_name=\"deepseek\"} 0.0\n",
  ], "")
  (match harness_launch_from_body(group: FabricGroupA, address: "192.168.1.232", body: no_process_line) {
     LaunchUnobserved { group: _, obligation: o } => string_contains(s: o as String, pattern: "cannot be named")
     LaunchObserved { launch: _, receipt: _ } => false
   })
    && (match harness_launch_from_body(group: FabricGroupA, address: "192.168.1.232", body: metrics_body(waiting: "0.0", running: "0.0", start: "1757200000.5")) {
          LaunchObserved { launch: l, receipt: _ } => (l.process_start_field as String) == "1757200000.5"
          LaunchUnobserved { group: _, obligation: _ } => false
        })
}

// ── A GRANTED SEAT IS OCCUPANCY THE GAUGES CANNOT YET SEE ─────────────────────────────────────
//
// THE DISCRIMINATING CASE, AND IT IS THE ONE THAT SHIPPED WRONG. The engine's gauges count what it
// has been HANDED. A placement whose seat was granted a moment ago, whose caller has not sent its
// request yet, reads zero on both gauges -- so a rule decided from the gauges alone admits a second
// cold prefill onto a group already committed to one, which is the overlap the rule exists to
// prevent. The seat ledger sees it, because a seat is taken before a request is sent.
//
// This control goes red on exactly the reading that shipped: gauges idle, one seat held, admitted.
test fn a_held_seat_is_occupancy_even_when_the_gauges_read_zero() -> Bool {
  let a = admission_with_seats(reading: QueueDepthRead { waiting: 0, running: 0 }, seats: SeatsHeldForTurns { held: 1 })
  (match a { InadmissibleActiveInteractiveTurn { occupied_by: n, basis: _ } => n == 1  _ => false })
    && (t_disposition(a: a) != "admissible")
    && (t_disposition(a: a) == "pending-retry")
}

// AND AN UNREADABLE LEDGER IS NOT AN EMPTY ONE, which is the same rule the gauges already obey: a
// pool that could not be read frees nobody by being waited for, so it is an obligation rather than a
// retry.
test fn an_unread_seat_ledger_never_admits() -> Bool {
  let a = admission_with_seats(reading: QueueDepthRead { waiting: 0, running: 0 }, seats: SeatOccupancyUnread { obligation: "the partition chain could not be walked" as NonEmptyStr })
  (match a { AdmissibilityUnread { obligation: o } => string_contains(s: o as String, pattern: "partition chain")  _ => false })
    && (t_disposition(a: a) != "admissible")
    && (t_disposition(a: a) != "pending-retry")
}

// BOTH CLOCKS CLEAR IS THE ONLY ADMITTING STATE, and the positive control says so rather than
// leaving the two refusals above to imply it.
test fn a_group_idle_on_both_readings_is_the_only_admitted_state() -> Bool {
  (t_disposition(a: admission_with_seats(reading: QueueDepthRead { waiting: 0, running: 0 }, seats: NoSeatHeld)) == "admissible")
    && (t_disposition(a: admission_with_seats(reading: QueueDepthRead { waiting: 0, running: 2 }, seats: NoSeatHeld)) != "admissible")
    && (t_disposition(a: admission_with_seats(reading: QueueDepthRead { waiting: 0, running: 0 }, seats: SeatsHeldForTurns { held: 3 })) != "admissible")
}
