module test.claim.serving.serving_benchmark_v2_inhabitance

import std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import std.types { Bool, String, List }
import std.optional { Present, Absent }
import std.measure { milli_tokens_per_second_count, events_per_hour_count }
import extdeps.filesystem.filesystem_io
import extdeps.gpu_bench.request_v2 { gpu_bench_parse_jsonl, GpuBenchRequestV2Parsed, GpuBenchRequestV2StreamUnreadable, GpuBenchRequestV2 }
import gunbc.serving.serving_benchmark { serving_benchmark_v1 }
import gunbc.serving.serving_benchmark_run_receipt {
  timed_requests, serving_level_result, LevelRead, LevelRefused, admit_serving_benchmark_run,
  ServingBenchmarkRunAdmitted, ServingBenchmarkRunRefused, GapMaxTokens, GapLevelRounds,
}
import test.claim.serving.serving_benchmark_run_receipt_witness { fx_cell_complete, fx_digest_a, fx_digest_b, fx_telemetry }
import gunbc.serving.serving_benchmark_run_receipt { ServingBenchmarkRunObservation }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// THE INHABITANCE CLAIM OF THE PER-REQUEST BOUNDARY (DESIGN section 3, the pairing obligation). The
// receipt witness supplies request/v2 lines; this claim reads lines the kit itself wrote: the first v2
// run on srv2 (PRO 6000 WS 600 W, NInfer NVFP4 KV), the same committed file
// test.claim.gpu_bench_v2_receipt_inhabitance_witness reads. It asserts the ROUTE: the real
// timestamps parse, the per-level folds compute from them, and the pinned serving-benchmark/1 refuses
// that run because it is a different workload (512-token outputs, levels 1/4/8). Deleting the file
// makes these claims red.
//
// The serving cell of a real run has no committed producer yet: its first is the srv3 realization
// (work item node://adhoc-ffb4b5c7-4a5, PR 2), whose receipt adds the cell's inhabitance claim.

data kit_v2_run_path: String = "fixtures/gpu_bench/pro6000ws_600w_v2/warm_ninfer_nvfp4_pro6000ws_600w.jsonl"

fn kit_rows() -> List<GpuBenchRequestV2> {
  match gpu_bench_parse_jsonl(text: filesystem_read(path: kit_v2_run_path).content) {
    GpuBenchRequestV2Parsed { records: rs } => rs
    GpuBenchRequestV2StreamUnreadable { line: _, cause: _ } => []
  }
}

test fn the_kit_run_folds_into_its_three_levels() -> Bool {
  let timed = timed_requests(requests: kit_rows())
  count(timed.gaps) == 0
    && count(timed.requests) == 268
    && match serving_level_result(requests: timed.requests, active: 8) {
      LevelRefused { gaps: _ } => false
      LevelRead { result: l } => l.rounds == 20 && l.completed_turns == 160 && milli_tokens_per_second_count(r: l.aggregate_end_to_end) > 0 && events_per_hour_count(r: l.completed_turns_per_hour) > 0
    }
    && match serving_level_result(requests: timed.requests, active: 1) {
      LevelRefused { gaps: _ } => false
      LevelRead { result: l } => l.rounds == 20 && milli_tokens_per_second_count(r: l.decode_median) > 0
    }
}

test fn serving_benchmark_v1_refuses_the_kit_run_as_another_workload() -> Bool {
  let observation = ServingBenchmarkRunObservation { cell: fx_cell_complete, session_text_digests: [fx_digest_a, fx_digest_b], requests: kit_rows(), telemetry: fx_telemetry }
  match admit_serving_benchmark_run(version: serving_benchmark_v1, observation: observation) {
    ServingBenchmarkRunAdmitted { receipt: _, levels: _ } => false
    ServingBenchmarkRunRefused { gaps: g } =>
      any(g, x => match x { GapMaxTokens { round: _, observed: _ } => true, _ => false })
        && any(g, x => match x { GapLevelRounds { active: a, observed: n } => a == 2 && n == 0, _ => false })
  }
}
