module test.claim.serving.scratch_merry_dump3

// SCRATCH, NOT FOR MERGE. And/or + negation spellings. DELETE when done.

import std.types { String }
import std.process { ExitSuccess }
import gunbc.cli_wire { CliWireResponse, CliWirePrintable }
import v2.std.diagnostic { diagnostics_reason_lexemes, Outcome }
import v2.workflow.bash_command_fold_serialize { bash_fold_serialize_node }
import v2.extdeps.languages.bash_build {
  bash_build_command_from_lits, bash_build_and_then, bash_build_or_else, bash_build_negation,
}

fn probe(label: String, outcome: Outcome<String>) -> String {
  match outcome {
    Accepted { value: v } => concat(label, concat(" OK[", concat(v, "]\n")))
    Rejected { diagnostics: d } =>
      concat(label, concat(" NO[", concat(diagnostics_reason_lexemes(diagnostics: d), "]\n")))
  }
}

fn cmd(word: String) -> Node {
  bash_build_command_from_lits(lits: [word])
}

fn main() -> CliWireResponse {
  CliWirePrintable {
    bytes: concat(
      concat(
        concat(
          "A1_ANDOR_NEG ",
          probe(
            label: "",
            outcome: bash_fold_serialize_node(
              stmt: bash_build_and_then(
                left: bash_build_or_else(left: cmd("true"), right: cmd("true")),
                right: bash_build_negation(inner: bash_build_or_else(left: cmd("false"), right: cmd("false")))
              )
            )
          )
        ),
        concat(
          "A2_OR_WITH_AND_LEFT ",
          probe(
            label: "",
            outcome: bash_fold_serialize_node(
              stmt: bash_build_or_else(
                left: bash_build_and_then(left: cmd("a"), right: cmd("b")),
                right: cmd("c")
              )
            )
          )
        )
      ),
      concat(
        concat(
          "A3_AND_WITH_OR_RIGHT ",
          probe(
            label: "",
            outcome: bash_fold_serialize_node(
              stmt: bash_build_and_then(left: cmd("a"), right: bash_build_or_else(left: cmd("b"), right: cmd("c")))
            )
          )
        ),
        concat(
          "A4_NEG_PLAIN ",
          probe(label: "", outcome: bash_fold_serialize_node(stmt: bash_build_negation(inner: cmd("false"))))
        )
      )
    ),
    exit: ExitSuccess,
  }
}
