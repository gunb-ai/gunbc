// The argv `docker inspect --format {{.Config.Cmd}} lil-flash-next` showed for the 2026-11-08 two-replica
// relaunch (L1=12, L2=125, disk-first KV, the pool context cap), with the two
// shell substitutions left as the wrapper writes them and the output redirect cut at its boundary (the
// wrapper's `>> $D/serve.log 2>&1` is shell, not argv). A LITERAL, deliberately: this is the reading the
// derivation is checked against, and restating it from the rows would make the check circular.
data observed_cmd_tail: List<String> = [
  "lil-serve",
  "--profile", "qwen38-flash-next",
  "--hardware", "rtx-pro-6000-pcie",
  "--env", "LMCACHE_MODE=ram-disk",
  "--env", "LMCACHE_L1_GB=12",
  "--env", "LMCACHE_L2_GB=125",
  "--env", "LMCACHE_L2_ROOT=/cache/kv",
  "--env", "LMCACHE_L2_WORKERS=16",
  "--env", "LMCACHE_L2_ODIRECT=1",
  "--env", "LMCACHE_CHECKPOINT_PROTECTED_SHARE=0.5",
  "--env", "LMCACHE_CHECKPOINT_PROTECTION_WINDOW_SECONDS=1800",
  "--",
  "--port", "18000",
  "--ssl-keyfile", "/root/serve/tls.key",
  "--ssl-certfile", "/root/serve/tls.crt",
  "--api-key", "$(cat /root/.pool_key)",
  "--max-model-len", "229376",
]

// THE BASH REALIZATION supplies its own key-read token to the render: the wrapper's command
// substitution, verbatim as `docker inspect` showed it. This is the ONLY place a witness spells the
// shell, and it spells it as an OBSERVATION (the token read off the container), never as something the
// model builds — srv1_serving_launch_argv takes it as a parameter (review 86807: no fn constructs
// shell syntax out of string literals into an argv; the substitution lives in the retained wrapper).
data bash_realization_key_read: NonEmptyStr = "\x24(cat /root/.pool_key)"

// THE RENDER EQUALS WHAT THE RUNNING CONTAINER SHOWED, element for element — including the key's file
// read spelled as a shell substitution and no secret value anywhere. This is the check that makes the
// argv a DERIVATION verified against an OBSERVATION, not a restatement of it. The observation is the
// 2026-10-31 08:02 relaunch at the pool context cap (gunbc.design_ruling one_serving_context_cap).
// THE RENDER EQUALS WHAT THE RUNNING CONTAINER SHOWED, element for element — including the key's file
// read spelled as a shell substitution and no secret value anywhere. This is the check that makes the
// argv a DERIVATION verified against an OBSERVATION, not a restatement of it.
//
// THE CAPTURE IS KEPT AS READ, TIER AND ALL. observed_cmd_tail is the 2026-11-08 relaunch, and its tier slot
// says 12 because that is what the tier was then; the tier moved to 48 on 2026-11-24 (read from the installed
// args files) and a capture does not move to keep a test green. So the equality is per-slot, with ONE slot
// permitted to differ — and it is permitted only when BOTH sides are that slot, with both figures named by
// the control below, so the exception cannot widen into a licence to differ anywhere.
test fn the_rendered_argv_equals_the_container_cmd_tail() -> Bool {
  zip_eq(a: srv1_serving_launch_argv(api_key_wire: bash_realization_key_read), b: observed_cmd_tail, eq: argv_slot_agrees)
}

// The one slot the 2026-11-24 window moved, recognised on both sides by the knob it names.
fn argv_slot_is_the_tier(value: NonEmptyStr) -> Bool {
  string_contains(s: value as String, pattern: "LMCACHE_L1_GB=")
}

fn argv_slot_agrees(derived: NonEmptyStr, captured: NonEmptyStr) -> Bool {
  (derived as String) == (captured as String)
    || (argv_slot_is_the_tier(value: derived) && argv_slot_is_the_tier(value: captured))
}

// The exception above is bounded: the capture holds the figure its own window read (12), the render holds the
// authority today (48), and nothing else in the argv differs. If someone re-bases the capture, or lets the
// derived row drift from the tier authority, this goes red by name rather than by a missing equality.
test fn the_tier_slot_is_the_only_difference_and_both_figures_are_named() -> Bool {
  let derived = srv1_serving_launch_argv(api_key_wire: bash_realization_key_read)
  let derived_tier = first_where(xs: derived, keep: argv_slot_is_the_tier)
  let captured_tier = first_where(xs: observed_cmd_tail, keep: argv_slot_is_the_tier)
  match derived_tier {
    Absent => false
    Present { value: d } => match captured_tier {
      Absent => false
      Present { value: c } => (d as String) == "LMCACHE_L1_GB=48" && (c as String) == "LMCACHE_L1_GB=12"
    }
  }
}

// ONE CAP, TWO ENGINES: srv1's vLLM launch and srv3's Strata flags both carry the pool cap from its one
// row, so moving the cap moves every engine and neither can drift alone. Each engine's own spelling of
// it is pinned by its render check (above for vLLM; extdeps.strata.serve_flags for Strata).
test fn both_pool_engines_carry_the_one_context_cap() -> Bool {
  (match srv1_serving_launch.engine.max_model_len { Present { value: n } => n == serving_fleet_context_cap _ => false })
    && srv3_strata_flags.launch.max_context == serving_fleet_context_cap
    && token_count_value(t: serving_fleet_context_cap) == 229376
}

// NO INVENTED FLAGS: every nvfp4/tier value the engine reports comes from lil-serve's own profile, not
// from argv, so the launch row carries none of them — a flag added here without a wrapper change would
// break this render check, which is the point. The context cap is the one flag, and it is the pool's.
test fn the_launch_carries_no_engine_flag_the_wrapper_does_not_pass() -> Bool {
  match srv1_serving_launch.engine {
    LilServeEngineFlags {
      served_model_name: mn, kv_cache_dtype: kv, memory: m, max_model_len: ml,
      max_num_seqs: ms, max_num_batched_tokens: mb, chunked_prefill: cp, prefix_caching: pc, unmodeled_tail: tail,
    } =>
      (match mn { Absent => true, _ => false })
        && (match kv { Absent => true, _ => false })
        && (match m { Absent => true, _ => false })
        && (match ml { Present { value: n } => n == serving_fleet_context_cap && token_count_value(t: n) == 229376 _ => false })
        && (match ms { Absent => true, _ => false })
        && (match mb { Absent => true, _ => false })
        && (match cp { Absent => true, _ => false })
        && (match pc { Absent => true, _ => false })
        && (length(xs: tail) == 0)
  }
}

// The LMCache tiers ARE in the wrapper, so they must be rows, and their wires render exactly as the
// container shows them.
test fn the_environment_tiers_wire_as_the_container_shows_them() -> Bool {
  srv1_serving_launch.environment
    == [
      lil_serve_environment_entry(key: "LMCACHE_MODE" as NonEmptyStr, value: "ram-disk" as NonEmptyStr),
      // THE ONE SLOT IN THIS LIST THAT IS NOT A LITERAL IS THE L1 TIER, and that is the point of it: the value
      // comes from gunbc.serving.serving_host_memory::srv1_lmcache_l1_gb_value, the same authority the boot args
      // are rendered from. It used to be the literal "12" — the figure read off the container on 2026-11-09 —
      // which provisioning handed to every srv1 container it started while the boot path had already been raised
      // to 48: the sixth home of one fact, and the one that made a provisioned replica disagree with a restarted
      // one. The Nov 9 capture still says 12, and it is kept (srv1_serving_command_observed) and asserted against
      // the render in the control named for it.
      lil_serve_environment_entry(key: "LMCACHE_L1_GB" as NonEmptyStr, value: srv1_lmcache_l1_gb_value()),
      lil_serve_environment_entry(key: "LMCACHE_L2_GB" as NonEmptyStr, value: "125" as NonEmptyStr),
      lil_serve_environment_entry(key: "LMCACHE_L2_ROOT" as NonEmptyStr, value: "/cache/kv" as NonEmptyStr),
      lil_serve_environment_entry(key: "LMCACHE_L2_WORKERS" as NonEmptyStr, value: "16" as NonEmptyStr),
      lil_serve_environment_entry(key: "LMCACHE_L2_ODIRECT" as NonEmptyStr, value: "1" as NonEmptyStr),
      lil_serve_environment_entry(key: "LMCACHE_CHECKPOINT_PROTECTED_SHARE" as NonEmptyStr, value: "0.5" as NonEmptyStr),
      lil_serve_environment_entry(key: "LMCACHE_CHECKPOINT_PROTECTION_WINDOW_SECONDS" as NonEmptyStr, value: "1800" as NonEmptyStr),
    ]
    && (lil_serve_environment_wire(e: lil_serve_environment_entry(key: "LMCACHE_MODE" as NonEmptyStr, value: "ram-disk" as NonEmptyStr)) as String) == "LMCACHE_MODE=ram-disk"
}

// THE RETAINED WRAPPER IS DECIDABLE AGAINST THE HOST COPY: its shape — shebang, container name, image
// (by digest), cgroup, the TLS CN the router pins, and the key READ FROM A PATH — is what the receipt
// read off srv1; the receipt pins the file's SHA-256, this is the content side. No secret VALUE can be
// in the body: the key appears only as the path it is read from.
// The installed wrapper's script, or nothing: a test that reads the body FAILS on the Refused arm (an empty
// body matches none of the patterns below), so no witness passes on a wrapper that does not exist.
fn installed_wrapper_script() -> RetainedShellScript? {
  match srv1_serving_wrapper {
    Srv1ServingWrapperInstallable { script: w, device_words: _ } => Present { value: w }
    Srv1ServingWrapperRefused { reason: _ } => Absent
  }
}

fn installed_wrapper_body() -> String {
  match installed_wrapper_script() { Present { value: w } => w.body Absent => "" }
}

test fn the_retained_wrapper_is_the_serving_entrypoint_the_receipt_read() -> Bool {
  let b = installed_wrapper_body()
  string_contains(s: b, pattern: "#!/bin/bash")
    && string_contains(s: b, pattern: "lil-flash-next")
    && string_contains(s: b, pattern: concat("IMG=sha256:", srv1_serving_image().digest_sha256 as String))
    && string_contains(s: b, pattern: "srv1-inference.slice")
    && string_contains(s: b, pattern: "pool-card")
    && string_contains(s: b, pattern: ".pool_key")
    && string_contains(s: b, pattern: "lil-serve")
    && string_contains(s: b, pattern: concat("--max-model-len ", to_string(token_count_value(t: serving_fleet_context_cap)), " >>"))
    && match installed_wrapper_script() {
      Present { value: w } => (w.dissolves_to.module_path as String) == "extdeps.docker.cli" && (w.dissolves_to.decl_name as String) == "docker_run_foreground_argv"
      Absent => false
    }
}

// THE PINNED CHECKPOINT AND THE IMAGE ARE ONE ROW EACH, and they agree with what the engine's startup
// receipt read off the live container — the Hub row and the receipt cannot disagree silently.
test fn the_launch_exports_the_observed_authorities() -> Bool {
  (srv1_serving_pinned_checkpoint().revision as String) == (qwen3_8_flash_next_manifest.revision as String)
    && (srv1_serving_pinned_checkpoint().revision as String) == (qwen3_8_flash_next_pinned_revision as String)
    && (srv1_serving_pinned_checkpoint().revision as String) == (srv1_serving_startup_reading.checkpoint_revision as String)
    && (srv1_serving_image().digest_sha256 as String) == (srv1_serving_startup_reading.image_digest_sha256 as String)
    // srv1 runs the DERIVED image, not the upstream base: the two digests differ, the base is the
    // upstream row itself, and every change is a real one: twenty-seven files, twenty-four replaced (each
    // digest differs from the base's) and three added (checkpoint_loss.py, checkpoint_policy.py and
    // checkpoint_restore.py, absent from the base).
    && (srv1_serving_image_derivation.base.digest_sha256 as String) == (local_inference_lab_vllm_image.digest_sha256 as String)
    && (srv1_serving_image().digest_sha256 as String) != (local_inference_lab_vllm_image.digest_sha256 as String)
    && length(xs: concat([srv1_serving_image_derivation.changes.head], srv1_serving_image_derivation.changes.tail)) == 27
    && concat([srv1_serving_image_derivation.changes.head], srv1_serving_image_derivation.changes.tail)
      .all(c => match c {
        Srv1ImageFileReplaced { path: _, base_file_sha256_hex: b, replaced_file_sha256_hex: r } => (b as String) != (r as String)
        Srv1ImageFileAdded { path: _, added_file_sha256_hex: _ } => true
      })
    && fold(concat([srv1_serving_image_derivation.changes.head], srv1_serving_image_derivation.changes.tail), init: 0,
      f: (n, c) => match c { Srv1ImageFileAdded { path: _, added_file_sha256_hex: _ } => n + 1 _ => n }) == 3
}

// THE BODY IS THE HOST COPY, BYTE FOR BYTE: `sha256sum ~/strata-test/srv1_lil_serve.sh` on srv1,
// 2026-10-30 20:3x after the context-cap edit, and re-read 2026-10-31 at the relaunch. A LITERAL,
// deliberately, for the reason observed_cmd_tail is one: the hash is the reading, and the body (with the
// cap rendered from its row) and the startup receipt's pin are both checked against it. Editing the body,
// the cap, or the host file without the others turns this red.
data host_wrapper_sha256_read: String = "b8b73d186a43d56c54eae5985ef0b8d1751b06af08dbf7f7013b885ba49e62bd"

test fn the_retained_running_body_hashes_to_the_host_copy() -> Bool {
  // The RUNNING container's wrapper body (retained as history) hashes to the host reading the receipt pins.
  sha256_hex(message: bytes_octets(b: utf8_encode_bytes(s: srv1_serving_wrapper_running_body))) == host_wrapper_sha256_read
    && host_wrapper_sha256_read == (srv1_serving_startup_reading.wrapper_sha256_hex as String)
    // The INSTALLED body is ahead of the running copy (it carries the declared per-device group, not `all`),
    // so the sha divergence is the DECLARED pending relaunch — never a red equality.
    && match srv1_serving_wrapper_adoption() {
      Srv1ServingWrapperPendingOperatorRelaunch { running_sha256_hex: rs, installed_sha256_hex: ins } =>
        rs == srv1_serving_startup_reading.wrapper_sha256_hex
          && ins != srv1_serving_startup_reading.wrapper_sha256_hex   // installed != running: the relaunch obligation
      _ => false
    }
}

// THE ROUTER'S LAUNCH FACTS READ THE LAUNCH: the port is the launch's listen port, the advertised model
// is the engine's OWN reported served_model_name (receipt), the TLS name is the wrapper's mint. The
// type has no cap and no key field at all — router policy and secrets stay router-side by construction.
test fn the_router_launch_facts_read_the_launch_and_hold_no_policy_or_secret() -> Bool {
  let f = srv1_router_upstream_launch_facts
  f.port == srv1_serving_launch.listen_port
    && f.port == 18000
    && (f.model as String) == (srv1_serving_startup_reading.served_model_name as String)
    && (match f.scheme { Https => true, _ => false })
    && (f.tls_name as String) == "pool-card"
    && (f.name as String) == "srv1-vllm"
}

// A port override re-derives the WHOLE launch from the one row; nothing restates it.
test fn a_port_override_changes_only_the_port() -> Bool {
  let at = srv1_serving_launch_for_port(port: 18001)
  at.listen_port == 18001
    && (srv1_serving_render_with_port(port: 18001) == [
      "lil-serve",
      "--profile", "qwen38-flash-next",
      "--hardware", "rtx-pro-6000-pcie",
      "--env", "LMCACHE_MODE=ram-disk",
      // the derived tier, not the 2026-11-09 capture's 12 — see the note in
      // the_environment_tiers_wire_as_the_container_shows_them. Spelled through the same wire function the row
      // itself uses, so this line is the row's answer and not a second copy of the number.
      "--env", (lil_serve_environment_wire(e: lil_serve_environment_entry(key: "LMCACHE_L1_GB" as NonEmptyStr, value: srv1_lmcache_l1_gb_value())) as String),
      "--env", "LMCACHE_L2_GB=125",
      "--env", "LMCACHE_L2_ROOT=/cache/kv",
      "--env", "LMCACHE_L2_WORKERS=16",
      "--env", "LMCACHE_L2_ODIRECT=1",
      "--env", "LMCACHE_CHECKPOINT_PROTECTED_SHARE=0.5",
      "--env", "LMCACHE_CHECKPOINT_PROTECTION_WINDOW_SECONDS=1800",
      "--",
      "--port", "18001",
      "--ssl-keyfile", "/root/serve/tls.key",
      "--ssl-certfile", "/root/serve/tls.crt",
      "--api-key", "$(cat /root/.pool_key)",
      "--max-model-len", "229376",
    ])
    && (length(xs: at.environment) == length(xs: srv1_serving_launch.environment))
}

fn srv1_serving_render_with_port(port: Port) -> List<String> {
  lil_serve_launch_argv(
    launch: srv1_serving_launch_for_port(port: port),
    api_key_wire: bash_realization_key_read,
  )
}

// THE INTERFACE CARRIES NO SHELL, THE CALLING REALIZATION SPELLS IT: the key source is a typed file
// reference in the interface row (no dollar sign anywhere in it), and the bash substitution exists only
// in the retained wrapper body — the witness above renders with it as an observed token, and a
// direct-exec transport would supply the file's contents in its place through the same parameter.
test fn the_key_is_a_typed_source_in_the_interface_and_shell_only_in_the_realization() -> Bool {
  match srv1_serving_launch.api_key {
    LilServeApiKeyFromFile { path: p } =>
      (p as String) == "/root/.pool_key"
        && !string_contains(s: p as String, pattern: "$")
        && !string_contains(s: p as String, pattern: "cat")
  }
}

// WHAT THIS MODULE DOES NOT MODEL is keyed, and the relaunch half stays UNBOUNDED on purpose: no row
// here converges the live container — that waits on the operator's maintenance window (merry-fox-82,
// 2026-10-25), so it cannot claim a bound trigger it does not own.
test fn the_unmodeled_frontier_is_keyed_and_the_relaunch_half_stays_unbounded() -> Bool {
  length(xs: srv1_serving_unmodeled_frontier_rows) == 7
    && (match first_where(xs: srv1_serving_unmodeled_frontier_rows, keep: fn(r) {
      match r.subject {
        DeclSubject { ref: d } => (d.decl_name as String) == "srv1_serving_wrapper"
        _ => false
      }
    }) {
      Present { value: r } => !dissolution_is_bound(condition: r.dissolution)
      Absent => false
    })
    && (match first_where(xs: srv1_serving_unmodeled_frontier_rows, keep: fn(r) {
      match r.subject {
        DeclSubject { ref: d } => (d.decl_name as String) == "srv1_serving_launch"
        _ => false
      }
    }) {
      Present { value: r } => true
      Absent => false
    })
    // The relaunch closed the receipt gap, so no frontier row is keyed on the receipt any more.
    && (match first_where(xs: srv1_serving_unmodeled_frontier_rows, keep: fn(r) {
      match r.subject {
        DeclSubject { ref: d } => (d.decl_name as String) == "srv1_serving_startup_reading"
        _ => false
      }
    }) {
      Present { value: _ } => false
      Absent => true
    })
}
// The loopback host is TYPED (review 86720): octets in the model; the wire string exists only at
// render_ipv4_address's boundary.
test fn the_router_host_is_typed_octets_not_a_string() -> Bool {
  (render_ipv4_address(addr: srv1_router_upstream_launch_facts.host) as String) == "127.0.0.1"
    && srv1_router_upstream_launch_facts.host.octet1 == 127
    && srv1_router_upstream_launch_facts.host.octet4 == 1
}

// One trigger row per retained wrapper effect (gunbc.design_argument::guarantee_ladder: plural loss needs plural triggers), each
// naming its restored capability in the dissolution text.
test fn each_retained_wrapper_effect_has_its_own_trigger_row() -> Bool {
  has_row_naming(needle: "TLS self-mint", capability: "openssl")
    && has_row_naming(needle: "events.log", capability: "host-event")
    && has_row_naming(needle: "pool-key generation", capability: "secret-reference")
    // THE KEY-READ TRIGGER, ASSERTED BY VALUE (review 86879: prose-matching dissolved the assertion —
    // ANY ref passed the bound check). The row whose reason carries the key-read loss must be bound to
    // EXACTLY the forward ref on the unbuilt render fn (srv1_serving_api_key_substitution_node): not to
    // the grammar rows, which landed in #15230 and would report the row retired while the wrapper still
    // spells shell, and not to srv1_serving_wrapper itself, which restates the wrapper's own dissolves_to
    // instead of naming a capability. dissolution_description renders a bound trigger as its ref's
    // display key, so this equality pins the trigger's identity, and the row-selection needle stays on
    // the reason text so selection cannot be satisfied by the trigger string itself.
    && (match first_where(xs: srv1_serving_unmodeled_frontier_rows, keep: fn(r) {
        string_contains(s: r.reason as String, pattern: "key READ at exec time")
      }) {
        Present { value: r } =>
          dissolution_is_bound(condition: r.dissolution)
            && dissolution_description(condition: r.dissolution) == "gunbc.serving.srv1_serving_launch::srv1_serving_api_key_substitution_node"
        Absent => false
      })
    // And the trigger must NOT point at the wrapper or the landed grammar rows — those readings were
    // each rejected in review 86879; this is the negative control for the assertion above.
    && !any(srv1_serving_unmodeled_frontier_rows, x =>
      string_contains(s: x.reason as String, pattern: "key READ at exec time")
        && (dissolution_description(condition: x.dissolution) == "gunbc.serving.srv1_serving_launch::srv1_serving_wrapper"
          || dissolution_description(condition: x.dissolution) == "v2.workflow.bash_emit::bash_emit_stmts"))
}

fn has_row_naming(needle: String, capability: String) -> Bool {
  match first_where(xs: srv1_serving_unmodeled_frontier_rows, keep: fn(r) {
    string_contains(s: r.reason as String, pattern: needle)
      && string_contains(s: dissolution_description(condition: r.dissolution), pattern: capability)
  }) {
    Present { value: _ } => true
    Absent => false
  }
}

// ── the declared GPU group replaces the `--device nvidia.com/gpu=all` bypass ───────────────────
// (fleet hardware-fact consumption #16045, deliverable 3)
//
// These read the new authority end to end: the device UUID comes from gunbc.fleet.gpu_device_observation and
// the admission from gunbc.fleet.gpu_power_state_policy. Removing either import breaks this file (a control on
// the real launch/apply path goes red), which is the point: the launch no longer carries the `all` wildcard or
// the literal route index — it reads the declared group. The power-limit READBACK that lets a qualified device
// run is NOT restated here; it is owned by gunbc.fleet.gpu_power_cap_converge and enforced on the real path by
// the engine unit's Requires= on the cap unit (gunbc.live_deploy.srv1_gpu_power_cap_unit).

// The Max-Q's GPU UUID, read from gunbc.fleet.gpu_device_observation on srv1 2026-11-07 (a LITERAL here on
// purpose: it is the reading these renderings are checked against, not derived from them).
data maxq_uuid: NonEmptyStr = "GPU-7b58568e-8bc9-4e4b-bc6c-c414b08936c3" as NonEmptyStr

// The launch renders ONE `--device nvidia.com/gpu=<UUID>` for the one member of the declared group — the
// Max-Q's observed UUID — and NOT the `all` wildcard. The INSTALLED wrapper body is CONSTRUCTED from that render
// inside srv1_serving_wrapper's Installable arm, so the body contains the model-rendered flag verbatim and `all` is
// unwritable (not merely checked away). The host copy the
// running container was launched from still says `all` and is kept as history in srv1_serving_wrapper_running_body.
test fn srv1_serving_launch_renders_per_device_flags_not_the_all_wildcard() -> Bool {
  match srv1_serving_wrapper {
    Srv1ServingWrapperInstallable { script: w, device_words: words } =>
      // device_words is the single rendering (oracle: the Max-Q's observed UUID from gpu_device_observation)…
      words == ["--device" as NonEmptyStr, "nvidia.com/gpu=GPU-7b58568e-8bc9-4e4b-bc6c-c414b08936c3" as NonEmptyStr]
        // …the installed body carries exactly that render joined (no second UUID home)…
        && string_contains(s: w.body, pattern: "--device nvidia.com/gpu=GPU-7b58568e-8bc9-4e4b-bc6c-c414b08936c3 ")
        // …and never the `all` wildcard.
        && !string_contains(s: w.body, pattern: "nvidia.com/gpu=all")
    Srv1ServingWrapperRefused { reason: _ } => false   // the one-card group MUST yield an installable wrapper
  }
}

fn wrapper_is_refused(w: Srv1ServingWrapper) -> Bool {
  match w {
    Srv1ServingWrapperRefused { reason: r } => string_contains(s: r as String, pattern: "does not resolve")
    Srv1ServingWrapperInstallable { script: _, device_words: _ } => false
  }
}

// A GROUP THAT DOES NOT RESOLVE HAS NO WRAPPER BODY AT ALL. Review 92228: a refused group used to render a
// valid-looking `docker run` with no `--device`, kept out only by a gate beside it. Now the body is built only in
// the Installable arm, so a refused selection — or any refused selection (an empty group cannot be declared at
// all: Srv1ServingGpuGroup names its served board) — yields Srv1ServingWrapperRefused, which carries a reason and
// no script to hash, stage or install.
//
// The unresolved member used to be the Workstation card, which did not enumerate. It enumerates now (read on the
// host 2026-11-08, carried by gunbc.fleet.gpu_device_observation), so the fixture's second member is a board srv1's
// power-cap intent covers no device for -- the same Refused arm, reached through a member that is genuinely not
// bringable on this host rather than through a reading this repository no longer holds.
test fn a_group_that_does_not_resolve_has_no_wrapper_body() -> Bool {
  let tp2 = Srv1ServingGpuGroup {
    decider: "witness" as NonEmptyStr,
    decided_on: "2026-11-09" as NonEmptyStr,
    basis: "witness: a hypothetical two-card configuration whose second member is a board srv1's power-cap intent does not cover" as NonEmptyStr,
    served_board: gpu_board_04,
    further_boards: [gpu_board_05],
  }
  wrapper_is_refused(w: srv1_serving_wrapper_of(selection: srv1_serving_group_selection(group: tp2)))
    && wrapper_is_refused(w: srv1_serving_wrapper_of(selection: Srv1ServingDevicesRefused { tensor_parallel: Zero, pending: ["witness: a refused selection" as NonEmptyStr] }))
}

// The one-card configuration is evaluated against ITS OWN member only, so it resolves (and the route
// resolves, device_index 0 of the group) while the Workstation card is pending — it does NOT wait on, or
// accidentally include, the second card.
test fn srv1_serving_one_card_group_is_evaluable_while_the_workstation_is_pending() -> Bool {
  match srv1_serving_group_selection(group: srv1_serving_gpu_group) {
    Srv1ServingDevicesSelected { tensor_parallel: tp, members: ms } =>
      match tp { Succ { prev: z } => match z { Zero => true _ => false } _ => false }
      && match ms.first() {
        Present { value: Srv1ServingDeviceSelected { board: _, gpu_uuid: u, rank: r } } =>
          u == maxq_uuid && match r { Zero => true _ => false }
        _ => false
      }
      && length(xs: ms) == 1   // the pending Workstation card never enters the one-card selection
    Srv1ServingDevicesRefused { tensor_parallel: _, pending: _ } => false   // the one-card group MUST resolve
  }
}

// A TP=2 configuration REQUIRES both members: the group REFUSES rather than yielding a one-device selection,
// so it can never silently degrade to TP=1 with one device flag where two were declared.
//
// The pending member is a board srv1's power-cap intent covers no device for. It was the Workstation card until
// 2026-11-08, when the card was read enumerating and admitted at 300 W; keeping the OLD board here would have
// asserted a host state this repository no longer records, which is the failure the whole device-observation
// split exists to prevent. The guard is over the mechanism -- an unresolvable member must refuse the group --
// and the next test covers the other side of it.
test fn srv1_serving_tensor_parallel_two_refuses_rather_than_degrading_to_one() -> Bool {
  let tp2 = Srv1ServingGpuGroup {
    decider: "witness" as NonEmptyStr,
    decided_on: "2026-11-09" as NonEmptyStr,
    basis: "witness: a hypothetical two-card configuration whose second member is a board srv1's power-cap intent does not cover" as NonEmptyStr,
    served_board: gpu_board_04,
    further_boards: [gpu_board_05],
  }
  match srv1_serving_group_selection(group: tp2) {
    Srv1ServingDevicesRefused { tensor_parallel: tp, pending: ps } =>
      match tp { Succ { prev: z } => match z { Succ { prev: zz } => match zz { Zero => true _ => false } _ => false } _ => false }
      && length(xs: ps) == 1   // the Workstation card is the one unresolved member
    Srv1ServingDevicesSelected { tensor_parallel: _, members: _ } => false   // a TP=2 group must NEVER be Selected while a member is pending
  }
}

// THE OTHER SIDE OF THAT GUARD, AND THE NEWEST FACT ON THE HOST: with both cards enumerated and both admitted at
// 300 W by gunbc.serving.gpu_power_state_policy, a two-board group over the two REAL srv1 boards resolves to two
// selected devices with distinct UUIDs and ranks 0 and 1 -- which is exactly what it could not do while the
// Workstation card did not enumerate. This is a statement about how the group mechanism RESOLVES device flags,
// not an operator declaration of tensor parallelism: the declared group stays srv1_serving_gpu_group (TP=1), and
// whether TP=2 may be adopted at all is the topology-and-benchmark row of
// gunbc.plans.fleet_hardware_fact_consumption, still open.
test fn both_enumerated_srv1_cards_resolve_a_two_device_group() -> Bool {
  let real_tp2 = Srv1ServingGpuGroup {
    decider: "witness" as NonEmptyStr,
    decided_on: "2026-11-09" as NonEmptyStr,
    basis: "witness: both srv1 cards read enumerating on 2026-11-08 and admitted at 300 W each" as NonEmptyStr,
    served_board: gpu_board_04,
    further_boards: [gpu_board_01],
  }
  match srv1_serving_group_selection(group: real_tp2) {
    Srv1ServingDevicesSelected { tensor_parallel: tp, members: ms } =>
      match tp { Succ { prev: z } => match z { Succ { prev: zz } => match zz { Zero => true _ => false } _ => false } _ => false }
      && length(xs: ms) == 2
      && match ms.first() {
        Present { value: Srv1ServingDeviceSelected { board: _, gpu_uuid: u, rank: r } } =>
          u == maxq_uuid && match r { Zero => true _ => false }
        _ => false
      }
    Srv1ServingDevicesRefused { tensor_parallel: _, pending: _ } => false   // two admitted cards must resolve
  }
}

// ── THE EMERGENCY VALVE ON THE LAUNCHER'S OWN FACE ──────────────────────────────────────────────
//
// WHY THIS CONTROL EXISTS. `--emergency-evict-for-prefetch` belongs to the launcher, not to the engine: it
// is one of the tokens lil-serve consumes BEFORE the `--` that separates it from vLLM (the host's 2026-11-24
// ps output shows the engine tail `-- --enforce-eager --disable-log-requests ...` starting after it).
// Modelling it as an ENGINE flag would have put a launcher argument in the engine's mouth, where
// srv1_replica_rendered_boot_path_witness pins `--kv-cache-dtype` at argv index 2 and would never have
// noticed. So the flag is a row on the launcher's own face, and this control is what keeps it there:
// PASSING contributes EXACTLY that one token, in place, before the environment; DECLINING contributes
// nothing — which is why the srv1 token sequence this witness compares against the host's docker inspect
// (test fn the_rendered_argv_equals_the_container_cmd_tail) did not move when the valve was modelled.
//
// THE DISCRIMINATION. Reorder the flag after the environment, or render it twice, and the zip_eq equality
// or the face test fails. Replace the derived list in `data srv1_serving_launch` with a literal `[]` and
// `length(srv1_serving_launch.launcher_flags) == 0` still passes — which is exactly why the control also
// asserts the ANSWER's own shape (length(passed) == 1, length(declined) == 0) and the flag's single
// spelling through extdeps, rather than only the rendering.

fn is_emergency_valve_token(t: String) -> Bool { t == "--emergency-evict-for-prefetch" }

fn is_lmcache_env_token(t: String) -> Bool { string_contains(s: t, pattern: "LMCACHE_") }

// The tokens lil-serve itself consumes: everything before the first `--env`, because the environment and
// the engine's own arguments both come after it.
fn launcher_face_tokens(argv: List<String>) -> List<String> {
  fold_list(
    xs: argv,
    empty: ([] as List<String>),
    cons: fn(acc, t) { if any(acc, is_lmcache_env_token) { acc } else { concat(acc, [t]) } }
  )
}

// srv1's own launch record with ONLY launcher_flags changed, so the two argvs differ by the answer and
// nothing else (the cfg_shape pattern of srv1_replica_rendered_boot_path_witness, for the same reason).
fn valve_probe_launch(flags: List<LilServeLauncherFlag>) -> LilServeLaunch {
  let l = srv1_serving_launch
  LilServeLaunch {
    profile: l.profile,
    hardware: l.hardware,
    environment: l.environment,
    launcher_flags: flags,
    engine: l.engine,
    ssl_keyfile: l.ssl_keyfile,
    ssl_certfile: l.ssl_certfile,
    api_key: l.api_key,
    listen_port: l.listen_port,
    standing: l.standing,
  }
}

test fn a_passed_valve_is_exactly_one_token_on_the_launcher_face() -> Bool {
  let passed = srv1_emergency_evict_launcher_flags(
    d: EmergencyEvictPassed { why: "the host passes it for GLM profiles" as NonEmptyStr }
  )
  let declined = srv1_emergency_evict_launcher_flags(
    d: srv1_emergency_evict_decision_for(profile: srv1_served_profile_name)
  )
  let with_valve = lil_serve_launch_argv(launch: valve_probe_launch(flags: passed), api_key_wire: "$POOL_KEY")
  let without = lil_serve_launch_argv(launch: valve_probe_launch(flags: declined), api_key_wire: "$POOL_KEY")
  // The spelling has one source: the row in extdeps.vllm.lil_serve, not a string written here.
  length(passed) == 1
    && lil_serve_launcher_flag_argv(f: lil_serve_launcher_flag_emergency_evict_for_prefetch) == ["--emergency-evict-for-prefetch"]
    && all(map(xs: passed, f: f => lil_serve_launcher_flag_argv(f: f)), t => length(t) == 1)
    // srv1 declines the valve, so the admitted launch carries none: the host's argv stays the authority.
    && length(declined) == 0
    && length(srv1_serving_launch.launcher_flags) == 0
    && !any(without, is_emergency_valve_token)
    // Passing adds exactly that token, in place, and nothing else about the launch changes.
    && any(with_valve, is_emergency_valve_token)
    && zip_eq(a: filter(with_valve, t => !is_emergency_valve_token(t)), b: without, eq: fn(x, y) { x == y })
    // And it lands on the launcher's face: before the first environment token, so before the engine's argv.
    && any(launcher_face_tokens(with_valve), is_emergency_valve_token)
    // A decline is an ANSWER, with a reading attached; an unmodelled profile is not an answer at all.
    && srv1_emergency_evict_decision_is_stated(d: srv1_emergency_evict_decision_for(profile: srv1_served_profile_name))
    && !srv1_emergency_evict_decision_is_stated(d: srv1_emergency_evict_decision_for(profile: "glm-5.3-flash" as NonEmptyStr))
    && match srv1_emergency_evict_decision_standing(d: srv1_emergency_evict_decision_for(profile: srv1_served_profile_name)) {
      Absent => false
      Present { value: st } => match cited_figure_read_obligation(standing: st) {
        Absent => false
        Present { value: o } => string_contains(s: o, pattern: "launcher.py")
          && string_contains(s: o, pattern: "GLM")
      }
    }
    && string_contains(s: srv1_emergency_evict_read_obligation as String, pattern: "admitted image")
}

// THE TWO SURFACES ANSWER TOGETHER, OR ONE OF THEM IS LYING. A container provisioned from the model takes its
// launcher face from srv1_serving_launch_for_port (gunbc.serving.serving_provision_derivation copies it into
// every provisioned vLLM container's argv); the boot path takes its face from
// srv1_emergency_evict_launcher_tokens over the same per-profile answer. Compared, not asserted equal: #17089
// had to be told twice that a provisioned launch and a boot render can carry different numbers for one config,
// and a flag that appeared on one surface and not the other is the same bug on the flag face.
test fn the_provisioned_launch_and_the_boot_answer_carry_the_same_launcher_face() -> Bool {
  let provisioned = map(
    xs: srv1_serving_launch_for_port(port: 18001).launcher_flags,
    f: x => lil_serve_launcher_flag_name(f: x) as String
  )
  let boot = map(
    xs: srv1_emergency_evict_launcher_tokens(d: srv1_emergency_evict_decision_for(profile: srv1_served_profile_name)),
    f: t => t as String
  )
  zip_eq(a: provisioned, b: boot, eq: fn(x, y) { x == y })
    // …and what they agree on today is that srv1 passes nothing, on BOTH surfaces.
    && !any(provisioned, is_emergency_valve_token)
    && !any(boot, is_emergency_valve_token)
    // The answer that would change both: one token each, never one surface only.
    && length(srv1_emergency_evict_launcher_tokens(d: EmergencyEvictPassed { why: "the host passes it for GLM profiles" as NonEmptyStr })) == 1
}
