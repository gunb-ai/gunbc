module test.claim.serving.srv1_serving_launch_witness

import std.types { String, Bool, NonEmptyStr, Port, List }
import std.optional { Absent, Present }
import std.list { first_where }
import std.algebra { length, string_contains }
import std.dissolution { dissolution_is_bound }
import std.roster_frontier { DeclSubject }
import gunbc.serving.serving_enrollment { ServingRouteResolved, CeilingByDeclaredPolicy }
import extdeps.vllm.lil_serve { LilServeEngineFlags, LilServeEnvironmentEntry, lil_serve_environment_entry, lil_serve_environment_wire, lil_serve_launch_argv }
import extdeps.local_inference_lab.qwen3_8_flash_next { qwen3_8_flash_next_manifest, QWEN3_8_FLASH_NEXT_REVISION }
import extdeps.vllm.local_inference_lab_build { local_inference_lab_vllm_image }
import gunbc.host.srv1_serving_startup_receipt { srv1_serving_startup_reading }
import gunbc.serving.srv1_serving_launch {
  srv1_serving_wrapper, srv1_serving_launch, srv1_serving_launch_for_port, srv1_serving_launch_argv,
  srv1_serving_image, srv1_serving_pinned_checkpoint, srv1_router_upstream_launch_facts, srv1_serving_route,
  srv1_serving_unmodeled_frontier_rows,
}

// The argv `docker inspect --format {{.Config.Cmd}} lil-flash-next` showed on 2026-10-25, with the two
// shell substitutions left as the wrapper writes them and the output redirect cut at its boundary (the
// wrapper's `>> $D/serve.log 2>&1` is shell, not argv). A LITERAL, deliberately: this is the reading the
// derivation is checked against, and restating it from the rows would make the check circular.
data observed_cmd_tail: List<String> = [
  "lil-serve",
  "--profile", "qwen38-flash-next",
  "--hardware", "rtx-pro-6000-pcie",
  "--env", "LMCACHE_MODE=ram-disk",
  "--env", "LMCACHE_L1_GB=24",
  "--env", "LMCACHE_L2_GB=200",
  "--env", "LMCACHE_L2_ROOT=/cache/kv",
  "--",
  "--port", "18000",
  "--ssl-keyfile", "/root/serve/tls.key",
  "--ssl-certfile", "/root/serve/tls.crt",
  "--api-key", "$(cat /root/.pool_key)",
]

// THE RENDER EQUALS WHAT THE RUNNING CONTAINER SHOWED, element for element — including the key's file
// read spelled as a shell substitution and no secret value anywhere. This is the check that makes the
// argv a DERIVATION verified against an OBSERVATION, not a restatement of it.
test fn the_rendered_argv_equals_the_container_cmd_tail() -> Bool {
  srv1_serving_launch_argv() == observed_cmd_tail
}

// NO INVENTED FLAGS: every nvfp4/context/tier value the engine reports comes from lil-serve's own
// profile, not from argv, so the launch row carries none of them — a flag added here without a wrapper
// change would break this render check, which is the point.
test fn the_launch_carries_no_engine_flag_the_wrapper_does_not_pass() -> Bool {
  match srv1_serving_launch.engine {
    LilServeEngineFlags {
      served_model_name: mn, kv_cache_dtype: kv, memory: m, max_model_len: ml,
      max_num_seqs: ms, max_num_batched_tokens: mb, chunked_prefill: cp, prefix_caching: pc, unmodeled_tail: tail,
    } =>
      (match mn { Absent => true, _ => false })
        && (match kv { Absent => true, _ => false })
        && (match m { Absent => true, _ => false })
        && (match ml { Absent => true, _ => false })
        && (match ms { Absent => true, _ => false })
        && (match mb { Absent => true, _ => false })
        && (match cp { Absent => true, _ => false })
        && (match pc { Absent => true, _ => false })
        && (length(xs: tail) == 0)
  }
}

// The LMCache tiers ARE in the wrapper, so they must be rows, and their wires render exactly as the
// container shows them.
test fn the_environment_tiers_wire_as_the_container_shows_them() -> Bool {
  srv1_serving_launch.environment
    == [
      lil_serve_environment_entry(key: "LMCACHE_MODE" as NonEmptyStr, value: "ram-disk" as NonEmptyStr),
      lil_serve_environment_entry(key: "LMCACHE_L1_GB" as NonEmptyStr, value: "24" as NonEmptyStr),
      lil_serve_environment_entry(key: "LMCACHE_L2_GB" as NonEmptyStr, value: "200" as NonEmptyStr),
      lil_serve_environment_entry(key: "LMCACHE_L2_ROOT" as NonEmptyStr, value: "/cache/kv" as NonEmptyStr),
    ]
    && (lil_serve_environment_wire(e: lil_serve_environment_entry(key: "LMCACHE_MODE" as NonEmptyStr, value: "ram-disk" as NonEmptyStr)) as String) == "LMCACHE_MODE=ram-disk"
}

// THE RETAINED WRAPPER IS DECIDABLE AGAINST THE HOST COPY: its shape — shebang, container name, image
// (by digest), cgroup, the TLS CN the router pins, and the key READ FROM A PATH — is what the receipt
// read off srv1; the receipt pins the file's SHA-256, this is the content side. No secret VALUE can be
// in the body: the key appears only as the path it is read from.
test fn the_retained_wrapper_is_the_serving_entrypoint_the_receipt_read() -> Bool {
  let b = srv1_serving_wrapper.body
  string_contains(s: b, pattern: "#!/bin/bash")
    && string_contains(s: b, pattern: "lil-flash-next")
    && string_contains(s: b, pattern: "ghcr.io/local-inference-lab/vllm")
    && string_contains(s: b, pattern: "af14f1a90e141ad7a1b4951f0fd37d695101ebd5887fcddb499f2f427eff5319")
    && string_contains(s: b, pattern: "srv1-inference.slice")
    && string_contains(s: b, pattern: "pool-card")
    && string_contains(s: b, pattern: ".pool_key")
    && string_contains(s: b, pattern: "lil-serve")
    && (srv1_serving_wrapper.dissolves_to.module_path as String) == "extdeps.vllm.lil_serve"
    && (srv1_serving_wrapper.dissolves_to.decl_name as String) == "lil_serve_launch_argv"
}

// THE PINNED CHECKPOINT AND THE IMAGE ARE ONE ROW EACH, and they agree with what the engine's startup
// receipt read off the live container — the Hub row and the receipt cannot disagree silently.
test fn the_launch_exports_the_observed_authorities() -> Bool {
  (srv1_serving_pinned_checkpoint().revision as String) == (qwen3_8_flash_next_manifest.revision as String)
    && (srv1_serving_pinned_checkpoint().revision as String) == (QWEN3_8_FLASH_NEXT_REVISION as String)
    && (srv1_serving_pinned_checkpoint().revision as String) == (srv1_serving_startup_reading.checkpoint_revision as String)
    && (srv1_serving_image().digest_sha256 as String) == (srv1_serving_startup_reading.image_digest_sha256 as String)
    && (srv1_serving_image().digest_sha256 as String) == (local_inference_lab_vllm_image.digest_sha256 as String)
}

// THE ROUTER'S LAUNCH FACTS READ THE LAUNCH: the port is the launch's listen port, the advertised model
// is the engine's OWN reported served_model_name (receipt), the TLS name is the wrapper's mint. The
// type has no cap and no key field at all — router policy and secrets stay router-side by construction.
test fn the_router_launch_facts_read_the_launch_and_hold_no_policy_or_secret() -> Bool {
  let f = srv1_router_upstream_launch_facts
  f.port == srv1_serving_launch.listen_port
    && f.port == 18000
    && (f.model as String) == (srv1_serving_startup_reading.served_model_name as String)
    && (f.scheme as String) == "https"
    && (f.tls_name as String) == "pool-card"
    && (f.name as String) == "srv1-vllm"
}

test fn the_enrollment_route_is_the_launch_address_with_the_operators_declared_ceiling() -> Bool {
  match srv1_serving_route {
    ServingRouteResolved { endpoint: e, ceiling: c } =>
      (e.port == srv1_serving_launch.listen_port)
        && (e.replica.node as String) == "srv1"
        && (e.replica.served_name as String) == (srv1_router_upstream_launch_facts.name as String)
        && (e.address as String) == (srv1_router_upstream_launch_facts.host as String)
        && (match c {
          CeilingByDeclaredPolicy { count: n, decider: d, decided_on: dd, basis: _ } =>
            n == 4 && (d as String) == "operator" && (dd as String) == "2026-10-24"
          _ => false
        })
    _ => false
  }
}

// A port override re-derives the WHOLE launch from the one row; nothing restates it.
test fn a_port_override_changes_only_the_port() -> Bool {
  let at = srv1_serving_launch_for_port(port: 18001)
  at.listen_port == 18001
    && (srv1_serving_render_with_port(port: 18001) == [
      "lil-serve",
      "--profile", "qwen38-flash-next",
      "--hardware", "rtx-pro-6000-pcie",
      "--env", "LMCACHE_MODE=ram-disk",
      "--env", "LMCACHE_L1_GB=24",
      "--env", "LMCACHE_L2_GB=200",
      "--env", "LMCACHE_L2_ROOT=/cache/kv",
      "--",
      "--port", "18001",
      "--ssl-keyfile", "/root/serve/tls.key",
      "--ssl-certfile", "/root/serve/tls.crt",
      "--api-key", "$(cat /root/.pool_key)",
    ])
    && (length(xs: at.environment) == length(xs: srv1_serving_launch.environment))
}

fn srv1_serving_render_with_port(port: Port) -> List<String> {
  lil_serve_launch_argv(launch: srv1_serving_launch_for_port(port: port))
}

// WHAT THIS MODULE DOES NOT MODEL is keyed, and the relaunch half stays UNBOUNDED on purpose: no row
// here converges the live container — that waits on the operator's maintenance window (merry-fox-82,
// 2026-10-25), so it cannot claim a bound trigger it does not own.
test fn the_unmodeled_frontier_is_keyed_and_the_relaunch_half_stays_unbounded() -> Bool {
  length(xs: srv1_serving_unmodeled_frontier_rows) == 2
    && (match first_where(xs: srv1_serving_unmodeled_frontier_rows, keep: fn(r) {
      match r.subject {
        DeclSubject { ref: d } => (d.decl_name as String) == "srv1_serving_wrapper"
        _ => false
      }
    }) {
      Present { value: r } => !dissolution_is_bound(condition: r.dissolution)
      Absent => false
    })
    && (match first_where(xs: srv1_serving_unmodeled_frontier_rows, keep: fn(r) {
      match r.subject {
        DeclSubject { ref: d } => (d.decl_name as String) == "srv1_serving_launch"
        _ => false
      }
    }) {
      Present { value: r } => true
      Absent => false
    })
}
