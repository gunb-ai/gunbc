// scratch (merry-gull-120): isolate which fold piece refuses with the generic
// grammar_relation_production_not_found. DELETE when done.
use v2.std.diagnostic.*
use v2.extdeps.languages.bash_build.*
use v2.workflow.bash_command_fold_serialize.*

data scratch_main_ok: Int = 0

fn scratch_probe(label: String, node: Node) -> String {
  match bash_fold_serialize_node(stmt: node) {
    Accepted { value: v, diagnostics: _ } => concat(label, concat(" ACCEPTED[", concat(v, "]")))
    Rejected { diagnostics: d } =>
      match diagnostics_first(diagnostics: d) {
        Present { value: x } =>
          concat(label, concat(" REJECTED[", concat(diagnostics_reason_lexemes(d: x), "]")))
        Absent => concat(label, " REJECTED[]")
      }
  }
}

fn main() -> CliWireResponse {
  let positional0 = match bash_build_word_positional(index: "0") {
    Present { value: p } => p
    Absent => bash_build_word_kinded(kind: ^scratch_refused_positional, value: "0")
  }
  let dq0 = match bash_build_word_double_quoted(parts: [positional0]) {
    Present { value: n } => n
    Absent => bash_build_word_kinded(kind: ^scratch_refused_dq, value: "0")
  }
  let exec_cmd = bash_build_command_from_lits(lits: ["exec"])
  let echo_bare = bash_build_command_with_words(words: [bash_build_word_bare(text: "echo")])
  let echo_lit = bash_build_command_with_words(words: [bash_build_word_lit(text: "echo")])
  let bad_var_cmd = bash_build_command_from_word_nodes(words: [bash_build_word_var(name: "1x")])
  let redir_bare = bash_build_with_redir_from_file(
    inner: exec_cmd,
    path: bash_build_word_bare(text: "/root/engine.args")
  )
  let lines = [
    scratch_probe(label: "P1_POSITIONAL", node: positional0),
    scratch_probe(label: "P2_DQ0", node: dq0),
    scratch_probe(label: "P3_EXEC", node: exec_cmd),
    scratch_probe(label: "P4_REDIR_DQ0", node: bash_build_with_redir_from_file(inner: exec_cmd, path: dq0)),
    scratch_probe(label: "P5_ECHO_BARE", node: echo_bare),
    scratch_probe(label: "P6_ECHO_LIT", node: echo_lit),
    scratch_probe(label: "P7_BADVAR_CMD", node: bad_var_cmd),
    scratch_probe(label: "P8_REDIR_BARE", node: redir_bare)
  ]
  CliWirePrintable {
    bytes: join(parts: lines, separator: "\n"),
    exit: ExitSuccess
  }
}
