module test.claim.serving.scratch_merry_dump2

// SCRATCH, NOT FOR MERGE. Isolate which fold piece refuses with the generic
// grammar_relation_production_not_found. DELETE when done.

import std.types { String }
import std.process { ExitSuccess }
import gunbc.cli_wire { CliWireResponse, CliWirePrintable }
import v2.std.diagnostic { diagnostics_reason_lexemes, Outcome }
import v2.workflow.bash_command_fold_serialize { bash_fold_serialize_node }
import v2.extdeps.languages.bash_build {
  bash_build_command_from_word_nodes, bash_build_word_var, bash_build_command_from_lits,
  bash_build_with_redir_from_file, bash_build_word_positional, bash_build_word_double_quoted,
  bash_build_word_kinded, bash_build_command_with_words, bash_build_word_bare, bash_build_word_lit,
}

fn probe(label: String, outcome: Outcome<String>) -> String {
  match outcome {
    Accepted { value: v } => concat(label, concat(" ACCEPTED[", concat(v, "]\n")))
    Rejected { diagnostics: d } =>
      concat(label, concat(" REJECTED[", concat(diagnostics_reason_lexemes(diagnostics: d), "]\n")))
  }
}

fn main() -> CliWireResponse {
  let positional0 = match bash_build_word_positional(index: "0") {
    Present { value: p } => p
    Absent => bash_build_word_kinded(kind: ^scratch_refused_positional, value: "0")
  }
  let dq0 = match bash_build_word_double_quoted(parts: [positional0]) {
    Present { value: n } => n
    Absent => bash_build_word_kinded(kind: ^scratch_refused_dq, value: "0")
  }
  let exec_cmd = bash_build_command_from_lits(lits: ["exec"])
  let echo_bare = bash_build_command_with_words(words: [bash_build_word_bare(text: "echo")])
  let echo_lit = bash_build_command_with_words(words: [bash_build_word_lit(text: "echo")])
  let bad_var = bash_build_command_from_word_nodes(words: [bash_build_word_var(name: "1x")])
  let redir_bare = bash_build_with_redir_from_file(
    inner: exec_cmd,
    path: bash_build_word_bare(text: "/root/engine.args")
  )
  CliWirePrintable {
    bytes: concat(
      concat(
        concat(
          concat(
            concat(
              concat(
                concat("P1_POSITIONAL ", probe(label: "", outcome: bash_fold_serialize_node(stmt: positional0))),
                concat("P2_DQ0 ", probe(label: "", outcome: bash_fold_serialize_node(stmt: dq0)))
              ),
              concat("P3_EXEC ", probe(label: "", outcome: bash_fold_serialize_node(stmt: exec_cmd)))
            ),
            concat(
              "P4_REDIR_DQ0 ",
              probe(label: "", outcome: bash_fold_serialize_node(stmt: bash_build_with_redir_from_file(inner: exec_cmd, path: dq0)))
            )
          ),
          concat("P5_ECHO_BARE ", probe(label: "", outcome: bash_fold_serialize_node(stmt: echo_bare)))
        ),
        concat("P6_ECHO_LIT ", probe(label: "", outcome: bash_fold_serialize_node(stmt: echo_lit)))
      ),
      concat(
        concat("P7_BADVAR ", probe(label: "", outcome: bash_fold_serialize_node(stmt: bad_var))),
        concat("P8_REDIR_BARE ", probe(label: "", outcome: bash_fold_serialize_node(stmt: redir_bare)))
      )
    ),
    exit: ExitSuccess,
  }
}
