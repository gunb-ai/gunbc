  },
}

fn w_gpu_only_field() -> List<CapCandidate> { [w_gpu_only_expensive, w_gpu_only_cheaper] }

// AN OFF-CIRCUIT TWIN: identical readings to the cheaper point, on a machine the fixture circuit does not
// carry. If selection could reach it, circuit membership would be decoration.
data w_ken_identity: DeclarationRef = w_identity(name: "w-ken-host-twin")

data w_ken_host_candidate: CapCandidate = CapCandidate {
  identity: w_ken_identity,
  label: "fixture twin, 30 W cap, 1500 MHz ceiling, 24.1 tok/s, 70-78 W drawn, on a machine OFF the circuit" as NonEmptyStr,
  host: operator_host_e2d4b7,
  gpu_cap: w_cap_30,
  cpu_cap: CappedAt { maximum: hertz(count: 2000000000) },
  sm_clock: CappedWithin { maximum: hertz(count: 1500000000) },
  condition: w_condition_cool,
  decode: DecodeRead {
    rate_low: milli_tokens_per_second(count: 24100),
    rate_high: milli_tokens_per_second(count: 24100),
    at_concurrency: 1,
    window: "fixture window" as NonEmptyStr,
    instrument: "fixture: sampled journal read" as NonEmptyStr,
    standing: CitedToAuthority { authority: w_fixture_authority },
  },
  draw: DrawRead {
    draw_low: milliwatt(count: 70000),
    draw_high: milliwatt(count: 78000),
    samples: 150,
    subject: HostLevel {
      instrument: "fixture: wattmeter on the machine's feed, sampled across the decode window" as NonEmptyStr,
      covers: "the whole machine at its feed" as NonEmptyStr,
    },
    throttle_share_note: Present { value: "fixture: 87% of the window power-capped" as NonEmptyStr },
    observed_on: "fixture" as NonEmptyStr,
    standing: CitedToAuthority { authority: w_fixture_authority },
  },
}

// The whole fleet field the fold can be asked about, for the census-style claims.
fn all_fleet_candidates() -> List<CapCandidate> {
  concat(
    concat(srv4_cap_ask_candidates(), srv4_morning_candidates()),
    concat(ken_cap_ask_candidates(), [srv3_40w_candidate, srv3_30w_2ghz_candidate]),
  )
}

// An assessment whose completeness join IS closed -- legitimate ONLY beside a fully-read fixture field, and
// never this module's own claim.
fn w_read_assessment(circuit: SharedPowerCircuit) -> DecisionAssessment {
  DecisionAssessment {
    subject: cap_ask_subject(circuit: circuit, term_ground: CitedToAuthority { authority: w_fixture_authority }),
    sensitivities: [VariesAlong {
      term: id_term,
      variable: id_var,
      region: cap_ask_region,
      relation: MonotoneIncreasing,
      coupling: CitedToAuthority { authority: w_fixture_authority },
    }],
    constraints: [ConstraintSatisfied {
      constraint: constraint_identity(circuit: circuit),
      evidence: "fixture: the circuit bound is stated for this witness" as NonEmptyStr,
    }],
    parameters: [ParameterBound {
      parameter: id_parameter,
      evidence: "fixture: the workload is bound for this witness" as NonEmptyStr,
    }],
    selected_candidate: Absent, term_drops: [],
    physical_model: PhysicalModelEstablished { terms: [id_term] },
    causal_model: CausalModelEstablished {
      couplings: [FleetObservedCoupling {
        receipt: w_fixture_coupling,
        term: id_term,
        variable: id_var,
        subject: cap_ask_subject_identity(circuit: circuit),
      }],
    },
  }
}

// ── THE LITTLE PREDICATES, so no test compares coproduct values with `==` ──────────────────────────

fn is_worse(c: AxisComparison) -> Bool { match c { Worse => true _ => false } }
fn is_better(c: AxisComparison) -> Bool { match c { Better => true _ => false } }
fn is_undecided(c: AxisComparison) -> Bool { match c { UndecidedOnEvidence => true _ => false } }

fn cpu_is_capped_at_2ghz(c: CapCandidate) -> Bool {
  match c.cpu_cap {
    CappedAt { maximum: h } => hertz_count(h: h) == 2000000000
    _ => false
  }
}

fn cpu_is_uncapped(c: CapCandidate) -> Bool {
  match c.cpu_cap {
    Uncapped => true
    _ => false
  }
}

fn ceiling_of(c: CapCandidate) -> Int {
  match c.sm_clock {
    CappedWithin { maximum: h } => hertz_count(h: h)
    _ => 0
  }
}

fn afternoon_window_is_carried_with_its_width() -> Bool {
  match axis_reading_of(c: srv4_40w_30ghz_afternoon_candidate, axis: ax_decode_tokens_per_second) {
    Present { value: iv } => interval_low(interval: iv) == 28500000 && interval_high(interval: iv) == 34000000
    Absent => false
  }
}

// Does this candidate ANSWER for one funded axis -- as a reading or as a named gap? A candidate silent on an
// axis would let a comparison run on half the trade, which is how a cap gets priced by its benefit alone.
fn axis_answered_for(c: CapCandidate, a: SelectionAxis) -> Bool {
  let e = candidate_entry(c: c)
  any(e.readings, r => same_ref(a: r.axis, b: a.identity))
    || any(e.missing_inputs, g => same_ref(a: g.axis, b: a.identity))
}

// And does the gap name the reading that would close it? A gap that only said "unmeasured" would be
// indistinguishable from one nobody can close.
fn gap_naming(c: CapCandidate, axis: DeclarationRef, pattern: String) -> Bool {
  let e = candidate_entry(c: c)
  any(e.missing_inputs, g =>
    same_ref(a: g.axis, b: axis) && string_contains(s: g.cause as String, pattern: pattern)
  )
}

fn same_ref(a: DeclarationRef, b: DeclarationRef) -> Bool {
  declaration_ref_identity(reference: a).digest == declaration_ref_identity(reference: b).digest
}

fn needs_mention(needs: List<SelectionEvidenceNeed>, pattern: NonEmptyStr) -> Bool {
  any(needs, n => string_contains(s: selection_evidence_need_cause(n: n) as String, pattern: pattern as String))
}
