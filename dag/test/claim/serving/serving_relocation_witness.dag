module test.claim.serving.serving_relocation_witness

// The nine tail scenarios for fabric-governed conversation relocation, as pure model witnesses
// (run with: gunbc run --source-root dag --source-root src/v2 --entry
//  dag/test/claim/serving/serving_relocation_witness.dag --claim-run). Each pins the decision the
// model must reach — stay, move, defer, evacuate, recover, reconcile — and names the rule whose
// removal flips it. The router-observable ones are mirrored in
// //gunbc/instruments:router-proxy-falsifier.

import std.types { Bool, NonEmptyStr, List }
import std.optional { Present }
import std.decl_ref { DeclarationRef, decl_ref }
import std.algebra { string_contains }
import gunbc.serving.serving_relocation {
  decide_relocation, defer_when_demand_not_ready, move_candidate, stay_candidate, excluded_candidate, decide_evacuation,
  note_source_over_retain_promise, claim_move, attempt_dispatch, render_move_intent,
  Move, Stay, DeferredToPolicy, Evacuate, ReconciliationRequired,
  MoveClaimed, MoveAlreadyClaimed, RecoveredRecordedAttempt,
  HandoffRecord, Dispatched, ConversationId, ReconstructFromCompleteRequest,
  IntentPayload, NoIntent,
}
import gunbc.serving.caller_backlog {
  CallerBacklogSnapshot, CallerWorkRecord, WorkWaiting, RecoveryEvent, SeatRef, PartitionId,
  ReservationRef, LogicalWorkId,
}

data w_move_id: DeclarationRef = decl_ref(module_path: "test.claim.serving.serving_relocation_witness", decl_name: "w_move_id")

// 1. A ready continuation behind a long turn with another engine free -> MOVE. The incumbent carries
//    a long-context starvation cost (a ready turn is stuck behind a long turn on the source), so its
//    net is low; the free engine's move has a high net at equal service-class, so it dominates on the
//    single net-benefit axis. MUTATION: drop the move candidate (or its net dominance) -> only stay
//    survives -> Stay -> red.
test fn a_ready_continuation_behind_a_long_turn_with_a_free_engine_moves() -> Bool {
  let move = move_candidate(id: w_move_id, label: "free-engine" as NonEmptyStr, net: 90, service_class: 0)
  match decide_relocation(field: [stay_candidate(net: -50), move], closed: true) {
    Move { destination_label: _, receipt: _ } => true
    _ => false
  }
}

// 2. A near-maximum warm context with a tiny continuation -> STAY, because the source's incremental
//    work is less than the destination's missing state: staying pays almost nothing (small age cost),
//    while the move must reconstruct the whole near-max context (transition ~900) for a tiny gain, so
//    its net is far lower. MUTATION: zero the move's reconstruction cost (net -3) -> move wins -> red;
//    the discriminating rule is counting repeated prefill as cost.
test fn a_near_max_warm_context_with_a_tiny_continuation_stays() -> Bool {
  let move = move_candidate(id: w_move_id, label: "cold-destination" as NonEmptyStr, net: -903, service_class: 0)
  match decide_relocation(field: [stay_candidate(net: -5), move], closed: true) {
    Stay => true
    _ => false
  }
}

// 3. Compaction or a prefix change voids the incumbent's advantage -> MOVE: staying now pays the
//    reconstruction itself (its net collapses), so the prefix-aligned destination keeps the higher net.
//    MUTATION: keep the incumbent's warm advantage (stay net -5, pretend the prefix survived) -> stay
//    wins -> red.
test fn a_compaction_or_prefix_change_voids_the_incumbent_advantage_moves() -> Bool {
  let move = move_candidate(id: w_move_id, label: "prefix-aligned" as NonEmptyStr, net: -25, service_class: 0)
  match decide_relocation(field: [stay_candidate(net: -800), move], closed: true) {
    Move { destination_label: _, receipt: _ } => true
    _ => false
  }
}

// 4. Dormant state blocking runnable demand -> DEFER: a dormant conversation (awaiting a person) has
//    no runnable demand at this boundary, so the move is deferred regardless of how attractive its
//    economics look — re-evaluate at the next event. MUTATION: remove the demand-readiness guard (call
//    decide_relocation directly) -> the economic decision runs and moves -> red.
test fn dormant_state_blocking_runnable_demand_defers() -> Bool {
  let move = move_candidate(id: w_move_id, label: "cross" as NonEmptyStr, net: 90, service_class: 0)
  match defer_when_demand_not_ready(ready: false, field: [stay_candidate(net: -50), move], closed: true) {
    DeferredToPolicy => true
    _ => false
  }
}

// 5. Many tool returns at once onto new capacity -> the SECOND decision sees the FIRST's reservation.
//    After the first claim advances the record to the destination seat, a replay naming the old
//    predecessor seat mismatches and is refused: the claim is taken once per predecessor.
//    MUTATION: drop the predecessor check in rebind_reservation -> both claims succeed -> red.
test fn many_tool_returns_at_once_the_second_decision_sees_the_first_reservation() -> Bool {
  let work = "conv/many-returns" as LogicalWorkId
  let seat_a = SeatRef { partition: "p" as PartitionId, reservation: "r-source" as ReservationRef }
  let seat_b = SeatRef { partition: "p" as PartitionId, reservation: "r-dest" as ReservationRef }
  let before = CallerBacklogSnapshot {
    records: [CallerWorkRecord { work: work, seat: Present { value: seat_a }, generation: 0, phase: WorkWaiting, recovery: [] as List<RecoveryEvent> }],
  }
  let after = CallerBacklogSnapshot {
    records: [CallerWorkRecord { work: work, seat: Present { value: seat_b }, generation: 0, phase: WorkWaiting, recovery: [] as List<RecoveryEvent> }],
  }
  let first = claim_move(snapshot: before, work: work, from_seat: seat_a, to_seat: seat_b)
  let replay = claim_move(snapshot: after, work: work, from_seat: seat_a, to_seat: seat_b)
  match first {
    MoveClaimed => match replay {
      MoveAlreadyClaimed { held: _ } => true
      _ => false
    }
    _ => false
  }
}

// 6. Drain or failure right after a move -> EVACUATE despite the recent move; mandatory evacuation
//    follows feasibility, never an economic cooldown or the last move. MUTATION: gate evacuation on an
//    economic margin -> a just-moved session would not re-evacuate -> red.
test fn drain_right_after_a_move_evacuates() -> Bool {
  match decide_evacuation(destination_label: "owned-fleet-b" as NonEmptyStr) {
    Evacuate { destination_label: d } => d == "owned-fleet-b" as NonEmptyStr
    _ => false
  }
}

// 7. A retry, tool return, or controller crash mid-handoff -> the recorded attempt is RECOVERED, never
//    blindly re-sent elsewhere. MUTATION: drop the dispatch_count guard -> a second send is counted as
//    a new dispatch -> red.
test fn a_retry_or_crash_mid_handoff_recovers_the_recorded_attempt() -> Bool {
  let rec = HandoffRecord {
    conversation: "conv-1" as ConversationId, revision: 3,
    source_seat: SeatRef { partition: "p" as PartitionId, reservation: "r-a" as ReservationRef },
    destination_seat: SeatRef { partition: "p" as PartitionId, reservation: "r-b" as ReservationRef },
    phase: Dispatched, method: ReconstructFromCompleteRequest, dispatch_count: 1,
  }
  match attempt_dispatch(record: rec) {
    RecoveredRecordedAttempt => true
    _ => false
  }
}

// 8. Cold prefill beside active decoding -> the move candidate violates the service-class hard bound
//    and is EXCLUDED before Pareto, never ranked; only stay remains feasible. MUTATION: raise the
//    service-class bound above the violating reading -> it is ranked and wins on net -> Move -> red.
test fn cold_prefill_beside_active_decoding_excludes_before_pareto() -> Bool {
  let move = excluded_candidate(id: w_move_id, label: "cold-prefill-violates-service-class" as NonEmptyStr)
  match decide_relocation(field: [stay_candidate(net: 0), move], closed: true) {
    Stay => true
    _ => false
  }
}

// 9. A source over its retained-capacity promise -> an OBLIGATION to reconcile, never "free".
//    MUTATION: make this return Move with no obligation -> the case that a move is not free is lost -> red.
test fn a_source_over_its_retain_promise_is_an_obligation_not_free() -> Bool {
  match note_source_over_retain_promise() {
    ReconciliationRequired { obligation: _ } => true
    _ => false
  }
}

// 10. The model RENDERS the /router/relocate payload from a real decision: a dominating move yields an
//     IntentPayload carrying conversation, revision, destination, method, allowance and the receipt
//     identities. This is the model's output the falsifier posts. MUTATION: render a literal instead of
//     running decide_relocation -> the receipt identities are absent -> red.
test fn render_move_intent_emits_the_router_payload_from_a_real_decision() -> Bool {
  let move = move_candidate(id: w_move_id, label: "free-engine" as NonEmptyStr, net: 90, service_class: 0)
  match render_move_intent(
    conversation: "conv-9" as ConversationId,
    from_launch: "srv3" as NonEmptyStr,
    current_revision: 7,
    authorization: "trial-allowance-1" as NonEmptyStr,
    transition_allowance_micros: 1000000,
    method: ReconstructFromCompleteRequest,
    field: [stay_candidate(net: -50), move],
    closed: true,
  ) {
    IntentPayload { payload: p } =>
      string_contains(s: p, pattern: "conversation=conv-9")
        && string_contains(s: p, pattern: "revision=7")
        && string_contains(s: p, pattern: "destination=free-engine")
        && string_contains(s: p, pattern: "method=reconstruct")
        && string_contains(s: p, pattern: "allowance_micros=1000000")
        && string_contains(s: p, pattern: "receipt_selected=")
        && string_contains(s: p, pattern: "receipt_policy=")
    NoIntent { reason: _ } => false
  }
}

// 11. A stay decision renders NO intent: the router is never told to move when the model stays.
//     MUTATION: render an intent even on Stay -> a spurious move command -> red.
test fn render_move_intent_emits_no_intent_when_the_model_stays() -> Bool {
  let move = move_candidate(id: w_move_id, label: "cold-destination" as NonEmptyStr, net: -903, service_class: 0)
  match render_move_intent(
    conversation: "conv-10" as ConversationId,
    from_launch: "srv3" as NonEmptyStr,
    current_revision: 2,
    authorization: "trial-allowance-1" as NonEmptyStr,
    transition_allowance_micros: 1000000,
    method: ReconstructFromCompleteRequest,
    field: [stay_candidate(net: -5), move],
    closed: true,
  ) {
    NoIntent { reason: _ } => true
    IntentPayload { payload: _ } => false
  }
}
