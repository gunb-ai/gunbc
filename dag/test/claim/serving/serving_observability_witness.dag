module test.claim.serving.serving_observability_witness

import std.types { String, Bool, List, Port, NonEmptyStr }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.optional { Optional, Present, Absent }
import std.decl_ref { DeclarationRef, decl_ref, declaration_ref_eq }
import gunbc.serving.serving_observability {
  EngineFrontProxyVerdict, EngineFrontProxyRendered, EngineFrontProxyRefused,
  EngineFrontProxyRefusal, OmitsRequiredRoute, EngineFrontRoute,
  engine_front_required_routes, engine_front_proxy_config, engine_front_render_forwards_route,
  engine_front_route_consumer,
  InstrumentDecision, NotAnInstrument, cold_token_cause_breakdown_standing,
  RouterProbeStanding, TransientReceiptOfHandManagedRouter, router_probe_line_standing,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// srv4's hand-managed TLS front (/opt/gunbc-serving/srv4-daily/nginx.conf) forwards the /v1/ inference
// routes and answers `return 404` to everything else, so /metrics is NOT forwarded. That forwarded set is
// what a hand-written proxy actually proxies; this is the observed misconfiguration, fed as the input the
// model must refuse.
fn srv4_forwarded_routes() -> List<NonEmptyStr> {
  [ "/v1/chat/completions" as NonEmptyStr, "/v1/models" as NonEmptyStr ] as List<NonEmptyStr>
}

// A front door that has learned the consumed-requirement lesson: every route a fleet reader needs is
// forwarded, including the metrics route srv4 dropped.
fn complete_forwarded_routes() -> List<NonEmptyStr> {
  map(engine_front_required_routes, r => r.path)
}

fn front(forwarded: List<NonEmptyStr>) -> EngineFrontProxyVerdict {
  engine_front_proxy_config(
    bind_address: "0.0.0.0" as NonEmptyStr,
    listen_port: 8443,
    tls_cert: "/etc/tls/engine.crt" as NonEmptyStr,
    tls_key: "/etc/tls/engine.key" as NonEmptyStr,
    engine_host: "127.0.0.1" as NonEmptyStr,
    engine_port: 8080,
    forwarded: forwarded,
  )
}

// The /metrics reader the roster names, as a typed reference the witness compares against (not a grep).
fn metrics_reader_ref() -> DeclarationRef {
  decl_ref(module_path: "gunbc.serving.engine_progress", decl_name: "engine_progress_read")
}

// RED: srv4's front door is refused, naming the route it dropped AND the typed consumer whose read it
// blocked. The misconfig is unrenderable rather than something a downstream check has to catch.
test fn srv4_front_dropping_the_metrics_route_is_refused_naming_route_and_consumer() -> Bool {
  match front(forwarded: srv4_forwarded_routes()) {
    EngineFrontProxyRefused { refusal: OmitsRequiredRoute { route: r, consumer: c } } =>
      (r as String) == "/metrics" && declaration_ref_eq(a: c, b: metrics_reader_ref())
    _ => false
  }
}

// The complete front -- every consumed route forwarded -- is ACCEPTED (the refusal is discriminating, not
// always-on: only the consumed-requirement roster is enforced).
test fn the_complete_front_door_is_accepted() -> Bool {
  match front(forwarded: complete_forwarded_routes()) {
    EngineFrontProxyRendered { text: _ } => true
    _ => false
  }
}

// The accepted front actually PROXIES the metrics and inference routes to the engine: the rendered bytes
// carry a proxy_pass for each, which is the point of those routes being consumed requirements.
test fn the_accepted_front_proxies_the_metrics_and_inference_routes() -> Bool {
  match front(forwarded: complete_forwarded_routes()) {
    EngineFrontProxyRendered { text: t } =>
      engine_front_render_forwards_route(text: t, route: "/metrics" as NonEmptyStr)
        && engine_front_render_forwards_route(text: t, route: "/v1/chat/completions" as NonEmptyStr)
    EngineFrontProxyRefused { refusal: _ } => false
  }
}

// CONSUMPTION (typed, not a grep): the roster's /metrics consumer is the engine_progress reader, reached by
// executing engine_front_route_consumer -- the same accessor the ledger uses, so this is not a shape check.
test fn the_metrics_route_names_its_progress_consumer_by_reference() -> Bool {
  match engine_front_route_consumer(path: "/metrics" as NonEmptyStr) {
    Present { value: c } => declaration_ref_eq(a: c, b: metrics_reader_ref())
    Absent => false
  }
}

// ITEM (2): the per-cause cold-token breakdown is recorded NOT an instrument, and its would-be consumer is
// a typed reference (a rename of engine_progress_read would break this), not prose.
test fn cold_token_cause_breakdown_is_recorded_not_an_instrument_with_a_typed_consumer() -> Bool {
  match cold_token_cause_breakdown_standing {
    NotAnInstrument { would_be_consumer: w, reason: _, add_when_trigger: _ } =>
      declaration_ref_eq(a: w, b: metrics_reader_ref())
    NamedInstrument { consumer: _, discriminator: _, acceptable_cost: _ } => false
  }
}

// ITEM (3): the router probe lines' standing is the transient receipt of the HAND-MANAGED router, and it
// names the modelled rows that retire it by typed reference -- reached by reading the typed carrier, not by
// grepping a prose paragraph.
test fn router_probe_line_standing_is_a_hand_managed_receipt_pointing_at_the_modelled_rows() -> Bool {
  let s = router_probe_line_standing
  match s.standing {
    TransientReceiptOfHandManagedRouter =>
      any(s.retires_via, d => (d.module_path as String) == "gunbc.serving.serving_relocation")
        && any(s.retires_via, d => (d.module_path as String) == "gunbc.serving.router_realization")
    ModelledRouterInstrument => false
  }
}
