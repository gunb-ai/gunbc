module test.claim.serving.serving_observability_witness

import std.types { String, Bool, List, Port, NonEmptyStr }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.optional { Optional, Present, Absent }
import std.algebra { length }
import std.decl_ref { DeclarationRef, decl_ref, declaration_ref_eq }
import gunbc.serving.serving_observability {
  EngineFrontProxyVerdict, EngineFrontProxyRendered, EngineFrontProxyRefused,
  EngineFrontRoute, engine_front_required_routes,
  engine_front_proxy_config, engine_front_server_directives, engine_front_proxies_route,
  engine_front_route_consumer, engine_front_unserved_consumers,
  InstrumentStanding, InstrumentProposal, InstrumentAddGate, instrument_promotion_admitted,
  cold_token_cause_breakdown_standing,
  RouterProbeStanding, ProbeStanding, TransientReceiptOfHandManagedRouter, ModelledRouterInstrument,
  router_probe_line_standing, ProbeFactsCarried, RouterProbeRetirement, MayRetire, KeepHandManagedReceipt,
  router_probe_attribution_is_modelled, router_probe_retirement,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// The /metrics reader the roster names, as a typed reference the witness compares against (not a grep).
fn metrics_reader_ref() -> DeclarationRef {
  decl_ref(module_path: "gunbc.serving.engine_progress", decl_name: "engine_progress_read")
}

// srv4's hand-managed TLS front (/opt/gunbc-serving/srv4-daily/nginx.conf) actually forwards only the /v1/
// inference routes and answers `return 404` to everything else, so /metrics is not forwarded. This is the
// OBSERVED host forwarded set -- an observation read off the host, used to reconcile against the roster.
fn srv4_observed_forwarded() -> List<NonEmptyStr> {
  [ "/v1/chat/completions" as NonEmptyStr, "/v1/models" as NonEmptyStr ] as List<NonEmptyStr>
}

// A front that forwards every roster route (the reconciled, correct host state).
fn complete_observed_forwarded() -> List<NonEmptyStr> {
  map(engine_front_required_routes, r => r.path)
}

// RED: reconciling srv4's OBSERVED forwarded set against the roster names the consumer whose read the
// hand-managed front blocked -- the /metrics reader, by typed reference. This is the class made decidable:
// nothing refuses it in production yet (that is the ledger's climb), but the model now SAYS who is shut out.
test fn srv4_observed_front_blocks_the_metrics_consumer() -> Bool {
  let blocked = engine_front_unserved_consumers(observed: srv4_observed_forwarded())
  any(blocked, c => declaration_ref_eq(a: c, b: metrics_reader_ref()))
}

// Positive control on the reconciliation: a front that forwards every roster route blocks no consumer.
test fn a_complete_observed_front_blocks_no_consumer() -> Bool {
  length(engine_front_unserved_consumers(observed: complete_observed_forwarded())) == 0
}

// The RENDER is derived from the roster with no forwarded input: it always proxies every consumed route,
// so a front missing /metrics has no constructor (guarantee_ladder). This asserts the metrics and inference
// routes really reach the engine as ProxyPassToHost directives. Discriminating: a route absent from the
// roster (/debug) is NOT proxied, so this proves the check is not vacuously true (fail_closed).
test fn the_rendered_front_always_proxies_the_consumed_routes() -> Bool {
  match engine_front_server_directives(
    bind_address: "0.0.0.0" as NonEmptyStr,
    listen_port: 8443,
    tls_cert: "/etc/tls/engine.crt" as NonEmptyStr,
    tls_key: "/etc/tls/engine.key" as NonEmptyStr,
    engine_host: "127.0.0.1" as NonEmptyStr,
    engine_port: 8080,
  ) {
    Present { value: rows } =>
      engine_front_proxies_route(ds: rows, route: "/metrics" as NonEmptyStr)
        && engine_front_proxies_route(ds: rows, route: "/v1/chat/completions" as NonEmptyStr)
        && engine_front_proxies_route(ds: rows, route: "/v1/models" as NonEmptyStr)
        && !engine_front_proxies_route(ds: rows, route: "/debug" as NonEmptyStr)
    Absent => false
  }
}

// CONSUMPTION (typed, not a grep): the roster's /metrics consumer is the engine_progress reader, reached by
// executing engine_front_route_consumer -- the same accessor the ledger uses, so not a shape check.
test fn the_metrics_route_names_its_progress_consumer_by_reference() -> Bool {
  match engine_front_route_consumer(path: "/metrics" as NonEmptyStr) {
    Present { value: c } => declaration_ref_eq(a: c, b: metrics_reader_ref())
    Absent => false
  }
}

// ITEM (2): the per-cause cold-token breakdown is gated OUT of the roster. The witness drives the real gate
// fold three ways -- the real standing refuses (RED, the decision), an open matched gate admits (accepted
// positive control), and a missing discriminator is refused (proves the typed condition is read) -- so the
// standing is consumed for behaviour, not existence (gunbc.design_argument::consumption).
fn matched_open_gate() -> InstrumentStanding {
  InstrumentStanding {
    is_instrument: false,
    promotion: Present { value: InstrumentAddGate {
      budgets_open: true,
      required_consumer: metrics_reader_ref(),
      needs_discriminator: true,
      needs_declared_cost: true,
    } },
  }
}

test fn cold_token_cause_breakdown_is_gated_out_of_the_roster() -> Bool {
  // RED: the real standing (is_instrument:false, budgets_open:false) refuses even a fully-formed proposal --
  // the decision that the breakdown is NOT an instrument, produced by the fold.
  !instrument_promotion_admitted(
    standing: cold_token_cause_breakdown_standing,
    proposal: InstrumentProposal { consumer: metrics_reader_ref(), names_discriminator: true, declares_cost: true },
  )
    // ACCEPTED positive control: the SAME fold admits once the gate is open and every typed condition matches.
    // The refusal above is therefore discriminating (driven by the typed fields), not a constant false.
    && instrument_promotion_admitted(standing: matched_open_gate(),
      proposal: InstrumentProposal { consumer: metrics_reader_ref(), names_discriminator: true, declares_cost: true })
    // The discriminator condition is genuinely read: an open gate still refuses a proposal that omits it.
    && !instrument_promotion_admitted(standing: matched_open_gate(),
      proposal: InstrumentProposal { consumer: metrics_reader_ref(), names_discriminator: false, declares_cost: true })
}

// ITEM (3): the router probe lines are a transient receipt of the HAND-MANAGED router. Both gate folds are
// driven for behaviour: the receipt is not a modelled fact, the lines cannot retire while the modelled rows
// carry no facts (RED -- the hand-managed TEMPORARY note is no authority to delete them), and once BOTH
// facts are carried on the modelled side the same fold hands the lines off to the retires_via rows (accepted
// positive control), so retires_via and the standing are read, not asserted to exist.
test fn router_probe_line_standing_is_a_hand_managed_receipt_that_cannot_self_retire() -> Bool {
  // attribution built on the hand-managed receipt is NOT a modelled fact of the router (reads the standing)
  !router_probe_attribution_is_modelled(s: router_probe_line_standing)
    // RED: with the modelled rows not yet carrying the facts, the lines cannot retire
    && match router_probe_retirement(s: router_probe_line_standing,
         carried: ProbeFactsCarried { prefix_overlap_modelled: false, token_usage_modelled: false }) {
         KeepHandManagedReceipt => true
         MayRetire { hands_off_to: _ } => false
       }
    // ACCEPTED positive control: once BOTH facts are carried the same fold hands off to the three retires_via
    // rows -- proving the fold discriminates and reads retires_via (a structural count, not a string grep).
    && match router_probe_retirement(s: router_probe_line_standing,
         carried: ProbeFactsCarried { prefix_overlap_modelled: true, token_usage_modelled: true }) {
         MayRetire { hands_off_to: rows } => length(rows) == 3
         KeepHandManagedReceipt => false
       }
    // the ModelledRouterInstrument arm of the standing reads as a modelled fact (both arms exercised)
    && router_probe_attribution_is_modelled(s: RouterProbeStanding {
         standing: ModelledRouterInstrument, retires_via: router_probe_line_standing.retires_via })
}
