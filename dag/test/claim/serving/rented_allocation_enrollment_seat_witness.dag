module test.claim.serving.rented_allocation_enrollment_seat_witness

import std.types { String, Bool, NonEmptyStr, List }
import gunbc.serving.serving_artifact_placement { ServingStoreRoots }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import gunbc.host.host_standup { HostStandupStep, HostStandupAssimilationPhase, Assimilation, InferenceServingProvision, ComputeFabricEnroll, RunnerDeploySlot, BuildCacheProvision, CodexRuntimeProvision, GreenPlaceReadiness }
import gunbc.host.host_assimilation_program { assimilation_program_for }
import gunbc.fleet.fleet_enrollment { HostEnrollmentIntent, inference_serving_enrollment_participation }
import gunbc.fleet.fleet_host_backing { ProviderGuest, ProviderResourceAwaited }
import gunbc.serving.rented_allocation { RentedServingAllocation, RentedContractRead, rented_allocation_replica }
import gunbc.serving.rented_allocation_host_enrollment {
  RentedGuestEntitlementRead, RentedGuestEntitlementUnread,
  RentedHostEnrollmentDerived, RentedHostEnrollmentRefused, RentedHostEnrollmentDerivation,
  rented_allocation_host_enrollment, rented_contract_unread_no_route_obligation,
}
import gunbc.harness.rented_allocation_seat { RentedSeatDerived, RentedSeatRefused, rented_allocation_seat }
import gunbc.harness.harness_seat { harness_seat_partition }
import gunbc.serving.turn_admission { InteractiveQualitySensitive }
import gunbc.serving.serving_launch {
  ServingServeNotListening, ServingServeKeyBinding, ServingServeKeyUnbound, ServingServeKeyBound,
  ServingLaunchRefusedUnmetCauses, ServingLaunchRefusedKeyNotDelivered,
  serving_launch_leg, serving_launch_leg_text,
}
import gunbc.serving.serving_key_grant {
  ServingKeySubject, ServingKeyGrantBound, ServingKeyGrantRefused,
  serving_key_request, serving_key_pattern, serving_key_grant_pending_cause, serving_key_grant_bind,
}
import std.scoped_authorization { ScopedAuthorization, AuthorizationRequest, AuthorizationPending, AuthorizationGranted, OperatorGrant, Unclaimed, AttemptIdentity }
import std.algebra { string_contains }
import extdeps.ninfer.ninfer_serve { ninfer_serve_launch_argv }
import gunbc.harness.operator_pod_launch { operator_pod_ninfer_launch, operator_pod_listen_port }
import test.claim.serving.rented_allocation_witness { a_allocation, a_tunnel }
import test.claim.serving.rented_instance_offer_witness { i_instance }
import test.claim.host.provider_guest_adoption_witness { cax41_entitlement }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn s_read_allocation() -> RentedServingAllocation {
  let base = a_allocation(route: a_tunnel(target_port: 8000))
  RentedServingAllocation {
    identity: base.identity, origin: base.origin, contract: RentedContractRead { offer: i_instance(gpus: 1) },
    card: base.card, end: base.end, engine: base.engine, artifact: base.artifact, host: base.host, route: base.route,
  }
}

fn s_derived_phases(r: RentedHostEnrollmentDerivation) -> List<HostStandupStep> {
  match r {
    RentedHostEnrollmentDerived { allocation: _, intent: i } => assimilation_program_for(intent: i).steps
    RentedHostEnrollmentRefused { allocation: _, obligation: _ } => []
  }
}

fn s_has_phase(steps: List<HostStandupStep>, p: HostStandupAssimilationPhase) -> Bool {
  any(xs: steps, predicate: fn(s) { match s.phase { Assimilation { phase: q } => q == p  _ => false } })
}

// THE DERIVED INTENT SELECTS EXACTLY THE INFERENCE PROGRAM: provision present, every runner phase absent.
test fn the_derived_intent_selects_inference_provision_and_no_runner_phase() -> Bool {
  let steps = s_derived_phases(r: rented_allocation_host_enrollment(a: s_read_allocation(), entitlement: RentedGuestEntitlementRead { entitlement: cax41_entitlement() }))
  s_has_phase(steps: steps, p: InferenceServingProvision) && s_has_phase(steps: steps, p: ComputeFabricEnroll)
    && !s_has_phase(steps: steps, p: RunnerDeploySlot) && !s_has_phase(steps: steps, p: BuildCacheProvision)
    && !s_has_phase(steps: steps, p: CodexRuntimeProvision) && !s_has_phase(steps: steps, p: GreenPlaceReadiness)
}

test fn the_derived_intent_is_inference_participation_over_a_provider_guest_with_an_awaited_resource() -> Bool {
  match rented_allocation_host_enrollment(a: s_read_allocation(), entitlement: RentedGuestEntitlementRead { entitlement: cax41_entitlement() }) {
    RentedHostEnrollmentDerived { allocation: _, intent: i } =>
      i.participation == inference_serving_enrollment_participation
        && (match i.backing { ProviderGuest { route: _, entitlement: _, resource: ProviderResourceAwaited { read_obligation: _ } } => true  _ => false })
    RentedHostEnrollmentRefused { allocation: _, obligation: _ } => false
  }
}

// THE REFUSALS ARE TYPED: an unread contract names no route; an unread entitlement is its own obligation.
test fn an_unread_contract_refuses_with_its_obligation() -> Bool {
  match rented_allocation_host_enrollment(a: a_allocation(route: a_tunnel(target_port: 8000)), entitlement: RentedGuestEntitlementRead { entitlement: cax41_entitlement() }) {
    RentedHostEnrollmentRefused { allocation: _, obligation: o } => o == rented_contract_unread_no_route_obligation
    RentedHostEnrollmentDerived { allocation: _, intent: _ } => false
  }
}

test fn an_unread_entitlement_refuses_with_the_supplied_obligation() -> Bool {
  match rented_allocation_host_enrollment(a: s_read_allocation(), entitlement: RentedGuestEntitlementUnread { obligation: "witness: entitlement unread" as NonEmptyStr }) {
    RentedHostEnrollmentRefused { allocation: _, obligation: o } => o == ("witness: entitlement unread" as NonEmptyStr)
    RentedHostEnrollmentDerived { allocation: _, intent: _ } => false
  }
}

// THE SEAT BINDS TO THE ALLOCATION ID and keeps the existing replica-keyed partition law.
test fn the_seat_carries_the_allocation_id_and_the_harness_partition() -> Bool {
  let a = s_read_allocation()
  match rented_allocation_seat(a: a, class: InteractiveQualitySensitive) {
    RentedSeatDerived { allocation: id, partition: p, ceiling: c } => id == a.identity && p == harness_seat_partition(replica: rented_allocation_replica(a: a), class: InteractiveQualitySensitive, ceiling: c)
    RentedSeatRefused { allocation: _, obligation: _ } => false
  }
}

// THE KEY GRANT. Fixture key text is distinctive so any leak into the leg text is visible.
fn s_subject() -> ServingKeySubject {
  ServingKeySubject { allocation: s_read_allocation().identity }
}

fn s_request() -> AuthorizationRequest<ServingKeySubject> {
  serving_key_request(escalation_id: "esc-1" as NonEmptyStr, subject: s_subject(), attempt: "attempt-1" as AttemptIdentity)
}

fn s_authorization() -> ScopedAuthorization<ServingKeySubject> {
  let r = s_request()
  AuthorizationGranted {
    grant: OperatorGrant {
      escalation_id: r.escalation_id, scopes: r.scopes, subject: r.subject, purpose: r.purpose, attempt: r.attempt, intent_hash: r.intent_hash,
      granted_by: "operator" as NonEmptyStr, granted_at: "2026-10-12T10:00:00Z", expires_at: "2026-10-12T11:00:00Z",
    },
    claim: Unclaimed,
  }
}

test fn a_pending_authorization_is_not_a_bound_grant() -> Bool {
  match serving_key_grant_bind(subject: s_subject(), authorization: AuthorizationPending { request: s_request() }) {
    ServingKeyGrantRefused { cause: c } => c == serving_key_grant_pending_cause
    ServingKeyGrantBound { grant: _ } => false
  }
}

fn s_key_binding() -> ServingServeKeyBinding {
  match serving_key_grant_bind(
    subject: s_subject(),
    authorization: s_authorization(),
  ) {
    ServingKeyGrantBound { grant: g } => ServingServeKeyBound { grant: g }
    ServingKeyGrantRefused { cause: c } => ServingServeKeyUnbound { grant_name: c }
  }
}

fn s_argv() -> List<String> {
  ninfer_serve_launch_argv(launch: operator_pod_ninfer_launch, model_path: "/root/serve/model/model.ninfer" as NonEmptyStr, listen_port: operator_pod_listen_port)
}

// PAIRING: the real producer (the pattern selection) is what lets the grant bind.
test fn the_real_pattern_selection_binds_the_grant() -> Bool {
  match s_key_binding() { ServingServeKeyBound { grant: _ } => true  _ => false }
}

fn s_secret() -> String {
  "SECRET-KEY-TEXT-9f3a"
}

fn s_word_leaks(words: List<String>) -> Bool {
  any(xs: words, predicate: fn(w) { string_contains(s: w, pattern: s_secret()) })
}

// THE KEY CANNOT REACH ARGV BY CONSTRUCTION (no key field on the launch or the bound arm); the fixture value is
// asserted absent from every argv word and the leg text, and the detector is shown to see it when present.
test fn a_bound_key_refuses_on_missing_delivery_and_the_key_text_is_nowhere() -> Bool {
  let leg = serving_launch_leg(roots: s_roots(), launch: operator_pod_ninfer_launch, launch_argv: s_argv(), reading: ServingServeNotListening, key: s_key_binding())
  (match leg { ServingLaunchRefusedKeyNotDelivered { key_grant: _, detach: _ } => true  _ => false })
    && !string_contains(s: serving_launch_leg_text(leg: leg), pattern: s_secret())
    && !s_word_leaks(words: s_argv())
}

test fn the_leak_detector_sees_the_value_as_a_positional_key_or_env_word() -> Bool {
  s_word_leaks(words: ["serve", s_secret()]) && s_word_leaks(words: ["--key=SECRET-KEY-TEXT-9f3a"]) && s_word_leaks(words: ["API_KEY=SECRET-KEY-TEXT-9f3a"])
}

test fn an_unbound_key_still_refuses() -> Bool {
  match serving_launch_leg(roots: s_roots(), launch: operator_pod_ninfer_launch, launch_argv: s_argv(), reading: ServingServeNotListening, key: ServingServeKeyUnbound { grant_name: "serve-api-key" as NonEmptyStr }) {
    ServingLaunchRefusedUnmetCauses { key_grant: _, detach: _ } => true
    _ => false
  }
}

fn s_roots() -> ServingStoreRoots {
  ServingStoreRoots {
    root: "/root/serve/store" as NonEmptyStr,
    model_link: "/root/serve/model/model.ninfer" as NonEmptyStr,
    serve_log: "/root/serve/serve.log" as NonEmptyStr,
  }
}
