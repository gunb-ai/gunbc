module test.claim.serving.gpu_power_state_policy_witness

import std.types { Bool, Int, List, NonEmptyStr, String }
import product.placement_supply { PhysicalAssetIdentity }
import std.optional { Absent, Present }
import std.measure { watt, watt_count }
import std.algebra { string_contains }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import extdeps.pci.identity { PciAddress }
import gunbc.fleet.fleet_host_identity { operator_host_srv1, operator_host_srv2, operator_host_srv4, operator_host_6ce85c, operator_host_e2d4b7 }
import gunbc.fleet.fleet_asset_identity { gpu_board_01, gpu_board_02, gpu_board_03, gpu_board_04, gpu_board_05, gpu_board_06 }
import gunbc.fleet.gpu_device_observation { GpuDeviceObservation, GpuDeviceEnumerated, GpuDeviceNotEnumerated, GpuPowerLimitControl, NvidiaSmiPowerLimit, AmdgpuHwmonPowerCap }
import extdeps.linux.amdgpu_hwmon { Power1Cap }
import gunbc.serving.gpu_power_state_policy {
  InstalledGpuCapIntent, OperatorDeclaredCap, SustainedPowerDraw, CappedQuantityUnstated, gpu_power_cap_bounds,
  GpuCapAdmission, GpuCapAdmitted, GpuCapOutsideDeviceRange, GpuCapDevicePending,
  admit_gpu_cap_against, gpu_cap_admitted, gpu_cap_admissions_on, srv1_pro_6000_cap_decision, h11_r9700_cap_decision,
  ken_t10_cap_decision, srv4_rtx_2000_ada_cap_decision,
  srv4_rtx_2000_ada_measured_prices, every_measured_cap_price_states_its_configuration,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE REAL PATH: srv1's two RTX PRO 6000 boards joined against their current observations, read on srv1
// 2026-11-08. BOTH ADMIT at 300 W against their OWN reported ranges and each is addressed by UUID: the Max-Q
// inside 250-325 W, the Workstation card inside 150-600 W. The Workstation card sat unpowered and
// unenumerated on 2026-11-07 and came up on 2026-11-08, which is why this test used to expect a pending
// admission for it; the ranges differ in both directions (150 W is applyable on the Workstation card and
// refused by the Max-Q), so admission is per-device and one operator decision admits two cards without
// clamping. srv2 carries no cap intent, so it admits nothing.
test fn srv1_admits_both_pro_6000s_at_300w_each_addressed_by_uuid() -> Bool {
  let admissions = gpu_cap_admissions_on(host: operator_host_srv1)
  admissions.length() == 2
    && any(admissions, a => match a {
      GpuCapAdmitted { host: _, board: b, gpu_uuid: u, cap: c } =>
        (b as String) == (gpu_board_04 as String) && (u as String) == "GPU-7b58568e-8bc9-4e4b-bc6c-c414b08936c3" && watt_count(w: c) == 300
      _ => false
    })
    && any(admissions, a => match a {
      GpuCapAdmitted { host: _, board: b, gpu_uuid: u, cap: c } =>
        (b as String) == (gpu_board_01 as String) && (u as String) == "GPU-96b749dc-e2ea-5b6f-2e45-ee868b1a9750" && watt_count(w: c) == 300
      _ => false
    })
    && gpu_cap_admissions_on(host: operator_host_srv2).length() == 0
}

fn intent_at(w: Int) -> InstalledGpuCapIntent {
  InstalledGpuCapIntent {
    host: operator_host_srv1,
    board: gpu_board_04,
    selection: OperatorDeclaredCap { cap: watt(count: w), bounds: CappedQuantityUnstated, decided_on: "fixture" as NonEmptyStr, said: "fixture" as NonEmptyStr },
  }
}

fn enumerated_via(uuid: NonEmptyStr?, control: GpuPowerLimitControl) -> GpuDeviceObservation? {
  Present { value: GpuDeviceEnumerated {
    host: operator_host_srv1, board: gpu_board_04, gpu_uuid: uuid, pci_address: "0005:01:00.0" as PciAddress,
    power_limit_minimum: watt(count: 250), power_limit_maximum: watt(count: 325), power_limit_current: watt(count: 300),
    power_limit_default: Present { value: watt(count: 300) }, power_limit_control: control, read_on: "fixture" as NonEmptyStr,
  } }
}

fn enumerated(uuid: NonEmptyStr?) -> GpuDeviceObservation? {
  enumerated_via(uuid: uuid, control: NvidiaSmiPowerLimit)
}

data fixture_uuid: NonEmptyStr? = Present { value: "GPU-fixture" as NonEmptyStr }

// THE RANGE IS THE DEVICE'S AND BOTH ENDS BITE; AN INFEASIBLE CAP REFUSES, NEVER CLAMPS. 325 is admitted
// (a rated-power ceiling of 300 would wrongly refuse it), 250 is admitted, 326 and 249 refuse, and 600
// refuses carrying the range it missed rather than being admitted at 325.
test fn a_cap_is_admitted_exactly_inside_the_device_range() -> Bool {
  gpu_cap_admitted(a: admit_gpu_cap_against(intent: intent_at(w: 325), observation: enumerated(uuid: fixture_uuid)))
    && gpu_cap_admitted(a: admit_gpu_cap_against(intent: intent_at(w: 250), observation: enumerated(uuid: fixture_uuid)))
    && !gpu_cap_admitted(a: admit_gpu_cap_against(intent: intent_at(w: 326), observation: enumerated(uuid: fixture_uuid)))
    && !gpu_cap_admitted(a: admit_gpu_cap_against(intent: intent_at(w: 249), observation: enumerated(uuid: fixture_uuid)))
    && match admit_gpu_cap_against(intent: intent_at(w: 600), observation: enumerated(uuid: fixture_uuid)) {
      GpuCapOutsideDeviceRange { board: _, cap: c, minimum: lo, maximum: hi } => watt_count(w: c) == 600 && watt_count(w: lo) == 250 && watt_count(w: hi) == 325
      _ => false
    }
}

fn pending_at_300(a: GpuCapAdmission) -> Bool {
  match a {
    GpuCapDevicePending { board: _, cap: c, read_obligation: _ } => watt_count(w: c) == 300
    _ => false
  }
}

// INSTALLED IS NOT AVAILABLE, AND A DEVICE WITHOUT A UUID IS NOT ADDRESSABLE: a board with no observation,
// a board that does not enumerate, and a device whose UUID was not read each keep the decided cap pending.
test fn an_unobserved_unenumerated_or_unaddressable_device_keeps_its_cap_pending() -> Bool {
  pending_at_300(a: admit_gpu_cap_against(intent: intent_at(w: 300), observation: Absent))
    && pending_at_300(a: admit_gpu_cap_against(intent: intent_at(w: 300), observation: enumerated(uuid: Absent)))
    && pending_at_300(a: admit_gpu_cap_against(intent: intent_at(w: 300), observation: Present { value: GpuDeviceNotEnumerated {
      host: operator_host_srv1, board: gpu_board_04, cause: "fixture" as NonEmptyStr, read_on: "fixture" as NonEmptyStr,
    } }))
}

test fn both_srv1_boards_carry_the_one_operator_decision() -> Bool {
  match srv1_pro_6000_cap_decision {
    OperatorDeclaredCap { cap: c, bounds: _, decided_on: d, said: s } => watt_count(w: c) == 300 && (d as String) == "2026-11-07" && contains(s as String, "300w")
  }
}

// AN amdgpu DEVICE'S CAP IS NEVER ADMITTED INTO THE nvidia-smi CONVERGE. The same in-range cap on the same fixture
// device admits when the control is nvidia-smi and stays pending, naming power1_cap, when the control is amdgpu's
// hwmon power1_cap -- even with a UUID present, so the refusal is the control's and not a missing identifier.
test fn an_amdgpu_controlled_device_keeps_an_in_range_cap_pending() -> Bool {
  gpu_cap_admitted(a: admit_gpu_cap_against(intent: intent_at(w: 300), observation: enumerated_via(uuid: fixture_uuid, control: NvidiaSmiPowerLimit)))
    && match admit_gpu_cap_against(intent: intent_at(w: 300), observation: enumerated_via(uuid: fixture_uuid, control: AmdgpuHwmonPowerCap { attribute: Power1Cap })) {
      GpuCapDevicePending { board: _, cap: c, read_obligation: o } => watt_count(w: c) == 300 && contains(o as String, "power1_cap")
      _ => false
    }
}

// THE REAL PATH ON host-6ce85c: the operator's 210 W R9700 decision is a SUSTAINED cap. Joined against the
// enumerating card it is inside the 210-300 W range (so it is not refused) and stays pending because the control is
// amdgpu's power1_cap; the second card does not enumerate, so its cap is pending on the device. Neither is dropped.
// The older srv1 decision keeps its unstated timescale.
test fn h11_r9700_cap_is_sustained_in_range_and_pending_on_the_amdgpu_control() -> Bool {
  let admissions = gpu_cap_admissions_on(host: operator_host_6ce85c)
  admissions.length() == 2
    && match gpu_power_cap_bounds(s: h11_r9700_cap_decision) { SustainedPowerDraw => true  CappedQuantityUnstated => false }
    && match gpu_power_cap_bounds(s: srv1_pro_6000_cap_decision) { SustainedPowerDraw => false  CappedQuantityUnstated => true }
    && any(admissions, a => match a {
      GpuCapDevicePending { board: b, cap: c, read_obligation: o } => b == gpu_board_02 && watt_count(w: c) == 210 && contains(o as String, "power1_cap")
      _ => false
    })
    && any(admissions, a => match a {
      GpuCapDevicePending { board: b, cap: c, read_obligation: o } => b == gpu_board_03 && watt_count(w: c) == 210 && contains(o as String, "does not enumerate")
      _ => false
    })
}

// FIXTURES AT KEN'S READ NUMBERS. The ranges and the control are what the 2026-11-18 read returned for each of
// the three functions (min 100 W, max 150 W, default 150 W, NvidiaSmiPowerLimit); the fixtures exist so the EDGES
// can be tested at those numbers without inventing corpus rows. The corpus rows themselves are exercised by the
// real-path claim below, which reads the population rather than these.
fn ken_intent_at(board: PhysicalAssetIdentity, w: Int) -> InstalledGpuCapIntent {
  InstalledGpuCapIntent {
    host: operator_host_e2d4b7, board: board,
    selection: OperatorDeclaredCap {
      cap: watt(count: w), bounds: CappedQuantityUnstated, decided_on: "fixture" as NonEmptyStr,
      said: "fixture at ken's read numbers" as NonEmptyStr,
    },
  }
}

fn ken_function_at(board: PhysicalAssetIdentity, uuid: NonEmptyStr?) -> GpuDeviceObservation? {
  Present { value: GpuDeviceEnumerated {
    host: operator_host_e2d4b7, board: board, gpu_uuid: uuid, pci_address: "0000:01:00.0" as PciAddress,
    power_limit_minimum: watt(count: 100), power_limit_maximum: watt(count: 150), power_limit_current: watt(count: 100),
    power_limit_default: Present { value: watt(count: 150) }, power_limit_control: NvidiaSmiPowerLimit,
    read_on: "fixture at ken's read numbers" as NonEmptyStr,
  } }
}

// THE REAL PATH ON ken (host-e2d4b7). The operator's 100 W ADMITS on all three read functions, each addressed by
// the GPU UUID the read returned -- 100 W is each card's OWN floor, which is where the hand-written boot script
// leaves them, and the same operator decision admits three cards without clamping. Admitting the cap does NOT
// promote the timescale: the decision stays CappedQuantityUnstated, the arm for a number said without one. The
// three REDS are at the read's own numbers: 151 W refuses carrying the 150 W ceiling it missed, 99 W refuses
// carrying the 100 W floor, and a function whose UUID was never read keeps the same in-range cap pending rather
// than admitting it -- addressability is a separate fact from enumeration.
test fn ken_admits_the_operators_100w_on_each_read_function_and_keeps_the_timescale_unstated() -> Bool {
  let admissions = gpu_cap_admissions_on(host: operator_host_e2d4b7)
  admissions.length() == 3
    && any(admissions, a => match a {
      GpuCapAdmitted { host: _, board: b, gpu_uuid: u, cap: c } =>
        (b as String) == (gpu_board_11 as String) && (u as String) == "GPU-c4177907-3dc8-12be-4146-431ea120f818" && watt_count(w: c) == 100
      _ => false
    })
    && any(admissions, a => match a {
      GpuCapAdmitted { host: _, board: b, gpu_uuid: u, cap: c } =>
        (b as String) == (gpu_board_12 as String) && (u as String) == "GPU-8327ce9a-6011-f8cf-0012-4af9596c3124" && watt_count(w: c) == 100
      _ => false
    })
    && any(admissions, a => match a {
      GpuCapAdmitted { host: _, board: b, gpu_uuid: u, cap: c } =>
        (b as String) == (gpu_board_13 as String) && (u as String) == "GPU-a56f81eb-df65-ec75-e5ee-06c01ce8509e" && watt_count(w: c) == 100
      _ => false
    })
    && match gpu_power_cap_bounds(s: ken_t10_cap_decision) { SustainedPowerDraw => false  CappedQuantityUnstated => true }
    && match admit_gpu_cap_against(intent: ken_intent_at(board: gpu_board_11, w: 151), observation: ken_function_at(board: gpu_board_11, uuid: Present { value: "GPU-c4177907-3dc8-12be-4146-431ea120f818" as NonEmptyStr })) {
      GpuCapOutsideDeviceRange { board: _, cap: c, minimum: lo, maximum: hi } => watt_count(w: c) == 151 && watt_count(w: lo) == 100 && watt_count(w: hi) == 150
      _ => false
    }
    && match admit_gpu_cap_against(intent: ken_intent_at(board: gpu_board_12, w: 99), observation: ken_function_at(board: gpu_board_12, uuid: Present { value: "GPU-8327ce9a-6011-f8cf-0012-4af9596c3124" as NonEmptyStr })) {
      GpuCapOutsideDeviceRange { board: _, cap: c, minimum: lo, maximum: hi } => watt_count(w: c) == 99 && watt_count(w: lo) == 100 && watt_count(w: hi) == 150
      _ => false
    }
    && match admit_gpu_cap_against(intent: ken_intent_at(board: gpu_board_13, w: 100), observation: ken_function_at(board: gpu_board_13, uuid: Absent)) {
      GpuCapDevicePending { board: b, cap: c, read_obligation: o } =>
        (b as String) == (gpu_board_13 as String) && watt_count(w: c) == 100 && contains(o as String, "UUID")
      _ => false
    }
}

// srv4'S ADAS: THE OPERATOR'S NUMBER, ON RECORD, AND STILL WAITING ON ITS DEVICES. The decision arrived on
// the host as a hand-edited unit long before it arrived here, so this claim is the one that says both halves
// are true at once: the operator's 30 W is the model's decision, and it does not admit, because the 2026-11-07
// survey never read the cards' GPU UUIDs and a cap is addressed by UUID. A change that "fixed" the pending
// state by minting a UUID nobody read would fail this. The bounds arm is the other half of the standing: the
// operator gave a number and a purpose and no timescale, so nothing here may call it sustained.
test fn srv4s_adas_carry_the_operators_30w_and_stay_pending_on_their_uuids() -> Bool {
  let admissions = gpu_cap_admissions_on(host: operator_host_srv4)
  let decision_is_operators = match srv4_rtx_2000_ada_cap_decision {
    OperatorDeclaredCap { cap: c, bounds: CappedQuantityUnstated, decided_on: d, said: words } =>
      watt_count(w: c) == 30
        && (d as String) == "2026-11-24"
        && contains(s: words as String, pattern: "surge-strip")
        && !contains(s: words as String, pattern: "sustained cap")
    OperatorDeclaredCap { cap: _, bounds: SustainedPowerDraw, decided_on: _, said: _ } => false
  }
  admissions.length() == 2
    && admissions.all(a => match a {
        GpuCapDevicePending { board: b, cap: c, read_obligation: _ } =>
          watt_count(w: c) == 30
            && ((b as String) == (gpu_board_05 as String) || (b as String) == (gpu_board_06 as String))
        GpuCapAdmitted { host: _, board: _, gpu_uuid: _, cap: _ } => false
        GpuCapOutsideDeviceRange { board: _, cap: _, minimum: _, maximum: _ } => false
      })
    && decision_is_operators
}

// A CAP'S PRICE IS ONLY EVIDENCE IF IT STATES THE CONFIGURATION IT WAS READ IN. srv4's four windows differ in
// both ceilings (card watts and CPU MHz), and two of them differ in the CPU ceiling alone -- 26.5 tok/s at
// 30 W / 2.0 GHz against 24.1 at 30 W / 3.0 GHz -- which is precisely the pair that lets the pass say the drop
// came from the card cap and not from the CPU cap. A row missing either ceiling, or its instrument, cannot
// support that sentence, so this claim requires both on every row.
test fn every_cap_price_row_states_its_two_ceilings_and_its_instrument() -> Bool {
  every_measured_cap_price_states_its_configuration()
    && srv4_rtx_2000_ada_measured_prices.length() == 4
    && srv4_rtx_2000_ada_measured_prices.all(p =>
      string_contains(s: p.instrument as String, pattern: "done: N tokens in T s"))
    && srv4_rtx_2000_ada_measured_prices.any(p =>
      watt_count(w: p.card_power_limit) == 30 && p.cpu_ceiling_mhz == 2000)
    && srv4_rtx_2000_ada_measured_prices.any(p =>
      watt_count(w: p.card_power_limit) == 30 && p.cpu_ceiling_mhz == 3000)
}
