module test.claim.serving.rented_ninfer_source_witness

import std.types { String, Bool }
import std.measure { byte_size, byte_size_count }
import std.content_hash { Sha256Digest }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import extdeps.ninfer.qwen3_8_27b_nvfp4 { qwen3_8_27b_nvfp4_row }
import gunbc.cloudflare.r2_origin { OriginCredentialMintEntryUnbuilt }
import gunbc.serving.rented_ninfer_source {
  ninfer_serve_81c8ce09_sm120_release, rented_engine_source, rented_ninfer_81c8ce09_sm120_engine_artifact, RentedTarballUnobserved, rented_weights_source, rented_qwen3_8_27b_nvfp4_weights_placement, rented_weights_pin_agreement, rented_artifact_url,
  RentedWeightsPinAgrees, RentedWeightsDigestDiffers, RentedWeightsBytesDiffer,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE REAL ROWS, against the values read from the live card on 2026-10-15.
test fn the_engine_binary_pin_equals_the_measured_install() -> Bool {
  let r = ninfer_serve_81c8ce09_sm120_release
  byte_size_count(b: r.binary.bytes) == 238462696
    && (r.binary.sha256.hex as String) == "4d6b4b5ce8e4f667ffc77a7362817e713ded23946ea996529429202e9c46261b"
}

test fn the_rev_file_pin_equals_the_measured_install_and_the_source_revision() -> Bool {
  let r = ninfer_serve_81c8ce09_sm120_release
  byte_size_count(b: r.rev_file.bytes) == 41
    && (r.rev_file.sha256.hex as String) == "e9ae34b6ca7a2496dfb45d54d2f4bf8517424a872fa2610dee3108ebdb9940dd"
    && (r.source.full_revision as String) == "81c8ce093b2c1646a87566a8e59d807fcf0ec95c"
}

test fn the_release_and_object_names_are_the_observed_ones() -> Bool {
  let r = ninfer_serve_81c8ce09_sm120_release
  (r.release_name as String) == "ninfer-serve-81c8ce09-sm120"
    && r.build_target.major == 12 && r.build_target.minor == 0
}

test fn the_tarball_is_unobserved() -> Bool {
  match rented_ninfer_81c8ce09_sm120_engine_artifact.tarball {
    RentedTarballUnobserved { read_obligation: _ } => true
  }
}

test fn the_engine_and_weights_resolve_to_the_models_bucket_endpoint_and_keys() -> Bool {
  rented_artifact_url(source: rented_engine_source(artifact: rented_ninfer_81c8ce09_sm120_engine_artifact))
      == "https://5f71db675ad3e94c16a3d5c159d16298.r2.cloudflarestorage.com/models/bin/ninfer-serve-81c8ce09-sm120.tgz"
    && rented_artifact_url(source: rented_weights_source(placement: rented_qwen3_8_27b_nvfp4_weights_placement))
      == "https://5f71db675ad3e94c16a3d5c159d16298.r2.cloudflarestorage.com/models/ninfer/qwen3_8_27b_nvfp4/qwen3_8_27b_nvfp4.ninfer"
}

test fn the_read_credential_is_a_custody_binding_with_no_mint_entry() -> Bool {
  match rented_engine_source(artifact: rented_ninfer_81c8ce09_sm120_engine_artifact).read_credential {
    OriginCredentialMintEntryUnbuilt { secret_id: s } => (s as String) == "cloudflare-r2-models-read-token"
    _ => false
  }
}

test fn the_weights_row_equals_the_measured_artifact() -> Bool {
  byte_size_count(b: qwen3_8_27b_nvfp4_row.container_bytes) == 23719715844
    && (qwen3_8_27b_nvfp4_row.container_sha256.hex as String) == "74d2c57145e6ff11d1d2faa79594477f9bc903a611af1fb20218189fbbb77d82"
}

test fn the_measured_weights_agree_with_the_model_row() -> Bool {
  match rented_weights_pin_agreement(row: qwen3_8_27b_nvfp4_row, claimed_bytes: byte_size(count: 23719715844), claimed_sha256: Sha256Digest { hex: "74d2c57145e6ff11d1d2faa79594477f9bc903a611af1fb20218189fbbb77d82" }) {
    RentedWeightsPinAgrees => true
    _ => false
  }
}

// RED: a weights digest that differs from the model row's is refused, and so is a differing size.
test fn a_weights_digest_differing_from_the_model_row_is_refused() -> Bool {
  match rented_weights_pin_agreement(row: qwen3_8_27b_nvfp4_row, claimed_bytes: byte_size(count: 23719715844), claimed_sha256: Sha256Digest { hex: "74d2c57145e6ff11d1d2faa79594477f9bc903a611af1fb20218189fbbb77d83" }) {
    RentedWeightsDigestDiffers { pinned: _, claimed: _ } => true
    _ => false
  }
}

test fn a_weights_size_differing_from_the_model_row_is_refused() -> Bool {
  match rented_weights_pin_agreement(row: qwen3_8_27b_nvfp4_row, claimed_bytes: byte_size(count: 23719715843), claimed_sha256: Sha256Digest { hex: "74d2c57145e6ff11d1d2faa79594477f9bc903a611af1fb20218189fbbb77d82" }) {
    RentedWeightsBytesDiffer { pinned: _, claimed: _ } => true
    _ => false
  }
}
