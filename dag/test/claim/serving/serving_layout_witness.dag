module test.claim.serving.serving_layout_witness

import std.types { String, NonEmptyStr, Bool, List }
import std.nat { Nat }
import std.optional { Present, Absent }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.decl_ref { decl_ref }
import std.measure { ByteSize, byte_size, byte_size_count, token_count, mebibyte, mebibyte_to_byte_size, gibibyte, gibibyte_to_byte_size }
import gunbc.host.host_memory_observation { HostUsableRamMeasured }
import gunbc.serving.serving_host_memory {
  ServingMemoryReading, ServingMemoryRead, ServingMemoryFits, conversation_snapshot_bytes,
}
import gunbc.serving.serving_layout {
  ServingResourceGrant, ServingDevice, ServingDeviceGroup, ServingBackendProfile, ServingRequirement, ServingReplicaConfig,
  ServingLayoutResult, ServingLayoutConfigured, ServingLayoutRefused, ServingLayoutRefusal,
  ServingLayoutRamShort, ServingLayoutDeviceTooSmall, ServingLayoutBackendCannotRetain, ServingLayoutUnknownDevice,
  ServingLayoutDeviceInTwoGroups, ServingLayoutContextAboveBackend,
  ServingBackendSupportsTopology, ServingLiveQualified, ServingLiveUnqualified,
  ServingLiveStandingUnqualified, ServingLiveStandingQualified, ServingLiveRequalificationRequired,
  ServingAdmitted, ServingAdmissionRefused, ServingAdmission,
  serving_layout_derive, serving_layout_with_qualification, serving_configuration_identity, serving_replica_admit,
  host_6ce85c_grant, host_6ce85c_independent_groups, strata_iq3_s_a16_profile, serving_context_ceiling_requirement, host_6ce85c_layout,
  srv4_grant, srv4_layer_split_groups, strata_srv4_layer_split_profile, srv4_layout,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn sl_gib(n: Nat) -> ByteSize {
  gibibyte_to_byte_size(g: gibibyte(count: n))
}

fn sl_grant_with(g: ServingResourceGrant, ram: ByteSize, devices: List<ServingDevice>) -> ServingResourceGrant {
  ServingResourceGrant {
    host: g.host,
    usable_ram: HostUsableRamMeasured { bytes: ram, provenance: "witness fixture" as NonEmptyStr },
    overhead: g.overhead, shared: g.shared, swap_bound: g.swap_bound, devices: devices, charging: g.charging,
  }
}

fn sl_device(name: String, vram: ByteSize) -> ServingDevice {
  ServingDevice {
    device: name as NonEmptyStr,
    board: decl_ref(module_path: "extdeps.gpu.nvidia", decl_name: "nvidia_rtx_pro_6000_workstation_board_catalog"),
    vram: ServingMemoryRead { bytes: vram, provenance: "witness fixture" as NonEmptyStr },
  }
}

fn sl_profile_with(b: ServingBackendProfile, most: Nat, floor: ServingMemoryReading) -> ServingBackendProfile {
  ServingBackendProfile {
    backend: b.backend, device_fixed_vram: b.device_fixed_vram, device_min_elastic_vram: b.device_min_elastic_vram,
    replica_base_ram: b.replica_base_ram, active_slots: b.active_slots, active_slot_ram: b.active_slot_ram,
    retention: b.retention, park_free_floor: floor, max_devices_with_retention: most, max_context: b.max_context,
  }
}

fn sl_profile_retaining_across(b: ServingBackendProfile, most: Nat) -> ServingBackendProfile {
  sl_profile_with(b: b, most: most, floor: b.park_free_floor)
}

fn sl_replicas(r: ServingLayoutResult) -> List<ServingReplicaConfig> {
  match r {
    ServingLayoutConfigured { replicas: rs, unallocated_ram: _, evidence: _ } => rs
    ServingLayoutRefused { refusal: _ } => [] as List<ServingReplicaConfig>
  }
}

fn sl_admitted_total(r: ServingLayoutResult) -> Nat {
  fold(sl_replicas(r: r), init: 0, f: (acc, c) => acc + c.admitted_conversations)
}

fn sl_refusal(r: ServingLayoutResult) -> ServingLayoutRefusal? {
  match r {
    ServingLayoutRefused { refusal: f } => Present { value: f }
    ServingLayoutConfigured { replicas: _, unallocated_ram: _, evidence: _ } => Absent
  }
}

// EVERY ADMITTED CONVERSATION CAN GROW TO THE CEILING, AND THE ENGINE WILL STILL PARK IT: each replica's
// retention budget holds its admitted count of maximum-context snapshots, and its cap holds that budget plus
// the park headroom the engine demands inside its own cgroup.
fn sl_all_grow_to_ceiling_under(r: ServingLayoutResult, b: ServingBackendProfile) -> Bool {
  let snapshot = byte_size_count(b: conversation_snapshot_bytes(cost: b.retention, context: serving_context_ceiling_requirement.max_context))
  let floor = match b.park_free_floor { ServingMemoryRead { bytes: f, provenance: _ } => byte_size_count(b: f)  _ => 0 }
  sl_replicas(r: r).all(c => c.admitted_conversations * snapshot <= byte_size_count(b: c.retention_budget)
    && byte_size_count(b: c.retention_budget) + floor < byte_size_count(b: c.memory_max))
}

fn sl_all_grow_to_ceiling(r: ServingLayoutResult) -> Bool {
  sl_all_grow_to_ceiling_under(r: r, b: strata_iq3_s_a16_profile)
}

// h11 AS GRANTED: six independent replicas, seven conversations guaranteed to the ceiling (2,1,1,1,1,1), the
// budget verdict Fits with its five assumptions named (three allowances, the extrapolated ceiling snapshot, the page charging), the backend supports the topology, and nothing is
// qualified live yet.
test fn witness_h11_layout_is_derived_and_fits_under_named_assumptions() -> Bool {
  match host_6ce85c_layout {
    ServingLayoutConfigured { replicas: rs, unallocated_ram: _, evidence: e } =>
      rs.length() == 6
        && rs.all(c => c.admitted_conversations >= 1 && c.active_slots == 1)
        && sl_admitted_total(r: host_6ce85c_layout) == 7
        && (match e.budget { ServingMemoryFits { spare: _ } => true  _ => false })
        && e.assumptions.length() == 5
        && (match e.backend { ServingBackendSupportsTopology => true  _ => false })
        && (match e.live { ServingLiveStandingUnqualified { obligation: _ } => true  _ => false })
        && sl_all_grow_to_ceiling(r: host_6ce85c_layout)
    _ => false
  }
}

// SMALLER AND LARGER GRANTS: 80 GiB cannot give six replicas one ceiling conversation each and refuses; 125 GiB
// (all eight DIMMs) admits more than today's 110.
test fn witness_grant_size_moves_admission_and_refuses_when_short() -> Bool {
  let small = serving_layout_derive(g: sl_grant_with(g: host_6ce85c_grant, ram: sl_gib(n: 80), devices: host_6ce85c_grant.devices), groups: host_6ce85c_independent_groups, b: strata_iq3_s_a16_profile, r: serving_context_ceiling_requirement)
  let large = serving_layout_derive(g: sl_grant_with(g: host_6ce85c_grant, ram: sl_gib(n: 125), devices: host_6ce85c_grant.devices), groups: host_6ce85c_independent_groups, b: strata_iq3_s_a16_profile, r: serving_context_ceiling_requirement)
  (match sl_refusal(r: small) { Present { value: ServingLayoutRamShort { needed: _, available: _ } } => true  _ => false })
    && sl_admitted_total(r: large) > sl_admitted_total(r: host_6ce85c_layout)
    && sl_all_grow_to_ceiling(r: large)
}

// HETEROGENEOUS DEVICES: an A16 GPU and a 96 GiB card as independent groups each get a replica; a 6 GiB
// device cannot hold the fixed VRAM plus the least expert cache and refuses, naming itself.
test fn witness_heterogeneous_devices_and_a_device_too_small() -> Bool {
  let a16 = sl_device(name: "a16-85", vram: mebibyte_to_byte_size(m: mebibyte(count: 15356)))
  let big = sl_device(name: "pro6000-0", vram: mebibyte_to_byte_size(m: mebibyte(count: 97887)))
  let tiny = sl_device(name: "tiny-0", vram: sl_gib(n: 6))
  let mixed = serving_layout_derive(g: sl_grant_with(g: host_6ce85c_grant, ram: sl_gib(n: 110), devices: [a16, big]),
    groups: [ServingDeviceGroup { name: "g-a16" as NonEmptyStr, devices: ["a16-85"] }, ServingDeviceGroup { name: "g-pro" as NonEmptyStr, devices: ["pro6000-0"] }],
    b: strata_iq3_s_a16_profile, r: serving_context_ceiling_requirement)
  let small = serving_layout_derive(g: sl_grant_with(g: host_6ce85c_grant, ram: sl_gib(n: 110), devices: [a16, tiny]),
    groups: [ServingDeviceGroup { name: "g-a16" as NonEmptyStr, devices: ["a16-85"] }, ServingDeviceGroup { name: "g-tiny" as NonEmptyStr, devices: ["tiny-0"] }],
    b: strata_iq3_s_a16_profile, r: serving_context_ceiling_requirement)
  sl_replicas(r: mixed).length() == 2
    && (match sl_refusal(r: small) { Present { value: ServingLayoutDeviceTooSmall { device: d, needed: _, has: _ } } => d == "tiny-0"  _ => false })
}

// A TWO-DEVICE GROUP IS REPRESENTED: Strata cannot retain across two devices and refuses that group by name;
// a backend that can retain across two runs it as one replica holding both devices.
test fn witness_two_device_group_is_modeled_and_backend_decides() -> Bool {
  let pair = [ServingDeviceGroup { name: "pair" as NonEmptyStr, devices: ["a16-85", "a16-87"] }]
  let strata = serving_layout_derive(g: host_6ce85c_grant, groups: pair, b: strata_iq3_s_a16_profile, r: serving_context_ceiling_requirement)
  let spanning = serving_layout_derive(g: host_6ce85c_grant, groups: pair, b: sl_profile_retaining_across(b: strata_iq3_s_a16_profile, most: 2), r: serving_context_ceiling_requirement)
  (match sl_refusal(r: strata) { Present { value: ServingLayoutBackendCannotRetain { group: gr, devices: n, most: m } } => gr == "pair" && n == 2 && m == 1  _ => false })
    && sl_replicas(r: spanning).length() == 1
    && sl_replicas(r: spanning).all(c => c.devices.length() == 2)
}

// THE TOPOLOGY MUST PARTITION GRANTED DEVICES, AND THE REQUIREMENT MAY NOT EXCEED THE BACKEND'S CEILING.
test fn witness_topology_and_ceiling_faults_refuse() -> Bool {
  let unknown = serving_layout_derive(g: host_6ce85c_grant, groups: [ServingDeviceGroup { name: "x" as NonEmptyStr, devices: ["a16-86"] }], b: strata_iq3_s_a16_profile, r: serving_context_ceiling_requirement)
  let twice = serving_layout_derive(g: host_6ce85c_grant, groups: [ServingDeviceGroup { name: "x" as NonEmptyStr, devices: ["a16-85"] }, ServingDeviceGroup { name: "y" as NonEmptyStr, devices: ["a16-85"] }], b: strata_iq3_s_a16_profile, r: serving_context_ceiling_requirement)
  let over = serving_layout_derive(g: host_6ce85c_grant, groups: host_6ce85c_independent_groups, b: strata_iq3_s_a16_profile, r: ServingRequirement { max_context: token_count(count: 300000), min_retained_per_replica: 1 })
  (match sl_refusal(r: unknown) { Present { value: ServingLayoutUnknownDevice { group: _, device: d } } => d == "a16-86"  _ => false })
    && (match sl_refusal(r: twice) { Present { value: ServingLayoutDeviceInTwoGroups { device: d } } => d == "a16-85"  _ => false })
    && (match sl_refusal(r: over) { Present { value: ServingLayoutContextAboveBackend { required: _, backend: _ } } => true  _ => false })
}

fn sl_admit_until_full(c: ServingReplicaConfig, admitted: Nat, steps: Nat) -> Nat {
  if steps == 0 { admitted } else {
    match serving_replica_admit(c: c, admitted: admitted) {
      ServingAdmitted { now_admitted: n } => sl_admit_until_full(c: c, admitted: n, steps: steps - 1)
      ServingAdmissionRefused { admitted: a, capacity: _ } => a
    }
  }
}

// ADMISSION TO THE CEILING AND ONE MORE: a replica admits exactly its capacity; the next admission is refused
// and the admitted count is what it was, so no existing conversation is displaced.
test fn witness_one_more_admission_is_refused_without_eviction() -> Bool {
  sl_replicas(r: host_6ce85c_layout).all(c =>
    sl_admit_until_full(c: c, admitted: 0, steps: 10) == c.admitted_conversations
      && (match serving_replica_admit(c: c, admitted: c.admitted_conversations) {
        ServingAdmissionRefused { admitted: a, capacity: k } => a == c.admitted_conversations && k == c.admitted_conversations
        ServingAdmitted { now_admitted: _ } => false
      }))
}

// A CHANGED DIMENSION REQUIRES REQUALIFICATION: a receipt bound to today's configuration qualifies it, and
// the same receipt read against the configuration a larger grant derives is not carried forward.
test fn witness_changed_grant_requires_requalification() -> Bool {
  let today = sl_replicas(r: host_6ce85c_layout)
  let receipt = ServingLiveQualified { receipt: "witness receipt" as NonEmptyStr, configuration: serving_configuration_identity(replicas: today) }
  let same = serving_layout_with_qualification(result: serving_layout_derive(g: host_6ce85c_grant, groups: host_6ce85c_independent_groups, b: strata_iq3_s_a16_profile, r: serving_context_ceiling_requirement), q: receipt)
  let grown = serving_layout_with_qualification(result: serving_layout_derive(g: sl_grant_with(g: host_6ce85c_grant, ram: sl_gib(n: 125), devices: host_6ce85c_grant.devices), groups: host_6ce85c_independent_groups, b: strata_iq3_s_a16_profile, r: serving_context_ceiling_requirement), q: receipt)
  (match same { ServingLayoutConfigured { replicas: _, unallocated_ram: _, evidence: e } => match e.live { ServingLiveStandingQualified { receipt: _ } => true  _ => false }  _ => false })
    && (match grown { ServingLayoutConfigured { replicas: _, unallocated_ram: _, evidence: e } => match e.live { ServingLiveRequalificationRequired { qualified: _, derived: _ } => true  _ => false }  _ => false })
}

// THE PARK HEADROOM IS PART OF THE CAP: the same h11 grant with the engine's 512 MiB park floor read as zero
// admits more conversations than with it, so a layout that omitted the floor would promise retention the
// engine then refuses to park.
test fn witness_park_floor_is_charged_to_each_replica() -> Bool {
  let unfloored = serving_layout_derive(g: host_6ce85c_grant, groups: host_6ce85c_independent_groups,
    b: sl_profile_with(b: strata_iq3_s_a16_profile, most: 1, floor: ServingMemoryRead { bytes: byte_size(count: 0), provenance: "witness: no floor" as NonEmptyStr }),
    r: serving_context_ceiling_requirement)
  sl_admitted_total(r: unfloored) > sl_admitted_total(r: host_6ce85c_layout)
}

// srv4 AS GRANTED: one replica holding both GPUs, thirteen maximum-context conversations inside the slice's
// 96 GiB throttle point, the budget Fits, and nothing qualified live yet. The same two-device group under h11's
// release, which cannot park across a split, refuses by name: spanning two GPUs is a backend fact, not a
// topology the layout grants on its own.
test fn witness_srv4_is_one_replica_across_two_gpus() -> Bool {
  let old_release = serving_layout_derive(g: srv4_grant, groups: srv4_layer_split_groups,
    b: sl_profile_retaining_across(b: strata_srv4_layer_split_profile, most: 1), r: serving_context_ceiling_requirement)
  (match srv4_layout {
    ServingLayoutConfigured { replicas: rs, unallocated_ram: _, evidence: e } =>
      rs.length() == 1
        && rs.all(c => c.devices.length() == 2 && c.admitted_conversations == 13 && byte_size_count(b: c.memory_max) <= byte_size_count(b: sl_gib(n: 96)))
        && (match e.budget { ServingMemoryFits { spare: _ } => true  _ => false })
        && (match e.live { ServingLiveStandingUnqualified { obligation: _ } => true  _ => false })
        && sl_all_grow_to_ceiling_under(r: srv4_layout, b: strata_srv4_layer_split_profile)
    _ => false
  })
    && (match sl_refusal(r: old_release) { Present { value: ServingLayoutBackendCannotRetain { group: gr, devices: n, most: m } } => gr == "gunbc-srv4-daily-engine" && n == 2 && m == 1  _ => false })
}
