data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn sl_gib(n: Nat) -> ByteSize {
  gibibyte_to_byte_size(g: gibibyte(count: n))
}

fn sl_grant_with(g: ServingResourceGrant, ram: ByteSize, devices: List<ServingDevice>) -> ServingResourceGrant {
  ServingResourceGrant {
    host: g.host,
    usable_ram: HostUsableRamMeasured { bytes: ram, provenance: "witness fixture" as NonEmptyStr },
    overhead: g.overhead, shared: g.shared, swap_bound: g.swap_bound, devices: devices, charging: g.charging,
  }
}

// The same grant with its swap bound replaced, so a witness can hand the derivation an Unread bound and watch it refuse
// rather than silently bill the missing swap as zero (the fail_closed headroom the h11 review left open).
fn sl_grant_swap(g: ServingResourceGrant, swap: ServingMemoryReading) -> ServingResourceGrant {
  ServingResourceGrant {
    host: g.host,
    usable_ram: g.usable_ram,
    overhead: g.overhead, shared: g.shared, swap_bound: swap, devices: g.devices, charging: g.charging,
  }
}

// A grant whose shared artifacts are replaced -- so a test can hand the layout an artifact whose CHARGED host-RAM
// reading is unread and check the layout refuses rather than billing it as zero (review 92474).
fn sl_grant_shared(g: ServingResourceGrant, shared: List<ServingSharedArtifact>) -> ServingResourceGrant {
  ServingResourceGrant {
    host: g.host, usable_ram: g.usable_ram, overhead: g.overhead, shared: shared, swap_bound: g.swap_bound, devices: g.devices, charging: g.charging,
  }
}

// An artifact whose host-RAM rung is evictable with an UNREAD OCCUPANCY -- the figure
// serving_artifact_host_ram_charge now bills into the pool (what the tier occupies inside the shared cgroup).
// Copying everything else keeps it a minimal single-variable change.
fn sl_host_ram_occupancy_unread(a: ServingSharedArtifact) -> ServingSharedArtifact {
  ServingSharedArtifact {
    name: a.name, bytes: a.bytes, owner: a.owner, device: a.device, disk: a.disk,
    host_ram: match a.host_ram {
      Present { value: r } => Present { value: ServingArtifactRung { bytes: r.bytes, holds: match r.holds {
        ArtifactHeldEvictable { bound_by: bound_by, floor: f, occupies: _ } => ArtifactHeldEvictable { bound_by: bound_by, floor: f, occupies: ServingMemoryUnread { reason: "fixture: what this tier occupies inside the shared cgroup has not been read" as NonEmptyStr } }
        ArtifactHeldPinned { mechanism: _ } => r.holds
      }, realizes: r.realizes } }
      Absent => Absent
    },
  }
}

// The other single-variable change on the same hold: an evictable rung whose FLOOR is unread. The floor is NOT
// billed any more (the occupancy is), so this must still CONFIGURE -- the pair with the fixture above is what shows
// the charge really moved off the floor and did not merely gain a neighbour.
fn sl_host_ram_floor_unread(a: ServingSharedArtifact) -> ServingSharedArtifact {
  ServingSharedArtifact {
    name: a.name, bytes: a.bytes, owner: a.owner, device: a.device, disk: a.disk,
    host_ram: match a.host_ram {
      Present { value: r } => Present { value: ServingArtifactRung { bytes: r.bytes, holds: match r.holds {
        ArtifactHeldEvictable { bound_by: bound_by, floor: _, occupies: o } => ArtifactHeldEvictable { bound_by: bound_by, floor: ServingMemoryUnread { reason: "fixture: the floor the tier cannot give back has not been read" as NonEmptyStr }, occupies: o }
        ArtifactHeldPinned { mechanism: _ } => r.holds
      }, realizes: r.realizes } }
      Absent => Absent
    },
  }
}

// An artifact whose host-RAM rung is PINNED with UNREAD bytes -- the other charged reading (a pinned rung bills its
// whole figure). Same single-variable discipline.
fn sl_host_ram_pinned_bytes_unread(a: ServingSharedArtifact) -> ServingSharedArtifact {
  ServingSharedArtifact {
    name: a.name, bytes: a.bytes, owner: a.owner, device: a.device, disk: a.disk,
    host_ram: match a.host_ram {
      Present { value: r } => Present { value: ServingArtifactRung { bytes: ServingMemoryUnread { reason: "the pinned host-RAM copy has not been read" as NonEmptyStr }, holds: ArtifactHeldPinned { mechanism: "fixture: pinned host-RAM rung" as NonEmptyStr }, realizes: r.realizes } }
      Absent => Absent
    },
  }
}

// An evictable host-RAM rung stating a GIVEN floor and occupancy -- the third single-variable change on the same
// hold. It lets a witness put the two figures in any relation: the RED sets the occupancy BELOW the floor, which
// no tier can both mean and pay for (ServingArtifactHoldBelowFloor), and the control sets them EQUAL, which must
// still configure -- the pair is what shows the gate fires on the contradiction and not on a mere equality.
fn sl_host_ram_hold(a: ServingSharedArtifact, fl: ServingMemoryReading, oc: ServingMemoryReading) -> ServingSharedArtifact {
  ServingSharedArtifact {
    name: a.name, bytes: a.bytes, owner: a.owner, device: a.device, disk: a.disk,
    host_ram: match a.host_ram {
      Present { value: r } => Present { value: ServingArtifactRung { bytes: r.bytes, holds: match r.holds {
        ArtifactHeldEvictable { bound_by: bound_by, floor: _, occupies: _ } => ArtifactHeldEvictable { bound_by: bound_by, floor: fl, occupies: oc }
        ArtifactHeldPinned { mechanism: _ } => r.holds
      }, realizes: r.realizes } }
      Absent => Absent
    },
  }
}

fn sl_device(name: String, vram: ByteSize) -> ServingDevice {
  ServingDevice {
    device: name as NonEmptyStr,
    board: decl_ref(module_path: "extdeps.gpu.nvidia", decl_name: "nvidia_rtx_pro_6000_workstation_board_catalog"),
    vram: ServingMemoryRead { bytes: vram, provenance: "witness fixture" as NonEmptyStr },
  }
}

fn sl_profile_with(b: ServingBackendProfile, most: Nat, floor: ServingMemoryReading) -> ServingBackendProfile {
  ServingBackendProfile {
    backend: b.backend, device_fixed_vram: b.device_fixed_vram, device_min_elastic_vram: b.device_min_elastic_vram,
    replica_base_ram: b.replica_base_ram, active_slots: b.active_slots, active_slot_ram: b.active_slot_ram,
    retention: b.retention, park_free_floor: floor, max_devices_with_retention: most, max_context: b.max_context,
  }
}

fn sl_profile_retaining_across(b: ServingBackendProfile, most: Nat) -> ServingBackendProfile {
  sl_profile_with(b: b, most: most, floor: b.park_free_floor)
}

// What a grant says the host may count on, whatever its epistemic arm. Unmeasured is zero, so a grant that lost its
// cap cannot satisfy the witness below by agreeing with an unread memory row.
fn sl_grant_ram(g: ServingResourceGrant) -> Nat {
  match g.usable_ram {
    HostUsableRamMeasured { bytes: b, provenance: _ } => byte_size_count(b: b)
    HostUsableRamConservativeLowerBound { bytes: b, basis: _ } => byte_size_count(b: b)
    HostUsableRamUnmeasured { reason: _ } => 0
  }
}

fn sl_replicas(r: ServingLayoutResult) -> List<ServingReplicaConfig> {
  match r {
    ServingLayoutConfigured { replicas: rs, unallocated_ram: _, evidence: _ } => rs
    ServingLayoutRefused { refusal: _ } => [] as List<ServingReplicaConfig>
  }
}

fn sl_admitted_total(r: ServingLayoutResult) -> Nat {
  fold(sl_replicas(r: r), init: 0, f: (acc, c) => acc + c.admitted_conversations)
}

fn sl_cap_total(r: ServingLayoutResult) -> Nat {
  fold(sl_replicas(r: r), init: 0, f: (acc, c) => acc + byte_size_count(b: c.memory_max))
}

fn sl_configuration(r: ServingLayoutResult) -> String {
  match r {
    ServingLayoutConfigured { replicas: _, unallocated_ram: _, evidence: e } => e.configuration
    ServingLayoutRefused { refusal: _ } => ""
  }
}

fn sl_refusal(r: ServingLayoutResult) -> ServingLayoutRefusal? {
  match r {
    ServingLayoutRefused { refusal: f } => Present { value: f }
    ServingLayoutConfigured { replicas: _, unallocated_ram: _, evidence: _ } => Absent
  }
}

// EVERY ADMITTED CONVERSATION CAN GROW TO THE CEILING, AND THE ENGINE WILL STILL PARK IT: each replica's
// retention budget holds its admitted count of maximum-context snapshots, and its cap holds that budget plus
// the park headroom the engine demands inside its own cgroup.
fn sl_all_grow_to_ceiling_under(r: ServingLayoutResult, b: ServingBackendProfile) -> Bool {
  let snapshot = byte_size_count(b: conversation_snapshot_bytes(cost: b.retention, context: serving_context_ceiling_requirement.max_context))
  let floor = match b.park_free_floor { ServingMemoryRead { bytes: f, provenance: _ } => byte_size_count(b: f)  _ => 0 }
  sl_replicas(r: r).all(c => c.admitted_conversations * snapshot <= byte_size_count(b: c.retention_budget)
    && byte_size_count(b: c.retention_budget) + floor < byte_size_count(b: c.memory_max))
}

fn sl_all_grow_to_ceiling(r: ServingLayoutResult) -> Bool {
  sl_all_grow_to_ceiling_under(r: r, b: strata_iq3_s_a16_profile)
}

// h11 AS GRANTED (A-prime): four independent replicas, five conversations guaranteed to the ceiling (2,1,1,1), the
// budget verdict Fits with its SIX assumptions named -- three allowances, the extrapolated ceiling snapshot, the page
// charging, and now the engine swap bound (serving_engine_swap_bound), which is charged per replica and is Assumed, so
// it must be listed and not read as measured (review 92488). The backend supports the topology, and nothing is
// qualified live yet.
test fn witness_h11_layout_is_derived_and_fits_under_named_assumptions() -> Bool {
  match host_6ce85c_layout {
    ServingLayoutConfigured { replicas: rs, unallocated_ram: _, evidence: e } =>
      rs.length() == 4
        && rs.all(c => c.admitted_conversations >= 1 && c.active_slots == 1)
        && sl_admitted_total(r: host_6ce85c_layout) == 5
        && (match e.budget { ServingMemoryFits { spare: _ } => true  _ => false })
        && e.assumptions.length() == 6
        && (match e.backend { ServingBackendSupportsTopology => true  _ => false })
        && (match e.live { ServingLiveStandingUnqualified { obligation: _ } => true  _ => false })
        && sl_all_grow_to_ceiling(r: host_6ce85c_layout)
    _ => false
  }
}

// SMALLER AND LARGER GRANTS: 80 GiB cannot give six replicas one ceiling conversation each and refuses; 125 GiB
// (all eight DIMMs) admits more than today's 110.
test fn witness_grant_size_moves_admission_and_refuses_when_short() -> Bool {
  let small = serving_layout_derive(g: sl_grant_with(g: host_6ce85c_grant, ram: sl_gib(n: 80), devices: host_6ce85c_grant.devices), groups: host_6ce85c_independent_groups, b: strata_iq3_s_a16_profile, r: serving_context_ceiling_requirement)
  let large = serving_layout_derive(g: sl_grant_with(g: host_6ce85c_grant, ram: sl_gib(n: 125), devices: host_6ce85c_grant.devices), groups: host_6ce85c_independent_groups, b: strata_iq3_s_a16_profile, r: serving_context_ceiling_requirement)
  (match sl_refusal(r: small) { Present { value: ServingLayoutRamShort { needed: _, available: _, terms: _ } } => true  _ => false })
    && sl_admitted_total(r: large) > sl_admitted_total(r: host_6ce85c_layout)
    && sl_all_grow_to_ceiling(r: large)
}

// HETEROGENEOUS DEVICES: an A16 GPU and a 96 GiB card as independent groups each get a replica; a 6 GiB
// device cannot hold the fixed VRAM plus the least expert cache and refuses, naming itself.
test fn witness_heterogeneous_devices_and_a_device_too_small() -> Bool {
  let a16 = sl_device(name: "a16-85", vram: mebibyte_to_byte_size(m: mebibyte(count: 15356)))
  let big = sl_device(name: "pro6000-0", vram: mebibyte_to_byte_size(m: mebibyte(count: 97887)))
  let tiny = sl_device(name: "tiny-0", vram: sl_gib(n: 6))
  let mixed = serving_layout_derive(g: sl_grant_with(g: host_6ce85c_grant, ram: sl_gib(n: 110), devices: [a16, big]),
    groups: [ServingDeviceGroup { name: "g-a16" as NonEmptyStr, devices: ["a16-85"] }, ServingDeviceGroup { name: "g-pro" as NonEmptyStr, devices: ["pro6000-0"] }],
    b: strata_iq3_s_a16_profile, r: serving_context_ceiling_requirement)
  let small = serving_layout_derive(g: sl_grant_with(g: host_6ce85c_grant, ram: sl_gib(n: 110), devices: [a16, tiny]),
    groups: [ServingDeviceGroup { name: "g-a16" as NonEmptyStr, devices: ["a16-85"] }, ServingDeviceGroup { name: "g-tiny" as NonEmptyStr, devices: ["tiny-0"] }],
    b: strata_iq3_s_a16_profile, r: serving_context_ceiling_requirement)
  sl_replicas(r: mixed).length() == 2
    && (match sl_refusal(r: small) { Present { value: ServingLayoutDeviceTooSmall { device: d, needed: _, has: _ } } => d == "tiny-0"  _ => false })
}

// A TWO-DEVICE GROUP IS REPRESENTED: Strata cannot retain across two devices and refuses that group by name;
// a backend that can retain across two runs it as one replica holding both devices.
test fn witness_two_device_group_is_modeled_and_backend_decides() -> Bool {
  let pair = [ServingDeviceGroup { name: "pair" as NonEmptyStr, devices: ["a16-85", "a16-87"] }]
  let strata = serving_layout_derive(g: host_6ce85c_grant, groups: pair, b: strata_iq3_s_a16_profile, r: serving_context_ceiling_requirement)
  let spanning = serving_layout_derive(g: host_6ce85c_grant, groups: pair, b: sl_profile_retaining_across(b: strata_iq3_s_a16_profile, most: 2), r: serving_context_ceiling_requirement)
  (match sl_refusal(r: strata) { Present { value: ServingLayoutBackendCannotRetain { group: gr, devices: n, most: m } } => gr == "pair" && n == 2 && m == 1  _ => false })
    && sl_replicas(r: spanning).length() == 1
    && sl_replicas(r: spanning).all(c => c.devices.length() == 2)
}

// THE TOPOLOGY MUST PARTITION GRANTED DEVICES, AND THE REQUIREMENT MAY NOT EXCEED THE BACKEND'S CEILING.
test fn witness_topology_and_ceiling_faults_refuse() -> Bool {
  let unknown = serving_layout_derive(g: host_6ce85c_grant, groups: [ServingDeviceGroup { name: "x" as NonEmptyStr, devices: ["a16-86"] }], b: strata_iq3_s_a16_profile, r: serving_context_ceiling_requirement)
  let twice = serving_layout_derive(g: host_6ce85c_grant, groups: [ServingDeviceGroup { name: "x" as NonEmptyStr, devices: ["a16-85"] }, ServingDeviceGroup { name: "y" as NonEmptyStr, devices: ["a16-85"] }], b: strata_iq3_s_a16_profile, r: serving_context_ceiling_requirement)
  let over = serving_layout_derive(g: host_6ce85c_grant, groups: host_6ce85c_independent_groups, b: strata_iq3_s_a16_profile, r: ServingRequirement { max_context: token_count(count: 300000), min_retained_per_replica: 1 })
  (match sl_refusal(r: unknown) { Present { value: ServingLayoutUnknownDevice { group: _, device: d } } => d == "a16-86"  _ => false })
    && (match sl_refusal(r: twice) { Present { value: ServingLayoutDeviceInTwoGroups { device: d } } => d == "a16-85"  _ => false })
    && (match sl_refusal(r: over) { Present { value: ServingLayoutContextAboveBackend { required: _, backend: _ } } => true  _ => false })
}

fn sl_admit_until_full(c: ServingReplicaConfig, admitted: Nat, steps: Nat) -> Nat {
  if steps == 0 { admitted } else {
    match serving_replica_admit(c: c, admitted: admitted) {
      ServingAdmitted { now_admitted: n } => sl_admit_until_full(c: c, admitted: n, steps: steps - 1)
      ServingAdmissionRefused { admitted: a, capacity: _ } => a
    }
  }
}

// ADMISSION TO THE CEILING AND ONE MORE: a replica admits exactly its capacity; the next admission is refused
// and the admitted count is what it was, so no existing conversation is displaced.
test fn witness_one_more_admission_is_refused_without_eviction() -> Bool {
  sl_replicas(r: host_6ce85c_layout).all(c =>
    sl_admit_until_full(c: c, admitted: 0, steps: 10) == c.admitted_conversations
      && (match serving_replica_admit(c: c, admitted: c.admitted_conversations) {
        ServingAdmissionRefused { admitted: a, capacity: k } => a == c.admitted_conversations && k == c.admitted_conversations
        ServingAdmitted { now_admitted: _ } => false
      }))
}

// A CHANGED DIMENSION REQUIRES REQUALIFICATION: a receipt bound to today's configuration qualifies it, and
// the same receipt read against the configuration a larger grant derives is not carried forward.
test fn witness_changed_grant_requires_requalification() -> Bool {
  let receipt = ServingLiveQualified { receipt: "witness receipt" as NonEmptyStr, configuration: sl_configuration(r: host_6ce85c_layout) }
  let same = serving_layout_with_qualification(result: serving_layout_derive(g: host_6ce85c_grant, groups: host_6ce85c_independent_groups, b: strata_iq3_s_a16_profile, r: serving_context_ceiling_requirement), q: receipt)
  let grown = serving_layout_with_qualification(result: serving_layout_derive(g: sl_grant_with(g: host_6ce85c_grant, ram: sl_gib(n: 125), devices: host_6ce85c_grant.devices), groups: host_6ce85c_independent_groups, b: strata_iq3_s_a16_profile, r: serving_context_ceiling_requirement), q: receipt)
  (match same { ServingLayoutConfigured { replicas: _, unallocated_ram: _, evidence: e } => match e.live { ServingLiveStandingQualified { receipt: _ } => true  _ => false }  _ => false })
    && (match grown { ServingLayoutConfigured { replicas: _, unallocated_ram: _, evidence: e } => match e.live { ServingLiveRequalificationRequired { qualified: _, derived: _ } => true  _ => false }  _ => false })
}

// THE PARK HEADROOM IS PART OF THE CAP: the same h11 grant with the engine's 512 MiB park floor read as zero
// admits more conversations than with it, so a layout that omitted the floor would promise retention the
// engine then refuses to park.
test fn witness_park_floor_is_charged_to_each_replica() -> Bool {
  let unfloored = serving_layout_derive(g: host_6ce85c_grant, groups: host_6ce85c_independent_groups,
    b: sl_profile_with(b: strata_iq3_s_a16_profile, most: 1, floor: ServingMemoryRead { bytes: byte_size(count: 0), provenance: "witness: no floor" as NonEmptyStr }),
    r: serving_context_ceiling_requirement)
  // The four replicas' freed floors (2048 MiB) plus the 3754 MiB left after every minimum still buy one 2990 MiB
  // snapshot and not two, so dropping the floor admits nothing more here; the charge shows in the caps, 512 MiB each.
  sl_admitted_total(r: unfloored) == sl_admitted_total(r: host_6ce85c_layout)
    && sl_cap_total(r: host_6ce85c_layout) == sl_cap_total(r: unfloored) + sl_replicas(r: host_6ce85c_layout).length() * byte_size_count(b: mebibyte_to_byte_size(m: mebibyte(count: 512)))
}

// THE CAP IS READ, NOT RETYPED (review 38602). Each grant's usable RAM is the engine memory row's own cap, so the
// layout cannot budget against a copy that a cap change left behind -- the failure this pins is the two figures
// disagreeing, which is exactly what happened when srv4's cap moved and a stale figure stayed in an obligation.
test fn witness_each_grants_cap_is_the_engine_rows_cap() -> Bool {
  sl_grant_ram(g: srv4_grant) == byte_size_count(b: serving_reading_bytes_or_zero(r: srv4_serving_engine_memory.memory_cap))
    && sl_grant_ram(g: srv3_grant) == byte_size_count(b: serving_reading_bytes_or_zero(r: srv3_strata_engine_memory.memory_cap))
    && 0 < sl_grant_ram(g: srv4_grant)
    && 0 < sl_grant_ram(g: srv3_grant)
}

// srv4 AS GRANTED TODAY: one replica holding both GPUs, THIRTEEN maximum-context conversations inside the 96 GiB
// MemoryHigh the engine's cgroup now carries -- the cap the operator raised it to on 2026-11-24, read from
// srv4_serving_engine_memory.memory_cap, which is the row that owns that limit. The count moved from eight because
// BOTH of its inputs moved on the same day: the cap came up from the 56 GiB the 2026-11-09 drop-in set, AND the
// expert tier's charge came up to what it actually occupies in the shared cgroup (47,964 MiB of mapped shards)
// instead of the 22 GiB floor the kernel may leave standing. The two changes are not independent -- the eight was
// the model's own way of saying the terms did not fit, and it was the host's real state: with a 22 GiB charge the
// layout handed 12 GiB of the cap to retention that the engine's admission gate then refused to park a single
// conversation into. The budget Fits, and nothing qualified live yet. THIRTEEN IS WHAT THE CGROUP AFFORDS, not what
// the engine will keep warm: srv4's engine row declares its own ceiling of 8 conversation slots over a 16 GiB cache
// (srv4_serving_engine_memory.conversation_slots / conversation_cache), and that is the figure the engine enforces --
// this count is the affordability the cap buys, which is exactly the number the starved cap could not state, and the
// gap between the two is part of what srv4_layout's live obligation asks to be read at the ceiling. The same two-device group under h11's
// release, which cannot park across a split, refuses by name: spanning two GPUs is a backend fact, not a topology
// the layout grants on its own.
test fn witness_srv4_is_one_replica_across_two_gpus() -> Bool {
  let old_release = serving_layout_derive(g: srv4_grant, groups: srv4_layer_split_groups,
    b: sl_profile_retaining_across(b: strata_srv4_layer_split_profile, most: 1), r: serving_context_ceiling_requirement)
  (match srv4_layout {
    ServingLayoutConfigured { replicas: rs, unallocated_ram: _, evidence: e } =>
      rs.length() == 1
        && rs.all(c => c.devices.length() == 2 && c.admitted_conversations == 13 && byte_size_count(b: c.memory_max) <= byte_size_count(b: sl_gib(n: 96)))
        && (match e.budget { ServingMemoryFits { spare: _ } => true  _ => false })
        && (match e.live { ServingLiveStandingUnqualified { obligation: _ } => true  _ => false })
        && sl_all_grow_to_ceiling_under(r: srv4_layout, b: strata_srv4_layer_split_profile)
    _ => false
  })
    && (match sl_refusal(r: old_release) { Present { value: ServingLayoutBackendCannotRetain { group: gr, devices: n, most: m } } => gr == "gunbc-srv4-daily-engine" && n == 2 && m == 1  _ => false })
}

// THE MISCONFIGURATION, MADE UNRENDERABLE (the discriminating RED for this class). srv4 ran 2026-11-09 to
// 2026-11-24 under MemoryHigh/MemoryMax 56G/64G: the 60-expert-l1-cap.conf drop-in, the operator's 2026-11-09
// ruling to bound the expert RAM tier. THAT RULING IS NOT WHAT THIS REFUSES and no row here overturns it -- the
// expert tier stays bounded, and bounding it is what serving_cgroup_terms names its occupancy for. What the model
// now refuses is a cap whose TERMS do not fit inside it: the expert tier's occupancy in the shared cgroup, the
// replica's fixed RAM including the admission floor the engine demands before it will park anything, the retention
// the requirement insists on, and the rounding headroom. Re-rendering srv4's own rows against the withdrawn 56 GiB
// cap therefore REFUSES by name, which is the state the host was actually in: an operator typed one number for
// four terms and nothing in the model added them up.
test fn witness_srv4_under_the_withdrawn_56g_cap_is_refused_by_its_terms() -> Bool {
  let withdrawn = ServingResourceGrant {
    host: srv4_grant.host, usable_ram: HostUsableRamConservativeLowerBound { bytes: sl_gib(n: 56), basis: "the withdrawn 2026-11-09 MemoryHigh of gunbc-srv4-daily-engine.service (drop-in 60-expert-l1-cap.conf), re-rendered as a fixture to refuse it" as NonEmptyStr },
    overhead: srv4_grant.overhead, shared: srv4_grant.shared, swap_bound: srv4_grant.swap_bound, devices: srv4_grant.devices, charging: srv4_grant.charging,
  }
  let terms = serving_cgroup_terms(g: withdrawn, groups: srv4_layer_split_groups, b: strata_srv4_layer_split_profile, r: serving_context_ceiling_requirement)
  let refused = serving_layout_derive(g: withdrawn, groups: srv4_layer_split_groups, b: strata_srv4_layer_split_profile, r: serving_context_ceiling_requirement)
  // The terms themselves say the cap does not fit: the expert tier alone asks for 47,964 MiB of the 57,344 the
  // withdrawn cap had, before the engine's own base, its active slot, its 2560 MiB admission floor or a single
  // retained conversation is counted.
  byte_size_count(b: terms.expert_host_ram) == byte_size_count(b: mebibyte_to_byte_size(m: mebibyte(count: 47964)))
    && byte_size_count(b: terms.minimum_cap) > byte_size_count(b: sl_gib(n: 56))
    // And it is the LAYOUT that says so, naming the terms -- not a check bolted on beside the derivation.
    && (match sl_refusal(r: refused) {
         Present { value: ServingLayoutRamShort { needed: needed, available: available, terms: t } } =>
           byte_size_count(b: needed) == byte_size_count(b: t.minimum_cap)
             && byte_size_count(b: available) == byte_size_count(b: sl_gib(n: 56))
             && byte_size_count(b: t.expert_host_ram) == byte_size_count(b: terms.expert_host_ram)
             && byte_size_count(b: t.replica_fixed_ram) == byte_size_count(b: terms.replica_fixed_ram)
             && byte_size_count(b: t.retention_floor) == byte_size_count(b: terms.retention_floor)
             && byte_size_count(b: t.rounding_headroom) == byte_size_count(b: terms.rounding_headroom)
             && t.replicas == 1
         _ => false
       })
    // The composition is the sum, in the order the cgroup pays it: nothing is hidden in "overhead" and nothing
    // that shares the limit is left out of it.
    && byte_size_count(b: terms.minimum_cap) == byte_size_count(b: terms.expert_host_ram) + byte_size_count(b: terms.replica_fixed_ram)
       + byte_size_count(b: terms.retention_floor) + byte_size_count(b: terms.rounding_headroom)
    // The admission floor -- the figure whose omission read as 2-3 GB of room on the host and as a 12 GiB
    // retention budget in the model -- is IN the terms, at the engine's own read of it.
    && byte_size_count(b: terms.replica_fixed_ram) >= byte_size_count(b: mebibyte_to_byte_size(m: mebibyte(count: 2560)))
}

// THE POSITIVE CONTROL: srv4's own rows, unmodified, under the cap the operator raised them to on 2026-11-24
// (96 GiB MemoryHigh / 112 GiB MemoryMax, read 22:03-22:05 UTC). The same derivation that refused the 56 GiB cap
// CONFIGURES this one, its terms sum below the cap, and the unallocated remainder of the pool is the room the
// conversation cache was never given -- the difference between the refused case and this one is one row's figure,
// which is what makes the pair discriminating rather than two fixtures that both happen to pass.
test fn witness_srv4_under_the_raised_cap_fits_its_terms() -> Bool {
  let terms = serving_cgroup_terms(g: srv4_grant, groups: srv4_layer_split_groups, b: strata_srv4_layer_split_profile, r: serving_context_ceiling_requirement)
  let cap = byte_size_count(b: serving_reading_bytes_or_zero(r: srv4_serving_engine_memory.memory_cap))
  let snapshot = byte_size_count(b: conversation_snapshot_bytes(cost: strata_srv4_layer_split_profile.retention, context: serving_context_ceiling_requirement.max_context))
  match srv4_layout {
    ServingLayoutConfigured { replicas: rs, unallocated_ram: un, evidence: e } =>
      byte_size_count(b: terms.minimum_cap) <= cap
        && (match e.budget { ServingMemoryFits { spare: _ } => true  _ => false })
        // What the conversation cache is granted, plus the admission gate's headroom, fits in the room the expert
        // tier's occupancy leaves -- the sentence the 56 GiB cap could not say.
        && rs.all(c => byte_size_count(b: c.retention_budget) + byte_size_count(b: serving_reading_bytes_or_zero(r: strata_srv4_layer_split_profile.park_free_floor)) < cap - byte_size_count(b: terms.expert_host_ram))
        // And the pool is spent, not left idle: what remains after the caps is less than one more snapshot.
        && byte_size_count(b: un) < snapshot
    _ => false
  }
}

// THE OTHER SIDE OF THE SAME UNDER-BILLING, ALSO MADE UNRENDERABLE. The state this class root-causes billed the
// expert tier at its FLOOR instead of its OCCUPANCY. A row can now be written the other way round -- an occupancy
// BELOW the floor the same tier cannot give back under reclaim -- and the budget would again bill the shared
// cgroup less than the tier actually holds: the same starvation, arriving from the other side. floor <= occupies
// is arithmetic and not preference (the WHY is on ServingArtifactHoldBelowFloor), so the layout refuses such a
// row BY NAME, naming both figures and the row, before it can hand out a retention budget the engine will refuse
// to park into. This is the discriminating RED for the guard; the control below keeps the boundary admitted.
test fn witness_evictable_hold_occupying_below_its_floor_is_refused() -> Bool {
  let bad = sl_grant_shared(g: srv4_grant, shared: [sl_host_ram_hold(
    a: srv4_routed_expert_artifact,
    fl: ServingMemoryRead { bytes: gibibyte_to_byte_size(g: gibibyte(count: 22)), provenance: "fixture: what reclaim leaves standing" as NonEmptyStr },
    oc: ServingMemoryRead { bytes: gibibyte_to_byte_size(g: gibibyte(count: 10)), provenance: "fixture: an occupancy BELOW that floor, which no tier can both mean and pay for" as NonEmptyStr },
  )])
  let refused = serving_layout_derive(g: bad, groups: srv4_layer_split_groups, b: strata_srv4_layer_split_profile, r: serving_context_ceiling_requirement)
  match sl_refusal(r: refused) {
    Present { value: ServingArtifactHoldBelowFloor { host: h, artifact: n, floor: f, occupies: o } } =>
      h == srv4_grant.host && n == srv4_routed_expert_artifact.name
        && byte_size_count(b: f) == byte_size_count(b: gibibyte_to_byte_size(g: gibibyte(count: 22)))
        && byte_size_count(b: o) == byte_size_count(b: gibibyte_to_byte_size(g: gibibyte(count: 10)))
    _ => false
  }
}

// THE CONTROL FOR THAT RED, AT THE BOUNDARY: occupancy EQUAL to the floor is not a contradiction -- a tier that
// fills exactly what it cannot give back is a tier with nothing evictable in it, coherent even if unusual -- and
// the same derivation CONFIGURES it. So the guard fires on occupies < floor, not on occupies == floor, and it is
// the relation that is enforced rather than a size preference wearing a type.
test fn witness_evictable_hold_occupying_exactly_its_floor_is_admitted() -> Bool {
  let same = sl_grant_shared(g: srv4_grant, shared: [sl_host_ram_hold(
    a: srv4_routed_expert_artifact,
    fl: ServingMemoryRead { bytes: gibibyte_to_byte_size(g: gibibyte(count: 22)), provenance: "fixture: what reclaim leaves standing" as NonEmptyStr },
    oc: ServingMemoryRead { bytes: gibibyte_to_byte_size(g: gibibyte(count: 22)), provenance: "fixture: an occupancy EQUAL to that floor" as NonEmptyStr },
  )])
  match serving_layout_derive(g: same, groups: srv4_layer_split_groups, b: strata_srv4_layer_split_profile, r: serving_context_ceiling_requirement) {
    ServingLayoutConfigured { replicas: rs, unallocated_ram: _, evidence: e } =>
      rs.length() == 1 && (match e.budget { ServingMemoryFits { spare: _ } => true  _ => false })
    _ => false
  }
}

fn sl_replica_on(devices: List<NonEmptyStr>) -> ServingReplicaConfig {
  ServingReplicaConfig {
    group: "g" as NonEmptyStr, devices: devices, memory_max: sl_gib(n: 8), swap_max: ServingMemoryRead { bytes: sl_gib(n: 2), provenance: "witness fixture" as NonEmptyStr }, retention_budget: sl_gib(n: 3),
    admitted_conversations: 1, active_slots: 1, max_context: token_count(count: 229376),
  }
}

// A RECEIPT IS BOUND TO THE BACKEND TOO: the same h11 grant and topology under a profile that differs only in
// its named release derives the same caps and counts, and today's receipt is NOT carried onto it.
test fn witness_backend_change_with_equal_numbers_requires_requalification() -> Bool {
  let receipt = ServingLiveQualified { receipt: "witness receipt" as NonEmptyStr, configuration: sl_configuration(r: host_6ce85c_layout) }
  let b = strata_iq3_s_a16_profile
  let renamed = ServingBackendProfile {
    backend: "strata 0.1.49 qwen3.8-flash-next-iq3_s" as NonEmptyStr, device_fixed_vram: b.device_fixed_vram, device_min_elastic_vram: b.device_min_elastic_vram,
    replica_base_ram: b.replica_base_ram, active_slots: b.active_slots, active_slot_ram: b.active_slot_ram,
    retention: b.retention, park_free_floor: b.park_free_floor, max_devices_with_retention: b.max_devices_with_retention, max_context: b.max_context,
  }
  let other = serving_layout_with_qualification(result: serving_layout_derive(g: host_6ce85c_grant, groups: host_6ce85c_independent_groups, b: renamed, r: serving_context_ceiling_requirement), q: receipt)
  serving_configuration_identity(replicas: sl_replicas(r: other)) == serving_configuration_identity(replicas: sl_replicas(r: host_6ce85c_layout))
    && (match other { ServingLayoutConfigured { replicas: _, unallocated_ram: _, evidence: e } => match e.live { ServingLiveRequalificationRequired { qualified: _, derived: _ } => true  _ => false }  _ => false })
}

// IDENTITIES ARE FRAMED, NOT DELIMITED: one device named "a+b" and two devices "a" and "b" are different
// replicas, and so are their identities.
test fn witness_device_names_cannot_impersonate_a_delimiter() -> Bool {
  serving_replica_identity(c: sl_replica_on(devices: ["a+b"])) != serving_replica_identity(c: sl_replica_on(devices: ["a", "b"]))
    && serving_replica_identity(c: sl_replica_on(devices: ["a", "b"])) == serving_replica_identity(c: sl_replica_on(devices: ["a", "b"]))
}

// TWO GROUPS UNDER ONE NAME REFUSE, naming it, even when their devices are disjoint.
test fn witness_duplicate_group_names_refuse() -> Bool {
  let twice = serving_layout_derive(g: host_6ce85c_grant,
    groups: [ServingDeviceGroup { name: "x" as NonEmptyStr, devices: ["a16-85"] }, ServingDeviceGroup { name: "x" as NonEmptyStr, devices: ["a16-87"] }],
    b: strata_iq3_s_a16_profile, r: serving_context_ceiling_requirement)
  match sl_refusal(r: twice) { Present { value: ServingLayoutDuplicateGroupName { group: g } } => g == "x"  _ => false }
}

// A ZERO MINIMUM IS NOT A RETENTION-FREE LAYOUT: the allocator still deals leftover RAM as retained
// conversations, so the two-device group h11's release cannot retain across refuses under a minimum of zero
// exactly as under one, and a backend that does retain across two runs it with retention dealt.
test fn witness_zero_minimum_does_not_bypass_the_retention_limit() -> Bool {
  let pair = [ServingDeviceGroup { name: "pair" as NonEmptyStr, devices: ["a16-85", "a16-87"] }]
  let zero = ServingRequirement { max_context: serving_context_ceiling_requirement.max_context, min_retained_per_replica: 0 }
  let strata = serving_layout_derive(g: host_6ce85c_grant, groups: pair, b: strata_iq3_s_a16_profile, r: zero)
  let spanning = serving_layout_derive(g: host_6ce85c_grant, groups: pair, b: sl_profile_retaining_across(b: strata_iq3_s_a16_profile, most: 2), r: zero)
  (match sl_refusal(r: strata) { Present { value: ServingLayoutBackendCannotRetain { group: gr, devices: n, most: m } } => gr == "pair" && n == 2 && m == 1  _ => false })
    && sl_replicas(r: spanning).length() == 1
    && sl_admitted_total(r: spanning) > 0
}

fn sl_grant_devices(g: ServingResourceGrant, devices: List<ServingDevice>) -> ServingResourceGrant {
  ServingResourceGrant { host: g.host, usable_ram: g.usable_ram, overhead: g.overhead, shared: g.shared, swap_bound: g.swap_bound, devices: devices, charging: g.charging }
}

fn sl_with_selected_device(g: ServingResourceGrant, name: String, vram: ByteSize, other_board: Bool) -> ServingResourceGrant {
  sl_with_selected_board(g: g, name: name, vram: vram, board: if other_board { Present { value: decl_ref(module_path: "extdeps.gpu.nvidia", decl_name: "nvidia_rtx_pro_6000_workstation_board_catalog") } } else { Absent })
}

fn sl_with_selected_board(g: ServingResourceGrant, name: String, vram: ByteSize, board: DeclarationRef?) -> ServingResourceGrant {
  sl_grant_devices(g: g, devices: map(g.devices, d => if d.device == name {
    ServingDevice {
      device: d.device,
      board: match board { Present { value: b } => b  Absent => d.board },
      vram: ServingMemoryRead { bytes: vram, provenance: "witness fixture" as NonEmptyStr },
    }
  } else { d }))
}

// A RECEIPT IS BOUND TO THE SELECTED HARDWARE: a selected device whose VRAM reads 24,576 MiB instead of
// 15,356 MiB, or whose board is another one under the same name, passes the same per-device minimum and
// derives the same caps and counts, and today's receipt is NOT carried onto either.
test fn witness_selected_device_change_with_equal_numbers_requires_requalification() -> Bool {
  let receipt = ServingLiveQualified { receipt: "witness receipt" as NonEmptyStr, configuration: sl_configuration(r: host_6ce85c_layout) }
  let bigger = serving_layout_with_qualification(result: serving_layout_derive(g: sl_with_selected_device(g: host_6ce85c_grant, name: "a16-85", vram: mebibyte_to_byte_size(m: mebibyte(count: 24576)), other_board: false), groups: host_6ce85c_independent_groups, b: strata_iq3_s_a16_profile, r: serving_context_ceiling_requirement), q: receipt)
  let reboarded = serving_layout_with_qualification(result: serving_layout_derive(g: sl_with_selected_device(g: host_6ce85c_grant, name: "a16-85", vram: mebibyte_to_byte_size(m: mebibyte(count: 15356)), other_board: true), groups: host_6ce85c_independent_groups, b: strata_iq3_s_a16_profile, r: serving_context_ceiling_requirement), q: receipt)
  serving_configuration_identity(replicas: sl_replicas(r: bigger)) == serving_configuration_identity(replicas: sl_replicas(r: host_6ce85c_layout))
    && serving_configuration_identity(replicas: sl_replicas(r: reboarded)) == serving_configuration_identity(replicas: sl_replicas(r: host_6ce85c_layout))
    && (match bigger { ServingLayoutConfigured { replicas: _, unallocated_ram: _, evidence: e } => match e.live { ServingLiveRequalificationRequired { qualified: _, derived: _ } => true  _ => false }  _ => false })
    && (match reboarded { ServingLayoutConfigured { replicas: _, unallocated_ram: _, evidence: e } => match e.live { ServingLiveRequalificationRequired { qualified: _, derived: _ } => true  _ => false }  _ => false })
}

fn sl_live_after_board(board: DeclarationRef, receipt_board: DeclarationRef) -> ServingLayoutResult {
  let a16 = mebibyte_to_byte_size(m: mebibyte(count: 15356))
  let before = serving_layout_derive(g: sl_with_selected_board(g: host_6ce85c_grant, name: "a16-85", vram: a16, board: Present { value: receipt_board }), groups: host_6ce85c_independent_groups, b: strata_iq3_s_a16_profile, r: serving_context_ceiling_requirement)
  let receipt = ServingLiveQualified { receipt: "witness receipt" as NonEmptyStr, configuration: sl_configuration(r: before) }
  serving_layout_with_qualification(result: serving_layout_derive(g: sl_with_selected_board(g: host_6ce85c_grant, name: "a16-85", vram: a16, board: Present { value: board }), groups: host_6ce85c_independent_groups, b: strata_iq3_s_a16_profile, r: serving_context_ceiling_requirement), q: receipt)
}

// A BOARD IS IDENTIFIED BY ITS PARTS, NOT ITS DISPLAY KEY: module "m" with declaration "b::c", module "m::b"
// with declaration "c", and module "m" declaration "b" field "c" all display as "m::b::c", and are three
// different references. Their identities differ, and a receipt taken with one of them as a selected device's
// board is not carried onto another; the same reference keeps the receipt.
test fn witness_boards_with_one_display_key_are_different_qualifications() -> Bool {
  let inner = decl_ref(module_path: "m", decl_name: "b::c")
  let outer = decl_ref(module_path: "m::b", decl_name: "c")
  let field = decl_field_ref(module_path: "m", decl_name: "b", field_name: "c")
  declaration_ref_display_key(ref: inner) == declaration_ref_display_key(ref: outer)
    && declaration_ref_display_key(ref: inner) == declaration_ref_display_key(ref: field)
    && declaration_ref_identity(reference: inner).digest != declaration_ref_identity(reference: outer).digest
    && declaration_ref_identity(reference: inner).digest != declaration_ref_identity(reference: field).digest
    && declaration_ref_identity(reference: outer).digest != declaration_ref_identity(reference: field).digest
    && (match sl_live_after_board(board: outer, receipt_board: inner) { ServingLayoutConfigured { replicas: _, unallocated_ram: _, evidence: e } => match e.live { ServingLiveRequalificationRequired { qualified: _, derived: _ } => true  _ => false }  _ => false })
    && (match sl_live_after_board(board: field, receipt_board: inner) { ServingLayoutConfigured { replicas: _, unallocated_ram: _, evidence: e } => match e.live { ServingLiveRequalificationRequired { qualified: _, derived: _ } => true  _ => false }  _ => false })
    && (match sl_live_after_board(board: inner, receipt_board: inner) { ServingLayoutConfigured { replicas: _, unallocated_ram: _, evidence: e } => match e.live { ServingLiveStandingQualified { receipt: _ } => true  _ => false }  _ => false })
}

fn sl_profile_with_snapshot(b: ServingBackendProfile, fixed: ByteSize, per_token: ByteSize) -> ServingBackendProfile {
  ServingBackendProfile {
    backend: b.backend, device_fixed_vram: b.device_fixed_vram, device_min_elastic_vram: b.device_min_elastic_vram,
    replica_base_ram: b.replica_base_ram, active_slots: b.active_slots, active_slot_ram: b.active_slot_ram,
    retention: ConversationSnapshotCost { fixed: fixed, per_token: per_token, provenance: "witness fixture" as NonEmptyStr, observed_up_to: b.retention.observed_up_to },
    park_free_floor: b.park_free_floor, max_devices_with_retention: b.max_devices_with_retention, max_context: b.max_context,
  }
}

// A SNAPSHOT THAT COSTS NOTHING HAS NO CONVERSATION COUNT: the allocation divides the RAM it has left by one
// conversation's snapshot, so h11's grant under a profile whose retention cost is zero at the ceiling refuses
// with the cause, before any division. The same profile at one byte per token is an ordinary layout.
test fn witness_a_zero_snapshot_cost_refuses_before_allocation() -> Bool {
  let zero = serving_layout_derive(g: host_6ce85c_grant, groups: host_6ce85c_independent_groups,
    b: sl_profile_with_snapshot(b: strata_iq3_s_a16_profile, fixed: byte_size(count: 0), per_token: byte_size(count: 0)), r: serving_context_ceiling_requirement)
  let one = serving_layout_derive(g: host_6ce85c_grant, groups: host_6ce85c_independent_groups,
    b: sl_profile_with_snapshot(b: strata_iq3_s_a16_profile, fixed: byte_size(count: 0), per_token: byte_size(count: 1)), r: serving_context_ceiling_requirement)
  (match sl_refusal(r: zero) { Present { value: ServingLayoutSnapshotCostNotPositive { context: _ } } => true  _ => false })
    && sl_replicas(r: one).length() == 4
}

// ---- ONE PLACEMENT VOCABULARY FOR EVERY HOST, AND SRV3 AS GRANTED (2026-11-09)
//
// The rung helpers: what one medium of an artifact holds, what its floor is, and whether it is pinned.

fn sl_rung(a: ServingSharedArtifact, m: ServingArtifactMedium) -> ServingArtifactRung? {
  match m { ArtifactOnDevice => a.device, ArtifactInHostRam => a.host_ram, ArtifactOnDisk => a.disk }
}

fn sl_rung_bytes(a: ServingSharedArtifact, m: ServingArtifactMedium) -> Nat {
  match sl_rung(a: a, m: m) {
    Absent => 0
    Present { value: r } => byte_size_count(b: serving_reading_bytes_or_zero(r: r.bytes))
  }
}

// True when the rung on this medium exists and states its size as UNREAD -- the honest shape when a figure exists
// only as an unattributed aggregate (srv3's expert host-RAM rung, whose only number is the cgroup file counter). The
// reason is a NonEmptyStr -- checking it is present and non-blank is the obligation being carried, not dropped.
fn sl_rung_bytes_unread(a: ServingSharedArtifact, m: ServingArtifactMedium) -> Bool {
  match sl_rung(a: a, m: m) {
    Absent => false
    Present { value: r } => match r.bytes {
      ServingMemoryUnread { reason: reason } => reason.length() > 0
      _ => false
    }
  }
}

// A rung whose size is a stated bet: Assumed, with a positive figure and a non-blank obligation naming the read that
// replaces it. Used for srv3's disk backing (the shard size srv3 has not du'd).
fn sl_rung_bytes_assumed(a: ServingSharedArtifact, m: ServingArtifactMedium) -> Bool {
  match sl_rung(a: a, m: m) {
    Absent => false
    Present { value: r } => match r.bytes {
      ServingMemoryAssumed { bytes: b, reason: reason } => byte_size_count(b: b) > 0 && reason.length() > 0
      _ => false
    }
  }
}

// The one check the two hosts genuinely share: the routed-expert artifact is modelled as exactly three rungs (card,
// host-RAM, disk). Shared as a helper only because it MEANS the same for srv4 and srv3; the arithmetic differs, so
// each host keeps its own honest partition witness (root_generalization forbids one over-general helper).
fn has_three_expert_rungs(a: ServingSharedArtifact) -> Bool {
  sl_rung_count(a: a, m: ArtifactOnDevice) == 1
    && sl_rung_count(a: a, m: ArtifactInHostRam) == 1
    && sl_rung_count(a: a, m: ArtifactOnDisk) == 1
}

// A pinned rung's floor is its whole (nothing can be squeezed out); an evictable rung's floor is the floor it
// states on its hold — what the kernel may leave standing, NOT the figure the budget reserves.
fn sl_rung_floor(a: ServingSharedArtifact, m: ServingArtifactMedium) -> Nat {
  match sl_rung(a: a, m: m) {
    Absent => 0
    Present { value: r } => byte_size_count(b: match r.holds {
      ArtifactHeldPinned { mechanism: _ } => serving_reading_bytes_or_zero(r: r.bytes)
      ArtifactHeldEvictable { bound_by: _, floor: f, occupies: _ } => serving_reading_bytes_or_zero(r: f)
    })
  }
}

// What an evictable rung STATES it occupies inside the cgroup it shares with the engine — the figure
// serving_artifact_host_ram_charge bills, read from the hold rather than recomputed anywhere.
fn sl_rung_occupies(a: ServingSharedArtifact, m: ServingArtifactMedium) -> Nat {
  match sl_rung(a: a, m: m) {
    Absent => 0
    Present { value: r } => byte_size_count(b: match r.holds {
      ArtifactHeldPinned { mechanism: _ } => byte_size(count: 0)
      ArtifactHeldEvictable { bound_by: _, floor: _, occupies: o } => serving_reading_bytes_or_zero(r: o)
    })
  }
}

// At most one rung per medium exists, so a rung is present (1) or absent (0) — never more than one.
fn sl_rung_count(a: ServingSharedArtifact, m: ServingArtifactMedium) -> Nat {
  match sl_rung(a: a, m: m) { Absent => 0, Present { value: _ } => 1 }
}

// True when the medium holds a rung and that rung is pinned (absent means false: nothing is reserved there).
fn sl_rung_pinned(a: ServingSharedArtifact, m: ServingArtifactMedium) -> Bool {
  match sl_rung(a: a, m: m) {
    Absent => false
    Present { value: r } => match r.holds {
      ArtifactHeldPinned { mechanism: _ } => true
      ArtifactHeldEvictable { bound_by: _, floor: _, occupies: _ } => false
    }
  }
}

// THE SAME ARTIFACT KIND, CHARGED TWO WAYS, WHICH IS THE WHOLE POINT OF THE HOLD. h11's experts are mlocked: the
// host reserves them WHOLE, exactly as it did before rungs existed (that equality against the host's own reading
// of the locked copy is the regression that proves h11's charge moved not at all). srv3 and srv4 run the mmap+cap
// shape (srv3 since the 2026-11-09 hand change): a page cache under the engine's own service cap, which the host
// reserves at its OCCUPANCY -- what it fills inside the cgroup the engine shares -- and NOT at its floor.
//
// THE FLOOR IS NO LONGER THE CHARGE, AND THAT IS THE srv4 FIX (2026-11-24). Charging the 22 GiB floor billed a tier
// that in fact occupied the whole 46.84 GiB it maps, and the layout handed the difference to the conversation cache
// as a retention budget the engine then refused to park one conversation into. So: charge == occupancy on both
// hosts; the floor is still stated, still smaller, and still identity-bearing; and the occupancy never exceeds the
// file it caches, which is what keeps "occupancy" from being an invitation to invent a size.
test fn witness_pinned_rungs_reserve_whole_and_evictable_ones_their_occupancy() -> Bool {
  // h11: the charge IS the lock service's resident copy, unchanged.
  fold(host_6ce85c_grant.shared, init: 0, f: (acc, a) => acc + byte_size_count(b: serving_artifact_host_ram_charge(a: a)))
    == byte_size_count(b: host_6ce85c_serving_memory_observed.shared_resident)
  // srv3: evictable under its service cap, charged its occupancy -- its resident expert figure is UNREAD (the
  // cgroup file counter overstates the shard and is not attributed to experts), so the rung states no resident figure;
  // what it may not do is leave the budget without a figure, which is why the hold states an occupancy.
    && !sl_rung_pinned(a: srv3_routed_expert_artifact, m: ArtifactInHostRam)
    && byte_size_count(b: serving_artifact_host_ram_charge(a: srv3_routed_expert_artifact))
      == sl_rung_occupies(a: srv3_routed_expert_artifact, m: ArtifactInHostRam)
      && sl_rung_occupies(a: srv3_routed_expert_artifact, m: ArtifactInHostRam) == byte_size_count(b: mebibyte_to_byte_size(m: mebibyte(count: 47964)))
      && sl_rung_floor(a: srv3_routed_expert_artifact, m: ArtifactInHostRam) == byte_size_count(b: sl_gib(n: 22))
      && sl_rung_floor(a: srv3_routed_expert_artifact, m: ArtifactInHostRam) < sl_rung_occupies(a: srv3_routed_expert_artifact, m: ArtifactInHostRam)
      && sl_rung_bytes(a: srv3_routed_expert_artifact, m: ArtifactInHostRam) == 0
      && sl_rung_bytes_unread(a: srv3_routed_expert_artifact, m: ArtifactInHostRam)
      && sl_rung_occupies(a: srv3_routed_expert_artifact, m: ArtifactInHostRam) <= byte_size_count(b: srv3_routed_expert_artifact.bytes)
  // srv4: same shape, same rule. The charge is its 47,964 MiB of mapped shards -- MORE than the 24,576 MiB file-tier
  // slice this rung holds by the engine's own plan, because the on-card copy is uploaded through the same pages --
  // and it is bounded by the artifact's file size, never above it.
    && !sl_rung_pinned(a: srv4_routed_expert_artifact, m: ArtifactInHostRam)
    && byte_size_count(b: serving_artifact_host_ram_charge(a: srv4_routed_expert_artifact))
      == sl_rung_occupies(a: srv4_routed_expert_artifact, m: ArtifactInHostRam)
      && sl_rung_occupies(a: srv4_routed_expert_artifact, m: ArtifactInHostRam) == byte_size_count(b: mebibyte_to_byte_size(m: mebibyte(count: 47964)))
      && sl_rung_floor(a: srv4_routed_expert_artifact, m: ArtifactInHostRam) == byte_size_count(b: sl_gib(n: 22))
      && sl_rung_floor(a: srv4_routed_expert_artifact, m: ArtifactInHostRam) < sl_rung_bytes(a: srv4_routed_expert_artifact, m: ArtifactInHostRam)
      && sl_rung_bytes(a: srv4_routed_expert_artifact, m: ArtifactInHostRam) == byte_size_count(b: mebibyte_to_byte_size(m: mebibyte(count: 24576)))
      && sl_rung_occupies(a: srv4_routed_expert_artifact, m: ArtifactInHostRam) > sl_rung_bytes(a: srv4_routed_expert_artifact, m: ArtifactInHostRam)
      && sl_rung_occupies(a: srv4_routed_expert_artifact, m: ArtifactInHostRam) <= byte_size_count(b: srv4_routed_expert_artifact.bytes)
  // The disk rungs hold the file on both hosts; the device rungs are the on-card expert cache -- pinned on the
  // card and carrying NO host-RAM floor, because a device rung reserves host RAM for nothing (review 92466; it is
  // ArtifactHeldPinned precisely so it cannot state a host-RAM floor it must not have).
    && sl_rung_pinned(a: srv4_routed_expert_artifact, m: ArtifactOnDisk)
    && sl_rung_pinned(a: srv3_routed_expert_artifact, m: ArtifactOnDisk)
    && sl_rung_pinned(a: srv4_routed_expert_artifact, m: ArtifactOnDevice)
    && sl_rung_pinned(a: srv3_routed_expert_artifact, m: ArtifactOnDevice)
}

// THE RUNGS ARE ONE ARTIFACT, NOT THREE FACTS (srv4, whose rung bytes are all READ): its engine planned "46.8 GiB
// experts, 22.9 GiB in the GPU caches, 0.0 GiB RAM copy, file tier 24.0 GiB", so the card rung and the disk rung
// TOGETHER are the file (figures rounded to 0.1 GiB, hence the one-gibibyte tolerance). The host-RAM rung's BYTES are
// the file-tier slice the engine streams -- the plan's own partition -- while its OCCUPANCY, what the cgroup pays, is
// the whole mapped file: at least the slice it streams, never more than the file, and strictly more than the slice
// because the on-card copy is uploaded through the same pages. That last inequality is the 2026-11-24 srv4 lesson
// written as arithmetic: a model that read the slice as the charge under-billed the cgroup by ~23 GiB and starved
// the conversation cache beside it. A wrong figure in any rung breaks one of these. srv3's card and host-RAM bytes
// are UNREAD, so it does NOT run through this arithmetic (sl_rung_bytes folds Unread to 0 and would make
// card+disk==whole pass on bytes never measured); it gets its own honest typing witness in
// witness_pinned_rungs_reserve_whole_and_evictable_ones_their_occupancy and
// test.claim.serving.serving_replica_profile_witness. Only "exactly three rungs" is shared (has_three_expert_rungs).
test fn witness_srv4_expert_rungs_partition_the_file_they_came_from() -> Bool {
  let a = srv4_routed_expert_artifact
  let whole = byte_size_count(b: a.bytes)
  let on_cards = sl_rung_bytes(a: a, m: ArtifactOnDevice)
  let on_disk = sl_rung_bytes(a: a, m: ArtifactOnDisk)
  let in_ram = sl_rung_bytes(a: a, m: ArtifactInHostRam)
  let occupied = sl_rung_occupies(a: a, m: ArtifactInHostRam)
  let one_gib = byte_size_count(b: sl_gib(n: 1))
  has_three_expert_rungs(a: a)
    && on_cards + on_disk >= whole && on_cards + on_disk <= whole + one_gib
    && in_ram <= on_disk && in_ram > 0
    && occupied >= in_ram && occupied <= whole && occupied > in_ram
}

// SRV3 SIBLING (review 2787d022): srv3 has the SAME three-rung structure, but its card cache and resident host-RAM
// pages are UNREAD and its disk size is a du-pending Assumption. It must NOT be run through partition arithmetic --
// sl_rung_bytes folds unread bytes to 0, so card+disk ~= whole would pass on bytes never measured. What is honest and
// checkable instead: exactly three rungs; card and host-RAM sizes typed UNREAD; disk typed ASSUMED with a positive
// figure; and the obligations PRESERVED, not dropped -- each unread/assumed reason is a NonEmptyStr naming the read that
// replaces it (the length check makes that concrete, not vacuous). The host-RAM rung's positive reserve is its FLOOR,
// which the floor and billing witnesses check; nothing here sums unknown bytes.
test fn witness_srv3_expert_rungs_are_honestly_typed_not_partitioned() -> Bool {
  let a = srv3_routed_expert_artifact
  has_three_expert_rungs(a: a)
    && sl_rung_bytes_unread(a: a, m: ArtifactOnDevice)
    && sl_rung_bytes_unread(a: a, m: ArtifactInHostRam)
    && sl_rung_bytes_assumed(a: a, m: ArtifactOnDisk)
}

// (No sum-to-MemoryCurrent witness: base is an assumption and the expert host-RAM rung is UNREAD, so there is no model
// figure to add to base. The ~79-81 GiB MemoryCurrent is recorded as an observation in srv3_grant's basis and the
// rung's reason; composing it would re-promote the unattributed file counter the P1 fix removes.)

// SRV3 AS GRANTED, BY THE SAME DERIVATION srv4 USES: one replica holding both cards inside the 96 GiB MemoryHigh
// its service drop-in sets, its live --batch 8 as the one batch input, the budget Fits, nothing qualified live.
// Its group is named for the unit that runs it, which is also the group its router naming joins on. TEN conversations
// is what the pool leaves at srv3's declared snapshot cost once the expert tier is charged what it OCCUPIES inside
// the cgroup the engine shares -- the same 47,964 MiB of mapped shards srv4 pays, because srv3 runs the same
// mmap+cap shape on the same shards (its 2026-11-09 hand change), and its expert page-cache counter stays Unread
// precisely because the cgroup's file counter is not attributable to experts. It was seventeen while the tier was
// charged its 22 GiB working-set floor: the same ~25 GiB that srv4's cap was short of, subtracted from retention
// here instead of from a starving admission gate there. That retention budget is a CEILING the engine may spend,
// not a reservation this layout made, so the figure is exactly as good as the memory.current reading the live
// obligation asks for. The operator's reads say srv3 itself was never starved (96% prompt-cache warm before the
// fleet change, 99.0% after -- an operator-session ad-hoc read, 2026-11-24): this count is the model's budget
// figure for the same artifact shape on both hosts, not a claim that srv3 was mis-sized.
test fn witness_srv3_is_one_replica_across_two_gpus_in_its_own_slice() -> Bool {
  sl_replicas(r: srv3_layout).length() == 1
    && (match srv3_layout {
      ServingLayoutConfigured { replicas: rs, unallocated_ram: _, evidence: e } =>
        rs.all(c => c.group == "strata-pool" && c.devices.length() == 2 && c.active_slots == 8
          && c.admitted_conversations == 10
          && byte_size_count(b: c.memory_max) <= byte_size_count(b: sl_gib(n: 96)))
        && (match e.budget { ServingMemoryFits { spare: _ } => true  _ => false })
        && (match e.live { ServingLiveStandingUnqualified { obligation: _ } => true  _ => false })
        && sl_all_grow_to_ceiling_under(r: srv3_layout, b: strata_srv3_layer_split_profile)
      _ => false
    })
    && sl_replicas(r: srv3_layout).all(c => byte_size_count(b: serving_reading_bytes_or_zero(r: strata_srv3_layer_split_profile.replica_base_ram)) + byte_size_count(b: serving_reading_bytes_or_zero(r: strata_srv3_layer_split_profile.park_free_floor)) < byte_size_count(b: c.memory_max))
}


// THE SWAP BOUND TRAVELS AS WHAT IT IS (review 92384). Each host's swap limit has one home -- its engine row in
// gunbc.serving.serving_host_memory -- and the grant carries that reading with its label intact. srv3's slice has
// never had MemorySwapMax read, so its grant says UNREAD; srv4's is its own read of MemorySwapMax=0; h11's is the
// operator's declared 2 GiB, labelled the decision it is. A fabricated 0 dressed as a measurement fails all three arms.
test fn witness_each_grants_swap_bound_keeps_its_own_label() -> Bool {
  // srv3's OWN slice limit is unread (its engine row says so, srv3_strata_engine_memory.swap_cap), so the grant
  // may not present a number as measured -- it carries the fleet no-swap convention as Assumed(0), labelled.
  match srv3_grant.swap_bound {
    ServingMemoryAssumed { bytes: b, reason: _ } => byte_size_count(b: b) == 0
    ServingMemoryRead { bytes: _, provenance: _ } => false
    ServingMemoryUnread { reason: _ } => false
  }
    && match srv4_grant.swap_bound {
         ServingMemoryRead { bytes: b, provenance: _ } => byte_size_count(b: b) == 0
         ServingMemoryUnread { reason: _ } => false
         ServingMemoryAssumed { bytes: _, reason: _ } => false
       }
    && match host_6ce85c_grant.swap_bound {
         ServingMemoryAssumed { bytes: b, reason: _ } => byte_size_count(b: b) == byte_size_count(b: sl_gib(n: 2))
         ServingMemoryRead { bytes: _, provenance: _ } => false
         ServingMemoryUnread { reason: _ } => false
       }
}

// THE LABEL SURVIVES DERIVATION (the second half of review 92384): before, the layout wrapped the grant's byte in
// ServingMemoryRead { provenance: "the grant's swap bound" }, so an unread srv3 limit emerged as a reading. The
// replica config now carries the grant's reading verbatim -- srv3's derives UNREAD, never a Read, and the host's
// memory verdict surfaces it as undetermined instead of silently fitting.
test fn witness_srv3_derivation_carries_the_grants_swap_label() -> Bool {
  match serving_layout_derive(g: srv3_grant, groups: srv3_layer_split_groups, b: strata_srv3_layer_split_profile, r: serving_context_ceiling_requirement) {
    ServingLayoutConfigured { replicas: rs, unallocated_ram: _, evidence: _ } =>
      match rs |> first() {
        Present { value: c } => match c.swap_max {
          // the grant's Assumed(0) reaches the config STILL Assumed -- the bug was the derivation re-wrapping it
          // as ServingMemoryRead { provenance: "the grant's swap bound" }, dressing an unknown as a measurement.
          ServingMemoryAssumed { bytes: b, reason: _ } => byte_size_count(b: b) == 0
          ServingMemoryRead { bytes: _, provenance: _ } => false
          ServingMemoryUnread { reason: _ } => false
        }
        Absent => false
      }
    ServingLayoutRefused { refusal: _ } => false
  }
}

// THE CHARGED ASSUMPTIONS ARE LISTED AS ASSUMPTIONS, NOT PROMOTED TO OBSERVED (review 92488). srv3 fills its swap
// bound (from srv4), its shared artifact's host-RAM rung FLOOR (the working set the budget reserves) and its disk rung
// (the shard size) with borrowed assumed figures that the budget CHARGES. serving_layout_assumptions folds the profile,
// the devices, the swap bound and each artifact's charged reading, so the derived identity cannot present a borrowed
// number as observed (gunbc.design_argument::epistemic_humility). The reasons are read from their SOURCE rows, not
// retyped: removing the swap or artifact fold from serving_layout_assumptions drops that reason from the derived list
// and this goes RED.
fn ca_reason_listed(r: ServingMemoryReading, list: List<NonEmptyStr>) -> Bool {
  match r {
    ServingMemoryAssumed { bytes: _, reason: x } => list.any(a => a == x)
    _ => false
  }
}

fn ca_evictable_floor(a: ServingSharedArtifact) -> ServingMemoryReading {
  match a.host_ram {
    Present { value: r } => match r.holds { ArtifactHeldEvictable { bound_by: _, floor: f, occupies: _ } => f  _ => ServingMemoryUnread { reason: "not evictable" as NonEmptyStr } }
    Absent => ServingMemoryUnread { reason: "no host-RAM rung" as NonEmptyStr }
  }
}

// The OCCUPANCY of an evictable host-RAM rung -- the reading serving_artifact_host_ram_charge actually bills, and
// so the one that must be an Assumed bet (with its reason in the layout's assumption list) or a read, never a
// silently Unread zero. Read from the hold; recomputing it here would only prove the witness agrees with itself.
fn ca_evictable_occupies(a: ServingSharedArtifact) -> ServingMemoryReading {
  match a.host_ram {
    Present { value: r } => match r.holds { ArtifactHeldEvictable { bound_by: _, floor: _, occupies: o } => o  _ => ServingMemoryUnread { reason: "not evictable" as NonEmptyStr } }
    Absent => ServingMemoryUnread { reason: "no host-RAM rung" as NonEmptyStr }
  }
}

test fn witness_srv3_charged_assumptions_are_listed_not_promoted() -> Bool {
  match srv3_layout {
    ServingLayoutConfigured { replicas: _, unallocated_ram: _, evidence: e } => {
      // The swap bound is charged per replica and srv3 fills it with a borrowed srv4 figure (Assumed); the host-RAM
      // rung's OCCUPANCY -- the figure the budget actually bills for the expert tier, the whole mapped shard set the
      // engine's cgroup pays for -- is a borrowed srv4 figure too (Assumed, with its attribution obligation); the
      // rung's FLOOR is the 22 GiB working set taken from srv4's read (Assumed); and the disk rung holds the shard
      // size srv3 has not du'd (Assumed). All four are bets a reader must not take as measured, and all are read
      // from their SOURCE rows: removing the swap or artifact fold from serving_layout_assumptions drops a reason and
      // this goes RED. The host-RAM rung BYTES are UNREAD (the cgroup file counter overstates the shard and is not
      // attributed to experts), so they are NOT a listed assumption -- they must stay an obligation, never promoted
      // to a figure; the check below fails if they are ever promoted to Read/Assumed.
      let disk_assumed = match srv3_routed_expert_artifact.disk {
        Present { value: r } => ca_reason_listed(r: r.bytes, list: e.assumptions)
        Absent => false
      }
      let host_ram_bytes_unread = match srv3_routed_expert_artifact.host_ram {
        Present { value: r } => match r.bytes { ServingMemoryUnread { reason: _ } => true  _ => false }
        Absent => false
      }
      ca_reason_listed(r: srv3_grant.swap_bound, list: e.assumptions)
        && ca_reason_listed(r: ca_evictable_occupies(a: srv3_routed_expert_artifact), list: e.assumptions)
        && ca_reason_listed(r: ca_evictable_floor(a: srv3_routed_expert_artifact), list: e.assumptions)
        && host_ram_bytes_unread
        && disk_assumed
    }
    ServingLayoutRefused { refusal: _ } => false
  }
}

// THE SWAP BOUND IS GUARDED LIKE EVERY OTHER CHARGED READING (review 92400). serving_reading_bytes_or_zero contributes
// nothing for an Unread reading, and the identity frame plus the host-memory verdict charge the swap through it -- so an
// Unread swap bound would widen the budget by its true bytes without a word (gunbc.design_argument::fail_closed: a
// silent widen is a hard reject). serving_layout_missing therefore lists the swap bound too, so an unread one is refused.
// Discriminating: with the guard absent the very same grant derives Configured (the swap would not be listed missing),
// so refuses would be false and this witness fails. The real srv3 grant carries its bound as an Assumed reading (a
// declared bet, not a missing reading), so srv3_layout still derives -- the guard refuses only what was never read.
test fn witness_unread_swap_bound_refuses_the_layout() -> Bool {
  let unread = ServingMemoryUnread { reason: "strata.slice MemorySwapMax has not been read" as NonEmptyStr }
  let refused = serving_layout_derive(
    g: sl_grant_swap(g: srv3_grant, swap: unread), groups: srv3_layer_split_groups,
    b: strata_srv3_layer_split_profile, r: serving_context_ceiling_requirement)
  let refuses = match refused {
    ServingLayoutRefused { refusal: ServingLayoutInputsUnread { missing: m } } => 0 < count(m)
    _ => false
  }
  let still_fits = match srv3_layout {
    ServingLayoutConfigured { replicas: rs, unallocated_ram: _, evidence: _ } => 0 < rs.length()
    ServingLayoutRefused { refusal: _ } => false
  }
  refuses && still_fits
}

// An artifact with its DEVICE rung's bytes set to a given reading -- single-variable, for the identity test: a device
// rung reserves no host RAM, so its figure is display-only and must never be folded into a measured zero.
fn sl_device_bytes(a: ServingSharedArtifact, r: ServingMemoryReading) -> ServingSharedArtifact {
  ServingSharedArtifact {
    name: a.name, bytes: a.bytes, owner: a.owner, host_ram: a.host_ram, disk: a.disk,
    device: match a.device {
      Present { value: d } => Present { value: ServingArtifactRung { bytes: r, holds: d.holds, realizes: d.realizes } }
      Absent => Absent
    },
  }
}

// THE CHARGED ARTIFACT READING IS GUARDED LIKE SWAP (review 92474; fail_closed). serving_artifact_host_ram_charge
// folds the host-RAM rung's reading with serving_reading_bytes_or_zero, whose Unread arm is ZERO -- so an Unread
// charged figure would silently widen the pool by billing 0. It now joins serving_layout_missing and the layout
// REFUSES. Pre-fix, both these layouts configured (billed 0); each assertion is red-capable on that defect.
test fn witness_unread_charged_host_rung_refuses_the_layout_instead_of_billing_zero() -> Bool {
  // an evictable host-RAM rung whose CHARGED occupancy is unread ...
  let evict = sl_grant_shared(g: srv4_grant, shared: [sl_host_ram_occupancy_unread(a: srv4_routed_expert_artifact)])
  let evicted = match serving_layout_derive(g: evict, groups: srv4_layer_split_groups, b: strata_srv4_layer_split_profile, r: serving_context_ceiling_requirement) {
    ServingLayoutRefused { refusal: ServingLayoutInputsUnread { missing: ms } } => 0 < ms.length()
    _ => false
  }
  // ... while an unread FLOOR, which the budget no longer bills, must still CONFIGURE. This is the arm that keeps
  // the guard honest about which figure the charge is: guard the wrong one and the eviction story reappears.
  // ... a pinned host-RAM rung whose billed bytes are unread ...
  let pin = sl_grant_shared(g: srv4_grant, shared: [sl_host_ram_pinned_bytes_unread(a: srv4_routed_expert_artifact)])
  let pinned = match serving_layout_derive(g: pin, groups: srv4_layer_split_groups, b: strata_srv4_layer_split_profile, r: serving_context_ceiling_requirement) {
    ServingLayoutRefused { refusal: ServingLayoutInputsUnread { missing: ms } } => 0 < ms.length()
    _ => false
  }
  // ... and the real srv4_grant (read floor, read bytes) still CONFIGURES -- the refusal is specifically the unread charge.
  let floor_free = sl_grant_shared(g: srv4_grant, shared: [sl_host_ram_floor_unread(a: srv4_routed_expert_artifact)])
  let floor_configured = match serving_layout_derive(g: floor_free, groups: srv4_layer_split_groups, b: strata_srv4_layer_split_profile, r: serving_context_ceiling_requirement) {
    ServingLayoutConfigured { replicas: rs, unallocated_ram: _, evidence: _ } => 0 < rs.length()
    ServingLayoutRefused { refusal: _ } => false
  }
  evicted && pinned && floor_configured && (match srv4_layout { ServingLayoutConfigured { replicas: _, unallocated_ram: _, evidence: _ } => true  _ => false })
}

// The identity frame no longer prints an UNREAD rung figure as a fabricated 0 (review 92466/92474). A device rung
// measured at zero and one nobody has read used to print the same "...-bytes 0"; they must now be DISTINCT
// configurations, while both still configure (a device rung charges no host RAM, so an unread device figure is a
// display concern, not a budget widen, and must not refuse).
test fn witness_unread_rung_bytes_is_not_a_measured_zero_in_the_identity() -> Bool {
  let zeroed = sl_device_bytes(a: srv4_routed_expert_artifact, r: ServingMemoryRead { bytes: byte_size(count: 0), provenance: "fixture: measured zero" as NonEmptyStr })
  let unread = sl_device_bytes(a: srv4_routed_expert_artifact, r: ServingMemoryUnread { reason: "fixture: the on-card cache has not been read" as NonEmptyStr })
  let c0 = serving_layout_derive(g: sl_grant_shared(g: srv4_grant, shared: [zeroed]), groups: srv4_layer_split_groups, b: strata_srv4_layer_split_profile, r: serving_context_ceiling_requirement)
  let c1 = serving_layout_derive(g: sl_grant_shared(g: srv4_grant, shared: [unread]), groups: srv4_layer_split_groups, b: strata_srv4_layer_split_profile, r: serving_context_ceiling_requirement)
  (match c0 { ServingLayoutConfigured { replicas: _, unallocated_ram: _, evidence: _ } => true  _ => false })
    && (match c1 { ServingLayoutConfigured { replicas: _, unallocated_ram: _, evidence: _ } => true  _ => false })
    && sl_configuration(r: c0) != sl_configuration(r: c1)
}
