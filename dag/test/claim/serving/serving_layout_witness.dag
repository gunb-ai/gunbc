import gunbc.serving.serving_host_memory {
  ServingMemoryReading, ServingMemoryRead, ServingMemoryAssumed, ServingMemoryUnread, ServingMemoryFits,
  conversation_snapshot_bytes, ConversationSnapshotCost, host_6ce85c_serving_memory_observed, srv3_strata_engine_memory,
  serving_reading_bytes_or_zero,
}
import gunbc.serving.serving_layout {
  ServingResourceGrant, ServingDevice, ServingDeviceGroup, ServingBackendProfile, ServingRequirement, ServingReplicaConfig,
  ServingLayoutResult, ServingLayoutConfigured, ServingLayoutRefused, ServingLayoutRefusal,
  ServingLayoutRamShort, ServingLayoutDeviceTooSmall, ServingLayoutBackendCannotRetain, ServingLayoutUnknownDevice,
  ServingLayoutDeviceInTwoGroups, ServingLayoutContextAboveBackend, ServingLayoutDuplicateGroupName, ServingLayoutSnapshotCostNotPositive,
  ServingLayoutInputsUnread,
  ServingBackendSupportsTopology, ServingLiveQualified, ServingLiveUnqualified,
  ServingLiveStandingUnqualified, ServingLiveStandingQualified, ServingLiveRequalificationRequired,
  ServingAdmitted, ServingAdmissionRefused, ServingAdmission,
  serving_layout_derive, serving_layout_with_qualification, serving_configuration_identity, serving_replica_identity, serving_replica_admit,
  host_6ce85c_grant, host_6ce85c_independent_groups, strata_iq3_s_a16_profile, serving_context_ceiling_requirement, host_6ce85c_layout,
  srv4_grant, srv4_layer_split_groups, strata_srv4_layer_split_profile, srv4_layout,
  srv3_grant, srv3_layer_split_groups, strata_srv3_layer_split_profile, srv3_layout,
  srv3_routed_expert_artifact, srv4_routed_expert_artifact, serving_artifact_host_ram_charge,
  ServingSharedArtifact, ServingArtifactMedium, ArtifactOnDevice, ArtifactInHostRam, ArtifactOnDisk,
  ArtifactHeldPinned, ArtifactHeldEvictable,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn sl_gib(n: Nat) -> ByteSize {
  gibibyte_to_byte_size(g: gibibyte(count: n))
}

fn sl_grant_with(g: ServingResourceGrant, ram: ByteSize, devices: List<ServingDevice>) -> ServingResourceGrant {
  ServingResourceGrant {
    host: g.host,
    usable_ram: HostUsableRamMeasured { bytes: ram, provenance: "witness fixture" as NonEmptyStr },
    overhead: g.overhead, shared: g.shared, swap_bound: g.swap_bound, devices: devices, charging: g.charging,
  }
}

// The same grant with its swap bound replaced, so a witness can hand the derivation an Unread bound and watch it refuse
// rather than silently bill the missing swap as zero (the fail_closed headroom the h11 review left open).
fn sl_grant_swap(g: ServingResourceGrant, swap: ServingMemoryReading) -> ServingResourceGrant {
  ServingResourceGrant {
    host: g.host,
    usable_ram: g.usable_ram,
    overhead: g.overhead, shared: g.shared, swap_bound: swap, devices: g.devices, charging: g.charging,
  }
}

fn sl_device(name: String, vram: ByteSize) -> ServingDevice {
  ServingDevice {
    device: name as NonEmptyStr,
    board: decl_ref(module_path: "extdeps.gpu.nvidia", decl_name: "nvidia_rtx_pro_6000_workstation_board_catalog"),
    vram: ServingMemoryRead { bytes: vram, provenance: "witness fixture" as NonEmptyStr },
  }
}

fn sl_profile_with(b: ServingBackendProfile, most: Nat, floor: ServingMemoryReading) -> ServingBackendProfile {
  ServingBackendProfile {
    backend: b.backend, device_fixed_vram: b.device_fixed_vram, device_min_elastic_vram: b.device_min_elastic_vram,
    replica_base_ram: b.replica_base_ram, active_slots: b.active_slots, active_slot_ram: b.active_slot_ram,
    retention: b.retention, park_free_floor: floor, max_devices_with_retention: most, max_context: b.max_context,
  }
}

fn sl_profile_retaining_across(b: ServingBackendProfile, most: Nat) -> ServingBackendProfile {
  sl_profile_with(b: b, most: most, floor: b.park_free_floor)
}

// What a grant says the host may count on, whatever its epistemic arm. Unmeasured is zero, so a grant that lost its
// cap cannot satisfy the witness below by agreeing with an unread memory row.
fn sl_grant_ram(g: ServingResourceGrant) -> Nat {
  match g.usable_ram {
    HostUsableRamMeasured { bytes: b, provenance: _ } => byte_size_count(b: b)
    HostUsableRamConservativeLowerBound { bytes: b, basis: _ } => byte_size_count(b: b)
    HostUsableRamUnmeasured { reason: _ } => 0
  }
}

fn sl_replicas(r: ServingLayoutResult) -> List<ServingReplicaConfig> {
  match r {
    ServingLayoutConfigured { replicas: rs, unallocated_ram: _, evidence: _ } => rs
    ServingLayoutRefused { refusal: _ } => [] as List<ServingReplicaConfig>
  }
}

fn sl_admitted_total(r: ServingLayoutResult) -> Nat {
  fold(sl_replicas(r: r), init: 0, f: (acc, c) => acc + c.admitted_conversations)
}

fn sl_cap_total(r: ServingLayoutResult) -> Nat {
  fold(sl_replicas(r: r), init: 0, f: (acc, c) => acc + byte_size_count(b: c.memory_max))
}

fn sl_configuration(r: ServingLayoutResult) -> String {
  match r {
    ServingLayoutConfigured { replicas: _, unallocated_ram: _, evidence: e } => e.configuration
    ServingLayoutRefused { refusal: _ } => ""
  }
}

fn sl_refusal(r: ServingLayoutResult) -> ServingLayoutRefusal? {
  match r {
    ServingLayoutRefused { refusal: f } => Present { value: f }
    ServingLayoutConfigured { replicas: _, unallocated_ram: _, evidence: _ } => Absent
  }
}

// EVERY ADMITTED CONVERSATION CAN GROW TO THE CEILING, AND THE ENGINE WILL STILL PARK IT: each replica's
// retention budget holds its admitted count of maximum-context snapshots, and its cap holds that budget plus
// the park headroom the engine demands inside its own cgroup.
fn sl_all_grow_to_ceiling_under(r: ServingLayoutResult, b: ServingBackendProfile) -> Bool {
  let snapshot = byte_size_count(b: conversation_snapshot_bytes(cost: b.retention, context: serving_context_ceiling_requirement.max_context))
  let floor = match b.park_free_floor { ServingMemoryRead { bytes: f, provenance: _ } => byte_size_count(b: f)  _ => 0 }
  sl_replicas(r: r).all(c => c.admitted_conversations * snapshot <= byte_size_count(b: c.retention_budget)
    && byte_size_count(b: c.retention_budget) + floor < byte_size_count(b: c.memory_max))
}

fn sl_all_grow_to_ceiling(r: ServingLayoutResult) -> Bool {
  sl_all_grow_to_ceiling_under(r: r, b: strata_iq3_s_a16_profile)
}

// h11 AS GRANTED (A-prime): four independent replicas, five conversations guaranteed to the ceiling (2,1,1,1), the
// budget verdict Fits with its five assumptions named (three allowances, the extrapolated ceiling snapshot, the page charging), the backend supports the topology, and nothing is
// qualified live yet.
test fn witness_h11_layout_is_derived_and_fits_under_named_assumptions() -> Bool {
  match host_6ce85c_layout {
    ServingLayoutConfigured { replicas: rs, unallocated_ram: _, evidence: e } =>
      rs.length() == 4
        && rs.all(c => c.admitted_conversations >= 1 && c.active_slots == 1)
        && sl_admitted_total(r: host_6ce85c_layout) == 5
        && (match e.budget { ServingMemoryFits { spare: _ } => true  _ => false })
        && e.assumptions.length() == 5
        && (match e.backend { ServingBackendSupportsTopology => true  _ => false })
        && (match e.live { ServingLiveStandingUnqualified { obligation: _ } => true  _ => false })
        && sl_all_grow_to_ceiling(r: host_6ce85c_layout)
    _ => false
  }
}

// SMALLER AND LARGER GRANTS: 80 GiB cannot give six replicas one ceiling conversation each and refuses; 125 GiB
// (all eight DIMMs) admits more than today's 110.
test fn witness_grant_size_moves_admission_and_refuses_when_short() -> Bool {
  let small = serving_layout_derive(g: sl_grant_with(g: host_6ce85c_grant, ram: sl_gib(n: 80), devices: host_6ce85c_grant.devices), groups: host_6ce85c_independent_groups, b: strata_iq3_s_a16_profile, r: serving_context_ceiling_requirement)
  let large = serving_layout_derive(g: sl_grant_with(g: host_6ce85c_grant, ram: sl_gib(n: 125), devices: host_6ce85c_grant.devices), groups: host_6ce85c_independent_groups, b: strata_iq3_s_a16_profile, r: serving_context_ceiling_requirement)
  (match sl_refusal(r: small) { Present { value: ServingLayoutRamShort { needed: _, available: _ } } => true  _ => false })
    && sl_admitted_total(r: large) > sl_admitted_total(r: host_6ce85c_layout)
    && sl_all_grow_to_ceiling(r: large)
}

// HETEROGENEOUS DEVICES: an A16 GPU and a 96 GiB card as independent groups each get a replica; a 6 GiB
// device cannot hold the fixed VRAM plus the least expert cache and refuses, naming itself.
test fn witness_heterogeneous_devices_and_a_device_too_small() -> Bool {
  let a16 = sl_device(name: "a16-85", vram: mebibyte_to_byte_size(m: mebibyte(count: 15356)))
  let big = sl_device(name: "pro6000-0", vram: mebibyte_to_byte_size(m: mebibyte(count: 97887)))
  let tiny = sl_device(name: "tiny-0", vram: sl_gib(n: 6))
  let mixed = serving_layout_derive(g: sl_grant_with(g: host_6ce85c_grant, ram: sl_gib(n: 110), devices: [a16, big]),
    groups: [ServingDeviceGroup { name: "g-a16" as NonEmptyStr, devices: ["a16-85"] }, ServingDeviceGroup { name: "g-pro" as NonEmptyStr, devices: ["pro6000-0"] }],
    b: strata_iq3_s_a16_profile, r: serving_context_ceiling_requirement)
  let small = serving_layout_derive(g: sl_grant_with(g: host_6ce85c_grant, ram: sl_gib(n: 110), devices: [a16, tiny]),
    groups: [ServingDeviceGroup { name: "g-a16" as NonEmptyStr, devices: ["a16-85"] }, ServingDeviceGroup { name: "g-tiny" as NonEmptyStr, devices: ["tiny-0"] }],
    b: strata_iq3_s_a16_profile, r: serving_context_ceiling_requirement)
  sl_replicas(r: mixed).length() == 2
    && (match sl_refusal(r: small) { Present { value: ServingLayoutDeviceTooSmall { device: d, needed: _, has: _ } } => d == "tiny-0"  _ => false })
}

// A TWO-DEVICE GROUP IS REPRESENTED: Strata cannot retain across two devices and refuses that group by name;
// a backend that can retain across two runs it as one replica holding both devices.
test fn witness_two_device_group_is_modeled_and_backend_decides() -> Bool {
  let pair = [ServingDeviceGroup { name: "pair" as NonEmptyStr, devices: ["a16-85", "a16-87"] }]
  let strata = serving_layout_derive(g: host_6ce85c_grant, groups: pair, b: strata_iq3_s_a16_profile, r: serving_context_ceiling_requirement)
  let spanning = serving_layout_derive(g: host_6ce85c_grant, groups: pair, b: sl_profile_retaining_across(b: strata_iq3_s_a16_profile, most: 2), r: serving_context_ceiling_requirement)
  (match sl_refusal(r: strata) { Present { value: ServingLayoutBackendCannotRetain { group: gr, devices: n, most: m } } => gr == "pair" && n == 2 && m == 1  _ => false })
    && sl_replicas(r: spanning).length() == 1
    && sl_replicas(r: spanning).all(c => c.devices.length() == 2)
}

// THE TOPOLOGY MUST PARTITION GRANTED DEVICES, AND THE REQUIREMENT MAY NOT EXCEED THE BACKEND'S CEILING.
test fn witness_topology_and_ceiling_faults_refuse() -> Bool {
  let unknown = serving_layout_derive(g: host_6ce85c_grant, groups: [ServingDeviceGroup { name: "x" as NonEmptyStr, devices: ["a16-86"] }], b: strata_iq3_s_a16_profile, r: serving_context_ceiling_requirement)
  let twice = serving_layout_derive(g: host_6ce85c_grant, groups: [ServingDeviceGroup { name: "x" as NonEmptyStr, devices: ["a16-85"] }, ServingDeviceGroup { name: "y" as NonEmptyStr, devices: ["a16-85"] }], b: strata_iq3_s_a16_profile, r: serving_context_ceiling_requirement)
  let over = serving_layout_derive(g: host_6ce85c_grant, groups: host_6ce85c_independent_groups, b: strata_iq3_s_a16_profile, r: ServingRequirement { max_context: token_count(count: 300000), min_retained_per_replica: 1 })
  (match sl_refusal(r: unknown) { Present { value: ServingLayoutUnknownDevice { group: _, device: d } } => d == "a16-86"  _ => false })
    && (match sl_refusal(r: twice) { Present { value: ServingLayoutDeviceInTwoGroups { device: d } } => d == "a16-85"  _ => false })
    && (match sl_refusal(r: over) { Present { value: ServingLayoutContextAboveBackend { required: _, backend: _ } } => true  _ => false })
}

fn sl_admit_until_full(c: ServingReplicaConfig, admitted: Nat, steps: Nat) -> Nat {
  if steps == 0 { admitted } else {
    match serving_replica_admit(c: c, admitted: admitted) {
      ServingAdmitted { now_admitted: n } => sl_admit_until_full(c: c, admitted: n, steps: steps - 1)
      ServingAdmissionRefused { admitted: a, capacity: _ } => a
    }
  }
}

// ADMISSION TO THE CEILING AND ONE MORE: a replica admits exactly its capacity; the next admission is refused
// and the admitted count is what it was, so no existing conversation is displaced.
test fn witness_one_more_admission_is_refused_without_eviction() -> Bool {
  sl_replicas(r: host_6ce85c_layout).all(c =>
    sl_admit_until_full(c: c, admitted: 0, steps: 10) == c.admitted_conversations
      && (match serving_replica_admit(c: c, admitted: c.admitted_conversations) {
        ServingAdmissionRefused { admitted: a, capacity: k } => a == c.admitted_conversations && k == c.admitted_conversations
        ServingAdmitted { now_admitted: _ } => false
      }))
}

// A CHANGED DIMENSION REQUIRES REQUALIFICATION: a receipt bound to today's configuration qualifies it, and
// the same receipt read against the configuration a larger grant derives is not carried forward.
test fn witness_changed_grant_requires_requalification() -> Bool {
  let receipt = ServingLiveQualified { receipt: "witness receipt" as NonEmptyStr, configuration: sl_configuration(r: host_6ce85c_layout) }
  let same = serving_layout_with_qualification(result: serving_layout_derive(g: host_6ce85c_grant, groups: host_6ce85c_independent_groups, b: strata_iq3_s_a16_profile, r: serving_context_ceiling_requirement), q: receipt)
  let grown = serving_layout_with_qualification(result: serving_layout_derive(g: sl_grant_with(g: host_6ce85c_grant, ram: sl_gib(n: 125), devices: host_6ce85c_grant.devices), groups: host_6ce85c_independent_groups, b: strata_iq3_s_a16_profile, r: serving_context_ceiling_requirement), q: receipt)
  (match same { ServingLayoutConfigured { replicas: _, unallocated_ram: _, evidence: e } => match e.live { ServingLiveStandingQualified { receipt: _ } => true  _ => false }  _ => false })
    && (match grown { ServingLayoutConfigured { replicas: _, unallocated_ram: _, evidence: e } => match e.live { ServingLiveRequalificationRequired { qualified: _, derived: _ } => true  _ => false }  _ => false })
}

// THE PARK HEADROOM IS PART OF THE CAP: the same h11 grant with the engine's 512 MiB park floor read as zero
// admits more conversations than with it, so a layout that omitted the floor would promise retention the
// engine then refuses to park.
test fn witness_park_floor_is_charged_to_each_replica() -> Bool {
  let unfloored = serving_layout_derive(g: host_6ce85c_grant, groups: host_6ce85c_independent_groups,
    b: sl_profile_with(b: strata_iq3_s_a16_profile, most: 1, floor: ServingMemoryRead { bytes: byte_size(count: 0), provenance: "witness: no floor" as NonEmptyStr }),
    r: serving_context_ceiling_requirement)
  // The four replicas' freed floors (2048 MiB) plus the 3754 MiB left after every minimum still buy one 2990 MiB
  // snapshot and not two, so dropping the floor admits nothing more here; the charge shows in the caps, 512 MiB each.
  sl_admitted_total(r: unfloored) == sl_admitted_total(r: host_6ce85c_layout)
    && sl_cap_total(r: host_6ce85c_layout) == sl_cap_total(r: unfloored) + sl_replicas(r: host_6ce85c_layout).length() * byte_size_count(b: mebibyte_to_byte_size(m: mebibyte(count: 512)))
}

// THE CAP IS READ, NOT RETYPED (review 38602). Each grant's usable RAM is the engine memory row's own cap, so the
// layout cannot budget against a copy that a cap change left behind -- the failure this pins is the two figures
// disagreeing, which is exactly what happened when srv4's cap moved and a stale figure stayed in an obligation.
test fn witness_each_grants_cap_is_the_engine_rows_cap() -> Bool {
  sl_grant_ram(g: srv4_grant) == byte_size_count(b: serving_reading_bytes_or_zero(r: srv4_serving_engine_memory.memory_cap))
    && sl_grant_ram(g: srv3_grant) == byte_size_count(b: serving_reading_bytes_or_zero(r: srv3_strata_engine_memory.memory_cap))
    && 0 < sl_grant_ram(g: srv4_grant)
    && 0 < sl_grant_ram(g: srv3_grant)
}

// srv4 AS GRANTED TODAY: one replica holding both GPUs, EIGHT maximum-context conversations inside the 56 GiB
// MemoryHigh the engine's own guard now reads under --mmap-experts (was thirteen under the old 96 GiB slice with a
// private 52 GiB base; the cap came down and the base came down with it, and the retained set came down to eight),
// the budget Fits, and nothing qualified live yet. The same two-device group under h11's release, which cannot park
// across a split, refuses by name: spanning two GPUs is a backend fact, not a topology the layout grants on its own.
test fn witness_srv4_is_one_replica_across_two_gpus() -> Bool {
  let old_release = serving_layout_derive(g: srv4_grant, groups: srv4_layer_split_groups,
    b: sl_profile_retaining_across(b: strata_srv4_layer_split_profile, most: 1), r: serving_context_ceiling_requirement)
  (match srv4_layout {
    ServingLayoutConfigured { replicas: rs, unallocated_ram: _, evidence: e } =>
      rs.length() == 1
        && rs.all(c => c.devices.length() == 2 && c.admitted_conversations == 8 && byte_size_count(b: c.memory_max) <= byte_size_count(b: sl_gib(n: 56)))
        && (match e.budget { ServingMemoryFits { spare: _ } => true  _ => false })
        && (match e.live { ServingLiveStandingUnqualified { obligation: _ } => true  _ => false })
        && sl_all_grow_to_ceiling_under(r: srv4_layout, b: strata_srv4_layer_split_profile)
    _ => false
  })
    && (match sl_refusal(r: old_release) { Present { value: ServingLayoutBackendCannotRetain { group: gr, devices: n, most: m } } => gr == "gunbc-srv4-daily-engine" && n == 2 && m == 1  _ => false })
}

fn sl_replica_on(devices: List<NonEmptyStr>) -> ServingReplicaConfig {
  ServingReplicaConfig {
    group: "g" as NonEmptyStr, devices: devices, memory_max: sl_gib(n: 8), swap_max: ServingMemoryRead { bytes: sl_gib(n: 2), provenance: "witness fixture" as NonEmptyStr }, retention_budget: sl_gib(n: 3),
    admitted_conversations: 1, active_slots: 1, max_context: token_count(count: 229376),
  }
}

// A RECEIPT IS BOUND TO THE BACKEND TOO: the same h11 grant and topology under a profile that differs only in
// its named release derives the same caps and counts, and today's receipt is NOT carried onto it.
test fn witness_backend_change_with_equal_numbers_requires_requalification() -> Bool {
  let receipt = ServingLiveQualified { receipt: "witness receipt" as NonEmptyStr, configuration: sl_configuration(r: host_6ce85c_layout) }
  let b = strata_iq3_s_a16_profile
  let renamed = ServingBackendProfile {
    backend: "strata 0.1.49 qwen3.8-flash-next-iq3_s" as NonEmptyStr, device_fixed_vram: b.device_fixed_vram, device_min_elastic_vram: b.device_min_elastic_vram,
    replica_base_ram: b.replica_base_ram, active_slots: b.active_slots, active_slot_ram: b.active_slot_ram,
    retention: b.retention, park_free_floor: b.park_free_floor, max_devices_with_retention: b.max_devices_with_retention, max_context: b.max_context,
  }
  let other = serving_layout_with_qualification(result: serving_layout_derive(g: host_6ce85c_grant, groups: host_6ce85c_independent_groups, b: renamed, r: serving_context_ceiling_requirement), q: receipt)
  serving_configuration_identity(replicas: sl_replicas(r: other)) == serving_configuration_identity(replicas: sl_replicas(r: host_6ce85c_layout))
    && (match other { ServingLayoutConfigured { replicas: _, unallocated_ram: _, evidence: e } => match e.live { ServingLiveRequalificationRequired { qualified: _, derived: _ } => true  _ => false }  _ => false })
}

// IDENTITIES ARE FRAMED, NOT DELIMITED: one device named "a+b" and two devices "a" and "b" are different
// replicas, and so are their identities.
test fn witness_device_names_cannot_impersonate_a_delimiter() -> Bool {
  serving_replica_identity(c: sl_replica_on(devices: ["a+b"])) != serving_replica_identity(c: sl_replica_on(devices: ["a", "b"]))
    && serving_replica_identity(c: sl_replica_on(devices: ["a", "b"])) == serving_replica_identity(c: sl_replica_on(devices: ["a", "b"]))
}

// TWO GROUPS UNDER ONE NAME REFUSE, naming it, even when their devices are disjoint.
test fn witness_duplicate_group_names_refuse() -> Bool {
  let twice = serving_layout_derive(g: host_6ce85c_grant,
    groups: [ServingDeviceGroup { name: "x" as NonEmptyStr, devices: ["a16-85"] }, ServingDeviceGroup { name: "x" as NonEmptyStr, devices: ["a16-87"] }],
    b: strata_iq3_s_a16_profile, r: serving_context_ceiling_requirement)
  match sl_refusal(r: twice) { Present { value: ServingLayoutDuplicateGroupName { group: g } } => g == "x"  _ => false }
}

// A ZERO MINIMUM IS NOT A RETENTION-FREE LAYOUT: the allocator still deals leftover RAM as retained
// conversations, so the two-device group h11's release cannot retain across refuses under a minimum of zero
// exactly as under one, and a backend that does retain across two runs it with retention dealt.
test fn witness_zero_minimum_does_not_bypass_the_retention_limit() -> Bool {
  let pair = [ServingDeviceGroup { name: "pair" as NonEmptyStr, devices: ["a16-85", "a16-87"] }]
  let zero = ServingRequirement { max_context: serving_context_ceiling_requirement.max_context, min_retained_per_replica: 0 }
  let strata = serving_layout_derive(g: host_6ce85c_grant, groups: pair, b: strata_iq3_s_a16_profile, r: zero)
  let spanning = serving_layout_derive(g: host_6ce85c_grant, groups: pair, b: sl_profile_retaining_across(b: strata_iq3_s_a16_profile, most: 2), r: zero)
  (match sl_refusal(r: strata) { Present { value: ServingLayoutBackendCannotRetain { group: gr, devices: n, most: m } } => gr == "pair" && n == 2 && m == 1  _ => false })
    && sl_replicas(r: spanning).length() == 1
    && sl_admitted_total(r: spanning) > 0
}

fn sl_grant_devices(g: ServingResourceGrant, devices: List<ServingDevice>) -> ServingResourceGrant {
  ServingResourceGrant { host: g.host, usable_ram: g.usable_ram, overhead: g.overhead, shared: g.shared, swap_bound: g.swap_bound, devices: devices, charging: g.charging }
}

fn sl_with_selected_device(g: ServingResourceGrant, name: String, vram: ByteSize, other_board: Bool) -> ServingResourceGrant {
  sl_with_selected_board(g: g, name: name, vram: vram, board: if other_board { Present { value: decl_ref(module_path: "extdeps.gpu.nvidia", decl_name: "nvidia_rtx_pro_6000_workstation_board_catalog") } } else { Absent })
}

fn sl_with_selected_board(g: ServingResourceGrant, name: String, vram: ByteSize, board: DeclarationRef?) -> ServingResourceGrant {
  sl_grant_devices(g: g, devices: map(g.devices, d => if d.device == name {
    ServingDevice {
      device: d.device,
      board: match board { Present { value: b } => b  Absent => d.board },
      vram: ServingMemoryRead { bytes: vram, provenance: "witness fixture" as NonEmptyStr },
    }
  } else { d }))
}

// A RECEIPT IS BOUND TO THE SELECTED HARDWARE: a selected device whose VRAM reads 24,576 MiB instead of
// 15,356 MiB, or whose board is another one under the same name, passes the same per-device minimum and
// derives the same caps and counts, and today's receipt is NOT carried onto either.
test fn witness_selected_device_change_with_equal_numbers_requires_requalification() -> Bool {
  let receipt = ServingLiveQualified { receipt: "witness receipt" as NonEmptyStr, configuration: sl_configuration(r: host_6ce85c_layout) }
  let bigger = serving_layout_with_qualification(result: serving_layout_derive(g: sl_with_selected_device(g: host_6ce85c_grant, name: "a16-85", vram: mebibyte_to_byte_size(m: mebibyte(count: 24576)), other_board: false), groups: host_6ce85c_independent_groups, b: strata_iq3_s_a16_profile, r: serving_context_ceiling_requirement), q: receipt)
  let reboarded = serving_layout_with_qualification(result: serving_layout_derive(g: sl_with_selected_device(g: host_6ce85c_grant, name: "a16-85", vram: mebibyte_to_byte_size(m: mebibyte(count: 15356)), other_board: true), groups: host_6ce85c_independent_groups, b: strata_iq3_s_a16_profile, r: serving_context_ceiling_requirement), q: receipt)
  serving_configuration_identity(replicas: sl_replicas(r: bigger)) == serving_configuration_identity(replicas: sl_replicas(r: host_6ce85c_layout))
    && serving_configuration_identity(replicas: sl_replicas(r: reboarded)) == serving_configuration_identity(replicas: sl_replicas(r: host_6ce85c_layout))
    && (match bigger { ServingLayoutConfigured { replicas: _, unallocated_ram: _, evidence: e } => match e.live { ServingLiveRequalificationRequired { qualified: _, derived: _ } => true  _ => false }  _ => false })
    && (match reboarded { ServingLayoutConfigured { replicas: _, unallocated_ram: _, evidence: e } => match e.live { ServingLiveRequalificationRequired { qualified: _, derived: _ } => true  _ => false }  _ => false })
}

fn sl_live_after_board(board: DeclarationRef, receipt_board: DeclarationRef) -> ServingLayoutResult {
  let a16 = mebibyte_to_byte_size(m: mebibyte(count: 15356))
  let before = serving_layout_derive(g: sl_with_selected_board(g: host_6ce85c_grant, name: "a16-85", vram: a16, board: Present { value: receipt_board }), groups: host_6ce85c_independent_groups, b: strata_iq3_s_a16_profile, r: serving_context_ceiling_requirement)
  let receipt = ServingLiveQualified { receipt: "witness receipt" as NonEmptyStr, configuration: sl_configuration(r: before) }
  serving_layout_with_qualification(result: serving_layout_derive(g: sl_with_selected_board(g: host_6ce85c_grant, name: "a16-85", vram: a16, board: Present { value: board }), groups: host_6ce85c_independent_groups, b: strata_iq3_s_a16_profile, r: serving_context_ceiling_requirement), q: receipt)
}

// A BOARD IS IDENTIFIED BY ITS PARTS, NOT ITS DISPLAY KEY: module "m" with declaration "b::c", module "m::b"
// with declaration "c", and module "m" declaration "b" field "c" all display as "m::b::c", and are three
// different references. Their identities differ, and a receipt taken with one of them as a selected device's
// board is not carried onto another; the same reference keeps the receipt.
test fn witness_boards_with_one_display_key_are_different_qualifications() -> Bool {
  let inner = decl_ref(module_path: "m", decl_name: "b::c")
  let outer = decl_ref(module_path: "m::b", decl_name: "c")
  let field = decl_field_ref(module_path: "m", decl_name: "b", field_name: "c")
  declaration_ref_display_key(ref: inner) == declaration_ref_display_key(ref: outer)
    && declaration_ref_display_key(ref: inner) == declaration_ref_display_key(ref: field)
    && declaration_ref_identity(reference: inner).digest != declaration_ref_identity(reference: outer).digest
    && declaration_ref_identity(reference: inner).digest != declaration_ref_identity(reference: field).digest
    && declaration_ref_identity(reference: outer).digest != declaration_ref_identity(reference: field).digest
    && (match sl_live_after_board(board: outer, receipt_board: inner) { ServingLayoutConfigured { replicas: _, unallocated_ram: _, evidence: e } => match e.live { ServingLiveRequalificationRequired { qualified: _, derived: _ } => true  _ => false }  _ => false })
    && (match sl_live_after_board(board: field, receipt_board: inner) { ServingLayoutConfigured { replicas: _, unallocated_ram: _, evidence: e } => match e.live { ServingLiveRequalificationRequired { qualified: _, derived: _ } => true  _ => false }  _ => false })
    && (match sl_live_after_board(board: inner, receipt_board: inner) { ServingLayoutConfigured { replicas: _, unallocated_ram: _, evidence: e } => match e.live { ServingLiveStandingQualified { receipt: _ } => true  _ => false }  _ => false })
}

fn sl_profile_with_snapshot(b: ServingBackendProfile, fixed: ByteSize, per_token: ByteSize) -> ServingBackendProfile {
  ServingBackendProfile {
    backend: b.backend, device_fixed_vram: b.device_fixed_vram, device_min_elastic_vram: b.device_min_elastic_vram,
    replica_base_ram: b.replica_base_ram, active_slots: b.active_slots, active_slot_ram: b.active_slot_ram,
    retention: ConversationSnapshotCost { fixed: fixed, per_token: per_token, provenance: "witness fixture" as NonEmptyStr, observed_up_to: b.retention.observed_up_to },
    park_free_floor: b.park_free_floor, max_devices_with_retention: b.max_devices_with_retention, max_context: b.max_context,
  }
}

// A SNAPSHOT THAT COSTS NOTHING HAS NO CONVERSATION COUNT: the allocation divides the RAM it has left by one
// conversation's snapshot, so h11's grant under a profile whose retention cost is zero at the ceiling refuses
// with the cause, before any division. The same profile at one byte per token is an ordinary layout.
test fn witness_a_zero_snapshot_cost_refuses_before_allocation() -> Bool {
  let zero = serving_layout_derive(g: host_6ce85c_grant, groups: host_6ce85c_independent_groups,
    b: sl_profile_with_snapshot(b: strata_iq3_s_a16_profile, fixed: byte_size(count: 0), per_token: byte_size(count: 0)), r: serving_context_ceiling_requirement)
  let one = serving_layout_derive(g: host_6ce85c_grant, groups: host_6ce85c_independent_groups,
    b: sl_profile_with_snapshot(b: strata_iq3_s_a16_profile, fixed: byte_size(count: 0), per_token: byte_size(count: 1)), r: serving_context_ceiling_requirement)
  (match sl_refusal(r: zero) { Present { value: ServingLayoutSnapshotCostNotPositive { context: _ } } => true  _ => false })
    && sl_replicas(r: one).length() == 4
}

// ---- ONE PLACEMENT VOCABULARY FOR EVERY HOST, AND SRV3 AS GRANTED (2026-11-09)
//
// The rung helpers: what one medium of an artifact holds, what its floor is, and whether it is pinned.

fn sl_rung(a: ServingSharedArtifact, m: ServingArtifactMedium) -> ServingArtifactRung? {
  match m { ArtifactOnDevice => a.device, ArtifactInHostRam => a.host_ram, ArtifactOnDisk => a.disk }
}

fn sl_rung_bytes(a: ServingSharedArtifact, m: ServingArtifactMedium) -> Nat {
  match sl_rung(a: a, m: m) {
    Absent => 0
    Present { value: r } => byte_size_count(b: serving_reading_bytes_or_zero(r: r.bytes))
  }
}

// A pinned rung's floor is its whole (nothing can be squeezed out); an evictable rung's floor is the floor it
// states on its hold — the same reading the budget reserves.
fn sl_rung_floor(a: ServingSharedArtifact, m: ServingArtifactMedium) -> Nat {
  match sl_rung(a: a, m: m) {
    Absent => 0
    Present { value: r } => byte_size_count(b: match r.holds {
      ArtifactHeldPinned { mechanism: _ } => serving_reading_bytes_or_zero(r: r.bytes)
      ArtifactHeldEvictable { bound_by: _, floor: f } => serving_reading_bytes_or_zero(r: f)
    })
  }
}

// At most one rung per medium exists, so a rung is present (1) or absent (0) — never more than one.
fn sl_rung_count(a: ServingSharedArtifact, m: ServingArtifactMedium) -> Nat {
  match sl_rung(a: a, m: m) { Absent => 0, Present { value: _ } => 1 }
}

// True when the medium holds a rung and that rung is pinned (absent means false: nothing is reserved there).
fn sl_rung_pinned(a: ServingSharedArtifact, m: ServingArtifactMedium) -> Bool {
  match sl_rung(a: a, m: m) {
    Absent => false
    Present { value: r } => match r.holds {
      ArtifactHeldPinned { mechanism: _ } => true
      ArtifactHeldEvictable { bound_by: _, floor: _ } => false
    }
  }
}

// THE SAME ARTIFACT KIND, CHARGED TWO WAYS, WHICH IS THE WHOLE POINT OF THE HOLD. h11's experts are mlocked: the
// host reserves them WHOLE, exactly as it did before rungs existed (that equality against the host's own reading
// of the locked copy is the regression that proves h11's charge moved not at all). srv3's are private anonymous
// memory: nothing can reclaim them, so they too are charged whole. srv4's are a page cache under a cgroup cap:
// they grow into whatever the cap leaves and are reclaimed first, so the host reserves only their FLOOR —
// strictly less than the 13.2 GiB resident at load, which is the figure an unfocused model would have reserved.
test fn witness_pinned_rungs_reserve_whole_and_evictable_ones_their_floor() -> Bool {
  // h11: the charge IS the lock service's resident copy, unchanged.
  fold(host_6ce85c_grant.shared, init: 0, f: (acc, a) => acc + byte_size_count(b: serving_artifact_host_ram_charge(a: a)))
    == byte_size_count(b: host_6ce85c_serving_memory_observed.shared_resident)
    && sl_rung_pinned(a: srv3_routed_expert_artifact, m: ArtifactInHostRam)
  // srv3: pinned, so the charge is the arena's whole 46.84 GiB.
    && byte_size_count(b: serving_artifact_host_ram_charge(a: srv3_routed_expert_artifact))
      == sl_rung_bytes(a: srv3_routed_expert_artifact, m: ArtifactInHostRam)
      && sl_rung_bytes(a: srv3_routed_expert_artifact, m: ArtifactInHostRam) == byte_size_count(b: mebibyte_to_byte_size(m: mebibyte(count: 47964)))
  // srv4: evictable, so the charge is its 8 GiB floor and NOT its 13.2 GiB resident figure.
    && !sl_rung_pinned(a: srv4_routed_expert_artifact, m: ArtifactInHostRam)
    && byte_size_count(b: serving_artifact_host_ram_charge(a: srv4_routed_expert_artifact))
      == sl_rung_floor(a: srv4_routed_expert_artifact, m: ArtifactInHostRam)
      && sl_rung_floor(a: srv4_routed_expert_artifact, m: ArtifactInHostRam) == byte_size_count(b: sl_gib(n: 22))
      && sl_rung_bytes(a: srv4_routed_expert_artifact, m: ArtifactInHostRam) == byte_size_count(b: mebibyte_to_byte_size(m: mebibyte(count: 24576)))
      && byte_size_count(b: serving_artifact_host_ram_charge(a: srv4_routed_expert_artifact)) < sl_rung_bytes(a: srv4_routed_expert_artifact, m: ArtifactInHostRam)
  // The disk rungs hold the file on both hosts; the device rungs are caches, not reservations.
    && sl_rung_pinned(a: srv4_routed_expert_artifact, m: ArtifactOnDisk)
    && sl_rung_pinned(a: srv3_routed_expert_artifact, m: ArtifactOnDisk)
    && !sl_rung_pinned(a: srv4_routed_expert_artifact, m: ArtifactOnDevice)
}

// THE RUNGS ARE ONE ARTIFACT, NOT THREE FACTS: srv4's engine planned "46.8 GiB experts, 22.9 GiB in the GPU
// caches, 0.0 GiB RAM copy, file tier 24.0 GiB", so the card rung and the disk rung TOGETHER are the file (each
// figure rounded to 0.1 GiB, hence the one-gibibyte tolerance), and the host-RAM rung is the part of the disk rung
// the page cache is holding — never more than it. A wrong figure in any rung breaks one of these.
test fn witness_srv4_expert_rungs_partition_the_file_they_came_from() -> Bool {
  let a = srv4_routed_expert_artifact
  let whole = byte_size_count(b: a.bytes)
  let on_cards = sl_rung_bytes(a: a, m: ArtifactOnDevice)
  let on_disk = sl_rung_bytes(a: a, m: ArtifactOnDisk)
  let in_ram = sl_rung_bytes(a: a, m: ArtifactInHostRam)
  let one_gib = byte_size_count(b: sl_gib(n: 1))
  sl_rung_count(a: a, m: ArtifactOnDevice) == 1 && sl_rung_count(a: a, m: ArtifactInHostRam) == 1 && sl_rung_count(a: a, m: ArtifactOnDisk) == 1
    && on_cards + on_disk >= whole && on_cards + on_disk <= whole + one_gib
    && in_ram <= on_disk && in_ram > 0
}

// THE ARITHMETIC THAT MAKES SRV3'S ASSUMED BASE A STATED BET AND NOT A GUESS: the engine's own memory plus its
// pinned arena re-sum to the 52 GiB its pre-mmap twin on srv4 was READ at (2026-10-30) — base 5284 MiB + arena
// 46.84 GiB = 52 GiB exactly. When memory.current is read on srv3, this is the figure it has to land near; the
// day it does not, the assumption is wrong and this test says so before the grant is trusted.
test fn witness_srv3_base_and_its_pinned_arena_resum_to_the_read_of_the_same_shape() -> Bool {
  byte_size_count(b: serving_reading_bytes_or_zero(r: srv3_strata_engine_memory.base))
    + sl_rung_bytes(a: srv3_routed_expert_artifact, m: ArtifactInHostRam)
    == byte_size_count(b: mebibyte_to_byte_size(m: mebibyte(count: 53248)))
}

// SRV3 AS GRANTED, BY THE SAME DERIVATION srv4 USES: one replica holding both cards inside the 110 GiB the
// engine's own guard reads, its live --batch 8 as the one batch input, the budget Fits, nothing qualified live.
// Its group is named for the unit that runs it, which is also the group its router naming joins on. Fifteen
// conversations is what the 64 GiB RAM conversation cache holds at srv3's declared snapshot cost inside the RAM the
// pinned 46.84 GiB expert arena leaves the guard; that cache budget is a CEILING the engine may spend, not a
// reservation this layout made, so the figure is exactly as good as the memory.current reading the live obligation
// asks for. A layout that dropped the arena charge would admit far more here, which is what makes the pin bite.
test fn witness_srv3_is_one_replica_across_two_gpus_in_its_own_slice() -> Bool {
  sl_replicas(r: srv3_layout).length() == 1
    && (match srv3_layout {
      ServingLayoutConfigured { replicas: rs, unallocated_ram: _, evidence: e } =>
        rs.all(c => c.group == "strata-pool" && c.devices.length() == 2 && c.active_slots == 8
          && c.admitted_conversations == 15
          && byte_size_count(b: c.memory_max) <= byte_size_count(b: sl_gib(n: 110)))
        && (match e.budget { ServingMemoryFits { spare: _ } => true  _ => false })
        && (match e.live { ServingLiveStandingUnqualified { obligation: _ } => true  _ => false })
        && sl_all_grow_to_ceiling_under(r: srv3_layout, b: strata_srv3_layer_split_profile)
      _ => false
    })
    && sl_replicas(r: srv3_layout).all(c => byte_size_count(b: serving_reading_bytes_or_zero(r: strata_srv3_layer_split_profile.replica_base_ram)) + byte_size_count(b: serving_reading_bytes_or_zero(r: strata_srv3_layer_split_profile.park_free_floor)) < byte_size_count(b: c.memory_max))
}


// THE SWAP BOUND TRAVELS AS WHAT IT IS (review 92384). Each host's swap limit has one home -- its engine row in
// gunbc.serving.serving_host_memory -- and the grant carries that reading with its label intact. srv3's slice has
// never had MemorySwapMax read, so its grant says UNREAD; srv4's is its own read of MemorySwapMax=0; h11's is the
// operator's declared 2 GiB, labelled the decision it is. A fabricated 0 dressed as a measurement fails all three arms.
test fn witness_each_grants_swap_bound_keeps_its_own_label() -> Bool {
  // srv3's OWN slice limit is unread (its engine row says so, srv3_strata_engine_memory.swap_cap), so the grant
  // may not present a number as measured -- it carries the fleet no-swap convention as Assumed(0), labelled.
  match srv3_grant.swap_bound {
    ServingMemoryAssumed { bytes: b, reason: _ } => byte_size_count(b: b) == 0
    ServingMemoryRead { bytes: _, provenance: _ } => false
    ServingMemoryUnread { reason: _ } => false
  }
    && match srv4_grant.swap_bound {
         ServingMemoryRead { bytes: b, provenance: _ } => byte_size_count(b: b) == 0
         ServingMemoryUnread { reason: _ } => false
         ServingMemoryAssumed { bytes: _, reason: _ } => false
       }
    && match host_6ce85c_grant.swap_bound {
         ServingMemoryAssumed { bytes: b, reason: _ } => byte_size_count(b: b) == byte_size_count(b: sl_gib(n: 2))
         ServingMemoryRead { bytes: _, provenance: _ } => false
         ServingMemoryUnread { reason: _ } => false
       }
}

// THE LABEL SURVIVES DERIVATION (the second half of review 92384): before, the layout wrapped the grant's byte in
// ServingMemoryRead { provenance: "the grant's swap bound" }, so an unread srv3 limit emerged as a reading. The
// replica config now carries the grant's reading verbatim -- srv3's derives UNREAD, never a Read, and the host's
// memory verdict surfaces it as undetermined instead of silently fitting.
test fn witness_srv3_derivation_carries_the_grants_swap_label() -> Bool {
  match serving_layout_derive(g: srv3_grant, groups: srv3_layer_split_groups, b: strata_srv3_layer_split_profile, r: serving_context_ceiling_requirement) {
    ServingLayoutConfigured { replicas: rs, unallocated_ram: _, evidence: _ } =>
      match rs |> first() {
        Present { value: c } => match c.swap_max {
          // the grant's Assumed(0) reaches the config STILL Assumed -- the bug was the derivation re-wrapping it
          // as ServingMemoryRead { provenance: "the grant's swap bound" }, dressing an unknown as a measurement.
          ServingMemoryAssumed { bytes: b, reason: _ } => byte_size_count(b: b) == 0
          ServingMemoryRead { bytes: _, provenance: _ } => false
          ServingMemoryUnread { reason: _ } => false
        }
        Absent => false
      }
    ServingLayoutRefused { refusal: _ } => false
  }
}

// THE SWAP BOUND IS GUARDED LIKE EVERY OTHER CHARGED READING (review 92400). serving_reading_bytes_or_zero contributes
// nothing for an Unread reading, and the identity frame plus the host-memory verdict charge the swap through it -- so an
// Unread swap bound would widen the budget by its true bytes without a word (gunbc.design_argument::fail_closed: a
// silent widen is a hard reject). serving_layout_missing therefore lists the swap bound too, so an unread one is refused.
// Discriminating: with the guard absent the very same grant derives Configured (the swap would not be listed missing),
// so refuses would be false and this witness fails. The real srv3 grant carries its bound as an Assumed reading (a
// declared bet, not a missing reading), so srv3_layout still derives -- the guard refuses only what was never read.
test fn witness_unread_swap_bound_refuses_the_layout() -> Bool {
  let unread = ServingMemoryUnread { reason: "strata.slice MemorySwapMax has not been read" as NonEmptyStr }
  let refused = serving_layout_derive(
    g: sl_grant_swap(g: srv3_grant, swap: unread), groups: srv3_layer_split_groups,
    b: strata_srv3_layer_split_profile, r: serving_context_ceiling_requirement)
  let refuses = match refused {
    ServingLayoutRefused { refusal: ServingLayoutInputsUnread { missing: m } } => 0 < count(m)
    _ => false
  }
  let still_fits = match srv3_layout {
    ServingLayoutConfigured { replicas: rs, unallocated_ram: _, evidence: _ } => 0 < rs.length()
    ServingLayoutRefused { refusal: _ } => false
  }
  refuses && still_fits
}
