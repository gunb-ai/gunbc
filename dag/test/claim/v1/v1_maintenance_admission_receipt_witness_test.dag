module test.claim.v1.v1_maintenance_admission_receipt_witness_test

import std.types { Bool, String, List, NonEmptyStr }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import gunbc.cutover_receipt {
  CutoverReceipt, CutoverReading, ReceiptUnrecorded, ReceiptRecorded,
  cutover_receipt_is_recorded, cutover_receipt_has_label_reading, cutover_receipt_names_runs,
  LabelReading, Purpose, Control, RefusedClass,
  v1_maintenance_first_admission_receipt
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// ACCEPTANCE ORACLE FOR v1-maintenance-admission-first-purpose-receipt, RED BY DESIGN. PINNED AT LAUNCH.
// Authority: gunbc.v1_maintenance_standing v1_seed_standing (admission is by PURPOSE).

// RED TODAY: the first admitted v1 change has a receipt naming the v2 self-host purpose it served
// and a control that resolves.
test fn the_first_admission_receipt_cites_a_resolving_control() -> Bool {
  cutover_receipt_is_recorded(r: v1_maintenance_first_admission_receipt)
    && cutover_receipt_has_label_reading(r: v1_maintenance_first_admission_receipt, kind: Purpose)
    && cutover_receipt_has_label_reading(r: v1_maintenance_first_admission_receipt, kind: Control)
}

// CONTROL: a receipt that names a refused class (growth for its own sake) refuses.
test fn a_receipt_naming_a_refused_class_refuses() -> Bool {
  !cutover_receipt_has_label_reading(r: ReceiptRecorded {
    run_ids: ["r"], host: "h", readings: [LabelReading { kind: RefusedClass, label: "growth_for_its_own_sake" as NonEmptyStr }]
  }, kind: Purpose)
}
