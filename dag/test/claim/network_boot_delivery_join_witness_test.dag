// Kernel and root match; the read-back initrd is a different object. The refusal names the
// initrd, not the kernel or root that did match.
test fn single_bundle_digest_mismatch_names_the_member() -> Bool {
  let wrong_initrd = BootBundleAvailable {
    receipt: bundle_receipt(
      kernel: content_hash_of_value(value: "kernel-fixture"),
      initrd: content_hash_of_value(value: "initrd-stale-object"),
      root: artifact,
    ),
  }
  match join_network_boot_delivery(inputs: inputs_varying(trust: production_trust(), site: site_ok(), bundle: wrong_initrd)) {
    NetworkBootDeliveryManifestRefused { cause: ManifestJoinBundleDigestDisagrees { member: BootBundleInitrd } } => true
    NetworkBootDeliveryManifestRefused { cause: _ } => false
    NetworkBootDeliveryEstablished { evidence: _ } => false
    NetworkBootDeliveryUnestablished { missing: _ } => false
    NetworkBootDeliveryEvidenceRefused { axis: _, observation: _ } => false
    NetworkBootDeliveryArchitectureRefused { cause: _ } => false
    NetworkBootDeliveryClientModeRefused { arch: _ } => false
    NetworkBootDeliveryTargetMismatch { axis: _ } => false
    NetworkBootDeliverySiteUnestablished => false
    NetworkBootDeliverySiteMismatch { axis: _, expected: _, observed: _ } => false
    NetworkBootDeliveryTrustUnestablished => false
    NetworkBootDeliveryTrustRefused { cause: _ } => false
    NetworkBootDeliveryRouteMismatch { axis: _, expected: _, observed: _ } => false
  }
}

fn join_census_has_frontier_subject(row: FrontierRow) -> Bool {
  any(census_closure_frontier_rows(), c => frontier_subject_eq(a: c.subject, b: row.subject))
}

test fn join_frontier_rows_well_formed() -> Bool {
  frontier_rows_well_formed(rows: network_boot_delivery_frontier_rows)
}

test fn join_frontier_rows_are_in_the_census() -> Bool {
  all(network_boot_delivery_frontier_rows, row => join_census_has_frontier_subject(row: row))
}
