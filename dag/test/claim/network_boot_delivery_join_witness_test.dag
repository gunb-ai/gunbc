test fn controlled_network_is_not_production_trust() -> Bool {
  match controlled_trust() {
    ControlledNetworkBootstrap { evidence: e } =>
      (e.observation.decl_name as String) == (obs.decl_name as String)
      && match production_trust() {
        ProductionTrustedBootstrap { grounds: g } =>
          match g {
            FirmwareHttpsTrusted { firmware_https: _ } => true
            SecureBootChainloaderTrusted { secure_boot_chainloader: _ } => false
            FirmwareHttpsAndSecureBootTrusted { firmware_https: _, secure_boot_chainloader: _ } => false
          }
        ControlledNetworkBootstrap { evidence: _ } => false
        BootstrapTrustUnestablished => false
      }
    ProductionTrustedBootstrap { grounds: _ } => false
    BootstrapTrustUnestablished => false
  }
}

test fn neither_trust_input_is_unestablished() -> Bool {
  match bootstrap_trust_standing(
    firmware_https: Absent,
    secure_boot_chainloader: Absent,
    isolated_onboarding_network: Absent,
  ) {
    BootstrapTrustUnestablished => true
    ProductionTrustedBootstrap { grounds: _ } => false
    ControlledNetworkBootstrap { evidence: _ } => false
  }
}

test fn firmware_https_is_production_even_on_isolated_network() -> Bool {
  match bootstrap_trust_standing(
    firmware_https: Present { value: https_trust_obs() },
    secure_boot_chainloader: Absent,
    isolated_onboarding_network: Present { value: controlled_trust_obs() },
  ) {
    ProductionTrustedBootstrap { grounds: _ } => true
    ControlledNetworkBootstrap { evidence: _ } => false
    BootstrapTrustUnestablished => false
  }
}

test fn both_grounds_present_names_both() -> Bool {
  match bootstrap_trust_standing(
    firmware_https: Present { value: https_trust_obs() },
    secure_boot_chainloader: Present { value: secure_boot_trust_obs() },
    isolated_onboarding_network: Absent,
  ) {
    ProductionTrustedBootstrap { grounds: g } =>
      match g {
        FirmwareHttpsAndSecureBootTrusted { firmware_https: h, secure_boot_chainloader: sb } =>
          (h.observation.decl_name as String) == (obs.decl_name as String)
          && (sb.observation.decl_name as String) == (obs.decl_name as String)
        FirmwareHttpsTrusted { firmware_https: _ } => false
        SecureBootChainloaderTrusted { secure_boot_chainloader: _ } => false
      }
    ControlledNetworkBootstrap { evidence: _ } => false
    BootstrapTrustUnestablished => false
  }
}

test fn secure_boot_ground_is_not_https_ground() -> Bool {
  match bootstrap_trust_standing(
    firmware_https: Absent,
    secure_boot_chainloader: Present { value: secure_boot_trust_obs() },
    isolated_onboarding_network: Absent,
  ) {
    ProductionTrustedBootstrap { grounds: g } =>
      match g {
        SecureBootChainloaderTrusted { secure_boot_chainloader: _ } => true
        FirmwareHttpsTrusted { firmware_https: _ } => false
        FirmwareHttpsAndSecureBootTrusted { firmware_https: _, secure_boot_chainloader: _ } => false
      }
    ControlledNetworkBootstrap { evidence: _ } => false
    BootstrapTrustUnestablished => false
  }
}

