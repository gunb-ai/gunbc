  match join_network_boot_delivery(inputs: inputs) {
    NetworkBootDeliveryManifestRefused { cause: ManifestVerificationRefused { class: ManifestVerificationMac, observation: o } } =>
      (o.decl_name as String) == (obs.decl_name as String)
    NetworkBootDeliveryManifestRefused { cause: _ } => false
    NetworkBootDeliverySiteUnestablished => false
