test fn controlled_network_is_not_production_trust() -> Bool {
  match controlled_trust() {
    ControlledNetworkBootstrap { evidence: e } =>
      (e.observation.decl_name as String) == (obs.decl_name as String)
      && match production_trust() {
        ProductionTrustedBootstrap { firmware_https: h, secure_boot_chainloader: _ } =>
          match h {
            Present { value: _ } => true
            Absent => false
          }
        ControlledNetworkBootstrap { evidence: _ } => false
        BootstrapTrustUnestablished => false
      }
    ProductionTrustedBootstrap { firmware_https: _, secure_boot_chainloader: _ } => false
    BootstrapTrustUnestablished => false
  }
}

test fn neither_trust_input_is_unestablished() -> Bool {
  match bootstrap_trust_standing(
    firmware_https: Absent,
    secure_boot_chainloader: Absent,
    isolated_onboarding_network: Absent,
  ) {
    BootstrapTrustUnestablished => true
    ProductionTrustedBootstrap { firmware_https: _, secure_boot_chainloader: _ } => false
    ControlledNetworkBootstrap { evidence: _ } => false
  }
}

test fn firmware_https_is_production_even_on_isolated_network() -> Bool {
  match bootstrap_trust_standing(
    firmware_https: Present { value: trust_obs() },
    secure_boot_chainloader: Absent,
    isolated_onboarding_network: Present { value: trust_obs() },
  ) {
    ProductionTrustedBootstrap { firmware_https: _, secure_boot_chainloader: _ } => true
    ControlledNetworkBootstrap { evidence: _ } => false
    BootstrapTrustUnestablished => false
  }
}

test fn secure_boot_ground_is_not_https_ground() -> Bool {
  match bootstrap_trust_standing(
    firmware_https: Absent,
    secure_boot_chainloader: Present { value: trust_obs() },
    isolated_onboarding_network: Absent,
  ) {
    ProductionTrustedBootstrap { firmware_https: h, secure_boot_chainloader: sb } =>
      match h {
        Absent =>
          match sb {
            Present { value: _ } => true
            Absent => false
          }
        Present { value: _ } => false
      }
    ControlledNetworkBootstrap { evidence: _ } => false
    BootstrapTrustUnestablished => false
  }
}

