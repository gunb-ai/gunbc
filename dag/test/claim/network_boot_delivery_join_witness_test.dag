    trust: production_trust(),
    fleet: fleet_ok(),
    site: site_ok(),
    client: client_ok(),
    boot_control: BootControlObserved {
      receipt: NetworkBootBootControlReceipt {
        target: other_target,
        observation: obs,
        observed_at: 1788000000000,
      },
    },
    manifest: manifest_ok(),
  }
  match join_network_boot_delivery(inputs: inputs) {
    NetworkBootDeliveryTargetMismatch { axis: axis } => axis == NetworkBootBootSourceOverride
    NetworkBootDeliveryEstablished { evidence: _ } => false
    NetworkBootDeliveryUnestablished { missing: _ } => false
    NetworkBootDeliveryEvidenceRefused { axis: _, observation: _ } => false
    NetworkBootDeliveryArchitectureRefused { cause: _ } => false
    NetworkBootDeliveryClientModeRefused { arch: _ } => false
    NetworkBootDeliveryManifestRefused { cause: _ } => false
    NetworkBootDeliverySiteUnestablished => false
    NetworkBootDeliverySiteMismatch { axis: _, expected: _, observed: _ } => false
    NetworkBootDeliveryTrustUnestablished => false
    NetworkBootDeliveryTrustRefused { cause: _ } => false
    NetworkBootDeliveryRouteMismatch { axis: _, expected: _, observed: _ } => false
  }
}

test fn manifest_for_other_unit_unestablishes_artifacts() -> Bool {
  let inputs = NetworkBootJoinInputs {
    target: target,
    expected_site: onboarding_site,
    bundle: bundle_ok(),
    artifact_digest: artifact,
    trust: production_trust(),
    fleet: fleet_ok(),
    site: site_ok(),
    client: client_ok(),
    boot_control: control_ok(),
    manifest: SignedBootManifestVerified {
      identity: SignedBootManifestIdentity {
        target_unit: "BRD-OTHER-UNIT" as UnitKey,
        attempt_id: attempt,
        nonce: "nonce-0a",
        architecture: Aarch64,
        boot_mode: UefiPxe { tftp_root: edge_tftp },
        chainloader_digest: content_hash_of_value(value: "ipxe-aarch64-fixture"),
        kernel_digest: content_hash_of_value(value: "kernel-fixture"),
        initrd_digest: content_hash_of_value(value: "initrd-fixture"),
        root_digest: artifact,
        kernel_cmdline: "console=ttyAMA0",
        not_before: 1788000000000,
        expiry: 1788003600000,
        signing_key_identity: "boot-manifest-key-0",
        callback_identity: "intake-callback-0",
      },
      observation: obs,
      observed_at: 1788000000000,
    },
  }
  let wrong_unit = match join_network_boot_delivery(inputs: inputs) {
    NetworkBootDeliveryManifestRefused { cause: ManifestJoinWrongTarget } => true
    NetworkBootDeliveryManifestRefused { cause: _ } => false
    NetworkBootDeliverySiteUnestablished => false
    NetworkBootDeliverySiteMismatch { axis: _, expected: _, observed: _ } => false
    NetworkBootDeliveryTrustUnestablished => false
    NetworkBootDeliveryTrustRefused { cause: _ } => false
    NetworkBootDeliveryRouteMismatch { axis: _, expected: _, observed: _ } => false
    NetworkBootDeliveryEstablished { evidence: _ } => false
    NetworkBootDeliveryUnestablished { missing: _ } => false
    NetworkBootDeliveryEvidenceRefused { axis: _, observation: _ } => false
    NetworkBootDeliveryArchitectureRefused { cause: _ } => false
    NetworkBootDeliveryClientModeRefused { arch: _ } => false
    NetworkBootDeliveryTargetMismatch { axis: _ } => false
  }
  let absent_inputs = NetworkBootJoinInputs {
    target: target,
    expected_site: onboarding_site,
    bundle: bundle_ok(),
    artifact_digest: artifact,
    trust: production_trust(),
    fleet: fleet_ok(),
    site: site_ok(),
    client: client_ok(),
    boot_control: control_ok(),
    manifest: SignedBootManifestAbsent,
  }
  let absent = match join_network_boot_delivery(inputs: absent_inputs) {
    NetworkBootDeliveryUnestablished { missing: m } => m |> any(x => x == NetworkBootBootArtifacts)
    NetworkBootDeliveryEstablished { evidence: _ } => false
    NetworkBootDeliveryEvidenceRefused { axis: _, observation: _ } => false
    NetworkBootDeliveryArchitectureRefused { cause: _ } => false
    NetworkBootDeliveryClientModeRefused { arch: _ } => false
    NetworkBootDeliveryTargetMismatch { axis: _ } => false
    NetworkBootDeliveryManifestRefused { cause: _ } => false
    NetworkBootDeliverySiteUnestablished => false
    NetworkBootDeliverySiteMismatch { axis: _, expected: _, observed: _ } => false
    NetworkBootDeliveryTrustUnestablished => false
    NetworkBootDeliveryTrustRefused { cause: _ } => false
    NetworkBootDeliveryRouteMismatch { axis: _, expected: _, observed: _ } => false
  }
  wrong_unit && absent
}

test fn unsigned_manifest_identity_does_not_establish_artifacts() -> Bool {
  let inputs = NetworkBootJoinInputs {
    target: target,
    expected_site: onboarding_site,
    bundle: bundle_ok(),
    artifact_digest: artifact,
    trust: production_trust(),
    fleet: fleet_ok(),
    site: site_ok(),
    client: client_ok(),
    boot_control: control_ok(),
    manifest: SignedBootManifestIdentified {
      identity: SignedBootManifestIdentity {
        target_unit: unit,
        attempt_id: attempt,
        nonce: "nonce-0a",
