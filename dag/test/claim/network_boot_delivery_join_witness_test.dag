// The edge agrees with the expected site and the client observation does not: the mismatch names the
// client axis, not the edge one (review 67939: one variant, two disagreements, now told apart).
test fn foreign_client_observation_site_names_the_client_axis() -> Bool {
  let inputs = NetworkBootJoinInputs {
    target: target,
    expected_site: onboarding_site,
    bundle: bundle_ok(),
    artifact_digest: artifact,
    trust: production_trust(),
    fleet: fleet_ok(),
    site: site_ok(),
    client: ClientBootModeObserved {
      receipt: ObservedClientBootModeReceipt {
        target: target,
        site: foreign_site,
        client: ObservedDhcpPxeClient {
          vendor_class: "PXEClient:Arch:00011:UNDI:003016",
          arch: UefiArm64,
        },
        observation: obs,
        observed_at: 1788000000000,
      },
    },
    boot_control: control_ok(),
    manifest: manifest_ok(),
  }
  match join_network_boot_delivery(inputs: inputs) {
    NetworkBootDeliverySiteMismatch { axis: ClientObservationSite, expected: exp, observed: obs_site } =>
      (exp as String) == (onboarding_site as String) && (obs_site as String) == (foreign_site as String)
    NetworkBootDeliverySiteMismatch { axis: SiteEdgeSite, expected: _, observed: _ } => false
    NetworkBootDeliveryEstablished { evidence: _ } => false
    NetworkBootDeliveryUnestablished { missing: _ } => false
    NetworkBootDeliveryEvidenceRefused { axis: _, observation: _ } => false
    NetworkBootDeliveryArchitectureRefused { cause: _ } => false
    NetworkBootDeliveryClientModeRefused { arch: _ } => false
    NetworkBootDeliveryTargetMismatch { axis: _ } => false
    NetworkBootDeliveryManifestRefused { cause: _ } => false
    NetworkBootDeliverySiteUnestablished => false
    NetworkBootDeliveryTrustUnestablished => false
    NetworkBootDeliveryTrustRefused { cause: _ } => false
    NetworkBootDeliveryRouteMismatch { axis: _, expected: _, observed: _ } => false
  }
}

// The complete inputs with the trust, site and bundle axes supplied, so each witness below
// states only the one input it varies.
fn inputs_varying(trust: BootstrapTrustStanding, site: SitePxeEdgeStanding, bundle: BootBundleAvailabilityStanding) -> NetworkBootJoinInputs {
  NetworkBootJoinInputs {
    target: target,
    expected_site: onboarding_site,
    bundle: bundle,
    artifact_digest: artifact,
    trust: trust,
    fleet: fleet_ok(),
    site: site,
    client: client_ok(),
    boot_control: control_ok(),
    manifest: manifest_ok(),
  }
}

// An established edge that served its chainloader from `tftp` and reached `broker` and `origin`.
fn site_reaching(broker: Uri, origin: Uri, tftp: Uri) -> SitePxeEdgeStanding {
  site_pxe_edge_standing(
    edge: SitePxeEdge {
      site: onboarding_site,
      admitted_architectures: first_slice_admitted_architectures,
      discovery: SiteAnsweredDhcp { direction: NativeDhcpBootOptions },
      bootstrap_transport: ArchitectureChainloader {
        architecture: Aarch64,
        filename_hint: DhcpFilenameHint { filename: "snponly.efi" },
        chainloader_digest: chainloader_fixture,
        tftp_root: tftp,
      },
      global_endpoint_reachability: GlobalHttpsEndpointReachable {
        broker_endpoint: broker,
        artifact_origin: origin,
        observation: obs,
        observed_at: 1788000000000,
      },
    },
    client_architecture: Aarch64,
    observation: obs,
    observed_at: 1788000000000,
  )
}

// Firmware HTTPS trust authenticates the HTTPS route; a UefiPxe ticket's chainloader arrives over
// TFTP, so HTTPS trust alone does not ground it, however valid its own subject is.
test fn uefi_pxe_with_firmware_https_only_is_not_production_trusted() -> Bool {
  let https_only = bootstrap_trust_standing(
    firmware_https: Present { value: https_trust_obs() },
    secure_boot_chainloader: Absent,
    isolated_onboarding_network: Absent,
  )
  match join_network_boot_delivery(inputs: inputs_varying(trust: https_only, site: site_ok(), bundle: bundle_ok())) {
    NetworkBootDeliveryTrustRefused { cause: FirmwareHttpsDoesNotAuthenticateTftpChainloader } => true
    NetworkBootDeliveryTrustRefused { cause: _ } => false
    NetworkBootDeliveryEstablished { evidence: _ } => false
    NetworkBootDeliveryUnestablished { missing: _ } => false
    NetworkBootDeliveryEvidenceRefused { axis: _, observation: _ } => false
    NetworkBootDeliveryArchitectureRefused { cause: _ } => false
    NetworkBootDeliveryClientModeRefused { arch: _ } => false
    NetworkBootDeliveryTargetMismatch { axis: _ } => false
    NetworkBootDeliveryManifestRefused { cause: _ } => false
    NetworkBootDeliverySiteUnestablished => false
    NetworkBootDeliverySiteMismatch { axis: _, expected: _, observed: _ } => false
    NetworkBootDeliveryTrustUnestablished => false
    NetworkBootDeliveryRouteMismatch { axis: _, expected: _, observed: _ } => false
  }
}

// The site reached AN HTTPS endpoint, not the fleet's broker: reachability of some other endpoint
// is not reachability of this service.
test fn reaching_a_different_https_endpoint_does_not_establish() -> Bool {
  let elsewhere = Uri { scheme: Https, locator: "other-broker.example.test/manifest" }
  match join_network_boot_delivery(inputs: inputs_varying(
    trust: production_trust(),
    site: site_reaching(broker: elsewhere, origin: fleet_origin, tftp: edge_tftp),
    bundle: bundle_ok(),
  )) {
    NetworkBootDeliveryRouteMismatch { axis: RouteBrokerEndpoint, expected: e, observed: o } =>
      e == fleet_broker && o == elsewhere
    NetworkBootDeliveryRouteMismatch { axis: _, expected: _, observed: _ } => false
    NetworkBootDeliveryEstablished { evidence: _ } => false
    NetworkBootDeliveryUnestablished { missing: _ } => false
    NetworkBootDeliveryEvidenceRefused { axis: _, observation: _ } => false
    NetworkBootDeliveryArchitectureRefused { cause: _ } => false
    NetworkBootDeliveryClientModeRefused { arch: _ } => false
    NetworkBootDeliveryTargetMismatch { axis: _ } => false
    NetworkBootDeliveryManifestRefused { cause: _ } => false
    NetworkBootDeliverySiteUnestablished => false
    NetworkBootDeliverySiteMismatch { axis: _, expected: _, observed: _ } => false
    NetworkBootDeliveryTrustUnestablished => false
    NetworkBootDeliveryTrustRefused { cause: _ } => false
  }
}

// The signed ticket directs firmware to one TFTP root and the edge was observed serving another.
test fn manifest_tftp_root_other_than_the_site_edge_refuses() -> Bool {
  let other_tftp = Uri { scheme: Tftp, locator: "198.51.100.7/snponly.efi" }
  match join_network_boot_delivery(inputs: inputs_varying(
    trust: production_trust(),
    site: site_reaching(broker: fleet_broker, origin: fleet_origin, tftp: other_tftp),
    bundle: bundle_ok(),
