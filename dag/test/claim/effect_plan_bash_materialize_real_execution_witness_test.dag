module test.claim.effect_plan_bash_materialize_real_execution_witness



data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = ReadsLiveTree

data effect_plan_bash_real_execution_note: String = "T1/T2 wet model evidence only, not the Wave-B gate consumer or policy activation. The controls execute emitted carriers through Bash using read-only test/id operations over fixed paths: no file write, environment mutation, network, repo state, or cleanup obligation. They prove two typed declared operations run, metachar/newline arguments stay one word, and grammar-owned && enforces FailFast by preventing the observable second command after the first fails."

fn wet_ref(path: String, service: String, operation: String) -> v2.std.operation_argv.OperationRef {
  v2.std.operation_argv.OperationRef { path: path, service: service, operation: operation }
}

fn wet_invocation(
  path: String,
  service: String,
  operation: String,
  bindings: List<v2.std.operation_argv.OperationInputBinding>
) -> v2.workflow.effect_plan_bash_materialize.BashBoundOperationInvocation {
  v2.workflow.effect_plan_bash_materialize.bash_bind_operation_invocation(
    at: wet_ref(path: path, service: service, operation: operation),
    bindings: bindings
  )
}

fn wet_test_path(operation: String, path: String) -> v2.workflow.effect_plan_bash_materialize.BashBoundOperationInvocation {
  wet_invocation(
    path: "dag/extdeps/shell.dag",
    service: "shell.Test",
    operation: operation,
    bindings: [v2.std.operation_argv.operation_argv_bind_text(name: "path", text: path)]
  )
}

fn wet_id_uid() -> v2.workflow.effect_plan_bash_materialize.BashBoundOperationInvocation {
  wet_invocation(
    path: "dag/extdeps/tools/id.dag",
    service: "os.Id",
    operation: "Uid",
    bindings: []
  )
}

fn wet_plan(
  steps: List<EffectPlanStep<v2.workflow.effect_plan_bash_materialize.BashBoundOperationInvocation>>
) -> EffectPlan<v2.workflow.effect_plan_bash_materialize.BashBoundOperationInvocation> {
  v2.std.effect_plan.EffectPlan { steps: steps, on_failure: FailFast }
}

fn wet_exec_succeeds_with_output(plan: EffectPlan<v2.workflow.effect_plan_bash_materialize.BashBoundOperationInvocation>) -> Bool {
  match bash_materialized_transport(materialization: v2.workflow.effect_plan_bash_materialize.effect_plan_bash_materialize(plan: plan)) {
    Present { value: script } => {
      let result = shell.Exec.Run(script: script)
      result.success && string_length(s: trim(s: result.stdout)) > 0
    }
    Absent => false
  }
}

fn wet_exec_fails_without_output(plan: EffectPlan<v2.workflow.effect_plan_bash_materialize.BashBoundOperationInvocation>) -> Bool {
  match bash_materialized_transport(materialization: v2.workflow.effect_plan_bash_materialize.effect_plan_bash_materialize(plan: plan)) {
    Present { value: script } => {
      let result = shell.Exec.Run(script: script, expect: ExpectFailure)
      !result.success && trim(s: result.stdout) == ""
    }
    Absent => false
  }
}

test fn effect_plan_bash_two_declared_operations_execute() -> Bool {
  wet_exec_succeeds_with_output(plan: wet_plan(steps: [
    v2.std.effect_plan.Do { effect: wet_test_path(operation: "IsExecutable", path: "/bin/sh") },
    v2.std.effect_plan.Do { effect: wet_id_uid() }
  ]))
}

test fn effect_plan_bash_fail_fast_prevents_later_operation_execution() -> Bool {
  wet_exec_fails_without_output(plan: wet_plan(steps: [
    v2.std.effect_plan.Do { effect: wet_test_path(operation: "IsFile", path: "/gunbc-wave-a-definitely-absent") },
    v2.std.effect_plan.Do { effect: wet_id_uid() }
  ]))
}

test fn effect_plan_bash_metachar_and_newline_cannot_open_a_statement() -> Bool {
  let metachar = wet_exec_fails_without_output(plan: wet_plan(steps: [
    v2.std.effect_plan.Do { effect: wet_test_path(
      operation: "IsFile",
      path: "/tmp/absent; printf PWN"
    ) }
  ]))
  let newline = wet_exec_fails_without_output(plan: wet_plan(steps: [
    v2.std.effect_plan.Do { effect: wet_test_path(
      operation: "IsFile",
      path: "/tmp/absent\nid -u"
    ) }
  ]))
  metachar && newline
}
