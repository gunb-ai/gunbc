module test.claim.srv3_websocat_sequence_witness


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THESE WITNESSES ASSERT WHAT RAN, NOT WHAT CAME BACK.
//
// Every other witness over this file checks the returned Srv3HostPredicate. Two real defects hid
// underneath exactly that: a privileged apt install executing on every ensure of an already-present
// tool, and four websocat mutations executing regardless of each other's outcome. In both the
// returned value was correct and the execution was wrong, so a classification witness could not
// have gone red for either. An action trace can.
//
// The trace is derived from websocat_after -- the same transition function the production driver
// consumes -- so a change to the sequencing reddens these without any host being involved.

fn unobserved(reason: String) -> gunbc.host_effect_realize.Srv3HostPredicate {
  gunbc.host_effect_realize.Srv3PredicateUnobserved { reason: reason }
}

fn labels_equal(actual: List<String>, expected: List<String>) -> Bool {
  join(actual, ",") == join(expected, ",")
}

fn trace_of(outcomes: List<gunbc.host_effect_realize.Srv3HostPredicate>) -> List<String> {
  gunbc.host_effect_realize.websocat_trace_labels(walk: gunbc.host_effect_realize.websocat_trace_from_outcomes(outcomes: outcomes))
}

// Already present: observe only. No mutation stage is reachable.
test fn already_installed_runs_observe_only() -> Bool {
  labels_equal(
    actual: trace_of(outcomes: [gunbc.host_effect_realize.Srv3PredicateHolds]),
    expected: ["observe-installed"],
  )
}

// An unobservable first probe must not lead to an install on a host that was never reached.
test fn unobservable_observation_runs_observe_only() -> Bool {
  labels_equal(
    actual: trace_of(outcomes: [unobserved(reason: "transport refused")]),
    expected: ["observe-installed"],
  )
}

// THE CENTRAL RED. A failed mkdir stops the walk: no download, no chmod, no readback.
// Before this cut all three ran anyway.
test fn a_failed_directory_ensure_stops_before_download() -> Bool {
  labels_equal(
    actual: trace_of(
      outcomes: [gunbc.host_effect_realize.Srv3PredicateFails, gunbc.host_effect_realize.Srv3PredicateHolds, gunbc.host_effect_realize.Srv3PredicateFails, gunbc.host_effect_realize.Srv3PredicateHolds, gunbc.host_effect_realize.Srv3PredicateHolds, gunbc.host_effect_realize.Srv3PredicateHolds, gunbc.host_effect_realize.Srv3PredicateHolds],
    ),
    expected: ["observe-installed", "resolve-curl", "ensure-directory"],
  )
}

// An unobservable chown must not be followed by a download either -- Unobserved is not a weaker
// Fails, it is "the host was never asked", and proceeding would mutate a host in unknown state.
test fn an_unobservable_ownership_ensure_stops_before_download() -> Bool {
  labels_equal(
    actual: trace_of(
      outcomes: [gunbc.host_effect_realize.Srv3PredicateFails, gunbc.host_effect_realize.Srv3PredicateHolds, gunbc.host_effect_realize.Srv3PredicateHolds, unobserved(reason: "ssh refused"), gunbc.host_effect_realize.Srv3PredicateHolds, gunbc.host_effect_realize.Srv3PredicateHolds, gunbc.host_effect_realize.Srv3PredicateHolds],
    ),
    expected: ["observe-installed", "resolve-curl", "ensure-directory", "ensure-ownership"],
  )
}

// A failed download must not be chmod'd or read back -- the previous body chmod'd a file the
// download had not produced, then re-observed it.
test fn a_failed_download_stops_before_chmod() -> Bool {
  labels_equal(
    actual: trace_of(
      outcomes: [gunbc.host_effect_realize.Srv3PredicateFails, gunbc.host_effect_realize.Srv3PredicateHolds, gunbc.host_effect_realize.Srv3PredicateHolds, gunbc.host_effect_realize.Srv3PredicateHolds, gunbc.host_effect_realize.Srv3PredicateFails, gunbc.host_effect_realize.Srv3PredicateHolds, gunbc.host_effect_realize.Srv3PredicateHolds],
    ),
    expected: ["observe-installed", "resolve-curl", "ensure-directory", "ensure-ownership", "download"],
  )
}

// THE REGRESSION CONTROL THE MERGED CUT NEEDED AND DID NOT HAVE. The final test -x must not
// execute after any preceding failure. #8695 moved that readback into an eagerly-built list, so it
// ran unconditionally, and no witness in the file could see it.
// EVERY TRACE SUPPLIES SEVEN OUTCOMES, one per stage, and that is load-bearing rather than tidy.
// An earlier draft supplied six: under a mutation that never stops, the walk then ran out of
// outcomes at stage six and stopped short of readback anyway, so this test stayed green against
// exactly the defect it names. Measured -- it was the one witness the never-stop mutation did
// not redden. The seventh outcome removes the exhaustion crutch, so the only thing that can
// keep readback out of the trace is the sequencing.
test fn the_readback_never_runs_after_a_failed_step() -> Bool {
  v2.std.algebra.fold_list(
    xs: [
      trace_of(outcomes: [gunbc.host_effect_realize.Srv3PredicateFails, gunbc.host_effect_realize.Srv3PredicateFails, gunbc.host_effect_realize.Srv3PredicateHolds, gunbc.host_effect_realize.Srv3PredicateHolds, gunbc.host_effect_realize.Srv3PredicateHolds, gunbc.host_effect_realize.Srv3PredicateHolds, gunbc.host_effect_realize.Srv3PredicateHolds]),
      trace_of(outcomes: [gunbc.host_effect_realize.Srv3PredicateFails, gunbc.host_effect_realize.Srv3PredicateHolds, gunbc.host_effect_realize.Srv3PredicateFails, gunbc.host_effect_realize.Srv3PredicateHolds, gunbc.host_effect_realize.Srv3PredicateHolds, gunbc.host_effect_realize.Srv3PredicateHolds, gunbc.host_effect_realize.Srv3PredicateHolds]),
      trace_of(outcomes: [gunbc.host_effect_realize.Srv3PredicateFails, gunbc.host_effect_realize.Srv3PredicateHolds, gunbc.host_effect_realize.Srv3PredicateHolds, gunbc.host_effect_realize.Srv3PredicateFails, gunbc.host_effect_realize.Srv3PredicateHolds, gunbc.host_effect_realize.Srv3PredicateHolds, gunbc.host_effect_realize.Srv3PredicateHolds]),
      trace_of(outcomes: [gunbc.host_effect_realize.Srv3PredicateFails, gunbc.host_effect_realize.Srv3PredicateHolds, gunbc.host_effect_realize.Srv3PredicateHolds, gunbc.host_effect_realize.Srv3PredicateHolds, gunbc.host_effect_realize.Srv3PredicateFails, gunbc.host_effect_realize.Srv3PredicateHolds, gunbc.host_effect_realize.Srv3PredicateHolds]),
      trace_of(outcomes: [gunbc.host_effect_realize.Srv3PredicateFails, gunbc.host_effect_realize.Srv3PredicateHolds, gunbc.host_effect_realize.Srv3PredicateHolds, gunbc.host_effect_realize.Srv3PredicateHolds, gunbc.host_effect_realize.Srv3PredicateHolds, gunbc.host_effect_realize.Srv3PredicateFails, gunbc.host_effect_realize.Srv3PredicateHolds]),
    ],
    empty: true,
    cons: fn(acc, labels) {
      acc && (string_contains(s: join(labels, ","), pattern: "readback") == false)
    },
  )
}

// THE POSITIVE CONTROL, without which every test above passes on a walk that never runs anything.
// It passes SEVEN outcomes for seven stages. An earlier draft passed six and could not have
// reached readback -- the test would have "passed" by asserting a chain it never walked.
test fn a_fully_successful_install_runs_the_complete_chain_then_reads_back() -> Bool {
  labels_equal(
    actual: trace_of(
      outcomes: [
        gunbc.host_effect_realize.Srv3PredicateFails,
        gunbc.host_effect_realize.Srv3PredicateHolds,
        gunbc.host_effect_realize.Srv3PredicateHolds,
        gunbc.host_effect_realize.Srv3PredicateHolds,
        gunbc.host_effect_realize.Srv3PredicateHolds,
        gunbc.host_effect_realize.Srv3PredicateHolds,
        gunbc.host_effect_realize.Srv3PredicateHolds,
      ],
    ),
    expected: [
      "observe-installed",
      "resolve-curl",
      "ensure-directory",
      "ensure-ownership",
      "download",
      "ensure-executable-mode",
      "readback",
    ],
  )
}


// THE DRIVER'S OWN GUARD, EVALUATED. Everything above witnesses the trace, which follows the stage
// websocat_after names. The production driver used to DISCARD that stage and run the one it was
// written to expect, so websocat_after was the sole authority for stop-or-continue while the stage
// EDGE was spelled a second time in the driver's call graph. Rewriting an edge would have reddened
// the trace while production carried on in its original order, and the never-stops mutation could
// not see it -- that mutation changes the stop decision, not the edge.
//
// These four witnesses evaluate the SAME expression each driver site now evaluates:
// websocat_edge_admits(actual: <what the authority said>, expected: <what this site implements>).
// Rewrite any edge in websocat_after and the matching one goes red, exactly as the driver would
// refuse. Raised in side-chat review of the first cut.
fn edge_admits(from: WebsocatStage, expected: WebsocatStage) -> Bool {
  match websocat_after(stage: from, outcome: Srv3PredicateHolds) {
    WebsocatAlreadySatisfied => false
    WebsocatStop { verdict: _ } => false
    WebsocatContinue { next: n } => websocat_edge_admits(actual: n, expected: expected)
  }
}

test fn the_directory_stage_continues_to_the_stage_its_driver_site_implements() -> Bool {
  edge_admits(from: EnsureDirectory, expected: EnsureOwnership)
}

test fn the_ownership_stage_continues_to_the_stage_its_driver_site_implements() -> Bool {
  edge_admits(from: EnsureOwnership, expected: gunbc.host_effect_realize.Download)
}

test fn the_download_stage_continues_to_the_stage_its_driver_site_implements() -> Bool {
  edge_admits(from: gunbc.host_effect_realize.Download, expected: EnsureExecutableMode)
}

test fn the_mode_stage_continues_to_the_stage_its_driver_site_implements() -> Bool {
  edge_admits(from: EnsureExecutableMode, expected: Readback)
}

// The control for the four above: the guard must be capable of answering false, or all four are
// asserting that a function returns true rather than that the edges agree.
test fn the_edge_guard_refuses_a_stage_the_site_does_not_implement() -> Bool {
  edge_admits(from: EnsureDirectory, expected: Readback) == false
}
