          capability_receipt: receipt,
          coverage: census_establish_coverage(
            denominator: coverage_witness_denominator(subjects: coverage_witness_ab_subjects),
            observation: observation,
          ),
        ),
      )
    Absent => none
  }
}

test fn witness_an_unobserved_conformance_holds_the_semantic_ceiling_at_a_floor() -> Bool {
  coverage_witness_ceiling_predicate(
    ceiling: coverage_witness_unconformed_ceiling(),
    f: ceiling => census_ceiling_is_floor_only(ceiling: ceiling),
  )
}

test fn witness_an_unobserved_conformance_names_its_limit() -> Bool {
  coverage_witness_ceiling_predicate(
    ceiling: coverage_witness_unconformed_ceiling(),
    f: ceiling => census_ceiling_has_limit(ceiling: ceiling, limit: MethodConformanceUnobserved),
  )
}

fn coverage_witness_textual_ceiling(rows: List<gunbc.repository_census_observation.CensusObservedRow>) -> gunbc.repository_census_coverage.CensusInferenceCeiling? {
  let observation = coverage_witness_observation(rows: rows)
  match census_method_capability_receipt(
    observation: observation,
    capability: gunbc.repository_census_coverage.MatchesSourceText {
      contract: coverage_witness_decl(name: "coverage_witness_classifier"),
    },
    conformance: coverage_witness_conforming_control(),
  ) {
    Present { value: receipt } =>
      coverage_witness_ceiling_option(
        outcome: census_inference_ceiling(
          capability_receipt: receipt,
          coverage: census_establish_coverage(
            denominator: coverage_witness_denominator(subjects: coverage_witness_ab_subjects),
            observation: observation,
          ),
        ),
      )
    Absent => none
  }
}

test fn witness_an_exhaustive_text_scan_cannot_support_a_semantic_subject_claim() -> Bool {
  !coverage_witness_ceiling_predicate(
    ceiling: coverage_witness_textual_ceiling(rows: coverage_witness_ab_rows),
    f: ceiling => census_ceiling_supports_semantic_subject_claim(ceiling: ceiling),
  )
}

test fn witness_an_exhaustive_text_scan_still_supports_textual_absence() -> Bool {
  coverage_witness_ceiling_predicate(
