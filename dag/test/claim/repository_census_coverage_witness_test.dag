    ceiling: coverage_witness_textual_ceiling(rows: [coverage_witness_row(name: "a")]),
    f: ceiling => census_ceiling_supports_textual_absence(ceiling: ceiling),
  )
}

test fn witness_the_denominator_subjects_reach_its_identity() -> Bool {
  !content_hash_eq_structural(
    left: census_denominator_identity(
      denominator: coverage_witness_denominator(subjects: coverage_witness_ab_subjects),
    ),
    right: census_denominator_identity(
      denominator: coverage_witness_denominator(subjects: [coverage_witness_key(name: "a")]),
    ),
  )
}

test fn witness_the_denominator_subject_count_is_a_projection() -> Bool {
  census_denominator_subject_count(
    denominator: coverage_witness_denominator(subjects: coverage_witness_ab_subjects),
  ) == 2
}
