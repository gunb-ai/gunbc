module test.claim.repository_census_coverage_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

data coverage_witness_separability_note: String = "EVERY WITNESS HERE ASSERTS ONE PROPERTY, and that is a rule this file was built under rather than a style preference (operator refinement 2026-08-04). A conjunction can only be licensed one conjunct at a time — a discriminating RED credits exactly the conjunct it trips, so one live conjunct can launder several dead ones and the result is indistinguishable from an all-live conjunction. That is only mechanically checkable when the conjuncts are SEPARABLE: a witness whose arms cannot be individually falsified cannot be individually licensed. Splitting them also makes a red self-locating, so a guard that fires is never read as a failure of the property the witness is named for."

fn coverage_witness_decl(name: String) -> std.decl_ref.DeclarationRef {
  decl_ref(module_path: "test.claim.repository_census_coverage_witness", decl_name: name)
}

data coverage_witness_revision: gunbc.guarantee_measurement.MeasurementRevision = gunbc.guarantee_measurement.GitRevision {
  commit: "ca75137ee30000000000000000000000000000ff",
}

data coverage_witness_other_revision: gunbc.guarantee_measurement.MeasurementRevision = gunbc.guarantee_measurement.GitRevision {
  commit: "ca75137ee30000000000000000000000000000aa",
}

fn coverage_witness_digest(seed: String) -> std.content_hash.Fnv1a64Structural {
  content_hash_atom(value: seed as std.types.NonEmptyStr)
}

fn coverage_witness_run_at(
  classifier: String,
  invocation: String,
  revision: gunbc.guarantee_measurement.MeasurementRevision,
) -> gunbc.repository_census_observation.CensusMethodRunIdentity {
  gunbc.repository_census_observation.CensusMethodRunIdentity {
    classifier: coverage_witness_decl(name: classifier),
    classifier_revision: revision,
    invocation_identity: coverage_witness_digest(seed: invocation),
  }
}

fn coverage_witness_enumeration_run() -> gunbc.repository_census_observation.CensusMethodRunIdentity {
  coverage_witness_run_at(
    classifier: "coverage_witness_enumerator",
    invocation: "enumerate",
    revision: coverage_witness_revision,
  )
}

fn coverage_witness_classification_run() -> gunbc.repository_census_observation.CensusMethodRunIdentity {
  coverage_witness_run_at(
    classifier: "coverage_witness_classifier",
    invocation: "classify",
    revision: coverage_witness_revision,
  )
}

data coverage_witness_population: gunbc.repository_census_observation.RepositoryPopulation = gunbc.repository_census_observation.RepositoryPopulation {
  repository: "gunbc" as gunbc.repository_census_observation.RepositoryIdentity,
  first_source_root: "dag" as gunbc.repository_census_observation.SourceRootIdentity,
  additional_source_roots: ["src/v2" as gunbc.repository_census_observation.SourceRootIdentity],
  inclusion_rule: coverage_witness_decl(name: "coverage_witness_inclusion_rule"),
  exclusion_rule: Absent,
}

data coverage_witness_other_population: gunbc.repository_census_observation.RepositoryPopulation = gunbc.repository_census_observation.RepositoryPopulation {
  repository: "gunbc" as gunbc.repository_census_observation.RepositoryIdentity,
  first_source_root: "dag" as gunbc.repository_census_observation.SourceRootIdentity,
  additional_source_roots: [],
  inclusion_rule: coverage_witness_decl(name: "coverage_witness_inclusion_rule"),
  exclusion_rule: Absent,
}

fn coverage_witness_key(name: String) -> gunbc.repository_census_observation.CensusSubjectKey {
  name as gunbc.repository_census_observation.CensusSubjectKey
}

fn coverage_witness_row(name: String) -> gunbc.repository_census_observation.CensusObservedRow {
  census_observed_row(
    subject: coverage_witness_key(name: name),
    fact: coverage_witness_digest(seed: concat("fact-", name)),
  )
}

fn coverage_witness_observation_of(
  population: gunbc.repository_census_observation.RepositoryPopulation,
  revision: gunbc.guarantee_measurement.MeasurementRevision,
  rows: List<gunbc.repository_census_observation.CensusObservedRow>,
  run: gunbc.repository_census_observation.CensusMethodRunIdentity,
) -> gunbc.repository_census_observation.RepositoryCensusObservation {
  repository_census_observation(
    population: population,
    observed_at_revision: revision,
    method_run: run,
    rows: rows,
  )
}

fn coverage_witness_observation(rows: List<gunbc.repository_census_observation.CensusObservedRow>) -> gunbc.repository_census_observation.RepositoryCensusObservation {
  coverage_witness_observation_of(
    population: coverage_witness_population,
    revision: coverage_witness_revision,
    rows: rows,
    run: coverage_witness_classification_run(),
  )
}

fn coverage_witness_denominator_of(
  population: gunbc.repository_census_observation.RepositoryPopulation,
  revision: gunbc.guarantee_measurement.MeasurementRevision,
  subjects: List<gunbc.repository_census_observation.CensusSubjectKey>,
) -> gunbc.repository_census_coverage.CensusDenominatorObservation {
  census_denominator_observation(
    population: population,
    observed_at_revision: revision,
    enumeration_run: coverage_witness_enumeration_run(),
    subjects: subjects,
  )
}

fn coverage_witness_denominator(
  subjects: List<gunbc.repository_census_observation.CensusSubjectKey>,
) -> gunbc.repository_census_coverage.CensusDenominatorObservation {
  coverage_witness_denominator_of(
    population: coverage_witness_population,
    revision: coverage_witness_revision,
    subjects: subjects,
  )
}

data coverage_witness_ab_subjects: List<gunbc.repository_census_observation.CensusSubjectKey> = [
  coverage_witness_key(name: "a"),
  coverage_witness_key(name: "b"),
]

data coverage_witness_ab_rows: List<gunbc.repository_census_observation.CensusObservedRow> = [
  coverage_witness_row(name: "a"),
  coverage_witness_row(name: "b"),
]

fn coverage_outcome_has_receipt(outcome: gunbc.repository_census_coverage.CensusCoverageOutcome) -> Bool {
  match outcome {
    CoverageEstablished { receipt: _ } => true
    CoverageRefused {
      observation_identity: _,
      classification_run_identity: _,
      reconciliation: _,
    } => false
  }
}

fn coverage_witness_established(
  denominator: gunbc.repository_census_coverage.CensusDenominatorObservation,
  observation: gunbc.repository_census_observation.RepositoryCensusObservation,
) -> Bool {
  coverage_outcome_has_receipt(
    outcome: census_establish_coverage(denominator: denominator, observation: observation),
  )
}

test fn witness_an_aligned_exact_join_yields_a_receipt() -> Bool {
  coverage_witness_established(
    denominator: coverage_witness_denominator(subjects: coverage_witness_ab_subjects),
    observation: coverage_witness_observation(rows: coverage_witness_ab_rows),
  )
}

data coverage_blocker_one_note: String = "BLOCKER 1 WITNESSES. The two populations below differ only in their source roots and the two revisions only in their commit, while the subject keys are spelled IDENTICALLY. Under the first cut both pairs reconciled and the receipt then recorded the mismatched identities beside the exhaustive status. Each of the two mismatch axes gets its own witness so a red names which one broke."

test fn witness_a_population_mismatch_refuses_before_any_key_is_compared() -> Bool {
  match census_resolve_coverage_subjects(
    denominator: coverage_witness_denominator_of(
      population: coverage_witness_other_population,
      revision: coverage_witness_revision,
      subjects: coverage_witness_ab_subjects,
    ),
    observation: coverage_witness_observation(rows: coverage_witness_ab_rows),
  ) {
    CoveragePopulationMismatch {
      denominator_population_identity: d,
      observation_population_identity: o,
    } => !content_hash_eq_structural(left: d, right: o)
    CoverageSubjectsAligned { population_identity: _, revision_identity: _ } => false
    CoverageRevisionMismatch {
      denominator_revision_identity: _,
      observation_revision_identity: _,
    } => false
  }
}

test fn witness_a_population_mismatch_yields_no_receipt() -> Bool {
  !coverage_witness_established(
    denominator: coverage_witness_denominator_of(
      population: coverage_witness_other_population,
      revision: coverage_witness_revision,
      subjects: coverage_witness_ab_subjects,
    ),
    observation: coverage_witness_observation(rows: coverage_witness_ab_rows),
  )
}

test fn witness_a_revision_mismatch_refuses_before_any_key_is_compared() -> Bool {
  match census_resolve_coverage_subjects(
    denominator: coverage_witness_denominator_of(
      population: coverage_witness_population,
      revision: coverage_witness_other_revision,
      subjects: coverage_witness_ab_subjects,
    ),
    observation: coverage_witness_observation(rows: coverage_witness_ab_rows),
  ) {
    CoverageRevisionMismatch {
      denominator_revision_identity: d,
      observation_revision_identity: o,
    } => !content_hash_eq_structural(left: d, right: o)
    CoverageSubjectsAligned { population_identity: _, revision_identity: _ } => false
    CoveragePopulationMismatch {
      denominator_population_identity: _,
      observation_population_identity: _,
    } => false
  }
}

test fn witness_a_revision_mismatch_yields_no_receipt() -> Bool {
  !coverage_witness_established(
    denominator: coverage_witness_denominator_of(
      population: coverage_witness_population,
      revision: coverage_witness_other_revision,
      subjects: coverage_witness_ab_subjects,
    ),
    observation: coverage_witness_observation(rows: coverage_witness_ab_rows),
  )
}

test fn witness_an_aligned_pair_carries_the_identities_the_join_established() -> Bool {
  match census_resolve_coverage_subjects(
    denominator: coverage_witness_denominator(subjects: coverage_witness_ab_subjects),
    observation: coverage_witness_observation(rows: coverage_witness_ab_rows),
  ) {
    CoverageSubjectsAligned {
      population_identity: population_identity,
      revision_identity: revision_identity,
    } => !content_hash_eq_structural(left: population_identity, right: revision_identity)
    CoveragePopulationMismatch {
      denominator_population_identity: _,
      observation_population_identity: _,
    } => false
    CoverageRevisionMismatch {
      denominator_revision_identity: _,
      observation_revision_identity: _,
    } => false
  }
}

data coverage_blocker_two_note: String = "BLOCKER 2 WITNESSES. A denominator of A, A against an observation of A has no missing key, no unexpected key and no duplicate among the OBSERVED keys — which is the whole population the first cut looked at. It reconciled. The denominator side is now resolved with its own arm, and the three duplicate shapes each get a witness."

test fn witness_a_denominator_duplicate_is_located_on_its_own_side() -> Bool {
  match census_resolve_duplicate_subjects(
    denominator_subjects: [coverage_witness_key(name: "a"), coverage_witness_key(name: "a")],
    observed_subjects: [coverage_witness_key(name: "a")],
  ) {
    DenominatorDuplicated { denominator_duplicated: duplicated } =>
      count(duplicated) == 1 && any(duplicated, k => (k as String) == "a")
    NoDuplicateSubjects => false
    ObservationDuplicated { observation_duplicated: _ } => false
    BothDuplicated { denominator_duplicated: _, observation_duplicated: _ } => false
  }
}

test fn witness_a_duplicated_denominator_yields_no_receipt() -> Bool {
  !coverage_witness_established(
    denominator: coverage_witness_denominator(
      subjects: [coverage_witness_key(name: "a"), coverage_witness_key(name: "a")],
    ),
    observation: coverage_witness_observation(rows: [coverage_witness_row(name: "a")]),
  )
}

test fn witness_an_observation_duplicate_is_located_on_its_own_side() -> Bool {
  match census_resolve_duplicate_subjects(
    denominator_subjects: [coverage_witness_key(name: "a")],
    observed_subjects: [coverage_witness_key(name: "a"), coverage_witness_key(name: "a")],
  ) {
    ObservationDuplicated { observation_duplicated: duplicated } =>
      count(duplicated) == 1 && any(duplicated, k => (k as String) == "a")
    NoDuplicateSubjects => false
    DenominatorDuplicated { denominator_duplicated: _ } => false
    BothDuplicated { denominator_duplicated: _, observation_duplicated: _ } => false
  }
}

test fn witness_duplicates_on_both_sides_are_reported_separately() -> Bool {
  match census_resolve_duplicate_subjects(
    denominator_subjects: [coverage_witness_key(name: "a"), coverage_witness_key(name: "a")],
    observed_subjects: [coverage_witness_key(name: "b"), coverage_witness_key(name: "b")],
  ) {
    BothDuplicated {
      denominator_duplicated: denominator_duplicated,
      observation_duplicated: observation_duplicated,
    } =>
      any(denominator_duplicated, k => (k as String) == "a") && any(observation_duplicated, k => (k as String) == "b")
    NoDuplicateSubjects => false
    DenominatorDuplicated { denominator_duplicated: _ } => false
    ObservationDuplicated { observation_duplicated: _ } => false
  }
}

test fn witness_a_clean_pair_reports_no_duplicates() -> Bool {
  match census_resolve_duplicate_subjects(
    denominator_subjects: coverage_witness_ab_subjects,
    observed_subjects: coverage_witness_ab_subjects,
  ) {
    NoDuplicateSubjects => true
    DenominatorDuplicated { denominator_duplicated: _ } => false
    ObservationDuplicated { observation_duplicated: _ } => false
    BothDuplicated { denominator_duplicated: _, observation_duplicated: _ } => false
  }
}

fn coverage_witness_aligned(
  denominator_subjects: List<gunbc.repository_census_observation.CensusSubjectKey>,
  observed_subjects: List<gunbc.repository_census_observation.CensusSubjectKey>,
) -> gunbc.repository_census_coverage.CensusCoverageReconciliation {
  census_reconcile_aligned_subjects(
    denominator_subjects: denominator_subjects,
    observed_subjects: observed_subjects,
    population_identity: coverage_witness_digest(seed: "population"),
    revision_identity: coverage_witness_digest(seed: "revision"),
  )
}

test fn witness_the_missing_subject_is_located_not_counted() -> Bool {
  match coverage_witness_aligned(
    denominator_subjects: coverage_witness_ab_subjects,
    observed_subjects: [coverage_witness_key(name: "a")],
  ) {
    CoverageIncomplete { missing: missing } =>
      count(missing) == 1 && any(missing, k => (k as String) == "b")
    CoverageReconciled { population_identity: _, revision_identity: _ } => false
    CoverageSubjectsUnresolved { resolution: _ } => false
    CoverageDuplicateSubjects { duplicates: _ } => false
    CoverageUnexpected { unexpected: _ } => false
    CoverageDiverged { missing: _, unexpected: _, duplicates: _ } => false
  }
}

test fn witness_an_unexpected_subject_is_located_not_counted() -> Bool {
  match coverage_witness_aligned(
    denominator_subjects: [coverage_witness_key(name: "a")],
    observed_subjects: coverage_witness_ab_subjects,
  ) {
    CoverageUnexpected { unexpected: unexpected } =>
      count(unexpected) == 1 && any(unexpected, k => (k as String) == "b")
    CoverageReconciled { population_identity: _, revision_identity: _ } => false
    CoverageSubjectsUnresolved { resolution: _ } => false
    CoverageDuplicateSubjects { duplicates: _ } => false
    CoverageIncomplete { missing: _ } => false
    CoverageDiverged { missing: _, unexpected: _, duplicates: _ } => false
  }
}

data coverage_cancelling_totals_note: String = "THE CASE A COUNT EQUALITY CANNOT SEE, and the reason this stage reconciles identities instead of totals. A denominator of two subjects against an observation carrying one subject TWICE has equal totals — two against two — while one subject is missing entirely and another is duplicated. The two failures cancel exactly in a sum. Any check comparing sizes reports coverage as complete; the identity join reports both failures, located, and refuses the receipt."

test fn witness_a_duplicate_and_a_missing_subject_cancel_in_a_total() -> Bool {
  let denominator_subjects = coverage_witness_ab_subjects
  let observed_subjects = [coverage_witness_key(name: "a"), coverage_witness_key(name: "a")]
  count(denominator_subjects) == count(observed_subjects)
}

test fn witness_a_duplicate_and_a_missing_subject_do_not_cancel_in_the_join() -> Bool {
  match coverage_witness_aligned(
    denominator_subjects: coverage_witness_ab_subjects,
    observed_subjects: [coverage_witness_key(name: "a"), coverage_witness_key(name: "a")],
  ) {
    CoverageDiverged { missing: missing, unexpected: unexpected, duplicates: duplicates } => {
      let located = count(missing) == 1 && count(unexpected) == 0
      let duplicated_named = match duplicates {
        ObservationDuplicated { observation_duplicated: observation_duplicated } =>
          any(observation_duplicated, k => (k as String) == "a")
        NoDuplicateSubjects => false
        DenominatorDuplicated { denominator_duplicated: _ } => false
        BothDuplicated { denominator_duplicated: _, observation_duplicated: _ } => false
      }
      located && duplicated_named
    }
    CoverageReconciled { population_identity: _, revision_identity: _ } => false
    CoverageSubjectsUnresolved { resolution: _ } => false
    CoverageDuplicateSubjects { duplicates: _ } => false
    CoverageIncomplete { missing: _ } => false
    CoverageUnexpected { unexpected: _ } => false
  }
}

data coverage_blocker_five_note: String = "BLOCKER 5 WITNESSES. Independence is decided from the two runs and then ACTED ON. Three shapes: one run used twice, two invocations of one classifier declaration, and two different classifier declarations. Only the last establishes independence, and the first two still permit a population floor."

test fn witness_one_run_used_twice_is_a_shared_run() -> Bool {
  match census_resolve_independence(
    enumeration_run: coverage_witness_classification_run(),
    classification_run: coverage_witness_classification_run(),
  ) {
    SharedRun { run_identity: _ } => true
    DistinctProcedureDenominatorEstablished {
      enumeration_classifier_identity: _,
      classification_classifier_identity: _,
    } => false
    IndependenceUnestablished { shared_classifier_identity: _ } => false
  }
}

test fn witness_two_invocations_of_one_classifier_do_not_establish_independence() -> Bool {
  match census_resolve_independence(
    enumeration_run: coverage_witness_run_at(
      classifier: "coverage_witness_classifier",
      invocation: "first",
      revision: coverage_witness_revision,
    ),
    classification_run: coverage_witness_run_at(
      classifier: "coverage_witness_classifier",
      invocation: "second",
      revision: coverage_witness_revision,
    ),
  ) {
    IndependenceUnestablished { shared_classifier_identity: _ } => true
    SharedRun { run_identity: _ } => false
    DistinctProcedureDenominatorEstablished {
      enumeration_classifier_identity: _,
      classification_classifier_identity: _,
    } => false
  }
}

test fn witness_two_distinct_classifiers_establish_independence() -> Bool {
  census_independence_is_established(
    independence: census_resolve_independence(
      enumeration_run: coverage_witness_enumeration_run(),
      classification_run: coverage_witness_classification_run(),
    ),
  )
}

data coverage_blocker_four_note: String = "BLOCKER 4 WITNESSES. A capability receipt exists only when its contract names the classifier that actually ran, checked at identity grain, and when any conformance control it carries names the same classifier at the same revision under a DIFFERENT invocation. Each of those three refusals gets its own witness."

fn coverage_witness_capability_for(contract_name: String) -> gunbc.repository_census_coverage.CensusMethodCapability {
  gunbc.repository_census_coverage.ClassifiesDeclaredStructure { contract: coverage_witness_decl(name: contract_name) }
}

// THE CONFORMANCE FIXTURES BUILD REAL CONTROL OUTCOMES, because the carrier no longer accepts an assertion about them. Each control here is an actual census_establish_coverage run against a denominator: the discriminating control observes rows that do NOT reconcile with the declared subjects and must come back CoverageRefused, the positive control observes rows that DO and must come back CoverageEstablished. A fixture that simply claimed those two results is no longer expressible, which is the point of the recut.
fn coverage_witness_control_outcome(
  subjects: List<gunbc.repository_census_observation.CensusSubjectKey>,
  rows: List<gunbc.repository_census_observation.CensusObservedRow>,
  invocation: String,
  revision: gunbc.guarantee_measurement.MeasurementRevision,
) -> gunbc.repository_census_coverage.CensusCoverageOutcome {
  census_establish_coverage(
    denominator: coverage_witness_denominator_of(
      population: coverage_witness_population,
      revision: coverage_witness_revision,
      subjects: subjects,
    ),
    observation: coverage_witness_observation_of(
      population: coverage_witness_population,
      revision: coverage_witness_revision,
      rows: rows,
      run: coverage_witness_run_at(
        classifier: "coverage_witness_classifier",
        invocation: invocation,
        revision: revision,
      ),
    ),
  )
}

fn coverage_witness_control_pair_at(
  invocation: String,
  revision: gunbc.guarantee_measurement.MeasurementRevision,
) -> gunbc.repository_census_coverage.CensusControlPair {
  gunbc.repository_census_coverage.CensusControlPair {
    control_run: coverage_witness_run_at(
      classifier: "coverage_witness_classifier",
      invocation: invocation,
      revision: revision,
    ),
    discriminating: coverage_witness_control_outcome(
      subjects: coverage_witness_ab_subjects,
      rows: [coverage_witness_row(name: "a")],
      invocation: invocation,
      revision: revision,
    ),
    positive: coverage_witness_control_outcome(
      subjects: coverage_witness_ab_subjects,
      rows: coverage_witness_ab_rows,
      invocation: invocation,
      revision: revision,
    ),
  }
}

fn coverage_witness_conformance_outcome_for(pair: gunbc.repository_census_coverage.CensusControlPair) -> gunbc.repository_census_coverage.CensusConformanceOutcome {
  census_method_conformance_receipt(
    pair: pair,
    method_run: coverage_witness_classification_run(),
  )
}

fn coverage_witness_conforming_control() -> gunbc.repository_census_coverage.CensusMethodConformanceReceipt? {
  census_conformance_receipt_of(
    outcome: coverage_witness_conformance_outcome_for(
      pair: coverage_witness_control_pair_at(
        invocation: "control",
        revision: coverage_witness_revision,
      ),
    ),
  )
}

fn coverage_witness_receipt_exists(
  capability: gunbc.repository_census_coverage.CensusMethodCapability,
  conformance: gunbc.repository_census_coverage.CensusMethodConformanceReceipt?,
) -> Bool {
  match census_method_capability_receipt(
    observation: coverage_witness_observation(rows: coverage_witness_ab_rows),
    capability: capability,
    conformance: conformance,
  ) {
    Present { value: _ } => true
    Absent => false
  }
}

test fn witness_two_executed_controls_that_discriminate_yield_a_conformance_receipt() -> Bool {
  match coverage_witness_conformance_outcome_for(
    pair: coverage_witness_control_pair_at(
      invocation: "control",
      revision: coverage_witness_revision,
    ),
  ) {
    CensusConformanceEstablished { receipt: _ } => true
    CensusConformanceControlOutcomesUnjoined {
      control_run_identity: _,
      discriminating_run_identity: _,
      positive_run_identity: _,
    } => false
    CensusConformanceControlNotDistinctFromMeasurement {
      control_run_identity: _,
      method_run_identity: _,
    } => false
    CensusConformanceControlsDidNotDiscriminate { discriminating: _, positive: _ } => false
  }
}

test fn witness_a_control_pair_that_refused_nothing_does_not_establish_conformance() -> Bool {
  let invocation = "control"
  match coverage_witness_conformance_outcome_for(
    pair: gunbc.repository_census_coverage.CensusControlPair {
      control_run: coverage_witness_run_at(
        classifier: "coverage_witness_classifier",
        invocation: invocation,
        revision: coverage_witness_revision,
      ),
      discriminating: coverage_witness_control_outcome(
        subjects: coverage_witness_ab_subjects,
        rows: coverage_witness_ab_rows,
        invocation: invocation,
        revision: coverage_witness_revision,
      ),
      positive: coverage_witness_control_outcome(
        subjects: coverage_witness_ab_subjects,
        rows: coverage_witness_ab_rows,
        invocation: invocation,
        revision: coverage_witness_revision,
      ),
    },
  ) {
    CensusConformanceControlsDidNotDiscriminate { discriminating: _, positive: _ } => true
    CensusConformanceEstablished { receipt: _ } => false
    CensusConformanceControlOutcomesUnjoined {
      control_run_identity: _,
      discriminating_run_identity: _,
      positive_run_identity: _,
    } => false
    CensusConformanceControlNotDistinctFromMeasurement {
      control_run_identity: _,
      method_run_identity: _,
    } => false
  }
}

test fn witness_a_control_pair_that_accepted_nothing_does_not_establish_conformance() -> Bool {
  let invocation = "control"
  match coverage_witness_conformance_outcome_for(
    pair: gunbc.repository_census_coverage.CensusControlPair {
      control_run: coverage_witness_run_at(
        classifier: "coverage_witness_classifier",
        invocation: invocation,
        revision: coverage_witness_revision,
      ),
      discriminating: coverage_witness_control_outcome(
        subjects: coverage_witness_ab_subjects,
        rows: [coverage_witness_row(name: "a")],
        invocation: invocation,
        revision: coverage_witness_revision,
      ),
      positive: coverage_witness_control_outcome(
        subjects: coverage_witness_ab_subjects,
        rows: [coverage_witness_row(name: "a")],
        invocation: invocation,
        revision: coverage_witness_revision,
      ),
    },
  ) {
    CensusConformanceControlsDidNotDiscriminate { discriminating: _, positive: _ } => true
    CensusConformanceEstablished { receipt: _ } => false
    CensusConformanceControlOutcomesUnjoined {
      control_run_identity: _,
      discriminating_run_identity: _,
      positive_run_identity: _,
    } => false
    CensusConformanceControlNotDistinctFromMeasurement {
      control_run_identity: _,
      method_run_identity: _,
    } => false
  }
}

test fn witness_a_control_reusing_the_measured_invocation_establishes_no_conformance() -> Bool {
  match coverage_witness_conformance_outcome_for(
    pair: coverage_witness_control_pair_at(
      invocation: "classify",
      revision: coverage_witness_revision,
    ),
  ) {
    CensusConformanceControlNotDistinctFromMeasurement {
      control_run_identity: _,
      method_run_identity: _,
    } => true
    CensusConformanceEstablished { receipt: _ } => false
    CensusConformanceControlOutcomesUnjoined {
      control_run_identity: _,
      discriminating_run_identity: _,
      positive_run_identity: _,
    } => false
    CensusConformanceControlsDidNotDiscriminate { discriminating: _, positive: _ } => false
  }
}

