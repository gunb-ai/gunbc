module test.claim.harness_supervisor_guidance_test

import std.types { Bool, String, Int }
import gunbc.roadmap.roadmap_supervisor {
  SupervisorVerdictReceipt, VerdictContinue, VerdictSteer, VerdictPlanDefect, VerdictStuck,
  supervisor_verdict_schema, supervisor_verdict_decode, supervisor_verdict_text, VerdictDecoded, VerdictNotDecodable,
}
import gunbc.harness.harness_supervisor_guidance {
  supervisor_brief_for, supervisor_system_prompt_at, supervisor_verdict_skeleton,
}

// THE BRIEF IS A PROJECTION, and this is the control that proves it: the chain, the check's verdict
// and the observation arrive in the text BECAUSE they were supplied, so changing them changes the
// brief -- a hand-copied brief satisfies nothing here.
test fn the_brief_projects_the_chain_the_check_and_the_observation_verbatim() -> Bool {
  let brief = supervisor_brief_for(
    chain: "L2 task contract: Cron remains the executor; a crontab line remains shell-shaped output",
    check_verdict: "\{\"kind\": \"extremely-misaligned\", \"direction\": \"the worker is rewriting the cron daemon\"}",
    observation: "\{\"role\": \"assistant\", \"content\": \"editing src/cron/daemon.rs\"}",
    adjudicated_turn: 80,
  )
  brief.contains("Cron remains the executor; a crontab line remains shell-shaped output")
    && brief.contains("the worker is rewriting the cron daemon")
    && brief.contains("editing src/cron/daemon.rs")
    && brief.contains("AFTER TURN 80")
}

// THE FOUR ROUTES ARE THE ONLY VERDICTS, each an action the paused session carries out, and the
// shape the supervisor copies decodes through the verdict's own codec -- bound to THIS boundary's
// turn, so the example it writes from is already the receipt the session will read.
test fn the_brief_carries_the_four_routes_and_a_skeleton_that_decodes_for_this_turn() -> Bool {
  let brief = supervisor_brief_for(chain: "c", check_verdict: "v", observation: "o", adjudicated_turn: 40)
  brief.contains(supervisor_verdict_schema as String)
    && brief.contains("- continue:")
    && brief.contains("- steer:")
    && brief.contains("- plan-defect:")
    && brief.contains("- stuck:")
    && brief.contains("the worker never continues against a known-bad plan")
    && (match supervisor_verdict_decode(text: supervisor_verdict_skeleton(adjudicated_turn: 40)) {
      VerdictNotDecodable { reason: _ } => false
      VerdictDecoded { receipt } =>
        receipt.adjudicated_turn == 40
          && (match receipt.verdict { VerdictContinue { basis: _ } => true  _ => false })
    })
}

// EVERY ROUTE ROUND-TRIPS WITH ITS STATEMENT, and the schema wall refuses the stretch-restart shape
// (v1, whose routes the session cannot carry out) rather than reading it as this one.
test fn every_route_round_trips_and_the_v1_shape_refuses() -> Bool {
  let round_trips = [
    VerdictContinue { basis: "the check misread a staged refactor" },
    VerdictSteer { direction: "keep the cron daemon untouched; emit the crontab line only" },
    VerdictPlanDefect { defect: "the brief names a deleted module" },
    VerdictStuck { cause: "the emitter lacks the lowering this needs" },
  ] |> map(v => supervisor_verdict_decode(text: supervisor_verdict_text(receipt: SupervisorVerdictReceipt { adjudicated_turn: 120, verdict: v })))
  let v1 = "\{\"schema\": \"roadmap-supervisor-verdict/v1\", \"attempt_key\": \"a1\", \"adjudicated_turn\": 3, \"route\": \"nominal\", \"statement\": \"renew\"}"
  all(round_trips, d => match d { VerdictDecoded { receipt } => receipt.adjudicated_turn == 120  VerdictNotDecodable { reason: _ } => false })
    && (match supervisor_verdict_decode(text: v1) {
      VerdictNotDecodable { reason } => reason.contains("roadmap-supervisor-verdict/v1")
      VerdictDecoded { receipt: _ } => false
    })
}

// THE ROLE CONTRACT NAMES THE WORKTREE AND THE VERDICT PATH as the session's only completion, and
// keeps the supervisor's hands off the worker's tree.
test fn the_system_prompt_binds_completion_to_the_verdict_file() -> Bool {
  let prompt = supervisor_system_prompt_at(worktree: "/x/attempts/n-a1", verdict_path: "/x/state/n-a1/supervision-supervisor-verdict-after-turn-80.json")
  prompt.contains("/x/attempts/n-a1")
    && prompt.contains("/x/state/n-a1/supervision-supervisor-verdict-after-turn-80.json")
    && prompt.contains("continue, steer, plan-defect or stuck")
    && prompt.contains("do not continue the implementation yourself")
    && prompt.contains("paused until you decide")
}
