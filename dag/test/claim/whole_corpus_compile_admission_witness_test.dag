module test.claim.whole_corpus_compile_admission_witness

data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data witness_subject_note: String = "BOTH ARMS STAND ON INDEPENDENTLY MEASURED MACHINES, which is what makes the pair fail for a reason worth knowing in either direction rather than restating its own input.\n\nThe REFUSING budget is the one the BuildBuddy remote-execution runner actually answered with on invocation 13cf8d2e-173a-42d2-9a56-101bb3332740, the run that was SIGKILLed at exit 137. It is not chosen to make the assertion true: it is recovered from the cap=1675 line that run printed, by inverting the integer division cli_run performs.\n\nThe ADMITTING budget is gunbc.runner_slot_allocation's declared per-slot memory.high, READ FROM THAT AUTHORITY rather than retyped here. Retyping it would have been the exact defect this PR's own threshold note argues against, and it has a live specimen one module over: host_budget_source_witness_test built its expectation from the seed mirror value retyped, so it greened whichever way the mirror went (found by stern-heron-695, corrected in gunbc#8638). A fixture input is still an input, and one that silently tracks nothing is worse than one that fails. So a refusal that stopped firing would mean the measured doomed run had become admissible, and an admission that stopped holding would mean CI's own runner had been refused — two different regressions, each with its own arm here."

fn observed_doomed_budget() -> gunbc.host_budget_source.HostBudgetResolution {
  gunbc.host_budget_source.HostBudgetResolved {
    source: gunbc.host_budget_source.BudgetSourceMemAvailable,
    bytes: gunbc.whole_corpus_compile_admission.whole_corpus_compile_observed_runner_budget_lower_bound,
  }
}

fn fleet_runner_slot_budget() -> gunbc.host_budget_source.HostBudgetResolution {
  gunbc.host_budget_source.HostBudgetResolved {
    source: gunbc.host_budget_source.BudgetSourceCgroupMemoryHigh {
      cgroup_dir: "/sys/fs/cgroup/system.slice/system-actions-runner.slice/actions-runner@srv1-01.service" as std.types.NonEmptyStr,
    },
    bytes: gunbc.runner_slot_allocation.gunbc_runner_slot_desired().memory_high,
  }
}

test fn the_budget_that_was_sigkilled_refuses_and_names_its_source() -> Bool {
  match gunbc.whole_corpus_compile_admission.whole_corpus_compile_admission(budget: observed_doomed_budget()) {
    WholeCorpusCompileRefusedBudgetBelowMeasuredDemand {
      budget: b,
      required: r,
      source: s,
    } => std.measure.byte_size_count(b: b) == 5269094400
      && std.measure.byte_size_count(b: r) == 7516192768
      && (s as String) == "/proc/meminfo MemAvailable"
    WholeCorpusCompileAdmitted { budget: _, required: _ } => false
    WholeCorpusCompileRefusedBudgetUnreadable { reason: _ } => false
  }
}

test fn the_runner_ci_actually_uses_is_admitted() -> Bool {
  gunbc.whole_corpus_compile_admission.whole_corpus_compile_admits(a: gunbc.whole_corpus_compile_admission.whole_corpus_compile_admission(budget: fleet_runner_slot_budget()))
}

test fn admission_is_tight_at_the_measured_demand() -> Bool {
  let demand = std.measure.byte_size_count(b: gunbc.whole_corpus_compile_admission.whole_corpus_compile_measured_peak_demand())
  gunbc.whole_corpus_compile_admission.whole_corpus_compile_admits(
    a: gunbc.whole_corpus_compile_admission.whole_corpus_compile_admission(
      budget: gunbc.host_budget_source.HostBudgetResolved { source: gunbc.host_budget_source.BudgetSourceMemAvailable, bytes: std.measure.byte_size(demand) }
    )
  )
    && !gunbc.whole_corpus_compile_admission.whole_corpus_compile_admits(
      a: gunbc.whole_corpus_compile_admission.whole_corpus_compile_admission(
        budget: gunbc.host_budget_source.HostBudgetResolved {
          source: gunbc.host_budget_source.BudgetSourceMemAvailable,
          bytes: std.measure.byte_size(demand - 1),
        }
      )
    )
}

test fn an_unreadable_budget_refuses_rather_than_admitting_the_widest_cap() -> Bool {
  match gunbc.whole_corpus_compile_admission.whole_corpus_compile_admission(
    budget: gunbc.host_budget_source.HostBudgetUnreadable {
      reason: "no modeled host memory source answered on this platform" as std.types.NonEmptyStr,
    }
  ) {
    WholeCorpusCompileRefusedBudgetUnreadable { reason: r } => !((r as String) == "")
    WholeCorpusCompileAdmitted { budget: _, required: _ } => false
    WholeCorpusCompileRefusedBudgetBelowMeasuredDemand { budget: _, required: _, source: _ } => false
  }
}
