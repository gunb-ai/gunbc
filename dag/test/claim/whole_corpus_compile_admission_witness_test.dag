module test.claim.whole_corpus_compile_admission_witness

import std.types { Bool, String, NonEmptyStr, Int, List }
import std.measure { ByteSize, byte_size, byte_size_count }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import gunbc.host_budget_source {
  HostBudgetResolution,
  HostBudgetResolved,
  HostBudgetUnreadable,
  BudgetSourceCgroupMemoryHigh,
  host_budget_resolved_observation,
}
import gunbc.runner_slot_allocation { gunbc_runner_slot_desired }
import gunbc.whole_corpus_compile_admission {
  WholeCorpusCompileAdmission,
  WholeCorpusCompileAdmitted,
  WholeCorpusCompileRefusedBudgetBelowMeasuredDemand,
  WholeCorpusCompileRefusedBudgetUnreadable,
  WholeCorpusCompileRefusedUnmeasuredRoot,
  WholeCorpusCompileRefusedDemandsForAnotherRepository,
  WholeCorpusCompileDemand,
  WholeCorpusCompileDemandsRead,
  DemandsProjectionNotDeclared,
  DemandsProjectionUnreadable,
  DemandsProjectionRead,
  NoDemandsProjectionDeclared,
  DemandsProjectionNotRead,
  NoRowForRoot,
  WholeCorpusCompileRootIdentity,
  MeasuredForRoot,
  UnmeasuredRoot,
  whole_corpus_compile_admission,
  whole_corpus_compile_admits,
  whole_corpus_compile_demand_for_root,
  whole_corpus_compile_public_root,
  whole_corpus_compile_public_root_demand,
  whole_corpus_compile_public_root_census,
  whole_corpus_compile_public_root_receipt,
  whole_corpus_compile_measured_root_demands,
  whole_corpus_compile_observed_runner_budget_lower_bound,
}
import gunbc.repository_census_observation { RepositoryIdentity, SourceRootIdentity }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data witness_subject_note: String = "BOTH ARMS STAND ON INDEPENDENTLY MEASURED MACHINES, which is what makes the pair fail for a reason worth knowing in either direction rather than restating its own input.\n\nThe REFUSING budget is the one the BuildBuddy remote-execution runner actually answered with on invocation 13cf8d2e-173a-42d2-9a56-101bb3332740, the run that was SIGKILLed at exit 137. It is not chosen to make the assertion true: it is recovered from the cap=1675 line that run printed, by inverting the integer division cli_run performs.\n\nTHE SOURCE ON THAT FIXTURE MOVED AND THE BUDGET DID NOT. It was BudgetSourceMemAvailable, the arm that produced the doomed number in the first place; that arm is deleted (gunbc.host_budget_source host_budget_source_seed_mirror_disposition) because a reading about the MACHINE is not a bound on the slot, and a runner in that state now resolves to HostBudgetUnreadable and refuses before this arm is reached. What this row judges is the QUANTITY, so the fixture is now carried on BudgetSourceEnvOverride — which is precisely the shape an operator on that runner produces today, and it makes the arm say something sharper than it did: even a 4.9 GiB budget DECLARED by an operator is refused against the measured demand.\n\nThe ADMITTING budget is gunbc.runner_slot_allocation's declared per-slot memory.high, READ FROM THAT AUTHORITY rather than retyped here. Retyping it would have been the exact defect this PR's own threshold note argues against, and it has a live specimen one module over: host_budget_source_witness_test built its expectation from the seed mirror value retyped, so it greened whichever way the mirror went (found by stern-heron-695, corrected in gunbc#8638). A fixture input is still an input, and one that silently tracks nothing is worse than one that fails. So a refusal that stopped firing would mean the measured doomed run had become admissible, and an admission that stopped holding would mean CI's own runner had been refused — two different regressions, each with its own arm here."

// The public root's measured peak, READ FROM ITS ROW rather than retyped, so every arm below asserts
// a relation to the row and survives a re-measure without an edit.
fn public_root_peak() -> Int {
  match whole_corpus_compile_public_root_demand {
    MeasuredForRoot { root: _, census: _, peak: p, receipt: _ } => byte_size_count(b: p)
    UnmeasuredRoot { root: _ } => 0
  }
}

// The rows as the seed receives them: a projection that read, at a fixture location.
fn read_of(demands: List<WholeCorpusCompileDemand>) -> WholeCorpusCompileDemandsRead {
  DemandsProjectionRead { location: "fixture/measured_root_demands.json" as NonEmptyStr, demands: demands }
}

fn admit_public_root(budget: HostBudgetResolution) -> WholeCorpusCompileAdmission {
  whole_corpus_compile_admission(
    budget: budget,
    root: whole_corpus_compile_public_root,
    read: read_of(demands: whole_corpus_compile_measured_root_demands),
  )
}

fn observed_doomed_budget() -> HostBudgetResolution {
  host_budget_resolved_observation(
    source: BudgetSourceCgroupMemoryHigh { cgroup_dir: "/sys/fs/cgroup/runner.slice" },
    bytes: whole_corpus_compile_observed_runner_budget_lower_bound
  )
}

// TWO FIXTURES, BECAUSE THEY ARE TWO DIFFERENT CLAIMS AND ONE OF THEM USED TO IMPERSONATE THE
// OTHER. The single fixture this replaces took its bytes from `gunbc_runner_slot_desired()` -- a
// DESIRED row -- while naming a real live cgroup path, so it read as an observation of srv1-01 and
// silently changed meaning the moment the desired row moved.

// WHAT EVERY RUNNER SLOT IN THE FLEET ACTUALLY CARRIES TODAY, read back from converged hosts:
// memory.high = 16106127360. This is the observation, and it is the control that must keep
// refusing across any sizing change.
fn fleet_runner_slot_effective_budget() -> HostBudgetResolution {
  host_budget_resolved_observation(
    source: BudgetSourceCgroupMemoryHigh {
      cgroup_dir: "/sys/fs/cgroup/system.slice/system-actions-runner.slice/actions-runner@srv1-01.service" as NonEmptyStr,
    },
    bytes: byte_size(16106127360)
  )
}

// THE DESIRED ROW, NAMED AS DESIRED. No cgroup on any host reports this value, so the source is
// labelled for what it is rather than borrowing a live unit's path -- a fixture that names a real
// cgroup is asserting a readback, and this one has none to assert.
fn fleet_runner_slot_desired_budget() -> HostBudgetResolution {
  host_budget_resolved_observation(
    source: BudgetSourceCgroupMemoryHigh {
      cgroup_dir: "<desired row: gunbc.runner_slot_allocation gunbc_runner_slot_desired, not observed on any host>" as NonEmptyStr,
    },
    bytes: gunbc_runner_slot_desired().memory_high
  )
}

// THE REQUIRED FIGURE IS DERIVED, NOT TRANSCRIBED. This arm asserted `r == 7516192768` -- a copy
// of the authority's own constant, which made it a change detector: the only way to close it after
// a re-measure was to hand-edit the expectation to whatever the authority now says, which is the
// self-comparison DESIGN section 5's oracle rule names. It caught nothing and cost a red on the
// 2026-08-28 re-measure. Derived from the public root row's peak it asserts the
// RELATION the arm exists for -- the refusal reports the authority's figure and not some other --
// and it survives every future re-measure without an edit.
//
// THE BUDGET LITERAL STAYS A LITERAL, and the asymmetry is deliberate: 5269094400 is a DATED
// EXTERNAL RECEIPT, the MemAvailable lower bound of the runner that SIGKILLed this instrument
// twice. It is not a number from this tree, so it is an oracle in exactly the sense the demand
// figure was not.
//
// THE SOURCE HALF MOVED AND THE BUDGET HALF DID NOT, which is why the expected label changed
// here rather than being loosened. BudgetSourceMemAvailable is the arm that produced this very
// number and it is deleted, so a runner in that state now resolves to HostBudgetUnreadable and
// refuses one step earlier. What this arm still judges is the QUANTITY reaching the demand
// comparison, and the source that carries it today is the operator's declaration -- so the
// assertion says something sharper than it did: even 4.9 GiB DECLARED by an operator is refused,
// and the refusal still names where the number came from rather than reporting a bare figure.
test fn the_budget_that_was_sigkilled_refuses_and_names_its_source() -> Bool {
  match admit_public_root(budget: observed_doomed_budget()) {
    WholeCorpusCompileRefusedBudgetBelowMeasuredDemand {
      budget: b,
      required: r,
      source: s,
    } => byte_size_count(b: b) == 5269094400
      && byte_size_count(b: r) == public_root_peak()
      && string_contains(s: s as String, pattern: "memory.high")
    WholeCorpusCompileAdmitted { budget: _, required: _ } => false
    WholeCorpusCompileRefusedBudgetUnreadable { reason: _ } => false
    WholeCorpusCompileRefusedUnmeasuredRoot { root: _, cause: _, recipe: _ } => false
    WholeCorpusCompileRefusedDemandsForAnotherRepository { root: _, location: _, projected_repositories: _ } => false
  }
}

// THE RECEIPT THAT THE FAIL-OPEN CLOSED. Until 2026-08-28 the demand figure was 7 GiB, a PROXY
// taken on the floor route at an older tree; the whole-corpus peak measured on the compile route
// itself is 12.41 GiB. So this arm admitted a 7 GiB host and that host would then have been
// SIGKILLed -- a refusal that exists and cannot fire for the population needing it, which is not
// conservatism but the shape DESIGN section 5 names, where the deficit's frequency is zero by
// construction.
//
// 7516192768 is written here as a LITERAL on purpose and it is not a tree copy: it is the
// superseded figure, a historical fact that does not move, and this arm's whole content is that
// the value the old authority admitted is now refused. It is progress-safe because a demand
// figure does not shrink with corpus growth -- the row says so and the re-measure trigger only
// fires upward -- so no legitimate future measurement makes this arm red.
test fn the_budget_the_superseded_figure_admitted_is_now_refused() -> Bool {
  whole_corpus_compile_admits(
    a: admit_public_root(
      budget: host_budget_resolved_observation(
        source: BudgetSourceCgroupMemoryHigh { cgroup_dir: "/sys/fs/cgroup/runner.slice" },
        bytes: byte_size(7516192768)
      ))) == false
}

// THIS ROW WAS INVERTED, NOT EDITED TO STAY GREEN, and the distinction is the whole reason it
// carries a note. It asserted the_runner_ci_actually_uses_is_admitted. Raising the declared demand
// to cover the highest measured COMPLETING peak (gunbc.whole_corpus_compile_admission
// whole_corpus_compile_measured_demand_note, review 57202 on gunbc#9545) put the threshold above
// the runner slot's reported budget, so the previous assertion became false about the tree. The two
// available responses were to change what the row asserts or to change the threshold until the row
// stayed true; the second is the failure this whole module exists to refuse, since it derives a
// safety literal from the outcome someone wanted.
//
// WHAT IT NOW ASSERTS AND WHY THAT IS THE CORRECT VERDICT RATHER THAN A CONCESSION. The budget
// resolved from a slot is memory_high -- the line the host has agreed to give before it throttles
// -- and the demand exceeds it. A completing run would in fact survive there, degrading into swap
// below the 16 GiB memory_max kill line, so this is an over-refusal measured against SURVIVAL and
// an exact refusal measured against the BUDGET. An admission arm that admits on the grounds that a
// host tolerates breaches past its own stated line is not fail-closed, so the refusal is the
// modelled answer and the survival margin is a fact about the host, not a licence.
//
// WHAT WOULD MAKE THIS ROW FLIP BACK: a slot provisioned above the demand, or a re-measured demand
// that is genuinely lower under this module's own re-measure trigger -- which only fires on a
// HIGHER reading, so the second path requires the trigger to be changed on its own argument and not
// as a side effect of wanting this green.

// THE LIVE SLOT IS STILL REFUSED, and this row is unchanged in substance: 15 GiB sits below the
// completing peak demand, so a whole-corpus compile on a real runner refuses. The 2026-09-12 sizing
// change does not touch it, which is the point of keeping it separate from the desired row below.
test fn the_runner_ci_actually_uses_is_refused_at_the_completing_peak_demand() -> Bool {
  whole_corpus_compile_admits(a: admit_public_root(budget: fleet_runner_slot_effective_budget())) == false
}

// THE DESIRED ROW ADMITS, BY POLICY, AND THIS ROW SAYS SO RATHER THAN LEAVING THE FLIP UNSTATED.
// 25 GiB clears the 16 GiB measured demand. The threshold is NOT adjusted to preserve the old
// answer -- choosing a rule to keep an assertion green is the reverse of an oracle.
//
// WHAT IT DOES NOT ESTABLISH: that any host can honour it. No fleet member carries this limit, so a
// run admitted on this basis would still meet the effective ceiling asserted above. Whether
// admission can outrun effective configuration is a separate open question and this fixture is
// deliberately not evidence either way.
test fn the_desired_row_admits_and_is_not_an_observation_of_any_host() -> Bool {
  whole_corpus_compile_admits(a: admit_public_root(budget: fleet_runner_slot_desired_budget()))
}

test fn admission_is_tight_at_the_measured_demand() -> Bool {
  let demand = public_root_peak()
  whole_corpus_compile_admits(
    a: admit_public_root(
      budget: host_budget_resolved_observation(
        source: BudgetSourceCgroupMemoryHigh { cgroup_dir: "/sys/fs/cgroup/runner.slice" },
        bytes: byte_size(demand)
      )
    )
  )
    && !whole_corpus_compile_admits(
      a: admit_public_root(
        budget: host_budget_resolved_observation(
          source: BudgetSourceCgroupMemoryHigh { cgroup_dir: "/sys/fs/cgroup/runner.slice" },
          bytes: byte_size(demand - 1)
        )
      )
    )
}

test fn an_unreadable_budget_refuses_rather_than_admitting_the_widest_cap() -> Bool {
  match admit_public_root(
    budget: HostBudgetUnreadable {
      reason: "no modeled host memory source answered on this platform" as NonEmptyStr,
    }
  ) {
    WholeCorpusCompileRefusedBudgetUnreadable { reason: r } => !((r as String) == "")
    WholeCorpusCompileAdmitted { budget: _, required: _ } => false
    WholeCorpusCompileRefusedBudgetBelowMeasuredDemand { budget: _, required: _, source: _ } => false
    WholeCorpusCompileRefusedUnmeasuredRoot { root: _, cause: _, recipe: _ } => false
    WholeCorpusCompileRefusedDemandsForAnotherRepository { root: _, location: _, projected_repositories: _ } => false
  }
}

// THE ROOT JOIN, EXECUTING. Each arm below varies ONE coordinate of the root identity against the
// public row and holds the budget at a figure the public row admits by a wide margin, so a refusal
// is the join refusing and never the budget. Without the join all four would admit: that is the
// population-blind constant this change deletes.
fn ample_budget() -> HostBudgetResolution {
  host_budget_resolved_observation(
    source: BudgetSourceCgroupMemoryHigh { cgroup_dir: "/sys/fs/cgroup/runner.slice" },
    bytes: byte_size(public_root_peak() * 4)
  )
}

fn refuses_as_unmeasured(a: WholeCorpusCompileAdmission, root: WholeCorpusCompileRootIdentity) -> Bool {
  match a {
    WholeCorpusCompileRefusedUnmeasuredRoot { root: r, cause: _, recipe: rc } =>
      (r.repository as String) == (root.repository as String)
        && (r.primary_root as String) == (root.primary_root as String)
        && string_contains(s: rc as String, pattern: concat("--source-root ", root.primary_root as String))
        && string_contains(s: rc as String, pattern: "MeasuredForRoot")
        && string_contains(s: rc as String, pattern: "gunbc measure-root-demand")
    WholeCorpusCompileAdmitted { budget: _, required: _ } => false
    WholeCorpusCompileRefusedBudgetBelowMeasuredDemand { budget: _, required: _, source: _ } => false
    WholeCorpusCompileRefusedBudgetUnreadable { reason: _ } => false
    WholeCorpusCompileRefusedDemandsForAnotherRepository { root: _, location: _, projected_repositories: _ } => false
  }
}

// POSITIVE CONTROL for the arms below: the same ample budget admits the public root, so the
// harness produces an admission and the refusals are findings rather than a rig that never admits.
test fn the_public_root_admits_at_an_ample_budget() -> Bool {
  whole_corpus_compile_admits(a: admit_public_root(budget: ample_budget()))
}

test fn an_unmeasured_root_refuses_naming_its_measurement_recipe() -> Bool {
  let private_root = WholeCorpusCompileRootIdentity {
    repository: "gunbc" as RepositoryIdentity,
    primary_root: "strategy" as SourceRootIdentity,
    dependency_pools: ["dag" as SourceRootIdentity],
  }
  refuses_as_unmeasured(
    a: whole_corpus_compile_admission(
      budget: ample_budget(),
      root: private_root,
      read: read_of(demands: whole_corpus_compile_measured_root_demands),
    ),
    root: private_root,
  )
}

// The repository is part of the key: a second repository spelling the SAME roots does not join the
// public row. This repository's projection carries only its own repository, so handing it to that
// compile is refused as ANOTHER REPOSITORY'S projection -- the direction that would have admitted a
// larger root on an undercounting number.
fn refuses_as_another_repository(a: WholeCorpusCompileAdmission, expect_projected: String) -> Bool {
  match a {
    WholeCorpusCompileRefusedDemandsForAnotherRepository { root: _, location: _, projected_repositories: rs } =>
      count(rs) > 0 && fold(rs, init: true, f: fn(acc, r) { acc && (r as String) == expect_projected })
    WholeCorpusCompileAdmitted { budget: _, required: _ } => false
    WholeCorpusCompileRefusedBudgetBelowMeasuredDemand { budget: _, required: _, source: _ } => false
    WholeCorpusCompileRefusedBudgetUnreadable { reason: _ } => false
    WholeCorpusCompileRefusedUnmeasuredRoot { root: _, cause: _, recipe: _ } => false
  }
}

test fn the_same_root_spelling_in_another_repository_does_not_join_the_public_row() -> Bool {
  let same_spelling = WholeCorpusCompileRootIdentity {
    repository: "gunbc-private" as RepositoryIdentity,
    primary_root: "dag" as SourceRootIdentity,
    dependency_pools: ["src/v2" as SourceRootIdentity],
  }
  refuses_as_another_repository(
    a: whole_corpus_compile_admission(
      budget: ample_budget(),
      root: same_spelling,
      read: read_of(demands: whole_corpus_compile_measured_root_demands),
    ),
    expect_projected: "gunbc",
  )
}

// The pools are part of the key: the public primary root with a different pool set is a different
// subject, including the empty pool set, which a name-census-tracking resident set prices differently.
test fn the_public_primary_root_with_different_pools_is_unmeasured() -> Bool {
  let no_pools = WholeCorpusCompileRootIdentity {
    repository: "gunbc" as RepositoryIdentity,
    primary_root: "dag" as SourceRootIdentity,
    dependency_pools: [],
  }
  let v2_primary = WholeCorpusCompileRootIdentity {
    repository: "gunbc" as RepositoryIdentity,
    primary_root: "src/v2" as SourceRootIdentity,
    dependency_pools: ["dag" as SourceRootIdentity],
  }
  refuses_as_unmeasured(
    a: whole_corpus_compile_admission(budget: ample_budget(), root: no_pools, read: read_of(demands: whole_corpus_compile_measured_root_demands)),
    root: no_pools,
  )
    && refuses_as_unmeasured(
      a: whole_corpus_compile_admission(budget: ample_budget(), root: v2_primary, read: read_of(demands: whole_corpus_compile_measured_root_demands)),
      root: v2_primary,
    )
}

// A MeasuredForRoot row for a DIFFERENT root does not admit this one at any budget: the roster here
// holds ONLY a row for another root, with a peak far below the budget, and the public root still
// refuses as unmeasured. Root identity is the join, not a label on a number.
test fn a_row_for_a_different_root_never_admits_this_one() -> Bool {
  let other_root_row = MeasuredForRoot {
    root: WholeCorpusCompileRootIdentity {
      repository: "gunbc" as RepositoryIdentity,
      primary_root: "src/v2" as SourceRootIdentity,
      dependency_pools: ["dag" as SourceRootIdentity],
    },
    census: whole_corpus_compile_public_root_census,
    peak: byte_size(1),
    receipt: whole_corpus_compile_public_root_receipt,
  }
  refuses_as_unmeasured(
    a: whole_corpus_compile_admission(
      budget: ample_budget(),
      root: whole_corpus_compile_public_root,
      read: read_of(demands: [other_root_row]),
    ),
    root: whole_corpus_compile_public_root,
  )
}

// Pinned by the join and not by position: with the other root's row FIRST, the public root still
// resolves to its own row.
test fn the_public_root_resolves_to_its_own_row_past_another_roots_row() -> Bool {
  let other = MeasuredForRoot {
    root: WholeCorpusCompileRootIdentity {
      repository: "gunbc" as RepositoryIdentity,
      primary_root: "src/v2" as SourceRootIdentity,
      dependency_pools: ["dag" as SourceRootIdentity],
    },
    census: whole_corpus_compile_public_root_census,
    peak: byte_size(1),
    receipt: whole_corpus_compile_public_root_receipt,
  }
  match whole_corpus_compile_demand_for_root(
    root: whole_corpus_compile_public_root,
    demands: [other, whole_corpus_compile_public_root_demand],
  ) {
    MeasuredForRoot { root: _, census: _, peak: p, receipt: _ } => byte_size_count(b: p) == public_root_peak()
    UnmeasuredRoot { root: _ } => false
  }
}

// The pool comparison is ordered and element-wise: reversed pools, and one pool whose spelling
// joins two, are both different subjects from the public root's.
test fn pool_order_and_element_boundaries_are_part_of_the_key() -> Bool {
  let reversed = WholeCorpusCompileRootIdentity {
    repository: "gunbc" as RepositoryIdentity,
    primary_root: "dag" as SourceRootIdentity,
    dependency_pools: ["src/v2" as SourceRootIdentity, "extdeps" as SourceRootIdentity],
  }
  let listed = WholeCorpusCompileRootIdentity {
    repository: "gunbc" as RepositoryIdentity,
    primary_root: "dag" as SourceRootIdentity,
    dependency_pools: ["extdeps" as SourceRootIdentity, "src/v2" as SourceRootIdentity],
  }
  let joined = WholeCorpusCompileRootIdentity {
    repository: "gunbc" as RepositoryIdentity,
    primary_root: "dag" as SourceRootIdentity,
    dependency_pools: ["extdeps, src/v2" as SourceRootIdentity],
  }
  let row = MeasuredForRoot {
    root: listed,
    census: whole_corpus_compile_public_root_census,
    peak: byte_size(1),
    receipt: whole_corpus_compile_public_root_receipt,
  }
  whole_corpus_compile_admits(a: whole_corpus_compile_admission(budget: ample_budget(), root: listed, read: read_of(demands: [row])))
    && refuses_as_unmeasured(a: whole_corpus_compile_admission(budget: ample_budget(), root: reversed, read: read_of(demands: [row])), root: reversed)
    && refuses_as_unmeasured(a: whole_corpus_compile_admission(budget: ample_budget(), root: joined, read: read_of(demands: [row])), root: joined)
}

// THE READ OUTCOMES, EXECUTING. The rows reach the seed as a projection read from a location the
// run is handed, so the admission is asked about the READ, not a list. Each arm holds the budget
// ample and the root at the public root, whose row the positive control admits.
fn unmeasured_cause_is(a: WholeCorpusCompileAdmission, expect: String) -> Bool {
  match a {
    WholeCorpusCompileRefusedUnmeasuredRoot { root: _, cause: c, recipe: _ } => match c {
      NoDemandsProjectionDeclared => expect == "not-declared"
      DemandsProjectionNotRead { location: l, reason: _ } => expect == concat("not-read:", l as String)
      NoRowForRoot { location: l } => expect == concat("no-row:", l as String)
    }
    WholeCorpusCompileAdmitted { budget: _, required: _ } => false
    WholeCorpusCompileRefusedBudgetBelowMeasuredDemand { budget: _, required: _, source: _ } => false
    WholeCorpusCompileRefusedBudgetUnreadable { reason: _ } => false
    WholeCorpusCompileRefusedDemandsForAnotherRepository { root: _, location: _, projected_repositories: _ } => false
  }
}

// No location handed: refused as unmeasured -- never the public row by default.
test fn no_declared_projection_refuses_rather_than_defaulting_to_the_public_row() -> Bool {
  unmeasured_cause_is(
    a: whole_corpus_compile_admission(budget: ample_budget(), root: whole_corpus_compile_public_root, read: DemandsProjectionNotDeclared),
    expect: "not-declared",
  )
}

// A location that does not read carries its location and reason: a missing file is not a missing row.
test fn an_unreadable_projection_refuses_naming_its_location() -> Bool {
  unmeasured_cause_is(
    a: whole_corpus_compile_admission(
      budget: ample_budget(),
      root: whole_corpus_compile_public_root,
      read: DemandsProjectionUnreadable { location: "tools/absent.json" as NonEmptyStr, reason: "No such file or directory" as NonEmptyStr },
    ),
    expect: "not-read:tools/absent.json",
  )
}

// A projection that read and holds rows of this repository but none for this root: unmeasured,
// with the location it looked in.
test fn a_read_projection_with_no_row_for_the_root_names_where_it_looked() -> Bool {
  let v2_primary = WholeCorpusCompileRootIdentity {
    repository: "gunbc" as RepositoryIdentity,
    primary_root: "src/v2" as SourceRootIdentity,
    dependency_pools: ["dag" as SourceRootIdentity],
  }
  unmeasured_cause_is(
    a: whole_corpus_compile_admission(budget: ample_budget(), root: v2_primary, read: read_of(demands: whole_corpus_compile_measured_root_demands)),
    expect: "no-row:fixture/measured_root_demands.json",
  )
}

// ANOTHER REPOSITORY'S PROJECTION handed to this compile: a row whose identity key is the public
// root's in every coordinate but the repository, with a peak far below the budget, refuses with
// the repository it carried rather than admitting or reading as merely unmeasured.
test fn another_repositorys_projection_refuses_with_a_typed_mismatch() -> Bool {
  let private_row = MeasuredForRoot {
    root: WholeCorpusCompileRootIdentity {
      repository: "gunbc-private" as RepositoryIdentity,
      primary_root: "dag" as SourceRootIdentity,
      dependency_pools: ["src/v2" as SourceRootIdentity],
    },
    census: whole_corpus_compile_public_root_census,
    peak: byte_size(1),
    receipt: whole_corpus_compile_public_root_receipt,
  }
  match whole_corpus_compile_admission(
    budget: ample_budget(),
    root: whole_corpus_compile_public_root,
    read: read_of(demands: [private_row]),
  ) {
    WholeCorpusCompileRefusedDemandsForAnotherRepository { root: _, location: _, projected_repositories: rs } =>
      count(rs) == 1 && fold(rs, init: true, f: fn(acc, r) { acc && (r as String) == "gunbc-private" })
    WholeCorpusCompileAdmitted { budget: _, required: _ } => false
    WholeCorpusCompileRefusedBudgetBelowMeasuredDemand { budget: _, required: _, source: _ } => false
    WholeCorpusCompileRefusedBudgetUnreadable { reason: _ } => false
    WholeCorpusCompileRefusedUnmeasuredRoot { root: _, cause: _, recipe: _ } => false
  }
}

