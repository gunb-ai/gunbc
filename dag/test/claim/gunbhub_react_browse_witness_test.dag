module test.claim.gunbhub_react_browse_witness


data live_tree_disposition: LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn browse_page_html() -> String {
  match extdeps.languages.html.try_serialize_html_source(node: gunbc.gunbhub_serve.gunbhub_browse_page()) {
    extdeps.languages.html.EmitOk { html: h } => h
    extdeps.languages.html.EmitRejected { reason: _ } => ""
  }
}

data gunbhub_browse_html: String = browse_page_html()

fn gunbhub_browse_page_serializes_holds() -> Bool {
  gunbhub_browse_html ==
    "<html><head><title>gunbc</title></head><body><header><h1>gunbc</h1><nav><a href=\"/\">Browse</a></nav></header><main><ul><li><a href=\"/dag\">dag</a></li><li><a href=\"/src\">src</a></li><li><a href=\"/ROADMAP.md\">ROADMAP.md</a></li></ul></main></body></html>"
}

test fn gunbhub_browse_keystone_holds() -> Bool {
  gunbhub_browse_page_serializes_holds()
}
