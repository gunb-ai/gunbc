module test.claim.host_cli_dependency_wet_witness_test


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = ReadsLiveTree

data echo_cli_tool: CliTool = CliTool {
  name: "echo" as NonEmptyStr,
  min_version: none,
  installable_via: [SourceCoreutils],
}

data witness_note: String = "WET EXECUTION: observe_host_cli_dependency must not match shell.Which.Check.path (Optional straddle). Present and absent are both successful typed observations — only a runtime error is RED."

test fn observe_echo_wet_which_check_does_not_crash() -> Bool {
  match observe_host_cli_dependency(tool: echo_cli_tool) {
    HostCliDependencyPresent => true
    HostCliDependencyAbsent { tool: _, hint: _ } => true
  }
}

test fn observe_npm_wet_which_check_does_not_crash() -> Bool {
  match observe_host_cli_dependency(tool: npm_cli_tool) {
    HostCliDependencyPresent => true
    HostCliDependencyAbsent { tool: _, hint: _ } => true
  }
}
