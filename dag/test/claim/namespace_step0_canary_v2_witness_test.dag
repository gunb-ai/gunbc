// AN ENTERED SUBJECT IN WHICH NOTHING WAS REMOVED WAS NOT ENTERED. This is the arm that stops a run
// whose strip was a no-op from reporting subject entry.
test fn an_entered_frontier_that_removed_nothing_refuses() -> Bool {
  holds(
    a: score(
      contract_identity: namespace_step0_canary_v2_contract.identity,
      commit_hex_in: commit_hex(),
      tree_hex_in: tree_hex(),
      compiler_program: "target/release/gunbc" as NonEmptyStr,
      compiler_hex_in: compiler_hex(),
      manifest: namespace_step0_v2_manifest_identity(),
      collected: population(members: 10, tag: "collected"),
      excluded: excluded_one(),
      admitted: population(members: 9, tag: "admitted"),
      prefix: step0_v2_entered_prefix,
      frontier: entered_frontier(stripped_tag: "stripped", compile_tag: "stripped", removed: 0),
      import_dependence: step0_import_dependence_not_judged()
    ),
    f: fn(a) { refused_at(a: a, want: V2FrontierField) }
  )
}

// THE COMPILE MUST HAVE CONSUMED THE POPULATION THE STRIP PRODUCED. Without this arm a receipt
// could report a strip of one population and a compile of another, which is the two-producer defect
// this whole contract exists to close, one stage further down.
test fn a_compile_over_a_population_the_strip_did_not_produce_refuses() -> Bool {
  holds(
    a: score(
      contract_identity: namespace_step0_canary_v2_contract.identity,
      commit_hex_in: commit_hex(),
      tree_hex_in: tree_hex(),
      compiler_program: "target/release/gunbc" as NonEmptyStr,
      compiler_hex_in: compiler_hex(),
      manifest: namespace_step0_v2_manifest_identity(),
      collected: population(members: 10, tag: "collected"),
      excluded: excluded_one(),
      admitted: population(members: 9, tag: "admitted"),
      prefix: step0_v2_entered_prefix,
      frontier: entered_frontier(stripped_tag: "stripped", compile_tag: "some-other-population", removed: 25415),
      import_dependence: step0_import_dependence_not_judged()
    ),
    f: fn(a) { refused_at(a: a, want: V2FrontierField) }
  )
}

// AN UNENTERED SUBJECT CANNOT CARRY A CENSUS, because there is nothing stripped for a census to be
// about.
test fn a_census_on_an_unentered_subject_refuses() -> Bool {
  holds(
    a: score(
      contract_identity: namespace_step0_canary_v2_contract.identity,
      commit_hex_in: commit_hex(),
      tree_hex_in: tree_hex(),
      compiler_program: "target/release/gunbc" as NonEmptyStr,
      compiler_hex_in: compiler_hex(),
      manifest: namespace_step0_v2_manifest_identity(),
      collected: population(members: 10, tag: "collected"),
      excluded: excluded_one(),
      admitted: population(members: 9, tag: "admitted"),
      prefix: step0_v2_pre_strip_prefix,
      frontier: not_entered_frontier(),
      import_dependence: ImportDependenceCensusObserved {
        receipt_identity: "planted-census" as NonEmptyStr,
        subject_population_identity: population(members: 9, tag: "stripped"),
        completeness: "planted" as NonEmptyStr
      }
    ),
    f: fn(a) { refused_at(a: a, want: V2ImportDependenceField) }
  )
}

// A CENSUS MUST NAME THE POPULATION THIS RECEIPT OBSERVED. A census bound to a foreign subject is
// the row the binding-provenance contract's fourth conservation law forbids, refused here at the
// receipt grain before any census exists to write one.
test fn a_census_naming_a_foreign_population_refuses() -> Bool {
  holds(
    a: score(
      contract_identity: namespace_step0_canary_v2_contract.identity,
      commit_hex_in: commit_hex(),
      tree_hex_in: tree_hex(),
      compiler_program: "target/release/gunbc" as NonEmptyStr,
      compiler_hex_in: compiler_hex(),
      manifest: namespace_step0_v2_manifest_identity(),
      collected: population(members: 10, tag: "collected"),
      excluded: excluded_one(),
      admitted: population(members: 9, tag: "admitted"),
      prefix: step0_v2_entered_prefix,
      frontier: entered_frontier(stripped_tag: "stripped", compile_tag: "stripped", removed: 25415),
      import_dependence: ImportDependenceCensusObserved {
        receipt_identity: "planted-census" as NonEmptyStr,
        subject_population_identity: population(members: 9, tag: "a-different-population"),
        completeness: "planted" as NonEmptyStr
      }
    ),
    f: fn(a) { refused_at(a: a, want: V2ImportDependenceField) }
  )
}

// THE STANDING IS DERIVED FROM ONE AUTHORITY, NOT RESTATED IN TWO. The canary's non-judgment reads
// the binding-provenance contract's producer_standing field; if a producer ever inhabits that
// contract, this consequence changes THERE and the canary follows, with no second row to update and
// no way for the two to disagree.
test fn import_dependence_is_unjudged_because_the_contract_says_no_producer_inhabits_it() -> Bool {
  match step0_binding_provenance_consequence() {
    BindingProvenanceObservable { producer: _ } => false
    BindingProvenanceUnobservable { detail: detail } => match step0_import_dependence_not_judged() {
      ImportDependenceCensusObserved { receipt_identity: _, subject_population_identity: _, completeness: _ } => false
      ImportDependenceNotJudged { cause: cause, required_capability: capability } =>
        (cause as String) == (detail as String)
          && capability.module_path == "gunbc.namespace_step0_binding_provenance_contract"
          && capability.decl_name == "step0_binding_provenance_receipt_contract"
    }
  }
}

// THE CONTRACT'S OWN STANDING, executed rather than read: the roster is the frozen six families and
// the four conservation laws are present, so a later census cannot quietly drop the family that
// fails silently.
test fn the_binding_provenance_contract_carries_the_frozen_roster_and_laws() -> Bool {
  count(step0_binding_provenance_receipt_contract.reference_families) == 6
    && count(step0_binding_provenance_receipt_contract.conservation_laws) == 4
    && count(step0_binding_provenance_receipt_contract.receipt_fields) == 10
}
