module test.claim.generic_argument_recheck_witness

import std.types { Bool, Int, String }
import gunbc.compile_census_probe { blocking_class_count_for, total_blocking_count_for }

// Discriminating specimens for sparse generic-argument recheck
// (v1.compiler.infer infer_call_arguments_generic_pass, argument_needs_generic_recheck).
// A compiler that never rechecks the right-bound lambda fails the Int identity call.
// Recheck demand is a name still missing after this argument that a later argument bound;
// a left-bound lambda's return generic is solved by the lambda itself and is not demand.
// Nested left-bound chain: acceptance control. Right-bound inner generic: if reuse of the
// first-round inner call were wrong, the Bool return would not refuse.

data left_bound_lambda_source: String = "module test.claim.gar_left_bound\nimport std.types { Int }\nfn gar_bind<T, R>(o: T, f: fn(T) -> R) -> R { f(o) }\nfn probe() -> Int { gar_bind(o: 1, f: fn(v) { v }) }\n"

data right_bound_lambda_source: String = "module test.claim.gar_right_bound\nimport std.types { Int }\nfn gar_app<T, R>(f: fn(T) -> R, x: T) -> R { f(x) }\nfn probe() -> Int { gar_app(f: fn(v) { v }, x: 1) }\n"

data nested_left_bound_chain_source: String = "module test.claim.gar_nested_left\nimport std.types { Int }\nfn gar_bind<T, R>(o: T, f: fn(T) -> R) -> R { f(o) }\nfn probe() -> Int {\n  gar_bind(o: 1, f: fn(a) {\n    gar_bind(o: a, f: fn(b) {\n      gar_bind(o: b, f: fn(c) { c })\n    })\n  })\n}\n"

data later_literal_context_source: String = "module test.claim.gar_later_literal\nimport std.types { Int }\nfn gar_pair<T>(x: T, y: T) -> T { y }\nfn probe() -> Int { gar_pair(x: 1, y: 2) }\n"

data later_record_context_source: String = "module test.claim.gar_later_record\nimport std.types { Int }\ntype GarBox<T> { v: T }\nfn gar_box_pair<T>(x: GarBox<T>, y: T) -> T { y }\nfn probe() -> Int { gar_box_pair(x: GarBox { v: 1 }, y: 2) }\n"

data lambda_return_mismatch_source: String = "module test.claim.gar_mismatch\nimport std.types { Bool, Int }\nfn gar_ap<T, R>(f: fn(T) -> R, x: T, r: R) -> R { r }\nfn probe() -> Bool { gar_ap(f: fn(v) { v }, x: 1, r: true) }\n"

data inner_generic_bound_by_outer_source: String = "module test.claim.gar_inner_outer\nimport std.types { Bool, Int }\nfn gar_id<T>(x: T) -> T { x }\nfn gar_app<T, R>(f: fn(T) -> R, x: T) -> R { f(x) }\nfn probe() -> Bool { gar_app(f: fn(v) { gar_id(x: v) }, x: 1) }\n"

test fn a_lambda_after_the_argument_that_binds_its_parameter_is_accepted() -> Bool {
  total_blocking_count_for(source: left_bound_lambda_source) == 0
}

test fn a_lambda_before_the_argument_that_binds_its_parameter_is_accepted_under_the_final_context() -> Bool {
  total_blocking_count_for(source: right_bound_lambda_source) == 0
}

test fn a_nested_left_bound_bind_chain_is_accepted() -> Bool {
  // Zero blocking diagnostics of ANY class. Under the deleted coarse gate this chain is
  // never rechecked at any depth; if a recheck were reintroduced it would either double
  // a diagnostic (caught by the negatives' == 1) or leak a new blocking row (caught here).
  total_blocking_count_for(source: nested_left_bound_chain_source) == 0
}

test fn an_earlier_literal_whose_generic_is_bound_later_is_accepted() -> Bool {
  total_blocking_count_for(source: later_literal_context_source) == 0
}

test fn an_earlier_record_literal_whose_generic_is_bound_later_is_accepted() -> Bool {
  total_blocking_count_for(source: later_record_context_source) == 0
}

test fn a_lambda_return_that_disagrees_with_the_substituted_callable_refuses() -> Bool {
  // EXACTLY one blocking TypeMismatch and nothing else blocking. ">= 1" could not see
  // the duplicate a replayed first pass produces (first-pass diagnostic + recheck
  // diagnostic for the same node), so the bar is == 1 on the class AND == 1 in total:
  // one refusal, at the refusing node, with no unrelated blocking diagnostic beside it.
  blocking_class_count_for(source: lambda_return_mismatch_source, wanted_class: "TypeMismatch") == 1 &&
    total_blocking_count_for(source: lambda_return_mismatch_source) == 1
}

test fn an_inner_generic_bound_only_by_the_outer_settlement_is_re_inferred() -> Bool {
  // Same exact-count bar as the return-mismatch negative: exactly one TypeMismatch,
  // zero other blocking diagnostics. This is the specimen that FAILS if the recheck is
  // removed -- the inner gar_id(x: v) must be re-inferred against the settled context.
  blocking_class_count_for(source: inner_generic_bound_by_outer_source, wanted_class: "TypeMismatch") == 1 &&
    total_blocking_count_for(source: inner_generic_bound_by_outer_source) == 1
}
