module test.claim.ci_nested_match_6777_reproducer_witness

import v2.workflow.ci_nested_match_6777_reproducer_emit {
  ci_nested_match_6777_reproducer_script,
  ci_nested_match_6777_reproducer_shell_emit_scaffold,
  ci_nested_match_6777_reproducer_receipt_prefix,
}
import gunbc.ci_spec { ci_nested_match_6777_reproducer_run_script }
import gunbc.ci_workflow { ci_build_job }
import gunbc.ci_materialization { step_display_name }
import extdeps.github.actions { Step }
import std.disposition { Scaffold }

data reproducer_step_name: String = "cargo test -p v1-compiler-tests --release nested_match_6777_emitted_matches_interpreted (#6777 emitted control)"
data compile_gate_step_name: String = "cargo test -p v1-compiler-tests --release --no-run (compile-contract gate; reuses release v1-compiler)"

fn step_index_of(steps: List<Step>, name: String) -> Int {
  let seen = fold(steps, init: { idx: 0, hit: 0 - 1 }, f: fn(acc, s) {
    if step_display_name(s: s) == name {
      if acc.hit >= 0 { { idx: acc.idx + 1, hit: acc.hit } } else { { idx: acc.idx + 1, hit: acc.idx } }
    } else {
      { idx: acc.idx + 1, hit: acc.hit }
    }
  })
  seen.hit
}

test fn w_reproducer_script_runs_one_named_test_not_suite() -> Bool {
  let script = ci_nested_match_6777_reproducer_script()
  string_contains(s: script, pattern: "'test'")
    && string_contains(s: script, pattern: "'v1-compiler-tests'")
    && string_contains(s: script, pattern: "'--release'")
    && string_contains(s: script, pattern: "'nested_match_6777_emitted_matches_interpreted'")
    && !string_contains(s: script, pattern: "'--no-run'")
    && !string_contains(s: script, pattern: "nextest")
}

test fn w_reproducer_run_script_emits_execution_receipt() -> Bool {
  let script = ci_nested_match_6777_reproducer_run_script()
  string_contains(s: script, pattern: ci_nested_match_6777_reproducer_receipt_prefix)
    && string_contains(s: script, pattern: "test=nested_match_6777_emitted_matches_interpreted")
    && string_contains(s: script, pattern: "members=0:Zero,1:One,2:Many,3:Many")
    && string_contains(s: script, pattern: "outcome=passed")
}

test fn w_reproducer_carrier_is_scaffold() -> Bool {
  match ci_nested_match_6777_reproducer_shell_emit_scaffold {
    Scaffold { dissolves_to: _, bind: _ } => true
    _ => false
  }
}

test fn w_build_job_runs_reproducer_after_compile_gate() -> Bool {
  let steps = ci_build_job().steps
  let gate = step_index_of(steps: steps, name: compile_gate_step_name)
  let reproducer = step_index_of(steps: steps, name: reproducer_step_name)
  (gate >= 0) && (reproducer >= 0) && (gate < reproducer)
}
