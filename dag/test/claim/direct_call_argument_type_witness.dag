module test.claim.direct_call_argument_type_witness

import gunbc.compile_diagnostic_census {
  CompileDiagnosticCensus,
  CensusObserved,
  CensusNotRunnable,
}
import gunbc.compile_census_probe {
  blocking_class_census,
  total_blocking_census,
  census_verdict,
  census_premise,
  census_exit,
  worst_census_verdict,
  CensusVerdict,
  CensusUnobserved,
}
import gunbc.guarantee_measurement { GuaranteeProbeId }
import gunbc.guarantee_probe_corpus {
  active_probe_row,
  direct_call_arg_type_ordinary_module_red_probe,
  direct_call_arg_type_v2_green_control_probe,
  direct_call_arg_type_v2_module_red_probe,
  probe_row_expectation_holds,
}
import std.types { String, List }
import std.process { ProcessExit }
import std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import std.optional { Absent, Present }

// THIS MODULE EXISTS BECAUSE ITS ASSERTIONS HAVE TO EXECUTE, AND THE OBVIOUS HOME FOR THEM DID
// NOT WHILE DeclinedLiveTree stood. The three probes below belong to the guarantee probe corpus
// and were first authored inside test.claim.guarantee_probe_corpus_witness beside their
// siblings. That module declares ReadsLiveTree -- correctly, because it reads harness source
// files off disk -- and was declined before the fold. Measured: run 32570670086 refused with
// ExpectedRedIdentityDidNotExecute.
//
// Splitting them out was how they became evidence rather than description. The SubstrateInputsOnly
// stamp on THIS file was the lie that bought execution: it calls compile_dag_diagnostic_census,
// which walks the checkout. DeclinedLiveTree is deleted. ReadsLiveTree is the honest stamp.
//
// WHAT THIS DOES NOT CLAIM. It does not fix the siblings still living in the live-tree corpus
// witness file.
data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

fn direct_call_arg_type_census_of(source: String) -> CompileDiagnosticCensus {
  compile_dag_diagnostic_census(source)
}

// The three sources differ on exactly two axes and nothing else, which is what makes the trio
// readable. The RED pair differ ONLY in the module name (v2.probe_... vs probe_...): same callee,
// same formal, same actual, same call form. The v2 GREEN differs from the v2 RED only in the
// actual's type. Any wider difference would let a reader attribute a verdict to something other
// than the axis being tested.
data direct_call_arg_type_v2_red_source: String = "module v2.probe_direct_call_arg_type_red\nfn takes_int(n: Int) -> Int { n }\nfn f() -> Int { takes_int(n: \"not an int\") }\n"

data direct_call_arg_type_ordinary_red_source: String = "module probe_direct_call_arg_type_red\nfn takes_int(n: Int) -> Int { n }\nfn f() -> Int { takes_int(n: \"not an int\") }\n"

data direct_call_arg_type_v2_green_source: String = "module v2.probe_direct_call_arg_type_green\nfn takes_int(n: Int) -> Int { n }\nfn f() -> Int { takes_int(n: 7) }\n"

// Expression-form controls for type-head exposure.  The RED differs from the first GREEN only in
// the argument expression.  The concat row is the live-corpus counterexample that disproved a
// scalar-shape-only wall: after synthesis both a String literal and that conforming call had been
// presented as Primitive(String), so only the authored expression form retained the premise.
data applied_formal_string_red_source: String = "module probe_applied_formal_string_red\nfn consume(xs: List<Int>) -> Int { 0 }\nfn f() -> Int { consume(xs: \"not a list\") }\n"
data applied_formal_list_green_source: String = "module probe_applied_formal_list_green\nfn consume(xs: List<Int>) -> Int { 0 }\nfn f() -> Int { consume(xs: [1, 2]) }\n"
data applied_formal_concat_green_source: String = "module probe_applied_formal_concat_green\nfn consume(xs: List<Int>) -> Int { 0 }\nfn f() -> Int { consume(xs: concat([1], [2])) }\n"
data applied_formal_wrong_element_red_source: String = "module probe_applied_formal_wrong_element_red\nfn consume(xs: List<Int>) -> Int { 0 }\nfn f() -> Int { consume(xs: [\"not an int\"]) }\n"
data nat_string_red_source: String = "module probe_nat_string_red\nimport std.nat { Nat }\nfn consume(n: Nat) -> Int { 0 }\nfn f() -> Int { consume(n: \"forty\") }\n"

fn source_blocking_type_mismatch_verdict(source: String) -> CensusVerdict {
  census_verdict(census: blocking_class_census(source: source, wanted_class: "TypeMismatch"), holds: fn(n) { n >= 1 })
}

fn source_zero_blocking_diagnostics_verdict(source: String) -> CensusVerdict {
  census_verdict(census: total_blocking_census(source: source), holds: fn(n) { n == 0 })
}

// The rostered probe row's own expectation, as a named premise. The row is read against a census
// that ran: a census that never ran is CensusUnobserved here, and must not be demoted to a
// Disagreed premise (the row's expectation is false on a refused census), so the gate answers the
// refusal before any premise is ranked.
fn probe_row_premise(census: CompileDiagnosticCensus, probe: GuaranteeProbeId) -> CensusVerdict {
  match active_probe_row(probe: probe) {
    Present { value: row } => census_premise(name: "the rostered probe row's expectation holds", holds: probe_row_expectation_holds(census: census, row: row))
    Absent => census_premise(name: "the probe row is active", holds: false)
  }
}

fn census_gated_verdict(census: CompileDiagnosticCensus, verdicts: List<CensusVerdict>) -> CensusVerdict {
  match census {
    CensusNotRunnable { cause: cause } => CensusUnobserved { cause: cause }
    CensusObserved { rows: _ } => worst_census_verdict(verdicts: verdicts)
  }
}

// The former discriminating red for the v2.* direct-call argument-type exemption, retained after
// the climb as a permanent regression control. Declaration-bound formal carriage makes it pass in
// every module without reconstructing the callee's formal in the caller environment.
test fn direct_call_arg_type_v2_module_red_refuses_blocking_type_mismatch() -> ProcessExit {
  let census = direct_call_arg_type_census_of(source: direct_call_arg_type_v2_red_source)
  census_exit(census_gated_verdict(census: census, verdicts: [
    probe_row_premise(census: census, probe: direct_call_arg_type_v2_module_red_probe),
    source_blocking_type_mismatch_verdict(source: direct_call_arg_type_v2_red_source)
  ]))
}

// The paired nonzero, and it PASSES today with the exemption in place, because the exemption never
// covered an ordinary module name. That is what makes the rostered red above interpretable: a red
// on the v2 row alone cannot distinguish "the judgment is switched off for v2 callers" from "the
// harness reds on anything". When the exemption goes, both are green and both are ordinary
// regression controls.
test fn direct_call_arg_type_ordinary_module_red_refuses_blocking_type_mismatch() -> ProcessExit {
  let census = direct_call_arg_type_census_of(source: direct_call_arg_type_ordinary_red_source)
  census_exit(census_gated_verdict(census: census, verdicts: [
    probe_row_premise(census: census, probe: direct_call_arg_type_ordinary_module_red_probe),
    source_blocking_type_mismatch_verdict(source: direct_call_arg_type_ordinary_red_source)
  ]))
}

// Without this, a seam refusing EVERY argument in a v2.* module would satisfy both reds.
test fn direct_call_arg_type_v2_green_control_has_zero_diagnostics() -> ProcessExit {
  let census = direct_call_arg_type_census_of(source: direct_call_arg_type_v2_green_source)
  census_exit(census_gated_verdict(census: census, verdicts: [probe_row_premise(census: census, probe: direct_call_arg_type_v2_green_control_probe)]))
}

test fn applied_formal_refuses_string_literal() -> ProcessExit {
  census_exit(source_blocking_type_mismatch_verdict(source: applied_formal_string_red_source))
}

test fn applied_formal_accepts_list_introduction() -> ProcessExit {
  census_exit(source_zero_blocking_diagnostics_verdict(source: applied_formal_list_green_source))
}

test fn applied_formal_accepts_conforming_concat_call() -> ProcessExit {
  census_exit(source_zero_blocking_diagnostics_verdict(source: applied_formal_concat_green_source))
}

test fn list_introduction_recursively_refuses_wrong_element() -> ProcessExit {
  census_exit(source_blocking_type_mismatch_verdict(source: applied_formal_wrong_element_red_source))
}

test fn nat_declared_identity_refuses_string_literal() -> ProcessExit {
  census_exit(source_blocking_type_mismatch_verdict(source: nat_string_red_source))
}
