module test.claim.os_install_actuator_selection


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn os_install_actuator_requirements_dispatch_through_kind_rows() -> Bool {
  match os_install_actuator_requirement_kinds.first() {
    Present { value: head } => head == BmcNetworkReach
    Absent => false
  }
    && match os_install_actuator_requirement_kinds.skip(n: 1).first() {
      Present { value: head } => head == ActuatorToolchainGrant
      Absent => false
    }
    && os_install_actuator_requirement_satisfied(
      kind: BmcNetworkReach,
      candidate: srv1_host,
      reach_facts: live_srv3_actuator_reach_facts,
    )
}

test fn srv3_actuator_selection_live_fleet_never_unsatisfiable() -> Bool {
  srv3_os_install_actuator_selection_is_selected_on_live_fleet()
    && match srv3_os_install_actuator_host_unsatisfiable_fallback_dissolution_trigger {
      Scaffold { dissolves_to: _, bind: _ } => true
      Terminal { reason: _ } => false
    }
    && match srv3_os_install_actuator_per_host_observation_forks_dissolution_trigger {
      Scaffold { dissolves_to: _, bind: _ } => true
      Terminal { reason: _ } => false
    }
}

test fn srv3_actuator_host_selected_because_requirements_and_policy() -> Bool {
  srv3_os_install_actuator_host_selected_because_requirements_and_policy()
    && srv3_os_install_actuator_host_is_derived_srv1()
    && srv3_os_install_actuator_host == srv1_host
    && match srv3_os_install_actuator_tie_break_policy {
      OperatorHostPreference { order: order } =>
        match order.first() {
    Present { value: head } => head == operator_host_srv1
    Absent => false
  }
          && match order.skip(n: 1).first() {
      Present { value: head } => head == operator_host_srv2
      Absent => false
    }
      _ => false
    }
}

test fn srv3_actuator_host_failover_fixture_selects_srv2() -> Bool {
  srv3_os_install_actuator_host_failover_fixture_selects_srv2()
    && srv3_os_install_actuator_host == srv1_host
}
