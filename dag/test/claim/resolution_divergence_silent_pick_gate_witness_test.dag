module test.claim.resolution_divergence_silent_pick_gate_witness_test


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn resolution_divergence_in_process_seed_receipt_holds() -> Bool {
  match resolution_divergence_in_process_seed_scaffold {
    Scaffold { dissolves_to: SingleAuthority, bind: bind } =>
      bind.module_path == "tools.resolution_divergence_silent_pick_gate_witness_transport"
        && bind.decl_name == "resolution_divergence_in_process_seed_deferral"
        && string_contains(
          s: resolution_divergence_in_process_seed_receipt,
          pattern: "net +735",
        )
        && string_contains(
          s: resolution_divergence_in_process_seed_deferral,
          pattern: "TRIGGER, one and checkable",
        )
        && string_contains(
          s: resolution_divergence_in_process_seed_deferral,
          pattern: "v1-zero-hand-maintained-rust",
        )
    _ => false
  }
}

test fn resolution_divergence_silent_pick_gate_keystone_holds() -> Bool {
  let gate_holds = run_resolution_divergence_silent_pick_gate_witness()
  gate_holds && resolution_divergence_in_process_seed_receipt_holds()
}
