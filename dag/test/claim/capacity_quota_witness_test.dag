module test.claim.capacity_quota_witness

import std.types { Bool, String, Int, NonEmptyStr, List, EpochSecs }
import std.nat { Nat }
import std.measure { Measure, Count, One }
import extdeps.api_rate_limit { UpstreamRateLimit, RateLimitPeriod, PerMinute, PerHour, PerDay, rate_limit_period_seconds, upstream_rate_limit_key }
import extdeps.github.rate_limits { github_core_rate_limit, github_rate_limits }
import extdeps.cloud.gcp.rate_limits { gcp_rate_limits }
import extdeps.ebay.rate_limits { ebay_rate_limits, ebay_sell_inventory_rate_limit }
import extdeps.llm.anthropic_rest { anthropic_messages_rate_limit }
import extdeps.llm.openai_rest { openai_chat_rate_limit }
import extdeps.accounting.appropriation_period { AppropriationPeriod }
import product.capacity.pool { Pool, Replenishment, NoReplenishment, LapseAtPeriodEnd, pool_of, pool_acquire, pool_reading_at, PoolReading, PoolRead, PoolReadingRefused, PoolOutcome, PoolAdvanced, PoolRefused, pool_reanchor }
import product.capacity.quota { quota_partition, quota_root_pool }

fn w_all_limits() -> List<UpstreamRateLimit> {
  concat(concat(concat(github_rate_limits, gcp_rate_limits), ebay_rate_limits), [anthropic_messages_rate_limit, openai_chat_rate_limit])
}

fn w_headroom(p: Pool<Count, One>, at: EpochSecs) -> Int {
  match pool_reading_at(pool: p, at: at) {
    PoolRead { committed: _, ceiling: _, headroom: h, over_committed: _ } => h.count
    PoolReadingRefused { at: _, anchor: _ } => -1
  }
}

// TEN SCOPES, EACH ITS OWN POOL, EACH NAMED ONCE: the seventeen annotations collapsed to ten typed
// rows because eight GitHub services drew from one core pool. Keys are distinct, the pool
// ceiling is the published count, and the period is the published period in seconds.
test fn every_upstream_scope_is_one_pool_with_the_published_ceiling_and_period() -> Bool {
  let limits = w_all_limits()
  let keys = map(limits, l => upstream_rate_limit_key(l: l) as String)
  length(limits) == 10
    && all(keys, k => length(filter(keys, x => x == k)) == 1)
    && all(limits, l =>
         (quota_partition(limit: l) as String) == join(["quota-", upstream_rate_limit_key(l: l) as String], "")
           && quota_root_pool(limit: l).ledger.appropriation.ceiling.count == l.requests
           && (match quota_root_pool(limit: l).replenishment {
                LapseAtPeriodEnd { period: p } => p.period_seconds == rate_limit_period_seconds(p: l.period) && p.anchor == 0
                NoReplenishment => false
              }))
    && github_core_rate_limit.requests == 5000 && rate_limit_period_seconds(p: github_core_rate_limit.period) == 3600
    && ebay_sell_inventory_rate_limit.requests == 2000000 && rate_limit_period_seconds(p: ebay_sell_inventory_rate_limit.period) == 86400
}

// A RESET INSTANT THE UPSTREAM REPORTS RE-ANCHORS THE POOL so a window ends exactly there: after
// re-anchoring the github pool to a reset at 5400, the window containing 5399 ends at 5400 and a
// lease that would cross it refuses, while at 5400 the full ceiling is available again.
test fn a_reported_reset_instant_reanchors_the_window_to_end_there() -> Bool {
  let p = pool_reanchor(pool: quota_root_pool(limit: github_core_rate_limit), reset_at: 5400)
  (match p.replenishment { LapseAtPeriodEnd { period: per } => per.anchor == 1800  NoReplenishment => false })
    && (match pool_acquire(pool: p, reference: "belt-1" as NonEmptyStr, amount: Measure { count: 1 }, at: 5399, term_seconds: 2) { PoolRefused { refusal: _ } => true  PoolAdvanced { pool: _ } => false })
    && (match pool_acquire(pool: p, reference: "belt-1" as NonEmptyStr, amount: Measure { count: 1 }, at: 5399, term_seconds: 1) { PoolAdvanced { pool: _ } => true  PoolRefused { refusal: _ } => false })
    && w_headroom(p: p, at: 5400) == 5000
}
