module test.claim.direct_call_argument_type_witness_test

import gunbc.compile_diagnostic_census { CompileDiagnosticCensus, CensusObserved, CensusNotRunnable }
import gunbc.guarantee_probe_corpus {
  active_probe_row,
  census_blocking_count_for_class,
  direct_call_arg_type_ordinary_module_red_probe,
  direct_call_arg_type_v2_green_control_probe,
  direct_call_arg_type_v2_module_red_probe,
  probe_row_expectation_holds,
}
import std.types { Bool, Int, String }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.optional { Absent, Present }

// THIS MODULE EXISTS BECAUSE ITS ASSERTIONS HAVE TO EXECUTE, AND THE OBVIOUS HOME FOR THEM DOES
// NOT. The three probes below belong to the guarantee probe corpus and were first authored inside
// test.claim.guarantee_probe_corpus_witness_test beside their siblings. That module declares
// ReadsLiveTree -- correctly, because it reads harness source files off disk to compute a
// measurement revision -- and a live home is DECLINED by the required floor's home policy before
// the fold sees it. Measured, not assumed: run 32570670086 refused with
// ExpectedRedIdentityDidNotExecute, and a grep of that run's whole log finds the module named
// exactly twice, both times in the refusal message. Not one witness in that file executed.
//
// So an assertion authored there is enrolled and inert -- the specification-without-execution
// state DESIGN 5 names, wearing the costume of a populated probe corpus. Splitting these three out
// into a substrate-only module is what makes them evidence rather than description, and it is a
// move available to any of their siblings that does not need the live read.
//
// WHAT THIS DOES NOT CLAIM. It does not fix the siblings, and the fact that a whole probe corpus
// does not execute in the required floor is a finding about the guarantee-recovery evidence base
// that is larger than this class and is reported separately rather than quietly repaired here.
data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn direct_call_arg_type_census_of(source: String) -> CompileDiagnosticCensus {
  compile_dag_diagnostic_census(source)
}

fn direct_call_arg_type_blocking_count(source: String, wanted: String) -> Int {
  match direct_call_arg_type_census_of(source: source) {
    CensusObserved { rows: rows } =>
      rows |> filter(r => (r.diagnostic_class as String) == wanted && r.blocking) |> fold(init: 0, f: (n, r) => n + r.count)
    CensusNotRunnable { cause: _ } => -1
  }
}

// The three sources differ on exactly two axes and nothing else, which is what makes the trio
// readable. The RED pair differ ONLY in the module name (v2.probe_... vs probe_...): same callee,
// same formal, same actual, same call form. The v2 GREEN differs from the v2 RED only in the
// actual's type. Any wider difference would let a reader attribute a verdict to something other
// than the axis being tested.
data direct_call_arg_type_v2_red_source: String = "module v2.probe_direct_call_arg_type_red\nfn takes_int(n: Int) -> Int { n }\nfn f() -> Int { takes_int(n: \"not an int\") }\n"

data direct_call_arg_type_ordinary_red_source: String = "module probe_direct_call_arg_type_red\nfn takes_int(n: Int) -> Int { n }\nfn f() -> Int { takes_int(n: \"not an int\") }\n"

data direct_call_arg_type_v2_green_source: String = "module v2.probe_direct_call_arg_type_green\nfn takes_int(n: Int) -> Int { n }\nfn f() -> Int { takes_int(n: 7) }\n"

// THE DISCRIMINATING RED for the v2.* direct-call argument-type exemption, and it is EXPECTED-RED
// today: the exemption is still standing, so the census carries zero blocking diagnostics for this
// source and this assertion cannot hold. It is rostered in v2.workflow.floor_expected_red with its
// trigger. Measured on a tree with the exemption deleted (gunbc#8886) it PASSES -- so it is a
// satisfiable assertion held open by a named cause, not an aspiration.
test fn direct_call_arg_type_v2_module_red_refuses_blocking_type_mismatch() -> Bool {
  let census = direct_call_arg_type_census_of(source: direct_call_arg_type_v2_red_source)
  match active_probe_row(probe: direct_call_arg_type_v2_module_red_probe) {
    Present { value: row } =>
      probe_row_expectation_holds(census: census, row: row)
        && match census_blocking_count_for_class(census: census, wanted: "TypeMismatch") {
          Present { value: n } => n >= 1
          Absent => false
        }
    Absent => false
  }
}

// The paired nonzero, and it PASSES today with the exemption in place, because the exemption never
// covered an ordinary module name. That is what makes the rostered red above interpretable: a red
// on the v2 row alone cannot distinguish "the judgment is switched off for v2 callers" from "the
// harness reds on anything". When the exemption goes, both are green and both are ordinary
// regression controls.
test fn direct_call_arg_type_ordinary_module_red_refuses_blocking_type_mismatch() -> Bool {
  let census = direct_call_arg_type_census_of(source: direct_call_arg_type_ordinary_red_source)
  match active_probe_row(probe: direct_call_arg_type_ordinary_module_red_probe) {
    Present { value: row } =>
      probe_row_expectation_holds(census: census, row: row)
        && match census_blocking_count_for_class(census: census, wanted: "TypeMismatch") {
          Present { value: n } => n >= 1
          Absent => false
        }
    Absent => false
  }
}

// Without this, a seam refusing EVERY argument in a v2.* module would satisfy both reds.
test fn direct_call_arg_type_v2_green_control_has_zero_diagnostics() -> Bool {
  match active_probe_row(probe: direct_call_arg_type_v2_green_control_probe) {
    Present { value: row } =>
      probe_row_expectation_holds(census: direct_call_arg_type_census_of(source: direct_call_arg_type_v2_green_source), row: row)
    Absent => false
  }
}

// Applied formals must not disappear into the nominal-declaration fallback. List<Int> has no
// nominal declaration at that lookup, which used to make the String actual silently admissible.
data direct_call_applied_list_red_source: String = "module probe_direct_call_applied_list_red\nfn takes(xs: List<Int>) -> Int { xs |> count }\nfn f() -> Int { takes(xs: \"not a list\") }\n"
data direct_call_applied_list_green_source: String = "module probe_direct_call_applied_list_green\nfn takes(xs: List<Int>) -> Int { xs |> count }\nfn f() -> Int { takes(xs: [1, 2]) }\n"

test fn direct_call_applied_list_refuses_kernel_scalar() -> Bool {
  direct_call_arg_type_blocking_count(source: direct_call_applied_list_red_source, wanted: "TypeMismatch") >= 1
}

test fn direct_call_applied_list_accepts_matching_value() -> Bool {
  direct_call_arg_type_blocking_count(source: direct_call_applied_list_green_source, wanted: "TypeMismatch") == 0
}

// Shape alone cannot decide applied types: std.nat.Nat is algebraic syntax with a native numeric
// realization, while v2.std.nat.Nat is the Peano coproduct. The existing declaration-identity
// authority admits only a kernel numeric at the first. A String at native Nat and an Int at Peano
// Nat both remain refusals, so this is a conjunction rather than a type-wide carve-out.
data direct_call_native_nat_numeric_green_source: String = "module probe_direct_call_native_nat_numeric_green\nimport std.nat { Nat }\nfn takes(n: Nat) -> Int { 1 }\nfn f() -> Int { takes(n: 40) }\n"
data direct_call_native_nat_string_red_source: String = "module probe_direct_call_native_nat_string_red\nimport std.nat { Nat }\nfn takes(n: Nat) -> Int { 1 }\nfn f() -> Int { takes(n: \"forty\") }\n"
data direct_call_peano_nat_numeric_red_source: String = "module probe_direct_call_peano_nat_numeric_red\nimport v2.std.nat { Nat }\nfn takes(n: Nat) -> Int { 1 }\nfn f() -> Int { takes(n: 40) }\n"

test fn direct_call_native_nat_accepts_kernel_numeric() -> Bool {
  direct_call_arg_type_blocking_count(source: direct_call_native_nat_numeric_green_source, wanted: "TypeMismatch") == 0
}

test fn direct_call_native_nat_refuses_non_numeric_kernel() -> Bool {
  direct_call_arg_type_blocking_count(source: direct_call_native_nat_string_red_source, wanted: "TypeMismatch") >= 1
}

test fn direct_call_peano_nat_refuses_kernel_numeric() -> Bool {
  direct_call_arg_type_blocking_count(source: direct_call_peano_nat_numeric_red_source, wanted: "TypeMismatch") >= 1
}
