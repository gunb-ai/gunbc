module test.claim.spark_bootstrap_provision_witness

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// Controls over the Spark credential population model. The prior revision of this witness proved
// least-privilege properties of an IAM binding set that has since been deleted along with the
// patterns that applied it; those controls are not carried forward, because the thing they
// constrained no longer exists and a control retained past its subject is a green assertion about
// nothing. What replaces them constrains the population and the classification of legacy state.

data spark_witness_scope_note: String = "These controls cover the credential population, the pending state of every external allocation, and the refusal of the two legacy containers as authorities. They do not cover actuation, which this module no longer performs. The prior least-privilege controls were deleted with the binding set they described rather than kept: they would have continued passing while constraining code that had been removed."

fn spark_population_has(host: HostIdentity, kind: SparkCredentialKind) -> Bool {
  fold(spark_credential_population(), init: false, f: (acc, o) =>
    acc || (o.host == host && spark_credential_kind_eq(a: o.kind, b: kind)))
}

fn spark_allocation_is_pending(a: SparkSecretAllocation) -> Bool {
  match a {
    SparkSecretAllocated { occurrence: _, handle: _ } => false
    SparkSecretAllocationPending { occurrence: _ } => true
  }
}

// CONTROL 1: the population is exactly the four host-by-kind occurrences. This is the control that
// reds on the specific error the prior revision shipped -- two globally-named credentials standing
// for a per-device population.
test fn spark_population_is_four_host_scoped_occurrences() -> Bool {
  spark_credential_population().length() == 4
    && spark_population_has(host: spark_srv5(), kind: FactoryHotspotCredential)
    && spark_population_has(host: spark_srv5(), kind: AdministratorCredential)
    && spark_population_has(host: spark_srv6(), kind: FactoryHotspotCredential)
    && spark_population_has(host: spark_srv6(), kind: AdministratorCredential)
}

// CONTROL 2: occurrences are distinguished by BOTH axes. A kind-only or host-only identity would
// still satisfy control 1's count while fusing two real credentials, and fusing them is the exact
// failure that makes one AddVersion silently become a prior version of another credential.
test fn spark_occurrence_identity_uses_both_axes() -> Bool {
  let a = spark_credential_occurrence(host: spark_srv5(), kind: FactoryHotspotCredential)
  let b = spark_credential_occurrence(host: spark_srv6(), kind: FactoryHotspotCredential)
  let c = spark_credential_occurrence(host: spark_srv5(), kind: AdministratorCredential)
  !spark_occurrence_eq(a: a, b: b)
    && !spark_occurrence_eq(a: a, b: c)
    && spark_occurrence_eq(a: a, b: spark_credential_occurrence(host: spark_srv5(), kind: FactoryHotspotCredential))
}

// CONTROL 3: no occurrence carries an allocated external handle. Pending is the honest state while
// nothing has allocated one, and this control reds if a plausible-looking secret id is ever
// authored here rather than allocated -- the fabrication the carried-never-derived naming law
// forbids.
test fn spark_allocations_are_all_pending() -> Bool {
  fold(spark_credential_population(), init: true, f: (acc, o) =>
    acc && spark_allocation_is_pending(a: spark_secret_allocation(occurrence: o)))
}

// CONTROL 4: the cloud principal is a DEDICATED identity, never a borrowed one. The invariant was
// never "unallocated forever" -- an earlier revision asserted that, which would have gone red the
// moment the correct thing happened. What must hold is that the Spark authority is not a principal
// declared for another domain, so this reds if the BMC assimilator is ever substituted here.
fn spark_principal_member() -> String {
  match fleet_cloud_convergence_principal() {
    FleetCloudPrincipalAllocated { member: m } => m as String
    FleetCloudPrincipalUnallocated => ""
  }
}

test fn spark_cloud_principal_is_dedicated_not_borrowed() -> Bool {
  let m = spark_principal_member()
  m != ""
    && m != "serviceAccount:bmc-assimilator@gunbai-secrets.iam.gserviceaccount.com"
    && m != "serviceAccount:fleet-automation@gunbai-secrets.iam.gserviceaccount.com"
}

// CONTROL 7: the principal existing does not mean the population is reachable by it. The reported
// grant covers one key secret, not the four Spark occurrences, and this control keeps those two
// facts from being collapsed into "the principal is set up".
test fn spark_population_has_no_binding_yet() -> Bool {
  match spark_population_binding_standing() {
    SparkPopulationBindingAbsent => true
    SparkPopulationBindingPresent { member: _ } => false
  }
}

// CONTROL 5: both legacy containers classify as observed-unbound, and there are exactly two of
// them. They are starting state, never accepted output; this reds if either is promoted into the
// allocation path.
fn spark_legacy_is_unbound(c: SparkLegacyContainerStanding) -> Bool {
  match c {
    ObservedLegacyUnbound { handle: h } => h != ""
  }
}

test fn spark_legacy_containers_are_observed_unbound() -> Bool {
  spark_legacy_containers.length() == 2
    && fold(spark_legacy_containers, init: true, f: (acc, c) => acc && spark_legacy_is_unbound(c: c))
}

// CONTROL 6: the legacy population is strictly smaller than the credential population. Stated as a
// standing inequality rather than as prose, because "two containers exist" reads like progress
// toward four and is not: neither can be the authority for a per-device hotspot credential.
test fn spark_legacy_containers_do_not_cover_the_population() -> Bool {
  spark_legacy_containers.length() < spark_credential_population().length()
}

// ── Container classification controls ─────────────────────────────────────────────────────

fn spark_allocated_specimen() -> SparkSecretAllocation {
  SparkSecretAllocated {
    occurrence: spark_credential_occurrence(host: spark_srv5(), kind: AdministratorCredential),
    handle: "fixture-allocated-handle"
  }
}

fn spark_pending_specimen() -> SparkSecretAllocation {
  spark_secret_allocation(occurrence: spark_credential_occurrence(host: spark_srv5(), kind: AdministratorCredential))
}

fn spark_verdict_is_refused(v: SparkContainerVerdict) -> Bool {
  match v {
    SparkContainerRefused { cause: _ } => true
    SparkContainerCreateRequired => false
    SparkContainerConverged { handle: _ } => false
    SparkContainerConflicted { handle: _, cause: _ } => false
  }
}

fn spark_verdict_is_conflicted(v: SparkContainerVerdict) -> Bool {
  match v {
    SparkContainerConflicted { handle: _, cause: _ } => true
    SparkContainerRefused { cause: _ } => false
    SparkContainerCreateRequired => false
    SparkContainerConverged { handle: _ } => false
  }
}

fn spark_verdict_is_converged(v: SparkContainerVerdict) -> Bool {
  match v {
    SparkContainerConverged { handle: _ } => true
    SparkContainerConflicted { handle: _, cause: _ } => false
    SparkContainerRefused { cause: _ } => false
    SparkContainerCreateRequired => false
  }
}

fn spark_verdict_is_create_required(v: SparkContainerVerdict) -> Bool {
  match v {
    SparkContainerCreateRequired => true
    SparkContainerConverged { handle: _ } => false
    SparkContainerConflicted { handle: _, cause: _ } => false
    SparkContainerRefused { cause: _ } => false
  }
}

// CONTROL 8: an unallocated occurrence cannot be observed. The alternative -- computing a probable
// name and observing that -- is the reverse inference the naming law forbids.
test fn spark_unallocated_occurrence_refuses_observation() -> Bool {
  spark_verdict_is_refused(v: classify_spark_container(
    allocation: spark_pending_specimen(),
    observation: SparkContainerAbsent))
}

// CONTROL 9: absent means create; versionless-present means converged. The two ordinary arms.
test fn spark_absent_creates_and_empty_container_converges() -> Bool {
  spark_verdict_is_create_required(v: classify_spark_container(
    allocation: spark_allocated_specimen(),
    observation: SparkContainerAbsent))
    && spark_verdict_is_converged(v: classify_spark_container(
         allocation: spark_allocated_specimen(),
         observation: SparkContainerPresent { handle: "fixture-allocated-handle", version_count: 0 }))
}

// CONTROL 10, the discriminating one: a container that already carries a version is CONFLICTED,
// never converged. This is the control that reds if someone makes the classifier tolerant to get a
// run green -- and tolerance here means writing a second live credential for one occurrence.
test fn spark_container_with_existing_version_conflicts() -> Bool {
  spark_verdict_is_conflicted(v: classify_spark_container(
    allocation: spark_allocated_specimen(),
    observation: SparkContainerPresent { handle: "fixture-allocated-handle", version_count: 1 }))
}

// CONTROL 11: an unreadable container refuses. It does not fall through to create, which would
// attempt a write against a resource whose state is unknown.
test fn spark_unreadable_container_refuses() -> Bool {
  spark_verdict_is_refused(v: classify_spark_container(
    allocation: spark_allocated_specimen(),
    observation: SparkContainerUnreadable { cause: "permission denied reading the secret" }))
}

// ── IAM delta controls ────────────────────────────────────────────────────────────────────

fn spark_owned_universe() -> List<String> {
  ["serviceAccount:owned-a@example.iam.gserviceaccount.com", "serviceAccount:owned-b@example.iam.gserviceaccount.com"]
}

// CONTROL 12, the one that matters most: a member OUTSIDE the owned universe is preserved, and is
// neither removed nor treated as drift. A blind SetIamPolicy drops exactly this member, which is
// the defect the deleted pattern shipped.
test fn spark_iam_preserves_unrelated_bindings() -> Bool {
  let observed = ["serviceAccount:owned-a@example.iam.gserviceaccount.com", "user:someone-elses-grant@example.com"]
  let d = spark_iam_delta(
    observed: observed,
    desired_owned: ["serviceAccount:owned-a@example.iam.gserviceaccount.com"],
    owned_universe: spark_owned_universe())
  d.preserve.length() == 1
    && spark_member_in(m: "user:someone-elses-grant@example.com", xs: d.preserve)
    && d.remove.length() == 0
    && d.add.length() == 0
}

// CONTROL 13: a stale OWNED member is removed, and a missing desired member is added. Removal is
// scoped to the owned universe, so this proves the diff acts where it has authority.
test fn spark_iam_removes_stale_owned_and_adds_missing() -> Bool {
  let d = spark_iam_delta(
    observed: ["serviceAccount:owned-b@example.iam.gserviceaccount.com"],
    desired_owned: ["serviceAccount:owned-a@example.iam.gserviceaccount.com"],
    owned_universe: spark_owned_universe())
  d.add.length() == 1
    && spark_member_in(m: "serviceAccount:owned-a@example.iam.gserviceaccount.com", xs: d.add)
    && d.remove.length() == 1
    && spark_member_in(m: "serviceAccount:owned-b@example.iam.gserviceaccount.com", xs: d.remove)
}

// CONTROL 14: a write with no observed etag refuses. Without it a concurrent update is overwritten
// with no signal at all.
test fn spark_iam_write_without_etag_refuses() -> Bool {
  let d = spark_iam_delta(observed: [], desired_owned: [], owned_universe: spark_owned_universe())
  match admit_spark_iam_write(observed_etag: SparkEtagMissing, delta: d) {
    SparkIamWriteRefused { cause: _ } => true
    SparkIamWriteAdmitted { etag: _, delta: _ } => false
  }
}

// ── Materialization controls ──────────────────────────────────────────────────────────────

fn spark_identity_specimen() -> SparkMaterializationIdentity {
  SparkMaterializationIdentity {
    occurrence: spark_credential_occurrence(host: spark_srv5(), kind: AdministratorCredential),
    payload_identity: "fixture-payload-identity"
  }
}

fn spark_receipt_with(readback: SparkReadbackVerdict) -> SparkMaterializationReceipt {
  SparkMaterializationReceipt {
    identity: spark_identity_specimen(),
    handle: "fixture-allocated-handle",
    exact_version: "7",
    readback: readback
  }
}

fn spark_decision_is_refused(d: SparkMaterializationDecision) -> Bool {
  match d {
    SparkMaterializeRefused { cause: _ } => true
    SparkMaterializeOnce { identity: _ } => false
    SparkMaterializeNoop { exact_version: _ } => false
    SparkMaterializeObserveStore { identity: _ } => false
  }
}

fn spark_decision_is_observe(d: SparkMaterializationDecision) -> Bool {
  match d {
    SparkMaterializeObserveStore { identity: _ } => true
    SparkMaterializeRefused { cause: _ } => false
    SparkMaterializeOnce { identity: _ } => false
    SparkMaterializeNoop { exact_version: _ } => false
  }
}

fn spark_decision_is_noop(d: SparkMaterializationDecision) -> Bool {
  match d {
    SparkMaterializeNoop { exact_version: _ } => true
    SparkMaterializeObserveStore { identity: _ } => false
    SparkMaterializeRefused { cause: _ } => false
    SparkMaterializeOnce { identity: _ } => false
  }
}

// CONTROL 15, the one that prevents version sprawl: an issued-but-unconfirmed attempt resolves by
// OBSERVING the store. It must never reach MaterializeOnce, because a lost process outcome is not
// evidence the write did not land.
test fn spark_issued_unconfirmed_observes_never_rewrites() -> Bool {
  spark_decision_is_observe(d: decide_spark_materialization(
    record: SparkAttemptIssuedUnconfirmed { identity: spark_identity_specimen() }))
}

// CONTROL 16: a confirmed receipt whose readback matched is a Noop naming the exact version. This
// is what makes a resumed run reuse the version rather than mint a second credential.
test fn spark_confirmed_receipt_is_noop_at_exact_version() -> Bool {
  spark_decision_is_noop(d: decide_spark_materialization(
    record: SparkAttemptConfirmed { receipt: spark_receipt_with(readback: SparkReadbackMatched { version: "7" }) }))
}

// CONTROL 17: a mismatched or unavailable readback REFUSES. A receipt is not discharged by having
// been written; it is discharged by an independent read agreeing with it.
test fn spark_bad_readback_refuses() -> Bool {
  spark_decision_is_refused(d: decide_spark_materialization(
    record: SparkAttemptConfirmed { receipt: spark_receipt_with(readback: SparkReadbackMismatched { version: "7" }) }))
    && spark_decision_is_refused(d: decide_spark_materialization(
         record: SparkAttemptConfirmed { receipt: spark_receipt_with(readback: SparkReadbackUnavailable { cause: "version disabled" }) }))
}

// CONTROL 18: a readback that names `latest` cannot witness anything. The moving alias is
// compatible with another writer having landed in between.
test fn spark_readback_through_latest_is_unavailable() -> Bool {
  match admit_spark_readback_version(version: "latest") {
    SparkReadbackUnavailable { cause: _ } => true
    SparkReadbackMatched { version: _ } => false
    SparkReadbackMismatched { version: _ } => false
  }
    && match admit_spark_readback_version(version: "7") {
         SparkReadbackMatched { version: _ } => true
         SparkReadbackUnavailable { cause: _ } => false
         SparkReadbackMismatched { version: _ } => false
       }
}

// CONTROL 19, the asymmetry wall: a factory hotspot credential cannot be GENERATED. Generating one
// fabricates an observation of physical hardware, and the administrator arm proves the refusal is
// kind-specific rather than a blanket ban on generation.
test fn spark_factory_hotspot_cannot_be_generated() -> Bool {
  let gen = GeneratedInRun { recipe: "random-24-char" }
  let refused = match admit_spark_material_source(kind: FactoryHotspotCredential, source: gen) {
    SparkSourceRefused { cause: _ } => true
    SparkSourceAdmitted { source: _ } => false
  }
  let admin_ok = match admit_spark_material_source(kind: AdministratorCredential, source: gen) {
    SparkSourceAdmitted { source: _ } => true
    SparkSourceRefused { cause: _ } => false
  }
  let observed_ok = match admit_spark_material_source(kind: FactoryHotspotCredential, source: ObservedFromDevice { note: "read from device label" }) {
    SparkSourceAdmitted { source: _ } => true
    SparkSourceRefused { cause: _ } => false
  }
  refused && admin_ok && observed_ok
}
