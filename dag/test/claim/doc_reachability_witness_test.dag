module test.claim.doc_reachability_witness
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import gunbc.doc_graph_roots { doc_graph_roots_all }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data live_tree_disposition_correction_note: String = "Corrected 2026-07-15: the 2026-07-12 machine-stamped SubstrateInputsOnly row (#6479 batch, entry-text classifier) was FALSE — every test fn below reads the live docs/ tree through the doc_graph_* host builtins (cli_run.rs build_doc_graph_report), the exact hidden-behind-a-builtin blind spot live_tree.dag:5 declares for that classifier. ReadsLiveTree restores the never-skip tooth so the orphan wall runs on every full floor; the false stamp let a docs-only PR (gunbc#6654) mint an orphan with green CI."

test fn doc_graph_has_no_orphan_docs() -> Bool {
  return doc_graph_orphan_count(doc_graph_roots_all()) == 0
}

test fn doc_graph_registered_plan_roots_nonempty() -> Bool {
  return doc_graph_roots_all().count() > 0
}

test fn doc_graph_registered_plan_roots_all_admitted() -> Bool {
  return doc_graph_admitted_root_count(doc_graph_roots_all()) == doc_graph_roots_all().count()
}

test fn doc_graph_has_no_dangling_links() -> Bool {
  return doc_graph_dangling_link_count() == 0
}

test fn doc_graph_universe_is_nonempty() -> Bool {
  return doc_graph_doc_count() > 0
}
