module test.claim.belt_store_seal_witness

import std.types { Bool, Int, String }
import gunbc.compile_census_probe { blocking_subject_census, census_verdict, census_verdict_all, census_exit }
import gunbc.compile_diagnostic_census { CompileDiagnosticCensus }
import std.process { ProcessExit }

// THE SIX BELT RECEIPT AND ATTEMPT-STATE STORES CANNOT BE SPELLED OR CAST OUTSIDE THEIR DECLARING FILES.
// gunbc.roadmap.roadmap_belt_receipt_store_root (BeltTickReceiptStore, BeltObligationReceiptStore,
// BeltPublicationReceiptStore) and gunbc.roadmap.roadmap_belt_attempt_store_root (BeltSubmissionStore,
// BeltCaptureIntentStore, BeltIntegrationStore) are sole_constructor; each is built only by its one mint, which
// takes the instance (and the node and attempt) and derives the root from its declaration. Each RED hands the
// compiler a module outside the defining files that spells the record as a literal, and asserts EXACTLY ONE
// SoleConstructorViolation keyed on that record's name. Each forged text then runs a second time against the
// seal-stripped twin (test.fixture.belt_store_seal.unsealed, same fields, no keyword): it draws no violation, so
// the refusal is the keyword. Claimed: construction is sealed (no forged store, no store over the wrong root).
// NOT claimed: that business code cannot read store.root (field reads are not sealed; the declared residual
// gunbc.recurring_failure_mode a_slot_store_is_built_over_a_literal_path_by_any_module).

fn seal_violations(source: String, subject: String) -> CompileDiagnosticCensus {
  blocking_subject_census(source: source, wanted_class: "SoleConstructorViolation", wanted_subject: subject)
}

data forged_belt_tick_receipt_store_source: String = "module probe_belt_forged_belt_tick_receipt_store\nimport std.types { NonEmptyStr }\nimport gunbc.roadmap.roadmap_belt_receipt_store_root { BeltTickReceiptStore }\nfn forged(d: NonEmptyStr) -> BeltTickReceiptStore {\n  BeltTickReceiptStore { instance: d, root: d }\n}\n"

data twin_belt_tick_receipt_store_source: String = "module probe_belt_twin_belt_tick_receipt_store\nimport std.types { NonEmptyStr }\nimport test.fixture.belt_store_seal.unsealed { BeltTickReceiptStore }\nfn forged(d: NonEmptyStr) -> BeltTickReceiptStore {\n  BeltTickReceiptStore { instance: d, root: d }\n}\n"

data cast_belt_tick_receipt_store_source: String = "module probe_belt_cast_belt_tick_receipt_store\nimport std.types { NonEmptyStr }\nimport gunbc.roadmap.roadmap_belt_receipt_store_root { BeltTickReceiptStore }\nfn forged(d: NonEmptyStr) -> BeltTickReceiptStore {\n  d as BeltTickReceiptStore\n}\n"

