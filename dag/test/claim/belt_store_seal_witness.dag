test fn the_same_forged_sources_pass_against_the_seal_stripped_twin() -> ProcessExit {
  census_verdict_all(verdicts: [
    census_verdict(census: seal_violations(source: twin_belt_tick_receipt_store_source, subject: "BeltTickReceiptStore"), holds: fn(n) { n == 0 }),
    census_verdict(census: seal_violations(source: twin_belt_obligation_receipt_store_source, subject: "BeltObligationReceiptStore"), holds: fn(n) { n == 0 }),
    census_verdict(census: seal_violations(source: twin_belt_publication_receipt_store_source, subject: "BeltPublicationReceiptStore"), holds: fn(n) { n == 0 }),
    census_verdict(census: seal_violations(source: twin_belt_submission_store_source, subject: "BeltSubmissionStore"), holds: fn(n) { n == 0 }),
    census_verdict(census: seal_violations(source: twin_belt_capture_intent_store_source, subject: "BeltCaptureIntentStore"), holds: fn(n) { n == 0 }),
    census_verdict(census: seal_violations(source: twin_belt_integration_store_source, subject: "BeltIntegrationStore"), holds: fn(n) { n == 0 }),
  ])
}
