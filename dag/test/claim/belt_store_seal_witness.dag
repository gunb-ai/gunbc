test fn a_forged_belt_tick_receipt_store_literal_is_refused_at_compile() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: forged_belt_tick_receipt_store_source, subject: "BeltTickReceiptStore"), holds: fn(n) { n == 1 }))
}

test fn a_forged_belt_tick_receipt_store_cast_is_refused_at_compile() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: cast_belt_tick_receipt_store_source, subject: "BeltTickReceiptStore"), holds: fn(n) { n == 1 }))
}

