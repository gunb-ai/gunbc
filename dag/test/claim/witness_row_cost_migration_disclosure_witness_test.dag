module test.claim.witness_row_cost_migration_disclosure

import gunbc.witness_row_cost {
  BelowMigrationThreshold,
  MandatoryMigration,
  MigrationMeasurementUnavailable,
  WitnessCostReceiptRow,
  witness_row_cost_migration_threshold_ms,
  witness_row_cost_migration_verdict,
  witness_row_cost_mandatory_migration_rows,
  witness_row_cost_mandatory_migration_count,
  witness_row_cost_measurement_unavailable_rows,
  witness_row_cost_measurement_unavailable_count,
}
import std.logic { Bool }
import std.nat { Nat }
import std.types { NonEmptyStr, List, Int }
import std.measure { millisecond, millisecond_count, millisecond_to_nanosecond }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.observation { Done, observation_durations_wall }
import v2.std.algebra { count_where, for_all }
import v2.std.text { String }

data witness_row_cost_migration_disclosure_note: String = "Executing consumer for the mandatory-migration disclosure (gunbc.witness_row_cost). THE PAIR IS THE PROOF, per the drift comparator's own discipline: a synthetic row at-or-above the threshold MUST produce MandatoryMigration, and a row comfortably below MUST NOT — either alone is satisfiable by a broken comparator. The threshold is authored directly on the WALL clock (operator ruling 2026-08-05, witness_row_cost_migration_threshold_note) rather than derived from the fast-lane fail-stop budget (a different, thread-CPU clock): this test pins the literal 500ms figure itself, since that is now the single authored source."

fn authored_threshold_is_500ms_holds() -> Bool {
  witness_row_cost_migration_threshold_ms() == 500
}

fn at_threshold_is_mandatory_migration_holds() -> Bool {
  let v = witness_row_cost_migration_verdict(observed: millisecond(count: witness_row_cost_migration_threshold_ms()))
  match v {
    MandatoryMigration { observed: o, threshold: t } =>
      millisecond_count(m: o) == witness_row_cost_migration_threshold_ms() &&
      millisecond_count(m: t) == witness_row_cost_migration_threshold_ms()
    BelowMigrationThreshold => false
    MigrationMeasurementUnavailable => false
  }
}

fn just_below_threshold_is_not_mandatory_holds() -> Bool {
  let v = witness_row_cost_migration_verdict(observed: millisecond(count: witness_row_cost_migration_threshold_ms() - 1))
  match v {
    BelowMigrationThreshold => true
    MandatoryMigration { observed: _, threshold: _ } => false
    MigrationMeasurementUnavailable => false
  }
}

fn sample_decl(name: String) -> DeclarationRef {
  DeclarationRef {
    module_path: "test.claim.witness_row_cost_migration_disclosure" as NonEmptyStr,
    decl_name: name as NonEmptyStr,
    field: WholeDeclaration
  }
}

fn sample_row(name: String, eval_ms: Nat) -> WitnessCostReceiptRow {
  WitnessCostReceiptRow {
    entry: "dag/test/claim/witness_row_cost_migration_disclosure_witness_test.dag" as NonEmptyStr,
    declaration: sample_decl(name: name),
    eval: observation_durations_wall(elapsed: millisecond_to_nanosecond(m: millisecond(count: eval_ms))),
    resolve: millisecond_to_nanosecond(m: millisecond(count: 1)),
    warm: millisecond_to_nanosecond(m: millisecond(count: eval_ms + 1)),
    outcome: Done
  }
}

fn rows_filter_and_count_agree_and_are_located_holds() -> Bool {
  let rows: List<WitnessCostReceiptRow> = [
    sample_row(name: "fast_row", eval_ms: 12),
    sample_row(name: "slow_row", eval_ms: 2500),
    sample_row(name: "at_cap_row", eval_ms: 5000)
  ]
  let mandatory = witness_row_cost_mandatory_migration_rows(rows: rows)
  witness_row_cost_mandatory_migration_count(rows: rows) == 2 &&
    count_where(xs: mandatory, predicate: row => true) == 2 &&
    for_all(xs: mandatory, predicate: row => row.declaration.decl_name != ("fast_row" as NonEmptyStr))
}

fn zero_over_threshold_rows_counts_zero_holds() -> Bool {
  let rows: List<WitnessCostReceiptRow> = [sample_row(name: "fast_row", eval_ms: 12)]
  witness_row_cost_mandatory_migration_count(rows: rows) == 0
}

fn sample_row_no_wall_measurement(name: String) -> WitnessCostReceiptRow {
  WitnessCostReceiptRow {
    entry: "dag/test/claim/witness_row_cost_migration_disclosure_witness_test.dag" as NonEmptyStr,
    declaration: sample_decl(name: name),
    eval: [],
    resolve: millisecond_to_nanosecond(m: millisecond(count: 1)),
    warm: millisecond_to_nanosecond(m: millisecond(count: 1)),
    outcome: Done
  }
}

// The gate-arming-on-ignorance regression (keen-ibex-349 review): an unmeasured row must count
// as unavailable, never as mandatory nor as silently below threshold, and the two populations
// (mandatory vs unavailable) must be tracked independently so a zero mandatory_count is never
// mistaken for evidence that every row was genuinely measured.
fn unavailable_rows_are_counted_separately_from_mandatory_holds() -> Bool {
  let rows: List<WitnessCostReceiptRow> = [
    sample_row(name: "fast_row", eval_ms: 12),
    sample_row_no_wall_measurement(name: "unmeasured_row")
  ]
  witness_row_cost_mandatory_migration_count(rows: rows) == 0 &&
    witness_row_cost_measurement_unavailable_count(rows: rows) == 1 &&
    for_all(
      xs: witness_row_cost_measurement_unavailable_rows(rows: rows),
      predicate: row => row.declaration.decl_name == ("unmeasured_row" as NonEmptyStr)
    )
}

test fn witness_row_cost_migration_disclosure_holds() -> Bool {
  authored_threshold_is_500ms_holds()
    && at_threshold_is_mandatory_migration_holds()
    && just_below_threshold_is_not_mandatory_holds()
    && rows_filter_and_count_agree_and_are_located_holds()
    && zero_over_threshold_rows_counts_zero_holds()
    && unavailable_rows_are_counted_separately_from_mandatory_holds()
}
