module test.claim.extdeps_dpkg_witness

import std.logic { Bool }
import std.types { String, List }
import extdeps.dpkg { dpkg_status_argv }
import extdeps.apt { package_tailscale }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn argv_join(argv: List<String>) -> String {
  join(argv, " ")
}

test fn extdeps_dpkg_status_argv_holds() -> Bool {
  argv_join(argv: dpkg_status_argv(package: package_tailscale)) == "dpkg -s tailscale"
}
