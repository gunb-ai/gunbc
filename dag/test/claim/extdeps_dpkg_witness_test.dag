module test.claim.extdeps_dpkg_witness

import std.logic { Bool }
import std.types { String, List }
import extdeps.dpkg { dpkg_status_argv }
import extdeps.apt { package_tailscale }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.operation_argv { operation_argv_bind_text, operation_argv_tokens_or_refusal_label }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data dpkg_status_path: String = "dag/extdeps/package_managers/dpkg.dag"
data dpkg_status_service: String = "dpkg.Package"
data dpkg_status_operation: String = "Status"

fn argv_join(argv: List<String>) -> String {
  join(argv, " ")
}

fn witness_dpkg_status_argv_matches_transport_row() -> Bool {
  let helper = dpkg_status_argv(package: package_tailscale)
  let transport = operation_argv_tokens_or_refusal_label(
    m: shell_materialize_operation_argv(
      dpkg_status_path,
      dpkg_status_service,
      dpkg_status_operation,
      [operation_argv_bind_text(name: "package", text: package_tailscale as String)]
    )
  )
  argv_join(argv: helper) == argv_join(argv: transport)
}

test fn extdeps_dpkg_status_argv_holds() -> Bool {
  witness_dpkg_status_argv_matches_transport_row()
}

test fn extdeps_dpkg_status_argv_RED_wrong_package_golden() -> Bool {
  argv_join(argv: dpkg_status_argv(package: package_tailscale)) != "dpkg -s nodejs"
}
