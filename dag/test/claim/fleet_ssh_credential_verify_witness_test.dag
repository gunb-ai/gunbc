module test.claim.fleet_ssh_credential_verify_witness_test


data subject_identity_file: std.types.NonEmptyStr = "/tmp/gunbc-credential-verify-witness-key"

data subject_key: extdeps.ssh.SshPublicKey = extdeps.ssh.SshPublicKey {
  algorithm: extdeps.ssh.Ed25519,
  material: "AAAAC3NzaC1lZDI1NTE5AAAAISUBJECTWITNESSMATERIAL000000000000" as std.types.NonEmptyStr,
  comment: "credential-verify-witness",
}

// A DIFFERENT key of the same algorithm -- the rotation case. This is the state the superseded route
// could not distinguish from a match, because it never read the file at all.
data rotated_key: extdeps.ssh.SshPublicKey = extdeps.ssh.SshPublicKey {
  algorithm: extdeps.ssh.Ed25519,
  material: "AAAAC3NzaC1lZDI1NTE5AAAAIROTATEDWITNESSMATERIAL0000000000" as std.types.NonEmptyStr,
  comment: "credential-verify-witness-rotated",
}

fn classify(succeeded: Bool, stdout: String, stderr: String) -> gunbc.fleet_ssh_credential_verify.FleetSshCredentialVerification {
  gunbc.fleet_ssh_credential_verify.classify_derived_public_key_line(
    identity_file: subject_identity_file,
    expected_key: test.claim.fleet_ssh_credential_verify_witness_test.subject_key,
    derivation_succeeded: succeeded,
    derivation_stdout: stdout,
    derivation_stderr: stderr,
  )
}

fn is_verified(v: gunbc.fleet_ssh_credential_verify.FleetSshCredentialVerification) -> Bool {
  match v {
    FleetSshCredentialVerified { binding: _ } => true
    FleetSshCredentialIdentityMismatch { expected_line: _, observed_line: _ } => false
    FleetSshCredentialDerivationRefused { cause: _ } => false
  }
}

fn is_mismatch(v: gunbc.fleet_ssh_credential_verify.FleetSshCredentialVerification) -> Bool {
  match v {
    FleetSshCredentialVerified { binding: _ } => false
    FleetSshCredentialIdentityMismatch { expected_line: _, observed_line: _ } => true
    FleetSshCredentialDerivationRefused { cause: _ } => false
  }
}

fn is_derivation_refused(v: gunbc.fleet_ssh_credential_verify.FleetSshCredentialVerification) -> Bool {
  match v {
    FleetSshCredentialVerified { binding: _ } => false
    FleetSshCredentialIdentityMismatch { expected_line: _, observed_line: _ } => false
    FleetSshCredentialDerivationRefused { cause: _ } => true
  }
}

// ── The positive control ────────────────────────────────────────────────────────────────────────
// Without this the negatives below would pass on a function that refuses everything.

test fn exact_derived_line_verifies() -> Bool {
  is_verified(v: test.claim.fleet_ssh_credential_verify_witness_test.classify(succeeded: true, stdout: gunbc.fleet_ssh_credential_verify.expected_public_key_line(key: test.claim.fleet_ssh_credential_verify_witness_test.subject_key), stderr: ""))
}

// ssh-keygen may append a comment. The trailing field is admitted, but only behind a space.
test fn derived_line_with_trailing_comment_verifies() -> Bool {
  is_verified(
    v: test.claim.fleet_ssh_credential_verify_witness_test.classify(
      succeeded: true,
      stdout: concat(gunbc.fleet_ssh_credential_verify.expected_public_key_line(key: test.claim.fleet_ssh_credential_verify_witness_test.subject_key), " some-comment@host"),
      stderr: "",
    ),
  )
}

test fn surrounding_whitespace_does_not_defeat_the_match() -> Bool {
  is_verified(
    v: test.claim.fleet_ssh_credential_verify_witness_test.classify(
      succeeded: true,
      stdout: concat(concat("\n  ", gunbc.fleet_ssh_credential_verify.expected_public_key_line(key: test.claim.fleet_ssh_credential_verify_witness_test.subject_key)), "  \n"),
      stderr: "",
    ),
  )
}

// ── THE DEFECT THIS MODULE EXISTS FOR ───────────────────────────────────────────────────────────
// The file holds a different key of the same type. The superseded route hashed the DECLARED material
// and produced a binding indistinguishable from the matching case. Here it refuses.

test fn a_rotated_key_in_the_file_refuses_rather_than_binding() -> Bool {
  is_mismatch(v: test.claim.fleet_ssh_credential_verify_witness_test.classify(succeeded: true, stdout: gunbc.fleet_ssh_credential_verify.expected_public_key_line(key: rotated_key), stderr: ""))
}

// The algorithm is part of the comparison, not an unchecked field.
test fn a_different_algorithm_with_the_same_material_refuses() -> Bool {
  is_mismatch(
    v: test.claim.fleet_ssh_credential_verify_witness_test.classify(
      succeeded: true,
      stdout: gunbc.fleet_ssh_credential_verify.expected_public_key_line(
        key: extdeps.ssh.SshPublicKey { algorithm: extdeps.ssh.Rsa, material: test.claim.fleet_ssh_credential_verify_witness_test.subject_key.material, comment: "" },
      ),
      stderr: "",
    ),
  )
}

// A longer material that CARRIES the expected one as a prefix must not pass. This is why the
// trailing-space form is required rather than a bare prefix test.
test fn a_material_extending_the_expected_one_refuses() -> Bool {
  is_mismatch(
    v: test.claim.fleet_ssh_credential_verify_witness_test.classify(
      succeeded: true,
      stdout: concat(gunbc.fleet_ssh_credential_verify.expected_public_key_line(key: test.claim.fleet_ssh_credential_verify_witness_test.subject_key), "EXTRAMATERIAL"),
      stderr: "",
    ),
  )
}

// ── Fail-closed on degenerate observations ──────────────────────────────────────────────────────
// Each of these is a state where a zero exit carries no evidence. None may verify.

test fn success_with_empty_stdout_does_not_verify() -> Bool {
  is_mismatch(v: test.claim.fleet_ssh_credential_verify_witness_test.classify(succeeded: true, stdout: "", stderr: ""))
}

test fn success_with_whitespace_only_stdout_does_not_verify() -> Bool {
  is_mismatch(v: test.claim.fleet_ssh_credential_verify_witness_test.classify(succeeded: true, stdout: "   \n  ", stderr: ""))
}

test fn a_failed_derivation_refuses_even_when_stdout_looks_right() -> Bool {
  is_derivation_refused(
    v: test.claim.fleet_ssh_credential_verify_witness_test.classify(
      succeeded: false,
      stdout: gunbc.fleet_ssh_credential_verify.expected_public_key_line(key: test.claim.fleet_ssh_credential_verify_witness_test.subject_key),
      stderr: "load failed",
    ),
  )
}

// ── The refusal is reportable ───────────────────────────────────────────────────────────────────

test fn mismatch_reason_names_both_lines_and_says_no_host_was_contacted() -> Bool {
  let reason = gunbc.fleet_ssh_credential_verify.fleet_ssh_credential_verification_refusal_reason(
    verification: test.claim.fleet_ssh_credential_verify_witness_test.classify(succeeded: true, stdout: gunbc.fleet_ssh_credential_verify.expected_public_key_line(key: rotated_key), stderr: ""),
  )
  string_contains(reason, gunbc.fleet_ssh_credential_verify.expected_public_key_line(key: test.claim.fleet_ssh_credential_verify_witness_test.subject_key))
    && string_contains(reason, gunbc.fleet_ssh_credential_verify.expected_public_key_line(key: rotated_key))
    && string_contains(reason, "contacting NO host")
}

test fn derivation_refusal_reason_carries_the_stderr() -> Bool {
  string_contains(
    gunbc.fleet_ssh_credential_verify.fleet_ssh_credential_verification_refusal_reason(
      verification: test.claim.fleet_ssh_credential_verify_witness_test.classify(succeeded: false, stdout: "", stderr: "no such identity file"),
    ),
    "no such identity file",
  )
}

// ── The agent arm ───────────────────────────────────────────────────────────────────────────────

data subject_socket: std.types.NonEmptyStr = "/tmp/gunbc-agent-witness.sock"
// The selector is SEALED -- its only production mint is the materializer, which writes the file and
// reads it back. A hermetic witness has no filesystem, so it is admitted explicitly here, exactly as
// the known-hosts anchor admits its own witness fixture. What that buys is that no OTHER module can
// hand `classify_agent_key_listing` a path it merely named.
fn witness_selector_fixture() -> gunbc.fleet_ssh_credential_verify.AgentSelectorFile {
  gunbc.fleet_ssh_credential_verify.agent_selector_file_seal(
    path: "/tmp/gunbc-fleet-selector.pub" as std.types.NonEmptyStr,
    selector_identity: std.content_hash.content_hash_of_value(value: "witness-selector" as std.types.NonEmptyStr),
  )
}
data subject_fingerprint: std.types.NonEmptyStr = "SHA256:mGT7qJsh36VsVb8OPh3m8br3oHedQHxRukRkW5P0CoQ"

fn classify_agent(succeeded: Bool, stdout: String, stderr: String) -> gunbc.fleet_ssh_credential_verify.FleetSshCredentialVerification {
  gunbc.fleet_ssh_credential_verify.classify_agent_key_listing(
    agent_socket: subject_socket,
    selector: witness_selector_fixture(),
    expected_key: test.claim.fleet_ssh_credential_verify_witness_test.subject_key,
    expected_fingerprint: subject_fingerprint,
    listing_succeeded: succeeded,
    listing_stdout: stdout,
    listing_stderr: stderr,
  )
}

data realistic_listing: String = "256 SHA256:mGT7qJsh36VsVb8OPh3m8br3oHedQHxRukRkW5P0CoQ fleet-automation@gunbc (ED25519)"

test fn an_agent_listing_the_declared_fingerprint_verifies() -> Bool {
  is_verified(v: classify_agent(succeeded: true, stdout: realistic_listing, stderr: ""))
}

// The agent holds keys, none of them ours. This is the state a bare "the command succeeded" check
// cannot distinguish from the one above.
test fn an_agent_holding_only_other_keys_refuses() -> Bool {
  is_mismatch(
    v: classify_agent(
      succeeded: true,
      stdout: "256 SHA256:OTHERKEYFINGERPRINTVALUEHERE0000000000000 someone@else (ED25519)",
      stderr: "",
    ),
  )
}

// Our key among several: exactness is about the fingerprint being present, not about being alone.
test fn the_declared_key_among_several_agent_identities_verifies() -> Bool {
  is_verified(
    v: classify_agent(
      succeeded: true,
      stdout: join([
        "256 SHA256:FIRSTOTHERKEY000000000000000000000000000000 a@b (ED25519)\n",
        realistic_listing, "\n",
        "256 SHA256:THIRDOTHERKEY000000000000000000000000000000 c@d (ED25519)",
      ], ""),
      stderr: "",
    ),
  )
}

// A fingerprint that CARRIES the declared one as a prefix must not match. This is why the membership
// test is space-delimited rather than a bare substring.
test fn a_fingerprint_extending_the_declared_one_refuses() -> Bool {
  is_mismatch(
    v: classify_agent(
      succeeded: true,
      stdout: "256 SHA256:mGT7qJsh36VsVb8OPh3m8br3oHedQHxRukRkW5P0CoQEXTRA other@host (ED25519)",
      stderr: "",
    ),
  )
}

// `ssh-add -l` exits 1 with "The agent has no identities." and 2 when it cannot reach the agent.
// Neither may produce a binding, and the empty-listing case must not pass on a zero exit either.
test fn an_agent_with_no_identities_refuses() -> Bool {
  is_derivation_refused(v: classify_agent(succeeded: false, stdout: "The agent has no identities.", stderr: ""))
}

test fn an_unreachable_agent_refuses() -> Bool {
  is_derivation_refused(
    v: classify_agent(succeeded: false, stdout: "", stderr: "Error connecting to agent: No such file or directory"),
  )
}

test fn an_empty_listing_on_a_zero_exit_does_not_verify() -> Bool {
  is_mismatch(v: classify_agent(succeeded: true, stdout: "", stderr: ""))
}

// The declared fingerprint authority is the one the hand-authored CI shell already compares against,
// so the model and that fragment cannot disagree about which key is expected.
test fn the_declared_fingerprint_is_the_fleet_authority() -> Bool {
  (gunbc.fleet_ssh_access.fleet_automation_ssh_key_fingerprint as String) == (subject_fingerprint as String)
}

// ── The agent selector file ─────────────────────────────────────────────────────────────────────

// Attempt-owned, for the same reason the known-hosts anchor path is: two concurrent runs must not
// write one another's selector, and a stale file from another attempt must not be readable as this
// one's.
test fn the_selector_path_is_attempt_owned() -> Bool {
  match fleet_ssh_attempt_identity(raw: "witness-attempt-a") {
    Absent => false
    Present { value: a } => match fleet_ssh_attempt_identity(raw: "witness-attempt-b") {
      Absent => false
      Present { value: b } => {
        let pa = agent_public_selector_path(attempt: a) as String
        let pb = agent_public_selector_path(attempt: b) as String
        pa != pb && string_contains(pa, "witness-attempt-a") && string_contains(pb, "witness-attempt-b")
      }
    }
  }
}

// The bytes are the authorized_keys line form OpenSSH expects in a public key file, newline included.
test fn the_selector_content_is_the_public_key_line() -> Bool {
  agent_public_selector_content(key: test.claim.fleet_ssh_credential_verify_witness_test.subject_key)
    == concat(ssh_public_key_line(k: test.claim.fleet_ssh_credential_verify_witness_test.subject_key), "\n")
}

// It carries the PUBLIC material and nothing else. A selector file is not a place a private key goes.
test fn the_selector_content_carries_the_public_material() -> Bool {
  string_contains(agent_public_selector_content(key: test.claim.fleet_ssh_credential_verify_witness_test.subject_key), test.claim.fleet_ssh_credential_verify_witness_test.subject_key.material as String)
    && string_contains(agent_public_selector_content(key: test.claim.fleet_ssh_credential_verify_witness_test.subject_key), "ssh-ed25519")
}

// ── The expected line is built from the modeled key, not re-spelled ─────────────────────────────

test fn expected_line_is_the_registered_token_then_the_material() -> Bool {
  gunbc.fleet_ssh_credential_verify.expected_public_key_line(key: test.claim.fleet_ssh_credential_verify_witness_test.subject_key)
    == concat("ssh-ed25519 ", test.claim.fleet_ssh_credential_verify_witness_test.subject_key.material as String)
}

// The production subject: the declared fleet automation key is what the identity-file route verifies
// against, so a change to that authority moves this check with it.
test fn the_fleet_automation_key_is_the_production_expected_line() -> Bool {
  gunbc.fleet_ssh_credential_verify.expected_public_key_line(key: gunbc.fleet_ssh_access.fleet_automation_ssh_key)
    == concat("ssh-ed25519 ", gunbc.fleet_ssh_access.fleet_automation_ssh_key.material as String)
}
