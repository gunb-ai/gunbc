// TARGET SELECTION REFUSES RATHER THAN WIDENS (DESIGN section 5, absorbing fallback).
// The pre-fix reader returned HostIdentity? and its consumer read Absent as "every
// enrolled Spark". Both refusal claims below are RED against that behavior: it answered
// the full host population where these require a typed refusal, and it did so on the
// path that actuates enable-linger.
test fn spark_target_absent_while_executing_refuses_rather_than_widening() -> Bool {
  match gunbc.fleet_multi_principal_probe.spark_converge_target_selection_of(raw: none, execute_apply: true) {
    SparkConvergeTargetRefused { reason: _ } => true
    SparkConvergeTargetAllObserveOnly => false
    SparkConvergeTargetSingle { host: _ } => false
  }
}

test fn spark_target_unrecognized_refuses_even_when_only_observing() -> Bool {
  match gunbc.fleet_multi_principal_probe.spark_converge_target_selection_of(
    raw: Present { value: "srv7" as std.types.NonEmptyStr },
    execute_apply: false,
  ) {
    SparkConvergeTargetRefused { reason: _ } => true
    SparkConvergeTargetAllObserveOnly => false
    SparkConvergeTargetSingle { host: _ } => false
  }
}

// The observe-only widening that IS legitimate: no target named, nothing actuates.
test fn spark_target_absent_while_observing_covers_all_enrolled_sparks() -> Bool {
  match gunbc.fleet_multi_principal_probe.spark_converge_target_selection_of(raw: none, execute_apply: false) {
    SparkConvergeTargetAllObserveOnly => true
    SparkConvergeTargetRefused { reason: _ } => false
    SparkConvergeTargetSingle { host: _ } => false
  }
}

// Positive control: a named target still selects exactly that one host under execution,
// so the refusals above are not a blanket refusal that would make the wall vacuous.
test fn spark_target_named_selects_exactly_that_host_under_execution() -> Bool {
  match gunbc.fleet_multi_principal_probe.spark_converge_target_selection_of(
    raw: Present { value: "srv6" as std.types.NonEmptyStr },
    execute_apply: true,
  ) {
    SparkConvergeTargetSingle { host: h } => h == gunbc.fleet_intent_network.operator_host_srv6
    SparkConvergeTargetRefused { reason: _ } => false
    SparkConvergeTargetAllObserveOnly => false
  }
}

// UNOBSERVED LINGER MUST NOT RENDER AS OBSERVED-DISABLED. RED against the prior receipt,
// which passed linger_enabled: false on every refusal path and therefore printed
// observed_linger=no for a host it had never reached — byte-identical to a reachable host
// with linger genuinely off. A reader or parser taking that field before the verdict would
// plan from an observation that was never made.
test fn observed_linger_renders_unobserved_distinctly_from_disabled() -> Bool {
  gunbc.spark_serving_converge_slice_wet.render_observed_linger(state: gunbc.spark_serving_converge_slice_wet.LingerUnobserved) == "unobserved"
    && gunbc.spark_serving_converge_slice_wet.render_observed_linger(state: gunbc.spark_serving_converge_slice_wet.LingerObserved { enabled: false }) == "no"
    && gunbc.spark_serving_converge_slice_wet.render_observed_linger(state: gunbc.spark_serving_converge_slice_wet.LingerObserved { enabled: true }) == "yes"
    && gunbc.spark_serving_converge_slice_wet.render_observed_linger(state: gunbc.spark_serving_converge_slice_wet.LingerUnobserved)
         != gunbc.spark_serving_converge_slice_wet.render_observed_linger(state: gunbc.spark_serving_converge_slice_wet.LingerObserved { enabled: false })
}

// THE ACTUATION BOUNDARY FAILS CLOSED. Before review 52578, the wet entry returned
// ExitSuccess as soon as the receipt file was written, whatever the per-host verdicts said —
// so an execute-mode dispatch whose enable-linger FAILED went green with the refusal visible
// only as text. These pin the classifier the exit status is derived from: exactly the two
// converged verdicts count as converged, and every refusal and failure shape does not. RED
// against any future arm that adds a verdict without deciding whether it means converged.
test fn slice_verdict_classifier_admits_exactly_the_two_converged_verdicts() -> Bool {
  gunbc.spark_serving_converge_slice_wet.spark_serving_slice_verdict_is_converged(verdict: gunbc.spark_serving_converge_slice_wet.spark_serving_slice_verdict_noop_converged)
    && gunbc.spark_serving_converge_slice_wet.spark_serving_slice_verdict_is_converged(verdict: gunbc.spark_serving_converge_slice_wet.spark_serving_slice_verdict_applied_converged)
}

// THE APPLIED VERDICT NOW CARRIES ITS SERVING EVIDENCE, and the classifier admits it WITH that
// suffix. Left as an equality the classifier would have called a healthy host unconverged the moment
// the verdict gained evidence -- an inversion at the boundary the exit status is read from, and one
// that would have looked like a serving failure rather than a string comparison.
test fn the_converged_verdict_is_admitted_with_its_serving_evidence() -> Bool {
  spark_serving_slice_verdict_is_converged(
    verdict: join([spark_serving_slice_verdict_applied_converged, " serving-converged version=0.32.9 model=gpt-oss:20b"], ""),
  )
    && spark_serving_slice_verdict_is_converged(
         verdict: join([spark_serving_slice_verdict_noop_converged, " serving-converged version=0.32.9 model=gpt-oss:20b"], ""),
       )
}

// AND A HOST THAT RECONCILES BUT CANNOT SERVE IS NOT CONVERGED. This is the whole point of splitting
// the verdict: the resources matched, so every membership check says yes, and the server answers
// nothing. It must not reach the converged classification, and it must not do so by accident of
// string prefixes either -- the unhealthy verdict deliberately shares no prefix with the healthy one.
test fn a_resource_converged_but_unhealthy_host_is_not_converged() -> Bool {
  !spark_serving_slice_verdict_is_converged(
    verdict: join([spark_serving_slice_verdict_applied_converged, "-but-resources-converged-but-serving-unhealthy generation-incomplete"], ""),
  )
    && !spark_serving_slice_verdict_is_converged(
         verdict: join([spark_serving_slice_verdict_noop_converged, "-but-resources-converged-but-serving-unhealthy generation-incomplete"], ""),
       )
    && !spark_serving_slice_verdict_is_converged(
         verdict: join([spark_serving_slice_verdict_noop_converged, "-but-serving-health-unobserved generation probe produced no output"], ""),
       )
}

test fn slice_verdict_classifier_rejects_every_refusal_and_failure_shape() -> Bool {
  !gunbc.spark_serving_converge_slice_wet.spark_serving_slice_verdict_is_converged(verdict: "observation-refused probe-did-not-run")
    && !gunbc.spark_serving_converge_slice_wet.spark_serving_slice_verdict_is_converged(verdict: "plan-refused")
    && !gunbc.spark_serving_converge_slice_wet.spark_serving_slice_verdict_is_converged(verdict: "plan-hash-refused")
    && !gunbc.spark_serving_converge_slice_wet.spark_serving_slice_verdict_is_converged(verdict: "apply-refused bundle mismatch")
    && !gunbc.spark_serving_converge_slice_wet.spark_serving_slice_verdict_is_converged(verdict: "wet-apply-exec-failed exit=1 stderr=denied")
    && !gunbc.spark_serving_converge_slice_wet.spark_serving_slice_verdict_is_converged(verdict: "wet-applied-readback-mismatch lingering-still-no")
    && !gunbc.spark_serving_converge_slice_wet.spark_serving_slice_verdict_is_converged(verdict: "wet-applied-readback-refused probe-did-not-run")
    && !gunbc.spark_serving_converge_slice_wet.spark_serving_slice_verdict_is_converged(verdict: "would-apply typed-argv membership_writes=1")
}

// A host report carries its verdict as DATA, not only as rendered text. This is what makes the
// exit status derivable at all; if the report were a bare String the entry would be back to
// classifying its own prose.
test fn slice_host_report_carries_converged_as_data_matching_its_verdict() -> Bool {
  let converged = gunbc.spark_serving_converge_slice_wet.spark_serving_converge_slice_host_line(
    host: gunbc.fleet_intent_network.operator_host_srv5,
    endpoint: "192.168.1.222",
    observed_linger: gunbc.spark_serving_converge_slice_wet.LingerObserved { enabled: true },
    typed_row_count: 0,
    apply_effect_count: 0,
    apply_command_count: 0,
    verdict: gunbc.spark_serving_converge_slice_wet.spark_serving_slice_verdict_noop_converged,
  )
  let failed = gunbc.spark_serving_converge_slice_wet.spark_serving_converge_slice_host_line(
    host: gunbc.fleet_intent_network.operator_host_srv5,
    endpoint: "192.168.1.222",
    observed_linger: gunbc.spark_serving_converge_slice_wet.LingerUnobserved,
    typed_row_count: 0,
    apply_effect_count: 0,
    apply_command_count: 0,
    verdict: "wet-apply-exec-failed exit=1 stderr=denied",
  )
  converged.converged && !failed.converged
    && string_contains(s: failed.line, pattern: "observed_linger=unobserved")
}

// USER-SCOPE ARMS. A sudo word appearing in either of these would be a privilege escalation the
// effect does not call for, so absence of sudo is asserted rather than assumed.
test fn reload_user_manager_is_user_scope_and_carries_no_sudo() -> Bool {
  match spark_serving_reload_user_manager_remote_argv() {
    SparkServingInstallRemoteCommandsPresent { steps: sts } =>
      remote_operations_argv_only(operations: map(sts, st => st.operation)).length() == 1
        && join(remote_operations_argv_only(operations: map(sts, st => st.operation)).first(), "\0") == join(["systemctl", "--user", "daemon-reload"], "\0")
        && !any(remote_operations_argv_only(operations: map(sts, st => st.operation)).first(), w => w == "sudo")
    SparkServingInstallRemoteCommandsRefused { reason: _ } => false
  }
}

// The unit name is asserted against gunbc.spark.serving_unit_identity, NOT against a literal
// repeated here. A literal would pass while the enabled unit and the observed unit drifted apart,
// which is the single-authority failure this grounding exists to prevent.
test fn enable_user_unit_targets_the_unit_identity_authority() -> Bool {
  match spark_serving_enable_user_unit_remote_argv() {
    SparkServingInstallRemoteCommandsPresent { steps: sts } =>
      remote_operations_argv_only(operations: map(sts, st => st.operation)).length() == 1
        && join(remote_operations_argv_only(operations: map(sts, st => st.operation)).first(), "\0")
          == join(["systemctl", "--user", "enable", spark_serving_unit_name], "\0")
        && !any(remote_operations_argv_only(operations: map(sts, st => st.operation)).first(), w => w == "sudo")
    SparkServingInstallRemoteCommandsRefused { reason: _ } => false
  }
}

// ENABLE DOES NOT START, AND THIS IS THE CLAIM THAT KEEPS IT THAT WAY.
//
// The install used `enable --now`, which applies two remedies under one word: persistence and
// activity. That made an enabled-but-dead unit indistinguishable from a converged one at the
// membership layer, because the enablement member was the only place either fact could be recorded.
// A `--now` reintroduced anywhere fails here.
test fn enable_user_unit_does_not_also_start_the_unit() -> Bool {
  match spark_serving_enable_user_unit_remote_argv() {
    SparkServingInstallRemoteCommandsPresent { steps: sts } =>
      !any(remote_operations_argv_only(operations: map(sts, st => st.operation)).first(), w => w == "--now")
        && !any(remote_operations_argv_only(operations: map(sts, st => st.operation)).first(), w => w == "start")
    SparkServingInstallRemoteCommandsRefused { reason: _ } => false
  }
}

// The other half: starting is its own operation against the same unit identity authority, so the
// two remedies exist separately rather than the activity one having been dropped.
test fn start_user_unit_is_its_own_operation_on_the_unit_identity() -> Bool {
  match spark_serving_start_user_unit_remote_argv() {
    SparkServingInstallRemoteCommandsPresent { steps: sts } =>
      remote_operations_argv_only(operations: map(sts, st => st.operation)).length() == 1
        && join(remote_operations_argv_only(operations: map(sts, st => st.operation)).first(), "\0")
          == join(["systemctl", "--user", "start", spark_serving_unit_name], "\0")
        && !any(remote_operations_argv_only(operations: map(sts, st => st.operation)).first(), w => w == "sudo")
    SparkServingInstallRemoteCommandsRefused { reason: _ } => false
  }
}

// ORDER IS THE POINT. Reloading the manager after enabling the unit would enable against a
// manager that had not re-read the unit file. This is the first witness with two DIFFERENT
// realized effects, so it is the first that can observe order at all.
test fn realized_sequence_preserves_frozen_effect_order() -> Bool {
  match gunbc.spark_serving_converge_realize.realize_spark_serving_install_effect_commands(
    effects: [gunbc.spark_serving_realization.ReloadUserManager, gunbc.spark_serving_realization.EnableUserUnit],
    executor_login: gunbc.spark_serving_desired.spark_serving_automation_principal_login(),
  ) {
    SparkServingInstallRemoteCommandsPresent { steps: sts } =>
      remote_operations_argv_only(operations: map(sts, st => st.operation)).length() == 2
        && join(remote_operations_argv_only(operations: map(sts, st => st.operation))[0], "\0") == join(["systemctl", "--user", "daemon-reload"], "\0")
        && join(remote_operations_argv_only(operations: map(sts, st => st.operation))[1], "\0")
          == join(["systemctl", "--user", "enable", spark_serving_unit_name], "\0")
    SparkServingInstallRemoteCommandsRefused { reason: _ } => false
  }
}

// ── Tamper controls: what the approved artifact hash actually discriminates ──────────────────────

fn tamper_row(state: std.types.NonEmptyStr, ops: List<gunbc.remote_operation.RemoteOperation>) -> gunbc.fleet_converge_plan.FleetConvergeSparkServingTypedAction {
  gunbc.fleet_converge_plan.FleetConvergeSparkServingTypedAction {
    action: gunbc.membership_reconcile.MemberAdded {
      at: spark_serving_member_key(
        member: spark_serving_member(
          host: witness_host_srv5 as product.placement_supply.HostIdentity,
          principal: spark_serving_serving_principal(),
          address: gunbc.spark.serving_membership.SparkServingUserUnitAddress,
          state_digest: state,
          ownership: extdeps.languages.rust.types.Owned,
        ),
      ),
      to: spark_serving_member(
        host: witness_host_srv5 as product.placement_supply.HostIdentity,
        principal: spark_serving_serving_principal(),
        address: gunbc.spark.serving_membership.SparkServingUserUnitAddress,
        state_digest: state,
        ownership: extdeps.languages.rust.types.Owned,
      ),
    },
    first_execution: gunbc.fleet_converge_plan.PlannedEffectExecution {
      effect: gunbc.spark.serving_realization.EnableLingerForOwnAccount,
      first_step: gunbc.remote_operation.PlannedRemoteStep {
        identity: "tamper-head" as std.types.NonEmptyStr,
        operation: match ops.first() {
          Present { value: h } => h
          Absent => gunbc.remote_operation.RemoteArgv { argv: ["unreachable-empty-tamper-fixture"] }
        },
      },
      further_steps: map(
        ops.skip(n: 1),
        op => gunbc.remote_operation.PlannedRemoteStep { identity: "tamper-tail" as std.types.NonEmptyStr, operation: op },
      ),
    },
    further_executions: [],
  }
}

fn tamper_wire(state: std.types.NonEmptyStr, ops: List<gunbc.remote_operation.RemoteOperation>) -> String {
  fleet_converge_spark_serving_typed_actions_wire(rows: [tamper_row(state: state, ops: ops)])
}

data tamper_base_ops: List<gunbc.remote_operation.RemoteOperation> = [gunbc.remote_operation.RemoteArgv { argv: ["loginctl", "enable-linger", "a"] }]

// THE APPROVAL IS OVER THE VALUES, NOT ONLY THE ADDRESS. A row whose `to` digest moved from one
// model manifest to another used to serialize identically, because the member KEY is host x
// principal x address by design -- so the approved artifact still admitted after exactly the drift
// the baseline exists to catch. Key answers "which resource"; the digest answers "to what".
test fn changing_a_member_state_digest_changes_the_wire() -> Bool {
  tamper_wire(state: "digest-a" as std.types.NonEmptyStr, ops: tamper_base_ops)
    != tamper_wire(state: "digest-b" as std.types.NonEmptyStr, ops: tamper_base_ops)
}

// Changing one argv word changes it.
test fn changing_one_argv_word_changes_the_wire() -> Bool {
  tamper_wire(state: "digest-a" as std.types.NonEmptyStr, ops: tamper_base_ops)
    != tamper_wire(
      state: "digest-a" as std.types.NonEmptyStr,
      ops: [gunbc.remote_operation.RemoteArgv { argv: ["loginctl", "enable-linger", "b"] }],
    )
}

// REORDERING is a distinct tamper from substitution: the same two operations in the other order is
// a different program -- writing the unit before creating its directory is precisely the bare-host
// failure the mkdir ordering exists to prevent -- and a set-shaped wire would call them equal.
test fn reordering_two_operations_changes_the_wire() -> Bool {
  let a = gunbc.remote_operation.RemoteArgv { argv: ["mkdir", "-p", "/d"] }
  let b = gunbc.remote_operation.RemoteArgv { argv: ["loginctl", "enable-linger", "a"] }
  tamper_wire(state: "digest-a" as std.types.NonEmptyStr, ops: [a, b])
    != tamper_wire(state: "digest-a" as std.types.NonEmptyStr, ops: [b, a])
}

// And DROPPING an operation changes it, so a row cannot be quietly emptied while keeping its effects.
test fn dropping_an_operation_changes_the_wire() -> Bool {
  let a = gunbc.remote_operation.RemoteArgv { argv: ["mkdir", "-p", "/d"] }
  let b = gunbc.remote_operation.RemoteArgv { argv: ["loginctl", "enable-linger", "a"] }
  tamper_wire(state: "digest-a" as std.types.NonEmptyStr, ops: [a, b])
    != tamper_wire(state: "digest-a" as std.types.NonEmptyStr, ops: [a])
}

// THE POSITIVE CONTROL. Every claim above is an inequality, and inequalities are satisfied by a wire
// that is simply nondeterministic. Two structurally identical rows must produce the SAME wire, or
// the four claims above prove nothing about tamper detection.
test fn two_identical_rows_produce_the_same_wire() -> Bool {
  tamper_wire(state: "digest-a" as std.types.NonEmptyStr, ops: tamper_base_ops)
    == tamper_wire(state: "digest-a" as std.types.NonEmptyStr, ops: tamper_base_ops)
}
