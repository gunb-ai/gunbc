    prior_generation: 0,
    observed_timers: [],
    observed_caps: [],
    projection: slice_projection_linger(r: rel, linger_enabled: true),
  ) {
    SparkServingPlanArtifactReady { artifact: artifact } => length(scheduled_rows_list(scheduled: artifact.spark_serving_typed_actions)) == 0
    SparkServingPlanArtifactRefused { cause: _ } => false
  }
  }
}

test fn linger_slice_bundle_refuses_smuggled_v1_without_typed_rows() -> Bool {
  match slice_release() {
    Absent => false
    Present { value: rel } =>
  match spark_serving_fleet_converge_plan_artifact(
    host: witness_host_srv5,
    prior_generation: 0,
    observed_timers: [],
    observed_caps: [],
    projection: slice_projection_linger(r: rel, linger_enabled: false),
  ) {
    SparkServingPlanArtifactReady { artifact: artifact } =>
      match fleet_converge_plan_artifact_hash(artifact: artifact) {
        Present { value: hex } =>
          !gunbc.fleet_converge_plan.fleet_converge_plan_artifact_bundle_admits(
            artifact: gunbc.fleet_converge_plan.FleetConvergePlanArtifact {
              subject: artifact.subject,
              prior_generation: artifact.prior_generation,
              plan_lease: artifact.plan_lease,
              observed_baseline_hex: artifact.observed_baseline_hex,
              plan_body: artifact.plan_body,
              apply_shell: artifact.apply_shell,
              spark_serving_typed_actions: scheduled_rows_empty(),
            },
            claimed_hex: hex as String,
          )
        Absent => false
      }
    SparkServingPlanArtifactRefused { cause: _ } => false
  }
  }
}

test fn linger_slice_apply_reads_frozen_rows_as_typed_argv_when_drift() -> Bool {
  match slice_release() {
    Absent => false
    Present { value: rel } =>
  match spark_serving_fleet_converge_plan_artifact(
    host: witness_host_srv5,
    prior_generation: 0,
    observed_timers: [],
    observed_caps: [],
    projection: slice_projection_linger(r: rel, linger_enabled: false),
  ) {
    SparkServingPlanArtifactReady { artifact: artifact } =>
      match fleet_converge_plan_artifact_hash(artifact: artifact) {
        Present { value: hex } =>
          match gunbc.spark_serving_converge_apply.spark_serving_apply_reads_frozen_typed_rows(
            artifact: artifact,
            claimed_bundle_hex: hex as String,
          ) {
            SparkServingFrozenApplied { remote_steps: sts, effect_count: n } =>
              n == 1
                && remote_operations_argv_only(operations: map(sts, st => st.operation)).length() == 1
                && spark_serving_enable_linger_argv_matches_expected(
                  argv: remote_operations_argv_only(operations: map(sts, st => st.operation)).first(),
                )
            SparkServingFrozenApplyRefused { reason: _ } => false
          }
        Absent => false
      }
    SparkServingPlanArtifactRefused { cause: _ } => false
  }
  }
}

test fn linger_slice_apply_noop_when_converged() -> Bool {
  match slice_release() {
    Absent => false
    Present { value: rel } =>
  match spark_serving_fleet_converge_plan_artifact(
    host: witness_host_srv5,
    prior_generation: 0,
    observed_timers: [],
    observed_caps: [],
    projection: slice_projection_linger(r: rel, linger_enabled: true),
  ) {
    SparkServingPlanArtifactReady { artifact: artifact } =>
      match fleet_converge_plan_artifact_hash(artifact: artifact) {
        Present { value: hex } =>
          match gunbc.spark_serving_converge_apply.spark_serving_apply_reads_frozen_typed_rows(
            artifact: artifact,
