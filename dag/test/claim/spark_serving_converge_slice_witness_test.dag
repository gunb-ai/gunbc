          ) {
            SparkServingFrozenApplied { remote_steps: sts, effect_count: n } =>
              n == 0 && remote_operation_count(operations: map(sts, st => st.operation)) == 0
            SparkServingFrozenApplyRefused { reason: _ } => false
          }
        Absent => false
      }
    SparkServingPlanArtifactRefused { cause: _ } => false
  }
  }
}

test fn linger_slice_consistency_wall_requires_body_marker() -> Bool {
  match slice_release() {
    Absent => false
    Present { value: rel } =>
  match spark_serving_fleet_converge_plan_artifact(
    host: witness_host_srv5,
    prior_generation: 0,
    observed_timers: [],
    observed_caps: [],
    projection: slice_projection_linger(r: rel, linger_enabled: false),
  ) {
    SparkServingPlanArtifactReady { artifact: artifact } =>
      fleet_converge_plan_spark_typed_actions_consistency_admits(
        plan_body: artifact.plan_body,
