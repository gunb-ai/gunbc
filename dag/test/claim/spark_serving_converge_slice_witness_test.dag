module test.claim.spark_serving_converge_slice_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data witness_host_srv5: std.types.NonEmptyStr = "srv5" as std.types.NonEmptyStr

test fn linger_slice_noop_when_linger_already_enabled() -> Bool {
  gunbc.spark_serving_converge_plan.spark_serving_linger_slice_noop_when_converged(linger_enabled: true)
}

test fn linger_slice_plans_member_changed_when_linger_disabled() -> Bool {
  let plan = gunbc.spark_serving_converge_plan.spark_serving_linger_membership_plan(
    host: gunbc.fleet_intent_network.operator_host_srv5,
    linger_enabled: false,
  )
  any(plan.actions, a => match a {
    MemberChanged { at: _, from: _, to: _ } => true
    _ => false
  })
}

test fn linger_slice_enable_linger_remote_argv_is_portable_word_list() -> Bool {
  match gunbc.spark_serving_converge_realize.spark_serving_enable_linger_remote_argv(
    login: gunbc.spark_serving_desired.spark_serving_automation_principal_login(),
  ) {
    SparkServingInstallRemoteCommandsPresent { steps: sts } =>
      remote_operations_argv_only(operations: map(sts, st => st.operation)).length() == 1
        && spark_serving_enable_linger_argv_matches_expected(argv: remote_operations_argv_only(operations: map(sts, st => st.operation)).first())
    _ => false
  }
}

// THE FUSION CONTROL. Before the command-sequence repair, realize_spark_serving_install_effect_commands
// appended argv WORDS across effects, so two effects produced ONE argv with the second command's
// words as trailing operands of the first. Nothing refused it, because every word is individually
// portable. Two of the same effect is the smallest input that exhibits it with the single arm that
// exists today: it must yield TWO commands of five words each, never one command of ten. If this
// ever reads one command, the words have fused again.
test fn two_install_effects_realize_as_two_commands_not_one_fused_argv() -> Bool {
  match gunbc.spark_serving_converge_realize.realize_spark_serving_install_effect_commands(
    effects: [gunbc.spark_serving_realization.EnableLingerForOwnAccount, gunbc.spark_serving_realization.EnableLingerForOwnAccount],
    executor_login: gunbc.spark_serving_desired.spark_serving_automation_principal_login(),
  ) {
    SparkServingInstallRemoteCommandsPresent { steps: sts } =>
      remote_operations_argv_only(operations: map(sts, st => st.operation)).length() == 2
        && remote_operations_argv_only(operations: map(sts, st => st.operation)).first().length() == 5
        && spark_serving_enable_linger_argv_matches_expected(argv: remote_operations_argv_only(operations: map(sts, st => st.operation)).first())
    SparkServingInstallRemoteCommandsRefused { reason: _ } => false
  }
}

test fn a_single_effect_still_realizes_to_exactly_one_command() -> Bool {
  match gunbc.spark_serving_converge_realize.realize_spark_serving_install_effect_commands(
    effects: [gunbc.spark_serving_realization.EnableLingerForOwnAccount],
    executor_login: gunbc.spark_serving_desired.spark_serving_automation_principal_login(),
  ) {
    SparkServingInstallRemoteCommandsPresent { steps: sts } =>
      remote_operations_argv_only(operations: map(sts, st => st.operation)).length() == 1
        && spark_serving_enable_linger_argv_matches_expected(argv: remote_operations_argv_only(operations: map(sts, st => st.operation)).first())
    SparkServingInstallRemoteCommandsRefused { reason: _ } => false
  }
}

test fn an_unrealized_effect_still_refuses_the_whole_sequence() -> Bool {
  match realize_spark_serving_install_effect_commands(
    effects: [gunbc.spark.serving_realization.EnableLingerForOwnAccount, gunbc.spark.serving_realization.RunContainerAsOwnUser],
    executor_login: spark_serving_automation_principal_login(),
  ) {
    SparkServingInstallRemoteCommandsRefused { reason: _ } => true
    SparkServingInstallRemoteCommandsPresent { steps: _ } => false
  }
}

// THE PLAN NOW TAKES AN OBSERVATION, NOT A LINGER BOOL. These three claims are about the LINGER
// member specifically, so everything else in the observation is pinned to exactly desired and only
// linger varies -- which is what keeps them claims about linger rather than about the widening.
fn slice_release() -> gunbc.spark.serving_release.SparkServingRelease? {
  match spark_serving_desired_admission {
    SparkServingDesiredAdmitted { serving_release: r } => Present { value: r }
    SparkServingDesiredRefused { cause: _ } => none
  }
}

fn slice_projection_linger(r: gunbc.spark.serving_release.SparkServingRelease, linger_enabled: Bool) -> gunbc.spark.serving_observed_members.SparkServingObservedMemberProjection {
  spark_serving_observed_members(
    host: witness_host_srv5 as product.placement_supply.HostIdentity,
    runtime: gunbc.ollama_runtime_bundle.RuntimeMaterializationComplete {
      identity: ollama_runtime_materialization_identity_for_required_release(),
    },
    store: gunbc.ollama_runtime_bundle.ModelStoreComplete {
      manifest_identity: serialize_content_hash(hash: r.model.identity) as std.types.NonEmptyStr,
      blob_closure_count: 1,
    },
    unit: gunbc.spark.serving_observed_members.UserUnitStateObserved { unit_state_digest: spark_serving_user_unit_state_digest() },
    enablement: gunbc.spark.serving_observed_members.UserUnitManagerEnabled,
    activity: gunbc.spark.serving_observed_members.UnitActivityRunning,
    linger: if linger_enabled { gunbc.spark.serving_observed_members.LingerObservedEnabled } else { gunbc.spark.serving_observed_members.LingerObservedDisabled },
  )
}

test fn linger_slice_freezes_enable_linger_typed_row() -> Bool {
  match slice_release() {
    Absent => false
    Present { value: rel } =>
  match spark_serving_fleet_converge_plan_artifact(
    host: witness_host_srv5,
    prior_generation: 0,
    observed_timers: [],
    observed_caps: [],
    projection: slice_projection_linger(r: rel, linger_enabled: false),
  ) {
    SparkServingPlanArtifactReady { artifact: artifact } =>
      length(scheduled_rows_list(scheduled: artifact.spark_serving_typed_actions)) == 1
        && match spark_serving_frozen_linger_effect(row: scheduled_rows_list(scheduled: artifact.spark_serving_typed_actions)[0]) {
          Present { value: e } => e == gunbc.spark.serving_realization.EnableLingerForOwnAccount
          Absent => false
        }
        && string_contains(
          s: artifact.plan_body,
          pattern: "# spark-serving-typed-actions:",
        )
        && !string_contains(s: artifact.apply_shell, pattern: "loginctl")
    SparkServingPlanArtifactRefused { cause: _ } => false
  }
  }
}

test fn linger_slice_converged_plan_has_empty_typed_rows() -> Bool {
  match slice_release() {
    Absent => false
    Present { value: rel } =>
  match spark_serving_fleet_converge_plan_artifact(
