module test.claim.spark_serving_converge_slice_witness

data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data witness_host_srv5: std.types.NonEmptyStr = "srv5" as std.types.NonEmptyStr

test fn linger_slice_noop_when_linger_already_enabled() -> std.types.Bool {
  gunbc.spark_serving_converge_plan.spark_serving_linger_slice_noop_when_converged(linger_enabled: true)
}

test fn linger_slice_plans_member_changed_when_linger_disabled() -> std.types.Bool {
  let plan = gunbc.spark_serving_converge_plan.spark_serving_linger_membership_plan(
    host: gunbc.fleet_intent_network.operator_host_srv5,
    linger_enabled: false,
  )
  any(plan.actions, a => match a {
    gunbc.membership_reconcile.MemberChanged { from: _, to: _ } => true
    _ => false
  })
}

test fn linger_slice_enable_linger_remote_argv_is_portable_word_list() -> std.types.Bool {
  match gunbc.spark_serving_converge_realize.spark_serving_enable_linger_remote_argv(
    login: gunbc.spark_serving_desired.spark_serving_automation_principal_login(),
  ) {
    gunbc.spark_serving_converge_realize.SparkServingInstallRemoteArgvPresent { argv: remote_argv } =>
      gunbc.spark_serving_converge_realize.spark_serving_enable_linger_argv_matches_expected(argv: remote_argv)
    _ => false
  }
}

test fn linger_slice_freezes_enable_linger_typed_row() -> std.types.Bool {
  match gunbc.spark_serving_converge_plan.spark_serving_fleet_converge_plan_artifact(
    host: witness_host_srv5,
    prior_generation: 0,
    observed_timers: [],
    observed_caps: [],
    linger_enabled: false,
  ) {
    Present { value: artifact } =>
      length(artifact.spark_serving_typed_actions) == 1
        && match gunbc.spark_serving_converge_plan.spark_serving_frozen_linger_effect(row: artifact.spark_serving_typed_actions[0]) {
          Present { value: e } => e == gunbc.spark_serving_realization.EnableLingerForOwnAccount
          Absent => false
        }
        && string_contains(
          s: artifact.plan_body,
          pattern: "# spark-serving-typed-actions:",
        )
        && !string_contains(s: artifact.apply_shell, pattern: "loginctl")
    Absent => false
  }
}

test fn linger_slice_converged_plan_has_empty_typed_rows() -> std.types.Bool {
  match gunbc.spark_serving_converge_plan.spark_serving_fleet_converge_plan_artifact(
    host: witness_host_srv5,
    prior_generation: 0,
    observed_timers: [],
    observed_caps: [],
    linger_enabled: true,
  ) {
    Present { value: artifact } => length(artifact.spark_serving_typed_actions) == 0
    Absent => false
  }
}

test fn linger_slice_bundle_refuses_smuggled_v1_without_typed_rows() -> std.types.Bool {
  match gunbc.spark_serving_converge_plan.spark_serving_fleet_converge_plan_artifact(
    host: witness_host_srv5,
    prior_generation: 0,
    observed_timers: [],
    observed_caps: [],
    linger_enabled: false,
  ) {
    Present { value: artifact } =>
      match gunbc.fleet_converge_plan.fleet_converge_plan_artifact_hash(artifact: artifact) {
        Present { value: hex } =>
          !gunbc.fleet_converge_plan.fleet_converge_plan_artifact_bundle_admits(
            artifact: gunbc.fleet_converge_plan.FleetConvergePlanArtifact {
              subject: artifact.subject,
              prior_generation: artifact.prior_generation,
              plan_lease: artifact.plan_lease,
              observed_baseline_hex: artifact.observed_baseline_hex,
              plan_body: artifact.plan_body,
              apply_shell: artifact.apply_shell,
              spark_serving_typed_actions: [],
            },
            claimed_hex: hex as std.types.String,
          )
        Absent => false
      }
    Absent => false
  }
}

test fn linger_slice_apply_reads_frozen_rows_as_typed_argv_when_drift() -> std.types.Bool {
  match gunbc.spark_serving_converge_plan.spark_serving_fleet_converge_plan_artifact(
    host: witness_host_srv5,
    prior_generation: 0,
    observed_timers: [],
    observed_caps: [],
    linger_enabled: false,
  ) {
    Present { value: artifact } =>
      match gunbc.fleet_converge_plan.fleet_converge_plan_artifact_hash(artifact: artifact) {
        Present { value: hex } =>
          match gunbc.spark_serving_converge_apply.spark_serving_apply_reads_frozen_typed_rows(
            artifact: artifact,
            claimed_bundle_hex: hex as std.types.String,
          ) {
            gunbc.spark_serving_converge_apply.SparkServingFrozenApplied { remote_argv: argv, effect_count: n } =>
              n == 1 && gunbc.spark_serving_converge_realize.spark_serving_enable_linger_argv_matches_expected(argv: argv)
            gunbc.spark_serving_converge_apply.SparkServingFrozenApplyRefused { reason: _ } => false
          }
        Absent => false
      }
    Absent => false
  }
}

test fn linger_slice_apply_noop_when_converged() -> std.types.Bool {
  match gunbc.spark_serving_converge_plan.spark_serving_fleet_converge_plan_artifact(
    host: witness_host_srv5,
    prior_generation: 0,
    observed_timers: [],
    observed_caps: [],
    linger_enabled: true,
  ) {
    Present { value: artifact } =>
      match gunbc.fleet_converge_plan.fleet_converge_plan_artifact_hash(artifact: artifact) {
        Present { value: hex } =>
          match gunbc.spark_serving_converge_apply.spark_serving_apply_reads_frozen_typed_rows(
            artifact: artifact,
            claimed_bundle_hex: hex as std.types.String,
          ) {
            gunbc.spark_serving_converge_apply.SparkServingFrozenApplied { remote_argv: argv, effect_count: n } =>
              n == 0 && length(argv) == 0
            gunbc.spark_serving_converge_apply.SparkServingFrozenApplyRefused { reason: _ } => false
          }
        Absent => false
      }
    Absent => false
  }
}

test fn linger_slice_consistency_wall_requires_body_marker() -> std.types.Bool {
  match gunbc.spark_serving_converge_plan.spark_serving_fleet_converge_plan_artifact(
    host: witness_host_srv5,
    prior_generation: 0,
    observed_timers: [],
    observed_caps: [],
    linger_enabled: false,
  ) {
    Present { value: artifact } =>
      gunbc.fleet_converge_plan.fleet_converge_plan_spark_typed_actions_consistency_admits(
        plan_body: artifact.plan_body,
        spark_serving_typed_actions: artifact.spark_serving_typed_actions,
      )
    Absent => false
  }
}

// TARGET SELECTION REFUSES RATHER THAN WIDENS (DESIGN section 5, absorbing fallback).
// The pre-fix reader returned HostIdentity? and its consumer read Absent as "every
// enrolled Spark". Both refusal claims below are RED against that behavior: it answered
// the full host population where these require a typed refusal, and it did so on the
// path that actuates enable-linger.
test fn spark_target_absent_while_executing_refuses_rather_than_widening() -> std.types.Bool {
  match gunbc.fleet_multi_principal_probe.spark_converge_target_selection_of(raw: none, execute_apply: true) {
    gunbc.fleet_multi_principal_probe.SparkConvergeTargetRefused { reason: _ } => true
    gunbc.fleet_multi_principal_probe.SparkConvergeTargetAllObserveOnly => false
    gunbc.fleet_multi_principal_probe.SparkConvergeTargetSingle { host: _ } => false
  }
}

test fn spark_target_unrecognized_refuses_even_when_only_observing() -> std.types.Bool {
  match gunbc.fleet_multi_principal_probe.spark_converge_target_selection_of(
    raw: Present { value: "srv7" as std.types.NonEmptyStr },
    execute_apply: false,
  ) {
    gunbc.fleet_multi_principal_probe.SparkConvergeTargetRefused { reason: _ } => true
    gunbc.fleet_multi_principal_probe.SparkConvergeTargetAllObserveOnly => false
    gunbc.fleet_multi_principal_probe.SparkConvergeTargetSingle { host: _ } => false
  }
}

// The observe-only widening that IS legitimate: no target named, nothing actuates.
test fn spark_target_absent_while_observing_covers_all_enrolled_sparks() -> std.types.Bool {
  match gunbc.fleet_multi_principal_probe.spark_converge_target_selection_of(raw: none, execute_apply: false) {
    gunbc.fleet_multi_principal_probe.SparkConvergeTargetAllObserveOnly => true
    gunbc.fleet_multi_principal_probe.SparkConvergeTargetRefused { reason: _ } => false
    gunbc.fleet_multi_principal_probe.SparkConvergeTargetSingle { host: _ } => false
  }
}

// Positive control: a named target still selects exactly that one host under execution,
// so the refusals above are not a blanket refusal that would make the wall vacuous.
test fn spark_target_named_selects_exactly_that_host_under_execution() -> std.types.Bool {
  match gunbc.fleet_multi_principal_probe.spark_converge_target_selection_of(
    raw: Present { value: "srv6" as std.types.NonEmptyStr },
    execute_apply: true,
  ) {
    gunbc.fleet_multi_principal_probe.SparkConvergeTargetSingle { host: h } => h == gunbc.fleet_intent_network.operator_host_srv6
    gunbc.fleet_multi_principal_probe.SparkConvergeTargetRefused { reason: _ } => false
    gunbc.fleet_multi_principal_probe.SparkConvergeTargetAllObserveOnly => false
  }
}

// UNOBSERVED LINGER MUST NOT RENDER AS OBSERVED-DISABLED. RED against the prior receipt,
// which passed linger_enabled: false on every refusal path and therefore printed
// observed_linger=no for a host it had never reached — byte-identical to a reachable host
// with linger genuinely off. A reader or parser taking that field before the verdict would
// plan from an observation that was never made.
test fn observed_linger_renders_unobserved_distinctly_from_disabled() -> std.types.Bool {
  gunbc.spark_serving_converge_slice_wet.render_observed_linger(state: gunbc.spark_serving_converge_slice_wet.LingerUnobserved) == "unobserved"
    && gunbc.spark_serving_converge_slice_wet.render_observed_linger(state: gunbc.spark_serving_converge_slice_wet.LingerObserved { enabled: false }) == "no"
    && gunbc.spark_serving_converge_slice_wet.render_observed_linger(state: gunbc.spark_serving_converge_slice_wet.LingerObserved { enabled: true }) == "yes"
    && gunbc.spark_serving_converge_slice_wet.render_observed_linger(state: gunbc.spark_serving_converge_slice_wet.LingerUnobserved)
         != gunbc.spark_serving_converge_slice_wet.render_observed_linger(state: gunbc.spark_serving_converge_slice_wet.LingerObserved { enabled: false })
}

// THE ACTUATION BOUNDARY FAILS CLOSED. Before review 52578, the wet entry returned
// ExitSuccess as soon as the receipt file was written, whatever the per-host verdicts said —
// so an execute-mode dispatch whose enable-linger FAILED went green with the refusal visible
// only as text. These pin the classifier the exit status is derived from: exactly the two
// converged verdicts count as converged, and every refusal and failure shape does not. RED
// against any future arm that adds a verdict without deciding whether it means converged.
test fn slice_verdict_classifier_admits_exactly_the_two_converged_verdicts() -> std.types.Bool {
  gunbc.spark_serving_converge_slice_wet.spark_serving_slice_verdict_is_converged(verdict: gunbc.spark_serving_converge_slice_wet.spark_serving_slice_verdict_noop_converged)
    && gunbc.spark_serving_converge_slice_wet.spark_serving_slice_verdict_is_converged(verdict: gunbc.spark_serving_converge_slice_wet.spark_serving_slice_verdict_applied_converged)
}

test fn slice_verdict_classifier_rejects_every_refusal_and_failure_shape() -> std.types.Bool {
  !gunbc.spark_serving_converge_slice_wet.spark_serving_slice_verdict_is_converged(verdict: "observation-refused probe-did-not-run")
    && !gunbc.spark_serving_converge_slice_wet.spark_serving_slice_verdict_is_converged(verdict: "plan-refused")
    && !gunbc.spark_serving_converge_slice_wet.spark_serving_slice_verdict_is_converged(verdict: "plan-hash-refused")
    && !gunbc.spark_serving_converge_slice_wet.spark_serving_slice_verdict_is_converged(verdict: "apply-refused bundle mismatch")
    && !gunbc.spark_serving_converge_slice_wet.spark_serving_slice_verdict_is_converged(verdict: "wet-apply-exec-failed exit=1 stderr=denied")
    && !gunbc.spark_serving_converge_slice_wet.spark_serving_slice_verdict_is_converged(verdict: "wet-applied-readback-mismatch lingering-still-no")
    && !gunbc.spark_serving_converge_slice_wet.spark_serving_slice_verdict_is_converged(verdict: "wet-applied-readback-refused probe-did-not-run")
    && !gunbc.spark_serving_converge_slice_wet.spark_serving_slice_verdict_is_converged(verdict: "would-apply typed-argv membership_writes=1")
}

// A host report carries its verdict as DATA, not only as rendered text. This is what makes the
// exit status derivable at all; if the report were a bare String the entry would be back to
// classifying its own prose.
test fn slice_host_report_carries_converged_as_data_matching_its_verdict() -> std.types.Bool {
  let converged = gunbc.spark_serving_converge_slice_wet.spark_serving_converge_slice_host_line(
    host: gunbc.fleet_intent_network.operator_host_srv5,
    endpoint: "192.168.1.222",
    observed_linger: gunbc.spark_serving_converge_slice_wet.LingerObserved { enabled: true },
    typed_row_count: 0,
    apply_effect_count: 0,
    apply_argv_len: 0,
    verdict: gunbc.spark_serving_converge_slice_wet.spark_serving_slice_verdict_noop_converged,
  )
  let failed = gunbc.spark_serving_converge_slice_wet.spark_serving_converge_slice_host_line(
    host: gunbc.fleet_intent_network.operator_host_srv5,
    endpoint: "192.168.1.222",
    observed_linger: gunbc.spark_serving_converge_slice_wet.LingerUnobserved,
    typed_row_count: 0,
    apply_effect_count: 0,
    apply_argv_len: 0,
    verdict: "wet-apply-exec-failed exit=1 stderr=denied",
  )
  converged.converged && !failed.converged
    && string_contains(s: failed.line, pattern: "observed_linger=unobserved")
}
