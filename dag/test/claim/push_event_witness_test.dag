module test.claim.push_event_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

// Hermetic executing consumer for extdeps.github.push_event JSON ingest and git object-id validation. Payload read refusal on a missing path lives in test.claim.push_event_witness_wet (Filesystem.Read is wet-only).
test fn witness_push_before_observed_from_json() -> Bool {
  match extdeps.github.push_event.push_before_from_event_json(
    text: "{\"before\":\"abc123def4567890abc123def4567890abc12345\",\"after\":\"fedcba09\"}"
  ) {
    extdeps.github.push_event.PushBeforeObserved { sha: sha } =>
      (sha as String) == "abc123def4567890abc123def4567890abc12345"
    extdeps.github.push_event.PushBeforeAbsent { detail: _ } => false
    extdeps.github.push_event.PushBeforeZeroSha => false
    extdeps.github.push_event.PushBeforeMalformed { detail: _ } => false
    extdeps.github.push_event.PushEventPayloadReadRefused { path: _, cause: _ } => false
  }
}

test fn witness_push_before_zero_sha_from_json() -> Bool {
  match extdeps.github.push_event.push_before_from_event_json(
    text: concat("{\"before\":\"", concat(extdeps.git.hooks.zero_sha, "\",\"after\":\"abc\"}"))
  ) {
    extdeps.github.push_event.PushBeforeZeroSha => true
    extdeps.github.push_event.PushBeforeObserved { sha: _ } => false
    extdeps.github.push_event.PushBeforeAbsent { detail: _ } => false
    extdeps.github.push_event.PushBeforeMalformed { detail: _ } => false
    extdeps.github.push_event.PushEventPayloadReadRefused { path: _, cause: _ } => false
  }
}

test fn witness_push_before_absent_member_refuses() -> Bool {
  match extdeps.github.push_event.push_before_from_event_json(text: "{\"after\":\"abc\"}") {
    extdeps.github.push_event.PushBeforeAbsent { detail: _ } => true
    extdeps.github.push_event.PushBeforeObserved { sha: _ } => false
    extdeps.github.push_event.PushBeforeZeroSha => false
    extdeps.github.push_event.PushBeforeMalformed { detail: _ } => false
    extdeps.github.push_event.PushEventPayloadReadRefused { path: _, cause: _ } => false
  }
}

test fn witness_push_before_malformed_json_refuses() -> Bool {
  match extdeps.github.push_event.push_before_from_event_json(text: "not json") {
    extdeps.github.push_event.PushBeforeMalformed { detail: _ } => true
    extdeps.github.push_event.PushBeforeObserved { sha: _ } => false
    extdeps.github.push_event.PushBeforeAbsent { detail: _ } => false
    extdeps.github.push_event.PushBeforeZeroSha => false
    extdeps.github.push_event.PushEventPayloadReadRefused { path: _, cause: _ } => false
  }
}

test fn witness_push_before_invalid_sha_refuses_before_minting() -> Bool {
  match extdeps.github.push_event.push_before_from_event_json(text: "{\"before\":\"not-a-valid-git-object-id\"}") {
    extdeps.github.push_event.PushBeforeMalformed { detail: detail } =>
      detail == "push event before member is not a valid git object id"
    extdeps.github.push_event.PushBeforeObserved { sha: _ } => false
    extdeps.github.push_event.PushBeforeAbsent { detail: _ } => false
    extdeps.github.push_event.PushBeforeZeroSha => false
    extdeps.github.push_event.PushEventPayloadReadRefused { path: _, cause: _ } => false
  }
}
