module test.claim.optional_layers_witness

import std.types { Bool }
import std.nat { Zero, nat_add }
import std.optional { Absent, Present }
import v2.std.optional_layers {
  one_optional_layer,
  peel_optional_layer,
  two_optional_layers
}

// SUBJECT: optional-layer depth as std.nat Nat (Zero = required). Inputs are supplied Nat values
// (DESIGN §3). Production inhabitance of the Node reading is
// v2.test.claim.compiler.optional_layers.

test fn required_composed_with_one_layer_is_one_layer() -> Bool {
  nat_add(a: Zero, b: one_optional_layer()) == one_optional_layer()
}

test fn substituting_an_optional_into_an_optional_adds_a_layer() -> Bool {
  nat_add(a: one_optional_layer(), b: one_optional_layer()) == two_optional_layers()
}

test fn max_would_collapse_two_ones_and_this_does_not() -> Bool {
  !(nat_add(a: one_optional_layer(), b: one_optional_layer()) == one_optional_layer())
}

test fn peel_of_one_layer_is_required() -> Bool {
  match peel_optional_layer(depth: one_optional_layer()) {
    Present { value: inner } => inner == Zero
    Absent => false
  }
}

test fn peel_of_required_refuses() -> Bool {
  match peel_optional_layer(depth: Zero) {
    Absent => true
    Present { value: _ } => false
  }
}

test fn one_layer_is_not_two() -> Bool {
  !(one_optional_layer() == two_optional_layers())
}

test fn required_is_not_one_layer() -> Bool {
  !(Zero == one_optional_layer())
}
