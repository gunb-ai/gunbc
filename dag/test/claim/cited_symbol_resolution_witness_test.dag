module test.claim.cited_symbol_resolution_witness_test

import gunbc.ci_layer_roots { witness_layer_roots }
import gunbc.doc_graph_roots {
  hand_authored_doc_declaration_refs,
  hand_authored_works_refs_all_resolve,
}
import std.decl_ref { DeclarationRef, WholeDeclaration, NamedField, decl_ref }
import v2.lens.enforcement.receipts { enforcement_red_probe_body_leaf }
import v2.lens.module_graph { module_declaration_facts_live }
import v2.std.decl_index { DeclFact, FnItem, decl_facts }
import v2.std.decl_ref_resolution {
  resolve_declaration_ref,
  cited_declaration_ref_refusal_count,
  declaration_ref_resolution_census,
  DeclarationRefResolved,
  DeclarationRefModuleAbsent,
  DeclarationRefDeclarationAbsent,
  DeclarationRefFieldAbsent,
  DeclarationRefAmbiguous,
}

data cited_symbol_resolution_witness_note: String = "G1 feature:cited-symbol-resolution — resolve_declaration_ref is the single authority over decl_facts + module_declaration_facts: exactly one declaration_identity, or one of four typed refusal arms (module absent / declaration absent / field absent / ambiguous). Positive controls use live production symbols and the hand-authored doc bind census; RED controls plant each refusal arm on synthetic refs without mutating the corpus."

test fn cited_symbol_resolves_node_kind_authority() -> Bool {
  match resolve_declaration_ref(
    ref: DeclarationRef {
      module_path: "v2.std.node",
      decl_name: "NodeKind",
      field: WholeDeclaration,
    },
    facts: decl_facts(pool_roots: witness_layer_roots),
    modules: module_declaration_facts_live(pool_roots: witness_layer_roots)
  ) {
    DeclarationRefResolved { declaration_identity: id } => id.qualified_name == "std.node.NodeKind"
    DeclarationRefModuleAbsent { reference: _ } => false
    DeclarationRefDeclarationAbsent { reference: _ } => false
    DeclarationRefFieldAbsent { reference: _ } => false
    DeclarationRefAmbiguous { reference: _, candidates: _ } => false
  }
}

test fn cited_symbol_resolves_decl_ref_constructor() -> Bool {
  match resolve_declaration_ref(
    ref: decl_ref(module_path: "std.decl_ref", decl_name: "decl_ref"),
    facts: decl_facts(pool_roots: witness_layer_roots),
    modules: module_declaration_facts_live(pool_roots: witness_layer_roots)
  ) {
    DeclarationRefResolved { declaration_identity: _ } => true
    DeclarationRefModuleAbsent { reference: _ } => false
    DeclarationRefDeclarationAbsent { reference: _ } => false
    DeclarationRefFieldAbsent { reference: _ } => false
    DeclarationRefAmbiguous { reference: _, candidates: _ } => false
  }
}

test fn cited_symbol_refuses_module_absent() -> Bool {
  match resolve_declaration_ref(
    ref: DeclarationRef {
      module_path: "synthetic.g1_module_absent_RED",
      decl_name: "any",
      field: WholeDeclaration,
    },
    facts: decl_facts(pool_roots: witness_layer_roots),
    modules: module_declaration_facts_live(pool_roots: witness_layer_roots)
  ) {
    DeclarationRefModuleAbsent { reference: _ } => true
    DeclarationRefResolved { declaration_identity: _ } => false
    DeclarationRefDeclarationAbsent { reference: _ } => false
    DeclarationRefFieldAbsent { reference: _ } => false
    DeclarationRefAmbiguous { reference: _, candidates: _ } => false
  }
}

test fn cited_symbol_refuses_declaration_absent() -> Bool {
  match resolve_declaration_ref(
    ref: DeclarationRef {
      module_path: "v2.std.node",
      decl_name: "NoSuchDecl_G1_RED",
      field: WholeDeclaration,
    },
    facts: decl_facts(pool_roots: witness_layer_roots),
    modules: module_declaration_facts_live(pool_roots: witness_layer_roots)
  ) {
    DeclarationRefDeclarationAbsent { reference: _ } => true
    DeclarationRefResolved { declaration_identity: _ } => false
    DeclarationRefModuleAbsent { reference: _ } => false
    DeclarationRefFieldAbsent { reference: _ } => false
    DeclarationRefAmbiguous { reference: _, candidates: _ } => false
  }
}

test fn cited_symbol_refuses_ambiguous_binding() -> Bool {
  let facts = [
    DeclFact {
      qualified_name: "std.node.g1_ambiguous",
      name: "g1_ambiguous",
      kind: FnItem,
      node: enforcement_red_probe_body_leaf,
      rel_path: "synthetic/a.dag",
    },
    DeclFact {
      qualified_name: "std.node.g1_ambiguous",
      name: "g1_ambiguous",
      kind: FnItem,
      node: enforcement_red_probe_body_leaf,
      rel_path: "synthetic/b.dag",
    },
  ]
  match resolve_declaration_ref(
    ref: DeclarationRef {
      module_path: "v2.std.node",
      decl_name: "g1_ambiguous",
      field: WholeDeclaration,
    },
    facts: facts,
    modules: module_declaration_facts_live(pool_roots: witness_layer_roots)
  ) {
    DeclarationRefAmbiguous { reference: _, candidates: c } => length(xs: c) == 2
    DeclarationRefResolved { declaration_identity: _ } => false
    DeclarationRefModuleAbsent { reference: _ } => false
    DeclarationRefDeclarationAbsent { reference: _ } => false
    DeclarationRefFieldAbsent { reference: _ } => false
  }
}

test fn cited_symbol_refuses_named_field_absent() -> Bool {
  match resolve_declaration_ref(
    ref: DeclarationRef {
      module_path: "v2.std.node",
      decl_name: "NodeKind",
      field: NamedField { field_name: "NoSuchField_G1_RED" },
    },
    facts: decl_facts(pool_roots: witness_layer_roots),
    modules: module_declaration_facts_live(pool_roots: witness_layer_roots)
  ) {
    DeclarationRefFieldAbsent { reference: _ } => true
    DeclarationRefResolved { declaration_identity: _ } => false
    DeclarationRefModuleAbsent { reference: _ } => false
    DeclarationRefDeclarationAbsent { reference: _ } => false
    DeclarationRefAmbiguous { reference: _, candidates: _ } => false
  }
}

test fn cited_symbol_hand_authored_binds_all_resolve() -> Bool {
  hand_authored_works_refs_all_resolve()
}

test fn cited_symbol_hand_authored_census_is_zero_refusals() -> Bool {
  let facts = decl_facts(pool_roots: witness_layer_roots)
  let modules = module_declaration_facts_live(pool_roots: witness_layer_roots)
  let census = declaration_ref_resolution_census(
    refs: hand_authored_doc_declaration_refs(),
    facts: facts,
    modules: modules
  )
  census.module_absent_count == 0
    && census.declaration_absent_count == 0
    && census.field_absent_count == 0
    && census.ambiguous_count == 0
    && census.resolved_count == length(xs: hand_authored_doc_declaration_refs())
}

test fn cited_symbol_refusal_count_red_on_dangling_fixture() -> Bool {
  let facts = decl_facts(pool_roots: witness_layer_roots)
  let modules = module_declaration_facts_live(pool_roots: witness_layer_roots)
  let dangling = [
    DeclarationRef {
      module_path: "v2.std.node",
      decl_name: "NoSuchDecl_G1_RED",
      field: WholeDeclaration,
    },
  ]
  cited_declaration_ref_refusal_count(refs: dangling, facts: facts, modules: modules) == 1
}
