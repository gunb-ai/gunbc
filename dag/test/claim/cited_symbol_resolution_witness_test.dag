module test.claim.cited_symbol_resolution_witness_test

import gunbc.ci_layer_roots { witness_layer_roots }
import gunbc.doc_graph_roots {
  hand_authored_cited_symbol_control_declaration_refs,
  hand_authored_doc_declaration_refs,
  hand_authored_production_doc_declaration_refs,
}
import std.decl_ref { DeclarationRef, WholeDeclaration, NamedField, decl_ref }
import v2.lens.cited_symbol_resolution {
  cited_symbol_enrolled_refusal_count,
  cited_symbol_planted_ambiguous_control_refuses,
  cited_symbol_planted_control_refusal_count,
  cited_symbol_resolution_violation_count,
}
import v2.lens.enforcement.receipts { enforcement_red_probe_body_leaf }
import v2.lens.module_graph { ModuleDeclarationFact, module_declaration_facts_live }
import v2.std.decl_index { DeclFact, FnItem, decl_facts }
import v2.std.decl_ref_resolution {
  resolve_declaration_ref,
  cited_declaration_ref_refusal_count,
  DeclarationRefResolved,
  DeclarationRefModuleAbsent,
  DeclarationRefDeclarationAbsent,
  DeclarationRefFieldAbsent,
  DeclarationRefAmbiguous,
}

data cited_symbol_resolution_witness_note: String = "G1 feature:cited-symbol-resolution — fast per-PR controls over cached witness-layer decl_facts + module_declaration_facts rows, synthetic fixtures, and permanent planted HandAuthoredDocBind controls (operator ruling 2026-08-03). Corpus-scale production census witnesses live in test.claim.long.cited_symbol_resolution_witness_test (operator 5s fast-lane rule)."

data cited_symbol_witness_layer_facts: List<DeclFact> = decl_facts(pool_roots: witness_layer_roots)

data cited_symbol_witness_layer_modules: List<ModuleDeclarationFact> = module_declaration_facts_live(pool_roots: witness_layer_roots)

test fn cited_symbol_resolves_node_kind_authority() -> Bool {
  match resolve_declaration_ref(
    ref: DeclarationRef {
      module_path: "v2.std.node",
      decl_name: "NodeKind",
      field: WholeDeclaration,
    },
    facts: cited_symbol_witness_layer_facts,
    modules: cited_symbol_witness_layer_modules
  ) {
    DeclarationRefResolved { declaration_identity: id } => id.qualified_name == "std.node.NodeKind"
    DeclarationRefModuleAbsent { reference: _ } => false
    DeclarationRefDeclarationAbsent { reference: _ } => false
    DeclarationRefFieldAbsent { reference: _ } => false
    DeclarationRefAmbiguous { reference: _, candidates: _ } => false
  }
}

test fn cited_symbol_resolves_decl_ref_constructor() -> Bool {
  match resolve_declaration_ref(
    ref: decl_ref(module_path: "std.decl_ref", decl_name: "decl_ref"),
    facts: cited_symbol_witness_layer_facts,
    modules: cited_symbol_witness_layer_modules
  ) {
    DeclarationRefResolved { declaration_identity: _ } => true
    DeclarationRefModuleAbsent { reference: _ } => false
    DeclarationRefDeclarationAbsent { reference: _ } => false
    DeclarationRefFieldAbsent { reference: _ } => false
    DeclarationRefAmbiguous { reference: _, candidates: _ } => false
  }
}

test fn cited_symbol_refuses_module_absent() -> Bool {
  match resolve_declaration_ref(
    ref: DeclarationRef {
      module_path: "synthetic.g1_module_absent_RED",
      decl_name: "any",
      field: WholeDeclaration,
    },
    facts: cited_symbol_witness_layer_facts,
    modules: cited_symbol_witness_layer_modules
  ) {
    DeclarationRefModuleAbsent { reference: _ } => true
    DeclarationRefResolved { declaration_identity: _ } => false
    DeclarationRefDeclarationAbsent { reference: _ } => false
    DeclarationRefFieldAbsent { reference: _ } => false
    DeclarationRefAmbiguous { reference: _, candidates: _ } => false
  }
}

test fn cited_symbol_refuses_declaration_absent() -> Bool {
  match resolve_declaration_ref(
    ref: DeclarationRef {
      module_path: "v2.std.node",
      decl_name: "NoSuchDecl_G1_RED",
      field: WholeDeclaration,
    },
    facts: cited_symbol_witness_layer_facts,
    modules: cited_symbol_witness_layer_modules
  ) {
    DeclarationRefDeclarationAbsent { reference: _ } => true
    DeclarationRefResolved { declaration_identity: _ } => false
    DeclarationRefModuleAbsent { reference: _ } => false
    DeclarationRefFieldAbsent { reference: _ } => false
    DeclarationRefAmbiguous { reference: _, candidates: _ } => false
  }
}

test fn cited_symbol_refuses_ambiguous_binding() -> Bool {
  let facts = [
    DeclFact {
      qualified_name: "std.node.g1_ambiguous",
      name: "g1_ambiguous",
      kind: FnItem,
      node: enforcement_red_probe_body_leaf,
      rel_path: "synthetic/a.dag",
    },
    DeclFact {
      qualified_name: "std.node.g1_ambiguous",
      name: "g1_ambiguous",
      kind: FnItem,
      node: enforcement_red_probe_body_leaf,
      rel_path: "synthetic/b.dag",
    },
  ]
  match resolve_declaration_ref(
    ref: DeclarationRef {
      module_path: "v2.std.node",
      decl_name: "g1_ambiguous",
      field: WholeDeclaration,
    },
    facts: facts,
    modules: cited_symbol_witness_layer_modules
  ) {
    DeclarationRefAmbiguous { reference: _, candidates: c } => length(xs: c) == 2
    DeclarationRefResolved { declaration_identity: _ } => false
    DeclarationRefModuleAbsent { reference: _ } => false
    DeclarationRefDeclarationAbsent { reference: _ } => false
    DeclarationRefFieldAbsent { reference: _ } => false
  }
}

test fn cited_symbol_refuses_named_field_absent() -> Bool {
  match resolve_declaration_ref(
    ref: DeclarationRef {
      module_path: "v2.std.node",
      decl_name: "NodeKind",
      field: NamedField { field_name: "NoSuchField_G1_RED" },
    },
    facts: cited_symbol_witness_layer_facts,
    modules: cited_symbol_witness_layer_modules
  ) {
    DeclarationRefFieldAbsent { reference: _ } => true
    DeclarationRefResolved { declaration_identity: _ } => false
    DeclarationRefModuleAbsent { reference: _ } => false
    DeclarationRefDeclarationAbsent { reference: _ } => false
    DeclarationRefAmbiguous { reference: _, candidates: _ } => false
  }
}

test fn cited_symbol_refusal_count_red_on_dangling_fixture() -> Bool {
  let dangling = [
    DeclarationRef {
      module_path: "v2.std.node",
      decl_name: "NoSuchDecl_G1_RED",
      field: WholeDeclaration,
    },
  ]
  cited_declaration_ref_refusal_count(
    refs: dangling,
    facts: cited_symbol_witness_layer_facts,
    modules: cited_symbol_witness_layer_modules
  ) == 1
}

test fn cited_symbol_planted_doc_graph_controls_are_enrolled() -> Bool {
  length(xs: hand_authored_cited_symbol_control_declaration_refs()) == 3
}

test fn cited_symbol_planted_doc_graph_controls_all_refuse() -> Bool {
  cited_symbol_planted_control_refusal_count() == 3
}

test fn cited_symbol_planted_ambiguous_control_refuses() -> Bool {
  cited_symbol_planted_ambiguous_control_refuses()
}

test fn cited_symbol_enrolled_population_refusal_proves_gate_not_vacuous() -> Bool {
  cited_symbol_enrolled_refusal_count() >= 3 && cited_symbol_resolution_violation_count() == cited_symbol_enrolled_refusal_count() - cited_symbol_planted_control_refusal_count()
}

test fn cited_symbol_production_population_excludes_planted_controls() -> Bool {
  length(xs: hand_authored_doc_declaration_refs()) == length(xs: hand_authored_production_doc_declaration_refs()) + length(xs: hand_authored_cited_symbol_control_declaration_refs())
}
