module test.claim.dag_compile_clean_perturb_receipts


data live_tree_disposition: LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

test fn dag_compile_clean_perturb_receipts_holds() -> Bool {
  tools.dag_compile_clean_transport.run_perturb_optional_skew_red_receipt()
    && tools.dag_compile_clean_transport.run_perturb_unresolved_import_red_receipt()
    && tools.dag_compile_clean_transport.run_cross_tree_import_green_receipt()
    && tools.dag_compile_clean_transport.run_dag_shell_primary_precedence_receipt()
}
