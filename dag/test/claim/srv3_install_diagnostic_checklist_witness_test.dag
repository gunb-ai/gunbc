module test.claim.srv3_install_diagnostic_checklist

import std.logic { Bool }
import gunbc.srv3_install_diagnostic_checklist {
  srv3_install_diagnostic_observe_script_declares_five_surfaces,
  srv3_install_diagnostic_checklist_entrypoint_is_declared,
  srv3_install_diagnostic_observe_script,
}
import gunbc.srv3_os_install_diagnostic {
  srv3_os_install_attempt_intent,
  srv3_remote_bmc_probe_observation,
  srv3_remote_bmc_probe_diagnostic_is_needs_serve_observation,
  diagnose_srv3_install,
  parse_srv3_install_debug_observation,
  InconclusiveNeedsServeObservation,
  ServeDown,
  ReadyToBoot,
  ServeObserved,
  ServeProcessesPresent,
  ServePortListening,
  TokenPresent,
  IsoPresent,
  WebsocketUpgradeAccepted,
  NoAttachedServe,
  NbdServeProcessObservation,
  NbdServePortObservation,
  BmcSessionTokenObservation,
  IsoServeReadinessObservation,
  NbdkitAbsent,
  ServePortAbsent,
  Srv3InstallDebugObservation,
  RedfishBootObservation,
  BootProgressNone,
  SolConsoleContentObservation,
}
import gunbc.srv3_seeded_install_media { srv3_seeded_install_media_content_hash }
import gunbc.network_identity_subsumption { srv3_pre_install_lease_table }
import extdeps.bmc.types { BootOverrideDisabled, BootTargetNone, On }
import extdeps.bmc.webui.nbd_proxy_serve { srv3_nbd_proxy_local_port }
import std.measure { byte_size }

test fn observe_script_covers_five_surfaces() -> Bool {
  srv3_install_diagnostic_observe_script_declares_five_surfaces()
    && string_contains(s: srv3_install_diagnostic_observe_script(intent: srv3_os_install_attempt_intent), pattern: "pgrep -x nbdkit")
    && string_contains(s: srv3_install_diagnostic_observe_script(intent: srv3_os_install_attempt_intent), pattern: "sha256sum")
    && string_contains(s: srv3_install_diagnostic_observe_script(intent: srv3_os_install_attempt_intent), pattern: "port_owner=")
    && string_contains(s: srv3_install_diagnostic_observe_script(intent: srv3_os_install_attempt_intent), pattern: "/vm/0/0")
}

test fn remote_bmc_probe_needs_serve_observation() -> Bool {
  srv3_remote_bmc_probe_diagnostic_is_needs_serve_observation()
    && match diagnose_srv3_install(
      intent: srv3_os_install_attempt_intent,
      observation: srv3_remote_bmc_probe_observation,
    ) {
      InconclusiveNeedsServeObservation => true
      _ => false
    }
}

test fn parse_stdout_disabled_boot_override_pre_boot_ready() -> Bool {
  let hash = srv3_seeded_install_media_content_hash as String
  let stdout = concat(
    concat("Srv3InstallObserveReceipt: surface=serve nbdkit=present websocat=present port_owner=expected token=present iso=match iso_file_sha256=abc123 content_hash_observed=", hash),
    "\nSrv3InstallObserveReceipt: surface=bmc_websocket http_code=101\nSrv3InstallObserveReceipt: surface=redfish power=On boot_enabled=Disabled boot_target=None\nSrv3InstallObserveReceipt: surface=sol status=silent\nSrv3InstallObserveReceipt: surface=router status=operator_required\n",
  )
  match diagnose_srv3_install(
    intent: srv3_os_install_attempt_intent,
    observation: parse_srv3_install_debug_observation(stdout: stdout, intent: srv3_os_install_attempt_intent),
  ) {
    ReadyToBoot => true
    _ => false
  }
}

test fn parse_stdout_iso_hash_mismatch_is_serve_down() -> Bool {
  let stdout = "Srv3InstallObserveReceipt: surface=serve nbdkit=present websocat=present port_owner=expected token=present iso=mismatch iso_file_sha256=abc123 content_hash_observed=stale-hash\nSrv3InstallObserveReceipt: surface=bmc_websocket http_code=101\nSrv3InstallObserveReceipt: surface=redfish power=On boot_enabled=Disabled boot_target=None\n"
  match diagnose_srv3_install(
    intent: srv3_os_install_attempt_intent,
    observation: parse_srv3_install_debug_observation(stdout: stdout, intent: srv3_os_install_attempt_intent),
  ) {
    ServeDown => true
    _ => false
  }
}

test fn parse_stdout_foreign_port_owner_is_serve_down() -> Bool {
  let hash = srv3_seeded_install_media_content_hash as String
  let stdout = concat(
    concat("Srv3InstallObserveReceipt: surface=serve nbdkit=present websocat=present port_owner=foreign token=present iso=match iso_file_sha256=abc123 content_hash_observed=", hash),
    "\nSrv3InstallObserveReceipt: surface=bmc_websocket http_code=101\n",
  )
  match diagnose_srv3_install(
    intent: srv3_os_install_attempt_intent,
    observation: parse_srv3_install_debug_observation(stdout: stdout, intent: srv3_os_install_attempt_intent),
  ) {
    ServeDown => true
    _ => false
  }
}

test fn serve_absent_observed_is_serve_down_not_ready() -> Bool {
  let observation = Srv3InstallDebugObservation {
    actuator_serve: ServeObserved {
      process: NbdkitAbsent,
      port: ServePortAbsent,
      session: TokenPresent,
      iso: IsoPresent { observed_content_hash: srv3_seeded_install_media_content_hash },
    },
    bmc_websocket: WebsocketUpgradeAccepted,
    redfish_boot: RedfishBootObservation {
      power_state: On,
      boot_override_enabled: BootOverrideDisabled,
      boot_override_target: BootTargetNone,
      boot_progress: BootProgressNone,
    },
    virtual_media_session: NoAttachedServe,
    sol: Present {
      value: SolConsoleContentObservation {
        bytes_captured: byte_size(0),
        duration_ms: 120000,
        contains_grub: false,
        contains_subiquity: false,
        contains_autoinstall: false,
        contains_firmware_menu: true,
        contains_error: false,
        capture_available: true,
      }
    },
    router_lease_table: Present { value: srv3_pre_install_lease_table },
    kvm: Absent,
    elapsed_since_boot_once_ms: Present { value: 120000 },
  }
  match diagnose_srv3_install(intent: srv3_os_install_attempt_intent, observation: observation) {
    ServeDown =>
      !srv3_install_diagnostic_is_ready_to_boot(
        verdict: diagnose_srv3_install(intent: srv3_os_install_attempt_intent, observation: observation),
      )
    _ => false
  }
}

test fn checklist_entrypoint_carries_dissolution_trigger() -> Bool {
  srv3_install_diagnostic_checklist_entrypoint_is_declared()
}
