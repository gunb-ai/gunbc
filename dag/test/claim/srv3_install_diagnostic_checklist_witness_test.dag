module test.claim.srv3_install_diagnostic_checklist


data live_tree_disposition: LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

test fn observe_script_covers_five_surfaces() -> Bool {
  gunbc.srv3_os_install_diagnostic.srv3_install_diagnostic_observe_script_declares_five_surfaces()
    && string_contains(s: gunbc.srv3_install_diagnostic_observe_script.srv3_install_diagnostic_observe_script(intent: gunbc.srv3_os_install_diagnostic.srv3_os_install_attempt_intent), pattern: "pgrep -x nbdkit")
    && string_contains(s: gunbc.srv3_install_diagnostic_observe_script.srv3_install_diagnostic_observe_script(intent: gunbc.srv3_os_install_diagnostic.srv3_os_install_attempt_intent), pattern: "sha256sum")
    && string_contains(s: gunbc.srv3_install_diagnostic_observe_script.srv3_install_diagnostic_observe_script(intent: gunbc.srv3_os_install_diagnostic.srv3_os_install_attempt_intent), pattern: "port_owner=")
    && string_contains(s: gunbc.srv3_install_diagnostic_observe_script.srv3_install_diagnostic_observe_script(intent: gunbc.srv3_os_install_diagnostic.srv3_os_install_attempt_intent), pattern: "/vm/0/0")
}

test fn observe_script_websocket_http_code_not_concatenated_before_if() -> Bool {
  let script = gunbc.srv3_install_diagnostic_observe_script.srv3_install_diagnostic_observe_script(intent: gunbc.srv3_os_install_diagnostic.srv3_os_install_attempt_intent)
  !string_contains(s: script, pattern: "HTTP_CODE=if")
    && !string_contains(s: script, pattern: "echo 000))")
    && string_contains(s: script, pattern: "HTTP_CODE=$(curl")
}

test fn remote_bmc_probe_needs_serve_observation() -> Bool {
  gunbc.srv3_os_install_diagnostic.srv3_remote_bmc_probe_diagnostic_is_needs_serve_observation()
    && match gunbc.srv3_os_install_diagnostic.diagnose_srv3_install(
      intent: gunbc.srv3_os_install_diagnostic.srv3_os_install_attempt_intent,
      observation: gunbc.srv3_os_install_diagnostic.srv3_remote_bmc_probe_observation,
    ) {
      InconclusiveNeedsServeObservation => true
      _ => false
    }
}

test fn parse_stdout_disabled_boot_override_pre_boot_ready() -> Bool {
  let hash = gunbc.srv3_seeded_install_media_artifact.srv3_seeded_install_media_content_hash as String
  let stdout = concat(
    concat("Srv3InstallObserveReceipt: surface=serve nbdkit=present websocat=present port_owner=expected token=present iso=match iso_file_sha256=abc123 content_hash_observed=", hash),
    "\nSrv3InstallObserveReceipt: surface=bmc_websocket http_code=101\nSrv3InstallObserveReceipt: surface=redfish power=On boot_enabled=Disabled boot_target=None\nSrv3InstallObserveReceipt: surface=sol status=silent\nSrv3InstallObserveReceipt: surface=router status=operator_required\n",
  )
  match gunbc.srv3_os_install_diagnostic.diagnose_srv3_install(
    intent: gunbc.srv3_os_install_diagnostic.srv3_os_install_attempt_intent,
    observation: gunbc.srv3_os_install_diagnostic.parse_srv3_install_debug_observation(stdout: stdout, intent: gunbc.srv3_os_install_diagnostic.srv3_os_install_attempt_intent),
  ) {
    ReadyToBoot => true
    _ => false
  }
}

test fn parse_stdout_elapsed_boot_once_ms_populates_observation() -> Bool {
  let hash = gunbc.srv3_seeded_install_media_artifact.srv3_seeded_install_media_content_hash as String
  let stdout = concat(
    concat("Srv3InstallObserveReceipt: surface=serve nbdkit=present websocat=present port_owner=expected token=present iso=match iso_file_sha256=abc123 content_hash_observed=", hash),
    "\nSrv3InstallObserveReceipt: surface=bmc_websocket http_code=101\nSrv3InstallObserveReceipt: surface=redfish power=On boot_enabled=Disabled boot_target=None\nSrv3InstallObserveReceipt: surface=sol status=silent\nSrv3InstallObserveReceipt: surface=elapsed boot_once_ms=120000\n",
  )
  match gunbc.srv3_os_install_diagnostic.parse_srv3_install_debug_observation(
    stdout: stdout,
    intent: gunbc.srv3_os_install_diagnostic.srv3_os_install_attempt_intent,
  ).elapsed_since_boot_once_ms {
    Present { value: v } => v == 120000
    Absent => false
  }
}

test fn parse_stdout_iso_hash_mismatch_is_serve_down() -> Bool {
  let stdout = "Srv3InstallObserveReceipt: surface=serve nbdkit=present websocat=present port_owner=expected token=present iso=mismatch iso_file_sha256=abc123 content_hash_observed=stale-hash\nSrv3InstallObserveReceipt: surface=bmc_websocket http_code=101\nSrv3InstallObserveReceipt: surface=redfish power=On boot_enabled=Disabled boot_target=None\n"
  match gunbc.srv3_os_install_diagnostic.diagnose_srv3_install(
    intent: gunbc.srv3_os_install_diagnostic.srv3_os_install_attempt_intent,
    observation: gunbc.srv3_os_install_diagnostic.parse_srv3_install_debug_observation(stdout: stdout, intent: gunbc.srv3_os_install_diagnostic.srv3_os_install_attempt_intent),
  ) {
    ServeDown => true
    _ => false
  }
}

test fn parse_stdout_foreign_port_owner_is_serve_down() -> Bool {
  let hash = gunbc.srv3_seeded_install_media_artifact.srv3_seeded_install_media_content_hash as String
  let stdout = concat(
    concat("Srv3InstallObserveReceipt: surface=serve nbdkit=present websocat=present port_owner=foreign token=present iso=match iso_file_sha256=abc123 content_hash_observed=", hash),
    "\nSrv3InstallObserveReceipt: surface=bmc_websocket http_code=101\n",
  )
  match gunbc.srv3_os_install_diagnostic.diagnose_srv3_install(
    intent: gunbc.srv3_os_install_diagnostic.srv3_os_install_attempt_intent,
    observation: gunbc.srv3_os_install_diagnostic.parse_srv3_install_debug_observation(stdout: stdout, intent: gunbc.srv3_os_install_diagnostic.srv3_os_install_attempt_intent),
  ) {
    ServeDown => true
    _ => false
  }
}

test fn serve_absent_observed_is_serve_down_not_ready() -> Bool {
  let observation = gunbc.srv3_os_install_diagnostic.Srv3InstallDebugObservation {
    actuator_serve: gunbc.srv3_os_install_diagnostic.ServeObserved {
      process: gunbc.srv3_os_install_diagnostic.NbdkitAbsent,
      port: gunbc.srv3_os_install_diagnostic.ServePortAbsent,
      session: gunbc.srv3_os_install_diagnostic.TokenPresent,
      iso: gunbc.srv3_os_install_diagnostic.IsoPresent { observed_content_hash: gunbc.srv3_seeded_install_media_artifact.srv3_seeded_install_media_content_hash },
    },
    bmc_websocket: gunbc.srv3_os_install_diagnostic.WebsocketUpgradeAccepted,
    redfish_boot: gunbc.srv3_os_install_diagnostic.RedfishBootObservation {
      power_state: On,
      boot_override_enabled: BootOverrideDisabled,
      boot_override_target: BootTargetNone,
      boot_progress: gunbc.srv3_os_install_diagnostic.BootProgressNone,
    },
    virtual_media_session: gunbc.srv3_os_install_diagnostic.NoAttachedServe,
    sol: Present {
      value: gunbc.srv3_os_install_diagnostic.SolConsoleContentObservation {
        bytes_captured: std.measure.byte_size(0),
        duration_ms: 120000,
        contains_grub: false,
        contains_subiquity: false,
        contains_autoinstall: false,
        contains_firmware_menu: true,
        contains_error: false,
        capture_available: true,
      }
    },
    router_lease_table: Present { value: gunbc.network_identity_subsumption.srv3_pre_install_lease_table },
    kvm: Absent,
    elapsed_since_boot_once_ms: Present { value: 120000 },
  }
  match gunbc.srv3_os_install_diagnostic.diagnose_srv3_install(intent: gunbc.srv3_os_install_diagnostic.srv3_os_install_attempt_intent, observation: observation) {
    ServeDown =>
      !gunbc.srv3_os_install_diagnostic.srv3_install_diagnostic_is_ready_to_boot(
        verdict: gunbc.srv3_os_install_diagnostic.diagnose_srv3_install(intent: gunbc.srv3_os_install_diagnostic.srv3_os_install_attempt_intent, observation: observation),
      )
    _ => false
  }
}

test fn parse_bmc_websocket_http_code_non_101_red_despite_serve_websocat_present() -> Bool {
  let stdout = concat(
    "Srv3InstallObserveReceipt: surface=serve nbdkit=present websocat=present port_owner=expected token=absent iso=missing",
    "\nSrv3InstallObserveReceipt: surface=bmc_websocket http_code=000\n",
  )
  let observation = gunbc.srv3_os_install_diagnostic.parse_srv3_install_debug_observation(
    stdout: stdout,
    intent: gunbc.srv3_os_install_diagnostic.srv3_os_install_attempt_intent,
  )
  match observation.bmc_websocket {
    WebsocketUnavailable => true
    _ => false
  }
    && match observation.virtual_media_session {
      NoAttachedServe => true
      _ => false
    }
}

test fn checklist_entrypoint_carries_dissolution_trigger() -> Bool {
  gunbc.srv3_install_diagnostic_checklist.srv3_install_diagnostic_checklist_entrypoint_is_declared()
}
