module test.claim.gc16_fnval_probe

import gunbc.compile_diagnostic_census {
  CensusObserved,
  CensusNotRunnable,
  census_blocking_rows,
  census_total_count,
}

fn blocking_count(source: String) -> Int {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: rows } => census_total_count(rows: census_blocking_rows(rows: rows))
    CensusNotRunnable { cause: _ } => -1
  }
}

// RULING-(i) DECISION PROBE (parent msg_d6381674): does the Applied-children descent at this
// head give the type-parameter LEAF/BOUND comparison an observable consumer? f: (Box<T>) -> Bool
// from fn f<T> against g: (Box<U>) -> Bool from fn g<U> at one same_arm site: distinct binders,
// same spelling. FIRES (>=1) => #14056's leaf/binder half has a claim home here and lands with
// this executing RED. NOT FIRES (0) => no observable consumer on today's routes; #14056 closes
// and its half folds into PR-2 or drops. Recorded either way.
test fn c_fnval_refused() -> Bool {
  blocking_count(source: "module probe.fnval\ntype Box<T>\nfn same_arm<A>(a: A, b: A) -> Bool { true }\nfn f<T>(x: Box<T>) -> Bool { true }\nfn g<U>(y: Box<U>) -> Bool { true }\nfn h() -> Bool {\n  same_arm(a: f, b: g)\n}\n") >= 1
}

// CONTROL: identical fn value against itself must ACCEPT (the probe is not a blanket refusal).
test fn c_fnval_control_self_accepts() -> Bool {
  blocking_count(source: "module probe.fnvalctl\ntype Box<T>\nfn same_arm<A>(a: A, b: A) -> Bool { true }\nfn f<T>(x: Box<T>) -> Bool { true }\nfn h() -> Bool {\n  same_arm(a: f, b: f)\n}\n") == 0
}
