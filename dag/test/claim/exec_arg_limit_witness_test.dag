module test.claim.exec_arg_limit_witness

import std.types { Bool, String }
import std.measure { byte_size }
import extdeps.os.exec_arg_limit { host_exec_arg_max_strlen }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data exec_arg_limit_witness_note: String = "Single-authority pin for the host per-argument exec ceiling (Linux execve(2) MAX_ARG_STRLEN = 131072). This authority is mirrored by the Rust seed const HOST_ARG_MAX_STRLEN_BYTES in src/v1/stage0/src/v1_interpreter.rs, which realizes the argv-size wall in dispatch_shell; the mirror is pinned to the same value by v1_interpreter argv_arg_limit_test::mirror_matches_extdeps_authority. The end-to-end wet demonstration (oversized argv -> typed ArgvExceedsHostArgMax refusal; >128KB script via stdin -> runs) is exec_arg_limit_wet_test.rs."

fn witness_host_exec_arg_max_strlen_value() -> Bool {
  host_exec_arg_max_strlen == byte_size(131072)
}

test fn exec_arg_limit_witnesses() -> Bool {
  witness_host_exec_arg_max_strlen_value()
}
