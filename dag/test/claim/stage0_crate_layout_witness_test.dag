module test.claim.stage0_crate_layout_witness


test fn w_hand_maintained_stage0_filenames_include_self_emitted() -> Bool {
  if v2.compiler.self_host.frontier.compiler_frontier_emitter_produced_count() == 0 {
    true
  } else {
    generated_stage0_filenames
      |> any(f => f == "v2_compiler_use_site_verdict.rs")
      && generated_stage0_filenames
        |> any(f => f == "v2_compiler_parse_engine_hooks.rs")
      && generated_stage0_filenames
        |> any(f => f == "v2_compiler_discovery_enumeration.rs")
  }
}

test fn w_generated_stage0_filenames_match_frontier() -> Bool {
  generated_stage0_filenames.length() == v2.compiler.self_host.frontier.hand_maintained_stage0_filenames().length()
    && generated_stage0_filenames
      |> all(f => v2.compiler.self_host.frontier.hand_maintained_stage0_filenames() |> any(g => g == f))
}

test fn w_generated_stage0_dirs_match_frontier() -> Bool {
  generated_stage0_dirs.length() == v2.compiler.self_host.frontier.hand_maintained_stage0_dirs().length()
    && generated_stage0_dirs
      |> all(d => v2.compiler.self_host.frontier.hand_maintained_stage0_dirs() |> any(g => g == d))
}

test fn w_self_emitted_derived_count() -> Bool {
  v2.compiler.self_host.frontier.compiler_frontier_emitter_produced_stage0_mod_basenames().length() == v2.compiler.self_host.frontier.compiler_frontier_emitter_produced_count()
}

