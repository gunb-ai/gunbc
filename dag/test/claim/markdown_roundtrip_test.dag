module test.claim.markdown_roundtrip

data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn roundtrip_core_doc() -> std.markdown.MarkdownDocument {
  std.markdown.MarkdownDocument {
    blocks: [
      std.markdown.HeadingBlock { level: H1, inlines: [ std.markdown.TextInline { text: "Roadmap" } ] },
      std.markdown.ParagraphBlock { inlines: [ std.markdown.TextInline { text: "Status of the work." } ] },
      std.markdown.HeadingBlock { level: H2, inlines: [ std.markdown.TextInline { text: "Tasks" } ] },
      std.markdown.TaskListBlock {
        items: [
          std.markdown.MarkdownTaskItem {
            state: Checked,
            blocks: [ std.markdown.ParagraphBlock { inlines: [ std.markdown.TextInline { text: "done item" } ] } ],
          },
          std.markdown.MarkdownTaskItem {
            state: Unchecked,
            blocks: [ std.markdown.ParagraphBlock { inlines: [ std.markdown.TextInline { text: "todo item" } ] } ],
          },
        ],
      },
      std.markdown.UnorderedListBlock {
        items: [
          std.markdown.MarkdownListItem { blocks: [ std.markdown.ParagraphBlock { inlines: [ std.markdown.TextInline { text: "alpha" } ] } ] },
          std.markdown.MarkdownListItem { blocks: [ std.markdown.ParagraphBlock { inlines: [ std.markdown.TextInline { text: "beta" } ] } ] },
        ],
      },
      std.markdown.OrderedListBlock {
        items: [
          std.markdown.MarkdownListItem { blocks: [ std.markdown.ParagraphBlock { inlines: [ std.markdown.TextInline { text: "first" } ] } ] },
          std.markdown.MarkdownListItem { blocks: [ std.markdown.ParagraphBlock { inlines: [ std.markdown.TextInline { text: "second" } ] } ] },
        ],
      },
      std.markdown.CodeBlock { code: "let x = 1;\n" },
    ],
  }
}

test fn witness_roundtrip_core() -> Bool {
  ingest_markdown_source(src: serialize_markdown_source(doc: roundtrip_core_doc())) == roundtrip_core_doc()
}

fn spellings_override(bullet: String, separator: String) -> extdeps.languages.markdown.MarkdownSpellings {
  extdeps.languages.markdown.MarkdownSpellings {
    heading_marker: commonmark_gfm_spellings.heading_marker,
    heading_sep: commonmark_gfm_spellings.heading_sep,
    unordered_bullet: bullet,
    ordered_suffix: commonmark_gfm_spellings.ordered_suffix,
    task_checked: commonmark_gfm_spellings.task_checked,
    task_unchecked: commonmark_gfm_spellings.task_unchecked,
    emphasis_delim: commonmark_gfm_spellings.emphasis_delim,
    strong_delim: commonmark_gfm_spellings.strong_delim,
    code_span_delim: commonmark_gfm_spellings.code_span_delim,
    code_fence: commonmark_gfm_spellings.code_fence,
    link_text_open: commonmark_gfm_spellings.link_text_open,
    link_text_close: commonmark_gfm_spellings.link_text_close,
    link_url_open: commonmark_gfm_spellings.link_url_open,
    link_url_close: commonmark_gfm_spellings.link_url_close,
    image_marker: commonmark_gfm_spellings.image_marker,
    table_pipe: commonmark_gfm_spellings.table_pipe,
    table_cell_pad: commonmark_gfm_spellings.table_cell_pad,
    table_align_none: commonmark_gfm_spellings.table_align_none,
    table_align_left: commonmark_gfm_spellings.table_align_left,
    table_align_center: commonmark_gfm_spellings.table_align_center,
    table_align_right: commonmark_gfm_spellings.table_align_right,
    blockquote_marker: commonmark_gfm_spellings.blockquote_marker,
    list_indent: commonmark_gfm_spellings.list_indent,
    block_separator: separator,
    thematic_break: commonmark_gfm_spellings.thematic_break,
  }
}

fn perturbed_bullet_spellings() -> extdeps.languages.markdown.MarkdownSpellings {
  spellings_override(bullet: "+ ", separator: commonmark_gfm_spellings.block_separator)
}

fn perturbed_separator_spellings() -> extdeps.languages.markdown.MarkdownSpellings {
  spellings_override(bullet: commonmark_gfm_spellings.unordered_bullet, separator: "\n---\n")
}

test fn witness_roundtrip_under_perturbed_rows() -> Bool {
  let spb = perturbed_bullet_spellings()
  let restored_b = ingest_markdown_source_with(src: serialize_markdown_source_with(doc: roundtrip_core_doc(), sp: spb), sp: spb)
  let sps = perturbed_separator_spellings()
  let restored_s = ingest_markdown_source_with(src: serialize_markdown_source_with(doc: roundtrip_core_doc(), sp: sps), sp: sps)
  (restored_b == roundtrip_core_doc()) && (restored_s == roundtrip_core_doc())
}

test fn witness_ingest_reads_bullet_row() -> Bool {
  let emitted_b = serialize_markdown_source_with(doc: roundtrip_core_doc(), sp: perturbed_bullet_spellings())
  let emitted_s = serialize_markdown_source_with(doc: roundtrip_core_doc(), sp: perturbed_separator_spellings())
  !(ingest_markdown_source(src: emitted_b) == roundtrip_core_doc())
    && !(ingest_markdown_source(src: emitted_s) == roundtrip_core_doc())
}

test fn witness_core_advertised_lossless() -> Bool {
  let recovered = ingest_markdown_source(src: serialize_markdown_source(doc: roundtrip_core_doc()))
  let m = markdown_medium_lossless(doc: recovered)
  match m.fidelity {
    Lossless => m.carried == roundtrip_core_doc()
    Lossy => false
  }
}

fn inline_doc(inlines: List<std.markdown.MarkdownInline>) -> std.markdown.MarkdownDocument {
  std.markdown.MarkdownDocument { blocks: [ std.markdown.ParagraphBlock { inlines: inlines } ] }
}

fn inline_round_trips(inlines: List<std.markdown.MarkdownInline>) -> Bool {
  let doc = inline_doc(inlines: inlines)
  ingest_markdown_source(src: serialize_markdown_source(doc: doc)) == doc
}

// Was witness_frontier_not_roundtripped, which ASSERTED that emphasis does not
// survive ingest. That was true, and the reason it was true is that every ingest
// call site read md_ingest_inlines -- a stub returning one TextInline over the
// whole string -- while the module's real recursive inline parser sat beside it
// wired to nothing. The claim named the situation a frontier, so the unplugged
// parser read as an unbuilt feature for as long as the claim stayed green.
// Per DESIGN 4b an expecting-red probe that greens when the wall lands becomes a
// permanent regression control rather than retiring: it now asserts the positive.
test fn witness_emphasis_survives_the_round_trip() -> Bool {
  inline_round_trips(inlines: [
    std.markdown.TextInline { text: "see " },
    std.markdown.EmphasisInline { inlines: [ std.markdown.TextInline { text: "this" } ] },
  ])
}

test fn witness_strong_survives_the_round_trip() -> Bool {
  inline_round_trips(inlines: [
    std.markdown.TextInline { text: "a " },
    std.markdown.StrongInline { inlines: [ std.markdown.TextInline { text: "bold" } ] },
  ])
}

test fn witness_code_survives_the_round_trip() -> Bool {
  inline_round_trips(inlines: [
    std.markdown.TextInline { text: "call " },
    std.markdown.CodeInline { text: "md_parse_inline_rest" },
  ])
}

test fn witness_link_survives_the_round_trip() -> Bool {
  inline_round_trips(inlines: [
    std.markdown.TextInline { text: "read " },
    std.markdown.LinkInline { inlines: [ std.markdown.TextInline { text: "DESIGN" } ], url: "DESIGN.md" },
  ])
}

// The discriminator. A round-trip suite made only of positives cannot tell a
// working parser from one that returns its input unchanged, because a stub that
// carries the raw markup in a single TextInline reproduces the source bytes too.
// This asserts the STRUCTURE, not the bytes: the stub yields one TextInline for
// the whole string, so it fails here while still passing every claim above.
test fn witness_ingest_yields_structure_not_one_text_run() -> Bool {
  let recovered = ingest_markdown_source(src: "a **bold** word")
  recovered == inline_doc(inlines: [
    std.markdown.TextInline { text: "a " },
    std.markdown.StrongInline { inlines: [ std.markdown.TextInline { text: "bold" } ] },
    std.markdown.TextInline { text: " word" },
  ])
}
