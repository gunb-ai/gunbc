module test.claim.annotation_carrier

import std.roster_frontier { fold_frontier_expiry, frontier_expiry_clean, frontier_rows_well_formed }
import std.decl_ref { decl_ref }
import std.dissolution {
  DissolutionUnbound,
  DissolutionPending,
  DissolutionFired,
  dissolution_status,
  bound_dissolution,
  unbound_dissolution,
}
import gunbc.census_closure_frontier { census_closure_frontier_rows }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn census_closure_frontier_rows_count_is_twenty_one() -> Bool {
  length(xs: census_closure_frontier_rows()) == 21
}

test fn census_closure_frontier_rows_well_formed() -> Bool {
  frontier_rows_well_formed(rows: census_closure_frontier_rows())
}

test fn frontier_expiry_fold_partitions_unbound_and_pending() -> Bool {
  let report = fold_frontier_expiry(
    rows: census_closure_frontier_rows(),
    present_decls: [],
  )
  report.unbound_count + report.pending_count == 21
    && report.fired_still_present_count == 0
    && frontier_expiry_clean(report: report)
}

test fn frontier_expiry_fired_row_still_present_reds() -> Bool {
  let mac_trigger = decl_ref(module_path: "extdeps.network.mac", decl_name: "parse_mac_address")
  let base = fold_frontier_expiry(rows: census_closure_frontier_rows(), present_decls: [])
  let report = fold_frontier_expiry(
    rows: census_closure_frontier_rows(),
    present_decls: [mac_trigger],
  )
  report.fired_still_present_count == 1
    && report.pending_count == base.pending_count - 1
    && report.unbound_count == base.unbound_count
    && !frontier_expiry_clean(report: report)
}

test fn frontier_expiry_fired_trigger_absent_from_rows_is_clean() -> Bool {
  let absent_trigger = decl_ref(module_path: "extdeps.network.mac", decl_name: "already_deleted_frontier_unit")
  let base = fold_frontier_expiry(rows: census_closure_frontier_rows(), present_decls: [])
  let report = fold_frontier_expiry(
    rows: census_closure_frontier_rows(),
    present_decls: [absent_trigger],
  )
  report.fired_still_present_count == 0
    && report.pending_count == base.pending_count
    && report.unbound_count == base.unbound_count
    && frontier_expiry_clean(report: report)
}

data no_forge_control_note: String = "The load-bearing control, and the one that distinguishes this carrier from the representation it replaces. Under the old DissolveTrigger a prose sentence fired whenever a caller passed the same string back in a prose_fired list, so the assertion below was not merely false but unstatable — there WAS an input that made an uncheckable condition report fired, and it was the roster's ordinary calling convention. Here the input that used to do it does not exist, and present_decls cannot reach the UnboundDissolution arm at all. The three probes cover the shapes that could plausibly leak: a ref whose module and name match the description's subject, a ref naming the row's own declaration, and a saturated list. Restoring a prose arm makes this test fail, which is what keeps the deletion real rather than a rename."

test fn unbound_condition_reports_unbound_not_pending() -> Bool {
  let c = unbound_dissolution(description: "every caller migrates to partition_fold_outcome")
  match dissolution_status(condition: c, present_decls: []) {
    DissolutionUnbound => true
    DissolutionPending => false
    DissolutionFired => false
  }
}

test fn unbound_condition_cannot_be_forced_to_fire_by_any_present_decls() -> Bool {
  let c = unbound_dissolution(description: "extdeps.network.mac parse_mac_address lands")
  let probes = [
    decl_ref(module_path: "extdeps.network.mac", decl_name: "parse_mac_address"),
    decl_ref(module_path: "std.dissolution", decl_name: "unbound_dissolution"),
  ]
  fold(probes, init: true, f: fn(acc, p) {
    acc && match dissolution_status(condition: c, present_decls: [p]) {
      DissolutionUnbound => true
      DissolutionPending => false
      DissolutionFired => false
    }
  })
    && match dissolution_status(condition: c, present_decls: probes) {
      DissolutionUnbound => true
      DissolutionPending => false
      DissolutionFired => false
    }
}

test fn bound_condition_pends_until_its_declaration_appears() -> Bool {
  let target = decl_ref(module_path: "extdeps.network.mac", decl_name: "parse_mac_address")
  let c = bound_dissolution(ref: target)
  let pending = match dissolution_status(condition: c, present_decls: []) {
    DissolutionPending => true
    DissolutionUnbound => false
    DissolutionFired => false
  }
  let fired = match dissolution_status(condition: c, present_decls: [target]) {
    DissolutionFired => true
    DissolutionUnbound => false
    DissolutionPending => false
  }
  pending && fired
}

test fn bound_condition_does_not_fire_on_a_near_miss_ref() -> Bool {
  let c = bound_dissolution(
    ref: decl_ref(module_path: "extdeps.network.mac", decl_name: "parse_mac_address"),
  )
  let near_misses = [
    decl_ref(module_path: "extdeps.network.mac", decl_name: "parse_mac_addres"),
    decl_ref(module_path: "extdeps.network.max", decl_name: "parse_mac_address"),
  ]
  fold(near_misses, init: true, f: fn(acc, p) {
    acc && match dissolution_status(condition: c, present_decls: [p]) {
      DissolutionPending => true
      DissolutionUnbound => false
      DissolutionFired => false
    }
  })
}
