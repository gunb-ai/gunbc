  }
}

test fn source_path_with_test_claim_refuses() -> Bool {
  let authority = module_storage_for(artifact: source_artifact())
  let claimed = v2.std.artifact.Artifact {
    kind: v2.std.artifact.TestClaimArtifact,
    id: ^source_path_test_claim,
    file_path: "dag/gunbc/publication_grant.dag",
  }
  let observation = gunbc.commit_workflow.CompleteStagedCommitObservation {
    index: [normal_index_entry(path: publication_grant_path(), oid: blob_oid())],
    blobs: [classified_text_blob(
      path: publication_grant_path(),
      oid: blob_oid(),
      text: staged_marker_218dea6_text(),
      grammar: marker_grammar(size: 7),
      artifact: claimed,
      module_storage: authority,
    )],
    module_storage: authority,
  }
  match admit_commit_writer(writer: HumanGitCommit, observation: observation) {
    CommitWriterAdmitted { writer: _ } => false
    CommitWriterRefused { writer: _, refusals } => match first(refusals) {
      Present { value: CommitWriterArtifactUntrackedRefusal { path, artifact: _ } } =>
        path == publication_grant_path()
      _ => false
    }
  }
}

test fn mismatched_provenance_file_path_refuses() -> Bool {
  let authority = module_storage_for(artifact: source_artifact())
  let mismatched = v2.std.artifact.Artifact {
    kind: v2.std.artifact.TestClaimArtifact,
    id: ^mismatched_fixture_claim,
    file_path: "dag/test/claim/conflict_marker_fixture.dag",
  }
  let observation = gunbc.commit_workflow.CompleteStagedCommitObservation {
    index: [normal_index_entry(path: publication_grant_path(), oid: blob_oid())],
    blobs: [classified_text_blob(
      path: publication_grant_path(),
      oid: blob_oid(),
      text: staged_marker_218dea6_text(),
      grammar: marker_grammar(size: 7),
      artifact: mismatched,
      module_storage: authority,
    )],
    module_storage: authority,
  }
  match admit_commit_writer(writer: HumanGitCommit, observation: observation) {
    CommitWriterAdmitted { writer: _ } => false
    CommitWriterRefused { writer: _, refusals } => match first(refusals) {
      Present { value: CommitWriterArtifactPathMismatchRefusal { path, provenance_file_path } } =>
        (path == publication_grant_path())
          && (provenance_file_path == "dag/test/claim/conflict_marker_fixture.dag")
      _ => false
    }
  }
}

