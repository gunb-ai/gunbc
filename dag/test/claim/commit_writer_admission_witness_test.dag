module test.claim.commit_writer_admission_witness

import gunbc.commit_workflow {
  HumanGitCommit,
  DashboardAutocommit,
  HealAutocommit,
  IntegrationCommit,
  CommitWriterNormalTextObservation,
  CommitWriterNormalNonTextObservation,
  CommitWriterUnmergedObservation,
  CommitWriterPathObservation,
  CommitWriterAdmitted,
  CommitWriterRefused,
  CommitWriterUnmergedIndexRefusal,
  CommitWriterConflictMarkerTextRefusal,
  admit_commit_writer
}
import extdeps.git.object_store {
  GitPath,
  GitPathDecoded,
  GitPathDecodeRefused,
  GitTreeEntryName,
  GitTreeEntryNameOctetAfterSlash,
  GitTreeEntryNameAfterSlashValue,
  GitIndexStageNormal,
  GitIndexStageBase,
  GitIndexStageOurs,
  GitIndexStageTheirs,
  git_decode_path_octets
}
import v2.std.artifact { Artifact, SourceFile, TestClaimArtifact }

data commit_writer_admission_witness_note: String = "Executable reproduction for commit 218dea61248d. The WIP-prefixed dashboard autocommit merge wrote three literal conflict blocks into dag/gunbc/publication_grant.dag. The unmerged-index witness represents the pre-add Git population (Base/Ours/Theirs); the independent stage-0 witness carries all three blocks exactly as committed after add normalized the index. Both refuse with the GitPath and their own structural location. The clean controls cover every declared writer kind. Mutation controls prove this is the complete marker grammar rather than a raw token scan: isolated begin text and begin/end/separator order both admit, while the same complete blocks are exempt only when their staged Artifact provenance is TestClaimArtifact."

fn publication_grant_path() -> GitPath {
  match git_decode_path_octets(octets: [
    100, 97, 103, 47, 103, 117, 110, 98, 99, 47, 112, 117, 98, 108, 105, 99,
    97, 116, 105, 111, 110, 95, 103, 114, 97, 110, 116, 46, 100, 97, 103,
  ]) {
    GitPathDecoded { path } => path
    GitPathDecodeRefused { cause: _ } => GitPath {
      first: GitTreeEntryName {
        first: GitTreeEntryNameOctetAfterSlash {
          value: 120 as GitTreeEntryNameAfterSlashValue,
        },
        rest: [],
      },
      rest: [],
    }
  }
}

fn source_artifact() -> Artifact {
  Artifact {
    kind: SourceFile,
    id: ^publication_grant_source,
    file_path: "dag/gunbc/publication_grant.dag",
  }
}

fn test_artifact() -> Artifact {
  Artifact {
    kind: TestClaimArtifact,
    id: ^conflict_marker_fixture,
    file_path: "fixture supplied by typed test provenance",
  }
}

fn clean_observation() -> CommitWriterPathObservation {
  CommitWriterNormalTextObservation {
    path: publication_grant_path(),
    stage: GitIndexStageNormal,
    text: "data public_file_publish_grants: List<PublicFilePublishGrant> = []\n",
    provenance: source_artifact(),
  }
}

fn unmerged_218dea6_observation() -> CommitWriterPathObservation {
  CommitWriterUnmergedObservation {
    path: publication_grant_path(),
    stages: [GitIndexStageBase, GitIndexStageOurs, GitIndexStageTheirs],
  }
}

fn staged_marker_218dea6_text() -> String {
  "data public_file_publish_grants: List<PublicFilePublishGrant> = [\n  public_file_publish_grant(path: \"dag/extdeps/git/inspect.dag\"),\n<<<<<<< HEAD\n  public_file_publish_grant(path: \"dag/extdeps/session_dashboard.dag\"),\n=======\n  public_file_publish_grant(path: \"dag/extdeps/github/workflows.dag\"),\n>>>>>>> origin/main\n  public_file_publish_grant(path: \"dag/extdeps/vendor/alphabet.dag\"),\n  public_file_publish_grant(path: \"dag/extdeps/vendor/hubspot.dag\"),\n  public_file_publish_grant(path: \"dag/extdeps/vendor/meta_platforms.dag\"),\n  public_file_publish_grant(path: \"dag/extdeps/vendor/salesforce.dag\"),\n  public_file_publish_grant(path: \"dag/gunbc/econ/acquisition.dag\"),\n<<<<<<< HEAD\n  public_file_publish_grant(path: \"dag/gunbc/landing_workflow.dag\"),\n  public_file_publish_grant(path: \"dag/gunbc/landing_workflow_observe.dag\"),\n  public_file_publish_grant(path: \"dag/gunbc/landing_workflow_page.dag\"),\n  public_file_publish_grant(path: \"dag/gunbc/landing_workflow_runtime.dag\"),\n=======\n  public_file_publish_grant(path: \"dag/gunbc/heal_revalidation.dag\"),\n>>>>>>> origin/main\n  public_file_publish_grant(path: \"dag/gunbc/publication_cutover.dag\"),\n  public_file_publish_grant(path: \"dag/gunbc/publication_grant.dag\"),\n  public_file_publish_grant(path: \"dag/gunbc/roadmap_presentation.dag\"),\n  public_file_publish_grant(path: \"dag/gunbc/source_integration_proof_kernel.dag\"),\n  public_file_publish_grant(path: \"dag/test/claim/acquisition_mechanism_witness_test.dag\"),\n  public_file_publish_grant(path: \"dag/test/claim/advertising_interface_witness_test.dag\"),\n  public_file_publish_grant(path: \"dag/test/claim/crm_stage_vocabulary_witness_test.dag\"),\n<<<<<<< HEAD\n  public_file_publish_grant(path: \"dag/test/claim/landing_workflow_witness_test.dag\"),\n=======\n  public_file_publish_grant(path: \"dag/test/claim/heal_revalidation_integration_witness_test.dag\"),\n  public_file_publish_grant(path: \"dag/test/claim/heal_revalidation_witness_test.dag\"),\n  public_file_publish_grant(path: \"dag/test/claim/roadmap_presentation_witness_test.dag\"),\n  public_file_publish_grant(path: \"dag/test/claim/source_integration_proof_kernel_acceptance_test.dag\"),\n  public_file_publish_grant(path: \"dag/test/claim/source_integration_proof_kernel_model_witness_test.dag\"),\n>>>>>>> origin/main\n  public_file_publish_grant(path: \"dag/test/claim/tailscale_serve_status_witness_test.dag\"),\n  public_file_publish_grant(path: \"dag/test/claim/workflow_dispatch_input_witness_test.dag\"),\n]\n"
}

fn staged_marker_observation(provenance: Artifact) -> CommitWriterPathObservation {
  CommitWriterNormalTextObservation {
    path: publication_grant_path(),
    stage: GitIndexStageNormal,
    text: staged_marker_218dea6_text(),
    provenance: provenance,
  }
}

fn admission_is_clean(writer: gunbc.commit_workflow.CommitWriter) -> Bool {
  match admit_commit_writer(writer: writer, paths: [clean_observation()]) {
    CommitWriterAdmitted { writer: _ } => true
    CommitWriterRefused { writer: _, refusals: _ } => false
  }
}

test fn clean_tree_admits_every_commit_writer() -> Bool {
  admission_is_clean(writer: HumanGitCommit)
    && admission_is_clean(writer: DashboardAutocommit)
    && admission_is_clean(writer: HealAutocommit)
    && admission_is_clean(writer: IntegrationCommit)
}

test fn unmerged_index_218dea6_shape_refuses_typed_and_located() -> Bool {
  match admit_commit_writer(
    writer: HealAutocommit,
    paths: [unmerged_218dea6_observation()],
  ) {
    CommitWriterAdmitted { writer: _ } => false
    CommitWriterRefused { writer: _, refusals } =>
      (count(refusals) == 1) && match first(refusals) {
        Absent => false
        Present { value: refusal } => match refusal {
          CommitWriterUnmergedIndexRefusal { path, stages } =>
            (path == publication_grant_path())
              && (stages == [GitIndexStageBase, GitIndexStageOurs, GitIndexStageTheirs])
          CommitWriterConflictMarkerTextRefusal { location: _ } => false
        }
      }
  }
}

test fn staged_marker_text_218dea6_shape_refuses_typed_and_located() -> Bool {
  match admit_commit_writer(
    writer: HealAutocommit,
    paths: [staged_marker_observation(provenance: source_artifact())],
  ) {
    CommitWriterAdmitted { writer: _ } => false
    CommitWriterRefused { writer: _, refusals } =>
      (count(refusals) == 3) && match first(refusals) {
        Absent => false
        Present { value: refusal } => match refusal {
          CommitWriterUnmergedIndexRefusal { path: _, stages: _ } => false
          CommitWriterConflictMarkerTextRefusal { location } =>
            (location.path == publication_grant_path())
              && (location.begin_line == 3)
              && (location.separator_line == 5)
              && (location.end_line == 7)
        }
      }
  }
}

test fn both_refusal_arms_are_independent_and_accumulate() -> Bool {
  match admit_commit_writer(
    writer: IntegrationCommit,
    paths: [
      unmerged_218dea6_observation(),
      staged_marker_observation(provenance: source_artifact()),
    ],
  ) {
    CommitWriterAdmitted { writer: _ } => false
    CommitWriterRefused { writer: _, refusals } => count(refusals) == 4
  }
}

test fn isolated_marker_token_red_control_admits() -> Bool {
  let observation = CommitWriterNormalTextObservation {
    path: publication_grant_path(),
    stage: GitIndexStageNormal,
    text: "a legitimate explanation can mention <<<<<<< HEAD without carrying a separator and end",
    provenance: source_artifact(),
  }
  match admit_commit_writer(writer: HumanGitCommit, paths: [observation]) {
    CommitWriterAdmitted { writer: _ } => true
    CommitWriterRefused { writer: _, refusals: _ } => false
  }
}

test fn out_of_order_marker_red_control_admits() -> Bool {
  let observation = CommitWriterNormalTextObservation {
    path: publication_grant_path(),
    stage: GitIndexStageNormal,
    text: "<<<<<<< HEAD\nleft\n>>>>>>> origin/main\n=======\nright\n",
    provenance: source_artifact(),
  }
  match admit_commit_writer(writer: HumanGitCommit, paths: [observation]) {
    CommitWriterAdmitted { writer: _ } => true
    CommitWriterRefused { writer: _, refusals: _ } => false
  }
}

test fn typed_test_artifact_provenance_exempts_complete_fixture() -> Bool {
  match admit_commit_writer(
    writer: HumanGitCommit,
    paths: [staged_marker_observation(provenance: test_artifact())],
  ) {
    CommitWriterAdmitted { writer: _ } => true
    CommitWriterRefused { writer: _, refusals: _ } => false
  }
}

test fn non_text_normal_blob_admits_without_fabricating_text() -> Bool {
  let observation = CommitWriterNormalNonTextObservation {
    path: publication_grant_path(),
    stage: GitIndexStageNormal,
  }
  match admit_commit_writer(writer: HumanGitCommit, paths: [observation]) {
    CommitWriterAdmitted { writer: _ } => true
    CommitWriterRefused { writer: _, refusals: _ } => false
  }
}
