test fn incomplete_population_refuses_each_shape() -> Bool {
  let storage = module_storage_for(artifact: source_artifact())
  let blob = classified_text_blob(
    path: publication_grant_path(),
    oid: blob_oid(),
    text: "clean\n",
    grammar: marker_grammar(size: 7),
    artifact: source_artifact(),
    module_storage: storage,
  )
  let missing = admit_commit_writer(
    writer: HumanGitCommit,
    observation: gunbc.commit_workflow.CompleteStagedCommitObservation {
      index: [normal_index_entry(path: publication_grant_path(), oid: blob_oid())],
      blobs: [],
      module_storage: storage,
    },
  )
  let extra = admit_commit_writer(
    writer: HumanGitCommit,
    observation: gunbc.commit_workflow.CompleteStagedCommitObservation { index: [], blobs: [blob], module_storage: storage },
  )
  let duplicate_blob = admit_commit_writer(
    writer: HumanGitCommit,
    observation: gunbc.commit_workflow.CompleteStagedCommitObservation {
      index: [normal_index_entry(path: publication_grant_path(), oid: blob_oid())],
      blobs: [blob, blob],
      module_storage: storage,
    },
  )
  let duplicate_index = admit_commit_writer(
    writer: HumanGitCommit,
    observation: gunbc.commit_workflow.CompleteStagedCommitObservation {
      index: [
        normal_index_entry(path: publication_grant_path(), oid: blob_oid()),
        normal_index_entry(path: publication_grant_path(), oid: blob_oid()),
      ],
      blobs: [blob],
      module_storage: storage,
    },
  )
  match missing {
    CommitWriterRefused { writer: _, refusals: missing_refusals } => match first(missing_refusals) {
      Present { value: CommitWriterMissingBlobObservationRefusal { path: _, indexed_oid: _ } } => match extra {
        CommitWriterRefused { writer: _, refusals } => match first(refusals) {
        Present { value: CommitWriterExtraBlobObservationRefusal { path: _, indexed_oid: _ } } => match duplicate_blob {
          CommitWriterRefused { writer: _, refusals: duplicate_blob_refusals } =>
            count(filter(duplicate_blob_refusals, refusal => match refusal {
              CommitWriterDuplicateBlobObservationRefusal { path: _, count: _ } => true
              _ => false
            })) > 0 && match duplicate_index {
              CommitWriterRefused { writer: _, refusals: duplicate_index_refusals } =>
                count(filter(duplicate_index_refusals, refusal => match refusal {
                  CommitWriterDuplicateNormalIndexEntryRefusal { path: _, count: _ } => true
                  _ => false
                })) == 1
              _ => false
            }
          _ => false
        }
        _ => false
      }
      _ => false
      }
      _ => false
    }
    _ => false
  }
}

test fn identity_content_and_classification_fail_closed() -> Bool {
  let storage = module_storage_for(artifact: source_artifact())
  let good = classified_text_blob(
    path: publication_grant_path(),
    oid: blob_oid(),
    text: "clean\n",
    grammar: marker_grammar(size: 7),
    artifact: source_artifact(),
    module_storage: storage,
  )
  let identity_mismatch = admit_commit_writer(
    writer: HumanGitCommit,
    observation: gunbc.commit_workflow.CompleteStagedCommitObservation {
      index: [normal_index_entry(path: publication_grant_path(), oid: other_blob_oid())],
      blobs: [good],
      module_storage: storage,
    },
  )
  let content_mismatch = admit_commit_writer(
    writer: HumanGitCommit,
    observation: gunbc.commit_workflow.CompleteStagedCommitObservation {
      index: [normal_index_entry(path: publication_grant_path(), oid: blob_oid())],
      blobs: [gunbc.commit_workflow.CommitWriterStagedBlobObservation {
        path: good.path,
        indexed_oid: good.indexed_oid,
        content_oid: other_blob_oid(),
        classification: good.classification,
      }],
      module_storage: storage,
    },
  )
  let unavailable = admit_commit_writer(
    writer: HumanGitCommit,
    observation: gunbc.commit_workflow.CompleteStagedCommitObservation {
      index: [normal_index_entry(path: publication_grant_path(), oid: blob_oid())],
      blobs: [gunbc.commit_workflow.CommitWriterStagedBlobObservation {
        path: publication_grant_path(),
        indexed_oid: blob_oid(),
        content_oid: blob_oid(),
        classification: commit_writer_unavailable_classification_receipt(
          cause: "staged blob decode unavailable",
        ),
      }],
      module_storage: storage,
    },
  )
  match identity_mismatch {
    CommitWriterRefused { writer: _, refusals } => match first(refusals) {
      Present { value: CommitWriterIndexBlobIdentityMismatchRefusal { path: _, index_oid: _, observed_index_oid: _ } } => match content_mismatch {
        CommitWriterRefused { writer: _, refusals: content_refusals } => match first(content_refusals) {
          Present { value: CommitWriterBlobContentMismatchRefusal { path: _, indexed_oid: _, content_oid: _ } } => match unavailable {
            CommitWriterRefused { writer: _, refusals: unavailable_refusals } => match first(unavailable_refusals) {
              Present { value: CommitWriterBlobClassificationUnavailableRefusal { path: _, cause } } =>
                cause == "staged blob decode unavailable"
              _ => false
            }
            _ => false
          }
          _ => false
        }
        _ => false
      }
      _ => false
    }
    _ => false
  }
}

test fn extra_population_and_content_mismatch_refusals_accumulate() -> Bool {
  let storage = module_storage_for(artifact: source_artifact())
  let good = classified_text_blob(
    path: publication_grant_path(),
    oid: blob_oid(),
    text: "clean\n",
    grammar: marker_grammar(size: 7),
    artifact: source_artifact(),
    module_storage: storage,
  )
  let mismatched = gunbc.commit_workflow.CommitWriterStagedBlobObservation {
    path: good.path,
    indexed_oid: good.indexed_oid,
    content_oid: other_blob_oid(),
    classification: good.classification,
  }
  match admit_commit_writer(
    writer: HumanGitCommit,
    observation: gunbc.commit_workflow.CompleteStagedCommitObservation {
      index: [],
      blobs: [mismatched],
      module_storage: storage,
    },
  ) {
    CommitWriterAdmitted { writer: _, coverage: _ } => false
    CommitWriterRefused { writer: _, refusals } =>
      (count(filter(refusals, refusal => match refusal {
        CommitWriterExtraBlobObservationRefusal { path: _, indexed_oid: _ } => true
        _ => false
      })) == 1)
        && (count(filter(refusals, refusal => match refusal {
          CommitWriterBlobContentMismatchRefusal { path: _, indexed_oid: _, content_oid: _ } => true
          _ => false
        })) == 1)
  }
}
