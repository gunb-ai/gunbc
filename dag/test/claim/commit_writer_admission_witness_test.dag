module test.claim.commit_writer_admission_witness


data commit_writer_admission_witness_note: String = "Executable reproduction for commit 218dea61248d plus complete-population controls. The unmerged index carries Base/Ours/Theirs. The independent stage-0 observation carries the exact three committed marker blocks and refuses at their line locations. Every normal index entry must have exactly one observed blob, no extra or duplicate blob may appear, the index/object/content identities must agree, and decode/classification must be available. Artifact classification is projected from ModuleStorageIndex and bound to the same GitPath and indexed object; a naked or mismatched v2.std.artifact.TestClaimArtifact cannot exempt source text. Isolated and out-of-order marker tokens admit, while the effective per-path conflict-marker-size fact drives the real begin/separator/end grammar."

fn publication_grant_path() -> extdeps.git.object_store.GitPath {
  match git_decode_path_octets(octets: [
    100, 97, 103, 47, 103, 117, 110, 98, 99, 47, 112, 117, 98, 108, 105, 99,
    97, 116, 105, 111, 110, 95, 103, 114, 97, 110, 116, 46, 100, 97, 103,
  ]) {
    GitPathDecoded { path } => path
    GitPathDecodeRefused { cause: _ } => test.claim.commit_writer_admission_witness.fallback_path()
  }
}

fn fixture_path() -> extdeps.git.object_store.GitPath {
  match git_decode_path_octets(octets: [
    100, 97, 103, 47, 116, 101, 115, 116, 47, 99, 108, 97, 105, 109, 47,
    99, 111, 110, 102, 108, 105, 99, 116, 95, 109, 97, 114, 107, 101, 114,
    95, 102, 105, 120, 116, 117, 114, 101, 46, 100, 97, 103,
  ]) {
    GitPathDecoded { path } => path
    GitPathDecodeRefused { cause: _ } => test.claim.commit_writer_admission_witness.fallback_path()
  }
}

fn fallback_path() -> extdeps.git.object_store.GitPath {
  extdeps.git.object_store.GitPath {
    first: extdeps.git.object_store.GitTreeEntryName {
      first: extdeps.git.object_store.GitTreeEntryNameOctetAfterSlash {
        value: 120 as extdeps.git.object_store.GitTreeEntryNameAfterSlashValue,
      },
      rest: [],
    },
    rest: [],
  }
}

fn blob_oid() -> extdeps.git.object_store.GitObjectId {
  extdeps.git.object_store.GitSha1ObjectId { digest: std.content_hash.Sha1Digest { hex: "1111111111111111111111111111111111111111" as std.content_hash.Sha1DigestHex } }
}

fn other_blob_oid() -> extdeps.git.object_store.GitObjectId {
  extdeps.git.object_store.GitSha1ObjectId { digest: std.content_hash.Sha1Digest { hex: "2222222222222222222222222222222222222222" as std.content_hash.Sha1DigestHex } }
}

fn source_artifact() -> v2.std.artifact.Artifact {
  v2.std.artifact.Artifact {
    kind: v2.std.artifact.SourceFile,
    id: ^publication_grant_source,
    file_path: "dag/gunbc/publication_grant.dag",
  }
}

fn fixture_artifact() -> v2.std.artifact.Artifact {
  v2.std.artifact.Artifact {
    kind: v2.std.artifact.TestClaimArtifact,
    id: ^conflict_marker_fixture,
    file_path: "dag/test/claim/conflict_marker_fixture.dag",
  }
}

fn module_storage_for(artifact: v2.std.artifact.Artifact) -> List<v2.compiler.source_authority.ModuleStorageBinding> {
  [v2.compiler.source_authority.ModuleStorageBinding {
    module: [^commit_writer_fixture_module],
    provenance: v2.compiler.source_authority.ParsedFromSource {
      artifact: artifact,
      span_index: v2.std.provenance.span_index_empty(),
    },
    source_root: DagTree,
  }]
}

fn marker_grammar(size: std.integer.PositiveInt) -> extdeps.git.object_store.GitEffectiveConflictMarkerGrammar {
  extdeps.git.object_store.GitEffectiveConflictMarkerGrammar { size: size }
}

fn normal_index_entry(path: extdeps.git.object_store.GitPath, oid: extdeps.git.object_store.GitObjectId) -> extdeps.git.object_store.GitIndexEntry {
  extdeps.git.object_store.GitIndexEntry {
    path: path,
    mode: GitRegularBlobMode,
    oid: oid,
    stage: GitIndexStageNormal,
  }
}

fn staged_marker_218dea6_text() -> String {
  "data public_file_publish_grants: List<PublicFilePublishGrant> = [\n  public_file_publish_grant(path: \"dag/extdeps/git/inspect.dag\"),\n<<<<<<< HEAD\n  public_file_publish_grant(path: \"dag/extdeps/session_dashboard.dag\"),\n=======\n  public_file_publish_grant(path: \"dag/extdeps/github/workflows.dag\"),\n>>>>>>> origin/main\n  public_file_publish_grant(path: \"dag/extdeps/vendor/alphabet.dag\"),\n  public_file_publish_grant(path: \"dag/extdeps/vendor/hubspot.dag\"),\n  public_file_publish_grant(path: \"dag/extdeps/vendor/meta_platforms.dag\"),\n  public_file_publish_grant(path: \"dag/extdeps/vendor/salesforce.dag\"),\n  public_file_publish_grant(path: \"dag/gunbc/econ/acquisition.dag\"),\n<<<<<<< HEAD\n  public_file_publish_grant(path: \"dag/gunbc/landing_workflow.dag\"),\n  public_file_publish_grant(path: \"dag/gunbc/landing_workflow_observe.dag\"),\n  public_file_publish_grant(path: \"dag/gunbc/landing_workflow_page.dag\"),\n  public_file_publish_grant(path: \"dag/gunbc/landing_workflow_runtime.dag\"),\n=======\n  public_file_publish_grant(path: \"dag/gunbc/heal_revalidation.dag\"),\n>>>>>>> origin/main\n  public_file_publish_grant(path: \"dag/gunbc/publication_cutover.dag\"),\n  public_file_publish_grant(path: \"dag/gunbc/publication_grant.dag\"),\n  public_file_publish_grant(path: \"dag/gunbc/roadmap_presentation.dag\"),\n  public_file_publish_grant(path: \"dag/gunbc/source_integration_proof_kernel.dag\"),\n  public_file_publish_grant(path: \"dag/test/claim/acquisition_mechanism_witness_test.dag\"),\n  public_file_publish_grant(path: \"dag/test/claim/advertising_interface_witness_test.dag\"),\n  public_file_publish_grant(path: \"dag/test/claim/crm_stage_vocabulary_witness_test.dag\"),\n<<<<<<< HEAD\n  public_file_publish_grant(path: \"dag/test/claim/landing_workflow_witness_test.dag\"),\n=======\n  public_file_publish_grant(path: \"dag/test/claim/heal_revalidation_integration_witness_test.dag\"),\n  public_file_publish_grant(path: \"dag/test/claim/heal_revalidation_witness_test.dag\"),\n  public_file_publish_grant(path: \"dag/test/claim/roadmap_presentation_witness_test.dag\"),\n  public_file_publish_grant(path: \"dag/test/claim/source_integration_proof_kernel_acceptance_test.dag\"),\n  public_file_publish_grant(path: \"dag/test/claim/source_integration_proof_kernel_model_witness_test.dag\"),\n>>>>>>> origin/main\n  public_file_publish_grant(path: \"dag/test/claim/tailscale_serve_status_witness_test.dag\"),\n  public_file_publish_grant(path: \"dag/test/claim/workflow_dispatch_input_witness_test.dag\"),\n]\n"
}

fn classified_text_blob(
  path: extdeps.git.object_store.GitPath,
  oid: extdeps.git.object_store.GitObjectId,
  text: String,
  grammar: extdeps.git.object_store.GitEffectiveConflictMarkerGrammar,
  artifact: v2.std.artifact.Artifact,
  module_storage: List<v2.compiler.source_authority.ModuleStorageBinding>,
) -> gunbc.commit_workflow.CommitWriterStagedBlobObservation {
  let classification = match commit_writer_classify_artifact(
    module_storage: module_storage,
    path: path,
    indexed_oid: oid,
    artifact: artifact,
  ) {
    CommitWriterArtifactClassified { receipt } =>
      commit_writer_text_classification_receipt(
        text: text,
        marker_grammar: grammar,
        artifact: receipt,
      )
    CommitWriterArtifactClassificationRefused { cause } =>
      commit_writer_refused_artifact_classification_receipt(cause: cause)
  }
  gunbc.commit_workflow.CommitWriterStagedBlobObservation {
    path: path,
    indexed_oid: oid,
    content_oid: oid,
    classification: classification,
  }
}

fn source_observation(text: String) -> gunbc.commit_workflow.CompleteStagedCommitObservation {
  let storage = module_storage_for(artifact: source_artifact())
  gunbc.commit_workflow.CompleteStagedCommitObservation {
    index: [normal_index_entry(path: publication_grant_path(), oid: blob_oid())],
    blobs: [classified_text_blob(
      path: publication_grant_path(),
      oid: blob_oid(),
      text: text,
      grammar: marker_grammar(size: 7),
      artifact: source_artifact(),
      module_storage: storage,
    )],
    module_storage: storage,
  }
}

fn admission_is_clean(writer: gunbc.commit_workflow.CommitWriter) -> Bool {
  match admit_commit_writer(
    writer: writer,
    observation: source_observation(
      text: "data public_file_publish_grants: List<PublicFilePublishGrant> = []\n",
    ),
  ) {
    CommitWriterAdmitted { writer: _, coverage } =>
      (coverage.normal_index_entry_count == 1)
        && (coverage.staged_blob_observation_count == 1)
    CommitWriterRefused { writer: _, refusals: _ } => false
  }
}

test fn clean_tree_admits_every_commit_writer() -> Bool {
  admission_is_clean(writer: HumanGitCommit)
    && admission_is_clean(writer: DashboardAutocommit)
    && admission_is_clean(writer: HealAutocommit)
    && admission_is_clean(writer: IntegrationCommit)
}

test fn missing_writer_bindings_are_two_owned_triggered_work_rows() -> Bool {
  (count(commit_writer_binding_work) == 2)
    && match first(commit_writer_binding_work) {
      Present { value: first_work } =>
        (first_work.site == CommitWriterHealSkewConflictArm)
          && (first_work.writer == HealAutocommit)
          && (first_work.owner == CommitWriterHealOrchestrationLaneOwner)
          && match first_work.trigger {
            CommitWriterBindAfterDependencyLands { dependency } =>
              dependency == commit_writer_complete_staged_index_blob_observation_transport
          }
      Absent => false
    }
    && match first(commit_writer_binding_work.skip(n: 1)) {
      Present { value: second_work } =>
        (second_work.site == CommitWriterDashboardAutocommitDaemon)
          && (second_work.writer == DashboardAutocommit)
          && (second_work.owner == CommitWriterDashboardInfrastructureOperatorOwner)
          && match second_work.trigger {
            CommitWriterBindAfterDependencyLands { dependency } =>
              dependency == commit_writer_complete_staged_index_blob_observation_transport
          }
      Absent => false
    }
}

test fn unmerged_index_218dea6_shape_refuses_typed_and_located() -> Bool {
  let path = publication_grant_path()
  let observation = gunbc.commit_workflow.CompleteStagedCommitObservation {
    index: [
      extdeps.git.object_store.GitIndexEntry { path: path, mode: GitRegularBlobMode, oid: blob_oid(), stage: GitIndexStageBase },
      extdeps.git.object_store.GitIndexEntry { path: path, mode: GitRegularBlobMode, oid: blob_oid(), stage: GitIndexStageOurs },
      extdeps.git.object_store.GitIndexEntry { path: path, mode: GitRegularBlobMode, oid: other_blob_oid(), stage: GitIndexStageTheirs },
    ],
    blobs: [],
    module_storage: module_storage_for(artifact: source_artifact()),
  }
  match admit_commit_writer(writer: HealAutocommit, observation: observation) {
    CommitWriterAdmitted { writer: _ } => false
    CommitWriterRefused { writer: _, refusals } => match first(refusals) {
      Absent => false
      Present { value: refusal } => match refusal {
        CommitWriterUnmergedIndexRefusal { path: refused_path, stages } =>
          (refused_path == path)
            && (stages == [GitIndexStageBase, GitIndexStageOurs, GitIndexStageTheirs])
        _ => false
      }
    }
  }
}

test fn staged_marker_text_218dea6_shape_refuses_typed_and_located() -> Bool {
  match admit_commit_writer(
    writer: DashboardAutocommit,
    observation: source_observation(text: staged_marker_218dea6_text()),
  ) {
    CommitWriterAdmitted { writer: _ } => false
    CommitWriterRefused { writer: _, refusals } =>
      (count(refusals) == 3) && match first(refusals) {
        Absent => false
        Present { value: refusal } => match refusal {
          CommitWriterConflictMarkerTextRefusal { location } =>
            (location.path == publication_grant_path())
              && (location.begin_line == 3)
              && (location.separator_line == 5)
              && (location.end_line == 7)
          _ => false
        }
      }
  }
}

test fn isolated_and_out_of_order_marker_controls_admit() -> Bool {
  match admit_commit_writer(
    writer: HumanGitCommit,
    observation: source_observation(
      text: "mention <<<<<<< HEAD without a separator and end\n",
    ),
  ) {
    CommitWriterRefused { writer: _, refusals: _ } => false
    CommitWriterAdmitted { writer: _ } => match admit_commit_writer(
      writer: HumanGitCommit,
      observation: source_observation(
        text: "<<<<<<< HEAD\nleft\n>>>>>>> origin/main\n=======\nright\n",
      ),
    ) {
      CommitWriterAdmitted { writer: _ } => true
      CommitWriterRefused { writer: _, refusals: _ } => false
    }
  }
}

test fn non_default_git_conflict_marker_size_refuses() -> Bool {
  let storage = module_storage_for(artifact: source_artifact())
  let observation = gunbc.commit_workflow.CompleteStagedCommitObservation {
    index: [normal_index_entry(path: publication_grant_path(), oid: blob_oid())],
    blobs: [classified_text_blob(
      path: publication_grant_path(),
      oid: blob_oid(),
      text: "<<<<<<<<< HEAD\nleft\n=========\nright\n>>>>>>>>> origin/main\n",
      grammar: marker_grammar(size: 9),
      artifact: source_artifact(),
      module_storage: storage,
    )],
    module_storage: storage,
  }
  match admit_commit_writer(writer: HumanGitCommit, observation: observation) {
    CommitWriterAdmitted { writer: _ } => false
    CommitWriterRefused { writer: _, refusals } => count(refusals) == 1
  }
}

