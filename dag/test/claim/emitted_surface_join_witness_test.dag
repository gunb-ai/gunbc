module test.claim.emitted_surface_join_witness

data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

// WITNESSES FOR THE BUILD THAT TURNS EMITTED MANIFESTS INTO A CENSUS.
//
// These are authored rows, not a live emission, for the reason the census's own witnesses give: the
// live specimen is expected to reach zero once the emitter fabrication is repaired, and a wall whose
// RED can only come from a live violation becomes a decoration that day. The fixture reproduces the
// live specimen's SHAPE -- one module, two entries, reexport rows differing by exactly one member,
// declaration rows identical -- so the discrimination survives the repair.

fn surface(source_module: String, reexports: List<String>, declarations: List<String>) -> gunbc.stage0_emitted_export_surface_observation.EmittedModuleExportSurface {
  gunbc.stage0_emitted_export_surface_observation.EmittedModuleExportSurface {
    source_module: source_module,
    target_filename: "v2_std_node",
    reexports: reexports,
    declarations: declarations
  }
}

// The live specimen at fixture grain: A carries the fabricated Cardinality, B does not, and the
// declaration rows are identical on both sides so the reexport difference is attributable.
fn entry_with_cardinality() -> v2.compiler.self_host.emitted_surface_join.EntryObservation {
  v2.compiler.self_host.emitted_surface_join.EntryObservation {
    entry: "dag/gunbc/native_scm_interaction_contract.dag",
    observation: gunbc.stage0_emitted_export_surface_observation.ExportSurfaceObserved {
      modules: [
        surface(source_module: "v2.std.node", reexports: ["Cardinality", "ContentHash"], declarations: ["Node", "Edge"])
      ]
    }
  }
}

fn entry_without_cardinality() -> v2.compiler.self_host.emitted_surface_join.EntryObservation {
  v2.compiler.self_host.emitted_surface_join.EntryObservation {
    entry: "src/v2/std/node.dag",
    observation: gunbc.stage0_emitted_export_surface_observation.ExportSurfaceObserved {
      modules: [
        surface(source_module: "v2.std.node", reexports: ["ContentHash"], declarations: ["Node", "Edge"])
      ]
    }
  }
}

fn entry_agreeing() -> v2.compiler.self_host.emitted_surface_join.EntryObservation {
  v2.compiler.self_host.emitted_surface_join.EntryObservation {
    entry: "src/v2/std/node.dag",
    observation: gunbc.stage0_emitted_export_surface_observation.ExportSurfaceObserved {
      modules: [
        surface(source_module: "v2.std.node", reexports: ["Cardinality", "ContentHash"], declarations: ["Node", "Edge"])
      ]
    }
  }
}

fn entry_unreadable() -> v2.compiler.self_host.emitted_surface_join.EntryObservation {
  v2.compiler.self_host.emitted_surface_join.EntryObservation {
    entry: "src/v2/std/node.dag",
    observation: gunbc.stage0_emitted_export_surface_observation.ExportSurfaceUnobserved {
      detail: "the content carried no declared export-surface rows"
    }
  }
}

fn build(observations: List<v2.compiler.self_host.emitted_surface_join.EntryObservation>) -> v2.compiler.self_host.emitted_surface_join.CensusBuild {
  v2.compiler.self_host.emitted_surface_join.census_from_entry_observations(observations: observations, vintage: "fixture-vintage")
}

// THE DISCRIMINATING RED FOR THE BUILD ITSELF. An entry whose manifest could not be read must refuse
// the whole build. If it contributed zero rows instead, the module it should have covered would be
// observed under one entry, would have nothing to disagree with, and would be ADMITTED as clean --
// a failed read rendering as agreement.

// A PRESENT MODULE WITH AN EMPTY LINKAGE SURFACE. Presence is now explicit in the module envelope;
// no consumer must infer it from declaration rows.
fn entry_declarations_only(entry: String) -> v2.compiler.self_host.emitted_surface_join.EntryObservation {
  v2.compiler.self_host.emitted_surface_join.EntryObservation {
    entry: entry,
    observation: gunbc.stage0_emitted_export_surface_observation.ExportSurfaceObserved {
      modules: [
        surface(source_module: "v2.std.node", reexports: [], declarations: ["Node", "Edge"])
      ]
    }
  }
}


// TWO MODULES UNDER ONE ENTRY: one that the other entry also emits, and one it does not.
//
// v2.std.only_here stands for the ordinary case -- 29 of the 37 modules on the declared frame are
// emitted under exactly one of the two entries, because the entries have different closures.
fn entry_with_entry_specific_module() -> v2.compiler.self_host.emitted_surface_join.EntryObservation {
  v2.compiler.self_host.emitted_surface_join.EntryObservation {
    entry: "a.dag",
    observation: gunbc.stage0_emitted_export_surface_observation.ExportSurfaceObserved {
      modules: [
        surface(source_module: "v2.std.node", reexports: ["ContentHash"], declarations: ["Node", "Edge"]),
        surface(source_module: "v2.std.only_here", reexports: ["Elsewhere"], declarations: ["OnlyHere"])
      ]
    }
  }
}

fn entry_sharing_one_module() -> v2.compiler.self_host.emitted_surface_join.EntryObservation {
  v2.compiler.self_host.emitted_surface_join.EntryObservation {
    entry: "b.dag",
    observation: gunbc.stage0_emitted_export_surface_observation.ExportSurfaceObserved {
      modules: [
        surface(source_module: "v2.std.node", reexports: ["ContentHash"], declarations: ["Node", "Edge"])
      ]
    }
  }
}

test fn witness_unreadable_entry_refuses_the_build() -> Bool {
  match build(observations: [entry_with_cardinality(), entry_unreadable()]) {
    v2.compiler.self_host.emitted_surface_join.CensusNotBuilt { detail: _ } => true
    v2.compiler.self_host.emitted_surface_join.CensusBuilt { census: _ } => false
  }
}

// The positive control beside it: the same two-entry shape with BOTH manifests readable builds.
test fn witness_readable_entries_build() -> Bool {
  match build(observations: [entry_with_cardinality(), entry_without_cardinality()]) {
    v2.compiler.self_host.emitted_surface_join.CensusBuilt { census: _ } => true
    v2.compiler.self_host.emitted_surface_join.CensusNotBuilt { detail: _ } => false
  }
}

// THE LIVE SPECIMEN, REPRODUCED END TO END: build a census from two manifests that differ by exactly
// one reexported member, and the census must REFUSE it.
test fn witness_divergent_surfaces_are_refused_after_join() -> Bool {
  match build(observations: [entry_with_cardinality(), entry_without_cardinality()]) {
    v2.compiler.self_host.emitted_surface_join.CensusNotBuilt { detail: _ } => false
    v2.compiler.self_host.emitted_surface_join.CensusBuilt { census: census } =>
      match v2.compiler.self_host.emitted_surface_census.canonical_seed_admission(census: census) {
        v2.std.diagnostic.Rejected { diagnostics: _ } => true
        v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => false
      }
  }
}

// THE GREEN CONTROL THAT MAKES THE RED MEAN SOMETHING: identical inputs except that the second
// entry's reexport row agrees, and the same pipeline ADMITS. Without this the refusal above could
// be produced by any defect in the join rather than by the surface difference.
test fn witness_agreed_surfaces_are_admitted_after_join() -> Bool {
  match build(observations: [entry_with_cardinality(), entry_agreeing()]) {
    v2.compiler.self_host.emitted_surface_join.CensusNotBuilt { detail: _ } => false
    v2.compiler.self_host.emitted_surface_join.CensusBuilt { census: census } =>
      match v2.compiler.self_host.emitted_surface_census.canonical_seed_admission(census: census) {
        v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => true
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
  }
}

// THE DENOMINATOR WITNESS, AND IT ASSERTS A POPULATION RATHER THAN A VERDICT ON PURPOSE.
//
// A module reexporting nothing under either entry is not a violation -- an empty surface agrees with
// an empty surface, so ADMITTING is the correct answer and it was the answer before this fix too.
// What was wrong was the SCOPE of that admission: the module was never censused, so "no module
// carries more than one linkage surface" ranged over reexport-bearing modules while reading as though
// it ranged over all of them. No verdict flips here, which is exactly why the assertion is on the
// census's row population and not on Accepted/Rejected -- a witness watching the verdict would have
// stayed green through the defect and through its repair alike.
//
// RED BEFORE THE FIX: discovery folded reexport rows only, so this census had ZERO rows.
test fn witness_declaration_only_module_enters_the_census() -> Bool {
  match build(observations: [entry_declarations_only(entry: "a.dag"), entry_declarations_only(entry: "b.dag")]) {
    v2.compiler.self_host.emitted_surface_join.CensusNotBuilt { detail: _ } => false
    v2.compiler.self_host.emitted_surface_join.CensusBuilt { census: census } =>
      v2.std.algebra.length(xs: census.rows) == 1
  }
}

// The verdict beside the population, stated separately because they are different claims: a module
// with an empty surface under every entry is ADMITTED. Together with the row count above, this says
// the module is now judged and found clean, rather than never judged.
test fn witness_declaration_only_module_is_admitted() -> Bool {
  match build(observations: [entry_declarations_only(entry: "a.dag"), entry_declarations_only(entry: "b.dag")]) {
    v2.compiler.self_host.emitted_surface_join.CensusNotBuilt { detail: _ } => false
    v2.compiler.self_host.emitted_surface_join.CensusBuilt { census: census } =>
      match v2.compiler.self_host.emitted_surface_census.canonical_seed_admission(census: census) {
        v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => true
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
  }
}

// AN EMPTY SURFACE AGAINST A NON-EMPTY ONE IS REFUSED. This one refused before the fix as well, by a
// different route -- the module was discovered from the reexport-bearing entry and then failed the
// coverage check because the other entry produced no observation. It is kept because the ROUTE is now
// the variance check over a genuinely empty surface, and a witness that only covered the old route
// would go quiet the moment the new one took over.
test fn witness_empty_surface_against_nonempty_is_refused() -> Bool {
  match build(observations: [entry_with_cardinality(), entry_declarations_only(entry: "src/v2/std/node.dag")]) {
    v2.compiler.self_host.emitted_surface_join.CensusNotBuilt { detail: _ } => false
    v2.compiler.self_host.emitted_surface_join.CensusBuilt { census: census } =>
      match v2.compiler.self_host.emitted_surface_census.canonical_seed_admission(census: census) {
        v2.std.diagnostic.Rejected { diagnostics: _ } => true
        v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => false
      }
  }
}

// A MODULE EMITTED UNDER ONLY ONE ENTRY IS NOT A COMPARISON SUBJECT, AND MUST NOT BECOME A REFUSAL.
//
// RED BEFORE THE FIX, ON BOTH ASSERTIONS: the build made a row for every module across all entries,
// so this census carried 2 rows and the admission REJECTED -- the entry-specific module was not
// observed under every entry and tripped the coverage refusal. Every real frame refused that way
// before ever comparing a linkage surface, which is what made the live specimen unreachable here.
//
// The row count is asserted alongside the verdict because they fail independently: filtering the
// population without fixing the verdict, or vice versa, would leave one of them red.
test fn witness_entry_specific_module_is_excluded_from_the_comparison() -> Bool {
  match build(observations: [entry_with_entry_specific_module(), entry_sharing_one_module()]) {
    v2.compiler.self_host.emitted_surface_join.CensusNotBuilt { detail: _ } => false
    v2.compiler.self_host.emitted_surface_join.CensusBuilt { census: census } =>
      v2.std.algebra.length(xs: census.rows) == 1
  }
}

test fn witness_entry_specific_module_does_not_cause_a_refusal() -> Bool {
  match build(observations: [entry_with_entry_specific_module(), entry_sharing_one_module()]) {
    v2.compiler.self_host.emitted_surface_join.CensusNotBuilt { detail: _ } => false
    v2.compiler.self_host.emitted_surface_join.CensusBuilt { census: census } =>
      match v2.compiler.self_host.emitted_surface_census.canonical_seed_admission(census: census) {
        v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => true
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
  }
}

test fn emitted_surface_join_witnesses() -> Bool {
  witness_unreadable_entry_refuses_the_build()
    && witness_readable_entries_build()
    && witness_divergent_surfaces_are_refused_after_join()
    && witness_agreed_surfaces_are_admitted_after_join()
    && witness_declaration_only_module_enters_the_census()
    && witness_declaration_only_module_is_admitted()
    && witness_empty_surface_against_nonempty_is_refused()
    && witness_entry_specific_module_is_excluded_from_the_comparison()
    && witness_entry_specific_module_does_not_cause_a_refusal()
}
