module test.claim.vscode_dag_syntax_emit_witness

import std.types { Bool, String, List }
import std.algebra { fold_list, list_starts_with, skip }
import std.coercion { unicode_scalar_unfold, unicode_scalar_fold }
import v2.std.text { char_eq }
import v2.extdeps.languages.dag { dag_lex_rules }

import extdeps.languages.json.emit {
    JsonArray,
    JsonString,
    JsonValue
    json_array,
    json_kv,
    json_object
}

import v2.std.compilers.lexing {
    LiteralPattern,
    KeywordPattern,
    SequencePattern,
    RepeatPattern,
    CharClassPattern,
    DigitChar,
    TokenRule,
    lex_rule_set_matching_rules
}

import extdeps.languages.json.parse {
    parse_json_document,
    JsonDocumentParsed,
    JsonDocumentUnreadable,
    json_object_unique_member,
    JsonMemberFound,
    JsonMemberAbsent,
    JsonMemberDuplicated,
    JsonMemberNotAnObject
}

import gunbc.vscode_dag_syntax_emit {
    lex_pattern_textmate_regex,
    dag_keyword_textmate_pattern,
    expected_vscode_dag_tm_language_json
}

type KeywordSearchState {
    rest: v2.std.text.String
    found: Bool
}

fn grammar_has_required_textmate_fields(document: JsonValue) -> Bool {
    match json_object_unique_member(v: document, key: "scopeName") {
        JsonMemberFound { value: JsonString { value: scope } } =>
            (scope == "source.dag")
            && (match json_object_unique_member(v: document, key: "patterns") {
                JsonMemberFound { value: JsonArray { elements: _ } } => true
                JsonMemberFound { value: _ } => false
                JsonMemberAbsent => false
                JsonMemberDuplicated { count: _ } => false
                JsonMemberNotAnObject => false
            })
        JsonMemberFound { value: _ } => false
        JsonMemberAbsent => false
        JsonMemberDuplicated { count: _ } => false
        JsonMemberNotAnObject => false
    }
}

fn grammar_has_emitted_keyword_pattern(document: JsonValue) -> Bool {
    match json_object_unique_member(v: document, key: "repository") {
        JsonMemberFound { value: repository } =>
            match json_object_unique_member(v: repository, key: "keywords") {
                JsonMemberFound { value: keywords } =>
                    match json_object_unique_member(v: keywords, key: "patterns") {
                        JsonMemberFound {
                            value: JsonArray { elements }
                        } =>
                            any(elements, pattern =>
                                match json_object_unique_member(
                                    v: pattern,
                                    key: "match"
                                ) {
                                    JsonMemberFound {
                                        value: JsonString { value: pattern }
                                    } =>
                                        pattern == dag_keyword_textmate_pattern()
                                    JsonMemberFound { value: _ } => false
                                    JsonMemberAbsent => false
                                    JsonMemberDuplicated { count: _ } => false
                                    JsonMemberNotAnObject => false
                                }
                            )
                        JsonMemberFound { value: _ } => false
                        JsonMemberAbsent => false
                        JsonMemberDuplicated { count: _ } => false
                        JsonMemberNotAnObject => false
                    }
                JsonMemberFound { value: _ } => false
                JsonMemberAbsent => false
                JsonMemberDuplicated { count: _ } => false
                JsonMemberNotAnObject => false
            }
        JsonMemberFound { value: _ } => false
        JsonMemberAbsent => false
        JsonMemberDuplicated { count: _ } => false
        JsonMemberNotAnObject => false
    }
}

fn keyword_regex_contains(text: String, fragment: String) -> Bool {
    let source = unicode_scalar_unfold(s: text)
    let needle = unicode_scalar_unfold(s: fragment)
    let result = fold_list(
        xs: source,
        empty: KeywordSearchState { rest: source, found: false },
        cons: fn(state, _) {
            KeywordSearchState {
                rest: skip(xs: state.rest, n: 1),
                found: state.found || list_starts_with(
                    xs: state.rest,
                    prefix: needle,
                    eq: char_eq
                )
            }
        }
    )
    result.found
}

fn grammar_group_has_keyword(
    repository: JsonValue,
    group: String,
    keyword: String
) -> Bool {
    match json_object_unique_member(v: repository, key: group) {
        JsonMemberFound { value: entry } =>
            match json_object_unique_member(v: entry, key: "patterns") {
                JsonMemberFound { value: JsonArray { elements } } =>
                    any(elements, rule =>
                        match json_object_unique_member(v: rule, key: "match") {
                            JsonMemberFound {
                                value: JsonString { value: regex }
                            } =>
                                keyword_regex_contains(
                                    text: regex,
                                    fragment: concat(
                                        "(?:",
                                        concat(keyword, "(?![A-Za-z0-9_])")
                                    )
                                )
                                || keyword_regex_contains(
                                    text: regex,
                                    fragment: concat(
                                        "|",
                                        concat(keyword, "(?![A-Za-z0-9_])")
                                    )
                                )
                            _ => false
                        }
                    )
                _ => false
            }
        _ => false
    }
}

fn grammar_covers_lexer_keywords(document: JsonValue) -> Bool {
    let rules = lex_rule_set_matching_rules(rules: dag_lex_rules())
    match json_object_unique_member(v: document, key: "repository") {
        JsonMemberFound { value: repository } =>
            any(rules, rule =>
                match rule {
                    TokenRule {
                        token_class: _,
                        pattern: KeywordPattern { text: _ }
                    } => true
                    _ => false
                }
            )
            && fold_list(
                xs: rules,
                empty: true,
                cons: fn(covered, rule) {
                    covered && (match rule {
                        TokenRule {
                            token_class: _,
                            pattern: KeywordPattern { text }
                        } =>
                            let keyword = unicode_scalar_fold(xs: text)
                            grammar_group_has_keyword(
                                repository: repository,
                                group: "keywords",
                                keyword: keyword
                            )
                            || grammar_group_has_keyword(
                                repository: repository,
                                group: "constants",
                                keyword: keyword
                            )
                        _ => true
                    })
                }
            )
        _ => false
    }
}

fn grammar_group_has_matches(
    document: JsonValue,
    group: String,
    scope: String,
    expected: List<String>
) -> Bool {
    match json_object_unique_member(v: document, key: "repository") {
        JsonMemberFound { value: repository } =>
            match json_object_unique_member(v: repository, key: group) {
                JsonMemberFound { value: entry } =>
                    match json_object_unique_member(v: entry, key: "patterns") {
                        JsonMemberFound { value: JsonArray { elements } } =>
                            map(elements, rule =>
                                match json_object_unique_member(
                                    v: rule,
                                    key: "name"
                                ) {
                                    JsonMemberFound {
                                        value: JsonString { value: name }
                                    } =>
                                        if name == scope {
                                            match json_object_unique_member(
                                                v: rule,
                                                key: "match"
                                            ) {
                                                JsonMemberFound {
                                                    value: JsonString {
                                                        value: regex
                                                    }
                                                } => regex
                                                _ => ""
                                            }
                                        } else {
                                            ""
                                        }
                                    _ => ""
                                }
                            ) == expected
                        _ => false
                    }
                _ => false
            }
        _ => false
    }
}

fn grammar_string_field_is(
    object: JsonValue,
    key: String,
    expected: String
) -> Bool {
    match json_object_unique_member(v: object, key: key) {
        JsonMemberFound { value: JsonString { value } } =>
            value == expected
        _ => false
    }
}

fn grammar_has_string_region(document: JsonValue) -> Bool {
    match json_object_unique_member(v: document, key: "repository") {
        JsonMemberFound { value: repository } =>
            match json_object_unique_member(v: repository, key: "strings") {
                JsonMemberFound { value: strings } =>
                    match json_object_unique_member(v: strings, key: "patterns") {
                        JsonMemberFound { value: JsonArray { elements } } =>
                            any(elements, rule =>
                                grammar_string_field_is(
                                    object: rule,
                                    key: "name",
                                    expected: "string.quoted.double.dag"
                                )
                                && grammar_string_field_is(
                                    object: rule,
                                    key: "begin",
                                    expected: "\""
                                )
                                && grammar_string_field_is(
                                    object: rule,
                                    key: "end",
                                    expected: "\""
                                )
                                && (match json_object_unique_member(
                                    v: rule,
                                    key: "patterns"
                                ) {
                                    JsonMemberFound {
                                        value: JsonArray { elements: nested }
                                    } =>
                                        any(nested, escape =>
                                            grammar_string_field_is(
                                                object: escape,
                                                key: "name",
                                                expected: "constant.character.escape.dag"
                                            )
                                            && (match json_object_unique_member(
                                                v: escape,
                                                key: "match"
                                            ) {
                                                JsonMemberFound {
                                                    value: JsonString {
                                                        value: regex
                                                    }
                                                } => regex != ""
                                                _ => false
                                            })
                                        )
                                    _ => false
                                })
                            )
                        _ => false
                    }
                _ => false
            }
        _ => false
    }
}

fn grammar_rule_includes(rule: JsonValue, reference: String) -> Bool {
    match json_object_unique_member(v: rule, key: "patterns") {
        JsonMemberFound { value: JsonArray { elements } } =>
            any(elements, entry =>
                grammar_string_field_is(
                    object: entry,
                    key: "include",
                    expected: reference
                )
            )
        _ => false
    }
}

fn grammar_has_code_region(
    document: JsonValue,
    group: String,
    scope: String,
    open: String,
    close: String
) -> Bool {
    match json_object_unique_member(v: document, key: "repository") {
        JsonMemberFound { value: repository } =>
            match json_object_unique_member(v: repository, key: group) {
                JsonMemberFound { value: entry } =>
                    match json_object_unique_member(v: entry, key: "patterns") {
                        JsonMemberFound { value: JsonArray { elements } } =>
                            any(elements, rule =>
                                grammar_string_field_is(
                                    object: rule,
                                    key: "name",
                                    expected: scope
                                )
                                && grammar_string_field_is(
                                    object: rule,
                                    key: "contentName",
                                    expected: "source.dag"
                                )
                                && grammar_string_field_is(
                                    object: rule,
                                    key: "begin",
                                    expected: open
                                )
                                && grammar_string_field_is(
                                    object: rule,
                                    key: "end",
                                    expected: close
                                )
                                && grammar_rule_includes(
                                    rule: rule,
                                    reference: "#interpolation-braces"
                                )
                                && grammar_rule_includes(
                                    rule: rule,
                                    reference: "$self"
                                )
                            )
                        _ => false
                    }
                _ => false
            }
        _ => false
    }
}

fn grammar_strings_include_interpolation(document: JsonValue) -> Bool {
    match json_object_unique_member(v: document, key: "repository") {
        JsonMemberFound { value: repository } =>
            match json_object_unique_member(v: repository, key: "strings") {
                JsonMemberFound { value: strings } =>
                    match json_object_unique_member(v: strings, key: "patterns") {
                        JsonMemberFound { value: JsonArray { elements } } =>
                            any(elements, rule =>
                                grammar_string_field_is(
                                    object: rule,
                                    key: "name",
                                    expected: "string.quoted.double.dag"
                                )
                                && grammar_rule_includes(
                                    rule: rule,
                                    reference: "#interpolation"
                                )
                            )
                        _ => false
                    }
                _ => false
            }
        _ => false
    }
}

test fn emitted_textmate_grammar_is_parseable_and_has_required_fields() -> Bool {
    match parse_json_document(s: expected_vscode_dag_tm_language_json()) {
        JsonDocumentParsed { value } =>
            grammar_has_required_textmate_fields(document: value)
            && grammar_has_emitted_keyword_pattern(document: value)
        JsonDocumentUnreadable { gap: _ } => false
    }
}

test fn grammar_missing_scope_name_is_refused() -> Bool {
    !grammar_has_required_textmate_fields(document: json_object(members: [
        json_kv(
            key: "patterns",
            value: json_array(elements: [])
        )
    ]))
}

test fn textmate_json_parses() -> Bool {
    match parse_json_document(s: expected_vscode_dag_tm_language_json()) {
        JsonDocumentParsed { value: _ } => true
        JsonDocumentUnreadable { gap: _ } => false
    }
}

test fn textmate_json_has_required_fields() -> Bool {
    match parse_json_document(s: expected_vscode_dag_tm_language_json()) {
        JsonDocumentParsed { value } =>
            grammar_has_required_textmate_fields(document: value)
        JsonDocumentUnreadable { gap: _ } => false
    }
}

test fn textmate_converter_escapes_literal_punctuation() -> Bool {
    lex_pattern_textmate_regex(
        pattern: LiteralPattern { text: "a+b.c" }
    ) == "a\\+b\\.c"
}

test fn textmate_converter_preserves_keyword_boundary() -> Bool {
    lex_pattern_textmate_regex(
        pattern: KeywordPattern { text: "if" }
    ) == "if(?![A-Za-z0-9_])"
}

test fn textmate_converter_groups_repetition() -> Bool {
    lex_pattern_textmate_regex(
        pattern: RepeatPattern {
            element: SequencePattern {
                left: LiteralPattern { text: "a" },
                right: CharClassPattern { class: DigitChar }
            }
        }
    ) == "(?:a[0-9])*+"
}

test fn emitted_grammar_covers_every_lexer_keyword() -> Bool {
    match parse_json_document(s: expected_vscode_dag_tm_language_json()) {
        JsonDocumentParsed { value } =>
            grammar_covers_lexer_keywords(document: value)
        JsonDocumentUnreadable { gap: _ } => false
    }
}

test fn emitted_grammar_has_lexer_comment_rule() -> Bool {
    match parse_json_document(s: expected_vscode_dag_tm_language_json()) {
        JsonDocumentParsed { value } =>
            grammar_group_has_matches(
                document: value,
                group: "comments",
                scope: "comment.line.double-slash.dag",
                expected: ["//(?:[^\\n])*+"]
            )
        JsonDocumentUnreadable { gap: _ } => false
    }
}

test fn emitted_grammar_has_float_before_integer() -> Bool {
    match parse_json_document(s: expected_vscode_dag_tm_language_json()) {
        JsonDocumentParsed { value } =>
            grammar_group_has_matches(
                document: value,
                group: "numbers",
                scope: "constant.numeric.dag",
                expected: [
                    "(?:[0-9])++\\.(?:[0-9])++",
                    "(?:[0-9])++"
                ]
            )
        JsonDocumentUnreadable { gap: _ } => false
    }
}

test fn emitted_grammar_includes_string_region_and_escapes() -> Bool {
    match parse_json_document(s: expected_vscode_dag_tm_language_json()) {
        JsonDocumentParsed { value } =>
            grammar_has_string_region(document: value)
            && (match json_object_unique_member(v: value, key: "patterns") {
                JsonMemberFound { value: JsonArray { elements } } =>
                    any(elements, include =>
                        grammar_string_field_is(
                            object: include,
                            key: "include",
                            expected: "#strings"
                        )
                    )
                _ => false
            })
        JsonDocumentUnreadable { gap: _ } => false
    }
}

test fn emitted_grammar_has_interpolation_region() -> Bool {
    match parse_json_document(s: expected_vscode_dag_tm_language_json()) {
        JsonDocumentParsed { value } =>
            grammar_strings_include_interpolation(document: value)
            && grammar_has_code_region(
                document: value,
                group: "interpolation",
                scope: "meta.interpolation.dag",
                open: "\\\{(?!(?!(?>[A-Za-z_]|(?>\\(|(?>!|-)))))",
                close: "\\}"
            )
        JsonDocumentUnreadable { gap: _ } => false
    }
}

test fn emitted_grammar_has_recursive_interpolation_braces() -> Bool {
    match parse_json_document(s: expected_vscode_dag_tm_language_json()) {
        JsonDocumentParsed { value } =>
            grammar_has_code_region(
                document: value,
                group: "interpolation-braces",
                scope: "meta.braces.dag",
                open: "\\{",
                close: "\\}"
            )
        JsonDocumentUnreadable { gap: _ } => false
    }
}