data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn nid(s: String) -> RoadmapNodeId { s }

fn sized_derivable(id: String, prs: List<Int>, title: String) -> RoadmapNode {
  RoadmapNode {
    node: nid(s: id),
    line: DerivableLine { prs: prs, title: title, description: "" },
    carriers: [],
    sizing: Sized { intricacy: IntricacyHigh, volume: VolumeMedium, repo: "gunbc", acceptance: PrsMerged },
    owner: "",
    signoff: Unsigned,
  }
}

fn fixture_section(nodes: List<RoadmapNode>, edges: List<RoadmapEdge>) -> RoadmapSection {
  RoadmapSection {
    title: "Test",
    elements: [Group { group: SectionGroup { label: "test", nodes: nodes, edges: edges } }],
  }
}

fn fixture_doc(nodes: List<RoadmapNode>, edges: List<RoadmapEdge>) -> RoadmapDocument {
  RoadmapDocument {
    preamble: [],
    lead_lanes: [],
    sections: [fixture_section(nodes: nodes, edges: edges)],
  }
}

test fn witness_tmux_session_name_prefix() -> Bool {
  dispatch_tmux_session_name(node_id: nid(s: "node-1")) == "gunbc-dispatch-node-1"
}

test fn witness_brief_fill_includes_node_metadata() -> Bool {
  let node = sized_derivable(id: "brief-node", prs: [1], title: "Brief Title")
  let brief = fill_dispatch_brief(
    template: dispatch_brief_template,
    fields: dispatch_brief_fields(node: node),
  )
  string_contains(s: brief, pattern: "Node: brief-node")
    && string_contains(s: brief, pattern: "Brief Title")
}

test fn witness_claude_effort_high_for_high_intricacy() -> Bool {
  claude_effort_for_intricacy(i: IntricacyHigh) == "high"
    && dispatch_reasoning_effort_for_intricacy(i: IntricacyHigh) == "high"
}

test fn witness_claude_argv_uses_dangerous_skip_permissions() -> Bool {
  let argv = claude_spawn_argv(
    effort: "high",
    session_uuid: "uuid-1",
    node_id: nid(s: "node-1"),
    brief: "brief body",
  )
  string_contains(s: join(argv, separator: "\0"), pattern: "--dangerously-skip-permissions")
    && string_contains(s: join(argv, separator: "\0"), pattern: "skipDangerousModePermissionPrompt")
    && string_contains(s: join(argv, separator: "\0"), pattern: "--session-id")
    && !string_contains(s: join(argv, separator: "\0"), pattern: "--resume")
}

test fn witness_git_worktree_argv_is_execfile_safe() -> Bool {
  let cmd = git_worktree_add_argv(
    worktree_path: "/opt/gunbc/dispatch-worktrees/node-1",
    branch_name: "dispatch/node-1",
    remote_ref: "origin/main",
  )
  cmd.program == "git"
    && cmd.args == ["worktree", "add", "/opt/gunbc/dispatch-worktrees/node-1", "-b", "dispatch/node-1", "origin/main"]
}

test fn witness_tmux_spawn_argv_threads_claude_argv() -> Bool {
  let claude = claude_spawn_argv(
    effort: "medium",
    session_uuid: "uuid-2",
    node_id: nid(s: "node-2"),
    brief: "brief",
  )
  let cmd = tmux_spawn_argv(
    session_name: "gunbc-dispatch-node-2",
    worktree_path: "/opt/gunbc/dispatch-worktrees/node-2",
    claude_argv: claude,
  )
  cmd.program == "tmux"
    && starts_with(s: join(cmd.args, separator: " "), prefix: "new-session -d -s gunbc-dispatch-node-2")
    && string_contains(s: join(cmd.args, separator: "\0"), pattern: "CLAUDE_CODE_NO_FLICKER=1")
}

test fn witness_codex_provider_is_selected_explicitly() -> Bool {
  dispatch_cli_provider == CodexCliProvider
}

test fn witness_codex_npm_launcher_fingerprint_is_live_receipt() -> Bool {
  let scope = dispatch_tmux_session_scope(node_id: nid(s: "codex-fingerprint"))
  scope.expected_process_fingerprint == ("node" as NonEmptyStr)
}

test fn witness_codex_argv_is_unattended_but_sandboxed() -> Bool {
  let argv = codex_spawn_argv(
    effort: "high",
    worktree_path: "/opt/gunbc/dispatch-worktrees/codex-node",
    brief: "brief body",
  )
  let wire = join(argv, separator: "\0")
  starts_with(s: wire, prefix: concat("env\0CODEX_HOME=", dispatch_codex_home))
    && string_contains(s: wire, pattern: "\0codex\0--ask-for-approval\0never\0exec")
    && string_contains(s: wire, pattern: "\0--sandbox\0workspace-write")
    && string_contains(s: wire, pattern: "\0--json")
    && string_contains(s: wire, pattern: "\0-C\0/opt/gunbc/dispatch-worktrees/codex-node")
    && string_contains(s: wire, pattern: "model_reasoning_effort=\"high\"")
    && string_contains(s: wire, pattern: "brief body")
    && !string_contains(s: wire, pattern: "--dangerously-bypass-approvals-and-sandbox")
    && !string_contains(s: wire, pattern: "--ephemeral")
}

test fn witness_selected_provider_shapes_codex_tmux_command() -> Bool {
  let node = sized_derivable(id: "codex-selected", prs: [1], title: "Codex selected")
  let cmds = dispatch_spawn_commands_for_provider(
    node: node,
    session_uuid: "uuid-unused-by-codex",
    attempt_key: "feedfacefeedface",
    provider: CodexCliProvider,
  )
  let wire = join(cmds.tmux_spawn.args, separator: "\0")
  cmds.tmux_spawn.program == "tmux"
    && string_contains(s: wire, pattern: "\0codex\0--ask-for-approval\0never\0exec")
    && !string_contains(s: wire, pattern: "\0claude\0")
}

test fn witness_lab_instance_moves_repo_tmux_and_codex_state_together() -> Bool {
  let lab = srv1_lab_dashboard_instance()
  let commands = dispatch_spawn_commands_for_instance(
    instance: lab,
    node: sized_derivable(
      id: "ts-dispatch-provider-events",
      prs: [],
      title: "Provider execution facts",
    ),
    session_uuid: "00000000-0000-4000-8000-000000000001",
    attempt_key: "feedfacefeedface",
    provider: CodexCliProvider,
  )
  let git_wire = join(commands.worktree_add.args, separator: "\0")
  let tmux_wire = join(commands.tmux_spawn.args, separator: "\0")
  string_contains(
    s: git_wire,
    pattern: "/home/briansrls/.local/share/gunbc/dashboard-instances/codex-provider-feedback-v0/attempts/ts-dispatch-provider-events-afeedfacefeedface",
  )
    && string_contains(s: git_wire, pattern: "\0origin/main")
    && starts_with(
      s: tmux_wire,
      prefix: "-L\0srv1-lab-codex-feedback-v0\0new-session\0-d\0-s\0gunbc-dispatch-ts-dispatch-provider-events",
    )
    && string_contains(
      s: tmux_wire,
      pattern: "\0CODEX_HOME=/home/briansrls/.codex@gunbc-roadmap\0/usr/bin/codex\0",
    )
}

test fn codex_provider_v0_argv_keystone_holds() -> Bool {
  witness_codex_provider_is_selected_explicitly()
    && witness_codex_npm_launcher_fingerprint_is_live_receipt()
    && witness_codex_argv_is_unattended_but_sandboxed()
    && witness_selected_provider_shapes_codex_tmux_command()
    && witness_lab_instance_moves_repo_tmux_and_codex_state_together()
    && witness_host_exec_argv_shapes_bound_to_extdeps()
}

test fn witness_stop_argv_targets_session() -> Bool {
  let cmd = tmux_kill_session_argv(session_name: "gunbc-dispatch-node-3")
  cmd.args == ["kill-session", "-t", "gunbc-dispatch-node-3"]
}

test fn witness_tmux_ls_parse_filters_prefix() -> Bool {
  let output = "other: 1 windows (created Fri Jul  3 04:14:00 2026)\ngunbc-dispatch-node-4: 2 windows (created Fri Jul  3 04:15:00 2026)\n"
  let entries = filter_dispatch_tmux_sessions(entries: parse_tmux_ls_output(output: output))
  count(entries) == 1
    && entries.first().session_name == "gunbc-dispatch-node-4"
    && entries.first().windows == 2
}

test fn witness_not_ready_node_refused() -> Bool {
  let parent = sized_derivable(id: "parent", prs: [100], title: "Parent")
  let child = sized_derivable(id: "child", prs: [200], title: "Child")
  let edges = [RoadmapEdge { child: nid(s: "child"), parent: nid(s: "parent") }]
  let doc = fixture_doc(nodes: [parent, child], edges: edges)
  let ready = next_spawnable(doc: doc, merged: [])
  match classify_dispatch_request(node: child, ready: ready, tmux_entries: [], attempt_key: "feedfacefeedface") {
    DispatchRefused { reason: r } => string_contains(s: r as String, pattern: "not in ready frontier")
    _ => false
  }
}

test fn witness_ready_node_permitted_without_live_session() -> Bool {
  let node = sized_derivable(id: "ready-node", prs: [10], title: "Ready")
  let doc = fixture_doc(nodes: [node], edges: [])
  let ready = next_spawnable(doc: doc, merged: [])
  match classify_dispatch_request(node: node, ready: ready, tmux_entries: [], attempt_key: "feedfacefeedface") {
    DispatchPermitted { session_name: s, worktree_path: w, branch_name: b, brief: br, reasoning_effort: e } =>
      s == "gunbc-dispatch-ready-node"
        && string_contains(s: w, pattern: "ready-node-afeedfacefeedface")
        && b == "dispatch/ready-node-afeedfacefeedface"
        && string_contains(s: br, pattern: "Ready")
        && e == "high"
    _ => false
  }
}

test fn witness_live_lease_refused() -> Bool {
  let node = sized_derivable(id: "leased-node", prs: [11], title: "Leased")
  let doc = fixture_doc(nodes: [node], edges: [])
  let ready = next_spawnable(doc: doc, merged: [])
  let entries = [TmuxLsEntry { session_name: "gunbc-dispatch-leased-node", windows: 1 }]
  match classify_dispatch_request(node: node, ready: ready, tmux_entries: entries, attempt_key: "feedfacefeedface") {
    DispatchRefused { reason: r } =>
      string_contains(s: r as String, pattern: "name occupied")
        && string_contains(s: r as String, pattern: "fingerprint unobserved")
    _ => false
  }
}

test fn witness_absent_lease_classifies_spawn() -> Bool {
  let scope = dispatch_tmux_session_scope(node_id: nid(s: "lease-absent"))
  match classify_dispatch_lease_upsert(scope: scope, obs: SessionAbsent) {
    UpsertClassification { verdict: Absent, decision: Apply { plan: SpawnSession } } => true
    _ => false
  }
}

test fn witness_hostile_node_id_single_argv_token() -> Bool {
  hostile_node_id_stays_single_argv_token(node_id: "foo;rm -rf /")
}

test fn witness_live_sessions_panel_rows() -> Bool {
  let output = "gunbc-dispatch-panel-a: 1 windows (created Fri Jul  3 04:14:00 2026)\n"
  let rows = dispatch_live_sessions(tmux_ls_output: output)
  count(rows) == 1
    && rows.first().node_id == "panel-a"
    && rows.first().session_name == "gunbc-dispatch-panel-a"
    && rows.first().lease_verdict == UnknownRefused
}

test fn witness_name_only_observation_not_converged() -> Bool {
  let scope = dispatch_tmux_session_scope(node_id: nid(s: "name-only"))
  match classify_tmux_session(
    scope: scope,
    obs: SessionNameObserved {
      session_name: "gunbc-dispatch-name-only" as NonEmptyStr,
      windows: 1,
    },
  ) {
    UnknownRefused => true
    Converged => false
    _ => false
  }
}

test fn witness_foreign_process_fingerprint_is_conflict() -> Bool {
  let scope = dispatch_tmux_session_scope(node_id: nid(s: "foreign-proc"))
  match classify_dispatch_lease_upsert(
    scope: scope,
    obs: SessionObserved {
      session_name: "gunbc-dispatch-foreign-proc" as NonEmptyStr,
      windows: 1,
      process_fingerprint: "foreign-shell" as NonEmptyStr,
    },
  ) {
    UpsertClassification { verdict: Conflict, decision: Refuse { reason: _ } } => true
    UpsertClassification { verdict: Converged, decision: _ } => false
    _ => false
  }
}

test fn witness_fingerprint_scaffold_marker_present() -> Bool {
  match dispatch_tmux_process_fingerprint_observation_dissolution_trigger {
    Scaffold { dissolves_to: _, bind: _ } => false
    Terminal { reason: r } => string_contains(s: r as String, pattern: "DISSOLVED")
  }
}

test fn witness_host_exec_argv_shapes_bound_to_extdeps() -> Bool {
  let worktree_args = shape_git_worktree_add_argv(
    path: "/opt/gunbc/dispatch-worktrees/bound-node" as FilePath,
    branch: "dispatch/bound-node" as NonEmptyStr,
    remote_ref: "origin/main" as GitRef,
  )
  let bound_worktree = git_worktree_add_argv(
    worktree_path: "/opt/gunbc/dispatch-worktrees/bound-node",
    branch_name: "dispatch/bound-node",
    remote_ref: "origin/main",
  )
  let tmux_args = shape_tmux_new_session_argv(
    session_name: "gunbc-dispatch-bound-node",
    working_dir: "/opt/gunbc/dispatch-worktrees/bound-node",
    inner_argv: ["env", "CLAUDE_CODE_NO_FLICKER=1"],
  )
  let claude_args_dangerous = shape_claude_invoke_argv(
    session_id: "uuid-bound",
    node_id: "bound-node",
    effort: "high",
    settings_json: "{}",
    append_system_prompt: "brief",
    start_prompt: "go",
    permission_args: ["--dangerously-skip-permissions"],
  )
  let claude_args_default = shape_claude_invoke_argv(
    session_id: "uuid-bound",
    node_id: "bound-node",
    effort: "high",
    settings_json: "{}",
    append_system_prompt: "brief",
    start_prompt: "go",
    permission_args: [],
  )
  let codex_args = shape_codex_exec_argv(
    codex_home: "/home/u/.codex-dispatch",
    cwd: "/opt/gunbc/dispatch-worktrees/bound-node",
    prompt: "brief",
    reasoning_effort: "high",
    spec: CodexExecSpec {
      sandbox: CodexWorkspaceWrite,
      approval: CodexApprovalNever,
      json_events: true,
      persist_session: true,
    },
  )
  bound_worktree.args == worktree_args
    && starts_with(s: join(tmux_args, separator: " "), prefix: "new-session -d -s gunbc-dispatch-bound-node")
    && string_contains(s: join(claude_args_dangerous, separator: "\0"), pattern: "--dangerously-skip-permissions")
    && !string_contains(s: join(claude_args_default, separator: "\0"), pattern: "--dangerously-skip-permissions")
    && string_contains(s: join(codex_args, separator: "\0"), pattern: "\0codex\0--ask-for-approval\0never\0exec")
    && string_contains(s: join(codex_args, separator: "\0"), pattern: "\0--sandbox\0workspace-write\0--color\0never\0--json")
    && !string_contains(s: join(codex_args, separator: "\0"), pattern: "--ephemeral")
}

test fn witness_claude_invoke_permission_args_are_gunbc_policy() -> Bool {
  let argv = claude_spawn_argv(
    effort: "high",
    session_uuid: "uuid-policy",
    node_id: nid(s: "node-policy"),
    brief: "brief",
  )
  string_contains(s: join(argv, separator: "\0"), pattern: "--dangerously-skip-permissions")
    && dispatch_claude_permission_args == ["--dangerously-skip-permissions"]
}

test fn witness_tmux_new_session_service_op_splices_inner_argv() -> Bool {
  let via_service_shape = shape_tmux_new_session_argv(
    session_name: "gunbc-dispatch-splice",
    working_dir: "/opt/gunbc/dispatch-worktrees/splice",
    inner_argv: ["claude", "--flag-a", "value with spaces", "--flag-b"],
  )
  via_service_shape == [
    "new-session", "-d", "-s", "gunbc-dispatch-splice",
    "-c", "/opt/gunbc/dispatch-worktrees/splice",
    "claude", "--flag-a", "value with spaces", "--flag-b",
  ]
}

test fn witness_session_lease_shape_reused() -> Bool {
  session_lease_reuses_process_port_classifier_shape()
}

fn ticket_fixture_node() -> RoadmapNode {
  gunbc.roadmap_authority.ticket_wi(id: "ticket-fixture", done: false, t: TicketFields {
    headline: "Fixture Headline",
    brief: "A short brief.",
    displaced_cost: "the real displaced cost",
    current_state: "the real current state",
    first_slice: "the real first slice",
    red_control: "the real red control",
    out_of_scope: "the real scope wall",
    handback: "the real handback",
    updates: [],
    authored_on: "2026-07-24",
    last_verified_on: "2026-07-24",
  }, intricacy: IntricacyMedium, volume: VolumeSmall, repo: "gunbc")
}

test fn witness_ticket_brief_fills_real_slots() -> Bool {
  let brief = filled_dispatch_brief_for_node(node: ticket_fixture_node())
  string_contains(s: brief, pattern: "the real displaced cost")
    && string_contains(s: brief, pattern: "the real current state")
    && string_contains(s: brief, pattern: "the real first slice")
    && string_contains(s: brief, pattern: "the real red control")
    && string_contains(s: brief, pattern: "the real scope wall")
    && string_contains(s: brief, pattern: "the real handback")
}

test fn witness_legacy_brief_still_stubs_with_title() -> Bool {
  let node = sized_derivable(id: "brief-node", prs: [1], title: "Brief Title")
  let brief = filled_dispatch_brief_for_node(node: node)
  string_contains(s: brief, pattern: "Brief Title")
    && !string_contains(s: brief, pattern: "the real displaced cost")
}
