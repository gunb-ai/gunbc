module test.claim.gunbc_invoke_witness

import gunbc.cli_invoke {
  PlanFunction,
  CiFloorPlan,
  CiRegenFloorPlan,
  CiPlanArtifactPlan,
  FalsifierPlan,
  FalsifierNativeCacheColdPlan,
  claim_executor_run_plan_shell,
  claim_executor_run_plan_transport_argv,
  claim_executor_verify_artifacts_shell,
  source_roots_shell_flags,
  SourceRootBare,
  SourceRootRooted
}
import gunbc.ci_layer_roots { witness_layer_roots, witness_layer_source_flags }
import gunbc.ci_spec {
  gunbc_ci_spec,
  gunbc_ci_deploy_srv1_stage,
  gunbc_ci_deploy_invoke,
  scheduler_invoke,
  scheduler_invoke_with,
  ci_floor_build_verify_script,
  artifact_shell_path
}
import gunbc.falsifier_workflow {
  falsifier_invoke,
  compile_clean_cold_control_invoke,
  native_cache_cold_control_invoke
}
import gunbc.merge_admission_produce { ci_repo_root_shell }
import gunbc.ci_release_bins {
  ci_floor_required_artifact_names
}
import v2.std.collection { Absent, Present }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data floor_plan_entry_path: String = "src/v2/workflow/ci_floor_plan.dag"

data plan_function_invoke_witness_closeout_note: String = "Closeout for #7642 PlanFunction coproduct: every production claim_executor_run_plan_shell consumer is witnessed as matching the typed variant, not a parallel string literal. v2.test.claim.ci_floor_plan_witness pins emitted argv and WalkPlan shape; these rows pin the invoke helpers that assemble those argv tokens."

fn modeled_ci_spec_rooted_invoke(p: PlanFunction) -> String {
  claim_executor_run_plan_shell(
    source_roots: witness_layer_roots,
    plan_entry: floor_plan_entry_path,
    plan_function: p,
    notice_title: Present { value: gunbc_ci_spec.notice_title },
    rooted: true
  )
}

fn modeled_falsifier_bare_invoke(p: PlanFunction) -> String {
  concat(
    concat("ROOT=", concat(ci_repo_root_shell(), "\n")),
    claim_executor_run_plan_shell(
      source_roots: witness_layer_roots,
      plan_entry: floor_plan_entry_path,
      plan_function: p,
      notice_title: Absent,
      rooted: false
    )
  )
}

data gunbc_invoke_deploy_srv1_pre_migration_golden_note: String = "Hand-frozen pre-Phase-3a bytes from origin/main gunbc_ci_deploy_invoke(gunbc_ci_deploy_srv1_stage) before gunbc.cli_invoke consolidation. Independent of gunbc_run_shell so a helper drift cannot green both sides (PR #6467 ci_cargo_eagain_retry_core_golden pattern)."

data gunbc_ci_deploy_invoke_srv1_pre_migration_golden: String = concat(
  concat("ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)\n"),
  concat(
    "\"$ROOT/target/release/gunbc\" run --source-root \"$ROOT/dag\" --source-root \"$ROOT/src/v2\"",
    concat(
      " --entry dag/gunbc/live_deploy/apply.dag",
      " --function live_deploy_apply_srv1_wet\n"
    )
  )
)

data gunbc_ci_deploy_invoke_srv1_wrong_entry_golden: String = concat(
  concat("ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)\n"),
  concat(
    "\"$ROOT/target/release/gunbc\" run --source-root \"$ROOT/dag\" --source-root \"$ROOT/src/v2\"",
    concat(
      " --entry dag/gunbc/live_deploy/WRONG_ENTRY.dag",
      " --function live_deploy_apply_srv1_wet\n"
    )
  )
)

test fn gunbc_invoke_scheduler_matches_modeled_shell_holds() -> Bool {
  scheduler_invoke(spec: gunbc_ci_spec) == modeled_ci_spec_rooted_invoke(p: CiFloorPlan)
}

test fn gunbc_invoke_regen_scheduler_matches_modeled_shell_holds() -> Bool {
  scheduler_invoke_with(spec: gunbc_ci_spec, plan_function: CiRegenFloorPlan)
    == modeled_ci_spec_rooted_invoke(p: CiRegenFloorPlan)
}

test fn gunbc_invoke_falsifier_matches_modeled_shell_holds() -> Bool {
  falsifier_invoke() == modeled_falsifier_bare_invoke(p: FalsifierPlan)
}

test fn gunbc_invoke_compile_clean_cold_control_matches_modeled_shell_holds() -> Bool {
  compile_clean_cold_control_invoke() == modeled_falsifier_bare_invoke(p: CiPlanArtifactPlan)
}

test fn gunbc_invoke_native_cache_cold_control_matches_modeled_shell_holds() -> Bool {
  native_cache_cold_control_invoke() == modeled_falsifier_bare_invoke(p: FalsifierNativeCacheColdPlan)
}

test fn gunbc_invoke_deploy_matches_pre_migration_golden_holds() -> Bool {
  gunbc_ci_deploy_invoke(stage: gunbc_ci_deploy_srv1_stage) == gunbc_ci_deploy_invoke_srv1_pre_migration_golden
}

test fn gunbc_invoke_deploy_pre_migration_golden_red_on_wrong_entry_holds() -> Bool {
  gunbc_ci_deploy_invoke(stage: gunbc_ci_deploy_srv1_stage) != gunbc_ci_deploy_invoke_srv1_wrong_entry_golden
}

test fn gunbc_invoke_source_root_flags_authority_holds() -> Bool {
  witness_layer_source_flags(roots: witness_layer_roots) ==
    source_roots_shell_flags(roots: witness_layer_roots, style: SourceRootBare)
    && source_roots_shell_flags(roots: witness_layer_roots, style: SourceRootRooted { root_var: "$ROOT" }) ==
      concat(" --source-root \"$ROOT/dag\"", " --source-root \"$ROOT/src/v2\"")
}

test fn gunbc_invoke_empty_notice_title_omits_flag_holds() -> Bool {
  let shell = claim_executor_run_plan_shell(
    source_roots: witness_layer_roots,
    plan_entry: "src/v2/workflow/ci_floor_plan.dag",
    plan_function: CiFloorPlan,
    notice_title: Present { value: "" },
    rooted: true
  )
  !string_contains(s: shell, pattern: "--notice-title")
}

fn transport_argv_contains_flag(argv: List<String>, flag: String) -> Bool {
  fold(argv, init: false, f: (acc, arg) => acc || arg == flag)
}

test fn gunbc_invoke_transport_argv_empty_notice_title_omits_flag_holds() -> Bool {
  let argv = claim_executor_run_plan_transport_argv(
    source_roots: witness_layer_roots,
    plan_entry: "src/v2/workflow/ci_floor_plan.dag",
    plan_function: CiFloorPlan,
    notice_title: Present { value: "" }
  )
  !transport_argv_contains_flag(argv: argv, flag: "--notice-title")
    && claim_executor_run_plan_transport_argv(
      source_roots: witness_layer_roots,
      plan_entry: "src/v2/workflow/ci_floor_plan.dag",
      plan_function: CiFloorPlan,
      notice_title: Absent
    ) == argv
}

test fn gunbc_invoke_verify_artifacts_shell_nonempty_holds() -> Bool {
  let script = claim_executor_verify_artifacts_shell(artifact_paths: ["\"$ROOT/target/release/gunbc\""])
  string_contains(s: script, pattern: "--verify-build-artifacts")
    && string_contains(s: script, pattern: "\"$ROOT/target/release/gunbc\"")
    && ci_floor_build_verify_script() == claim_executor_verify_artifacts_shell(
      artifact_paths: map(ci_floor_required_artifact_names(), name => artifact_shell_path(name: name))
    )
}
