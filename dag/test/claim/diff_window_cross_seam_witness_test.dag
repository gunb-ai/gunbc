module test.claim.diff_window_cross_seam_witness_test

import std.logic { Bool }
import std.types { String }
import extdeps.git.object_store { git_object_id_wire_hex, git_sha1_object_id, GitObjectId, GitSha1ObjectId, Sha1Digest, Sha1DigestHex }
import gunbc.diff_change_window {
  ExactDiffWindow,
  DiffWindowObservation,
  DiffWindowObserved,
  DiffWindowMalformed,
  ClaimedMergeBase,
  VerifiedMergeBase,
  exact_diff_window_for_verification,
  diff_window_json,
  diff_window_from_json,
  diff_window_env_assignment,
  gunbc_diff_window_path_env,
}
import gunbc.diff_baseline {
  CiDiffEvent,
  DiffBaselineResolution,
  BaselineSelected,
  BaselineRefused,
  ExactReplayBoundary,
  resolve_diff_baseline,
  diff_baseline_diff_base,
  diff_baseline_diff_head,
  diff_baseline_is_exact_replay
}
import gunbc.repo_identity { gunbc_merge_target_ref, gunbc_default_remote_name }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data planted_base_hex: String = "abc123def4567890abc123def4567890abc12345"
data planted_head_hex: String = "fedcba0987654321fedcba0987654321fedcba09"
data planted_window_path: String = "/tmp/attempt/verification/fedcba09.diff-window.json"

fn planted_oid(hex: String) -> GitObjectId {
  match git_sha1_object_id(hex: hex) {
    Present { value: oid } => oid
    Absent =>
      GitSha1ObjectId {
        digest: Sha1Digest {
          hex: planted_base_hex as Sha1DigestHex
        }
      }
  }
}

fn planted_exact_window() -> ExactDiffWindow {
  exact_diff_window_for_verification(
    base: planted_oid(hex: planted_base_hex),
    head: planted_oid(hex: planted_head_hex),
    relation: ClaimedMergeBase {},
  )
}

fn planted_diff_window_observation() -> DiffWindowObservation {
  Present { value: DiffWindowObserved { window: planted_exact_window() } }
}

fn resolve_with_diff_window(
  diff_window: DiffWindowObservation?,
  base_ref: String?
) -> DiffBaselineResolution {
  resolve_diff_baseline(
    event: CiDiffEvent {
      override_ref: none,
      event_name: "pull_request",
      base_ref: base_ref,
      push_before: none,
      head_sha: none,
      diff_window: diff_window
    },
    push_parent_ref: gunbc_merge_target_ref,
    default_remote_name: gunbc_default_remote_name
  )
}

test fn witness_verification_window_emits_exact_replay_argv() -> Bool {
  let json = diff_window_json(window: planted_exact_window())
  match diff_window_from_json(text: json) {
    DiffWindowObserved { window: window } =>
      match resolve_with_diff_window(
        diff_window: Present { value: DiffWindowObserved { window: window } },
        base_ref: Present { value: "main" }
      ) {
        BaselineSelected { baseline: b } =>
          diff_baseline_is_exact_replay(b: b)
            && diff_baseline_diff_base(b: b) == planted_base_hex
            && diff_baseline_diff_head(b: b, default_head: "HEAD") == planted_head_hex
        BaselineRefused { reason: _ } => false
      }
    DiffWindowMalformed { detail: _ } => false
    DiffWindowReadRefused { path: _, cause: _ } => false
  }
}

test fn witness_without_diff_window_binding_stays_merge_target() -> Bool {
  match resolve_with_diff_window(diff_window: none, base_ref: Present { value: "main" }) {
    BaselineSelected { baseline: b } =>
      !diff_baseline_is_exact_replay(b: b)
        && diff_baseline_diff_base(b: b) == "origin/main"
    BaselineRefused { reason: _ } => false
  }
}

test fn witness_hex_branch_base_ref_never_enters_exact_replay_route() -> Bool {
  match resolve_with_diff_window(diff_window: none, base_ref: Present { value: planted_base_hex }) {
    BaselineSelected { baseline: b } =>
      !diff_baseline_is_exact_replay(b: b)
        && diff_baseline_diff_base(b: b) == concat("origin/", planted_base_hex)
    BaselineRefused { reason: _ } => false
  }
}

test fn witness_malformed_window_refuses_before_diff() -> Bool {
  match diff_window_from_json(text: "{\"schema\":\"gunbc-diff-window/v1\"}") {
    DiffWindowMalformed { detail: _ } =>
      match resolve_with_diff_window(
        diff_window: Present { value: DiffWindowMalformed { detail: "missing members" } },
        base_ref: Present { value: "main" }
      ) {
        BaselineRefused { reason: reason } =>
          string_contains(s: reason, pattern: "exact diff window malformed")
        BaselineSelected { baseline: _ } => false
      }
    DiffWindowObserved { window: _ } => false
    DiffWindowReadRefused { path: _, cause: _ } => false
  }
}

test fn witness_subject_head_mismatch_refuses_at_parse() -> Bool {
  let bad_json = concat(
    concat(
      concat(
        "{\"schema\":\"gunbc-diff-window/v1\",\"base_object_id\":\"",
        planted_base_hex
      ),
      concat(
        concat("\",\"head_object_id\":\"", planted_head_hex),
        concat("\",\"subject_head\":\"", planted_base_hex)
      )
    ),
    "\",\"relation\":\"claimed_merge_base\"}"
  )
  match diff_window_from_json(text: bad_json) {
    DiffWindowMalformed { detail: detail } =>
      string_contains(s: detail, pattern: "subject_head")
    DiffWindowObserved { window: _ } => false
    DiffWindowReadRefused { path: _, cause: _ } => false
  }
}

test fn witness_verified_relation_is_not_silent_claimed() -> Bool {
  let window = ExactDiffWindow {
    base: planted_oid(hex: planted_base_hex),
    head: planted_oid(hex: planted_head_hex),
    subject_head: planted_oid(hex: planted_head_hex),
    relation: VerifiedMergeBase {},
  }
  match diff_window_from_json(text: diff_window_json(window: window)) {
    DiffWindowObserved { window: parsed } =>
      match parsed.relation {
        VerifiedMergeBase {} => true
        ClaimedMergeBase {} => false
      }
    DiffWindowMalformed { detail: _ } => false
    DiffWindowReadRefused { path: _, cause: _ } => false
  }
}

test fn witness_env_binding_names_neutral_path_var() -> Bool {
  diff_window_env_assignment(path: planted_window_path) == concat(gunbc_diff_window_path_env as String, concat("=", planted_window_path))
}
