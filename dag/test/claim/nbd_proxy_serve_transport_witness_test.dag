module test.claim.nbd_proxy_serve_transport


data live_tree_disposition: LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

test fn nbd_proxy_ws_path_for_vm_slot_index() -> Bool {
  extdeps.bmc.webui.nbd_proxy.bmcweb_nbd_proxy_ws_path(variant: extdeps.bmc.webui.nbd_proxy.VmSlotIndexEndpoint, slot: 0, index: 0) == "/vm/0/0"
}

test fn nbd_proxy_serve_argv_is_typed_not_shell_supervision_program() -> Bool {
  let intent = extdeps.bmc.webui.nbd_proxy_serve.nbd_proxy_serve_transport_intent(
    bmc_host: extdeps.boards.asrock_rack.asrock_srv3_live_bmc_host,
    session_token: extdeps.bmc.webui.nbd_proxy_serve.bmcweb_session_token_env_ref,
    ws_path: extdeps.bmc.webui.nbd_proxy.bmcweb_nbd_proxy_ws_path(variant: extdeps.bmc.webui.nbd_proxy.VmSlotIndexEndpoint, slot: 0, index: 0),
    iso_path: "/var/lib/gunbc/artifacts/ubuntu-24.04.3-live-server-arm64.iso",
    local_nbd_port: extdeps.bmc.webui.nbd_proxy_serve.srv3_nbd_proxy_local_port,
  )
  extdeps.bmc.webui.nbd_proxy_serve.nbd_proxy_serve_websocat_argv_leading_tool_is_websocat(intent: intent)
    && extdeps.bmc.webui.nbd_proxy_serve.nbd_proxy_serve_nbdkit_argv_includes_iso(intent: intent)
    && extdeps.bmc.webui.nbd_proxy_serve.nbd_proxy_serve_has_no_shell_supervision_grammar(intent: intent)
    && string_contains(
      s: extdeps.bmc.webui.nbd_proxy_serve.nbd_proxy_serve_nbdkit_unit_name(lease_key: gunbc.srv3_os_install_reconcile_types.srv3_nbd_proxy_lease_key) as String,
      pattern: "nbd-proxy-",
    )
    && string_contains(
      s: extdeps.bmc.webui.nbd_proxy_serve.nbd_proxy_serve_websocat_unit_name(lease_key: gunbc.srv3_os_install_reconcile_types.srv3_nbd_proxy_lease_key) as String,
      pattern: "-ws",
    )
    && nbd_proxy_serve_cited_tool_names_includes_nbdkit()
    && nbd_proxy_serve_cited_tool_names_includes_websocat()
    && nbd_proxy_serve_cited_tool_names_includes_socat()
}

fn nbd_proxy_serve_cited_tool_names_includes_nbdkit() -> Bool {
  fold(
    extdeps.bmc.webui.nbd_proxy_serve.nbd_proxy_serve_cited_tool_names,
    init: false,
    f: (acc, name) => acc || name == extdeps.tools.nbdkit.nbdkit_cli_tool.name
  )
}

fn nbd_proxy_serve_cited_tool_names_includes_websocat() -> Bool {
  fold(
    extdeps.bmc.webui.nbd_proxy_serve.nbd_proxy_serve_cited_tool_names,
    init: false,
    f: (acc, name) => acc || name == extdeps.tools.websocat.websocat_cli_tool.name
  )
}

fn nbd_proxy_serve_cited_tool_names_includes_socat() -> Bool {
  fold(
    extdeps.bmc.webui.nbd_proxy_serve.nbd_proxy_serve_cited_tool_names,
    init: false,
    f: (acc, name) => acc || name == extdeps.tools.socat.socat_cli_tool.name
  )
}

test fn nbd_proxy_serve_supervision_marker_red_control_holds() -> Bool {
  extdeps.bmc.webui.nbd_proxy_serve.nbd_proxy_serve_argv_surface_contains_supervision_marker(surface: "trap 'kill $PID' EXIT")
    && extdeps.bmc.webui.nbd_proxy_serve.nbd_proxy_serve_argv_surface_contains_supervision_marker(surface: "nbdkit -p 10809 &")
    && extdeps.bmc.webui.nbd_proxy_serve.nbd_proxy_serve_argv_surface_contains_supervision_marker(surface: "echo $!")
    && !extdeps.bmc.webui.nbd_proxy_serve.nbd_proxy_serve_argv_surface_contains_supervision_marker(
      surface: "websocat --text --header=\"Authorization: Token abc\" wss://host/vm/0/0",
    )
}

test fn nbd_proxy_serve_carrier_names_systemd_realization_dissolution_trigger() -> Bool {
  match extdeps.bmc.webui.nbd_proxy_serve.nbd_proxy_serve_systemd_realization_dissolution_trigger {
    std.disposition.Scaffold { dissolves_to: _, bind: _ } => true
    Terminal { reason: _ } => false
  }
}

test fn bmcweb_session_login_argv_uses_curl_authority_not_inline_secret() -> Bool {
  witness_bmcweb_session_login_argv_semantic_surface_holds()
}

fn witness_bmcweb_session_login_argv_semantic_surface_holds() -> Bool {
  let body = "/tmp/bmcweb-login.json" as std.types.NonEmptyStr
  let response = "/tmp/bmcweb-login-response.json" as std.types.NonEmptyStr
  let curl_args = extdeps.bmc.webui.nbd_proxy_serve.bmcweb_session_login_curl_args(
    bmc_host: extdeps.boards.asrock_rack.asrock_srv3_live_bmc_host,
    request_body_file: body,
    response_path: response,
  )
  let argv = extdeps.bmc.webui.nbd_proxy_serve.bmcweb_session_login_argv(
    bmc_host: extdeps.boards.asrock_rack.asrock_srv3_live_bmc_host,
    request_body_file: body,
    response_path: response,
  )
  let curl_args_surface = fold(
    curl_args,
    init: "",
    f: (acc, word) => if acc == "" { word } else { concat(acc, concat(" ", word)) },
  )
  let argv_surface = fold(
    argv,
    init: "",
    f: (acc, word) => if acc == "" { word } else { concat(acc, concat(" ", word)) },
  )
  fold(argv, init: "", f: (acc, word) => if acc == "" { word } else { acc }) == extdeps.tools.curl.curl_cli_tool.name
    && extdeps.tools.curl.curl_cli_tool.name == "curl"
    && string_contains(s: argv_surface, pattern: curl_args_surface)
    && string_contains(s: argv_surface, pattern: "-o")
    && string_contains(s: argv_surface, pattern: body as String)
    && string_contains(s: argv_surface, pattern: response as String)
    && string_contains(s: argv_surface, pattern: "https://")
    && string_contains(s: argv_surface, pattern: "/login")
}

test fn nbd_proxy_serve_host_role_is_nbd_server() -> Bool {
  extdeps.bmc.webui.nbd_proxy_serve.nbd_proxy_serve_requires_host_as_nbd_server()
}
