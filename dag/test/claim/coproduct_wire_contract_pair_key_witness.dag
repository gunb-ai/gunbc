module test.claim.coproduct_wire_contract_pair_key_witness

import std.types { Bool }
import std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// RED for RFM dag/gunbc/recurring_failure_mode/coproduct_wire_contract_target_not_local_in_emitted_extdeps_github.dag
// (charter 3 filed the row from the self-host closure failure: emitted extdeps_github_github.rs carried
// "CoproductWireContract target does not name a local coproduct: IssueState" because the emitter matched
// a CoproductWireContract row by DECL NAME ALONE over the emitting module's wire context -- so
// github_contracts' row, whose DeclarationRef claims jurisdiction over extdeps.github.issues.IssueState
// (another module), was validated against github, which declares no IssueState at all, and refused).
//
// The repair keys the row by its OWN DeclarationRef PAIR -- (module_path, decl_name) -- exactly as the
// typing authority indexes rows (v1_interpreter.rs build_coproduct_wire_contract_index): a row governs
// the declaration it names and no other.
//
// ReadsLiveTree, as on every compile_dag_rust_emit_check surface: std.serialization and std.decl_ref
// resolve from the live corpus, so what is under test is the emitter's keying of real CoproductWireContract
// and DeclarationRef shapes, not a fixture-local stand-in.

// FALSE REFUSAL (the RFM's exact cargo error, carried by a fixture because the shape is unrepresentable
// in the accepted corpus -- DESIGN 4b): a module that declares some coproduct but NOT IssueState, carrying
// a row whose DeclarationRef claims ANOTHER module's IssueState. BEFORE: validation read the row's
// decl_name alone, found no local coproduct of that name, and emitted the cargo-facing compile_error.
// AFTER: the row claims extdeps.github.issues, so it is not this module's obligation -- validated where it
// claims jurisdiction, not here -- and the module's own coproduct keeps the internal-tag default.
test fn a_row_claiming_another_module_does_not_refuse_this_one() -> Bool {
  compile_dag_rust_emit_check(
    "module cwc_pair_foreign_target\n\nimport std.serialization { CoproductWireContract, StringVariant, SnakeCase }\nimport std.decl_ref { DeclarationRef, WholeDeclaration }\n\ntype Direction = North | South\n\ndata foreign_issue_state_wire_contract: CoproductWireContract = {\n  coproduct: DeclarationRef { module_path: \"extdeps.github.issues\", decl_name: \"IssueState\", field: WholeDeclaration },\n  encoding: StringVariant { naming: SnakeCase }\n}\n",
    "src/cwc_pair_foreign_target.rs",
    ["pub enum Direction", "#[serde(tag = \"_variant\")]"],
    ["compile_error!", "rename_all"]
  )
}

// POLICY LEAK (the mirror half of the same boundary): a module that DOES declare a coproduct named
// IssueState, plus a row claiming ANOTHER module's same-named coproduct. BEFORE: name-only matching served
// the foreign row's encoding to the local coproduct -- an encoding its own module never declared. AFTER:
// the pair does not match this module, the row governs nothing here, and the local declaration keeps the
// default. This arm's expectations flip with the repair, which is what makes the witness discriminating
// rather than merely green.
test fn a_foreign_row_does_not_govern_a_same_named_local() -> Bool {
  compile_dag_rust_emit_check(
    "module cwc_pair_name_collision\n\nimport std.serialization { CoproductWireContract, StringVariant, SnakeCase }\nimport std.decl_ref { DeclarationRef, WholeDeclaration }\n\ntype IssueState = Open | Closed\n\ndata foreign_issue_state_wire_contract: CoproductWireContract = {\n  coproduct: DeclarationRef { module_path: \"somewhere.else\", decl_name: \"IssueState\", field: WholeDeclaration },\n  encoding: StringVariant { naming: SnakeCase }\n}\n",
    "src/cwc_pair_name_collision.rs",
    ["pub enum IssueState", "#[serde(tag = \"_variant\")]"],
    ["rename_all", "compile_error!"]
  )
}

// THE REFUSAL SURVIVES WHERE IT IS EARNED (green before AND after): a row that claims THIS module must
// still name a locally declared coproduct. This is the arm that proves the repair is a re-keying and not
// a silencing of the cargo-facing error.
test fn a_row_claiming_this_module_still_refuses_an_absent_target() -> Bool {
  compile_dag_rust_emit_check(
    "module cwc_pair_liar\n\nimport std.serialization { CoproductWireContract, StringVariant, AsAuthored }\nimport std.decl_ref { DeclarationRef, WholeDeclaration }\n\ntype FixtureCarrier = Here0 | Gone0\n\ndata ghost_wire_contract: CoproductWireContract = {\n  coproduct: DeclarationRef { module_path: \"cwc_pair_liar\", decl_name: \"GhostCoproduct\", field: WholeDeclaration },\n  encoding: StringVariant { naming: AsAuthored }\n}\n",
    "src/cwc_pair_liar.rs",
    ["compile_error!", "CoproductWireContract target does not name a local coproduct: GhostCoproduct"],
    []
  )
}

// THE ROW STILL GOVERNS WHERE IT CLAIMS JURISDICTION (green before AND after): the pair matches this
// module and this declaration, so the declared encoding renders. After the repair this is the arm that
// proves the keying did not disable the mechanism.
test fn an_honest_local_row_still_applies_its_encoding() -> Bool {
  compile_dag_rust_emit_check(
    "module cwc_pair_honest\n\nimport std.serialization { CoproductWireContract, StringVariant, SnakeCase }\nimport std.decl_ref { DeclarationRef, WholeDeclaration }\n\ntype Gadget = WidgetOn | WidgetOff\n\ndata gadget_wire_contract: CoproductWireContract = {\n  coproduct: DeclarationRef { module_path: \"cwc_pair_honest\", decl_name: \"Gadget\", field: WholeDeclaration },\n  encoding: StringVariant { naming: SnakeCase }\n}\n",
    "src/cwc_pair_honest.rs",
    ["pub enum Gadget", "#[serde(rename_all = \"snake_case\")]"],
    ["compile_error!", "#[serde(tag = \"_variant\")]"]
  )
}

// AN UNREADABLE module_path IS A MALFORMED ROW, REPORTED -- NOT SILENTLY DROPPED (review 85745).
// The DeclarationRef is well-formed here (the path is a named String, so parse and typing pass),
// but the row's jurisdiction cannot be READ as a literal: the author believes it governs
// FixtureCarrier, and the authority indexes it nowhere. DESIGN section 5: every path succeeds
// fully or fails with a typed, located diagnostic -- a silent widen is a hard reject. BEFORE the
// fix the row vanished with no word (and its encoding even leaked onto the local same-reading
// path under name-only matching); AFTER, the emission carries the located compile_error naming
// the unreadable field, symmetric with the decl_name arm.
test fn an_unreadable_module_path_still_reports() -> Bool {
  compile_dag_rust_emit_check(
    "module cwc_pair_bad_module_path\n\nimport std.serialization { CoproductWireContract, StringVariant, AsAuthored }\nimport std.decl_ref { DeclarationRef, WholeDeclaration }\n\ntype FixtureCarrier = Here0 | Gone0\n\ndata module_path_holder: String = \"cwc_pair_bad_module_path\"\n\ndata bad_module_path_wire_contract: CoproductWireContract = {\n  coproduct: DeclarationRef { module_path: module_path_holder, decl_name: \"FixtureCarrier\", field: WholeDeclaration },\n  encoding: StringVariant { naming: AsAuthored }\n}\n",
    "src/cwc_pair_bad_module_path.rs",
    ["compile_error!", "CoproductWireContract.coproduct must be a DeclarationRef with a string module_path"],
    []
  )
}
