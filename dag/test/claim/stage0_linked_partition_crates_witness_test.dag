module test.claim.stage0_linked_partition_crates_witness

import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.logic { Bool }
import v2.std.collection { List }
import v2.std.text { String }
import v2.std.algebra { any, length }
import v2.workflow.rust_crate_partition {
  Stage0PartitionCrateRow,
  Stage0FoundationCrate,
  Stage0LayeredCoreCrate,
  CompilationUnitId,
}
import gunbc.stage0_executable_assembly_emit {
  LinkedPartitionCratesRendered,
  LinkedPartitionCratesRefused,
  linked_partition_crate_dirs,
  render_linked_partition_crates,
  expected_stage0_linked_partition_crates_txt,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// ── THE WATCH SET FOR THE BUILD IDENTITY IS DERIVED FROM THE PARTITION MODEL, NOT SCANNED ─────
//
// src/v1/stage0/build.rs must rerun -- and so observe a dirty tree -- when ANY crate the
// executable links changes. The set of those crates is the host shell's declared partition
// dependencies closed over the modeled reexport edges. These claims supply a roster and a
// dependency list at that fold's interface; the last one runs the live authorities.

fn row(package: String, dir: String, deps: List<String>) -> Stage0PartitionCrateRow {
  Stage0PartitionCrateRow {
    unit_id: package as CompilationUnitId,
    package_name: package,
    crate_dir: dir,
    kind: Stage0LayeredCoreCrate,
    modules: [],
    reexport_packages: deps,
    carries_non_empty_wrappers: false,
  }
}

fn chain_rows() -> List<Stage0PartitionCrateRow> {
  [
    row(package: "a", dir: "src/a", deps: []),
    row(package: "b", dir: "src/b", deps: ["a"]),
    row(package: "c", dir: "src/c", deps: ["b"]),
    row(package: "unlinked", dir: "src/unlinked", deps: ["a"]),
  ]
}

fn has(xs: List<String>, wanted: String) -> Bool {
  any(xs: xs, predicate: fn(x) { x == wanted })
}

// THE TRANSITIVE-CHILD CASE: declaring only `c` reaches `b` and, through it, `a`. A crate reached
// only through two edges is exactly the one a per-manifest scan of the host shell never sees.
test fn a_transitive_child_is_in_the_watch_set() -> Bool {
  let dirs = linked_partition_crate_dirs(deps: ["c"], rows: chain_rows())
  has(xs: dirs, wanted: "src/c") && has(xs: dirs, wanted: "src/b") && has(xs: dirs, wanted: "src/a")
}

// THE CONTROL: a rostered crate nothing links is NOT watched, so the set is the closure and not
// the roster -- a watch set equal to the roster would pass the claim above for the wrong reason.
test fn an_unlinked_rostered_crate_is_not_in_the_watch_set() -> Bool {
  let dirs = linked_partition_crate_dirs(deps: ["c"], rows: chain_rows())
  !has(xs: dirs, wanted: "src/unlinked") && length(xs: dirs) == 3
}

// A DECLARED DEPENDENCY WITH NO ROW REFUSES THE RENDER, naming it. An omission here would be a
// clean build identity minted over a population nobody could complete.
test fn a_declared_dependency_with_no_row_refuses_the_render() -> Bool {
  match render_linked_partition_crates(deps: ["ghost"], rows: chain_rows()) {
    LinkedPartitionCratesRefused { reason } => contains(reason, "ghost")
    LinkedPartitionCratesRendered { content: _ } => false
  }
}

// AND SO DOES ONE REACHED TRANSITIVELY: a row whose reexport names a package no row carries.
test fn a_transitive_dependency_with_no_row_refuses_the_render() -> Bool {
  let rows = [row(package: "top", dir: "src/top", deps: ["missing"])]
  match render_linked_partition_crates(deps: ["top"], rows: rows) {
    LinkedPartitionCratesRefused { reason } => contains(reason, "missing")
    LinkedPartitionCratesRendered { content: _ } => false
  }
}

// THE RENDER LISTS ONE DIRECTORY PER LINE UNDER THE PROVENANCE HEADER, the shape build.rs reads.
test fn a_rendered_watch_set_is_one_directory_per_line() -> Bool {
  match render_linked_partition_crates(deps: ["c"], rows: chain_rows()) {
    LinkedPartitionCratesRendered { content } =>
      starts_with(s: content, prefix: "# Generated by gunbc stage0_executable_assembly_emit")
        && contains(content, "\nsrc/a\n") && contains(content, "\nsrc/b\n") && contains(content, "\nsrc/c\n")
        && !contains(content, "src/unlinked")
    LinkedPartitionCratesRefused { reason: _ } => false
  }
}

// THE LIVE AUTHORITIES RENDER, and the render reaches the foundation crate the host shell never
// names directly: v1-stage0-runtime is linked only through the layered chain, so its presence is
// the transitive case inhabited by the real model rather than by a fixture.
test fn the_live_partition_model_renders_and_reaches_the_foundation_crate() -> Bool {
  match expected_stage0_linked_partition_crates_txt() {
    LinkedPartitionCratesRendered { content } =>
      contains(content, "\nsrc/v1/stage0_v1_infer\n") && contains(content, "\nsrc/v1/stage0_runtime\n")
    LinkedPartitionCratesRefused { reason: _ } => false
  }
}
