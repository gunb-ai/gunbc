module test.claim.spark_secret_access_ensure_witness_test


data convergence_member: String = "serviceAccount:fleet-cloud-convergence@gunbai-secrets.iam.gserviceaccount.com"

// A binding this model does not own, held by an unrelated principal. Its survival is the property
// that separates an ensure from a policy overwrite.
data foreign_binding: extdeps.cloud.gcp.iam.GcpBinding = extdeps.cloud.gcp.iam.GcpBinding {
  role: "roles/secretmanager.admin",
  members: ["user:someone-else@example.com"],
  condition: none
}

fn policy_without_grant() -> extdeps.cloud.gcp.iam.GcpPolicy {
  extdeps.cloud.gcp.iam.GcpPolicy { bindings: [foreign_binding], etag: "etag-observed", version: 1 }
}

fn policy_with_grant() -> extdeps.cloud.gcp.iam.GcpPolicy {
  extdeps.cloud.gcp.iam.GcpPolicy {
    bindings: [
      foreign_binding,
      extdeps.cloud.gcp.iam.GcpBinding { role: role_secretmanager_secret_accessor, members: [convergence_member], condition: none }
    ],
    etag: "etag-observed",
    version: 1
  }
}

fn reconcile_for(observed: extdeps.cloud.gcp.iam.GcpPolicy) -> extdeps.cloud.gcp.iam.GcpPolicyReconciliation {
  reconcile_gcp_policy(
    observed: observed,
    desired_owned: spark_secret_desired_cells(member: convergence_member),
    owned_universe: spark_secret_owned_universe(member: convergence_member)
  )
}

// The ensure must target the exact enrolled secret, not a re-spelled name.
test fn the_ensure_targets_the_enrolled_administrator_secret() -> Bool {
  let t = spark_secret_target()
  t.secret as String == "spark-administrator-password" && t.project as String == "gunbai-secrets"
}

test fn the_member_resolves_to_the_allocated_convergence_principal() -> Bool {
  match spark_grant_member_resolution() {
    gunbc.spark.secret_access_ensure.SparkGrantMemberResolved { member: m } => m == convergence_member
    gunbc.spark.secret_access_ensure.SparkGrantMemberUnresolved { cause: _ } => false
  }
}

// The grant is for the ACCESSOR role. A grant of admin to the workload would be the escalation the
// two-principal split exists to prevent, so what THIS module selects is asserted -- not the value of
// the imported constant, which would be a tautology about extdeps and would say nothing about the
// cell this ensure actually writes.
test fn the_granted_role_is_accessor_and_not_an_administrative_one() -> Bool {
  let cells = spark_secret_desired_cells(member: convergence_member)
  let admin_free = cells |> filter(c => c.role == "roles/secretmanager.admin")
  count(cells) == 1
    && count(admin_free) == 0
    && gcp_cell_in(
         c: extdeps.cloud.gcp.iam.GcpIamBindingCell { role: "roles/secretmanager.secretAccessor", member: convergence_member, condition: none },
         xs: cells
       )
}

test fn the_desired_cell_names_the_accessor_role_and_the_resolved_member() -> Bool {
  let cells = spark_secret_desired_cells(member: convergence_member)
  count(cells) == 1
    && gcp_cell_in(
         c: extdeps.cloud.gcp.iam.GcpIamBindingCell { role: role_secretmanager_secret_accessor, member: convergence_member, condition: none },
         xs: cells
       )
}

// OWNED is what may be REMOVED. Keeping it equal to desired is what makes a foreign binding
// unremovable; a witness pins it so widening it is a visible edit rather than a quiet one.
test fn the_owned_universe_is_exactly_the_desired_cell() -> Bool {
  let owned = spark_secret_owned_universe(member: convergence_member)
  count(owned.cells) == 1
    && gcp_cell_in(
         c: extdeps.cloud.gcp.iam.GcpIamBindingCell { role: role_secretmanager_secret_accessor, member: convergence_member, condition: none },
         xs: owned.cells
       )
}

// THE NO-OP IS THE POINT. A policy already carrying the grant reconciles to its own arm, so the
// ensure performs no setIamPolicy and the etag does not advance.
test fn an_already_granted_policy_reconciles_to_converged_and_writes_nothing() -> Bool {
  match reconcile_for(observed: policy_with_grant()) {
    extdeps.cloud.gcp.iam.GcpPolicyAlreadyConverged { policy: _ } => true
    extdeps.cloud.gcp.iam.GcpPolicyDeltaRequired { policy: _, added: _, removed: _, preserved: _ } => false
  }
}

test fn a_policy_missing_the_grant_requires_a_delta() -> Bool {
  match reconcile_for(observed: policy_without_grant()) {
    extdeps.cloud.gcp.iam.GcpPolicyAlreadyConverged { policy: _ } => false
    extdeps.cloud.gcp.iam.GcpPolicyDeltaRequired { policy: _, added: a, removed: _, preserved: _ } => count(a) == 1
  }
}

// The written policy must CONTAIN the grant. A delta that computed correctly but assembled a
// policy without the cell would still fail the run, and this is the assertion that separates them.
test fn the_policy_to_write_carries_the_granted_cell() -> Bool {
  match reconcile_for(observed: policy_without_grant()) {
    extdeps.cloud.gcp.iam.GcpPolicyAlreadyConverged { policy: _ } => false
    extdeps.cloud.gcp.iam.GcpPolicyDeltaRequired { policy: p, added: _, removed: _, preserved: _ } =>
      spark_secret_grant_present(policy: p, member: convergence_member)
  }
}

// THE SAFETY PROPERTY. setIamPolicy is a whole-policy replace, so an ensure that assembles the new
// policy from its desired set alone would silently revoke every binding it does not know about.
// The foreign admin binding must survive into the policy that gets written, and must never appear
// in `removed`.
test fn a_foreign_binding_survives_the_write_and_is_never_removed() -> Bool {
  match reconcile_for(observed: policy_without_grant()) {
    extdeps.cloud.gcp.iam.GcpPolicyAlreadyConverged { policy: _ } => false
    extdeps.cloud.gcp.iam.GcpPolicyDeltaRequired { policy: p, added: _, removed: r, preserved: pres } =>
      count(r) == 0
        && gcp_cell_in(
             c: extdeps.cloud.gcp.iam.GcpIamBindingCell { role: "roles/secretmanager.admin", member: "user:someone-else@example.com", condition: none },
             xs: gcp_policy_cells(p: p)
           )
        && count(pres) == 1
  }
}

// The readback predicate must be able to say NO. A predicate that answers true for any policy
// would make the post-write verification vacuous, so it is driven both ways.
test fn the_grant_readback_predicate_discriminates() -> Bool {
  spark_secret_grant_present(policy: policy_with_grant(), member: convergence_member)
    && !spark_secret_grant_present(policy: policy_without_grant(), member: convergence_member)
}

// A different member is a different grant. Without this the readback would accept a policy that
// granted access to somebody else entirely.
test fn the_readback_does_not_accept_a_grant_to_another_member() -> Bool {
  !spark_secret_grant_present(policy: policy_with_grant(), member: "serviceAccount:someone-else@gunbai-secrets.iam.gserviceaccount.com")
}

// THE PRINCIPAL ATTRIBUTION, EXECUTED. The module claims it acts as the modeled control plane and
// never as the workload. Prose cannot establish that, so both directions are driven here.
//
// This is the one that matters. If the workload could perform these operations, the ensure would be
// self-granting and the two-principal split decorative -- so the negative is asserted per operation
// rather than in aggregate, because an aggregate false is satisfied by ANY single denial and would
// hide a partial widening.
test fn the_workload_principal_can_perform_no_operation_this_ensure_needs() -> Bool {
  !principal_admits_any_ensure_operation(principal: ensure_workload_principal())
}

test fn the_control_plane_principal_admits_every_operation_this_ensure_needs() -> Bool {
  principal_admits_every_ensure_operation(principal: ensure_control_plane_principal())
}

// The two checks above are only meaningful if the operation set is the real one. An empty list
// would satisfy "every" vacuously and "any" trivially, so the population is pinned.
test fn the_ensure_operation_set_is_exactly_the_two_policy_operations() -> Bool {
  let ops = spark_secret_access_ensure_operations()
  count(ops) == 2
}
