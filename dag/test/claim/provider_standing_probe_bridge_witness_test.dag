module test.claim.provider_standing_probe_bridge_witness


fn fixture_codex_provider_instance() -> extdeps.llm.cli_lifecycle.ProviderInstance {
  extdeps.llm.cli_lifecycle.ProviderInstance {
    kind: extdeps.llm.cli_lifecycle.CodexCliProvider,
    host: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
    executable: "codex" as std.types.NonEmptyStr,
    observed_version: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
    state_directory: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
    credential_storage_method: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
    service_identity: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
  }
}

fn witness_codex_bridge_successful_probe_observation() -> gunbc.provider_standing_probe_bridge.CodexProviderDashboardProbeObservation {
  gunbc.provider_standing_probe_bridge.CodexProviderDashboardProbeObservation {
    state_root: gunbc.provider_standing_probe_bridge.CodexStateRootPresent,
    runtime: gunbc.provider_standing_probe_bridge.ProviderDashboardExecProbeReported {
      succeeded: true,
      stdout: "codex-cli 0.145.0" as String,
      stderr: "" as String,
    },
    auth: gunbc.provider_standing_probe_bridge.ProviderDashboardExecProbeReported {
      succeeded: true,
      stdout: "" as String,
      stderr: "Logged in using ChatGPT" as String,
    },
  }
}

test fn witness_bridge_codex_successful_probes_map_authenticated_not_entitled() -> Bool {
  let bundle = gunbc.provider_standing_probe_bridge.provider_standing_bundle_from_codex_dashboard_probes(
    observation: witness_codex_bridge_successful_probe_observation(),
  )
  match bundle.authentication {
    gunbc.provider_standing.AuthenticationAuthenticated => true
    _ => false
  }
    && match bundle.entitlement {
      gunbc.provider_standing.EntitlementObservationUnobserved { reason } =>
        reason == gunbc.provider_standing_probe_bridge.provider_standing_probe_bridge_entitlement_unobserved_reason
      _ => false
    }
    && match v2.std.algebra.list_head(xs: bundle.limits) {
      v2.std.algebra.HeadFound { value: gunbc.provider_standing.LimitObservationUnobserved { reason } } =>
        reason == gunbc.provider_standing_probe_bridge.provider_standing_probe_bridge_limit_unobserved_reason
      v2.std.algebra.HeadAbsent => false
    }
}

test fn witness_bridge_codex_auth_failure_is_credentials_absent_not_authenticated() -> Bool {
  let bundle = gunbc.provider_standing_probe_bridge.provider_standing_bundle_from_codex_dashboard_probes(
    observation: gunbc.provider_standing_probe_bridge.CodexProviderDashboardProbeObservation {
      state_root: gunbc.provider_standing_probe_bridge.CodexStateRootPresent,
      runtime: gunbc.provider_standing_probe_bridge.ProviderDashboardExecProbeReported {
        succeeded: true,
        stdout: "codex-cli 0.145.0" as String,
        stderr: "" as String,
      },
      auth: gunbc.provider_standing_probe_bridge.ProviderDashboardExecProbeReported {
        succeeded: false,
        stdout: "" as String,
        stderr: "Not logged in" as String,
      },
    },
  )
  match bundle.authentication {
    gunbc.provider_standing.AuthenticationCredentialsAbsent => true
    gunbc.provider_standing.AuthenticationAuthenticated => false
    _ => false
  }
}

test fn witness_bridge_honest_limit_unobserved_blocks_even_when_authenticated() -> Bool {
  !gunbc.provider_standing.provider_standing_is_selection_eligible(
    standing: gunbc.provider_standing.provider_standing_from_observed_bundle(
      fact_id: gunbc.provider_standing.selection_fixture_standing_fact_id,
      provider: fixture_codex_provider_instance(),
      bundle: gunbc.provider_standing_probe_bridge.provider_standing_bundle_from_codex_dashboard_probes(
        observation: witness_codex_bridge_successful_probe_observation(),
      ),
    ),
    draw: gunbc.provider_standing.LimitDispatchDrawAutomatic,
  )
}

test fn witness_bridge_claude_control_probe_honest_installation_and_tool_unobserved() -> Bool {
  let bundle = gunbc.provider_standing_probe_bridge.provider_standing_bundle_from_claude_credential_control_probe(
    observation: gunbc.provider_standing_probe_bridge.ClaudeCredentialControlProbeObservation {
      token_source: "oauth" as std.types.NonEmptyStr,
      subscription_tier: "claude_max" as std.types.NonEmptyStr,
    },
  )
  match bundle.installation {
    gunbc.provider_standing.InstallationStandingUnobserved { reason } =>
      reason == gunbc.provider_standing_probe_bridge.provider_standing_probe_bridge_claude_installation_unobserved_reason
    gunbc.provider_standing.InstallationReady => false
    _ => false
  }
    && match bundle.tool_environment {
      gunbc.provider_standing.ToolEnvironmentStandingUnobserved { reason } =>
        reason == gunbc.provider_standing_probe_bridge.provider_standing_probe_bridge_claude_tool_environment_unobserved_reason
      gunbc.provider_standing.ToolEnvironmentReady => false
      _ => false
    }
    && match bundle.authentication {
      gunbc.provider_standing.AuthenticationAuthenticated => true
      _ => false
    }
}

test fn witness_bridge_profile_present_token_absent_refuses_through_mapper() -> Bool {
  let bundle = gunbc.provider_standing_probe_bridge.provider_standing_bundle_from_claude_credential_control_probe(
    observation: gunbc.provider_standing_probe_bridge.ClaudeCredentialControlProbeObservation {
      token_source: "none" as std.types.NonEmptyStr,
      subscription_tier: "claude_max" as std.types.NonEmptyStr,
    },
  )
  match bundle.authentication {
    gunbc.provider_standing.AuthenticationProfilePresentTokenAbsent {
      subscription_tier: tier,
      token_source: source,
    } => tier == ("claude_max" as std.types.NonEmptyStr) && source == ("none" as std.types.NonEmptyStr)
    gunbc.provider_standing.AuthenticationAuthenticated => false
    _ => false
  }
    && !gunbc.provider_standing.provider_standing_is_selection_eligible(
      standing: gunbc.provider_standing.provider_standing_from_observed_bundle(
        fact_id: gunbc.provider_standing.selection_fixture_standing_fact_id,
        provider: fixture_codex_provider_instance(),
        bundle: bundle,
      ),
      draw: gunbc.provider_standing.LimitDispatchDrawAutomatic,
    )
}

test fn witness_bridge_profile_present_token_absent_not_authenticated_arm() -> Bool {
  match gunbc.provider_standing_probe_bridge.provider_standing_bundle_from_claude_credential_control_probe(
    observation: gunbc.provider_standing_probe_bridge.ClaudeCredentialControlProbeObservation {
      token_source: "none" as std.types.NonEmptyStr,
      subscription_tier: "claude_max" as std.types.NonEmptyStr,
    },
  ).authentication {
    gunbc.provider_standing.AuthenticationProfilePresentTokenAbsent { subscription_tier: _, token_source: _ } => true
    gunbc.provider_standing.AuthenticationAuthenticated => false
    _ => false
  }
}

test fn witness_bridge_standing_is_from_fact_not_inventory_unobserved() -> Bool {
  match gunbc.provider_standing.provider_standing_from_observed_bundle(
    fact_id: gunbc.provider_standing.selection_fixture_standing_fact_id,
    provider: fixture_codex_provider_instance(),
    bundle: gunbc.provider_standing_probe_bridge.provider_standing_bundle_from_codex_dashboard_probes(
      observation: witness_codex_bridge_successful_probe_observation(),
    ),
  ) {
    gunbc.provider_standing.ProviderStandingFromFact { fact: _ } => true
    gunbc.provider_standing.ProviderStandingUnobserved { reason: _ } => false
    _ => false
  }
}

test fn provider_standing_probe_bridge_keystone_holds() -> Bool {
  witness_bridge_codex_successful_probes_map_authenticated_not_entitled()
    && witness_bridge_codex_auth_failure_is_credentials_absent_not_authenticated()
    && witness_bridge_honest_limit_unobserved_blocks_even_when_authenticated()
    && witness_bridge_claude_control_probe_honest_installation_and_tool_unobserved()
    && witness_bridge_profile_present_token_absent_refuses_through_mapper()
    && witness_bridge_profile_present_token_absent_not_authenticated_arm()
    && witness_bridge_standing_is_from_fact_not_inventory_unobserved()
    && witness_codex_bucket_projects_to_native_bucket_never_account_scope()
    && witness_exhausted_codex_allows_a_sibling_bucket_draw()
    && witness_capacity_unknown_is_not_capacity()
    && witness_no_buckets_is_a_located_unobserved_not_an_empty_list()
    && witness_undecoded_bucket_does_not_refuse_a_measured_sibling()
    && witness_undecoded_bucket_still_refuses_its_own_draw_and_unnamed_draws()
    && witness_credential_identity_tracks_the_observed_codex_home()
    && witness_pro_subscription_is_the_only_arm_that_entitles()
    && witness_upstream_unknown_plan_is_not_a_yes()
    && witness_stale_pin_is_unobserved_while_wrong_realm_is_rejected()
    && witness_absent_and_malformed_accounts_never_entitle()
    && witness_realm_decodes_from_the_captured_account_read_shape()
    && witness_chatgpt_account_without_plan_type_is_malformed_not_unnamed()
    && witness_reported_cause_and_reset_survive_the_projection()
    && witness_unreported_cause_is_not_the_bucket_id()
    && witness_deployed_profile_admits_exactly_the_observed_plan()
    && witness_unadmitted_plan_is_unobserved_but_wrong_realm_is_rejected()
    && witness_plans_added_after_the_pinned_runtime_read_as_stale_pin()
    && witness_credential_liveness_splits_from_realm()
}


data codex_press_limit_bridge_witness_note: String = "The sibling-bucket case is the whole point: an exhausted `codex` bucket and an available `codex_bengalfox` bucket must produce DIFFERENT verdicts under draws that name them. A projection that routed either through ProviderAccountLimit would collapse both to one account verdict and refuse — or admit — work for the wrong reason."

fn press_bucket_credential() -> gunbc.provider_standing.LimitCredentialLabel {
  gunbc.provider_standing.LimitCredentialLabel { label: "srv1-codex" as std.types.NonEmptyStr }
}

fn draw_on(native_key: std.types.NonEmptyStr) -> gunbc.provider_standing.ProviderLimitDispatchDraw {
  gunbc.provider_standing.LimitDispatchDrawNativeBucket {
    credential: press_bucket_credential(),
    native_key: native_key,
  }
}

fn exhausted_codex_bucket() -> gunbc.codex_app_server_press.CodexRateLimitBucketVerdict {
  gunbc.codex_app_server_press.CodexBucketUnavailableUntilReset {
    limit_id: "codex" as std.types.NonEmptyStr,
    reached_type: none,
    resets_at: none,
  }
}

fn available_bengalfox_bucket() -> gunbc.codex_app_server_press.CodexRateLimitBucketVerdict {
  gunbc.codex_app_server_press.CodexBucketCapacityAvailable { limit_id: "codex_bengalfox" as std.types.NonEmptyStr }
}

test fn witness_codex_bucket_projects_to_native_bucket_never_account_scope() -> Bool {
  let available = gunbc.provider_standing_probe_bridge.provider_limit_observation_from_codex_bucket(
    credential: press_bucket_credential(), verdict: available_bengalfox_bucket())
  let exhausted = gunbc.provider_standing_probe_bridge.provider_limit_observation_from_codex_bucket(
    credential: press_bucket_credential(), verdict: exhausted_codex_bucket())
  (match available {
    gunbc.provider_standing.LimitObservedAvailable { subject: s } =>
      match s {
        gunbc.provider_standing.ProviderNativeLimitBucket { credential: _, native_key: k } => k == "codex_bengalfox"
        _ => false
      }
    _ => false
  })
    && (match exhausted {
      gunbc.provider_standing.LimitUnavailableUntilReset { subject: s, cause: c, reset: _, reason: _ } =>
        (match c { gunbc.provider_standing.NativeCauseUnreported => true _ => false })
          && (match s {
            gunbc.provider_standing.ProviderNativeLimitBucket { credential: _, native_key: k } => k == "codex"
            gunbc.provider_standing.ProviderAccountLimit { credential: _ } => false
            _ => false
          })
      _ => false
    })
}

test fn witness_exhausted_codex_allows_a_sibling_bucket_draw() -> Bool {
  let observations = gunbc.provider_standing_probe_bridge.provider_limit_observations_from_codex_buckets(
    credential: press_bucket_credential(),
    buckets: [exhausted_codex_bucket(), available_bengalfox_bucket()],
  )
  !gunbc.provider_standing.limit_observations_are_selection_eligible(
    observations: observations, draw: draw_on(native_key: "codex" as std.types.NonEmptyStr))
    && gunbc.provider_standing.limit_observations_are_selection_eligible(
      observations: observations, draw: draw_on(native_key: "codex_bengalfox" as std.types.NonEmptyStr))
}

test fn witness_capacity_unknown_is_not_capacity() -> Bool {
  let unknown = gunbc.provider_standing_probe_bridge.provider_limit_observation_from_codex_bucket(
    credential: press_bucket_credential(),
    verdict: gunbc.codex_app_server_press.CodexBucketCapacityUnknown { limit_id: "codex" as std.types.NonEmptyStr })
  (match unknown {
    gunbc.provider_standing.LimitSubjectUnobserved { subject: s, native_token: _, reason: _ } =>
      match s {
        gunbc.provider_standing.ProviderNativeLimitBucket { credential: _, native_key: k } =>
          k == ("codex" as std.types.NonEmptyStr)
        _ => false
      }
    _ => false
  })
    && !gunbc.provider_standing.limit_observations_are_selection_eligible(
      observations: [unknown], draw: draw_on(native_key: "codex" as std.types.NonEmptyStr))
}

test fn witness_no_buckets_is_a_located_unobserved_not_an_empty_list() -> Bool {
  let observations = gunbc.provider_standing_probe_bridge.provider_limit_observations_from_codex_buckets(
    credential: press_bucket_credential(), buckets: [])
  observations.length() == 1
    && all(observations, o =>
      match o { gunbc.provider_standing.LimitObservationUnobserved { reason: _ } => true _ => false })
}

data mixed_decode_witness_note: String = "Over-refusal reads as caution while it prices out capacity the observation proved was there. The producer held the limit_id and threw it away; carrying it is the whole fix."

fn undecoded_codex_bucket() -> gunbc.codex_app_server_press.CodexRateLimitBucketVerdict {
  gunbc.codex_app_server_press.CodexBucketCapacityUnknown { limit_id: "codex" as std.types.NonEmptyStr }
}

fn mixed_decode_observations() -> List<gunbc.provider_standing.ProviderLimitObservation> {
  gunbc.provider_standing_probe_bridge.provider_limit_observations_from_codex_buckets(
    credential: press_bucket_credential(),
    buckets: [undecoded_codex_bucket(), available_bengalfox_bucket()],
  )
}

test fn witness_undecoded_bucket_does_not_refuse_a_measured_sibling() -> Bool {
  gunbc.provider_standing.limit_observations_are_selection_eligible(
    observations: mixed_decode_observations(),
    draw: draw_on(native_key: "codex_bengalfox" as std.types.NonEmptyStr))
}

test fn witness_undecoded_bucket_still_refuses_its_own_draw_and_unnamed_draws() -> Bool {
  let observations = mixed_decode_observations()
  let unknown = gunbc.provider_standing_probe_bridge.provider_limit_observation_from_codex_bucket(
    credential: press_bucket_credential(), verdict: undecoded_codex_bucket())
  !gunbc.provider_standing.limit_observations_are_selection_eligible(
    observations: observations, draw: draw_on(native_key: "codex" as std.types.NonEmptyStr))
    && !gunbc.provider_standing.limit_observations_are_selection_eligible(
      observations: observations, draw: gunbc.provider_standing.LimitDispatchDrawUnspecified)
    && !gunbc.provider_standing.limit_observations_are_selection_eligible(
      observations: observations, draw: gunbc.provider_standing.LimitDispatchDrawAutomatic)
    && (match unknown {
      gunbc.provider_standing.LimitSubjectUnobserved { subject: s, native_token: t, reason: _ } =>
        t == "codex"
          && (match s {
            gunbc.provider_standing.ProviderNativeLimitBucket { credential: _, native_key: k } => k == "codex"
            _ => false
          })
      _ => false
    })
}

test fn witness_credential_identity_tracks_the_observed_codex_home() -> Bool {
  let a = gunbc.provider_standing_probe_bridge.codex_press_credential_identity(
    credential: gunbc.codex_app_server_press.AmbientCodexCredentialContext { codex_home: "/srv/codex-a" as std.types.FilePath })
  let b = gunbc.provider_standing_probe_bridge.codex_press_credential_identity(
    credential: gunbc.codex_app_server_press.AmbientCodexCredentialContext { codex_home: "/srv/codex-b" as std.types.FilePath })
  (match a {
    gunbc.provider_standing.LimitCredentialLabel { label: la } =>
      match b {
        gunbc.provider_standing.LimitCredentialLabel { label: lb } => la != lb && la == "/srv/codex-a"
        _ => false
      }
    _ => false
  })
}


data entitlement_realm_witness_note: String = "THE TWO NEGATIVES ARE DIFFERENT NEGATIVES. A Bedrock account is REJECTED — read successfully, wrong realization, the answer is no. An unrecognized plan string is UNOBSERVED — upstream moved and our pin is stale, the answer is not yet. Both refuse dispatch today, which is exactly why a witness that only checked `not available` would pass while the model conflated them: the first is permanent until the credential changes, the second is repaired by updating a roster."

fn chatgpt_realm_on(plan_wire: String) -> gunbc.codex_app_server_press.CodexAccountRealm {
  match extdeps.languages.json.parse.parse_json(s: plan_wire) {
    Absent => gunbc.codex_app_server_press.CodexAccountRealmUnobserved { reason: "fixture did not parse" as std.types.NonEmptyStr }
    Present { value: v } => gunbc.codex_app_server_press.codex_account_realm_from_result(result: v)
  }
}

test fn witness_pro_subscription_is_the_only_arm_that_entitles() -> Bool {
  let entitled = gunbc.provider_standing_probe_bridge.provider_entitlement_from_codex_realm(
    realm: gunbc.codex_app_server_press.CodexChatgptRealm { plan: gunbc.codex_app_server_press.CodexPlanTypeObserved { plan: extdeps.llm.codex_app_server.CodexPlanPro } })
  let api_key = gunbc.provider_standing_probe_bridge.provider_entitlement_from_codex_realm(realm: gunbc.codex_app_server_press.CodexApiKeyRealm)
  let bedrock = gunbc.provider_standing_probe_bridge.provider_entitlement_from_codex_realm(realm: gunbc.codex_app_server_press.CodexAmazonBedrockRealm)
  (match entitled { gunbc.provider_standing.EntitlementObservedAvailable => true _ => false })
    && (match api_key { gunbc.provider_standing.EntitlementRejected { reason: _ } => true _ => false })
    && (match bedrock { gunbc.provider_standing.EntitlementRejected { reason: _ } => true _ => false })
}

test fn witness_upstream_unknown_plan_is_not_a_yes() -> Bool {
  let unknown = gunbc.provider_standing_probe_bridge.provider_entitlement_from_codex_realm(
    realm: gunbc.codex_app_server_press.CodexChatgptRealm { plan: gunbc.codex_app_server_press.CodexPlanTypeObserved { plan: extdeps.llm.codex_app_server.CodexPlanUnknown } })
  !gunbc.provider_standing_probe_bridge.codex_plan_is_entitling(plan: extdeps.llm.codex_app_server.CodexPlanUnknown)
    && (match unknown { gunbc.provider_standing.EntitlementObservationUnobserved { reason: _ } => true _ => false })
    && gunbc.provider_standing_probe_bridge.codex_plan_is_entitling(plan: extdeps.llm.codex_app_server.CodexPlanPro)
    && !gunbc.provider_standing_probe_bridge.codex_plan_is_entitling(plan: extdeps.llm.codex_app_server.CodexPlanFree)
}

test fn witness_deployed_profile_admits_exactly_the_observed_plan() -> Bool {
  codex_first_deployment_subscription_policy.admitted_plans.length() == 1
    && gunbc.provider_standing_probe_bridge.codex_plan_is_entitling(plan: extdeps.llm.codex_app_server.CodexPlanPro)
    && !gunbc.provider_standing_probe_bridge.codex_plan_is_entitling(plan: extdeps.llm.codex_app_server.CodexPlanEnterprise)
    && !gunbc.provider_standing_probe_bridge.codex_plan_is_entitling(plan: extdeps.llm.codex_app_server.CodexPlanTeam)
    && !gunbc.provider_standing_probe_bridge.codex_plan_is_entitling(plan: extdeps.llm.codex_app_server.CodexPlanPlus)
    && !gunbc.provider_standing_probe_bridge.codex_plan_is_entitling(plan: extdeps.llm.codex_app_server.CodexPlanFree)
    && !gunbc.provider_standing_probe_bridge.codex_plan_is_entitling(plan: extdeps.llm.codex_app_server.CodexPlanUnknown)
}

test fn witness_unadmitted_plan_is_unobserved_but_wrong_realm_is_rejected() -> Bool {
  let unadmitted = gunbc.provider_standing_probe_bridge.provider_entitlement_from_codex_realm(
    realm: gunbc.codex_app_server_press.CodexChatgptRealm { plan: gunbc.codex_app_server_press.CodexPlanTypeObserved { plan: extdeps.llm.codex_app_server.CodexPlanEnterprise } })
  let wrong_realm = gunbc.provider_standing_probe_bridge.provider_entitlement_from_codex_realm(realm: gunbc.codex_app_server_press.CodexApiKeyRealm)
  (match unadmitted { gunbc.provider_standing.EntitlementObservationUnobserved { reason: _ } => true _ => false })
    && (match wrong_realm { gunbc.provider_standing.EntitlementRejected { reason: _ } => true _ => false })
}

test fn witness_stale_pin_is_unobserved_while_wrong_realm_is_rejected() -> Bool {
  let stale_plan = gunbc.provider_standing_probe_bridge.provider_entitlement_from_codex_plan_reading(
    reading: gunbc.codex_app_server_press.CodexPlanTypeUnrecognized { native: "quantum_max" as std.types.NonEmptyStr })
  let stale_realm = gunbc.provider_standing_probe_bridge.provider_entitlement_from_codex_realm(
    realm: gunbc.codex_app_server_press.CodexAccountRealmUnrecognizedType { native: "azureEntra" as std.types.NonEmptyStr })
  let wrong_realm = gunbc.provider_standing_probe_bridge.provider_entitlement_from_codex_realm(realm: gunbc.codex_app_server_press.CodexAmazonBedrockRealm)
  (match stale_plan { gunbc.provider_standing.EntitlementObservationUnobserved { reason: _ } => true _ => false })
    && (match stale_realm { gunbc.provider_standing.EntitlementObservationUnobserved { reason: _ } => true _ => false })
    && (match wrong_realm { gunbc.provider_standing.EntitlementRejected { reason: _ } => true _ => false })
}

test fn witness_absent_and_malformed_accounts_never_entitle() -> Bool {
  let absent = gunbc.provider_standing_probe_bridge.provider_entitlement_from_codex_realm(realm: gunbc.codex_app_server_press.CodexAccountRealmAbsent)
  let malformed = gunbc.provider_standing_probe_bridge.provider_entitlement_from_codex_plan_reading(
    reading: gunbc.codex_app_server_press.CodexPlanTypeMalformed { cause: "no planType" as std.types.NonEmptyStr })
  (match absent { gunbc.provider_standing.EntitlementObservationUnobserved { reason: _ } => true _ => false })
    && (match malformed { gunbc.provider_standing.EntitlementObservationUnobserved { reason: _ } => true _ => false })
}

test fn witness_realm_decodes_from_the_captured_account_read_shape() -> Bool {
  let chatgpt = chatgpt_realm_on(
    plan_wire: "{\"account\":{\"type\":\"chatgpt\",\"planType\":\"pro\",\"email\":\"REDACTED@example.invalid\"},\"requiresOpenaiAuth\":true}")
  let api_key = chatgpt_realm_on(plan_wire: "{\"account\":{\"type\":\"apiKey\"}}")
  let null_account = chatgpt_realm_on(
    plan_wire: "{\"account\":null,\"requiresOpenaiAuth\":true}")
  (match chatgpt {
    gunbc.codex_app_server_press.CodexChatgptRealm { plan: gunbc.codex_app_server_press.CodexPlanTypeObserved { plan: extdeps.llm.codex_app_server.CodexPlanPro } } => true
    _ => false
  })
    && (match api_key { gunbc.codex_app_server_press.CodexApiKeyRealm => true _ => false })
    && (match null_account { gunbc.codex_app_server_press.CodexAccountRealmAbsent => true _ => false })
}

test fn witness_chatgpt_account_without_plan_type_is_malformed_not_unnamed() -> Bool {
  let no_plan = chatgpt_realm_on(plan_wire: "{\"account\":{\"type\":\"chatgpt\"}}")
  match no_plan {
    gunbc.codex_app_server_press.CodexChatgptRealm { plan: gunbc.codex_app_server_press.CodexPlanTypeMalformed { cause: _ } } => true
    _ => false
  }
}

data native_cause_fallback_witness_note: String = "THIS FILE USED TO ASSERT THE DEFECT. witness_codex_bucket_projects_to_native_bucket_never_account_scope checked `t == \"codex\"` against a fixture declaring `reached_type: none` — so the value it pinned was the projection substituting the bucket id for a cause the wire never gave. A green witness was holding the fallback in place as the contract, which is the shape DESIGN §5 names when a degradation gets enshrined by the test that was supposed to catch it.\n\nThe pair below is what the old fixture could not distinguish: one bucket reports a cause and a reset, one reports neither, and they must not project to the same thing."

fn exhausted_codex_bucket_with_reported_cause() -> gunbc.codex_app_server_press.CodexRateLimitBucketVerdict {
  gunbc.codex_app_server_press.CodexBucketUnavailableUntilReset {
    limit_id: "codex" as std.types.NonEmptyStr,
    reached_type: Present { value: "rate_limit_reached" as std.types.NonEmptyStr },
    resets_at: Present { value: 1786000000 },
  }
}

test fn witness_reported_cause_and_reset_survive_the_projection() -> Bool {
  let reported = gunbc.provider_standing_probe_bridge.provider_limit_observation_from_codex_bucket(
    credential: press_bucket_credential(),
    verdict: exhausted_codex_bucket_with_reported_cause())
  match reported {
    gunbc.provider_standing.LimitUnavailableUntilReset { subject: _, cause: c, reset: r, reason: _ } =>
      (match c {
        gunbc.provider_standing.NativeCauseReported { token: t } => t == ("rate_limit_reached" as std.types.NonEmptyStr)
        gunbc.provider_standing.NativeCauseUnreported => false
      })
        && (match r {
          gunbc.provider_standing.LimitResetAt { at: a } => a == 1786000000
          gunbc.provider_standing.LimitResetInstantUnobserved => false
        })
    _ => false
  }
}

test fn witness_unreported_cause_is_not_the_bucket_id() -> Bool {
  let silent = gunbc.provider_standing_probe_bridge.provider_limit_observation_from_codex_bucket(
    credential: press_bucket_credential(), verdict: exhausted_codex_bucket())
  let reported = gunbc.provider_standing_probe_bridge.provider_limit_observation_from_codex_bucket(
    credential: press_bucket_credential(),
    verdict: exhausted_codex_bucket_with_reported_cause())
  (match silent {
    gunbc.provider_standing.LimitUnavailableUntilReset { subject: _, cause: gunbc.provider_standing.NativeCauseUnreported, reset: gunbc.provider_standing.LimitResetInstantUnobserved, reason: _ } => true
    _ => false
  })
    && (match reported {
      gunbc.provider_standing.LimitUnavailableUntilReset { subject: _, cause: gunbc.provider_standing.NativeCauseUnreported, reset: _, reason: _ } => false
      gunbc.provider_standing.LimitUnavailableUntilReset { subject: _, cause: _, reset: _, reason: _ } => true
      _ => false
    })
}

test fn witness_plans_added_after_the_pinned_runtime_read_as_stale_pin() -> Bool {
  let later = chatgpt_realm_on(
    plan_wire: "{\"account\":{\"type\":\"chatgpt\",\"planType\":\"self_serve_business_prolite\"}}")
  let also_later = chatgpt_realm_on(
    plan_wire: "{\"account\":{\"type\":\"chatgpt\",\"planType\":\"enterprise_cbp_automation\"}}")
  let pinned = chatgpt_realm_on(
    plan_wire: "{\"account\":{\"type\":\"chatgpt\",\"planType\":\"enterprise_cbp_usage_based\"}}")
  (match later {
    gunbc.codex_app_server_press.CodexChatgptRealm { plan: gunbc.codex_app_server_press.CodexPlanTypeUnrecognized { native: n } } =>
      n == ("self_serve_business_prolite" as std.types.NonEmptyStr)
    _ => false
  })
    && (match also_later {
      gunbc.codex_app_server_press.CodexChatgptRealm { plan: gunbc.codex_app_server_press.CodexPlanTypeUnrecognized { native: _ } } => true
      _ => false
    })
    && (match pinned {
      gunbc.codex_app_server_press.CodexChatgptRealm { plan: gunbc.codex_app_server_press.CodexPlanTypeObserved { plan: _ } } => true
      _ => false
    })
}

test fn witness_credential_liveness_splits_from_realm() -> Bool {
  let live_auth = gunbc.provider_standing_probe_bridge.provider_authentication_from_codex_credential_liveness(
    liveness: gunbc.codex_app_server_press.CodexCredentialLive { bucket_count: 2 })
  let dead_auth = gunbc.provider_standing_probe_bridge.provider_authentication_from_codex_credential_liveness(
    liveness: gunbc.codex_app_server_press.CodexCredentialDead {
      reason: "account/rateLimits/read returned no decodable buckets" as std.types.NonEmptyStr,
    })
  let unobserved_auth = gunbc.provider_standing_probe_bridge.provider_authentication_from_codex_credential_liveness(
    liveness: gunbc.codex_app_server_press.CodexCredentialLivenessUnobserved {
      reason: "account/rateLimits/read probe did not complete" as std.types.NonEmptyStr,
    })
  let realm_still_pro = gunbc.provider_standing_probe_bridge.provider_entitlement_from_codex_realm(
    realm: gunbc.codex_app_server_press.CodexChatgptRealm { plan: gunbc.codex_app_server_press.CodexPlanTypeObserved { plan: extdeps.llm.codex_app_server.CodexPlanPro } })
  (match live_auth { gunbc.provider_standing.AuthenticationAuthenticated => true _ => false })
    && (match dead_auth { gunbc.provider_standing.AuthenticationRefreshFailed { reason: _ } => true _ => false })
    && (match unobserved_auth { gunbc.provider_standing.AuthenticationStandingUnobserved { reason: _ } => true _ => false })
    && (match realm_still_pro { gunbc.provider_standing.EntitlementObservedAvailable => true _ => false })
}
