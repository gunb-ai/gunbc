import extdeps.languages.yaml.types { kv, yaml_string }
import extdeps.github.actions { Job, Step, RunStep, UsesStep }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data revision_r: String = "4e6e066f88fcabe0058a683f9cb634de4f8abff3"
data revision_s: String = "7261964510969c72ab874e908e8cc3fc80b880aa"

// A binding as the runner supplies it inside one fleet-converge run, and the route admitted from
// it. Supplied, not observed: the route's inhabitance is the wet probe and the fleet run.
fn fleet_run_binding() -> ActionsRunBinding {
  ActionsRunBinding {
    repository: "gunb-ai/gunbc",
    workflow_ref: join(["gunb-ai/gunbc/", fleet_converge_workflow_file_path(), "@refs/heads/main"], ""),
    run_id: "35416075835",
    run_revision: revision_r,
  }
}

fn admitted_route() -> BuildDeliveryRoute {
  admit_build_delivery_route(
    binding: fleet_run_binding(),
    observed_job_id: ActionsVariablePresent { value: runner_slot_retire_job_id },
    workflow_path: fleet_converge_workflow_file_path(),
    consumer_job_id: runner_slot_retire_job_id,
  )
}

fn unestablished_route() -> BuildDeliveryRoute {
  DeliveryRouteUnestablished { cause: "GITHUB_WORKFLOW_REF not set; this process is not bound to a workflow run" }
}

// ── THE JOIN, AT ITS ONE INTERFACE: an expected revision and a reading of the running executable ──
//
// The reading is SUPPLIED, not observed: what the running interpreter reports is the subject of
// `observe_running_seed_identity`, whose inhabitance is the wet probe and the fleet route
// (gunbc.build_provenance_join build_provenance_probe_wet), and re-executing it here would make
// every claim below a claim about this harness's binary rather than about the fold.

// THE POSITIVE CONTROL: all three agree, and the join carries the revision it joined on.
test fn an_executable_built_from_the_selected_revision_joins() -> Bool {
  match join_build_provenance(
    expected: revision_r,
    reading: RunningSeedIdentityRead { identity: CliCleanSourceCommit { commit: revision_r as CommitSha } },
    route: admitted_route(),
  ) {
    BuildProvenanceJoined { revision: r, route: _ } => (r as String) == revision_r
    BuildProvenanceMismatch { expected: _, built_from: _ } => false
    BuildProvenanceDirty { built_from: _ } => false
    BuildProvenanceUnobserved { cause: _ } => false
    BuildProvenanceOriginUnestablished { reported: _, cause: _ } => false
  }
}

// THE DISCRIMINATING RED THE BRIEF NAMES: the checkout is R, the binary was built from S. The
// refusal carries both so the receipt can say which is which.
test fn an_executable_built_from_another_revision_refuses_with_both_named() -> Bool {
  match join_build_provenance(
    expected: revision_r,
    reading: RunningSeedIdentityRead { identity: CliCleanSourceCommit { commit: revision_s as CommitSha } },
    route: admitted_route(),
  ) {
    BuildProvenanceMismatch { expected: e, built_from: b } => (e as String) == revision_r && (b as String) == revision_s
    BuildProvenanceJoined { revision: _, route: _ } => false
    BuildProvenanceOriginUnestablished { reported: _, cause: _ } => false
    BuildProvenanceDirty { built_from: _ } => false
    BuildProvenanceUnobserved { cause: _ } => false
  }
}

// A DIRTY BUILD OF R IS NOT R. The same commit with the dirty observation flipped must not join;
// stripping the suffix to recover the commit would be the impersonation the render refuses.
test fn a_dirty_build_of_the_selected_revision_refuses() -> Bool {
  match join_build_provenance(
    expected: revision_r,
    reading: RunningSeedIdentityRead { identity: CliDirtySourceCommit { commit: revision_r as CommitSha } },
    route: admitted_route(),
  ) {
    BuildProvenanceDirty { built_from: b } => (b as String) == revision_r
    BuildProvenanceJoined { revision: _, route: _ } => false
    BuildProvenanceOriginUnestablished { reported: _, cause: _ } => false
    BuildProvenanceMismatch { expected: _, built_from: _ } => false
    BuildProvenanceUnobserved { cause: _ } => false
  }
}

// PROVENANCE UNREADABLE REFUSES AS UNOBSERVED, never as a pass and never as a mismatch.
test fn an_unreadable_identity_refuses_as_unobserved() -> Bool {
  match join_build_provenance(
    expected: revision_r,
    reading: RunningSeedIdentityUnreadable { cause: "the running gunbc did not report its version" },
    route: admitted_route(),
  ) {
    BuildProvenanceUnobserved { cause: _ } => true
    BuildProvenanceJoined { revision: _, route: _ } => false
    BuildProvenanceOriginUnestablished { reported: _, cause: _ } => false
    BuildProvenanceMismatch { expected: _, built_from: _ } => false
    BuildProvenanceDirty { built_from: _ } => false
  }
}

// ONLY THE JOINED ARM HOLDS -- the predicate the route consumes to decide whether a blocker exists.
test fn only_a_joined_provenance_holds() -> Bool {
  build_provenance_join_holds(
    verdict: join_build_provenance(
      expected: revision_r,
      reading: RunningSeedIdentityRead { identity: CliCleanSourceCommit { commit: revision_r as CommitSha } },
      route: admitted_route(),
    ),
  )
    && !build_provenance_join_holds(
      verdict: join_build_provenance(
        expected: revision_r,
        reading: RunningSeedIdentityRead { identity: CliCleanSourceCommit { commit: revision_s as CommitSha } },
        route: admitted_route(),
      ),
    )
    && !build_provenance_join_holds(
      verdict: join_build_provenance(
        expected: revision_r,
        reading: RunningSeedIdentityUnreadable { cause: "unread" },
        route: admitted_route(),
      ),
    )
}

// ── THE DELIVERY ROUTE: a matching self-report outside the admitted route is NOT a join ──────

// THE TRUST-BOUNDARY DISCRIMINATOR. The executable reports exactly R, and nothing else about it is
// known: refuse as origin-unestablished, carrying the reported commit, and never join.
test fn a_matching_report_outside_the_delivery_route_is_origin_unestablished() -> Bool {
  match join_build_provenance(
    expected: revision_r,
    reading: RunningSeedIdentityRead { identity: CliCleanSourceCommit { commit: revision_r as CommitSha } },
    route: unestablished_route(),
  ) {
    BuildProvenanceOriginUnestablished { reported: r, cause: _ } => (r as String) == revision_r
    BuildProvenanceJoined { revision: _, route: _ } => false
    BuildProvenanceMismatch { expected: _, built_from: _ } => false
    BuildProvenanceDirty { built_from: _ } => false
    BuildProvenanceUnobserved { cause: _ } => false
  }
}

// THE ROUTE IS NOT A SUBSTITUTE FOR THE REPORT EITHER: inside the route, a mismatch still refuses
// as a mismatch, so neither half can clear the other.
test fn a_mismatch_inside_the_delivery_route_still_refuses_as_a_mismatch() -> Bool {
  match join_build_provenance(
    expected: revision_r,
    reading: RunningSeedIdentityRead { identity: CliCleanSourceCommit { commit: revision_s as CommitSha } },
    route: admitted_route(),
  ) {
    BuildProvenanceMismatch { expected: _, built_from: _ } => true
    BuildProvenanceJoined { revision: _, route: _ } => false
    BuildProvenanceDirty { built_from: _ } => false
    BuildProvenanceUnobserved { cause: _ } => false
    BuildProvenanceOriginUnestablished { reported: _, cause: _ } => false
  }
}

// ROUTE ADMISSION AT ITS OWN INTERFACE: the run's workflow reference must name the fleet-converge
// file, and the runner's job id must be the job the model delivers release-bins to.
test fn a_run_of_another_workflow_file_does_not_establish_the_route() -> Bool {
  match admit_build_delivery_route(
    binding: ActionsRunBinding {
      repository: "gunb-ai/gunbc",
      workflow_ref: "gunb-ai/gunbc/.github/workflows/witnesses.yml@refs/heads/main",
      run_id: "1",
      run_revision: revision_r,
    },
    observed_job_id: ActionsVariablePresent { value: runner_slot_retire_job_id },
    workflow_path: fleet_converge_workflow_file_path(),
    consumer_job_id: runner_slot_retire_job_id,
  ) {
    DeliveryRouteUnestablished { cause: _ } => true
    DeliveredByRunBuildJob { workflow_path: _, job_id: _, run_id: _ } => false
  }
}

test fn another_job_of_the_same_run_does_not_establish_the_route() -> Bool {
  match admit_build_delivery_route(
    binding: fleet_run_binding(),
    observed_job_id: ActionsVariablePresent { value: "build" },
    workflow_path: fleet_converge_workflow_file_path(),
    consumer_job_id: runner_slot_retire_job_id,
  ) {
    DeliveryRouteUnestablished { cause: _ } => true
    DeliveredByRunBuildJob { workflow_path: _, job_id: _, run_id: _ } => false
  }
}

test fn an_absent_job_id_does_not_establish_the_route() -> Bool {
  match admit_build_delivery_route(
    binding: fleet_run_binding(),
    observed_job_id: ActionsVariableAbsent { variable: "GITHUB_JOB", detail: "not set" },
    workflow_path: fleet_converge_workflow_file_path(),
    consumer_job_id: runner_slot_retire_job_id,
  ) {
    DeliveryRouteUnestablished { cause: _ } => true
    DeliveredByRunBuildJob { workflow_path: _, job_id: _, run_id: _ } => false
  }
}

test fn the_retire_job_of_a_fleet_converge_run_establishes_the_route() -> Bool {
  match admitted_route() {
    DeliveredByRunBuildJob { workflow_path: w, job_id: j, run_id: r } =>
      w == fleet_converge_workflow_file_path() && j == runner_slot_retire_job_id && r == "35416075835"
    DeliveryRouteUnestablished { cause: _ } => false
  }
}

// ── THE MODEL BEHIND THE ROUTE, HELD TO WHAT THE ROUTE ASSUMES ───────────────────────────────
//
// The route admits "job J of workflow W" on the runner's word; what makes that an accepted
// build-and-delivery boundary is the MODEL of W (gunbc.fleet_converge_workflow), from which the
// YAML is projected. gunbc.fleet_workflow_steps release_bins_delivery_premise judges the handoff
// by what the steps DO -- the cited action, the artifact named, the verify script, no `if:`, no
// `continue-on-error:`, in order, behind a `needs:` -- never by a step's display name. The green
// runs it over the real jobs; every red below is a same-name mutation of the real consumer job
// that the premise must refuse.

fn retire_job_with_steps(steps: List<Step>) -> Job {
  let real = fleet_converge_runner_slot_retire_job()
  Job {
    id: real.id, name: real.name, runner: real.runner, steps: steps, needs: real.needs, env: real.env,
    outputs: real.outputs, if_condition: real.if_condition, timeout_minutes: real.timeout_minutes,
    continue_on_error: real.continue_on_error, concurrency: real.concurrency, permissions: real.permissions,
  }
}

fn retire_job_with_needs(needs: List<String>) -> Job {
  let real = fleet_converge_runner_slot_retire_job()
  Job {
    id: real.id, name: real.name, runner: real.runner, steps: real.steps, needs: needs, env: real.env,
    outputs: real.outputs, if_condition: real.if_condition, timeout_minutes: real.timeout_minutes,
    continue_on_error: real.continue_on_error, concurrency: real.concurrency, permissions: real.permissions,
  }
}

fn step_named(step: Step) -> String? {
  match step {
    RunStep { name: n, id: _, run: _, shell: _, env: _, working_directory: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } => n
    UsesStep { name: n, id: _, uses: _, with: _, env: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } => n
  }
}

// Replace the step whose name matches `victim`'s with `replacement`, keeping every other step and
// its position -- so the only thing a red changes is the behaviour behind one name.
fn with_step_replaced(steps: List<Step>, victim: Step, replacement: Step) -> List<Step> {
  steps |> map(s => if step_named(step: s) == step_named(step: victim) { replacement } else { s })
}

fn premise_refused(p: ReleaseBinsDeliveryPremise) -> Bool {
  match p {
    ReleaseBinsDeliveryRefused { cause: _ } => true
    ReleaseBinsDelivered { producer_job: _, consumer_job: _, consumer_step: _ } => false
  }
}

fn premise_over(consumer: Job) -> ReleaseBinsDeliveryPremise {
  release_bins_delivery_premise(
    producer: fleet_converge_build_job(),
    consumer: consumer,
    consumer_step_id: fleet_converge_runner_slot_retire_step_id,
  )
}

// THE GREEN: the real build job hands the real retire job the artifact, verified, before the
// assessment step, behind needs.
test fn the_workflow_model_delivers_release_bins_from_the_build_job_to_the_retire_job() -> Bool {
  match premise_over(consumer: fleet_converge_runner_slot_retire_job()) {
    ReleaseBinsDelivered { producer_job: p, consumer_job: c, consumer_step: s } =>
      p == fleet_converge_build_job().id && c == runner_slot_retire_job_id && s == fleet_converge_runner_slot_retire_step_id
    ReleaseBinsDeliveryRefused { cause: _ } => false
  }
}

// THE CRITICAL RED: the same name, the wrong behaviour. A RunStep called exactly what the
// download step is called, running `true`, delivers nothing and must refuse.
test fn a_same_name_step_that_does_not_download_refuses_the_premise() -> Bool {
  let impostor = RunStep {
    name: step_named(step: ci_release_bins_download_step()), id: none, run: "true", shell: none, env: none,
    working_directory: none, if_condition: none, continue_on_error: none, timeout_minutes: none,
  }
  premise_refused(p: premise_over(consumer: retire_job_with_steps(
    steps: with_step_replaced(steps: fleet_converge_runner_slot_retire_job().steps, victim: ci_release_bins_download_step(), replacement: impostor),
  )))
}

// ARTIFACT SELECTION: the download step, same action and name, naming a different artifact.
test fn a_download_of_a_different_artifact_refuses_the_premise() -> Bool {
  let other = UsesStep {
    name: step_named(step: ci_release_bins_download_step()), id: none, uses: download_artifact_action,
    with: Present { value: [kv(key: "name", value: yaml_string(s: "release-bins-from-somewhere-else"))] },
    env: none, if_condition: none, continue_on_error: none, timeout_minutes: none,
  }
  premise_refused(p: premise_over(consumer: retire_job_with_steps(
    steps: with_step_replaced(steps: fleet_converge_runner_slot_retire_job().steps, victim: ci_release_bins_download_step(), replacement: other),
  )))
}

// VERIFY AS A NO-OP: same name and id as the unpack + verify step, running something else.
test fn a_same_name_verify_step_running_something_else_refuses_the_premise() -> Bool {
  let noop = RunStep {
    name: step_named(step: ci_release_bins_unpack_verify_step()), id: Present { value: "release_bins" }, run: "true",
    shell: none, env: none, working_directory: none, if_condition: none, continue_on_error: none, timeout_minutes: none,
  }
  premise_refused(p: premise_over(consumer: retire_job_with_steps(
    steps: with_step_replaced(steps: fleet_converge_runner_slot_retire_job().steps, victim: ci_release_bins_unpack_verify_step(), replacement: noop),
  )))
}

// A SKIPPABLE PREREQUISITE: the real download step, made conditional.
test fn a_conditional_download_refuses_the_premise() -> Bool {
  let skippable = UsesStep {
    name: step_named(step: ci_release_bins_download_step()), id: none, uses: download_artifact_action,
    with: Present { value: [kv(key: "name", value: yaml_string(s: ci_release_bins_artifact_name))] },
    env: none, if_condition: Present { value: "false" }, continue_on_error: none, timeout_minutes: none,
  }
  premise_refused(p: premise_over(consumer: retire_job_with_steps(
    steps: with_step_replaced(steps: fleet_converge_runner_slot_retire_job().steps, victim: ci_release_bins_download_step(), replacement: skippable),
  )))
}

// A MISORDERED PREREQUISITE: the download and verify steps moved AFTER the assessment step.
test fn a_download_after_the_consumer_refuses_the_premise() -> Bool {
  let real = fleet_converge_runner_slot_retire_job().steps
  let without = real |> filter(s => step_named(step: s) != step_named(step: ci_release_bins_download_step()) && step_named(step: s) != step_named(step: ci_release_bins_unpack_verify_step()))
  premise_refused(p: premise_over(consumer: retire_job_with_steps(
    steps: concat(without, [ci_release_bins_download_step(), ci_release_bins_unpack_verify_step()]),
  )))
}

// NO `needs:`: the download would race the upload.
test fn a_consumer_that_does_not_need_the_producer_refuses_the_premise() -> Bool {
  premise_refused(p: premise_over(consumer: retire_job_with_needs(needs: [])))
}

// THE PRODUCER SIDE: a build job whose upload step is a same-name no-op.
test fn a_producer_whose_upload_is_a_same_name_noop_refuses_the_premise() -> Bool {
  let real = fleet_converge_build_job()
  let impostor = RunStep {
    name: step_named(step: ci_release_bins_upload_step()), id: none, run: "true", shell: none, env: none,
    working_directory: none, if_condition: none, continue_on_error: none, timeout_minutes: none,
  }
  let producer = Job {
    id: real.id, name: real.name, runner: real.runner,
    steps: with_step_replaced(steps: real.steps, victim: ci_release_bins_upload_step(), replacement: impostor),
    needs: real.needs, env: real.env, outputs: real.outputs, if_condition: real.if_condition,
    timeout_minutes: real.timeout_minutes, continue_on_error: real.continue_on_error, concurrency: real.concurrency, permissions: real.permissions,
  }
  premise_refused(p: release_bins_delivery_premise(
    producer: producer, consumer: fleet_converge_runner_slot_retire_job(), consumer_step_id: fleet_converge_runner_slot_retire_step_id,
  ))
}

// The build job is not itself a consumer: the premise refuses it as a consumer of its own upload.
test fn the_build_job_is_not_itself_a_release_bins_consumer() -> Bool {
  premise_refused(p: release_bins_delivery_premise(
    producer: fleet_converge_build_job(), consumer: fleet_converge_build_job(), consumer_step_id: fleet_converge_runner_slot_retire_step_id,
  ))
}

// ── THE REPOSITORY IS BOUND FROM ITS AUTHORITY, NOT FROM THE BINDING ─────────────────────────

test fn a_run_of_another_repository_with_the_same_file_and_job_does_not_establish_the_route() -> Bool {
  match admit_build_delivery_route(
    binding: ActionsRunBinding {
      repository: "someone-else/gunbc",
      workflow_ref: join(["someone-else/gunbc/", fleet_converge_workflow_file_path(), "@refs/heads/main"], ""),
      run_id: "1",
      run_revision: revision_r,
    },
    observed_job_id: ActionsVariablePresent { value: runner_slot_retire_job_id },
    workflow_path: fleet_converge_workflow_file_path(),
    consumer_job_id: runner_slot_retire_job_id,
  ) {
    DeliveryRouteUnestablished { cause: _ } => true
    DeliveredByRunBuildJob { workflow_path: _, job_id: _, run_id: _ } => false
  }
}

// ── THE VERSION LINE, READ BACK THROUGH THE GRAMMAR THAT RENDERED IT ─────────────────────────

// ROUND TRIP: what `gunbc_cli_version_text` renders, prefixed by the binary name as clap prints
// it, parses back to the identity it was rendered from -- clean and dirty alike.
test fn a_rendered_version_line_parses_back_to_its_identity() -> Bool {
  let clean = gunbc_cli_version_identity(source_commit: revision_r as CommitSha, source_dirty: false)
  let dirty = gunbc_cli_version_identity(source_commit: revision_r as CommitSha, source_dirty: true)
  let clean_back = match gunbc_cli_version_line_parse(line: join(["gunbc ", gunbc_cli_version_text(identity: clean), "\n"], "")) {
    CliVersionLineParsed { identity: i } =>
      match i {
        CliCleanSourceCommit { commit: c } => (c as String) == revision_r
        CliDirtySourceCommit { commit: _ } => false
      }
    CliVersionLineRefused { cause: _ } => false
  }
  let dirty_back = match gunbc_cli_version_line_parse(line: join(["gunbc ", gunbc_cli_version_text(identity: dirty)], "")) {
    CliVersionLineParsed { identity: i } =>
      match i {
        CliDirtySourceCommit { commit: c } => (c as String) == revision_r
        CliCleanSourceCommit { commit: _ } => false
      }
    CliVersionLineRefused { cause: _ } => false
  }
  clean_back && dirty_back
}

// A MATERIALIZED-TREE IDENTITY (the devboot producer's spelling) is refused rather than read as a
// commit: a tree object names no revision this join could compare against.
test fn a_materialized_tree_identity_is_refused_not_admitted_as_a_commit() -> Bool {
  match gunbc_cli_version_line_parse(line: "gunbc tree:sha1:4e6e066f88fcabe0058a683f9cb634de4f8abff3") {
    CliVersionLineRefused { cause: _ } => true
    CliVersionLineParsed { identity: _ } => false
  }
}

// ANOTHER PROGRAM'S VERSION LINE IS REFUSED: the parse asserts the binary name, so a line printed
// by something that is not gunbc cannot supply gunbc's identity.
test fn another_programs_version_line_is_refused() -> Bool {
  match gunbc_cli_version_line_parse(line: "rustc 1.90.0") {
    CliVersionLineRefused { cause: _ } => true
    CliVersionLineParsed { identity: _ } => false
  }
}

// AN EMPTY OR MALFORMED LINE IS REFUSED, which is what an operation whose process printed nothing
// produces, and which must reach the join as unobserved rather than as any identity.
test fn an_empty_version_line_is_refused() -> Bool {
  match gunbc_cli_version_line_parse(line: "") {
    CliVersionLineRefused { cause: _ } => true
    CliVersionLineParsed { identity: _ } => false
  }
}
