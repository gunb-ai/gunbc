module test.claim.optional_equality_by_representation

import v2.std.live_tree { LiveTreeDisposition }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

type ObrKind = ObrFirst | ObrSecond

data obr_kinds: List<ObrKind> = [ObrFirst, ObrSecond]

// The RED specimen (`obr_kinds.first() == Present { value: ObrFirst }`, false by representation) is no
// longer executable: gunbc.compile EqualityAgainstPresentOnListRead refuses that spelling at check time
// (src/v1/04_infer.dag equality_operand_list_read_name), so it is held by the check-time controls in
// test.claim.self_host_equality_admission_witness (DESIGN 4b(4): the discriminating RED stays enrolled,
// there as a refusal control). An enrolled expected-red must reach its subject and answer, which a
// refused program cannot.

// POSITIVE CONTROL: the same read on the same list, eliminated by a match, answers by value.
test fn a_match_on_the_present_first_reads_its_value() -> Bool {
  match obr_kinds.first() {
    Present { value: ObrFirst } => true
    _ => false
  }
}
