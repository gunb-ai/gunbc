module test.claim.witness_purpose_taxonomy_witness


data witness_purpose_taxonomy_witness_note: String = "Slice C-a: stable WitnessPurpose vocabulary only — BehavioralDiscriminator, BoundaryCrossing, PopulationTotality, ExternalFidelity, ResourceContract. TerminatingOneShot is NOT a WitnessPurpose arm; TerminatingOneShotFrontier records honest deferral (deadline and completion substrates absent) until typed carriers land. No placement, envelope, or cadence logic — those are C-b/C-c slices."

fn fixture_subject_hash() -> std.content_hash.ContentHash {
  std.content_hash.Fnv1a64(
    std.content_hash.structural_content_hash(digest: "deadbeefdeadbeef" as std.content_hash.Fnv1a64StructuralDigestHex)
  )
}

fn fixture_population_ref() -> std.decl_ref.DeclarationRef {
  std.decl_ref.decl_ref(
    module_path: "dag.test.claim.witness_purpose_taxonomy_witness",
    decl_name: "witness_purpose_taxonomy_witness_note",
  )
}

test fn behavioral_discriminator_is_stable_purpose_arm() -> Bool {
  let purpose = std.witness_purpose.BehavioralDiscriminator
  match purpose {
    std.witness_purpose.BehavioralDiscriminator => true
    std.witness_purpose.BoundaryCrossing { modeled_boundary: _, chosen_input: _ } => false
    std.witness_purpose.PopulationTotality { population: _ } => false
    std.witness_purpose.ExternalFidelity { effect: _ } => false
    std.witness_purpose.ResourceContract { bound: _ } => false
  }
}

test fn boundary_crossing_carries_modeled_boundary_and_chosen_input() -> Bool {
  let purpose = std.witness_purpose.BoundaryCrossing {
    modeled_boundary: fixture_population_ref(),
    chosen_input: fixture_subject_hash(),
  }
  match purpose {
    std.witness_purpose.BoundaryCrossing { modeled_boundary: boundary, chosen_input: hash } =>
      boundary == fixture_population_ref()
        && hash == fixture_subject_hash()
    std.witness_purpose.BehavioralDiscriminator => false
    std.witness_purpose.PopulationTotality { population: _ } => false
    std.witness_purpose.ExternalFidelity { effect: _ } => false
    std.witness_purpose.ResourceContract { bound: _ } => false
  }
}

test fn population_totality_carries_population_ref() -> Bool {
  let purpose = std.witness_purpose.PopulationTotality { population: fixture_population_ref() }
  match purpose {
    std.witness_purpose.PopulationTotality { population: population } =>
      population == fixture_population_ref()
    std.witness_purpose.BehavioralDiscriminator => false
    std.witness_purpose.BoundaryCrossing { modeled_boundary: _, chosen_input: _ } => false
    std.witness_purpose.ExternalFidelity { effect: _ } => false
    std.witness_purpose.ResourceContract { bound: _ } => false
  }
}

test fn external_fidelity_carries_effect_ref() -> Bool {
  let purpose = std.witness_purpose.ExternalFidelity { effect: fixture_population_ref() }
  match purpose {
    std.witness_purpose.ExternalFidelity { effect: effect } => effect == fixture_population_ref()
    std.witness_purpose.BehavioralDiscriminator => false
    std.witness_purpose.BoundaryCrossing { modeled_boundary: _, chosen_input: _ } => false
    std.witness_purpose.PopulationTotality { population: _ } => false
    std.witness_purpose.ResourceContract { bound: _ } => false
  }
}

test fn resource_contract_wall_bound_is_millisecond() -> Bool {
  let purpose = std.witness_purpose.ResourceContract {
    bound: std.witness_purpose.EvalWallTimeBound { bound: std.measure.millisecond(count: 500) },
  }
  match purpose {
    std.witness_purpose.ResourceContract { bound: bound } =>
      match bound {
        std.witness_purpose.EvalWallTimeBound { bound: ms } => std.measure.millisecond_count(m: ms) == 500
        std.witness_purpose.EvalThreadCpuBound { bound: _ } => false
        std.witness_purpose.PeakMemoryBound { bound: _ } => false
      }
    std.witness_purpose.BehavioralDiscriminator => false
    std.witness_purpose.BoundaryCrossing { modeled_boundary: _, chosen_input: _ } => false
    std.witness_purpose.PopulationTotality { population: _ } => false
    std.witness_purpose.ExternalFidelity { effect: _ } => false
  }
}

test fn resource_contract_peak_memory_bound_is_byte_size() -> Bool {
  let purpose = std.witness_purpose.ResourceContract {
    bound: std.witness_purpose.PeakMemoryBound { bound: std.measure.byte_size(count: 1073741824) },
  }
  match purpose {
    std.witness_purpose.ResourceContract { bound: bound } =>
      match bound {
        std.witness_purpose.PeakMemoryBound { bound: bytes } => std.measure.byte_size_count(b: bytes) == 1073741824
        std.witness_purpose.EvalWallTimeBound { bound: _ } => false
        std.witness_purpose.EvalThreadCpuBound { bound: _ } => false
      }
    std.witness_purpose.BehavioralDiscriminator => false
    std.witness_purpose.BoundaryCrossing { modeled_boundary: _, chosen_input: _ } => false
    std.witness_purpose.PopulationTotality { population: _ } => false
    std.witness_purpose.ExternalFidelity { effect: _ } => false
  }
}

test fn terminating_one_shot_unavailable_records_deadline_substrate_absent() -> Bool {
  let frontier = std.witness_purpose.TerminatingOneShotUnavailableDeadlineSubstrateAbsent
  match frontier {
    std.witness_purpose.TerminatingOneShotUnavailableDeadlineSubstrateAbsent => true
    std.witness_purpose.TerminatingOneShotUnavailableCompletionSubstrateAbsent => false
  }
}

test fn witness_purpose_has_five_stable_arms_only() -> Bool {
  let purposes = [
    std.witness_purpose.BehavioralDiscriminator,
    std.witness_purpose.BoundaryCrossing {
      modeled_boundary: fixture_population_ref(),
      chosen_input: fixture_subject_hash(),
    },
    std.witness_purpose.PopulationTotality { population: fixture_population_ref() },
    std.witness_purpose.ExternalFidelity { effect: fixture_population_ref() },
    std.witness_purpose.ResourceContract {
      bound: std.witness_purpose.EvalThreadCpuBound { bound: std.measure.millisecond(count: 1) },
    },
  ]
  length(xs: purposes) == 5
}
