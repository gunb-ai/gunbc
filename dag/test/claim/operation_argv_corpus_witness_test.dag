module test.claim.operation_argv_corpus_witness

import std.types { String, List, Bool, Int }
import v2.std.algebra { fold_list, any, length, list_head, HeadFound, HeadAbsent }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import v2.std.operation_argv {
  ArgvMaterialization,
  ArgvMaterialized,
  ArgvMaterializationRefused,
  ArgvRowClassification,
  ArgvRowMaterialized,
  ArgvRowExpressionResidue,
  ArgvRowExecutablePositionRefused,
  ArgvRowOtherRefusal,
  ShellTransportOperationRow,
  operation_argv_bind_text,
  operation_argv_classify,
  operation_argv_refusal_label,
  operation_argv_row_bindings,
}

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// The RED corpus for argv materializer route (b), DERIVED rather than rostered:
// shell_transport_operation_rows() enumerates every shell-transport operation declared under dag/
// and src/v2/ from the declarations themselves, so a newly authored operation enrolls by existing
// and coverage is a corpus fact rather than a claim (DESIGN 3 and 6 -- a hand roster would be the
// parallel-ledger form of exactly this fact). Each row is bound GENERICALLY: every input the
// operation declares, and nothing else. Row cardinality is the live enumerator
// (shell_transport_operation_rows / ArgvCorpusTally.rows), not a number copied into this note.
// An earlier authoring-time transcription of 141 rows is withdrawn: it was a snapshot, not an
// authority, and it drifted from the enumerator on the same witness (DESIGN 6: name the
// instrument, never transcribe its output).
// Pins below are the executing floor (non-vacuous lower bound, residue count, unexplained == 0),
// not a restated census total. The expression_residue pin is ArgvRowExpressionResidue only.
// Materialization also refuses composed argv (calls and coproduct helpers) on operations that
// this pin does not name; git.Plumbing.ReadTreeIntoIndex is the exemplar. Do not read the residue
// pin as the set of operations whose argv is too composed to compare.
// Argv-list identity cannot be walled as its own merge-blocking witness identity UNDER
// THE CURRENT COST MODEL, in which every claim identity pays its own full-corpus
// rematerialization. DESIGN 4b next-rung, measured: witness_duplicate_authority_pairs_are_well_formed
// hit changed-witness interrupted_before_verdict against the required-floor claim CPU
// deadline (required_floor_claim_cpu_safety_limit_ms). The obstacle is that second
// rematerialization against that deadline, not the analysis and not the absence of a check.
// Sampling is not a wall. A count or closed roster over pairs is the absorbing fallback.
// Cite claim_batch's [witness] cpu= line against that deadline function; do not copy
// milliseconds into this note. A declaration-only fold over the same enumerator (output
// from-keys, no argv expansion) has been observed under the deadline as its own claim
// identity; that is a different class and does not retire this rung.
// Next-rung trigger (the capability, not an artifact): materialization results shared
// across claim identities, or an argv identity derivable without rematerializing. Either
// makes the wall affordable; writing another witness does not.
// E0S0 is not a defect class. No stdout product plus branchable failure (exit_code,
// stderr) is a legitimate contract; git.Plumbing is the exemplar. Reading the A0B0C0
// empty E0S0 cell as corpus-wide emptiness treats a slice as the table. Browser effect
// operations with output {} (Close, Click, Fill, UploadFile, Screenshot, Wait) are a
// finding for that upstream, not a floor witness.
// A Hamming-1 relation (same program and flags; one position a declaration literal vs a
// generic bound-slot) would catch the class this join cannot see: an operation that bakes
// its parameter in as a literal never shares an argv with the general operation it
// duplicates, so the identity join reports a LOWER BOUND and is blind in the direction of
// the worst offenders -- the more policy an operation hardcodes, the less likely it is to
// join. It is a second named relation, not list identity, not "same policy" (undecidable),
// and was not built. The specimen that motivated it was deleted rather than repaired: it
// had no consumer, so deletion cost nothing the relation would have protected. That
// disposition is why the relation stays unbuilt AND why its absence is not evidence the
// class is empty -- the census found this one by reading the module, not by joining.
// The relation remains blind on composed argv regardless.

data operation_argv_expression_residue_note: String = "The residue is a DEFICIT HELD CONSTANT, not a regression: 7 operations carry an argv element that is a call or a field access, which materialization does not evaluate. Established by execution against the OLD builtin before this change -- all 7 refused there too (4 with `unsupported expr`, 3 with `unbound param` reached first), so no operation that materialized before refuses now. What changed is the shape of the refusal: an untyped host error string became a typed, located, counted ArgvExpressionUnsupported. The count is pinned so the deficit can only shrink deliberately; the operations are git.Core.DiffUnified0, git.Core.DiffNameStatus, http.Client.GetLocalhostBounded, sudo.NopasswdExecuteProbe.Check, gunbc.Cli.Run, claim_executor.Executor.RunPlan and claim_executor.Executor.VerifyBuildArtifacts. Dissolves when argv element evaluation lands, which is a separate lane."

data operation_argv_legacy_vocabulary: List<String> = ["package", "bin", "args", "unit", "property"]

data operation_argv_fixture_path: String = "dag/test/fixture/argv_executable_position_probe.dag"

type ArgvCorpusTally {
  rows: Int
  materialized: Int
  expression_residue: Int
  executable_position: Int
  executable_position_outside_fixture: Int
  unexplained: Int
  outside_legacy: Int
  outside_legacy_materialized: Int
}

data operation_argv_empty_tally: ArgvCorpusTally = ArgvCorpusTally {
  rows: 0,
  materialized: 0,
  expression_residue: 0,
  executable_position: 0,
  executable_position_outside_fixture: 0,
  unexplained: 0,
  outside_legacy: 0,
  outside_legacy_materialized: 0
}

fn operation_argv_flag(b: Bool) -> Int {
  if b { 1 } else { 0 }
}

fn operation_argv_name_is_legacy_vocabulary(name: String) -> Bool {
  any(xs: operation_argv_legacy_vocabulary, predicate: fn(v) { v == name })
}

fn operation_argv_row_is_outside_legacy_vocabulary(row: ShellTransportOperationRow) -> Bool {
  any(
    xs: row.argv_input_refs,
    predicate: fn(n) { !operation_argv_name_is_legacy_vocabulary(name: n) }
  )
}

fn operation_argv_row_materialization(row: ShellTransportOperationRow) -> ArgvMaterialization {
  shell_materialize_operation_argv(
    row.at.path,
    row.at.service,
    row.at.operation,
    operation_argv_row_bindings(row: row)
  )
}

fn operation_argv_tally_row(acc: ArgvCorpusTally, row: ShellTransportOperationRow) -> ArgvCorpusTally {
  let classification = operation_argv_classify(m: operation_argv_row_materialization(row: row))
  let materialized = match classification { ArgvRowMaterialized => true, ArgvRowExpressionResidue => false, ArgvRowExecutablePositionRefused => false, ArgvRowOtherRefusal => false }
  let residue = match classification { ArgvRowMaterialized => false, ArgvRowExpressionResidue => true, ArgvRowExecutablePositionRefused => false, ArgvRowOtherRefusal => false }
  let exec_position = match classification { ArgvRowMaterialized => false, ArgvRowExpressionResidue => false, ArgvRowExecutablePositionRefused => true, ArgvRowOtherRefusal => false }
  let unexplained = match classification { ArgvRowMaterialized => false, ArgvRowExpressionResidue => false, ArgvRowExecutablePositionRefused => false, ArgvRowOtherRefusal => true }
  let outside = operation_argv_row_is_outside_legacy_vocabulary(row: row)
  let exec_outside_fixture = exec_position && (row.at.path != operation_argv_fixture_path)
  ArgvCorpusTally {
    rows: acc.rows + 1,
    materialized: acc.materialized + operation_argv_flag(b: materialized),
    expression_residue: acc.expression_residue + operation_argv_flag(b: residue),
    executable_position: acc.executable_position + operation_argv_flag(b: exec_position),
    executable_position_outside_fixture: acc.executable_position_outside_fixture + operation_argv_flag(b: exec_outside_fixture),
    unexplained: acc.unexplained + operation_argv_flag(b: unexplained),
    outside_legacy: acc.outside_legacy + operation_argv_flag(b: outside),
    outside_legacy_materialized: acc.outside_legacy_materialized + operation_argv_flag(b: outside && materialized)
  }
}

fn operation_argv_corpus_tally() -> ArgvCorpusTally {
  fold_list(
    xs: shell_transport_operation_rows(),
    empty: operation_argv_empty_tally,
    cons: fn(acc, row) { operation_argv_tally_row(acc: acc, row: row) }
  )
}

test fn operation_argv_corpus_is_non_vacuous() -> Bool {
  operation_argv_corpus_tally().rows >= 139
}

test fn operation_argv_corpus_every_row_is_materialized_or_counted() -> Bool {
  operation_argv_corpus_tally().unexplained == 0
}

test fn operation_argv_corpus_tally_is_total() -> Bool {
  let t = operation_argv_corpus_tally()
  (t.materialized + t.expression_residue + t.executable_position) == t.rows
}

// 7 -> 8: `shell.Exec.Check` joined the residue when `TransportScript` became a sole_constructor
// record. Its argv element went from `{command}` — a bound name the materializer resolves — to
// `{command.body}`, a field access, which materialization refuses as ArgvExpressionUnsupported.
// That is a real, counted increment on a ratchet whose direction is down, and it is recorded here
// rather than absorbed: the alternative shapes were widening Check's input back to a bare String
// (deleting the construction wall to satisfy a census, which DESIGN forbids outright) or asserting
// a smaller number than the corpus contains. The live path is unaffected — Check executes through
// the interpreter's dispatch_shell, which evaluates argv expressions, and that is the path the
// wall's transport witness exercises. Returns to 7 on the same trigger the residue note already
// names: argv element evaluation in materialization, a separate lane.
test fn operation_argv_corpus_expression_residue_is_pinned() -> Bool {
  operation_argv_corpus_tally().expression_residue == 8
}

test fn operation_argv_corpus_executable_position_wall_fires_on_the_fixture_only() -> Bool {
  let t = operation_argv_corpus_tally()
  t.executable_position == 1 && t.executable_position_outside_fixture == 0
}

test fn operation_argv_corpus_outside_legacy_vocabulary_now_materializes() -> Bool {
  operation_argv_corpus_tally().outside_legacy_materialized >= 92
}

test fn operation_argv_corpus_outside_legacy_vocabulary_is_the_majority() -> Bool {
  let t = operation_argv_corpus_tally()
  t.outside_legacy >= 96 && (t.outside_legacy + t.outside_legacy) > t.rows
}

test fn operation_argv_corpus_RED_smuggled_executable_is_refused_and_located() -> Bool {
  let label = operation_argv_refusal_label(
    m: shell_materialize_operation_argv(
      operation_argv_fixture_path,
      "ArgvExecutablePositionProbe",
      "SmuggleExecutable",
      [operation_argv_bind_text(name: "bin", text: "/usr/bin/curl")]
    )
  )
  string_contains(label, "ExecutablePositionNotLiteral") && string_contains(label, "ArgvExecutablePositionProbe.SmuggleExecutable")
}

test fn operation_argv_corpus_RED_literal_executable_control_materializes() -> Bool {
  match shell_materialize_operation_argv(
    operation_argv_fixture_path,
    "ArgvExecutablePositionProbe",
    "LiteralExecutable",
    [operation_argv_bind_text(name: "flag", text: "--version")]
  ) {
    ArgvMaterialized { argv: argv } =>
      length(xs: argv) == 2
        && match list_head(xs: argv) {
          HeadFound { value: head } => head == "true"
          HeadAbsent => false
        }
    ArgvMaterializationRefused { at: _, cause: _ } => false
  }
}
