module test.claim.guarantee_probe_corpus_witness_test

import gunbc.guarantee_probe_corpus {
  guarantee_probe_corpus_charter_note,
  v1_compile_rust_path_id,
  v2_infer_eval_path_id,
  v2_infer_translate_path_id,
  guarantee_probe_paths,
  guarantee_probe_class_ids,
  guarantee_probe_ids,
  call_label_surplus_class,
  method_established_surface_class,
  declared_conformance_ground_class,
  v2_self_grounding_frontier_class,
  v2_translate_underived_refusal_class,
  call_mislabel_red_probe,
  call_surplus_red_probe,
  call_shape_green_probe,
  method_missing_red_probe,
  method_green_probe,
  conformance_scalar_red_probe,
  conformance_green_probe,
  v2_frontier_red_probe,
  v2_frontier_green_probe,
  v2_translate_underived_red_probe,
  v2_translate_underived_green_probe,
  ProbeExpectation,
  ExpectBlockingRefusal,
  ExpectZeroDiagnostics,
  probe_expectation_holds,
  probe_observation_from_census,
  observation_is_blocking_refusal,
  observation_is_clean,
  observation_refused_count,
  build_v1_compile_receipt,
  receipt_joins_v1_compile_path,
  census_blocking_count_for_class,
  census_any_count_for_class,
  probe_ids_match_canonical_order,
}
import gunbc.guarantee_measurement {
  observed_is_verdict,
  guarantee_class_ids_unique, guarantee_path_ids_unique,
  probe_set_digest,
}
import gunbc.compile_diagnostic_census {
  CompileDiagnosticCensus,
  CensusObserved,
  CensusNotRunnable,
  census_blocking_rows,
  census_rows_of_class,
  census_total_count,
}
import std.types { String, NonEmptyStr, Bool, Int, List, CommitSha }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import v2.std.optional { Present, Absent }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data guarantee_probe_corpus_witness_scope_note: String = "SLICE 1 MIGRATION RECEIPT: the landed wall controls from gunbc#7519 (call-label-and-surplus), gunbc#7484 (method-established-surface + declared-conformance-ground-fragment), gunbc#7485 (InferToEval self-grounding frontier), and gunbc#7555 (InferToTranslate underived-refusal identities reserved) execute through gunbc.guarantee_measurement identities. Each v1 probe compiles synthetic source via compile_dag_diagnostic_census, asserts the class-specific expectation through probe_observation_fold (never hand-matching ProbeObservation arms), and builds a GuaranteeMeasurementReceipt that joins its declared path. Mutation controls below prove the expectations discriminate — a green witness asserting the wrong contract would defend the defect (census_rows [] incident). The dark-suite originals in compiler_tests.rs remain until gap analysis sec 11 item 9 dispositiones them — this file is the durable enrolled copy keyed by identity, not a second test family. v2 InferToEval executing evidence joins the registry from src/v2/test/claim/infer_self_grounding_wall_test.dag; InferToTranslate identity rows are declared here until #7555 lands executing probes."

data probe_subject_revision_placeholder: CommitSha = "0000000000000000000000000000000000000000"
data probe_harness_revision_placeholder: CommitSha = "1111111111111111111111111111111111111111"

fn census_of(source: String) -> CompileDiagnosticCensus {
  compile_dag_diagnostic_census(source)
}

data call_mislabel_source: String = "module probe_call_mislabel\nfn sub(a: Int, b: Int) -> Int { a - b }\nfn f() -> Int { sub(a: 10, bb: 3) }\n"

data call_surplus_source: String = "module probe_call_surplus\nfn two(a: Int, b: Int) -> Int { a + b }\nfn f() -> Int { two(1, 2, 3) }\n"

data call_shape_green_source: String = "module probe_call_green\nfn sub(a: Int, b: Int) -> Int { a - b }\nfn ignore_ctx(_ctx: Int, b: Int) -> Int { b }\nfn named() -> Int { sub(a: 10, b: 3) }\nfn positional() -> Int { sub(10, 3) }\nfn underscore_idiom() -> Int { ignore_ctx(ctx: 1, b: 2) }\n"

data method_missing_source: String = "module probe_method_red\nfn f(xs: List<Int>) -> List<Int> { xs |> filter_map(x => x) }\nfn g(xs: List<Int>) -> Bool { xs |> starts_with(\"x\") }\nfn h(xs: List<Int>) -> String { xs |> to_upper() }\n"

data method_green_source: String = "module probe_method_green\nfn p(xs: List<Int>) -> List<Int> { xs |> filter(x => x > 1) |> map(x => x + 1) }\nfn q(xs: List<Int>) -> Int { xs |> fold(0, (a, x) => a + x) }\nfn r(s: String) -> Int { s |> count }\n"

data conformance_scalar_red_source: String = "module probe_conformance_red\nfn f() -> Int { \"a string\" }\ndata d: Int = \"a string\"\n"

data conformance_green_source: String = "module probe_conformance_green\nfn a() -> Int { 42 }\nfn b() -> String { \"fine\" }\ndata c: Int = 7\nfn e(xs: List<Int>) -> Int? { xs |> first }\n"

test fn identity_registry_is_unique() -> Bool {
  guarantee_class_ids_unique(ids: guarantee_probe_class_ids())
    && guarantee_path_ids_unique(paths: guarantee_probe_paths())
}

test fn probe_set_digest_is_stable() -> Bool {
  let a = probe_set_digest(probe_ids: guarantee_probe_ids()) as String
  let b = probe_set_digest(probe_ids: guarantee_probe_ids()) as String
  a == b && a != ""
}

test fn call_mislabel_red_refuses_blocking_call_argument_name_unknown() -> Bool {
  let census = census_of(source: call_mislabel_source)
  probe_expectation_holds(
    census: census,
    expectation: ExpectBlockingRefusal { diagnostic_class: "CallArgumentNameUnknown" as NonEmptyStr },
  )
    && match census_blocking_count_for_class(census: census, wanted: "CallArgumentNameUnknown") {
      Present { value: n } => n >= 1
      Absent => false
    }
}

test fn call_surplus_red_refuses_blocking_call_positional_surplus() -> Bool {
  let census = census_of(source: call_surplus_source)
  probe_expectation_holds(
    census: census,
    expectation: ExpectBlockingRefusal { diagnostic_class: "CallPositionalSurplus" as NonEmptyStr },
  )
}

test fn call_shape_green_control_has_zero_diagnostics() -> Bool {
  probe_expectation_holds(
    census: census_of(source: call_shape_green_source),
    expectation: ExpectZeroDiagnostics,
  )
}

test fn method_missing_red_refuses_blocking_method_not_found() -> Bool {
  let census = census_of(source: method_missing_source)
  probe_expectation_holds(
    census: census,
    expectation: ExpectBlockingRefusal { diagnostic_class: "MethodNotFound" as NonEmptyStr },
  )
    && match census_blocking_count_for_class(census: census, wanted: "MethodNotFound") {
      Present { value: n } => n >= 3
      Absent => false
    }
}

test fn method_green_control_has_zero_diagnostics() -> Bool {
  probe_expectation_holds(
    census: census_of(source: method_green_source),
    expectation: ExpectZeroDiagnostics,
  )
}

test fn conformance_scalar_red_refuses_blocking_type_mismatch() -> Bool {
  let census = census_of(source: conformance_scalar_red_source)
  probe_expectation_holds(
    census: census,
    expectation: ExpectBlockingRefusal { diagnostic_class: "TypeMismatch" as NonEmptyStr },
  )
    && match census_blocking_count_for_class(census: census, wanted: "TypeMismatch") {
      Present { value: n } => n >= 2
      Absent => false
    }
}

test fn conformance_green_control_has_zero_diagnostics() -> Bool {
  probe_expectation_holds(
    census: census_of(source: conformance_green_source),
    expectation: ExpectZeroDiagnostics,
  )
}

test fn migrated_receipt_joins_its_v1_compile_path() -> Bool {
  let receipt = build_v1_compile_receipt(
    class: call_label_surplus_class,
    probe: call_mislabel_red_probe,
    census: census_of(source: call_mislabel_source),
    expectation: ExpectBlockingRefusal { diagnostic_class: "CallArgumentNameUnknown" as NonEmptyStr },
    subject_revision: probe_subject_revision_placeholder,
    harness_revision: probe_harness_revision_placeholder,
  )
  receipt_joins_v1_compile_path(receipt: receipt)
    && (receipt.class as String) == (call_label_surplus_class as String)
    && (receipt.probe as String) == (call_mislabel_red_probe as String)
    && (receipt.path as String) == (v1_compile_rust_path_id as String)
}

test fn blocking_refusal_observation_is_a_verdict() -> Bool {
  let census = census_of(source: method_missing_source)
  let receipt = build_v1_compile_receipt(
    class: method_established_surface_class,
    probe: method_missing_red_probe,
    census: census,
    expectation: ExpectBlockingRefusal { diagnostic_class: "MethodNotFound" as NonEmptyStr },
    subject_revision: probe_subject_revision_placeholder,
    harness_revision: probe_harness_revision_placeholder,
  )
  observed_is_verdict(o: receipt.observed)
    && match census_blocking_count_for_class(census: census, wanted: "MethodNotFound") {
      Present { value: n } => observation_refused_count(o: receipt.observed) == n
      Absent => false
    }
}

test fn green_control_observation_is_accepted_clean() -> Bool {
  let receipt = build_v1_compile_receipt(
    class: call_label_surplus_class,
    probe: call_shape_green_probe,
    census: census_of(source: call_shape_green_source),
    expectation: ExpectZeroDiagnostics,
    subject_revision: probe_subject_revision_placeholder,
    harness_revision: probe_harness_revision_placeholder,
  )
  observation_is_clean(o: receipt.observed)
}

test fn advisory_demotion_would_not_satisfy_blocking_expectation() -> Bool {
  let advisory_only = CensusObserved {
    rows: [{
      diagnostic_class: "CallArgumentNameUnknown" as NonEmptyStr,
      subject_name: "probe" as String,
      blocking: false,
      count: 1,
    }],
  }
  !probe_expectation_holds(
    census: advisory_only,
    expectation: ExpectBlockingRefusal { diagnostic_class: "CallArgumentNameUnknown" as NonEmptyStr },
  )
    && match census_any_count_for_class(census: advisory_only, wanted: "CallArgumentNameUnknown") {
      Present { value: n } => n >= 1
      Absent => false
    }
}

test fn not_runnable_never_satisfies_expectation() -> Bool {
  let not_runnable = CensusNotRunnable { cause: "harness error" as NonEmptyStr }
  !probe_expectation_holds(census: not_runnable, expectation: ExpectZeroDiagnostics)
    && !probe_expectation_holds(
      census: not_runnable,
      expectation: ExpectBlockingRefusal { diagnostic_class: "MethodNotFound" as NonEmptyStr },
    )
}

test fn probe_ids_are_canonically_ordered() -> Bool {
  probe_ids_match_canonical_order(ids: guarantee_probe_ids())
}

test fn mislabel_red_does_not_satisfy_surplus_expectation() -> Bool {
  let census = census_of(source: call_mislabel_source)
  probe_expectation_holds(
    census: census,
    expectation: ExpectBlockingRefusal { diagnostic_class: "CallArgumentNameUnknown" as NonEmptyStr },
  )
    && !probe_expectation_holds(
      census: census,
      expectation: ExpectBlockingRefusal { diagnostic_class: "CallPositionalSurplus" as NonEmptyStr },
    )
}

test fn surplus_red_does_not_satisfy_mislabel_expectation() -> Bool {
  let census = census_of(source: call_surplus_source)
  probe_expectation_holds(
    census: census,
    expectation: ExpectBlockingRefusal { diagnostic_class: "CallPositionalSurplus" as NonEmptyStr },
  )
    && !probe_expectation_holds(
      census: census,
      expectation: ExpectBlockingRefusal { diagnostic_class: "CallArgumentNameUnknown" as NonEmptyStr },
    )
}

test fn green_control_fails_blocking_refusal_expectation() -> Bool {
  let census = census_of(source: call_shape_green_source)
  probe_expectation_holds(census: census, expectation: ExpectZeroDiagnostics)
    && !probe_expectation_holds(
      census: census,
      expectation: ExpectBlockingRefusal { diagnostic_class: "CallArgumentNameUnknown" as NonEmptyStr },
    )
}

test fn observation_fold_routes_blocking_refusal() -> Bool {
  let obs = probe_observation_from_census(
    census: census_of(source: call_mislabel_source),
    expectation: ExpectBlockingRefusal { diagnostic_class: "CallArgumentNameUnknown" as NonEmptyStr },
  )
  observation_is_blocking_refusal(o: obs, wanted: "CallArgumentNameUnknown" as NonEmptyStr)
    && !observation_is_clean(o: obs)
}

test fn v2_translate_identities_are_declared() -> Bool {
  (v2_infer_translate_path_id as String) == "v2-infer-translate"
    && (v2_translate_underived_refusal_class as String) == "v2-translate-underived-refusal"
    && (v2_translate_underived_red_probe as String) == "v2-translate-underived-refusal-conj-red"
}

test fn v2_frontier_identities_are_declared() -> Bool {
  (v2_infer_eval_path_id as String) == "v2-infer-eval"
    && (v2_self_grounding_frontier_class as String) == "v2-self-grounding-frontier"
    && (v2_frontier_red_probe as String) == "v2-self-grounding-frontier-value-red"
    && (v2_frontier_green_probe as String) == "v2-self-grounding-frontier-derived-green"
}
