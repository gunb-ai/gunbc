test fn observation_fold_routes_blocking_refusal() -> Bool {
  let obs = probe_observation_from_census(census: census_of(source: call_mislabel_source))
  observation_is_blocking_refusal(o: obs, wanted: "CallArgumentNameUnknown" as NonEmptyStr)
    && !observation_is_clean(o: obs)
}

test fn wrong_expectation_does_not_fabricate_clean_receipt() -> Bool {
  let census = census_of(source: call_mislabel_source)
  match active_probe_row(probe: call_mislabel_red_probe) {
    Present { value: registry_row } =>
      match active_v1_compile_probe_row(probe: call_mislabel_red_probe) {
        Present { value: row } =>
          match active_probe_row(probe: call_surplus_red_probe) {
            Present { value: wrong_row } =>
              probe_row_expectation_holds(census: census, row: registry_row)
                && !probe_row_expectation_holds(census: census, row: wrong_row)
                && observation_is_blocking_refusal(
                  o: probe_observation_from_census(census: census),
                  wanted: "CallArgumentNameUnknown" as NonEmptyStr,
                )
                && observation_is_clean(o: build_v1_compile_receipt(
                  row: row,
                  census: census,
                  subject_revision: synthetic_program_subject_revision(source: call_mislabel_source),
                  harness_revision: witness_harness_revision(probe: row.probe),
                ).observed) == false
            Absent => false
          }
        Absent => false
      }
    Absent => false
  }
}

test fn subject_revision_is_content_derived_not_fabricated_constant() -> Bool {
  let mislabel_subject = synthetic_program_subject_revision(source: call_mislabel_source)
  let surplus_subject = synthetic_program_subject_revision(source: call_surplus_source)
  let mislabel_harness = witness_harness_revision(probe: call_mislabel_red_probe)
  let surplus_harness = witness_harness_revision(probe: call_surplus_red_probe)
  mislabel_subject != surplus_subject && mislabel_harness != surplus_harness
}

test fn harness_revision_tracks_expectation_not_probe_id_alone() -> Bool {
  let harness_source = measured_v1_compile_harness_source()
  match active_probe_row(probe: call_mislabel_red_probe) {
    Present { value: mislabel } =>
      match active_probe_row(probe: call_shape_green_probe) {
        Present { value: green } =>
          let mislabel_harness = v1_compile_harness_revision(
            probe: call_mislabel_red_probe,
            expectation: mislabel.expectation,
            harness_source: harness_source,
          )
          let green_harness = v1_compile_harness_revision(
            probe: call_mislabel_red_probe,
            expectation: green.expectation,
            harness_source: harness_source,
          )
          mislabel_harness != green_harness
        Absent => false
      }
    Absent => false
  }
}

test fn harness_revision_tracks_measured_source_not_symbol_spine() -> Bool {
  match active_probe_row(probe: call_mislabel_red_probe) {
    Present { value: row } =>
      let measured = measured_v1_compile_harness_source()
      let from_measured = v1_compile_harness_revision(
        probe: call_mislabel_red_probe,
        expectation: row.expectation,
        harness_source: measured,
      )
      let from_symbol_spine = v1_compile_harness_revision(
        probe: call_mislabel_red_probe,
        expectation: row.expectation,
        harness_source: "compile_dag_diagnostic_census|probe_observation_from_census|probe_row_expectation_holds|probe_expectation_fold" as NonEmptyStr,
      )
      from_measured != from_symbol_spine
    Absent => false
  }
}

test fn synthetic_revisions_use_content_fingerprint_not_git_revision() -> Bool {
  match synthetic_program_subject_revision(source: call_mislabel_source) {
    ContentFingerprint { digest: _ } => true
    GitRevision { commit: _ } => false
  }
}

test fn receipt_probe_set_digest_matches_executed_probe_set() -> Bool {
  match active_v1_compile_probe_row(probe: call_mislabel_red_probe) {
    Present { value: row } =>
      let executed = executed_probe_ids_for_probe(probe: row.probe)
      let receipt = build_v1_compile_receipt(
        row: row,
        census: census_of(source: call_mislabel_source),
        subject_revision: synthetic_program_subject_revision(source: call_mislabel_source),
        harness_revision: witness_harness_revision(probe: row.probe),
      )
      (receipt.probe_set_digest as String) == (probe_set_digest(probe_ids: executed) as String)
        && !((receipt.probe_set_digest as String) == (probe_set_digest(probe_ids: guarantee_probe_ids()) as String))
    Absent => false
  }
}

test fn harness_revision_includes_compiler_pipeline_not_schema_only() -> Bool {
  match active_probe_row(probe: call_mislabel_red_probe) {
    Present { value: row } =>
      let full = measured_v1_compile_harness_source()
      let schema_only = measured_harness_source_material(
        paths: [
          "dag/gunbc/guarantee_probe_corpus.dag",
          "dag/gunbc/guarantee_measurement.dag",
          "dag/gunbc/compile_diagnostic_census.dag",
        ],
      )
      let from_full = v1_compile_harness_revision(
        probe: call_mislabel_red_probe,
        expectation: row.expectation,
        harness_source: full,
      )
      let from_schema = v1_compile_harness_revision(
        probe: call_mislabel_red_probe,
        expectation: row.expectation,
        harness_source: schema_only,
      )
      from_full != from_schema
    Absent => false
  }
}

test fn canonical_probe_rows_bind_class_path_and_probe() -> Bool {
  count(guarantee_probe_rows()) == count(guarantee_probe_ids())
    && guarantee_probe_ids_unique(ids: guarantee_probe_ids())
    && match resolve_canonical_probe_row(wanted: v2_frontier_red_probe) {
      ProbeRowResolved { row: row } =>
        (row.class as String) == (v2_self_grounding_frontier_class as String)
          && (row.path as String) == (v2_infer_eval_path_id as String)
          && (row.probe as String) == (v2_frontier_red_probe as String)
      ProbeRowUnknown { wanted: _ } => false
      ProbeRowDuplicate { wanted: _, matches: _ } => false
    }
    && match active_probe_row(probe: call_mislabel_red_probe) {
      Present { value: row } =>
        (row.class as String) == (call_label_surplus_class as String)
          && (row.path as String) == (v1_compile_rust_path_id as String)
      Absent => false
    }
}

test fn canonical_probe_resolution_refuses_duplicate_population() -> Bool {
  canonical_probe_row_resolution_refuses_duplicate_population()
}

// known_v1_migration_gap_ids below names sole_ctor_mint_fn_hole_probe: its own row's declared
// expectation does not yet hold (sole_constructor_probe_scope_note,
// sole_constructor_mint_fn_hole_still_compile_clean) — a tracked open compile gap from #7790,
// never a retired Rust dark-suite witness — so its absence from every disposition is named here,
// not silently unaccounted for in either direction of the join.
// Named residue (DESIGN §4c): known_v1_migration_gap_ids is a hand-authored allowlist and its
// one entry's justification lives only in this prose annotation, which no Accepted program can
// read — the completeness join below cannot itself verify the exception is warranted, only that
// it is the sole one taken. Dissolution trigger: when #7790 closes and
// sole_constructor_mint_fn_hole_still_compile_clean's expectation holds, remove this probe from
// known_v1_migration_gap_ids so it is covered by disposition or registry retirement instead.
// Probes authored directly against the v1 compile path with no Rust witness behind them. The
// migration law below quantifies over every v1-compile row on the assumption that each descends
// from a Rust witness that must be disposed; these do not, so disposing them would assert a
// migration that never happened and listing them as gaps would assert a hole that is not there.
// Both are the rung-inflation failure in miniature, one in each direction, so they get their own
// arm. Membership here is not an exemption from evidence: each row still carries a discriminating
// RED or a positive control executed by a test in this file.
// The three arms must partition, or a row could claim two contradictory standings at once.
test fn dark_suite_dispositions_cover_migrated_v1_probes() -> Bool {
  let dispositions = guarantee_probe_dark_suite_dispositions()
  let disposition_probes: List<GuaranteeProbeId> = dispositions
    |> flat_map(d => match d {
      MigratedToEnrolledDagProbe { rust_witness: _, dag_probes: probes, rust_retained_until: _ } => probes
    })
  let disposition_probe_ids: List<String> = disposition_probes |> map(p => p as String)
  let dispositions_name_the_finite_classification_gate = dispositions
    |> all(d => match d {
      MigratedToEnrolledDagProbe { rust_witness: _, dag_probes: _, rust_retained_until: gate } =>
        (gate as String) == "gap-analysis-sec-11-item-9-finite-classification"
    })
  let disposed_ids_are_sound = disposition_probes
    |> all(p => match resolve_canonical_probe_row(wanted: p) {
      ProbeRowResolved { row: _ } => true
      ProbeRowUnknown { wanted: _ } => false
      ProbeRowDuplicate { wanted: _, matches: _ } => false
    })
  let disposed_ids_have_no_internal_duplicates =
    distinct_string_count(values: disposition_probe_ids) == count(disposition_probe_ids)
  let known_v1_migration_gap_ids: List<String> = [sole_ctor_mint_fn_hole_probe as String]
  let dag_native_v1_compile_probe_ids: List<String> = [
    bare_none_collection_red_probe as String,
    bare_none_green_probe as String,
    bare_none_scalar_red_probe as String,
    direct_call_arg_type_ordinary_module_red_probe as String,
    direct_call_arg_type_v2_green_control_probe as String,
    direct_call_arg_type_v2_module_red_probe as String,
    sole_ctor_admitted_caller_green_probe as String,
    sole_ctor_cast_red_probe as String,
    sole_ctor_unadmitted_caller_red_probe as String,
  ]
  let known_gaps_are_not_disposed = known_v1_migration_gap_ids
    |> all(gap => !string_list_contains(xs: disposition_probe_ids, wanted: gap))
  let every_v1_compile_probe_is_disposed_or_a_named_gap = guarantee_probe_rows()
    |> filter(row => (row.path as String) == (v1_compile_rust_path_id as String))
    |> all(row => {
      let id = row.probe as String
      string_list_contains(xs: disposition_probe_ids, wanted: id)
        || string_list_contains(xs: known_v1_migration_gap_ids, wanted: id)
        || string_list_contains(xs: dag_native_v1_compile_probe_ids, wanted: id)
    })
  let dag_native_ids_are_not_disposed_or_gaps = dag_native_v1_compile_probe_ids
    |> all(id => !string_list_contains(xs: disposition_probe_ids, wanted: id)
      && !string_list_contains(xs: known_v1_migration_gap_ids, wanted: id))
  disposed_ids_are_sound
    && disposed_ids_have_no_internal_duplicates
    && dispositions_name_the_finite_classification_gate
    && known_gaps_are_not_disposed
    && dag_native_ids_are_not_disposed_or_gaps
    && every_v1_compile_probe_is_disposed_or_a_named_gap
}

test fn v2_frontier_identities_are_declared() -> Bool {
  (v2_infer_eval_path_id as String) == "v2-infer-eval"
    && (v2_self_grounding_frontier_class as String) == "v2-self-grounding-frontier"
    && (v2_frontier_red_probe as String) == "v2-self-grounding-frontier-value-red"
    && (v2_frontier_green_probe as String) == "v2-self-grounding-frontier-derived-green"
}
