test fn call_duplicate_red_does_not_satisfy_mislabel_or_surplus_expectation() -> Bool {
  let census = census_of(source: call_duplicate_red_source)
  match active_probe_row(probe: call_duplicate_red_probe) {
    Present { value: dup_row } =>
      match active_probe_row(probe: call_mislabel_red_probe) {
        Present { value: mislabel_row } =>
          match active_probe_row(probe: call_surplus_red_probe) {
            Present { value: surplus_row } =>
              probe_row_expectation_holds(census: census, row: dup_row)
                && !probe_row_expectation_holds(census: census, row: mislabel_row)
                && !probe_row_expectation_holds(census: census, row: surplus_row)
            Absent => false
          }
        Absent => false
      }
    Absent => false
  }
}

