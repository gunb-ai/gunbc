test fn migrated_receipt_joins_its_v1_compile_path() -> Bool {
  match active_v1_compile_probe_row(probe: call_mislabel_red_probe) {
    Present { value: row } =>
      let receipt = build_v1_compile_receipt(
        row: row,
        census: census_of(source: call_mislabel_source),
        subject_revision: synthetic_program_subject_revision(source: call_mislabel_source),
        harness_revision: witness_harness_revision(probe: row.probe),
      )
      receipt_joins_v1_compile_path(receipt: receipt)
        && receipt_matches_v1_compile_probe_row(receipt: receipt, row: row)
        && (receipt.path as String) == (v1_compile_rust_path_id as String)
    Absent => false
  }
}

test fn blocking_refusal_observation_is_a_verdict() -> Bool {
  let census = census_of(source: method_missing_source)
  match active_v1_compile_probe_row(probe: method_missing_red_probe) {
    Present { value: row } =>
      let receipt = build_v1_compile_receipt(
        row: row,
        census: census,
        subject_revision: synthetic_program_subject_revision(source: method_missing_source),
        harness_revision: witness_harness_revision(probe: row.probe),
      )
      observed_is_verdict(o: receipt.observed)
        && receipt_matches_v1_compile_probe_row(receipt: receipt, row: row)
        && match census_blocking_count_for_class(census: census, wanted: "MethodNotFound") {
          Present { value: n } => observation_refused_count(o: receipt.observed) == n
          Absent => false
        }
    Absent => false
  }
}

test fn green_control_observation_is_accepted_clean() -> Bool {
  match active_v1_compile_probe_row(probe: call_shape_green_probe) {
    Present { value: row } =>
      let receipt = build_v1_compile_receipt(
        row: row,
        census: census_of(source: call_shape_green_source),
        subject_revision: synthetic_program_subject_revision(source: call_shape_green_source),
        harness_revision: witness_harness_revision(probe: row.probe),
      )
      observation_is_clean(o: receipt.observed)
        && receipt_matches_v1_compile_probe_row(receipt: receipt, row: row)
    Absent => false
  }
}

test fn advisory_demotion_would_not_satisfy_blocking_expectation() -> Bool {
  let advisory_only = CensusObserved {
    rows: [{
      diagnostic_class: "CallArgumentNameUnknown" as NonEmptyStr,
      subject_name: "probe" as String,
      blocking: false,
      count: 1,
    }],
  }
  !probe_expectation_holds(
    census: advisory_only,
    expectation: ExpectBlockingRefusal { diagnostic_class: "CallArgumentNameUnknown" as NonEmptyStr },
  )
    && match census_any_count_for_class(census: advisory_only, wanted: "CallArgumentNameUnknown") {
      Present { value: n } => n >= 1
      Absent => false
    }
}

test fn not_runnable_never_satisfies_expectation() -> Bool {
  let not_runnable = CensusNotRunnable { cause: "harness error" as NonEmptyStr }
  !probe_expectation_holds(census: not_runnable, expectation: ExpectZeroDiagnostics)
    && !probe_expectation_holds(
      census: not_runnable,
      expectation: ExpectBlockingRefusal { diagnostic_class: "MethodNotFound" as NonEmptyStr },
    )
}

test fn probe_ids_are_canonically_ordered() -> Bool {
  probe_ids_are_lexicographically_ordered(ids: guarantee_probe_ids())
    && count(guarantee_probe_id_strings()) == count(guarantee_probe_ids())
}

test fn mislabel_red_does_not_satisfy_surplus_expectation() -> Bool {
  let census = census_of(source: call_mislabel_source)
  match active_probe_row(probe: call_mislabel_red_probe) {
    Present { value: mislabel_row } =>
      match active_probe_row(probe: call_surplus_red_probe) {
        Present { value: surplus_row } =>
          probe_row_expectation_holds(census: census, row: mislabel_row)
            && !probe_row_expectation_holds(census: census, row: surplus_row)
        Absent => false
      }
    Absent => false
  }
}

test fn surplus_red_does_not_satisfy_mislabel_expectation() -> Bool {
  let census = census_of(source: call_surplus_source)
  match active_probe_row(probe: call_surplus_red_probe) {
    Present { value: surplus_row } =>
      match active_probe_row(probe: call_mislabel_red_probe) {
        Present { value: mislabel_row } =>
          probe_row_expectation_holds(census: census, row: surplus_row)
            && !probe_row_expectation_holds(census: census, row: mislabel_row)
        Absent => false
      }
    Absent => false
  }
}

test fn green_control_fails_blocking_refusal_expectation() -> Bool {
  let census = census_of(source: call_shape_green_source)
  match active_probe_row(probe: call_shape_green_probe) {
    Present { value: green_row } =>
      match active_probe_row(probe: call_mislabel_red_probe) {
        Present { value: mislabel_row } =>
          probe_row_expectation_holds(census: census, row: green_row)
            && !probe_row_expectation_holds(census: census, row: mislabel_row)
        Absent => false
      }
    Absent => false
  }
}

test fn observation_fold_routes_blocking_refusal() -> Bool {
  let obs = probe_observation_from_census(census: census_of(source: call_mislabel_source))
  observation_is_blocking_refusal(o: obs, wanted: "CallArgumentNameUnknown" as NonEmptyStr)
    && !observation_is_clean(o: obs)
}

test fn wrong_expectation_does_not_fabricate_clean_receipt() -> Bool {
  let census = census_of(source: call_mislabel_source)
  match active_probe_row(probe: call_mislabel_red_probe) {
    Present { value: registry_row } =>
      match active_v1_compile_probe_row(probe: call_mislabel_red_probe) {
        Present { value: row } =>
          match active_probe_row(probe: call_surplus_red_probe) {
            Present { value: wrong_row } =>
              probe_row_expectation_holds(census: census, row: registry_row)
                && !probe_row_expectation_holds(census: census, row: wrong_row)
                && observation_is_blocking_refusal(
                  o: probe_observation_from_census(census: census),
                  wanted: "CallArgumentNameUnknown" as NonEmptyStr,
                )
                && observation_is_clean(o: build_v1_compile_receipt(
                  row: row,
                  census: census,
                  subject_revision: synthetic_program_subject_revision(source: call_mislabel_source),
                  harness_revision: witness_harness_revision(probe: row.probe),
                ).observed) == false
            Absent => false
          }
        Absent => false
      }
    Absent => false
  }
}

test fn subject_revision_is_content_derived_not_fabricated_constant() -> Bool {
  let mislabel_subject = synthetic_program_subject_revision(source: call_mislabel_source)
  let surplus_subject = synthetic_program_subject_revision(source: call_surplus_source)
  let mislabel_harness = witness_harness_revision(probe: call_mislabel_red_probe)
  let surplus_harness = witness_harness_revision(probe: call_surplus_red_probe)
  mislabel_subject != surplus_subject && mislabel_harness != surplus_harness
}

test fn harness_revision_tracks_expectation_not_probe_id_alone() -> Bool {
  let harness_source = measured_v1_compile_harness_source()
  match active_probe_row(probe: call_mislabel_red_probe) {
    Present { value: mislabel } =>
      match active_probe_row(probe: call_shape_green_probe) {
        Present { value: green } =>
          let mislabel_harness = v1_compile_harness_revision(
            probe: call_mislabel_red_probe,
            expectation: mislabel.expectation,
            harness_source: harness_source,
          )
          let green_harness = v1_compile_harness_revision(
            probe: call_mislabel_red_probe,
            expectation: green.expectation,
            harness_source: harness_source,
          )
          mislabel_harness != green_harness
        Absent => false
      }
    Absent => false
  }
}

test fn harness_revision_tracks_measured_source_not_symbol_spine() -> Bool {
  match active_probe_row(probe: call_mislabel_red_probe) {
    Present { value: row } =>
      let measured = measured_v1_compile_harness_source()
      let from_measured = v1_compile_harness_revision(
        probe: call_mislabel_red_probe,
        expectation: row.expectation,
        harness_source: measured,
      )
      let from_symbol_spine = v1_compile_harness_revision(
        probe: call_mislabel_red_probe,
        expectation: row.expectation,
        harness_source: "compile_dag_diagnostic_census|probe_observation_from_census|probe_row_expectation_holds|probe_expectation_fold" as NonEmptyStr,
      )
      from_measured != from_symbol_spine
    Absent => false
  }
}

test fn synthetic_revisions_use_content_fingerprint_not_git_revision() -> Bool {
  match synthetic_program_subject_revision(source: call_mislabel_source) {
    ContentFingerprint { digest: _ } => true
    GitRevision { commit: _ } => false
  }
}

test fn receipt_probe_set_digest_matches_executed_probe_set() -> Bool {
  match active_v1_compile_probe_row(probe: call_mislabel_red_probe) {
    Present { value: row } =>
      let executed = executed_probe_ids_for_probe(probe: row.probe)
      let receipt = build_v1_compile_receipt(
        row: row,
        census: census_of(source: call_mislabel_source),
        subject_revision: synthetic_program_subject_revision(source: call_mislabel_source),
        harness_revision: witness_harness_revision(probe: row.probe),
      )
      (receipt.probe_set_digest as String) == (probe_set_digest(probe_ids: executed) as String)
        && !((receipt.probe_set_digest as String) == (probe_set_digest(probe_ids: guarantee_probe_ids()) as String))
    Absent => false
  }
}

test fn canonical_probe_rows_bind_class_path_and_probe() -> Bool {
  count(guarantee_probe_rows()) == count(guarantee_probe_ids())
    && guarantee_probe_ids_unique(ids: guarantee_probe_ids())
    && guarantee_probe_ids_unique(ids: guarantee_probe_ids_canonical())
    && count(guarantee_probe_rows_reserved()) == count(guarantee_probe_ids_reserved())
    && match resolve_canonical_probe_row(wanted: v2_frontier_red_probe) {
      ProbeRowResolved { row: row } =>
        (row.class as String) == (v2_self_grounding_frontier_class as String)
          && (row.path as String) == (v2_infer_eval_path_id as String)
          && (row.probe as String) == (v2_frontier_red_probe as String)
      ProbeRowUnknown { wanted: _ } => false
      ProbeRowDuplicate { wanted: _, matches: _ } => false
    }
    && match active_probe_row(probe: call_mislabel_red_probe) {
      Present { value: row } =>
        (row.class as String) == (call_label_surplus_class as String)
          && (row.path as String) == (v1_compile_rust_path_id as String)
      Absent => false
    }
}

test fn canonical_probe_resolution_refuses_duplicate_population() -> Bool {
  canonical_probe_row_resolution_refuses_duplicate_population()
}

test fn dark_suite_dispositions_cover_migrated_v1_probes() -> Bool {
  let dispositions = guarantee_probe_dark_suite_dispositions()
  count(dispositions) == 3
    && fold_list(
      xs: dispositions,
      empty: 0,
      cons: fn(acc, d) {
        match d {
          MigratedToEnrolledDagProbe { rust_witness: _, dag_probes: probes, rust_retained_until: gate } => {
            let gate_penalty = if (gate as String) == "gap-analysis-sec-11-item-9-finite-classification" {
              0
            } else {
              1000
            }
            acc + count(probes) + gate_penalty
          }
        }
      },
    ) == 7
}

test fn v2_translate_identities_are_declared() -> Bool {
  (v2_infer_translate_path_id as String) == "v2-infer-translate"
    && (v2_translate_underived_refusal_class as String) == "v2-translate-underived-refusal"
    && (v2_translate_underived_red_probe as String) == "v2-translate-underived-refusal-conj-red"
    && count(guarantee_probe_ids_reserved()) == 2
    && count(guarantee_probe_paths_reserved()) == 1
    && count(guarantee_probe_class_ids_reserved()) == 1
    && count(
      guarantee_probe_ids()
        |> filter(id => (id as String) == (v2_translate_underived_red_probe as String)),
    ) == 0
    && count(
      guarantee_probe_paths()
        |> filter(p => (p.id as String) == (v2_infer_translate_path_id as String)),
    ) == 0
    && count(
      guarantee_probe_class_ids()
        |> filter(id => (id as String) == (v2_translate_underived_refusal_class as String)),
    ) == 0
}

test fn v2_frontier_identities_are_declared() -> Bool {
  (v2_infer_eval_path_id as String) == "v2-infer-eval"
    && (v2_self_grounding_frontier_class as String) == "v2-self-grounding-frontier"
    && (v2_frontier_red_probe as String) == "v2-self-grounding-frontier-value-red"
    && (v2_frontier_green_probe as String) == "v2-self-grounding-frontier-derived-green"
}
