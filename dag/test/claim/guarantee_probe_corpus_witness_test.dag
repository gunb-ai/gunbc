data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data guarantee_probe_corpus_witness_scope_note: String = "SLICE 1 MIGRATION RECEIPT: the landed wall controls from the THREE MERGED PRs gunbc#7519 (call-label-and-surplus), gunbc#7484 (method-established-surface + declared-conformance-ground-fragment), and gunbc#7485 (InferToEval self-grounding frontier) execute through gunbc.guarantee_measurement identities. gunbc#7555 (InferToTranslate) is OPEN — class/path/probe rows are reserved for layout only; no control is copied from that branch and translate probes stay out of guarantee_probe_ids until #7555 merges. Each v1 probe compiles synthetic source via compile_dag_diagnostic_census, asserts the class-specific expectation through probe_observation_fold (never hand-matching ProbeObservation arms), and builds a GuaranteeMeasurementReceipt that joins its declared path. Mutation controls below prove the expectations discriminate — a green witness asserting the wrong contract would defend the defect (census_rows [] incident). The dark-suite originals in compiler_tests.rs remain until gap analysis sec 11 item 9 dispositiones them — this file is the durable enrolled copy keyed by identity, not a second test family. v2 InferToEval executing evidence joins the registry from src/v2/test/claim/infer_self_grounding_wall_test.dag."

fn census_of(source: String) -> CompileDiagnosticCensus {
  compile_dag_diagnostic_census(source)
}

fn measured_harness_source_material(paths: List<String>) -> NonEmptyStr {
  fold_list(
    xs: paths,
    empty: "guarantee-probe-harness-source" as NonEmptyStr,
    cons: fn(acc, path) {
      let read = filesystem_read(path: path)
      concat(
        concat(concat(acc as String, "\n=== "), path as String),
        concat(" ===\n", read.content as String),
      ) as NonEmptyStr
    },
  )
}

fn measured_v1_compile_harness_source() -> NonEmptyStr {
  measured_harness_source_material(paths: v1_compile_harness_source_paths())
}

fn witness_harness_revision(probe: GuaranteeProbeId) -> MeasurementRevision {
  let harness_source = measured_v1_compile_harness_source()
  match active_probe_row(probe: probe) {
    Present { value: row } =>
      v1_compile_harness_revision(
        probe: probe,
        expectation: row.expectation,
        harness_source: harness_source,
      )
    Absent =>
      v1_compile_harness_revision(
        probe: probe,
        expectation: ExpectBlockingRefusal { diagnostic_class: "witness-harness-row-absent" as NonEmptyStr },
        harness_source: harness_source,
      )
  }
}

data call_mislabel_source: String = "module probe_call_mislabel\nfn sub(a: Int, b: Int) -> Int { a - b }\nfn f() -> Int { sub(a: 10, bb: 3) }\n"

data call_surplus_source: String = "module probe_call_surplus\nfn two(a: Int, b: Int) -> Int { a + b }\nfn f() -> Int { two(1, 2, 3) }\n"

data call_shape_green_source: String = "module probe_call_green\nfn sub(a: Int, b: Int) -> Int { a - b }\nfn ignore_ctx(_ctx: Int, b: Int) -> Int { b }\nfn named() -> Int { sub(a: 10, b: 3) }\nfn positional() -> Int { sub(10, 3) }\nfn underscore_idiom() -> Int { ignore_ctx(ctx: 1, b: 2) }\n"

data method_missing_source: String = "module probe_method_red\nfn f(xs: List<Int>) -> List<Int> { xs |> filter_map(x => x) }\nfn g(xs: List<Int>) -> Bool { xs |> starts_with(\"x\") }\nfn h(xs: List<Int>) -> String { xs |> to_upper() }\n"

data method_green_source: String = "module probe_method_green\nfn p(xs: List<Int>) -> List<Int> { xs |> filter(x => x > 1) |> map(x => x + 1) }\nfn q(xs: List<Int>) -> Int { xs |> fold(0, (a, x) => a + x) }\nfn r(s: String) -> Int { s |> count }\n"

data conformance_scalar_red_source: String = "module probe_conformance_red\nfn f() -> Int { \"a string\" }\ndata d: Int = \"a string\"\n"

data conformance_green_source: String = "module probe_conformance_green\nfn a() -> Int { 42 }\nfn b() -> String { \"fine\" }\ndata c: Int = 7\nfn e(xs: List<Int>) -> Int? { xs |> first }\n"

test fn identity_registry_is_unique() -> Bool {
  guarantee_class_ids_unique(ids: guarantee_probe_class_ids())
    && guarantee_path_ids_unique(paths: guarantee_probe_paths())
    && guarantee_probe_ids_unique(ids: guarantee_probe_ids())
}

test fn duplicate_probe_id_reds_registry() -> Bool {
  guarantee_probe_ids_unique(ids: guarantee_probe_ids())
    && !guarantee_probe_ids_unique(ids: [call_mislabel_red_probe, call_mislabel_red_probe])
}

test fn probe_set_digest_is_stable() -> Bool {
  let a = probe_set_digest(probe_ids: guarantee_probe_ids()) as String
  let b = probe_set_digest(probe_ids: guarantee_probe_ids()) as String
  a == b && a != ""
}

test fn call_mislabel_red_refuses_blocking_call_argument_name_unknown() -> Bool {
  let census = census_of(source: call_mislabel_source)
  match active_probe_row(probe: call_mislabel_red_probe) {
    Present { value: row } =>
      probe_row_expectation_holds(census: census, row: row)
        && match census_blocking_count_for_class(census: census, wanted: "CallArgumentNameUnknown") {
          Present { value: n } => n >= 1
          Absent => false
        }
    Absent => false
  }
}

test fn call_surplus_red_refuses_blocking_call_positional_surplus() -> Bool {
  let census = census_of(source: call_surplus_source)
  match active_probe_row(probe: call_surplus_red_probe) {
    Present { value: row } => probe_row_expectation_holds(census: census, row: row)
    Absent => false
  }
}

