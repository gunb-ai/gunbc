module test.claim.match_exhaustiveness_coproduct_witness

import gunbc.compile_diagnostic_census {
  CompileDiagnosticCensus,
  CensusObserved,
  CensusNotRunnable,
  census_blocking_rows,
  census_rows_of_class,
  census_total_count,
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import tools.multi_module_compile_fixture {
  MultiModuleCompileFixtureOutcome, FixtureInstrumentRefused, FixtureCompileRefused,
  FixtureCompileCompleted, MultiModuleCompileFixture, fixture_source, compile_fixture,
  fixture_blocking_rows, fixture_rows_of_class,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// Paired control for v1 coproduct match exhaustiveness via compile_dag_diagnostic_census. An
// exhaustive Trio match must observe zero NonExhaustiveMatch rows; a match omitting Blue must
// refuse with exactly one counted NonExhaustiveMatch diagnostic — not merely 'refuses', which would
// pass today when the checker lists the full declared roster. Precision of the missing variant list
// is pinned in infer_semantics_witness (check_match_exhaustiveness missing.len == 1).

data exhaustive_coproduct_source: String = "module exhaust_exhaustive\ntype Trio = Red | Green | Blue\nfn f(c: Trio) -> Bool {\n  match c {\n    Red => true\n    Green => false\n    Blue => true\n  }\n}\n"

data missing_arm_coproduct_source: String = "module exhaust_missing\ntype Trio = Red | Green | Blue\nfn f(c: Trio) -> Bool {\n  match c {\n    Red => true\n    Green => false\n  }\n}\n"

// THE IMPORTED, RECORD-PROJECTED SHAPE IS THE REGRESSION CONTROL. The direct-parameter fixture
// above was already green while `gunbc.discovery_census` compiled two matches that omitted
// `DeclinedOutsideRequiredGate`: a field projection retained the nominal imported type name, but
// exhaustiveness lookup asked only the current module's local type environment for its declaration.
// The negative omits exactly `DeclinedOutsideRequiredGate`; the positive differs only by
// including it. Both name every later arm so growth in the imported authority makes these
// controls fail closed instead of changing which omission the negative measures.
data imported_projected_missing_arm_source: String = "module exhaust_imported_projected_missing\nimport v2.workflow.required_floor { RequiredFloorDisposition, Planned, PlannedAsChangedWitness, DeclinedLongModule, DeclinedFixtureMember, DeclinedOutsideRequiredGate, DeclinedCostDebt, DeclinedOutsideGateClosure, DeclinedDiscoveryExcluded }\ntype Row { disposition: RequiredFloorDisposition }\nfn f(row: Row) -> Bool {\n  match row.disposition {\n    Planned => true\n    PlannedAsChangedWitness => true\n    DeclinedLongModule { matched_prefix: _ } => false\n    DeclinedFixtureMember { matched_prefix: _ } => false\n    DeclinedCostDebt => false\n    DeclinedOutsideGateClosure => false\n    DeclinedDiscoveryExcluded { matched_substring: _ } => false\n  }\n}\n"

data imported_projected_exhaustive_source: String = "module exhaust_imported_projected_complete\nimport v2.workflow.required_floor { RequiredFloorDisposition, Planned, PlannedAsChangedWitness, DeclinedLongModule, DeclinedFixtureMember, DeclinedOutsideRequiredGate, DeclinedCostDebt, DeclinedOutsideGateClosure, DeclinedDiscoveryExcluded }\ntype Row { disposition: RequiredFloorDisposition }\nfn f(row: Row) -> Bool {\n  match row.disposition {\n    Planned => true\n    PlannedAsChangedWitness => true\n    DeclinedLongModule { matched_prefix: _ } => false\n    DeclinedFixtureMember { matched_prefix: _ } => false\n    DeclinedOutsideRequiredGate => false\n    DeclinedCostDebt => false\n    DeclinedOutsideGateClosure => false\n    DeclinedDiscoveryExcluded { matched_substring: _ } => false\n  }\n}\n"

fn non_exhaustive_blocking_count(source: String) -> Int {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: rows } =>
      census_total_count(rows: census_blocking_rows(rows: census_rows_of_class(rows: rows, wanted: "NonExhaustiveMatch")))
    CensusNotRunnable { cause: _ } => -1
  }
}

test fn w_exhaustive_coproduct_match_observes_zero_non_exhaustive() -> Bool {
  non_exhaustive_blocking_count(source: exhaustive_coproduct_source) == 0
}

test fn w_missing_coproduct_arm_reports_one_non_exhaustive() -> Bool {
  non_exhaustive_blocking_count(source: missing_arm_coproduct_source) == 1
}

test fn w_imported_projected_missing_arm_reports_one_non_exhaustive() -> Bool {
  non_exhaustive_blocking_count(source: imported_projected_missing_arm_source) == 1
}

test fn w_imported_projected_exhaustive_match_observes_zero_non_exhaustive() -> Bool {
  non_exhaustive_blocking_count(source: imported_projected_exhaustive_source) == 0
}

data cross_module_trio_provider: String = "module exhaust.provider\ntype Trio = A | B | C\n"
data cross_module_quartet_provider: String = "module exhaust.provider\ntype Trio = A | B | C | D\n"
data cross_module_missing_consumer: String = "module exhaust.consumer\nimport exhaust.provider { Trio, A, B, C }\ntype Row { disposition: Trio }\nfn f(row: Row) -> Bool { match row.disposition { A => true B => false } }\n"
data cross_module_complete_consumer: String = "module exhaust.consumer\nimport exhaust.provider { Trio, A, B, C }\ntype Row { disposition: Trio }\nfn f(row: Row) -> Bool { match row.disposition { A => true B => false C => true } }\n"
data cross_module_catch_all_consumer: String = "module exhaust.consumer\nimport exhaust.provider { Trio, A, B, C }\ntype Row { disposition: Trio }\nfn f(row: Row) -> Bool { match row.disposition { A => true _ => false } }\n"
data unresolved_scrutinee_consumer: String = "module exhaust.unresolved\nfn f(x: MissingType) -> Bool { match x { A => true } }\n"

fn cross_module_run(provider: String, consumer: String) -> MultiModuleCompileFixtureOutcome {
  compile_fixture(MultiModuleCompileFixture {
    sources: [
      fixture_source("exhaust/provider.dag", provider),
      fixture_source("exhaust/consumer.dag", consumer)
    ],
    entry: "exhaust/consumer.dag"
  })
}

fn fixture_blocking_class_count(o: MultiModuleCompileFixtureOutcome, wanted: String) -> Int {
  match o {
    FixtureCompileRefused { module_count: _, diagnostics: rows, source_digest: _, compiler_digest: _ } =>
      census_total_count(rows: fixture_blocking_rows(rows: fixture_rows_of_class(rows: rows, wanted: wanted)))
    FixtureCompileCompleted { module_count: _, emitted_files: _, diagnostics: rows, source_digest: _, compiler_digest: _ } =>
      census_total_count(rows: fixture_blocking_rows(rows: fixture_rows_of_class(rows: rows, wanted: wanted)))
    FixtureInstrumentRefused { cause: _ } => -1
  }
}

test fn w_cross_module_missing_c_reports_one_non_exhaustive() -> Bool {
  fixture_blocking_class_count(
    o: cross_module_run(provider: cross_module_trio_provider, consumer: cross_module_missing_consumer),
    wanted: "NonExhaustiveMatch"
  ) == 1
}

test fn w_cross_module_complete_match_is_clean() -> Bool {
  fixture_blocking_class_count(
    o: cross_module_run(provider: cross_module_trio_provider, consumer: cross_module_complete_consumer),
    wanted: "NonExhaustiveMatch"
  ) == 0
}

test fn w_cross_module_catch_all_is_permitted() -> Bool {
  fixture_blocking_class_count(
    o: cross_module_run(provider: cross_module_trio_provider, consumer: cross_module_catch_all_consumer),
    wanted: "NonExhaustiveMatch"
  ) == 0
}

// THE CONSUMER IS UNCHANGED: widening only the provider adds D, and the same match must red.
test fn w_cross_module_provider_growth_reports_one_non_exhaustive() -> Bool {
  fixture_blocking_class_count(
    o: cross_module_run(provider: cross_module_quartet_provider, consumer: cross_module_complete_consumer),
    wanted: "NonExhaustiveMatch"
  ) == 1
}

test fn w_unresolved_scrutinee_refuses_instead_of_becoming_not_a_coproduct() -> Bool {
  let run = compile_fixture(MultiModuleCompileFixture {
    sources: [fixture_source("exhaust/unresolved.dag", unresolved_scrutinee_consumer)],
    entry: "exhaust/unresolved.dag"
  })
  fixture_blocking_class_count(o: run, wanted: "UnresolvedType") > 0
}

// -- NESTED PATTERNS: THE ARM HEAD IS NOT THE ARM'S COVERAGE --
//
// The flat coverage fold keyed on the arm head and discarded `field_bindings`, so
// `A { i: P { v: v } }` marked the whole of `A` covered. gunbc accepted the negative below
// with zero blocking diagnostics and rustc refused its emission -- accepted source, uncompilable
// target. The negative and the positive differ by exactly one arm, `A { i: Q }`.

data nested_missing_source: String = "module exhaust_nested_missing\ntype Inner = P { v: Bool } | Q\ntype Outer = A { i: Inner } | B\nfn f(o: Outer) -> Bool {\n  match o {\n    A { i: P { v: v } } => v\n    B => false\n  }\n}\n"

data nested_complete_source: String = "module exhaust_nested_complete\ntype Inner = P { v: Bool } | Q\ntype Outer = A { i: Inner } | B\nfn f(o: Outer) -> Bool {\n  match o {\n    A { i: P { v: v } } => v\n    A { i: Q } => false\n    B => false\n  }\n}\n"

// A WILDCARD FIELD STILL COVERS ITS VARIANT WHOLE, and so does the bare head. These are the
// controls that the change refuses only what nesting actually restricts: every arm below binds
// no constructor at depth, so both must stay clean.
data nested_wildcard_field_source: String = "module exhaust_nested_wildcard\ntype Inner = P { v: Bool } | Q\ntype Outer = A { i: Inner } | B\nfn f(o: Outer) -> Bool {\n  match o {\n    A { i: _ } => true\n    B => false\n  }\n}\n"

data nested_bare_head_source: String = "module exhaust_nested_bare\ntype Inner = P { v: Bool } | Q\ntype Outer = A { i: Inner } | B\nfn f(o: Outer) -> Bool {\n  match o {\n    A { i: i } => true\n    B => false\n  }\n}\n"

// THE JOINT-COLUMN DISCRIMINATOR, and the reason coverage is not computed one field at a time.
// Reading the two fields INDEPENDENTLY, x is covered by {P, Q} and y is covered by {P, Q}, so a
// per-field checker calls this exhaustive. It is not: `A { x: P, y: Q }` matches no arm, and
// rustc refuses the emission. A checker that greens this witness has replaced one blind spot
// with a narrower one rather than removing the class.
data nested_pair_missing_source: String = "module exhaust_nested_pair_missing\ntype Inner = P | Q\ntype Outer = A { x: Inner, y: Inner } | B\nfn f(o: Outer) -> Bool {\n  match o {\n    A { x: P, y: P } => true\n    A { x: Q, y: Q } => false\n    B => false\n  }\n}\n"

data nested_pair_complete_source: String = "module exhaust_nested_pair_complete\ntype Inner = P | Q\ntype Outer = A { x: Inner, y: Inner } | B\nfn f(o: Outer) -> Bool {\n  match o {\n    A { x: P, y: P } => true\n    A { x: P, y: Q } => true\n    A { x: Q, y: P } => false\n    A { x: Q, y: Q } => false\n    B => false\n  }\n}\n"

test fn w_nested_variant_pattern_restricting_a_field_reports_one_non_exhaustive() -> Bool {
  non_exhaustive_blocking_count(source: nested_missing_source) == 1
}

test fn w_nested_variant_pattern_covering_every_inner_arm_is_clean() -> Bool {
  non_exhaustive_blocking_count(source: nested_complete_source) == 0
}

test fn w_wildcard_field_binding_still_covers_its_variant() -> Bool {
  non_exhaustive_blocking_count(source: nested_wildcard_field_source) == 0
}

test fn w_named_field_binding_still_covers_its_variant() -> Bool {
  non_exhaustive_blocking_count(source: nested_bare_head_source) == 0
}

test fn w_two_nested_columns_are_judged_jointly_not_per_field() -> Bool {
  non_exhaustive_blocking_count(source: nested_pair_missing_source) == 1
}

test fn w_two_nested_columns_covered_pairwise_are_clean() -> Bool {
  non_exhaustive_blocking_count(source: nested_pair_complete_source) == 0
}

// THE PRECISION CONTROL FOR THE DEFAULT-MATRIX GATE. Every pair over {P, Q} x {P, Q} is covered:
// (P, P) and (P, Q) by arm one, (Q, P) by arm two, (Q, Q) by arm three. But the x column DOES
// carry an irrefutable row, so a checker that takes the default matrix whenever some row head is
// a wildcard keeps arm two alone, drops the two arms that also cover `x = P`, and refuses this
// program with `A { x: _, y: Q }` missing. The sound gate is signature COMPLETENESS -- the
// default matrix is admissible only when some declared constructor appears at no row head at all.
data nested_overlapping_wildcard_source: String = "module exhaust_nested_overlapping\ntype Inner = P | Q\ntype Outer = A { x: Inner, y: Inner } | B\nfn f(o: Outer) -> Bool {\n  match o {\n    A { x: P, y: _ } => true\n    A { x: _, y: P } => true\n    A { x: Q, y: Q } => false\n    B => false\n  }\n}\n"

test fn w_overlapping_wildcard_columns_are_not_over_refused() -> Bool {
  non_exhaustive_blocking_count(source: nested_overlapping_wildcard_source) == 0
}

// -- THE OPTIONAL-NESTED SHAPE, WHICH IS THE FORM THAT ACTUALLY OCCURRED --
//
// The synthetic fixtures above nest one authored coproduct inside another. The population
// specimen nests inside `Present`, over `Optional<T>`: `v1.compiler.dag_collect_support
// inferred_fingerprint` and `v1.compiler.parse occurrence_allocator_after_inferred_node` both
// matched `Present { value: Resolved { .. } }` and stayed SILENT when a fourth `InferredNode`
// variant landed, while SEVEN flat matches of the same coproduct in the same run were refused
// (gunbc#9964, still-swift-363). Flat flagged, nested silent, one variant, one run.
//
// It is a distinct code path and not a restatement: the Optional roster is SYNTHESISED
// (`Present`/`Absent` with a minted `value` field) rather than read off declared children, so a
// checker can see through authored nesting and still be blind here. The two sites were repaired
// at their authority in #9964; this is the checker, so a third such match authored tomorrow is
// the thing under test.
data optional_nested_missing_source: String = "module exhaust_optional_nested_missing\ntype Kind = KA { n: Bool } | KB { n: Bool } | KC\nfn f(v: Kind?) -> Bool {\n  match v {\n    Absent => false\n    Present { value: KA { n: n } } => n\n    Present { value: KB { n: n } } => n\n  }\n}\n"

data optional_nested_complete_source: String = "module exhaust_optional_nested_complete\ntype Kind = KA { n: Bool } | KB { n: Bool } | KC\nfn f(v: Kind?) -> Bool {\n  match v {\n    Absent => false\n    Present { value: KA { n: n } } => n\n    Present { value: KB { n: n } } => n\n    Present { value: KC } => true\n  }\n}\n"

test fn w_optional_nested_missing_inner_variant_reports_one_non_exhaustive() -> Bool {
  non_exhaustive_blocking_count(source: optional_nested_missing_source) == 1
}

test fn w_optional_nested_covering_every_inner_variant_is_clean() -> Bool {
  non_exhaustive_blocking_count(source: optional_nested_complete_source) == 0
}
