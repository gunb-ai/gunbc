module test.claim.markup_medium_convergence


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn em_hi() -> std.markup.Fragment {
  extdeps.browser.Element { tag: "em", attributes: [], children: [ std.markup.FragmentText { content: "hi" } ] }
}

fn md_medium() -> std.markup.MarkupMedium {
  markdown_markup_medium(sp: commonmark_gfm_spellings)
}

test fn witness_same_fold_html_vs_md() -> Bool {
  let html = serialize_fragment_with(frag: em_hi(), medium: html_markup_medium())
  let md = serialize_fragment_with(frag: em_hi(), medium: md_medium())
  (html == "<em>hi</em>") && (md == "*hi*") && (html != md)
}

fn md_medium_underscore() -> std.markup.MarkupMedium {
  std.markup.MarkupMedium {
    tag_overrides: [ std.markup.TagDelimiter { tag: "em", open: "_", close: "_" } ],
    bracket: canonical_html_spellings,
    text_escape: EscapeRaw,
    void_tags: [],
    void_rendering: OmitClose,
    raw_text_tags: [],
  }
}

test fn witness_perturb_row_flips_output() -> Bool {
  let base = serialize_fragment_with(frag: em_hi(), medium: md_medium())
  let perturbed = serialize_fragment_with(frag: em_hi(), medium: md_medium_underscore())
  (base == "*hi*") && (perturbed == "_hi_") && (base != perturbed)
}

fn button_node() -> std.markup.Fragment {
  extdeps.browser.Element {
    tag: "button",
    attributes: [ attr(name: "class", value: "primary" ) ],
    children: [ std.markup.FragmentText { content: "Go" } ],
  }
}

fn single_quote_medium() -> std.markup.MarkupMedium {
  std.markup.MarkupMedium {
    tag_overrides: [],
    bracket: std.markup.MarkupBracket {
      tag_open: "<",
      end_tag_open: "</",
      tag_close: ">",
      attr_sep: " ",
      attr_assign: "=",
      attr_quote: "'",
    },
    text_escape: EscapeHtml,
    void_tags: [],
    void_rendering: OmitClose,
    raw_text_tags: [],
  }
}

test fn witness_third_medium_is_one_row() -> Bool {
  let html = serialize_fragment_with(frag: button_node(), medium: html_markup_medium())
  let single_quote = serialize_fragment_with(frag: button_node(), medium: single_quote_medium())
  (html == "<button class=\"primary\">Go</button>")
    && (single_quote == "<button class='primary'>Go</button>")
    && (html != single_quote)
}

fn md_mixed_doc() -> std.markdown.MarkdownDocument {
  std.markdown.MarkdownDocument {
    blocks: [
      std.markdown.ParagraphBlock {
        inlines: [
          std.markdown.StrongInline { inlines: [ std.markdown.TextInline { text: "bold" } ] },
          std.markdown.TextInline { text: " and " },
          std.markdown.EmphasisInline { inlines: [ std.markdown.TextInline { text: "em" } ] },
        ],
      },
    ],
  }
}

test fn witness_md_inline_emission_bytes() -> Bool {
  let out = serialize_markdown_source_with(doc: md_mixed_doc(), sp: commonmark_gfm_spellings)
  out == "**bold** and *em*\n"
}

fn md_link_doc() -> std.markdown.MarkdownDocument {
  std.markdown.MarkdownDocument {
    blocks: [
      std.markdown.ParagraphBlock {
        inlines: [
          std.markdown.LinkInline { inlines: [ std.markdown.TextInline { text: "text" } ], url: "https://x.com" },
        ],
      },
    ],
  }
}

test fn witness_md_link_named_arm_bytes() -> Bool {
  let out = serialize_markdown_source_with(doc: md_link_doc(), sp: commonmark_gfm_spellings)
  out == "[text](https://x.com)\n"
}

fn hostile_href_node() -> std.markup.Fragment {
  extdeps.browser.Element {
    tag: "a",
    attributes: [ attr(name: "href", value: "javascript:alert(1)" ) ],
    children: [ std.markup.FragmentText { content: "x" } ],
  }
}

test fn witness_xss_still_rejected_through_fold() -> Bool {
  match try_serialize_html_source(node: hostile_href_node()) {
    EmitRejected { reason: _ } => true
    EmitOk { html: _ } => false
  }
}

