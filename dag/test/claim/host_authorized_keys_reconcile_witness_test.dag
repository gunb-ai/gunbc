module test.claim.host_authorized_keys_reconcile


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data host_authorized_keys_reconcile_witness_note: String = "Green-by-execution proof of the SSH-authorized-keys reconcile on REAL observed data (operator macbook reads of srv3/srv4, 2026-07-24). The load-bearing discriminations: srv3 (installed pre-#7027, missing the fleet key) yields exactly ONE upsert — the fleet-automation key, named specifically, not just a count — and TWO refusals, both the out-of-band keys the fleet does not own, REFUSED (not torn down). srv4 (installed with the fleet key in the seed) yields the empty converged plan — the negative control that proves the reconcile does not fabricate work. The R5-wall RED control (reconcile_would_teardown_only_if_ownership_claimed_it) reconstructs the wall's hinge: feed a ownership fn that lies 'Owned' about the foreign keys and the SAME spine WOULD emit teardowns — so the refusal is caused by ownership_of returning Absent, not by the spine being unable to teardown. That makes the wall discriminating rather than asserted."

fn srv3_plan() -> MembershipPlan<SshPublicKey> {
  host_authorized_keys_reconcile(observed: srv3_observed_authorized_keys)
}

fn srv4_plan() -> MembershipPlan<SshPublicKey> {
  host_authorized_keys_reconcile(observed: srv4_observed_authorized_keys)
}

test fn srv3_reconcile_adds_exactly_the_missing_fleet_key() -> Bool {
  let plan = srv3_plan()
  let upsert_materials = flat_map(plan.actions, a =>
    match a {
      MemberUpsert { member: m } => [m.material as String]
      MemberTeardown { member: _ } => []
      MemberTeardownRefused { member: _, cause: _ } => []
    }
  )
  count(upsert_materials) == 1
    && any(upsert_materials, m => m == fleet_automation_ssh_key.material as String)
}

test fn srv3_reconcile_refuses_both_unowned_keys_never_teardown() -> Bool {
  let plan = srv3_plan()
  let tally = membership_tally(plan: plan)
  let refused_materials = flat_map(plan.actions, a =>
    match a {
      MemberTeardownRefused { member: m, cause: OwnershipUnknown } => [m.material as String]
      MemberTeardownRefused { member: _, cause: MemberNotOwned } => []
      MemberUpsert { member: _ } => []
      MemberTeardown { member: _ } => []
    }
  )
  tally.upserts == 1
    && tally.teardowns == 0
    && tally.refusals == 2
    && any(refused_materials, m => m == srv3_observed_node_orch_srv2_key.material as String)
    && any(refused_materials, m => m == srv3_observed_briansrls_srv1_key.material as String)
}

test fn srv4_reconcile_is_converged_empty_plan() -> Bool {
  let tally = membership_tally(plan: srv4_plan())
  tally.upserts == 0 && tally.teardowns == 0 && tally.refusals == 0
}

test fn srv3_and_srv4_disagree_on_convergence() -> Bool {
  let srv3 = membership_tally(plan: srv3_plan())
  let srv4 = membership_tally(plan: srv4_plan())
  (srv3.upserts + srv3.refusals) > 0
    && (srv4.upserts + srv4.teardowns + srv4.refusals) == 0
}

fn ownership_lies_owned(k: SshPublicKey) -> Ownership? {
  Present { value: Owned }
}

test fn reconcile_would_teardown_only_if_ownership_claimed_it() -> Bool {
  let honest = membership_tally(plan: srv3_plan())
  let lying = membership_tally(plan: membership_reconcile(
    desired: fleet_authorized_keys,
    observed: srv3_observed_authorized_keys,
    key_of: authorized_key_identity,
    key_eq: authorized_key_identity_eq,
    value_eq: authorized_key_value_eq,
    ownership_of: ownership_lies_owned,
  ))
  honest.refusals == 2
    && honest.teardowns == 0
    && lying.refusals == 0
    && lying.teardowns == 2
}

test fn comment_only_drift_is_reupsert_not_remove_add() -> Bool {
  let renamed_macbook = SshPublicKey {
    algorithm: operator_macbook_ssh_key.algorithm,
    material: operator_macbook_ssh_key.material,
    comment: "macbook-m4-renamed",
  }
  let observed = [renamed_macbook, fleet_automation_ssh_key]
  let tally = membership_tally(plan: host_authorized_keys_reconcile(observed: observed))
  tally.upserts == 1 && tally.teardowns == 0 && tally.refusals == 0
}
