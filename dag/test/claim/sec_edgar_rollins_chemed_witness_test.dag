module test.claim.sec_edgar_rollins_chemed_witness


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data sec_edgar_witness_note: String = "Rollins and Chemed both tag a CostOfGoodsAndService variant instead of GrossProfit on their FY2025 10-Ks (see rollins_facts / chemed_facts provenance notes), so the profitability witness here derives OPERATING margin (OperatingIncomeLoss / revenue) rather than gross margin. derive_gross_margin_ratio_from_facts is reused as-is — the ratio math (profit / revenue, revenue > 0) is agnostic to which profit line is passed in; no new facts.dag function is needed for this."

data rollins_fy2025_operating_margin_ratio_low: Float = 0.1930

data rollins_fy2025_operating_margin_ratio_high: Float = 0.1931

data chemed_fy2025_operating_margin_ratio_low: Float = 0.1336

data chemed_fy2025_operating_margin_ratio_high: Float = 0.1337

test fn w_rollins_cik_verified_on_edgar() -> Bool {
  extdeps.sec.edgar.cik_padded_digits(cik: extdeps.sec.issuer.rollins.rollins_cik) == "0000084839"
}

test fn w_chemed_cik_verified_on_edgar() -> Bool {
  extdeps.sec.edgar.cik_padded_digits(cik: extdeps.sec.issuer.chemed.chemed_cik) == "0000019584"
}

test fn w_rollins_operating_margin_derivation_matches_filed_facts() -> Bool {
  match extdeps.sec.facts.derive_gross_margin_ratio_from_facts(
    revenue: extdeps.sec.issuer.rollins_facts.rollins_fy2025_revenue,
    gross_profit: extdeps.sec.issuer.rollins_facts.rollins_fy2025_operating_income
  ) {
    Present { value: ratio } =>
      extdeps.sec.facts.gross_margin_ratio_in_band(
        ratio: ratio,
        low: rollins_fy2025_operating_margin_ratio_low,
        high: rollins_fy2025_operating_margin_ratio_high
      )
    _ => false
  }
}

test fn w_chemed_operating_margin_derivation_matches_filed_facts() -> Bool {
  match extdeps.sec.facts.derive_gross_margin_ratio_from_facts(
    revenue: extdeps.sec.issuer.chemed_facts.chemed_fy2025_revenue,
    gross_profit: extdeps.sec.issuer.chemed_facts.chemed_fy2025_operating_income
  ) {
    Present { value: ratio } =>
      extdeps.sec.facts.gross_margin_ratio_in_band(
        ratio: ratio,
        low: chemed_fy2025_operating_margin_ratio_low,
        high: chemed_fy2025_operating_margin_ratio_high
      )
    _ => false
  }
}

test fn w_rollins_operating_margin_red_on_perturbed_operating_income() -> Bool {
  match extdeps.sec.facts.filed_amount(fact: extdeps.sec.issuer.rollins_facts.rollins_fy2025_operating_income) {
    Present { value: oi } => {
      let perturbed = extdeps.sec.facts.usd_whole_dollars(count: extdeps.sec.facts.usd_whole_dollars_count(oi) + 1000000)
      match extdeps.sec.facts.derive_gross_margin_ratio_from_facts(
        revenue: extdeps.sec.issuer.rollins_facts.rollins_fy2025_revenue,
        gross_profit: extdeps.sec.facts.FiledMonetaryFact { element: rollins_fy2025_operating_income.element, amount: Filed { amount: perturbed }, citation: rollins_fy2025_operating_income.citation }
      ) {
        Present { value: ratio } =>
          !extdeps.sec.facts.gross_margin_ratio_in_band(
            ratio: ratio,
            low: rollins_fy2025_operating_margin_ratio_low,
            high: rollins_fy2025_operating_margin_ratio_high
          )
        _ => false
      }
    }
    _ => false
  }
}

test fn w_chemed_operating_margin_red_on_perturbed_operating_income() -> Bool {
  match extdeps.sec.facts.filed_amount(fact: extdeps.sec.issuer.chemed_facts.chemed_fy2025_operating_income) {
    Present { value: oi } => {
      let perturbed = extdeps.sec.facts.usd_whole_dollars(count: extdeps.sec.facts.usd_whole_dollars_count(oi) + 1000000)
      match extdeps.sec.facts.derive_gross_margin_ratio_from_facts(
        revenue: extdeps.sec.issuer.chemed_facts.chemed_fy2025_revenue,
        gross_profit: extdeps.sec.facts.FiledMonetaryFact { element: chemed_fy2025_operating_income.element, amount: Filed { amount: perturbed }, citation: chemed_fy2025_operating_income.citation }
      ) {
        Present { value: ratio } =>
          !extdeps.sec.facts.gross_margin_ratio_in_band(
            ratio: ratio,
            low: chemed_fy2025_operating_margin_ratio_low,
            high: chemed_fy2025_operating_margin_ratio_high
          )
        _ => false
      }
    }
    _ => false
  }
}

