module test.claim.dissolution_census_a_projection_witness_test



data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = ReadsLiveTree

data census_tsv_path: String = "docs/probes/dissolution_census_a_ci_layer_roots_2026-08-03.tsv"
data census_summary_path: String = "docs/probes/dissolution_census_a_ci_layer_roots_2026-08-03.summary.json"

data witness_note: String = "Dissolution census A authority recut (operator 2026-08-03): the revision-pinned TSV is the canonical observation; summary JSON and markdown are generated projections via docs/probes/dissolution_census_a_ci_layer_roots_project.py. This witness enforces PER-GROUP agreement between TSV row prefixes and summary JSON declarations — not totals alone (Census B on PR #7749 had matching totals with five of six per-layer counts wrong). Summary counts are read through parse_json + json_object_unique_member into typed Int (not string_contains); the numeric-prefix fail-open class is closed BY CONSTRUCTION at that rung — no separate enrolled prefix regression witness (a wrong-count-against-correct-artifact probe cannot fail under either implementation). Offline perturbation evidence: docs/probes/dissolution_census_a_ci_layer_roots_project.py verify-red. witness_predicate_refuses_incorrect_group_counts is a predicate-discrimination control only, not a routing control on a drifted fixture. Full metric reconciliation (is_ref split, semantic classes, byte partition) is in the Python verify path. This witness is the discriminating structural-group gate enrolled per-PR."

fn census_tsv_text() -> String {
  filesystem_read(path: census_tsv_path).content
}

fn census_summary_text() -> String {
  filesystem_read(path: census_summary_path).content
}

fn census_summary_json() -> JsonValue? {
  parse_json(s: census_summary_text())
}

fn summary_int_member(doc: JsonValue, key: String) -> Int? {
  match json_object_unique_member(v: doc, key: key) {
    JsonMemberFound { value: v } =>
      match v {
        JsonNumber { lexeme: lx } => parse_int(s: lx as String)
        _ => none
      }
    _ => none
  }
}

fn summary_root_int_equals(key: String, count: Int) -> Bool {
  match census_summary_json() {
    Present { value: root } =>
      match summary_int_member(doc: root, key: key) {
        Present { value: n } => n == count
        Absent => false
      }
    Absent => false
  }
}

fn summary_structural_group_count(groups_doc: JsonValue, group: String) -> Int? {
  match json_object_unique_member(v: groups_doc, key: group) {
    JsonMemberFound { value: v } =>
      match v {
        JsonNumber { lexeme: lx } => parse_int(s: lx as String)
        _ => none
      }
    _ => none
  }
}

fn summary_group_declares(group: String, count: Int) -> Bool {
  match census_summary_json() {
    Present { value: root } =>
      match json_object_unique_member(v: root, key: "structural_groups") {
        JsonMemberFound { value: groups } =>
          match summary_structural_group_count(groups_doc: groups, group: group) {
            Present { value: n } => n == count
            Absent => false
          }
        _ => false
      }
    Absent => false
  }
}

fn summary_classifier_equals(want: String) -> Bool {
  match census_summary_json() {
    Present { value: root } =>
      match json_object_unique_member(v: root, key: "observation") {
        JsonMemberFound { value: obs } =>
          match json_object_unique_member(v: obs, key: "classifier") {
            JsonMemberFound { value: v } =>
              match v {
                JsonString { value: s } => s == want
                _ => false
              }
            _ => false
          }
        _ => false
      }
    Absent => false
  }
}

fn tsv_line_is_data_row(line: String) -> Bool {
  let trimmed = trim(line)
  trimmed != "" && !starts_with(s: trimmed, prefix: "structural_group")
}

fn tsv_line_has_group_prefix(line: String, group: String) -> Bool {
  starts_with(s: line, prefix: concat(group, "\t"))
}

fn tsv_count_group(group: String) -> Int {
  fold(split(s: census_tsv_text(), delimiter: "\n"), init: 0, f: fn(n, line) {
    if tsv_line_is_data_row(line: line) && tsv_line_has_group_prefix(line: line, group: group) {
      n + 1
    } else {
      n
    }
  })
}

fn tsv_total_data_rows() -> Int {
  fold(split(s: census_tsv_text(), delimiter: "\n"), init: 0, f: fn(n, line) {
    if tsv_line_is_data_row(line: line) {
      n + 1
    } else {
      n
    }
  })
}

fn witness_group_agrees(group: String, count: Int) -> Bool {
  tsv_count_group(group: group) == count && summary_group_declares(group: group, count: count)
}

test fn witness_structural_groups_match_between_tsv_and_summary() -> Bool {
  witness_group_agrees(group: "witnessexclusionrow", count: 154)
    && witness_group_agrees(group: "substratelonglanerow", count: 46)
    && witness_group_agrees(group: "rehomedbinwetrow", count: 18)
    && witness_group_agrees(group: "module_note", count: 24)
    && witness_group_agrees(group: "shared_template", count: 21)
    && tsv_total_data_rows() == 263
    && summary_root_int_equals(key: "total_sites", count: 263)
    && summary_root_int_equals(key: "inline_prose", count: 158)
    && summary_root_int_equals(key: "template_refs", count: 105)
    && summary_root_int_equals(key: "bytes_inline", count: 66329)
    && summary_classifier_equals(want: "dag-note-prose-census-lexical-v1")
}

test fn witness_predicate_refuses_incorrect_group_counts() -> Bool {
  tsv_count_group(group: "witnessexclusionrow") == 154
    && tsv_count_group(group: "module_note") == 24
    && tsv_total_data_rows() == 263
    && !summary_group_declares(group: "module_note", count: 25)
    && !summary_group_declares(group: "witnessexclusionrow", count: 153)
    && !(witness_group_agrees(group: "module_note", count: 25))
}
