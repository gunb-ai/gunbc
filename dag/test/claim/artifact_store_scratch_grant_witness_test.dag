module test.claim.artifact_store_scratch_grant_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

// P-B discriminating witnesses for std.artifact_store_scratch_grant (docs/plans/effect-namespace-grants.md 6). A /tmp/gunbc_* store root Permits Read+Write; a repo-tree or non-gunbc /tmp path is a located std.access.Deny from EffectRequest — the RED control for the extdeps.realization.artifact_store_fs construction wall.
data witness_scratch_root: String = "/tmp/gunbc_artifact_store_witness"
data repo_tree_root: String = "/home/user/gunbc/dag"
data non_gunbc_tmp_root: String = "/tmp/other_scratch"
data gunbc_prefix_without_separator_root: String = "/tmp/gunbcsomethingelse"

fn is_refused(a: std.access.AccessDecision) -> Bool {
  match a {
    Permit => false
    std.access.Deny { refusal: refusal } => true
  }
}

fn is_admitted(a: std.access.AccessDecision) -> Bool {
  match a {
    Permit => true
    std.access.Deny { refusal: refusal } => false
  }
}

test fn artifact_store_scratch_grant_admits_gunbc_tmp_holds() -> Bool {
  test.claim.artifact_store_scratch_grant_witness.is_admitted(a: artifact_store_scratch_write_admissible(store_root: witness_scratch_root))
    && test.claim.artifact_store_scratch_grant_witness.is_admitted(a: artifact_store_scratch_read_admissible(store_root: witness_scratch_root))
}

test fn artifact_store_scratch_grant_refuses_repo_tree_holds() -> Bool {
  test.claim.artifact_store_scratch_grant_witness.is_refused(a: artifact_store_scratch_write_admissible(store_root: repo_tree_root))
    && test.claim.artifact_store_scratch_grant_witness.is_refused(a: artifact_store_scratch_read_admissible(store_root: repo_tree_root))
}

test fn artifact_store_scratch_grant_refuses_non_gunbc_tmp_holds() -> Bool {
  test.claim.artifact_store_scratch_grant_witness.is_refused(a: artifact_store_scratch_write_admissible(store_root: non_gunbc_tmp_root))
}

test fn artifact_store_scratch_grant_refuses_gunbc_prefix_without_separator_holds() -> Bool {
  test.claim.artifact_store_scratch_grant_witness.is_refused(a: artifact_store_scratch_write_admissible(store_root: gunbc_prefix_without_separator_root))
}

test fn artifact_store_scratch_grant_refusal_is_located() -> Bool {
  match artifact_store_scratch_write_admissible(store_root: repo_tree_root) {
    std.access.Deny { refusal: refusal } =>
      refusal.location.profile == "EffectRequest"
        && refusal.location.subject == artifact_store_scratch_frame.name
        && refusal.location.action == "write"
    Permit => false
  }
}
