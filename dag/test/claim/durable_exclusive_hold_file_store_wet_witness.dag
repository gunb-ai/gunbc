module test.claim.durable_exclusive_hold_file_store_wet_witness

import extdeps.shell
import extdeps.filesystem.filesystem_io { Filesystem }
import std.types { Bool, Int, NonEmptyStr, String }
import std.algebra { string_contains, string_concat_join }
import std.optional { Present, Absent }
import std.durable_compare_and_set { CasSlotObservation, cas_generation_count }
import std.durable_exclusive_hold {
  DurableHoldOwnerRef, DurableHoldReleaseRef, DurableHoldReleaseRefusal, DurableHoldHolderLiveness,
  HolderObservedDead, HolderObservedLive,
  HoldReleaseSlotAbsent, HoldReleaseAlreadyFree, HoldReleaseHeldByAnotherOwner,
  HoldReleaseAgainstAnotherGeneration, HoldReleaseSlotUndecodable, HoldReleaseObservationUnavailable,
}
import gunbc.durable_cas_file_store { cas_file_slot_path }
import std.process { ProcessExit, ExitSuccess, ExitFailure }
import gunbc.machine_intake.arrival_subject { admit_arrival_subject, ArrivalSubjectInPopulation }
import gunbc.machine_intake.arrival_interlock {
  arrival_after_acquire, arrival_archive_slot_acquire, arrival_archive_slot_release, arrival_holder_run_liveness,
  ArrivalArchiveSlotAcquired, ArrivalArchiveSlotAcquireRefused, ArrivalArchiveSlotReleaseRefused,
}
import gunbc.durable_exclusive_hold_file_store {
  FileHoldAcquireOutcome, FileHoldAcquired, FileHoldOccupied, FileHoldAcquireLost,
  FileHoldAcquireStoreUnavailable, FileHoldSlotUndecodable, FileHoldKeyNotSlotAddressable,
  FileHoldAcquirePlan, FileHoldAcquirePreparation, FileHoldAcquirePlanned, FileHoldAcquireNotEligible,
  file_hold_acquire, file_hold_acquire_prepare, file_hold_acquire_commit,
  FileHoldReleasePlan, FileHoldReleaseAssessment, FileHoldReleasePlanned, FileHoldReleaseNotEligible,
  FileHoldReleaseOutcome, FileHoldReleased, FileHoldReleaseLost, FileHoldReleaseStoreUnavailable,
  FileHoldReleaseKeyNotSlotAddressable,
  file_hold_release_assess, file_hold_release_commit,
}

// WET CONTROLS FOR THE HOLD PROTOCOL OVER THE REAL FILE STORE. The pure walls
// are test.claim.durable_exclusive_hold_witness; this file reaches the host,
// because the facts here -- a hold LANDS, a second contender LOSES, a release
// COMMITS, a store fault is NOT contention -- are only establishable by running
// the compare-and-set against a filesystem. Enrolled on the local-repo wet lane
// (throwaway temp directory, no network), beside the CAS store's own wet rows.

fn wh_owner(text: String) -> DurableHoldOwnerRef {
  text as DurableHoldOwnerRef
}

// A holder the arrival shape-gate WILL decode: arrival/<host>/<run>, the exact form arrival_run mints.
fn wh_arrival_owner(host: String, run: String) -> DurableHoldOwnerRef {
  string_concat_join(fields: ["arrival/", host, "/", run], separator: "") as DurableHoldOwnerRef
}

// The acquire REQUIRES an explicit liveness reader (no default). On the fresh / self-holder / shape-gate rows
// it is never invoked -- those arms are decided before the store's recovery. On the Recovered / Live rows it
// is exactly what decides whether the held run is dead. It is passed explicitly by every caller.
fn wh_reader_unseen(_run: String) -> DurableHoldHolderLiveness { HolderObservedLive { evidence: "unseen" as NonEmptyStr } }
fn wh_reader_dead(_run: String) -> DurableHoldHolderLiveness { HolderObservedDead { evidence: "injected-dead" as NonEmptyStr } }
fn wh_reader_live(_run: String) -> DurableHoldHolderLiveness { HolderObservedLive { evidence: "injected-live" as NonEmptyStr } }

fn wh_release(text: String) -> DurableHoldReleaseRef {
  text as DurableHoldReleaseRef
}

fn wh_fresh_root() -> String {
  shell.Mktemp.DirWithTemplate(template: "/tmp/gunbc_hold.XXXXXX").path
}

fn wh_acquired_at(o: FileHoldAcquireOutcome, generation: Int) -> Bool {
  match o {
    FileHoldAcquired { slot_key: _, owner: _, generation: g } => cas_generation_count(g: g) == generation
    _ => false
  }
}

fn wh_occupied_by(o: FileHoldAcquireOutcome, holder: String) -> Bool {
  match o {
    FileHoldOccupied { slot_key: _, holder: h, generation: _ } => (h as String) == holder
    _ => false
  }
}

fn wh_acquire_lost(o: FileHoldAcquireOutcome) -> Bool {
  match o {
    FileHoldAcquireLost { slot_key: _ } => true
    _ => false
  }
}

fn wh_acquire_store_unavailable(o: FileHoldAcquireOutcome) -> Bool {
  match o {
    FileHoldAcquireStoreUnavailable { slot_key: _, cause: _ } => true
    _ => false
  }
}

fn wh_acquire_plan(root: NonEmptyStr, owner: String) -> FileHoldAcquirePlan? {
  match file_hold_acquire_prepare(root: root, slot_key: "cell", requested_owner: wh_owner(text: owner)) {
    FileHoldAcquirePlanned { plan: p } => Present { value: p }
    FileHoldAcquireNotEligible { slot_key: _, refusal: _ } => none
  }
}

fn wh_acquire_commit(p: FileHoldAcquirePlan?) -> FileHoldAcquireOutcome? {
  match p {
    Present { value: plan } => Present { value: file_hold_acquire_commit(plan: plan) }
    Absent => none
  }
}

fn wh_acquired_at_opt(o: FileHoldAcquireOutcome?, generation: Int) -> Bool {
  match o {
    Present { value: v } => wh_acquired_at(o: v, generation: generation)
    Absent => false
  }
}

fn wh_acquire_lost_opt(o: FileHoldAcquireOutcome?) -> Bool {
  match o {
    Present { value: v } => wh_acquire_lost(o: v)
    Absent => false
  }
}

fn wh_acquire_store_unavailable_opt(o: FileHoldAcquireOutcome?) -> Bool {
  match o {
    Present { value: v } => wh_acquire_store_unavailable(o: v)
    Absent => false
  }
}

fn wh_slot_bytes(root: NonEmptyStr, generation: Int) -> String {
  let read = Filesystem.Read(path: cas_file_slot_path(root: root, key: "cell", generation: generation))
  if read.success { read.content } else { "" }
}

fn wh_slot_generation_absent(root: NonEmptyStr, generation: Int) -> Bool {
  !Filesystem.Read(path: cas_file_slot_path(root: root, key: "cell", generation: generation)).success
}

fn wh_assess(root: NonEmptyStr, owner: String, acquired: Int, reason: String) -> FileHoldReleaseAssessment {
  file_hold_release_assess(
    root: root, slot_key: "cell",
    owner: wh_owner(text: owner), acquired_generation: acquired, released_by: wh_release(text: reason),
  )
}

fn wh_plan(a: FileHoldReleaseAssessment) -> FileHoldReleasePlan? {
  match a {
    FileHoldReleasePlanned { plan: p } => Present { value: p }
    FileHoldReleaseNotEligible { slot_key: _, refusal: _ } => none
  }
}

fn wh_not_eligible(a: FileHoldReleaseAssessment) -> Bool {
  match a {
    FileHoldReleaseNotEligible { slot_key: _, refusal: _ } => true
    FileHoldReleasePlanned { plan: _ } => false
  }
}

fn wh_released_at(o: FileHoldReleaseOutcome?, generation: Int) -> Bool {
  match o {
    Present { value: FileHoldReleased { slot_key: _, generation: g } } => cas_generation_count(g: g) == generation
    _ => false
  }
}

fn wh_release_lost(o: FileHoldReleaseOutcome?) -> Bool {
  match o {
    Present { value: FileHoldReleaseLost { slot_key: _ } } => true
    _ => false
  }
}

fn wh_commit(p: FileHoldReleasePlan?) -> FileHoldReleaseOutcome? {
  match p {
    Present { value: plan } => Present { value: file_hold_release_commit(plan: plan) }
    Absent => none
  }
}

// AN ABSENT SLOT ACQUIRES AT GENERATION 1, AND THE BYTES ON DISK ARE THE
// SHARED SPELLING: the held tag followed by exactly the owner. Read back through
// the filesystem rather than through the store, so the row establishes what was
// WRITTEN and not what the codec says it would write.
test fn an_absent_slot_acquires_at_generation_one_by_real_execution() -> Bool {
  let root_path = wh_fresh_root()
  let root = root_path as NonEmptyStr
  let first = file_hold_acquire(root: root, slot_key: "cell", requested_owner: wh_owner(text: "demand-7|offer-1"))
  let bytes = wh_slot_bytes(root: root, generation: 1)
  let removed = shell.Remove.RecursiveForce(path: root_path)
  wh_acquired_at(o: first, generation: 1) && bytes == "held|demand-7|offer-1" && removed.success
}

// A HELD SLOT REFUSES WITHOUT WRITING -- to another owner AND to its own owner's
// spelling. The generation-2 file must not exist after either attempt: an
// occupied answer that had nonetheless advanced the slot would be the
// overwrite the protocol exists to forbid, wearing a refusal's name.
test fn a_held_slot_refuses_another_owner_without_writing_by_real_execution() -> Bool {
  let root_path = wh_fresh_root()
  let root = root_path as NonEmptyStr
  let first = file_hold_acquire(root: root, slot_key: "cell", requested_owner: wh_owner(text: "demand-7|offer-1"))
  let second = file_hold_acquire(root: root, slot_key: "cell", requested_owner: wh_owner(text: "demand-9|offer-4"))
  let no_advance = wh_slot_generation_absent(root: root, generation: 2)
  let bytes = wh_slot_bytes(root: root, generation: 1)
  let removed = shell.Remove.RecursiveForce(path: root_path)
  wh_acquired_at(o: first, generation: 1)
    && wh_occupied_by(o: second, holder: "demand-7|offer-1")
    && no_advance
    && bytes == "held|demand-7|offer-1"
    && removed.success
}

test fn a_held_slot_refuses_its_own_owners_spelling_without_writing_by_real_execution() -> Bool {
  let root_path = wh_fresh_root()
  let root = root_path as NonEmptyStr
  let first = file_hold_acquire(root: root, slot_key: "cell", requested_owner: wh_owner(text: "demand-7|offer-1"))
  let again = file_hold_acquire(root: root, slot_key: "cell", requested_owner: wh_owner(text: "demand-7|offer-1"))
  let no_advance = wh_slot_generation_absent(root: root, generation: 2)
  let removed = shell.Remove.RecursiveForce(path: root_path)
  wh_acquired_at(o: first, generation: 1)
    && wh_occupied_by(o: again, holder: "demand-7|offer-1")
    && no_advance
    && removed.success
}

// THE FULL CYCLE: held at 1, released to free at 2 with the free bytes on
// disk, reacquired at 3. The reacquire is the row that proves a released slot is
// not a dead slot, and that the acquire derives generation 2 from its own read
// rather than from anything the caller said.
test fn a_released_slot_is_free_at_n_plus_one_and_reacquires_at_n_plus_two_by_real_execution() -> Bool {
  let root_path = wh_fresh_root()
  let root = root_path as NonEmptyStr
  let first = file_hold_acquire(root: root, slot_key: "cell", requested_owner: wh_owner(text: "demand-7|offer-1"))
  let released = wh_commit(p: wh_plan(a: wh_assess(root: root, owner: "demand-7|offer-1", acquired: 1, reason: "attempt abandoned")))
  let free_bytes = wh_slot_bytes(root: root, generation: 2)
  let second = file_hold_acquire(root: root, slot_key: "cell", requested_owner: wh_owner(text: "demand-9|offer-4"))
  let held_bytes = wh_slot_bytes(root: root, generation: 3)
  let removed = shell.Remove.RecursiveForce(path: root_path)
  wh_acquired_at(o: first, generation: 1)
    && wh_released_at(o: released, generation: 2)
    && free_bytes == "free|attempt abandoned"
    && wh_acquired_at(o: second, generation: 3)
    && held_bytes == "held|demand-9|offer-4"
    && removed.success
}

// TWO CONTENDERS, ONE LIVE READ, ONE WINNER. The slot is free at 2; ONE
// prepare performs the live read and mints ONE sealed plan; two commits of that
// same plan race to the store. Exactly one is admitted; the other is a lost race
// AFTER the read -- not Occupied, which would say it was never eligible, and not
// a store fault. This is the case the protocol exists for, and it is staged
// without any caller-supplied observation: the plan is the only thing shared.
test fn one_live_plan_committed_by_two_contenders_gives_one_commit_and_one_lost_race_by_real_execution() -> Bool {
  let root_path = wh_fresh_root()
  let root = root_path as NonEmptyStr
  let first = file_hold_acquire(root: root, slot_key: "cell", requested_owner: wh_owner(text: "demand-7|offer-1"))
  let released = wh_commit(p: wh_plan(a: wh_assess(root: root, owner: "demand-7|offer-1", acquired: 1, reason: "done")))
  let plan = wh_acquire_plan(root: root, owner: "contender-a")
  let a = wh_acquire_commit(p: plan)
  let b = wh_acquire_commit(p: plan)
  let bytes = wh_slot_bytes(root: root, generation: 3)
  let no_fourth = wh_slot_generation_absent(root: root, generation: 4)
  let removed = shell.Remove.RecursiveForce(path: root_path)
  wh_acquired_at(o: first, generation: 1)
    && wh_released_at(o: released, generation: 2)
    && wh_acquired_at_opt(o: a, generation: 3)
    && wh_acquire_lost_opt(o: b)
    && bytes == "held|contender-a"
    && no_fourth
    && removed.success
}

// A STORE REFUSAL IS NOT CONTENTION. The root is a regular file, so the store
// cannot observe or publish; that must surface as unavailable and never as a
// lost race or an occupied slot, or a caller would wait forever for a holder
// that does not exist (recurring_failure_mode store_refusal_reported_as_contention).
test fn a_store_refusal_is_reported_as_unavailable_not_as_a_lost_race_by_real_execution() -> Bool {
  let root_path = wh_fresh_root()
  let blocker = concat(root_path, "/not-a-directory")
  let planted = Filesystem.Write(path: blocker, content: "not a store root")
  let outcome = file_hold_acquire(root: blocker as NonEmptyStr, slot_key: "cell", requested_owner: wh_owner(text: "demand-7|offer-1"))
  let removed = shell.Remove.RecursiveForce(path: root_path)
  planted.success && wh_acquire_store_unavailable(o: outcome) && !wh_acquire_lost(o: outcome) && removed.success
}

// THE SAME DISTINCTION AT THE WRITE, NOT ONLY AT THE READ. The row above
// reaches the store fault while READING (the root is a file, so nothing can be
// read), and a mutation that collapsed only the commit's CasStoreRefused arm
// into a lost race passed it -- measured on this PR's mutation table. So this
// row prepares a real plan against a real empty root, then mutates THAT store
// between prepare and commit: the directory is removed and a regular file is put
// in its place. The commit's own publication is refused by the store, and that
// must surface as unavailable, not as a race lost after the read. The plan is
// bound to the root it was read from; nothing is rebound.
test fn a_write_time_store_refusal_is_reported_as_unavailable_not_as_a_lost_race_by_real_execution() -> Bool {
  let root_path = wh_fresh_root()
  let root = root_path as NonEmptyStr
  let plan = wh_acquire_plan(root: root, owner: "demand-7|offer-1")
  let removed_dir = shell.Remove.RecursiveForce(path: root_path)
  let planted = Filesystem.Write(path: root_path, content: "not a store root any more")
  let outcome = wh_acquire_commit(p: plan)
  let removed = shell.Remove.RecursiveForce(path: root_path)
  removed_dir.success
    && planted.success
    && wh_acquire_store_unavailable_opt(o: outcome)
    && !wh_acquire_lost_opt(o: outcome)
    && removed.success
}

// THE RELEASE PLAN IS MINTED FROM THE LIVE READ AND CARRIES THE FREE BYTES IN
// THE SHARED SPELLING. The generation on the plan is the store's, and the payload
// the commit will write is the free tag followed by exactly the release
// reference -- the bytes the fabric's release wrote before the extraction.
test fn a_live_release_plan_carries_the_observed_generation_and_the_free_bytes_by_real_execution() -> Bool {
  let root_path = wh_fresh_root()
  let root = root_path as NonEmptyStr
  let first = file_hold_acquire(root: root, slot_key: "cell", requested_owner: wh_owner(text: "demand-7|offer-1"))
  let plan = wh_plan(a: wh_assess(root: root, owner: "demand-7|offer-1", acquired: 1, reason: "attempt abandoned before execution"))
  let removed = shell.Remove.RecursiveForce(path: root_path)
  let plan_ok = match plan {
    Present { value: p } =>
      cas_generation_count(g: p.generation) == 1
        && (p.slot_key as String) == "cell"
        && (p.root as String) == root_path
        && (p.free_payload as String) == "free|attempt abandoned before execution"
    Absent => false
  }
  wh_acquired_at(o: first, generation: 1) && plan_ok && removed.success
}

// FOUR RELEASE REFUSALS, AND NONE OF THEM FREES. Each refusal is checked
// against the disk as well as the outcome: the next generation must not exist
// afterwards. Absent, already free, another owner's hold, and the right owner at
// the wrong generation.
test fn refused_releases_do_not_free_the_slot_by_real_execution() -> Bool {
  let root_path = wh_fresh_root()
  let root = root_path as NonEmptyStr
  let absent = wh_assess(root: root, owner: "demand-7|offer-1", acquired: 1, reason: "stale")
  let absent_untouched = wh_slot_generation_absent(root: root, generation: 1)
  let first = file_hold_acquire(root: root, slot_key: "cell", requested_owner: wh_owner(text: "demand-7|offer-1"))
  let other = wh_assess(root: root, owner: "demand-9|offer-4", acquired: 1, reason: "not mine")
  let wrong_generation = wh_assess(root: root, owner: "demand-7|offer-1", acquired: 2, reason: "stale")
  let still_held = wh_slot_generation_absent(root: root, generation: 2) && wh_slot_bytes(root: root, generation: 1) == "held|demand-7|offer-1"
  let released = wh_commit(p: wh_plan(a: wh_assess(root: root, owner: "demand-7|offer-1", acquired: 1, reason: "done")))
  let twice = wh_assess(root: root, owner: "demand-7|offer-1", acquired: 2, reason: "again")
  let no_third = wh_slot_generation_absent(root: root, generation: 3)
  let removed = shell.Remove.RecursiveForce(path: root_path)
  wh_not_eligible(a: absent) && absent_untouched
    && wh_acquired_at(o: first, generation: 1)
    && wh_not_eligible(a: other)
    && wh_not_eligible(a: wrong_generation)
    && still_held
    && wh_released_at(o: released, generation: 2)
    && wh_not_eligible(a: twice)
    && no_third
    && removed.success
}

// A RACE BETWEEN ASSESS AND COMMIT IS RELEASE-LOST, NOT SUCCESS. The plan was
// minted against the slot held at 1; before it commits, the slot moves (here,
// the same plan is committed once, which frees it). The second commit of that
// plan must lose rather than write free over free -- a caller that had settled
// against the plan learns its settlement and the slot have come apart.
test fn a_release_committed_after_the_slot_moved_is_lost_not_successful_by_real_execution() -> Bool {
  let root_path = wh_fresh_root()
  let root = root_path as NonEmptyStr
  let first = file_hold_acquire(root: root, slot_key: "cell", requested_owner: wh_owner(text: "demand-7|offer-1"))
  let plan = wh_plan(a: wh_assess(root: root, owner: "demand-7|offer-1", acquired: 1, reason: "done"))
  let committed = wh_commit(p: plan)
  let again = wh_commit(p: plan)
  let no_third = wh_slot_generation_absent(root: root, generation: 3)
  let removed = shell.Remove.RecursiveForce(path: root_path)
  wh_acquired_at(o: first, generation: 1)
    && wh_released_at(o: committed, generation: 2)
    && wh_release_lost(o: again)
    && no_third
    && removed.success
}

test fn w_after_acquire_invokes_the_real_slot_release() -> Bool {
  let root_path = wh_fresh_root()
  let root = root_path as NonEmptyStr
  match admit_arrival_subject(wire: "mtjade1") {
    ArrivalSubjectInPopulation { subject: s } =>
      match arrival_after_acquire(
        outcome: arrival_archive_slot_acquire(
          root: root,
          subject: s,
          owner: "arrival-release-inhabitance" as DurableHoldOwnerRef,
          self_run_id: "wet-witness-run",
          live_reader: wh_reader_unseen,
        ),
        body: fn() { ExitSuccess },
        release_fn: fn(h) { arrival_archive_slot_release(root: root, held: h) },
      ) {
        ExitFailure { code: _, reason: _ } =>
          shell.Remove.RecursiveForce(path: root_path).success && false
        ExitSuccess =>
          match arrival_archive_slot_acquire(
            root: root,
            subject: s,
            owner: "arrival-release-inhabitance-2" as DurableHoldOwnerRef,
            self_run_id: "wet-witness-run",
            live_reader: wh_reader_unseen,
          ) {
            ArrivalArchiveSlotAcquireRefused { cause: _ } =>
              shell.Remove.RecursiveForce(path: root_path).success && false
            ArrivalArchiveSlotAcquired { held: _ } =>
              shell.Remove.RecursiveForce(path: root_path).success
          }
      }
    _ => shell.Remove.RecursiveForce(path: root_path).success && false
  }
}

fn arrival_body_writes_marker(marker: String) -> ProcessExit {
  if Filesystem.WriteCreateNew(path: marker, content: "BODY").success {
    ExitSuccess
  } else {
    ExitFailure { code: 1, reason: "marker write failed" }
  }
}

test fn w_failed_acquire_runs_no_body() -> Bool {
  let root_path = wh_fresh_root()
  let marker = concat(root_path, "/body-ran")
  match arrival_after_acquire(
    outcome: ArrivalArchiveSlotAcquireRefused { cause: "slot occupied" as NonEmptyStr },
    body: fn() { arrival_body_writes_marker(marker: marker) },
    release_fn: fn(h) {
      ArrivalArchiveSlotReleaseRefused { cause: "release must not run on refused acquire" as NonEmptyStr }
    },
  ) {
    ExitSuccess => shell.Remove.RecursiveForce(path: root_path).success && false
    ExitFailure { code: _, reason: _ } =>
      !Filesystem.Read(path: marker).success && shell.Remove.RecursiveForce(path: root_path).success
  }
}

test fn w_refused_acquire_body_writes_a_marker_when_called_directly() -> Bool {
  let root_path = wh_fresh_root()
  let marker = concat(root_path, "/body-ran")
  match arrival_body_writes_marker(marker: marker) {
    ExitFailure { code: _, reason: _ } =>
      shell.Remove.RecursiveForce(path: root_path).success && false
    ExitSuccess =>
      Filesystem.Read(path: marker).success && shell.Remove.RecursiveForce(path: root_path).success
  }
}

// A SELF-HOLDER is REFUSED, not recovered. The slot is held by a run id that IS this run's own id; GitHub
// keeps a run id across re-run attempts, so a re-run of a run that died holding the slot must be told "that
// is you -- finish or cancel run <id> first", never treated as another arrival, and never recovered by its
// own re-run. Decided before any read, so it runs with no network. Discriminating: if the self-holder were
// dropped into the generic occupied path it would try to recover (and read) instead of naming the run.
test fn w_self_holder_is_refused_not_recovered() -> Bool {
  let root_path = wh_fresh_root()
  let root = root_path as NonEmptyStr
  match admit_arrival_subject(wire: "mtjade1") {
    ArrivalSubjectInPopulation { subject: s } =>
      match arrival_archive_slot_acquire(
        root: root, subject: s, owner: wh_arrival_owner(s.host as String, "self-holder-run"), self_run_id: "self-holder-run", live_reader: wh_reader_unseen,
      ) {
        ArrivalArchiveSlotAcquired { held: _ } =>
          match arrival_archive_slot_acquire(
            root: root, subject: s, owner: wh_arrival_owner(s.host as String, "retry-owner"), self_run_id: "self-holder-run", live_reader: wh_reader_unseen,
          ) {
            ArrivalArchiveSlotAcquireRefused { cause: c } =>
              string_contains(s: c as String, pattern: "this very run")
                && string_contains(s: c as String, pattern: "controller untouched")
                && shell.Remove.RecursiveForce(path: root_path).success
            ArrivalArchiveSlotAcquired { held: _ } =>
              shell.Remove.RecursiveForce(path: root_path).success && false
          }
        _ => shell.Remove.RecursiveForce(path: root_path).success && false
      }
    _ => shell.Remove.RecursiveForce(path: root_path).success && false
  }
}

// A HOLDER THAT IS NOT THE arrival/<host>/<run_id> SHAPE REFUSES BEFORE THE STORE IS TOUCHED AND BEFORE ANY
// READ: absence of evidence is not evidence of death. Discriminating: if the shape-gate were removed, the
// unshaped holder would fall through to the recovery (and its declared read) instead of this refusal.
test fn w_unshaped_holder_refuses_before_the_read() -> Bool {
  let root_path = wh_fresh_root()
  let root = root_path as NonEmptyStr
  match admit_arrival_subject(wire: "mtjade1") {
    ArrivalSubjectInPopulation { subject: s } =>
      match arrival_archive_slot_acquire(
        root: root, subject: s, owner: wh_owner("not-an-arrival-holder"), self_run_id: "some-run", live_reader: wh_reader_unseen,
      ) {
        ArrivalArchiveSlotAcquired { held: _ } =>
          match arrival_archive_slot_acquire(
            root: root, subject: s, owner: wh_arrival_owner(s.host as String, "another-run"), self_run_id: "some-run", live_reader: wh_reader_unseen,
          ) {
            ArrivalArchiveSlotAcquireRefused { cause: c } =>
              string_contains(s: c as String, pattern: "is not arrival/")
                && string_contains(s: c as String, pattern: "controller untouched")
                && shell.Remove.RecursiveForce(path: root_path).success
            ArrivalArchiveSlotAcquired { held: _ } =>
              shell.Remove.RecursiveForce(path: root_path).success && false
          }
        _ => shell.Remove.RecursiveForce(path: root_path).success && false
      }
    _ => shell.Remove.RecursiveForce(path: root_path).success && false
  }
}

// THE DEAD-HOLDER RECOVERY, driven by the injected liveness reader (the seam), with no network. A slot is
// held by a shaped arrival owner; a newcomer acquires. When the injected reader reports the held run DEAD,
// the recovery frees the slot and the re-acquire LANDS. Discriminating: if recovery were removed the
// re-acquire would refuse; if absence were treated as dead the Live row below would wrongly land here.
test fn w_dead_holder_is_recovered_and_reacquired() -> Bool {
  let root_path = wh_fresh_root()
  let root = root_path as NonEmptyStr
  match admit_arrival_subject(wire: "mtjade1") {
    ArrivalSubjectInPopulation { subject: s } =>
      match arrival_archive_slot_acquire(
        root: root, subject: s, owner: wh_arrival_owner(s.host as String, "dead-run"), self_run_id: "acquirer-a", live_reader: wh_reader_unseen,
      ) {
        ArrivalArchiveSlotAcquired { held: _ } =>
          match arrival_archive_slot_acquire(
            root: root, subject: s, owner: wh_arrival_owner(s.host as String, "newcomer"), self_run_id: "acquirer-b", live_reader: wh_reader_dead,
          ) {
            ArrivalArchiveSlotAcquired { held: _ } => shell.Remove.RecursiveForce(path: root_path).success
            ArrivalArchiveSlotAcquireRefused { cause: _ } => shell.Remove.RecursiveForce(path: root_path).success && false
          }
        _ => shell.Remove.RecursiveForce(path: root_path).success && false
      }
    _ => shell.Remove.RecursiveForce(path: root_path).success && false
  }
}

// A LIVE holder is NOT recovered: the injected reader says the held run is live, so recovery refuses and the
// acquire refuses -- the slot stays held, controller untouched. Discriminating the dead/live split.
test fn w_live_holder_is_not_recovered() -> Bool {
  let root_path = wh_fresh_root()
  let root = root_path as NonEmptyStr
  match admit_arrival_subject(wire: "mtjade1") {
    ArrivalSubjectInPopulation { subject: s } =>
      match arrival_archive_slot_acquire(
        root: root, subject: s, owner: wh_arrival_owner(s.host as String, "live-run"), self_run_id: "acquirer-a", live_reader: wh_reader_unseen,
      ) {
        ArrivalArchiveSlotAcquired { held: _ } =>
          match arrival_archive_slot_acquire(
            root: root, subject: s, owner: wh_arrival_owner(s.host as String, "newcomer"), self_run_id: "acquirer-b", live_reader: wh_reader_live,
          ) {
            ArrivalArchiveSlotAcquireRefused { cause: c } =>
              string_contains(s: c as String, pattern: "the holder is live")
                && string_contains(s: c as String, pattern: "controller untouched")
                && shell.Remove.RecursiveForce(path: root_path).success
            ArrivalArchiveSlotAcquired { held: _ } => shell.Remove.RecursiveForce(path: root_path).success && false
          }
        _ => shell.Remove.RecursiveForce(path: root_path).success && false
      }
    _ => shell.Remove.RecursiveForce(path: root_path).success && false
  }
}

// THE PRODUCTION READER IS THE DECLARED GET. Passing arrival_holder_run_liveness -- exactly what
// gunbc.machine_intake.arrival_run wires at its call site -- through the seam makes an occupied acquire
// UNOBSERVABLE (a made-up run id cannot be read as a completed run), so the acquire refuses rather than
// recovering. This PINS that production's injected reader is the declared github fetch: a live/dead stub would
// have recovered or said "the holder is live", not this. Discriminating: swap the reader for wh_reader_dead and
// this row goes red (it would Acquire).
test fn w_production_reader_is_the_declared_get_and_unobservable() -> Bool {
  let root_path = wh_fresh_root()
  let root = root_path as NonEmptyStr
  match admit_arrival_subject(wire: "mtjade1") {
    ArrivalSubjectInPopulation { subject: s } =>
      match arrival_archive_slot_acquire(
        root: root, subject: s, owner: wh_arrival_owner(s.host as String, "prod-run"), self_run_id: "acquirer-a", live_reader: wh_reader_unseen,
      ) {
        ArrivalArchiveSlotAcquired { held: _ } =>
          match arrival_archive_slot_acquire(
            root: root, subject: s, owner: wh_arrival_owner(s.host as String, "newcomer"), self_run_id: "acquirer-b", live_reader: arrival_holder_run_liveness,
          ) {
            ArrivalArchiveSlotAcquireRefused { cause: c } =>
              string_contains(s: c as String, pattern: "cannot be observed as dead")
                && string_contains(s: c as String, pattern: "controller untouched")
                && shell.Remove.RecursiveForce(path: root_path).success
            ArrivalArchiveSlotAcquired { held: _ } => shell.Remove.RecursiveForce(path: root_path).success && false
          }
        _ => shell.Remove.RecursiveForce(path: root_path).success && false
      }
    _ => shell.Remove.RecursiveForce(path: root_path).success && false
  }
}
