module test.claim.tmp_name_probe_test

import std.types { Bool, Int }

type ApplicationUnary<T> = fn(T) -> T

type CbInvoke = InvokePresent { invoke: ApplicationUnary<Int> } | InvokeAbsent
type CbStep = StepPresent { step: ApplicationUnary<Int> } | StepAbsent

fn application_increment(value: Int) -> Int { value + 1 }

fn declared_invoke_cb() -> CbInvoke { InvokePresent { invoke: application_increment } }
fn declared_step_cb() -> CbStep { StepPresent { step: application_increment } }

test fn r1_field_named_invoke() -> Bool {
  match declared_invoke_cb() {
    InvokePresent { invoke } => invoke(41) == 42
    InvokeAbsent => false
  }
}

test fn r2_field_named_step() -> Bool {
  match declared_step_cb() {
    StepPresent { step } => step(41) == 42
    StepAbsent => false
  }
}
