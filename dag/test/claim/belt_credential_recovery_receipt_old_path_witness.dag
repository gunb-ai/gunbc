module test.claim.belt_credential_recovery_receipt_old_path_witness

import std.types { Bool, String, NonEmptyStr }
import gunbc.roadmap.roadmap_dashboard_instance { HostDashboardInstance, srv1_live_dashboard_instance }
import gunbc.host.host_layout { instance_receipts_dir }

// ============================================================================
// node credential-recovery-receipt-under-declared-instance-dir — VALUE-LEVEL RED control
//
// This witness reconstructs the EXACT expression belt_credential_recovery_cli used to build its
// receipt path at red_at = 56d460116d6252f6ec8dfe889ea358c804685861, namely
//   join([instance.instance_root as String, "/credential-acquisition-recovery.json"], "")
// (roadmap_belt_tick_cli.dag:844 at that sha) — it does NOT import the post-fix
// belt_credential_recovery_receipt_path, so it RESOLVES AND EXECUTES against the red_at tree
// rather than dying on a missing-symbol compile refusal. The point is the VALUE: at red_at the
// CLI computed a path sitting at the TOP of the root-owned instance root (/opt/gunbc), which is
// NOT under the declared, install-owned instance_receipts_dir. That is why the live unit fails
// 'receipt write failed' against /opt/gunbc root:root 0755 in the srv1 journal.
//
// red_at: 56d460116d6252f6ec8dfe889ea358c804685861 (the main sha before this row's change).
// Run with the gate roots (--source-root dag --source-root src/v2) against that tree.
// The named-negative claim below makes the run exit rc 1 with a raw FAIL, and it is deterministic
// across repeats — the witness discriminates by VALUE, not by whether a symbol name resolves.
// ============================================================================

// The red_at CLI's receipt-path expression, reconstructed verbatim from the pre-fix CLI.
fn cli_computed_receipt_path_at_red_at() -> String {
  let instance = srv1_live_dashboard_instance()
  join([instance.instance_root as String, "/credential-acquisition-recovery.json"], "")
}

test fn the_cli_computed_receipt_path_is_the_pinned_top_level_bytes() -> Bool {
  // VALUE proof: at red_at belt_credential_recovery_cli computes the top-level path
  // /opt/gunbc/credential-acquisition-recovery.json (the instance root is /opt/gunbc).
  cli_computed_receipt_path_at_red_at() == "/opt/gunbc/credential-acquisition-recovery.json"
}

test fn the_cli_computed_receipt_path_is_not_under_the_declared_receipts_dir() -> Bool {
  // VALUE proof of the defect: the red_at path sits OUTSIDE the declared, install-owned
  // instance receipts directory — the directory briansrls can actually write in.
  let instance = srv1_live_dashboard_instance()
  let receipts = instance_receipts_dir(instance_root: instance.instance_root as String) as String
  !starts_with(s: cli_computed_receipt_path_at_red_at(), prefix: concat(receipts, "/"))
}

test fn the_cli_computed_receipt_path_does_not_escape_the_instance_root() -> Bool {
  // The red_at path is inside the instance root (a top-level file there), and carries no
  // traversal — the defect is not an escape, it is a write to a root-owned location that is
  // outside the declared writable dir yet inside the instance root.
  let instance = srv1_live_dashboard_instance()
  let root = instance.instance_root as String
  let path = cli_computed_receipt_path_at_red_at()
  starts_with(s: path, prefix: concat(root, "/")) && !string_contains(s: path, pattern: "..")
}

// NAMED NEGATIVE — MUST FAIL at red_at (rc 1), proving the witness is value-discriminating and
// not vacuously green. If someone ever pins belt_credential_recovery_receipt_path back to the top
// level, this is exactly the property that becomes true and the green half goes red.
test fn the_cli_computed_receipt_path_is_under_the_declared_receipts_dir() -> Bool {
  let instance = srv1_live_dashboard_instance()
  let receipts = instance_receipts_dir(instance_root: instance.instance_root as String) as String
  starts_with(s: cli_computed_receipt_path_at_red_at(), prefix: concat(receipts, "/"))
}
