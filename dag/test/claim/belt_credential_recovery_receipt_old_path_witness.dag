module test.claim.belt_credential_recovery_receipt_old_path_witness

import std.types { Bool, String, NonEmptyStr }
import gunbc.roadmap.roadmap_dashboard_instance { HostDashboardInstance, srv1_live_dashboard_instance }
import gunbc.host.host_layout { instance_receipts_dir }

// ============================================================================
// node credential-recovery-receipt-under-declared-instance-dir — VALUE-LEVEL RED EVIDENCE
//
// WHAT THIS WITNESS IS, AND WHAT IT IS NOT. At red_at =
// 56d460116d6252f6ec8dfe889ea358c804685861 the receipt path was spelled INLINE inside
// belt_credential_recovery_cli at roadmap_belt_tick_cli.dag:844 as
//   join([instance.instance_root as String, "/credential-acquisition-recovery.json"], "")
// There was NO importable production symbol exposing it (the fix is what later introduced
// belt_credential_recovery_receipt_path). So this witness is a faithful RECONSTRUCTION of that
// inline expression — it does NOT import gunbc.roadmap.roadmap_belt_tick_cli and does NOT call
// belt_credential_recovery_receipt_path. Consequence stated plainly: every value checked here is
// identical at red_at, at this PR's head, and at any later commit; this file ALONE cannot tell a
// fixed build from a broken one, and is NOT the discriminating control.
//
// THE DISCRIMINATING CONTROL is test.claim.belt_credential_recovery_receipt_home_witness, which
// DOES import belt_credential_recovery_receipt_path from production: it goes red when the behavior
// is wrong — its value claims fail if the path is regressed to the top level, and its import fails
// if the function is deleted (fail_closed; witness_one_interface "deleting the integration must
// make a control fail"). This old-path witness only supplies the VALUE the CLI computed at red_at
// (the historical red half of the pair), which the home witness cannot show because at red_at the
// symbol it reads does not exist yet.
//
// red_at: 56d460116d6252f6ec8dfe889ea358c804685861 (the main sha before this row's change).
// Run with the gate roots (--source-root dag --source-root src/v2) against that tree. The
// named-negative claim below makes the run exit rc 1 with a raw FAIL, deterministic across repeats:
// it pins the reconstructed value OUTSIDE instance_receipts_dir, so a negative asserting it is
// INSIDE fails — the point is to make the red_at top-level value visible, not to discriminate a
// build (that is the home witness's job).
// ============================================================================

// The red_at CLI's receipt-path expression, reconstructed verbatim from the pre-fix CLI.
fn cli_computed_receipt_path_at_red_at() -> String {
  let instance = srv1_live_dashboard_instance()
  join([instance.instance_root as String, "/credential-acquisition-recovery.json"], "")
}

test fn the_cli_computed_receipt_path_is_the_pinned_top_level_bytes() -> Bool {
  // VALUE proof: at red_at belt_credential_recovery_cli computes the top-level path
  // /opt/gunbc/credential-acquisition-recovery.json (the instance root is /opt/gunbc).
  cli_computed_receipt_path_at_red_at() == "/opt/gunbc/credential-acquisition-recovery.json"
}

test fn the_cli_computed_receipt_path_is_not_under_the_declared_receipts_dir() -> Bool {
  // VALUE proof of the defect: the red_at path sits OUTSIDE the declared, install-owned
  // instance receipts directory — the directory briansrls can actually write in.
  let instance = srv1_live_dashboard_instance()
  let receipts = instance_receipts_dir(instance_root: instance.instance_root as String) as String
  !starts_with(s: cli_computed_receipt_path_at_red_at(), prefix: concat(receipts, "/"))
}

test fn the_cli_computed_receipt_path_does_not_escape_the_instance_root() -> Bool {
  // The red_at path is inside the instance root (a top-level file there), and carries no
  // traversal — the defect is not an escape, it is a write to a root-owned location that is
  // outside the declared writable dir yet inside the instance root.
  let instance = srv1_live_dashboard_instance()
  let root = instance.instance_root as String
  let path = cli_computed_receipt_path_at_red_at()
  starts_with(s: path, prefix: concat(root, "/")) && !string_contains(s: path, pattern: "..")
}

// NAMED NEGATIVE — fails at every tree (it asserts the reconstructed top-level value sits INSIDE
// the declared receipts directory, which it never does). It exists so the red_at run exits rc 1
// with a raw FAIL that names the exact property the fix must establish, making the red_at VALUE and
// its WRONGNESS visible in the same run. It does NOT read belt_credential_recovery_receipt_path and
// therefore does NOT flip if production is regressed — regression detection is the home witness's
// job (its import and value claims break), not this reconstruction's.
test fn the_cli_computed_receipt_path_is_under_the_declared_receipts_dir() -> Bool {
  let instance = srv1_live_dashboard_instance()
  let receipts = instance_receipts_dir(instance_root: instance.instance_root as String) as String
  starts_with(s: cli_computed_receipt_path_at_red_at(), prefix: concat(receipts, "/"))
}
