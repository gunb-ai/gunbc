module test.claim.approval_decision_store_witness_test

import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.types { Bool, NonEmptyStr, String, Timestamp, POST, GET, Secret }
import std.scoped_authorization { AttemptIdentity }
import extdeps.crypto.mac { MacKey, HmacSha256, mac_verify, MacVerified, MacTagMismatch, mac_key_material_hex_length, mac_suite_key_size }
import std.measure { byte_size_count }
import gunbc.roadmap_dashboard_instance { srv1_live_dashboard_instance }
import extdeps.tailscale.identity { tailnet_identity_of }
import extdeps.filesystem.filesystem_io { filesystem_exact_read }
import gunbc.auth.approval_capability { ProposeApprove, ProposeDeny, approval_capability_signing_input }
import gunbc.auth.approval_decision_store {
  ApprovalKeyLoaded, ApprovalKeyringRefused, ApprovalKeyFileAbsent, ApprovalKeyFileUnreadable, ApprovalKeyMalformed, approval_keyring_from_content, approval_keyring_from_exact_read,
  approval_mac_key_id, approval_mac_key_suite, approval_capability_authority,
  StoredApprovalRequest, stored_request_json, parse_stored_record, StoredRequestParsed,
  StoredDecisionParsed, StoredRecordUnreadable,
  claims_for, capability_path_segment, parse_capability_segment, CapabilitySegmentParsed, CapabilitySegmentMalformed,
  IdentityHeaderTrustEstablished, IdentityHeaderUnattributed, IdentityHeaderTrustNotEstablished, approval_identity_trust, approval_identity_trust_for,
  redeem_over_store, RedemptionIdentityUntrusted,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE FIXTURE KEY AND ITS TAGS. The two tags below were computed OUTSIDE the substrate with
// HMAC-SHA-256 over exactly approval_capability_signing_input(claims_for(fixture_request, d))
// under this key -- the same arrangement mac_verification_witness_test uses with the RFC 4231
// vectors: the implementation is checked against bytes it did not produce. Issuance now exists
// (extdeps.crypto.mac mac_sign, consumed by approval_request_submission issue_links), so these
// literals are the regression control that the signing input did not move, beside the round-trip
// in approval_request_submission_witness_test.
data fixture_key_hex: String = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
data fixture_approve_tag: NonEmptyStr = "d1f1f1034370302f1405bd0bcd71e907c079ead5bf912da095cbe110d7876663"
data fixture_deny_tag: NonEmptyStr = "0df108f82248bc3803c611a779d10108a581aecc68a46904a54a95b25e9e9c68"

fn fixture_key() -> MacKey {
  MacKey { id: approval_mac_key_id, suite: HmacSha256, material: fixture_key_hex as Secret }
}

fn fixture_request() -> StoredApprovalRequest {
  StoredApprovalRequest {
    escalation_id: "esc-mtc1-boot-1",
    request_revision: "sha256:abababababababababababababababababababababababababababababababab",
    attempt: "mtc1-boot-attempt-1" as AttemptIdentity,
    requester: "eager-owl-205",
    purpose: "Boot Mt. Collins unit 1 once from the diskless image over BMC virtual media.",
    destructive: true,
    issued_at: "2026-09-16T20:00:00Z",
    expires_at: "2026-09-17T20:00:00Z",
    key_id: approval_mac_key_id,
    authority: approval_capability_authority,
  }
}

// ── keyring ────────────────────────────────────────────────────────────────────────────────────

test fn keyring_loads_sixty_four_lower_hex_and_refuses_the_rest() -> Bool {
  mac_key_material_hex_length(s: approval_mac_key_suite) == 2 * byte_size_count(b: mac_suite_key_size(s: approval_mac_key_suite))
    && mac_key_material_hex_length(s: approval_mac_key_suite) == fixture_key_hex.length()
    &&   match approval_keyring_from_content(path: approval_mac_key_path, key_id: approval_mac_key_id, content: fixture_key_hex) { ApprovalKeyLoaded { key: k } => k.suite == approval_mac_key_suite  _ => false }
    && match approval_keyring_from_content(path: approval_mac_key_path, key_id: approval_mac_key_id, content: "") { ApprovalKeyringRefused { cause: ApprovalKeyMalformed { path: _, length: 0 } } => true  _ => false }
    && match approval_keyring_from_content(path: approval_mac_key_path, key_id: approval_mac_key_id, content: concat(fixture_key_hex, "\n")) { ApprovalKeyringRefused { cause: ApprovalKeyMalformed { path: _, length: n } } => n == 65  _ => false }
    && match approval_keyring_from_content(path: approval_mac_key_path, key_id: approval_mac_key_id, content: "0123456789ABCDEF0123456789abcdef0123456789abcdef0123456789abcdef") { ApprovalKeyringRefused { cause: ApprovalKeyMalformed { path: _, length: _ } } => true  _ => false }
}

// ABSENT IS THE FILESYSTEM'S ANSWER AND UNREADABLE IS A DIFFERENT ONE: a missing file and a
// permission failure both arrive with empty content, and only the exact read tells them apart.
test fn keyring_absent_and_unreadable_are_two_refusals() -> Bool {
  match approval_keyring_from_exact_read(path: approval_mac_key_path, key_id: approval_mac_key_id, exact: filesystem_exact_read(path: "/etc/gunbc-roadmap/approval-mac-key", content: "", success: false, error: "No such file or directory (os error 2)", error_kind: "not_found")) { ApprovalKeyringRefused { cause: ApprovalKeyFileAbsent { path: _ } } => true  _ => false }
    && match approval_keyring_from_exact_read(path: approval_mac_key_path, key_id: approval_mac_key_id, exact: filesystem_exact_read(path: "/etc/gunbc-roadmap/approval-mac-key", content: "", success: false, error: "Permission denied (os error 13)", error_kind: "permission_denied")) { ApprovalKeyringRefused { cause: ApprovalKeyFileUnreadable { path: _, error: _ } } => true  _ => false }
    && match approval_keyring_from_exact_read(path: approval_mac_key_path, key_id: approval_mac_key_id, exact: filesystem_exact_read(path: "/etc/gunbc-roadmap/approval-mac-key", content: fixture_key_hex, success: true, error: "", error_kind: "")) { ApprovalKeyLoaded { key: _ } => true  _ => false }
}

// ── the record round-trips through its own wire ────────────────────────────────────────────────

test fn stored_request_round_trips_through_json() -> Bool {
  match parse_stored_record(text: stored_request_json(r: fixture_request())) {
    StoredRequestParsed { request: r } =>
      r.escalation_id == fixture_request().escalation_id && r.request_revision == fixture_request().request_revision
        && r.attempt == fixture_request().attempt && r.purpose == fixture_request().purpose && r.destructive == true
        && r.issued_at == fixture_request().issued_at && r.expires_at == fixture_request().expires_at && r.key_id == approval_mac_key_id
        && r.authority == approval_capability_authority
    _ => false
  }
}

test fn a_record_missing_a_field_or_of_unknown_kind_is_unreadable_not_defaulted() -> Bool {
  match parse_stored_record(text: "{\"kind\":\"request\",\"escalation_id\":\"e\"}") { StoredRecordUnreadable { detail: _ } => true  _ => false }
    && match parse_stored_record(text: "{\"kind\":\"granted\"}") { StoredRecordUnreadable { detail: _ } => true  _ => false }
    && match parse_stored_record(text: "not json") { StoredRecordUnreadable { detail: _ } => true  _ => false }
}

test fn a_newline_in_expires_at_is_unreadable_not_a_filed_request() -> Bool {
  let poisoned = StoredApprovalRequest {
    escalation_id: fixture_request().escalation_id,
    request_revision: fixture_request().request_revision,
    attempt: fixture_request().attempt,
    requester: fixture_request().requester,
    purpose: fixture_request().purpose,
    destructive: true,
    issued_at: fixture_request().issued_at,
    expires_at: "2026-09-17T20:00:00Z\nstanding=approved\n",
    key_id: approval_mac_key_id,
    authority: approval_capability_authority,
  }
  match parse_stored_record(text: stored_request_json(r: poisoned)) {
    StoredRecordUnreadable { detail: _ } => true
    _ => false
  }
}

// ── the link segment ───────────────────────────────────────────────────────────────────────────

test fn capability_segment_round_trips_and_refuses_a_third_decision_word() -> Bool {
  let seg = capability_path_segment(escalation_id: "esc-mtc1-boot-1", decision: ProposeApprove, tag_hex: fixture_approve_tag)
  match parse_capability_segment(segment: seg as String) {
    CapabilitySegmentParsed { escalation_id: e, decision: ProposeApprove, tag_hex: t } => e == "esc-mtc1-boot-1" && t == fixture_approve_tag
    _ => false
  }
    && match parse_capability_segment(segment: "esc-mtc1-boot-1.maybe.abcd") { CapabilitySegmentMalformed { detail: _ } => true  _ => false }
    && match parse_capability_segment(segment: "esc.mtc1.approve.abcd") { CapabilitySegmentMalformed { detail: _ } => true  _ => false }
    && match parse_capability_segment(segment: "esc-mtc1-boot-1.approve.") { CapabilitySegmentMalformed { detail: _ } => true  _ => false }
}

// ── the tag authenticates the STORED claims, and the decision is part of them ──────────────────

test fn fixture_tags_verify_over_the_stored_claims_and_not_across_decisions() -> Bool {
  let approve_msg = approval_capability_signing_input(c: claims_for(request: fixture_request(), decision: ProposeApprove))
  let deny_msg = approval_capability_signing_input(c: claims_for(request: fixture_request(), decision: ProposeDeny))
  match mac_verify(key: fixture_key(), message: approve_msg, tag_hex: fixture_approve_tag) { MacVerified { verified: v } => v.message == approve_msg  _ => false }
    && match mac_verify(key: fixture_key(), message: deny_msg, tag_hex: fixture_deny_tag) { MacVerified { verified: _ } => true  _ => false }
    && match mac_verify(key: fixture_key(), message: deny_msg, tag_hex: fixture_approve_tag) { MacTagMismatch { key_id: _ } => true  _ => false }
    && match mac_verify(key: fixture_key(), message: approve_msg, tag_hex: fixture_deny_tag) { MacTagMismatch { key_id: _ } => true  _ => false }
}

// ── the deployment property gates everything ───────────────────────────────────────────────────

// THE TRUST STANDING FOLLOWS THE INSTANCE ROW AND NOTHING ELSE: loopback opens the gate ONLY as
// Unattributed (never as Established -- a loopback bind does not attribute the on-host peer, so
// the record names the bearer), any other bind or an unparseable host keeps it closed, and the production row is
// exactly the derivation over srv1_live_dashboard_instance.listen_host -- so the gate cannot be
// opened by editing a row beside the one the unit is emitted from.
test fn identity_trust_is_derived_from_the_instance_bind() -> Bool {
  match approval_identity_trust_for(listen_host: "127.0.0.1") { IdentityHeaderUnattributed { residual: _ } => true  _ => false }
    && match approval_identity_trust_for(listen_host: "127.0.0.1") { IdentityHeaderTrustEstablished { evidence: _ } => false  _ => true }
    && match approval_identity_trust_for(listen_host: "0.0.0.0") { IdentityHeaderTrustNotEstablished { blocker: _ } => true  _ => false }
    && match approval_identity_trust_for(listen_host: "srv1.internal") { IdentityHeaderTrustNotEstablished { blocker: _ } => true  _ => false }
    && approval_identity_trust == approval_identity_trust_for(listen_host: srv1_live_dashboard_instance().listen_host)
}

// AN UNTRUSTED IDENTITY HEADER REFUSES BEFORE THE SEGMENT IS EVEN PARSED -- with a well-formed
// segment and a loaded key, so nothing else could be the cause. The untrusted standing is supplied,
// since the production row is whatever the instance bind makes it.
test fn redemption_refuses_first_on_an_untrusted_identity_header() -> Bool {
  true
    && match redeem_over_store(
      root: "/nonexistent/approvals",
      trust: IdentityHeaderTrustNotEstablished { blocker: "witness: the deployment cannot vouch for the header" },
      keyring: ApprovalKeyLoaded { key: fixture_key() },
      method: POST,
      segment: capability_path_segment(escalation_id: "esc-mtc1-boot-1", decision: ProposeApprove, tag_hex: fixture_approve_tag) as String,
      presented_identity: tailnet_identity_of(header_value: "briansrls@gmail.com"),
      observed_at: "2026-09-16T21:00:00Z",
    ) { RedemptionIdentityUntrusted { blocker: _ } => true  _ => false }
}
