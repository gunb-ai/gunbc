module test.claim.emitted_export_surface_manifest_witness

data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

// THE READ IS THE STRUCTURAL INVERSE OF THE WRITE, AND THIS IS WHERE THAT IS PROVEN BY EXECUTION.
//
// The manifest content here is BUILT WITH THE WRITER'S OWN GRAMMAR ROWS -- the same prefix,
// separator, field separator and tags `v1.compiler.emit_rust` renders with -- rather than typed
// out as a golden string. A golden string would pass while the two ends disagreed, because it
// would be a third spelling of the grammar and would drift with neither. Composing the fixture
// from the authority means a change to the grammar moves the writer, the reader and this witness
// together, and a change to only one of them fails here.
//
// FIXTURE-BACKED, NOT LIVE-TREE, and the reason is the one DESIGN gives for the census beside it:
// the refusals below must stay authorable forever. A witness that could only go red by finding a
// malformed row in the committed artifact would be permanently green by construction the moment
// the emitter is correct -- which is always, since the emitter writes both ends -- and would then
// be cited as coverage for a reader nothing had ever exercised.

fn row(source_module: String, target_filename: String, tag: String, members: List<String>) -> String {
  concat(
    gunbc.stage0_emitted_population_manifest.emitted_population_manifest_line_prefix,
    concat([source_module, target_filename, tag], members)
      |> join(separator: gunbc.stage0_emitted_population_manifest.emitted_export_surface_manifest_field_separator)
  )
}

fn manifest(rows: List<String>) -> String {
  concat(
    rows |> join(separator: gunbc.stage0_emitted_population_manifest.emitted_population_manifest_line_separator),
    gunbc.stage0_emitted_population_manifest.emitted_population_manifest_line_separator
  )
}

fn two_module_manifest() -> String {
  manifest(rows: [
    row(source_module: "v2.std.node", target_filename: "v2_std_node", tag: gunbc.stage0_emitted_population_manifest.emitted_export_surface_module_tag, members: []),
    row(source_module: "v2.std.node", target_filename: "v2_std_node", tag: gunbc.stage0_emitted_population_manifest.emitted_export_surface_reexport_tag, members: ["Cardinality", "Symbol"]),
    row(source_module: "v2.std.node", target_filename: "v2_std_node", tag: gunbc.stage0_emitted_population_manifest.emitted_export_surface_declaration_tag, members: ["Behavior", "Edge", "Node"]),
    row(source_module: "std.logic", target_filename: "std_logic", tag: gunbc.stage0_emitted_population_manifest.emitted_export_surface_module_tag, members: []),
    row(source_module: "std.logic", target_filename: "std_logic", tag: gunbc.stage0_emitted_population_manifest.emitted_export_surface_reexport_tag, members: []),
    row(source_module: "std.logic", target_filename: "std_logic", tag: gunbc.stage0_emitted_population_manifest.emitted_export_surface_declaration_tag, members: ["Bool"])
  ])
}

fn observed_modules(content: String) -> List<gunbc.stage0_emitted_export_surface_observation.EmittedModuleExportSurface> {
  match gunbc.stage0_emitted_export_surface_observation.observe_emitted_export_surface(content: content) {
    gunbc.stage0_emitted_export_surface_observation.ExportSurfaceUnobserved { detail: _ } => []
    gunbc.stage0_emitted_export_surface_observation.ExportSurfaceObserved { modules: modules } => modules
  }
}

// The round trip: six wire rows go in and two producer-shaped module envelopes come back, with both
// projections attached to the right identity. The content assertion matters because a count alone
// survives a reader that puts every field one position off.
fn witness_module_envelopes_round_trip() -> Bool {
  let modules = observed_modules(content: two_module_manifest())
  v2.std.algebra.length(xs: modules) == 2
    && v2.std.algebra.any(xs: modules, predicate: surface =>
      surface.source_module == "v2.std.node"
        && surface.target_filename == "v2_std_node"
        && v2.std.algebra.length(xs: surface.reexports) == 2
        && v2.std.algebra.length(xs: surface.declarations) == 3)
}

// DECLARED EMPTY IS NOT NOT-OBSERVED, and this is the witness that keeps the two apart.
//
// `std.logic` declares an EMPTY reexport projection. It must come back as a present module envelope
// carrying zero linkage members -- not as a missing module, and not as an absent observation.
fn witness_declared_empty_row_survives_the_round_trip() -> Bool {
  let modules = observed_modules(content: two_module_manifest())
  v2.std.algebra.any(xs: modules, predicate: surface =>
    surface.source_module == "std.logic"
      && v2.std.algebra.length(xs: surface.reexports) == 0
      && v2.std.algebra.length(xs: surface.declarations) == 1)
}

// RED: projection rows without their module envelope are not a smaller valid observation. Before
// the envelope existed this exact content was accepted and every consumer had to infer presence.
fn witness_projection_rows_without_module_envelope_refuse() -> Bool {
  match gunbc.stage0_emitted_export_surface_observation.observe_emitted_export_surface(
    content: manifest(rows: [
      row(source_module: "std.logic", target_filename: "std_logic", tag: gunbc.stage0_emitted_population_manifest.emitted_export_surface_reexport_tag, members: []),
      row(source_module: "std.logic", target_filename: "std_logic", tag: gunbc.stage0_emitted_population_manifest.emitted_export_surface_declaration_tag, members: ["Bool"])
    ])
  ) {
    gunbc.stage0_emitted_export_surface_observation.ExportSurfaceObserved { modules: _ } => false
    gunbc.stage0_emitted_export_surface_observation.ExportSurfaceUnobserved { detail: _ } => true
  }
}

// RED 1: AN UNRECOGNIZED TAG REFUSES RATHER THAN BEING SKIPPED.
//
// A reader that dropped the row would report a partial surface as a complete one -- a narrow, not
// a widen, and therefore silently uncovered. This is the discriminating input: it is well-formed
// in every respect except the tag, so a green here could only mean the tag is not being checked.
fn witness_unknown_tag_refuses() -> Bool {
  match gunbc.stage0_emitted_export_surface_observation.observe_emitted_export_surface(
    content: manifest(rows: [
      row(source_module: "v2.std.node", target_filename: "v2_std_node", tag: "reexports", members: ["Symbol"])
    ])
  ) {
    gunbc.stage0_emitted_export_surface_observation.ExportSurfaceObserved { modules: _ } => false
    gunbc.stage0_emitted_export_surface_observation.ExportSurfaceUnobserved { detail: _ } => true
  }
}

// RED 2: A ROW SHORT OF ITS THREE FIXED FIELDS REFUSES.
//
// The members are variadic and may be absent; the identity, the locator and the kind are not.
fn witness_row_missing_fixed_fields_refuses() -> Bool {
  match gunbc.stage0_emitted_export_surface_observation.observe_emitted_export_surface(
    content: manifest(rows: [
      concat(
        gunbc.stage0_emitted_population_manifest.emitted_population_manifest_line_prefix,
        "v2.std.node v2_std_node"
      )
    ])
  ) {
    gunbc.stage0_emitted_export_surface_observation.ExportSurfaceObserved { modules: _ } => false
    gunbc.stage0_emitted_export_surface_observation.ExportSurfaceUnobserved { detail: _ } => true
  }
}

// RED 3: CONTENT THAT IS NOT THIS ARTIFACT IS UNOBSERVED, NOT AN EMPTY SURFACE SET.
//
// Reporting "this emit exported nothing" for a file the reader was never pointed at is the
// fabricated plausible output the whole manifest channel exists to end.
fn witness_content_without_rows_is_unobserved() -> Bool {
  match gunbc.stage0_emitted_export_surface_observation.observe_emitted_export_surface(
    content: "fn main() {}\n"
  ) {
    gunbc.stage0_emitted_export_surface_observation.ExportSurfaceObserved { modules: _ } => false
    gunbc.stage0_emitted_export_surface_observation.ExportSurfaceUnobserved { detail: _ } => true
  }
}

// POSITIVE CONTROL FOR THE THREE REDS ABOVE: the same reader, over well-formed content, observes.
// Without it the three refusals are equally satisfied by a reader that refuses everything.
fn witness_well_formed_manifest_is_observed() -> Bool {
  match gunbc.stage0_emitted_export_surface_observation.observe_emitted_export_surface(
    content: two_module_manifest()
  ) {
    gunbc.stage0_emitted_export_surface_observation.ExportSurfaceObserved { modules: _ } => true
    gunbc.stage0_emitted_export_surface_observation.ExportSurfaceUnobserved { detail: _ } => false
  }
}

// RED 3: A NONEMPTY LINE THAT IS NOT A ROW REFUSES THE WHOLE OBSERVATION.
//
// The manifest below is VALID except for one interloping line, and that is the point: the reader
// selected row-prefixed lines and dropped the rest, so a corrupted artifact answered Observed as
// long as one good row survived. The affected module then vanishes from the consuming census's
// population, and the census reads an absent module as agreeing with itself.
//
// This is the same failure the malformed-ROW wall was written against, reached one gate earlier --
// the wall guarded payloads it was handed, and the hand-off had already discarded the evidence.
fn witness_unexpected_nonempty_line_refuses() -> Bool {
  match gunbc.stage0_emitted_export_surface_observation.observe_emitted_export_surface(
    content: concat(
      manifest(rows: [
        row(source_module: "v2.std.node", target_filename: "v2_std_node", tag: gunbc.stage0_emitted_population_manifest.emitted_export_surface_reexport_tag, members: ["Symbol"])
      ]),
      concat("a line that is not a row", gunbc.stage0_emitted_population_manifest.emitted_population_manifest_line_separator)
    )
  ) {
    gunbc.stage0_emitted_export_surface_observation.ExportSurfaceObserved { rows: _ } => false
    gunbc.stage0_emitted_export_surface_observation.ExportSurfaceUnobserved { detail: _ } => true
  }
}

// THE GREEN CONTROL THAT KEEPS THE ABOVE FROM BEING A WALL THAT ALWAYS FIRES.
//
// The writer terminates the file with a trailing separator, so every well-formed manifest splits
// with a final EMPTY line. Refusing on "not a row" without excepting the empty string would refuse
// every real artifact, and a check whose only reachable state is red carries no information. This
// asserts the ordinary manifest still observes, which is what makes the refusal above discriminating
// rather than universal.
fn witness_trailing_empty_line_still_observes() -> Bool {
  match gunbc.stage0_emitted_export_surface_observation.observe_emitted_export_surface(content: two_module_manifest()) {
    gunbc.stage0_emitted_export_surface_observation.ExportSurfaceObserved { rows: _ } => true
    gunbc.stage0_emitted_export_surface_observation.ExportSurfaceUnobserved { detail: _ } => false
  }
}

test fn emitted_export_surface_manifest_witnesses() -> Bool {
  witness_module_envelopes_round_trip()
    && witness_declared_empty_row_survives_the_round_trip()
    && witness_projection_rows_without_module_envelope_refuse()
    && witness_unknown_tag_refuses()
    && witness_row_missing_fixed_fields_refuses()
    && witness_content_without_rows_is_unobserved()
    && witness_well_formed_manifest_is_observed()
    && witness_unexpected_nonempty_line_refuses()
    && witness_trailing_empty_line_still_observes()
}
