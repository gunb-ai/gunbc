data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data a_digest_hex: NonEmptyStr = "4fc53fea3fe49bc3ed3b967511654223578d59d963546117ab524df11b419bcd"

// JOURNAL LINES AS THE OBSERVER WROTE THEM on the executed protocol run of 2026-09-28 06:41Z (remote
// runner, headless Chromium, playwright 1.62.1, the table-driven loopback transport): the normal run
// and the model-scheduled drop. Copied verbatim so the parser is held to the real spelling.
data journal_ok: String = join([
  "1790577669914 2026-09-28T06:41:09.914Z connection-requested url=\"ws://127.0.0.1:45865/kvm?token=csrf-1\"",
  "1790577669915 2026-09-28T06:41:09.915Z connection-open gen=1 url=\"ws://127.0.0.1:45865/kvm?token=csrf-1\"",
  "1790577669931 2026-09-28T06:41:09.931Z established host=\"127.0.0.1:45865\" session=7 attempt=wet gen=1",
  "1790577676453 2026-09-28T06:41:16.453Z still seq=1 reason=trigger:1002-sol-channel-lost gen=1 started_ms=1790577676447 file=still-1.jpg bytes=3611",
  "1790577679461 2026-09-28T06:41:19.461Z stop-requested by=stop-file",
  "1790577679466 2026-09-28T06:41:19.466Z connection-lost gen=1",
  "1790577679466 2026-09-28T06:41:19.466Z session-release result=released",
  "1790577679502 2026-09-28T06:41:19.502Z browser-close result=closed",
  "1790577679502 2026-09-28T06:41:19.502Z stopped session=released browser=closed",
  "",
], "\n")

data journal_drop: String = join([
  "1790577691953 2026-09-28T06:41:31.953Z connection-open gen=1 url=\"ws://127.0.0.1:38247/kvm?token=csrf-1\"",
  "1790577691967 2026-09-28T06:41:31.967Z established host=\"127.0.0.1:38247\" session=7 attempt=wet gen=1",
  "1790577696558 2026-09-28T06:41:36.558Z connection-lost gen=1",
  "1790577698732 2026-09-28T06:41:38.732Z acquisition-failed seq=1 reason=trigger:1002-sol-channel-lost gen=1 cause=not-connected",
  "",
], "\n")

fn ok_subject() -> KvmObserverSubject { KvmObserverSubject { host: "127.0.0.1:45865", attempt: "wet" } }

fn drop_subject() -> KvmObserverSubject { KvmObserverSubject { host: "127.0.0.1:38247", attempt: "wet" } }

fn started(standing: KvmObserverStanding) -> KvmObserverStart {
  KvmObserverStarted { dir: "artifacts/mtcollins1-boot-kvm-wet", subject: ok_subject(), standing: standing, checked_at: "t" }
}

fn instant(iso: String) -> KvmInstant {
  KvmInstant { since_epoch: millisecond(count: 1), iso: iso }
}

// THE UPSTREAM FACT THE ROUTE STANDS ON: 0.32 serves no on-demand still; the viewer canvas is the one
// route that yields a still at any moment.
test fn firmware_0_32_serves_no_on_demand_still_and_the_viewer_is_client_side() -> Bool {
  let absent = match megarac_screen_capture_standing_at_0_32(route: ServerSideOnDemandStill) { ScreenCaptureAbsent => true  _ => false }
  let client = match megarac_screen_capture_standing_at_0_32(route: KvmClientCanvasJpeg) { ScreenCaptureClientSideOnly => true  _ => false }
  let bsod = match megarac_screen_capture_standing_at_0_32(route: LastBsodJpeg) { ScreenCaptureEventRetainedOnly => true  _ => false }
  let rec = match megarac_screen_capture_standing_at_0_32(route: TriggeredFramebufferRecording) { ScreenCaptureEventRetainedOnly => true  _ => false }
  absent && client && bsod && rec
}

// ESTABLISHED ONLY FOR THE EXPECTED SUBJECT, and every still carries its capture instant and the
// connection generation it was taken under.
test fn established_is_bound_to_the_expected_host_and_attempt() -> Bool {
  let events = kvm_journal_events(text: journal_ok)
  let bound = match kvm_observer_standing(events: kvm_journal_events(text: "1790577669931 2026-09-28T06:41:09.931Z established host=\"127.0.0.1:45865\" session=7 attempt=wet gen=1\n"), subject: ok_subject()) {
    KvmObserverEstablished { at: a, host: h, session: s, attempt: t } => (millisecond_count(m: a.since_epoch) as Int) == 1790577669931 && h == "127.0.0.1:45865" && s == "7" && t == "wet"
    _ => false
  }
  let stills = count(filter(events, e => match e { KvmJournalStill { at: a, seq: _, reason: r, file: f, gen: g } => (millisecond_count(m: a.since_epoch) as Int) > 0 && g == "1" && f == "still-1.jpg" && string_contains(s: r, pattern: "sol-channel-lost")  _ => false }))
  bound && stills == 1
}

// A MISMATCHED OR INCOMPLETE ESTABLISHED LINE IS NEVER ESTABLISHED: another host, another attempt,
// or a missing session each read Mismatch.
test fn a_mismatched_or_incomplete_established_line_is_not_established() -> Bool {
  let line = "1790577669931 2026-09-28T06:41:09.931Z established host=\"127.0.0.1:45865\" session=7 attempt=wet gen=1\n"
  let other_host = match kvm_observer_standing(events: kvm_journal_events(text: line), subject: KvmObserverSubject { host: "192.168.1.228", attempt: "wet" }) { KvmObserverMismatch { at: _, detail: d } => string_contains(s: d, pattern: "expected 192.168.1.228")  _ => false }
  let other_attempt = match kvm_observer_standing(events: kvm_journal_events(text: line), subject: KvmObserverSubject { host: "127.0.0.1:45865", attempt: "36335369059" }) { KvmObserverMismatch { at: _, detail: _ } => true  _ => false }
  let no_session = match kvm_observer_standing(events: kvm_journal_events(text: "1790577669931 2026-09-28T06:41:09.931Z established host=\"127.0.0.1:45865\" attempt=wet gen=1\n"), subject: ok_subject()) { KvmObserverMismatch { at: _, detail: d } => string_contains(s: d, pattern: "missing")  _ => false }
  other_host && other_attempt && no_session
}

// THE STANDING FOLLOWS THE CONNECTION: a loss after establishment is Lost, and the still asked after
// it is not-connected; both are boundary events the watch reports.
test fn a_loss_after_establishment_is_lost_and_reported() -> Bool {
  let events = kvm_journal_events(text: journal_drop)
  let lost = match kvm_observer_standing(events: events, subject: drop_subject()) { KvmObserverLost { at: a, established_at: e } => a.iso == "2026-09-28T06:41:36.558Z" && e.iso == "2026-09-28T06:41:31.967Z"  _ => false }
  let not_connected = count(filter(events, e => match e { KvmJournalAcquisitionFailed { at: _, seq: _, reason: _, cause: c, gen: _ } => match c { KvmNotConnected => true  _ => false }  _ => false })) == 1
  lost && not_connected && count(kvm_boundary_events(events: events)) == 2
}

// A STILL WHOSE CONNECTION CHANGED DURING ACQUISITION IS A FAILED ACQUISITION, and an unexportable
// canvas is its own cause with the browser's words.
test fn acquisition_failures_keep_their_cause() -> Bool {
  let changed = match kvm_journal_event(line: "1790577698732 2026-09-28T06:41:38.732Z acquisition-failed seq=2 reason=periodic gen=1 started_ms=1790577698700 cause=connection-changed-during-acquisition") {
    KvmJournalAcquisitionFailed { at: _, seq: _, reason: _, cause: c, gen: g } => g == "1" && match c { KvmConnectionChangedDuringAcquisition => true  _ => false }
    _ => false
  }
  let tainted = match kvm_journal_event(line: "1790577710007 2026-09-28T06:41:50.007Z acquisition-failed seq=1 reason=periodic gen=1 started_ms=1790577710003 cause=canvas-unreadable detail=\"SecurityError: Tainted canvases may not be exported.\"") {
    KvmJournalAcquisitionFailed { at: _, seq: _, reason: _, cause: c, gen: _ } => match c { KvmCanvasUnreadable { detail: d } => string_contains(s: d, pattern: "Tainted canvases")  _ => false }
    _ => false
  }
  changed && tainted
}

// THE HANDOFF IS ADMITTED ONLY OVER AN ESTABLISHED OBSERVER, through the selector the actuation
// calls: not started, pending, a busy seat, a mismatch and a loss each refuse with their standing.
test fn the_handoff_is_admitted_only_over_an_established_observer() -> Bool {
  let at = instant(iso: "t1")
  let admitted = match kvm_handoff_admission_of(start: started(standing: KvmObserverPending), standing: KvmObserverEstablished { at: at, host: "127.0.0.1:45865", session: "7", attempt: "wet" }) { KvmHandoffAdmitted { session: s } => s == "7"  _ => false }
  let not_started = match kvm_handoff_admission_of(start: KvmObserverNotStarted { reason: "the runner browser toolchain is not ready" }, standing: KvmObserverPending) { KvmHandoffRefused { cause: c } => string_contains(s: c, pattern: "toolchain is not ready")  _ => false }
  let pending = match kvm_handoff_admission_of(start: started(standing: KvmObserverPending), standing: KvmObserverPending) { KvmHandoffRefused { cause: c } => string_contains(s: c, pattern: "NOT ESTABLISHED")  _ => false }
  let seat = match kvm_handoff_admission_of(start: started(standing: KvmObserverPending), standing: KvmObserverRefused { at: at, refusal: KvmSeatBusy { viewer_count: "1" } }) { KvmHandoffRefused { cause: c } => string_contains(s: c, pattern: "viewer_count=1")  _ => false }
  let mismatch = match kvm_handoff_admission_of(start: started(standing: KvmObserverPending), standing: KvmObserverMismatch { at: at, detail: "established for attempt 1, expected 2" }) { KvmHandoffRefused { cause: _ } => true  _ => false }
  let lost = match kvm_handoff_admission_of(start: started(standing: KvmObserverPending), standing: KvmObserverLost { at: at, established_at: at }) { KvmHandoffRefused { cause: c } => string_contains(s: c, pattern: "LOST")  _ => false }
  admitted && not_started && pending && seat && mismatch && lost
}

// LIVE, NOT HISTORICAL (hold on gunbc#12492): an established journal counts only over a running owned
// process. Quiet but live stays established; a writer that died without a line, one whose process is
// unreadable, a stop, and an unread journal each have their own standing, and none of them admits the
// handoff.
test fn establishment_is_live_only_over_a_running_owned_process() -> Bool {
  let text = "1790577669931 2026-09-28T06:41:09.931Z established host=\"127.0.0.1:45865\" session=7 attempt=wet gen=1\n"
  let running = OwnedRunning { pid: "4242", start_time: "100" }
  let quiet_live = match kvm_live_standing(journal: KvmJournalText { text: text }, subject: ok_subject(), process: running) { KvmObserverEstablished { at: _, host: _, session: _, attempt: _ } => true  _ => false }
  let died = kvm_live_standing(journal: KvmJournalText { text: text }, subject: ok_subject(), process: OwnedGone { pid: "4242" })
  let died_ok = match died { KvmObserverProcessNotRunning { process: p } => match p { OwnedGone { pid: _ } => true  _ => false }  _ => false }
  let unreadable = match kvm_live_standing(journal: KvmJournalText { text: text }, subject: ok_subject(), process: OwnedUnreadable { pid: "4242", detail: "EACCES" }) { KvmObserverProcessNotRunning { process: _ } => true  _ => false }
  let stopped = match kvm_live_standing(journal: KvmJournalText { text: concat(text, "1790577679461 2026-09-28T06:41:19.461Z stopped session=released browser=closed\n") }, subject: ok_subject(), process: running) { KvmObserverStopped { at: _ } => true  _ => false }
  let unread = match kvm_live_standing(journal: KvmJournalUnread { cause: "EISDIR" }, subject: ok_subject(), process: running) { KvmObserverJournalUnread { cause: c } => c == "EISDIR"  _ => false }
  let refuses = match kvm_handoff_admission_of(start: started(standing: KvmObserverPending), standing: died) { KvmHandoffRefused { cause: c } => string_contains(s: c, pattern: "NOT RUNNING")  _ => false }
  quiet_live && died_ok && unreadable && stopped && unread && refuses
}

// THE OWNED PROCESS'S READBACK KEEPS EACH OBSERVATION AS ITSELF: a missing stat is Gone, an unreadable
// one is Unreadable, an unparseable one is Unparseable, a different start time is Foreign.
test fn owned_process_observations_are_kept_distinct() -> Bool {
  let rec = "4242 100\n"
  let stat_100 = "4242 (node) S 1 4242 4242 0 -1 4194560 100 0 0 0 1 1 0 0 20 0 1 0 100 12345 67 18446744073709551615\n"
  let stat_200 = "4242 (node) S 1 4242 4242 0 -1 4194560 100 0 0 0 1 1 0 0 20 0 1 0 200 12345 67 18446744073709551615\n"
  let run = match owned_process_standing_of(record_read_ok: true, record: rec, stat_read_ok: true, stat_not_found: false, stat_error: "", stat: stat_100) { OwnedRunning { pid: _, start_time: _ } => true  _ => false }
  let gone = match owned_process_standing_of(record_read_ok: true, record: rec, stat_read_ok: false, stat_not_found: true, stat_error: "not found", stat: "") { OwnedGone { pid: _ } => true  _ => false }
  let unread = match owned_process_standing_of(record_read_ok: true, record: rec, stat_read_ok: false, stat_not_found: false, stat_error: "EACCES", stat: "") { OwnedUnreadable { pid: _, detail: d } => d == "EACCES"  _ => false }
  let garbled = match owned_process_standing_of(record_read_ok: true, record: rec, stat_read_ok: true, stat_not_found: false, stat_error: "", stat: "garbage") { OwnedUnparseable { pid: _, detail: _ } => true  _ => false }
  let foreign = match owned_process_standing_of(record_read_ok: true, record: rec, stat_read_ok: true, stat_not_found: false, stat_error: "", stat: stat_200) { OwnedForeign { pid: _, observed_start: o } => o == "200"  _ => false }
  run && gone && unread && garbled && foreign
}

// GAPS ARE RETAINED: an interval over two cadences, a clock that stepped back, and a final gap left
// unclosed when the last mark is not a stop request.
test fn gaps_step_backs_and_unclosed_ends_are_retained() -> Bool {
  let text = join([
    "1000000 t0 established host=h session=1 attempt=a gen=1",
    "1060000 t1 still seq=1 reason=periodic gen=1 file=still-1.jpg",
    "1300000 t2 still seq=2 reason=periodic gen=1 file=still-2.jpg",
    "1200000 t3 still seq=3 reason=periodic gen=1 file=still-3.jpg",
    "",
  ], "\n")
  let gaps = kvm_still_gaps(events: kvm_journal_events(text: text), cadence: second(count: 60), observed_until: "t9")
  let over = count(filter(gaps, g => match g { KvmGapOverCadence { from: f, to: t, length: l } => f.iso == "t1" && t.iso == "t2" && (millisecond_count(m: l) as Int) == 240000  _ => false }))
  let back = count(filter(gaps, g => match g { KvmClockStepBack { from: f, to: t } => f.iso == "t2" && t.iso == "t3"  _ => false }))
  let unclosed = count(filter(gaps, g => match g { KvmFinalGapUnclosed { from: f, observed_until: u } => f.iso == "t3" && u == "t9"  _ => false }))
  let closed = kvm_still_gaps(events: kvm_journal_events(text: journal_ok), cadence: second(count: 60), observed_until: "t9")
  over == 1 && back == 1 && unclosed == 1 && count(filter(closed, g => match g { KvmFinalGapUnclosed { from: _, observed_until: _ } => true  _ => false })) == 0
}

// AN UNREAD JOURNAL IS NOT A QUIET ONE: only read text yields events; absent and unread yield none
// and are carried as themselves.
test fn only_a_read_journal_yields_events() -> Bool {
  count(kvm_journal_events_of(read: KvmJournalText { text: journal_ok })) == 9
    && count(kvm_journal_events_of(read: KvmJournalUnread { cause: "EISDIR" })) == 0
    && count(kvm_journal_events_of(read: KvmJournalAbsent)) == 0
    && match kvm_journal_event(line: "not a journal line") { KvmJournalUnparsed { line: l } => l == "not a journal line"  _ => false }
}

// HASH-BOUND: a still is retained only with the digest our own sha256sum read took.
test fn a_still_is_retained_only_when_hash_bound() -> Bool {
  let at = instant(iso: "t")
  let bound = kvm_retained_still(dir: "artifacts/mtcollins1-boot-kvm-1", at: at, seq: "1", reason: "periodic", file: "still-1.jpg", digest: Sha256FileDigest { digest: sha256_digest(hex: a_digest_hex) })
  let unbound = kvm_retained_still(dir: "artifacts/mtcollins1-boot-kvm-1", at: at, seq: "1", reason: "periodic", file: "still-1.jpg", digest: Sha256FileDigestUnavailable { path: "x", reason: "sha256sum could not digest the input" })
  let ok = match bound { KvmStillHashed { at: _, seq: _, reason: _, path: p, digest: d } => d.hex == a_digest_hex && p == "artifacts/mtcollins1-boot-kvm-1/still-1.jpg"  _ => false }
  let refused = match unbound { KvmStillUnhashed { at: _, seq: _, reason: _, path: _, why: _ } => true  _ => false }
  ok && refused
}

// THE REAL START, EXECUTED, WITH NOTHING TO DRIVE: an uncatalogued firmware, an unbound credential and
// an unresolved toolchain each refuse before any process starts, and a trigger on an observer that
// never started is refused.
test fn the_start_refuses_without_driving_when_a_precondition_is_missing() -> Bool {
  let other = mtcollins1_kvm_observer_start(firmware: bmc_firmware_release_identity_of_wire(family: AmiMegaRac, wire: "9.99"), bmc_host: "192.0.2.1", username: "u", password_file: "/nonexistent", toolchain: BrowserToolchainUnresolved { cause: "witness" }, attempt: "1")
  let nocred = mtcollins1_kvm_observer_start(firmware: mtcollins1_bmc_firmware, bmc_host: "192.0.2.1", username: "u", password_file: "", toolchain: BrowserToolchainUnresolved { cause: "witness" }, attempt: "1")
  let notool = mtcollins1_kvm_observer_start(firmware: mtcollins1_bmc_firmware, bmc_host: "192.0.2.1", username: "u", password_file: "/nonexistent", toolchain: BrowserToolchainUnresolved { cause: "host not in the floor pool" }, attempt: "1")
  let a = match other { KvmObserverNotStarted { reason: r } => string_contains(s: r as String, pattern: "not catalogued")  _ => false }
  let b = match nocred { KvmObserverNotStarted { reason: r } => string_contains(s: r as String, pattern: "no BMC credential")  _ => false }
  let c = match notool { KvmObserverNotStarted { reason: r } => string_contains(s: r as String, pattern: "unresolved: host not in the floor pool")  _ => false }
  a && b && c && !kvm_observer_trigger(start: nocred, order: 1, reason: "power-on-verified")
}

// RETAINED WITH THE BUNDLE: the observer's directory sits under the boot's upload prefix.
test fn the_observer_directory_is_retained_with_the_boot_artifacts() -> Bool {
  starts_with(s: mtcollins1_kvm_observer_dir(attempt: "36335369059"), prefix: mtcollins1_boot_retained_artifact_prefix)
}
