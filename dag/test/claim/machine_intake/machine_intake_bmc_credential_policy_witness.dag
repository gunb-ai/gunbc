module test.claim.machine_intake.machine_intake_bmc_credential_policy_witness

import std.types { Bool, HttpStatus, List, NonEmptyStr, String }
import std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import std.algebra { length }
import std.content_hash { Sha256Digest, Sha256Hash, content_hash_of_value, sha256_hex_of_text }
import std.scoped_authorization { AttemptIdentity }
import gunbc.clock_read { ObserverClockInstant, observer_clock_modeled }
import extdeps.board_authority { BoardAuthorityRef }
import extdeps.bmc.endpoint { BmcControllerEndpoint, OpenBmc, AmiMegaRac, bmc_controller_of_endpoint }
import gunbc.fleet.fleet_intent { srv13_baseboard }
import extdeps.bmc.capability { bmc_firmware_release_identity_of_wire }
import extdeps.boards.asrock_rack { asrock_altrad8ud_board_authority }
import extdeps.ampere.mt_collins_board { mt_collins_board_authority }
import gunbc.machine_intake.receipt { EvidenceRef }
import gunbc.machine_intake.bmc_credential_policy {
  BmcCredentialPolicyKey, ForcedChangeAdmission, ForcedChangeAdmitted, ForcedChangeRefused,
  ForcedChangeNotA403, ForcedChangeVerdictNotIndicated, ForcedChangeBodyUnreadable, ForcedChangeBuildHasNoPolicy,
  ForcedChangeBuildAcceptsFactoryLogin, ForcedChangeBuildNotMeasured, ForcedChangeMessageDiffers,
  ForcedChangeCaptureIsNotThisResponse, ForcedChangeNoBuildOfTheBoardAnswersIt, ForcedChangeBuildsOfTheBoardAmbiguous,
  ForcedChangeLoginIsNotTheFactoryAccount,
  ForcedChangeResponseReading, ForcedChangeBuildReading, ForcedChangeBuildRead, ForcedChangeBuildUnreadable,
  ForcedBuildRead, ForcedBuildInferredFromTheResponse,
  ForcedBuildInference, ForcedBuildInferred, ForcedBuildNoneAnswers, ForcedBuildAmbiguous, infer_forced_build,
  RedfishBasicOrSession, IpmiLanplus,
  admit_published_credential_change_forced, asrock_altrad8ud_openbmc_3_22_00_key, shared_store_surfaces,
  bmc_credential_policy_catalog, srv13_openbmc_3_22_00_factory_login_403,
}

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// THE FORCED-CHANGE STATE IS ENTERED FROM ONE READING ONLY. The verdicts are produced by the real parser,
// extdeps.bmc.redfish redfish_password_change_verdict, over response bodies: srv13's committed 403 body
// (artifacts/bmc/srv13-first-contact-2026-10-07/bmc-3.22.00-factory-login-403.json, inlined byte for byte
// below), a licence-gate 403 of the shape Supermicro serves, and an unreadable body.

data srv13_forced_change_body: String = "{\n  \"@Message.ExtendedInfo\": [\n    {\n      \"@odata.type\": \"#Message.v1_1_1.Message\",\n      \"Message\": \"The password provided for this account must be changed before access is granted.  PATCH the Password property for this account located at the target URI '/redfish/v1/AccountService/Accounts/root' to complete this process.\",\n      \"MessageArgs\": [\n        \"/redfish/v1/AccountService/Accounts/root\"\n      ],\n      \"MessageId\": \"Base.1.16.0.PasswordChangeRequired\",\n      \"MessageSeverity\": \"Critical\",\n      \"Resolution\": \"Change the password for this account using a PATCH to the Password property at the URI provided.\"\n    }\n  ]\n}"

data licence_gate_body: String = "{\"error\":{\"code\":\"Base.v1_4_0.OemLicenseNotPassed\",\"message\":\"Not licensed to perform this request.\",\"@Message.ExtendedInfo\":[{\"MessageId\":\"Base.v1_4_0.OemLicenseNotPassed\"}]}}"

data newer_registry_body: String = "{\"@Message.ExtendedInfo\":[{\"MessageId\":\"Base.1.18.0.PasswordChangeRequired\"}]}"

data srv13_endpoint: BmcControllerEndpoint = bmc_controller_of_endpoint(endpoint: srv13_baseboard.bmc)

// A capture that names some other bytes than the response classified.
data unrelated_receipt: EvidenceRef = EvidenceRef {
  label: "witness response",
  digest: content_hash_of_value(value: "witness response" as NonEmptyStr),
}

// The committed capture of srv13's response, and, for a body with no committed file, the SHA-256 of the
// body itself (what a capture of exactly those bytes would carry).
data srv13_capture: EvidenceRef = srv13_openbmc_3_22_00_factory_login_403

fn capture_of(body: String) -> EvidenceRef {
  EvidenceRef { label: "witness capture", digest: Sha256Hash(Sha256Digest { hex: sha256_hex_of_text(text: body) }) }
}

fn key_3_22() -> BmcCredentialPolicyKey {
  asrock_altrad8ud_openbmc_3_22_00_key()
}

fn key_at(wire: NonEmptyStr) -> BmcCredentialPolicyKey {
  BmcCredentialPolicyKey { board: asrock_altrad8ud_board_authority, firmware: bmc_firmware_release_identity_of_wire(family: OpenBmc, wire: wire) }
}

fn read_at(key: BmcCredentialPolicyKey) -> ForcedChangeBuildReading {
  ForcedChangeBuildRead { firmware: key.firmware, evidence: unrelated_receipt }
}

// One response of `endpoint`'s controller, in run `attempt`.
fn controller_reading(endpoint: BmcControllerEndpoint, attempt: AttemptIdentity, board: BoardAuthorityRef, login: NonEmptyStr, status: HttpStatus, body: String, capture: EvidenceRef, firmware: ForcedChangeBuildReading) -> ForcedChangeResponseReading {
  ForcedChangeResponseReading {
    endpoint: endpoint,
    board: board,
    login: login,
    attempt: attempt,
    observed_at: observer_clock_modeled(millis: 1793145600000, realization: "credential policy witness" as NonEmptyStr),
    status: status,
    body: body,
    capture: capture,
    firmware: firmware,
  }
}

// One response of srv13's controller, in run "attempt-1".
fn reading_of(board: BoardAuthorityRef, login: NonEmptyStr, status: HttpStatus, body: String, capture: EvidenceRef, firmware: ForcedChangeBuildReading) -> ForcedChangeResponseReading {
  controller_reading(endpoint: srv13_endpoint, attempt: "attempt-1" as AttemptIdentity, board: board, login: login, status: status, body: body, capture: capture, firmware: firmware)
}

fn admission_label(reading: ForcedChangeResponseReading) -> String {
  match admit_published_credential_change_forced(reading: reading) {
    ForcedChangeAdmitted { state: st } =>
      match st.build {
        ForcedBuildRead { evidence: _ } => "forced"
        ForcedBuildInferredFromTheResponse => "forced-inferred"
      }
    ForcedChangeRefused { cause: c } =>
      match c {
        ForcedChangeNotA403 { status: _ } => "not-a-403"
        ForcedChangeCaptureIsNotThisResponse { capture: _ } => "capture-not-this-response"
        ForcedChangeVerdictNotIndicated => "not-indicated"
        ForcedChangeBodyUnreadable { cause: _ } => "unreadable"
        ForcedChangeBuildHasNoPolicy { key: _ } => "no-policy"
        ForcedChangeBuildAcceptsFactoryLogin { key: _ } => "accepts-factory-login"
        ForcedChangeBuildNotMeasured { key: _ } => "not-measured"
        ForcedChangeMessageDiffers { observed: _, measured: _ } => "message-differs"
        ForcedChangeNoBuildOfTheBoardAnswersIt { board: _, observed: _ } => "no-build-answers"
        ForcedChangeBuildsOfTheBoardAmbiguous { board: _, observed: _, builds: _ } => "ambiguous"
        ForcedChangeLoginIsNotTheFactoryAccount { login: _, factory_account: _ } => "not-the-factory-login"
      }
  }
}

// A read build, root's login, the body's own capture.
fn verdict_of(key: BmcCredentialPolicyKey, status: HttpStatus, body: String) -> String {
  admission_label(reading: reading_of(board: key.board, login: "root" as NonEmptyStr, status: status, body: body, capture: capture_of(body: body), firmware: read_at(key: key)))
}

// POSITIVE CONTROL: srv13's own 403, under its committed capture (whose SHA256SUMS digest is the digest of
// the inlined bytes), on the build it was measured on, enters the forced-change state; and with the build
// unreadable before the write, the board's one forcing build is inferred from the response.
test fn the_measured_forced_change_reading_enters_the_state() -> Bool {
  admission_label(reading: reading_of(board: asrock_altrad8ud_board_authority, login: "root" as NonEmptyStr, status: 403, body: srv13_forced_change_body, capture: srv13_capture, firmware: read_at(key: key_3_22()))) == "forced"
    && admission_label(reading: reading_of(board: asrock_altrad8ud_board_authority, login: "root" as NonEmptyStr, status: 403, body: srv13_forced_change_body, capture: srv13_capture, firmware: ForcedChangeBuildUnreadable)) == "forced-inferred"
}

// THE REDS (merry-fox-82, 2026-10-28): any other 403 refuses -- a licence gate, an unreadable body, the same
// verdict under a different registry version than the row measured -- and so does the measured body with any
// other status, or on a build nobody measured.
test fn any_other_reading_refuses_the_forced_change_state() -> Bool {
  verdict_of(key: key_3_22(), status: 403, body: licence_gate_body) == "not-indicated"
    && verdict_of(key: key_3_22(), status: 403, body: "<html>forbidden</html>") == "unreadable"
    && verdict_of(key: key_3_22(), status: 403, body: newer_registry_body) == "message-differs"
    && verdict_of(key: key_3_22(), status: 401, body: srv13_forced_change_body) == "not-a-403"
    && verdict_of(key: key_at(wire: "3.06.00" as NonEmptyStr), status: 403, body: srv13_forced_change_body) == "no-policy"
}

// THE RESPONSE IS ONE CONTROLLER'S ONE ANSWER. The capture must be the classified bytes (a capture of other
// bytes, or of another response, refuses); the login must be the build's factory account; and with the build
// unread, a board with no forcing build, or a message no build of the board answers, infers nothing.
test fn a_forced_reading_is_bound_to_its_response_its_login_and_its_board() -> Bool {
  let unread = ForcedChangeBuildUnreadable
  admission_label(reading: reading_of(board: asrock_altrad8ud_board_authority, login: "root" as NonEmptyStr, status: 403, body: srv13_forced_change_body, capture: unrelated_receipt, firmware: unread)) == "capture-not-this-response"
    && admission_label(reading: reading_of(board: asrock_altrad8ud_board_authority, login: "root" as NonEmptyStr, status: 403, body: srv13_forced_change_body, capture: capture_of(body: licence_gate_body), firmware: unread)) == "capture-not-this-response"
    && admission_label(reading: reading_of(board: asrock_altrad8ud_board_authority, login: "admin" as NonEmptyStr, status: 403, body: srv13_forced_change_body, capture: srv13_capture, firmware: unread)) == "not-the-factory-login"
    && admission_label(reading: reading_of(board: mt_collins_board_authority, login: "root" as NonEmptyStr, status: 403, body: srv13_forced_change_body, capture: srv13_capture, firmware: unread)) == "no-build-answers"
    && admission_label(reading: reading_of(board: asrock_altrad8ud_board_authority, login: "root" as NonEmptyStr, status: 403, body: newer_registry_body, capture: capture_of(body: newer_registry_body), firmware: unread)) == "no-build-answers"
}

// TWO BUILDS OF ONE BOARD ANSWERING THE SAME MESSAGE NAME NO BUILD. The live catalog has one forcing row per
// board, so the ambiguity is exercised on the inference itself over a catalog that lists the row twice; the
// live catalog's single row is inferred (paired control).
test fn two_builds_answering_one_message_infer_nothing() -> Bool {
  let doubled = concat(bmc_credential_policy_catalog, bmc_credential_policy_catalog)
  let observed = "Base.1.16.0.PasswordChangeRequired"
  (match infer_forced_build(board: asrock_altrad8ud_board_authority, observed: observed, catalog: doubled) {
    ForcedBuildAmbiguous { builds: b } => length(b) == 2
    ForcedBuildInferred { row: _ } => false
    ForcedBuildNoneAnswers => false
  })
    && (match infer_forced_build(board: asrock_altrad8ud_board_authority, observed: observed, catalog: bmc_credential_policy_catalog) {
      ForcedBuildInferred { row: _ } => true
      ForcedBuildAmbiguous { builds: _ } => false
      ForcedBuildNoneAnswers => false
    })
}

// THE SHARED-STORE ROW NAMES ONLY WHAT IT GROUNDS. 3.22.00 grounds the Redfish surface and not IPMI lanplus;
// a board nobody measured grounds nothing.
test fn the_shared_store_row_names_only_its_grounded_surfaces() -> Bool {
  let grounded = shared_store_surfaces(key: key_3_22())
  any(grounded, x => x.surface == RedfishBasicOrSession)
    && !any(grounded, x => x.surface == IpmiLanplus)
    && length(shared_store_surfaces(key: BmcCredentialPolicyKey { board: mt_collins_board_authority, firmware: bmc_firmware_release_identity_of_wire(family: AmiMegaRac, wire: "0.45" as NonEmptyStr) })) == 0
}
