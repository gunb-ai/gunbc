  RecoveryWriteRecord, ExecutedWithoutByteCapture, recovery_write_was_attempted, recovery_write_grounds_success,
  recovery_reset_actuation, InBandTemporaryAdministratorPassword,
  RecoveryRouteUnavailable, RecoveryFirmwarePolicyUnknown, recovery_test_route,
  recovery_measured_refusal_policy, converge_in_band_recovery,
