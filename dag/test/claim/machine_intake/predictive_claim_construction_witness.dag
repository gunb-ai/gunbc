module test.claim.machine_intake.predictive_claim_construction_witness

import std.types { String }
import std.process { ProcessExit }
import std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import gunbc.compile_census_probe { blocking_class_census, total_blocking_census, census_verdict, census_exit }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

fn prediction_construction_refuses(source: String, class: String) -> ProcessExit {
  census_exit(census_verdict(census: blocking_class_census(source: source, wanted_class: class), holds: fn(n) { n > 0 }))
}

test fn predictive_model_cannot_be_forged_or_have_its_receipts_erased() -> ProcessExit {
  prediction_construction_refuses(
    source: "module predictive_forge_probe\nimport std.predictive_claim { PredictiveModel }\nfn forge(old: PredictiveModel<Int, Int>) -> PredictiveModel<Int, Int> { PredictiveModel { prediction: old.prediction, tests: [], superseded: [] } }\n",
    class: "SoleConstructorViolation",
  )
}

test fn a_started_test_cannot_be_forged_without_ordering_admission() -> ProcessExit {
  prediction_construction_refuses(
    source: "module predictive_start_forge_probe\nimport std.predictive_claim { StartedPredictiveTest }\nfn forge(old: StartedPredictiveTest<Int, Int>) -> StartedPredictiveTest<Int, Int> { StartedPredictiveTest { committed: old.committed, configuration: old.configuration, discrimination: old.discrimination, started_at: 0 } }\n",
    class: "SoleConstructorViolation",
  )
}

test fn the_internal_append_cannot_bypass_registration_admission() -> ProcessExit {
  prediction_construction_refuses(
    source: "module predictive_append_forge_probe\nimport std.predictive_claim { PredictiveModel, PredictiveModelResult, PredictionTestReceipt, append_predictive_observation }\nfn forge(model: PredictiveModel<Int, Int>, receipt: PredictionTestReceipt<Int, Int>) -> PredictiveModelResult<Int, Int> { append_predictive_observation(model: model, configuration: receipt.configuration, observation: receipt.observation, source: receipt.source, registration: receipt.registration, discrimination: receipt.discrimination) }\n",
    class: "ConstructorCallAdmissionRefused",
  )
}

test fn the_same_model_is_readable_through_the_public_boundary() -> ProcessExit {
  census_exit(census_verdict(census: total_blocking_census(source: "module predictive_read_probe\nimport std.predictive_claim { PredictiveModel }\nfn read(model: PredictiveModel<Int, Int>) -> Int { count(model.tests) }\n"), holds: fn(n) { n == 0 }))
}
