module test.claim.bmc_intake_first_contact_witness

import std.types { Bool }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import gunbc.machine_intake_bmc_first_contact_standing {
  BmcFirmwareFamilyStanding,
  FamilyObserved,
  FamilyUnobserved,
}
import gunbc.machine_intake_mtjade1_access_observation { mtjade1_firmware_family_standing }
import extdeps.bmc.endpoint { AmiMegaRac }
import gunbc.tools.bmc_intake_first_contact {
  HostUnreachable,
  IntakeRedfishSurface,
  RedfishHttpSurface,
  WriteOutUnreadable,
  classify_intake_probe,
  intake_probe_host_unreachable_cause,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn w_intake_probe_404_is_a_captured_surface_not_a_failed_login() -> Bool {
  match classify_intake_probe(reached_host: true, blob: "{}\n404", transport_stderr: "") {
      RedfishHttpSurface { status: s, blob: b } => s == 404 && b == "{}\n404"
      HostUnreachable { cause: _, transport_stderr: _ } => false
      WriteOutUnreadable { blob: _, cause: _ } => false
    }
}

// BOTH FIXTURES ARE THE SHAPES THE TRANSPORT REALLY PRODUCES ON AN UNREACHABLE HOST: stdout is
// the write-out alone ("\n000", because -sS sends curl's message to stderr) and stderr carries
// the connect text. The earlier form of this claim supplied curl's prose as the STDOUT blob — a
// shape the operation never emits — so it stayed green while the production refusal printed
// "\n000". The discriminating REDs are both conjuncts: refusing with the stdout blob again makes
// the first false, and dropping the stderr binding makes the second false.
test fn w_intake_probe_unreachable_host_is_not_a_surface() -> Bool {
  match classify_intake_probe(
    reached_host: false,
    blob: "\n000",
    transport_stderr: "curl: (7) Failed to connect to 10.0.0.9 port 443 after 3 ms: Could not connect to server",
  ) {
    HostUnreachable { cause: c, transport_stderr: e } =>
      c == intake_probe_host_unreachable_cause && string_contains(s: e, pattern: "Failed to connect")
    RedfishHttpSurface { status: _, blob: _ } => false
    WriteOutUnreadable { blob: _, cause: _ } => false
  }
}

test fn w_intake_probe_success_without_write_out_line_is_unreadable() -> Bool {
  match classify_intake_probe(reached_host: true, blob: "{\"RedfishVersion\":\"1.0.0\"}", transport_stderr: "") {
    WriteOutUnreadable { blob: b, cause: _ } => string_contains(s: b, pattern: "RedfishVersion")
    RedfishHttpSurface { status: _, blob: _ } => false
    HostUnreachable { cause: _, transport_stderr: _ } => false
  }
}

// NEITHER SURFACE CONSTRUCTS A FAMILY, WHICH IS THE CLAIM THE TRIGGERS DEPEND ON. An earlier
// revision of this branch wrote "a wet ProbeServiceRoot read binds FamilyObserved" into four
// triggers and two annotations. It cannot: a 200 service root is served by several firmware
// families, and a 404 establishes the absence of that surface rather than MegaRAC. The claim is
// stated as a FOLD from an intake surface to a standing so it can actually be run, and the fold
// is total in the only way that is honest -- every surface, reachable or not, answers unobserved.
//
// THE RED IS AUTHORABLE AND THE THIRD CONJUNCT IS IT: a future fold that promotes a 200 into
// FamilyObserved reddens this, which is precisely the promotion the triggers must not license.
fn intake_surface_family_standing(surface: IntakeRedfishSurface) -> BmcFirmwareFamilyStanding {
  match surface {
    RedfishHttpSurface { status: _, blob: _ } => mtjade1_firmware_family_standing
    HostUnreachable { cause: _, transport_stderr: _ } => mtjade1_firmware_family_standing
    WriteOutUnreadable { blob: _, cause: _ } => mtjade1_firmware_family_standing
  }
}

fn standing_is_unobserved(standing: BmcFirmwareFamilyStanding) -> Bool {
  match standing {
    FamilyUnobserved { discriminator: _ } => true
    FamilyObserved { family: _ } => false
  }
}

test fn w_neither_a_200_nor_a_404_redfish_surface_observes_a_family() -> Bool {
  standing_is_unobserved(
    standing: intake_surface_family_standing(
      surface: classify_intake_probe(reached_host: true, blob: "{\"RedfishVersion\":\"1.6.0\"}\n200", transport_stderr: ""),
    ),
  )
    && standing_is_unobserved(
      standing: intake_surface_family_standing(
        surface: classify_intake_probe(reached_host: true, blob: "{}\n404", transport_stderr: ""),
      ),
    )
    && standing_is_unobserved(standing: mtjade1_firmware_family_standing)
    && standing_is_unobserved(standing: FamilyObserved { family: AmiMegaRac }) == false
}
