module test.claim.bmc_intake_first_contact_witness

import std.types { Bool, String }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import gunbc.machine_intake_bmc_first_contact_standing { FamilyObserved, FamilyUnobserved }
import gunbc.machine_intake_mtjade1_access_observation {
  CaptureBoundToAnotherLink,
  CaptureDigestMismatch,
  CaptureFieldUnread,
  CaptureJsonUnreadable,
  RecordedManagerDecode,
  RecordedManagerDecoded,
  RecordedManagerRefused,
  decode_recorded_manager_capture,
  mtjade1_redfish_manager_capture_sha256,
  recorded_manager_family_standing,
}
import gunbc.machine_intake_mtjade1_factory_network { mtjade1_bmc_observed_network }
import extdeps.bmc.endpoint { AmiMegaRac, OpenBmc }
import gunbc.tools.bmc_intake_first_contact {
  HostUnreachable,
  RedfishHttpSurface,
  WriteOutUnreadable,
  classify_intake_probe,
  intake_probe_host_unreachable_cause,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn w_intake_probe_404_is_a_captured_surface_not_a_failed_login() -> Bool  {
  match classify_intake_probe(reached_host: true, blob: "{}\n404", transport_stderr: "") {
      RedfishHttpSurface { status: s, blob: b } => s == 404 && b == "{}\n404"
      HostUnreachable { cause: _, transport_stderr: _ } => false
      WriteOutUnreadable { blob: _, cause: _ } => false
    }
}

// BOTH FIXTURES ARE THE SHAPES THE TRANSPORT REALLY PRODUCES ON AN UNREACHABLE HOST: stdout is
// the write-out alone ("\n000", because -sS sends curl's message to stderr) and stderr carries
// the connect text. The earlier form of this claim supplied curl's prose as the STDOUT blob — a
// shape the operation never emits — so it stayed green while the production refusal printed
// "\n000". The discriminating REDs are both conjuncts: refusing with the stdout blob again makes
// the first false, and dropping the stderr binding makes the second false.
test fn w_intake_probe_unreachable_host_is_not_a_surface() -> Bool  {
  match classify_intake_probe(
    reached_host: false,
    blob: "\n000",
    transport_stderr: "curl: (7) Failed to connect to 10.0.0.9 port 443 after 3 ms: Could not connect to server",
  ) {
    HostUnreachable { cause: c, transport_stderr: e } =>
      c == intake_probe_host_unreachable_cause && string_contains(s: e, pattern: "Failed to connect")
    RedfishHttpSurface { status: _, blob: _ } => false
    WriteOutUnreadable { blob: _, cause: _ } => false
  }
}

test fn w_intake_probe_success_without_write_out_line_is_unreadable() -> Bool  {
  match classify_intake_probe(reached_host: true, blob: "{\"RedfishVersion\":\"1.0.0\"}", transport_stderr: "") {
    WriteOutUnreadable { blob: b, cause: _ } => string_contains(s: b, pattern: "RedfishVersion")
    RedfishHttpSurface { status: _, blob: _ } => false
    HostUnreachable { cause: _, transport_stderr: _ } => false
  }
}

// THE PROMOTION THIS BRANCH'S TRIGGERS DEPEND ON IS UNCONSTRUCTIBLE, NOT CHECKED, and saying so
// is the whole correction. IntakeRedfishSurface carries no BmcFirmwareFamily in any arm --
// RedfishHttpSurface holds an HttpStatus and a blob, HostUnreachable a cause and stderr,
// WriteOutUnreadable a blob and a cause -- so no total fold from it can reach FamilyObserved
// without inventing a family from nothing. That is DESIGN section 4b rung 4: the invalid state
// has no constructor in the canonical model, and validation is unnecessary because the bad state
// cannot be written.
//
// AN EARLIER REVISION OF THIS FILE "PROVED" IT INSTEAD, AND THE PROOF WAS A DECORATION (review
// 68252). It defined a fold from surface to standing that discarded its argument and returned the
// same constant in every arm, so a 200 and a 404 answered unobserved for any input whatsoever;
// the promotion it claimed to forbid lived in this test file and no production path could redden
// it. The operator asked for that RED and I built something that could not go red, then cited it
// in two frontier triggers as the property they rest on -- the exact shape ten earlier commits on
// this branch deleted elsewhere, surviving in the one file whose prose defended it.
//
// THE RECORDED-CAPTURE DECODE, OVER SUPPLIED DOCUMENTS (DESIGN §3: the committed file's real read
// runs once, in test.claim.mtjade1_recorded_manager_capture_witness). Each control states the one
// gap it must land in, so a decoder that refused for a DIFFERENT reason would red it. The supplied
// documents carry their own digest, computed here, because the subject of these claims is the
// decode and binding, not the recorded digest -- that is the live witness's subject.
fn ami_manager(board_extra: String, model_member: String) -> String {
  join(["\{\"Id\": \"Self\", \"FirmwareVersion\": \"2.11.104000\", ", model_member, "\"Oem\": \{\"Ami\": \{}, \"Amp\": \{\"FruInformation\": \{\"BoardExtra\": \"", board_extra, "\"}}}}"], "")
}

fn decode_self_digested(text: String) -> RecordedManagerDecode {
  decode_recorded_manager_capture(content: text, expected_sha256: sha256_hex_of_text(text: text), network: mtjade1_bmc_observed_network)
}

test fn w_a_bound_ami_manager_is_observed_megarac() -> Bool  {
  match recorded_manager_family_standing(decoded: decode_self_digested(text: ami_manager(board_extra: "70:E2:84:95:33:6B", model_member: "\"Model\": \"130582050\", "))) {
    FamilyObserved { family: f } => match f { AmiMegaRac => true  OpenBmc => false }
    FamilyUnobserved { discriminator: _ } => false
  }
}

fn refused_as_another_link(board_extra: String) -> Bool {
  match decode_self_digested(text: ami_manager(board_extra: board_extra, model_member: "\"Model\": \"130582050\", ")) {
    RecordedManagerRefused { gap: CaptureBoundToAnotherLink { board_extra: b } } => b == board_extra
    RecordedManagerRefused { gap: _ } => false
    RecordedManagerDecoded { observation: _ } => false
  }
}

// The second conjunct is the same address in another spelling: it refuses too, because the
// binding compares what the capture said, not a normalization of it.
test fn w_a_valid_ami_manager_with_another_mac_does_not_classify_mtjade1() -> Bool  {
  refused_as_another_link(board_extra: "70:E2:84:95:33:6C") && refused_as_another_link(board_extra: "70:e2:84:95:33:6b")
}

test fn w_a_capture_whose_bytes_drifted_from_the_recorded_digest_is_refused() -> Bool  {
  match decode_recorded_manager_capture(
    content: ami_manager(board_extra: "70:E2:84:95:33:6B", model_member: "\"Model\": \"130582050\", "),
    expected_sha256: mtjade1_redfish_manager_capture_sha256,
    network: mtjade1_bmc_observed_network,
  ) {
    RecordedManagerRefused { gap: CaptureDigestMismatch { expected: _, observed: _ } } => true
    RecordedManagerRefused { gap: _ } => false
    RecordedManagerDecoded { observation: _ } => false
  }
}

test fn w_a_capture_that_is_not_one_json_document_is_refused() -> Bool  {
  match decode_self_digested(text: "\{\"Id\": \"Self\"") {
    RecordedManagerRefused { gap: CaptureJsonUnreadable { gap: _ } } => true
    RecordedManagerRefused { gap: _ } => false
    RecordedManagerDecoded { observation: _ } => false
  }
}

test fn w_a_capture_missing_model_is_unobserved() -> Bool  {
  let decoded = decode_self_digested(text: ami_manager(board_extra: "70:E2:84:95:33:6B", model_member: ""))
  match decoded {
    RecordedManagerRefused { gap: CaptureFieldUnread { field: f, cause: _ } } => (f as String) == "Model"
    RecordedManagerRefused { gap: _ } => false
    RecordedManagerDecoded { observation: _ } => false
  }
    && match recorded_manager_family_standing(decoded: decoded) {
      FamilyUnobserved { discriminator: _ } => true
      FamilyObserved { family: _ } => false
    }
}
