// THE 0.45.3 MEDIA CONVERGE, as boot run 40038339650 met it: firmware 0.45.3 (the current build since the
// 2026-10-02 reflash), the runner medium wanted, and the census session an earlier attempt left on the
// controller reading redirection_status 19. Every input is a supplied configurations body at the
// converge's own pure folds; the real producer of these bodies is megarac.Media.Configurations through
// megarac_attach_remote_image, executed on the controller by the boot run, not here.
data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data runner_desired: NonEmptyStr = ubuntu_seeded_install_media_image_name(image_stem: runner_host_medium_image_stem, output_digest: "31aef93912ab34cd56")
// The image boot run 40038339650 found presented, by its committed name.
data census_left: NonEmptyStr = "gunbc-mtcollins1-census-ubuntu-24.04.3-arm64-161b98b9bb389a80.iso"
data both_stems: FreeSemigroup<NonEmptyStr> = FreeSemigroup { head: runner_host_medium_image_stem, tail: [mtcollins1_census_image_stem] }
data runner_only: FreeSemigroup<NonEmptyStr> = non_empty_singleton(item: runner_host_medium_image_stem)
data firmware_0_99: BmcFirmwareReleaseIdentity = bmc_firmware_release_identity_of_wire(family: AmiMegaRac, wire: "0.99")

fn row(name: String, status: String) -> String {
  concat("{\"id\":1,\"media_type\":1,\"media_index\":0,\"session_index\":0,\"image_name\":\"", concat(name, concat("\",\"redirection_status\":", concat(status, "}"))))
}

fn rows1(a: String) -> String { concat("[", concat(a, "]")) }
fn rows2(a: String, b: String) -> String { concat("[", concat(a, concat(",", concat(b, "]")))) }

fn step_on(configurations: String, firmware: BmcFirmwareReleaseIdentity, stems: FreeSemigroup<NonEmptyStr>) -> ConvergenceStep {
  megarac_convergence_step(
    convergence: presented_convergence(
      presented: presented_media(body: configurations, image_name: runner_desired, firmware: firmware, replaceable: Present { value: stems }),
      image_name: runner_desired,
      replaceable_seeded_stems: stems,
    ),
    detach: MegaRacDetachAdmitted,
    configurations: configurations,
    cd_before: CdErrorRead { code: CdErrorNone },
  )
}

// A REFUSAL IS ASSERTED BY ITS REASON: the row, the unread arm, and the condition that kept it unstopped.
fn refused_unread(s: ConvergenceStep, name: String, want: MegaRacRedirectionUnread, why: UnreadRowStopRefusal) -> Bool {
  match s {
    ConvergeStepRefuse { outcome: MegaRacRedirectionUncatalogued { image_name: n, unread: u, refusal: r, configurations: _ } } => n == name && u == want && r == why
    _ => false
  }
}

fn stop_evidence(readback: String) -> MegaRacDetachEvidence {
  MegaRacDetachEvidence {
    stale_image: census_left as String,
    media_index: "0",
    command: megarac_write_answer(exit_code: 0, body: "{}", stderr: ""),
    readback_read: true,
    readback: readback,
    cd_after_stop: CdErrorRead { code: CdErrorNone },
    general_after_stop: MegaRacRawRead { answered: true, body: "{}", observed_at: Present { value: 1 } },
  }
}

// THE EXPECTED RELEASE, WRITTEN IN THIS LANE ONLY HERE (the way a capture's digest is written only in a
// witness). extdeps.bmc.megarac DECLARES this release as the one the controller reports and keys its 0.45
// redirection arm on it; gunbc.host.bmc_release_capability_catalog DERIVES it from the retained stdout of
// this unit's boot run. Every claim below is a cross-check that the derivation lands on what is declared,
// so re-typing "0.45.3" anywhere, or letting the parser drift, reds here instead of letting a plausible
// build number become the default.
data the_build_the_read_names: BmcFirmwareReleaseIdentity = bmc_firmware_release_identity_of_wire(family: AmiMegaRac, wire: "0.45")

// THE JOIN, MADE A CLAIM. extdeps declares the release the controller REPORTS (raw "0.45", no semantic
// version) and keys its 0.45 redirection arm there; the observing layer walks the retained stdout of this
// unit's boot run through the parser and answers with causes. Nothing in the vendor model may parse a
// machine's receipt -- so what holds the two together is THIS claim: the release this unit's committed read
// establishes is the release the table catalogues, and it is not the vendor's page label. If the capture
// stops parsing, this claim goes red and the join stops being claimed; the vendor table itself does not
// quietly disappear for every caller.
test fn w_the_committed_read_lands_on_the_release_the_media_table_catalogues() -> Bool {
  match mtcollins1_current_build_firmware {
    Absent => false
    Present { value: read } =>
      bmc_firmware_release_identity_eq(a: read, b: megarac_firmware_0_45_reported)
        && bmc_firmware_release_identity_eq(a: read, b: the_build_the_read_names)
        && (read.raw_version as String) == "0.45"
        && match read.semantic_version { Absent => true  Present { value: _ } => false }
        && !bmc_firmware_release_identity_eq(a: read, b: megarac_firmware_0_45_3)
  }
}

// THE PAGE LABEL IS NOT A KEY OF THE TABLE. A caller carrying the vendor's page wording gets no catalogue
// at all -- not because the build is unknown, but because the label is not what the build reports. This is
// the discriminating half of the move: the 0.45 codes are reachable ONLY at the derived release, and a row
// that ever carries "0.45.3" as its identity refuses rather than inheriting them.
test fn the_vendor_page_label_is_not_a_key_of_the_redirection_table() -> Bool {
  megarac_redirection_status_of_wire(firmware: megarac_firmware_0_45_3, wire: 1)
    == RedirectionStatusFirmwareUncatalogued { firmware: megarac_firmware_0_45_3, wire: 1 }
}

// THE CATALOGUE, AT THE RELEASE THE COMMITTED hpm READ DERIVES -- not the vendor's page label "0.45.3",
// which is a key of nothing here. 1 is the one code committed 0.45 readings show: boot run 38789347052
// read 1 on its session, and boot run 40258937016 read 1 on the session it then established (session_index
// 0, cd_error_code 0) in the run that machine-read this build.
test fn at_the_read_build_wire_1_is_started_and_presenting() -> Bool {
  let l = megarac_redirection_status_of_wire(firmware: the_build_the_read_names, wire: 1)
  (match l { RedirectionStatusKnown { firmware: f, status: RedirectionStartedConnectionAccepted } => bmc_firmware_release_identity_eq(a: f, b: the_build_the_read_names)  _ => false })
    && megarac_redirection_presentation_standing(lookup: l) == RedirectionPresenting
}

// 0.32's other codes are NOT inherited: no 0.45 wire reading grounds a bare 0, and 19 stays unread there.
// (100 is catalogued at this build, but on this build's own vendor rendering, not by inheritance:
// w_100_at_the_read_build_is_connecting_on_the_vendors_rendering.)
test fn at_the_read_build_the_0_32_codes_are_not_carried_over() -> Bool {
  megarac_redirection_status_of_wire(firmware: the_build_the_read_names, wire: 0) == RedirectionStatusKnown { firmware: the_build_the_read_names, status: RedirectionWireUncatalogued { wire: 0 } }
    && megarac_redirection_status_of_wire(firmware: the_build_the_read_names, wire: 19) == RedirectionStatusKnown { firmware: the_build_the_read_names, status: RedirectionWireUncatalogued { wire: 19 } }
}

test fn the_0_32_catalogue_is_unchanged() -> Bool {
  megarac_redirection_status_of_wire(firmware: megarac_firmware_0_32, wire: 0) == RedirectionStatusKnown { firmware: megarac_firmware_0_32, status: RedirectionStopped }
    && megarac_redirection_status_of_wire(firmware: megarac_firmware_0_32, wire: 1) == RedirectionStatusKnown { firmware: megarac_firmware_0_32, status: RedirectionStartedConnectionAccepted }
    && megarac_redirection_status_of_wire(firmware: megarac_firmware_0_32, wire: 100) == RedirectionStatusKnown { firmware: megarac_firmware_0_32, status: RedirectionConnecting }
    && megarac_redirection_status_of_wire(firmware: megarac_firmware_0_32, wire: 19) == RedirectionStatusKnown { firmware: megarac_firmware_0_32, status: RedirectionWireUncatalogued { wire: 19 } }
}

test fn an_uncatalogued_release_stays_firmware_uncatalogued() -> Bool {
  megarac_redirection_status_of_wire(firmware: firmware_0_99, wire: 1) == RedirectionStatusFirmwareUncatalogued { firmware: firmware_0_99, wire: 1 }
}

// ── BOOT RUN 40264233543'S LEFTOVER ROW, AND WHETHER THE RULE AS IT STANDS COULD STOP IT ──────────────
// The question a boot would have answered -- once the route reads the build the committed hpm check
// names, can the media row boot 5 left on the controller be stopped? -- is answered here instead, over
// the row boot 6's own diagnostics carry verbatim:
// artifacts/bmc/mtcollins1-boot-run-40264233543/mtcollins1-boot-diagnostics.txt prints
//   [ { "id": 1, "media_type": 1, "media_index": 0, "session_index": 255,
//       "image_name": "gunbc-runner-host-ubuntu-24.04.3-arm64-31aef9394d9e58c3.iso",
//       "redirection_status": 16 } ]
// and refuses: "the row naming '...31aef939...iso' reports redirection_status 16 on firmware 0.32 ...
// refusing before any write or power action". session_index 255 is carried verbatim below and NOTHING in
// today's decode consults it; that it means "no active session" belongs to the status-16 lane, not here.
data boot6_leftover_iso: NonEmptyStr = "gunbc-runner-host-ubuntu-24.04.3-arm64-31aef9394d9e58c3.iso"

fn boot6_leftover_rows() -> String {
  "[{\"id\":1,\"media_type\":1,\"media_index\":0,\"session_index\":255,\"image_name\":\"gunbc-runner-host-ubuntu-24.04.3-arm64-31aef9394d9e58c3.iso\",\"redirection_status\":16}]"
}

// The same pure converge, with the WANTED image as a parameter: at boot 6 the leftover row IS the image
// the attempt wants -- it is this lane's runner ISO, left attached by the previous run.
fn step_for(configurations: String, firmware: BmcFirmwareReleaseIdentity, stems: FreeSemigroup<NonEmptyStr>, image_name: NonEmptyStr) -> ConvergenceStep {
  megarac_convergence_step(
    convergence: presented_convergence(
      presented: presented_media(body: configurations, image_name: image_name, firmware: firmware, replaceable: Present { value: stems }),
      image_name: image_name,
      replaceable_seeded_stems: stems,
    ),
    detach: MegaRacDetachAdmitted,
    configurations: configurations,
    cd_before: CdErrorRead { code: CdErrorNone },
  )
}

// WHAT BOOT 6 ACTUALLY DID, AT THE IDENTITY ITS ROW CARRIED. The managed-host row's access observation
// still names the 2026-09-05 probe's 0.32, so 16 reaches a table that exists but does not name 16: an
// unread CODE, on a release that is not the one the stop exception is bound to (0.45.3). This is the arm
// boot 6's receipt text renders, and it is not a stop.
test fn boot_six_refused_on_the_release_arm_at_the_identity_its_row_carried() -> Bool {
  refused_unread(
    s: step_for(configurations: boot6_leftover_rows(), firmware: mtcollins1_identity.firmware, stems: both_stems, image_name: boot6_leftover_iso),
    name: boot6_leftover_iso as String,
    want: RedirectionUnreadCode { firmware: mtcollins1_identity.firmware, wire: 16 },
    why: UnreadStopReleaseNotEvidenced { unread: RedirectionUnreadCode { firmware: mtcollins1_identity.firmware, wire: 16 } },
  )
}

// THE LEFTOVER EJECTED ROW NO LONGER STOPS ANYTHING AT THE BUILD THIS REPOSITORY READ -- AND THE REASON IS
// A CODE THAT WAS READ, NOT A RULE THAT WAS LOOSENED. Boot run 40264233543 met a row naming this lane's
// runner ISO at redirection_status 16 with session_index 255 and REFUSED on it: the machine-read
// identity's table named only 1, so 16 was an unread CODE, and the arm that protects the wanted image
// refused the step. Code 16 has since been READ -- twice, as a row, at this build, in
// gunbc.machine_intake.megarac_media_row_reading -- so the row now reads as what the controller reports:
// STOPPED, not presenting. Nothing was detached, and no stop rule was widened: the convergence simply has
// a status to read, and it attaches the wanted image. Under the 2026-09-05 probe's 0.32 the same row is
// STILL an unread code -- that release never returned 16 -- and the step still refuses, which is what
// keeps this a fact about a release rather than a global loosening. The claim goes red if 16 is catalogued
// where it was not read (as a default, or on the 0.32 arm), and if the session index stops mattering (the
// RED beside it: w_code_16_beside_an_active_session_is_still_an_unread_code).
test fn w_the_leftover_ejected_row_is_not_presenting_at_the_build_this_repository_read() -> Bool {
  match mtcollins1_current_build_firmware {
    Absent => false
    Present { value: read } =>
      match step_for(configurations: boot6_leftover_rows(), firmware: read, stems: both_stems, image_name: boot6_leftover_iso) {
        ConvergeStepAttachFromListing => true
        _ => false
      }
      && match step_for(configurations: boot6_leftover_rows(), firmware: mtcollins1_identity.firmware, stems: both_stems, image_name: boot6_leftover_iso) {
        ConvergeStepRefuse { outcome: MegaRacRedirectionUncatalogued { image_name: n, unread: u, refusal: r, configurations: _ } } =>
          n == (boot6_leftover_iso as String)
            && u == RedirectionUnreadCode { firmware: mtcollins1_identity.firmware, wire: 16 }
            && r == UnreadStopReleaseNotEvidenced { unread: u }
        _ => false
      }
  }
}

// THE GATE THE CALLER SWITCH MUST NOT CROSS ALONE. extdeps.bmc.megarac's redirection-status table is keyed
// on the operator's page label "0.45.3"; the identity this unit's build machine-reads is raw "0.45", and
// those are not the same release identity, so at the derived identity the table has NO arm -- every code,
// including the 1 that boot run 40258937016 read as its own started session (redirection_status=1,
// session_index 0, cd_error_code 0, established) while the same run printed
// build=machine-read APP 0.45, comes back as RedirectionStatusFirmwareUncatalogued. A boot that reads its
// own build as 0.45 therefore cannot tell a started session from a stopped one at all: attach refuses on
// EVERY row, not only on the leftover. This claim FAILS until the table's 0.45 arm is keyed on the
// identity the committed read derives, and it is why the table move and the caller switch are one
// transition, not two. A bare 0 stays uncatalogued at that release; 100 is Connecting there on that release's
// own vendor rendering (w_100_at_the_read_build_is_connecting_on_the_vendors_rendering).
test fn the_redirection_table_reaches_the_build_the_machine_read_names() -> Bool {
  match mtcollins1_current_build_firmware {
    Absent => false
    Present { value: read } =>
      match megarac_redirection_status_of_wire(firmware: read, wire: 1) {
        RedirectionStatusKnown { firmware: f, status: RedirectionStartedConnectionAccepted } =>
          bmc_firmware_release_identity_eq(a: f, b: read)
            && megarac_redirection_status_of_wire(firmware: read, wire: 16) == RedirectionStatusKnown { firmware: read, status: RedirectionWireUncatalogued { wire: 16 } }
            && megarac_redirection_status_of_wire(firmware: read, wire: 0) == RedirectionStatusKnown { firmware: read, status: RedirectionWireUncatalogued { wire: 0 } }
            && megarac_redirection_status_of_wire(firmware: read, wire: 100) == RedirectionStatusKnown { firmware: read, status: RedirectionConnecting }
        _ => false
      }
  }
}

// THE RUN 40038339650 STATE, WITH BOTH STEMS: the census session at 19 is this lane's residue and is
// stopped.
test fn the_left_census_session_at_19_at_the_read_build_is_stopped() -> Bool {
  match step_on(configurations: rows1(a: row(name: census_left as String, status: "19")), firmware: the_build_the_read_names, stems: both_stems) {
    ConvergeStepDetachStale { row: r } => r.image_name == (census_left as String) && r.redirection_wire == 19
    _ => false
  }
}

// THE SAME STATE WITH ONLY THE RUNNER STEM -- the set #14912 left -- refuses, and the refusal says which
// arm (the code, not the firmware) and on which release.
test fn with_only_the_runner_stem_the_census_session_refuses_on_its_code() -> Bool {
  refused_unread(
    s: step_on(configurations: rows1(a: row(name: census_left as String, status: "19")), firmware: the_build_the_read_names, stems: runner_only),
    name: census_left as String,
    want: RedirectionUnreadCode { firmware: the_build_the_read_names, wire: 19 },
    why: UnreadStopImageForeign,
  )
}

test fn a_foreign_image_at_19_is_never_stopped() -> Bool {
  refused_unread(
    s: step_on(configurations: rows1(a: row(name: "someone-elses-installer.iso", status: "19")), firmware: the_build_the_read_names, stems: both_stems),
    name: "someone-elses-installer.iso",
    want: RedirectionUnreadCode { firmware: the_build_the_read_names, wire: 19 },
    why: UnreadStopImageForeign,
  )
}

test fn the_wanted_image_at_19_is_not_stopped() -> Bool {
  refused_unread(
    s: step_on(configurations: rows1(a: row(name: runner_desired as String, status: "19")), firmware: the_build_the_read_names, stems: both_stems),
    name: runner_desired as String,
    want: RedirectionUnreadCode { firmware: the_build_the_read_names, wire: 19 },
    why: UnreadStopRowIsTheWantedImage,
  )
}

test fn an_unnamed_row_at_an_unread_code_refuses() -> Bool {
  refused_unread(
    s: step_on(configurations: rows1(a: row(name: "", status: "0")), firmware: the_build_the_read_names, stems: both_stems),
    name: "",
    want: RedirectionUnreadCode { firmware: the_build_the_read_names, wire: 0 },
    why: UnreadStopRowUnnamed,
  )
}

// Our census session beside a started foreign one: the foreign row decides, and nothing is stopped.
test fn the_census_session_beside_a_foreign_one_refuses() -> Bool {
  match step_on(configurations: rows2(a: row(name: census_left as String, status: "19"), b: row(name: "someone-elses-installer.iso", status: "1")), firmware: the_build_the_read_names, stems: both_stems) {
    ConvergeStepRefuse { outcome: MegaRacForeignImagePresented { image_name: n, configurations: _ } } => n == "someone-elses-installer.iso"
    _ => false
  }
}

test fn two_of_our_sessions_at_once_refuse() -> Bool {
  match step_on(configurations: rows2(a: row(name: census_left as String, status: "19"), b: row(name: "gunbc-runner-host-ubuntu-24.04.3-arm64-0123456789abcdef.iso", status: "1")), firmware: the_build_the_read_names, stems: both_stems) {
    ConvergeStepRefuse { outcome: MegaRacSeveralImagesPresented { configurations: _ } } => true
    _ => false
  }
}

// AN UNCATALOGUED RELEASE: no row of it was ever read, so even our own census session is not stopped.
test fn on_an_uncatalogued_release_our_census_session_refuses_with_no_stop() -> Bool {
  refused_unread(
    s: step_on(configurations: rows1(a: row(name: census_left as String, status: "1")), firmware: firmware_0_99, stems: both_stems),
    name: census_left as String,
    want: RedirectionUnreadFirmware { firmware: firmware_0_99, wire: 1 },
    why: UnreadStopReleaseNotEvidenced { unread: RedirectionUnreadFirmware { firmware: firmware_0_99, wire: 1 } },
  ) && refused_unread(
    s: step_on(configurations: rows1(a: row(name: census_left as String, status: "19")), firmware: firmware_0_99, stems: both_stems),
    name: census_left as String,
    want: RedirectionUnreadFirmware { firmware: firmware_0_99, wire: 19 },
    why: UnreadStopReleaseNotEvidenced { unread: RedirectionUnreadFirmware { firmware: firmware_0_99, wire: 19 } },
  )
}

// BOOT RUN 40070230626, AS READ. The controller is admitted as 0.32 (the declared drop
// gunbc.rung_drop.megarac_operations_admitted_through_a_superseded_build_observation), our census session
// reports 19, and both stems are supplied. The refusal is the RELEASE arm -- not foreign, not unnamed,
// not the wanted image -- and its text says so rather than naming the image as foreign.
test fn the_boot_40070230626_census_session_refuses_on_the_release_not_as_foreign() -> Bool {
  let unread = RedirectionUnreadCode { firmware: megarac_firmware_0_32, wire: 19 }
  let why = UnreadStopReleaseNotEvidenced { unread: unread }
  let text = unread_row_stop_refusal_text(refusal: why)
  refused_unread(
    s: step_on(configurations: rows1(a: row(name: census_left as String, status: "19")), firmware: megarac_firmware_0_32, stems: both_stems),
    name: census_left as String,
    want: unread,
    why: why,
  ) && string_contains(s: text, pattern: "committed evidence grounds (0.45)")
    && string_contains(s: text, pattern: "on firmware 0.32")
    && string_contains(s: text, pattern: "foreign") == false
}

// The refusal text names the arm that fired and the release.
test fn on_an_uncatalogued_release_the_text_names_the_firmware_arm() -> Bool {
  string_contains(s: redirection_unread_text(unread: RedirectionUnreadFirmware { firmware: firmware_0_99, wire: 19 }), pattern: "on firmware 0.99, a release whose status codes are not catalogued")
    && string_contains(s: redirection_unread_text(unread: RedirectionUnreadCode { firmware: the_build_the_read_names, wire: 19 }), pattern: "redirection_status 19 on firmware 0.45, a code")
}

// THE STOP'S READ-BACK ON 0.45.3. No committed reading shows what a stopped row reads on this release,
// so a cleared-looking row (image_name "", status 0, which IS stopped on 0.32) does not establish the
// stop here; the reason records the wire so this attempt's receipt grounds it.
test fn at_the_read_build_a_cleared_looking_readback_does_not_establish_the_stop_and_records_the_wire() -> Bool {
  match detach_verdict(evidence: stop_evidence(readback: rows1(a: row(name: "", status: "0"))), image_name: runner_desired, firmware: the_build_the_read_names, replaceable_seeded_stems: both_stems) {
    DetachNotEstablished { reason: why } => string_contains(s: why as String, pattern: "redirection_status 0 on firmware 0.45")
    _ => false
  }
}

// The positive control beside it: the same read-back on 0.32 IS an established stop.
test fn on_0_32_the_same_cleared_readback_establishes_the_stop() -> Bool {
  match detach_verdict(evidence: stop_evidence(readback: rows1(a: row(name: "", status: "0"))), image_name: runner_desired, firmware: megarac_firmware_0_32, replaceable_seeded_stems: both_stems) {
    DetachEstablished => true
    _ => false
  }
}

test fn at_the_read_build_our_census_still_listed_after_the_stop_is_not_established() -> Bool {
  match detach_verdict(evidence: stop_evidence(readback: rows1(a: row(name: census_left as String, status: "19"))), image_name: runner_desired, firmware: the_build_the_read_names, replaceable_seeded_stems: both_stems) {
    DetachNotEstablished { reason: _ } => true
    _ => false
  }
}


// ═══════════════════════════════════════════════════════════════════════════════════════════════
// THE 0.45 CUTOVER WITNESSES (PR1 re-key, boot run 40082618814). The catalogue's 0.45.x row moved from
// the operator's page attestation to a firmware read of the retained pre-power hpm check, so the release
// identity is DERIVED from committed bytes ("0.45 03000000" mints the wire "0.45", the HPM.1 auxiliary
// revision bytes deliberately NOT folded into a patch) and the vendor page label "0.45.3" survives only
// as the label of the vendor page. These four pin that machinery at the byte level; the boot witness
// pins the boot-side consequences, and the operation-standing witness pins the receipt joins.
// ═══════════════════════════════════════════════════════════════════════════════════════════════

// The establishment half of the committed-read claim, bound so no pipeline sits in a match scrutinee
// (this file has mis-parsed that shape before): derived, not the page label, and derived rather than
// refused -- a garbled artifact or an upgrade listing refuses and fails here.
fn derived_is_not_the_page_label(e: MegaRacReleaseCapabilityEntry) -> Bool {
  match megarac_version_establishment(standing: e.standing) {
    MegaRacReleaseEstablishedByRead { firmware: firmware } =>
      !bmc_firmware_release_identity_eq(a: firmware, b: megarac_firmware_0_45_3)
      && (firmware.raw_version as String) == "0.45"
      && match firmware.semantic_version { Absent => true  Present { value: _ } => false }
    MegaRacReleaseEstablishedByAttestation { firmware: _ } => false
    MegaRacReleaseEstablishmentRefused { standing: _, cause: _ } => false
  }
}

// IS THIS IDENTITY THE COMMITTED MACHINE READ? The current build is BmcFirmwareReleaseIdentity? (it
// exists only because the committed hpm check established it), so comparisons against it go through HERE:
// the Absent arm answers FALSE, and every claim in this file that leans on the reading goes red together
// if the read ever stops establishing -- none passes vacuously against a missing build.
fn eq_the_committed_build(f: BmcFirmwareReleaseIdentity) -> Bool {
  match mtcollins1_current_build_firmware {
    Present { value: current } => bmc_firmware_release_identity_eq(a: f, b: current)
    Absent => false
  }
}


// THE 0.45 ROW IS ESTABLISHED BY A MACHINE READ OF THE COMMITTED STDOUT (prod cite:
// gunbc/host/bmc_release_capability_catalog.dag). Three discriminations, each failing independently:
// RED-1 the standing left the read arm (an attestation moved back, a third row, a row retyped) -- the
//   filter finds no entry whose establishment derives the machine-read build;
// RED-2 the auxiliary bytes folded into the release (an Active cell rendered "0.45.3 03000000" instead of
//   the controller's verbatim "0.45 03000000"): the establishment would then derive the PAGE LABEL -- an
//   identity nothing has ever read -- and the !eq arm below goes red. gunbc.design_argument::epistemic_humility: no equality by resemblance;
// RED-3 the table refused to parse (a garbled artifact, an upgrade listing): the ByRead arm below fails
//   on a Refused establishment, so a row whose bytes cannot be read cannot claim a release either.
// The identity is checked against the ONE mint (bmc_firmware_release_identity_of_wire of the derived
// wire), never against a typed literal here.
test fn w_the_0_45_row_is_established_by_a_machine_read_of_the_committed_stdout() -> Bool {
  let rows = filter(megarac_release_capability_catalog, e => match e.standing {
    MegaRacVersionFromFirmwareRead { artifact_path: _, component: _, stdout: _ } =>
      match megarac_version_establishment(standing: e.standing) {
        MegaRacReleaseEstablishedByRead { firmware: firmware } =>
          eq_the_committed_build(f: firmware)
        _ => false
      }
    MegaRacVersionFromOperatorAttestation { attested_on: _, page_reported: _, detail: _, upgrade_read: _ } => false
  })
  let one_row = rows |> first()
  count(rows) == 1 && (match one_row {
    Absent => false
    Present { value: e } => match e.standing {
      MegaRacVersionFromFirmwareRead { artifact_path: path, component: component, stdout: stdout } =>
        // THE PATH IS THE ONE DATA THE WHOLE REPOSITORY SHARES: the ledger's committed evidence row, the
        // catalogue row's own artifact_path, and this claim all name
        // extdeps.bmc.ipmitool_observed_output mtcollins1_boot_run_40082618814_hpm_check_artifact_path
        // (review 86103 finding 2 -- the same path was typed at three sites).
        (path as String) == (mtcollins1_boot_run_40082618814_hpm_check_artifact_path as String)
        && (component as String) == "APP"
        // THE AUXILIARY BYTES ARE HELD VERBATIM AND UNFOLDED: the auxiliary revision column's bytes are
        // present in the table, separated from the release by a space -- which is exactly what makes the
        // derived wire "0.45" and not the page label. A fold that pasted them onto the release ("0.45.3")
        // would keep this arm green while RED-2 below turns red; both are needed.
        && string_contains(s: stdout as String, pattern: "0.45 03000000")
        && string_contains(s: stdout as String, pattern: "0.45.3") == false
        && derived_is_not_the_page_label(e: e)
      MegaRacVersionFromOperatorAttestation { attested_on: _, page_reported: _, detail: _, upgrade_read: _ } => false
    }
  })
}

// THE 0.45 ROW NAMES NO RELEASE IT DID NOT READ (prod cite:
// gunbc/host/bmc_release_capability_catalog.dag). The re-key moved the STANDING; the EVIDENCE arm is the
// same executed run it always was -- run 38789347052 exercising exactly three capabilities, claiming no
// release, minting no attempt identity. And NO STANDING ANYWHERE IN THE CATALOG claims a release through
// an attestation any more: the page label cannot be a row key, so the catalog as a whole claims only the
// two releases instrument output has actually reported. RED: a row moved to the committed-readback arm to
// dodge the run's own element list, a run that suddenly claims a release, or any attestation-arm standing
// restored (the page label keying a row again) fails here -- independently of the sibling witness above,
// which pins the bytes.
test fn w_the_0_45_row_names_no_release_it_did_not_read() -> Bool {
  // NO ROW IS ESTABLISHED BY ATTESTATION ANY MORE -- the strongest form of "the page label is not a key":
  // every standing that establishes, establishes through a read.
  let nothing_attested = all(megarac_release_capability_catalog, e => match megarac_version_establishment(standing: e.standing) {
    MegaRacReleaseEstablishedByAttestation { firmware: _ } => false
    _ => true
  })
  && count(megarac_release_capability_catalog) == 2
  let rows = filter(megarac_release_capability_catalog, e => match e.standing {
    MegaRacVersionFromFirmwareRead { artifact_path: _, component: _, stdout: _ } =>
      match megarac_version_establishment(standing: e.standing) {
        MegaRacReleaseEstablishedByRead { firmware: firmware } =>
          eq_the_committed_build(f: firmware)
        _ => false
      }
    MegaRacVersionFromOperatorAttestation { attested_on: _, page_reported: _, detail: _, upgrade_read: _ } => false
  })
  match rows |> first() {
    Absent => false
    Present { value: e } => match e.evidence {
      MegaRacCapabilitiesFromExecutedRun { run: run } => {
        // THE RUN CLAIMS NO RELEASE: no attempt identity, and its derived capability list is the run's own
        // exercised element by element -- the same three controls, no more, no fewer.
        let no_attempt = match megarac_run_attempt_identity(run: run) {
          Absent => true
          Present { value: _ } => false
        }
        let derived = filter(megarac_release_capabilities_of(evidence: e.evidence), c => any(run.exercised, x => x == c))
        count(derived) == count(run.exercised) && count(run.exercised) == 3 && no_attempt
      }
      MegaRacCapabilitiesFromCommittedReadback { capabilities: _, artifact_paths: _, observed_on: _ } => false
    }
  } && nothing_attested
}

// THE CURRENT BUILD IDENTITY IS THE ONE THE COMMITTED READING MINTS -- via the ROW, and only the row
// (review 38602 rework, review 86103/86139 rework). The identity is no longer a typed wire this test can
// compare a literal against: gunbc.machine_intake.mtcollins1_access_observation ASKS the catalogue for it
// (megarac_committed_hpm_check_readout) and receives either an identity or a TYPED REFUSAL -- never a
// stand-in (review 86103 finding 1: the previous shape fabricated a "no version stored" identity for every
// failure, gunbc.design_argument::fail_closed "no plausible output is fabricated"). Four discriminations, each failing
// independently:
// 1. THE DERIVED IDENTITY IS WHAT THE ROW'S OWN BYTES SAY -- re-deriving the row's identity through the
//    establishment here and comparing to the consumed value means a consumer that STARTED typing its own
//    identity (or a row whose bytes changed under it) is caught from the outside;
// 2. THE PATH IS THE ROW'S PATH: asking under the single-home artifact path data returns EXACTLY the
//    established identity -- retarget the row's artifact_path away from the committed bytes and the lookup
//    answers CommittedReadRefused { NoCommittedRowAtPath }, this arm demands Established, and it goes red;
// 3. A PATH NO ROW CARRIVES REFUSES, BY TYPE -- CommittedReadRefused { NoCommittedRowAtPath }, which is
//    not an identity at all. A lookup rebuilt to hand back the last good release (so a lost artifact
//    silently keeps booting) has no arm to do it with, and if someone re-added one this match demands the
//    refusal and dies;
// 4. THE LEDGER CANNOT CLAIM A READING THE READ DID NOT ESTABLISH: exactly one reading on the committed
//    ledger carries this build's identity, and the digest it vouches for is the digest DERIVED from the
//    committed bytes -- the file on disk whose sha256 the committed artifact reports. A forged artifact
//    (bytes changed) or a forged literal (literal changed against the file) separates the two and this
//    arm goes red.
test fn w_the_current_build_identity_is_the_one_the_committed_reading_mints() -> Bool {
  let committed_rows = filter(megarac_release_capability_catalog, e => match e.standing {
    MegaRacVersionFromFirmwareRead { artifact_path: path, component: _, stdout: bytes } =>
      (path as String) == "artifacts/bmc/mtcollins1-boot-run-40082618814/mtcollins1-boot-hpm-check-40082618814.txt"
      && (bytes as String) == (ipmitool_hpm_check_bmc0_45 as String)
    MegaRacVersionFromOperatorAttestation { attested_on: _, page_reported: _, detail: _, upgrade_read: _ } => false
  })
  let committed_head = committed_rows |> first()
  let derived_by_the_row = match committed_head {
    Present { value: e } => match megarac_version_establishment(standing: e.standing) {
      MegaRacReleaseEstablishedByRead { firmware: established } => Present { value: established }
      _ => Absent
    }
    Absent => Absent
  }
  // 1+2. THE CONSUMED IDENTITY EQUALS THE ROW-DERIVED ONE, and equals what the lookup ESTABLISHES under
  // the single-home committed path -- the ask must come back Established, and with the row's own identity.
  let ask_under_the_committed_path = megarac_committed_hpm_check_readout(
    artifact_path: mtcollins1_boot_run_40082618814_hpm_check_artifact_path,
  )
  let consumed_is_derived = match derived_by_the_row {
    Present { value: established } => match ask_under_the_committed_path {
      CommittedReadEstablished { firmware: readout } =>
        eq_the_committed_build(f: established)
        && bmc_firmware_release_identity_eq(a: readout, b: established)
        && (match mtcollins1_current_build_identity {
          Present { value: consumed } => bmc_firmware_release_identity_eq(a: consumed.firmware, b: established)
          Absent => false
        })
      // 2'. THE ASK UNDER THE REAL PATH MUST ESTABLISH -- a refusal here is the boot refusing, and this
      // claim going red is the whole point: no silent anything.
      CommittedReadRefused { cause: _ } => false
    }
    Absent => false
  }
  // 3. A PATH NO ROW CARRIVES ANSWERS A TYPED REFUSAL, NOT AN IDENTITY. There is no value to compare
  // against any more -- which is the fix: the previous shape had a sentinel identity a careless consumer
  // could boot on. The match demands the arm, so any re-fabrication (a third arm, an identity for the
  // miss) makes this witness uncompilable or red.
  let ask_under_a_path_no_row_carries = megarac_committed_hpm_check_readout(
    artifact_path: "artifacts/bmc/no-such-run/hpm-check.txt",
  )
  let an_absent_path_refuses_by_type = match ask_under_a_path_no_row_carries {
    CommittedReadRefused { cause: NoCommittedRowAtPath { artifact_path: missing } } =>
      (missing as String) == "artifacts/bmc/no-such-run/hpm-check.txt"
    _ => false
  }
  // 4. THE LEDGER CANNOT CLAIM A READING THE READ DID NOT ESTABLISH. Exactly one committed reading
  // carries this build's identity, its digest is the single-home digest DERIVED from the committed bytes,
  // and that digest is the file's own observed sha256 -- the pin that binds literal, ledger row, and
  // artifact on disk together (review 86103 finding 2: the same path/hex lived at three sites; now the
  // witness is the only place a hex is written, and it is a CROSS-CHECK, not a home).
  let ledger_rows_under_the_build = match mtcollins1_current_build_identity {
    Absent => false
    Present { value: consumed } => match count(filter(mtcollins1_megarac_operation_evidence().readings, r =>
      bmc_firmware_release_identity_eq(a: r.identity.firmware, b: consumed.firmware))) {
      1 => true
      _ => false
    }
  }
  let digest_is_the_files_own_sha256 = content_hash_eq_cryptographic(
    left: mtcollins1_boot_run_40082618814_hpm_check_digest,
    right: Sha256Digest { hex: "31d953d5e2ffc0ee084d7c7087d40be88a29ddf94cdc0b30d2b368610fca273d" },
  )
  // AND THE FRU SIDE OF THE IDENTITY IS READ, NOT COPIED: the board and chassis of the current-build
  // identity are mtcollins1_identity's own fields (review 38602 finding 2) -- a build change moves the
  // firmware and nothing else, and there is no second spelling to drift.
  // Field-by-field, never == on whole structures: optional_equality_answers_by_representation
  // (gunbc.recurring_failure_mode) records == answering false on optionals that mean the same thing.
  let fru_side_is_shared = match mtcollins1_current_build_identity {
    Absent => false
    Present { value: consumed } =>
      board_fru_fields_eq(a: consumed.board, b: mtcollins1_identity.board)
      && both_or_neither(a: consumed.chassis_part_number, b: mtcollins1_identity.chassis_part_number)
  }
  consumed_is_derived && an_absent_path_refuses_by_type && ledger_rows_under_the_build
    && digest_is_the_files_own_sha256 && fru_side_is_shared
}

// Both boards READ, to the same fields (review 38602 finding 2: the current-build identity's board is
// mtcollins1_identity's board, taken not copied). Both-unread is NOT allowed to pass: the intake capture
// is what the boot's identity owes, and a build identity that dropped the board would be an unbound boot.
fn board_fru_fields_eq(a: BoardFruObservation, b: BoardFruObservation) -> Bool {
  match a {
    BoardFruRead { fru: x } => match b {
      BoardFruRead { fru: y } =>
        x.manufacturer == y.manufacturer
        && x.product == y.product
        && both_or_neither(a: x.part_number, b: y.part_number)
      BoardFruNotRead { cause: _ } => false
    }
    BoardFruNotRead { cause: _ } => false
  }
}

// Two optionals read the SAFE way (see the recurrence above): both absent, or both present with equal
// content -- decided by matching, never by == on the variants.
fn both_or_neither(a: NonEmptyStr?, b: NonEmptyStr?) -> Bool {
  match a {
    Present { value: x } => match b {
      Present { value: y } => x == y
      Absent => false
    }
    Absent => match b {
      Absent => true
      Present { value: _ } => false
    }
  }
}

// THE STATUS-19 CENSUS ROW REFUSES AT THE MACHINE-READ IDENTITY (spec PR1 item (c)). Boot run 40082618814
// read redirection_status 19 on its census row while the controller was on the machine-read build, and the
// redirection catalogue is keyed by the VENDOR PAGE identity "0.45.3" -- so at the machine-read identity
// (raw "0.45") release 19 is FIRMWARE-UNCATALOGUED and the convergence refuses as an unread release, not
// as foreign and not by walking the row. This is the harness-visible half of "the next boot STILL refuses
// at attach until the cutover": the machine-read identity earns no redirection knowledge it has not read.
// RED: a redirection catalogue that NAMED 19 at the machine-read identity (hand-written to make this boot
// pass) turns the refusal into a walk-through and this witness goes red; so does a catalogue that started
// treating the machine-read identity as the page label (the gunbc.design_argument::epistemic_humility confusion, from the other side).
// THE SAME FIXTURE AFTER THE TABLE MOVED, AND WHAT THAT CHANGED. Before the move this identity had no
// catalogue at all: every wire came back RedirectionUnreadFirmware and the stop exception's arm for that
// is a flat false, so this refused. Now the identity the committed hpm read derives IS the evidenced
// release, so the row reads as an unread CODE on an evidenced release, the census image is this lane's
// residue named by a seeded stem, and it is NOT the image the attempt wants -- so the step stops it. The
// wanted image stays protected by a different arm, pinned by
// w_the_leftover_ejected_row_is_not_presenting_at_the_build_this_repository_read and by the runner-stem claims
// above; which images may be stopped at all is unchanged (a foreign name still refuses,
// UnreadStopImageForeign). The claim goes red, with every other claim that leans on the reading, if the
// committed read ever stops establishing an identity to ask about.
test fn the_status_19_census_row_is_stopped_at_the_machine_read_identity_once_the_table_reaches_it() -> Bool {
  match mtcollins1_current_build_firmware {
    Absent => false
    Present { value: machine_read } =>
      match step_on(configurations: rows1(a: row(name: census_left as String, status: "19")), firmware: machine_read, stems: both_stems) {
        ConvergeStepDetachStale { row: r } => r.image_name == (census_left as String) && r.redirection_wire == 19
        _ => false
      }
  }
}

// A ROW, NOT A CODE: a fixture whose SESSION INDEX is under test, so the same status can be placed beside
// the no-session marker and beside a live one.
fn row_at_session(name: String, status: String, session: String) -> String {
  concat("{\"id\":1,\"media_type\":1,\"media_index\":0,\"session_index\":", concat(session, concat(",\"image_name\":\"", concat(name, concat("\",\"redirection_status\":", concat(status, "}"))))))
}

// THE TRIPLE AS IT WAS READ, AND NOTHING BEYOND IT. Code 16 beside the no-session marker answers STOPPED
// on the release the vendor module DECLARES and on the identity the committed hpm read DERIVES -- the same
// answer either way, because the media table reaches this build by identity equality (see
// the_redirection_table_reaches_the_build_the_machine_read_names). The marker is pinned to what the reads
// carried, and separated from what a LIVE session carried on that same run, so the marker cannot quietly
// become "any index". And the vendor's own words are consulted as an attestation that labels a stopped,
// ejected row -- never as the source of the code.
test fn w_the_ejected_row_triple_is_stopped_on_the_release_the_controller_reports() -> Bool {
  match mtcollins1_current_build_firmware {
    Absent => false
    Present { value: read } =>
      match megarac_redirection_status_of_row(firmware: read, wire: 16, session_index: Present { value: megarac_no_redirection_session_index }) {
        RedirectionStatusKnown { firmware: f, status: RedirectionStopped } => bmc_firmware_release_identity_eq(a: f, b: read)
        _ => false
      }
      && match megarac_redirection_status_of_row(firmware: megarac_firmware_0_45_reported, wire: 16, session_index: Present { value: megarac_no_redirection_session_index }) {
        RedirectionStatusKnown { firmware: f, status: RedirectionStopped } => bmc_firmware_release_identity_eq(a: f, b: megarac_firmware_0_45_reported)
        _ => false
      }
      && megarac_no_redirection_session_index == boot_run_40258937016_end_media_row.session_index
      && boot_run_40258937016_started_session_marker.session_index != megarac_no_redirection_session_index
      && boot_run_40258937016_end_media_row.redirection_status == 16
      && reads_agree_on_the_ejected_row(a: boot_run_40258937016_end_media_row, b: boot_run_40264233543_end_media_row)
      && attestation_labels_a_stopped_and_ejected_row(attestation: mtcollins1_cd_row_ui_attestation)
      && attestation_and_read_name_the_same_row(attestation: mtcollins1_cd_row_ui_attestation, read: boot_run_40264233543_end_media_row)
  }
}

// RED: CODE 16 BESIDE AN ACTIVE SESSION WAS NEVER READ AND STAYS UNREAD. The only session this repository
// read as live at this build carried index 0 (boot_run_40258937016_started_session_marker), so a row at 16
// with a live index is a DIFFERENT observation and must not be folded into the stopped state: not as a bare
// wire, not as a row whose index was never read, and not through the route. If the grounding were written
// as "16 means stopped", all three arms below would pass by construction -- and the boot would attach over
// a session that is live, which is exactly what the unread-code stop exists to prevent.
test fn w_code_16_beside_an_active_session_is_still_an_unread_code() -> Bool {
  match mtcollins1_current_build_firmware {
    Absent => false
    Present { value: read } =>
      match megarac_redirection_status_of_row(firmware: read, wire: 16, session_index: Present { value: boot_run_40258937016_started_session_marker.session_index }) {
        RedirectionStatusKnown { firmware: f, status: RedirectionWireUncatalogued { wire: w } } => w == 16 && bmc_firmware_release_identity_eq(a: f, b: read)
        _ => false
      }
      && match megarac_redirection_status_of_row(firmware: read, wire: 16, session_index: none) {
        RedirectionStatusKnown { firmware: _, status: RedirectionWireUncatalogued { wire: w } } => w == 16
        _ => false
      }
      && match step_for(configurations: rows1(row_at_session(name: boot6_leftover_iso as String, status: "16", session: "0")), firmware: read, stems: both_stems, image_name: boot6_leftover_iso) {
        ConvergeStepRefuse { outcome: MegaRacRedirectionUncatalogued { image_name: n, unread: u, refusal: r, configurations: _ } } =>
          n == (boot6_leftover_iso as String)
            && u == RedirectionUnreadCode { firmware: read, wire: 16 }
            && r == UnreadStopRowIsTheWantedImage
        _ => false
      }
  }
}

// 16 IS NOT CARRIED TO A RELEASE THAT NEVER REPORTED IT. The 2026-09-05 probe read 0, 1 and 100 on 0.32 and
// never 16; the page label "0.45.3" is not a key of the table at all; and a release the corpus does not
// know answers by release, not by code. Same triple, other releases, no knowledge -- so the grounding
// cannot drift into a default.
test fn w_code_16_is_not_catalogued_on_the_releases_that_never_reported_it() -> Bool {
  match megarac_redirection_status_of_row(firmware: megarac_firmware_0_32, wire: 16, session_index: Present { value: megarac_no_redirection_session_index }) {
    RedirectionStatusKnown { firmware: f, status: RedirectionWireUncatalogued { wire: w } } => w == 16 && bmc_firmware_release_identity_eq(a: f, b: megarac_firmware_0_32)
    _ => false
  } && match megarac_redirection_status_of_row(firmware: megarac_firmware_0_45_3, wire: 16, session_index: Present { value: megarac_no_redirection_session_index }) {
    RedirectionStatusFirmwareUncatalogued { firmware: f, wire: w } => w == 16 && bmc_firmware_release_identity_eq(a: f, b: megarac_firmware_0_45_3)
    _ => false
  } && match megarac_redirection_status_of_row(firmware: firmware_0_99, wire: 16, session_index: Present { value: megarac_no_redirection_session_index }) {
    RedirectionStatusFirmwareUncatalogued { firmware: f, wire: w } => w == 16 && bmc_firmware_release_identity_eq(a: f, b: firmware_0_99)
    _ => false
  }
}

// THE TWO RELEASES REPORT DIFFERENT WIRES FOR A ROW THAT IS NOT PRESENTING, AND NEITHER MEANING TRAVELS.
// The reads are the source, not a typed status: at the release the committed hpm check names, 16 beside the
// marker is Stopped; the same row shape at 0.32 -- which never reported 16 -- is an unread code; the wire the
// 2026-09-05 probe saw for a non-presenting drive (0) is Stopped at 0.32 and, beside the marker at this build,
// NOT ACTIVE -- the vendor's own rendering of that pair (w_the_status_zero_no_session_row_is_not_active_and_not_stopped),
// which is a different state from the Stopped 0.32 names, not the same meaning carried across. So
// no status here is a default, and a world that pairs one release's wire with a route asking at the other
// gets a refusal rather than a silent substitution -- which is exactly how a fixture error shows up. The last
// group ties the two row receipts to the same machine's boot lane as the committed hpm read that names the
// release, so the pairing above cannot be an accident of two different machines.
test fn w_the_two_releases_report_different_wires_for_a_row_that_is_not_presenting() -> Bool {
  match mtcollins1_current_build_firmware {
    Absent => false
    Present { value: read } =>
      match megarac_redirection_status_of_row(
        firmware: read,
        wire: boot_run_40264233543_end_media_row.redirection_status,
        session_index: Present { value: boot_run_40264233543_end_media_row.session_index },
      ) {
        RedirectionStatusKnown { firmware: f, status: RedirectionStopped } => bmc_firmware_release_identity_eq(a: f, b: read)
        _ => false
      }
      && match megarac_redirection_status_of_row(
        firmware: mtcollins1_identity.firmware,
        wire: boot_run_40264233543_end_media_row.redirection_status,
        session_index: Present { value: boot_run_40264233543_end_media_row.session_index },
      ) {
        RedirectionStatusKnown { firmware: f, status: RedirectionWireUncatalogued { wire: w } } => w == 16 && bmc_firmware_release_identity_eq(a: f, b: mtcollins1_identity.firmware)
        _ => false
      }
      && match megarac_redirection_status_of_wire(firmware: mtcollins1_identity.firmware, wire: 0) {
        RedirectionStatusKnown { firmware: f, status: RedirectionStopped } => bmc_firmware_release_identity_eq(a: f, b: mtcollins1_identity.firmware)
        _ => false
      }
      && match megarac_redirection_status_of_row(firmware: read, wire: 0, session_index: Present { value: megarac_no_redirection_session_index }) {
        RedirectionStatusKnown { firmware: f, status: RedirectionNotActive } => bmc_firmware_release_identity_eq(a: f, b: read)
        _ => false
      }
      && boot_run_40258937016_end_media_row.redirection_status == boot_run_40264233543_end_media_row.redirection_status
      && boot_run_40258937016_end_media_row.session_index == boot_run_40264233543_end_media_row.session_index
      && string_contains(s: boot_run_40264233543_end_media_row.artifact_path as String, pattern: "artifacts/bmc/mtcollins1-boot-run-")
      && string_contains(s: mtcollins1_boot_run_40082618814_hpm_check_artifact_path as String, pattern: "artifacts/bmc/mtcollins1-boot-run-")
  }
}

// THE ROW THAT STOPPED THE SEVENTH AND NINTH BOOT ATTEMPTS IS NOT ACTIVE -- AND NOT STOPPED. Boot runs
// 41573858366 and 42663208460 each read the CD row at status 0 beside the no-session marker, naming no medium.
// The vendor's own words for that pair are two readings: the served renderer draws status 0 with its
// status-0 string ("~") and never with its "Stopped" string, and draws session 255 as "N/A" by
// `255==s?"N/A":s`; and the operator's 2026-11-09 reading of the page shows the CD/DVD instance 0 row as
// "~" / "N/A". The claim: both machine reads are the triple the fold's arm is keyed on, both readings of the
// vendor's words describe that pair (and the 16 attestation does not), and the fold answers
// RedirectionNotActive -- with a presentation standing distinct from KnownStopped, so no consumer can read
// "no session" as "stopped".
test fn w_the_status_zero_no_session_row_is_not_active_and_not_stopped() -> Bool {
  match mtcollins1_current_build_firmware {
    Absent => false
    Present { value: read } =>
      match megarac_redirection_status_of_row(
        firmware: read,
        wire: boot_run_42663208460_end_media_row.redirection_status,
        session_index: Present { value: boot_run_42663208460_end_media_row.session_index },
      ) {
        RedirectionStatusKnown { firmware: f, status: RedirectionNotActive } => bmc_firmware_release_identity_eq(a: f, b: read)
        _ => false
      }
      && megarac_redirection_status_of_row(firmware: read, wire: 0, session_index: Present { value: megarac_no_redirection_session_index }) != RedirectionStatusKnown { firmware: read, status: RedirectionStopped }
      && megarac_redirection_presentation_standing(lookup: megarac_redirection_status_of_row(firmware: read, wire: 0, session_index: Present { value: megarac_no_redirection_session_index })) == RedirectionKnownNotActive
      && megarac_redirection_presentation_standing(lookup: megarac_redirection_status_of_row(firmware: read, wire: 0, session_index: Present { value: megarac_no_redirection_session_index })) != RedirectionKnownStopped
      // THE TWO MACHINE READS ARE THE SAME TRIPLE, ON TWO ATTEMPTS.
      && boot_run_42663208460_end_media_row.redirection_status == 0
      && boot_run_42663208460_end_media_row.session_index == megarac_no_redirection_session_index
      && boot_run_42663208460_end_media_row.media_type == 1
      && boot_run_42663208460_end_media_row.media_index == 0
      && reads_agree_on_the_ejected_row(a: boot_run_41573858366_end_media_row, b: boot_run_42663208460_end_media_row)
      && string_contains(s: boot_run_42663208460_end_media_row.artifact_path as String, pattern: "artifacts/bmc/mtcollins1-boot-run-42663208460/")
      // THE RENDERER'S RULES: N/A is the marker, the status-0 string is not the stopped string.
      && mtcollins1_ui_media_row_rendering.session_wire_rendered_absent == megarac_no_redirection_session_index
      && string_contains(s: mtcollins1_ui_media_row_rendering.session_rule as String, pattern: "255==s?\"N/A\":s")
      && string_contains(s: mtcollins1_ui_media_row_rendering.status_zero_rule as String, pattern: "lmedia:status_")
      && !string_contains(s: mtcollins1_ui_media_row_rendering.status_zero_rule as String, pattern: "lmedia:halted")
      && (mtcollins1_ui_media_row_rendering.status_zero_label as String) != (mtcollins1_ui_media_row_rendering.halted_label as String)
      // THE OPERATOR'S PAGE READING DRAWS THAT PAIR; THE 16 READING DOES NOT.
      && attestation_draws_status_zero_without_a_session(attestation: mtcollins1_cd_row_status_zero_ui_attestation, rendering: mtcollins1_ui_media_row_rendering)
      && !attestation_draws_status_zero_without_a_session(attestation: mtcollins1_cd_row_ui_attestation, rendering: mtcollins1_ui_media_row_rendering)
      && !attestation_labels_a_stopped_and_ejected_row(attestation: mtcollins1_cd_row_status_zero_ui_attestation)
  }
}

// THE PAGE AND THE WIRE DISAGREE ON THE IMAGE NAME, AND THE DISAGREEMENT IS CARRIED, NOT EXPLAINED. Joined by
// position (CD/DVD, instance 0), the operator's page reading and boot run 42663208460's machine read are the
// same row; the page shows the census image name where the machine read none. The join must answer the
// disagreement arm with both names as read and the typed bet beside it -- never Agree, never "not the same
// row" (which would drop the observation by declaring it about something else). RED controls: the 16 reading
// names the runner medium and the boot 6/7-era receipt naming that medium agrees with it, so the join CAN
// answer Agree; and a read at another instance is not the same row.
test fn w_the_page_and_the_wire_disagree_on_the_name_and_it_is_kept() -> Bool {
  match ui_attestation_and_read_join(attestation: mtcollins1_cd_row_status_zero_ui_attestation, read: boot_run_42663208460_end_media_row, rendering: mtcollins1_ui_media_row_rendering) {
    UiAndReadSameRowByPosition { image_names: ImageNamesDisagreeUnexplained { ui_name: ui, read_name: rn, bet: UiNameMayComeFromOutsideTheRow { renderer_fragment: frag, fragment_octet: at, unread: _ } } } =>
      (ui as String) == (mtcollins1_cd_row_status_zero_ui_attestation.image_name as String)
        && match rn { Absent => true  Present { value: _ } => false }
        && string_contains(s: frag as String, pattern: ".image_name")
        && at == mtcollins1_ui_media_row_rendering.image_name_rule_octet
    _ => false
  }
  && match ui_attestation_and_read_join(attestation: mtcollins1_cd_row_ui_attestation, read: boot_run_40264233543_end_media_row, rendering: mtcollins1_ui_media_row_rendering) {
    UiAndReadSameRowByPosition { image_names: ImageNamesAgree } => true
    _ => false
  }
  && match ui_attestation_and_read_join(
    attestation: mtcollins1_cd_row_status_zero_ui_attestation,
    read: MegaRacMediaRowReceipt {
      run_id: boot_run_42663208460_end_media_row.run_id,
      observed_at: boot_run_42663208460_end_media_row.observed_at,
      artifact_path: boot_run_42663208460_end_media_row.artifact_path,
      artifact_sha256: boot_run_42663208460_end_media_row.artifact_sha256,
      artifact_lines: boot_run_42663208460_end_media_row.artifact_lines,
      media_type: 1,
      media_index: 1,
      session_index: 255,
      image_name: Absent,
      redirection_status: 0,
    },
    rendering: mtcollins1_ui_media_row_rendering,
  ) {
    UiAndReadNotTheSameRow => true
    _ => false
  }
}

// THE ATTACH LANE RUNS ON THE ROW AS THE CONTROLLER ANSWERED IT. The document below is boot run 42663208460's
// row member for member, as its diagnostics quote it at media attach (the receipt
// gunbc.machine_intake.megarac_media_row_reading boot_run_42663208460_end_media_row records the file, its
// sha256 and the lines) -- image_name the controller's empty answer, session_index 255, redirection_status 0
// -- run through the production gate. It must answer ConfigurationRowIdle: no session is live on it, so the
// lane may attach over it. And the same row with a LIVE session index (the only one ever read live at this
// build) must not: without the marker, 0 is an unread code and the lane refuses it.
test fn w_the_attach_lane_reads_the_not_active_row_as_idle_and_a_live_zero_as_unread() -> Bool {
  let row = json_object(members: [
    json_kv(key: "id", value: JsonNumber { lexeme: "1" }),
    json_kv(key: "media_type", value: JsonNumber { lexeme: "1" }),
    json_kv(key: "media_index", value: JsonNumber { lexeme: "0" }),
    json_kv(key: "session_index", value: JsonNumber { lexeme: "255" }),
    json_kv(key: "image_name", value: JsonString { value: "" }),
    json_kv(key: "redirection_status", value: JsonNumber { lexeme: "0" }),
  ])
  let live = json_object(members: [
    json_kv(key: "id", value: JsonNumber { lexeme: "1" }),
    json_kv(key: "media_type", value: JsonNumber { lexeme: "1" }),
    json_kv(key: "media_index", value: JsonNumber { lexeme: "0" }),
    json_kv(key: "session_index", value: JsonNumber { lexeme: "0" }),
    json_kv(key: "image_name", value: JsonString { value: "" }),
    json_kv(key: "redirection_status", value: JsonNumber { lexeme: "0" }),
  ])
  match mtcollins1_current_build_firmware {
    Absent => false
    Present { value: read } =>
      configuration_row_reading(row: row, image_name: boot6_leftover_iso, firmware: read) == ConfigurationRowIdle
      && match configuration_row_reading(row: live, image_name: boot6_leftover_iso, firmware: read) {
        ConfigurationRowUncatalogued { image_name: name, unread: RedirectionUnreadCode { firmware: f, wire: w } } =>
          name == "" && w == 0 && bmc_firmware_release_identity_eq(a: f, b: read)
        _ => false
      }
      && configuration_row_reading(row: live, image_name: boot6_leftover_iso, firmware: read) != ConfigurationRowIdle
  }
}

// RED: NOT ACTIVE IS DRAWN ONLY BESIDE THE MARKER. 0 beside the ONLY session index this repository has ever
// read as live at this build, and 0 on a row whose reading carried no session index at all, each stay an
// uncatalogued wire: the session rule is what makes "no session" a reading, so without the marker there is
// none. Were the arm written as "0 means not active", both would be told a meaning the vendor never gave.
test fn w_code_0_is_not_active_only_beside_the_no_session_marker() -> Bool {
  match mtcollins1_current_build_firmware {
    Absent => false
    Present { value: read } =>
      match megarac_redirection_status_of_row(
        firmware: read,
        wire: 0,
        session_index: Present { value: boot_run_40258937016_started_session_marker.session_index },
      ) {
        RedirectionStatusKnown { firmware: f, status: RedirectionWireUncatalogued { wire: w } } =>
          w == 0 && bmc_firmware_release_identity_eq(a: f, b: read)
        _ => false
      }
      && match megarac_redirection_status_of_row(
        firmware: read,
        wire: 0,
        session_index: none,
      ) {
        RedirectionStatusKnown { firmware: f, status: RedirectionWireUncatalogued { wire: w } } =>
          w == 0 && bmc_firmware_release_identity_eq(a: f, b: read)
        _ => false
      }
      // AND THE BARE WIRE STAYS UNCATALOGUED ON THIS RELEASE: the meaning is a row's, not a code's.
      && match megarac_redirection_status_of_wire(firmware: read, wire: 0) {
        RedirectionStatusKnown { firmware: f, status: RedirectionWireUncatalogued { wire: w } } =>
          w == 0 && bmc_firmware_release_identity_eq(a: f, b: read)
        _ => false
      }
      // AND THE MEDIUM SPELLING IS THE CONTROLLER'S EMPTY ANSWER, read the one way this repository reads it:
      // "" is no medium, and a row that answers a name is a different row.
      && match megarac_media_row_named_medium(name: "") {
        Absent => true
        Present { value: _ } => false
      }
      && match megarac_media_row_named_medium(name: boot6_leftover_iso as String) {
        Present { value: named } => (named as String) == (boot6_leftover_iso as String)
        Absent => false
      }
  }
}

// CODE 0 IS NOT CARRIED TO A RELEASE THAT NEVER READ IT, AND 0.32 KEEPS ITS OWN REASON. The page label
// "0.45.3" is not a key of the table at all and a release the corpus does not know answers by release, so
// both fall through to the wire table and answer UNCATALOGUED for this row shape. 0.32 answers Stopped at 0
// THROUGH ITS OWN TABLE, with no session index and no medium at all, so the not-active arm is not what
// answers 0.32 -- and 0.32's Stopped is not carried to 0.45 either. Three releases, three different reasons,
// and none of them a default.
test fn w_code_0_is_not_carried_to_the_releases_that_never_read_it() -> Bool {
  match megarac_redirection_status_of_row(
    firmware: megarac_firmware_0_45_3,
    wire: 0,
    session_index: Present { value: megarac_no_redirection_session_index },
  ) {
    RedirectionStatusFirmwareUncatalogued { firmware: f, wire: w } =>
      w == 0 && bmc_firmware_release_identity_eq(a: f, b: megarac_firmware_0_45_3)
    _ => false
  } && match megarac_redirection_status_of_row(
    firmware: firmware_0_99,
    wire: 0,
    session_index: Present { value: megarac_no_redirection_session_index },
  ) {
    RedirectionStatusFirmwareUncatalogued { firmware: f, wire: w } =>
      w == 0 && bmc_firmware_release_identity_eq(a: f, b: firmware_0_99)
    _ => false
  } && match megarac_redirection_status_of_row(
    firmware: megarac_firmware_0_32,
    wire: 0,
    session_index: none,
  ) {
    RedirectionStatusKnown { firmware: f, status: RedirectionStopped } =>
      bmc_firmware_release_identity_eq(a: f, b: megarac_firmware_0_32)
    _ => false
  }
}

// THE WORLD THE BOOT RUNS AGAINST PUTS THE SUPPLIED RELEASE'S WIRE IN ITS CD ROW, AND THE PAIRING IS NOT
// INTERCHANGEABLE. After the cutover the boot asks the media policy with the release the admit gate supplies
// from the reading of the current build, so the media world's cleared CD row has to carry THAT release's wire:
// status and marker taken from the row the boot read back at that build, not typed. Arms: the model's row
// equals what the attempt read (status, then marker, and the two attempts agree with each other); that row is
// STOPPED at the identity the gate supplies, which is what lets the executed boot frames reach the attach and
// the fan gate; and the same row shape at 0.32 -- the release the probe read 0 on -- is an unread code, so if
// the world's wire ever became release-independent, or was swapped back to the probe's wire, this claim goes
// red rather than the boot quietly refusing (or quietly passing on the wrong release).
test fn w_the_boot_fixture_renders_the_cleared_cd_on_the_wire_the_current_build_reports() -> Bool {
  match mtcollins1_current_build_firmware {
    Absent => false
    Present { value: read } =>
      megarac_cleared_cd_at_the_current_build().redirection_status == boot_run_40264233543_end_media_row.redirection_status
        && megarac_cleared_cd_at_the_current_build().session_index == boot_run_40264233543_end_media_row.session_index
        && boot_run_40258937016_end_media_row.redirection_status == boot_run_40264233543_end_media_row.redirection_status
        && match megarac_redirection_status_of_row(
          firmware: read,
          wire: megarac_cleared_cd_at_the_current_build().redirection_status,
          session_index: Present { value: megarac_cleared_cd_at_the_current_build().session_index },
        ) {
          RedirectionStatusKnown { firmware: f, status: RedirectionStopped } => bmc_firmware_release_identity_eq(a: f, b: read)
          _ => false
        }
        && match megarac_redirection_status_of_row(
          firmware: mtcollins1_identity.firmware,
          wire: megarac_cleared_cd_at_the_current_build().redirection_status,
          session_index: Present { value: megarac_cleared_cd_at_the_current_build().session_index },
        ) {
          RedirectionStatusKnown { firmware: f, status: RedirectionWireUncatalogued { wire: w } } => w == 16 && bmc_firmware_release_identity_eq(a: f, b: mtcollins1_identity.firmware)
          _ => false
        }
        && match megarac_redirection_status_of_wire(firmware: mtcollins1_identity.firmware, wire: 0) {
          RedirectionStatusKnown { firmware: f, status: RedirectionStopped } => bmc_firmware_release_identity_eq(a: f, b: mtcollins1_identity.firmware)
          _ => false
        }
  }
}

fn interlude_world() -> MegaRacMediaWorld {
  MegaRacMediaWorld {
    sessions: [],
    next_session: 0,
    share: MegaRacShare { server: "192.168.1.201", source_path: "/srv/bmc", share_type: "nfs" },
    mount_cd: 1,
    cd_error_code: 0,
    images: [MegaRacImage { image_name: boot6_leftover_iso as String, image_index: 5 }],
    cd: megarac_cleared_cd_at_the_current_build(),
    ready_after: second(count: 12),
    withdraw_at: none,
    withdraw_after_ready: none,
    error_after_ready: none,
    error_clears_on_stop: false,
    stop_at_ready: none,
  }
}

fn row_at(name: String, status: String, session: String) -> String {
  concat("{\"id\":1,\"media_type\":1,\"media_index\":0,\"session_index\":", concat(session, concat(",\"image_name\":\"", concat(name, concat("\",\"redirection_status\":", concat(status, "}"))))))
}

// THE INTERVAL BETWEEN A START AND THE STARTED READING IS NOT READ AT THIS BUILD, so the model carries it
// as a HYPOTHESIS WITH A TYPED STANDING (extdeps.external_authority CitedFigureStanding), and these claims
// keep the two things apart: what this build was READ answering, and what this repository INFERRED about
// the wait. The inference is what lets the boot's attach poll rather than refuse, so it is named in the same
// breath as the frames that depend on it -- never presented as a firmware fact.
test fn w_the_post_start_interval_is_a_hypothesis_with_a_read_obligation() -> Bool {
  match megarac_start_media_interval.standing {
    TranscribedUncited { read_obligation: o } =>
      string_contains(s: o as String, pattern: "StartMedia")
        && string_contains(s: o as String, pattern: "configurations")
        && string_contains(s: o as String, pattern: "not a 0.45 firmware observation")
    CitedToAuthority { authority: _ } => false
    ObservedByReceipt { observed: _ } => false
  }
}

// THE MODEL'S POST-START ROW IS THAT HYPOTHESIS, not a reading: the pair it leaves comes from the datum
// above (whose own pair is the closest thing this unit has been read answering while NOT presenting, on a
// leftover row read long after any start), the interval is still TIMED rather than assumed, and the value is
// neither 0.32's 100 nor 0. Conditional on w_the_post_start_interval_is_a_hypothesis_with_a_read_obligation:
// if the interval is ever read on a live boot, the datum moves to ObservedByReceipt in its own transition and
// this claim is re-written against that reading.
test fn w_the_start_leaves_the_row_at_the_hypothesized_interval_pair() -> Bool {
  let started = megarac_start_media(world: interlude_world(), image_name: boot6_leftover_iso as String, image_index: 5, now: second(count: 100))
  started.cd.image_name == (boot6_leftover_iso as String)
    && started.cd.redirection_status == megarac_start_media_interval.row.redirection_status
    && started.cd.session_index == megarac_start_media_interval.row.session_index
    && started.cd.session_index == megarac_no_redirection_session_index
    && started.cd.redirection_status != 100
    && started.cd.redirection_status != 0
    && match started.cd.ready_at {
        Present { value: at } => second_count(s: at) == 112
        Absent => false
      }
}

// THE HYPOTHESIS WAITS; IT DOES NOT SATISFY READINESS BY ITSELF. Folded at the release the gate supplies,
// a row naming the wanted image at the hypothesized pair is idle, so the first look after the start is NOT
// PRESENTED -- pending after this attempt's own start-media, not a refusal, and emphatically not Established:
// only the started pair this build WAS read as (boot run 40258937016: 1 beside session_index 0) satisfies
// readiness, and it arrives at ready_at. This is the arm the boot's attach depends on, and it depends on it
// conditionally on the claim above.
test fn w_the_hypothesized_interval_waits_and_never_satisfies_readiness_by_itself() -> Bool {
  match mtcollins1_current_build_firmware {
    Absent => false
    Present { value: read } =>
      match attach_readiness(answered: true, body: rows1(row_at(name: boot6_leftover_iso as String, status: "16", session: "255")), image_name: boot6_leftover_iso, firmware: read) {
        ReadinessNotPresented { configurations: _ } => true
        ReadinessStarted { row: _, configurations: _ } => false
        ReadinessStartedUnbound { row: _, configurations: _ } => false
        ReadinessConnecting { row: _, configurations: _ } => false
        _ => false
      }
  }
}

// 100 AT THE READ BUILD IS CONNECTING, ON THIS BUILD'S OWN VENDOR RENDERING. This replaces the claim that
// the 0.32 interlude code would refuse here, which said it would go red the day 100 was grounded at this
// release; boot 10 (run 42756688400) read 100 on the wanted image beside the no-session marker and refused
// on it as uncatalogued, and run 42783677276 read how the vendor draws it. The grounding is the renderer's
// 100 branch (the code's own catalogue string, NOT the lmedia:halted prefix every code but 0, 1 and 100 takes)
// and the English catalogue's lmedia:status_100, " Starting.." -- a Candidate-grade raw occurrence, with no
// operator reading of a row at 100 committed. The reading is the same asset the status-0 rendering came from
// (same path, same octet count), and its label is not the vendor's word for stopped.
test fn w_100_at_the_read_build_is_connecting_on_the_vendors_rendering() -> Bool {
  match mtcollins1_current_build_firmware {
    Absent => false
    Present { value: read } =>
      megarac_redirection_status_of_wire(firmware: read, wire: mtcollins1_ui_status_100_rendering.wire) == RedirectionStatusKnown { firmware: read, status: RedirectionConnecting }
        && megarac_redirection_status_of_row(firmware: read, wire: 100, session_index: Present { value: megarac_no_redirection_session_index }) == RedirectionStatusKnown { firmware: read, status: RedirectionConnecting }
        && mtcollins1_ui_status_100_rendering.wire == 100
        && (mtcollins1_ui_status_100_rendering.label as String) == " Starting.."
        && (mtcollins1_ui_status_100_rendering.label_key as String) == "status_100"
        && string_contains(s: mtcollins1_ui_status_100_rendering.branch_rule as String, pattern: "\"100\"==r")
        && string_contains(s: mtcollins1_ui_status_100_rendering.branch_rule as String, pattern: "lmedia:status_")
        && !string_contains(s: mtcollins1_ui_status_100_rendering.branch_rule as String, pattern: "lmedia:halted")
        && string_contains(s: mtcollins1_ui_status_100_rendering.halted_exemption_rule as String, pattern: "100!=r")
        && (mtcollins1_ui_status_100_rendering.asset_path as String) == (mtcollins1_ui_media_row_rendering.asset_path as String)
        && byte_size_count(b: mtcollins1_ui_status_100_rendering.asset_octets) == byte_size_count(b: mtcollins1_ui_media_row_rendering.asset_octets)
        && !string_contains(s: mtcollins1_ui_status_100_rendering.label as String, pattern: mtcollins1_ui_media_row_rendering.halted_label as String)
  }
}

// THE ARM'S GROUND IS A TYPED BET, AND THE ARM POINTS AT IT. extdeps.bmc.megarac's ground row for the 0.45 arm
// names the `standing` field of this reading, and that standing is TranscribedUncited with a nonempty read
// obligation -- the Candidate grade carried in the type, not in a comment. RED if the standing is promoted
// (CitedToAuthority or ObservedByReceipt) without an operator reading, or if the ground row stops naming it.
test fn w_the_0_45_connecting_arm_rests_on_a_typed_uncited_standing() -> Bool {
  (megarac_0_45_redirection_100_ground.module_path as String) == "gunbc.machine_intake.megarac_media_row_reading"
    && (megarac_0_45_redirection_100_ground.decl_name as String) == "mtcollins1_ui_status_100_rendering"
    && match megarac_0_45_redirection_100_ground.field {
      NamedField { field_name: f } => (f as String) == "standing"
      _ => false
    }
    && match mtcollins1_ui_status_100_rendering.standing {
      TranscribedUncited { read_obligation: o } => string_contains(s: o as String, pattern: "operator reading of a live redirection_status 100 row")
      CitedToAuthority { authority: _ } => false
      ObservedByReceipt { observed: _ } => false
    }
}

// AND IT ONLY WAITS: THE ARM CAN NEVER ADMIT STARTED. Boot 10's exact row -- the wanted image at 100 beside the
// no-session marker -- is Connecting, which the readiness policy holds pending; and so is 100 beside a BOUND
// session index, the discriminating input: were 100 ever read as Started, that row (session 0) would come
// back ReadinessStarted and satisfy readiness. The only Started this build establishes is 1 beside a bound
// session (positive control). Through the window: a connecting look inside it looks again, and one at the
// deadline closes the window -- the typed "did not reach Started with a bound session"
// (MegaRacReadinessTimedOut), never ready.
test fn w_100_at_the_read_build_waits_and_never_establishes_readiness() -> Bool {
  match mtcollins1_current_build_firmware {
    Absent => false
    Present { value: read } =>
      (match attach_readiness(answered: true, body: rows1(row_at(name: boot6_leftover_iso as String, status: "100", session: "255")), image_name: boot6_leftover_iso, firmware: read) {
        ReadinessConnecting { row: _, configurations: _ } => true
        _ => false
      })
      && (match attach_readiness(answered: true, body: rows1(row_at(name: boot6_leftover_iso as String, status: "100", session: "0")), image_name: boot6_leftover_iso, firmware: read) {
        ReadinessConnecting { row: _, configurations: _ } => true
        _ => false
      })
      && (match attach_readiness(answered: true, body: rows1(row_at(name: boot6_leftover_iso as String, status: "1", session: "0")), image_name: boot6_leftover_iso, firmware: read) {
        ReadinessStarted { row: _, configurations: _ } => true
        _ => false
      })
      && (match readiness_verdict(opened_at: 1000, budget: 30000, previous: none, look: ReadinessLook { observed_at: 5000, reading: attach_readiness(answered: true, body: rows1(row_at(name: boot6_leftover_iso as String, status: "100", session: "255")), image_name: boot6_leftover_iso, firmware: read) }, phase: ReadinessAfterStart, looks: 3) {
        ReadinessLookAgain => true
        _ => false
      })
      && (match readiness_verdict(opened_at: 1000, budget: 30000, previous: none, look: ReadinessLook { observed_at: 31000, reading: attach_readiness(answered: true, body: rows1(row_at(name: boot6_leftover_iso as String, status: "100", session: "255")), image_name: boot6_leftover_iso, firmware: read) }, phase: ReadinessAfterStart, looks: 16) {
        ReadinessWindowClosed { last: _, deadline: d, looks: _ } => d == 31000
        _ => false
      })
  }
}

// THE MEDIA TYPE IS THE LANE'S OWN GATE, BEFORE ANY STATUS IS READ. A row of another media type that names the
// wanted image, at status 0 beside the marker, is refused by the lane's CD gate -- ConfigurationRowUnreadable --
// because this lane publishes a CD image; the not-active reading of a CD row is never consulted for it, and it
// is never idle, so it cannot be attached.
test fn w_a_row_of_another_media_type_is_refused_by_the_cd_gate_not_read_as_not_active() -> Bool {
  let row = json_object(members: [
    json_kv(key: "id", value: JsonNumber { lexeme: "1" }),
    json_kv(key: "media_type", value: JsonNumber { lexeme: "2" }),
    json_kv(key: "media_index", value: JsonNumber { lexeme: "0" }),
    json_kv(key: "session_index", value: JsonNumber { lexeme: "255" }),
    json_kv(key: "image_name", value: JsonString { value: "gunbc-runner-host-ubuntu-24.04.3-arm64-31aef9394d9e58c3.iso" }),
    json_kv(key: "redirection_status", value: JsonNumber { lexeme: "0" }),
  ])
  match mtcollins1_current_build_firmware {
    Absent => false
    Present { value: read } =>
      match configuration_row_reading(row: row, image_name: boot6_leftover_iso, firmware: read) {
        ConfigurationRowUnreadable { detail: d } => string_contains(s: d, pattern: "not CD media_type 1")
        _ => false
      }
      && configuration_row_reading(row: row, image_name: boot6_leftover_iso, firmware: read) != ConfigurationRowIdle
  }
}
