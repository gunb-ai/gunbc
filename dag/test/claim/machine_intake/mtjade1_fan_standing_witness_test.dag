module test.claim.mtjade1_fan_standing_witness

import std.types { Bool }
import std.measure { percent_count }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import extdeps.bmc.endpoint { AmiMegaRac, OpenBmc }
import gunbc.machine_intake_bmc_first_contact_standing { FamilyObserved }
import product.fan_policy_standing {
  ConvergeRouteBound,
  ConvergeRouteUnbound,
  HostPostStateUnobserved,
  HostPosted,
  HostPoweredOff,
  HostPoweredOnPrePost,
}
import gunbc.fleet_acoustic_intent { operator_residence_sustained_duty_ceiling }
import gunbc.machine_intake_mtjade1_fan_standing {
  AwaitingFirstPostWithDimms,
  ChassisHostPowerOff,
  FailsafeWindowUnbounded,
  FamilyUnobservedNoFanRealizer,
  FirstPostFanCaptured,
  JadeFanRouteSelected,
  jade_current_fan_policy_convergence,
  jade_fan_policy_convergence,
  mtjade1_failsafe_window_close,
  mtjade1_first_post_fan_capture,
  mtjade1_host_thermal_before_next_power_on,
  mtjade1_residence_acoustic_intent,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE RED MOVED WHEN THE FORK WAS DELETED, AND IT MOVED TO A STRONGER PLACE. This claim used to
// match a local UnboundedFailsafeFullDutyNotTolerated / FailsafeFullDutyAdmitted pair, so it could
// only go red if THIS module re-bound its own row. The receipt now carries the fleet ceiling, so
// the claim reds if gunbc.fleet_acoustic_intent raises that ceiling to full duty -- which is the
// change that would actually make unbounded full duty tolerable at this site, and which the old
// two-arm version could not see at all.
test fn w_mtjade1_residence_refuses_indefinite_full_failsafe() -> Bool {
  percent_count(p: mtjade1_residence_acoustic_intent.ceiling) < 100
    && percent_count(p: mtjade1_residence_acoustic_intent.ceiling) == percent_count(p: operator_residence_sustained_duty_ceiling)
    && match mtjade1_failsafe_window_close {
      ChassisHostPowerOff => true
      FailsafeWindowUnbounded => false
    }
}

// THE POST STATE IS NOW THE PRODUCT COPRODUCT, so this match is exhaustive over all four arms
// rather than over a local pair. Its red is unchanged in meaning -- the unit has not posted -- and
// wider in reach: HostPosted and HostPoweredOff are now distinguishable states this claim refuses,
// where the deleted HostThermalTelemetry pair could not tell a powered-off host from a pre-POST one.
test fn w_mtjade1_first_post_fan_finding_includes_stay_at_failsafe() -> Bool {
  match mtjade1_first_post_fan_capture {
    AwaitingFirstPostWithDimms => true
    FirstPostFanCaptured { standing: _ } => false
  }
    && match mtjade1_host_thermal_before_next_power_on {
      HostPoweredOnPrePost => true
      HostPosted => false
      HostPoweredOff => false
      HostPostStateUnobserved => false
    }
}

// WHAT THIS ASSERTS THAT THE PRE-MIGRATION VERSION COULD NOT. The old arms were named
// OpenBmcPidControlRows and MegaRacFanProfileUnexecuted, so the claim established only that the
// dispatch returned differently-named arms for the two families. It now establishes the fact the
// residence ceiling actually turns on: the OpenBMC family resolves to a BOUND route -- one with a
// write operation, a transport and a readback -- and the MegaRAC family to an UNBOUND one that
// carries its read obligation. That is the difference between a ceiling this fleet can converge
// and one it can only refuse against.
test fn w_mtjade1_fan_convergence_awaits_family_then_openbmc_pid_or_megarac_unexecuted() -> Bool {
  match jade_current_fan_policy_convergence() {
    FamilyUnobservedNoFanRealizer => true
    JadeFanRouteSelected { route: _ } => false
  }
    && match jade_fan_policy_convergence(family: FamilyObserved { family: OpenBmc }) {
      JadeFanRouteSelected { route: r } => match r {
        ConvergeRouteBound { authority: _, write_operation: _, transport: _, readback: _ } => true
        ConvergeRouteUnbound { authority: _, read_obligation: _ } => false
      }
      FamilyUnobservedNoFanRealizer => false
    }
    && match jade_fan_policy_convergence(family: FamilyObserved { family: AmiMegaRac }) {
      JadeFanRouteSelected { route: r } => match r {
        ConvergeRouteUnbound { authority: _, read_obligation: _ } => true
        ConvergeRouteBound { authority: _, write_operation: _, transport: _, readback: _ } => false
      }
      FamilyUnobservedNoFanRealizer => false
    }
}
