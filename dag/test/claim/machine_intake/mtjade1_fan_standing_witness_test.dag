module test.claim.mtjade1_fan_standing_witness

import std.types { Bool }
import std.measure { percent_count }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import extdeps.bmc.endpoint { AmiMegaRac, OpenBmc }
import extdeps.ampere.mt_jade_getting_started_guide.chassis {
  mt_jade_gsg_without_1p_bmc_image_fan_duty,
}
import gunbc.machine_intake_bmc_first_contact_standing { FamilyObserved }
import gunbc.machine_intake_mtjade1_fan_standing {
  AwaitingFirstPostWithDimms,
  ChassisHostPowerOff,
  FailsafeFullDutyAdmitted,
  FailsafeWindowUnbounded,
  FamilyUnobservedNoFanRealizer,
  FansLeftFailsafeForThermalCurve,
  FansStayAtFailsafeAfterPost,
  FirstPostFanCaptured,
  HostThermalAbsentBeforePost,
  HostThermalPresentAfterPost,
  MegaRacFanProfileUnexecuted,
  OpenBmcPidControlRows,
  OperatorResidence,
  failsafe_window_closes_by_chassis_power_off,
  jade_current_fan_policy_convergence,
  jade_fan_policy_convergence,
  mtjade1_failsafe_window_close,
  mtjade1_first_post_fan_capture,
  mtjade1_host_thermal_before_next_power_on,
  mtjade1_residence_acoustic_intent,
  residence_refuses_unbounded_failsafe,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn w_mtjade1_residence_refuses_indefinite_full_failsafe() -> Bool {
  residence_refuses_unbounded_failsafe(intent: mtjade1_residence_acoustic_intent)
    && residence_refuses_unbounded_failsafe(
      intent: FailsafeFullDutyAdmitted {
        site: OperatorResidence,
        cited_act: "fixture: a site that admits unbounded failsafe full duty",
      },
    ) == false
    && failsafe_window_closes_by_chassis_power_off(close: mtjade1_failsafe_window_close)
    && failsafe_window_closes_by_chassis_power_off(close: ChassisHostPowerOff)
    && failsafe_window_closes_by_chassis_power_off(close: FailsafeWindowUnbounded) == false
}

test fn w_mtjade1_first_post_fan_finding_includes_stay_at_failsafe() -> Bool {
  match mtjade1_first_post_fan_capture {
    AwaitingFirstPostWithDimms => true
    FirstPostFanCaptured { finding: _ } => false
  }
    && match mtjade1_host_thermal_before_next_power_on {
      HostThermalAbsentBeforePost => true
      HostThermalPresentAfterPost => false
    }
    && match FansStayAtFailsafeAfterPost { discriminator: "fixture: SOL/BMC sensors still failsafe after POST" } {
      FansStayAtFailsafeAfterPost { discriminator: _ } => true
      FansLeftFailsafeForThermalCurve => false
    }
}

test fn w_mtjade1_fan_convergence_awaits_family_then_openbmc_pid_or_megarac_unexecuted() -> Bool {
  match jade_current_fan_policy_convergence() {
    FamilyUnobservedNoFanRealizer => true
    OpenBmcPidControlRows => false
    MegaRacFanProfileUnexecuted { reason: _ } => false
  }
    && match jade_fan_policy_convergence(family: FamilyObserved { family: OpenBmc }) {
      OpenBmcPidControlRows => true
      MegaRacFanProfileUnexecuted { reason: _ } => false
      FamilyUnobservedNoFanRealizer => false
    }
    && match jade_fan_policy_convergence(family: FamilyObserved { family: AmiMegaRac }) {
      MegaRacFanProfileUnexecuted { reason: _ } => true
      OpenBmcPidControlRows => false
      FamilyUnobservedNoFanRealizer => false
    }
    && percent_count(mt_jade_gsg_without_1p_bmc_image_fan_duty) == 100
}
