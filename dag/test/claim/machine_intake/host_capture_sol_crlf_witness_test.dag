module test.claim.machine_intake.host_capture_sol_crlf_witness_test

import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.types { Bool, List, NonEmptyStr, String }
import gunbc.machine_intake_host_capture_envelope {
  host_capture_bind, host_capture_section_reading, HostCaptureOpen, HostCaptureSectionReading, SectionComplete,
}
import gunbc.machine_intake_mtcollins1_boot_run {
  mtcollins1_boot_terminal_verdict, mtcollins1_boot_terminal_cause_text, MtCollins1BootTerminalVerdict, TerminalRefused,
}
import gunbc.machine_intake_mtcollins1_boot_authorization { mtcollins1_boot_subject_for, MtCollins1CensusMedium }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// SUPPLIED INPUT, REAL BYTES: lines of the SOL capture from mtcollins1_boot run 35793279839
// (artifact mtcollins1-boot-receipts, mtcollins1-boot-sol.capture), each carrying the CR NL the
// console's ONLCR discipline wrote. Trimmed to the begin marker and the three sections that run
// refused with "exited 0"; boot-media and edac-before keep a subset of their output lines,
// byte-for-byte, and nproc is whole. The envelope stays open (no end marker), as the run's was.
data sol_crlf_capture_lines: List<String> = [
    "=====GUNBC-HOST-CAPTURE mtcollins1 boot-id=8d112fe8-4fe1-48d8-b02b-64068f758b30 begin 2026-09-22T22:54:17Z=====\r\n",
    "----SECTION boot-media----\r\n",
    "----ARGV boot-media: ls -l /dev/disk/by-label; blkid\r\n",
    "total 0\r\n",
    "lrwxrwxrwx 1 root root 9 Sep 22 22:53 GUNBC_MTC1_CENSUS_2404_3 -> ../../sr0\r\n",
    "----EXIT boot-media: 0\r\n",
    "----SECTION nproc----\r\n",
    "----ARGV nproc: nproc\r\n",
    "80\r\n",
    "----EXIT nproc: 0\r\n",
    "----SECTION edac-before----\r\n",
    "----ARGV edac-before: find /sys/devices/system/edac -type f -name '*count' | sort | while read -r f; do echo \"$f == $(cat \"$f\")\"; done\r\n",
    "/sys/devices/system/edac/mc/mc0/ce_count == 0\r\n",
    "/sys/devices/system/edac/mc/mc0/dimm8/dimm_ue_count == 0\r\n",
    "/sys/devices/system/edac/mc/mc0/ue_count == 0\r\n",
    "----EXIT edac-before: 0\r\n",
]

fn sol_crlf_capture() -> String {
  join(sol_crlf_capture_lines, "")
}

fn completed_with_exit_zero(r: HostCaptureSectionReading) -> Bool {
  match r { SectionComplete { exit_code: c, output: _ } => c == "0"  _ => false }
}

// THE ROUTE: every section framed from the CR NL bytes completes with exit code exactly "0" --
// the terminator's CR reaches no reader. At main (split on NL alone) each reads "0\r".
test fn sol_crlf_sections_complete_with_exit_zero() -> Bool {
  match host_capture_bind(capture: sol_crlf_capture(), machine: "mtcollins1" as NonEmptyStr) {
    HostCaptureOpen { envelope: e } =>
      completed_with_exit_zero(r: host_capture_section_reading(envelope: e, name: "nproc"))
        && completed_with_exit_zero(r: host_capture_section_reading(envelope: e, name: "boot-media"))
        && completed_with_exit_zero(r: host_capture_section_reading(envelope: e, name: "edac-before"))
    _ => false
  }
}

// THE VERDICT: boot-media and edac-before hold, and the only REFUSING cause is nproc's JUDGED value --
// "80" read exactly (no CR), against the census row's 160 (gunbc.machine_intake_mtcollins1_memory_census_observation
// mtcollins1_nproc). That mismatch is the unit's own reading, not framing: the same capture's lscpu
// reports CPU(s) 80 on one socket. At main this refuses with the three "exited 0" causes instead.
// The trimmed capture never opens workload or edac-after, so the open refusal names both as
// unobserved rather than dropping them (mtcollins1_boot_run open_unresolved_causes).
test fn sol_crlf_capture_refuses_only_on_the_nproc_reading() -> Bool {
  let medium = MtCollins1CensusMedium { output_digest: "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef" as NonEmptyStr }
  let subject = mtcollins1_boot_subject_for(medium: medium, execution_revision: "0123456789abcdef0123456789abcdef01234567" as NonEmptyStr)
  match mtcollins1_boot_terminal_verdict(capture: sol_crlf_capture(), subject: subject, medium: medium) {
    TerminalRefused { causes: cs } => map(cs, c => mtcollins1_boot_terminal_cause_text(cause: c)) == [
      "nproc observed 80, qualification expects 160",
      "workload not yet observed when the open envelope refused; unqualified",
      "edac-after not yet observed when the open envelope refused; unqualified",
    ]
    _ => false
  }
}
