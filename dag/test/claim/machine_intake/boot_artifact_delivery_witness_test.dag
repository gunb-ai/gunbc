  }
}

// RULING §2 CONTROL — collection discovered is NOT a plan floor.
test fn redfish_collection_discovery_alone_does_not_plan() -> Bool {
  match solve(profile: vm_profile, receipt: observed(surfaces: [SurfaceBootControl, SurfaceRedfishVirtualMedia], probe: Present { value: probe_collection_only }), staging: staging_all) {
    BootDeliveryRefused { cause: c } =>
      match c {
        DeliveryNoEligibleTransport { firmware: _, considered: considered } =>
          match boot_delivery_candidate_standing_of(verdicts: considered, candidate: CandidateRedfishVirtualMedia) {
            CandidateIneligible { cause: ineligibility } => match ineligibility { CandidateRedfishProbeBelowPlanFloor { progress: p } => p == CollectionDiscovered _ => false }
            _ => false
          }
        _ => false
      }
    BootDeliveryPlanned { plan: _ } => false
  }
}

// RED (2026-08-30 re-review §2) — a receipt whose arm says the floor was never
// reached while its population lists HTTPS contradicts itself: refused as a
// contradiction, never resolved by preferring the population.
fn refuses_as_probe_contradiction(s: BootDeliverySolution, expected: RedfishVirtualMediaProbe) -> Bool {
  match s {
    BootDeliveryRefused { cause: c } =>
      match c {
        DeliveryNoEligibleTransport { firmware: _, considered: considered } =>
          match boot_delivery_candidate_standing_of(verdicts: considered, candidate: CandidateRedfishVirtualMedia) {
            CandidateIneligible { cause: ineligibility } => match ineligibility { CandidateRedfishProbeContradictory { progress: p, admitted: a } => p == expected && list_length(items: a) == 1 _ => false }
            _ => false
          }
        _ => false
      }
    BootDeliveryPlanned { plan: _ } => false
  }
}

test fn contradictory_probe_receipts_are_refused_not_resolved() -> Bool {
  let unreached = solve(profile: vm_profile, receipt: observed(surfaces: [SurfaceBootControl, SurfaceRedfishVirtualMedia], probe: Present { value: probe_unreached_with_https }), staging: staging_all)
  let collection = solve(profile: vm_profile, receipt: observed(surfaces: [SurfaceBootControl, SurfaceRedfishVirtualMedia], probe: Present { value: probe_collection_with_https }), staging: staging_all)
  refuses_as_probe_contradiction(s: unreached, expected: ProbeUnreached) && refuses_as_probe_contradiction(s: collection, expected: CollectionDiscovered)
}

// RED (2026-08-30 re-review §3) — the catalog row names BootSourceOverride and
// the media surface is live, but the controller was NOT observed serving boot
// control: no plan, and the refusal names the control surface's standing.
test fn live_boot_control_absent_refuses_despite_catalog_capability_and_live_media() -> Bool {
  match solve(profile: vm_profile, receipt: observed(surfaces: [SurfaceRedfishVirtualMedia, SurfaceOemRestRemoteMedia], probe: Present { value: probe_https }), staging: staging_all) {
    BootDeliveryRefused { cause: c } =>
      match c {
        DeliveryBootControlSurfaceUnestablished { standing: s } =>
          match s {
            CandidateIneligible { cause: ineligibility } => match ineligibility { CandidateLiveSurfaceAbsent { surface: sf } => sf == SurfaceBootControl _ => false }
            _ => false
          }
        _ => false
      }
    BootDeliveryPlanned { plan: _ } => false
  }
}

// RED + POSITIVE (2026-08-30 re-review, boot-control ruling) — profile names
// Redfish AND IPMI; boot control was observed over IPMI only: the plan carries
// IPMI, never the catalog's Redfish; with no route observation at all the solve
// refuses rather than picking from the profile; with both observed it is a
// typed ambiguity; a MegaRAC REST route — named by the profile, but carrying no
// boot-control operation — is refused as not control-capable.
fn solve_with_control(control: List<BmcBootControlRouteObservation>) -> BootDeliverySolution {
  let receipt = receipt_of(subject: intake_subject, standing: BmcAccessObserved { observation: observation_over(identity: mt_collins_identity, surfaces: [SurfaceBootControl, SurfaceRedfishVirtualMedia], probe: Present { value: probe_https }, control: control) }, manifest: full_manifest)
  solve(profile: vm_profile, receipt: receipt, staging: staging_all)
}

test fn boot_control_route_is_the_observed_one_never_the_catalogued_preference() -> Bool {
  let ipmi_only = match solve_with_control(control: [control_over_ipmi]) {
    BootDeliveryPlanned { plan: p } => p.boot_control_route.route == IpmiLanplusRoute && p.boot_control_route.raw_response == control_over_ipmi.raw_response
    BootDeliveryRefused { cause: _ } => false
  }
  let unobserved = match solve_with_control(control: []) {
    BootDeliveryRefused { cause: c } =>
      match c {
        DeliveryBootControlRouteUnobserved { endpoint: e } => e == megarac_endpoint
        _ => false
      }
    BootDeliveryPlanned { plan: _ } => false
  }
  let ambiguous = match solve_with_control(control: [control_over_redfish, control_over_ipmi]) {
    BootDeliveryRefused { cause: c } =>
      match c {
        DeliveryBootControlRouteAmbiguous { observed: rs } => list_length(items: rs) == 2
        _ => false
      }
    BootDeliveryPlanned { plan: _ } => false
  }
  let not_capable = match solve_with_control(control: [control_over_megarac_rest]) {
    BootDeliveryRefused { cause: c } =>
      match c {
        DeliveryBootControlRouteNotControlCapable { observed: r } => r == MegaRacRestRoute { image_redirection: MegaRacImageRedirectionEnabled }
        _ => false
      }
    BootDeliveryPlanned { plan: _ } => false
  }
  ipmi_only && unobserved && ambiguous && not_capable
}

// RED — a control-route observation whose bytes the manifest does not name
// does not bind, exactly like the probe's.
test fn control_route_bytes_absent_from_the_manifest_do_not_bind() -> Bool {
  let receipt = receipt_of(subject: intake_subject, standing: BmcAccessObserved { observation: observation_over(identity: mt_collins_identity, surfaces: [SurfaceBootControl, SurfaceRedfishVirtualMedia], probe: Present { value: probe_https }, control: [control_over_redfish]) }, manifest: manifest_of(digests: [discovery_digest, probe_https.raw_response]))
  match bind(profile: vm_profile, receipt: receipt) {
