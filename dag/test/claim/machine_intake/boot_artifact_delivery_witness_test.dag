          params.image_name == "intake.iso"
            && megarac_image_redirection_wire(r: params.image_redirection) == "1"
            && p.boot_control == BootFromRemovableMedia
        _ => false
      }
    BootDeliveryRefused { cause: _ } => false
  }
}

// RED (ruling 3 §2) — the same build with image_redirection Unset on its
