data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// ---------------------------------------------------------------------------
// The intake subject and attempt this solve is for.
// ---------------------------------------------------------------------------
data unit: UnitKey = "BRD-000777" as UnitKey

data assembly: AssemblyManifest = AssemblyManifest {
  chassis_part_number: "CH-2U-MTC",
  components: [ComponentIdentity { kind: DimmComponent, slot: "A1", identity: "SPD-A1-777" }],
}

data firmware_manifest: FirmwareManifest = FirmwareManifest {
  entries: [FirmwareEntry { component: "bmc", version: "1.2.3" }],
  configuration_digests: [],
}

data attempt_one: IntakeAttemptId = "intake-20260830-0001" as IntakeAttemptId
data attempt_two: IntakeAttemptId = "intake-20260830-0002" as IntakeAttemptId

data intake_subject: MachineIntakeSubject = MachineIntakeSubject {
  subject: qualification_subject_of(unit_key: unit, assembly: assembly, firmware: firmware_manifest),
  attempt_id: attempt_one,
}

data other_attempt_subject: MachineIntakeSubject = MachineIntakeSubject {
  subject: qualification_subject_of(unit_key: unit, assembly: assembly, firmware: firmware_manifest),
  attempt_id: attempt_two,
}

// The controller, protocol-neutral: the same host is driven over MegaRAC REST
// for delivery and IPMI for boot control, and neither route is its identity.
data megarac_endpoint: BmcControllerEndpoint = BmcControllerEndpoint { host: "192.168.1.60" }
data other_controller: BmcControllerEndpoint = BmcControllerEndpoint { host: "192.168.1.61" }

data target: BootDeliveryTarget = BootDeliveryTarget { subject: intake_subject, endpoint: megarac_endpoint }
data other_attempt_target: BootDeliveryTarget = BootDeliveryTarget { subject: other_attempt_subject, endpoint: megarac_endpoint }
data other_controller_target: BootDeliveryTarget = BootDeliveryTarget { subject: intake_subject, endpoint: other_controller }

// THE ARTIFACT. Everything staged must name this digest.
data intake_artifact: BootArtifact = BootArtifact {
  purpose: IntakeLinuxEnvironment,
  architecture: Aarch64,
  digest: content_hash_of_value(value: "intake-linux-aarch64-fixture"),
  format: IsoImage,
  entrypoint: "/EFI/BOOT/BOOTAA64.EFI",
  build_identity: "intake-agent-0.1.0-fixture",
}

data other_digest: ContentHash = content_hash_of_value(value: "some-other-iso")

// ---------------------------------------------------------------------------
// Firmware release identities: the exact vendor string is the key; the
// semantic reading is derived and may be Absent.
// ---------------------------------------------------------------------------
data megarac_release: BmcFirmwareReleaseIdentity = bmc_firmware_release_identity_of_wire(family: AmiMegaRac, wire: "1.2.3")
data megarac_release_other: BmcFirmwareReleaseIdentity = bmc_firmware_release_identity_of_wire(family: AmiMegaRac, wire: "1.2.4")
data mt_collins_raw_release: BmcFirmwareReleaseIdentity = bmc_firmware_release_identity_of_wire(family: AmiMegaRac, wire: "0.32")
data mt_collins_raw_release_prior: BmcFirmwareReleaseIdentity = bmc_firmware_release_identity_of_wire(family: AmiMegaRac, wire: "0.31")

// Control-only EXACT-RELEASE capability rows for the profiles below.
fn row_of(rel: BmcFirmwareReleaseIdentity, capabilities: List<BmcCapability>) -> BmcFirmwareReleaseCapabilityRow {
  BmcFirmwareReleaseCapabilityRow { firmware: rel, capabilities: capabilities }
}

data vm_and_oem_row: BmcFirmwareReleaseCapabilityRow = row_of(rel: megarac_release, capabilities: [CapabilityPowerControl, CapabilityBootSourceOverride, CapabilityVirtualMedia, CapabilityOemRemoteMedia])
data oem_only_row: BmcFirmwareReleaseCapabilityRow = row_of(rel: megarac_release, capabilities: [CapabilityPowerControl, CapabilityBootSourceOverride, CapabilityOemRemoteMedia])
data no_vm_row: BmcFirmwareReleaseCapabilityRow = row_of(rel: megarac_release, capabilities: [CapabilityPowerControl, CapabilityBootSourceOverride])
data no_override_row: BmcFirmwareReleaseCapabilityRow = row_of(rel: megarac_release, capabilities: [CapabilityPowerControl, CapabilityVirtualMedia])
data raw_oem_row: BmcFirmwareReleaseCapabilityRow = row_of(rel: mt_collins_raw_release, capabilities: [CapabilityPowerControl, CapabilityBootSourceOverride, CapabilityOemRemoteMedia])
data raw_prior_oem_row: BmcFirmwareReleaseCapabilityRow = row_of(rel: mt_collins_raw_release_prior, capabilities: [CapabilityPowerControl, CapabilityBootSourceOverride, CapabilityOemRemoteMedia])

// ---------------------------------------------------------------------------
// Profiles. Control fixtures grounded in a fixture authority — no fleet unit
// has been observed on any of these releases. A PROMOTED provenance is kept
// only for the RED below: with no producer able to resolve its receipts it may
// not bind.
// ---------------------------------------------------------------------------
data fixture_provenance: ProfileFromExternalAuthority = ProfileFromExternalAuthority {
  authority: ExternalAuthority { uri: Uri { scheme: Https, locator: "fixture.invalid/bmc-access-profiles/control" } },
}

data promoted_provenance: ProfilePromotedFromObservation = ProfilePromotedFromObservation {
  observation_receipt: content_hash_of_value(value: "fixture-observation-receipt"),
  promotion_receipt: content_hash_of_value(value: "fixture-promotion-receipt"),
}

data redfish_route: BmcAccessRoute = RedfishRoute {
  system_locator: "/redfish/v1/Systems/1",
  chassis_locator: "/redfish/v1/Chassis/1",
  manager_locator: "/redfish/v1/Managers/1",
}

fn profile_keyed(rel: BmcFirmwareReleaseIdentity, routes: List<BmcAccessRoute>, surfaces: List<BmcAccessSurface>, row: BmcFirmwareReleaseCapabilityRow) -> BmcAccessProfile {
  BmcAccessProfile {
    key: BmcAccessProfileKey { baseboard: AmpereMtCollins, chassis: AllChassisVariants, firmware: rel },
    routes: routes,
    bootstrap_credential: none,
    candidate_surfaces: surfaces,
    capability_row: row,
  }
}

fn profile_of(routes: List<BmcAccessRoute>, surfaces: List<BmcAccessSurface>, row: BmcFirmwareReleaseCapabilityRow) -> BmcAccessProfile {
  BmcAccessProfile {
    key: BmcAccessProfileKey { baseboard: AmpereMtCollins, chassis: AllChassisVariants, firmware: megarac_release },
    routes: routes,
    bootstrap_credential: none,
    candidate_surfaces: surfaces,
    capability_row: row,
  }
}

fn catalog_of(profile: BmcAccessProfile) -> List<BmcAccessProfileCatalogRow> {
  [BmcAccessProfileCatalogRow { profile: profile, provenance: fixture_provenance }]
}

// A build serving both the DMTF collection and the OEM REST surface.
data vm_profile: BmcAccessProfile = profile_of(
  routes: [redfish_route, IpmiLanplusRoute, MegaRacRestRoute { image_redirection: MegaRacImageRedirectionEnabled }],
  surfaces: [SurfaceBootControl, SurfaceRedfishVirtualMedia, SurfaceOemRestRemoteMedia],
  row: vm_and_oem_row,
)

// The observed Mt. Collins shape: IPMI and the proprietary REST surface, no
// Redfish route at all — representable without inventing a locator.
data oem_only_profile: BmcAccessProfile = profile_of(
  routes: [IpmiLanplusRoute, MegaRacRestRoute { image_redirection: MegaRacImageRedirectionEnabled }],
  surfaces: [SurfaceBootControl, SurfaceOemRestRemoteMedia],
  row: oem_only_row,
)

data oem_unset_profile: BmcAccessProfile = profile_of(
  routes: [IpmiLanplusRoute, MegaRacRestRoute { image_redirection: MegaRacImageRedirectionUnset }],
  surfaces: [SurfaceBootControl, SurfaceOemRestRemoteMedia],
  row: oem_only_row,
)

// THE REAL Mt. Collins string: a profile keyed by raw "0.32" carrying an
// exact-release capability row for the same string. Representable AND
// inhabitable (ruling 4 §2).
data mt_collins_raw_profile: BmcAccessProfile = profile_keyed(
  rel: mt_collins_raw_release,
  routes: [IpmiLanplusRoute, MegaRacRestRoute { image_redirection: MegaRacImageRedirectionEnabled }],
  surfaces: [SurfaceBootControl, SurfaceOemRestRemoteMedia],
  row: raw_oem_row,
)

data no_vm_profile: BmcAccessProfile = profile_of(routes: [IpmiLanplusRoute], surfaces: [SurfaceBootControl], row: no_vm_row)

data no_override_profile: BmcAccessProfile = profile_of(routes: [redfish_route], surfaces: [SurfaceRedfishVirtualMedia], row: no_override_row)

// ---------------------------------------------------------------------------
// Observations and their receipts.
// ---------------------------------------------------------------------------
data discovery_digest: ContentHash = content_hash_of_value(value: "bmc-discovery-response-fixture")

fn identity_of(baseboard: BaseboardModel, firmware: BmcFirmwareReleaseIdentity) -> BmcObservedIdentity {
  BmcObservedIdentity { baseboard: baseboard, chassis_part_number: none, firmware: firmware }
}

data mt_collins_identity: BmcObservedIdentity = identity_of(baseboard: AmpereMtCollins, firmware: megarac_release)

data probe_https: RedfishVirtualMediaProbeReceipt = RedfishVirtualMediaProbeReceipt {
  locator: RedfishVirtualMediaLocator { parent: UnderManager { manager_id: "1" }, media_id: "CD1" },
  progress: TransferProtocolAdmitted,
  admitted_protocols: [TransferHttps, TransferNfs],
  raw_response: content_hash_of_value(value: "virtualmedia-cd1-fixture"),
}

data probe_nfs_only: RedfishVirtualMediaProbeReceipt = RedfishVirtualMediaProbeReceipt {
  locator: RedfishVirtualMediaLocator { parent: UnderManager { manager_id: "1" }, media_id: "CD1" },
  progress: TransferProtocolAdmitted,
  admitted_protocols: [TransferNfs],
  raw_response: content_hash_of_value(value: "virtualmedia-cd1-nfs-fixture"),
}

data probe_collection_only: RedfishVirtualMediaProbeReceipt = RedfishVirtualMediaProbeReceipt {
  locator: RedfishVirtualMediaLocator { parent: UnderManager { manager_id: "1" }, media_id: "CD1" },
  progress: CollectionDiscovered,
  admitted_protocols: [],
  raw_response: content_hash_of_value(value: "virtualmedia-collection-fixture"),
}

fn observation_of(identity: BmcObservedIdentity, surfaces: List<BmcAccessSurface>, probe: RedfishVirtualMediaProbeReceipt?) -> BmcAccessObservation {
  BmcAccessObservation {
    endpoint: megarac_endpoint,
    identity: identity,
    discovered_surfaces: surfaces,
    redfish_virtual_media_probe: probe,
    successful_read_surfaces: surfaces,
    successful_write_surfaces: [],
    raw_response: discovery_digest,
    observed_at: 1788000000000,
  }
}

// THE EVIDENCE MANIFEST: every raw blob the observation and its nested probes
// were read from. The control manifest names the discovery bytes and all three
// probe fixtures' bytes; the REDs below name less.
fn manifest_of(digests: List<ContentHash>) -> List<EvidenceRef> {
  digests |> map(d => EvidenceRef { label: "bmc-discovery", digest: d })
}

data full_manifest: List<EvidenceRef> = manifest_of(digests: [discovery_digest, probe_https.raw_response, probe_nfs_only.raw_response, probe_collection_only.raw_response])

fn receipt_of(subject: MachineIntakeSubject, standing: BmcAccessObservationStanding, manifest: List<EvidenceRef>) -> AccessObservationReceipt {
  AccessObservationReceipt { subject: subject, standing: standing, evidence_manifest: manifest }
}

fn observed(surfaces: List<BmcAccessSurface>, probe: RedfishVirtualMediaProbeReceipt?) -> AccessObservationReceipt {
  receipt_of(subject: intake_subject, standing: BmcAccessObserved { observation: observation_of(identity: mt_collins_identity, surfaces: surfaces, probe: probe) }, manifest: full_manifest)
}

// ---------------------------------------------------------------------------
// Staging offers.
// ---------------------------------------------------------------------------
fn redfish_offer(digest: ContentHash, protocol: RedfishVirtualMediaTransferProtocol) -> RedfishImageOffer {
  RedfishImageOffer {
    artifact_digest: digest,
    image: Uri { scheme: Https, locator: "intake-staging/artifacts/intake-linux-aarch64/intake.iso" },
    transfer_protocol: protocol,
  }
}

fn megarac_offer(digest: ContentHash) -> MegaRacShareOffer {
  MegaRacShareOffer {
    artifact_digest: digest,
    share_type: MegaRacShareNfs,
    server_address: "intake-staging",
    source_path: "/srv/bmc/intake/artifacts/intake-linux-aarch64",
    image_name: "intake.iso",
  }
}

data configfs_offer: ConfigfsGadgetOffer = ConfigfsGadgetOffer {
  artifact_digest: intake_artifact.digest,
  nbd_server_host: "intake-staging",
  nbd_port: 10809,
  export_name: "intake",
  nbd_device: "/dev/nbd0",
  udc: "1e6a0000.usb-vhub:p1",
}

data staging_all: BootArtifactStagingBinding = BootArtifactStagingBinding {
  redfish_image: Present { value: redfish_offer(digest: intake_artifact.digest, protocol: TransferHttps) },
  megarac_share: Present { value: megarac_offer(digest: intake_artifact.digest) },
  nbd_export: none,
  configfs_gadget: Present { value: configfs_offer },
}

data staging_wrong_redfish_digest: BootArtifactStagingBinding = BootArtifactStagingBinding {
  redfish_image: Present { value: redfish_offer(digest: other_digest, protocol: TransferHttps) },
  megarac_share: none,
  nbd_export: none,
  configfs_gadget: none,
}

fn request_with(staging: BootArtifactStagingBinding) -> BootDeliveryRequest {
  BootDeliveryRequest { target: target, artifact: intake_artifact, staging: staging }
}

data policy: BootDeliveryPolicy = BootDeliveryPolicy { preference: PreferStandardRedfishThenOemThenNetwork }

data configfs_unestablished: ReinstallPathStanding = ReinstallPathUnestablished { missing_probes: configfs_transport_requirements_all }

data network_boot_unestablished: NetworkBootDeliveryStanding = NetworkBootDeliveryUnestablished { missing: network_boot_requirements_all }

fn evidence_of(access: BoundBmcAccessContextStanding, configfs: ReinstallPathStanding, network_boot: NetworkBootDeliveryStanding) -> BoundBootDeliveryEvidence {
  BoundBootDeliveryEvidence {
    access: access,
    configfs: bind_reinstall_path_to_target(target: target, standing: configfs),
    uefi_http: UefiHttpDeliveryUnestablished { missing: uefi_http_requirements_all },
    network_boot: network_boot,
  }
}

fn bind(profile: BmcAccessProfile, receipt: AccessObservationReceipt) -> BoundBmcAccessContextStanding {
  bind_bmc_access_context(subject: intake_subject, receipt: receipt, catalog: catalog_of(profile: profile))
}

fn solve(profile: BmcAccessProfile, receipt: AccessObservationReceipt, staging: BootArtifactStagingBinding) -> BootDeliverySolution {
  solve_boot_artifact_delivery(
    request: request_with(staging: staging),
    ev: evidence_of(access: bind(profile: profile, receipt: receipt), configfs: configfs_unestablished, network_boot: network_boot_unestablished),
    policy: policy,
  )
}

// ===========================================================================
// POSITIVE CONTROL — bound context, probe receipt at the plan floor, an offer
// naming the requested digest: the Redfish pull is planned, and the plan binds
// target, artifact, the probe's own locator, a removable-media boot control
// and the observation receipt its eligibility came from.
// ===========================================================================
test fn redfish_virtual_media_planned_from_bound_context_and_probe_receipt() -> Bool {
  match solve(profile: vm_profile, receipt: observed(surfaces: [SurfaceBootControl, SurfaceRedfishVirtualMedia, SurfaceOemRestRemoteMedia], probe: Present { value: probe_https }), staging: staging_all) {
    BootDeliveryPlanned { plan: p } =>
      match p.delivery {
        RedfishVirtualMediaPull { params: params } =>
          params.transfer_protocol == TransferHttps
            && params.media.media_id == "CD1"
            && p.artifact.build_identity == intake_artifact.build_identity
            && p.target.endpoint == megarac_endpoint
            && p.boot_control == BootFromRemovableMedia
            && list_length(items: p.eligibility.evidence_manifest) == 4
            && p.eligibility.selected == SelectedFromProfileIntersection { surface: SurfaceRedfishVirtualMedia }
        _ => false
      }
    BootDeliveryRefused { cause: _ } => false
  }
}

// RED (ruling 3 §1) — the staged URI serves digest B while the request names
// digest A: the Redfish candidate stops at CandidateStagedArtifactMismatch and
// nothing is planned.
test fn staged_artifact_digest_mismatch_refuses_the_plan() -> Bool {
  match solve(profile: vm_profile, receipt: observed(surfaces: [SurfaceBootControl, SurfaceRedfishVirtualMedia], probe: Present { value: probe_https }), staging: staging_wrong_redfish_digest) {
    BootDeliveryRefused { cause: c } =>
      match c {
        DeliveryNoEligibleTransport { firmware: _, considered: considered } =>
          match boot_delivery_candidate_standing_of(verdicts: considered, candidate: CandidateRedfishVirtualMedia) {
            CandidateStagedArtifactMismatch { offered: _, requested: _ } => true
            _ => false
          }
        _ => false
      }
    BootDeliveryPlanned { plan: _ } => false
  }
}

// RED (ruling 4 §1) — same subject, a DIFFERENT controller: the context was
// bound for 192.168.1.60 and the request names .61. Refused before any
// candidate is judged, naming both sides.
test fn bound_context_for_another_controller_is_not_this_target() -> Bool {
  match solve_boot_artifact_delivery(
    request: BootDeliveryRequest { target: other_controller_target, artifact: intake_artifact, staging: staging_all },
    ev: evidence_of(access: bind(profile: vm_profile, receipt: observed(surfaces: [SurfaceBootControl, SurfaceRedfishVirtualMedia], probe: Present { value: probe_https })), configfs: configfs_unestablished, network_boot: network_boot_unestablished),
    policy: policy,
  ) {
    BootDeliveryRefused { cause: c } =>
      match c {
        DeliveryTargetControllerMismatch { requested: r, bound_endpoint: e } => r.endpoint == other_controller && e == megarac_endpoint
        _ => false
      }
    BootDeliveryPlanned { plan: _ } => false
  }
}

// RED (ruling 4 §1) — same controller, a DIFFERENT attempt: the context was
// bound for attempt one and the request is attempt two's. The access binder
// alone cannot see this (the receipt WAS attempt one's), so the target binding
// must.
test fn bound_context_for_another_attempt_is_not_this_target() -> Bool {
  match solve_boot_artifact_delivery(
    request: BootDeliveryRequest { target: other_attempt_target, artifact: intake_artifact, staging: staging_all },
    ev: evidence_of(access: bind(profile: vm_profile, receipt: observed(surfaces: [SurfaceBootControl, SurfaceRedfishVirtualMedia], probe: Present { value: probe_https })), configfs: configfs_unestablished, network_boot: network_boot_unestablished),
    policy: policy,
  ) {
    BootDeliveryRefused { cause: c } =>
      match c {
        DeliveryTargetSubjectMismatch { requested: r, bound_subject: s } =>
          (r.subject.attempt_id as NonEmptyStr) == (attempt_two as NonEmptyStr) && (s.attempt_id as NonEmptyStr) == (attempt_one as NonEmptyStr)
        _ => false
      }
    BootDeliveryPlanned { plan: _ } => false
  }
}

// RED (ruling 3 §1) — an observation taken for another attempt is not
// evidence about this one, however well its identity fits.
test fn observation_from_another_attempt_does_not_bind() -> Bool {
  let receipt = receipt_of(subject: other_attempt_subject, standing: BmcAccessObserved { observation: observation_of(identity: mt_collins_identity, surfaces: [SurfaceBootControl, SurfaceRedfishVirtualMedia], probe: Present { value: probe_https }) }, manifest: full_manifest)
  match solve(profile: vm_profile, receipt: receipt, staging: staging_all) {
    BootDeliveryRefused { cause: c } =>
      match c {
        DeliveryAccessUnbound { standing: s } =>
          match s {
            AccessContextObservationForOtherAttempt { expected: _, found: f } => (f.attempt_id as NonEmptyStr) == (attempt_two as NonEmptyStr)
            _ => false
          }
        _ => false
      }
    BootDeliveryPlanned { plan: _ } => false
  }
}

// RED (ruling 3 §1) — the receipt names bytes the observation was not read
// from: the context does not bind.
test fn observation_whose_manifest_omits_its_bytes_does_not_bind() -> Bool {
  let receipt = receipt_of(subject: intake_subject, standing: BmcAccessObserved { observation: observation_of(identity: mt_collins_identity, surfaces: [SurfaceBootControl, SurfaceRedfishVirtualMedia], probe: Present { value: probe_https }) }, manifest: manifest_of(digests: [other_digest]))
  match bind(profile: vm_profile, receipt: receipt) {
    AccessContextObservationEvidenceMismatch { endpoint: e, manifest: _, raw_response: _ } => e == megarac_endpoint
    _ => false
  }
}

// RED (ruling 4 §5) — the manifest names the discovery bytes but NOT the
// nested probe's: the locator and protocols the plan would derive come from a
// blob no receipt captured, so the context does not bind.
test fn probe_bytes_absent_from_the_manifest_do_not_bind() -> Bool {
  let receipt = receipt_of(subject: intake_subject, standing: BmcAccessObserved { observation: observation_of(identity: mt_collins_identity, surfaces: [SurfaceBootControl, SurfaceRedfishVirtualMedia], probe: Present { value: probe_https }) }, manifest: manifest_of(digests: [discovery_digest]))
  match bind(profile: vm_profile, receipt: receipt) {
    AccessContextProbeEvidenceMismatch { endpoint: e, manifest: m, raw_response: r } => e == megarac_endpoint && list_length(items: m) == 1 && r == probe_https.raw_response
    _ => false
  }
}

// RED (ruling 4 §4) — a profile promoted from an observation names two
// receipts no producer can resolve: it does not bind, and the refusal names
// the receipts it could not verify.
test fn promoted_profile_without_verified_provenance_does_not_bind() -> Bool {
  let catalog = [BmcAccessProfileCatalogRow { profile: vm_profile, provenance: promoted_provenance }]
  match bind_bmc_access_context(subject: intake_subject, receipt: observed(surfaces: [SurfaceBootControl, SurfaceRedfishVirtualMedia], probe: Present { value: probe_https }), catalog: catalog) {
    AccessContextPromotedProfileUnverified { observation_receipt: o, promotion_receipt: _ } => o == promoted_provenance.observation_receipt
    _ => false
  }
}

// RED (ruling 3 §1) — a catalog row whose capability row describes a different
// release than its key ("0.31" beside a "0.32" key) refuses the whole lookup;
// and the real Mt. Collins string "0.32" is representable as a release
// identity with no semantic reading rather than fabricated as 0.32.0.
test fn capability_row_for_another_release_refuses_the_catalog() -> Bool {
  let raw_keyed = profile_keyed(
    rel: mt_collins_raw_release,
    routes: [IpmiLanplusRoute, MegaRacRestRoute { image_redirection: MegaRacImageRedirectionEnabled }],
    surfaces: [SurfaceBootControl, SurfaceOemRestRemoteMedia],
    row: raw_prior_oem_row,
  )
  let raw_has_no_semantic = match mt_collins_raw_release.semantic_version {
    Absent => true
    Present { value: _ } => false
  }
  let raw_identity = identity_of(baseboard: AmpereMtCollins, firmware: mt_collins_raw_release)
  let lookup_refused = match bmc_access_profile_for(identity: raw_identity, catalog: catalog_of(profile: raw_keyed)) {
    AccessProfileCatalogRowRefused { standing: s } =>
      match s {
        CatalogRowCapabilityFirmwareMismatch { key: _, row: _ } => true
        _ => false
      }
    _ => false
  }
  let receipt = receipt_of(subject: intake_subject, standing: BmcAccessObserved { observation: observation_of(identity: raw_identity, surfaces: [SurfaceBootControl, SurfaceOemRestRemoteMedia], probe: none) }, manifest: full_manifest)
  let context_refused = match bind_bmc_access_context(subject: intake_subject, receipt: receipt, catalog: catalog_of(profile: raw_keyed)) {
    AccessContextCatalogRefused { standing: _ } => true
    _ => false
  }
  mt_collins_raw_release.raw_version == "0.32" && raw_has_no_semantic && lookup_refused && context_refused
}

// POSITIVE CONTROL (ruling 4 §2) — raw release "0.32", an exact-release OEM
// remote-media capability row, a matching profile and a matching synthetic
// observation receipt: the context binds and the MegaRAC delivery is planned.
// A fixture proving inhabitability, not a seeded fleet observation.
test fn raw_release_0_32_binds_a_profile_and_plans_megarac_delivery() -> Bool {
  let raw_identity = identity_of(baseboard: AmpereMtCollins, firmware: mt_collins_raw_release)
  let receipt = receipt_of(subject: intake_subject, standing: BmcAccessObserved { observation: observation_of(identity: raw_identity, surfaces: [SurfaceBootControl, SurfaceOemRestRemoteMedia], probe: none) }, manifest: full_manifest)
  let bound = match bind(profile: mt_collins_raw_profile, receipt: receipt) {
    AccessContextBound { context: c } => c.capability_row.firmware.raw_version == "0.32" && c.identity.firmware.raw_version == "0.32"
    _ => false
  }
  let planned = match solve(profile: mt_collins_raw_profile, receipt: receipt, staging: staging_all) {
    BootDeliveryPlanned { plan: p } =>
      match p.delivery {
        MegaRacRestRemoteMedia { params: params } => megarac_image_redirection_wire(r: params.image_redirection) == "1" && p.eligibility.selected == SelectedFromProfileIntersection { surface: SurfaceOemRestRemoteMedia }
        _ => false
      }
    BootDeliveryRefused { cause: _ } => false
  }
  bound && planned
}

// RED (ruling 3 §2) — the probe admitted NFS only; the staging service offers
// HTTPS: the transport is not planned against a protocol the resource did not
// admit.
test fn offered_protocol_not_admitted_by_the_probe_refuses() -> Bool {
  match solve(profile: vm_profile, receipt: observed(surfaces: [SurfaceBootControl, SurfaceRedfishVirtualMedia], probe: Present { value: probe_nfs_only }), staging: staging_all) {
    BootDeliveryRefused { cause: c } =>
      match c {
        DeliveryNoEligibleTransport { firmware: _, considered: considered } =>
          match boot_delivery_candidate_standing_of(verdicts: considered, candidate: CandidateRedfishVirtualMedia) {
            CandidateRedfishProtocolNotAdmitted { offered: o, admitted: a } => o == TransferHttps && list_length(items: a) == 1
            _ => false
          }
        _ => false
      }
    BootDeliveryPlanned { plan: _ } => false
  }
}

// RED — a controller that served no Redfish VirtualMedia resource has no probe
// receipt, and a plan cannot be derived from a locator that was never read.
test fn absent_probe_receipt_refuses_the_redfish_arm() -> Bool {
  match solve(profile: vm_profile, receipt: observed(surfaces: [SurfaceBootControl, SurfaceRedfishVirtualMedia], probe: none), staging: staging_wrong_redfish_digest) {
    BootDeliveryRefused { cause: c } =>
      match c {
        DeliveryNoEligibleTransport { firmware: _, considered: considered } =>
          match boot_delivery_candidate_standing_of(verdicts: considered, candidate: CandidateRedfishVirtualMedia) {
            CandidateRedfishProbeAbsent => true
            _ => false
          }
        _ => false
      }
    BootDeliveryPlanned { plan: _ } => false
  }
}

// RULING §2 CONTROL — collection discovered is NOT a plan floor.
test fn redfish_collection_discovery_alone_does_not_plan() -> Bool {
  match solve(profile: vm_profile, receipt: observed(surfaces: [SurfaceBootControl, SurfaceRedfishVirtualMedia], probe: Present { value: probe_collection_only }), staging: staging_all) {
