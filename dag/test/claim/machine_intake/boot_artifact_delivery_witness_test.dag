            CandidateRedfishProbeBelowPlanFloor { progress: p } => p == CollectionDiscovered
            _ => false
          }
        _ => false
      }
    BootDeliveryPlanned { plan: _ } => false
  }
}

// POSITIVE CONTROL — the observed Mt. Collins shape: no Redfish route at all,
// the OEM REST surface live, the profile's MegaRAC route carrying
// image_redirection Enabled. The plan's params carry the typed
// MegaRacImageRedirectionOn the start-media contract requires.
test fn observed_mt_collins_build_plans_megarac_rest_remote_media_with_image_redirection() -> Bool {
  match solve(profile: oem_only_profile, receipt: observed(surfaces: [SurfaceBootControl, SurfaceOemRestRemoteMedia], probe: none), staging: staging_all) {
    BootDeliveryPlanned { plan: p } =>
      match p.delivery {
