data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data megarac_endpoint: BmcEndpoint = BmcEndpoint { host: "192.168.1.60", protocol: Redfish }

data megarac_fw: BmcFirmwareVersion = BmcFirmwareVersion { family: AmiMegaRac, version: firmware_semantic_version(major: 1, minor: 2, patch: 3) }
data megarac_fw_other: BmcFirmwareVersion = BmcFirmwareVersion { family: AmiMegaRac, version: firmware_semantic_version(major: 1, minor: 2, patch: 4) }

// A control-only MegaRAC row: the capability roster a platform profile would
// carry. No fleet unit has been observed on this firmware; the row exists so
// the witness can separate 'the catalog says so' from 'the endpoint served it'.
data megarac_vm_row: BmcFirmwareCapabilityRow = BmcFirmwareCapabilityRow {
  firmware: megarac_fw,
  capabilities: [CapabilityPowerControl, CapabilityBootSourceOverride, CapabilityVirtualMedia],
}

data no_vm_row: BmcFirmwareCapabilityRow = BmcFirmwareCapabilityRow {
  firmware: megarac_fw,
  capabilities: [CapabilityPowerControl, CapabilityBootSourceOverride],
}

data no_override_row: BmcFirmwareCapabilityRow = BmcFirmwareCapabilityRow {
  firmware: megarac_fw,
  capabilities: [CapabilityPowerControl, CapabilityVirtualMedia],
}

data redfish_params: RedfishVirtualMediaParams = RedfishVirtualMediaParams {
  media: RedfishVirtualMediaLocator { parent: UnderManager { manager_id: "1" }, media_id: "CD1" },
  image: Uri { scheme: Https, locator: "intake-staging/artifacts/sha256-abc/intake.iso" },
  transfer_protocol: TransferHttps,
}

data megarac_params: MegaRacRemoteMediaParams = MegaRacRemoteMediaParams {
  share_type: MegaRacShareNfs,
  server_address: "intake-staging",
  source_path: "/srv/bmc/intake/artifacts/sha256-abc",
  image_name: "intake.iso",
}

// The observed Mt. Collins build (gunbc#9678): no Redfish, the proprietary
// remote-media surface present. The row names the OEM capability, the live
// observation discovered the OEM surface, so the MegaRAC REST arm is selected.
data mt_collins_observed_row: BmcFirmwareCapabilityRow = BmcFirmwareCapabilityRow {
  firmware: megarac_fw,
  capabilities: [CapabilityPowerControl, CapabilityBootSourceOverride, CapabilityOemRemoteMedia],
}

// A control-only MegaRAC access profile for a Mt. Collins at megarac_fw: the
// catalog side of the intersection. Its candidate surfaces name the DMTF
// collection and the OEM remote-media surface; the live observation decides
// which of them this endpoint actually serves.
data mt_collins_control_profile: BmcAccessProfile = BmcAccessProfile {
  key: BmcAccessProfileKey { baseboard: AmpereMtCollins, chassis_part_number: none, firmware: megarac_fw },
  redfish_system_locator: "/redfish/v1/Systems/1",
  redfish_chassis_locator: "/redfish/v1/Chassis/1",
  redfish_manager_locator: "/redfish/v1/Managers/1",
  bootstrap_credential: none,
  candidate_surfaces: [SurfaceBootControl, SurfaceRedfishVirtualMedia, SurfaceOemRestRemoteMedia],
  oem_parameters: [],
}

data control_profile_catalog: List<BmcAccessProfileCatalogRow> = [
  BmcAccessProfileCatalogRow {
    profile: mt_collins_control_profile,
    provenance: DeclarationRef { module_path: "test.claim.boot_artifact_delivery_witness_test", decl_name: "mt_collins_control_profile", field: WholeDeclaration },
  },
]

fn identity_of(baseboard: BaseboardModel, firmware: BmcFirmwareVersion) -> BmcObservedIdentity {
  BmcObservedIdentity { baseboard: baseboard, chassis_part_number: none, firmware: firmware }
}

data mt_collins_identity: BmcObservedIdentity = identity_of(baseboard: AmpereMtCollins, firmware: megarac_fw)

data mt_collins_profile_standing: BmcAccessProfileStanding = bmc_access_profile_for(identity: mt_collins_identity, catalog: control_profile_catalog)

fn observed_with(surfaces: List<BmcAccessSurface>, identity: BmcObservedIdentity, probe: RedfishVirtualMediaProbe) -> BmcAccessObservationStanding {
  BmcAccessObserved {
    observation: BmcAccessObservation {
      endpoint: megarac_endpoint,
      identity: identity,
      firmware: identity.firmware,
      discovered_surfaces: surfaces,
      redfish_virtual_media_probe: probe,
      successful_read_surfaces: surfaces,
      successful_write_surfaces: [],
      observed_at: 1788000000000,
    },
  }
}

fn observed(surfaces: List<BmcAccessSurface>, firmware: BmcFirmwareVersion) -> BmcAccessObservationStanding {
  BmcAccessObserved {
    observation: BmcAccessObservation {
      endpoint: megarac_endpoint,
      identity: identity_of(baseboard: AmpereMtCollins, firmware: firmware),
      firmware: firmware,
      discovered_surfaces: surfaces,
      redfish_virtual_media_probe: TransferProtocolAdmitted { protocol: TransferHttps },
      successful_read_surfaces: surfaces,
      successful_write_surfaces: [],
      observed_at: 1788000000000,
    },
  }
}

fn delivery_evidence(row: BmcFirmwareCapabilityRow, live_access: BmcAccessObservationStanding, configfs: ReinstallPathStanding, configfs_params: ConfigfsGadgetParams?) -> BootDeliveryEvidence {
  BootDeliveryEvidence {
    row: row,
    profile: mt_collins_profile_standing,
    live_access: live_access,
    preference: PreferStandardRedfishThenOemThenNetwork,
    redfish_media: Present { value: redfish_params },
    megarac_media: Present { value: megarac_params },
    nbd_proxy: none,
    configfs: configfs,
    configfs_params: configfs_params,
    uefi_http: UefiHttpDeliveryUnestablished { missing: uefi_http_requirements_all },
    network_boot: NetworkBootDeliveryUnestablished { missing: network_boot_requirements_all },
  }
}

data configfs_unestablished: ReinstallPathStanding = ReinstallPathUnestablished { missing_probes: configfs_transport_requirements_all }

// POSITIVE CONTROL — catalog capability AND live-observed VirtualMedia surface
// at the same firmware selects the Redfish pull.
test fn redfish_virtual_media_selected_from_profile_and_live_intersection() -> Bool {
  match solve_boot_artifact_delivery(ev: delivery_evidence(row: megarac_vm_row, live_access: observed(surfaces: [SurfaceBootControl, SurfaceRedfishVirtualMedia], firmware: megarac_fw), configfs: configfs_unestablished, configfs_params: none)) {
    BootDeliveryPlanned { delivery: d, considered: _ } =>
      match d {
        RedfishVirtualMediaPull { params: p } => p.transfer_protocol == TransferHttps
        _ => false
      }
    BootDeliveryRefused { cause: _ } => false
  }
}

test fn observed_mt_collins_build_selects_megarac_rest_remote_media() -> Bool {
  match solve_boot_artifact_delivery(ev: delivery_evidence(row: mt_collins_observed_row, live_access: observed(surfaces: [SurfaceBootControl, SurfaceOemRestRemoteMedia], firmware: megarac_fw), configfs: configfs_unestablished, configfs_params: none)) {
    BootDeliveryPlanned { delivery: d, considered: _ } =>
      match d {
        MegaRacRestRemoteMedia { params: p } => p.image_name == "intake.iso"
        _ => false
      }
    BootDeliveryRefused { cause: _ } => false
  }
}

// CONTROL (ruling §16) — remove Redfish VirtualMedia from the LIVE observation
// while retaining it in the profile: the Redfish transport is not selected,
// and the considered set says the live surface was absent.
test fn redfish_virtual_media_absent_from_live_observation_is_not_selected() -> Bool {
  match solve_boot_artifact_delivery(ev: delivery_evidence(row: megarac_vm_row, live_access: observed(surfaces: [SurfaceBootControl], firmware: megarac_fw), configfs: configfs_unestablished, configfs_params: none)) {
    BootDeliveryRefused { cause: c } =>
      match c {
        DeliveryNoEligibleTransport { firmware: _, considered: considered } =>
          match boot_delivery_candidate_standing_of(verdicts: considered, candidate: CandidateRedfishVirtualMedia) {
            CandidateLiveSurfaceAbsent { surface: s } => s == SurfaceRedfishVirtualMedia
            _ => false
          }
        DeliveryNoBootSourceOverride { firmware: _ } => false
      }
    BootDeliveryPlanned { delivery: _, considered: _ } => false
  }
}

// An observation of a DIFFERENT firmware than the profile does not bind to
// it: the profile ∩ observation identity check refuses, not a version compare.
test fn live_observation_at_another_firmware_does_not_bind_the_profile() -> Bool {
  match solve_boot_artifact_delivery(ev: delivery_evidence(row: megarac_vm_row, live_access: observed(surfaces: [SurfaceBootControl, SurfaceRedfishVirtualMedia], firmware: megarac_fw_other), configfs: configfs_unestablished, configfs_params: none)) {
    BootDeliveryRefused { cause: c } =>
      match c {
        DeliveryNoEligibleTransport { firmware: _, considered: considered } =>
          match boot_delivery_candidate_standing_of(verdicts: considered, candidate: CandidateRedfishVirtualMedia) {
            CandidateProfileObservationIdentityMismatch { surface: _ } => true
            _ => false
          }
        DeliveryNoBootSourceOverride { firmware: _ } => false
      }
    BootDeliveryPlanned { delivery: _, considered: _ } => false
  }
}

// RULING §2 CONTROL — same firmware, a DIFFERENT board: the profile lookup
// refuses (uncatalogued for that identity), so no surface candidate is
// eligible; equal firmware alone never pairs an endpoint with a profile.
test fn same_firmware_on_another_board_does_not_pair_with_the_profile() -> Bool {
  let asrock_identity = identity_of(baseboard: AsrockRackAltrad8ud1l2t, firmware: megarac_fw)
  let standing = bmc_access_profile_for(identity: asrock_identity, catalog: control_profile_catalog)
  let ev = BootDeliveryEvidence {
    row: megarac_vm_row,
    profile: standing,
    live_access: observed_with(surfaces: [SurfaceBootControl, SurfaceRedfishVirtualMedia], identity: asrock_identity, probe: TransferProtocolAdmitted { protocol: TransferHttps }),
    preference: PreferStandardRedfishThenOemThenNetwork,
    redfish_media: Present { value: redfish_params },
    megarac_media: none,
    nbd_proxy: none,
    configfs: configfs_unestablished,
    configfs_params: none,
    uefi_http: UefiHttpDeliveryUnestablished { missing: uefi_http_requirements_all },
    network_boot: NetworkBootDeliveryUnestablished { missing: network_boot_requirements_all },
  }
  let lookup_refused = match standing {
    AccessProfileUncatalogued { observed_identity: _ } => true
    _ => false
  }
  lookup_refused
    && match solve_boot_artifact_delivery(ev: ev) {
         BootDeliveryRefused { cause: c } =>
           match c {
             DeliveryNoEligibleTransport { firmware: _, considered: considered } =>
               match boot_delivery_candidate_standing_of(verdicts: considered, candidate: CandidateRedfishVirtualMedia) {
                 CandidateProfileUnestablished { standing: _ } => true
                 _ => false
               }
             DeliveryNoBootSourceOverride { firmware: _ } => false
           }
         BootDeliveryPlanned { delivery: _, considered: _ } => false
       }
}

// RULING §2 CONTROL — collection discovered is NOT a plan floor: with the
// surface present but the probe stopping at CollectionDiscovered, the Redfish
// arm is not planned; the same evidence with TransferProtocolAdmitted is.
test fn redfish_collection_discovery_alone_does_not_plan() -> Bool {
  let below = solve_boot_artifact_delivery(ev: delivery_evidence(row: megarac_vm_row, live_access: observed_with(surfaces: [SurfaceBootControl, SurfaceRedfishVirtualMedia], identity: mt_collins_identity, probe: CollectionDiscovered), configfs: configfs_unestablished, configfs_params: none))
  match below {
    BootDeliveryRefused { cause: c } =>
      match c {
        DeliveryNoEligibleTransport { firmware: _, considered: considered } =>
          match boot_delivery_candidate_standing_of(verdicts: considered, candidate: CandidateRedfishVirtualMedia) {
            CandidateRedfishProbeBelowPlanFloor { probe: p } => p == CollectionDiscovered
            _ => false
          }
        DeliveryNoBootSourceOverride { firmware: _ } => false
      }
    BootDeliveryPlanned { delivery: _, considered: _ } => false
  }
}

test fn profile_lookup_binds_the_control_identity() -> Bool {
  match mt_collins_profile_standing {
    AccessProfileKnown { profile: p, provenance: _ } => p.key.baseboard == AmpereMtCollins
    _ => false
  }
}

test fn unobserved_endpoint_blocks_every_virtual_media_arm() -> Bool {
  match solve_boot_artifact_delivery(ev: delivery_evidence(row: megarac_vm_row, live_access: BmcAccessUnobserved { endpoint: megarac_endpoint }, configfs: configfs_unestablished, configfs_params: none)) {
    BootDeliveryRefused { cause: c } =>
      match c {
        DeliveryNoEligibleTransport { firmware: _, considered: considered } =>
          match boot_delivery_candidate_standing_of(verdicts: considered, candidate: CandidateRedfishVirtualMedia) {
            CandidateLiveSurfaceUnobserved { endpoint: e } => e == megarac_endpoint
            _ => false
          }
        DeliveryNoBootSourceOverride { firmware: _ } => false
      }
    BootDeliveryPlanned { delivery: _, considered: _ } => false
  }
}

// CONTROL (ruling §16) — no virtual media and no network-boot evidence: no
// implicit PXE. The PXE candidate reports the four missing requirements.
test fn no_virtual_media_and_no_network_boot_evidence_refuses_without_pxe() -> Bool {
  match solve_boot_artifact_delivery(ev: delivery_evidence(row: no_vm_row, live_access: observed(surfaces: [SurfaceBootControl], firmware: megarac_fw), configfs: configfs_unestablished, configfs_params: none)) {
    BootDeliveryRefused { cause: c } =>
      match c {
        DeliveryNoEligibleTransport { firmware: _, considered: considered } =>
          match boot_delivery_candidate_standing_of(verdicts: considered, candidate: CandidatePxeChainBoot) {
            CandidateNetworkBootUnestablished { missing: m } => list_length(items: m) == 4
            _ => false
          }
        DeliveryNoBootSourceOverride { firmware: _ } => false
      }
    BootDeliveryPlanned { delivery: _, considered: _ } => false
  }
}

test fn boot_source_override_gates_every_arm() -> Bool {
  match solve_boot_artifact_delivery(ev: delivery_evidence(row: no_override_row, live_access: observed(surfaces: [SurfaceRedfishVirtualMedia], firmware: megarac_fw), configfs: configfs_unestablished, configfs_params: none)) {
    BootDeliveryRefused { cause: c } =>
      match c {
        DeliveryNoBootSourceOverride { firmware: _ } => true
        DeliveryNoEligibleTransport { firmware: _, considered: _ } => false
      }
    BootDeliveryPlanned { delivery: _, considered: _ } => false
  }
}

data srv4_configfs_params: ConfigfsGadgetParams = ConfigfsGadgetParams {
  nbd_server_host: "intake-staging",
  nbd_port: 10809,
  export_name: "intake",
  nbd_device: "/dev/nbd0",
  udc: "1e6a0000.usb-vhub:p1",
}

// THE srv4 GAP, CLOSED: an established configfs reinstall path selects the
// USB-gadget delivery the old install solver could not see...
test fn established_configfs_path_selects_usb_gadget_delivery() -> Bool {
  match solve_boot_artifact_delivery(ev: delivery_evidence(row: no_vm_row, live_access: observed(surfaces: [SurfaceBootControl], firmware: megarac_fw), configfs: ReinstallPathEstablished { qualified_by: [] }, configfs_params: Present { value: srv4_configfs_params })) {
    BootDeliveryPlanned { delivery: d, considered: _ } =>
      match d {
        OpenBmcConfigfsUsbGadget { params: p } => p.udc == srv4_configfs_params.udc
        _ => false
      }
    BootDeliveryRefused { cause: _ } => false
  }
}

// ...and the frozen legacy projection carries no access profile: a capability
// row is not a profile, and the ruling forbids seeding one from memory, so even
// with the surface live-observed the projection refuses with the
// virtual-media-unestablished cause whose considered set shows the Redfish
// candidate stopped at the profile step, standing AccessProfileNotLookedUp —
// the executed reason X is frozen and its consumers must read
// BootDeliverySolution directly.
test fn legacy_projection_never_establishes_an_access_profile() -> Bool {
  match solve_delivery_from_capability_row(
    row: megarac_vm_row,
    catalog: [megarac_vm_row],
    live_access: observed(surfaces: [SurfaceBootControl, SurfaceRedfishVirtualMedia], firmware: megarac_fw),
    network_boot: NetworkBootDeliveryUnestablished { missing: network_boot_requirements_all },
    firmware_transition: fleet_firmware_transition_standing,
  ) {
    OsInstallMechanismRefused { cause: c } =>
      match c {
        InstallVirtualMediaLiveSurfaceUnestablished { firmware: _, considered: considered } =>
          match boot_delivery_candidate_standing_of(verdicts: considered, candidate: CandidateRedfishVirtualMedia) {
            CandidateProfileUnestablished { standing: s } =>
              match s {
                AccessProfileNotLookedUp { endpoint: _ } => true
                AccessProfileKnown { profile: _, provenance: _ } => false
                AccessProfileUncatalogued { observed_identity: _ } => false
                AccessProfileAmbiguous { observed_identity: _, count: _ } => false
                AccessProfileIdentityMismatch { profile: _, observed: _ } => false
              }
            _ => false
          }
        _ => false
      }
    OsInstallMechanismSelected { mechanism: _ } => false
  }
}

// The Redfish transport arm is one more inhabitant of the shared
// VirtualMediaTransport axis, and its action path is the DMTF one.
test fn redfish_transport_inhabits_the_shared_axis_with_dmtf_action_path() -> Bool {
  let transport = RedfishVirtualMediaTransport { params: redfish_params }
  virtual_media_transport_kind(transport: transport) == "redfish-virtualmedia"
    && redfish_virtual_media_insert_action_path(locator: redfish_params.media) == "/redfish/v1/Managers/1/VirtualMedia/CD1/Actions/VirtualMedia.InsertMedia"
}
