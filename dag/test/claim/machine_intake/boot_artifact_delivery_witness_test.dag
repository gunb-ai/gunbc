// THE srv4 GAP, CLOSED HONESTLY: all eight configfs probes observed present
// and bound to THIS target, with a staged export naming the artifact, select
// the USB-gadget delivery; the plan preserves the eight observations.
test fn established_configfs_path_selects_usb_gadget_delivery() -> Bool {
  match solve_boot_artifact_delivery(
    request: request_with(staging: staging_all),
    ev: evidence_of(access: bind(profile: no_vm_profile, receipt: observed(surfaces: [SurfaceBootControl], probe: none)), configfs: target_bound_reinstall_path(target: target, observations: every_configfs_probe_for(t: target)), network_boot: network_boot_unestablished),
    policy: policy,
  ) {
    BootDeliveryPlanned { plan: p } =>
      match p.delivery {
        OpenBmcConfigfsUsbGadget { params: params } =>
          params.udc == configfs_offer.udc
            && match p.eligibility.selected {
                 SelectedFromConfigfsQualification { qualified_by: q } => list_length(items: q) == 8
                 _ => false
               }
        _ => false
      }
    BootDeliveryRefused { cause: _ } => false
  }
}

// RED (2026-08-30 re-review §1) — an EMPTY observation population does not
// establish the path: the producer derives Unestablished with all eight probes
// missing, and no authored establishment can be handed in beside a target.
test fn empty_configfs_observation_population_does_not_establish() -> Bool {
  match solve_boot_artifact_delivery(
    request: request_with(staging: staging_all),
    ev: evidence_of(access: bind(profile: no_vm_profile, receipt: observed(surfaces: [SurfaceBootControl], probe: none)), configfs: configfs_unestablished, network_boot: network_boot_unestablished),
    policy: policy,
  ) {
    BootDeliveryRefused { cause: c } =>
      match c {
        DeliveryNoEligibleTransport { firmware: _, considered: considered } =>
          match boot_delivery_candidate_standing_of(verdicts: considered, candidate: CandidateOpenBmcConfigfsUsbGadget) {
            CandidateIneligible { cause: ineligibility } => match ineligibility { CandidateConfigfsUnestablished { missing: m } => list_length(items: m) == 8 _ => false }
            _ => false
          }
        _ => false
      }
    BootDeliveryPlanned { plan: _ } => false
  }
}

// RED (ruling 4 §1) — the same eight observations bound to ANOTHER target
// (another attempt on the same controller) are not evidence for this request:
// the producer refuses the binding and the candidate names the target found.
test fn configfs_path_established_for_another_target_is_refused() -> Bool {
  let ev = BoundBootDeliveryEvidence {
    access: bind(profile: no_vm_profile, receipt: observed(surfaces: [SurfaceBootControl], probe: none)),
    configfs: target_bound_reinstall_path(target: target, observations: every_configfs_probe_for(t: other_attempt_target)),
    uefi_http: UefiHttpDeliveryUnestablished { missing: uefi_http_requirements_all },
    network_boot: network_boot_unestablished,
  }
  match solve_boot_artifact_delivery(request: request_with(staging: staging_all), ev: ev, policy: policy) {
    BootDeliveryRefused { cause: c } =>
      match c {
        DeliveryNoEligibleTransport { firmware: _, considered: considered } =>
          match boot_delivery_candidate_standing_of(verdicts: considered, candidate: CandidateOpenBmcConfigfsUsbGadget) {
            CandidateIneligible { cause: ineligibility } => match ineligibility { CandidateEvidenceForOtherTarget { evidence_target: t } => (t.subject.attempt_id as NonEmptyStr) == (attempt_two as NonEmptyStr) _ => false }
            _ => false
          }
        _ => false
      }
    BootDeliveryPlanned { plan: _ } => false
  }
}

// Network boot: every axis observed AND the establishment naming the
// requested digest selects PXE; the same establishment naming another digest
// is a staged-artifact mismatch, never a plan.
fn control_network_boot_axis(requirement: NetworkBootRequirement) -> NetworkBootRequirementEvidence {
  NetworkBootRequirementEvidence {
    requirement: requirement,
    observation: DeclarationRef {
      module_path: "test.claim.boot_artifact_delivery_witness_test",
      decl_name: "established_network_boot_for",
      field: WholeDeclaration,
    },
    observed_at: 1788000000000,
  }
}

fn established_network_boot_for(t: BootDeliveryTarget, digest: ContentHash) -> NetworkBootDeliveryStanding {
  NetworkBootDeliveryEstablished {
    evidence: NetworkBootDeliveryEstablishment {
      target: t,
      boot_source_override: control_network_boot_axis(requirement: NetworkBootBootSourceOverride),
      client_boot_mode: control_network_boot_axis(requirement: NetworkBootClientBootMode),
      serving_infrastructure: control_network_boot_axis(requirement: NetworkBootServingInfrastructure),
      boot_artifacts: control_network_boot_axis(requirement: NetworkBootBootArtifacts),
      artifact_digest: digest,
    },
  }
}

test fn established_network_boot_naming_the_artifact_selects_pxe_and_another_digest_does_not() -> Bool {
  let planned = solve_boot_artifact_delivery(
    request: request_with(staging: boot_artifact_staging_unbound),
    ev: evidence_of(access: bind(profile: no_vm_profile, receipt: observed(surfaces: [SurfaceBootControl], probe: none)), configfs: configfs_unestablished, network_boot: established_network_boot_for(t: target, digest: intake_artifact.digest)),
    policy: policy,
  )
  let mismatched = solve_boot_artifact_delivery(
    request: request_with(staging: boot_artifact_staging_unbound),
    ev: evidence_of(access: bind(profile: no_vm_profile, receipt: observed(surfaces: [SurfaceBootControl], probe: none)), configfs: configfs_unestablished, network_boot: established_network_boot_for(t: target, digest: other_digest)),
    policy: policy,
  )
  let pxe_planned = match planned {
    BootDeliveryPlanned { plan: p } =>
      match p.delivery {
        PxeChainBoot { evidence: _ } => true
        _ => false
      }
    BootDeliveryRefused { cause: _ } => false
  }
  let pxe_refused = match mismatched {
    BootDeliveryRefused { cause: c } =>
      match c {
        DeliveryNoEligibleTransport { firmware: _, considered: considered } =>
          match boot_delivery_candidate_standing_of(verdicts: considered, candidate: CandidatePxeChainBoot) {
            CandidateIneligible { cause: ineligibility } => match ineligibility { CandidateStagedArtifactMismatch { offered: _, requested: _ } => true _ => false }
            _ => false
          }
        _ => false
      }
    BootDeliveryPlanned { plan: _ } => false
  }
  let other_target = solve_boot_artifact_delivery(
    request: request_with(staging: boot_artifact_staging_unbound),
    ev: evidence_of(access: bind(profile: no_vm_profile, receipt: observed(surfaces: [SurfaceBootControl], probe: none)), configfs: configfs_unestablished, network_boot: established_network_boot_for(t: other_controller_target, digest: intake_artifact.digest)),
    policy: policy,
  )
  let other_target_refused = match other_target {
    BootDeliveryRefused { cause: c } =>
      match c {
        DeliveryNoEligibleTransport { firmware: _, considered: considered } =>
          match boot_delivery_candidate_standing_of(verdicts: considered, candidate: CandidatePxeChainBoot) {
            CandidateIneligible { cause: ineligibility } => match ineligibility { CandidateEvidenceForOtherTarget { evidence_target: t } => t.endpoint == other_controller _ => false }
            _ => false
          }
        _ => false
      }
    BootDeliveryPlanned { plan: _ } => false
  }
  pxe_planned && pxe_refused && other_target_refused
}

// THE FROZEN PROJECTION reads the solver's answer and nothing else: a plan
// maps to the legacy arm that names it, a MegaRAC plan to the typed
// outside-legacy refusal, and the standing of a path that never ran a lookup
// keeps its own cause.
test fn legacy_projection_reads_the_solver_answer_and_names_the_unrun_lookup() -> Bool {
  let redfish_plan = solve(profile: vm_profile, receipt: observed(surfaces: [SurfaceBootControl, SurfaceRedfishVirtualMedia, SurfaceOemRestRemoteMedia], probe: Present { value: probe_https }), staging: staging_all)
  let megarac_plan = solve(profile: oem_only_profile, receipt: observed(surfaces: [SurfaceBootControl, SurfaceOemRestRemoteMedia], probe: none), staging: staging_all)
  let not_run = BootDeliveryRefused { cause: DeliveryAccessUnbound { standing: AccessContextProfileLookupNotRun { endpoint: other_controller } } }
  let redfish_ok = match os_install_solution_of_delivery(solution: redfish_plan) {
    OsInstallMechanismSelected { mechanism: m } => m == VirtualMediaInstall
    OsInstallMechanismRefused { cause: _ } => false
  }
  let megarac_ok = match os_install_solution_of_delivery(solution: megarac_plan) {
    OsInstallMechanismRefused { cause: c } =>
      match c {
        InstallDeliveryOutsideLegacyMechanism { delivery: _ } => true
        _ => false
      }
    OsInstallMechanismSelected { mechanism: _ } => false
  }
  let not_run_ok = match os_install_solution_of_delivery(solution: not_run) {
    OsInstallMechanismRefused { cause: c } =>
      match c {
        InstallAccessProfileNotLookedUp { endpoint: e } => e == other_controller
        _ => false
      }
    OsInstallMechanismSelected { mechanism: _ } => false
  }
  redfish_ok && megarac_ok && not_run_ok
}

// The Redfish transport arm is one more inhabitant of the shared
// VirtualMediaTransport axis, and its action path is the DMTF one.
test fn redfish_transport_inhabits_the_shared_axis_with_dmtf_action_path() -> Bool {
  let params = RedfishVirtualMediaParams { media: probe_https.locator, image: redfish_offer(digest: intake_artifact.digest, protocol: TransferHttps).image, transfer_protocol: TransferHttps }
  let transport = RedfishVirtualMediaTransport { params: params }
  virtual_media_transport_kind(transport: transport) == "redfish-virtualmedia"
    && redfish_virtual_media_insert_action_path(locator: params.media) == "/redfish/v1/Managers/1/VirtualMedia/CD1/Actions/VirtualMedia.InsertMedia"
}

// NO-FALLBACK-0: A PLAN NAMES ONE TRANSPORT AND OFFERS NO SECOND ONE.
//
// This is the only shape that separates a plan from an ordered fallback list,
// and no other control in this module reaches it: every other plan witness
// asserts what the SELECTED transport is, which a model that also hands over a
// spare would satisfy identically. The fixture is deliberately the two-eligible
// case — the profile and the live observation admit BOTH Redfish VirtualMedia
// and the MegaRAC REST remote-media surface — so the policy has a real choice
// to make and a real loser to record.
//
// The loser must appear as OUTRANKED BY the selected transport, naming it: a
// completed decision, not an offer. If plan verdicts still carried the solving
// standing, MegaRAC would read CandidateEligible here and an executor holding
// this plan could attempt it after Redfish failed. The first two assertions
// pin exactly one selection; the third is what makes the test non-vacuous,
// because without an outranked row the fixture would have had only one eligible
// candidate and would prove nothing about fallback at all.
fn plan_selected_count(verdicts: List<BootDeliveryPlanCandidateVerdict>) -> Int {
  fold(verdicts, init: 0, f: fn(acc, v) {
    match v.disposition {
      PlanCandidateSelected => acc + 1
      PlanCandidateOutrankedBy { selected: _ } => acc
      PlanCandidateIneligible { cause: _ } => acc
    }
  })
}

fn plan_outranked_by_redfish_count(verdicts: List<BootDeliveryPlanCandidateVerdict>) -> Int {
  fold(verdicts, init: 0, f: fn(acc, v) {
    match v.disposition {
      PlanCandidateSelected => acc
      PlanCandidateOutrankedBy { selected: sel } => if (sel == CandidateRedfishVirtualMedia) { acc + 1 } else { acc }
      PlanCandidateIneligible { cause: _ } => acc
    }
  })
}

fn plan_selected_is_redfish_count(verdicts: List<BootDeliveryPlanCandidateVerdict>) -> Int {
  fold(verdicts, init: 0, f: fn(acc, v) {
    match v.disposition {
      PlanCandidateSelected => if (v.candidate == CandidateRedfishVirtualMedia) { acc + 1 } else { acc }
      PlanCandidateOutrankedBy { selected: _ } => acc
      PlanCandidateIneligible { cause: _ } => acc
    }
  })
}

test fn a_plan_names_one_transport_and_records_the_rest_as_outranked() -> Bool {
  match solve(profile: vm_profile, receipt: observed(surfaces: [SurfaceBootControl, SurfaceRedfishVirtualMedia, SurfaceOemRestRemoteMedia], probe: Present { value: probe_https }), staging: staging_all) {
    BootDeliveryPlanned { plan: p } =>
      plan_selected_count(verdicts: p.eligibility.considered) == 1
        && plan_selected_is_redfish_count(verdicts: p.eligibility.considered) == 1
        && plan_outranked_by_redfish_count(verdicts: p.eligibility.considered) >= 1
    BootDeliveryRefused { cause: _ } => false
  }
}
