data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE mtcollins1 BOOT ACCEPTANCE MATRIX (gunbc#12423, operator ruling 2026-09-27). Every case runs THE
// REAL ENTRY -- gunbc.machine_intake.mtcollins1_boot_run mtcollins1_boot_on_srv1_resolving_toolchain, which the
// wet entry mtcollins1_boot_wet_on_srv1 is a single call into, unchanged -- over
// a dry realization of its whole effect demand (gunbc.machine_intake.mtcollins1_boot_dry_realization):
// the one BMC model, its virtual-media subsystem, the worker's filesystem, processes, environment and
// clocks, the SSH agent and srv2. Nothing in the orchestrator is replaced. Each case asserts the ROUTE
// the dispatcher logged -- which effects, in what order, under which hold -- and the typed outcome.
//
// EVIDENCE BOUNDARY, for every case here: the deepest real layer is the orchestration and every
// production decoder above the transport observation; the first substituted layer is the transport
// observation. None of these cases is evidence about what the physical controller, the ipmitool or
// curl clients, the SOL collector process or the host firmware do -- those are the companion transport
// controls and live acceptance -- and every modeled answer is grounded where the corpus retains one
// (extdeps.bmc.ipmitool_observed_output, extdeps.bmc.megarac_observed_output).
data realization_identity: NonEmptyStr = "mtcollins1-boot-matrix" as NonEmptyStr

data credential_path: String = "/run/bmc-credential"

data sol_capture_path: String = "/run/sol.capture"

data sol_pid_path: String = "/run/sol.pid"

fn matrix_grant(service: String, verb: std.effect_grant.Verb) -> Grant {
  Grant { verb: verb, root: NamespacePosition { tree: ServiceOpTree { service: service }, path: [] }, binding: ModeledRealization { realization: realization_identity as String }, lifecycle: LifecycleByConstruction }
}

// The services the entry's effect demand reaches, each granted to the dry realization for reading and
// writing. An operation of any other service refuses as uncovered.
data matrix_services: List<String> = [
  "diagnostic.ipmi.Tool", "megarac.Media", "Filesystem", "shell.Env", "sleep.Delay",
  "gunbc.machine_intake.sol_hold", "shell.Exec", "ssh.Session", "Clock", "linux.Procfs", "shell.Move", "os.Hostname", "shell.Mkdir", "shell.Path", "shell.Stat",
  // The media attach carries its CSRF token through gunbc.auth.private_secret_file's bracket, whose
  // demand reaches the modeled mktemp and remove services (their handlers live in
  // gunbc.filesystem_model private_secret_file_bindings, beside the filesystem handlers).
  "shell.Mktemp", "shell.Remove",
]

fn matrix_frame(world: MtCollins1BootWorld) -> WitnessEvaluationFrame<MtCollins1BootWorld> {
  matrix_frame_over(realization: mtcollins1_boot_dry_realization(identity: realization_identity, initial: world, epoch: virtual_clock_origin()))
}

fn matrix_frame_over(realization: OperationRealization<MtCollins1BootWorld>) -> WitnessEvaluationFrame<MtCollins1BootWorld> {
  WitnessEvaluationFrame {
    envelope: Envelope {
      frame: Frame { name: "mtcollins1-boot-matrix", kind: SharedStateFrame }
      grants: concat(map(matrix_services, s => matrix_grant(service: s, verb: Read)), map(matrix_services, s => matrix_grant(service: s, verb: Write)))
    }
    rest_fixtures: []
    realization: Present { value: realization }
  }
}

// THE RUNNER'S BROWSER TOOLCHAIN IS SUPPLIED, NOT READ BACK (ruling of eager-owl-205 on gunbc#12533).
// The wet entry resolves it with runner_browser_toolchain_here_wet -- a full readback of the installed
// tree against its pin, the host libraries, the versions and a launch probe -- which is a different
// subject with its own witnesses. The matrix supplies each resolution arm the boot can meet, built from
// the production location and probe values, and the inner entry calls it where the observer starts.
// The real resolution is a different subject, witnessed where the wet entry runs it.
fn srv1_toolchain_location() -> RunnerBrowserToolchainLocation? {
  match runner_browser_toolchain_host_admission(host: "srv1" as NonEmptyStr) {
    BrowserToolchainHostAdmitted { deploy: _, location: loc } => Present { value: loc }
    BrowserToolchainHostRefused { host: _, cause: _ } => none
  }
}

fn toolchain_standing(loc: RunnerBrowserToolchainLocation, tree: TreeAdmission) -> RunnerBrowserToolchainStanding {
  RunnerBrowserToolchainStanding {
    host: "srv1" as NonEmptyStr, location: loc, tree: tree,
    versions: [
      VersionMatches { subject: "node" as NonEmptyStr, observed: runner_browser_toolchain_node.version as String },
      VersionMatches { subject: "playwright-core" as NonEmptyStr, observed: runner_browser_toolchain_automation.version as String },
    ],
    libraries: [HostLibrariesResolved { binary: loc.headless_shell }, HostLibrariesResolved { binary: loc.chromium }],
    launch: BrowserLaunchRendered { title: browser_toolchain_probe_title, rendered_width: browser_toolchain_probe_width_px, resolved_module: loc.playwright_module as String },
    after: tree,
  }
}

fn ready_toolchain() -> RunnerBrowserToolchainResolution {
  match srv1_toolchain_location() {
    Present { value: loc } => BrowserToolchainReady { location: loc, standing: toolchain_standing(loc: loc, tree: TreeAdmitted) }
    Absent => BrowserToolchainUnresolved { cause: "matrix: srv1 is not admitted to the browser-toolchain pool" }
  }
}

fn boot_with_toolchain(toolchain: RunnerBrowserToolchainResolution) -> MtCollins1BootAttempt {
  mtcollins1_boot_on_srv1_resolving_toolchain(medium: mtcollins1_census_boot_medium, resolve_toolchain: fn() { toolchain }, pxe_target: none, cited: none)
}

fn run_attempt(world: MtCollins1BootWorld) -> WitnessEvaluation<MtCollins1BootAttempt, MtCollins1BootWorld> {
  evaluate_in_witness_frame(frame: matrix_frame(world: world), subject: fn(_scope) { boot_with_toolchain(toolchain: ready_toolchain()) })
}

// A SUBJECT RUN OVER THE ROUTE'S OWN FRAME. A frame is a realization over a world, and the world is
// the whole of what the effects can see; nothing here grants a subject more than the boot claims get.
fn matrix_subject_over<A>(
  realization: OperationRealization<MtCollins1BootWorld>,
  subject: fn(Bool) -> A,
) -> WitnessEvaluation<A, MtCollins1BootWorld> {
  evaluate_in_witness_frame(frame: matrix_frame_over(realization: realization), subject: subject)
}

// THE WORLD THE UNATTENDED RESET-RETURN DISPATCH RUNS IN. Same worker, same modeled effects as the
// boot -- the reset job and the boot run on one machine -- so the reset claims judge the production
// entry against the boot's own world rather than a second, drifting model of it. Two facts differ, and
// both belong to the reset dispatch alone: it reads the observer label its converge dispatch carried,
// and it files its receipt under the run id it was dispatched with.
fn world_for_reset_route(observer_label: String, run_id: String) -> MtCollins1BootWorld {
  let base = world_with_console(lines: [])
  MtCollins1BootWorld {
    // POWERED ON at the start, where the BOOT world starts powered off. The difference is the route's
    // own refusal surface, not a preference: the reset route refuses a subject that was not up before
    // it issued (a reset cannot prove a return for a machine that was never serving), while the boot
    // exists to power a cold chassis on. Starting on also makes the down-then-back watch earn its keep
    // here -- the only way the watch sees the subject leave is the cycle the route itself issued.
    // THE POWER-CYCLE WINDOW, WIDENED FROM THE MODEL'S 5s DEFAULT. The model's own cycle_off_interval
    // schedules the restore 5s after the cycle write; the route spends roughly that long on its own
    // post-issuance readbacks (every dispatch advances the virtual clock), so with 5s the scheduled
    // restore matures BEFORE the watch's first poll and the subject is never observed down -- the
    // measured failure (reset-not-measured cause=never observed down). A MegaRAC power cycle holding
    // the chassis off for 45s is the realistic hardware fact, and both watch bounds (120 down-samples
    // at ~1s, 200 back-samples at ~6s) bracket it. This is a fact about the modeled machine the frame
    // simulates, not a nudge to make the claim pass: the watch still has to SEE down and THEN back,
    // and a route that never wrote would still never be observed back.
    bmc: bmc_world_cycled(power: BmcPowerOn, off: second(count: 45)),
    media: base.media,
    // The boot's OWN filesystem, with ONE directory added: the directory the route's own receipt path
    // "target/host-reset-return.txt" lives in -- a write into an absent directory is refused, so this
    // is what lets the receipt the claims judge actually exist. Everything else comes from the boot:
    // the controller credential file the entry reads by the path its environment names (a capability
    // reaching the route through the modeled filesystem, not through an argument), and the maintenance-
    // exclusion store the handoff consults before ANY controller write, seeded empty so the read is a
    // no-exclusion read rather than an absent-store refusal.
    fs: ModeledFilesystem {
      files: base.fs.files,
      directories: concat(xs: base.fs.directories, ys: ["target"]),
      refused_reads: base.fs.refused_reads,
      stats: base.fs.stats,
    },
    // PREPENDED, not appended, because the modeled environment answers a repeated name from the first
    // row that matches it (gunbc.process_environment_model.modeled_variable): the reset dispatch's own
    // run id and observer label must win over the boot run's, exactly as a dispatched job's environment
    // overrides the runner's inherited one.
    environment: concat(xs: [
      ModeledVariable { name: host_reset_observer_label_env as String, value: observer_label },
      ModeledVariable { name: "GITHUB_RUN_ID", value: run_id },
    ], ys: base.environment),
    clock: base.clock,
    agent: base.agent,
    remote_hosts: base.remote_hosts,
    worker: base.worker,
    console: base.console, mktemp_refused: base.mktemp_refused
  }
}

// BmcWorld carries no with-cycle setter, and the test side constructs the record directly (the same
// shape gunbc.machine_intake.machine_intake_prior_life_boundary_witness uses). Everything else is the
// untouched bmc_world default.
fn bmc_world_cycled(power: BmcPower, off: Second) -> BmcWorld {
  let w = bmc_world(power: power)
  BmcWorld {
    power: w.power, pending: w.pending, fired: w.fired, boot_override: w.boot_override, sel: w.sel,
    sol_session_open: w.sol_session_open, cycle_off_interval: off,
    host_booted_at: w.host_booted_at, booted_via_override: w.booted_via_override, sol_drop_after_boot: w.sol_drop_after_boot,
    web: w.web, ipmi_users: w.ipmi_users, ipmi_user_access: w.ipmi_user_access, record_surfaces: w.record_surfaces, redfish_accounts: w.redfish_accounts,
  }
}

// THE REACHABILITY ANSWER, FOR THE ROUTE THAT ASKS IT. The reset route asks ssh.Session.Reachability
// of its subject before, during and after the reset; the boot never asks it. No answer may be a
// constant here: a constant "reachable" lets a reset that never moved the chassis pass the route's
// down-then-back watch, which is the exact fabrication gunbc.host.host_reset_return exists to catch.
// So the reachability of the subject IS the modeled chassis power -- the same BmcWorld the
// ChassisPowerControl dispatch writes and boot_advance ages -- and an endpoint nobody inventoried is
// not reachable, because nothing is invented to answer it.
data reset_route_subject_endpoint: String = "10.20.14.30"

fn reset_route_reachability_handler(w: MtCollins1BootWorld, call: OperationCall) -> OperationStep<MtCollins1BootWorld> {
  let asked = operation_input_text(invocation: call.invocation, name: "host")
  let wanted = match asked {
    Present { value: host } => host
    Absent => ""
  }
  // The reachability probe is the world's CLOCK TANK for the watch: it ages the BMC model at the
  // call's own virtual instant before reading power, so the power-cycle's scheduled BmcPowerRestored
  // matures inside the watch that is waiting for it. bmc_advance is the model's own aging function --
  // the same one the realization's advance carries -- and it is idempotent for an instant it has
  // already passed, so applying it here cannot fire an event twice.
  let aged = with_bmc(w: w, bmc: bmc_advance(world: w.bmc, now: call.now))
  let reachable = if wanted == reset_route_subject_endpoint || wanted == "mtcollins1" {
    // ssh LIVENESS, not chassis power. The probe the route watches with completes an ssh handshake:
    // a machine whose chassis power is On but whose OS has not finished booting answers NO. Reading
    // power alone made every poll after the power-cycle's restore answer reachable, so the down-watch
    // never saw the subject leave (HostObservedDownAndNotBack / never_down) -- the outage the watch
    // exists to observe was invisible to the fixture. The boot delay is the world's own fact: the host
    // is ssh-live only once modeled_host_up_after_boot has passed since the boot the model recorded
    // (host_booted_at, set by the same model's power-up and restore transitions). A world that has
    // never booted answers on power, which is the state the frame is certified against.
    host_is_ssh_live(bmc: aged.bmc, now: call.now)
  } else {
    match first_where(xs: w.remote_hosts, keep: fn(h) { (h.endpoint as String) == wanted }) {
      Present { value: _ } => true
      Absent => false
    }
  }
  OperationObserved {
    observation: ShellObserved { observation: ShellProcessExited { exit_code: if reachable { 0 } else { 255 }, stdout: "", stderr: "" } },
    state: aged,
    // A poll burns a second of the virtual clock. A zero-length poll freezes the world's clock:
    // the power-cycle's scheduled BmcPowerRestored (bmc_world's cycle_off_interval, +5s) would
    // never mature, the watch would read the subject down forever, and the route's verdict could
    // only ever be host-return-not-measured. One second per poll is the poll's own duration --
    // the reachability check is a probe with a cost, not an oracle outside of time.
    elapsed: second(count: 1),
  }
}

// THE MODELED OS BOOT TIME. The interval between the controller restoring chassis power and the host
// completing its boot enough to answer an ssh handshake. It is a fixture fact about the modeled
// machine, kept here beside the handler that consumes it; a machine image takes a real amount of time
// to come up, and a fixture that pretended otherwise would make the down-watch blind in exactly the
// direction the claim asserts about (a world where nothing is ever down proves nothing about watching
// for a return).
data modeled_host_up_after_boot: Second = second(count: 90)

// ssh liveness out of the model's own facts: the chassis must be On AND the boot the model recorded
// (host_booted_at, set by bmc_host_boots on power-up and on a power-cycle restore) must have happened
// at least modeled_host_up_after_boot ago. A world with no recorded boot answers on power alone --
// the frame's certified initial state, where the host is up and has been.
fn host_is_ssh_live(bmc: BmcWorld, now: Second) -> Bool {
  if !bmc_power_is_on(world: bmc) {
    false
  } else {
    match bmc.host_booted_at {
      Absent => true
      Present { value: booted } => second_count(s: now) >= second_count(s: booted) + second_count(s: modeled_host_up_after_boot)
    }
  }
}

// THE FRAME THE RESET ROUTE IS EXECUTED UNDER: the boot's own production realization over the reset
// world, with ONE binding changed -- the ssh.Session.Reachability answer replaced by the world-aware
// one above. It is replaced here rather than inside the production composition for two reasons: two
// bindings for one operation is a refusal, not an override, so the production answer must be filtered
// out first; and the boot witnesses stay certified against the realization they were certified
// against, while the reset route's reachability answer remains a visible fixture choice beside the
// world whose power it reads.
fn matrix_reset_route_frame(world: MtCollins1BootWorld) -> WitnessEvaluationFrame<MtCollins1BootWorld> {
  let production = mtcollins1_boot_dry_realization(identity: realization_identity, initial: world, epoch: virtual_clock_origin())
  matrix_frame_over(realization: OperationRealization {
    identity: production.identity,
    initial: production.initial,
    epoch: production.epoch,
    advance: production.advance,
    bindings: concat(xs: filter(production.bindings, b => !(b.at.service == "ssh.Session" && b.at.operation == "Reachability")), ys: [
      OperationBinding {
        at: OperationRef { path: "dag/extdeps/ssh/session.dag", service: "ssh.Session", operation: "Reachability" },
        handler: reset_route_reachability_handler,
      },
    ]),
  })
}

// EXECUTE THE PRODUCTION RESET-RETURN ENTRY IN THIS FRAME. The subject IS the entry; the judge reads
// what the route did, not what a test said it would do.
fn run_reset_route(world: MtCollins1BootWorld, evidence: MegaRacOperationEvidence) -> WitnessEvaluation<ProcessExit, MtCollins1BootWorld> {
  evaluate_in_witness_frame(
    frame: matrix_reset_route_frame(world: world),
    subject: fn(_scope) { host_reset_return_wet(evidence: evidence) },
  )
}

// ─── THE RUNNER AND THE CONTROLLER THE BOOT SEES ────────────────────────────────────────────────
// Two facts of the healthy world exist because the production boot reads them, and the dry
// realization answers each from the world rather than from a constant:
//
// THE JOB-OWNED TEMP DIRECTORY. The census filing reaches srv2 over the fleet-ssh context, whose
// preparation (gunbc.fleet.fleet_known_hosts_anchor materialize_fleet_ssh_multiplex_directory, main
// #14108) reads RUNNER_TEMP, creates the control-socket directory under it owner-only, and reads back
// its mode and owner against RUNNER_TEMP's owner. A CI runner sets RUNNER_TEMP on every job and owns
// it, so the healthy world carries both; the directory's mode and owner are then whatever
// gunbc.filesystem_model's owner-only mkdir records, read back by its stat bindings.
data runner_temp: String = "/tmp/gunbc-ci-runner"
data runner_principal: String = "runner"

data runner_temp_mode: FileMode = FileMode {
  owner: PermissionBits { read: true, write: true, execute: true },
  group: PermissionBits { read: false, write: false, execute: false },
  other: PermissionBits { read: false, write: false, execute: false },
  setuid: false, setgid: false, sticky: false,
}

// THE CONTROLLER'S IPMI SENSOR RECORDS. The boot's post-power-on chassis-fan gate (main #14263) reads
// `sdr type Temperature` and `sdr type Fan` after power-on and before the census watch, and
// post_power_fan_verdict decides. The healthy controller publishes the committed observation of boot
// run 39005709187 (the capture gunbc.machine_intake mtcollins1_fitted_fan_set stands on, and the
// shape test.claim.machine_intake.mtcollins1_boot_fan_gate_witness unit_rows carries): the four fitted
// headers FAN4_0/FAN4_1/FAN5_0/FAN5_1 turning, the two unfitted headers the board prints as No
// Reading, and the temperature rows published -- the reading the verdict ADMITS. The verdict stays
// post_power_fan_verdict's alone; the world only says what the controller publishes. The records are
// static -- no transition ties a reading to chassis power -- which is sound only because the gate reads
// them after power-on and nothing here reads them before it.
fn sdr_record(sensor_type: String, name: String, number: String, status: String, entity: String, reading: String) -> BmcSdrRecord {
  BmcSdrRecord {
    sensor_type: sensor_type as NonEmptyStr,
    line: SdrTypeLine { name: name as NonEmptyStr, sensor_number: number as NonEmptyStr, status: status as NonEmptyStr, entity_id: entity as NonEmptyStr, reading_text: reading as NonEmptyStr },
  }
}

data healthy_temperature_records: List<BmcSdrRecord> = [
  sdr_record(sensor_type: "Temperature", name: "CPU0_Temp", number: "01h", status: "ok", entity: "3.1", reading: "45 degrees C"),
  sdr_record(sensor_type: "Temperature", name: "DIMM_Temp", number: "02h", status: "ok", entity: "3.2", reading: "38 degrees C"),
]

data healthy_fan_records: List<BmcSdrRecord> = [
  sdr_record(sensor_type: "Fan", name: "FAN4_0_Speed", number: "00h", status: "ok", entity: "29.1", reading: "5700 RPM"),
  sdr_record(sensor_type: "Fan", name: "FAN4_1_Speed", number: "01h", status: "ok", entity: "29.1", reading: "5700 RPM"),
  sdr_record(sensor_type: "Fan", name: "FAN5_0_Speed", number: "02h", status: "ok", entity: "29.1", reading: "5700 RPM"),
  sdr_record(sensor_type: "Fan", name: "FAN5_1_Speed", number: "03h", status: "ok", entity: "29.1", reading: "5800 RPM"),
  sdr_record(sensor_type: "Fan", name: "FAN0_0_Speed", number: "04h", status: "ok", entity: "29.1", reading: "No Reading"),
  sdr_record(sensor_type: "Fan", name: "FAN3_1_Speed", number: "05h", status: "ok", entity: "29.1", reading: "No Reading"),
]

// The refused reading: every record the healthy one EXCEPT the first fitted header at 0 RPM -- the
// committed refusal fixture's reading (FittedHeaderZeroRpm) -- with the unfitted headers reporting ns.
data fan_records_first_fitted_header_stopped: List<BmcSdrRecord> = [
  sdr_record(sensor_type: "Fan", name: "FAN4_0_Speed", number: "00h", status: "ok", entity: "29.1", reading: "0 RPM"),
  sdr_record(sensor_type: "Fan", name: "FAN4_1_Speed", number: "01h", status: "ok", entity: "29.1", reading: "5700 RPM"),
  sdr_record(sensor_type: "Fan", name: "FAN5_0_Speed", number: "02h", status: "ok", entity: "29.1", reading: "5700 RPM"),
  sdr_record(sensor_type: "Fan", name: "FAN5_1_Speed", number: "03h", status: "ok", entity: "29.1", reading: "5800 RPM"),
  sdr_record(sensor_type: "Fan", name: "FAN0_0_Speed", number: "04h", status: "ns", entity: "29.1", reading: "No Reading"),
  sdr_record(sensor_type: "Fan", name: "FAN3_1_Speed", number: "05h", status: "ns", entity: "29.1", reading: "No Reading"),
]

fn bmc_publishing(bmc: BmcWorld, fans: List<BmcSdrRecord>) -> BmcWorld {
  bmc_with_record_surfaces(world: bmc, surfaces: BmcRecordSurfaces {
    // Publishing the SDR repository adds it; it does not un-model what the world already answered.
    mc_info: bmc.record_surfaces.mc_info,
    sol_configuration: bmc.record_surfaces.sol_configuration,
    ethernet_interface: bmc.record_surfaces.ethernet_interface,
    boot_options: bmc.record_surfaces.boot_options,
    manager_date_time: bmc.record_surfaces.manager_date_time,
    log_services: bmc.record_surfaces.log_services,
    account_events: bmc.record_surfaces.account_events,
    virtual_media: bmc.record_surfaces.virtual_media,
    sensors: bmc.record_surfaces.sensors,
    ipmi_sdr: Present { value: concat(healthy_temperature_records, fans) },
  })
}

// THE HEALTHY ONE-SOCKET CENSUS WORLD, and the same world with one fitted fan stopped. The boot claims
// here and in test.claim.host.managed_host_boot_witness run the production entry over these through
// run_attempt -- one frame, one realization.
fn healthy_census_world() -> MtCollins1BootWorld {
  world_with_console(lines: console_of(capture: one_socket_census_capture, begin_after: 60, end_after: 240))
}

fn healthy_census_world_with_a_stopped_fan() -> MtCollins1BootWorld {
  let w = healthy_census_world()
  with_bmc(w: w, bmc: bmc_publishing(bmc: w.bmc, fans: fan_records_first_fitted_header_stopped))
}

// ─── THE HEALTHY WORLD, and the facts it is built from ───────────────────────────────────────────
