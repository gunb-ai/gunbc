  ModeledRemoteHost { endpoint: "srv2", files: match mtcollins1_census_image {
    CensusImageDerived { input: input } => [
      ModeledRemoteFile { path: census_record_path(input: input) as String, content: Present { value: concat(selected_digest(), "\n") }, sha256: none },
      ModeledRemoteFile { path: boot_medium_served_path(medium: mtcollins1_census_boot_medium) as String, content: Present { value: "<image bytes>" }, sha256: Present { value: selected_digest() } },
    ]
    _ => []
  } }
}

fn healthy_media() -> MegaRacMediaWorld {
  MegaRacMediaWorld {
    sessions: [], next_session: 1,
    share: MegaRacShare { server: "192.168.1.201", source_path: "/srv/bmc", share_type: "nfs" },
    mount_cd: 1, cd_error_code: 0,
    images: [MegaRacImage { image_name: mtcollins1_census_boot_medium.image_name as String, image_index: 5 }],
    cd: megarac_cleared_cd_at_the_current_build(),
    ready_after: second(count: 12),
    withdraw_at: none,
    withdraw_after_ready: none,
    error_after_ready: none,
    error_clears_on_stop: false, stop_at_ready: none, close_releases: true,
