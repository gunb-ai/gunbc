module test.claim.machine_intake.mtjade1_arrival_principal_witness

import std.logic { Bool }
import std.types { List, NonEmptyStr, String }
import gunbc.machine_intake_arrival_subject {
  arrival_converge_subject_options, admit_arrival_subject, arrival_subject_admission_refuses_before_effect,
  ArrivalSubjectInPopulation, ArrivalSubjectUnknown, ArrivalSubjectIsManagedHostExecutorConfusion,
}
import gunbc.machine_intake_arrival_interlock {
  ArrivalSlotHeld, ArrivalSlotNotHeld,
  admit_arrival_archive_interlock, admit_arrival_bmc_secure_interlock,
  ArrivalArchiveInterlockAdmitted, ArrivalArchiveInterlockRefused,
  ArrivalBmcSecureInterlockAdmitted, ArrivalBmcSecureInterlockRefused,
  arrival_combine_prefix_and_release, arrival_after_acquire,
  ArrivalArchiveSlotReleased, ArrivalArchiveSlotReleaseRefused,
  ArrivalArchiveSlotAcquireRefused,
}
import std.process { ProcessExit, ExitSuccess, ExitFailure }
import std.durable_compare_and_set { cas_generation_first }
import gunbc.machine_intake_bmc_rotation_route { rotation_route_ungrounded }
import extdeps.bmc.endpoint { AmiMegaRac, BmcControllerEndpoint }
import extdeps.bmc.capability { bmc_firmware_release_identity_of_wire }
import gunbc.auth.mtjade1_arrival_pair { mtjade1_arrival_principal_member, mtjade1_arrival_secret_grants }
import gunbc.auth.mtjade1_arrival_federation {
  mtjade1_arrival_archive_effect, mtjade1_arrival_firmware_qualification_effect,
}
import gunbc.auth.authorization_pattern_selection {
  FederatedScopedGrant, OperatorApprovedCapability,
  PatternSelected, AuthorizationPatternSelection,
  InterlockPending, InterlockedBy, UnconditionalStanding,
  select_authorization_pattern,
}
import gunbc.auth.privileged_effect_census { rulings_without_a_rostered_interlock }
import gunbc.machine_intake_arrival_converge { grant_discharges_bmc_secure_account_write }
import gunbc.auth.standing_operator_grant {
  mtjade1_live_standing_grant, standing_grant_covers, standing_grant_arm_interlock, StandingGrantHost,
  StandingJadeArrivalArchive, StandingJadeFirmwareQualification, StandingBmcSecureAccountWrite, StandingD0ReleaseToFleet,
}
import std.decl_ref { declaration_ref_display_key }
import gunbc.fleet_host_identity { operator_host_mtjade1, operator_host_mtcollins1 }

fn selected_federated(s: AuthorizationPatternSelection) -> Bool {
  match s {
    PatternSelected { pattern: FederatedScopedGrant, receipt: _ } => true
    _ => false
  }
}

fn selected_approved(s: AuthorizationPatternSelection) -> Bool {
  match s {
    PatternSelected { pattern: OperatorApprovedCapability, receipt: _ } => true
    _ => false
  }
}

test fn w_arrival_options_are_the_population_projection() -> Bool {
  arrival_converge_subject_options() == ["mtjade1"]
}

test fn w_mtjade1_is_admitted_and_mtcollins1_and_outsiders_refuse_before_effect() -> Bool {
  match admit_arrival_subject(wire: "mtjade1") {
    ArrivalSubjectInPopulation { subject: s } => (s.wire as String) == "mtjade1"
    _ => false
  }
    && match admit_arrival_subject(wire: operator_host_mtcollins1 as String) {
      ArrivalSubjectIsManagedHostExecutorConfusion { wire: _ } => true
      _ => false
    }
    && match admit_arrival_subject(wire: "not-a-unit") {
      ArrivalSubjectUnknown { wire: w } => w == "not-a-unit"
      _ => false
    }
    && arrival_subject_admission_refuses_before_effect(admission: admit_arrival_subject(wire: "not-a-unit"))
    && arrival_subject_admission_refuses_before_effect(admission: admit_arrival_subject(wire: operator_host_mtcollins1 as String))
    && !arrival_subject_admission_refuses_before_effect(admission: admit_arrival_subject(wire: "mtjade1"))
}

test fn w_grant_covers_arrival_arms_on_mtjade1_only() -> Bool {
  standing_grant_covers(g: mtjade1_live_standing_grant, scope: StandingGrantHost { host: operator_host_mtjade1 }, effect: StandingJadeArrivalArchive)
    && standing_grant_covers(g: mtjade1_live_standing_grant, scope: StandingGrantHost { host: operator_host_mtjade1 }, effect: StandingJadeFirmwareQualification)
    && standing_grant_covers(g: mtjade1_live_standing_grant, scope: StandingGrantHost { host: operator_host_mtjade1 }, effect: StandingBmcSecureAccountWrite)
    && grant_discharges_bmc_secure_account_write(g: mtjade1_live_standing_grant, host: operator_host_mtjade1)
    && !grant_discharges_bmc_secure_account_write(g: mtjade1_live_standing_grant, host: operator_host_mtcollins1)
    && !standing_grant_covers(g: mtjade1_live_standing_grant, scope: StandingGrantHost { host: operator_host_mtcollins1 }, effect: StandingBmcSecureAccountWrite)
    && !standing_grant_covers(g: mtjade1_live_standing_grant, scope: StandingGrantHost { host: operator_host_mtjade1 }, effect: StandingD0ReleaseToFleet)
}

test fn w_ungrounded_route_refuses_bmc_secure_interlock() -> Bool {
  match admit_arrival_subject(wire: "mtjade1") {
    ArrivalSubjectInPopulation { subject: s } =>
      match admit_arrival_archive_interlock(subject: s, slot: ArrivalSlotNotHeld { cause: "slot free" as NonEmptyStr }) {
        ArrivalArchiveInterlockRefused { cause: _ } =>
          match admit_arrival_bmc_secure_interlock(
            subject: s,
            slot: ArrivalSlotHeld { subject: s },
            route: rotation_route_ungrounded(
              endpoint: BmcControllerEndpoint { host: "192.168.1.246" },
              firmware: bmc_firmware_release_identity_of_wire(family: AmiMegaRac, wire: "2.11.104000" as NonEmptyStr),
            ),
          ) {
            ArrivalBmcSecureInterlockRefused { cause: _ } => true
            ArrivalBmcSecureInterlockAdmitted { subject: _ } => false
          }
        ArrivalArchiveInterlockAdmitted { subject: _ } => false
      }
    _ => false
  }
}

test fn w_release_failure_after_success_is_visible() -> Bool {
  match arrival_combine_prefix_and_release(
    prefix: ExitSuccess,
    slot: ArrivalArchiveSlotReleaseRefused { cause: "arrival slot release was not eligible" as NonEmptyStr },
  ) {
    ExitSuccess => false
    ExitFailure { code: _, reason: r } => string_contains(s: r, pattern: "slot release refused")
  }
}

test fn w_release_failure_after_prefix_failure_is_concatenated() -> Bool {
  match arrival_combine_prefix_and_release(
    prefix: ExitFailure { code: 2, reason: "prefix refused" },
    slot: ArrivalArchiveSlotReleaseRefused { cause: "arrival slot release was not eligible" as NonEmptyStr },
  ) {
    ExitSuccess => false
    ExitFailure { code: c, reason: r } =>
      c == 2 && string_contains(s: r, pattern: "prefix refused") && string_contains(s: r, pattern: "slot release refused")
  }
}

fn body_that_runs_marks_exit() -> ProcessExit {
  ExitFailure { code: 9, reason: "BODY_RAN" }
}

test fn w_failed_acquire_runs_no_body() -> Bool {
  match arrival_after_acquire(
    outcome: ArrivalArchiveSlotAcquireRefused { cause: "slot occupied" as NonEmptyStr },
    body: fn() { body_that_runs_marks_exit() },
  ) {
    ExitSuccess => false
    ExitFailure { code: _, reason: r } =>
      string_contains(s: r, pattern: "slot occupied") && !string_contains(s: r, pattern: "BODY_RAN")
  }
}

test fn w_successful_release_keeps_the_prefix() -> Bool {
  match arrival_combine_prefix_and_release(
    prefix: ExitSuccess,
    slot: ArrivalArchiveSlotReleased { generation: cas_generation_first() },
  ) {
    ExitSuccess => true
    ExitFailure { code: _, reason: _ } => false
  }
}

test fn w_bound_principal_selects_federated_scoped_grant() -> Bool {
  selected_federated(s: select_authorization_pattern(e: mtjade1_arrival_archive_effect()))
    && selected_approved(s: select_authorization_pattern(e: mtjade1_arrival_firmware_qualification_effect()))
    && !selected_federated(s: select_authorization_pattern(e: mtjade1_arrival_firmware_qualification_effect()))
    && !selected_approved(s: select_authorization_pattern(e: mtjade1_arrival_archive_effect()))
    && mtjade1_arrival_principal_member() == "serviceAccount:mtjade1-arrival@gunbai-secrets.iam.gserviceaccount.com"
    && mtjade1_arrival_secret_grants().length() == 1
    && rulings_without_a_rostered_interlock().length() == 1
    && match rulings_without_a_rostered_interlock().first() {
      Present { value: s } =>
        declaration_ref_display_key(ref: s) == "gunbc.auth.mtjade1_arrival_federation::mtjade1_arrival_firmware_qualification_effect"
      Absent => false
    }
    && match standing_grant_arm_interlock(g: mtjade1_live_standing_grant, e: StandingJadeFirmwareQualification) {
      InterlockPending { obligation: _ } => true
      InterlockedBy { hold: _ } => false
      UnconditionalStanding { reason: _ } => false
    }
    && match standing_grant_arm_interlock(g: mtjade1_live_standing_grant, e: StandingBmcSecureAccountWrite) {
      InterlockedBy { hold: h } => (h.decl_name as String) == "admit_rotation_apply"
      InterlockPending { obligation: _ } => false
      UnconditionalStanding { reason: _ } => false
    }
}
