module test.claim.machine_intake.mtcollins1_census_medium_readback_witness

import gunbc.machine_intake.mtcollins1_boot_milestone { mtcollins1_census_stages, mtcollins1_one_socket_workload, mtcollins1_dual_socket_workload }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.types { Bool, Int, NonEmptyStr, String }
import gunbc.host.boot_medium { BootImageExport, BootMedium, BootMediumVolumeLabel, stock_installer_boot_medium, bmc_boot_image_export, boot_image_export_eq }
import gunbc.fleet.fleet_known_hosts_anchor { SshTarget, ssh_target_wire }
import extdeps.network.endpoint { SocketAddress, socket_address, host_by_name }
import extdeps.dns.domain_name { DnsLabel, HostName, DomainName, PartiallyQualified }
import gunbc.machine_intake.mtcollins1_census_image { census_boot_medium,
  census_capture_program,
  census_image_derivation,
  mtcollins1_census_image, CensusImage, CensusImageDerived, CensusImageRefused,
  mtcollins1_census_console_device, mtcollins1_census_grub_cmdline, mtcollins1_census_halt_command,
  mtcollins1_census_image_stem, mtcollins1_census_machine, mtcollins1_census_nocloud_dir,
  mtcollins1_census_program_file, mtcollins1_census_volume_id, census_seeded_image_input,
  census_medium_qualification, CensusMediumQualified, CensusMediumNotCensus,
}
import extdeps.provisioning.ubuntu_seeded_install_media { UbuntuSeededInstallMediaBuildInput, ubuntu_seeded_install_media_image_name }
import gunbc.machine_intake.mtcollins1_census_medium_readback {
  CensusMediumReadback, CensusMediumReadbackAgreed, CensusMediumReadbackDiverged, CensusMediumReadbackNotCensus, CensusMediumReadbackExporterUnsupported,
  census_medium_readback,
  CensusMediumReadbackRecordUnreadable, CensusMediumReadbackRecordMalformed, CensusMediumReadbackRecordDisagrees,
  CensusMediumReadbackImageUnreadable, CensusMediumReadbackMeasureMalformed,
  RemoteAnswer, census_medium_readback_from_answers, census_readback_refusal,
  census_readback_refusal_before_filing, census_readback_refusal_before_attach,
  CensusRecordAdmitted, CensusRecordRefused, census_record_standing,
  census_record_argv, census_readback_argv,
  census_medium_served_path, census_record_path, census_build_key,
  remote_answer_of,
}
import gunbc.typed_argv_exec { TypedArgvExecConverged, TypedArgvExecRefused }
import extdeps.ssh.session { SshSessionExecResult }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data recorded: NonEmptyStr = "30ca88d43f8913995078f6c2c917d5049842f927f3fc886a103f460dd146a706"
data other: String = "2ee2163c9b901ff5926400e80759088ff3b879982a3956c02100495b489fd555"
// 64 characters, not hexadecimal: the RED that separates "64 long" from "a digest".
data sixty_four_non_hex: String = "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
data census: BootMedium = census_boot_medium(image_stem: mtcollins1_census_image_stem, volume_id: mtcollins1_census_volume_id, output_digest: recorded)
data srv2: NonEmptyStr = "srv2"

// THE SAME CENSUS MEDIUM -- genuine name, digest, directory and label -- NAMING ANOTHER EXPORTER. Only the
// export's SSH target differs: another endpoint, or another principal at the supported endpoint. Its
// bytes live on an exporter these readers never read, so a successful readback from the supported one
// would answer for bytes the medium did not name (side-chat review at cad3011782).
// Another exporter host, by name, at the standard port.
fn other_exporter_address() -> SocketAddress {
  socket_address(host: host_by_name(name: HostName { name: DomainName { labels: ["fixture-other-exporter" as DnsLabel] }, qualification: PartiallyQualified }), port: 22)
}

fn census_at(address: SocketAddress, principal: String) -> BootMedium {
  BootMedium {
    image_name: census.image_name,
    digest: census.digest,
    export: BootImageExport { target: SshTarget { address: address, principal: principal as NonEmptyStr }, dir: census.export.dir },
    terminal: census.terminal,
  }
}

fn census_at_other_endpoint() -> BootMedium {
  census_at(address: other_exporter_address(), principal: census.export.target.principal as String)
}

fn census_as_other_principal() -> BootMedium {
  census_at(address: census.export.target.address, principal: "fixture-other-principal")
}

fn ok(stdout: String) -> RemoteAnswer { RemoteAnswer { exit_code: 0, stdout: stdout, stderr: "" } }
fn failed(code: Int, stderr: String) -> RemoteAnswer { RemoteAnswer { exit_code: code, stdout: "", stderr: stderr } }
// The refused leg is DERIVED through the producer's adapter, not restated (review 69507).
fn refused(reason: String) -> RemoteAnswer { remote_answer_of(outcome: TypedArgvExecRefused { reason: reason }) }
// A SUPPLIED build input for the record-stage fold: the fold is over the record answer, and needs an
// input only to name the record path; the real derivation is read by the chain claim above.
fn census_input() -> UbuntuSeededInstallMediaBuildInput {
  census_seeded_image_input(
    image_stem: mtcollins1_census_image_stem,
    volume_id: mtcollins1_census_volume_id,
    user_data_body: "#cloud-config\nautoinstall:\n  version: 1\n" as NonEmptyStr,
    grub_kernel_cmdline: mtcollins1_census_grub_cmdline,
    nocloud_dir: mtcollins1_census_nocloud_dir,
    program_file: mtcollins1_census_program_file,
    program_content: census_capture_program(machine: mtcollins1_census_machine, console_device: mtcollins1_census_console_device, halt_command: mtcollins1_census_halt_command, stages: mtcollins1_census_stages),
  )
}
fn record_ok() -> RemoteAnswer { ok(stdout: concat(recorded as String, "\n")) }
fn measure_ok() -> RemoteAnswer { ok(stdout: concat(recorded as String, "  /srv/bmc/x.iso\n")) }

// THE CHAIN DERIVES FROM ONE INPUT: the served path from the digest through the image stem, the
// record path from the build key through the same stem, the build key from the census inputs.
test fn the_served_path_and_the_record_path_derive_from_the_census_input() -> Bool {
  match mtcollins1_census_image {
    CensusImageRefused { reason: _ } => false
    CensusImageDerived { input: input } =>
      (census_medium_served_path(medium: census) as String) == "/srv/bmc/gunbc-mtcollins1-census-ubuntu-24.04.3-arm64-30ca88d43f891399.iso"
        && (census_record_path(input: input) as String) == concat("/srv/bmc/.gunbc-mtcollins1-census-ubuntu-24.04.3-arm64.", census_build_key(input: input) as String, ".built")
        && (census_build_key(input: input) as String) == "c001ac127d718e72"
  }
}

test fn a_record_and_a_file_that_both_repeat_the_selected_digest_agree_and_retain_every_value() -> Bool {
  match census_medium_readback_from_answers(medium: census, host: srv2, image: mtcollins1_census_image, record: record_ok(), measure: measure_ok()) {
    CensusMediumReadbackAgreed { host: h, build_key: k, recorded_digest: r, image_name: n, served_path: p, measured_digest: m } =>
      (h as String) == "srv2" && (k as String) == "c001ac127d718e72" && (r as String) == (recorded as String) && (m as String) == (recorded as String)
        && (n as String) == "gunbc-mtcollins1-census-ubuntu-24.04.3-arm64-30ca88d43f891399.iso"
        && (p as String) == "/srv/bmc/gunbc-mtcollins1-census-ubuntu-24.04.3-arm64-30ca88d43f891399.iso"
    _ => false
  }
}

// THE DISCRIMINATING REDS, one per link of the chain.
// The record stage is a fold over the record ALONE -- no measurement in its signature -- and the
// producer runs sha256sum only inside its admitted arm, so refusing here is refusing before the
// multi-gigabyte image is consulted on the executing route, not only in a composed fold.
test fn an_unreadable_record_refuses_before_the_file_is_consulted() -> Bool {
  (match census_record_standing(medium: census, host: srv2, input: census_input(), record: failed(code: 1, stderr: "cat: No such file or directory")) {
    CensusRecordRefused { readback: CensusMediumReadbackRecordUnreadable { host: _, record_path: _, reason: why } } => string_contains(s: why, pattern: "exit=1")
    _ => false
  })
    && (match census_record_standing(medium: census, host: srv2, input: census_input(), record: record_ok()) {
      CensusRecordAdmitted { recorded: r } => (r as String) == (recorded as String)
      _ => false
    })
    && (match census_medium_readback_from_answers(medium: census, host: srv2, image: mtcollins1_census_image, record: failed(code: 1, stderr: "cat: No such file or directory"), measure: measure_ok()) {
      CensusMediumReadbackRecordUnreadable { host: _, record_path: _, reason: why } => string_contains(s: why, pattern: "exit=1")
      _ => false
    })
}

// SIXTY-FOUR NON-HEX CHARACTERS ARE MALFORMED, NEVER AN ACCUSATION: neither RecordDisagrees nor
// Diverged may be minted over text that is not a digest. And a record is consumed whole, as
// resolve_seeded_image consumes it: the selected digest followed by anything is malformed.
test fn sixty_four_non_hex_characters_are_malformed_in_the_record_and_from_sha256sum() -> Bool {
  (match census_medium_readback_from_answers(medium: census, host: srv2, image: mtcollins1_census_image, record: ok(stdout: concat(sixty_four_non_hex, "\n")), measure: measure_ok()) {
    CensusMediumReadbackRecordMalformed { record_path: _, content: c } => c == sixty_four_non_hex
    _ => false
  })
    && (match census_medium_readback_from_answers(medium: census, host: srv2, image: mtcollins1_census_image, record: record_ok(), measure: ok(stdout: concat(sixty_four_non_hex, "  /srv/bmc/x.iso\n"))) {
      CensusMediumReadbackMeasureMalformed { served_path: _, content: _ } => true
      _ => false
    })
    && (match census_medium_readback_from_answers(medium: census, host: srv2, image: mtcollins1_census_image, record: ok(stdout: concat(recorded as String, " trailing-junk\n")), measure: measure_ok()) {
      CensusMediumReadbackRecordMalformed { record_path: _, content: _ } => true
      _ => false
    })
    && (match census_medium_readback_from_answers(medium: census, host: srv2, image: mtcollins1_census_image, record: ok(stdout: concat("  ", recorded as String, "\n\n")), measure: measure_ok()) {
      CensusMediumReadbackAgreed { host: _, build_key: _, recorded_digest: _, image_name: _, served_path: _, measured_digest: _ } => true
      _ => false
    })
}

// The legs are the coreutils and crypto authorities' own commands, `--` included.
test fn the_two_legs_are_the_upstream_commands_not_local_spellings() -> Bool {
  census_record_argv(record_path: "/srv/bmc/r" as NonEmptyStr) == ["cat", "/srv/bmc/r"]
    && census_readback_argv(path: "/srv/bmc/x.iso" as NonEmptyStr) == ["sha256sum", "--", "/srv/bmc/x.iso"]
}

test fn a_malformed_record_is_malformed_not_diverged() -> Bool {
  match census_medium_readback_from_answers(medium: census, host: srv2, image: mtcollins1_census_image, record: ok(stdout: "not a digest\n"), measure: measure_ok()) {
    CensusMediumReadbackRecordMalformed { record_path: _, content: _ } => true
    _ => false
  }
}

test fn a_record_naming_other_bytes_than_the_medium_row_disagrees_even_when_the_file_matches_the_record() -> Bool {
  match census_medium_readback_from_answers(medium: census, host: srv2, image: mtcollins1_census_image, record: ok(stdout: concat(other, "\n")), measure: ok(stdout: concat(other, "  /srv/bmc/x.iso\n"))) {
    CensusMediumReadbackRecordDisagrees { record_path: _, recorded: r, selected: sel } => (r as String) == other && (sel as String) == (recorded as String)
    _ => false
  }
}

test fn a_missing_image_is_unreadable_not_diverged() -> Bool {
  match census_medium_readback_from_answers(medium: census, host: srv2, image: mtcollins1_census_image, record: record_ok(), measure: failed(code: 1, stderr: "sha256sum: No such file")) {
    CensusMediumReadbackImageUnreadable { host: _, served_path: _, reason: why } => string_contains(s: why, pattern: "No such file")
    _ => false
  }
}

test fn a_truncated_measurement_is_malformed_not_agreed() -> Bool {
  match census_medium_readback_from_answers(medium: census, host: srv2, image: mtcollins1_census_image, record: record_ok(), measure: ok(stdout: "30ca88d43f891399  /srv/bmc/x.iso\n")) {
    CensusMediumReadbackMeasureMalformed { served_path: _, content: _ } => true
    _ => false
  }
}

test fn a_file_whose_bytes_differ_from_the_record_diverges() -> Bool {
  match census_medium_readback_from_answers(medium: census, host: srv2, image: mtcollins1_census_image, record: record_ok(), measure: ok(stdout: concat(other, "  /srv/bmc/x.iso\n"))) {
    CensusMediumReadbackDiverged { served_path: _, recorded: r, measured: m } => (r as String) == (recorded as String) && (m as String) == other
    _ => false
  }
}

test fn the_stock_medium_has_no_census_readback() -> Bool {
  match census_medium_readback_from_answers(medium: stock_installer_boot_medium, host: srv2, image: mtcollins1_census_image, record: record_ok(), measure: measure_ok()) {
    CensusMediumReadbackNotCensus => true
    _ => false
  }
}

// ONLY AGREEMENT PASSES THE GATE; every other arm refuses naming its link and leaves the controller
// untouched.
test fn only_an_agreed_readback_lets_the_boot_proceed() -> Bool {
  let agreed = census_medium_readback_from_answers(medium: census, host: srv2, image: mtcollins1_census_image, record: record_ok(), measure: measure_ok())
  let diverged = census_medium_readback_from_answers(medium: census, host: srv2, image: mtcollins1_census_image, record: record_ok(), measure: ok(stdout: concat(other, "  x\n")))
  let disagrees = census_medium_readback_from_answers(medium: census, host: srv2, image: mtcollins1_census_image, record: ok(stdout: concat(other, "\n")), measure: measure_ok())
  let unreadable = census_medium_readback_from_answers(medium: census, host: srv2, image: mtcollins1_census_image, record: refused(reason: "ssh: connect refused"), measure: measure_ok())
  (match census_readback_refusal(subject: mtcollins1_census_machine, readback: agreed) { Absent => true  Present { value: _ } => false })
    && (match census_readback_refusal(subject: mtcollins1_census_machine, readback: diverged) { Present { value: w } => !string_contains(s: w, pattern: "untouched") && string_contains(s: w, pattern: recorded as String) && string_contains(s: w, pattern: other as String)  Absent => false })
    && (match census_readback_refusal_before_filing(subject: mtcollins1_census_machine, readback: diverged) { Present { value: w } => string_contains(s: w, pattern: "controller untouched") && !string_contains(s: w, pattern: "SOL")  Absent => false })
    && (match census_readback_refusal_before_attach(subject: mtcollins1_census_machine, readback: diverged) { Present { value: w } => string_contains(s: w, pattern: "after grant, before attach") && string_contains(s: w, pattern: "media attach, boot selection and power untouched") && string_contains(s: w, pattern: "SOL session had been acquired") && !string_contains(s: w, pattern: "controller untouched")  Absent => false })
    && (match census_readback_refusal_before_attach(subject: mtcollins1_census_machine, readback: agreed) { Absent => true  Present { value: _ } => false })
    && (match census_readback_refusal(subject: mtcollins1_census_machine, readback: disagrees) { Present { value: w } => string_contains(s: w, pattern: "does not describe the current derivation")  Absent => false })
    && (match census_readback_refusal(subject: mtcollins1_census_machine, readback: unreadable) { Present { value: w } => string_contains(s: w, pattern: "connect refused")  Absent => false })
    && (match census_readback_refusal(subject: mtcollins1_census_machine, readback: CensusMediumReadbackNotCensus) { Present { value: _ } => true  Absent => false })
}

// THE REFUSAL NAMES THE SUBJECT IT IS GIVEN AND THE HOST ITS RECEIPT RECORDED. Every claim above
// passes mtcollins1's machine label and srv2's receipts, so a renderer that ignored its subject
// parameter and hardcoded the mtcollins1 name -- or that ignored the receipt host and hardcoded srv2
// -- would stay green. This claim is the discriminating control for that contract: a SECOND subject's
// label must appear in the text (and the mtcollins1 label must not), and a NON-srv2 receipt host must
// appear in the rendered text (and srv2 must not). Pure: it renders a constructed readback, so a
// renderer that drops the parameters goes RED here (DESIGN 5 -- green by execution plus a
// discriminating input).
test fn control_c_refusal_names_the_subject_and_the_host_its_receipt_recorded() -> Bool {
  // A not-census refusal for the SECOND subject: the subject is a parameter, so the text names the
  // second subject, not mtcollins1.
  let second_not_census = match census_readback_refusal(subject: second_subject_stem, readback: CensusMediumReadbackNotCensus) {
    Present { value: w } => w
    Absent => "" as String
  }
  let second_unreadable = CensusMediumReadbackRecordUnreadable { host: "census2-exporter", record_path: "/srv/census2/record.txt", reason: "ssh: connect refused" }
  let second_record_refusal = match census_readback_refusal(subject: second_subject_stem, readback: second_unreadable) {
    Present { value: w } => w
    Absent => "" as String
  }
  let mtcollins1_not_census = match census_readback_refusal(subject: mtcollins1_census_machine, readback: CensusMediumReadbackNotCensus) {
    Present { value: w } => w
    Absent => "" as String
  }
  let mtcollins1_unreadable = CensusMediumReadbackRecordUnreadable { host: srv2, record_path: "/srv/census/record.txt", reason: "ssh: connect refused" }
  let mtcollins1_record_refusal = match census_readback_refusal(subject: mtcollins1_census_machine, readback: mtcollins1_unreadable) {
    Present { value: w } => w
    Absent => "" as String
  }
  // The second subject's label names its refusal and the mtcollins1 label does not; and the
  // mtcollins1 label names ITS refusal and the second label does not. (Subject is a parameter, not a
  // spelling.)
  string_contains(s: second_not_census, pattern: second_subject_stem as String)
    && !string_contains(s: second_not_census, pattern: mtcollins1_census_machine as String)
    && string_contains(s: mtcollins1_not_census, pattern: mtcollins1_census_machine as String)
    && !string_contains(s: mtcollins1_not_census, pattern: second_subject_stem as String)
    // The receipt host names its refusal and srv2 does not (and vice versa) on the record-unreadable
    // arm, so the host is the receipt's, not a parameter the renderer invents.
    && string_contains(s: second_record_refusal, pattern: "census2-exporter")
    && !string_contains(s: second_record_refusal, pattern: srv2 as String)
    && string_contains(s: mtcollins1_record_refusal, pattern: srv2 as String)
    && !string_contains(s: mtcollins1_record_refusal, pattern: "census2-exporter")
}

// INHABITANCE OF THE ADAPTER (DESIGN §3, the pairing obligation): remote_answer_of is the one seam
// between typed_argv_exec_over_fleet_ssh and the RemoteAnswer every claim above supplies. Both
// arms execute here, so a swapped stdout/stderr or a wrong refusal code is red in this claim
// rather than green everywhere while the real route mislabels a divergence.
test fn remote_answer_of_carries_a_converged_result_field_for_field_and_a_refusal_as_exit_255() -> Bool {
  let converged = remote_answer_of(outcome: TypedArgvExecConverged {
    result: SshSessionExecResult { exit_code: 3, success: false, stdout: "out-text", stderr: "err-text" },
  })
  let refusal = remote_answer_of(outcome: TypedArgvExecRefused { reason: "witness: transport refused" })
  converged.exit_code == 3 && converged.stdout == "out-text" && converged.stderr == "err-text"
    && refusal.exit_code == 255 && refusal.stdout == "" && refusal.stderr == "witness: transport refused"
    && (match census_medium_readback_from_answers(medium: census, host: srv2, image: mtcollins1_census_image, record: record_ok(), measure: refusal) {
      CensusMediumReadbackImageUnreadable { host: _, served_path: _, reason: why } => string_contains(s: why, pattern: "exit=255") && string_contains(s: why, pattern: "transport refused")
      _ => false
    })
}

fn exporter_unsupported_naming(r: CensusMediumReadback, endpoint: String, principal: String) -> Bool {
  match r {
    CensusMediumReadbackExporterUnsupported { supported: sup, named: n } =>
      (ssh_target_wire(target: n.target) as String) == endpoint && (n.target.principal as String) == principal
        && (ssh_target_wire(target: sup.target) as String) == (ssh_target_wire(target: census.export.target) as String)
        && (sup.target.principal as String) == (census.export.target.principal as String)
    _ => false
  }
}

// RED: ANOTHER ENDPOINT. The record and the image answer exactly as the supported exporter would, and
// the readback still refuses, because those answers are not from the exporter the medium names. The
// production entry refuses before any leg is dispatched (no SSH context is prepared), so this executes
// the real route; the answers composition shows the healthy answers cannot buy agreement.
test fn a_census_medium_naming_another_exporter_endpoint_is_refused_not_read_back() -> Bool {
  let m = census_at_other_endpoint()
  exporter_unsupported_naming(r: census_medium_readback(attempt: "mtcollins1-census-readback", medium: m, image: mtcollins1_census_image), endpoint: "fixture-other-exporter", principal: census.export.target.principal as String)
    && (match census_readback_refusal_before_filing(subject: mtcollins1_census_machine, readback: census_medium_readback(attempt: "mtcollins1-census-readback", medium: m, image: mtcollins1_census_image)) { Present { value: w } => string_contains(s: w, pattern: "fixture-other-exporter") && string_contains(s: w, pattern: "controller untouched")  Absent => false })
}

// RED: ANOTHER PRINCIPAL AT THE SAME ENDPOINT. The same host reached as another account is another
// export (the account decides what may be read and written), so it is refused the same way.
test fn a_census_medium_naming_another_principal_at_the_same_endpoint_is_refused_not_read_back() -> Bool {
  let m = census_as_other_principal()
  exporter_unsupported_naming(r: census_medium_readback(attempt: "mtcollins1-census-readback", medium: m, image: mtcollins1_census_image), endpoint: ssh_target_wire(target: census.export.target) as String, principal: "fixture-other-principal")
}

// THE SAME TWO REDS OVER THE PURE COMPOSITION: the record and the image answer exactly as the supported
// exporter would, and the readback still refuses for both changed exporters. These carry no effect, so
// they discriminate on the qualification alone (the production-entry claims above additionally pin
// that no leg is dispatched).
test fn healthy_answers_cannot_buy_agreement_for_a_medium_naming_another_exporter() -> Bool {
  exporter_unsupported_naming(r: census_medium_readback_from_answers(medium: census_at_other_endpoint(), host: srv2, image: mtcollins1_census_image, record: record_ok(), measure: measure_ok()), endpoint: "fixture-other-exporter", principal: census.export.target.principal as String)
    && exporter_unsupported_naming(r: census_medium_readback_from_answers(medium: census_as_other_principal(), host: srv2, image: mtcollins1_census_image, record: record_ok(), measure: measure_ok()), endpoint: ssh_target_wire(target: census.export.target) as String, principal: "fixture-other-principal")
}

// CONTROL: THE UNCHANGED EXPORT IS ADMITTED. The same constructor with the supported endpoint and
// principal reproduces the census medium, and the same answers agree -- so the two reds above are the
// exporter, not the helper.
test fn the_census_medium_at_its_supported_export_is_admitted_and_agrees() -> Bool {
  let m = census_at(address: census.export.target.address, principal: census.export.target.principal as String)
  match census_medium_readback_from_answers(medium: m, host: srv2, image: mtcollins1_census_image, record: record_ok(), measure: measure_ok()) {
    CensusMediumReadbackAgreed { host: _, build_key: _, recorded_digest: r, image_name: _, served_path: _, measured_digest: d } => (r as String) == (recorded as String) && (d as String) == (recorded as String)
    _ => false
  }
}

// =============================================================================
// DISCRIMINATING CONTROLS (review #80603 / manager msg 3fb13889). These test the
// GENERALIZATION itself on a constructed SECOND subject (supplied values, not
// mtcollins1's rows): (a) a non-mtcollins1 subject derives its own image and
// medium plan (its own stem and digest); (b) a medium whose stem does not match
// the image it is read back for refuses at census_medium_qualification before
// any leg. Both are executed, pure, and leg-free: (b)'s refusal is decided by
// census_medium_qualification inside the producer before it ever prepares an
// SSH agent context, so the test never touches a controller.
// =============================================================================

// The second subject's supplied facts. Deliberately NOT mtcollins1's: a distinct
// stem, a distinct volume id, and a distinct derivation-record digest. The build
// key is derived from the build input (stem + volume + seeds + dates), so the
// same digest over a different stem gives a different build key.
data second_subject_stem: NonEmptyStr = "gunbc-census2-ubuntu-24.04.3-arm64"
data second_subject_volume_id: NonEmptyStr = "GUNBC_CENSUS2_2404_3"
data second_subject_digest: NonEmptyStr = "9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08"
data second_subject_image_name: NonEmptyStr = ubuntu_seeded_install_media_image_name(image_stem: second_subject_stem, output_digest: second_subject_digest)
// The mtcollins1 build key the chain claim above asserts (a second subject MUST differ from it).
data mtcollins1_census_build_key: NonEmptyStr = "c001ac127d718e72"

// The second subject's medium: a genuine name, digest and directory derived from
// its OWN stem, with the matching volume label and the supported export.
fn second_subject_medium() -> BootMedium {
  census_boot_medium(image_stem: second_subject_stem, volume_id: second_subject_volume_id, output_digest: second_subject_digest)
}

// The second subject's image: the REAL derivation applied to its own facts. Its stem and volume id
// name the artifact, so the derived input carries the second stem -- and hence a build key and an
// image name that differ from mtcollins1's -- through the same code path the mtcollins1 row uses.
// (Routed through census_image_derivation, not a hand-built CensusImageDerived, so a derivation that
// ignored image_stem and hardcoded the mtcollins1 constants would go RED here -- DESIGN 5: a real
// consumer green by execution plus a discriminating input.)
fn second_subject_image() -> CensusImage {
  census_image_derivation(
    stages: mtcollins1_census_stages,
    machine: second_subject_stem,
    console_device: mtcollins1_census_console_device,
    halt_command: mtcollins1_census_halt_command,
    image_stem: second_subject_stem,
    volume_id: second_subject_volume_id,
    grub_kernel_cmdline: mtcollins1_census_grub_cmdline,
    nocloud_dir: mtcollins1_census_nocloud_dir,
    program_file: mtcollins1_census_program_file,
  )
}

// CONTROL (a): A NON-MTCOLLINS1 SUBJECT DERIVES ITS OWN IMAGE AND MEDIUM PLAN.
// Its medium and image agree (qualification admits), and the plan it derives is
// mtcollins1's own -- its own stem, its own digest, and a build key distinct from
// mtcollins1's -- so the generalization is what is tested, not a re-read of the
// mtcollins1 row. Pure: no leg, no effect.
test fn control_a_non_mtcollins1_subject_derives_its_own_image_and_medium_plan() -> Bool {
  let m = second_subject_medium()
  let img = second_subject_image()
  match img {
    CensusImageDerived { input: input } =>
      match census_medium_qualification(image_stem: input.image_stem, volume_id: input.volume_id, medium: m) {
        CensusMediumQualified { digest: _, export: _ } =>
          (m.image_name as String) == (second_subject_image_name as String)
          && (input.image_stem as String) == (second_subject_stem as String)
          && (m.digest as String) == (second_subject_digest as String)
          && (second_subject_image_name as String) != (census.image_name as String)
          && (input.image_stem as String) != (mtcollins1_census_image_stem as String)
          && (m.digest as String) != (recorded as String)
          && (census_build_key(input: input) as String) != (mtcollins1_census_build_key as String)
        _ => false
      }
    _ => false
  }
}

// CONTROL (b): A MEDIUM WHOSE STEM DOES NOT MATCH ITS IMAGE REFUSES. The mtcollins1
// image is read back for a medium whose name (and hence stem) is the SECOND subject's,
// with the matching volume label and the supported export. The only thing wrong is the
// stem: the producer's census_medium_qualification sees the medium's image_name does not
// equal the image it was asked to read back for, and refuses with
// CensusMediumReadbackNotCensus BEFORE it prepares any SSH agent context or runs a leg.
// This is the control the PR title promises: a mismatched binding refuses before any
// effect, and the refusal names the SUBJECT and EXECUTOR, not one baked-in host.
test fn control_b_medium_whose_stem_does_not_match_its_image_refuses_before_any_effect() -> Bool {
  // A medium carrying the SECOND subject's stem+digest but labelled with mtcollins1's
  // volume id and export -- the caller is asking to read the mtcollins1 image back for
  // bytes that were derived from a different stem. The name disagrees; that is the fault.
  let wrong_stem_medium = BootMedium {
    image_name: second_subject_image_name,
    digest: second_subject_digest,
    export: bmc_boot_image_export,
    terminal: BootMediumVolumeLabel { label: mtcollins1_census_volume_id },
  }
  match census_medium_readback(medium: wrong_stem_medium, image: mtcollins1_census_image, attempt: "census2-readback") {
    CensusMediumReadbackNotCensus => true
    _ => false
  }
}
