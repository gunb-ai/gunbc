module test.claim.machine_intake.mtcollins1_boot_phase_timing_witness_test

import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.types { Bool, Int, List, String }
import std.nat { Nat }
import std.measure { millisecond, millisecond_count, measure_sub, MeasureDifference, MeasureSubtrahendExceedsMinuend }
import v2.std.optional { Present, Absent }
import v2.std.algebra { filter, skip }
import extdeps.linux.proc_uptime { ProcUptimeRead, UptimeObserved, UptimeRefused, proc_uptime_parse, proc_uptime_read }
import gunbc.machine_intake_oob_boot_handoff { PoweredOn, PowerCycled }
import gunbc.machine_intake_mtcollins1_smpro_observation { SmproProbeRaw, smpro_probe_outcome }
import extdeps.ampere.smpro_register { smpro_bootstage_reg }
import gunbc.machine_intake_mtcollins1_boot_phase_timing {
  MtCollins1BootPhaseTiming, MtCollins1BootPhaseSpan, PhaseRan, PhaseNotRan, BootStartCold, BootStartWarm,
  PhaseVerified, PhaseRefused, MtCollins1BootPhaseReadings, MtCollins1BootPhaseResults,
  PhaseHandoff,
  mtcollins1_boot_phase_spans, mtcollins1_boot_phase_timing_sol_refused,
  mtcollins1_boot_phase_duration, PhaseElapsed, PhaseClockUnread, PhaseClockSteppedBack,
  mtcollins1_smpro_pass_result,
  mtcollins1_boot_start_of, mtcollins1_boot_phase_timing_text, mtcollins1_boot_phase_timing_not_taken,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// SUPPLIED READINGS AND VERDICTS, not a boot: the subject is the phase record's assembly and
// rendering, so the readings are constructed at this boundary (#12423 comment 5858637192: a
// controlled refused route, not a wait for a live refusal). The production caller is
// mtcollins1_boot_actuate, which reaches mtcollins1_boot_phase_spans with the readings it took;
// the real clock route is the_real_uptime_clock_reads_and_does_not_go_back below.
fn at(ms: Nat) -> ProcUptimeRead {
  UptimeObserved { uptime: millisecond(count: ms) }
}

fn readings() -> MtCollins1BootPhaseReadings {
  MtCollins1BootPhaseReadings {
    hold_acquired: at(ms: 1000),
    sol_held: at(ms: 3400),
    param5_before_read: at(ms: 4000),
    attach_verified: at(ms: 9000),
    power_verified: at(ms: 21000),
    smpro_power_on_read: at(ms: 23000),
    terminal_observed: at(ms: 500000),
    param5_after_read: at(ms: 501000),
    power_after_read: at(ms: 506000),
    released: at(ms: 507000),
  }
}

fn all_verified() -> MtCollins1BootPhaseResults {
  MtCollins1BootPhaseResults {
    param5_before: PhaseVerified, media_attach: PhaseVerified, handoff: PhaseVerified, smpro_power_on: PhaseVerified,
    terminal_watch: PhaseVerified, param5_after: PhaseVerified, power_after: PhaseVerified, sol_release: PhaseVerified,
  }
}

fn attach_refused() -> MtCollins1BootPhaseResults {
  MtCollins1BootPhaseResults {
    param5_before: PhaseVerified, media_attach: PhaseRefused { cause: "fixture: virtual media readback did not match" }, handoff: PhaseVerified,
    smpro_power_on: PhaseVerified, terminal_watch: PhaseVerified, param5_after: PhaseVerified, power_after: PhaseVerified, sol_release: PhaseVerified,
  }
}

fn text_of(v: MtCollins1BootPhaseResults) -> String {
  mtcollins1_boot_phase_timing_text(t: MtCollins1BootPhaseTiming { hold_acquired: at(ms: 1000), start: BootStartCold, spans: mtcollins1_boot_phase_spans(r: readings(), v: v) })
}

test fn a_completed_route_reports_offset_and_span_per_phase() -> Bool {
  let t = text_of(v: all_verified())
  contains(t, "phase sol_acquire: first_action=+0ms verified_after=2400ms")
    && contains(t, "phase handoff: first_action=+8000ms verified_after=12000ms")
    && contains(t, "phase smpro_power_on: first_action=+20000ms verified_after=2000ms")
    && contains(t, "phase terminal_watch: first_action=+22000ms verified_after=477000ms")
    && contains(t, "phase sol_release: first_action=+505000ms verified_after=1000ms")
}

// THE REFUSED ROUTE: an attach that did not verify. The attach prints REFUSED with its cause, never
// "verified"; the handoff, the power-on SMpro pass and the terminal watch print not reached with no
// number; the after-reads, final power and SOL release -- which run on every arm that held the SOL --
// still carry their times. Deleting the reachability arms of mtcollins1_boot_phase_spans turns this red.
test fn a_refused_attach_marks_later_phases_not_reached_and_keeps_cleanup_times() -> Bool {
  let t = text_of(v: attach_refused())
  contains(t, "phase media_attach: first_action=+3000ms REFUSED_after=5000ms (fixture: virtual media readback did not match)")
    && !contains(t, "phase media_attach: first_action=+3000ms verified_after")
    && contains(t, "phase handoff: not reached (the media attach did not verify)")
    && contains(t, "phase smpro_power_on: not reached (power on was never verified)")
    && contains(t, "phase terminal_watch: not reached (power on was never verified)")
    && contains(t, "phase param5_after: first_action=+499000ms verified_after=1000ms")
    && contains(t, "phase sol_release: first_action=+505000ms verified_after=1000ms")
}

// THE PHASES THAT RAN PARTITION THE ACTUATION: every ran phase begins at the reading that ended the
// ran phase before it, so no interval is inside two phases and the spans cover hold to release.
fn begin_of(s: MtCollins1BootPhaseSpan) -> ProcUptimeRead {
  match s {
    PhaseRan { phase: _, result: _, begin: b, end: _ } => b
    PhaseNotRan { phase: _, reason: _ } => UptimeRefused { detail: "not ran" }
  }
}

fn end_of(s: MtCollins1BootPhaseSpan) -> ProcUptimeRead {
  match s {
    PhaseRan { phase: _, result: _, begin: _, end: e } => e
    PhaseNotRan { phase: _, reason: _ } => UptimeRefused { detail: "not ran" }
  }
}

// ADJACENT MEANS NO TIME BETWEEN, measured by the instrument's own duration and not by comparing
// counts by hand.
fn adjacent(a: ProcUptimeRead, b: ProcUptimeRead) -> Bool {
  match mtcollins1_boot_phase_duration(from: a, to: b) {
    PhaseElapsed { elapsed: e } => millisecond_count(m: e) == 0
    PhaseClockUnread { detail: _ } => false
    PhaseClockSteppedBack { begin: _, end: _ } => false
  }
}

fn span_at(xs: List<MtCollins1BootPhaseSpan>, index: Int) -> MtCollins1BootPhaseSpan {
  match xs.skip(n: index).first() {
    Present { value: s } => s
    Absent => PhaseNotRan { phase: PhaseHandoff, reason: "index out of range" }
  }
}

fn partitions(spans: List<MtCollins1BootPhaseSpan>) -> Bool {
  let r = filter(spans, s => match s { PhaseRan { phase: _, result: _, begin: _, end: _ } => true  PhaseNotRan { phase: _, reason: _ } => false })
  let n = count(r)
  n > 0
    && adjacent(a: readings().hold_acquired, b: begin_of(s: span_at(xs: r, index: 0)))
    && adjacent(a: end_of(s: span_at(xs: r, index: n - 1)), b: readings().released)
    && all(range(1, n), i => adjacent(a: end_of(s: span_at(xs: r, index: i - 1)), b: begin_of(s: span_at(xs: r, index: i))))
}

test fn the_phases_that_ran_partition_hold_to_release_on_both_routes() -> Bool {
  partitions(spans: mtcollins1_boot_phase_spans(r: readings(), v: all_verified()))
    && partitions(spans: mtcollins1_boot_phase_spans(r: readings(), v: attach_refused()))
}

test fn a_clock_that_goes_back_refuses_rather_than_printing_negative_time() -> Bool {
  let t = mtcollins1_boot_phase_timing_text(t: MtCollins1BootPhaseTiming {
    hold_acquired: at(ms: 5000),
    start: BootStartCold,
    spans: [PhaseRan { phase: PhaseHandoff, result: PhaseVerified, begin: at(ms: 5000), end: at(ms: 4000) }],
  })
  contains(t, "verified_after=REFUSED: clock went back from 5000 to 4000 ms") && !contains(t, "-1000ms")
}

test fn an_unread_clock_prints_its_cause_not_a_number() -> Bool {
  let t = mtcollins1_boot_phase_timing_text(t: MtCollins1BootPhaseTiming {
    hold_acquired: at(ms: 5000),
    start: BootStartCold,
    spans: [PhaseRan { phase: PhaseHandoff, result: PhaseVerified, begin: at(ms: 5000), end: UptimeRefused { detail: "fixture: /proc/uptime read failed" } }],
  })
  contains(t, "verified_after=unread (fixture: /proc/uptime read failed)")
}

test fn a_refused_sol_acquire_holds_nothing_after_it() -> Bool {
  let t = mtcollins1_boot_phase_timing_text(t: mtcollins1_boot_phase_timing_sol_refused(hold_acquired: at(ms: 1000), refused_at: at(ms: 3500), cause: "fixture: activate refused"))
  contains(t, "phase sol_acquire: first_action=+0ms REFUSED_after=2500ms (fixture: activate refused)")
    && contains(t, "phase media_attach: not reached (the SOL lease was not acquired, so nothing was written)")
    && contains(t, "phase sol_release: not reached")
}

test fn power_up_is_cold_and_power_cycle_is_warm() -> Bool {
  (match mtcollins1_boot_start_of(transition: PoweredOn) { BootStartCold => true  _ => false })
    && (match mtcollins1_boot_start_of(transition: PowerCycled) { BootStartWarm => true  _ => false })
}

test fn an_attempt_that_never_held_says_so() -> Bool {
  let t = mtcollins1_boot_phase_timing_text(t: mtcollins1_boot_phase_timing_not_taken(reason: "the unit hold was refused"))
  contains(t, "boot_start=unobserved (the unit hold was refused)") && contains(t, "phases: none reached")
}

// /proc/uptime's SHAPE: `%lu.%02lu %lu.%02lu` (fs/proc/uptime.c). Anything else refuses.
test fn proc_uptime_parses_to_milliseconds_and_refuses_malformed_text() -> Bool {
  (match proc_uptime_parse(text: "350735.47 234388.90\n") { UptimeObserved { uptime: u } => millisecond_count(m: u) == 350735470  UptimeRefused { detail: _ } => false })
    && (match proc_uptime_parse(text: "") { UptimeRefused { detail: _ } => true  UptimeObserved { uptime: _ } => false })
    && (match proc_uptime_parse(text: "350735 234388.90") { UptimeRefused { detail: _ } => true  UptimeObserved { uptime: _ } => false })
    && (match proc_uptime_parse(text: "350735.4 234388.90") { UptimeRefused { detail: _ } => true  UptimeObserved { uptime: _ } => false })
    && (match proc_uptime_parse(text: "-1.00 0.00") { UptimeRefused { detail: _ } => true  UptimeObserved { uptime: _ } => false })
}

// THE REAL CLOCK ROUTE: two readings of this machine's /proc/uptime through the procfs transport
// the actuation uses. Both are observations and the second is not below the first.
test fn the_real_uptime_clock_reads_and_does_not_go_back() -> Bool {
  let a = proc_uptime_read()
  let b = proc_uptime_read()
  match a {
    UptimeObserved { uptime: x } => match b { UptimeObserved { uptime: y } => match measure_sub(a: y, b: x) { MeasureDifference { value: _ } => true  MeasureSubtrahendExceedsMinuend => false }  UptimeRefused { detail: _ } => false }
    UptimeRefused { detail: _ } => false
  }
}

// AN SMpro PASS WHOSE READS WERE ALL TAKEN AND NONE ANSWERED IS REFUSED. Supplied raw probe results
// go through the real per-read decision (smpro_probe_outcome): a completion-code NAK and a
// transport timeout with no completion code. Returning PhaseVerified for a pass that merely ran
// turns this red; one word read among refusals makes it verified; an empty pass is refused.
fn smpro_raw(socket: Int, exit_code: Int, stdout: String, stderr: String) -> SmproProbeRaw {
  SmproProbeRaw { sequence: 0, socket: socket, register: smpro_bootstage_reg.name, request: "raw 0x06 0x52 0x05 0x9e 0x02 0xb0 0x02", at: "2026-09-27T12:00:00Z", exit_code: exit_code, stdout: stdout, stderr: stderr }
}

test fn an_smpro_pass_is_verified_only_when_a_register_answered() -> Bool {
  let nak = smpro_probe_outcome(raw: smpro_raw(socket: 0, exit_code: 1, stdout: "", stderr: "Unable to send RAW command (channel=0x0 netfn=0x6 lun=0x0 cmd=0x52 rsp=0x83): Unknown (0x83)"))
  let timeout = smpro_probe_outcome(raw: smpro_raw(socket: 1, exit_code: 124, stdout: "", stderr: ""))
  let word = smpro_probe_outcome(raw: smpro_raw(socket: 0, exit_code: 0, stdout: "09 02", stderr: ""))
  let all_refused = mtcollins1_smpro_pass_result(outcomes: [nak, timeout])
  (match all_refused {
    PhaseRefused { cause: c } => contains(c, "no SMpro register returned a word (2 reads")
    PhaseVerified => false
  })
    && (match mtcollins1_smpro_pass_result(outcomes: [nak, word, timeout]) { PhaseVerified => true  PhaseRefused { cause: _ } => false })
    && (match mtcollins1_smpro_pass_result(outcomes: []) { PhaseRefused { cause: c } => contains(c, "(0 reads")  PhaseVerified => false })
}
