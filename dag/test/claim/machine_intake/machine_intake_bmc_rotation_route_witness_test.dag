data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// ── supplied values at the approval boundary ────────────────────────────────────────────────────
// The approval is SUPPLIED as an admitted Redemption (gunbc.auth.approval_broker); its own producer
// and every refusal it makes are witnessed in test.claim.approval_broker_witness_test. What these
// claims discriminate is which authority and which request revision the route admission reads.
fn approval(authority: NonEmptyStr, revision: NonEmptyStr) -> Redemption {
  RedemptionAdmitted {
    claims: ApprovalCapabilityClaims {
      protocol: approval_capability_protocol,
      issuer: "gunbc-approval-broker" as NonEmptyStr,
      audience: "srv1" as NonEmptyStr,
      authority: authority,
      escalation_id: "route-witness-1" as NonEmptyStr,
      request_revision: revision,
      decision: ProposeApprove,
      attempt: "attempt-1" as AttemptIdentity,
      issued_at: "2026-10-03T00:00:00Z",
      expires_at: "2026-10-03T00:15:00Z",
      key_id: "broker-2026-10" as MacKeyId,
    },
    decided_by: "operator" as NonEmptyStr,
  }
}

fn standing_request(s: BmcRotationRouteStanding) -> BmcAccountWriteRequest {
  match s.grounding {
    RouteGroundedByExecutedRequest { request: r, request_receipt: _, response_receipt: _, effect: _ } => r
    RouteGroundedByCitedSource { request: r, citation: _ } => r
    RouteQualificationCandidate { request: r, evidence: _ } => r
    RouteUngrounded => IpmiSetUserPassword { user: 3 }
  }
}

// An operator approval of the ROTATION of this exact controller, build and request.
fn rotation_approval_for(s: BmcRotationRouteStanding) -> Redemption {
  approval(authority: rotation_apply_authority, revision: rotation_route_request_identity(standing: s, request: standing_request(s: s)))
}

// A synthetic MegaRAC controller pair and build for the qualification bootstrap. No unit row is made
// from either, and no modeled run grounds anything: the modeled verdict carries no standing.
data lab_endpoint: BmcControllerEndpoint = BmcControllerEndpoint { host: "198.51.100.7" }

data lab_endpoint_b: BmcControllerEndpoint = BmcControllerEndpoint { host: "198.51.100.8" }

fn lab_firmware() -> BmcFirmwareReleaseIdentity {
  bmc_firmware_release_identity_of_wire(family: AmiMegaRac, wire: "0.32" as NonEmptyStr)
}

data lab_surface_receipt: EvidenceRef = EvidenceRef {
  label: "lab IPMI user list read",
  digest: content_hash_of_value(value: "lab IPMI user list read" as NonEmptyStr),
}

fn candidate_at(endpoint: BmcControllerEndpoint, request: BmcAccountWriteRequest) -> BmcRotationRouteStanding {
  rotation_route_candidate(
    endpoint: endpoint,
    firmware: lab_firmware(),
    request: request,
    evidence: ObservedSurfaceRead { surface: SurfaceAccountManagement, receipt: lab_surface_receipt },
  )
}

fn lab_candidate(request: BmcAccountWriteRequest) -> BmcRotationRouteStanding {
  candidate_at(endpoint: lab_endpoint, request: request)
}

fn subject_at(endpoint: BmcControllerEndpoint, request: BmcAccountWriteRequest) -> RouteQualificationSubject {
  RouteQualificationSubject { endpoint: endpoint, firmware: lab_firmware(), request: request }
}

fn lab_world_with_user3() -> BmcWorld {
  bmc_with_ipmi_users(world: bmc_world(power: BmcPowerOn), users: [BmcIpmiUser { id: 3, password: "factory" }])
}

fn qualification_approval_for(standing: BmcRotationRouteStanding, request: BmcAccountWriteRequest) -> Redemption {
  approval(authority: route_qualification_authority, revision: rotation_route_request_identity(standing: standing, request: request))
}

fn refusal_name(c: RouteQualificationRefusal) -> String {
  match c {
    QualificationSubjectNotACandidate => "not-a-candidate"
    QualificationApprovalRefused { cause: _ } => "approval-refused"
    QualificationApprovalDenied => "approval-denied"
    QualificationApprovalForAnotherAuthority { authority: _ } => "another-authority"
    QualificationApprovalForAnotherRequest { approved: _, requested: _ } => "another-request"
    QualificationResponseForAnotherSubject { answered: _, candidate: _ } => "response-for-another-subject"
    QualificationRequestUnrealized => "unrealized"
    QualificationRequestNotCompleted { response_receipt: _ } => "not-completed"
    QualificationReadbackRefused { response_receipt: _ } => "readback-refused"
  }
}

// The modeled verdict for a candidate, an approval and a modeled run against `answered`.
fn modeled_verdict(candidate: BmcRotationRouteStanding, approval_value: Redemption, world: BmcWorld, answered: RouteQualificationSubject) -> String {
  match classify_modeled_route_qualification(standing: candidate, approval: approval_value, response: dry_route_qualification_request(world: world, subject: answered, password: "new-Secret!1").response) {
    ModeledQualificationWouldQualify { subject: _, request_receipt: _, response_receipt: _, effect: _ } => "would-qualify"
    ModeledQualificationRefused { cause: c } => refusal_name(c: c)
  }
}

fn refusal_of(world: BmcWorld, request: BmcAccountWriteRequest, approval_value: Redemption) -> String {
  modeled_verdict(candidate: lab_candidate(request: request), approval_value: approval_value, world: world, answered: subject_at(endpoint: lab_endpoint, request: request))
}

fn apply_verdict(standing: BmcRotationRouteStanding, target: BmcControllerEndpoint, firmware: BmcFirmwareReleaseIdentity, approval_value: Redemption) -> String {
  apply_verdict_for(standing: standing, target: target, firmware: firmware, request: standing_request(s: standing), approval_value: approval_value)
}

fn apply_verdict_for(standing: BmcRotationRouteStanding, target: BmcControllerEndpoint, firmware: BmcFirmwareReleaseIdentity, request: BmcAccountWriteRequest, approval_value: Redemption) -> String {
  match admit_rotation_apply(standing: standing, target_endpoint: target, target_firmware: firmware, request: request, managed_readback: none, approval: approval_value) {
    RotationApplyAdmitted { standing: _, request: _, decided_by: _ } => "admitted"
    RotationApplyRouteNotGrounded { standing: _ } => "route-not-grounded"
    RotationApplyRouteForAnotherController { route_endpoint: _, target_endpoint: _ } => "another-controller"
    RotationApplyRouteForAnotherBuild { route_firmware: _, target_firmware: _ } => "another-build"
    RotationApplyRouteForAnotherOperation { grounded: _, requested: _ } => "another-operation"
    RotationApplyRouteEffectUnobserved { standing: _ } => "effect-unobserved"
    RotationApplyApprovalRefused { cause: _ } => "approval-refused"
    RotationApplyApprovalDenied => "approval-denied"
    RotationApplyApprovalForAnotherAuthority { authority: _ } => "another-authority"
    RotationApplyApprovalForAnotherRequest { approved: _, requested: _ } => "another-request"
    RotationApplyWouldLeaveNoAdministrator { channel: _, cause: _ } => "would-leave-no-administrator"
  }
}

fn grounding_kind(standing: BmcRotationRouteStanding) -> String {
  match standing.grounding {
    RouteGroundedByExecutedRequest { request: _, request_receipt: _, response_receipt: _, effect: _ } => "executed"
    RouteGroundedByCitedSource { request: _, citation: _ } => "cited"
    RouteQualificationCandidate { request: _, evidence: _ } => "candidate"
    RouteUngrounded => "ungrounded"
  }
}

// The candidate a past read would justify, at the address it was read on. Supplied by the witness
// only: no production code mints a standing from a historical observation.
fn candidate_from_history(h: HistoricalRotationRouteObservation) -> BmcRotationRouteStanding {
  rotation_route_candidate(endpoint: h.observed_endpoint, firmware: h.firmware, request: h.request, evidence: h.evidence)
}

// ── rows from evidence ──────────────────────────────────────────────────────────────────────────

// mtcollins1 is grounded by its executed IPMI Set User Password on user 3, bound to its own
// controller and build, with both receipts naming the committed transcript at its digest.
test fn mtcollins1_is_grounded_by_its_executed_ipmi_request() -> Bool {
  let s = mtcollins1_rotation_route_standing()
  (s.endpoint.host as String) == "192.168.1.228"
    && (s.firmware.raw_version as String) == "0.32"
    && match s.grounding {
      RouteGroundedByExecutedRequest { request: r, request_receipt: q, response_receipt: p, effect: _ } =>
        match r {
          IpmiSetUserPassword { user: u } => (u as Int) == 3
          IpmiSetUserPrivilegeLimit { access: _ } => false
          RedfishAccountPasswordWrite { transport_operation: _, action_shape: _ } => false
        }
          && q.digest == mtcollins1_user3_route_digest
          && p.digest == mtcollins1_user3_route_digest
      RouteGroundedByCitedSource { request: _, citation: _ } => false
      RouteQualificationCandidate { request: _, evidence: _ } => false
      RouteUngrounded => false
    }
}

// mtjade1 has a HISTORICAL observation only (the real path: read, hashed, decoded, bound to the
// unit's link, discriminated), at the factory address the capture was read on and the build it
// reports, naming the observed Manager surface and the Redfish account write. Its type is not a
// standing; the current standing is AccessDiscover's (O1c-1).
test fn mtjade1_has_only_a_historical_observation_at_its_factory_address() -> Bool {
  match mtjade1_historical_rotation_route_observation() {
    Absent => false
    Present { value: h } =>
      (h.observed_endpoint.host as String) == "10.0.7.2"
        && (h.firmware.raw_version as String) == "2.11.104000"
        && account_write_request_eq(a: h.request, b: redfish_account_password_write())
        && match h.evidence {
          ObservedSurfaceRead { surface: sf, receipt: _ } => match sf { SurfaceManagerIdentity => true  _ => false }
          PublicStandardOperation { authority: _ } => false
        }
  }
}

// CONTROL: two AmiMegaRac controllers with different observed and executed surfaces produce
// different route standings. Same family: mtcollins1's executed request grounds its route; the most
// mtjade1's Manager read can justify is a candidate. A family-keyed answer cannot pass.
test fn two_megarac_controllers_with_different_surfaces_have_different_standings() -> Bool {
  match mtjade1_historical_rotation_route_observation() {
    Absent => false
    Present { value: h } => {
      let jade = candidate_from_history(h: h)
      let collins = mtcollins1_rotation_route_standing()
      collins.firmware.family == AmiMegaRac
        && jade.firmware.family == AmiMegaRac
        && grounding_kind(standing: collins) == "executed"
        && grounding_kind(standing: jade) == "candidate"
    }
  }
}

// CONTROL: a Manager GET alone cannot construct an account-write route. The most the read justifies
// is a candidate; the rotation Apply refuses it beside an exact approval of the rotation, and the
// qualification classifier refuses it with an exact qualification approval because no live (or even
// modeled) account write answered.
test fn a_manager_get_alone_cannot_construct_an_account_write_route() -> Bool {
  match historical_route_observation_from_manager_read(read: read_mtjade1_recorded_manager_identity()) {
    Absent => false
    Present { value: h } => {
      let s = candidate_from_history(h: h)
      !rotation_route_is_grounded(standing: s)
        && apply_verdict(standing: s, target: s.endpoint, firmware: s.firmware, approval_value: rotation_approval_for(s: s)) == "route-not-grounded"
        && match qualify_rotation_route(standing: s, approval: qualification_approval_for(standing: s, request: h.request), response: none) {
          RouteQualificationRefused { standing: _, cause: c } => refusal_name(c: c) == "unrealized"
          RouteQualified { standing: _ } => false
        }
    }
  }
}

// CONTROL: RouteUngrounded + operator approval of the rotation + an ordinary Apply -> refused, and
// refused for the ROUTE. Positive control on the same fold, with the one real live-execution
// carrier: mtcollins1's committed executed route with its exact approval is admitted.
test fn an_ungrounded_route_with_rotation_approval_is_refused_and_a_grounded_one_is_admitted() -> Bool {
  let ungrounded = rotation_route_ungrounded(endpoint: mtcollins1_endpoint, firmware: mtcollins1_firmware)
  apply_verdict(standing: ungrounded, target: mtcollins1_endpoint, firmware: mtcollins1_firmware, approval_value: rotation_approval_for(s: ungrounded)) == "route-not-grounded"
    && apply_verdict(standing: mtcollins1_rotation_route_standing(), target: mtcollins1_endpoint, firmware: mtcollins1_firmware, approval_value: rotation_approval_for(s: mtcollins1_rotation_route_standing())) == "admitted"
}

// An IPMI route grounded on mtcollins1 does not authorize mtjade1 (at the address its capture names),
// nor mtcollins1 at another build, nor a write approved under the route-qualification authority.
test fn mtcollins1s_grounded_route_does_not_authorize_another_controller_build_or_authority() -> Bool {
  match mtjade1_historical_rotation_route_observation() {
    Absent => false
    Present { value: h } => {
      let collins = mtcollins1_rotation_route_standing()
      apply_verdict(standing: collins, target: h.observed_endpoint, firmware: h.firmware, approval_value: rotation_approval_for(s: collins)) == "another-controller"
        && apply_verdict(standing: collins, target: mtcollins1_endpoint, firmware: bmc_firmware_release_identity_of_wire(family: AmiMegaRac, wire: "0.33" as NonEmptyStr), approval_value: rotation_approval_for(s: collins)) == "another-build"
        && apply_verdict(standing: collins, target: mtcollins1_endpoint, firmware: mtcollins1_firmware, approval_value: approval(authority: route_qualification_authority, revision: rotation_route_request_identity(standing: collins, request: IpmiSetUserPassword { user: 3 }))) == "another-authority"
    }
  }
}

// ── the qualification bootstrap, over the dry realization ───────────────────────────────────────

// THE MODELED RUN CANNOT GROUND A PRODUCTION ROUTE (side-chat review of afcc512e9c, item 1). With a
// candidate, the exact qualification approval and a completed, read-back modeled Set User Password,
// the classifier says the run WOULD qualify -- and that verdict carries no standing. The candidate
// stays a candidate, the ordinary rotation Apply still refuses it, and qualify_rotation_route, the
// only construction of an executed grounding, has no live response to read and refuses.
test fn a_modeled_run_would_qualify_but_grounds_nothing() -> Bool {
  let request = IpmiSetUserPassword { user: 3 }
  let candidate = lab_candidate(request: request)
  let exact = qualification_approval_for(standing: candidate, request: request)
  let step = dry_route_qualification_request(world: lab_world_with_user3(), subject: subject_at(endpoint: lab_endpoint, request: request), password: "new-Secret!1")
  bmc_ipmi_user_accepts(world: step.world, user: 3, password: "new-Secret!1")
    && !bmc_ipmi_user_accepts(world: step.world, user: 3, password: "factory")
    && modeled_verdict(candidate: candidate, approval_value: exact, world: lab_world_with_user3(), answered: subject_at(endpoint: lab_endpoint, request: request)) == "would-qualify"
    && grounding_kind(standing: candidate) == "candidate"
    && apply_verdict(standing: candidate, target: lab_endpoint, firmware: lab_firmware(), approval_value: rotation_approval_for(s: candidate)) == "route-not-grounded"
    && match qualify_rotation_route(standing: candidate, approval: exact, response: none) {
      RouteQualificationRefused { standing: s, cause: c } => refusal_name(c: c) == "unrealized" && grounding_kind(standing: s) == "candidate"
      RouteQualified { standing: _ } => false
    }
}

// THE RESPONSE IS BOUND TO ITS SUBJECT (item 2). A response made against controller A answers A: for
// candidate B with the same request and B's exact approval it refuses; for candidate A it would
// qualify.
test fn a_response_for_another_controller_is_refused() -> Bool {
  let request = IpmiSetUserPassword { user: 3 }
  let b = candidate_at(endpoint: lab_endpoint_b, request: request)
  let a = candidate_at(endpoint: lab_endpoint, request: request)
  modeled_verdict(candidate: b, approval_value: qualification_approval_for(standing: b, request: request), world: lab_world_with_user3(), answered: subject_at(endpoint: lab_endpoint, request: request)) == "response-for-another-subject"
    && modeled_verdict(candidate: a, approval_value: qualification_approval_for(standing: a, request: request), world: lab_world_with_user3(), answered: subject_at(endpoint: lab_endpoint, request: request)) == "would-qualify"
}

// REQUEST IDENTITY IS STRUCTURAL (item 3). Two Redfish account writes differing ONLY in the transport
// operation's declaration field, or ONLY in the action shape, are different requests: unequal, with
// different approval identities, and an approval for one refuses the other.
fn redfish_write(op_field: NonEmptyStr, action_field: NonEmptyStr) -> BmcAccountWriteRequest {
  RedfishAccountPasswordWrite {
    transport_operation: decl_field_ref(module_path: "extdeps.bmc.http", decl_name: "redfish.Http", field_name: op_field),
    action_shape: decl_field_ref(module_path: "extdeps.bmc.types", decl_name: "RedfishSystemAction", field_name: action_field),
  }
}

test fn requests_differing_only_in_transport_or_action_shape_are_different_requests() -> Bool {
  let base = redfish_write(op_field: "SetAccountPassword" as NonEmptyStr, action_field: "SetAccountPassword" as NonEmptyStr)
  let other_transport = redfish_write(op_field: "SetAccountPasswordV2" as NonEmptyStr, action_field: "SetAccountPassword" as NonEmptyStr)
  let other_action = redfish_write(op_field: "SetAccountPassword" as NonEmptyStr, action_field: "ResetAccountPassword" as NonEmptyStr)
  let c_transport = lab_candidate(request: other_transport)
  let c_action = lab_candidate(request: other_action)
  account_write_request_eq(a: base, b: base)
    && !account_write_request_eq(a: base, b: other_transport)
    && !account_write_request_eq(a: base, b: other_action)
    && classify_names(candidate: c_transport, approval_value: qualification_approval_for(standing: c_transport, request: base)) == "another-request"
    && classify_names(candidate: c_action, approval_value: qualification_approval_for(standing: c_action, request: base)) == "another-request"
}

fn classify_names(candidate: BmcRotationRouteStanding, approval_value: Redemption) -> String {
  match classify_modeled_route_qualification(standing: candidate, approval: approval_value, response: none) {
    ModeledQualificationWouldQualify { subject: _, request_receipt: _, response_receipt: _, effect: _ } => "would-qualify"
    ModeledQualificationRefused { cause: c } => refusal_name(c: c)
  }
}

// Every other way across refuses and keeps the candidate.
test fn the_qualification_classifier_refuses_every_other_crossing() -> Bool {
  let ipmi = IpmiSetUserPassword { user: 3 }
  let right = qualification_approval_for(standing: lab_candidate(request: ipmi), request: ipmi)
  refusal_of(world: lab_world_with_user3(), request: ipmi, approval_value: rotation_approval_for(s: lab_candidate(request: ipmi))) == "another-authority"
    && refusal_of(world: lab_world_with_user3(), request: ipmi, approval_value: approval(authority: route_qualification_authority, revision: "another controller" as NonEmptyStr)) == "another-request"
    && refusal_of(world: bmc_world(power: BmcPowerOn), request: ipmi, approval_value: right) == "not-completed"
    && refusal_of(world: lab_world_with_user3(), request: redfish_account_password_write(), approval_value: qualification_approval_for(standing: lab_candidate(request: redfish_account_password_write()), request: redfish_account_password_write())) == "unrealized"
    && modeled_verdict(candidate: rotation_route_ungrounded(endpoint: lab_endpoint, firmware: lab_firmware()), approval_value: right, world: lab_world_with_user3(), answered: subject_at(endpoint: lab_endpoint, request: ipmi)) == "not-a-candidate"
    && modeled_verdict(candidate: lab_candidate(request: ipmi), approval_value: right, world: lab_world_with_user3(), answered: subject_at(endpoint: lab_endpoint, request: IpmiSetUserPassword { user: 4 })) == "response-for-another-subject"
}

// THE CITED ARM: a route grounded by a source cited for this build admits an Apply on that build and
// refuses the same controller at another build.
test fn a_cited_route_admits_apply_and_is_bound_to_its_build() -> Bool {
  let s = rotation_route_from_citation(
    endpoint: lab_endpoint,
    firmware: lab_firmware(),
    request: IpmiSetUserPassword { user: 3 },
    citation: ExternalAuthority { uri: uri_https(locator: "example.invalid/route-witness-citation" as NonEmptyStr) },
  )
  grounding_kind(standing: s) == "cited"
    && apply_verdict(standing: s, target: lab_endpoint, firmware: lab_firmware(), approval_value: rotation_approval_for(s: s)) == "admitted"
    && apply_verdict(standing: s, target: lab_endpoint, firmware: bmc_firmware_release_identity_of_wire(family: AmiMegaRac, wire: "0.33" as NonEmptyStr), approval_value: rotation_approval_for(s: s)) == "another-build"
}

// ── the qualification effect's authorization, by executing the selection ────────────────────────

// The census row for qualify_rotation_route is classified by EXECUTING select_authorization_pattern
// over its stated characteristics: the selection returns the operator-approved capability, and the
// row's realization (an admitted Redemption) conforms to it.
test fn the_qualification_effect_is_classified_operator_approved_and_conforms() -> Bool {
  let rows = filter(privileged_effect_census, r => (r.site.module_path as String) == "gunbc.machine_intake_bmc_rotation_route" && (r.site.decl_name as String) == "admit_password_route_qualification")
  length(rows) == 1
    && all(rows, r =>
      match select_authorization_pattern(e: r.effect) {
        PatternSelected { pattern: p, receipt: _ } => match p { OperatorApprovedCapability => true  _ => false }
        _ => false
      }
        && match site_verdict(row: r).conformance { Conforms => true  _ => false })
}

// AN APPROVAL IS BOUND TO ITS CONTROLLER, BUILD AND REQUEST (review 75181). mtcollins1's rotation
// approval, reused for another controller's grounded route under the same authority, is a different
// decision and refuses; the approval minted for that route's own identity is admitted; and a denial
// is its own typed arm. Shown on a cited route, the grounded arm a witness may construct.
test fn a_rotation_approval_for_one_controller_does_not_admit_another() -> Bool {
  let request = IpmiSetUserPassword { user: 3 }
  let lab = rotation_route_from_citation(
    endpoint: lab_endpoint,
    firmware: lab_firmware(),
    request: request,
    citation: ExternalAuthority { uri: uri_https(locator: "example.invalid/route-witness-citation" as NonEmptyStr) },
  )
  let denied = RedemptionAdmitted {
    claims: ApprovalCapabilityClaims {
      protocol: approval_capability_protocol,
      issuer: "gunbc-approval-broker" as NonEmptyStr,
      audience: "srv1" as NonEmptyStr,
      authority: rotation_apply_authority,
      escalation_id: "route-witness-2" as NonEmptyStr,
      request_revision: rotation_route_request_identity(standing: lab, request: request),
      decision: ProposeDeny,
      attempt: "attempt-2" as AttemptIdentity,
      issued_at: "2026-10-03T00:00:00Z",
      expires_at: "2026-10-03T00:15:00Z",
      key_id: "broker-2026-10" as MacKeyId,
    },
    decided_by: "operator" as NonEmptyStr,
  }
  apply_verdict(standing: lab, target: lab_endpoint, firmware: lab_firmware(), approval_value: rotation_approval_for(s: mtcollins1_rotation_route_standing())) == "another-request"
    && apply_verdict(standing: lab, target: lab_endpoint, firmware: lab_firmware(), approval_value: rotation_approval_for(s: lab)) == "admitted"
    && apply_verdict(standing: lab, target: lab_endpoint, firmware: lab_firmware(), approval_value: denied) == "approval-denied"
}

// ── cut O1a-2: the channel-access request shape ─────────────────────────────────────────────────

fn access_write(user: Int, channel: Int, privilege: IpmiChannelPrivilegeLimit) -> BmcAccountWriteRequest {
  IpmiSetUserPrivilegeLimit { access: ipmi_user_channel_access(channel: channel, user: user, privilege: privilege) }
}

// EVERY FIELD IS IN THE IDENTITY. Set User Access requests differing ONLY in the channel, ONLY in the
// privilege limit, or ONLY in the user are different requests: unequal, and an approval for the base
// request refuses each as another request.
test fn channel_access_requests_differing_in_any_one_field_are_different_requests() -> Bool {
  let base = access_write(user: 2, channel: 2, privilege: IpmiPrivilegeNoAccess)
  let other_channel = access_write(user: 2, channel: 3, privilege: IpmiPrivilegeNoAccess)
  let other_privilege = access_write(user: 2, channel: 2, privilege: IpmiPrivilegeUser)
  let other_user = access_write(user: 4, channel: 2, privilege: IpmiPrivilegeNoAccess)
  let c_channel = lab_candidate(request: other_channel)
  let c_privilege = lab_candidate(request: other_privilege)
  let c_user = lab_candidate(request: other_user)
  account_write_request_eq(a: base, b: base)
    && !account_write_request_eq(a: base, b: other_channel)
    && !account_write_request_eq(a: base, b: other_privilege)
    && !account_write_request_eq(a: base, b: other_user)
    && classify_names(candidate: c_channel, approval_value: qualification_approval_for(standing: c_channel, request: base)) == "another-request"
    && classify_names(candidate: c_privilege, approval_value: qualification_approval_for(standing: c_privilege, request: base)) == "another-request"
    && classify_names(candidate: c_user, approval_value: qualification_approval_for(standing: c_user, request: base)) == "another-request"
}

// mtcollins1's channel-access route is a candidate on its CURRENT controller and build (0.45.3, not
// the 0.32 its password route was executed on), naming the NON-DESTRUCTIVE qualifying request (the
// managed account, user 3, re-asserted at ADMINISTRATOR on channel 1), with the public standard as its
// only evidence. It is not grounded, and an Apply refuses it.
test fn mtcollins1_channel_access_route_is_an_ungrounded_candidate_on_its_current_build() -> Bool {
  let s = mtcollins1_channel_access_route_standing()
  (s.endpoint.host as String) == "192.168.1.228"
    && (s.firmware.raw_version as String) == "0.45.3"
    && !rotation_route_is_grounded(standing: s)
    && match s.grounding {
      RouteQualificationCandidate { request: r, evidence: e } =>
        account_write_request_eq(a: r, b: access_write(user: 3, channel: 1, privilege: IpmiPrivilegeAdministrator))
          && match e { PublicStandardOperation { authority: _ } => true  ObservedSurfaceRead { surface: _, receipt: _ } => false }
      RouteGroundedByExecutedRequest { request: _, request_receipt: _, response_receipt: _, effect: _ } => false
      RouteGroundedByCitedSource { request: _, citation: _ } => false
      RouteUngrounded => false
    }
    && apply_verdict(standing: s, target: s.endpoint, firmware: s.firmware, approval_value: rotation_approval_for(s: s)) == "route-not-grounded"
}

// THE MODELED CHANNEL-ACCESS RUN: the Set User Access transition sets exactly that (channel, user)
// row, Get User Access reads it back, and the classifier says it would qualify -- with no standing.
// A user the IPMI table does not hold is not completed.
test fn a_modeled_channel_access_run_would_qualify_but_grounds_nothing() -> Bool {
  let request = access_write(user: 3, channel: 2, privilege: IpmiPrivilegeNoAccess)
  let candidate = lab_candidate(request: request)
  let step = dry_route_qualification_request(world: lab_world_with_user3(), subject: subject_at(endpoint: lab_endpoint, request: request), password: "unused")
  match bmc_ipmi_get_user_access(world: step.world, user: 3, channel: 2) {
    Present { value: p } => match p { IpmiPrivilegeNoAccess => true  _ => false }
    Absent => false
  }
    && match bmc_ipmi_get_user_access(world: step.world, user: 3, channel: 3) { Absent => true  Present { value: _ } => false }
    && modeled_verdict(candidate: candidate, approval_value: qualification_approval_for(standing: candidate, request: request), world: lab_world_with_user3(), answered: subject_at(endpoint: lab_endpoint, request: request)) == "would-qualify"
    && grounding_kind(standing: candidate) == "candidate"
    && refusal_of(world: lab_world_with_user3(), request: access_write(user: 9, channel: 2, privilege: IpmiPrivilegeNoAccess), approval_value: qualification_approval_for(standing: lab_candidate(request: access_write(user: 9, channel: 2, privilege: IpmiPrivilegeNoAccess)), request: access_write(user: 9, channel: 2, privilege: IpmiPrivilegeNoAccess))) == "not-completed"
}

// A GROUNDED ROUTE FOR ONE OPERATION DOES NOT ADMIT ANOTHER. mtcollins1's grounded Set User Password
// route, on its own controller and build, with an exact approval of a Set User Access write, refuses
// as another operation; the same route with an exact approval of a password write is admitted.
test fn a_grounded_password_route_does_not_admit_a_channel_access_apply() -> Bool {
  let collins = mtcollins1_rotation_route_standing()
  let access = access_write(user: 2, channel: 2, privilege: IpmiPrivilegeNoAccess)
  apply_verdict_for(standing: collins, target: mtcollins1_endpoint, firmware: mtcollins1_firmware, request: access, approval_value: approval(authority: rotation_apply_authority, revision: rotation_route_request_identity(standing: collins, request: access))) == "another-operation"
    && apply_verdict_for(standing: collins, target: mtcollins1_endpoint, firmware: mtcollins1_firmware, request: IpmiSetUserPassword { user: 3 }, approval_value: approval(authority: rotation_apply_authority, revision: rotation_route_request_identity(standing: collins, request: IpmiSetUserPassword { user: 3 }))) == "admitted"
}

// The census row for qualifying the channel-access shape, classified by EXECUTING the selection over
// its own characteristics (not the password row's): the selection returns the operator-approved
// capability and the row's realization conforms.
test fn the_channel_access_qualification_effect_is_classified_by_executing_the_selection() -> Bool {
  let rows = filter(privileged_effect_census, r => (r.site.module_path as String) == "gunbc.machine_intake_bmc_rotation_route" && (r.site.decl_name as String) == "admit_privilege_limit_route_qualification")
  length(rows) == 1
    && all(rows, r =>
      match select_authorization_pattern(e: r.effect) {
        PatternSelected { pattern: p, receipt: _ } => match p { OperatorApprovedCapability => true  _ => false }
        _ => false
      }
        && match site_verdict(row: r).conformance { Conforms => true  _ => false })
}

// THE LOCKOUT HAZARD IS UNPLANNABLE. On a grounded channel-access route (a cited one, the grounded
// arm a witness may construct), closing user 2 on channel 2 with an exact approval of that write:
// with no managed readback -> refused; with the managed account (user 3) read back at ADMINISTRATOR on
// channel 2 in the approval's own attempt -> admitted; the same readback from another run, a readback
// whose managed account IS the closed one, and a managed account at ADMINISTRATOR only on another
// channel -> each refused with its own typed cause.
fn lockout_verdict(readback: ManagedAdministratorReadback?) -> String {
  let request = access_write(user: 2, channel: 2, privilege: IpmiPrivilegeNoAccess)
  let route = rotation_route_from_citation(
    endpoint: lab_endpoint,
    firmware: lab_firmware(),
    request: access_write(user: 2, channel: 3, privilege: IpmiPrivilegeNoAccess),
    citation: ExternalAuthority { uri: uri_https(locator: "example.invalid/route-witness-citation" as NonEmptyStr) },
  )
  match admit_rotation_apply(
    standing: route,
    target_endpoint: lab_endpoint,
    target_firmware: lab_firmware(),
    request: request,
    managed_readback: readback,
    approval: approval(authority: rotation_apply_authority, revision: rotation_route_request_identity(standing: route, request: request)),
  ) {
    RotationApplyAdmitted { standing: _, request: _, decided_by: _ } => "admitted"
    RotationApplyWouldLeaveNoAdministrator { channel: ch, cause: c } =>
      if ch != 2 { "wrong-channel" } else {
        match c {
          ManagedReadbackAbsent => "readback-absent"
          ManagedReadbackFromAnotherController { readback: _, route: _ } => "another-controller"
          ManagedReadbackFromAnotherBuild { readback: _, route: _ } => "another-build"
          ManagedReadbackFromAnotherRun { readback: _, approved: _ } => "another-run"
          ManagedAccountIsTheClosedAccount { user: _ } => "managed-is-closed"
          ManagedAccountNotAdministratorOnChannel { managed_user: _ } => "not-administrator-on-channel"
          ManagedReadbackDuplicateRow { managed_user: _, count: _ } => "duplicate-row"
          QualificationTargetIsNotTheManagedAccount { target: _, managed_user: _ } => "target-not-managed"
          QualificationTargetDoesNotAlreadyHoldTheLimit { target: _ } => "target-not-holding"
        }
      }
    _ => "other-refusal"
  }
}

// Every readback below is minted by managed_administrator_readback_fixture IN THE CLAIM THAT CONSUMES IT:
// the fixture admits exactly those claims, and no function here returns a readback or a standing.
test fn a_channel_access_write_that_could_lock_out_every_administrator_is_unplannable() -> Bool {
  let admin_on_2 = [ipmi_user_channel_access(channel: 2, user: 3, privilege: IpmiPrivilegeAdministrator)]
  let admin_on_1 = [ipmi_user_channel_access(channel: 1, user: 3, privilege: IpmiPrivilegeAdministrator)]
  lockout_verdict(readback: none) == "readback-absent"
    && lockout_verdict(readback: Present { value: managed_administrator_readback_fixture(endpoint: lab_endpoint, firmware: lab_firmware(), attempt: "attempt-1" as AttemptIdentity, managed_user: 3, access: admin_on_2) }) == "admitted"
    && lockout_verdict(readback: Present { value: managed_administrator_readback_fixture(endpoint: lab_endpoint, firmware: lab_firmware(), attempt: "attempt-0" as AttemptIdentity, managed_user: 3, access: admin_on_2) }) == "another-run"
    && lockout_verdict(readback: Present { value: managed_administrator_readback_fixture(endpoint: lab_endpoint, firmware: lab_firmware(), attempt: "attempt-1" as AttemptIdentity, managed_user: 2, access: [ipmi_user_channel_access(channel: 2, user: 2, privilege: IpmiPrivilegeAdministrator)]) }) == "managed-is-closed"
    && lockout_verdict(readback: Present { value: managed_administrator_readback_fixture(endpoint: lab_endpoint, firmware: lab_firmware(), attempt: "attempt-1" as AttemptIdentity, managed_user: 3, access: admin_on_1) }) == "not-administrator-on-channel"
}

// A READBACK FROM CONTROLLER A CANNOT UNLOCK A CLOSE ON CONTROLLER B, nor one from another build of the
// same controller: the same readback that admits the close on its own controller and build refuses on
// the route's controller B and on build 0.33.
test fn a_readback_from_another_controller_or_build_does_not_unlock_a_close() -> Bool {
  let admin_on_2 = [ipmi_user_channel_access(channel: 2, user: 3, privilege: IpmiPrivilegeAdministrator)]
  lockout_verdict(readback: Present { value: managed_administrator_readback_fixture(endpoint: lab_endpoint_b, firmware: lab_firmware(), attempt: "attempt-1" as AttemptIdentity, managed_user: 3, access: admin_on_2) }) == "another-controller"
    && lockout_verdict(readback: Present { value: managed_administrator_readback_fixture(endpoint: lab_endpoint, firmware: bmc_firmware_release_identity_of_wire(family: AmiMegaRac, wire: "0.33" as NonEmptyStr), attempt: "attempt-1" as AttemptIdentity, managed_user: 3, access: admin_on_2) }) == "another-build"
    && lockout_verdict(readback: Present { value: managed_administrator_readback_fixture(endpoint: lab_endpoint, firmware: lab_firmware(), attempt: "attempt-1" as AttemptIdentity, managed_user: 3, access: admin_on_2) }) == "admitted"
}

// A DUPLICATE (channel, user) RESULT REFUSES: an ADMINISTRATOR row beside a contradictory NO ACCESS row
// for the same managed user and channel is not a unique reading.
test fn a_duplicated_managed_readback_row_refuses() -> Bool {
  lockout_verdict(readback: Present { value: managed_administrator_readback_fixture(endpoint: lab_endpoint, firmware: lab_firmware(), attempt: "attempt-1" as AttemptIdentity, managed_user: 3, access: [
    ipmi_user_channel_access(channel: 2, user: 3, privilege: IpmiPrivilegeAdministrator),
    ipmi_user_channel_access(channel: 2, user: 3, privilege: IpmiPrivilegeNoAccess),
  ]) }) == "duplicate-row"
}

// ── THE PRE-WRITE QUALIFICATION ADMISSION (side-chat review of 7887d74ed2, item 1) ──────────────────

fn prewrite_verdict(a: RouteQualificationRequestAdmission) -> String {
  match a {
    RouteQualificationRequestAdmitted { request: _ } => "admitted"
    RouteQualificationRequestRefused { cause: c } =>
      match c {
        QualificationRequestForAnotherOperation { candidate: _ } => "another-operation"
        QualificationRequestRefusedByClassifier { cause: k } => refusal_name(c: k)
        QualificationRequestWouldLeaveNoAdministrator { cause: k } =>
          match k {
            ManagedReadbackAbsent => "readback-absent"
            _ => "retention-refused"
          }
      }
  }
}

// THE MTCOLLINS1 CANDIDATE CANNOT REACH A TRANSPORT CALL WITHOUT A CURRENT RECEIPT. With its exact
// qualification approval and no managed-administrator readback, the privilege-limit entrypoint refuses
// before any write: no AdmittedRouteQualificationRequest exists, and that sealed value is the only input
// the live transport is permitted. The password entrypoint refuses the candidate as another operation.
test fn the_mtcollins1_channel_access_candidate_cannot_issue_a_request_without_a_current_receipt() -> Bool {
  let s = mtcollins1_channel_access_route_standing()
  let exact = qualification_approval_for(standing: s, request: standing_request(s: s))
  prewrite_verdict(a: admit_privilege_limit_route_qualification(standing: s, approval: exact, readback: none)) == "readback-absent"
    && prewrite_verdict(a: admit_password_route_qualification(standing: s, approval: exact)) == "another-operation"
}

// THE POSITIVE, ON A LAB CANDIDATE WITH THE NON-DESTRUCTIVE SHAPE: re-asserting the managed account's
// ADMINISTRATOR limit on channel 1, with the exact approval and a same-run readback showing it already
// ADMINISTRATOR there, is admitted; the same with a readback from another controller refuses; and a
// rotation approval refuses at the classifier.
test fn the_prewrite_admission_admits_only_with_the_same_run_receipt() -> Bool {
  let request = access_write(user: 3, channel: 1, privilege: IpmiPrivilegeAdministrator)
  let c = lab_candidate(request: request)
  let exact = qualification_approval_for(standing: c, request: request)
  let admin_on_1 = [ipmi_user_channel_access(channel: 1, user: 3, privilege: IpmiPrivilegeAdministrator)]
  prewrite_verdict(a: admit_privilege_limit_route_qualification(standing: c, approval: exact, readback: Present { value: managed_administrator_readback_fixture(endpoint: lab_endpoint, firmware: lab_firmware(), attempt: "attempt-1" as AttemptIdentity, managed_user: 3, access: admin_on_1) })) == "admitted"
    && prewrite_verdict(a: admit_privilege_limit_route_qualification(standing: c, approval: exact, readback: Present { value: managed_administrator_readback_fixture(endpoint: lab_endpoint_b, firmware: lab_firmware(), attempt: "attempt-1" as AttemptIdentity, managed_user: 3, access: admin_on_1) })) == "retention-refused"
    && prewrite_verdict(a: admit_privilege_limit_route_qualification(standing: c, approval: rotation_approval_for(s: c), readback: Present { value: managed_administrator_readback_fixture(endpoint: lab_endpoint, firmware: lab_firmware(), attempt: "attempt-1" as AttemptIdentity, managed_user: 3, access: admin_on_1) })) == "another-authority"
}

// ── WHAT A QUALIFICATION GROUNDS: acceptance, and effect only when the run could tell ───────────────

fn modeled_effect(candidate: BmcRotationRouteStanding, world: BmcWorld, request: BmcAccountWriteRequest) -> String {
  match classify_modeled_route_qualification(standing: candidate, approval: qualification_approval_for(standing: candidate, request: request), response: dry_route_qualification_request(world: world, subject: subject_at(endpoint: lab_endpoint, request: request), password: "unused").response) {
    ModeledQualificationWouldQualify { subject: _, request_receipt: _, response_receipt: _, effect: e } => match e { EffectObserved => "observed"  AcceptedEffectUnobserved => "accepted-only" }
    ModeledQualificationRefused { cause: _ } => "refused"
  }
}

fn world_with_user3_admin_on_1() -> BmcWorld {
  bmc_ipmi_set_user_access(world: lab_world_with_user3(), access: ipmi_user_channel_access(channel: 1, user: 3, privilege: IpmiPrivilegeAdministrator)).world
}

// THE IDEMPOTENT QUALIFYING REQUEST GROUNDS ACCEPTANCE ONLY. Re-asserting a value already present reads
// back identically whether applied or ignored: the modeled run reports accepted-only. The same request
// against a world where the value differed beforehand reports the effect observed.
test fn an_idempotent_qualifying_write_grounds_acceptance_only() -> Bool {
  let request = access_write(user: 3, channel: 1, privilege: IpmiPrivilegeAdministrator)
  let c = lab_candidate(request: request)
  modeled_effect(candidate: c, world: world_with_user3_admin_on_1(), request: request) == "accepted-only"
    && modeled_effect(candidate: c, world: lab_world_with_user3(), request: request) == "observed"
}

// AN ACCEPT-ONLY GROUNDING DOES NOT ADMIT THE CLOSING WRITE. A grounded privilege-limit route whose
// effect was unobserved, with an exact approval of closing user 2 on channel 2 and a valid same-run
// managed-administrator readback, refuses as effect-unobserved; the same with EffectObserved is admitted.
fn closing_verdict(route: BmcRotationRouteStanding, readback: ManagedAdministratorReadback?) -> String {
  let close = access_write(user: 2, channel: 2, privilege: IpmiPrivilegeNoAccess)
  match admit_rotation_apply(
    standing: route,
    target_endpoint: lab_endpoint,
    target_firmware: lab_firmware(),
    request: close,
    managed_readback: readback,
    approval: approval(authority: rotation_apply_authority, revision: rotation_route_request_identity(standing: route, request: close)),
  ) {
    RotationApplyAdmitted { standing: _, request: _, decided_by: _ } => "admitted"
    RotationApplyRouteEffectUnobserved { standing: _ } => "effect-unobserved"
    _ => "other-refusal"
  }
}

test fn an_accept_only_grounding_does_not_admit_the_closing_write() -> Bool {
  let qualifying = access_write(user: 3, channel: 1, privilege: IpmiPrivilegeAdministrator)
  let readback = Present { value: managed_administrator_readback_fixture(endpoint: lab_endpoint, firmware: lab_firmware(), attempt: "attempt-1" as AttemptIdentity, managed_user: 3, access: [ipmi_user_channel_access(channel: 2, user: 3, privilege: IpmiPrivilegeAdministrator)]) }
  closing_verdict(route: rotation_route_executed_fixture(endpoint: lab_endpoint, firmware: lab_firmware(), request: qualifying, receipt: lab_surface_receipt, effect: AcceptedEffectUnobserved), readback: readback) == "effect-unobserved"
    && closing_verdict(route: rotation_route_executed_fixture(endpoint: lab_endpoint, firmware: lab_firmware(), request: qualifying, receipt: lab_surface_receipt, effect: EffectObserved), readback: readback) == "admitted"
}

// THE NON-DESTRUCTIVE QUALIFICATION RE-ASSERTS THE MANAGED ACCOUNT'S OWN CURRENT VALUE (side-chat review
// of 6d277411fd, item 2). For the target (user 3, channel 1, ADMINISTRATOR): a receipt only for managed
// user 4, though ADMINISTRATOR on channel 1, issues no qualification request; a receipt for user 3 whose
// channel-1 row is OPERATOR issues none; the exact current ADMINISTRATOR reading for user 3 is admitted.
test fn the_idempotent_qualification_requires_the_target_pair_to_already_hold_the_value() -> Bool {
  let request = access_write(user: 3, channel: 1, privilege: IpmiPrivilegeAdministrator)
  let c = lab_candidate(request: request)
  let exact = qualification_approval_for(standing: c, request: request)
  prewrite_verdict(a: admit_privilege_limit_route_qualification(standing: c, approval: exact, readback: Present { value: managed_administrator_readback_fixture(endpoint: lab_endpoint, firmware: lab_firmware(), attempt: "attempt-1" as AttemptIdentity, managed_user: 4, access: [ipmi_user_channel_access(channel: 1, user: 4, privilege: IpmiPrivilegeAdministrator)]) })) == "retention-refused"
    && prewrite_verdict(a: admit_privilege_limit_route_qualification(standing: c, approval: exact, readback: Present { value: managed_administrator_readback_fixture(endpoint: lab_endpoint, firmware: lab_firmware(), attempt: "attempt-1" as AttemptIdentity, managed_user: 3, access: [ipmi_user_channel_access(channel: 1, user: 3, privilege: IpmiPrivilegeOperator)]) })) == "retention-refused"
    && prewrite_verdict(a: admit_privilege_limit_route_qualification(standing: c, approval: exact, readback: Present { value: managed_administrator_readback_fixture(endpoint: lab_endpoint, firmware: lab_firmware(), attempt: "attempt-1" as AttemptIdentity, managed_user: 3, access: [ipmi_user_channel_access(channel: 1, user: 3, privilege: IpmiPrivilegeAdministrator)]) })) == "admitted"
}
