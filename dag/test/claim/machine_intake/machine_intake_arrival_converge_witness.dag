test fn w_a_precondition_is_not_satisfied_by_a_receipt_for_another_subject() -> Bool {
  let own_access = step_instance_key(run: run_a, step: access_discover_step_ref, subject: mtjade1_key)
  let foreign_access = step_instance_key(run: run_a, step: access_discover_step_ref, subject: "mtjade2" as StepSubjectKey)
  let identity = step_instance_key(run: run_a, step: identity_bind_provisional_step_ref, subject: mtjade1_key)
  let outcomes: List<StepOutcome<ProbeReceipt, String, String>> = [
    StepEstablished { receipt: ProbeReceipt { key: own_access, consumed: [] } },
    StepEstablished { receipt: ProbeReceipt { key: identity, consumed: [foreign_access] } },
  ]
  match admit_convergence_plan(planning: arrival_planning_authority(), steps: real_steps()) {
    ConvergencePlanAdmitted { plan: p } =>
      stopped_on_unmet_access_precondition(v: Present { value: fold_convergence_run(plan: p, run: run_a, subject: mtjade1_key, outcomes: outcomes, projection: convergence_receipt_projection(key_of: probe_key, consumed_of: probe_consumed, authorization_required_of: probe_auth_never), discharges: []) })
    ConvergencePlanRefused { cause: _ } => false
  }
}

// Nor by a receipt for the same subject read back in ANOTHER run (the fold's check, supplied).
test fn w_a_precondition_is_not_satisfied_by_a_receipt_from_another_run() -> Bool {
  let own_access = step_instance_key(run: run_a, step: access_discover_step_ref, subject: mtjade1_key)
  let earlier_access = step_instance_key(run: run_b, step: access_discover_step_ref, subject: mtjade1_key)
  let identity = step_instance_key(run: run_a, step: identity_bind_provisional_step_ref, subject: mtjade1_key)
  let outcomes: List<StepOutcome<ProbeReceipt, String, String>> = [
    StepEstablished { receipt: ProbeReceipt { key: own_access, consumed: [] } },
    StepEstablished { receipt: ProbeReceipt { key: identity, consumed: [earlier_access] } },
  ]
  match admit_convergence_plan(planning: arrival_planning_authority(), steps: real_steps()) {
    ConvergencePlanAdmitted { plan: p } =>
      stopped_on_unmet_access_precondition(v: Present { value: fold_convergence_run(plan: p, run: run_a, subject: mtjade1_key, outcomes: outcomes, projection: convergence_receipt_projection(key_of: probe_key, consumed_of: probe_consumed, authorization_required_of: probe_auth_never), discharges: []) })
    ConvergencePlanRefused { cause: _ } => false
  }
}

// AN INCOMPLETE INSTANCE STOPS ITS DEPENDENTS AND IS NEITHER CONVERGED NOR REFUSED (the fold's rule,
// SUPPLIED like the two controls above). Over the real admitted plan, AccessDiscover converges,
// IdentityBindProvisional is INCOMPLETE, and PriorLifeBoundary -- whose receipt here even claims to
// have consumed the incomplete instance -- is NotReached blocked by it: the verdict is RunIncomplete at
// IdentityBindProvisional, never RunConverged and never RunStopped.
test fn w_an_incomplete_instance_satisfies_no_dependent_and_the_run_is_incomplete() -> Bool {
  let own_access = step_instance_key(run: run_a, step: access_discover_step_ref, subject: mtjade1_key)
  let identity = step_instance_key(run: run_a, step: identity_bind_provisional_step_ref, subject: mtjade1_key)
  let prior_life = step_instance_key(run: run_a, step: prior_life_boundary_step_ref, subject: mtjade1_key)
  let outcomes: List<StepOutcome<ProbeReceipt, String, String>> = [
    StepEstablished { receipt: ProbeReceipt { key: own_access, consumed: [] } },
    StepIncomplete { key: identity, cause: "written, not read back" },
    StepEstablished { receipt: ProbeReceipt { key: prior_life, consumed: [identity] } },
  ]
  match admit_convergence_plan(planning: arrival_planning_authority(), steps: real_steps()) {
    ConvergencePlanAdmitted { plan: p } =>
      match fold_convergence_run(plan: p, run: run_a, subject: mtjade1_key, outcomes: outcomes, projection: convergence_receipt_projection(key_of: probe_key, consumed_of: probe_consumed, authorization_required_of: probe_auth_never), discharges: []) {
        RunIncomplete { ledger: l, at: at } =>
          declaration_ref_eq(a: at.step_identity, b: identity_bind_provisional_step_ref)
            && match l.instances.last() {
              Present { value: s } => match s {
                InstanceNotReached { key: k, blocked_by: b } => declaration_ref_eq(a: k.step_identity, b: prior_life_boundary_step_ref) && declaration_ref_eq(a: b.step_identity, b: identity_bind_provisional_step_ref)
                _ => false
              }
              Absent => false
            }
        _ => false
      }
    ConvergencePlanRefused { cause: _ } => false
  }
}

// THE DOMAIN'S OWN WALL, on the real path: IdentityBindProvisional refuses an AccessDiscover receipt
// that is not its own instance's -- here mtjade1's real receipt from another run -- before binding
// anything, so no IdentityBoundProvisional exists for a key its access receipt does not match.
test fn w_identity_bind_refuses_an_access_receipt_from_another_run() -> Bool {
  match established_access(o: real_access(run: run_b, subject: mtjade1_key, read: read_mtjade1_current_manager_read())) {
    Absent => false
    Present { value: earlier } => {
      let outcome: StepOutcome<ArrivalStepReceipt, ArrivalStepRefusal, ArrivalStepIncomplete> = identity_bind_provisional(key: step_instance_key(run: run_a, step: identity_bind_provisional_step_ref, subject: mtjade1_key), access: earlier, inputs: mtjade1_identity_bind_inputs())
      let refusal: ArrivalStepRefusal? = step_outcome_refusal(outcome: outcome)
      match refusal {
        Present { value: c } => match c { IdentityBindAccessForAnotherInstance { access: k } => ((k.run as NonEmptyStr) as String) == "o1c1-witness-run-b"  _ => false }
        Absent => false
      }
    }
  }
}

// AND PRIORLIFEBOUNDARY'S, on the real path: an IdentityBindProvisional receipt mtjade1 really minted
// in ANOTHER run cannot be archived under this run's instance. The step refuses naming that receipt's
// instance before the phase reads or writes anything, so no prior-life receipt exists for an identity
// instance its key does not match.
test fn w_prior_life_boundary_refuses_an_identity_receipt_from_another_run() -> Bool {
  match established_access(o: real_access(run: run_b, subject: mtjade1_key, read: read_mtjade1_current_manager_read())) {
    Absent => false
    Present { value: access_b } =>
      match step_outcome_receipt(outcome: identity_bind_provisional(key: step_instance_key(run: run_b, step: identity_bind_provisional_step_ref, subject: mtjade1_key), access: access_b, inputs: mtjade1_identity_bind_inputs())) {
        Present { value: r } =>
          match r {
            IdentityBindReceipt { receipt: identity_b } => {
              let outcome: StepOutcome<ArrivalStepReceipt, ArrivalStepRefusal, ArrivalStepIncomplete> = prior_life_boundary(key: step_instance_key(run: run_a, step: prior_life_boundary_step_ref, subject: mtjade1_key), identity: identity_b, platform: mt_jade_platform_ref, world: prior_life_minimal_dry_world(), across: none)
              let refusal: ArrivalStepRefusal? = step_outcome_refusal(outcome: outcome)
              match refusal {
                Present { value: c } => match c { PriorLifeIdentityForAnotherInstance { identity: k } => ((k.run as NonEmptyStr) as String) == "o1c1-witness-run-b"  _ => false }
                Absent => false
              }
            }
            _ => false
          }
        Absent => false
      }
  }
}

// A DUPLICATE (run, step, subject) REFUSES the run before any ledger is written.
test fn w_a_duplicate_run_step_subject_refuses() -> Bool {
  let access = real_access(run: run_a, subject: mtjade1_key, read: read_mtjade1_current_manager_read())
  match fold_real(run: run_a, subject: mtjade1_key, outcomes: [access, access]) {
    Present { value: v } => match v {
      RunOutcomesRefused { cause: c } => match c { OutcomeDuplicated { key: k } => declaration_ref_eq(a: k.step_identity, b: access_discover_step_ref)  _ => false }
      _ => false
    }
    Absent => false
  }
}

// A read bound to another unit does not establish this unit's access: the goal diverges and the
// read-only phase, having no remedy, refuses.
test fn w_access_discover_refuses_a_read_bound_to_another_unit() -> Bool {
  match step_outcome_refusal(outcome: real_access(run: run_a, subject: "mtjade2" as StepSubjectKey, read: read_mtjade1_current_manager_read())) {
    Present { value: c } => match c { ReadOnlyPhaseRefused { phase: p, reason: _ } => p == AccessDiscover  _ => false }
    Absent => false
  }
}

// A REFUSAL STOPS THE LINE OVER ITS DEPENDENTS, AND EACH NAMES ITS BLOCKER. The real read, run for a
// unit it is not bound to, refuses AccessDiscover; IdentityBindProvisional and PriorLifeBoundary are
// then never executed and are NotReached, each blocked by that AccessDiscover instance.
test fn w_a_refused_access_leaves_identity_bind_not_reached_blocked_by_it() -> Bool {
  match converge_arrival_prefix(run: run_a, subject: "mtjade2" as StepSubjectKey, read: read_mtjade1_current_manager_read(), inputs: mtjade1_identity_bind_inputs(), prior_life: PriorLifeInputs { platform: mt_jade_platform_ref, world: prior_life_minimal_dry_world() }, locked: none) {
    ArrivalRunFolded { verdict: v } => match v {
      RunStopped { ledger: l, at: at } =>
        declaration_ref_eq(a: at.step_identity, b: access_discover_step_ref)
          && length(xs: l.instances) == 3
          && length(xs: l.instances |> filter(s => match s {
            InstanceNotReached { key: _, blocked_by: b } => declaration_ref_eq(a: b.step_identity, b: access_discover_step_ref) && ((b.subject as NonEmptyStr) as String) == "mtjade2"
            _ => false
          })) == 2
          && match l.instances.last() {
            Present { value: s } => instance_step_is(s: s, step: prior_life_boundary_step_ref)
            Absent => false
          }
      _ => false
    }
    _ => false
  }
}

// ── O1a's control at the current endpoint ──────────────────────────────────────────────────────

// SUPPLIED: an operator approval of the rotation that names this exact controller, build and request,
// so the only thing left to refuse is the route. A Manager GET alone yields a candidate, and the
// ordinary rotation Apply refuses it as not grounded.
fn route_request_of(s: BmcRotationRouteStanding) -> BmcAccountWriteRequest {
  match s.grounding {
    RouteQualificationCandidate { request: r, evidence: _ } => r
    RouteGroundedByExecutedRequest { request: r, request_receipt: _, response_receipt: _, effect: _ } => r
    RouteGroundedByCitedSource { request: r, citation: _ } => r
    RouteUngrounded => IpmiSetUserPassword { user: 3 }
  }
}

fn rotation_approval_for(s: BmcRotationRouteStanding) -> ScopedAuthorization<BmcAccountWriteApproval> {
  let request = match s.grounding {
    RouteQualificationCandidate { request: r, evidence: _ } => r
    RouteGroundedByExecutedRequest { request: r, request_receipt: _, response_receipt: _, effect: _ } => r
    RouteGroundedByCitedSource { request: r, citation: _ } => r
    RouteUngrounded => IpmiSetUserPassword { user: 3 }
  }
  approved_bmc_write(standing: s, request: request, purpose: RotateCredential, attempt: "attempt-1" as NonEmptyStr)
}

test fn w_a_manager_get_alone_cannot_construct_an_account_write_route_at_the_current_endpoint() -> Bool {
  match established_access(o: real_access(run: run_a, subject: mtjade1_key, read: read_mtjade1_current_manager_read())) {
    Absent => false
    Present { value: a } =>
      rotation_route_is_grounded(standing: a.route) == false
        && match admit_rotation_apply(standing: a.route, target_endpoint: a.access.endpoint, target_firmware: a.access.firmware, request: route_request_of(s: a.route), managed_readback: none, approval: rotation_approval_for(s: a.route)) {
          RotationApplyRouteNotGrounded { standing: _ } => true
          _ => false
        }
  }
}

// ── the hold on mtjade1 (merry-fox-82, 2026-10-28) ────────────────────────────────────────────────────

fn mtjade1_discharge_released_by(qualification: RunnerThroughputAssessment<HostIdentity>?, grant: StandingOperatorGrant?, with_capability: Bool) -> Bool {
  match mtjade1_dry_applied_bmc(subject: mtjade1_intake_subject()) {
    Absent => false
    Present { value: apply } => {
      let standing = apply.application.plan.managed_write.route
      let request = apply.application.plan.managed_write.request
      let capability = if with_capability {
        Present { value: rotation_capability_for(standing: standing, request: request, attempt_text: run_a as String, purpose: RotateCredential) }
      } else {
        none
      }
      match discharge_bmc_secure_apply(
        key: bmc_secure_apply_key(),
        identity_subject: mtjade1_intake_subject(),
        inputs: mtjade1_bmc_inputs_released_by(reading: apply.application.plan.diverged, grant: grant, apply: Present { value: apply }, capability: capability, qualification: qualification),
        standing: standing,
        request: request,
      ) {
        Present { value: _ } => true
        Absent => false
      }
    }
  }
}

// THE RED AND ITS PAIR ON THE REAL DISCHARGE. Without mtcollins1's qualification, mtjade1's standing grant
// discharges nothing and neither does an exact per-write approval; the same two inputs with the
// qualification supplied discharge.
test fn w_mtjade1_is_held_for_both_routes_until_mtcollins1_qualifies() -> Bool {
  let no_release: RunnerThroughputAssessment<HostIdentity>? = none
  !mtjade1_discharge_released_by(qualification: no_release, grant: Present { value: mtjade1_live_standing_grant }, with_capability: false)
    && !mtjade1_discharge_released_by(qualification: no_release, grant: none, with_capability: true)
    && mtjade1_discharge_released_by(qualification: Present { value: mtcollins1_qualified() }, grant: Present { value: mtjade1_live_standing_grant }, with_capability: false)
    && mtjade1_discharge_released_by(qualification: Present { value: mtcollins1_qualified() }, grant: none, with_capability: true)
}

// An assessment of mtcollins1 that refused (here: no concurrent cohort observed) releases nothing.
test fn w_an_assessment_that_does_not_hold_releases_nothing() -> Bool {
  !mtjade1_discharge_released_by(qualification: Present { value: mtcollins1_not_qualified() }, grant: Present { value: mtjade1_live_standing_grant }, with_capability: true)
}

// THE HOLD ON THE CONVERGE PATH. The run that converges with the release supplied
// (w_bmc_secure_apply_with_the_mtjade1_standing_grant_converges_over_the_dry_world) does not converge
// without it: it stops at BmcSecure.
test fn w_a_held_mtjade1_does_not_converge_through_bmc_secure_apply() -> Bool {
  let no_release: RunnerThroughputAssessment<HostIdentity>? = none
  match mtjade1_dry_applied_bmc(subject: mtjade1_intake_subject()) {
    Absent => false
    Present { value: apply } =>
      match converge_arrival_through_bmc_secure(
        run: run_a,
        subject: mtjade1_key,
        read: read_mtjade1_current_manager_read(),
        inputs: mtjade1_identity_bind_inputs(),
        prior_life: PriorLifeInputs { platform: mt_jade_platform_ref, world: prior_life_minimal_dry_world() },
        bmc: mtjade1_bmc_inputs_released_by(
          reading: apply.application.plan.diverged,
          grant: Present { value: mtjade1_live_standing_grant },
          apply: Present { value: apply },
          capability: none,
          qualification: no_release,
        ),
        locked: none,
      ) {
        ArrivalRunFolded { verdict: v } =>
          match v {
            RunConverged { run: _ } => false
            RunStopped { ledger: _, at: at } => step_instance_key_eq(a: at, b: bmc_secure_apply_key())
            _ => false
          }
        _ => false
      }
  }
}

// ──────────────────────────────────────────────────────────────────────────────────────────────
// FORCED-CHANGE ARRIVAL: the §3b divergence row ForcedFirstRotationPrecedesPriorLife, and the typed
// third outcome PriorLifeIndeterminateAcrossForcedWrite. Design approved by merry-fox-82 on 2026-10-29;
// arrival_phases_all is UNTOUCHED -- the row places one EFFECT before a standing, it does not reorder the
// order of standings. NO live effect: the whole sequence runs over the dry model.
//
// ONE UNIT, ONE RUN (the P1-a fix). Every record the row joins is srv13's, and every one comes from ONE run
// of the real producers:
//   the 403                          -- srv13's committed factory-login capture of the 03.22.00 push, read
//                                       through the credential-policy row's own verdict (forced_state_at);
//   the authenticated Manager read   -- read_srv13_current_manager_read: srv13's post-rotation Redfish Manager
//                                       read, digest-checked against that directory's SHA256SUMS;
//   the account read before the write, -- dry_read_bmc_account_state / plan_bmc_account_action /
//   the plan, the dry apply, and the    dry_apply_bmc_account_plan over ONE BmcWorld, inside
//   authenticated read after it         forced_write_sequence_at (machine_intake_bmc_forced_first_rotation_witness);
//   the pre-write archive            -- dry_archive_prior_life for srv13's subject, read before the write begins.
// The pending is minted under THIS run's AccessDiscover step instance, and the write's attempt IS this run's
// intake attempt (intake_attempt_of_run), so the classifier joins the ACTIVE instance rather than a supporting
// record that merely agrees with another one -- the class filed as a recurring_failure_mode row by this PR.
//
// WHAT IS NOT CAPTURE-GROUNDED HERE, and says so in its type: srv13's FRU and SMBIOS observations. srv13 has a
// Redfish capture set, no ipmitool FRU print, no UEFI smbiosview type-2 transcript, and its Redfish System
// serial is the unprovisioned factory placeholder "$PRODUCT_SERIAL_NUMBER". The identity leg comes from the
// witness mints (mtjade1_access_observation witness_recorded_fru_identity / witness_recorded_smbios_serial,
// admitted only here) and carries FruIdentityWitnessSupplied / SmbiosIdentityWitnessSupplied, so nothing in
// this control can be read as a measured
// identity. The producers of those record types are grounded by the inhabitance claim above (read_mtjade1_fru /
// read_mtjade1_smbios_type2 over mtjade1's committed capture set), and the ALTRAD8UD readers are declared as
// mtjade1_access_observation.altrad8ud_identity_readers_frontier.
//
// THE ORDERING IS OBSERVER ORDERING, NOT A LABEL (the P1-b fix). Nothing below passes a write instant or calls
// an archive "pre-write": the boundary derives the order from the sealed read_at of the archives and the write
// leg's own begin/completion, produced by forced_first_rotation_write_leg. AdmittedForcedFirstRotation is an
// ADMISSION, not a completion, so it anchors nothing.

data srv13_key: StepSubjectKey = "srv13" as StepSubjectKey

// The observer-clock order the boundary reads: srv13's archive is read, the write leg begins, the leg is read
// as complete, the archive is read again after it. Millis on the modeled archive clock -- the same clock the
// archives and the leg deadline are sealed on (see the PR body: cross-realization comparability of
// ObserverClockInstant is a declared follow-up, not this change).
data t_srv13_pre_capture: EpochMs = 1791158300000
data t_srv13_pre_capture_returned: EpochMs = 1791158302000
data t_srv13_write_began: EpochMs = 1791158360000
data t_srv13_write_finished: EpochMs = 1791158365000
// THE WRITE LANDS INSIDE ITS LEG: the application's stamped instant, between the leg's start and completion.
data t_srv13_apply: EpochMs = 1791158362000
data t_srv13_post_read: EpochMs = 1791158460000
data t_srv13_post_read_returned: EpochMs = 1791158462000

// srv13's prior-life world at an observer instant of the run's choosing. The shared dry carrier model; the
// archive arm is what the boundary reads. The platform row is mtjade1's because no ALTRAD8UD product brief is
// committed yet -- the row selects which carriers matter, it is not a claim about srv13's firmware.
// The world read at a chosen observer instant, with its archive write RETURNED on the same leg two seconds
// later: the return belongs to the read's leg, so moving the read moves the return. A world whose return
// predates its read, or lands outside the write leg's budget, is an archive write that never completed --
// the producer refuses it, and no claim may read an archive out of it.
fn srv13_prior_life_world(read_at: EpochMs, returned_at: EpochMs) -> DryPriorLifeWorld {
  let full = prior_life_full_dry_world()
  dry_world_at(bmc: full.bmc, store: full.store, read_at: read_at, returned_at: returned_at)
}

fn srv13_empty_prior_life_world(read_at: EpochMs, returned_at: EpochMs) -> DryPriorLifeWorld {
  let z = zero_entry_world()
  dry_world_at(bmc: z.bmc, store: z.store, read_at: read_at, returned_at: returned_at)
}

// THE POST-WRITE ARCHIVE WORLD, read a minute after the write finished (so its sealed read_at is after the
// leg's completion) -- with entries, and with none at all for the indeterminate RED.
fn srv13_post_world() -> DryPriorLifeWorld {
  srv13_prior_life_world(read_at: t_srv13_post_read, returned_at: t_srv13_post_read_returned)
}

fn srv13_empty_post_world() -> DryPriorLifeWorld {
  srv13_empty_prior_life_world(read_at: t_srv13_post_read, returned_at: t_srv13_post_read_returned)
}

// THE RUN'S OWN PRE-WRITE CAPTURE: the real archive producer, for srv13's subject, read at `read_at` -- before
// the write leg begins. Minted, never labelled.
fn srv13_pre_capture(run: ConvergenceRunId, intake: MachineIntakeSubject, read_at: EpochMs, returned_at: EpochMs) -> PriorLifeArchive? {
  match dry_archive_prior_life(
    key: step_instance_key(run: run, step: prior_life_boundary_step_ref, subject: srv13_key),
    consumed_identity: step_instance_key(run: run, step: identity_bind_provisional_step_ref, subject: srv13_key),
    subject: intake,
    platform: mt_jade_platform_ref,
    world: srv13_prior_life_world(read_at: read_at, returned_at: returned_at),
    forced_inference: none,
  ).outcome {
    PriorLifeArchiveEstablished { receipt: r } => Present { value: prior_life_receipt_archive(r) }
    _ => none
  }
}

// srv13's identity inputs, WITNESS-SUPPLIED and typed as such (see the banner above): the board product its
// first contact recorded (ALTRAD8UD-1L2T) and a board serial MODELED FOR THIS WITNESS -- srv13's real board
// serial has no committed capture, so no value here may read as a measured one, and borrowing another unit's
// real serial (srv14's in-band BR80S6102300077) would put a captured fact under srv13's name. The values carry
// FruIdentityWitnessSupplied / SmbiosIdentityWitnessSupplied; no capture path, digest or SOL session is implied.
data srv13_witness_board_serial: NonEmptyStr = "SRV13-WITNESS-BOARD-01" as NonEmptyStr

fn srv13_witness_realization() -> NonEmptyStr {
  "witness-supplied: srv13 has no committed FRU print and no SOL smbiosview transcript; the board product is as recorded at first contact, the serial is modeled for this witness; PR 2's ALTRAD8UD readers replace this (mtjade1_access_observation.altrad8ud_identity_readers_frontier)" as NonEmptyStr
}

fn srv13_witness_fru_fields() -> FruIdentityFields {
  FruIdentityFields {
    board_serial: srv13_witness_board_serial,
    board_part_number: "ALTRAD8UD-1L2T" as NonEmptyStr,
    board_product: "ALTRAD8UD-1L2T" as NonEmptyStr,
    chassis_part_number: "ALTRAD8UD-1L2T" as NonEmptyStr,
    chassis_serial: srv13_witness_board_serial,
  }
}

// WHO MAY HOLD THE CARRIER. The two mints inside this helper are admitted only to it, so closing THIS helper
// is what closes the chain: an unrestricted function that returns a sealed IdentityBindInputs would let any
// module write `fn borrowed() -> IdentityBindInputs { srv13_identity_bind_inputs() }` and receive witness-
// provenanced identity through a mint that saw its admitted caller (the escape the side chat named). Only the
// witness's own observation wrapper and the six claims that run the forced-change path may call it; the
// forged-probe claim the_witness_identity_carrier_helpers_refuse_an_outside_caller calls it from an outside
// module and asserts the refusal, paired with the positive control that calls it legitimately.
fn srv13_identity_bind_inputs() -> IdentityBindInputs
  admit_callers: [
    decl_ref(module_path: "test.claim.machine_intake.machine_intake_arrival_converge_witness", decl_name: "srv13_witness_fru_observation"),
    decl_ref(module_path: "test.claim.machine_intake.machine_intake_arrival_converge_witness", decl_name: "w_forced_change_unit_sequence_converges_under_the_row"),
    decl_ref(module_path: "test.claim.machine_intake.machine_intake_arrival_converge_witness", decl_name: "w_a_forced_state_from_another_run_or_controller_cannot_take_the_row"),
    decl_ref(module_path: "test.claim.machine_intake.machine_intake_arrival_converge_witness", decl_name: "w_a_matching_forced_pair_from_another_run_cannot_take_the_row"),
    decl_ref(module_path: "test.claim.machine_intake.machine_intake_arrival_converge_witness", decl_name: "w_a_matching_forced_pair_for_another_controller_cannot_take_the_row"),
    decl_ref(module_path: "test.claim.machine_intake.machine_intake_arrival_converge_witness", decl_name: "w_zero_pre_write_entries_take_the_indeterminate_third_outcome_on_the_real_path"),
    decl_ref(module_path: "test.claim.machine_intake.machine_intake_arrival_converge_witness", decl_name: "w_a_post_write_build_that_disagrees_with_the_forced_response_makes_bmc_secure_refuse"),
  ]
{
  witness_identity_bind_inputs(
    fru: FruObserved {
      observation: witness_recorded_fru_identity(
        subject: "srv13" as NonEmptyStr,
        fields: srv13_witness_fru_fields(),
        realization: srv13_witness_realization(),
      ),
    },
    smbios: SmbiosObserved {
      observation: witness_recorded_smbios_serial(
        subject: "srv13" as NonEmptyStr,
        serial: srv13_witness_board_serial,
        realization: srv13_witness_realization(),
      ),
    },
    other_units: arrival_bound_unit_keys(),
  )
}

// THE SAME SUBJECT THE FOLD BINDS, NOT A WITNESS GUESS OF IT. IdentityBindProvisional binds the unit key from
// the agreed board serial (gunbc.machine_intake.subject bind_unit_key) and derives the assembly from the FRU
// read and the firmware manifest from THIS run's Manager read; the prior-life boundary and BmcSecure then join
// their records to THAT subject. So the witness derives it through the same three functions the step uses,
// from the same inputs -- otherwise the pre-write capture and the write sequence would be joined to a subject
// the fold never binds, which is the failure class this change is about.
// THE OBSERVATION WRAPPER IS CLOSED TOO: returning the sealed observation from an unrestricted helper would
// be the same escape one level down. Its only consumer is the subject fixture below, which the two leg
// fixtures call, and they are closed to the claims.
fn srv13_witness_fru_observation() -> RecordedFruObservation?
  admit_callers: [
    decl_ref(module_path: "test.claim.machine_intake.machine_intake_arrival_converge_witness", decl_name: "srv13_intake_for_run"),
  ]
{
  match srv13_identity_bind_inputs().fru {
    FruObserved { observation: o } => Present { value: o }
    FruReadRefused { gap: _ } => none
  }
}

// The authenticated AccessDiscover of the run: the post-write Manager read of the captured controller, through
// the real step. Its receipt is what the identity step binds from, so the firmware manifest below is the one
// the fold's IdentityBindProvisional would carry.
fn srv13_access_of_run(run: ConvergenceRunId) -> AccessDiscoverEstablished? {
  match access_discover_from_read(
    key: step_instance_key(run: run, step: access_discover_step_ref, subject: srv13_key),
    read: read_srv13_current_manager_read(),
  ) {
    StepEstablished { receipt: AccessDiscoverReceipt { receipt: a } } => Present { value: a }
    _ => none
  }
}

fn srv13_intake_for_run(run: ConvergenceRunId) -> MachineIntakeSubject?
  admit_callers: [
    decl_ref(module_path: "test.claim.machine_intake.machine_intake_arrival_converge_witness", decl_name: "captured_leg_for_run"),
    decl_ref(module_path: "test.claim.machine_intake.machine_intake_arrival_converge_witness", decl_name: "foreign_leg_for_run"),
  ]
{
  match srv13_access_of_run(run: run) {
    Absent => none
    Present { value: access } =>
      match srv13_witness_fru_observation() {
        Absent => none
        Present { value: fru } =>
          Present {
            value: MachineIntakeSubject {
              subject: qualification_subject_of(
                unit_key: srv13_witness_board_serial as UnitKey,
                assembly: provisional_assembly_of_fru(fru: fru),
                firmware: live_firmware_manifest(access: access),
              ),
              attempt_id: intake_attempt_of_run(run: run),
            },
          }
      }
  }
}

// ONE RUN'S WHOLE FORCED LEG: the subject that run's IdentityBindProvisional binds, that run's own pre-write
// archive (read before the write leg begins), and that run's write transition, plan and authenticated
// readback -- all produced by the real producers under ONE subject and ONE attempt. `captured_unit` picks the
// controller the producers read at: srv13's own address, or another controller's address for the
// matching-foreign-controller RED.
type ForcedRunLeg sole_constructor {
  subject: MachineIntakeSubject
  pre_capture: PriorLifeArchive
  sequence: ForcedWriteSequence
}

fn captured_leg_for_run(run: ConvergenceRunId, began: EpochMs, finished: EpochMs) -> ForcedRunLeg? {
  match srv13_intake_for_run(run: run) {
    Absent => none
    Present { value: intake } =>
      match srv13_pre_capture(
        run: run,
        intake: intake,
        read_at: t_srv13_pre_capture,
        returned_at: t_srv13_pre_capture_returned,
      ) {
        Absent => none
        Present { value: pre } =>
          match forced_sequence_for_the_captured_unit(
            subject: intake,
            pre_capture: Present { value: pre },
            began_millis: began,
            finished_millis: finished,
            applied_at_millis: t_srv13_apply,
          ) {
            Absent => none
            Present { value: seq } => Present { value: ForcedRunLeg { subject: intake, pre_capture: pre, sequence: seq } }
          }
      }
  }
}

fn foreign_leg_for_run(run: ConvergenceRunId, began: EpochMs, finished: EpochMs) -> ForcedRunLeg? {
  match srv13_intake_for_run(run: run) {
    Absent => none
    Present { value: intake } =>
      match srv13_pre_capture(
        run: run,
        intake: intake,
        read_at: t_srv13_pre_capture,
        returned_at: t_srv13_pre_capture_returned,
      ) {
        Absent => none
        Present { value: pre } =>
          match forced_sequence_for_the_foreign_unit(
            subject: intake,
            pre_capture: Present { value: pre },
            began_millis: began,
            finished_millis: finished,
            applied_at_millis: t_srv13_apply,
          ) {
            Absent => none
            Present { value: seq } => Present { value: ForcedRunLeg { subject: intake, pre_capture: pre, sequence: seq } }
          }
      }
  }
}

// THE SEQUENCE FOR THE CAPTURED UNIT: srv13's own -- the controller the committed 403 and the committed
// post-rotation Manager read are of.
fn forced_sequence_for_the_captured_unit(subject: MachineIntakeSubject, pre_capture: PriorLifeArchive?, began_millis: EpochMs, finished_millis: EpochMs, applied_at_millis: EpochMs) -> ForcedWriteSequence? {
  srv13_forced_write_sequence(subject: subject, pre_capture: pre_capture, began_millis: began_millis, finished_millis: finished_millis, applied_at_millis: applied_at_millis)
}

// THE SEQUENCE FOR ANOTHER CONTROLLER: the same producers at srv4's address. Internally consistent -- forced
// state, route standing, approval, plan, application and readback all name that controller -- which is what
// makes the matching-foreign-controller RED a join test rather than a mismatch test.
fn forced_sequence_for_the_foreign_unit(subject: MachineIntakeSubject, pre_capture: PriorLifeArchive?, began_millis: EpochMs, finished_millis: EpochMs, applied_at_millis: EpochMs) -> ForcedWriteSequence? {
  srv4_forced_write_sequence(subject: subject, pre_capture: pre_capture, began_millis: began_millis, finished_millis: finished_millis, applied_at_millis: applied_at_millis)
}

// BmcSecure's inputs for the forced path: the run's goal, and the AUTHENTICATED read the sequence produced
// after the write -- not a hand-built "secured" reading.
// The goal the forced write realizes is the goal the run converges BmcSecure under: the readback was taken
// under it (plan_bmc_account_action's goal, generation 2 of the managed reference), and the assessment
// refuses any other. Passing the pre-write goal here would be a second, disagreeing source for which
// generation this controller is managed at.
fn forced_bmc_inputs(goal: BmcSecureGoal, readback: BmcAccountStateObservation) -> BmcSecureInputs {
  BmcSecureInputs {
    goal: goal,
    reading: readback,
    grant: none,
    capability: none,
    apply: none,
    hold_release: none,
  }
}

// AN AUTHENTICATED READ OF THE SAME CONTROLLER, SUBJECT AND ATTEMPT AT ANOTHER BUILD: the read a post-write
// controller answers when its firmware is not the build the 403 inferred. Same producers, same world, a
// different build identity -- the disagreement RED (iv) consumes it.
//
// WHAT THIS READ IS NOT: 03.22.00 shares ONE password per account between Redfish and the managed account, and
// its faithful dry surface is the Redfish account read (crisp-gull-572's item 3, PR #15370 --
// gunbc.bmc_model's Redfish world), not this IPMI-modeled read. The Redfish read replaces this call and the
// sequence's reads when it lands; that is a follow-up, not a blocker, and nothing here claims the IPMI shape is
// what 03.22.00 serves (the build row already records IPMI lanplus as NOT grounded for this build).
fn srv13_read_at_build(subject: MachineIntakeSubject, firmware: BmcFirmwareReleaseIdentity) -> BmcAccountStateObservation {
  let attempt = (subject.attempt_id as NonEmptyStr) as AttemptIdentity
  dry_read_bmc_account_state(
    world: world_root(password: generation_1),
    subject: subject,
    endpoint: srv13(),
    board: lab_board(),
    firmware: firmware,
    managed: goal_v1().managed,
    managed_user: root_user,
    managed_password: generation_1,
    census: srv13_dry_census(),
    published_user: root_user,
    published_password: published_password,
    published_account: PublishedAccountRetired,
    break_glass: goal_v1().published_break_glass,
    break_glass_password: generation_1,
    published_reading: derive_over(served: redfish_only),
    attempt: attempt,
    read_at_millis: t_readback,
    lockout: lockout_both_served(read_at: t_readback, redfish_threshold: 20, ipmi_channel: 1, ipmi_threshold: 20),
  )
}

fn forced_fold(
  run: ConvergenceRunId,
  subject: StepSubjectKey,
  pending: AccessForcedChangePending,
  read: CurrentManagerRead,
  bind: IdentityBindInputs,
  world: DryPriorLifeWorld,
  transition: ForcedFirstRotationWriteTransition,
  write: AdmittedForcedFirstRotation,
  bmc: BmcSecureInputs,
) -> ArrivalPrefixVerdict {
  converge_arrival_forced_through_bmc_secure(
    run: run,
    subject: subject,
    pending: pending,
    read: read,
    inputs: bind,
    prior_life: PriorLifeInputs { platform: mt_jade_platform_ref, world: world },
    transition: transition,
    bmc: bmc,
    write: write,
    locked: none,
  )
}

// The prior-life standing SAYS WHAT IT RESTED ON: the row's typed inference rides the established receipt, so a
// reader of the standing sees the premise (an inference, not a fact) instead of having to find the row.
fn prior_life_established_carries_the_rows_inference(s: StepInstanceStanding<ArrivalStepReceipt, ArrivalStepRefusal, ArrivalStepIncomplete>) -> Bool {
  match s {
    InstanceConverged { key: k, receipt: r } =>
      declaration_ref_eq(a: k.step_identity, b: prior_life_boundary_step_ref)
        && match r {
          PriorLifeBoundaryReceipt { receipt: p } => match p.forced_write_inference {
            Present { value: _ } => true
            Absent => false
          }
          _ => false
        }
    _ => false
  }
}

// THE PENDING STATE OF A RUN'S AccessDiscover STEP, minted once here: the claims name the run and subject they
// fold under, and this builds the key the row admission compares its pending against. The mint admits exactly
// this helper (gunbc.machine_intake.arrival_converge access_forced_change_pending), so no claim mints it itself.
fn forced_pending_for(run: ConvergenceRunId, subject: StepSubjectKey, forced: PublishedCredentialChangeForced) -> AccessForcedChangePending {
  access_forced_change_pending(
    key: step_instance_key(run: run, step: access_discover_step_ref, subject: subject),
    forced: forced,
  )
}

// POSITIVE CONTROL, on the real arrival path. The forced state, the approval, the write, the application, the
// readback, the archive and the run all describe ONE unit (srv13) and ONE run (run_a, whose intake attempt is
// the attempt the write was admitted under): the subject is the one that run's IdentityBindProvisional binds,
// the pre-write archive is that run's own read, and the transition, plan and authenticated readback are that
// run's producers' output. The row is taken, the four instances establish in the normal phase order, and
// BmcSecure's Noop establishes in its normal place -- carrying the row's typed inference on the prior-life
// standing, so a reader of the standing sees what it rested on.
// Rung: the real fold driver over the real producers.
test fn w_forced_change_unit_sequence_converges_under_the_row() -> Bool uses fs: std.resources.Filesystem {
  match captured_leg_for_run(
    run: run_a,
    began: t_srv13_write_began,
    finished: t_srv13_write_finished,
  ) {
    Absent => false
    Present { value: leg } =>
      match forced_fold(
        run: run_a,
        subject: srv13_key,
        pending: forced_pending_for(run: run_a, subject: srv13_key, forced: leg.sequence.transition.leg.write.forced),
        read: read_srv13_current_manager_read(),
        bind: srv13_identity_bind_inputs(),
        world: srv13_post_world(),
        transition: leg.sequence.transition,
        write: leg.sequence.transition.leg.write,
        bmc: forced_bmc_inputs(goal: leg.sequence.goal, readback: leg.sequence.post_read),
      ) {
        ArrivalRunFolded { verdict: v } =>
          match v {
            RunConverged { run: r } =>
              length(xs: r.ledger.instances) == 4
                && match r.ledger.instances |> filter(s => instance_step_is(s: s, step: bmc_secure_step_ref)) |> first() {
                  Present { value: s } => bmc_secure_noop_established(s: s)
                  Absent => false
                }
                && match r.ledger.instances |> filter(s => instance_step_is(s: s, step: prior_life_boundary_step_ref)) |> first() {
                  Present { value: s } => prior_life_established_carries_the_rows_inference(s: s)
                  Absent => false
                }
            _ => false
          }
        _ => false
      }
  }
}

// (i) RED. A NON-FORCING build cannot take the row. mtjade1's build row answers no forced-change verdict, so
// admit_published_credential_change_forced mints no forced state at all -- condition (a) is carried by the
// sealed PublishedCredentialChangeForced, and re-testing the policy row here would be a validation where
// construction holds (DESIGN §5). The control's second half then shows the row cannot be borrowed either: hand
// srv13's own admitted write to a fold running under mtjade1's subject, authenticated read and identity inputs,
// and the row admission refuses. Paired positive: the srv13 control above, identical but for the unit.
// Rung: the real credential-policy verdict, then the real fold driver over the real producers.
test fn w_a_non_forcing_build_cannot_take_the_forced_first_rotation_row() -> Bool uses fs: std.resources.Filesystem {
  match admit_published_credential_change_forced(
    reading: controller_reading(
      endpoint: lab_endpoint,
      attempt: "attempt-1" as AttemptIdentity,
      board: mt_collins_board_authority,
      login: "admin" as NonEmptyStr,
      status: 401,
      body: "{\"error\":{\"code\":\"Base.1.16.0.GeneralError\",\"message\":\"unauthorized\"}}" as NonEmptyStr,
      capture: srv13_capture,
      firmware: ForcedChangeBuildUnreadable,
    ),
  ) {
    ForcedChangeAdmitted { state: _ } => false
    ForcedChangeRefused { cause: _ } =>
      match captured_leg_for_run(
        run: run_a,
        began: t_srv13_write_began,
        finished: t_srv13_write_finished,
      ) {
        Absent => false
        Present { value: leg } =>
          match forced_fold(
            run: run_a,
            subject: mtjade1_key,
            pending: forced_pending_for(run: run_a, subject: mtjade1_key, forced: leg.sequence.transition.leg.write.forced),
            read: read_mtjade1_current_manager_read(),
            bind: mtjade1_identity_bind_inputs(),
            world: prior_life_minimal_dry_world(),
            transition: leg.sequence.transition,
            write: leg.sequence.transition.leg.write,
            bmc: forced_bmc_inputs(goal: leg.sequence.goal, readback: leg.sequence.post_read),
          ) {
            // srv13's write folded under mtjade1's run: the controller join refuses. A non-forcing build never
            // reaches the row at all -- there is no forced state to carry it.
            ArrivalForcedRowNotAdmitted { key: _ } => true
            _ => false
          }
      }
  }
}

// (ii) RED. A forced state from ANOTHER controller cannot take the row: the pending carries srv13's forced
// state, while the write handed the ladder was admitted from ANOTHER controller's own 403, route standing and
// approval (srv4's producers, run under the same attempt). Both are real admissions of real readings; what
// refuses is that they are not the same controller's. Paired positive: the srv13 control above, where every
// record is srv13's.
// Rung: the real fold driver over the real producers of both controllers.
test fn w_a_forced_state_from_another_run_or_controller_cannot_take_the_row() -> Bool uses fs: std.resources.Filesystem {
  match captured_leg_for_run(
