fn cited_mtjade1_managed_route() -> BmcRotationRouteStanding
  admit_callers: [
    decl_ref(module_path: "test.claim.machine_intake.machine_intake_arrival_converge_witness", decl_name: "mtjade1_dry_applied_bmc"),
  ]
{
  rotation_route_from_citation(
    endpoint: mtjade1_bmc_endpoint(),
    firmware: mtjade1_bmc_firmware(),
    request: IpmiSetUserPassword { user: mtjade1_managed_ipmi_user },
    citation: mtjade1_route_fixture_citation,
