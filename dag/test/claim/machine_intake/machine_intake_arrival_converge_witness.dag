          goal: mtjade1_bmc_goal(),
          reading: reading,
          grant: Present { value: mtjade1_live_standing_grant },
          apply: Present { value: BmcSecureApplyInputs { application: stamped, post_read: apply.post_read } },
          capability: none,
          hold_release: Present { value: mtcollins1_qualified() },
        },
      ) {
        StepRefused { key: _, cause: c } => match c { BmcSecureApplicationNotTheInspectedTransition => true  _ => false }
        _ => false
      }
    }
  }
}

