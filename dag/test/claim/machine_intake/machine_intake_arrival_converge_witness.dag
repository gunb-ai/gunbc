// (iii) RED, THE GAP CLOSED. The post-write archive shows NO entry from before the write instant. The verdict
// is RunIncomplete (NOT RunStopped -- a plain refusal would brick every factory-fresh unit) with the incomplete
// cause carrying the PriorLifeIndeterminateAcrossForcedWrite, whose options name the operator decision
// (confirm factory-fresh vs quarantine). The pre-write capture IS this run's and IS ordered before the write;
// what is missing is an entry from before it, and fresh-and-erased read alike.
// Paired positive: w_forced_change_unit_sequence_converges_under_the_row (an entry before the write establishes
// normally and the run converges).
// Rung: the real fold driver -- the prior_life instance is Incomplete with that cause, and bmc_secure is not reached.
test fn w_zero_pre_write_entries_take_the_indeterminate_third_outcome_on_the_real_path() -> Bool uses fs: std.resources.Filesystem {
  match captured_leg_for_run(
    run: run_a,
    began: t_srv13_write_began,
    finished: t_srv13_write_finished,
  ) {
    Absent => false
    Present { value: leg } =>
      match forced_fold(
        run: run_a,
        subject: srv13_key,
        pending: forced_pending_for(run: run_a, subject: srv13_key, forced: leg.sequence.transition.leg.write.forced),
        read: read_srv13_current_manager_read(),
        bind: srv13_identity_bind_inputs(),
        world: srv13_empty_post_world(),
        transition: leg.sequence.transition,
        write: leg.sequence.transition.leg.write,
        bmc: forced_bmc_inputs(goal: leg.sequence.goal, readback: leg.sequence.post_read),
      ) {
        ArrivalRunFolded { verdict: v } =>
          match v {
            RunIncomplete { ledger: l, at: at } =>
              declaration_ref_eq(a: at.step_identity, b: prior_life_boundary_step_ref)
                && match l.instances |> filter(s => instance_step_is(s: s, step: prior_life_boundary_step_ref)) |> first() {
                  Present { value: s } => match s {
                    InstanceIncomplete { key: _, cause: c } => match c {
                      ForcedWritePriorLifeIndeterminate { verdict: i } =>
                        match i.grounds { PreCaptureOrderedForThisRun {} => true  _ => false }
                          && match i.standing { NoPriorLifeEntries {} => true  _ => false }
                          && (length(xs: i.options) == 2)
                      PriorLifeBoundaryIncomplete { cause: _ } => false
                    }
                    _ => false
                  }
                  Absent => false
                }
            _ => false
          }
        _ => false
      }
  }
}

// (iv) RED. The authenticated read after the write answers a build that is NOT the build inferred from the 403:
// BmcSecure refuses with its own arm, naming both builds, and the run stops before BmcSecure establishes.
// Paired positive: w_forced_change_unit_sequence_converges_under_the_row, where the read answers 3.22.00.
// Rung: the real fold driver -- the bmc_secure instance is refused, with the disagreement as its cause.
test fn w_a_post_write_build_that_disagrees_with_the_forced_response_makes_bmc_secure_refuse() -> Bool uses fs: std.resources.Filesystem {
  match captured_leg_for_run(
    run: run_a,
    began: t_srv13_write_began,
    finished: t_srv13_write_finished,
  ) {
    Absent => false
    Present { value: leg } =>
      match forced_fold(
        run: run_a,
        subject: srv13_key,
        pending: forced_pending_for(run: run_a, subject: srv13_key, forced: leg.sequence.transition.leg.write.forced),
        read: read_srv13_current_manager_read(),
        bind: srv13_identity_bind_inputs(),
        world: srv13_post_world(),
        transition: leg.sequence.transition,
        write: leg.sequence.transition.leg.write,
        bmc: forced_bmc_inputs(
          goal: leg.sequence.goal,
          readback: srv13_read_at_build(subject: leg.subject, firmware: bmc_firmware_release_identity_of_wire(family: OpenBmc, wire: "3.03.00" as NonEmptyStr)),
        ),
      ) {
        ArrivalRunFolded { verdict: v } =>
          match v {
            RunStopped { ledger: l, at: at } =>
              step_instance_key_eq(a: at, b: step_instance_key(run: run_a, step: bmc_secure_step_ref, subject: srv13_key))
                && match l.instances |> filter(s => instance_step_is(s: s, step: bmc_secure_step_ref)) |> first() {
                  Present { value: s } => match s {
                    InstanceRefused { key: _, cause: c } => match c {
                      DomainRefused { cause: BmcSecureForcedBuildDisagreesWithForcedResponse { inferred: _, read: _ } } => true
                      _ => false
                    }
                    _ => false
                  }
                  Absent => false
                }
            _ => false
          }
        _ => false
      }
  }
}












