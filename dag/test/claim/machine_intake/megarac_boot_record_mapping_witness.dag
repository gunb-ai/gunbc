  megarac_boot_run_record, MegaRacRunRecord, BootParam5Reading, BootParam5NotTaken,
  BootParam5Read, BootParam5Unread, BmcUnreachable,
  megarac_boot_override_consumption, megarac_power_after_from_observation,
  BootOverrideClears, boot_override_clears_none_found,
  megarac_override_release, megarac_stale_override_clearance, boot_param5_owes_clear,
  boot_param5_clear_not_required_reason, BootParam5Clear, BootParam5ClearIssued, BootParam5ClearNotIssued,
  BootOverrideClear, OverrideCleared, OverrideClearLeftPending, OverrideClearNotRequired, OverrideClearUnread,
  StaleOverrideClearance, StaleOverrideNoneFound, StaleOverrideCleared, StaleOverrideWouldNotClear, StaleOverrideUnread,
  StaleOverrideClearedUnread, boot_override_standing_after_clear,
