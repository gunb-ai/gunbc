module test.claim.machine_intake.megarac_boot_record_mapping_witness

// ── THE RAW-TO-NEUTRAL MAPPING WITNESS (cut 4d-ii) ──────────────────────────────────
//
// The bundle stores the RAW MegaRAC records once. There is no neutral BootRunRecord stored beside
// them -- that would be two representations of one boot, free to disagree. The neutral record is a
// CLASSIFICATION, produced on demand by gunbc.machine_intake.megarac_boot_diagnostic_bundle's
// mapping functions.
//
// This witness is what makes that safe. Every raw arm of every per-attempt record is pinned here to
// the neutral arm it must classify into. Add a raw arm without giving it a neutral case and this
// module stops compiling (the match is exhaustive); add one with a case that maps to the wrong arm,
// and the claim that fails is precisely "this raw arm classifies into that neutral arm". Without it,
// the single-storage rule would have no check at all: the raw records would be the only thing anyone
// ever looked at, and the neutral module's careful vocabulary would drift from them unnoticed.
//
// Each claim reads the mapping only -- no transport, no host, no row needed beyond the classifier's
// own inputs -- so a failure means the classification is wrong, not the read.

import std.types { NonEmptyStr }
import std.algebra { FreeSemigroup, length, non_empty_to_list, string_contains }
import std.decl_ref { DeclarationRef, decl_ref, declaration_ref_eq }
import std.dissolution { DissolutionPending, DissolutionFired }
import v2.std.decl_index { DeclFact, decl_facts_at }
import v2.std.decl_facts_skeleton { decl_facts_matching_qualified_name }
import std.measure { byte_size }
import extdeps.bmc.ipmi_chassis_control { ChassisPowerObservation, ChassisPowerRead, ChassisStatusUndecodable, ChassisUnreadable }
import gunbc.host.boot_attempt {
  HostPowerState, PowerOn, PowerOff, PowerUnread,
  BootPresentation, Presented, PresentationNotServed, PresentationSessionHeld, PresentationUnread,
  StalePowerOffNotNeeded, StalePowerOffObserved, StalePowerOffCommandRefused, StalePowerOffNotObserved,
  MediaAttachNotAttempted, MediaAttachAttempted,
  HandoffConfirmed, HandoffAttemptedUnconfirmed,
  HandoffMediaNotReached, HandoffMediaWithheldAtRecheck, HandoffMediaAttempted,
  EndMediaNotTaken, EndMediaObserved,
  PoweredOffAfterTerminal, PoweredOffWithoutTerminal, PoweredOnAfterAttempt, PowerAfterUnobserved, PowerAfterNotTaken,
  OverrideConsumedByAttempt, OverrideNoLongerPendingAfterAttempt, OverridePendingBeforeAttempt,
  OverrideStillPendingAfterAttempt, OverrideNotHandedOff, OverrideConsumptionUnread,
  // THE DECISIONS, NOW CALLED WHERE THEY LIVE. Review 81601 deleted the adapter's copies of the
  // power pairing and the override consumption (and the sums they were copied from), so these claims
  // call gunbc.host.boot_attempt's own functions and name the core's input carriers.
  power_after_attempt, boot_override_consumption,
  HostPowerReading, HostPowerRead, HostPowerNotTaken,
  BootOverrideStanding, OverrideFlagPending, OverrideFlagNotPending, OverrideReadUnanswered,
  StandingFinding, DerivedFinding, EveryReadFailed, CredentialMayRemain,
  MediaAttachNotReady, MediaAttachSessionHeld, HandoffWithheldAtRecheck,
  HandoffUnconfirmed, OverrideNotConsumed, PoweredOffWithoutTerminalMarker, CredentialMayRemain,
  PresentationAfterHandoff,
}
import gunbc.machine_intake.post_power_fan_gate_outcome { PostPowerFanGateNotReached }
import gunbc.machine_intake.megarac_media_attach {
  MegaRacAttachResult, MegaRacPresentationReady, MegaRacPresentationEvidence,
  MegaRacPresentationObserved, MegaRacSessionRefused, MegaRacRawRead, SessionRelease,
  SessionReleased, SessionReleaseRefused, SessionReleaseNotAttempted, RouteAlreadyPresented,
  // THE READ-ONLY LOOK, as the observe task actually returns it: a share standing, an attach readiness
  // parsed from a configurations document, a cd_error code. A look is not an attach, so a fixture for
  // one must be built from THESE and not from MegaRacPresentationReady -- see megarac_look_presentation.
  ShareBound, ShareMismatch, ShareUnreadable, MegaRacObservedShare, ShareBindingStanding,
  CdErrorRead, CdErrorNone, CdErrorUnread, CdErrorReading, AttachReadiness, ReadinessStarted,
  PresentingRow, MegaRacAttachOutcome,
}
import extdeps.bmc.megarac { MegaRacRedirectionStatus, RedirectionStartedConnectionAccepted }
import extdeps.bmc.capability { BmcFirmwareReleaseIdentity, bmc_firmware_release_identity_of_wire }
import extdeps.bmc.endpoint { AmiMegaRac }
import gunbc.host.boot_attempt {
  AttemptIdentityReading,
  DiagnosticRetained,
