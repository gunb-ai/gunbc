module test.claim.machine_intake.mtcollins1_boot_fan_gate_admission_witness

import std.types { String, Bool, Int }
import std.optional { Present, Absent }
import gunbc.compile_diagnostic_census { CompileDiagnosticCensus }
import gunbc.guarantee_probe_corpus { census_blocking_count_for_class }

// fan_gate_refuse IS THE ONLY DOOR TO THE PowerDown CHAIN (finish_refusal -> boot_fan_gate_safe_stop -> boot_fan_gate_power_down),
// so it is restricted to mtcollins1_boot_fan_gate (side-chat hold 2026-10-19). THE ADMITTED CALL is the production gate itself:
// it calls fan_gate_refuse and is admitted by the roster. This witness is admission checking plus diagnostic controls; it does not
// execute the live gate, and no import is credited with doing so. THE REFUSAL: a module
// outside the roster calling it is refused by the admission wall. THE POSITIVE CONTROL: the same probe shape calling an
// unrestricted sibling (fan_gate_write) is not refused, so the refusal is the roster and not a broken harness.
data outside_refuse_source: String = "module probe_fan_gate_refuse_outside\nimport gunbc.machine_intake.mtcollins1_boot_fan_gate { fan_gate_refuse }\nimport gunbc.machine_intake.chassis_fan_establishment { FittedFanSet, PostPowerFanRefusal }\nimport gunbc.machine_intake.bmc_fan_observation { FanObservationRound }\nimport gunbc.machine_intake.post_power_fan_gate_outcome { PostPowerFanGateOutcome, FanGateWrite }\nimport std.types { NonEmptyStr, String }\nfn outside(fitted: FittedFanSet, cause: PostPowerFanRefusal, observation: FanObservationRound, username: NonEmptyStr, password_file: NonEmptyStr) -> PostPowerFanGateOutcome {\n  fan_gate_refuse(fitted: fitted, cause: cause, observation: observation, username: username, password_file: password_file)\n}\n"

data outside_unrestricted_source: String = "module probe_fan_gate_write_outside\nimport gunbc.machine_intake.mtcollins1_boot_fan_gate { fan_gate_write }\nimport gunbc.machine_intake.chassis_fan_establishment { FittedFanSet, PostPowerFanRefusal }\nimport gunbc.machine_intake.bmc_fan_observation { FanObservationRound }\nimport gunbc.machine_intake.post_power_fan_gate_outcome { PostPowerFanGateOutcome, FanGateWrite }\nimport std.types { NonEmptyStr, String }\nfn outside(path: NonEmptyStr, content: String) -> FanGateWrite {\n  fan_gate_write(path: path, content: content)\n}\n"

fn refused_count(source: String) -> Int {
  match census_blocking_count_for_class(census: compile_dag_diagnostic_census(source), wanted: "ConstructorCallAdmissionRefused") {
    Present { value: n } => n
    Absent => 0 - 1
  }
}

test fn a_call_to_fan_gate_refuse_from_outside_the_gate_is_refused() -> Bool { refused_count(source: outside_refuse_source) >= 1 }

test fn the_same_probe_calling_an_unrestricted_sibling_is_not_refused() -> Bool { refused_count(source: outside_unrestricted_source) == 0 }
