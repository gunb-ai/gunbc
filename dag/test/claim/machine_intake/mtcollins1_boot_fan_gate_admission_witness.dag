module test.claim.machine_intake.mtcollins1_boot_fan_gate_admission_witness

import std.types { String, Int, Bool }
import std.process { ProcessExit }
import gunbc.compile_census_probe { blocking_class_census, census_verdict, census_exit, CensusVerdict }

// fan_gate_refuse IS THE ONLY DOOR TO THE PowerDown CHAIN (finish_refusal -> boot_fan_gate_safe_stop -> boot_fan_gate_power_down),
// so it is restricted to mtcollins1_boot_fan_gate (side-chat hold 2026-10-19). THE ADMITTED CALL is the production gate itself:
// it calls fan_gate_refuse and is admitted by the roster. This witness is admission checking plus diagnostic controls; it does not
// execute the live gate, and no import is credited with doing so. THE REFUSAL: a module
// outside the roster calling it is refused by the admission wall. THE POSITIVE CONTROL: the same probe shape calling an
// unrestricted sibling (fan_gate_write) is not refused, so the refusal is the roster and not a broken harness.
data outside_refuse_source: String = "module probe_fan_gate_refuse_outside\nimport gunbc.machine_intake.mtcollins1_boot_fan_gate { fan_gate_refuse }\nimport gunbc.machine_intake.chassis_fan_establishment { FittedFanSet, PostPowerFanRefusal }\nimport gunbc.machine_intake.bmc_fan_observation { FanObservationRound }\nimport gunbc.machine_intake.post_power_fan_gate_outcome { PostPowerFanGateOutcome, FanGateWrite }\nimport std.types { NonEmptyStr, String }\nfn outside(fitted: FittedFanSet, cause: PostPowerFanRefusal, observation: FanObservationRound, username: NonEmptyStr, password_file: NonEmptyStr) -> PostPowerFanGateOutcome {\n  fan_gate_refuse(fitted: fitted, cause: cause, observation: observation, username: username, password_file: password_file)\n}\n"

data outside_unrestricted_source: String = "module probe_fan_gate_write_outside\nimport gunbc.machine_intake.mtcollins1_boot_fan_gate { fan_gate_write }\nimport gunbc.machine_intake.chassis_fan_establishment { FittedFanSet, PostPowerFanRefusal }\nimport gunbc.machine_intake.bmc_fan_observation { FanObservationRound }\nimport gunbc.machine_intake.post_power_fan_gate_outcome { PostPowerFanGateOutcome, FanGateWrite }\nimport std.types { NonEmptyStr, String }\nfn outside(path: NonEmptyStr, content: String) -> FanGateWrite {\n  fan_gate_write(path: path, content: content)\n}\n"

fn refused_verdict(source: String, holds: fn(Int) -> Bool) -> CensusVerdict {
  census_verdict(census: blocking_class_census(source: source, wanted_class: "ConstructorCallAdmissionRefused"), holds: holds)
}

test fn a_call_to_fan_gate_refuse_from_outside_the_gate_is_refused() -> ProcessExit { census_exit(refused_verdict(source: outside_refuse_source, holds: fn(n) { n >= 1 })) }

test fn the_same_probe_calling_an_unrestricted_sibling_is_not_refused() -> ProcessExit { census_exit(refused_verdict(source: outside_unrestricted_source, holds: fn(n) { n == 0 })) }

// NO POWERED HOST REACHES THE BOOT WITHOUT A GATE THAT CAN STOP IT (merry-fox-82, 2026-10-24). Two facts make a
// powered host with unverified fans unrepresentable on the boot route, and each is held by a RED the compiler must
// refuse beside a control it must admit. (a) The powered gate (post_power_fan_gate_outcome PoweredFanGate), which
// mtcollins1_boot_run's power-on branch, actuation_watch_of and fan_gate_continuation carry, has no not-reached
// constructor: a probe returning PostPowerFanGateNotReached as one is a type mismatch, and the same probe returning a
// Reached gate is not. (b) The account a safe stop runs with is the power-on's own (managed_host_boot_handoff
// BootHandoffPoweredOn, sole_constructor, minted only where the power control was issued): a probe minting one is
// refused, and the same probe reading one is not.
data powered_gate_unreached_source: String = "module probe_powered_gate_unreached\nimport std.types { NonEmptyStr }\nimport gunbc.machine_intake.post_power_fan_gate_outcome { PoweredFanGate, PostPowerFanGateNotReached }\nfn unread(r: NonEmptyStr) -> PoweredFanGate {\n  PostPowerFanGateNotReached { reason: r }\n}\n"

data powered_gate_reached_source: String = "module probe_powered_gate_reached\nimport gunbc.machine_intake.post_power_fan_gate_outcome { PoweredFanGate, PostPowerFanGateReached, PostPowerFanGateOutcome }\nimport gunbc.machine_intake.chassis_fan_establishment { FittedFanSet }\nfn read(f: FittedFanSet, o: PostPowerFanGateOutcome) -> PoweredFanGate {\n  PostPowerFanGateReached { fitted: f, outcome: o }\n}\n"

data powered_on_minted_source: String = "module probe_powered_on_minted\nimport std.types { NonEmptyStr }\nimport gunbc.host.managed_host_boot_handoff { BootHandoffPoweredOn }\nfn minted(a: NonEmptyStr) -> BootHandoffPoweredOn {\n  BootHandoffPoweredOn { account: a }\n}\n"

data powered_on_read_source: String = "module probe_powered_on_read\nimport std.types { NonEmptyStr }\nimport gunbc.host.managed_host_boot_handoff { BootHandoffPoweredOn }\nfn read(p: BootHandoffPoweredOn) -> NonEmptyStr {\n  p.account\n}\n"

fn class_verdict(source: String, class: String, holds: fn(Int) -> Bool) -> CensusVerdict {
  census_verdict(census: blocking_class_census(source: source, wanted_class: class), holds: holds)
}

test fn a_powered_gate_has_no_unreached_constructor() -> ProcessExit { census_exit(class_verdict(source: powered_gate_unreached_source, class: "TypeMismatch", holds: fn(n) { n >= 1 })) }

test fn a_reached_gate_is_a_powered_gate() -> ProcessExit { census_exit(class_verdict(source: powered_gate_reached_source, class: "TypeMismatch", holds: fn(n) { n == 0 })) }

test fn a_power_on_record_cannot_be_minted_outside_the_handoff() -> ProcessExit { census_exit(class_verdict(source: powered_on_minted_source, class: "SoleConstructorViolation", holds: fn(n) { n >= 1 })) }

test fn a_power_on_record_can_be_read_outside_the_handoff() -> ProcessExit { census_exit(class_verdict(source: powered_on_read_source, class: "SoleConstructorViolation", holds: fn(n) { n == 0 })) }

