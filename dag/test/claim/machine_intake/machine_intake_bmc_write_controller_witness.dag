module test.claim.machine_intake.machine_intake_bmc_write_controller_witness

import std.types { Bool, NonEmptyStr, String }
import std.optional { Absent, Present }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import product.host_identity { HostIdentity }
import extdeps.bmc.endpoint { BmcControllerEndpoint }
import extdeps.github.workflow_runs { GitHubWorkflowRunId }
import gunbc.fleet.fleet_host_identity { operator_host_mtjade1, operator_host_mtcollins1, operator_host_srv2, operator_host_srv13, operator_host_srv15 }
import gunbc.runner.runner_throughput_qualification { RunnerThroughputAssessment }
import gunbc.machine_intake.bmc_write_controller {
  BmcWriteRoute, ByStandingGrant, ByPerWriteApproval, UntilRunnerQualified,
  BmcWriteControllerSelected, BmcWriteControllerRefused,
  NoControllerRowForHost, ControllerRowIsAnotherEndpoint, ControllerWritesHeld, StandingGrantNotAdmittedForController,
  mtjade1_bmc_write_controller, srv13_bmc_write_controller, srv15_bmc_write_controller, select_bmc_write_controller, hold_released,
}
import test.claim.runner.runner_throughput_qualification_witness { selection, good_run, assess_at_width, assess_unobserved }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE SELECTION INTERFACE, OVER ITS OWN ROWS. The release is the sealed mtcollins1 throughput assessment,
// built by the qualification witness's fixture: one that holds and one refused for an unobserved cohort.
// The discharge that consumes this selection is witnessed on the real arrival path in
// test.claim.machine_intake.machine_intake_arrival_converge_witness (w_mtjade1_is_held_for_both_routes_until_mtcollins1_qualifies).

fn qualified() -> RunnerThroughputAssessment<HostIdentity>? {
  Present { value: assess_at_width(selection: selection(), runs: [good_run(id: GitHubWorkflowRunId { value: 35447067113 })]) }
}

fn not_qualified() -> RunnerThroughputAssessment<HostIdentity>? {
  Present { value: assess_unobserved(selection: selection(), runs: [good_run(id: GitHubWorkflowRunId { value: 35447067113 })]) }
}

fn no_release() -> RunnerThroughputAssessment<HostIdentity>? {
  none
}

fn verdict(host: HostIdentity, target: BmcControllerEndpoint, route: BmcWriteRoute, qualification: RunnerThroughputAssessment<HostIdentity>?) -> String {
  match select_bmc_write_controller(host: host, target: target, route: route, qualification: qualification) {
    BmcWriteControllerSelected { row: _ } => "selected"
    BmcWriteControllerRefused { cause: c } =>
      match c {
        NoControllerRowForHost { host: _ } => "no-row"
        ControllerRowIsAnotherEndpoint { host: _, row_endpoint: _, target: _ } => "another-endpoint"
        ControllerWritesHeld { host: _, reason: _, until: _ } => "held"
        StandingGrantNotAdmittedForController { host: _ } => "standing-grant-not-admitted"
      }
  }
}

fn jade() -> BmcControllerEndpoint {
  mtjade1_bmc_write_controller.endpoint
}

fn srv13() -> BmcControllerEndpoint {
  srv13_bmc_write_controller.endpoint
}

// mtjade1 IS HELD FOR BOTH ROUTES, and only the assessment its hold names releases it: a refused
// assessment does not, and with a holding one both routes are selected (its row admits the standing grant
// once released).
test fn mtjade1_is_held_until_mtcollins1_qualifies() -> Bool {
  verdict(host: operator_host_mtjade1, target: jade(), route: ByStandingGrant, qualification: no_release()) == "held"
    && verdict(host: operator_host_mtjade1, target: jade(), route: ByPerWriteApproval, qualification: no_release()) == "held"
    && verdict(host: operator_host_mtjade1, target: jade(), route: ByPerWriteApproval, qualification: not_qualified()) == "held"
    && verdict(host: operator_host_mtjade1, target: jade(), route: ByStandingGrant, qualification: qualified()) == "selected"
    && verdict(host: operator_host_mtjade1, target: jade(), route: ByPerWriteApproval, qualification: qualified()) == "selected"
}

// A HOLD NAMES ITS HOST. mtcollins1's holding assessment does not release a hold that waits on another host.
test fn an_assessment_for_another_host_releases_nothing() -> Bool {
  hold_released(until: UntilRunnerQualified { host: operator_host_srv2 }, qualification: qualified()) == false
    && hold_released(until: UntilRunnerQualified { host: operator_host_mtcollins1 }, qualification: qualified())
}

// srv13 ADMITS ONLY A PER-WRITE APPROVAL (merry-fox-82, 2026-10-28). The standing-grant route is refused for
// srv13 by its row. This is the RED that discriminates the row: on the arrival discharge the only standing
// grant (mtjade1's) is scoped to mtjade1 and would refuse srv13 before the row is read.
test fn srv13_admits_a_per_write_approval_and_refuses_the_standing_grant() -> Bool {
  verdict(host: operator_host_srv13, target: srv13(), route: ByPerWriteApproval, qualification: no_release()) == "selected"
    && verdict(host: operator_host_srv13, target: srv13(), route: ByStandingGrant, qualification: no_release()) == "standing-grant-not-admitted"
}

// srv15 (box 2) ADMITS ONLY A PER-WRITE APPROVAL, at its own controller and not at srv13's.
test fn srv15_admits_a_per_write_approval_at_its_own_controller() -> Bool {
  let box2 = srv15_bmc_write_controller.endpoint
  verdict(host: operator_host_srv15, target: box2, route: ByPerWriteApproval, qualification: no_release()) == "selected"
    && verdict(host: operator_host_srv15, target: box2, route: ByStandingGrant, qualification: no_release()) == "standing-grant-not-admitted"
    && verdict(host: operator_host_srv15, target: srv13(), route: ByPerWriteApproval, qualification: no_release()) == "another-endpoint"
}

// A HOST WITH NO ROW ADMITS NO WRITE, and a row admits writes only at its own controller's endpoint.
test fn no_row_and_another_endpoint_refuse() -> Bool {
  verdict(host: operator_host_srv2, target: srv13(), route: ByPerWriteApproval, qualification: no_release()) == "no-row"
    && verdict(host: operator_host_srv13, target: jade(), route: ByPerWriteApproval, qualification: no_release()) == "another-endpoint"
}
