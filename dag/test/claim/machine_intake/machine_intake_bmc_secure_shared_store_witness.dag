data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// THE PUBLISHED ACCOUNT IS THE MANAGED ACCOUNT (OpenBMC root, ASRock ALTRAD8UD at 3.22.00). Every reading
// below is taken by dry_read_bmc_account_state from a gunbc.bmc_model BmcWorld, deriving the published
// credential's retirement under the build's credential-policy row (gunbc.machine_intake.bmc_credential_policy
// asrock_altrad8ud_openbmc_3_22_00_credential_policy) rather than probing it. The SUPPLIED boundaries are
// the operator's go (test.fixture.machine_intake.bmc_write_approval) and the Secret Manager fetch result;
// the route is a cited fixture standing, the grounded arm a witness may construct.

data lab_unit: UnitKey = "LAB-ROOT-0001" as UnitKey

data lab_assembly: AssemblyManifest = AssemblyManifest {
  chassis_part_number: "CH-LAB-ROOT",
  components: [ComponentIdentity { kind: DimmComponent, slot: "dimm0", identity: "SPD-LAB-ROOT-0" }],
}

data lab_firmware_manifest: FirmwareManifest = FirmwareManifest {
  entries: [FirmwareEntry { component: "bmc", version: "3.22.00" }],
  configuration_digests: [],
}

fn lab_subject() -> MachineIntakeSubject {
  MachineIntakeSubject {
    subject: qualification_subject_of(unit_key: lab_unit, assembly: lab_assembly, firmware: lab_firmware_manifest),
    attempt_id: "intake-20261028-root" as IntakeAttemptId,
  }
}

data lab_endpoint: BmcControllerEndpoint = BmcControllerEndpoint { host: "198.51.100.60" }

fn lab_firmware() -> BmcFirmwareReleaseIdentity {
  bmc_firmware_release_identity_of_wire(family: OpenBmc, wire: "3.22.00" as NonEmptyStr)
}

// root is IPMI user 1 on this board (the in-band recovery capture's `user list 1`).
data root_user: IpmiUserId = 1

data published_password: String = "0penBmc"
data generation_1: String = "root-generation-1!"
data generation_2: String = "root-generation-2!"

fn root_ref(version: NonEmptyStr, epoch: Int) -> ManagedCredentialReference {
  ManagedCredentialReference {
    account: "root",
    role: AccountRoleAdministrator,
    secret: SecretRef { project: "gunbai-secrets", secret: "bmc-lab-root-admin", version: version, hash_state: HashPending },
    credential_epoch: epoch,
  }
}

// One password per account: the goal's published half IS the managed generation.
fn goal_v1() -> BmcSecureGoal {
  BmcSecureGoal { managed: root_ref(version: "1", epoch: 1), published_break_glass: root_ref(version: "1", epoch: 1), policy: machine_qualification_policy(admits: TestRisk) }
}

fn census() -> IpmiControllerChannelCensus {
  ipmi_controller_channel_census(
    members: [ipmi_lan_channel_member(channel: 1, medium: IpmiMedium8023Lan, address: ipv4_address(octet1: 198, octet2: 51, octet3: 100, octet4: 60))],
    user_access: [ipmi_user_channel_access(channel: 1, user: root_user, privilege: IpmiPrivilegeAdministrator)],
  )
}

fn world_root(password: String) -> BmcWorld {
  bmc_with_ipmi_user_access(world: bmc_with_ipmi_users(world: bmc_world(power: BmcPowerOn), users: [BmcIpmiUser { id: 1, password: password }]), rows: census().user_access)
}

fn derive_over(served: List<CredentialSurface>) -> DryPublishedReading {
  DryDerivePublishedRetirement { published_account: "root" as NonEmptyStr, served: served }
}

// The lab controller's declared board: the board the 3.22.00 policy row was measured on.
fn lab_board() -> BoardAuthorityRef? {
  Present { value: asrock_altrad8ud_openbmc_3_22_00_key().board }
}

data redfish_only: List<CredentialSurface> = [RedfishBasicOrSession]

fn read_root(w: BmcWorld, managed: ManagedCredentialReference, password: String, served: List<CredentialSurface>, at: EpochMs) -> BmcAccountStateObservation
  admit_callers: [
    decl_ref(module_path: "test.claim.machine_intake.machine_intake_bmc_secure_shared_store_witness", decl_name: "decision_on"),
    decl_ref(module_path: "test.claim.machine_intake.machine_intake_bmc_secure_shared_store_witness", decl_name: "a_secured_root_controller_is_read_without_a_published_probe"),
    decl_ref(module_path: "test.claim.machine_intake.machine_intake_bmc_secure_shared_store_witness", decl_name: "the_root_rotation_is_one_write_and_a_second_published_write_refuses"),
    decl_ref(module_path: "test.claim.machine_intake.machine_intake_bmc_secure_shared_store_witness", decl_name: "the_root_rotation_applies_reads_back_and_converges"),
  ]
{
  dry_read_bmc_account_state(
    world: w,
    subject: lab_subject(),
    endpoint: lab_endpoint,
    board: lab_board(),
    firmware: lab_firmware(),
    managed: managed,
    managed_user: root_user,
    managed_password: password,
    census: census(),
    published_user: root_user,
    published_password: published_password,
    published_account: PublishedAccountRetired,
    break_glass: managed,
    break_glass_password: password,
    published_reading: derive_over(served: served),
    attempt: "attempt-1" as AttemptIdentity,
    read_at_millis: at,
    redfish_accounts: BmcRedfishCensusUnmodeled {},

    redfish_surface_served: false,

  )
}

data t_read: EpochMs = 1793145600000
data t_store: EpochMs = 1793145610000
data t_fetch: EpochMs = 1793145620000
data t_plan: EpochMs = 1793145630000
data t_apply: EpochMs = 1793145640000
data t_readback: EpochMs = 1793145650000

fn decision_label(d: UpsertDecision<BmcAccountActionDue>) -> String {
  match d {
    Noop => "noop"
    Apply { plan: _ } => "apply"
    Refuse { reason: _ } => "refuse"
  }
}

// The decision on a root controller holding `world_password`, read under the goal's generation 1.
fn decision_on(world_password: String, read_password: String, served: List<CredentialSurface>) -> String {
  match inspect_bmc_secure_state(subject: lab_subject(), goal: goal_v1(), reading: read_root(w: world_root(password: world_password), managed: root_ref(version: "1", epoch: 1), password: read_password, served: served, at: t_read)) {
    BmcSecureStateUnobserved { cause: _ } => "unobserved"
    BmcSecureStateInspected { observed: _, assessment: _, decision: d } => decision_label(d: d)
  }
}

// POSITIVE CONTROL AND THE COST IT AVOIDS. root holding generation 1, read under generation 1 on a build whose
// row grounds the Redfish surface as one store: the published credential's retirement is DERIVED (no probe
// list at all), and the controller is already secured -- a Noop, with no write and no failed login.
test fn a_secured_root_controller_is_read_without_a_published_probe() -> Bool {
  let reading = read_root(w: world_root(password: generation_1), managed: root_ref(version: "1", epoch: 1), password: generation_1, served: redfish_only, at: t_read)
  match reading.published_credential {
    PublishedCredentialRetiredOnTheManagedAccount { derivation: _ } => true
    PublishedCredentialProbed { probes: _ } => false
  }
    && decision_on(world_password: generation_1, read_password: generation_1, served: redfish_only) == "noop"
}

// THE RED: THE PUBLISHED CREDENTIAL STILL WORKS. A "generation" that is the published password retires
// nothing: the derivation refuses, the published state is unestablished, and BmcSecure refuses rather than
// reading the controller as secured -- even though the managed probe of that very password is accepted.
test fn a_generation_that_is_the_published_password_is_not_secured() -> Bool {
  decision_on(world_password: published_password, read_password: published_password, served: redfish_only) == "refuse"
}

// A SURFACE THE ROW DOES NOT GROUND IS NOT ASSUMED. The same secured controller, now read as also serving
// IPMI lanplus, which the 3.22.00 row does not (yet) ground as sharing root's password: no derivation, an
// unestablished published state, a refusal -- never a Noop.
test fn a_surface_the_policy_does_not_ground_refuses_the_derivation() -> Bool {
  decision_on(world_password: generation_1, read_password: generation_1, served: [RedfishBasicOrSession, IpmiLanplus]) == "refuse"
}

// ── the rotation ────────────────────────────────────────────────────────────────────────────────

data lab_route_citation: ExternalAuthority = ExternalAuthority { uri: uri_https(locator: "example.invalid/root-route-witness-citation" as NonEmptyStr) }

fn cited_root_route() -> BmcRotationRouteStanding
  admit_callers: [
    decl_ref(module_path: "test.claim.machine_intake.machine_intake_bmc_secure_shared_store_witness", decl_name: "plan_root"),
  ]
{
  rotation_route_from_citation(endpoint: lab_endpoint, firmware: lab_firmware(), request: redfish_account_password_write(account: "root" as NonEmptyStr), citation: lab_route_citation)
}

fn version_identity(version: String) -> SmResolvedVersionIdentity {
  join(["projects/gunbai-secrets/secrets/bmc-lab-root-admin/versions/", version], "") as SmResolvedVersionIdentity
}

fn ready(version: String, bytes: String) -> SecretCredentialFetch {
  SecretCredentialReady { credential: bytes as Secret, resolved_version: version_identity(version: version) }
}

fn generation_v2(store_at: ObserverClockInstant, fetch_at: ObserverClockInstant) -> ManagedCredentialGenerationFetched? {
  match admit_stored_generation(current: root_ref(version: "1", epoch: 1), added: version_identity(version: "2"), stored_at: store_at) {
    GenerationStoreRefused { cause: _ } => none
    GenerationStored { stored: st } =>
      match admit_fetched_generation(stored: st, fetch: ready(version: "2", bytes: generation_2), fetched_at: fetch_at) {
        GenerationFetchRefused { cause: _ } => none
        GenerationFetched { fetched: f } => Present { value: f }
      }
  }
}

// root still holding the published password: the managed generation 1 is rejected, so the decision is an
// Apply (the account action remedies it), and the plan is computed over the cited Redfish root route.
fn plan_root(reading: BmcAccountStateObservation, separate: Bool, store_at: ObserverClockInstant, fetch_at: ObserverClockInstant, plan_at: ObserverClockInstant) -> BmcAccountPlanOutcome? {
  let route = cited_root_route()
  match generation_v2(store_at: store_at, fetch_at: fetch_at) {
    Absent => none
    Present { value: g } => {
      let published = if separate { PublishedWriteInputs { route: route, generation: g } } else { PublishedAccountIsTheManagedAccount }
      let go = approved_bmc_convergence(approval: bmc_secure_convergence_approval(goal: goal_v1(), reading: reading, managed_user: root_user, managed_route: route, published: published), attempt: "attempt-1" as NonEmptyStr)
      Present {
        value: plan_bmc_account_action(
          subject: lab_subject(),
          goal: goal_v1(),
          reading: reading,
          managed_user: root_user,
          managed_route: route,
          approval: go,
          managed_generation: g,
          published: published,
          channel_close: none,
          planned_at: plan_at,
        ),
      }
    }
  }
}

data schedule: NonEmptyStr = "test.claim.machine_intake.machine_intake_bmc_secure_shared_store_witness schedule" as NonEmptyStr

// ONE ACCOUNT, ONE WRITE. The plan for root is one Redfish password write of root; its published half is
// that same write, and the plan's goal carries generation 2 for both halves. Supplying a separate published
// write for the same user refuses: it would repeat the managed write.
test fn the_root_rotation_is_one_write_and_a_second_published_write_refuses() -> Bool {
  let store_at = observer_clock_modeled(millis: t_store, realization: schedule)
  let fetch_at = observer_clock_modeled(millis: t_fetch, realization: schedule)
  let plan_at = observer_clock_modeled(millis: t_plan, realization: schedule)
  let before = read_root(w: world_root(password: published_password), managed: root_ref(version: "1", epoch: 1), password: generation_1, served: redfish_only, at: t_read)
  let one = match plan_root(reading: before, separate: false, store_at: store_at, fetch_at: fetch_at, plan_at: plan_at) {
    Absent => false
    Present { value: o } =>
      match o {
        BmcAccountPlanRefused { cause: _ } => false
        BmcAccountPlanned { plan: p } =>
          (p.goal.published_break_glass.secret.version as String) == "2"
            && match p.published_write { PublishedIsTheManagedWrite => true  PublishedWrittenSeparately { write: _ } => false }
      }
  }
  let repeated = match plan_root(reading: before, separate: true, store_at: store_at, fetch_at: fetch_at, plan_at: plan_at) {
    Absent => false
    Present { value: o } =>
      match o {
        BmcAccountPlanned { plan: _ } => false
        BmcAccountPlanRefused { cause: c } => match c { PublishedWriteWouldRepeatTheManagedWrite { user: u } => (u as Int) == 1  _ => false }
      }
  }
  one && repeated
}

// THE ROUTE END TO END, DRY. Plan, apply over the dry world (the one write lands generation 2 on root), read
// back independently under generation 2 with the retirement derived, and the phase converges. A readback
// that still finds the published password refuses.
test fn the_root_rotation_applies_reads_back_and_converges() -> Bool {
  let store_at = observer_clock_modeled(millis: t_store, realization: schedule)
  let fetch_at = observer_clock_modeled(millis: t_fetch, realization: schedule)
  let plan_at = observer_clock_modeled(millis: t_plan, realization: schedule)
  let initial = world_root(password: published_password)
  let before = read_root(w: initial, managed: root_ref(version: "1", epoch: 1), password: generation_1, served: redfish_only, at: t_read)
  match plan_root(reading: before, separate: false, store_at: store_at, fetch_at: fetch_at, plan_at: plan_at) {
    Absent => false
    Present { value: o } =>
      match o {
        BmcAccountPlanRefused { cause: _ } => false
        BmcAccountPlanned { plan: p } => {
          let step = dry_apply_bmc_account_plan(world: initial, plan: p, managed_fetch: ready(version: "2", bytes: generation_2), published_fetch: ready(version: "2", bytes: generation_2), applied_at_millis: t_apply)
          let after = read_root(w: step.world, managed: p.goal.managed, password: generation_2, served: redfish_only, at: t_readback)
          let stale = read_root(w: initial, managed: p.goal.managed, password: generation_2, served: redfish_only, at: t_readback)
          match bmc_secure_phase_applied(application: step.application, post_read: after) {
            BmcSecurePhaseConverged { receipt: _ } => true
            BmcSecurePhaseRefused { cause: _ } => false
          }
            && match bmc_secure_phase_applied(application: step.application, post_read: stale) {
              BmcSecurePhaseConverged { receipt: _ } => false
              BmcSecurePhaseRefused { cause: _ } => true
            }
        }
      }
  }
}

// ── the derivation is bound to the board and build it was read on (review of gunbc#15317) ───────────
//
// The policy key is not supplied beside the reading: the dry read derives it from the reading's own declared
// board and observed build, so a derivation under another board's or build's row is not expressible through
// it. retired_on_the_managed_account still joins the derivation's key to the observation's, for any other
// producer of the observation.

fn build(wire: NonEmptyStr) -> BmcFirmwareReleaseIdentity {
  bmc_firmware_release_identity_of_wire(family: OpenBmc, wire: wire)
}

// root holding generation 1, read under generation 1, on `board` at `firmware`.
fn read_root_on(board: BoardAuthorityRef?, firmware: BmcFirmwareReleaseIdentity, served: List<CredentialSurface>) -> BmcAccountStateObservation
  admit_callers: [
    decl_ref(module_path: "test.claim.machine_intake.machine_intake_bmc_secure_shared_store_witness", decl_name: "derived_on"),
    decl_ref(module_path: "test.claim.machine_intake.machine_intake_bmc_secure_shared_store_witness", decl_name: "decision_on_build"),
  ]
{
  dry_read_bmc_account_state(
    world: world_root(password: generation_1),
    subject: lab_subject(),
    endpoint: lab_endpoint,
    board: board,
    firmware: firmware,
    managed: root_ref(version: "1", epoch: 1),
    managed_user: root_user,
    managed_password: generation_1,
    census: census(),
    published_user: root_user,
    published_password: published_password,
    published_account: PublishedAccountRetired,
    break_glass: root_ref(version: "1", epoch: 1),
    break_glass_password: generation_1,
    published_reading: derive_over(served: served),
    attempt: "attempt-1" as AttemptIdentity,
    read_at_millis: t_read,
    redfish_accounts: BmcRedfishCensusUnmodeled {},

    redfish_surface_served: false,

  )
}

fn derived_on(board: BoardAuthorityRef?, firmware: BmcFirmwareReleaseIdentity, served: List<CredentialSurface>) -> Bool {
  match read_root_on(board: board, firmware: firmware, served: served).published_credential {
    PublishedCredentialRetiredOnTheManagedAccount { derivation: _ } => true
    PublishedCredentialProbed { probes: _ } => false
  }
}

fn decision_on_build(board: BoardAuthorityRef?, firmware: BmcFirmwareReleaseIdentity, served: List<CredentialSurface>) -> String {
  match inspect_bmc_secure_state(subject: lab_subject(), goal: goal_v1(), reading: read_root_on(board: board, firmware: firmware, served: served)) {
    BmcSecureStateUnobserved { cause: _ } => "unobserved"
    BmcSecureStateInspected { observed: _, assessment: _, decision: d } => decision_label(d: d)
  }
}

// NO SURFACES IS NOT EVERY SURFACE COVERED. A discovery that established no served surface derives nothing,
// and BmcSecure refuses; the same read with the Redfish surface served is the Noop
// (a_secured_root_controller_is_read_without_a_published_probe).
test fn an_empty_served_set_derives_nothing() -> Bool {
  let f = asrock_altrad8ud_openbmc_3_22_00_key().firmware
  !derived_on(board: lab_board(), firmware: f, served: [])
    && decision_on_build(board: lab_board(), firmware: f, served: []) == "refuse"
    && derived_on(board: lab_board(), firmware: f, served: redfish_only)
}

// A BUILD NOBODY MEASURED DERIVES NOTHING, even read at that very build on the measured board.
test fn a_build_with_no_policy_row_derives_nothing() -> Bool {
  let older = build(wire: "3.06.00" as NonEmptyStr)
  !derived_on(board: lab_board(), firmware: older, served: redfish_only)
    && decision_on_build(board: lab_board(), firmware: older, served: redfish_only) == "refuse"
}

// THE BOARD IS HALF THE KEY. The 3.22.00 row was measured on the ALTRAD8UD board: the same build read on
// another board, or on a controller whose board no row declares, derives nothing and refuses; the reading on
// the measured board and build is the Noop (paired control).
test fn another_board_or_an_undeclared_board_derives_nothing() -> Bool {
  let f = asrock_altrad8ud_openbmc_3_22_00_key().firmware
  let other: BoardAuthorityRef? = Present { value: mt_collins_board_authority }
  let undeclared: BoardAuthorityRef? = none
  !derived_on(board: other, firmware: f, served: redfish_only)
    && decision_on_build(board: other, firmware: f, served: redfish_only) == "refuse"
    && !derived_on(board: undeclared, firmware: f, served: redfish_only)
    && decision_on_build(board: undeclared, firmware: f, served: redfish_only) == "refuse"
    && decision_on_build(board: lab_board(), firmware: f, served: redfish_only) == "noop"
}
