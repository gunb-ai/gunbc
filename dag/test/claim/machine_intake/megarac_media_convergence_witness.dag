    ShareUnreadable { detail: _ } => true
    _ => false
  }
}

// THE CODE IS A RAW OBSERVATION; no meaning is established for it. 18:37Z (boot run 36721915217): code 16
// while the re-attached image read Started, session 0.
data cd_clean: CdErrorReading = CdErrorRead { code: CdErrorNone }
data cd_16: CdErrorReading = cd_error_reading(body: mtcollins1_media_general_2026_09_27, firmware: megarac_firmware_0_32)

// The 18:37Z receipt with only cd_error_code changed, so every other member stays the controller's.
fn general_coded(code: String) -> String {
  join(split(s: mtcollins1_media_general_2026_09_27, delimiter: "\"cd_error_code\": 16"), concat("\"cd_error_code\": ", code))
}

fn raw_at(body: String) -> MegaRacRawRead {
  MegaRacRawRead { answered: true, body: body, observed_at: Present { value: 13100 } }
}

fn ready_after(cd_before: CdErrorReading, general: String) -> MegaRacAttachOutcome {
  readiness_wait_outcome(wait: ReadinessWaitReady { look: look(at: 13000, status: "1", session: "0"), looks: 4, in_interval: look(at: 1100, status: "0", session: "255") }, image_name: desired_census, firmware: megarac_firmware_0_32, route: RouteAttached { image_list_index: "5", start: WriteAccepted { body: "{}" } }, cd_before: cd_before, general_at_end: raw_at(body: general))
}

fn gate_of(outcome: MegaRacAttachOutcome) -> String {
  match megarac_boot_media_gate(record: attempted(result: MegaRacAttachResult { outcome: outcome, session_release: SessionReleased, baseline: none , secret_file: SecretFileRemoved })) {
    MediaGateWithheld { reason: r } => concat("WITHHELD: ", r as String)
    MediaGateReady { evidence: _ } => "READY"
  }
}

// ─── EVERY NONZERO CODE IS THE RAW NUMBER ────────────────────────────────────────────────────────
// No value is given a meaning: a nonzero code reads as itself with the firmware it came from, and the
// attach policy admits only 16 on 0.32 (the boot run's reading), by policy rather than by decoding.
fn nonzero_is(r: CdErrorReading, expected: Int) -> Bool {
  match r { CdErrorRead { code: CdErrorNonzero { wire: w, firmware: _ } } => w == expected  _ => false }
}

fn cd_attach_policy_admits(r: CdErrorReading) -> Bool {
  match r { CdErrorRead { code: c } => cd_error_attach_policy_admits(code: c)  _ => false }
}

test fn a_nonzero_code_reads_as_the_raw_number_and_only_16_on_0_32_is_admitted_by_policy() -> Bool {
  nonzero_is(r: cd_16, expected: 16)
    && nonzero_is(r: cd_error_reading(body: general_coded(code: "11"), firmware: megarac_firmware_0_32), expected: 11)
    && nonzero_is(r: cd_error_reading(body: general_coded(code: "18"), firmware: megarac_firmware_0_32), expected: 18)
    && cd_attach_policy_admits(r: cd_16)
    && !cd_attach_policy_admits(r: cd_error_reading(body: general_coded(code: "11"), firmware: megarac_firmware_0_32))
    && !cd_attach_policy_admits(r: cd_error_reading(body: mtcollins1_media_general_2026_09_27, firmware: bmc_firmware_release_identity_of_wire(family: AmiMegaRac, wire: "0.33")))
}

// ─── STARTED: THE CODE IS RECORDED, NEVER WITHHELD ON ───────────────────────────────────────────
test fn a_named_code_beside_a_started_presentation_is_ready_and_recorded() -> Bool {
  (match ready_after(cd_before: cd_16, general: general_coded(code: "11")) {
    MegaRacPresentationReady { route: _, evidence: e } =>
      (match e.cd_at_ready { CdErrorRead { code: CdErrorNonzero { wire: w, firmware: _ } } => w == 11  _ => false })
        && nonzero_is(r: e.cd_before_any_write, expected: 16)
    _ => false
  })
    && gate_of(outcome: ready_after(cd_before: cd_16, general: mtcollins1_media_general_2026_09_27)) == "READY"
}

// AN UNCATALOGUED CODE BESIDE STARTED IS ALSO ONLY RECORDED: the code is never withheld on while
// started, whatever it reads. The red for this arm is the unread code below.
test fn a_code_outside_the_table_beside_a_started_presentation_is_ready_and_recorded() -> Bool {
  (match ready_after(cd_before: cd_clean, general: general_coded(code: "42")) {
    MegaRacPresentationReady { route: _, evidence: e } => (match e.cd_at_ready { CdErrorRead { code: CdErrorNonzero { wire: w, firmware: _ } } => w == 42  _ => false })
    _ => false
  })
    && gate_of(outcome: ready_after(cd_before: cd_clean, general: general_coded(code: "42"))) == "READY"
}

test fn an_unread_code_at_readiness_withholds_as_unestablished() -> Bool {
  match readiness_wait_outcome(wait: ReadinessWaitReady { look: look(at: 13000, status: "1", session: "0"), looks: 4, in_interval: look(at: 1100, status: "0", session: "255") }, image_name: desired_census, firmware: megarac_firmware_0_32, route: RouteAlreadyPresented, cd_before: cd_clean, general_at_end: MegaRacRawRead { answered: false, body: "curl: (28)", observed_at: none }) {
    MegaRacMediaStateUnestablished { image_name: _, route: _, look: _, looks: _, cd_before_any_write: _, cd_at_ready: CdErrorUnread { detail: d }, general_at_ready: _ } => d == "curl: (28)"
    _ => false
  }
}

// A CODE THAT APPEARS DURING THE WAIT: on an already-presented row it refuses (the wait writes nothing, so the
// row is refused rather than stopped), carrying the code; on an attach it stays a recorded observation beside the
// Started row, the existing disposition that boot 11 does not reach.
test fn a_code_appearing_at_readiness_refuses_an_already_presented_row_and_is_recorded_on_an_attach() -> Bool {
  (match readiness_wait_outcome(wait: ReadinessWaitReady { look: look(at: 13000, status: "1", session: "0"), looks: 4, in_interval: look(at: 1100, status: "1", session: "0") }, image_name: desired_census, firmware: megarac_firmware_0_32, route: RouteAlreadyPresented, cd_before: cd_clean, general_at_end: raw_at(body: general_coded(code: "16"))) {
    MegaRacPresentedRowNotServing { image_name: n, configurations: _, cd_error: e, not_replaced: _ } => (n as String) == (desired_census as String) && nonzero_is(r: e, expected: 16)
    _ => false
  })
    && (match ready_after(cd_before: cd_clean, general: general_coded(code: "16")) {
      MegaRacPresentationReady { route: _, evidence: e } => nonzero_is(r: e.cd_at_ready, expected: 16)
      _ => false
    })
}

test fn a_clean_code_at_readiness_is_ready() -> Bool {
  match readiness_wait_outcome(wait: ReadinessWaitReady { look: look(at: 13000, status: "1", session: "0"), looks: 4, in_interval: look(at: 1100, status: "0", session: "255") }, image_name: desired_census, firmware: megarac_firmware_0_32, route: RouteAlreadyPresented, cd_before: cd_16, general_at_end: raw_at(body: mtcollins1_media_general_2026_09_27_morning_as_reported)) {
    MegaRacPresentationReady { route: _, evidence: e } => (match e.cd_at_ready { CdErrorRead { code: CdErrorNone } => true _ => false })
    _ => false
  }
}

// ─── BOOT RUN 36721915217, ITS OWN READINGS ─────────────────────────────────────────────────────
// RECEIPT, VERBATIM (run 36721915217, artifact mtcollins1-boot-receipts, mtcollins1-boot-diagnostics.txt):
// general settings at readiness (answered at 1790776024628) and the configurations row of the Started
// look (session_index 0). cd_error_code read 16 before any write, after the stop and at readiness; the
// run refused as "cannot establish the media state". Under the grounded reading it is ready.
data run_36721915217_general_at_ready: String = "{ \"id\": 1, \"local_media_support\": 0, \"remote_media_support\": 1, \"same_settings\": 0, \"cd_remote_server_address\": \"192.168.1.188\", \"cd_remote_source_path\": \"\\/srv\\/bmc\", \"cd_remote_share_type\": \"nfs\", \"cd_remote_domain_name\": \"\", \"cd_remote_user_name\": \"\", \"mount_cd\": 1, \"cd_image_name\": \"\", \"cd_error_code\": 16, \"mount_hd\": 0, \"hd_remote_server_address\": \"\", \"hd_remote_source_path\": \"\", \"hd_remote_share_type\": \"\", \"hd_remote_domain_name\": \"\", \"hd_remote_user_name\": \"\", \"hd_image_name\": \"\", \"hd_error_code\": 0, \"rmedia_retry_count\": 3, \"rmedia_retry_interval\": 15 }"

data run_36721915217_configurations_at_ready: String = "[ { \"id\": 1, \"media_type\": 1, \"media_index\": 0, \"session_index\": 0, \"image_name\": \"gunbc-mtcollins1-census-ubuntu-24.04.3-arm64-161b98b9bb389a80.iso\", \"redirection_status\": 1 } ]"

data run_36721915217_image: NonEmptyStr = "gunbc-mtcollins1-census-ubuntu-24.04.3-arm64-161b98b9bb389a80.iso"

test fn boot_run_36721915217_readings_now_admit() -> Bool {
  let general = MegaRacRawRead { answered: true, body: run_36721915217_general_at_ready, observed_at: Present { value: 1790776024628 } }
  let started = ReadinessLook { observed_at: 1790776024465, reading: attach_readiness(answered: true, body: run_36721915217_configurations_at_ready, image_name: run_36721915217_image, firmware: megarac_firmware_0_32) }
  let outcome = readiness_wait_outcome(wait: ReadinessWaitReady { look: started, looks: 7, in_interval: started }, image_name: run_36721915217_image, firmware: megarac_firmware_0_32, route: RouteAttached { image_list_index: "6", start: WriteAccepted { body: "{}" } }, cd_before: cd_error_reading(body: run_36721915217_general_at_ready, firmware: megarac_firmware_0_32), general_at_end: general)
  (match outcome {
    MegaRacPresentationReady { route: _, evidence: e } =>
      e.session_index == Present { value: "0" }
        && nonzero_is(r: e.cd_at_ready, expected: 16)
    _ => false
  })
    && (match megarac_boot_media_gate(record: MegaRacMediaAttachAttempted { attempt: "36721915217", medium_image_name: run_36721915217_image, medium_image_sha256: "161b98b9bb389a80", power: ChassisPowerRead { power_on: false }, stale_power_off: MegaRacStalePowerOffNotNeeded { reason: "the host was read off" }, result: MegaRacAttachResult { outcome: outcome, session_release: SessionReleased, baseline: none , secret_file: SecretFileRemoved } }) {
      MediaGateReady { evidence: _ } => true
      MediaGateWithheld { reason: _ } => false
    })
}

// ─── STOPPED: A TIMEOUT CARRYING THE RAW CODE ───────────────────────────────────────────────────
// The wait closes on a look that finds nothing presented (the row stopped, status 0). Whatever the code
// reads, that is a timeout that carries the code as observed; no code turns it into a named stop.
fn closed_stopped(general: String) -> MegaRacAttachOutcome {
  readiness_wait_outcome(wait: ReadinessWaitClosed { last: look(at: 43000, status: "0", session: "255"), deadline: 43000, looks: 16 }, image_name: desired_census, firmware: megarac_firmware_0_32, route: RouteAttached { image_list_index: "5", start: WriteAccepted { body: "{}" } }, cd_before: cd_clean, general_at_end: raw_at(body: general))
}

fn timed_out_at(general: String, expected: Int) -> Bool {
  match closed_stopped(general: general) {
    MegaRacReadinessTimedOut { image_name: _, route: _, last: _, deadline: _, looks: n, cd_before_any_write: _, cd_at_refusal: c } => n == 16 && nonzero_is(r: c, expected: expected)
    _ => false
  }
}

test fn a_stopped_presentation_is_a_timeout_whatever_the_code_reads() -> Bool {
  timed_out_at(general: mtcollins1_media_general_2026_09_27, expected: 16)
    && timed_out_at(general: general_coded(code: "42"), expected: 42)
    && (match closed_stopped(general: mtcollins1_media_general_2026_09_27_morning_as_reported) { MegaRacReadinessTimedOut { image_name: _, route: _, last: _, deadline: _, looks: _, cd_before_any_write: _, cd_at_refusal: CdErrorRead { code: CdErrorNone } } => true  _ => false })
}

// ─── BEFORE ANY WRITE ───────────────────────────────────────────────────────────────────────────
// THE DESIRED IMAGE PRESENTED IS PRESENTATION EVIDENCE ONLY ON A CLEAN CODE (megarac_media_attach
// presented_row_serving, grounded by boot run 43040335415). Clean: the no-write readiness fold, host on or off.
// Nonzero with the host off: the stale-row path stops that very row. Nonzero with the host on: a typed refusal
// carrying both readings and why no stop was made; nothing is written. Nothing presented is attached under the
// policy that admits 16 on 0.32, as before.
test fn a_desired_presentation_is_readiness_only_on_a_clean_code() -> Bool {
  let desired = presenting(name: desired_census as String, status: "1")
  (match step_with_cd(configurations: desired, detach: host_off, cd_before: cd_clean) { ConvergeStepAwaitReadiness => true  _ => false })
    && (match step_with_cd(configurations: desired, detach: host_on, cd_before: cd_clean) { ConvergeStepAwaitReadiness => true  _ => false })
    && (match step_with_cd(configurations: desired, detach: host_off, cd_before: cd_16) { ConvergeStepDetachStale { row: r } => r.image_name == (desired_census as String)  _ => false })
    && (match step_with_cd(configurations: desired, detach: host_off, cd_before: cd_42) { ConvergeStepDetachStale { row: r } => r.image_name == (desired_census as String)  _ => false })
    && (match step_with_cd(configurations: desired, detach: host_on, cd_before: cd_16) {
      ConvergeStepRefuse { outcome: MegaRacPresentedRowNotServing { image_name: n, configurations: c, cd_error: e, not_replaced: why } } =>
        (n as String) == (desired_census as String) && nonzero_is(r: e, expected: 16) && c == desired && string_contains(s: why as String, pattern: "powered on")
      _ => false
    })
}

// BOOT 11'S OWN READINGS, through the pure step: the row it admitted (boot_run_43040335415_presented_row, rendered
// back into the configurations document it was read from) beside the code general settings read
// (boot_run_43040335415_general_before_handoff), on the release that run's hpm check reported. With the host off,
// as it was, the row is stopped and re-attached rather than handed to the readiness fold; with the host on it is
// refused. The RED is presented_row_serving removed: both arms then read ConvergeStepAwaitReadiness, the route that
// powered boot 11 on over a CD that served nothing.
fn boot_11_row_document(r: MegaRacMediaRowReceipt) -> String {
  join(["[ { \"id\": 1, \"media_type\": ", to_string(r.media_type), ", \"media_index\": ", to_string(r.media_index), ", \"session_index\": ", to_string(r.session_index), ", \"image_name\": \"", match r.image_name { Present { value: n } => n as String  Absent => "" }, "\", \"redirection_status\": ", to_string(r.redirection_status), " } ]"], "")
}

fn boot_11_step(detach: MegaRacDetachAdmission) -> ConvergenceStep {
  let image = match boot_run_43040335415_presented_row.image_name { Present { value: n } => n  Absent => desired_census }
  let doc = boot_11_row_document(r: boot_run_43040335415_presented_row)
  megarac_convergence_step(
    convergence: presented_convergence(
      presented: presented_media(body: doc, image_name: image, firmware: megarac_firmware_0_45_reported, replaceable: Present { value: non_empty_singleton(item: mtcollins1_census_image_stem) }),
      image_name: image,
      replaceable_seeded_stems: non_empty_singleton(item: mtcollins1_census_image_stem),
    ),
    detach: detach,
    configurations: doc,
    cd_before: CdErrorRead { code: megarac_cd_error_code_of_wire(firmware: megarac_firmware_0_45_reported, wire: boot_run_43040335415_general_before_handoff.cd_error_code) },
  )
}

test fn boot_11_readings_are_not_presentation_evidence() -> Bool {
  (match boot_11_step(detach: host_off) {
    ConvergeStepDetachStale { row: r } => match boot_run_43040335415_presented_row.image_name { Present { value: n } => r.image_name == (n as String)  Absent => false }
    _ => false
  })
    && (match boot_11_step(detach: host_on) {
      ConvergeStepRefuse { outcome: MegaRacPresentedRowNotServing { image_name: _, configurations: _, cd_error: e, not_replaced: _ } } => nonzero_is(r: e, expected: 16)
      _ => false
    })
}

test fn a_named_code_with_nothing_presented_attaches() -> Bool {
  (match step_with_cd(configurations: "[]", detach: host_off, cd_before: cd_16) { ConvergeStepAttachFromListing => true  _ => false })
}

// A CODE OUTSIDE THE ATTACH POLICY WITH NOTHING PRESENTED is the one pre-write knowledge refusal left: the
// fresh-presentation admission decides, and not admitted, nothing is written.
data cd_42: CdErrorReading = cd_error_reading(body: general_coded(code: "42"), firmware: megarac_firmware_0_32)


test fn nothing_presented_with_a_code_outside_the_table_and_the_host_on_refuses_before_any_write() -> Bool {
  match step_with_cd(configurations: "[]", detach: host_on, cd_before: cd_42) {
    ConvergeStepRefuse { outcome: MegaRacMediaStateUnestablishedBeforeWrite { cd_before_any_write: CdErrorRead { code: CdErrorNonzero { wire: w, firmware: _ } }, reason: _ } } => w == 42
    _ => false
  }
}

fn observed(general: String, configurations: String) -> MegaRacAttachResult {
  observed_under(general: general, configurations: configurations, admitted_route: none)
}

// A LOOK RE-READING A PRESENTATION ADMITTED ON admitted_route, the provenance the recheck is judged under.
fn observed_under(general: String, configurations: String, admitted_route: MegaRacAttachRoute?) -> MegaRacAttachResult {
  MegaRacAttachResult {
    outcome: MegaRacPresentationObserved {
      share: share_binding_standing(body: general, expected: share_as_of_2026_09_27),
      readiness: attach_readiness(answered: true, body: configurations, image_name: desired_census, firmware: megarac_firmware_0_32),
      cd_error: cd_error_reading(body: general, firmware: megarac_firmware_0_32),
      general: MegaRacRawRead { answered: true, body: general, observed_at: Present { value: 5000 } },
      configurations: MegaRacRawRead { answered: true, body: configurations, observed_at: Present { value: 5001 } },
      admitted_route: admitted_route,
    },
    session_release: SessionReleased,
    baseline: none,
   secret_file: SecretFileRemoved }
}

// The handoff's typed harness findings, rendered once each by the bundle's own renderer.
fn handoff_media_findings(h: MegaRacHandoff) -> List<String> {
  map(handoff_media_harness(h: h), f => harness_finding_text(f: f))
}

fn only_finding_contains(findings: List<String>, pattern: String) -> Bool {
  count(findings) == 1 && (match findings.first() { Present { value: f } => string_contains(s: f, pattern: pattern)  Absent => false })
}

data served_look: MegaRacAttachResult = observed(general: mtcollins1_media_general_2026_09_27_morning_as_reported, configurations: presenting_in(name: desired_census as String, status: "1", session: "0"))

test fn a_started_bound_presentation_is_still_served() -> Bool {
  match presentation_still_served(result: served_look) { PresentationStillReady => true _ => false }
}

// The after-state of boot run 36330382023 as a post-handoff look: the row reads status 16, which is
// uncatalogued, so the look cannot say whether the medium is served -- INDETERMINATE, not LOST.
test fn the_36330382023_after_state_is_indeterminate_not_an_affirmed_loss() -> Bool {
  let after = observed(general: mtcollins1_media_general_2026_09_27, configurations: presenting_in(name: desired_census as String, status: "16", session: "255"))
  (match presentation_still_served(result: after) { PresentationUnobserved { reason: _ } => true _ => false })
    && only_finding_contains(findings: handoff_media_findings(h: MegaRacHandoffAttempted { before: served_look, handoff: MegaRacHandoffConfirmed, after: after }), pattern: "INDETERMINATE")
    && (count(handoff_media_findings(h: MegaRacHandoffAttempted { before: served_look, handoff: MegaRacHandoffConfirmed, after: served_look })) == 0)
}

// An affirmed loss: the look was taken and the row is gone.
test fn a_withdrawn_row_after_the_handoff_is_an_affirmed_loss() -> Bool {
  only_finding_contains(findings: handoff_media_findings(h: MegaRacHandoffAttempted { before: served_look, handoff: MegaRacHandoffConfirmed, after: observed(general: mtcollins1_media_general_2026_09_27_morning_as_reported, configurations: "[]") }), pattern: "LOST at or after")
}

// A LOSS AFFIRMED AFTER A CONFIRMED HANDOFF IS THE ATTEMPT'S CAUSE (gunbc#12533 finding 4): the
// deadline failure is re-attributed to "media presentation lost at <phase>", the earliest affirming
// look is the phase, and the downstream reason is kept. Controls, each on the same failure: a
// served look, an UNOBSERVED look, and an unconfirmed handoff leave the reason as it was; a success
// stands over an affirmed loss.
data withdrawn_look: MegaRacAttachResult = observed(general: mtcollins1_media_general_2026_09_27_morning_as_reported, configurations: "[]")
data deadline_failure: ProcessExit = ExitFailure { code: 1, reason: "mtcollins1 boot: deadline reached without a host-capture terminal" }

fn attributed_reason(handoff: MegaRacHandoff, end: MegaRacEndMedia) -> String {
  match outcome_attributing_media_loss(row: mtcollins1_boot_row_value, outcome: deadline_failure, loss: media_loss_after_handoff(handoff: handoff, end: end)) {
    ExitFailure { code: _, reason: r } => r
    ExitSuccess => ""
  }
}

test fn a_presentation_lost_after_a_confirmed_handoff_is_the_named_cause() -> Bool {
  let at_after = attributed_reason(handoff: MegaRacHandoffAttempted { before: served_look, handoff: MegaRacHandoffConfirmed, after: withdrawn_look }, end: MegaRacEndMediaObserved { look: withdrawn_look, end_release: EndReleaseKeptHostOn })
  let at_end = attributed_reason(handoff: MegaRacHandoffAttempted { before: served_look, handoff: MegaRacHandoffConfirmed, after: served_look }, end: MegaRacEndMediaObserved { look: withdrawn_look, end_release: EndReleaseKeptHostOn })
  starts_with(s: at_after, prefix: "mtcollins1 boot: media presentation lost at after-handoff (")
    && string_contains(s: at_after, pattern: "deadline reached without a host-capture terminal")
    && starts_with(s: at_end, prefix: "mtcollins1 boot: media presentation lost at end-of-attempt (")
}

test fn an_unaffirmed_look_or_an_unconfirmed_handoff_leaves_the_cause_alone() -> Bool {
  let failed = MegaRacAttachResult { outcome: MegaRacSessionRefused { detail: "curl: (7)" }, session_release: SessionReleaseNotAttempted, baseline: none , secret_file: SecretFileRemoved }
  let unchanged = "mtcollins1 boot: deadline reached without a host-capture terminal"
  attributed_reason(handoff: MegaRacHandoffAttempted { before: served_look, handoff: MegaRacHandoffConfirmed, after: served_look }, end: MegaRacEndMediaObserved { look: served_look, end_release: EndReleaseKeptHostOn }) == unchanged
    && attributed_reason(handoff: MegaRacHandoffAttempted { before: served_look, handoff: MegaRacHandoffConfirmed, after: failed }, end: MegaRacEndMediaObserved { look: failed, end_release: EndReleaseKeptHostOn }) == unchanged
    && attributed_reason(handoff: MegaRacHandoffAttempted { before: served_look, handoff: MegaRacHandoffAttemptedUnconfirmed { reason: "no read-back" }, after: withdrawn_look }, end: MegaRacEndMediaObserved { look: withdrawn_look, end_release: EndReleaseKeptHostOn }) == unchanged
    && (match outcome_attributing_media_loss(row: mtcollins1_boot_row_value, outcome: ExitSuccess, loss: media_loss_after_handoff(handoff: MegaRacHandoffAttempted { before: served_look, handoff: MegaRacHandoffConfirmed, after: withdrawn_look }, end: MegaRacEndMediaNotTaken { reason: "x" })) { ExitSuccess => true _ => false })
}

// THE DISCRIMINATING CONTROL: a failed session with the prior good presentation unchanged is
// UNOBSERVED, never LOST.
test fn a_failed_look_is_indeterminate_not_lost() -> Bool {
  let failed = MegaRacAttachResult { outcome: MegaRacSessionRefused { detail: "curl: (7)" }, session_release: SessionReleaseNotAttempted, baseline: none , secret_file: SecretFileRemoved }
  (match presentation_still_served(result: failed) { PresentationUnobserved { reason: _ } => true _ => false })
    && only_finding_contains(findings: handoff_media_findings(h: MegaRacHandoffAttempted { before: served_look, handoff: MegaRacHandoffConfirmed, after: failed }), pattern: "INDETERMINATE")
}

// THE RECHECK OWES ITS OWN CLEANUP: identical bodies, differing release -> only the released one admits.
test fn the_recheck_withholds_when_its_own_session_was_not_released() -> Bool {
  let held = MegaRacAttachResult { outcome: served_look.outcome, session_release: SessionReleaseRefused { detail: "probe still succeeded" }, baseline: none , secret_file: SecretFileRemoved }
  (match presentation_still_served(result: held) { PresentationReadyButSessionHeld { held: _ } => true _ => false })
    && (match presentation_still_served(result: served_look) { PresentationStillReady => true _ => false })
}

// AT THE RECHECK: on a freshly attached route (or with no admitted route) Started with any read code is
// still served; an unread look is unobserved; a stopped row with code 16 is an affirmed loss that does not
// name the code as a cause. On the already-presented route the recheck applies the serving law of the
// admission: code 0 is served, a nonzero code is the serving condition no longer satisfied.
fn a_fresh_route() -> MegaRacAttachRoute {
  RouteAttached { image_list_index: "5", start: WriteAccepted { body: "{}" } }
}

fn started_census() -> String {
  presenting_in(name: desired_census as String, status: "1", session: "0")
}

test fn a_started_look_with_code_16_is_still_served_at_the_recheck() -> Bool {
  (match presentation_still_served(result: observed(general: mtcollins1_media_general_2026_09_27, configurations: started_census())) {
    PresentationStillReady => true
    _ => false
  })
    && (match presentation_still_served(result: observed_under(general: mtcollins1_media_general_2026_09_27, configurations: started_census(), admitted_route: Present { value: a_fresh_route() })) {
      PresentationStillReady => true
      _ => false
    })
}

// merry-fox-82's review of #16339 at f5885ada: the same admitted presentation, changing only the recheck
// code. 0 proceeds; 16 is the serving condition unsatisfied, carrying the code and never wording it as a
// withdrawal or a loss; unread stays indeterminate.
test fn the_recheck_holds_an_already_presented_admission_to_a_clean_code() -> Bool {
  let admitted = Present { value: RouteAlreadyPresented }
  let clean = presentation_still_served(result: observed_under(general: general_coded(code: "0"), configurations: started_census(), admitted_route: admitted))
  let coded_look = observed_under(general: mtcollins1_media_general_2026_09_27, configurations: started_census(), admitted_route: admitted)
  let unread = presentation_still_served(result: observed_under(general: general_coded(code: "\"x\""), configurations: started_census(), admitted_route: admitted))
  let withheld = handoff_media_findings(h: MegaRacHandoffWithheldAtRecheck { before: coded_look })
  (match clean { PresentationStillReady => true _ => false })
    && (match presentation_still_served(result: coded_look) {
      PresentationServingConditionUnsatisfied { cd_error: CdErrorRead { code: CdErrorNonzero { wire: w, firmware: _ } } } => w == 16
      _ => false
    })
    && (match unread { PresentationUnobserved { reason: r } => (r as String) == "cd_error_code could not be read" _ => false })
    && only_finding_contains(findings: withheld, pattern: "the serving condition is no longer satisfied")
    && only_finding_contains(findings: withheld, pattern: "general settings now read cd_error_code 16")
    && only_finding_contains(findings: withheld, pattern: "no boot-device or power write")
    && !only_finding_contains(findings: withheld, pattern: "LOST")
    && !only_finding_contains(findings: withheld, pattern: "withdrawn")
}

test fn a_started_look_with_a_code_outside_the_table_is_still_served_at_the_recheck() -> Bool {
  match presentation_still_served(result: observed(general: general_coded(code: "42"), configurations: presenting_in(name: desired_census as String, status: "1", session: "0"))) {
    PresentationStillReady => true
    _ => false
  }
}

test fn a_started_look_with_an_unread_code_is_unobserved_at_the_recheck() -> Bool {
  match presentation_still_served(result: observed(general: general_coded(code: "\"x\""), configurations: presenting_in(name: desired_census as String, status: "1", session: "0"))) {
    PresentationUnobserved { reason: r } => (r as String) == "cd_error_code could not be read"
    _ => false
  }
}

test fn a_stopped_row_with_code_16_is_no_longer_served_and_the_reason_does_not_name_the_code() -> Bool {
  match presentation_still_served(result: observed(general: mtcollins1_media_general_2026_09_27, configurations: presenting_in(name: desired_census as String, status: "0", session: "255"))) {
    PresentationNoLongerReady { reason: r } => string_contains(s: r as String, pattern: "no longer Started with a bound session") && !string_contains(s: r as String, pattern: "ejected")
    _ => false
  }
}

test fn a_withdrawn_row_or_an_unobserved_look_is_not_served() -> Bool {
  (match presentation_still_served(result: observed(general: mtcollins1_media_general_2026_09_27_morning_as_reported, configurations: "[]")) { PresentationNoLongerReady { reason: _ } => true _ => false })
    && only_finding_contains(findings: handoff_media_findings(h: MegaRacHandoffWithheldAtRecheck { before: observed(general: mtcollins1_media_general_2026_09_27_morning_as_reported, configurations: "[]") }), pattern: "no boot-device or power write")
}

// ─── RECEIPTS FOR THE TWO BETS ──────────────────────────────────────────────────────────────────
//
// Manual stops on 2026-09-27, host off, supplied verbatim by eager-owl-205. Both bodies carried
// image_index 0 and both rows read media_index 0, so they are CONSISTENT with stop_media_body's
// media_index bet and do NOT discriminate it from the image-list reading (the two indices coincided).
// The second read-back cleared image and status while session_index read 255 -- the observation the
// unbound-session reading of 255 rests on.
data manual_stop_readback_1545z: String = "[ { \"id\": 1, \"media_type\": 1, \"media_index\": 0, \"session_index\": 0, \"image_name\": \"\", \"redirection_status\": 0 } ]"
data manual_stop_readback_1630z: String = "[ { \"id\": 1, \"media_type\": 1, \"media_index\": 0, \"session_index\": 255, \"image_name\": \"\", \"redirection_status\": 0 } ]"

test fn both_manual_stop_readbacks_establish_the_detach_whatever_stop_media_answered() -> Bool {
  (match detach_verdict(evidence: detach(success: true, body: "echoed body", readback_read: true, readback: manual_stop_readback_1545z), image_name: desired_census, firmware: megarac_firmware_0_32, replaceable_seeded_stems: non_empty_singleton(item: mtcollins1_census_image_stem)) { DetachEstablished => true _ => false })
    && (match detach_verdict(evidence: detach(success: false, body: stop_1411, readback_read: true, readback: manual_stop_readback_1630z), image_name: desired_census, firmware: megarac_firmware_0_32, replaceable_seeded_stems: non_empty_singleton(item: mtcollins1_census_image_stem)) { DetachEstablished => true _ => false })
}

test fn the_stop_body_this_module_sends_is_byte_equal_to_the_manual_stop_that_worked() -> Bool {
  stop_media_body(image_name: stale_census as String, media_index: "0") as String
    == "{\"image_name\":\"gunbc-mtcollins1-census-ubuntu-24.04.3-arm64-6455b3b9ae11214d.iso\",\"image_type\":1,\"image_index\":0,\"image_redirection\":1}"
}

// ─── ROWS: ONLY A WELL-FORMED ROW IS IDLE (side-chat review 5331738657) ───────────────────────────
data empty_row_doc: String = "[{}]"
data started_then_empty: String = concat("[{\"media_type\":1,\"image_name\":\"", concat(desired_census as String, "\",\"redirection_status\":1,\"media_index\":0,\"session_index\":0},{}]"))
data empty_then_started: String = concat("[{},{\"media_type\":1,\"image_name\":\"", concat(desired_census as String, "\",\"redirection_status\":1,\"media_index\":0,\"session_index\":0}]"))
data unnamed_uncatalogued_row: String = "[{\"media_type\":1,\"image_name\":\"\",\"redirection_status\":16,\"media_index\":0,\"session_index\":255}]"
data string_status_row: String = "[{\"media_type\":1,\"image_name\":\"\",\"redirection_status\":\"0\",\"media_index\":0,\"session_index\":0}]"

test fn an_empty_row_alone_is_unreadable_and_licenses_no_write() -> Bool {
  match step(configurations: empty_row_doc, detach: host_off) {
    ConvergeStepRefuse { outcome: MegaRacConfigurationsUnreadable { detail: _ } } => true
    _ => false
  }
}

test fn a_started_row_beside_an_unreadable_row_is_not_ready_either_order() -> Bool {
  (match attach_readiness(answered: true, body: started_then_empty, image_name: desired_census, firmware: megarac_firmware_0_32) { ReadinessMalformed { detail: _ } => true _ => false })
    && (match attach_readiness(answered: true, body: empty_then_started, image_name: desired_census, firmware: megarac_firmware_0_32) { ReadinessMalformed { detail: _ } => true _ => false })
}

test fn an_unreadable_row_in_the_readback_does_not_establish_a_detach() -> Bool {
  (match detach_verdict(evidence: detach(success: true, body: "{}", readback_read: true, readback: empty_row_doc), image_name: desired_census, firmware: megarac_firmware_0_32, replaceable_seeded_stems: non_empty_singleton(item: mtcollins1_census_image_stem)) { DetachNotEstablished { reason: _ } => true _ => false })
    && (match detach_verdict(evidence: detach(success: true, body: "{}", readback_read: true, readback: string_status_row), image_name: desired_census, firmware: megarac_firmware_0_32, replaceable_seeded_stems: non_empty_singleton(item: mtcollins1_census_image_stem)) { DetachNotEstablished { reason: _ } => true _ => false })
}

test fn an_unnamed_row_with_an_uncatalogued_status_keeps_its_wire() -> Bool {
  match step(configurations: unnamed_uncatalogued_row, detach: host_off) {
    ConvergeStepRefuse { outcome: MegaRacRedirectionUncatalogued { image_name: n, unread: u, refusal: _, configurations: _ } } => n == "" && redirection_unread_wire(unread: u) == 16
    _ => false
  }
}

// ─── THE CLOCK CONTRACT (side-chat review 5331738657) ────────────────────────────────────────────
test fn a_started_look_before_the_window_opened_is_clock_incoherent() -> Bool {
  match readiness_verdict(opened_at: 1000, budget: 30000, previous: none, look: look(at: 500, status: "1", session: "0"), phase: ReadinessAfterStart, looks: 1) {
    ReadinessClockIncoherent { opened_at: o, previous: _, look: l, looks: _ } => o == 1000 && l.observed_at == 500
    _ => false
  }
}

test fn a_backward_or_stalled_clock_is_incoherent() -> Bool {
  (match readiness_verdict(opened_at: 1000, budget: 30000, previous: Present { value: 5000 }, look: look(at: 4000, status: "100", session: "0"), phase: ReadinessAfterStart, looks: 2) { ReadinessClockIncoherent { opened_at: _, previous: _, look: _, looks: _ } => true _ => false })
    && (match readiness_verdict(opened_at: 1000, budget: 30000, previous: Present { value: 5000 }, look: look(at: 5000, status: "1", session: "0"), phase: ReadinessAfterStart, looks: 2) { ReadinessClockIncoherent { opened_at: _, previous: _, look: _, looks: _ } => true _ => false })
}

test fn a_started_look_exactly_at_the_deadline_is_outside_the_window() -> Bool {
  match readiness_verdict(opened_at: 1000, budget: 30000, previous: Present { value: 29000 }, look: look(at: 31000, status: "1", session: "0"), phase: ReadinessAfterStart, looks: 5) {
    ReadinessWindowClosed { last: _, deadline: d, looks: _ } => d == 31000
    _ => false
  }
}

test fn the_look_count_closes_the_window_even_when_the_clock_stays_inside_it() -> Bool {
  match readiness_verdict(opened_at: 1000, budget: 30000, previous: Present { value: 1100 }, look: look(at: 1200, status: "100", session: "0"), phase: ReadinessAfterStart, looks: 16) {
    ReadinessWindowClosed { last: _, deadline: _, looks: n } => n == 16
    _ => false
  }
}

// ─── AN EXECUTED DETACH SURVIVES A LATER ERROR ───────────────────────────────────────────────────
test fn a_listing_error_after_the_stop_keeps_the_stop_and_its_1411() -> Bool {
  match media_attach_outcome_reason(outcome: MegaRacListingUnparseableAfterDetach { detail: "<html>", detach: detach(success: false, body: stop_1411, readback_read: true, readback: manual_stop_readback_1630z) }) {
    Present { value: r } => string_contains(s: r, pattern: "1411") && string_contains(s: r, pattern: "<html>")
    Absent => false
  }
}

// ─── THE POPULATION IS UNIQUE BEFORE ANY WRITE (side-chat review 5331991982) ──────────────────────
fn two_rows(a: String, a_status: String, b: String, b_status: String) -> String {
  join(["[{\"media_type\":1,\"image_name\":\"", a, "\",\"redirection_status\":", a_status, ",\"media_index\":0,\"session_index\":0},",
    "{\"media_type\":1,\"image_name\":\"", b, "\",\"redirection_status\":", b_status, ",\"media_index\":1,\"session_index\":1}]"], "")
}

fn several_in_both_orders(a: String, b: String) -> Bool {
  (match step_with_cd(configurations: two_rows(a: a, a_status: "1", b: b, b_status: "1"), detach: host_off, cd_before: cd_16) { ConvergeStepRefuse { outcome: MegaRacSeveralImagesPresented { configurations: _ } } => true _ => false })
    && (match step_with_cd(configurations: two_rows(a: b, a_status: "1", b: a, b_status: "1"), detach: host_off, cd_before: cd_16) { ConvergeStepRefuse { outcome: MegaRacSeveralImagesPresented { configurations: _ } } => true _ => false })
}

test fn duplicate_desired_rows_refuse_before_any_write_in_both_orders() -> Bool {
  several_in_both_orders(a: desired_census as String, b: desired_census as String)
}

test fn desired_beside_another_census_image_refuses_in_both_orders() -> Bool {
  several_in_both_orders(a: desired_census as String, b: stale_census as String)
}

test fn desired_beside_a_foreign_image_refuses_as_foreign_in_both_orders() -> Bool {
  (match step_with_cd(configurations: two_rows(a: desired_census as String, a_status: "1", b: "memtest86-5.31b.iso", b_status: "1"), detach: host_off, cd_before: cd_16) { ConvergeStepRefuse { outcome: MegaRacForeignImagePresented { image_name: n, configurations: _ } } => n == "memtest86-5.31b.iso" _ => false })
    && (match step_with_cd(configurations: two_rows(a: "memtest86-5.31b.iso", a_status: "1", b: desired_census as String, b_status: "1"), detach: host_off, cd_before: cd_16) { ConvergeStepRefuse { outcome: MegaRacForeignImagePresented { image_name: n, configurations: _ } } => n == "memtest86-5.31b.iso" _ => false })
}

test fn a_listing_naming_the_image_twice_is_ambiguous_not_first_match() -> Bool {
  let listing = join(["[{\"image_name\":\"", desired_census as String, "\",\"image_index\":2},{\"image_name\":\"", desired_census as String, "\",\"image_index\":5}]"], "")
  (match images_listing_reading(body: listing, image_name: desired_census) { ImagesListingOffersAmbiguously { image_indices: ids } => ids == ["2", "5"] _ => false })
    && (match images_listing_reading(body: join(["[{\"image_name\":\"", desired_census as String, "\",\"image_index\":5}]"], ""), image_name: desired_census) { ImagesListingOffers { image_index: i } => i == "5" _ => false })
}

// A VALID LISTING THAT NAMES THE IMAGE TWICE IS NOT AN UNREADABLE DOCUMENT (gunbc#12533 finding 5).
// Its cause names both offered identities and never says "not valid JSON"; the red is the old label.
// A duplicated row whose image_index is not numeric stays an unread member, as on the unique arm.
test fn a_duplicate_listing_reports_both_identities_not_invalid_json() -> Bool {
  let reason = media_attach_outcome_reason(outcome: MegaRacImageOfferedAmbiguously { image_name: desired_census, image_indices: ["2", "5"] })
  (match reason { Present { value: r } => string_contains(s: r, pattern: "(image_index 2, 5)") && string_contains(s: r, pattern: desired_census as String) && string_contains(s: r, pattern: "JSON") == false  Absent => false })
    && (match images_listing_reading(body: join(["[{\"image_name\":\"", desired_census as String, "\",\"image_index\":2},{\"image_name\":\"", desired_census as String, "\"}]"], ""), image_name: desired_census) { ImagesListingUnparseable { detail: _ } => true _ => false })
}

// ─── THE CODE'S DISPOSITION ON EVERY ROUTE ───────────────────────────────────────────────────────
data cd_unread: CdErrorReading = CdErrorUnread { detail: "cd_error_code missing" }

test fn an_unread_code_never_withdraws_a_presentation() -> Bool {
  (match step_with_cd(configurations: presenting(name: stale_census as String, status: "1"), detach: host_off, cd_before: cd_unread) { ConvergeStepRefuse { outcome: MegaRacMediaStateUnestablishedBeforeWrite { cd_before_any_write: _, reason: _ } } => true _ => false })
    && (match step_with_cd(configurations: presenting(name: desired_census as String, status: "1"), detach: host_off, cd_before: cd_unread) { ConvergeStepRefuse { outcome: MegaRacMediaStateUnestablishedBeforeWrite { cd_before_any_write: _, reason: _ } } => true _ => false })
    && (match step_with_cd(configurations: "[]", detach: host_off, cd_before: cd_unread) { ConvergeStepRefuse { outcome: MegaRacMediaStateUnestablishedBeforeWrite { cd_before_any_write: _, reason: _ } } => true _ => false })
}

test fn nothing_presented_with_a_code_outside_the_table_attaches_only_under_admission() -> Bool {
  (match step_with_cd(configurations: "[]", detach: host_off, cd_before: cd_42) { ConvergeStepAttachFromListing => true _ => false })
    && (match step_with_cd(configurations: "[]", detach: host_on, cd_before: cd_42) { ConvergeStepRefuse { outcome: MegaRacMediaStateUnestablishedBeforeWrite { cd_before_any_write: _, reason: _ } } => true _ => false })
    && (match step_with_cd(configurations: "[]", detach: host_on, cd_before: cd_clean) { ConvergeStepAttachFromListing => true _ => false })
}

// ─── WRITE ANSWERS AND THE RENDERED ARTIFACT ─────────────────────────────────────────────────────
test fn a_write_without_an_http_answer_is_effect_uncertain() -> Bool {
  (match megarac_write_answer(exit_code: 28, body: "", stderr: "curl: (28) Operation timed out after 10001 milliseconds") { WriteEffectUncertain { exit_code: x, partial_body: _, stderr: _ } => x == 28 _ => false })
    && (match megarac_write_answer(exit_code: 22, body: stop_1411, stderr: "") { WriteAnsweredHttpError { body: b, stderr: _ } => b == stop_1411 _ => false })
}

// The published artifact keeps the executed stop (and its 1411) and the StartMedia answer when the
// readiness clock refused afterwards.
test fn the_rendered_artifact_keeps_the_detach_and_start_answers_on_a_clock_refusal() -> Bool {
  let route = RouteReplaced { image_list_index: "5", detach: detach(success: false, body: stop_1411, readback_read: true, readback: manual_stop_readback_1630z), start: WriteEffectUncertain { exit_code: 28, partial_body: "", stderr: "curl: (28) Operation timed out" } }
  let rendered = megarac_media_attach_text(record: attempted(result: MegaRacAttachResult {
    outcome: MegaRacReadinessClockIncoherent { image_name: desired_census, route: route, opened_at: 1000, previous: none, look: look(at: 500, status: "1", session: "0"), looks: 1 },
    session_release: SessionReleased,
    baseline: none,
   secret_file: SecretFileRemoved }))
  string_contains(s: rendered, pattern: "1411") && string_contains(s: rendered, pattern: "EFFECT UNCERTAIN") && string_contains(s: rendered, pattern: "(28)")
}

// ─── REVIEW 5332343434 ────────────────────────────────────────────────────────────────────────────
// An offered row whose identity cannot be read is admitted as unread before candidates are counted,
// on either side of the valid desired row.
fn listing_with(first: String, second: String) -> String {
  join(["[", first, ",", second, "]"], "")
}

fn desired_offer() -> String {
  concat("{\"image_name\":\"", concat(desired_census as String, "\",\"image_index\":5}"))
}
fn dup_name_offer() -> String {
  "{\"image_name\":\"a.iso\",\"image_name\":\"b.iso\",\"image_index\":3}"
}

test fn an_unreadable_offered_row_beside_the_desired_one_refuses_before_start_media() -> Bool {
  (match images_listing_reading(body: listing_with(first: "{}", second: desired_offer()), image_name: desired_census) { ImagesListingUnparseable { detail: _ } => true _ => false })
    && (match images_listing_reading(body: listing_with(first: desired_offer(), second: "{}"), image_name: desired_census) { ImagesListingUnparseable { detail: _ } => true _ => false })
    && (match images_listing_reading(body: listing_with(first: dup_name_offer(), second: desired_offer()), image_name: desired_census) { ImagesListingUnparseable { detail: _ } => true _ => false })
    && (match images_listing_reading(body: listing_with(first: desired_offer(), second: "{\"image_name\":7}"), image_name: desired_census) { ImagesListingUnparseable { detail: _ } => true _ => false })
}

test fn a_readable_listing_ignores_unrelated_optional_members() -> Bool {
  match images_listing_reading(body: listing_with(first: "{\"image_name\":\"memtest.iso\",\"image_index\":0}", second: desired_offer()), image_name: desired_census) {
    ImagesListingOffers { image_index: i } => i == "5"
    _ => false
  }
}

// Partial bytes then a timeout: uncertain, with every byte kept; never a complete controller answer.
test fn partial_bytes_then_a_timeout_are_uncertain_and_kept() -> Bool {
  match megarac_write_answer(exit_code: 28, body: "<partial-json-bytes", stderr: "curl: (28) Operation timed out") {
    WriteEffectUncertain { exit_code: x, partial_body: b, stderr: _ } => b == "<partial-json-bytes" && x == 28
    _ => false
  }
}

test fn a_stop_never_sent_is_not_issued() -> Bool {
  match detach_verdict(evidence: MegaRacDetachEvidence { stale_image: stale_census as String, media_index: "", share_cycle_start: none, command: WriteNotIssued { reason: "no device" }, readback_read: false, readback: "", cd_after_stop: cd_unread, general_after_stop: MegaRacRawRead { answered: false, body: "not read", observed_at: none } }, image_name: desired_census, firmware: megarac_firmware_0_32, replaceable_seeded_stems: non_empty_singleton(item: mtcollins1_census_image_stem)) {
    DetachNotEstablished { reason: _ } => true
    _ => false
  }
}

// The end look is owed by an attempted media attach, handed off or not; an unconfirmed handoff is
// reported as attempted, not as a handoff that happened.
test fn the_end_look_is_owed_by_any_attempted_attach() -> Bool {
  end_media_is_owed(media: attempted(result: MegaRacAttachResult { outcome: MegaRacMediaStateUnestablished { image_name: desired_census, route: RouteAttached { image_list_index: "5", start: WriteAccepted { body: "{}" } }, look: look(at: 13000, status: "1", session: "0"), looks: 4, cd_before_any_write: cd_16, cd_at_ready: cd_16, general_at_ready: raw_at(body: mtcollins1_media_general_2026_09_27) }, session_release: SessionReleased, baseline: none , secret_file: SecretFileRemoved }))
    && !end_media_is_owed(media: MegaRacMediaAttachNotAttempted { reason: "BMC is not BmcSecured" })
}

test fn an_unconfirmed_handoff_is_reported_as_attempted() -> Bool {
  let findings = handoff_media_findings(h: MegaRacHandoffAttempted { before: served_look, handoff: MegaRacHandoffAttemptedUnconfirmed { reason: "chassis power read-back did not observe on" }, after: served_look })
  count(findings) == 1 && (match findings.first() { Present { value: f } => string_contains(s: f, pattern: "attempted and not confirmed")  Absent => false })
}

// The raw, timed settings read reaches the rendered artifact, bound to readiness: the code before any
// write differs (16), so a render that swapped the two fields or dropped the timestamp reds. A nonzero
// code renders as observed with no meaning, the standing MegaRacCdErrorCode gives every nonzero value.
test fn the_rendered_artifact_keeps_the_raw_timed_settings_at_readiness() -> Bool {
  let rendered = megarac_media_attach_text(record: attempted(result: MegaRacAttachResult {
    outcome: MegaRacMediaStateUnestablished { image_name: desired_census, route: RouteAttached { image_list_index: "5", start: WriteAccepted { body: "{}" } }, look: look(at: 13000, status: "1", session: "0"), looks: 4, cd_before_any_write: cd_16, cd_at_ready: cd_42, general_at_ready: raw_at(body: mtcollins1_media_general_2026_09_27) },
    session_release: SessionReleased,
    baseline: none,
   secret_file: SecretFileRemoved }))
  string_contains(s: rendered, pattern: "and at readiness 42 (observed; no meaning established) (general settings answered at 13100: ")
}

// THE VERDICT IS THE TYPED EXIT CODE, NOT STDERR WORDING (review 71971): a complete HTTP error with
// reworded or empty stderr is still an answer, and a timeout whose stderr mentions "(22)" is still
// uncertain.
test fn the_write_verdict_follows_the_exit_code_not_the_stderr_wording() -> Bool {
  (match megarac_write_answer(exit_code: 22, body: stop_1411, stderr: "") { WriteAnsweredHttpError { body: _, stderr: _ } => true _ => false })
    && (match megarac_write_answer(exit_code: 28, body: "", stderr: "curl: (22) misleading text") { WriteEffectUncertain { exit_code: x, partial_body: _, stderr: _ } => x == 28 _ => false })
    && (match megarac_write_answer(exit_code: 7, body: "", stderr: "curl: (7) Failed to connect") { WriteEffectUncertain { exit_code: x, partial_body: _, stderr: _ } => x == 7 _ => false })
    && (match megarac_write_answer(exit_code: 0, body: "{}", stderr: "") { WriteAccepted { body: _ } => true _ => false })
}

// ─── THE IN-INTERVAL READ SURVIVES THE WAIT ────────────────────────────────────────────
// The interval between the StartMedia write and the started reading is what gunbc.megarac_media_model's
// megarac_start_media_interval is a hypothesis about, and its read_obligation names this look ("Read
// configurations 0 INSIDE the interval between a successful StartMedia and the started reading"). Two things
// lost it: the loop overwrote its look on every pending pass, so only the ready look survived the wait, and the
// ready path printed no look at all -- the bundle renders a look only where the attempt refuses. The wait now
// carries its first look and presentation_evidence_text prints it. The fixture's in-interval look is the row
// reading 0 beside the no-session marker, which decodes into ReadinessConnecting -- one of the three arms that
// used to drop the document they were decoded from -- so these claims exercise all three layers at once.

// The SAME fixture as ready_outcome(), with the in-interval look as its only variable -- including the
// general-settings body, which is what makes cd_error_of_raw ANSWER rather than come back unread. An unread
// code there sends the ready arm to MegaRacMediaStateUnestablished, which renders no evidence at all: these
// three claims were red for that reason and no other, so the fixture that never reached the arm it claims to
// exercise was the defect, not the claims.
fn ready_outcome_with_interval(interval: ReadinessLook) -> MegaRacAttachOutcome {
  readiness_wait_outcome(
    wait: ReadinessWaitReady { look: look(at: 13000, status: "1", session: "0"), looks: 4, in_interval: interval },
    image_name: desired_census,
    firmware: megarac_firmware_0_32,
    route: RouteAttached { image_list_index: "5", start: WriteAccepted { body: "{}" } },
    cd_before: cd_clean,
    general_at_end: raw_at(body: mtcollins1_media_general_2026_09_27_morning_as_reported),
  )
}

fn evidence_text_of(outcome: MegaRacAttachOutcome) -> String {
  match outcome {
    MegaRacPresentationReady { route: _, evidence: e } => presentation_evidence_text(e: e)
    _ => ""
  }
}

// END TO END, THE WAY BOOT 8 RUNS IT: a wait of four looks that came up started still prints the FIRST look's
// configurations -- the status the row read beside the no-session marker, which the ready look's own fields
// never say.
test fn the_ready_outcome_prints_the_in_interval_configurations() -> Bool {
  let text = evidence_text_of(outcome: ready_outcome_with_interval(interval: look(at: 1100, status: "0", session: "255")))
  string_contains(s: text, pattern: "\"redirection_status\":0")
    && string_contains(s: text, pattern: "\"session_index\":255")
}

// THE FIRST LOOK, NOT THE READY ONE REPRINTED. The ready path types its own reading (redirection_status=,
// session_index=) and prints a configurations DOCUMENT only for the in-interval look, so the two readings are
// told apart by their JSON markers: the interval reads 0 beside the no-session marker 255, the ready look reads
// 1 beside a bound 0. If the wait ever filled the interval from the ready look, the interval's marker would be
// gone and the ready document's "session_index":0 would appear -- this claim goes red on either half alone.
test fn the_in_interval_look_is_not_the_ready_look_reprinted() -> Bool {
  let text = evidence_text_of(outcome: ready_outcome_with_interval(interval: look(at: 1100, status: "0", session: "255")))
  string_contains(s: text, pattern: "\"redirection_status\":0")
    && !string_contains(s: text, pattern: "\"session_index\":0")
}

// RED: IF THE IN-INTERVAL LOOK IS EVER DROPPED, THE TEXT COLLAPSES. Same wait, same ready look, two in-interval
// documents differing only in the session the row carried. Should the receipt stop carrying the interval, the
// two renders become one string and this goes red.
test fn a_dropped_in_interval_look_would_collapse_the_receipt_text() -> Bool {
  let left = evidence_text_of(outcome: ready_outcome_with_interval(interval: look(at: 1100, status: "0", session: "255")))
  let right = evidence_text_of(outcome: ready_outcome_with_interval(interval: look(at: 1100, status: "0", session: "7")))
  left != right
}

// ─── SHARE RE-ENUMERATION (gunbc.machine_intake.megarac_media_attach megarac_reenumerate_share) ──────────────
//
// Boot run 43578670059 refused at media attach: nothing presented, and the listing offered other images but not
// the newly published one. The route now presents one offered image of this lane and stops it, the only
// re-enumeration this controller performs. The controller answers are SUPPLIED here at the pure decisions the
// route composes: the cycle's candidate (the listing), its presentation (configurations after its start), its
// stop (the 2026-09-27 stop-media answer 1411 and its verbatim read-back, manual_stop_readback_1630z), and the
// target's enumeration after it (the establishment fold). The lane is the census stem; the target is
// desired_census and the predecessor stale_census, the two names of the 2026-09-27 refusal.

fn lane_stems() -> FreeSemigroup<NonEmptyStr> { non_empty_singleton(item: mtcollins1_census_image_stem) }

data lane_zero: NonEmptyStr = ubuntu_seeded_install_media_image_name(image_stem: mtcollins1_census_image_stem, output_digest: "00000000000000aa00")

fn offer(name: String, index: String) -> String {
  join(["{\"image_name\":\"", name, "\",\"image_index\":", index, "}"], "")
}

fn listing_of(offers: List<String>) -> String {
  concat("[", concat(join(offers, ","), "]"))
}

fn cycled_of(listing: String) -> String {
  match share_cycle_candidate(listing: listing, image_name: desired_census, replaceable_seeded_stems: lane_stems()) {
    ShareCycleThrough { cycled: c, image_index: i } => join([c as String, "@", i], "")
    ShareCycleNoCandidate { offered: _ } => "none"
    ShareCycleListingUnreadable { detail: _ } => "unreadable"
  }
}

// THE CYCLED IMAGE IS THIS LANE'S, CHOSEN BY NAME, NOT BY LISTING ORDER: the least lane name wins whichever order
// the controller lists them in; a foreign image (memtest) is never chosen even when listed first; with one lane
// image offered, that one is cycled at its own index. RED: the stem filter removed (memtest is cycled).
test fn a_lacking_listing_cycles_this_lanes_least_named_image_and_never_a_foreign_one() -> Bool {
  let forward = listing_of(offers: [offer(name: "memtest.iso", index: "0"), offer(name: stale_census as String, index: "3"), offer(name: lane_zero as String, index: "1")])
  let reversed = listing_of(offers: [offer(name: lane_zero as String, index: "1"), offer(name: stale_census as String, index: "3"), offer(name: "memtest.iso", index: "0")])
  let only_predecessor = listing_of(offers: [offer(name: "memtest.iso", index: "0"), offer(name: stale_census as String, index: "3")])
  cycled_of(listing: forward) == concat(lane_zero as String, "@1")
    && cycled_of(listing: reversed) == concat(lane_zero as String, "@1")
    && cycled_of(listing: only_predecessor) == concat(stale_census as String, "@3")
    && cycled_of(listing: "<html>") == "unreadable"
}

// A LISTING WITH NOTHING OF THIS LANE REFUSES BEFORE ANY WRITE, NAMING EVERY OFFER. RED: the stem filter removed.
test fn a_listing_with_no_image_of_this_lane_refuses_naming_every_offer() -> Bool {
  let foreign_only = listing_of(offers: [offer(name: "memtest.iso", index: "0"), offer(name: "other.iso", index: "2")])
  match share_cycle_candidate(listing: foreign_only, image_name: desired_census, replaceable_seeded_stems: lane_stems()) {
    ShareCycleNoCandidate { offered: names } =>
      names == ["memtest.iso", "other.iso"]
        && (match media_attach_outcome_reason(outcome: MegaRacImageNotEnumerated { image_name: desired_census, offered: names }) {
          Present { value: r } => string_contains(s: r, pattern: "(offered: memtest.iso, other.iso)") && string_contains(s: r, pattern: "nothing was written")
          Absent => false
        })
    ShareCycleThrough { cycled: _, image_index: _ } => false
    ShareCycleListingUnreadable { detail: _ } => false
  }
}

// THE CYCLED ROW IS STOPPED ONLY ONCE IT PRESENTS, AND ONLY IF IT IS THE ONE PRESENTING: nothing presented (or an
// unanswered read) is not yet; exactly the cycled image presenting names the device to stop; another lane image
// or a foreign one presenting refuses, because the row a stop would name is then not the cycle's own.
// RED: a row presenting another image read as the cycled one.
test fn the_cycled_image_is_stopped_only_once_it_alone_presents() -> Bool {
  let p = fn(answered, body) { share_cycle_presentation(answered: answered, body: body, cycled: stale_census, firmware: megarac_firmware_0_32, replaceable_seeded_stems: lane_stems()) }
  (match p(true, "[]") { ShareCycleNotYetPresented => true  _ => false })
    && (match p(false, "timeout") { ShareCycleNotYetPresented => true  _ => false })
    && (match p(true, presenting(name: stale_census as String, status: "1")) { ShareCyclePresenting { row: r } => r.image_name == (stale_census as String) && optional_text_is(v: r.media_index, want: "0")  _ => false })
    && (match p(true, presenting(name: desired_census as String, status: "1")) { ShareCycleRefused { reason: _ } => true  _ => false })
    && (match p(true, presenting(name: "memtest.iso", status: "1")) { ShareCycleRefused { reason: _ } => true  _ => false })
}

fn cycle_stop(readback: String) -> MegaRacDetachEvidence {
  MegaRacDetachEvidence {
    stale_image: stale_census as String,
    media_index: "0",
    share_cycle_start: Present { value: WriteAccepted { body: "{}" } },
    command: megarac_write_answer(exit_code: 22, body: stop_1411, stderr: ""),
    readback_read: true,
    readback: readback,
    cd_after_stop: cd_clean,
    general_after_stop: raw_at(body: mtcollins1_media_general_2026_09_27_morning_as_reported),
  }
}

// THE CYCLE'S STOP IS ESTABLISHED BY ITS READ-BACK, NOT ITS ANSWER: the 2026-09-27 stop answered 1411 and read back
// cleared, and that establishes it; the same answer with the row still presenting does not. The evidence names
// the start that presented the row, so the receipt shows both writes the cycle made.
test fn the_cycles_stop_is_established_by_the_read_back_whatever_it_answered() -> Bool {
  (match detach_verdict(evidence: cycle_stop(readback: manual_stop_readback_1630z), image_name: desired_census, firmware: megarac_firmware_0_32, replaceable_seeded_stems: lane_stems()) { DetachEstablished => true  _ => false })
    && (match detach_verdict(evidence: cycle_stop(readback: presenting(name: stale_census as String, status: "1")), image_name: desired_census, firmware: megarac_firmware_0_32, replaceable_seeded_stems: lane_stems()) { DetachEstablished => false  _ => true })
    && string_contains(s: detach_evidence_text(detach: cycle_stop(readback: manual_stop_readback_1630z)), pattern: concat("presented '", concat(stale_census as String, "' to re-enumerate the share (start-media")))
}

// THE TARGET STILL ABSENT AFTER THE RE-ENUMERATION REFUSES, NAMING WHAT WAS OFFERED: the listing lacked the target
// at a look that reached the declared deadline, so the fold closes and the miss carries the names that look
// offered; the reason says the row stopped was the cycled one, and shows both its writes.
// RED: the miss dropping the offered names.
test fn the_target_still_absent_after_reenumeration_refuses_naming_what_was_offered() -> Bool {
  let standing = mount_standing_as_of(
    window: refresh_window,
    observations: [absent_at(at: 50000), absent_at(at: 91000)],
    boundary: MountEvaluationBoundary { observed_through: 91000, clock_evidence: lacks_bytes },
  )
  match enumeration_decision(standing: standing, reading: ImagesListingLacks, offered: [stale_census as String, "memtest.iso"], remaining: 5) {
    EnumerationDecided { result: NotEnumeratedAfterRefresh { standing: st, offered: names } } =>
      names == [stale_census as String, "memtest.iso"]
        && (match media_attach_outcome_reason(outcome: MegaRacNotEnumeratedAfterRefresh { image_name: desired_census, detach: cycle_stop(readback: manual_stop_readback_1630z), standing: st, offered: names }) {
          Present { value: r } =>
            string_contains(s: r, pattern: concat("after the image cycled to re-enumerate the share, ", stale_census as String))
              && string_contains(s: r, pattern: concat("(last offered: ", concat(stale_census as String, ", memtest.iso)")))
              && string_contains(s: r, pattern: "start-media")
          Absent => false
        })
    _ => false
  }
}

// NO RE-ENUMERATION OUTCOME OTHER THAN THE TARGET'S READINESS OPENS THE HANDOFF: a cycle whose start never
// presented, and a target still absent after the cycle, both withhold the boot-device and power writes, so the
// cycled image is never presented across a boot.
test fn a_reenumeration_that_does_not_ready_the_target_withholds_the_handoff() -> Bool {
  let not_presented = MegaRacShareCycleNotPresented { image_name: desired_census, cycled: stale_census as String, start: WriteAccepted { body: "{}" }, reason: "no look presented it", configurations: "[]" }
  let closed = mount_standing_as_of(
    window: refresh_window,
    observations: [absent_at(at: 50000), absent_at(at: 91000)],
    boundary: MountEvaluationBoundary { observed_through: 91000, clock_evidence: lacks_bytes },
  )
  let still_absent = MegaRacNotEnumeratedAfterRefresh { image_name: desired_census, detach: cycle_stop(readback: manual_stop_readback_1630z), standing: closed, offered: [stale_census as String] }
  let gate = fn(o) { megarac_boot_media_gate(record: attempted(result: MegaRacAttachResult { outcome: o, session_release: SessionReleased, baseline: none, secret_file: SecretFileRemoved })) }
  (match gate(not_presented) { MediaGateWithheld { reason: r } => string_contains(s: r as String, pattern: "to re-enumerate the share")  MediaGateReady { evidence: _ } => false })
    && (match gate(still_absent) { MediaGateWithheld { reason: r } => string_contains(s: r as String, pattern: "last offered")  MediaGateReady { evidence: _ } => false })
}
