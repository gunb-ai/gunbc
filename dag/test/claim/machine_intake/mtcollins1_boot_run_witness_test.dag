        concat(
          "----SECTION edac-before----\n----ARGV edac-before: (counters)\n== /sys/devices/system/edac/mc/mc0/ce_count == 0\n== /sys/devices/system/edac/mc/mc0/ue_count == 0\n----EXIT edac-before: 0\n",
          concat(
            "----SECTION workload----\n----ARGV workload: echo workload-write-rc=0; echo workload-digest-stable=yes\nworkload-write-rc=0\n----EXIT workload: 0\n",
            concat(
              "----SECTION edac-after----\n----ARGV edac-after: (counters)\n== /sys/devices/system/edac/mc/mc0/ce_count == 0\n== /sys/devices/system/edac/mc/mc0/ue_count == 0\n----EXIT edac-after: 0\n",
              "=====GUNBC-HOST-CAPTURE mtcollins1 attempt=1 end 2026-09-18T00:04:00Z=====\n",
            ),
          ),
        ),
      ),
    ),
  )
  let boot23_open = concat(
    "=====GUNBC-HOST-CAPTURE mtcollins1 boot-id=8e1d5b0c-2f5e-4d3a-9a1e-0b6f5a1c2d3e begin 2026-09-21T14:47:00Z=====\n",
    concat(
      "----SECTION boot-media----\n----ARGV boot-media: ls -l /dev/disk/by-label; blkid\nLABEL=\"GUNBC_MTC1_CENSUS_2404_3\"\n----EXIT boot-media: 0\n",
      concat(
        "----SECTION nproc----\n----ARGV nproc: nproc\n80\n----EXIT nproc: 0\n",
        concat(
          "----SECTION edac-before----\n----ARGV edac-before: (counters)\n/sys/devices/system/edac/mc/mc0/ce_count == 0\n/sys/devices/system/edac/mc/mc0/ue_count == 0\n----EXIT edac-before: 0\n",
          "----SECTION workload----\n----ARGV workload: (the rendered workload command)\nworkload-write-rc=1\n",
        ),
      ),
    ),
  )
  let accepted = match mtcollins1_boot_terminal_verdict(capture: clean, subject: census_subject, medium: census_medium) {
    TerminalAccepted { run: _, threads: t } => t == "160"
    _ => false
  }
  accepted
    && refused_with_prefix(v: mtcollins1_boot_terminal_verdict(capture: clean, subject: subject, medium: census_medium), prefix: "signed subject names")
    && refused_with(v: mtcollins1_boot_terminal_verdict(capture: stock_medium, subject: census_subject, medium: census_medium), texts: ["boot-media does not name the census volume GUNBC_MTC1_CENSUS_2404_3"])
    && refused_with_prefix(v: mtcollins1_boot_terminal_verdict(capture: clean, subject: subject, medium: MtCollins1StockInstallerMedium), prefix: "signed subject names")
    && refused_with(v: mtcollins1_boot_terminal_verdict(capture: argv_echo_only, subject: census_subject, medium: census_medium), texts: ["workload digest not stable across passes"])
    && is_pending(v: mtcollins1_boot_terminal_verdict(capture: "BootControlIssued cdrom", subject: census_subject, medium: census_medium))
    && refused_with(v: mtcollins1_boot_terminal_verdict(capture: ghes_ce, subject: census_subject, medium: census_medium), texts: ["edac-before: mc0 ce_count/ue_count not both 0"])
    && refused_with(v: mtcollins1_boot_terminal_verdict(capture: ue, subject: census_subject, medium: census_medium), texts: ["edac-before: mc0 ce_count/ue_count not both 0"])
    && refused_with(v: mtcollins1_boot_terminal_verdict(capture: nproc_elsewhere, subject: census_subject, medium: census_medium), texts: ["nproc exited 1"])
    && refused_with(v: mtcollins1_boot_terminal_verdict(capture: digest_mismatch, subject: census_subject, medium: census_medium), texts: ["workload digest not stable across passes"])
    && is_pending(v: mtcollins1_boot_terminal_verdict(capture: begin_only, subject: census_subject, medium: census_medium))
    && is_pending(v: mtcollins1_boot_terminal_verdict(capture: begin_with_spurious_end, subject: census_subject, medium: census_medium))
    && refused_with(v: mtcollins1_boot_terminal_verdict(capture: boot23_open, subject: census_subject, medium: census_medium), texts: ["nproc observed 80, qualification expects 160", "workload write rc=1"])
    && review_5269655400_walls(census_subject: census_subject, census_medium: census_medium, clean: clean, boot23_open: boot23_open)
    && string_contains(s: mtcollins1_boot_terminal_refusal_text(causes: [HardwareThreadCountMismatch { expected: "160", observed: "80" }, WorkloadWriteFailed { rc: "1" }]), pattern: "nproc observed 80, qualification expects 160; workload write rc=1")
}

test fn boot_loopback_filing_is_srv1_only() -> Bool {
  mtcollins1_boot_host_must_be_srv1(host: operator_host_srv1 as String)
    && !mtcollins1_boot_host_must_be_srv1(host: operator_host_srv2 as String)
    && match mtcollins1_boot_refuses_off_srv1(host: operator_host_srv1 as String) { ExitSuccess => true  _ => false }
    && match mtcollins1_boot_refuses_off_srv1(host: operator_host_srv2 as String) { ExitSuccess => false  _ => true }
}

// THE FLEET KEY IS MATERIALIZED FOR THIS MODE, AND THE CONTROL IS THE MODE BESIDE IT. The
// fleet-converge key step's condition is derived from the per-mode demand, so this is the executing
// consumer of MtCollins1Boot => FleetSshKeyConsumed rather than a restatement of the arm.
// approval_keyring_converge is asserted PRESENT in the same string because it is a real fleet-SSH
// demand too, which keeps the claim from being satisfiable by a condition that names everything.
//
// WHY Consumed IS THE HONEST VALUE SINCE CENSUS STAGE 0D. Every transport mtcollins1_boot_wet's
// closure reached before 0D presented a credential that is not the fleet key (local files, HTTP
// loopback under the submission MAC key, HTTPS and ipmitool to the BMC under the pinned BMC
// credential), and this claim asserted the arm NotConsumed as that route's executing consumer. 0D
// adds one leg: gunbc.machine_intake_mtcollins1_census_medium_readback re-measures the served census
// image on srv2 through typed_argv_exec_over_fleet_ssh as the fleet principal before the signed
// subject is minted -- a genuine fleet-SSH demand, so the arm flips and this claim flips with it.
// Flip the arm back and the boot job runs without the key its readback needs; this claim goes red.
test fn mtcollins1_boot_materializes_the_fleet_key_for_the_census_readback() -> Bool {
  let c = fleet_converge_fleet_ssh_key_step_if
  string_contains(s: c, pattern: "'mtcollins1_boot'")
    && string_contains(s: c, pattern: "'approval_keyring_converge'")
}

// THE MEDIUM GATE REFUSES BEFORE ANY CONTROLLER WRITE. A boot that attaches the stock installer can
// never print the census terminal, and the run says so from the row rather than after a hardware
// run (review 69352); the census medium passes the gate and names the label the verdict binds to.
test fn the_stock_installer_medium_refuses_the_census_boot_at_the_gate() -> Bool {
  match mtcollins1_boot_medium_refusal(medium: MtCollins1StockInstallerMedium) {
    Present { value: why } => string_contains(s: why, pattern: "controller untouched") && string_contains(s: why, pattern: "no census program")
    Absent => false
  }
}

test fn the_census_medium_passes_the_gate_and_binds_the_verdict_to_its_label() -> Bool {
  let medium = MtCollins1CensusMedium { output_digest: "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef" as NonEmptyStr }
  match mtcollins1_boot_medium_refusal(medium: medium) {
    Present { value: _ } => false
    Absent =>
      match mtcollins1_boot_medium_label(medium: medium) {
        Absent => false
        Present { value: label } => (label as String) == "GUNBC_MTC1_CENSUS_2404_3"
      }
  }
}
