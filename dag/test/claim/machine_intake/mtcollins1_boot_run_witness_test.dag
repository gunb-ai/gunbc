data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// NO APPROVAL WINDOW (operator ruling 2026-09-23): the step budget is the boot's own phases only.
test fn the_step_timeout_covers_the_boot_phases() -> Bool {
  let covered = (second_count(s: mtcollins1_boot_prelude_allowance) as Int)
    + (second_count(s: mtcollins1_boot_issue_allowance) as Int)
    + (second_count(s: mtcollins1_boot_actuation_allowance) as Int)
    + (second_count(s: mtcollins1_boot_cleanup_allowance) as Int)
    + (second_count(s: mtcollins1_boot_diagnostics_allowance()) as Int)
  (minute_count(m: mtcollins1_boot_step_timeout_minutes()) as Int) * 60 >= covered
}

test fn sol_held_is_a_live_ipmitool_pid_not_a_nonempty_capture() -> Bool {
  !mtcollins1_boot_sol_is_held(pid_path: "")
    && !mtcollins1_boot_sol_held_from_observations(
      pid_path: "/tmp/sol.pid",
      pid_file_ok: false,
      pid_file_content: "123",
      cmdline_ok: true,
      cmdline_content: "ipmitool",
    )
    && !mtcollins1_boot_sol_held_from_observations(
      pid_path: "/tmp/sol.pid",
      pid_file_ok: true,
      pid_file_content: "\n",
      cmdline_ok: true,
      cmdline_content: "ipmitool",
    )
    && !mtcollins1_boot_sol_held_from_observations(
      pid_path: "/tmp/sol.pid",
      pid_file_ok: true,
      pid_file_content: "123\n",
      cmdline_ok: true,
      cmdline_content: "bash",
    )
    && !mtcollins1_boot_sol_held_from_observations(
      pid_path: "/tmp/sol.pid",
      pid_file_ok: true,
      pid_file_content: "123\n",
      cmdline_ok: false,
      cmdline_content: "ipmitool",
    )
    && mtcollins1_boot_sol_held_from_observations(
      pid_path: "/tmp/sol.pid",
      pid_file_ok: true,
      pid_file_content: "123\n",
      cmdline_ok: true,
      cmdline_content: "ipmitool sol activate",
    )
}

test fn sol_lease_observation_is_the_collector_we_hold_not_sol_info() -> Bool {
  held_lease_observed_verdict(
    observed: mtcollins1_sol_observed_from_collector(
      pid_path_set: false,
      pid_file_ok: false,
      pid_file_content: "",
      collector_held: false,
    ),
  ) == Inaccessible
    && held_lease_observed_verdict(
      observed: mtcollins1_sol_observed_from_collector(
        pid_path_set: true,
        pid_file_ok: true,
        pid_file_content: "123\n",
        collector_held: true,
      ),
    ) == Converged
    && held_lease_observed_verdict(
      observed: mtcollins1_sol_observed_from_collector(
        pid_path_set: true,
        pid_file_ok: true,
        pid_file_content: "123\n",
        collector_held: false,
      ),
    ) == Drifted
    && held_lease_observed_verdict(
      observed: mtcollins1_sol_observed_from_collector(
        pid_path_set: true,
        pid_file_ok: false,
        pid_file_content: "",
        collector_held: false,
      ),
    ) == Absent
    && mtcollins1_sol_observed_from_collector(
      pid_path_set: true,
      pid_file_ok: true,
      pid_file_content: "123\n",
      collector_held: false,
    ) == LeaseRunningStale
    && mtcollins1_sol_observed_from_collector(
      pid_path_set: true,
      pid_file_ok: true,
      pid_file_content: "123\n",
      collector_held: true,
    ) == LeaseRunningExpected
    && mtcollins1_sol_observed_from_collector(
      pid_path_set: false,
      pid_file_ok: false,
      pid_file_content: "SOL enabled",
      collector_held: false,
    ) == LeaseInaccessible
}

// A refusal is compared by its rendered causes, in order: the list pattern is the claim.
fn refused_with(v: MtCollins1BootTerminalVerdict, texts: List<String>) -> Bool {
  match v {
    TerminalRefused { causes: cs } => map(cs, c => mtcollins1_boot_terminal_cause_text(cause: c)) == texts
    _ => false
  }
}

// An open envelope that refuses names every qualification it had not yet read
// (mtcollins1_boot_run open_unresolved_causes), after the causes that refused.
fn unobserved(name: String) -> String {
  concat(name, " not yet observed when the open envelope refused; unqualified")
}

fn refused_with_prefix(v: MtCollins1BootTerminalVerdict, prefix: String) -> Bool {
  match v {
    TerminalRefused { causes: cs } => count(cs) == 1 && all(cs, c => starts_with(s: mtcollins1_boot_terminal_cause_text(cause: c), prefix: prefix))
    _ => false
  }
}

fn is_pending(v: MtCollins1BootTerminalVerdict) -> Bool {
  match v { TerminalPending { reason: _ } => true  _ => false }
}

// A PENDING CARRIES WHAT WAS OBSERVED, which is what the deadline reports instead of a bare
// "timed out": the reason is the evidence, so it is asserted rather than discarded here too.
fn pending_because(v: MtCollins1BootTerminalVerdict, fragment: String) -> Bool {
  match v { TerminalPending { reason: r } => string_contains(s: r, pattern: fragment)  _ => false }
}

// THE FOUR WALLS OF REVIEW 5269655400, each with its RED and its positive control:
// (1) a second begin for the machine while the envelope is open refuses -- run B's refusing
//     section may not inhabit run A's open envelope;
// (2) a section without its ARGV line never completes -- text before ARGV is not output and an
//     EXIT before ARGV mints nothing; and a SECOND ARGV is malformed, never a reset (review
//     5270388845) -- the one-ARGV a_only fixture beside it is the positive control;
// (3) an unterminated final fragment is not evidence -- "workload-write-rc=1" without its newline
//     is Pending, with it Refused;
// (4) a same-name / different-digest subject-medium disagreement renders the digests, never
//     "names X but the medium row names X". The image name derives from the digest, so that
//     subject cannot come from the constructor: it is a forged or stale signed subject, built
//     field-for-field in the fold.
// Review 69667: in a CLOSED envelope a section that opened and never printed its EXIT line is
// "unterminated", not "absent", and a section whose printed output already refused is not
// reported a second time -- closed_unterminated_workload yields exactly the write refusal plus the
// unterminated edac-after, never a third cause about the workload.
fn review_5269655400_walls(census_subject: MtCollins1BootSubject, census_medium: MtCollins1BootMedium, clean: String, boot23_open: String) -> Bool {
  let begin_a = "=====GUNBC-HOST-CAPTURE mtcollins1 boot-id=aaaaaaaa-0000-4000-8000-000000000001 begin 2026-09-21T14:47:00Z=====\n"
  let begin_b = "=====GUNBC-HOST-CAPTURE mtcollins1 boot-id=bbbbbbbb-0000-4000-8000-000000000002 begin 2026-09-21T14:52:00Z=====\n"
  let refusing_nproc = "----SECTION nproc----\n----ARGV nproc: nproc\n80\n----EXIT nproc: 0\n"
  let restarted = concat(begin_a, begin_b, refusing_nproc)
  let no_argv = concat(begin_a, "----SECTION nproc----\n80\n----EXIT nproc: 0\n")
  let exit_before_argv = concat(begin_a, "----SECTION nproc----\n----EXIT nproc: 0\n----ARGV nproc: nproc\n80\n")
  let two_argv = concat(begin_a, "----SECTION nproc----\n----ARGV nproc: nproc\n160\n----ARGV nproc: second-boundary\n----EXIT nproc: 0\n")
  let unterminated = concat(begin_a, "----SECTION workload----\n----ARGV workload: (the rendered workload command)\nworkload-write-rc=1")
  let terminated = concat(unterminated, "\n")
  let closed_unterminated_workload = concat(begin_a,
    "----SECTION boot-media----\n----ARGV boot-media: blkid\nLABEL=\"GUNBC_MTC1_CENSUS_2404_3\"\n----EXIT boot-media: 0\n",
    "----SECTION nproc----\n----ARGV nproc: nproc\n160\n----EXIT nproc: 0\n",
    "----SECTION edac-before----\n----ARGV edac-before: (counters)\n/sys/devices/system/edac/mc/mc0/ce_count == 0\n/sys/devices/system/edac/mc/mc0/ue_count == 0\n----EXIT edac-before: 0\n",
    "----SECTION workload----\n----ARGV workload: (the rendered workload command)\nworkload-write-rc=1\n",
    "----SECTION edac-after----\n----ARGV edac-after: (counters)\n/sys/devices/system/edac/mc/mc0/ce_count == 0\n",
    "=====GUNBC-HOST-CAPTURE mtcollins1 boot-id=aaaaaaaa-0000-4000-8000-000000000001 end 2026-09-21T14:55:00Z=====\n")
  let same_name_other_digest = MtCollins1BootSubject {
    machine: census_subject.machine,
    bmc_host: census_subject.bmc_host,
    image_name: census_subject.image_name,
    image_sha256: "fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210" as NonEmptyStr,
    export_host: census_subject.export_host,
    export_dir: census_subject.export_dir,
    selection: census_subject.selection,
    power_action: census_subject.power_action,
    execution_revision: census_subject.execution_revision,
  }
  (match mtcollins1_boot_terminal_verdict(capture: restarted, subject: census_subject, medium: census_medium) {
    TerminalRefused { causes: cs } => count(cs) == 1 && all(cs, c => string_contains(s: mtcollins1_boot_terminal_cause_text(cause: c), pattern: "second begin marker"))
    _ => false })
    && refused_with(v: mtcollins1_boot_terminal_verdict(capture: concat(begin_a, refusing_nproc), subject: census_subject, medium: census_medium), texts: ["nproc observed 80, qualification expects 160", unobserved(name: "boot-media"), unobserved(name: "edac-before"), unobserved(name: "workload"), unobserved(name: "edac-after")])
    && is_pending(v: mtcollins1_boot_terminal_verdict(capture: no_argv, subject: census_subject, medium: census_medium))
    && is_pending(v: mtcollins1_boot_terminal_verdict(capture: exit_before_argv, subject: census_subject, medium: census_medium))
    && refused_with(v: mtcollins1_boot_terminal_verdict(capture: two_argv, subject: census_subject, medium: census_medium), texts: ["section nproc carries two ARGV boundaries; which output the exit belongs to is not a fact", unobserved(name: "boot-media"), unobserved(name: "edac-before"), unobserved(name: "workload"), unobserved(name: "edac-after")])
    && is_pending(v: mtcollins1_boot_terminal_verdict(capture: unterminated, subject: census_subject, medium: census_medium))
    && refused_with(v: mtcollins1_boot_terminal_verdict(capture: closed_unterminated_workload, subject: census_subject, medium: census_medium), texts: ["workload write rc=1", "closed envelope's edac-after section never printed its EXIT line"])
    && refused_with(v: mtcollins1_boot_terminal_verdict(capture: terminated, subject: census_subject, medium: census_medium), texts: ["workload write rc=1", unobserved(name: "nproc"), unobserved(name: "boot-media"), unobserved(name: "edac-before"), unobserved(name: "edac-after")])
    && (match mtcollins1_boot_terminal_verdict(capture: clean, subject: same_name_other_digest, medium: census_medium) {
      TerminalRefused { causes: cs } => count(cs) == 1 && all(cs, c => {
        let t = mtcollins1_boot_terminal_cause_text(cause: c)
        string_contains(s: t, pattern: "both name") && string_contains(s: t, pattern: "fedcba98") && string_contains(s: t, pattern: "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef")
      })
      _ => false })
}

// Every closed fixture ends its END marker with a newline, as the program does: an END marker whose
// newline has not arrived is an unterminated fragment and does not close the envelope.
// The last fixture is BOOT 23 ATTEMPT 3, run 35612872611, as the capture stood eight minutes before
// the deadline: the envelope open, nproc complete at 80, the workload section still hashing after
// printing a failed write. The verdict is REFUSED with both causes; the old Bool read it as "not
// yet" until timeout.
test fn boot_terminal_is_the_host_capture_not_boot_control_issued() -> Bool {
  let subject = mtcollins1_boot_subject(execution_revision: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
  let census_medium = MtCollins1CensusMedium { output_digest: "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef" as NonEmptyStr }
  let census_subject = mtcollins1_boot_subject_for(medium: census_medium, execution_revision: "0123456789abcdef0123456789abcdef01234567" as NonEmptyStr)
  let clean = concat(
    "=====GUNBC-HOST-CAPTURE mtcollins1 attempt=1 begin 2026-09-18T00:00:00Z=====\n",
    concat(
      "----SECTION boot-media----\n----ARGV boot-media: ls -l /dev/disk/by-label; blkid\nLABEL=\"GUNBC_MTC1_CENSUS_2404_3\"\n----EXIT boot-media: 0\n",
      concat(
        "----SECTION nproc----\n----ARGV nproc: nproc\n160\n----EXIT nproc: 0\n",
        concat(
          "----SECTION edac-before----\n----ARGV edac-before: (counters)\n== /sys/devices/system/edac/mc/mc0/ce_count == 0\n== /sys/devices/system/edac/mc/mc0/ue_count == 0\n----EXIT edac-before: 0\n",
          concat(
            "----SECTION workload----\n----ARGV workload: (the rendered workload command)\nworkload-write-rc=0\nworkload-digest-stable=yes\n----EXIT workload: 0\n",
            concat(
              "----SECTION edac-after----\n----ARGV edac-after: (counters)\n== /sys/devices/system/edac/mc/mc0/ce_count == 0\n== /sys/devices/system/edac/mc/mc0/ue_count == 0\n----EXIT edac-after: 0\n",
              "=====GUNBC-HOST-CAPTURE mtcollins1 attempt=1 end 2026-09-18T00:04:00Z=====\n",
            ),
          ),
        ),
      ),
    ),
  )
  let ghes_ce = concat(
    "=====GUNBC-HOST-CAPTURE mtcollins1 attempt=1 begin 2026-09-18T00:00:00Z=====\n",
    concat(
      "----SECTION boot-media----\n----ARGV boot-media: ls -l /dev/disk/by-label; blkid\nLABEL=\"GUNBC_MTC1_CENSUS_2404_3\"\n----EXIT boot-media: 0\n",
      concat(
