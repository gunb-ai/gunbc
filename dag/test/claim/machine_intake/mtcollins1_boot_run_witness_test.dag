          "----SECTION edac-before----\n----ARGV edac-before: (counters)\n== /sys/devices/system/edac/mc/mc0/ce_count == 0\n== /sys/devices/system/edac/mc/mc0/ue_count == 0\n----EXIT edac-before: 0\n",
          concat(
            "----SECTION workload----\n----ARGV workload: echo workload-write-rc=0; echo workload-digest-stable=yes\nworkload-write-rc=0\n----EXIT workload: 0\n",
            concat(
              "----SECTION edac-after----\n----ARGV edac-after: (counters)\n== /sys/devices/system/edac/mc/mc0/ce_count == 0\n== /sys/devices/system/edac/mc/mc0/ue_count == 0\n----EXIT edac-after: 0\n",
              "=====GUNBC-HOST-CAPTURE mtcollins1 attempt=1 end 2026-09-18T00:04:00Z=====\n",
            ),
          ),
        ),
      ),
    ),
  )
  let boot23_open = concat(
    "=====GUNBC-HOST-CAPTURE mtcollins1 boot-id=8e1d5b0c-2f5e-4d3a-9a1e-0b6f5a1c2d3e begin 2026-09-21T14:47:00Z=====\n",
    concat(
      "----SECTION boot-media----\n----ARGV boot-media: ls -l /dev/disk/by-label; blkid\nLABEL=\"GUNBC_MTC1_CENSUS_2404_3\"\n----EXIT boot-media: 0\n",
      concat(
        "----SECTION nproc----\n----ARGV nproc: nproc\n80\n----EXIT nproc: 0\n",
        concat(
          "----SECTION edac-before----\n----ARGV edac-before: (counters)\n/sys/devices/system/edac/mc/mc0/ce_count == 0\n/sys/devices/system/edac/mc/mc0/ue_count == 0\n----EXIT edac-before: 0\n",
          "----SECTION workload----\n----ARGV workload: (the rendered workload command)\nworkload-write-rc=1\n",
        ),
      ),
    ),
  )
  let accepted = match mtcollins1_boot_terminal_verdict(capture: clean, subject: census_subject, medium: census_medium) {
    TerminalAccepted { run: _, threads: t } => hardware_thread_count_value(t: t) == 160
    _ => false
  }
  accepted
    && refused_with_prefix(v: mtcollins1_boot_terminal_verdict(capture: clean, subject: subject, medium: census_medium), prefix: "signed subject names")
    && refused_with(v: mtcollins1_boot_terminal_verdict(capture: stock_medium, subject: census_subject, medium: census_medium), texts: ["boot-media does not name the census volume GUNBC_MTC1_CENSUS_2404_3"])
    && refused_with_prefix(v: mtcollins1_boot_terminal_verdict(capture: clean, subject: subject, medium: MtCollins1StockInstallerMedium), prefix: "signed subject names")
    && refused_with(v: mtcollins1_boot_terminal_verdict(capture: argv_echo_only, subject: census_subject, medium: census_medium), texts: ["workload digest not stable across passes"])
    && is_pending(v: mtcollins1_boot_terminal_verdict(capture: "BootControlIssued cdrom", subject: census_subject, medium: census_medium))
    && refused_with(v: mtcollins1_boot_terminal_verdict(capture: ghes_ce, subject: census_subject, medium: census_medium), texts: ["edac-before: mc0 ce_count/ue_count not both 0"])
    && refused_with(v: mtcollins1_boot_terminal_verdict(capture: ue, subject: census_subject, medium: census_medium), texts: ["edac-before: mc0 ce_count/ue_count not both 0"])
    && refused_with(v: mtcollins1_boot_terminal_verdict(capture: nproc_elsewhere, subject: census_subject, medium: census_medium), texts: ["nproc exited 1"])
    && refused_with(v: mtcollins1_boot_terminal_verdict(capture: digest_mismatch, subject: census_subject, medium: census_medium), texts: ["workload digest not stable across passes"])
    && is_pending(v: mtcollins1_boot_terminal_verdict(capture: begin_only, subject: census_subject, medium: census_medium))
    && is_pending(v: mtcollins1_boot_terminal_verdict(capture: begin_with_spurious_end, subject: census_subject, medium: census_medium))
    && refused_with(v: mtcollins1_boot_terminal_verdict(capture: boot23_open, subject: census_subject, medium: census_medium), texts: ["nproc observed 80, qualification expects 160", "workload write rc=1", unobserved(name: "edac-after")])
    && review_5269655400_walls(census_subject: census_subject, census_medium: census_medium, clean: clean, boot23_open: boot23_open)
    && string_contains(s: mtcollins1_boot_terminal_refusal_text(causes: [HardwareThreadCountMismatch { expected: hardware_thread_count(count: 160), observed: "80" }, WorkloadWriteFailed { rc: "1" }]), pattern: "nproc observed 80, qualification expects 160; workload write rc=1")
}

// THE UNIT HOLD STORE IS ON THE RUNNER HOST, so a boot anywhere else would take a hold the operator
// cannot see: srv1 only.
test fn boot_is_srv1_only_where_the_unit_hold_store_is() -> Bool {
  mtcollins1_boot_host_must_be_srv1(host: operator_host_srv1 as String)
    && !mtcollins1_boot_host_must_be_srv1(host: operator_host_srv2 as String)
    && match mtcollins1_boot_refuses_off_srv1(host: operator_host_srv1 as String) { ExitSuccess => true  _ => false }
    && match mtcollins1_boot_refuses_off_srv1(host: operator_host_srv2 as String) { ExitSuccess => false  _ => true }
}

// THE FLEET KEY IS MATERIALIZED IN THE BOOT'S OWN JOB. Since the boot became its own job (its
// identity is the dedicated mtcollins1-boot federation, gunbc.auth.mtcollins1_boot_federation), the
// key step is a step of that job, taken under the dedicated account's pinned cell. The census
// medium readback on srv2 runs over fleet ssh, so a boot job without it could not re-measure the
// served image; drop the step and this claim goes red. The approval submission MAC key is asserted
// ABSENT from the job's scripts: it existed only to sign the approval filing.
fn step_run_text(s: Step) -> String {
  match s {
    RunStep { name: _, id: _, run: r, shell: _, env: _, working_directory: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } => r
    UsesStep { name: _, id: _, uses: _, with: _, env: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } => ""
  }
}

test fn mtcollins1_boot_job_materializes_the_fleet_key_and_not_the_submission_key() -> Bool {
  let runs = join(map(fleet_converge_mtcollins1_boot_job().steps, s => step_run_text(s: s)), "\n")
  string_contains(s: runs, pattern: "fleet-automation-ssh-key")
    && !string_contains(s: runs, pattern: "approval-submission-mac-key")
    && string_contains(s: runs, pattern: "bmc-mtcollins1-gunbc")
}

// THE MEDIUM GATE REFUSES BEFORE ANY CONTROLLER WRITE. A boot that attaches the stock installer can
// never print the census terminal, and the run says so from the row rather than after a hardware
// run (review 69352); the census medium passes the gate and names the label the verdict binds to.
test fn the_stock_installer_medium_refuses_the_census_boot_at_the_gate() -> Bool {
  match mtcollins1_boot_medium_refusal(medium: MtCollins1StockInstallerMedium) {
    Present { value: why } => string_contains(s: why, pattern: "controller untouched") && string_contains(s: why, pattern: "no census program")
    Absent => false
  }
}

test fn the_census_medium_passes_the_gate_and_binds_the_verdict_to_its_label() -> Bool {
  let medium = MtCollins1CensusMedium { output_digest: "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef" as NonEmptyStr }
  match mtcollins1_boot_medium_refusal(medium: medium) {
    Present { value: _ } => false
    Absent =>
      match mtcollins1_boot_medium_label(medium: medium) {
        Absent => false
        Present { value: label } => (label as String) == "GUNBC_MTC1_CENSUS_2404_3"
      }
  }
}

// PRE-OS REFUSALS END THE BOOT BEFORE ANY ENVELOPE. Fixtures are the console lines boot 23
// attempt 7 (run 35669747413) and the 2026-09-12 DDR-init captures actually printed. A GRUB error
// while the loader is still trying, and the bare menu banner, stay PENDING: the boot may proceed.
test fn a_pre_os_refusal_on_the_console_is_a_typed_refusal_not_a_timeout() -> Bool {
  let grub_failed = concat(
    "Checkpoint AD\n",
    "GNU GRUB  version 2.12\n",
    "      Press enter to boot the selected OS, `e' to edit the commands       \n",
    "error: you need to load the kernel first.\n",
    "Press any key to continue...\n",
    "  Failed to boot both default and fallback entries.\n",
    "Press any key to continue...\n",
    "GNU GRUB  version 2.12\n")
  let grub_trying = "GNU GRUB  version 2.12\nerror: failure reading sector 0xc5130 from `cd0'.\n"
  let banner_only = "Checkpoint AD\nGNU GRUB  version 2.12\n"
  let ddr = "NOTICE:  DRAM FW version 210525\nERROR:   SK[1]: 00110010\nERROR:     MC[4]: 00f10081\nERROR:   DDR initialization failure. STOP!\n"
  let unterminated_failure = "GNU GRUB  version 2.12\n  Failed to boot both default and fallback entries."
  (match mtcollins1_boot_pre_os_verdict(capture: grub_failed) {
    TerminalRefused { causes: cs } => count(cs) == 1 && all(cs, c => {
      let t = mtcollins1_boot_terminal_cause_text(cause: c)
      starts_with(s: t, prefix: "boot loader failed both default and fallback entries") && string_contains(s: t, pattern: "you need to load the kernel first")
    })
    _ => false })
    && is_pending(v: mtcollins1_boot_pre_os_verdict(capture: grub_trying))
    && pending_because(v: mtcollins1_boot_pre_os_verdict(capture: grub_trying), fragment: "media read failed on cd0")
    && is_pending(v: mtcollins1_boot_pre_os_verdict(capture: banner_only))
    && is_pending(v: mtcollins1_boot_pre_os_verdict(capture: ""))
    && is_pending(v: mtcollins1_boot_pre_os_verdict(capture: unterminated_failure))
    && (match mtcollins1_boot_pre_os_verdict(capture: ddr) {
      TerminalRefused { causes: cs } => count(cs) == 1 && all(cs, c => mtcollins1_boot_terminal_cause_text(cause: c) == "firmware refused before any kernel: ERROR:   DDR initialization failure. STOP! [socket 1] [memory controller 4]")
      _ => false })
    && (match mtcollins1_boot_terminal_verdict(capture: grub_failed, subject: mtcollins1_boot_subject_for(medium: MtCollins1CensusMedium { output_digest: "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef" as NonEmptyStr }, execution_revision: "0123456789abcdef0123456789abcdef01234567" as NonEmptyStr), medium: MtCollins1CensusMedium { output_digest: "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef" as NonEmptyStr }) {
      TerminalRefused { causes: cs } => count(cs) == 1
      _ => false })
}

// EVERY ACQUISITION THAT GOES ON TO READ THE CAPTURE BINDS IT TO THIS ATTEMPT FIRST. This is the
// claim that was RED before the repair it guards: the converged arm -- a collector we already hold
// -- returned plain success without ever binding the capture, so a GRUB refusal left in the file by
// an EARLIER attempt was readable as this attempt's evidence, and the typed pre-OS refusal beside
// it would have aborted the claim on another boot's failure. The live workflow truncated the file
// in its shell prelude, so CI was green on a second safety net while the fold's own annotation
// claimed a construction it did not have.
//
// The assertion is on the MAPPING rather than on a predicate over the sum: a predicate answering
// true for every arm is permanently green by construction (section 4b calls that a decoration), so
// what is asserted is that converged yields the BINDING arm and that each refusing observation
// still refuses -- which is exactly what flips if the bypass returns.
test fn every_acquisition_that_reads_the_capture_binds_it_to_this_attempt() -> Bool {
  let pid = "/run/mtcollins1-sol.pid"
  let cap = "/run/mtcollins1-sol.out"
  (match sol_acquire_plan(verdict: Converged, pid_path: pid, capture_path: cap) {
    SolAcquireBindHeldCollector => true  _ => false })
    && (match sol_acquire_plan(verdict: Absent, pid_path: pid, capture_path: cap) {
      SolAcquireStart => true  _ => false })
    && (match sol_acquire_plan(verdict: Drifted, pid_path: pid, capture_path: cap) {
      SolAcquireReleaseThenStart => true  _ => false })
    && (match sol_acquire_plan(verdict: Conflict, pid_path: pid, capture_path: cap) {
      SolAcquireRefuse { reason: _ } => true  _ => false })
    && (match sol_acquire_plan(verdict: Inaccessible, pid_path: pid, capture_path: cap) {
      SolAcquireRefuse { reason: _ } => true  _ => false })
    && (match sol_acquire_plan(verdict: UnknownRefused, pid_path: pid, capture_path: cap) {
      SolAcquireRefuse { reason: _ } => true  _ => false })
    && (match sol_acquire_plan(verdict: Converged, pid_path: pid, capture_path: "") {
      SolAcquireRefuse { reason: _ } => true  _ => false })
    && (match sol_acquire_plan(verdict: Converged, pid_path: "", capture_path: cap) {
      SolAcquireRefuse { reason: _ } => true  _ => false })
}

// WALL 1 (side-chat review 5286225278): NO DISPATCH INPUT SELECTS THE BYTES THE WIF JOB EXECUTES. The
// boot job's own checkout names only the event sha, and nothing in the rendered job mentions
// expected_revision; the build job that produces the binaries it downloads checks out the event sha
// FIRST for this mode, before expected_revision is consulted. RED: put expected_revision back in
// either expression and this claim fails.
// Read at the interface (DESIGN §3): the boot job's own checkout ref, its steps' run texts and its
// env/with values, not a YAML render of the whole job.
fn kv_text(e: YamlKeyValue) -> String {
  match e.value {
    YamlString { value: v } => v
    _ => ""
  }
}

fn step_inputs_text(s: Step) -> String {
  match s {
    RunStep { name: _, id: _, run: r, shell: _, env: e, working_directory: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } =>
      concat(r, match e { Present { value: es } => join(map(es, x => kv_text(e: x)), " ")  _ => "" })
    UsesStep { name: _, id: _, uses: _, with: w, env: e, if_condition: _, continue_on_error: _, timeout_minutes: _ } =>
      concat(match w { Present { value: ws } => join(map(ws, x => kv_text(e: x)), " ")  _ => "" }, match e { Present { value: es } => join(map(es, x => kv_text(e: x)), " ")  _ => "" })
  }
}

test fn another_expected_revision_cannot_change_a_byte_the_boot_job_executes() -> Bool {
  let inputs = join(map(fleet_converge_mtcollins1_boot_job().steps, s => step_inputs_text(s: s)), "\n")
  fleet_converge_mtcollins1_boot_checkout_ref_expr == "${{ github.sha }}"
    && !string_contains(s: inputs, pattern: "expected_revision")
    && string_contains(s: inputs, pattern: "${{ github.sha }}")
    && starts_with(s: fleet_converge_checkout_ref_expr, prefix: "${{ github.event.inputs.mode == 'mtcollins1_boot' && github.sha || ")
}

fn runner_labels(r: RunnerSpec) -> List<String> {
  match r {
    SelfHosted { labels: ls } => ls
    RunsOnExpression { expression: _ } => []
    HostedRunner { label: _ } => []
  }
}

// WALL 2: THE CREDENTIALS NEVER REACH A CALLER-SELECTED RUNNER. runs-on is srv1's literal labels, the
// concurrency domain is srv1's, and the job-level condition refuses any other host, so a dispatch of
// mode=mtcollins1_boot host=srv2 never starts the job: no OIDC exchange and no secret fetch happen
// anywhere. RED: the runner reading inputs.host, or the condition losing the host term.
test fn a_boot_dispatch_naming_another_host_never_starts_the_job() -> Bool {
  let j = fleet_converge_mtcollins1_boot_job()
  runner_labels(r: j.runner) == ["self-hosted", "linux", "arm64", "srv1"]
    && string_contains(s: fleet_converge_mtcollins1_boot_job_if, pattern: "github.event.inputs.host == 'srv1'")
    && string_contains(s: fleet_converge_mtcollins1_boot_job_if, pattern: "github.event.inputs.mode == 'mtcollins1_boot'")
    && fleet_converge_mtcollins1_boot_concurrency_group == "gunbc-host-mutation-srv1"
}
