module test.claim.mtjade1_access_witness

import std.types { Bool, String }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import gunbc.machine_intake_mtjade1_access_observation {
  JadeUnitKeyAwaitingFru,
  mtjade1_firmware_family_standing,
  mtjade1_unit_key_standing,
}
import gunbc.machine_intake_bmc_first_contact_standing {
  FamilyObserved,
  FamilyUnobserved,
  bmc_intake_may_use_megarac_media_attach,
  bmc_intake_may_use_openbmc_factory_login,
}
import gunbc.machine_intake_subject {
  BoardSerialAbsent,
  UnitIdentityInputs,
  UnitKeyBound,
  UnitKeyRefused,
  bind_unit_key,
}
import extdeps.bmc.endpoint { BmcEndpoint, Ipmi }
import gunbc.secret_provision { mtcollins1_bmc_gunbc_secret_ref, mtjade1_bmc_gunbc_secret_ref }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn w_mtjade1_family_is_unobserved_and_cannot_select_a_factory_or_megarac_path() -> Bool {
  match mtjade1_firmware_family_standing {
    FamilyUnobserved { discriminator: _ } => true
    FamilyObserved { family: _ } => false
  }
    && bmc_intake_may_use_openbmc_factory_login(family: mtjade1_firmware_family_standing) == false
    && bmc_intake_may_use_megarac_media_attach(family: mtjade1_firmware_family_standing) == false
}

test fn w_mtjade1_unit_key_awaits_fru() -> Bool {
  match mtjade1_unit_key_standing {
    JadeUnitKeyAwaitingFru { discriminator: _ } => true
  }
}

test fn w_bmc_only_bind_without_serials_is_absent_not_a_fabricated_key() -> Bool {
  match bind_unit_key(
    inputs: UnitIdentityInputs {
      bmc_endpoint: BmcEndpoint { host: "fixture-jade-bmc", protocol: Ipmi },
      board_serial_observations: [],
    },
    other_units: [],
  ) {
    UnitKeyRefused { cause: BoardSerialAbsent } => true
    UnitKeyRefused { cause: _ } => false
    UnitKeyBound { key: _ } => false
  }
}

test fn w_mtjade1_bmc_secret_locus_is_not_the_collins_secret() -> Bool {
  (mtjade1_bmc_gunbc_secret_ref.secret as String) == "bmc-mtjade1-gunbc"
    && (mtcollins1_bmc_gunbc_secret_ref.secret as String) == "bmc-mtcollins1-gunbc"
    && (mtjade1_bmc_gunbc_secret_ref.secret as String) != (mtcollins1_bmc_gunbc_secret_ref.secret as String)
}
