import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn same_nats(a: List<Nat>, b: List<Nat>) -> Bool {
  list_length(items: a) == list_length(items: b)
    && fold(a, init: true, f: (acc, x) => acc && fold(b, init: false, f: (o, y) => o || x == y))
}

// A controlled fixture for the discriminating boot: only the drawing-'J25' stick removed.
// Not an observation; the real roster lands as a production anchor row.
fn two_stick_fixture(controller: Nat) -> MtCollins1PlacementAnchor {
  MtCollins1PlacementAnchor {
    evidence: FirmwareTrainedFact { run_id: 1, artifact: "controlled fixture", roster_lines: ["fixture"] },
    placed_at_drawing_labels: [1, 17],
    trained: [MtCollins1TrainedSlot { socket: 0, controller: controller, slot: 0 }],
    live_sockets: [0],
  }
}

data rear_fixture: MtCollins1Viewpoint = ViewpointReported { end: RearEnd, report: OperatorByEyeReport {
  observed_on: SpecificationDocumentDate { year: 2026, month: 9, day: 23 }, relay: "controlled fixture", method: "controlled fixture",
} }

fn resolves_to(anchors: List<MtCollins1PlacementAnchor>, banks: List<MtCollinsDimmFigureBank>, want: MtCollins1ViewHypothesis) -> Bool {
  match resolve_orientation(anchors: anchors, banks: banks, pairs: mt_collins_channel_connector_pairs) {
    OrientationResolved { hypothesis: h, order: _ } => h == want
    OrientationAmbiguous { surviving: _ } => false
    OrientationContradicted => false
    OrientationUnevaluable { hypothesis: _, unresolved_key: _ } => false
  }
}

// THE CHECK THAT WOULD HAVE CAUGHT 2026-09-23. Reading the operator's view as Figure 9's
// order predicts only SK0 MC0 S0 from the three-stick boot (drawing J17 and J25 on the absent
// socket), and the firmware trained SK0 MC0 S0 and SK0 MC4 S0.
test fn w_unmirrored_figure_order_contradicts_firmware() -> Bool {
  match anchor_verdict(anchor: mtcollins1_three_stick_anchor, hypothesis: FigureOrder, banks: dimm_figure_banks, pairs: mt_collins_channel_connector_pairs) {
    AnchorContradicted { predicted: p } => list_length(items: p) == 1 && p.first().socket == 0 && p.first().controller == 0
    AnchorConsistent => false
    AnchorUnevaluable { unresolved_key: _ } => false
  }
}

// The three-stick boot alone cannot say whether the view is a full mirror or a socket swap:
// both put the two trained sticks on SK0 MC0 and SK0 MC4. With only that anchor the damaged
// connector stays a candidate set {J5, J13}, every candidate is excluded from population
// choice, and the slot map refuses rather than naming J numbers.
test fn w_three_stick_anchor_alone_leaves_the_orientation_ambiguous() -> Bool {
  let o = resolve_orientation(anchors: [mtcollins1_three_stick_anchor], banks: dimm_figure_banks, pairs: mt_collins_channel_connector_pairs)
  let ambiguous = match o {
    OrientationAmbiguous { surviving: s } => s == [FullMirror, SocketHalvesSwapped]
    OrientationResolved { hypothesis: _, order: _ } => false
    OrientationContradicted => false
    OrientationUnevaluable { hypothesis: _, unresolved_key: _ } => false
  }
  let candidates = damaged_connector_candidates(report: mtcollins1_damaged_connector_report, orientation: o, banks: dimm_figure_banks)
  let both = match candidates {
    DamagedCandidates { connectors: cs, hypotheses: _ } => same_nats(a: cs, b: [5, 13])
    DamagedCandidatesRefused { orientation: _ } => false
  }
  let sixteen = match population_damage_standing(population: mt_collins_population_16_dimms, candidates: candidates) {
    PopulationUsesDamaged { population: _, connectors: cs } => same_nats(a: cs, b: [5, 13])
    PopulationAvoidsDamage { population: _ } => false
    PopulationDamageUndetermined { candidates: _ } => false
  }
  let refused = match render_slot_map(orientation: o, viewpoint: rear_fixture, tech_end: RearEnd, live_sockets: [0], history: [], population: mt_collins_population_8_dimms, installed_drawing_labels: [1, 17], report: mtcollins1_damaged_connector_report, banks: dimm_figure_banks, pairs: mt_collins_channel_connector_pairs) {
    SlotMapRefused { refusal: r } => match r {
      SlotMapOrientationUnresolved { orientation: _ } => true
      SlotMapViewpointNotReported { asked: _ } => false
      SlotMapPopulationUnresolved { identity: _ } => false
      SlotMapConnectorUnresolved { connector: _ } => false
    }
    SlotMapRendered { end: _, readback: _, lines: _, damage: _, agreement: _, text: _ } => false
  }
  ambiguous && both && sixteen && refused
}

// The production anchors (runs 35805796492 and 35808203121) resolve the full mirror, the
// damaged connector to J5, and the population consequence: the 16-DIMM row uses J5, the
// 8-DIMM Table 11 row avoids it. Without a reported viewpoint the slot map refuses.
test fn w_production_anchors_resolve_the_full_mirror_and_j5() -> Bool {
  let resolved = match mtcollins1_orientation() {
    OrientationResolved { hypothesis: h, order: _ } => h == FullMirror
    OrientationAmbiguous { surviving: _ } => false
    OrientationContradicted => false
    OrientationUnevaluable { hypothesis: _, unresolved_key: _ } => false
  }
  let candidates = mtcollins1_damaged_candidates()
  let j5 = match candidates {
    DamagedCandidates { connectors: cs, hypotheses: _ } => same_nats(a: cs, b: [5])
    DamagedCandidatesRefused { orientation: _ } => false
  }
  let sixteen = match population_damage_standing(population: mt_collins_population_16_dimms, candidates: candidates) {
    PopulationUsesDamaged { population: _, connectors: cs } => same_nats(a: cs, b: [5])
    PopulationAvoidsDamage { population: _ } => false
    PopulationDamageUndetermined { candidates: _ } => false
  }
  let eight = match population_damage_standing(population: mt_collins_population_8_dimms, candidates: candidates) {
    PopulationAvoidsDamage { population: p } => p.dimm_count == 8
    PopulationUsesDamaged { population: _, connectors: _ } => false
    PopulationDamageUndetermined { candidates: _ } => false
  }
  let gated = match render_slot_map(orientation: mtcollins1_orientation(), viewpoint: ViewpointNotYetReported { asked: "controlled fixture" }, tech_end: FrontEnd, live_sockets: [0], history: [], population: mt_collins_population_8_dimms, installed_drawing_labels: [1, 17], report: mtcollins1_damaged_connector_report, banks: dimm_figure_banks, pairs: mt_collins_channel_connector_pairs) {
    SlotMapRefused { refusal: r } => match r {
      SlotMapViewpointNotReported { asked: _ } => true
      SlotMapOrientationUnresolved { orientation: _ } => false
      SlotMapPopulationUnresolved { identity: _ } => false
      SlotMapConnectorUnresolved { connector: _ } => false
    }
    SlotMapRendered { end: _, readback: _, lines: _, damage: _, agreement: _, text: _ } => false
  }
  let undetermined = match population_damage_standing(population: mt_collins_population_8_dimms, candidates: DamagedCandidatesRefused { orientation: OrientationContradicted }) {
    PopulationDamageUndetermined { candidates: _ } => true
    PopulationAvoidsDamage { population: _ } => false
    PopulationUsesDamaged { population: _, connectors: _ } => false
  }
  resolved && j5 && sixteen && eight && gated && undetermined
}

// The discriminating boot resolves each way, and the damaged connector follows: MC4 surviving
// means the full mirror and J5; MC0 surviving means the socket swap and J13.
test fn w_discriminating_anchor_resolves_the_damaged_connector() -> Bool {
  let mirror = [mtcollins1_three_stick_anchor, two_stick_fixture(controller: 4)]
  let swapped = [mtcollins1_three_stick_anchor, two_stick_fixture(controller: 0)]
  let j5 = match damaged_connector_candidates(report: mtcollins1_damaged_connector_report, orientation: resolve_orientation(anchors: mirror, banks: dimm_figure_banks, pairs: mt_collins_channel_connector_pairs), banks: dimm_figure_banks) {
    DamagedCandidates { connectors: cs, hypotheses: _ } => same_nats(a: cs, b: [5])
    DamagedCandidatesRefused { orientation: _ } => false
  }
  let j13 = match damaged_connector_candidates(report: mtcollins1_damaged_connector_report, orientation: resolve_orientation(anchors: swapped, banks: dimm_figure_banks, pairs: mt_collins_channel_connector_pairs), banks: dimm_figure_banks) {
    DamagedCandidates { connectors: cs, hypotheses: _ } => same_nats(a: cs, b: [13])
    DamagedCandidatesRefused { orientation: _ } => false
  }
  resolves_to(anchors: mirror, banks: dimm_figure_banks, want: FullMirror)
    && resolves_to(anchors: swapped, banks: dimm_figure_banks, want: SocketHalvesSwapped)
    && j5 && j13
}

// MUTATIONS. (1) The anchor: had the firmware trained only SK0 MC0, the figure order would
// survive alone. (2) The vendor bank order: with CPU0's right bank read ascending (J9..J16
// instead of J16..J9), the socket swap now predicts J9's neighbours differently and the
// damaged candidate moves, so the candidate is a function of Figure 9, not a literal.
test fn w_mutations_move_the_verdict() -> Bool {
  let only_mc0 = MtCollins1PlacementAnchor {
    evidence: mtcollins1_three_stick_anchor.evidence,
    placed_at_drawing_labels: mtcollins1_three_stick_anchor.placed_at_drawing_labels,
    trained: [MtCollins1TrainedSlot { socket: 0, controller: 0, slot: 0 }],
    live_sockets: [0],
  }
  let ascending = map(dimm_figure_banks, b => if b.processor_socket == 0 && b.side == RightOfProcessor {
    MtCollinsDimmFigureBank { figure: b.figure, processor_socket: 0, processor_figure_label: b.processor_figure_label, side: b.side, connectors_left_to_right: [9, 10, 11, 12, 13, 14, 15, 16] }
  } else { b })
  let moved = match damaged_connector_candidates(report: mtcollins1_damaged_connector_report, orientation: resolve_orientation(anchors: [mtcollins1_three_stick_anchor], banks: ascending, pairs: mt_collins_channel_connector_pairs), banks: ascending) {
    DamagedCandidates { connectors: cs, hypotheses: _ } => !same_nats(a: cs, b: [5, 13])
    DamagedCandidatesRefused { orientation: _ } => true
  }
  resolves_to(anchors: [only_mc0], banks: dimm_figure_banks, want: FigureOrder) && moved
}

// THE RENDERED MAP FOR TODAY, entirely on production rows: both firmware anchors, the operator's
// reported front-end viewpoint, the damage report, and the 8-DIMM population. The two
// independent frames agree: the landmark report (front) and the firmware-proven full mirror.
fn rendered_today() -> MtCollins1SlotMap {
  mtcollins1_slot_map(population: mt_collins_population_8_dimms, tech_end: FrontEnd)
}

test fn w_slot_map_renders_left_to_right_for_a_tech() -> Bool {
  match rendered_today() {
    SlotMapRendered { end: _, readback: rb, lines: ls, damage: _, agreement: a, text: t } =>
      list_length(items: ls) == 32
      && fold(ls, init: true, f: (ok, l) => ok && ((l.connector == 5) == (l.state == SlotDamaged)) && ((l.connector == 25 || l.connector == 9) == (l.state == SlotPopulated)))
      && a == ViewpointAgreesWithFigureBet
      && string_contains(s: t, pattern: "Standing at the FRONT (NVMe backplane and six fans (front)), from LEFT edge to RIGHT edge:\n1. blue  J25  SK1 MC4  populated\n")
      && string_contains(s: t, pattern: "\n17. blue  J9  SK0 MC4  populated\n")
      && string_contains(s: t, pattern: "\n28. blue  J5  SK0 MC2  DAMAGED - do not use\n")
      && string_contains(s: t, pattern: "\n32. blue  J1  SK0 MC0  empty\n")
      && string_contains(s: t, pattern: "Population of 8 DIMMs avoids the damaged connector.")
      && list_length(items: rb) == 4 && string_contains(s: t, pattern: "Expected firmware roster for this population: SK0 MC0 S0, SK0 MC1 S0, SK0 MC4 S0, SK0 MC5 S0")
      && string_contains(s: t, pattern: "\nrun 35808203121: drawing 'J1','J17' = physical J25, J9 -> trained SK0 MC4 S0; DRAM 16 GiB; mcu_enable_mask = 00000010 [default: 000000ff]\n")
      && string_contains(s: t, pattern: "\nrun 35805796492: drawing 'J1','J17','J25' = physical J25, J9, J1 -> trained SK0 MC0 S0, SK0 MC4 S0; DRAM 32 GiB;")
      && string_contains(s: t, pattern: "Socket 1 trained no DIMM in 4 boots, including the J9+J25 placement (run 35805796492, run 35808203121).")
    SlotMapRefused { refusal: _ } => false
  }
}

// The same physical row seen from the other end: left and right reverse, and every
// connector keeps its J number, socket and controller.
test fn w_other_end_reverses_left_right_but_not_identity() -> Bool {
  let v = ViewpointReported { end: RearEnd, report: OperatorByEyeReport {
    observed_on: SpecificationDocumentDate { year: 2026, month: 9, day: 23 }, relay: "controlled fixture", method: "controlled fixture",
  } }
  let o = resolve_orientation(anchors: [mtcollins1_three_stick_anchor, two_stick_fixture(controller: 4)], banks: dimm_figure_banks, pairs: mt_collins_channel_connector_pairs)
  let rear = render_slot_map(orientation: o, viewpoint: v, tech_end: RearEnd, live_sockets: [0], history: [], population: mt_collins_population_8_dimms, installed_drawing_labels: [1, 17], report: mtcollins1_damaged_connector_report, banks: dimm_figure_banks, pairs: mt_collins_channel_connector_pairs)
  let front = render_slot_map(orientation: o, viewpoint: v, tech_end: FrontEnd, live_sockets: [0], history: [], population: mt_collins_population_8_dimms, installed_drawing_labels: [1, 17], report: mtcollins1_damaged_connector_report, banks: dimm_figure_banks, pairs: mt_collins_channel_connector_pairs)
  match rear {
    SlotMapRendered { end: _, readback: _, lines: r, damage: _, agreement: _, text: _ } => match front {
      SlotMapRendered { end: _, readback: _, lines: f, damage: _, agreement: _, text: _ } =>
        r.first().connector == f.last().connector && r.last().connector == f.first().connector
        && fold(r, init: true, f: (ok, a) => ok && fold(f, init: false, f: (hit, b) => hit || (a.connector == b.connector && a.socket == b.socket && a.controller == b.controller && a.state == b.state && a.from_left + b.from_left == 31)))
      SlotMapRefused { refusal: _ } => false
    }
    SlotMapRefused { refusal: _ } => false
  }
}

// A commanded J1 + J17 install reads back SK0 MC0 S0 and SK1 MC0 S0 on a two-socket board;
// today's SK0 MC0 + SK0 MC4 roster is not that readback, which is a placement mismatch.
test fn w_commanded_install_carries_its_expected_readback() -> Bool {
  let expected = expected_firmware_readback(connectors: [1, 17], live_sockets: [0, 1], banks: dimm_figure_banks, pairs: mt_collins_channel_connector_pairs)
  list_length(items: expected.unresolved) == 0
  && trained_sets_equal(a: expected.predicted, b: [MtCollins1TrainedSlot { socket: 0, controller: 0, slot: 0 }, MtCollins1TrainedSlot { socket: 1, controller: 0, slot: 0 }])
  && !trained_sets_equal(a: expected_firmware_readback(connectors: [1, 17, 25], live_sockets: [0], banks: dimm_figure_banks, pairs: mt_collins_channel_connector_pairs).predicted, b: mtcollins1_three_stick_anchor.trained)
}

// Socket 1's silence and the mask correlation are computed from the receipts, and each has a
// red: a boot that trained SK1, or a boot whose printed mask is not its controller bitmap.
test fn w_socket1_silence_and_mask_correlation_are_derived() -> Bool {
  let silent = match mtcollins1_socket1_standing() {
    Socket1TrainedNothing { runs: rs, since: _, symmetric_mc4_runs: sy } => list_length(items: rs) == 4 && sy == [35805796492, 35808203121]
    Socket1TrainedIn { runs: _ } => false
  }
  let correlated = match mtcollins1_mask_correlation() {
    MaskMatchedTrainedControllers { runs: rs, not_printed: np } => rs == [35801475989, 35805796492, 35808203121] && np == [35793279839]
    MaskDiverged { run_id: _, mask: _, bitmap: _ } => false
  }
  let b = mtcollins1_socket1_boot_two_sticks
  let sk1 = MtCollins1Socket1InvestigationBoot { run_id: b.run_id, capture_sha256: b.capture_sha256, intended: b.intended, roster_lines: b.roster_lines,
    trained: concat(b.trained, [MtCollins1TrainedSlot { socket: 1, controller: 4, slot: 0 }]), dram_total_gib: b.dram_total_gib,
    mcu_enable_mask: Present { value: 1 }, mcu_enable_mask_line: b.mcu_enable_mask_line, host: b.host, live_sockets: b.live_sockets, findings: b.findings }
  let red_socket = match socket1_standing(boots: [sk1], orientation: mtcollins1_orientation(), banks: dimm_figure_banks) {
    Socket1TrainedIn { runs: rs } => rs == [35808203121]
    Socket1TrainedNothing { runs: _, since: _, symmetric_mc4_runs: _ } => false
  }
  let red_mask = match mask_correlation(boots: [sk1]) {
    MaskDiverged { run_id: _, mask: m, bitmap: bm } => m == 1 && bm == 16
    MaskMatchedTrainedControllers { runs: _, not_printed: _ } => false
  }
  silent && correlated && red_socket && red_mask
}
