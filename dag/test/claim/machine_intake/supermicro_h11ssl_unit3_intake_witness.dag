import gunbc.fleet.fleet_host_identity { operator_host_e2d4b7 }
import product.host_identity { host_identity_eq }
import gunbc.fleet.fleet_enrollment { fleet_enrollments, HostEnrollmentIntent, HostKeyLoginAdmitted, HostKeyLoginRefused, HostReachPolicy }
import gunbc.runner.runner_connectivity_recovery { host_reach_admission_for_fleet_host }
import gunbc.runner.runner_broker_progress_watchdog { HostReachAdmitted, HostReachRefused }
import gunbc.fleet.fleet_fan_tach_expectation { fleet_fan_tach_expectations, HostFanTachExpectation }
import gunbc.fleet.fleet_intent { fleet_intent_known_hosts, supermicro_h11ssl_unit3_host, ComputeHost }
import gunbc.fleet.fleet_intent_network { ken_host_lan_endpoint }
import gunbc.integration_concern {
  ConcernDisposition, ConcernKind, ConcernSighting, Distinct, Integrated, IntegrationConcern, Open,
  RequirementEstablished,
  RequirementUnestablished, SuspectedCapabilityGap, SuspectedFork, Triaged, Withdrawn,
  h11ssl_unit3_edge_gate_refusal_revision,
  h11ssl_unit3_fan_duty_floor_has_no_home_in_the_fan_layer,
  h11ssl_unit3_host_key_login_admits_on_no_read_the_fleet_can_repeat,
  h11ssl_unit3_hand_install_route_seeded_no_fleet_authorized_keys_roster,
  h11ssl_unit3_hand_staged_edge_artifacts_have_no_place_in_the_edge_model,
  h11ssl_unit3_supply_row_held_out_of_the_known_hosts_population,
  h11ssl_unit3_intake_sighting_revision,
  h11ssl_unit3_install_ran_without_a_pre_install_disk_contents_capture,
  site_pxe_edge_pinned_chainloader_member_absent_from_srv4,
}
import extdeps.bmc.ipmi_boot_selection { ipmi_boot_selectable_devices, ipmi_boot_selection_label }
import gunbc.machine_intake.supermicro_h11ssl_unit_identity {
  supermicro_h11ssl_unit1_bmc_mac, supermicro_h11ssl_unit2_bmc_mac, supermicro_h11ssl_unit3_bmc_mac,
}
import gunbc.machine_intake.supermicro_h11ssl_unit_observation { H11sslReportedFigure }
import gunbc.machine_intake.supermicro_h11ssl_unit3_intake_observation {
  H11sslBoardPortLabel, h11ssl_board_port_label_text,
  RotationRouteNotYetRunnable, RotationRouteStandingCommitted,
  AddressConfirmed,
  AddressSeenOnlyInStaleNeighbourEntry,
  BasisObservedDhcp,
  BasisObservedStatic,
  BasisUnobserved,
  BootPathUnobserved,
  FactoryCredentialInForce,
  H11sslUnit3InstallNicAddressStanding,
  IpxeForcedBootObservedOnOtherPort,
  RotatedCredentialObserved,
  supermicro_h11ssl_unit3_bmc_address_basis,
  supermicro_h11ssl_unit3_bmc_credential_standing,
  supermicro_h11ssl_unit3_bmc_firmware_version,
  supermicro_h11ssl_unit3_bmc_lan_address,
