module test.claim.machine_intake.supermicro_h11ssl_unit3_intake_witness

// WITNESSES FOR THE UNIT-3 INTAKE RECEIPTS (the hand-installed H11SSL-i, BMC at 192.168.1.249).
//
// What these claims hold is the SHAPE of the receipts: that the rows keep the board's two network ports
// and two network addresses apart, that this unit is not a re-appearance of unit1 or unit2, that the
// boot-path standing cites the boot-selection authority it claims to cite and names the same port the
// NIC row names, and that no figure in the module is stated without a read owed against it. They do NOT
// hold that any figure is true about the board: none of these figures is a read of the board, and the
// module says so row by row.
import std.types { Bool, List, NonEmptyStr }
import std.algebra { FreeSemigroup, fold_list, length, string_contains }
import std.decl_ref { DeclarationRef }
import extdeps.network.mac { Eui48Address, render_mac_address }
import extdeps.network.ipv4 { ipv4_address, ipv4_address_eq }
