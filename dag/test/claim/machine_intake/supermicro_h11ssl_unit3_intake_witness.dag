// Claims below assert WHICH declaration a row points at, so renaming that row reds here instead of
// leaving a name inside a paragraph that nothing checks.
// The register keeps a sighting's account as prose, so the check available is whether some sighting in a
// concern records the account being looked for. Used only for facts whose carrier is prose.
fn any_sighting_account_mentions(sightings: FreeSemigroup<ConcernSighting>, wants: String) -> Bool {
  fold_list(
    xs: sightings.tail,
    empty: string_contains(s: text(sightings.head.account), pattern: wants),
    cons: (acc, sighting) => acc || string_contains(s: text(sighting.account), pattern: wants),
  )
}

fn decl_ref_names(ref: DeclarationRef, module_path: String, decl_name: String) -> Bool {
  (text(ref.module_path) == module_path) && (text(ref.decl_name) == decl_name)
}

fn text(value: String) -> String {
  value
}

fn mac_text(mac: Eui48Address) -> String {
  render_mac_address(addr: mac) as String
}

// UNIT 3 IS NOT UNIT1 AND NOT UNIT2. The unit number is a claim about the corpus of H11SSL boards this
// repository has receipts for, and it rests on the BMC MAC matching neither known unit. If a future row
// copies a MAC, this reds instead of quietly making two units one machine.
test fn witness_unit3_is_a_third_unit_not_a_reappearance() -> Bool {
  (mac_text(supermicro_h11ssl_unit3_bmc_mac) != mac_text(supermicro_h11ssl_unit1_bmc_mac)) &&
    (mac_text(supermicro_h11ssl_unit3_bmc_mac) != mac_text(supermicro_h11ssl_unit2_bmc_mac))
}

// THE BMC'S PORT AND THE INSTALL NIC ARE DIFFERENT PORTS. Same board, two interfaces; a row that
// conflated them would aim a PXE install at a controller, which is the confusion the boot-path
// standing exists to record.
test fn witness_install_nic_is_not_the_bmc_port() -> Bool {
  unit3_install_nic_is_not_the_bmc_port(
    nic: supermicro_h11ssl_unit3_install_nic_mac,
    bmc_mac: supermicro_h11ssl_unit3_bmc_mac,
  )
}

// THE BMC'S ADDRESS AND THE INSTALL NIC'S PAIRING ARE DIFFERENT ADDRESSES. The NIC pairing is a stale
// neighbour entry another host's endpoint row already claims, so no row may let the two addresses stand
// for one another.
test fn witness_bmc_address_is_not_the_install_nic_address() -> Bool {
  unit3_bmc_address_is_not_the_install_nic_address(
    bmc: supermicro_h11ssl_unit3_bmc_lan_address,
    nic: supermicro_h11ssl_unit3_install_nic_address_standing,
  )
}

// THE INSTALL NIC CLAIMS NO NETWORK ENDPOINT ROW OF ITS OWN. Its address stands only as a stale neighbour
// pairing, and the standing must name the row that holds that address -- otherwise a later reader (or a
// later row) treats the pairing as a lease. As of 2026-11-18 the named row is
// gunbc.fleet.fleet_intent_network::ken_host_lan_endpoint, a dated OBSERVATION of this unit; before that it
// was srv9's endpoint row, and the pairing was a collision between two hosts. Either way the standing is the
// unconfirmed arm and the obligation stays non-empty, which is what this claim actually holds.
test fn witness_install_nic_address_is_unconfirmed_and_names_the_row_that_holds_it() -> Bool {
  match supermicro_h11ssl_unit3_install_nic_address_standing {
    AddressSeenOnlyInStaleNeighbourEntry {
      address: seen,
      claimed_by_authority: claimed_by,
      read_obligation: owed,
    } =>
      ipv4_address_eq(a: seen, b: ipv4_address(octet1: 192, octet2: 168, octet3: 1, octet4: 236))
        && decl_ref_names(ref: claimed_by, module_path: "gunbc.fleet.fleet_intent_network", decl_name: "ken_host_lan_endpoint")
        && (text(owed) != "")
    AddressConfirmed { address: _, confirmed_at: _ } => false
  }
}

// THE BOOT-PATH STANDING CITES THE BOOT-SELECTION AUTHORITY, not a private device name: the device the
// forced boot asked for must be one the authority offers as selectable.
test fn witness_boot_path_cites_a_device_the_authority_selects() -> Bool {
  unit3_boot_path_cites_a_selectable_device(devices: ipmi_boot_selectable_devices)
}

// THE STANDING AND THE AUTHORITY AGREE ON WHAT WAS ASKED FOR. The row stores the authority's own
// rendering of the selection alongside the sightng; if the authority's rendering of a UEFI one-shot PXE
// override changes, the row cannot silently keep the old wording. And the port the standing says the
// install needed must be the SAME row as the module's NIC row, not a second copy of the address.
test fn witness_boot_path_renders_the_selection_as_the_authority_renders_it() -> Bool {
  match supermicro_h11ssl_unit3_ipmi_pxe_boot_path_standing {
    IpxeForcedBootObservedOnOtherPort {
      selection_the_flag_asked_for: selection,
      selection_as_the_authority_renders_it: rendered,
      board_port_the_pxe_attempt_landed_on: landed_label,
      board_port_the_install_needed: install_label,
      port_the_install_needed: install_port,
      route_that_reached_the_install_port: route_figure,
      confounder_row: _,
      read_obligation: _,
    } =>
      (text(rendered) == text(ipmi_boot_selection_label(selection: selection)))
        && (mac_text(install_port) == mac_text(supermicro_h11ssl_unit3_install_nic_mac))
        && (h11ssl_board_port_label_text(label: install_label) == text(supermicro_h11ssl_unit3_install_nic_port_label.value))
        && (text(route_figure.value) != "")
    BootPathUnobserved { read_obligation: _ } => false
  }
}

// THE FORCED BOOT ASKED FOR PXE, AND THE PORT IT LANDED ON IS NOT THE INSTALL PORT. That difference IS
// the quirk; if a future edit makes them equal, the standing no longer records anything and should be
// deleted rather than left standing.
test fn witness_the_port_that_pxe_landed_on_is_not_the_install_port() -> Bool {
  match supermicro_h11ssl_unit3_ipmi_pxe_boot_path_standing {
    IpxeForcedBootObservedOnOtherPort {
      selection_the_flag_asked_for: _,
      selection_as_the_authority_renders_it: _,
      board_port_the_pxe_attempt_landed_on: landed_label,
      board_port_the_install_needed: install_label,
      port_the_install_needed: _,
      route_that_reached_the_install_port: _,
      confounder_row: _,
      read_obligation: _,
    } =>
      (h11ssl_board_port_label_text(label: landed_label) != h11ssl_board_port_label_text(label: install_label))
        && (h11ssl_board_port_label_text(label: landed_label) != text(supermicro_h11ssl_unit3_install_nic_port_label.value))
    BootPathUnobserved { read_obligation: _ } => false
  }
}

// THE BOOT-PATH STANDING LEAVES ITS CONFOUNDER OPEN. The CMOS battery on this unit is reported as
// needing replacement, and that is an alternative explanation for the same sightng; a standing that
// dropped the confounder would be asserting a board property this repository has not read.
test fn witness_boot_path_keeps_the_cmos_confounder_open() -> Bool {
  match supermicro_h11ssl_unit3_ipmi_pxe_boot_path_standing {
    IpxeForcedBootObservedOnOtherPort {
      selection_the_flag_asked_for: _,
      selection_as_the_authority_renders_it: _,
      board_port_the_pxe_attempt_landed_on: _,
      board_port_the_install_needed: _,
      port_the_install_needed: _,
      route_that_reached_the_install_port: _,
      confounder_row: confounder,
      read_obligation: _,
    } => decl_ref_names(ref: confounder, module_path: "gunbc.machine_intake.supermicro_h11ssl_unit3_intake_observation", decl_name: "supermicro_h11ssl_unit3_cmos_battery_outstanding")
    BootPathUnobserved { read_obligation: _ } => false
  }
}

// THE BMC CREDENTIAL STANDS AS FACTORY-IN-FORCE, NOT ROTATED. The rotation route for this controller is
// not grounded, so a row claiming a rotated credential would be writing an effect that never ran.
test fn witness_bmc_credential_stands_as_factory_in_force() -> Bool {
  match supermicro_h11ssl_unit3_bmc_credential_standing {
    FactoryCredentialInForce {
      attested_by: attested_by,
      attested_at: _,
      rotation_route_standing: route,
      read_obligation: owed,
    } =>
      (text(attested_by) != "")
        && (match route {
            RotationRouteNotYetRunnable {
              secret_name_convention: _, secret_name_blocked_on: _, route_authority: _,
              secret_ref_precedent: _, gate_precedent: _, secret_placement: _, who_owes_which_step: _,
            } => true
            RotationRouteStandingCommitted { standing: _ } => false
          })
        && (text(owed) != "")
    RotatedCredentialObserved { observed_at: _ } => false
  }
}

// THE BMC ADDRESS BASIS IS UNOBSERVED. Nothing read here says static or DHCP, and the model refuses to
// guess -- the same refusal mtjade1_factory_network makes for the other units.
test fn witness_bmc_address_basis_is_unobserved() -> Bool {
  match supermicro_h11ssl_unit3_bmc_address_basis {
    BasisUnobserved { read_obligation: owed } => text(owed) != ""
    BasisObservedStatic => false
    BasisObservedDhcp => false
  }
}

// EVERY REPORTED FIGURE IN THE MODULE OWES ITS READ. The rows carry operator statements, and the only
// thing that keeps an operator statement from becoming a fabricated fact is the read named against it.
// If any of these figures is re-standed as cited-to-authority without a receipt behind it, this reds.
fn figure_owes_a_read(figure: H11sslReportedFigure) -> Bool {
  match figure.standing {
    TranscribedUncited { read_obligation: owed } => text(owed) != ""
    CitedToAuthority { authority: _ } => false
    ObservedByReceipt { observed: _ } => false
  }
}

test fn witness_every_reported_figure_owes_its_read() -> Bool {
  let figures: List<H11sslReportedFigure> = [
    supermicro_h11ssl_unit3_bios_version,
    supermicro_h11ssl_unit3_bmc_firmware_version,
    supermicro_h11ssl_unit3_install_nic_port_label,
    supermicro_h11ssl_unit3_seen_host_key_fingerprint,
    supermicro_h11ssl_unit3_gpu_report,
    supermicro_h11ssl_unit3_gpu_idle_temperature_and_power_cap_reported,
    supermicro_h11ssl_unit3_fan_zone_duty_needed_reported,
    supermicro_h11ssl_unit3_fan_zone_duty_after_power_off_reported,
  ]
  all(figures, figure_owes_a_read)
}

// THE CAP SETTER POINTS AT THE FIGURE IT EXPLAINS, BY CITATION. A power cap that arrives at boot is only
// evidence of hand state if the row that says so is bound to the figure it bears on: a rename of the figure
// must move this row, and the figure must keep owing its read.
test fn witness_power_cap_setter_names_the_figure_it_bears_on() -> Bool {
  decl_ref_names(
    ref: supermicro_h11ssl_unit3_power_cap_setter_prior_life.bears_on_row,
    module_path: "gunbc.machine_intake.supermicro_h11ssl_unit3_intake_observation",
    decl_name: "supermicro_h11ssl_unit3_gpu_idle_temperature_and_power_cap_reported"
  )
    && figure_owes_a_read(supermicro_h11ssl_unit3_gpu_idle_temperature_and_power_cap_reported)
    && (text(supermicro_h11ssl_unit3_power_cap_setter_prior_life.standing) != "")
}

// THE PHYSICAL MAINTENANCE ROW AND THE BOOT-PATH STANDING POINT AT EACH OTHER, BY CITATION. The CMOS
// battery is the operator's action, and the row is only worth keeping because of which standing the
// missing read depends on: the standing cites this row as its confounder, this row cites the standing as
// what it bears on, and neither edge is a word inside a sentence that a rename could quietly invalidate.
test fn witness_cmos_battery_row_names_what_it_bears_on() -> Bool {
  decl_ref_names(ref: supermicro_h11ssl_unit3_cmos_battery_outstanding.bears_on_row, module_path: "gunbc.machine_intake.supermicro_h11ssl_unit3_intake_observation", decl_name: "supermicro_h11ssl_unit3_ipmi_pxe_boot_path_standing")
    && (text(supermicro_h11ssl_unit3_cmos_battery_outstanding.account) != "")
}


// THE REGISTER CARRIES THE HAND WORK'S THREE GAPS, AND CARRIES THEM AS GAPS. The unit was brought up
// outside every modeled route, and the model's inability to say so is recorded in the integration
// register. These rows must stay capability gaps -- the model could not express the subject -- and must
// not quietly be re-standed as forks (one subject, two authorities) or as settled: the hand-staged
// artifacts are still on srv4, the host still admits no fleet roster, and the pre-install disk capture
// is still gone.
fn gap_stands_open(row: IntegrationConcern) -> Bool {
  match row.kind {
    SuspectedCapabilityGap { model: _, requirement: owed_requirement, standing: _ } =>
      (text(owed_requirement) != "") && matches_open(row.disposition)
    SuspectedFork { authorities: _ } => false
  }
}


fn edge_path_names_the_install_nic(path: String) -> Bool {
  string_contains(s: text(path), pattern: "ac-1f-6b-e6-75-eb")
}

fn matches_open(disposition: ConcernDisposition) -> Bool {
  match disposition {
    Open => true
    Triaged { home: _, preserve: _, next: _ } => false
    Distinct { reason: _, scope_examined: _ } => false
    Withdrawn { reason: _ } => false
    Integrated { evidence: _ } => false
  }
}

test fn witness_the_register_carries_the_hand_work_as_three_open_gaps() -> Bool {
  all(
    [
      h11ssl_unit3_hand_staged_edge_artifacts_have_no_place_in_the_edge_model,
      h11ssl_unit3_hand_install_route_seeded_no_fleet_authorized_keys_roster,
      h11ssl_unit3_install_ran_without_a_pre_install_disk_contents_capture,
    ],
    gap_stands_open,
  )
}

// THE DISK-CAPTURE GAP POINTS AT THE INSTALL SUBJECT'S OWN ADMISSION, so the gap is about the model that
// demands the capture and not about some unrelated standing.
// A LATER SIGHTING IS APPENDED TO ITS ROW, never minted as a second row -- the register says so at
// ConcernSighting itself. The edge gap grew a SECOND sighting, at a different main revision, for a second
// and worse half of the same obstacle: the first says the model cannot show a converge what to delete; the
// second says a session branch cannot even LOOK at the edge it is proposing to clean (the read-only
// observation mode was refused by the workflow's own workload-identity gate, run 43786925157). This claim
// refuses the shape where that new half shows up as a fourth open row, which would double-count one
// obstacle and hide that it is the same gap deepened.
test fn witness_the_edge_gap_grew_sightings_rather_than_rows() -> Bool {
  matches_open(h11ssl_unit3_hand_staged_edge_artifacts_have_no_place_in_the_edge_model.disposition)
    && (length(h11ssl_unit3_hand_staged_edge_artifacts_have_no_place_in_the_edge_model.sightings.tail) == 3)
}

test fn witness_the_disk_capture_gap_names_the_install_admission_it_cannot_satisfy() -> Bool {
  match h11ssl_unit3_install_ran_without_a_pre_install_disk_contents_capture.kind {
    SuspectedCapabilityGap { model: model, requirement: _, standing: _ } =>
      (text(model.module_path) == "gunbc.host.network_install") && (text(model.decl_name) == "TargetDiskContents")
    SuspectedFork { authorities: _ } => false
  }
}

// THE NAME SIGHTING AND THE ADDRESS STANDING AGREE, and both point at the address the model now holds as
// ken_host_lan_endpoint. Two rows about one address that disagree would be exactly the fork the register
// exists to catch, so the agreement is asserted rather than assumed.
test fn witness_the_lan_name_sighting_and_the_address_standing_name_one_address() -> Bool {
  match supermicro_h11ssl_unit3_install_nic_address_standing {
    AddressSeenOnlyInStaleNeighbourEntry { address: seen, claimed_by_authority: claimed_by, read_obligation: _ } =>
      ipv4_address_eq(a: supermicro_h11ssl_unit3_lan_name_sighting.answered_with, b: seen)
        && decl_ref_names(ref: claimed_by, module_path: "gunbc.fleet.fleet_intent_network", decl_name: "ken_host_lan_endpoint")
    AddressConfirmed { address: _, confirmed_at: _ } => false
  }
}

// THE GPU FIGURE OWES THE BUS-TO-SLOT PAIRING, not just a device count: the cooling lane cites slots,
// and a count without a slot pairing cannot be used by it.
test fn witness_the_gpu_figure_reads_ids_by_sysfs_and_leaves_the_pairing_unread() -> Bool {
  match supermicro_h11ssl_unit3_gpu_report.standing {
    TranscribedUncited { read_obligation: owed } =>
      string_contains(s: text(owed), pattern: "/sys/bus/pci/devices")
        && string_contains(s: text(owed), pattern: "UNREAD")
    CitedToAuthority { authority: _ } => false
    ObservedByReceipt { observed: _ } => false
  }
}

// THE ROTATION IS NOT RUNNABLE YET, AND WHAT IT IS WAITING ON IS CITED, NOT DESCRIBED. The standing must
// be the variant that says no route is committed, and it must point by citation at (a) the authority that
// owns the fleet name the credential id is keyed to, (b) the BmcSecure standing that does not exist yet,
// (c) srv15's secret-ref row and (d) the deployment-environment gate that carries srv15's arrival. Rename
// any of those four and this reds -- a paragraph naming them in prose would not. And the credential name
// is carried as a FORM with the name still blank: a concrete id here before the allocation authority
// fills the slot would be minting an identity through a side door.
test fn witness_bmc_rotation_is_planned_but_its_secret_id_is_not_minted() -> Bool {
  match supermicro_h11ssl_unit3_bmc_credential_standing {
    FactoryCredentialInForce {
      attested_by: _,
      attested_at: _,
      rotation_route_standing: route,
      read_obligation: _,
    } =>
      match route {
        RotationRouteNotYetRunnable {
          secret_name_convention: convention,
          secret_name_blocked_on: name_gate,
          route_authority: route_authority,
          secret_ref_precedent: secret_precedent,
          gate_precedent: gate_precedent,
          secret_placement: placement,
          who_owes_which_step: _,
        } =>
          decl_ref_names(ref: name_gate, module_path: "gunbc.hostname_allocation", decl_name: "hostname_allocation_admission")
            && decl_ref_names(ref: route_authority, module_path: "gunbc.machine_intake.bmc_rotation_route", decl_name: "BmcRotationRouteStanding")
            && decl_ref_names(ref: secret_precedent, module_path: "gunbc.secret_provision", decl_name: "srv15_bmc_gunbc_secret_ref")
            && decl_ref_names(ref: gate_precedent, module_path: "gunbc.auth.srv15_arrival_federation_provision", decl_name: "srv15_arrival_environment_creation_frontier")
            && string_contains(s: text(convention), pattern: "-admin")
            && string_contains(s: text(placement), pattern: "stdin")
        RotationRouteStandingCommitted { standing: _ } => false
      }
    RotatedCredentialObserved { observed_at: _ } => false
  }
}

// A CONCERN FILED OPEN ON A WIRE LINE, THEN CLOSED AS DISTINCT BY READING THE CODE THAT PRINTED IT. The
// row's first sighting said the absent pinned chainloader "blocks every apply on this edge"; site_pxe_edge_run_succeeded
// splits the modes and the apply arm never consults run.chains, so that half was mine to correct. Two claims,
// deliberately not one conjunction: the register must show the correction (Distinct, naming the fns that
// settled it) AND must not let the correction quietly delete the sighting it refutes.
test fn witness_the_chainloader_concern_was_closed_as_distinct_by_a_code_read() -> Bool {
  match site_pxe_edge_pinned_chainloader_member_absent_from_srv4.disposition {
    Distinct { reason: why, scope_examined: scope } =>
      string_contains(s: text(why), pattern: "an apply is not blocked")
        && string_contains(s: text(scope), pattern: "site_pxe_edge_run_succeeded")
    Open => false
    Triaged { home: _, preserve: _, next: _ } => false
    Withdrawn { reason: _ } => false
    Integrated { evidence: _ } => false
  }
}

test fn witness_the_chainloader_concern_keeps_the_sighting_it_refuted() -> Bool {
  length(site_pxe_edge_pinned_chainloader_member_absent_from_srv4.sightings.tail) == 1
}

// THE EDGE SIGHTING BINDS THE INSTALL PORT, NOT THE BMC PORT, AND KEEPS THE RUN'S OWN LIMITS IN THE ROW.
// srv4's request log counts a MAC at the edge; it does not identify the machine behind the MAC, and the run
// that read it said so itself. A row that quietly promoted "two requests from this MAC" into "this unit
// asked twice" would be the exact promotion epistemic humility refuses. The paths are kept because they are
// where the hand-staged seed actually is; the digest is kept because the run printed it with readings=0, and
// a refusal digest read as a measurement would be a second, quieter promotion.
test fn witness_the_edge_sighting_binds_the_install_port_and_keeps_the_caveats() -> Bool {
  unit3_install_nic_is_not_the_bmc_port(
    nic: supermicro_h11ssl_unit3_edge_sighting.mac,
    bmc_mac: supermicro_h11ssl_unit3_bmc_mac,
  )
    && (mac_text(supermicro_h11ssl_unit3_edge_sighting.mac) == mac_text(supermicro_h11ssl_unit3_install_nic_mac))
    && all(supermicro_h11ssl_unit3_edge_sighting.served_paths_named_for_this_mac, edge_path_names_the_install_nic)
    && string_contains(s: text(supermicro_h11ssl_unit3_edge_sighting.account), pattern: "host attribution")
    && string_contains(s: text(supermicro_h11ssl_unit3_edge_sighting.account), pattern: "readings=0")
    && string_contains(s: text(supermicro_h11ssl_unit3_edge_sighting.read_obligation), pattern: "ip -o link")
}

// THE BASEBOARD ROW IS HELD WITH ITS OBLIGATIONS NAMED, not left as prose. Two claims, kept apart on purpose:
// conjoining a string probe and a list-length probe in one arm makes THIS entry's typecheck run past fifteen
// minutes (measured twice), while either alone elaborates in well under a minute -- a fact about the checker that
// belongs in the record because it changes how claims here have to be written.
// What the board row owes is asserted BY NAME, not by a count: a count copied from the list is a change
// detector that a genuine addition trips, and it says nothing about WHICH read is missing. (Its own claim:
// a string probe conjoined with a length probe in one arm has been measured driving this entry's typecheck
// past fifteen minutes, while either alone elaborates in well under a minute.)
fn baseboard_obligation_named(needle: NonEmptyStr) -> Bool {
  supermicro_h11ssl_unit3_baseboard_row_standing.owed_reads.any(r => string_contains(s: r, pattern: needle))
}

test fn witness_the_baseboard_row_names_every_obligation_it_owes() -> Bool {
  baseboard_obligation_named(needle: "dmidecode -t baseboard")
    && baseboard_obligation_named(needle: "ipmitool lan print")
    && baseboard_obligation_named(needle: "sel elist")
    && baseboard_obligation_named(needle: "GetZoneDuty")
}

// The name obligation is CLOSED, and a closed obligation must not stay in a list of owed reads -- that list
// is what the next reader works from.
test fn witness_the_closed_name_obligation_has_left_the_owed_list() -> Bool {
  !supermicro_h11ssl_unit3_baseboard_row_standing.owed_reads.any(r =>
    string_contains(s: r, pattern: "hostname_allocation"))
}

test fn witness_the_baseboard_row_is_held_in_the_right_home() -> Bool {
  string_contains(s: text(supermicro_h11ssl_unit3_baseboard_row_standing.home), pattern: "gunbc.fleet.fleet_intent")
}

// THE HOLD ON THIS EDGE IS ATTRIBUTED, DATED IN THE RECORD, AND CLAIMS NO AUTHORITY IT DOES NOT HAVE. The hold
// is a lane instruction from the owner of the site PXE edge lane, not a ruling of the operator: gunbc.design_ruling
// carries dated rulings OF THE OPERATOR, and this hold has none -- a row there would lend it an authority nobody
// gave it. So the concern has to say who held it, in which lane, and which repository-side record the hold rests
// on (the srv15 install NIC row), and it must NOT cite a design_ruling row for it.
test fn witness_the_edge_hold_is_attributed_without_ruling_authority() -> Bool {
  match h11ssl_unit3_hand_staged_edge_artifacts_have_no_place_in_the_edge_model.kind {
    SuspectedCapabilityGap { model: _, requirement: owed, standing: _ } =>
      string_contains(s: text(owed), pattern: "lane instruction")
        && string_contains(s: text(owed), pattern: "smart-crane-730")
        && string_contains(s: text(owed), pattern: "srv15_host_nic_observation")
        && string_contains(s: text(owed), pattern: "bring-up plan")
        && !(string_contains(s: text(owed), pattern: "design_ruling::srv4_edge_apply_held"))
    SuspectedFork { authorities: _ } => false
  }
}

// A SIGHTING CARRIES THE HOLD AS A SIGHTING, AND SAYS WHY IT IS NOT A RULING. Four sightings stand on this
// concern (the original, the branch-ref refusal, the self-correction of the second, and the hold), and at least
// one of them states that the hold sits out of gunbc.design_ruling. That is the record's shape for an
// instruction relayed inside a lane: attributed to the lane, not promoted to a ruling.
test fn witness_a_sighting_records_the_hold_as_a_lane_instruction() -> Bool {
  let concern = h11ssl_unit3_hand_staged_edge_artifacts_have_no_place_in_the_edge_model
  length(concern.sightings.tail) == 3
    && any_sighting_account_mentions(sightings: concern.sightings, wants: "NOT entered in gunbc.design_ruling")
    && any_sighting_account_mentions(sightings: concern.sightings, wants: "smart-crane-730")
}

// ── THE OPERATOR'S REPORT DOES NOT OPEN THE GATE ───────────────────────────────────────────────
//
// gunbc.fleet.fleet_enrollment holds this unit's reach policy, and that arm is an EFFECT GATE: it is what
// lets the fleet dispatch at a host (gunbc.runner.runner_connectivity_recovery::
// host_reach_admission_for_fleet_host). The operator reported on 2026-11-16 that the three fleet access
// principals' keys sit on this unit's ubuntu account with passwordless sudo -- and the same report puts
// the unit's ssh answer at an address the model held as srv9's endpoint row (now retired as sold) and
// holds now only as the dated observation gunbc.fleet.fleet_intent_network::ken_host_lan_endpoint. Nothing
// read says WHICH machine answers there, so an effect admitted on the report could still be applied at a
// different machine than the row names.
// The claims here hold the line the rework drew: this host's row is refused, the transport gate is shut,
// and the report stands in the register as an open row that names the read which would ground it. None of
// this says the report is false; it says the model has not repeated it.

fn this_unit_is_enrolled() -> Bool {
  fleet_enrollments.any(e => host_identity_eq(a: e.host, b: operator_host_e2d4b7))
}

fn this_unit_reaches_as_refused() -> Bool {
  fleet_enrollments.any(e =>
    host_identity_eq(a: e.host, b: operator_host_e2d4b7)
      && match e.reach_policy {
           HostKeyLoginRefused { reason: _ } => true
           HostKeyLoginAdmitted => false
         })
}

fn reach_gate_is_open_for_this_unit() -> Bool {
  match host_reach_admission_for_fleet_host(host: operator_host_e2d4b7) {
    HostReachAdmitted => true
    HostReachRefused { host: _, reason: _ } => false
  }
}

fn the_no_read_row_stands_open() -> Bool {
  match h11ssl_unit3_host_key_login_admits_on_no_read_the_fleet_can_repeat.disposition {
    Open => true
    _ => false
  }
}

test fn keys_reported_in_place_leave_this_unit_refused_and_the_gate_shut() -> Bool {
  this_unit_is_enrolled()
    && this_unit_reaches_as_refused()
    && reach_gate_is_open_for_this_unit() == false
    && the_no_read_row_stands_open()
}

// The pair cannot drift in EITHER direction. If the gate is opened -- which only a read returning
// host-authored output may do -- the register row that says "no read the fleet can repeat" must no longer
// stand Open, or the model would be carrying a receipt and an admission that deny each other. And while the
// row is Open the gate must be shut. This is the tripwire that replaces the arm the rework removed: the
// status is checked on the two rows that hold it, not on a variant minted for one machine.
test fn an_opened_gate_dissolves_the_no_read_row_or_reds() -> Bool {
  match reach_gate_is_open_for_this_unit() {
    true => the_no_read_row_stands_open() == false && this_unit_reaches_as_refused() == false
    false => the_no_read_row_stands_open()
  }
}

// The unit is REPORTED to answer ssh at an address the model holds only as a dated observation. The link
// between those facts is a citation, not a paragraph: the standing must name, as a declaration, the row that
// holds the address. It used to name srv9's endpoint row -- a claim for ANOTHER host, which made this a
// collision; that row was retired when srv9 (spark-0c75) was sold, and the row named now is
// ken_host_lan_endpoint, which reserves nothing. The address VALUE is not re-stated here --
// witness_the_lan_name_sighting_and_the_address_standing_name_one_address already binds the two sightings of
// it -- so this claim checks only the link, and retires when the lease read lands.
test fn the_address_standing_names_the_row_that_holds_the_address() -> Bool {
  match supermicro_h11ssl_unit3_install_nic_address_standing {
    AddressSeenOnlyInStaleNeighbourEntry { address: _, claimed_by_authority: conflict, read_obligation: _ } =>
      (conflict.module_path as String) == "gunbc.fleet.fleet_intent_network"
        && (conflict.decl_name as String) == "ken_host_lan_endpoint"
    // Once the lease/ARP read lands the standing moves to its confirmed variant and there is no
    // competing authority left to name: the claim retires with the collision it was guarding.
    AddressConfirmed { address: _, confirmed_at: _ } => true
  }
}

// OBSERVATION, NOT INTENT -- the distinction the 2026-11-18 retirement rests on, stated instead of tolerated
// as a duplicate row on one address. gunbc.fleet.fleet_intent_network::ken_host_lan_endpoint holds
// 192.168.1.236 as a DATED LEASE OBSERVATION of this unit. Three things must stay true while that is so, and
// this claim binds them together so a future edit cannot promote the observation by accident: the address the
// observation carries is the SAME address this unit's standing calls unconfirmed; the standing keeps a
// non-empty read obligation (the lease table, the in-band address read, the console-confirmed host key); and
// the effect gate for this host is still the refusal, so the extra row buys no reach. Mark the standing
// confirmed without doing the reads, or open the gate on the strength of this row, and this reds.
test fn the_held_address_is_an_observation_while_the_standing_and_the_effect_gate_stay_shut() -> Bool {
  match supermicro_h11ssl_unit3_install_nic_address_standing {
    AddressSeenOnlyInStaleNeighbourEntry { address: seen, claimed_by_authority: held_by, read_obligation: owed } =>
      ipv4_address_eq(a: seen, b: ken_host_lan_endpoint.address)
        && decl_ref_names(ref: held_by, module_path: "gunbc.fleet.fleet_intent_network", decl_name: "ken_host_lan_endpoint")
        && (text(owed) != "")
        && this_unit_is_enrolled()
        && this_unit_reaches_as_refused()
    AddressConfirmed { address: _, confirmed_at: _ } => false
  }
}

// The keys being placed by hand is recorded ON the route concern, and that concern still stands open: a
// later sighting exists, it cites the register row that now carries the report, and the disposition is
// still Open. Promotion to Integrated while the install ROUTE is still unmodeled is what this claim is for.
test fn the_roster_concern_carries_the_hand_placement_and_stays_open() -> Bool {
  let concern = h11ssl_unit3_hand_install_route_seeded_no_fleet_authorized_keys_roster
  length(concern.sightings.tail) > 0
    && concern.affected.tail.any(d =>
      (d.module_path as String) == "gunbc.integration_concern"
        && (d.decl_name as String) == "h11ssl_unit3_host_key_login_admits_on_no_read_the_fleet_can_repeat")
    && match concern.disposition { Open => true _ => false }
}

// ── THE FAN FLOOR, AND THE FACT THAT THE FLEET HOLDS NO ROW FOR THIS HOST ───────────────────────
//
// The operator set zones A and B to 100% by hand and reports the board falls back to 20% on every
// power-off. The two duty rows must stay in the TRANSCRIBED standing -- a citation to an authority, or a
// receipt, is the only thing that may move them, and neither exists. And the requirement those figures
// imply is checked where the model keeps requirements: as an open register row against the fan layer,
// naming the tach-expectation grain it cannot be minted into. The fan layer itself is checked for the row
// the report implies is missing: this host has no HostFanTachExpectation, which is what
// gunbc.fleet.fleet_health::host_goal refuses the whole fleet over once a host is rostered.

fn fan_row_belongs_to_this_unit(row: HostFanTachExpectation) -> Bool {
  host_identity_eq(a: row.host, b: operator_host_e2d4b7)
}

// The grade, not the wording: transcribed today, and a receipt would legitimately promote it. What is NOT
// allowed for these two rows is a citation to an AUTHORITY -- no Supermicro manual or board document states
// what duty THIS unit's operator set by hand, so a `CitedToAuthority` standing on these figures would mean a
// number had been sourced to a document instead of read off the board.
test fn the_fan_duty_stays_reported_and_the_fleet_holds_no_fan_row_for_this_host() -> Bool {
  match supermicro_h11ssl_unit3_fan_zone_duty_needed_reported.standing {
    TranscribedUncited { read_obligation: _ } => true
    ObservedByReceipt { observed: _ } => true
    CitedToAuthority { authority: _ } => false
  }
    && match supermicro_h11ssl_unit3_fan_zone_duty_after_power_off_reported.standing {
         TranscribedUncited { read_obligation: _ } => true
         ObservedByReceipt { observed: _ } => true
         CitedToAuthority { authority: _ } => false
       }
    && !fleet_fan_tach_expectations.any(fan_row_belongs_to_this_unit)
}

// The requirement is registered AGAINST the fan layer: the open row's gap must name the expectation
// population as the model it is missing, and its standing must still be the un-established one while no
// board-profile figure or fan-mode row exists for this family. A row quietly promoted to
// RequirementEstablished, or filed against some other module, reds here.
test fn the_fan_requirement_is_registered_against_the_fan_layer() -> Bool {
  let gap = h11ssl_unit3_fan_duty_floor_has_no_home_in_the_fan_layer
  match gap.kind {
    SuspectedCapabilityGap { model: model, requirement: _, standing: standing } =>
      (model.module_path as String) == "gunbc.fleet.fleet_fan_tach_expectation"
        && (model.decl_name as String) == "fleet_fan_tach_expectations"
        && match standing {
             RequirementUnestablished { decided_by: _ } => true
             RequirementEstablished { by: _ } => false
           }
    SuspectedFork { authorities: _ } => false
  }
    && match gap.disposition { Open => true _ => false }
}

// ── A SUPPLY ROW IS NOT A SCHEDULE TARGET ───────────────────────────────────────────────────────
//
// This unit's ComputeHost row exists so the fleet can state where the machine is, and it is deliberately
// NOT in gunbc.fleet.fleet_intent::fleet_intent_known_hosts, the population that turns a supply row into
// fleet work: joining it before the board has a fan expectation would refuse the health check for every
// host at once. The gate is carried as a register row, and this claim binds the two: while the host is
// out of that population the gate must stand Open, and the row it gates must be this host's.
fn known_hosts_holds_this_host(host: ComputeHost) -> Bool {
  (host.identity as String) == (operator_host_e2d4b7 as String)
}

test fn the_supply_row_is_stated_while_the_join_to_fleet_work_is_held_open() -> Bool {
  (supermicro_h11ssl_unit3_host.identity as String) == (operator_host_e2d4b7 as String)
    && !fleet_intent_known_hosts.any(known_hosts_holds_this_host)
    && match h11ssl_unit3_supply_row_held_out_of_the_known_hosts_population.disposition {
         Open => true
         _ => false
       }
}
