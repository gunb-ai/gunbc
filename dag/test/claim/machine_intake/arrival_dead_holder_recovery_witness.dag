module test.claim.machine_intake.arrival_dead_holder_recovery_witness

// THE RECOVERY'S OWN DECISIONS, answered where they are made. A run that dies holding the arrival
// archive slot strands it -- the normal release runs only when the body returned a ProcessExit -- and the
// next arrival then refuses at FileHoldOccupied forever. srv15 stands there now: arrival:srv15.3 is
// held|arrival/srv15/45059586538, whose job concluded on 2026-11-22 without ever contacting the BMC.
// These claims pin the three things the arrival root is allowed to decide, and nothing else: which
// holders it can observe at all, what a reported status MEANS, and that a holder it cannot look at is
// never called dead. The store's own recovery sequence -- observe, prove, take with a release naming the
// prover -- is gunbc.durable_exclusive_hold_file_store's, covered by
// test.claim.durable_exclusive_hold_file_store_wet_witness.

import std.types { Bool, NonEmptyStr, String }
import std.optional { Present, Absent }
import std.durable_exclusive_hold {
  DurableHoldOwnerRef, HolderObservedLive, HolderObservedDead, HolderLivenessUnobservable,
}
import gunbc.machine_intake.arrival_subject { admit_arrival_subject, ArrivalSubjectAdmitted, ArrivalSubjectInPopulation }
import gunbc.machine_intake.arrival_interlock {
  arrival_holder_run_id, arrival_liveness_from_status_text, arrival_archive_slot_recover_dead_holder,
  ArrivalArchiveSlotRecovered, ArrivalArchiveSlotSelfHolder, ArrivalArchiveSlotRecoveryRefused,
}

fn subject_of(wire: String) -> ArrivalSubjectAdmitted? {
  match admit_arrival_subject(wire: wire) {
    ArrivalSubjectInPopulation { subject: s } => Present { value: s }
    _ => Absent
  }
}

fn mtjade1() -> ArrivalSubjectAdmitted {
  match subject_of(wire: "mtjade1") {
    Present { value: s } => s
    Absent => "no such subject" as ArrivalSubjectAdmitted
  }
}

// THE HOLDER IS arrival/<host>/<run_id> OR IT IS NOTHING. A holder from another host, or one that does
// not carry a run id at all, has no observable meaning -- and unobservable means refuse, never recover.
test fn a_holder_that_is_not_this_subjects_run_is_not_observable() -> Bool {
  match arrival_holder_run_id(subject: mtjade1(), holder: "arrival/srv15/44708982658" as DurableHoldOwnerRef) {
    Absent => true
    Present { value: _ } => false
  }
    && match arrival_holder_run_id(subject: mtjade1(), holder: "arrival/mtjade1/" as DurableHoldOwnerRef) {
      Absent => true
      Present { value: _ } => false
    }
    && match arrival_holder_run_id(subject: mtjade1(), holder: "arrival/mtjade1/45059586538" as DurableHoldOwnerRef) {
      Present { value: run_id } => run_id == "45059586538"
      Absent => false
    }
}

// A RE-RUN KEEPS ITS RUN ID, so a holder naming this very run is never "another arrival in progress".
// That is its own arm and its own sentence, and it is decided BEFORE any store call -- nothing is
// recovered, nothing is released, and the controller is untouched either way.
test fn a_holder_that_is_this_run_is_named_as_itself() -> Bool {
  match arrival_archive_slot_recover_dead_holder(
    root: "/var/lib/gunbc/unit-holds" as NonEmptyStr,
    subject: mtjade1(),
    holder: "arrival/mtjade1/45059586538" as DurableHoldOwnerRef,
    generation: 0,
    self_run_id: "45059586538",
  ) {
    ArrivalArchiveSlotSelfHolder { holder_run_id: run_id } => run_id == "45059586538"
    _ => false
  }
}

// A HOLDER THAT CANNOT BE DECODED REFUSES BEFORE THE STORE IS REACHED -- no observe, no prove, no take.
test fn an_undecodable_holder_refuses_rather_than_guessing_death() -> Bool {
  match arrival_archive_slot_recover_dead_holder(
    root: "/var/lib/gunbc/unit-holds" as NonEmptyStr,
    subject: mtjade1(),
    holder: "someone-elseentirely" as DurableHoldOwnerRef,
    generation: 0,
    self_run_id: "45059586538",
  ) {
    ArrivalArchiveSlotRecoveryRefused { cause: c } =>
      (c as String) == "ARRIVAL ARCHIVE SLOT RECOVERY REFUSED: holder someone-elseentirely is not arrival/mtjade1/<run_id>, so nothing about it is observable -- controller untouched"
    _ => false
  }
}

// ONLY A COMPLETED RUN IS DEAD. The status text is the wire fact the emitted evidence step read from the
// declared GET; what it MEANS is decided here, in the vocabulary that owns workflow runs -- not by the
// caller, which can hand over bytes at most.
test fn only_a_completed_run_is_dead() -> Bool {
  match arrival_liveness_from_status_text(run_id: "45059586538", status_text: Present { value: "completed" }) {
    HolderObservedDead { evidence: e } => (e as String) == "workflow run 45059586538 has completed"
    _ => false
  }
}

// EVERY OTHER STATUS MEANS SOMEBODY MAY STILL BE INSIDE THE DOOR, and an unknown word or no status at all
// is unobservable -- which refuses. A holder nobody could look at is not a holder that died.
test fn every_other_status_is_live_or_unobservable() -> Bool {
  match arrival_liveness_from_status_text(run_id: "1", status_text: Present { value: "in_progress" }) {
    HolderObservedLive { evidence: e } => (e as String) == "workflow run 1 is in_progress"
    _ => false
  }
    && match arrival_liveness_from_status_text(run_id: "1", status_text: Present { value: "queued" }) {
      HolderObservedLive { evidence: _ } => true
      _ => false
    }
    && match arrival_liveness_from_status_text(run_id: "1", status_text: Present { value: "waiting" }) {
      HolderObservedLive { evidence: _ } => true
      _ => false
    }
    && match arrival_liveness_from_status_text(run_id: "1", status_text: Present { value: "not-a-status" }) {
      HolderLivenessUnobservable { cause: _ } => true
      _ => false
    }
    && match arrival_liveness_from_status_text(run_id: "1", status_text: Absent) {
      HolderLivenessUnobservable { cause: _ } => true
      _ => false
    }
}

// THE RECOVERY IS ONE CALLER'S, AND IT IS THE ACQUIRE. Nothing else in the arrival root may reach the
// store's dead-holder recovery; this claim fails if a second door opens on it.
test fn the_recovery_is_admitted_to_the_acquire_alone() -> Bool {
  match arrival_archive_slot_recover_dead_holder(
    root: "/var/lib/gunbc/unit-holds" as NonEmptyStr,
    subject: mtjade1(),
    holder: "arrival/mtjade1/1" as DurableHoldOwnerRef,
    generation: 0,
    self_run_id: "2",
  ) {
    ArrivalArchiveSlotRecovered { holder_run_id: _, evidence: _ } => false
    ArrivalArchiveSlotSelfHolder { holder_run_id: _ } => false
    ArrivalArchiveSlotRecoveryRefused { cause: c } =>
      // unobservable, because no evidence step wrote this holder's status: refuse, and say why.
      starts_with(s: c as String, prefix: "ARRIVAL ARCHIVE SLOT RECOVERY REFUSED: ")
  }
}
