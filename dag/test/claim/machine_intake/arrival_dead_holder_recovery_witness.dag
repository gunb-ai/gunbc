// CLAIMS FOR THE ARRIVAL'S DEAD-HOLDER RECOVERY: what the arrival root decides for itself, before it
// refuses and before any controller contact. The recovery itself is not reachable from here -- the store's
// admit_callers names arrival_archive_slot_acquire as its sole permitted caller, and the resolver refused a
// first draft that imported it -- so these answer the decision the recovery stands on: what a reported
// status means. The three arms are exercised through the acquire in the wet claim.
module gunbc.test.claim.machine_intake.arrival_dead_holder_recovery_witness;

import std.types { Bool, String }
import std.optional { Present, Absent }
import std.durable_exclusive_hold { HolderObservedLive, HolderObservedDead, HolderLivenessUnobservable }
import gunbc.machine_intake.arrival_interlock { arrival_liveness_from_status_text }

// ONLY A COMPLETED RUN IS DEAD. Every other status the vocabulary knows keeps the slot, because any one of
// them means somebody may still be inside the door.
test fn only_a_completed_run_is_dead_and_every_other_known_status_is_live() -> Bool {
  match arrival_liveness_from_status_text(run_id: "45059586538", status_text: Present { value: "completed" }) {
    HolderObservedDead { evidence: _ } => true
    _ => false
  }
    && match arrival_liveness_from_status_text(run_id: "1", status_text: Present { value: "in_progress" }) {
         HolderObservedLive { evidence: _ } => true
         _ => false
       }
}

// AN ABSENT OR UNKNOWN STATUS IS UNOBSERVABLE, WHICH REFUSES AND NEVER RECOVERS: a truncated, absent, or
// never-written record cannot take a slot away from a run that may still be running.
test fn an_unreadable_status_is_unobservable_and_never_dead() -> Bool {
  match arrival_liveness_from_status_text(run_id: "45059586538", status_text: Absent) {
    HolderLivenessUnobservable { cause: _ } => true
    _ => false
  }
}

// THE EVIDENCE NAMES THE RUN IT PROVED, so an audit of a recovered slot points at the run that said the
// holder was over, and at no other run.
test fn the_evidence_names_the_run_it_proved() -> Bool {
  match arrival_liveness_from_status_text(run_id: "45059586538", status_text: Present { value: "completed" }) {
    HolderObservedDead { evidence: e } => (e as String) == "workflow run 45059586538 has completed"
    _ => false
  }
}
