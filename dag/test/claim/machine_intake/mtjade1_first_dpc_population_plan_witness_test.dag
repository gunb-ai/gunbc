module test.claim.mtjade1_first_dpc_population_plan_witness

import std.types { Bool, list_length }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import extdeps.cpu.ampere_altra_platform_hw_design.platform {
  DimmSlot0,
  OneDimmPerChannel,
  TwoDimmsPerChannel,
  dimms_per_channel_count,
}
import extdeps.ampere.mt_jade_getting_started_guide.memory_population { HashNumberPrefix }
import extdeps.memory.types { DualDiePackage, MonolithicDie, ThreeDimensionalStacked }
import extdeps.ocp.mt_jade.platform { MasterSocket, SlaveSocket }
import gunbc.machine_intake_mtjade1_first_dpc_population_plan {
  ConnectorSilkFromGsgTable11,
  MixedModuleClassRefused,
  UniformDualDieRdimm,
  UniformMonolithicRdimm,
  jade_channel_slot,
  CrossChannel1r2rLookupFailed,
  CrossChannel1r2rSettled,
  CrossChannel1r2rUndetermined,
  jade_first_dpc_admits_die_stacking,
  jade_first_dpc_cross_channel_1r_2r,
  jade_first_dpc_dimm_count,
  jade_first_dpc_empty_slot_labels,
  jade_first_dpc_preferred_class,
  jade_first_dpc_printed_slot_labels,
  jade_first_dpc_silk_standing,
  jade_first_dpc_slot,
  jade_first_dpc_slots,
  jade_first_dpc_topology,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn w_jade_first_dpc_is_sixteen_slot0_positions() -> Bool {
  jade_first_dpc_topology == OneDimmPerChannel
    && dimms_per_channel_count(topology: jade_first_dpc_topology) == 1
    && dimms_per_channel_count(topology: TwoDimmsPerChannel) == 2
    && jade_first_dpc_dimm_count() == 16
    && list_length(jade_first_dpc_slots) == 16
    && jade_first_dpc_slot() == DimmSlot0
}

test fn w_jade_first_dpc_names_master_and_slave_channel_ends() -> Bool {
  let a = jade_channel_slot(socket: MasterSocket, channel_ordinal: 0)
  let h = jade_channel_slot(socket: MasterSocket, channel_ordinal: 7)
  let i = jade_channel_slot(socket: SlaveSocket, channel_ordinal: 0)
  let p = jade_channel_slot(socket: SlaveSocket, channel_ordinal: 7)
  match a.socket {
    MasterSocket => a.channel_ordinal == 0 && a.slot == DimmSlot0
    SlaveSocket => false
  }
    && h.channel_ordinal == 7
    && match i.socket {
      SlaveSocket => i.channel_ordinal == 0
      MasterSocket => false
    }
    && match p.socket {
      SlaveSocket => p.channel_ordinal == 7 && p.slot == DimmSlot0
      MasterSocket => false
    }
}

test fn w_jade_first_dpc_does_not_engage_same_channel_mixing_and_refuses_1r_2r_tbd() -> Bool {
  dimms_per_channel_count(topology: jade_first_dpc_topology) == 1
    && dimms_per_channel_count(topology: TwoDimmsPerChannel) > 1
    && match jade_first_dpc_cross_channel_1r_2r() {
      CrossChannel1r2rUndetermined => true
      CrossChannel1r2rSettled { support: _ } => false
      CrossChannel1r2rLookupFailed { cause: _ } => false
    }
}

test fn w_jade_first_dpc_modules_are_uniform_and_ddp_is_a_class_not_a_bogus_2rx4() -> Bool {
  match jade_first_dpc_preferred_class {
    UniformMonolithicRdimm => true
    UniformDualDieRdimm => false
    MixedModuleClassRefused { cause: _ } => false
  }
    && match jade_first_dpc_admits_die_stacking(stacking: DualDiePackage, uniform: true) {
      UniformDualDieRdimm => true
      UniformMonolithicRdimm => false
      MixedModuleClassRefused { cause: _ } => false
    }
    && match jade_first_dpc_admits_die_stacking(stacking: MonolithicDie, uniform: false) {
      MixedModuleClassRefused { cause: _ } => true
      UniformMonolithicRdimm => false
      UniformDualDieRdimm => false
    }
    && match jade_first_dpc_admits_die_stacking(stacking: ThreeDimensionalStacked, uniform: true) {
      MixedModuleClassRefused { cause: _ } => true
      UniformMonolithicRdimm => false
      UniformDualDieRdimm => false
    }
}

test fn w_jade_first_dpc_silk_is_gsg_table11_hash_numbers() -> Bool {
  match jade_first_dpc_silk_standing {
    ConnectorSilkFromGsgTable11 { prefix: HashNumberPrefix, socket0: a, socket1: b, citation: _ } =>
      list_length(a) == 8
        && list_length(b) == 8
        && list_length(jade_first_dpc_printed_slot_labels) == jade_first_dpc_dimm_count()
        && list_length(jade_first_dpc_empty_slot_labels) == jade_first_dpc_dimm_count()
        && list_length(jade_first_dpc_slots) == jade_first_dpc_dimm_count()
  }
}
