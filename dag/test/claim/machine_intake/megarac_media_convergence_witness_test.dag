data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE TWO NAMES OF THE 2026-09-27 REFUSAL (boot run 36328950865), derived from the naming
// authority rather than typed: the image the controller still presented and the one it did not offer.
data stale_census: NonEmptyStr = ubuntu_seeded_install_media_image_name(image_stem: mtcollins1_census_image_stem, output_digest: "6455b3b9ae11214d00")
data desired_census: NonEmptyStr = ubuntu_seeded_install_media_image_name(image_stem: mtcollins1_census_image_stem, output_digest: "30ca88d43f891399ff")

fn presenting_in(name: String, status: String, session: String) -> String {
  concat("[{\"media_type\":1,\"image_name\":\"", concat(name, concat("\",\"redirection_status\":", concat(status, concat(",\"media_index\":0,\"session_index\":", concat(session, "}]"))))))
}

fn presenting(name: String, status: String) -> String {
  presenting_in(name: name, status: status, session: "0")
}

data host_off: MegaRacDetachAdmission = MegaRacDetachAdmitted
data host_on: MegaRacDetachAdmission = MegaRacDetachNotAdmitted { reason: "the host is powered on" }

fn step(configurations: String, detach: MegaRacDetachAdmission) -> ConvergenceStep {
  step_with_cd(configurations: configurations, detach: detach, cd_before: CdErrorRead { code: CdErrorNone })
}

fn step_with_cd(configurations: String, detach: MegaRacDetachAdmission, cd_before: CdErrorReading) -> ConvergenceStep {
  megarac_convergence_step(
    convergence: presented_convergence(
      presented: presented_media(body: configurations, image_name: desired_census, firmware: megarac_firmware_0_32),
      image_name: desired_census,
      replaceable_seeded_stem: mtcollins1_census_image_stem,
    ),
    detach: detach,
    configurations: configurations,
    cd_before: cd_before,
  )
}

// THE RECOGNIZER IS THE NAME AUTHORITY RUN BACKWARDS: both census names are of the stem, and a
// name that merely starts with the stem is not.
test fn census_names_are_recognised_by_the_naming_inverse() -> Bool {
  ubuntu_seeded_install_media_name_digest_prefix(image_stem: mtcollins1_census_image_stem, image_name: stale_census as String) == Present { value: "6455b3b9ae11214d" }
    && ubuntu_seeded_install_media_name_digest_prefix(image_stem: mtcollins1_census_image_stem, image_name: desired_census as String) == Present { value: "30ca88d43f891399" }
}

test fn a_stem_prefixed_name_that_no_build_produces_is_not_recognised() -> Bool {
  match ubuntu_seeded_install_media_name_digest_prefix(image_stem: mtcollins1_census_image_stem, image_name: concat(mtcollins1_census_image_stem as String, "-old-backup1.iso")) {
    Absent => true
    Present { value: _ } => false
  }
}

// CONTROL 1: the refused run's own state — stale census presented, host off — detaches that row.
test fn stale_census_presented_with_the_host_off_detaches_it() -> Bool {
  match step(configurations: presenting(name: stale_census as String, status: "1"), detach: host_off) {
    ConvergeStepDetachStale { row: r } => r.image_name == (stale_census as String)
    _ => false
  }
}

test fn the_stop_body_names_the_stale_image_and_its_device() -> Bool {
  stop_media_body(image_name: stale_census as String, media_index: "0") as String
    == concat("{\"image_name\":\"", concat(stale_census as String, "\",\"image_type\":1,\"image_index\":0,\"image_redirection\":1}"))
}

// CONTROL 2: a presented image outside the stem refuses, host off or not.
test fn a_foreign_image_presented_refuses() -> Bool {
  match step(configurations: presenting(name: "memtest86-5.31b.iso", status: "1"), detach: host_off) {
    ConvergeStepRefuse { outcome: MegaRacForeignImagePresented { image_name: n, configurations: c } } => n == "memtest86-5.31b.iso" && string_contains(s: c, pattern: "memtest86")
    _ => false
  }
}

// CONTROL 3: the host on refuses the detach.
test fn stale_census_presented_with_the_host_on_refuses() -> Bool {
  match step(configurations: presenting(name: stale_census as String, status: "100"), detach: host_on) {
    ConvergeStepRefuse { outcome: MegaRacStaleDetachNotAdmitted { stale_image: n, reason: _ } } => n == (stale_census as String)
    _ => false
  }
}

// CONTROL 5: the desired image presented makes no write and consults no admission; it goes to the
// same readiness fold every other route does (the filename match is not readiness).
test fn the_desired_image_presented_writes_nothing_and_awaits_readiness() -> Bool {
  match step(configurations: presenting(name: desired_census as String, status: "1"), detach: host_on) {
    ConvergeStepAwaitReadiness => true
    _ => false
  }
}

test fn a_stopped_row_is_nothing_presented() -> Bool {
  match step(configurations: presenting(name: stale_census as String, status: "0"), detach: host_on) {
    ConvergeStepAttachFromListing => true
    _ => false
  }
}

test fn an_uncatalogued_status_on_a_named_row_refuses_keeping_the_wire() -> Bool {
  match step(configurations: presenting(name: desired_census as String, status: "16"), detach: host_off) {
    ConvergeStepRefuse { outcome: MegaRacRedirectionUncatalogued { image_name: _, wire: w, configurations: _ } } => w == 16
    _ => false
  }
}

// ─── READINESS ───────────────────────────────────────────────────────────────────────────────
fn look(at: EpochMs, status: String, session: String) -> ReadinessLook {
  ReadinessLook { observed_at: at, reading: attach_readiness(answered: true, body: presenting_in(name: desired_census as String, status: status, session: session), image_name: desired_census, firmware: megarac_firmware_0_32) }
}

// Boot run 36330382023's own after-state: status 16, session 255. Refuses with the wire.
test fn status_16_refuses_keeping_the_wire() -> Bool {
  match readiness_verdict(opened_at: 1000, budget: 30000, previous: none, look: look(at: 2000, status: "16", session: "255"), phase: ReadinessAfterStart, looks: 1) {
    ReadinessRefusedVerdict { look: l, looks: _ } =>
      match l.reading { ReadinessUncatalogued { image_name: _, wire: w, configurations: c } => w == 16 && string_contains(s: c, pattern: "255") _ => false }
    _ => false
  }
}

test fn started_with_a_bound_session_is_ready() -> Bool {
  match readiness_verdict(opened_at: 1000, budget: 30000, previous: none, look: look(at: 13000, status: "1", session: "0"), phase: ReadinessAfterStart, looks: 3) {
    ReadinessReady { look: _, looks: n } => n == 3
    _ => false
  }
}

// CONNECTING IS PENDING, not ready — a policy, not a claim about the firmware state.
test fn connecting_is_pending_inside_the_window() -> Bool {
  match readiness_verdict(opened_at: 1000, budget: 30000, previous: none, look: look(at: 7000, status: "100", session: "0"), phase: ReadinessAfterStart, looks: 1) {
    ReadinessLookAgain => true
    _ => false
  }
}

// CONNECTING-ONLY TIMEOUT: still connecting at the deadline closes the window and keeps the last look.
test fn connecting_only_times_out_keeping_the_last_look() -> Bool {
  match readiness_verdict(opened_at: 1000, budget: 30000, previous: none, look: look(at: 31000, status: "100", session: "0"), phase: ReadinessAfterStart, looks: 15) {
    ReadinessWindowClosed { last: l, deadline: d, looks: n } =>
      d == 31000 && n == 15 && (match l.reading { ReadinessConnecting { row: r } => r.redirection_wire == 100 _ => false })
    _ => false
  }
}

// UNKNOWN AFTER CONNECTING: a pending look, then an uncatalogued one, refuses at the second.
test fn unknown_after_connecting_refuses() -> Bool {
  (match readiness_verdict(opened_at: 1000, budget: 30000, previous: none, look: look(at: 5000, status: "100", session: "0"), phase: ReadinessAfterStart, looks: 1) { ReadinessLookAgain => true _ => false })
    && (match readiness_verdict(opened_at: 1000, budget: 30000, previous: none, look: look(at: 7000, status: "16", session: "255"), phase: ReadinessAfterStart, looks: 2) {
      ReadinessRefusedVerdict { look: l, looks: n } => n == 2 && (match l.reading { ReadinessUncatalogued { image_name: _, wire: w, configurations: _ } => w == 16 _ => false })
      _ => false
    })
}

test fn started_without_a_bound_session_is_pending() -> Bool {
  match look(at: 2000, status: "1", session: "255").reading {
    ReadinessStartedUnbound { row: r } => optional_text_is(v: r.session_index, want: "255")
    _ => false
  }
}

fn optional_text_is(v: String?, want: String) -> Bool {
  match v { Present { value: x } => x == want  Absent => false }
}

data duplicate_rows: String = concat("[", concat(
  "{\"media_type\":1,\"image_name\":\"", concat(desired_census as String, concat("\",\"redirection_status\":1,\"media_index\":0,\"session_index\":0},",
  concat("{\"media_type\":1,\"image_name\":\"", concat(desired_census as String, "\",\"redirection_status\":1,\"media_index\":1,\"session_index\":1}]"))))))

data wrong_rows: String = concat("[", concat(
  "{\"media_type\":1,\"image_name\":\"", concat(desired_census as String, concat("\",\"redirection_status\":1,\"media_index\":0,\"session_index\":0},",
  concat("{\"media_type\":1,\"image_name\":\"", concat(stale_census as String, "\",\"redirection_status\":1,\"media_index\":1,\"session_index\":1}]"))))))

test fn duplicate_rows_for_the_image_refuse_keeping_the_document() -> Bool {
  match attach_readiness(answered: true, body: duplicate_rows, image_name: desired_census, firmware: megarac_firmware_0_32) {
    ReadinessDuplicate { configurations: c } => c == duplicate_rows
    _ => false
  }
}

test fn a_second_image_presented_beside_it_refuses_naming_it() -> Bool {
  match attach_readiness(answered: true, body: wrong_rows, image_name: desired_census, firmware: megarac_firmware_0_32) {
    ReadinessWrongPresentation { image_name: n, configurations: c } => n == (stale_census as String) && c == wrong_rows
    _ => false
  }
}

// NOT PRESENTED is pending only after this attempt's own start; on the already-presented route it
// is a withdrawal and refuses.
test fn not_presented_is_pending_after_start_and_refused_when_it_was_presented() -> Bool {
  let gone = ReadinessLook { observed_at: 2000, reading: attach_readiness(answered: true, body: "[]", image_name: desired_census, firmware: megarac_firmware_0_32) }
  (match readiness_verdict(opened_at: 1000, budget: 30000, previous: none, look: gone, phase: ReadinessAfterStart, looks: 1) { ReadinessLookAgain => true _ => false })
    && (match readiness_verdict(opened_at: 1000, budget: 30000, previous: none, look: gone, phase: ReadinessOfPresented, looks: 1) { ReadinessRefusedVerdict { look: _, looks: _ } => true _ => false })
}

// ALREADY STARTED: no detach, no start, and the evidence carries the Started row's own indices.
test fn already_started_is_ready_with_its_evidence_and_no_list_index() -> Bool {
  match readiness_wait_outcome(
    wait: ReadinessWaitReady { look: look(at: 1500, status: "1", session: "0"), looks: 1 },
    image_name: desired_census,
    firmware: megarac_firmware_0_32,
    route: RouteAlreadyPresented,
    cd_before: cd_clean,
    general_at_end: raw_clean,
  ) {
    MegaRacPresentationReady { route: RouteAlreadyPresented, evidence: e } =>
      e.redirection_wire == 1 && optional_text_is(v: e.session_index, want: "0") && optional_text_is(v: e.media_index, want: "0") && e.established_at == 1500 && e.looks == 1
    _ => false
  }
}

// ─── DETACH: the command's answer and the read-back are two facts ───────────────────────────────
fn detach(success: Bool, body: String, readback_read: Bool, readback: String) -> MegaRacDetachEvidence {
  MegaRacDetachEvidence { stale_image: stale_census as String, media_index: "0", command: megarac_write_answer(success: success, body: body, stderr: ""), readback_read: readback_read, readback: readback, cd_after_stop: cd_clean, general_after_stop: raw_clean }
}

data stop_1411: String = "{\"error\":\"Error stopping the remote media redirection\",\"code\":1411}"
data cleared_rows: String = "[{\"media_type\":1,\"image_name\":\"\",\"redirection_status\":0,\"media_index\":0,\"session_index\":255}]"

test fn an_error_but_detached_is_established_and_keeps_the_error() -> Bool {
  let d = detach(success: false, body: stop_1411, readback_read: true, readback: cleared_rows)
  (match detach_verdict(evidence: d, image_name: desired_census, firmware: megarac_firmware_0_32, replaceable_seeded_stem: mtcollins1_census_image_stem) { DetachEstablished => true _ => false })
    && string_contains(s: detach_evidence_text(detach: d), pattern: "1411")
}

test fn a_success_but_still_attached_is_not_established() -> Bool {
  match detach_verdict(evidence: detach(success: true, body: "{}", readback_read: true, readback: presenting(name: stale_census as String, status: "1")), image_name: desired_census, firmware: megarac_firmware_0_32, replaceable_seeded_stem: mtcollins1_census_image_stem) {
    DetachNotEstablished { reason: _ } => true
    _ => false
  }
}

test fn a_success_with_an_unread_readback_is_not_established() -> Bool {
  match detach_verdict(evidence: detach(success: true, body: "{}", readback_read: false, readback: "curl: (28)"), image_name: desired_census, firmware: megarac_firmware_0_32, replaceable_seeded_stem: mtcollins1_census_image_stem) {
    DetachNotEstablished { reason: _ } => true
    _ => false
  }
}

// ─── THE GATE THE HANDOFF IS BEHIND ─────────────────────────────────────────────────────────────
fn attempted(result: MegaRacAttachResult) -> MtCollins1MediaAttachRecord {
  MediaAttachAttempted { attempt: "36330382023", medium_image_name: desired_census, medium_image_sha256: "30ca88d43f891399", power: ChassisPowerRead { power_on: false }, result: result }
}

test fn a_timed_out_presentation_withholds_the_handoff_with_its_last_look() -> Bool {
  match mtcollins1_media_gate(record: attempted(result: MegaRacAttachResult {
    outcome: MegaRacReadinessTimedOut { image_name: desired_census, route: RouteAttached { image_list_index: "5", start: WriteAccepted { body: "{}" } }, last: look(at: 31000, status: "100", session: "0"), deadline: 31000, looks: 15, cd_before_any_write: cd_clean, cd_at_refusal: cd_clean },
    session_release: SessionReleased,
    baseline: none,
  })) {
    MediaGateWithheld { reason: r } => string_contains(s: r as String, pattern: "No boot-device or power handoff") && string_contains(s: r as String, pattern: "connecting (status 100)")
    MediaGateReady { evidence: _ } => false
  }
}

test fn a_refused_presentation_withholds_the_handoff_with_the_wire() -> Bool {
  match mtcollins1_media_gate(record: attempted(result: MegaRacAttachResult {
    outcome: MegaRacReadinessRefused { image_name: desired_census, route: RouteAttached { image_list_index: "5", start: WriteAccepted { body: "{}" } }, look: look(at: 2000, status: "16", session: "255"), looks: 1, cd_before_any_write: cd_clean, cd_at_refusal: cd_16 },
    session_release: SessionReleased,
    baseline: none,
  })) {
    MediaGateWithheld { reason: r } => string_contains(s: r as String, pattern: "redirection_status 16")
    MediaGateReady { evidence: _ } => false
  }
}

fn ready_outcome() -> MegaRacAttachResult {
  MegaRacAttachResult {
    outcome: readiness_wait_outcome(wait: ReadinessWaitReady { look: look(at: 13000, status: "1", session: "0"), looks: 4 }, image_name: desired_census, firmware: megarac_firmware_0_32, route: RouteAttached { image_list_index: "5", start: WriteAccepted { body: "{}" } }, cd_before: cd_clean, general_at_end: raw_clean),
    session_release: SessionReleased,
    baseline: none,
  }
}

test fn a_ready_presentation_opens_the_gate_with_its_evidence() -> Bool {
  match mtcollins1_media_gate(record: attempted(result: ready_outcome())) {
    MediaGateReady { evidence: e } => e.looks == 4 && e.established_at == 13000
    MediaGateWithheld { reason: _ } => false
  }
}

test fn a_ready_presentation_with_a_leaked_session_withholds() -> Bool {
  match mtcollins1_media_gate(record: attempted(result: MegaRacAttachResult { outcome: ready_outcome().outcome, session_release: SessionReleaseRefused { detail: "probe still succeeded" }, baseline: none })) {
    MediaGateWithheld { reason: _ } => true
    MediaGateReady { evidence: _ } => false
  }
}

// CONTROL 4: still absent after the refresh. The listing lacked the name at a look that reached
// the declared deadline, so the establishment fold closes TimedOut and the answer is
// NotEnumeratedAfterRefresh — not another look.
data refresh_window: RemoteMediaMountWindow = RemoteMediaMountWindow { requested_at: 1000, budget: 90000 }
data lacks_bytes: ContentHash = content_hash_of_value(value: "images-listing-without-desired")

fn absent_at(at: EpochMs) -> RemoteMediaListingObservation {
  RemoteMediaListingObservation { observed_at: at, listing: MediaImageAbsentFromListing, raw_response: lacks_bytes }
}

test fn absent_at_the_deadline_is_not_enumerated_after_refresh() -> Bool {
  let standing = mount_standing_as_of(
    window: refresh_window,
    observations: [absent_at(at: 50000), absent_at(at: 91000)],
    boundary: MountEvaluationBoundary { observed_through: 91000, clock_evidence: lacks_bytes },
  )
  match enumeration_decision(standing: standing, reading: ImagesListingLacks, remaining: 5) {
    EnumerationDecided { result: NotEnumeratedAfterRefresh { standing: _ } } => true
    _ => false
  }
}

test fn absent_inside_the_window_looks_again() -> Bool {
  let standing = mount_standing_as_of(
    window: refresh_window,
    observations: [absent_at(at: 50000)],
    boundary: MountEvaluationBoundary { observed_through: 50000, clock_evidence: lacks_bytes },
  )
  match enumeration_decision(standing: standing, reading: ImagesListingLacks, remaining: 5) {
    EnumerationLookAgain => true
    _ => false
  }
}

// ─── THE SHARE BINDING AND THE CD ERROR CODE ────────────────────────────────────────────────────
//
// RECEIPT, VERBATIM: read-only GET /api/settings/media/general on mtcollins1 (192.168.1.228,
// firmware 0.32) at 2026-09-27T18:37:18Z, supplied by eager-owl-205, after boot run 36330382023.
data mtcollins1_media_general_2026_09_27: String = "{ \"id\": 1, \"local_media_support\": 0, \"remote_media_support\": 1, \"same_settings\": 0, \"cd_remote_server_address\": \"192.168.1.188\", \"cd_remote_source_path\": \"\\/srv\\/bmc\", \"cd_remote_share_type\": \"nfs\", \"cd_remote_domain_name\": \"\", \"cd_remote_user_name\": \"\", \"mount_cd\": 1, \"cd_image_name\": \"\", \"cd_error_code\": 16, \"mount_hd\": 0, \"hd_remote_server_address\": \"\", \"hd_remote_source_path\": \"\", \"hd_remote_share_type\": \"\", \"hd_remote_domain_name\": \"\", \"hd_remote_user_name\": \"\", \"hd_image_name\": \"\", \"hd_error_code\": 0, \"rmedia_retry_count\": 3, \"rmedia_retry_interval\": 15 }"

// RECEIPT, AS REPORTED, NOT VERBATIM: the ~15:40Z read the same day was reported identical except
// cd_error_code 0. The body below is that report applied to the 18:37Z bytes; the 15:40Z bytes
// themselves were not supplied.
data mtcollins1_media_general_2026_09_27_morning_as_reported: String = "{ \"id\": 1, \"local_media_support\": 0, \"remote_media_support\": 1, \"same_settings\": 0, \"cd_remote_server_address\": \"192.168.1.188\", \"cd_remote_source_path\": \"\\/srv\\/bmc\", \"cd_remote_share_type\": \"nfs\", \"cd_remote_domain_name\": \"\", \"cd_remote_user_name\": \"\", \"mount_cd\": 1, \"cd_image_name\": \"\", \"cd_error_code\": 0, \"mount_hd\": 0, \"hd_remote_server_address\": \"\", \"hd_remote_source_path\": \"\", \"hd_remote_share_type\": \"\", \"hd_remote_domain_name\": \"\", \"hd_remote_user_name\": \"\", \"hd_image_name\": \"\", \"hd_error_code\": 0, \"rmedia_retry_count\": 3, \"rmedia_retry_interval\": 15 }"

fn general_with(server: String, path: String, kind: String, mount: String, error: String) -> String {
  join(["{ \"cd_remote_server_address\": \"", server, "\", \"cd_remote_source_path\": \"", path, "\", \"cd_remote_share_type\": \"", kind, "\", \"mount_cd\": ", mount, ", \"cd_error_code\": ", error, " }"], "")
}

// The binding the production caller passes is derived from srv2's address and the export row, and
// the controller's own answer binds to it: the morning read (error 0) is bound.
test fn the_derived_share_binds_the_controllers_own_answer() -> Bool {
  (mtcollins1_media_share.server_address as String) == "192.168.1.188"
    && (mtcollins1_media_share.source_path as String) == "/srv/bmc"
    && (match share_binding_standing(body: mtcollins1_media_general_2026_09_27_morning_as_reported, expected: mtcollins1_media_share) { ShareBound => true _ => false })
}

// The code is judged at readiness, not in the share binding: the evening read, cd_error_code 16, still binds.
test fn a_nonzero_cd_error_is_not_a_share_mismatch() -> Bool {
  match share_binding_standing(body: mtcollins1_media_general_2026_09_27, expected: mtcollins1_media_share) {
    ShareBound => true
    _ => false
  }
}

test fn another_server_is_a_mismatch_naming_it() -> Bool {
  match share_binding_standing(body: general_with(server: "192.168.1.99", path: "/srv/bmc", kind: "nfs", mount: "1", error: "0"), expected: mtcollins1_media_share) {
    ShareMismatch { observed: o } => o.server_address == "192.168.1.99"
    _ => false
  }
}

test fn another_path_is_a_mismatch_naming_it() -> Bool {
  match share_binding_standing(body: general_with(server: "192.168.1.188", path: "/srv/other", kind: "nfs", mount: "1", error: "0"), expected: mtcollins1_media_share) {
    ShareMismatch { observed: o } => o.source_path == "/srv/other"
    _ => false
  }
}

test fn a_cifs_share_or_an_unmounted_share_is_a_mismatch() -> Bool {
  (match share_binding_standing(body: general_with(server: "192.168.1.188", path: "/srv/bmc", kind: "cifs", mount: "1", error: "0"), expected: mtcollins1_media_share) { ShareMismatch { observed: o } => o.share_type == "cifs" _ => false })
    && (match share_binding_standing(body: general_with(server: "192.168.1.188", path: "/srv/bmc", kind: "nfs", mount: "0", error: "0"), expected: mtcollins1_media_share) { ShareMismatch { observed: o } => o.mount_cd == "0" _ => false })
}

test fn a_general_document_missing_a_member_is_unreadable_not_bound() -> Bool {
  match share_binding_standing(body: "{ \"cd_remote_server_address\": \"192.168.1.188\", \"mount_cd\": 1 }", expected: mtcollins1_media_share) {
    ShareUnreadable { detail: _ } => true
    _ => false
  }
}

// THE CODE IS A LATCHED LAST ERROR, JUDGED WITH THE PRESENTATION (operator direction on #12425).
// 18:37Z: code 16 while the re-attached image read Started, session 0 -- a healthy presentation. So a
// nonzero code beside Started is historical: recorded with BmcUnknownSemantics, not blocking, and the
// gate opens; the same code beside an unhealthy presentation rides that presentation's refusal.
data cd_clean: CdErrorReading = CdErrorRead { code: CdErrorNone }
data cd_16: CdErrorReading = cd_error_reading(body: mtcollins1_media_general_2026_09_27)
data raw_16: MegaRacRawRead = MegaRacRawRead { answered: true, body: mtcollins1_media_general_2026_09_27, observed_at: Present { value: 13100 } }
data raw_clean: MegaRacRawRead = MegaRacRawRead { answered: true, body: mtcollins1_media_general_2026_09_27_morning_as_reported, observed_at: Present { value: 13100 } }

// OPTION A (operator decision on #12425): a nonzero or unread code withholds as a knowledge refusal.
test fn a_nonzero_code_beside_a_started_presentation_withholds_as_unestablished() -> Bool {
  match readiness_wait_outcome(wait: ReadinessWaitReady { look: look(at: 13000, status: "1", session: "0"), looks: 4 }, image_name: desired_census, firmware: megarac_firmware_0_32, route: RouteAttached { image_list_index: "5", start: WriteAccepted { body: "{}" } }, cd_before: cd_16, general_at_end: raw_16) {
    MegaRacMediaStateUnestablished { image_name: _, route: _, look: _, looks: n, cd_before_any_write: _, cd_at_ready: CdErrorRead { code: CdErrorUncatalogued { wire: w } }, general_at_ready: _ } =>
      n == 4 && w == 16
        && (match mtcollins1_media_gate(record: attempted(result: MegaRacAttachResult { outcome: readiness_wait_outcome(wait: ReadinessWaitReady { look: look(at: 13000, status: "1", session: "0"), looks: 4 }, image_name: desired_census, firmware: megarac_firmware_0_32, route: RouteAttached { image_list_index: "5", start: WriteAccepted { body: "{}" } }, cd_before: cd_16, general_at_end: raw_16), session_release: SessionReleased, baseline: none })) {
          MediaGateWithheld { reason: r } => string_contains(s: r as String, pattern: "knowledge refusal")
          MediaGateReady { evidence: _ } => false
        })
    _ => false
  }
}

test fn an_unread_code_at_readiness_withholds_as_unestablished() -> Bool {
  match readiness_wait_outcome(wait: ReadinessWaitReady { look: look(at: 13000, status: "1", session: "0"), looks: 4 }, image_name: desired_census, firmware: megarac_firmware_0_32, route: RouteAlreadyPresented, cd_before: cd_clean, general_at_end: MegaRacRawRead { answered: false, body: "curl: (28)", observed_at: none }) {
    MegaRacMediaStateUnestablished { image_name: _, route: _, look: _, looks: _, cd_before_any_write: _, cd_at_ready: CdErrorUnread { detail: d }, general_at_ready: _ } => d == "curl: (28)"
    _ => false
  }
}

test fn a_clean_code_at_readiness_is_ready() -> Bool {
  match readiness_wait_outcome(wait: ReadinessWaitReady { look: look(at: 13000, status: "1", session: "0"), looks: 4 }, image_name: desired_census, firmware: megarac_firmware_0_32, route: RouteAlreadyPresented, cd_before: cd_16, general_at_end: raw_clean) {
    MegaRacPresentationReady { route: _, evidence: e } => (match e.cd_before_any_write { CdErrorRead { code: CdErrorUncatalogued { wire: w } } => w == 16 _ => false })
    _ => false
  }
}

// THE EXPERIMENT ARM: the desired image presented with code 16 before any write. Held and off, the
// fresh-presentation recovery stops it (the detach route); not admitted, it refuses before any write.
test fn desired_presented_with_code_16_and_the_host_off_takes_the_recovery_arm() -> Bool {
  match step_with_cd(configurations: presenting(name: desired_census as String, status: "1"), detach: host_off, cd_before: cd_16) {
    ConvergeStepDetachStale { row: r } => r.image_name == (desired_census as String)
    _ => false
  }
}

test fn desired_presented_with_code_16_and_the_host_on_refuses_before_any_write() -> Bool {
  match step_with_cd(configurations: presenting(name: desired_census as String, status: "1"), detach: host_on, cd_before: cd_16) {
    ConvergeStepRefuse { outcome: MegaRacMediaStateUnestablishedBeforeWrite { cd_before_any_write: CdErrorRead { code: CdErrorUncatalogued { wire: w } }, reason: _ } } => w == 16
    _ => false
  }
}

fn observed(general: String, configurations: String) -> MegaRacAttachResult {
  MegaRacAttachResult {
    outcome: MegaRacPresentationObserved {
      share: share_binding_standing(body: general, expected: mtcollins1_media_share),
      readiness: attach_readiness(answered: true, body: configurations, image_name: desired_census, firmware: megarac_firmware_0_32),
      cd_error: cd_error_reading(body: general),
      general: MegaRacRawRead { answered: true, body: general, observed_at: Present { value: 5000 } },
      configurations: MegaRacRawRead { answered: true, body: configurations, observed_at: Present { value: 5001 } },
    },
    session_release: SessionReleased,
    baseline: none,
  }
}

fn only_finding_contains(findings: List<String>, pattern: String) -> Bool {
  count(findings) == 1 && (match findings.first() { Present { value: f } => string_contains(s: f, pattern: pattern)  Absent => false })
}

data served_look: MegaRacAttachResult = observed(general: mtcollins1_media_general_2026_09_27_morning_as_reported, configurations: presenting_in(name: desired_census as String, status: "1", session: "0"))

test fn a_started_bound_presentation_is_still_served() -> Bool {
  match presentation_still_served(result: served_look) { PresentationStillReady => true _ => false }
}

// The after-state of boot run 36330382023 as a post-handoff look: the row reads status 16, which is
// uncatalogued, so the look cannot say whether the medium is served -- INDETERMINATE, not LOST.
test fn the_36330382023_after_state_is_indeterminate_not_an_affirmed_loss() -> Bool {
  let after = observed(general: mtcollins1_media_general_2026_09_27, configurations: presenting_in(name: desired_census as String, status: "16", session: "255"))
  (match presentation_still_served(result: after) { PresentationUnobserved { reason: _ } => true _ => false })
    && only_finding_contains(findings: handoff_media_findings(h: HandoffMediaAttempted { before: served_look, handoff: HandoffConfirmed, after: after }), pattern: "INDETERMINATE")
    && (count(handoff_media_findings(h: HandoffMediaAttempted { before: served_look, handoff: HandoffConfirmed, after: served_look })) == 0)
}

// An affirmed loss: the look was taken and the row is gone.
test fn a_withdrawn_row_after_the_handoff_is_an_affirmed_loss() -> Bool {
  only_finding_contains(findings: handoff_media_findings(h: HandoffMediaAttempted { before: served_look, handoff: HandoffConfirmed, after: observed(general: mtcollins1_media_general_2026_09_27_morning_as_reported, configurations: "[]") }), pattern: "LOST at or after")
}

// THE DISCRIMINATING CONTROL: a failed session with the prior good presentation unchanged is
// UNOBSERVED, never LOST.
test fn a_failed_look_is_indeterminate_not_lost() -> Bool {
  let failed = MegaRacAttachResult { outcome: MegaRacSessionRefused { detail: "curl: (7)" }, session_release: SessionReleaseNotAttempted, baseline: none }
  (match presentation_still_served(result: failed) { PresentationUnobserved { reason: _ } => true _ => false })
    && only_finding_contains(findings: handoff_media_findings(h: HandoffMediaAttempted { before: served_look, handoff: HandoffConfirmed, after: failed }), pattern: "INDETERMINATE")
}

// THE RECHECK OWES ITS OWN CLEANUP: identical bodies, differing release -> only the released one admits.
test fn the_recheck_withholds_when_its_own_session_was_not_released() -> Bool {
  let held = MegaRacAttachResult { outcome: served_look.outcome, session_release: SessionReleaseRefused { detail: "probe still succeeded" }, baseline: none }
  (match presentation_still_served(result: held) { PresentationReadyButSessionHeld { held: _ } => true _ => false })
    && (match presentation_still_served(result: served_look) { PresentationStillReady => true _ => false })
}

test fn a_started_look_with_code_16_is_unestablished_at_the_recheck() -> Bool {
  match presentation_still_served(result: observed(general: mtcollins1_media_general_2026_09_27, configurations: presenting_in(name: desired_census as String, status: "1", session: "0"))) {
    PresentationStateUnestablished { cd_error: CdErrorRead { code: CdErrorUncatalogued { wire: w } } } => w == 16
    _ => false
  }
}

test fn a_withdrawn_row_or_an_unobserved_look_is_not_served() -> Bool {
  (match presentation_still_served(result: observed(general: mtcollins1_media_general_2026_09_27_morning_as_reported, configurations: "[]")) { PresentationNoLongerReady { reason: _ } => true _ => false })
    && only_finding_contains(findings: handoff_media_findings(h: HandoffMediaWithheldAtRecheck { before: observed(general: mtcollins1_media_general_2026_09_27_morning_as_reported, configurations: "[]") }), pattern: "no boot-device or power write")
}

// ─── RECEIPTS FOR THE TWO BETS ──────────────────────────────────────────────────────────────────
//
// Manual stops on 2026-09-27, host off, supplied verbatim by eager-owl-205. Both bodies carried
// image_index 0 and both rows read media_index 0, so they are CONSISTENT with stop_media_body's
// media_index bet and do NOT discriminate it from the image-list reading (the two indices coincided).
// The second read-back cleared image and status while session_index read 255 -- the observation the
// unbound-session reading of 255 rests on.
data manual_stop_readback_1545z: String = "[ { \"id\": 1, \"media_type\": 1, \"media_index\": 0, \"session_index\": 0, \"image_name\": \"\", \"redirection_status\": 0 } ]"
data manual_stop_readback_1630z: String = "[ { \"id\": 1, \"media_type\": 1, \"media_index\": 0, \"session_index\": 255, \"image_name\": \"\", \"redirection_status\": 0 } ]"

test fn both_manual_stop_readbacks_establish_the_detach_whatever_stop_media_answered() -> Bool {
  (match detach_verdict(evidence: detach(success: true, body: "echoed body", readback_read: true, readback: manual_stop_readback_1545z), image_name: desired_census, firmware: megarac_firmware_0_32, replaceable_seeded_stem: mtcollins1_census_image_stem) { DetachEstablished => true _ => false })
    && (match detach_verdict(evidence: detach(success: false, body: stop_1411, readback_read: true, readback: manual_stop_readback_1630z), image_name: desired_census, firmware: megarac_firmware_0_32, replaceable_seeded_stem: mtcollins1_census_image_stem) { DetachEstablished => true _ => false })
}

test fn the_stop_body_this_module_sends_is_byte_equal_to_the_manual_stop_that_worked() -> Bool {
  stop_media_body(image_name: stale_census as String, media_index: "0") as String
    == "{\"image_name\":\"gunbc-mtcollins1-census-ubuntu-24.04.3-arm64-6455b3b9ae11214d.iso\",\"image_type\":1,\"image_index\":0,\"image_redirection\":1}"
}

// ─── ROWS: ONLY A WELL-FORMED ROW IS IDLE (side-chat review 5331738657) ───────────────────────────
data empty_row_doc: String = "[{}]"
data started_then_empty: String = concat("[{\"media_type\":1,\"image_name\":\"", concat(desired_census as String, "\",\"redirection_status\":1,\"media_index\":0,\"session_index\":0},{}]"))
data empty_then_started: String = concat("[{},{\"media_type\":1,\"image_name\":\"", concat(desired_census as String, "\",\"redirection_status\":1,\"media_index\":0,\"session_index\":0}]"))
data unnamed_uncatalogued_row: String = "[{\"media_type\":1,\"image_name\":\"\",\"redirection_status\":16,\"media_index\":0,\"session_index\":255}]"
data string_status_row: String = "[{\"media_type\":1,\"image_name\":\"\",\"redirection_status\":\"0\",\"media_index\":0,\"session_index\":0}]"

test fn an_empty_row_alone_is_unreadable_and_licenses_no_write() -> Bool {
  match step(configurations: empty_row_doc, detach: host_off) {
    ConvergeStepRefuse { outcome: MegaRacConfigurationsUnreadable { detail: _ } } => true
    _ => false
  }
}

test fn a_started_row_beside_an_unreadable_row_is_not_ready_either_order() -> Bool {
  (match attach_readiness(answered: true, body: started_then_empty, image_name: desired_census, firmware: megarac_firmware_0_32) { ReadinessMalformed { detail: _ } => true _ => false })
    && (match attach_readiness(answered: true, body: empty_then_started, image_name: desired_census, firmware: megarac_firmware_0_32) { ReadinessMalformed { detail: _ } => true _ => false })
}

test fn an_unreadable_row_in_the_readback_does_not_establish_a_detach() -> Bool {
  (match detach_verdict(evidence: detach(success: true, body: "{}", readback_read: true, readback: empty_row_doc), image_name: desired_census, firmware: megarac_firmware_0_32, replaceable_seeded_stem: mtcollins1_census_image_stem) { DetachNotEstablished { reason: _ } => true _ => false })
    && (match detach_verdict(evidence: detach(success: true, body: "{}", readback_read: true, readback: string_status_row), image_name: desired_census, firmware: megarac_firmware_0_32, replaceable_seeded_stem: mtcollins1_census_image_stem) { DetachNotEstablished { reason: _ } => true _ => false })
}

test fn an_unnamed_row_with_an_uncatalogued_status_keeps_its_wire() -> Bool {
  match step(configurations: unnamed_uncatalogued_row, detach: host_off) {
    ConvergeStepRefuse { outcome: MegaRacRedirectionUncatalogued { image_name: n, wire: w, configurations: _ } } => n == "" && w == 16
    _ => false
  }
}

// ─── THE CLOCK CONTRACT (side-chat review 5331738657) ────────────────────────────────────────────
test fn a_started_look_before_the_window_opened_is_clock_incoherent() -> Bool {
  match readiness_verdict(opened_at: 1000, budget: 30000, previous: none, look: look(at: 500, status: "1", session: "0"), phase: ReadinessAfterStart, looks: 1) {
    ReadinessClockIncoherent { opened_at: o, previous: _, look: l, looks: _ } => o == 1000 && l.observed_at == 500
    _ => false
  }
}

test fn a_backward_or_stalled_clock_is_incoherent() -> Bool {
  (match readiness_verdict(opened_at: 1000, budget: 30000, previous: Present { value: 5000 }, look: look(at: 4000, status: "100", session: "0"), phase: ReadinessAfterStart, looks: 2) { ReadinessClockIncoherent { opened_at: _, previous: _, look: _, looks: _ } => true _ => false })
    && (match readiness_verdict(opened_at: 1000, budget: 30000, previous: Present { value: 5000 }, look: look(at: 5000, status: "1", session: "0"), phase: ReadinessAfterStart, looks: 2) { ReadinessClockIncoherent { opened_at: _, previous: _, look: _, looks: _ } => true _ => false })
}

test fn a_started_look_exactly_at_the_deadline_is_outside_the_window() -> Bool {
  match readiness_verdict(opened_at: 1000, budget: 30000, previous: Present { value: 29000 }, look: look(at: 31000, status: "1", session: "0"), phase: ReadinessAfterStart, looks: 5) {
    ReadinessWindowClosed { last: _, deadline: d, looks: _ } => d == 31000
    _ => false
  }
}

test fn the_look_count_closes_the_window_even_when_the_clock_stays_inside_it() -> Bool {
  match readiness_verdict(opened_at: 1000, budget: 30000, previous: Present { value: 1100 }, look: look(at: 1200, status: "100", session: "0"), phase: ReadinessAfterStart, looks: 16) {
    ReadinessWindowClosed { last: _, deadline: _, looks: n } => n == 16
    _ => false
  }
}

// ─── AN EXECUTED DETACH SURVIVES A LATER ERROR ───────────────────────────────────────────────────
test fn a_listing_error_after_the_stop_keeps_the_stop_and_its_1411() -> Bool {
  match media_attach_outcome_reason(outcome: MegaRacListingUnparseableAfterDetach { detail: "<html>", detach: detach(success: false, body: stop_1411, readback_read: true, readback: manual_stop_readback_1630z) }) {
    Present { value: r } => string_contains(s: r, pattern: "1411") && string_contains(s: r, pattern: "<html>")
    Absent => false
  }
}

// ─── THE POPULATION IS UNIQUE BEFORE ANY WRITE (side-chat review 5331991982) ──────────────────────
fn two_rows(a: String, a_status: String, b: String, b_status: String) -> String {
  join(["[{\"media_type\":1,\"image_name\":\"", a, "\",\"redirection_status\":", a_status, ",\"media_index\":0,\"session_index\":0},",
    "{\"media_type\":1,\"image_name\":\"", b, "\",\"redirection_status\":", b_status, ",\"media_index\":1,\"session_index\":1}]"], "")
}

fn several_in_both_orders(a: String, b: String) -> Bool {
  (match step_with_cd(configurations: two_rows(a: a, a_status: "1", b: b, b_status: "1"), detach: host_off, cd_before: cd_16) { ConvergeStepRefuse { outcome: MegaRacSeveralImagesPresented { configurations: _ } } => true _ => false })
    && (match step_with_cd(configurations: two_rows(a: b, a_status: "1", b: a, b_status: "1"), detach: host_off, cd_before: cd_16) { ConvergeStepRefuse { outcome: MegaRacSeveralImagesPresented { configurations: _ } } => true _ => false })
}

test fn duplicate_desired_rows_refuse_before_any_write_in_both_orders() -> Bool {
  several_in_both_orders(a: desired_census as String, b: desired_census as String)
}

test fn desired_beside_another_census_image_refuses_in_both_orders() -> Bool {
  several_in_both_orders(a: desired_census as String, b: stale_census as String)
}

test fn desired_beside_a_foreign_image_refuses_as_foreign_in_both_orders() -> Bool {
  (match step_with_cd(configurations: two_rows(a: desired_census as String, a_status: "1", b: "memtest86-5.31b.iso", b_status: "1"), detach: host_off, cd_before: cd_16) { ConvergeStepRefuse { outcome: MegaRacForeignImagePresented { image_name: n, configurations: _ } } => n == "memtest86-5.31b.iso" _ => false })
    && (match step_with_cd(configurations: two_rows(a: "memtest86-5.31b.iso", a_status: "1", b: desired_census as String, b_status: "1"), detach: host_off, cd_before: cd_16) { ConvergeStepRefuse { outcome: MegaRacForeignImagePresented { image_name: n, configurations: _ } } => n == "memtest86-5.31b.iso" _ => false })
}

test fn a_listing_naming_the_image_twice_is_ambiguous_not_first_match() -> Bool {
  let listing = join(["[{\"image_name\":\"", desired_census as String, "\",\"image_index\":2},{\"image_name\":\"", desired_census as String, "\",\"image_index\":5}]"], "")
  (match images_listing_reading(body: listing, image_name: desired_census) { ImagesListingUnparseable { detail: d } => string_contains(s: d, pattern: "ambiguous") _ => false })
    && (match images_listing_reading(body: join(["[{\"image_name\":\"", desired_census as String, "\",\"image_index\":5}]"], ""), image_name: desired_census) { ImagesListingOffers { image_index: i } => i == "5" _ => false })
}

// ─── THE CODE'S DISPOSITION ON EVERY ROUTE ───────────────────────────────────────────────────────
data cd_unread: CdErrorReading = CdErrorUnread { detail: "cd_error_code missing" }

test fn an_unread_code_never_withdraws_a_presentation() -> Bool {
  (match step_with_cd(configurations: presenting(name: stale_census as String, status: "1"), detach: host_off, cd_before: cd_unread) { ConvergeStepRefuse { outcome: MegaRacMediaStateUnestablishedBeforeWrite { cd_before_any_write: _, reason: _ } } => true _ => false })
    && (match step_with_cd(configurations: presenting(name: desired_census as String, status: "1"), detach: host_off, cd_before: cd_unread) { ConvergeStepAwaitReadiness => true _ => false })
    && (match step_with_cd(configurations: "[]", detach: host_off, cd_before: cd_unread) { ConvergeStepRefuse { outcome: MegaRacMediaStateUnestablishedBeforeWrite { cd_before_any_write: _, reason: _ } } => true _ => false })
}

test fn nothing_presented_with_a_nonzero_code_attaches_only_under_admission() -> Bool {
  (match step_with_cd(configurations: "[]", detach: host_off, cd_before: cd_16) { ConvergeStepAttachFromListing => true _ => false })
    && (match step_with_cd(configurations: "[]", detach: host_on, cd_before: cd_16) { ConvergeStepRefuse { outcome: MegaRacMediaStateUnestablishedBeforeWrite { cd_before_any_write: _, reason: _ } } => true _ => false })
    && (match step_with_cd(configurations: "[]", detach: host_on, cd_before: cd_clean) { ConvergeStepAttachFromListing => true _ => false })
}

// ─── WRITE ANSWERS AND THE RENDERED ARTIFACT ─────────────────────────────────────────────────────
test fn a_write_without_an_http_answer_is_effect_uncertain() -> Bool {
  (match megarac_write_answer(success: false, body: "", stderr: "curl: (28) Operation timed out after 10001 milliseconds") { WriteEffectUncertain { partial_body: _, stderr: e } => string_contains(s: e, pattern: "(28)") _ => false })
    && (match megarac_write_answer(success: false, body: stop_1411, stderr: "curl: (22) The requested URL returned error: 500") { WriteAnsweredHttpError { body: b, stderr: _ } => b == stop_1411 _ => false })
}

// The published artifact keeps the executed stop (and its 1411) and the StartMedia answer when the
// readiness clock refused afterwards.
test fn the_rendered_artifact_keeps_the_detach_and_start_answers_on_a_clock_refusal() -> Bool {
  let route = RouteReplaced { image_list_index: "5", detach: detach(success: false, body: stop_1411, readback_read: true, readback: manual_stop_readback_1630z), start: WriteEffectUncertain { partial_body: "", stderr: "curl: (28) Operation timed out" } }
  let rendered = media_attach_text(record: attempted(result: MegaRacAttachResult {
    outcome: MegaRacReadinessClockIncoherent { image_name: desired_census, route: route, opened_at: 1000, previous: none, look: look(at: 500, status: "1", session: "0"), looks: 1 },
    session_release: SessionReleased,
    baseline: none,
  }))
  string_contains(s: rendered, pattern: "1411") && string_contains(s: rendered, pattern: "EFFECT UNCERTAIN") && string_contains(s: rendered, pattern: "(28)")
}

// ─── REVIEW 5332343434 ────────────────────────────────────────────────────────────────────────────
// An offered row whose identity cannot be read is admitted as unread before candidates are counted,
// on either side of the valid desired row.
fn listing_with(first: String, second: String) -> String {
  join(["[", first, ",", second, "]"], "")
}

fn desired_offer() -> String {
  concat("{\"image_name\":\"", concat(desired_census as String, "\",\"image_index\":5}"))
}
data dup_name_offer: String = "{\"image_name\":\"a.iso\",\"image_name\":\"b.iso\",\"image_index\":3}"

test fn an_unreadable_offered_row_beside_the_desired_one_refuses_before_start_media() -> Bool {
  (match images_listing_reading(body: listing_with(first: "{}", second: desired_offer()), image_name: desired_census) { ImagesListingUnparseable { detail: _ } => true _ => false })
    && (match images_listing_reading(body: listing_with(first: desired_offer(), second: "{}"), image_name: desired_census) { ImagesListingUnparseable { detail: _ } => true _ => false })
    && (match images_listing_reading(body: listing_with(first: dup_name_offer, second: desired_offer()), image_name: desired_census) { ImagesListingUnparseable { detail: _ } => true _ => false })
    && (match images_listing_reading(body: listing_with(first: desired_offer(), second: "{\"image_name\":7}"), image_name: desired_census) { ImagesListingUnparseable { detail: _ } => true _ => false })
}

test fn a_readable_listing_ignores_unrelated_optional_members() -> Bool {
  match images_listing_reading(body: listing_with(first: "{\"image_name\":\"memtest.iso\",\"image_index\":0}", second: desired_offer()), image_name: desired_census) {
    ImagesListingOffers { image_index: i } => i == "5"
    _ => false
  }
}

// Partial bytes then a timeout: uncertain, with every byte kept; never a complete controller answer.
test fn partial_bytes_then_a_timeout_are_uncertain_and_kept() -> Bool {
  match megarac_write_answer(success: false, body: "{partial", stderr: "curl: (28) Operation timed out") {
    WriteEffectUncertain { partial_body: b, stderr: e } => b == "{partial" && string_contains(s: e, pattern: "(28)")
    _ => false
  }
}

test fn a_stop_never_sent_is_not_issued() -> Bool {
  match detach_verdict(evidence: MegaRacDetachEvidence { stale_image: stale_census as String, media_index: "", command: WriteNotIssued { reason: "no device" }, readback_read: false, readback: "", cd_after_stop: cd_unread, general_after_stop: MegaRacRawRead { answered: false, body: "not read", observed_at: none } }, image_name: desired_census, firmware: megarac_firmware_0_32, replaceable_seeded_stem: mtcollins1_census_image_stem) {
    DetachNotEstablished { reason: _ } => true
    _ => false
  }
}

// The end look is owed by an attempted media attach, handed off or not; an unconfirmed handoff is
// reported as attempted, not as a handoff that happened.
test fn the_end_look_is_owed_by_any_attempted_attach() -> Bool {
  end_media_is_owed(media: attempted(result: MegaRacAttachResult { outcome: MegaRacMediaStateUnestablished { image_name: desired_census, route: RouteAttached { image_list_index: "5", start: WriteAccepted { body: "{}" } }, look: look(at: 13000, status: "1", session: "0"), looks: 4, cd_before_any_write: cd_16, cd_at_ready: cd_16, general_at_ready: raw_16 }, session_release: SessionReleased, baseline: none }))
    && !end_media_is_owed(media: MediaAttachNotAttempted { reason: "BMC is not BmcSecured" })
}

test fn an_unconfirmed_handoff_is_reported_as_attempted() -> Bool {
  let findings = handoff_media_findings(h: HandoffMediaAttempted { before: served_look, handoff: HandoffAttemptedUnconfirmed { reason: "chassis power read-back did not observe on" }, after: served_look })
  count(findings) == 1 && (match findings.first() { Present { value: f } => string_contains(s: f, pattern: "attempted and not confirmed")  Absent => false })
}

// The raw, timed settings read reaches the rendered artifact.
test fn the_rendered_artifact_keeps_the_raw_timed_settings_at_readiness() -> Bool {
  let rendered = media_attach_text(record: attempted(result: MegaRacAttachResult {
    outcome: MegaRacMediaStateUnestablished { image_name: desired_census, route: RouteAttached { image_list_index: "5", start: WriteAccepted { body: "{}" } }, look: look(at: 13000, status: "1", session: "0"), looks: 4, cd_before_any_write: cd_16, cd_at_ready: cd_16, general_at_ready: raw_16 },
    session_release: SessionReleased,
    baseline: none,
  }))
  string_contains(s: rendered, pattern: "13100") && string_contains(s: rendered, pattern: "16 (uncatalogued)")
}
