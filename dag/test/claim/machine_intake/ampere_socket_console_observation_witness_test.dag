data reference_ghes: String = "[    0.360421] {1}[Hardware Error]: Hardware error from APEI Generic Hardware Error Source: 0\r\n[    0.360430] {1}[Hardware Error]: event severity: recoverable\r\n[    0.360434] {1}[Hardware Error]:  Error 0, type: recoverable\r\n[    0.360436] {1}[Hardware Error]:   section type: unknown, e8ed898d-df16-43cc-8ecc-54f060ef157f\r\n[    0.360443] {1}[Hardware Error]:   section length: 0x30\r\n[    0.360448] {1}[Hardware Error]:   00000000: 00000005 ec30000e 00080110 80001001  ......0.........\r\n[    0.360451] {1}[Hardware Error]:   00000010: 00000300 00000000 00000000 00000000  ................\r\n[    0.360453] {1}[Hardware Error]:   00000020: 00000000 00000000 00000000 00000000  ................\r\n[    0.360507] {2}[Hardware Error]: Hardware error from APEI Generic Hardware Error Source: 3\r\n[    0.360509] {2}[Hardware Error]: event severity: recoverable\r\n[    0.360511] {2}[Hardware Error]:  Error 0, type: recoverable\r\n[    0.360512] {2}[Hardware Error]:   section type: unknown, e8ed898d-df16-43cc-8ecc-54f060ef157f\r\n[    0.360513] {2}[Hardware Error]:   section length: 0x30\r\n[    0.360515] {2}[Hardware Error]:   00000000: 40000005 ec30000e 00080110 80005001  ...@..0......P..\r\n[    0.360517] {2}[Hardware Error]:   00000010: 00000300 00000000 00000000 00000000  ................\r\n[    0.360519] {2}[Hardware Error]:   00000020: 00000000 00000000 00000000 00000000  ................\r\n"

// artifacts/bmc/mtcollins1-hw-census-sol.log lines 3158-3167 verbatim; excerpt sha256 273ac5e09e0f35017ab34def365c451ad568fd3e39e90d223d5a196fe51de4c8.
data reference_bert: String = "[   16.312983] BERT: Error records from previous boot:\r\n[   16.317851] [Hardware Error]: event severity: recoverable\r\n[   16.323242] [Hardware Error]:  Error 0, type: fatal\r\n[   16.328114] [Hardware Error]:   section type: unknown, e8ed898d-df16-43cc-8ecc-54f060ef157f\r\n[   16.336455] [Hardware Error]:   section length: 0x31\r\n[   16.341410] [Hardware Error]:   00000000: 0000007f 6e6b6e55 206e776f 6f626572  ....Unknown rebo\r\n[   16.350098] [Hardware Error]:   00000010: 7220746f 6f736165 0000006e 00000000  ot reason.......\r\n[   16.358787] [Hardware Error]:   00000020: 00000000 00000000 00000000 00000000  ................\r\n[   16.367475] [Hardware Error]:   00000030: 12                                               .\r\n[   16.375906] BERT: Total records found: 1\r\n"

fn reference() -> AmpereSocketConsoleObservation {
  ampere_socket_console_observation(lines: split(s: concat(reference_summary, reference_ghes, reference_bert), delimiter: "\n"))
}

fn reference_whole_file() -> AmpereSocketConsoleObservation {
  ampere_socket_console_observation(lines: split(s: reference_text(), delimiter: "\n"))
}

// THE SUBJECT IS THE SOCKET-1-DEAD BOOT: SUPPLIED EXCERPTS, exact bytes of a capture that is not
