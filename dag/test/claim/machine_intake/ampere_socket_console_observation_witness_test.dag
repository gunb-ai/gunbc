fn subject() -> AmpereSocketConsoleObservation {
  ampere_socket_console_observation(lines: split(s: concat(capture_35810323032_summary, capture_35810323032_ghes, capture_35810323032_bert), delimiter: "\n"))
}

fn ints_equal(a: List<Int>, b: List<Int>) -> Bool {
  join(map(a, x => to_string(x)), ",") == join(map(b, x => to_string(x)), ",")
}

fn is_count(n: Int?, expected: Int) -> Bool {
  match n { Present { value: v } => v == expected Absent => false }
}

// ── the header decode, discriminating in both directions ──────────────────────────────────────

test fn socket_bits_are_bits_14_and_15_of_the_instance_word() -> Bool {
  match ampere_ras_section_header_of(dword: 1073741829) {
    Absent => false
    Present { value: h } => h.socket == 1 && h.instance == 0 && (match h.error_type { AmpereRasTypeDefined { error_type: AmpereRasGic } => true _ => false })
  }
}

test fn socket_zero_gic_decodes_as_socket_zero() -> Bool {
  match ampere_ras_section_header_of(dword: 5) {
    Absent => false
    Present { value: h } => h.socket == 0 && (match h.error_type { AmpereRasTypeDefined { error_type: AmpereRasGic } => true _ => false }) && !(match h.error_type { AmpereRasTypeDefined { error_type: AmpereRasPmproFw } => true _ => false })
  }
}

test fn the_pmpro_fw_word_carries_payload_three_and_subtype_three() -> Bool {
  match ampere_ras_section_header_of(dword: 974) {
    Absent => false
    Present { value: h } => (match h.error_type { AmpereRasTypeDefined { error_type: AmpereRasPmproFw } => true _ => false }) && h.subtype == 3 && h.socket == 0
      && (match h.payload_type { AmperePayloadFirmwareSpecific => true _ => false })
  }
}

test fn a_type_code_with_no_row_stays_a_number() -> Bool {
  match ampere_ras_section_header_of(dword: 21) {
    Absent => false
    Present { value: h } => match h.error_type { AmpereRasTypeUndefined { code: c } => c == 21 _ => false }
  }
}

test fn a_value_that_is_not_a_dword_refuses() -> Bool {
  match ampere_ras_section_header_of(dword: 4294967296) { Absent => true Present { value: _ } => false }
}

// ── the reference: two sockets on both printers ───────────────────────────────────────────────

test fn the_reference_capture_is_its_committed_length() -> Bool {
  reference_text().length() == reference_scalars
}

test fn the_reference_summary_prints_two_sockets_and_two_inter_socket_links() -> Bool {
  (match reference().summary {
    AmpereSummaryObserved { summary: s, summaries_printed: _ } =>
      is_count(n: s.active_sockets, expected: 2) && ints_equal(a: ampere_summary_sockets(s: s), b: [0, 1]) && count(s.inter_socket_links) == 2
    AmpereSummaryNotPrinted => false
  })
}

test fn the_reference_boot_raises_one_gic_record_per_socket() -> Bool {
  let o = reference()
  ints_equal(a: ampere_cper_sockets_this_boot(o: o.cper), b: [0, 1])
    && all(filter(o.cper.records, r => match r.source { CperFromBert => false _ => true }), r => (match r.header.error_type { AmpereRasTypeDefined { error_type: AmpereRasGic } => true _ => false }))
}

test fn the_bert_record_is_kept_apart_from_this_boot() -> Bool {
  any(reference().cper.records, r => (match r.source { CperFromBert => true _ => false }) && (match r.header.error_type { AmpereRasTypeDefined { error_type: AmpereRasBert } => true _ => false }))
}

// ── the subject: socket 1 absent from both printers ────────────────────────────────────────────

test fn the_subject_summary_prints_one_socket_and_no_link() -> Bool {
  match subject().summary {
    AmpereSummaryObserved { summary: s, summaries_printed: n } =>
      n == 1 && is_count(n: s.active_sockets, expected: 1) && ints_equal(a: ampere_summary_sockets(s: s), b: [0]) && count(s.inter_socket_links) == 0
    AmpereSummaryNotPrinted => false
  }
}

test fn every_subject_record_is_socket_zero() -> Bool {
  let o = subject()
  count(o.cper.records) == 3 && ints_equal(a: ampere_cper_sockets_this_boot(o: o.cper), b: [0])
}

// ── the comparison ─────────────────────────────────────────────────────────────────────────────

fn differences_from(r: AmpereSocketConsoleObservation) -> List<String> {
  map(ampere_socket_console_differences(reference: r, subject: subject()), d => match d {
    ActiveSocketsDiffer { reference: _, subject: _ } => "active"
    SummarySocketAbsent { socket: k } => concat("socket-absent ", to_string(k))
    InterSocketLinkAbsent { link: l, reference: _ } => concat("link-absent ", to_string(l))
    SummaryFieldDiffers { socket: k, name: n, reference: _, subject: _ } => concat("field ", to_string(k), " ", n as String)
    CperRecordAbsent { key: k } => concat("cper-absent ", to_string(k.socket), " ", k.type_text)
    CperRecordAdded { key: k } => concat("cper-added ", to_string(k.socket), " ", k.type_text, " ", to_string(k.subtype))
    _ => "other"
  })
}

fn names_socket_one(d: List<String>) -> Bool {
  any(d, x => x == "active") && any(d, x => x == "socket-absent 1")
    && any(d, x => x == "link-absent 0") && any(d, x => x == "link-absent 1")
    && any(d, x => x == "cper-absent 1 GIC") && any(d, x => x == "cper-added 0 PMPRO FW 3")
    && any(d, x => x == "field 0 RC disable mask")
    && !any(d, x => x == "cper-absent 0 GIC")
}

test fn the_comparison_names_socket_one_on_both_printers_and_the_added_pmpro_record() -> Bool {
  names_socket_one(d: differences_from(r: reference()))
}

// THE ONE REAL-ROUTE CLAIM: the committed capture read whole, through the production fold, shows
// socket 1 on both printers, as the excerpts the other claims supply do. The comparison over those
// facts is the excerpt claim above; re-running it here would pay for it twice.
test fn the_committed_file_shows_socket_one_on_both_printers() -> Bool {
  let o = reference_whole_file()
  reference_text().length() == reference_scalars
    && ints_equal(a: ampere_cper_sockets_this_boot(o: o.cper), b: [0, 1])
    && (match o.summary {
      AmpereSummaryObserved { summary: s, summaries_printed: _ } => is_count(n: s.active_sockets, expected: 2) && ints_equal(a: ampere_summary_sockets(s: s), b: [0, 1]) && count(s.inter_socket_links) == 2
      AmpereSummaryNotPrinted => false
    })
}

// A boot compared with itself differs in nothing: the comparison is not a generator of findings.
test fn a_boot_compared_with_itself_has_no_difference() -> Bool {
  count(ampere_socket_console_differences(reference: subject(), subject: subject())) == 0
}

// ── refusals the fold must keep ────────────────────────────────────────────────────────────────

test fn an_unparsable_ampere_first_row_is_kept_as_malformed() -> Bool {
  let o = ampere_socket_console_observation(lines: [
    "[    0.1] {1}[Hardware Error]: Hardware error from APEI Generic Hardware Error Source: 0",
    "[    0.1] {1}[Hardware Error]:   section type: unknown, e8ed898d-df16-43cc-8ecc-54f060ef157f",
    "[    0.1] {1}[Hardware Error]:   00000000: zz000005 ec30000e 00080110 80001001  ......0.........",
  ])
  count(o.cper.records) == 0 && count(o.cper.malformed) == 1
}

test fn a_section_of_another_type_is_counted_not_decoded() -> Bool {
  let o = ampere_socket_console_observation(lines: [
    "[    0.1] {1}[Hardware Error]: Hardware error from APEI Generic Hardware Error Source: 0",
    "[    0.1] {1}[Hardware Error]:   section type: unknown, 00000000-0000-0000-0000-000000000000",
    "[    0.1] {1}[Hardware Error]:   00000000: 40000005 ec30000e 00080110 80001001  ......0.........",
  ])
  count(o.cper.records) == 0 && o.cper.other_sections == 1
}

test fn the_rendering_names_the_decoded_socket() -> Bool {
  string_contains(s: ampere_socket_console_text(o: subject()), pattern: "-> socket 0 PMPRO FW subtype 3")
}
