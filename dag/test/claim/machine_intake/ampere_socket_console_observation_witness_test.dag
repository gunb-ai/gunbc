module test.claim.machine_intake.ampere_socket_console_observation_witness_test

import std.types { Bool, Int, List, String }
import extdeps.filesystem.filesystem_io { Filesystem }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import v2.std.optional { Present }
import extdeps.ampere.ras_error_section {
  AmpereRasGic, AmpereRasPmproFw, AmpereRasBert, AmperePayloadFirmwareSpecific, AmpereRasTypeUndefined,
  ampere_ras_section_header_of, AmpereRasTypeDefined,
}
import gunbc.machine_intake_ampere_socket_console_observation {
  AmpereSocketConsoleObservation, AmpereSummaryObserved, AmpereSummaryNotPrinted, CperFromBert,
  ActiveSocketsDiffer, SummarySocketAbsent, InterSocketLinkAbsent, SummaryFieldDiffers, CperRecordAbsent, CperRecordAdded,
  ampere_socket_console_observation, ampere_cper_sockets_this_boot, ampere_summary_sockets,
  ampere_socket_console_differences, ampere_socket_console_text,
}
import gunbc.machine_intake_mtcollins1_memory_census_observation { mtcollins1_census_sol_artifact_path }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// THE REFERENCE IS THE COMMITTED TWO-SOCKET BOOT, read whole from the tree on the production fold's
// route: artifacts/bmc/mtcollins1-hw-census-sol.log (240475 bytes, sha256
// 1e0c4bc3ab7f635f5522c23832e6d5db33d7c3b07e9467cea1f9814167bd0de8), the census run of 2026-09-10
// that reported 2 sockets and 160 CPUs. A missing path reads as empty content on this route, so every
// reference claim first asserts the file's length. A String's length counts Unicode scalar values,
// not bytes: the file's 240475 bytes decode (UTF-8, no replacement) to 240341 scalars.
data reference_scalars: Int = 240341

fn reference_text() -> String {
  Filesystem.Read(path: mtcollins1_census_sol_artifact_path as String).content
}

// THE WHOLE-FILE ROUTE IS PAID ONCE (DESIGN §3, a witness discriminates at one interface): only
// the_comparison_over_the_committed_file_names_socket_one reads the capture whole. The other
// reference claims supply its three regions as excerpts, exact bytes of that file.
// artifacts/bmc/mtcollins1-hw-census-sol.log lines 455-494 verbatim; excerpt sha256 969989d117ab172dca5f80995c8c0a8c23ed3c090a24dc14595f3e257f7db35c.
