module test.claim.machine_intake.mtcollins1_smpro_observation_witness_test

import v2.std.algebra { filter, any }
import std.types { Bool, Int, List, NonEmptyStr, String }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.optional { Present }
import extdeps.bmc.ipmi_master_write_read {
  MasterWriteReadBus, PrivateBus, PublicBus, CompletionNakOnWrite,
  master_write_read_bus_byte, master_write_read_slave_byte,
}
import extdeps.ampere.smpro_register {
  SmproStageDefined, SmproStageUndefined, SmproStatusDefined,
  smpro_bootstage_of, smpro_manufacturer_id_reg, smpro_bootstage_reg, smpro_cur_bootstage_reg,
}
import extdeps.ampere.scp_diagnostic { DdrTraining, DdrInitialization, OperatingSystem, Completed, Failed }
import gunbc.machine_intake_mtcollins1_smpro_observation {
  mtcollins1_smpro_socket_stage, CurrentStageEstablished, ReportedStageUnavailable,
  SmproProbeRaw, SmproProbeOutcome, SmproWordRead, SmproControllerRefused, SmproTransportFailed, SmproResponseMalformed, SmproNotSent,
  smpro_probe_outcome, smpro_control_refusal, smpro_request_text, mtcollins1_smpro_dossier_text,
  mtcollins1_smpro_probe_count, mtcollins1_smpro_read_order, mtcollins1_smpro_sequenced, mtcollins1_smpro_plan, SmproTarget,
}
import extdeps.ampere.smpro_register { SmproRegister, SmproBootProgressRead, SmproBootProgressRefused }
import gunbc.machine_intake_mtcollins1_power_on_account {
  PowerOnAccount, PowerOnEvidence, AttemptConfigurationReceipt, SmproPassEvidence, SocketProgressAccount,
  HandoffPoweredOn, ConsoleNotRead, SelEventsNotRead, WatchdogUnobserved,
  ExpectedSockets, StimulusRequestNotRecorded, StimulusApplicationNotRecorded, PopulationNotRecorded, FirmwareReadbacksNotRecorded,
  ProgressRead, ProgressNotRead, SmproReportedFailure, SmproPairRefused,
  mtcollins1_power_on_account,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// SUPPLIED TRANSPORT RESULTS, NOT OBSERVED ONES. No SMpro exchange with this BMC exists in the
// corpus yet: that is what this pass will produce. The stdout renderings follow ipmitool(1) raw
// (space-separated hex bytes on completion code 00h), and the refusal stderr is ipmitool's
// "Unable to send RAW command (... rsp=0xNN)" line.

fn raw(socket: Int, register: NonEmptyStr, exit_code: Int, stdout: String, stderr: String) -> SmproProbeRaw {
  SmproProbeRaw { sequence: 0, socket: socket, register: register, request: "raw 0x06 0x52 0x05 0x9e 0x02 0x02 0x02", at: "2026-09-24T12:00:00Z", exit_code: exit_code, stdout: stdout, stderr: stderr }
}

fn read_ok(socket: Int, register: NonEmptyStr, stdout: String) -> SmproProbeOutcome {
  smpro_probe_outcome(raw: raw(socket: socket, register: register, exit_code: 0, stdout: stdout, stderr: ""))
}

data nak_stderr: String = "Unable to send RAW command (channel=0x0 netfn=0x6 lun=0x0 cmd=0x52 rsp=0x83): Unknown (0x83)"

// ── request framing (IPMI v2.0 §22.11) ──────────────────────────────────────────────────────────

test fn bus_two_private_is_byte_05_and_public_04() -> Bool {
  (match master_write_read_bus_byte(bus: MasterWriteReadBus { channel: 0, bus_id: 2, bus_type: PrivateBus }) { Present { value: b } => b == 5 Absent => false })
    && (match master_write_read_bus_byte(bus: MasterWriteReadBus { channel: 0, bus_id: 2, bus_type: PublicBus }) { Present { value: b } => b == 4 Absent => false })
    && (match master_write_read_bus_byte(bus: MasterWriteReadBus { channel: 0, bus_id: 8, bus_type: PrivateBus }) { Present { value: _ } => false Absent => true })
}

test fn the_seven_bit_address_is_shifted_and_an_eight_bit_one_refuses() -> Bool {
  (match master_write_read_slave_byte(seven_bit_address: 79) { Present { value: b } => b == 158 Absent => false })
    && (match master_write_read_slave_byte(seven_bit_address: 158) { Present { value: _ } => false Absent => true })
}

test fn the_bootstage_request_writes_the_register_and_the_size() -> Bool {
  (smpro_request_text(bus: 5, slave: 158, reg: 176) as String) == "raw 0x06 0x52 0x05 0x9e 0x02 0xb0 0x02"
}

test fn the_plan_is_every_ordered_register_on_two_sockets() -> Bool {
  mtcollins1_smpro_probe_count() == 2 * count(mtcollins1_smpro_read_order) && count(mtcollins1_smpro_read_order) == 24
}

// ── one transport result -> one typed outcome ───────────────────────────────────────────────────

test fn the_manufacturer_id_in_wire_order_passes_the_control() -> Bool {
  let o = read_ok(socket: 0, register: smpro_manufacturer_id_reg.name, stdout: " cd 3a\n")
  (match o { SmproWordRead { raw: _, word: w } => w == 52538 _ => false }) && (match smpro_control_refusal(o: o) { Absent => true Present { value: _ } => false })
}

test fn a_byte_swapped_id_refuses_the_control_and_says_what_it_read() -> Bool {
  match smpro_control_refusal(o: read_ok(socket: 0, register: smpro_manufacturer_id_reg.name, stdout: " 3a cd\n")) {
    Present { value: why } => contains(why, "read 0x3acd")
    Absent => false
  }
}

test fn a_nak_is_the_controllers_refusal_not_a_transport_failure() -> Bool {
  match smpro_probe_outcome(raw: raw(socket: 1, register: smpro_manufacturer_id_reg.name, exit_code: 1, stdout: "", stderr: nak_stderr)) {
    SmproControllerRefused { raw: _, completion: CompletionNakOnWrite } => true
    _ => false
  }
}

test fn a_deadline_with_no_completion_code_is_a_transport_failure() -> Bool {
  match smpro_probe_outcome(raw: raw(socket: 0, register: smpro_manufacturer_id_reg.name, exit_code: 124, stdout: "", stderr: "")) {
    SmproTransportFailed { raw: _, timed_out: t } => t
    _ => false
  }
}

test fn one_byte_on_success_is_malformed_not_a_zero_word() -> Bool {
  match read_ok(socket: 0, register: smpro_bootstage_reg.name, stdout: " cd\n") {
    SmproResponseMalformed { raw: _, detail: _ } => true
    _ => false
  }
}

// ── the BOOTSTAGE word ──────────────────────────────────────────────────────────────────────────

test fn the_high_byte_is_the_stage_and_the_low_byte_the_status() -> Bool {
  let b = smpro_bootstage_of(word: 1027)
  (match b.stage { SmproStageDefined { stage: DdrTraining } => true _ => false })
    && (match b.status { SmproStatusDefined { status: Failed } => true _ => false })
}

test fn a_stage_code_past_the_table_stays_a_number() -> Bool {
  match smpro_bootstage_of(word: 2561).stage { SmproStageUndefined { code: c } => c == 10 _ => false }
}

// ── what a pass reports ─────────────────────────────────────────────────────────────────────────

fn socket_reads(socket: Int, bootstage: String) -> List<SmproProbeOutcome> {
  socket_reads_at(socket: socket, current: "00 09", bootstage: bootstage)
}

fn socket_reads_at(socket: Int, current: String, bootstage: String) -> List<SmproProbeOutcome> {
  [
    read_ok(socket: socket, register: smpro_manufacturer_id_reg.name, stdout: "cd 3a"),
    read_ok(socket: socket, register: smpro_cur_bootstage_reg.name, stdout: current),
    read_ok(socket: socket, register: smpro_bootstage_reg.name, stdout: bootstage),
  ]
}

// WHAT A PASS MEANS FOR THE MACHINE is the power-on account's (gunbc.machine_intake_mtcollins1_power_on_account):
// these claims supply one pass to it and read each socket's progress and the stated errors. The
// receipt is supplied with nothing recorded, so the claims say nothing about configuration.
fn receipt() -> AttemptConfigurationReceipt {
  AttemptConfigurationReceipt {
    subject: "mtcollins1", attempt: "witness", expected: ExpectedSockets { sockets: [0, 1], source: "witness" },
    requested: StimulusRequestNotRecorded { reason: "witness" }, applied: StimulusApplicationNotRecorded { reason: "witness" },
    cpus: PopulationNotRecorded { reason: "witness" }, dimms: PopulationNotRecorded { reason: "witness" }, firmware: FirmwareReadbacksNotRecorded { reason: "witness" },
  }
}

fn account_of(outcomes: List<SmproProbeOutcome>) -> PowerOnAccount {
  mtcollins1_power_on_account(e: PowerOnEvidence {
    configuration: receipt(), handoff: HandoffPoweredOn,
    smpro: [SmproPassEvidence { label: "pass", outcomes: outcomes }],
    console: ConsoleNotRead, sel: SelEventsNotRead, watchdog: WatchdogUnobserved { reason: "witness" },
    bmc_anomalies: [], census_ended: false, coverage: [],
  })
}

fn progress_of(a: PowerOnAccount, socket: Int) -> SocketProgressAccount? {
  filter(a.socket_progress, p => p.socket == socket).first()
}

fn current_code(a: PowerOnAccount, socket: Int) -> Int {
  match progress_of(a: a, socket: socket) {
    Present { value: p } => match p.reading { ProgressRead { cur_bootstage_word: c, bootstage_word: _, progress: _ } => c % 256 ProgressNotRead { reason: _ } => 0 - 1 }
    Absent => 0 - 1
  }
}

test fn socket_one_failing_ddr_training_beside_a_booted_socket_zero_is_named() -> Bool {
  let a = account_of(outcomes: concat(socket_reads(socket: 0, bootstage: "09 02"), socket_reads(socket: 1, bootstage: "04 03")))
  any(a.errors, x => match x.error { SmproReportedFailure { socket: k, pass: _, cur_bootstage_word: _, bootstage_word: r } => k == 1 && r == 1027 _ => false })
    && !any(a.errors, x => match x.error { SmproReportedFailure { socket: k, pass: _, cur_bootstage_word: _, bootstage_word: _ } => k == 0 _ => false })
}

test fn two_sockets_at_the_same_stage_add_nothing() -> Bool {
  let a = account_of(outcomes: concat(socket_reads(socket: 0, bootstage: "09 02"), socket_reads(socket: 1, bootstage: "09 02")))
  count(a.errors) == 0 && !any(a.open, q => match q.question { SmproPairRefused { socket: _, pass: _ } => true _ => false })
}

test fn socket_one_unreadable_beside_a_read_socket_zero_is_named() -> Bool {
  let s1 = [smpro_probe_outcome(raw: raw(socket: 1, register: smpro_manufacturer_id_reg.name, exit_code: 1, stdout: "", stderr: nak_stderr))]
  let a = account_of(outcomes: concat(socket_reads(socket: 0, bootstage: "09 02"), s1))
  current_code(a: a, socket: 0) == 9
    && (match progress_of(a: a, socket: 1) { Present { value: p } => (match p.reading { ProgressNotRead { reason: r } => contains(r as String, "CUR_BOOTSTAGE") _ => false }) Absent => false })
}

// THE DOSSIER EXISTS WHEN NOTHING WAS ANSWERED.
test fn a_pass_where_nothing_was_sent_still_renders_every_socket() -> Bool {
  let os = [SmproNotSent { socket: 0, register: smpro_bootstage_reg.name, reason: "socket 0 control: MANUFACTURER_ID TRANSPORT FAILED" }, SmproNotSent { socket: 1, register: smpro_bootstage_reg.name, reason: "socket 0 control did not establish the transport" }]
  let t = mtcollins1_smpro_dossier_text(outcomes: os)
  contains(t, "SMpro socket 0: CUR_BOOTSTAGE UNAVAILABLE") && contains(t, "SMpro socket 1: CUR_BOOTSTAGE UNAVAILABLE") && contains(t, "(no request sent)")
    && count(account_of(outcomes: os).errors) == 0
}

// ── THE ORDER IS ENFORCED BY THE FOLD (the production fold, with a supplied read) ───────────────
//
// The read below answers from a script and records the sequence it was HANDED, which the fold
// derives from the outcomes already folded. So each outcome's sequence is the number of probes
// that had an outcome before it was issued.

fn scripted_word(reg: SmproRegister) -> String {
  if reg.offset == 2 { "cd 3a" } else if reg.offset == 176 { "09 02" } else { "00 09" }
}

fn scripted_read(t: SmproTarget, reg: SmproRegister, n: Int) -> SmproProbeOutcome {
  smpro_probe_outcome(raw: SmproProbeRaw { sequence: n, socket: t.socket, register: reg.name, request: "r", at: "t", exit_code: 0, stdout: scripted_word(reg: reg), stderr: "" })
}

fn sequence_of(o: SmproProbeOutcome) -> Int {
  match o { SmproWordRead { raw: r, word: _ } => r.sequence _ => 0 - 1 }
}

fn register_of(o: SmproProbeOutcome) -> String {
  match o { SmproWordRead { raw: r, word: _ } => r.register as String SmproNotSent { socket: _, register: g, reason: _ } => g as String _ => "" }
}

type SequenceWalk {
  next: Int
  ok: Bool
}

// Each outcome's sequence equals its position: 0, 1, 2, ... with no gap or repeat.
fn sequences_are_positions(os: List<SmproProbeOutcome>) -> Bool {
  fold(os, init: SequenceWalk { next: 0, ok: true }, f: (acc, o) => SequenceWalk { next: acc.next + 1, ok: acc.ok && sequence_of(o: o) == acc.next }).ok
}

test fn every_read_is_issued_after_all_earlier_probes_have_outcomes() -> Bool {
  let os = mtcollins1_smpro_sequenced(plan: mtcollins1_smpro_plan(), read: (t, reg, n) => scripted_read(t: t, reg: reg, n: n))
  count(os) == mtcollins1_smpro_probe_count() && sequences_are_positions(os: os)
}

test fn bootstage_is_last_on_each_socket_and_the_control_first() -> Bool {
  let os = mtcollins1_smpro_sequenced(plan: mtcollins1_smpro_plan(), read: (t, reg, n) => scripted_read(t: t, reg: reg, n: n))
  let per = count(mtcollins1_smpro_read_order)
  let names = map(os, o => register_of(o: o))
  count(names) == 2 * per
    && (match names.first() { Present { value: x } => x == "MANUFACTURER_ID_REG" Absent => false })
    && (match names.skip(n: per - 1).first() { Present { value: x } => x == "BOOTSTAGE" Absent => false })
    && (match names.skip(n: per).first() { Present { value: x } => x == "MANUFACTURER_ID_REG" Absent => false })
    && (match names.skip(n: 2 * per - 1).first() { Present { value: x } => x == "BOOTSTAGE" Absent => false })
}

// A plan listed out of order is refused by the gate rather than executed out of order: a
// boot-progress register placed BEFORE its socket's control is NOT SENT.
test fn a_register_ahead_of_its_control_is_not_sent() -> Bool {
  let plan = mtcollins1_smpro_plan()
  let reordered = concat(plan.skip(n: 4).take(n: 1), concat(plan.take(n: 4), plan.skip(n: 5)))
  let os = mtcollins1_smpro_sequenced(plan: reordered, read: (t, reg, n) => scripted_read(t: t, reg: reg, n: n))
  match os.first() { Present { value: SmproNotSent { socket: 0, register: _, reason: _ } } => true _ => false }
}

// The socket-0 control gates socket 1 through the folded outcome, not through a separate call.
test fn a_failed_socket_zero_control_sends_nothing_further() -> Bool {
  let os = mtcollins1_smpro_sequenced(plan: mtcollins1_smpro_plan(), read: (t, reg, n) => smpro_probe_outcome(raw: SmproProbeRaw { sequence: n, socket: t.socket, register: reg.name, request: "r", at: "t", exit_code: 1, stdout: "", stderr: nak_stderr }))
  count(os) == mtcollins1_smpro_probe_count() && count(filter(os, o => match o { SmproNotSent { socket: _, register: _, reason: _ } => true _ => false })) == mtcollins1_smpro_probe_count() - 1
}

// ── CUR_BOOTSTAGE AND BOOTSTAGE ARE INDEPENDENT READINGS ───────────────────────────────────────

// Same reported BOOTSTAGE on both sockets, different CURRENT stage: that is a difference.
test fn a_differing_current_stage_with_the_same_bootstage_is_named() -> Bool {
  let a = account_of(outcomes: concat(socket_reads_at(socket: 0, current: "00 09", bootstage: "03 01"), socket_reads_at(socket: 1, current: "00 03", bootstage: "03 01")))
  current_code(a: a, socket: 0) == 9 && current_code(a: a, socket: 1) == 3
}

// A CUR_BOOTSTAGE that read survives a BOOTSTAGE that did not.
test fn the_current_stage_stands_when_bootstage_fails() -> Bool {
  let os = [
    read_ok(socket: 1, register: smpro_manufacturer_id_reg.name, stdout: "cd 3a"),
    read_ok(socket: 1, register: smpro_cur_bootstage_reg.name, stdout: "00 04"),
    smpro_probe_outcome(raw: raw(socket: 1, register: smpro_bootstage_reg.name, exit_code: 124, stdout: "", stderr: "")),
  ]
  let st = mtcollins1_smpro_socket_stage(outcomes: os, socket: 1)
  (match st.current { CurrentStageEstablished { stage: SmproStageDefined { stage: DdrTraining } } => true _ => false })
    && (match st.reported { ReportedStageUnavailable { reason: why } => contains(why, "TRANSPORT FAILED") _ => false })
}
