module test.claim.pre_os_replay_witness

import gunbc.machine_intake_mtcollins1_netboot_client_observation { mtcollins1_host_nic_mac }

import gunbc.machine_intake_pre_os_refusal { pre_os_text_refusal, PreOsOccurrenceConflict, PreOsMachineDisagrees, PreOsTextRefusal, PreOsSourceRefusal, PreOsContinuityRefusal, PreOsCommitRefusal, PreOsOwnershipRefusal }
import std.types { Bool, List, NonEmptyStr, String }
import std.nat { Nat }
import std.measure { byte_size, byte_size_count }
import gunbc.fleet_observation_collector_ownership { FollowerReadOnly }
import std.goal_assessment { ObservationEstablished, ObservationRefused, GoalAssessmentRefused, GoalSatisfied, GoalIndeterminate }
import gunbc.fleet_observation_observation_envelope { ObservationEnvelope, SourceGenerationObserved, SourceGenerationUnavailable, NativeCursor, ExposedToCollectorHostLoss, RetainedBeyondCollectorHost, ForwardRefused }
import gunbc.fleet_observation_capture_chunk { continuity_from_committed_chunks, DerivedContinuity, stream_position, StreamContinuity, ContinuityEstablished, ContinuityUnknown, DownstreamNotOffered, DownstreamAccepted, DownstreamRejected, ChunkCommitRefused, CommitNoReceipt, CommitAttestsOtherPayload, LocalCommitStanding, LocalCommitNotAttempted }
import test.claim.fleet_observation_capture_witness { t_envelope, t_chunk, t_owner, t_unfenced, t_commit_for, t_other_session, t_reach, t_pos, t_other_stream, t_one, t_committed_chunk_on_stream }
import gunbc.machine_intake_pre_os_replay { pre_os_sel_cursor, pre_os_ingest_sel }

import gunbc.machine_intake_pre_os_timeline { pre_os_cycle_anchor, pre_os_console_span, pre_os_utf8_size, PreOsReplayObservation, PreOsConsoleText, PreOsTimelineRow, pre_os_machine_timeline, pre_os_timeline_view, pre_os_captured_cycles }
import gunbc.machine_intake_pre_os_capture_replay { pre_os_archive_specs, pre_os_archive_inventory_question }
import test.claim.pre_os_observer_witness { observer_test_boot_payload }

fn replay_fixture(seq: Nat, generation: NonEmptyStr, record: NonEmptyStr) -> ObservationEnvelope {
  let base = t_envelope(ownership: t_owner(fencing: t_unfenced), chunk: t_chunk(seq: seq, generation: 4, payload: "identical-payload", first: 0, len: 100),
    local_commit: t_commit_for(payload: "identical-payload"), continuity: t_reach(through: 100), downstream: DownstreamNotOffered)
  ObservationEnvelope { binding: base.binding, source_generation: SourceGenerationObserved { generation: generation }, native_cursor: NativeCursor { record_identity: record },
    ownership: base.ownership, chunk: base.chunk, producer_timestamp: base.producer_timestamp, received: base.received, local_commit: base.local_commit,
    downstream: base.downstream, continuity: base.continuity }
}

fn baseline_text() -> String { "685 | 09/12/2026 | 10:59:50 AM | Fan #0x1 | Device Present | Asserted" }
fn stimulus_text() -> String { concat(baseline_text(), "\n686 | 09/12/2026 | 10:59:51 AM | System Boot Initiated #0x0 | Initiated by power up | Asserted") }

test fn w_generation_change_retained_without_new_stimulus() -> Bool {
  let first = pre_os_ingest_sel(previous: ObservationRefused { cause: pre_os_text_refusal(text: "no prior cursor") }, envelope: replay_fixture(seq: 1, generation: "sel-a", record: "685"), payload: baseline_text())
  let positive = pre_os_ingest_sel(previous: first.cursor, envelope: replay_fixture(seq: 2, generation: "sel-a", record: "686"), payload: stimulus_text())
  let reset = pre_os_ingest_sel(previous: first.cursor, envelope: replay_fixture(seq: 2, generation: "sel-b", record: "686"), payload: stimulus_text())
  count(first.new_records) == 0 && count(positive.new_records) == 1 && count(reset.new_records) == 0
    && match positive.continuity { ObservationEstablished { observed: delta } => delta.events == positive.new_records _ => false }
    && reset.payload == stimulus_text()
    && match reset.continuity { ObservationRefused { cause: _ } => true _ => false }
}

test fn w_sel_continuity_refusal_retains_the_observed_cause() -> Bool {
  let first = pre_os_ingest_sel(previous: ObservationRefused { cause: pre_os_text_refusal(text: "no prior cursor") }, envelope: replay_fixture(seq: 1, generation: "sel-a", record: "685"), payload: baseline_text())
  let base = replay_fixture(seq: 2, generation: "sel-a", record: "686")
  all([t_reach(through: 10), ContinuityUnknown { detail: "source reset not observed" }], continuity => {
    let envelope = ObservationEnvelope { binding: base.binding, source_generation: base.source_generation, native_cursor: base.native_cursor,
      ownership: base.ownership, chunk: base.chunk, producer_timestamp: base.producer_timestamp, received: base.received,
      local_commit: base.local_commit, downstream: base.downstream, continuity: continuity }
    let reading = pre_os_ingest_sel(previous: first.cursor, envelope: envelope, payload: stimulus_text())
    count(reading.new_records) == 0 && reading.payload == stimulus_text()
      && match reading.continuity {
        ObservationEstablished { observed: _ } => false
        ObservationRefused { cause } => match continuity {
          ContinuityEstablished { reach: _ } => contains(to_string(cause), "ContinuityShortOfRange") && contains(to_string(cause), "100")
          ContinuityUnknown { detail } => contains(to_string(cause), detail as String)
          _ => false
        }
      }
  })
}

// DEDUP AND CONFLICT ARE ASKED OF THE TIMELINE, the one authority that answers them (review 66670:
// the helpers that used to answer here were consumed by nothing else and duplicated its fold).
fn timeline_of(envelopes: List<ObservationEnvelope>) -> List<PreOsTimelineRow> {
  pre_os_machine_timeline(machine: "synthetic-machine-1",
    observations: map(envelopes, e => PreOsReplayObservation { envelope: e, format: PreOsConsoleText, payload: ObservationEstablished { observed: "NOTICE:  DRAM FW version 210525\n" } }),
    host_mac: mtcollins1_host_nic_mac, inventory_question: ObservationRefused { cause: "no question" })
}

fn row_is_occurrence_conflict(row: PreOsTimelineRow) -> Bool {
  match row.association {
    ObservationRefused { cause } => match cause.detail { PreOsOccurrenceConflict { subject: _ } => true _ => false }
    ObservationEstablished { observed: _ } => false
  }
}

test fn w_duplicate_application_is_idempotent_but_equal_payload_occurrences_survive() -> Bool {
  let a = replay_fixture(seq: 1, generation: "sel-a", record: "685")
  let b = replay_fixture(seq: 2, generation: "sel-a", record: "685")
  count(timeline_of(envelopes: [a, b])) == 2 && count(timeline_of(envelopes: [a, b, a, b])) == 2
}

test fn w_same_occurrence_changed_source_generation_is_conflict() -> Bool {
  let a = replay_fixture(seq: 1, generation: "sel-a", record: "685")
  let b = replay_fixture(seq: 1, generation: "sel-b", record: "685")
  let rows = timeline_of(envelopes: [a, b])
  count(rows) == 2 && all(rows, row => row_is_occurrence_conflict(row: row))
}


test fn w_timeline_separates_os_milestone_from_boot_identity_and_present_admission() -> Bool {
  let envelope = replay_fixture(seq: 1, generation: "console-a", record: "685")
  let observation = PreOsReplayObservation { envelope: envelope, format: PreOsConsoleText,
    payload: ObservationEstablished { observed: concat("NOTICE:  DRAM FW version 210525\n", observer_test_boot_payload()) } }
  let rows = pre_os_machine_timeline(machine: "synthetic-machine-1", observations: [observation, observation], host_mac: mtcollins1_host_nic_mac,
    inventory_question: ObservationRefused { cause: "OS milestone question supplies no memory inventory expectation" })
  let other_machine = pre_os_machine_timeline(machine: "another-machine", observations: [observation], host_mac: mtcollins1_host_nic_mac,
    inventory_question: ObservationRefused { cause: "no question" })
  count(rows) == 1 && match rows.first() {
    Absent => false
    Present { value: row } => count(row.cycles) == 1
      && match row.boot { GoalSatisfied { evidence: _ } => true _ => false }
      && match row.present_admission { GoalIndeterminate { known_deviations: _, unknowns: _ } => true _ => false }
      && all(row.cycles, cycle => match cycle.firmware_attempt { ObservationRefused { cause: _ } => true _ => false })
      && contains(pre_os_timeline_view(rows: rows), "kernel_boot")
  } && count(other_machine) == 1 && all(other_machine, row => count(row.cycles) == 0
    && match row.association { ObservationRefused { cause: _ } => true _ => false }
    && match row.boot {
      GoalAssessmentRefused { cause } => cause.location == ["timeline machine"] && match cause.detail {
        PreOsMachineDisagrees { expected, observed } => expected == "another-machine" && observed == "synthetic-machine-1"
        _ => false
      }
      _ => false
    })
}

// A delivery receipt is new evidence about an existing occurrence, not a new
// host event and not an unchanged retry that may be discarded.
test fn w_same_occurrence_new_continuity_receipt_is_retained() -> Bool {
  let a = replay_fixture(seq: 1, generation: "sel-a", record: "685")
  let b = ObservationEnvelope { binding: a.binding, source_generation: a.source_generation, native_cursor: a.native_cursor,
    ownership: a.ownership, chunk: a.chunk, producer_timestamp: a.producer_timestamp, received: a.received, local_commit: a.local_commit,
    downstream: a.downstream, continuity: t_reach(through: 200) }
  let rows = timeline_of(envelopes: [a, a, b, b])
  count(rows) == 2 && all(rows, row => !row_is_occurrence_conflict(row: row))
}

// Delivery changes retention for the same occurrence; it must neither erase
// the earlier exposure nor establish an OS boot from the delivery receipt.
test fn w_timeline_retains_local_exposure_and_downstream_acceptance() -> Bool {
  let local = replay_fixture(seq: 1, generation: "console-a", record: "685")
  let delivered = ObservationEnvelope { binding: local.binding, source_generation: local.source_generation, native_cursor: local.native_cursor,
    ownership: local.ownership, chunk: local.chunk, producer_timestamp: local.producer_timestamp, received: local.received,
    local_commit: local.local_commit, continuity: local.continuity,
    downstream: DownstreamAccepted { accepted_content: local.chunk.payload_digest } }
  let rejected = ObservationEnvelope { binding: local.binding, source_generation: local.source_generation, native_cursor: local.native_cursor,
    ownership: local.ownership, chunk: local.chunk, producer_timestamp: local.producer_timestamp, received: local.received,
    local_commit: local.local_commit, continuity: local.continuity,
    downstream: DownstreamRejected { cause: ChunkCommitRefused { detail: "downstream fixture refused this chunk" } } }
  let rows = pre_os_machine_timeline(machine: "synthetic-machine-1", observations: [
    PreOsReplayObservation { envelope: local, format: PreOsConsoleText, payload: ObservationEstablished { observed: "no host milestone" } },
    PreOsReplayObservation { envelope: rejected, format: PreOsConsoleText, payload: ObservationEstablished { observed: "no host milestone" } },
    PreOsReplayObservation { envelope: delivered, format: PreOsConsoleText, payload: ObservationEstablished { observed: "no host milestone" } },
  ], host_mac: mtcollins1_host_nic_mac,
    inventory_question: ObservationRefused { cause: "no inventory question" })
  count(rows) == 3
    && match rows.first() { Present { value: row } => match row.retention { ExposedToCollectorHostLoss { refusal: _ } => true _ => false } Absent => false }
    && match rows.skip(n: 1).first() { Present { value: row } => match row.retention { ForwardRefused { cause: ChunkCommitRefused { detail } } => detail == "downstream fixture refused this chunk" _ => false } Absent => false }
    && match rows.skip(n: 2).first() { Present { value: row } => match row.retention { RetainedBeyondCollectorHost => true _ => false } Absent => false }
    && all(rows, row => match row.boot { GoalIndeterminate { known_deviations: _, unknowns: _ } => true _ => false })
    && contains(pre_os_timeline_view(rows: rows), "retention=")
}

fn replay_console_chunk(seq: Nat, first: Nat, payload: NonEmptyStr, continuity: StreamContinuity) -> PreOsReplayObservation {
  let base = replay_fixture(seq: seq, generation: "console-a", record: "685")
  let chunk = t_chunk(seq: seq, generation: 4, payload: payload, first: first, len: byte_size_count(b: pre_os_utf8_size(text: payload as String)))
  PreOsReplayObservation {
    envelope: ObservationEnvelope { binding: base.binding, source_generation: base.source_generation, native_cursor: base.native_cursor,
      ownership: base.ownership, chunk: chunk, producer_timestamp: base.producer_timestamp, received: base.received,
      local_commit: t_commit_for(payload: payload), downstream: base.downstream, continuity: continuity },
    format: PreOsConsoleText, payload: ObservationEstablished { observed: payload as String },
  }
}

test fn w_console_chunks_compose_only_across_verified_continuity() -> Bool {
  let a = replay_console_chunk(seq: 1, first: 0, payload: "NOTICE:  DRAM FW ver", continuity: t_reach(through: 20))
  let b = replay_console_chunk(seq: 2, first: 20, payload: "sion 210525", continuity: t_reach(through: 31))
  let gap = replay_console_chunk(seq: 2, first: 20, payload: "sion 210525", continuity: ContinuityUnknown { detail: "reconnect lost continuity" })
  let before = pre_os_console_span(previous: Absent, current: a, host_mac: mtcollins1_host_nic_mac)
  let joined = pre_os_console_span(previous: Present { value: before }, current: b, host_mac: mtcollins1_host_nic_mac)
  let interrupted = pre_os_console_span(previous: Present { value: before }, current: gap, host_mac: mtcollins1_host_nic_mac)
  joined.payload == "NOTICE:  DRAM FW version 210525" && count(joined.chunks) == 2
    && interrupted.payload == "sion 210525" && count(interrupted.chunks) == 1
    && match joined.composition { ObservationEstablished { observed: combined } => combined == joined.payload _ => false }
    && match interrupted.composition { ObservationRefused { cause } => contains(to_string(cause), "current chunk") && contains(to_string(cause), "reconnect lost continuity") _ => false }
}

// The SEL cursor consumer must preserve independent commit and ownership causes.
// These fixtures change the evidence, not the observer's refusal implementation.
test fn w_sel_cursor_retains_commit_and_owner_refusals() -> Bool {
  let base = replay_fixture(seq: 1, generation: "sel-a", record: "685")
  let positive = pre_os_sel_cursor(envelope: base, payload: baseline_text())
  let commits: List<LocalCommitStanding> = [LocalCommitNotAttempted, t_commit_for(payload: "different payload")]
  match positive { ObservationEstablished { observed: _ } => true _ => false }
    && all(commits, standing => {
      let envelope = ObservationEnvelope { binding: base.binding, source_generation: base.source_generation, native_cursor: base.native_cursor,
        ownership: base.ownership, chunk: base.chunk, producer_timestamp: base.producer_timestamp, received: base.received,
        local_commit: standing, downstream: base.downstream, continuity: base.continuity }
      match pre_os_sel_cursor(envelope: envelope, payload: baseline_text()) {
        ObservationRefused { cause } => match standing {
          LocalCommitNotAttempted => match cause.detail { PreOsCommitRefusal { binding: CommitNoReceipt { standing: LocalCommitNotAttempted } } => true _ => false }
          _ => match cause.detail { PreOsCommitRefusal { binding: CommitAttestsOtherPayload { attested: _, chunk_payload: _ } } => true _ => false }
        }
        _ => false
      }
    })
    && {
      let envelope = ObservationEnvelope { binding: base.binding, source_generation: base.source_generation, native_cursor: base.native_cursor,
        ownership: FollowerReadOnly { session: t_other_session }, chunk: base.chunk, producer_timestamp: base.producer_timestamp, received: base.received,
        local_commit: base.local_commit, downstream: base.downstream, continuity: base.continuity }
      match pre_os_sel_cursor(envelope: envelope, payload: baseline_text()) {
        ObservationRefused { cause } => match cause.detail { PreOsOwnershipRefusal { ownership: FollowerReadOnly { session } } => session == t_other_session _ => false }
        _ => false
      }
    }
}

// Equal numeric offsets in different streams are incomparable, not out of range.
// THE CARRIED SCAN READS EXACTLY WHAT A SPLIT OF THE WHOLE SPAN WOULD READ: a marker that straddles
// two chunks is found when its second half arrives, cycles close at the next marker, and each
// anchor sits at its marker's byte offset. The chunk boundaries are placed so that the first
// chunk holds one whole cycle plus the head of the second marker, and the third chunk closes the
// second marker and carries the second cycle's text.
test fn w_carried_cycle_scan_finds_a_marker_that_straddles_chunks() -> Bool {
  let marker = "NOTICE:  DRAM FW version 210525"
  let one = concat("x", marker, "A", "NOTICE:  DRAM")
  let two = " FW version 210525B"
  let a = replay_console_chunk(seq: 1, first: 0, payload: one as NonEmptyStr, continuity: t_reach(through: 46))
  let b = replay_console_chunk(seq: 2, first: 46, payload: two as NonEmptyStr, continuity: t_reach(through: 65))
  let first = pre_os_console_span(previous: Absent, current: a, host_mac: mtcollins1_host_nic_mac)
  let joined = pre_os_console_span(previous: Present { value: first }, current: b, host_mac: mtcollins1_host_nic_mac)
  let cycles = pre_os_captured_cycles(span: joined, host_mac: mtcollins1_host_nic_mac)
  count(pre_os_captured_cycles(span: first, host_mac: mtcollins1_host_nic_mac)) == 1
    && count(cycles) == 2
    && match cycles.first() { Present { value: c } => match c.anchor { ObservationEstablished { observed: anchor } => anchor.stream_offset == t_pos(at: 1) _ => false } Absent => false }
    && match cycles.skip(n: 1).first() { Present { value: c } => match c.anchor { ObservationEstablished { observed: anchor } => anchor.stream_offset == t_pos(at: 33) _ => false } Absent => false }
}

test fn w_cycle_anchor_refuses_cross_stream_position() -> Bool {
  let chunk = replay_console_chunk(seq: 1, first: 0, payload: "abc", continuity: t_reach(through: 3))
  let positive = pre_os_cycle_anchor(chunks: [chunk], at: t_pos(at: 1))
  let foreign = pre_os_cycle_anchor(chunks: [chunk], at: stream_position(stream: t_other_stream, since_stream_origin: byte_size(count: 1)))
  match positive { ObservationEstablished { observed: anchor } => anchor.stream_offset == t_pos(at: 1) _ => false }
    && match foreign { ObservationRefused { cause } => contains(to_string(cause), "PositionIncomparable") && contains(to_string(cause), "a-different-source-stream") _ => false }
}

// The carrier's foreign-stream reach enters through admitted construction; the
// SEL consumer must retain incomparability rather than invent a shorter reach.
test fn w_sel_incomparable_continuity_keeps_both_streams() -> Bool {
  let first = pre_os_ingest_sel(previous: ObservationRefused { cause: pre_os_text_refusal(text: "no prior cursor") }, envelope: replay_fixture(seq: 1, generation: "sel-a", record: "685"), payload: baseline_text())
  let base = replay_fixture(seq: 2, generation: "sel-a", record: "686")
  let positive = pre_os_ingest_sel(previous: first.cursor, envelope: base, payload: stimulus_text())
  match continuity_from_committed_chunks(
    committed: t_one(c: t_committed_chunk_on_stream(stream: t_other_stream, seq: 1, generation: 4, payload: "foreign reach", first: 0, len: 100)),
    subject: t_other_stream, from: stream_position(stream: t_other_stream, since_stream_origin: byte_size(count: 0))) {
    DerivedContinuity { continuity } => {
      let envelope = ObservationEnvelope { binding: base.binding, source_generation: base.source_generation, native_cursor: base.native_cursor,
        ownership: base.ownership, chunk: base.chunk, producer_timestamp: base.producer_timestamp, received: base.received,
        local_commit: base.local_commit, downstream: base.downstream, continuity: continuity }
      let negative = pre_os_ingest_sel(previous: first.cursor, envelope: envelope, payload: stimulus_text())
      count(positive.new_records) == 1 && count(negative.new_records) == 0
        && match negative.continuity { ObservationRefused { cause } => contains(to_string(cause), "ContinuityPositionsIncomparable") && contains(to_string(cause), "synthetic-sol") && contains(to_string(cause), "a-different-source-stream") && !contains(to_string(cause), "ContinuityShortOfRange") _ => false }
    }
    _ => false
  }
}

// An unread payload refuses boot with its located cause; an assessed console
// without an OS milestone remains indeterminate. Neither is a boot success.
test fn w_boot_retains_payload_refusal_but_assessed_no_milestone_is_indeterminate() -> Bool {
  let envelope = replay_fixture(seq: 1, generation: "console-a", record: "685")
  all([true, false], unread => {
    let observation = PreOsReplayObservation { envelope: envelope, format: PreOsConsoleText,
      payload: if unread { ObservationRefused { cause: "capture read failed" } }
        else { ObservationEstablished { observed: "no host milestone" } } }
    let rows = pre_os_machine_timeline(machine: "synthetic-machine-1", observations: [observation],
      host_mac: mtcollins1_host_nic_mac, inventory_question: ObservationRefused { cause: "no inventory question" })
    count(rows) == 1 && match rows.first() {
      Absent => false
      Present { value: row } => match row.boot {
        GoalAssessmentRefused { cause } => unread && cause.location == ["observation"] && match cause.detail {
          PreOsTextRefusal { text } => text == "capture read failed"
          _ => false
        }
        GoalIndeterminate { known_deviations: _, unknowns: _ } => !unread
        _ => false
      }
    }
  })
}

// Carrier rejection must stop the assessments, not merely decorate the view.
// A valid standalone chunk after a rejected chunk still has its own evidence.
fn replay_carrier_assessment_control(standing: LocalCommitStanding, continuity: StreamContinuity, accepted: Bool) -> Bool {
  let payload = concat("NOTICE:  DRAM FW version 210525\n", observer_test_boot_payload()) as NonEmptyStr
  let valid = replay_console_chunk(seq: 1, first: 0, payload: payload, continuity: t_reach(through: 10000))
  let base = valid.envelope
  let changed = PreOsReplayObservation { format: PreOsConsoleText, payload: valid.payload,
    envelope: ObservationEnvelope { binding: base.binding, source_generation: base.source_generation, native_cursor: base.native_cursor,
      ownership: base.ownership, chunk: base.chunk, producer_timestamp: base.producer_timestamp, received: base.received,
      local_commit: standing, downstream: base.downstream, continuity: continuity } }
  let next = replay_console_chunk(seq: 2, first: byte_size_count(b: pre_os_utf8_size(text: payload as String)), payload: payload, continuity: t_reach(through: 10000))
  match pre_os_archive_specs() {
    ObservationRefused { cause: _ } => false
    ObservationEstablished { observed: specs } => match specs.first() {
      Absent => false
      Present { value: spec } => {
        let rows = pre_os_machine_timeline(machine: "synthetic-machine-1", observations: [changed, next], host_mac: mtcollins1_host_nic_mac,
          inventory_question: ObservationEstablished { observed: pre_os_archive_inventory_question(spec: spec) })
        count(rows) == 2 && match rows.first() {
          Absent => false
          Present { value: row } => if accepted {
            match row.boot { GoalSatisfied { evidence: _ } => count(row.cycles) == 1 _ => false }
          } else {
            count(row.cycles) == 0 && match row.console_composition {
              ObservationEstablished { observed: _ } => false
              ObservationRefused { cause: rejected } =>
                match row.boot { GoalAssessmentRefused { cause } => cause == rejected _ => false }
                && match row.training { GoalAssessmentRefused { cause } => cause == rejected _ => false }
                && match row.configuration { ObservationRefused { cause } => cause == rejected _ => false }
            }
          }
        } && match rows.skip(n: 1).first() {
          Absent => false
          Present { value: row } => match row.boot { GoalSatisfied { evidence: _ } => count(row.cycles) > 0 _ => false }
        }
      }
    }
  }
}

test fn w_timeline_assessments_consume_commit_and_continuity_refusals() -> Bool {
  let payload = concat("NOTICE:  DRAM FW version 210525\n", observer_test_boot_payload()) as NonEmptyStr
  let valid_commit = t_commit_for(payload: payload)
  let reach = t_reach(through: 10000)
  replay_carrier_assessment_control(standing: valid_commit, continuity: reach, accepted: true)
    && all([LocalCommitNotAttempted, t_commit_for(payload: "another payload")], standing =>
      replay_carrier_assessment_control(standing: standing, continuity: reach, accepted: false))
    && all([ContinuityUnknown { detail: "capture continuity unobserved" }, t_reach(through: 1)], continuity =>
      replay_carrier_assessment_control(standing: valid_commit, continuity: continuity, accepted: false))
    && match continuity_from_committed_chunks(
      committed: t_one(c: t_committed_chunk_on_stream(stream: t_other_stream, seq: 1, generation: 4, payload: "foreign reach", first: 0, len: 10000)),
      subject: t_other_stream, from: stream_position(stream: t_other_stream, since_stream_origin: byte_size(count: 0))) {
      DerivedContinuity { continuity } => replay_carrier_assessment_control(standing: valid_commit, continuity: continuity, accepted: false)
      _ => false
    }
}

// Recovery labels locate the previous refusal; they must not replace its cause.
test fn w_sel_baseline_retains_prior_cursor_refusal() -> Bool {
  let prior = pre_os_text_refusal(text: "prior capture digest mismatch")
  let reading = pre_os_ingest_sel(previous: ObservationRefused { cause: prior },
    envelope: replay_fixture(seq: 1, generation: "sel-a", record: "685"), payload: baseline_text())
  match reading.continuity {
    ObservationRefused { cause } => cause.detail == prior.detail && count(cause.location) == count(prior.location) + 1
    _ => false
  }
}

// A late conflict must refuse the first occurrence too. The input-order list
// remains independent of index traversal, and an exact retry keeps its first row.
test fn w_indexed_timeline_preserves_order_and_late_conflicts() -> Bool {
  let a = replay_fixture(seq: 1, generation: "console-a", record: "685")
  let b = replay_fixture(seq: 2, generation: "console-a", record: "685")
  let changed = replay_fixture(seq: 1, generation: "console-b", record: "685")
  let observations = map([a, b, a, changed], envelope => PreOsReplayObservation {
    envelope: envelope, format: PreOsConsoleText, payload: ObservationEstablished { observed: "ordinary console" } })
  let rows = pre_os_machine_timeline(machine: "synthetic-machine-1", observations: observations,
    host_mac: mtcollins1_host_nic_mac, inventory_question: ObservationRefused { cause: "no inventory question" })
  map(rows, row => row.observation.envelope.chunk.occurrence.receive_sequence) == [1, 2, 1]
    && all(rows, row => if row.observation.envelope.chunk.occurrence.receive_sequence == 1 {
      match row.association {
        ObservationRefused { cause } => match cause.detail { PreOsOccurrenceConflict { subject: _ } => true _ => false }
        _ => false
      }
    } else { match row.association { ObservationEstablished { observed: _ } => true _ => false } })
}
