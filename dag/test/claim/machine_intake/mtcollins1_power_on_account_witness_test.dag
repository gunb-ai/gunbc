inux version 6.8.0-71-generic (buildd@bos03-arm64-036) (aarch64-linux-gnu-gcc-13 (Ubuntu 13.3.0-6ubuntu2~24.04) 13.3.0, GNU ld (GNU Binutils for Ubuntu) 2.42) #71-Ubuntu SMP PREEMPT_DYNAMIC Tue Jul 22 16:44:45 UTC 2025 (Ubuntu 6.8.0-71.71-generic 6.8.12)\r\n"

// the same file, line 1879: the kernel's panic after the missing initrd; excerpt sha256 a602607e3bd95133ca09a71f3d24f3227cf4fd92e33bd108be22bf11b3848e51.
data run_37069907299_panic: String = "[    9.962666] Kernel panic - not syncing: VFS: Unable to mount root fs on unknown-block(0,0)\r\n"

fn lines_of(text: String) -> List<String> {
  host_capture_lines(capture: HostCaptureLiveStream { text: text })
}

data no_digest: Sha256FileDigest = Sha256FileDigest { digest: sha256_digest(hex: "6f33812ce2af74aacf9deba90931aa9144b1ba974532ae9e890b90a57c5900c1") }

// The relation the bundle derives for step 1's last span against the census reference (supplied; see above).
fn step1_relation(span: Int) -> AmpereCheckpointRelation {
  AmpereCheckpointRelation {
    span: span, capture: no_digest, last: AmpereCheckpointToken { digits: "00001a0a" },
    reference_path: "artifacts/bmc/mtcollins1-hw-census-sol.log", reference_digest: no_digest,
    reference_firmware: "the vendor firmware set installed before the 2026-10-02 update", reference_configuration: "two sockets, sixteen DIMMs",
    continuation: ReferenceContinues { next: AmpereCheckpointToken { digits: "14001a0a" }, remaining: 91, occurrences: 1 },
  }
}

fn console_of(lines: List<String>, relations: List<AmpereCheckpointRelation>) -> ConsoleEvidence {
  ConsoleRead {
    capture: no_digest, firmware: firmware_console_report(lines: lines), firmware_error_lines: 0,
    dram: ampere_dram_console_observation(lines: lines), checkpoints: ampere_checkpoint_console_observation(lines: lines), relations: relations,
    milestones: mtcollins1_console_milestones(lines: lines), sockets: ampere_socket_console_observation(lines: lines),
    loader: grub_console_report(lines: lines), linux: linux_boot_console_observation(lines: lines), modules: kernel_module_decompression_observation(lines: lines), span_readings: span_console_readings(lines: lines),
  }
}

fn receipt() -> AttemptConfigurationReceipt {
  AttemptConfigurationReceipt {
    subject: "mtcollins1", attempt: "witness", expected: ExpectedSockets { sockets: [0, 1], source: "witness: both sockets expected" },
    requested: StimulusRequestNotRecorded { reason: "witness" }, applied: StimulusApplicationNotRecorded { reason: "witness" },
    cpus: PopulationNotRecorded { reason: "witness" }, dimms: PopulationNotRecorded { reason: "witness" }, firmware: FirmwareReadbacksNotRecorded { reason: "witness" },
  }
}

fn raw(socket: Int, reg: SmproRegister, stdout: String) -> SmproProbeOutcome {
  smpro_probe_outcome(raw: SmproProbeRaw { sequence: 0, socket: socket, register: reg.name, request: "r", at: "2026-10-03T04:25:00Z", exit_code: 0, stdout: stdout, stderr: "" })
}

// THE 2026-10-03 LOOP's SMpro pass (eager-gull-22's synchronized capture): socket 0 CUR_BOOTSTAGE 0x0002
// with BOOTSTAGE 0x0201; socket 1 CUR_BOOTSTAGE 0x0001 with BOOTSTAGE 0x03ff, a refused pair.
fn loop_pass() -> List<SmproPassEvidence> {
  pass_of(label: "power-on", outcomes: [
    raw(socket: 0, reg: smpro_manufacturer_id_reg, stdout: "cd 3a"), raw(socket: 0, reg: smpro_cur_bootstage_reg, stdout: "00 02"), raw(socket: 0, reg: smpro_bootstage_reg, stdout: "02 01"),
    raw(socket: 1, reg: smpro_manufacturer_id_reg, stdout: "cd 3a"), raw(socket: 1, reg: smpro_cur_bootstage_reg, stdout: "00 01"), raw(socket: 1, reg: smpro_bootstage_reg, stdout: "03 ff"),
  ])
}

// Socket 0's GPI-pending CCIX record as #13058 decodes it (smpro-err-20261003T005609Z: 0x7E = 0x0002,
// 0xA6 = 0x0074, 0xA7 = 0x2244).
fn ccix_pass() -> List<SmproPassEvidence> {
  pass_of(label: "census", outcomes: [
    raw(socket: 0, reg: smpro_manufacturer_id_reg, stdout: "cd 3a"), raw(socket: 0, reg: smpro_gpi_ras_err_reg, stdout: "00 02"),
    raw(socket: 0, reg: smpro_err_pmpro_type_reg, stdout: "00 02"), raw(socket: 0, reg: smpro_err_pmpro_info_hi_reg, stdout: "22 44"),
    raw(socket: 0, reg: smpro_err_pmpro_info_lo_reg, stdout: "00 74"), raw(socket: 0, reg: smpro_err_pmpro_data_hi_reg, stdout: "00 00"),
    raw(socket: 0, reg: smpro_err_pmpro_data_lo_reg, stdout: "00 00"), raw(socket: 0, reg: smpro_warn_pmpro_info_hi_reg, stdout: "00 00"),
    raw(socket: 0, reg: smpro_warn_pmpro_info_lo_reg, stdout: "00 00"),
  ])
}

// REAL SEL ROWS, re-typed as the reader types them (gunbc.machine_intake_pre_os_bringup_verdict
// SelWindowEvent). Run 37069907299's own window (artifact mtcollins1-boot-diagnostics.txt, sha256
// 5d11c12a4bb1d9eda3b7b0c5568e46b91f57b93d68507f1e3e6f6969cc3946f6): c26 "Initiated by power up" then
// c2b "System Restart" -- the power-on and the one restart before its second DRAM pass. Step 1's
// sel-after.txt (branch mtcollins1-captures-2026-10-03) row 3b, one "System Restart" of the loop.
data run_37069907299_power_up: SelWindowEvent = SelWindowEvent { record_id: 3110, bmc_clock_rendering: "10/02/2026 06:13:25 PM UTC", kind: BootRestart { offset: InitiatedByPowerUp } }

data run_37069907299_restart: SelWindowEvent = SelWindowEvent { record_id: 3115, bmc_clock_rendering: "10/02/2026 06:14:09 PM UTC", kind: BootRestart { offset: SystemRestart } }

data step1_restart: SelWindowEvent = SelWindowEvent { record_id: 59, bmc_clock_rendering: "10/02/2026 07:32:52 PM UTC", kind: BootRestart { offset: SystemRestart } }

// Step 1's row 37, the "System Restart" before row 3b: after a confirmed power-on with no power-up
// record, the first such row is ambiguous (it may be the power-on's own boot) and 3b is a distinct reset.
data step1_first_restart: SelWindowEvent = SelWindowEvent { record_id: 55, bmc_clock_rendering: "10/02/2026 07:32:27 PM UTC", kind: BootRestart { offset: SystemRestart } }

data step1_restarts: List<SelWindowEvent> = [step1_first_restart, step1_restart]

fn evidence(console: ConsoleEvidence, smpro: List<SmproPassEvidence>, census_ended: Bool) -> PowerOnEvidence {
  evidence_with(console: console, smpro: smpro, census_ended: census_ended, sel: [])
}

fn evidence_with(console: ConsoleEvidence, smpro: List<SmproPassEvidence>, census_ended: Bool, sel: List<SelWindowEvent>) -> PowerOnEvidence {
  PowerOnEvidence {
    configuration: receipt(), handoff: HandoffPoweredOn, smpro: smpro, console: console, sel: SelEventsRead { events: sel },
    watchdog: WatchdogUnobserved { reason: "witness" }, bmc_anomalies: [], census_ended: census_ended, coverage: [],
  }
}

fn step1_account() -> PowerOnAccount {
  let lines = lines_of(text: step1_last_two_cycles)
  mtcollins1_power_on_account(e: evidence_with(console: console_of(lines: lines, relations: [step1_relation(span: 1)]), smpro: loop_pass(), census_ended: false, sel: step1_restarts))
}

// ── THE NEW-FIRMWARE LOOP ─────────────────────────────────────────────────────────────────────

test fn the_step1_loop_is_a_repeated_restart_ending_after_an_opaque_token() -> Bool {
  match step1_account().ending {
    RestartedRepeatedly { cycles: n, last_cycle_ended_after: r, cadence: c, console_errors: k, sel_restarts: _, watchdog: _, reset_cause: rc } =>
      n == 2 && k == 0
        && (match r { Present { value: rel } => (rel.last.digits as String) == "00001a0a" Absent => false })
        && (match c { CadenceCounted { cycles: m } => m == 2 _ => false })
        && (match rc { ResetCauseUnobserved { searched: _ } => true _ => false })
    _ => false
  }
}

test fn the_loop_leaves_retry_state_reset_cause_and_meaning_open() -> Bool {
  let a = step1_account()
  any(a.open, q => match q.question { RetryStatePersistence => true _ => false })
    && any(a.open, q => match q.question { ResetCauseNotPubliclyReadable => true _ => false })
    && any(a.open, q => match q.question { CheckpointMeaningNotPubliclyModeled => true _ => false })
}

// LAW 5: the refused pair is evidence on the join subject and an open question, never a stage.
test fn socket_ones_refused_pair_is_an_open_question_on_the_join() -> Bool {
  let a = step1_account()
  any(a.open, q => match q.question { SmproPairRefused { socket: k, pass: _ } => k == 1 && (match q.subject { SecondaryJoin => true _ => false }) _ => false })
    && any(a.socket_progress, p => p.socket == 1 && (match p.reading { ProgressRead { cur_bootstage_word: _, bootstage_word: _, progress: g } => (match g { SmproBootProgressRefused { cur_bootstage_word: c, bootstage_word: r } => c == 1 && r == 1023 _ => false }) _ => false }))
}

// LAW 4: mutating the last token changes only the relation; the ending's kind and cycle count stand.
test fn a_different_last_token_changes_only_the_relation() -> Bool {
  let lines = lines_of(text: step1_last_two_cycles)
  let other = AmpereCheckpointRelation { span: 1, capture: no_digest, last: AmpereCheckpointToken { digits: "00001a09" }, reference_path: "r", reference_digest: no_digest, reference_firmware: "f", reference_configuration: "c", continuation: ReferenceContinues { next: AmpereCheckpointToken { digits: "00001a0a" }, remaining: 1, occurrences: 1 } }
  match mtcollins1_power_on_account(e: evidence_with(console: console_of(lines: lines, relations: [other]), smpro: loop_pass(), census_ended: false, sel: step1_restarts)).ending {
    RestartedRepeatedly { cycles: n, last_cycle_ended_after: r, cadence: _, console_errors: _, sel_restarts: _, watchdog: _, reset_cause: _ } =>
      n == 2 && (match r { Present { value: rel } => (rel.last.digits as String) == "00001a09" Absent => false })
    _ => false
  }
}

// ── LAW 2: CYCLES ARE PRESERVED, AND PROGRESS AFTER A RESTART IS NOT A LOOP ──────────────────

fn old_firmware_account(census_ended: Bool) -> PowerOnAccount {
  let lines = concat(lines_of(text: run_37069907299_firmware), concat(lines_of(text: run_37069907299_loader_and_stub), lines_of(text: run_37069907299_panic)))
  mtcollins1_power_on_account(e: evidence_with(console: console_of(lines: lines, relations: []), smpro: [], census_ended: census_ended, sel: [run_37069907299_power_up, run_37069907299_restart]))
}

test fn the_old_firmware_first_cycle_stops_and_the_second_reaches_uefi() -> Bool {
  let a = old_firmware_account(census_ended: false)
  count(a.cycles) == 2
    && (match a.cycles.first() { Present { value: c } => !any(c.milestones, m => match m.sighting.milestone { FirmwareSummaryObserved => true _ => false }) Absent => false })
    && (match a.cycles.last() { Present { value: c } => any(c.milestones, m => match m.sighting.milestone { FirmwareSummaryObserved => true _ => false }) Absent => false })
}

// The stub's initrd failure led to the kernel's panic: the attempt stopped at the panic, and the
// initrd failure stays among the errors as what led there.
test fn an_initrd_failure_then_a_panic_ends_at_the_kernel_with_both_errors_kept() -> Bool {
  let a = old_firmware_account(census_ended: false)
  (match a.ending { StoppedWithStatedFailure { subject: s, error: e } => (match s { Kernel => true _ => false }) && (match e { KernelPanic { reason: _ } => true _ => false }) _ => false })
    && any(a.errors, x => match x.error { InitrdLoadFailedByStub { status: st } => (match st { EfiLoadError => true _ => false }) _ => false })
}

test fn the_readback_finds_uefi_in_cycle_two_and_carries_the_ending() -> Bool {
  match firmware_set_boot_readback(a: old_firmware_account(census_ended: false)) {
    BootReachedUefiAfterSet { cycle: c, milestone: _, ending: e, degradations: _, account: _ } => c == 2 && (match e { StoppedWithStatedFailure { subject: _, error: _ } => true _ => false })
    _ => false
  }
}

test fn the_step1_readback_is_progress_lost() -> Bool {
  match firmware_set_boot_readback(a: step1_account()) { BootProgressLostAfterSet { ending: _, last_relation: r, account: _ } => (match r { Present { value: _ } => true Absent => false }) _ => false }
}

// ── LAW 1: REACHING THE CENSUS IS ORTHOGONAL TO ERRORS ───────────────────────────────────────

test fn a_pending_ccix_record_and_a_one_socket_census_reach_the_census_degraded() -> Bool {
  let a = mtcollins1_power_on_account(e: evidence(console: console_of(lines: lines_of(text: run_37069907299_firmware), relations: []), smpro: ccix_pass(), census_ended: true))
  (match a.ending { ReachedCensus => true _ => false })
    && any(a.degradations, d => match d { PendingErrorRecord { socket: k, processor: _, record: _ } => k == 0 _ => false })
    && any(a.degradations, d => match d { ActiveSocketsBelowExpected { active: n, expected: x } => n == 1 && x == 2 _ => false })
    && any(a.degradations, d => match d { SocketNotJoined { outcome: _ } => true _ => false })
}

// ── LAW 3: COVERAGE NEVER CHOOSES THE ENDING ─────────────────────────────────────────────────

test fn an_empty_sol_beside_a_census_end_marker_is_reached_census_with_a_gap() -> Bool {
  let a = mtcollins1_power_on_account(e: PowerOnEvidence {
    configuration: receipt(), handoff: HandoffPoweredOn, smpro: [], console: console_of(lines: [], relations: []), sel: SelEventsNotRead,
    watchdog: WatchdogUnobserved { reason: "witness" }, bmc_anomalies: [], census_ended: true,
    coverage: [CarrierCoverage { carrier: SolConsole, standing: CarrierReadEmpty }],
  })
  (match a.ending { ReachedCensus => true _ => false })
    && any(a.open, q => match q.question { CarrierNotRead { carrier: c } => (match c { SolConsole => true _ => false }) _ => false })
}

// ── LAW 7: A CYCLE EXISTS WITHOUT DRAM ───────────────────────────────────────────────────────

test fn power_on_and_smpro_progress_without_a_banner_is_one_partial_cycle() -> Bool {
  let a = mtcollins1_power_on_account(e: evidence(console: ConsoleNotRead, smpro: loop_pass(), census_ended: false))
  count(a.cycles) == 1
    && (match a.cycles.first() { Present { value: c } => (match c.boundary { OpenedByPowerOn => true _ => false }) && (match c.console { NoConsoleSpan => true _ => false }) Absent => false })
    && (match a.ending { StoppedWithoutRestart { last_milestone: m, ended_after: _, console_errors: _, restarts_before: n } => n == 0 && (match m { Absent => true Present { value: _ } => false }) _ => false })
}

test fn with_nothing_read_the_host_ending_is_not_established() -> Bool {
  let a = mtcollins1_power_on_account(e: PowerOnEvidence {
    configuration: receipt(), handoff: HandoffNotConfirmed { reason: "witness" }, smpro: [], console: ConsoleNotRead, sel: SelEventsNotRead,
    watchdog: WatchdogUnobserved { reason: "witness" }, bmc_anomalies: [], census_ended: false, coverage: [],
  })
  count(a.cycles) == 0 && (match a.ending { HostEndingNotEstablished => true _ => false })
}

// ── LAW 6: CONFIGURATION QUESTIONS NEED THE RECEIPT ──────────────────────────────────────────

test fn an_unrecorded_dimm_population_is_an_open_question_and_an_attested_one_is_not() -> Bool {
  let lines = lines_of(text: step1_last_two_cycles)
  let unrecorded = mtcollins1_power_on_account(e: evidence(console: console_of(lines: lines, relations: []), smpro: [], census_ended: false))
  let r = receipt()
  let attested = mtcollins1_power_on_account(e: PowerOnEvidence {
    configuration: AttemptConfigurationReceipt { subject: r.subject, attempt: r.attempt, expected: r.expected, requested: r.requested, applied: r.applied, cpus: r.cpus,
      dimms: PopulationOperatorAttested { rows: [SlotRow { label: "J1", socket: 0, populated: true }, SlotRow { label: "J17", socket: 0, populated: true }], receipt: "witness inspection" }, firmware: r.firmware },
    handoff: HandoffPoweredOn, smpro: [], console: console_of(lines: lines, relations: []), sel: SelEventsNotRead,
    watchdog: WatchdogUnobserved { reason: "witness" }, bmc_anomalies: [], census_ended: false, coverage: [],
  })
  any(unrecorded.open, q => match q.question { ConfigurationNotRecorded { field: f } => (match f { ConfiguredDimmPopulation => true _ => false }) _ => false })
    && !any(attested.open, q => match q.question { ConfigurationNotRecorded { field: f } => (match f { ConfiguredDimmPopulation => true _ => false }) _ => false })
}

test fn the_rendering_names_the_ending_and_the_open_questions() -> Bool {
  let t = mtcollins1_power_on_account_text(a: step1_account())
  contains(t, "restarted repeatedly: 2 cycle(s)") && contains(t, "ended after token 00001a0a")
    && contains(t, "does any failsafe or retry state survive the reset?")
}

// ── GAP 1: ONLY TYPED POWER-ON OR RESET EVIDENCE OPENS A CYCLE ───────────────────────────────

test fn two_banners_without_a_reset_are_one_cycle_with_unbound_spans() -> Bool {
  let a = mtcollins1_power_on_account(e: evidence(console: console_of(lines: lines_of(text: step1_last_two_cycles), relations: []), smpro: [], census_ended: false))
  count(a.cycles) == 1
    && (match a.cycles.first() { Present { value: c } => (match c.console { SpanBindingAmbiguous => true _ => false }) Absent => false })
    && any(a.open, q => match q.question { ConsoleSpansUnbound { spans: n, cycles: k } => n == 2 && k == 1 _ => false })
    && (match a.ending { RestartedRepeatedly { cycles: _, last_cycle_ended_after: _, cadence: _, console_errors: _, sel_restarts: _, watchdog: _, reset_cause: _ } => false _ => true })
}

test fn the_same_console_plus_one_typed_reset_is_two_bound_cycles() -> Bool {
  let lines = lines_of(text: run_37069907299_firmware)
  let without = mtcollins1_power_on_account(e: evidence(console: console_of(lines: lines, relations: []), smpro: [], census_ended: false))
  let with = mtcollins1_power_on_account(e: evidence_with(console: console_of(lines: lines, relations: []), smpro: [], census_ended: false, sel: [run_37069907299_power_up, run_37069907299_restart]))
  count(without.cycles) == 1 && count(with.cycles) == 2
    && (match with.cycles.last() { Present { value: c } => (match c.boundary { OpenedBySelRestart { record: r } => r.record_id == 3115 _ => false }) Absent => false })
    && !any(with.open, q => match q.question { ConsoleSpansUnbound { spans: _, cycles: _ } => true _ => false })
}

// A power-up record and the confirmed power-on are ONE boundary.
test fn a_power_up_record_does_not_add_a_cycle_to_the_power_on() -> Bool {
  count(old_firmware_account(census_ended: false).cycles) == 2
}

// ── GAP 2: AN UNRECORDED TOPOLOGY MINTS NO TOPOLOGY DEGRADATION ──────────────────────────────

fn with_expected(e: PowerOnEvidence, expected: ExpectedTopology) -> PowerOnEvidence {
  let c = e.configuration
  PowerOnEvidence {
    configuration: AttemptConfigurationReceipt { subject: c.subject, attempt: c.attempt, expected: expected, requested: c.requested, applied: c.applied, cpus: c.cpus, dimms: c.dimms, firmware: c.firmware },
    handoff: e.handoff, smpro: e.smpro, console: e.console, sel: e.sel, watchdog: e.watchdog, bmc_anomalies: e.bmc_anomalies, census_ended: e.census_ended, coverage: e.coverage,
  }
}

test fn one_active_socket_with_no_recorded_topology_is_questions_only() -> Bool {
  let a = mtcollins1_power_on_account(e: with_expected(e: evidence(console: console_of(lines: lines_of(text: run_37069907299_firmware), relations: []), smpro: [], census_ended: true), expected: ExpectedTopologyNotRecorded { reason: "witness" }))
  count(a.degradations) == 0
    && any(a.open, q => match q.question { ConfigurationNotRecorded { field: f } => (match f { ConfiguredExpectedTopology => true _ => false }) _ => false })
}

test fn a_receipt_expecting_one_socket_is_not_degraded_by_one_active_socket() -> Bool {
  let a = mtcollins1_power_on_account(e: with_expected(e: evidence(console: console_of(lines: lines_of(text: run_37069907299_firmware), relations: []), smpro: [], census_ended: true), expected: ExpectedSockets { sockets: [0], source: "witness: socket-1 CPU removed" }))
  !any(a.degradations, d => match d { ActiveSocketsBelowExpected { active: _, expected: _ } => true SocketNotJoined { outcome: _ } => true _ => false })
}

// ── GAP 3: AN EARLIER CYCLE'S FAILURE IS HISTORY, NOT THE ENDING ─────────────────────────────

test fn a_cycle_one_panic_then_a_reset_and_a_stable_uefi_shell_is_not_ended_by_the_panic() -> Bool {
  let lines = concat(["NOTICE:  DRAM FW version 210525", "CP: 0ff00900"], concat(lines_of(text: run_37069907299_panic), ["NOTICE:  DRAM FW version 220414", "CP: 0ff00900", "UEFI Interactive Shell v2.2"]))
  let a = mtcollins1_power_on_account(e: evidence_with(console: console_of(lines: lines, relations: []), smpro: [], census_ended: false, sel: step1_restarts))
  (match a.ending { StoppedWithoutRestart { last_milestone: m, ended_after: _, console_errors: _, restarts_before: n } => n == 1 && (match m { Present { value: x } => (match x.sighting.milestone { UefiShellObserved => true _ => false }) Absent => false }) _ => false })
    && any(a.errors, x => (match x.error { KernelPanic { reason: _ } => true _ => false }) && (match x.cycle { Present { value: k } => k == 1 Absent => false }))
}

// ── GAP 4: A PENDING WARNING SURVIVES ─────────────────────────────────────────────────────────

test fn a_pending_warning_without_an_error_is_kept() -> Bool {
  let pass = pass_of(label: "census", outcomes: [
    raw(socket: 0, reg: smpro_manufacturer_id_reg, stdout: "cd 3a"), raw(socket: 0, reg: smpro_gpi_ras_err_reg, stdout: "00 02"),
    raw(socket: 0, reg: smpro_err_pmpro_type_reg, stdout: "00 01"), raw(socket: 0, reg: smpro_err_pmpro_info_hi_reg, stdout: "00 00"),
    raw(socket: 0, reg: smpro_err_pmpro_info_lo_reg, stdout: "00 00"), raw(socket: 0, reg: smpro_err_pmpro_data_hi_reg, stdout: "00 00"),
    raw(socket: 0, reg: smpro_err_pmpro_data_lo_reg, stdout: "00 00"), raw(socket: 0, reg: smpro_warn_pmpro_info_hi_reg, stdout: "22 44"),
    raw(socket: 0, reg: smpro_warn_pmpro_info_lo_reg, stdout: "00 74"),
  ])
  let a = mtcollins1_power_on_account(e: evidence(console: ConsoleNotRead, smpro: pass, census_ended: false))
  count(a.warnings) == 1 && !any(a.errors, x => match x.error { SmproRecordStated { socket: _, processor: _, pass: _, record: _ } => true _ => false })
}

// ── GAP 5: A MILESTONE CARRIES ITS CAPTURE AND ITS READER ────────────────────────────────────

test fn the_same_line_from_two_captures_stays_two_facts() -> Bool {
  let lines = concat(["NOTICE:  DRAM FW version 220414"], ["UEFI Interactive Shell v2.2"])
  let other = Sha256FileDigest { digest: sha256_digest(hex: "1e0c4bc3ab7f635f5522c23832e6d5db33d7c3b07e9467cea1f9814167bd0de8") }
  let c1 = console_of(lines: lines, relations: [])
  let c2 = match c1 {
    ConsoleRead { capture: _, firmware: f, firmware_error_lines: e, dram: d, checkpoints: k, relations: r, milestones: m, sockets: o, loader: g, linux: l, modules: x, span_readings: sr } =>
      ConsoleRead { capture: other, firmware: f, firmware_error_lines: e, dram: d, checkpoints: k, relations: r, milestones: m, sockets: o, loader: g, linux: l, modules: x, span_readings: sr }
    ConsoleNotRead => ConsoleNotRead
  }
  let m1 = flat_map(mtcollins1_power_on_account(e: evidence(console: c1, smpro: [], census_ended: false)).cycles, c => c.milestones)
  let m2 = flat_map(mtcollins1_power_on_account(e: evidence(console: c2, smpro: [], census_ended: false)).cycles, c => c.milestones)
  match m1.last() {
    Present { value: a } => match m2.last() {
      Present { value: b } => (a.sighting.line as String) == (b.sighting.line as String) && digest_hex(d: a.capture) != digest_hex(d: b.capture) && (a.reader.decl_name as String) == "mtcollins1_console_milestones"
      Absent => false
    }
    Absent => false
  }
}

fn digest_hex(d: Sha256FileDigest) -> String {
  match d { Sha256FileDigest { digest: x } => x.hex as String Sha256FileDigestUnavailable { path: _, reason: r } => r }
}

// ── THE AMBIGUOUS FIRST RESTART (side-chat review of 21630c5) ────────────────────────────────

// A confirmed power-on, no power-up record, and a first "System Restart": the record may be the
// power-on's own boot, so it opens no cycle -- never a second cycle, never a repeated-restart ending.
test fn a_first_restart_after_power_on_without_a_power_up_record_is_ambiguous() -> Bool {
  let a = mtcollins1_power_on_account(e: evidence_with(console: console_of(lines: lines_of(text: step1_last_two_cycles), relations: []), smpro: [], census_ended: false, sel: [step1_first_restart]))
  count(a.cycles) == 1
    && any(a.open, q => match q.question { BootBoundaryAmbiguous { record_id: r } => r == 55 _ => false })
    && (match a.ending { RestartedRepeatedly { cycles: _, last_cycle_ended_after: _, cadence: _, console_errors: _, sel_restarts: _, watchdog: _, reset_cause: _ } => false _ => true })
}

// ── EVERY PANIC IS ITS OWN ERROR, IN ITS OWN CYCLE ──────────────────────────────────────────

test fn two_panics_in_two_cycles_are_two_errors_and_the_second_ends_the_attempt() -> Bool {
  let lines = ["NOTICE:  DRAM FW version 220414", "[    9.1] Kernel panic - not syncing: first", "NOTICE:  DRAM FW version 220414", "[    9.2] Kernel panic - not syncing: second"]
  let a = mtcollins1_power_on_account(e: evidence_with(console: console_of(lines: lines, relations: []), smpro: [], census_ended: false, sel: step1_restarts))
  any(a.errors, x => (match x.error { KernelPanic { reason: r } => (r as String) == "first" _ => false }) && (match x.cycle { Present { value: k } => k == 1 Absent => false }))
    && any(a.errors, x => (match x.error { KernelPanic { reason: r } => (r as String) == "second" _ => false }) && (match x.cycle { Present { value: k } => k == 2 Absent => false }))
    && (match a.ending { StoppedWithStatedFailure { subject: _, error: e } => (match e { KernelPanic { reason: r } => (r as String) == "second" _ => false }) _ => false })
}

// ── ONE ERROR PER OCCURRENCE FOR WHOLE-SPAN STATEMENTS TOO (side-chat review of c7beccad) ───────

data grub_failed_line: String = "Failed to boot both default and fallback entries."

test fn a_grub_failure_in_each_of_two_cycles_is_two_errors_and_the_second_ends() -> Bool {
  let lines = ["NOTICE:  DRAM FW version 220414", "GNU GRUB  version 2.12", "error: no such device: first.", grub_failed_line, "NOTICE:  DRAM FW version 220414", "GNU GRUB  version 2.12", "error: no such device: second.", grub_failed_line]
  let a = mtcollins1_power_on_account(e: evidence_with(console: console_of(lines: lines, relations: []), smpro: [], census_ended: false, sel: step1_restarts))
  let grub = filter(a.errors, x => match x.error { BootLoaderFailed { errors: _ } => true _ => false })
  count(grub) == 2
    && any(grub, x => match x.cycle { Present { value: k } => k == 1 Absent => false })
    && any(grub, x => match x.cycle { Present { value: k } => k == 2 Absent => false })
    && (match a.ending { StoppedWithStatedFailure { subject: _, error: e } => (match e { BootLoaderFailed { errors: es } => any(es, g => contains(grub_error_text(error: g), "second")) _ => false }) _ => false })
}

test fn a_firmware_statement_in_each_of_two_cycles_is_two_errors() -> Bool {
  let lines = ["NOTICE:  DRAM FW version 220414", "ERROR: Non-identical DIMM mixture NOT supported!", "NOTICE:  DRAM FW version 220414", "ERROR: Non-identical DIMM mixture NOT supported!"]
  let a = mtcollins1_power_on_account(e: evidence_with(console: console_of(lines: lines, relations: []), smpro: [], census_ended: false, sel: step1_restarts))
  let fw = filter(a.errors, x => match x.error { FirmwareStatement { report: _ } => true _ => false })
  count(fw) == 2 && any(fw, x => match x.cycle { Present { value: k } => k == 1 Absent => false }) && any(fw, x => match x.cycle { Present { value: k } => k == 2 Absent => false })
}

// ── THE SEL FOLD IS ORDERED, WITHOUT LOOK-AHEAD ──────────────────────────────────────────────

data second_power_up: SelWindowEvent = SelWindowEvent { record_id: 3200, bmc_clock_rendering: "witness", kind: BootRestart { offset: InitiatedByPowerUp } }

fn boundary_kinds(sel: List<SelWindowEvent>) -> List<String> {
  map(mtcollins1_power_on_account(e: evidence_with(console: ConsoleNotRead, smpro: [], census_ended: false, sel: sel)).boundaries, b => match b {
    PowerOnCorroboration { record: r } => concat("corroborates ", to_string(r.record_id))
    DistinctRestart { record: r } => concat("distinct ", to_string(r.record_id))
    BoundaryAmbiguous { record: r, reason: _ } => concat("ambiguous ", to_string(r.record_id))
  })
}

test fn a_later_record_never_changes_how_a_prefix_was_classified() -> Bool {
  let prefix = boundary_kinds(sel: [step1_first_restart])
  let longer = boundary_kinds(sel: [step1_first_restart, second_power_up])
  prefix == longer.take(n: count(prefix)) && prefix == ["ambiguous 55"]
}

test fn a_power_on_and_two_ordered_power_ups_are_an_initial_cycle_and_one_later_cycle() -> Bool {
  let a = mtcollins1_power_on_account(e: evidence_with(console: ConsoleNotRead, smpro: [], census_ended: false, sel: [run_37069907299_power_up, second_power_up]))
  count(a.cycles) == 2 && boundary_kinds(sel: [run_37069907299_power_up, second_power_up]) == ["corroborates 3110", "distinct 3200"]
}
