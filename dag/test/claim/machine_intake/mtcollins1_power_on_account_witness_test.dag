data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// ONE SUPPLIED PASS, rendered against mtcollins1's real admitted site so the account reads it through
// a subject as production does. A refused site yields no pass, and every claim expecting one fails.
fn pass_of(label: NonEmptyStr, outcomes: List<SmproProbeOutcome>) -> List<SmproPassEvidence> {
  match mtcollins1_smpro_site() {
    SmproSiteAdmitted { site: s } => [SmproPassEvidence { label: label, observation: smpro_pass_observation_fixture(host: operator_host_mtcollins1, site: s, outcomes: outcomes) }]
    SmproSiteRefused { cause: _ } => []
  }
}

// SUPPLIED FIXTURES (DESIGN section 3, a witness discriminates at one interface). The account's inputs
// are constructed here: console readings by running the real readers over EXACT BYTES of real
// captures, and the opaque checkpoint relation supplied as a value -- its production from a reference
// capture is held by power_on_console_readers_witness_test, and the whole bundle route by
// mtcollins1_boot_diagnostic_bundle_witness_test's inhabitance claim.
// branch mtcollins1-captures-2026-10-03, mtcollins1/step1-j1j17-20261003T042447Z/sol.raw
