import extdeps.bmc.megarac { megarac_ui_features_json }
import v2.std.algebra { any }

// PROCESS-AND-PROTOCOL EVIDENCE, NOT HARDWARE EVIDENCE (eager-owl-205, 2026-09-28). Each control runs
// the REAL held observer -- the same launcher (through kvm_observer_protocol_launch), triggers, handoff admission and
// megarac_kvm_observer_finish the boot runs -- in headless Chromium against a loopback controller
// (gunbc.bmc_megarac_web_transport) that ENFORCES the transition table gunbc.bmc_megarac_web_adapter
// derives from gunbc.bmc_model against every actual request. It needs gunbc.runner_browser_toolchain
// ready on the executing runner; without it the observer is not started and every control here is
// RED, never skipped. The hardware half is the boot itself: its receipt carries the observer's
// established line and first hash-bound still (REAL ROUTE UNEXECUTED until the first hold-lifted boot).

fn world(other_viewers: Int, close_at: Nat?, canvas_readable: Bool) -> BmcWorld {
  bmc_with_pending(
    world: bmc_with_web(world: bmc_world(power: BmcPowerOn), web: BmcWebWorld {
      account: Present { value: BmcWebAccount { username: "admin", password: "pw", privilege: 4 } },
      sessions: [], next_session_id: 7, other_kvm_viewers: other_viewers, kvm: BmcKvmIdle {}, canvas_readable: canvas_readable,
    }),
    pending: match close_at { Absent => []  Present { value: t } => [BmcScheduledEvent { at: second(count: t), event: BmcKvmStreamClosed {} }] },
    fired: [],
  )
}

// A table the lifecycle controls never reach: their "node" exits or is blocked before it reads it.
data empty_table: String = "\{\"initial\": \"A\", \"canvas_readable\": true, \"kvm_path\": \"/kvm\", \"rows\": []}"

fn no_close() -> Nat? {
  none
}

type Rig {
  dir: String
  serving: MegaRacWebTransportStart
  start: KvmObserverStart
}

fn scratch_dir() -> String {
  let made = shell.Mktemp.Dir()
  if made.success { made.path as String } else { "" }
}

// WHY THE TOOLCHAIN IS NOT HERE is kept as the toolchain authority states it -- the readback standing
// for NotReady, the cause for Unresolved -- and carried into the rig's KvmObserverNotStarted reason,
// never collapsed into a generic "not ready".
fn toolchain_absence(r: RunnerBrowserToolchainResolution) -> String {
  match r {
    BrowserToolchainReady { location: _, standing: _ } => ""
    BrowserToolchainNotReady { standing: st } => concat("the runner browser toolchain is not ready on this host: ", runner_browser_toolchain_standing_text(s: st))
    BrowserToolchainUnresolved { cause: c } => concat("the runner browser toolchain is unresolved on this host: ", c)
  }
}

fn read_or_empty(path: String) -> String {
  let x = Filesystem.Read(path: path)
  if x.success { x.content } else { "" }
}

// Serve the model's table on loopback, write the credential, and launch the real observer at it.
fn rig(w: BmcWorld) -> Rig {
  rig_with(w: w, features_json: loopback_features_json())
}

// THE FEATURE LIST THE LOOPBACK VIEWER NEEDS: the vendor shape (extdeps.bmc.megarac
// megarac_ui_features_json) over the one name the stand-in viewer reads.
fn loopback_features_json() -> String {
  megarac_ui_features_json(names: ["KVM_SESSION_RECONNECT" as NonEmptyStr])
}

fn rig_with(w: BmcWorld, features_json: String) -> Rig {
  let dir = scratch_dir()
  let pw_path = concat(dir, "/credential")
  let _pw = Filesystem.Write(path: pw_path, content: "pw")
  let table = megarac_web_transition_table(initial: w, credentials: [MegaRacWebLogin { username: "admin", password: "pw" }], extended_privilege: 259, depth: megarac_web_exploration_depth)
  let resolution = runner_browser_toolchain_here_wet()
  match resolution {
    BrowserToolchainReady { location: loc, standing: _ } => {
      let serving = megarac_web_transport_serve(dir: dir, table: table, node_binary: loc.node_binary as String)
      let start = match serving {
        TransportServing { port: port, pid: _ } => {
          let obs = concat(dir, "/observer")
          let _made = shell.Mkdir.Parents(path: obs as FilePath)
          kvm_observer_protocol_launch(dir_given: obs, base_url: concat("http://127.0.0.1:", port), host: concat("127.0.0.1:", port), username: "admin", password_file: pw_path, toolchain: loc, attempt: "wet", features_json: features_json)
        }
        TransportNotServing { cause: _ } => KvmObserverNotStarted { reason: "the loopback transport is not serving" }
      }
      Rig { dir: dir, serving: serving, start: start }
    }
    _ => Rig { dir: dir, serving: TransportNotServing { cause: TransportPidUnpublished }, start: KvmObserverNotStarted { reason: toolchain_absence(r: resolution) as NonEmptyStr } }
  }
}

fn close_rig(r: Rig) -> Bool {
  let released = megarac_web_transport_stop(dir: r.dir)
  let observed = match released { OwnedReleased { pid: _ } => true  OwnedAlreadyGone { pid: _ } => true  _ => false }
  observed && shell.Remove.RecursiveForce(path: r.dir).success
}

fn released(rec: KvmObserverRecord) -> Bool {
  match rec.teardown {
    KvmTeardownRecorded { terminal: _, snapshot: _, requested_at: _, stopped_seen: st, session_release: sr, browser_close: bc, process: p } =>
      st && string_contains(s: sr, pattern: "released") && string_contains(s: bc, pattern: "closed")
        && match p { OwnedReleased { pid: _ } => true  OwnedAlreadyGone { pid: _ } => true  _ => false }
    _ => false
  }
}

fn transport_log(r: Rig) -> String { read_or_empty(path: concat(r.dir, "/transport.log")) }

// THE PAGE'S ROUTE, AS THE JOURNAL RECORDS IT: every main-frame navigation's seq, the observer's phase
// and the committed URL, in journal order. Against the loopback controller the route is exactly the one
// navigation the observer makes -- viewer.html, and never the root -- so the journal's record of where the
// page went is held to what happened; on the real controller the same lines record any reload the SPA
// makes to #login under the held viewer.
fn navigation_route(start: KvmObserverStart) -> List<String> {
  match start {
    KvmObserverStarted { dir: d, subject: _, standing: _, checked_at: _ } =>
      flat_map(kvm_journal_events_at(dir: d as String), e => match e {
        KvmJournalNavigated { at: _, seq: n, phase: p, url: u } => [join([n, p, u], " ")]
        _ => []
      })
    _ => []
  }
}

// The loopback port the observer was pointed at, read back from its established host.
fn port_of(start: KvmObserverStart) -> String {
  match start {
    KvmObserverStarted { dir: _, subject: s, standing: _, checked_at: _ } =>
      match split(s: s.host, delimiter: ":").last() { Present { value: p } => p  Absent => "" }
    _ => ""
  }
}

// ESTABLISHED FOR THIS SUBJECT, ADMITTED FOR THE HANDOFF, AND THE TRIGGERED STILL IS HASH-BOUND. The
// controller saw a real login, the owning logout, and closed the stream when the model said so.
test fn a_held_observer_is_admitted_and_its_triggered_still_is_hash_bound() -> Bool {
  let r = rig(w: world(other_viewers: 0, close_at: no_close(), canvas_readable: true))
  let admitted = match kvm_handoff_admission(start: r.start) { KvmHandoffAdmitted { session: s } => s == "7"  _ => false }
  let asked = kvm_observer_trigger(start: r.start, order: 2, reason: "sol-channel-lost")
  let _w = sleep_delay_seconds_second_carrier_projection(duration: second(count: 3))
  let rec = megarac_kvm_observer_finish(start: r.start, attempt: "wet", terminal_order: 3)
  let log = transport_log(r: r)
  let loss_still = count(filter(rec.stills, s => match s { KvmStillHashed { at: a, seq: _, reason: why, path: _, digest: _ } => string_contains(s: why, pattern: "sol-channel-lost") && (millisecond_count(m: a.since_epoch) as Int) > 0  _ => false }))
  let navigations = navigation_route(start: r.start)
  let closed = close_rig(r: r)
  admitted && asked && loss_still == 1 && released(rec: rec) && closed
    && navigations == [concat("1 viewer \"http://127.0.0.1:", port_of(start: r.start), "/viewer.html\"")]
    && string_contains(s: log, pattern: "transition request=[\"login\",\"admin\",\"pw\"] status=200")
    && string_contains(s: log, pattern: "transition request=[\"logout\",\"csrf-7\"] status=200")
    && string_contains(s: log, pattern: "stream closed by the model")
}

// THE LOGIN DOES NOT RUN IN A DOCUMENT THAT CAN NAVIGATE AWAY (fleet-converge run 36721915217). The
// transport's root page replaces itself on DOMContentLoaded. The observer that loaded "/" and logged in
// by evaluating a fetch inside it journalled "failed ... Execution context was destroyed" against this
// transport, the hardware journal line for line, and was never established. The ROUTE is asserted, not
// only the answer: the controller saw the login and never served its root page.
test fn a_root_page_that_navigates_cannot_destroy_the_login() -> Bool {
  let r = rig(w: world(other_viewers: 0, close_at: no_close(), canvas_readable: true))
  let admitted = match kvm_handoff_admission(start: r.start) { KvmHandoffAdmitted { session: s } => s == "7"  _ => false }
  let rec = megarac_kvm_observer_finish(start: r.start, attempt: "wet", terminal_order: 3)
  let log = transport_log(r: r)
  let closed = close_rig(r: r)
  admitted && released(rec: rec) && closed
    && string_contains(s: log, pattern: "transition request=[\"login\",\"admin\",\"pw\"] status=200")
    && !string_contains(s: log, pattern: "spa-root served")
}

// THE VIEWER NEEDS ITS FEATURE LIST (KVM probe run 36788605665): launched WITHOUT it, the viewer's
// unguarded sessionStorage.features.indexOf throws, the page error is journalled, /kvm is never
// requested, and the observer refuses for want of a frame -- never established. The route is asserted:
// the controller saw the login and no kvm connect.
test fn a_viewer_without_its_feature_list_never_opens_kvm() -> Bool {
  let r = rig_with(w: world(other_viewers: 0, close_at: no_close(), canvas_readable: true), features_json: "")
  let refused = match kvm_observer_standing_now(start: r.start) { KvmObserverRefused { at: _, refusal: _ } => true  _ => false }
  let page_error = match r.start { KvmObserverStarted { dir: d, subject: _, standing: _, checked_at: _ } => any(kvm_journal_events_at(dir: d as String), e => match e { KvmJournalPageError { at: _, phase: p, detail: x } => p == "viewer" && string_contains(s: x, pattern: "indexOf")  _ => false })  _ => false }
  let rec = megarac_kvm_observer_finish(start: r.start, attempt: "wet", terminal_order: 3)
  let log = transport_log(r: r)
  let closed = close_rig(r: r)
  refused && page_error && released(rec: rec) && closed
    && string_contains(s: log, pattern: "transition request=[\"login\",\"admin\",\"pw\"] status=200")
    && !string_contains(s: log, pattern: "transition request=[\"connect\"")
}

// VIEWER SLOT BUSY: the model's other viewer makes viewer_count 1; the observer refuses with that count,
// never connects, releases its session -- and the handoff is refused with that standing.
test fn a_busy_viewer_slot_refuses_the_observer_and_the_handoff() -> Bool {
  let r = rig(w: world(other_viewers: 1, close_at: no_close(), canvas_readable: true))
  let refused = match kvm_observer_standing_now(start: r.start) { KvmObserverRefused { at: _, refusal: x } => match x { KvmSeatBusy { viewer_count: n } => n == "1"  _ => false }  _ => false }
  let handoff = match kvm_handoff_admission(start: r.start) { KvmHandoffRefused { cause: c } => string_contains(s: c, pattern: "viewer_count=1")  _ => false }
  let rec = megarac_kvm_observer_finish(start: r.start, attempt: "wet", terminal_order: 3)
  let log = transport_log(r: r)
  let closed = close_rig(r: r)
  refused && handoff && !string_contains(s: log, pattern: "kvm-open") && string_contains(s: log, pattern: "transition request=[\"logout\",\"csrf-7\"] status=200") && released(rec: rec) && closed
}

// CONNECTION LOST MID-BOOT: the model closes the stream at its scheduled instant. The browser's close
// is journalled as connection-lost, the boot's tick report freezes it, the standing is Lost (so a
// handoff after it is refused), and a still asked after it is not-connected.
test fn a_connection_lost_mid_boot_is_reported_and_no_still_is_claimed_after_it() -> Bool {
  let r = rig(w: world(other_viewers: 0, close_at: Present { value: 8 }, canvas_readable: true))
  let _w = sleep_delay_seconds_second_carrier_projection(duration: second(count: 10))
  let reported = mtcollins1_boot_screen_boundary_report(screen: r.start, already: [])
  let lost = match kvm_observer_standing_now(start: r.start) { KvmObserverLost { at: _, established_at: _ } => true  _ => false }
  let handoff = match kvm_handoff_admission(start: r.start) { KvmHandoffRefused { cause: c } => string_contains(s: c, pattern: "LOST")  _ => false }
  let rec = megarac_kvm_observer_finish(start: r.start, attempt: "wet", terminal_order: 3)
  let report_file = match r.start { KvmObserverStarted { dir: d, subject: _, standing: _, checked_at: _ } => read_or_empty(path: concat(d as String, "/boundary-report"))  _ => "" }
  let closed = close_rig(r: r)
  lost && handoff && count(rec.stills) == 0
    && count(reported) >= 1 && string_contains(s: report_file, pattern: "CONNECTION LOST")
    && released(rec: rec) && closed
}

// CANVAS UNREADABLE: the world's browser-side flag makes the page's canvas unexportable; the still asked
// for is acquisition-failed canvas-unreadable with the browser's own words.
test fn an_unreadable_canvas_is_acquisition_failed_with_the_browsers_words() -> Bool {
  let r = rig(w: world(other_viewers: 0, close_at: no_close(), canvas_readable: false))
  let asked = kvm_observer_trigger(start: r.start, order: 2, reason: "sol-channel-lost")
  let _w = sleep_delay_seconds_second_carrier_projection(duration: second(count: 3))
  let rec = megarac_kvm_observer_finish(start: r.start, attempt: "wet", terminal_order: 3)
  let unreadable = count(filter(rec.events, e => match e {
    KvmJournalAcquisitionFailed { at: _, seq: _, reason: _, cause: c, gen: _ } => match c { KvmCanvasUnreadable { detail: d } => string_contains(s: d, pattern: "Tainted canvases")  _ => false }
    _ => false
  })) >= 1
  let closed = close_rig(r: r)
  asked && unreadable && count(rec.stills) == 0 && released(rec: rec) && closed
}

// ── THE TRANSPORT'S OWNED LIFECYCLE ─────────────────────────────────────────────────────────────
//
// READINESS IS BOUND TO THE WHOLE INSTANCE: a listening line from another pid, or from the SAME pid with
// an earlier start time, is not readiness, whatever it says. Pure over what the launch would have read.
test fn a_stale_listening_line_from_another_pid_is_not_readiness() -> Bool {
  let stale = "1 pid=999 listening start=50 port=4242\n1 pid=4242 listening start=99 port=4343\n"
  let running = OwnedRunning { pid: "4242", start_time: "100" }
  let not_yet = match megarac_web_transport_readiness(standing: running, out: "", events: stale) { Absent => true  Present { value: _ } => false }
  let mine = match megarac_web_transport_readiness(standing: running, out: "", events: concat(stale, "2 pid=4242 listening start=100 port=5151\n")) { Present { value: s } => match s { TransportServing { port: p, pid: q } => p == "5151" && q == "4242"  _ => false }  Absent => false }
  let unpublished = match megarac_web_transport_readiness(standing: OwnedGone { pid: "" }, out: concat(owned_process_unpublished_line, "\n"), events: "") { Present { value: s } => match s { TransportNotServing { cause: c } => match c { TransportPidUnpublished => true  _ => false }  _ => false }  Absent => false }
  let exited = match megarac_web_transport_readiness(standing: OwnedGone { pid: "4242" }, out: concat(owned_process_exit_prefix, "1 at=2026-09-28T00:00:00Z\n"), events: "") { Present { value: s } => match s { TransportNotServing { cause: c } => match c { TransportExitedBeforeReady { exit_line: _ } => true  _ => false }  _ => false }  Absent => false }
  not_yet && mine && unpublished && exited
}

// AN IMMEDIATE EXIT, EXECUTED: a "node" that exits at once never becomes serving. Which typed cause it
// gets is a race the launch reports honestly: exited-before-ready when its (pid, start time) was
// published first, pid-unpublished when it was gone before its start time could be read. Never serving.
test fn a_transport_that_exits_at_once_is_not_serving() -> Bool {
  let dir = scratch_dir()
  let s = megarac_web_transport_serve(dir: dir, table: empty_table, node_binary: "false")
  let _gone = shell.Remove.RecursiveForce(path: dir)
  match s {
    TransportNotServing { cause: c } => match c {
      TransportExitedBeforeReady { exit_line: l } => string_contains(s: l, pattern: "status=1")
      TransportPidUnpublished => true
      _ => false
    }
    _ => false
  }
}

// A FAILED PID PUBLICATION, EXECUTED: a pid path that cannot be written stops the child the launch
// started and says so; nothing is left running.
test fn a_launch_that_cannot_publish_its_pid_stops_its_child() -> Bool {
  let dir = scratch_dir()
  let _blocker = shell.Mkdir.Parents(path: concat(dir, "/transport.pid") as FilePath)
  let s = megarac_web_transport_serve(dir: dir, table: empty_table, node_binary: "sleep")
  let _gone = shell.Remove.RecursiveForce(path: dir)
  match s { TransportNotServing { cause: c } => match c { TransportPidUnpublished => true  _ => false }  _ => false }
}

// A TERM-IGNORING CHILD WHOSE RECORD CANNOT BE PUBLISHED, EXECUTED THROUGH THE PRODUCTION LAUNCH SCRIPT
// (gunbc.owned_process owned_process_launch_script, the exact bytes LaunchOwned hands to bash -c): the
// launch escalates to KILL and writes "stopped" only after observing the child gone -- the exit record
// shows the KILL -- and nothing it started is left running.
// THE CHILD IGNORES TERM FROM BIRTH, inherited from a launcher that ignores it before forking, for the
// reason given at an_unreadable_process_state_never_skips_the_kill_of_an_unpublished_child: a child
// that installs the ignore itself can be TERMed first and exit 143, so KILL is never exercised. That
// disposition cannot be set through the LaunchOwned operation (its launcher argv is the production
// one), so the script is run directly; the operation itself is still executed for real by
// a_launch_that_cannot_publish_its_pid_stops_its_child.
test fn a_term_ignoring_child_with_an_unpublished_record_is_observed_stopped() -> Bool {
  let dir = scratch_dir()
  let pid_path = concat(dir, "/child.pid")
  let _blocker = shell.Mkdir.Parents(path: pid_path as FilePath)
  let _l = shell.Exec.RunArgv(program: "env", arguments: ["--ignore-signal=TERM", "bash", "-c", owned_process_launch_script, "owned-launch", pid_path, concat(dir, "/child.log"), owned_process_exit_prefix, owned_process_unpublished_line, owned_process_unpublished_survived_line, owned_process_unpublished_unobservable_line, "sleep", "37"])
  let _w = sleep_delay_seconds_second_carrier_projection(duration: second(count: 6))
  let log = read_or_empty(path: concat(dir, "/child.log"))
  let _gone = shell.Remove.RecursiveForce(path: dir)
  string_contains(s: log, pattern: "child stopped (observed gone)") && string_contains(s: log, pattern: concat(owned_process_exit_prefix, "137"))
}

// THE SAME LAUNCH WITH ITS PROCESS STATE UNOBSERVABLE, EXECUTED: the production launch script's exact
// bytes (gunbc.owned_process owned_process_launch_script, the string LaunchOwned hands to bash -c) run
// with one fixture fault -- a cat earlier on PATH that fails every /proc/<pid>/stat read and passes
// everything else through. An unreadable stat is not a gone child, so the launch must still escalate
// to KILL (the exit record shows status 137) and nothing the fixture started may survive. Under the
// pre-fix launch an unreadable stat ended the TERM wait and skipped KILL, leaving the TERM-ignoring
// child running while the log claimed it stopped. The fixture kills its own marked child afterwards,
// whatever the verdict.
// THE CHILD IGNORES TERM FROM BIRTH: the disposition is set on the launcher before it forks, and the
// child inherits it across exec. A child that installs the ignore itself (`sh -c "trap '' TERM; ..."`)
// is TERM-able until its shell runs the trap, and with publication failing at once the launch's TERM
// can land first -- the child then exits 143 and the 137 this claim reads is never written
// (merge-group run 37120556276, observed failed with no change touching this path).
test fn an_unreadable_process_state_never_skips_the_kill_of_an_unpublished_child() -> Bool {
  let dir = scratch_dir()
  let bin = concat(dir, "/bin")
  let _b = shell.Mkdir.Parents(path: bin as FilePath)
  let _stub = Filesystem.Write(path: concat(bin, "/cat"), content: "#!/bin/sh\ncase \"$1\" in /proc/*/stat) exit 1;; esac\nexec /bin/cat \"$@\"\n")
  let _x = shell.Exec.RunArgv(program: "chmod", arguments: ["+x", concat(bin, "/cat")])
  let pid_path = concat(dir, "/child.pid")
  let _blocker = shell.Mkdir.Parents(path: pid_path as FilePath)
  let marker = "37.0417"
  let _l = shell.Exec.RunArgv(program: "env", arguments: ["--ignore-signal=TERM", concat("PATH=", concat(bin, ":/usr/bin:/bin")), "bash", "-c", owned_process_launch_script, "owned-launch", pid_path, concat(dir, "/child.log"), owned_process_exit_prefix, owned_process_unpublished_line, owned_process_unpublished_survived_line, owned_process_unpublished_unobservable_line, "sleep", marker])
  let _w = sleep_delay_seconds_second_carrier_projection(duration: second(count: 6))
  let log = read_or_empty(path: concat(dir, "/child.log"))
  let survivor = shell.Exec.RunArgv(program: "pgrep", arguments: ["-f", concat("^sleep ", concat(marker, "$"))]).exit_code == 0
  let _clean = shell.Exec.RunArgv(program: "pkill", arguments: ["-KILL", "-f", concat("^sleep ", concat(marker, "$"))])
  let _gone = shell.Remove.RecursiveForce(path: dir)
  string_contains(s: log, pattern: concat(owned_process_exit_prefix, "137")) && !survivor
}

// THE PRODUCTION DIRECTORY SHAPE, EXECUTED: a RELATIVE observer directory (as the boot passes
// artifacts/mtcollins1-boot-kvm-<attempt>) is resolved once. The observer is launched through the real
// kvm_observer_launch_in with an unreadable credential, so it refuses before loading Playwright and
// journals that refusal; the boot reads it from the one resolved location, and no doubled
// <dir>/<dir> journal exists.
test fn a_relative_observer_directory_is_resolved_once() -> Bool {
  let made = shell.Mktemp.DirWithTemplate(template: "target/gunbc_kvmrel.XXXXXX")
  let dir = trim(s: made.path as String)
  match runner_browser_toolchain_here_wet() {
    BrowserToolchainReady { location: loc, standing: _ } => {
      let start = kvm_observer_protocol_launch(dir_given: dir, base_url: "http://127.0.0.1:9", host: "127.0.0.1:9", username: "u", password_file: "/nonexistent/credential", toolchain: loc, attempt: "rel", features_json: "")
      let refused = match start {
        KvmObserverStarted { dir: d, subject: _, standing: st, checked_at: _ } => starts_with(s: d as String, prefix: "/") && match st { KvmObserverRefused { at: _, refusal: _ } => true  _ => false }
        _ => false
      }
      let doubled = Filesystem.Read(path: concat(dir, concat("/", concat(dir, "/journal")))).success
      let _gone = shell.Remove.RecursiveForce(path: dir)
      refused && !doubled
    }
    _ => {
      let _gone = shell.Remove.RecursiveForce(path: dir)
      false
    }
  }
}

// WRONG IDENTITY, EXECUTED: a pid record whose start time does not match the live process of that pid
// is Foreign, and the release leaves it alone.
test fn a_record_naming_another_process_is_foreign_and_not_released() -> Bool {
  let dir = scratch_dir()
  let pid_path = concat(dir, "/foreign.pid")
  let _rec = Filesystem.Write(path: pid_path, content: "1 999999999999\n")
  let standing = owned_process_standing(pid_path: pid_path)
  let r = owned_process_release(pid_path: pid_path)
  let _gone = shell.Remove.RecursiveForce(path: dir)
  let foreign = match standing { OwnedForeign { pid: p, observed_start: _ } => p == "1"  _ => false }
  let untouched = match r { OwnedReleaseNotOwned { standing: _ } => true  _ => false }
  foreign && untouched
}

// RELEASE, EXECUTED AND OBSERVED: an owned process is signalled and then observed gone; a second
// release of the same record reports it already gone rather than succeeding again.
test fn an_owned_process_is_released_and_observed_gone() -> Bool {
  let dir = scratch_dir()
  let pid_path = concat(dir, "/sleeper.pid")
  let _l = gunbc.owned_process.launch.LaunchOwned(pid_path: pid_path as NonEmptyStr, log_path: concat(dir, "/sleeper.log") as NonEmptyStr, command: ["sleep", "60"])
  let _w = sleep_delay_seconds_second_carrier_projection(duration: second(count: 1))
  let running = match owned_process_standing(pid_path: pid_path) { OwnedRunning { pid: _, start_time: _ } => true  _ => false }
  let first = owned_process_release(pid_path: pid_path)
  let second_try = owned_process_release(pid_path: pid_path)
  let _gone = shell.Remove.RecursiveForce(path: dir)
  running
    && match first { OwnedReleased { pid: _ } => true  _ => false }
    && match second_try { OwnedAlreadyGone { pid: _ } => true  _ => false }
}
