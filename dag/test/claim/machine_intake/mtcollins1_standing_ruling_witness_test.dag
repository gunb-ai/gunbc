module test.claim.machine_intake.mtcollins1_standing_ruling_witness_test

import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.types { Bool, NonEmptyStr, String }
import v2.std.optional { Present, Absent }
import std.content_hash { Sha256Digest, Sha256Family, content_hash_family }
import std.effect_grant { NamespacePosition, ServiceOpTree, Write }
import std.scoped_authorization { AuthorizationRequest, AuthorizationScope, AuthorizedAction }
import gunbc.auth.approval_request_client { ApprovalPollStanding, PollApproved, PollDenied, PollNotFiled, PollStillPending }
import gunbc.auth.approval_decision_store { request_revision_of }
import gunbc.machine_intake_mtcollins1_standing_ruling {
  StandingRuling, StandingRulingSubject, mtcollins1_boot_standing_ruling, mtcollins1_boot_standing_ruling_text,
  StandingRulingDigested, StandingRulingDigestRefused, standing_ruling_digest,
  standing_ruling_request_for, standing_ruling_escalation_id, standing_ruling_refusal,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE STANDING RULING IS CONFIRMED ONLY BY THE OPERATOR'S STORED APPROVAL OF THIS EXACT RULING (review
// 70369, decision A; side-chat review 5287596716). Poll standings are supplied to the PURE refusal
// fold, which returns a reason or nothing and never a confirmation; the confirmation's only mint is
// the live read, and the skip-the-read route is refused at compile time by
// test.probe.unit_hold_proof_forged_probe. Each claim digests the rulings it compares once.

fn digest_of(r: StandingRuling) -> Sha256Digest? {
  match standing_ruling_digest(r: r) {
    StandingRulingDigested { digest: d } => Present { value: d }
    StandingRulingDigestRefused { reason: _ } => none
  }
}

fn with_text(r: StandingRuling, text: NonEmptyStr) -> StandingRuling {
  StandingRuling { text: text, effect_subject: r.effect_subject, scope: r.scope, interlock: r.interlock }
}

fn approved(q: AuthorizationRequest<StandingRulingSubject>) -> ApprovalPollStanding {
  PollApproved { revision: request_revision_of(request: q), decided_by: "operator" as NonEmptyStr, decided_at: "2026-09-23T12:00:00Z", execute_by: "2026-09-23T12:30:00Z" }
}

fn denied(q: AuthorizationRequest<StandingRulingSubject>) -> ApprovalPollStanding {
  PollDenied { revision: request_revision_of(request: q), decided_by: "operator" as NonEmptyStr, decided_at: "2026-09-23T12:00:00Z", reason: "not yet" as NonEmptyStr }
}

fn refused(r: NonEmptyStr?) -> Bool {
  match r {
    Present { value: why } => string_contains(s: why as String, pattern: "not confirmed") && string_contains(s: why as String, pattern: "controller untouched")
    Absent => false
  }
}

fn confirmed(r: NonEmptyStr?) -> Bool {
  match r {
    Present { value: _ } => false
    Absent => true
  }
}

// THE CONTROL, AND THE FAMILY: the ruling digests under SHA-256 (never the structural FNV family), the
// request's intent is that digest, the escalation id is versioned by it, and an approval of this
// request confirms it.
test fn the_ruling_is_sha256_bound_and_an_approval_of_it_confirms() -> Bool {
  match digest_of(r: mtcollins1_boot_standing_ruling) {
    Absent => false
    Present { value: d } => {
      let q = standing_ruling_request_for(r: mtcollins1_boot_standing_ruling, d: d)
      content_hash_family(hash: q.intent_hash) == Sha256Family
        && (q.escalation_id as String) == concat("mtcollins1-standing-ruling-", d.hex as String)
        && (q.purpose as String) == (mtcollins1_boot_standing_ruling_text as String)
        && confirmed(r: standing_ruling_refusal(poll: approved(q: q), request: q))
    }
  }
}

// RED: never filed, or filed and still pending -> every boot refuses.
test fn an_absent_or_pending_decision_refuses() -> Bool {
  match digest_of(r: mtcollins1_boot_standing_ruling) {
    Absent => false
    Present { value: d } => {
      let q = standing_ruling_request_for(r: mtcollins1_boot_standing_ruling, d: d)
      refused(r: standing_ruling_refusal(poll: PollNotFiled, request: q))
        && refused(r: standing_ruling_refusal(poll: PollStillPending, request: q))
    }
  }
}

// RED: approval for A, source at B (a one-character edit). A's approval cannot confirm B, and B has a
// different digest and so a different escalation id -- a fresh slot it can be filed into.
test fn an_approval_of_ruling_a_cannot_confirm_ruling_b_and_b_is_fileable_fresh() -> Bool {
  let b = with_text(r: mtcollins1_boot_standing_ruling, text: concat(mtcollins1_boot_standing_ruling_text as String, "!") as NonEmptyStr)
  match digest_of(r: mtcollins1_boot_standing_ruling) {
    Absent => false
    Present { value: da } =>
      match digest_of(r: b) {
        Absent => false
        Present { value: db } => {
          let qa = standing_ruling_request_for(r: mtcollins1_boot_standing_ruling, d: da)
          let qb = standing_ruling_request_for(r: b, d: db)
          refused(r: standing_ruling_refusal(poll: approved(q: qa), request: qb))
            && (da.hex as String) != (db.hex as String)
            && (qa.escalation_id as String) != (qb.escalation_id as String)
        }
      }
  }
}

// RED: A denied, then revised to B. The denial does not bind B, and B has its own escalation id, so
// the revision is independently fileable rather than blocked behind A's decided slot.
test fn a_denied_ruling_leaves_its_revision_independently_fileable() -> Bool {
  let b = with_text(r: mtcollins1_boot_standing_ruling, text: concat(mtcollins1_boot_standing_ruling_text as String, " Revised.") as NonEmptyStr)
  match digest_of(r: mtcollins1_boot_standing_ruling) {
    Absent => false
    Present { value: da } =>
      match digest_of(r: b) {
        Absent => false
        Present { value: db } => {
          let qa = standing_ruling_request_for(r: mtcollins1_boot_standing_ruling, d: da)
          let qb = standing_ruling_request_for(r: b, d: db)
          refused(r: standing_ruling_refusal(poll: denied(q: qa), request: qa))
            && (qa.escalation_id as String) != (qb.escalation_id as String)
            && confirmed(r: standing_ruling_refusal(poll: approved(q: qb), request: qb))
        }
      }
  }
}

// THE PREIMAGE COVERS THE SCOPE AND THE INTERLOCK, not just the words: changing either is a different
// ruling.
test fn a_scope_or_interlock_change_changes_the_digest() -> Bool {
  let r = mtcollins1_boot_standing_ruling
  let other_scope = StandingRuling {
    text: r.text, effect_subject: r.effect_subject, interlock: r.interlock,
    scope: AuthorizationScope { verb: Write, resource: NamespacePosition { tree: ServiceOpTree { service: "gunbc-standing-ruling" }, path: ["mtcollins1", "boot"] }, action: "gunbc.standing-ruling.other" as AuthorizedAction },
  }
  let other_interlock = StandingRuling { text: r.text, effect_subject: r.effect_subject, scope: r.scope, interlock: "gunbc.some_other_hold::key" as NonEmptyStr }
  match digest_of(r: r) {
    Absent => false
    Present { value: d } =>
      match digest_of(r: other_scope) {
        Absent => false
        Present { value: ds } =>
          match digest_of(r: other_interlock) {
            Absent => false
            Present { value: di } => (d.hex as String) != (ds.hex as String) && (d.hex as String) != (di.hex as String)
          }
      }
  }
}
