module test.claim.machine_intake.mtcollins1_standing_ruling_witness_test

import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.types { Bool, List, NonEmptyStr, String }
import v2.std.optional { Present, Absent }
import std.content_hash { Sha256Digest, Sha256Family, content_hash_family, sha256_hex_digest }
import std.decl_ref { DeclarationRef, decl_ref }
import std.effect_grant { NamespacePosition, ServiceOpTree, UriTree, Read, Write }
import std.scoped_authorization { AuthorizationRequest, AuthorizationScope, AuthorizedAction }
import gunbc.auth.approval_request_client { ApprovalPollStanding, PollApproved, PollDenied, PollNotFiled, PollStillPending }
import gunbc.auth.approval_decision_store { request_revision_of }
import gunbc.machine_intake_mtcollins1_standing_ruling {
  StandingRuling, StandingRulingSubject, mtcollins1_boot_standing_ruling, mtcollins1_boot_standing_ruling_text,
  standing_ruling_preimage,
  standing_ruling_request_for, standing_ruling_refusal,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE STANDING RULING IS CONFIRMED ONLY BY THE OPERATOR'S STORED APPROVAL OF THIS EXACT RULING (review
// 70369, decision A; side-chat reviews 5287596716, 5288466573). Poll standings are supplied to the
// PURE refusal fold, which returns a reason or nothing and never a confirmation; the confirmation's only
// mint is the live read (the skip-the-read route is refused at compile time by
// test.probe.unit_hold_proof_forged_probe). Structural controls compare the injective ENCODING, from
// which the digest is a function; request claims take SUPPLIED digests (see `supplied`).

fn r0() -> StandingRuling {
  mtcollins1_boot_standing_ruling
}

fn with_text(r: StandingRuling, text: NonEmptyStr) -> StandingRuling {
  StandingRuling { text: text, effect_subject: r.effect_subject, roots: r.roots, scope: r.scope, interlock: r.interlock }
}

fn with_scope(r: StandingRuling, scope: AuthorizationScope) -> StandingRuling {
  StandingRuling { text: r.text, effect_subject: r.effect_subject, roots: r.roots, scope: scope, interlock: r.interlock }
}

fn boot_only(r: StandingRuling) -> StandingRuling {
  StandingRuling { text: r.text, effect_subject: r.effect_subject, roots: [decl_ref(module_path: "gunbc.machine_intake_mtcollins1_boot_run", decl_name: "mtcollins1_boot_wet")], scope: r.scope, interlock: r.interlock }
}

// SUPPLIED DIGESTS (DESIGN §3, a witness discriminates at one interface). The interpreter's pure
// SHA-256 costs on the order of 100k eval steps per 64-byte block, so digesting the real ruling
// (about 21 blocks) inside a claim measured 4.2M-5.5M steps against the 72.3k new-witness budget.
// These claims are about the REQUEST built from a digest and about the ENCODING the digest is taken
// over; the SHA-256 primitive's own evidence is test.claim.sha256_fips_witness_test (FIPS 180-4
// vectors), and the real composition runs on every standing-ruling read and filing.
fn supplied(hex: String) -> Sha256Digest? {
  sha256_hex_digest(hex: hex)
}

fn digest_a() -> Sha256Digest? {
  supplied(hex: "a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90")
}

fn digest_b() -> Sha256Digest? {
  supplied(hex: "0f1e2d3c4b5a69788796a5b4c3d2e1f00f1e2d3c4b5a69788796a5b4c3d2e1f0")
}

fn approved(q: AuthorizationRequest<StandingRulingSubject>) -> ApprovalPollStanding {
  PollApproved { revision: request_revision_of(request: q), decided_by: "operator" as NonEmptyStr, decided_at: "2026-09-23T12:00:00Z", execute_by: "2026-09-23T12:30:00Z" }
}

fn denied(q: AuthorizationRequest<StandingRulingSubject>) -> ApprovalPollStanding {
  PollDenied { revision: request_revision_of(request: q), decided_by: "operator" as NonEmptyStr, decided_at: "2026-09-23T12:00:00Z", reason: "not yet" as NonEmptyStr }
}

fn refused(r: NonEmptyStr?) -> Bool {
  match r {
    Present { value: why } => string_contains(s: why as String, pattern: "not confirmed") && string_contains(s: why as String, pattern: "controller untouched")
    Absent => false
  }
}

fn confirmed(r: NonEmptyStr?) -> Bool {
  match r {
    Present { value: _ } => false
    Absent => true
  }
}

fn encoding_differs(a: StandingRuling, b: StandingRuling) -> Bool {
  standing_ruling_preimage(r: a) != standing_ruling_preimage(r: b)
}

// THE CONTROL: SHA-256 (never FNV) over the encoding is the intent and the id suffix; the purpose the
// operator reads is the ruling text; an approval of this request confirms it, and absent, pending or
// denied refuses.
test fn the_ruling_is_sha256_bound_and_only_its_own_approval_confirms_it() -> Bool {
  match digest_a() {
    Absent => false
    Present { value: d } => {
      let q = standing_ruling_request_for(r: r0(), d: d)
      content_hash_family(hash: q.intent_hash) == Sha256Family
        && (q.escalation_id as String) == concat("mtcollins1-standing-ruling-", d.hex as String)
        && (q.purpose as String) == (mtcollins1_boot_standing_ruling_text as String)
        && confirmed(r: standing_ruling_refusal(poll: approved(q: q), request: q))
        && refused(r: standing_ruling_refusal(poll: PollNotFiled, request: q))
        && refused(r: standing_ruling_refusal(poll: PollStillPending, request: q))
        && refused(r: standing_ruling_refusal(poll: denied(q: q), request: q))
    }
  }
}

// RED: a boot-only ruling (one root) is a different ruling -- a different encoding, hence a different
// SHA-256 -- and a request under a different digest has a different escalation id, whose approval
// cannot confirm the ruling that also covers host_reset_return.
test fn a_boot_only_approval_cannot_confirm_the_two_root_ruling_and_the_id_moves() -> Bool {
  encoding_differs(a: r0(), b: boot_only(r: r0())) && match digest_a() {
    Absent => false
    Present { value: d } =>
      match digest_b() {
        Absent => false
        Present { value: db } => {
          let q = standing_ruling_request_for(r: r0(), d: d)
          let qb = standing_ruling_request_for(r: boot_only(r: r0()), d: db)
          refused(r: standing_ruling_refusal(poll: approved(q: qb), request: q))
            && (qb.escalation_id as String) != (q.escalation_id as String)
            && confirmed(r: standing_ruling_refusal(poll: approved(q: qb), request: qb))
        }
      }
  }
}

// THE ENCODING COVERS THE WHOLE SCOPE, not only the action: the same action under another verb, another
// resource tree, another service or another path segment is a different encoding.
test fn every_scope_component_is_encoded() -> Bool {
  let s = r0().scope
  encoding_differs(a: r0(), b: with_scope(r: r0(), scope: AuthorizationScope { verb: Read, resource: s.resource, action: s.action }))
    && encoding_differs(a: r0(), b: with_scope(r: r0(), scope: AuthorizationScope { verb: s.verb, resource: NamespacePosition { tree: UriTree, path: s.resource.path }, action: s.action }))
    && encoding_differs(a: r0(), b: with_scope(r: r0(), scope: AuthorizationScope { verb: s.verb, resource: NamespacePosition { tree: ServiceOpTree { service: "other" }, path: s.resource.path }, action: s.action }))
    && encoding_differs(a: r0(), b: with_scope(r: r0(), scope: AuthorizationScope { verb: s.verb, resource: NamespacePosition { tree: s.resource.tree, path: ["mtcollins1", "bmc", "other"] }, action: s.action }))
    && encoding_differs(a: r0(), b: with_scope(r: r0(), scope: AuthorizationScope { verb: s.verb, resource: NamespacePosition { tree: s.resource.tree, path: ["mtcollins1", "bmc"] }, action: s.action }))
    && encoding_differs(a: r0(), b: StandingRuling { text: r0().text, effect_subject: r0().effect_subject, roots: r0().roots, scope: s, interlock: decl_ref(module_path: "gunbc.machine_intake_mtcollins1_maintenance_hold", decl_name: "mtcollins1_unit_hold_store_host") })
}

// THE ENCODING IS INJECTIVE AT FIELD BOUNDARIES: moving a separator-looking run from one field into the
// next -- text 'T\neffect=E1' with effect 'E2' against text 'T' with effect 'E1\neffect=E2', and the
// same across path segments -- cannot reproduce an encoding, because each value carries its length.
test fn separator_redistribution_between_fields_does_not_collide() -> Bool {
  let a = StandingRuling { text: "T\neffect=E1" as NonEmptyStr, effect_subject: "E2" as NonEmptyStr, roots: r0().roots, scope: r0().scope, interlock: r0().interlock }
  let b = StandingRuling { text: "T" as NonEmptyStr, effect_subject: "E1\neffect=E2" as NonEmptyStr, roots: r0().roots, scope: r0().scope, interlock: r0().interlock }
  let pa = with_scope(r: r0(), scope: AuthorizationScope { verb: Write, resource: NamespacePosition { tree: r0().scope.resource.tree, path: ["a;path:1:b", "c"] }, action: r0().scope.action })
  let pb = with_scope(r: r0(), scope: AuthorizationScope { verb: Write, resource: NamespacePosition { tree: r0().scope.resource.tree, path: ["a", "b;path:1:c"] }, action: r0().scope.action })
  encoding_differs(a: a, b: b) && encoding_differs(a: pa, b: pb)
}

// CANONICAL: one ruling has one byte form -- the value re-assembled field by field encodes identically.
test fn a_reassembled_ruling_encodes_to_the_same_bytes() -> Bool {
  let r = r0()
  let again = StandingRuling { text: r.text, effect_subject: r.effect_subject, roots: r.roots, scope: AuthorizationScope { verb: r.scope.verb, resource: NamespacePosition { tree: r.scope.resource.tree, path: r.scope.resource.path }, action: r.scope.action }, interlock: r.interlock }
  standing_ruling_preimage(r: r) == standing_ruling_preimage(r: again)
    && encoding_differs(a: r, b: with_text(r: r, text: concat(r.text as String, "!") as NonEmptyStr))
}
