  StepInstanceKey, ConvergenceRunId, StepSubjectKey, step_instance_key,
  LegCompletedWithin, LegDeadlineElapsed, LegFinishedBeforeItStarted, LegCompletionUnobserved,
  leg_budget, effect_leg_deadline, complete_effect_leg,
}
