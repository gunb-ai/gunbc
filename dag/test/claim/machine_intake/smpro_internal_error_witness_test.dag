module test.claim.machine_intake.smpro_internal_error_witness_test

import v2.std.algebra { any, contains }
import std.types { Bool, Int, List, NonEmptyStr, String }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.optional { Present }
import extdeps.ampere.smpro_internal_error {
  SmproInternalRecord, SmproNamedCode, SmproCodeDefined, SmproCodeUndefined,
  SmproRecordKind, SmproErrorWithData, SmproErrorWithoutData, SmproWarning, SmproEnter, SmproExit,
  smpro_internal_error_of, smpro_internal_warning_of, smpro_internal_record_text,
}
import extdeps.ampere.smpro_register {
  SmproRegister, smpro_manufacturer_id_reg, smpro_err_pmpro_type_reg, smpro_err_pmpro_info_lo_reg, smpro_err_pmpro_info_hi_reg,
  smpro_err_pmpro_data_lo_reg, smpro_err_pmpro_data_hi_reg, smpro_warn_pmpro_info_lo_reg, smpro_warn_pmpro_info_hi_reg,
}
import gunbc.machine_intake_mtcollins1_smpro_error_reading {
  SmproErrorWindow, SmproWindowPmproError, PmproErrorDecoded, PmproErrorWordsMissing,
  mtcollins1_smpro_error_windows, mtcollins1_smpro_error_reads_20261003,
}
import gunbc.machine_intake_mtcollins1_smpro_observation {
  SmproProbeRaw, SmproProbeOutcome, smpro_probe_outcome, mtcollins1_smpro_findings, mtcollins1_smpro_dossier_text,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// ── field predicates ────────────────────────────────────────────────────────────────────────────

fn named(c: SmproNamedCode, code: Int, name: String) -> Bool {
  match c { SmproCodeDefined { code: n, name: s } => n == code && (s as String) == name SmproCodeUndefined { code: _ } => false }
}

fn undefined(c: SmproNamedCode, code: Int) -> Bool {
  match c { SmproCodeUndefined { code: n } => n == code SmproCodeDefined { code: _, name: _ } => false }
}

fn is_enter(r: SmproInternalRecord) -> Bool {
  match r.direction { SmproEnter => true SmproExit => false }
}

// The record the 2026-10-03 capture carries: CCIX RCA link-up failure during CCIX initialization.
fn is_ccix_rca_linkup_fail(r: SmproInternalRecord) -> Bool {
  named(c: r.error, code: 116, name: "ERR_CCIX_RCA_LINKUP_FAIL")
    && named(c: r.location, code: 68, name: "CCIX initialization")
    && named(c: r.image, code: 2, name: "Executing ROM normal (non-secure) boot path")
    && is_enter(r: r)
}

fn kind_is_with_data(r: SmproInternalRecord) -> Bool {
  match r.kind { SmproErrorWithData => true SmproErrorWithoutData => false SmproWarning => false }
}

fn kind_is_without_data(r: SmproInternalRecord) -> Bool {
  match r.kind { SmproErrorWithoutData => true SmproErrorWithData => false SmproWarning => false }
}

// ── the decoder over supplied words ─────────────────────────────────────────────────────────────

test fn type_bit_two_with_info_2244_0074_is_the_ccix_rca_linkup_failure() -> Bool {
  match smpro_internal_error_of(type_word: 4, info_hi: 8772, info_lo: 116, data_hi: 0, data_lo: 0) {
    Present { value: r } => is_ccix_rca_linkup_fail(r: r) && kind_is_with_data(r: r) && r.info_hi_unparsed_bits == 2
    Absent => false
  }
}

test fn a_type_with_no_error_bit_is_no_record() -> Bool {
  match smpro_internal_error_of(type_word: 0, info_hi: 8772, info_lo: 116, data_hi: 0, data_lo: 0) { Present { value: _ } => false Absent => true }
    && (match smpro_internal_error_of(type_word: 1, info_hi: 8772, info_lo: 116, data_hi: 0, data_lo: 0) { Present { value: _ } => false Absent => true })
}

// BIT(1) is taken before BIT(2), exactly as smpro_internal_err_read tests them.
test fn bit_one_is_taken_before_bit_two() -> Bool {
  match smpro_internal_error_of(type_word: 6, info_hi: 8772, info_lo: 116, data_hi: 7, data_lo: 9) {
    Present { value: r } => kind_is_without_data(r: r) && r.data_hi == 0 && r.data_lo == 0
    Absent => false
  }
}

test fn bit_eleven_is_exit() -> Bool {
  match smpro_internal_error_of(type_word: 2, info_hi: 8772 + 2048, info_lo: 116, data_hi: 0, data_lo: 0) {
    Present { value: r } => match r.direction { SmproExit => true SmproEnter => false }
    Absent => false
  }
}

test fn a_warning_reads_its_own_words() -> Bool {
  match smpro_internal_warning_of(type_word: 1, warn_hi: 8772, warn_lo: 116) {
    Present { value: r } => is_ccix_rca_linkup_fail(r: r) && (match r.kind { SmproWarning => true SmproErrorWithData => false SmproErrorWithoutData => false })
    Absent => false
  }
}

// ── RED: an unlisted code is its number, never the nearest name ────────────────────────────────

// INFO_HI 0xA099: image nibble 10 (the table ends at 9), location 0x99 = 153 (it ends at 77);
// INFO_LO 146 (it ends at 145).
test fn red_an_unlisted_location_error_and_image_are_undefined() -> Bool {
  match smpro_internal_error_of(type_word: 2, info_hi: 41113, info_lo: 146, data_hi: 0, data_lo: 0) {
    Present { value: r } => undefined(c: r.image, code: 10) && undefined(c: r.location, code: 153) && undefined(c: r.error, code: 146)
      && contains(smpro_internal_record_text(r: r), "code 146 (no row in internalErrors.hpp)")
    Absent => false
  }
}

test fn the_last_listed_codes_are_still_defined() -> Bool {
  match smpro_internal_error_of(type_word: 2, info_hi: 36941, info_lo: 145, data_hi: 0, data_lo: 0) {
    Present { value: r } => named(c: r.image, code: 9, name: "All others") && named(c: r.location, code: 77, name: "BMC module") && named(c: r.error, code: 145, name: "ERR_DDR_TRAINING_FAILED")
    Absent => false
  }
}

// ── RED: a misplaced field shift reads a different record ──────────────────────────────────────

// Reading INFO_HI with its bytes swapped (location from the HIGH byte -- the 0x22/0x44 misreading)
// lands on location 34, a different named location, and is not the CCIX record.
test fn red_location_from_the_high_byte_is_a_different_record() -> Bool {
  match smpro_internal_error_of(type_word: 4, info_hi: 17442, info_lo: 116, data_hi: 0, data_lo: 0) {
    Present { value: r } => !is_ccix_rca_linkup_fail(r: r) && named(c: r.location, code: 34, name: "PCP CPM initialization")
    Absent => false
  }
}

// Swapping INFO_HI and INFO_LO puts both fields past their tables.
test fn red_info_hi_and_lo_swapped_is_undefined() -> Bool {
  match smpro_internal_error_of(type_word: 4, info_hi: 116, info_lo: 8772, data_hi: 0, data_lo: 0) {
    Present { value: r } => !is_ccix_rca_linkup_fail(r: r) && undefined(c: r.location, code: 116) && undefined(c: r.error, code: 8772)
    Absent => false
  }
}

// ── the real capture (gunbc.machine_intake_mtcollins1_smpro_error_reading), decoded ─────────────

fn window_at(n: Int) -> SmproErrorWindow? {
  mtcollins1_smpro_error_windows(reads: mtcollins1_smpro_error_reads_20261003).skip(n: n).first()
}

fn window_record(n: Int) -> SmproInternalRecord? {
  match window_at(n: n) {
    Absent => none
    Present { value: w } => match w.pmpro_error { PmproErrorDecoded { record: r } => r PmproErrorWordsMissing { missing: _ } => none }
  }
}

fn window_decoded_empty(n: Int) -> Bool {
  match window_at(n: n) {
    Absent => false
    Present { value: w } => match w.pmpro_error { PmproErrorDecoded { record: Absent } => true _ => false }
  }
}

fn window_socket(n: Int) -> Int {
  match window_at(n: n) { Present { value: w } => match w.socket { Present { value: s } => s Absent => 0 - 1 } Absent => 0 - 2 }
}

fn window_gpi(n: Int) -> Int {
  match window_at(n: n) { Present { value: w } => match w.gpi_ras_err { Present { value: g } => g Absent => 0 - 1 } Absent => 0 - 2 }
}

// This is the inhabitance claim: the real bytes reach the real decoder through the real windowing.
test fn the_capture_is_five_windows_in_socket_order_0_0_1_0_1() -> Bool {
  count(mtcollins1_smpro_error_windows(reads: mtcollins1_smpro_error_reads_20261003)) == 5
    && window_socket(n: 0) == 0 && window_socket(n: 1) == 0 && window_socket(n: 2) == 1 && window_socket(n: 3) == 0 && window_socket(n: 4) == 1
}

test fn window_zero_socket_zero_reports_the_ccix_failure_with_data() -> Bool {
  window_gpi(n: 0) == 2 && match window_record(n: 0) { Present { value: r } => is_ccix_rca_linkup_fail(r: r) && kind_is_with_data(r: r) Absent => false }
}

test fn window_one_socket_zero_has_no_record_so_it_is_not_sticky() -> Bool {
  window_gpi(n: 1) == 0 && window_decoded_empty(n: 1)
}

test fn socket_one_reports_the_same_failure_without_data_in_both_windows() -> Bool {
  (match window_record(n: 2) { Present { value: r } => is_ccix_rca_linkup_fail(r: r) && kind_is_without_data(r: r) Absent => false })
    && (match window_record(n: 4) { Present { value: r } => is_ccix_rca_linkup_fail(r: r) && kind_is_without_data(r: r) Absent => false })
    && window_gpi(n: 2) == 0 - 1
}

// GPI_RAS_ERR says PMpro pending while TYPE is already clear: carried as read, not reconciled.
test fn window_three_pending_bit_with_a_clear_type_is_no_record() -> Bool {
  window_gpi(n: 3) == 2 && window_decoded_empty(n: 3)
}

// ── the collector renders a decoded record as a finding (supplied outcomes) ────────────────────

fn read_ok(socket: Int, reg: SmproRegister, stdout: String) -> SmproProbeOutcome {
  smpro_probe_outcome(raw: SmproProbeRaw { sequence: 0, socket: socket, register: reg.name, request: "r", at: "t", exit_code: 0, stdout: stdout, stderr: "" })
}

fn pmpro_words(socket: Int, info_hi: String) -> List<SmproProbeOutcome> {
  [
    read_ok(socket: socket, reg: smpro_manufacturer_id_reg, stdout: "cd 3a"),
    read_ok(socket: socket, reg: smpro_err_pmpro_type_reg, stdout: "00 02"),
    read_ok(socket: socket, reg: smpro_err_pmpro_info_lo_reg, stdout: "00 74"),
    read_ok(socket: socket, reg: smpro_err_pmpro_info_hi_reg, stdout: info_hi),
    read_ok(socket: socket, reg: smpro_err_pmpro_data_lo_reg, stdout: "00 00"),
    read_ok(socket: socket, reg: smpro_err_pmpro_data_hi_reg, stdout: "00 00"),
    read_ok(socket: socket, reg: smpro_warn_pmpro_info_lo_reg, stdout: "00 00"),
    read_ok(socket: socket, reg: smpro_warn_pmpro_info_hi_reg, stdout: "00 00"),
  ]
}

test fn a_read_pmpro_record_is_a_finding_naming_the_decode() -> Bool {
  let f = mtcollins1_smpro_findings(outcomes: pmpro_words(socket: 1, info_hi: "22 44"))
  any(f, x => starts_with(s: x, prefix: "SMpro socket 1: PMpro error: ERR_CCIX_RCA_LINKUP_FAIL (116) at CCIX initialization (68), ENTER"))
}

test fn red_a_missing_info_word_decodes_nothing_and_says_why() -> Bool {
  let os = pmpro_words(socket: 1, info_hi: "22 44")
  let without_hi = concat(os.take(n: 3), os.skip(n: 4))
  !any(mtcollins1_smpro_findings(outcomes: without_hi), x => contains(x, "ERR_CCIX"))
    && contains(mtcollins1_smpro_dossier_text(outcomes: without_hi), "SMpro socket 1: PMpro records UNAVAILABLE (ERR_PMPRO_INFO_HI was not probed)")
}
