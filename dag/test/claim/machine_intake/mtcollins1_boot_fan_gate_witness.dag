// SUPPLIED ROUNDS at the verdict and outcome boundaries. The effectful route (settle, read, write-before-stop,
// PowerDown, readback, one repeat, step-summary append) is the live boot step. The gate-to-boot decision is paired in
// mtcollins1_boot_run_witness (fan_gate_continuation: admitted, refused and unreached controls); the live effectful
// route is exercised only by a real boot, and no control here claims it. The unit's set is the OperatorAssumed row mtcollins1_fitted_fan_set.
data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

fn row(name: NonEmptyStr, reading: NonEmptyStr) -> SdrTypeLine {
  SdrTypeLine { name: name, sensor_number: "0x00" as NonEmptyStr, status: "ok" as NonEmptyStr, entity_id: "29.1" as NonEmptyStr, reading_text: reading }
}

fn published() -> ThermalObservation { ThermalRead { publication: TemperaturePublished, undecoded_texts: [], unrecognised_readings: [] } }

fn round(on: Bool, lines: List<SdrTypeLine>) -> FanObservationRound {
  FanObservationRound { observed_at: "2026-10-17T00:00:00Z" as NonEmptyStr, round_index: 0, chassis: ChassisPowerRead { power_on: on }, chassis_raw: "", thermal: published(), fans: FanSensorsRead { lines: lines, undecoded_lines: [], failure_rows: [] }, verbose: SdrVerboseNotRequired }
}



fn established(round: FanObservationRound) -> Bool {
  match post_power_fan_verdict(fitted: mtcollins1_fitted_fan_set, chassis: round.chassis, thermal: round.thermal, fans: round.fans, typing: Absent) { PostPowerFanVerdictEstablished => true  PostPowerFanVerdictRefused { cause: _ } => false }
}

fn unit_rows(fan5_1: NonEmptyStr) -> List<SdrTypeLine> {
  [row(name: "FAN4_0_Speed" as NonEmptyStr, reading: "5700 RPM" as NonEmptyStr), row(name: "FAN4_1_Speed" as NonEmptyStr, reading: "5700 RPM" as NonEmptyStr), row(name: "FAN5_0_Speed" as NonEmptyStr, reading: "5700 RPM" as NonEmptyStr), row(name: "FAN5_1_Speed" as NonEmptyStr, reading: fan5_1), row(name: "FAN0_0_Speed" as NonEmptyStr, reading: "No Reading" as NonEmptyStr), row(name: "FAN3_1_Speed" as NonEmptyStr, reading: "No Reading" as NonEmptyStr)]
}


test fn the_unit_fitted_set_is_established_on_the_observed_reading() -> Bool {
  established(round: round(on: true, lines: unit_rows(fan5_1: "5800 RPM" as NonEmptyStr)))
}

test fn the_unit_fitted_set_refuses_when_one_fitted_rotor_reads_zero() -> Bool {
  established(round: round(on: true, lines: unit_rows(fan5_1: "0 RPM" as NonEmptyStr))) == false
}

test fn an_off_chassis_refuses_even_with_the_unit_fans_listed() -> Bool {
  established(round: round(on: false, lines: unit_rows(fan5_1: "5800 RPM" as NonEmptyStr))) == false
}

// FULL-PATH REPLAY OF REAL RAW STDOUT: the committed `sdr elist` of this controller (powered, artifacts/bmc/mtcollins1-32dimm/06-sdr.txt)
// goes through sdr_decode_lines, fan_observation, FanObservationRound and the gate; no list is constructed here. In that real text every
// FANn_Failure line has an EMPTY reading cell (status ok), which the SDR decoder leaves unstructured; the fan layer reads it structurally
// as NOT-asserted and admits it. The ASSERTED spelling is not in any committed text, so a Failure row that is not (empty reading, ok) or
// (reading `No Reading`, the host-off capture of run 39053311400) refuses with its own arm.
fn raw_stdout() -> String {
  Filesystem.Read(path: "artifacts/bmc/mtcollins1-32dimm/06-sdr.txt").content
}

fn replay_round(stdout: String) -> FanObservationRound {
  FanObservationRound { observed_at: "2026-10-17T00:00:00Z" as NonEmptyStr, round_index: 0, chassis: ChassisPowerRead { power_on: true }, chassis_raw: "", thermal: published(), fans: fan_observation(success: true, results: sdr_decode_lines(stdout: stdout)), verbose: SdrVerboseNotRequired }
}

fn verdict_of(stdout: String) -> PostPowerFanVerdict {
  post_power_fan_verdict(fitted: mtcollins1_fitted_fan_set, chassis: ChassisPowerRead { power_on: true }, thermal: published(), fans: replay_round(stdout: stdout).fans, typing: Absent)
}

fn undecoded_of(stdout: String) -> List<String> {
  match verdict_of(stdout: stdout) {
    PostPowerFanVerdictRefused { cause: FanRowsUndecoded { texts: t } } => t
    _ => []
  }
}

fn not_nominal_text(stdout: String) -> String {
  match verdict_of(stdout: stdout) {
    PostPowerFanVerdictRefused { cause: FanFailureSensorNotNominal { text: t } } => t
    _ => ""
  }
}

fn no_reading_text(stdout: String) -> String {
  match verdict_of(stdout: stdout) {
    PostPowerFanVerdictRefused { cause: FanFailureSensorNoReading { text: t } } => t
    _ => ""
  }
}

// the controller's fan rows, Failure rows included (the other empty-reading discrete rows of the whole elist are other sensors' business)
fn fan_rows(stdout: String) -> String {
  join(filter(split(s: stdout, delimiter: "\n"), l => string_contains(s: l, pattern: "FAN") && string_contains(s: l, pattern: "PSU") == false), "\n")
}

fn read_whole() -> Bool { raw_stdout().length() > 1000 }

// POSITIVE CONTROL: the real fan rows, Failure rows with their empty reading cell included, decode whole, the four fitted fans spin, the gate admits.
test fn the_real_stdout_fan_rows_with_empty_reading_failure_rows_are_established() -> Bool {
  read_whole() && string_contains(s: fan_rows(stdout: raw_stdout()), pattern: "FAN4_Failure")
    && undecoded_of(stdout: fan_rows(stdout: raw_stdout())).length() == 0
    && established(round: replay_round(stdout: fan_rows(stdout: raw_stdout())))
}

// RED: the host-off shape (run 39053311400, `ns` / `No Reading`) is a sensor not reporting while the chassis is on: it refuses with its own arm.
test fn a_failure_row_reading_no_reading_while_powered_refuses_with_its_own_arm() -> Bool {
  let s = join(split(s: fan_rows(stdout: raw_stdout()), delimiter: "FAN4_Failure     | 1Bh | ok  | 29.0 | "), "FAN4_Failure     | 1Bh | ns  | 29.0 | No Reading")
  read_whole() && s != fan_rows(stdout: raw_stdout()) && established(round: replay_round(stdout: s)) == false
    && string_contains(s: no_reading_text(stdout: s), pattern: "FAN4_Failure")
}

// RED: the no-reading sort is the upstream's, not a literal: `Disabled` on a powered Failure row is also a sensor not reporting.
test fn a_failure_row_reading_disabled_while_powered_refuses_as_no_reading() -> Bool {
  let s = join(split(s: fan_rows(stdout: raw_stdout()), delimiter: "FAN4_Failure     | 1Bh | ok  | 29.0 | "), "FAN4_Failure     | 1Bh | ns  | 29.0 | Disabled")
  read_whole() && s != fan_rows(stdout: raw_stdout()) && established(round: replay_round(stdout: s)) == false
    && string_contains(s: no_reading_text(stdout: s), pattern: "FAN4_Failure")
}

// RED: an asserted failure (any status but ok on an empty reading) refuses with its own arm, carrying the row text.
test fn an_asserted_failure_row_refuses_with_its_own_arm() -> Bool {
  let s = join(split(s: fan_rows(stdout: raw_stdout()), delimiter: "FAN4_Failure     | 1Bh | ok  | 29.0 | "), "FAN4_Failure     | 1Bh | cr  | 29.0 | ")
  read_whole() && s != fan_rows(stdout: raw_stdout()) && established(round: replay_round(stdout: s)) == false
    && string_contains(s: not_nominal_text(stdout: s), pattern: "FAN4_Failure")
}

// RED: `No Reading` under any status refuses while powered.
test fn a_failure_row_reading_no_reading_under_another_status_refuses() -> Bool {
  let s = join(split(s: fan_rows(stdout: raw_stdout()), delimiter: "FAN4_Failure     | 1Bh | ok  | 29.0 | "), "FAN4_Failure     | 1Bh | cr  | 29.0 | No Reading")
  read_whole() && s != fan_rows(stdout: raw_stdout()) && established(round: replay_round(stdout: s)) == false
    && string_contains(s: no_reading_text(stdout: s), pattern: "FAN4_Failure")
}

// RED: a structured Failure row whose reading is anything but `No Reading` refuses with the same arm.
test fn a_structured_failure_row_with_another_reading_refuses() -> Bool {
  let s = join(split(s: fan_rows(stdout: raw_stdout()), delimiter: "FAN4_Failure     | 1Bh | ok  | 29.0 | "), "FAN4_Failure     | 1Bh | ok  | 29.0 | Asserted")
  read_whole() && s != fan_rows(stdout: raw_stdout()) && established(round: replay_round(stdout: s)) == false
    && string_contains(s: not_nominal_text(stdout: s), pattern: "Asserted")
}

// RED: the whole elist still carries other unstructured rows (CPU0_Hightemp and others); each refuses, carrying its text.
test fn the_whole_real_elist_still_refuses_on_its_other_unstructured_rows_carrying_each_text() -> Bool {
  let t = undecoded_of(stdout: raw_stdout())
  read_whole() && t.length() > 0 && any(t, x => string_contains(s: x, pattern: "CPU0_Hightemp")) && any(t, x => string_contains(s: x, pattern: "_Failure")) == false
}

test fn the_refusal_text_and_pre_stop_artifact_carry_each_undecoded_line() -> Bool {
  let r = replay_round(stdout: raw_stdout())
  let c = FanRowsUndecoded { texts: undecoded_of(stdout: raw_stdout()) }
  let pre = post_power_fan_gate_pre_stop_text(fitted: mtcollins1_fitted_fan_set, cause: c, observation: r, manager: FanManagerUnread { read_obligation: "fixture obligation" as NonEmptyStr })
  read_whole() && string_contains(s: pre, pattern: "fan_undecoded_line=[CPU0_Hightemp") && string_contains(s: pre, pattern: "fan_failure_row=[FAN4_Failure") && string_contains(s: post_power_fan_refusal_text(cause: c), pattern: "CPU0_Hightemp")
}

// RED: one changed unstructured line still refuses.
test fn one_changed_unstructured_line_still_refuses() -> Bool {
  let s = join(split(s: fan_rows(stdout: raw_stdout()), delimiter: "FAN0_Presence    | 0Fh | ok  | 29.0 | Device Present"), "FAN0_Presence    | 0Fh | ok  | 29.0")
  read_whole() && s != fan_rows(stdout: raw_stdout()) && established(round: replay_round(stdout: s)) == false && any(undecoded_of(stdout: s), x => string_contains(s: x, pattern: "FAN0_Presence"))
}

// RED: one added unstructured line still refuses.
test fn one_added_unstructured_line_still_refuses() -> Bool {
  let s = join([fan_rows(stdout: raw_stdout()), "\nFAN9_Presence    | 99h | cr  | 29.0 | "], "")
  read_whole() && established(round: replay_round(stdout: s)) == false && any(undecoded_of(stdout: s), x => string_contains(s: x, pattern: "FAN9_Presence"))
}

fn off() -> ChassisPowerObservation { ChassisPowerRead { power_on: false } }
fn still_on() -> ChassisPowerObservation { ChassisPowerRead { power_on: true } }

fn refused_outcome(stop: FanGateSafeStopReceipt) -> PostPowerFanGateOutcome {
  PostPowerFanRefused {
    cause: FittedHeaderZeroRpm { header: "FAN4_0_Speed" as NonEmptyStr },
    observation: round(on: true, lines: unit_rows(fan5_1: "0 RPM" as NonEmptyStr)),
    stop: stop,
    manager: FanManagerUnread { read_obligation: "fixture obligation" as NonEmptyStr },
    evidence: FanGateEvidence { observation_file: FanGateWritten { path: "artifacts/f.txt" as NonEmptyStr }, step_summary: FanGateWriteFailed { path: "GITHUB_STEP_SUMMARY" as NonEmptyStr, error: "unset" } },
  }
}

fn attempt(rb: List<ChassisPowerObservation>) -> FanGatePowerDownAttempt {
  FanGatePowerDownAttempt { command_success: true, command_stdout: "Chassis Power Control: Down/Off", command_exit_code: 0, command_stderr: "", readbacks: rb }
}

fn failed_attempt() -> FanGatePowerDownAttempt {
  FanGatePowerDownAttempt { command_success: false, command_stdout: "", command_exit_code: 1, command_stderr: "Error: Unable to establish IPMI v2 / RMCP+ session", readbacks: [still_on()] }
}

test fn a_failed_powerdown_command_is_on_the_record_with_its_exit_and_stderr() -> Bool {
  let t = post_power_fan_gate_stop_section(stop: FanGateSafeStopReceipt { first: failed_attempt(), repeat: FanGateRepeated { attempt: failed_attempt() } })
  string_contains(s: t, pattern: "PowerDown (first): command success=false exit=1")
    && string_contains(s: t, pattern: "PowerDown (repeat): command success=false exit=1")
    && string_contains(s: t, pattern: "stderr=[Error: Unable to establish IPMI v2 / RMCP+ session]")
}

fn stopped_off() -> FanGateSafeStopReceipt { FanGateSafeStopReceipt { first: attempt(rb: [still_on(), off()]), repeat: FanGateRepeatNotNeeded } }

fn exit_text(outcome: PostPowerFanGateOutcome) -> String {
  match post_power_fan_gate_exit(fitted: mtcollins1_fitted_fan_set, outcome: outcome) { ExitSuccess => "success"  ExitFailure { code: _, reason: r } => r }
}

test fn an_established_outcome_exits_success() -> Bool {
  exit_text(outcome: PostPowerFanEstablished { observation: round(on: true, lines: unit_rows(fan5_1: "5800 RPM" as NonEmptyStr)) }) == "success"
}

test fn a_refused_outcome_stops_with_the_typed_cause_the_assumed_set_and_the_evidence_pointers() -> Bool {
  let t = exit_text(outcome: refused_outcome(stop: stopped_off()))
  string_contains(s: t, pattern: "FAN4_0_Speed") && string_contains(s: t, pattern: "reads zero RPM") && string_contains(s: t, pattern: "OPERATOR'S ASSUMPTION")
    && string_contains(s: t, pattern: "power-off read back as off") && string_contains(s: t, pattern: "cooling manager standing unread")
    && string_contains(s: t, pattern: "written to artifacts/f.txt") && string_contains(s: t, pattern: "NOT written to GITHUB_STEP_SUMMARY")
}

test fn a_stop_whose_repeat_never_read_off_reports_power_off_unconfirmed_with_both_attempts_kept() -> Bool {
  let stop = FanGateSafeStopReceipt { first: attempt(rb: [still_on(), still_on()]), repeat: FanGateRepeated { attempt: attempt(rb: [still_on(), ChassisUnreadable]) } }
  let full = post_power_fan_gate_text(reading: PostPowerFanGatePowered { gate: PostPowerFanGateReached { fitted: mtcollins1_fitted_fan_set, outcome: refused_outcome(stop: stop) } })
  string_contains(s: exit_text(outcome: refused_outcome(stop: stop)), pattern: "power-off unconfirmed") && string_contains(s: full, pattern: "PowerDown (repeat): command success=true exit=0 stdout=[Chassis Power Control: Down/Off] stderr=[]; readbacks 2:") && string_contains(s: full, pattern: "PowerDown (first): command success=true exit=0 stdout=[Chassis Power Control: Down/Off] stderr=[]; readbacks 2:")
}

test fn a_repeat_that_read_off_says_so() -> Bool {
  let stop = FanGateSafeStopReceipt { first: attempt(rb: [still_on()]), repeat: FanGateRepeated { attempt: attempt(rb: [off()]) } }
  string_contains(s: exit_text(outcome: refused_outcome(stop: stop)), pattern: "only after one repeated PowerDown")
}

test fn the_stopping_observation_is_in_the_pre_stop_text_not_a_later_reread() -> Bool {
  let t = post_power_fan_gate_pre_stop_text(fitted: mtcollins1_fitted_fan_set, cause: FittedHeaderMissing { header: "FAN4_0_Speed" as NonEmptyStr }, observation: round(on: true, lines: unit_rows(fan5_1: "0 RPM" as NonEmptyStr)), manager: FanManagerUnread { read_obligation: "o" as NonEmptyStr })
  string_contains(s: t, pattern: "observation that stopped the boot") && string_contains(s: t, pattern: "FAN5_1_Speed")
}

fn with_manager(m: FanManagerReadStanding) -> String {
  post_power_fan_gate_pre_stop_text(fitted: mtcollins1_fitted_fan_set, cause: FittedHeaderMissing { header: "H" as NonEmptyStr }, observation: round(on: true, lines: []), manager: m)
}

test fn the_unread_manager_standing_renders_what_would_read_it() -> Bool {
  string_contains(s: with_manager(m: FanManagerUnread { read_obligation: "a REST session" as NonEmptyStr }), pattern: "cooling manager standing unread: a REST session")
}

test fn an_unreached_gate_reads_not_reached() -> Bool {
  string_contains(s: post_power_fan_gate_text(reading: PostPowerFanGateNotReached { reason: "r" as NonEmptyStr }), pattern: "not reached: r")
}

// THERMAL STANDING (side-chat hold 2026-10-19): only a published, fully decoded temperature read admits; every other
// standing refuses with its own typed arm. A silent pre-POST list never acquires a healthy interpretation by omission.
fn thermal_cause(t: ThermalObservation) -> String {
  match post_power_fan_verdict(fitted: mtcollins1_fitted_fan_set, chassis: ChassisPowerRead { power_on: true }, thermal: t, fans: round(on: true, lines: unit_rows(fan5_1: "5800 RPM" as NonEmptyStr)).fans, typing: Absent) {
    PostPowerFanVerdictEstablished => "established"
    PostPowerFanVerdictRefused { cause: PostPowerThermalUnreadable } => "unreadable"
    PostPowerFanVerdictRefused { cause: PostPowerThermalNotPublished { publication: TemperatureSensorsSilent } } => "silent"
    PostPowerFanVerdictRefused { cause: PostPowerThermalNotPublished { publication: TemperatureUndecodable } } => "undecodable"
    PostPowerFanVerdictRefused { cause: PostPowerThermalNotPublished { publication: TemperatureNoSensorRows } } => "norows"
    PostPowerFanVerdictRefused { cause: PostPowerThermalRowsUndecoded { refusals: _ } } => "undecoded-rows"
    PostPowerFanVerdictRefused { cause: PostPowerThermalReadingUnrecognised { texts: _ } } => "unrecognised-reading"
    PostPowerFanVerdictRefused { cause: _ } => "other"
  }
}

test fn a_published_fully_decoded_thermal_read_with_spinning_fans_is_established() -> Bool { thermal_cause(t: published()) == "established" }
test fn an_unreadable_thermal_read_refuses() -> Bool { thermal_cause(t: ThermalUnreadable) == "unreadable" }
test fn a_silent_pre_post_thermal_list_refuses_and_is_never_healthy() -> Bool { thermal_cause(t: ThermalRead { publication: TemperatureSensorsSilent, undecoded_texts: [], unrecognised_readings: [] }) == "silent" }
test fn an_undecodable_thermal_list_refuses() -> Bool { thermal_cause(t: ThermalRead { publication: TemperatureUndecodable, undecoded_texts: ["PSU2_Status      | EBh | ok  |  0.0 | ", "Watchdog2        | D7h | ok  | 33.0 | "], unrecognised_readings: [] }) == "undecodable" }
test fn a_thermal_read_with_no_sensor_rows_refuses() -> Bool { thermal_cause(t: ThermalRead { publication: TemperatureNoSensorRows, undecoded_texts: [], unrecognised_readings: [] }) == "norows" }
test fn a_published_temperature_beside_an_undecoded_row_refuses() -> Bool { thermal_cause(t: ThermalRead { publication: TemperaturePublished, undecoded_texts: ["PSU2_Status      | EBh | ok  |  0.0 | "], unrecognised_readings: [] }) == "undecoded-rows" }

// The real route: raw sdr text -> sdr_decode_lines -> thermal_observation -> the gate. sdr_temperature_publication still answers
// "was ANY temperature published" (TemperaturePublished here), so the unrecognised sibling must be carried by its own field.
fn thermal_of(stdout: String) -> ThermalObservation { thermal_observation(success: true, results: sdr_decode_lines(stdout: stdout)) }
test fn a_decoded_temperature_beside_an_unrecognised_reading_refuses() -> Bool {
  thermal_cause(t: thermal_of(stdout: "CPU0_SOC_Temp    | 3Dh | ok  | 30.15 | 46 degrees C\nCPU1_SOC_Temp    | 3Eh | ok  | 30.16 | 46 kelvin\n")) == "unrecognised-reading"
}
test fn only_decoded_temperatures_are_established_by_the_same_route() -> Bool {
  thermal_cause(t: thermal_of(stdout: "CPU0_SOC_Temp    | 3Dh | ok  | 30.15 | 46 degrees C\nCPU1_SOC_Temp    | 3Eh | ok  | 30.16 | 47 degrees C\n")) == "established"
}
test fn the_unrecognised_reading_refusal_text_carries_the_reading() -> Bool {
  string_contains(s: post_power_fan_refusal_text(cause: PostPowerThermalReadingUnrecognised { texts: ["46 kelvin"] }), pattern: "46 kelvin")
}

test fn the_thermal_refusal_text_names_each_standing_and_each_row_cause() -> Bool {
  string_contains(s: post_power_fan_refusal_text(cause: PostPowerThermalUnreadable), pattern: "temperature sensors were unreadable")
    && string_contains(s: post_power_fan_refusal_text(cause: PostPowerThermalNotPublished { publication: TemperatureSensorsSilent }), pattern: "published no decoded temperature")
    && string_contains(s: post_power_fan_refusal_text(cause: PostPowerThermalRowsUndecoded { refusals: map(["a", "b", "c"], r => SdrRowRefusedNoRecordNamed { row: r }) }), pattern: "3 undecoded row(s)")
    // THE CAUSE WORDS REACH THE RECEIPT, not just the count: a verdict that refused every row for one
    // wrong reason, or printed every cause as the same sentence, would fail here while passing the count
    // assertions above it.
    && string_contains(s: post_power_fan_refusal_text(cause: PostPowerThermalRowsUndecoded { refusals: map(["a"], r => SdrRowRefusedThresholdTyped { row: r }) }), pattern: "typed a threshold sensor")
    && string_contains(s: post_power_fan_refusal_text(cause: PostPowerThermalRowsUndecoded { refusals: map(["a"], r => SdrRowRefusedUnlabelledRecord { row: r }) }), pattern: "printed neither ipmitool threshold label")
    && string_contains(s: post_power_fan_refusal_text(cause: PostPowerThermalRowsUndecoded { refusals: map(["a"], r => SdrRowRefusedAmbiguousTypingLine { row: r }) }), pattern: "more than one Sensor Type line")
    && string_contains(s: post_power_fan_refusal_text(cause: PostPowerThermalRowsUndecoded { refusals: map(["PSU2_Status      | EBh | ok  |  0.0 | ", "Watchdog2        | D7h | ok  | 33.0 | ", "EndOfPost        | E2h | ok  |  6.2 | "], r => SdrRowRefusedNoRecordNamed { row: r }) }), pattern: "PSU2_Status")
}

// THE GATE'S OBSERVATION RECORDS THE UNDECODED THERMAL ROWS THEMSELVES (boot 5, run 40258937016:
// four rows refused unread and the receipt said only `undecoded=4`). The fan side already printed each
// undecoded row as fan_undecoded_line=[..]; the thermal side printed only a count, so boot 7 could not
// tell the operator which rows the BMC left unread. Each undecoded row now appears as
// round=<i> thermal_undecoded_row=[<the controller's own text>].
test fn the_stopped_boot_observation_records_each_undecoded_thermal_row() -> Bool {
  let r = FanObservationRound {
    observed_at: "2026-10-26T02:56:41Z" as NonEmptyStr,
    round_index: 0,
    chassis: ChassisPowerRead { power_on: true },
    chassis_raw: "",
    thermal: ThermalRead { publication: TemperaturePublished, undecoded_texts: ["PSU2_Status      | EBh | ok  |  0.0 | ", "Watchdog2        | D7h | ok  | 33.0 | "], unrecognised_readings: [] },
    fans: FanSensorsRead { lines: unit_rows(fan5_1: "5800 RPM" as NonEmptyStr), undecoded_lines: [], failure_rows: [] },
    verbose: SdrVerboseNotRequired,
  }
  string_contains(s: render_round_block(round: r), pattern: "round=0 thermal_undecoded_row=[PSU2_Status      | EBh | ok  |  0.0 | ]")
    && string_contains(s: render_round_block(round: r), pattern: "round=0 thermal_undecoded_row=[Watchdog2        | D7h | ok  | 33.0 | ]")
    && string_contains(s: render_round_block(round: r), pattern: "undecoded=2")
}

fn boot5_empty_reading_rows() -> String {
  "PSU2_Status      | EBh | ok  |  0.0 |\nWatchdog2        | D7h | ok  | 33.0 |\nEndOfPost        | E2h | ok  |  6.2 |\nEvent_log        | D6h | ok  |  6.2 |"
}

fn boot5_unstructured() -> List<String> {
  sdr_unstructured_texts(results: sdr_decode_lines(stdout: boot5_empty_reading_rows()))
}

// BOOT 7 STATIC ADMISSION CHECK (manager ask: does the gate AS MERGED in #15327 admit boot 5's
// thermal reading, or still refuse it? no live run). THE COMMITTED INPUT: boot 5 (run 40258937016)
// committed its sensor dump at artifacts/bmc/mtcollins1-boot-run-40258937016/mtcollins1-boot-diagnostics.txt,
// section "== bmc sensors (ipmi sdr elist) ==", header "read at 2026-10-26T02:57:00Z: 197 line(s),
// 4 without a reading field"; the four rows WITHOUT a reading field, verbatim as committed, are the
// literals below. Two caveats, stated not hidden: (a) that dump is a diagnostic RENDER - rows carry two
// leading indent spaces (stripped here) and the renderer drops trailing spaces, so raw stdout would end
// "| " where the committed row ends "|"; (b) that read is 19 s after the gate's own round (02:56:41Z)
// and after the safe power-off - same controller, same discrete status rows, but NOT the gate round's
// own stdout, which was never committed raw because boot 5 predates #15327. The gate round itself is
// committed as a rendering (mtcollins1-boot-fan-gate-observation.txt): "round=0 ... thermal=published
// undecoded=4" - the source of the TemperaturePublished input below.

test fn the_four_committed_boot5_empty_reading_rows_are_the_undecoded_rows() -> Bool {
  let u = boot5_unstructured()
  let t = join(u, "\n")
  u.length() == 4 &&
  string_contains(s: t, pattern: "PSU2_Status") &&
  string_contains(s: t, pattern: "Watchdog2") &&
  string_contains(s: t, pattern: "EndOfPost") &&
  string_contains(s: t, pattern: "Event_log")
}

// THE ANSWER, MEASURED: with the committed publication fact (thermal=published) and the committed rows,
// thermal_refusal - the arm that stopped boot 5 - still REFUSES: PostPowerThermalRowsUndecoded over the
// four rows. Admission would be Absent. #15327 changed the RECEIPT (raw rows carried), not the DECISION.
test fn the_merged_gate_still_refuses_the_boot5_thermal_reading() -> Bool {
  let thermal_read = ThermalRead { publication: TemperaturePublished, undecoded_texts: boot5_unstructured(), unrecognised_readings: [] }
  match thermal_refusal(thermal: thermal_read, typing: Absent) {
    Present { value: PostPowerThermalRowsUndecoded { refusals: t } } => t.length() == 4
    _ => false
  }
}

// THE #15327 RECEIPT HALF: the refusal text names each committed row, so a boot that stops here EMITS
// the bytes the later admission rule will classify.
test fn the_refusal_text_carries_each_committed_boot5_row() -> Bool {
  let text = post_power_fan_refusal_text(cause: PostPowerThermalRowsUndecoded { refusals: map(boot5_unstructured(), r => SdrRowRefusedNoRecordNamed { row: r }) })
  string_contains(s: text, pattern: "PSU2_Status") &&
  string_contains(s: text, pattern: "Watchdog2") &&
  string_contains(s: text, pattern: "EndOfPost") &&
  string_contains(s: text, pattern: "Event_log")
}

// THE REPOSITORY IS THE TOOL'S OUTPUT, NOT A SHAPE WE INVENTED.
//
// These claims parse the committed verbose read of srv1 (run 41406891344), carried verbatim by
// test.fixture.machine_intake.mtcollins1_fan_capture. They replace a unit-shape sample this file used
// to carry, which wrote 'Sensor Type : Power Supply (08h)' and 'Event/Reading Type Code   : 6Fh'.
// Neither string is what ipmitool prints: the verbose block prints ' Sensor Type (Discrete): %s
// (0x%02x)' (lib/ipmi_sdr.c:1888 at be11d948) and the event/reading type code reaches only
// lprintf(LOG_DEBUG, ...) (:1891), never stdout. That claim asserted a string it had itself written,
// so it could not fail - the reason this whole rule needed real bytes before it could be trusted.

// THE ROWS, verbatim from the committed boot-5 observation
// (artifacts/bmc/mtcollins1-boot-run-40258937016/mtcollins1-boot-diagnostics.txt:1965/2034/2035/2049).
// A regex over that whole dump for 'name | XXh | ok | entity |' with an empty reading matches EXACTLY
// these four, which is why the rule is about these rows and not about a category invented in a test.
data boot5_blank_reading_rows: List<String> = [
  "  PSU2_Status      | EBh | ok  |  0.0 |",
  "  Watchdog2        | D7h | ok  | 33.0 |",
  "  EndOfPost        | E2h | ok  |  6.2 |",
  "  Event_log        | D6h | ok  |  6.2 |",
]

fn rows_admit(rows: List<String>) -> Bool {
  match thermal_refusal(
    thermal: ThermalRead { publication: TemperaturePublished, undecoded_texts: rows, unrecognised_readings: [] },
    typing: Present { value: mtcollins1_fan_capture_readout() },
  ) {
    Absent => true
    Present { value: _ } => false
  }
}

fn rows_refuse_with(rows: List<String>, wanted: Int) -> Bool {
  match thermal_refusal(
    thermal: ThermalRead { publication: TemperaturePublished, undecoded_texts: rows, unrecognised_readings: [] },
    typing: Present { value: mtcollins1_fan_capture_readout() },
  ) {
    Present { value: PostPowerThermalRowsUndecoded { refusals: still } } => still.length() == wanted
    _ => false
  }
}

test fn the_committed_repository_groups_each_record_with_its_own_detail_lines() -> Bool {
  let recs = mtcollins1_fan_capture_records()
  recs.length() == 5 &&
    string_contains(s: join(map(recs, r => r.name), "\n"), pattern: "PSU2_Status") &&
    string_contains(s: join(map(recs, r => r.name), "\n"), pattern: "EndOfPost") &&
    string_contains(s: join(flat_map(recs, r => r.detail_lines), "\n"), pattern: "Sensor Type (Discrete): Power Supply (0x08)") &&
    string_contains(s: join(flat_map(recs, r => r.detail_lines), "\n"), pattern: "Sensor Type (Discrete): Unknown (0xd0)") &&
    !string_contains(s: join(flat_map(recs, r => r.detail_lines), "\n"), pattern: "Event/Reading Type Code")
}

// THE ADMISSION. Boot 5 stopped at the gate on these four rows; with the repository read they pass.
test fn the_four_boot5_blank_reading_rows_admit_on_the_committed_repository() -> Bool {
  rows_admit(rows: boot5_blank_reading_rows)
}

// THE RED THAT KEEPS IT HONEST, THREE WAYS.
// 1. No record for the row: refused, even though the shape is identical to the four that just passed.
//    The sensor number is C0h on purpose - the withdrawn design keyed on >= C0h and must not be
//    re-introduced by a test that happens to agree with it.
test fn a_blank_reading_row_with_no_record_in_the_repository_still_refuses() -> Bool {
  rows_refuse_with(rows: ["  Invented_Sensor    | C0h | ok  |  7.1 |"], wanted: 1)
}

// 2. A record that says THRESHOLD: a blank reading there IS the decode failure, so it stays refused.
//    CPU0_SOC_Temp is real, from the same read.
test fn a_threshold_record_does_not_admit_a_blank_reading_row() -> Bool {
  rows_refuse_with(rows: ["  CPU0_SOC_Temp      | 3Dh | ok  |  3.1 |"], wanted: 1)
}

// 4. THE MALFORMED-COMPETITOR RED. ipmitool prints EXACTLY ONE typing line per record
//    (lib/ipmi_sdr.c:1888 / :1952 at be11d948), so a record carrying a valid
//    ' Sensor Type (Discrete): ...' line
//    AND a malformed competitor like ' Sensor Type (Threshold ) : ' was not written by ipmitool, and
//    which label governs it would be a guess. The classifier used to SEARCH the detail lines, so the
//    malformed line was invisible to the threshold test, the record typed not-threshold, and the row
//    admitted on bytes that contradict themselves. It must refuse, with its own cause.
test fn a_valid_discrete_label_beside_a_malformed_competitor_never_admits() -> Bool {
  let record = SdrVerboseRecord { name: "Malformed_Type_Sensor", number_hex: "0xc0", detail_lines: [" Sensor Type (Discrete): Power Supply (0x08)", " Sensor Type (Threshold ) : Power Supply (0x08)"] }
  match sdr_verbose_block_typing(record: record) {
    SdrBlockTypingAmbiguous => match thermal_refusal(
      thermal: ThermalRead { publication: TemperaturePublished, undecoded_texts: ["  Malformed_Type_Sensor | C0h | ok  |  7.1 |"], unrecognised_readings: [] },
      typing: Present { value: SdrVerboseRead { records: [record] } },
    ) {
      // The refusal is this cause, not merely "some refusal": the receipt has to be able to say that
      // the repository contradicted itself, which is a different fact from printing no label.
      Present { value: PostPowerThermalRowsUndecoded { refusals: still } } => still.length() == 1 && flat_map(still, f => match f { SdrRowRefusedAmbiguousTypingLine { row: _ } => [f] _ => [] }).length() == 1
      _ => false
    }
    _ => false
  }
}

// 5. A malformed line on its own is not a threshold line and not a discrete line either: the record is
//    unlabelled, and an unlabelled record is refused under its OWN cause rather than folded in with
//    the contradiction above (§5: degradations stay distinguishable).
test fn a_record_whose_only_typing_line_is_malformed_is_unlabelled_and_refused() -> Bool {
  let record = SdrVerboseRecord { name: "Half_Type_Sensor", number_hex: "0xc1", detail_lines: [" Sensor Type (Threshold ) : Power Supply (0x08)"] }
  match sdr_verbose_block_typing(record: record) {
    SdrBlockUntyped => match thermal_refusal(
      thermal: ThermalRead { publication: TemperaturePublished, undecoded_texts: ["  Half_Type_Sensor   | C1h | ok  |  7.1 |"], unrecognised_readings: [] },
      typing: Present { value: SdrVerboseRead { records: [record] } },
    ) {
      Present { value: PostPowerThermalRowsUndecoded { refusals: still } } => still.length() == 1 && flat_map(still, f => match f { SdrRowRefusedUnlabelledRecord { row: _ } => [f] _ => [] }).length() == 1
      _ => false
    }
    _ => false
  }
}

// 3. No readout at all (the boot phase that never read the repository): the four stay refused. This is
//    the fail-closed half of the design and the reason the readout is threaded through the signature.
test fn the_four_boot5_rows_stay_refused_without_any_repository_read() -> Bool {
  match thermal_refusal(
    thermal: ThermalRead { publication: TemperaturePublished, undecoded_texts: boot5_blank_reading_rows, unrecognised_readings: [] },
    typing: Absent,
  ) {
    Present { value: PostPowerThermalRowsUndecoded { refusals: still } } => still.length() == 4
    _ => false
  }
}

// THE NUMBER CARRIES NO TYPING (the anti-C0h guard). The same four rows admit with their sensor
// numbers rewritten to values no design has ever keyed on: if anything in the rule read field 2, this
// would refuse.
test fn the_admission_survives_rewriting_every_sensor_number() -> Bool {
  rows_admit(rows: [
    "  PSU2_Status      | 01h | ok  |  0.0 |",
    "  Watchdog2        | FFh | ok  | 33.0 |",
    "  EndOfPost        | 00h | ok  |  6.2 |",
    "  Event_log        | 7Fh | ok  |  6.2 |",
  ])
}

// THE STATUS CELL STILL DECIDES: a row that does not read ok is not admitted by a discrete record.
test fn a_row_that_does_not_read_ok_is_not_admitted_by_a_discrete_record() -> Bool {
  rows_refuse_with(rows: ["  PSU2_Status      | EBh | ns  |  0.0 |"], wanted: 1)
}

// THE BOOT-PHASE READOUT OVER THE REAL BYTES (manager msg_d6bce079): the same readout the boot lane
// threads into the gate parses this capture into records naming all four rows. Before this PR the
// row-keyed parser returned ZERO records from exactly these bytes.
test fn the_boot_phase_readout_over_the_committed_bytes_yields_the_four_records() -> Bool {
  match mtcollins1_fan_capture_readout() {
    SdrVerboseRead { records: recs } =>
      recs.length() == 5 &&
      string_contains(s: join(map(recs, r => r.name), "\n"), pattern: "Watchdog2") &&
      string_contains(s: join(map(recs, r => r.name), "\n"), pattern: "Event_log")
    _ => false
  }
}

// THE CAPTURE INHABITS THE RULE. For each of the four rows the boot-5 gate refused, the committed bytes
// carry a record of that name AND the classifier types it not-threshold -- so the rule admits them on
// what a BMC printed, not on a shape we invented. The capture INHABITS the rule; it does not ground it:
// no production path reads these bytes (boot admission comes from the live per-round verbose read), which
// is what keeps a stale or wrong capture unable to admit anything. Delete a record
// from the committed bytes, or let the classifier call a discrete record threshold, and this goes red.
// EndOfPost is in here on purpose: its type NAME prints as "Unknown (0xd0)", an OEM code, so a rule that
// keyed on the name would refuse it - and this claim would then refuse the rule.
test fn each_refused_row_is_typed_by_a_record_in_the_committed_capture() -> Bool {
  let records = mtcollins1_fan_capture_records()
  let typed = flat_map(["PSU2_Status", "Watchdog2", "EndOfPost", "Event_log"], n => flat_map(records, r => if r.name == n { match sdr_verbose_block_typing(record: r) { SdrBlockNotThreshold => [r] SdrBlockThreshold => [] SdrBlockTypingAmbiguous => [] SdrBlockUntyped => [] } } else { [] }))
  typed.length() == 4
}


// THE DECISION GOES RED, ON INPUTS THAT ARE NOT EDITS TO A NUMBER. The claim above is the green side;
// these are the discriminating half. Each hands mtcollins1_fan_capture_types_the_rows a readout it built
// itself, so passing one is the parser's verdict over bytes rather than a literal agreeing with a literal:
// nothing here reads a count written down beside the capture, and an edit to such a count could not turn
// any of them red or green. The decision returns Bool and constructs no authority - production admission
// comes from the live per-round verbose read, never from these bytes.
test fn the_committed_capture_types_the_rows_by_the_parsers_verdict() -> Bool {
  mtcollins1_fan_capture_types_the_rows(readout: mtcollins1_fan_capture_readout())
}

// A failed read types nothing. It is not an empty repository either, and the two stay separate states.
test fn a_failed_read_types_no_rows() -> Bool {
  !mtcollins1_fan_capture_types_the_rows(readout: SdrVerboseUnreadable)
}

test fn an_empty_repository_types_no_rows() -> Bool {
  !mtcollins1_fan_capture_types_the_rows(readout: SdrVerboseEmptyRepository)
}

// THE CONTROL THAT MAKES THE DECISION MEAN SOMETHING. The threshold-only subset of the SAME committed
// records - bytes that never met the not-threshold side of ipmi_sdr.h:427 - must not type the rows, while
// the whole repository does (the first claim). Both sides are the parser's verdict over real bytes: the
// subset is taken by the classifier itself, so if the classifier called a discrete record threshold the
// subset would carry a not-threshold record too, carry both kinds, and this claim would go red.
test fn bytes_that_never_met_both_sides_of_the_threshold_line_type_no_rows() -> Bool {
  let threshold_only = flat_map(mtcollins1_fan_capture_records(), r => match sdr_verbose_block_typing(record: r) { SdrBlockThreshold => [r] SdrBlockNotThreshold => [] SdrBlockTypingAmbiguous => [] SdrBlockUntyped => [] })
  threshold_only.length() > 0 && !mtcollins1_fan_capture_types_the_rows(readout: SdrVerboseRead { records: threshold_only })
}

// EACH REFUSAL CAUSE IS ITS OWN RULING, AND EACH HAS A CLAIM OF ITS OWN. Under one Refused variant
// carrying one of seven sentences, a claim could only ask "was it refused?" - so a rule that refused
// EVERY row for one wrong reason, or admitted a row it should have refused while still refusing others,
// could pass. Matching the variant makes each cause separately red, and a misnamed cause is a compile
// error rather than a string nobody compares against (DESIGN.md §4c: a ruling belongs in a typed
// carrier; §5: refusals are typed and located, which is why each carries the row it refused).

// THE COMMITTED CAPTURE AS A ROUND'S READ, so the row-level claims ask the judgement the same question
// the gate asks it: "what did this round have to type against".
fn the_committed_repository() -> SdrVerboseReadout? {
  Present { value: mtcollins1_fan_capture_readout() }
}

test fn a_row_that_is_not_an_elist_row_is_refused_as_malformed() -> Bool {
  match sdr_blank_ok_row_judgement(text: "Sensor ID              : PSU2_Status (0xeb)", typing: the_committed_repository()) {
    SdrRowRefused { refusal: SdrRowRefusedNotAnElistRow { row: r } } => true
    _ => false
  }
}

// A row with a reading is a different case entirely: the rule exists for blanks, and admitting a row
// that already has a reading would let the gate call an unread value typed.
test fn a_row_carrying_a_reading_is_not_the_blank_reading_case() -> Bool {
  match sdr_blank_ok_row_judgement(text: "  PSU1_FAN_SPEED     | 32h | ok  |  7.1 | 5000 RPM", typing: the_committed_repository()) {
    SdrRowRefused { refusal: SdrRowRefusedCarriesReading { row: _ } } => true
    _ => false
  }
}

// ORDER MATTERS, AND THIS PINS IT: PSU2_Status HAS a discrete record, so a rule that consulted the
// repository before checking status would admit this row. Status is checked first and refuses it.
test fn a_row_whose_status_is_not_ok_is_refused_on_status_not_on_its_record() -> Bool {
  match sdr_blank_ok_row_judgement(text: "  PSU2_Status      | EBh | ns  |  0.0 |", typing: the_committed_repository()) {
    SdrRowRefused { refusal: SdrRowRefusedStatusNotOk { row: _ } } => true
    _ => false
  }
}

test fn a_blank_ok_row_with_no_record_of_its_name_is_refused_for_that_missing_record() -> Bool {
  match sdr_blank_ok_row_judgement(text: "  Invented_Sensor    | C0h | ok  |  7.1 |", typing: the_committed_repository()) {
    SdrRowRefused { refusal: SdrRowRefusedNoRecordNamed { row: _ } } => true
    _ => false
  }
}

// The name is the join, so a name shared by two records makes "which sensor typed this row" a guess -
// and a guess here admits a reading nobody read. The twin is a real record from this capture, so the
// repository really does contain one; doubling it is the only change.
test fn two_records_sharing_a_name_refuse_the_row_as_ambiguous() -> Bool {
  let twin = SdrVerboseRecord { name: "PSU2_Status", number_hex: "0xeb", detail_lines: [" Sensor Type (Discrete): Power Supply (0x08)"] }
  let doubled = mtcollins1_fan_capture_records().concat([twin])
  match sdr_blank_ok_row_judgement(text: "  PSU2_Status      | EBh | ok  |  0.0 |", typing: Present { value: SdrVerboseRead { records: doubled } }) {
    SdrRowRefused { refusal: SdrRowRefusedNameAmbiguous { row: _ } } => true
    _ => false
  }
}

test fn a_threshold_record_refuses_the_blank_row_it_is_served() -> Bool {
  match sdr_blank_ok_row_judgement(text: "  CPU0_SOC_Temp      | 3Dh | ok  |  3.1 |", typing: the_committed_repository()) {
    SdrRowRefused { refusal: SdrRowRefusedThresholdTyped { row: _ } } => true
    _ => false
  }
}

// Neither label present: the event/reading type is unknown, and an unknown type is not permission. This
// is the fail-closed edge - a missing label must never read as "not threshold".
test fn a_record_with_neither_ipmitool_label_refuses_rather_than_guessing() -> Bool {
  let unlabelled = SdrVerboseRecord { name: "Mystery_Sensor", number_hex: "0x55", detail_lines: [" Entity ID             : 7.1 (Temperature)"] }
  match sdr_blank_ok_row_judgement(text: "  Mystery_Sensor     | 55h | ok  |  7.1 |", typing: Present { value: SdrVerboseRead { records: [unlabelled] } }) {
    SdrRowRefused { refusal: SdrRowRefusedUnlabelledRecord { row: _ } } => true
    _ => false
  }
}

// A FAILED VERBOSE READ IS UNREAD, NEVER ZERO RECORDS: an unread repository must not read as a
// controller that publishes no records (the fan_lines lesson, applied to the new read).
test fn a_failed_verbose_read_reports_unread_not_zero_records() -> Bool {
  match sdr_verbose_readout(success: false, stdout: "") {
    SdrVerboseUnreadable => true
    _ => false
  }
}

// THE RENDER STATES THE VERBOSE FACT PER ROUND: not_required when the round had nothing to answer,
// and captured records print elist line and detail lines verbatim in brackets.
test fn a_round_without_capture_prints_verbose_state_as_not_required() -> Bool {
  string_contains(s: render_round_block(round: round(on: true, lines: unit_rows(fan5_1: "5800 RPM" as NonEmptyStr))), pattern: "verbose_sdr=not_required")
}

// RENDERS THE REAL CAPTURE, AND THE MARKER CARRIES THE COUNT (manager msg_d6bce079). This claim used to
// render a hand-written sample and assert the strings it had itself written; it now renders the
// committed repository and asserts the two lines a reader needs to audit it: the state with its record
// count, and a detail line copied byte-for-byte including the tool's own leading space.
test fn a_captured_verbose_record_prints_its_lines_verbatim() -> Bool {
  let r = FanObservationRound { observed_at: "2026-11-02T04:40:00Z" as NonEmptyStr, round_index: 0, chassis: ChassisPowerRead { power_on: true }, chassis_raw: "", thermal: published(), fans: FanSensorsRead { lines: [], undecoded_lines: [], failure_rows: [] }, verbose: SdrVerboseCaptured { readout: mtcollins1_fan_capture_readout() } }
  let block = render_round_block(round: r)
  string_contains(s: block, pattern: "verbose_sdr=captured(5)") &&
  string_contains(s: block, pattern: "verbose_record=[PSU2_Status (0xeb)]") &&
  string_contains(s: block, pattern: "verbose_detail=[ Sensor Type (Discrete): Unknown (0xd0)]")
}

// THE FOURTH CAUSE, IN ALL THREE OF ITS SHAPES. A round with nothing to type against is a materially
// different failure from a record that named the row and refused it, and the verdict must be able to say
// which of the three it was: the read was never issued, it was issued and failed, or it was issued and
// parsed to nothing. Before the causes were carried, all three - and a genuine threshold typing - left
// one "undecoded" string behind, and boot 7 could not tell a missing read from a misclassified sensor.
//
// A WITNESS-LOCAL PROJECTION, which is allowed of a witness (§3: a witness discriminates at one
// interface) and would not be allowed as a production helper: it exists so each shape is separately red.
fn typing_unread_shape(refusal: SdrRowRefusal) -> String {
  match refusal {
    SdrRowRefusedTypingUnread { row: _, readout: ro } => match ro {
      Absent => "never issued"
      Present { value: r } => match r {
        SdrVerboseUnreadable => "issued and failed"
        SdrVerboseEmptyRepository => "issued, parsed to nothing"
        SdrVerboseRead { records: _ } => "a read that carries records is never this cause"
      }
    }
    _ => "not a typing-unread refusal"
  }
}

fn refusals_of(rows: List<String>, typing: SdrVerboseReadout?) -> List<SdrRowRefusal> {
  match thermal_refusal(
    thermal: ThermalRead { publication: TemperaturePublished, undecoded_texts: rows, unrecognised_readings: [] },
    typing: typing,
  ) {
    Present { value: PostPowerThermalRowsUndecoded { refusals: t } } => t
    _ => []
  }
}

test fn a_round_that_never_issued_the_read_says_so_rather_than_blaming_the_records() -> Bool {
  let t = refusals_of(rows: boot5_blank_reading_rows, typing: Absent)
  t.length() == 4 && flat_map(t, f => if typing_unread_shape(refusal: f) == "never issued" { [1] } else { [] }).length() == 4
}

test fn a_read_that_failed_says_it_failed_rather_than_that_the_records_are_missing() -> Bool {
  let t = refusals_of(rows: boot5_blank_reading_rows, typing: Present { value: SdrVerboseUnreadable })
  t.length() == 4 && flat_map(t, f => if typing_unread_shape(refusal: f) == "issued and failed" { [1] } else { [] }).length() == 4
}

test fn a_read_that_parsed_to_nothing_says_it_was_empty_rather_than_that_the_records_are_missing() -> Bool {
  let t = refusals_of(rows: boot5_blank_reading_rows, typing: Present { value: SdrVerboseEmptyRepository })
  t.length() == 4 && flat_map(t, f => if typing_unread_shape(refusal: f) == "issued, parsed to nothing" { [1] } else { [] }).length() == 4
}

// The three shapes are NOT collapsed into one word: one claim, all three verdicts, no two alike. Without
// this the typed cause would be decorative - every shape rendering the same sentence would still pass
// each claim above.
// .first() yields an OPTIONAL in this language (matched Present/Absent everywhere it is used, e.g.
// dag/product/breakout_leg_programming.dag:179), so the head of a refusal list is taken by matching it,
// not by handing it to a function that wants a refusal. An empty list here is a real answer -- "nothing
// was refused" -- and it says so rather than panicking on a missing head.
fn first_typing_unread_shape(rows: List<String>, typing: SdrVerboseReadout?) -> String {
  match refusals_of(rows: rows, typing: typing).first() {
    Present { value: f } => typing_unread_shape(refusal: f)
    Absent => "nothing refused"
  }
}

test fn the_three_ways_to_have_nothing_to_type_against_are_three_different_words() -> Bool {
  let a = first_typing_unread_shape(rows: boot5_blank_reading_rows, typing: Absent)
  let b = first_typing_unread_shape(rows: boot5_blank_reading_rows, typing: Present { value: SdrVerboseUnreadable })
  let c = first_typing_unread_shape(rows: boot5_blank_reading_rows, typing: Present { value: SdrVerboseEmptyRepository })
  a != "nothing refused" && a != b && b != c && a != c
}

// A threshold typing is NOT this cause: it is the records being present and saying no, which is the
// distinction the whole verdict change exists to keep.
test fn a_threshold_typing_is_not_reported_as_a_round_that_read_nothing() -> Bool {
  let t = refusals_of(rows: ["  CPU0_SOC_Temp      | 3Dh | ok  |  3.1 |"], typing: Present { value: mtcollins1_fan_capture_readout() })
  t.length() == 1 && flat_map(t, f => if typing_unread_shape(refusal: f) == "not a typing-unread refusal" { [1] } else { [] }).length() == 1 &&
    flat_map(t, f => match f { SdrRowRefusedThresholdTyped { row: _ } => [1] _ => [] }).length() == 1
}

// THE EXCUSED ROW NAMES ITSELF: the admission carries the row it excused, so a receipt can show which
// row the repository typed and a claim can pin the row rather than only the fact that something passed.
test fn the_admitted_judgement_names_the_row_it_excused() -> Bool {
  match sdr_blank_ok_row_judgement(text: "  PSU2_Status      | EBh | ok  |  0.0 |", typing: the_committed_repository()) {
    SdrRowAdmittedDiscrete { row: r } => r == "  PSU2_Status      | EBh | ok  |  0.0 |"
    _ => false
  }
}
