test fn serial_channel_stays_in_census_and_does_not_block_lan_secure() -> Bool {
  let standing = derive_bmc_secure(
    subject: intake_subject,
    observation: rotation_observed(
      subj: intake_subject,
      previous_epoch: 0,
      bootstrap: bootstrap_accepted,
      reference: managed_reference,
      applied_at: rotation_at,
      managed: managed_accepted,
      census: census_with_serial,
      probes: both_lan_rejecting(),
      account: published_account_retired,
    ),
    environment: DevelopmentAndTest,
  )
  is_secured(standing: standing)
}

test fn disabled_not_retired_is_a_secured_residual() -> Bool {
  let standing = derive_bmc_secure(
    subject: intake_subject,
    observation: rotation_observed(
      subj: intake_subject,
      previous_epoch: 0,
      bootstrap: bootstrap_accepted,
      reference: managed_reference,
      applied_at: rotation_at,
      managed: managed_accepted,
      census: census_two_lan,
      probes: both_lan_rejecting(),
      account: published_account_disabled,
    ),
    environment: DevelopmentAndTest,
  )
  match standing.outcome {
    BmcSecured { endpoint: _, reference: _, evidence: _, secured_at: _, published_credential: acc } =>
      acc == published_account_disabled
    BmcSecureRefused { cause: _ } => false
  }
}

test fn disabled_administrator_reenable_is_a_secured_residual() -> Bool {
  let standing = derive_bmc_secure(
    subject: intake_subject,
    observation: rotation_observed(
      subj: intake_subject,
      previous_epoch: 0,
      bootstrap: bootstrap_accepted,
      reference: managed_reference,
      applied_at: rotation_at,
      managed: managed_accepted,
      census: census_two_lan,
      probes: both_lan_rejecting(),
      account: published_account_disabled_reenable,
    ),
    environment: DevelopmentAndTest,
  )
  match standing.outcome {
    BmcSecured { endpoint: _, reference: _, evidence: _, secured_at: _, published_credential: acc } =>
      acc == published_account_disabled_reenable
    BmcSecureRefused { cause: _ } => false
  }
}

test fn break_glass_retention_secures_dev_test() -> Bool {
  let standing = derive_dev(observation: rotation_observed(
    subj: intake_subject,
    previous_epoch: 0,
    bootstrap: bootstrap_accepted,
    reference: managed_reference,
    applied_at: rotation_at,
    managed: managed_accepted,
    census: census_two_lan,
    probes: both_lan_rejecting(),
    account: published_account_break_glass,
  ))
  match standing.outcome {
    BmcSecured { endpoint: _, reference: _, evidence: _, secured_at: _, published_credential: acc } =>
      acc == published_account_break_glass
    BmcSecureRefused { cause: _ } => false
  }
}

test fn retained_credential_refuses_under_production() -> Bool {
  let observation = rotation_observed(
    subj: intake_subject,
    previous_epoch: 0,
    bootstrap: bootstrap_accepted,
    reference: managed_reference,
    applied_at: rotation_at,
    managed: managed_accepted,
    census: census_two_lan,
    probes: both_lan_rejecting(),
    account: published_account_break_glass,
  )
  refused_with(
    standing: derive_bmc_secure(subject: intake_subject, observation: observation, environment: Production),
    expected: PublishedCredentialRetainedNotAdmittedForProduction,
  )
}

test fn published_factory_retention_secures_dev_test_only_when_explicit() -> Bool {
  let standing = derive_dev(observation: rotation_observed(
    subj: intake_subject,
    previous_epoch: 0,
    bootstrap: bootstrap_accepted,
    reference: managed_reference,
    applied_at: rotation_at,
    managed: managed_accepted,
    census: census_two_lan,
    probes: both_lan_accepting(),
    account: published_account_factory_retained,
  ))
  match standing.outcome {
    BmcSecured { endpoint: _, reference: _, evidence: _, secured_at: _, published_credential: acc } =>
      acc == published_account_factory_retained
    BmcSecureRefused { cause: _ } => false
  }
}

