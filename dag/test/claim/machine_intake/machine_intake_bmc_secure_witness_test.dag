data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data unit: UnitKey = "BRD-000451" as UnitKey

data assembly: AssemblyManifest = AssemblyManifest {
  chassis_part_number: "CH-1U-ALT",
  components: [ComponentIdentity { kind: DimmComponent, slot: "A1", identity: "SPD-A1" }],
}

data firmware: FirmwareManifest = FirmwareManifest {
  entries: [FirmwareEntry { component: "bmc", version: "3.22.00" }],
  configuration_digests: [],
}

data subject: QualificationSubject = qualification_subject_of(unit_key: unit, assembly: assembly, firmware: firmware)

data attempt_one: IntakeAttemptId = "intake-20260910-0001" as IntakeAttemptId
data attempt_two: IntakeAttemptId = "intake-20260910-0002" as IntakeAttemptId

data intake_subject: MachineIntakeSubject = MachineIntakeSubject { subject: subject, attempt_id: attempt_one }
data other_attempt_subject: MachineIntakeSubject = MachineIntakeSubject { subject: subject, attempt_id: attempt_two }

data controller: BmcControllerEndpoint = BmcControllerEndpoint { host: "192.168.1.192" }

data lan_228: Ipv4Address = ipv4_address(octet1: 192, octet2: 168, octet3: 1, octet4: 228)
data lan_231: Ipv4Address = ipv4_address(octet1: 192, octet2: 168, octet3: 1, octet4: 231)
data lan_unspecified: Ipv4Address = ipv4_address(octet1: 0, octet2: 0, octet3: 0, octet4: 0)

data channel_one: IpmiChannelNumber = 1
data channel_two: IpmiChannelNumber = 2
data channel_seven: IpmiChannelNumber = 7
data channel_eight: IpmiChannelNumber = 8

data census_two_lan: IpmiControllerChannelCensus = ipmi_controller_channel_census(members: [
  ipmi_lan_channel_member(channel: channel_one, medium: IpmiMedium8023Lan, address: lan_228),
  ipmi_lan_channel_member(channel: channel_eight, medium: IpmiMedium8023Lan, address: lan_231),
])

data census_empty: IpmiControllerChannelCensus = ipmi_controller_channel_census(members: [])

data census_with_unaddressed: IpmiControllerChannelCensus = ipmi_controller_channel_census(members: [
  ipmi_lan_channel_member(channel: channel_one, medium: IpmiMedium8023Lan, address: lan_228),
  ipmi_lan_channel_member(channel: channel_seven, medium: IpmiMedium8023Lan, address: lan_unspecified),
  ipmi_lan_channel_member(channel: channel_eight, medium: IpmiMedium8023Lan, address: lan_231),
])

data census_with_serial: IpmiControllerChannelCensus = ipmi_controller_channel_census(members: [
  ipmi_lan_channel_member(channel: channel_one, medium: IpmiMedium8023Lan, address: lan_228),
  ipmi_non_lan_channel_member(channel: channel_two, medium: IpmiMediumSerialAsync),
  ipmi_lan_channel_member(channel: channel_eight, medium: IpmiMedium8023Lan, address: lan_231),
])

data census_serial_only: IpmiControllerChannelCensus = ipmi_controller_channel_census(members: [
  ipmi_non_lan_channel_member(channel: channel_two, medium: IpmiMediumSerialAsync),
])

data managed_secret: SecretRef = SecretRef {
  project: "gunbai-secrets",
  secret: "bmc-brd000451-admin",
  version: "1",
  hash_state: HashPending,
}

data managed_reference: ManagedCredentialReference = ManagedCredentialReference {
  account: "intake-admin",
  role: AccountRoleAdministrator,
  secret: managed_secret,
  credential_epoch: 1,
}

fn evidence(label: NonEmptyStr) -> EvidenceRef {
  EvidenceRef { label: label, digest: content_hash_of_value(value: label as String) }
}

data rotation_at: EpochMs = 1788000005000

data bootstrap_accepted: CredentialProbeOutcome = CredentialAccepted { evidence: evidence(label: "bootstrap-login"), observed_at: 1788000001000 }
data managed_accepted: CredentialProbeOutcome = CredentialAccepted { evidence: evidence(label: "managed-login"), observed_at: 1788000006000 }
data published_rejected: CredentialProbeOutcome = CredentialRejected { evidence: evidence(label: "published-login-401"), observed_at: 1788000007000 }
data published_accepted: CredentialProbeOutcome = CredentialAccepted { evidence: evidence(label: "published-login-200"), observed_at: 1788000007000 }
data published_rejected_231: CredentialProbeOutcome = CredentialRejected { evidence: evidence(label: "published-login-401-231"), observed_at: 1788000008000 }
data published_accepted_231: CredentialProbeOutcome = CredentialAccepted { evidence: evidence(label: "published-login-200-231"), observed_at: 1788000008000 }

data published_account_retired: PublishedCredentialAccountObservation = PublishedCredentialRetired {
  evidence: evidence(label: "user-list-absent"),
  observed_at: 1788000009000,
}

data published_account_disabled: PublishedCredentialAccountObservation = PublishedCredentialDisabledNotRetired {
  restore_path: FirmwareResetRestoresPublishedAccount,
  evidence: evidence(label: "user-list-disabled"),
  observed_at: 1788000009000,
}

data published_account_disabled_reenable: PublishedCredentialAccountObservation = PublishedCredentialDisabledNotRetired {
  restore_path: AdministratorReEnableRestoresPublishedAccount,
  evidence: evidence(label: "user-list-disabled-reenable"),
  observed_at: 1788000009000,
}

data break_glass_secret: SecretRef = SecretRef {
  project: "gunbai-secrets",
  secret: "bmc-brd000451-break-glass",
  version: "1",
  hash_state: HashPending,
}

data published_account_break_glass: PublishedCredentialAccountObservation = PublishedCredentialRetainedByPolicy {
  retention: BreakGlassAccount { secret: break_glass_secret },
  evidence: evidence(label: "break-glass-present"),
  observed_at: 1788000009000,
}

data published_account_factory_retained: PublishedCredentialAccountObservation = PublishedCredentialRetainedByPolicy {
  retention: PublishedFactoryCredential,
  evidence: evidence(label: "factory-retained-explicit"),
  observed_at: 1788000009000,
}

fn lan_probe(channel: IpmiChannelNumber, address: Ipv4Address, outcome: CredentialProbeOutcome) -> PublishedCredentialLanProbe {
  PublishedCredentialLanProbe { channel: channel, address: address, outcome: outcome }
}

fn both_lan_rejecting() -> List<PublishedCredentialLanProbe> {
  [
    lan_probe(channel: channel_one, address: lan_228, outcome: published_rejected),
    lan_probe(channel: channel_eight, address: lan_231, outcome: published_rejected_231),
  ]
}

fn split_lan_probes() -> List<PublishedCredentialLanProbe> {
  [
    lan_probe(channel: channel_one, address: lan_228, outcome: published_rejected),
    lan_probe(channel: channel_eight, address: lan_231, outcome: published_accepted_231),
  ]
}

fn both_lan_accepting() -> List<PublishedCredentialLanProbe> {
  [
    lan_probe(channel: channel_one, address: lan_228, outcome: published_accepted),
    lan_probe(channel: channel_eight, address: lan_231, outcome: published_accepted_231),
  ]
}

fn derive_dev(observation: BmcCredentialRotationObservation) -> BmcSecureStanding {
  derive_bmc_secure(subject: intake_subject, observation: observation, environment: DevelopmentAndTest)
}

// One rotation observation. Every test below perturbs exactly one reading.
fn rotation_observed(
  subj: MachineIntakeSubject,
  previous_epoch: Int,
  bootstrap: CredentialProbeOutcome,
  reference: ManagedCredentialReference,
  applied_at: EpochMs,
  managed: CredentialProbeOutcome,
  census: IpmiControllerChannelCensus,
  probes: List<PublishedCredentialLanProbe>,
  account: PublishedCredentialAccountObservation,
) -> BmcCredentialRotationObservation {
  observed_bmc_credential_rotation(
    subject: subj,
    endpoint: controller,
    previous_credential_epoch: previous_epoch,
    bootstrap_probe: bootstrap,
    rotation: RotationApplied { reference: reference, applied_at: applied_at, evidence: evidence(label: "account-create-201") },
    managed_probe: managed,
    channel_census: census,
    census_evidence: evidence(label: "channel-census"),
    published_probes: probes,
    published_account: account,
  )
}

fn nominal_rotation() -> BmcCredentialRotationObservation {
  rotation_observed(
    subj: intake_subject,
    previous_epoch: 0,
    bootstrap: bootstrap_accepted,
    reference: managed_reference,
    applied_at: rotation_at,
    managed: managed_accepted,
    census: census_two_lan,
    probes: both_lan_rejecting(),
    account: published_account_retired,
  )
}

fn is_secured(standing: BmcSecureStanding) -> Bool {
  match standing.outcome {
    BmcSecured { endpoint: _, reference: _, evidence: _, secured_at: _, published_credential: _ } => true
    BmcSecureRefused { cause: _ } => false
  }
}

fn refusal_cause(standing: BmcSecureStanding) -> BmcSecureRefusalCause? {
  match standing.outcome {
    BmcSecured { endpoint: _, reference: _, evidence: _, secured_at: _, published_credential: _ } => none
    BmcSecureRefused { cause: c } => Present { value: c }
  }
}

fn refused_with(standing: BmcSecureStanding, expected: BmcSecureRefusalCause) -> Bool {
  match refusal_cause(standing: standing) {
    Present { value: c } => c == expected
    Absent => false
  }
}

// POSITIVE CONTROL. The whole conjunction holds — bootstrap opened, the
// rotation advanced the epoch, the managed credential authenticates after it,
// the published credential does not — and the phase is satisfied. Without this
// arm every refusal below would also pass on a function that refused always.
test fn nominal_rotation_secures_the_bmc() -> Bool {
  let standing = derive_dev(observation: nominal_rotation())
  let satisfied = match standing.outcome {
    BmcSecured { endpoint: e, reference: r, evidence: ev, secured_at: at, published_credential: acc } =>
      e == controller && r.credential_epoch == 1 && list_length(items: ev) == 7 && at == 1788000008000 && acc == published_account_retired
    BmcSecureRefused { cause: _ } => false
  }
  satisfied && is_secured(standing: standing)
}

// THE AUTHORED RED (machine-intake design §16: "Leave factory credential
// working after rotation | BmcSecure refuses"). Identical to the positive
// control in every other reading; the published credential still opens a
// session, and the phase refuses.
test fn published_credential_still_working_refuses() -> Bool {
  let observation = rotation_observed(
    subj: intake_subject,
    previous_epoch: 0,
    bootstrap: bootstrap_accepted,
    reference: managed_reference,
    applied_at: rotation_at,
    managed: managed_accepted,
    census: census_two_lan,
    probes: [
      lan_probe(channel: channel_one, address: lan_228, outcome: published_accepted),
      lan_probe(channel: channel_eight, address: lan_231, outcome: published_rejected_231),
    ],
    account: published_account_retired,
  )
  let standing = derive_dev(observation: observation)
  refused_with(standing: standing, expected: PublishedCredentialStillAccepted { channel: channel_one }) && (is_secured(standing: standing) == false)
}

// UNESTABLISHED IS NOT RETIRED. An account service that did not answer must
// not certify that the published credential stopped working; widening the
// unknown into the good arm is the absorbing fallback DESIGN §5 names.
test fn published_credential_retirement_unestablished_refuses() -> Bool {
  let observation = rotation_observed(
    subj: intake_subject,
    previous_epoch: 0,
    bootstrap: bootstrap_accepted,
    reference: managed_reference,
    applied_at: rotation_at,
    managed: managed_accepted,
    census: census_two_lan,
    probes: [
      lan_probe(channel: channel_one, address: lan_228, outcome: CredentialProbeUnestablished { detail: "connection reset before the login response" }),
      lan_probe(channel: channel_eight, address: lan_231, outcome: published_rejected_231),
    ],
    account: published_account_retired,
  )
  refused_with(
    standing: derive_dev(observation: observation),
    expected: PublishedCredentialRetirementUnestablished { detail: "connection reset before the login response" },
  )
}

// A REJECTION READ BEFORE THE ROTATION IS NOT EVIDENCE ABOUT IT. The reading
// is the right one and the ordering makes it worthless: it describes whatever
// the controller answered before this attempt changed anything.
test fn published_probe_before_rotation_refuses() -> Bool {
  let observation = rotation_observed(
    subj: intake_subject,
    previous_epoch: 0,
    bootstrap: bootstrap_accepted,
    reference: managed_reference,
    applied_at: rotation_at,
    managed: managed_accepted,
    census: census_two_lan,
    probes: [
      lan_probe(channel: channel_one, address: lan_228, outcome: CredentialRejected { evidence: evidence(label: "published-login-401"), observed_at: 1788000002000 }),
      lan_probe(channel: channel_eight, address: lan_231, outcome: published_rejected_231),
    ],
    account: published_account_retired,
  )
  refused_with(
    standing: derive_dev(observation: observation),
    expected: PublishedCredentialProbePrecedesRotation { applied_at: rotation_at, probed_at: 1788000002000 },
  )
}

// RED 1. Census of two addresses: .228 rejects, .231 accepts. Count of probes
// equals members; identity join still refuses because one member accepts.
// MUTATION: published_probe_refusal CredentialAccepted -> none mints BmcSecured.
test fn split_lan_census_one_accepting_refuses() -> Bool {
  let observation = rotation_observed(
    subj: intake_subject,
    previous_epoch: 0,
    bootstrap: bootstrap_accepted,
    reference: managed_reference,
    applied_at: rotation_at,
    managed: managed_accepted,
    census: census_two_lan,
    probes: split_lan_probes(),
    account: published_account_retired,
  )
  refused_with(
    standing: derive_dev(observation: observation),
    expected: PublishedCredentialStillAccepted { channel: channel_eight },
  )
}

// RED 2. A single-address observation with no census must refuse, not
// adjudicate. MUTATION: replace CensusNotTaken with the retired single-host
// path (sole rejecting probe mints BmcSecured). Deleting the arm so the
// fold proceeds still refuses NoAddressableLanMember and is VOID.
test fn single_address_without_census_refuses() -> Bool {
  let observation = rotation_observed(
    subj: intake_subject,
    previous_epoch: 0,
    bootstrap: bootstrap_accepted,
    reference: managed_reference,
    applied_at: rotation_at,
    managed: managed_accepted,
    census: census_empty,
    probes: [lan_probe(channel: channel_one, address: lan_228, outcome: published_rejected)],
    account: published_account_retired,
  )
  refused_with(
    standing: derive_dev(observation: observation),
    expected: PublishedCredentialCensusNotTaken,
  )
}

// Equal probe/member counts without identity coverage is not coverage: ch8
// has no matching probe, a probe for a third address does not cover it.
test fn census_member_unprobed_refuses() -> Bool {
  let observation = rotation_observed(
    subj: intake_subject,
    previous_epoch: 0,
    bootstrap: bootstrap_accepted,
    reference: managed_reference,
    applied_at: rotation_at,
    managed: managed_accepted,
    census: census_two_lan,
    probes: [
      lan_probe(channel: channel_one, address: lan_228, outcome: published_rejected),
      lan_probe(channel: channel_two, address: ipv4_address(octet1: 192, octet2: 168, octet3: 1, octet4: 10), outcome: published_rejected_231),
    ],
    account: published_account_retired,
  )
  refused_with(
    standing: derive_dev(observation: observation),
    expected: PublishedCredentialCensusMemberUnprobed { channel: channel_eight },
  )
}

test fn published_probe_unmatched_refuses() -> Bool {
  let observation = rotation_observed(
    subj: intake_subject,
    previous_epoch: 0,
    bootstrap: bootstrap_accepted,
    reference: managed_reference,
    applied_at: rotation_at,
    managed: managed_accepted,
    census: census_two_lan,
    probes: concat(both_lan_rejecting(), [
      lan_probe(channel: channel_two, address: ipv4_address(octet1: 192, octet2: 168, octet3: 1, octet4: 10), outcome: published_rejected_231),
    ]),
    account: published_account_retired,
  )
  refused_with(
    standing: derive_dev(observation: observation),
    expected: PublishedCredentialProbeUnmatched { channel: channel_two },
  )
}

test fn published_probe_duplicate_refuses() -> Bool {
  let observation = rotation_observed(
    subj: intake_subject,
    previous_epoch: 0,
    bootstrap: bootstrap_accepted,
    reference: managed_reference,
    applied_at: rotation_at,
    managed: managed_accepted,
    census: census_two_lan,
    probes: [
      lan_probe(channel: channel_one, address: lan_228, outcome: published_rejected),
      lan_probe(channel: channel_one, address: lan_228, outcome: published_rejected),
      lan_probe(channel: channel_eight, address: lan_231, outcome: published_rejected_231),
    ],
    account: published_account_retired,
  )
  refused_with(
    standing: derive_dev(observation: observation),
    expected: PublishedCredentialProbeDuplicate { channel: channel_one },
  )
}

test fn serial_only_census_is_not_vacuous_secure() -> Bool {
  let observation = rotation_observed(
    subj: intake_subject,
    previous_epoch: 0,
    bootstrap: bootstrap_accepted,
    reference: managed_reference,
    applied_at: rotation_at,
    managed: managed_accepted,
    census: census_serial_only,
    probes: both_lan_rejecting(),
    account: published_account_retired,
  )
  refused_with(
    standing: derive_dev(observation: observation),
    expected: PublishedCredentialNoAddressableLanMember,
  )
}

test fn unaddressed_lan_member_is_not_a_rejection() -> Bool {
  let observation = rotation_observed(
    subj: intake_subject,
    previous_epoch: 0,
    bootstrap: bootstrap_accepted,
    reference: managed_reference,
    applied_at: rotation_at,
    managed: managed_accepted,
    census: census_with_unaddressed,
    probes: both_lan_rejecting(),
    account: published_account_retired,
  )
  refused_with(
    standing: derive_dev(observation: observation),
    expected: PublishedCredentialLanMemberUnaddressed { channel: channel_seven },
  )
