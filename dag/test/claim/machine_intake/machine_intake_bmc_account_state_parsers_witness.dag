module test.claim.machine_intake.machine_intake_bmc_account_state_parsers_witness

// PR A (PXE 1c, sharp-crane-14): witnesses for the PURE parse-carriers of the live BMC account-state read.
// Each parser is held to three things: it decodes a REAL committed capture (the bytes below are copied from
// the artifacts/bmc tree) into the served carrier; it returns the carrier's Not-Available shape when the
// parameter simply is not printed; and it returns the carrier's Read/Malformed failure shape -- never a
// silently-defaulted value -- when a field is present but cannot be held. One malformed red per parser.

import std.types { Bool, Int, NonEmptyStr, String }
import std.optional { Absent, Present }
import std.algebra { list_at_optional }
import gunbc.machine_intake.bmc_account_state_parsers {
  AccountEntryRead,
  AccountEntryUnreadable,
  AccountsCollectionRead,
  AccountsCollectionUnreadable,
  IpmiCensusAccepted,
  IpmiCensusAuthenticationRefused,
  IpmiCensusUnreadable,
  IpmiUserAccessRowsMalformed,
  IpmiUserAccessRowsRead,
  ipmi_authenticated_census_read,
  ipmi_lan_threshold_from_print,
  ipmi_user_access_rows,
  redfish_account_entry_from_body,
  redfish_account_names_from_collection,
  redfish_account_service_lockout_from_body,
}
import extdeps.bmc.redfish {
  RedfishAccountServiceLockoutPropertiesNotAuthenticated,
  RedfishAccountServiceLockoutPropertiesRead,
  RedfishAccountServiceLockoutPropertiesUnreadable,
}
import extdeps.bmc.ipmi_channel {
  IpmiChannelNumber,
  IpmiLanBadPasswordThresholdNotAvailable,
  IpmiLanBadPasswordThresholdRead,
  IpmiLanBadPasswordThresholdReadFailed,
  IpmiLanBadPasswordThresholdVerdict,
  IpmiPrivilegeAdministrator,
  IpmiPrivilegeNoAccess,
  IpmiPrivilegeOem,
}

// THE COMMITTED H11SSL (ALTRAD8UD-class Supermicro) `ipmitool lan print 1` CAPTURE, its lockout lines copied
// verbatim from artifacts/bmc/h11ssl-unit1-ipmitool-2026-10-27/lan-print-1.txt (the file is on host 192.168.1.252,
// MAC ac:1f:6b:e3:f5:7b, DHCP; the four lockout parameters read 3 / yes / 300 / 300).
fn h11ssl_lan_print_capture() -> String {
  join(
    [
      "Set in Progress         : Set Complete",
      "Auth Type Support       : NONE MD2 MD5 PASSWORD ",
      "IP Address Source       : DHCP Address",
      "IP Address              : 192.168.1.252",
      "MAC Address             : ac:1f:6b:e3:f5:7b",
      "802.1q VLAN ID          : Disabled",
      "Bad Password Threshold  : 3",
      "Invalid password disable: yes",
      "Attempt Count Reset Int.: 300",
      "User Lockout Interval   : 300",
    ],
    "\n",
  )
}

// HAPPY: the real capture decodes to the served threshold with the four parameters the budget gate reads.
test fn the_h11ssl_lan_print_capture_decodes_the_served_threshold() -> Bool {
  let verdict = ipmi_lan_threshold_from_print(text: h11ssl_lan_print_capture(), channel: 1)
  match verdict {
    IpmiLanBadPasswordThresholdRead { channel: _, served: s } =>
      s.invalid_password_disable &&
        s.bad_password_threshold == 3 &&
        s.attempt_count_reset_secs == 300 &&
        s.user_lockout_interval_secs == 300
    _ => false
  }
}

// NOT-AVAILABLE: a capture that never prints the parameter is Not-Available, never a threshold of zero.
test fn a_capture_without_the_threshold_is_not_available() -> Bool {
  let verdict =
    ipmi_lan_threshold_from_print(
      text: "IP Address Source       : DHCP Address\nIP Address              : 192.168.1.9",
      channel: 1,
    )
  match verdict {
    IpmiLanBadPasswordThresholdNotAvailable { channel: _ } => true
    _ => false
  }
}

// MALFORMED RED: a threshold that is present but not a byte-sized count is ReadFailed, never a default.
test fn a_malformed_threshold_is_read_failed_never_a_default() -> Bool {
  let verdict =
    ipmi_lan_threshold_from_print(
      text: "Bad Password Threshold  : oops\nInvalid password disable: yes\nAttempt Count Reset Int.: 300\nUser Lockout Interval   : 300",
      channel: 1,
    )
  match verdict {
    IpmiLanBadPasswordThresholdReadFailed { channel: _, detail: _ } => true
    _ => false
  }
}

// The committed `ipmitool user list 1` / Get User Access table from the mtjade1 read-only probe
// (artifacts/bmc/mtjade1-readonly-probe-192.168.1.246-20261006T184626Z/user_list_1.txt), verbatim:
// fifteen id slots, the two named administrators, a named OEM slot, and the unnamed NO ACCESS slots.
// ALL FIFTEEN ROWS DECODE: ids, privileges and channel, nameless slots included. Every row the capture
// prints becomes exactly one carrier row -- a dropped or defaulted row (a missing slot quietly turned
// into No Access that was really OEM) turns this red.
test fn the_committed_getaccess_table_decodes_every_row() -> Bool {
  let getaccess_capture = "ID  Name\t             Callin  Link Auth\tIPMI Msg\tChannel Priv Limit\n1   admin            false   false      true       ADMINISTRATOR\n2   operator           false   false      true       ADMINISTRATOR\n3                  true    false      false      NO ACCESS\n4   OEM                false   false      true       OEM\n5                  false   false      false      NO ACCESS\n6                  false   false      false      NO ACCESS\n7                  false   false      false      NO ACCESS\n8                  false   false      false      NO ACCESS\n9                  false   false      false      NO ACCESS\n10                 false   false      false      NO ACCESS\n11                 false   false      false      NO ACCESS\n12                 false   false      false      NO ACCESS\n13                 false   false      false      NO ACCESS\n14                 false   false      false      NO ACCESS\n15                 false   false      false      NO ACCESS\n"
  match ipmi_user_access_rows(text: getaccess_capture, channel: 1) {
    IpmiUserAccessRowsRead { rows: rows } =>
      rows.length() == 15
        && (match list_at_optional(xs: rows, index: 0) {
             Present { value: r } => r.user == 1 && r.channel == 1 && r.privilege == IpmiPrivilegeAdministrator
             Absent => false
           })
        && (match list_at_optional(xs: rows, index: 1) {
             Present { value: r } => r.user == 2 && r.privilege == IpmiPrivilegeAdministrator
             Absent => false
           })
        && (match list_at_optional(xs: rows, index: 2) {
             Present { value: r } => r.user == 3 && r.privilege == IpmiPrivilegeNoAccess
             Absent => false
           })
        && (match list_at_optional(xs: rows, index: 3) {
             Present { value: r } => r.user == 4 && r.privilege == IpmiPrivilegeOem
             Absent => false
           })
        && (match list_at_optional(xs: rows, index: 14) {
             Present { value: r } => r.user == 15 && r.privilege == IpmiPrivilegeNoAccess
             Absent => false
           })
    IpmiUserAccessRowsMalformed { detail: _ } => false
  }
}

// AN UNKNOWN PRIVILEGE WORD REFUSES with the offending line, never a silently defaulted row. The
// same bytes through a parser that fell back to No Access on an unrecognized word would pass -- that
// is the failure this red pins.
test fn a_malformed_privilege_word_refuses_never_a_defaulted_row() -> Bool {
  let bad = "ID  Name\t             Callin  Link Auth\tIPMI Msg\tChannel Priv Limit\n1   admin            false   false      false      SUPERVISOR\n"
  match ipmi_user_access_rows(text: bad, channel: 1) {
    IpmiUserAccessRowsMalformed { detail: detail } => detail == "1   admin            false   false      false      SUPERVISOR"
    IpmiUserAccessRowsRead { rows: _ } => false
  }
}

// A FLAG COLUMN OF GARBAGE REFUSES TOO: the carrier does not model the Callin / Link Auth / IPMI Msg
// cells, but their shape is validated, so a shifted or corrupted row cannot masquerade as a row.
test fn a_flag_column_of_garbage_refuses_though_the_carrier_drops_the_flags() -> Bool {
  let bad = "1   admin            false   maybe      true       ADMINISTRATOR"
  match ipmi_user_access_rows(text: bad, channel: 1) {
    IpmiUserAccessRowsMalformed { detail: detail } => detail == bad
    IpmiUserAccessRowsRead { rows: _ } => false
  }
}

// ==================== THE AUTHENTICATED CENSUS READ (managed acceptance, review 93420) ====================

// THE ACCEPTED ARM. A well-formed user-access table -- the authenticated managed read serving the census --
// reads as Accepted WITH its rows: that success is the evidence the controller accepts the managed
// credential. (The assembler maps this arm to managed_accepted: true.)
test fn an_authenticated_census_table_reads_as_accepted_with_its_rows() -> Bool {
  let table = "ID  Name\t             Callin  Link Auth\tIPMI Msg\tChannel Priv Limit\n1   root             false   false      true       ADMINISTRATOR\n"
  match ipmi_authenticated_census_read(text: table, channel: 1) {
    IpmiCensusAccepted { rows: rows } => rows.length() == 1 && (match list_at_optional(xs: rows, index: 0) {
      Present { value: r } => r.user == 1 && r.channel == 1 && r.privilege == IpmiPrivilegeAdministrator
      Absent => false
    })
    _ => false
  }
}

// THE REFUSED ARM (never malformed). An authenticated census read the controller refused -- the RMCP+
// session never came up (also the RAKP-2-HMAC wrong-password line) -- is AuthenticationRefused with the
// vendor line carried, NOT Malformed and NOT Accepted. This is the case the assembler turns into
// managed_accepted: false; a permissive classifier that read it as an empty/malformed table would be a red.
test fn a_refused_authenticated_census_is_read_as_refused_never_malformed() -> Bool {
  let session = match ipmi_authenticated_census_read(text: "Error: Unable to establish IPMI v2 / RMCP+ session", channel: 8) {
    IpmiCensusAuthenticationRefused { detail: d } => d == "Unable to establish IPMI v2 / RMCP+ session"
    _ => false
  }
  let rakp = match ipmi_authenticated_census_read(text: "Error (0): RAKP 2 HMAC is invalid", channel: 8) {
    IpmiCensusAuthenticationRefused { detail: d } => d == "RAKP 2 HMAC is invalid"
    _ => false
  }
  session && rakp
}

// EMPTY IS NEVER A REFUSAL. An absent read (empty body) is Unreadable, not AuthenticationRefused: a read that
// did not happen is not a controller that refused the credential (fail_closed -- a reading that cannot look is
// never reported as a refusal, just as it is never a reading). The assembler refuses on this arm rather than
// minting managed_accepted:false on nothing.
test fn an_empty_census_is_unreadable_never_a_refused_reading() -> Bool {
  match ipmi_authenticated_census_read(text: "", channel: 8) {
    IpmiCensusUnreadable { detail: _ } => true
    _ => false
  }
}

// GARBAGE IS NEVER A DEFAULTED ACCEPTANCE. A body that is neither a table nor a recognized refusal is
// Unreadable -- the assembler refuses rather than defaulting managed_accepted to anything. No plausible
// acceptance is fabricated from bytes that say nothing.
test fn a_garbage_census_is_unreadable_never_a_defaulted_acceptance() -> Bool {
  match ipmi_authenticated_census_read(text: "check-password: ok token invoked lookup successful", channel: 8) {
    IpmiCensusUnreadable { detail: _ } => true
    _ => false
  }
}

// ==================== REDFISH PARSER WITNESSES ====================

// The COMMITTED srv13 first-contact Accounts collection
// (artifacts/bmc/srv13-first-contact-2026-10-07/Accounts.json, OpenBMC 3.22.00), verbatim. One
// member (root); the count agrees with the array.
test fn the_committed_srv13_accounts_collection_decodes_its_members() -> Bool {
  let body = "{\"@odata.id\":\"/redfish/v1/AccountService/Accounts\",\"Members\":[{\"@odata.id\":\"/redfish/v1/AccountService/Accounts/root\"}],\"Members@odata.count\":1}"
  match redfish_account_names_from_collection(body: body) {
    AccountsCollectionRead { names: names } =>
      names.length() == 1 && (match list_at_optional(xs: names, index: 0) {
        Present { value: n } => n == "root"
        Absent => false
      })
    AccountsCollectionUnreadable { detail: _ } => false
  }
}

// A controller that CONTRADICTS ITSELF -- Members@odata.count 2 over a one-member array -- is
// Unreadable. A parser that trusted the count, or counted silently and moved on, would mint a census
// from bytes the controller does not stand behind: that is the red this pins.
test fn a_collection_whose_count_contradicts_its_members_is_unreadable() -> Bool {
  let body = "{\"Members\":[{\"@odata.id\":\"/redfish/v1/AccountService/Accounts/root\"}],\"Members@odata.count\":2}"
  match redfish_account_names_from_collection(body: body) {
    AccountsCollectionUnreadable { detail: _ } => true
    AccountsCollectionRead { names: _ } => false
  }
}

// ONE ManagerAccount body (the OpenBMC 3.22.00 bmcweb shape: UserName + Enabled -- no committed
// member capture exists in artifacts/, so the bytes are the documented bmcweb 3.22.00 shape; the
// first wet run commits the real one). The managed flag is derived from the BODY's UserName, not
// the URL the body was fetched from.
test fn the_manager_account_body_decodes_name_enabled_and_identity() -> Bool {
  let body = "{\"@odata.id\":\"/redfish/v1/AccountService/Accounts/root\",\"UserName\":\"root\",\"Enabled\":true}"
  match redfish_account_entry_from_body(body: body, managed_name: "root") {
    AccountEntryRead { entry: e } => e.name == "root" && e.enabled && e.is_managed_account
    AccountEntryUnreadable { detail: _ } => false
  }
}

// NO Enabled, NO ANSWER: the carrier models enabled, so a body without it refuses. Defaulting it to
// true (the property's typical value) would mint a census that says an unproved account is live --
// the exact fabrication this red pins.
test fn a_manager_account_without_enabled_is_unreadable_never_defaulted() -> Bool {
  let body = "{\"UserName\":\"root\"}"
  match redfish_account_entry_from_body(body: body, managed_name: "root") {
    AccountEntryUnreadable { detail: _ } => true
    AccountEntryRead { entry: _ } => false
  }
}

// THE ACCOUNTSERVICE LOCKOUT DOCUMENT (bmcweb 3.22.00 shape; no committed AccountService capture
// exists in artifacts/ yet -- the first wet run commits one, and that run is what discharges
// redfish_account_service_lockout_live_read_frontier). Required threshold decoded; the optional
// window properties decoded alongside. Built ONLY through the cited sole constructor.
test fn the_openbmc_account_service_body_decodes_the_lockout_props() -> Bool {
  let body = "{\"AccountLockoutThreshold\":3,\"AccountLockoutDuration\":600,\"AccountLockoutCounterResetAfter\":600,\"AccountLockoutCounterResetEnabled\":true}"
  match redfish_account_service_lockout_from_body(body: body) {
    RedfishAccountServiceLockoutPropertiesRead { served: served } =>
      served.account_lockout_threshold == 3
        && (match served.account_lockout_duration { Present { value: d } => d == 600 Absent => false })
        && (match served.account_lockout_counter_reset_after { Present { value: a } => a == 600 Absent => false })
        && (match served.account_lockout_counter_reset_enabled { Present { value: e } => e Absent => false })
    RedfishAccountServiceLockoutPropertiesUnreadable { detail: _ } => false
    RedfishAccountServiceLockoutPropertiesNotAuthenticated { http_status: _, detail: _ } => false
  }
}

// NO THRESHOLD IS NOT ZERO: an AccountService body without AccountLockoutThreshold refuses -- never
// a zero that would read as "never locks" and open the budget gate wide (extdeps.bmc.redfish says
// the same of absent thresholds; this pins it at the parse boundary).
test fn an_account_service_without_a_threshold_is_unreadable_never_zero() -> Bool {
  let body = "{\"AccountLockoutDuration\":600}"
  match redfish_account_service_lockout_from_body(body: body) {
    RedfishAccountServiceLockoutPropertiesUnreadable { detail: _ } => true
    RedfishAccountServiceLockoutPropertiesRead { served: _ } => false
    RedfishAccountServiceLockoutPropertiesNotAuthenticated { http_status: _, detail: _ } => false
  }
}
