module test.claim.machine_intake_bmc_secure_state_forged_probe_witness

import std.types { String, Bool, Int, List }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import gunbc.compile_diagnostic_census {
  CompileDiagnosticCensus, CompileDiagnosticCensusRow, CensusObserved, CensusNotRunnable,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE STATE-SHAPED BmcSecure SEALS AND THE OBSERVER CLOCK, ENROLLED AS EXECUTED REDS (cut O1b). The
// probe source below authors every sealed carrier of the phase outside its module -- an observer
// instant, a stored and a fetched credential generation, an application receipt and the phase receipt
// -- calls the modeled-clock mint from a caller it does not admit, and places a controller's own clock
// reading in an ordering field. This witness hands that source to the compiler through the
// diagnostic-census harness and requires each refusal CLASS at its SUBJECT by name, so a probe refusing
// for another reason measures another wall; the class-scoped control shows a clean source reading the
// same modules emits none of them.
data forged_probe_source: String = "module probe_bmc_secure_state_forged\n\nimport std.types { Bool, EpochMs, List, NonEmptyStr, String }\nimport std.content_hash { content_hash_of_value }\nimport gunbc.clock_read { ObserverClockInstant, ObserverClockModeled, observer_clock_modeled }\nimport gunbc.machine_intake_receipt { EvidenceRef }\nimport gunbc.machine_intake_bmc_rotation_route { BmcRotationRouteStanding }\nimport test.claim.machine_intake_bmc_secure_state_witness { cited_lab_route_managed_user, read, read_with, read_in, secured_read }\nimport gunbc.machine_intake_subject { MachineIntakeSubject }\nimport extdeps.bmc.endpoint { BmcControllerEndpoint }\nimport extdeps.bmc.capability { BmcFirmwareReleaseIdentity }\nimport extdeps.bmc.ipmi_channel { IpmiControllerChannelCensus }\nimport gunbc.machine_intake_bmc_secure {\n  ControllerClockReading, ObservedCredentialProbe, ObservedCredentialAccepted,\n  ManagedCredentialGenerationStored, ManagedCredentialGenerationFetched, BmcAccountActionPlan,\n  BmcAccountApplication, BmcSecurePhaseReceipt, BmcAccountStateObservation,\n  ManagedCredentialReference, ObservedPublishedAccount, observed_bmc_account_state,\n  ObservedReading, PublishedAccountKind, project_managed_administrator_readback,\n  dry_bmc_account_instant, observed_reading, observed_published_account, dry_read_bmc_account_state, dry_apply_bmc_account_plan, BmcAccountDryStep,\n  dry_probe, dry_published_lan_probes, ObservedPublishedLanProbe,\n}\nimport gunbc.bmc_model { BmcWorld }\nimport gunbc.auth.secret_ref_credential { SecretCredentialFetch }\nimport std.scoped_authorization { AttemptIdentity }\nimport gunbc.machine_intake_bmc_rotation_route { ManagedAdministratorReadback }\n\nfn evidence() -> EvidenceRef {\n  EvidenceRef { label: \"forged\", digest: content_hash_of_value(value: \"forged\" as NonEmptyStr) }\n}\n\nfn forged_instant() -> ObserverClockInstant {\n  ObserverClockInstant { millis: 946684800000, source: ObserverClockModeled { realization: \"forged\" } }\n}\n\nfn forged_modeled_instant() -> ObserverClockInstant {\n  observer_clock_modeled(millis: 946684800000, realization: \"forged\" as NonEmptyStr)\n}\n\nfn controller_time_as_read_floor(\n  subject: MachineIntakeSubject,\n  endpoint: BmcControllerEndpoint,\n  firmware: BmcFirmwareReleaseIdentity,\n  managed: ManagedCredentialReference,\n  reading: ControllerClockReading,\n  probe: ObservedCredentialProbe,\n  census: IpmiControllerChannelCensus,\n  instant: ObserverClockInstant,\n  account: ObservedPublishedAccount,\n) -> BmcAccountStateObservation {\n  observed_bmc_account_state(\n    subject: subject,\n    endpoint: endpoint,\n    firmware: firmware,\n    managed: managed,\n    managed_user: 3,\n    attempt: \"forged\" as AttemptIdentity,\n    read_floor: reading,\n    managed_probe: probe,\n    channel_census: census,\n    census_evidence: evidence(),\n    census_observed_at: instant,\n    published_probes: [],\n    published_user: 2,\n    published_account: account,\n    break_glass: managed,\n    break_glass_probe: probe,\n    controller_clock: none,\n  )\n}\n\nfn readback_through_the_projection(o: BmcAccountStateObservation) -> ManagedAdministratorReadback? {\n  project_managed_administrator_readback(observed: o)\n}\n\nfn outside_instant(m: EpochMs) -> ObserverClockInstant {\n  dry_bmc_account_instant(millis: m)\n}\n\nfn outside_reading(at: ObserverClockInstant) -> ObservedReading {\n  observed_reading(evidence: evidence(), observed_at: at)\n}\n\nfn outside_published_account(k: PublishedAccountKind, at: ObserverClockInstant) -> ObservedPublishedAccount {\n  observed_published_account(kind: k, evidence: evidence(), observed_at: at)\n}\n\nfn outside_dry_read(w: BmcWorld, subject: MachineIntakeSubject, endpoint: BmcControllerEndpoint, firmware: BmcFirmwareReleaseIdentity, managed: ManagedCredentialReference, census: IpmiControllerChannelCensus, k: PublishedAccountKind) -> BmcAccountStateObservation {\n  dry_read_bmc_account_state(world: w, subject: subject, endpoint: endpoint, firmware: firmware, managed: managed, managed_user: 3, managed_password: \"x\", census: census, published_user: 2, published_password: \"x\", published_account: k, break_glass: managed, break_glass_password: \"x\", attempt: \"forged\" as AttemptIdentity, read_at_millis: 946684800000)\n}\n\nfn outside_dry_apply(w: BmcWorld, p: BmcAccountActionPlan, f: SecretCredentialFetch) -> BmcAccountDryStep {\n  dry_apply_bmc_account_plan(world: w, plan: p, managed_fetch: f, published_fetch: f, applied_at_millis: 946684800000)\n}\n\nfn outside_read(w: BmcWorld, subject: MachineIntakeSubject, managed: ManagedCredentialReference) -> BmcAccountStateObservation {\n  read(w: w, subject: subject, managed: managed, managed_password: \"x\", closed: true, at: 946684800000)\n}\n\nfn outside_read_with(w: BmcWorld, subject: MachineIntakeSubject, managed: ManagedCredentialReference, census: IpmiControllerChannelCensus, k: PublishedAccountKind) -> BmcAccountStateObservation {\n  read_with(w: w, subject: subject, managed: managed, managed_password: \"x\", census_value: census, account: k, at: 946684800000)\n}\n\nfn outside_read_in(w: BmcWorld, subject: MachineIntakeSubject, managed: ManagedCredentialReference, census: IpmiControllerChannelCensus, k: PublishedAccountKind) -> BmcAccountStateObservation {\n  read_in(w: w, subject: subject, managed: managed, managed_password: \"x\", census_value: census, account: k, attempt: \"forged\", at: 946684800000)\n}\n\nfn outside_secured_read(census: IpmiControllerChannelCensus, k: PublishedAccountKind) -> BmcAccountStateObservation {\n  secured_read(census_value: census, account: k)\n}\n\nfn outside_dry_probe(w: BmcWorld, at: ObserverClockInstant) -> ObservedCredentialProbe {\n  dry_probe(world: w, user: 3, password: \"x\", what: \"forged\", at: at)\n}\n\nfn outside_dry_published_lan_probes(w: BmcWorld, census: IpmiControllerChannelCensus, at: ObserverClockInstant) -> List<ObservedPublishedLanProbe> {\n  dry_published_lan_probes(world: w, census: census, published_user: 2, published_password: \"x\", at: at)\n}\n\nfn forged_stored(s: ManagedCredentialGenerationStored) -> ManagedCredentialGenerationStored {\n  ManagedCredentialGenerationStored { reference: s.reference, stored_version: s.stored_version, stored_at: s.stored_at }\n}\n\nfn forged_fetched(s: ManagedCredentialGenerationStored) -> ManagedCredentialGenerationFetched {\n  ManagedCredentialGenerationFetched { stored: s, fetched_at: s.stored_at }\n}\n\nfn forged_application(p: BmcAccountActionPlan) -> BmcAccountApplication {\n  BmcAccountApplication {\n    plan: p,\n    managed_write_completed: true,\n    published_write_completed: true,\n    request_receipt: evidence(),\n    response_receipt: evidence(),\n    applied_at: p.planned_at,\n  }\n}\n\nfn forged_receipt(r: BmcSecurePhaseReceipt) -> BmcSecurePhaseReceipt {\n  BmcSecurePhaseReceipt { subject: r.subject, phase: r.phase, goal: r.goal, decision: r.decision, held: r.held }\n}\n\nfn forged_plan(p: BmcAccountActionPlan) -> BmcAccountActionPlan {\n  BmcAccountActionPlan {\n    subject: p.subject,\n    endpoint: p.endpoint,\n    firmware: p.firmware,\n    goal: p.goal,\n    diverged: p.diverged,\n    due: p.due,\n    managed_write: p.managed_write,\n    published_write: p.published_write,\n    planned_at: p.planned_at,\n  }\n}\n\nfn forged_observation(o: BmcAccountStateObservation) -> BmcAccountStateObservation {\n  BmcAccountStateObservation {\n    subject: o.subject,\n    endpoint: o.endpoint,\n    managed: o.managed,\n    read_floor: o.read_floor,\n    managed_probe: o.managed_probe,\n    channel_census: o.channel_census,\n    census_evidence: o.census_evidence,\n    census_observed_at: o.census_observed_at,\n    published_probes: o.published_probes,\n    published_user: o.published_user,\n    published_account: o.published_account,\n    controller_clock: o.controller_clock,\n  }\n}\n\nfn controller_time_in_a_reading_field(reading: ControllerClockReading) -> ObservedReading {\n  ObservedReading { evidence: evidence(), observed_at: reading }\n}\n\nfn controller_time_in_an_account_field(kind: PublishedAccountKind, reading: ControllerClockReading) -> ObservedPublishedAccount {\n  ObservedPublishedAccount { kind: kind, evidence: evidence(), observed_at: reading }\n}\n\nfn borrowed_fixture_route() -> BmcRotationRouteStanding {\n  cited_lab_route_managed_user()\n}\n"

data harness_control_source: String = "module probe_bmc_secure_state_harness_control\nimport gunbc.machine_intake_bmc_secure { BmcSecurePhaseReceipt, bmc_secure_phase_receipt_evidence }\nimport gunbc.machine_intake_receipt { EvidenceRef }\nimport std.types { List }\nfn evidence_of(r: BmcSecurePhaseReceipt) -> List<EvidenceRef> { bmc_secure_phase_receipt_evidence(receipt: r) }\n"

fn probe() -> CompileDiagnosticCensus {
  compile_dag_diagnostic_census(forged_probe_source)
}

fn blocking_count_for_class_and_subject(c: CompileDiagnosticCensus, wanted: String, subject: String) -> Int {
  match c {
    CensusNotRunnable { cause: _ } => -1
    CensusObserved { rows: rows } =>
      rows
        |> filter(r => (r.diagnostic_class as String) == wanted && r.subject_name == subject && r.blocking)
        |> fold(init: 0, f: (acc, r) => acc + r.count)
  }
}

fn blocking_count_for_class(c: CompileDiagnosticCensus, wanted: String) -> Int {
  match c {
    CensusNotRunnable { cause: _ } => -1
    CensusObserved { rows: rows } =>
      rows |> filter(r => (r.diagnostic_class as String) == wanted && r.blocking) |> fold(init: 0, f: (acc, r) => acc + r.count)
  }
}



test fn the_harness_runs_and_a_clean_source_emits_none_of_the_wall_classes() -> Bool {
  let c = compile_dag_diagnostic_census(harness_control_source)
  blocking_count_for_class(c: c, wanted: "SoleConstructorViolation") == 0
    && blocking_count_for_class(c: c, wanted: "ConstructorCallAdmissionRefused") == 0
    && blocking_count_for_class(c: c, wanted: "DeclaredTypeNotInhabited") == 0
}

// Every carrier of the phase is unwritable outside its module: the observer instant, the observation,
// the stored and fetched generations, the plan, the application receipt and the phase receipt.
test fn every_sealed_carrier_of_the_phase_refuses_a_foreign_literal() -> Bool {
  let c = probe()
  blocking_count_for_class_and_subject(c: c, wanted: "SoleConstructorViolation", subject: "ObserverClockInstant") >= 1
    && blocking_count_for_class_and_subject(c: c, wanted: "SoleConstructorViolation", subject: "BmcAccountStateObservation") >= 1
    && blocking_count_for_class_and_subject(c: c, wanted: "SoleConstructorViolation", subject: "ManagedCredentialGenerationStored") >= 1
    && blocking_count_for_class_and_subject(c: c, wanted: "SoleConstructorViolation", subject: "ManagedCredentialGenerationFetched") >= 1
    && blocking_count_for_class_and_subject(c: c, wanted: "SoleConstructorViolation", subject: "BmcAccountActionPlan") >= 1
    && blocking_count_for_class_and_subject(c: c, wanted: "SoleConstructorViolation", subject: "BmcAccountApplication") >= 1
    && blocking_count_for_class_and_subject(c: c, wanted: "SoleConstructorViolation", subject: "BmcSecurePhaseReceipt") >= 1
}

// The modeled observer clock, and the witness's fixture-citation route helper, refuse a caller they
// do not admit.
test fn the_modeled_observer_clock_refuses_an_outside_caller() -> Bool {
  blocking_count_for_class_and_subject(c: probe(), wanted: "ConstructorCallAdmissionRefused", subject: "observer_clock_modeled") >= 1
    && blocking_count_for_class_and_subject(c: probe(), wanted: "ConstructorCallAdmissionRefused", subject: "cited_lab_route_managed_user") >= 1
}

// THE FIELD ROUTE. A controller reading placed in an ordering FIELD is the route the compiler defect
// leaves open (gunbc.recurring_failure_mode record_field_admits_a_distinct_product_value), so every
// record carrying an observer instant is sealed and the literal refuses at the seal.
test fn a_controller_clock_reading_in_an_ordering_field_refuses_at_the_seal() -> Bool {
  let c = probe()
  blocking_count_for_class_and_subject(c: c, wanted: "SoleConstructorViolation", subject: "ObservedReading") >= 1
    && blocking_count_for_class_and_subject(c: c, wanted: "SoleConstructorViolation", subject: "ObservedPublishedAccount") >= 1
}

// A controller's own clock reading cannot be passed as the observation's read floor, the ordering
// field every reading is judged against. SCOPE, stated so the wall is not read wider than it is: the
// refusal is at the CALL-ARGUMENT position. A non-literal ControllerClockReading placed in an
// ObserverClockInstant RECORD FIELD is accepted today -- gunbc.recurring_failure_mode
// record_field_admits_a_distinct_product_value, which carries this specimen -- so the sealed
// observation mint is the route this claim covers.
// SINCE cut O1a-2 THE OBSERVATION MINT ADMITS ONLY THE DRY READ. The call above, which hands a
// controller's clock reading to the mint as the read floor, now refuses at the mint's admission, so no
// caller outside the dry realization can choose the read floor at all; the dry read derives it from its
// own modeled observer schedule, and the live read is bmc_secure_state_live_read_frontier. The wall is
// therefore construction-level (who may mint), where it was an argument-type refusal before, and that
// argument-type refusal is no longer emitted because the call no longer reaches argument judgement.
test fn a_controller_clock_reading_cannot_be_the_read_floor() -> Bool {
  blocking_count_for_class_and_subject(c: probe(), wanted: "ConstructorCallAdmissionRefused", subject: "observed_bmc_account_state") >= 1
}

// THE PROJECTION IS NOT A CONSTRUCTOR PROXY (side-chat review of 8960bbe511). An outside call to
// project_managed_administrator_readback -- the function that returns the sealed readback -- refuses at
// its admission, as does an outside call to the observation's own mint.
test fn the_readback_projection_and_the_observation_mint_refuse_an_outside_caller() -> Bool {
  let c = probe()
  blocking_count_for_class_and_subject(c: c, wanted: "ConstructorCallAdmissionRefused", subject: "project_managed_administrator_readback") >= 1
    && blocking_count_for_class_and_subject(c: c, wanted: "ConstructorCallAdmissionRefused", subject: "observed_bmc_account_state") >= 1
}

// THE DRY REALIZATION'S MINTS ARE NOT CONSTRUCTOR PROXIES (follow-up to #13242). An outside call turning
// a number into a sealed observer instant, a reading or a published-account reading, or reaching the dry
// read or the dry apply with a chosen schedule, refuses at the function's admission. The seed does not
// refuse a record at an EpochMs formal (gunbc#13385), so these admissions are the wall.
test fn the_dry_realization_mints_refuse_an_outside_caller() -> Bool {
  let c = probe()
  blocking_count_for_class_and_subject(c: c, wanted: "ConstructorCallAdmissionRefused", subject: "dry_bmc_account_instant") >= 1
    && blocking_count_for_class_and_subject(c: c, wanted: "ConstructorCallAdmissionRefused", subject: "observed_reading") >= 1
    && blocking_count_for_class_and_subject(c: c, wanted: "ConstructorCallAdmissionRefused", subject: "observed_published_account") >= 1
    && blocking_count_for_class_and_subject(c: c, wanted: "ConstructorCallAdmissionRefused", subject: "dry_read_bmc_account_state") >= 1
    && blocking_count_for_class_and_subject(c: c, wanted: "ConstructorCallAdmissionRefused", subject: "dry_apply_bmc_account_plan") >= 1
}

// THE READ HELPERS ARE NOT CONSTRUCTOR PROXIES EITHER (side-chat review of 99ade6b1d5). An outside call
// through each wrapper that returns a sealed observation or reading -- the witness's read, read_with,
// read_in and secured_read, and the dry realization's dry_probe and dry_published_lan_probes -- refuses
// at that wrapper's own admission, not only at the mints beneath it.
test fn the_read_helpers_refuse_an_outside_caller() -> Bool {
  let c = probe()
  blocking_count_for_class_and_subject(c: c, wanted: "ConstructorCallAdmissionRefused", subject: "read") >= 1
    && blocking_count_for_class_and_subject(c: c, wanted: "ConstructorCallAdmissionRefused", subject: "read_with") >= 1
    && blocking_count_for_class_and_subject(c: c, wanted: "ConstructorCallAdmissionRefused", subject: "read_in") >= 1
    && blocking_count_for_class_and_subject(c: c, wanted: "ConstructorCallAdmissionRefused", subject: "secured_read") >= 1
    && blocking_count_for_class_and_subject(c: c, wanted: "ConstructorCallAdmissionRefused", subject: "dry_probe") >= 1
    && blocking_count_for_class_and_subject(c: c, wanted: "ConstructorCallAdmissionRefused", subject: "dry_published_lan_probes") >= 1
}
