  BmcSecureGoal {
    managed: ManagedCredentialReference {
      account: "gunbc",
      role: AccountRoleAdministrator,
      secret: SecretRef { project: "gunbai-secrets", secret: "bmc-lab-o1b-gunbc", version: "1", hash_state: HashPending },
      credential_epoch: 1,
    },
    published_break_glass: ManagedCredentialReference {
      account: "admin",
      role: AccountRoleAdministrator,
      secret: SecretRef { project: "gunbai-secrets", secret: "bmc-lab-o1b-admin", version: "4", hash_state: HashPending },
      credential_epoch: 4,
