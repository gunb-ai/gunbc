data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// CUT O1c-1, THE ARRIVAL PREFIX OVER THE CONVERGENCE FOLD. The first claim is the ONE execution of
// the real path (DESIGN §3 pairing obligation): mtjade1's committed current read goes through both
// protocol steps, the census-joined and rank-checked plan, and the fold, and the claim asserts the
// ROUTE -- which instance converged with which receipt fields, and the typed refusal the line stopped
// on -- not only the verdict. The controls after it reuse that real read; where one supplies a value
// (a board serial, an approval, a census with a doubled row) the comment beside it says which.

data run_a: ConvergenceRunId = "o1c1-witness-run-a" as ConvergenceRunId

data run_b: ConvergenceRunId = "o1c1-witness-run-b" as ConvergenceRunId

data mtjade1_key: StepSubjectKey = "mtjade1" as StepSubjectKey

fn instance_step_is(s: StepInstanceStanding<ArrivalStepReceipt, ArrivalStepRefusal>, step: DeclarationRef) -> Bool {
  match s {
    InstanceConverged { key: k, receipt: _ } => declaration_ref_eq(a: k.step_identity, b: step)
    InstanceRefused { key: k, cause: _ } => declaration_ref_eq(a: k.step_identity, b: step)
    InstanceNotReached { key: k, blocked_by: _ } => declaration_ref_eq(a: k.step_identity, b: step)
  }
}

fn route_is_redfish_write_candidate_on_manager_read(route: BmcRotationRouteStanding) -> Bool {
  match route.grounding {
    RouteQualificationCandidate { request: r, evidence: e } =>
      (match r { RedfishAccountPasswordWrite { transport_operation: _, action_shape: _ } => true  IpmiSetUserPassword { user: _ } => false })
        && (match e { ObservedSurfaceRead { surface: _, receipt: rc } => (rc.label as String) == "artifacts/bmc/mtjade1-redfish-manager-self-192.168.1.246-2026-10-04T043605Z.json"  PublicStandardOperation { authority: _ } => false })
    RouteGroundedByExecutedRequest { request: _, request_receipt: _, response_receipt: _ } => false
    RouteGroundedByCitedSource { request: _, citation: _ } => false
    RouteUngrounded => false
  }
}

fn access_established_as_read(s: StepInstanceStanding<ArrivalStepReceipt, ArrivalStepRefusal>) -> Bool {
  match s {
    InstanceConverged { key: k, receipt: r } =>
      declaration_ref_eq(a: k.step_identity, b: access_discover_step_ref)
        && match r {
          AccessDiscoverReceipt { receipt: a } =>
            (a.access.endpoint.host as String) == "192.168.1.246"
              && (a.access.firmware.raw_version as String) == "2.11.104000"
              && (match a.access.family { AmiMegaRac => true  OpenBmc => false })
              && (match a.access.controller_clock { ControllerClockRendered { rendering: t } => (t as String) == "2000-02-28T20:29:01-05:00"  ControllerClockUnread { cause: _ } => false })
              && (a.route.endpoint.host as String) == "192.168.1.246"
              && route_is_redfish_write_candidate_on_manager_read(route: a.route)
          IdentityBindReceipt { receipt: _ } => false
        }
    InstanceRefused { key: _, cause: _ } => false
    InstanceNotReached { key: _, blocked_by: _ } => false
  }
}

fn identity_refused_board_serial_absent(s: StepInstanceStanding<ArrivalStepReceipt, ArrivalStepRefusal>) -> Bool {
  match s {
    InstanceRefused { key: k, cause: c } =>
      declaration_ref_eq(a: k.step_identity, b: identity_bind_provisional_step_ref)
        && match c {
          DomainRefused { cause: d } =>
            match d {
              IdentityBindObserveRefused { cause: i } => match i { UnitKeyNotBound { cause: u } => match u { BoardSerialAbsent => true  _ => false }  _ => false }
              _ => false
            }
          _ => false
        }
    InstanceConverged { key: _, receipt: _ } => false
    InstanceNotReached { key: _, blocked_by: _ } => false
  }
}

// THE REAL PATH. mtjade1 establishes AccessDiscover from its committed 2026-10-04 read at
// 192.168.1.246 (MegaRAC, 2.11.104000, the controller's year-2000 clock kept as a reading, and a
// CANDIDATE Redfish account-write route on that read), and the line stops at IdentityBindProvisional
// with the typed missing observation: no committed board serial, so no unit key.
test fn w_mtjade1_establishes_access_and_stops_at_identity_bind_board_serial_absent() -> Bool {
  match converge_mtjade1_arrival_prefix(run: run_a) {
    ArrivalRunFolded { verdict: v } =>
      match v {
        RunStopped { ledger: l, at: at } =>
          declaration_ref_eq(a: at.step_identity, b: identity_bind_provisional_step_ref)
            && length(xs: l.instances) == 2
            && match l.instances.first() { Present { value: s } => access_established_as_read(s: s)  Absent => false }
            && match l.instances.last() { Present { value: s } => identity_refused_board_serial_absent(s: s)  Absent => false }
        RunConverged { run: _ } => false
        RunOutcomesRefused { cause: _ } => false
      }
    ArrivalPlanRefused { cause: _ } => false
    ArrivalPrefixUnstepped { phase: _ } => false
  }
}

// The roster is the authority's own prefix through IdentityBindProvisional: exactly two phases, in
// arrival_phases_all's order, not the twelve-phase list and not a second shorter list.
test fn w_the_roster_is_the_two_phase_prefix_of_the_authority() -> Bool {
  arrival_prefix_through(last: arrival_prefix_last) == [Arrival { phase: AccessDiscover }, Arrival { phase: IdentityBindProvisional }]
}

// A phase of the prefix with no step refuses rather than being skipped: through BmcSecure the prefix
// reaches PriorLifeBoundary, which has no step in this cut.
test fn w_a_prefix_phase_with_no_step_refuses() -> Bool {
  match arrival_prefix_steps(phases: arrival_prefix_through(last: BmcSecure)) {
    ArrivalPrefixPhaseUnstepped { phase: p } => p == Arrival { phase: PriorLifeBoundary }
    ArrivalPrefixStepped { steps: _ } => false
  }
}

// ── plan controls, over the real step identities and the production census ───────────────────

fn real_steps() -> List<ConvergenceStep<IntakePhase>> {
  match arrival_prefix_steps(phases: arrival_prefix_through(last: arrival_prefix_last)) {
    ArrivalPrefixStepped { steps: ss } => ss
    ArrivalPrefixPhaseUnstepped { phase: _ } => []
  }
}

fn access_step_bound_to(phase: IntakePhase) -> ConvergenceStep<IntakePhase> {
  ConvergenceStep { identity: access_discover_step_ref, order_member: phase, preconditions: [] }
}

fn identity_step_with(preconditions: List<StepPrecondition>) -> ConvergenceStep<IntakePhase> {
  ConvergenceStep { identity: identity_bind_provisional_step_ref, order_member: Arrival { phase: IdentityBindProvisional }, preconditions: preconditions }
}

fn plan_refusal(admission: ConvergencePlanAdmission<IntakePhase>) -> ConvergencePlanRefusal<IntakePhase>? {
  match admission {
    ConvergencePlanRefused { cause: c } => Present { value: c }
    ConvergencePlanAdmitted { plan: _ } => none
  }
}

test fn w_the_real_two_step_plan_is_admitted() -> Bool {
  match admit_convergence_plan(planning: arrival_planning_authority(), steps: real_steps()) {
    ConvergencePlanAdmitted { plan: _ } => length(xs: real_steps()) == 2
    ConvergencePlanRefused { cause: _ } => false
  }
}

// AccessDiscover bound to BmcSecure ranks after IdentityBindProvisional in the authority, so the
// roster's order disagrees with intake_phase_rank and the plan refuses naming both steps and ranks.
test fn w_a_step_whose_phase_rank_disagrees_with_the_authority_refuses() -> Bool {
  match plan_refusal(admission: admit_convergence_plan(planning: arrival_planning_authority(), steps: [access_step_bound_to(phase: Arrival { phase: BmcSecure }), identity_step_with(preconditions: [SameSubject { step: access_discover_step_ref }])])) {
    Present { value: c } => match c {
      StepRankDisagreesWithAuthority { step: s, rank: r, preceding_step: p, preceding_rank: pr } =>
        declaration_ref_eq(a: s, b: identity_bind_provisional_step_ref) && declaration_ref_eq(a: p, b: access_discover_step_ref) && r == 1 && pr == 3
      _ => false
    }
    Absent => false
  }
}

// A real declaration that is not a step of the plan, so the precondition names nothing the plan
// carries.
test fn w_an_unknown_precondition_refuses() -> Bool {
  let unknown = decl_ref(module_path: "gunbc.machine_intake_arrival_converge", decl_name: "converge_arrival_prefix")
  match plan_refusal(admission: admit_convergence_plan(planning: arrival_planning_authority(), steps: [access_step_bound_to(phase: Arrival { phase: AccessDiscover }), identity_step_with(preconditions: [SameSubject { step: access_discover_step_ref }, SameSubject { step: unknown }])])) {
    Present { value: c } => match c {
      PreconditionUnknown { step: s, precondition: p } => declaration_ref_eq(a: s, b: identity_bind_provisional_step_ref) && match p { SameSubject { step: ps } => declaration_ref_eq(a: ps, b: unknown) }
      _ => false
    }
    Absent => false
  }
}

// converge_arrival_prefix is a real declaration with no census row: as a step it refuses.
test fn w_a_step_with_no_census_row_refuses() -> Bool {
  let uncensused = decl_ref(module_path: "gunbc.machine_intake_arrival_converge", decl_name: "converge_arrival_prefix")
  match plan_refusal(admission: admit_convergence_plan(planning: arrival_planning_authority(), steps: [ConvergenceStep { identity: uncensused, order_member: Arrival { phase: AccessDiscover }, preconditions: [] }])) {
    Present { value: c } => match c { StepMissingFromCensus { step: s } => declaration_ref_eq(a: s, b: uncensused)  _ => false }
    Absent => false
  }
}

// SUPPLIED: the production census rows with AccessDiscover's row appearing twice. The production
// census admission refuses such a list itself, and the production plan mint reads only the canonical
// census, so this goes to the pure classifier, which cannot return a plan: its identity join refuses
// a step with two rows rather than picking one.
test fn w_a_step_with_two_census_rows_refuses() -> Bool {
  let access_rows = host_convergence_census_rows |> filter(r => declaration_ref_eq(a: r.identity, b: access_discover_step_ref))
  let doubled: HostConvergenceCensus = CensusWellFormed { rows: concat(host_convergence_census_rows, access_rows) }
  length(xs: access_rows) == 1
    && match classify_convergence_plan(census: doubled, order: arrival_order_authority(), steps: real_steps()) {
      PlanClassifiedRefused { cause: c } => match c { StepDuplicatedInCensus { step: s } => declaration_ref_eq(a: s, b: access_discover_step_ref)  _ => false }
      PlanClassifiedAdmissible { steps: _ } => false
    }
}

// ── run controls, over real step outcomes from mtjade1's real read ─────────────────────────────

fn real_access(run: ConvergenceRunId, subject: StepSubjectKey, read: CurrentManagerRead) -> StepOutcome<ArrivalStepReceipt, ArrivalStepRefusal> {
  access_discover(key: step_instance_key(run: run, step: access_discover_step_ref, subject: subject), read: read)
}

fn established_access(o: StepOutcome<ArrivalStepReceipt, ArrivalStepRefusal>) -> AccessDiscoverEstablished? {
  match step_outcome_receipt(outcome: o) {
    Present { value: r } => match r { AccessDiscoverReceipt { receipt: a } => Present { value: a }  IdentityBindReceipt { receipt: _ } => none }
    Absent => none
  }
}

// SUPPLIED at the IdentityBindProvisional boundary: a board serial and a provisional assembly, so the
// step can be shown to converge and to bind the run's attempt. Neither is a fact about mtjade1; the
// real path (first claim) is the BoardSerialAbsent refusal.
fn supplied_identity_inputs() -> IdentityBindInputs {
  identity_bind_inputs_supplied(
    board_serials: [BoardSerialObservation { source: BmcFru, serial: "SUPPLIED-SERIAL-0001" }],
    other_units: [],
    assembly: Present { value: AssemblyManifest { chassis_part_number: "SUPPLIED-CHASSIS", components: [ComponentIdentity { kind: ChassisComponent, slot: "chassis", identity: "SUPPLIED-CHASSIS" }] } },
  )
}

fn fold_real(run: ConvergenceRunId, subject: StepSubjectKey, outcomes: List<StepOutcome<ArrivalStepReceipt, ArrivalStepRefusal>>) -> ConvergenceRunVerdict<ArrivalStepReceipt, ArrivalStepRefusal>? {
  match admit_convergence_plan(planning: arrival_planning_authority(), steps: real_steps()) {
    ConvergencePlanAdmitted { plan: p } => Present { value: fold_convergence_run(plan: p, run: run, subject: subject, outcomes: outcomes, projection: arrival_receipt_projection()) }
    ConvergencePlanRefused { cause: _ } => none
  }
}

// POSITIVE CONTROL: with a supplied serial and assembly the same run converges both instances, and
// the subject carries this run as its one intake attempt.
test fn w_supplied_identity_inputs_converge_and_bind_the_run_attempt() -> Bool {
  let read = read_mtjade1_current_manager_read()
  let access = real_access(run: run_a, subject: mtjade1_key, read: read)
  match established_access(o: access) {
    Absent => false
    Present { value: a } => {
      let identity = identity_bind_provisional(key: step_instance_key(run: run_a, step: identity_bind_provisional_step_ref, subject: mtjade1_key), access: a, inputs: supplied_identity_inputs())
      match fold_real(run: run_a, subject: mtjade1_key, outcomes: [access, identity]) {
        Present { value: v } => match v {
          RunConverged { run: r } => match r.ledger.instances.last() {
            Present { value: s } => match s {
              InstanceConverged { key: _, receipt: r } => match r {
                IdentityBindReceipt { receipt: i } => ((i.subject.attempt_id as NonEmptyStr) as String) == "o1c1-witness-run-a"
                AccessDiscoverReceipt { receipt: _ } => false
              }
              _ => false
            }
            Absent => false
          }
          _ => false
        }
        Absent => false
      }
    }
  }
}

fn stopped_on_unmet_access_precondition<R, C>(v: ConvergenceRunVerdict<R, C>?) -> Bool {
  match v {
    Present { value: verdict } => match verdict {
      RunStopped { ledger: l, at: _ } => match l.instances.last() {
        Present { value: s } => match s {
          InstanceRefused { key: _, cause: c } => match c {
            PreconditionUnmet { precondition: p, consumed: _ } =>
              declaration_ref_eq(a: p.step_identity, b: access_discover_step_ref) && ((p.subject as NonEmptyStr) as String) == "mtjade1" && ((p.run as NonEmptyStr) as String) == "o1c1-witness-run-a"
            _ => false
          }
          _ => false
        }
        Absent => false
      }
      _ => false
    }
    Absent => false
  }
}

// A PRECONDITION IS NOT SATISFIED BY A RECEIPT FOR ANOTHER SUBJECT. SUPPLIED at the fold's
// interface: the Manager read is sealed and binds to mtjade1 alone, so no real AccessDiscover receipt
// for another unit exists to hand it. The probe receipt below carries its key and consumed set as
// plain fields, read through a projection this witness is admitted to mint. Over the real admitted
// plan, an IdentityBindProvisional instance for mtjade1 that consumed mtjade2's AccessDiscover
// instance stops the line naming mtjade1's own AccessDiscover instance as the unmet precondition,
// although mtjade1's AccessDiscover converged.
type ProbeReceipt {
  key: StepInstanceKey
  consumed: List<StepInstanceKey>
}

fn probe_key(r: ProbeReceipt) -> StepInstanceKey {
  r.key
}

fn probe_consumed(r: ProbeReceipt) -> List<StepInstanceKey> {
  r.consumed
}

fn probe_receipt_projection() -> ConvergenceReceiptProjection<ProbeReceipt> {
  convergence_receipt_projection(key_of: probe_key, consumed_of: probe_consumed)
}

test fn w_a_precondition_is_not_satisfied_by_a_receipt_for_another_subject() -> Bool {
  let own_access = step_instance_key(run: run_a, step: access_discover_step_ref, subject: mtjade1_key)
  let foreign_access = step_instance_key(run: run_a, step: access_discover_step_ref, subject: "mtjade2" as StepSubjectKey)
  let identity = step_instance_key(run: run_a, step: identity_bind_provisional_step_ref, subject: mtjade1_key)
  let outcomes: List<StepOutcome<ProbeReceipt, String>> = [
    StepEstablished { receipt: ProbeReceipt { key: own_access, consumed: [] } },
    StepEstablished { receipt: ProbeReceipt { key: identity, consumed: [foreign_access] } },
  ]
  match admit_convergence_plan(planning: arrival_planning_authority(), steps: real_steps()) {
    ConvergencePlanAdmitted { plan: p } =>
      stopped_on_unmet_access_precondition(v: Present { value: fold_convergence_run(plan: p, run: run_a, subject: mtjade1_key, outcomes: outcomes, projection: probe_receipt_projection()) })
    ConvergencePlanRefused { cause: _ } => false
  }
}

// Nor by a receipt for the same subject read back in ANOTHER run (the fold's check, supplied).
test fn w_a_precondition_is_not_satisfied_by_a_receipt_from_another_run() -> Bool {
  let own_access = step_instance_key(run: run_a, step: access_discover_step_ref, subject: mtjade1_key)
  let earlier_access = step_instance_key(run: run_b, step: access_discover_step_ref, subject: mtjade1_key)
  let identity = step_instance_key(run: run_a, step: identity_bind_provisional_step_ref, subject: mtjade1_key)
  let outcomes: List<StepOutcome<ProbeReceipt, String>> = [
    StepEstablished { receipt: ProbeReceipt { key: own_access, consumed: [] } },
    StepEstablished { receipt: ProbeReceipt { key: identity, consumed: [earlier_access] } },
  ]
  match admit_convergence_plan(planning: arrival_planning_authority(), steps: real_steps()) {
    ConvergencePlanAdmitted { plan: p } =>
      stopped_on_unmet_access_precondition(v: Present { value: fold_convergence_run(plan: p, run: run_a, subject: mtjade1_key, outcomes: outcomes, projection: probe_receipt_projection()) })
    ConvergencePlanRefused { cause: _ } => false
  }
}

// THE DOMAIN'S OWN WALL, on the real path: IdentityBindProvisional refuses an AccessDiscover receipt
// that is not its own instance's -- here mtjade1's real receipt from another run -- before binding
// anything, so no IdentityBoundProvisional exists for a key its access receipt does not match.
test fn w_identity_bind_refuses_an_access_receipt_from_another_run() -> Bool {
  match established_access(o: real_access(run: run_b, subject: mtjade1_key, read: read_mtjade1_current_manager_read())) {
    Absent => false
    Present { value: earlier } => {
      let outcome: StepOutcome<ArrivalStepReceipt, ArrivalStepRefusal> = identity_bind_provisional(key: step_instance_key(run: run_a, step: identity_bind_provisional_step_ref, subject: mtjade1_key), access: earlier, inputs: supplied_identity_inputs())
      let refusal: ArrivalStepRefusal? = step_outcome_refusal(outcome: outcome)
      match refusal {
        Present { value: c } => match c { IdentityBindAccessForAnotherInstance { access: k } => ((k.run as NonEmptyStr) as String) == "o1c1-witness-run-b"  _ => false }
        Absent => false
      }
    }
  }
}

// A DUPLICATE (run, step, subject) REFUSES the run before any ledger is written.
test fn w_a_duplicate_run_step_subject_refuses() -> Bool {
  let access = real_access(run: run_a, subject: mtjade1_key, read: read_mtjade1_current_manager_read())
  match fold_real(run: run_a, subject: mtjade1_key, outcomes: [access, access]) {
    Present { value: v } => match v {
      RunOutcomesRefused { cause: c } => match c { OutcomeDuplicated { key: k } => declaration_ref_eq(a: k.step_identity, b: access_discover_step_ref)  _ => false }
      _ => false
    }
    Absent => false
  }
}

// A read bound to another unit does not establish this unit's access: the goal diverges and the
// read-only phase, having no remedy, refuses.
test fn w_access_discover_refuses_a_read_bound_to_another_unit() -> Bool {
  match step_outcome_refusal(outcome: real_access(run: run_a, subject: "mtjade2" as StepSubjectKey, read: read_mtjade1_current_manager_read())) {
    Present { value: c } => match c { ReadOnlyPhaseRefused { phase: p, reason: _ } => p == AccessDiscover  _ => false }
    Absent => false
  }
}

// A REFUSAL STOPS THE LINE OVER ITS DEPENDENTS, AND EACH NAMES ITS BLOCKER. The real read, run for a
// unit it is not bound to, refuses AccessDiscover; IdentityBindProvisional is then never executed and
// is NotReached, blocked by that AccessDiscover instance.
test fn w_a_refused_access_leaves_identity_bind_not_reached_blocked_by_it() -> Bool {
  match converge_arrival_prefix(run: run_a, subject: "mtjade2" as StepSubjectKey, read: read_mtjade1_current_manager_read(), inputs: mtjade1_identity_bind_inputs()) {
    ArrivalRunFolded { verdict: v } => match v {
      RunStopped { ledger: l, at: at } =>
        declaration_ref_eq(a: at.step_identity, b: access_discover_step_ref)
          && length(xs: l.instances) == 2
          && match l.instances.last() {
            Present { value: s } => match s {
              InstanceNotReached { key: k, blocked_by: b } =>
                declaration_ref_eq(a: k.step_identity, b: identity_bind_provisional_step_ref) && declaration_ref_eq(a: b.step_identity, b: access_discover_step_ref) && ((b.subject as NonEmptyStr) as String) == "mtjade2"
              _ => false
            }
            Absent => false
          }
      _ => false
    }
    _ => false
  }
}

// ── O1a's control at the current endpoint ──────────────────────────────────────────────────────

// SUPPLIED: an operator approval of the rotation that names this exact controller, build and request,
// so the only thing left to refuse is the route. A Manager GET alone yields a candidate, and the
// ordinary rotation Apply refuses it as not grounded.
fn rotation_approval_for(s: BmcRotationRouteStanding) -> Redemption {
  let request = match s.grounding {
    RouteQualificationCandidate { request: r, evidence: _ } => r
    RouteGroundedByExecutedRequest { request: r, request_receipt: _, response_receipt: _ } => r
    RouteGroundedByCitedSource { request: r, citation: _ } => r
    RouteUngrounded => IpmiSetUserPassword { user: 3 }
  }
  RedemptionAdmitted {
    claims: ApprovalCapabilityClaims {
      protocol: approval_capability_protocol,
      issuer: "gunbc-approval-broker" as NonEmptyStr,
      audience: "srv1" as NonEmptyStr,
      authority: rotation_apply_authority,
      escalation_id: "o1c1-witness" as NonEmptyStr,
      request_revision: rotation_route_request_identity(standing: s, request: request),
      decision: ProposeApprove,
      attempt: "attempt-1" as AttemptIdentity,
      issued_at: "2026-10-04T00:00:00Z",
      expires_at: "2026-10-04T00:15:00Z",
      key_id: "broker-2026-10" as MacKeyId,
    },
    decided_by: "operator" as NonEmptyStr,
  }
}

test fn w_a_manager_get_alone_cannot_construct_an_account_write_route_at_the_current_endpoint() -> Bool {
  match established_access(o: real_access(run: run_a, subject: mtjade1_key, read: read_mtjade1_current_manager_read())) {
    Absent => false
    Present { value: a } =>
      rotation_route_is_grounded(standing: a.route) == false
        && match admit_rotation_apply(standing: a.route, target_endpoint: a.access.endpoint, target_firmware: a.access.firmware, approval: rotation_approval_for(s: a.route)) {
          RotationApplyRouteNotGrounded { standing: _ } => true
          _ => false
        }
  }
}
