module test.claim.machine_intake.mtcollins1_stale_power_off_witness_test

import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.types { Bool, NonEmptyStr, String }
import extdeps.provisioning.ubuntu_seeded_install_media { ubuntu_seeded_install_media_image_name }
import extdeps.bmc.ipmi_chassis_control { ChassisPowerObservation, ChassisPowerRead, ChassisUnreadable, ChassisStatusUndecodable }
import gunbc.machine_intake_mtcollins1_census_image { mtcollins1_census_image_stem }
import gunbc.machine_intake_mtcollins1_access_observation { mtcollins1_firmware }
import gunbc.machine_intake_megarac_media_attach {
  CdErrorNone,
  CdErrorRead,
  ConvergeStepAwaitReadiness,
  ConvergeStepDetachStale,
  ConvergeStepRefuse,
  ConvergenceStep,
  MegaRacAttachResult,
  MegaRacDetachAdmission,
  MegaRacDetachNotAdmitted,
  MegaRacPresentationObserved,
  MegaRacRawRead,
  MegaRacSessionRefused,
  MegaRacStaleDetachNotAdmitted,
  SessionReleased,
  SessionReleaseNotAttempted,
  SessionReleaseRefused,
  ShareBound,
  ShareUnreadable,
  attach_readiness,
  megarac_convergence_step,
  presented_convergence,
  presented_media,
}
import gunbc.machine_intake_mtcollins1_boot_diagnostic_bundle {
  StalePowerOffCommandRefused,
  StalePowerOffNotNeeded,
  StalePowerOffNotObserved,
  StalePowerOffObserved,
}
import gunbc.machine_intake_mtcollins1_media_attach {
  PowerOffForStale,
  PowerOffNotNeeded,
  mtcollins1_detach_admission,
  mtcollins1_detach_admission_after_power_off,
  mtcollins1_stale_power_off_need,
  stale_power_off_look_owed,
  stale_power_off_observed,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// FLEET-CONVERGE RUN 36683309058 (mode mtcollins1_boot, main 7b87f99f): after the repin to
// 161b98b9 (#12743) the controller still presented the previous census image 30ca88d4 and the host
// was on, so the attach refused "the stale census image ... is presented and was NOT stopped: the host
// is powered on". Both names are derived from the naming authority, not typed.
data run_stale: NonEmptyStr = ubuntu_seeded_install_media_image_name(image_stem: mtcollins1_census_image_stem, output_digest: "30ca88d43f891399ff")
data run_desired: NonEmptyStr = ubuntu_seeded_install_media_image_name(image_stem: mtcollins1_census_image_stem, output_digest: "161b98b9ae11214d00")

data host_on: ChassisPowerObservation = ChassisPowerRead { power_on: true }
data host_off: ChassisPowerObservation = ChassisPowerRead { power_on: false }

fn presenting(name: String) -> String {
  concat("[{\"media_type\":1,\"image_name\":\"", concat(name, "\",\"redirection_status\":1,\"media_index\":0,\"session_index\":0}]"))
}

fn raw(body: String) -> MegaRacRawRead {
  MegaRacRawRead { answered: true, body: body, observed_at: Present { value: 1000 } }
}

// ONE READ-ONLY LOOK AS THE OBSERVE TASK RETURNS IT: share bound, code clean, session released.
fn look(configurations: String) -> MegaRacAttachResult {
  MegaRacAttachResult {
    outcome: MegaRacPresentationObserved {
      share: ShareBound,
      readiness: attach_readiness(answered: true, body: configurations, image_name: run_desired, firmware: mtcollins1_firmware),
      cd_error: CdErrorRead { code: CdErrorNone },
      general: raw(body: "{}"),
      configurations: raw(body: configurations),
    },
    session_release: SessionReleased,
    baseline: none,
  }
}

// THE CONVERGE'S OWN DECISION over a presentation and an admission, as the attach will take it.
fn step(configurations: String, detach: MegaRacDetachAdmission) -> ConvergenceStep {
  megarac_convergence_step(
    convergence: presented_convergence(
      presented: presented_media(body: configurations, image_name: run_desired, firmware: mtcollins1_firmware),
      image_name: run_desired,
      replaceable_seeded_stem: mtcollins1_census_image_stem,
    ),
    detach: detach,
    configurations: configurations,
    cd_before: CdErrorRead { code: CdErrorNone },
  )
}

// THE DISCRIMINATING RED, run 36683309058's state. Without the power-off the admission over the
// on reading refuses the detach, which is the receipt; with it the look selects a power-off for
// exactly the stale image, and after an OBSERVED off plus a fresh off reading the same converge
// detaches it. Deleting the arm leaves only the first half, which is the refusal.
test fn run_36683309058_on_with_stale_refuses_without_the_power_off() -> Bool {
  match step(configurations: presenting(name: run_stale as String), detach: mtcollins1_detach_admission(power: host_on)) {
    ConvergeStepRefuse { outcome: MegaRacStaleDetachNotAdmitted { stale_image: n, reason: _ } } => n == (run_stale as String)
    _ => false
  }
}

test fn run_36683309058_on_with_stale_powers_off_then_detaches() -> Bool {
  let off = StalePowerOffObserved { stale_image: run_stale as String, before: host_on }
  stale_power_off_look_owed(before: host_on)
    && (match mtcollins1_stale_power_off_need(look: look(configurations: presenting(name: run_stale as String)), image_name: run_desired) {
      PowerOffForStale { stale_image: n } => n == (run_stale as String)
      _ => false
    })
    && (match step(configurations: presenting(name: run_stale as String), detach: mtcollins1_detach_admission_after_power_off(power: host_off, off: off)) {
      ConvergeStepDetachStale { row: r } => r.image_name == (run_stale as String)
      _ => false
    })
}

// POSITIVE CONTROL: off with the stale image needs no look and no power-off, and detaches.
test fn off_with_stale_needs_no_power_off_and_detaches() -> Bool {
  let off = StalePowerOffNotNeeded { reason: "chassis power before the session: off" }
  !stale_power_off_look_owed(before: host_off)
    && (match step(configurations: presenting(name: run_stale as String), detach: mtcollins1_detach_admission_after_power_off(power: host_off, off: off)) {
      ConvergeStepDetachStale { row: r } => r.image_name == (run_stale as String)
      _ => false
    })
}

// POSITIVE CONTROL: on with the desired image presented is never powered off, and stays the no-write
// readiness route under the on reading.
test fn on_with_desired_is_never_powered_off_and_stays_a_no_op() -> Bool {
  (match mtcollins1_stale_power_off_need(look: look(configurations: presenting(name: run_desired as String)), image_name: run_desired) {
    PowerOffNotNeeded { reason: _ } => true
    _ => false
  })
    && (match step(configurations: presenting(name: run_desired as String), detach: mtcollins1_detach_admission(power: host_on)) {
      ConvergeStepAwaitReadiness => true
      _ => false
    })
}

// AN UNKNOWN MEDIUM IS NEVER POWERED OFF FOR: a foreign name, nothing presented, an unreadable
// configurations document, an unbound share, a session that was not released, no observation.
test fn a_foreign_image_is_never_powered_off_for() -> Bool {
  match mtcollins1_stale_power_off_need(look: look(configurations: presenting(name: "someone-elses-installer.iso")), image_name: run_desired) {
    PowerOffNotNeeded { reason: _ } => true
    _ => false
  }
}

test fn nothing_presented_is_never_powered_off_for() -> Bool {
  match mtcollins1_stale_power_off_need(look: look(configurations: "[]"), image_name: run_desired) {
    PowerOffNotNeeded { reason: _ } => true
    _ => false
  }
}

test fn an_unreadable_presentation_is_never_powered_off_for() -> Bool {
  match mtcollins1_stale_power_off_need(look: look(configurations: "curl: (28)"), image_name: run_desired) {
    PowerOffNotNeeded { reason: _ } => true
    _ => false
  }
}

test fn an_unbound_share_is_never_powered_off_for() -> Bool {
  let l = look(configurations: presenting(name: run_stale as String))
  let unbound = MegaRacAttachResult {
    outcome: MegaRacPresentationObserved {
      share: ShareUnreadable { detail: "curl: (28)" },
      readiness: attach_readiness(answered: true, body: presenting(name: run_stale as String), image_name: run_desired, firmware: mtcollins1_firmware),
      cd_error: CdErrorRead { code: CdErrorNone },
      general: raw(body: "{}"),
      configurations: raw(body: presenting(name: run_stale as String)),
    },
    session_release: l.session_release,
    baseline: none,
  }
  match mtcollins1_stale_power_off_need(look: unbound, image_name: run_desired) {
    PowerOffNotNeeded { reason: _ } => true
    _ => false
  }
}

test fn a_look_whose_session_leaked_is_never_powered_off_for() -> Bool {
  let l = look(configurations: presenting(name: run_stale as String))
  let leaked = MegaRacAttachResult { outcome: l.outcome, session_release: SessionReleaseRefused { detail: "probe 000" }, baseline: none }
  match mtcollins1_stale_power_off_need(look: leaked, image_name: run_desired) {
    PowerOffNotNeeded { reason: _ } => true
    _ => false
  }
}

test fn a_refused_look_is_never_powered_off_for() -> Bool {
  let refused = MegaRacAttachResult { outcome: MegaRacSessionRefused { detail: "HTTP 401" }, session_release: SessionReleaseNotAttempted, baseline: none }
  match mtcollins1_stale_power_off_need(look: refused, image_name: run_desired) {
    PowerOffNotNeeded { reason: _ } => true
    _ => false
  }
}

// POWER UNREADABLE OR UNDECODABLE STILL REFUSES: no look, no power-off, and the admission refuses.
test fn unreadable_or_undecodable_power_takes_no_look_and_refuses() -> Bool {
  let undecodable = ChassisStatusUndecodable { cause: "no System Power line" }
  !stale_power_off_look_owed(before: ChassisUnreadable)
    && !stale_power_off_look_owed(before: undecodable)
    && (match mtcollins1_detach_admission(power: ChassisUnreadable) { MegaRacDetachNotAdmitted { reason: _ } => true  _ => false })
    && (match mtcollins1_detach_admission(power: undecodable) { MegaRacDetachNotAdmitted { reason: _ } => true  _ => false })
}

// A POWER-OFF NOT OBSERVED NEVER ADMITS, even beside an off reading: the read-back is the evidence,
// not the command's exit or a later reading alone.
test fn a_power_off_not_observed_or_refused_never_admits() -> Bool {
  let unobserved = StalePowerOffNotObserved { stale_image: run_stale as String, before: host_on, last: ChassisUnreadable }
  let refused = StalePowerOffCommandRefused { stale_image: run_stale as String, before: host_on }
  (match mtcollins1_detach_admission_after_power_off(power: host_off, off: unobserved) { MegaRacDetachNotAdmitted { reason: _ } => true  _ => false })
    && (match mtcollins1_detach_admission_after_power_off(power: host_off, off: refused) { MegaRacDetachNotAdmitted { reason: _ } => true  _ => false })
}

// THE READ-BACK ENDS ONLY ON AN OBSERVED OFF.
test fn only_an_observed_off_ends_the_read_back() -> Bool {
  stale_power_off_observed(sample: host_off)
    && !stale_power_off_observed(sample: host_on)
    && !stale_power_off_observed(sample: ChassisUnreadable)
    && !stale_power_off_observed(sample: ChassisStatusUndecodable { cause: "x" })
}
