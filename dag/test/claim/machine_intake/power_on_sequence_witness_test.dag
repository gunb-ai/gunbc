// the same file, line 1879; excerpt sha256 a602607e3bd95133ca09a71f3d24f3227cf4fd92e33bd108be22bf11b3848e51.
data run_37069907299_panic: String = "[    9.962666] Kernel panic - not syncing: VFS: Unable to mount root fs on unknown-block(0,0)\r\n"

fn lines_of(text: String) -> List<String> {
  host_capture_lines(capture: HostCaptureLiveStream { text: text })
}

fn console_of(lines: List<String>) -> ConsoleEvidence {
  let checkpoints = ampere_checkpoint_console_observation(lines: lines)
  ConsoleRead {
    firmware: firmware_console_report(lines: lines),
    firmware_error_lines: 0,
    dram: ampere_dram_console_observation(lines: lines),
    checkpoints: checkpoints,
    against_reference: ampere_checkpoint_reference_comparison(subject: checkpoints, reference: ampere_checkpoint_console_observation(lines: lines_of(text: run_37069907299_firmware))),
    sockets: ampere_socket_console_observation(lines: lines),
    loader: grub_console_report(lines: lines),
    linux: linux_boot_console_observation(lines: lines),
    modules: kernel_module_decompression_observation(lines: lines),
  }
}

fn socket_stage(socket: Int, cur: Int, bootstage: Int) -> SmproSocketStage {
  SmproSocketStage { socket: socket, current: CurrentStageEstablished { stage: smpro_cur_bootstage_of(word: cur) }, reported: ReportedStageEstablished { bootstage: smpro_bootstage_of(word: bootstage) } }
}

// THE 2026-10-03 LOOP AS OBSERVED (eager-gull-22's synchronized captures): socket 0 BOOTSTAGE 0x0201
// (ATF BL1 started), socket 1 CUR_BOOTSTAGE 0x0001 with BOOTSTAGE 0x03ff.
fn loop_smpro() -> List<SmproPassEvidence> {
  [SmproPassEvidence { label: "power-on", sockets: [socket_stage(socket: 0, cur: 2, bootstage: 513), socket_stage(socket: 1, cur: 1, bootstage: 1023)] }]
}

fn evidence(console: ConsoleEvidence, smpro: List<SmproPassEvidence>, census_ended: Bool) -> BootEvidence {
  BootEvidence {
    expected_sockets: [0, 1], bmc: CarrierRead, bmc_anomalies: [], handoff: HandoffPoweredOn,
    smpro: smpro, console: console, sel: SelEventsRead { events: [] }, census_ended: census_ended,
  }
}

fn reading_at(u: BootUnderstanding, stage: PowerOnStage) -> StageReading {
  match filter(u.stages, s => same_stage(a: s.stage, b: stage)).first() { Absent => StageUnobserved Present { value: s } => s.reading }
}

test fn the_step1_loop_is_a_reset_after_the_dram_firmware_at_00001a0a() -> Bool {
  let u = boot_understanding(e: evidence(console: console_of(lines: lines_of(text: step1_last_two_cycles)), smpro: loop_smpro(), census_ended: false))
  (match u.ending {
    ResetWithObservedCadence { at: a, against_reference: _, restart_cadence: c, console_errors: n, sel_restarts: _, reset_cause: rc } =>
      same_stage(a: a.stage, b: Firmware { stage: DdrInitialization })
        && (match a.last_checkpoint { Present { value: w } => (w.digits as String) == "00001a0a" Absent => false })
        && n == 0
        && (match c { CadenceCounted { cycles: k } => k == 2 _ => false })
        && (match rc { ResetCauseUnobserved { searched: _ } => true _ => false })
    _ => false
  }) && count(u.errors) == 0
}

test fn the_second_socket_is_an_independent_anomaly_not_the_ending() -> Bool {
  let u = boot_understanding(e: evidence(console: console_of(lines: lines_of(text: step1_last_two_cycles)), smpro: loop_smpro(), census_ended: false))
  match reading_at(u: u, stage: InterSocketLink) {
    StageAnomalous { anomalies: xs, reached_by: b } =>
      count(b) == 0 &&
      any(xs, a => match a { SocketStagePairInconsistent { socket: k, current: _, reported: _ } => k == 1 _ => false })
        && any(xs, a => match a { DramSocketUntrained { socket: k } => k == 1 _ => false })
    _ => false
  }
}

test fn the_loop_leaves_retry_state_reset_cause_and_the_pair_as_open_questions() -> Bool {
  let u = boot_understanding(e: evidence(console: console_of(lines: lines_of(text: step1_last_two_cycles)), smpro: loop_smpro(), census_ended: false))
  any(u.open, q => match q.question { RetryStatePersistence => true _ => false })
    && any(u.open, q => match q.question { ResetCauseNotPubliclyReadable => true _ => false })
    && any(u.open, q => match q.question { CheckpointMeaningNotPubliclyModeled => true _ => false })
    && any(u.open, q => match q.question { SocketStagePairUnexplained { socket: k } => k == 1 _ => false })
}

test fn one_cycle_and_no_sel_restart_is_a_silent_stop_not_a_reset() -> Bool {
  let last_cycle_only = lines_of(text: concat("NOTICE:  DRAM FW version 220414\r\n", join(filter(split(s: step1_last_two_cycles, delimiter: "\n"), l => starts_with(s: l, prefix: "CP: ")).skip(n: 27), "\n")))
  match boot_understanding(e: evidence(console: console_of(lines: last_cycle_only), smpro: loop_smpro(), census_ended: false)).ending {
    StoppedSilently { at: a, console_errors: _ } => match a.last_checkpoint { Present { value: w } => (w.digits as String) == "00001a0a" Absent => false }
    _ => false
  }
}

test fn run_37069907299_stops_at_the_stub_with_an_initrd_efi_load_error() -> Bool {
  let lines = concat(lines_of(text: run_37069907299_firmware), concat(lines_of(text: run_37069907299_loader_and_stub), lines_of(text: run_37069907299_panic)))
  let u = boot_understanding(e: evidence(console: console_of(lines: lines), smpro: [], census_ended: false))
  (match u.ending {
    StoppedWithStatedFailure { stage: s, error: err } => same_stage(a: s, b: KernelStub) && (match err { InitrdLoadFailedByStub { status: st } => (match st { EfiLoadError => true _ => false }) _ => false })
    _ => false
  })
    && (match reading_at(u: u, stage: KernelBoot) { StageFailed { error: err } => (match err { KernelPanic { reason: _ } => true _ => false }) _ => false })
    && (match reading_at(u: u, stage: Firmware { stage: Uefi }) { StageReached { by: _ } => true _ => false })
    && (match reading_at(u: u, stage: InterSocketLink) { StageFailed { error: err } => (match err { ActiveSocketsBelowExpected { active: a, expected: x } => a == 1 && x == 2 _ => false }) _ => false })
    && (match u.furthest { Present { value: a } => same_stage(a: a.stage, b: KernelBoot) Absent => false })
}

test fn the_census_end_marker_is_the_only_route_to_reached_census() -> Bool {
  let lines = lines_of(text: run_37069907299_firmware)
  (match boot_understanding(e: evidence(console: console_of(lines: lines), smpro: [], census_ended: true)).ending { ReachedCensus => true _ => false })
    && (match boot_understanding(e: evidence(console: console_of(lines: lines), smpro: [], census_ended: false)).ending { ReachedCensus => false _ => true })
}

test fn with_nothing_read_the_ending_is_unobservable_never_a_stage() -> Bool {
  let u = boot_understanding(e: BootEvidence {
    expected_sockets: [0, 1], bmc: CarrierNotRead { reason: "no answer" }, bmc_anomalies: [],
    handoff: HandoffNotConfirmed { reason: "handoff not confirmed" }, smpro: [],
    console: ConsoleNotRead { reason: "not retained" }, sel: SelEventsNotRead { reason: "no snapshot" }, census_ended: false,
  })
  (match u.ending { EndingUnobservable { missing: m } => any(m, c => match c { SerialConsole => true _ => false }) _ => false })
    && (match u.furthest { Absent => true Present { value: _ } => false })
    && any(u.open, q => match q.question { CarrierMissing { carrier: _, reason: _ } => true _ => false })
}

test fn the_rendering_names_the_stop_and_the_open_questions() -> Bool {
  let t = boot_understanding_text(u: boot_understanding(e: evidence(console: console_of(lines: lines_of(text: step1_last_two_cycles)), smpro: loop_smpro(), census_ended: false)))
  string_contains(s: t, pattern: "last checkpoint 00001a0a")
    && string_contains(s: t, pattern: "reset cause: unobserved")
    && string_contains(s: t, pattern: "does any failsafe or retry state survive the reset?")
}
