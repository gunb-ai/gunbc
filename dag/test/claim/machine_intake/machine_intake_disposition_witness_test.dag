data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data unit: UnitKey = "BRD-000123" as UnitKey

data assembly_before: AssemblyManifest = AssemblyManifest {
  chassis_part_number: "CH-1U-ALT",
  components: [ComponentIdentity { kind: DimmComponent, slot: "A1", identity: "SPD-A1-OLD" }],
}

data assembly_after: AssemblyManifest = AssemblyManifest {
  chassis_part_number: "CH-1U-ALT",
  components: [ComponentIdentity { kind: DimmComponent, slot: "A1", identity: "SPD-A1-NEW" }],
}

data firmware_v1: FirmwareManifest = FirmwareManifest {
  entries: [FirmwareEntry { component: "bmc", version: "3.22.00" }],
  configuration_digests: [],
}

data subject_before: QualificationSubject = qualification_subject_of(unit_key: unit, assembly: assembly_before, firmware: firmware_v1)
data subject_after: QualificationSubject = qualification_subject_of(unit_key: unit, assembly: assembly_after, firmware: firmware_v1)

data firmware_v2: FirmwareManifest = FirmwareManifest {
  entries: [FirmwareEntry { component: "bmc", version: "3.23.00" }],
  configuration_digests: [],
}

data subject_after_flash: QualificationSubject = qualification_subject_of(unit_key: unit, assembly: assembly_before, firmware: firmware_v2)

data attempt_one: IntakeAttemptId = "intake-20260829-0001" as IntakeAttemptId

data producer: IntakeProducerIdentity = IntakeProducerIdentity {
  intake_binary: content_hash_of_value(value: "intake-binary-fixture"),
  staging_service_identity: "intake-staging",
  agent_artifact: none,
}

data policy_digest: ContentHash = content_hash_of_value(value: "policy-fixture")

data attempt_two: IntakeAttemptId = "intake-20260829-0002" as IntakeAttemptId

fn receipt_at(phase: IntakePhase, subject: QualificationSubject, attempt: IntakeAttemptId, result: IntakeReceiptResult, started_at: EpochMs, previous: ContentHash?) -> IntakeReceiptEnvelope {
  IntakeReceiptEnvelope {
    schema: MachineIntakeReceiptV1,
    subject: MachineIntakeSubject { subject: subject, attempt_id: attempt },
    phase: phase,
    producer: producer,
    policy_digest: policy_digest,
    started_at: started_at,
    ended_at: started_at + 1000,
    observations: [],
    result: result,
    previous_receipt: previous,
  }
}

// Unlinked, un-timed receipt shapes; chain() threads links and times.
fn satisfied_receipt(phase: IntakePhase, subject: QualificationSubject, previous: ContentHash?) -> IntakeReceiptEnvelope {
  receipt_at(phase: phase, subject: subject, attempt: attempt_one, result: ReceiptSatisfied, started_at: 1788000000000, previous: previous)
}

fn refused_receipt(phase: IntakePhase, subject: QualificationSubject, owner: QualificationRefusalOwner, cause: NonEmptyStr) -> IntakeReceiptEnvelope {
  receipt_at(phase: phase, subject: subject, attempt: attempt_one, result: ReceiptRefused { owner: owner, cause: cause }, started_at: 1788000000000, previous: none)
}

type ChainFold {
  out: List<IntakeReceiptEnvelope>
  previous: ContentHash?
  next_start: EpochMs
}

// Threads a genuine chain through a receipt sequence: each receipt's
// previous_receipt is the fingerprint of the one before, and times ascend.
fn chain(receipts: List<IntakeReceiptEnvelope>) -> List<IntakeReceiptEnvelope> {
  let folded = fold(
    receipts,
    init: ChainFold { out: [], previous: none, next_start: 1788000000000 },
    f: fn(acc, r) {
      let linked = IntakeReceiptEnvelope {
        schema: r.schema,
        subject: r.subject,
        phase: r.phase,
        producer: r.producer,
        policy_digest: r.policy_digest,
        started_at: acc.next_start,
        ended_at: acc.next_start + 1000,
        observations: r.observations,
        result: r.result,
        previous_receipt: acc.previous,
      }
      ChainFold {
        out: concat(acc.out, [linked]),
        previous: Present { value: intake_receipt_structural_fingerprint(envelope: linked) },
        next_start: acc.next_start + 2000,
      }
    },
  )
  folded.out
}

// Validates then derives; Absent means the ledger itself was refused, which
// every admission test below must distinguish from a non-admissible verdict.
fn admission_over(subject: QualificationSubject, receipts: List<IntakeReceiptEnvelope>) -> FleetAdmissionStanding? {
  match validate_intake_receipt_ledger(receipts: chain(receipts: receipts)) {
    LedgerValidated { ledger: l } => Present { value: derive_fleet_admission(observed_subject: subject, ledger: l, now: 1788000002000) }
    LedgerRefused { cause: _ } => none
  }
}

// A full satisfied ledger for a subject: one receipt per required phase.
fn full_ledger(subject: QualificationSubject) -> List<IntakeReceiptEnvelope> {
  fold(fleet_admission_required_phases, init: [], f: (acc, p) => concat(acc, [satisfied_receipt(phase: p, subject: subject, previous: none)]))
}

fn ledger_without(subject: QualificationSubject, omitted: IntakePhase) -> List<IntakeReceiptEnvelope> {
  fold(fleet_admission_required_phases, init: [], f: (acc, p) => if p == omitted { acc } else { concat(acc, [satisfied_receipt(phase: p, subject: subject, previous: none)]) })
}

// POSITIVE WITNESS (ruling 4, LedgerPhaseUnranked ruling): every phase the
// three per-transaction rosters name has exactly one rank, and the ranks are
// distinct. The validator's Unranked arm stays as fail-closed coverage for a
// phase variant added without being placed in the required ordering.
test fn every_current_phase_has_exactly_one_rank() -> Bool {
  let all = concat(arrival_phases_all, concat(provisioning_phases_all, placement_phases_all))
  let ranked = fold(
    all,
    init: 0,
    f: (acc, p) => match intake_phase_rank(phase: p) {
      Present { value: _ } => acc + 1
      Absent => acc
    },
  )
  let distinct = fold(
    all,
    init: [],
    f: (acc, p) => match intake_phase_rank(phase: p) {
      Present { value: r } => if fold(acc, init: false, f: (seen, x) => seen || x == r) { acc } else { concat(acc, [r]) }
      Absent => acc
    },
  )
  list_length(items: all) == 22 && ranked == 22 && list_length(items: distinct) == 22 && list_length(items: fleet_admission_required_phases) == 22
}

fn phase_rank_or_neg(phase: IntakePhase) -> Int {
  match intake_phase_rank(phase: phase) {
    Present { value: k } => k
    Absent => -1
  }
}

// The lifecycle that STOPPED at `phase`: every lower-ranked required phase
// satisfied in roster order, then the refused receipt for `phase` last. This
// is what a serial executor records, and it is rank-valid: the ruling's
// monotone-rank rule refuses the old shape (a refusal appended after every
// later phase), so these fixtures now place the refusal at its rank.
fn ledger_stopped_at(subject: QualificationSubject, phase: IntakePhase, owner: QualificationRefusalOwner, cause: NonEmptyStr) -> List<IntakeReceiptEnvelope> {
  let stop = phase_rank_or_neg(phase: phase)
  let before = fold(fleet_admission_required_phases, init: [], f: fn(acc, p) {
    let earlier = phase_rank_or_neg(phase: p) < stop
    if earlier { concat(acc, [satisfied_receipt(phase: p, subject: subject, previous: none)]) } else { acc }
  })
  concat(before, [refused_receipt(phase: phase, subject: subject, owner: owner, cause: cause)])
}

// The full lifecycle with ONE phase recorded twice at its rank — first with
// `first`, then immediately with `retry` — an immediate same-rank retry, which
// the validator admits and admission resolves last-wins.
fn full_ledger_retrying(subject: QualificationSubject, phase: IntakePhase, first: IntakeReceiptResult, retry: IntakeReceiptResult) -> List<IntakeReceiptEnvelope> {
  fold(fleet_admission_required_phases, init: [], f: fn(acc, p) {
    let here = p == phase
    if here {
      concat(acc, [
        receipt_at(phase: p, subject: subject, attempt: attempt_one, result: first, started_at: 0, previous: none),
        receipt_at(phase: p, subject: subject, attempt: attempt_one, result: retry, started_at: 0, previous: none),
      ])
    } else {
      concat(acc, [satisfied_receipt(phase: p, subject: subject, previous: none)])
    }
  })
}

fn hashes_equal(left: ContentHash, right: ContentHash) -> Bool {
  match compare_content_hash(left: left, right: right) {
    ContentHashEqual => true
    ContentHashDifferent => false
    ContentHashCrossFamilyIncomparable => false
  }
}

fn admitted(standing: FleetAdmissionStanding?) -> Bool {
  match standing {
    Present { value: a } =>
      match a {
        FleetAdmissible { receipt: r } => list_length(items: r.satisfied) == list_length(items: fleet_admission_required_phases)
        FleetNotAdmissible { missing: _, refused: _, subject_mismatched: _, subject_currency: _ } => false
      }
    Absent => false
  }
}

fn not_admissible_missing_count(standing: FleetAdmissionStanding?) -> Int {
  match standing {
    Present { value: a } =>
      match a {
        FleetNotAdmissible { missing: m, refused: _, subject_mismatched: _, subject_currency: _ } => list_length(items: m)
        FleetAdmissible { receipt: _ } => -1
      }
    Absent => -2
  }
}

// POSITIVE CONTROL — a complete, current, LINKED ledger derives admission, so
// every refusal below is discriminating rather than the derivation refusing all.
test fn complete_current_ledger_is_admissible() -> Bool {
  admitted(standing: admission_over(subject: subject_before, receipts: full_ledger(subject: subject_before)))
}

// CONTROL 4 — a manually authored terminal status cannot substitute for phase
// receipts: an EMPTY ledger is not even a ledger (validation refuses), and a
// ledger with one phase omitted refuses naming that phase. Admitted is
// reachable only through derivation over a validated ledger.
test fn empty_ledger_is_refused_by_validation() -> Bool {
  match validate_intake_receipt_ledger(receipts: []) {
    LedgerRefused { cause: c } => c == LedgerEmpty
    LedgerValidated { ledger: _ } => false
  }
}

test fn one_missing_phase_blocks_admission_and_is_named() -> Bool {
  let omitted = Arrival { phase: MemoryAuthoritativeQualify }
  match admission_over(subject: subject_before, receipts: ledger_without(subject: subject_before, omitted: omitted)) {
    Present { value: a } =>
      match a {
        FleetNotAdmissible { missing: m, refused: _, subject_mismatched: _, subject_currency: _ } =>
          list_length(items: m) == 1 && (m |> any(p => p == omitted))
        FleetAdmissible { receipt: _ } => false
      }
    Absent => false
  }
}

// CONTROL 1 (disposition side) — a repair changed one DIMM; the pre-repair
// ledger is complete and linked, and the machine is STILL not admissible
// because every receipt's subject is stale against the subject observed now.
test fn prior_admission_does_not_survive_a_dimm_swap() -> Bool {
  match admission_over(subject: subject_after, receipts: full_ledger(subject: subject_before)) {
    Present { value: a } =>
      match a {
        FleetNotAdmissible { missing: m, refused: _, subject_mismatched: s, subject_currency: _ } =>
          list_length(items: m) == 0 && list_length(items: s) == list_length(items: fleet_admission_required_phases)
        FleetAdmissible { receipt: _ } => false
      }
    Absent => false
  }
}

fn currency_of(standing: FleetAdmissionStanding?) -> SubjectCurrency? {
  match standing {
    Present { value: a } =>
      match a {
        FleetNotAdmissible { missing: _, refused: _, subject_mismatched: _, subject_currency: c } => Present { value: c }
        FleetAdmissible { receipt: _ } => none
      }
    Absent => none
  }
}

// REVIEW 57434 CONTROL — the reported currency is the axes that actually moved,
// never a constant: a firmware-only re-flash reports FirmwareManifestStale and
// NOT AssemblyManifestStale; a ledger produced before BOTH a DIMM swap and a
// re-flash reports both. The fabricated `{ assembly_changed: true }` this
// replaces would fail both halves, and so would a constant axis list: each arm
// requires the exact cardinality as well as the membership (review 57612 moved
// the three parallel Booleans to List<StaleAxis>). (A validated ledger carries exactly one subject, so
// receipts of two different stale subjects cannot share a ledger — that case
// refuses at validation, see mixed_attempt_ids_on_one_subject_are_refused.)
test fn stale_currency_names_the_axes_that_moved() -> Bool {
  let flash_only = match currency_of(standing: admission_over(subject: subject_after_flash, receipts: full_ledger(subject: subject_before))) {
    Present { value: c } =>
      match c {
        SubjectStale { axes: axes } =>
          list_length(items: axes.further_axes) == 0 && axes.first_axis == FirmwareManifestStale
        SubjectCurrent => false
      }
    Absent => false
  }
  let both = match currency_of(standing: admission_over(subject: subject_after_flash, receipts: full_ledger(subject: subject_after))) {
    Present { value: c } =>
      match c {
        SubjectStale { axes: axes } =>
          list_length(items: axes.further_axes) == 1
            && axes.first_axis == AssemblyManifestStale
            && (axes.further_axes |> any(x => x == FirmwareManifestStale))
        SubjectCurrent => false
      }
    Absent => false
  }
  flash_only && both
}

// Re-running from a stale attempt after a repair: the phase standing reports
// the subject mismatch rather than reading the old receipt as satisfaction.
test fn stale_attempt_receipt_reports_subject_mismatch() -> Bool {
  let phase = Arrival { phase: BootDeliveryEstablish }
  match phase_standing(phase: phase, subject: subject_after, receipts: [satisfied_receipt(phase: phase, subject: subject_before, previous: none)]) {
    PhaseReceiptSubjectMismatch { receipt: _, currency: _ } => true
    _ => false
  }
}

fn disposition_over(subject: QualificationSubject, receipts: List<IntakeReceiptEnvelope>, window: ReturnWindow) -> MachineIntakeDisposition? {
  match admission_over(subject: subject, receipts: receipts) {
    Present { value: a } => Present { value: derive_disposition(admission: a, return_window: window, evidence: []) }
    Absent => none
  }
}

// CONTROL 5 — a staging failure is a PartsHold owned by StagingInfrastructure,
// never a ReturnWindow hardware defect, even with the return window open.
test fn staging_failure_is_parts_hold_not_return_window() -> Bool {
  let phase = Arrival { phase: BootDeliveryEstablish }
  let receipts = ledger_stopped_at(subject: subject_before, phase: phase, owner: StagingInfrastructure, cause: "artifact service unreachable")
  match disposition_over(subject: subject_before, receipts: receipts, window: ReturnWindowOpen { deadline: 1790000000000 }) {
    Present { value: d } =>
      match d {
        PartsHold { reason: r, next_action: _ } =>
          match r {
            QualificationUnestablished { phase: p, owner: o, cause: _ } => p == phase && o == StagingInfrastructure
            _ => false
          }
        _ => false
      }
    Absent => false
  }
}

// Positive control for control 5: the SAME shape of refusal owned by the
// hardware, inside an open window, IS a ReturnWindow — so the owner is what
// decides, not the phase.
test fn hardware_defect_in_open_window_is_return_window() -> Bool {
  let phase = Arrival { phase: MemoryAuthoritativeQualify }
  let receipts = ledger_stopped_at(subject: subject_before, phase: phase, owner: UnitHardware, cause: "new uncorrectable error")
  match disposition_over(subject: subject_before, receipts: receipts, window: ReturnWindowOpen { deadline: 1790000000000 }) {
    Present { value: d } =>
      match d {
        ReturnWindow { defect: df, evidence: _, return_deadline: dl } => df.phase == phase && dl == 1790000000000
        _ => false
      }
    Absent => false
  }
}

test fn hardware_defect_outside_window_is_repair_or_cull() -> Bool {
  let phase = Arrival { phase: AcceptanceSoak }
  let receipts = ledger_stopped_at(subject: subject_before, phase: phase, owner: UnitHardware, cause: "thermal runaway")
  match disposition_over(subject: subject_before, receipts: receipts, window: ReturnWindowClosed) {
    Present { value: d } =>
      match d {
        PartsHold { reason: r, next_action: _ } =>
          match r {
            RepairOrCull { defect: df } => df.phase == phase
            _ => false
          }
        _ => false
      }
    Absent => false
  }
}

// Arrival and provisioning complete, placement not yet run: the state between
// the two gates is PartsHold { PlacementQualificationPending }, not Admitted.
test fn placement_pending_is_parts_hold_not_admitted() -> Bool {
  let done = concat(arrival_phases_all, provisioning_phases_all)
  let receipts = fold(done, init: [], f: (acc, p) => concat(acc, [satisfied_receipt(phase: p, subject: subject_before, previous: none)]))
  match disposition_over(subject: subject_before, receipts: receipts, window: ReturnWindowOpen { deadline: 1790000000000 }) {
    Present { value: d } =>
      match d {
        PartsHold { reason: r, next_action: _ } => r == PlacementQualificationPending
        Admitted { admission_receipt: _ } => false
        ReturnWindow { defect: _, evidence: _, return_deadline: _ } => false
      }
    Absent => false
  }
}

fn ledger_refusal(receipts: List<IntakeReceiptEnvelope>) -> IntakeLedgerRefusalCause? {
  match validate_intake_receipt_ledger(receipts: receipts) {
    LedgerRefused { cause: c } => Present { value: c }
    LedgerValidated { ledger: _ } => none
  }
}

// RULING (receipt-spine blocker) CONTROLS — the ledger validator IS the
// admission producer's only input, and each way a ledger can lie refuses:
// a second genesis, a broken link, reordered (non-monotone) receipts, a mixed
// attempt id on the same qualification subject.
test fn disconnected_genesis_receipts_are_refused() -> Bool {
  let unlinked = full_ledger(subject: subject_before)
  match ledger_refusal(receipts: unlinked) {
    Present { value: c } =>
      match c {
        LedgerMultipleGenesis { index: i } => i == 1
        _ => false
      }
    Absent => false
  }
}

test fn broken_link_is_refused() -> Bool {
  let linked = chain(receipts: full_ledger(subject: subject_before))
  let tampered = fold(linked, init: [], f: fn(acc, r) {
    if list_length(items: acc) == 3 {
      concat(acc, [IntakeReceiptEnvelope { schema: r.schema, subject: r.subject, phase: r.phase, producer: r.producer, policy_digest: r.policy_digest, started_at: r.started_at, ended_at: r.ended_at, observations: r.observations, result: r.result, previous_receipt: Present { value: content_hash_of_value(value: "forged-link") } }])
    } else {
      concat(acc, [r])
    }
  })
  match ledger_refusal(receipts: tampered) {
    Present { value: c } =>
      match c {
        LedgerBrokenLink { index: i } => i == 3
        _ => false
      }
    Absent => false
  }
}

test fn reordered_receipts_are_refused() -> Bool {
  let linked = chain(receipts: full_ledger(subject: subject_before))
  let rewound = fold(linked, init: [], f: fn(acc, r) {
    if list_length(items: acc) == 2 {
      concat(acc, [IntakeReceiptEnvelope { schema: r.schema, subject: r.subject, phase: r.phase, producer: r.producer, policy_digest: r.policy_digest, started_at: 1787000000000, ended_at: 1787000001000, observations: r.observations, result: r.result, previous_receipt: r.previous_receipt }])
    } else {
      concat(acc, [r])
    }
  })
  match ledger_refusal(receipts: rewound) {
    Present { value: c } =>
      match c {
        LedgerNonMonotoneTime { index: i } => i == 2
        _ => false
      }
    Absent => false
  }
}

test fn mixed_attempt_ids_on_one_subject_are_refused() -> Bool {
  let phase_a = Arrival { phase: BootDeliveryEstablish }
  let phase_b = Arrival { phase: MemoryAuthoritativeQualify }
  let mixed = chain(receipts: [
    receipt_at(phase: phase_a, subject: subject_before, attempt: attempt_one, result: ReceiptSatisfied, started_at: 0, previous: none),
    receipt_at(phase: phase_b, subject: subject_before, attempt: attempt_two, result: ReceiptSatisfied, started_at: 0, previous: none),
  ])
  match ledger_refusal(receipts: mixed) {
    Present { value: c } =>
      match c {
        LedgerSubjectMismatch { index: i } => i == 1
        _ => false
      }
    Absent => false
  }
}

// Retry semantics: a later refusal on a phase supersedes its earlier success
// (last-wins in ledger order), so a re-run that failed cannot hide behind the
// first attempt's receipt. The retry sits at the phase's own rank — an
// immediate retry — because a re-run appended after later phases is exactly
// the regression the validator now refuses (see the counterexample REDs).
test fn later_refusal_supersedes_earlier_success() -> Bool {
  let phase = Arrival { phase: MemoryAuthoritativeQualify }
  let receipts = full_ledger_retrying(subject: subject_before, phase: phase, first: ReceiptSatisfied, retry: ReceiptRefused { owner: UnitHardware, cause: "new corrected errors on retry" })
  match admission_over(subject: subject_before, receipts: receipts) {
    Present { value: a } =>
      match a {
        FleetNotAdmissible { missing: m, refused: r, subject_mismatched: _, subject_currency: _ } =>
          list_length(items: m) == 0 && list_length(items: r) == 1
        FleetAdmissible { receipt: _ } => false
      }
    Absent => false
  }
}

// Same-rank retry the other way: a refusal followed immediately by a satisfied
// re-run of the SAME phase validates and admits — so the rank rule admits an
// immediate retry and refuses only regression — and the admission receipt
// preserves provenance: it binds the phase to the RETRY's fingerprint (not the
// first receipt's), names the validated ledger's terminal fingerprint, and
// carries the attempt's policy digest.
test fn immediate_same_rank_retry_validates_and_binds_the_retry() -> Bool {
  let phase = Arrival { phase: MemoryAuthoritativeQualify }
  let receipts = chain(receipts: full_ledger_retrying(subject: subject_before, phase: phase, first: ReceiptRefused { owner: UnitHardware, cause: "corrected errors" }, retry: ReceiptSatisfied))
  let retry_fingerprint = fold(receipts, init: none, f: fn(acc, r) {
    let here = r.phase == phase
    if here { Present { value: intake_receipt_structural_fingerprint(envelope: r) } } else { acc }
  })
  match validate_intake_receipt_ledger(receipts: receipts) {
    LedgerRefused { cause: _ } => false
    LedgerValidated { ledger: l } =>
      match derive_fleet_admission(observed_subject: subject_before, ledger: l, now: 1788000002000) {
        FleetNotAdmissible { missing: _, refused: _, subject_mismatched: _, subject_currency: _ } => false
        FleetAdmissible { receipt: r } => {
          let bound = fold(r.satisfied, init: none, f: fn(acc, b) {
            let here = b.phase == phase
            if here { Present { value: b.receipt } } else { acc }
          })
          let binding_is_retry = match bound {
            Present { value: b } =>
              match retry_fingerprint {
                Present { value: f } => hashes_equal(left: b, right: f)
                Absent => false
              }
            Absent => false
          }
          binding_is_retry
            && hashes_equal(left: r.ledger_terminal_fingerprint, right: l.terminal_fingerprint)
            && hashes_equal(left: r.policy_digest, right: policy_digest)
            && list_length(items: r.satisfied) == list_length(items: fleet_admission_required_phases)
        }
      }
  }
}

// RULING 3 §4 COUNTEREXAMPLE 1 — every required receipt in REVERSE phase
// order, increasing timestamps, every link recomputed: link-valid, and refused
// at index 1 as a phase-rank regression. Before the rank rule this admitted.
test fn reverse_phase_order_with_valid_links_is_refused() -> Bool {
  let reversed = fold(full_ledger(subject: subject_before), init: [], f: (acc, r) => concat([r], acc))
  match ledger_refusal(receipts: chain(receipts: reversed)) {
    Present { value: c } =>
      match c {
        LedgerPhaseRegression { index: i } => i == 1
        _ => false
      }
    Absent => false
  }
}

// RULING 3 §4 COUNTEREXAMPLE 2 — a complete successful lifecycle followed by a
// fresh successful AccessDiscover: last-wins would make that discovery current
// while every downstream qualification predates it. Refused as a regression at
// the appended index; retrying an earlier phase requires a new attempt.
test fn fresh_access_discover_after_complete_lifecycle_is_refused() -> Bool {
  let full = full_ledger(subject: subject_before)
  let appended = concat(full, [satisfied_receipt(phase: Arrival { phase: AccessDiscover }, subject: subject_before, previous: none)])
  match ledger_refusal(receipts: chain(receipts: appended)) {
    Present { value: c } =>
      match c {
        LedgerPhaseRegression { index: i } => i == list_length(items: full)
        _ => false
      }
    Absent => false
  }
}

// RED — a receipt whose started_at exceeds its ended_at is refused at its
// index, before any link is read.
test fn inverted_receipt_interval_is_refused() -> Bool {
  let linked = chain(receipts: full_ledger(subject: subject_before))
  let inverted = fold(linked, init: [], f: fn(acc, r) {
    let here = list_length(items: acc) == 3
    if here {
      concat(acc, [IntakeReceiptEnvelope { schema: r.schema, subject: r.subject, phase: r.phase, producer: r.producer, policy_digest: r.policy_digest, started_at: r.started_at, ended_at: r.started_at - 1, observations: r.observations, result: r.result, previous_receipt: r.previous_receipt }])
    } else {
      concat(acc, [r])
    }
  })
  match ledger_refusal(receipts: inverted) {
    Present { value: c } =>
      match c {
        LedgerIntervalInverted { index: i } => i == 3
        _ => false
      }
    Absent => false
  }
}

// RED — a policy digest that differs from the genesis receipt's is refused at
// its index: one attempt runs under one policy.
test fn policy_digest_change_across_attempt_is_refused() -> Bool {
  let linked = chain(receipts: full_ledger(subject: subject_before))
  let changed = fold(linked, init: [], f: fn(acc, r) {
    let here = list_length(items: acc) == 2
    if here {
      concat(acc, [IntakeReceiptEnvelope { schema: r.schema, subject: r.subject, phase: r.phase, producer: r.producer, policy_digest: content_hash_of_value(value: "policy-revised-midway"), started_at: r.started_at, ended_at: r.ended_at, observations: r.observations, result: r.result, previous_receipt: r.previous_receipt }])
    } else {
      concat(acc, [r])
    }
  })
  match ledger_refusal(receipts: changed) {
    Present { value: c } =>
      match c {
        LedgerPolicyDigestChanged { index: i } => i == 2
        _ => false
      }
    Absent => false
  }
}

// RED — a producer identity that differs from the genesis receipt's (here the
// intake binary) is refused at its index: no producer-transition receipt is
// modeled, so a change of producer is a new attempt.
test fn producer_change_across_attempt_is_refused() -> Bool {
  let linked = chain(receipts: full_ledger(subject: subject_before))
  let other = IntakeProducerIdentity { intake_binary: content_hash_of_value(value: "intake-binary-upgraded"), staging_service_identity: "intake-staging", agent_artifact: none }
  let changed = fold(linked, init: [], f: fn(acc, r) {
    let here = list_length(items: acc) == 2
    if here {
      concat(acc, [IntakeReceiptEnvelope { schema: r.schema, subject: r.subject, phase: r.phase, producer: other, policy_digest: r.policy_digest, started_at: r.started_at, ended_at: r.ended_at, observations: r.observations, result: r.result, previous_receipt: r.previous_receipt }])
    } else {
      concat(acc, [r])
    }
  })
  match ledger_refusal(receipts: changed) {
    Present { value: c } =>
      match c {
        LedgerProducerChanged { index: i } => i == 2
        _ => false
      }
    Absent => false
  }
}

// Receipt chain: a correctly linked pair validates; a pair whose second link
// names the wrong predecessor does not.
test fn receipt_chain_link_is_checked_by_fingerprint() -> Bool {
  let first = satisfied_receipt(phase: Arrival { phase: BootDeliveryEstablish }, subject: subject_before, previous: none)
  let second_ok = receipt_at(phase: Arrival { phase: MemoryAuthoritativeQualify }, subject: subject_before, attempt: attempt_one, result: ReceiptSatisfied, started_at: 1788000005000, previous: Present { value: intake_receipt_structural_fingerprint(envelope: first) })
  let second_bad = receipt_at(phase: Arrival { phase: MemoryAuthoritativeQualify }, subject: subject_before, attempt: attempt_one, result: ReceiptSatisfied, started_at: 1788000005000, previous: Present { value: content_hash_of_value(value: "not-the-first") })
  let ok = match ledger_refusal(receipts: [first, second_ok]) {
    Absent => true
    Present { value: _ } => false
  }
  let bad = match ledger_refusal(receipts: [first, second_bad]) {
    Present { value: c } =>
      match c {
        LedgerBrokenLink { index: i } => i == 1
        _ => false
      }
    Absent => false
  }
  ok && bad
}

data issued: IssuedAttemptNonce = IssuedAttemptNonce {
  attempt_id: attempt_one,
  nonce: "nonce-7f3a" as IntakeAttemptNonce,
  artifact_digest: content_hash_of_value(value: "intake-iso-aarch64"),
  artifact_architecture: Aarch64,
  issued_at: 1788000000000,
}

fn agent_receipt(nonce: NonEmptyStr, artifact: NonEmptyStr, serial: NonEmptyStr) -> IntakeAgentBootReceipt {
  agent_receipt_on(nonce: nonce, artifact: artifact, serial: serial, arch: Aarch64)
}

fn agent_receipt_on(nonce: NonEmptyStr, artifact: NonEmptyStr, serial: NonEmptyStr, arch: Architecture) -> IntakeAgentBootReceipt {
  IntakeAgentBootReceipt {
    attempt_nonce: nonce as IntakeAttemptNonce,
    artifact_digest: content_hash_of_value(value: artifact),
    architecture: arch,
    board_serial: serial,
    assembly_observation: EvidenceRef { label: "smbios", digest: content_hash_of_value(value: "smbios-dump") },
    firmware_observation: EvidenceRef { label: "firmware", digest: content_hash_of_value(value: "firmware-dump") },
    booted_at: 1788000000500,
  }
}

// CONTROL — media activity, an image-redirection session and an NFS plateau
// WITHOUT the agent callback do not attest the boot; they ride in the refusal.
test fn activity_without_agent_receipt_does_not_attest_boot() -> Bool {
  match attest_diagnostic_boot(issued: issued, unit_key: unit, callbacks: [], supporting: [NfsReadPlateau, ImageRedirectionSessionActive]) {
    DiagnosticBootNotAttested { cause: c } =>
      match c {
        AgentReceiptAbsent { supporting: s } => list_length(items: s) == 2
        _ => false
      }
    DiagnosticBootAttested { attempt_id: _, receipt: _ } => false
  }
}

test fn nonce_bound_receipt_attests_and_wrong_nonce_refuses() -> Bool {
  let good = attest_diagnostic_boot(issued: issued, unit_key: unit, callbacks: [agent_receipt(nonce: "nonce-7f3a", artifact: "intake-iso-aarch64", serial: "BRD-000123")], supporting: [])
  let bad = attest_diagnostic_boot(issued: issued, unit_key: unit, callbacks: [agent_receipt(nonce: "nonce-0000", artifact: "intake-iso-aarch64", serial: "BRD-000123")], supporting: [])
  match good {
    DiagnosticBootAttested { attempt_id: a, receipt: _ } =>
      (a as NonEmptyStr) == (attempt_one as NonEmptyStr)
        && match bad {
             DiagnosticBootNotAttested { cause: c } => c == NonceMismatch
             DiagnosticBootAttested { attempt_id: _, receipt: _ } => false
           }
    DiagnosticBootNotAttested { cause: _ } => false
  }
}

test fn wrong_artifact_or_wrong_unit_refuses_attestation() -> Bool {
  let wrong_artifact = attest_diagnostic_boot(issued: issued, unit_key: unit, callbacks: [agent_receipt(nonce: "nonce-7f3a", artifact: "some-other-iso", serial: "BRD-000123")], supporting: [])
  let wrong_unit = attest_diagnostic_boot(issued: issued, unit_key: unit, callbacks: [agent_receipt(nonce: "nonce-7f3a", artifact: "intake-iso-aarch64", serial: "BRD-000999")], supporting: [])
  let a = match wrong_artifact {
    DiagnosticBootNotAttested { cause: c } =>
      match c {
        ArtifactDigestMismatch { expected: _, received: _ } => true
        _ => false
      }
    DiagnosticBootAttested { attempt_id: _, receipt: _ } => false
  }
  let b = match wrong_unit {
    DiagnosticBootNotAttested { cause: c } =>
      match c {
        BoardSerialMismatch { expected: _, received: r } => r == "BRD-000999"
        _ => false
      }
    DiagnosticBootAttested { attempt_id: _, receipt: _ } => false
  }
  a && b
}

// RED CONTROL — the receipt's architecture was carried and never compared, so
// an x86-64 agent callback would have attested an AArch64 unit's issuance.
test fn an_agent_on_the_wrong_architecture_does_not_attest_the_boot() -> Bool {
  let wrong = attest_diagnostic_boot(issued: issued, unit_key: unit, callbacks: [agent_receipt_on(nonce: "nonce-7f3a", artifact: "intake-iso-aarch64", serial: "BRD-000123", arch: X86_64)], supporting: [])
  match wrong {
    DiagnosticBootNotAttested { cause: c } =>
      match c {
        ArchitectureMismatch { expected: _, received: got } => got == X86_64
        _ => false
      }
    DiagnosticBootAttested { attempt_id: _, receipt: _ } => false
  }
}

// RED CONTROL — the nonce is a ONE-TIME callback token. A second callback on
// the same issuance is a replay and is refused even when it is identical to
// the first: honouring one of two would be an absorbing fallback (§5).
test fn a_second_callback_on_one_nonce_is_a_replay_not_a_boot() -> Bool {
  let one = agent_receipt(nonce: "nonce-7f3a", artifact: "intake-iso-aarch64", serial: "BRD-000123")
  let replay = attest_diagnostic_boot(issued: issued, unit_key: unit, callbacks: [one, one], supporting: [])
  match replay {
    DiagnosticBootNotAttested { cause: c } =>
      match c {
        DuplicateAgentCallback { received: n } => n == 2
        _ => false
      }
    DiagnosticBootAttested { attempt_id: _, receipt: _ } => false
  }
}
