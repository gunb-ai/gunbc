module test.claim.machine_intake.mtcollins1_boot_authorization_witness_test

import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.types { Bool, String }
import gunbc.machine_intake_mtcollins1_boot_authorization {
  mtcollins1_boot_subject,
  mtcollins1_boot_medium,
  mtcollins1_boot_medium_image_name,
  mtcollins1_boot_medium_image_sha256,
}
import extdeps.toolchain.types { Aarch64 }
import extdeps.bmc.ipmi_boot_selection { IpmiBootCdrom, IpmiBootEfi, IpmiBootOnce, ipmi_boot_selection_label }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// The approval-gate claims that lived here were deleted with the approval stage (operator ruling
// 2026-09-23); the boot subject they were signed over remains the one record the attach, the handoff
// and the terminal verdict read, so its derivation from the medium row is still claimed.
test fn subject_names_the_selected_medium() -> Bool {
  let s = mtcollins1_boot_subject(execution_revision: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
  s.image_name == mtcollins1_boot_medium_image_name(medium: mtcollins1_boot_medium)
    && s.image_sha256 == mtcollins1_boot_medium_image_sha256(medium: mtcollins1_boot_medium)
    && (s.image_name as String) == "gunbc-mtcollins1-census-ubuntu-24.04.3-arm64-6455b3b9ae11214d.iso"
    && s.machine as String == "mtcollins1"
    && s.execution_revision as String == "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    && s.selection.architecture == Aarch64
    && s.selection.firmware_mode == IpmiBootEfi
    && s.selection.persistence == IpmiBootOnce
    && s.selection.device == IpmiBootCdrom
    && (ipmi_boot_selection_label(selection: s.selection) as String) == "cdrom/efi/once"
}
