module test.claim.machine_intake.mtcollins1_boot_federation_witness_test

import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.types { Bool, List, NonEmptyStr, String }
import gunbc.auth.oidc_claim_pins { OidcClaimPin }
import gunbc.auth.mtcollins1_boot_federation {
  mtcollins1_boot_claim_pins, mtcollins1_boot_claims_admitted, mtcollins1_boot_wif_attribute_condition,
  mtcollins1_boot_secret_grants, mtcollins1_boot_wif_principal_set,
}
import gunbc.auth.gcp_secret_access { SecretAccessGrant }
import v2.std.optional { Present, Absent }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// ── The federation: only this workflow, at main, dispatched, in the boot environment ───────────
fn boot_job_claims() -> List<OidcClaimPin> {
  mtcollins1_boot_claim_pins()
}

fn with_claim(claims: List<OidcClaimPin>, claim: NonEmptyStr, value: String) -> List<OidcClaimPin> {
  concat(filter(claims, c => (c.claim as String) != (claim as String)), [OidcClaimPin { claim: claim, value: value }])
}

fn without_claim(claims: List<OidcClaimPin>, claim: NonEmptyStr) -> List<OidcClaimPin> {
  filter(claims, c => (c.claim as String) != (claim as String))
}

// THE CONTROL: the boot job's own token is admitted. THE REDS: another workflow file, another ref,
// a pull_request event, another environment, and a job with no environment (every other job in
// fleet-converge.yml) are each refused -- one claim changed at a time, so each red is attributable.
test fn only_the_boot_jobs_oidc_subject_is_admitted_to_the_dedicated_pool() -> Bool {
  let c = boot_job_claims()
  mtcollins1_boot_claims_admitted(claims: c)
    && !mtcollins1_boot_claims_admitted(claims: with_claim(claims: c, claim: "workflow_ref", value: "gunb-ai/gunbc/.github/workflows/witnesses.yml@refs/heads/main"))
    && !mtcollins1_boot_claims_admitted(claims: with_claim(claims: c, claim: "ref", value: "refs/heads/feature"))
    && !mtcollins1_boot_claims_admitted(claims: with_claim(claims: c, claim: "workflow_ref", value: "gunb-ai/gunbc/.github/workflows/fleet-converge.yml@refs/heads/feature"))
    && !mtcollins1_boot_claims_admitted(claims: with_claim(claims: c, claim: "event_name", value: "pull_request"))
    && !mtcollins1_boot_claims_admitted(claims: with_claim(claims: c, claim: "environment", value: "production"))
    && !mtcollins1_boot_claims_admitted(claims: without_claim(claims: c, claim: "environment"))
}

// THE PROVISIONED CONDITION IS THE ADMISSION'S OWN PINS: every pin appears in the CEL string GCP
// stores, so the refusal above is the provider's, not a second description of it.
test fn the_provider_condition_carries_every_pin() -> Bool {
  let cond = mtcollins1_boot_wif_attribute_condition()
  all(mtcollins1_boot_claim_pins(), p => string_contains(s: cond, pattern: join(["assertion.", p.claim as String, " == '", p.value, "'"], "")))
    && string_contains(s: cond, pattern: "fleet-converge.yml@refs/heads/main")
    && string_contains(s: cond, pattern: "assertion.environment == 'mtcollins1-boot'")
}

// EXACTLY TWO CELLS, EACH ON ONE PINNED VERSION, AND THE IMPERSONATION MEMBER IS THE DEDICATED POOL,
// never the repository pool.
fn grant_is_version_pinned(g: SecretAccessGrant) -> Bool {
  match g.condition {
    Present { value: c } => string_contains(s: c.expression, pattern: join(["/secrets/", g.target.secret as String, "/versions/", g.target.version as String, "\""], ""))
    Absent => false
  }
}

test fn the_boot_account_reads_exactly_two_pinned_versions_from_the_dedicated_pool() -> Bool {
  let gs = mtcollins1_boot_secret_grants()
  (gs |> count) == 2
    && all(gs, g => grant_is_version_pinned(g: g))
    && any(gs, g => (g.target.secret as String) == "bmc-mtcollins1-gunbc")
    && any(gs, g => (g.target.secret as String) == "fleet-automation-ssh-key")
    && !any(gs, g => (g.target.secret as String) == "approval-submission-mac-key")
    && string_contains(s: mtcollins1_boot_wif_principal_set(), pattern: "/workloadIdentityPools/github-mtcollins1-boot/*")
    && !string_contains(s: mtcollins1_boot_wif_principal_set(), pattern: "/workloadIdentityPools/github-actions/")
}
