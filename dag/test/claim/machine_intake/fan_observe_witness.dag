import std.optional { Present, Absent }
import gunbc.fleet.fleet_converge_workflow {
  fleet_converge_fan_observe_ipmi_series_step_name,
  fleet_converge_fan_policy_phase_step,
  fleet_converge_fan_policy_phase_receipt_upload_step,
  fleet_converge_mtcollins1_boot_steps_around,
  fleet_converge_mtcollins1_fan_observe_step,
}
import extdeps.languages.yaml.types { YamlString }
import gunbc.ci.ci_spec {
  gunbc_ci_mtcollins1_fan_observe_boot_phase_invoke,
  gunbc_ci_mtcollins1_fan_observe_invoke,
  gunbc_ci_mtcollins1_kvm_observer_observe_invoke,
  gunbc_ci_mtcollins1_probe_rendered,
  gunbc_ci_auth_header_format,
}
import v2.extdeps.languages.bash_build {
  bash_build_word_lit, bash_build_word_var, bash_build_word_concat_from_nodes, bash_build_command_with_words,
  bash_build_assign, bash_build_with_redir_to_file,
}
import extdeps.github.actions { Step, RunStep, UsesStep }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import extdeps.bmc.endpoint { OpenBmc }
import extdeps.bmc.capability { bmc_firmware_release_identity_of_wire }
import extdeps.bmc.access_profile { BmcAccessObservation, BmcAccessObserved, BmcAccessUnobserved, BmcObservedIdentity }
import gunbc.fleet.fleet_host_identity { operator_host_mtcollins1 }
import gunbc.host.managed_host { ManagedHostFound, managed_host_binding_for, managed_host_fixture, managed_hosts }
import gunbc.host.bmc_control_binding { bmc_control_binding }
import gunbc.machine_intake.mtcollins1_fan_observe { mtcollins1_fan_credential_fetch_status_suffix }
import gunbc.machine_intake.fan_observe {
  FanObserveAdmission, FanObserveAdmitted, FanObserveRefused, FanHostFamilyUnobserved, FanHostNotManaged,
  fan_observe_admission, fan_observe_authority, fan_observe_refusal_text,
}

// The claims that execute the fan step's emitted bash or touch real files live in
// test.claim.machine_intake.fan_observe_local_wet, on the local-repo wet lane; every claim here
// evaluates under Hermetic.
data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn authority_names(a: FanObserveAdmission, module_path: String, decl_name: String) -> Bool {
  match a {
    FanObserveAdmitted { host: h } =>
      (fan_observe_authority(host: h).declaration.module_path as String) == module_path
        && (fan_observe_authority(host: h).declaration.decl_name as String) == decl_name
    FanObserveRefused { cause: _ } => false
  }
}

// THE INHABITANCE CLAIM, AND IT ASSERTS THE ROUTE: the one managed row, mtcollins1, reaches the fan read
// through its real binding (gunbc.host.managed_host managed_host_binding_for, the lookup the wet entry
// makes), and its observed family -- AMI MegaRAC -- selects the MegaRAC policy authority. Its observed
// family changing, its binding refusing, or the dispatch defaulting turns this red.
test fn the_megarac_row_is_read_against_the_megarac_policy() -> Bool {
  let a = fan_observe_admission(lookup: managed_host_binding_for(host: operator_host_mtcollins1 as NonEmptyStr))
  authority_names(a: a, module_path: "extdeps.bmc.megarac_fan_policy", decl_name: "megarac_fan_policy_standing")
    && match a {
      FanObserveAdmitted { host: h } =>
        (h.host as String) == (operator_host_mtcollins1 as String)
          && managed_hosts() |> all(r => match r.access {
            BmcAccessObserved { observation: o } => (o.endpoint.host as String) == (h.observation.endpoint.host as String)
            BmcAccessUnobserved { endpoint: _ } => false
          })
          && (h.account as String) == "gunbc"
      FanObserveRefused { cause: _ } => false
    }
}

fn observation_as_openbmc(o: BmcAccessObservation) -> BmcAccessObservation {
  BmcAccessObservation {
    endpoint: o.endpoint,
    identity: BmcObservedIdentity { board: o.identity.board, chassis_part_number: o.identity.chassis_part_number, firmware: bmc_firmware_release_identity_of_wire(family: OpenBmc, wire: o.identity.firmware.raw_version) },
    discovered_surfaces: o.discovered_surfaces,
    boot_control_routes: o.boot_control_routes,
    redfish_virtual_media_probe: o.redfish_virtual_media_probe,
    successful_read_surfaces: o.successful_read_surfaces,
    successful_write_surfaces: o.successful_write_surfaces,
    raw_response: o.raw_response,
    observed_at: o.observed_at,
  }
}

// A SUPPLIED CONTROL, NOT A BINDING: no managed host is OpenBMC-bound. The real row with ONLY its observed
// family changed selects the phosphor zone contract, so the authority follows the observed family and is
// not a constant of the module.
test fn an_openbmc_bound_row_is_read_against_the_phosphor_policy() -> Bool {
  match managed_hosts().first() {
    Absent => false
    Present { value: h } =>
      match h.access {
        BmcAccessUnobserved { endpoint: _ } => false
        BmcAccessObserved { observation: o } => {
          let openbmc = managed_host_fixture(host: h.host, access: BmcAccessObserved { observation: observation_as_openbmc(o: o) }, secure: h.secure, smpro: h.smpro)
          authority_names(a: fan_observe_admission(lookup: ManagedHostFound { host: openbmc, control: bmc_control_binding(observed: openbmc.access, secured: openbmc.secure) }), module_path: "extdeps.bmc.phosphor_fan_control", decl_name: "phosphor_fan_zone_policy_contract")
        }
      }
  }
}

// RED: THE SAME ROW WITH ITS CONTROLLER UNOBSERVED (Mt. Jade's standing). There is no family to select a
// policy from, so the read refuses with a cause naming the controller whose observation is missing -- it
// is never read against either policy by default.
test fn a_row_whose_family_is_unobserved_refuses_naming_the_missing_observation() -> Bool {
  match managed_hosts().first() {
    Absent => false
    Present { value: h } =>
      match h.access {
        BmcAccessUnobserved { endpoint: _ } => false
        BmcAccessObserved { observation: o } => {
          let unobserved = managed_host_fixture(host: h.host, access: BmcAccessUnobserved { endpoint: o.endpoint }, secure: h.secure, smpro: h.smpro)
          match fan_observe_admission(lookup: ManagedHostFound { host: unobserved, control: bmc_control_binding(observed: unobserved.access, secured: unobserved.secure) }) {
            FanObserveRefused { cause: FanHostFamilyUnobserved { endpoint: e } } =>
              (e.host as String) == (o.endpoint.host as String)
                && string_contains(s: fan_observe_refusal_text(cause: FanHostFamilyUnobserved { endpoint: e }) as String, pattern: "was never observed")
            _ => false
          }
        }
      }
  }
}

// RED: A HOST THE FLEET DOES NOT MANAGE. mtjade1 has no managed row, so its fan read refuses by name.
test fn a_host_that_is_not_managed_refuses() -> Bool {
  match fan_observe_admission(lookup: managed_host_binding_for(host: "mtjade1" as NonEmptyStr)) {
    FanObserveRefused { cause: FanHostNotManaged { host: n } } => (n as String) == "mtjade1"
    _ => false
  }
}

fn fan_policy_phase_step_name(s: Step) -> String {
  match s {
    RunStep { name: n, id: _, run: _, shell: _, env: _, working_directory: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } =>
      match n {
        Present { value: v } => v
        Absent => ""
      }
    UsesStep { name: n, id: _, uses: _, with: _, env: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } =>
      match n {
        Present { value: v } => v
        Absent => ""
      }
  }
}

fn fan_policy_phase_step_run_text(s: Step) -> String {
  match s {
    RunStep { name: _, id: _, run: r, shell: _, env: _, working_directory: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } => r
    UsesStep { name: _, id: _, uses: _, with: _, env: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } => ""
  }
}

fn fan_policy_phase_marker_step(marker: String) -> Step {
  RunStep { name: none, id: none, run: marker, shell: none, env: none, working_directory: none, if_condition: none, continue_on_error: none, timeout_minutes: none }
}

data fan_policy_phase_supplied_fleet_key: String = "SUPPLIED-FLEET-KEY-STEP"
data fan_policy_phase_supplied_boot: String = "SUPPLIED-BOOT-STEP"

// THE PHASE NAME IS THE IPMI SERIES, BECAUSE THAT IS THE INVOKE. A Cooling Manager / PWM REST
// label on this run would report a MegaRAC GET that never ran.
test fn fan_policy_phase_names_the_ipmi_sdr_series_it_runs() -> Bool {
  fan_policy_phase_step_name(s: fleet_converge_fan_policy_phase_step())
    == fleet_converge_fan_observe_ipmi_series_step_name
    && fan_policy_phase_step_name(s: fleet_converge_mtcollins1_fan_observe_step())
      == fleet_converge_fan_observe_ipmi_series_step_name
    && fan_policy_phase_step_run_text(s: fleet_converge_fan_policy_phase_step())
      == gunbc_ci_mtcollins1_fan_observe_boot_phase_invoke()
    && fan_policy_phase_step_run_text(s: fleet_converge_mtcollins1_fan_observe_step())
      == gunbc_ci_mtcollins1_fan_observe_invoke()
    && !string_contains(s: gunbc_ci_mtcollins1_fan_observe_boot_phase_invoke(), pattern: "dissolve-on")
}

// THE PHASE IS A PRIOR JOB STEP, NOT A CHILD OF THE BOOT INVOKE. GitHub Actions runs job steps
// sequentially, so this gunbc run exits before the boot step starts its concurrent pair.
test fn fan_policy_phase_runs_before_the_power_cycle_and_not_inside_it() -> Bool {
  let runs = map(
    fleet_converge_mtcollins1_boot_steps_around(
      fleet_key_step: fan_policy_phase_marker_step(marker: fan_policy_phase_supplied_fleet_key),
      boot_step: fan_policy_phase_marker_step(marker: fan_policy_phase_supplied_boot),
    ),
    s => fan_policy_phase_step_run_text(s: s),
  )
  let fan = gunbc_ci_mtcollins1_fan_observe_boot_phase_invoke()
  filter(runs, r => r == fan_policy_phase_supplied_fleet_key || r == fan || r == fan_policy_phase_supplied_boot)
    == [fan_policy_phase_supplied_fleet_key, fan, fan_policy_phase_supplied_boot]
}

fn fan_policy_phase_continue_on_error(s: Step) -> Bool {
  match s {
    RunStep { name: _, id: _, run: _, shell: _, env: _, working_directory: _, if_condition: _, continue_on_error: c, timeout_minutes: _ } =>
      match c {
        Present { value: v } => v
        Absent => false
      }
    UsesStep { name: _, id: _, uses: _, with: _, env: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } => false
  }
}

fn fan_policy_phase_timeout_present(s: Step) -> Bool {
  match s {
    RunStep { name: _, id: _, run: _, shell: _, env: _, working_directory: _, if_condition: _, continue_on_error: _, timeout_minutes: t } =>
      match t {
        Present { value: _ } => true
        Absent => false
      }
    UsesStep { name: _, id: _, uses: _, with: _, env: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } => false
  }
}

// CONTROL (review 81077): an UNMODELED failure in the phase fails the job AT this step. The step
// carries no continue-on-error - non-gating is the entry's typed receipt path, not an absorbed exit
// code - and it keeps its timeout, so a hang dies here, before the boot, located. The standalone
// observe step was and stays strict the same way.
test fn fan_policy_phase_unmodeled_failure_fails_loud_at_the_step() -> Bool {
  !fan_policy_phase_continue_on_error(s: fleet_converge_fan_policy_phase_step())
    && fan_policy_phase_timeout_present(s: fleet_converge_fan_policy_phase_step())
    && !fan_policy_phase_continue_on_error(s: fleet_converge_mtcollins1_fan_observe_step())
}

// CONTROL (review 81090 finding B): the credential carrier carries ONLY a credential. The boot-phase
// prelude reports a refused Secret Manager fetch through a sibling STATUS file named by the reader's
// own constant, removes the credential file on refusal, and the strict KVM lane keeps the old shape
// (fetch failure dies under set -e, and no status file logic rides along in its script).
test fn fan_policy_phase_credential_fetch_is_typed_and_kvm_stays_strict() -> Bool {
  let boot = gunbc_ci_mtcollins1_fan_observe_boot_phase_invoke()
  let kvm = gunbc_ci_mtcollins1_kvm_observer_observe_invoke()
  string_contains(s: boot, pattern: "||")
    && string_contains(s: boot, pattern: mtcollins1_fan_credential_fetch_status_suffix)
    && string_contains(s: boot, pattern: "fetch-failed")
    && string_contains(s: boot, pattern: "'ok' > \"$STATUS_FILE\"")
    && !string_contains(s: kvm, pattern: "STATUS_FILE")
    && !string_contains(s: kvm, pattern: "fetch-failed")
}

// CONTROL (review round, blocker 1): the cleanup trap must never meet an unset variable. set -u is
// on from the first line, so an EXIT trap naming $STATUS_FILE while it is still unset aborts the trap
// BEFORE its rm runs - and the window between trap-install and the bearer-token header write is
// exactly where token-bearing temp files exist. The emitted typed script must therefore read, in
// this order: STATUS_FILE assignment, trap, stale-status rm, header write. Order is asserted on
// CONTIGUOUS pairs rendered by the very builders the prelude uses (the real rm list, the real header
// format), and the reverse of the first pair must be absent - a script that moved the assignment
// after the trap fails this claim. The strict lane stays free of STATUS_FILE entirely.
test fn fan_policy_phase_trap_names_no_unsettled_variable() -> Bool {
  let boot = gunbc_ci_mtcollins1_fan_observe_boot_phase_invoke()
  let kvm = gunbc_ci_mtcollins1_kvm_observer_observe_invoke()
  let status_assign = bash_build_assign(name: "STATUS_FILE", value: bash_build_word_concat_from_nodes(parts: [bash_build_word_var(name: "DEST_FILE"), bash_build_word_lit(text: mtcollins1_fan_credential_fetch_status_suffix)]))
  let trap_stmt = bash_build_command_with_words(words: [
    bash_build_word_lit(text: "trap"),
    bash_build_word_lit(text: gunbc_ci_mtcollins1_probe_rendered(stmts: [bash_build_command_with_words(words: [
      bash_build_word_lit(text: "rm"), bash_build_word_lit(text: "-f"),
      bash_build_word_var(name: "HDR_FILE"), bash_build_word_var(name: "RESP_FILE"),
      bash_build_word_var(name: "DEST_FILE"), bash_build_word_var(name: "STATUS_FILE"),
    ])], set_e: false)),
    bash_build_word_lit(text: "EXIT"),
  ])
  let rm_status = bash_build_command_with_words(words: [bash_build_word_lit(text: "rm"), bash_build_word_lit(text: "-f"), bash_build_word_var(name: "STATUS_FILE")])
  let header_write = bash_build_with_redir_to_file(inner: bash_build_command_with_words(words: [bash_build_word_lit(text: "printf"), bash_build_word_lit(text: gunbc_ci_auth_header_format), bash_build_word_var(name: "WIF_ACCESS_TOKEN")]), path: bash_build_word_var(name: "HDR_FILE"))
  string_contains(s: boot, pattern: gunbc_ci_mtcollins1_probe_rendered(stmts: [status_assign, trap_stmt], set_e: false))
    && !string_contains(s: boot, pattern: gunbc_ci_mtcollins1_probe_rendered(stmts: [trap_stmt, status_assign], set_e: false))
    && string_contains(s: boot, pattern: gunbc_ci_mtcollins1_probe_rendered(stmts: [trap_stmt, rm_status], set_e: false))
    && string_contains(s: boot, pattern: gunbc_ci_mtcollins1_probe_rendered(stmts: [rm_status, header_write], set_e: false))
    && !string_contains(s: kvm, pattern: "STATUS_FILE")
}

// CONTROL: the receipt upload still fails the job when the phase wrote NOTHING (review 81077's
// wrong-place-failure finding is closed at the other end: every modeled path writes a receipt, so a
// missing file now means the step itself died - and it already failed at the fan step). Under
// always() so an early-failing job still reports it, fail-closed on no-files-found.
test fn fan_policy_phase_receipt_upload_fails_closed_under_always() -> Bool {
  let upload = fleet_converge_fan_policy_phase_receipt_upload_step()
  match upload {
    UsesStep { name: _, id: _, uses: _, with: w, env: _, if_condition: i, continue_on_error: c, timeout_minutes: _ } =>
      match w {
        Present { value: with } =>
          with |> any(k =>
            k.key == "if-no-files-found"
              && match k.value { YamlString { value: v } => v == "error"  _ => false })
            && match i { Present { value: "always()" } => true  _ => false }
            && match c { Absent => true  _ => false }
        Absent => false
      }
    RunStep { name: _, id: _, run: _, shell: _, env: _, working_directory: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } => false
  }
}

// CONTROL: no step after boot can turn a refused observation into a job failure; the phase's
// refusal is a typed receipt whose tail fails the fan step itself, so the receipt upload is the last fan step.
test fn fan_policy_phase_has_no_post_boot_gate() -> Bool {
  let ids = map(
    fleet_converge_mtcollins1_boot_steps_around(
      fleet_key_step: fan_policy_phase_marker_step(marker: fan_policy_phase_supplied_fleet_key),
      boot_step: fan_policy_phase_marker_step(marker: fan_policy_phase_supplied_boot),
    ),
    s => fan_policy_phase_step_run_text(s: s),
  )
  filter(ids, r => string_contains(s: r, pattern: "boot_phase_verdict")) == []
}
