module test.claim.machine_intake.mtcollins1_maintenance_hold_witness_test

import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.types { Bool, List, NonEmptyStr, String }
import std.durable_exclusive_hold {
  DurableHoldOwnerRef, DurableHoldReleaseRef, HoldSlotAbsent, HoldSlotFree, HoldSlotHeld, HoldSlotUndecodable,
  HoldReleaseAgainstAnotherGeneration, HoldReleaseHeldByAnotherOwner, HoldReleaseAlreadyFree,
}
import std.durable_compare_and_set { CasGeneration, cas_generation_first }
import gunbc.durable_exclusive_hold_file_store {
  FileHoldAcquireOutcome, FileHoldAcquired, FileHoldOccupied, FileHoldAcquireLost, FileHoldSlotUndecodable,
  FileHoldReleased, FileHoldReleaseLost,
}
import gunbc.machine_intake_mtcollins1_maintenance_hold {
  UnitHoldOwner, OperatorMaintenance, BootRun, HostResetReturn, KvmObserverProbe, UnitHoldOwnerDecoded, UnitHoldOwnerUnrecognized,
  unit_hold_owner_ref, decode_unit_hold_owner, unit_hold_owner_label,
  unit_hold_refusal, operator_maintenance_owner, boot_run_owner, host_reset_owner, mtcollins1_unit_hold_key,
  ProbeHoldReleaseDecision, ProbeHoldReleaseAt, ProbeHoldFreeNoop, ProbeHoldForeignNoop, ProbeHoldUnobservable,
  ProbeHoldReleaseOutcome, ProbeHoldReleased, ProbeHoldAlreadyFree, ProbeHoldNotOurs, ProbeHoldStale, ProbeHoldUnreleased,
  probe_hold_release_decision, probe_hold_release_refused, probe_hold_release_committed,
  HolderLivenessRoute, HolderObserveProcess, HolderNotObservable, holder_liveness_route,
}
import gunbc.auth.oidc_claim_pins { OidcClaimPin }
import gunbc.auth.mtcollins1_boot_federation {
  mtcollins1_boot_claim_pins, mtcollins1_boot_claims_admitted, mtcollins1_boot_wif_attribute_condition,
  mtcollins1_boot_secret_grants, mtcollins1_boot_wif_principal_set,
}
import gunbc.auth.gcp_secret_access { SecretAccessGrant }
import v2.std.optional { Present, Absent }
import gunbc.build_cache_instance { ProcessIdentity }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data holder_process: ProcessIdentity = ProcessIdentity { boot_id: "73c8153e-0e0e-4480-a36c-bc7560c50e8b" as NonEmptyStr, pid: 3975, start_time: "81234" as NonEmptyStr }

// ── The interlock: the boot refuses under an active maintenance hold ──────────────────────────
// Supplied at the interface (DESIGN §3, a witness discriminates at one interface), and only into the
// PURE refusal fold: a supplied outcome yields text and never a UnitHoldProof, whose one mint is the
// live acquire (the forged-proof refusal is test.claim.machine_intake.mtcollins1_unit_hold_forged_probe_witness_test).
// The store route itself is test.claim.durable_exclusive_hold_file_store_wet_witness.

fn first_generation() -> CasGeneration {
  cas_generation_first()
}

fn refused_naming(r: NonEmptyStr?, pattern: String) -> Bool {
  match r {
    Present { value: why } => string_contains(s: why as String, pattern: pattern) && string_contains(s: why as String, pattern: "controller untouched")
    Absent => false
  }
}

fn not_refused(r: NonEmptyStr?) -> Bool {
  match r {
    Present { value: _ } => false
    Absent => true
  }
}

// THE RED: the operator holds the unit (DIMM reseat), and the acquire is refused naming the holder.
// THE CONTROL beside it: the same unit acquired is no refusal.
test fn the_boot_refuses_under_an_active_maintenance_hold_and_names_the_holder() -> Bool {
  let held = FileHoldOccupied {
    slot_key: mtcollins1_unit_hold_key,
    holder: operator_maintenance_owner(reason: "reseating DIMMs"),
    generation: first_generation(),
  }
  refused_naming(r: unit_hold_refusal(outcome: held), pattern: "operator-maintenance:reseating DIMMs")
    && not_refused(r: unit_hold_refusal(outcome: FileHoldAcquired { slot_key: mtcollins1_unit_hold_key, owner: boot_run_owner(run_id: "42", process: holder_process, pid_namespace: "pid:[4026531836]"), generation: first_generation() }))
}

// ANOTHER HOLDER IS A HOLDER: a running boot, or a host reset-return, excludes the next writer.
test fn a_second_writer_refuses_while_another_run_holds_the_unit() -> Bool {
  refused_naming(r: unit_hold_refusal(outcome: FileHoldOccupied { slot_key: mtcollins1_unit_hold_key, holder: boot_run_owner(run_id: "41", process: holder_process, pid_namespace: "pid:[4026531836]"), generation: first_generation() }), pattern: "mtcollins1-boot:41")
    && refused_naming(r: unit_hold_refusal(outcome: FileHoldOccupied { slot_key: mtcollins1_unit_hold_key, holder: host_reset_owner(attempt: "srv1-mtcollins1"), generation: first_generation() }), pattern: "host-reset-return:srv1-mtcollins1")
}

// AN INTERLOCK THAT CANNOT BE READ IS NOT RELEASED: a lost race and an undecodable slot refuse.
test fn an_unreadable_or_contended_hold_refuses_rather_than_proceeding() -> Bool {
  refused_naming(r: unit_hold_refusal(outcome: FileHoldAcquireLost { slot_key: mtcollins1_unit_hold_key }), pattern: "lost the race")
    && refused_naming(r: unit_hold_refusal(outcome: FileHoldSlotUndecodable { slot_key: mtcollins1_unit_hold_key, generation: first_generation(), detail: "garbage" }), pattern: "undecodable")
}

// ── The federation: only this workflow, at main, dispatched, in the boot environment ───────────
fn boot_job_claims() -> List<OidcClaimPin> {
  mtcollins1_boot_claim_pins()
}

fn with_claim(claims: List<OidcClaimPin>, claim: NonEmptyStr, value: String) -> List<OidcClaimPin> {
  concat(filter(claims, c => (c.claim as String) != (claim as String)), [OidcClaimPin { claim: claim, value: value }])
}

fn without_claim(claims: List<OidcClaimPin>, claim: NonEmptyStr) -> List<OidcClaimPin> {
  filter(claims, c => (c.claim as String) != (claim as String))
}

// THE CONTROL: the boot job's own token is admitted. THE REDS: another workflow file, another ref,
// a pull_request event, another environment, and a job with no environment (every other job in
// fleet-converge.yml) are each refused -- one claim changed at a time, so each red is attributable.
test fn only_the_boot_jobs_oidc_subject_is_admitted_to_the_dedicated_pool() -> Bool {
  let c = boot_job_claims()
  mtcollins1_boot_claims_admitted(claims: c)
    && !mtcollins1_boot_claims_admitted(claims: with_claim(claims: c, claim: "workflow_ref", value: "gunb-ai/gunbc/.github/workflows/witnesses.yml@refs/heads/main"))
    && !mtcollins1_boot_claims_admitted(claims: with_claim(claims: c, claim: "ref", value: "refs/heads/feature"))
    && !mtcollins1_boot_claims_admitted(claims: with_claim(claims: c, claim: "workflow_ref", value: "gunb-ai/gunbc/.github/workflows/fleet-converge.yml@refs/heads/feature"))
    && !mtcollins1_boot_claims_admitted(claims: with_claim(claims: c, claim: "event_name", value: "pull_request"))
    && !mtcollins1_boot_claims_admitted(claims: with_claim(claims: c, claim: "environment", value: "production"))
    && !mtcollins1_boot_claims_admitted(claims: without_claim(claims: c, claim: "environment"))
}

// THE PROVISIONED CONDITION IS THE ADMISSION'S OWN PINS: every pin appears in the CEL string GCP
// stores, so the refusal above is the provider's, not a second description of it.
test fn the_provider_condition_carries_every_pin() -> Bool {
  let cond = mtcollins1_boot_wif_attribute_condition()
  all(mtcollins1_boot_claim_pins(), p => string_contains(s: cond, pattern: join(["assertion.", p.claim as String, " == '", p.value, "'"], "")))
    && string_contains(s: cond, pattern: "fleet-converge.yml@refs/heads/main")
    && string_contains(s: cond, pattern: "assertion.environment == 'mtcollins1-boot'")
}

// EXACTLY TWO CELLS, EACH ON ONE PINNED VERSION, AND THE IMPERSONATION MEMBER IS THE DEDICATED POOL,
// never the repository pool.
fn grant_is_version_pinned(g: SecretAccessGrant) -> Bool {
  match g.condition {
    Present { value: c } => string_contains(s: c.expression, pattern: join(["/secrets/", g.target.secret as String, "/versions/", g.target.version as String, "\""], ""))
    Absent => false
  }
}

test fn the_boot_account_reads_exactly_two_pinned_versions_from_the_dedicated_pool() -> Bool {
  let gs = mtcollins1_boot_secret_grants()
  (gs |> count) == 2
    && all(gs, g => grant_is_version_pinned(g: g))
    && any(gs, g => (g.target.secret as String) == "bmc-mtcollins1-gunbc")
    && any(gs, g => (g.target.secret as String) == "fleet-automation-ssh-key")
    && !any(gs, g => (g.target.secret as String) == "approval-submission-mac-key")
    && string_contains(s: mtcollins1_boot_wif_principal_set(), pattern: "/workloadIdentityPools/github-mtcollins1-boot/*")
    && !string_contains(s: mtcollins1_boot_wif_principal_set(), pattern: "/workloadIdentityPools/github-actions/")
}

// THE HOLDER KIND IS A DECLARED SUM (review 70459), rendered and decoded in one place. Each kind round-
// trips; a string no kind rendered is refused rather than guessed; and a host-reset holder is named as
// one -- the defect the review found was a two-valued check naming it a boot run.
fn round_trips(o: UnitHoldOwner, label: String) -> Bool {
  match decode_unit_hold_owner(owner: unit_hold_owner_ref(o: o)) {
    UnitHoldOwnerDecoded { owner: d } => unit_hold_owner_label(o: d) == label
    UnitHoldOwnerUnrecognized { raw: _ } => false
  }
}

test fn every_holder_kind_round_trips_and_a_foreign_owner_is_refused() -> Bool {
  round_trips(o: OperatorMaintenance { reason: "reseating DIMMs" as NonEmptyStr }, label: "operator maintenance: reseating DIMMs")
    && round_trips(o: BootRun { run_id: "41" as NonEmptyStr, process: holder_process, pid_namespace: "pid:[4026531836]" as NonEmptyStr }, label: "the mtcollins1 boot run 41 (process 3975 on boot 73c8153e-0e0e-4480-a36c-bc7560c50e8b)")
    && round_trips(o: HostResetReturn { attempt: "srv1-mtcollins1" as NonEmptyStr }, label: "host reset-return attempt srv1-mtcollins1")
    && round_trips(o: KvmObserverProbe { run_id: "36800000000" as NonEmptyStr, process: holder_process, pid_namespace: "pid:[4026531836]" as NonEmptyStr }, label: "the mtcollins1 KVM observer probe run 36800000000 (process 3975 on boot 73c8153e-0e0e-4480-a36c-bc7560c50e8b)")
    && match decode_unit_hold_owner(owner: "someone-else:x" as DurableHoldOwnerRef) {
      UnitHoldOwnerUnrecognized { raw: _ } => true
      UnitHoldOwnerDecoded { owner: _ } => false
    }
    && match decode_unit_hold_owner(owner: "host-reset-return:" as DurableHoldOwnerRef) {
      UnitHoldOwnerUnrecognized { raw: _ } => true
      UnitHoldOwnerDecoded { owner: _ } => false
    }
}

// ── The KVM probe's always() release: only this run's own hold, at the generation it observed ─────
// Supplied observations into the PURE decision fold (the live release plan is minted only from a live
// read of the slot, so a supplied observation can never free a real hold).
fn probe_owner(run_id: NonEmptyStr) -> DurableHoldOwnerRef {
  unit_hold_owner_ref(o: KvmObserverProbe { run_id: run_id, process: holder_process, pid_namespace: "pid:[4026531836]" as NonEmptyStr })
}

test fn the_release_targets_only_this_runs_probe_hold_at_its_observed_generation() -> Bool {
  match probe_hold_release_decision(observed: HoldSlotHeld { generation: first_generation(), owner: probe_owner(run_id: "36800000000") }, run_id: "36800000000") {
    ProbeHoldReleaseAt { owner: o, generation: g } => (o as String) == (probe_owner(run_id: "36800000000") as String) && g == first_generation()
    _ => false
  }
}

// THE FOREIGN-HOLDER REDS: another probe run, a boot, host reset-return, the operator, or an owner this
// module never wrote -- each is a no-op naming the holder, never a release.
fn foreign(observed_owner: DurableHoldOwnerRef, pattern: String) -> Bool {
  match probe_hold_release_decision(observed: HoldSlotHeld { generation: first_generation(), owner: observed_owner }, run_id: "36800000000") {
    ProbeHoldForeignNoop { holder: h } => string_contains(s: h, pattern: pattern)
    _ => false
  }
}

test fn a_foreign_holder_is_never_released() -> Bool {
  foreign(observed_owner: probe_owner(run_id: "36800000001"), pattern: "36800000001")
    && foreign(observed_owner: boot_run_owner(run_id: "36800000000", process: holder_process, pid_namespace: "pid:[4026531836]"), pattern: "boot run 36800000000")
    && foreign(observed_owner: host_reset_owner(attempt: "srv1-mtcollins1"), pattern: "reset-return")
    && foreign(observed_owner: operator_maintenance_owner(reason: "reseating DIMMs"), pattern: "reseating DIMMs")
    && foreign(observed_owner: "someone-else:36800000000" as DurableHoldOwnerRef, pattern: "someone-else")
}

// A FREE OR UNREADABLE SLOT IS A REPORTED NO-OP.
test fn a_free_or_unreadable_slot_is_not_released() -> Bool {
  (match probe_hold_release_decision(observed: HoldSlotAbsent, run_id: "36800000000") { ProbeHoldFreeNoop => true  _ => false })
    && (match probe_hold_release_decision(observed: HoldSlotFree { generation: first_generation(), released_by: "x" as DurableHoldReleaseRef }, run_id: "36800000000") { ProbeHoldFreeNoop => true  _ => false })
    && (match probe_hold_release_decision(observed: HoldSlotUndecodable { generation: first_generation(), detail: "garbage" }, run_id: "36800000000") { ProbeHoldUnobservable { cause: c } => string_contains(s: c, pattern: "garbage")  _ => false })
}

// THE STALE-GENERATION REDS: the slot moved between the observation and the release -- assessed against
// another generation, or lost at the commit -- and is left alone as stale; a slot re-taken by another
// owner meanwhile is not ours; only a committed release at the observed generation is Released.
test fn a_stale_generation_is_left_alone() -> Bool {
  (match probe_hold_release_refused(refusal: HoldReleaseAgainstAnotherGeneration { acquired: first_generation(), observed: first_generation() }) { ProbeHoldStale { detail: _ } => true  _ => false })
    && (match probe_hold_release_committed(outcome: FileHoldReleaseLost { slot_key: mtcollins1_unit_hold_key }) { ProbeHoldStale { detail: _ } => true  _ => false })
    && (match probe_hold_release_refused(refusal: HoldReleaseHeldByAnotherOwner { generation: first_generation(), holder: boot_run_owner(run_id: "41", process: holder_process, pid_namespace: "pid:[4026531836]") }) { ProbeHoldNotOurs { holder: h } => string_contains(s: h, pattern: "mtcollins1-boot:41")  _ => false })
    && (match probe_hold_release_refused(refusal: HoldReleaseAlreadyFree { generation: first_generation(), released_by: "x" as DurableHoldReleaseRef }) { ProbeHoldAlreadyFree => true  _ => false })
    && (match probe_hold_release_committed(outcome: FileHoldReleased { slot_key: mtcollins1_unit_hold_key, generation: first_generation() }) { ProbeHoldReleased => true  _ => false })
}

// ── A DEAD PROBE HOLDER IS RECOVERABLE (side-chat blocker 4b) ────────────────────────────────────────
// The probe owner names its holding process -- boot id, pid, start time and the pid namespace it was
// read in -- and decodes back to it, so the recovery route OBSERVES that process, exactly as for a boot
// run; the std recovery fold then frees a hold whose holder is observed dead
// (test.claim.durable_exclusive_hold_witness_test). A probe owner written WITHOUT a process (this
// PR's earlier spelling) is not guessed into one: it is unobservable, and its hold is refused rather
// than broken.
test fn a_probe_holder_is_observed_by_its_process_and_a_processless_one_is_not() -> Bool {
  let rendered = probe_owner(run_id: "36800000000") as String
  rendered == "mtcollins1-kvm-observer:36800000000@boot=73c8153e-0e0e-4480-a36c-bc7560c50e8b,pid=3975,start=81234,pidns=pid:[4026531836]"
    && (match holder_liveness_route(holder: rendered as DurableHoldOwnerRef) {
      HolderObserveProcess { process: p, pid_namespace: n } => p.pid == 3975 && (p.start_time as String) == "81234" && (n as String) == "pid:[4026531836]"
      _ => false
    })
    && (match holder_liveness_route(holder: "mtcollins1-kvm-observer:36800000000" as DurableHoldOwnerRef) {
      HolderNotObservable { cause: _ } => true
      _ => false
    })
    && (match holder_liveness_route(holder: operator_maintenance_owner(reason: "reseating DIMMs")) {
      HolderNotObservable { cause: c } => string_contains(s: c as String, pattern: "only the operator")
      _ => false
    })
}
