  mtcollins1_console_milestones, UefiConsolePromptObserved, DramFirmwareBannerObserved, GrubBannerObserved, EfiStubLineObserved, KernelBannerObserved,
}
import gunbc.machine_intake_host_capture_envelope { HostCaptureLiveStream, host_capture_lines }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

