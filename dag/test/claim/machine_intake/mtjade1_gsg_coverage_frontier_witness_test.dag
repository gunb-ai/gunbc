module test.claim.mtjade1_gsg_coverage_frontier_witness

import std.types { Bool, String, all, any, list_length }
import std.decl_ref { decl_ref }
import std.dissolution { DissolutionFired, DissolutionPending, DissolutionUnbound, dissolution_status }
import std.roster_frontier { DeclSubject, PathSubject, frontier_rows_well_formed, frontier_subject_eq }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import gunbc.machine_intake_mtjade1_gsg_coverage_frontier {
  mtjade1_gsg_coverage_frontier_rows,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE ROSTER IS READ BY A FOLD, WHICH IS THE WHOLE POINT OF MOVING IT OUT OF PROSE. Each conjunct
// has an authorable RED that a comment could not have: a malformed row fails the first, a row
// whose subject is not one of the GSG chassis declarations fails the second, and a row whose
// dissolution is bound forward to a symbol this closure cannot name fails the third — which is
// the fabricated-citation class std.dissolution warns about by name.
test fn w_mtjade1_gsg_frontier_rows_are_well_formed_and_unbound() -> Bool {
  frontier_rows_well_formed(rows: mtjade1_gsg_coverage_frontier_rows)
    && list_length(mtjade1_gsg_coverage_frontier_rows) == 9
    && all(
      mtjade1_gsg_coverage_frontier_rows,
      row => match row.subject {
        DeclSubject { ref: r } =>
          (r.module_path as String) == "extdeps.ampere.mt_jade_getting_started_guide.chassis"
        PathSubject { path: _ } => false
      },
    )
    && all(
      mtjade1_gsg_coverage_frontier_rows,
      row => match dissolution_status(condition: row.dissolution, present_decls: []) {
        DissolutionUnbound => true
        DissolutionPending => false
        DissolutionFired => false
      },
    )
}

// THE ROW THAT MOST NEEDS TO BE MACHINE-READABLE, asserted by identity rather than by prose: the
// GSG minimum family may not be consumed before a wet probe binds an observed family, because
// bmc_first_contact_standing carries no function from a document to an installed family.
test fn w_minimum_bmc_firmware_family_is_on_the_frontier() -> Bool {
  any(
    mtjade1_gsg_coverage_frontier_rows,
    row => frontier_subject_eq(
      a: row.subject,
      b: DeclSubject {
        ref: decl_ref(
          module_path: "extdeps.ampere.mt_jade_getting_started_guide.chassis",
          decl_name: "mt_jade_gsg_minimum_bmc_firmware_family",
        ),
      },
    ),
  )
    && any(
      mtjade1_gsg_coverage_frontier_rows,
      row => frontier_subject_eq(
        a: row.subject,
        b: DeclSubject {
          ref: decl_ref(
            module_path: "extdeps.ampere.mt_jade_getting_started_guide.chassis",
            decl_name: "mt_jade_gsg_without_1p_bmc_image_fan_duty",
          ),
        },
      ),
    )
}
