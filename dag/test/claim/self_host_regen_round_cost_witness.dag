module test.claim.self_host_regen_round_cost_witness

import std.types { Bool, String, List, NonEmptyStr }
import std.measure { CpuClock, WallClock, Nanosecond, nanosecond, nanosecond_count }
import std.observation { Measured, MeasuredValue, MeasuredUnavailable }
import gunbc.regen_round_cost {
  RegenRoundCostReceipt, TraceMark, regen_round_mark, regen_round_cpu_unreadable_cause,
  RegenRoundPhase, Emit, SeedBuild, BaseMirrorBootstrap, RegenRoundPhaseAttribution, Attributed,
  Unattributed, RoundOneMirrorAuthority, FromBaseMirror, SeedBuiltFromHead,
  regen_round_phase_of_label, regen_round_phase_tag, regen_round_phase_label, regen_round_phases,
  regen_round_total, regen_round_mark_line, regen_round_cost_render
}

// WHAT THIS WITNESS COVERS: the fold from a drained trace ledger to the receipt lines the host
// prints -- attribution of a label to a phase, the two totals, and the rendered text -- held
// against fixture rows so the format authority is exercised without a seed build, an emit or a
// host. WHAT IT DOES NOT COVER: that the seed stamps the labels this module names at the phase
// boundaries it claims. That half executes only in a real `claim_executor --regen-round-cost`
// run, whose receipt is the evidence; a mark the seed stamps under a label this module does not
// know renders as `unattributed`, so the disagreement is visible in the receipt rather than
// silent.

fn ms(count: Int) -> Nanosecond {
  nanosecond(count: count * 1000000)
}

fn a_mark(label: String, wall_ms: Int, cpu_ms: Int) -> TraceMark {
  regen_round_mark(label: label, wall: ms(count: wall_ms), cpu: MeasuredValue { value: ms(count: cpu_ms) })
}

fn a_cpu_unreadable_mark(label: String, wall_ms: Int) -> TraceMark {
  regen_round_mark(label: label, wall: ms(count: wall_ms), cpu: MeasuredUnavailable { cause: regen_round_cpu_unreadable_cause })
}

fn measured_ms_is(d: Measured<Nanosecond>, expected_ms: Int) -> Bool {
  match d {
    MeasuredValue { value: v } => nanosecond_count(n: v) == expected_ms * 1000000
    MeasuredUnavailable { cause: c } => false
  }
}

fn a_receipt(marks: List<TraceMark>) -> RegenRoundCostReceipt {
  RegenRoundCostReceipt {
    producer: "claim_executor --regen-round-cost",
    host: "srv1",
    tree: "2a11b317d2caf3c37d1d38a4421e8e0c06188925",
    tree_dirty: false,
    seed_build_compiled_crates: 0,
    rebuild_compiled_crates: 2,
    rustfmt_spawns: 7,
    marks: marks,
    changed_paths: ["v1_rt.rs", "v1_compiler_runtime_rust.rs"],
    convergence_stage_receipt_ids: ["stage-1", "stage-2"],
    installed_mirrors: ["v1_rt.rs"],
    host_shell_modules: [],
    rebuild_packages: ["v1-stage0-runtime", "v1-compiler"],
    executable_digest: "exedigest",
    second_generation_candidate_digest: "gen2digest",
    base_mirror_authority: SeedBuiltFromHead
  }
}

// THE SAME RECEIPT ON A HEAL ROUND: round 1 compiled the base mirror, so the receipt NAMES THE
// BASE COMMIT (never the ref -- a ref is a moving name and a receipt records a past round).
fn a_bootstrapped_receipt(marks: List<TraceMark>) -> RegenRoundCostReceipt {
  let a = a_receipt(marks: marks)
  RegenRoundCostReceipt {
    producer: a.producer,
    host: a.host,
    tree: a.tree,
    tree_dirty: a.tree_dirty,
    seed_build_compiled_crates: a.seed_build_compiled_crates,
    rebuild_compiled_crates: a.rebuild_compiled_crates,
    rustfmt_spawns: a.rustfmt_spawns,
    marks: a.marks,
    changed_paths: a.changed_paths,
    convergence_stage_receipt_ids: a.convergence_stage_receipt_ids,
    installed_mirrors: a.installed_mirrors,
    host_shell_modules: a.host_shell_modules,
    rebuild_packages: a.rebuild_packages,
    executable_digest: a.executable_digest,
    second_generation_candidate_digest: a.second_generation_candidate_digest,
    // The counts are this witness's own inputs; the claim is that the renderer NAMES the source they
    // describe. `crate_paths` is the whole-crate population base 2a11b317 actually commits under
    // `src/v1/stage0` — the authority's real grain, not a top-level slice.
    base_mirror_authority: FromBaseMirror { commit: "2a11b317d2caf3c37d1d38a4421e8e0c06188925", crate_paths: 252, head_added_paths_kept: 2 }
  }
}

fn attributed_to(attribution: RegenRoundPhaseAttribution, phase: RegenRoundPhase) -> Bool {
  match attribution {
    Attributed { phase: p } => regen_round_phase_tag(phase: p) == regen_round_phase_tag(phase: phase)
    Unattributed => false
  }
}

fn is_unattributed(attribution: RegenRoundPhaseAttribution) -> Bool {
  match attribution {
    Attributed { phase: p } => false
    Unattributed => true
  }
}

// POSITIVE CONTROL: the compile.dag mark that carries the emit lands on the Emit phase.
test fn a_compile_emit_label_attributes_to_the_emit_phase() -> Bool {
  attributed_to(attribution: regen_round_phase_of_label(label: "compile.emit"), phase: Emit)
}

// EVERY PHASE ROUND-TRIPS THROUGH ITS OWN LABEL. A phase whose label attributes to a different
// phase, or to nothing, would price one phase's time under another's name.
test fn a_every_phase_label_attributes_back_to_its_phase() -> Bool {
  fold(regen_round_phases(), init: true, f: fn(acc, phase) {
    acc && attributed_to(attribution: regen_round_phase_of_label(label: regen_round_phase_label(phase: phase)), phase: phase)
  })
}

// THE DISCRIMINATING RED for attribution: a sub-mark under the emit is NOT the emit. A prefix
// match would fold compile.emit.dag.collect into the Emit line and count its time twice.
test fn w_RED_an_emit_sub_mark_is_unattributed_not_folded_into_emit() -> Bool {
  is_unattributed(attribution: regen_round_phase_of_label(label: "compile.emit.dag.collect"))
}

test fn a_wall_total_is_the_sum_of_the_marks() -> Bool {
  measured_ms_is(
    d: regen_round_total(marks: [a_mark(label: "round.seed_build", wall_ms: 1500, cpu_ms: 9000), a_mark(label: "compile.emit", wall_ms: 300000, cpu_ms: 299000)], basis: WallClock),
    expected_ms: 301500
  )
}

// THE DISCRIMINATING RED for the CPU total: one unreadable row makes the total unreadable. A
// total that summed the readable rows would report a smaller CPU than the round spent.
test fn w_RED_one_unreadable_cpu_row_makes_the_cpu_total_unreadable() -> Bool {
  let total = regen_round_total(marks: [
    a_mark(label: "round.seed_build", wall_ms: 1500, cpu_ms: 9000),
    a_cpu_unreadable_mark(label: "compile.emit", wall_ms: 300000)
  ], basis: CpuClock)
  match total {
    MeasuredUnavailable { cause: c } => true
    MeasuredValue { value: v } => false
  }
}

test fn a_all_readable_cpu_rows_sum() -> Bool {
  measured_ms_is(d: regen_round_total(marks: [a_mark(label: "a", wall_ms: 1, cpu_ms: 2), a_mark(label: "b", wall_ms: 3, cpu_ms: 4)], basis: CpuClock), expected_ms: 6)
}

// The wall total of the same rows is readable even though the CPU total is not: the two
// clocks are two rows, and an unreadable CPU never poisons the wall.
test fn a_wall_total_survives_an_unreadable_cpu_row() -> Bool {
  measured_ms_is(
    d: regen_round_total(marks: [a_mark(label: "a", wall_ms: 1500, cpu_ms: 9000), a_cpu_unreadable_mark(label: "b", wall_ms: 300000)], basis: WallClock),
    expected_ms: 301500
  )
}

test fn a_mark_line_names_the_phase_and_both_clocks() -> Bool {
  regen_round_mark_line(mark: a_mark(label: "round.seed_build", wall_ms: 1500, cpu_ms: 9000))
    == "regen-round-cost: phase=seed_build wall_ms=1500 cpu_ms=9000"
}

test fn a_mark_line_for_an_unknown_label_says_unattributed_and_keeps_the_label() -> Bool {
  regen_round_mark_line(mark: a_mark(label: "compile.emit.dag.serialize", wall_ms: 7, cpu_ms: 7))
    == "regen-round-cost: unattributed label=compile.emit.dag.serialize wall_ms=7 cpu_ms=7"
}

// THE ROUND-1 BOOTSTRAP APPEARS IN THE RECEIPT, between the provenance header and the phase rows,
// and names the base COMMIT with its file count (DESIGN §5, RFM #14963; the sleek-owl-397
// caution: the receipt must name the base mirror by commit).
test fn a_bootstrapped_receipt_names_the_base_commit_after_the_header() -> Bool {
  let text = regen_round_cost_render(receipt: a_bootstrapped_receipt(marks: [
    a_mark(label: "round.base_mirror_bootstrap", wall_ms: 120, cpu_ms: 90),
    a_mark(label: "round.seed_build", wall_ms: 1500, cpu_ms: 9000)
  ]))
  text == concat(
    "regen-round-cost: producer=claim_executor --regen-round-cost host=srv1 tree=2a11b317d2caf3c37d1d38a4421e8e0c06188925 tree_dirty=false seed_build_compiled_crates=0 rebuild_compiled_crates=2 rustfmt_spawns=7\n",
    concat(
      "regen-round-cost: base_mirror_commit=2a11b317d2caf3c37d1d38a4421e8e0c06188925 crate=src/v1/stage0 crate_paths=252 head_added_paths_kept=2\n",
      concat(
        "regen-round-cost: phase=base_mirror_bootstrap wall_ms=120 cpu_ms=90\nregen-round-cost: phase=seed_build wall_ms=1500 cpu_ms=9000\n",
        concat(
          "regen-round-cost: total wall_ms=1620 cpu_ms=9090\nregen-round-cost: changed_paths=2 [v1_rt.rs, v1_compiler_runtime_rust.rs]\nregen-round-cost: convergence_stages=2 [stage-1, stage-2]\n",
          concat(
            "partition-rebuild: PartitionRebuildScopeDerived changed_mirrors=[v1_rt.rs] owning_packages=[v1-stage0-runtime] package_closure=[v1-stage0-runtime, v1-stage0-std-core, v1-stage0-std-surface, v1-stage0-extdeps-languages, v1-stage0-v1-artifact, v1-stage0-v1-infer, v1-stage0-emit-core, v1-compiler] executable_assembly=assembled package=v1-compiler bin=claim_executor\n",
            "regen-round-cost: execution-identity rebuild_packages=2 [v1-stage0-runtime, v1-compiler] executable_digest=exedigest second_generation_candidate=gen2digest\n"
          )
        )
      )
    )
  )
}

// POSITIVE CONTROL, THE OTHER DIRECTION: a round that was NOT asked to bootstrap from a base
// mirror renders NO base line -- byte-for-byte the receipt it rendered before this change. A heal
// fact can never be assumed into a non-heal receipt.
test fn a_non_bootstrapped_receipt_renders_no_base_mirror_line() -> Bool {
  let text = regen_round_cost_render(receipt: a_receipt(marks: [
    a_mark(label: "round.seed_build", wall_ms: 1500, cpu_ms: 9000)
  ]))
  !string_contains(s: text, pattern: "base_mirror_commit")
}

// THE BOOTSTRAP IS ITS OWN PRICED PHASE, so its time is never booked to the seed build it
// precedes -- the round's cost claim stays honest about where the base read went.
test fn the_base_mirror_bootstrap_phase_is_priced_as_itself() -> Bool {
  attributed_to(attribution: regen_round_phase_of_label(label: "round.base_mirror_bootstrap"), phase: BaseMirrorBootstrap)
    && regen_round_phase_label(phase: BaseMirrorBootstrap) == "round.base_mirror_bootstrap"
}

// THE RENDERED RECEIPT, BYTE FOR BYTE: provenance header, one line per mark in ledger order, the
// totals, and the changed set by identity.
test fn a_receipt_renders_provenance_marks_totals_and_changed_paths() -> Bool {
  let text = regen_round_cost_render(receipt: a_receipt(marks: [
    a_mark(label: "round.seed_build", wall_ms: 1500, cpu_ms: 9000),
    a_mark(label: "compile.emit", wall_ms: 300000, cpu_ms: 299000)
  ]))
  text == concat(
    "regen-round-cost: producer=claim_executor --regen-round-cost host=srv1 tree=2a11b317d2caf3c37d1d38a4421e8e0c06188925 tree_dirty=false seed_build_compiled_crates=0 rebuild_compiled_crates=2 rustfmt_spawns=7\n",
    concat(
      "regen-round-cost: phase=seed_build wall_ms=1500 cpu_ms=9000\nregen-round-cost: phase=compile.emit wall_ms=300000 cpu_ms=299000\n",
      concat(
        "regen-round-cost: total wall_ms=301500 cpu_ms=308000\nregen-round-cost: changed_paths=2 [v1_rt.rs, v1_compiler_runtime_rust.rs]\nregen-round-cost: convergence_stages=2 [stage-1, stage-2]\n",
        concat(
          "partition-rebuild: PartitionRebuildScopeDerived changed_mirrors=[v1_rt.rs] owning_packages=[v1-stage0-runtime] package_closure=[v1-stage0-runtime, v1-stage0-std-core, v1-stage0-std-surface, v1-stage0-extdeps-languages, v1-stage0-v1-artifact, v1-stage0-v1-infer, v1-stage0-emit-core, v1-compiler] executable_assembly=assembled package=v1-compiler bin=claim_executor\n",
          "regen-round-cost: execution-identity rebuild_packages=2 [v1-stage0-runtime, v1-compiler] executable_digest=exedigest second_generation_candidate=gen2digest\n"
        )
      )
    )
  )
}
