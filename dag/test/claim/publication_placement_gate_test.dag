module test.claim.publication_placement_gate

import std.types { Bool, List }
import std.process { ProcessExit, ExitSuccess, ExitFailure }
import std.effect_grant { Envelope }
import std.materialization_ladder { Frame, SharedStateFrame }
import std.measure { percent }
import extdeps.git {
  GitDiffStatusEntry, DiffCopiedStatus, DiffRenamedStatus,
}
import gunbc.publication_grant {
  PublicRootPublishBaseline, SubtreePublishGrant, PublicPublicationGrantRoster,
  public_root_publish_baseline, public_subtree_publish_grants,
  subtree_publish_world_grant,
}
import gunbc.ci_gate { PublicationPlacementGate }
import gunbc.commit_workflow {
  CommitSpecGate, GithubActionsCiJob,
  commit_gate_roster, commit_workflow_surface_eq, gate_eq,
}
import tools.publication_placement_gate {
  PublishGuardLocalOutcome, PublishGuardLocalAccepted, PublishGuardLocalRefused,
  PublishGuardLocalViolation, BaselinePlacementPolicyNotPinned,
  AddedPathSubtreeGrantAbsent, AddedPathPublishGrantRefused,
  SubtreePublishGrantRootRepeated, SubtreePublishGrantWidensAncestor,
  added_paths_from, publication_guard_local_check, publication_guard_process_exit,
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data publication_placement_acceptance_note: String = "Discriminating P-B subtree-grain probes over the real gate decision and boundary. The behavior-preservation control sends representative current post-cutover additions under dag, docs, and src through the three history-derived public subtree defaults and reaches ExitSuccess without a per-file row. A descendant under dag inherits Publish World. A path under a novel top-level root reaches located AddedPathSubtreeGrantAbsent and ExitFailure. A narrower nested default beats its broader ancestor and refuses only that nested path; a sibling remains admitted. A World descendant below that narrower ancestor reaches SubtreePublishGrantWidensAncestor even with no added path, pinning visibility-grants Rule 2 downward closure separately from lookup precedence. Advancing the cutover and repeating a subtree root remain distinct refusals. Copied and renamed destinations under a novel root RED through the same absence path. Every probe calls publication_guard_local_check, whose publication decision remains std.effect_grant.admit_effect(Publish, world_audience), then publication_guard_process_exit, the same boundary the live gate runs. Live git.Core.DiffNameStatus execution from the exact cutover to HEAD is enrolled separately as the Wet server-side floor runnable tools.floor_effect_gate_witness.publication_placement_gate_passes."

data synthetic_known_path: String = "dag/example/new_public_file.dag"
data synthetic_private_path: String = "dag/private/new_private_file.dag"
data synthetic_public_sibling_path: String = "dag/example/public_sibling.dag"
data synthetic_novel_path: String = "novel-root/new_public_file.dag"

fn exit_is_success(exit: ProcessExit) -> Bool {
  match exit {
    ExitSuccess => true
    ExitFailure { code: code, reason: reason } => false
  }
}

fn default_roster() -> PublicPublicationGrantRoster {
  PublicPublicationGrantRoster {
    baseline: public_root_publish_baseline,
    subtree_grants: public_subtree_publish_grants,
  }
}

fn private_subtree_grant(root: String) -> SubtreePublishGrant {
  SubtreePublishGrant {
    root: root,
    envelope: Envelope {
      frame: Frame { name: root, kind: SharedStateFrame },
      grants: [],
    },
  }
}

fn narrowed_roster() -> PublicPublicationGrantRoster {
  PublicPublicationGrantRoster {
    baseline: public_root_publish_baseline,
    subtree_grants: [
      subtree_publish_world_grant(root: "dag"),
      private_subtree_grant(root: "dag/private"),
    ],
  }
}

fn widening_roster() -> PublicPublicationGrantRoster {
  PublicPublicationGrantRoster {
    baseline: public_root_publish_baseline,
    subtree_grants: [
      subtree_publish_world_grant(root: "dag"),
      private_subtree_grant(root: "dag/private"),
      subtree_publish_world_grant(root: "dag/private/reopened"),
    ],
  }
}

fn repeated_root_roster() -> PublicPublicationGrantRoster {
  let marker = subtree_publish_world_grant(root: "dag")
  PublicPublicationGrantRoster {
    baseline: public_root_publish_baseline,
    subtree_grants: [marker, marker],
  }
}

fn advanced_cutover_roster() -> PublicPublicationGrantRoster {
  PublicPublicationGrantRoster {
    baseline: PublicRootPublishBaseline {
      root: public_root_publish_baseline.root,
      cutover: "synthetic-advanced-cutover",
      envelope: public_root_publish_baseline.envelope,
    },
    subtree_grants: [],
  }
}

test fn current_public_behavior_is_preserved_by_subtree_defaults() -> Bool {
  let paths = [
    "dag/extdeps/advertising/google_ads.dag",
    "docs/plans/roadmap-presentation-seam-design.md",
    "src/v2/workflow/ci_heal_revalidation_preflight_emit.dag",
  ]
  let outcome = publication_guard_local_check(
    roster: default_roster(),
    added_paths: paths,
    head: "synthetic-head",
  )
  match outcome {
    PublishGuardLocalAccepted { receipt: receipt } =>
      receipt.root == "."
        && receipt.subtree_grant_roots == ["dag", "docs", "src"]
        && receipt.added_paths == paths
        && exit_is_success(exit: publication_guard_process_exit(outcome: outcome))
    PublishGuardLocalRefused { receipt: receipt, violations: violations } => false
  }
}

test fn descendant_inherits_public_subtree_default() -> Bool {
  let outcome = publication_guard_local_check(
    roster: default_roster(),
    added_paths: [synthetic_known_path],
    head: "synthetic-head",
  )
  match outcome {
    PublishGuardLocalAccepted { receipt: receipt } =>
      receipt.added_paths == [synthetic_known_path]
        && exit_is_success(exit: publication_guard_process_exit(outcome: outcome))
    PublishGuardLocalRefused { receipt: receipt, violations: violations } => false
  }
}

test fn novel_root_without_default_reds_gate() -> Bool {
  let outcome = publication_guard_local_check(
    roster: default_roster(),
    added_paths: [synthetic_novel_path],
    head: "synthetic-head",
  )
  match outcome {
    PublishGuardLocalAccepted { receipt: receipt } => false
    PublishGuardLocalRefused { receipt: receipt, violations: violations } =>
      violations.count() == 1
        && match violations.first() {
          AddedPathSubtreeGrantAbsent { path: path, root: root, audience: audience } =>
            path == synthetic_novel_path && root == "."
          _ => false
        }
        && !exit_is_success(exit: publication_guard_process_exit(outcome: outcome))
  }
}

test fn nearest_ancestor_narrowing_wins_without_capturing_sibling() -> Bool {
  let outcome = publication_guard_local_check(
    roster: narrowed_roster(),
    added_paths: [synthetic_private_path, synthetic_public_sibling_path],
    head: "synthetic-head",
  )
  match outcome {
    PublishGuardLocalAccepted { receipt: receipt } => false
    PublishGuardLocalRefused { receipt: receipt, violations: violations } =>
      violations.count() == 1
        && match violations.first() {
          AddedPathPublishGrantRefused { path: path, root: root, verb: verb, target: target, frame: frame } =>
            path == synthetic_private_path && root == "." && frame.name == "dag/private"
          _ => false
        }
        && !exit_is_success(exit: publication_guard_process_exit(outcome: outcome))
  }
}

test fn descendant_cannot_widen_narrower_ancestor() -> Bool {
  let outcome = publication_guard_local_check(
    roster: widening_roster(),
    added_paths: [],
    head: "synthetic-head",
  )
  match outcome {
    PublishGuardLocalAccepted { receipt: receipt } => false
    PublishGuardLocalRefused { receipt: receipt, violations: violations } =>
      violations.count() == 1
        && match violations.first() {
          SubtreePublishGrantWidensAncestor { subtree_root: subtree_root, ancestor_root: ancestor_root, root: root } =>
            subtree_root == "dag/private/reopened"
              && ancestor_root == "dag/private"
              && root == "."
          _ => false
        }
        && !exit_is_success(exit: publication_guard_process_exit(outcome: outcome))
  }
}

test fn advanced_cutover_reds_gate() -> Bool {
  let outcome = publication_guard_local_check(
    roster: advanced_cutover_roster(),
    added_paths: [],
    head: "synthetic-head",
  )
  match outcome {
    PublishGuardLocalAccepted { receipt: receipt } => false
    PublishGuardLocalRefused { receipt: receipt, violations: violations } =>
      violations.count() == 1
        && match violations.first() {
          BaselinePlacementPolicyNotPinned { declared_root: declared_root, pinned_root: pinned_root, declared_cutover: declared_cutover, pinned_cutover: pinned_cutover } =>
            declared_root == "."
              && pinned_root == "."
              && declared_cutover == "synthetic-advanced-cutover"
              && pinned_cutover == "7ead65c60397231ac50b55898300f17191ad931f"
          _ => false
        }
        && !exit_is_success(exit: publication_guard_process_exit(outcome: outcome))
  }
}

test fn repeated_publication_subtree_root_reds_gate() -> Bool {
  let outcome = publication_guard_local_check(
    roster: repeated_root_roster(),
    added_paths: [],
    head: "synthetic-head",
  )
  match outcome {
    PublishGuardLocalAccepted { receipt: receipt } => false
    PublishGuardLocalRefused { receipt: receipt, violations: violations } =>
      violations.count() == 1
        && match violations.first() {
          SubtreePublishGrantRootRepeated { subtree_root: subtree_root, root: root } =>
            subtree_root == "dag" && root == "."
          _ => false
        }
        && !exit_is_success(exit: publication_guard_process_exit(outcome: outcome))
  }
}

test fn novel_renamed_destination_reds_gate() -> Bool {
  let renamed = GitDiffStatusEntry {
    status: DiffRenamedStatus { similarity: percent(100) },
    path: synthetic_novel_path,
    old_path: Present { value: "dag/example/old_public_file.dag" },
  }
  let outcome = publication_guard_local_check(
    roster: default_roster(),
    added_paths: added_paths_from(entries: [renamed]),
    head: "synthetic-head",
  )
  match outcome {
    PublishGuardLocalAccepted { receipt: receipt } => false
    PublishGuardLocalRefused { receipt: receipt, violations: violations } =>
      violations.count() == 1
        && match violations.first() {
          AddedPathSubtreeGrantAbsent { path: path, root: root, audience: audience } =>
            path == synthetic_novel_path && root == "."
          _ => false
        }
        && !exit_is_success(exit: publication_guard_process_exit(outcome: outcome))
  }
}

test fn novel_copied_destination_reds_gate() -> Bool {
  let copied = GitDiffStatusEntry {
    status: DiffCopiedStatus { similarity: percent(100) },
    path: synthetic_novel_path,
    old_path: Present { value: "dag/example/source_public_file.dag" },
  }
  let outcome = publication_guard_local_check(
    roster: default_roster(),
    added_paths: added_paths_from(entries: [copied]),
    head: "synthetic-head",
  )
  match outcome {
    PublishGuardLocalAccepted { receipt: receipt } => false
    PublishGuardLocalRefused { receipt: receipt, violations: violations } =>
      violations.count() == 1
        && match violations.first() {
          AddedPathSubtreeGrantAbsent { path: path, root: root, audience: audience } =>
            path == synthetic_novel_path && root == "."
          _ => false
        }
        && !exit_is_success(exit: publication_guard_process_exit(outcome: outcome))
  }
}

test fn publication_placement_gate_is_server_side_only() -> Bool {
  let rows = filter(commit_gate_roster, row => match row.check {
    CommitSpecGate { gate: gate } => gate_eq(a: gate, b: PublicationPlacementGate)
    _ => false
  })
  rows.count() == 1
    && rows.first().surfaces.count() == 1
    && commit_workflow_surface_eq(
      a: rows.first().surfaces.first(),
      b: GithubActionsCiJob,
    )
}
