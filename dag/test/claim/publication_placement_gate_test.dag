module test.claim.publication_placement_gate

import std.types { Bool, List }
import std.process { ProcessExit, ExitSuccess, ExitFailure }
import std.access { Permit, Deny }
import std.authorization_profile { EnumeratedAudience }
import std.measure { percent }
import extdeps.git {
  GitDiffStatusEntry, DiffCopiedStatus, DiffRenamedStatus,
}
import gunbc.publication_grant {
  PublicationAudienceGrant,
  PublicRootPublishBaseline, PublicFilePublishGrant, PublicPublicationGrantRoster,
  public_root_publish_baseline,
  public_file_publish_grant,
  public_publication_request, decide_publication_request,
}
import gunbc.ci_gate { PublicationPlacementGate }
import gunbc.commit_workflow {
  CommitSpecGate, GithubActionsCiJob,
  commit_gate_roster, commit_workflow_surface_eq, gate_eq,
}
import tools.publication_placement_gate {
  PublishGuardLocalOutcome, PublishGuardLocalAccepted, PublishGuardLocalRefused,
  PublishGuardLocalViolation, BaselinePlacementPolicyNotPinned,
  AddedPathPublishGrantAbsent,
  FilePublishGrantMarkerRepeated, FilePublishGrantMarkerRefused,
  added_paths_from, publication_guard_local_check, publication_guard_process_exit,
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data publication_placement_acceptance_note: String = "Behavior-preservation witnesses over the real Stage-0 gate after dissolving gunbc#7541's provisional effect-grant carrier. The same baseline, missing-marker, repeated-marker, refused-marker, added, copied, and renamed cases reach the same accepted/refused gate outcomes and ProcessExit boundary. The only publication allow/deny now flows PublicationAdmissionRequest -> std.access.AccessRequest -> public_publication_policy; an empty audience grant is the discriminating RED against the universal public audience."

data synthetic_added_path: String = "dag/example/new_public_file.dag"

fn exit_is_success(exit: ProcessExit) -> Bool {
  match exit {
    ExitSuccess => true
    ExitFailure { code: code, reason: reason } => false
  }
}

fn ungranted_roster() -> PublicPublicationGrantRoster {
  PublicPublicationGrantRoster {
    baseline: public_root_publish_baseline,
    file_grants: [],
  }
}

fn granted_roster() -> PublicPublicationGrantRoster {
  PublicPublicationGrantRoster {
    baseline: public_root_publish_baseline,
    file_grants: [public_file_publish_grant(path: synthetic_added_path)],
  }
}

fn repeated_marker_roster() -> PublicPublicationGrantRoster {
  let marker = public_file_publish_grant(path: synthetic_added_path)
  PublicPublicationGrantRoster {
    baseline: public_root_publish_baseline,
    file_grants: [marker, marker],
  }
}

fn refused_marker_roster() -> PublicPublicationGrantRoster {
  PublicPublicationGrantRoster {
    baseline: public_root_publish_baseline,
    file_grants: [PublicFilePublishGrant {
      path: synthetic_added_path,
      grant: PublicationAudienceGrant {
        resource: synthetic_added_path,
        root: ".",
        audience: EnumeratedAudience { members: empty_set() },
      },
    }],
  }
}

fn advanced_cutover_roster() -> PublicPublicationGrantRoster {
  PublicPublicationGrantRoster {
    baseline: PublicRootPublishBaseline {
      root: public_root_publish_baseline.root,
      cutover: "synthetic-advanced-cutover",
      grant: public_root_publish_baseline.grant,
    },
    file_grants: [],
  }
}

test fn added_ungranted_public_path_reds_gate() -> Bool {
  let outcome = publication_guard_local_check(
    roster: ungranted_roster(),
    added_paths: [synthetic_added_path],
    head: "synthetic-head",
  )
  match outcome {
    PublishGuardLocalAccepted { receipt: receipt } => false
    PublishGuardLocalRefused { receipt: receipt, violations: violations } =>
      violations.count() == 1
        && match violations.first() {
          AddedPathPublishGrantAbsent { path: path, root: root, audience: audience } =>
            path == synthetic_added_path && root == "."
          _ => false
        }
        && !exit_is_success(exit: publication_guard_process_exit(outcome: outcome))
  }
}

test fn advanced_cutover_reds_gate() -> Bool {
  let outcome = publication_guard_local_check(
    roster: advanced_cutover_roster(),
    added_paths: [],
    head: "synthetic-head",
  )
  match outcome {
    PublishGuardLocalAccepted { receipt: receipt } => false
    PublishGuardLocalRefused { receipt: receipt, violations: violations } =>
      violations.count() == 1
        && match violations.first() {
          BaselinePlacementPolicyNotPinned { declared_root: declared_root, pinned_root: pinned_root, declared_cutover: declared_cutover, pinned_cutover: pinned_cutover } =>
            declared_root == "."
              && pinned_root == "."
              && declared_cutover == "synthetic-advanced-cutover"
              && pinned_cutover == "7ead65c60397231ac50b55898300f17191ad931f"
          _ => false
        }
        && !exit_is_success(exit: publication_guard_process_exit(outcome: outcome))
  }
}

test fn added_granted_public_path_greens_gate() -> Bool {
  let outcome = publication_guard_local_check(
    roster: granted_roster(),
    added_paths: [synthetic_added_path],
    head: "synthetic-head",
  )
  match outcome {
    PublishGuardLocalAccepted { receipt: receipt } =>
      receipt.root == "."
        && receipt.file_marker_paths == [synthetic_added_path]
        && receipt.added_paths == [synthetic_added_path]
        && exit_is_success(exit: publication_guard_process_exit(outcome: outcome))
    PublishGuardLocalRefused { receipt: receipt, violations: violations } => false
  }
}

test fn ungranted_renamed_destination_reds_gate() -> Bool {
  let renamed = GitDiffStatusEntry {
    status: DiffRenamedStatus { similarity: percent(100) },
    path: synthetic_added_path,
    old_path: Present { value: "dag/example/old_public_file.dag" },
  }
  let outcome = publication_guard_local_check(
    roster: ungranted_roster(),
    added_paths: added_paths_from(entries: [renamed]),
    head: "synthetic-head",
  )
  match outcome {
    PublishGuardLocalAccepted { receipt: receipt } => false
    PublishGuardLocalRefused { receipt: receipt, violations: violations } =>
      violations.count() == 1
        && match violations.first() {
          AddedPathPublishGrantAbsent { path: path, root: root, audience: audience } =>
            path == synthetic_added_path && root == "."
          _ => false
        }
        && !exit_is_success(exit: publication_guard_process_exit(outcome: outcome))
  }
}

test fn ungranted_copied_destination_reds_gate() -> Bool {
  let copied = GitDiffStatusEntry {
    status: DiffCopiedStatus { similarity: percent(100) },
    path: synthetic_added_path,
    old_path: Present { value: "dag/example/source_public_file.dag" },
  }
  let outcome = publication_guard_local_check(
    roster: ungranted_roster(),
    added_paths: added_paths_from(entries: [copied]),
    head: "synthetic-head",
  )
  match outcome {
    PublishGuardLocalAccepted { receipt: receipt } => false
    PublishGuardLocalRefused { receipt: receipt, violations: violations } =>
      violations.count() == 1
        && match violations.first() {
          AddedPathPublishGrantAbsent { path: path, root: root, audience: audience } =>
            path == synthetic_added_path && root == "."
          _ => false
        }
        && !exit_is_success(exit: publication_guard_process_exit(outcome: outcome))
  }
}

test fn repeated_publication_marker_reds_gate() -> Bool {
  let outcome = publication_guard_local_check(
    roster: repeated_marker_roster(),
    added_paths: [],
    head: "synthetic-head",
  )
  match outcome {
    PublishGuardLocalAccepted { receipt: receipt } => false
    PublishGuardLocalRefused { receipt: receipt, violations: violations } =>
      violations.count() == 1
        && match violations.first() {
          FilePublishGrantMarkerRepeated { path: path, root: root } =>
            path == synthetic_added_path && root == "."
          _ => false
        }
        && !exit_is_success(exit: publication_guard_process_exit(outcome: outcome))
  }
}

test fn refused_publication_marker_reds_gate() -> Bool {
  let outcome = publication_guard_local_check(
    roster: refused_marker_roster(),
    added_paths: [],
    head: "synthetic-head",
  )
  match outcome {
    PublishGuardLocalAccepted { receipt: receipt } => false
    PublishGuardLocalRefused { receipt: receipt, violations: violations } =>
      violations.count() == 1
        && match violations.first() {
          FilePublishGrantMarkerRefused { path: path, root: root, refusal: refusal } =>
            path == synthetic_added_path
              && root == "."
              && refusal.location.profile == "PublicationAdmissionRequest"
          _ => false
        }
        && !exit_is_success(exit: publication_guard_process_exit(outcome: outcome))
        && match decide_publication_request(request: public_publication_request(
          resource: "dag/example/unrelated-public-file.dag",
          root: ".",
          grant: public_file_publish_grant(path: synthetic_added_path).grant,
        )) {
          Permit => false
          Deny { refusal: mismatch } =>
            mismatch.location.profile == "PublicationAdmissionRequest"
              && mismatch.location.object == "dag/example/unrelated-public-file.dag"
        }
        && match decide_publication_request(request: public_publication_request(
          resource: synthetic_added_path,
          root: "synthetic-other-public-root",
          grant: public_file_publish_grant(path: synthetic_added_path).grant,
        )) {
          Permit => false
          Deny { refusal: mismatch } =>
            mismatch.location.profile == "PublicationAdmissionRequest"
              && mismatch.location.subject == "synthetic-other-public-root"
        }
  }
}

test fn publication_placement_gate_is_server_side_only() -> Bool {
  let rows = filter(commit_gate_roster, row => match row.check {
    CommitSpecGate { gate: gate } => gate_eq(a: gate, b: PublicationPlacementGate)
    _ => false
  })
  rows.count() == 1
    && rows.first().surfaces.count() == 1
    && commit_workflow_surface_eq(
      a: rows.first().surfaces.first(),
      b: GithubActionsCiJob,
    )
}
