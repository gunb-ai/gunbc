module test.claim.cache_retention_axes_witness_test


data cache_retention_axes_note: String = "THE DISCRIMINATING CONTROLS for the retention axis split (operator ruling 2026-08-06). Every cell here is a PLANTED retention value, not a live corpus row, so a red is attributable to the algebra rather than to a catalog edit; the per-row dispositions are checked by each row consumer. Two cells prove the shape the old sum could not express AT ALL - scope release AND a capacity bound carried in one value - which is the whole reason the axis was split. One cell keeps the two negative states apart, because known-unbounded and not-established have different remedies and only the second is closed by a citation. One cell keeps refuse-new-store distinct from replacement, the distinction PR 2 rests on. The LRU and TTL halves are deliberately NOT tested here and the note below says why: both became unrepresentable rather than merely false, and an unrepresentable state has no value a predicate could be handed."

data lru_ttl_unrepresentability_note: String = "WHERE THE LRU AND TTL HALVES ARE ACTUALLY CLOSED, stated here because an earlier draft of this file got it wrong in a way worth recording. That draft carried two functions named lru_without_capacity and ttl_without_capacity whose bodies were BYTE-IDENTICAL - both just CapacityUnobserved - so the names claimed a property no value in the test carried, and neither test could have failed for the reason its name gave. The real closure is at two different layers and NEITHER is a predicate over a planted retention value. (1) LRU is unrepresentable as a capacity claim: at_capacity nests inside the CapacityBounded arm, so ReplaceExisting { strategy: LeastRecentlyUsed } cannot be stated beside CapacityUnobserved or CapacityUnbounded at all - a type-level property, which is exactly why no test here exercises it and why the old fused axis needed one. (2) TTL is not on this axis: TtlExpiry lives on KeyDerivationFacts invalidation_triggers, so a TTL fact cannot reach a capacity verdict by any path. What remains testable is the predicate below - that an unobserved capacity does not satisfy a bounded role - plus the per-row dispositions, which are checked by each row consumer rather than restated here."

fn capacity_not_established() -> std.cache_interface.ProviderRetention {
  std.cache_interface.ProviderRetention {
    release_policy: std.cache_interface.ReleasedNever,
    capacity: std.cache_interface.CapacityUnobserved
  }
}

fn scope_exit_byte_bounded_refuse_new() -> std.cache_interface.ProviderRetention {
  std.cache_interface.ProviderRetention {
    release_policy: std.cache_interface.ReleasedAtProviderScopeExit,
    capacity: std.cache_interface.CapacityBounded {
      limit: std.cache_interface.ByteCapacity { limit: std.cache_interface.ExactLimit { value: std.measure.byte_size(count: 268435456) } },
      at_capacity: std.cache_interface.RefuseNewStore
    }
  }
}

fn scope_exit_runtime_derived_replace_existing() -> std.cache_interface.ProviderRetention {
  std.cache_interface.ProviderRetention {
    release_policy: std.cache_interface.ReleasedAtProviderScopeExit,
    capacity: std.cache_interface.CapacityBounded {
      limit: std.cache_interface.EntryCountCapacity {
        limit: std.cache_interface.RuntimeDerivedLimit {
          authority: {
            module_path: "gunbc.host_budget_source",
            decl_name: "HostBudgetResolution",
            field: std.decl_ref.WholeDeclaration
          }
        }
      },
      at_capacity: std.cache_interface.ReplaceExisting { strategy: std.cache_interface.ProviderNativeReplacement }
    }
  }
}

test fn unobserved_capacity_never_satisfies_a_bounded_role() -> Bool {
  let r = capacity_not_established()
  !std.cache_interface.capacity_is_bounded(c: r.capacity) && !std.cache_interface.retention_growth_is_bounded(r: r)
}

data scope_release_bounds_growth_note: String = "Scope release bounds GROWTH because storage ends with the frame; it says nothing about the peak reached INSIDE that frame, which is why the 2026-07-10 20GiB incident happened under a live scope. retention_growth_is_bounded is the growth predicate, deliberately not a peak-memory guarantee, and a role that needs a peak bound asks the capacity axis."

test fn scope_release_and_a_byte_ceiling_are_one_value() -> Bool {
  let r = scope_exit_byte_bounded_refuse_new()
  std.cache_interface.capacity_is_bounded(c: r.capacity) && std.cache_interface.retention_growth_is_bounded(r: r)
}

test fn scope_release_and_a_runtime_derived_ceiling_are_one_value() -> Bool {
  let r = scope_exit_runtime_derived_replace_existing()
  std.cache_interface.capacity_is_bounded(c: r.capacity) && std.cache_interface.retention_growth_is_bounded(r: r)
}

test fn refuse_new_store_is_distinct_from_replacement() -> Bool {
  let refusing = scope_exit_byte_bounded_refuse_new()
  let replacing = scope_exit_runtime_derived_replace_existing()
  let a = match refusing.capacity {
    std.cache_interface.CapacityUnbounded => false
    std.cache_interface.CapacityUnobserved => false
    std.cache_interface.CapacityBounded { limit: _, at_capacity: d } => match d {
      std.cache_interface.RefuseNewStore => true
      std.cache_interface.ReplaceExisting { strategy: _ } => false
      std.cache_interface.AtCapacityUnobserved => false
    }
  }
  let b = match replacing.capacity {
    std.cache_interface.CapacityUnbounded => false
    std.cache_interface.CapacityUnobserved => false
    std.cache_interface.CapacityBounded { limit: _, at_capacity: d } => match d {
      std.cache_interface.RefuseNewStore => false
      std.cache_interface.ReplaceExisting { strategy: _ } => true
      std.cache_interface.AtCapacityUnobserved => false
    }
  }
  a && b
}

test fn unbounded_and_unobserved_capacity_are_different_states() -> Bool {
  let known_unbounded = std.cache_interface.ProviderRetention {
    release_policy: std.cache_interface.ReleasedNever,
    capacity: std.cache_interface.CapacityUnbounded
  }
  let not_established = std.cache_interface.ProviderRetention {
    release_policy: std.cache_interface.ReleasedNever,
    capacity: std.cache_interface.CapacityUnobserved
  }
  let neither_is_bounded =
    !std.cache_interface.retention_growth_is_bounded(r: known_unbounded) && !std.cache_interface.retention_growth_is_bounded(r: not_established)
  let they_are_distinguishable = match known_unbounded.capacity {
    std.cache_interface.CapacityUnbounded => true
    std.cache_interface.CapacityUnobserved => false
    std.cache_interface.CapacityBounded { limit: _, at_capacity: _ } => false
  }
  neither_is_bounded && they_are_distinguishable
}

data scope_exit_role_discrimination_note: String = "THE CONTROL THE FIRST CUT LACKED (operator ruling 2026-08-06). Its only negative cell used ReleasedNever, so it never exercised the case that actually matters: a scope-released provider whose capacity is unbounded or unobserved. That value satisfies GROWTH boundedness - the frame ends, so storage ends - and satisfies CAPACITY boundedness not at all. One overloaded predicate would have admitted it to a byte-budget role, which is exactly the promoted-eval-memo obligation PR 2 owes. These two cells hold the predicates apart at the one point they disagree."

test fn scope_release_with_unbounded_capacity_bounds_growth_but_not_capacity() -> Bool {
  let r = std.cache_interface.ProviderRetention {
    release_policy: std.cache_interface.ReleasedAtProviderScopeExit,
    capacity: std.cache_interface.CapacityUnbounded
  }
  std.cache_interface.retention_growth_is_bounded(r: r)
    && !std.cache_interface.retention_has_capacity_bound(r: r)
    && !std.cache_interface.retention_has_exact_byte_bound(r: r)
}

test fn scope_release_with_unobserved_capacity_bounds_growth_but_not_capacity() -> Bool {
  let r = std.cache_interface.ProviderRetention {
    release_policy: std.cache_interface.ReleasedAtProviderScopeExit,
    capacity: std.cache_interface.CapacityUnobserved
  }
  std.cache_interface.retention_growth_is_bounded(r: r)
    && !std.cache_interface.retention_has_capacity_bound(r: r)
    && !std.cache_interface.retention_has_exact_byte_bound(r: r)
}

test fn an_entry_count_ceiling_is_not_a_byte_budget() -> Bool {
  let r = std.cache_interface.ProviderRetention {
    release_policy: std.cache_interface.ReleasedAtProviderScopeExit,
    capacity: std.cache_interface.CapacityBounded {
      limit: std.cache_interface.EntryCountCapacity { limit: std.cache_interface.ExactLimit { value: 1000000 } },
      at_capacity: std.cache_interface.RefuseNewStore
    }
  }
  std.cache_interface.retention_has_capacity_bound(r: r) && !std.cache_interface.retention_has_exact_byte_bound(r: r)
}

test fn an_unobserved_byte_ceiling_is_not_a_byte_budget() -> Bool {
  let r = std.cache_interface.ProviderRetention {
    release_policy: std.cache_interface.ReleasedNever,
    capacity: std.cache_interface.CapacityBounded {
      limit: std.cache_interface.ByteCapacity { limit: std.cache_interface.EffectiveLimitUnobserved },
      at_capacity: std.cache_interface.ReplaceExisting { strategy: std.cache_interface.LeastRecentlyUsed }
    }
  }
  std.cache_interface.retention_has_capacity_bound(r: r) && !std.cache_interface.retention_has_exact_byte_bound(r: r)
}
