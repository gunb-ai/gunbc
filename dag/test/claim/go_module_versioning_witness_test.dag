module test.claim.go_module_versioning_witness

import v2.std.live_tree { LiveTreeDisposition }
import extdeps.languages.go.emit { go_manifest_file }
import extdeps.languages.go.module {
  GoMvsProperty,
  GoSemVer,
  MajorV0OrV1,
  MajorV2Plus,
  emit_host_bootstrap_toolchain,
  emit_host_min_go_language_version,
  go_major_suffix_str,
  go_module_version_scheme,
  go_mvs_properties,
  go_semver_label,
  go_semver_to_version_identity,
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn w_go_manifest_file() -> Bool {
  go_manifest_file == "go.mod"
}

test fn w_major_v0_or_v1_suffix_is_empty() -> Bool {
  go_major_suffix_str(suffix: MajorV0OrV1) == ""
}

test fn w_major_v2_suffix() -> Bool {
  go_major_suffix_str(suffix: MajorV2Plus { major: 2 }) == "/v2"
}

test fn w_major_v3_suffix() -> Bool {
  go_major_suffix_str(suffix: MajorV2Plus { major: 3 }) == "/v3"
}

test fn w_suffixes_are_distinct() -> Bool {
  go_major_suffix_str(suffix: MajorV2Plus { major: 2 }) != go_major_suffix_str(suffix: MajorV0OrV1)
}

test fn w_semver_release_label() -> Bool {
  go_semver_label(v: GoSemVer {
    major: 1, minor: 2, patch: 3,
    prerelease: none, build: none
  }) == "v1.2.3"
}

test fn w_semver_v0_label() -> Bool {
  go_semver_label(v: GoSemVer {
    major: 0, minor: 1, patch: 0,
    prerelease: none, build: none
  }) == "v0.1.0"
}

test fn w_semver_prerelease_label() -> Bool {
  go_semver_label(v: GoSemVer {
    major: 1, minor: 0, patch: 0,
    prerelease: Present { value: "alpha.1" }, build: none
  }) == "v1.0.0-alpha.1"
}

test fn w_semver_build_label() -> Bool {
  go_semver_label(v: GoSemVer {
    major: 1, minor: 0, patch: 0,
    prerelease: none, build: Present { value: "build.42" }
  }) == "v1.0.0+build.42"
}

test fn w_semver_prerelease_and_build_label() -> Bool {
  go_semver_label(v: GoSemVer {
    major: 2, minor: 0, patch: 0,
    prerelease: Present { value: "rc.1" }, build: Present { value: "exp" }
  }) == "v2.0.0-rc.1+exp"
}

test fn w_semver_labels_distinct() -> Bool {
  go_semver_label(v: GoSemVer {
    major: 1, minor: 2, patch: 3,
    prerelease: none, build: none
  }) != go_semver_label(v: GoSemVer {
    major: 1, minor: 2, patch: 4,
    prerelease: none, build: none
  })
}

fn mvs_property_count(ps: List<GoMvsProperty>) -> Int {
  fold(ps, init: 0, f: (acc, _p) => acc + 1)
}

test fn w_go_mvs_has_three_properties() -> Bool {
  mvs_property_count(ps: go_mvs_properties) == 3
}

test fn w_go_semver_to_version_identity() -> Bool {
  go_semver_to_version_identity(v: GoSemVer {
    major: 1, minor: 2, patch: 3, prerelease: none, build: none
  }) == "v1.2.3"
}

test fn w_go_module_version_scheme_major_less() -> Bool {
  match go_module_version_scheme.compare(a: "v1.0.0", b: "v2.0.0") {
    VersionCompared { ordering: o } => o == std.algebra.Less
    VersionComparisonRefused { side: _, identity: _, cause: _ } => false
  }
}

test fn w_go_module_version_scheme_patch_greater() -> Bool {
  match go_module_version_scheme.compare(a: "v1.0.5", b: "v1.0.2") {
    VersionCompared { ordering: o } => o == std.algebra.Greater
    VersionComparisonRefused { side: _, identity: _, cause: _ } => false
  }
}

test fn w_go_module_version_scheme_equal() -> Bool {
  match go_module_version_scheme.compare(a: "v1.2.3", b: "v1.2.3") {
    VersionCompared { ordering: o } => o == std.algebra.Equal
    VersionComparisonRefused { side: _, identity: _, cause: _ } => false
  }
}

test fn w_go_module_version_scheme_no_pre_beats_pre() -> Bool {
  match go_module_version_scheme.compare(a: "v1.0.0", b: "v1.0.0-rc.1") {
    VersionCompared { ordering: o } => o == std.algebra.Greater
    VersionComparisonRefused { side: _, identity: _, cause: _ } => false
  }
}

// §11: pre-release identifiers with the same leading fields rank by their identifier sets —
// alpha ranks BELOW beta. The deleted go-local comparator ranked ANY two pre-release versions
// Equal; this witness failed for that documented reason before the rework.
test fn w_go_module_version_scheme_orders_pre_release_identifiers() -> Bool {
  match go_module_version_scheme.compare(a: "v1.0.0-alpha", b: "v1.0.0-beta") {
    VersionCompared { ordering: o } => o == std.algebra.Less
    VersionComparisonRefused { side: _, identity: _, cause: _ } => false
  }
}

test fn w_emit_host_min_go_language_version() -> Bool {
  emit_host_min_go_language_version == "1.22"
}

test fn w_emit_host_bootstrap_toolchain() -> Bool {
  emit_host_bootstrap_toolchain == "go1.22.5"
}


// The scheme strips the go "v" prefix and routes through the SemVer grammar and semver_compare —
// the ONE implementation of the cited rule — so unequal labels get the real numeric order.
test fn w_go_module_version_scheme_orders_patch_numerically() -> Bool {
  match go_module_version_scheme.compare(a: "v1.2.4", b: "v1.2.3") {
    VersionCompared { ordering: o } => o == std.algebra.Greater
    VersionComparisonRefused { side: _, identity: _, cause: _ } => false
  }
}

// A label outside the go module grammar (no "v" prefix, or a non-SemVer remainder) is a located
// refusal: the carrier names the failing side, the label, and the cause — never a fabricated
// order.
test fn w_go_module_version_scheme_refuses_unparsable_label() -> Bool {
  match go_module_version_scheme.compare(a: "not-a-go-version", b: "v1.2.3") {
    VersionComparisonRefused { side: side, identity: i, cause: _ } => side == LeftOperand && i == "not-a-go-version"
    VersionCompared { ordering: _ } => false
  }
}

// The go prefix rule is the scheme's own acceptance rule: a label WITHOUT the leading "v" is
// outside the grammar even when the remainder is a valid SemVer version.
test fn w_go_module_version_scheme_refuses_label_without_v_prefix() -> Bool {
  match go_module_version_scheme.compare(a: "1.0.0", b: "v1.0.0") {
    VersionComparisonRefused { side: side, identity: i, cause: _ } => side == LeftOperand && i == "1.0.0"
    VersionCompared { ordering: _ } => false
  }
}

// The go grammar is "v" + SemVer 2.0.0, so SemVer's §9 refusal carries over: a leading-zero
// all-digit pre-release identifier refuses instead of ranking.
test fn w_go_module_version_scheme_refuses_leading_zero_pre_release() -> Bool {
  match go_module_version_scheme.compare(a: "v1.0.0-01", b: "v1.0.0-1") {
    VersionComparisonRefused { side: side, identity: i, cause: _ } => side == LeftOperand && i == "v1.0.0-01"
    VersionCompared { ordering: _ } => false
  }
}
