module test.claim.ci_deploy_witness

import gunbc.ci_spec {
  gunbc_ci_spec,
  gunbc_ci_deploy_stages,
  gunbc_ci_deploy_srv1_stage,
  live_deploy_apply_entry,
  live_deploy_apply_srv1_wet_function,
  gunbc_ci_deploy_run_script,
}
import gunbc.ci_deploy_access {
  ci_deploy_srv1_access,
  deploy_access_is_local_apply,
  deploy_access_refusal_prefix,
  deploy_access_check_observed,
  deploy_access_check,
  deploy_access_preflight_pass_message,
  deploy_access_decision_reason,
  deploy_access_sudo_miss_reason,
  Permit,
  Deny,
  DeployAccessActor,
  gunbc_deploy_sudoers_dropin,
  deploy_access_sudoers_line,
  srv1_live_deploy_privileged_commands,
  grounded_posix_principal_name,
}
import gunbc.fleet_posix_accounts {
  FleetAccountCiRunner,
  fleet_posix_principal,
}
import gunbc.ci_workflow { ci_workflow }
import gunbc.ci_workflow_expressions { ci_deploy_push_to_main_if }
import gunbc.ci_yaml_emit { expected_ci_yml }
import gunbc.fleet_intent { srv1_host }
import gunbc.host_effect { LocalShell }

fn ci_deploy_runner_principal_name() -> String {
  grounded_posix_principal_name(p: ci_deploy_srv1_access.principal) as String
}

fn witness_deploy_stage_targets_live_deploy_wet() -> Bool {
  gunbc_ci_deploy_srv1_stage.entry == live_deploy_apply_entry
    && gunbc_ci_deploy_srv1_stage.function == live_deploy_apply_srv1_wet_function
    && gunbc_ci_deploy_srv1_stage.needs == ["ci"]
}

fn witness_deploy_access_uses_local_apply_on_srv1() -> Bool {
  let access = ci_deploy_srv1_access
  access.host == srv1_host
    && grounded_posix_principal_name(p: access.principal) == "ghrunner"
    && deploy_access_is_local_apply(access: access)
    && match access.transport {
      LocalShell => true
      _ => false
    }
}

fn witness_deploy_access_preflight_is_fail_closed() -> Bool {
  let d = deploy_access_check_observed(access: ci_deploy_srv1_access)
  match d {
    Permit =>
      string_contains(
        s: deploy_access_preflight_pass_message(access: ci_deploy_srv1_access),
        pattern: "deploy-access-preflight: PASS"
      )
        && string_contains(
          s: deploy_access_preflight_pass_message(access: ci_deploy_srv1_access),
          pattern: ci_deploy_runner_principal_name()
        )
    Deny { reason: _ } =>
      string_contains(s: deploy_access_decision_reason(d: d), pattern: deploy_access_refusal_prefix)
  }
}

fn witness_deploy_access_sudo_miss_surfaces_sudoers_hint() -> Bool {
  let actor = DeployAccessActor {
    observed_name: fleet_posix_principal(key: FleetAccountCiRunner).posix.name,
    sudo_granted: false,
  }
  match deploy_access_check(access: ci_deploy_srv1_access, actor: actor) {
    Permit => false
    Deny { reason: _ } =>
      let why = deploy_access_sudo_miss_reason(access: ci_deploy_srv1_access)
      string_contains(s: why, pattern: gunbc_deploy_sudoers_dropin)
        && string_contains(
          s: why,
          pattern: deploy_access_sudoers_line(
            access: ci_deploy_srv1_access,
            cmd: srv1_live_deploy_privileged_commands().first()
          )
        )
  }
}

fn witness_deploy_access_sudoers_line_authority() -> Bool {
  string_contains(
    s: deploy_access_sudoers_line(
      access: ci_deploy_srv1_access,
      cmd: srv1_live_deploy_privileged_commands().first()
    ),
    pattern: ci_deploy_runner_principal_name()
  )
}

fn witness_ci_spec_carries_deploy_stages() -> Bool {
  gunbc_ci_spec.deploy_stages == gunbc_ci_deploy_stages
    && length(gunbc_ci_deploy_stages) == 1
}

fn witness_deploy_run_script_invokes_gunbc_wet() -> Bool {
  let script = gunbc_ci_deploy_run_script(stage: gunbc_ci_deploy_srv1_stage)
  string_contains(s: script, pattern: live_deploy_apply_entry)
    && string_contains(s: script, pattern: live_deploy_apply_srv1_wet_function)
    && string_contains(s: script, pattern: "$ROOT/target/release/gunbc")
    && string_contains(s: script, pattern: "--source-root dag")
}

fn witness_workflow_has_deploy_job_gated_on_ci() -> Bool {
  let deploy_jobs = filter(ci_workflow.jobs, j => j.id == "deploy_dashboard_srv1")
  length(deploy_jobs) == 1
    && deploy_jobs.first().needs == ["ci"]
    && match deploy_jobs.first().if_condition {
      Present { value: cond } => cond == ci_deploy_push_to_main_if
      Absent => false
    }
}

fn witness_ci_yml_emits_deploy_job() -> Bool {
  let yaml = expected_ci_yml()
  string_contains(s: yaml, pattern: "  deploy_dashboard_srv1:")
    && string_contains(s: yaml, pattern: "    needs: [ci]")
    && string_contains(s: yaml, pattern: concat("    if: ", ci_deploy_push_to_main_if))
    && string_contains(s: yaml, pattern: "Deploy dashboard to srv1 (live_deploy_apply_srv1_wet)")
    && string_contains(s: yaml, pattern: live_deploy_apply_srv1_wet_function)
}

test fn ci_deploy_witnesses() -> Bool {
  witness_deploy_stage_targets_live_deploy_wet()
    && witness_deploy_access_uses_local_apply_on_srv1()
    && witness_deploy_access_preflight_is_fail_closed()
    && witness_deploy_access_sudo_miss_surfaces_sudoers_hint()
    && witness_deploy_access_sudoers_line_authority()
    && witness_ci_spec_carries_deploy_stages()
    && witness_deploy_run_script_invokes_gunbc_wet()
    && witness_workflow_has_deploy_job_gated_on_ci()
    && witness_ci_yml_emits_deploy_job()
}
