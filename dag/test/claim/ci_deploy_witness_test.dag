data ci_deploy_witness_hermetic_split_note: String = "The observed half of this file (witness_deploy_access_preflight_is_fail_closed, which shells live whoami + sudo -n via deploy_access_check_observed) lives in test.claim.ci_deploy_observed_wet, OFFLINE per the hermetic-floor posture (operator 2026-07-11). This file keeps the hermetic half: pure pins over the deploy spec/script/workflow and the mock-shaped deploy_access_check(access, actor) dual — the dependency-injection exemplar the posture generalizes."

fn ci_deploy_runner_principal_name() -> String {
  grounded_posix_principal_name(p: ci_deploy_srv1_access.principal) as String
}

test fn witness_deploy_stage_targets_live_deploy_wet() -> Bool {
  gunbc_ci_deploy_srv1_stage.entry == live_deploy_apply_entry
    && gunbc_ci_deploy_srv1_stage.function == live_deploy_apply_srv1_wet_function
    && gunbc_ci_deploy_srv1_stage.needs == ["ci"]
}

test fn witness_deploy_access_uses_local_apply_on_srv1() -> Bool {
  let access = ci_deploy_srv1_access
  access.host == srv1_host
    && grounded_posix_principal_name(p: access.principal) == "ghrunner"
    && deploy_access_is_local_apply(access: access)
    && match access.transport {
      LocalShell => true
      _ => false
    }
}

test fn witness_deploy_access_sudo_miss_surfaces_sudoers_hint() -> Bool {
  let actor = DeployAccessActor {
    observed_name: fleet_posix_principal(key: FleetAccountCiRunner).posix.name,
    sudo_granted: false,
  }
  match deploy_access_check(access: ci_deploy_srv1_access, actor: actor) {
    Permit => false
    Deny { refusal: _ } =>
      let why = deploy_access_sudo_miss_reason(access: ci_deploy_srv1_access)
      string_contains(s: why, pattern: gunbc_deploy_sudoers_dropin)
        && string_contains(
          s: why,
          pattern: deploy_access_sudoers_line(
            access: ci_deploy_srv1_access,
            cmd: srv1_live_deploy_privileged_commands().first()
          )
        )
  }
}

test fn witness_deploy_access_sudoers_line_authority() -> Bool {
  string_contains(
    s: deploy_access_sudoers_line(
      access: ci_deploy_srv1_access,
      cmd: srv1_live_deploy_privileged_commands().first()
    ),
    pattern: ci_deploy_runner_principal_name()
  )
}

test fn witness_ci_spec_carries_deploy_stages() -> Bool {
  gunbc_ci_spec.deploy_stages == gunbc_ci_deploy_stages
}

test fn witness_deploy_invoke_runs_gunbc_wet() -> Bool {
  let script = gunbc_ci_deploy_invoke(stage: gunbc_ci_deploy_srv1_stage)
  string_contains(s: script, pattern: live_deploy_apply_entry)
    && string_contains(s: script, pattern: live_deploy_apply_srv1_wet_function)
    && string_contains(s: script, pattern: "\"$ROOT/target/release/gunbc\" run")
    && string_contains(s: script, pattern: "--source-root \"$ROOT/dag\"")
}

test fn witness_deploy_invoke_does_not_rebuild_release_bins() -> Bool {
  let script = gunbc_ci_deploy_invoke(stage: gunbc_ci_deploy_srv1_stage)
  !string_contains(s: script, pattern: ci_release_build_line())
    && !string_contains(s: script, pattern: ci_release_build_script())
    && !string_contains(s: script, pattern: "CARGO_BIN")
    && !string_contains(s: script, pattern: "sccache --show-stats")
    && !string_contains(s: script, pattern: "CARGO_BUILD_JOBS=1")
}

test fn witness_ci_yml_deploy_job_consumes_release_bins_artifact() -> Bool {
  let yaml = expected_ci_yml()
  string_contains(s: yaml, pattern: "  deploy_dashboard_srv1:")
    && string_contains(s: yaml, pattern: "      - name: Download release-bins artifact")
    && string_contains(s: yaml, pattern: "      - name: Unpack + verify release bins (claim_executor --verify-build-artifacts; fail-closed)")
    && string_contains(s: yaml, pattern: "      - name: Deploy dashboard to srv1 (live_deploy_apply_srv1_wet)")
    && string_contains(s: yaml, pattern: "    timeout-minutes: 10")
    && !string_contains(s: yaml, pattern: "Deploy dashboard to srv1 (live_deploy_apply_srv1_wet)\n        run: |\n          ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)\n          set -o pipefail")
    && !string_contains(s: yaml, pattern: "Deploy dashboard to srv1 (live_deploy_apply_srv1_wet)\n        run: |\n          ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)\n          \"$CARGO_BIN\" build")
}

data deploy_concurrency_witness_boundary_note: String = "THIS WITNESS USED TO PIN A SPELLING AND CERTIFY THE WRONG PROPERTY. It asserted the emitted text `group: srv1-dashboard-deploy / cancel-in-progress: false`, which greens in the EXACT production state that cancelled the newest candidate on run 30863337319 — a pending job evicted with zero steps while the oldest commit's deploy ran last and reported success. The property is 'cutovers cannot overlap AND the final state is the newest admitted revision'; a substring pin covers only the first conjunct, and covers it by spelling rather than by behavior (operator ruling 2026-08-04).\\n\\nSo it is split. The ORDERING half is an executed acceptance in test.claim.deploy_revision_witness — every permutation of three ordered revisions converges to the newest. What remains here is the PRODUCTION-COMPOSITION half that only the emitted workflow can state: the deploy job must be QueueMax, because a pending deploy job is the sole carrier of its candidate revision and artifact, so pending-replacement destroys admitted work. Asserting `queue: max` is present AND that the pending-replacement default is absent makes the emitted mode discriminating in both directions, which a single positive substring never was."

test fn witness_ci_yml_deploy_job_retains_pending_candidates() -> Bool {
  let yaml = expected_ci_yml()
  string_contains(
    s: yaml,
    pattern: "    concurrency:\n      queue: max\n      group: srv1-dashboard-deploy\n      cancel-in-progress: false"
  )
}

data group_rename_deferred_witness_note: String = "THE GROUP STRING MUST STILL BE THE LEGACY ONE, and this asserts that deliberately rather than by omission. Renaming the concurrency group in the same landing as the lease would open a window with NO exclusion at all: jobs already in flight sit in the old group and predate the host lease, so they take neither the new group nor the lock, and the merge run would not exclude them through either mechanism (operator review 2026-08-04).\\n\\nThe second clause is what keeps the deferral from silently becoming permanent — it pins that the derived post-drain form is a DIFFERENT string that is not yet emitted, so when the rename lands this witness fails and has to be updated deliberately."

test fn witness_deploy_concurrency_group_rename_is_still_deferred() -> Bool {
  let emitted = deploy_target_queue_group(target: Srv1Dashboard)
  let after_drain = deploy_target_queue_group_after_drain(target: Srv1Dashboard)
  emitted == "srv1-dashboard-deploy"
    && after_drain != emitted
    && !string_contains(s: expected_ci_yml(), pattern: after_drain)
}

data deploy_budget_containment_witness_note: String = "The deploy STEP budget must fit inside the JOB backstop with room for the prelude and artifact transfer, or GitHub cancels the job before flock can report a lock conflict on its distinct exit code — destroying the one signal that separates 'another deploy holds the host' from 'this deploy failed'. Asserted as an inequality over the derivations rather than as two literals, so raising the cutover envelope moves both and cannot silently break containment."

test fn witness_deploy_step_budget_fits_inside_the_job_backstop() -> Bool {
  let step = gunbc_ci_deploy_step_timeout_minutes()
  let job = gunbc_ci_deploy_job_backstop_timeout_minutes()
  step > 0 && job > step && job >= step + gunbc_ci_artifact_transfer_step_timeout_minutes
}

test fn witness_workflow_deploy_job_matches_enrollment() -> Bool {
  let deploy_jobs = filter(ci_workflow.jobs, j => j.id == "deploy_dashboard_srv1")
  length(deploy_jobs) == length(gunbc_ci_deploy_stages)
}

test fn witness_ci_yml_deploy_job_matches_enrollment() -> Bool {
  let yaml = expected_ci_yml()
  let enrolled = length(gunbc_ci_deploy_stages) > 0
  string_contains(s: yaml, pattern: "  deploy_dashboard_srv1:") == enrolled
    && string_contains(s: yaml, pattern: "Deploy dashboard to srv1 (live_deploy_apply_srv1_wet)") == enrolled
    && string_contains(s: yaml, pattern: live_deploy_apply_srv1_wet_function) == enrolled
}

data lease_composition_note: String = "THE JOIN BETWEEN THE MODEL AND THE PRODUCTION PATH, ASSERTED RATHER THAN TRUSTED. lease.dag's advisory-lock obligation is 'every public mutation entry routes through the leased launcher', and an advisory lock is worth exactly what that obligation is worth — so these witnesses execute it. What they check is the seam a reader cannot see from either side alone: that the function CI actually names is the launcher, that the launcher's own argv re-invokes the leased inner entry against the same entry file, and that the candidate crosses that boundary as a named argument rather than being re-derived on the other side.\\n\\nThis is the shape #7462 was missing. A witness over decide_deploy_revision alone greens in a tree where nothing calls it; these red if the wiring is removed while every pure-decision witness stays green."


data witness_candidate_sha: CommitSha = "abcdef0123456789abcdef0123456789abcdef01"


data one_entry_file_note: String = "The CI step and the leased re-invocation must name the SAME entry file, and after the single-authority consolidation they are literally the same declaration — so this witness reds if anyone re-forks it, which is the failure mode that would otherwise produce a deploy that takes the lock and then runs nothing."



data conflict_code_argv_note: String = "The conflict code has to REACH flock, not merely be declared. A carrier holding 111 while the argv omitted --conflict-exit-code would leave flock exiting 1 on contention — indistinguishable from the wrapped deploy failing, which is the whole state-space collapse the flag exists to prevent."


data timeout_argv_is_a_bare_integer_note: String = "flock(1) takes --timeout as a bare integer of seconds; there is no `300s` form. This pins the emitted token so a change in how the Duration carrier renders cannot silently produce an argument flock rejects (review 48288)."


data candidate_crosses_as_named_arg_note: String = "The candidate must cross the process boundary as `--arg candidate=<sha>` and not as an environment variable or a positional. A positional would be an unchecked coincidence against a named .dag parameter, and an env channel at a runtime-present site is the shell-to-intent class DESIGN names — both of which would also make the candidate ambient at exactly the seam this model exists to make explicit."


data lease_outcome_three_way_note: String = "THREE OUTCOMES, AND THE SYSEXITS RANGE IS THE ONE THAT WAS ALMOST MISSED (review 48288). flock reserves 64..78 for its OWN failures, so those exits mean the wrapped deploy never ran — reporting them as the deploy's exit is the same conflation --conflict-exit-code removes, one class over. The boundary values are asserted, not just the interior, because an off-by-one on either end would silently reclassify a real launcher failure as a deploy failure."


data conflict_code_disjointness_note: String = "The conflict code's disjointness from every occupied range is asserted rather than argued. An earlier revision picked 75 because EX_TEMPFAIL's meaning matched a lease conflict — and 75 is inside the range flock uses for its own errors, so an internal flock failure would have been reported as contention. Semantic aptness was the wrong criterion; this is the right one, executing."

test fn the_conflict_code_is_disjoint_from_every_occupied_range() -> Bool {
  flock_conflict_exit_code_is_disjoint_from_reserved_ranges()
    && !flock_exit_is_launcher_failure(exit_code: flock_conflict_exit_code)
    && flock_exit_is_lock_conflict(exit_code: flock_conflict_exit_code)
}

fn is_conflict(o: LiveDeployLeaseOutcome) -> Bool {
  match o {
    LeaseExecutionAbnormal { target_key: _, exit_code: _ } => false
    LeaseConflict { target_key: _, waited: _ } => true
    LeaseLauncherFailed { target_key: _, exit_code: _ } => false
    LeaseAcquiredExit { exit_code: _ } => false
  }
}

fn is_launcher_failure(o: LiveDeployLeaseOutcome) -> Bool {
  match o {
    LeaseExecutionAbnormal { target_key: _, exit_code: _ } => false
    LeaseConflict { target_key: _, waited: _ } => false
    LeaseLauncherFailed { target_key: _, exit_code: _ } => true
    LeaseAcquiredExit { exit_code: _ } => false
  }
}

fn is_acquired(o: LiveDeployLeaseOutcome) -> Bool {
  match o {
    LeaseExecutionAbnormal { target_key: _, exit_code: _ } => false
    LeaseConflict { target_key: _, waited: _ } => false
    LeaseLauncherFailed { target_key: _, exit_code: _ } => false
    LeaseAcquiredExit { exit_code: _ } => true
  }
}

fn head_is(argv: List<String>, expected: String) -> Bool {
  match list_head(xs: argv) {
    HeadAbsent => false
    HeadFound { value: first } => first == expected
  }
}

fn contains_element(xs: List<String>, target: String) -> Bool {
  any(xs, x => x == target)
}

data receipt_read_write_note: String = "The receipt read and write must address the SAME path, and it must be the path revision.dag declares — the two scripts are built independently and would otherwise be free to drift into writing where nothing reads. The directory is asserted to be the file's own prefix for the same reason: the write creates the parent before placing the file, and a parent that is not this file's parent creates a directory nobody uses while the install still fails."

test fn the_receipt_scripts_address_the_declared_path_and_its_parent() -> Bool {
  let slot = deploy_target_blue_slot(target: Srv1Dashboard)
  let path = deploy_slot_revision_receipt_path(slot: slot) as String
  let dir = deploy_slot_revision_receipt_dir as String
  substring(s: path, start: 0, end: dir.length()) == dir
    && path.length() > dir.length()
    && contains_substring(haystack: live_deploy_slot_revision_read_script(spec: slot), needle: path)
    && contains_substring(
         haystack: live_deploy_slot_revision_record_script(spec: slot, revision: witness_candidate_sha),
         needle: path
       )
    && contains_substring(
         haystack: live_deploy_slot_revision_record_script(spec: slot, revision: witness_candidate_sha),
         needle: witness_candidate_sha as String
       )
}

data unrecorded_token_is_shared_note: String = "The read script prints the absence token and the parser compares against it. Asserting that the script actually contains the constant the parser reads is what keeps the two sides of that process boundary from drifting into disagreeing about what absence looks like — a drift that would make every slot read as unreadable, or worse, as unrecorded."


test fn the_receipt_parser_splits_recorded_unrecorded_and_corrupt() -> Bool {
  match parse_slot_revision_stdout(stdout: slot_revision_unrecorded_token) {
    DeployedRevisionUnrecorded => true
    DeployedRevisionRecorded { revision: _ } => false
    DeployedRevisionUnreadable { cause: _ } => false
  }
  && match parse_slot_revision_stdout(stdout: witness_candidate_sha as String) {
    DeployedRevisionRecorded { revision: r } => r == witness_candidate_sha
    DeployedRevisionUnrecorded => false
    DeployedRevisionUnreadable { cause: _ } => false
  }
  && match parse_slot_revision_stdout(stdout: "not-a-sha") {
    DeployedRevisionUnreadable { cause: _ } => true
    DeployedRevisionRecorded { revision: _ } => false
    DeployedRevisionUnrecorded => false
  }
  && match parse_slot_revision_stdout(stdout: "") {
    DeployedRevisionUnreadable { cause: _ } => true
    DeployedRevisionRecorded { revision: _ } => false
    DeployedRevisionUnrecorded => false
  }
}

fn contains_substring(haystack: String, needle: String) -> Bool {
  contains_substring_from(haystack: haystack, needle: needle, index: 0)
}

fn contains_substring_from(haystack: String, needle: String, index: Int) -> Bool {
  if index + needle.length() > haystack.length() {
    false
  } else {
    if substring(s: haystack, start: index, end: index + needle.length()) == needle {
      true
    } else {
      contains_substring_from(haystack: haystack, needle: needle, index: index + 1)
    }
  }
}

data lease_host_agreement_note: String = "THE LEASE MUST LOCK THE MACHINE THE EFFECTS LAND ON, AND THIS IS THE PAIR THAT PROVES THE TWO TRANSPORTS ARE TREATED DIFFERENTLY. The CI access is LocalShell — every host effect executes in the launcher's own machine, so the lock file and the mutations are on one host by construction and the lease is real. The operator access drives effects over SSH, so a flock taken in the launcher would lock the CALLER's machine and exclude nothing on srv1: a lease that reports success while excluding nobody, which is worse than none.\\n\\nThis is the discriminating pair rather than a single assertion because either half alone is satisfiable by a mistake. Admitting both would ship the fabricated lease; refusing both would disable the deploy entirely and still look 'safe'."



data shared_parent_has_no_owner_flags_note: String = "THE SHARED PARENT MUST NOT CARRY OWNERSHIP FLAGS, asserted rather than left to the next author's memory (review 48335). /var/lib/gunbc/deploy-revision is shared by every slot, so an `install -d -o <service_user>` there takes its owner from whichever slot happens to be deploying — idempotent only while all slots share one user, which is a coincidence of two values rather than a fact. The per-slot FILE keeps its owner flags, so this witness has to distinguish the two commands rather than simply banning `-o` from the script."

test fn the_shared_receipt_parent_is_created_without_owner_flags() -> Bool {
  let script = live_deploy_slot_revision_record_script(
    spec: deploy_target_blue_slot(target: Srv1Dashboard),
    revision: witness_candidate_sha,
  )
  let dir = deploy_slot_revision_receipt_dir as String
  contains_substring(haystack: script, needle: concat("install -d -m 0755 '", concat(dir, "'")))
    && !contains_substring(haystack: script, needle: concat("install -d -m 0755 -o", ""))
    && contains_substring(haystack: script, needle: "install -m 0644 -o ")
}

data coordination_matrices_note: String = "THE MATRICES THE OPERATOR ASKED FOR (2026-08-05), because the single CI/operator pair the previous revision carried is a two-point sample of a five-axis property. A coordination mechanism can be present, well-formed and useless on any of locus, extent, population, resource identity or outcome partition, and each axis needs its own discriminating pair — otherwise passing on one axis reads as coverage of all of them."

fn leased_argv_for(inner: String, operation: LiveDeployExclusiveOperation) -> List<String> {
  live_deploy_leased_command_for_operation(
    invocation: live_deploy_exclusive_invocation(target: Srv1Dashboard),
    source_roots: witness_layer_roots,
    inner_function: inner,
    named_args: witness_named_args(operation: operation),
  ).argv
}

fn witness_named_args(operation: LiveDeployExclusiveOperation) -> List<GunbcRunNamedArg> {
  match operation {
    LeasedRetract => []
    LeasedApply =>
      [GunbcRunNamedArg { name: live_deploy_candidate_arg_name, value: witness_candidate_sha as String }]
  }
}

fn subject_with(
  lease_locus: ExecutionLocus,
  mutation_locus: ExecutionLocus,
  lease_extent: CoordinationExtent,
  covered: List<DeployMutator>,
) -> DeployCoordinationSubject {
  DeployCoordinationSubject {
    target: Srv1Dashboard,
    lease_locus: lease_locus,
    mutation_locus: mutation_locus,
    lease_extent: lease_extent,
    required_extent: deploy_required_extent,
    mutation_population: deploy_mutation_population(),
    covered_population: covered,
  }
}

fn admits(s: DeployCoordinationSubject) -> Bool {
  match deploy_coordination_admission(subject: s) {
    CoordinationCovers => true
    CoordinationRefused { cause: _ } => false
  }
}

fn refuses_with_locus_mismatch(s: DeployCoordinationSubject) -> Bool {
  match deploy_coordination_admission(subject: s) {
    CoordinationRefused { cause: c } =>
      match c {
        CoordinationLocusMismatch { lease_host: _, mutation_host: _ } => true
        CoordinationExtentTooShort => false
        MutationEntrypointUncovered { participant: _ } => false
        CoordinationLocusUnobserved => false
      }
    CoordinationCovers => false
  }
}

fn refuses_with_extent_too_short(s: DeployCoordinationSubject) -> Bool {
  match deploy_coordination_admission(subject: s) {
    CoordinationRefused { cause: c } =>
      match c {
        CoordinationExtentTooShort => true
        CoordinationLocusMismatch { lease_host: _, mutation_host: _ } => false
        MutationEntrypointUncovered { participant: _ } => false
        CoordinationLocusUnobserved => false
      }
    CoordinationCovers => false
  }
}

fn refuses_with_uncovered_entrypoint(s: DeployCoordinationSubject) -> Bool {
  match deploy_coordination_admission(subject: s) {
    CoordinationRefused { cause: c } =>
      match c {
        MutationEntrypointUncovered { participant: _ } => true
        CoordinationExtentTooShort => false
        CoordinationLocusMismatch { lease_host: _, mutation_host: _ } => false
        CoordinationLocusUnobserved => false
      }
    CoordinationCovers => false
  }
}

fn refuses_with_unobserved_locus(s: DeployCoordinationSubject) -> Bool {
  match deploy_coordination_admission(subject: s) {
    CoordinationRefused { cause: c } =>
      match c {
        CoordinationLocusUnobserved => true
        MutationEntrypointUncovered { participant: _ } => false
        CoordinationExtentTooShort => false
        CoordinationLocusMismatch { lease_host: _, mutation_host: _ } => false
      }
    CoordinationCovers => false
  }
}

data witness_host_a: HostIdentity = "srv1"
data witness_host_b: HostIdentity = "srv2"

fn all_participants() -> List<DeployMutator> { deploy_mutation_population() }

test fn locus_matrix_admits_exactly_the_same_machine_on_both_sides() -> Bool {
  admits(s: subject_with(
    lease_locus: CurrentHost { host: witness_host_a },
    mutation_locus: CurrentHost { host: witness_host_a },
    lease_extent: ProcessLifetime, covered: all_participants()))
  && admits(s: subject_with(
    lease_locus: NamedHost { host: witness_host_a },
    mutation_locus: NamedHost { host: witness_host_a },
    lease_extent: SessionLifetime, covered: all_participants()))
  && refuses_with_extent_too_short(s: subject_with(
    lease_locus: NamedHost { host: witness_host_a },
    mutation_locus: NamedHost { host: witness_host_a },
    lease_extent: OneCommand, covered: all_participants()))
  && refuses_with_locus_mismatch(s: subject_with(
    lease_locus: NamedHost { host: witness_host_a },
    mutation_locus: NamedHost { host: witness_host_b },
    lease_extent: SessionLifetime, covered: all_participants()))
  && refuses_with_locus_mismatch(s: subject_with(
    lease_locus: CurrentHost { host: witness_host_a },
    mutation_locus: NamedHost { host: witness_host_b },
    lease_extent: ProcessLifetime, covered: all_participants()))
  && refuses_with_locus_mismatch(s: subject_with(
    lease_locus: CurrentHost { host: witness_host_a },
    mutation_locus: CurrentHost { host: witness_host_b },
    lease_extent: ProcessLifetime, covered: all_participants()))
  && refuses_with_locus_mismatch(s: subject_with(
    lease_locus: CurrentHost { host: witness_host_a },
    mutation_locus: DeferredExecution,
    lease_extent: ProcessLifetime, covered: all_participants()))
}

data unobserved_is_not_agreement_note: String = "AN UNOBSERVED LOCUS REFUSES ON EITHER SIDE. 'I could not determine which machine I am on' is not 'I am on the right one', and the whole locus axis is worthless if the unknown case defaults toward admission."

test fn an_unobserved_locus_refuses_on_either_side() -> Bool {
  refuses_with_unobserved_locus(s: subject_with(
    lease_locus: ExecutionLocusUnobserved,
    mutation_locus: CurrentHost { host: witness_host_a },
    lease_extent: ProcessLifetime, covered: all_participants()))
  && refuses_with_unobserved_locus(s: subject_with(
    lease_locus: CurrentHost { host: witness_host_a },
    mutation_locus: ExecutionLocusUnobserved,
    lease_extent: ProcessLifetime, covered: all_participants()))
}

data extent_matrix_note: String = "THE EXTENT AXIS FAILS INDEPENDENTLY OF THE LOCUS AXIS, which is why this holds the locus fixed at full agreement. A remote flock wrapping ONE command has a correct locus and still covers nothing across a multi-effect cutover — the defect the future session-lifetime transport must not be able to claim its way past."

test fn extent_matrix_refuses_a_lock_shorter_than_the_cutover() -> Bool {
  refuses_with_extent_too_short(s: subject_with(
    lease_locus: CurrentHost { host: witness_host_a },
    mutation_locus: CurrentHost { host: witness_host_a },
    lease_extent: OneCommand, covered: all_participants()))
  && admits(s: subject_with(
    lease_locus: CurrentHost { host: witness_host_a },
    mutation_locus: CurrentHost { host: witness_host_a },
    lease_extent: ProcessLifetime, covered: all_participants()))
  && admits(s: subject_with(
    lease_locus: CurrentHost { host: witness_host_a },
    mutation_locus: CurrentHost { host: witness_host_a },
    lease_extent: SessionLifetime, covered: all_participants()))
}

data participant_completeness_note: String = "THE POPULATION AXIS, PLANTED AT PARTICIPANT IDENTITY. Dropping retract from the covered set must red — that is the exact state this PR shipped before the operator caught it, with a carrier note claiming full coverage while both retract entries bypassed the lease. Every PARTICIPANT is dropped in turn, so no single declaration is special-cased, and the planted-fifth-entrypoint control below covers the case the kind grain could not see at all."

test fn participant_completeness_reds_when_any_mutator_is_uncovered() -> Bool {
  all(
    all_participants(),
    dropped => refuses_with_uncovered_entrypoint(s: subject_with(
      lease_locus: CurrentHost { host: witness_host_a },
      mutation_locus: CurrentHost { host: witness_host_a },
      lease_extent: ProcessLifetime,
      covered: filter(all_participants(), m => deploy_mutator_key(m: m) != deploy_mutator_key(m: dropped))))
  )
  && admits(s: subject_with(
      lease_locus: CurrentHost { host: witness_host_a },
      mutation_locus: CurrentHost { host: witness_host_a },
      lease_extent: ProcessLifetime, covered: all_participants()))
}

data transport_projection_witness_note: String = "THE PROJECTIONS ARE FACTS, ASSERTED SEPARATELY FROM THE POLICY THAT READS THEM. If a future transport is to become admissible by reporting a session lifetime rather than by an edit to a policy match, then what each transport reports has to be pinned — otherwise the projection becomes the new place to quietly change the answer."

test fn transports_project_the_loci_and_extents_they_actually_have() -> Bool {
  match host_effect_mutation_locus(transport: SshShell { ssh_host: "srv1" as NonEmptyStr }) {
    NamedHost { host: h } => h == witness_host_a
    _ => false
  }
  && match host_effect_mutation_locus(transport: EmitArtifactThenThinRun {
       bootstrap: BootstrapFragment { script: "" },
       invocation: ThinInvocation { argv: [] },
     }) {
    DeferredExecution => true
    _ => false
  }
  && match command_transport_lease_locus(transport: SshExec { ssh_target: "srv1" as NonEmptyStr }) {
    NamedHost { host: h } => h == witness_host_a
    _ => false
  }
  && match command_transport_lease_extent(transport: LocalExec) {
    ProcessLifetime => true
    _ => false
  }
  && match command_transport_lease_extent(transport: SshExec { ssh_target: "srv1" as NonEmptyStr }) {
    OneCommand => true
    _ => false
  }
}

data all_public_entries_leased_note: String = "PARTICIPANT COMPLETENESS AT THE ENTRYPOINT GRAIN, which the population axis cannot see: the model can list retract as covered while the retract entrypoint still calls the actuator directly. This asserts that the four public entries name exactly the two leased inner functions and that neither inner function is itself a public entry."

test fn all_four_public_entries_launch_under_the_lease() -> Bool {
  gunbc_ci_deploy_srv1_stage.function == live_deploy_apply_srv1_wet_function
    && live_deploy_apply_srv1_wet_function != live_deploy_apply_srv1_leased_entry_function
    && live_deploy_apply_srv1_wet_function != live_deploy_retract_srv1_leased_entry_function
    && live_deploy_apply_srv1_leased_entry_function != live_deploy_retract_srv1_leased_entry_function
}

test fn the_leased_command_is_flock_exclusive_over_the_target_lease() -> Bool {
  let argv = leased_argv_for(inner: live_deploy_apply_srv1_leased_entry_function, operation: LeasedApply)
  head_is(argv: argv, expected: "flock")
    && contains_element(argv, "--exclusive")
    && contains_element(argv, deploy_target_lease_path(target: Srv1Dashboard) as String)
    && contains_element(argv, live_deploy_apply_srv1_leased_entry_function)
    && contains_element(argv, "--conflict-exit-code")
    && contains_element(argv, to_string(flock_conflict_exit_code))
    && contains_element(argv, "--timeout")
    && contains_element(argv, "300")
    && !contains_element(argv, "300s")
    && contains_element(argv, live_deploy_apply_entry)
    && live_deploy_apply_entry == live_deploy_apply_entry_path
}

data retract_carries_no_candidate_note: String = "A RETRACT HAS NO CANDIDATE, and asserting its absence matters: an operation shape that let a retract be launched with a candidate argument would be handing the inner entry a value it has no meaning for, which is the placeholder that an earlier revision of the operation carrier forced every caller to invent."

test fn apply_carries_the_candidate_and_retract_carries_none() -> Bool {
  let apply_argv = leased_argv_for(inner: live_deploy_apply_srv1_leased_entry_function, operation: LeasedApply)
  let retract_argv = leased_argv_for(inner: live_deploy_retract_srv1_leased_entry_function, operation: LeasedRetract)
  contains_element(apply_argv, "--arg")
    && contains_element(apply_argv, concat("candidate=", witness_candidate_sha as String))
    && !contains_element(retract_argv, "--arg")
    && contains_element(retract_argv, live_deploy_retract_srv1_leased_entry_function)
}

data lease_namespace_witness_note: String = "THE LOCK DIRECTORY MUST BE PROVISIONED BEFORE ACQUISITION, and this pins that the provisioning command targets the lock path's own parent. Nothing created /var/lib/gunbc/deploy-lease before the operator caught it, so the first launcher would have failed at flock — before reaching any inner process that could have created it."

test fn the_lease_namespace_command_provisions_the_lock_object() -> Bool {
  let argv = live_deploy_lease_namespace_command(
    invocation: live_deploy_exclusive_invocation(target: Srv1Dashboard)
  ).argv
  head_is(argv: argv, expected: "sudo")
    && contains_element(argv, "install")
    && contains_element(argv, "-d")
    && contains_element(argv, deploy_target_lease_path(target: Srv1Dashboard) as String)
    && substring(
         s: deploy_target_lease_path(target: Srv1Dashboard) as String,
         start: 0,
         end: (deploy_target_lease_dir as String).length()
       ) == (deploy_target_lease_dir as String)
}

data exit_domain_witness_note: String = "THE WRAPPED PROGRAM'S EXIT DOMAIN IS CLOSED AT {0,1}, so everything outside it that is not the conflict code or flock's own sysexits range is abnormal. 126, 127 and signal-derived exits were previously reported as the inner reconciliation's verdict — a sentence about a deploy that never started."

test fn the_exit_partition_covers_conflict_launcher_abnormal_and_wrapped() -> Bool {
  let inv = live_deploy_exclusive_invocation(target: Srv1Dashboard)
  is_conflict(o: live_deploy_lease_outcome(invocation: inv, exit_code: flock_conflict_exit_code))
    && is_launcher_failure(o: live_deploy_lease_outcome(invocation: inv, exit_code: 64))
    && is_launcher_failure(o: live_deploy_lease_outcome(invocation: inv, exit_code: 78))
    && is_acquired(o: live_deploy_lease_outcome(invocation: inv, exit_code: 0))
    && is_acquired(o: live_deploy_lease_outcome(invocation: inv, exit_code: 1))
    && is_abnormal(o: live_deploy_lease_outcome(invocation: inv, exit_code: 2))
    && is_abnormal(o: live_deploy_lease_outcome(invocation: inv, exit_code: 63))
    && is_abnormal(o: live_deploy_lease_outcome(invocation: inv, exit_code: 79))
    && is_abnormal(o: live_deploy_lease_outcome(invocation: inv, exit_code: 126))
    && is_abnormal(o: live_deploy_lease_outcome(invocation: inv, exit_code: 127))
    && is_abnormal(o: live_deploy_lease_outcome(invocation: inv, exit_code: 137))
}

fn is_abnormal(o: LiveDeployLeaseOutcome) -> Bool {
  match o {
    LeaseExecutionAbnormal { target_key: _, exit_code: _ } => true
    LeaseConflict { target_key: _, waited: _ } => false
    LeaseLauncherFailed { target_key: _, exit_code: _ } => false
    LeaseAcquiredExit { exit_code: _ } => false
  }
}

data codec_controls_note: String = "THE RECEIPT DECODER MUST NOT REPAIR CORRUPTION INTO AUTHORIZATION. `tr -d '[:space:]'` deleted INTERNAL whitespace, so a receipt fragmented by spaces or newlines collapsed into a well-formed 40-character sha and was accepted. These controls plant each whitespace class inside an otherwise-valid sha; every one must refuse."

test fn internally_corrupted_receipts_refuse_rather_than_being_repaired() -> Bool {
  let good = witness_candidate_sha as String
  all(
    [" ", "\t", "\r", "\n"],
    ws => match parse_slot_revision_stdout(
      stdout: join([substring(s: good, start: 0, end: 20), ws, substring(s: good, start: 20, end: 40)], "")
    ) {
      DeployedRevisionUnreadable { cause: _ } => true
      DeployedRevisionRecorded { revision: _ } => false
      DeployedRevisionUnrecorded => false
    }
  )
  && match parse_slot_revision_stdout(stdout: concat(good, "\n")) {
    DeployedRevisionUnreadable { cause: _ } => true
    _ => false
  }
  && match parse_slot_revision_stdout(stdout: good) {
    DeployedRevisionRecorded { revision: r } => r == witness_candidate_sha
    _ => false
  }
}

test fn the_read_script_prints_the_token_the_parser_recognizes() -> Bool {
  let script = live_deploy_slot_revision_read_script(spec: deploy_target_blue_slot(target: Srv1Dashboard))
  contains_substring(haystack: script, needle: slot_revision_unrecorded_token)
    && !contains_substring(haystack: script, needle: "tr -d")
}


data lease_probe_fold_note: String = "THE PROBE'S OUTCOME FOLD, PINNED HERMETICALLY, so the wet run on srv1 has a regression control that does not need srv1. The three steps are 0 / conflict / 0, and each is asserted to refuse on its own — because a fold that accepted a wrong code at any step would report a working lease from a host where the lock does not work, which is the one thing the probe exists to rule out.\n\nThe fold is separated from the execution deliberately: the codes come from the real flock invocation at run time, and everything downstream of them is decidable here."

fn probe_holds(o: LeaseProbeOutcome) -> Bool {
  match o {
    LeaseProbeHolds => true
    LeaseProbeRefused { cause: _ } => false
  }
}

test fn the_lease_probe_accepts_only_the_free_contended_free_sequence() -> Bool {
  probe_holds(o: lease_probe_outcome(lock: "/l", cleared: 0, free_before: 0, contended: flock_conflict_exit_code, inner_ran: 0, free_after: 0, object_stable: 0))
    && !probe_holds(o: lease_probe_outcome(lock: "/l", cleared: 1, free_before: 0, contended: flock_conflict_exit_code, inner_ran: 0, free_after: 0, object_stable: 0))
    && !probe_holds(o: lease_probe_outcome(lock: "/l", cleared: 0, free_before: 1, contended: flock_conflict_exit_code, inner_ran: 0, free_after: 0, object_stable: 0))
    && !probe_holds(o: lease_probe_outcome(lock: "/l", cleared: 0, free_before: flock_conflict_exit_code, contended: flock_conflict_exit_code, inner_ran: 0, free_after: 0, object_stable: 0))
    && !probe_holds(o: lease_probe_outcome(lock: "/l", cleared: 0, free_before: 0, contended: 0, inner_ran: 0, free_after: 0, object_stable: 0))
    && !probe_holds(o: lease_probe_outcome(lock: "/l", cleared: 0, free_before: 0, contended: 1, inner_ran: 0, free_after: 0, object_stable: 0))
    && !probe_holds(o: lease_probe_outcome(lock: "/l", cleared: 0, free_before: 0, contended: flock_conflict_exit_code, inner_ran: 0, free_after: flock_conflict_exit_code, object_stable: 0))
    && !probe_holds(o: lease_probe_outcome(lock: "/l", cleared: 0, free_before: 0, contended: flock_conflict_exit_code, inner_ran: 0, free_after: 1, object_stable: 0))
    && !probe_holds(o: lease_probe_outcome(lock: "/l", cleared: 0, free_before: 0, contended: flock_conflict_exit_code, inner_ran: 1, free_after: 0, object_stable: 0))
    && !probe_holds(o: lease_probe_outcome(lock: "/l", cleared: 0, free_before: 0, contended: flock_conflict_exit_code, inner_ran: 0, free_after: 0, object_stable: 1))
}

data probe_uses_the_real_builder_note: String = "The probe's argv must be the deploy's own flock command, not a hand-spelled one — otherwise it proves that some flock invocation works on srv1 while leaving the command this model actually constructs unexercised. Step B nests the same builder inside itself, which is what makes the conflict come from this argv rather than from a bespoke one."

test fn the_probe_argv_is_the_modeled_flock_command() -> Bool {
  let inv = live_deploy_exclusive_invocation(target: Srv1Dashboard)
  let outer = live_deploy_lease_probe_command(invocation: inv, inner: ["true"]).argv
  head_is(argv: outer, expected: "flock")
    && contains_element(outer, "--exclusive")
    && contains_element(outer, "--nonblock")
    && contains_element(outer, "--conflict-exit-code")
    && contains_element(outer, to_string(flock_conflict_exit_code))
    && contains_element(outer, deploy_target_lease_path(target: Srv1Dashboard) as String)
    && contains_element(
         live_deploy_lease_probe_command(invocation: inv, inner: outer).argv,
         "--nonblock"
       )
}

data crash_prefix_control_note: String = "THE CRASH-PREFIX CONTROL, FOLDING THE ACTUATOR'S OWN STAGE ORDER (operator merge condition 2026-08-05). gunbc.live_deploy.apply crash_prefix_invariant_note states a property of every prefix of the cutover; until this ran, that property was prose beside a nested if/else, which is the specification-without-execution shape DESIGN §5 names — the claim would have stayed true-looking after someone reverted the order.\\n\\nSo the actuator now folds live_deploy_cutover_stage_order and this folds the SAME row. The invariant is: at every prefix, the ROUTED slot's recorded revision equals what that slot serves — because the next deploy reads exactly the routed slot's receipt and nothing else. Reverting to flip-before-record edits the row, and the first test below reds.\\n\\nTHE RED IS THE HISTORICAL DEFECT, NOT A SYNTHETIC ONE. The rejected order is authored here because a control needs something to discriminate against, and the second test proves it actually violates the invariant rather than merely differing. The third carries it through the REAL decision function to the harm: a routed slot serving C while its receipt still says stale authorizes a later, OLDER candidate as an advance, so the public dashboard moves backward — and the same candidate against the landed order's final world is Keep. That is the whole reason the order is a safety property and not a preference."

data crash_sha_stale: CommitSha = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
data crash_sha_next: CommitSha = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
data crash_sha_candidate: CommitSha = "cccccccccccccccccccccccccccccccccccccccc"

type PrefixWorld {
  routed_is_candidate: Bool
  old_recorded: CommitSha
  old_serves: CommitSha
  candidate_recorded: CommitSha
  candidate_serves: CommitSha
}

data crash_prefix_initial_world: PrefixWorld = PrefixWorld {
  routed_is_candidate: false,
  old_recorded: crash_sha_stale,
  old_serves: crash_sha_stale,
  candidate_recorded: crash_sha_stale,
  candidate_serves: crash_sha_stale,
}

fn crash_prefix_apply_stage(w: PrefixWorld, stage: CutoverStage) -> PrefixWorld {
  match stage {
    PrepareCandidateSlot =>
      PrefixWorld {
        routed_is_candidate: w.routed_is_candidate,
        old_recorded: w.old_recorded,
        old_serves: w.old_serves,
        candidate_recorded: w.candidate_recorded,
        candidate_serves: crash_sha_candidate,
      }
    RecordCandidateRevision =>
      PrefixWorld {
        routed_is_candidate: w.routed_is_candidate,
        old_recorded: w.old_recorded,
        old_serves: w.old_serves,
        candidate_recorded: crash_sha_candidate,
        candidate_serves: w.candidate_serves,
      }
    FlipRouteToCandidate =>
      PrefixWorld {
        routed_is_candidate: true,
        old_recorded: w.old_recorded,
        old_serves: w.old_serves,
        candidate_recorded: w.candidate_recorded,
        candidate_serves: w.candidate_serves,
      }
    VerifyRoutedCandidate => w
    RetireActiveSlot => w
  }
}

fn routed_receipt_matches_service(w: PrefixWorld) -> Bool {
  if w.routed_is_candidate {
    w.candidate_recorded == w.candidate_serves
  } else {
    w.old_recorded == w.old_serves
  }
}

type PrefixTrace {
  current: PrefixWorld
  holds: List<Bool>
}

fn crash_prefix_trace(stages: List<CutoverStage>) -> PrefixTrace {
  fold(
    stages,
    init: PrefixTrace {
      current: crash_prefix_initial_world,
      holds: [routed_receipt_matches_service(w: crash_prefix_initial_world)],
    },
    f: (acc, stage) => {
      let next = crash_prefix_apply_stage(w: acc.current, stage: stage)
      PrefixTrace {
        current: next,
        holds: concat(acc.holds, [routed_receipt_matches_service(w: next)]),
      }
    }
  )
}

data crash_prefix_rejected_order: List<CutoverStage> = [
  PrepareCandidateSlot,
  FlipRouteToCandidate,
  RecordCandidateRevision,
  VerifyRoutedCandidate,
  RetireActiveSlot,
]

test fn every_prefix_of_the_landed_cutover_order_holds_the_receipt_invariant() -> Bool {
  let trace = crash_prefix_trace(stages: live_deploy_cutover_stage_order)
  count(trace.holds) == count(live_deploy_cutover_stage_order) + 1
    && all(trace.holds, h => h)
    && trace.current.routed_is_candidate
    && trace.current.candidate_recorded == crash_sha_candidate
}

test fn the_flip_before_record_order_violates_the_receipt_invariant() -> Bool {
  let trace = crash_prefix_trace(stages: crash_prefix_rejected_order)
  count(trace.holds) == count(crash_prefix_rejected_order) + 1
    && any(trace.holds, h => !h)
    && count(crash_prefix_rejected_order) == count(live_deploy_cutover_stage_order)
}

data crash_prefix_harm_note: String = "The two decisions below differ only in which revision the ROUTED slot's receipt names, which is the only thing the crash window changes. Both are the same real fold over the same later candidate."

fn decision_for_routed_receipt(recorded: CommitSha, candidate: CommitSha) -> DeployDecision {
  decide_deploy_for_observation(
    observed: DeployedRevisionRecorded { revision: recorded },
    candidate: candidate,
    deployed_is_ancestor_of_candidate: crash_linear_is_ancestor(earlier: recorded, later: candidate),
    candidate_is_ancestor_of_deployed: crash_linear_is_ancestor(earlier: candidate, later: recorded),
  )
}

fn crash_revision_index(sha: CommitSha) -> Int {
  if sha == crash_sha_stale { 0 }
  else { if sha == crash_sha_next { 1 } else { if sha == crash_sha_candidate { 2 } else { 0 - 1 } } }
}

fn crash_linear_is_ancestor(earlier: CommitSha, later: CommitSha) -> Bool {
  let i = crash_revision_index(sha: earlier)
  let j = crash_revision_index(sha: later)
  i >= 0 && j >= 0 && i <= j
}

test fn the_violated_prefix_authorizes_a_backward_public_move() -> Bool {
  let crashed = crash_prefix_trace(stages: crash_prefix_rejected_order)
  let landed = crash_prefix_trace(stages: live_deploy_cutover_stage_order)
  let crashed_at_flip = crash_prefix_apply_stage(
    w: crash_prefix_apply_stage(w: crash_prefix_initial_world, stage: PrepareCandidateSlot),
    stage: FlipRouteToCandidate,
  )
  !routed_receipt_matches_service(w: crashed_at_flip)
    && crashed_at_flip.candidate_serves == crash_sha_candidate
    && crashed_at_flip.candidate_recorded == crash_sha_stale
    && match decision_for_routed_receipt(recorded: crashed_at_flip.candidate_recorded, candidate: crash_sha_next) {
         Advance { admission: adm } => adm.to == crash_sha_next
         Keep { reason: _ } => false
         Refuse { cause: _ } => false
       }
    && match decision_for_routed_receipt(recorded: landed.current.candidate_recorded, candidate: crash_sha_next) {
         Keep { reason: _ } => true
         Advance { admission: _ } => false
         Refuse { cause: _ } => false
       }
    && any(crashed.holds, h => !h)
    && all(landed.holds, h => h)
}

data planted_fifth_entrypoint_note: String = "THE CONTROL THE KIND GRAIN COULD NOT EXPRESS (operator ruling 2026-08-05). Under the previous shape both sides listed the same four KINDS, so a new public function performing an existing kind — say a fifth entrypoint that only flips the route — found MutateRouteFlip already covered and the admission stayed green while a real mutator sat outside the lease. Planting exactly that participant is the discriminating input: same kind, new declaration, must refuse. It reds if the join is ever weakened back to kinds."

fn planted_route_flip_entrypoint() -> DeployMutator {
  DeployMutator {
    declaration: DeclarationRef {
      module_path: "gunbc.live_deploy.apply",
      decl_name: "some_future_route_only_entrypoint",
      field: WholeDeclaration,
    },
    kind: MutateRouteFlip,
  }
}

test fn a_new_entrypoint_performing_a_covered_kind_still_refuses() -> Bool {
  let planted = planted_route_flip_entrypoint()
  let widened = concat(all_participants(), [planted])
  any(all_participants(), m => m.kind == MutateRouteFlip)
    && !any(all_participants(), m => deploy_mutator_key(m: m) == deploy_mutator_key(m: planted))
    && refuses_with_uncovered_entrypoint(s: DeployCoordinationSubject {
         target: Srv1Dashboard,
         lease_locus: CurrentHost { host: witness_host_a },
         mutation_locus: CurrentHost { host: witness_host_a },
         lease_extent: ProcessLifetime,
         required_extent: deploy_required_extent,
         mutation_population: widened,
         covered_population: all_participants(),
       })
}

data future_remote_session_note: String = "THE ESCAPE HATCH THE MODULE ADVERTISES MUST ACTUALLY BE REACHABLE. coordination_coverage_note promises a future remote-session transport becomes admissible by REPORTING SessionLifetime rather than by editing a policy match. Under the previous locus fold that was false — every NamedHost lease locus refused before extent was consulted, so no lifetime value could admit it. This asserts the promise directly: same named host on both sides, session lifetime, admits; the same pair at one-command lifetime refuses on extent, which is where today's SSH realization correctly lands."

test fn a_future_remote_session_is_admissible_without_a_policy_edit() -> Bool {
  admits(s: subject_with(
    lease_locus: NamedHost { host: witness_host_a },
    mutation_locus: NamedHost { host: witness_host_a },
    lease_extent: SessionLifetime, covered: all_participants()))
  && refuses_with_extent_too_short(s: subject_with(
    lease_locus: NamedHost { host: witness_host_a },
    mutation_locus: NamedHost { host: witness_host_a },
    lease_extent: OneCommand, covered: all_participants()))
  && match command_transport_lease_extent(transport: SshExec { ssh_target: "srv1" as NonEmptyStr }) {
       OneCommand => true
       _ => false
     }
}

data lock_object_witness_note: String = "THE LOCK OBJECT IS A DIRECTORY AND THE NAMESPACE IS NOT WORLD-WRITABLE. A replaceable pathname passes a free/contended/free probe perfectly while providing no exclusion — measured, and recorded in lock_object_is_a_directory_note. These pin the two facts that remove the replacement: the provisioning command creates the LOCK OBJECT itself (not merely its parent) so the object exists before anyone locks it, and it does so at 0755 rather than 0777, so no unprivileged principal can unlink or rename it."

test fn the_lock_object_is_provisioned_as_a_stable_directory() -> Bool {
  let argv = live_deploy_lease_namespace_command(
    invocation: live_deploy_exclusive_invocation(target: Srv1Dashboard)
  ).argv
  let lock = deploy_target_lease_path(target: Srv1Dashboard) as String
  head_is(argv: argv, expected: "sudo")
    && contains_element(argv, "install")
    && contains_element(argv, "-d")
    && contains_element(argv, "0755")
    && !contains_element(argv, "0777")
    && contains_element(argv, lock)
    && !string_contains(s: lock, pattern: ".lock")
    && string_contains(s: lock, pattern: deploy_target_lease_dir as String)
}

data cutover_verifies_before_retiring_note: String = "RETIREMENT IS GATED ON A VERIFIED ROUTE, NOT ON A ZERO EXIT. The flip stage reports whether the `tailscale serve` command converged; that is not an observation that the public mapping moved. Without a verification stage between them, a command that succeeded while the mapping stayed stale is followed straight by stopping the runtime that is still routed. These assert the stage exists, sits between the flip and the retirement, and that the order is still the record-before-flip order the crash-prefix control depends on."

test fn the_routed_candidate_is_verified_before_the_old_runtime_retires() -> Bool {
  let order = live_deploy_cutover_stage_order
  count(order) == 5
    && stage_index(order: order, stage: RecordCandidateRevision) < stage_index(order: order, stage: FlipRouteToCandidate)
    && stage_index(order: order, stage: FlipRouteToCandidate) < stage_index(order: order, stage: VerifyRoutedCandidate)
    && stage_index(order: order, stage: VerifyRoutedCandidate) < stage_index(order: order, stage: RetireActiveSlot)
}

fn stage_key(stage: CutoverStage) -> String {
  match stage {
    PrepareCandidateSlot => "prepare"
    RecordCandidateRevision => "record"
    FlipRouteToCandidate => "flip"
    VerifyRoutedCandidate => "verify"
    RetireActiveSlot => "retire"
  }
}

type StageIndexScan {
  seen: Int
  found: Int
}

fn stage_index(order: List<CutoverStage>, stage: CutoverStage) -> Int {
  let scan = fold(
    order,
    init: StageIndexScan { seen: 0, found: 0 - 1 },
    f: (acc, s) => StageIndexScan {
      seen: acc.seen + 1,
      found: if stage_key(stage: s) == stage_key(stage: stage) { acc.seen } else { acc.found },
    }
  )
  scan.found
}
