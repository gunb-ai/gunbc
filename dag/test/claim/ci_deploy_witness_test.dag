module test.claim.ci_deploy_witness



data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

data ci_deploy_witness_hermetic_split_note: String = "The observed half of this file (witness_deploy_access_preflight_is_fail_closed, which shells live whoami + sudo -n via deploy_access_check_observed) lives in test.claim.ci_deploy_observed_wet, OFFLINE per the hermetic-floor posture (operator 2026-07-11). This file keeps the hermetic half: pure pins over the deploy spec/script/workflow and the mock-shaped deploy_access_check(access, actor) dual — the dependency-injection exemplar the posture generalizes."

fn ci_deploy_runner_principal_name() -> String {
  grounded_posix_principal_name(p: ci_deploy_srv1_access.principal) as String
}

test fn witness_deploy_stage_targets_live_deploy_wet() -> Bool {
  gunbc_ci_deploy_srv1_stage.entry == live_deploy_apply_entry
    && gunbc_ci_deploy_srv1_stage.function == live_deploy_apply_srv1_wet_function
    && gunbc_ci_deploy_srv1_stage.needs == ["ci"]
}

test fn witness_deploy_access_uses_local_apply_on_srv1() -> Bool {
  let access = ci_deploy_srv1_access
  access.host == srv1_host
    && grounded_posix_principal_name(p: access.principal) == "ghrunner"
    && deploy_access_is_local_apply(access: access)
    && match access.transport {
      LocalShell => true
      _ => false
    }
}

test fn witness_deploy_access_sudo_miss_surfaces_sudoers_hint() -> Bool {
  let actor = DeployAccessActor {
    observed_name: fleet_posix_ci_runner_principal().posix.name,
    sudo_granted: false,
  }
  match deploy_access_check(access: ci_deploy_srv1_access, actor: actor) {
    Permit => false
    Deny { refusal: _ } =>
      let why = deploy_access_sudo_miss_reason(access: ci_deploy_srv1_access)
      string_contains(s: why, pattern: gunbc_deploy_sudoers_dropin)
        && string_contains(
          s: why,
          pattern: deploy_access_sudoers_line(
            access: ci_deploy_srv1_access,
            cmd: srv1_live_deploy_privileged_commands().first()
          )
        )
  }
}

test fn witness_deploy_access_sudoers_line_authority() -> Bool {
  string_contains(
    s: deploy_access_sudoers_line(
      access: ci_deploy_srv1_access,
      cmd: srv1_live_deploy_privileged_commands().first()
    ),
    pattern: ci_deploy_runner_principal_name()
  )
}

test fn witness_ci_spec_carries_deploy_stages() -> Bool {
  gunbc_ci_spec.deploy_stages == gunbc_ci_deploy_stages
}

test fn witness_deploy_invoke_runs_gunbc_wet() -> Bool {
  let script = gunbc_ci_deploy_invoke(stage: gunbc_ci_deploy_srv1_stage)
  string_contains(s: script, pattern: live_deploy_apply_entry)
    && string_contains(s: script, pattern: live_deploy_apply_srv1_wet_function)
    && string_contains(s: script, pattern: "\"$ROOT/target/release/gunbc\" run")
    && string_contains(s: script, pattern: "--source-root \"$ROOT/dag\"")
}

test fn witness_deploy_invoke_does_not_rebuild_release_bins() -> Bool {
  let script = gunbc_ci_deploy_invoke(stage: gunbc_ci_deploy_srv1_stage)
  !string_contains(s: script, pattern: ci_release_build_line())
    && !string_contains(s: script, pattern: ci_release_build_script())
    && !string_contains(s: script, pattern: "CARGO_BIN")
    && !string_contains(s: script, pattern: "sccache --show-stats")
    && !string_contains(s: script, pattern: "CARGO_BUILD_JOBS=1")
}

// Deploy now runs as a STEP inside the unified `fleet` job (operator consolidation
// 2026-08-10): the job downloads + verifies the release-bins artifact once and the deploy
// step consumes it. The deploy step does not rebuild (asserted directly against the
// invoke script in witness_deploy_invoke_does_not_rebuild_release_bins above).
test fn witness_ci_yml_deploy_job_consumes_release_bins_artifact() -> Bool {
  let yaml = expected_ci_yml()
  string_contains(s: yaml, pattern: "  fleet:")
    && string_contains(s: yaml, pattern: "      - name: Download release-bins artifact")
    && string_contains(s: yaml, pattern: "      - name: Unpack + verify release bins (claim_executor --verify-build-artifacts; fail-closed)")
    && string_contains(s: yaml, pattern: "      - name: Deploy dashboard to srv1 (live_deploy_apply_srv1_wet)")
}

test fn witness_ci_yml_deploy_job_serializes_blue_green_cutovers() -> Bool {
  let yaml = expected_ci_yml()
  string_contains(
    s: yaml,
    pattern: "    concurrency:\n      group: srv1-dashboard-deploy\n      cancel-in-progress: false"
  )
}

// The deploy jobs collapsed into ONE `fleet` job (operator consolidation 2026-08-10);
// exactly one fleet job carries the deploy step(s).
test fn witness_workflow_deploy_job_matches_enrollment() -> Bool {
  let fleet_jobs = filter(ci_workflow.jobs, j => j.id == "fleet")
  length(fleet_jobs) == 1
}

// OBSERVATION-UNFUSED-FROM-ACTUATION discriminating control (operator route 2026-08-10,
// CONVERGE acceptance). Two consecutive main pushes hit the cold whole-corpus floor
// over-budget, so the push-gated fleet job skipped every time and collect_fleet_convergence
// (a READ) never ran. The repair admits the collector on workflow_dispatch while keeping
// deploy + advance (the WRITES) push-only. This test REDS if the collector reverts to
// push-only (re-fusing the read to the write gate) OR if either write leaks onto dispatch
// (letting a censored-floor dispatch deploy or advance the desired ref).
fn ci_fleet_step_if_condition(s: Step) -> String {
  match s {
    RunStep { name: _, id: _, run: _, shell: _, env: _, working_directory: _, if_condition: ifc, continue_on_error: _, timeout_minutes: _ } =>
      match ifc { Present { value: c } => c, _ => "" }
    UsesStep { name: _, id: _, uses: _, with: _, env: _, if_condition: ifc, continue_on_error: _, timeout_minutes: _ } =>
      match ifc { Present { value: c } => c, _ => "" }
  }
}

fn ci_fleet_step_name(s: Step) -> String {
  match s {
    RunStep { name: n, id: _, run: _, shell: _, env: _, working_directory: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } =>
      match n { Present { value: nm } => nm, _ => "" }
    UsesStep { name: n, id: _, uses: _, with: _, env: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } =>
      match n { Present { value: nm } => nm, _ => "" }
  }
}

fn ci_fleet_if_for_step_named(needle: String) -> String {
  let fleet_steps = filter(ci_workflow.jobs, j => j.id == "fleet").first().steps
  fold(fleet_steps, init: "", f: (acc, s) =>
    if string_contains(s: ci_fleet_step_name(s: s), pattern: needle) {
      ci_fleet_step_if_condition(s: s)
    } else {
      acc
    })
}

// The READ step and the WRITE steps are deliberately gated differently: collect admits BOTH
// push and workflow_dispatch, while deploy and advance are push-only and never dispatch. A
// dispatchable write is the fused shape this claim exists to refuse.
test fn witness_collector_read_unfused_from_writes() -> Bool {
  let collect_if = ci_fleet_if_for_step_named(needle: "Collect fleet converge")
  let deploy_if = ci_fleet_if_for_step_named(needle: "Deploy dashboard to srv1")
  let advance_if = ci_fleet_if_for_step_named(needle: "Advance refs/fleet/desired")
  string_contains(s: collect_if, pattern: "github.event_name == 'push'")
    && string_contains(s: collect_if, pattern: "workflow_dispatch")
    && string_contains(s: deploy_if, pattern: "github.event_name == 'push'")
    && !string_contains(s: deploy_if, pattern: "workflow_dispatch")
    && string_contains(s: advance_if, pattern: "github.event_name == 'push'")
    && !string_contains(s: advance_if, pattern: "workflow_dispatch")
}

test fn witness_ci_yml_deploy_job_matches_enrollment() -> Bool {
  let yaml = expected_ci_yml()
  let enrolled = length(gunbc_ci_deploy_stages) > 0
  string_contains(s: yaml, pattern: "  fleet:")
    && string_contains(s: yaml, pattern: "Deploy dashboard to srv1 (live_deploy_apply_srv1_wet)") == enrolled
    && string_contains(s: yaml, pattern: live_deploy_apply_srv1_wet_function) == enrolled
}
