module test.claim.contract_identity.required_ci_contract_epoch_derived

import std.types { Bool, String }
import gunbc.required_ci_contract_epoch {
  required_ci_context_name,
  required_ci_contract_epoch,
  required_ci_contract_epoch_of,
  required_ci_obligation_rows,
  RequiredContextName,
}
import std.algebra { Cons }

// THE EPOCH IS THE DIGEST OF THE OBLIGATION ROWS, not a hand-bumped calendar token. A list that
// dropped the context-name row is a different contract; a list equal to production is the
// production epoch. The digest does not see workflow YAML or the step list — those are not rows.

test fn the_required_context_name_is_v2_bootstrap() -> Bool {
  (required_ci_context_name as String) == "v2-bootstrap"
}

test fn the_production_epoch_is_the_digest_of_the_production_rows() -> Bool {
  (required_ci_contract_epoch as String) == (required_ci_contract_epoch_of(rows: required_ci_obligation_rows()) as String)
}

test fn dropping_an_obligation_row_moves_the_epoch() -> Bool {
  match required_ci_obligation_rows() {
    Cons { head: _, tail: rest } =>
      (required_ci_contract_epoch_of(rows: rest) as String) != (required_ci_contract_epoch as String)
    _ => false
  }
}

test fn the_context_name_is_an_obligation_row() -> Bool {
  any(required_ci_obligation_rows(), row =>
    match row.kind {
      RequiredContextName => (row.key as String) == (required_ci_context_name as String)
      _ => false
    })
}

test fn a_step_list_string_is_not_an_obligation_key() -> Bool {
  !any(required_ci_obligation_rows(), row =>
    string_contains(s: row.key as String, pattern: "Checkout")
      || string_contains(s: row.key as String, pattern: "Isolate toolchain"))
}
