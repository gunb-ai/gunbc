module test.claim.contract_identity.required_ci_epoch_git_backed_witness

import std.types { Bool, String, Int, NonEmptyStr, FilePath, GitRef }
import std.logic { Bool }
import extdeps.git
import extdeps.shell
import extdeps.filesystem.filesystem_io
import extdeps.git.plumbing { GitRepositoryAddress, GitWorktreeAt }
import extdeps.github.workflow_runs { WorkflowRunConclusion, Success }
import extdeps.github.workflow_run_event { WorkflowRunEvent, CommitSha }
import extdeps.languages.yaml.types { YamlValue, yaml_mapping, yaml_string, kv }
import extdeps.languages.yaml.emit { serialize_yaml }
import gunbc.generated_artifact { WitnessFloorYamlArtifact, artifact_path }
import gunbc.repo_identity { gunbc_default_branch_name }
import gunbc.witness_floor_workflow { witness_floor_workflow_name }
import gunbc.required_ci_contract_epoch {
  required_ci_contract_epoch,
  required_ci_contract_epoch_env_key,
}
import gunbc.required_ci_epoch_observation {
  RequiredCiEpochObservation,
  RequiredCiEpochObserved,
  RequiredCiEpochUnobservable,
  observe_required_ci_epoch_at_commit,
}
import gunbc.fleet_revision_acceptance {
  RequiredCiAdmission,
  RequiredCiAdmitted,
  RequiredCiRefused,
  CiContractEpochMismatch,
  accept_required_ci_workflow_run,
}
import gunbc.fleet_desired_admission {
  FleetDesiredAcceptedRevision,
  FleetDesiredRevisionAccepted,
  FleetDesiredRevisionRefused,
  fleet_desired_accepted_from_event,
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// WHY THIS WITNESS IS GIT-BACKED AND NOT A CONSTRUCTED OBSERVATION. The contract epoch is a
// structural member of a committed artifact, so changing it CHANGES THE TREE and therefore the
// commit. "Hold the revision fixed and vary the observed epoch" is not a state this system can
// reach, and a witness that constructed the observation by hand would be asserting the fold's
// arithmetic while proving nothing about the reader that produces it. The experiment is therefore
// two real commits in a real repository whose trees differ ONLY in the epoch member, read back
// through the production reader, and fed to the production composition.
//
// THE TWO FIXTURE DOCUMENTS ARE EMITTED, NOT TYPED. Both come from one function differing only in
// its epoch argument, and both are serialized by extdeps.languages.yaml.emit serialize_yaml -- the
// same emitter that writes the committed workflow -- so "the trees differ only in the epoch member"
// is a property of the construction rather than of an author's care with two string literals.
//
// THE ORACLE DOES NOT CALL THE FOLD UNDER TEST. Expected values are the required epoch (from its
// authority) and the mismatching epoch (from the constructor that built the fixture); the verdict
// is read by pattern-matching the refusal arm and comparing both carried epochs to those two.
// required_ci_epoch_verdict, contract_identity_eq and the epoch comparison itself are never called.

data fixture_mismatching_epoch: String = "1999-01-01.0"
data fixture_repo_full_name: String = "gunb-ai/gunbc"

fn fixture_workflow_source(epoch: String) -> String {
  serialize_yaml(v: yaml_mapping(entries: [
    kv(key: "name", value: yaml_string(s: witness_floor_workflow_name)),
    kv(key: "env", value: yaml_mapping(entries: [
      kv(key: (required_ci_contract_epoch_env_key as String), value: yaml_string(s: epoch)),
    ])),
  ]))
}

fn fixture_repo_file(repo: FilePath, name: String) -> String {
  concat(concat(repo as String, "/"), name)
}

// The workflow path inside the fixture is the production path, derived from the artifact authority
// rather than spelled here: the reader resolves the path itself, so a fixture that put the document
// anywhere else would be observing an absence and calling it a mismatch.
fn fixture_workflow_dir(repo: FilePath) -> String {
  fixture_repo_file(repo: repo, name: ".github/workflows")
}

type EpochCommitPair {
  matching_sha: String
  mismatching_sha: String
  setup_ok: Bool
}

// Two parentless commits, each written from a private index, so neither shares any history with the
// other and the ONLY thing that can differ between their trees is the one blob this function writes.
func commit_epoch_fixture(repo: FilePath, epoch: String, branch: String) -> String {
  let written = Filesystem.Write(
    path: fixture_repo_file(repo: repo, name: artifact_path(a: WitnessFloorYamlArtifact)),
    content: fixture_workflow_source(epoch: epoch),
  )
  let staged = git.Core.AddAllInRepo(repo: repo).exit_code
  let committed = git.Core.CommitInRepo(repo: repo, message: branch).exit_code
  let resolved = git.Core.RevParseInRepo(repo: repo, target: "HEAD" as GitRef)
  if written.success && staged == 0 && committed == 0 && resolved.exit_code == 0 {
    trim(s: resolved.revision)
  } else {
    ""
  }
}

func build_epoch_fixture(repo: FilePath) -> EpochCommitPair {
  let made = shell.Mkdir.Parents(path: fixture_workflow_dir(repo: repo) as FilePath)
  let initialized = git.Core.InitInRepo(repo: repo)
  let email = git.Core.ConfigLocalSetInRepo(repo: repo, key: "user.email", value: "witness@gunbc.invalid")
  let name = git.Core.ConfigLocalSetInRepo(repo: repo, key: "user.name", value: "gunbc contract epoch witness")
  let matching = commit_epoch_fixture(repo: repo, epoch: required_ci_contract_epoch as String, branch: "matching")
  let mismatching = commit_epoch_fixture(repo: repo, epoch: fixture_mismatching_epoch, branch: "mismatching")
  EpochCommitPair {
    matching_sha: matching,
    mismatching_sha: mismatching,
    setup_ok: made.success && initialized.success && email.success && name.success
      && matching != "" && mismatching != "" && matching != mismatching,
  }
}

type EpochExperiment {
  observation: RequiredCiEpochObservation
  admission: RequiredCiAdmission
  desired: FleetDesiredAcceptedRevision
  setup_ok: Bool
}

fn fixture_event_at(head_sha: String) -> WorkflowRunEvent {
  WorkflowRunEvent {
    activity: "completed",
    run_id: "1" as NonEmptyStr,
    workflow_name: witness_floor_workflow_name,
    workflow_id: "2" as NonEmptyStr,
    workflow_path: artifact_path(a: WitnessFloorYamlArtifact),
    conclusion: Success,
    html_url: "https://example.invalid/run" as NonEmptyStr,
    run_started_at: "2026-09-01T00:00:00Z" as NonEmptyStr,
    head_sha: head_sha as CommitSha,
    head_branch: gunbc_default_branch_name,
    head_repository_full_name: fixture_repo_full_name,
    originating_event: "push",
    repository_full_name: fixture_repo_full_name,
  }
}

// ONE AXIS. Both arms run this function; the only thing that differs between them is WHICH of the
// two fixture commits is named as the run's head_sha, and every other field of the event, the
// repository, and the reader are identical.
func run_epoch_experiment(mismatching: Bool) -> EpochExperiment {
  let dir = shell.Mktemp.Dir()
  let fixture = build_epoch_fixture(repo: dir.path)
  let head_sha = if mismatching { fixture.mismatching_sha } else { fixture.matching_sha }
  let observed = observe_required_ci_epoch_at_commit(
    address: GitWorktreeAt { path: dir.path },
    head_sha: head_sha as GitRef,
  )
  let event = fixture_event_at(head_sha: head_sha)
  let admission = accept_required_ci_workflow_run(
    event: event,
    evidence: event.run_id,
    observed_epoch: observed,
  )
  let desired = fleet_desired_accepted_from_event(event: event, observed_epoch: observed)
  let cleaned = shell.Remove.RecursiveForce(path: dir.path)
  EpochExperiment {
    observation: observed,
    admission: admission,
    desired: desired,
    setup_ok: dir.success && fixture.setup_ok && cleaned.success,
  }
}

// THE DISCRIMINATING RED. Exactly one refusal, naming the contract-epoch axis and carrying both
// epochs, through the live fleet-desired composition.
test func a_run_of_the_contract_at_another_epoch_refuses_naming_both_epochs() -> Bool {
  let e = run_epoch_experiment(mismatching: true)
  e.setup_ok
    && match e.observation {
      RequiredCiEpochObserved { epoch: o } => (o as String) == fixture_mismatching_epoch
      RequiredCiEpochUnobservable { cause: _ } => false
    }
    && match e.admission {
      RequiredCiRefused { cause: CiContractEpochMismatch { observed: o, required: r } } =>
        o == fixture_mismatching_epoch && r == (required_ci_contract_epoch as String)
      _ => false
    }
    && match e.desired {
      FleetDesiredRevisionRefused { cause: _ } => true
      FleetDesiredRevisionAccepted { accepted: _ } => false
    }
}

// THE PAIRED CONTROL. The same experiment at the required epoch admits through the same fold, so
// the refusal above is the epoch and not the fixture.
test func a_run_of_the_contract_at_the_required_epoch_admits() -> Bool {
  let e = run_epoch_experiment(mismatching: false)
  e.setup_ok
    && match e.observation {
      RequiredCiEpochObserved { epoch: o } => (o as String) == (required_ci_contract_epoch as String)
      RequiredCiEpochUnobservable { cause: _ } => false
    }
    && match e.admission {
      RequiredCiAdmitted { succeeded: _ } => true
      RequiredCiRefused { cause: _ } => false
    }
    && match e.desired {
      FleetDesiredRevisionAccepted { accepted: _ } => true
      FleetDesiredRevisionRefused { cause: _ } => false
    }
}
