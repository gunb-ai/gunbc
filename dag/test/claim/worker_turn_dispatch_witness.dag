module test.claim.worker_turn_dispatch_witness

import std.types { Bool, List, NonEmptyStr, String }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.optional { Present, Absent }
import gunbc.roadmap.roadmap_dashboard_instance { HostDashboardInstance, srv1_live_dashboard_instance, srv2_lab_dashboard_instance }
import gunbc.roadmap.roadmap_dispatch_actuator {
  DispatchProviderInnerArgv,
  DispatchProviderInnerArgvReady,
  CodexProviderExecutableAbsent,
  CursorProviderOffCustodyHost,
  CursorProviderCredentialUnbound,
  CodexProviderOffCustodyHost,
  ClaudeProviderCredentialUnbound,
  dispatch_provider_inner_argv_for_launch,
}
import gunbc.dispatch_attempt { DispatchAttempt }
import gunbc.dispatch_attempt_launch { PreparedAttemptLaunch, SnapshotFreeLaunch, CodexWithoutSnapshot, HarnessWithoutSnapshot }
import extdeps.llm.cli { ReasoningMedium, ProviderAccountDefaultModel }
import gunbc.codex_harness_credential { codex_harness_turn_lock_path, codex_worker_turn_codex_home }
import gunbc.host.host_layout { srv2_roadmap_codex_home }
import test.claim.roadmap.roadmap_dispatch_actuator_witness { fx_prepared_launch, sized_derivable }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE PRODUCTION SPAWN FOLD for a dashboard instance, with nothing supplied but the attempt and its
// prepared launch: these claims exercise dispatch_provider_inner_argv_for_launch over the declared
// srv1 and srv2 instances, so a change that sends a Codex turn to an ambient login, or to a host that
// does not hold the credential, reds here. A Claude or Cursor launch holds an attempt snapshot, which
// only the real take writes, so those claims are witnessed by
// test.claim.dispatch_credential_snapshot_wet_witness, which uses inner_for_launch below.
fn worker_turn_attempt(instance: HostDashboardInstance) -> DispatchAttempt {
  DispatchAttempt {
    instance: instance,
    node: sized_derivable(id: "node-worker-turn", prs: [], title: "Worker turn"),
    attempt_key: "0123456789abcdef",
  }
}

fn inner_for_launch(prepared: PreparedAttemptLaunch) -> DispatchProviderInnerArgv {
  dispatch_provider_inner_argv_for_launch(
    prepared: prepared,
    session_uuid: "00000000-0000-4000-8000-000000000000",
    worktree_path: "/tmp/w",
    brief: "brief",
    alignment_chain_fingerprint: "fp",
  )
}

fn codex_inner_for(instance: HostDashboardInstance) -> DispatchProviderInnerArgv? {
  let attempt = worker_turn_attempt(instance: instance)
  match fx_prepared_launch(
    requested: attempt,
    launch: SnapshotFreeLaunch { attempt: attempt, executor: CodexWithoutSnapshot },
    effort: ReasoningMedium,
    model: ProviderAccountDefaultModel,
  ) {
    Present { value: prepared } => Present { value: inner_for_launch(prepared: prepared) }
    none => none
  }
}

fn ready_argv(inner: DispatchProviderInnerArgv) -> List<String>? {
  match inner {
    DispatchProviderInnerArgvReady { argv } => Present { value: argv }
    CodexProviderExecutableAbsent { reason: _ } => none
    CursorProviderOffCustodyHost { reason: _ } => none
    CursorProviderCredentialUnbound { reason: _ } => none
    CodexProviderOffCustodyHost { reason: _ } => none
    ClaudeProviderCredentialUnbound { reason: _ } => none
  }
}

fn first_word_is(argv: List<String>, word: String) -> Bool {
  match argv.first() {
    Present { value: w } => w == word
    Absent => false
  }
}

fn has_pair(argv: List<String>, flag: String, value: String) -> Bool {
  string_contains(s: join(argv, separator: "\0"), pattern: join(["\0", flag, "\0", value], ""))
}

// THE CODEX ROUTE on the custody host: the whole command runs under the exclusive non-blocking flock
// on the custody lock, with conflict exit 75, and CODEX_HOME is the custody directory -- never the
// instance's ambient roadmap login, which is the arm this replaced.
test fn a_codex_turn_on_srv2_runs_under_the_flock_on_the_custody_codex_home() -> Bool {
  match codex_inner_for(instance: srv2_lab_dashboard_instance()) {
    none => false
    Present { value: inner } =>
      match inner {
        DispatchProviderInnerArgvReady { argv } =>
          first_word_is(argv: argv, word: "flock")
            && any(argv, a => a == "--exclusive")
            && any(argv, a => a == "--nonblock")
            && has_pair(argv: argv, flag: "--conflict-exit-code", value: "75")
            && any(argv, a => a == codex_harness_turn_lock_path as String)
            && any(argv, a => a == concat("CODEX_HOME=", codex_worker_turn_codex_home as String))
            && !any(argv, a => a == concat("CODEX_HOME=", srv2_roadmap_codex_home as String))
        CodexProviderExecutableAbsent { reason: _ } => false
        CursorProviderOffCustodyHost { reason: _ } => false
        CursorProviderCredentialUnbound { reason: _ } => false
        CodexProviderOffCustodyHost { reason: _ } => false
        ClaudeProviderCredentialUnbound { reason: _ } => false
      }
  }
}

test fn a_codex_turn_off_its_custody_host_refuses() -> Bool {
  match codex_inner_for(instance: srv1_live_dashboard_instance()) {
    none => false
    Present { value: inner } =>
      match inner {
        CodexProviderOffCustodyHost { reason } => string_contains(s: reason as String, pattern: "srv2")
        DispatchProviderInnerArgvReady { argv: _ } => false
        CodexProviderExecutableAbsent { reason: _ } => false
        CursorProviderOffCustodyHost { reason: _ } => false
        CursorProviderCredentialUnbound { reason: _ } => false
        ClaudeProviderCredentialUnbound { reason: _ } => false
      }
  }
}

// THE BELT ENTRY IS UNACTIVATED (operator ruling, flex 7): the production spawn fold passes no durable turn, so a
// belt worker keeps the operator-route behaviour and claims no durability. Activation is a fleet-seat placement
// for BatchQualityTolerant belt work (gunbc.serving.caller_retry_contract serving_route_caller_retry_rows). Passing
// a dispatch node, turn ordinal or state root from the belt before then reads RED here.
test fn the_emitted_worker_argv_passes_no_durable_turn() -> Bool {
  let attempt = worker_turn_attempt(instance: srv2_lab_dashboard_instance())
  match fx_prepared_launch(
    requested: attempt,
    launch: SnapshotFreeLaunch { attempt: attempt, executor: HarnessWithoutSnapshot },
    effort: ReasoningMedium,
    model: ProviderAccountDefaultModel,
  ) {
    none => false
    Present { value: prepared } =>
      match inner_for_launch(prepared: prepared) {
        DispatchProviderInnerArgvReady { argv } =>
          string_contains(s: join(argv, separator: "\0"), pattern: "alignment_chain_fingerprint=")
            && !string_contains(s: join(argv, separator: "\0"), pattern: "dispatch_node=")
            && !string_contains(s: join(argv, separator: "\0"), pattern: "turn_ordinal=")
            && !string_contains(s: join(argv, separator: "\0"), pattern: "state_root=")
        CodexProviderExecutableAbsent { reason: _ } => false
        CursorProviderOffCustodyHost { reason: _ } => false
        CursorProviderCredentialUnbound { reason: _ } => false
        CodexProviderOffCustodyHost { reason: _ } => false
        ClaudeProviderCredentialUnbound { reason: _ } => false
      }
  }
}
