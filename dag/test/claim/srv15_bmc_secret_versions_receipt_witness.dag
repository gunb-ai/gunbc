module gunbc.test.claim.srv15_bmc_secret_versions_receipt_witness

// Discriminating claims for the metadata-only versions read (gunbc.auth.srv15_bmc_secret_versions_receipt).
// Every fold input is SUPPLIED here as a typed RestResult — the same shape the readonly ListVersions
// operation answers — so each law (permission, absence, transport, credential, decode, pagination,
// enabled-uniqueness) is tested at the decision that raises it, not at a mocked transport.

import std.types { Bool, String, List, NonEmptyStr }
import std.algebra { length, string_contains, list_append, string_concat_join, FreeMonoid, Empty, Cons }
import std.optional { Absent, Present }
import std.access { AccessRefusal, AccessRefusalCause, AccessEvidenceAbsent, AccessRefusalLocation }
import extdeps.transports.rest { RestResult, RestAnswered, RestRefused, RestStatusRefused, RestTransportRefused, RestBodyUndecodable, RestCredentialRefused }
import extdeps.cloud.gcp.secret_manager { GcpSecretVersion, SmVersionState, SmEnabled, SmDisabled, SmDestroyed, SmResolvedVersionIdentity }
import gunbc.auth.srv15_bmc_secret_versions_receipt {
  Srv15SecretVersionsAnswer,
  Srv15SecretVersionsReadOutcome,
  Srv15SecretVersionsReadRefusal,
  Srv15SecretVersionsAccepted,
  Srv15SecretVersionsRefused,
  Srv15BmcSecretVersionsReceipt,
  Srv15SecretVersionRow,
  srv15_bmc_secret_versions_fold,
  srv15_versions_receipt_json,
  srv15_versions_wire_name,
  srv15_versions_run_url,
  srv15_versions_state_name,
  refusal_name,
}
import gunbc.secret_provision { srv15_bmc_gunbc_secret_ref }
import gunbc.fleet.fleet_secrets_config { fleet_secrets_gcp_project }

// One row builder, BOTH facts independent: the name's versions/<n> tail AND the state field are
// supplied separately, so a fold that derived enabled-ness from either one alone can be caught.
fn fx_row(version_number: String, state: SmVersionState, created: String) -> GcpSecretVersion {
  GcpSecretVersion {
    name: string_concat_join(
      fields: ["projects/gunbai-secrets/secrets/bmc-srv15-admin/versions/", version_number],
      separator: "",
    ) as SmResolvedVersionIdentity,
    state: state,
    create_time: created,
    etag: Absent,
    destroy_time: Absent,
  }
}

fn fx_answer(rows: List<GcpSecretVersion>) -> RestResult<Srv15SecretVersionsAnswer> {
  RestAnswered {
    answer: Srv15SecretVersionsAnswer { versions: rows, next_page_token: Absent },
  }
}

fn fx_fold(rows: List<GcpSecretVersion>) -> Srv15SecretVersionsReadOutcome {
  srv15_bmc_secret_versions_fold(
    project: fleet_secrets_gcp_project,
    secret: srv15_bmc_gunbc_secret_ref.secret,
    observed_by_run: srv15_versions_run_url(run_id: "12345"),
    answer: fx_answer(rows: rows),
  )
}

// THE HAPPY PATH: exactly one ENABLED row among a disabled and a destroyed row folds to a receipt
// carrying every row as read. Discriminating on the STATE field, not the name: an implementation
// that read "enabled" off the digit tail (name carries "7" while the row is DISABLED) accepts
// nothing here and this claim goes red.
test fn srv15_versions_receipt_accepts_the_single_enabled_row() -> Bool {
  match fx_fold(rows: [
    fx_row(version_number: "7", state: SmDisabled, created: "2026-11-02T00:00:00Z"),
    fx_row(version_number: "7", state: SmEnabled, created: "2026-11-01T00:00:00Z"),
    fx_row(version_number: "3", state: SmDestroyed, created: "2026-10-28T00:00:00Z"),
  ]) {
    Srv15SecretVersionsAccepted { receipt: r } =>
      length(r.versions) == 3
        && any(r.versions, row => row.number == "7" && row.create_time == "2026-11-01T00:00:00Z")
        && any(r.versions, row => row.number == "3" && row.state == SmDestroyed)
    Srv15SecretVersionsRefused { cause: _ } => false
  }
}

// The state names the artifact spells are the API's own three words, per row.
test fn srv15_versions_state_names_are_the_lifecycle_words() -> Bool {
  srv15_versions_state_name(state: SmEnabled) == "ENABLED"
    && srv15_versions_state_name(state: SmDisabled) == "DISABLED"
    && srv15_versions_state_name(state: SmDestroyed) == "DESTROYED"
}

// The receipt's run locator is the composed Actions run URL of THIS run — the locator the pin
// will carry; a receipt without it could not ground a citation.
test fn srv15_versions_receipt_carries_the_run_url() -> Bool {
  match fx_fold(rows: [fx_row(version_number: "7", state: SmEnabled, created: "2026-11-01T00:00:00Z")]) {
    Srv15SecretVersionsAccepted { receipt: r } =>
      (r.observed_by_run as String) == "https://github.com/gunb-ai/gunbc/actions/runs/12345"
        && (r.project as String) == (fleet_secrets_gcp_project as String)
        && (r.secret as String) == (srv15_bmc_gunbc_secret_ref.secret as String)
    Srv15SecretVersionsRefused { cause: _ } => false
  }
}

// A DISABLED-only population is not a version to pin: the read refuses NoEnabledVersion rather
// than pinning a disabled version.
test fn srv15_versions_read_refuses_when_no_row_is_enabled() -> Bool {
  match fx_fold(rows: [
    fx_row(version_number: "7", state: SmDisabled, created: "2026-11-01T00:00:00Z"),
    fx_row(version_number: "6", state: SmDestroyed, created: "2026-10-30T00:00:00Z"),
  ]) {
    Srv15SecretVersionsRefused { cause: c } =>
      refusal_name(cause: c) == "Srv15SecretReadNoEnabledVersion"
    Srv15SecretVersionsAccepted { receipt: _ } => false
  }
}

// TWO enabled rows: "the" enabled version is not a fact the read can ground; the refusal carries
// the ambiguity rather than picking (a fold that silently took the first would pass every other
// claim here and fails THIS one).
test fn srv15_versions_read_refuses_ambiguous_enabled_versions() -> Bool {
  match fx_fold(rows: [
    fx_row(version_number: "7", state: SmEnabled, created: "2026-11-01T00:00:00Z"),
    fx_row(version_number: "9", state: SmEnabled, created: "2026-11-03T00:00:00Z"),
  ]) {
    Srv15SecretVersionsRefused { cause: c } =>
      refusal_name(cause: c) == "Srv15SecretReadAmbiguousEnabledVersion"
    Srv15SecretVersionsAccepted { receipt: _ } => false
  }
}

// THE PAGE-TOKEN LAW: a population that reports a continuation is a PREFIX, and a prefix holding
// exactly one ENABLED row must STILL refuse — the unshown page could hold the real enabled
// version. A fold that accepted single-enabled prefixes is exactly the silent narrowing a
// nextPageToken exists to warn about.
test fn srv15_versions_read_refuses_a_paginated_prefix() -> Bool {
  match srv15_bmc_secret_versions_fold(
    project: fleet_secrets_gcp_project,
    secret: srv15_bmc_gunbc_secret_ref.secret,
    observed_by_run: srv15_versions_run_url(run_id: "12345"),
    answer: RestAnswered {
      answer: Srv15SecretVersionsAnswer {
        versions: [fx_row(version_number: "7", state: SmEnabled, created: "2026-11-01T00:00:00Z")],
        next_page_token: Present { value: "CONTINUATION-TOKEN" },
      },
    },
  ) {
    Srv15SecretVersionsRefused { cause: c } => refusal_name(cause: c) == "Srv15SecretReadPaginated"
    Srv15SecretVersionsAccepted { receipt: _ } => false
  }
}

// 403 refuses BY NAME — the ruling's no-fallback law. The step's log must be able to say WHICH
// law fired, and nothing downstream may retry as a different identity.
test fn srv15_versions_read_403_refuses_permission_by_name() -> Bool {
  match srv15_bmc_secret_versions_fold(
    project: fleet_secrets_gcp_project,
    secret: srv15_bmc_gunbc_secret_ref.secret,
    observed_by_run: srv15_versions_run_url(run_id: "12345"),
    answer: RestRefused { refusal: RestStatusRefused { status: 403, body: "{\"error\":{\"message\":\"Permission denied on secret\"}}" } },
  ) {
    Srv15SecretVersionsRefused { cause: c } =>
      match c {
        Srv15SecretReadPermissionDenied { http_status: 403, message: _ } =>
          string_contains(s: refusal_name(cause: c), pattern: "Srv15SecretReadPermissionDenied")
        _ => false
      }
    Srv15SecretVersionsAccepted { receipt: _ } => false
  }
}

// 404 is the secret-absent law, kept DISTINCT from permission: the fix for one (operator creates
// the secret) is not the fix for the other (operator grants the role).
test fn srv15_versions_read_404_refuses_secret_absent_by_name() -> Bool {
  match srv15_bmc_secret_versions_fold(
    project: fleet_secrets_gcp_project,
    secret: srv15_bmc_gunbc_secret_ref.secret,
    observed_by_run: srv15_versions_run_url(run_id: "12345"),
    answer: RestRefused { refusal: RestStatusRefused { status: 404, body: "{\"error\":{\"message\":\"not found\"}}" } },
  ) {
    Srv15SecretVersionsRefused { cause: c } => refusal_name(cause: c) == "Srv15SecretReadSecretAbsent"
    Srv15SecretVersionsAccepted { receipt: _ } => false
  }
}

// A transport that never answered is its own named cause — not permission, not absence, and
// never a fold over an empty population.
test fn srv15_versions_read_transport_failure_refuses_by_name() -> Bool {
  match srv15_bmc_secret_versions_fold(
    project: fleet_secrets_gcp_project,
    secret: srv15_bmc_gunbc_secret_ref.secret,
    observed_by_run: srv15_versions_run_url(run_id: "12345"),
    answer: RestRefused { refusal: RestTransportRefused { cause: "dns-failure" as NonEmptyStr } },
  ) {
    Srv15SecretVersionsRefused { cause: c } =>
      string_contains(s: refusal_name(cause: c), pattern: "Srv15SecretReadTransportFailed")
    Srv15SecretVersionsAccepted { receipt: _ } => false
  }
}

// No workload identity is its own named cause too: the step refuses rather than asking with a
// different credential.
test fn srv15_versions_read_without_identity_refuses_by_name() -> Bool {
  match srv15_bmc_secret_versions_fold(
    project: fleet_secrets_gcp_project,
    secret: srv15_bmc_gunbc_secret_ref.secret,
    observed_by_run: srv15_versions_run_url(run_id: "12345"),
    answer: RestRefused {
      refusal: RestCredentialRefused {
        refusal: AccessRefusal {
          cause: AccessEvidenceAbsent { evidence: "srv15-arrival job identity" },
          location: AccessRefusalLocation {
            profile: "srv15-bmc-versions-read",
            subject: "github-iam-converge-job",
            action: "secretmanager.versions.list",
            object: "projects/gunbai-secrets/secrets/bmc-srv15-admin",
          },
        },
      },
    },
  ) {
    Srv15SecretVersionsRefused { cause: c } =>
      string_contains(s: refusal_name(cause: c), pattern: "Srv15SecretReadCredentialRefused")
    Srv15SecretVersionsAccepted { receipt: _ } => false
  }
}

// A 200 whose body failed typed decoding is NOT an empty population and not a success: unreadable.
test fn srv15_versions_read_undecodable_body_refuses_unreadable() -> Bool {
  match srv15_bmc_secret_versions_fold(
    project: fleet_secrets_gcp_project,
    secret: srv15_bmc_gunbc_secret_ref.secret,
    observed_by_run: srv15_versions_run_url(run_id: "12345"),
    answer: RestRefused { refusal: RestBodyUndecodable { status: 200, cause: "expected object" as NonEmptyStr } },
  ) {
    Srv15SecretVersionsRefused { cause: c } => refusal_name(cause: c) == "Srv15SecretReadResponseUnreadable"
    Srv15SecretVersionsAccepted { receipt: _ } => false
  }
}

// A status this read was never ruled to fold (here 500) is refused, not defaulted: a port that
// cannot establish its effect refuses; it never answers yes.
test fn srv15_versions_read_unmapped_status_refuses() -> Bool {
  match srv15_bmc_secret_versions_fold(
    project: fleet_secrets_gcp_project,
    secret: srv15_bmc_gunbc_secret_ref.secret,
    observed_by_run: srv15_versions_run_url(run_id: "12345"),
    answer: RestRefused { refusal: RestStatusRefused { status: 500, body: "{}" } },
  ) {
    Srv15SecretVersionsRefused { cause: c } => refusal_name(cause: c) == "Srv15SecretReadResponseUnreadable"
    Srv15SecretVersionsAccepted { receipt: _ } => false
  }
}

// The artifact's canonical bytes name the STANDING's secret under the standing's project — the
// pin's locator (versions/<n>) is findable in the artifact, and the step cannot have read a
// different secret than the standing names.
test fn srv15_versions_receipt_json_names_the_standing_secret() -> Bool {
  string_contains(s: srv15_versions_wire_name(), pattern: "projects/gunbai-secrets/secrets/bmc-srv15-admin")
    && string_contains(
      s: srv15_versions_receipt_json(receipt: Srv15BmcSecretVersionsReceipt {
        project: fleet_secrets_gcp_project,
        secret: srv15_bmc_gunbc_secret_ref.secret,
        versions: [Srv15SecretVersionRow { number: "7", state: SmEnabled, create_time: "2026-11-01T00:00:00Z" }],
        observed_by_run: "https://github.com/gunb-ai/gunbc/actions/runs/12345" as NonEmptyStr,
      }),
      pattern: "\"versions\":[{\"name\":\"projects/gunbai-secrets/secrets/bmc-srv15-admin/versions/7\",\"state\":\"ENABLED\"",
    )
}

// EIGHT NAMED CAUSES, EIGHT DISTINCT NAMES: the step's log always says which law fired, so a
// refusal can never masquerade as another (a collapsed pair would let permission-denied be read
// as absence, whose fix — create the secret — is not the grant fix).
test fn srv15_versions_refusal_names_are_eight_distinct_laws() -> Bool {
  length(
    distinct_names(causes: [
      Srv15SecretReadCredentialRefused { detail: "a" },
      Srv15SecretReadTransportFailed { cause: "b" as NonEmptyStr },
      Srv15SecretReadPermissionDenied { http_status: 403, message: "c" },
      Srv15SecretReadSecretAbsent { http_status: 404, message: "d" },
      Srv15SecretReadResponseUnreadable { detail: "e" },
      Srv15SecretReadPaginated { rows_seen: 1 },
      Srv15SecretReadNoEnabledVersion { rows_seen: 2 },
      Srv15SecretReadAmbiguousEnabledVersion { enabled_numbers: ["7", "9"] },
    ])
  ) == 8
}

fn distinct_names(causes: List<Srv15SecretVersionsReadRefusal>) -> List<String> {
  match causes {
    Empty => []
    Cons { head: head, tail: tail } =>
      match distinct_names(causes: tail) {
        rest =>
          match any(rest, n => n == refusal_name(cause: head)) {
            true => rest
            false => list_append(xs: [refusal_name(cause: head)], ys: rest)
          }
      }
  }
}
