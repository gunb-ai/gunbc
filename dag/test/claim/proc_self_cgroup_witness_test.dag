module test.claim.proc_self_cgroup_witness

import extdeps.linux.proc_self_cgroup {
  read_unified_cgroup_membership,
  proc_self_cgroup_line_from_wire,
  CurrentCgroupObserved,
  MembershipMissing,
  MembershipAmbiguous,
  MembershipMalformed,
  ProcSelfCgroupLineParsed,
  ProcSelfCgroupLineRefused,
  ProcSelfCgroupLineMissingColon,
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data fixture_unified_single: String = "0::/user.slice/user-1000.slice/session-3.scope\n"

data fixture_unified_colon_in_path: String = "0::/user.slice/job:build/session.scope\n"

data fixture_unified_duplicate: String = "0::/first.path\n0::/second.path\n"

data fixture_malformed_no_colon: String = "garbage-line\n"

data fixture_missing_unified: String = "1:memory:/legacy.path\n"

test fn proc_self_cgroup_unified_single_membership_holds() -> Bool {
  match read_unified_cgroup_membership(content: fixture_unified_single) {
    CurrentCgroupObserved { relative_path: path } =>
      path as String == "/user.slice/user-1000.slice/session-3.scope"
    MembershipMissing => false
    MembershipAmbiguous { first: _, second: _ } => false
    MembershipMalformed { cause: _ } => false
  }
}

test fn proc_self_cgroup_colon_in_path_not_truncated_holds() -> Bool {
  match read_unified_cgroup_membership(content: fixture_unified_colon_in_path) {
    CurrentCgroupObserved { relative_path: path } =>
      path as String == "/user.slice/job:build/session.scope"
    MembershipMissing => false
    MembershipAmbiguous { first: _, second: _ } => false
    MembershipMalformed { cause: _ } => false
  }
}

test fn proc_self_cgroup_missing_is_distinct_holds() -> Bool {
  match read_unified_cgroup_membership(content: fixture_missing_unified) {
    MembershipMissing => true
    CurrentCgroupObserved { relative_path: _ } => false
    MembershipAmbiguous { first: _, second: _ } => false
    MembershipMalformed { cause: _ } => false
  }
}

test fn proc_self_cgroup_ambiguous_is_distinct_holds() -> Bool {
  match read_unified_cgroup_membership(content: fixture_unified_duplicate) {
    MembershipAmbiguous { first: f, second: s } =>
      (f as String == "/first.path") && (s as String == "/second.path")
    MembershipMissing => false
    CurrentCgroupObserved { relative_path: _ } => false
    MembershipMalformed { cause: _ } => false
  }
}

test fn proc_self_cgroup_malformed_is_distinct_holds() -> Bool {
  match read_unified_cgroup_membership(content: fixture_malformed_no_colon) {
    MembershipMalformed { cause: ProcSelfCgroupLineMissingColon } => true
    MembershipMissing => false
    MembershipAmbiguous { first: _, second: _ } => false
    CurrentCgroupObserved { relative_path: _ } => false
  }
}

test fn proc_self_cgroup_line_parse_splits_on_second_colon_only_holds() -> Bool {
  match proc_self_cgroup_line_from_wire(line: "0::/foo:bar/baz") {
    ProcSelfCgroupLineParsed { hierarchy_id: hid, controller_list: _, relative_path: path } =>
      (hid as String == "0") && (path as String == "/foo:bar/baz")
    ProcSelfCgroupLineRefused { cause: _ } => false
  }
}
