module test.claim.proc_self_cgroup_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data fixture_unified_single: String = "0::/user.slice/user-1000.slice/session-3.scope\n"

data fixture_unified_colon_in_path: String = "0::/user.slice/job:build/session.scope\n"

data fixture_unified_duplicate: String = "0::/first.path\n0::/second.path\n"

data fixture_malformed_no_colon: String = "garbage-line\n"

data fixture_missing_unified: String = "1:memory:/legacy.path\n"

data fixture_hierarchy_zero_nonempty_controller: String = "0:cpu:/sys/fs/cgroup\n"

data cgroup_mount_root: std.types.FilePathParts = std.types.FilePathParts { segments: ["sys", "fs", "cgroup"] }

data cgroup_walk_var: std.types.NonEmptyStr = "d" as std.types.NonEmptyStr

data cgroup_shell_witness_note: String = "Compile-time witnesses route through v2.extdeps.languages.bash_proc_self_cgroup bash_membership_assign_from_content (read_unified_cgroup_membership then outcome lowering). Executing shell fixtures for missing/ambiguous/malformed/observed live in test.claim.proc_self_cgroup_real_execution_witness (bin_witness_wet_entries). PERMANENT CROSS-REALIZATION FIXTURE LAW: unified_membership_outcome_tag_from_content(fixture) must equal the executed Bash realization outcome tag for the same fixture; mutation sketches below prove drift in either implementation reds."

data cross_realization_fixture_law_note: String = "The four canonical fixtures are the closed subject universe for parser-vs-bash agreement. Each law row asserts only the parser-side tag; the wet execution witnesses in proc_self_cgroup_real_execution_witness join the same tags after shell.Exec.Run."

test fn cross_realization_fixture_law_missing_holds() -> Bool {
  match extdeps.linux.proc_self_cgroup.unified_membership_outcome_tag_from_content(content: fixture_missing_unified) {
    extdeps.linux.proc_self_cgroup.OutcomeTagMissing => true
    _ => false
  }
}

test fn cross_realization_fixture_law_ambiguous_holds() -> Bool {
  match extdeps.linux.proc_self_cgroup.unified_membership_outcome_tag_from_content(content: fixture_unified_duplicate) {
    extdeps.linux.proc_self_cgroup.OutcomeTagAmbiguous => true
    _ => false
  }
}

test fn cross_realization_fixture_law_malformed_holds() -> Bool {
  match extdeps.linux.proc_self_cgroup.unified_membership_outcome_tag_from_content(content: fixture_malformed_no_colon) {
    extdeps.linux.proc_self_cgroup.OutcomeTagMalformed => true
    _ => false
  }
}

test fn cross_realization_fixture_law_observed_holds() -> Bool {
  match extdeps.linux.proc_self_cgroup.unified_membership_outcome_tag_from_content(content: fixture_unified_colon_in_path) {
    extdeps.linux.proc_self_cgroup.OutcomeTagObserved { relative_path: path } =>
      path as String == "/user.slice/job:build/session.scope"
    _ => false
  }
}

test fn cross_realization_parser_branch_mutation_red_control_holds() -> Bool {
  !extdeps.linux.proc_self_cgroup.unified_membership_outcome_tag_eq(
    a: extdeps.linux.proc_self_cgroup.unified_membership_outcome_tag_from_content(
      content: fixture_hierarchy_zero_nonempty_controller,
    ),
    b: extdeps.linux.proc_self_cgroup.unified_membership_outcome_tag(
      record: extdeps.linux.proc_self_cgroup.read_unified_cgroup_membership_drift_sketch(
        content: fixture_hierarchy_zero_nonempty_controller,
      ),
    ),
  )
}

test fn cross_realization_bash_branch_mutation_red_control_holds() -> Bool {
  let authority = v2.extdeps.languages.bash_proc_self_cgroup.bash_membership_runtime_scan_loop
  let drifted = v2.extdeps.languages.bash_proc_self_cgroup.bash_membership_runtime_scan_loop_drift_sketch
  string_contains(s: authority, pattern: "[ -z \"$_cg_ctl\" ]")
    && !string_contains(s: drifted, pattern: "[ -z \"$_cg_ctl\" ]")
    && string_contains(s: drifted, pattern: "[ \"$_cg_h\" = \"0\" ]; then")
}

test fn proc_self_cgroup_unified_single_membership_holds() -> Bool {
  match extdeps.linux.proc_self_cgroup.read_unified_cgroup_membership(content: fixture_unified_single) {
    extdeps.linux.proc_self_cgroup.CurrentCgroupObserved { relative_path: path } =>
      path as String == "/user.slice/user-1000.slice/session-3.scope"
    extdeps.linux.proc_self_cgroup.MembershipMissing => false
    extdeps.linux.proc_self_cgroup.MembershipAmbiguous { first: _, second: _ } => false
    extdeps.linux.proc_self_cgroup.MembershipMalformed { cause: _ } => false
  }
}

test fn proc_self_cgroup_colon_in_path_not_truncated_holds() -> Bool {
  match extdeps.linux.proc_self_cgroup.read_unified_cgroup_membership(content: fixture_unified_colon_in_path) {
    extdeps.linux.proc_self_cgroup.CurrentCgroupObserved { relative_path: path } =>
      path as String == "/user.slice/job:build/session.scope"
    extdeps.linux.proc_self_cgroup.MembershipMissing => false
    extdeps.linux.proc_self_cgroup.MembershipAmbiguous { first: _, second: _ } => false
    extdeps.linux.proc_self_cgroup.MembershipMalformed { cause: _ } => false
  }
}

test fn proc_self_cgroup_missing_is_distinct_holds() -> Bool {
  match extdeps.linux.proc_self_cgroup.read_unified_cgroup_membership(content: fixture_missing_unified) {
    extdeps.linux.proc_self_cgroup.MembershipMissing => true
    extdeps.linux.proc_self_cgroup.CurrentCgroupObserved { relative_path: _ } => false
    extdeps.linux.proc_self_cgroup.MembershipAmbiguous { first: _, second: _ } => false
    extdeps.linux.proc_self_cgroup.MembershipMalformed { cause: _ } => false
  }
}

test fn proc_self_cgroup_ambiguous_is_distinct_holds() -> Bool {
  match extdeps.linux.proc_self_cgroup.read_unified_cgroup_membership(content: fixture_unified_duplicate) {
    extdeps.linux.proc_self_cgroup.MembershipAmbiguous { first: f, second: s } =>
      (f as String == "/first.path") && (s as String == "/second.path")
    extdeps.linux.proc_self_cgroup.MembershipMissing => false
    extdeps.linux.proc_self_cgroup.CurrentCgroupObserved { relative_path: _ } => false
    extdeps.linux.proc_self_cgroup.MembershipMalformed { cause: _ } => false
  }
}

test fn proc_self_cgroup_malformed_is_distinct_holds() -> Bool {
  match extdeps.linux.proc_self_cgroup.read_unified_cgroup_membership(content: fixture_malformed_no_colon) {
    extdeps.linux.proc_self_cgroup.MembershipMalformed { cause: extdeps.linux.proc_self_cgroup.ProcSelfCgroupLineMissingColon } => true
    extdeps.linux.proc_self_cgroup.MembershipMissing => false
    extdeps.linux.proc_self_cgroup.MembershipAmbiguous { first: _, second: _ } => false
    extdeps.linux.proc_self_cgroup.CurrentCgroupObserved { relative_path: _ } => false
  }
}

test fn proc_self_cgroup_hierarchy_zero_nonempty_controller_not_unified_holds() -> Bool {
  match extdeps.linux.proc_self_cgroup.read_unified_cgroup_membership(content: fixture_hierarchy_zero_nonempty_controller) {
    extdeps.linux.proc_self_cgroup.CurrentCgroupObserved { relative_path: _ } => false
    extdeps.linux.proc_self_cgroup.MembershipMissing => true
    extdeps.linux.proc_self_cgroup.MembershipAmbiguous { first: _, second: _ } => false
    extdeps.linux.proc_self_cgroup.MembershipMalformed { cause: _ } => false
  }
}

test fn proc_self_cgroup_unified_v2_requires_empty_controller_field_holds() -> Bool {
  !extdeps.linux.proc_self_cgroup.proc_self_cgroup_is_unified_v2_line(
    hierarchy_id: "0" as std.types.NonEmptyStr,
    controller_list: "cpu",
  )
}

test fn proc_self_cgroup_line_parse_splits_on_second_colon_only_holds() -> Bool {
  match extdeps.linux.proc_self_cgroup.proc_self_cgroup_line_from_wire(line: "0::/foo:bar/baz") {
    extdeps.linux.proc_self_cgroup.ProcSelfCgroupLineParsed { hierarchy_id: hid, controller_list: ctl, relative_path: path } =>
      (hid as String == "0") && (ctl == "") && (path as String == "/foo:bar/baz")
    extdeps.linux.proc_self_cgroup.ProcSelfCgroupLineRefused { cause: _ } => false
  }
}

test fn proc_self_cgroup_three_refusal_states_are_distinct_holds() -> Bool {
  (match extdeps.linux.proc_self_cgroup.read_unified_cgroup_membership(content: fixture_missing_unified) {
    extdeps.linux.proc_self_cgroup.MembershipMissing => true
    _ => false
  })
    && (match extdeps.linux.proc_self_cgroup.read_unified_cgroup_membership(content: fixture_unified_duplicate) {
      extdeps.linux.proc_self_cgroup.MembershipAmbiguous { first: _, second: _ } => true
      _ => false
    })
    && (match extdeps.linux.proc_self_cgroup.read_unified_cgroup_membership(content: fixture_malformed_no_colon) {
      extdeps.linux.proc_self_cgroup.MembershipMalformed { cause: _ } => true
      _ => false
    })
}

test fn bash_assign_from_content_matches_record_for_observed_holds() -> Bool {
  let record = extdeps.linux.proc_self_cgroup.read_unified_cgroup_membership(content: fixture_unified_single)
  v2.extdeps.languages.bash_proc_self_cgroup.bash_membership_assign_from_content(
    content: fixture_unified_single,
    walk_var: cgroup_walk_var,
    mount_root: cgroup_mount_root,
  ) == v2.extdeps.languages.bash_proc_self_cgroup.bash_membership_assign_from_record(
    record: record,
    walk_var: cgroup_walk_var,
    mount_root: cgroup_mount_root,
  )
}

test fn bash_assign_from_content_refuses_missing_holds() -> Bool {
  v2.extdeps.languages.bash_proc_self_cgroup.bash_membership_assign_from_content(
    content: fixture_missing_unified,
    walk_var: cgroup_walk_var,
    mount_root: cgroup_mount_root,
  ) == v2.extdeps.languages.bash_proc_self_cgroup.bash_membership_assign_from_record(
    record: extdeps.linux.proc_self_cgroup.MembershipMissing,
    walk_var: cgroup_walk_var,
    mount_root: cgroup_mount_root,
  )
}

test fn bash_assign_from_content_refuses_ambiguous_holds() -> Bool {
  let record = extdeps.linux.proc_self_cgroup.read_unified_cgroup_membership(content: fixture_unified_duplicate)
  match record {
    extdeps.linux.proc_self_cgroup.MembershipAmbiguous { first: _, second: _ } =>
      v2.extdeps.languages.bash_proc_self_cgroup.bash_membership_assign_from_content(
        content: fixture_unified_duplicate,
        walk_var: cgroup_walk_var,
        mount_root: cgroup_mount_root,
      ) == v2.extdeps.languages.bash_proc_self_cgroup.bash_membership_assign_from_record(
        record: record,
        walk_var: cgroup_walk_var,
        mount_root: cgroup_mount_root,
      )
    _ => false
  }
}

test fn bash_assign_from_content_refuses_malformed_holds() -> Bool {
  let record = extdeps.linux.proc_self_cgroup.read_unified_cgroup_membership(content: fixture_malformed_no_colon)
  match record {
    extdeps.linux.proc_self_cgroup.MembershipMalformed { cause: _ } =>
      v2.extdeps.languages.bash_proc_self_cgroup.bash_membership_assign_from_content(
        content: fixture_malformed_no_colon,
        walk_var: cgroup_walk_var,
        mount_root: cgroup_mount_root,
      ) == v2.extdeps.languages.bash_proc_self_cgroup.bash_membership_assign_from_record(
        record: record,
        walk_var: cgroup_walk_var,
        mount_root: cgroup_mount_root,
      )
    _ => false
  }
}

test fn bash_assign_from_source_has_no_grep_c_or_head_or_widen_holds() -> Bool {
  let cmd = v2.extdeps.languages.bash_proc_self_cgroup.bash_membership_assign_from_source(
    cgroup_source: "/proc/self/cgroup",
    walk_var: cgroup_walk_var,
    mount_root: cgroup_mount_root,
  )
  !string_contains(s: cmd, pattern: "grep -c")
    && !string_contains(s: cmd, pattern: "head -1")
    && !string_contains(s: cmd, pattern: "awk -F:")
    && !string_contains(s: cmd, pattern: "d=\"/sys/fs/cgroup\"")
}

test fn bash_assign_from_source_preserves_refusal_markers_holds() -> Bool {
  let cmd = v2.extdeps.languages.bash_proc_self_cgroup.bash_membership_assign_from_source(
    cgroup_source: "/proc/self/cgroup",
    walk_var: cgroup_walk_var,
    mount_root: cgroup_mount_root,
  )
  string_contains(s: cmd, pattern: "cgroup_membership=malformed")
    && string_contains(s: cmd, pattern: "cgroup_membership=missing")
    && string_contains(s: cmd, pattern: "cgroup_membership=ambiguous")
}

data cgroup_locate_spec: std.path_intent.NearestAncestorContaining = std.path_intent.NearestAncestorContaining {
  start: std.path_intent.PathRefStart { name: cgroup_walk_var },
  stop_before: cgroup_mount_root,
  relative_entry: std.types.FilePathParts { segments: ["memory.peak"] },
  expected_kind: std.filesystem.types.RegularFile,
}

test fn cgroup_locate_assign_preserves_membership_refusals_holds() -> Bool {
  let cmd = v2.extdeps.languages.bash_orch_if.bash_nearest_ancestor_locate_assign_command(spec: cgroup_locate_spec)
  string_contains(s: cmd, pattern: "cgroup_membership=malformed")
    && string_contains(s: cmd, pattern: "cgroup_membership=missing")
    && string_contains(s: cmd, pattern: "cgroup_membership=ambiguous")
    && !string_contains(s: cmd, pattern: "grep -c")
    && !string_contains(s: cmd, pattern: "head -1")
    && !string_contains(s: cmd, pattern: "awk -F:")
    && !string_contains(s: cmd, pattern: "d=\"/sys/fs/cgroup\"")
}

test fn cgroup_locate_assign_uses_runtime_scan_not_sed_holds() -> Bool {
  let cmd = v2.extdeps.languages.bash_orch_if.bash_nearest_ancestor_locate_assign_command(spec: cgroup_locate_spec)
  string_contains(s: cmd, pattern: "_cg_n=0")
    && string_contains(s: cmd, pattern: "[ \"$_cg_h\" = \"0\" ]")
    && string_contains(s: cmd, pattern: "d=\"/sys/fs/cgroup$_cg_rel\"")
}

test fn cgroup_locate_cond_preserves_predicate_shape_holds() -> Bool {
  let cmd = v2.extdeps.languages.bash_orch_if.bash_nearest_ancestor_locate_cond_command(spec: cgroup_locate_spec)
  string_contains(s: cmd, pattern: "[ -n \"$d\" ]")
    && string_contains(s: cmd, pattern: "[ \"$d\" != \"/sys/fs/cgroup\" ]")
    && string_contains(s: cmd, pattern: "! [ -f \"$d/memory.peak\" ]")
}

test fn cgroup_locate_body_preserves_ascent_holds() -> Bool {
  let cmd = v2.extdeps.languages.bash_orch_if.bash_nearest_ancestor_locate_body_command(spec: cgroup_locate_spec)
  cmd == "d=$(dirname \"$d\")"
}

test fn nearest_ancestor_predicate_uses_regular_file_peak_holds() -> Bool {
  match std.path_intent.nearest_ancestor_while_predicate(spec: cgroup_locate_spec) {
    std.path_intent.And { lhs: _, rhs: std.path_intent.And { lhs: _, rhs: std.path_intent.Not { inner: PathEntryKind { path: _, kind: std.filesystem.types.RegularFile } } } } => true
    _ => false
  }
}
