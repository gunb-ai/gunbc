module test.claim.proc_self_cgroup_witness

import extdeps.linux.proc_self_cgroup {
  read_unified_cgroup_membership,
  proc_self_cgroup_line_from_wire,
  proc_self_cgroup_is_unified_v2_line,
  bash_membership_assign_from_content,
  bash_membership_assign_from_source,
  bash_membership_assign_from_record,
  CurrentCgroupObserved,
  MembershipMissing,
  MembershipAmbiguous,
  MembershipMalformed,
  ProcSelfCgroupLineParsed,
  ProcSelfCgroupLineRefused,
  ProcSelfCgroupLineMissingColon,
}
import v2.extdeps.languages.bash_orch_if {
  bash_nearest_ancestor_locate_assign_command,
  bash_nearest_ancestor_locate_cond_command,
  bash_nearest_ancestor_locate_body_command,
}
import std.path_intent {
  NearestAncestorContaining,
  PathRefStart,
  And,
  Not,
  nearest_ancestor_while_predicate,
}
import std.filesystem.types { RegularFile }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.types { FilePathParts, NonEmptyStr }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data fixture_unified_single: String = "0::/user.slice/user-1000.slice/session-3.scope\n"

data fixture_unified_colon_in_path: String = "0::/user.slice/job:build/session.scope\n"

data fixture_unified_duplicate: String = "0::/first.path\n0::/second.path\n"

data fixture_malformed_no_colon: String = "garbage-line\n"

data fixture_missing_unified: String = "1:memory:/legacy.path\n"

data fixture_hierarchy_zero_nonempty_controller: String = "0:cpu:/sys/fs/cgroup\n"

data cgroup_mount_root: FilePathParts = FilePathParts { segments: ["sys", "fs", "cgroup"] }

data cgroup_walk_var: NonEmptyStr = "d" as NonEmptyStr

data cgroup_shell_witness_note: String = "Compile-time witnesses route through bash_membership_assign_from_content (read_unified_cgroup_membership then outcome lowering). Executing shell fixtures for missing/ambiguous/malformed/observed live in test.claim.proc_self_cgroup_real_execution_witness (bin_witness_wet_entries)."

test fn proc_self_cgroup_unified_single_membership_holds() -> Bool {
  match read_unified_cgroup_membership(content: fixture_unified_single) {
    CurrentCgroupObserved { relative_path: path } =>
      path as String == "/user.slice/user-1000.slice/session-3.scope"
    MembershipMissing => false
    MembershipAmbiguous { first: _, second: _ } => false
    MembershipMalformed { cause: _ } => false
  }
}

test fn proc_self_cgroup_colon_in_path_not_truncated_holds() -> Bool {
  match read_unified_cgroup_membership(content: fixture_unified_colon_in_path) {
    CurrentCgroupObserved { relative_path: path } =>
      path as String == "/user.slice/job:build/session.scope"
    MembershipMissing => false
    MembershipAmbiguous { first: _, second: _ } => false
    MembershipMalformed { cause: _ } => false
  }
}

test fn proc_self_cgroup_missing_is_distinct_holds() -> Bool {
  match read_unified_cgroup_membership(content: fixture_missing_unified) {
    MembershipMissing => true
    CurrentCgroupObserved { relative_path: _ } => false
    MembershipAmbiguous { first: _, second: _ } => false
    MembershipMalformed { cause: _ } => false
  }
}

test fn proc_self_cgroup_ambiguous_is_distinct_holds() -> Bool {
  match read_unified_cgroup_membership(content: fixture_unified_duplicate) {
    MembershipAmbiguous { first: f, second: s } =>
      (f as String == "/first.path") && (s as String == "/second.path")
    MembershipMissing => false
    CurrentCgroupObserved { relative_path: _ } => false
    MembershipMalformed { cause: _ } => false
  }
}

test fn proc_self_cgroup_malformed_is_distinct_holds() -> Bool {
  match read_unified_cgroup_membership(content: fixture_malformed_no_colon) {
    MembershipMalformed { cause: ProcSelfCgroupLineMissingColon } => true
    MembershipMissing => false
    MembershipAmbiguous { first: _, second: _ } => false
    CurrentCgroupObserved { relative_path: _ } => false
  }
}

test fn proc_self_cgroup_hierarchy_zero_nonempty_controller_not_unified_holds() -> Bool {
  match read_unified_cgroup_membership(content: fixture_hierarchy_zero_nonempty_controller) {
    CurrentCgroupObserved { relative_path: _ } => false
    MembershipMissing => true
    MembershipAmbiguous { first: _, second: _ } => false
    MembershipMalformed { cause: _ } => false
  }
}

test fn proc_self_cgroup_unified_v2_requires_empty_controller_field_holds() -> Bool {
  !proc_self_cgroup_is_unified_v2_line(
    hierarchy_id: "0" as NonEmptyStr,
    controller_list: "cpu",
  )
}

test fn proc_self_cgroup_line_parse_splits_on_second_colon_only_holds() -> Bool {
  match proc_self_cgroup_line_from_wire(line: "0::/foo:bar/baz") {
    ProcSelfCgroupLineParsed { hierarchy_id: hid, controller_list: ctl, relative_path: path } =>
      (hid as String == "0") && (ctl == "") && (path as String == "/foo:bar/baz")
    ProcSelfCgroupLineRefused { cause: _ } => false
  }
}

test fn proc_self_cgroup_three_refusal_states_are_distinct_holds() -> Bool {
  (match read_unified_cgroup_membership(content: fixture_missing_unified) {
    MembershipMissing => true
    _ => false
  })
    && (match read_unified_cgroup_membership(content: fixture_unified_duplicate) {
      MembershipAmbiguous { first: _, second: _ } => true
      _ => false
    })
    && (match read_unified_cgroup_membership(content: fixture_malformed_no_colon) {
      MembershipMalformed { cause: _ } => true
      _ => false
    })
}

test fn bash_assign_from_content_matches_record_for_observed_holds() -> Bool {
  let record = read_unified_cgroup_membership(content: fixture_unified_single)
  bash_membership_assign_from_content(
    content: fixture_unified_single,
    walk_var: cgroup_walk_var,
    mount_root: cgroup_mount_root,
  ) == bash_membership_assign_from_record(
    record: record,
    walk_var: cgroup_walk_var,
    mount_root: cgroup_mount_root,
  )
}

test fn bash_assign_from_content_refuses_missing_holds() -> Bool {
  bash_membership_assign_from_content(
    content: fixture_missing_unified,
    walk_var: cgroup_walk_var,
    mount_root: cgroup_mount_root,
  ) == bash_membership_assign_from_record(
    record: MembershipMissing,
    walk_var: cgroup_walk_var,
    mount_root: cgroup_mount_root,
  )
}

test fn bash_assign_from_content_refuses_ambiguous_holds() -> Bool {
  let record = read_unified_cgroup_membership(content: fixture_unified_duplicate)
  match record {
    MembershipAmbiguous { first: _, second: _ } =>
      bash_membership_assign_from_content(
        content: fixture_unified_duplicate,
        walk_var: cgroup_walk_var,
        mount_root: cgroup_mount_root,
      ) == bash_membership_assign_from_record(
        record: record,
        walk_var: cgroup_walk_var,
        mount_root: cgroup_mount_root,
      )
    _ => false
  }
}

test fn bash_assign_from_content_refuses_malformed_holds() -> Bool {
  let record = read_unified_cgroup_membership(content: fixture_malformed_no_colon)
  match record {
    MembershipMalformed { cause: _ } =>
      bash_membership_assign_from_content(
        content: fixture_malformed_no_colon,
        walk_var: cgroup_walk_var,
        mount_root: cgroup_mount_root,
      ) == bash_membership_assign_from_record(
        record: record,
        walk_var: cgroup_walk_var,
        mount_root: cgroup_mount_root,
      )
    _ => false
  }
}

test fn bash_assign_from_source_has_no_grep_c_or_head_or_widen_holds() -> Bool {
  let cmd = bash_membership_assign_from_source(
    cgroup_source: "/proc/self/cgroup",
    walk_var: cgroup_walk_var,
    mount_root: cgroup_mount_root,
  )
  !string_contains(s: cmd, pattern: "grep -c")
    && !string_contains(s: cmd, pattern: "head -1")
    && !string_contains(s: cmd, pattern: "awk -F:")
    && !string_contains(s: cmd, pattern: "d=\"/sys/fs/cgroup\"")
}

test fn bash_assign_from_source_preserves_refusal_markers_holds() -> Bool {
  let cmd = bash_membership_assign_from_source(
    cgroup_source: "/proc/self/cgroup",
    walk_var: cgroup_walk_var,
    mount_root: cgroup_mount_root,
  )
  string_contains(s: cmd, pattern: "cgroup_membership=malformed")
    && string_contains(s: cmd, pattern: "cgroup_membership=missing")
    && string_contains(s: cmd, pattern: "cgroup_membership=ambiguous")
}

data cgroup_locate_spec: NearestAncestorContaining = NearestAncestorContaining {
  start: PathRefStart { name: cgroup_walk_var },
  stop_before: cgroup_mount_root,
  relative_entry: FilePathParts { segments: ["memory.peak"] },
  expected_kind: RegularFile,
}

test fn cgroup_locate_assign_preserves_membership_refusals_holds() -> Bool {
  let cmd = bash_nearest_ancestor_locate_assign_command(spec: cgroup_locate_spec)
  string_contains(s: cmd, pattern: "cgroup_membership=malformed")
    && string_contains(s: cmd, pattern: "cgroup_membership=missing")
    && string_contains(s: cmd, pattern: "cgroup_membership=ambiguous")
    && !string_contains(s: cmd, pattern: "grep -c")
    && !string_contains(s: cmd, pattern: "head -1")
    && !string_contains(s: cmd, pattern: "awk -F:")
    && !string_contains(s: cmd, pattern: "d=\"/sys/fs/cgroup\"")
}

test fn cgroup_locate_assign_uses_runtime_scan_not_sed_holds() -> Bool {
  let cmd = bash_nearest_ancestor_locate_assign_command(spec: cgroup_locate_spec)
  string_contains(s: cmd, pattern: "_cg_n=0")
    && string_contains(s: cmd, pattern: "[ \"$_cg_h\" = \"0\" ]")
    && string_contains(s: cmd, pattern: "d=\"/sys/fs/cgroup$_cg_rel\"")
}

test fn cgroup_locate_cond_preserves_predicate_shape_holds() -> Bool {
  let cmd = bash_nearest_ancestor_locate_cond_command(spec: cgroup_locate_spec)
  string_contains(s: cmd, pattern: "[ -n \"$d\" ]")
    && string_contains(s: cmd, pattern: "[ \"$d\" != \"/sys/fs/cgroup\" ]")
    && string_contains(s: cmd, pattern: "! [ -f \"$d/memory.peak\" ]")
}

test fn cgroup_locate_body_preserves_ascent_holds() -> Bool {
  let cmd = bash_nearest_ancestor_locate_body_command(spec: cgroup_locate_spec)
  cmd == "d=$(dirname \"$d\")"
}

test fn nearest_ancestor_predicate_uses_regular_file_peak_holds() -> Bool {
  match nearest_ancestor_while_predicate(spec: cgroup_locate_spec) {
    And { lhs: _, rhs: And { lhs: _, rhs: Not { inner: std.path_intent.PathEntryKind { path: _, kind: RegularFile } } } } => true
    _ => false
  }
}
