module test.claim.print_preparation_kernel_validation
import std.measure {micrometer_count}
import std.process {ProcessExit}
import product.printed_chassis.print_preparation {run_kernel,required_settings,deposited_path_edge_allowance_um}
import extdeps.languages.json.emit {serialize_json}
fn controls() -> String {join([
 "import tempfile,copy\n",
 "leading='G90\\nM83\\nG1 X10 Y10 Z.2\\n; CHANGE_LAYER\\n; FEATURE: Inner wall\\n; printing object X id:0\\nG1 X10.2 Y10 E.025\\n'\n",
 "p=toolpaths(leading)\n",
 "assert abs(p['extrusion']['Inner wall']-.025)<1e-9 and p['bounds']==[10.,10.,.2,10.2,10.,.2]\n",
 "assert p['object_bounds']['X']==[10.,10.,.2,10.2,10.,.2] and p['support_geometry']==dict()\n",
 "support=leading+'; FEATURE: Support\\nG1 X12 Y10 Z1 E.25\\n; FEATURE: Support interface\\nG2 X12 Y10 I-1 J0 E.5\\n'\n",
 "sp=toolpaths(support)\n",
 "assert len(sp['support_geometry']['X'])==2 and sp['support_geometry']['X'][1]['center_xy_mm']==[11.,10.]\n",
 "assert sp['object_bounds']['X'][5]==1. and sp['supports']['X']==.75\n",
 "circle='G90\\nM83\\nG1 X20 Y10 Z.2\\n; CHANGE_LAYER\\nG2 X20 Y10 I-5 J0 E.5\\n'\n",
 "p=toolpaths(circle)\n",
 "assert p['bounds']==[10.,5.,.2,20.,15.,.2],p\n",
 "\n",
 "def must_refuse(f):\n",
 "    try:f()\n",
 "    except (AssertionError,ValueError,KeyError):return\n",
 "    raise AssertionError('Negative control admitted')\n",
 "must_refuse(lambda:toolpaths(leading+'G1 Xnan Y10 E.5\\n'))\n",
 "must_refuse(lambda:toolpaths(leading+'G2 X10 Y10 R4 E.5\\n'))\n",
 "\n",
 "def fixture(path, g=leading, second=False, object_name='X', transform='1 0 0 0 1 0 0 0 1 0 0 0', bad_digest=False, overrides=None):\n",
 "    with zipfile.ZipFile(path,'w') as z:\n",
 "        z.writestr('Metadata/plate_1.gcode',g)\n",
 "        z.writestr('Metadata/plate_1.gcode.md5','wrong' if bad_digest else hashlib.md5(g.encode()).hexdigest())\n",
 "        if second:z.writestr('Metadata/plate_2.gcode',g)\n",
 "        z.writestr('Metadata/project_settings.config',json.dumps(dict(requirements,**(overrides or dict()))))\n",
 "        z.writestr('Metadata/plate_1.json',json.dumps(\{'filament_ids':[0]\}))\n",
 "        z.writestr('Metadata/slice_info.config','<config><plate><metadata key=\"outside\" value=\"false\"/><metadata key=\"prediction\" value=\"1\"/><metadata key=\"weight\" value=\"1\"/><object name=\"'+object_name+'\" skipped=\"false\"/></plate></config>')\n",
 "        z.writestr('3D/3dmodel.model','<model unit=\"millimeter\"><build><item transform=\"'+transform+'\"/></build></model>')\n",
 "with tempfile.TemporaryDirectory() as d:\n",
 "    p=pathlib.Path(d)/'fixture.3mf'\n",
 "    def check():return readback(p,['X'],requirements,[180,180,180],['X'],[],edge_allowance_um)\n",
 "    fixture(p);assert check()['objects']==['X']\n",
 "    fixture(p,overrides=dict(enable_support='0'));must_refuse(check)\n",
 "    fixture(p,overrides=dict(support_top_z_distance='0.5'));must_refuse(check)\n",
 "    fixture(p,second=True);must_refuse(check)\n",
 "    fixture(p,object_name='Y');must_refuse(check)\n",
 "    fixture(p,transform='2 0 0 0 1 0 0 0 1 0 0 0');must_refuse(check)\n",
 "    fixture(p,bad_digest=True);must_refuse(check)\n",
 "    fixture(p,g=leading+'G1 X181 Y10 E.5\\n');must_refuse(check)\n",
 "    fixture(p,g=leading+'G1 X10 Y10 Z181 E.5\\n');must_refuse(check)\n",
 "    fixture(p,g=leading+'; FEATURE: Support\\nG1 X10.4 Y10 E.5\\n');must_refuse(check)\n",
 "print('PASS: leading-dot extrusion, full-circle bounds, valid archive; archive and support-policy refusal controls; per-object Z and separate support geometry')\n",
 "# Relative/absolute E must yield identical retraction evidence, including G92 and layer boundaries.\n",
 "def observed(body):return toolpaths('G90\\nG1 X10 Y10 Z.2 F600\\n; CHANGE_LAYER\\n; FEATURE: Inner wall\\n; printing object X id:0\\n'+body)['process_observation']\n",
 "relative=observed('M83\\nG1 X11 E.125\\nG1 E-.75 F1800\\nG92 E0\\n; CHANGE_LAYER\\nG1 X15 F600\\nG1 E.75 F1800\\nG1 X16 E.125 F600\\n')\n",
 "absolute=observed('M82\\nG1 X11 E.125\\nG1 E-.625 F1800\\nG92 E0\\n; CHANGE_LAYER\\nG1 X15 F600\\nG1 E.75 F1800\\nG1 X16 E.875 F600\\n')\n",
 "assert relative==absolute,(relative,absolute)\n",
 "a,b=relative['layers']\n",
 "assert a['negative_e_moves']==1 and a['retraction_episodes']==1 and abs(a['retracted_filament_mm']-.75)<1e-9\n",
 "assert b['nonextruding_xy_moves']==1 and b['deposition_runs_after_travel']==1 and b['recovered_filament_mm']==.75\n",
 "assert relative['unrecovered_filament_mm']==0 and b['objects']==['X']\n",
 "assert abs(b['commanded_motion_seconds']-(.4+.75/30+.1))<1e-9\n",
 "wipe=observed('M83\\nG1 X11 E.1\\nG1 X12 E-.4\\nG1 X13 E-.4\\nG1 E.8\\nG1 X14 E.1\\n')['layers'][0]\n",
 "assert wipe['negative_e_moves']==2 and wipe['retraction_episodes']==1 and wipe['negative_e_xy_moves']==2\n",
 "assert wipe['nonextruding_xy_moves']==2 and wipe['deposition_runs_after_travel']==1\n",
 "arc=toolpaths(circle.replace('E.5','E.5 F600'))['process_observation']['layers'][0]\n",
 "assert abs(arc['commanded_motion_seconds']-math.pi)<1e-9 and arc['unestimated_motion_moves']==0\n",
 "unknown=toolpaths(leading)['process_observation']['layers'][0]\n",
 "assert unknown['unestimated_motion_moves']==1\n",
 "firmware=observed('M83\\nG10\\nG11\\nG1 X11 E.1\\n')['layers'][0]\n",
 "assert firmware['firmware_retraction_commands']==2\n",
 "with tempfile.TemporaryDirectory() as d:\n",
 "    p=pathlib.Path(d)/'observed.3mf'\n",
 "    fixture(p,overrides=dict(retraction_length=['.8'],filament_retraction_length=['nil']))\n",
 "    admitted=readback(p,['X'],requirements,[180,180,180],['X'],[],edge_allowance_um)\n",
 "    retrospective=observe_archived_process(p)\n",
 "    assert admitted['sliced_project_settings']==retrospective['sliced_project_settings']\n",
 "    assert admitted['sliced_project_settings']['retraction_length']==['.8'] and admitted['sliced_project_settings']['filament_retraction_length']==['nil']\n",
 "    assert 'z_hop' not in admitted['sliced_project_settings']\n",
 "    assert admitted['paths']['process_observation']==retrospective['process_observation']\n",
 "    fixture(p,bad_digest=True);must_refuse(lambda:observe_archived_process(p))\n",
 "print('PASS: process observations, relative/absolute E, G92, cross-layer recovery, wipes, modal feed, arc time, unknown feed, firmware commands and admission/retrospective integration')\n",
],"")}
fn exercise_kernel(script:String) -> ProcessExit {
 run_kernel(script:script,call:join(["\nrequirements=",serialize_json(v:required_settings()),"\nedge_allowance_um=",to_string(micrometer_count(m: deposited_path_edge_allowance_um)),"\n",controls()],""))
}

fn run(script:String) -> ProcessExit {exercise_kernel(script:script)}
