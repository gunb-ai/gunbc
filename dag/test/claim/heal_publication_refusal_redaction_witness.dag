module test.claim.heal_publication_refusal_redaction_witness

// THE PUBLISH PATH'S REFUSAL TEXT CARRIES NO BODY, AND ONLY THE CAUSE THE HOST DECLARES FROM THE TYPE
// (redaction hardening, gunbc#15710; cause restoration after the 2026-11-10 heal-publish outage).
// gunbc.heal_publication rest_refusal_text is the one text every publish-path REST refusal reaches
// stderr through (exit_failure, via refused_exit, the readback refusals, the PR-state read and the
// receipt comment), including the not-fast-forward arm, which used to print the raw body directly.
// FAKE-SECRET-MARKER is planted where a credential or echoed request could sit. The undecodable arm is
// the one arm that keeps a cause, and it keeps it because the host mints it from the DECLARED type
// (src/v1/stage0/src/v1_interpreter.rs rest_response_declared_cause, whose own test plants
// FAKE-SECRET-MARKER in every body-derived payload and asserts it does not reach this text): the
// publisher had to read 'status 200 undecodable' with no cause for every PR it read while the
// interpreter knew the body failed at NoWireContract on PullRequestState.
import std.types { Bool, String }
import std.algebra { string_contains }
import extdeps.transports.rest { RestStatusRefused, RestTransportRefused, RestBodyUndecodable }
import gunbc.heal_publication { rest_refusal_text }

fn marker() -> String { "FAKE-SECRET-MARKER" }

fn carries_no_marker(text: String) -> Bool { !string_contains(s: text, pattern: marker()) }

// The shape v1_interpreter rest_response_declared_cause mints for the cause the 2026-11-10 outage
// printed: '<kind text> at <located DECLARED field> (coproduct <name>)'. The located field is part of the
// published text and not an accident of it -- every segment of that path is an authored name out of the
// declaration tree (decode_json_by_declared_field seeds it from authored_name_at of the declared field),
// so it carries no response content and it is what a refusal is diagnosed from. This is a RECORDED shape,
// so it must move with the renderer; the follow-up (named in the PR) asserts against the renderer itself
// instead of a string that can drift. The path spelling below is the pull field of the declared output
// record descending into PullRequest.state; what is pinned here is that a located field appears between
// the kind text and the coproduct, which is the property the publisher diagnoses from.
fn no_wire_contract_cause() -> String {
  "body did not inhabit the declared output: no CoproductWireContract row is realized for this coproduct and its module declares no wire_contract, so its wire spelling is undeclared at pull.state (coproduct PullRequestState)"
}

test fn witness_a_status_refusal_keeps_only_its_status() -> Bool {
  let t = rest_refusal_text(o: RestStatusRefused { status: 422, body: "{\"message\":\"Update is not a fast forward FAKE-SECRET-MARKER\"}" })
  t == "status 422" && carries_no_marker(text: t)
}

test fn witness_a_transport_refusal_withholds_its_cause() -> Bool {
  let t = rest_refusal_text(o: RestTransportRefused { cause: "https://api.github.com/?token=FAKE-SECRET-MARKER: connection reset" })
  t == "transport refused (cause withheld on a credential path)" && carries_no_marker(text: t)
}

test fn witness_an_undecodable_answer_publishes_the_declared_side_cause() -> Bool {
  let t = rest_refusal_text(o: RestBodyUndecodable { status: 200, cause: no_wire_contract_cause() })
  t == join(["status 200 undecodable (", no_wire_contract_cause(), ")"], "")
    && string_contains(s: t, pattern: "CoproductWireContract")
    && string_contains(s: t, pattern: "PullRequestState")
    && string_contains(s: t, pattern: " at pull.state ")
    && carries_no_marker(text: t)
}
