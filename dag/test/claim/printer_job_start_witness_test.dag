module test.claim.printer_job_start_witness_test

import std.types { Bool, String, NonEmptyStr, Secret, FilePath, List }
import extdeps.exec.command { argv_words }
import extdeps.oasis.mqtt {
  MqttQos, AtMostOnce, AtLeastOnce, ExactlyOnce, mqtt_qos_wire_level,
  MqttEndpoint, MqttOverTls,
}
import extdeps.printing.bambu_lab_lan_protocol {
  bambu_request_topic, bambu_report_topic, bambu_lan_mqtt_endpoint,
  bambu_start_command, bambu_start_payload_json, bambu_start_command_qos,
  bambu_lan_mqtt_user,
}
import extdeps.tools.mosquitto_pub { mosquitto_publish_command }
import gunbc.auth.mosquitto_options_binding { mosquitto_options_content }
import gunbc.fleet.printer_job_start {
  PrinterSerialLookup, PrinterSerialFound, PrinterSerialUnknown,
  PrinterSerialUnrecorded, PrinterSerialAmbiguous, printer_serial,
}
import gunbc.fleet_asset_identity { printer_01, printer_02, ams_01 }

// THE ARGV IS THE SUBJECT OF MOST OF THESE WITNESSES, because the guarantee this leg adds is a
// NEGATIVE one -- that a credential does not appear on a command line -- and a negative property is
// exactly the kind that a type name asserts and nothing checks. gunbc.credential_argv_exposure is a
// measured incident, not hygiene, so its regression control has to read the words that would be
// handed to execve rather than the shape of the function that built them.

data a_serial: NonEmptyStr = "0300CA660400324"
data another_serial: NonEmptyStr = "0300CA652201400"
data a_host: NonEmptyStr = "192.168.1.235"
data a_remote_name: NonEmptyStr = "gauge_container.3mf"
data a_ca_path: FilePath = "/tmp/fixture/printer_ca.pem" as FilePath

fn start_argv() -> List<String> {
  argv_words(command: mosquitto_publish_command(
    endpoint: bambu_lan_mqtt_endpoint(host: a_host),
    topic: bambu_request_topic(serial: a_serial) as NonEmptyStr,
    payload: bambu_start_payload_json(
      command: bambu_start_command(remote_name: a_remote_name), sequence_id: "1"),
    qos: bambu_start_command_qos,
    ca_bundle: a_ca_path))
}

// THE DISCRIMINATING RED: if anyone adds a credential parameter to the publish builder and renders
// it, one of these two words appears and this goes red. It is authorable today -- the flags exist on
// the real tool and a caller reaching for them is the likely edit -- which is what separates this
// from a check that is permanently green by construction.
test fn the_publish_argv_carries_no_credential_flag() -> Bool {
  let argv = start_argv()
  ((argv |> filter(w => w == "-P") |> length) == 0)
    && ((argv |> filter(w => w == "-u") |> length) == 0)
    && ((argv |> filter(w => w == "--pw-file") |> length) == 0)
}

// THE POSITIVE CONTROL FOR THE SAME PROBE. A witness that only asserts absence passes just as well
// when the argv is empty, when the builder returns a different command, or when the filter is
// looking at the wrong list -- so the same list must be shown to contain what it should.
test fn the_publish_argv_is_the_command_it_claims_to_be() -> Bool {
  let argv = start_argv()
  ((argv |> filter(w => w == "mosquitto_pub") |> length) == 1)
    && ((argv |> filter(w => w == "-t") |> length) == 1)
    && ((argv |> filter(w => w == a_host as String) |> length) == 1)
}

// VERIFICATION IS NOT OPTIONAL IN THE EMITTED ARGV. --cafile is what makes the chain check happen at
// all, and --insecure without it is the arm measured to fail with certificate verify failed. Both
// words being present is the shape that was proven to connect to a real printer.
test fn the_publish_argv_pins_a_ca() -> Bool {
  let argv = start_argv()
  ((argv |> filter(w => w == "--cafile") |> length) == 1)
    && ((argv |> filter(w => w == a_ca_path as String) |> length) == 1)
}

// THE CREDENTIAL LIVES IN THE OPTIONS FILE, AND BOTH HALVES OF IT DO. Splitting the login into argv
// and leaving only the password in the file would compile, would work, and would leave a reader of
// the command line believing the visible -u was how the tool authenticated.
test fn the_options_file_carries_both_halves_of_the_login() -> Bool {
  let content = mosquitto_options_content(
    login: bambu_lan_mqtt_user, password: "fixture-access-code" as Secret)
  string_contains(s: content, pattern: "-u bblp")
    && string_contains(s: content, pattern: "-P fixture-access-code")
}

// THE TOPIC IS KEYED ON THE SERIAL, so two machines never share one. This is the control for the
// hole the delivery module already found on its endpoint: two facts that must agree being free to
// disagree, which there would have fetched one printer's code and addressed the other.
test fn two_printers_do_not_share_a_request_topic() -> Bool {
  (bambu_request_topic(serial: a_serial) as String)
    != (bambu_request_topic(serial: another_serial) as String)
}

test fn the_request_topic_is_not_the_report_topic() -> Bool {
  (bambu_request_topic(serial: a_serial) as String)
    != (bambu_report_topic(serial: a_serial) as String)
}

// THE SERIAL IS RESOLVED FROM THE PRINTER ROSTER AND NOT FROM "ANY ASSET WITH A SERIAL", which is
// why the negative is the AMS rather than a host. ams_01 is a real asset, physically present, and it
// HAS a recorded physical_serial -- it is deliberately absent from owned_printer_inventory because
// its catalog is the AMS module rather than the A1 mini. So a lookup that joined on the wrong roster,
// or that fell back to the physical inventory when the printer roster missed, would find a serial
// here and pass. Picking an asset with no serial at all would have let both implementations through.
test fn a_non_printer_asset_resolves_no_serial() -> Bool {
  match printer_serial(printer: ams_01) {
    PrinterSerialUnknown { printer: _ } => true
    PrinterSerialFound { serial: _ } => false
    PrinterSerialUnrecorded { printer: _ } => false
    PrinterSerialAmbiguous { printer: _ } => false
  }
}

test fn printer_02_resolves_its_recorded_serial() -> Bool {
  match printer_serial(printer: printer_02) {
    PrinterSerialFound { serial: s } => (s as String) == (a_serial as String)
    PrinterSerialUnknown { printer: _ } => false
    PrinterSerialUnrecorded { printer: _ } => false
    PrinterSerialAmbiguous { printer: _ } => false
  }
}

test fn the_two_printers_resolve_different_serials() -> Bool {
  match printer_serial(printer: printer_01) {
    PrinterSerialFound { serial: one } =>
      match printer_serial(printer: printer_02) {
        PrinterSerialFound { serial: two } => (one as String) != (two as String)
        PrinterSerialUnknown { printer: _ } => false
        PrinterSerialUnrecorded { printer: _ } => false
        PrinterSerialAmbiguous { printer: _ } => false
      }
    PrinterSerialUnknown { printer: _ } => false
    PrinterSerialUnrecorded { printer: _ } => false
    PrinterSerialAmbiguous { printer: _ } => false
  }
}

// THE QoS CHOICE IS ARGUED IN THE PROTOCOL MODULE AND PINNED HERE. AtMostOnce may be dropped
// silently, which for a start command means a job that never begins and nothing that says why; the
// wire level is asserted alongside the variant so a renumbering cannot pass unnoticed.
test fn the_start_command_is_not_published_at_most_once() -> Bool {
  match bambu_start_command_qos {
    AtMostOnce => false
    AtLeastOnce => mqtt_qos_wire_level(qos: bambu_start_command_qos) == 1
    ExactlyOnce => mqtt_qos_wire_level(qos: bambu_start_command_qos) == 2
  }
}

// THE START PAYLOAD NAMES A FILE ALREADY ON THE MACHINE, and names THIS one. A payload that carried
// a stale or defaulted name would start whichever project happened to be on the card.
test fn the_start_payload_names_the_delivered_file() -> Bool {
  let json = bambu_start_payload_json(
    command: bambu_start_command(remote_name: a_remote_name), sequence_id: "7")
  string_contains(s: json, pattern: "file:///sdcard/gauge_container.3mf")
    && string_contains(s: json, pattern: "\"sequence_id\":\"7\"")
    && string_contains(s: json, pattern: "\"command\":\"project_file\"")
}

// use_ams IS FALSE, and it is checked rather than trusted to the constructor. The operator's
// constraint is one filament per printer -- printer-01 white, printer-02 black -- and a true here
// would make the machine wait on an AMS that is not bound to this print.
test fn the_start_payload_does_not_ask_for_an_ams() -> Bool {
  let json = bambu_start_payload_json(
    command: bambu_start_command(remote_name: a_remote_name), sequence_id: "1")
  string_contains(s: json, pattern: "\"use_ams\":false")
}

// THE BROKER IS TLS, MEASURED ON THE MACHINE RATHER THAN ASSUMED FROM THE PORT NUMBER.
test fn the_lan_broker_endpoint_is_tls() -> Bool {
  let endpoint = bambu_lan_mqtt_endpoint(host: a_host)
  match endpoint.security {
    MqttOverTls => (endpoint.host as String) == (a_host as String)
    MqttPlaintext => false
  }
}
