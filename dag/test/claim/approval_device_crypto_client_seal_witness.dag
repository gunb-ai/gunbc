module test.claim.approval_device_crypto_client_seal_witness

import gunbc.compile_diagnostic_census {
  CompileDiagnosticCensus,
  CensusObserved,
  CensusNotRunnable,
  census_count_at_key,
  census_blocking_rows
}
import std.types { String, Bool, Int }
import std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// THE DISCRIMINATING RED FOR THE CALLER SEAL OVER THE WHOLE DEPUTY CHAIN of gunbc.auth.approval_device_crypto_client.
// NativeDeviceCryptoBound, DeviceCryptoAdmission and DeviceCryptoAnswer are plain constructible values, so what keeps a module
// from forging a receipt and a verified answer and minting Verified* without the sidecar is that nothing outside the real route can
// reach the mints: device_crypto_proof_of, proof_for, signed_from / attested_from / asserted_from and the three *_from_answer folds
// are each admit_callers-sealed to the next link, and the *_from_answer folds to the sidecar_*_verification route (post + strict
// decode) plus the named fixtures and probes. Each probe below hands the compiler a module OUTSIDE every roster that calls one link,
// and asserts the refusal keyed by that link's own name (a class-only count is a property of the whole closure).

fn keyed_refusals(source: String, callee: String) -> Int {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: rows } =>
      census_count_at_key(rows: rows, diagnostic_class: "ConstructorCallAdmissionRefused", subject_name: callee, blocking: true)
    CensusNotRunnable { cause: _ } => 0 - 1
  }
}

data forged_signature_source: String = "module probe_forged_signature\nimport std.types { NonEmptyStr }\nimport std.decl_ref { DeclarationRef }\nimport std.native_realization_proof { NativeRealizationProof }\nimport extdeps.crypto.signature { VerifyingKey, SignatureVerification, SignedMessage }\nimport extdeps.apple.app_attest { AttestationExpectation, AssertionExpectation, AttestationVerification, AssertionVerification, AttestKeyId, AppAttestEnvironment, VerifiedAttestation, AuthenticAssertion }\nimport gunbc.auth.approval_device_crypto_realization { DeviceCryptoAdmission, device_crypto_proof_of }\nimport gunbc.auth.approval_device_crypto_wire { DeviceCryptoAnswer }\nimport gunbc.auth.approval_device_crypto_client { SidecarResult, signature_from_answer, attestation_from_answer, assertion_from_answer, proof_for, signed_from, attested_from, asserted_from }\nfn forged(a: DeviceCryptoAdmission, w: DeviceCryptoAnswer, k: VerifyingKey, m: NonEmptyStr) -> SidecarResult<SignatureVerification> = signature_from_answer(admission: a, answer: w, key: k, message: m)\n"

data forged_attestation_source: String = "module probe_forged_attestation\nimport std.types { NonEmptyStr }\nimport std.decl_ref { DeclarationRef }\nimport std.native_realization_proof { NativeRealizationProof }\nimport extdeps.crypto.signature { VerifyingKey, SignatureVerification, SignedMessage }\nimport extdeps.apple.app_attest { AttestationExpectation, AssertionExpectation, AttestationVerification, AssertionVerification, AttestKeyId, AppAttestEnvironment, VerifiedAttestation, AuthenticAssertion }\nimport gunbc.auth.approval_device_crypto_realization { DeviceCryptoAdmission, device_crypto_proof_of }\nimport gunbc.auth.approval_device_crypto_wire { DeviceCryptoAnswer }\nimport gunbc.auth.approval_device_crypto_client { SidecarResult, signature_from_answer, attestation_from_answer, assertion_from_answer, proof_for, signed_from, attested_from, asserted_from }\nfn forged(a: DeviceCryptoAdmission, w: DeviceCryptoAnswer, e: AttestationExpectation) -> SidecarResult<AttestationVerification> = attestation_from_answer(admission: a, answer: w, expectation: e)\n"

data forged_assertion_source: String = "module probe_forged_assertion\nimport std.types { NonEmptyStr }\nimport std.decl_ref { DeclarationRef }\nimport std.native_realization_proof { NativeRealizationProof }\nimport extdeps.crypto.signature { VerifyingKey, SignatureVerification, SignedMessage }\nimport extdeps.apple.app_attest { AttestationExpectation, AssertionExpectation, AttestationVerification, AssertionVerification, AttestKeyId, AppAttestEnvironment, VerifiedAttestation, AuthenticAssertion }\nimport gunbc.auth.approval_device_crypto_realization { DeviceCryptoAdmission, device_crypto_proof_of }\nimport gunbc.auth.approval_device_crypto_wire { DeviceCryptoAnswer }\nimport gunbc.auth.approval_device_crypto_client { SidecarResult, signature_from_answer, attestation_from_answer, assertion_from_answer, proof_for, signed_from, attested_from, asserted_from }\nfn forged(a: DeviceCryptoAdmission, w: DeviceCryptoAnswer, e: AssertionExpectation) -> SidecarResult<AssertionVerification> = assertion_from_answer(admission: a, answer: w, expectation: e)\n"

data forged_signed_source: String = "module probe_forged_signed\nimport std.types { NonEmptyStr }\nimport std.decl_ref { DeclarationRef }\nimport std.native_realization_proof { NativeRealizationProof }\nimport extdeps.crypto.signature { VerifyingKey, SignatureVerification, SignedMessage }\nimport extdeps.apple.app_attest { AttestationExpectation, AssertionExpectation, AttestationVerification, AssertionVerification, AttestKeyId, AppAttestEnvironment, VerifiedAttestation, AuthenticAssertion }\nimport gunbc.auth.approval_device_crypto_realization { DeviceCryptoAdmission, device_crypto_proof_of }\nimport gunbc.auth.approval_device_crypto_wire { DeviceCryptoAnswer }\nimport gunbc.auth.approval_device_crypto_client { SidecarResult, signature_from_answer, attestation_from_answer, assertion_from_answer, proof_for, signed_from, attested_from, asserted_from }\nfn forged(a: DeviceCryptoAdmission, k: VerifyingKey, m: NonEmptyStr) -> SignedMessage? = signed_from(admission: a, k: k, m: m)\n"

data forged_attested_source: String = "module probe_forged_attested\nimport std.types { NonEmptyStr }\nimport std.decl_ref { DeclarationRef }\nimport std.native_realization_proof { NativeRealizationProof }\nimport extdeps.crypto.signature { VerifyingKey, SignatureVerification, SignedMessage }\nimport extdeps.apple.app_attest { AttestationExpectation, AssertionExpectation, AttestationVerification, AssertionVerification, AttestKeyId, AppAttestEnvironment, VerifiedAttestation, AuthenticAssertion }\nimport gunbc.auth.approval_device_crypto_realization { DeviceCryptoAdmission, device_crypto_proof_of }\nimport gunbc.auth.approval_device_crypto_wire { DeviceCryptoAnswer }\nimport gunbc.auth.approval_device_crypto_client { SidecarResult, signature_from_answer, attestation_from_answer, assertion_from_answer, proof_for, signed_from, attested_from, asserted_from }\nfn forged(a: DeviceCryptoAdmission, id: AttestKeyId, pk: NonEmptyStr, r: NonEmptyStr, e: AppAttestEnvironment, c: NonEmptyStr) -> VerifiedAttestation? = attested_from(admission: a, id: id, pk: pk, r: r, e: e, c: c)\n"

data forged_asserted_source: String = "module probe_forged_asserted\nimport std.types { NonEmptyStr }\nimport std.decl_ref { DeclarationRef }\nimport std.native_realization_proof { NativeRealizationProof }\nimport extdeps.crypto.signature { VerifyingKey, SignatureVerification, SignedMessage }\nimport extdeps.apple.app_attest { AttestationExpectation, AssertionExpectation, AttestationVerification, AssertionVerification, AttestKeyId, AppAttestEnvironment, VerifiedAttestation, AuthenticAssertion }\nimport gunbc.auth.approval_device_crypto_realization { DeviceCryptoAdmission, device_crypto_proof_of }\nimport gunbc.auth.approval_device_crypto_wire { DeviceCryptoAnswer }\nimport gunbc.auth.approval_device_crypto_client { SidecarResult, signature_from_answer, attestation_from_answer, assertion_from_answer, proof_for, signed_from, attested_from, asserted_from }\nfn forged(a: DeviceCryptoAdmission, id: AttestKeyId, pk: NonEmptyStr, n: Int, c: NonEmptyStr) -> AuthenticAssertion? = asserted_from(admission: a, id: id, pk: pk, n: n, c: c)\n"

data forged_proof_source: String = "module probe_forged_proof\nimport std.types { NonEmptyStr }\nimport std.decl_ref { DeclarationRef }\nimport std.native_realization_proof { NativeRealizationProof }\nimport extdeps.crypto.signature { VerifyingKey, SignatureVerification, SignedMessage }\nimport extdeps.apple.app_attest { AttestationExpectation, AssertionExpectation, AttestationVerification, AssertionVerification, AttestKeyId, AppAttestEnvironment, VerifiedAttestation, AuthenticAssertion }\nimport gunbc.auth.approval_device_crypto_realization { DeviceCryptoAdmission, device_crypto_proof_of }\nimport gunbc.auth.approval_device_crypto_wire { DeviceCryptoAnswer }\nimport gunbc.auth.approval_device_crypto_client { SidecarResult, signature_from_answer, attestation_from_answer, assertion_from_answer, proof_for, signed_from, attested_from, asserted_from }\nfn forged(a: DeviceCryptoAdmission, f: DeclarationRef) -> NativeRealizationProof? = proof_for(admission: a, module_path: \"extdeps.crypto.signature\", decl_name: \"verify_signature\")\n"

data direct_proof_source: String = "module probe_direct_proof\nimport std.types { NonEmptyStr }\nimport std.decl_ref { DeclarationRef }\nimport std.native_realization_proof { NativeRealizationProof }\nimport extdeps.crypto.signature { VerifyingKey, SignatureVerification, SignedMessage }\nimport extdeps.apple.app_attest { AttestationExpectation, AssertionExpectation, AttestationVerification, AssertionVerification, AttestKeyId, AppAttestEnvironment, VerifiedAttestation, AuthenticAssertion }\nimport gunbc.auth.approval_device_crypto_realization { DeviceCryptoAdmission, device_crypto_proof_of }\nimport gunbc.auth.approval_device_crypto_wire { DeviceCryptoAnswer }\nimport gunbc.auth.approval_device_crypto_client { SidecarResult, signature_from_answer, attestation_from_answer, assertion_from_answer, proof_for, signed_from, attested_from, asserted_from }\nfn forged(a: DeviceCryptoAdmission, f: DeclarationRef) -> NativeRealizationProof? = device_crypto_proof_of(admission: a, fold: f)\n"

test fn an_unlisted_module_calling_signature_from_answer_is_refused() -> Bool {
  keyed_refusals(source: forged_signature_source, callee: "signature_from_answer") >= 1
}

test fn an_unlisted_module_calling_attestation_from_answer_is_refused() -> Bool {
  keyed_refusals(source: forged_attestation_source, callee: "attestation_from_answer") >= 1
}

test fn an_unlisted_module_calling_assertion_from_answer_is_refused() -> Bool {
  keyed_refusals(source: forged_assertion_source, callee: "assertion_from_answer") >= 1
}

test fn an_unlisted_module_calling_signed_from_is_refused() -> Bool {
  keyed_refusals(source: forged_signed_source, callee: "signed_from") >= 1
}

test fn an_unlisted_module_calling_attested_from_is_refused() -> Bool {
  keyed_refusals(source: forged_attested_source, callee: "attested_from") >= 1
}

test fn an_unlisted_module_calling_asserted_from_is_refused() -> Bool {
  keyed_refusals(source: forged_asserted_source, callee: "asserted_from") >= 1
}

test fn an_unlisted_module_calling_proof_for_is_refused() -> Bool {
  keyed_refusals(source: forged_proof_source, callee: "proof_for") >= 1
}

test fn an_unlisted_module_calling_device_crypto_proof_of_is_refused() -> Bool {
  keyed_refusals(source: direct_proof_source, callee: "device_crypto_proof_of") >= 1
}

data real_route_source: String = "module probe_real_route\nimport std.types { NonEmptyStr }\nimport extdeps.crypto.signature { VerifyingKey, SignatureBytes, SignatureVerification }\nimport gunbc.auth.approval_device_crypto_realization { DeviceCryptoGate }\nimport gunbc.auth.approval_device_crypto_client { SidecarResult, sidecar_signature_verification }\nfn real(g: DeviceCryptoGate, k: VerifyingKey, s: SignatureBytes, m: NonEmptyStr) -> SidecarResult<SignatureVerification> = sidecar_signature_verification(gate: g, key: k, signature: s, message: m)\n"

data closure_baseline_source: String = "module probe_closure_baseline\nimport std.types { NonEmptyStr }\nimport extdeps.crypto.signature { VerifyingKey, SignatureBytes, SignatureVerification }\nimport gunbc.auth.approval_device_crypto_realization { DeviceCryptoGate }\nimport gunbc.auth.approval_device_crypto_client { SidecarResult, sidecar_signature_verification }\n"

// The census carries the imported closure's own blocking rows (gunbc.compile_diagnostic_census), so a total of zero is never
// observable; the exact form is the differential against a source importing the same names and calling nothing, where the
// shared closure cancels. The same call against the interface as it was before the gate/admission split: `admission:` is no argument of the route
// now. It is the control's own RED: a source that has drifted from the real signature must show MORE blocking diagnostics than the baseline, or the
// green control below could pass on a broken closure with every keyed seal count at zero.
data stale_route_source: String = "module probe_stale_route\nimport std.types { NonEmptyStr }\nimport extdeps.crypto.signature { VerifyingKey, SignatureBytes, SignatureVerification }\nimport gunbc.auth.approval_device_crypto_realization { DeviceCryptoGate }\nimport gunbc.auth.approval_device_crypto_client { SidecarResult, sidecar_signature_verification }\nfn real(g: DeviceCryptoGate, k: VerifyingKey, s: SignatureBytes, m: NonEmptyStr) -> SidecarResult<SignatureVerification> = sidecar_signature_verification(admission: g, key: k, signature: s, message: m)\n"

fn blocking_diagnostics(source: String) -> Int {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: rows } => count(census_blocking_rows(rows: rows))
    CensusNotRunnable { cause: _ } => 0 - 1
  }
}

// THE GREEN CONTROL: a module calling the real route compiles with no admission refusal on any link of the chain, so the REDs above
// are the seals and not a broken closure (the route's own calls to the links sit inside the imported closure this census covers).
test fn the_real_route_resolves_under_the_seals() -> Bool {
  blocking_diagnostics(source: real_route_source) == blocking_diagnostics(source: closure_baseline_source)
    && blocking_diagnostics(source: closure_baseline_source) >= 0
    && keyed_refusals(source: real_route_source, callee: "signature_from_answer") == 0
    && keyed_refusals(source: real_route_source, callee: "attestation_from_answer") == 0
    && keyed_refusals(source: real_route_source, callee: "assertion_from_answer") == 0
    && keyed_refusals(source: real_route_source, callee: "signed_from") == 0
    && keyed_refusals(source: real_route_source, callee: "attested_from") == 0
    && keyed_refusals(source: real_route_source, callee: "asserted_from") == 0
    && keyed_refusals(source: real_route_source, callee: "proof_for") == 0
    && keyed_refusals(source: real_route_source, callee: "device_crypto_proof_of") == 0
}

// RED FOR THE GREEN CONTROL: a route call written against the stale interface shows blocking diagnostics, so zero keyed seal
// refusals alone (which a type diagnostic leaves untouched) cannot be what makes the green control pass.
test fn a_route_call_against_the_stale_interface_has_blocking_diagnostics() -> Bool {
  blocking_diagnostics(source: stale_route_source) > blocking_diagnostics(source: closure_baseline_source)
    && blocking_diagnostics(source: closure_baseline_source) >= 0
    && keyed_refusals(source: stale_route_source, callee: "signature_from_answer") == 0
}
