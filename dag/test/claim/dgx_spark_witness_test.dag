data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// SPARK-0 green-by-execution proof. The RED control (w_red_admission_without_evidence_refuses) is the deliverable per the brief: constructing a DgxSparkDeployment from vendor catalog data plus procurement intent alone, with no FleetLifecycleEnvelope, must REFUSE -- physical binding evidence (a real device_identity.py observation) is absent, and catalog+intent can never substitute for it. w_admission_with_real_evidence_succeeds is the positive control proving the same function admits once that evidence is supplied, so the RED control is proven to be a real discriminator and not a permanently-broken function. w_red_admission_with_wrong_tool_evidence_refuses is a second RED control (review 49032): presence of ANY FleetLifecycleEnvelope is not sufficient -- an envelope from a different tool (spark_updatectl.py, an UpdateControl observation) must also REFUSE, proving the wall discriminates on evidence identity, not mere presence. w_red_admission_with_mismatched_host_refuses is a third RED control (review 49071): a real device_identity.py envelope observed against one host must not bind a deployment for a different identity. dgx_spark_catalog_row (extdeps.systems.nvidia) has no witness calling it by name but is exercised indirectly: it constructs nvidia_dgx_spark_1tb_catalog and nvidia_dgx_spark_4tb_catalog as data, and multiple witnesses above dereference both, so its body executes on every run of this file.
test fn w_catalog_row_nests_gpu_from_grounded_authority() -> Bool {
  nvidia_dgx_spark_1tb_catalog.gpu.model == nvidia_gb10_gpu_catalog.model
    && nvidia_dgx_spark_1tb_catalog.gpu.model == "GB10 Blackwell GPU"
}

test fn w_two_skus_differ_only_in_storage_capacity() -> Bool {
  nvidia_dgx_spark_1tb_catalog.model == nvidia_dgx_spark_4tb_catalog.model
    && nvidia_dgx_spark_1tb_catalog.soc_model == nvidia_dgx_spark_4tb_catalog.soc_model
    && nvidia_dgx_spark_1tb_catalog.storage_capacity != nvidia_dgx_spark_4tb_catalog.storage_capacity
}

test fn w_heterogeneous_cpu_core_count_derives_to_twenty() -> Bool {
  integrated_compute_system_cpu_core_count(row: nvidia_dgx_spark_4tb_catalog) == 20
}

test fn w_fleet_lifecycle_operation_class_distinguishes_collector_and_controller() -> Bool {
  match fleet_lifecycle_operation_class(op: DeviceIdentity) {
    Collector => true
    Controller => false
  }
    && match fleet_lifecycle_operation_class(op: UpdateControl) {
      Collector => false
      Controller => true
    }
}

test fn w_only_the_controller_requires_a_change_window() -> Bool {
  !fleet_lifecycle_requires_change_window(op: DeviceIdentity)
    && fleet_lifecycle_requires_change_window(op: UpdateControl)
}

test fn w_tool_names_match_the_cited_page() -> Bool {
  fleet_lifecycle_operation_tool_name(op: DeviceIdentity) == "device_identity.py"
    && fleet_lifecycle_operation_tool_name(op: UpdateControl) == "spark_updatectl.py"
}


test fn w_procurement_intent_reserves_two_identities_not_enrolled() -> Bool {
  dgx_spark_procurement_intent.unit_count == 2
    && dgx_spark_procurement_intent.reserved_identities == [operator_host_srv5, operator_host_srv6]
    && dgx_spark_reserved_identities() == [operator_host_srv5, operator_host_srv6]
}

test fn w_reserved_identities_derive_from_the_router_binding_roster() -> Bool {
  count(dgx_spark_router_bindings) == 2
    && dgx_spark_reserved_identities() == map(dgx_spark_router_bindings, b => b.identity)
    && srv5_router_binding.identity == operator_host_srv5
    && srv6_router_binding.identity == operator_host_srv6
}

// The live state as of 2026-08-07: both units have ARRIVED and the operator has authored two static reservations on the CR1000A, so those rows are facts and are modeled. What is NOT established is which box takes the srv5 slot and which takes srv6 -- the operator supplied the router table but never stated the assignment, and it may be a free choice rather than a discovered fact. This witness pins exactly that split: the two observed reservations exist with their transcribed MACs and addresses, and NEITHER is yet joined to a fleet subject. It reds in both useful directions -- if someone drops the observed router facts, and if someone guesses the assignment without an operator statement.
test fn w_router_reservations_are_observed_but_not_yet_assigned_to_a_slot() -> Bool {
  count(observed_dgx_spark_router_reservations) == 2
    && spark_a3ee_reservation.ipv4_address == ipv4_address(octet1: 192, octet2: 168, octet3: 1, octet4: 222)
    && spark_3bd5_reservation.ipv4_address == ipv4_address(octet1: 192, octet2: 168, octet3: 1, octet4: 223)
    && fold(
      dgx_spark_router_bindings,
      init: true,
      f: (acc, b) =>
        acc && match b.reservation {
          Absent => true
          Present { value: _ } => false
        }
    )
}

fn synthetic_envelope_for(host: NonEmptyStr) -> FleetLifecycleEnvelope {
  FleetLifecycleEnvelope {
    tool: "device_identity.py",
    ts: "2026-08-07T00:00:00Z",
    host: host,
    status: StatusOk,
    rc: 0,
    duration_ms: 42,
    summary: "synthetic positive control, not a real device observation",
    warnings: [],
    artifacts: [],
  }
}

// A synthetic reservation fixture, carrying the all-zero MAC so it can never be mistaken for an observed router row (the convention gunbc.network_identity_subsumption's post-install fixture uses). Its only job is to make the router-binding wall a proven discriminator: without a bound fixture the positive control could not exist, and a wall no input can pass proves nothing.
fn synthetic_bound_binding_for(identity_host: NonEmptyStr, last_octet: Int) -> DgxSparkRouterBinding {
  DgxSparkRouterBinding {
    identity: identity_host as HostIdentity,
    reservation: Present {
      value: Cr1000aDhcpLeaseRow {
        mac_address: "00:00:00:00:00:00" as MacAddress,
        ipv4_address: ipv4_address(octet1: 192, octet2: 168, octet3: 1, octet4: last_octet),
        lease: StaticDhcpReservation {
          reservation_label: "synthetic-dgx-spark-fixture" as NonEmptyStr,
          status: Active,
        },
      }
    },
  }
}

// The dispatch-side facts a real collector run would carry: the SUBJECT it was dispatched against, the endpoint it reached, the attempt that produced these bytes, and a digest of the raw evidence. Every fixture below builds its observation this way, so no witness can accidentally re-introduce the defect the carrier exists to close -- there is no path here that derives a subject from the envelope.
fn synthetic_observation(
  subject_host: NonEmptyStr,
  envelope_host: NonEmptyStr,
  last_octet: Int,
  attempt_label: NonEmptyStr,
) -> DgxSparkCollectorObservation {
  DgxSparkCollectorObservation {
    subject: subject_host as HostIdentity,
    endpoint_binding: EndpointBindingIdentity {
      address: ipv4_address(octet1: 192, octet2: 168, octet3: 1, octet4: last_octet),
    },
    attempt: collector_attempt_identity(label: attempt_label),
    raw_evidence: content_hash_of_value(value: attempt_label),
    envelope: synthetic_envelope_for(host: envelope_host),
  }
}

fn srv5_good_observation() -> DgxSparkCollectorObservation {
  synthetic_observation(subject_host: "srv5", envelope_host: "srv5", last_octet: 222, attempt_label: "attempt-1")
}

test fn w_admission_with_real_evidence_succeeds() -> Bool {
  match admit_dgx_spark_deployment(
    identity: operator_host_srv5,
    catalog: nvidia_dgx_spark_4tb_catalog,
    selection: ObservationUnique { observation: srv5_good_observation() },
    router_binding: synthetic_bound_binding_for(identity_host: "srv5", last_octet: 222),
  ) {
    DgxSparkDeploymentAdmitted { deployment: d } =>
      d.identity == operator_host_srv5 && d.observation.subject == operator_host_srv5
    DgxSparkDeploymentRefused { reason: _ } => false
  }
}

test fn w_red_admission_without_evidence_refuses() -> Bool {
  match admit_dgx_spark_deployment(
    identity: operator_host_srv5,
    catalog: nvidia_dgx_spark_4tb_catalog,
    selection: ObservationMissing { subject: operator_host_srv5 },
    router_binding: synthetic_bound_binding_for(identity_host: "srv5", last_octet: 222),
  ) {
    DgxSparkDeploymentRefused { reason: DeploymentAdmissionNoEvidence { requested_identity: i } } =>
      i == operator_host_srv5
    DgxSparkDeploymentRefused { reason: _ } => false
    DgxSparkDeploymentAdmitted { deployment: _ } => false
  }
}

test fn w_red_admission_with_wrong_tool_evidence_refuses() -> Bool {
  let o = DgxSparkCollectorObservation {
    subject: operator_host_srv5,
    endpoint_binding: EndpointBindingIdentity {
      address: ipv4_address(octet1: 192, octet2: 168, octet3: 1, octet4: 222),
    },
    attempt: collector_attempt_identity(label: "attempt-wrong-tool"),
    raw_evidence: content_hash_of_value(value: "attempt-wrong-tool"),
    envelope: FleetLifecycleEnvelope {
      tool: "spark_updatectl.py",
      ts: "2026-08-07T00:00:00Z",
      host: "srv5",
      status: StatusOk,
      rc: 0,
      duration_ms: 42,
      summary: "synthetic wrong-tool envelope: an UpdateControl observation, not a DeviceIdentity one",
      warnings: [],
      artifacts: [],
    },
  }
  match admit_dgx_spark_deployment(
    identity: operator_host_srv5,
    catalog: nvidia_dgx_spark_4tb_catalog,
    selection: ObservationUnique { observation: o },
    router_binding: synthetic_bound_binding_for(identity_host: "srv5", last_octet: 222),
  ) {
    DgxSparkDeploymentRefused { reason: DeploymentAdmissionWrongTool { observed_tool: t } } => t == "spark_updatectl.py"
    DgxSparkDeploymentRefused { reason: _ } => false
    DgxSparkDeploymentAdmitted { deployment: _ } => false
  }
}

// DEFECT 1 control, dispatch half: an observation DISPATCHED against srv5 must not admit a deployment for srv6, and the refusal names the dispatched subject -- the authority fact -- rather than anything the envelope printed.
test fn w_red_admission_with_mismatched_dispatch_subject_refuses() -> Bool {
  match admit_dgx_spark_deployment(
    identity: operator_host_srv6,
    catalog: nvidia_dgx_spark_4tb_catalog,
    selection: ObservationUnique { observation: srv5_good_observation() },
    router_binding: synthetic_bound_binding_for(identity_host: "srv6", last_octet: 223),
  ) {
    DgxSparkDeploymentRefused {
      reason: DeploymentAdmissionSubjectMismatch { dispatched_subject: s, requested_identity: i }
    } => s == operator_host_srv5 && i == operator_host_srv6
    DgxSparkDeploymentRefused { reason: _ } => false
    DgxSparkDeploymentAdmitted { deployment: _ } => false
  }
}

// DEFECT 1 control, evidence half, and the sharper of the two: the observation is dispatched against srv6 -- correct subject, correct binding, correct endpoint -- but the unit PRINTED "srv5". Under the old shape the printed string WAS the subject, so this input would have re-pointed the deployment to srv5 without a murmur; now the subject stands and the disagreeing presentation is caught as a typed evidence mismatch. That is the whole content of "presentation is checkable evidence, never the authority".
test fn w_red_admission_when_envelope_host_disagrees_with_subject_refuses() -> Bool {
  let o = synthetic_observation(subject_host: "srv6", envelope_host: "srv5", last_octet: 223, attempt_label: "attempt-disagreeing-host")
  match admit_dgx_spark_deployment(
    identity: operator_host_srv6,
    catalog: nvidia_dgx_spark_4tb_catalog,
    selection: ObservationUnique { observation: o },
    router_binding: synthetic_bound_binding_for(identity_host: "srv6", last_octet: 223),
  ) {
    DgxSparkDeploymentRefused {
      reason: DeploymentAdmissionHostMismatch { observed_host: h, requested_identity: i }
    } => h == "srv5" && i == operator_host_srv6
    DgxSparkDeploymentRefused { reason: _ } => false
    DgxSparkDeploymentAdmitted { deployment: _ } => false
  }
}

test fn w_red_admission_with_failed_observation_refuses() -> Bool {
  let o = DgxSparkCollectorObservation {
    subject: operator_host_srv5,
    endpoint_binding: EndpointBindingIdentity {
      address: ipv4_address(octet1: 192, octet2: 168, octet3: 1, octet4: 222),
    },
    attempt: collector_attempt_identity(label: "attempt-failed"),
    raw_evidence: content_hash_of_value(value: "attempt-failed"),
    envelope: FleetLifecycleEnvelope {
      tool: "device_identity.py",
      ts: "2026-08-07T00:00:00Z",
      host: "srv5",
      status: StatusError,
      rc: 1,
      duration_ms: 42,
      summary: "synthetic FAILED device_identity.py run: the tool was invoked against srv5 and did not succeed",
      warnings: [],
      artifacts: [],
    },
  }
  match admit_dgx_spark_deployment(
    identity: operator_host_srv5,
    catalog: nvidia_dgx_spark_4tb_catalog,
    selection: ObservationUnique { observation: o },
    router_binding: synthetic_bound_binding_for(identity_host: "srv5", last_octet: 222),
  ) {
    DgxSparkDeploymentRefused {
      reason: DeploymentAdmissionObservationNotOk { observed_status: StatusError, observed_rc: rc }
    } => rc == 1
    DgxSparkDeploymentRefused { reason: _ } => false
    DgxSparkDeploymentAdmitted { deployment: _ } => false
  }
}

// A valid successful observation of srv3, a real fleet host, with a matching bound binding. It must still refuse: nothing about a valid observation of some host makes that host a machine the operator procured, and admitting one would let the procurement roster be written by whatever answered.
test fn w_red_admission_of_unreserved_identity_refuses() -> Bool {
  let o = synthetic_observation(subject_host: "srv3", envelope_host: "srv3", last_octet: 221, attempt_label: "attempt-srv3")
  match admit_dgx_spark_deployment(
    identity: operator_host_srv3,
    catalog: nvidia_dgx_spark_4tb_catalog,
    selection: ObservationUnique { observation: o },
    router_binding: synthetic_bound_binding_for(identity_host: "srv3", last_octet: 221),
  ) {
    DgxSparkDeploymentRefused {
      reason: DeploymentAdmissionIdentityNotReserved { requested_identity: i }
    } => i == operator_host_srv3
    DgxSparkDeploymentRefused { reason: _ } => false
    DgxSparkDeploymentAdmitted { deployment: _ } => false
  }
}

// The LIVE srv5 binding, whose reservation is Absent because the slot-to-box assignment has not been stated. Everything else about this call is valid, so this isolates the router-binding requirement as the sole reason for refusal. It flips of its own accord the day the operator states which box serves srv5.
test fn w_red_admission_with_pending_router_binding_refuses() -> Bool {
  match admit_dgx_spark_deployment(
    identity: operator_host_srv5,
    catalog: nvidia_dgx_spark_4tb_catalog,
    selection: ObservationUnique { observation: srv5_good_observation() },
    router_binding: srv5_router_binding,
  ) {
    DgxSparkDeploymentRefused {
      reason: DeploymentAdmissionRouterBindingPending { requested_identity: i }
    } => i == operator_host_srv5
    DgxSparkDeploymentRefused { reason: _ } => false
    DgxSparkDeploymentAdmitted { deployment: _ } => false
  }
}

test fn w_red_admission_with_mismatched_router_binding_refuses() -> Bool {
  let o = synthetic_observation(subject_host: "srv6", envelope_host: "srv6", last_octet: 223, attempt_label: "attempt-srv6")
  match admit_dgx_spark_deployment(
    identity: operator_host_srv6,
    catalog: nvidia_dgx_spark_4tb_catalog,
    selection: ObservationUnique { observation: o },
    router_binding: synthetic_bound_binding_for(identity_host: "srv5", last_octet: 222),
  ) {
    DgxSparkDeploymentRefused {
      reason: DeploymentAdmissionRouterBindingMismatch { binding_identity: b, requested_identity: i }
    } => b == operator_host_srv5 && i == operator_host_srv6
    DgxSparkDeploymentRefused { reason: _ } => false
    DgxSparkDeploymentAdmitted { deployment: _ } => false
  }
}

// Evidence must arrive from the RESERVED endpoint. The subject, the binding and the envelope all agree here; only the address the collector actually reached differs from the one reserved for that subject, which is the case where a machine answered on an address nobody reserved for it.
test fn w_red_admission_from_unreserved_endpoint_refuses() -> Bool {
  let o = synthetic_observation(subject_host: "srv5", envelope_host: "srv5", last_octet: 231, attempt_label: "attempt-wrong-endpoint")
  match admit_dgx_spark_deployment(
    identity: operator_host_srv5,
    catalog: nvidia_dgx_spark_4tb_catalog,
    selection: ObservationUnique { observation: o },
    router_binding: synthetic_bound_binding_for(identity_host: "srv5", last_octet: 222),
  ) {
    DgxSparkDeploymentRefused {
      reason: DeploymentAdmissionEndpointBindingMismatch { requested_identity: i }
    } => i == operator_host_srv5
    DgxSparkDeploymentRefused { reason: _ } => false
    DgxSparkDeploymentAdmitted { deployment: _ } => false
  }
}

// DEFECT 2 control, the one the old first-wins fold silently passed. Two collector attempts against ONE subject, disagreeing (the second reports failure). Selection must report Ambiguous with the candidate count rather than returning whichever the list ordered first, and the wall must refuse on it. Under the previous shape this input admitted a deployment built from attempt-1 while attempt-2's failure was dropped without a trace.
fn two_conflicting_srv5_observations() -> List<DgxSparkCollectorObservation> {
  [
    srv5_good_observation(),
    DgxSparkCollectorObservation {
      subject: operator_host_srv5,
      endpoint_binding: EndpointBindingIdentity {
        address: ipv4_address(octet1: 192, octet2: 168, octet3: 1, octet4: 222),
      },
      attempt: collector_attempt_identity(label: "attempt-2"),
      raw_evidence: content_hash_of_value(value: "attempt-2"),
      envelope: FleetLifecycleEnvelope {
        tool: "device_identity.py",
        ts: "2026-08-07T00:05:00Z",
        host: "srv5",
        status: StatusError,
        rc: 1,
        duration_ms: 42,
        summary: "synthetic second attempt against the same subject, disagreeing with the first",
        warnings: [],
        artifacts: [],
      },
    },
  ]
}

test fn w_red_two_attempts_for_one_subject_select_ambiguous() -> Bool {
  match select_observation_for_subject(
    subject: operator_host_srv5,
    observations: two_conflicting_srv5_observations(),
  ) {
    ObservationAmbiguous { subject: s, candidate_count: n } => s == operator_host_srv5 && n == 2
    ObservationUnique { observation: _ } => false
    ObservationMissing { subject: _ } => false
  }
}

test fn w_red_admission_on_ambiguous_evidence_refuses() -> Bool {
  match admit_dgx_spark_deployment(
    identity: operator_host_srv5,
    catalog: nvidia_dgx_spark_4tb_catalog,
    selection: select_observation_for_subject(
      subject: operator_host_srv5,
      observations: two_conflicting_srv5_observations(),
    ),
    router_binding: synthetic_bound_binding_for(identity_host: "srv5", last_octet: 222),
  ) {
    DgxSparkDeploymentRefused {
      reason: DeploymentAdmissionAmbiguousEvidence { requested_identity: i, candidate_count: n }
    } => i == operator_host_srv5 && n == 2
    DgxSparkDeploymentRefused { reason: _ } => false
    DgxSparkDeploymentAdmitted { deployment: _ } => false
  }
}

// The three arms of selection are all reachable and distinct: zero candidates, exactly one, and the attempt-exact disambiguation that resolves the ambiguous case above to a unique pick. Naming the attempt is the ONLY way to narrow it -- list position never is.
test fn w_selection_is_zero_one_many_and_attempt_disambiguates() -> Bool {
  match select_observation_for_subject(subject: operator_host_srv5, observations: []) {
    ObservationMissing { subject: s } => s == operator_host_srv5
    ObservationUnique { observation: _ } => false
    ObservationAmbiguous { subject: _, candidate_count: _ } => false
  }
    && match select_observation_for_subject(
      subject: operator_host_srv5,
      observations: [srv5_good_observation()],
    ) {
      ObservationUnique { observation: o } => o.subject == operator_host_srv5
      ObservationMissing { subject: _ } => false
      ObservationAmbiguous { subject: _, candidate_count: _ } => false
    }
    && match select_observation_by_attempt(
      subject: operator_host_srv5,
      attempt: collector_attempt_identity(label: "attempt-2"),
      observations: two_conflicting_srv5_observations(),
    ) {
      ObservationUnique { observation: o } => o.envelope.rc == 1
      ObservationMissing { subject: _ } => false
      ObservationAmbiguous { subject: _, candidate_count: _ } => false
    }
}

// Selection keys on the DISPATCH subject, not on what the envelope printed: an observation dispatched against srv6 whose envelope says "srv5" must not be selectable as srv5's evidence. This is the selection-side half of DEFECT 1 -- the old fold matched on envelope.host, so this row WAS srv5's evidence.
test fn w_red_selection_ignores_envelope_host() -> Bool {
  let o = synthetic_observation(subject_host: "srv6", envelope_host: "srv5", last_octet: 223, attempt_label: "attempt-mislabeled")
  match select_observation_for_subject(subject: operator_host_srv5, observations: [o]) {
    ObservationMissing { subject: s } => s == operator_host_srv5
    ObservationUnique { observation: _ } => false
    ObservationAmbiguous { subject: _, candidate_count: _ } => false
  }
}

// Live convergence: the real roster against the real (empty) observation population is Pending with one typed row per unit, and the cause is the absence of evidence -- not an untyped "not ready" and not a silently empty result a consumer could read as converged.
test fn w_live_procurement_convergence_is_pending_for_both_units() -> Bool {
  match dgx_spark_procurement_convergence() {
    DgxSparkProcurementPending { pending: p } =>
      count(p) == 2
        && fold(
          p,
          init: true,
          f: (acc, d) =>
            acc && match d {
              DgxSparkUnitPending { identity: _, reason: DeploymentAdmissionNoEvidence { requested_identity: _ } } => true
              DgxSparkUnitPending { identity: _, reason: _ } => false
              DgxSparkUnitDeployed { deployment: _ } => false
            }
        )
    DgxSparkProcurementConverged { deployments: _ } => false
  }
}

test fn w_procurement_converges_when_both_units_are_bound_and_observed() -> Bool {
  match converge_dgx_spark_procurement(
    bindings: [
      synthetic_bound_binding_for(identity_host: "srv5", last_octet: 222),
      synthetic_bound_binding_for(identity_host: "srv6", last_octet: 223),
    ],
    observations: [
      srv5_good_observation(),
      synthetic_observation(subject_host: "srv6", envelope_host: "srv6", last_octet: 223, attempt_label: "attempt-srv6"),
    ],
  ) {
    DgxSparkProcurementConverged { deployments: ds } =>
      count(ds) == 2
        && map(ds, d => d.identity) == [operator_host_srv5, operator_host_srv6]
    DgxSparkProcurementPending { pending: _ } => false
  }
}

// Partial arrival is Pending, not converged: one unit bound and observed, the other still unassigned. The discriminator against a converge that folds with an OR.
test fn w_red_partial_arrival_does_not_converge() -> Bool {
  match converge_dgx_spark_procurement(
    bindings: [synthetic_bound_binding_for(identity_host: "srv5", last_octet: 222), srv6_router_binding],
    observations: [
      srv5_good_observation(),
      synthetic_observation(subject_host: "srv6", envelope_host: "srv6", last_octet: 223, attempt_label: "attempt-srv6"),
    ],
  ) {
    DgxSparkProcurementPending { pending: p } =>
      count(p) == 1
        && fold(
          p,
          init: false,
          f: (acc, d) =>
            acc || match d {
              DgxSparkUnitPending {
                identity: i,
                reason: DeploymentAdmissionRouterBindingPending { requested_identity: _ },
              } => i == operator_host_srv6
              DgxSparkUnitPending { identity: _, reason: _ } => false
              DgxSparkUnitDeployed { deployment: _ } => false
            }
        )
    DgxSparkProcurementConverged { deployments: _ } => false
  }
}
