module test.claim.emitted_closure_artifact_witness_test

import gunbc.emitted_closure_artifact {
  emitted_closure_rust_library_text,
  emitted_closure_cargo_package,
  emitted_closure_binary_target,
  curated_probe_cargo_package_text,
  emitted_closure_import_alias,
  EmittedArtifactSlug
}
import tools.self_host_curated_seed_linked_harness { cssl_v1_compiled_cargo_package_header }
import std.types { Bool, NonEmptyStr, String }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE COLLAPSE PRESERVED GENERATED BYTES, AND THIS IS THE ORACLE THAT SAYS SO RATHER THAN AN
// ARGUMENT THAT IT MUST HAVE. The curated probe's manifest header used to carry the library
// identifier as its own literal; it now renders that identifier from the single authority. Those are
// two different constructions of one string, so the only honest check is that the string did not
// move. The expected value here is a controlled literal -- the bytes as they stood before the
// collapse -- which is what makes this a pin and not a measurement compared against itself.
data expected_probe_manifest_header: String = "[package]\nname = \"v1_compiled\"\nversion = \"0.1.0\"\nedition = \"2021\"\n\n[features]\ntext_lookup_work_counter = []\n\n"

test fn the_collapsed_manifest_header_renders_the_same_bytes_holds() -> Bool {
  cssl_v1_compiled_cargo_package_header() == expected_probe_manifest_header
}

// THE CURATED PROBE'S PACKAGE NAME IS DERIVED FROM THE LIBRARY IDENTIFIER, and asserting the
// equality states the DIRECTION the model now carries: Cargo derives a package's default library
// name from its package name, and the probe's shims resolve the library, so that package name is a
// means of fixing the identifier rather than an independent choice beside it.
test fn the_curated_probe_package_is_the_library_identifier_holds() -> Bool {
  curated_probe_cargo_package_text() == emitted_closure_rust_library_text()
}

// THE ROUTE'S PACKAGE AND BINARY TARGET ARE SLUG-DERIVED AND ARE NOT THE LIBRARY IDENTIFIER. This is
// the second naming scheme the census found, modeled here so a reader finds both answers in one
// place; the claim keeps them separable, so a later consolidation that accidentally collapsed the two
// schemes into one string would go red here rather than silently rename a `use` line's target.
test fn the_route_package_and_binary_are_slug_derived_holds() -> Bool {
  let s = EmittedArtifactSlug { slug: "src-v2-cli-compile-cli-dag" as NonEmptyStr }
  (emitted_closure_cargo_package(slug: s).name != emitted_closure_rust_library_text())
    && (emitted_closure_binary_target(slug: s).name == emitted_closure_cargo_package(slug: s).name)
}

// THE IMPORT ALIAS STILL EQUALS THE PHYSICAL LIBRARY, AND THAT IS THE RENAME PRECONDITION STATED AS
// AN EXECUTING CLAIM RATHER THAN A PLAN. While this holds, authored Rust names the physical library
// directly, so renaming it edits every shim body. When the artifact owner lands a generated stable
// alias, this claim is the one that must be INVERTED -- and its inversion is the mechanical signal
// that the cheap rename has become available, which is a better trigger than a human remembering.
test fn the_import_alias_still_equals_the_physical_library_holds() -> Bool {
  emitted_closure_import_alias().alias == emitted_closure_rust_library_text()
}
