data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE ENTRY-BOUND MODELED OPERATION REALIZATION, EXERCISED THROUGH THE REAL DISPATCHER. Every subject
// below issues real extdeps.bmc operations -- directly, or through the production helper
// gunbc.machine_intake.oob_boot_handoff read_chassis_power, which issues ChassisStatus and runs the
// production decoder chassis_observation on what comes back. Nothing here constructs a decoded
// judgment: the model renders stdout and the production decoder reads it. Each claim asserts the
// ROUTE the dispatcher logged, not only the answer.
data realization_identity: NonEmptyStr = "bmc-dry-witness" as NonEmptyStr

fn modeled_grant(service: String, verb: std.effect_grant.Verb) -> Grant {
  Grant {
    verb: verb
    root: NamespacePosition { tree: ServiceOpTree { service: service }, path: [] }
    binding: ModeledRealization { realization: realization_identity as String }
    lifecycle: LifecycleByConstruction
  }
}

fn modeled_frame(realization: OperationRealization<BmcWorld>) -> WitnessEvaluationFrame<BmcWorld> {
  WitnessEvaluationFrame {
    envelope: Envelope {
      frame: Frame { name: "operation-realization-witness", kind: SharedStateFrame }
      grants: [
        modeled_grant(service: "diagnostic.ipmi.Tool", verb: Read),
        modeled_grant(service: "diagnostic.ipmi.Tool", verb: Write),
        modeled_grant(service: "sleep.Delay", verb: Write),
      ]
    }
    rest_fixtures: []
    realization: Present { value: realization }
  }
}

fn world(power_on: Bool) -> BmcWorld {
  bmc_world(power: if power_on { BmcPowerOn } else { BmcPowerOff })
}

fn read_power() -> ChassisPowerObservation {
  read_chassis_power(bmc_host: "bmc.test.invalid" as NonEmptyStr, username: "operator" as NonEmptyStr, password_file: "/nonexistent/credential" as NonEmptyStr, cipher_suite: Absent)
}

fn power_control(action: NonEmptyStr) -> Bool {
  diagnostic.ipmi.Tool.ChassisPowerControl(
    bmc_host: "bmc.test.invalid" as NonEmptyStr,
    username: "operator" as NonEmptyStr,
    password_file: "/nonexistent/credential" as NonEmptyStr,
    action: action,
    deadline: "5s" as NonEmptyStr,
    kill_after: "1s" as NonEmptyStr,
    cipher_suite_argv: ipmi_cipher_suite_argv(suite: Absent),
  ).success
}

fn route_operations(route: List<DispatchRecord>) -> List<String> {
  map(route, r => r.invocation.at.operation)
}

fn observed_on(o: ChassisPowerObservation) -> Bool {
  match o {
    ChassisPowerRead { power_on: on } => on
    _ => false
  }
}

fn observed_off(o: ChassisPowerObservation) -> Bool {
  match o {
    ChassisPowerRead { power_on: on } => !on
    _ => false
  }
}

fn every_record_observed(route: List<DispatchRecord>) -> Bool {
  all(route, r => match r.outcome { DispatchObserved { observation: _ } => true _ => false })
}

fn refused_with(reason_part: String, result_reason: String) -> Bool {
  string_contains(s: result_reason, pattern: reason_part)
}

// THE ENCODER ROUND-TRIPS THROUGH THE PRODUCTION DECODER. The line the dry adapter renders for each
// power state, fed to chassis_observation, reads back as that state -- so the dry route decodes by the
// same decoder a physical read reaches, and a rendering the decoder cannot read would red here first.
test fn the_status_rendering_round_trips_through_the_production_decoder() -> Bool {
  observed_on(o: chassis_observation(success: true, stdout: ipmitool_chassis_status_power_line(power_on: true)))
    && observed_off(o: chassis_observation(success: true, stdout: ipmitool_chassis_status_power_line(power_on: false)))
}

// A READ IS ANSWERED FROM THE WORLD AND DECODED BY THE PRODUCTION HELPER. Both power states are run so
// a realization that ignored its state could not pass, and the route shows exactly one ChassisStatus
// dispatched to this realization.
test fn a_dry_status_read_is_decoded_by_the_production_helper() -> Bool {
  let off = evaluate_in_witness_frame(
    frame: modeled_frame(realization: bmc_dry_realization(identity: realization_identity, initial: world(power_on: false), epoch: virtual_clock_origin())),
    subject: fn(_scope) { read_power() }
  )
  let on = evaluate_in_witness_frame(
    frame: modeled_frame(realization: bmc_dry_realization(identity: realization_identity, initial: world(power_on: true), epoch: virtual_clock_origin())),
    subject: fn(_scope) { read_power() }
  )
  (match off {
    WitnessReturned { value, route } =>
      observed_off(o: value) && route_operations(route: route) == ["ChassisStatus"] && every_record_observed(route: route)
        && all(route, r => r.realization == (realization_identity as String))
    _ => false
  }) && (match on {
    WitnessReturned { value, route } => observed_on(o: value) && route_operations(route: route) == ["ChassisStatus"]
    _ => false
  })
}

// THE DECODER IS UNDER TEST, NOT BYPASSED. A realization whose status handler prints a value the
// decoder does not recognise yields the decoder's own Undecodable arm through read_chassis_power: the
// verdict comes from production code reading scripted stdout, so no handler can hand back a decision.
fn unknown_status_handler(state: BmcWorld, call: OperationCall) -> OperationStep<BmcWorld> {
  OperationObserved {
    observation: ShellObserved { observation: ShellProcessExited { exit_code: 0, stdout: "System Power         : unknown\n", stderr: "" } },
    state: state,
    elapsed: second(count: 1),
  }
}

test fn an_unrecognised_rendering_reaches_the_decoders_own_refusal() -> Bool {
  let realization = OperationRealization {
    identity: realization_identity,
    initial: world(power_on: true),
    epoch: virtual_clock_origin(),
    bindings: [OperationBinding { at: bmc_ipmi_operation(operation: "ChassisStatus"), handler: unknown_status_handler }],
    advance: fn(s, now) { s },
  }
  match evaluate_in_witness_frame(frame: modeled_frame(realization: realization), subject: fn(_scope) { read_power() }) {
    WitnessReturned { value } => match value {
      ChassisStatusUndecodable { cause: _ } => true
      _ => false
    }
    _ => false
  }
}

// A WRITE CHANGES THE WORLD AND A LATER READ OBSERVES IT, in the order the subject issued them, and the
// frame returns the world the model ended in.
test fn a_write_transitions_the_world_and_a_later_read_observes_it() -> Bool {
  let result = evaluate_in_witness_frame(
    frame: modeled_frame(realization: bmc_dry_realization(identity: realization_identity, initial: world(power_on: false), epoch: virtual_clock_origin())),
    subject: fn(_scope) {
      let before = read_power()
      let accepted = power_control(action: "on" as NonEmptyStr)
      let after = read_power()
      observed_off(o: before) && accepted && observed_on(o: after)
    }
  )
  match result {
    WitnessReturned { value, route, state } =>
      value
        && route_operations(route: route) == ["ChassisStatus", "ChassisPowerControl", "ChassisStatus"]
        && map(route, r => r.ordinal) == [0, 1, 2]
        && match state { Present { value: w } => bmc_power_is_on(world: w) Absent => false }
    _ => false
  }
}

fn loss_fired_and_none_pending(w: BmcWorld) -> Bool {
  count(w.fired) == 1 && count(w.pending) == 0
}

// AN EVENT HAPPENS DURING A QUIET WAIT. The world is on with AC loss scheduled at t=3; the subject reads
// (t 0 -> 1), sleeps five seconds through the production sleep helper (t 1 -> 6), and reads again. The
// loss fired during the sleep with no operation issued at t=3, and the second read observes it.
test fn a_scheduled_event_fires_during_a_quiet_wait() -> Bool {
  let initial = bmc_with_pending(world: bmc_world(power: BmcPowerOn), pending: [BmcScheduledEvent { at: second(count: 3), event: BmcAcPowerLost {} }], fired: [])
  let result = evaluate_in_witness_frame(
    frame: modeled_frame(realization: bmc_dry_realization(identity: realization_identity, initial: initial, epoch: virtual_clock_origin())),
    subject: fn(_scope) {
      let first = read_power()
      let waited = sleep_delay_seconds_second_carrier_projection(duration: second(count: 5))
      let second_read = read_power()
      observed_on(o: first) && waited && observed_off(o: second_read)
    }
  )
  match result {
    WitnessReturned { value, route, state } =>
      value
        && route_operations(route: route) == ["ChassisStatus", "Seconds", "ChassisStatus"]
        && map(route, r => second_count(s: r.completed_at)) == [1, 6, 7]
        && match state { Present { value: w } => loss_fired_and_none_pending(w: w) Absent => false }
    _ => false
  }
}

// AN OPERATION THE REALIZATION DOES NOT BIND REFUSES, AND NOTHING ELSE ANSWERS IT. SensorList is
// covered by the grant and PUBLISHES a hermetic mock case (extdeps.bmc.mock_corpus), so a fallback to
// the mock layer would answer it; the frame refuses instead, and the route records the unbound
// dispatch after the read that preceded it.
test fn an_unbound_operation_refuses_and_is_not_mocked() -> Bool {
  let result = evaluate_in_witness_frame(
    frame: modeled_frame(realization: bmc_dry_realization(identity: realization_identity, initial: world(power_on: true), epoch: virtual_clock_origin())),
    subject: fn(_scope) {
      let first = read_power()
      let sensors = diagnostic.ipmi.Tool.SensorList(bmc_host: "bmc.test.invalid" as NonEmptyStr, cipher_suite_argv: ipmi_cipher_suite_argv(suite: Absent))
      sensors.success
    }
  )
  match result {
    WitnessRefused { diagnostic, route } =>
      refused_with(reason_part: "OperationNotBound", result_reason: witness_diagnostic_rendered_reason(diagnostic: diagnostic))
        && route_operations(route: route) == ["ChassisStatus", "SensorList"]
        && match route.skip(n: 1).first() { Present { value: r } => match r.outcome { DispatchUnbound { cause: _ } => true _ => false } Absent => false }
    _ => false
  }
}

// THE FRU FIXTURE IS THE COMMITTED CAPTURE, BYTE FOR BYTE. extdeps.bmc.ipmitool_observed_output
// ipmitool_fru_print_0_mt_collins is the literal the realization answers `fru print 0` with; its cited
// source is artifacts/bmc/mtcollins1-boot-run-40264233543/mtcollins1-boot-fru-print-0-40264233543.txt.
// The claim re-reads that committed artifact through the checkout-input carve-out and demands the
// literal equals it exactly -- 894 bytes, 22 newlines, and the ABSENCE of a final newline (the last
// byte is the last `X` of the final `Product Extra` line). A hand-typed drift, a stripped
// trailing blank, or a normalized line ending reds here rather than silently diverging the boot's
// retained inventory from the controller's answer. The digest projection is pinned too, so the comment's
// cited sha cannot rot away from the bytes.
fn fru_capture_text() -> String {
  Filesystem.Read(path: "artifacts/bmc/mtcollins1-boot-run-40264233543/mtcollins1-boot-fru-print-0-40264233543.txt").content
}

test fn the_fru_fixture_is_the_committed_capture_byte_for_byte() -> Bool {
  ipmitool_fru_print_0_mt_collins == fru_capture_text()
}

test fn the_fru_fixture_digest_is_the_cited_sha() -> Bool {
  sha256_digest_wire_form(digest: sha256_computed_digest(message: bytes_octets(b: utf8_encode_bytes(s: ipmitool_fru_print_0_mt_collins))))
    == "sha256:e3db166444d26c8a1a6ec44a398adc229f3b88b50e21c016aa8f5daf80dc3031" as NonEmptyStr
}

// THE BOOT'S `fru print 0` IS ANSWERED FROM THE CAPTURE, NOT REFUSED. The boot route dispatched
// diagnostic.ipmi.Tool.FruPrint in its pre-power retention and REFUSED at the unbound operation before
// ever reaching the fan gate or the identity writes (the four executed-frame claims of
// test.claim.host.managed_host_boot_witness were the red this binding repairs). Bound beside McInfo and
// HpmCheck in gunbc.bmc_dry_realization bmc_ipmi_bindings, the same call now returns the capture bytes,
// the route records one FruPrint dispatched and observed against THIS realization.
fn fru_print_0() -> String {
  let r = diagnostic.ipmi.Tool.FruPrint(
    bmc_host: "bmc.test.invalid" as NonEmptyStr,
    username: "operator" as NonEmptyStr,
    password_file: "/nonexistent/credential" as NonEmptyStr,
    fru_id: "0",
    deadline: "30",
    kill_after: "5",
    cipher_suite_argv: ipmi_cipher_suite_argv(suite: Absent),
  )
  if r.success { r.stdout } else { "" }
}

test fn a_bound_fru_print_zero_answers_the_committed_capture() -> Bool {
  match evaluate_in_witness_frame(
    frame: modeled_frame(realization: bmc_dry_realization(identity: realization_identity, initial: world(power_on: true), epoch: virtual_clock_origin())),
    subject: fn(_scope) { fru_print_0() }
  ) {
    WitnessReturned { value, route } =>
      value == ipmitool_fru_print_0_mt_collins
        && route_operations(route: route) == ["FruPrint"]
        && match route.first() {
          Present { value: r } => match r.outcome { DispatchObserved { observation: _ } => r.realization == (realization_identity as String) _ => false }
          Absent => false
        }
    _ => false
  }
}

// A PRINT OF ANY OTHER FRU ID FAULTS RATHER THAN BORROWING THE BOARD'S BYTES. The capture is of FRU 0,
// the board FRU the identity rows are read from. Answering `fru print 1` with FRU 0's stdout would be a
// fabricated reading -- an invented observation of a device the capture never asked. The handler checks
// the input and faults; the route shows the dispatch recorded as a harness fault, not an observation.
fn fru_print_1() -> Bool {
  let r = diagnostic.ipmi.Tool.FruPrint(
    bmc_host: "bmc.test.invalid" as NonEmptyStr,
    username: "operator" as NonEmptyStr,
    password_file: "/nonexistent/credential" as NonEmptyStr,
    fru_id: "1",
    deadline: "30",
    kill_after: "5",
    cipher_suite_argv: ipmi_cipher_suite_argv(suite: Absent),
  )
  r.success
}

test fn a_fru_print_of_another_id_faults_rather_than_borrowing_the_board_capture() -> Bool {
  match evaluate_in_witness_frame(
    frame: modeled_frame(realization: bmc_dry_realization(identity: realization_identity, initial: world(power_on: true), epoch: virtual_clock_origin())),
    subject: fn(_scope) { fru_print_1() }
  ) {
    WitnessRefused { diagnostic, route } =>
      refused_with(reason_part: "harness fault", result_reason: witness_diagnostic_rendered_reason(diagnostic: diagnostic))
        && route_operations(route: route) == ["FruPrint"]
        && match route.first() {
          Present { value: r } => match r.outcome { DispatchHarnessFault { reason: _ } => true _ => false }
          Absent => false
        }
    _ => false
  }
}

// THE CHECKOUT-INPUT CARVE-OUT DOES NOT ESCAPE THE FRAME. Under plain hermetic execution a readonly
// Filesystem.Read of a committed checkout path is a REAL read; under a modeled realization no grant
// covers Filesystem, so the same read refuses as uncovered.
test fn a_checkout_read_is_not_an_escape_from_the_frame() -> Bool {
  match evaluate_in_witness_frame(
    frame: modeled_frame(realization: bmc_dry_realization(identity: realization_identity, initial: world(power_on: true), epoch: virtual_clock_origin())),
    subject: fn(_scope) { count(filesystem_read_checkout_probe()) > 0 }
  ) {
    WitnessRefused { diagnostic } =>
      refused_with(reason_part: "OperationUncovered", result_reason: witness_diagnostic_rendered_reason(diagnostic: diagnostic))
    _ => false
  }
}

fn filesystem_read_checkout_probe() -> String {
  Filesystem.Read(path: "DESIGN.md").content
}

// A MALFORMED REALIZATION REFUSES BEFORE THE SUBJECT RUNS: one identity bound twice, and one binding
// whose identity names a file that does not declare the operation. The subject would return true, so a
// green here can only come from admission refusing it, and the route is empty.
test fn a_duplicate_binding_refuses_before_the_subject_runs() -> Bool {
  let realization = OperationRealization {
    identity: realization_identity,
    initial: world(power_on: true),
    epoch: virtual_clock_origin(),
    bindings: [
      OperationBinding { at: bmc_ipmi_operation(operation: "ChassisPowerControl"), handler: bmc_chassis_power_control_handler },
      OperationBinding { at: bmc_ipmi_operation(operation: "ChassisPowerControl"), handler: bmc_chassis_power_control_handler },
    ],
    advance: fn(s, now) { s },
  }
  match evaluate_in_witness_frame(frame: modeled_frame(realization: realization), subject: fn(_scope) { true }) {
    WitnessRefused { diagnostic, route } =>
      refused_with(reason_part: "binds one operation identity twice", result_reason: witness_diagnostic_rendered_reason(diagnostic: diagnostic))
        && count(route) == 0
    _ => false
  }
}

test fn a_binding_to_an_undeclared_identity_refuses_before_the_subject_runs() -> Bool {
  let misplaced = OperationRef { path: "dag/extdeps/bmc/ipmi_chassis_control.dag", service: "diagnostic.ipmi.Tool", operation: "ChassisStatus" }
  let realization = OperationRealization {
    identity: realization_identity,
    initial: world(power_on: true),
    epoch: virtual_clock_origin(),
    bindings: [OperationBinding { at: misplaced, handler: unknown_status_handler }],
    advance: fn(s, now) { s },
  }
  match evaluate_in_witness_frame(frame: modeled_frame(realization: realization), subject: fn(_scope) { true }) {
    WitnessRefused { diagnostic, route } =>
      refused_with(reason_part: "resolves to no declared operation", result_reason: witness_diagnostic_rendered_reason(diagnostic: diagnostic))
        && count(route) == 0
    _ => false
  }
}

// THE WORKER IS KILLED AFTER THE EFFECT AND BEFORE THE REPLY. The power-on commits (the world is on)
// and no reply ever reaches the subject, so the frame answers WitnessInterrupted -- never a manufactured
// return -- carrying the committed world and a route that ends at the killed dispatch. The enclosing
// witness is the supervisor: it resumes a SECOND attempt from that world in a new frame, and the
// resumed attempt reads before it writes and finds the host already on.
fn killed_after_power_on(state: BmcWorld, call: OperationCall) -> OperationStep<BmcWorld> {
  OperationWorkerKilled { committed: true, state: bmc_with_power(world: state, power: BmcPowerOn) }
}

test fn a_killed_worker_is_interrupted_and_a_resumed_attempt_reconciles() -> Bool {
  let realization = OperationRealization {
    identity: realization_identity,
    initial: world(power_on: false),
    epoch: virtual_clock_origin(),
    bindings: [
      OperationBinding { at: bmc_ipmi_operation(operation: "ChassisStatus"), handler: fn(s, c) { OperationObserved { observation: ShellObserved { observation: ShellProcessExited { exit_code: 0, stdout: ipmitool_chassis_status_power_line(power_on: bmc_power_is_on(world: s)), stderr: "" } }, state: s, elapsed: second(count: 1) } } },
      OperationBinding { at: bmc_ipmi_operation(operation: "ChassisPowerControl"), handler: killed_after_power_on },
    ],
    advance: fn(s, now) { s },
  }
  let first = evaluate_in_witness_frame(
    frame: modeled_frame(realization: realization),
    subject: fn(_scope) {
      let before = read_power()
      let accepted = power_control(action: "on" as NonEmptyStr)
      accepted
    }
  )
  match first {
    WitnessInterrupted { at, route, state, now } => {
      let resumed = evaluate_in_witness_frame(
        frame: modeled_frame(realization: bmc_dry_realization(identity: realization_identity, initial: state, epoch: now)),
        subject: fn(_scope) { read_power() }
      )
      at.invocation.at.operation == "ChassisPowerControl"
        && match at.outcome { DispatchWorkerKilled { committed: c } => c _ => false }
        && route_operations(route: route) == ["ChassisStatus", "ChassisPowerControl"]
        && bmc_power_is_on(world: state)
        && match resumed {
          WitnessReturned { value, route } => observed_on(o: value) && route_operations(route: route) == ["ChassisStatus"]
          _ => false
        }
    }
    _ => false
  }
}

// A HANDLER RECEIVES NO EFFECT CONTEXT. A handler that issues an operation -- here the sleep, which the
// realization does bind -- refuses rather than dispatching it, so a handler cannot reach live I/O even
// through an operation the frame would otherwise answer.
fn effectful_status_handler(state: BmcWorld, call: OperationCall) -> OperationStep<BmcWorld> {
  let waited = sleep_delay_seconds_second_carrier_projection(duration: second(count: 1))
  OperationObserved {
    observation: ShellObserved { observation: ShellProcessExited { exit_code: 0, stdout: ipmitool_chassis_status_power_line(power_on: waited), stderr: "" } },
    state: state,
    elapsed: second(count: 1),
  }
}

test fn a_handler_that_issues_an_operation_refuses() -> Bool {
  let realization = OperationRealization {
    identity: realization_identity,
    initial: world(power_on: true),
    epoch: virtual_clock_origin(),
    bindings: [OperationBinding { at: bmc_ipmi_operation(operation: "ChassisStatus"), handler: effectful_status_handler }],
    advance: fn(s, now) { s },
  }
  match evaluate_in_witness_frame(frame: modeled_frame(realization: realization), subject: fn(_scope) { read_power() }) {
    WitnessRefused { diagnostic, route } =>
      refused_with(reason_part: "handlers receive no effect context", result_reason: witness_diagnostic_rendered_reason(diagnostic: diagnostic))
        && only_record_failed_at(route: route, operation: "ChassisStatus", stage_is_handler: true)
    _ => false
  }
}

// THE REALIZATION DOES NOT OUTLIVE ITS FRAME.
test fn the_realization_does_not_escape_its_frame() -> Bool {
  let inside = evaluate_in_witness_frame(
    frame: modeled_frame(realization: bmc_dry_realization(identity: realization_identity, initial: world(power_on: true), epoch: virtual_clock_origin())),
    subject: fn(_scope) { witness_evaluation_frame_active() }
  )
  (match inside { WitnessReturned { value } => value _ => false }) && !witness_evaluation_frame_active()
}

// THE RECORD OF A DISPATCH WHOSE CALLBACK FAILED: exactly one record, for this operation, at ordinal 0,
// whose outcome is the callback failure at the named stage -- never an observation.
fn only_record_failed_at(route: List<DispatchRecord>, operation: String, stage_is_handler: Bool) -> Bool {
  count(route) == 1 && all(route, r =>
    r.ordinal == 0 && r.invocation.at.operation == operation && match r.outcome {
      DispatchCallbackFailed { stage, cause } => (match stage { HandlerFailed => stage_is_handler AdvanceFailed => !stage_is_handler }) && cause != ""
      _ => false
    })
}

// A HANDLER THAT THROWS still leaves its dispatch recorded, with the original cause propagated.
fn throwing_status_handler(state: BmcWorld, call: OperationCall) -> OperationStep<BmcWorld> {
  let zero = count(call.invocation.bindings) - count(call.invocation.bindings)
  OperationObserved {
    observation: ShellObserved { observation: ShellProcessExited { exit_code: 100 / zero, stdout: "", stderr: "" } },
    state: state,
    elapsed: second(count: 1),
  }
}

test fn a_throwing_handler_keeps_its_dispatch_record() -> Bool {
  let realization = OperationRealization {
    identity: realization_identity,
    initial: world(power_on: true),
    epoch: virtual_clock_origin(),
    bindings: [OperationBinding { at: bmc_ipmi_operation(operation: "ChassisStatus"), handler: throwing_status_handler }],
    advance: fn(s, now) { s },
  }
  match evaluate_in_witness_frame(frame: modeled_frame(realization: realization), subject: fn(_scope) { read_power() }) {
    WitnessRefused { diagnostic, route } =>
      only_record_failed_at(route: route, operation: "ChassisStatus", stage_is_handler: true)
        && !refused_with(reason_part: "modeled operation realization refused", result_reason: witness_diagnostic_rendered_reason(diagnostic: diagnostic))
    _ => false
  }
}

// AN advance THAT FAILS after an observed step leaves the record too, at the advance stage. It holds at
// the epoch (admission applies it at t=0) and throws once time has moved.
fn advance_failing_after_origin(state: BmcWorld, now: Second) -> BmcWorld {
  let moved = second_count(s: now) as Int
  if moved == 0 { state } else if 100 / (moved - moved) > 0 { state } else { state }
}

test fn a_failing_advance_keeps_its_dispatch_record() -> Bool {
  let realization = OperationRealization {
    identity: realization_identity,
    initial: world(power_on: true),
    epoch: virtual_clock_origin(),
    bindings: [OperationBinding { at: bmc_ipmi_operation(operation: "ChassisStatus"), handler: fn(s, c) { OperationObserved { observation: ShellObserved { observation: ShellProcessExited { exit_code: 0, stdout: ipmitool_chassis_status_power_line(power_on: true), stderr: "" } }, state: s, elapsed: second(count: 1) } } }],
    advance: advance_failing_after_origin,
  }
  match evaluate_in_witness_frame(frame: modeled_frame(realization: realization), subject: fn(_scope) { read_power() }) {
    WitnessRefused { route } => only_record_failed_at(route: route, operation: "ChassisStatus", stage_is_handler: false)
    _ => false
  }
}

// FRAME COMPOSITION: no frame opens inside an active modeled realization, whatever it carries. Each
// nested attempt below would, if admitted, let an operation escape the outer realization (the
// published SensorList mock, the checkout read carve-out, a second model). Each is refused before its
// subject runs, the escaping operation never dispatches, and the outer route holds only the outer
// operations. The spellings differ on purpose: no realization, another realization, the same one.
test fn a_nested_frame_cannot_open_inside_a_modeled_realization() -> Bool {
  let other = OperationRealization {
    identity: "another-realization" as NonEmptyStr,
    initial: world(power_on: false),
    epoch: virtual_clock_origin(),
    bindings: [OperationBinding { at: bmc_ipmi_operation(operation: "ChassisStatus"), handler: unknown_status_handler }],
    advance: fn(s, now) { s },
  }
  let result = evaluate_in_witness_frame(
    frame: modeled_frame(realization: bmc_dry_realization(identity: realization_identity, initial: world(power_on: true), epoch: virtual_clock_origin())),
    subject: fn(_scope) {
      let before = read_power()
      let bare = evaluate_in_witness_frame(
        frame: WitnessEvaluationFrame { envelope: modeled_frame(realization: other).envelope, rest_fixtures: [], realization: none },
        subject: fn(_s) { diagnostic.ipmi.Tool.SensorList(bmc_host: "bmc.test.invalid" as NonEmptyStr, cipher_suite_argv: ipmi_cipher_suite_argv(suite: Absent)).success }
      )
      let foreign = evaluate_in_witness_frame(
        frame: modeled_frame(realization: other),
        subject: fn(_s) { count(filesystem_read_checkout_probe()) > 0 }
      )
      let same = evaluate_in_witness_frame(
        frame: modeled_frame(realization: bmc_dry_realization(identity: realization_identity, initial: world(power_on: false), epoch: virtual_clock_origin())),
        subject: fn(_s) { observed_off(o: read_power()) }
      )
      let after = read_power()
      nested_frame_refused_before_its_subject(r: bare)
        && nested_frame_refused_before_its_subject(r: foreign)
        && nested_frame_refused_before_its_subject(r: same)
        && observed_on(o: before) && observed_on(o: after)
    }
  )
  match result {
    WitnessReturned { value, route } => value && route_operations(route: route) == ["ChassisStatus", "ChassisStatus"]
    _ => false
  }
}

fn nested_frame_refused_before_its_subject<A, S>(r: v2.std.witness_evaluation.WitnessEvaluation<A, S>) -> Bool {
  match r {
    WitnessRefused { diagnostic, route } =>
      refused_with(reason_part: "cannot open while a modeled operation realization is active", result_reason: witness_diagnostic_rendered_reason(diagnostic: diagnostic))
        && count(route) == 0
    _ => false
  }
}

// AFTER THE OUTER SCOPE ENDS, frames compose again: a frame without a realization evaluates, and a fresh
// modeled frame starts at the origin rather than at any earlier scenario's clock.
test fn frames_are_independent_after_the_outer_scope_ends() -> Bool {
  let outer = evaluate_in_witness_frame(
    frame: modeled_frame(realization: bmc_dry_realization(identity: realization_identity, initial: world(power_on: true), epoch: virtual_clock_origin())),
    subject: fn(_scope) { observed_on(o: read_power()) && observed_on(o: read_power()) }
  )
  let plain = evaluate_in_witness_frame(
    frame: WitnessEvaluationFrame { envelope: modeled_frame(realization: bmc_dry_realization(identity: realization_identity, initial: world(power_on: true), epoch: virtual_clock_origin())).envelope, rest_fixtures: [], realization: none },
    subject: fn(_scope) { true }
  )
  let fresh = evaluate_in_witness_frame(
    frame: modeled_frame(realization: bmc_dry_realization(identity: realization_identity, initial: world(power_on: false), epoch: virtual_clock_origin())),
    subject: fn(_scope) { observed_off(o: read_power()) }
  )
  (match outer { WitnessReturned { value } => value _ => false })
    && (match plain { WitnessReturned { value } => value _ => false })
    && (match fresh {
      WitnessReturned { value, route } => value && map(route, r => second_count(s: r.completed_at)) == [1]
      _ => false
    })
}

// RESUME KEEPS THE CLOCK. Power is lost at t=5. Uninterrupted: read (t 0->1), sleep 4 (->5, the loss
// fires), read -> off. Interrupted at t=3: read (->1), sleep 2 (->3), the power control is killed at 3
// with nothing committed; the frame reports now = 3. The resumed attempt starts at that epoch -- modeled
// time did not advance while the worker was absent -- reads at 3->4 (still on), sleeps 1 (->5, the loss
// fires) and reads off, exactly as the uninterrupted history does. Had the resume restarted at the
// origin its reads would complete at 1 and the loss would not yet have fired.
fn loss_at_five() -> BmcWorld {
  bmc_with_pending(world: bmc_world(power: BmcPowerOn), pending: [BmcScheduledEvent { at: second(count: 5), event: BmcAcPowerLost {} }], fired: [])
}

fn killed_without_commit(state: BmcWorld, call: OperationCall) -> OperationStep<BmcWorld> {
  OperationWorkerKilled { committed: false, state: state }
}

test fn a_resumed_attempt_keeps_the_interrupted_clock() -> Bool {
  let uninterrupted = evaluate_in_witness_frame(
    frame: modeled_frame(realization: bmc_dry_realization(identity: realization_identity, initial: loss_at_five(), epoch: virtual_clock_origin())),
    subject: fn(_scope) {
      let first = read_power()
      let waited = sleep_delay_seconds_second_carrier_projection(duration: second(count: 4))
      observed_on(o: first) && waited && observed_off(o: read_power())
    }
  )
  let dry = bmc_dry_realization(identity: realization_identity, initial: loss_at_five(), epoch: virtual_clock_origin())
  let interrupted = evaluate_in_witness_frame(
    frame: modeled_frame(realization: OperationRealization { identity: dry.identity, initial: dry.initial, epoch: dry.epoch, bindings: without_power_control(bindings: dry.bindings, extra: killed_without_commit), advance: dry.advance }),
    subject: fn(_scope) {
      let first = read_power()
      let waited = sleep_delay_seconds_second_carrier_projection(duration: second(count: 2))
      power_control(action: "on" as NonEmptyStr)
    }
  )
  (match uninterrupted { WitnessReturned { value } => value _ => false })
    && match interrupted {
      WitnessInterrupted { at, state, now } => {
        let resumed = evaluate_in_witness_frame(
          frame: modeled_frame(realization: bmc_dry_realization(identity: realization_identity, initial: state, epoch: now)),
          subject: fn(_scope) {
            let first = read_power()
            let waited = sleep_delay_seconds_second_carrier_projection(duration: second(count: 1))
            observed_on(o: first) && waited && observed_off(o: read_power())
          }
        )
        second_count(s: now) == 3 && second_count(s: at.dispatched_at) == 3
          && match resumed {
            WitnessReturned { value, route } => value && map(route, r => second_count(s: r.completed_at)) == [4, 5, 6]
            _ => false
          }
      }
      _ => false
    }
}

fn without_power_control(bindings: List<OperationBinding<BmcWorld>>, extra: fn(BmcWorld, OperationCall) -> OperationStep<BmcWorld>) -> List<OperationBinding<BmcWorld>> {
  list_append(
    filter(bindings, b => b.at.operation != "ChassisPowerControl"),
    OperationBinding { at: bmc_ipmi_operation(operation: "ChassisPowerControl"), handler: extra },
  )
}

// THE ADMISSION DECISION THE DISPATCHER ASKS, executed on all three modes: only Hermetic admits a
// modeled realization; Wet and Record, which dispatch real effects, refuse. The dispatcher reaches this
// function (admit_modeled_realization); the refusal it produces under a real Wet run was executed
// locally with claim_batch --wet and is recorded on gunbc#12486.
test fn only_a_hermetic_run_admits_a_modeled_realization() -> Bool {
  modeled_realization_admitted_in(mode: Hermetic)
    && !modeled_realization_admitted_in(mode: Wet)
    && !modeled_realization_admitted_in(mode: Record)
}

// ─── THE CLEAR OF PARAMETER 5: BOUND AT LAST, AND JUDGED BY ITS READBACK ──────────────────────────
// `Tool.ChassisBootDev` -- the plain form, no options input -- had ZERO production callers and NO binding
// until boot 7, so a route that wanted to drop a pending override had nothing to dispatch and parameter 5
// stayed set across the exit (the boot-5/6 lockout: runs 40258937016, 40264233543). The three claims below
// hold the repair to three separate things that can each break: the binding must MOVE THE WORLD; the
// readback must be the thing the verdict comes from; and the echo's bytes must be held as what they are --
// a derived row keyed to the firmware two captures were read on, never a capture (merry-fox-82 ruling
// msg_c21159d5).

fn bootdev_clear(device: NonEmptyStr) -> Bool {
  diagnostic.ipmi.Tool.ChassisBootDev(
    bmc_host: "bmc.test.invalid" as NonEmptyStr,
    username: "operator" as NonEmptyStr,
    password_file: "/nonexistent/credential" as NonEmptyStr,
    device: device,
    cipher_suite_argv: ipmi_cipher_suite_argv(suite: Absent),
  ).success
}

fn bootparam5_read() -> String {
  let r = diagnostic.ipmi.Tool.ChassisBootParamGet(
    bmc_host: "bmc.test.invalid" as NonEmptyStr,
    username: "operator" as NonEmptyStr,
    password_file: "/nonexistent/credential" as NonEmptyStr,
    parameter: "5",
    deadline: "5s" as NonEmptyStr,
    kill_after: "1s" as NonEmptyStr,
    cipher_suite_argv: ipmi_cipher_suite_argv(suite: Absent),
  )
  if r.success { r.stdout } else { "" }
}

fn override_is_cleared(w: BmcWorld?) -> Bool {
  match w {
    Present { value: world } => match world.boot_override {
      BootOverrideNone => true
      BootOverrideCdromEfiNextBoot => false
    }
    Absent => false
  }
}

// THE CLEAR MOVES THE WORLD, AND THE READ AFTER IT SAYS SO. One dispatch of the plain operation, between
// two parameter-5 reads: the read before names the override, the world afterwards holds none, and the read
// after it answers from the COMMITTED cleared capture -- 'Boot parameter data: 0000000000' and 'Boot Device
// Selector : No override', both verbatim in extdeps.bmc.ipmitool_observed_output
// ipmitool_bootparam5_no_override. A binding that printed the echo without moving the world -- which is
// what the fixture's own standing warns about -- reds on the world AND on the second read, because the
// read is answered from the world.
test fn clearing_the_override_moves_the_world_and_the_read_after_it_says_so() -> Bool {
  let seeded = bmc_with_override(world: world(power_on: true), over: BootOverrideCdromEfiNextBoot)
  match evaluate_in_witness_frame(
    frame: modeled_frame(realization: bmc_dry_realization(identity: realization_identity, initial: seeded, epoch: virtual_clock_origin())),
    subject: fn(_scope) {
      let before = bootparam5_read()
      let cleared = bootdev_clear(device: ipmi_boot_device_none)
      let after = bootparam5_read()
      cleared
        && string_contains(s: before, pattern: "Boot parameter data: a014000000")
        && string_contains(s: before, pattern: "Boot Device Selector : Force Boot from CD/DVD")
        && string_contains(s: after, pattern: "Boot parameter data: 0000000000")
        && string_contains(s: after, pattern: "Boot Device Selector : No override")
    }
  ) {
    WitnessReturned { value, route, state } =>
      value
        && route_operations(route: route) == ["ChassisBootParamGet", "ChassisBootDev", "ChassisBootParamGet"]
        && every_record_observed(route: route)
        && override_is_cleared(w: state)
    _ => false
  }
}

// A CLEAR THAT DID NOT LAND IS READ AS STILL PENDING, NOT AS CLEARED BY ITS OWN WORDS. The same route, over
// a realization whose ChassisBootDev handler answers the vendor's echo and clears NOTHING: the subject sees
// the same stdout it would have seen from the real binding, and the parameter-5 read afterwards still names
// the override. This is the claim merry-fox-82's ruling asks for in the only form that can be checked --
// nothing in the model may judge a clear from that stdout, because a handler that lies about the clear is
// indistinguishable from the honest one EXCEPT through the readback.
fn lying_clear_realization(initial: BmcWorld) -> OperationRealization<BmcWorld> {
  OperationRealization {
    identity: realization_identity,
    initial: initial,
    epoch: virtual_clock_origin(),
    bindings: [
      OperationBinding { at: bmc_ipmi_operation(operation: "ChassisStatus"), handler: bmc_lift(get: fn(w) { w }, put: fn(w, next) { next }, reply: bmc_chassis_status_reply) },
      OperationBinding { at: bmc_ipmi_operation(operation: "ChassisBootParamGet"), handler: bmc_lift(get: fn(w) { w }, put: fn(w, next) { next }, reply: bmc_bootparam_get_reply) },
      OperationBinding {
        at: bmc_ipmi_operation(operation: "ChassisBootDev"),
        handler: fn(world, call) {
          OperationObserved {
            observation: ShellObserved { observation: ShellProcessExited { exit_code: 0, stdout: ipmitool_bootdev_none_reply.bytes, stderr: "" } },
            state: world,
            elapsed: second(count: 1),
          }
        }
      },
    ],
    advance: bmc_advance,
  }
}

test fn a_clear_that_did_not_land_is_still_read_as_pending() -> Bool {
  let seeded = bmc_with_override(world: world(power_on: true), over: BootOverrideCdromEfiNextBoot)
  match evaluate_in_witness_frame(
    frame: modeled_frame(realization: lying_clear_realization(initial: seeded)),
    subject: fn(_scope) {
      let cleared = bootdev_clear(device: ipmi_boot_device_none)
      let after = bootparam5_read()
      cleared && string_contains(s: after, pattern: "Boot parameter data: a014000000")
    }
  ) {
    WitnessReturned { value, route, state } =>
      value
        && route_operations(route: route) == ["ChassisBootDev", "ChassisBootParamGet"]
        && !override_is_cleared(w: state)
    _ => false
  }
}

// THE ECHO'S BYTES ARE A DERIVED ROW, KEYED -- NOT A CAPTURE. The standing is typed, and the type is what
// keeps the two kinds of evidence apart: this row names the two MegaRAC 0.32 captures its shape came from,
// and it is offered for 0.32 only. A machine on any other release gets no answer at all, because the
// vendor's echo was never read there -- and the row must not quietly become a vendor-wide claim by someone
// deleting the key.
test fn the_clears_echo_is_a_firmware_keyed_derived_row() -> Bool {
  match ipmitool_bootdev_none_reply_standing {
    BootdevEchoDerivedFromShape { shape_captures: captures, read_obligation: _, read_on_release: keyed } =>
      list_length(items: captures) == 2
        && any(captures, c => string_contains(s: c as String, pattern: "30-bootdev.txt"))
        && any(captures, c => string_contains(s: c as String, pattern: "intake-write-exercise.json"))
        // THE KEY IS THE ROW'S OWN, and it is the release the model runs: the derived row states the
        // firmware its two shape captures were read on, and the model's identity comes from the `mc info`
        // reading (gunbc.machine_intake.mtcollins1_access_observation mtcollins1_firmware). Two independent
        // values meeting in a typed comparison -- not one number written twice and guarded by a string
        // search (DESIGN §3/§5, review 87774). If either moves, the clear stops answering at all.
        && (keyed == bmc_dry_bmc_firmware_release)
    BootdevEchoTranscribed { capture: _ } => false
  }
    && match ipmitool_bootdev_none_reply_for(firmware_release: bmc_dry_bmc_firmware_release) {
         Present { value: reply } => reply == ipmitool_bootdev_none_reply
         Absent => false
       }
    && match ipmitool_bootdev_none_reply_for(firmware_release: "0.45.01" as NonEmptyStr) {
         Absent => true
         Present { value: _ } => false
       }
    && (ipmitool_bootdev_none_reply.bytes == "Set Boot Device to none\n")
  // THE CAPTURE AND THE GUESS ARE CITED DIFFERENTLY, in the same command family: the cdrom echo names the
  // file and digest it was read out of -- the same citation that seeds the derived row's shape captures, so
  // the two cannot disagree about where the capture is.
    && match ipmitool_bootdev_cdrom_reply_standing {
         BootdevEchoTranscribed { capture: c } => c == bootdev_cdrom_echo_capture
         BootdevEchoDerivedFromShape { shape_captures: _, read_obligation: _, read_on_release: _ } => false
       }
}

// THE STANDING IS AT THE POINT OF CONSUMPTION, NOT BESIDE IT (review 87774, DESIGN §4b(1)). Delegating
// handler: it asks the PRODUCTION bmc_bootdev_clear_reply for the clear's answer and completes only if the
// reply that reaches this consumer carries the derived standing with its bytes. A reply that handed the
// guessed line over unlabelled -- or handed back a capture's citation for a line that is not one -- faults
// the route here, which is what keeps the standing from being an inert field someone matches with '_'.
// THE CLEAR PRINTS THE BYTES OF THE ROW IT WAS GIVEN -- and nothing else. The derived echo exists in exactly
// one place (extdeps.bmc.ipmitool_observed_output ObservedBootdevReply, review 87774); this binding delegates
// the clear to the PRODUCTION reply function and faults the route if what it printed is not that row's bytes,
// so a second hand-written copy of the guess cannot appear at the one site that prints it. The world change
// and the parameter-5 readback afterwards are the real ones.
fn clear_prints_the_row_it_is_given_realization(initial: BmcWorld) -> OperationRealization<BmcWorld> {
  OperationRealization {
    identity: realization_identity,
    initial: initial,
    epoch: virtual_clock_origin(),
    bindings: [
      OperationBinding { at: bmc_ipmi_operation(operation: "ChassisStatus"), handler: bmc_lift(get: fn(w) { w }, put: fn(w, next) { next }, reply: bmc_chassis_status_reply) },
      OperationBinding { at: bmc_ipmi_operation(operation: "ChassisBootParamGet"), handler: bmc_lift(get: fn(w) { w }, put: fn(w, next) { next }, reply: bmc_bootparam_get_reply) },
      OperationBinding {
        at: bmc_ipmi_operation(operation: "ChassisBootDev"),
        handler: fn(world, call) {
          match bmc_bootdev_clear_reply(world: world, call: call) {
            BmcReplyFault { reason: r } => OperationHarnessFault { reason: r }
            BmcReplied { stdout: out, world: w } => if out == ipmitool_bootdev_none_reply.bytes {
              OperationObserved {
                observation: ShellObserved { observation: ShellProcessExited { exit_code: 0, stdout: out, stderr: "" } },
                state: w,
                elapsed: second(count: 1),
              }
            } else {
              OperationHarnessFault { reason: "the dry clear printed something other than the bytes of the firmware-keyed row it is given" as NonEmptyStr }
            }
          }
        }
      },
    ],
    advance: bmc_advance,
  }
}

test fn the_clear_prints_the_bytes_of_the_row_it_is_given() -> Bool {
  let seeded = bmc_with_override(world: world(power_on: true), over: BootOverrideCdromEfiNextBoot)
  match evaluate_in_witness_frame(
    frame: modeled_frame(realization: clear_prints_the_row_it_is_given_realization(initial: seeded)),
    subject: fn(_scope) {
      let cleared = bootdev_clear(device: ipmi_boot_device_none)
      let after = bootparam5_read()
      cleared && string_contains(s: after, pattern: "Boot parameter data: 0000000000")
    }
  ) {
    WitnessReturned { value, route, state } =>
      value
        && route_operations(route: route) == ["ChassisBootDev", "ChassisBootParamGet"]
        && override_is_cleared(w: state)
    _ => false
  }
}

// THE CLEAR'S DEVICE WORD IS THE ONE THE MODEL CARRIES, and the plain operation carries nothing else: a
// device that would SET an override (rather than drop it) is refused on this operation, so the clear can
// never be reached by a write. Both arms run against the real binding.
test fn the_plain_bootdev_operation_carries_the_clear_device_only() -> Bool {
  let refused = evaluate_in_witness_frame(
    frame: modeled_frame(realization: bmc_dry_realization(identity: realization_identity, initial: world(power_on: true), epoch: virtual_clock_origin())),
    subject: fn(_scope) { bootdev_clear(device: "cdrom" as NonEmptyStr) }
  )
  match refused {
    WitnessRefused { diagnostic, route } =>
      refused_with(reason_part: "ChassisBootDev", result_reason: witness_diagnostic_rendered_reason(diagnostic: diagnostic))
        && route_operations(route: route) == ["ChassisBootDev"]
    _ => false
  }
}

// SdrElistVerbose (the conditional verbose SDR capture feeding the thermal admission rule): the
// dry world deliberately does NOT answer it. Verbose record bytes are vendor output, and until a
// real capture is committed any dry reply would be synthetic evidence - the very thing the
// admission rule must be grounded on, not fabricated (manager msg_4049c507). So a dispatched
// verbose read surfaces as a harness fault carrying the grounding reason, and the route records
// the dispatch; the wet lane answers it for real.
fn sdr_elist_verbose_call() -> Bool {
  let r = diagnostic.ipmi.Tool.SdrElistVerbose(
    bmc_host: "bmc.test.invalid" as NonEmptyStr,
    username: "operator" as NonEmptyStr,
    password_file: "/nonexistent/credential" as NonEmptyStr,
    deadline: "30",
    kill_after: "5",
    cipher_suite_argv: ipmi_cipher_suite_argv(suite: Absent),
  )
  r.success
}

test fn a_dispatched_verbose_sdr_read_faults_with_the_grounding_reason() -> Bool {
  match evaluate_in_witness_frame(
    frame: modeled_frame(realization: bmc_dry_realization(identity: realization_identity, initial: world(power_on: true), epoch: virtual_clock_origin())),
    subject: fn(_scope) { sdr_elist_verbose_call() }
  ) {
    WitnessRefused { diagnostic, route } =>
      refused_with(reason_part: "no committed verbose SDR capture", result_reason: witness_diagnostic_rendered_reason(diagnostic: diagnostic))
        && route_operations(route: route) == ["SdrElistVerbose"]
        && match route.first() {
          Present { value: r } => match r.outcome { DispatchHarnessFault { reason: _ } => true _ => false }
          Absent => false
        }
    _ => false
  }
}

// THE CONDITIONAL VERBOSE CAPTURE, END TO END IN THE MODEL. The fan round reads the world's own SDR
// surface through the dry realization, so the CONDITION on the verbose read is measured, not asserted:
// a round whose thermal rows all decode never dispatches SdrElistVerbose, and a round left with a row
// without a reading - the boot-5 refusal shape - dispatches it in the very same round, right after the
// reads that failed to answer it. The dry world then refuses to ANSWER that read: verbose record bytes
// come only from a committed capture, never from the model (the row above proves the refusal itself).
// The records below are unit shape - written to exercise the condition - not vendor captures.
fn unit_sdr_record(sensor_type: String, name: String, number: String, status: String, entity: String, reading: String) -> BmcSdrRecord {
  BmcSdrRecord {
    sensor_type: sensor_type as NonEmptyStr,
    line: SdrTypeLine { name: name as NonEmptyStr, sensor_number: number as NonEmptyStr, status: status as NonEmptyStr, entity_id: entity as NonEmptyStr, reading_text: reading as NonEmptyStr },
  }
}

fn fan_round_surface(temps: List<BmcSdrRecord>, fans: List<BmcSdrRecord>) -> BmcWorld {
  bmc_with_record_surfaces(world: bmc_world(power: BmcPowerOn), surfaces: BmcRecordSurfaces {
    manager_date_time: none,
    log_services: none,
    account_events: none,
    virtual_media: none,
    sensors: none,
    ipmi_sdr: Present { value: concat(temps, fans) },
  })
}

fn fan_round_subject() -> FanObservationRound {
  observe_fan_round(bmc_host: "bmc.test.invalid" as NonEmptyStr, username: "operator" as NonEmptyStr, password_file: "/nonexistent/credential" as NonEmptyStr, round_index: 0, cipher_suite: Absent)
}

test fn a_round_whose_thermal_rows_all_decode_never_asks_for_the_verbose_read() -> Bool {
  match evaluate_in_witness_frame(
    frame: modeled_frame(realization: bmc_dry_realization(identity: realization_identity, initial: fan_round_surface([unit_sdr_record("Temperature", "CPU0_Temp", "01h", "ok", "3.1", "45 degrees C")], [unit_sdr_record("Fan", "FAN4_0_Speed", "00h", "ok", "29.1", "5700 RPM")]), epoch: virtual_clock_origin())),
    subject: fn(_scope) { fan_round_subject() }
  ) {
    WitnessReturned { value, route } =>
      route_operations(route: route) == ["ChassisStatus", "SdrTypeList", "SdrTypeList"]
        && match value.verbose {
          SdrVerboseNotRequired => true
          _ => false
        }
    _ => false
  }
}

test fn a_round_left_with_an_unread_thermal_row_asks_for_the_verbose_read_in_the_same_round() -> Bool {
  match evaluate_in_witness_frame(
    frame: modeled_frame(realization: bmc_dry_realization(identity: realization_identity, initial: fan_round_surface([unit_sdr_record("Temperature", "PSU2_Status", "EBh", "ok", "0.0", " ")], [unit_sdr_record("Fan", "FAN4_0_Speed", "00h", "ok", "29.1", "5700 RPM")]), epoch: virtual_clock_origin())),
    subject: fn(_scope) { fan_round_subject() }
  ) {
    WitnessRefused { diagnostic, route } =>
      refused_with(reason_part: "no committed verbose SDR capture", result_reason: witness_diagnostic_rendered_reason(diagnostic: diagnostic))
        && route_operations(route: route) == ["ChassisStatus", "SdrTypeList", "SdrTypeList", "SdrElistVerbose"]
    _ => false
  }
}
