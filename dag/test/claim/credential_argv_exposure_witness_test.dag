module test.claim.credential_argv_exposure_witness

import gunbc.ci_spec {
  gunbc_ci_fleet_key_agent_script,
  gunbc_ci_spark_grant_install_invoke,
  gunbc_ci_auth_header_file_write_command,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THIS WITNESS ASSERTS TWO THINGS, AND ONE OF THEM ALONE WOULD BE A DECORATION. The absence of the
// leaking spelling is the safety property; the presence of the file-backed one is what makes the
// absence mean the credential still ARRIVES rather than that the step stopped authenticating. A
// prelude that had simply dropped the header would satisfy an absence-only check perfectly, which is
// the failure mode extdeps.llm.cursor_sdk already records under a different name: an argv that is
// clean because it is broken.
//
// The subject is the EMITTED SHELL rather than the committed workflow file, deliberately. The
// committed .github/workflows/fleet-converge.yml is a projection of these functions; asserting
// against it would test whether someone remembered to regenerate, while asserting against the
// emission tests the authority that decides what any future regeneration produces.

data forbidden_bearer_interpolation: String = "Authorization: Bearer $WIF_ACCESS_TOKEN"

// THE RED ARM IS AUTHORABLE, which is what distinguishes this from a check that is green by
// construction: restoring the old spelling in either prelude turns these two tests red, and that is
// exactly the edit a future author would make by copying a neighbouring curl invocation.
test fn fleet_key_prelude_does_not_interpolate_the_token_into_a_command() -> Bool {
  !string_contains(s: gunbc_ci_fleet_key_agent_script(), pattern: forbidden_bearer_interpolation)
    && string_contains(s: gunbc_ci_fleet_key_agent_script(), pattern: "-H @\"$HDR_FILE\"")
}

test fn spark_grant_prelude_does_not_interpolate_the_token_into_a_command() -> Bool {
  !string_contains(s: gunbc_ci_spark_grant_install_invoke(), pattern: forbidden_bearer_interpolation)
    && string_contains(s: gunbc_ci_spark_grant_install_invoke(), pattern: "-H @\"$HDR_FILE\"")
}

// THE WRITER MUST BE A BUILTIN, and this is the assertion most likely to be lost in a later edit
// because it looks like a formatting preference. It is not: `printf` runs inside the shell process
// and forks nothing, so the token exists in the shell's memory and in the file. Any EXTERNAL command
// writing the same bytes -- echo as a binary, a here-doc through tee, a python one-liner -- would
// leave the value in ITS OWN argv, relocating the exposure rather than removing it. A reviewer who
// swaps printf for tee has not made a cosmetic change, and this test is what says so.
test fn the_auth_header_is_written_by_a_shell_builtin_not_an_external_command() -> Bool {
  string_contains(s: gunbc_ci_auth_header_file_write_command(), pattern: "printf ")
    && !string_contains(s: gunbc_ci_auth_header_file_write_command(), pattern: "tee ")
    && !string_contains(s: gunbc_ci_auth_header_file_write_command(), pattern: "python")
}

// Both preludes must reach the writer, since a header file that is never written makes `-H @FILE` a
// curl error rather than a leak -- loud, but a different failure than the one under test, and one a
// reader would mistake for this repair having been abandoned.
test fn both_preludes_write_the_header_file_before_using_it() -> Bool {
  string_contains(s: gunbc_ci_fleet_key_agent_script(), pattern: "printf 'Authorization: Bearer")
    && string_contains(s: gunbc_ci_spark_grant_install_invoke(), pattern: "printf 'Authorization: Bearer")
}

test fn credential_argv_exposure_witness() -> Bool {
  fleet_key_prelude_does_not_interpolate_the_token_into_a_command()
    && spark_grant_prelude_does_not_interpolate_the_token_into_a_command()
    && the_auth_header_is_written_by_a_shell_builtin_not_an_external_command()
    && both_preludes_write_the_header_file_before_using_it()
}
