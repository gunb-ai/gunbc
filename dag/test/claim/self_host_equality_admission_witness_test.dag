module test.claim.self_host_equality_admission_witness

import gunbc.compile_diagnostic_census {
  CompileDiagnosticCensus,
  CensusObserved,
  CensusNotRunnable,
  census_blocking_rows,
  census_rows_of_class,
  census_total_count
}
import std.types { String, Bool }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data equality_admission_witness_charter_note: String = "DISCRIMINATING EVIDENCE for the equality admission wall (XL-0E ruling 2026-08-30: equality on function-bearing values is an ACCEPTANCE defect, not an emitter formatting error). Before the wall, every red source below COMPILED CLEAN: infer_binop_type_node answered Eq/Ne with bool_type unconditionally, and the refusal lived below the floor as rustc E0369 in the emitted crate. The reds are the real subject that still carries function members ('==' on v2.std.runtime InterpretationAlgebra, compiled against the live pool), a planted structural equivalent of each original subject (a record with a function member; a coproduct with a function-bearing arm), and the open-support carrier (PartialFunction). The other original subject, RuntimeValue, was re-modeled by #9724 onto finite Map bindings and now ADMITS by the same type-derived rule -- see runtime_value_admission_ruling_note. The greens are the admissions the wall must NOT widen into: Peano v2.std.nat.Nat (recursive coproduct -- the visited-set control), a local recursive Peano equivalent, ordinary closed structural data with kernel and finite-container members, and the '== none' presence idiom. Severity is asserted as BLOCKING through census_blocking_rows, not merely present: an advisory equality refusal would still emit the unrealizable comparison. These witnesses prove the wall's behaviour on the v1-pipeline synthetic-single-module path the census measures; the corpus-wide census is the floor compile itself."

fn eq_census_of(source: String) -> CompileDiagnosticCensus {
  compile_dag_diagnostic_census(source)
}

fn eq_blocking_count(source: String, wanted: String) -> Int {
  match eq_census_of(source: source) {
    CensusObserved { rows: rows } =>
      census_total_count(rows: census_rows_of_class(rows: census_blocking_rows(rows: rows), wanted: wanted))
    CensusNotRunnable { cause: _ } => 0 - 1
  }
}

fn eq_wall_refusal_count(source: String) -> Int {
  eq_blocking_count(source: source, wanted: "EqualityOnFunctionMember")
    + eq_blocking_count(source: source, wanted: "EqualityMemberUnjudgeable")
}

fn eq_census_clean(source: String) -> Bool {
  match eq_census_of(source: source) {
    CensusObserved { rows: rows } => count(rows) == 0
    CensusNotRunnable { cause: _ } => false
  }
}

fn eq_admitted(source: String) -> Bool {
  match eq_census_of(source: source) {
    CensusObserved { rows: rows } => census_total_count(rows: census_blocking_rows(rows: rows)) == 0
    CensusNotRunnable { cause: _ } => false
  }
}

data interpretation_algebra_eq_red_source: String = "module eq_probe_interpretation_algebra\nimport v2.std.runtime { InterpretationAlgebra }\nfn same(a: InterpretationAlgebra, b: InterpretationAlgebra) -> Bool { a == b }\n"

data runtime_value_eq_model_derived_source: String = "module eq_probe_runtime_value\nimport v2.std.runtime { RuntimeValue }\nfn same(a: RuntimeValue, b: RuntimeValue) -> Bool { a == b }\n"

data runtime_value_admission_ruling_note: String = "MODEL-DERIVED VERDICT, re-judged after #9724 (A1-R). When this witness was authored, RuntimeValue carried a function-valued member transitively: RuntimeClosureValue.environment.bindings was PartialFunction<EnvironmentBindingKey, RuntimeValue>, an open-support carrier, so '==' on RuntimeValue refused. #9724 re-modeled closure environments as finite Map bindings, and the wall's admission is derived from the COMPLETE RESOLVED TYPE, never from a leaf spelling or a remembered ruling -- so on the current model RuntimeValue is closed structural data (Node code, byte lists, finite maps) and '==' on it ADMITS. This row therefore asserts the ADMISSION, as the live-subject control against over-refusal: it goes red either if the wall wrongly widens, or if a function-valued member is reintroduced into the RuntimeValue closure without this verdict being re-judged. The refusal semantics for running closure VALUES stays where it belongs: v2.std.runtime runtime_value_equality answers RuntimeValueEqualityUnavailable on closures at evaluation grain, independent of this type-grain admission."

data fn_member_record_eq_red_source: String = "module eq_probe_fn_record\ntype Ops {\n  step: fn(Int) -> Int\n}\nfn same(a: Ops, b: Ops) -> Bool { a == b }\n"

data fn_member_coproduct_eq_red_source: String = "module eq_probe_fn_coproduct\ntype Carrier\n  = Plain { n: Int }\n  | Op { f: fn(Int) -> Int }\nfn same(a: Carrier, b: Carrier) -> Bool { a == b }\n"

data partial_function_eq_red_source: String = "module eq_probe_partial_function\nimport std.algebra { PartialFunction }\nfn same(a: PartialFunction<Int, Int>, b: PartialFunction<Int, Int>) -> Bool { a == b }\n"

data peano_nat_eq_green_source: String = "module eq_probe_peano_nat\nimport test.fixture.structural_peano_nat { StructuralNat }\nfn same(a: StructuralNat, b: StructuralNat) -> Bool { a == b }\n"

data local_recursive_coproduct_eq_green_source: String = "module eq_probe_local_peano\ntype PNat\n  = PZero\n  | PSucc { prev: PNat }\nfn same(a: PNat, b: PNat) -> Bool { a == b }\n"

data structural_record_eq_green_source: String = "module eq_probe_structural_record\nimport std.types { String, List, Map }\ntype Point {\n  x: Int\n  label: String\n  tags: List<String>\n  attrs: Map<String, Int>\n}\nfn same(a: Point, b: Point) -> Bool { a == b }\n"

data presence_test_green_source: String = "module eq_probe_presence\nfn has(x: Int?) -> Bool { x != none }\n"

test fn interpretation_algebra_equality_refuses_blocking() -> Bool {
  eq_wall_refusal_count(source: interpretation_algebra_eq_red_source) >= 1
}

test fn runtime_value_equality_admits_on_the_finite_map_model() -> Bool {
  eq_admitted(source: runtime_value_eq_model_derived_source)
}

test fn fn_member_record_equality_refuses_blocking() -> Bool {
  eq_blocking_count(source: fn_member_record_eq_red_source, wanted: "EqualityOnFunctionMember") >= 1
}

test fn fn_member_coproduct_equality_refuses_blocking() -> Bool {
  eq_blocking_count(source: fn_member_coproduct_eq_red_source, wanted: "EqualityOnFunctionMember") >= 1
}

test fn partial_function_equality_refuses_blocking() -> Bool {
  eq_blocking_count(source: partial_function_eq_red_source, wanted: "EqualityOnFunctionMember") >= 1
}

test fn peano_nat_equality_stays_admitted() -> Bool {
  eq_admitted(source: peano_nat_eq_green_source)
}

test fn local_recursive_coproduct_equality_stays_admitted() -> Bool {
  eq_census_clean(source: local_recursive_coproduct_eq_green_source)
}

test fn structural_record_equality_stays_admitted() -> Bool {
  eq_admitted(source: structural_record_eq_green_source)
}

test fn presence_test_stays_admitted() -> Bool {
  eq_census_clean(source: presence_test_green_source)
}

// T? == T (gunbc.recurring_failure_mode optional_compared_with_required_value). Before the arm
// in v1.compiler.infer equality_admission_diags these compiled clean and the Rust emitter
// rendered `Option<T> == T` (rustc E0308, std.filesystem is_text_readable). The red is a
// field typed `Kind?` compared with a bare variant, in both operand orders; the controls are
// the explicit spellings the refusal names (a Present comparison, a match) and two optionals
// compared with each other, which the arm must not widen into.
data optionality_mismatch_red_source: String = "module eq_probe_optionality\ntype Kind = A | B\ntype Row { kind: Kind? }\nfn is_a(r: Row) -> Bool { r.kind == A }\n"

data optionality_mismatch_reversed_red_source: String = "module eq_probe_optionality_rev\ntype Kind = A | B\ntype Row { kind: Kind? }\nfn is_a(r: Row) -> Bool { A != r.kind }\n"

data optionality_explicit_present_green_source: String = "module eq_probe_optionality_present\ntype Kind = A | B\ntype Row { kind: Kind? }\nfn is_a(r: Row) -> Bool { r.kind == Present { value: A } }\n"

data optionality_explicit_match_green_source: String = "module eq_probe_optionality_match\ntype Kind = A | B\ntype Row { kind: Kind? }\nfn is_a(r: Row) -> Bool {\n  match r.kind {\n    Present { value: k } => k == A\n    Absent => false\n  }\n}\n"

data optionality_both_optional_green_source: String = "module eq_probe_optionality_both\ntype Kind = A | B\ntype Row { kind: Kind? }\nfn same(a: Row, b: Row) -> Bool { a.kind == b.kind }\n"

test fn optional_compared_with_required_value_refuses_blocking() -> Bool {
  eq_blocking_count(source: optionality_mismatch_red_source, wanted: "EqualityOptionalityMismatch") == 1
}

test fn required_compared_with_optional_value_refuses_blocking() -> Bool {
  eq_blocking_count(source: optionality_mismatch_reversed_red_source, wanted: "EqualityOptionalityMismatch") == 1
}

test fn explicit_present_comparison_stays_admitted() -> Bool {
  eq_admitted(source: optionality_explicit_present_green_source)
}

test fn explicit_match_on_optional_stays_admitted() -> Bool {
  eq_admitted(source: optionality_explicit_match_green_source)
}

test fn optional_compared_with_optional_stays_admitted() -> Bool {
  eq_admitted(source: optionality_both_optional_green_source)
}

// C5, THE SAME CLASS AT THE DECLARED RETURN: a fn declared `-> T?` whose body produces a bare T. No
// declared coercion lifts T into T?, and the Rust emission refused it (E0308, gunbc.running_release_
// identity running_release_member_string). The red is a bare-Int body under `-> Int?`; the controls
// are the explicit present spelling and the absent spelling, which the arm must not widen into.
data return_lift_red_source: String = "module ret_probe_lift\nfn f(x: Int) -> Int? { x }\n"

data return_explicit_present_green_source: String = "module ret_probe_present\nfn f(x: Int) -> Int? { Present { value: x } }\n"

data return_absent_green_source: String = "module ret_probe_absent\nfn f(x: Int) -> Int? { none }\n"

test fn required_body_at_optional_return_refuses_blocking() -> Bool {
  eq_blocking_count(source: return_lift_red_source, wanted: "DeclaredTypeNotInhabited") == 1
}

test fn explicit_present_return_stays_admitted() -> Bool {
  eq_admitted(source: return_explicit_present_green_source)
}

test fn absent_return_stays_admitted() -> Bool {
  eq_admitted(source: return_absent_green_source)
}

data return_lift_match_arm_red_source: String = "module ret_probe_arm\nfn g(s: String) -> String? {\n  match s {\n    \"a\" => s\n    _ => none\n  }\n}\n"

test fn required_arm_at_optional_return_refuses_blocking() -> Bool {
  eq_blocking_count(source: return_lift_match_arm_red_source, wanted: "DeclaredTypeNotInhabited") >= 1
}

// Arm ORDER must not decide the verdict (review 76904): the join keeps the first arm's type, so with
// `none` listed first the bare arm was never judged against the declared return.
data return_lift_match_arm_swapped_red_source: String = "module ret_probe_arm_swapped\nfn g(s: String) -> String? {\n  match s {\n    \"b\" => none\n    _ => s\n  }\n}\n"

test fn required_arm_after_none_arm_refuses_blocking() -> Bool {
  eq_blocking_count(source: return_lift_match_arm_swapped_red_source, wanted: "InternalError") >= 1
}

// THE SAME CLASS AT A DATA INITIALIZER (ruling A on gunbc#13202). A `data r: T? = <bare T>` row was
// emitted bare against Option<..> and refused only downstream by rustc; the checker now refuses it.
// The red's T is a coproduct with a nested-record variant, the specimen that exposed the class; the
// control is the same row spelled Present { value: .. }.
data data_row_bare_lift_red_source: String = "module data_probe_lift\ntype Inner {\n  n: Int\n}\ntype Shape\n  = Circle { inner: Inner }\n  | NoShape\ndata shape_row: Shape? = Circle { inner: Inner { n: 1 } }\n"

data data_row_present_spelled_green_source: String = "module data_probe_present\ntype Inner {\n  n: Int\n}\ntype Shape\n  = Circle { inner: Inner }\n  | NoShape\ndata shape_row: Shape? = Present { value: Circle { inner: Inner { n: 1 } } }\n"

test fn bare_data_initializer_at_optional_row_refuses_blocking() -> Bool {
  eq_blocking_count(source: data_row_bare_lift_red_source, wanted: "DeclaredTypeNotInhabited") == 1
}

test fn present_spelled_data_initializer_stays_admitted() -> Bool {
  eq_admitted(source: data_row_present_spelled_green_source)
}
