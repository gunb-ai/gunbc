module test.claim.attempt_metering_traversal_foreign_witness

// FOREIGN-MODULE TRAVERSAL WITNESS (side-chat REQUEST_CHANGES, sealed stores PR 1, 2026-11-20).
// The finding: attempt_metering_create_once(store, entry: NonEmptyStr, content) joined store.directory +
// entry and ran WriteCreateNew, so entry "../outside" created bytes OUTSIDE the sealed attempt directory;
// the index-store twin joined the same way; and attempt_metering_read_derived kept a raw directory AND a
// raw name as a second reader beside the store. The fix admits every member name as a path segment at the
// effect boundary: the only carrier is AttemptMeteringMemberName, a brand of std.types PathSegment minted
// through path_segment_is_safe (the one law; no allowlist), and the roster directory reader enforces the
// same law INSIDE the effect. These claims run FROM THIS FOREIGN MODULE.

import std.types { String, Bool, NonEmptyStr, PathSegment, path_segment_is_safe }
import std.optional { Present, Absent }
import gunbc.compile_diagnostic_census { compile_dag_diagnostic_census, census_rows_of_class, census_total_count, census_blocking_rows, census_blocking_rows_of_class_at_subject }
import gunbc.roadmap.roadmap_attempt_metering {
  AttemptMeteringMemberName, attempt_metering_member_name, attempt_metering_declared_member_name,
  attempt_metering_member_name_segment,
}
import gunbc.roadmap.roadmap_attempt_state_store { AttemptMeteringRecordFile, attempt_state_member_name }

fn mints_agree_with_the_law(raw: String) -> Bool {
  match attempt_metering_member_name(raw: raw) {
    Absent => !path_segment_is_safe(raw: raw)
    Present { value: carrier } => (attempt_metering_member_name_segment(entry: carrier) as String) == raw && path_segment_is_safe(raw: raw)
  }
}

test fn hostile_entry_spellings_never_mint_a_carrier() -> Bool {
  let hostile = ["../outside", "..", ".", "a/b", "/etc", "", "sub/metering.json", "../..", "x/"]
  all(hostile, h => mints_agree_with_the_law(raw: h))
    && all(hostile, h => match attempt_metering_member_name(raw: h) { Absent => true, Present { value: _ } => false })
}

test fn declared_member_names_mint_and_round_trip() -> Bool {
  match attempt_metering_declared_member_name(member: AttemptMeteringRecordFile) {
    Absent => false
    Present { value: carrier } => (attempt_metering_member_name_segment(entry: carrier) as String) == attempt_state_member_name(member: AttemptMeteringRecordFile)
  }
    && all(["launch.a.json", "metering-roster.json"], n => mints_agree_with_the_law(raw: n))
}

// ── THE REDS: the hostile call shapes no longer type-check; safe twins do. ─────────────────────────────

data hostile_create_source: String = "module probe_amt_hostile_create\nimport std.types { NonEmptyStr }\nimport gunbc.roadmap.roadmap_attempt_metering { AttemptMeteringStore, attempt_metering_create_once, AttemptMeteringCreateOnce }\nfn f(store: AttemptMeteringStore) -> AttemptMeteringCreateOnce { attempt_metering_create_once(store: store, entry: \"../outside\" as NonEmptyStr, content: \"escaped\") }\n"

data safe_create_source: String = "module probe_amt_safe_create\nimport std.types { NonEmptyStr }\nimport std.optional { Present, Absent }\nimport gunbc.roadmap.roadmap_attempt_metering { AttemptMeteringStore, attempt_metering_create_once, AttemptMeteringCreateOnce, attempt_metering_member_name }\nfn f(store: AttemptMeteringStore) -> AttemptMeteringCreateOnce? { match attempt_metering_member_name(raw: \"metering.json\") { Absent => none, Present { value: mname } => Present { value: attempt_metering_create_once(store: store, entry: mname, content: \"sealed\") } } }\n"

data hostile_read_source: String = "module probe_amt_hostile_read\nimport std.optional { Present, Absent }\nimport gunbc.roadmap.roadmap_attempt_metering { OptionalFileRead, AttemptMeteringStore, attempt_metering_read_derived, attempt_metering_member_name }\nfn f(store: AttemptMeteringStore) -> OptionalFileRead? { match attempt_metering_member_name(raw: \"metering.json\") { Absent => none, Present { value: mname } => Present { value: attempt_metering_read_derived(dir: \"/tmp/sealed-attempt\", name: mname) } } }\n"

data safe_read_source: String = "module probe_amt_safe_read\nimport std.optional { Present, Absent }\nimport gunbc.roadmap.roadmap_attempt_metering { OptionalFileRead, AttemptMeteringStore, attempt_metering_read_derived, attempt_metering_member_name }\nfn f(store: AttemptMeteringStore) -> OptionalFileRead? { match attempt_metering_member_name(raw: \"metering.json\") { Absent => none, Present { value: mname } => Present { value: attempt_metering_read_derived(store: store, name: mname) } } }\n"

data hostile_index_source: String = "module probe_amt_hostile_index\nimport std.types { NonEmptyStr }\nimport gunbc.roadmap.roadmap_attempt_metering { AttemptMeteringIndexStore, attempt_metering_index_create_once, AttemptMeteringCreateOnce }\nfn f(store: AttemptMeteringIndexStore) -> AttemptMeteringCreateOnce { attempt_metering_index_create_once(store: store, entry: \"../../outside.index.json\" as NonEmptyStr, content: \"escaped\") }\n"

data safe_index_source: String = "module probe_amt_safe_index\nimport std.types { NonEmptyStr }\nimport std.optional { Present, Absent }\nimport gunbc.roadmap.roadmap_attempt_metering { AttemptMeteringIndexStore, attempt_metering_index_create_once, AttemptMeteringCreateOnce, attempt_metering_member_name }\nfn f(store: AttemptMeteringIndexStore) -> AttemptMeteringCreateOnce? { match attempt_metering_member_name(raw: \"metering-attempt.1.a.json\") { Absent => none, Present { value: mname } => Present { value: attempt_metering_index_create_once(store: store, entry: mname, content: \"sealed\") } } }\n"

// THE LISTING ROUTE, ROUND 4. The finding: attempt_metering_listing(root: String, what: String) let a
// foreign module list ANY directory (metering_list(dir) reborn). Its root-taking signature is deleted; a
// post-mint listing takes the applicable sealed store and lists the directory the store itself owns; each
// mint lists the directory it derived from its own business key. Probes, foreign to the definer: the
// store-bound listing is ADMITTED (0 TypeMismatch rows) and a caller-chosen directory is REFUSED through
// every listing shape, including importing the deleted name outright (blocking rows, positive control 0).

data safe_listing_source: String = "module probe_amt_safe_listing\nimport gunbc.roadmap.roadmap_attempt_metering { AttemptMeteringStore, AttemptMeteringListing, attempt_metering_listing_of }\nfn f(store: AttemptMeteringStore) -> AttemptMeteringListing { attempt_metering_listing_of(store: store) }\n"

data hostile_listing_source: String = "module probe_amt_hostile_listing\nimport gunbc.roadmap.roadmap_attempt_metering { AttemptMeteringListing, attempt_metering_listing_of }\nfn f() -> AttemptMeteringListing { attempt_metering_listing_of(store: \"/tmp/any-dir-chosen-by-the-caller\") }\n"

data safe_index_listing_source: String = "module probe_amt_safe_index_listing\nimport gunbc.roadmap.roadmap_attempt_metering { AttemptMeteringIndexStore, AttemptMeteringListing, attempt_metering_index_listing }\nfn f(store: AttemptMeteringIndexStore) -> AttemptMeteringListing { attempt_metering_index_listing(store: store) }\n"

data hostile_index_listing_source: String = "module probe_amt_hostile_index_listing\nimport gunbc.roadmap.roadmap_attempt_metering { AttemptMeteringListing, attempt_metering_index_listing }\nfn f() -> AttemptMeteringListing { attempt_metering_index_listing(store: \"/tmp/any-root-chosen-by-the-caller\") }\n"

data old_caller_listing_call_source: String = "module probe_amt_old_caller_listing_call\nimport gunbc.roadmap.roadmap_attempt_metering { AttemptMeteringListingRead, AttemptMeteringListingUnreadable, attempt_metering_listing }\nfn old_caller() -> Bool { match attempt_metering_listing(root: \"/tmp/caller-chooses\", what: \"records\") { AttemptMeteringListingRead { names: _ } => true, AttemptMeteringListingUnreadable { detail: _ } => false } }\n"

data lawful_listing_call_source: String = "module probe_amt_lawful_listing_call\nimport gunbc.roadmap.roadmap_attempt_metering { AttemptMeteringStore, AttemptMeteringListingRead, AttemptMeteringListingUnreadable, attempt_metering_listing_of, attempt_metering_listing }\nfn lawful(store: AttemptMeteringStore) -> Bool { match attempt_metering_listing_of(store: store) { AttemptMeteringListingRead { names: _ } => true, AttemptMeteringListingUnreadable { detail: _ } => false } }\n"
data control_import_source: String = "module probe_amt_control_import\nimport gunbc.roadmap.roadmap_attempt_metering { AttemptMeteringStore, attempt_metering_listing_of }\nfn f(store: AttemptMeteringStore) -> Bool { true }\n"

fn blocking_rows(source: String) -> Int {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: rows } => census_total_count(rows: census_blocking_rows(rows: rows))
    CensusNotRunnable { cause: _ } => -1
  }
}

test fn the_listing_route_takes_the_sealed_store_only() -> Bool {
     type_mismatch_count(source: safe_listing_source) == 0
  && type_mismatch_count(source: hostile_listing_source) >= 1
  && type_mismatch_count(source: safe_index_listing_source) == 0
  && type_mismatch_count(source: hostile_index_listing_source) >= 1
  && match compile_dag_diagnostic_census(source: control_import_source) {
       CensusObserved { rows: rows } => census_total_count(rows: census_rows_of_class(rows: rows, wanted: "UnlistedImportUse")) >= 1
       CensusNotRunnable { cause: _ } => false
     }
}

// The deleted root-taking listing route is refused at the compiler floor: a CALL
// to the undeclared name produces a BLOCKING row, observed (not instructed). The
// lawful call through the sealed store must be clean AND its census must be
// OBSERVED runnable (its UnlistedImportUse row witnesses observability;
// type_mismatch_count answers -1 on a refused census, never a silent 0).
test fn the_listing_route_refuses_the_deleted_root_call() -> Bool {
     match compile_dag_diagnostic_census(source: old_caller_listing_call_source) {
       // THE ROUTE ITSELF BLOCKS: a row keyed (class=MissingExport,
       // subject_name=attempt_metering_listing). A count over the unscoped
       // row set cannot say WHICH name the compiler refused -- the row set is
       // the whole compile's (dag/gunbc/compile_diagnostic_census.dag); this
       // census is keyed by class AND subject_name
       // (src/v1/stage0/src/cli_run/compile_clean.rs, MissingExport).
       CensusObserved { rows: rows } =>
         census_total_count(rows: census_blocking_rows_of_class_at_subject(
           rows: rows, wanted_class: "MissingExport",
           wanted_subject: "attempt_metering_listing")) >= 1
       CensusNotRunnable { cause: _ } => false
     }
  && match compile_dag_diagnostic_census(source: lawful_listing_call_source) {
       CensusObserved { rows: rows } => census_total_count(rows: census_rows_of_class(rows: rows, wanted: "TypeMismatch")) == 0
                                      && census_total_count(rows: census_rows_of_class(rows: rows, wanted: "UnlistedImportUse")) >= 1
                                      && census_total_count(rows: census_blocking_rows(rows: rows)) == 0
       CensusNotRunnable { cause: _ } => false
     }
}

fn type_mismatch_count(source: String) -> Int {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: rows } => census_total_count(rows: census_rows_of_class(rows: rows, wanted: "TypeMismatch"))
    CensusNotRunnable { cause: _ } => 0 - 1
  }
}

test fn a_caller_chosen_entry_reaches_no_create_or_read_effect() -> Bool {
  type_mismatch_count(source: hostile_create_source) >= 1
    && type_mismatch_count(source: safe_create_source) == 0
    && type_mismatch_count(source: hostile_read_source) >= 1
    && type_mismatch_count(source: safe_read_source) == 0
    && type_mismatch_count(source: hostile_index_source) >= 1
    && type_mismatch_count(source: safe_index_source) == 0
}

// THE MEMBER CARRIER SEAL, BY TWIN (review 97160 follow-up: #15574's segment carrier had the same
// plain-brand hole). Two forged casts -- a traversal spelling and a WELL-FORMED spelling -- against two
// definer fixtures differing in nothing but the sole_constructor keyword. Sealed: BOTH forgeries are
// refused construction (>=1 SoleConstructorViolation row each). Stripped: the SAME sources compile with
// NO such row. The seal keyword is what refuses.

data member_forged_cast_sealed_twin_source: String = "module probe_member_twin_sealed\nimport test.fixture.c_roadmap2_metering_member.member_definer { AttemptMeteringMemberName, forge_target }\nfn forged_traversal() -> Bool { forge_target(entry: \"../outside\" as AttemptMeteringMemberName) }\nfn forged_wellformed() -> Bool { forge_target(entry: \"record.json\" as AttemptMeteringMemberName) }\n"

data member_forged_cast_stripped_twin_source: String = "module probe_member_twin_stripped\nimport test.fixture.c_roadmap2_metering_member.member_stripped_definer { AttemptMeteringMemberName, forge_target }\nfn forged_traversal() -> Bool { forge_target(entry: \"../outside\" as AttemptMeteringMemberName) }\nfn forged_wellformed() -> Bool { forge_target(entry: \"record.json\" as AttemptMeteringMemberName) }\n"

fn sole_ctor_rows(source: String) -> Int {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: rows } => census_total_count(rows: census_rows_of_class(rows: rows, wanted: "SoleConstructorViolation"))
    CensusNotRunnable { cause: _ } => -1
  }
}

fn census_ran(source: String) -> Bool {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: _ } => true
    CensusNotRunnable { cause: _ } => false
  }
}

test fn the_member_carrier_seal_is_what_refuses_forged_casts() -> Bool {
  census_ran(source: member_forged_cast_sealed_twin_source)
    && census_ran(source: member_forged_cast_stripped_twin_source)
    && sole_ctor_rows(source: member_forged_cast_sealed_twin_source) >= 1
    && sole_ctor_rows(source: member_forged_cast_stripped_twin_source) == 0
}

// THE STORE SEAL, BY TWIN (review 97249 second finding's strip control): the directory a read derives from
// is reachable only through the sealed store record. A probe module FOREIGN to the definer fixture forges
// a store literal with a caller-chosen directory: against the SEALED twin its construction is refused
// (>=1 SoleConstructorViolation row); against the STRIPPED twin -- the same declaration minus the
// sole_constructor keyword, nothing else different -- the same source compiles with no such row. The
// keyword is what refuses; the store-bound reads above are admissible only because that seal holds.

data store_forged_cast_sealed_twin_source: String = "module probe_store_twin_sealed\nimport std.types { NonEmptyStr }\nimport test.fixture.c_roadmap2_metering_store_forgery.definer { AttemptMeteringStore, forge_target }\nfn forged() -> Bool { forge_target(store: AttemptMeteringStore { instance: \"i\" as NonEmptyStr, node: \"n\", attempt_key: \"k\", directory: \"/any\" as NonEmptyStr }) }\n"

data store_forged_cast_stripped_twin_source: String = "module probe_store_twin_stripped\nimport std.types { NonEmptyStr }\nimport test.fixture.c_roadmap2_metering_store_forgery.stripped_definer { AttemptMeteringStore, forge_target }\nfn forged() -> Bool { forge_target(store: AttemptMeteringStore { instance: \"i\" as NonEmptyStr, node: \"n\", attempt_key: \"k\", directory: \"/any\" as NonEmptyStr }) }\n"

test fn the_store_seal_is_what_refuses_a_forged_directory() -> Bool {
  census_ran(source: store_forged_cast_sealed_twin_source)
    && sole_ctor_rows(source: store_forged_cast_sealed_twin_source) >= 1
    && census_ran(source: store_forged_cast_stripped_twin_source)
    && sole_ctor_rows(source: store_forged_cast_stripped_twin_source) == 0
}
