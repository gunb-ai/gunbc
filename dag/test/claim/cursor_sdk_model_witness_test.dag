module test.claim.cursor_sdk_model_witness_test


test fn local_usage_standing_is_typed_capability_gap() -> Bool {
  let gap = extdeps.llm.cursor_sdk_facts.cursor_sdk_local_account_usage_unobservable()
  gap.missing_capability == extdeps.llm.cursor_sdk_facts.cursor_sdk_local_usage_missing_capability
    && string_contains(s: gap.reason as String, pattern: "account-level")
}

test fn package_closure_matches_probe_receipt() -> Bool {
  let closure = extdeps.llm.cursor_sdk_facts.cursor_sdk_local_package_closure()
  let receipt = extdeps.probes.provider_interface_acquisition.provider_interface_acquisition_cursor_sdk_closure_receipt()
  closure.package_name == receipt.package_name
    && closure.exact_version == receipt.exact_version
    && closure.lockfile_sha256 == receipt.lockfile_sha256
    && closure.root_integrity == receipt.root_integrity
    && closure.lock_entry_count == receipt.lock_entry_count
    && closure.platform_gated_entry_count == receipt.platform_gated_entry_count
    && closure.install_script_count == receipt.install_script_count
    && closure.node_toolchain_version == receipt.node_toolchain_version
    && closure.npm_toolchain_version == receipt.npm_toolchain_version
    && closure.module_export == receipt.package_name
}

test fn srv1_package_provision_is_typed_gap() -> Bool {
  let gap = extdeps.llm.cursor_sdk_facts.cursor_sdk_local_package_unprovisioned_on_deployed_host()
  gap.missing_capability == extdeps.llm.cursor_sdk_facts.cursor_sdk_local_provision_missing_capability
    && string_contains(s: gap.reason as String, pattern: "srv1")
}

test fn cursor_sdk_model_witness_keystone_holds() -> Bool {
  local_usage_standing_is_typed_capability_gap()
    && package_closure_matches_probe_receipt()
    && srv1_package_provision_is_typed_gap()
}
