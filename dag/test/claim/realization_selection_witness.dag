data id_a: DeclarationRef = decl_ref(module_path: "test.claim.realization_selection_witness", decl_name: "id_a")
data id_b: DeclarationRef = decl_ref(module_path: "test.claim.realization_selection_witness", decl_name: "id_b")
data id_c: DeclarationRef = decl_ref(module_path: "test.claim.realization_selection_witness", decl_name: "id_c")
data id_policy_usesep: DeclarationRef = decl_ref(module_path: "test.claim.realization_selection_witness", decl_name: "id_policy_usesep")
data id_subject: DeclarationRef = decl_ref(module_path: "test.claim.realization_selection_witness", decl_name: "id_subject")
data id_field: DeclarationRef = decl_ref(module_path: "test.claim.realization_selection_witness", decl_name: "id_field")
data id_field2: DeclarationRef = decl_ref(module_path: "test.claim.realization_selection_witness", decl_name: "id_field2")
data id_constraints: DeclarationRef = decl_ref(module_path: "test.claim.realization_selection_witness", decl_name: "id_constraints")
data id_evidence: DeclarationRef = decl_ref(module_path: "test.claim.realization_selection_witness", decl_name: "id_evidence")
data id_evidence2: DeclarationRef = decl_ref(module_path: "test.claim.realization_selection_witness", decl_name: "id_evidence2")
data id_policy_unique: DeclarationRef = decl_ref(module_path: "test.claim.realization_selection_witness", decl_name: "id_policy_unique")
data id_policy_a: DeclarationRef = decl_ref(module_path: "test.claim.realization_selection_witness", decl_name: "id_policy_a")
data id_policy_b: DeclarationRef = decl_ref(module_path: "test.claim.realization_selection_witness", decl_name: "id_policy_b")
data ax_tput: DeclarationRef = decl_ref(module_path: "test.claim.realization_selection_witness", decl_name: "ax_tput")
data ax_power: DeclarationRef = decl_ref(module_path: "test.claim.realization_selection_witness", decl_name: "ax_power")
data ax_orphan: DeclarationRef = decl_ref(module_path: "test.claim.realization_selection_witness", decl_name: "ax_orphan")

data id_var: DeclarationRef = decl_ref(module_path: "test.claim.realization_selection_witness", decl_name: "var_sel")
data id_term: DeclarationRef = decl_ref(module_path: "test.claim.realization_selection_witness", decl_name: "term_sel")
data id_constraint_cell: DeclarationRef = decl_ref(module_path: "test.claim.realization_selection_witness", decl_name: "constraint_sel")
data id_param_cell: DeclarationRef = decl_ref(module_path: "test.claim.realization_selection_witness", decl_name: "param_sel")
data id_region: DeclarationRef = decl_ref(module_path: "test.claim.realization_selection_witness", decl_name: "region_sel")
data id_domain: DeclarationRef = decl_ref(module_path: "test.claim.realization_selection_witness", decl_name: "domain_sel")
data id_objective: DeclarationRef = decl_ref(module_path: "test.claim.realization_selection_witness", decl_name: "objective_sel")
data id_coupling: DeclarationRef = decl_ref(module_path: "test.claim.realization_selection_witness", decl_name: "id_coupling")

data fixture_physical_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri { scheme: Https, locator: "fixture.invalid/selection-witness/physical" },
}

data var_sel: DecisionVariable = DecisionVariable { identity: id_var }
data term_sel: ObjectiveTerm = ObjectiveTerm {
  identity: id_term,
  ground: CitedToAuthority { authority: fixture_physical_authority },
}
data constraint_sel: DecisionConstraint = DecisionConstraint { identity: id_constraint_cell }
data param_sel: ContextParameter = ContextParameter { identity: id_param_cell }
data region_sel: DecisionRegion = DecisionRegion { identity: id_region }

data objective_sel: ObjectiveMeasure = ObjectiveMeasure {
  identity: id_objective,
  goal: HigherIsBetter,
  terms: [term_sel],
}

data domain_sel: ChoiceDomain = ChoiceDomain {
  identity: id_domain,
  variables: [var_sel],
}

data subject_sel: DecisionSubject = DecisionSubject {
  identity: id_subject,
  question: "synthetic closed subject for choose-one witnesses" as NonEmptyStr,
  parameters: [param_sel],
  constraints: [constraint_sel],
  objective: objective_sel,
  choice_domain: domain_sel,
}

fn closed_selection_assessment() -> DecisionAssessment {
  DecisionAssessment {
    subject: subject_sel,
    sensitivities: [
      VariesAlong {
        term: id_term,
        variable: id_var,
        region: region_sel,
        relation: MonotoneDecreasing,
        coupling: CitedToAuthority { authority: fixture_physical_authority },
      },
    ],
    constraints: [
      ConstraintSatisfied {
        constraint: id_constraint_cell,
        evidence: "fixture constraint" as NonEmptyStr,
      },
    ],
    parameters: [
      ParameterBound {
        parameter: id_param_cell,
        evidence: "fixture parameter" as NonEmptyStr,
      },
    ],
    selected_candidate: Absent,
    term_drops: [],
    physical_model: PhysicalModelEstablished { terms: [id_term] },
    causal_model: CausalModelEstablished {
      couplings: [
        FleetObservedCoupling {
          receipt: id_coupling,
          term: id_term,
          variable: id_var,
          subject: id_subject,
        },
      ],
    },
  }
}

fn unestablished_selection_assessment() -> DecisionAssessment {
  DecisionAssessment {
    subject: subject_sel,
    sensitivities: [],
    constraints: [],
    parameters: [],
    selected_candidate: Absent,
    term_drops: [],
    physical_model: PhysicalModelUnestablished {
      subject: id_subject,
      read_obligation: "physical model unread" as NonEmptyStr,
    },
    causal_model: CausalModelEstablished { couplings: [] },
  }
}

fn axes_forward() -> List<SelectionAxis> {
  [
    SelectionAxis { identity: ax_tput, goal: HigherIsBetter },
    SelectionAxis { identity: ax_power, goal: LowerIsBetter },
  ]
}

fn axes_reversed() -> List<SelectionAxis> {
  [
    SelectionAxis { identity: ax_power, goal: LowerIsBetter },
    SelectionAxis { identity: ax_tput, goal: HigherIsBetter },
  ]
}

fn axes_power_only() -> List<SelectionAxis> {
  [SelectionAxis { identity: ax_power, goal: LowerIsBetter }]
}

fn reading(axis: DeclarationRef, v: Int) -> AxisReading {
  AxisReading { axis: axis, interval_micro: degenerate_interval(point: v) }
}

fn entry(id: DeclarationRef, label: NonEmptyStr, tput: Int, power: Int) -> ParetoEntry {
  ParetoEntry {
    identity: id,
    display_label: label,
    readings: [reading(axis: ax_tput, v: tput), reading(axis: ax_power, v: power)],
    missing_inputs: [],
  }
}

fn entry_missing_power(id: DeclarationRef, label: NonEmptyStr, tput: Int) -> ParetoEntry {
  ParetoEntry {
    identity: id,
    display_label: label,
    readings: [reading(axis: ax_tput, v: tput)],
    missing_inputs: [AxisGap { axis: ax_power, cause: "required power reading absent" as NonEmptyStr }],
  }
}

fn entry_over_cap_missing_tput(id: DeclarationRef, label: NonEmptyStr, power: Int) -> ParetoEntry {
  ParetoEntry {
    identity: id,
    display_label: label,
    readings: [reading(axis: ax_power, v: power)],
    missing_inputs: [AxisGap { axis: ax_tput, cause: "tput unread on a forbidden candidate" as NonEmptyStr }],
  }
}

// An interval reading on the throughput axis: dominance may be UNDECIDED (overlapping intervals),
// which must never be read as a tie.
fn entry_interval_tput(id: DeclarationRef, label: NonEmptyStr, tput_low: Int, tput_high: Int, power: Int) -> ParetoEntry {
  ParetoEntry {
    identity: id,
    display_label: label,
    readings: [
      AxisReading { axis: ax_tput, interval_micro: span(low: tput_low, high: tput_high) },
      reading(axis: ax_power, v: power),
    ],
    missing_inputs: [],
  }
}

data power_cap: HardConstraint = HardConstraint {
  identity: id_constraints,
  axis: ax_power,
  bound_micro: 100,
  denomination: NonMoneyConstraint,
}

data tput_floor: HardConstraint = HardConstraint {
  identity: id_constraints,
  axis: ax_tput,
  bound_micro: 5,
  denomination: NonMoneyConstraint,
}

data orphan_cap: HardConstraint = HardConstraint {
  identity: id_constraints,
  axis: ax_orphan,
  bound_micro: 1,
  denomination: NonMoneyConstraint,
}

fn le_int(a: Int, b: Int) -> Bool { a <= b }

fn span(low: Int, high: Int) -> OrderedClosedInterval<Int> {
  match closed_interval(low: low, high: high, le: le_int) {
    IntervalReady { interval: iv } => iv
    IntervalRefused { reason: _ } => degenerate_interval(point: 0)
  }
}

fn selected_id(field: List<ParetoEntry>, axes: List<SelectionAxis>, constraints: List<HardConstraint>, pol: SelectionPolicy, evidence: DeclarationRef, field_id: DeclarationRef) -> DeclarationRef? {
  match select_realization(
    assessment: closed_selection_assessment(),
    candidate_field_identity: field_id,
    field: field,
    axes: axes,
    constraints: constraints,
    constraint_authority: id_constraints,
    policy: pol,
    evidence_snapshot: evidence,
  ) {
    SelectedWithin { candidate: c, receipt: _ } => Present { value: c.identity }
    SelectionNeedsEvidence { needs: _ } => Absent
    SelectionNeedsPolicy { survivors: _ } => Absent
    RealizationSelectionRefused { defects: _ } => Absent
    NoFeasibleRealization { causes: _, scope: _ } => Absent
    CandidateFieldUnestablished { causes: _ } => Absent
  }
}

// The receipt a selection mints, so a witness can compare receipts across a held-fixed question whose
// only change is the policy arm or its parameters.
fn receipt_for(field: List<ParetoEntry>, pol: SelectionPolicy) -> SelectionReceipt? {
  match select_realization(
    assessment: closed_selection_assessment(),
    candidate_field_identity: id_field,
    field: field,
    axes: axes_forward(),
    constraints: [],
    constraint_authority: id_constraints,
    policy: pol,
    evidence_snapshot: id_evidence,
  ) {
    SelectedWithin { candidate: _, receipt: r } => Present { value: r }
    _ => Absent
  }
}

test fn a_hard_constraint_failure_excludes_before_unread_axes_are_requested() -> Bool {
  let forbidden = entry_over_cap_missing_tput(id: id_a, label: "over cap missing tput" as NonEmptyStr, power: 200)
  let feasible = entry(id: id_b, label: "under cap" as NonEmptyStr, tput: 10, power: 50)
  match select_realization(
    assessment: closed_selection_assessment(),
    candidate_field_identity: id_field,
    field: [forbidden, feasible],
    axes: axes_forward(),
    constraints: [power_cap],
    constraint_authority: id_constraints,
    policy: UniqueSurvivorRequired { identity: id_policy_unique },
    evidence_snapshot: id_evidence,
  ) {
    SelectedWithin { candidate: c, receipt: _ } => declaration_ref_eq(a: c.identity, b: id_b)
    _ => false
  }
}

test fn a_sole_hard_constraint_failure_is_no_feasible_not_needs_evidence() -> Bool {
  let forbidden = entry_over_cap_missing_tput(id: id_a, label: "over cap missing tput" as NonEmptyStr, power: 200)
  match select_realization(
    assessment: closed_selection_assessment(),
    candidate_field_identity: id_field,
    field: [forbidden],
    axes: axes_forward(),
    constraints: [power_cap],
    constraint_authority: id_constraints,
    policy: UniqueSurvivorRequired { identity: id_policy_unique },
    evidence_snapshot: id_evidence,
  ) {
    NoFeasibleRealization { causes: cs, scope: _ } =>
      any(cs, s =>
        string_contains(s: s as String, pattern: declaration_ref_display_key(ref: id_a))
          && string_contains(s: s as String, pattern: declaration_ref_display_key(ref: ax_power)))
    _ => false
  }
}

test fn hard_power_constraint_excludes_before_pareto() -> Bool {
  let attractive = entry(id: id_a, label: "high tput over cap" as NonEmptyStr, tput: 90, power: 200)
  let feasible = entry(id: id_b, label: "lower tput under cap" as NonEmptyStr, tput: 10, power: 50)
  match select_realization(
    assessment: closed_selection_assessment(),
    candidate_field_identity: id_field,
    field: [attractive, feasible],
    axes: axes_forward(),
    constraints: [power_cap],
    constraint_authority: id_constraints,
    policy: UniqueSurvivorRequired { identity: id_policy_unique },
    evidence_snapshot: id_evidence,
  ) {
    SelectedWithin { candidate: c, receipt: _ } => declaration_ref_eq(a: c.identity, b: id_b)
    _ => false
  }
}

test fn missing_power_reading_needs_evidence_never_zero_watts() -> Bool {
  let incomplete = entry_missing_power(id: id_a, label: "no power" as NonEmptyStr, tput: 90)
  match select_realization(
    assessment: closed_selection_assessment(),
    candidate_field_identity: id_field,
    field: [incomplete],
    axes: axes_forward(),
    constraints: [power_cap],
    constraint_authority: id_constraints,
    policy: UniqueSurvivorRequired { identity: id_policy_unique },
    evidence_snapshot: id_evidence,
  ) {
    SelectionNeedsEvidence { needs: ns } =>
      any(ns, n =>
        match n {
          UnfundedAxis { gap: g } => declaration_ref_eq(a: g.axis, b: ax_power)
          _ => false
        }
      )
        && !any(ns, n =>
          match n {
            UnfundedAxis { gap: g } => string_contains(s: g.cause as String, pattern: "0 W")
            CandidateStandingIncomplete { candidate: _, cause: c } => string_contains(s: c as String, pattern: "0 W")
            SubjectClosureIncomplete { subject: _, obligation: o } => string_contains(s: o as String, pattern: "0 W")
          }
        )
    _ => false
  }
}

test fn two_survivors_without_policy_need_policy_not_first_element() -> Bool {
  let left = entry(id: id_a, label: "tput winner" as NonEmptyStr, tput: 80, power: 80)
  let right = entry(id: id_b, label: "power winner" as NonEmptyStr, tput: 20, power: 20)
  match select_realization(
    assessment: closed_selection_assessment(),
    candidate_field_identity: id_field,
    field: [left, right],
    axes: axes_forward(),
    constraints: [],
    constraint_authority: id_constraints,
    policy: UniqueSurvivorRequired { identity: id_policy_unique },
    evidence_snapshot: id_evidence,
  ) {
    SelectionNeedsPolicy { survivors: sv } =>
      (sv |> count) == 2
        && any(sv, s => declaration_ref_eq(a: s, b: id_a))
        && any(sv, s => declaration_ref_eq(a: s, b: id_b))
    SelectedWithin { candidate: _, receipt: _ } => false
    _ => false
  }
}

test fn reversing_candidate_and_axis_order_preserves_answer() -> Bool {
  let a = entry(id: id_a, label: "a" as NonEmptyStr, tput: 10, power: 90)
  let b = entry(id: id_b, label: "b" as NonEmptyStr, tput: 50, power: 50)
  let fwd = select_realization(
    assessment: closed_selection_assessment(),
    candidate_field_identity: id_field,
    field: [a, b],
    axes: axes_forward(),
    constraints: [power_cap],
    constraint_authority: id_constraints,
    policy: UniqueSurvivorRequired { identity: id_policy_unique },
    evidence_snapshot: id_evidence,
  )
  let rev = select_realization(
    assessment: closed_selection_assessment(),
    candidate_field_identity: id_field,
    field: [b, a],
    axes: axes_reversed(),
    constraints: [power_cap],
    constraint_authority: id_constraints,
    policy: UniqueSurvivorRequired { identity: id_policy_unique },
    evidence_snapshot: id_evidence,
  )
  match fwd {
    SelectedWithin { candidate: c1, receipt: _ } =>
      match rev {
        SelectedWithin { candidate: c2, receipt: _ } => declaration_ref_eq(a: c1.identity, b: c2.identity)
        _ => false
      }
    _ => false
  }
}

test fn policy_cannot_choose_dominated_infeasible_or_absent() -> Bool {
  let attractive = entry(id: id_a, label: "over cap" as NonEmptyStr, tput: 90, power: 200)
  let feasible = entry(id: id_b, label: "under cap" as NonEmptyStr, tput: 10, power: 50)
  match select_realization(
    assessment: closed_selection_assessment(),
    candidate_field_identity: id_field,
    field: [attractive, feasible],
    axes: axes_forward(),
    constraints: [power_cap],
    constraint_authority: id_constraints,
    policy: PreferSurvivor { identity: id_policy_a, preferred: id_a },
    evidence_snapshot: id_evidence,
  ) {
    RealizationSelectionRefused { defects: _ } => true
    _ => false
  }
}

test fn changing_only_policy_may_choose_a_different_survivor() -> Bool {
  let left = entry(id: id_a, label: "tput" as NonEmptyStr, tput: 80, power: 80)
  let right = entry(id: id_b, label: "power" as NonEmptyStr, tput: 20, power: 20)
  let field = [left, right]
  match selected_id(field: field, axes: axes_forward(), constraints: [], pol: PreferSurvivor { identity: id_policy_a, preferred: id_a }, evidence: id_evidence, field_id: id_field) {
    Absent => false
    Present { value: a } =>
      match selected_id(field: field, axes: axes_forward(), constraints: [], pol: PreferSurvivor { identity: id_policy_b, preferred: id_b }, evidence: id_evidence, field_id: id_field) {
        Absent => false
        Present { value: b } =>
          declaration_ref_eq(a: a, b: id_a) && declaration_ref_eq(a: b, b: id_b)
      }
  }
}

test fn changing_evidence_or_field_identity_invalidates_receipt() -> Bool {
  let feasible = entry(id: id_b, label: "ok" as NonEmptyStr, tput: 10, power: 50)
  match select_realization(
    assessment: closed_selection_assessment(),
    candidate_field_identity: id_field,
    field: [feasible],
    axes: axes_forward(),
    constraints: [power_cap],
    constraint_authority: id_constraints,
    policy: UniqueSurvivorRequired { identity: id_policy_unique },
    evidence_snapshot: id_evidence,
  ) {
    SelectedWithin { candidate: _, receipt: r1 } =>
      match select_realization(
        assessment: closed_selection_assessment(),
        candidate_field_identity: id_field2,
        field: [feasible],
        axes: axes_forward(),
        constraints: [power_cap],
        constraint_authority: id_constraints,
        policy: UniqueSurvivorRequired { identity: id_policy_unique },
        evidence_snapshot: id_evidence2,
      ) {
        SelectedWithin { candidate: _, receipt: r2 } => !receipts_eq(a: r1, b: r2)
        _ => false
      }
    _ => false
  }
}

test fn different_funded_axes_are_a_different_receipt() -> Bool {
  let feasible = entry(id: id_b, label: "ok" as NonEmptyStr, tput: 10, power: 50)
  match select_realization(
    assessment: closed_selection_assessment(),
    candidate_field_identity: id_field,
    field: [feasible],
    axes: axes_forward(),
    constraints: [power_cap],
    constraint_authority: id_constraints,
    policy: UniqueSurvivorRequired { identity: id_policy_unique },
    evidence_snapshot: id_evidence,
  ) {
    SelectedWithin { candidate: _, receipt: r1 } =>
      match select_realization(
        assessment: closed_selection_assessment(),
        candidate_field_identity: id_field,
        field: [feasible],
        axes: axes_power_only(),
        constraints: [power_cap],
        constraint_authority: id_constraints,
        policy: UniqueSurvivorRequired { identity: id_policy_unique },
        evidence_snapshot: id_evidence,
      ) {
        SelectedWithin { candidate: _, receipt: r2 } => !receipts_eq(a: r1, b: r2)
        _ => false
      }
    _ => false
  }
}

test fn selection_refuses_before_any_convergence() -> Bool {
  match fleet_operating_point_selection() {
    RealizationSelectionRefused { defects: ds } => (ds |> count) > 0
    SelectedWithin { candidate: _, receipt: _ } => false
    _ => false
  }
}

// MIGRATED FROM gunbc.world_converge, which #10814 deleted at the root. This binding is what
// DESIGN section 3 calls the census: the deletion made every real dependent refuse, and this one
// refused loudly, so it is fixed forward rather than restored.
//
// TWO STAGES DISAPPEAR RATHER THAN BEING REWRITTEN, and their absence is the claim. The shape this
// replaces required an `apply` and an `unchanged_receipt`; this witness supplied `WorldApplied`
// over a context it threaded through, which asserted nothing about actuation and existed only
// because the interface demanded the stage. std.goal_assessment has no actuator, so there is
// nothing to supply and nothing to mistake for a proven write.
//
// THE EVIDENCE IS NOW DERIVED FROM THE OBSERVATION rather than from a threaded receipt, because
// `assess` receives only what was observed. The claim under test is unchanged and is the section
// 3d one: a SelectedWithin candidate feeds the convergence root as its SUBJECT, and the root
// reaches a satisfied assessment over it. The receipt was never read by the old handler either --
// it was returned unchanged -- so nothing that was asserted has been dropped.
fn selection_observe(subject: ParetoEntry, _: SelectionReceipt) -> ObservationAttempt<DeclarationRef, NonEmptyStr> {
  ObservationEstablished { observed: subject.identity }
}

fn selection_assess(goal: DeclarationRef, observed: DeclarationRef) -> GoalAssessment<DeclarationRef, DeclarationRef, DeclarationRef, NonEmptyStr> {
  assess_by_deviations(evidence: observed, deviations: [])
}

test fn selected_within_feeds_the_goal_assessment_root() -> Bool {
  let feasible = entry(id: id_b, label: "ok" as NonEmptyStr, tput: 10, power: 50)
  match select_realization(
    assessment: closed_selection_assessment(),
    candidate_field_identity: id_field,
    field: [feasible],
    axes: axes_forward(),
    constraints: [power_cap],
    constraint_authority: id_constraints,
    policy: UniqueSurvivorRequired { identity: id_policy_unique },
    evidence_snapshot: id_evidence,
  ) {
    SelectedWithin { candidate: c, receipt: r } =>
      match inspect_goal(
        subject: c,
        goal: c.identity,
        request: r,
        observe: selection_observe,
        assess: selection_assess,
      ) {
        GoalInspected { subject: _, goal: _, request: _, observed: _, assessment: GoalSatisfied { evidence: _ } } => true
        _ => false
      }
    _ => false
  }
}

test fn incomplete_subject_cannot_mint_selected_within() -> Bool {
  let feasible = entry(id: id_b, label: "ok" as NonEmptyStr, tput: 10, power: 50)
  match select_realization(
    assessment: unestablished_selection_assessment(),
    candidate_field_identity: id_field,
    field: [feasible],
    axes: axes_forward(),
    constraints: [power_cap],
    constraint_authority: id_constraints,
    policy: UniqueSurvivorRequired { identity: id_policy_unique },
    evidence_snapshot: id_evidence,
  ) {
    SelectedWithin { candidate: _, receipt: _ } => false
    SelectionNeedsEvidence { needs: ns } => (ns |> count) > 0
    _ => false
  }
}

test fn generated_section_3d_and_reviewer_execute() -> Bool {
  let md = expected_design_md()
  string_contains(s: md, pattern: "Selection precedes convergence")
    && string_contains(s: md, pattern: "std.decision")
    && any(design_propositions, p => p.id == "s3d.selection-precedes-convergence")
    && match review_criterion_by_key(key: "selection-precedes-convergence") {
      Absent => false
      Present { value: c } => string_contains(s: c.question, pattern: "std.goal_assessment")
    }
}

test fn fleet_operating_point_names_throughput_and_ac_power_gaps() -> Bool {
  match select_realization(
    assessment: closed_selection_assessment(),
    candidate_field_identity: fleet_operating_point_field,
    field: fleet_operating_point_field_rows(),
    axes: fleet_operating_point_axes(),
    constraints: [],
    constraint_authority: fleet_operating_point_constraints,
    policy: UniqueSurvivorRequired { identity: fleet_operating_point_policy },
    evidence_snapshot: fleet_operating_point_evidence,
  ) {
    SelectionNeedsEvidence { needs: ns } =>
      (ns |> count) == 4
        && any(ns, n =>
          match n {
            UnfundedAxis { gap: g } => declaration_ref_eq(a: g.axis, b: gap_aggregate_throughput.axis)
            _ => false
          }
        )
        && any(ns, n =>
          match n {
            UnfundedAxis { gap: g } => declaration_ref_eq(a: g.axis, b: gap_ac_power_energy.axis)
            _ => false
          }
        )
    _ => false
  }
}

test fn fleet_operating_point_refuses_under_modeled_subject() -> Bool {
  match fleet_operating_point_selection() {
    RealizationSelectionRefused { defects: ds } =>
      any(ds, d => string_contains(s: d as String, pattern: "subject completeness join is not closed"))
    _ => false
  }
}

test fn deferred_subject_merges_into_field_evidence_needs() -> Bool {
  let incomplete = entry_missing_power(id: id_a, label: "no power" as NonEmptyStr, tput: 90)
  match select_realization(
    assessment: unestablished_selection_assessment(),
    candidate_field_identity: id_field,
    field: [incomplete],
    axes: axes_forward(),
    constraints: [power_cap],
    constraint_authority: id_constraints,
    policy: UniqueSurvivorRequired { identity: id_policy_unique },
    evidence_snapshot: id_evidence,
  ) {
    SelectionNeedsEvidence { needs: ns } =>
      any(ns, n =>
        match n {
          UnfundedAxis { gap: g } => declaration_ref_eq(a: g.axis, b: ax_power)
          _ => false
        }
      )
        && any(ns, n =>
          match n {
            SubjectClosureIncomplete { subject: s, obligation: _ } => declaration_ref_eq(a: s, b: id_subject)
            _ => false
          }
        )
    _ => false
  }
}

test fn unfunded_constraint_axis_refuses_not_needs_evidence() -> Bool {
  let feasible = entry(id: id_b, label: "ok" as NonEmptyStr, tput: 10, power: 50)
  match select_realization(
    assessment: closed_selection_assessment(),
    candidate_field_identity: id_field,
    field: [feasible],
    axes: axes_forward(),
    constraints: [power_cap, orphan_cap],
    constraint_authority: id_constraints,
    policy: UniqueSurvivorRequired { identity: id_policy_unique },
    evidence_snapshot: id_evidence,
  ) {
    RealizationSelectionRefused { defects: ds } =>
      any(ds, d => string_contains(s: d as String, pattern: "not a funded selection axis"))
    SelectionNeedsEvidence { needs: _ } => false
    _ => false
  }
}

test fn undecided_constraint_does_not_gap_decided_constraints() -> Bool {
  let mixed = ParetoEntry {
    identity: id_b,
    display_label: "sharp tput, wide power" as NonEmptyStr,
    readings: [
      reading(axis: ax_tput, v: 90),
      AxisReading { axis: ax_power, interval_micro: span(low: 40, high: 120) },
    ],
    missing_inputs: [],
  }
  match select_realization(
    assessment: closed_selection_assessment(),
    candidate_field_identity: id_field,
    field: [mixed],
    axes: axes_forward(),
    constraints: [tput_floor, power_cap],
    constraint_authority: id_constraints,
    policy: UniqueSurvivorRequired { identity: id_policy_unique },
    evidence_snapshot: id_evidence,
  ) {
    SelectionNeedsEvidence { needs: ns } =>
      (ns |> count) == 1
        && any(ns, n =>
          match n {
            UnfundedAxis { gap: g } => declaration_ref_eq(a: g.axis, b: ax_power)
            _ => false
          }
        )
        && !any(ns, n =>
          match n {
            UnfundedAxis { gap: g } => declaration_ref_eq(a: g.axis, b: ax_tput)
            _ => false
          }
        )
    _ => false
  }
}

test fn two_unevidenced_candidates_accumulate_every_gap() -> Bool {
  match select_realization(
    assessment: closed_selection_assessment(),
    candidate_field_identity: id_field,
    field: [
      entry_missing_power(id: id_a, label: "a missing power" as NonEmptyStr, tput: 90),
      entry_missing_power(id: id_b, label: "b missing power" as NonEmptyStr, tput: 10),
    ],
    axes: axes_forward(),
    constraints: [power_cap],
    constraint_authority: id_constraints,
    policy: UniqueSurvivorRequired { identity: id_policy_unique },
    evidence_snapshot: id_evidence,
  ) {
    SelectionNeedsEvidence { needs: ns } => (ns |> count) == 2
    _ => false
  }
}


// A SECOND FIELD IDENTITY, DECLARED BECAUSE THE CONTROL BELOW NEEDS TWO DECISIONS THAT DIFFER IN EXACTLY
// ONE DISCRIMINATOR. Reusing id_field for both would compare a scope with itself and pass whatever
// scopes_eq did.
data id_other_field: DeclarationRef = decl_ref(module_path: "test.claim.realization_selection_witness", decl_name: "id_other_field")

// ── A REFUSAL NOW CARRIES THE SCOPE IT REFUSED, AND TWO REFUSALS ARE TELLABLE APART ─────────────
//
// THIS IS THE CONTROL THE DECOMPOSITION EXISTS FOR, and without it the new field is a declaration
// nothing reads -- the section 3c dangling finding. "Nothing is feasible" is the claim most likely to be
// quoted outside its scope later, because it travels further than "this candidate won": a reader six
// months on sees a refusal and concludes the SUBJECT cannot be served, when what was refused was one
// field under one constraint set against one evidence snapshot.
//
// SO THE ASSERTION IS THAT THE SCOPES DIFFER, NOT THAT THE CAUSES DO. Cause text is display. The two
// refusals below are over fields with DIFFERENT candidate-field identities, and `scopes_eq` separates
// them -- which is section 3d's "a stale choice is mechanically detectable" holding on the negative arm
// for the first time. Both halves are needed: the same-scope pair must compare EQUAL, or the test would
// pass for a scope that merely varies with something incidental.
fn refusal_scope_over(field_identity: DeclarationRef) -> DecisionScope? {
  match select_realization(
    assessment: closed_selection_assessment(),
    candidate_field_identity: field_identity,
    field: [entry_over_cap_missing_tput(id: id_a, label: "over cap" as NonEmptyStr, power: 200)],
    axes: axes_forward(),
    constraints: [power_cap],
    constraint_authority: id_constraints,
    policy: UniqueSurvivorRequired { identity: id_policy_unique },
    evidence_snapshot: id_evidence,
  ) {
    NoFeasibleRealization { causes: _, scope: sc } => Present { value: sc }
    SelectedWithin { candidate: _, receipt: _ } => none
    SelectionNeedsEvidence { needs: _ } => none
    SelectionNeedsPolicy { survivors: _ } => none
    RealizationSelectionRefused { defects: _ } => none
    CandidateFieldUnestablished { causes: _ } => none
  }
}

test fn two_refusals_over_different_fields_carry_distinguishable_scopes() -> Bool {
  match refusal_scope_over(field_identity: id_field) {
    Absent => false
    Present { value: s1 } =>
      match refusal_scope_over(field_identity: id_other_field) {
        Absent => false
        Present { value: s2 } =>
          !scopes_eq(a: s1, b: s2)
            && scopes_eq(a: s1, b: s1)
            && declaration_ref_eq(a: s1.candidate_field_identity, b: id_field)
            && declaration_ref_eq(a: s1.constraint_authority, b: id_constraints)
            && declaration_ref_eq(a: s1.evidence_snapshot, b: id_evidence)
            && count(s1.funded_axes) > 0
      }
  }
}

// ── UniqueSurvivorElsePrefer: one arm, one witness per branch, each with a discriminating red ────

// BRANCH 1 — a single survivor wins on its own merit even when it is NOT the preferred identity.
// Here id_a strictly dominates id_b (higher tput AND lower power), so id_a is the sole survivor; the
// preferred identity id_b is dominated and must NOT be chosen.
// RED: swap the policy to PreferSurvivor { preferred: id_b } — id_b is dominated, so PreferSurvivor
// returns RealizationSelectionRefused, not SelectedWithin(id_a). This is exactly the gap the new arm
// closes: PreferSurvivor cannot let a dominating non-preferred candidate win.
test fn usesep_single_survivor_wins_even_when_not_preferred() -> Bool {
  let dominator = entry(id: id_a, label: "dominates" as NonEmptyStr, tput: 80, power: 20)
  let dominated = entry(id: id_b, label: "dominated" as NonEmptyStr, tput: 20, power: 80)
  match select_realization(
    assessment: closed_selection_assessment(),
    candidate_field_identity: id_field,
    field: [dominator, dominated],
    axes: axes_forward(),
    constraints: [],
    constraint_authority: id_constraints,
    policy: UniqueSurvivorElsePrefer { identity: id_policy_usesep, preferred: id_b },
    evidence_snapshot: id_evidence,
  ) {
    SelectedWithin { candidate: c, receipt: _ } => declaration_ref_eq(a: c.identity, b: id_a)
    _ => false
  }
}

// BRANCH 2 — several nondominated ALTERNATIVES (a tradeoff, not an equality) that INCLUDE the preferred
// identity select the preferred. id_a wins tput, id_b wins power: neither dominates, so both survive;
// the preferred id_b is selected. This records a preference among incomparable alternatives — it does
// NOT assert id_a and id_b are equal on any axis.
// RED: swap the policy to UniqueSurvivorRequired — two survivors is not one, so it returns
// SelectionNeedsPolicy and never selects id_b. The "else prefer" branch is what resolves the tradeoff.
test fn usesep_tie_including_preferred_selects_preferred() -> Bool {
  let tput_winner = entry(id: id_a, label: "tput winner" as NonEmptyStr, tput: 80, power: 80)
  let power_winner = entry(id: id_b, label: "power winner" as NonEmptyStr, tput: 20, power: 20)
  match select_realization(
    assessment: closed_selection_assessment(),
    candidate_field_identity: id_field,
    field: [tput_winner, power_winner],
    axes: axes_forward(),
    constraints: [],
    constraint_authority: id_constraints,
    policy: UniqueSurvivorElsePrefer { identity: id_policy_usesep, preferred: id_b },
    evidence_snapshot: id_evidence,
  ) {
    SelectedWithin { candidate: c, receipt: _ } => declaration_ref_eq(a: c.identity, b: id_b)
    _ => false
  }
}

// BRANCH 3 — several nondominated alternatives that EXCLUDE the preferred identity stay
// SelectionNeedsPolicy, never a silent refusal or a fallthrough. id_a and id_b both survive; the
// preferred id_c is not in the field.
// RED: swap the policy to PreferSurvivor { preferred: id_c } — id_c is not a survivor, so PreferSurvivor
// returns RealizationSelectionRefused. The new arm defers instead of refusing an unresolved field.
test fn usesep_tie_excluding_preferred_needs_policy_not_refused() -> Bool {
  let tput_winner = entry(id: id_a, label: "tput winner" as NonEmptyStr, tput: 80, power: 80)
  let power_winner = entry(id: id_b, label: "power winner" as NonEmptyStr, tput: 20, power: 20)
  match select_realization(
    assessment: closed_selection_assessment(),
    candidate_field_identity: id_field,
    field: [tput_winner, power_winner],
    axes: axes_forward(),
    constraints: [],
    constraint_authority: id_constraints,
    policy: UniqueSurvivorElsePrefer { identity: id_policy_usesep, preferred: id_c },
    evidence_snapshot: id_evidence,
  ) {
    SelectionNeedsPolicy { survivors: sv } =>
      (sv |> count) == 2
        && any(sv, s => declaration_ref_eq(a: s, b: id_a))
        && any(sv, s => declaration_ref_eq(a: s, b: id_b))
    _ => false
  }
}

// BRANCH 4 — no survivors (the only candidate violates a hard constraint) is NoFeasibleRealization,
// matching the existing arms. NOTE (corrected coverage): a hard-constraint exclusion empties the
// remaining field at scan_feasibility, which short-circuits to NoFeasibleRealization BEFORE apply_policy
// runs, so this end-to-end case does NOT exercise the arm's own count == 0 branch and is not a
// discriminating red for it. It is kept as an end-to-end check that the arm agrees with the existing
// arms on an all-infeasible field; the arm's count == 0 branch is reachable only when the Pareto fold
// yields an empty survivor set from a non-empty feasible field, which no current input produces.
test fn usesep_no_survivors_is_no_feasible_not_needs_policy() -> Bool {
  let forbidden = entry(id: id_a, label: "over cap" as NonEmptyStr, tput: 10, power: 200)
  match select_realization(
    assessment: closed_selection_assessment(),
    candidate_field_identity: id_field,
    field: [forbidden],
    axes: axes_forward(),
    constraints: [power_cap],
    constraint_authority: id_constraints,
    policy: UniqueSurvivorElsePrefer { identity: id_policy_usesep, preferred: id_a },
    evidence_snapshot: id_evidence,
  ) {
    NoFeasibleRealization { causes: _, scope: _ } => true
    _ => false
  }
}

// BRANCH 5 — interval readings that leave dominance UNDECIDED stay SelectionNeedsEvidence; they are
// never read as a tie that the policy could resolve. id_a's tput interval [50,100] and id_b's [0,60]
// overlap, so neither dominates and neither is dominated: the standing is undecided, not two survivors.
// RED: if undecided dominance were folded into the survivor set, both would survive and the preferred
// id_b would be SelectedWithin — this witness asserts SelectionNeedsEvidence, so that mutation goes red.
test fn usesep_undecided_dominance_stays_needs_evidence_never_a_tie() -> Bool {
  let a = entry_interval_tput(id: id_a, label: "tput [50,100]" as NonEmptyStr, tput_low: 50, tput_high: 100, power: 20)
  let b = entry_interval_tput(id: id_b, label: "tput [0,60]" as NonEmptyStr, tput_low: 0, tput_high: 60, power: 20)
  match select_realization(
    assessment: closed_selection_assessment(),
    candidate_field_identity: id_field,
    field: [a, b],
    axes: axes_forward(),
    constraints: [],
    constraint_authority: id_constraints,
    policy: UniqueSurvivorElsePrefer { identity: id_policy_usesep, preferred: id_b },
    evidence_snapshot: id_evidence,
  ) {
    SelectionNeedsEvidence { needs: _ } => true
    SelectedWithin { candidate: _, receipt: _ } => false
    SelectionNeedsPolicy { survivors: _ } => false
    _ => false
  }
}

// RECEIPT CONTROL — change the policy ARM, hold the question and the selected candidate fixed: the
// receipts must differ. id_a strictly dominates id_b, so both policies select id_a; only the arm differs.
// RED: if the receipt recorded only the authority reference (not the applied policy), the two receipts
// would be receipts_eq and this witness would go red.
test fn usesep_receipt_distinguishes_a_change_of_arm() -> Bool {
  let dominator = entry(id: id_a, label: "dominates" as NonEmptyStr, tput: 80, power: 20)
  let dominated = entry(id: id_b, label: "dominated" as NonEmptyStr, tput: 20, power: 80)
  let field = [dominator, dominated]
  match receipt_for(field: field, pol: UniqueSurvivorRequired { identity: id_policy_usesep }) {
    Absent => false
    Present { value: r1 } =>
      match receipt_for(field: field, pol: UniqueSurvivorElsePrefer { identity: id_policy_usesep, preferred: id_b }) {
        Absent => false
        Present { value: r2 } =>
          declaration_ref_eq(a: r1.selected_identity, b: id_a)
            && declaration_ref_eq(a: r2.selected_identity, b: id_a)
            && !receipts_eq(a: r1, b: r2)
      }
  }
}

// RECEIPT CONTROL — change the PREFERRED parameter, same arm, same selection: the receipts must differ.
// id_a is the unique survivor under both, so the selection is identical; only the preferred parameter
// differs, and it must still be visible in the receipt.
// RED: if policy_equality ignored the preferred parameter, the two receipts would be receipts_eq -> red.
test fn usesep_receipt_distinguishes_a_change_of_preferred_parameter() -> Bool {
  let dominator = entry(id: id_a, label: "dominates" as NonEmptyStr, tput: 80, power: 20)
  let dominated = entry(id: id_b, label: "dominated" as NonEmptyStr, tput: 20, power: 80)
  let field = [dominator, dominated]
  match receipt_for(field: field, pol: UniqueSurvivorElsePrefer { identity: id_policy_usesep, preferred: id_b }) {
    Absent => false
    Present { value: r1 } =>
      match receipt_for(field: field, pol: UniqueSurvivorElsePrefer { identity: id_policy_usesep, preferred: id_c }) {
        Absent => false
        Present { value: r2 } =>
          declaration_ref_eq(a: r1.selected_identity, b: id_a)
            && declaration_ref_eq(a: r2.selected_identity, b: id_a)
            && !receipts_eq(a: r1, b: r2)
      }
  }
}

// RECEIPT CONTROL — repeat the IDENTICAL policy: the receipts must be equal. Guards against
// over-discrimination (comparing the policy by reference rather than by structure).
// RED: if policy_equality compared policies by identity/reference rather than structurally, the two
// receipts would differ -> red.
test fn usesep_receipt_is_stable_under_a_repeated_identical_policy() -> Bool {
  let dominator = entry(id: id_a, label: "dominates" as NonEmptyStr, tput: 80, power: 20)
  let dominated = entry(id: id_b, label: "dominated" as NonEmptyStr, tput: 20, power: 80)
  let field = [dominator, dominated]
  match receipt_for(field: field, pol: UniqueSurvivorElsePrefer { identity: id_policy_usesep, preferred: id_b }) {
    Absent => false
    Present { value: r1 } =>
      match receipt_for(field: field, pol: UniqueSurvivorElsePrefer { identity: id_policy_usesep, preferred: id_b }) {
        Absent => false
        Present { value: r2 } => receipts_eq(a: r1, b: r2)
      }
  }
}
