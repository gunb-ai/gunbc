module test.claim.fabric_m0_job_ending_witness

import std.types { Bool, List, NonEmptyStr }
import std.process { exit_ok }
import std.measure { hardware_thread_count }
import std.content_hash { Sha256Digest }
import std.scoped_authorization { AttemptIdentity }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import product.fabric.envelope { unstated_envelope }
import product.fabric.isolation { shared_kernel_sandbox_profile }
import product.fabric.work {
  Work, WorkContract, WorkStep, ReceiptSatisfiable, ExecutionRequirements,
  Shape, HardRequirements, ControlPlaneCapacity, work_for,
  OutputObligation, OutputArtifactObligation, TerminalResultObligation,
  DeclaredOutputObligations,
}
import std.durable_compare_and_set { CasStoreRefused, CasUnreadableReadRefused }
import extdeps.github.checks {
  Success,
  Failure,
  ActionRequired,
  Neutral,
  check_conclusion_is_success,
}
import gunbc.fabric_m0_completion {
  ComputationSucceeded,
  ComputationFailed,
  OriginObservation,
  ObligationSubject,
  CommittedOutput,
  ManifestMember,
  ReadbackConfirmed,
  PublishSuccess,
  PublishComputationFailed,
  PublishFinalizationFailed,
  PublishPendingReconciliation,
  PublishObligationsUnreadable,
}
import gunbc.fabric_m0_commit {
  CommitTransportOutcome,
  StoreAnswered,
  StoreDidNotAnswer,
  ManifestReadbackObservation,
  ManifestRead,
  cache_manifest_read,
  ManifestNotFound,
  ManifestReadUnavailable,
  CommitNamespace,
}
import gunbc.fabric_m0_origin_readback {
  OriginReading,
  OriginReadingOutcome,
  OriginReadingTaken,
  OriginReadingUnavailable,
  origin_reading_digest,
  read_origin_staged_file,
}
import gunbc.fabric_m0_job_ending {
  JobEnding,
  end_required_job,
  check_conclusion_of_publication,
  process_exit_of_job_ending,
}

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data fixture_staged_manifest: NonEmptyStr = "dag/test/fixture/fabric_m0_origin_readback/staged_manifest.txt"

fn read_outcome() -> OriginReadingOutcome {
  read_origin_staged_file(staged_path: fixture_staged_manifest)
}

fn digest_a(r: OriginReading) -> Sha256Digest {
  origin_reading_digest(reading: r)
}

fn the_attempt() -> AttemptIdentity {
  "attempt-1" as AttemptIdentity
}

fn the_namespace() -> CommitNamespace {
  "fabric-m0/v1/commit" as CommitNamespace
}

fn our_slot() -> NonEmptyStr {
  "fabric-m0/v1/commit/attempt-1"
}

fn answered() -> CommitTransportOutcome {
  StoreAnswered {
    slot: our_slot(),
    outcome: CasStoreRefused { cause: CasUnreadableReadRefused { detail: "read refused" } },
  }
}

fn origin_read(r: OriginReading) -> ManifestReadbackObservation {
  ManifestRead { reading: r }
}

fn build_output() -> OutputObligation {
  OutputObligation { id: "build-output", kind: OutputArtifactObligation {} }
}

fn execution_receipt() -> OutputObligation {
  OutputObligation { id: "execution-receipt", kind: TerminalResultObligation {} }
}

fn fixture_requirements() -> ExecutionRequirements {
  ExecutionRequirements {
    capacity_class: ControlPlaneCapacity,
    shape: Shape {
      hard: HardRequirements { threads: hardware_thread_count(8) },
      envelope: unstated_envelope(),
    },
    capabilities: "linux-arm64",
    trust_domain: "fleet-owned",
    isolation: shared_kernel_sandbox_profile(),
  }
}

fn the_contract() -> WorkContract {
  WorkContract {
    program: "gunbc.fabric-m0.program:1",
    steps: [WorkStep { step_id: "fabric-m0", resumability: ReceiptSatisfiable }],
    source: "source:1",
    inputs: "inputs:1",
    runtime_closure: "runtime:1",
    effect_contract: "effects:1",
    output_contract: "outputs:1",
    output_obligations: DeclaredOutputObligations { required: [build_output(), execution_receipt()] },
  }
}

fn the_work() -> Work<NonEmptyStr> {
  work_for(principal: "gunbc" as NonEmptyStr, contract: the_contract(), requirements: fixture_requirements())
}

fn committed_both(r: OriginReading) -> List<CommittedOutput> {
  [
    CommittedOutput { obligation: build_output(), attempt: the_attempt(), recorded_digest: digest_a(r: r) },
    CommittedOutput { obligation: execution_receipt(), attempt: the_attempt(), recorded_digest: digest_a(r: r) },
  ]
}

fn members_both(r: OriginReading) -> List<ManifestMember> {
  [
    ManifestMember { obligation: build_output(), content: digest_a(r: r) },
    ManifestMember { obligation: execution_receipt(), content: digest_a(r: r) },
  ]
}

fn object_reads(r: OriginReading) -> List<OriginObservation> {
  [
    OriginObservation { subject: ObligationSubject { obligation: build_output() }, readback: ReadbackConfirmed { reading: r } },
    OriginObservation { subject: ObligationSubject { obligation: execution_receipt() }, readback: ReadbackConfirmed { reading: r } },
  ]
}

// POSITIVE CONTROL: a complete attempt's check conclusion is Success, and only Success
// passes gunbc.merge_admission check_conclusion_is_success.
test fn a_complete_work_concludes_check_success() -> Bool {
  match read_outcome() {
    OriginReadingUnavailable { staged_path: _, cause: _ } => false
    OriginReadingTaken { reading: r } =>
      match end_required_job(
        work: the_work(),
        attempt: the_attempt(),
        computation: ComputationSucceeded,
        committed: committed_both(r: r),
        observations: object_reads(r: r),
        namespace: the_namespace(),
        manifest_digest: digest_a(r: r),
        members: members_both(r: r),
        transport: answered(),
        observed: origin_read(r: r),
      ) {
        JobEnding { publication, conclusion } =>
          match publication {
            PublishSuccess { attempt: _, manifest_digest: _ } =>
              (conclusion == Success) && check_conclusion_is_success(c: conclusion)
            PublishComputationFailed { attempt: _, cause: _, unresolved: _ } => false
            PublishFinalizationFailed { attempt: _, subject: _, cause: _, unresolved: _ } => false
            PublishPendingReconciliation { attempt: _, subject: _, cause: _, unresolved: _ } => false
            PublishObligationsUnreadable { attempt: _, subject: _, cause: _, unresolved: _ } => false
          }
      }
  }
}

test fn a_failed_computation_concludes_check_failure() -> Bool {
  match read_outcome() {
    OriginReadingUnavailable { staged_path: _, cause: _ } => false
    OriginReadingTaken { reading: r } =>
      match end_required_job(
        work: the_work(),
        attempt: the_attempt(),
        computation: ComputationFailed { cause: "compile failed" },
        committed: committed_both(r: r),
        observations: object_reads(r: r),
        namespace: the_namespace(),
        manifest_digest: digest_a(r: r),
        members: members_both(r: r),
        transport: answered(),
        observed: origin_read(r: r),
      ) {
        JobEnding { publication, conclusion } =>
          match publication {
            PublishComputationFailed { attempt: _, cause, unresolved: _ } =>
              (cause == "compile failed") && (conclusion == Failure) && (check_conclusion_is_success(c: conclusion) == false)
            PublishSuccess { attempt: _, manifest_digest: _ } => false
            PublishFinalizationFailed { attempt: _, subject: _, cause: _, unresolved: _ } => false
            PublishPendingReconciliation { attempt: _, subject: _, cause: _, unresolved: _ } => false
            PublishObligationsUnreadable { attempt: _, subject: _, cause: _, unresolved: _ } => false
          }
      }
  }
}

// RED: a cache hit must not conclude Success. Pending maps to ActionRequired, never Neutral
// (GitHub treats Neutral as success for required checks).
test fn a_cache_manifest_read_concludes_action_required() -> Bool {
  match read_outcome() {
    OriginReadingUnavailable { staged_path: _, cause: _ } => false
    OriginReadingTaken { reading: r } =>
      match end_required_job(
        work: the_work(),
        attempt: the_attempt(),
        computation: ComputationSucceeded,
        committed: committed_both(r: r),
        observations: object_reads(r: r),
        namespace: the_namespace(),
        manifest_digest: digest_a(r: r),
        members: members_both(r: r),
        transport: answered(),
        observed: cache_manifest_read(provider: "local-store"),
      ) {
        JobEnding { publication, conclusion } =>
          match publication {
            PublishPendingReconciliation { attempt: _, subject: _, cause: _, unresolved: _ } =>
              (conclusion == ActionRequired)
                && (conclusion == Neutral) == false
                && check_conclusion_is_success(c: conclusion) == false
            PublishSuccess { attempt: _, manifest_digest: _ } => false
            PublishComputationFailed { attempt: _, cause: _, unresolved: _ } => false
            PublishFinalizationFailed { attempt: _, subject: _, cause: _, unresolved: _ } => false
            PublishObligationsUnreadable { attempt: _, subject: _, cause: _, unresolved: _ } => false
          }
      }
  }
}

test fn a_lost_ack_without_origin_read_concludes_action_required() -> Bool {
  match read_outcome() {
    OriginReadingUnavailable { staged_path: _, cause: _ } => false
    OriginReadingTaken { reading: r } =>
      match end_required_job(
        work: the_work(),
        attempt: the_attempt(),
        computation: ComputationSucceeded,
        committed: committed_both(r: r),
        observations: object_reads(r: r),
        namespace: the_namespace(),
        manifest_digest: digest_a(r: r),
        members: members_both(r: r),
        transport: StoreDidNotAnswer { slot: our_slot(), cause: "commit acknowledgement lost" },
        observed: ManifestNotFound,
      ) {
        JobEnding { publication, conclusion } =>
          match publication {
            PublishPendingReconciliation { attempt: _, subject: _, cause: _, unresolved: _ } =>
              (conclusion == ActionRequired) && (check_conclusion_is_success(c: conclusion) == false)
            PublishSuccess { attempt: _, manifest_digest: _ } => false
            PublishComputationFailed { attempt: _, cause: _, unresolved: _ } => false
            PublishFinalizationFailed { attempt: _, subject: _, cause: _, unresolved: _ } => false
            PublishObligationsUnreadable { attempt: _, subject: _, cause: _, unresolved: _ } => false
          }
      }
  }
}

test fn an_unavailable_origin_read_concludes_action_required() -> Bool {
  match read_outcome() {
    OriginReadingUnavailable { staged_path: _, cause: _ } => false
    OriginReadingTaken { reading: r } =>
      match end_required_job(
        work: the_work(),
        attempt: the_attempt(),
        computation: ComputationSucceeded,
        committed: committed_both(r: r),
        observations: object_reads(r: r),
        namespace: the_namespace(),
        manifest_digest: digest_a(r: r),
        members: members_both(r: r),
        transport: answered(),
        observed: ManifestReadUnavailable { cause: "origin unbound" },
      ) {
        JobEnding { publication, conclusion } =>
          match publication {
            PublishPendingReconciliation { attempt: _, subject: _, cause: _, unresolved: _ } =>
              (conclusion == ActionRequired) && (check_conclusion_is_success(c: conclusion) == false)
            PublishSuccess { attempt: _, manifest_digest: _ } => false
            PublishComputationFailed { attempt: _, cause: _, unresolved: _ } => false
            PublishFinalizationFailed { attempt: _, subject: _, cause: _, unresolved: _ } => false
            PublishObligationsUnreadable { attempt: _, subject: _, cause: _, unresolved: _ } => false
          }
      }
  }
}

test fn an_absent_manifest_at_answered_store_concludes_failure() -> Bool {
  match read_outcome() {
    OriginReadingUnavailable { staged_path: _, cause: _ } => false
    OriginReadingTaken { reading: r } =>
      match end_required_job(
        work: the_work(),
        attempt: the_attempt(),
        computation: ComputationSucceeded,
        committed: committed_both(r: r),
        observations: object_reads(r: r),
        namespace: the_namespace(),
        manifest_digest: digest_a(r: r),
        members: members_both(r: r),
        transport: answered(),
        observed: ManifestNotFound,
      ) {
        JobEnding { publication, conclusion } =>
          match publication {
            PublishFinalizationFailed { attempt: _, subject: _, cause: _, unresolved: _ } =>
              (conclusion == Failure) && (check_conclusion_is_success(c: conclusion) == false)
            PublishSuccess { attempt: _, manifest_digest: _ } => false
            PublishComputationFailed { attempt: _, cause: _, unresolved: _ } => false
            PublishPendingReconciliation { attempt: _, subject: _, cause: _, unresolved: _ } => false
            PublishObligationsUnreadable { attempt: _, subject: _, cause: _, unresolved: _ } => false
          }
      }
  }
}

test fn pending_publication_never_maps_to_success() -> Bool {
  match read_outcome() {
    OriginReadingUnavailable { staged_path: _, cause: _ } => false
    OriginReadingTaken { reading: r } =>
      match end_required_job(
        work: the_work(),
        attempt: the_attempt(),
        computation: ComputationSucceeded,
        committed: committed_both(r: r),
        observations: object_reads(r: r),
        namespace: the_namespace(),
        manifest_digest: digest_a(r: r),
        members: members_both(r: r),
        transport: answered(),
        observed: ManifestReadUnavailable { cause: "origin unbound" },
      ) {
        JobEnding { publication, conclusion: _ } =>
          (check_conclusion_of_publication(publication: publication) == Success) == false
      }
  }
}

// THE ONE ARM end_required_job CANNOT REACH. publish_work derives the judged key from the Work it
// holds, so a resolution bound to a foreign work -- the only producer of PublishObligationsUnreadable
// -- has no route through the ending. The mapping over it is exercised on the value directly: an
// unenumerable roster is DECIDED, so it concludes Failure rather than waiting on reconciliation.
test fn an_unreadable_roster_concludes_failure_rather_than_action_required() -> Bool {
  check_conclusion_of_publication(
    publication: PublishObligationsUnreadable {
      attempt: the_attempt(),
      subject: "contract",
      cause: "a foreign work key cannot seal this contract's roster",
      unresolved: [],
    }
  ) == Failure
}

test fn process_exit_follows_the_ending_conclusion() -> Bool {
  match read_outcome() {
    OriginReadingUnavailable { staged_path: _, cause: _ } => false
    OriginReadingTaken { reading: r } =>
      let green = end_required_job(
        work: the_work(),
        attempt: the_attempt(),
        computation: ComputationSucceeded,
        committed: committed_both(r: r),
        observations: object_reads(r: r),
        namespace: the_namespace(),
        manifest_digest: digest_a(r: r),
        members: members_both(r: r),
        transport: answered(),
        observed: origin_read(r: r),
      )
      let pending = end_required_job(
        work: the_work(),
        attempt: the_attempt(),
        computation: ComputationSucceeded,
        committed: committed_both(r: r),
        observations: object_reads(r: r),
        namespace: the_namespace(),
        manifest_digest: digest_a(r: r),
        members: members_both(r: r),
        transport: answered(),
        observed: cache_manifest_read(provider: "local-store"),
      )
      exit_ok(e: process_exit_of_job_ending(ending: green))
        && (exit_ok(e: process_exit_of_job_ending(ending: pending)) == false)
  }
}
