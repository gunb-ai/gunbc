module test.claim.llm_attempt_receipt_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data fixture_substrate: gunbc.econ.llm_attempt_receipt.SubstrateIdentity = gunbc.econ.llm_attempt_receipt.SubstrateIdentity {
  compiler_revision: "4b7a13d73b1" as std.types.NonEmptyStr,
  authority_snapshot: "design-2026-08-05" as std.types.NonEmptyStr,
}

data fixture_concurrency: gunbc.econ.llm_attempt_receipt.ConcurrencyObservation = gunbc.econ.llm_attempt_receipt.ConcurrencyObservation {
  admitted_sessions: 16,
  active_sequences: 4,
}

data fixture_usage: gunbc.econ.llm_attempt_receipt.LlmTokenUsage = gunbc.econ.llm_attempt_receipt.LlmTokenUsage {
  input: std.measure.token_count(count: 32000),
  cached_input: std.measure.token_count(count: 30000),
  output: std.measure.token_count(count: 1000),
}

fn review_receipt(
  identity: std.types.NonEmptyStr,
  usage: gunbc.econ.llm_attempt_receipt.LlmUsageObservation,
  durations: gunbc.econ.llm_attempt_receipt.AttemptPhaseDurations,
  disposition: gunbc.econ.llm_attempt_receipt.ReviewDisposition,
) -> gunbc.econ.llm_attempt_receipt.LlmAttemptReceipt {
  gunbc.econ.llm_attempt_receipt.LlmAttemptReceipt {
    attempt_identity: identity,
    task_class: gunbc.econ.llm_attempt_receipt.DagReview,
    prompt_policy_identity: "review-policy-v1" as std.types.NonEmptyStr,
    context_policy_identity: "closure-context-v1" as std.types.NonEmptyStr,
    substrate: fixture_substrate,
    requested_model: "qwen3-coder-next" as gunbc.econ.llm_attempt_receipt.RequestedModelIdentity,
    resolved_model: "qwen3-coder-next-q4-k-m" as gunbc.econ.llm_attempt_receipt.ResolvedModelIdentity,
    model_artifact_identity: "qwen3-coder-next-Q4_K_M-gguf" as std.types.NonEmptyStr,
    serving_runtime_identity: "vllm-arm64-cuda" as std.types.NonEmptyStr,
    machine_opportunity_identity: "dgx-spark-01" as std.types.NonEmptyStr,
    concurrency: fixture_concurrency,
    prefix_cache: gunbc.econ.llm_attempt_receipt.PrefixCacheHit { reused: std.measure.token_count(count: 30000) },
    usage: usage,
    durations: durations,
    wall_energy: none,
    disposition: disposition,
  }
}

data one_second_decode: gunbc.econ.llm_attempt_receipt.AttemptPhaseDurations = gunbc.econ.llm_attempt_receipt.AttemptPhaseDurations {
  queue: Present { value: std.measure.nanosecond(count: 500000000) },
  prefill: Present { value: std.measure.nanosecond(count: 54000000000) },
  decode: Present { value: std.measure.nanosecond(count: 1000000000) },
}

data decode_unobserved: gunbc.econ.llm_attempt_receipt.AttemptPhaseDurations = gunbc.econ.llm_attempt_receipt.AttemptPhaseDurations {
  queue: none,
  prefill: none,
  decode: none,
}

data zero_decode: gunbc.econ.llm_attempt_receipt.AttemptPhaseDurations = gunbc.econ.llm_attempt_receipt.AttemptPhaseDurations {
  queue: none,
  prefill: none,
  decode: Present { value: std.measure.nanosecond(count: 0) },
}

data accepted_attempt: gunbc.econ.llm_attempt_receipt.LlmAttemptReceipt = review_receipt(
  identity: "attempt-accepted" as std.types.NonEmptyStr,
  usage: gunbc.econ.llm_attempt_receipt.LlmUsageObserved { usage: fixture_usage },
  durations: one_second_decode,
  disposition: gunbc.econ.llm_attempt_receipt.ReviewAccepted,
)

data rejected_attempt: gunbc.econ.llm_attempt_receipt.LlmAttemptReceipt = review_receipt(
  identity: "attempt-rejected" as std.types.NonEmptyStr,
  usage: gunbc.econ.llm_attempt_receipt.LlmUsageObserved { usage: fixture_usage },
  durations: one_second_decode,
  disposition: gunbc.econ.llm_attempt_receipt.ReviewRejected { reason: "false positive finding" as std.types.NonEmptyStr },
)

data escalated_attempt: gunbc.econ.llm_attempt_receipt.LlmAttemptReceipt = review_receipt(
  identity: "attempt-escalated" as std.types.NonEmptyStr,
  usage: gunbc.econ.llm_attempt_receipt.LlmUsageObserved { usage: fixture_usage },
  durations: one_second_decode,
  disposition: gunbc.econ.llm_attempt_receipt.ReviewEscalated { reason: "architectural judgment required" as std.types.NonEmptyStr },
)

data usage_unobserved_attempt: gunbc.econ.llm_attempt_receipt.LlmAttemptReceipt = review_receipt(
  identity: "attempt-usage-unobserved" as std.types.NonEmptyStr,
  usage: gunbc.econ.llm_attempt_receipt.LlmUsageUnobserved { reason: "provider reported no usage block" as std.types.NonEmptyStr },
  durations: one_second_decode,
  disposition: gunbc.econ.llm_attempt_receipt.ReviewAccepted,
)

data decode_unobserved_attempt: gunbc.econ.llm_attempt_receipt.LlmAttemptReceipt = review_receipt(
  identity: "attempt-decode-unobserved" as std.types.NonEmptyStr,
  usage: gunbc.econ.llm_attempt_receipt.LlmUsageObserved { usage: fixture_usage },
  durations: decode_unobserved,
  disposition: gunbc.econ.llm_attempt_receipt.ReviewAccepted,
)

data zero_decode_attempt: gunbc.econ.llm_attempt_receipt.LlmAttemptReceipt = review_receipt(
  identity: "attempt-zero-decode" as std.types.NonEmptyStr,
  usage: gunbc.econ.llm_attempt_receipt.LlmUsageObserved { usage: fixture_usage },
  durations: zero_decode,
  disposition: gunbc.econ.llm_attempt_receipt.ReviewAccepted,
)

data mixed_roster: List<gunbc.econ.llm_attempt_receipt.LlmAttemptReceipt> = [
  accepted_attempt,
  rejected_attempt,
  escalated_attempt,
  usage_unobserved_attempt,
]

test fn decode_throughput_derives_from_counts_and_duration() -> Bool {
  match gunbc.econ.llm_attempt_receipt.derive_decode_throughput(receipt: accepted_attempt) {
    gunbc.econ.llm_attempt_receipt.DecodeThroughputDerived { throughput: t } => t.num == 1000 && t.denom == 1000000000
    gunbc.econ.llm_attempt_receipt.DecodeThroughputRefused { cause: _ } => false
  }
}

test fn decode_throughput_floor_projects_tokens_per_second() -> Bool {
  match gunbc.econ.llm_attempt_receipt.derive_decode_throughput(receipt: accepted_attempt) {
    gunbc.econ.llm_attempt_receipt.DecodeThroughputDerived { throughput: t } =>
      match gunbc.econ.llm_attempt_receipt.throughput_per_second_floor(t: t) {
        Present { value: v } => v == 1000
        none => false
      }
    gunbc.econ.llm_attempt_receipt.DecodeThroughputRefused { cause: _ } => false
  }
}

test fn unobserved_usage_refuses_throughput_without_refusing_the_attempt() -> Bool {
  let refused = match gunbc.econ.llm_attempt_receipt.derive_decode_throughput(receipt: usage_unobserved_attempt) {
    gunbc.econ.llm_attempt_receipt.DecodeThroughputRefused { cause: gunbc.econ.llm_attempt_receipt.ThroughputUsageUnobserved } => true
    _ => false
  }
  refused && gunbc.econ.llm_attempt_receipt.attempt_is_accepted(d: usage_unobserved_attempt.disposition)
}

test fn absent_decode_duration_refuses_rather_than_fabricating() -> Bool {
  match gunbc.econ.llm_attempt_receipt.derive_decode_throughput(receipt: decode_unobserved_attempt) {
    gunbc.econ.llm_attempt_receipt.DecodeThroughputRefused { cause: gunbc.econ.llm_attempt_receipt.DecodeDurationUnobserved } => true
    _ => false
  }
}

test fn zero_decode_duration_refuses_rather_than_fabricating() -> Bool {
  match gunbc.econ.llm_attempt_receipt.derive_decode_throughput(receipt: zero_decode_attempt) {
    gunbc.econ.llm_attempt_receipt.DecodeThroughputRefused { cause: gunbc.econ.llm_attempt_receipt.ZeroDecodeDuration } => true
    _ => false
  }
}

test fn zero_denominator_floor_projection_returns_none() -> Bool {
  match gunbc.econ.llm_attempt_receipt.throughput_per_second_floor(t: std.algebra.FieldOfFractions { num: 1000, denom: 0 }) {
    none => true
    Present { value: _ } => false
  }
}

test fn goodput_counts_accepted_attempts_only() -> Bool {
  gunbc.econ.llm_attempt_receipt.accepted_attempt_count(receipts: mixed_roster) == 2
    && gunbc.econ.llm_attempt_receipt.escalated_attempt_count(receipts: mixed_roster) == 1
}

test fn accepted_goodput_derives_over_the_observation_window() -> Bool {
  match gunbc.econ.llm_attempt_receipt.derive_accepted_goodput(receipts: mixed_roster, window: std.measure.nanosecond(count: 4000000000)) {
    gunbc.econ.llm_attempt_receipt.AcceptedGoodputDerived { goodput: g } => g.num == 2 && g.denom == 4000000000
    gunbc.econ.llm_attempt_receipt.AcceptedGoodputRefused { cause: _ } => false
  }
}

test fn empty_roster_refuses_goodput() -> Bool {
  match gunbc.econ.llm_attempt_receipt.derive_accepted_goodput(receipts: [], window: std.measure.nanosecond(count: 4000000000)) {
    gunbc.econ.llm_attempt_receipt.AcceptedGoodputRefused { cause: gunbc.econ.llm_attempt_receipt.EmptyAttemptRoster } => true
    _ => false
  }
}

test fn zero_window_refuses_goodput() -> Bool {
  match gunbc.econ.llm_attempt_receipt.derive_accepted_goodput(receipts: mixed_roster, window: std.measure.nanosecond(count: 0)) {
    gunbc.econ.llm_attempt_receipt.AcceptedGoodputRefused { cause: gunbc.econ.llm_attempt_receipt.ZeroObservationWindow } => true
    _ => false
  }
}

test fn escalation_fraction_is_exact_over_the_roster() -> Bool {
  match gunbc.econ.llm_attempt_receipt.derive_escalation_fraction(receipts: mixed_roster) {
    gunbc.econ.llm_attempt_receipt.EscalationFractionDerived { fraction: f } => f.num == 1 && f.denom == 4
    gunbc.econ.llm_attempt_receipt.EscalationFractionRefused { cause: _ } => false
  }
}

test fn empty_roster_refuses_escalation_fraction() -> Bool {
  match gunbc.econ.llm_attempt_receipt.derive_escalation_fraction(receipts: []) {
    gunbc.econ.llm_attempt_receipt.EscalationFractionRefused { cause: gunbc.econ.llm_attempt_receipt.EmptyAttemptRoster } => true
    _ => false
  }
}

test fn token_count_round_trips_its_magnitude() -> Bool {
  std.measure.token_count_value(t: std.measure.token_count(count: 32000)) == 32000
}
