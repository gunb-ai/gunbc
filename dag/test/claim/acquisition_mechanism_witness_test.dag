data zero_converted_forecast_fixture: gunbc.econ.acquisition.AcquisitionCostForecast = gunbc.econ.acquisition.AcquisitionCostForecast {
  entry_stage_label: "click",
  outcome_stage_label: "customer",
  composed_rate: gunbc.econ.acquisition.ConversionRate { num: 0, denom: 1 },
  entry_unit_cost: two_usd_per_click,
}

test fn w_red_floor_projection_refuses_hand_built_zero_converted_forecast() -> Bool {
  match gunbc.econ.acquisition.acquisition_forecast_cost_floor_micros(forecast: zero_converted_forecast_fixture) {
    Present { value: _ } => false
    Absent => true
  }
}

test fn w_red_first_invalid_stage_wins() -> Bool {
  match gunbc.econ.acquisition.derive_acquisition_cost_forecast(input: gunbc.econ.acquisition.AcquisitionScenarioDeclared {
    scenario: gunbc.econ.acquisition.AcquisitionScenario {
      entry_stage_label: "click",
      entry_unit_cost: two_usd_per_click,
      steps: [
        gunbc.econ.acquisition.AcquisitionStageStep { stage_label: "lead", assumed_rate: gunbc.econ.acquisition.ConversionRate { num: 0, denom: 10 } },
        gunbc.econ.acquisition.AcquisitionStageStep { stage_label: "customer", assumed_rate: gunbc.econ.acquisition.ConversionRate { num: 0, denom: 4 } },
      ],
    },
  }) {
    gunbc.econ.acquisition.AcquisitionForecastRefused { cause: gunbc.econ.acquisition.ZeroConversionNumerator { stage_label: l } } =>
      (l as String) == "lead"
    _ => false
  }
}
