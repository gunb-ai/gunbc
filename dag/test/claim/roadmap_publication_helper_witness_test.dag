module test.claim.roadmap_publication_helper_witness

import std.types { Bool, String, NonEmptyStr, CommitSha }
import std.layout { render }
import gunbc.repository { gunbc_repository }
import extdeps.github.github { Repository }
import gunbc.roadmap_publish { RoadmapPublicationSubject }
import gunbc.roadmap_publication_helper {
  publication_helper_disposition_detail,
  publication_spool_key,
  PublicationCapabilityAdmission, SubjectWithinCapability, SubjectOutsideCapability,
  publication_helper_capability_admits,
  publication_spool_entry_name,
  publication_request_json,
  publication_request_decode,
  PublicationRequestDecode, RequestDecoded, RequestUndecodable,
  publication_request_path_for,
  publication_answer_path_for,
  PublicationHelperOutcome,
  HelperAnswered, HelperRequestNotConsumed, HelperRequestUnreadable,
  HelperRequestRefused, HelperRequestNotQuarantined,
  HelperAnswerWriteFailed, HelperSpoolRefused, HelperSubjectOutsideCapability,
  PublicationHelperDisposition, OutcomeRecorded, OutcomeStopsTheLine,
  publication_helper_outcome_disposition,
  publication_helper_outcome_key,
  PublicationHelperRunStanding, HelperRunCompleted, HelperRunStopped,
  publication_helper_run_standing,
  publication_helper_answer_request,
  publication_request_admission,
  RequestAdmission, RequestAdmitted, RequestUndecodableDocument,
  RequestOutsideCapability, RequestMisaddressed,
  publication_helper_credential_env_var,
}
import gunbc.roadmap_publish_observe {
  PublicationCredentialSource, CredentialSourceAbsent,
}
import gunbc.host_layout {
  publication_request_dir,
  publication_answer_dir,
  publication_refused_dir,
}
import gunbc.live_deploy.emit {
  live_deploy_protocol,
  emit_publication_service_unit_doc,
  emit_belt_service_unit_doc,
  emit_systemd_unit_doc,
  ReleaseRevisionBinding,
  RevisionBoundAtEmission,
}
import gunbc.live_deploy.spec {
  DeploymentSpec,
  deployment_spec_srv1,
  deployment_credential_env_path,
}

// WHAT THIS FILE ASSERTS, AND WHAT IT CANNOT.
//
// The deliverable is a NEGATIVE property -- the belt and serve units never hold a GitHub token --
// and a negative over a whole process is not something a hermetic witness can establish. What is
// establishable is the two facts the property is built from, and both are asserted here by
// execution: the units that spawn children bind no credential while the unit that does bind one
// starts no session (over rendered unit bytes, which is where a credential binding is either present
// or absent), and the request document the belt hands across carries a subject and nothing that
// could direct a write.
//
// WHAT IS DELIBERATELY NOT CLAIMED. Nothing here observes a host, so this says nothing about
// whether the publication account exists on srv1, whether the credential file is placed, or what
// its mode is. Those are the operator's half, declared in gunbc.live_deploy.spec
// deployment_credential_env_path, and asserting them from a fixture would be the authored-versus-
// executed collapse this repository keeps paying for.

fn live_spec() -> DeploymentSpec {
  deployment_spec_srv1()
}

fn live_revision() -> ReleaseRevisionBinding {
  RevisionBoundAtEmission { revision: "0000000000000000000000000000000000000000" as CommitSha }
}

fn subject_at(node_id: String, attempt_key: String, head: String) -> RoadmapPublicationSubject {
  RoadmapPublicationSubject {
    node_id: node_id,
    attempt_key: attempt_key,
    repository: gunbc_repository,
    branch: "session/sharp-crab-95" as NonEmptyStr,
    expected_base: gunbc_repository.default_branch as NonEmptyStr,
    expected_head: head as CommitSha,
  }
}

// A REPOSITORY THAT IS NOT THIS ONE, built from the real authority so the only thing that differs
// is the identity under test rather than an incidentally malformed record.
fn other_repository() -> Repository {
  Repository {
    owner: "other-owner",
    name: "other-repo",
    full_name: "other-owner/other-repo",
    private: false,
    default_branch: gunbc_repository.default_branch,
  }
}

fn ordinary_subject() -> RoadmapPublicationSubject {
  subject_at(
    node_id: "adhoc-27aa0eed-025",
    attempt_key: "a1",
    head: "1111111111111111111111111111111111111111",
  )
}

// ── The spool key separates every field of the subject ─────────────────────────────────
//
// SIX FIELDS, SIX ASSERTIONS, AND THAT COUNT IS THE POINT. The previous key was built from three of
// the subject's six fields, so the three it omitted -- repository owner, repository name, branch and
// expected_base -- collided silently. A witness that only checked "the key is stable" would have
// passed against the defective key just as happily, so each field is varied ALONE and required to
// move the key. This is the discriminating form: it fails if any field is dropped from the digest.
//
// The path-separator and empty-field refusals this block used to assert are GONE, deliberately.
// publication_spool_key returns a lower-hex-16 digest, so no subject can produce a key containing
// `/` or `..` and the refusal's RED is no longer authorable anywhere -- a check that cannot fail is
// a decoration cited as coverage (DESIGN section 4b), so it is deleted with the machinery it guarded
// rather than kept as a permanently-green reassurance.

fn key_of(s: RoadmapPublicationSubject) -> String { publication_spool_key(subject: s) }

test fn the_spool_key_is_stable_and_names_its_own_entry() -> Bool {
  let k = key_of(s: ordinary_subject())
  k == key_of(s: ordinary_subject())
    && publication_spool_entry_name(key: k) == join([k, ".json"], "")
    && !string_contains(s: k, pattern: "/")
    && !string_contains(s: k, pattern: ".")
}

test fn every_field_of_the_subject_moves_the_spool_key() -> Bool {
  let base = ordinary_subject()
  let k = key_of(s: base)
  let node = k != key_of(s: subject_at(node_id: "other-node", attempt_key: "a1", head: "1111111111111111111111111111111111111111"))
  let attempt = k != key_of(s: subject_at(node_id: "adhoc-27aa0eed-025", attempt_key: "a2", head: "1111111111111111111111111111111111111111"))
  let head = k != key_of(s: subject_at(node_id: "adhoc-27aa0eed-025", attempt_key: "a1", head: "2222222222222222222222222222222222222222"))
  let owner = k != key_of(s: RoadmapPublicationSubject {
    node_id: base.node_id, attempt_key: base.attempt_key,
    repository: other_repository(), branch: base.branch,
    expected_base: base.expected_base, expected_head: base.expected_head,
  })
  let branch = k != key_of(s: RoadmapPublicationSubject {
    node_id: base.node_id, attempt_key: base.attempt_key,
    repository: base.repository, branch: "session/other" as NonEmptyStr,
    expected_base: base.expected_base, expected_head: base.expected_head,
  })
  let expected_base = k != key_of(s: RoadmapPublicationSubject {
    node_id: base.node_id, attempt_key: base.attempt_key,
    repository: base.repository, branch: base.branch,
    expected_base: "release/9" as NonEmptyStr, expected_head: base.expected_head,
  })
  node && attempt && head && owner && branch && expected_base
}

// ── The credential is not spent on a repository the requester chose ───────────────────────
//
// THE CONFUSED-DEPUTY WALL, asserted as a pair so it cannot pass by admitting everything. The helper
// holds an authority the requester does not, and the request names its own repository, so without
// this check the service principal could direct the credential at any target it liked.

test fn a_request_for_this_repository_is_within_the_capability() -> Bool {
  match publication_helper_capability_admits(subject: ordinary_subject()) {
    SubjectWithinCapability => true
    SubjectOutsideCapability { detail: _ } => false
  }
}

test fn a_request_naming_another_repository_is_refused_before_any_observation() -> Bool {
  let base = ordinary_subject()
  match publication_helper_capability_admits(subject: RoadmapPublicationSubject {
    node_id: base.node_id, attempt_key: base.attempt_key,
    repository: other_repository(), branch: base.branch,
    expected_base: base.expected_base, expected_head: base.expected_head,
  }) {
    SubjectOutsideCapability { detail } =>
      string_contains(s: detail, pattern: "other-owner")
        && string_contains(s: detail, pattern: gunbc_repository.owner)
    SubjectWithinCapability => false
  }
}

test fn a_request_outside_the_capability_stops_the_line() -> Bool {
  disposition_stops(o: HelperSubjectOutsideCapability {
    entry: "e.json", detail: "another repository",
  })
}

// ── The request round-trips, and refuses a document that is not one ──────────────────────────────

test fn a_request_decodes_back_to_the_subject_it_was_written_from() -> Bool {
  match publication_request_decode(request: publication_request_json(subject: ordinary_subject(), worktree: "/tmp/wt")) {
    RequestUndecodable { reason: _ } => false
    RequestDecoded { subject, worktree: _ } =>
      subject.node_id == ordinary_subject().node_id
      && subject.attempt_key == ordinary_subject().attempt_key
      && (subject.branch as String) == (ordinary_subject().branch as String)
      && (subject.expected_base as String) == (ordinary_subject().expected_base as String)
      && (subject.expected_head as String) == (ordinary_subject().expected_head as String)
      && subject.repository.owner == ordinary_subject().repository.owner
      && subject.repository.name == ordinary_subject().repository.name
  }
}

test fn a_document_of_another_schema_is_refused_rather_than_read_as_a_request() -> Bool {
  match publication_request_decode(
    request: "{\"schema\":\"roadmap-publication-receipt/v2\",\"subject\":{}}",
  ) {
    RequestUndecodable { reason: _ } => true
    RequestDecoded { subject: _, worktree: _ } => false
  }
}

test fn a_document_that_is_not_json_is_refused_rather_than_read_as_a_request() -> Bool {
  match publication_request_decode(request: "not a document at all") {
    RequestUndecodable { reason: _ } => true
    RequestDecoded { subject: _, worktree: _ } => false
  }
}

// ── A request whose subject does not match its own entry name is refused ─────────────────────────
//
// THIS IS THE ANTI-FORGERY ARM AND IT IS REACHED WITHOUT A NETWORK READ. The helper derives the
// answer's address from the subject it decodes, never from the request's name, so a document placed
// under one name carrying a subject that addresses another is a document whose name lies. It is
// refused before any observation, which is what makes this arm hermetic: the credential is never
// consulted, and the check runs ahead of the branch that would consult it.

test fn a_request_whose_subject_addresses_another_entry_is_refused_before_any_observation() -> Bool {
  match publication_request_admission(
    entry: "some-other-node.a1.2222222222222222222222222222222222222222.json",
    request_text: publication_request_json(subject: ordinary_subject(), worktree: "/tmp/wt"),
  ) {
    RequestMisaddressed { detail } =>
      string_contains(s: detail, pattern: publication_spool_entry_name(
        key: publication_spool_key(subject: ordinary_subject()),
      ))
    RequestAdmitted { subject: _, worktree: _ } => false
    RequestUndecodableDocument { reason: _ } => false
    RequestOutsideCapability { detail: _ } => false
  }
}

test fn a_request_document_that_does_not_decode_is_refused_rather_than_skipped() -> Bool {
  match publication_request_admission(
    entry: "n.a1.1111111111111111111111111111111111111111.json",
    request_text: "{}",
  ) {
    RequestUndecodableDocument { reason: _ } => true
    RequestAdmitted { subject: _, worktree: _ } => false
    RequestOutsideCapability { detail: _ } => false
    RequestMisaddressed { detail: _ } => false
  }
}

// ── The stopping partition is exact, and the run standing carries what stopped it ───────────────
//
// The helper's exit status is derived from this classification, so an outcome silently classified
// as recorded would be a helper that exits 0 having failed. Both poles are asserted, because a
// classifier that answered `stops` for everything would satisfy a one-sided check just as well.
//
// HelperRequestNotConsumed STOPS THE LINE and that is not obvious: the answer was written, so the
// requester is served and the run looks successful. It stops because the request survives, so the
// subject is re-observed on every run from then on with nothing recording why -- a cost that grows
// silently, which is exactly what a recorded classification would hide.

// THE THREE TERMINAL REFUSALS STAY THREE. They share one remedy -- leave the pending set -- and a
// single `terminally refused` arm would have been the cheaper model. It would also have erased the
// anti-forgery distinction: a document naming another repository and a document whose name lies
// about its own subject are different findings for whoever reads the stopped line. This is the
// control that a later collapse reds.
test fn the_three_terminal_refusals_are_distinguished_rather_than_collapsed() -> Bool {
  let base = ordinary_subject()
  let foreign = RoadmapPublicationSubject {
    node_id: base.node_id, attempt_key: base.attempt_key,
    repository: other_repository(), branch: base.branch,
    expected_base: base.expected_base, expected_head: base.expected_head,
  }
  let undecodable = match publication_request_admission(
    entry: publication_spool_entry_name(key: publication_spool_key(subject: base)),
    request_text: "{}",
  ) {
    RequestUndecodableDocument { reason: _ } => true
    RequestAdmitted { subject: _, worktree: _ } => false
    RequestOutsideCapability { detail: _ } => false
    RequestMisaddressed { detail: _ } => false
  }
  let outside = match publication_request_admission(
    entry: publication_spool_entry_name(key: publication_spool_key(subject: foreign)),
    request_text: publication_request_json(subject: foreign, worktree: "/tmp/wt"),
  ) {
    RequestOutsideCapability { detail: _ } => true
    RequestAdmitted { subject: _, worktree: _ } => false
    RequestUndecodableDocument { reason: _ } => false
    RequestMisaddressed { detail: _ } => false
  }
  let admitted = match publication_request_admission(
    entry: publication_spool_entry_name(key: publication_spool_key(subject: base)),
    request_text: publication_request_json(subject: base, worktree: "/tmp/wt"),
  ) {
    RequestAdmitted { subject: _, worktree: _ } => true
    RequestUndecodableDocument { reason: _ } => false
    RequestOutsideCapability { detail: _ } => false
    RequestMisaddressed { detail: _ } => false
  }
  undecodable && outside && admitted
}

// ── A terminally refused request leaves the pending set; a transiently unreadable one does not ──
//
// THIS IS THE CLASS THE EARLIER REVISION HAD NO NAME FOR, and the cost of not having one was
// measured rather than imagined: two requests written under a superseded schema stopped the srv1
// helper on every tick for a day, each tick paying a full run, because the refusal was correct and
// the retention was not. Decoding is a pure function of the request bytes, so no run in that
// population could have ended differently.
//
// The discriminating pair is the whole claim. A failed READ is transient -- the same path may read
// next run -- so its request stays pending and nothing is moved. A failed DECODE is terminal, so its
// request is moved out of the pending set. If the two shared one outcome, one of these two arms
// would have to be wrong, and the one that was wrong is the one that ran in production.

test fn a_terminally_refused_request_is_named_apart_from_a_transiently_unreadable_one() -> Bool {
  publication_helper_outcome_key(o: HelperRequestRefused { entry: "e", detail: "d" })
    != publication_helper_outcome_key(o: HelperRequestUnreadable { entry: "e", detail: "d" })
}

// A QUARANTINE THAT FAILS IS NOT A SILENCE. The helper that could not move the document is back in
// the loop this repair exists to end, and the only thing that makes that visible is its own name --
// on the precedent HelperRequestNotConsumed sets for the delete that fails after a written answer.
test fn a_quarantine_that_fails_is_its_own_outcome_and_stops_the_line() -> Bool {
  publication_helper_outcome_key(o: HelperRequestNotQuarantined { entry: "e", detail: "d" })
    != publication_helper_outcome_key(o: HelperRequestRefused { entry: "e", detail: "d" })
  && disposition_stops(o: HelperRequestNotQuarantined { entry: "e", detail: "d" })
}

// THE QUARANTINE IS NOT AN ANSWER, and it must not be addressable as one. An undecodable request has
// no decoded subject, so no answer address exists for it; the bytes go to a third directory the
// publication principal holds. Asserting the three are pairwise distinct is what keeps a later
// author from resolving the quarantine into the answer directory, where the belt would read it.
test fn the_quarantine_is_a_third_directory_and_not_the_answer_directory() -> Bool {
  let requests = publication_request_dir(instance_root: "/opt/gunbc")
  let answers = publication_answer_dir(instance_root: "/opt/gunbc")
  let refused = publication_refused_dir(instance_root: "/opt/gunbc")
  refused != requests && refused != answers && requests != answers
}

fn disposition_stops(o: PublicationHelperOutcome) -> Bool {
  match publication_helper_outcome_disposition(o: o) {
    OutcomeStopsTheLine { detail: _ } => true
    OutcomeRecorded { detail: _ } => false
  }
}

test fn only_the_helpers_own_failures_stop_the_line() -> Bool {
  !disposition_stops(o: HelperAnswered { key: "k", outcome_key: "branch-not-published" })
  && disposition_stops(o: HelperRequestNotConsumed { key: "k", detail: "d" })
  && disposition_stops(o: HelperRequestUnreadable { entry: "e", detail: "d" })
  && disposition_stops(o: HelperRequestRefused { entry: "e", detail: "d" })
  && disposition_stops(o: HelperRequestNotQuarantined { entry: "e", detail: "d" })
  && disposition_stops(o: HelperAnswerWriteFailed { key: "k", detail: "d" })
  && disposition_stops(o: HelperSpoolRefused { detail: "d" })
}

// A STOPPED RUN NAMES WHAT STOPPED IT, which is the whole reason the classification is typed rather
// than a Bool: the exit can say which outcome refused instead of handing back one bit and making a
// reader walk the ledger. The mixed case is the discriminating one -- a run carrying BOTH a good
// answer and a refusal must stop, and must name the refusal rather than the answer.
test fn a_run_of_answers_completes_and_counts_them() -> Bool {
  match publication_helper_run_standing(outcomes: [
    HelperAnswered { key: "a", outcome_key: "branch-not-published" },
    HelperAnswered { key: "b", outcome_key: "publication-bound" },
  ]) {
    HelperRunCompleted { answered: n } => n == 2
    HelperRunStopped { first: _, more: _ } => false
  }
}

test fn a_mixed_run_stops_and_names_the_outcome_that_stopped_it() -> Bool {
  match publication_helper_run_standing(outcomes: [
    HelperAnswered { key: "a", outcome_key: "branch-not-published" },
    HelperSpoolRefused { detail: "the request directory could not be listed" },
    HelperAnswerWriteFailed { key: "c", detail: "read-only file system" },
  ]) {
    HelperRunCompleted { answered: _ } => false
    HelperRunStopped { first, more } =>
      publication_helper_disposition_detail(d: publication_helper_outcome_disposition(o: first))
        == "the request directory could not be listed"
      && count(more) == 1
  }
}

// AN EMPTY RUN IS COMPLETED, NOT STOPPED. A helper whose spool holds nothing has done its job; the
// unlistable spool is a different state and is a HelperSpoolRefused outcome rather than an absence,
// which is what keeps `nothing to do` from standing in for `I could not find out`.
test fn an_empty_run_completes_rather_than_stopping() -> Bool {
  match publication_helper_run_standing(outcomes: []) {
    HelperRunCompleted { answered: n } => n == 0
    HelperRunStopped { first: _, more: _ } => false
  }
}

// ── The credential is bound to one unit, and it is the one that dispatches no session ────────────
//
// THE DISCRIMINATOR IS THE PAIR, ASSERTED OVER THE SAME BYTES A DEPLOY INSTALLS. A witness that
// only checked the publication unit HAS a credential would pass just as well with the belt unit
// carrying one too, which is precisely the state this lane exists to end; a witness that only
// checked the belt unit has none would pass with a helper that cannot authenticate at all.

fn publication_unit_text() -> String {
  render(doc: emit_publication_service_unit_doc(spec: live_spec()), proto: live_deploy_protocol)
}

fn belt_unit_text() -> String {
  render(doc: emit_belt_service_unit_doc(spec: live_spec()), proto: live_deploy_protocol)
}

fn serve_unit_text() -> String {
  render(doc: emit_systemd_unit_doc(spec: live_spec(), revision: live_revision()), proto: live_deploy_protocol)
}

test fn the_publication_unit_binds_the_credential_and_the_other_two_do_not() -> Bool {
  string_contains(
    s: publication_unit_text(),
    pattern: join(["EnvironmentFile=-", deployment_credential_env_path(names: live_spec().names) as String], ""),
  )
  && !string_contains(s: belt_unit_text(), pattern: "EnvironmentFile")
  && !string_contains(s: serve_unit_text(), pattern: "EnvironmentFile")
}

test fn the_credential_variable_is_named_in_no_unit_that_spawns_a_worker() -> Bool {
  !string_contains(s: belt_unit_text(), pattern: publication_helper_credential_env_var as String)
  && !string_contains(s: serve_unit_text(), pattern: publication_helper_credential_env_var as String)
}

// THE PRINCIPAL IS THE BOUNDARY, so the unit that reads the credential must not run as the account
// the belt and serve units run as. Asserted as a DIFFERENCE rather than against a literal name: the
// account's host-local handle is an allocation (see DeploymentNames' header), and a witness pinning
// the spelling would fail on any host that allocated a different one while saying nothing about the
// property that matters.
test fn the_publication_unit_runs_as_a_principal_the_service_units_do_not() -> Bool {
  let principal = live_spec().names.publication_principal as String
  let service_user = live_spec().service.service_user as String
  principal != service_user
  && string_contains(s: publication_unit_text(), pattern: join(["User=", principal], ""))
  && string_contains(s: belt_unit_text(), pattern: join(["User=", service_user], ""))
  && string_contains(s: serve_unit_text(), pattern: join(["User=", service_user], ""))
}

// THE HELPER IS HANDED ONE ARGUMENT AND NO SPAWN ROOT. The belt unit carries a spawn workdir
// because a tick launches provider sessions; a publication unit that carried one would be a
// credentialed process with a tree to act on, which is the shape the boundary refuses.
test fn the_publication_unit_carries_no_spawn_environment() -> Bool {
  !string_contains(s: publication_unit_text(), pattern: "Environment=")
  && string_contains(s: publication_unit_text(), pattern: "--function publication_helper_run_once_cli")
}

// ── The two spool directories are addressed apart ────────────────────────────────────────────────
//
// A single directory could not carry the opposite permissions the boundary needs, so their
// distinctness is a property the emitter and the reader must agree on rather than a detail.

test fn a_request_and_its_answer_are_addressed_in_different_directories() -> Bool {
  publication_request_dir(instance_root: "/opt/gunbc")
    != publication_answer_dir(instance_root: "/opt/gunbc")
  && publication_request_path_for(instance_root: "/opt/gunbc", key: "k")
    != publication_answer_path_for(instance_root: "/opt/gunbc", key: "k")
}

test fn two_instances_do_not_share_a_spool() -> Bool {
  publication_request_dir(instance_root: "/opt/gunbc")
    != publication_request_dir(instance_root: "/opt/gunbc-lab")
}
