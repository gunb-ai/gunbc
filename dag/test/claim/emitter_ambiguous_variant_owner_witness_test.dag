module test.claim.emitter_ambiguous_variant_owner_witness_test

import v1.compiler.emit_rust { is_value_variant_type_arg }

data emitter_ambiguous_variant_owner_witness_note: String = "PERMANENT REGRESSION CONTROL for the variant-owner ambiguity sentinel.\n\nTHE DEFECT, measured on src/v2/compiler/05_emit.dag before repair: v1.compiler.emit_info derive_variant_to_enum folds the CLOSURE's type summaries into variant-name-to-owning-enum, and inserts the empty string when two enums in that closure claim one variant name -- so the empty string means AMBIGUOUS, a third state the Map<String, String> type does not name. is_value_variant_type_arg read that map with map_contains_key, which cannot see the value, so an ambiguously owned name tested positive as an unambiguous value-variant and rust_type_arg_renders_as_unit collapsed the type argument to unit. That is fabricated plausible output at exactly the point the emitter could not know the answer: 159 collapse events on one entry, 91 on the name Absent and 68 on Optional, and honoring the sentinel moved that entry from 666 coded rustc errors to 527 with E0308 from 286 to 128, while surfacing 25 E0425 the collapse had been masking. The six other readers of that map already guarded the sentinel with an explicit non-empty check; one consumer diverged from its siblings.\n\nWHY THIS WITNESS IS AT THE PREDICATE AND NOT AT THE EMITTED TEXT, recorded because the emitted-text version was attempted first and is UNREACHABLE rather than merely inconvenient: the compiler already REFUSES two enums claiming one variant name inside a single module, with the hard diagnostic 'variant X appears in both A and B'. So the ambiguous state is only reachable ACROSS modules -- which is exactly where the live cases sit, Optional across v2.std.grammar and dag.std.constructors, Absent across v2.std.optional and dag.std.upsert_decision -- and compile_dag_rust_emit_check compiles ONE synthetic source. A single-source fixture cannot construct the subject. That the existing wall is module-local is itself the reason the class survives, and it is the construction fix this witness does not perform.\n\nWHY THREE ROWS AND NOT ONE. Deleting the collapse entirely would satisfy a witness that only asserts the ambiguous name is refused -- and would be wrong, because collapsing an UNAMBIGUOUSLY owned value-variant is the feature working as intended. The rows therefore assert THREE DIFFERENT ANSWERS against ONE map, so no constant, default, or disabled mechanism can satisfy them together: an ambiguous owner is false, a real owner is true, an absent key is false. Because they share a single map value, the rows also check continuously that they are reading one subject, which a set of separately-constructed fixtures could not.\n\ndissolve-on: the owner value becomes a coproduct with no constructor for the conflated read (Unowned | OwnedBy | Ambiguous), at which point the ambiguous row is unwritable rather than checked. The unambiguous row survives as the feature's control."

// ONE map, three keys, three distinct states. Built once and shared by every row
// deliberately: rows asserting different answers against the SAME value cannot pass
// together unless the lookup genuinely varies with the key.
fn owner_map() -> Map<String, String> {
  map_insert(
    map_insert(
      map_insert(empty_map(), "AmbiguouslyClaimed", ""),
      "SolelyClaimed",
      "OwningEnum",
    ),
    "AlsoSolelyClaimed",
    "OtherOwningEnum",
  )
}

// The sentinel means AMBIGUOUS. The emitter does not know this name's owner, so it
// must not claim the argument is a value-variant.
test fn ambiguous_owner_is_not_a_value_variant() -> Bool {
  is_value_variant_type_arg(
    generic_param_names: [],
    variant_to_enum: owner_map(),
    name: "AmbiguouslyClaimed",
  ) == false
}

// A real owner IS a value-variant. This row is what keeps the repair from being a
// deletion of the mechanism, and it is asserted twice on two differently-owned names
// so that a lookup accidentally pinned to one entry cannot satisfy it.
test fn sole_owner_is_a_value_variant() -> Bool {
  is_value_variant_type_arg(
    generic_param_names: [],
    variant_to_enum: owner_map(),
    name: "SolelyClaimed",
  ) == true
    && is_value_variant_type_arg(
      generic_param_names: [],
      variant_to_enum: owner_map(),
      name: "AlsoSolelyClaimed",
    ) == true
}

// A name absent from the map is not a value-variant either -- the same answer as the
// ambiguous row, reached by a different route. Held separately so that a change
// collapsing absent and ambiguous into one arm still passes here and fails above.
test fn unknown_name_is_not_a_value_variant() -> Bool {
  is_value_variant_type_arg(
    generic_param_names: [],
    variant_to_enum: owner_map(),
    name: "NeverDeclared",
  ) == false
}

// A generic parameter shadows the map entirely: even a solely-owned name is not a
// value-variant when it is the function's own type variable. Pre-existing behavior,
// asserted so the repair is shown not to have disturbed the arm above it.
test fn generic_param_shadows_a_sole_owner() -> Bool {
  is_value_variant_type_arg(
    generic_param_names: ["SolelyClaimed"],
    variant_to_enum: owner_map(),
    name: "SolelyClaimed",
  ) == false
}
