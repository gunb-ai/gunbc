  FirmwareUpdateThenVirtualMedia,
  InstallFirmwareEvidenceAbsent,
  InstallFirmwareVersionAmbiguous,
  InstallFirmwareVersionUncatalogued,
  InstallNoBootSourceOverride,
  InstallNoVirtualMediaAndNetworkBootUnestablished,
  NetworkBootDeliveryEstablished,
  NetworkBootDeliveryStanding,
  NetworkBootDeliveryUnestablished,
  NetworkBootRequirement,
  NbdProxyVirtualMediaInstall,
  OsInstallMechanismRefused,
  OsInstallMechanismSelected,
