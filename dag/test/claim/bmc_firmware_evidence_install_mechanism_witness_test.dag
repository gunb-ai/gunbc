module test.claim.bmc_firmware_evidence_install_mechanism


// Control-only fixtures. Every axis gets its OWN synthetic observation: the earlier version of
// this control constructed the established arm from gunbc.os_install srv3_pxe_network_boot_chain,
// an authored plan that this module's own rationale says must not count as establishment — the
// forbidden substitution encoded directly in the positive fixture. These four refer to a witness
// declaration, so nothing in production can be mistaken for evidence.
fn control_network_boot_axis(requirement: gunbc.os_install_mechanism.NetworkBootRequirement) -> gunbc.os_install_mechanism.NetworkBootRequirementEvidence {
  gunbc.os_install_mechanism.NetworkBootRequirementEvidence {
    requirement: requirement,
    observation: std.decl_ref.DeclarationRef {
      module_path: "test.claim.bmc_firmware_evidence_install_mechanism",
      decl_name: "established_network_boot_for_control",
      field: std.decl_ref.WholeDeclaration,
    },
    observed_at: 1786320000000,
  }
}

data established_network_boot_for_control: gunbc.os_install_mechanism.NetworkBootDeliveryStanding = gunbc.os_install_mechanism.NetworkBootDeliveryEstablished {
  evidence: gunbc.os_install_mechanism.NetworkBootDeliveryEstablishment {
    boot_source_override: control_network_boot_axis(requirement: gunbc.os_install_mechanism.NetworkBootBootSourceOverride),
    client_boot_mode: control_network_boot_axis(requirement: gunbc.os_install_mechanism.NetworkBootClientBootMode),
    serving_infrastructure: control_network_boot_axis(requirement: gunbc.os_install_mechanism.NetworkBootServingInfrastructure),
    boot_artifacts: control_network_boot_axis(requirement: gunbc.os_install_mechanism.NetworkBootBootArtifacts),
  },
}

data established_firmware_transition_for_control: gunbc.os_install_mechanism.FirmwareTransitionStanding = gunbc.os_install_mechanism.FirmwareTransitionEstablished {
  from: asrock_altrad8ud_openbmc_3_22_00_capabilities.firmware,
  to: asrock_altrad8ud_openbmc_2_07_00_capabilities.firmware,
  artifact: std.decl_ref.DeclarationRef {
    module_path: "test.claim.bmc_firmware_evidence_install_mechanism",
    decl_name: "established_firmware_transition_for_control",
    field: std.decl_ref.WholeDeclaration,
  },
}

data unknown_endpoint: std.bmc.BmcEndpoint = std.bmc.BmcEndpoint { host: "192.168.1.254", protocol: std.bmc.Redfish }

data uncatalogued_firmware: extdeps.bmc.capability.BmcFirmwareVersion = extdeps.bmc.capability.BmcFirmwareVersion {
  family: std.bmc.OpenBmc,
  version: extdeps.firmware.types.firmware_semantic_version(major: 2, minor: 7, patch: 1),
}

// THE FINDING, made executable, at its honest strength. srv4's observed firmware (OpenBMC
// 3.22.00) carries neither virtual-media capability, and no network-boot delivery is established
// for it, so the evidence-derived answer is a REFUSAL naming what is missing. The pre-repair
// board-default read answers NbdProxyVirtualMediaInstall for the same host — a mechanism that
// firmware does not implement. The claim is the DISAGREEMENT between a refusal and a fabricated
// selection, not either value alone.
test fn srv4_evidence_derived_refuses_while_board_default_selects_nbd_proxy() -> Bool {
  let board_default = gunbc.os_install_mechanism.solve_install_mechanism(
    current: extdeps.boards.asrock_rack.asrock_altrad8ud_shipped_bmc_firmware_capabilities,
    catalog: gunbc.os_install_mechanism.srv3_firmware_catalog,
  )
  match gunbc.os_install_mechanism.srv4_install_mechanism_solution {
    gunbc.os_install_mechanism.OsInstallMechanismRefused { cause: c } =>
      match c {
        gunbc.os_install_mechanism.InstallNoVirtualMediaAndNetworkBootUnestablished { firmware: _, missing: m } =>
          std.types.list_length(items: m) == 4
            && match board_default {
                 gunbc.os_install_mechanism.NbdProxyVirtualMediaInstall => true
                 gunbc.os_install_mechanism.PxeHttpInstall => false
                 gunbc.os_install_mechanism.VirtualMediaInstall => false
                 gunbc.os_install_mechanism.FirmwareUpdateThenVirtualMedia => false
               }
        gunbc.os_install_mechanism.InstallFirmwareEvidenceAbsent { endpoint: _ } => false
        gunbc.os_install_mechanism.InstallFirmwareVersionUncatalogued { firmware: _ } => false
        gunbc.os_install_mechanism.InstallFirmwareVersionAmbiguous { firmware: _, count: _ } => false
        gunbc.os_install_mechanism.InstallNoBootSourceOverride { firmware: _ } => false
        gunbc.os_install_mechanism.InstallFirmwareTransitionUnestablished { firmware: _, missing: _ } => false
        gunbc.os_install_mechanism.InstallFirmwareTransitionAmbiguous { firmware: _, candidates: _ } => false
      }
    gunbc.os_install_mechanism.OsInstallMechanismSelected { mechanism: _ } => false
  }
}

// srv3's BMC upgrade to 3.22.00 took its catalogued delivery mechanism with it,
// and this witness says so by execution. The predecessor asserted the mechanism
// IS nbd-proxy; it reddened the moment srv3's evidence row followed the upgrade,
// which is exactly what the tripwire above it was written to do.
//
// READ THE CAUSE, NOT THE ARM. UNESTABLISHED is not impossible. The catalogued
// 3.22.00 row lists neither Redfish virtual media nor the bmcweb nbd-proxy, and
// no host has an established network-boot delivery — so this solver has nothing
// left to select. It does NOT establish that the host cannot be installed: srv4
// runs this same firmware and was installed over the configfs USB-gadget
// transport, which extdeps.bmc.virtual_media already models as
// ConfigfsGadgetTransport and which this solver cannot see because its
// OsInstallMechanism enum predates that authority. Teaching it to consume
// VirtualMediaTransport is the INSTALL-0 repair; an omitted capability read as an
// observed absence is the defect, not the hardware.
test fn srv3_reinstall_path_is_unestablished_on_3_22_00() -> Bool {
  match gunbc.os_install_mechanism.srv3_install_mechanism_solution {
    gunbc.os_install_mechanism.OsInstallMechanismRefused { cause: c } =>
      match c {
        gunbc.os_install_mechanism.InstallNoVirtualMediaAndNetworkBootUnestablished { firmware: fw, missing: _ } =>
          fw.version.major == 3 && fw.version.minor == 22
        _ => false
      }
    gunbc.os_install_mechanism.OsInstallMechanismSelected { mechanism: _ } => false
  }
}

// The retained legacy row NO LONGER agrees with the evidence-derived solution,
// and executing that divergence is the point. srv3_install_mechanism reads the
// board's SHIPPED 2.07.00 capabilities, so it still answers
// NbdProxyVirtualMediaInstall; the evidence-derived solution follows srv3's
// ACTUAL firmware and refuses. Pinning both halves is what stops the stale
// board-default row being read as a current plan — the failure its predecessor
// existed to catch, now caught and held rather than re-greened.
test fn legacy_board_default_row_no_longer_agrees_with_evidence() -> Bool {
  match gunbc.os_install_mechanism.srv3_install_mechanism_solution {
    gunbc.os_install_mechanism.OsInstallMechanismRefused { cause: _ } =>
      match gunbc.os_install_mechanism.srv3_install_mechanism {
        gunbc.os_install_mechanism.NbdProxyVirtualMediaInstall => true
        _ => false
      }
    gunbc.os_install_mechanism.OsInstallMechanismSelected { mechanism: _ } => false
  }
}

test fn attested_srv1_srv2_resolve_to_nbd_proxy() -> Bool {
  match gunbc.os_install_mechanism.srv1_install_mechanism_solution {
    gunbc.os_install_mechanism.OsInstallMechanismSelected { mechanism: a } =>
      match gunbc.os_install_mechanism.srv2_install_mechanism_solution {
        gunbc.os_install_mechanism.OsInstallMechanismSelected { mechanism: b } =>
          match a {
            gunbc.os_install_mechanism.NbdProxyVirtualMediaInstall =>
              match b {
                gunbc.os_install_mechanism.NbdProxyVirtualMediaInstall => true
                gunbc.os_install_mechanism.PxeHttpInstall => false
                gunbc.os_install_mechanism.VirtualMediaInstall => false
                gunbc.os_install_mechanism.FirmwareUpdateThenVirtualMedia => false
              }
            gunbc.os_install_mechanism.PxeHttpInstall => false
            gunbc.os_install_mechanism.VirtualMediaInstall => false
            gunbc.os_install_mechanism.FirmwareUpdateThenVirtualMedia => false
          }
        gunbc.os_install_mechanism.OsInstallMechanismRefused { cause: _ } => false
      }
    gunbc.os_install_mechanism.OsInstallMechanismRefused { cause: _ } => false
  }
}

// Provenance is carried structurally, not by a comment: srv1/srv2 inhabit the attested arm and
// srv3/srv4 the observed arm, so a recollection cannot be read back as a Redfish observation.
test fn srv1_srv2_are_attested_and_srv3_srv4_are_observed() -> Bool {
  match gunbc.fleet_bmc_firmware_evidence.srv1_bmc_firmware_evidence {
    gunbc.fleet_bmc_firmware_evidence.BmcFirmwareEvidenceAttested { attestation: _ } =>
      match gunbc.fleet_bmc_firmware_evidence.srv2_bmc_firmware_evidence {
        gunbc.fleet_bmc_firmware_evidence.BmcFirmwareEvidenceAttested { attestation: _ } =>
          match gunbc.fleet_bmc_firmware_evidence.srv3_bmc_firmware_evidence {
            gunbc.fleet_bmc_firmware_evidence.BmcFirmwareEvidenceObserved { observation: _ } =>
              match gunbc.fleet_bmc_firmware_evidence.srv4_bmc_firmware_evidence {
                gunbc.fleet_bmc_firmware_evidence.BmcFirmwareEvidenceObserved { observation: _ } => true
                gunbc.fleet_bmc_firmware_evidence.BmcFirmwareEvidenceAttested { attestation: _ } => false
                gunbc.fleet_bmc_firmware_evidence.BmcFirmwareEvidenceUnobserved { endpoint: _ } => false
              }
            gunbc.fleet_bmc_firmware_evidence.BmcFirmwareEvidenceAttested { attestation: _ } => false
            gunbc.fleet_bmc_firmware_evidence.BmcFirmwareEvidenceUnobserved { endpoint: _ } => false
          }
        gunbc.fleet_bmc_firmware_evidence.BmcFirmwareEvidenceObserved { observation: _ } => false
        gunbc.fleet_bmc_firmware_evidence.BmcFirmwareEvidenceUnobserved { endpoint: _ } => false
      }
    gunbc.fleet_bmc_firmware_evidence.BmcFirmwareEvidenceObserved { observation: _ } => false
    gunbc.fleet_bmc_firmware_evidence.BmcFirmwareEvidenceUnobserved { endpoint: _ } => false
  }
}

// RED CONTROL — the absorbing fallback this repair exists to forbid. An endpoint with no
// evidence must refuse with the missing fact, NOT fall through to PxeHttpInstall (which is
// what solve_install_mechanism's else-arm would answer for an empty capability row) and NOT
// substitute the board's shipped roster.
test fn unobserved_endpoint_refuses_rather_than_defaulting_to_pxe() -> Bool {
  match gunbc.os_install_mechanism.solve_install_mechanism_from_evidence(
    evidence: gunbc.fleet_bmc_firmware_evidence.BmcFirmwareEvidenceUnobserved { endpoint: unknown_endpoint },
    catalog: gunbc.os_install_mechanism.srv3_firmware_catalog,
    network_boot: established_network_boot_for_control,
    firmware_transition: gunbc.os_install_mechanism.fleet_firmware_transition_standing,
  ) {
    gunbc.os_install_mechanism.OsInstallMechanismRefused { cause: c } =>
      match c {
        gunbc.os_install_mechanism.InstallFirmwareEvidenceAbsent { endpoint: e } => e == unknown_endpoint
        gunbc.os_install_mechanism.InstallFirmwareVersionUncatalogued { firmware: _ } => false
        gunbc.os_install_mechanism.InstallFirmwareVersionAmbiguous { firmware: _, count: _ } => false
        gunbc.os_install_mechanism.InstallNoBootSourceOverride { firmware: _ } => false
        gunbc.os_install_mechanism.InstallNoVirtualMediaAndNetworkBootUnestablished { firmware: _, missing: _ } => false
        gunbc.os_install_mechanism.InstallFirmwareTransitionUnestablished { firmware: _, missing: _ } => false
        gunbc.os_install_mechanism.InstallFirmwareTransitionAmbiguous { firmware: _, candidates: _ } => false
      }
    gunbc.os_install_mechanism.OsInstallMechanismSelected { mechanism: _ } => false
  }
}

// RED CONTROL — a firmware version one patch off a catalogued row must refuse, not match the
// nearest row. 2.07.00 is the only version carrying CapabilityNbdProxyVirtualMedia; answering
// for 2.07.01 from that row would grant a capability nobody observed.
test fn uncatalogued_version_refuses_rather_than_matching_nearest() -> Bool {
  match gunbc.os_install_mechanism.solve_install_mechanism_from_evidence(
    evidence: gunbc.fleet_bmc_firmware_evidence.BmcFirmwareEvidenceAttested {
      attestation: gunbc.fleet_bmc_firmware_evidence.BmcFirmwareAttestation {
        endpoint: unknown_endpoint,
        firmware: uncatalogued_firmware,
        attested_by: "witness",
        attested_at: 1786320000000,
      },
    },
    catalog: gunbc.os_install_mechanism.srv3_firmware_catalog,
    network_boot: established_network_boot_for_control,
    firmware_transition: gunbc.os_install_mechanism.fleet_firmware_transition_standing,
  ) {
    gunbc.os_install_mechanism.OsInstallMechanismRefused { cause: c } =>
      match c {
        gunbc.os_install_mechanism.InstallFirmwareVersionUncatalogued { firmware: f } =>
          extdeps.bmc.capability.bmc_firmware_version_eq(a: f, b: uncatalogued_firmware)
        gunbc.os_install_mechanism.InstallFirmwareEvidenceAbsent { endpoint: _ } => false
        gunbc.os_install_mechanism.InstallFirmwareVersionAmbiguous { firmware: _, count: _ } => false
        gunbc.os_install_mechanism.InstallNoBootSourceOverride { firmware: _ } => false
        gunbc.os_install_mechanism.InstallNoVirtualMediaAndNetworkBootUnestablished { firmware: _, missing: _ } => false
        gunbc.os_install_mechanism.InstallFirmwareTransitionUnestablished { firmware: _, missing: _ } => false
        gunbc.os_install_mechanism.InstallFirmwareTransitionAmbiguous { firmware: _, candidates: _ } => false
      }
    gunbc.os_install_mechanism.OsInstallMechanismSelected { mechanism: _ } => false
  }
}

// POSITIVE CONTROL for the lookup itself — the catalogued version resolves to the row whose
// capabilities the fleet actually depends on, so the refusals above are discriminating rather
// than the function refusing everything.
test fn catalogued_version_resolves_to_its_own_row() -> Bool {
  match extdeps.bmc.capability.bmc_firmware_capability_row_for(
    firmware: asrock_altrad8ud_openbmc_2_07_00_capabilities.firmware,
    catalog: gunbc.os_install_mechanism.srv3_firmware_catalog,
  ) {
    extdeps.bmc.capability.BmcFirmwareCapabilityKnown { row: r } =>
      extdeps.bmc.capability.firmware_has_capability(row: r, cap: extdeps.bmc.capability.CapabilityNbdProxyVirtualMedia)
        && extdeps.bmc.capability.firmware_has_capability(row: r, cap: extdeps.bmc.capability.CapabilityVirtualMedia) == false
    extdeps.bmc.capability.BmcFirmwareCapabilityUncatalogued { firmware: _ } => false
    extdeps.bmc.capability.BmcFirmwareCapabilityAmbiguous { firmware: _, count: _ } => false
  }
}

test fn catalogued_3_22_00_row_carries_no_virtual_media_of_either_kind() -> Bool {
  match extdeps.bmc.capability.bmc_firmware_capability_row_for(
    firmware: asrock_altrad8ud_openbmc_3_22_00_capabilities.firmware,
    catalog: gunbc.os_install_mechanism.srv3_firmware_catalog,
  ) {
    extdeps.bmc.capability.BmcFirmwareCapabilityKnown { row: r } =>
      extdeps.bmc.capability.firmware_has_capability(row: r, cap: extdeps.bmc.capability.CapabilityVirtualMedia) == false
        && extdeps.bmc.capability.firmware_has_capability(row: r, cap: extdeps.bmc.capability.CapabilityNbdProxyVirtualMedia) == false
    extdeps.bmc.capability.BmcFirmwareCapabilityUncatalogued { firmware: _ } => false
    extdeps.bmc.capability.BmcFirmwareCapabilityAmbiguous { firmware: _, count: _ } => false
  }
}

test fn unobserved_evidence_establishes_no_version() -> Bool {
  match gunbc.fleet_bmc_firmware_evidence.bmc_firmware_evidence_version(
    evidence: gunbc.fleet_bmc_firmware_evidence.BmcFirmwareEvidenceUnobserved { endpoint: unknown_endpoint },
  ) {
    gunbc.fleet_bmc_firmware_evidence.BmcFirmwareVersionUnestablished { endpoint: e } => e == unknown_endpoint
    gunbc.fleet_bmc_firmware_evidence.BmcFirmwareVersionEstablished { firmware: _ } => false
  }
}

test fn capability_standing_refuses_on_absent_evidence() -> Bool {
  match gunbc.fleet_bmc_firmware_evidence.bmc_firmware_capability_standing(
    evidence: gunbc.fleet_bmc_firmware_evidence.BmcFirmwareEvidenceUnobserved { endpoint: unknown_endpoint },
    catalog: gunbc.os_install_mechanism.srv3_firmware_catalog,
  ) {
    gunbc.fleet_bmc_firmware_evidence.BmcFirmwareCapabilityEvidenceAbsent { endpoint: e } => e == unknown_endpoint
    gunbc.fleet_bmc_firmware_evidence.BmcFirmwareCapabilityResolved { row: _ } => false
    gunbc.fleet_bmc_firmware_evidence.BmcFirmwareCapabilityVersionUncatalogued { firmware: _ } => false
    gunbc.fleet_bmc_firmware_evidence.BmcFirmwareCapabilityVersionAmbiguous { firmware: _, count: _ } => false
  }
}

data no_boot_override_row: extdeps.bmc.capability.BmcFirmwareCapabilityRow = extdeps.bmc.capability.BmcFirmwareCapabilityRow {
  firmware: uncatalogued_firmware,
  capabilities: [extdeps.bmc.capability.CapabilityPowerControl],
}

data duplicated_version_catalog: List<extdeps.bmc.capability.BmcFirmwareCapabilityRow> = [
  extdeps.boards.asrock_rack.asrock_altrad8ud_openbmc_2_07_00_capabilities,
  extdeps.boards.asrock_rack.asrock_altrad8ud_openbmc_2_07_00_capabilities,
]

data attested_2_07_00_evidence: gunbc.fleet_bmc_firmware_evidence.BmcFirmwareEvidence = gunbc.fleet_bmc_firmware_evidence.BmcFirmwareEvidenceAttested {
  attestation: gunbc.fleet_bmc_firmware_evidence.BmcFirmwareAttestation {
    endpoint: unknown_endpoint,
    firmware: asrock_altrad8ud_openbmc_2_07_00_capabilities.firmware,
    attested_by: "witness",
    attested_at: 1786320000000,
  },
}

// RED CONTROL for the manager-flagged PXE-by-absence defect. A firmware row carrying NO
// virtual-media capability must not yield PxeHttpInstall merely because the virtual-media arms
// did not fire. With no declared network-boot delivery it refuses; the paired positive below
// selects PXE from the SAME row once a delivery is declared, so the refusal is discriminating
// rather than the function refusing everything.
test fn no_virtual_media_without_declared_network_boot_refuses_instead_of_inferring_pxe() -> Bool {
  match gunbc.os_install_mechanism.solve_install_mechanism_from_evidence(
    evidence: gunbc.fleet_bmc_firmware_evidence.srv4_bmc_firmware_evidence,
    catalog: gunbc.os_install_mechanism.srv3_firmware_catalog,
    network_boot: gunbc.os_install_mechanism.NetworkBootDeliveryUnestablished { missing: [] },
    firmware_transition: gunbc.os_install_mechanism.fleet_firmware_transition_standing,
  ) {
    gunbc.os_install_mechanism.OsInstallMechanismRefused { cause: c } =>
      match c {
        gunbc.os_install_mechanism.InstallNoVirtualMediaAndNetworkBootUnestablished { firmware: _, missing: _ } => true
        gunbc.os_install_mechanism.InstallFirmwareEvidenceAbsent { endpoint: _ } => false
        gunbc.os_install_mechanism.InstallFirmwareVersionUncatalogued { firmware: _ } => false
        gunbc.os_install_mechanism.InstallFirmwareVersionAmbiguous { firmware: _, count: _ } => false
        gunbc.os_install_mechanism.InstallNoBootSourceOverride { firmware: _ } => false
        gunbc.os_install_mechanism.InstallFirmwareTransitionUnestablished { firmware: _, missing: _ } => false
        gunbc.os_install_mechanism.InstallFirmwareTransitionAmbiguous { firmware: _, candidates: _ } => false
      }
    gunbc.os_install_mechanism.OsInstallMechanismSelected { mechanism: _ } => false
  }
}

test fn same_row_selects_pxe_once_a_network_boot_delivery_is_established() -> Bool {
  match gunbc.os_install_mechanism.solve_install_mechanism_from_evidence(
    evidence: gunbc.fleet_bmc_firmware_evidence.srv4_bmc_firmware_evidence,
    catalog: gunbc.os_install_mechanism.srv3_firmware_catalog,
    network_boot: established_network_boot_for_control,
    firmware_transition: gunbc.os_install_mechanism.fleet_firmware_transition_standing,
  ) {
    gunbc.os_install_mechanism.OsInstallMechanismSelected { mechanism: m } =>
      match m {
        gunbc.os_install_mechanism.PxeHttpInstall => true
        gunbc.os_install_mechanism.NbdProxyVirtualMediaInstall => false
        gunbc.os_install_mechanism.VirtualMediaInstall => false
        gunbc.os_install_mechanism.FirmwareUpdateThenVirtualMedia => false
      }
    gunbc.os_install_mechanism.OsInstallMechanismRefused { cause: _ } => false
  }
}

// RED CONTROL — boot-source-override gates every delivery arm, so a row without it refuses
// rather than reaching the network-boot arm on a declared standing.
test fn row_without_boot_source_override_refuses_even_with_declared_network_boot() -> Bool {
  match gunbc.os_install_mechanism.solve_delivery_from_capability_row(
    row: no_boot_override_row,
    catalog: gunbc.os_install_mechanism.srv3_firmware_catalog,
    network_boot: established_network_boot_for_control,
    firmware_transition: gunbc.os_install_mechanism.fleet_firmware_transition_standing,
  ) {
    gunbc.os_install_mechanism.OsInstallMechanismRefused { cause: c } =>
      match c {
        gunbc.os_install_mechanism.InstallNoBootSourceOverride { firmware: _ } => true
        gunbc.os_install_mechanism.InstallNoVirtualMediaAndNetworkBootUnestablished { firmware: _, missing: _ } => false
        gunbc.os_install_mechanism.InstallFirmwareEvidenceAbsent { endpoint: _ } => false
        gunbc.os_install_mechanism.InstallFirmwareVersionUncatalogued { firmware: _ } => false
        gunbc.os_install_mechanism.InstallFirmwareVersionAmbiguous { firmware: _, count: _ } => false
        gunbc.os_install_mechanism.InstallFirmwareTransitionUnestablished { firmware: _, missing: _ } => false
        gunbc.os_install_mechanism.InstallFirmwareTransitionAmbiguous { firmware: _, candidates: _ } => false
      }
    gunbc.os_install_mechanism.OsInstallMechanismSelected { mechanism: _ } => false
  }
}

// RED CONTROL for the manager-flagged duplicate-match defect. Two catalog rows for one version
// is a contradiction; answering from whichever was authored first would render it as a verdict.
test fn duplicate_catalog_rows_for_one_version_refuse_as_ambiguous() -> Bool {
  match extdeps.bmc.capability.bmc_firmware_capability_row_for(
    firmware: asrock_altrad8ud_openbmc_2_07_00_capabilities.firmware,
    catalog: duplicated_version_catalog,
  ) {
    extdeps.bmc.capability.BmcFirmwareCapabilityAmbiguous { firmware: _, count: n } => n == 2
    extdeps.bmc.capability.BmcFirmwareCapabilityKnown { row: _ } => false
    extdeps.bmc.capability.BmcFirmwareCapabilityUncatalogued { firmware: _ } => false
  }
}

test fn ambiguous_catalog_propagates_to_a_mechanism_refusal() -> Bool {
  match gunbc.os_install_mechanism.solve_install_mechanism_from_evidence(
    evidence: attested_2_07_00_evidence,
    catalog: duplicated_version_catalog,
    network_boot: established_network_boot_for_control,
    firmware_transition: gunbc.os_install_mechanism.fleet_firmware_transition_standing,
  ) {
    gunbc.os_install_mechanism.OsInstallMechanismRefused { cause: c } =>
      match c {
        gunbc.os_install_mechanism.InstallFirmwareVersionAmbiguous { firmware: _, count: n } => n == 2
        gunbc.os_install_mechanism.InstallFirmwareEvidenceAbsent { endpoint: _ } => false
        gunbc.os_install_mechanism.InstallFirmwareVersionUncatalogued { firmware: _ } => false
        gunbc.os_install_mechanism.InstallNoBootSourceOverride { firmware: _ } => false
        gunbc.os_install_mechanism.InstallNoVirtualMediaAndNetworkBootUnestablished { firmware: _, missing: _ } => false
        gunbc.os_install_mechanism.InstallFirmwareTransitionUnestablished { firmware: _, missing: _ } => false
        gunbc.os_install_mechanism.InstallFirmwareTransitionAmbiguous { firmware: _, candidates: _ } => false
      }
    gunbc.os_install_mechanism.OsInstallMechanismSelected { mechanism: _ } => false
  }
}
