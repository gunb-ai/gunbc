module test.claim.owned_directory_witness

import std.types { Bool, String, NonEmptyStr, FilePath }
import extdeps.posix.identity { PosixOwnerNames }
import gunbc.managed_directory { DeclaredDirectoryMode, DirectoryOwnerOnly, DirectoryOwnerGroupWritableSetgid, DirectoryOwnerAllGroupTraverse }
import gunbc.ensure { EnsureMayApply, EnsureObserveOnly, EnsureObservation, EnsureObserved, EnsureAbsent, EnsureInaccessible }
import std.upsert_decision { Noop, Apply, Refuse }
import gunbc.owned_directory {
  OwnedDirectoryTarget, OwnedDirectoryDeclared, OwnedDirectoryReading,
  owned_directory_decide, owned_directory_reading_of_stat_line, owned_directory_observe,
  ObserverRead, ObserverReadOut, ObserverReadFailed, ObserverFailure, ObserverNotSpawned, ObserverExited, ObserverTransportRefused,
  owned_directory_ensure, owned_directory_ensure_observed, OwnedDirectoryEnsured, OwnedDirectoryEnsureRefused,
  owned_directory_act_time_handover, HandoverOwnerChanged, HandoverAppeared,
  SameUserRegroupToDeclaredGroup, owned_directory_inheriting_from_parent,
}

// THE PROVIDER'S DECISION TABLE, over supplied observations (DESIGN 3: one interface, supplied values).
// The real path -- a stat line read off a host and parsed -- is inhabited by the parse claims below and
// by the live_deploy route claims in test.claim.live_deploy.owned_directory_route_witness.

fn target() -> OwnedDirectoryTarget {
  OwnedDirectoryDeclared {
    member: "auth-sessions" as NonEmptyStr,
    path: "/srv/instance/auth-sessions" as FilePath,
    owner: PosixOwnerNames { user: "svc" as NonEmptyStr, group: "svc" as NonEmptyStr },
    mode: DirectoryOwnerOnly,
    group_adoption: ForeignOwnershipRefuses,
  }
}

fn observed(line: String) -> EnsureObservation<OwnedDirectoryReading> {
  owned_directory_observe(path: "/srv/instance/auth-sessions" as FilePath, list: p => ObserverReadOut { stdout: "auth-sessions\n" }, stat: p => ObserverReadOut { stdout: line })
}

fn decision_label(o: EnsureObservation<OwnedDirectoryReading>, may_apply: Bool) -> String {
  match owned_directory_decide(policy: if may_apply { EnsureMayApply } else { EnsureObserveOnly }, target: target(), observation: o) {
    Noop => "noop"
    Apply { plan: _ } => "apply"
    Refuse { reason } => join(["refuse:", reason as String], "")
  }
}

// The stat line parses into owner, group and mode; a malformed line is no reading at all.
test fn the_stat_identity_line_parses_and_a_malformed_line_does_not() -> Bool {
  let parsed = match owned_directory_reading_of_stat_line(line: "directory|svc|svc|700\n") {
    Present { value: r } => r.is_directory && (r.owner.user as String) == "svc"
    Absent => false
  }
  let malformed = match owned_directory_reading_of_stat_line(line: "directory|svc|700") {
    Present { value: _ } => false
    Absent => true
  }
  parsed && malformed
}

// CONVERGED -> NOOP: a second apply over a converged directory does nothing.
test fn a_converged_directory_is_noop() -> Bool {
  decision_label(o: observed(line: "directory|svc|svc|700"), may_apply: true) == "noop"
}

// FOREIGN OWNER -> REFUSE, NEVER ADOPTED, under May-apply. The red control is the same directory under
// the demanded owner, which is Noop.
test fn a_foreign_owner_refuses_and_is_never_adopted() -> Bool {
  starts_with(s: decision_label(o: observed(line: "directory|root|root|700"), may_apply: true), prefix: "refuse:")
    && string_contains(s: decision_label(o: observed(line: "directory|root|root|700"), may_apply: true), pattern: "never adopted")
}

// A NON-DIRECTORY IS NEVER REPLACED.
test fn a_non_directory_refuses() -> Bool {
  starts_with(s: decision_label(o: observed(line: "regular file|svc|svc|700"), may_apply: true), prefix: "refuse:")
}

// ── THE OBSERVATION CONTRACT: ABSENCE IS ESTABLISHED BY A READ, NEVER INFERRED FROM A FAILURE ────
//
// Routes are stubbed at the contract (DESIGN 3: supplied values at one interface): `list` and `stat`
// return what a read of one directory returned, or the typed origin of why nothing was read.
fn listing(stdout: String) -> ObserverRead { ObserverReadOut { stdout: stdout } }

fn observe_with(list: fn(FilePath) -> ObserverRead, stat: fn(FilePath) -> ObserverRead) -> EnsureObservation<OwnedDirectoryReading> {
  owned_directory_observe(path: "/srv/instance/auth-sessions" as FilePath, list: list, stat: stat)
}

data missing_observer: ObserverFailure = ObserverNotSpawned { cause: "No such file or directory" }

// GREEN POSITIVE: the parent's listing was read and does not name the directory -> absent -> May-apply
// installs. And a parent that is itself not listed in ITS parent makes the child absent too.
test fn a_parent_listing_that_omits_the_directory_establishes_absence() -> Bool {
  decision_label(o: observe_with(list: p => listing(stdout: "other\nauth-jwks\n"), stat: p => listing(stdout: "")), may_apply: true) == "apply"
    && decision_label(o: observe_with(
      list: p => if (p as String) == "/srv/instance" { ObserverReadFailed { origin: ObserverExited { exit_code: 2, stderr: "" } } } else { listing(stdout: "bin\n") },
      stat: p => listing(stdout: ""),
    ), may_apply: true) == "apply"
}

// LISTED, THEN STAT: a listed directory at the demanded identity is converged.
test fn a_listed_directory_reads_its_identity_from_stat() -> Bool {
  decision_label(o: observe_with(list: p => listing(stdout: "auth-sessions\n"), stat: p => listing(stdout: "directory|svc|svc|700")), may_apply: true) == "noop"
}

// A MISSING OBSERVER EXECUTABLE IS NOT AN ABSENT DIRECTORY, whatever text it carries: the listing was
// never read, so presence is unestablished -> refuse. ZERO INSTALL CALLS: the provider is driven with a
// `run` that would report failure; had it been called, the receipt would carry "Apply was paired with
// NotApplied". Its GREEN POSITIVE is the same provider over an established absence, where run IS called.
test fn a_missing_observer_executable_is_inaccessible_and_installs_nothing() -> Bool {
  let unread = p => ObserverReadFailed { origin: missing_observer }
  let exited = p => ObserverReadFailed { origin: ObserverExited { exit_code: 127, stderr: "env: '/usr/bin/ls': No such file or directory" } }
  starts_with(s: decision_label(o: observe_with(list: unread, stat: unread), may_apply: true), prefix: "refuse:")
    && starts_with(s: decision_label(o: observe_with(list: exited, stat: exited), may_apply: true), prefix: "refuse:")
    && match owned_directory_ensure_observed(policy: EnsureMayApply, target: target(), observe: p => observe_with(list: unread, stat: unread), run: plan => false) {
      OwnedDirectoryEnsured { target: _, converged: _ } => false
      OwnedDirectoryEnsureRefused { target: _, reason } => !string_contains(s: reason, pattern: "Apply was paired with NotApplied")
    }
    && match owned_directory_ensure_observed(policy: EnsureMayApply, target: target(), observe: p => observe_with(list: q => listing(stdout: ""), stat: q => listing(stdout: "")), run: plan => false) {
      OwnedDirectoryEnsured { target: _, converged: _ } => false
      OwnedDirectoryEnsureRefused { target: _, reason } => string_contains(s: reason, pattern: "Apply was paired with NotApplied")
    }
}

// A TRANSPORT FAILURE CARRYING THE SAME TEXT IS INACCESSIBLE, and so is a refused grant (an observer
// that ran and exited nonzero): the origin is typed, and no failed read establishes anything.
test fn a_transport_or_grant_failure_is_inaccessible() -> Bool {
  starts_with(s: decision_label(o: observe_with(list: p => ObserverReadFailed { origin: ObserverTransportRefused { cause: "ssh: /srv/x: No such file or directory" } }, stat: p => listing(stdout: "")), may_apply: true), prefix: "refuse:")
    && starts_with(s: decision_label(o: observe_with(list: p => ObserverReadFailed { origin: ObserverExited { exit_code: 1, stderr: "sudo: a password is required" } }, stat: p => listing(stdout: "")), may_apply: true), prefix: "refuse:")
    && starts_with(s: decision_label(o: observe_with(list: p => listing(stdout: "auth-sessions\n"), stat: p => ObserverReadFailed { origin: ObserverExited { exit_code: 1, stderr: "Permission denied" } }), may_apply: true), prefix: "refuse:")
}
// OBSERVE-ONLY AND ABSENT -> REFUSE; May-apply on the same observation applies.
test fn observe_only_absent_refuses() -> Bool {
  let absent = EnsureAbsent { reason: "absent" }
  starts_with(s: decision_label(o: absent, may_apply: false), prefix: "refuse:")
    && decision_label(o: absent, may_apply: true) == "apply"
}

// A MODE DRIFT ON THE DEMANDED OWNER'S DIRECTORY IS REPAIRED, not refused.
test fn a_mode_drift_on_the_owners_directory_applies() -> Bool {
  decision_label(o: observed(line: "directory|svc|svc|755"), may_apply: true) == "apply"
}

// ── THE ACT-TIME OWNERSHIP EFFECT (roadmap node "Realize live_deploy's install-owned leaves as typed
// fs writes with an ownership effect"). A directory that changed hands between the plan-time
// observation and the act is refused BEFORE the install runs, so the readback can never report
// convergence over a stolen directory. The check compares the TWO OBSERVATIONS against each other --
// never the declared owner (review 90625: closing the gap toward the declaration is what Apply does;
// SameUserRegroupToDeclaredGroup exists for exactly that). Each claim flips exactly one input.

test fn a_changed_owner_between_plan_and_act_is_a_handover() -> Bool {
  match owned_directory_act_time_handover(
    before: observed(line: "directory|svc|svc|700"),
    at_act: observed(line: "directory|root|root|700"),
  ) {
    Present { value: HandoverOwnerChanged { plan_time: _, act_time } } =>
      (act_time.user as String) == "root" && (act_time.group as String) == "root"
    _ => false
  }
}

// THE REVIEW 90625 DISCRIMINATOR: an UNCHANGED foreign-owned directory is not a handover -- the
// regroup Apply must still act. The pre-fix check compared against the declared owner and refused
// exactly this case.
test fn an_unchanged_foreign_owner_is_no_handover_the_regroup_may_act() -> Bool {
  match owned_directory_act_time_handover(
    before: observed(line: "directory|root|webdev|700"),
    at_act: observed(line: "directory|root|webdev|700"),
  ) {
    Present { value: _ } => false
    Absent => true
  }
}

test fn a_path_replaced_by_a_file_between_the_readings_is_a_handover() -> Bool {
  match owned_directory_act_time_handover(
    before: observed(line: "directory|svc|svc|700"),
    at_act: observed(line: "regular file|svc|svc|700"),
  ) {
    Present { value: _ } => true
    _ => false
  }
}

test fn a_path_that_appeared_between_the_readings_is_a_handover() -> Bool {
  match owned_directory_act_time_handover(
    before: EnsureAbsent { reason: "no such directory" },
    at_act: observed(line: "directory|root|root|700"),
  ) {
    Present { value: HandoverAppeared { act_time } } => (act_time.user as String) == "root"
    _ => false
  }
}

test fn an_unreadable_act_time_reading_never_fabricates_a_handover() -> Bool {
  match owned_directory_act_time_handover(
    before: observed(line: "directory|svc|svc|700"),
    at_act: EnsureAbsent { reason: "gone" },
  ) {
    Present { value: _ } => false
    Absent => true
  }
    && match owned_directory_act_time_handover(
      before: observed(line: "directory|svc|svc|700"),
      at_act: EnsureInaccessible { reason: "stat failed" },
    ) {
      Present { value: _ } => false
      Absent => true
    }
}

test fn an_unreadable_plan_time_reading_never_fabricates_a_handover() -> Bool {
  match owned_directory_act_time_handover(
    before: EnsureInaccessible { reason: "stat failed" },
    at_act: observed(line: "directory|root|root|700"),
  ) {
    Present { value: _ } => false
    Absent => true
  }
}

// PROVIDER-LEVEL REGRESS GUARD (review 90625): a SameUserRegroupToDeclaredGroup target whose group
// differs is a legitimate Apply; with nothing changing between the readings the install must be
// ATTEMPTED -- so the refusal (the after-reading still differs in the fake) is the generic
// not-converged reason, never the handover text. Pre-fix, this claim is red: the act check refused
// the regroup and the reason said "changed hands".
test fn a_stable_regroup_target_is_acted_on_not_refused_as_a_handover() -> Bool {
  match owned_directory_ensure_observed(
    policy: EnsureMayApply,
    target: OwnedDirectoryDeclared {
      member: "auth-sessions" as NonEmptyStr,
      path: "/srv/instance/auth-sessions" as FilePath,
      owner: PosixOwnerNames { user: "svc" as NonEmptyStr, group: "svc" as NonEmptyStr },
      mode: DirectoryOwnerOnly,
      group_adoption: SameUserRegroupToDeclaredGroup,
    },
    observe: p => observed(line: "directory|svc|webdev|700"),
    run: plan => true,
  ) {
    OwnedDirectoryEnsured { target: _, converged: _ } => true
    OwnedDirectoryEnsureRefused { target: _, reason } =>
      !string_contains(s: reason, pattern: "changed hands") && !string_contains(s: reason, pattern: "never adopted")
  }
}

// The provider refuses over a directory that is foreign-owned at plan time, and the refusal is the
// plan-time foreign-owner refusal -- never a converged receipt: that would mean the install ran and
// the readback blessed it.
test fn the_provider_installs_nothing_over_a_foreign_owner_at_act_time() -> Bool {
  match owned_directory_ensure_observed(
    policy: EnsureMayApply,
    target: target(),
    observe: p => observed(line: "directory|root|root|700"),
    run: plan => true,
  ) {
    OwnedDirectoryEnsured { target: _, converged: _ } => false
    OwnedDirectoryEnsureRefused { target: _, reason } =>
      string_contains(s: reason, pattern: "never adopted") && !string_contains(s: reason, pattern: "changed hands")
  }
}

// ── THE ACT-TIME WINDOW, ON THE PROVIDER'S REAL ROUTE (review 90635) ──────────────────────────
//
// The pure handover decision above is witnessable directly; what these claims add is the ROUTE:
// the provider body executes its re-read, the handover check, the install skip and the reconcile,
// and the refusal text distinguishes which check stopped the install. The pair doubles as each
// other's RED CONTROL: a build where the handover check is removed would report "Apply was paired
// with NotApplied" (the install ran and the after-read disagrees) on the first claim, and a build
// where the check wrongly consults the declaration would report "changed hands" on the second.
//
// The observations are positional by CALL ORDER, not scripted: the handover baseline is the
// caller-carried plan reading (Present arm -- exactly what release_member_plan's own observation
// will feed when the apply legs thread it, the node's next rung), and every observe() call of the
// provider (act re-read, after-readback) returns the same post-plan reading.

test fn the_provider_refuses_a_handover_before_the_install_runs() -> Bool {
  match owned_directory_ensure(
    policy: EnsureMayApply,
    target: target(),
    plan_reading: Present { value: observed(line: "directory|svc|svc|700") },
    observe: p => observed(line: "directory|root|root|700"),
    run: plan => false,
  ) {
    OwnedDirectoryEnsured { target: _, converged: _ } => false
    OwnedDirectoryEnsureRefused { target: _, reason } =>
      string_contains(s: reason, pattern: "changed hands")
        && !string_contains(s: reason, pattern: "Apply was paired with NotApplied")
        && !string_contains(s: reason, pattern: "never adopted")
  }
}

test fn the_provider_refuses_a_foreign_baseline_as_foreign_never_as_a_handover() -> Bool {
  match owned_directory_ensure(
    policy: EnsureMayApply,
    target: target(),
    plan_reading: Present { value: observed(line: "directory|root|root|700") },
    observe: p => observed(line: "directory|root|root|700"),
    run: plan => false,
  ) {
    OwnedDirectoryEnsured { target: _, converged: _ } => false
    OwnedDirectoryEnsureRefused { target: _, reason } =>
      string_contains(s: reason, pattern: "never adopted") && !string_contains(s: reason, pattern: "changed hands")
  }
}

// A CHILD OF A SETGID PARENT EXPECTS THE PARENT'S GROUP AND THE SETGID BIT (derived, not re-declared).
fn inheriting_parent(mode: DeclaredDirectoryMode) -> OwnedDirectoryTarget {
  OwnedDirectoryDeclared {
    member: "attempt-state" as NonEmptyStr,
    path: "/srv/instance/attempt-state" as FilePath,
    owner: PosixOwnerNames { user: "svc" as NonEmptyStr, group: "gunbc-attempt" as NonEmptyStr },
    mode: mode,
    group_adoption: ForeignOwnershipRefuses,
  }
}

fn inheriting_child_decision(parent_mode: DeclaredDirectoryMode, line: String) -> String {
  match owned_directory_decide(
    policy: EnsureMayApply,
    target: owned_directory_inheriting_from_parent(parent: inheriting_parent(mode: parent_mode), child: target()),
    observation: observed(line: line),
  ) {
    Noop => "noop"
    Apply { plan: _ } => "apply"
    Refuse { reason } => join(["refuse:", reason as String], "")
  }
}

// PASS on the live shape: a 2700 child of the setgid parent in the parent's group.
test fn a_setgid_parents_child_expects_the_inherited_group_and_bit() -> Bool {
  inheriting_child_decision(parent_mode: DirectoryOwnerGroupWritableSetgid, line: "directory|svc|gunbc-attempt|2700") == "noop"
}

// A non-setgid parent changes nothing: the child still expects the owner's own group, and the
// inherited-shape reading is no longer the expected one.
test fn a_non_setgid_parents_child_still_expects_the_owners_group() -> Bool {
  inheriting_child_decision(parent_mode: DirectoryOwnerAllGroupTraverse, line: "directory|svc|svc|700") == "noop"
    && starts_with(s: inheriting_child_decision(parent_mode: DirectoryOwnerAllGroupTraverse, line: "directory|svc|gunbc-attempt|2700"), prefix: "refuse:")
}

// A live group that differs from the derived one still refuses (never adopted), and a
// missing setgid bit under a setgid parent is a mode drift the plan repairs (Apply).
test fn a_child_whose_live_group_or_bit_differs_from_the_derived_still_refuses() -> Bool {
  starts_with(s: inheriting_child_decision(parent_mode: DirectoryOwnerGroupWritableSetgid, line: "directory|svc|svc|2700"), prefix: "refuse:")
    && inheriting_child_decision(parent_mode: DirectoryOwnerGroupWritableSetgid, line: "directory|svc|gunbc-attempt|700") == "apply"
}
