module test.claim.bmc_auth_runtime_secret_seam


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn redfish_basic_auth_password(password: Secret) -> Secret {
  password
}

test fn factory_published_password_promotes_to_basic_auth_secret() -> Bool {
  redfish_basic_auth_password(password: openbmc_factory_login.published_password as Secret) == "0penBmc"
}

test fn gcp_access_payload_produces_basic_auth_secret() -> Bool {
  match decode_secret_access_data_b64(
    data_b64: "Ym1jLXNydjMtYWRtaW4tcm90YXRlZA==" as Secret,
  ) {
    SecretAccessPayloadDecoded { secret: decoded } =>
      redfish_basic_auth_password(password: decoded) == "bmc-srv3-admin-rotated"
    SecretAccessPayloadDecodeRefused { reason: _ } => false
  }
    && gcp_secret_payload_b64(credential: "bmc-srv3-admin-rotated" as Secret) == "Ym1jLXNydjMtYWRtaW4tcm90YXRlZA=="
}

test fn gcp_access_payload_invalid_base64_refuses() -> Bool {
  match decode_secret_access_data_b64(data_b64: "not*base64" as Secret) {
    SecretAccessPayloadDecoded { secret: _ } => false
    SecretAccessPayloadDecodeRefused { reason: reason } =>
      string_contains(s: reason as String, pattern: "not valid standard base64")
  }
}

test fn gcloud_token_success_produces_ready_resolution() -> Bool {
  match gcloud_access_token_resolution(success: true, token: "fixture-token" as Secret) {
    AccessTokenReady { token: token } => token == "fixture-token"
    AccessTokenUpsertRequired { plan: _ } => false
    AccessTokenEnsureRefused { reason: _ } => false
  }
}

test fn gcloud_access_ensure_classifies_present_as_noop_and_absent_as_upsert() -> Bool {
  match gcloud_access_ensure_classification(success: true) {
    UpsertClassification { verdict: Converged, decision: Noop } => true
    _ => false
  }
    && match gcloud_access_ensure_classification(success: false) {
      UpsertClassification {
        verdict: Absent,
        decision: Apply {
          plan: HumanGcloudLogin {
            authenticate_command: auth_command,
            retry_instruction: retry,
          },
        },
      } =>
        auth_command == "gcloud auth login"
          && string_contains(s: retry as String, pattern: "re-run the same command")
      _ => false
    }
}

test fn gcloud_token_failure_derives_human_realized_access_upsert() -> Bool {
  match gcloud_access_token_resolution(success: false, token: "" as Secret) {
    AccessTokenReady { token: _ } => false
    AccessTokenEnsureRefused { reason: _ } => false
    AccessTokenUpsertRequired {
      plan: HumanGcloudLogin {
        authenticate_command: auth_command,
        retry_instruction: retry,
      },
    } =>
        auth_command == "gcloud auth login"
          && string_contains(s: retry as String, pattern: "re-run the same command")
  }
}

test fn operator_token_handler_remains_explicit_not_the_default_gcloud_arm() -> Bool {
  match OperatorSuppliedToken { token: "fixture-token" as Secret } {
    OperatorSuppliedToken { token: token } => token == "fixture-token"
    GcloudPrintToken => false
  }
}

test fn secret_manager_access_need_derives_from_the_selected_probe_branch() -> Bool {
  match bmc_credential_probe_access_need(
    plan: srv4_onboarding_plan,
    factory_credential_active: true,
  ) {
    FactoryCredentialSufficient => true
    StoredCredentialReadRequired { secret_ref: _ } => false
  }
    && match bmc_credential_probe_access_need(
      plan: srv4_onboarding_plan,
      factory_credential_active: false,
    ) {
      FactoryCredentialSufficient => false
      StoredCredentialReadRequired { secret_ref: secret_ref } =>
        secret_ref.secret == srv4_onboarding_plan.secret_name
          && secret_ref.project == fleet_secrets_gcp_project
    }
}
