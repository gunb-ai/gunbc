module test.claim.bmc_auth_runtime_secret_seam


data live_tree_disposition: LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn redfish_basic_auth_password(password: std.types.Secret) -> std.types.Secret {
  password
}

test fn factory_published_password_promotes_to_basic_auth_secret() -> Bool {
  redfish_basic_auth_password(password: extdeps.bmc.openbmc.openbmc_factory_login.published_password as std.types.Secret) == "0penBmc"
}

test fn gcp_access_payload_produces_basic_auth_secret() -> Bool {
  redfish_basic_auth_password(
    password: extdeps.cloud.gcp.secret_manager.utf8_secret_from_access_payload(payload: std.bytes.utf8_encode_bytes(s: "bmc-srv3-admin-rotated"))
  ) == "bmc-srv3-admin-rotated"
}
