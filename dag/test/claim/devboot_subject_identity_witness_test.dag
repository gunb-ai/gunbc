module test.claim.devboot_subject_identity_witness




data witness_grounding_doc: String = "The tree object ids below are REAL, read out of this repository during the DEVBOOT re-observation rather than invented to look plausible. clean_tree_hex is `git write-tree` over a temp index holding HEAD's content and equals the tree HEAD points at; parent_tree_hex is the tree of HEAD~1; dirty_tree_hex is the same index with one untracked file staged. blob_hex and pack_sha256_hex are the object id and content digest of an actual downloaded release pack.\\n\\nUsing measured values matters here beyond tidiness: the claim under test is that this identity scheme distinguishes and collapses the RIGHT things, and a fixture invented to satisfy it could not have falsified it. These three trees really do stand in the relations the tests assert -- same content same id, different content different id."

data clean_tree_hex: String = "4a712980497e1d0a45374185b2184a094cca4c8f"
data parent_tree_hex: String = "96817c95aa43c3aead837ca3a8f37d77f6fc2d61"
data dirty_tree_hex: String = "b8084eb2bd437b9b3fb503996604d4d0d45ede1a"
data blob_hex: String = "2d964d3995eb862e98255555d858bb970bac1b99"
data pack_sha256_hex: String = "c145cdcad67185c86b487c5d1e9caed689a5b4efd4c8512268ea6f4ae085e47b"

fn witness_toolchain() -> extdeps.toolchain.types.ToolchainRequirement {
  extdeps.toolchain.types.ToolchainRequirement { name: "rustup" as std.types.NonEmptyStr, version: "1.89.0" as std.types.NonEmptyStr }
}

fn witness_target(gnu_abi: Bool) -> extdeps.toolchain.types.TargetTriple {
  extdeps.toolchain.types.TargetTriple {
    arch: extdeps.toolchain.types.X86_64,
    vendor: extdeps.toolchain.types.UnknownVendor,
    os: extdeps.toolchain.types.Linux,
    env: if gnu_abi { Present { value: extdeps.toolchain.types.Gnu } } else { Present { value: extdeps.toolchain.types.Musl } },
  }
}

fn witness_oid(hex: String) -> extdeps.git.object_store.GitObjectId? {
  extdeps.git.object_store.git_object_id_from_untagged_hex(hex: hex)
}

data witness_subject_builder_doc: String = "One builder every row goes through, so a test that means to vary ONE axis cannot accidentally vary another. Each parameter is an axis of the subject identity, and the defaults are the same on both sides of every comparison below."

fn witness_subject_full(
  tree_hex: String,
  gnu_abi: Bool,
  features: List<String>,
  package: String,
  cargo_target: extdeps.cargo.CargoTarget,
  profile: String,
  rustflags: List<String>,
) -> gunbc.devboot.subject.BuildSubject? {
  match witness_oid(hex: tree_hex) {
    Absent => none
    Present { value: oid } =>
      match gunbc.devboot.subject.admit_build_subject(
        tree_oid: oid,
        package: package,
        cargo_target: cargo_target,
        toolchain: witness_toolchain(),
        target: witness_target(gnu_abi: gnu_abi),
        profile: profile,
        features: features,
        rustflags: rustflags,
        linker: none,
        sysroot: none,
        cargo_config: [],
        platform_c_library: extdeps.gnu.libc.GnuLibc { version: "2.36" as std.types.NonEmptyStr },
      ) {
        gunbc.devboot.subject.SubjectRefused { cause } => none
        gunbc.devboot.subject.SubjectAdmitted { subject } => Present { value: subject }
      }
  }
}

fn witness_subject(tree_hex: String, gnu_abi: Bool, features: List<String>) -> gunbc.devboot.subject.BuildSubject? {
  witness_subject_full(
    tree_hex: tree_hex,
    gnu_abi: gnu_abi,
    features: features,
    package: "gunbc",
    cargo_target: extdeps.cargo.Bin { name: "gunbc" },
    profile: "release",
    rustflags: [],
  )
}

fn witness_subject_digest(tree_hex: String, gnu_abi: Bool, features: List<String>) -> std.content_hash.ContentHash? {
  match witness_subject(tree_hex: tree_hex, gnu_abi: gnu_abi, features: features) {
    Absent => none
    Present { value: subject } => Present { value: gunbc.devboot.subject.build_subject_digest(subject: subject) }
  }
}

data three_valued_comparison_doc: String = "WHY THIS IS THREE-VALUED, AND WHY THE EARLIER TWO-VALUED HELPER MADE EVERY NEGATIVE TEST BELOW A LIE. The previous revision compared two optional digests with a helper that answered false whenever either side was absent. Absent is what construction FAILURE produces here -- a bad object id, a refused admission -- so 'the two digests differ' and 'I could not build either digest' returned the same answer.\\n\\nEvery discriminating negative asserts the NOT of that helper, so each one passed whenever construction broke. Had admit_build_subject started refusing everything, the ABI false-share test, the different-trees test and the features test would all have gone GREEN while proving nothing whatsoever. That is the specification-without-execution failure wearing a passing suite, and it is worse than an absent test because it actively reports coverage.\\n\\nThe fix is to keep 'could not compare' as its own answer that satisfies NEITHER polarity. A positive row demands BothPresentEqual and a negative row demands BothPresentDifferent, so both directions now require that construction succeeded on both sides -- the comparison can no longer be satisfied by failing."

type DigestComparison
  = BothPresentEqual
  | BothPresentDifferent
  | ComparisonUnavailable

fn compare_optional_digests(left: std.content_hash.ContentHash?, right: std.content_hash.ContentHash?) -> DigestComparison {
  match left {
    Absent => ComparisonUnavailable
    Present { value: l } =>
      match right {
        Absent => ComparisonUnavailable
        Present { value: r } =>
          match std.content_hash.compare_content_hash(left: l, right: r) {
            std.content_hash.ContentHashEqual => BothPresentEqual
            std.content_hash.ContentHashDifferent => BothPresentDifferent
            std.content_hash.ContentHashCrossFamilyIncomparable => ComparisonUnavailable
          }
      }
  }
}

fn digests_are_equal(left: std.content_hash.ContentHash?, right: std.content_hash.ContentHash?) -> Bool {
  match compare_optional_digests(left: left, right: right) {
    BothPresentEqual => true
    BothPresentDifferent => false
    ComparisonUnavailable => false
  }
}

fn digests_are_different(left: std.content_hash.ContentHash?, right: std.content_hash.ContentHash?) -> Bool {
  match compare_optional_digests(left: left, right: right) {
    BothPresentEqual => false
    BothPresentDifferent => true
    ComparisonUnavailable => false
  }
}

data comparison_control_doc: String = "THE CONTROL THAT PROVES THE FIX IS REAL. An unconstructable subject must satisfy neither polarity -- not equal AND not different -- which is exactly what the broken two-valued helper could not express. If this row ever goes red, the three-valued comparison has collapsed back into a boolean and every negative test above has quietly stopped discriminating."

test fn an_unconstructable_digest_satisfies_neither_polarity() -> Bool {
  let broken = witness_subject_digest(tree_hex: "not-a-valid-object-id", gnu_abi: true, features: [])
  let good = witness_subject_digest(tree_hex: clean_tree_hex, gnu_abi: true, features: [])
  !digests_are_equal(left: broken, right: good)
    && !digests_are_different(left: broken, right: good)
    && digests_are_equal(left: good, right: good)
}

test fn identical_subjects_share_one_digest() -> Bool {
  digests_are_equal(
    left: witness_subject_digest(tree_hex: clean_tree_hex, gnu_abi: true, features: []),
    right: witness_subject_digest(tree_hex: clean_tree_hex, gnu_abi: true, features: []),
  )
}

test fn different_trees_never_collide() -> Bool {
  digests_are_different(
    left: witness_subject_digest(tree_hex: clean_tree_hex, gnu_abi: true, features: []),
    right: witness_subject_digest(tree_hex: parent_tree_hex, gnu_abi: true, features: []),
  )
    && digests_are_different(
      left: witness_subject_digest(tree_hex: clean_tree_hex, gnu_abi: true, features: []),
      right: witness_subject_digest(tree_hex: dirty_tree_hex, gnu_abi: true, features: []),
    )
}

data abi_false_share_red_doc: String = "THE DISCRIMINATING RED FOR THE FALSE-SHARE CLASS. Gnu and Musl builds of one tree differ in exactly the property that decides whether the artifact runs on a given host, and a subject key blind to the ABI axis would report them as one subject -- handing a requester a binary its libc cannot load while every record claimed a hit. This test goes red the moment the ABI identity tag stops reaching the digest, which is the failure a reviewer cannot see by reading the fold."

test fn gnu_and_musl_are_different_subjects() -> Bool {
  digests_are_different(
    left: witness_subject_digest(tree_hex: clean_tree_hex, gnu_abi: true, features: []),
    right: witness_subject_digest(tree_hex: clean_tree_hex, gnu_abi: false, features: []),
  )
}

test fn features_participate_in_identity() -> Bool {
  digests_are_different(
    left: witness_subject_digest(tree_hex: clean_tree_hex, gnu_abi: true, features: []),
    right: witness_subject_digest(tree_hex: clean_tree_hex, gnu_abi: true, features: ["tracing"]),
  )
}

data product_axis_red_doc: String = "THE RED FOR THE MISSING-PRODUCT CLASS. One tree at one toolchain, target, profile and feature set can still produce entirely different bytes depending on WHICH artifact was asked for -- the CLI binary, another binary, or the library. Before the product axis existed these were one subject, so a request for one could be answered with another's bytes while every modeled axis agreed. Both rows must differ, and they differ on the two distinct ways a product can vary: the target KIND, and the target NAME at one kind."

test fn the_product_being_built_participates_in_identity() -> Bool {
  let cli = witness_subject_full(
    tree_hex: clean_tree_hex,
    gnu_abi: true,
    features: [],
    package: "gunbc",
    cargo_target: extdeps.cargo.Bin { name: "gunbc" },
    profile: "release",
    rustflags: [],
  )
  let other_bin = witness_subject_full(
    tree_hex: clean_tree_hex,
    gnu_abi: true,
    features: [],
    package: "gunbc",
    cargo_target: extdeps.cargo.Bin { name: "claim_executor" },
    profile: "release",
    rustflags: [],
  )
  let library = witness_subject_full(
    tree_hex: clean_tree_hex,
    gnu_abi: true,
    features: [],
    package: "gunbc",
    cargo_target: extdeps.cargo.Lib,
    profile: "release",
    rustflags: [],
  )
  digests_are_different(
    left: optional_digest(subject: cli),
    right: optional_digest(subject: other_bin),
  )
    && digests_are_different(
      left: optional_digest(subject: cli),
      right: optional_digest(subject: library),
    )
}

fn optional_digest(subject: gunbc.devboot.subject.BuildSubject?) -> std.content_hash.ContentHash? {
  match subject {
    Absent => none
    Present { value: s } => Present { value: gunbc.devboot.subject.build_subject_digest(subject: s) }
  }
}

data environment_axis_red_doc: String = "THE RED FOR THE BUILD-ENVIRONMENT CLASS. A codegen flag changes the emitted bytes while leaving source, toolchain, target, profile, features and product all identical, so a key blind to it would serve an optimized artifact against a request that asked for a debuggable one and vice versa -- with every visible axis agreeing.\\n\\nThe second row is the one that would be easy to get wrong: rustc resolves repeated codegen options last-one-wins, so the SAME flags in a different ORDER are genuinely a different build. A digest that folded flags order-insensitively would report these two as one subject."

test fn build_environment_participates_in_identity() -> Bool {
  let bare = witness_subject_full(
    tree_hex: clean_tree_hex,
    gnu_abi: true,
    features: [],
    package: "gunbc",
    cargo_target: extdeps.cargo.Bin { name: "gunbc" },
    profile: "release",
    rustflags: [],
  )
  let flagged = witness_subject_full(
    tree_hex: clean_tree_hex,
    gnu_abi: true,
    features: [],
    package: "gunbc",
    cargo_target: extdeps.cargo.Bin { name: "gunbc" },
    profile: "release",
    rustflags: ["-Copt-level=3"],
  )
  let reordered = witness_subject_full(
    tree_hex: clean_tree_hex,
    gnu_abi: true,
    features: [],
    package: "gunbc",
    cargo_target: extdeps.cargo.Bin { name: "gunbc" },
    profile: "release",
    rustflags: ["-Cdebuginfo=2", "-Copt-level=3"],
  )
  let original_order = witness_subject_full(
    tree_hex: clean_tree_hex,
    gnu_abi: true,
    features: [],
    package: "gunbc",
    cargo_target: extdeps.cargo.Bin { name: "gunbc" },
    profile: "release",
    rustflags: ["-Copt-level=3", "-Cdebuginfo=2"],
  )
  digests_are_different(left: optional_digest(subject: bare), right: optional_digest(subject: flagged))
    && digests_are_different(
      left: optional_digest(subject: original_order),
      right: optional_digest(subject: reordered),
    )
}

test fn duplicate_feature_refuses() -> Bool {
  match witness_oid(hex: clean_tree_hex) {
    Absent => false
    Present { value: oid } =>
      match gunbc.devboot.subject.admit_build_subject(
        tree_oid: oid,
        package: "gunbc",
        cargo_target: extdeps.cargo.Bin { name: "gunbc" },
        toolchain: witness_toolchain(),
        target: witness_target(gnu_abi: true),
        profile: "release",
        features: ["tracing", "tracing"],
        rustflags: [],
        linker: none,
        sysroot: none,
        cargo_config: [],
        platform_c_library: extdeps.gnu.libc.GnuLibc { version: "2.36" as std.types.NonEmptyStr },
      ) {
        gunbc.devboot.subject.SubjectAdmitted { subject } => false
        gunbc.devboot.subject.SubjectRefused { cause } =>
          match cause {
            gunbc.devboot.subject.DuplicateFeature { name } => name == "tracing"
            _ => false
          }
      }
  }
}

test fn empty_feature_name_refuses() -> Bool {
  match witness_oid(hex: clean_tree_hex) {
    Absent => false
    Present { value: oid } =>
      match gunbc.devboot.subject.admit_build_subject(
        tree_oid: oid,
        package: "gunbc",
        cargo_target: extdeps.cargo.Bin { name: "gunbc" },
        toolchain: witness_toolchain(),
        target: witness_target(gnu_abi: true),
        profile: "release",
        features: [""],
        rustflags: [],
        linker: none,
        sysroot: none,
        cargo_config: [],
        platform_c_library: extdeps.gnu.libc.GnuLibc { version: "2.36" as std.types.NonEmptyStr },
      ) {
        gunbc.devboot.subject.SubjectAdmitted { subject } => false
        gunbc.devboot.subject.SubjectRefused { cause } =>
          match cause {
            gunbc.devboot.subject.FeatureNameEmpty => true
            _ => false
          }
      }
  }
}

data admission_wall_doc: String = "THE ADMISSION IS THE ONLY DOOR, asserted per field rather than assumed from one sample. Each of these strings is non-empty by TYPE inside BuildSubject, so an empty one arriving from a request must be refused at admission or it becomes a cast that asserts what was never checked -- the fabrication class this carrier was reworked to remove. A field that stopped being scanned would show up here and nowhere else."

test fn every_required_string_is_refused_when_empty() -> Bool {
  empty_profile_refuses() && empty_rustflag_refuses()
}

fn empty_profile_refuses() -> Bool {
  match witness_oid(hex: clean_tree_hex) {
    Absent => false
    Present { value: oid } =>
      match gunbc.devboot.subject.admit_build_subject(
        tree_oid: oid,
        package: "gunbc",
        cargo_target: extdeps.cargo.Bin { name: "gunbc" },
        toolchain: witness_toolchain(),
        target: witness_target(gnu_abi: true),
        profile: "",
        features: [],
        rustflags: [],
        linker: none,
        sysroot: none,
        cargo_config: [],
        platform_c_library: extdeps.gnu.libc.GnuLibc { version: "2.36" as std.types.NonEmptyStr },
      ) {
        gunbc.devboot.subject.SubjectAdmitted { subject } => false
        gunbc.devboot.subject.SubjectRefused { cause } =>
          match cause {
            gunbc.devboot.subject.ProfileNameEmpty => true
            _ => false
          }
      }
  }
}

fn empty_rustflag_refuses() -> Bool {
  match witness_oid(hex: clean_tree_hex) {
    Absent => false
    Present { value: oid } =>
      match gunbc.devboot.subject.admit_build_subject(
        tree_oid: oid,
        package: "gunbc",
        cargo_target: extdeps.cargo.Bin { name: "gunbc" },
        toolchain: witness_toolchain(),
        target: witness_target(gnu_abi: true),
        profile: "release",
        features: [],
        rustflags: [""],
        linker: none,
        sysroot: none,
        cargo_config: [],
        platform_c_library: extdeps.gnu.libc.GnuLibc { version: "2.36" as std.types.NonEmptyStr },
      ) {
        gunbc.devboot.subject.SubjectAdmitted { subject } => false
        gunbc.devboot.subject.SubjectRefused { cause } =>
          match cause {
            gunbc.devboot.subject.RustflagEmpty => true
            _ => false
          }
      }
  }
}

fn witness_artifact(for_subject: gunbc.devboot.subject.BuildSubject) -> gunbc.devboot.outcome.StoredArtifact? {
  match witness_oid(hex: blob_hex) {
    Absent => none
    Present { value: blob } =>
      match std.content_hash.sha256_hex_digest(hex: pack_sha256_hex) {
        Absent => none
        Present { value: digest } =>
          Present {
            value: gunbc.devboot.outcome.StoredArtifact {
              subject_digest: gunbc.devboot.subject.build_subject_digest(subject: for_subject),
              blob_oid: blob,
              sha256: digest,
              bytes: std.measure.byte_size(count: 97371648),
            },
          }
      }
  }
}

fn witness_record(for_subject: gunbc.devboot.subject.BuildSubject) -> gunbc.devboot.outcome.StoredArtifactRecord? {
  match witness_artifact(for_subject: for_subject) {
    Absent => none
    Present { value: artifact } =>
      Present { value: gunbc.devboot.outcome.StoredArtifactRecord { subject: for_subject, artifact: artifact } }
  }
}

data structural_equality_red_doc: String = "THE RULING'S REUSE ORDER, ASSERTED AS BEHAVIOUR. A stored record is offered against a request naming a different tree; it must answer SubjectDiffers and the reuse path must refuse, no matter that bytes were sitting right there and available. This is the 'use what's there' failure the hard stop forbids, and it is the arm a cache is most tempted to take.\\n\\nThe row also pins the ORDER the ruling fixed: the mismatch arm is reached with availability set to Available, so a reuse that consulted only the digest and the bytes would grant here. Only a comparison of the full retrieved subject refuses."

test fn a_record_built_for_another_subject_is_refused_even_when_bytes_are_available() -> Bool {
  match witness_subject(tree_hex: clean_tree_hex, gnu_abi: true, features: []) {
    Absent => false
    Present { value: built_for } =>
      match witness_subject(tree_hex: parent_tree_hex, gnu_abi: true, features: []) {
        Absent => false
        Present { value: requested } =>
          match witness_record(for_subject: built_for) {
            Absent => false
            Present { value: record } =>
              match gunbc.devboot.outcome.record_matches_request(record: record, requested: requested) {
                gunbc.devboot.outcome.SubjectMatches => false
                gunbc.devboot.outcome.SubjectDiffers =>
                  !gunbc.devboot.outcome.reuse_grants_artifact(
                    decision: gunbc.devboot.outcome.reuse_decision(
                      candidate: Present { value: record },
                      requested: requested,
                      availability: gunbc.devboot.outcome.ArtifactAvailable { artifact: record.artifact },
                    ),
                  )
              }
          }
      }
  }
}

test fn a_record_built_for_the_request_reuses_when_bytes_are_available() -> Bool {
  match witness_subject(tree_hex: clean_tree_hex, gnu_abi: true, features: []) {
    Absent => false
    Present { value: subject } =>
      match witness_record(for_subject: subject) {
        Absent => false
        Present { value: record } =>
          gunbc.devboot.outcome.reuse_grants_artifact(
            decision: gunbc.devboot.outcome.reuse_decision(
              candidate: Present { value: record },
              requested: subject,
              availability: gunbc.devboot.outcome.ArtifactAvailable { artifact: record.artifact },
            ),
          )
      }
  }
}

data reuse_requires_all_three_doc: String = "REUSE NEEDS A CANDIDATE, AN EXACT MATCH, AND PRESENT BYTES -- never two out of three. The matching record with MISSING bytes is the row that matters: every identity check passes, and reuse must still refuse, because the contract law is about retrievability rather than about records. A service that granted here would report success for bytes nobody can fetch."

test fn a_matching_record_without_bytes_does_not_reuse() -> Bool {
  match witness_subject(tree_hex: clean_tree_hex, gnu_abi: true, features: []) {
    Absent => false
    Present { value: subject } =>
      match witness_record(for_subject: subject) {
        Absent => false
        Present { value: record } =>
          !gunbc.devboot.outcome.reuse_grants_artifact(
            decision: gunbc.devboot.outcome.reuse_decision(
              candidate: Present { value: record },
              requested: subject,
              availability: gunbc.devboot.outcome.ArtifactMissing,
            ),
          )
            && !gunbc.devboot.outcome.reuse_grants_artifact(
              decision: gunbc.devboot.outcome.reuse_decision(
                candidate: none,
                requested: subject,
                availability: gunbc.devboot.outcome.ArtifactAvailable { artifact: record.artifact },
              ),
            )
      }
  }
}

data split_axes_doc: String = "THE STATE THE FUSED SUM COULD NOT SAY. Execution Produced with artifact Missing is a real and common situation -- the build ran and succeeded, the bytes were later pruned -- and under a single outcome sum it could only be expressed by overwriting the success, destroying the record that the build had ever run.\\n\\nBoth halves are asserted here: the status is simultaneously a settled Produced execution AND not retrievable. A collapse back into one axis makes one of the two conjuncts unrepresentable and this row goes red."

fn witness_status(
  subject: gunbc.devboot.subject.BuildSubject,
  id: String,
  execution: gunbc.devboot.outcome.BuildExecutionOutcome,
  availability: gunbc.devboot.outcome.ArtifactAvailability,
) -> gunbc.devboot.outcome.DevbootWorkStatus {
  gunbc.devboot.outcome.DevbootWorkStatus {
    work_id: id as std.types.NonEmptyStr as gunbc.devboot.outcome.DevbootWorkId,
    subject: subject,
    execution: execution,
    availability: availability,
  }
}

fn produced_but_missing_status_holds(subject: gunbc.devboot.subject.BuildSubject) -> Bool {
  let status = witness_status(
    subject: subject,
    id: "w-1",
    execution: gunbc.devboot.outcome.ExecutionProduced,
    availability: gunbc.devboot.outcome.ArtifactMissing,
  )
  gunbc.devboot.outcome.execution_is_settled(execution: status.execution)
    && !gunbc.devboot.outcome.status_reports_retrievable_artifact(status: status)
}

test fn produced_yesterday_with_missing_bytes_today_is_representable() -> Bool {
  match witness_subject(tree_hex: clean_tree_hex, gnu_abi: true, features: []) {
    Absent => false
    Present { value: subject } => produced_but_missing_status_holds(subject: subject)
  }
}

data retrievability_law_doc: String = "THE CONTRACT LAW ASSERTED OVER EVERY ARM: only observed-available bytes permit a caller to believe it holds an artifact. Corrupt bytes are the arm most likely to be mishandled -- they exist, they are the right length, and they are the wrong content -- so a service that treated presence as availability would serve them."

test fn only_observed_available_bytes_permit_retrieval() -> Bool {
  match witness_subject(tree_hex: clean_tree_hex, gnu_abi: true, features: []) {
    Absent => false
    Present { value: subject } =>
      match witness_artifact(for_subject: subject) {
        Absent => false
        Present { value: artifact } =>
          match std.content_hash.sha256_hex_digest(hex: pack_sha256_hex) {
            Absent => false
            Present { value: digest } =>
              gunbc.devboot.outcome.availability_permits_retrieval(
                availability: gunbc.devboot.outcome.ArtifactAvailable { artifact: artifact },
              )
                && !gunbc.devboot.outcome.availability_permits_retrieval(availability: gunbc.devboot.outcome.ArtifactMissing)
                && !gunbc.devboot.outcome.availability_permits_retrieval(
                  availability: gunbc.devboot.outcome.ArtifactCorrupt { expected: digest, observed: digest },
                )
                && !gunbc.devboot.outcome.availability_permits_retrieval(
                  availability: gunbc.devboot.outcome.ArtifactUnreadable { detail: "store unreadable" },
                )
          }
      }
  }
}

fn failed_build_status_holds(subject: gunbc.devboot.subject.BuildSubject) -> Bool {
  let status = witness_status(
    subject: subject,
    id: "w-2",
    execution: gunbc.devboot.outcome.ExecutionFailed { cause: gunbc.devboot.outcome.CompilationFailed { detail: "type error" } },
    availability: gunbc.devboot.outcome.ArtifactMissing,
  )
  !gunbc.devboot.outcome.status_reports_retrievable_artifact(status: status)
    && gunbc.devboot.outcome.execution_is_settled(execution: status.execution)
}

test fn a_failed_build_never_reports_retrievable() -> Bool {
  match witness_subject(tree_hex: clean_tree_hex, gnu_abi: true, features: []) {
    Absent => false
    Present { value: subject } => failed_build_status_holds(subject: subject)
  }
}

test fn an_interrupted_build_is_not_settled() -> Bool {
  !gunbc.devboot.outcome.execution_is_settled(execution: gunbc.devboot.outcome.ExecutionInterrupted { detail: "producer died" })
}

data devboot_membership_witness_doc: String = "THE STORE ROOT IS ENSURED, AND THESE ROWS SAY WHAT THAT BUYS. It projects the gunbc.host_layout authority rather than respelling the path; it reaches the apply order, so a deploy converges it; and its teardown REFUSES, so no retract can remove it.\\n\\nThe third row is the one the incident earned. Wiring this root into the OWNED roster made a lab twin's retract remove the production artifact store -- caught by the twin disjointness claims, which is why those claims were left exactly as they were. A hazard caught once by a claim about something else deserves a control of its own, so the refusal is asserted directly here rather than left to depend on two tests that are really about twins."

fn devboot_ensured_step_projects_layout(acc: Int, step: gunbc.live_deploy.spec.DeploymentDependencyStep) -> Int {
  match step.subject {
    gunbc.live_deploy.spec.EnsuredHostDirectory { path, owner } =>
      if (path as String) == (gunbc.host_layout.srv1_devboot_artifact_store_root as String) { acc + 1 } else { acc }
    gunbc.live_deploy.spec.EnsuredPackage { package } => acc
  }
}

test fn the_devboot_store_root_is_an_ensured_host_resource_projecting_the_layout_row() -> Bool {
  fold(
    gunbc.live_deploy.spec.deployment_ensured_steps(),
    init: 0,
    f: (acc, step) => devboot_ensured_step_projects_layout(acc: acc, step: step),
  ) == 1
}

fn same_path(a: String, b: String) -> Bool { a == b }

fn step_is_devboot_root(step: gunbc.live_deploy.spec.DeploymentStep) -> Bool {
  match step {
    gunbc.live_deploy.spec.Dependency { step: dep } =>
      same_path(a: gunbc.live_deploy.spec.ensured_subject_identity(subject: dep.subject) as String, b: gunbc.host_layout.srv1_devboot_artifact_store_root as String)
    gunbc.live_deploy.spec.ArtifactStep { step: art } => false
  }
}

test fn the_devboot_store_root_reaches_the_deploy_apply_path() -> Bool {
  let spec = gunbc.live_deploy.spec.deployment_spec_srv1()
  fold(spec.steps, init: false, f: (acc, step) => acc || step_is_devboot_root(step: step))
}

data devboot_teardown_refusal_red_doc: String = "THE CONTROL FOR THE HAZARD THAT WAS ACTUALLY HIT. A retract must not be able to remove the artifact store, and this asserts it at the step level: the devboot root's teardown disposition refuses with TeardownOutsideOwnership. If someone moves this root back into the owned roster, TeardownActs replaces the refusal and this row goes red -- which is exactly the edit that, last time, would have let a lab twin's retract delete production's artifacts."

test fn no_retract_can_remove_the_devboot_store_root() -> Bool {
  let spec = gunbc.live_deploy.spec.deployment_spec_srv1()
  fold(
    spec.steps,
    init: false,
    f: (acc, step) =>
      if step_is_devboot_root(step: step) {
        match gunbc.live_deploy.spec.deployment_step_teardown_disposition(step: step) {
          gunbc.live_deploy.spec.TeardownRefuses { cause } => true
          gunbc.live_deploy.spec.TeardownActs => false
        }
      } else {
        acc
      },
  )
}

