module test.claim.spatial_placement


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

// SPATIAL-0 green-by-execution proofs for product.placement_supply and
// gunbc.fleet_physical_inventory: RackResidence/same_rack (exact RackIdentity only; unobserved is
// Absent not false), WirelessAdapterStanding, WirelessReachStanding receipt-grounded reach, and
// the Wi-Fi bootstrap chain. The load-bearing fail-closed control is
// same_rack_without_receipt_refuses_bootstrap: co-rack placement makes a probe candidate but never
// establishes RF reach — bootstrap refuses until TargetAssociationObserved exists. The synthetic
// second-rack specimen proves same_rack returns Present(false) across different RackIdentity
// values. srv1 is the live WirelessAdapterAbsent specimen.
data rack_a: product.placement_supply.RackIdentity = "rack-a" as product.placement_supply.RackIdentity
data rack_b: product.placement_supply.RackIdentity = "rack-b" as product.placement_supply.RackIdentity

data synthetic_site: product.placement_supply.PhysicalSite = product.placement_supply.PhysicalSite {
  identity: "synthetic-lab" as product.placement_supply.SiteIdentity,
  racks: [rack_a, rack_b],
}

data asset_seed: product.placement_supply.PhysicalAssetIdentity = "asset-seed" as product.placement_supply.PhysicalAssetIdentity
data asset_next: product.placement_supply.PhysicalAssetIdentity = "asset-next" as product.placement_supply.PhysicalAssetIdentity
data asset_far: product.placement_supply.PhysicalAssetIdentity = "asset-far" as product.placement_supply.PhysicalAssetIdentity

data host_seed: product.placement_supply.HostIdentity = "seed-host" as product.placement_supply.HostIdentity
data host_next: product.placement_supply.HostIdentity = "next-host" as product.placement_supply.HostIdentity
data host_far: product.placement_supply.HostIdentity = "far-host" as product.placement_supply.HostIdentity

data seed_rack_a_residence: product.placement_supply.RackResidence = product.placement_supply.RackMounted {
  rack: rack_a,
  position: RackPositionUnobserved,
}

data next_rack_a_residence: product.placement_supply.RackResidence = product.placement_supply.RackShelfResident {
  rack: rack_a,
  shelf: none,
}

data far_rack_b_residence: product.placement_supply.RackResidence = product.placement_supply.RackMounted {
  rack: rack_b,
  position: RackPositionUnobserved,
}

data spatial_fixture_facts: List<product.placement_supply.HostSpatialFacts> = [
  product.placement_supply.HostSpatialFacts {
    host: host_seed,
    asset: asset_seed,
    residence: seed_rack_a_residence,
    wireless: product.placement_supply.WirelessAdapterPresent {
      interface: "wlan0" as std.types.NonEmptyStr,
      station_mode: StationModeUnobserved,
    },
    relay: RelayProvisioned,
    bootstrap_need: BootstrapNotNeeded,
  },
  product.placement_supply.HostSpatialFacts {
    host: host_next,
    asset: asset_next,
    residence: next_rack_a_residence,
    wireless: WirelessAdapterUnobserved,
    relay: RelayIncapable,
    bootstrap_need: BootstrapNeeded,
  },
  product.placement_supply.HostSpatialFacts {
    host: host_far,
    asset: asset_far,
    residence: far_rack_b_residence,
    wireless: WirelessAdapterUnobserved,
    relay: RelayIncapable,
    bootstrap_need: BootstrapNeeded,
  },
]

data seed_to_next_association: product.placement_supply.WirelessReachStanding = product.placement_supply.TargetAssociationObserved {
  controller: host_seed,
  target: host_next,
  interface: "wlan0" as std.types.NonEmptyStr,
  management_path_preserved: true,
}

test fn site_contains_declared_racks_holds() -> Bool {
  site_contains_rack(site: synthetic_site, rack: rack_a)
    && site_contains_rack(site: synthetic_site, rack: rack_b)
    && site_contains_rack(site: operator_physical_site, rack: rack_01)
}

test fn same_rack_exact_identity_holds_for_co_residents() -> Bool {
  match same_rack(a: seed_rack_a_residence, b: next_rack_a_residence) {
    Present { value: same } => same
    Absent => false
  }
}

test fn same_rack_different_racks_is_false_not_unknown() -> Bool {
  match same_rack(a: seed_rack_a_residence, b: far_rack_b_residence) {
    Present { value: same } => !same
    Absent => false
  }
}

test fn same_rack_unobserved_is_absent_not_false() -> Bool {
  match same_rack(a: RackResidenceUnobserved, b: seed_rack_a_residence) {
    Absent => true
    Present { value: _ } => false
  }
}

// Three arms, discriminating: needed is Present(true), not-needed is Present(false), and
// unobserved is Absent. The RED this pins is the collapse review 50391 found — mapping
// BootstrapNeedUnobserved to false made an unlooked-at target report "does not need
// bootstrap", so a witness asserting Present{value:false} on the third arm must fail.
test fn bootstrap_need_discriminates_unobserved_from_not_needed() -> Bool {
  match wifi_target_needs_bootstrap(need: BootstrapNeeded) {
    Absent => false
    Present { value: needed } =>
      match wifi_target_needs_bootstrap(need: BootstrapNotNeeded) {
        Absent => false
        Present { value: not_needed } =>
          match wifi_target_needs_bootstrap(need: BootstrapNeedUnobserved) {
            Present { value: _ } => false
            Absent => needed && !not_needed
          }
      }
  }
}

test fn wireless_standing_discriminates_present_vs_absent() -> Bool {
  match wireless_adapter_can_associate(
    standing: product.placement_supply.WirelessAdapterPresent {
      interface: "wlan0" as std.types.NonEmptyStr,
      station_mode: StationModeUnobserved,
    },
  ) {
    Absent => false
    Present { value: present_can } =>
      match wireless_adapter_can_associate(standing: WirelessAdapterAbsent) {
        Absent => false
        Present { value: absent_can } =>
          match wireless_adapter_can_associate(standing: WirelessAdapterUnobserved) {
            Present { value: _ } => false
            Absent =>
              match wifi_relay_can_bootstrap(
                relay: RelayProvisioned,
                wireless: product.placement_supply.WirelessAdapterPresent {
                  interface: "wlan0" as std.types.NonEmptyStr,
                  station_mode: StationModeUnobserved,
                },
              ) {
                Absent => false
                Present { value: relay_can } =>
                  present_can && !absent_can && relay_can
              }
          }
      }
  }
}

test fn srv1_measured_adapter_absent_specimen() -> Bool {
  match host_spatial_facts_for(facts: fleet_host_spatial_facts, host: host_srv1) {
    Present { value: srv1 } =>
      match srv1.wireless {
        WirelessAdapterAbsent =>
          match wireless_adapter_can_associate(standing: srv1.wireless) {
            Present { value: can } => !can
            Absent => false
          }
        WirelessAdapterPresent { interface: _, station_mode: _ } => false
        WirelessAdapterUnobserved => false
      }
    Absent => false
  }
    && srv1_measured_wireless_note != ""
}

test fn same_rack_makes_probe_candidate_without_establishing_reach() -> Bool {
  match wifi_probe_is_candidate(
    bootstrapper_residence: seed_rack_a_residence,
    target_residence: next_rack_a_residence,
    bootstrapper_wireless: product.placement_supply.WirelessAdapterPresent {
      interface: "wlan0" as std.types.NonEmptyStr,
      station_mode: StationModeUnobserved,
    },
  ) {
    Absent => false
    Present { value: is_candidate } => is_candidate
  }
    && !wireless_reach_established(
      bootstrapper: host_seed,
      target: host_next,
      standings: [],
    )
}

test fn same_rack_without_receipt_refuses_bootstrap() -> Bool {
  match wifi_bootstrap_step_admissible(
    step: product.placement_supply.WifiBootstrapStep { bootstrapper: host_seed, target: host_next },
    facts: spatial_fixture_facts,
    reach_standings: [],
  ) {
    WifiBootstrapRefused { cause: c } => c == "wireless_reach_unobserved"
    WifiBootstrapAdmissible => false
  }
}

test fn association_receipt_establishes_reach_and_admits_bootstrap() -> Bool {
  wireless_reach_established(
    bootstrapper: host_seed,
    target: host_next,
    standings: [seed_to_next_association],
  )
    && match wifi_bootstrap_step_admissible(
      step: product.placement_supply.WifiBootstrapStep { bootstrapper: host_seed, target: host_next },
      facts: spatial_fixture_facts,
      reach_standings: [seed_to_next_association],
    ) {
      WifiBootstrapAdmissible => true
      WifiBootstrapRefused { cause: _ } => false
    }
}

test fn synthetic_second_rack_refuses_probe_and_bootstrap() -> Bool {
  match wifi_probe_is_candidate(
    bootstrapper_residence: seed_rack_a_residence,
    target_residence: far_rack_b_residence,
    bootstrapper_wireless: product.placement_supply.WirelessAdapterPresent {
      interface: "wlan0" as std.types.NonEmptyStr,
      station_mode: StationModeUnobserved,
    },
  ) {
    Absent => false
    Present { value: is_candidate } => !is_candidate
  }
    && match wifi_bootstrap_step_admissible(
      step: product.placement_supply.WifiBootstrapStep { bootstrapper: host_seed, target: host_far },
      facts: spatial_fixture_facts,
      reach_standings: [seed_to_next_association],
    ) {
      WifiBootstrapRefused { cause: c } => c == "wifi_probe_not_candidate"
      WifiBootstrapAdmissible => false
    }
}

test fn wifi_bootstrap_chain_one_hop_with_receipt_holds() -> Bool {
  let chain = product.placement_supply.WifiBootstrapChain {
    steps: [
      product.placement_supply.WifiBootstrapStep { bootstrapper: host_seed, target: host_next },
    ],
  }
  match wifi_bootstrap_chain_admissible(
    chain: chain,
    facts: spatial_fixture_facts,
    reach_standings: [seed_to_next_association],
  ) {
    WifiBootstrapAdmissible => true
    WifiBootstrapRefused { cause: _ } => false
  }
}

test fn fleet_nominal_rackmount_arithmetic_witness_holds() -> Bool {
  fleet_nominal_rackmount_arithmetic_holds()
}
