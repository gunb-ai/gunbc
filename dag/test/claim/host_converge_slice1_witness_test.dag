module test.claim.host_converge_slice1_witness

import std.types { Bool }
import extdeps.os.systemd { systemd_memory_max_property }
import gunbc.host_converge { Drifted }
import gunbc.fleet_intent_network { operator_host_srv1 }
import gunbc.runner_unit_live_read {
  gunbc_srv1_runner_unit_live_read_fixture,
  runner_unit_live_read_typed,
}
import gunbc.fleet_show_effective_read {
  fleet_runner_unit_property_read_script,
  runner_unit_live_read_row_from_stdout,
  runner_unit_memory_live_read_from_stdout,
  per_slot_memory_cap_verdict_from_unit_read,
}
import gunbc.host_converge_slice1 {
  host_converge_slice1_probe_unit,
  host_converge_slice1_knob_name,
  host_converge_slice1_srv1_per_slot_memory_max_knob,
  host_converge_slice1_knob_is_per_slot_memory_max,
  host_converge_slice1_memory_cap_verdict,
  host_converge_slice1_fixture_receipt,
  host_converge_slice1_knob_wired,
  host_converge_slice1_apply_path_wired,
  host_converge_slice1_memory_max_read_script,
  host_converge_slice1_memory_max_set_script,
  host_converge_slice1_transport_script_scaffold,
}
import std.disposition { Scaffold, Terminal }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn witness_slice1_knob_is_per_slot_memory_max_on_srv1() -> Bool {
  match host_converge_slice1_srv1_per_slot_memory_max_knob() {
    Present { value: knob } =>
      host_converge_slice1_knob_is_per_slot_memory_max(knob: knob)
        && knob.name == host_converge_slice1_knob_name
    Absent => false
  }
}

fn witness_fixture_infinity_drifts_against_model_desired() -> Bool {
  match host_converge_slice1_fixture_receipt() {
    Present { value: receipt } =>
      receipt.host == operator_host_srv1
        && receipt.unit == host_converge_slice1_probe_unit
        && receipt.verdict == Drifted
    Absent => false
  }
}

fn witness_stdout_parse_grounds_memory_max() -> Bool {
  match runner_unit_live_read_row_from_stdout(
    unit: host_converge_slice1_probe_unit,
    stdout: "infinity\n0\ninfinity\n",
    probed_at: "2026-07-16",
  ) {
    Present { value: row } => row.memory_max_raw == "infinity"
    Absent => false
  }
}

fn witness_short_stdout_is_read_absent() -> Bool {
  match runner_unit_memory_live_read_from_stdout(
    unit: host_converge_slice1_probe_unit,
    stdout: "infinity\n",
    probed_at: "2026-07-16",
  ) {
    Present { value: _ } => false
    Absent => true
  }
}

fn witness_verdict_uses_converge_target_not_string_flatten() -> Bool {
  match host_converge_slice1_srv1_per_slot_memory_max_knob() {
    Present { value: knob } =>
      match host_converge_slice1_memory_cap_verdict(
        read: runner_unit_live_read_typed(row: gunbc_srv1_runner_unit_live_read_fixture),
        knob: knob,
      ) {
        Present { value: Drifted } =>
          match per_slot_memory_cap_verdict_from_unit_read(
            read: runner_unit_live_read_typed(row: gunbc_srv1_runner_unit_live_read_fixture),
            target: knob.target,
          ) {
            Present { value: Drifted } => true
            _ => false
          }
        _ => false
      }
    Absent => false
  }
}

fn witness_transport_scripts_are_read_only_systemctl() -> Bool {
  string_contains(
    s: host_converge_slice1_memory_max_read_script(unit: host_converge_slice1_probe_unit),
    pattern: "systemctl show",
  )
    && string_contains(
      s: host_converge_slice1_memory_max_set_script(unit: host_converge_slice1_probe_unit, bytes_value: "17179869184"),
      pattern: "set-property",
    )
    && string_contains(
      s: fleet_runner_unit_property_read_script(unit: host_converge_slice1_probe_unit, property: systemd_memory_max_property),
      pattern: "MemoryMax",
    )
}

fn witness_apply_and_knob_paths_wired() -> Bool {
  host_converge_slice1_knob_wired() && host_converge_slice1_apply_path_wired()
}

fn witness_transport_script_scaffold_carries_dissolution_trigger() -> Bool {
  match host_converge_slice1_transport_script_scaffold {
    Scaffold { dissolves_to: _, bind: _ } => true
    Terminal { reason: _ } => false
  }
}

test fn host_converge_slice1_wires_srv1_memory_cap() -> Bool {
  witness_slice1_knob_is_per_slot_memory_max_on_srv1()
    && witness_fixture_infinity_drifts_against_model_desired()
    && witness_stdout_parse_grounds_memory_max()
    && witness_short_stdout_is_read_absent()
    && witness_verdict_uses_converge_target_not_string_flatten()
    && witness_transport_scripts_are_read_only_systemctl()
    && witness_apply_and_knob_paths_wired()
}
