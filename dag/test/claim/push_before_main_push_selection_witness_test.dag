module test.claim.push_before_main_push_selection_witness_test


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

data push_before_selection_witness_note: String = "Discriminating witness for push-before main-push selection (checklist step 6): a planted push delta observes PushBefore (not self-compare), carries a non-empty changed-path population, and the selection-degradation receipt reads SelectionApplied with selected/total derived from that population (selected>0, selected<total). RED control witness_empty_delta_zero_selected_still_reads_applied_red documents why selected>0 matters: a zero-path diff still classifies as SelectionApplied with selected=0 — the empty-observation narrow trap the push-before baseline closes."

data planted_before_sha: String = "1111111111111111111111111111111111111111"
data planted_head_sha: String = "2222222222222222222222222222222222222222"

data roster_entry_push_event: String = "dag/extdeps/github/push_event.dag"
data roster_entry_diff_baseline: String = "dag/gunbc/diff_baseline.dag"
data roster_entry_ci_spec: String = "dag/gunbc/ci_spec.dag"

fn planted_entry_group_roster() -> List<String> {
  [roster_entry_push_event, roster_entry_diff_baseline, roster_entry_ci_spec]
}

fn planted_push_delta_changed_paths() -> List<String> {
  [roster_entry_push_event, roster_entry_diff_baseline]
}

fn roster_entry_selected(entry: String, changed_paths: List<String>) -> Bool {
  fold(
    changed_paths,
    init: false,
    f: (acc, path) => acc || path == entry
  )
}

fn count_selected_entry_groups(roster: List<String>, changed_paths: List<String>) -> Nat {
  fold(
    roster,
    init: 0,
    f: (acc, entry) =>
      if roster_entry_selected(entry: entry, changed_paths: changed_paths) {
        acc + 1
      } else {
        acc
      }
  )
}

fn planted_main_push_baseline_resolution() -> DiffBaselineResolution {
  resolve_diff_baseline(
    event: CiDiffEvent {
      override_ref: none,
      event_name: "push",
      base_ref: none,
      push_before: Present { value: PushBeforeSha { sha: planted_before_sha } },
      head_sha: Present { value: planted_head_sha },
      diff_window: none
    },
    push_parent_ref: gunbc_merge_target_ref,
    default_remote_name: gunbc_default_remote_name
  )
}

test fn witness_main_push_resolves_push_before_not_parent() -> Bool {
  match planted_main_push_baseline_resolution() {
    BaselineSelected { baseline: PushBefore { ref: ref } } =>
      (ref as String) == planted_before_sha
    BaselineRefused { reason: _ } => false
    BaselineSourceConflict { window_detail: _, override_ref: _ } => false
    BaselineSelected { baseline: _ } => false
  }
}

test fn witness_self_compare_would_observe_zero_changed_paths() -> Bool {
  list_length(items: planted_push_delta_changed_paths()) > 0
    && list_length(items: []) == 0
}

test fn witness_main_push_selection_degradation_applied_from_planted_delta() -> Bool {
  let roster = planted_entry_group_roster()
  let changed = planted_push_delta_changed_paths()
  let total = list_length(items: roster)
  let selected = count_selected_entry_groups(roster: roster, changed_paths: changed)
  let line = selection_degradation_receipt_line(
    selection_mode_tag: "applied" as NonEmptyStr,
    selected: selected,
    total: total,
    categorization_unavailable: false,
    categorization_reason: ""
  )
  let receipt = selection_degradation_receipt_of(
    selection_mode_tag: "applied" as NonEmptyStr,
    selected: selected,
    total: total,
    categorization_unavailable: false,
    categorization_reason: ""
  )
  selection_degradation_is_applied_narrowed(receipt: receipt)
    && selected > 0
    && selected < total
    && selection_degradation_state_tag(state: receipt.selection_state) == "SelectionApplied"
    && string_contains(s: line, pattern: "selected_entry_groups=2")
    && string_contains(s: line, pattern: "total_entry_groups=3")
}

test fn witness_empty_delta_zero_selected_still_reads_applied_red() -> Bool {
  let roster = planted_entry_group_roster()
  let total = list_length(items: roster)
  let selected = count_selected_entry_groups(roster: roster, changed_paths: [])
  let receipt = selection_degradation_receipt_of(
    selection_mode_tag: "applied" as NonEmptyStr,
    selected: selected,
    total: total,
    categorization_unavailable: false,
    categorization_reason: ""
  )
  selected == 0
    && selection_degradation_is_applied_narrowed(receipt: receipt)
    && selection_degradation_state_tag(state: receipt.selection_state) == "SelectionApplied"
}
