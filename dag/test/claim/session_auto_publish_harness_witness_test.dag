data witness_scope_note: String = "AUTO-PUBLISH harness: slice 0 recut proves three independent axes — LocalCheckpoint (local autosave), RemoteBranchPublication (explicit publish push), WorkerNotification (user publish or drift reminder) — and that silent polling advances none of them; slice 1 proves immediate policy adjudication; slice 2 proves default-deny remote-publish conjunction with five refusal fixtures and a positive control. What is NOT claimed: shell transport does not yet call admit_remote_publication, so publishSessionWorktree can still auto-push until the transport slice lands."

data head_a: CommitSha = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
data head_b: CommitSha = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
data head_c: CommitSha = "cccccccccccccccccccccccccccccccccccccccc"
data head_main: CommitSha = "dddddddddddddddddddddddddddddddddddddddd"
data stamp_one: Timestamp = "2026-08-07T00:00:00.000Z"
data stamp_two: Timestamp = "2026-08-07T00:00:01.000Z"

test fn local_autosave_advances_local_checkpoint_only() -> Bool {
  let state = after_local_autosave(
    state: after_user_intent_publish(
      state: empty_session_publish_state(),
      published_head: head_a,
      at: stamp_one,
    ),
    local_commit: head_b,
  )
  match local_checkpoint_commit(state: state) {
    Present { value: commit } => commit == head_b
    Absent => false
  }
    && match remote_branch_head(state: state) {
      Present { value: head } => head == head_a
      Absent => false
    }
    && match worker_notification_head(state: state) {
      Present { value: head } => head == head_a
      Absent => false
    }
}

test fn explicit_publish_push_advances_remote_branch_only() -> Bool {
  let state = after_explicit_publish_push(
    state: after_local_autosave(
      state: empty_session_publish_state(),
      local_commit: head_a,
    ),
    remote_head: head_b,
  )
  match local_checkpoint_commit(state: state) {
    Present { value: commit } => commit == head_a
    Absent => false
  }
    && match remote_branch_head(state: state) {
      Present { value: head } => head == head_b
      Absent => false
    }
    && match worker_notification_head(state: state) {
      Absent => true
      Present { value: _ } => false
    }
}

test fn user_intent_stamps_remote_branch_and_worker() -> Bool {
  let state = after_user_intent_publish(
    state: after_local_autosave(
      state: empty_session_publish_state(),
      local_commit: head_a,
    ),
    published_head: head_b,
    at: stamp_two,
  )
  match remote_branch_head(state: state) {
    Present { value: head } => head == head_b
    Absent => false
  }
    && match worker_notification_head(state: state) {
      Present { value: head } => head == head_b
      Absent => false
    }
    && match state.worker {
      WorkerNotificationStamped { notified_head: _, notified_at: at } => at == stamp_two
      WorkerNotificationAbsent => false
    }
}

test fn drift_reminder_advances_worker_notification_only() -> Bool {
  let state = after_drift_reminder_delivered(
    state: after_user_intent_publish(
      state: empty_session_publish_state(),
      published_head: head_a,
      at: stamp_one,
    ),
    current_head: head_c,
    at: stamp_two,
  )
  match remote_branch_head(state: state) {
    Present { value: head } => head == head_a
    Absent => false
  }
    && match worker_notification_head(state: state) {
      Present { value: head } => head == head_c
      Absent => false
    }
    && match state.worker {
      WorkerNotificationStamped { notified_head: _, notified_at: at } => at == stamp_two
      WorkerNotificationAbsent => false
    }
}

test fn silent_poll_advances_no_axis() -> Bool {
  let before = after_user_intent_publish(
    state: empty_session_publish_state(),
    published_head: head_a,
    at: stamp_one,
  )
  let after = observe_without_publishing(state: before)
  local_checkpoint_commit(state: before) == local_checkpoint_commit(state: after)
    && remote_branch_head(state: before) == remote_branch_head(state: after)
    && worker_notification_head(state: before) == worker_notification_head(state: after)
}

test fn drift_poll_requires_worker_notification() -> Bool {
  !drift_poll_may_run(state: empty_session_publish_state())
    && drift_poll_may_run(
      state: after_user_intent_publish(
        state: empty_session_publish_state(),
        published_head: head_a,
        at: stamp_one,
      ),
    )
    && !drift_poll_may_run(
      state: after_explicit_publish_push(
        state: empty_session_publish_state(),
        remote_head: head_a,
      ),
    )
}

data conflation_red_note: String = "When poll wrongly treats a push as RemoteBranchPublication while WorkerNotification stays behind, the old pr_publish_head || pr_publish_notified_head fallback returns the remote head. Drift must use worker_notification_baseline instead, or unrelated mainline commits enter the worker notice."

test fn conflated_baseline_differs_from_worker_when_remote_advanced_without_notification() -> Bool {
  let state = after_explicit_publish_push(
    state: after_user_intent_publish(
      state: empty_session_publish_state(),
      published_head: head_a,
      at: stamp_one,
    ),
    remote_head: head_b,
  )
  match worker_notification_baseline(state: state) {
    Present { value: worker } =>
      match conflated_checkpoint_baseline(state: state) {
        Present { value: conflated } =>
          worker == head_a && conflated == head_b && worker != conflated
        Absent => false
      }
    Absent => false
  }
}

test fn drift_diff_start_uses_worker_not_conflated_baseline() -> Bool {
  let notified = head_a
  resolve_drift_diff_start(
    notified_baseline: notified,
    current_head: head_c,
    merge_base_with_origin: Present { value: head_main },
    baseline_is_ancestor_of_merge_base: true,
  ) == head_main
    && resolve_drift_diff_start(
      notified_baseline: notified,
      current_head: head_c,
      merge_base_with_origin: Absent,
      baseline_is_ancestor_of_merge_base: false,
    ) == notified
}

test fn red_conflated_baseline_would_start_drift_at_remote_head() -> Bool {
  let state = after_explicit_publish_push(
    state: after_user_intent_publish(
      state: empty_session_publish_state(),
      published_head: head_a,
      at: stamp_one,
    ),
    remote_head: head_b,
  )
  match worker_notification_baseline(state: state) {
    Present { value: worker } =>
      match conflated_checkpoint_baseline(state: state) {
        Present { value: conflated } =>
          resolve_drift_diff_start(
            notified_baseline: worker,
            current_head: head_c,
            merge_base_with_origin: Absent,
            baseline_is_ancestor_of_merge_base: false,
          ) != conflated
        Absent => false
      }
    Absent => false
  }
}

test fn scratch_probe_permits_local_checkpoint_only() -> Bool {
  publication_is_permitted(
    disposition: adjudicate_local_checkpoint(subject: PublicationSubjectScratchProbe),
  )
    && !publication_is_permitted(
      disposition: adjudicate_remote_publication(
        subject: PublicationSubjectScratchProbe,
        kind: RemotePushBranch,
      ),
    )
    && !publication_is_permitted(
      disposition: adjudicate_remote_publication(
        subject: PublicationSubjectScratchProbe,
        kind: RemoteCreatePullRequest,
      ),
    )
}

test fn autosave_permits_local_checkpoint_only() -> Bool {
  publication_is_permitted(
    disposition: adjudicate_local_checkpoint(subject: PublicationSubjectDashboardAutosave),
  )
    && !publication_is_permitted(
      disposition: adjudicate_remote_publication(
        subject: PublicationSubjectDashboardAutosave,
        kind: RemotePushBranch,
      ),
    )
}

test fn healer_refuses_author_branch_mutation() -> Bool {
  match adjudicate_remote_publication(
    subject: PublicationSubjectArtifactHealer {
      repair_target: HealerRepairTargetAuthorBranch,
    },
    kind: HealerMutateAuthorBranch,
  ) {
    PublicationRefuse { cause: HealerAuthorBranchMutationForbidden } => true
    PublicationPermit => false
  }
    && publication_is_permitted(
      disposition: adjudicate_remote_publication(
        subject: PublicationSubjectArtifactHealer {
          repair_target: HealerRepairTargetBotBranch,
        },
        kind: RemotePushBranch,
      ),
    )
    && publication_is_permitted(
      disposition: adjudicate_remote_publication(
        subject: PublicationSubjectArtifactHealer {
          repair_target: HealerRepairTargetPatchArtifact,
        },
        kind: RemotePushBranch,
      ),
    )
}

test fn explicit_user_intent_permits_remote_publication() -> Bool {
  publication_is_permitted(
    disposition: adjudicate_remote_publication(
      subject: PublicationSubjectExplicitUserIntent,
      kind: RemotePushBranch,
    ),
  )
    && publication_is_permitted(
      disposition: adjudicate_remote_publication(
        subject: PublicationSubjectExplicitUserIntent,
        kind: RemoteCreatePullRequest,
      ),
    )
}

data unknown_subject_red_note: String = "Unevaluable publication subjects must refuse remote publication rather than pass — the absorbing fallback in the worst place."

test fn unknown_subject_refuses_remote_publication() -> Bool {
  match adjudicate_remote_publication(
    subject: PublicationSubjectUnknown,
    kind: RemotePushBranch,
  ) {
    PublicationRefuse { cause: PublicationSubjectUnknownRefused } => true
    PublicationPermit => false
  }
    && match adjudicate_local_checkpoint(subject: PublicationSubjectUnknown) {
      PublicationRefuse { cause: PublicationSubjectUnknownRefused } => true
      PublicationPermit => false
    }
}

test fn unknown_healer_target_refuses_remote_publication() -> Bool {
  match adjudicate_remote_publication(
    subject: PublicationSubjectArtifactHealer {
      repair_target: HealerRepairTargetUnknown,
    },
    kind: RemotePushBranch,
  ) {
    PublicationRefuse { cause: HealerRepairTargetUnknownRefused } => true
    PublicationPermit => false
  }
}

test fn red_scratch_probe_remote_would_have_published() -> Bool {
  match adjudicate_remote_publication(
    subject: PublicationSubjectScratchProbe,
    kind: RemoteCreatePullRequest,
  ) {
    PublicationRefuse { cause: ScratchProbeRemotePublicationForbidden } => true
    PublicationPermit => false
  }
}

test fn red_autosave_remote_would_have_published() -> Bool {
  match adjudicate_remote_publication(
    subject: PublicationSubjectDashboardAutosave,
    kind: RemotePushBranch,
  ) {
    PublicationRefuse { cause: AutosaveRemotePublicationForbidden } => true
    PublicationPermit => false
  }
}

fn clean_publish_request(head: CommitSha) -> PublicationRequest {
  mint_publication_request(
    requester: "loyal-otter-651",
    expected_remote_head: head,
    produced_head: head,
  )
}

fn clean_publish_attempt(head: CommitSha, paths: List<String>) -> RemotePublishAttempt {
  RemotePublishAttempt {
    subject: PublicationSubjectExplicitUserIntent,
    kind: RemotePushBranch,
    request: Present { value: clean_publish_request(head: head) },
    observed_remote_head: RemoteHeadKnown { head: head },
    current_remote_head: RemoteHeadKnown { head: head },
    index_cleanliness: IndexClean,
    unmerged_stage_count: CountKnown { count: 0 },
    conflict_marker_count: CountKnown { count: 0 },
    declared_write_paths: paths,
    actual_write_paths: paths,
    post_write_compile: PostWriteCompileGreen,
    peer_authorship: PeerAuthoredByPublisher,
  }
}

test fn explicit_request_positive_control_permits_remote_publication() -> Bool {
  publication_is_permitted(
    disposition: admit_remote_publication(
      attempt: clean_publish_attempt(
        head: head_a,
        paths: ["dag/gunbc/session_auto_publish.dag"],
      ),
    ),
  )
}

test fn fixture_uncompilable_tree_refuses_before_remote_write() -> Bool {
  match admit_remote_publication(
    attempt: RemotePublishAttempt {
      subject: PublicationSubjectExplicitUserIntent,
      kind: RemotePushBranch,
      request: Present { value: clean_publish_request(head: head_a) },
      observed_remote_head: RemoteHeadKnown { head: head_a },
      current_remote_head: RemoteHeadKnown { head: head_a },
      index_cleanliness: IndexClean,
      unmerged_stage_count: CountKnown { count: 0 },
      conflict_marker_count: CountKnown { count: 0 },
      declared_write_paths: ["dag/gunbc/session_auto_publish.dag"],
      actual_write_paths: ["dag/gunbc/session_auto_publish.dag"],
      post_write_compile: PostWriteCompileRed,
      peer_authorship: PeerAuthoredByPublisher,
    },
  ) {
    PublicationRefuse { cause: PostWriteCompileRedRefused } => true
    PublicationPermit => false
  }
}

