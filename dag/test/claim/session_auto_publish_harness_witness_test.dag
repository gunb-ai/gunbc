module test.claim.session_auto_publish_harness_witness


data witness_scope_note: String = "AUTO-PUBLISH harness: slice 0 recut proves three independent axes — LocalCheckpoint (local autosave), RemoteBranchPublication (explicit publish push), WorkerNotification (user publish or drift reminder) — and that silent polling advances none of them; slice 1 proves immediate policy adjudication by (repair_target, operation) pair; slice 2 proves default-deny remote-publish conjunction with PostWriteValidationReceipt exact-joined to ingested PublicationRequest. What is NOT claimed: shell transport does not yet call admit_remote_publication, so publishSessionWorktree can still auto-push until the transport slice lands."

data head_a: std.types.CommitSha = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
data head_b: std.types.CommitSha = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
data head_c: std.types.CommitSha = "cccccccccccccccccccccccccccccccccccccccc"
data head_main: std.types.CommitSha = "dddddddddddddddddddddddddddddddddddddddd"
data stamp_one: std.types.Timestamp = "2026-08-07T00:00:00.000Z"
data stamp_two: std.types.Timestamp = "2026-08-07T00:00:01.000Z"
data write_digest_a: std.content_hash.Fnv1a64Structural = std.content_hash.Fnv1a64Structural { digest: "1111111111111111" }
data write_digest_b: std.content_hash.Fnv1a64Structural = std.content_hash.Fnv1a64Structural { digest: "2222222222222222" }

test fn local_autosave_advances_local_checkpoint_only() -> Bool {
  let state = gunbc.session_auto_publish.after_local_autosave(
    state: gunbc.session_auto_publish.after_user_intent_publish(
      state: gunbc.session_auto_publish.empty_session_publish_state(),
      published_head: head_a,
      at: stamp_one,
    ),
    local_commit: head_b,
  )
  match gunbc.session_auto_publish.local_checkpoint_commit(state: state) {
    v2.std.optional.Present { value: commit } => commit == head_b
    v2.std.optional.Absent => false
  }
    && match gunbc.session_auto_publish.remote_branch_head(state: state) {
      v2.std.optional.Present { value: head } => head == head_a
      v2.std.optional.Absent => false
    }
    && match gunbc.session_auto_publish.worker_notification_head(state: state) {
      v2.std.optional.Present { value: head } => head == head_a
      v2.std.optional.Absent => false
    }
}

test fn explicit_publish_push_advances_remote_branch_only() -> Bool {
  let state = gunbc.session_auto_publish.after_explicit_publish_push(
    state: gunbc.session_auto_publish.after_local_autosave(
      state: gunbc.session_auto_publish.empty_session_publish_state(),
      local_commit: head_a,
    ),
    remote_head: head_b,
  )
  match gunbc.session_auto_publish.local_checkpoint_commit(state: state) {
    v2.std.optional.Present { value: commit } => commit == head_a
    v2.std.optional.Absent => false
  }
    && match gunbc.session_auto_publish.remote_branch_head(state: state) {
      v2.std.optional.Present { value: head } => head == head_b
      v2.std.optional.Absent => false
    }
    && match gunbc.session_auto_publish.worker_notification_head(state: state) {
      v2.std.optional.Absent => true
      v2.std.optional.Present { value: _ } => false
    }
}

test fn user_intent_stamps_remote_branch_and_worker() -> Bool {
  let state = gunbc.session_auto_publish.after_user_intent_publish(
    state: gunbc.session_auto_publish.after_local_autosave(
      state: gunbc.session_auto_publish.empty_session_publish_state(),
      local_commit: head_a,
    ),
    published_head: head_b,
    at: stamp_two,
  )
  match gunbc.session_auto_publish.remote_branch_head(state: state) {
    v2.std.optional.Present { value: head } => head == head_b
    v2.std.optional.Absent => false
  }
    && match gunbc.session_auto_publish.worker_notification_head(state: state) {
      v2.std.optional.Present { value: head } => head == head_b
      v2.std.optional.Absent => false
    }
    && match state.worker {
      gunbc.session_auto_publish.WorkerNotificationStamped { notified_head: _, notified_at: at } => at == stamp_two
      gunbc.session_auto_publish.WorkerNotificationAbsent => false
    }
}

test fn drift_reminder_advances_worker_notification_only() -> Bool {
  let state = gunbc.session_auto_publish.after_drift_reminder_delivered(
    state: gunbc.session_auto_publish.after_user_intent_publish(
      state: gunbc.session_auto_publish.empty_session_publish_state(),
      published_head: head_a,
      at: stamp_one,
    ),
    current_head: head_c,
    at: stamp_two,
  )
  match gunbc.session_auto_publish.remote_branch_head(state: state) {
    v2.std.optional.Present { value: head } => head == head_a
    v2.std.optional.Absent => false
  }
    && match gunbc.session_auto_publish.worker_notification_head(state: state) {
      v2.std.optional.Present { value: head } => head == head_c
      v2.std.optional.Absent => false
    }
    && match state.worker {
      gunbc.session_auto_publish.WorkerNotificationStamped { notified_head: _, notified_at: at } => at == stamp_two
      gunbc.session_auto_publish.WorkerNotificationAbsent => false
    }
}

test fn silent_poll_advances_no_axis() -> Bool {
  let before = gunbc.session_auto_publish.after_user_intent_publish(
    state: gunbc.session_auto_publish.empty_session_publish_state(),
    published_head: head_a,
    at: stamp_one,
  )
  let after = gunbc.session_auto_publish.observe_without_publishing(state: before)
  gunbc.session_auto_publish.local_checkpoint_commit(state: before) == gunbc.session_auto_publish.local_checkpoint_commit(state: after)
    && gunbc.session_auto_publish.remote_branch_head(state: before) == gunbc.session_auto_publish.remote_branch_head(state: after)
    && gunbc.session_auto_publish.worker_notification_head(state: before) == gunbc.session_auto_publish.worker_notification_head(state: after)
}

test fn drift_poll_requires_worker_notification() -> Bool {
  !gunbc.session_auto_publish.drift_poll_may_run(state: gunbc.session_auto_publish.empty_session_publish_state())
    && gunbc.session_auto_publish.drift_poll_may_run(
      state: gunbc.session_auto_publish.after_user_intent_publish(
        state: gunbc.session_auto_publish.empty_session_publish_state(),
        published_head: head_a,
        at: stamp_one,
      ),
    )
    && !gunbc.session_auto_publish.drift_poll_may_run(
      state: gunbc.session_auto_publish.after_explicit_publish_push(
        state: gunbc.session_auto_publish.empty_session_publish_state(),
        remote_head: head_a,
      ),
    )
}

data conflation_red_note: String = "When poll wrongly treats a push as RemoteBranchPublication while WorkerNotification stays behind, the old pr_publish_head || pr_publish_notified_head fallback returns the remote head. Drift must use worker_notification_baseline instead, or unrelated mainline commits enter the worker notice."

test fn conflated_baseline_differs_from_worker_when_remote_advanced_without_notification() -> Bool {
  let state = gunbc.session_auto_publish.after_explicit_publish_push(
    state: gunbc.session_auto_publish.after_user_intent_publish(
      state: gunbc.session_auto_publish.empty_session_publish_state(),
      published_head: head_a,
      at: stamp_one,
    ),
    remote_head: head_b,
  )
  match gunbc.session_auto_publish.worker_notification_baseline(state: state) {
    v2.std.optional.Present { value: worker } =>
      match gunbc.session_auto_publish.conflated_checkpoint_baseline(state: state) {
        v2.std.optional.Present { value: conflated } =>
          worker == head_a && conflated == head_b && worker != conflated
        v2.std.optional.Absent => false
      }
    v2.std.optional.Absent => false
  }
}

test fn drift_diff_start_uses_worker_not_conflated_baseline() -> Bool {
  let notified = head_a
  gunbc.session_auto_publish.resolve_drift_diff_start(
    notified_baseline: notified,
    current_head: head_c,
    merge_base_with_origin: v2.std.optional.Present { value: head_main },
    baseline_is_ancestor_of_merge_base: true,
  ) == head_main
    && gunbc.session_auto_publish.resolve_drift_diff_start(
      notified_baseline: notified,
      current_head: head_c,
      merge_base_with_origin: v2.std.optional.Absent,
      baseline_is_ancestor_of_merge_base: false,
    ) == notified
}

test fn red_conflated_baseline_would_start_drift_at_remote_head() -> Bool {
  let state = gunbc.session_auto_publish.after_explicit_publish_push(
    state: gunbc.session_auto_publish.after_user_intent_publish(
      state: gunbc.session_auto_publish.empty_session_publish_state(),
      published_head: head_a,
      at: stamp_one,
    ),
    remote_head: head_b,
  )
  match gunbc.session_auto_publish.worker_notification_baseline(state: state) {
    v2.std.optional.Present { value: worker } =>
      match gunbc.session_auto_publish.conflated_checkpoint_baseline(state: state) {
        v2.std.optional.Present { value: conflated } =>
          gunbc.session_auto_publish.resolve_drift_diff_start(
            notified_baseline: worker,
            current_head: head_c,
            merge_base_with_origin: v2.std.optional.Absent,
            baseline_is_ancestor_of_merge_base: false,
          ) != conflated
        v2.std.optional.Absent => false
      }
    v2.std.optional.Absent => false
  }
}

test fn scratch_probe_permits_local_checkpoint_only() -> Bool {
  gunbc.session_auto_publish.publication_is_permitted(
    disposition: gunbc.session_auto_publish.adjudicate_local_checkpoint(context: gunbc.session_auto_publish.PublicationContextScratchProbe),
  )
    && !gunbc.session_auto_publish.publication_is_permitted(
      disposition: gunbc.session_auto_publish.adjudicate_remote_publication(
        context: gunbc.session_auto_publish.PublicationContextScratchProbe,
        operation: gunbc.session_auto_publish.RemotePushBranch,
      ),
    )
    && !gunbc.session_auto_publish.publication_is_permitted(
      disposition: gunbc.session_auto_publish.adjudicate_remote_publication(
        context: gunbc.session_auto_publish.PublicationContextScratchProbe,
        operation: gunbc.session_auto_publish.RemoteCreatePullRequest,
      ),
    )
}

test fn autosave_permits_local_checkpoint_only() -> Bool {
  gunbc.session_auto_publish.publication_is_permitted(
    disposition: gunbc.session_auto_publish.adjudicate_local_checkpoint(context: gunbc.session_auto_publish.PublicationContextDashboardAutosave),
  )
    && !gunbc.session_auto_publish.publication_is_permitted(
      disposition: gunbc.session_auto_publish.adjudicate_remote_publication(
        context: gunbc.session_auto_publish.PublicationContextDashboardAutosave,
        operation: gunbc.session_auto_publish.RemotePushBranch,
      ),
    )
}

test fn healer_refuses_author_branch_mutation() -> Bool {
  match gunbc.session_auto_publish.adjudicate_remote_publication(
    context: gunbc.session_auto_publish.PublicationContextArtifactHealer {
      repair_target: gunbc.session_auto_publish.HealerRepairTargetAuthorBranch,
    },
    operation: gunbc.session_auto_publish.HealerMutateAuthorBranch,
  ) {
    gunbc.session_auto_publish.PublicationRefuse { cause: gunbc.session_auto_publish.HealerAuthorBranchMutationForbidden } => true
    gunbc.session_auto_publish.PublicationPermit => false
  }
    && gunbc.session_auto_publish.publication_is_permitted(
      disposition: gunbc.session_auto_publish.adjudicate_remote_publication(
        context: gunbc.session_auto_publish.PublicationContextArtifactHealer {
          repair_target: gunbc.session_auto_publish.HealerRepairTargetBotBranch,
        },
        operation: gunbc.session_auto_publish.RemotePushBranch,
      ),
    )
    && match gunbc.session_auto_publish.adjudicate_remote_publication(
      context: gunbc.session_auto_publish.PublicationContextArtifactHealer {
        repair_target: gunbc.session_auto_publish.HealerRepairTargetPatchArtifact,
      },
      operation: gunbc.session_auto_publish.RemotePushBranch,
    ) {
      gunbc.session_auto_publish.PublicationRefuse { cause: gunbc.session_auto_publish.PatchArtifactRemotePublicationForbidden } => true
      gunbc.session_auto_publish.PublicationPermit => false
    }
}

test fn healer_bot_branch_refuses_pr_creation() -> Bool {
  match gunbc.session_auto_publish.adjudicate_remote_publication(
    context: gunbc.session_auto_publish.PublicationContextArtifactHealer {
      repair_target: gunbc.session_auto_publish.HealerRepairTargetBotBranch,
