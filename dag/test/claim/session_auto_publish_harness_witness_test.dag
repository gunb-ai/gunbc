fn ingested_publish_request(head: std.types.CommitSha) -> gunbc.session_auto_publish_ctrl_ingest.PublicationRequest {
  ingest_publication_request_from_ctrl(
    authority: harness_ctrl_publication_ingest_authority(),
    expected_remote_head: head,
    candidate_head: head,
  )
}

fn validation_receipt_for_head(head: std.types.CommitSha, digest: std.content_hash.Fnv1a64Structural) -> gunbc.session_auto_publish.PostWriteValidationReceipt {
  gunbc.session_auto_publish.PostWriteValidationReceipt {
    candidate_head: head,
    declared_write_set_digest: digest,
    actual_write_set_digest: digest,
    parser_revision: "parser-v1",
    formatter_revision: "formatter-v1",
    compiler_revision: "compiler-v1",
    verdict: PostWriteValidationAccepted,
  }
}

fn clean_publish_attempt(head: std.types.CommitSha, paths: List<String>) -> gunbc.session_auto_publish.RemotePublishAttempt {
  let request = ingested_publish_request(head: head)
  let digest = write_digest_a
  gunbc.session_auto_publish.RemotePublishAttempt {
    context: gunbc.session_auto_publish.PublicationContextCtrlUserPublish { request: request },
    operation: RemotePushBranch,
    observed_remote_head: gunbc.session_auto_publish.RemoteHeadKnown { head: head },
    current_remote_head: gunbc.session_auto_publish.RemoteHeadKnown { head: head },
    current_local_head: Present { value: head },
    index_cleanliness: IndexClean,
    unmerged_stage_count: gunbc.session_auto_publish.CountKnown { count: 0 },
    conflict_marker_count: gunbc.session_auto_publish.CountKnown { count: 0 },
    declared_write_paths: paths,
    actual_write_paths: paths,
    post_write_validation: Present {
      value: validation_receipt_for_head(head: head, digest: digest),
    },
    peer_authorship: PeerAuthoredByPublisher,
    equivalent_pre_push: Absent,
  }
}

test fn ingested_request_positive_control_permits_remote_publication() -> Bool {
  publication_is_permitted(
    disposition: admit_remote_publication(
      attempt: clean_publish_attempt(
        head: head_a,
        paths: ["dag/gunbc/session_auto_publish.dag"],
      ),
    ),
  )
}

