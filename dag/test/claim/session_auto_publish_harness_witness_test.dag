test fn dirty_index_refuses_before_remote_write() -> Bool {
  let request = ingested_publish_request(head: head_a)
  match admit_remote_publication(
    attempt: gunbc.session_auto_publish.RemotePublishAttempt {
      context: gunbc.session_auto_publish.PublicationContextCtrlUserPublish { request: request },
      operation: RemotePushBranch,
      observed_remote_head: gunbc.session_auto_publish.RemoteHeadKnown { head: head_a },
      current_remote_head: gunbc.session_auto_publish.RemoteHeadKnown { head: head_a },
      current_local_head: Present { value: head_a },
      index_cleanliness: IndexDirty,
      unmerged_stage_count: gunbc.session_auto_publish.CountKnown { count: 0 },
      conflict_marker_count: gunbc.session_auto_publish.CountKnown { count: 0 },
      declared_write_paths: ["dag/gunbc/session_auto_publish.dag"],
      actual_write_paths: ["dag/gunbc/session_auto_publish.dag"],
      post_write_validation: Present {
        value: validation_receipt_for_head(head: head_a, digest: write_digest_a),
      },
      peer_authorship: PeerAuthoredByPublisher,
      equivalent_pre_push: Absent,
    },
  ) {
    PublicationRefuse { cause: IndexDirtyRefused } => true
    PublicationPermit => false
  }
}

test fn red_patch_artifact_remote_push_would_have_published() -> Bool {
  match adjudicate_remote_publication(
    context: gunbc.session_auto_publish.PublicationContextArtifactHealer {
      repair_target: HealerRepairTargetPatchArtifact,
    },
    operation: RemoteCreatePullRequest,
  ) {
    PublicationRefuse { cause: PatchArtifactRemotePublicationForbidden } => true
    PublicationPermit => false
  }
}

test fn ctrl_user_publish_derives_intent_from_ingested_request_only() -> Bool {
  let request = ingested_publish_request(head: head_a)
  publication_is_permitted(
    disposition: adjudicate_remote_publication(
      context: gunbc.session_auto_publish.PublicationContextCtrlUserPublish { request: request },
      operation: RemotePushBranch,
    ),
  )
    && match admit_remote_publication(
      attempt: clean_publish_attempt(
        head: head_a,
        paths: ["dag/gunbc/session_auto_publish.dag"],
      ),
    ) {
      PublicationPermit => true
      PublicationRefuse { cause: _ } => false
    }
}
