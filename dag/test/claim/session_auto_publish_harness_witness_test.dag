    gunbc.session_auto_publish.PublicationRefuse { cause: gunbc.session_auto_publish.HealerBotBranchOperationForbidden } => true
    gunbc.session_auto_publish.PublicationPermit => false
  }
}

data unknown_context_red_note: String = "Unevaluable publication contexts must refuse remote publication rather than pass — the absorbing fallback in the worst place."

test fn unknown_context_refuses_remote_publication() -> Bool {
  match gunbc.session_auto_publish.adjudicate_remote_publication(
    context: gunbc.session_auto_publish.PublicationContextUnknown,
    operation: gunbc.session_auto_publish.RemotePushBranch,
  ) {
    gunbc.session_auto_publish.PublicationRefuse { cause: gunbc.session_auto_publish.PublicationContextUnknownRefused } => true
    gunbc.session_auto_publish.PublicationPermit => false
  }
    && match gunbc.session_auto_publish.adjudicate_local_checkpoint(context: gunbc.session_auto_publish.PublicationContextUnknown) {
      gunbc.session_auto_publish.PublicationRefuse { cause: gunbc.session_auto_publish.PublicationContextUnknownRefused } => true
      gunbc.session_auto_publish.PublicationPermit => false
    }
}

