      actual_write_paths: ["dag/gunbc/session_auto_publish.dag"],
      post_write_validation: v2.std.optional.Present {
        value: validation_receipt_for_head(head: head_a, digest: write_digest_a),
      },
      peer_authorship: gunbc.session_auto_publish.PeerAuthoredByPublisher,
      equivalent_pre_push: v2.std.optional.Absent,
    },
  ) {
    gunbc.session_auto_publish.PublicationRefuse { cause: gunbc.session_auto_publish.RemoteHeadMovedSinceObservation } => true
    gunbc.session_auto_publish.PublicationPermit => false
  }
}

