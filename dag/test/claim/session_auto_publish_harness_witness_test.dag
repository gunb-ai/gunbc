fn ingested_publish_request(head: std.types.CommitSha) -> gunbc.session_auto_publish_ctrl_ingest.PublicationRequest {
  gunbc.session_auto_publish_ctrl_ingest.ingest_publication_request_from_ctrl(
    authority: gunbc.session_auto_publish_ctrl_ingest.harness_ctrl_publication_ingest_authority(),
    expected_remote_head: head,
    candidate_head: head,
  )
}

fn validation_receipt_for_head(head: std.types.CommitSha, digest: std.content_hash.Fnv1a64Structural) -> gunbc.session_auto_publish.PostWriteValidationReceipt {
  gunbc.session_auto_publish.PostWriteValidationReceipt {
    candidate_head: head,
    declared_write_set_digest: digest,
    actual_write_set_digest: digest,
    parser_revision: "parser-v1",
    formatter_revision: "formatter-v1",
    compiler_revision: "compiler-v1",
    verdict: gunbc.session_auto_publish.PostWriteValidationAccepted,
  }
}

fn clean_publish_attempt(head: std.types.CommitSha, paths: List<String>) -> gunbc.session_auto_publish.RemotePublishAttempt {
  let request = ingested_publish_request(head: head)
  let digest = write_digest_a
  gunbc.session_auto_publish.RemotePublishAttempt {
    context: gunbc.session_auto_publish.PublicationContextCtrlUserPublish { request: request },
    operation: gunbc.session_auto_publish.RemotePushBranch,
    observed_remote_head: gunbc.session_auto_publish.RemoteHeadKnown { head: head },
    current_remote_head: gunbc.session_auto_publish.RemoteHeadKnown { head: head },
    current_local_head: v2.std.optional.Present { value: head },
    index_cleanliness: gunbc.session_auto_publish.IndexClean,
    unmerged_stage_count: gunbc.session_auto_publish.CountKnown { count: 0 },
    conflict_marker_count: gunbc.session_auto_publish.CountKnown { count: 0 },
    declared_write_paths: paths,
    actual_write_paths: paths,
    post_write_validation: v2.std.optional.Present {
      value: validation_receipt_for_head(head: head, digest: digest),
    },
    peer_authorship: gunbc.session_auto_publish.PeerAuthoredByPublisher,
    equivalent_pre_push: v2.std.optional.Absent,
  }
}

test fn ingested_request_positive_control_permits_remote_publication() -> Bool {
  gunbc.session_auto_publish.publication_is_permitted(
    disposition: gunbc.session_auto_publish.admit_remote_publication(
      attempt: clean_publish_attempt(
        head: head_a,
        paths: ["dag/gunbc/session_auto_publish.dag"],
      ),
    ),
  )
}

test fn fixture_uncompilable_tree_refuses_before_remote_write() -> Bool {
  let request = ingested_publish_request(head: head_a)
  match gunbc.session_auto_publish.admit_remote_publication(
    attempt: gunbc.session_auto_publish.RemotePublishAttempt {
      context: gunbc.session_auto_publish.PublicationContextCtrlUserPublish { request: request },
      operation: gunbc.session_auto_publish.RemotePushBranch,
      observed_remote_head: gunbc.session_auto_publish.RemoteHeadKnown { head: head_a },
      current_remote_head: gunbc.session_auto_publish.RemoteHeadKnown { head: head_a },
      current_local_head: v2.std.optional.Present { value: head_a },
      index_cleanliness: gunbc.session_auto_publish.IndexClean,
      unmerged_stage_count: gunbc.session_auto_publish.CountKnown { count: 0 },
      conflict_marker_count: gunbc.session_auto_publish.CountKnown { count: 0 },
      declared_write_paths: ["dag/gunbc/session_auto_publish.dag"],
      actual_write_paths: ["dag/gunbc/session_auto_publish.dag"],
      post_write_validation: v2.std.optional.Present {
        value: gunbc.session_auto_publish.PostWriteValidationReceipt {
          candidate_head: head_a,
          declared_write_set_digest: write_digest_a,
          actual_write_set_digest: write_digest_a,
          parser_revision: "parser-v1",
          formatter_revision: "formatter-v1",
          compiler_revision: "compiler-v1",
          verdict: gunbc.session_auto_publish.PostWriteValidationRejected,
        },
      },
      peer_authorship: gunbc.session_auto_publish.PeerAuthoredByPublisher,
      equivalent_pre_push: v2.std.optional.Absent,
    },
  ) {
    gunbc.session_auto_publish.PublicationRefuse { cause: gunbc.session_auto_publish.PostWriteValidationRejectedRefused } => true
    gunbc.session_auto_publish.PublicationPermit => false
  }
}

