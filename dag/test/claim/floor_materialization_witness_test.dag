test fn frozen_scoped_execution_reds_on_replay_old_frozen_after_new_prepared_tree() -> Bool {
  match prepared_floor_subject_fixture() {
    Absent => false
    Present { value: subject } =>
      match git_sha1_object_id(hex: "1111111111111111111111111111111111111111") {
        Absent => false
        Present { value: new_tree } => {
          let candidates = v1_claim_scoped_witness_batch.entries
          let new_subject = PreparedFloorSubjectIdentity {
            tested_commit: "cccccccccccccccccccccccccccccccccccccccc",
            tested_tree: new_tree,
            tool_identity: subject.tool_identity,
            discovery: subject.discovery,
            root_views: subject.root_views
          }
          match reconcile_frozen_scoped_execution(
            frozen: freeze_scoped_population(
              subject: subject,
              comparison: frozen_scoped_comparison_fixture(subject: subject),
              head_observation: frozen_scoped_head_resolution_fixture(subject: subject),
              candidates: candidates,
              selected: candidates,
              skipped: []
            ),
            subject_observation: FrozenScopedPreparedSubjectObserved {
              subject: new_subject
            },
            execution_identities: candidates
          ) {
            FrozenScopedPopulationRefused {
              cause: FrozenScopedPopulationPreparedSubjectMismatch
            } => true
            _ => false
          }
        }
      }
  }
}

test fn frozen_scoped_population_reds_on_duplicate_candidates_and_selected() -> Bool {
  match prepared_floor_subject_fixture() {
    Absent => false
    Present { value: subject } => {
      let candidates = v1_claim_scoped_witness_batch.entries
      if candidates.count() == 0 {
        false
      } else {
        let duplicate = candidates.first()
        let comparison = frozen_scoped_comparison_fixture(subject: subject)
        let candidate_red = freeze_scoped_population(
          subject: subject,
          comparison: comparison,
          head_observation: frozen_scoped_head_resolution_fixture(subject: subject),
          candidates: [duplicate, duplicate],
          selected: [],
          skipped: []
        )
        let selected_red = freeze_scoped_population(
          subject: subject,
          comparison: comparison,
          head_observation: frozen_scoped_head_resolution_fixture(subject: subject),
          candidates: candidates,
          selected: [duplicate, duplicate],
          skipped: []
        )
        match candidate_red {
          FrozenScopedPopulationRefused {
            cause: FrozenScopedPopulationDuplicateCandidateIdentity
          } => match selected_red {
            FrozenScopedPopulationRefused {
              cause: FrozenScopedPopulationDuplicateSelectedIdentity
            } => true
            _ => false
          }
          _ => false
        }
      }
    }
  }
}

