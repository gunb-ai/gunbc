test fn prepared_floor_subject_identity_is_bound_to_commit_tree_and_tool() -> Bool {
  match prepared_floor_subject_fixture() {
    Absent => false
    Present { value: base } =>
      match git_sha1_object_id(hex: "1111111111111111111111111111111111111111") {
        Absent => false
        Present { value: other_tree } => {
          let changed_commit = PreparedFloorSubjectIdentity {
            tested_commit: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
            tested_tree: base.tested_tree,
            tool_identity: base.tool_identity,
            discovery: base.discovery,
            root_views: base.root_views
          }
          let changed_tree = PreparedFloorSubjectIdentity {
            tested_commit: base.tested_commit,
            tested_tree: other_tree,
            tool_identity: base.tool_identity,
            discovery: base.discovery,
            root_views: base.root_views
          }
          let changed_tool = PreparedFloorSubjectIdentity {
            tested_commit: base.tested_commit,
            tested_tree: base.tested_tree,
            tool_identity: content_hash_atom(value: "different-prepared-floor-tool"),
            discovery: base.discovery,
            root_views: base.root_views
          }
          !content_hash_eq_structural(
            left: prepared_floor_subject_content_identity(subject: base),
            right: prepared_floor_subject_content_identity(subject: changed_commit)
          )
            && !content_hash_eq_structural(
            left: prepared_floor_subject_content_identity(subject: base),
            right: prepared_floor_subject_content_identity(subject: changed_tree)
          )
            && !content_hash_eq_structural(
              left: prepared_floor_subject_content_identity(subject: base),
              right: prepared_floor_subject_content_identity(subject: changed_tool)
            )
        }
      }
  }
}

test fn prepared_floor_subject_identity_changes_with_discovery_and_ordered_root_views() -> Bool {
  match prepared_floor_subject_fixture() {
    Absent => false
    Present { value: base } => {
      let changed_request = PreparedFloorDiscoveryIdentity {
        request_identity: content_hash_atom(value: "different-prepared-floor-request"),
        roster_identity: base.discovery.roster_identity,
        module_graph_facts_identity: base.discovery.module_graph_facts_identity,
        payload_identity: base.discovery.payload_identity
      }
      let changed_roster = PreparedFloorDiscoveryIdentity {
        request_identity: base.discovery.request_identity,
        roster_identity: content_hash_atom(value: "different-prepared-floor-roster"),
        module_graph_facts_identity: base.discovery.module_graph_facts_identity,
        payload_identity: base.discovery.payload_identity
      }
      let changed_facts = PreparedFloorDiscoveryIdentity {
        request_identity: base.discovery.request_identity,
        roster_identity: base.discovery.roster_identity,
        module_graph_facts_identity: content_hash_atom(
          value: "different-prepared-floor-module-graph-facts"
        ),
        payload_identity: base.discovery.payload_identity
      }
      let changed_payload = PreparedFloorDiscoveryIdentity {
        request_identity: base.discovery.request_identity,
        roster_identity: base.discovery.roster_identity,
        module_graph_facts_identity: base.discovery.module_graph_facts_identity,
        payload_identity: content_hash_atom(value: "different-prepared-floor-payload")
      }
      let changed_root_views = PreparedFloorOrderedRootViewsIdentity {
        walk_source_roots: ["src/v2", "dag"],
        scoped_source_roots: base.root_views.scoped_source_roots
      }
      let changed_discovery_subject = PreparedFloorSubjectIdentity {
        tested_commit: base.tested_commit,
        tested_tree: base.tested_tree,
        tool_identity: base.tool_identity,
        discovery: changed_payload,
        root_views: base.root_views
      }
      let changed_root_views_subject = PreparedFloorSubjectIdentity {
        tested_commit: base.tested_commit,
        tested_tree: base.tested_tree,
        tool_identity: base.tool_identity,
        discovery: base.discovery,
        root_views: changed_root_views
      }
      !content_hash_eq_structural(
        left: prepared_floor_discovery_content_identity(discovery: base.discovery),
        right: prepared_floor_discovery_content_identity(discovery: changed_request)
      )
        && !content_hash_eq_structural(
          left: prepared_floor_discovery_content_identity(discovery: base.discovery),
          right: prepared_floor_discovery_content_identity(discovery: changed_roster)
        )
        && !content_hash_eq_structural(
          left: prepared_floor_discovery_content_identity(discovery: base.discovery),
          right: prepared_floor_discovery_content_identity(discovery: changed_facts)
        )
        && !content_hash_eq_structural(
          left: prepared_floor_discovery_content_identity(discovery: base.discovery),
          right: prepared_floor_discovery_content_identity(discovery: changed_payload)
        )
        && !content_hash_eq_structural(
          left: prepared_floor_ordered_root_views_content_identity(
            root_views: base.root_views
          ),
          right: prepared_floor_ordered_root_views_content_identity(
            root_views: changed_root_views
          )
        )
        && !content_hash_eq_structural(
          left: prepared_floor_subject_content_identity(subject: base),
          right: prepared_floor_subject_content_identity(subject: changed_discovery_subject)
        )
        && !content_hash_eq_structural(
          left: prepared_floor_subject_content_identity(subject: base),
          right: prepared_floor_subject_content_identity(subject: changed_root_views_subject)
        )
    }
  }
}

test fn prepared_floor_subject_is_shared_by_reference_across_both_populations() -> Bool {
  match prepared_floor_subject_fixture() {
    Absent => false
    Present { value: subject } => value_verdict_is_shared_by_reference(
      v: floor_prepared_subject_materialization(subject: subject),
      identity: floor_prepared_subject_value_identity(subject: subject),
      provider_id: floor_prepared_subject_share_provider_id,
      reader_count: floor_prepared_subject_reader_count()
    ) && (floor_prepared_subject_reader_count() == 2)
  }
}

test fn prepared_floor_subject_missing_provider_refuses_and_cannot_initialize() -> Bool {
  match prepared_floor_subject_fixture() {
    Absent => false
    Present { value: subject } => {
      let missing = floor_prepared_subject_materialization_without_provider(subject: subject)
      value_verdict_is_refused_needing_reference(
        v: missing,
        identity: floor_prepared_subject_value_identity(subject: subject)
        )
        && match prepared_floor_initialize(
          subject: subject,
          materialization: missing
        ) {
          PreparedFloorPhaseRefused {
            subject: _,
            cause: PreparedFloorReferenceProviderUnavailable
          } => true
          _ => false
        }
    }
  }
}

test fn prepared_floor_root_views_keep_exact_ordered_universes_on_one_subject() -> Bool {
  match prepared_floor_subject_fixture() {
    Absent => false
    Present { value: subject } => {
      let walk = prepared_floor_walk_root_view(subject: subject)
      let scoped = prepared_floor_scoped_root_view(subject: subject)
      let same_roots_subject = PreparedFloorSubjectIdentity {
          tested_commit: subject.tested_commit,
          tested_tree: subject.tested_tree,
          tool_identity: subject.tool_identity,
          discovery: subject.discovery,
          root_views: PreparedFloorOrderedRootViewsIdentity {
            walk_source_roots: witness_layer_roots,
            scoped_source_roots: witness_layer_roots
          }
        }
      let reordered_walk_subject = PreparedFloorSubjectIdentity {
          tested_commit: subject.tested_commit,
          tested_tree: subject.tested_tree,
          tool_identity: subject.tool_identity,
          discovery: subject.discovery,
          root_views: PreparedFloorOrderedRootViewsIdentity {
            walk_source_roots: ["src/v2", "dag"],
            scoped_source_roots: v1_claim_scoped_witness_batch.source_roots
          }
        }
      prepared_floor_subject_identity_eq(
        left: prepared_floor_root_view_subject(view: walk),
        right: prepared_floor_root_view_subject(view: scoped)
      )
        && (prepared_floor_root_view_source_roots(view: walk) == witness_layer_roots)
        && (prepared_floor_root_view_source_roots(view: scoped) == ["dag", "src/v1"])
        && content_hash_eq_structural(
          left: prepared_floor_root_view_source_roots_digest(view: walk),
          right: scoped_witness_source_roots_digest(source_roots: witness_layer_roots)
        )
        && content_hash_eq_structural(
          left: prepared_floor_root_view_source_roots_digest(view: scoped),
          right: scoped_witness_source_roots_digest(
            source_roots: v1_claim_scoped_witness_batch.source_roots
          )
        )
        && !prepared_floor_root_view_identity_eq(
          left: prepared_floor_walk_root_view(subject: same_roots_subject),
          right: prepared_floor_scoped_root_view(subject: same_roots_subject)
        )
        && !prepared_floor_root_view_identity_eq(
          left: walk,
          right: prepared_floor_walk_root_view(subject: reordered_walk_subject)
        )
    }
  }
}

fn frozen_scoped_comparison_fixture(
  subject: PreparedFloorSubjectIdentity
) -> FloorDiffComparisonReadout {
  DirectComparison {
    base: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
    head: "HEAD",
    kind: ExactReplayBaseline
  }
}

fn frozen_scoped_head_resolution_fixture(
  subject: PreparedFloorSubjectIdentity
) -> FrozenScopedComparisonHeadObservation {
  FrozenScopedComparisonHeadResolved {
    selected_head: "HEAD",
    observed_commit: subject.tested_commit
  }
}

fn reverse_scoped_identities(
  identities: List<ScheduleWitnessEntry>
) -> List<ScheduleWitnessEntry> {
  identities.reverse()
}

test fn frozen_scoped_population_binds_postselection_and_preserves_execution_order() -> Bool {
  match prepared_floor_subject_fixture() {
    Absent => false
    Present { value: subject } => {
      let candidates = v1_claim_scoped_witness_batch.entries
      if candidates.count() == 0 {
        false
      } else {
        let selected = candidates.skip(n: 1)
        let skipped = [candidates.first()]
        let frozen = freeze_scoped_population(
          subject: subject,
          comparison: frozen_scoped_comparison_fixture(subject: subject),
          head_observation: frozen_scoped_head_resolution_fixture(subject: subject),
          candidates: candidates,
          selected: selected,
          skipped: skipped
        )
        match reconcile_frozen_scoped_execution(
          frozen: frozen,
          subject_observation: FrozenScopedPreparedSubjectObserved { subject: subject },
          execution_identities: reverse_scoped_identities(identities: selected)
        ) {
          FrozenScopedPopulationPostselection {
            subject: frozen_subject,
            comparison: comparison,
            head_observation: frozen_head_observation,
            candidates: frozen_candidates,
            selected: frozen_selected,
            skipped: frozen_skipped
          } =>
            prepared_floor_subject_identity_eq(left: frozen_subject, right: subject)
              && schedule_witness_entry_list_eq(left: frozen_candidates, right: candidates)
              && schedule_witness_entry_list_eq(left: frozen_selected, right: selected)
              && schedule_witness_entry_list_eq(left: frozen_skipped, right: skipped)
              && match comparison {
                DirectComparison { base: _, head: head, kind: _ } =>
                  (head == "HEAD")
                    && match frozen_head_observation {
                      FrozenScopedComparisonHeadResolved {
                        selected_head: selected_head,
                        observed_commit: observed_commit
                      } =>
                        (selected_head == "HEAD")
                          && (observed_commit == subject.tested_commit)
                      _ => false
                    }
                _ => false
              }
          _ => false
        }
      }
    }
  }
}

test fn frozen_scoped_population_reds_on_comparison_refusal() -> Bool {
  match prepared_floor_subject_fixture() {
    Absent => false
    Present { value: subject } => match freeze_scoped_population(
