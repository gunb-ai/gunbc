test fn prepared_floor_scoped_scratch_requires_ordinary_scratch_release() -> Bool {
  match prepared_floor_subject_fixture() {
    Absent => false
    Present { value: subject } => {
      let initialized = prepared_floor_initialize(
        subject: subject,
        materialization: floor_prepared_subject_materialization(subject: subject)
      )
      let ordinary = prepared_floor_begin_ordinary(
        phase: initialized,
        scratch: prepared_floor_ordinary_scratch_fixture(subject: subject)
      )
      let premature_scoped = prepared_floor_begin_scoped(
        phase: ordinary,
        scratch: prepared_floor_scoped_scratch_fixture(subject: subject)
      )
      let released = prepared_floor_release_ordinary(phase: ordinary)
      let scoped = prepared_floor_begin_scoped(
        phase: released,
        scratch: prepared_floor_scoped_scratch_fixture(subject: subject)
      )
      match ordinary {
        PreparedFloorOrdinaryScratchActive {
          subject: ordinary_subject,
          scratch: ordinary_scratch
        } =>
          match premature_scoped {
            PreparedFloorPhaseRefused {
              subject: _,
              cause: PreparedFloorScopedScratchStartedBeforeOrdinaryRelease
            } => match released {
              PreparedFloorOrdinaryScratchReleased {
                subject: _,
                released_scratch: _
              } => match scoped {
                PreparedFloorScopedScratchActive {
                  subject: scoped_subject,
                  scratch: scoped_scratch
                } =>
                  prepared_floor_subject_identity_eq(
                    left: ordinary_subject,
                    right: scoped_subject
                  )
                    && (ordinary_scratch.identity != scoped_scratch.identity)
                _ => false
              }
              _ => false
            }
            _ => false
          }
        _ => false
      }
    }
  }
}


test fn prepared_floor_same_scratch_identity_refuses_scoped_activation() -> Bool {
  match prepared_floor_subject_fixture() {
    Absent => false
    Present { value: subject } => {
      let initialized = prepared_floor_initialize(
        subject: subject,
        materialization: floor_prepared_subject_materialization(subject: subject)
      )
      let ordinary = prepared_floor_begin_ordinary(
        phase: initialized,
        scratch: prepared_floor_ordinary_scratch_fixture(subject: subject)
      )
      let released = prepared_floor_release_ordinary(phase: ordinary)
      match prepared_floor_begin_scoped(
        phase: released,
        scratch: prepared_floor_reused_scoped_scratch_fixture(subject: subject)
      ) {
        PreparedFloorPhaseRefused {
          subject: _,
          cause: PreparedFloorScopedScratchIdentityReused
        } => true
        _ => false
      }
    }
  }
}
