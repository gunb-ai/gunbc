      comparison: ComparisonReadoutRefused { reason: "fixture refusal" },
      head_observation: frozen_scoped_head_resolution_fixture(subject: subject),
      candidates: v1_claim_scoped_witness_batch.entries,
      selected: v1_claim_scoped_witness_batch.entries,
      skipped: []
    ) {
      FrozenScopedPopulationRefused {
        cause: FrozenScopedPopulationComparisonRefused
      } => true
      _ => false
    }
  }
}

