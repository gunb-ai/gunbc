module test.claim.witness_row_cost_drift


data witness_row_cost_drift_note: String = "Executing consumer for the per-witness cost drift comparator (gunbc.witness_row_cost, placement #5 spine). THE PAIR IS THE PROOF: a synthetic row exceeding 2× its dated basis MUST produce DriftExceeded, and one within basis MUST NOT — either alone is satisfiable by a broken comparator. BasisAbsent is a third arm: no dated basis is typed and counted, never assume fine. Structural claims only here — every ms basis value in production rows must cite an arm64 fleet run id (witness_row_cost_basis_host_class_note). Consumers match WitnessRowCostVerdict directly (no Bool predicate dissolution). THE CROSS-CLOCK PAIR IS THE DISCRIMINATING CONTROL for the clock-basis wall (operator ruling 2026-08-05), and it takes TWO cases rather than one because a single case is satisfiable by a comparator that happens to be answering DriftExceeded for the wrong reason: 21 CPU against a 10 wall basis would exceed the 2x ratio and 20 CPU against the same basis would not, so the pair asserts that the SAME refusal arrives on both sides of the threshold and therefore that the refusal is decided by the clock rather than by the magnitude. Before this wall both cases returned a confident verdict about two different quantities."

fn dated_basis(clock: std.measure.ClockBasis, eval_ms: std.nat.Nat, run_ref: String) -> gunbc.witness_row_cost.WitnessRowCostDatedBasis {
  gunbc.witness_row_cost.WitnessRowCostDatedBasis {
    clock: clock,
    eval: std.measure.millisecond(count: eval_ms),
    run_ref: run_ref,
  }
}

fn drift_red_control_exceeds_basis_holds() -> Bool {
  let v = gunbc.witness_row_cost.witness_row_cost_verdict(
    observed: std.measure.millisecond(count: 21),
    observed_clock: std.measure.WallClock,
    basis: v2.std.optional.Present { value: dated_basis(clock: std.measure.WallClock, eval_ms: 10, run_ref: "synthetic-red") },
  )
  match v {
    gunbc.witness_row_cost.DriftExceeded { observed: o, basis: b } =>
      std.measure.millisecond_count(m: o) == 21 && std.measure.millisecond_count(m: b) == 10
    gunbc.witness_row_cost.WithinBasis => false
    gunbc.witness_row_cost.BasisAbsent => false
    gunbc.witness_row_cost.BasisClockMismatch { observed: _, basis: _ } => false
  }
}

fn within_basis_control_does_not_drift_holds() -> Bool {
  let v = gunbc.witness_row_cost.witness_row_cost_verdict(
    observed: std.measure.millisecond(count: 20),
    observed_clock: std.measure.WallClock,
    basis: v2.std.optional.Present { value: dated_basis(clock: std.measure.WallClock, eval_ms: 10, run_ref: "synthetic-within") },
  )
  match v {
    gunbc.witness_row_cost.WithinBasis => true
    gunbc.witness_row_cost.DriftExceeded { observed: _, basis: _ } => false
    gunbc.witness_row_cost.BasisAbsent => false
    gunbc.witness_row_cost.BasisClockMismatch { observed: _, basis: _ } => false
  }
}

fn basis_absent_control_holds() -> Bool {
  let v = gunbc.witness_row_cost.witness_row_cost_verdict(
    observed: std.measure.millisecond(count: 999),
    observed_clock: std.measure.WallClock,
    basis: v2.std.optional.Absent,
  )
  match v {
    gunbc.witness_row_cost.BasisAbsent => true
    gunbc.witness_row_cost.WithinBasis => false
    gunbc.witness_row_cost.DriftExceeded { observed: _, basis: _ } => false
    gunbc.witness_row_cost.BasisClockMismatch { observed: _, basis: _ } => false
  }
}

fn cross_clock_comparison_refuses_rather_than_answering_holds() -> Bool {
  let v = gunbc.witness_row_cost.witness_row_cost_verdict(
    observed: std.measure.millisecond(count: 21),
    observed_clock: std.measure.CpuClock,
    basis: v2.std.optional.Present { value: dated_basis(clock: std.measure.WallClock, eval_ms: 10, run_ref: "synthetic-cross-clock") },
  )
  match v {
    gunbc.witness_row_cost.BasisClockMismatch { observed: o, basis: b } =>
      std.measure.clock_basis_eq(a: o, b: std.measure.CpuClock) && std.measure.clock_basis_eq(a: b, b: std.measure.WallClock)
    gunbc.witness_row_cost.DriftExceeded { observed: _, basis: _ } => false
    gunbc.witness_row_cost.WithinBasis => false
    gunbc.witness_row_cost.BasisAbsent => false
  }
}

fn cross_clock_refusal_is_not_reachable_by_the_within_arm_holds() -> Bool {
  let v = gunbc.witness_row_cost.witness_row_cost_verdict(
    observed: std.measure.millisecond(count: 20),
    observed_clock: std.measure.CpuClock,
    basis: v2.std.optional.Present { value: dated_basis(clock: std.measure.WallClock, eval_ms: 10, run_ref: "synthetic-cross-clock-within") },
  )
  match v {
    gunbc.witness_row_cost.BasisClockMismatch { observed: _, basis: _ } => true
    gunbc.witness_row_cost.WithinBasis => false
    gunbc.witness_row_cost.DriftExceeded { observed: _, basis: _ } => false
    gunbc.witness_row_cost.BasisAbsent => false
  }
}

fn boundary_at_exactly_twice_is_not_drift_holds() -> Bool {
  !gunbc.witness_row_cost.witness_row_cost_exceeds_basis(
    observed: std.measure.millisecond(count: 20),
    basis: std.measure.millisecond(count: 10),
  )
}

test fn witness_row_cost_drift_comparator_holds() -> Bool {
  drift_red_control_exceeds_basis_holds()
    && within_basis_control_does_not_drift_holds()
    && basis_absent_control_holds()
    && boundary_at_exactly_twice_is_not_drift_holds()
    && cross_clock_comparison_refuses_rather_than_answering_holds()
    && cross_clock_refusal_is_not_reachable_by_the_within_arm_holds()
}
