module test.claim.witness_row_cost_drift

import gunbc.witness_row_cost {
  BasisAbsent,
  DriftExceeded,
  WithinBasis,
  WitnessRowCostDatedBasis,
  witness_row_cost_exceeds_basis,
  witness_row_cost_verdict,
}
import std.logic { Bool }
import std.nat { Nat }
import std.measure { millisecond, millisecond_count }
import v2.std.optional { Absent, Present }
import v2.std.text { String }

data witness_row_cost_drift_note: String = "Executing consumer for the per-witness cost drift comparator (gunbc.witness_row_cost, placement #5 spine). THE PAIR IS THE PROOF: a synthetic row exceeding 2× its dated basis MUST produce DriftExceeded, and one within basis MUST NOT — either alone is satisfiable by a broken comparator. BasisAbsent is a third arm: no dated basis is typed and counted, never assume fine. Structural claims only here — every ms basis value in production rows must cite an arm64 fleet run id (witness_row_cost_basis_host_class_note). Consumers match WitnessRowCostVerdict directly (no Bool predicate dissolution)."

fn dated_basis(eval_ms: Nat, run_ref: String) -> WitnessRowCostDatedBasis {
  WitnessRowCostDatedBasis {
    eval: millisecond(count: eval_ms),
    run_ref: run_ref,
  }
}

fn drift_red_control_exceeds_basis_holds() -> Bool {
  let v = witness_row_cost_verdict(
    observed: millisecond(count: 21),
    basis: Present { value: dated_basis(eval_ms: 10, run_ref: "synthetic-red") },
  )
  match v {
    DriftExceeded { observed: o, basis: b } =>
      millisecond_count(m: o) == 21 && millisecond_count(m: b) == 10
    WithinBasis => false
    BasisAbsent => false
  }
}

fn within_basis_control_does_not_drift_holds() -> Bool {
  let v = witness_row_cost_verdict(
    observed: millisecond(count: 20),
    basis: Present { value: dated_basis(eval_ms: 10, run_ref: "synthetic-within") },
  )
  match v {
    WithinBasis => true
    DriftExceeded { observed: _, basis: _ } => false
    BasisAbsent => false
  }
}

fn basis_absent_control_holds() -> Bool {
  let v = witness_row_cost_verdict(
    observed: millisecond(count: 999),
    basis: Absent,
  )
  match v {
    BasisAbsent => true
    WithinBasis => false
    DriftExceeded { observed: _, basis: _ } => false
  }
}

fn boundary_at_exactly_twice_is_not_drift_holds() -> Bool {
  !witness_row_cost_exceeds_basis(
    observed: millisecond(count: 20),
    basis: millisecond(count: 10),
  )
}

test fn witness_row_cost_drift_comparator_holds() -> Bool {
  drift_red_control_exceeds_basis_holds()
    && within_basis_control_does_not_drift_holds()
    && basis_absent_control_holds()
    && boundary_at_exactly_twice_is_not_drift_holds()
}
