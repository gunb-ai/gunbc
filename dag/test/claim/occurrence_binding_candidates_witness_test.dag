test fn reference_derived_dependency_projection_preserves_provenance_and_collapses_files_holds() -> Bool {
  match test.fixture.cross_file_clause_e_fixture.cross_file_clause_e_fixture_assembled_closure() {
    std.occurrence_binding_candidates.AssembledCrossFileBindingClosureReady {
      transport: transport,
      inputs: inputs,
      module_files: module_file_rows,
      consumer_file: _,
    } =>
      match std.occurrence_binding_candidates.structural_binding_walk(transport: transport, inputs: inputs) {
        std.occurrence_binding_candidates.StructuralBindingWalkReady { population: population } =>
      match std.occurrence_binding_candidates.module_path_file_index_from_rows(rows: module_file_rows) {
        std.occurrence_binding_candidates.ModulePathFileIndexReady { entries: module_files } =>
          match std.occurrence_binding_candidates.reference_derived_dependency_projection(
            population: population,
            module_files: module_files,
          ) {
            std.occurrence_binding_candidates.ReferenceDerivedDependencyProjectionReady {
              binding_provenance: provenances,
              file_dependencies: file_dependencies,
              bound_population: _,
            } =>
              (provenances |> count) == 2 && (file_dependencies |> count) == 1
            _ => false
          }
        std.occurrence_binding_candidates.ModulePathFileIndexRefused { refusal: _ } => false
      }
        _ => false
      }
    std.occurrence_binding_candidates.AssembledCrossFileBindingClosureRefused { refusal: _ } => false
  }
}

