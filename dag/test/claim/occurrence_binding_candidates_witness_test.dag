data occurrence_binding_candidates_witness_raw_containment_not_parallel_note: String = "Fail-closed RED (PR 7515 blocker 1): a declaration whose containment is a prefix of the reference but whose DeclarationExposure is ModuleExposure for a DIFFERENT module must NOT bind via raw containment. Exposure carrier alone decides — missing/wrong ModuleExposure is not rescued by declaration.containment."

test fn raw_containment_without_matching_exposure_does_not_bind_holds() -> Bool {
  let nested_decl = std.occurrence_identity.OccurrenceId { value: 10 }
  let outer_fn = std.occurrence_identity.OccurrenceId { value: 20 }
  let call_ref = std.occurrence_identity.OccurrenceId { value: 30 }
  let nested_path = obc_fixture_path(ancestors: [], terminal: nested_decl)
  let call_ref_path = obc_fixture_path(ancestors: [nested_decl, outer_fn], terminal: call_ref)
  let transport = std.occurrence_identity.OccurrenceTransport {
    index: std.occurrence_identity.OccurrenceIndex {
      entries: [
        obc_fixture_index_entry(occurrence: nested_decl, authored_name: "fn_a", containment: nested_path),
        obc_fixture_index_entry(occurrence: outer_fn, authored_name: "fn_b", containment: obc_fixture_path(ancestors: [nested_decl], terminal: outer_fn)),
        obc_fixture_index_entry(occurrence: call_ref, authored_name: "fn_a", containment: call_ref_path),
      ],
    },
    declarations: [
      obc_fixture_declaration(occurrence: nested_decl, containment: nested_path, category: std.occurrence_identity.CallableOccurrence),
      obc_fixture_declaration(occurrence: outer_fn, containment: obc_fixture_path(ancestors: [nested_decl], terminal: outer_fn), category: std.occurrence_identity.CallableOccurrence),
    ],
    references: [
      obc_fixture_reference(occurrence: call_ref, containment: call_ref_path, category: std.occurrence_identity.CallableOccurrence),
    ],
  }
  match std.occurrence_binding_candidates.resolve_reference_binding_via_structural_candidates(
    transport: transport,
    inputs: obc_fixture_inputs(
      module_paths: [
        std.occurrence_binding_candidates.OccurrenceModulePathRow { occurrence: nested_decl, module_path: obc_module_path(dotted: "app.other_module") },
        std.occurrence_binding_candidates.OccurrenceModulePathRow { occurrence: outer_fn, module_path: obc_module_path(dotted: "app.sibling_module") },
        std.occurrence_binding_candidates.OccurrenceModulePathRow { occurrence: call_ref, module_path: obc_module_path(dotted: "app.sibling_module") },
      ],
      exposure_rows: [
        obc_module_exposure(occurrence: nested_decl, module: "app.other_module"),
        obc_module_exposure(occurrence: outer_fn, module: "app.sibling_module"),
      ],
      authored_order_rows: [
        obc_authored_order(occurrence: nested_decl),
        obc_authored_order(occurrence: outer_fn),
        obc_authored_order(occurrence: call_ref),
      ],
    ),
    reference: obc_fixture_reference(
      occurrence: call_ref,
      containment: call_ref_path,
      category: std.occurrence_identity.CallableOccurrence,
    ),
  ) {
    std.occurrence_binding_candidates.ReferenceBindingProjectionUnbound { occurrence: unbound } => unbound.value == 30
    _ => false
  }
}

data occurrence_binding_candidates_witness_root_exposure_note: String = "RootExposure authority control: a declaration carrying RootExposure binds on every candidate lookup regardless of containment ancestry or module siblinghood — visibility comes from RootExposure's own semantics, not raw containment."

test fn root_exposure_is_visible_holds() -> Bool {
  let root_decl = std.occurrence_identity.OccurrenceId { value: 10 }
  let call_ref = std.occurrence_identity.OccurrenceId { value: 30 }
  let root_path = obc_fixture_path(ancestors: [], terminal: root_decl)
  let call_ref_path = obc_fixture_path(ancestors: [std.occurrence_identity.OccurrenceId { value: 20 }], terminal: call_ref)
  match std.occurrence_binding_candidates.resolve_reference_binding_via_structural_candidates(
    transport: std.occurrence_identity.OccurrenceTransport {
      index: std.occurrence_identity.OccurrenceIndex {
        entries: [
          obc_fixture_index_entry(occurrence: root_decl, authored_name: "root_fn", containment: root_path),
          obc_fixture_index_entry(occurrence: call_ref, authored_name: "root_fn", containment: call_ref_path),
        ],
      },
      declarations: [
        obc_fixture_declaration(occurrence: root_decl, containment: root_path, category: std.occurrence_identity.CallableOccurrence),
      ],
      references: [
        obc_fixture_reference(occurrence: call_ref, containment: call_ref_path, category: std.occurrence_identity.CallableOccurrence),
      ],
    },
    inputs: obc_fixture_inputs(
      module_paths: [
        std.occurrence_binding_candidates.OccurrenceModulePathRow { occurrence: root_decl, module_path: obc_module_path(dotted: "app.root_module") },
        std.occurrence_binding_candidates.OccurrenceModulePathRow { occurrence: call_ref, module_path: obc_module_path(dotted: "app.other_module") },
      ],
      exposure_rows: [
        obc_root_exposure(occurrence: root_decl),
      ],
      authored_order_rows: [
        obc_authored_order(occurrence: root_decl),
        obc_authored_order(occurrence: call_ref),
      ],
    ),
    reference: obc_fixture_reference(
      occurrence: call_ref,
      containment: call_ref_path,
      category: std.occurrence_identity.CallableOccurrence,
    ),
  ) {
    std.occurrence_binding_candidates.ReferenceBindingProjectionBound { provider: provider } =>
      provider.declaration_occurrence.value == 10
        && provider.reference_occurrence.value == 30
    _ => false
  }
}

data occurrence_binding_candidates_witness_declarations_by_name_refuse_note: String = "Fail-closed RED (operator finding 3): declarations_by_name_build refuses MissingDeclarationIndexEntry when a declaration is absent from entries_by_id — never silent-skips and shrinks the candidate population."

test fn declarations_by_name_missing_index_entry_refuses_holds() -> Bool {
  let decl = std.occurrence_identity.OccurrenceId { value: 10 }
  let decl_path = obc_fixture_path(ancestors: [], terminal: decl)
  match std.occurrence_binding_candidates.declarations_by_name_build(
    entries_by_id: empty_map(),
    declarations: [
      obc_fixture_declaration(occurrence: decl, containment: decl_path, category: std.occurrence_identity.CallableOccurrence),
    ],
  ) {
    std.occurrence_binding_candidates.DeclarationsByNameMissingIndexEntry { occurrence: missing } => missing.value == 10
    std.occurrence_binding_candidates.DeclarationsByNameReady { by_name: _ } => false
  }
}

data section13_fixture_head: std.types.CommitSha = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

fn obc_section13_observation(decl_name: String, passed: Bool) -> std.occurrence_binding_candidates.Section13ExactHeadExecutionObservation {
  std.occurrence_binding_candidates.Section13ExactHeadExecutionObservation {
    head: section13_fixture_head,
    declaration: std.occurrence_binding_candidates.section13_executing_receipt(
      module_path: std.occurrence_binding_candidates.section13_witness_module_path(),
      decl_name: decl_name as std.types.NonEmptyStr,
    ),
    passed: passed,
  }
}

fn obc_section13_joined_observations() -> List<std.occurrence_binding_candidates.Section13ExactHeadExecutionObservation> {
  [
    obc_section13_observation(decl_name: "module_scope_sibling_is_visible_holds", passed: true),
    obc_section13_observation(decl_name: "sibling_match_arm_not_visible_holds", passed: true),
    obc_section13_observation(decl_name: "nested_lexical_only_inside_scope_holds", passed: true),
    obc_section13_observation(decl_name: "declaration_below_occurrence_not_visible_holds", passed: true),
    obc_section13_observation(decl_name: "same_text_distinct_identities_is_ambiguous_holds", passed: true),
  ]
}

data occurrence_binding_candidates_witness_section13_join_note: String = "Section-13 denominator: Executing rows join to exact-head observations (symbolic DeclarationRef module paths). GREEN supplies passed=true observations for every Executing receipt. RED controls: missing observation and failed observation refuse — inhabiting Section13PopulationLawExecuting alone never greens."

test fn witness_section13_population_law_roster_denominator_holds() -> Bool {
  std.occurrence_binding_candidates.section13_population_law_roster_denominator_holds(
    observations: obc_section13_joined_observations(),
    required_head: section13_fixture_head,
  )
}

test fn section13_missing_observation_refuses_holds() -> Bool {
  match std.occurrence_binding_candidates.section13_population_law_roster_adjudicate(
    observations: [
      obc_section13_observation(decl_name: "module_scope_sibling_is_visible_holds", passed: true),
      obc_section13_observation(decl_name: "sibling_match_arm_not_visible_holds", passed: true),
      obc_section13_observation(decl_name: "nested_lexical_only_inside_scope_holds", passed: true),
      obc_section13_observation(decl_name: "declaration_below_occurrence_not_visible_holds", passed: true),
    ],
    required_head: section13_fixture_head,
  ) {
    std.occurrence_binding_candidates.Section13PopulationLawRosterRefusedMissingObservation { receipt: receipt } =>
      receipt.decl_name == ("same_text_distinct_identities_is_ambiguous_holds" as std.types.NonEmptyStr)
    _ => false
  }
}

test fn section13_failed_observation_refuses_holds() -> Bool {
  match std.occurrence_binding_candidates.section13_population_law_roster_adjudicate(
    observations: [
      obc_section13_observation(decl_name: "module_scope_sibling_is_visible_holds", passed: true),
      obc_section13_observation(decl_name: "sibling_match_arm_not_visible_holds", passed: true),
      obc_section13_observation(decl_name: "nested_lexical_only_inside_scope_holds", passed: true),
      obc_section13_observation(decl_name: "declaration_below_occurrence_not_visible_holds", passed: true),
      obc_section13_observation(decl_name: "same_text_distinct_identities_is_ambiguous_holds", passed: false),
    ],
    required_head: section13_fixture_head,
  ) {
    std.occurrence_binding_candidates.Section13PopulationLawRosterRefusedFailedOrStaleObservation { receipt: receipt } =>
      receipt.decl_name == ("same_text_distinct_identities_is_ambiguous_holds" as std.types.NonEmptyStr)
    std.occurrence_binding_candidates.Section13PopulationLawRosterHolds => false
    _ => false
  }
}
