module test.claim.occurrence_binding_candidates_witness_test


fn obc_module_path(dotted: String) -> std.types.NonEmptyStr {
  dotted as std.types.NonEmptyStr
}

fn obc_same_module(left: std.types.NonEmptyStr, right: std.types.NonEmptyStr) -> Bool {
  left == right
}

fn obc_edge_matches(
  edge: std.occurrence_binding_candidates.DirectModuleDependency,
  consumer: String,
  provider: String
) -> Bool {
  obc_same_module(left: edge.consumer_module, right: obc_module_path(dotted: consumer))
    && obc_same_module(left: edge.provider_module, right: obc_module_path(dotted: provider))
}

fn obc_authored_order(occurrence: std.occurrence_identity.OccurrenceId) -> std.occurrence_binding_candidates.AuthoredOrderRow {
  std.occurrence_binding_candidates.AuthoredOrderRow {
    occurrence: occurrence,
    ordinal: std.occurrence_identity.AuthoredTokenOrdinal { value: occurrence.value },
  }
}

fn obc_module_exposure(occurrence: std.occurrence_identity.OccurrenceId, module: String) -> std.occurrence_binding_candidates.DeclarationExposureRow {
  std.occurrence_binding_candidates.DeclarationExposureRow {
    occurrence: occurrence,
    exposure: std.occurrence_binding_candidates.ModuleExposure { module: obc_module_path(dotted: module) },
  }
}

fn obc_lexical_exposure(
  occurrence: std.occurrence_identity.OccurrenceId,
  scope: std.occurrence_identity.OccurrenceContainmentPath
) -> std.occurrence_binding_candidates.DeclarationExposureRow {
  std.occurrence_binding_candidates.DeclarationExposureRow {
    occurrence: occurrence,
    exposure: std.occurrence_binding_candidates.LexicalExposure { exposing_scope: scope },
  }
}

fn obc_root_exposure(occurrence: std.occurrence_identity.OccurrenceId) -> std.occurrence_binding_candidates.DeclarationExposureRow {
  std.occurrence_binding_candidates.DeclarationExposureRow {
    occurrence: occurrence,
    exposure: std.occurrence_binding_candidates.RootExposure,
  }
}

fn obc_fixture_inputs(
  module_paths: List<std.occurrence_binding_candidates.OccurrenceModulePathRow>,
  exposure_rows: List<std.occurrence_binding_candidates.DeclarationExposureRow>,
  authored_order_rows: List<std.occurrence_binding_candidates.AuthoredOrderRow>
) -> std.occurrence_binding_candidates.OccurrenceBindingCandidateInputs {
  std.occurrence_binding_candidates.OccurrenceBindingCandidateInputs {
    module_paths: module_paths,
    exposure_rows: exposure_rows,
    authored_order_rows: authored_order_rows,
  }
}

fn obc_fixture_span(file: String, start: Int, end: Int) -> std.types.SourceSpan {
  std.types.SourceSpan { file: file, start: start, end: end }
}

fn obc_fixture_path(
  ancestors: List<std.occurrence_identity.OccurrenceId>,
  terminal: std.occurrence_identity.OccurrenceId
) -> std.occurrence_identity.OccurrenceContainmentPath {
  std.occurrence_identity.OccurrenceContainmentPath {
    ancestors: ancestors,
    terminal: terminal,
  }
}

fn obc_fixture_index_entry(
  occurrence: std.occurrence_identity.OccurrenceId,
  authored_name: String,
  containment: std.occurrence_identity.OccurrenceContainmentPath
) -> std.occurrence_identity.OccurrenceIndexEntry {
  std.occurrence_identity.OccurrenceIndexEntry {
    projection: std.occurrence_identity.OccurrenceProjection {
      occurrence: occurrence,
      authored_name: authored_name,
      diagnostic_span: obc_fixture_span(file: "fixture.dag", start: 0, end: 1),
    },
    containment: containment,
  }
}

fn obc_fixture_declaration(
  occurrence: std.occurrence_identity.OccurrenceId,
  containment: std.occurrence_identity.OccurrenceContainmentPath,
  category: std.occurrence_identity.OccurrenceCategory
) -> std.occurrence_identity.DeclarationOccurrence {
  std.occurrence_identity.DeclarationOccurrence {
    occurrence: occurrence,
    containment: containment,
    category: category,
    diagnostic_span: obc_fixture_span(file: "fixture.dag", start: 0, end: 1),
  }
}

fn obc_fixture_reference(
  occurrence: std.occurrence_identity.OccurrenceId,
  containment: std.occurrence_identity.OccurrenceContainmentPath,
  category: std.occurrence_identity.OccurrenceCategory
) -> std.occurrence_identity.ReferenceOccurrence {
  std.occurrence_identity.ReferenceOccurrence {
    occurrence: occurrence,
    containment: containment,
    category: category,
    diagnostic_span: obc_fixture_span(file: "fixture.dag", start: 0, end: 1),
  }
}

data occurrence_binding_candidates_witness_module_note: String = "Module rule 1 fixture: two module-level functions declared as direct siblings (neither's occurrence id is an ancestor of the other's body) inside one module. fn_a = 10, fn_b's call-site reference to fn_a = 30, both rows carrying module_path \"app.sibling_module\". The reference's own containment ancestors are just fn_b's own occurrence (20) -- there is no lexical nesting between fn_a and the reference at all, so occurrence_containment_path_is_prefix_of alone can never expose fn_a to it; only the module-sibling rule can."

fn obc_module_sibling_transport() -> std.occurrence_identity.OccurrenceTransport {
  let fn_a = std.occurrence_identity.OccurrenceId { value: 10 }
  let fn_b = std.occurrence_identity.OccurrenceId { value: 20 }
  let call_ref = std.occurrence_identity.OccurrenceId { value: 30 }
  let fn_a_path = obc_fixture_path(ancestors: [], terminal: fn_a)
  let fn_b_path = obc_fixture_path(ancestors: [], terminal: fn_b)
  let call_ref_path = obc_fixture_path(ancestors: [fn_b], terminal: call_ref)
  std.occurrence_identity.OccurrenceTransport {
    index: std.occurrence_identity.OccurrenceIndex {
      entries: [
        obc_fixture_index_entry(occurrence: fn_a, authored_name: "fn_a", containment: fn_a_path),
        obc_fixture_index_entry(occurrence: fn_b, authored_name: "fn_b", containment: fn_b_path),
        obc_fixture_index_entry(occurrence: call_ref, authored_name: "fn_a", containment: call_ref_path),
      ],
    },
    declarations: [
      obc_fixture_declaration(occurrence: fn_a, containment: fn_a_path, category: std.occurrence_identity.CallableOccurrence),
      obc_fixture_declaration(occurrence: fn_b, containment: fn_b_path, category: std.occurrence_identity.CallableOccurrence),
    ],
    references: [
      obc_fixture_reference(occurrence: call_ref, containment: call_ref_path, category: std.occurrence_identity.CallableOccurrence),
    ],
  }
}

fn obc_module_sibling_module_paths() -> List<std.occurrence_binding_candidates.OccurrenceModulePathRow> {
  [
    std.occurrence_binding_candidates.OccurrenceModulePathRow { occurrence: std.occurrence_identity.OccurrenceId { value: 10 }, module_path: obc_module_path(dotted: "app.sibling_module") },
    std.occurrence_binding_candidates.OccurrenceModulePathRow { occurrence: std.occurrence_identity.OccurrenceId { value: 20 }, module_path: obc_module_path(dotted: "app.sibling_module") },
    std.occurrence_binding_candidates.OccurrenceModulePathRow { occurrence: std.occurrence_identity.OccurrenceId { value: 30 }, module_path: obc_module_path(dotted: "app.sibling_module") },
  ]
}

fn obc_module_sibling_inputs() -> std.occurrence_binding_candidates.OccurrenceBindingCandidateInputs {
  obc_fixture_inputs(
    module_paths: obc_module_sibling_module_paths(),
    exposure_rows: [
      obc_module_exposure(occurrence: std.occurrence_identity.OccurrenceId { value: 10 }, module: "app.sibling_module"),
      obc_module_exposure(occurrence: std.occurrence_identity.OccurrenceId { value: 20 }, module: "app.sibling_module"),
    ],
    authored_order_rows: [
      obc_authored_order(occurrence: std.occurrence_identity.OccurrenceId { value: 10 }),
      obc_authored_order(occurrence: std.occurrence_identity.OccurrenceId { value: 20 }),
      obc_authored_order(occurrence: std.occurrence_identity.OccurrenceId { value: 30 }),
    ],
  )
}

test fn module_scope_sibling_is_visible_holds() -> Bool {
  match std.occurrence_binding_candidates.resolve_reference_binding_via_structural_candidates(
    transport: obc_module_sibling_transport(),
    inputs: obc_module_sibling_inputs(),
    reference: obc_fixture_reference(
      occurrence: std.occurrence_identity.OccurrenceId { value: 30 },
      containment: obc_fixture_path(ancestors: [std.occurrence_identity.OccurrenceId { value: 20 }], terminal: std.occurrence_identity.OccurrenceId { value: 30 }),
      category: std.occurrence_identity.CallableOccurrence,
    ),
  ) {
    std.occurrence_binding_candidates.ReferenceBindingProjectionBound { provider: provider } =>
      provider.declaration_occurrence.value == 10
        && provider.reference_occurrence.value == 30
        && obc_same_module(left: provider.consumer_module, right: obc_module_path(dotted: "app.sibling_module"))
        && obc_same_module(left: provider.provider_module, right: obc_module_path(dotted: "app.sibling_module"))
    _ => false
  }
}

data occurrence_binding_candidates_witness_sibling_arm_note: String = "Rule 2 fixture: match arm 1 binds pattern variable y at occurrence 11 under containment ancestors [1, 2] (module=1, arm1=2); arm 2 binds a distinct y at occurrence 12 under ancestors [1, 3] (arm2=3) and its body references y at occurrence 21 under ancestors [1, 3, 12] (nested inside arm2's own pattern scope). Both binders are LexicalValueOccurrence, so the module-sibling rule never admits either; only occurrence 12 is a genuine containment ancestor of the reference, so occurrence 11 (the sibling arm's binder) must never appear in the exposed population despite identical spelling."

fn obc_sibling_arm_transport() -> std.occurrence_identity.OccurrenceTransport {
  let module_id = std.occurrence_identity.OccurrenceId { value: 1 }
  let arm1 = std.occurrence_identity.OccurrenceId { value: 2 }
  let arm2 = std.occurrence_identity.OccurrenceId { value: 3 }
  let arm1_y = std.occurrence_identity.OccurrenceId { value: 11 }
  let arm2_y = std.occurrence_identity.OccurrenceId { value: 12 }
  let arm2_ref = std.occurrence_identity.OccurrenceId { value: 21 }
  let arm1_y_path = obc_fixture_path(ancestors: [module_id, arm1], terminal: arm1_y)
  let arm2_y_path = obc_fixture_path(ancestors: [module_id, arm2], terminal: arm2_y)
  let arm2_ref_path = obc_fixture_path(ancestors: [module_id, arm2, arm2_y], terminal: arm2_ref)
  std.occurrence_identity.OccurrenceTransport {
    index: std.occurrence_identity.OccurrenceIndex {
      entries: [
        obc_fixture_index_entry(occurrence: arm1_y, authored_name: "y", containment: arm1_y_path),
        obc_fixture_index_entry(occurrence: arm2_y, authored_name: "y", containment: arm2_y_path),
        obc_fixture_index_entry(occurrence: arm2_ref, authored_name: "y", containment: arm2_ref_path),
      ],
    },
    declarations: [
      obc_fixture_declaration(occurrence: arm1_y, containment: arm1_y_path, category: std.occurrence_identity.LexicalValueOccurrence),
      obc_fixture_declaration(occurrence: arm2_y, containment: arm2_y_path, category: std.occurrence_identity.LexicalValueOccurrence),
    ],
    references: [
      obc_fixture_reference(occurrence: arm2_ref, containment: arm2_ref_path, category: std.occurrence_identity.LexicalValueOccurrence),
    ],
  }
}

fn obc_sibling_arm_module_paths() -> List<std.occurrence_binding_candidates.OccurrenceModulePathRow> {
  [
    std.occurrence_binding_candidates.OccurrenceModulePathRow { occurrence: std.occurrence_identity.OccurrenceId { value: 11 }, module_path: obc_module_path(dotted: "app.match_module") },
    std.occurrence_binding_candidates.OccurrenceModulePathRow { occurrence: std.occurrence_identity.OccurrenceId { value: 12 }, module_path: obc_module_path(dotted: "app.match_module") },
    std.occurrence_binding_candidates.OccurrenceModulePathRow { occurrence: std.occurrence_identity.OccurrenceId { value: 21 }, module_path: obc_module_path(dotted: "app.match_module") },
  ]
}

fn obc_sibling_arm_inputs() -> std.occurrence_binding_candidates.OccurrenceBindingCandidateInputs {
  let arm1_y_path = obc_fixture_path(
    ancestors: [std.occurrence_identity.OccurrenceId { value: 1 }, std.occurrence_identity.OccurrenceId { value: 2 }],
    terminal: std.occurrence_identity.OccurrenceId { value: 11 },
  )
  let arm2_y_path = obc_fixture_path(
    ancestors: [std.occurrence_identity.OccurrenceId { value: 1 }, std.occurrence_identity.OccurrenceId { value: 3 }],
    terminal: std.occurrence_identity.OccurrenceId { value: 12 },
  )
  obc_fixture_inputs(
    module_paths: obc_sibling_arm_module_paths(),
    exposure_rows: [
      obc_lexical_exposure(occurrence: std.occurrence_identity.OccurrenceId { value: 11 }, scope: arm1_y_path),
      obc_lexical_exposure(occurrence: std.occurrence_identity.OccurrenceId { value: 12 }, scope: arm2_y_path),
    ],
    authored_order_rows: [
      obc_authored_order(occurrence: std.occurrence_identity.OccurrenceId { value: 11 }),
      obc_authored_order(occurrence: std.occurrence_identity.OccurrenceId { value: 12 }),
      obc_authored_order(occurrence: std.occurrence_identity.OccurrenceId { value: 21 }),
    ],
  )
}

test fn sibling_match_arm_not_visible_holds() -> Bool {
  match std.occurrence_binding_candidates.resolve_reference_binding_via_structural_candidates(
    transport: obc_sibling_arm_transport(),
    inputs: obc_sibling_arm_inputs(),
    reference: obc_fixture_reference(
      occurrence: std.occurrence_identity.OccurrenceId { value: 21 },
      containment: obc_fixture_path(
        ancestors: [std.occurrence_identity.OccurrenceId { value: 1 }, std.occurrence_identity.OccurrenceId { value: 3 }, std.occurrence_identity.OccurrenceId { value: 12 }],
        terminal: std.occurrence_identity.OccurrenceId { value: 21 },
      ),
      category: std.occurrence_identity.LexicalValueOccurrence,
    ),
  ) {
    std.occurrence_binding_candidates.ReferenceBindingProjectionBound { provider: provider } =>
      provider.declaration_occurrence.value == 12
    _ => false
  }
}

data occurrence_binding_candidates_witness_nested_lexical_note: String = "Rule 3 fixture: a let binder x at occurrence 41 nests a body under it (ancestors include 41); a reference to x sitting OUTSIDE that let's subtree (occurrence 51, ancestors just [module]) must see zero candidates -- containment enclosure only reaches descendants of the let, never siblings of it, and x's LexicalValueOccurrence category earns it no module-sibling exposure either."

fn obc_nested_lexical_transport() -> std.occurrence_identity.OccurrenceTransport {
  let module_id = std.occurrence_identity.OccurrenceId { value: 4 }
  let let_x = std.occurrence_identity.OccurrenceId { value: 41 }
  let outside_ref = std.occurrence_identity.OccurrenceId { value: 51 }
  let let_x_path = obc_fixture_path(ancestors: [module_id], terminal: let_x)
  let outside_ref_path = obc_fixture_path(ancestors: [module_id], terminal: outside_ref)
  std.occurrence_identity.OccurrenceTransport {
    index: std.occurrence_identity.OccurrenceIndex {
      entries: [
        obc_fixture_index_entry(occurrence: let_x, authored_name: "x", containment: let_x_path),
        obc_fixture_index_entry(occurrence: outside_ref, authored_name: "x", containment: outside_ref_path),
      ],
    },
    declarations: [
      obc_fixture_declaration(occurrence: let_x, containment: let_x_path, category: std.occurrence_identity.LexicalValueOccurrence),
    ],
    references: [
      obc_fixture_reference(occurrence: outside_ref, containment: outside_ref_path, category: std.occurrence_identity.LexicalValueOccurrence),
    ],
  }
}

fn obc_nested_lexical_module_paths() -> List<std.occurrence_binding_candidates.OccurrenceModulePathRow> {
  [
    std.occurrence_binding_candidates.OccurrenceModulePathRow { occurrence: std.occurrence_identity.OccurrenceId { value: 41 }, module_path: obc_module_path(dotted: "app.block_module") },
    std.occurrence_binding_candidates.OccurrenceModulePathRow { occurrence: std.occurrence_identity.OccurrenceId { value: 51 }, module_path: obc_module_path(dotted: "app.block_module") },
  ]
}

fn obc_nested_lexical_inputs() -> std.occurrence_binding_candidates.OccurrenceBindingCandidateInputs {
  let let_x_path = obc_fixture_path(
    ancestors: [std.occurrence_identity.OccurrenceId { value: 4 }],
    terminal: std.occurrence_identity.OccurrenceId { value: 41 },
  )
  obc_fixture_inputs(
    module_paths: obc_nested_lexical_module_paths(),
    exposure_rows: [
      obc_lexical_exposure(occurrence: std.occurrence_identity.OccurrenceId { value: 41 }, scope: let_x_path),
    ],
    authored_order_rows: [
      obc_authored_order(occurrence: std.occurrence_identity.OccurrenceId { value: 41 }),
      obc_authored_order(occurrence: std.occurrence_identity.OccurrenceId { value: 51 }),
    ],
  )
}

test fn nested_lexical_only_inside_scope_holds() -> Bool {
  match std.occurrence_binding_candidates.resolve_reference_binding_via_structural_candidates(
    transport: obc_nested_lexical_transport(),
    inputs: obc_nested_lexical_inputs(),
    reference: obc_fixture_reference(
      occurrence: std.occurrence_identity.OccurrenceId { value: 51 },
      containment: obc_fixture_path(ancestors: [std.occurrence_identity.OccurrenceId { value: 4 }], terminal: std.occurrence_identity.OccurrenceId { value: 51 }),
      category: std.occurrence_identity.LexicalValueOccurrence,
    ),
  ) {
    std.occurrence_binding_candidates.ReferenceBindingProjectionUnbound { occurrence: unbound } => unbound.value == 51
    _ => false
  }
}

data occurrence_binding_candidates_witness_source_order_note: String = "Rule 4 fixture: fn_later is declared AFTER the reference in authored source order (ordinal 70 > ordinal 60), both ModuleExposure in the same module. AuthoredTokenOrdinal comparison must keep fn_later out of the candidate population even when it is otherwise an eligible module sibling, so the reference is Unbound."

fn obc_source_order_inputs() -> std.occurrence_binding_candidates.OccurrenceBindingCandidateInputs {
  obc_fixture_inputs(
    module_paths: obc_source_order_module_paths(),
    exposure_rows: [
      obc_module_exposure(occurrence: std.occurrence_identity.OccurrenceId { value: 70 }, module: "app.order_module"),
    ],
    authored_order_rows: [
      obc_authored_order(occurrence: std.occurrence_identity.OccurrenceId { value: 60 }),
      obc_authored_order(occurrence: std.occurrence_identity.OccurrenceId { value: 70 }),
    ],
  )
}

fn obc_source_order_transport() -> std.occurrence_identity.OccurrenceTransport {
  let call_ref = std.occurrence_identity.OccurrenceId { value: 60 }
  let fn_later = std.occurrence_identity.OccurrenceId { value: 70 }
  let call_ref_path = obc_fixture_path(ancestors: [], terminal: call_ref)
  let fn_later_path = obc_fixture_path(ancestors: [], terminal: fn_later)
  std.occurrence_identity.OccurrenceTransport {
    index: std.occurrence_identity.OccurrenceIndex {
      entries: [
        obc_fixture_index_entry(occurrence: call_ref, authored_name: "fn_later", containment: call_ref_path),
        obc_fixture_index_entry(occurrence: fn_later, authored_name: "fn_later", containment: fn_later_path),
      ],
    },
    declarations: [
      obc_fixture_declaration(occurrence: fn_later, containment: fn_later_path, category: std.occurrence_identity.CallableOccurrence),
    ],
    references: [
      obc_fixture_reference(occurrence: call_ref, containment: call_ref_path, category: std.occurrence_identity.CallableOccurrence),
    ],
  }
}

fn obc_source_order_module_paths() -> List<std.occurrence_binding_candidates.OccurrenceModulePathRow> {
  [
    std.occurrence_binding_candidates.OccurrenceModulePathRow { occurrence: std.occurrence_identity.OccurrenceId { value: 60 }, module_path: obc_module_path(dotted: "app.order_module") },
    std.occurrence_binding_candidates.OccurrenceModulePathRow { occurrence: std.occurrence_identity.OccurrenceId { value: 70 }, module_path: obc_module_path(dotted: "app.order_module") },
  ]
}

test fn declaration_below_occurrence_not_visible_holds() -> Bool {
  match std.occurrence_binding_candidates.resolve_reference_binding_via_structural_candidates(
    transport: obc_source_order_transport(),
    inputs: obc_source_order_inputs(),
    reference: obc_fixture_reference(
      occurrence: std.occurrence_identity.OccurrenceId { value: 60 },
      containment: obc_fixture_path(ancestors: [], terminal: std.occurrence_identity.OccurrenceId { value: 60 }),
      category: std.occurrence_identity.CallableOccurrence,
    ),
  ) {
    std.occurrence_binding_candidates.ReferenceBindingProjectionUnbound { occurrence: unbound } => unbound.value == 60
    _ => false
  }
}

data occurrence_binding_candidates_witness_ambiguous_note: String = "Rule 5 fixture: two distinct module-level CallableOccurrence declarations named helper (occurrence 80 and 81), both declared before the reference (occurrence 90) in the same module. Same authored spelling must never collapse to one candidate -- the producer supplies both distinct OccurrenceIds and P1's fold reports OccurrenceAmbiguous."

fn obc_ambiguous_transport() -> std.occurrence_identity.OccurrenceTransport {
  let helper_a = std.occurrence_identity.OccurrenceId { value: 80 }
  let helper_b = std.occurrence_identity.OccurrenceId { value: 81 }
  let call_ref = std.occurrence_identity.OccurrenceId { value: 90 }
  let helper_a_path = obc_fixture_path(ancestors: [], terminal: helper_a)
  let helper_b_path = obc_fixture_path(ancestors: [], terminal: helper_b)
  let call_ref_path = obc_fixture_path(ancestors: [], terminal: call_ref)
  std.occurrence_identity.OccurrenceTransport {
    index: std.occurrence_identity.OccurrenceIndex {
      entries: [
        obc_fixture_index_entry(occurrence: helper_a, authored_name: "helper", containment: helper_a_path),
        obc_fixture_index_entry(occurrence: helper_b, authored_name: "helper", containment: helper_b_path),
        obc_fixture_index_entry(occurrence: call_ref, authored_name: "helper", containment: call_ref_path),
      ],
    },
    declarations: [
      obc_fixture_declaration(occurrence: helper_a, containment: helper_a_path, category: std.occurrence_identity.CallableOccurrence),
      obc_fixture_declaration(occurrence: helper_b, containment: helper_b_path, category: std.occurrence_identity.CallableOccurrence),
    ],
    references: [
      obc_fixture_reference(occurrence: call_ref, containment: call_ref_path, category: std.occurrence_identity.CallableOccurrence),
    ],
  }
}

fn obc_ambiguous_module_paths() -> List<std.occurrence_binding_candidates.OccurrenceModulePathRow> {
  [
    std.occurrence_binding_candidates.OccurrenceModulePathRow { occurrence: std.occurrence_identity.OccurrenceId { value: 80 }, module_path: obc_module_path(dotted: "app.ambiguous_module") },
    std.occurrence_binding_candidates.OccurrenceModulePathRow { occurrence: std.occurrence_identity.OccurrenceId { value: 81 }, module_path: obc_module_path(dotted: "app.ambiguous_module") },
    std.occurrence_binding_candidates.OccurrenceModulePathRow { occurrence: std.occurrence_identity.OccurrenceId { value: 90 }, module_path: obc_module_path(dotted: "app.ambiguous_module") },
  ]
}

fn obc_ambiguous_inputs() -> std.occurrence_binding_candidates.OccurrenceBindingCandidateInputs {
  obc_fixture_inputs(
    module_paths: obc_ambiguous_module_paths(),
    exposure_rows: [
      obc_module_exposure(occurrence: std.occurrence_identity.OccurrenceId { value: 80 }, module: "app.ambiguous_module"),
      obc_module_exposure(occurrence: std.occurrence_identity.OccurrenceId { value: 81 }, module: "app.ambiguous_module"),
    ],
    authored_order_rows: [
      obc_authored_order(occurrence: std.occurrence_identity.OccurrenceId { value: 80 }),
      obc_authored_order(occurrence: std.occurrence_identity.OccurrenceId { value: 81 }),
      obc_authored_order(occurrence: std.occurrence_identity.OccurrenceId { value: 90 }),
    ],
  )
}

test fn same_text_distinct_identities_is_ambiguous_holds() -> Bool {
  match std.occurrence_binding_candidates.resolve_reference_binding_via_structural_candidates(
    transport: obc_ambiguous_transport(),
    inputs: obc_ambiguous_inputs(),
    reference: obc_fixture_reference(
      occurrence: std.occurrence_identity.OccurrenceId { value: 90 },
      containment: obc_fixture_path(ancestors: [], terminal: std.occurrence_identity.OccurrenceId { value: 90 }),
      category: std.occurrence_identity.CallableOccurrence,
    ),
  ) {
    std.occurrence_binding_candidates.ReferenceBindingProjectionAmbiguous { occurrence: ambiguous } => ambiguous.value == 90
    _ => false
  }
}

data occurrence_binding_candidates_witness_production_note: String = "Production control: an ordinary two-function module (gunbc.example.greeter) where greet() calls format_greeting() declared earlier in the same file -- the exact shape the pre-strip prefix-only bug rejected. No authored import list participates; the candidate producer resolves the call purely from structural sibling exposure plus source order, and the resulting BoundReferenceProvider/DirectModuleDependency projections are asserted directly."

fn obc_production_transport() -> std.occurrence_identity.OccurrenceTransport {
  let format_greeting = std.occurrence_identity.OccurrenceId { value: 100 }
  let greet = std.occurrence_identity.OccurrenceId { value: 101 }
  let call_ref = std.occurrence_identity.OccurrenceId { value: 110 }
  let format_greeting_path = obc_fixture_path(ancestors: [], terminal: format_greeting)
  let greet_path = obc_fixture_path(ancestors: [], terminal: greet)
  let call_ref_path = obc_fixture_path(ancestors: [greet], terminal: call_ref)
  std.occurrence_identity.OccurrenceTransport {
    index: std.occurrence_identity.OccurrenceIndex {
      entries: [
        obc_fixture_index_entry(occurrence: format_greeting, authored_name: "format_greeting", containment: format_greeting_path),
        obc_fixture_index_entry(occurrence: greet, authored_name: "greet", containment: greet_path),
        obc_fixture_index_entry(occurrence: call_ref, authored_name: "format_greeting", containment: call_ref_path),
      ],
    },
    declarations: [
      obc_fixture_declaration(occurrence: format_greeting, containment: format_greeting_path, category: std.occurrence_identity.CallableOccurrence),
      obc_fixture_declaration(occurrence: greet, containment: greet_path, category: std.occurrence_identity.CallableOccurrence),
    ],
    references: [
      obc_fixture_reference(occurrence: call_ref, containment: call_ref_path, category: std.occurrence_identity.CallableOccurrence),
    ],
  }
}

fn obc_production_module_paths() -> List<std.occurrence_binding_candidates.OccurrenceModulePathRow> {
  [
    std.occurrence_binding_candidates.OccurrenceModulePathRow { occurrence: std.occurrence_identity.OccurrenceId { value: 100 }, module_path: obc_module_path(dotted: "gunbc.example.greeter") },
    std.occurrence_binding_candidates.OccurrenceModulePathRow { occurrence: std.occurrence_identity.OccurrenceId { value: 101 }, module_path: obc_module_path(dotted: "gunbc.example.greeter") },
    std.occurrence_binding_candidates.OccurrenceModulePathRow { occurrence: std.occurrence_identity.OccurrenceId { value: 110 }, module_path: obc_module_path(dotted: "gunbc.example.greeter") },
  ]
}

fn obc_production_inputs() -> std.occurrence_binding_candidates.OccurrenceBindingCandidateInputs {
  obc_fixture_inputs(
    module_paths: obc_production_module_paths(),
    exposure_rows: [
      obc_module_exposure(occurrence: std.occurrence_identity.OccurrenceId { value: 100 }, module: "gunbc.example.greeter"),
      obc_module_exposure(occurrence: std.occurrence_identity.OccurrenceId { value: 101 }, module: "gunbc.example.greeter"),
    ],
    authored_order_rows: [
      obc_authored_order(occurrence: std.occurrence_identity.OccurrenceId { value: 100 }),
      obc_authored_order(occurrence: std.occurrence_identity.OccurrenceId { value: 101 }),
      obc_authored_order(occurrence: std.occurrence_identity.OccurrenceId { value: 110 }),
    ],
  )
}

test fn production_module_call_to_earlier_sibling_binds_holds() -> Bool {
  match std.occurrence_binding_candidates.resolve_reference_binding_via_structural_candidates(
    transport: obc_production_transport(),
    inputs: obc_production_inputs(),
    reference: obc_fixture_reference(
      occurrence: std.occurrence_identity.OccurrenceId { value: 110 },
      containment: obc_fixture_path(ancestors: [std.occurrence_identity.OccurrenceId { value: 101 }], terminal: std.occurrence_identity.OccurrenceId { value: 110 }),
      category: std.occurrence_identity.CallableOccurrence,
    ),
  ) {
    std.occurrence_binding_candidates.ReferenceBindingProjectionBound { provider: provider } =>
      provider.reference_occurrence.value == 110
        && provider.declaration_occurrence.value == 100
        && obc_same_module(left: provider.consumer_module, right: obc_module_path(dotted: "gunbc.example.greeter"))
        && obc_same_module(left: provider.provider_module, right: obc_module_path(dotted: "gunbc.example.greeter"))
    _ => false
  }
}

data occurrence_binding_candidates_witness_dependency_order_note: String = "RED control: direct_module_dependencies_from_bound_population must preserve first-seen provider-traversal order for cross-module edges and must project NO same-module self-edge (BoundReferenceProvider retained; M→M omitted). A hash-ordered map readback would permute the cross-module list and turn the witness red."

test fn direct_module_dependency_dedupes_by_module_pair_holds() -> Bool {
  let same_module_provider = std.occurrence_binding_candidates.BoundReferenceProvider {
    reference_occurrence: std.occurrence_identity.OccurrenceId { value: 110 },
    declaration_occurrence: std.occurrence_identity.OccurrenceId { value: 100 },
    consumer_module: obc_module_path(dotted: "gunbc.example.greeter"),
    provider_module: obc_module_path(dotted: "gunbc.example.greeter"),
  }
  let cross_module_provider_one = std.occurrence_binding_candidates.BoundReferenceProvider {
    reference_occurrence: std.occurrence_identity.OccurrenceId { value: 200 },
    declaration_occurrence: std.occurrence_identity.OccurrenceId { value: 300 },
    consumer_module: obc_module_path(dotted: "app.consumer"),
    provider_module: obc_module_path(dotted: "app.provider"),
  }
  let cross_module_provider_two = std.occurrence_binding_candidates.BoundReferenceProvider {
    reference_occurrence: std.occurrence_identity.OccurrenceId { value: 201 },
    declaration_occurrence: std.occurrence_identity.OccurrenceId { value: 300 },
    consumer_module: obc_module_path(dotted: "app.consumer"),
    provider_module: obc_module_path(dotted: "app.provider"),
  }
  let edges = match std.occurrence_binding_candidates.direct_module_dependencies_from_bound_population(
    population: std.occurrence_binding_candidates.AllReferencesBound {
      providers: [same_module_provider, cross_module_provider_one, cross_module_provider_two],
    },
  ) {
    std.occurrence_binding_candidates.DirectModuleDependencyListReady { edges: edges } => edges
    _ => []
  }
  (edges |> count) == 1
    && match edges |> first {
      Present { value: edge } => obc_edge_matches(edge: edge, consumer: "app.consumer", provider: "app.provider")
      Absent => false
    }
}

data occurrence_binding_candidates_witness_refused_population_never_empty_edges_note: String = "Blocker-3 residual RED (PR 7515): a ReferencePopulationRefused population must project as DirectModuleDependencyPopulationRefused — never DirectModuleDependencyListReady with an empty edge list. Empty edges are reachable only from AllReferencesBound with zero cross-module providers."

test fn refused_population_never_projects_empty_edge_list_holds() -> Bool {
  match std.occurrence_binding_candidates.direct_module_dependencies_from_bound_population(
