      },
      more_failures: [],
    },
  ) {
    std.occurrence_binding_candidates.DirectModuleDependencyPopulationRefused { population: _ } => true
    std.occurrence_binding_candidates.DirectModuleDependencyListReady { edges: _ } => false
  }
}

data occurrence_binding_candidates_witness_file_dependency_note: String = "Clause (e) projection law: repeated cross-file BoundReferenceProvider rows for one provider module collapse to one provider-file dependency for the consumer file. Same-file self-edges are omitted from the projection."

test fn repeated_cross_file_mentions_collapse_provider_file_holds() -> Bool {
  let provider_one = std.occurrence_binding_candidates.BoundReferenceProvider {
    reference_occurrence: std.occurrence_identity.OccurrenceId { value: 200 },
    declaration_occurrence: std.occurrence_identity.OccurrenceId { value: 300 },
    consumer_module: obc_module_path(dotted: "app.consumer"),
    provider_module: obc_module_path(dotted: "app.provider"),
  }
  let provider_two = std.occurrence_binding_candidates.BoundReferenceProvider {
    reference_occurrence: std.occurrence_identity.OccurrenceId { value: 201 },
    declaration_occurrence: std.occurrence_identity.OccurrenceId { value: 300 },
    consumer_module: obc_module_path(dotted: "app.consumer"),
    provider_module: obc_module_path(dotted: "app.provider"),
  }
  let module_file_index = std.occurrence_binding_candidates.module_path_file_index_from_rows(rows: [
    std.occurrence_binding_candidates.ModulePathFileRow {
      module_path: obc_module_path(dotted: "app.consumer"),
      file_path: "dag/app/consumer.dag",
    },
    std.occurrence_binding_candidates.ModulePathFileRow {
      module_path: obc_module_path(dotted: "app.provider"),
      file_path: "dag/app/provider.dag",
    },
  ])
  match module_file_index {
    std.occurrence_binding_candidates.ModulePathFileIndexReady { entries: module_files } =>
      match std.occurrence_binding_candidates.reference_derived_provider_files_for_consumer(
        population: std.occurrence_binding_candidates.AllReferencesBound { providers: [provider_one, provider_two] },
        module_files: module_files,
        consumer_file: "dag/app/consumer.dag",
      ) {
        std.occurrence_binding_candidates.ReferenceDerivedProviderFileProjectionReady { provider_files: provider_files } =>
          (provider_files |> count) == 1
            && match provider_files |> first {
              Present { value: provider_file } => provider_file == "dag/app/provider.dag"
              Absent => false
            }
        _ => false
      }
    std.occurrence_binding_candidates.ModulePathFileIndexRefused { refusal: _ } => false
  }
}

