module test.claim.html_emit_witness


data live_tree_disposition: LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn sample_button() -> std.markup.MarkupNode {
  std.markup.ElementNode {
    tag: "button",
    attrs: [ std.markup.MarkupAttr { name: "class", value: "primary" } ],
    children: [ std.markup.TextNode { text: "Go" } ],
  }
}

fn witness_html_emit_reduces_and_serializes() -> Bool {
  match extdeps.languages.html.try_serialize_html_source(node: sample_button()) {
    extdeps.languages.html.EmitOk { html: h } => h == "<button class=\"primary\">Go</button>"
    extdeps.languages.html.EmitRejected { reason: _ } => false
  }
}

fn witness_html_emit_matches_markup_fold() -> Bool {
  match extdeps.languages.html.try_serialize_html_source(node: sample_button()) {
    extdeps.languages.html.EmitOk { html: h } => h == extdeps.languages.html.serialize_markup_node(node: sample_button())
    extdeps.languages.html.EmitRejected { reason: _ } => false
  }
}

fn hostile_javascript_href() -> std.markup.MarkupNode {
  std.markup.ElementNode {
    tag: "a",
    attrs: [ std.markup.MarkupAttr { name: "href", value: "javascript:alert(1)" } ],
    children: [ std.markup.TextNode { text: "click" } ],
  }
}

fn hostile_data_href() -> std.markup.MarkupNode {
  std.markup.ElementNode {
    tag: "a",
    attrs: [ std.markup.MarkupAttr { name: "href", value: "data:text/html,<script>alert(1)</script>" } ],
    children: [],
  }
}

fn witness_javascript_reject_discriminates_from_char_escape() -> Bool {
  match extdeps.languages.html.try_serialize_html_source(node: hostile_javascript_href()) {
    extdeps.languages.html.EmitRejected { reason: _ } => {
      let unchecked = extdeps.languages.html.serialize_markup_node(node: hostile_javascript_href())
      unchecked == "<a href=\"javascript:alert(1)\">click</a>"
    }
    extdeps.languages.html.EmitOk { html: _ } => false
  }
}

fn witness_data_reject_discriminates_from_char_escape() -> Bool {
  match extdeps.languages.html.try_serialize_html_source(node: hostile_data_href()) {
    extdeps.languages.html.EmitRejected { reason: _ } => {
      let unchecked = extdeps.languages.html.serialize_markup_node(node: hostile_data_href())
      unchecked.starts_with(prefix: "<a href=\"data:")
    }
    extdeps.languages.html.EmitOk { html: _ } => false
  }
}

fn witness_serialize_rejects_javascript_href() -> Bool {
  match extdeps.languages.html.try_serialize_html_source(node: hostile_javascript_href()) {
    extdeps.languages.html.EmitRejected { reason: u } =>
      u == "javascript:alert(1)"
    extdeps.languages.html.EmitOk { html: _ } => false
  }
}

fn witness_serialize_rejects_data_href() -> Bool {
  match extdeps.languages.html.try_serialize_html_source(node: hostile_data_href()) {
    extdeps.languages.html.EmitRejected { reason: u } =>
      u.starts_with(prefix: "data:")
    extdeps.languages.html.EmitOk { html: _ } => false
  }
}

fn witness_http_href_serializes() -> Bool {
  match extdeps.languages.html.try_serialize_html_source(
    node: std.markup.ElementNode {
      tag: "a",
      attrs: [ std.markup.MarkupAttr { name: "href", value: "https://gunbc.dev" } ],
      children: [ std.markup.TextNode { text: "home" } ],
    }
  ) {
    extdeps.languages.html.EmitOk { html: h } => h == "<a href=\"https://gunbc.dev\">home</a>"
    extdeps.languages.html.EmitRejected { reason: _ } => false
  }
}

fn trusted_relative_link() -> std.markup.MarkupNode {
  std.markup.ElementNode {
    tag: "a",
    attrs: [ std.markup.MarkupAttr { name: "href", value: "/tree/dag" } ],
    children: [ std.markup.TextNode { text: "dag" } ],
  }
}

fn req_a_hostile_but_trusted_scheme() -> std.markup.MarkupNode {
  std.markup.ElementNode {
    tag: "a",
    attrs: [ std.markup.MarkupAttr { name: "href", value: "x\"&<y onmouseover=z" } ],
    children: [],
  }
}

fn witness_trusted_href_serializes() -> Bool {
  match extdeps.languages.html.try_serialize_html_source(node: trusted_relative_link()) {
    extdeps.languages.html.EmitOk { html: h } => h == "<a href=\"/tree/dag\">dag</a>"
    extdeps.languages.html.EmitRejected { reason: _ } => false
  }
}

fn witness_req_a_hostile_href_still_emits_with_escaping() -> Bool {
  match extdeps.languages.html.try_serialize_html_source(node: req_a_hostile_but_trusted_scheme()) {
    extdeps.languages.html.EmitOk { html: h } =>
      h == "<a href=\"x%22&amp;%3Cy%20onmouseover=z\"></a>"
    extdeps.languages.html.EmitRejected { reason: _ } => false
  }
}

test fn html_emit_keystone_holds() -> Bool {
  witness_html_emit_reduces_and_serializes()
    && witness_html_emit_matches_markup_fold()
    && witness_javascript_reject_discriminates_from_char_escape()
    && witness_data_reject_discriminates_from_char_escape()
    && witness_serialize_rejects_javascript_href()
    && witness_serialize_rejects_data_href()
    && witness_http_href_serializes()
    && witness_trusted_href_serializes()
    && witness_req_a_hostile_href_still_emits_with_escaping()
}
