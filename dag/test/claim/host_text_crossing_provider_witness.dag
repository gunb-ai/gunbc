module test.claim.host_text_crossing_provider_witness

import std.types { Bool, String }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import gunbc.instruments.multi_module_compile_fixture {
  MultiModuleCompileFixture,
  MultiModuleCompileFixtureOutcome,
  FixtureInstrumentRefused,
  FixtureCompileRefused,
  FixtureCompileCompleted,
  fixture_source,
  compile_fixture,
  fixture_blocking_rows,
  fixture_has_class
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE GENERATED CROSSING REFUSES WHEN ITS PROVIDER IS ABSENT (v1.compiler.infer host_text_crossing_call).
// The crossing is a call the compiler generates to the declared route of the Unicode scalar unfold's
// conversion plan, std.coercion unicode_scalar_unfold. In a hermetic compile
// (gunbc.instruments.multi_module_compile_fixture: the manifest is the whole source vector) the fixture
// supplies the code-point-sequence carrier the compiled-in row names (std.algebra FreeMonoid over
// std.types Char) and, or not, a std.coercion declaring the route.
//
// Three arms. With no crossing the consumer compiles clean, so the harness can say yes. With a
// crossing and the route supplied it compiles clean, so the crossing itself is admitted. With a
// crossing and NO route it refuses with the crossing's own diagnostic -- never a fallback to the
// spelling `chars`, which in this closure no module declares.

fn fixture_algebra() -> String {
  "module std.algebra\n\ntype FreeMonoid<T>\n"
}

fn fixture_types() -> String {
  "module std.types\n\ntype Char = Int\n"
}

fn fixture_coercion() -> String {
  "module std.coercion\n\nimport std.algebra { FreeMonoid }\nimport std.types { Char }\n\nfn unicode_scalar_unfold(s: String) -> FreeMonoid<Char> {\n  unicode_scalar_unfold(s: s)\n}\n"
}

fn consumer(crosses: Bool) -> String {
  let call = if crosses { "take(cps: s)" } else { "0" }
  concat("module consumer\n\nimport std.algebra { FreeMonoid }\nimport std.types { Char }\n\nfn take(cps: FreeMonoid<Char>) -> Int {\n  0\n}\n\nfn host_into(s: String) -> Int {\n  ", call, "\n}\n")
}

fn compile(with_route: Bool, crosses: Bool) -> MultiModuleCompileFixtureOutcome {
  let base = [
    fixture_source("std/algebra.dag", fixture_algebra()),
    fixture_source("std/types.dag", fixture_types()),
    fixture_source("consumer.dag", consumer(crosses: crosses)),
  ]
  compile_fixture(MultiModuleCompileFixture {
    sources: if with_route { concat(base, [fixture_source("std/coercion.dag", fixture_coercion())]) } else { base },
    entry: "consumer.dag",
  })
}

fn compiles_clean(o: MultiModuleCompileFixtureOutcome) -> Bool {
  match o {
    FixtureCompileCompleted { module_count: _, emitted_files: _, resolved_rust_functions: _, diagnostics: rows, source_digest: _, compiler_digest: _ } =>
      count(fixture_blocking_rows(rows: rows)) == 0
    FixtureCompileRefused { module_count: _, diagnostics: _, source_digest: _, compiler_digest: _ } => false
    FixtureInstrumentRefused { cause: _ } => false
  }
}

fn refused_by_the_crossing(o: MultiModuleCompileFixtureOutcome) -> Bool {
  match o {
    FixtureCompileRefused { module_count: _, diagnostics: rows, source_digest: _, compiler_digest: _ } =>
      fixture_has_class(rows: fixture_blocking_rows(rows: rows), wanted: "InternalError")
    FixtureCompileCompleted { module_count: _, emitted_files: _, resolved_rust_functions: _, diagnostics: rows, source_digest: _, compiler_digest: _ } =>
      fixture_has_class(rows: fixture_blocking_rows(rows: rows), wanted: "InternalError")
    FixtureInstrumentRefused { cause: _ } => false
  }
}

test fn without_a_crossing_the_consumer_compiles_clean() -> Bool {
  compiles_clean(o: compile(with_route: false, crosses: false))
}

test fn a_crossing_with_its_route_supplied_compiles_clean() -> Bool {
  compiles_clean(o: compile(with_route: true, crosses: true))
}

test fn a_crossing_whose_route_is_absent_refuses() -> Bool {
  refused_by_the_crossing(o: compile(with_route: false, crosses: true))
}
