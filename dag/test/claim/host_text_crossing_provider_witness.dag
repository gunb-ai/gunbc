module test.claim.host_text_crossing_provider_witness

import std.types { Bool, String }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import gunbc.instruments.multi_module_compile_fixture {
  MultiModuleCompileFixture,
  MultiModuleCompileFixtureOutcome,
  FixtureInstrumentRefused,
  FixtureCompileRefused,
  FixtureCompileCompleted,
  fixture_source,
  compile_fixture,
  fixture_blocking_rows,
  fixture_has_class
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE GENERATED CROSSING DEMANDS ITS PROVIDER, AND A HERMETIC CLOSURE WITHOUT IT REFUSES TYPED
// (v1.compiler.infer host_text_crossing_call; std.generated_provider; the seed's hermetic adapter).
// The crossing is a call the compiler generates to the route of the conversion plan selected by the
// crossing's two endpoints, std.coercion unicode_scalar_unfold. In a hermetic compile
// (gunbc.instruments.multi_module_compile_fixture: the manifest is the whole closure and the pool is
// empty) the fixture supplies the code-point-sequence carrier the compiled-in row names (std.algebra
// FreeMonoid over std.types Char) and, or not, a std.coercion declaring the route.
//
// The refusal class is the discriminator that the crossing was entered: only a generated reference
// demands a provider, so GeneratedProviderUnavailable can come from nowhere but the crossing. A fixture
// that failed elsewhere would refuse with another class and these claims would read false.
//
// Four arms. No crossing and no route: compiles clean, and no provider is demanded although the carrier
// is present. Crossing with the route supplied: compiles clean. Crossing without the route: refuses
// GeneratedProviderUnavailable -- never a fallback to the spelling `chars`, which no module here declares.

fn fixture_algebra() -> String {
  "module std.algebra\n\ntype FreeMonoid<T>\n"
}

fn fixture_types() -> String {
  "module std.types\n\ntype Char = Int\n"
}

fn fixture_coercion() -> String {
  "module std.coercion\n\nimport std.algebra { FreeMonoid }\nimport std.types { Char }\n\nfn unicode_scalar_unfold(s: String) -> FreeMonoid<Char> {\n  unicode_scalar_unfold(s: s)\n}\n"
}

fn consumer(crosses: Bool) -> String {
  let call = if crosses { "take(cps: s)" } else { "0" }
  concat("module consumer\n\nimport std.algebra { FreeMonoid }\nimport std.types { Char }\n\nfn take(cps: FreeMonoid<Char>) -> Int {\n  0\n}\n\nfn host_into(s: String) -> Int {\n  ", call, "\n}\n")
}

fn compile(with_route: Bool, crosses: Bool) -> MultiModuleCompileFixtureOutcome {
  let base = [
    fixture_source("std/algebra.dag", fixture_algebra()),
    fixture_source("std/types.dag", fixture_types()),
    fixture_source("consumer.dag", consumer(crosses: crosses)),
  ]
  compile_fixture(MultiModuleCompileFixture {
    sources: if with_route { concat(base, [fixture_source("std/coercion.dag", fixture_coercion())]) } else { base },
    entry: "consumer.dag",
  })
}

fn compiles_clean(o: MultiModuleCompileFixtureOutcome) -> Bool {
  match o {
    FixtureCompileCompleted { module_count: _, emitted_files: _, resolved_rust_functions: _, diagnostics: rows, source_digest: _, compiler_digest: _ } =>
      count(fixture_blocking_rows(rows: rows)) == 0
    FixtureCompileRefused { module_count: _, diagnostics: _, source_digest: _, compiler_digest: _ } => false
    FixtureInstrumentRefused { cause: _ } => false
  }
}

fn refused_as_provider_unavailable(o: MultiModuleCompileFixtureOutcome) -> Bool {
  match o {
    FixtureCompileRefused { module_count: _, diagnostics: rows, source_digest: _, compiler_digest: _ } =>
      fixture_has_class(rows: fixture_blocking_rows(rows: rows), wanted: "GeneratedProviderUnavailable")
    FixtureCompileCompleted { module_count: _, emitted_files: _, resolved_rust_functions: _, diagnostics: rows, source_digest: _, compiler_digest: _ } =>
      fixture_has_class(rows: fixture_blocking_rows(rows: rows), wanted: "GeneratedProviderUnavailable")
    FixtureInstrumentRefused { cause: _ } => false
  }
}

test fn without_a_crossing_the_consumer_compiles_clean() -> Bool {
  compiles_clean(o: compile(with_route: false, crosses: false))
}

test fn a_crossing_with_its_route_supplied_compiles_clean() -> Bool {
  compiles_clean(o: compile(with_route: true, crosses: true))
}

test fn a_crossing_whose_route_is_absent_refuses_as_provider_unavailable() -> Bool {
  refused_as_provider_unavailable(o: compile(with_route: false, crosses: true))
}

test fn the_carrier_without_a_crossing_demands_no_provider() -> Bool {
  !refused_as_provider_unavailable(o: compile(with_route: false, crosses: false))
}
