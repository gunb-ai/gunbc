module dag.test.claim.witness_deferral_freeze_witness



data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

data witness_deferral_freeze_witness_note: String = "MECHANISM ON FIXTURES, per the decomposition rule this lane's own wall enforces: a corpus census may be irreducible but a mechanism never is, so every claim here plants its own tiny rosters and the live-population join runs where it is already paid for — the host admission step the floor executes per PR (cli_run collect_unexecuted_deferred_witnesses / collect_stale_frozen_path_deferrals, pinned by unfrozen_offline_path_row_refuses_as_unclassified_path_deferral and frozen_path_deferral_roster_carries_no_stale_rows). Folding the whole live roster through the live refusal here would be quadratic and would put this file over the very budget whose evasion it exists to close.

THE DISCRIMINATOR every positive claim holds fixed: the row, the offline pattern and the exclusion verdict are identical across the refusing and admitting halves, and only FREEZE MEMBERSHIP moves. That is the fact the wall added — before 2026-08-04 an OfflineLocalRecipe path admitted unconditionally, so the refusing half could not have been written at all."

fn probe_offline_patterns() -> List<String> {
  ["test/claim/long/"]
}

fn probe_fixture_patterns() -> List<String> {
  ["test/fixture/floor_skip/"]
}

fn probe_entry() -> String {
  "src/v2/test/claim/long/synthetic_freeze_probe_test.dag"
}

fn probe_frozen_roster() -> List<gunbc.witness_deferral_freeze.FrozenPathDeferral> {
  [
    gunbc.witness_deferral_freeze.FrozenPathDeferral {
      entry: "src/v2/test/claim/long/synthetic_freeze_probe_test.dag",
      functions: ["already_frozen_holds"]
    }
  ]
}

fn probe_standing(entry: String, function: String, frozen: List<gunbc.witness_deferral_freeze.FrozenPathDeferral>) -> std.witness_admission.WitnessExecutionStanding {
  v2.workflow.witness_admission.witness_path_policy_execution_standing_in(
    entry: entry,
    function: function,
    excluded_from_discovery: true,
    offline: probe_offline_patterns(),
    fixture: probe_fixture_patterns(),
    frozen: frozen
  )
}

fn standing_is_unclassified_path_deferral(r: std.witness_admission.WitnessExecutionStanding) -> Bool {
  match r {
    UnclassifiedPathDeferral { entry: _, function: _ } => true
    UnexecutedDeferredWitness { entry: _, function: _ } => false
    LegacyFrozenPathDeferral { entry: _, function: _ } => false
    WitnessHasExecutingConsumer { cadence: _ } => false
    DeclaredCadenceUnrealized { cadence: _, entry: _, function: _ } => false
  }
}

fn standing_is_unexecuted_deferred(r: std.witness_admission.WitnessExecutionStanding) -> Bool {
  match r {
    UnexecutedDeferredWitness { entry: _, function: _ } => true
    UnclassifiedPathDeferral { entry: _, function: _ } => false
    LegacyFrozenPathDeferral { entry: _, function: _ } => false
    WitnessHasExecutingConsumer { cadence: _ } => false
    DeclaredCadenceUnrealized { cadence: _, entry: _, function: _ } => false
  }
}

fn standing_is_legacy_frozen(r: std.witness_admission.WitnessExecutionStanding) -> Bool {
  match r {
    LegacyFrozenPathDeferral { entry: _, function: _ } => true
    UnexecutedDeferredWitness { entry: _, function: _ } => false
    UnclassifiedPathDeferral { entry: _, function: _ } => false
    WitnessHasExecutingConsumer { cadence: _ } => false
    DeclaredCadenceUnrealized { cadence: _, entry: _, function: _ } => false
  }
}

test fn witness_deferral_freeze_unfrozen_offline_row_refuses() -> Bool {
  standing_is_unclassified_path_deferral(
    r: probe_standing(
      entry: probe_entry(),
      function: "relocated_matrix_holds",
      frozen: probe_frozen_roster()
    )
  )
}

data frozen_is_tolerated_not_covered_note: String = "THE CLAIM THIS PAIR SEPARATES, and the defect it exists to prevent from returning. A frozen row is TOLERATED by the migration ratchet and is NOT COVERED, and those are answered by two different gates over the same standing. The first shape of this wall returned one success arm for both, so a frozen row was indistinguishable from a witness with a real cadence and the live gate going green read as evidence that every current row is admitted — while every one of those rows still executed nowhere. Here the same standing answers NO to coverage and YES to the floor, and a third claim shows the floor's YES is conditional on the baseline axis rather than unconditional."

test fn witness_deferral_freeze_frozen_row_is_not_covered() -> Bool {
  !v2.workflow.witness_admission.witness_has_executing_consumer(
    standing: probe_standing(
      entry: probe_entry(),
      function: "already_frozen_holds",
      frozen: probe_frozen_roster()
    )
  )
    && standing_is_legacy_frozen(
      r: probe_standing(
        entry: probe_entry(),
        function: "already_frozen_holds",
        frozen: probe_frozen_roster()
      )
    )
}

test fn witness_deferral_freeze_frozen_row_is_tolerated_by_the_floor() -> Bool {
  v2.workflow.witness_admission.witness_floor_admission_holds(
    standing: probe_standing(
      entry: probe_entry(),
      function: "already_frozen_holds",
      frozen: probe_frozen_roster()
    ),
    baseline: FrozenBaselineDebtAllowed
  )
}

test fn witness_deferral_freeze_grown_baseline_withdraws_the_toleration() -> Bool {
  !v2.workflow.witness_admission.witness_floor_admission_holds(
    standing: probe_standing(
      entry: probe_entry(),
      function: "already_frozen_holds",
      frozen: probe_frozen_roster()
    ),
    baseline: std.witness_admission.FrozenBaselineDebtGrew { added_count: 1 }
  )
}

test fn witness_deferral_freeze_empty_roster_refuses_the_same_row() -> Bool {
  standing_is_unclassified_path_deferral(
    r: probe_standing(entry: probe_entry(), function: "already_frozen_holds", frozen: [])
  )
}

test fn witness_deferral_freeze_fixture_path_is_unaffected() -> Bool {
  v2.workflow.witness_admission.witness_has_executing_consumer(
    standing: probe_standing(
      entry: "dag/test/fixture/floor_skip/synthetic_control_test.dag",
      function: "floor_skip_control_holds",
      frozen: []
    )
  )
}

test fn witness_deferral_freeze_unclaimed_path_stays_unexecuted_deferred() -> Bool {
  standing_is_unexecuted_deferred(
    r: probe_standing(
      entry: "dag/test/claim/synthetic_orphan_admission_witness_test.dag",
      function: "synthetic_orphan_no_consumer_holds",
      frozen: []
    )
  )
}

test fn witness_deferral_freeze_included_row_is_never_refused() -> Bool {
  v2.workflow.witness_admission.witness_has_executing_consumer(
    standing: v2.workflow.witness_admission.witness_path_policy_execution_standing_in(
      entry: probe_entry(),
      function: "relocated_matrix_holds",
      excluded_from_discovery: false,
      offline: probe_offline_patterns(),
      fixture: probe_fixture_patterns(),
      frozen: []
    )
  )
}

test fn witness_deferral_freeze_join_is_by_identity_not_by_entry() -> Bool {
  !frozen_path_deferral_covers_in(
    rows: probe_frozen_roster(),
    entry: probe_entry(),
    function: "added_after_the_freeze_holds"
  )
    && frozen_path_deferral_covers_in(
      rows: probe_frozen_roster(),
      entry: probe_entry(),
      function: "already_frozen_holds"
    )
}

fn probe_discovered_population() -> List<std.realization_schedule.ScheduleWitnessEntry> {
  [
    std.realization_schedule.ScheduleWitnessEntry {
      entry: "src/v2/test/claim/long/synthetic_freeze_probe_test.dag",
      function: "already_frozen_holds",
      kind: CorpusWitnessKind
    }
  ]
}

test fn witness_deferral_freeze_live_rows_join_the_discovered_population() -> Bool {
  v2.workflow.witness_admission.frozen_path_deferrals_all_discovered(
    rows: probe_frozen_roster(),
    discovered: probe_discovered_population()
  )
}

test fn witness_deferral_freeze_departed_row_fails_the_join() -> Bool {
  !v2.workflow.witness_admission.frozen_path_deferrals_all_discovered(
    rows: [
      gunbc.witness_deferral_freeze.FrozenPathDeferral {
        entry: "src/v2/test/claim/long/departed_test.dag",
        functions: ["departed_holds"]
      }
    ],
    discovered: probe_discovered_population()
  )
}

test fn witness_deferral_freeze_empty_function_list_is_malformed() -> Bool {
  !frozen_path_deferral_row_well_formed(
    row: gunbc.witness_deferral_freeze.FrozenPathDeferral {
      entry: "src/v2/test/claim/long/synthetic_freeze_probe_test.dag",
      functions: []
    }
  )
    && frozen_path_deferral_row_well_formed(
      row: gunbc.witness_deferral_freeze.FrozenPathDeferral {
        entry: "src/v2/test/claim/long/synthetic_freeze_probe_test.dag",
        functions: ["x_holds"]
      }
    )
}

test fn witness_deferral_freeze_live_roster_is_well_formed() -> Bool {
  frozen_path_deferrals_well_formed()
}

data commit_roster_consumer_control_note: String = "THE FALSE-POSITIVE CONTROL, and it caught a real one. A CommitWitnessClaim enrollment on an executing surface makes a witness run as an explicit entry, and explicit rows merge after discovery with no exclusion filter — so an enrolled witness under an offline path executes even though the path excludes it. The first revision of this wall did not read that authority and would have refused 31 such identities: fail-closed, and still a wrong answer. This pair is the discriminator, on a LIVE row rather than a fixture, because the defect was precisely that the live authority was unread: the identity below is admitted while being absent from the frozen population, so its admission can only be coming from its enrollment."

test fn witness_deferral_freeze_commit_roster_enrollment_admits() -> Bool {
  v2.workflow.witness_admission.witness_has_executing_consumer_for_row(
    entry: "src/v2/test/claim/long/parse_table_memo_governed_witness_test.dag",
    function: "witness_content_key_subject_stable"
  )
}

test fn witness_deferral_freeze_commit_roster_row_is_not_frozen() -> Bool {
  !frozen_path_deferral_covers(
    entry: "src/v2/test/claim/long/parse_table_memo_governed_witness_test.dag",
    function: "witness_content_key_subject_stable"
  )
}

data rust_realization_disposition_note: String = "THE REALIZATION IS ACCOUNTED FOR, not just the policy. The .dag carriers above are the authority, but the seed realization in cli_run.rs is several hundred hand-maintained lines in the largest such wall in the program, and a modeled policy does not exempt its realization. gunbc.cli_run_witness_deferral_freeze_scaffold carries the typed Scaffold disposition, the measured landing LOC delta and the ordered dissolution sequence; this pair keeps that registration from becoming a file nobody reads by requiring the disposition to exist and to name a dissolution."

test fn witness_deferral_freeze_rust_realization_is_declared_scaffold() -> Bool {
  match gunbc.cli_run_witness_deferral_freeze_scaffold.cli_run_witness_deferral_freeze_scaffold {
    std.disposition.Scaffold { dissolves_to: _, bind: _ } => true
    _ => false
  }
}

test fn witness_deferral_freeze_rust_realization_names_a_dissolution() -> Bool {
  !(dissolution_description(condition: gunbc.cli_run_witness_deferral_freeze_scaffold.cli_run_witness_deferral_freeze_dissolve_trigger) == "")
    && !(cli_run_witness_deferral_freeze_loc_delta_basis == "")
}
