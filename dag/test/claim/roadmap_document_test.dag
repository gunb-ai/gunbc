module test.claim.roadmap_document


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

data audit_id: gunbc.roadmap_model.RoadmapNodeId = "fail-closed-audit"
data status_id: gunbc.roadmap_model.RoadmapNodeId = "pr-checkbox-status"
data child_id: gunbc.roadmap_model.RoadmapNodeId = "host-fed-status-bridge"

fn audit_node() -> gunbc.roadmap_model.RoadmapNode {
  gunbc.roadmap_model.RoadmapNode {
    identity: "rnfx_J19302B1RYEQZVMM6TG9" as gunbc.roadmap_model.RoadmapNodeIdentity,
    node: audit_id,
    line: gunbc.roadmap_status.AuthoredLine { done: true, content: "**fail-open audit**" },
    carriers: [gunbc.roadmap_model.Pointer { label: "plan", path: "docs/plans/fail-closed-lockdown.md" }],
    sizing: Unsized,
    execution: ExecutionContractUnspecified,
    owner: "",
    signoff: Unsigned,
  }
}

fn status_node() -> gunbc.roadmap_model.RoadmapNode {
  gunbc.roadmap_model.RoadmapNode {
    identity: "rnfx_AJ7G9SDD8FFX86WHFYQB" as gunbc.roadmap_model.RoadmapNodeIdentity,
    node: status_id,
    line: gunbc.roadmap_status.DerivableLine { prs: [5491], title: "**PR-checkbox status**", description: "" },
    carriers: [],
    sizing: Unsized,
    execution: ExecutionContractUnspecified,
    owner: "",
    signoff: Unsigned,
  }
}
fn child_node() -> gunbc.roadmap_model.RoadmapNode {
  gunbc.roadmap_model.RoadmapNode {
    identity: "rnfx_ABYCNZ3BDSY98CHYC51T" as gunbc.roadmap_model.RoadmapNodeIdentity,
    node: child_id,
    line: gunbc.roadmap_status.AuthoredLine { done: false, content: "**host-fed status bridge**" },
    carriers: [],
    sizing: Unsized,
    execution: ExecutionContractUnspecified,
    owner: "",
    signoff: Unsigned,
  }
}

fn lockdown_section() -> gunbc.roadmap_document.RoadmapSection {
  gunbc.roadmap_document.RoadmapSection {
    title: "0. Fail-closed lock-down",
    elements: [section_group(label: "", nodes: [audit_node()], edges: [])],
  }
}
fn expansion_section() -> gunbc.roadmap_document.RoadmapSection {
  gunbc.roadmap_document.RoadmapSection {
    title: "6. Expansion",
    elements: [section_group(
      label: "",
      nodes: [status_node(), child_node()],
      edges: [gunbc.roadmap_model.RoadmapEdge { child: child_id, parent: status_id }],
    )],
  }
}

fn preamble() -> List<std.markdown.MarkdownBlock> {
  [
    std.markdown.HeadingBlock { level: H1, inlines: [std.markdown.TextInline { text: "ROADMAP" }] },
    std.markdown.ParagraphBlock { inlines: [std.markdown.TextInline { text: "Generated from .dag authority — do not hand-edit." }] },
  ]
}

fn authority() -> gunbc.roadmap_document.RoadmapDocument {
  gunbc.roadmap_document.RoadmapDocument { preamble: preamble(), lead_lanes: [], sections: [lockdown_section(), expansion_section()] }
}

fn emit_roadmap(merged: List<Int>) -> String {
  serialize_markdown_source(doc: project_roadmap_to_markdown(doc: authority(), merged: merged))
}

test fn witness_preamble_first() -> Bool {
  let out = emit_roadmap(merged: [5491])
  string_contains(s: out, pattern: "# ROADMAP")
    && string_contains(s: out, pattern: "Generated from .dag authority")
}

test fn witness_both_sections() -> Bool {
  let out = emit_roadmap(merged: [5491])
  string_contains(s: out, pattern: "## 0. Fail-closed lock-down")
    && string_contains(s: out, pattern: "## 6. Expansion")
}

test fn witness_authored_evidence_awaiting_signoff() -> Bool {
  let out = emit_roadmap(merged: [5491])
  string_contains(s: out, pattern: "[ ] **fail-open audit**")
    && string_contains(s: out, pattern: "[plan](docs/plans/fail-closed-lockdown.md)")
    && string_contains(s: out, pattern: "⏳ awaiting sign-off")
}

test fn witness_derived_merged_awaiting_signoff() -> Bool {
  let out = emit_roadmap(merged: [5491])
  string_contains(s: out, pattern: "[ ] **PR-checkbox status**")
    && string_contains(s: out, pattern: "⏳ awaiting sign-off")
    && !string_contains(s: out, pattern: "[x] **PR-checkbox status**")
}

test fn witness_derived_unchecked_when_unmerged() -> Bool {
  let out = emit_roadmap(merged: [])
  string_contains(s: out, pattern: "[ ] **PR-checkbox status**")
    && !string_contains(s: out, pattern: "[x] **PR-checkbox status**")
}

fn expected_roadmap() -> String {
  join([
    "# ROADMAP\n",
    "\n",
    "Generated from .dag authority — do not hand-edit.\n",
    "\n",
    "## 0. Fail-closed lock-down\n",
    "\n",
    "- [ ] **fail-open audit** [plan](docs/plans/fail-closed-lockdown.md) — ⏳ awaiting sign-off\n",
    "\n",
    "## 6. Expansion\n",
    "\n",
    "- [ ] **PR-checkbox status** (#5491) — ⏳ awaiting sign-off\n",
    "  - [ ] **host-fed status bridge**\n"
  ], "")
}

test fn witness_exact_bytes() -> Bool {
  emit_roadmap(merged: [5491]) == expected_roadmap()
}

test fn witness_drift_receipt() -> Bool {
  emit_roadmap(merged: [5491]) == expected_roadmap()
    && !(emit_roadmap(merged: []) == expected_roadmap())
}
