module test.claim.runner_shape_profile_witness_test

import std.types { Bool, Int }
import std.measure { byte_size, byte_size_count, gigabyte, gibibyte, Gibibyte }
import extdeps.ci_runner.types { QuotedByteMagnitude, QuotedDecimalGigabytes, QuotedBinaryGibibytes, QuotedWithoutBasis }
import product.fabric.runner_shape_profile {
  SlotMemoryAnchor, RunnerShapeProfile, OperatorAdoption,
  AdoptedAxis, CpuMemoryRatio, PerRunnerStorage, adoption_covers_axis,
  cores_for_anchor, CoreCountDerived, CoreCountRefused,
  resolve_slot_shape, SlotShapeDerived, SlotShapeRefused,
  gunbc_slot_shape, gunbc_slot_memory_anchor, gunbc_internal_arm_ci_profile,
}

// 16 GiB against 3 DECIMAL GB/core is 5.73 cores and must round UP to 6. Rounding down to 5 would
// pack more slots onto a host than the ratio justifies, and the count derived from this shape is a
// capacity admission, so the error that over-admits is the one that hurts.
test fn slot_shape_derives_six_cores_from_the_sixteen_gibibyte_anchor() -> Bool {
  match gunbc_slot_shape() {
    SlotShapeDerived { shape: s } =>
      s.cores == 6 && byte_size_count(b: s.memory) == 17179869184
    SlotShapeRefused { reason: _ } => false
  }
}

// THE BASIS IS LOAD-BEARING AND THIS IS THE RED THAT PROVES IT. The same numeral 3 read as binary
// gibibytes instead of decimal gigabytes gives 5.33 cores per slot, which rounds to 6 as well --
// so a cores assertion alone would NOT discriminate. The discriminating case is an anchor where the
// two bases land on different core counts: 12 GiB wants 4.29 cores at 3 GB (rounds to 5) and
// exactly 4 at 3 GiB. If the basis were ever dropped, this claim goes red.
test fn decimal_and_binary_bases_are_not_interchangeable() -> Bool {
  let anchor = SlotMemoryAnchor { bytes: byte_size(12884901888), chosen_because: "fixture" }
  let decimal = profile_quoting(m: QuotedDecimalGigabytes { value: gigabyte(3) })
  let binary = profile_quoting(m: QuotedBinaryGibibytes { value: gibibyte_three() })
  cores_of(anchor: anchor, profile: decimal) == 5
    && cores_of(anchor: anchor, profile: binary) == 4
}

// A VENDOR FIGURE WITH NO STATED BASIS REFUSES rather than picking one. This is the arm the reused
// extdeps carrier supplies and the module's first cut could not express: it carried bytes beside a
// numeral and a label, so an unresolvable quote had no representation and would simply have been
// whatever the bytes field happened to say.
test fn a_basis_less_quote_refuses_to_derive_a_core_count() -> Bool {
  let vague = profile_quoting(m: QuotedWithoutBasis { numeral: 3, unit_label: "GB-ish" })
  match cores_for_anchor(anchor: gunbc_slot_memory_anchor, profile: vague) {
    CoreCountDerived { cores: _ } => false
    CoreCountRefused { reason: _ } => true
  }
}

// AN EXACT MULTIPLE MUST NOT OVER-ROUND: 24 decimal GB against 3 GB/core is exactly 8 cores, and a
// ceil that added a ninth would inflate every shape on the fleet by one core.
test fn an_exact_multiple_does_not_gain_a_core() -> Bool {
  let exact = SlotMemoryAnchor { bytes: byte_size(24000000000), chosen_because: "fixture" }
  cores_of(anchor: exact, profile: gunbc_internal_arm_ci_profile) == 8
}

// THE ADOPTION'S SCOPE IS READABLE, which is the whole reason it is a typed axis list rather than
// prose. Ubicloud's cited rows carry a per-runner disk figure beside the ratio; a consumer that
// reaches for it is told no by the model instead of by a comment nothing can read.
test fn the_adoption_covers_the_ratio_and_refuses_storage() -> Bool {
  adoption_covers_axis(evidence: gunbc_internal_arm_ci_profile.evidence, axis: CpuMemoryRatio)
    && !adoption_covers_axis(evidence: gunbc_internal_arm_ci_profile.evidence, axis: PerRunnerStorage)
}

fn gibibyte_three() -> Gibibyte {
  gibibyte(3)
}

fn profile_quoting(m: QuotedByteMagnitude) -> RunnerShapeProfile {
  RunnerShapeProfile {
    name: "fixture",
    memory_per_core: m,
    evidence: OperatorAdoption {
      source: "fixture",
      adopted_on: "fixture",
      rationale: "fixture",
      adopted_axes: [CpuMemoryRatio],
    },
  }
}

fn cores_of(anchor: SlotMemoryAnchor, profile: RunnerShapeProfile) -> Int {
  match cores_for_anchor(anchor: anchor, profile: profile) {
    CoreCountDerived { cores: c } => c
    CoreCountRefused { reason: _ } => 0
  }
}
