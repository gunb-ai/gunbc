module test.claim.branch_protection_witness

import extdeps.github.branch_protection {
  BranchProtectionState, RequiredStatusChecks, PushAllowance
}
import gunbc.branch_protection {
  ProtectionReconcile, ProtectionInSync, ProtectionDrifted, ProtectionObservedUnknown,
  main_branch_protection_desired,
  reconcile_branch_protection,
  protection_eq,
  heal_bot_may_push,
  heal_bot_app_slug,
  branch_protection_converge_armed
}

data branch_protection_witness_note: String = "Green-by-execution proof of the branch-protection RECONCILE decision (the pure part; the Get/Update host effects are not fired here). witness_reconcile_drift proves a differing observed yields ProtectionDrifted carrying the DESIRED state to PUT; witness_reconcile_in_sync proves identical yields no-op; witness_reconcile_unknown_refuses is the fail-closed RED control — an unreadable observed (Get failed) yields ProtectionObservedUnknown, NEVER an assumed in-sync (assuming sync on an unknown observed is the absorbing fallback §5 forbids — it would silently skip a real drift). witness_audit_only_default proves the converge is audit-only by default (no live PUT without an explicit arm). witness_heal_bot_allowed + its negative control prove the push-allowance is the load-bearing field: the heal identity is present in the desired allowance, and a desired without it reads false."

fn sample_observed_matching() -> BranchProtectionState {
  main_branch_protection_desired
}

fn sample_observed_drifted() -> BranchProtectionState {
  BranchProtectionState {
    required_status_checks: RequiredStatusChecks { strict: false, contexts: [] },
    enforce_admins: false,
    required_approving_review_count: 0,
    push_restricted: false,
    push_allowance: PushAllowance { users: [], teams: [], apps: [] }
  }
}

fn reconcile_is_in_sync(r: ProtectionReconcile) -> Bool {
  match r { ProtectionInSync => true  _ => false }
}

fn reconcile_is_drifted_to_desired(r: ProtectionReconcile) -> Bool {
  match r {
    ProtectionDrifted { needs } => protection_eq(a: needs, b: main_branch_protection_desired)
    _ => false
  }
}

fn reconcile_is_unknown(r: ProtectionReconcile) -> Bool {
  match r { ProtectionObservedUnknown { reason: _ } => true  _ => false }
}

fn witness_reconcile_in_sync() -> Bool {
  reconcile_is_in_sync(r: reconcile_branch_protection(
    desired: main_branch_protection_desired,
    observed_ok: true,
    observed: sample_observed_matching(),
    observe_error: ""
  ))
}

fn witness_reconcile_drift() -> Bool {
  reconcile_is_drifted_to_desired(r: reconcile_branch_protection(
    desired: main_branch_protection_desired,
    observed_ok: true,
    observed: sample_observed_drifted(),
    observe_error: ""
  ))
}

fn witness_reconcile_unknown_refuses() -> Bool {
  reconcile_is_unknown(r: reconcile_branch_protection(
    desired: main_branch_protection_desired,
    observed_ok: false,
    observed: sample_observed_drifted(),
    observe_error: "GET /branches/main/protection failed: 404"
  ))
    && !reconcile_is_in_sync(r: reconcile_branch_protection(
        desired: main_branch_protection_desired,
        observed_ok: false,
        observed: sample_observed_matching(),
        observe_error: "unreadable"
      ))
}

fn witness_audit_only_default() -> Bool {
  branch_protection_converge_armed == false
}

fn witness_heal_bot_allowed() -> Bool {
  heal_bot_may_push(desired: main_branch_protection_desired)
    && !heal_bot_may_push(desired: sample_observed_drifted())
}

test fn branch_protection_witnesses() -> Bool {
  witness_reconcile_in_sync()
    && witness_reconcile_drift()
    && witness_reconcile_unknown_refuses()
    && witness_audit_only_default()
    && witness_heal_bot_allowed()
}
