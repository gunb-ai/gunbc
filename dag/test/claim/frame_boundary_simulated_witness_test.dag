module test.claim.frame_boundary_simulated_witness_test


// Discriminating witnesses for the Simulated boundary handler (extdeps.realization.frame_boundary_simulated). Simulated closes exactly the layers it is handed, at LifecycleByConvention -- so it SATISFIES the spec for those layers (boundary_admits -> Materialized) and NEVER over-claims: a layer it was not handed stays uncovered and refuses (the RED). It also never reports LifecycleByConstruction, so a native run requiring the strong grade will not be greened by convention -- pinned by grade_is_convention.
data require_network: List<std.effect_grant.NamespaceTree> = [std.effect_grant.UriTree]

fn is_materialized_convention(a: std.frame_boundary.BoundaryAdmission) -> Bool {
  match a {
    std.frame_boundary.BoundaryMaterialized { grade: g } =>
      match g {
        std.effect_grant.LifecycleByConvention => true
        std.effect_grant.LifecycleByConstruction => false
      }
    std.frame_boundary.BoundaryUnmaterialized { tree: t } => false
  }
}

fn is_unmaterialized_for(a: std.frame_boundary.BoundaryAdmission, tree: std.effect_grant.NamespaceTree) -> Bool {
  match a {
    std.frame_boundary.BoundaryMaterialized { grade: g } => false
    std.frame_boundary.BoundaryUnmaterialized { tree: t } => std.effect_grant.namespace_tree_eq(a: t, b: tree)
  }
}

test fn simulated_boundary_satisfies_spec() -> Bool {
  is_materialized_convention(
    a: std.frame_boundary.boundary_admits(
      required_trees: require_network,
      provided: extdeps.realization.frame_boundary_simulated.simulated_boundary(trees: require_network)
    )
  )
}

test fn simulated_boundary_closes_only_given_layers() -> Bool {
  is_unmaterialized_for(
    a: std.frame_boundary.boundary_admits(
      required_trees: require_network,
      provided: extdeps.realization.frame_boundary_simulated.simulated_boundary(trees: [std.effect_grant.FilesystemPathTree])
    ),
    tree: std.effect_grant.UriTree
  )
}

test fn simulated_boundary_grade_is_convention() -> Bool {
  is_materialized_convention(
    a: std.frame_boundary.boundary_admits(
      required_trees: [std.effect_grant.UriTree, std.effect_grant.FilesystemPathTree],
      provided: extdeps.realization.frame_boundary_simulated.simulated_boundary(trees: [std.effect_grant.UriTree, std.effect_grant.FilesystemPathTree])
    )
  )
}
