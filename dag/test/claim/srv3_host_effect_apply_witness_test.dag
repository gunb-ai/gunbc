test fn witness_srv3_nbd_proxy_apply_foreign_port_refuses_at_apply_time() -> Bool {
  let effect = srv3_nbd_proxy_serve_host_effect()
  match effect {
    Srv3NbdProxyServe { intent: i, lease_key: k } =>
      match host_effect_nbd_proxy_serve_apply_with_observation(
        binding: host_effect_nbd_proxy_serve_session_binding(intent: i, lease_key: k),
        obs: gunbc.session_lease.PortObserved {
          observed_port: i.local_nbd_port,
          pid: 424242,
          cmdline: "foreign-nbdkit" as NonEmptyStr,
          process_fingerprint: "foreign-nbdkit" as NonEmptyStr,
        },
        transport: LocalShell,
      ) {
        NbdProxyServeApplyRefused { reason: _ } => true
        _ => false
      }
    _ => false
  }
}

test fn witness_srv3_nbd_proxy_apply_stale_matching_drains_not_foreign_kill() -> Bool {
  let effect = srv3_nbd_proxy_serve_host_effect()
  match effect {
    Srv3NbdProxyServe { intent: i, lease_key: k } => {
      let binding = host_effect_nbd_proxy_serve_session_binding(intent: i, lease_key: k)
      let stale = gunbc.session_lease.PortObservedStaleExpected {
        observed_port: i.local_nbd_port,
        pid: 99999,
        cmdline: "gunbc-nbd-proxy" as NonEmptyStr,
        process_fingerprint: "gunbc-nbd-proxy" as NonEmptyStr,
        stale_reason: "prior-generation lease holder" as NonEmptyStr,
      }
      let foreign = gunbc.session_lease.PortObserved {
        observed_port: i.local_nbd_port,
        pid: 424242,
        cmdline: "foreign-nbdkit" as NonEmptyStr,
        process_fingerprint: "foreign-nbdkit" as NonEmptyStr,
      }
      host_effect_nbd_proxy_serve_apply_drains_stale_matching(binding: binding, obs: stale)
        && !host_effect_nbd_proxy_serve_apply_drains_stale_matching(binding: binding, obs: foreign)
        && host_effect_nbd_proxy_serve_apply_refuses_foreign_port(binding: binding, obs: foreign)
    }
    _ => false
  }
}

test fn witness_srv3_nbd_proxy_websocat_argv_materializes_token_not_shell_env_ref() -> Bool {
  let effect = srv3_nbd_proxy_serve_host_effect()
  match effect {
    Srv3NbdProxyServe { intent: i, lease_key: _ } =>
      host_effect_nbd_proxy_serve_websocat_argv_materialized_omits_shell_env_ref(
        intent: i,
        token: "materialized-bmcweb-token" as NonEmptyStr,
      )
    _ => false
  }
}

test fn witness_srv3_nbd_proxy_apply_observe_unimplemented_refuses_fail_closed() -> Bool {
  let effect = srv3_nbd_proxy_serve_host_effect()
  match effect {
    Srv3NbdProxyServe { intent: i, lease_key: k } =>
      host_effect_nbd_proxy_serve_apply_refuses_when_observe_unimplemented(
        binding: host_effect_nbd_proxy_serve_session_binding(intent: i, lease_key: k),
        transport: LocalShell,
      )
    _ => false
  }
}

test fn witness_srv3_nbd_proxy_serve_session_binding_carries_lease() -> Bool {
  let effect = srv3_nbd_proxy_serve_host_effect()
  match effect {
    Srv3NbdProxyServe { intent: i, lease_key: k } =>
      match host_effect_nbd_proxy_serve_session_binding(intent: i, lease_key: k) {
        binding =>
          binding.lease_key == srv3_nbd_proxy_lease_key
            && binding.scope.listen_port == i.local_nbd_port
            && binding.scope.expected_owner_label == "gunbc-nbd-proxy" as NonEmptyStr
            && host_effect_nbd_proxy_serve_session_policy_is_held_lease(lease_key: k)
      }
    _ => false
  }
}

