module test.claim.srv3_host_effect_apply_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn srv3_actuator_target() -> gunbc.host_effect.NodeControlPlane {
  HostOs { node: srv3_os_install_actuator_host }
}

fn srv3_bmc_target() -> gunbc.host_effect.NodeControlPlane {
  BmcController { node: srv3_os_install_actuator_host }
}

test fn witness_srv3_receipt_emit_apply_converges_in_process() -> Bool {
  match host_effect_apply(
    target: srv3_actuator_target(),
    effect: gunbc.host_effect.Srv3ReceiptEmit { lines: ["line-one", "line-two"] },
    evidence: host_effect_identity_evidence,
    transport: LocalShell,
  ) {
    Converged { evidence: e, applied: _ } =>
      match e {
        ShellEffectApplied { stdout: out, exit_code: code, stderr: _ } =>
          code == 0
            && string_contains(s: out, pattern: "line-one")
            && string_contains(s: out, pattern: "line-two")
            && !string_contains(s: out, pattern: "printf")
        ConvergePlanApplied { stdout: _, exit_code: _ } => false
      }
    NotConverged { reason: _, applied: _ } => false
  }
}

test fn witness_bmcweb_token_extract_ssh_transport_refuses_typed() -> Bool {
  match host_effect_apply(
    target: srv3_actuator_target(),
    effect: Srv3BmcwebTokenExtract,
    evidence: host_effect_identity_evidence,
    transport: gunbc.host_effect.SshShell { ssh_host: "203.0.113.1" as NonEmptyStr },
  ) {
    NotConverged { reason: why, applied: _ } =>
      string_contains(s: why, pattern: "SshShell transport is a fail-closed Unimplemented stub")
    Converged { evidence: _, applied: _ } => false
  }
}

test fn witness_bmcweb_session_login_argv_uses_curl_authority_not_serialize_bash() -> Bool {
  let curl_args = bmcweb_session_login_curl_args(
    bmc_host: asrock_srv3_live_bmc_host,
    request_body_file: srv3_bmcweb_login_body_path as NonEmptyStr,
    response_path: gunbc.srv3_actuate_shell_paths.srv3_bmcweb_login_response_path as NonEmptyStr,
  )
  let argv = bmcweb_session_login_argv(
    bmc_host: asrock_srv3_live_bmc_host,
    request_body_file: srv3_bmcweb_login_body_path as NonEmptyStr,
    response_path: gunbc.srv3_actuate_shell_paths.srv3_bmcweb_login_response_path as NonEmptyStr,
  )
  let curl_args_surface = fold(
    curl_args,
    init: "" as String,
    f: (acc, word) => if acc == "" { word } else { concat(acc, concat(" ", word)) },
  )
  let argv_surface = fold(
    argv,
    init: "" as String,
    f: (acc, word) => if acc == "" { word } else { concat(acc, concat(" ", word)) },
  )
  string_contains(s: argv_surface, pattern: curl_cli_tool.name as String)
    && string_contains(s: argv_surface, pattern: curl_args_surface)
    && string_contains(s: argv_surface, pattern: srv3_bmcweb_login_body_path)
    && string_contains(s: argv_surface, pattern: gunbc.srv3_actuate_shell_paths.srv3_bmcweb_login_response_path)
    && !string_contains(s: argv_surface, pattern: "serialize_bash")
}

test fn witness_srv3_apply_shell_failure_refuses_typed() -> Bool {
  !reconciliation_converged(r: host_effect_apply(
    target: srv3_actuator_target(),
    effect: ShellCommand { script: "exit 1" },
    evidence: host_effect_identity_evidence,
    transport: LocalShell
  ))
}

test fn witness_srv3_apply_failure_surfaces_captured_stdout_not_fabricated() -> Bool {
  match host_effect_apply(
    target: srv3_actuator_target(),
    effect: ShellCommand { script: "echo srv3-apply-red-marker && exit 1" },
    evidence: host_effect_identity_evidence,
    transport: LocalShell
  ) {
    NotConverged { reason: why, applied: _ } =>
      string_contains(s: why, pattern: "srv3-apply-red-marker")
        && string_contains(s: why, pattern: "fail-closed")
    Converged { evidence: _, applied: _ } => false
  }
}

test fn witness_srv3_apply_failure_no_fabricated_stdout() -> Bool {
  let r = host_effect_apply(
    target: srv3_actuator_target(),
    effect: ShellCommand { script: "exit 1" },
    evidence: host_effect_identity_evidence,
    transport: LocalShell
  )
  !reconciliation_converged(r: r) && srv3_shell_stdout_from_apply(r: r) == none
}

