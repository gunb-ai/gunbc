module test.claim.srv3_host_effect_apply_witness


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn srv3_actuator_target() -> NodeControlPlane {
  HostOs { node: srv3_os_install_actuator_host }
}

fn srv3_bmc_target() -> NodeControlPlane {
  BmcController { node: srv3_os_install_actuator_host }
}

fn witness_srv3_receipt_emit_apply_converges_in_process() -> Bool {
  match host_effect_apply(
    target: srv3_actuator_target(),
    effect: Srv3ReceiptEmit { lines: ["line-one", "line-two"] },
    evidence: host_effect_identity_evidence,
    transport: LocalShell,
  ) {
    Converged { evidence: e, applied: _ } =>
      match e {
        ShellEffectApplied { stdout: out, exit_code: code } =>
          code == 0
            && string_contains(s: out, pattern: "line-one")
            && string_contains(s: out, pattern: "line-two")
            && !string_contains(s: out, pattern: "printf")
        ConvergePlanApplied { stdout: _, exit_code: _ } => false
      }
    NotConverged { reason: _, applied: _ } => false
  }
}

fn witness_durable_approval_grant_read_refuses_when_grant_file_unreadable() -> Bool {
  match host_effect_apply(
    target: srv3_actuator_target(),
    effect: DurableApprovalGrantRead,
    evidence: host_effect_read_evidence,
    transport: LocalShell,
  ) {
    Converged { evidence: _, applied: _ } => false
    NotConverged { reason: why, applied: _ } =>
      string_contains(s: why, pattern: "DurableApprovalGrantRead refused Filesystem.Read failure")
        && string_contains(s: why, pattern: "fail-closed")
  }
}

fn witness_bmcweb_token_extract_ssh_transport_refuses_typed() -> Bool {
  match host_effect_apply(
    target: srv3_actuator_target(),
    effect: Srv3BmcwebTokenExtract,
    evidence: host_effect_identity_evidence,
    transport: SshShell { ssh_host: "203.0.113.1" as NonEmptyStr },
  ) {
    NotConverged { reason: why, applied: _ } =>
      string_contains(s: why, pattern: "SshShell transport is a fail-closed Unimplemented stub")
    Converged { evidence: _, applied: _ } => false
  }
}

fn witness_bmcweb_session_login_argv_uses_curl_authority_not_serialize_bash() -> Bool {
  let curl_args = bmcweb_session_login_curl_args(
    bmc_host: asrock_srv3_live_bmc_host,
    request_body_file: srv3_bmcweb_login_body_path as NonEmptyStr,
    response_path: srv3_bmcweb_login_response_path as NonEmptyStr,
  )
  let argv = bmcweb_session_login_argv(
    bmc_host: asrock_srv3_live_bmc_host,
    request_body_file: srv3_bmcweb_login_body_path as NonEmptyStr,
    response_path: srv3_bmcweb_login_response_path as NonEmptyStr,
  )
  let curl_args_surface = fold(
    curl_args,
    init: "" as String,
    f: (acc, word) => if acc == "" { word } else { concat(acc, concat(" ", word)) },
  )
  let argv_surface = fold(
    argv,
    init: "" as String,
    f: (acc, word) => if acc == "" { word } else { concat(acc, concat(" ", word)) },
  )
  string_contains(s: argv_surface, pattern: curl_cli_tool.name as String)
    && string_contains(s: argv_surface, pattern: curl_args_surface)
    && string_contains(s: argv_surface, pattern: srv3_bmcweb_login_body_path)
    && string_contains(s: argv_surface, pattern: srv3_bmcweb_login_response_path)
    && !string_contains(s: argv_surface, pattern: "serialize_bash")
}

fn witness_srv3_apply_shell_failure_refuses_typed() -> Bool {
  !reconciliation_converged(r: host_effect_apply(
    target: srv3_actuator_target(),
    effect: ShellCommand { script: "exit 1" },
    evidence: host_effect_identity_evidence,
    transport: LocalShell
  ))
}

fn witness_srv3_apply_failure_surfaces_captured_stdout_not_fabricated() -> Bool {
  match host_effect_apply(
    target: srv3_actuator_target(),
    effect: ShellCommand { script: "echo srv3-apply-red-marker && exit 1" },
    evidence: host_effect_identity_evidence,
    transport: LocalShell
  ) {
    NotConverged { reason: why, applied: _ } =>
      string_contains(s: why, pattern: "srv3-apply-red-marker")
        && string_contains(s: why, pattern: "fail-closed")
    Converged { evidence: _, applied: _ } => false
  }
}

fn witness_srv3_apply_failure_no_fabricated_stdout() -> Bool {
  let r = host_effect_apply(
    target: srv3_actuator_target(),
    effect: ShellCommand { script: "exit 1" },
    evidence: host_effect_identity_evidence,
    transport: LocalShell
  )
  !reconciliation_converged(r: r) && srv3_shell_stdout_from_apply(r: r) == none
}

fn witness_srv3_typed_effect_on_bmc_refuses_typed() -> Bool {
  match host_effect_apply(
    target: srv3_bmc_target(),
    effect: Srv3InstallMediaFetch,
    evidence: host_effect_identity_evidence,
    transport: LocalShell
  ) {
    NotConverged { reason: why, applied: _ } =>
      string_contains(s: why, pattern: "cannot target BmcController")
    Converged { evidence: _, applied: _ } => false
  }
}

fn witness_srv3_typed_reconcile_ssh_transport_refuses_typed() -> Bool {
  match host_effect_apply(
    target: srv3_actuator_target(),
    effect: Srv3InstallMediaFetch,
    evidence: host_effect_identity_evidence,
    transport: SshShell { ssh_host: "203.0.113.1" as NonEmptyStr }
  ) {
    NotConverged { reason: why, applied: _ } =>
      string_contains(s: why, pattern: "SshShell transport is a fail-closed Unimplemented stub")
    Converged { evidence: _, applied: _ } => false
  }
}

fn witness_srv3_nbd_proxy_apply_foreign_port_refuses_at_apply_time() -> Bool {
  let effect = srv3_nbd_proxy_serve_host_effect()
  match effect {
    Srv3NbdProxyServe { intent: i, lease_key: k } =>
      match host_effect_nbd_proxy_serve_apply_with_observation(
        binding: host_effect_nbd_proxy_serve_session_binding(intent: i, lease_key: k),
        obs: PortObserved {
          observed_port: i.local_nbd_port,
          pid: 424242,
          cmdline: "foreign-nbdkit" as NonEmptyStr,
          process_fingerprint: "foreign-nbdkit" as NonEmptyStr,
        },
        transport: LocalShell,
      ) {
        NbdProxyServeApplyRefused { reason: _ } => true
        _ => false
      }
    _ => false
  }
}

fn witness_srv3_nbd_proxy_apply_stale_matching_drains_not_foreign_kill() -> Bool {
  let effect = srv3_nbd_proxy_serve_host_effect()
  match effect {
    Srv3NbdProxyServe { intent: i, lease_key: k } => {
      let binding = host_effect_nbd_proxy_serve_session_binding(intent: i, lease_key: k)
      let stale = PortObservedStaleExpected {
        observed_port: i.local_nbd_port,
        pid: 99999,
        cmdline: "gunbc-nbd-proxy" as NonEmptyStr,
        process_fingerprint: "gunbc-nbd-proxy" as NonEmptyStr,
        stale_reason: "prior-generation lease holder" as NonEmptyStr,
      }
      let foreign = PortObserved {
        observed_port: i.local_nbd_port,
        pid: 424242,
        cmdline: "foreign-nbdkit" as NonEmptyStr,
        process_fingerprint: "foreign-nbdkit" as NonEmptyStr,
      }
      host_effect_nbd_proxy_serve_apply_drains_stale_matching(binding: binding, obs: stale)
        && !host_effect_nbd_proxy_serve_apply_drains_stale_matching(binding: binding, obs: foreign)
        && host_effect_nbd_proxy_serve_apply_refuses_foreign_port(binding: binding, obs: foreign)
    }
    _ => false
  }
}

fn witness_srv3_nbd_proxy_websocat_argv_materializes_token_not_shell_env_ref() -> Bool {
  let effect = srv3_nbd_proxy_serve_host_effect()
  match effect {
    Srv3NbdProxyServe { intent: i, lease_key: _ } =>
      host_effect_nbd_proxy_serve_websocat_argv_materialized_omits_shell_env_ref(
        intent: i,
        token: "materialized-bmcweb-token" as NonEmptyStr,
      )
    _ => false
  }
}

fn witness_srv3_nbd_proxy_apply_observe_unimplemented_refuses_fail_closed() -> Bool {
  let effect = srv3_nbd_proxy_serve_host_effect()
  match effect {
    Srv3NbdProxyServe { intent: i, lease_key: k } =>
      host_effect_nbd_proxy_serve_apply_refuses_when_observe_unimplemented(
        binding: host_effect_nbd_proxy_serve_session_binding(intent: i, lease_key: k),
        transport: LocalShell,
      )
    _ => false
  }
}

fn witness_srv3_nbd_proxy_serve_session_binding_carries_lease() -> Bool {
  let effect = srv3_nbd_proxy_serve_host_effect()
  match effect {
    Srv3NbdProxyServe { intent: i, lease_key: k } =>
      match host_effect_nbd_proxy_serve_session_binding(intent: i, lease_key: k) {
        binding =>
          binding.lease_key == srv3_nbd_proxy_lease_key
            && binding.scope.listen_port == i.local_nbd_port
            && binding.scope.expected_owner_label == "gunbc-nbd-proxy" as NonEmptyStr
            && host_effect_nbd_proxy_serve_session_policy_is_held_lease(lease_key: k)
      }
    _ => false
  }
}

fn witness_srv3_nbd_proxy_on_bmc_refuses_typed() -> Bool {
  match host_effect_apply(
    target: srv3_bmc_target(),
    effect: srv3_nbd_proxy_serve_host_effect(),
    evidence: host_effect_identity_evidence,
    transport: LocalShell
  ) {
    NotConverged { reason: why, applied: _ } =>
      string_contains(s: why, pattern: "cannot target BmcController")
    Converged { evidence: _, applied: _ } => false
  }
}

test fn srv3_typed_receipt_emit_realizes_in_process_not_shell() -> Bool {
  witness_srv3_receipt_emit_apply_converges_in_process()
}

test fn srv3_typed_receipt_carrier_holds_lines() -> Bool {
  let receipt = srv3_typed_receipt_from_lines(lines: ["a", "b"])
  srv3_typed_receipt(receipt: receipt).lines.length() == 2
}

test fn shell_bash_runner_still_present_for_p5b() -> Bool {
  string_contains(s: shell_bash_runner_dissolution_trigger, pattern: "shell_exec_via_bash")
}

test fn srv3_nbd_proxy_serve_realize_layer_dissolves_via_host_effect_nbd_proxy_serve() -> Bool {
  string_contains(s: host_effect_nbd_proxy_serve_dissolution_trigger, pattern: "systemd")
    && string_contains(s: host_effect_nbd_proxy_serve_dissolution_trigger, pattern: "srv3_bmcweb_token_path")
    && string_contains(s: host_effect_nbd_proxy_serve_dissolution_trigger, pattern: "P6 Part 2")
}

test fn srv3_host_effect_apply_holds() -> Bool {
  witness_srv3_receipt_emit_apply_converges_in_process()
    && srv3_typed_receipt_carrier_holds_lines()
    && shell_bash_runner_still_present_for_p5b()
    && srv3_nbd_proxy_serve_realize_layer_dissolves_via_host_effect_nbd_proxy_serve()
    && witness_srv3_nbd_proxy_serve_session_binding_carries_lease()
    && witness_srv3_nbd_proxy_apply_foreign_port_refuses_at_apply_time()
    && witness_srv3_nbd_proxy_apply_stale_matching_drains_not_foreign_kill()
    && witness_srv3_nbd_proxy_websocat_argv_materializes_token_not_shell_env_ref()
    && witness_srv3_nbd_proxy_apply_observe_unimplemented_refuses_fail_closed()
    && witness_srv3_nbd_proxy_on_bmc_refuses_typed()
    && witness_srv3_apply_shell_failure_refuses_typed()
    && witness_srv3_apply_failure_surfaces_captured_stdout_not_fabricated()
    && witness_srv3_apply_failure_no_fabricated_stdout()
    && witness_srv3_typed_effect_on_bmc_refuses_typed()
    && witness_srv3_typed_reconcile_ssh_transport_refuses_typed()
    && witness_durable_approval_grant_read_refuses_when_grant_file_unreadable()
    && witness_bmcweb_token_extract_ssh_transport_refuses_typed()
    && witness_bmcweb_session_login_argv_uses_curl_authority_not_serialize_bash()
}
