test fn srv3_typed_receipt_emit_realizes_in_process_not_shell() -> Bool {
  witness_srv3_receipt_emit_apply_converges_in_process()
}

test fn srv3_typed_receipt_carrier_holds_lines() -> Bool {
  let receipt = srv3_typed_receipt_from_lines(lines: ["a", "b"])
  srv3_typed_receipt(receipt: receipt).lines.length() == 2
}

test fn shell_bash_runner_still_present_for_p5b() -> Bool {
  string_contains(s: std.dissolution.dissolution_description(condition: shell_bash_runner_dissolution_trigger), pattern: "shell_exec_via_bash")
}

test fn srv3_nbd_proxy_serve_realize_layer_dissolves_via_host_effect_nbd_proxy_serve() -> Bool {
  string_contains(s: std.dissolution.dissolution_description(condition: host_effect_nbd_proxy_serve_dissolution_trigger), pattern: "systemd")
    && string_contains(s: std.dissolution.dissolution_description(condition: host_effect_nbd_proxy_serve_dissolution_trigger), pattern: "srv3_bmcweb_token_path")
    && string_contains(s: std.dissolution.dissolution_description(condition: host_effect_nbd_proxy_serve_dissolution_trigger), pattern: "P6 Part 2")
}


// THE FIVE WITNESSES BELOW DISCRIMINATE THE BMCWEB TOKEN-EXTRACT FAIL-OPEN.
// jq's `// empty` alternative turns an absent or null `.token` into a run that
// exits 0 and prints nothing, so the pre-fix realization wrote an EMPTY file to
// srv3_bmcweb_token_path and reconciled Converged — a rejected BMC login
// reported as a successful convergence at a credential seam (DESIGN §5,
// fabricated plausible output). The verdict now lives in
// gunbc.host_effect_realize.bmcweb_token_extraction_verdict, ahead of the write, so an absent token has no
// path to Filesystem.Write at all rather than being caught after the fact.
//
// THE ARGV CLAIM IS ABOUT THE FILTER, NOT THE FLAG. It asserts that the filter does not
// carry an absence-swallowing alternative — the exact defect as found — and deliberately
// does NOT assert the `-e` spelling. `-e` is loudness at the transport: it makes jq itself
// report the absence rather than leaving the caller to infer it from empty output, and the
// argv-migration lane will delete this flattened-argv form outright, so pinning its spelling
// would pin a deletion-bound artifact instead of the requirement. The WALL is the verdict
// below, which refuses blank stdout on its own — that is what makes `-e` optional rather
// than load-bearing here, and it is also why `-e` alone would be insufficient: jq exits zero
// on an empty-STRING token, which the blank arm catches and the flag does not.
test fn witness_bmcweb_token_extract_argv_demands_a_value() -> Bool {
  let argv = gunbc.host_effect_realize.bmcweb_token_extract_jq_args(response_path: gunbc.srv3_actuate_shell_paths.srv3_bmcweb_login_response_path)
  let surface = fold(
    argv,
    init: "" as String,
    f: (acc, word) => if acc == "" { word } else { concat(acc, concat(" ", word)) },
  )
  string_contains(s: surface, pattern: ".token")
    && !string_contains(s: surface, pattern: "// empty")
    && string_contains(s: surface, pattern: gunbc.srv3_actuate_shell_paths.srv3_bmcweb_login_response_path)
}

test fn witness_bmcweb_token_extract_absent_token_refuses_typed() -> Bool {
  match gunbc.host_effect_realize.bmcweb_token_extraction_verdict(jq_success: true, jq_stdout: "") {
    gunbc.host_effect_realize.BmcwebTokenExtractRefused { reason: why } =>
      string_contains(s: why, pattern: "Srv3BmcwebTokenExtract")
        && string_contains(s: why, pattern: "fail-closed")
    gunbc.host_effect_realize.BmcwebTokenExtracted { token: _ } => false
  }
}

test fn witness_bmcweb_token_extract_blank_token_refuses_typed() -> Bool {
  match gunbc.host_effect_realize.bmcweb_token_extraction_verdict(jq_success: true, jq_stdout: "\n") {
    gunbc.host_effect_realize.BmcwebTokenExtractRefused { reason: _ } => true
    gunbc.host_effect_realize.BmcwebTokenExtracted { token: _ } => false
  }
}

test fn witness_bmcweb_token_extract_jq_nonzero_refuses_typed() -> Bool {
  match gunbc.host_effect_realize.bmcweb_token_extraction_verdict(jq_success: false, jq_stdout: "") {
    gunbc.host_effect_realize.BmcwebTokenExtractRefused { reason: _ } => true
    gunbc.host_effect_realize.BmcwebTokenExtracted { token: _ } => false
  }
}

test fn witness_bmcweb_token_extract_present_token_extracts_trimmed() -> Bool {
  match gunbc.host_effect_realize.bmcweb_token_extraction_verdict(jq_success: true, jq_stdout: "3wMhV2QcT0k\n") {
    gunbc.host_effect_realize.BmcwebTokenExtracted { token: token } => (token as String) == "3wMhV2QcT0k"
    gunbc.host_effect_realize.BmcwebTokenExtractRefused { reason: _ } => false
  }
}
