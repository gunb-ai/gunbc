test fn w_red_zero_registered_user_floor_yields_no_bound() -> Bool {
  match gunbc.econ.free_tier_serving.average_serving_cost_per_registered_user_year_micros_upper_bound(
    annual_cost_of_revenue: extdeps.sec.issuer.gitlab_facts.gitlab_fy2026_cost_of_revenue,
    registered_users: zero_floor_registered_users_fixture,
  ) {
    Present { value: _ } => false
