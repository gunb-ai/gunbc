module test.claim.free_tier_serving_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data solo_scm_user_envelope: gunbc.econ.free_tier_serving.FreeTierUserEnvelope = gunbc.econ.free_tier_serving.FreeTierUserEnvelope {
  storage_bytes_per_user: std.measure.byte_size(count: 100000000),
  monthly_egress_bytes_per_user: std.measure.byte_size(count: 500000000),
}

data solo_scm_10k_assumptions: gunbc.econ.free_tier_serving.FreeTierServingAssumptions = gunbc.econ.free_tier_serving.FreeTierServingAssumptions {
  user_count: 10000,
  replica_count: 2,
  per_box_monthly_egress_allowance: std.measure.byte_size(count: 20000000000000),
}

data solo_scm_100k_assumptions: gunbc.econ.free_tier_serving.FreeTierServingAssumptions = gunbc.econ.free_tier_serving.FreeTierServingAssumptions {
  user_count: 100000,
  replica_count: 2,
  per_box_monthly_egress_allowance: std.measure.byte_size(count: 20000000000000),
}

data ax41_zero_storage_fixture: extdeps.pricing.hetzner_dedicated.HetznerDedicatedServerPriceRow = extdeps.pricing.hetzner_dedicated.HetznerDedicatedServerPriceRow {
  server_type: hetzner_ax41_1_ltd_price.server_type,
  server_type_wire_label: hetzner_ax41_1_ltd_price.server_type_wire_label,
  cpu: hetzner_ax41_1_ltd_price.cpu,
  cpu_description: hetzner_ax41_1_ltd_price.cpu_description,
  memory_bytes: hetzner_ax41_1_ltd_price.memory_bytes,
  storage_bytes: std.measure.byte_size(count: 0),
  monthly: hetzner_ax41_1_ltd_price.monthly,
  setup_fee: hetzner_ax41_1_ltd_price.setup_fee,
  pricing_citation: "witness-fixture#box-storage-zero",
}

data zero_floor_registered_users_fixture: extdeps.sec.operating_metrics.RegisteredUserCountRow = extdeps.sec.operating_metrics.RegisteredUserCountRow {
  registered_user_count_floor: 0,
  citation: gitlab_fy2026_registered_users.citation,
}

test fn w_10k_users_floor_is_two_ax41_boxes() -> Bool {
  match gunbc.econ.free_tier_serving.derive_free_tier_serving_floor(
    box_row: extdeps.pricing.hetzner_dedicated.hetzner_ax41_1_ltd_price,
    assumptions_input: gunbc.econ.free_tier_serving.FreeTierAssumptionsDeclared {
      envelope: solo_scm_user_envelope,
      assumptions: solo_scm_10k_assumptions,
    },
  ) {
    gunbc.econ.free_tier_serving.FreeTierFloorComputed { floor: f } =>
      (f.box_count == 2) && (std.measure.money_per_month_micros(q: f.monthly_floor) == 114600000)
    _ => false
  }
}

test fn w_100k_users_floor_scales_to_nineteen_boxes() -> Bool {
  match gunbc.econ.free_tier_serving.derive_free_tier_serving_floor(
    box_row: extdeps.pricing.hetzner_dedicated.hetzner_ax41_1_ltd_price,
    assumptions_input: gunbc.econ.free_tier_serving.FreeTierAssumptionsDeclared {
      envelope: solo_scm_user_envelope,
      assumptions: solo_scm_100k_assumptions,
    },
  ) {
    gunbc.econ.free_tier_serving.FreeTierFloorComputed { floor: f } =>
      (f.box_count == 19) && (std.measure.money_per_month_micros(q: f.monthly_floor) == 1088700000)
    _ => false
  }
}

test fn w_gitlab_fy2026_average_serving_cost_upper_bound() -> Bool {
  match gunbc.econ.free_tier_serving.average_serving_cost_per_registered_user_year_micros_upper_bound(
    annual_cost_of_revenue: extdeps.sec.issuer.gitlab_facts.gitlab_fy2026_cost_of_revenue,
    registered_users: extdeps.sec.issuer.gitlab_facts.gitlab_fy2026_registered_users,
  ) {
    Present { value: micros_per_user_year } =>
      (micros_per_user_year == 2414860) && (micros_per_user_year < 2500000)
    _ => false
  }
}

test fn w_gitlab_fy2023_average_serving_cost_upper_bound() -> Bool {
  match gunbc.econ.free_tier_serving.average_serving_cost_per_registered_user_year_micros_upper_bound(
    annual_cost_of_revenue: extdeps.sec.issuer.gitlab_facts.gitlab_fy2023_cost_of_revenue,
    registered_users: extdeps.sec.issuer.gitlab_facts.gitlab_fy2023_registered_users,
  ) {
    Present { value: micros_per_user_year } =>
      (micros_per_user_year == 1722667) && (micros_per_user_year < 1800000)
    _ => false
  }
}

test fn w_red_unknown_assumptions_refused() -> Bool {
  match gunbc.econ.free_tier_serving.derive_free_tier_serving_floor(
    box_row: extdeps.pricing.hetzner_dedicated.hetzner_ax41_1_ltd_price,
    assumptions_input: gunbc.econ.free_tier_serving.FreeTierAssumptionsUnknown,
  ) {
    gunbc.econ.free_tier_serving.FreeTierFloorRefused { cause: gunbc.econ.free_tier_serving.ServingAssumptionsUnknown } => true
    _ => false
  }
}

