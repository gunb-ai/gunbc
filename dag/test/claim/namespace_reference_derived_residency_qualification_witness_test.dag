module test.claim.namespace_reference_derived_residency_qualification_witness_test

import gunbc.namespace_reference_derived_residency_qualification {
  ProducerCarrierReading,
  ProductionLifecycleReading,
  SyntaxNodePerKey,
  IdentityDigestPerKey,
  KeyedByWholePoolPopulation,
  KeyedBySingleSubject,
  BoundedRealizationQualified,
  BoundedRealizationRefused,
  WholeCorpusSyntaxAtConstructionPeak,
  WholeCorpusSyntaxRetainedAtReturn,
  LifecycleReadingAbsent,
  BoundedRealizationAdmitted,
  BoundedRealizationSemanticDeliveryOutstanding,
  BoundedRealizationResourceQualificationOutstanding,
  qualify_bounded_realization,
  admit_bounded_realization,
  reference_derived_pool_lifecycle_reading,
  bounded_reference_derived_pool_specimen,
}
import std.types { Bool, List, String }
import std.decl_ref { DeclarationRef, decl_ref }

// Witnesses for the residency qualification of the reference-derived graph producer. The three RED
// controls are the three ways a check over this subject has been satisfiable by a producer that fixed
// nothing: retention moved into the index, a whole-pool build that releases before returning, and an
// empty reading standing as a bound.

fn rdrq_subject() -> DeclarationRef {
  decl_ref(module_path: "v2.lens.module_graph", decl_name: "load_reference_derived_pool")
}

fn rdrq_syntax_carrier(decl_name: String) -> ProducerCarrierReading {
  ProducerCarrierReading {
    carrier: decl_ref(module_path: "v2.lens.module_graph", decl_name: decl_name),
    grain: SyntaxNodePerKey,
    population: KeyedByWholePoolPopulation,
  }
}

fn rdrq_index_syntax_carrier() -> ProducerCarrierReading {
  ProducerCarrierReading {
    carrier: decl_ref(module_path: "v2.std.symbol_index", decl_name: "SymbolIndex"),
    grain: SyntaxNodePerKey,
    population: KeyedByWholePoolPopulation,
  }
}

fn rdrq_bounded_index_carrier() -> ProducerCarrierReading {
  ProducerCarrierReading {
    carrier: decl_ref(module_path: "v2.std.symbol_index", decl_name: "SymbolIndex"),
    grain: IdentityDigestPerKey,
    population: KeyedByWholePoolPopulation,
  }
}

fn rdrq_subject_tree_carrier() -> ProducerCarrierReading {
  ProducerCarrierReading {
    carrier: decl_ref(module_path: "v2.lens.module_graph", decl_name: "LocatedModuleRoot"),
    grain: SyntaxNodePerKey,
    population: KeyedBySingleSubject,
  }
}

fn rdrq_reading(
  constructed: List<ProducerCarrierReading>,
  retained_at_return: List<ProducerCarrierReading>,
) -> ProductionLifecycleReading {
  ProductionLifecycleReading {
    subject: rdrq_subject(),
    constructed: constructed,
    retained_at_return: retained_at_return,
  }
}

// POSITIVE CONTROL. A name table keyed by the pool population plus the one subject tree under
// production qualifies. Without this arm every red below would be satisfied by a qualifier that
// refuses everything.
fn a_name_table_pool_with_one_subject_tree_qualifies() -> Bool {
  match qualify_bounded_realization(
    reading: rdrq_reading(
      constructed: [rdrq_bounded_index_carrier(), rdrq_subject_tree_carrier()],
      retained_at_return: [],
    ),
  ) {
    BoundedRealizationQualified { subject: _ } => true
    BoundedRealizationRefused { subject: _, failure: _ } => false
  }
}

// The producer as it stands refuses, and it refuses on CONSTRUCTION PEAK with nothing retained.
fn the_live_reference_derived_pool_refuses_at_construction_peak() -> Bool {
  match qualify_bounded_realization(reading: reference_derived_pool_lifecycle_reading) {
    BoundedRealizationQualified { subject: _ } => false
    BoundedRealizationRefused { subject: _, failure: failure } =>
      match failure {
        WholeCorpusSyntaxAtConstructionPeak { carrier: _ } => true
        WholeCorpusSyntaxRetainedAtReturn { carrier: _ } => false
        LifecycleReadingAbsent => false
      }
  }
}

fn the_bounded_specimen_beside_it_qualifies() -> Bool {
  match qualify_bounded_realization(reading: bounded_reference_derived_pool_specimen) {
    BoundedRealizationQualified { subject: _ } => true
    BoundedRealizationRefused { subject: _, failure: _ } => false
  }
}

// RED CONTROL 1 -- the whole-pool-build-then-release specimen. Nothing survives the call, so an
// after-the-fact reading is indistinguishable from the bounded one above; the construction boundary is
// what separates them.
fn a_whole_pool_build_that_releases_before_returning_still_refuses() -> Bool {
  match qualify_bounded_realization(
    reading: rdrq_reading(
      constructed: [rdrq_syntax_carrier(decl_name: "ReferenceDerivedPool")],
      retained_at_return: [],
    ),
  ) {
    BoundedRealizationQualified { subject: _ } => false
    BoundedRealizationRefused { subject: _, failure: failure } =>
      match failure {
        WholeCorpusSyntaxAtConstructionPeak { carrier: _ } => true
        WholeCorpusSyntaxRetainedAtReturn { carrier: _ } => false
        LifecycleReadingAbsent => false
      }
  }
}

// RED CONTROL 2 -- retention moved out of `trees` and into the index. A check written against the
// tree map alone would go green here while the same population stays resident.
fn retention_moved_into_the_symbol_index_still_refuses() -> Bool {
  match qualify_bounded_realization(
    reading: rdrq_reading(
      constructed: [rdrq_subject_tree_carrier(), rdrq_index_syntax_carrier()],
      retained_at_return: [rdrq_index_syntax_carrier()],
    ),
  ) {
    BoundedRealizationQualified { subject: _ } => false
    BoundedRealizationRefused { subject: _, failure: failure } =>
      match failure {
        WholeCorpusSyntaxAtConstructionPeak { carrier: _ } => true
        WholeCorpusSyntaxRetainedAtReturn { carrier: _ } => false
        LifecycleReadingAbsent => false
      }
  }
}

// The retained-at-return arm is reachable on its own: a producer whose construction is bounded but
// which hands back a whole-corpus index refuses at the second boundary rather than the first.
fn a_bounded_build_handing_back_a_whole_corpus_index_refuses_at_return() -> Bool {
  match qualify_bounded_realization(
    reading: rdrq_reading(
      constructed: [rdrq_bounded_index_carrier()],
      retained_at_return: [rdrq_index_syntax_carrier()],
    ),
  ) {
    BoundedRealizationQualified { subject: _ } => false
    BoundedRealizationRefused { subject: _, failure: failure } =>
      match failure {
        WholeCorpusSyntaxAtConstructionPeak { carrier: _ } => false
        WholeCorpusSyntaxRetainedAtReturn { carrier: _ } => true
        LifecycleReadingAbsent => false
      }
  }
}

// RED CONTROL 3 -- an empty reading is not a bound. A qualifier that defaulted to qualified would
// hand every unmeasured producer a pass.
fn an_empty_lifecycle_reading_refuses_rather_than_qualifying() -> Bool {
  match qualify_bounded_realization(reading: rdrq_reading(constructed: [], retained_at_return: [])) {
    BoundedRealizationQualified { subject: _ } => false
    BoundedRealizationRefused { subject: _, failure: failure } =>
      match failure {
        WholeCorpusSyntaxAtConstructionPeak { carrier: _ } => false
        WholeCorpusSyntaxRetainedAtReturn { carrier: _ } => false
        LifecycleReadingAbsent => true
      }
  }
}

// THE CONSUMPTION ARM, which is where the filed class actually bites: semantic delivery of the
// instrument is true and the bounded-realization claim is still not admitted, because the resource
// qualification is a separate argument with no arm that semantic delivery can satisfy.
fn semantic_delivery_alone_does_not_admit_a_bounded_realization_claim() -> Bool {
  match admit_bounded_realization(
    semantic_delivered: true,
    resource: qualify_bounded_realization(reading: reference_derived_pool_lifecycle_reading),
  ) {
    BoundedRealizationAdmitted { subject: _ } => false
    BoundedRealizationSemanticDeliveryOutstanding => false
    BoundedRealizationResourceQualificationOutstanding { failure: _ } => true
  }
}

// And the converse arm, so the admission is not simply unreachable: a qualified resource reading with
// semantic delivery outstanding is also not an admission.
fn resource_qualification_alone_does_not_admit_either() -> Bool {
  match admit_bounded_realization(
    semantic_delivered: false,
    resource: qualify_bounded_realization(reading: bounded_reference_derived_pool_specimen),
  ) {
    BoundedRealizationAdmitted { subject: _ } => false
    BoundedRealizationSemanticDeliveryOutstanding => true
    BoundedRealizationResourceQualificationOutstanding { failure: _ } => false
  }
}

// The positive control for the admission itself.
fn both_evidences_together_admit_the_claim() -> Bool {
  match admit_bounded_realization(
    semantic_delivered: true,
    resource: qualify_bounded_realization(reading: bounded_reference_derived_pool_specimen),
  ) {
    BoundedRealizationAdmitted { subject: _ } => true
    BoundedRealizationSemanticDeliveryOutstanding => false
    BoundedRealizationResourceQualificationOutstanding { failure: _ } => false
  }
}
