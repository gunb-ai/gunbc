module test.claim.ci_materialization_witness

import std.types { Bool, Int, List, String }
import gunbc.ci_materialization { ci_catalog_projection_refusals }
import gunbc.ci_materialization_gate {
  ci_materialization_ladder_holds_live,
  ci_materialization_holds_without_sccache,
  ci_materialization_exempt_identities,
  ci_release_build_demand_count,
  ci_discharged_verdict_count,
  ci_release_build_discharged_by_sccache_count,
  ci_below_cost_floor_verdict_count,
  ci_exempt_fresh_verdict_count,
  ci_release_build_refused_without_provider_count,
  ci_uses_steps_skipped_count,
  ci_run_step_natures_claimed_not_derived_count
}

data ci_materialization_witness_note: String = "The ladder run against the LIVE emitted workflow, enrolled on the CI surface — the see-it-working-up-front requirement (operator, 2026-07-08): shell -> binary with appropriate caching installed or a typed refusal, in the same pipeline the redundancy would otherwise be paid in. The RED control removes the sccache provider row and demands the refusal, so the gate discriminates: it is green because the obligation is DISCHARGED, not because nothing looked."

test fn ci_ladder_holds_on_live_workflow() -> Bool {
  ci_materialization_ladder_holds_live()
}

test fn ci_release_build_is_plural_and_discharged_by_sccache() -> Bool {
  ci_release_build_demand_count() >= 2
    && ci_release_build_discharged_by_sccache_count() == 1
    && ci_discharged_verdict_count() == 1
}

test fn ci_ladder_reds_without_sccache_provider() -> Bool {
  !ci_materialization_holds_without_sccache()
    && ci_release_build_refused_without_provider_count() == 1
}

test fn ci_prelude_scripts_are_typed_cost_floor_acceptances() -> Bool {
  ci_materialization_exempt_identities().count() >= 2
    && ci_below_cost_floor_verdict_count() == 2
}

test fn ci_measurement_is_exempt_fresh_effect() -> Bool {
  ci_exempt_fresh_verdict_count() >= 1
}

test fn ci_catalog_projection_has_no_refusals() -> Bool {
  ci_catalog_projection_refusals() == 0
}

test fn ci_uses_steps_are_counted_not_silent() -> Bool {
  ci_uses_steps_skipped_count() == 6
}

