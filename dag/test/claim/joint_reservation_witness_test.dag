module test.claim.joint_reservation_witness

import std.logic { Bool }
import std.types { NonEmptyStr, List, String }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.nat { Nat }
import std.measure { Measure, Time }
import extdeps.accounting.budget { Appropriation }
import extdeps.accounting.encumbrance {
  EncumbranceLedger, Encumbrance, EncumbranceState, Held,
  EncumbranceOutcome, LedgerAdvanced, EncumbranceRefused,
  EncumbranceRefusal, ExceedsAppropriation, DuplicateReference,
  reserve_encumbrance, committed_total,
}
import product.fabric.joint_reservation {
  JointLedgers, JointReservationOutcome, BothHeld,
  ResourceRefusedJoint, MoneyRefusedJoint,
  reserve_jointly, joint_reservation_holds, joint_reservation_ledgers,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn jr_measure(count: Nat) -> Measure<Time, String, Nat> {
  Measure { count: count }
}

fn jr_ledger(ceiling: Nat) -> EncumbranceLedger<Time, String> {
  EncumbranceLedger {
    appropriation: Appropriation { ceiling: jr_measure(count: ceiling) },
    entries: [],
  }
}

fn jr_pair(resource_ceiling: Nat, money_ceiling: Nat) -> JointLedgers<Time, String, Time, String> {
  JointLedgers {
    resource: jr_ledger(ceiling: resource_ceiling),
    money: jr_ledger(ceiling: money_ceiling),
  }
}

fn jr_committed(ledger: EncumbranceLedger<Time, String>) -> Nat {
  committed_total(ledger: ledger).count
}

// THE POSITIVE CONTROL. Without it every row below is satisfied by a join that
// refuses everything, which is a fabric that can never reserve anything.
test fn a_reservation_both_ledgers_can_cover_holds_on_both() -> Bool {
  match reserve_jointly(
    ledgers: jr_pair(resource_ceiling: 100, money_ceiling: 100),
    reference: "grant-1",
    resource_liability: jr_measure(count: 10),
    money_liability: jr_measure(count: 20),
  ) {
    BothHeld { ledgers: l, reference: _ } =>
      jr_committed(ledger: l.resource) == 10 && jr_committed(ledger: l.money) == 20
    ResourceRefusedJoint { reference: _, refusal: _ } => false
    MoneyRefusedJoint { reference: _, refusal: _ } => false
  }
}

// THE ROW THIS MODULE EXISTS FOR. Money cannot cover; resource easily can, so
// the resource side advances and must then be DISCARDED. If any resource hold
// survived a money refusal, the fabric has encumbered capacity against a grant
// that was never issued and nothing accounts for it.
//
// WHAT THIS ROW DELIBERATELY DOES NOT ASSERT, because the first draft did and it
// was a decoration: "the caller's own ledger is unchanged" CANNOT FAIL HERE. The
// ledgers are pure values, so `before` is immutable by construction and that
// conjunct is permanently green whatever reserve_jointly does. A check whose red
// is unauthorable is worse than an absent one, because it would be cited as the
// guard against exactly the leak it cannot detect.
//
// What IS authorable, and what this asserts: the refusal must yield NOTHING to
// persist. A caller writes back whatever joint_reservation_ledgers returns, so
// an arm that carried the advanced pair would be committed to storage by a
// caller doing exactly the right thing. That is the reachable form of the leak
// in a pure design, and it goes red the moment any refusal arm gains a ledger.
test fn a_money_refusal_yields_nothing_to_persist() -> Bool {
  let outcome = reserve_jointly(
    ledgers: jr_pair(resource_ceiling: 100, money_ceiling: 5),
    reference: "grant-2",
    resource_liability: jr_measure(count: 10),
    money_liability: jr_measure(count: 50),
  )
  !joint_reservation_holds(outcome: outcome)
    && (joint_reservation_ledgers(outcome: outcome) |> count) == 0
    && match outcome {
         MoneyRefusedJoint { reference: _, refusal: _ } => true
         BothHeld { ledgers: _, reference: _ } => false
         ResourceRefusedJoint { reference: _, refusal: _ } => false
       }
}

// The mirror direction. Resource cannot cover, so money must never be touched
// -- the budget must not be encumbered for a grant that has no capacity to run
// on. Both directions are asserted because the arms are separate code and a
// later edit could break one while the other stays green.
test fn a_resource_refusal_never_reaches_the_money_ledger() -> Bool {
  match reserve_jointly(
    ledgers: jr_pair(resource_ceiling: 5, money_ceiling: 100),
    reference: "grant-3",
    resource_liability: jr_measure(count: 50),
    money_liability: jr_measure(count: 10),
  ) {
    ResourceRefusedJoint { reference: _, refusal: _ } =>
      (joint_reservation_ledgers(
         outcome: ResourceRefusedJoint {
           reference: "grant-3",
           refusal: DuplicateReference { reference: "grant-3" },
         }
       ) |> count) == 0
    BothHeld { ledgers: _, reference: _ } => false
    MoneyRefusedJoint { reference: _, refusal: _ } => false
  }
}

// NO REFUSAL YIELDS ANYTHING TO PERSIST. This is the fail-open guard: a caller
// writes back whatever joint_reservation_ledgers returns, so if any refusal arm
// ever produced a pair, a refused reservation would be committed to storage by
// a caller doing exactly the right thing.
test fn no_refusal_yields_ledgers_to_write_back() -> Bool {
  (joint_reservation_ledgers(
     outcome: ResourceRefusedJoint {
       reference: "grant-4",
       refusal: ExceedsAppropriation {
         requested: jr_measure(count: 50),
         committed: jr_measure(count: 0),
         ceiling: jr_measure(count: 5),
       },
     }
   ) |> count) == 0
    && (joint_reservation_ledgers(
         outcome: MoneyRefusedJoint {
           reference: "grant-4",
           refusal: DuplicateReference { reference: "grant-4" },
         }
       ) |> count) == 0
}

// And the positive control for THAT guard, so it is not satisfied by a
// projection that returns empty for every outcome including success.
test fn a_held_reservation_does_yield_ledgers_to_write_back() -> Bool {
  let held = reserve_jointly(
    ledgers: jr_pair(resource_ceiling: 100, money_ceiling: 100),
    reference: "grant-5",
    resource_liability: jr_measure(count: 1),
    money_liability: jr_measure(count: 1),
  )
  joint_reservation_holds(outcome: held)
    && (joint_reservation_ledgers(outcome: held) |> count) == 1
}

// The two refusal causes stay DISTINGUISHABLE. "Resource exceeded" and "money
// exceeded" have different owners and different remedies -- add capacity versus
// raise a budget -- so a caller must be able to tell them apart. One collapsed
// "reservation refused" would make the diagnosis unactionable.
test fn the_two_refusal_sides_are_distinguishable() -> Bool {
  !joint_reservation_holds(
    outcome: reserve_jointly(
      ledgers: jr_pair(resource_ceiling: 5, money_ceiling: 100),
      reference: "grant-6",
      resource_liability: jr_measure(count: 50),
      money_liability: jr_measure(count: 10),
    )
  )
    && !joint_reservation_holds(
         outcome: reserve_jointly(
           ledgers: jr_pair(resource_ceiling: 100, money_ceiling: 5),
           reference: "grant-7",
           resource_liability: jr_measure(count: 10),
           money_liability: jr_measure(count: 50),
         )
       )
}
