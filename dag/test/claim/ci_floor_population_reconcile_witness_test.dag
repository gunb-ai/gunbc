module test.claim.ci_floor_population_reconcile_witness

import std.types { Bool }
import std.measure { millisecond, millisecond_count }
import gunbc.ci_floor_population_reconcile {
  Delivered,
  NotDelivered,
  MissingArtifactOpen,
  MissingRequiredObservation,
  InsufficientAttribution,
  OverAttributed,
  Reconciled,
  harvested_subject_a_reconciliation,
  harvested_subject_a_nested_diagnostic_sum,
  nested_diagnostics_are_not_exclusive_classified,
  over_attributed_specimen,
  remainder_false_green_specimen_refused,
  reconcile_exclusive_against_job_wall,
  admission_settle_from_stage_walls,
  native_fleet_settle_from_transition_counts,
  warm_hit_settle_from_skip_counter,
  current_admission_settle,
  current_native_fleet_settle,
  current_warm_hit_settle,
}

test fn witness_subject_a_missing_exclusive_observations() -> Bool {
  match harvested_subject_a_reconciliation() {
    MissingRequiredObservation { owed: _ } => true
    _ => false
  }
}

test fn witness_nested_diagnostics_not_in_classified() -> Bool {
  nested_diagnostics_are_not_exclusive_classified()
    && millisecond_count(m: harvested_subject_a_nested_diagnostic_sum()) == 606958
}

test fn witness_over_attribution_refuses() -> Bool {
  match over_attributed_specimen() {
    OverAttributed { classified_wall: _, ci_job_wall: _ } => true
    _ => false
  }
}

test fn witness_remainder_cannot_satisfy_ninety_five() -> Bool {
  remainder_false_green_specimen_refused()
}

test fn witness_honest_classified_plus_remainder_is_insufficient() -> Bool {
  match reconcile_exclusive_against_job_wall(
    classified: millisecond(count: 606958),
    ci_job: millisecond(count: 2509000)
  ) {
    InsufficientAttribution { classified_wall: c, unattributed_wall: u, attribution_ratio_basis_points: bp } =>
      millisecond_count(m: c) == 606958
        && millisecond_count(m: u) == 1902042
        && bp == 2419
    _ => false
  }
}

test fn red_over_attribution_must_not_reconcile() -> Bool {
  match over_attributed_specimen() {
    Reconciled { classified_wall: _, unattributed_wall: _, attribution_ratio_basis_points: _ } => false
    _ => true
  }
}

test fn red_remainder_inflate_must_not_pass_bar() -> Bool {
  remainder_false_green_specimen_refused()
}

test fn witness_admission_missing_stages_is_open() -> Bool {
  match current_admission_settle() {
    MissingArtifactOpen { owed: _ } => true
    _ => false
  }
}

test fn witness_admission_delivered_when_stages_join_under_baseline() -> Bool {
  match admission_settle_from_stage_walls(
    capture: millisecond(count: 110820),
    stage1: Present { value: millisecond(count: 40000) },
    stage2: Present { value: millisecond(count: 40000) },
    cold_baseline: millisecond(count: 197130)
  ) {
    Delivered {} => true
    _ => false
  }
}

test fn witness_admission_not_delivered_when_net_exceeds_baseline() -> Bool {
  match admission_settle_from_stage_walls(
    capture: millisecond(count: 110820),
    stage1: Present { value: millisecond(count: 100000) },
    stage2: Present { value: millisecond(count: 100000) },
    cold_baseline: millisecond(count: 197130)
  ) {
    NotDelivered { reason: _ } => true
    _ => false
  }
}

test fn witness_native_missing_tsv_is_open() -> Bool {
  match current_native_fleet_settle() {
    MissingArtifactOpen { owed: _ } => true
    _ => false
  }
}

test fn witness_native_delivered_when_native_equals_selected() -> Bool {
  match native_fleet_settle_from_transition_counts(
    native_count: Present { value: 3 },
    fallback_count: Present { value: 0 },
    selected_count: Present { value: 3 }
  ) {
    Delivered {} => true
    _ => false
  }
}

test fn witness_native_not_delivered_on_fallback() -> Bool {
  match native_fleet_settle_from_transition_counts(
    native_count: Present { value: 0 },
    fallback_count: Present { value: 3 },
    selected_count: Present { value: 3 }
  ) {
    NotDelivered { reason: _ } => true
    _ => false
  }
}

test fn witness_warm_hit_current_is_delivered() -> Bool {
  match current_warm_hit_settle() {
    Delivered {} => true
    _ => false
  }
}

test fn witness_warm_hit_delivered_when_skip_proven() -> Bool {
  match warm_hit_settle_from_skip_counter(skip_proven: Present { value: true }) {
    Delivered {} => true
    _ => false
  }
}
