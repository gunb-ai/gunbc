module test.claim.ci_floor_population_reconcile_witness

import std.types { Bool, String, NonEmptyStr }
import std.measure { millisecond, millisecond_count }
import gunbc.ci_floor_population_reconcile {
  Delivered,
  NotDelivered,
  MissingArtifactOpen,
  MissingRequiredObservation,
  InsufficientAttribution,
  OverAttributed,
  InvalidCiJobWall,
  Reconciled,
  harvested_subject_a_reconciliation,
  harvested_subject_a_nested_diagnostic_sum,
  nested_diagnostics_are_not_exclusive_classified,
  over_attributed_specimen,
  remainder_false_green_specimen_refused,
  reconcile_exclusive_against_job_wall,
  unattributed_within_five_percent,
  admission_settle_from_stage_walls,
  native_fleet_settle_from_transition_counts,
  warm_hit_settle_from_skip_counter,
  current_admission_settle,
  current_native_fleet_settle,
  current_warm_hit_settle,
  current_settlement_receipt,
  current_exclusive_job_reconciliation,
}
import gunbc.ci_floor_population_settlement_receipt {
  banked_admission_observed_total,
  banked_admission_recovery,
  banked_admission_total_matches_review_arithmetic,
  banked_subject_round_trips_wire,
  admission_standing_from_settlement_receipt,
  ExecutedAndAdmitted,
  Improved,
}

test fn witness_subject_a_missing_exclusive_observations() -> Bool {
  match harvested_subject_a_reconciliation() {
    MissingRequiredObservation { owed: _ } => true
    _ => false
  }
}

test fn witness_nested_diagnostics_not_in_classified() -> Bool {
  nested_diagnostics_are_not_exclusive_classified()
    && millisecond_count(m: harvested_subject_a_nested_diagnostic_sum()) == 606958
}

test fn witness_over_attribution_refuses() -> Bool {
  match over_attributed_specimen() {
    OverAttributed { classified_wall: _, ci_job_wall: _ } => true
    _ => false
  }
}

test fn witness_remainder_cannot_satisfy_ninety_five() -> Bool {
  remainder_false_green_specimen_refused()
}

test fn witness_honest_classified_plus_remainder_is_insufficient() -> Bool {
  match reconcile_exclusive_against_job_wall(
    classified: millisecond(count: 606958),
    ci_job: millisecond(count: 2509000)
  ) {
    InsufficientAttribution { classified_wall: c, unattributed_wall: u, attribution_ratio_basis_points: bp } =>
      millisecond_count(m: c) == 606958
        && millisecond_count(m: u) == 1902042
        && bp == 2419
    _ => false
  }
}

test fn red_over_attribution_must_not_reconcile() -> Bool {
  match over_attributed_specimen() {
    Reconciled { classified_wall: _, unattributed_wall: _, attribution_ratio_basis_points: _ } => false
    _ => true
  }
}

test fn red_remainder_inflate_must_not_pass_bar() -> Bool {
  remainder_false_green_specimen_refused()
}

test fn witness_zero_ci_job_wall_refuses() -> Bool {
  match reconcile_exclusive_against_job_wall(
    classified: millisecond(count: 0),
    ci_job: millisecond(count: 0)
  ) {
    InvalidCiJobWall {} => true
    _ => false
  }
}

test fn witness_exact_five_percent_boundary_reconciles() -> Bool {
  unattributed_within_five_percent(unattributed_ms: 500, ci_job_ms: 10000)
    && match reconcile_exclusive_against_job_wall(
      classified: millisecond(count: 9500),
      ci_job: millisecond(count: 10000)
    ) {
      Reconciled { classified_wall: _, unattributed_wall: u, attribution_ratio_basis_points: _ } =>
        millisecond_count(m: u) == 500
      _ => false
    }
}

test fn red_just_over_five_percent_must_not_floor_to_pass() -> Bool {
  !unattributed_within_five_percent(unattributed_ms: 501, ci_job_ms: 10000)
    && match reconcile_exclusive_against_job_wall(
      classified: millisecond(count: 9499),
      ci_job: millisecond(count: 10000)
    ) {
      InsufficientAttribution { classified_wall: _, unattributed_wall: u, attribution_ratio_basis_points: _ } =>
        millisecond_count(m: u) == 501
      _ => false
    }
}

test fn witness_admission_settled_delivered_from_banked_artifact() -> Bool {
  let r = current_settlement_receipt()
  let standing = admission_standing_from_settlement_receipt(r: r)
  banked_admission_total_matches_review_arithmetic(r: r)
    && banked_admission_recovery(r: r) == 78706
    && millisecond_count(m: banked_admission_observed_total(r: r)) == 118424
    && banked_subject_round_trips_wire(r: r)
    && match standing.execution {
      ExecutedAndAdmitted {} => match standing.cost {
        Improved { baseline: b, observed: o, recovered: rec } =>
          millisecond_count(m: b) == 197130
            && millisecond_count(m: o) == 118424
            && millisecond_count(m: rec) == 78706
        _ => false
      }
      _ => false
    }
    && match current_admission_settle() {
      Delivered {} => true
      _ => false
    }
}

test fn witness_admission_delivered_when_stages_join_under_baseline() -> Bool {
  match admission_settle_from_stage_walls(
    capture: millisecond(count: 110820),
    stage1: Present { value: millisecond(count: 40000) },
    stage2: Present { value: millisecond(count: 40000) },
    cold_baseline: millisecond(count: 197130)
  ) {
    Delivered {} => true
    _ => false
  }
}

test fn witness_admission_not_delivered_when_net_exceeds_baseline() -> Bool {
  match admission_settle_from_stage_walls(
    capture: millisecond(count: 110820),
    stage1: Present { value: millisecond(count: 100000) },
    stage2: Present { value: millisecond(count: 100000) },
    cold_baseline: millisecond(count: 197130)
  ) {
    NotDelivered { reason: _ } => true
    _ => false
  }
}

test fn witness_native_settled_not_delivered_from_banked_artifact() -> Bool {
  match current_native_fleet_settle() {
    NotDelivered { reason } => reason as String == "fallback:native_realization_refused"
    _ => false
  }
}

test fn witness_native_delivered_when_full_transition_accepted() -> Bool {
  match native_fleet_settle_from_transition_counts(
    native_count: Present { value: 3 },
    fallback_count: Present { value: 0 },
    selected_count: Present { value: 3 }
  ) {
    Delivered {} => true
    _ => false
  }
}

test fn witness_native_not_delivered_on_fallback() -> Bool {
  match native_fleet_settle_from_transition_counts(
    native_count: Present { value: 0 },
    fallback_count: Present { value: 3 },
    selected_count: Present { value: 3 }
  ) {
    NotDelivered { reason: _ } => true
    _ => false
  }
}

test fn witness_warm_hit_current_is_open_cross_process_absent() -> Bool {
  match current_warm_hit_settle() {
    MissingArtifactOpen { owed } =>
      owed as String == "CrossProcessExecutionReceiptAbsent"
    _ => false
  }
}

test fn witness_warm_hit_delivered_when_skip_proven() -> Bool {
  match warm_hit_settle_from_skip_counter(skip_proven: Present { value: true }) {
    Delivered {} => true
    _ => false
  }
}

test fn witness_banked_run_exclusive_job_reconciles_within_five_percent() -> Bool {
  match current_exclusive_job_reconciliation() {
    Reconciled { classified_wall: c, unattributed_wall: u, attribution_ratio_basis_points: bp } =>
      millisecond_count(m: c) == 2836000
        && millisecond_count(m: u) == 4000
        && bp == 9985
    _ => false
  }
}

test fn red_banked_run_must_not_remain_missing_exclusive() -> Bool {
  match current_exclusive_job_reconciliation() {
    MissingRequiredObservation { owed: _ } => false
    _ => true
  }
}
