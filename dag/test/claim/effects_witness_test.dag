fn tracked_op_derives(op: TrackedRestOp) -> Bool {
  match derive_op_effect(
    operation_name: op.name,
    method: op.method,
    path: parse_ok(raw: op.path)
  ) {
    DerivedEffect { effect: effect } => true
    MalformedPathInput => false
  }
}

fn all_tracked_rest_ops_derive() -> Bool {
  fold(effects_tracked_rest_ops, init: true, f: (acc, op) =>
    acc && tracked_op_derives(op: op)
  )
}

fn tracked_to_derived(op: TrackedRestOp) -> DerivedOpEffect {
  derived_op(name: op.name, method: op.method, raw_path: op.path)
}

fn tracked_idempotent_count() -> Int {
  fold(effects_tracked_rest_ops, init: 0, f: (acc, op) => {
    let d = tracked_to_derived(op: op)
    if is_idempotent_effect(shape: d.shape) { acc + 1 } else { acc }
  })
}

fn every_idempotent_tracked_has_obligation() -> Bool {
  let derived = effects_tracked_rest_ops |> map(op => tracked_to_derived(op: op))
  let obligations = generate_idempotency_obligations(ops: derived)
  fold(derived, init: true, f: (acc, d) => {
    if is_idempotent_effect(shape: d.shape) {
      acc && fold(obligations, init: false, f: (found, o) =>
        found || (o.operation_name == d.operation_name && o.effect_shape == d.shape)
      )
    } else {
      acc
    }
  })
}

test fn effects_path_parse_witnesses() -> Bool {
  let simple = parse_ok(raw: "/repos/\{owner\}/\{repo\}/pulls")
  let colon = parse_ok(raw: "/v1/\{secret_name\}:addVersion")
  let no_params = parse_ok(raw: "/token")
  let nested = parse_ok(raw: "/v1/projects/\{project_id\}/secrets/\{secret\}/versions/\{version\}:access")
  let query_stripped = parse_ok(raw: "/computeMetadata/v1/instance/service-accounts/default/identity?audience=\{audience\}")
  let deep = parse_ok(raw: "/repos/\{owner\}/\{repo\}/pulls/\{pull_number\}/reviews")

  has_path_params(template: simple)
    && match last_path_param(template: simple) {
      Present { value: p } => p == "repo"
      Absent => false
    }
    && has_path_params(template: colon)
    && match last_path_param(template: colon) {
      Present { value: p } => p == "secret_name"
      Absent => false
    }
    && !has_path_params(template: no_params)
    && match last_path_param(template: no_params) { Absent => true Present => false }
    && has_path_params(template: nested)
    && match last_path_param(template: nested) {
      Present { value: p } => p == "version"
      Absent => false
    }
    && !has_path_params(template: query_stripped)
    && has_path_params(template: deep)
    && match last_path_param(template: deep) {
      Present { value: p } => p == "pull_number"
      Absent => false
    }
    && parse_malformed(raw: concat("/repos/", "{", "owner/pulls"))
    && parse_malformed(raw: concat("/repos/owner", "}", "/pulls"))
    && parse_malformed(raw: concat("/v1/", "{", "project", "}", "{", "secret", "}"))
}

test fn effects_derivation_witnesses() -> Bool {
  is_read(shape: derived_op(name: "List", method: GET, raw_path: "/repos/\{owner\}/\{repo\}/pulls").shape)
    && is_create(shape: derived_op(name: "CreateSecret", method: POST, raw_path: "/v1/projects/\{project_id\}/secrets").shape)
    && is_create(shape: derived_op(name: "Messages", method: POST, raw_path: "/v1/messages").shape)
    && is_upsert(shape: derived_op(name: "Update", method: PUT, raw_path: "/repos/\{owner\}/\{repo\}/pulls/\{pull_number\}").shape)
    && is_create(shape: derived_op(name: "Update", method: PUT, raw_path: "/config").shape)
    && is_delete(shape: derived_op(name: "DeleteItem", method: DELETE, raw_path: "/items/\{id\}").shape)
    && is_create(shape: derived_op(name: "Purge", method: DELETE, raw_path: "/cache").shape)
    && match derive_op_effect(
      operation_name: "TypedBoundary",
      method: PUT,
      path: parse_ok(raw: "/repos/\{owner\}/\{repo\}")
    ) {
      DerivedEffect { effect: effect } => true
      MalformedPathInput => false
    }
}

test fn effects_compose_witnesses() -> Bool {
  composition_is_idempotent(v: compose_effects(effects: []))
    && composition_is_idempotent(v: compose_effects(effects: [op_lattice_read(name: "a"), op_lattice_read(name: "b")]))
    && !composition_is_idempotent(v: compose_effects(effects: [
      op_lattice_read(name: "first"),
      op_non_idempotent(name: "breaker"),
      op_non_idempotent(name: "later")
    ]))
    && composition_first_breaker_name(v: compose_effects(effects: [
      op_lattice_read(name: "first"),
      op_non_idempotent(name: "breaker"),
      op_non_idempotent(name: "later")
    ])) == "breaker"
}

test fn effects_idempotency_obligation_witnesses() -> Bool {
  let derived = effects_tracked_rest_ops |> map(op => tracked_to_derived(op: op))
  let obligations = generate_idempotency_obligations(ops: derived)
  (obligations |> length) == tracked_idempotent_count()
    && every_idempotent_tracked_has_obligation()
}

test fn effects_modifier_github_readonly_witnesses() -> Bool {
  let readonly_gets = [
    ReadonlyGetCase { name: "List", path: "/repos/\{owner\}/\{repo\}/pulls" },
    ReadonlyGetCase { name: "Get", path: "/repos/\{owner\}/\{repo\}/pulls/\{pull_number\}" },
    ReadonlyGetCase { name: "Diff", path: "/repos/\{owner\}/\{repo\}/pulls/\{pull_number\}" },
    ReadonlyGetCase { name: "ListReviews", path: "/repos/\{owner\}/\{repo\}/pulls/\{pull_number\}/reviews" },
    ReadonlyGetCase { name: "ListComments", path: "/repos/\{owner\}/\{repo\}/pulls/\{pull_number\}/comments" },
  ]
  fold(readonly_gets, init: true, f: (acc, case) => {
    let mc = check_modifier_vs_derivation(
      op: derived_op(name: case.name, method: GET, raw_path: case.path),
      declared_idempotent: false,
      declared_readonly: true
    )
    acc
      && match mc.agreement { Agrees => true _ => false }
      && mc.declared_readonly
  })
}

test fn effects_modifier_gcp_sites_witnesses() -> Bool {
  let access = derived_op(
    name: "AccessVersion",
    method: GET,
    raw_path: "/v1/projects/\{project_id\}/secrets/\{secret\}/versions/\{version\}:access"
  )
  let access_check = check_modifier_vs_derivation(op: access, declared_idempotent: true, declared_readonly: true)

  let add = derived_op(name: "AddVersion", method: POST, raw_path: "/v1/\{secret_name\}:addVersion")
  let add_check = check_modifier_vs_derivation(op: add, declared_idempotent: true, declared_readonly: false)

  let gen = derived_op(
    name: "GenerateAccessToken",
    method: POST,
    raw_path: "/v1/projects/-/serviceAccounts/\{target_sa\}:generateAccessToken"
  )
  let gen_check = check_modifier_vs_derivation(op: gen, declared_idempotent: true, declared_readonly: false)

  let refresh = derived_op(name: "Refresh", method: POST, raw_path: "/token")
  let refresh_check = check_modifier_vs_derivation(op: refresh, declared_idempotent: true, declared_readonly: false)

  let exchange = derived_op(name: "Exchange", method: POST, raw_path: "/v1/token")
  let exchange_check = check_modifier_vs_derivation(op: exchange, declared_idempotent: true, declared_readonly: false)

  match access_check.agreement { Agrees => true _ => false }
    && is_create(shape: add.shape)
    && match add_check.agreement { DerivationUnknown { reason: reason } => true _ => false }
    && is_create(shape: gen.shape)
    && match gen_check.agreement { DerivationUnknown { reason: reason } => true _ => false }
    && is_create(shape: refresh.shape)
    && match refresh_check.agreement { DerivationUnknown { reason: reason } => true _ => false }
    && is_create(shape: exchange.shape)
    && match exchange_check.agreement { DerivationUnknown { reason: reason } => true _ => false }
}

test fn effects_post_parent_path_witnesses() -> Bool {
  is_create(shape: derived_op(name: "CreateSecret", method: POST, raw_path: "/v1/projects/\{project_id\}/secrets").shape)
    && is_create(shape: derived_op(
      name: "CreateComment",
      method: POST,
      raw_path: "/repos/\{owner\}/\{repo\}/issues/\{issue_number\}/comments"
    ).shape)
    && is_create(shape: derived_op(
      name: "CreateReview",
      method: POST,
      raw_path: "/repos/\{owner\}/\{repo\}/pulls/\{pull_number\}/reviews"
    ).shape)
}

test fn effects_create_comment_path_witness() -> Bool {
  let cc_path = "/repos/\{owner\}/\{repo\}/issues/\{issue_number\}/comments"
  string_contains(s: cc_path, pattern: "/issues/")
    && string_contains(s: cc_path, pattern: "\{issue_number\}")
}

test fn effects_create_if_absent_dedup_witnesses() -> Bool {
  let key = InputField { field: "id" }
  let shape = CreateEffect { cause: CreateIfAbsent { key_source: key } }
  let key_b = InputField { field: "b" }
  let shape_b = CreateEffect { cause: CreateIfAbsent { key_source: key_b } }
  let always = CreateEffect { cause: PostAlways }

  is_idempotent_effect(shape: shape)
    && create_effect_is_dedupable(shape: shape)
    && create_double_init_collapsible(a: shape, b: shape)
    && create_effect_is_dedupable(shape: shape_b)
    && !create_double_init_collapsible(a: shape, b: shape_b)
    && !is_idempotent_effect(shape: always)
    && !create_effect_is_dedupable(shape: always)
    && !create_double_init_collapsible(a: always, b: always)
}

test fn effects_create_if_absent_modifier_witnesses() -> Bool {
  let key = InputField { field: "id" }
  let shape = CreateEffect { cause: CreateIfAbsent { key_source: key } }
  let op = DerivedOpEffect {
    operation_name: "create_secret",
    method: POST,
    path_template: parse_ok(raw: "/secrets"),
    shape: shape
  }
  let agrees = check_modifier_vs_derivation(op: op, declared_idempotent: true, declared_readonly: false)
  let disagrees = check_modifier_vs_derivation(op: op, declared_idempotent: false, declared_readonly: false)
  let always_op = DerivedOpEffect {
    operation_name: "add_version",
    method: POST,
    path_template: parse_ok(raw: "/versions"),
    shape: CreateEffect { cause: PostAlways }
  }
  let unknown = check_modifier_vs_derivation(op: always_op, declared_idempotent: true, declared_readonly: false)

  match agrees.agreement { Agrees => true _ => false }
    && match disagrees.agreement { Disagrees { reason: reason } => true _ => false }
    && match unknown.agreement { DerivationUnknown { reason: reason } => true _ => false }
}

test fn effects_rest_transport_witnesses() -> Bool {
  all_tracked_rest_ops_derive()
    && fingerprints_all_unique(ops: effects_rest_authority_corpus)
    && fingerprints_all_unique(ops: effects_tracked_rest_ops |> map(op =>
      RestFingerprint { service: op.service, name: op.name, method: op.method, path: op.path }
    ))
}
