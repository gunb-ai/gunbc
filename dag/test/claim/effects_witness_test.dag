module test.claim.effects_witness_test


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

type ReadonlyGetCase {
  name: String
  path: String
}

fn derived_op(name: String, method: std.types.HttpMethod, path: std.http_path.PathTemplate) -> std.effects.DerivedOpEffect {
  match std.effects.derive_op_effect(operation_name: name, method: method, path: path) {
    std.effects.DerivedEffect { effect: e } => e
    std.effects.MalformedPathInput => std.effects.DerivedOpEffect {
      operation_name: name,
      method: method,
      path_template: path,
      shape: std.effects.AppendEffect
    }
  }
}

fn derived_raw_is_read(name: String, method: std.types.HttpMethod, raw: String) -> Bool {
  match extdeps.uri_path.parse_path_template(raw: raw) {
    extdeps.uri_path.ParsedPathTemplate { template: path } => is_read(shape: derived_op(name: name, method: method, path: path).shape)
    extdeps.uri_path.MalformedPathTemplate => false
  }
}

fn derived_raw_is_create(name: String, method: std.types.HttpMethod, raw: String) -> Bool {
  match extdeps.uri_path.parse_path_template(raw: raw) {
    extdeps.uri_path.ParsedPathTemplate { template: path } => is_create(shape: derived_op(name: name, method: method, path: path).shape)
    extdeps.uri_path.MalformedPathTemplate => false
  }
}

fn derived_raw_is_upsert(name: String, method: std.types.HttpMethod, raw: String) -> Bool {
  match extdeps.uri_path.parse_path_template(raw: raw) {
    extdeps.uri_path.ParsedPathTemplate { template: path } => is_upsert(shape: derived_op(name: name, method: method, path: path).shape)
    extdeps.uri_path.MalformedPathTemplate => false
  }
}

fn derived_raw_is_delete(name: String, method: std.types.HttpMethod, raw: String) -> Bool {
  match extdeps.uri_path.parse_path_template(raw: raw) {
    extdeps.uri_path.ParsedPathTemplate { template: path } => is_delete(shape: derived_op(name: name, method: method, path: path).shape)
    extdeps.uri_path.MalformedPathTemplate => false
  }
}

fn derived_raw_modifier_agrees(name: String, method: std.types.HttpMethod, raw: String, declared_idempotent: Bool, declared_readonly: Bool) -> Bool {
  match extdeps.uri_path.parse_path_template(raw: raw) {
    extdeps.uri_path.ParsedPathTemplate { template: path } =>
      match std.effects.check_modifier_vs_derivation(
        op: derived_op(name: name, method: method, path: path),
        declared_idempotent: declared_idempotent,
        declared_readonly: declared_readonly
      ).agreement { std.effects.Agrees => true _ => false }
    extdeps.uri_path.MalformedPathTemplate => false
  }
}

fn derived_raw_modifier_unknown(name: String, method: std.types.HttpMethod, raw: String, declared_idempotent: Bool, declared_readonly: Bool) -> Bool {
  match extdeps.uri_path.parse_path_template(raw: raw) {
    extdeps.uri_path.ParsedPathTemplate { template: path } =>
      match std.effects.check_modifier_vs_derivation(
        op: derived_op(name: name, method: method, path: path),
        declared_idempotent: declared_idempotent,
        declared_readonly: declared_readonly
      ).agreement { std.effects.DerivationUnknown { reason: reason } => true _ => false }
    extdeps.uri_path.MalformedPathTemplate => false
  }
}

fn is_read(shape: std.effects.EffectShape<std.effects.KeySource>) -> Bool {
  match shape {
    std.effects.ReadEffect => true
    _ => false
  }
}

fn is_create(shape: std.effects.EffectShape<std.effects.KeySource>) -> Bool {
  match shape {
    std.effects.CreateEffect { cause: cause } => true
    _ => false
  }
}

data keyless_fallback_witness_note: String = "Discriminating control for the PostAlways state-space conflation (std.effects.keyless_fallback_cause_note). Pre-fix, derive_effect_shape answered CreateEffect{PostAlways} for a real POST AND for a keyless PUT/PATCH/DELETE, so this projection was inexpressible and the originating method was lost. These rows go RED if the two causes ever collapse back together, and the negative arms prove the method is genuinely carried rather than defaulted."

fn derived_cause_is_keyless_with_method(shape: std.effects.EffectShape<std.effects.KeySource>, expected: std.types.HttpMethod) -> Bool {
  match shape {
    std.effects.CreateEffect { cause: cause } =>
      match cause {
        std.effects.KeylessFallback { method: m } =>
          match m {
            std.types.GET => match expected { std.types.GET => true, _ => false }
            std.types.POST => match expected { std.types.POST => true, _ => false }
            std.types.PUT => match expected { std.types.PUT => true, _ => false }
            std.types.DELETE => match expected { std.types.DELETE => true, _ => false }
            _ => false
          }
        std.effects.PostAlways => false
        std.effects.CreateIfAbsent { key_source: key_source } => false
      }
    _ => false
  }
}

fn derived_cause_is_post_always(shape: std.effects.EffectShape<std.effects.KeySource>) -> Bool {
  match shape {
    std.effects.CreateEffect { cause: cause } =>
      match cause {
        std.effects.PostAlways => true
        std.effects.KeylessFallback { method: m } => false
        std.effects.CreateIfAbsent { key_source: key_source } => false
      }
    _ => false
  }
}

fn derived_raw_cause_is_keyless_with_method(name: String, method: std.types.HttpMethod, raw: String, expected: std.types.HttpMethod) -> Bool {
  match extdeps.uri_path.parse_path_template(raw: raw) {
    extdeps.uri_path.ParsedPathTemplate { template: path } =>
      match std.effects.derive_op_effect(operation_name: name, method: method, path: path) {
        std.effects.DerivedEffect { effect: effect } => derived_cause_is_keyless_with_method(shape: effect.shape, expected: expected)
        std.effects.MalformedPathInput => false
      }
    extdeps.uri_path.MalformedPathTemplate => false
  }
}

fn derived_raw_cause_is_post_always(name: String, method: std.types.HttpMethod, raw: String) -> Bool {
  match extdeps.uri_path.parse_path_template(raw: raw) {
    extdeps.uri_path.ParsedPathTemplate { template: path } =>
      match std.effects.derive_op_effect(operation_name: name, method: method, path: path) {
        std.effects.DerivedEffect { effect: effect } => derived_cause_is_post_always(shape: effect.shape)
        std.effects.MalformedPathInput => false
      }
    extdeps.uri_path.MalformedPathTemplate => false
  }
}

fn is_upsert(shape: std.effects.EffectShape<std.effects.KeySource>) -> Bool {
  match shape {
    std.effects.UpsertEffect { key_source: key_source } => true
    _ => false
  }
}

fn is_delete(shape: std.effects.EffectShape<std.effects.KeySource>) -> Bool {
  match shape {
    std.effects.DeleteEffect { key_source: key_source } => true
    _ => false
  }
}

fn op_lattice_read(name: String) -> std.effects.OperationEffect {
  std.effects.OperationEffect {
    operation_name: name,
    shape: std.effects.ReadEffect,
    evidence: std.effects.LatticeEffect { shape: std.effects.ReadEffect }
  }
}

fn op_non_idempotent(name: String) -> std.effects.OperationEffect {
  std.effects.OperationEffect {
    operation_name: name,
    shape: std.effects.CreateEffect { cause: std.effects.PostAlways },
    evidence: std.effects.NonIdempotent {
      shape: std.effects.CreateEffect { cause: std.effects.PostAlways },
      reason: "test"
    }
  }
}

test fn effects_path_parse_witnesses() -> Bool {
  match extdeps.uri_path.parse_path_template(raw: "/repos/\{owner\}/\{repo\}/pulls") {
    extdeps.uri_path.ParsedPathTemplate { template: simple } =>
      match extdeps.uri_path.parse_path_template(raw: "/v1/\{secret_name\}:addVersion") {
        extdeps.uri_path.ParsedPathTemplate { template: colon } =>
          match extdeps.uri_path.parse_path_template(raw: "/token") {
            extdeps.uri_path.ParsedPathTemplate { template: no_params } =>
              match extdeps.uri_path.parse_path_template(raw: "/v1/projects/\{project_id\}/secrets/\{secret\}/versions/\{version\}:access") {
                extdeps.uri_path.ParsedPathTemplate { template: nested } =>
                  match extdeps.uri_path.parse_path_template(raw: "/computeMetadata/v1/instance/service-accounts/default/identity?audience=\{audience\}") {
                    extdeps.uri_path.ParsedPathTemplate { template: query_stripped } =>
                      match extdeps.uri_path.parse_path_template(raw: "/repos/\{owner\}/\{repo\}/pulls/\{pull_number\}/reviews") {
                        extdeps.uri_path.ParsedPathTemplate { template: deep } =>
                          std.http_path.has_path_params(template: simple)
                            && match std.http_path.last_path_param(template: simple) {
                              Present { value: p } => p == "repo"
                              Absent => false
                            }
                            && std.http_path.has_path_params(template: colon)
                            && match std.http_path.last_path_param(template: colon) {
                              Present { value: p } => p == "secret_name"
                              Absent => false
                            }
                            && !std.http_path.has_path_params(template: no_params)
                            && match std.http_path.last_path_param(template: no_params) { Absent => true Present => false }
                            && std.http_path.has_path_params(template: nested)
                            && match std.http_path.last_path_param(template: nested) {
                              Present { value: p } => p == "version"
                              Absent => false
                            }
                            && !std.http_path.has_path_params(template: query_stripped)
                            && std.http_path.has_path_params(template: deep)
                            && match std.http_path.last_path_param(template: deep) {
                              Present { value: p } => p == "pull_number"
                              Absent => false
                            }
                            && match extdeps.uri_path.parse_path_template(raw: concat("/repos/", "{", "owner/pulls")) {
                              extdeps.uri_path.MalformedPathTemplate => true
                              extdeps.uri_path.ParsedPathTemplate => false
                            }
                            && match extdeps.uri_path.parse_path_template(raw: concat("/repos/owner", "}", "/pulls")) {
                              extdeps.uri_path.MalformedPathTemplate => true
                              extdeps.uri_path.ParsedPathTemplate => false
                            }
                            && match extdeps.uri_path.parse_path_template(raw: concat("/v1/", "{", "project", "}", "{", "secret", "}")) {
                              extdeps.uri_path.MalformedPathTemplate => true
                              extdeps.uri_path.ParsedPathTemplate => false
                            }
                        extdeps.uri_path.MalformedPathTemplate => false
                      }
                    extdeps.uri_path.MalformedPathTemplate => false
                  }
                extdeps.uri_path.MalformedPathTemplate => false
              }
            extdeps.uri_path.MalformedPathTemplate => false
          }
        extdeps.uri_path.MalformedPathTemplate => false
      }
    extdeps.uri_path.MalformedPathTemplate => false
  }
}

test fn effects_derivation_witnesses() -> Bool {
  derived_raw_is_read(name: "List", method: std.types.GET, raw: "/repos/\{owner\}/\{repo\}/pulls")
    && derived_raw_is_create(name: "CreateSecret", method: std.types.POST, raw: "/v1/projects/\{project_id\}/secrets")
    && derived_raw_is_create(name: "Messages", method: std.types.POST, raw: "/v1/messages")
    && derived_raw_is_upsert(name: "Update", method: std.types.PUT, raw: "/repos/\{owner\}/\{repo\}/pulls/\{pull_number\}")
    && derived_raw_is_create(name: "Update", method: std.types.PUT, raw: "/config")
    && derived_raw_is_delete(name: "DeleteItem", method: std.types.DELETE, raw: "/items/\{id\}")
    && derived_raw_is_create(name: "Purge", method: std.types.DELETE, raw: "/cache")
    && match extdeps.uri_path.parse_path_template(raw: "/repos/\{owner\}/\{repo\}") {
      extdeps.uri_path.ParsedPathTemplate { template: path } =>
        match std.effects.derive_op_effect(operation_name: "TypedBoundary", method: std.types.PUT, path: path) {
          std.effects.DerivedEffect { effect: effect } => true
          std.effects.MalformedPathInput => false
        }
      extdeps.uri_path.MalformedPathTemplate => false
    }
}

test fn effects_keyless_fallback_is_not_post_witnesses() -> Bool {
  derived_raw_cause_is_keyless_with_method(name: "Update", method: std.types.PUT, raw: "/config", expected: std.types.PUT)
    && derived_raw_cause_is_keyless_with_method(name: "Purge", method: std.types.DELETE, raw: "/cache", expected: std.types.DELETE)
    && !derived_raw_cause_is_keyless_with_method(name: "Update", method: std.types.PUT, raw: "/config", expected: std.types.DELETE)
    && derived_raw_cause_is_post_always(name: "Messages", method: std.types.POST, raw: "/v1/messages")
    && !derived_raw_cause_is_keyless_with_method(name: "Messages", method: std.types.POST, raw: "/v1/messages", expected: std.types.POST)
    && !derived_raw_cause_is_post_always(name: "Update", method: std.types.PUT, raw: "/config")
    && derived_raw_is_upsert(name: "Update", method: std.types.PUT, raw: "/repos/\{owner\}/\{repo\}/pulls/\{pull_number\}")
    && derived_raw_is_delete(name: "DeleteItem", method: std.types.DELETE, raw: "/items/\{id\}")
}

test fn effects_compose_witnesses() -> Bool {
  match std.effects.compose_effects(effects: []) {
    std.effects.IdempotentComposition => true
    std.effects.BrokenBy { first_breaker: breaker } => false
  }
    && match std.effects.compose_effects(effects: [op_lattice_read(name: "a"), op_lattice_read(name: "b")]) {
      std.effects.IdempotentComposition => true
      std.effects.BrokenBy { first_breaker: breaker } => false
    }
    && match std.effects.compose_effects(effects: [
      op_lattice_read(name: "first"),
      op_non_idempotent(name: "breaker"),
      op_non_idempotent(name: "later")
    ]) {
      std.effects.BrokenBy { first_breaker: breaker } => breaker.operation_name == "breaker"
      std.effects.IdempotentComposition => false
    }
}

test fn effects_modifier_github_readonly_witnesses() -> Bool {
  let readonly_gets = [
    ReadonlyGetCase { name: "List", path: "/repos/\{owner\}/\{repo\}/pulls" },
    ReadonlyGetCase { name: "Get", path: "/repos/\{owner\}/\{repo\}/pulls/\{pull_number\}" },
    ReadonlyGetCase { name: "Diff", path: "/repos/\{owner\}/\{repo\}/pulls/\{pull_number\}" },
    ReadonlyGetCase { name: "ListReviews", path: "/repos/\{owner\}/\{repo\}/pulls/\{pull_number\}/reviews" },
    ReadonlyGetCase { name: "ListComments", path: "/repos/\{owner\}/\{repo\}/pulls/\{pull_number\}/comments" },
  ]
  fold(readonly_gets, init: true, f: (acc, case) => {
    acc && derived_raw_modifier_agrees(
      name: case.name,
      method: std.types.GET,
      raw: case.path,
      declared_idempotent: false,
      declared_readonly: true
    )
  })
}

test fn effects_modifier_gcp_sites_witnesses() -> Bool {
  derived_raw_modifier_agrees(
    name: "AccessVersion",
    method: std.types.GET,
    raw: "/v1/projects/\{project_id\}/secrets/\{secret\}/versions/\{version\}:access",
    declared_idempotent: true,
    declared_readonly: true
  )
    && derived_raw_is_create(name: "AddVersion", method: std.types.POST, raw: "/v1/\{secret_name\}:addVersion")
    && derived_raw_modifier_agrees(
      name: "AddVersion",
      method: std.types.POST,
      raw: "/v1/\{secret_name\}:addVersion",
      declared_idempotent: false,
      declared_readonly: false
    )
    && derived_raw_is_create(
      name: "GenerateAccessToken",
      method: std.types.POST,
      raw: "/v1/projects/-/serviceAccounts/\{target_sa\}:generateAccessToken"
    )
    && derived_raw_modifier_unknown(
      name: "GenerateAccessToken",
      method: std.types.POST,
      raw: "/v1/projects/-/serviceAccounts/\{target_sa\}:generateAccessToken",
      declared_idempotent: true,
      declared_readonly: false
    )
    && derived_raw_is_create(name: "Refresh", method: std.types.POST, raw: "/token")
    && derived_raw_modifier_unknown(
      name: "Refresh",
      method: std.types.POST,
      raw: "/token",
      declared_idempotent: true,
      declared_readonly: false
    )
    && derived_raw_is_create(name: "Exchange", method: std.types.POST, raw: "/v1/token")
    && derived_raw_modifier_unknown(
      name: "Exchange",
      method: std.types.POST,
      raw: "/v1/token",
      declared_idempotent: true,
      declared_readonly: false
    )
}

test fn effects_post_parent_path_witnesses() -> Bool {
  derived_raw_is_create(name: "CreateSecret", method: std.types.POST, raw: "/v1/projects/\{project_id\}/secrets")
    && derived_raw_is_create(
      name: "CreateComment",
      method: std.types.POST,
      raw: "/repos/\{owner\}/\{repo\}/issues/\{issue_number\}/comments"
    )
    && derived_raw_is_create(
      name: "CreateReview",
      method: std.types.POST,
      raw: "/repos/\{owner\}/\{repo\}/pulls/\{pull_number\}/reviews"
    )
}

test fn effects_create_if_absent_dedup_witnesses() -> Bool {
  let key = std.effects.InputField { field: "id" }
  let shape = std.effects.CreateEffect { cause: std.effects.CreateIfAbsent { key_source: key } }
  let key_b = std.effects.InputField { field: "b" }
  let shape_b = std.effects.CreateEffect { cause: std.effects.CreateIfAbsent { key_source: key_b } }
  let always = std.effects.CreateEffect { cause: std.effects.PostAlways }

  std.effects.is_idempotent_effect(shape: shape)
    && std.effects.create_effect_is_dedupable(shape: shape)
    && std.effects.create_double_init_collapsible(a: shape, b: shape)
    && std.effects.create_effect_is_dedupable(shape: shape_b)
    && !std.effects.create_double_init_collapsible(a: shape, b: shape_b)
    && !std.effects.is_idempotent_effect(shape: always)
    && !std.effects.create_effect_is_dedupable(shape: always)
    && !std.effects.create_double_init_collapsible(a: always, b: always)
}

test fn effects_create_if_absent_modifier_witnesses() -> Bool {
  let key = std.effects.InputField { field: "id" }
  let shape = std.effects.CreateEffect { cause: std.effects.CreateIfAbsent { key_source: key } }
  match extdeps.uri_path.parse_path_template(raw: "/secrets") {
    extdeps.uri_path.ParsedPathTemplate { template: secrets_path } =>
      match extdeps.uri_path.parse_path_template(raw: "/versions") {
        extdeps.uri_path.ParsedPathTemplate { template: versions_path } =>
          let op = std.effects.DerivedOpEffect {
            operation_name: "create_secret",
            method: std.types.POST,
            path_template: secrets_path,
            shape: shape
          }
          let agrees = std.effects.check_modifier_vs_derivation(op: op, declared_idempotent: true, declared_readonly: false)
          let disagrees = std.effects.check_modifier_vs_derivation(op: op, declared_idempotent: false, declared_readonly: false)
          let always_op = std.effects.DerivedOpEffect {
            operation_name: "add_version",
            method: std.types.POST,
            path_template: versions_path,
            shape: std.effects.CreateEffect { cause: std.effects.PostAlways }
          }
          let unknown = std.effects.check_modifier_vs_derivation(op: always_op, declared_idempotent: true, declared_readonly: false)
          match agrees.agreement { std.effects.Agrees => true _ => false }
            && match disagrees.agreement { std.effects.Disagrees { reason: reason } => true _ => false }
            && match unknown.agreement { std.effects.DerivationUnknown { reason: reason } => true _ => false }
        extdeps.uri_path.MalformedPathTemplate => false
      }
    extdeps.uri_path.MalformedPathTemplate => false
  }
}
