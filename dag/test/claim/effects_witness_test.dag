module test.claim.effects_witness_test

import std.types { HttpMethod, GET, POST, PUT, DELETE, String, List, Bool }
import std.http_path { PathTemplate, has_path_params, last_path_param }
import extdeps.uri_path {
  parse_path_template,
  ParsedPathTemplate,
  MalformedPathTemplate,
}
import std.effects {
  EffectShape, ReadEffect, UpsertEffect, DeleteEffect, CreateEffect, AppendEffect,
  CreateCause, PostAlways, CreateIfAbsent,
  KeySource, PathParam, InputField,
  DerivedOpEffect, DeriveOpEffectResult, DerivedEffect, MalformedPathInput,
  derive_op_effect, check_modifier_vs_derivation,
  compose_effects, OperationEffect, CompositionVerdict,
  IdempotentComposition, BrokenBy,
  composition_is_idempotent, composition_first_breaker_name,
  IdempotencyEvidence, LatticeEffect, NonIdempotent,
  ModifierAgreement, Agrees, Disagrees, DerivationUnknown,
  is_idempotent_effect, create_effect_is_dedupable, create_double_init_collapsible,
  generate_idempotency_obligations,
}

data effects_witness_provenance: String = "Floor witnesses migrated from src/v1/tests/src/effects.rs (5-test-migration lane): effect-shape derivation, idempotency, modifier agreement, compose verdicts, and cited REST-transport authority rows — marker-discovered instead of the v1 Rust harness."

type RestFingerprint {
  service: String
  name: String
  method: HttpMethod
  path: String
}

type TrackedRestOp {
  service: String
  name: String
  method: HttpMethod
  path: String
}

type ReadonlyGetCase {
  name: String
  path: String
}

fn parse_ok(raw: String) -> PathTemplate {
  match parse_path_template(raw: raw) {
    ParsedPathTemplate { template: t } => t
    MalformedPathTemplate => PathTemplate { tokens: [] }
  }
}

fn parse_malformed(raw: String) -> Bool {
  match parse_path_template(raw: raw) {
    MalformedPathTemplate => true
    ParsedPathTemplate => false
  }
}

fn derived_op(name: String, method: HttpMethod, raw_path: String) -> DerivedOpEffect {
  let path = parse_ok(raw: raw_path)
  match derive_op_effect(operation_name: name, method: method, path: path) {
    DerivedEffect { effect: e } => e
    MalformedPathInput => DerivedOpEffect {
      operation_name: name,
      method: method,
      path_template: path,
      shape: AppendEffect
    }
  }
}

fn is_read(shape: EffectShape) -> Bool {
  match shape {
    ReadEffect => true
    _ => false
  }
}

fn is_create(shape: EffectShape) -> Bool {
  match shape {
    CreateEffect { cause: cause } => true
    _ => false
  }
}

fn is_create_always(shape: EffectShape) -> Bool {
  match shape {
    CreateEffect { cause: PostAlways } => true
    _ => false
  }
}

fn is_upsert(shape: EffectShape) -> Bool {
  match shape {
    UpsertEffect { key_source: key_source } => true
    _ => false
  }
}

fn is_delete(shape: EffectShape) -> Bool {
  match shape {
    DeleteEffect { key_source: key_source } => true
    _ => false
  }
}

fn op_lattice_read(name: String) -> OperationEffect {
  OperationEffect {
    operation_name: name,
    shape: ReadEffect,
    evidence: LatticeEffect { shape: ReadEffect }
  }
}

fn op_non_idempotent(name: String) -> OperationEffect {
  OperationEffect {
    operation_name: name,
    shape: CreateEffect { cause: PostAlways },
    evidence: NonIdempotent {
      shape: CreateEffect { cause: PostAlways },
      reason: "test"
    }
  }
}

fn fp_eq(a: RestFingerprint, b: RestFingerprint) -> Bool {
  a.service == b.service
    && a.name == b.name
    && a.method == b.method
    && a.path == b.path
}

fn fp_count(ops: List<RestFingerprint>, target: RestFingerprint) -> Int {
  fold(ops, init: 0, f: (acc, op) => if fp_eq(a: op, b: target) { acc + 1 } else { acc })
}

fn fingerprints_all_unique(ops: List<RestFingerprint>) -> Bool {
  fold(ops, init: true, f: (acc, candidate) =>
    acc && fp_count(ops: ops, target: candidate) == 1
  )
}

