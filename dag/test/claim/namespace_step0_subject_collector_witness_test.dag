module test.claim.namespace_step0_subject_collector_witness

import std.types { Bool, Int, List, NonEmptyStr, String }
import extdeps.git.object_store { GitObjectId, git_sha1_object_id, git_object_id_eq }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import tools.multi_module_compile_fixture { FixtureSource }
import gunbc.namespace_step0_canary {
  namespace_step0_canary_contract,
  namespace_step0_manifest_identity
}
import gunbc.namespace_step0_subject_collector {
  Step0SubjectVector,
  Step0SubjectCollection,
  Step0SubjectCollected,
  Step0SubjectCollectionRefused,
  Step0SubjectPinRefusal,
  Step0SubjectVectorEmpty,
  Step0CommitIdentityUnreadable,
  Step0TreeIdentityUnreadable,
  Step0HeadCommitUnreadable,
  Step0HeadTreeUnreadable,
  Step0TreePathsUnreadable,
  Step0SourceUnreadableAtTree,
  assemble_step0_subject_vector,
  step0_subject_paths_at,
  step0_subject_vector_paths,
  step0_subject_vector_size
}

// EVERY WITNESS IN THIS ENTRY IS PURE. The collector's live half reads the git object store, and a
// probe of it belongs where a route that can reach that effect runs it; it lives in
// test.claim.long.namespace_step0_subject_collector_live, beside the measurement that admitted it.
data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn well_formed_commit_hex() -> String {
  "20caf4eb0477c5a46d5b0d1302e337db14fcbd59"
}

fn well_formed_tree_hex() -> String {
  "a6a6e0a531e23cc88fbbe01a2fa582b84867c625"
}

fn one_source() -> List<FixtureSource> {
  [FixtureSource { path: "dag/std/types.dag" as NonEmptyStr, content: "module std.types\n" }]
}

fn refusal_is_empty_subject(c: Step0SubjectCollection) -> Bool {
  match c {
    Step0SubjectCollected { vector: _ } => false
    Step0SubjectCollectionRefused { cause: cause } => match cause {
      Step0SubjectVectorEmpty { tree_hex: _ } => true
      Step0CommitIdentityUnreadable { hex: _ } => false
      Step0TreeIdentityUnreadable { hex: _ } => false
      Step0HeadCommitUnreadable { detail: _ } => false
      Step0HeadTreeUnreadable { detail: _ } => false
      Step0TreePathsUnreadable { detail: _ } => false
      Step0SourceUnreadableAtTree { path: _, detail: _ } => false
    }
  }
}

fn refusal_is_unreadable_commit(c: Step0SubjectCollection) -> Bool {
  match c {
    Step0SubjectCollected { vector: _ } => false
    Step0SubjectCollectionRefused { cause: cause } => match cause {
      Step0CommitIdentityUnreadable { hex: _ } => true
      Step0SubjectVectorEmpty { tree_hex: _ } => false
      Step0TreeIdentityUnreadable { hex: _ } => false
      Step0HeadCommitUnreadable { detail: _ } => false
      Step0HeadTreeUnreadable { detail: _ } => false
      Step0TreePathsUnreadable { detail: _ } => false
      Step0SourceUnreadableAtTree { path: _, detail: _ } => false
    }
  }
}

fn refusal_is_unreadable_tree(c: Step0SubjectCollection) -> Bool {
  match c {
    Step0SubjectCollected { vector: _ } => false
    Step0SubjectCollectionRefused { cause: cause } => match cause {
      Step0TreeIdentityUnreadable { hex: _ } => true
      Step0CommitIdentityUnreadable { hex: _ } => false
      Step0SubjectVectorEmpty { tree_hex: _ } => false
      Step0HeadCommitUnreadable { detail: _ } => false
      Step0HeadTreeUnreadable { detail: _ } => false
      Step0TreePathsUnreadable { detail: _ } => false
      Step0SourceUnreadableAtTree { path: _, detail: _ } => false
    }
  }
}

fn paths_contain(xs: List<String>, want: String) -> Bool {
  fold(xs, init: false, f: fn(acc, x) { acc || x == want })
}

// THE SUBJECT FILTER SELECTS THE MANIFEST'S POPULATION AND NOTHING ELSE: a tree path outside the
// contract's roots, and a non-.dag file inside them, are both absent -- so a collector that handed
// the strip producer the repository's Rust, Markdown or workflow files would red here rather than
// producing a wider "subject" under the manifest's name.
test fn the_subject_filter_takes_dag_sources_under_the_contract_roots_only() -> Bool {
  let blob = concat(
    concat("dag/std/types.dag", from_code_point(0)),
    concat(
      concat("src/v2/std/algebra.dag", from_code_point(0)),
      concat(
        concat("src/v1/02_parse.dag", from_code_point(0)),
        concat(
          concat("README.md", from_code_point(0)),
          concat(
            concat("src/v1/stage0/src/lib.rs", from_code_point(0)),
            concat("docs/plans/namespace-cut-replacement-plan.md", from_code_point(0))
          )
        )
      )
    )
  )
  let selected = step0_subject_paths_at(paths_nul: blob)
  count(selected) == 3
    && paths_contain(xs: selected, want: "dag/std/types.dag")
    && paths_contain(xs: selected, want: "src/v2/std/algebra.dag")
    && paths_contain(xs: selected, want: "src/v1/02_parse.dag")
}

// AN EMPTY POPULATION IS AN UNOBSERVED SUBJECT, NOT A SUBJECT OF SIZE ZERO -- the same rule the
// frozen canary applies to a planted empty observation.
test fn an_empty_read_refuses_instead_of_reporting_an_empty_subject() -> Bool {
  refusal_is_empty_subject(c: assemble_step0_subject_vector(
    head_commit_hex: well_formed_commit_hex(),
    head_tree_hex: well_formed_tree_hex(),
    sources: []
  ))
}

test fn an_unreadable_revision_refuses_before_any_vector_is_built() -> Bool {
  refusal_is_unreadable_commit(c: assemble_step0_subject_vector(
    head_commit_hex: "not-a-sha",
    head_tree_hex: well_formed_tree_hex(),
    sources: one_source()
  ))
}

test fn an_unreadable_tree_refuses_before_any_vector_is_built() -> Bool {
  refusal_is_unreadable_tree(c: assemble_step0_subject_vector(
    head_commit_hex: well_formed_commit_hex(),
    head_tree_hex: "",
    sources: one_source()
  ))
}

// THE POSITIVE CONTROL FOR THE PURE HALF: well-formed observations produce a vector carrying
// exactly the tree that was observed, so the refusals above discriminate rather than being the
// function's only behaviour.
test fn a_well_formed_observation_produces_a_vector_bound_to_the_observed_tree() -> Bool {
  match assemble_step0_subject_vector(
    head_commit_hex: well_formed_commit_hex(),
    head_tree_hex: well_formed_tree_hex(),
    sources: one_source()
  ) {
    Step0SubjectCollectionRefused { cause: _ } => false
    Step0SubjectCollected { vector: vector } => match git_sha1_object_id(hex: well_formed_tree_hex()) {
      Absent => false
      Present { value: expected_tree } =>
        git_object_id_eq(left: vector.source_tree, right: expected_tree)
          && step0_subject_vector_size(vector: vector) == 1
          && paths_contain(xs: step0_subject_vector_paths(vector: vector), want: "dag/std/types.dag")
    }
  }
}
