module test.claim.codex_provider_runtime_receipt_witness

import std.types { FilePath, NonEmptyStr }
import product.placement_supply { HostIdentity }
import gunbc.codex_provider_runtime_receipt {
  derive_codex_provider_runtime_receipt,
  codex_provider_runtime_receipt_converges_three_roots,
  codex_provider_runtime_receipt_process_fingerprint_observed,
  codex_provider_runtime_receipt_wire_path,
  CodexProcessFingerprintUnobserved,
}
import gunbc.host_layout { srv1_provider_runtime_placement }
import gunbc.package_delivery {
  codex_runtime_version_identity_marker,
  codex_bundled_executable_for_srv1,
}

test fn witness_runtime_receipt_derives_three_roots_and_honest_fingerprint() -> Bool {
  let host = "srv1" as HostIdentity
  match codex_bundled_executable_for_srv1() {
    Absent => false
    Present { value: executable } =>
      match derive_codex_provider_runtime_receipt(
        host: host,
        bundled_executable: executable,
        bundle_receipt_identity_hex: "abc123" as NonEmptyStr,
      ) {
        Absent => false
        Present { value: receipt } =>
          codex_provider_runtime_receipt_converges_three_roots(receipt: receipt)
            && receipt.bundled_executable == executable
            && receipt.version_marker == codex_runtime_version_identity_marker() as NonEmptyStr
            && receipt.bundle_receipt_identity_hex == ("abc123" as NonEmptyStr)
            && match receipt.process_fingerprint {
              CodexProcessFingerprintUnobserved { reason: _ } => true
              _ => false
            }
            && codex_provider_runtime_receipt_process_fingerprint_observed(receipt: receipt) == none
            && codex_provider_runtime_receipt_wire_path(
              placement: srv1_provider_runtime_placement(),
              host: host,
            ) == (
              "/opt/gunbc/provider-runtime/evidence/codex-provider-runtime/srv1.json" as FilePath
            )
      }
  }
}

test fn witness_runtime_receipt_refuses_unknown_host() -> Bool {
  match codex_bundled_executable_for_srv1() {
    Absent => true
    Present { value: executable } =>
      derive_codex_provider_runtime_receipt(
        host: "unknown-host" as HostIdentity,
        bundled_executable: executable,
        bundle_receipt_identity_hex: "abc123" as NonEmptyStr,
      ) == none
  }
}
