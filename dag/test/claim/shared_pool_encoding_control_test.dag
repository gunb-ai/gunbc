module test.claim.shared_pool_encoding_control

import std.logic { Bool }
import std.nat { Nat }
import std.types { List, list_length }
import std.measure { byte_size, byte_size_count, hardware_thread_count }
import std.machine_shape {
  DomainId,
  LevelId,
  MachineShape,
  MachineShapeOk,
  MachineShapeRefused,
  MemoryLevel,
  ExecutionDomain,
  ExecutionShape,
  IndependentLanes,
  SharedLevelEdge,
  machine_shape_validate,
  machine_shape_device_level_capacity,
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE OWNER-SWAP REPRESENTATION CONTROL, executed before any GB10 derivation is attempted.
// Question: can std.machine_shape give ONE canonical identity to a pool that is genuinely shared,
// where neither execution domain is naturally the owner?
//
// SharedLevelEdge is asymmetric -- owner, sharer, level -- and machine_shape_validate_edge requires
// the level to exist under the OWNER's level index. Memory levels live under a domain
// (ExecutionDomain { id, execution, memory }). So a single shared pool must be authored beneath one
// domain or the other, and the choice is arbitrary for a system-owned pool.
//
// These specimens are deliberately NOT vendor rows. The question is about the carrier's
// expressiveness, so a synthetic two-domain machine isolates it from any catalog's accidents.
data shared_pool_encoding_control_note: String = "Executed control, not an argument from reading. Three encodings of ONE physical machine -- a CPU domain and a GPU domain sharing one 128 GiB pool -- are constructed and validated. Encodings A and B differ only in which domain the pool is authored under, which is arbitrary when the pool is system-owned. Encoding C is the shape an unwary author reaches for when SharedLevelEdge is not used at all: the pool appears under BOTH domains. If C validates, the carrier permits counting one physical pool twice, and nothing in the type forces the shared-pool encoding over the duplicated one."

data cpu_domain: DomainId = "cpu" as DomainId
data gpu_domain: DomainId = "gpu" as DomainId
data pool_level: LevelId = "system-pool" as LevelId

data pool_bytes: Nat = 137438953472

fn pool() -> MemoryLevel {
  MemoryLevel {
    id: pool_level,
    capacity: byte_size(count: pool_bytes),
    transfer_grain: none,
    bandwidth: none,
    latency: none,
  }
}

fn lanes(n: Nat) -> ExecutionShape {
  ExecutionShape { lane_count: hardware_thread_count(count: n), grouping: IndependentLanes }
}

fn domain(id: DomainId, n: Nat, mem: List<MemoryLevel>) -> ExecutionDomain {
  ExecutionDomain { id: id, execution: lanes(n: n), memory: mem }
}

// A: the pool is authored under the CPU; the GPU shares it.
fn encoding_pool_under_cpu() -> MachineShape {
  MachineShape {
    domains: [domain(id: cpu_domain, n: 20, mem: [pool()]), domain(id: gpu_domain, n: 6144, mem: [])],
    edges: [SharedLevelEdge { owner: cpu_domain, sharer: gpu_domain, level: pool_level }],
  }
}

// B: the same machine, authored the other way round.
fn encoding_pool_under_gpu() -> MachineShape {
  MachineShape {
    domains: [domain(id: cpu_domain, n: 20, mem: []), domain(id: gpu_domain, n: 6144, mem: [pool()])],
    edges: [SharedLevelEdge { owner: gpu_domain, sharer: cpu_domain, level: pool_level }],
  }
}

// C: the pool authored under BOTH domains, with no shared edge -- the double count.
fn encoding_pool_duplicated() -> MachineShape {
  MachineShape {
    domains: [
      domain(id: cpu_domain, n: 20, mem: [pool()]),
      domain(id: gpu_domain, n: 6144, mem: [pool()]),
    ],
    edges: [],
  }
}

fn shape_validates(s: MachineShape) -> Bool {
  match machine_shape_validate(shape: s) {
    MachineShapeOk { shape: _ } => true
    MachineShapeRefused { cause: _ } => false
  }
}

// The naive summation a capacity consumer reaches for: total installed memory across domains.
fn summed_capacity_bytes(s: MachineShape) -> Nat {
  fold(s.domains, init: 0, f: (acc, d) =>
    fold(d.memory, init: acc, f: (inner, m) => inner + byte_size_count(b: m.capacity)))
}

// CONTROL 1: both orientations of one shared pool are accepted. If this holds, the carrier admits
// two encodings of one topology and supplies no canonical identity between them.
test fn witness_both_owner_orientations_validate() -> Bool {
  shape_validates(s: encoding_pool_under_cpu()) && shape_validates(s: encoding_pool_under_gpu())
}

// CONTROL 2: the duplicated-pool encoding is ALSO accepted, and it sums to twice the physical
// capacity. This is the double count made writable -- nothing requires an author to reach for
// SharedLevelEdge rather than repeat the level under each accessor.
test fn witness_duplicated_pool_encoding_is_writable_and_double_counts() -> Bool {
  let dup = encoding_pool_duplicated()
  shape_validates(s: dup) && summed_capacity_bytes(s: dup) == pool_bytes + pool_bytes
}

// CONTROL 3: the honest shared encodings sum to the pool ONCE. Paired with control 2 this shows the
// carrier can express the correct answer and does not require it.
test fn witness_shared_encodings_sum_the_pool_once() -> Bool {
  summed_capacity_bytes(s: encoding_pool_under_cpu()) == pool_bytes
    && summed_capacity_bytes(s: encoding_pool_under_gpu()) == pool_bytes
}

// CONTROL 4: the derived device-level capacity is stable across the two orientations. This is the
// half that could have gone either way -- machine_shape_device_level_capacity folds domains in
// order and takes the first domain that carries any level, so an empty CPU domain falls through to
// the GPU. Asserted rather than assumed, because if it ever diverges the same machine would report
// two different capacities depending on an arbitrary authoring choice.
test fn witness_device_level_capacity_is_orientation_stable() -> Bool {
  match machine_shape_device_level_capacity(shape: encoding_pool_under_cpu()) {
    Absent => false
    Present { value: a } =>
      match machine_shape_device_level_capacity(shape: encoding_pool_under_gpu()) {
        Absent => false
        Present { value: b } => byte_size_count(b: a) == byte_size_count(b: b)
      }
  }
}
