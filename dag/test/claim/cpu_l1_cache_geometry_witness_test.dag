module test.claim.cpu_l1_cache_geometry_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data ampere_altra_l1_data_kibibytes_per_core: std.nat.Nat = 64
data ampere_altra_l1_line_bytes: std.nat.Nat = 64

test fn w_ampere_l1_geometry_matches_datasheet() -> Bool {
  let g = extdeps.cpu.ampere.ampere_altra_l1_cache_geometry
  std.measure.byte_size_count(b: g.data_capacity_per_core) == ampere_altra_l1_data_kibibytes_per_core * 1024
    && std.measure.byte_size_count(b: g.instruction_capacity_per_core) == ampere_altra_l1_data_kibibytes_per_core * 1024
    && std.measure.byte_size_count(b: g.line_size) == ampere_altra_l1_line_bytes
}

test fn w_ampere_catalog_rows_share_cited_l1_geometry() -> Bool {
  altra_max_m12830_catalog.l1_cache == extdeps.cpu.ampere.ampere_altra_l1_cache_geometry
    && altra_q6430_catalog.l1_cache == extdeps.cpu.ampere.ampere_altra_l1_cache_geometry
}

test fn w_ampere_l1_citations_cover_all_fields() -> Bool {
  let citations = altra_max_m12830_catalog.l1_cache_citations
  std.types.list_length(items: citations) == 3
    && citations.first().authority == extdeps.cpu.ampere.ampere_altra_rev_a1_datasheet_authority
}

