module test.claim.error_primitives_bottom_seam

import std.types { Bool, Int, String }
import std.error_primitives { Never, absurd, never }
import std.algebra { string_contains, trim }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// The producer never() and eliminator absurd live in std.error_primitives. The guarded arm is not taken.
// Evaluating never() is a named runtime divergence, not a proved uninhabited arm.
fn bottom_seam_resolves_from_the_leaf(selector: Bool) -> Bool {
  if selector { true } else { absurd(never()) }
}

test fn bottom_seam_projections_resolve_from_error_primitives() -> Bool {
  bottom_seam_resolves_from_the_leaf(selector: true)
}

test fn trim_still_routes_to_the_host_realization() -> Bool {
  trim(s: "  a ") == "a"
}

test fn string_contains_is_substring_search_on_kernel_text() -> Bool {
  string_contains(s: "haystack", pattern: "stack")
    && !string_contains(s: "haystack", pattern: "foo")
    && string_contains(s: "haystack", pattern: "")
}
