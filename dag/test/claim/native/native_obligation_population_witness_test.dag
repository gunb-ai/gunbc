module test.claim.native.native_obligation_population_witness_test

import std.types { Bool, String, List, list_length }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.algebra { any }
import gunbc.plans.native_obligation_population {
  FrontierUnobserved, FrontierObserved, native_population_green_set, native_route_first_frontier,
  native_frontier_stands, native_population_frontier_count,
}
import gunbc.emitted_subject_build_gate { emitted_subject_build_rows, emitted_subject_build_label_text }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// ACCEPTANCE ORACLE FOR native-obligation-population, RED BY DESIGN. PINNED AT LAUNCH.

// RED TODAY: the population has a green set (it is empty until the built driver judges a run).
test fn the_green_set_only_grows() -> Bool {
  list_length(items: native_population_green_set) > 0 && native_frontier_stands(f: native_route_first_frontier)
}

// CONTROL: a population holds exactly one frontier; two rows refuse.
test fn a_second_frontier_row_refuses() -> Bool {
  native_population_frontier_count(rows: [native_route_first_frontier]) == 1
    && native_population_frontier_count(rows: [FrontierUnobserved, FrontierUnobserved]) != 1
}

// CONTROL: eligibility is native adjudication only; a host-judged producer identity is not a member.
data host_judged_producers: List<String> = ["NativeClaimProgramProducer", "NativeServeProgramProducer"]

test fn a_host_judged_member_is_ineligible() -> Bool {
  !any(native_population_green_set, m => any(host_judged_producers, h => m == h))
}

// CONTROL: the population is disjoint from the emitted subject rows (two products, not members).
test fn the_population_is_disjoint_from_the_emitted_subject_rows() -> Bool {
  !any(native_population_green_set, m => any(emitted_subject_build_rows, r => m == r.step_id || m == emitted_subject_build_label_text(row: r)))
}
