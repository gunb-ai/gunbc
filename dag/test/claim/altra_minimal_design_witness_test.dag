module test.claim.altra_minimal_design_witness

import std.types { Bool, String, List }
import std.integer { Int }
import product.altra_motherboard.minimal_design {
  ActiveDdrChannelCount,
  AltraMinimalMotherboard,
  ChannelCountExceedsControllerPopulation,
  DebugOnlyChannelCountUnderProductionIntent,
  DesignAdmitted,
  DesignRefused,
  DesignRefusal,
  DimmPopulationDisagreesWithChannels,
  EightChannels,
  EngineeringBringUp,
  FourChannels,
  MemoryConfiguration,
  OneChannel,
  PcieLanesExceedPackage,
  Production,
  SixChannels,
  TwoChannels,
  active_channel_count,
  admit_design,
  altra_1p_minimum,
  channel_count_is_production_qualified,
  design_refusal_count,
  total_dimms,
}
import extdeps.cpu.ampere_altra_package { altra_ddr4_channel_count, altra_pcie_gen4_lane_count }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn design(intent_is_production: Bool, ch: ActiveDdrChannelCount, dpc: Int, lanes: Int) -> AltraMinimalMotherboard {
  AltraMinimalMotherboard {
    intent: if intent_is_production { Production } else { EngineeringBringUp },
    memory: MemoryConfiguration { channels: ch, dimms_per_channel: dpc },
    pcie_lanes_broken_out: lanes,
  }
}

fn admits(d: AltraMinimalMotherboard) -> Bool {
  match admit_design(d: d) {
    DesignAdmitted { design: _ } => true
    DesignRefused { causes: _ } => false
  }
}

fn refusal_is(r: DesignRefusal, wanted: String) -> Bool {
  match r {
    DebugOnlyChannelCountUnderProductionIntent { selected: _ } => wanted == "DebugOnly"
    ChannelCountExceedsControllerPopulation { selected: _, available: _ } => wanted == "ExceedsControllers"
    DimmPopulationDisagreesWithChannels { dimms: _, channels: _ } => wanted == "DimmPopulation"
    PcieLanesExceedPackage { requested: _, available: _ } => wanted == "PcieLanes"
  }
}

fn refuses_naming(d: AltraMinimalMotherboard, wanted: String) -> Bool {
  match admit_design(d: d) {
    DesignAdmitted { design: _ } => false
    DesignRefused { causes: cs } =>
      fold(concat([cs.first], cs.rest), init: false, f: fn(acc, r) { acc || refusal_is(r: r, wanted: wanted) })
  }
}

// THE POSITIVE CONTROL. The selected 1P minimum admits: four channels is the smallest
// production-qualified population, one DIMM per channel, four lanes of a hundred and twenty-eight.
test fn w_the_selected_minimum_is_admitted() -> Bool {
  admits(d: altra_1p_minimum) && total_dimms(m: altra_1p_minimum.memory) == 4
}

// THE WALL. Two channels is a configuration the vendor documents as engineering debug and
// bring-up, so it is refused under a production intent — not because two is small, but because
// the part is documented as outside its production envelope there. A design that quietly picked
// two to save routing effort would be a debug fixture wearing a product's name.
test fn w_a_debug_only_channel_count_is_refused_for_production() -> Bool {
  refuses_naming(d: design(intent_is_production: true, ch: TwoChannels, dpc: 1, lanes: 4), wanted: "DebugOnly")
    && refuses_naming(d: design(intent_is_production: true, ch: OneChannel, dpc: 1, lanes: 4), wanted: "DebugOnly")
}

// AND THE SAME CONFIGURATION IS ADMITTED FOR BRING-UP, which is what makes the previous test a
// statement about intent rather than about the number. Without this the wall is satisfied by a
// rule that simply refuses small channel counts, and the one- and two-channel configurations
// exist precisely to serve bring-up.
test fn w_the_same_count_is_admitted_for_engineering_bring_up() -> Bool {
  admits(d: design(intent_is_production: false, ch: TwoChannels, dpc: 1, lanes: 4))
    && admits(d: design(intent_is_production: false, ch: OneChannel, dpc: 1, lanes: 4))
}

// The admitted set is the vendor's enumeration, not an arithmetic range: four, six and eight are
// production-qualified and one and two are not, and nothing in between is representable at all.
test fn w_the_qualified_set_is_exactly_four_six_and_eight() -> Bool {
  !channel_count_is_production_qualified(c: OneChannel)
    && !channel_count_is_production_qualified(c: TwoChannels)
    && channel_count_is_production_qualified(c: FourChannels)
    && channel_count_is_production_qualified(c: SixChannels)
    && channel_count_is_production_qualified(c: EightChannels)
}

// EVERY BOUND IS READ FROM THE PACKAGE AUTHORITY. Eight channels is the controller population and
// a hundred and twenty-eight is the lane count, both from the cited datasheet rows rather than
// retyped here — so a correction there moves this admission instead of leaving it agreeing with a
// number that has changed.
test fn w_the_bounds_come_from_the_cited_package() -> Bool {
  active_channel_count(c: EightChannels) == altra_ddr4_channel_count
    && altra_pcie_gen4_lane_count == 128
    && refuses_naming(d: design(intent_is_production: true, ch: FourChannels, dpc: 1, lanes: 129), wanted: "PcieLanes")
}

// A channel with no DIMM on it is a channel that is not populated, which contradicts calling it
// active.
test fn w_an_unpopulated_channel_refuses() -> Bool {
  refuses_naming(d: design(intent_is_production: true, ch: FourChannels, dpc: 0, lanes: 4), wanted: "DimmPopulation")
}

// Causes accumulate rather than stopping at the first, so a design with two independent problems
// reports two. Counting is what makes that visible.
test fn w_independent_defects_are_all_reported() -> Bool {
  match admit_design(d: design(intent_is_production: true, ch: TwoChannels, dpc: 0, lanes: 129)) {
    DesignAdmitted { design: _ } => false
    DesignRefused { causes: cs } => design_refusal_count(s: cs) == 3
  }
}
