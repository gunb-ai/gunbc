module test.claim.fleet_converge_timer_witness

import std.types { Bool, String }
import gunbc.fleet_converge_timer {
  fleet_converge_service_unit_name,
  fleet_converge_timer_unit_name,
  fleet_converge_timer_on_calendar,
  fleet_converge_service_content,
  fleet_converge_service_content_self,
  fleet_converge_timer_content,
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// Option A shape: calendar cadence WITH Persistent=true (catch-up after downtime — the
// offline-host property) and jitter. Persistent on a monotonic timer would be silently
// ignored by systemd, so the content deriving both from one authority is the wall.
test fn timer_content_is_calendar_persistent_with_jitter() -> Bool {
  let t = fleet_converge_timer_content()
  string_contains(s: t, pattern: "OnCalendar=*:0/15")
    && string_contains(s: t, pattern: "Persistent=true")
    && string_contains(s: t, pattern: "RandomizedDelaySec=90")
    && string_contains(s: t, pattern: "Unit=ctrl-fleet-converge.service")
    && !string_contains(s: t, pattern: "OnUnitActiveSec")
}

// The service converges SELF only — no remote host name is writable into the emitted
// unit from this authority, and the oneshot runs the pinned binary path.
test fn service_content_converges_self_only_via_pinned_binary() -> Bool {
  let s = fleet_converge_service_content_self()
  string_contains(s: s, pattern: "ExecStart=/opt/gunbc/bin/gunbc converge --host self")
    && string_contains(s: s, pattern: "Type=oneshot")
    && !string_contains(s: s, pattern: "--host srv")
}

// RED-shaped control: a content builder invoked with a remote host WOULD name it — the
// self-only law lives in the self projection, so the discriminating fact is that the
// generic builder and the self projection differ exactly on the host argument.
test fn generic_builder_with_remote_host_is_not_the_self_projection() -> Bool {
  fleet_converge_service_content(host_arg: "srv2") != fleet_converge_service_content_self()
    && string_contains(s: fleet_converge_service_content(host_arg: "srv2"), pattern: "--host srv2")
}

test fn unit_names_are_the_single_authority() -> Bool {
  fleet_converge_service_unit_name == "ctrl-fleet-converge.service"
    && fleet_converge_timer_unit_name == "ctrl-fleet-converge.timer"
    && fleet_converge_timer_on_calendar == "*:0/15"
}
