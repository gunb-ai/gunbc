module test.claim.roadmap_publish_witness_test

import std.types { Bool, String, NonEmptyStr, Int, CommitSha, List }
import extdeps.github.pulls { PullRequest, PullRequestRef, PullRequestState, Open }
import extdeps.github.github { GitHubUser, UserType, User }
import gunbc.roadmap_publish {
  PullRequestObservation, PullRequestsRead, PullRequestsUnreadable,
  RemoteBranchObservation, RemoteBranchesRead, RemoteBranchesUnreadable,
  PublicationOutcome,
  PublicationBound, PublicationHeadDiverged,
  BranchPublishedWithoutPullRequest, BranchNotPublished,
  PublicationObservationRefused,
  adjudicate_publication,
  publication_detail,
  publication_offers_the_candidate,
}

data witness_scope_note: String = "What is claimed is the ADJUDICATION, not the fetch. adjudicate_publication is pure and total over observations the caller already holds, so every arm is reachable with no network and no token.\\n\\nWhat is NOT claimed, stated so the bound is visible: nothing here executes github.Pulls or git. A change that broke the reads while leaving the adjudication intact would keep these green. What the coproduct inputs buy is that a broken read is now REPRESENTABLE — the caller reports it and the refusal arm is exercised here — where the previous cut could only raise."

data fixture_candidate: CommitSha = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
data fixture_older: CommitSha = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
data fixture_branch: NonEmptyStr = "dispatch/some-node-a7" as NonEmptyStr
data fixture_remote: NonEmptyStr = "origin" as NonEmptyStr

fn fixture_user() -> GitHubUser {
  GitHubUser { login: "someone", id: 1, type: User }
}

fn fixture_pull(number: Int, branch: String, sha: CommitSha, draft: Bool) -> PullRequest {
  PullRequest {
    number: number,
    title: "a candidate",
    body: Absent,
    state: Open,
    html_url: "https://github.com/gunb-ai/gunbc/pull/1" as NonEmptyStr,
    user: fixture_user(),
    head: PullRequestRef { ref: branch, sha: sha, label: branch },
    base: PullRequestRef { ref: "main", sha: fixture_older, label: "main" },
    created_at: "2026-07-31T00:00:00Z",
    updated_at: "2026-07-31T00:00:00Z",
    merged_at: Absent,
    draft: draft,
  }
}

fn adjudicate_with(
  pulls: PullRequestObservation,
  remotes: RemoteBranchObservation,
) -> PublicationOutcome {
  adjudicate_publication(
    pulls: pulls,
    remotes: remotes,
    remote: fixture_remote,
    branch: fixture_branch,
    candidate_head: fixture_candidate,
  )
}

data no_remotes_needed_note: String = "When a pull request names the branch, the remote listing is never consulted — so these fixtures pass an unreadable remote observation deliberately. If the adjudicator ever started reading it on that path, these claims would turn into refusals and say so."

fn remotes_deliberately_unreadable() -> RemoteBranchObservation {
  RemoteBranchesUnreadable { detail: "not consulted on this path" }
}

test fn a_pull_request_at_the_candidate_head_is_bound() -> Bool {
  let outcome = adjudicate_with(
    pulls: PullRequestsRead {
      pulls: [
        fixture_pull(number: 11, branch: "someone/other", sha: fixture_older, draft: false),
        fixture_pull(number: 22, branch: fixture_branch as String, sha: fixture_candidate, draft: true),
      ],
    },
    remotes: remotes_deliberately_unreadable(),
  )
  match outcome {
    PublicationBound { branch: _, pr_number, pr_head, url: _, draft } =>
      pr_number == 22
        && (pr_head as String) == (fixture_candidate as String)
        && draft
    PublicationHeadDiverged {
      branch: _, pr_number: _, pr_head: _, candidate_head: _, url: _,
    } => false
    BranchPublishedWithoutPullRequest { branch: _ } => false
    BranchNotPublished { branch: _, remote_branches_seen: _ } => false
    PublicationObservationRefused { detail: _ } => false
  }
}

data divergence_is_the_point_note: String = "THE CLAIM THE PREVIOUS CUT COULD NOT MAKE. A pull request exists, its branch matches, and its head is a DIFFERENT commit — the ordinary state after a worker pushes while a review is in flight. A branch lookup reports this as a successful publication and every later receipt binds to a commit nobody assessed.\\n\\nBoth heads are asserted, because a refusal naming only one leaves the operator unable to tell which is stale."

test fn a_pull_request_at_another_head_diverges_and_names_both() -> Bool {
  let outcome = adjudicate_with(
    pulls: PullRequestsRead {
      pulls: [fixture_pull(number: 22, branch: fixture_branch as String, sha: fixture_older, draft: false)],
    },
    remotes: remotes_deliberately_unreadable(),
  )
  match outcome {
    PublicationHeadDiverged { branch: _, pr_number, pr_head, candidate_head, url: _ } =>
      pr_number == 22
        && (pr_head as String) == (fixture_older as String)
        && (candidate_head as String) == (fixture_candidate as String)
    PublicationBound { branch: _, pr_number: _, pr_head: _, url: _, draft: _ } => false
    BranchPublishedWithoutPullRequest { branch: _ } => false
    BranchNotPublished { branch: _, remote_branches_seen: _ } => false
    PublicationObservationRefused { detail: _ } => false
  }
}

test fn a_diverged_publication_does_not_offer_the_candidate() -> Bool {
  let bound = adjudicate_with(
    pulls: PullRequestsRead {
      pulls: [fixture_pull(number: 22, branch: fixture_branch as String, sha: fixture_candidate, draft: false)],
    },
    remotes: remotes_deliberately_unreadable(),
  )
  let diverged = adjudicate_with(
    pulls: PullRequestsRead {
      pulls: [fixture_pull(number: 22, branch: fixture_branch as String, sha: fixture_older, draft: false)],
    },
    remotes: remotes_deliberately_unreadable(),
  )
  publication_offers_the_candidate(outcome: bound)
    && !publication_offers_the_candidate(outcome: diverged)
}

test fn a_pushed_branch_with_no_pull_request_is_its_own_arm() -> Bool {
  let outcome = adjudicate_with(
    pulls: PullRequestsRead { pulls: [] },
    remotes: RemoteBranchesRead {
      branches: ["origin/main", "origin/dispatch/some-node-a7"],
    },
  )
  match outcome {
    BranchPublishedWithoutPullRequest { branch } =>
      (branch as String) == (fixture_branch as String)
    BranchNotPublished { branch: _, remote_branches_seen: _ } => false
    PublicationBound { branch: _, pr_number: _, pr_head: _, url: _, draft: _ } => false
    PublicationHeadDiverged {
      branch: _, pr_number: _, pr_head: _, candidate_head: _, url: _,
    } => false
    PublicationObservationRefused { detail: _ } => false
  }
}

test fn an_unpushed_branch_reports_how_many_remotes_it_read() -> Bool {
  let outcome = adjudicate_with(
    pulls: PullRequestsRead { pulls: [] },
    remotes: RemoteBranchesRead { branches: ["origin/main", "origin/other"] },
  )
  match outcome {
    BranchNotPublished { branch, remote_branches_seen } =>
      (branch as String) == (fixture_branch as String) && remote_branches_seen == 2
    BranchPublishedWithoutPullRequest { branch: _ } => false
    PublicationBound { branch: _, pr_number: _, pr_head: _, url: _, draft: _ } => false
    PublicationHeadDiverged {
      branch: _, pr_number: _, pr_head: _, candidate_head: _, url: _,
    } => false
    PublicationObservationRefused { detail: _ } => false
  }
}

data near_miss_note: String = "A SIBLING BRANCH MUST NOT COUNT AS THIS ONE. origin/dispatch/some-node-a7-old shares a prefix with the branch under judgment, so a contains-style match would report the candidate published when only a stale sibling exists. The qualified comparison is what makes this a real check rather than a coincidence of naming."

test fn a_sibling_branch_sharing_a_prefix_is_not_this_branch() -> Bool {
  let outcome = adjudicate_with(
    pulls: PullRequestsRead { pulls: [] },
    remotes: RemoteBranchesRead {
      branches: ["origin/dispatch/some-node-a7-old", "origin/dispatch/some-node-a70"],
    },
  )
  match outcome {
    BranchNotPublished { branch: _, remote_branches_seen } => remote_branches_seen == 2
    BranchPublishedWithoutPullRequest { branch: _ } => false
    PublicationBound { branch: _, pr_number: _, pr_head: _, url: _, draft: _ } => false
    PublicationHeadDiverged {
      branch: _, pr_number: _, pr_head: _, candidate_head: _, url: _,
    } => false
    PublicationObservationRefused { detail: _ } => false
  }
}

data refusal_is_not_absence_note: String = "AN UNREADABLE OBSERVATION MUST NOT READ AS 'NOT PUBLISHED'. Both are negative, so a claim asserting only 'it did not conclude bound' would pass against the collapse — and the collapse points the operator at the wrong action entirely: pushing a branch that may already be pushed, because the truth is that nothing was learned."

test fn unreadable_pull_requests_refuse_rather_than_report_unpublished() -> Bool {
  let outcome = adjudicate_with(
    pulls: PullRequestsUnreadable { detail: "401 from the forge" },
    remotes: RemoteBranchesRead { branches: [] },
  )
  match outcome {
    PublicationObservationRefused { detail } =>
      string_contains(s: detail, pattern: "401 from the forge")
    BranchNotPublished { branch: _, remote_branches_seen: _ } => false
    BranchPublishedWithoutPullRequest { branch: _ } => false
    PublicationBound { branch: _, pr_number: _, pr_head: _, url: _, draft: _ } => false
    PublicationHeadDiverged {
      branch: _, pr_number: _, pr_head: _, candidate_head: _, url: _,
    } => false
  }
}

test fn unreadable_remotes_with_no_pull_request_refuse_rather_than_report_unpublished() -> Bool {
  let outcome = adjudicate_with(
    pulls: PullRequestsRead { pulls: [] },
    remotes: RemoteBranchesUnreadable { detail: "ls-remote timed out" },
  )
  match outcome {
    PublicationObservationRefused { detail } =>
      string_contains(s: detail, pattern: "ls-remote timed out")
    BranchNotPublished { branch: _, remote_branches_seen: _ } => false
    BranchPublishedWithoutPullRequest { branch: _ } => false
    PublicationBound { branch: _, pr_number: _, pr_head: _, url: _, draft: _ } => false
    PublicationHeadDiverged {
      branch: _, pr_number: _, pr_head: _, candidate_head: _, url: _,
    } => false
  }
}

test fn a_refusal_does_not_offer_the_candidate() -> Bool {
  let refused = adjudicate_with(
    pulls: PullRequestsUnreadable { detail: "no token" },
    remotes: RemoteBranchesRead { branches: [] },
  )
  !publication_offers_the_candidate(outcome: refused)
}

data detail_derivation_note: String = "The rendered detail is what an operator reads on the row strip, so it is claimed rather than assumed. The diverged detail must carry BOTH shas — a message naming only the pull request's head would be true and would still leave the reader unable to see that it is the wrong commit."

test fn the_diverged_detail_names_both_commits() -> Bool {
  let diverged = publication_detail(outcome: adjudicate_with(
    pulls: PullRequestsRead {
      pulls: [fixture_pull(number: 22, branch: fixture_branch as String, sha: fixture_older, draft: false)],
    },
    remotes: remotes_deliberately_unreadable(),
  ))
  string_contains(s: diverged, pattern: fixture_older as String)
    && string_contains(s: diverged, pattern: fixture_candidate as String)
    && string_contains(s: diverged, pattern: "branch moved")
}

test fn the_bound_detail_distinguishes_draft_from_ready() -> Bool {
  let as_draft = publication_detail(outcome: adjudicate_with(
    pulls: PullRequestsRead {
      pulls: [fixture_pull(number: 22, branch: fixture_branch as String, sha: fixture_candidate, draft: true)],
    },
    remotes: remotes_deliberately_unreadable(),
  ))
  let as_ready = publication_detail(outcome: adjudicate_with(
    pulls: PullRequestsRead {
      pulls: [fixture_pull(number: 22, branch: fixture_branch as String, sha: fixture_candidate, draft: false)],
    },
    remotes: remotes_deliberately_unreadable(),
  ))
  string_contains(s: as_draft, pattern: "draft pull request #22")
    && !string_contains(s: as_ready, pattern: "draft")
    && string_contains(s: as_ready, pattern: "pull request #22")
}
