module test.claim.roadmap_publish_witness_test

import std.types { Bool, String, NonEmptyStr, Int, CommitSha, List }
import extdeps.github.pulls { PullRequest, PullRequestRef, PullRequestState, Open }
import extdeps.github.github { GitHubUser, UserType, User }
import gunbc.roadmap_publish {
  PublicationOutcome, PublicationObserved, PublicationAbsent,
  publication_from_pulls,
  publication_detail,
}

data witness_scope_note: String = "THE PRODUCER LANDED WITH NO EXECUTING CONSUMER and this closes that (review 45531). gunbc.roadmap_verify shipped beside roadmap_verify_witness_test; this module's first cut shipped with a manual probe that was deleted, so its green-by-execution claim rested on evidence nobody else could re-run — which is the specification-without-execution trap stated exactly.\\n\\nWhat is claimed here is the CLASSIFICATION, not the fetch. publication_from_pulls is pure and total over values the caller already holds, so every arm is reachable from constructed inputs with no network and no token. The impure wrapper is one line and carries no decisions.\\n\\nWhat is NOT claimed, stated so the bound is visible: nothing here executes github.Pulls. A change that broke the REST call while leaving the classification intact would keep these green. That gap belongs to the effect-frontier enrollment the PR body names, not to this file."

data fixture_head: CommitSha = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
data fixture_older: CommitSha = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

fn fixture_user() -> GitHubUser {
  GitHubUser { login: "someone", id: 1, type: User }
}

fn fixture_pull(number: Int, branch: String, sha: CommitSha, draft: Bool) -> PullRequest {
  PullRequest {
    number: number,
    title: "a candidate",
    body: Absent,
    state: Open,
    html_url: "https://github.com/gunb-ai/gunbc/pull/1" as NonEmptyStr,
    user: fixture_user(),
    head: PullRequestRef { ref: branch, sha: sha, label: branch },
    base: PullRequestRef { ref: "main", sha: fixture_older, label: "main" },
    created_at: "2026-07-31T00:00:00Z",
    updated_at: "2026-07-31T00:00:00Z",
    merged_at: Absent,
    draft: draft,
  }
}

data branch_match_note: String = "The join is by head ref, and the negative half is what proves it. Asserting only that the matching branch is found would pass against a function that returned the FIRST pull request regardless of branch — which is the shape a careless implementation takes — so a second, non-matching pull request sits in the same list and must not be selected."

test fn publication_selects_the_pull_request_for_this_branch() -> Bool {
  let pulls = [
    fixture_pull(number: 11, branch: "someone/other-branch", sha: fixture_older, draft: false),
    fixture_pull(number: 22, branch: "session/mine", sha: fixture_head, draft: true),
  ]
  match publication_from_pulls(pulls: pulls, branch: "session/mine" as NonEmptyStr) {
    PublicationObserved { branch: _, pr_number, head_sha, url: _, draft } =>
      pr_number == 22 && (head_sha as String) == (fixture_head as String) && draft
    PublicationAbsent { branch: _, open_pull_requests_seen: _ } => false
  }
}

data absent_counts_what_it_read_note: String = "ABSENT MUST CARRY THE COUNT IT READ, because that is the only thing distinguishing a real negative observation from a failed one in a module that has no refusal arm. 'Read 2, none matched' is evidence; a bare 'no pull request' is indistinguishable from having read nothing at all."

test fn publication_absent_reports_how_many_it_read() -> Bool {
  let pulls = [
    fixture_pull(number: 11, branch: "someone/other-branch", sha: fixture_older, draft: false),
    fixture_pull(number: 12, branch: "someone/another", sha: fixture_older, draft: false),
  ]
  match publication_from_pulls(pulls: pulls, branch: "session/absent" as NonEmptyStr) {
    PublicationObserved { branch: _, pr_number: _, head_sha: _, url: _, draft: _ } => false
    PublicationAbsent { branch, open_pull_requests_seen } =>
      (branch as String) == "session/absent" && open_pull_requests_seen == 2
  }
}

test fn publication_absent_on_an_empty_list_reads_zero() -> Bool {
  match publication_from_pulls(pulls: [], branch: "session/mine" as NonEmptyStr) {
    PublicationObserved { branch: _, pr_number: _, head_sha: _, url: _, draft: _ } => false
    PublicationAbsent { branch: _, open_pull_requests_seen } => open_pull_requests_seen == 0
  }
}

data head_sha_rides_the_observation_note: String = "THE HEAD SHA IS THE POINT, so it is asserted rather than carried untested. A pull request number identifies a conversation; the head sha identifies the CANDIDATE, and every downstream judgment the roadmap makes — review, audit, acceptance — is about a candidate. An implementation that returned the pull request without its head sha would satisfy the branch-selection claim above and still leave every consumer unable to say what was judged."

data detail_derivation_note: String = "The rendered detail is what an operator reads on the row strip, so it is claimed rather than assumed. Draft is the discriminating axis: a detail that read the same for a draft and a ready pull request would be true and useless, because whether the candidate is offered for judgment at all is the thing Publication exists to report."

test fn publication_detail_distinguishes_draft_from_ready() -> Bool {
  let as_draft = publication_detail(outcome: publication_from_pulls(
    pulls: [fixture_pull(number: 22, branch: "session/mine", sha: fixture_head, draft: true)],
    branch: "session/mine" as NonEmptyStr,
  ))
  let as_ready = publication_detail(outcome: publication_from_pulls(
    pulls: [fixture_pull(number: 22, branch: "session/mine", sha: fixture_head, draft: false)],
    branch: "session/mine" as NonEmptyStr,
  ))
  string_contains(s: as_draft, pattern: "draft pull request #22")
    && !string_contains(s: as_ready, pattern: "draft")
    && string_contains(s: as_ready, pattern: "pull request #22")
    && string_contains(s: as_ready, pattern: fixture_head as String)
}
