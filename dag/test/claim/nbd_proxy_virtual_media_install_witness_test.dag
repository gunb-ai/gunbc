module test.claim.nbd_proxy_virtual_media_install


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// A SUPPLIED resolved image (DESIGN §3: a witness discriminates at one interface). What these
// claims check does not depend on which bytes the actuator serves, only on the path reaching the
// intent; the real resolution route is exercised by test.claim.mtcollins1_census_image.
data srv3_resolved_image_fixture: SeededImageResolution = SeededImageResolved {
  built: ubuntu_seeded_install_media_built(
    input: srv3_seeded_install_media_input,
    output_digest: "abababababababababababababababababababababababababababababababab",
  ),
  path: "/var/lib/gunbc/artifacts/ubuntu-24.04.3-live-server-srv3-seeded-abababababababab.iso",
}

// The mapping is the subject here and it is unchanged: a boot target is derived
// from the mechanism, never hardcoded to Pxe. What changed is that srv3 no
// longer REACHES the mapping — its 3.22.00 evidence refuses before a mechanism
// is selected — so the host half asserts the refusal and the mapping is pinned
// on the mechanisms directly, which is where the claim always actually lived.
test fn install_boot_target_follows_mechanism_not_hardcoded_pxe() -> Bool {
  match srv3_install_mechanism_solution {
    OsInstallMechanismRefused { cause: _ } => true
    OsInstallMechanismSelected { mechanism: _ } => false
  }
    && install_boot_target_for(mechanism: NbdProxyVirtualMediaInstall) == BootTargetCd
    && install_boot_target_for(mechanism: PxeHttpInstall) == BootTargetPxe
    && install_boot_target_for(mechanism: VirtualMediaInstall) == BootTargetCd
}

// SOLVE-DRIVEN IS STILL THE CLAIM, and the refusal is what proves it. If the
// plan were hardcoded to nbd-proxy it would still be Ready after srv3's BMC
// upgrade; because it is derived from the solved mechanism, the upgrade
// propagates and the plan refuses. A plan that survived the firmware change
// would be the defect this witness exists to catch.
test fn srv3_actuator_plan_is_solve_driven_and_follows_the_refusal() -> Bool {
  match srv3_os_install_actuator_plan_standing(image: srv3_resolved_image_fixture) {
    ActuatorPlanRefused { cause: _ } => true
    ActuatorPlanReady { plan: _ } => false
  }
}

test fn nbd_proxy_actuator_steps_serve_boot_restart() -> Bool {
  let steps = os_install_actuator_steps(
    mechanism: NbdProxyVirtualMediaInstall,
    export: srv3_nbd_proxy_export_placeholder
  )
  list_length(items: steps) == 3
    && match steps.first() {
      ActuatorNbdProxyServe { endpoint: e, slot: 0, index: 0, export: _ } =>
        e == VmSlotIndexEndpoint
      _ => false
    }
    && match steps.skip(n: 1).first() {
      ActuatorBootOnce { target: BootTargetCd, enabled: _ } => true
      _ => false
    }
    && match steps.skip(n: 2).first() {
      ActuatorForceRestart { reset_type: _ } => true
      _ => false
    }
}

test fn pxe_actuator_steps_stage_boot_restart() -> Bool {
  let steps = os_install_actuator_steps(
    mechanism: PxeHttpInstall,
    export: srv3_nbd_proxy_export_placeholder
  )
  list_length(items: steps) == 3
    && match steps.first() {
      ActuatorPxeNetworkBootStaging => true
      _ => false
    }
}

// steps.first() is an Optional, so an ABSENT first step may not read as ready; the realization is
// taken against the resolved census image. Both facts are load-bearing and neither side of the
// merge that introduced them carried the other.
test fn nbd_proxy_serve_step_maps_to_actuator_host_shell_intent() -> Bool {
  let steps = os_install_actuator_steps(
    mechanism: NbdProxyVirtualMediaInstall,
    export: srv3_nbd_proxy_export_placeholder
  )
  let first_step_ready = match steps.first() {
    Absent => false
    Present { value: first_step } =>
      match actuator_step_realization(step: first_step, image: srv3_resolved_image_fixture) {
        ActuatorStepReady { intent: intent } =>
          match intent.target {
            HostOs { node: h } =>
              match srv3_os_install_actuator_selection {
                ActuatorSelected { host: selected } => h == selected
                ActuatorUnsatisfiable { reason: _ } => false
              }
            _ => false
          }
            && match intent.effect {
              Srv3NbdProxyServe { intent: _, lease_key: _ } => true
              _ => false
            }
        ActuatorStepRefused { cause: _ } => false
      }
  }
  first_step_ready
    && match nbd_proxy_serve_systemd_realization_dissolution_trigger {
      Scaffold { dissolves_to: _, bind: _ } => true
      Terminal { reason: _ } => false
    }
}

test fn nbd_proxy_placeholder_scaffolds_carry_dissolve_on_markers() -> Bool {
  match srv3_nbd_proxy_export_dissolution_trigger {
    Scaffold { dissolves_to: _, bind: _ } => true
    Terminal { reason: _ } => false
  }
}

// RED CONTROL for the silent-omission fail-open this repair closed. The three steps with no
// realization must refuse by NAME, and a plan containing any of them must not be ready. The
// previous Optional form answered Absent, which a caller cannot distinguish from "this step
// needs no host effect" — so an install plan could report ready while omitting the very effects
// that perform the install.
test fn unrealized_actuator_steps_refuse_rather_than_reporting_absent() -> Bool {
  match actuator_step_realization(step: ActuatorRedfishInsertMedia, image: srv3_resolved_image_fixture) {
    ActuatorStepRefused { cause: ActuatorStepRealizationAbsent { step: _ } } => true
    ActuatorStepRefused { cause: ActuatorStepActuatorHostUnsatisfiable { step: _, reason: _ } } => false
    ActuatorStepRefused { cause: ActuatorStepImageUnresolved { step: _, reason: _ } } => false
    ActuatorStepReady { intent: _ } => false
  }
    && match actuator_step_realization(step: ActuatorPxeNetworkBootStaging, image: srv3_resolved_image_fixture) {
         ActuatorStepRefused { cause: ActuatorStepRealizationAbsent { step: _ } } => true
         ActuatorStepRefused { cause: ActuatorStepActuatorHostUnsatisfiable { step: _, reason: _ } } => false
         ActuatorStepRefused { cause: ActuatorStepImageUnresolved { step: _, reason: _ } } => false
         ActuatorStepReady { intent: _ } => false
       }
    && match actuator_step_realization(step: ActuatorFirmwareUpdate, image: srv3_resolved_image_fixture) {
         ActuatorStepRefused { cause: ActuatorStepRealizationAbsent { step: _ } } => true
         ActuatorStepRefused { cause: ActuatorStepActuatorHostUnsatisfiable { step: _, reason: _ } } => false
         ActuatorStepRefused { cause: ActuatorStepImageUnresolved { step: _, reason: _ } } => false
         ActuatorStepReady { intent: _ } => false
       }
}

// A plan whose steps are not all realized is REFUSED, and every unrealized step is reported —
// not just the first. The PXE mechanism's staging step has no realization, so its plan refuses.
test fn plan_with_unrealized_steps_is_refused_and_names_them() -> Bool {
  match actuator_plan_realization(
    steps: os_install_actuator_steps(
      mechanism: PxeHttpInstall,
      export: srv3_nbd_proxy_export_placeholder
    ),
    image: srv3_resolved_image_fixture,
  ) {
    ActuatorPlanUnrealized { refusals: rs } => list_length(items: rs) == 1
    ActuatorPlanRealized { intents: _ } => false
  }
}

fn nbd_serve_step_refuses_image(step: OsInstallActuatorStep, image: SeededImageResolution) -> Bool {
  match actuator_step_realization_under(step: step, selection: ActuatorSelected { host: srv1_host }, image: image) {
    ActuatorStepRefused { cause: ActuatorStepImageUnresolved { step: _, reason: _ } } => true
    _ => false
  }
}

// THE SERVED PATH IS THE RESOLVED IMAGE'S, and an unresolved image REFUSES the serve step. Both
// directions under a satisfiable actuator selection, so the image is the only thing that differs:
// the resolved arm must carry exactly the fixture's path into the NBD intent, and each unresolved
// arm must refuse by name rather than serve a path of its own.
test fn nbd_serve_step_serves_the_resolved_image_and_refuses_an_unresolved_one() -> Bool {
  let selection = ActuatorSelected { host: srv1_host }
  match os_install_actuator_steps(
    mechanism: NbdProxyVirtualMediaInstall,
    export: srv3_nbd_proxy_export_placeholder
  ).first() {
    Absent => false
    Present { value: step } => nbd_serve_step_claims_hold(step: step, selection: selection)
  }
}

fn nbd_serve_step_claims_hold(step: OsInstallActuatorStep, selection: OsInstallActuatorSelection) -> Bool {
  let served = match actuator_step_realization_under(step: step, selection: selection, image: srv3_resolved_image_fixture) {
    ActuatorStepReady { intent: i } =>
      match i.effect {
        Srv3NbdProxyServe { intent: nbd, lease_key: _ } =>
          nbd.iso_path == "/var/lib/gunbc/artifacts/ubuntu-24.04.3-live-server-srv3-seeded-abababababababab.iso"
        _ => false
      }
    ActuatorStepRefused { cause: _ } => false
  }
  served
    && nbd_serve_step_refuses_image(step: step, image: SeededImageNotBuilt { record_path: "/var/lib/gunbc/artifacts/.x.built" })
    && nbd_serve_step_refuses_image(step: step, image: SeededImageRecordDiverged { path: "/var/lib/gunbc/artifacts/x.iso", recorded: "ab", observed: "cd" })
    && nbd_serve_step_refuses_image(step: step, image: SeededImageRecordedImageAbsent { path: "/var/lib/gunbc/artifacts/x.iso", recorded: "ab" })
    && nbd_serve_step_refuses_image(step: step, image: SeededImageUnobservable { reason: "record unreadable" })
}
