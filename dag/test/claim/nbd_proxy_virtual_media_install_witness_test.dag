module test.claim.nbd_proxy_virtual_media_install

import std.logic { Bool }
import std.types { list_length }
import extdeps.bmc.types { BootTargetCd, BootTargetPxe }
import extdeps.bmc.webui.nbd_proxy { VmSlotIndexEndpoint }
import gunbc.os_install_mechanism {
  NbdProxyVirtualMediaInstall,
  PxeHttpInstall,
  install_boot_target_for,
  srv3_install_mechanism,
  srv3_install_boot_target,
}
import gunbc.nbd_proxy_virtual_media_install {
  OsInstallActuatorStep,
  ActuatorNbdProxyServe,
  ActuatorBootOnce,
  ActuatorForceRestart,
  ActuatorPxeNetworkBootStaging,
  srv3_os_install_actuator_plan,
  os_install_actuator_step_count,
  os_install_actuator_steps,
  srv3_nbd_proxy_export_placeholder,
  srv3_nbd_proxy_iso_path_dissolution_trigger,
  srv3_nbd_proxy_export_dissolution_trigger,
  actuator_step_to_host_effect_intent,
  srv3_os_install_actuator_host,
  srv3_os_install_actuator_toolchain_grant_row_count,
}
import gunbc.host_effect { HostOs, ShellCommand }
import extdeps.bmc.webui.nbd_proxy_serve {
  nbd_proxy_serve_bash_emit_dissolution_trigger,
}

test fn srv3_install_boot_target_follows_mechanism_not_hardcoded_pxe() -> Bool {
  match srv3_install_mechanism {
    NbdProxyVirtualMediaInstall => srv3_install_boot_target == BootTargetCd
    PxeHttpInstall => srv3_install_boot_target == BootTargetPxe
    _ => false
  }
    && install_boot_target_for(mechanism: NbdProxyVirtualMediaInstall) == BootTargetCd
    && install_boot_target_for(mechanism: PxeHttpInstall) == BootTargetPxe
}

test fn srv3_nbd_proxy_actuator_plan_is_solve_driven() -> Bool {
  match srv3_os_install_actuator_plan.mechanism {
    NbdProxyVirtualMediaInstall => true
    PxeHttpInstall => false
    _ => false
  }
    && os_install_actuator_step_count(plan: srv3_os_install_actuator_plan) == 3
}

test fn nbd_proxy_actuator_steps_serve_boot_restart() -> Bool {
  let steps = os_install_actuator_steps(
    mechanism: NbdProxyVirtualMediaInstall,
    export: srv3_nbd_proxy_export_placeholder
  )
  list_length(items: steps) == 3
    && match steps.first() {
      ActuatorNbdProxyServe { endpoint: e, slot: 0, index: 0, export: _ } =>
        e == VmSlotIndexEndpoint
      _ => false
    }
    && match steps.skip(n: 1).first() {
      ActuatorBootOnce { target: BootTargetCd, enabled: _ } => true
      _ => false
    }
    && match steps.skip(n: 2).first() {
      ActuatorForceRestart { reset_type: _ } => true
      _ => false
    }
}

test fn pxe_actuator_steps_stage_boot_restart() -> Bool {
  let steps = os_install_actuator_steps(
    mechanism: PxeHttpInstall,
    export: srv3_nbd_proxy_export_placeholder
  )
  list_length(items: steps) == 3
    && match steps.first() {
      ActuatorPxeNetworkBootStaging => true
      _ => false
    }
}

test fn nbd_proxy_serve_step_maps_to_actuator_host_shell_intent() -> Bool {
  let steps = os_install_actuator_steps(
    mechanism: NbdProxyVirtualMediaInstall,
    export: srv3_nbd_proxy_export_placeholder
  )
  match actuator_step_to_host_effect_intent(step: steps.first()) {
    Present { value: intent } =>
      match intent.target {
        HostOs { node: h } => h == srv3_os_install_actuator_host
        _ => false
      }
        && match intent.effect {
          ShellCommand { script: _ } => true
          _ => false
        }
    Absent => false
  }
    && string_contains(s: nbd_proxy_serve_bash_emit_dissolution_trigger, pattern: "dissolve-on:")
}

test fn actuator_toolchain_grant_is_wired() -> Bool {
  srv3_os_install_actuator_toolchain_grant_row_count() == 4
}

test fn nbd_proxy_placeholder_scaffolds_carry_dissolve_on_markers() -> Bool {
  string_contains(s: srv3_nbd_proxy_iso_path_dissolution_trigger, pattern: "dissolve-on:")
    && string_contains(s: srv3_nbd_proxy_export_dissolution_trigger, pattern: "dissolve-on:")
}
