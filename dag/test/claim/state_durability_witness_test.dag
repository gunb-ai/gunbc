test fn evidence_for_an_old_perturbation_generation_cannot_qualify() -> Bool {
  let stale_admission = fixture_admission(
    target: fixture_target,
    desired: fixture_digest_a,
    realization: fixture_realization,
    capability_version: fixture_capability_version,
    generation: 6,
    subject: fixture_subject,
  )
  let stale = fixture_preserved_evidence(
    admission: stale_admission,
    perturbation_target: fixture_target,
    perturbation_generation: 6,
    before_target: fixture_target,
    before_subject: fixture_subject,
    before: fixture_digest_a,
    after_target: fixture_target,
    after_subject: fixture_subject,
    after: fixture_digest_a,
    activation: ActivationVerified,
  )
  match durable_restart_verdict(evidence: [stale]) {
    StateDurabilityRefused {
      cause: DurabilityEvidenceMissing { admission: _, boundary: _ },
    } => true
    _ => false
  }
}

test fn equal_before_and_after_bytes_do_not_qualify_when_not_desired() -> Bool {
  let wrong = fixture_preserved_evidence(
    admission: current_admission(),
    perturbation_target: fixture_target,
    perturbation_generation: 7,
    before_target: fixture_target,
    before_subject: fixture_subject,
    before: fixture_digest_b,
    after_target: fixture_target,
    after_subject: fixture_subject,
    after: fixture_digest_b,
    activation: ActivationVerified,
  )
  match durable_restart_verdict(evidence: [wrong]) {
    StateDurabilityRefused {
      cause: DurabilityDesiredStateMismatch {
        desired: desired,
        before: before,
        after: after,
      },
    } =>
      desired == fixture_digest_a
        && before == fixture_digest_b
        && after == fixture_digest_b
    _ => false
  }
}

test fn a_different_readback_subject_refuses_with_typed_cause() -> Bool {
  let wrong = fixture_preserved_evidence(
    admission: current_admission(),
    perturbation_target: fixture_target,
    perturbation_generation: 7,
    before_target: fixture_target,
    before_subject: fixture_other_subject,
    before: fixture_digest_a,
    after_target: fixture_target,
    after_subject: fixture_subject,
    after: fixture_digest_a,
    activation: ActivationVerified,
  )
  match durable_restart_verdict(evidence: [wrong]) {
    StateDurabilityRefused {
      cause: DurabilityReadbackSubjectMismatch {
        position: _,
        expected: expected,
        observed: observed,
      },
    } =>
      expected == fixture_subject && observed == fixture_other_subject
    _ => false
  }
}

test fn unverified_post_boundary_activation_refuses_with_typed_cause() -> Bool {
  let unverified = fixture_preserved_evidence(
    admission: current_admission(),
    perturbation_target: fixture_target,
    perturbation_generation: 7,
    before_target: fixture_target,
    before_subject: fixture_subject,
    before: fixture_digest_a,
    after_target: fixture_target,
    after_subject: fixture_subject,
    after: fixture_digest_a,
    activation: ActivationUnverified {
      reason: "service activation was not read back",
    },
  )
  match durable_restart_verdict(evidence: [unverified]) {
    StateDurabilityRefused {
      cause: DurabilityActivationUnverified { reason: reason },
    } => reason == "service activation was not read back"
    _ => false
  }
}

test fn duplicate_preserved_and_lost_receipts_refuse_independent_of_list_order() -> Bool {
  let preserved_first = durable_restart_verdict(
    evidence: [matching_preserved_evidence(), matching_lost_evidence()],
  )
  let lost_first = durable_restart_verdict(
    evidence: [matching_lost_evidence(), matching_preserved_evidence()],
  )
  match preserved_first {
    StateDurabilityRefused {
      cause: DurabilityEvidenceAmbiguous { admission: _, boundary: _, count: 2 },
    } =>
      match lost_first {
        StateDurabilityRefused {
          cause: DurabilityEvidenceAmbiguous { admission: _, boundary: _, count: 2 },
        } => true
        _ => false
      }
    _ => false
  }
}

test fn current_effectiveness_preserves_typed_durability_refusal() -> Bool {
  match qualify_string_grounding(verdict: durable_restart_verdict(evidence: [])) {
    DurabilityDoesNotGround {
      cause: DeclaredLifetimeDoesNotGround {
        cause: DurabilityEvidenceMissing { admission: _, boundary: _ },
      },
    } => true
    _ => false
  }
}

test fn qualified_grounding_carries_effective_and_durability_evidence() -> Bool {
  match qualify_string_grounding(
    verdict: durable_restart_verdict(evidence: [matching_preserved_evidence()]),
  ) {
    DurabilityGrounds {
      effective_state_evidence: effective,
      durability_evidence: durability,
    } =>
      effective == "currently effective"
        && match durability {
          DurableLifetimeQualification {
            admission: admission,
            capability: _,
            boundaries: _,
            evidence: evidence,
          } =>
            admission == current_admission()
              && evidence == [matching_preserved_evidence()]
          _ => false
        }
    _ => false
  }
}
