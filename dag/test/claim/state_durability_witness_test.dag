module test.claim.state_durability_witness

import extdeps.crypto.hash { Digest, sha256_digest }
import std.state_durability {
  ActivationVerified,
  ControlPlaneFirmwareReplacement,
  ControlPlaneRestartBoundary,
  DurableAcross,
  DurabilityActivationScopeMismatch,
  DurabilityCapabilityAdmissionMismatch,
  DurabilityDesiredStateMismatch,
  DurabilityEvidenceAmbiguous,
  DurabilityPerturbationBoundaryMismatch,
  DurabilityReadbackReceiptLinkMismatch,
  LifecycleGracefulRestart,
  SoftwareReplacementBoundary,
  StateActivationEvidence,
  StateActivationReceipt,
  StateDurabilityAdmission,
  StateDurabilityBoundary,
  StateDurabilityCapability,
  StateDurabilityCapabilityVersion,
  StateDurabilityEvidence,
  StateDurabilityInstant,
  StateDurabilityQualified,
  StateDurabilityRefused,
  StateDurabilityTimeline,
  StateDurabilityVerdict,
  StatePerturbationGeneration,
  StatePerturbationReceipt,
  StatePreserved,
  StateReadbackReceipt,
  StateRealizationDefinitionHashes,
  StateRealizationIdentity,
  SynchronizedCommit,
  state_durability_after_readback_at,
  state_durability_boundary_requirements,
  state_durability_perturbation_completed_at,
  state_durability_perturbation_started_at,
  state_durability_satisfied,
  state_durability_verdict,
  state_realization_content_hash,
}
import std.types { Bool, ContentHash, List, NonEmptyStr }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

type FixtureTarget = NonEmptyStr where brand("FixtureTarget")

type FixtureReadbackSubject {
  path: NonEmptyStr
}

data fixture_target: FixtureTarget = "fixture-host" as FixtureTarget
data fixture_subject: FixtureReadbackSubject = FixtureReadbackSubject {
  path: "/etc/fixture-policy",
}

data fixture_boundary: StateDurabilityBoundary = ControlPlaneRestartBoundary {
  mode: LifecycleGracefulRestart,
}

data fixture_wrong_boundary: StateDurabilityBoundary = SoftwareReplacementBoundary {
  scope: ControlPlaneFirmwareReplacement,
}

data fixture_digest_a: Digest = sha256_digest(
  hex: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
)

data fixture_digest_b: Digest = sha256_digest(
  hex: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
)

fn fixture_definition_hashes(suffix: NonEmptyStr) -> StateRealizationDefinitionHashes {
  StateRealizationDefinitionHashes {
    projection: suffix as ContentHash,
    verifier: "fixture-verifier" as ContentHash,
    observer: "fixture-observer" as ContentHash,
    transport: "fixture-transport" as ContentHash,
    actuator: "fixture-actuator" as ContentHash,
  }
}

data fixture_realization: StateRealizationIdentity = StateRealizationIdentity {
  realization_id: "fixture-realizer",
  definition_hashes: fixture_definition_hashes(suffix: "projection-v1"),
}

data fixture_stale_realization: StateRealizationIdentity = StateRealizationIdentity {
  realization_id: "fixture-realizer",
  definition_hashes: fixture_definition_hashes(suffix: "projection-v0"),
}

data fixture_capability_version: StateDurabilityCapabilityVersion = StateDurabilityCapabilityVersion {
  version: "fixture-capability-v1",
  definition_hash: "fixture-capability-definition-v1" as ContentHash,
}

data fixture_stale_capability_version: StateDurabilityCapabilityVersion = StateDurabilityCapabilityVersion {
  version: "fixture-capability-v0",
  definition_hash: "fixture-capability-definition-v0" as ContentHash,
}

fn fixture_admission(
  realization: StateRealizationIdentity,
  capability_version: StateDurabilityCapabilityVersion,
  desired: Digest,
) -> StateDurabilityAdmission<FixtureTarget, FixtureReadbackSubject> {
  StateDurabilityAdmission {
    target: fixture_target,
    desired_state_digest: desired,
    realization: realization,
    capability_version: capability_version,
    perturbation_generation: 7,
    readback_subject: fixture_subject,
  }
}

fn current_admission() -> StateDurabilityAdmission<FixtureTarget, FixtureReadbackSubject> {
  fixture_admission(
    realization: fixture_realization,
    capability_version: fixture_capability_version,
    desired: fixture_digest_a,
  )
}

fn fixture_capability(
  realization: StateRealizationIdentity,
  capability_version: StateDurabilityCapabilityVersion,
) -> StateDurabilityCapability {
  StateDurabilityCapability {
    realization: realization,
    capability_version: capability_version,
    supported_boundaries: [fixture_boundary],
    commit_barrier: SynchronizedCommit,
  }
}

fn current_capability() -> StateDurabilityCapability {
  fixture_capability(
    realization: fixture_realization,
    capability_version: fixture_capability_version,
  )
}

fn fixture_timeline() -> StateDurabilityTimeline {
  StateDurabilityTimeline {
    before_readback_at: 1000 as StateDurabilityInstant,
    before_to_perturbation_start_ms: 10,
    perturbation_duration_ms: 20,
    completion_to_after_readback_ms: 30,
  }
}

fn fixture_activation(
  admission: StateDurabilityAdmission<FixtureTarget, FixtureReadbackSubject>,
  receipt_id: NonEmptyStr,
) -> StateActivationEvidence<FixtureTarget, FixtureReadbackSubject> {
  ActivationVerified {
    receipt: StateActivationReceipt {
      perturbation_receipt_id: receipt_id,
      target: admission.target,
      subject: admission.readback_subject,
      desired_state_digest: admission.desired_state_digest,
      realization: admission.realization,
      capability_version: admission.capability_version,
      perturbation_generation: admission.perturbation_generation,
    },
  }
}

fn fixture_readback(
  receipt_id: NonEmptyStr,
  digest: Digest,
) -> StateReadbackReceipt<FixtureTarget, FixtureReadbackSubject> {
  StateReadbackReceipt {
    perturbation_receipt_id: receipt_id,
    target: fixture_target,
    subject: fixture_subject,
    state_digest: digest,
  }
}

fn fixture_evidence(
  admission: StateDurabilityAdmission<FixtureTarget, FixtureReadbackSubject>,
  boundary: StateDurabilityBoundary,
  readback_receipt_id: NonEmptyStr,
  before: Digest,
  after: Digest,
  activation: StateActivationEvidence<FixtureTarget, FixtureReadbackSubject>,
) -> StateDurabilityEvidence<FixtureTarget, FixtureReadbackSubject> {
  StateDurabilityEvidence {
    admission: admission,
    perturbation: StatePerturbationReceipt {
      receipt_id: "fixture-perturbation",
      target: fixture_target,
      boundary: boundary,
      generation: 7,
    },
    outcome: StatePreserved {
      timeline: fixture_timeline(),
      before: fixture_readback(
        receipt_id: readback_receipt_id,
        digest: before,
      ),
      after: fixture_readback(
        receipt_id: readback_receipt_id,
        digest: after,
      ),
      activation: activation,
    },
  }
}

fn matching_evidence() -> StateDurabilityEvidence<FixtureTarget, FixtureReadbackSubject> {
  fixture_evidence(
    admission: current_admission(),
    boundary: fixture_boundary,
    readback_receipt_id: "fixture-perturbation",
    before: fixture_digest_a,
    after: fixture_digest_a,
    activation: fixture_activation(
      admission: current_admission(),
      receipt_id: "fixture-perturbation",
    ),
  )
}

fn durable_verdict(
  evidence: List<StateDurabilityEvidence<FixtureTarget, FixtureReadbackSubject>>,
) -> StateDurabilityVerdict<FixtureTarget, FixtureReadbackSubject> {
  state_durability_verdict(
    intent: DurableAcross {
      boundaries: state_durability_boundary_requirements(
        first: fixture_boundary,
        additional: [],
      ),
    },
    admission: current_admission(),
    capability: Present { value: current_capability() },
    evidence: evidence,
  )
}

test fn boundary_requirements_are_nonempty_and_deduplicate_by_construction() -> Bool {
  let requirements = state_durability_boundary_requirements(
    first: fixture_boundary,
    additional: [fixture_boundary, fixture_wrong_boundary, fixture_wrong_boundary],
  )
  let boundaries = requirements as List<StateDurabilityBoundary>
  fold(boundaries, init: 0, f: (count, _) => count + 1) == 2
    && any(boundaries, boundary => boundary == fixture_boundary)
    && any(boundaries, boundary => boundary == fixture_wrong_boundary)
}

test fn timeline_order_is_derived_from_positive_deltas() -> Bool {
  let timeline = fixture_timeline()
  let started = state_durability_perturbation_started_at(timeline: timeline)
  let completed = state_durability_perturbation_completed_at(timeline: timeline)
  let after = state_durability_after_readback_at(timeline: timeline)
  timeline.before_readback_at < started
    && started < completed
    && completed < after
}

test fn exact_matching_receipts_qualify() -> Bool {
  state_durability_satisfied(verdict: durable_verdict(evidence: [matching_evidence()]))
}

test fn realization_definition_change_invalidates_old_receipt() -> Bool {
  match state_durability_verdict(
    intent: DurableAcross {
      boundaries: state_durability_boundary_requirements(
        first: fixture_boundary,
        additional: [],
      ),
    },
    admission: current_admission(),
    capability: Present {
      value: fixture_capability(
        realization: fixture_stale_realization,
        capability_version: fixture_capability_version,
      ),
    },
    evidence: [],
  ) {
    StateDurabilityRefused {
      cause: DurabilityCapabilityAdmissionMismatch {
        expected_realization: _,
        observed_realization: _,
        expected_capability_version: _,
        observed_capability_version: _,
      },
    } => state_realization_content_hash(realization: fixture_realization) != state_realization_content_hash(realization: fixture_stale_realization)
    _ => false
  }
}

test fn capability_definition_change_invalidates_old_receipt() -> Bool {
  match state_durability_verdict(
    intent: DurableAcross {
      boundaries: state_durability_boundary_requirements(
        first: fixture_boundary,
        additional: [],
      ),
    },
    admission: current_admission(),
    capability: Present {
      value: fixture_capability(
        realization: fixture_realization,
        capability_version: fixture_stale_capability_version,
      ),
    },
    evidence: [],
  ) {
    StateDurabilityRefused {
      cause: DurabilityCapabilityAdmissionMismatch {
        expected_realization: _,
        observed_realization: _,
        expected_capability_version: _,
        observed_capability_version: _,
      },
    } => true
    _ => false
  }
}

test fn wrong_boundary_receipt_reaches_typed_mismatch_arm() -> Bool {
  let wrong = fixture_evidence(
    admission: current_admission(),
    boundary: fixture_wrong_boundary,
    readback_receipt_id: "fixture-perturbation",
    before: fixture_digest_a,
    after: fixture_digest_a,
    activation: fixture_activation(
      admission: current_admission(),
      receipt_id: "fixture-perturbation",
    ),
  )
  match durable_verdict(evidence: [wrong]) {
    StateDurabilityRefused {
      cause: DurabilityPerturbationBoundaryMismatch {
        expected: expected,
        observed: observed,
      },
    } => expected == fixture_boundary && observed == fixture_wrong_boundary
    _ => false
  }
}

test fn readbacks_must_link_the_perturbation_receipt() -> Bool {
  let wrong = fixture_evidence(
    admission: current_admission(),
    boundary: fixture_boundary,
    readback_receipt_id: "unrelated-perturbation",
    before: fixture_digest_a,
    after: fixture_digest_a,
    activation: fixture_activation(
      admission: current_admission(),
      receipt_id: "fixture-perturbation",
    ),
  )
  match durable_verdict(evidence: [wrong]) {
    StateDurabilityRefused {
      cause: DurabilityReadbackReceiptLinkMismatch {
        position: _,
        expected_receipt_id: expected,
        observed_receipt_id: observed,
      },
    } => expected == "fixture-perturbation" && observed == "unrelated-perturbation"
    _ => false
  }
}

test fn activation_receipt_is_scoped_to_the_admitted_digest() -> Bool {
  let stale = fixture_admission(
    realization: fixture_realization,
    capability_version: fixture_capability_version,
    desired: fixture_digest_b,
  )
  let wrong = fixture_evidence(
    admission: current_admission(),
    boundary: fixture_boundary,
    readback_receipt_id: "fixture-perturbation",
    before: fixture_digest_a,
    after: fixture_digest_a,
    activation: fixture_activation(
      admission: stale,
      receipt_id: "fixture-perturbation",
    ),
  )
  match durable_verdict(evidence: [wrong]) {
    StateDurabilityRefused {
      cause: DurabilityActivationScopeMismatch {
        expected: _,
        observed: observed,
      },
    } => observed.desired_state_digest == fixture_digest_b
    _ => false
  }
}

test fn semantically_similar_but_digest_different_state_refuses() -> Bool {
  let wrong = fixture_evidence(
    admission: current_admission(),
    boundary: fixture_boundary,
    readback_receipt_id: "fixture-perturbation",
    before: fixture_digest_b,
    after: fixture_digest_b,
    activation: fixture_activation(
      admission: current_admission(),
      receipt_id: "fixture-perturbation",
    ),
  )
  match durable_verdict(evidence: [wrong]) {
    StateDurabilityRefused {
      cause: DurabilityDesiredStateMismatch {
        desired: desired,
        before: before,
        after: after,
      },
    } =>
      desired == fixture_digest_a
        && before == fixture_digest_b
        && after == fixture_digest_b
    _ => false
  }
}

test fn duplicate_exact_receipts_are_ambiguous() -> Bool {
  match durable_verdict(evidence: [matching_evidence(), matching_evidence()]) {
    StateDurabilityRefused {
      cause: DurabilityEvidenceAmbiguous {
        admission: _,
        boundary: _,
        count: 2,
      },
    } => true
    _ => false
  }
}
