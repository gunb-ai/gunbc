module test.claim.seed_debt_bundle_item_2_floor_scope

import gunbc.ci_layer_roots { witness_layer_roots }
import std.realization_schedule {
  Runnable,
  RunnableDiscoveryBatch,
  ScheduleWitnessEntry
}
import std.measure { HardwareThreadCount, hardware_thread_count }
import std.types { List }

fn seed_debt_witness_entries() -> List<ScheduleWitnessEntry> {
  [
    ScheduleWitnessEntry {
      entry: "dag/test/claim/compile_source_model_witness_test.dag",
      function: "compile_source_model_witnesses"
    }
  ]
}

fn seed_debt_floor_scope_batches() -> List<List<Runnable>> {
  [[
    RunnableDiscoveryBatch {
      source_roots: witness_layer_roots,
      scan_dirs: [],
      explicit_entries: seed_debt_witness_entries(),
      skip_unaffected_node_frontier: false
    }
  ]]
}

fn seed_debt_floor_scope_spawn_width() -> HardwareThreadCount {
  hardware_thread_count(count: 1)
}
