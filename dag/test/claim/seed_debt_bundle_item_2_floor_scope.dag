module test.claim.seed_debt_bundle_item_2_floor_scope


fn seed_debt_witness_entries() -> List<std.realization_schedule.ScheduleWitnessEntry> {
  [
    std.realization_schedule.ScheduleWitnessEntry {
      entry: "dag/test/claim/compile_source_model_witness_test.dag",
      function: "",
      kind: std.realization_schedule.CorpusWitnessKind
    }
  ]
}

fn seed_debt_floor_scope_batches() -> List<List<std.realization_schedule.Runnable>> {
  [[
    std.realization_schedule.RunnableDiscoveryBatch {
      source_roots: gunbc.ci_layer_roots.witness_layer_roots,
      scan_dirs: [],
      explicit_entries: seed_debt_witness_entries(),
      exclude_substrings: [],
      discovery_scope_dirs: [],
      profile: std.realization_schedule.runnable_resource_profile_negligible()
    }
  ]]
}

fn seed_debt_floor_scope_spawn_width() -> std.measure.HardwareThreadCount {
  std.measure.hardware_thread_count(count: 1)
}
