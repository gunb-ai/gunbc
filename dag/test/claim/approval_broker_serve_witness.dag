import std.types { Bool, String, NonEmptyStr }
import extdeps.http.server {
  ServedRouteTable,
  ServedRouteTableBuilt, ServedRouteTableBuildRefused,
  RouteSelection, SelectedStatic, SelectedDynamic, MethodNotAllowed, NoRouteMatched,
  serve_select_route, http_extension_field_name, serve_typed_arm_header_names, serve_response_header_wire,
  HttpExtensionFieldNameAdmitted, HttpExtensionFieldNameRefused, ServeResponseHeaderField,
}
import extdeps.uri_path { path_param_value }
import std.unicode.scalar { ascii_uppercase }
import gunbc.auth.approval_broker_marker {
  ApprovalBrokerMarker, approval_broker_marker_token, approval_broker_marker_in_response, approval_broker_marker_in_text,
  approval_broker_marked_body, BrokerBodyMarked, BrokerMarkerRefused,
  ObservedMarker, NoMarkerInBody, MarkerObserved,
  BrokerNoRouteMatched, DeviceEnrolHandlerObserved,
  approval_broker_served_token, approval_serving_process_token,
}
import gunbc.auth.approval_broker_serve {
  ApprovalBrokerHandler, DeviceEnrolHandler, DeviceRedeemHandler, DevicePendingHandler, DeviceRequestHandler, DeviceEnrollmentReadbackHandler, DevicePushUpdateHandler, DeviceListHandler, DeviceRevokeHandler,
  ApprovalSubmitHandler, ApprovalStatusHandler, ApprovalStoreReceiptHandler,
  approval_broker_route_specs,
  approval_broker_route_table_build,
