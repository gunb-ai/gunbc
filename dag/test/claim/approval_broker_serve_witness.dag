import extdeps.http.server { ServeHttpResponse, serve_wire_response, application_json_utf8 }
import extdeps.languages.json.parse { parse_json_document, JsonDocumentParsed, JsonDocumentUnreadable }
import gunbc.auth.approval_broker_endpoint {
  approval_broker_submit_path,
  approval_broker_status_path_template,
  approval_broker_listen_port,
  approval_broker_submit_url,
  approval_broker_status_url,
}
import extdeps.ietf.http_semantics { HttpMethod, GET, POST, PUT }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// A Refused build yields the EMPTY table here, so every selection claim below goes RED — the
// discriminating direction. The production path never does this: approval_broker_respond answers
// 500 naming the broken literal.
fn broker_table_or_empty() -> ServedRouteTable<ApprovalBrokerHandler> {
  match approval_broker_route_table_build() {
    ServedRouteTableBuilt { table: t } => t
    ServedRouteTableBuildRefused { raw: _, segment: _, reason: _ } => ServedRouteTable { routes: [] }
  }
}

fn broker_selects(method: HttpMethod, path: String, want: ApprovalBrokerHandler) -> Bool {
  match serve_select_route(table: broker_table_or_empty(), method: method, path: path) {
    SelectedDynamic { handler: h, params: _ } => h == want
    SelectedStatic { route: _ } => false
    MethodNotAllowed { allowed: _ } => false
    NoRouteMatched => false
  }
}

// THE POSITIVE CONTROL FOR THE ROADMAP'S WALL. test.claim.roadmap.roadmap_serve_witness asserts the
// roadmap answers nothing for the filing routes; this establishes they are answered HERE, so the pair
// says the routes moved rather than vanished. AND THE BEARER PAIR IS GONE: GET and POST on
// /approve/<capability> -- the confirm page and its decide -- match no route at all after the device
// cutover, so a disclosed capability has no URL to be spent at. Restore either row and this goes red.
test fn approval_broker_table_selects_the_filing_routes_and_no_bearer_route() -> Bool {
  broker_selects(method: POST, path: "/approvals", want: ApprovalSubmitHandler)
    && broker_selects(method: GET, path: "/approvals/esc-1", want: ApprovalStatusHandler)
    && match serve_select_route(table: broker_table_or_empty(), method: GET, path: "/approve/esc-1.approve.0badc0de") { NoRouteMatched => true  _ => false }
    && match serve_select_route(table: broker_table_or_empty(), method: POST, path: "/approve/esc-1.approve.0badc0de") { NoRouteMatched => true  _ => false }
}

// THE STORE RECEIPT ROUTE IS A POST ON THE ESCALATION'S MEMBER PATH, and a GET there is 405 -- never
// the status read, which would hand bearer authority to any poller.
test fn approval_broker_table_selects_the_store_receipt_route_as_a_post() -> Bool {
  broker_selects(method: POST, path: "/approvals/esc-1/store-receipt", want: ApprovalStoreReceiptHandler)
    && broker_selects(method: GET, path: "/approvals/esc-1", want: ApprovalStatusHandler)
    && match serve_select_route(table: broker_table_or_empty(), method: GET, path: "/approvals/esc-1/store-receipt") {
      MethodNotAllowed { allowed: ms } => count(ms) == 1
      _ => false
    }
}

// THE SIX PHONE ROUTES ARE ANSWERED HERE AND ONLY AS POSTS (gunbc.auth.approval_device_wire:
// every device operation is a POST whose body carries its authentication). The two suffixed
// routes bind one segment; a GET on any of them is 405, not a read.
test fn approval_broker_table_selects_the_device_routes_with_their_methods() -> Bool {
  broker_selects(method: POST, path: "/approve/device/enrol", want: DeviceEnrolHandler)
    && broker_selects(method: POST, path: "/approve/device/redeem", want: DeviceRedeemHandler)
    && broker_selects(method: POST, path: "/approve/device/pending", want: DevicePendingHandler)
    && broker_selects(method: POST, path: "/approve/device/requests/id-ZXNj", want: DeviceRequestHandler)
    && broker_selects(method: POST, path: "/approve/device/enrollments/id-ZW5y", want: DeviceEnrollmentReadbackHandler)
    && broker_selects(method: POST, path: "/approve/device/push", want: DevicePushUpdateHandler)
    // THE TWO OPERATOR ROUTES: the list is a GET, the revoke a POST binding one enrollment segment.
    && broker_selects(method: GET, path: "/approve/devices", want: DeviceListHandler)
    && broker_selects(method: POST, path: "/approve/devices/revoke/id-ZW5y", want: DeviceRevokeHandler)
    && match serve_select_route(table: broker_table_or_empty(), method: GET, path: "/approve/device/pending") {
      MethodNotAllowed { allowed: ms } => count(ms) == 1
      _ => false
    }
}

// THE TABLE IS EXACTLY THE TWELVE: the favicon and the two filing routes, the store receipt route and the eight
// device routes (six phone routes, the operator list and revoke). A new row is not a neutral addition: every route this process serves is one more
// thing whose demand shares the broker's slice, and the split exists because co-tenancy is what
// made an approval poll depend on a dashboard render. The eleventh is the approval loop's own: a
// receipt is minted from the broker's decision store and nowhere else, and it is a separate POST so
// that bearer authority over store writes never rides the public status GET.
test fn approval_broker_table_carries_no_other_route() -> Bool {
  count(approval_broker_route_specs()) == 12
    && match approval_broker_route_table_build() {
      ServedRouteTableBuilt { table: t } => count(t.routes) == 12
      ServedRouteTableBuildRefused { raw: _, segment: _, reason: _ } => false
    }
}

// ── THE INHABITANCE CLAIM ────────────────────────────────────────────────────────────────────
// Every claim above supplies a (method, path) at the ROUTE TABLE boundary and inspects what the
// table answers. DESIGN section 3's pairing obligation is that some claim still runs the real path,
// and it is discharged here: this enters approval_broker_respond -- the fold the serve entry calls --
// with the bytes a request carries, and lets it build the table, select, consult the writer gate and
// run the submission fold, whose unreadable body refuses before any store effect -- the one handler
// that reaches its fold with no host read, so this runs hermetically (the device routes read the
// clock first). DELETE THE INTEGRATION AND THIS GOES RED: remove the submit row from the specs and the
// same call answers the adapter's own 404.
test fn approval_broker_filing_route_answers_through_the_real_entry() -> Bool {
  let r = broker_respond_as(process: live_writer(), method_label: "POST", path: approval_broker_submit_path as String, body: "{}")
  r.status == 400 && string_contains(s: r.body, pattern: "approval submission:")
}

// THE ADAPTER'S 404 IS ITS OWN, not the table's absence: a path this process does not serve answers
// not-found through the same entry rather than reaching a handler.
test fn approval_broker_entry_refuses_a_roadmap_path() -> Bool {
  let r = approval_broker_respond(
    method_label: "GET",
    path: "/roadmap",
    body: "",
    tailscale_identity: "",
  )
  r.status == 404
}

// ── THE MARKER IS PRODUCED BY THE REAL PATH, WHICH IS WHAT MAKES THE CUTOVER'S PROBE A READING ──
// THE PAIRING OBLIGATION FOR gunbc.auth.approval_broker_cutover (DESIGN section 3): those claims
// SUPPLY an ObservedMarker to admission, so something must run the producer. The JSON device route
// carries its marker in the header (a_device_route_json_marker_is_in_the_header_the_reader_looks_in
// below), and the adapter's own 404 carries it too.
// THE ADAPTER'S OWN 404 IS MARKED TOO, and this is the half the cutover's prefix-strip reading rests
// on. A request that reaches the broker and matches no route must be distinguishable from one that
// never arrived, and the only channel is the body -- so the not-found path carries
// approval-broker/no-route-matched and the front-door probe can tell the two apart.
test fn the_brokers_own_not_found_is_marked_as_having_reached_the_broker() -> Bool {
  let r = approval_broker_respond(
    method_label: "GET",
    path: "/roadmap",
    body: "",
    tailscale_identity: "",
  )
  r.status == 404
    && (match approval_broker_marker_in_response(headers: serve_wire_response(r: r).headers, body: r.body) {
      MarkerObserved { process: p, marker: m } =>
        approval_broker_served_token(p: p, m: m) == approval_broker_served_token(p: BrokerProcess, m: BrokerNoRouteMatched)
      NoMarkerInBody => false
    })
}

// ── THE SAME FOLD, SERVED BY THE ROADMAP, IS A DIFFERENT MARKER ─────────────────────────────
// THE RED THAT REVIEW 68539 SHOWED WAS MISSING, and it is the claim that makes the whole scheme
// mean what its prose says. Until the last cutover stage the roadmap MOUNTS THESE FOLDS -- it
// projects its approval rows from approval_broker_route_specs and invokes them with
// process: RoadmapProcess -- so the marker has to separate the two processes on a route they BOTH
// serve correctly. With the token naming only the fold, both produced identical bytes here.
//
// It runs the real adapter for both, on the same method and path, so the only difference between
// the two calls is the process the entry binds. DELETE THE PROCESS FROM THE TOKEN AND THIS GOES
// RED, while every other marker claim in this file stays green -- which is exactly how the defect
// survived.
//
// WHAT IT DOES NOT ESTABLISH, said rather than left to be assumed: it enters this module's adapter
// with process: RoadmapProcess, not gunbc.roadmap.roadmap_serve's own table. That is the same fold
// with the same process value -- roadmap_serve's approval arm calls approval_broker_invoke, which is
// what this reaches -- but it is not evidence about the roadmap's route table, and a claim that
// entered there would take on that module's whole subject (instance, plan, release) for one fact
// about marking.
test fn the_two_processes_do_not_produce_the_same_marker_on_one_route() -> Bool {
  let by_broker = approval_broker_respond_as(
    method_label: "GET",
    path: "/approvals",
    body: "",
    tailscale_identity: "",
    process: BrokerProcess,
  )
  let by_roadmap = approval_broker_respond_as(
    method_label: "GET",
    path: "/approvals",
    body: "",
    tailscale_identity: "",
    process: RoadmapProcess,
  )
  let seen_broker = match approval_broker_marker_in_response(headers: serve_wire_response(r: by_broker).headers, body: by_broker.body) {
    MarkerObserved { process: p, marker: _ } => approval_serving_process_token(p: p) as String
    NoMarkerInBody => "none"
  }
  let seen_roadmap = match approval_broker_marker_in_response(headers: serve_wire_response(r: by_roadmap).headers, body: by_roadmap.body) {
    MarkerObserved { process: p, marker: _ } => approval_serving_process_token(p: p) as String
    NoMarkerInBody => "none"
  }
  by_broker.status == by_roadmap.status
    && seen_broker == "broker"
    && seen_roadmap == "roadmap"
    && seen_broker != seen_roadmap
}

// ── THE LOOPBACK ENDPOINT A BOOT RUN IS POINTED AT ──────────────────────────────────────────
// ONE ADDRESS FOR THE PROCESS'S WHOLE LIFE, so a boot client needs no cutover-aware port logic: the
// same URL reaches the broker while it is dark and after it holds the store, and what changes is
// whether the write is ADMITTED (gunbc.auth.approval_writer_authority), not where it lands. An
// earlier cut parameterised this over a dark port and a serving port, which made the client's
// correctness depend on knowing which stage the deployment was in (side-chat HOLD item 1).
test fn the_loopback_submit_url_names_the_brokers_one_port() -> Bool {
  let url = approval_broker_submit_url(port: approval_broker_listen_port) as String
  string_contains(s: url, pattern: join(["127.0.0.1:", to_string(approval_broker_listen_port)], ""))
    && string_contains(s: url, pattern: approval_broker_submit_path as String)
}

// THE STATUS URL IS THE SUBMIT COLLECTION PLUS A MEMBER, and the claim is here because the obvious
// implementation is a second "/approvals/" literal that agrees until one of them moves. A status URL
// built this way reaches the route the broker's table actually carries.
test fn the_loopback_status_url_is_the_submit_collection_plus_the_escalation() -> Bool {
  let url = approval_broker_status_url(port: approval_broker_listen_port, escalation_id: "esc-1" as NonEmptyStr) as String
  url == join([approval_broker_submit_url(port: approval_broker_listen_port) as String, "/esc-1"], "")
    && broker_selects(method: GET, path: join([approval_broker_submit_path as String, "/esc-1"], ""), want: ApprovalStatusHandler)
}

// ══════════════════════════════════════════════════════════════════════════════════════════════
// WRITER AUTHORITY IS CONSULTED BEFORE ANY STORE MUTATION — side-chat HOLD item 3
// ══════════════════════════════════════════════════════════════════════════════════════════════
// PORT IDENTITY IS NOT WRITER AUTHORITY. The earlier design kept the broker on a separate port and
// treated being off the front door as being unable to write. That holds only for traffic arriving
// through the front door; a boot client on the same host reaches loopback directly, and the moment
// one does, two processes with working keyrings and one store root are both able to write it.
//
// So the two MUTATING routes consult gunbc.auth.approval_writer_authority before the store, and the
// process that is not the declared writer refuses. These claims run the real entry fold for both
// process identities, which is the only way to establish that the gate is on the path rather than
// merely declared beside it.

fn broker_respond_as(process: ApprovalServingProcess, method_label: String, path: String, body: String) -> ServeHttpResponse {
  approval_broker_respond_as(
    method_label: method_label,
    path: path,
    body: body,
    tailscale_identity: "",
    process: process,
  )
}

// THE ROADMAP MOUNT CANNOT FILE WHILE THE BROKER HOLDS AUTHORITY, and vice versa. Exactly one of
// the two process identities is admitted at any value of the row, which is the single-writer
// property stated where it is decided.
test fn exactly_one_process_may_write_at_every_authority_value() -> Bool {
  let roadmap_holds = approval_write_admission_under(authority: RoadmapWriter, asker: RoadmapProcess)
  let roadmap_holds_broker_asks = approval_write_admission_under(authority: RoadmapWriter, asker: BrokerProcess)
  let broker_holds = approval_write_admission_under(authority: BrokerWriter, asker: BrokerProcess)
  let broker_holds_roadmap_asks = approval_write_admission_under(authority: BrokerWriter, asker: RoadmapProcess)
  admitted(a: roadmap_holds) && !admitted(a: roadmap_holds_broker_asks)
    && admitted(a: broker_holds) && !admitted(a: broker_holds_roadmap_asks)
}

fn admitted(a: ApprovalWriteAdmission) -> Bool {
  match a {
    ApprovalWriteAdmitted { writer: _ } => true
    ApprovalWriteRefused { holder: _, asker: _ } => false
  }
}

// THE WRITER AND THE NON-WRITER ARE READ FROM THE LIVE AUTHORITY, never spelled. They were spelled
// once (review 68224 found them backwards) and spelled again they would invert silently at the
// posture flip, reporting the old authority's shape as coverage of the new one. Deriving them keeps
// every claim below about the gate at whatever posture is live.
fn live_writer() -> ApprovalServingProcess {
  approval_writer_process(authority: approval_writer_authority)
}

fn live_non_writer() -> ApprovalServingProcess {
  match approval_writer_authority {
    RoadmapWriter => BrokerProcess
    BrokerWriter => RoadmapProcess
  }
}

// ── WHICH IDENTITY IS THE NON-WRITER TODAY, AND WHY GETTING IT BACKWARDS MATTERED ───────────
// These two claims passed RoadmapProcess and called it the non-writer. It is the WRITER: the live
// posture is RoadmapServesAndWrites, which derives RoadmapWriter, whose process is RoadmapProcess.
// The non-writer today is BrokerProcess (review 68224).
//
// THE SUBMISSION CLAIM WENT RED, which is the honest half. THE DECISION CLAIM LANDED ON 503 ANYWAY,
// through RedemptionIdentityUntrusted -- because approval_identity_trust is NotEstablished while
// the unit binds 0.0.0.0 -- and only the body conjunct saved it. Had I asserted status alone, it
// would have been PERMANENTLY GREEN through a mechanism it does not exercise, which is precisely
// the designed-fixture failure DESIGN section 3 names: the claim reaches the right verdict by the
// wrong route, so the wall it was built to be is gone while it still reports coverage. The body
// assertion is what made the near-miss visible, and it stays for that reason rather than as detail.
//
// THE PAIR BELOW IS WHAT THE GATE ACTUALLY NEEDS: the non-writer refused with the authority's own
// reason, and the writer NOT refused that way -- because a claim that only shows a refusal cannot
// tell a working gate from one that refuses everybody.

// THE GATE IS ON THE REQUEST PATH, NOT BESIDE IT. This runs the broker's own adapter under the
// non-writer identity, so a future edit removing the consult from approval_submit_response reds
// here even though the admission fold itself still exists and its own claims still pass.
test fn a_non_writer_submission_is_refused_before_the_store() -> Bool {
  let r = broker_respond_as(
    process: live_non_writer(),
    method_label: "POST",
    path: approval_broker_submit_path as String,
    body: "{}",
  )
  r.status == 503 && string_contains(s: r.body, pattern: "writer authority is held by")
}

// THE WRITER IS NOT REFUSED BY THE GATE, and this is the conjunct that makes the claim above mean
// something. The same malformed body under the WRITER identity reaches the envelope parse and comes
// back as a submission outcome -- so the gate discriminates on identity rather than refusing every
// caller. THE RED: make approval_write_admission refuse unconditionally and this fails while the
// claim above still passes.
test fn the_writer_reaches_the_submission_fold_rather_than_the_gate() -> Bool {
  let r = broker_respond_as(
    process: live_writer(),
    method_label: "POST",
    path: approval_broker_submit_path as String,
    body: "{}",
  )
  !string_contains(s: r.body, pattern: "writer authority is held by")
    && string_contains(s: r.body, pattern: "approval submission:")
}

// THE SAME FOR THE ONE ROUTE THAT COMMITS A DECISION -- the device redeem route -- and here the
// BODY is the whole assertion: a status-only claim could pass on a 503 from some other refusal, so
// what discriminates is WHICH refusal came back. THE RED: make the gate admit every asker and the
// non-writer half fails; make it refuse every asker and the writer half fails. The device routes read
// the clock before the gate, so this and the pending-read claim below observe only under --wet, like
// the JSON-marker claims after them; the hermetic gate coverage is the submission pair above.
test fn a_non_writer_decision_is_refused_before_the_store() -> Bool {
  let refused = broker_respond_as(
    process: live_non_writer(),
    method_label: "POST",
    path: "/approve/device/redeem",
    body: "not json",
  )
  refused.status == 503
    && string_contains(s: refused.body, pattern: "writer authority is held by")
    && admitted(a: approval_write_admission_under(authority: approval_writer_authority, asker: live_writer()))
}

// THE READ ROUTES ARE NOT GATED, because gating a read would refuse a poll that is safe from either
// process and would say nothing true about single-writer discipline. It runs under the NON-WRITER
// identity, which is the arm that would break if a future edit gated reads by authority.
test fn a_non_writer_may_still_reach_the_pending_read() -> Bool {
  let r = broker_respond_as(
    process: live_non_writer(),
    method_label: "POST",
    path: "/approve/device/pending",
    body: "not json",
  )
  r.status != 404 && !string_contains(s: r.body, pattern: "writer authority is held by")
}

// ── A JSON ANSWER IS STILL JSON, AND STILL MARKED ──────────────────────────────────────────────
// THE DEFECT: approval_broker_marked_body appended `x-approval-broker: <token>` to the body of every
// subtype without comment syntax, so POST /approve/device/enrol answered `{...}x-approval-broker: ...`
// and the phone app's strict decoder could read no device route. These claims run the REAL entry
// (the pairing obligation: a supplied hypothesis about the boundary is a reading only once the
// producer has run) on a device route whose request body the route refuses before any store effect.
fn device_enrol_refusal_through_the_real_entry() -> ServeHttpResponse {
  approval_broker_respond(
    method_label: "POST",
    path: "/approve/device/enrol",
    body: "not json",
    tailscale_identity: "",
  )
}

test fn a_device_route_json_body_parses_as_json_with_no_marker_in_it() -> Bool {
  let r = device_enrol_refusal_through_the_real_entry()
  r.content_type == application_json_utf8
    && !string_contains(s: r.body, pattern: "approval-broker/")
    && !string_contains(s: r.body, pattern: "x-approval-broker")
    && (match parse_json_document(s: r.body) {
      JsonDocumentParsed { value: _ } => true
      JsonDocumentUnreadable { gap: _ } => false
    })
}

test fn a_device_route_json_marker_is_in_the_header_the_reader_looks_in() -> Bool {
  let r = device_enrol_refusal_through_the_real_entry()
  let seen = approval_broker_marker_in_response(headers: serve_wire_response(r: r).headers, body: r.body)
  let body_only = approval_broker_marker_in_text(body: r.body)
  (match seen {
    MarkerObserved { process: p, marker: m } =>
      approval_broker_served_token(p: p, m: m)
        == approval_broker_served_token(p: BrokerProcess, m: DeviceEnrolHandlerObserved)
    NoMarkerInBody => false
  }) && (match body_only {
    NoMarkerInBody => true
    MarkerObserved { process: _, marker: _ } => false
  })
}

// RED CONTROL: the old arm, spelled out, on the same JSON. If this parses, the parse claim above
// discriminates nothing.
test fn the_old_body_appended_marker_does_not_parse_as_json() -> Bool {
  let r = device_enrol_refusal_through_the_real_entry()
  let old = join([r.body, "x-approval-broker: ", approval_broker_served_token(p: BrokerProcess, m: DeviceEnrolHandlerObserved) as String, "\n"], "")
  match parse_json_document(s: old) {
    JsonDocumentParsed { value: _ } => false
    JsonDocumentUnreadable { gap: _ } => true
  }
}

// The producer's own arm: a JSON body comes back byte-identical and the marker is one header.
test fn a_json_body_is_served_untouched_with_exactly_one_marker_header() -> Bool {
  let j = approval_broker_marked_body(content_type: application_json_utf8, body: "{}", m: DeviceEnrolHandlerObserved, process: BrokerProcess)
  match j {
    BrokerBodyMarked { body: b, headers: hs } => b == "{}" && hs.length() == 1
    BrokerMarkerRefused { reason: _ } => false
  }
}

// The sealed name's one construction route: a token is admitted and rides the wire as that label.
test fn the_field_name_admits_a_token_and_the_wire_carries_it_verbatim() -> Bool {
  match http_extension_field_name(label: "X-Served-By") {
    HttpExtensionFieldNameAdmitted { name: n } => {
      let w = serve_response_header_wire(header: ServeResponseHeaderField { name: n, value: "t" })
      w.name == "X-Served-By" && w.value == "t"
    }
    HttpExtensionFieldNameRefused { cause: _ } => false
  }
}

// RED controls: a framing field (any case), a non-token and an empty label are refused.
test fn the_field_name_refuses_a_framing_field_and_a_non_token() -> Bool {
  let framing = match http_extension_field_name(label: "Content-Length") {
    HttpExtensionFieldNameAdmitted { name: _ } => false
    HttpExtensionFieldNameRefused { cause: _ } => true
  }
  let folded = match http_extension_field_name(label: "tRaNsFeR-eNcOdInG") {
    HttpExtensionFieldNameAdmitted { name: _ } => false
    HttpExtensionFieldNameRefused { cause: _ } => true
  }
  let spaced = match http_extension_field_name(label: "X Bad: y") {
    HttpExtensionFieldNameAdmitted { name: _ } => false
    HttpExtensionFieldNameRefused { cause: _ } => true
  }
  let empty = match http_extension_field_name(label: "") {
    HttpExtensionFieldNameAdmitted { name: _ } => false
    HttpExtensionFieldNameRefused { cause: _ } => true
  }
  let typed_arm = match http_extension_field_name(label: "set-cookie") {
    HttpExtensionFieldNameAdmitted { name: _ } => false
    HttpExtensionFieldNameRefused { cause: _ } => true
  }
  let location = match http_extension_field_name(label: "Location") {
    HttpExtensionFieldNameAdmitted { name: _ } => false
    HttpExtensionFieldNameRefused { cause: _ } => true
  }
  framing && folded && spaced && empty && typed_arm && location
}

fn field_name_is_refused(label: String) -> Bool {
  match http_extension_field_name(label: label) {
    HttpExtensionFieldNameAdmitted { name: _ } => false
    HttpExtensionFieldNameRefused { cause: _ } => true
  }
}

test fn every_typed_arm_field_name_is_refused_in_any_case() -> Bool {
  let names = serve_typed_arm_header_names()
  (names |> count) == 3
    && all(names, n => field_name_is_refused(label: n) && field_name_is_refused(label: ascii_uppercase(s: n)))
}
