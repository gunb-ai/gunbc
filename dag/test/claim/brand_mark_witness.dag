module test.claim.brand_mark_witness

import std.types { Bool, String }
import extdeps.languages.html { serialize_html_source }
import gunbc.design.brand_mark {
  FaceMark, RobotMark, brand_mark_body_path, brand_mark_antenna_path, brand_mark_body_transform, brand_mark_svg,
}
import gunbc.site.brand { site_favicon_source }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE ORACLE IS THE FIRST AUTHORED SPELLING, NOT THIS MODULE'S OWN OUTPUT. Each literal below is a
// path as gunb-ai/frontend legacy/moodboard.html (#stoic-robot) and assets/mark.svg drew it before
// the template existed, so a template edit that moves either mark goes red here rather than
// re-deriving its own expectation.
data face_eyes_and_mouth: String = "M27,48 A8,8 0 0,1 43,48 A8,8 0 0,1 27,48 Z M77,48 A8,8 0 0,1 93,48 A8,8 0 0,1 77,48 Z M54,54 H66 A2,2 0 0,1 68,56 V58 A2,2 0 0,1 66,60 H54 A2,2 0 0,1 52,58 V56 A2,2 0 0,1 54,54 Z"

data squircle_body: String = "M40,20 H80 A30,30 0 0,1 110,50 V70 A30,30 0 0,1 80,100 H40 A30,30 0 0,1 10,70 V50 A30,30 0 0,1 40,20 Z"

test fn the_robot_mark_paths_are_the_symbols_spelling() -> Bool {
  brand_mark_body_path(variant: RobotMark) == join([squircle_body, "M30,41 H40 A2,2 0 0,1 42,43 V53 A2,2 0 0,1 40,55 H30 A2,2 0 0,1 28,53 V43 A2,2 0 0,1 30,41 Z M80,41 H90 A2,2 0 0,1 92,43 V53 A2,2 0 0,1 90,55 H80 A2,2 0 0,1 78,53 V43 A2,2 0 0,1 80,41 Z M54,54 H66 A2,2 0 0,1 68,56 V58 A2,2 0 0,1 66,60 H54 A2,2 0 0,1 52,58 V56 A2,2 0 0,1 54,54 Z"], " ")
    && brand_mark_antenna_path == "M58,6 H62 V12 H58 Z M55,5 A5,5 0 0,1 65,5 A5,5 0 0,1 55,5 Z"
    && brand_mark_body_transform == "translate(-12 -12) scale(1.2)"
}

// The face is mark.svg's body, two 8-unit round eyes centred at (35,48) and (85,48), and the mouth.
test fn the_face_mark_is_the_seal_geometry() -> Bool {
  brand_mark_body_path(variant: FaceMark) == join([squircle_body, face_eyes_and_mouth], " ")
}

// The robot alone carries the antenna; the face is one transformed path and nothing else.
test fn only_the_robot_has_an_antenna() -> Bool {
  let face = serialize_html_source(node: brand_mark_svg(variant: FaceMark, class_name: "f", label: "f"))
  let robot = serialize_html_source(node: brand_mark_svg(variant: RobotMark, class_name: "r", label: "r"))
  !string_contains(s: face, pattern: brand_mark_antenna_path)
    && string_contains(s: robot, pattern: brand_mark_antenna_path)
}

// The favicon the workspace serves is the face on the stone badge, painted in the ink.
test fn the_favicon_is_the_face_on_the_stone_badge() -> Bool {
  let svg = site_favicon_source()
  string_contains(s: svg, pattern: face_eyes_and_mouth)
    && string_contains(s: svg, pattern: "fill=\"#f4f1ec\"")
    && string_contains(s: svg, pattern: "color=\"#0f0f0f\"")
}
