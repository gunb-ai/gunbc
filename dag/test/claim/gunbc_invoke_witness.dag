module test.claim.gunbc_invoke_witness

import gunbc.live_deploy.live_deploy_ci_step {
  gunbc_ci_live_deploy_apply_srv1_invoke,
  gunbc_ci_desired_instance_receipt_identity_invoke,
  gunbc_ci_desired_instance_deploy_invoke,
  gunbc_ci_live_deploy_transaction_invoke
}
import gunbc.ci.ci_release_build { ci_floor_build_verify_script }
import gunbc.cli_invoke {
  claim_executor_verify_artifacts_shell,
  gunbc_run_invocation_words,
  gunbc_run_transport_argv,
  invocation_words_bare,
  source_roots_shell_flags,
  SourceRootBare,
  SourceRootRooted
}
import v2.workflow.gunbc_invoke_step_emit { gunbc_run_step_script }
import v2.std.diagnostic { Accepted, Rejected, diagnostics_reason_lexemes, outcome_accepted_value }
import std.optional { Present, Absent }
import gunbc.ci.ci_layer_roots { witness_layer_roots, witness_layer_source_flags }
import gunbc.ci.ci_release_bins {
  ci_floor_required_artifact_names
}
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// Hand-frozen pre-Phase-3a bytes from origin/main
// gunbc_ci_deploy_invoke(gunbc_ci_deploy_srv1_stage) before gunbc.cli_invoke consolidation. That
// invoke and its stage were deleted as unreached (gunbc.plans.closure_consolidation P1); the live
// dashboard deploy, gunbc.live_deploy.live_deploy_ci_step gunbc_ci_live_deploy_apply_srv1_invoke,
// renders the same target through the same helper with the same arguments, so the goldens now read it.
// Independent of gunbc_run_shell so a helper drift cannot green both sides (PR #6467
// ci_cargo_eagain_retry_core_golden pattern).

data gunbc_ci_deploy_invoke_srv1_pre_migration_golden: String = concat(
  concat("ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)\n"),
  concat(
    "\"$ROOT/target/release/gunbc\" run --source-root \"$ROOT/dag\" --source-root \"$ROOT/src/v2\"",
    concat(
      " --entry dag/gunbc/live_deploy/apply.dag",
      " --function live_deploy_apply_prod_role_wet\n"
    )
  )
)

data gunbc_ci_deploy_invoke_srv1_wrong_entry_golden: String = concat(
  concat("ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)\n"),
  concat(
    "\"$ROOT/target/release/gunbc\" run --source-root \"$ROOT/dag\" --source-root \"$ROOT/src/v2\"",
    concat(
      " --entry dag/gunbc/live_deploy/WRONG_ENTRY.dag",
      " --function live_deploy_apply_prod_role_wet\n"
    )
  )
)

// THE GOLDEN IS UNEDITED AND THE ASSERTION MOVED INSTEAD, which is the opposite of the tempting fix
// and the reason this row exists. gunbc_ci_deploy_invoke_srv1_pre_migration_golden is a hand-frozen
// byte string authored before the orchestration-emit binding, deliberately independent of the
// helper so that a helper change cannot green both sides. After the binding it FAILED, and the
// cheap move -- repaste the new output into the golden -- would have destroyed exactly the
// independence that makes it worth having: a golden derived from the thing it checks asserts
// nothing. So the golden keeps its original bytes and the assertion below states the measured
// relationship instead. MEASURED, not assumed: concat(new output, newline) == the golden, exactly.
// The migration is byte-preserving for this invocation apart from one trailing newline. WHERE THAT
// NEWLINE WENT AND WHY IT IS NOT RESTORED: the deleted gunbc_run_shell appended a newline to every
// invocation it built, so a caller that added a receipt cat after it got the newline as a SEPARATOR
// and a caller that did not got it as a trailing byte -- one spelling doing two jobs.
// v2.std.orchestration joins pipeline steps with newlines and emits none after the last, so
// separation is now structural and the trailing byte simply has no author. Restoring it would mean
// re-introducing a per-site concat to reproduce an artifact of the mechanism this change deletes,
// which is gunbc.design_argument::self_hosting's warts-for-byte-identity trap. The emitted workflows are unaffected
// either way: the YAML block-scalar emitter normalizes the block body, and the measured
// fleet-converge.yml diff carries no whitespace change at any bound step.

test fn gunbc_invoke_deploy_matches_pre_migration_golden_holds() -> Bool {
  match outcome_accepted_value(gunbc_ci_live_deploy_apply_srv1_invoke()) {
    Present { value: s } => concat(s, "\n") == gunbc_ci_deploy_invoke_srv1_pre_migration_golden
    Absent => false
  }
}

test fn gunbc_invoke_deploy_pre_migration_golden_red_on_wrong_entry_holds() -> Bool {
  match outcome_accepted_value(gunbc_ci_live_deploy_apply_srv1_invoke()) {
    Present { value: s } => s != gunbc_ci_deploy_invoke_srv1_wrong_entry_golden
    Absent => false
  }
}

test fn gunbc_invoke_source_root_flags_authority_holds() -> Bool {
  witness_layer_source_flags(roots: witness_layer_roots) ==
    source_roots_shell_flags(roots: witness_layer_roots, style: SourceRootBare)
    && source_roots_shell_flags(roots: witness_layer_roots, style: SourceRootRooted { root_var: "$ROOT" }) ==
      concat(" --source-root \"$ROOT/dag\"", " --source-root \"$ROOT/src/v2\"")
}

fn transport_argv_contains_flag(argv: List<String>, flag: String) -> Bool {
  fold(argv, init: false, f: (acc, arg) => acc || arg == flag)
}

test fn gunbc_invoke_verify_artifacts_shell_nonempty_holds() -> Bool {
  let script = claim_executor_verify_artifacts_shell(artifact_paths: ["\"$ROOT/target/release/gunbc\""])
  string_contains(s: script, pattern: "--verify-build-artifacts")
    && string_contains(s: script, pattern: "\"$ROOT/target/release/gunbc\"")
    && ci_floor_build_verify_script() == concat(
      join(
        concat(
          ["\"$ROOT\"'/target/release/claim_executor' '--verify-build-artifacts'"],
          map(ci_floor_required_artifact_names(), name => concat("\"$ROOT\"'/target/release/", concat(name, "'")))
        ),
        " "
      ),
      "\n"
    )
}

// THE EXECUTING EVIDENCE that v2.workflow.gunbc_invoke_step_emit's fail-closed word wall is real
// rather than declared. The positive control is
// gunbc_invoke_deploy_matches_pre_migration_golden_holds above -- a hand-frozen golden authored
// before the migration, so the binding must reproduce bytes it did not author. The discriminating
// RED is below: an entry carrying a shell metacharacter must NOT reach the emitted command, and the
// refusal must be a marker that is not valid workflow shell so the committed workflow drift gate
// goes red. These two stay enrolled after the wall lands; deleting them would recreate
// specification-without-execution one rung up (gunbc.design_argument::guarantee_ladder, dissolution-on-climb applies to
// production handling only, never the evidence).

test fn gunbc_invoke_word_wall_refuses_metacharacter_entry_holds() -> Bool {
  match gunbc_run_step_script(
    source_roots: witness_layer_roots,
    entry: "dag/gunbc/evil.dag; rm -rf /",
    function: "probe_wet",
    receipt_rel: none
  ) {
    // The word wall now returns a TYPED, located Rejected (no in-band marker string). The discriminating
    // assertion is on the REASON: it names the fail-closed wall and shows the refused word sanitized
    // through the emitter alphabet, and it must not leak the raw metacharacter or an emitted command line.
    Rejected { diagnostics: d } =>
      let reason = diagnostics_reason_lexemes(diagnostics: d)
      string_contains(s: reason, pattern: "gunbc invoke word wall refused")
      && string_contains(s: reason, pattern: "dag/gunbc/evil.dag__rm_-rf_/")
      && !string_contains(s: reason, pattern: "rm -rf /")
      && !string_contains(s: reason, pattern: "target/release/gunbc\" run")
    Accepted { value: _ } => false
  }
}

test fn gunbc_invoke_word_wall_admits_ordinary_entry_holds() -> Bool {
  match gunbc_run_step_script(
    source_roots: witness_layer_roots,
    entry: "dag/gunbc/host/host_reach_identity_probe.dag",
    function: "probe_fleet_reach_wet",
    receipt_rel: "target/fleet-reach-probe-receipt.txt"
  ) {
    Accepted { value: admitted } =>
      string_contains(s: admitted, pattern: "\"$ROOT/target/release/gunbc\" run --source-root \"$ROOT/dag\"")
      && string_contains(s: admitted, pattern: "--entry dag/gunbc/host/host_reach_identity_probe.dag --function probe_fleet_reach_wet")
      && string_contains(s: admitted, pattern: "cat \"$ROOT/target/fleet-reach-probe-receipt.txt\"")
    Rejected { diagnostics: _ } => false
  }
}

test fn gunbc_invoke_argv_and_emitted_step_share_one_authority_holds() -> Bool {
  let argv = gunbc_run_transport_argv(
    source_roots: witness_layer_roots,
    entry: "dag/gunbc/host/host_reach_identity_probe.dag",
    function: "probe_fleet_reach_wet"
  )
  let words = gunbc_run_invocation_words(
    source_roots: witness_layer_roots,
    entry: "dag/gunbc/host/host_reach_identity_probe.dag",
    function: "probe_fleet_reach_wet"
  )
  argv == invocation_words_bare(words: words)
    && transport_argv_contains_flag(argv: argv, flag: "--entry")
    && !transport_argv_contains_flag(argv: argv, flag: "--claim-run")
}

// THE RECEIPT-CAT CONTRACT FOR INVOKE STEPS (the #16687 cutover defect, executed -- not declared).
// An invoke step's receipt_rel makes gunbc_invoke_receipt_steps (v2.workflow.gunbc_invoke_step_emit)
// append a `cat "$ROOT/<receipt>"`. The run command itself is NEVER told to write a receipt (it takes no
// write-receipt argument), so the file the cat reads must be one the invoked FUNCTION writes, at exactly
// the path the builder hands over. When it is not, the step dies with "No such file or directory" and, for
// a wet fold, the instance has already been mutated when the step then fails. Three steps share this
// module and this helper and differ ONLY in whether their function writes a receipt at the given path:
//   - gunbc_ci_desired_instance_receipt_identity_invoke runs the OUTPUT-ONLY resolver
//     (live_deploy_ci_instance_receipt_identity_from_ci), which writes ONLY $GITHUB_OUTPUT and no receipt
//     file, so it must carry NO cat;
//   - gunbc_ci_desired_instance_deploy_invoke runs the instance-scoped WET fold, whose only receipt is the
//     per-instance transaction receipt live_deploy_write_apply_receipt writes at the CHOSEN instance's
//     dir -- never a fixed "desired-instance-deploy" label -- so it must carry NO cat (the assert/upload
//     steps reach that receipt through the resolve step);
//   - gunbc_ci_live_deploy_transaction_invoke runs the dashboard WET fold bound to srv1_dashboard_live_id,
//     whose receipt live_deploy_write_apply_receipt DOES write at exactly that label, so its cat must be
//     PRESENT. This third arm is the positive control: it proves the helper really does emit a cat when a
//     step passes a receipt_rel that names a file its function writes, so the two no-cat arms above are
//     measurements and not the artifact of a helper that never cats.
// The two no-cat arms are the RED that was missing: with the original receipt_rel values (both pointed at
// live_deploy_apply_receipt_artifact_path_for(...)) they go red -- exactly the two steps that failed the
// live deploy run before/after the fold.

test fn gunbc_ci_desired_instance_receipt_identity_invoke_has_no_receipt_cat_holds() -> Bool {
  // The invoke family now returns Outcome<String>; fail-closed -- a refused emission cannot vouch for its own content.
  match outcome_accepted_value(gunbc_ci_desired_instance_receipt_identity_invoke()) {
    Absent => false
    Present { value: script } =>
      string_contains(s: script, pattern: "live_deploy_ci_instance_receipt_identity_from_ci")
        && !string_contains(s: script, pattern: "cat ")
        && !string_contains(s: script, pattern: "live_deploy_receipt.json")
  }
}

test fn gunbc_ci_desired_instance_deploy_invoke_has_no_receipt_cat_holds() -> Bool {
  // The invoke family now returns Outcome<String>; fail-closed -- a refused emission cannot vouch for its own content.
  match outcome_accepted_value(gunbc_ci_desired_instance_deploy_invoke()) {
    Absent => false
    Present { value: script } =>
      string_contains(s: script, pattern: "live_deploy_apply_desired_wet_from_ci")
        && !string_contains(s: script, pattern: "cat ")
        && !string_contains(s: script, pattern: "live_deploy_receipt.json")
  }
}

test fn gunbc_ci_live_deploy_transaction_invoke_keeps_its_receipt_cat_holds() -> Bool {
  // The invoke family now returns Outcome<String>; fail-closed -- a refused emission cannot vouch for its own content.
  match outcome_accepted_value(gunbc_ci_live_deploy_transaction_invoke()) {
    Absent => false
    Present { value: script } =>
      string_contains(s: script, pattern: "live_deploy_apply_prod_role_transaction_wet")
        && string_contains(s: script, pattern: "cat ")
        && string_contains(s: script, pattern: "live_deploy_receipt.json")
  }
}
