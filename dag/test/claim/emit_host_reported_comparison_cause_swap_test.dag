module test.claim.emit_host_reported_comparison_cause_swap_test

// A CAUSE-SWAP CONTROL, NOT A DISCRIMINATING RED.
//
// The subject is fine in every case below. The go, ts and node_http smokes were passing, the
// fixtures emit the octets they always emitted, and no ordinary red could have detected anything --
// what was wrong was the EVIDENCE, and evidence defects are invisible to a probe that varies the
// subject. So this control varies the CAUSE and asserts what the predicate can and cannot tell apart.
//
// Before the comparison left the shell script, the only value crossing into .dag was the script's
// exit status, and these two causes produced the same one:
//   a) the toolchain was absent, so the question was never posed;
//   b) the fixture ran and emitted the wrong number of octets.
// (a) says nothing whatever about the subject; (b) refutes it. The first two witnesses restate that
// old predicate EXECUTABLY rather than citing it, so if anyone folds the comparison back into the
// script this file stops being able to make its point and says so.
//
// WHAT THIS FILE DOES NOT CLAIM: the fold at the return type is still a fold, and both causes still
// arrive at the consumer as one false. Separating them there needs the typed carrier and is the
// class-B migration, landing separately. What is established here is that the two causes are now
// SEPARATELY COMPUTABLE, which is the precondition that was missing.

import tools.emit_host_transport {
  emit_host_reported_octets_match,
  emit_host_smoke_holds
}

data expected_octets: String = "8"

data toolchain_absent_stdout: String = ""

data wrong_octet_count_stdout: String = "7"

// THE OLD PREDICATE, RESTATED EXECUTABLY. Both causes collapse to the same answer, which is the
// defect. This witness is green because the collapse is real, not because it is acceptable.
test fn folded_answer_cannot_separate_the_two_causes() -> Bool {
  let absent = emit_host_smoke_holds(
    harness_ok: false,
    reported_stdout: toolchain_absent_stdout,
    expected_text: expected_octets
  )
  let wrong = emit_host_smoke_holds(
    harness_ok: true,
    reported_stdout: wrong_octet_count_stdout,
    expected_text: expected_octets
  )
  absent == wrong
}

// A HARNESS FAILURE IS NEVER RESCUED BY A MATCHING REPORT. The inputs here are contradictory on
// purpose -- the script failed, yet its stdout carries exactly the expected octets -- because that is
// the shape a reordered fold produces. Write `octets_match || harness_ok`, or drop the harness
// conjunct, and this goes red. An earlier revision of this file asserted `false != true` over two
// literals instead; that could not go red under any edit to the production code, which makes it
// decoration rather than a control, and it is replaced rather than kept beside this one.
test fn harness_failure_is_not_rescued_by_a_matching_report() -> Bool {
  !emit_host_smoke_holds(
    harness_ok: false,
    reported_stdout: expected_octets,
    expected_text: expected_octets
  )
}

// The comparison itself is a statement about the subject and nothing else: it is false for a wrong
// count and true for the expected one, with no toolchain state reachable from its inputs.
test fn comparison_answers_only_about_the_octets() -> Bool {
  let wrong = emit_host_reported_octets_match(
    reported_stdout: wrong_octet_count_stdout,
    expected_text: expected_octets
  )
  let right = emit_host_reported_octets_match(
    reported_stdout: expected_octets,
    expected_text: expected_octets
  )
  !wrong && right
}

// An empty report is NOT silently equal to an expected count. This is the arm that would fabricate a
// pass if the expected text were ever empty, and it is pinned so that a future change making
// expected_text derivable-to-empty goes red here rather than greening every smoke.
test fn empty_report_never_matches_a_nonempty_expectation() -> Bool {
  !emit_host_reported_octets_match(
    reported_stdout: toolchain_absent_stdout,
    expected_text: expected_octets
  )
}
