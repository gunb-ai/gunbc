data absent_versus_null_executable_note: String = "THE DISCRIMINATING PAIR for the absent-vs-null split. Cargo documents executable as present-and-null for a target with no runnable binary, so an explicit null is a legitimate result while an absent member means the message does not satisfy the compiler-artifact shape at all. An earlier revision collapsed both into no-executable, which let a drifted or truncated message answer confidently as `this target has no binary` — this module's own thesis failing inside the module, since the point is that the path must be the one cargo NAMED. These two claims are stated together deliberately: either one alone passes under the collapse, and only the pair distinguishes the two upstream facts. Grounded in the recording rather than in argument: all 124 compiler-artifact messages in the 143-message capture carry the executable key (123 explicit null, one string), so absence is not a shape a healthy build produces."

test fn an_artifact_message_with_no_executable_member_refuses() -> Bool {
  match select_from(
    lines: [build_script_line, artifact_line_no_executable_member, build_finished_line],
    target_name: "gunbc"
  ) {
    CargoMessageExecutableAbsent { line_number: n } => n == 2
    CargoArtifactSelected { executable: _ } => false
    CargoArtifactAbsent { target_name: _ } => false
    CargoArtifactAmbiguous { target_name: _, count: _ } => false
    CargoArtifactWithoutExecutable { target_name: _ } => false
    CargoArtifactExecutablePathEmpty { target_name: _, line_number: _ } => false
    CargoArtifactExecutableNotAString { target_name: _, line_number: _ } => false
    CargoMessageLineUnparseable { line_number: _ } => false
    CargoMessageLineNotAnObject { line_number: _ } => false
    CargoMessageReasonAbsent { line_number: _ } => false
    CargoMessageReasonNotAString { line_number: _ } => false
    CargoMessageMemberDuplicated { line_number: _, key: _ } => false
    CargoMessageTargetNotAnObject { line_number: _ } => false
    CargoMessageTargetNameAbsent { line_number: _ } => false
    CargoMessageTargetNameNotAString { line_number: _ } => false
  }
}

