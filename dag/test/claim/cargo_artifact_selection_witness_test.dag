test fn one_trailing_newline_is_framing_and_changes_nothing() -> Bool {
  let body = stream_of(lines: [build_script_line, artifact_line_gunbc, build_finished_line])
  let framed = concat(body, "\n")
  let plain = extdeps.cargo_message.cargo_select_artifact_executable(
    stdout: body,
    target_name: "gunbc"
  )
  let terminated = extdeps.cargo_message.cargo_select_artifact_executable(
    stdout: framed,
    target_name: "gunbc"
  )
  selected_path_or_empty(selection: plain) == "/w/target/debug/gunbc"
    && selected_path_or_empty(selection: terminated) == "/w/target/debug/gunbc"
}

