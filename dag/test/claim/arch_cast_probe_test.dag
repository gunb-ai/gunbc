module test.claim.arch_cast_probe

import std.logic { Bool }
import std.types { String }
import extdeps.toolchain.types { Architecture, Riscv64, architecture_diagnostic_name }

test fn arch_cast_probe() -> Bool {
  let cast = Riscv64 as String
  let named = architecture_diagnostic_name(arch: Riscv64) as String
  print(concat("CAST=[", concat(cast, "]")))
  print(concat("NAMED=[", concat(named, "]")))
  cast == named
}
