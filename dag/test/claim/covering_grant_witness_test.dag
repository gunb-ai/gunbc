module test.claim.covering_grant_witness_test


data covering_grant_witness_note: String = "Discriminating witnesses for covering_grant (the P-C per-grant-binding primitive) and for admit_effect being its reach projection. An envelope carries a Read grant bound RealTransport under repo and a Write grant bound Replay (carrying a fixture_store) under scratch. covering_grant returns the COVERING grant so dispatch can read its binding: the Read target resolves to the RealTransport grant, the Write target to the Replay grant carrying its own fixture_store -- the per-grant selector that supplants the process-global ExecutionMode. An uncovered target is a located NoCoveringGrant (fail-closed). admit_effect is unchanged behaviorally (Admitted via the covering root; EffectOutsideGrant when none covers) -- proving the primitive/projection refactor preserves the reach wall by execution."

data cg_frame: Frame = Frame { name: "covering-grant-witness", kind: SharedStateFrame }

fn cg_envelope() -> Envelope {
  Envelope {
    frame: cg_frame,
    grants: [
      Grant {
        verb: Read,
        root: filesystem_position(path: ["repo"]),
        binding: RealTransport,
        lifecycle: LifecycleByConvention
      },
      Grant {
        verb: Write,
        root: filesystem_position(path: ["scratch"]),
        binding: Replay { fixture_store: "fx" },
        lifecycle: LifecycleByConvention
      },
    ]
  }
}

fn covered_binding_is_real(cg: CoveringGrant) -> Bool {
  match cg {
    CoveredBy { grant: g } =>
      match g.binding {
        RealTransport => true
        Replay { fixture_store: s } => false
      }
    NoCoveringGrant { verb: v, target: t, frame: f } => false
  }
}

fn covered_binding_replay_store(cg: CoveringGrant, store: String) -> Bool {
  match cg {
    CoveredBy { grant: g } =>
      match g.binding {
        Replay { fixture_store: s } => s == store
        RealTransport => false
      }
    NoCoveringGrant { verb: v, target: t, frame: f } => false
  }
}

fn is_no_covering(cg: CoveringGrant) -> Bool {
  match cg {
    NoCoveringGrant { verb: v, target: t, frame: f } => true
    CoveredBy { grant: g } => false
  }
}

test fn covering_grant_read_selects_real_transport() -> Bool {
  covered_binding_is_real(
    cg: covering_grant(
      env: cg_envelope(),
      verb: Read,
      target: filesystem_position(path: ["repo", "x"])
    )
  )
}

test fn covering_grant_write_selects_replay_with_store() -> Bool {
  covered_binding_replay_store(
    cg: covering_grant(
      env: cg_envelope(),
      verb: Write,
      target: filesystem_position(path: ["scratch", "y"])
    ),
    store: "fx"
  )
}

test fn covering_grant_uncovered_is_no_covering() -> Bool {
  is_no_covering(
    cg: covering_grant(
      env: cg_envelope(),
      verb: Read,
      target: filesystem_position(path: ["elsewhere"])
    )
  )
}

test fn admit_effect_projection_admits_covered() -> Bool {
  match admit_effect(
    env: cg_envelope(),
    verb: Read,
    target: filesystem_position(path: ["repo", "x"])
  ) {
    Admitted { via_root: r } => r.path == ["repo"]
    EffectOutsideGrant { verb: v, target: t, frame: f } => false
  }
}

test fn admit_effect_projection_refuses_uncovered() -> Bool {
  match admit_effect(
    env: cg_envelope(),
    verb: Read,
    target: filesystem_position(path: ["elsewhere"])
  ) {
    EffectOutsideGrant { verb: v, target: t, frame: f } => true
    Admitted { via_root: r } => false
  }
}
