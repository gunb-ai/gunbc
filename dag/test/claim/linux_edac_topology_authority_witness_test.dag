module test.claim.linux_edac_topology_authority_witness

import extdeps.linux.edac {
  EdacDriverBinding,
  NativeMemoryControllerEdac,
  GhesEdac,
  NoEdacDriverBound,
  MemoryControllerEnumerated,
  ErrorAttributionOnly,
  NoEdacAuthority,
  ChannelTopologyEnumerated,
  ChannelTopologyAbsent,
  FirmwareFirstErrorAttributionShim,
  NoMemoryControllerDriverBound,
  AbsentOnEveryBoot,
  AbsentUntilDriverBound,
  MemoryControllerEnumeration,
  SmbiosType17MemoryDeviceTable,
  edac_driver_topology_authority,
  edac_channel_topology_availability,
  edac_channel_topology_absence_standing,
  edac_dimm_node_source,
  apei_firmware_first_from_dmesg,
  ControllerCountFixedByDriver,
  ControllerCountIsAPlatformReading,
  ControllerCountNotApplicable,
  edac_registered_controller_count,
}
import extdeps.linux.kernel { LinuxKernelModuleName }
import std.measure { memory_controller_count_value }
import std.types { Bool }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.optional { Absent, Present }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// The three bindings are the closed universe of the trichotomy, so every law below is asked of all
// three rather than of the interesting one.
data skx_binding: EdacDriverBinding = NativeMemoryControllerEdac {
  kernel_module: "skx_edac" as LinuxKernelModuleName,
}

// The dmesg line as the host actually printed it, from artifacts/bmc/mtcollins1-host-capture.txt
// (Linux 6.8.0-71-generic aarch64, Ampere Altra, stock Ubuntu 24.04.3). It is a fixture here, not a
// receipt: the receipt lives in the observing layer, and this file only needs a real line to prove
// the detector reads the kernel's spelling rather than a paraphrase of it.
data dmesg_firmware_first_fixture: String = "[    0.352441] GHES: APEI firmware first mode is enabled by APEI bit.\n[    0.352443] EDAC MC0: Giving out device to module ghes_edac.c\n"

// The discriminating negative: a dmesg that mentions GHES and EDAC and firmware, and still is not
// the marker. A detector matching on "firmware" or "GHES" alone would green here and is what this
// fixture exists to red.
data dmesg_without_marker_fixture: String = "[    0.211003] GHES: Failed to enable APEI firmware first mode.\n[    0.352443] EDAC MC0: Giving out device to module ghes_edac.c\n"

test fn ghes_edac_is_not_a_topology_authority_holds() -> Bool {
  match edac_driver_topology_authority(binding: GhesEdac) {
    ErrorAttributionOnly => true
    MemoryControllerEnumerated => false
    NoEdacAuthority => false
  }
}

test fn native_driver_is_a_topology_authority_holds() -> Bool {
  match edac_driver_topology_authority(binding: skx_binding) {
    MemoryControllerEnumerated => true
    ErrorAttributionOnly => false
    NoEdacAuthority => false
  }
}

test fn unbound_edac_is_no_authority_holds() -> Bool {
  match edac_driver_topology_authority(binding: NoEdacDriverBound) {
    NoEdacAuthority => true
    MemoryControllerEnumerated => false
    ErrorAttributionOnly => false
  }
}

test fn ghes_edac_exposes_no_channel_topology_holds() -> Bool {
  match edac_channel_topology_availability(binding: GhesEdac) {
    ChannelTopologyAbsent { cause: FirmwareFirstErrorAttributionShim } => true
    ChannelTopologyAbsent { cause: NoMemoryControllerDriverBound } => false
    ChannelTopologyEnumerated { kernel_module: _ } => false
  }
}

test fn native_driver_exposes_channel_topology_holds() -> Bool {
  match edac_channel_topology_availability(binding: skx_binding) {
    ChannelTopologyEnumerated { kernel_module: m } => m as String == "skx_edac"
    ChannelTopologyAbsent { cause: _ } => false
  }
}

// THE LOAD-BEARING DISTINCTION. Both absences are absences; only one of them ends the errand. If
// this fold ever collapsed the two causes onto one standing, this law reds — which is the whole
// reason the causes are separate variants rather than one "unavailable".
test fn the_two_absences_have_different_standings_holds() -> Bool {
  (match edac_channel_topology_absence_standing(cause: FirmwareFirstErrorAttributionShim) {
    AbsentOnEveryBoot => true
    AbsentUntilDriverBound => false
  })
    && (match edac_channel_topology_absence_standing(cause: NoMemoryControllerDriverBound) {
      AbsentUntilDriverBound => true
      AbsentOnEveryBoot => false
    })
}

test fn ghes_edac_dimm_nodes_come_from_smbios_holds() -> Bool {
  match edac_dimm_node_source(binding: GhesEdac) {
    Present { value: SmbiosType17MemoryDeviceTable } => true
    Present { value: MemoryControllerEnumeration } => false
    Absent => false
  }
}

test fn native_driver_dimm_nodes_come_from_the_controller_holds() -> Bool {
  match edac_dimm_node_source(binding: skx_binding) {
    Present { value: MemoryControllerEnumeration } => true
    Present { value: SmbiosType17MemoryDeviceTable } => false
    Absent => false
  }
}

test fn unbound_edac_has_no_dimm_node_source_holds() -> Bool {
  match edac_dimm_node_source(binding: NoEdacDriverBound) {
    Absent => true
    Present { value: _ } => false
  }
}

// The one is the SHIM's, so the law is that it does not depend on the platform -- and the
// discriminating half is the other arm: a native driver's count must NOT come back as a
// driver-fixed number, because this module does not know it and inventing one would be the
// fabricated-plausible-output failure with a Nat on it.
test fn ghes_edac_registers_exactly_one_controller_holds() -> Bool {
  match edac_registered_controller_count(binding: GhesEdac) {
    ControllerCountFixedByDriver { count: n } => memory_controller_count_value(c: n) == 1
    ControllerCountIsAPlatformReading => false
    ControllerCountNotApplicable => false
  }
}

test fn native_driver_controller_count_is_not_fixed_by_the_driver_holds() -> Bool {
  match edac_registered_controller_count(binding: skx_binding) {
    ControllerCountIsAPlatformReading => true
    ControllerCountFixedByDriver { count: _ } => false
    ControllerCountNotApplicable => false
  }
}

test fn unbound_edac_has_no_controller_count_holds() -> Bool {
  match edac_registered_controller_count(binding: NoEdacDriverBound) {
    ControllerCountNotApplicable => true
    ControllerCountFixedByDriver { count: _ } => false
    ControllerCountIsAPlatformReading => false
  }
}

test fn firmware_first_detector_reads_the_real_dmesg_line_holds() -> Bool {
  apei_firmware_first_from_dmesg(dmesg: dmesg_firmware_first_fixture)
}

test fn firmware_first_detector_red_control_holds() -> Bool {
  !apei_firmware_first_from_dmesg(dmesg: dmesg_without_marker_fixture)
}
