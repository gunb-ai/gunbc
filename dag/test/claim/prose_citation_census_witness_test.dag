module test.claim.prose_citation_census_witness

import std.types { Bool, Int, String, List, Map }
import gunbc.prose_row_frontier { ProseRowRef }
import tools.prose_citation_census {
  ProseCitationSite, ProseCitationCarrier, InAnnotationBlock, InProseRowLiteral,
  prose_citation_names_in_line,
  prose_citation_line_carrier,
  prose_citation_sites_in_source,
  prose_citation_retired_rows,
  prose_citation_retired_index,
  prose_citation_census_of,
  prose_citation_baseline_row,
  prose_citation_baseline_rows,
  prose_citation_site_key,
  ProseRowOrigin, RetiredFromOnePath, RetiredFromSeveralPaths,
  ProseCitationLocality, InRetiringFile, InAnotherFile, RetiringFileAmbiguous,
  prose_citation_locality_of,
  ProseCitationResolution, CitedNameAbsentEverywhere, CitedNameSurvivesElsewhere,
  prose_citation_module_index,
  prose_citation_qualified,
}

// THE DISCRIMINATING CONTROLS for the prose-citation census, run against the REAL recogniser on
// specimens rather than against a re-derived copy of its rule. Nothing here reads git or the corpus:
// the recogniser is pure over (path, text, retired index) precisely so these can exercise the decision
// itself, and the live-corpus half is a separate, separately budgeted subject.
//
// THE PAIRS ARE THE POINT. "the scan finds a citation" alone is satisfied by a rule that reports every
// line, and "the scan rejects a non-citation" alone by a rule that reports nothing; only the two
// together pin the boundary rule. Every positive below therefore has a negative that differs in one
// property, and the counter pair at the end shows the scan is non-constant in its retired index.

fn retired_index_of(names: List<String>, home: String) -> Map<String, ProseRowOrigin> {
  prose_citation_retired_index(rows: names |> map(n => ProseRowRef { path: home, decl_name: n }))
}

data specimen_home: String = "dag/gunbc/retiring_module.dag"

data specimen_other: String = "dag/gunbc/citing_module.dag"

// THE TWELVE SAMPLED SPECIMENS, CARRIED AS THE CENSUS'S OWN ACCURACY CONTROL.
//
// A twelve-site random sample of cross-file hits was read by hand and every one was a genuine section
// 3 citation -- a paragraph naming a symbol so a reader can go and read it -- with no false positive.
// That result was a fact someone remembered, which is exactly the shape DESIGN section 6 refuses: a
// measurement is cited by naming the producer that re-derives it. The sampled LINES are therefore
// carried here verbatim, so the precision claim is re-executed on every run rather than recalled. If
// the recogniser regresses, these go red; if a specimen's own citation is repaired upstream, this
// fixture keeps the sample intact rather than losing it to the repair.
type SampledCitation {
  line: String
  cited_name: String
}

data sampled_citations: List<SampledCitation> = [
  SampledCitation { line: "// the companyfacts/companyconcept APIs (same API-boundary case as chemed_segment_gap_note). No", cited_name: "chemed_segment_gap_note" },
  SampledCitation { line: "// interpreter_dispatch_bijection_real_roster_memory_envelope_note.", cited_name: "interpreter_dispatch_bijection_real_roster_memory_envelope_note" },
  SampledCitation { line: "// class_b_import_closure_transport's class_b_transport_note and the witness's class_b_witness_note", cited_name: "class_b_transport_note" },
  SampledCitation { line: "// lean_overflow_parse_continuation_note.", cited_name: "lean_overflow_parse_continuation_note" },
  SampledCitation { line: "// vacuity_bool_witness_fn_decl_collection_ceiling_note) prevents a real `test fn` or a", cited_name: "vacuity_bool_witness_fn_decl_collection_ceiling_note" },
  SampledCitation { line: "// closing_contract_authoring_predicate_note owns it. Two of the four clauses are answered as asked", cited_name: "closing_contract_authoring_predicate_note" },
  SampledCitation { line: "// rust_test_fixtures_rust_import_unstrip_note). Dissolve-on: bare-reference closure binding is", cited_name: "rust_test_fixtures_rust_import_unstrip_note" },
  SampledCitation { line: "// gunbc.roadmap_instrument_sandbox exemplar_note). Modeled as a TsProgram via", cited_name: "exemplar_note" },
  SampledCitation { line: "// shared with witness_long_eval_budget_entries_note: per-witness declared cost envelopes replace", cited_name: "witness_long_eval_budget_entries_note" },
  SampledCitation { line: "data measure_clock_basis_note: String = \"WHICH CLOCK a duration was read from, per byte_basis_note\"", cited_name: "byte_basis_note" },
  SampledCitation { line: "data witness_note: String = \"why_this_is_not_derived_from_the_build_cache_roster_note has the rest\"", cited_name: "why_this_is_not_derived_from_the_build_cache_roster_note" },
  SampledCitation { line: "data vacuity_gap_note: String = \"Correction (review 46947): see vacuity_bool_witness_fn_decl_collection_ceiling_note\"", cited_name: "vacuity_bool_witness_fn_decl_collection_ceiling_note" }
]

fn names_contains(names: List<String>, wanted: String) -> Bool {
  fold(names, init: false, f: (found, n) => found || n == wanted)
}

fn every_sampled_specimen_is_recognised() -> Bool {
  fold(
    sampled_citations,
    init: true,
    f: (ok, c) => ok && names_contains(names: prose_citation_names_in_line(line: c.line), wanted: c.cited_name)
  )
}

test fn the_twelve_sampled_specimens_are_all_recognised() -> Bool {
  every_sampled_specimen_is_recognised()
}

// The sample is only evidence if it is the size that was drawn. A fixture silently shrinking to one
// row would keep this file green while deleting eleven twelfths of the control.
test fn the_sample_is_the_twelve_sites_that_were_drawn() -> Bool {
  (sampled_citations |> count) == 12
}

// A line naming TWO retired rows is two citations, not one. The third specimen carries both, and a
// recogniser that stopped at the first occurrence would satisfy every other row above.
data two_name_specimen: String = "// class_b_import_closure_transport's class_b_transport_note and the witness's class_b_witness_note"

test fn a_line_naming_two_rows_yields_both() -> Bool {
  let names = prose_citation_names_in_line(line: two_name_specimen)
  names_contains(names: names, wanted: "class_b_transport_note")
    && names_contains(names: names, wanted: "class_b_witness_note")
}

// THE BOUNDARY PAIR. Both sides are needed: the first alone is satisfied by a recogniser that never
// matches, the second by one that matches any substring.
test fn a_longer_identifier_ending_in_the_suffix_is_not_read_as_its_tail() -> Bool {
  let names = prose_citation_names_in_line(line: "// see bar_foo_note for the rest")
  names_contains(names: names, wanted: "bar_foo_note") && !names_contains(names: names, wanted: "foo_note")
}

test fn a_word_that_merely_starts_with_the_suffix_is_not_a_name() -> Bool {
  (prose_citation_names_in_line(line: "// written up in the shared_notebook, not here") |> count) == 0
}

// CARRIER CLASSIFICATION, AND THE ARM THAT MUST STAY EMPTY. A retired name in a semantic position is a
// program fact the compiler already refuses; reporting it here would be this census answering someone
// else's question.
test fn an_annotation_line_and_a_prose_row_line_are_different_carriers() -> Bool {
  match prose_citation_line_carrier(line: "// cites probe_note") {
    Absent => false
    Present { value: c } =>
      match c {
        InAnnotationBlock =>
          match prose_citation_line_carrier(line: "data other_note: String = \"cites probe_note\"") {
            Absent => false
            Present { value: d } => match d { InAnnotationBlock => false, InProseRowLiteral => true }
          }
        InProseRowLiteral => false
      }
  }
}

test fn a_semantic_line_naming_a_retired_row_is_not_a_citation_site() -> Bool {
  match prose_citation_line_carrier(line: "import gunbc.retiring_module { probe_note }") {
    Absent => true
    Present { value: _ } => false
  }
}

data annotation_specimen: String = "module gunbc.citing_module\n\n// The rationale, which cites probe_note for the argument it does not repeat.\ndata kept: Int = 1\n"

data prose_row_specimen: String = "module gunbc.citing_module\n\ndata kept_note: String = \"restates probe_note without repeating it\"\n"

fn sites_of(path: String, text: String, retired: List<String>, home: String) -> List<ProseCitationSite> {
  prose_citation_sites_in_source(rel_path: path, text: text, retired: retired_index_of(names: retired, home: home), live_bare: empty_map())
}

test fn a_cross_file_annotation_citation_is_one_site_at_its_line() -> Bool {
  let sites = sites_of(path: specimen_other, text: annotation_specimen, retired: ["probe_note"], home: specimen_home)
  (sites |> count) == 1
    && fold(sites, init: true, f: (ok, s) => ok && s.cited_name == "probe_note" && s.line == 3
        && match s.locality { InAnotherFile => true, InRetiringFile => false, RetiringFileAmbiguous => false }
        && match s.carrier { InAnnotationBlock => true, InProseRowLiteral => false })
}

test fn a_prose_row_citation_is_a_prose_row_site() -> Bool {
  let sites = sites_of(path: specimen_other, text: prose_row_specimen, retired: ["probe_note"], home: specimen_home)
  (sites |> count) == 1 && fold(sites, init: true, f: (ok, s) => ok && match s.carrier { InAnnotationBlock => false, InProseRowLiteral => true })
}

// SAME-FILE IS THE OTHER ARM OF cross_file, and it is the arm a disposition turns on: a citation in
// the file the row was retired from can be read against the annotation that replaced it.
test fn a_citation_in_the_retiring_file_is_not_cross_file() -> Bool {
  let sites = sites_of(path: specimen_home, text: annotation_specimen, retired: ["probe_note"], home: specimen_home)
  (sites |> count) == 1 && fold(sites, init: true, f: (ok, s) => ok && match s.locality { InRetiringFile => true, InAnotherFile => false, RetiringFileAmbiguous => false })
}

// THE FALSE-POSITIVE CONTROL. Prose naming a row that is STILL DECLARED is a healthy citation and must
// not be reported. Without this the census would report every prose citation in the corpus and its
// count would be meaningless.
test fn prose_naming_a_row_outside_the_retired_index_is_not_a_site() -> Bool {
  (sites_of(path: specimen_other, text: annotation_specimen, retired: ["other_note"], home: specimen_home) |> count) == 0
}

// THE COUNTER PAIR, SHOWN NON-CONSTANT IN BOTH DIRECTIONS. The same text scanned with an empty retired
// index yields zero and with the real one yields one, so neither reading is a constant the recogniser
// would have produced whatever it was handed.
test fn the_scan_is_non_constant_in_its_retired_index() -> Bool {
  (sites_of(path: specimen_other, text: annotation_specimen, retired: [], home: specimen_home) |> count) == 0
    && (sites_of(path: specimen_other, text: annotation_specimen, retired: ["probe_note"], home: specimen_home) |> count) == 1
}

// LIVENESS IS THE OTHER HALF OF THE JOIN and it has the same shape of failure: a retired filter that
// let everything through would make every removal look retired.
fn live_index(names: List<String>) -> Map<String, Bool> {
  fold(names, init: empty_map(), f: (acc, n) => map_insert(acc, n, true))
}

// RETIREMENT IS DECIDED BY QUALIFIED IDENTITY, and this pair is what makes that claim falsifiable
// rather than declared. Both rows carry the SAME bare name. One is still declared in its OWN module
// and is not retired; the other's module no longer declares it while ANOTHER module does, and it IS
// retired. A bare-name key returns the same answer for both and would report neither -- which is the
// false negative review 58234 named, and it is the more severe class because such a citation still
// resolves, to the wrong declaration.
data live_module_a: String = "gunbc.module_a"

data live_module_b: String = "gunbc.module_b"

fn qualified_live_index(qualified: List<String>) -> Map<String, Bool> {
  fold(qualified, init: empty_map(), f: (acc, q) => map_insert(acc, q, true))
}

data two_module_baseline: List<ProseRowRef> = [
  ProseRowRef { path: "dag/gunbc/module_a.dag", decl_name: "kept_note" },
  ProseRowRef { path: "dag/gunbc/module_b.dag", decl_name: "moved_note" }
]

data two_module_index: Map<String, String> = map_insert(map_insert(empty_map(), "dag/gunbc/module_a.dag", live_module_a), "dag/gunbc/module_b.dag", live_module_b)

test fn a_row_still_declared_in_its_own_module_is_not_retired() -> Bool {
  let live = qualified_live_index(qualified: [
    prose_citation_qualified(module_path: live_module_a, decl_name: "kept_note"),
    prose_citation_qualified(module_path: live_module_b, decl_name: "moved_note")
  ])
  (prose_citation_retired_rows(baseline_rows: two_module_baseline, modules: two_module_index, live_qualified: live) |> count) == 0
}

test fn a_row_whose_bare_name_survives_only_in_another_module_is_retired() -> Bool {
  let live = qualified_live_index(qualified: [
    prose_citation_qualified(module_path: live_module_a, decl_name: "kept_note"),
    prose_citation_qualified(module_path: live_module_a, decl_name: "moved_note")
  ])
  let retired = prose_citation_retired_rows(baseline_rows: two_module_baseline, modules: two_module_index, live_qualified: live)
  (retired |> count) == 1
    && fold(retired, init: true, f: (ok, r) => ok && r.decl_name == "moved_note")
}

// A baseline path with no module line establishes no identity, so it is not judged either way. Without
// this arm the fold would have to invent a module or default to retired, and defaulting to retired
// would enrol every unparsed file's rows into the population.
test fn a_baseline_row_whose_module_is_unknown_is_not_judged() -> Bool {
  (prose_citation_retired_rows(baseline_rows: two_module_baseline, modules: empty_map(), live_qualified: empty_map()) |> count) == 0
}

// THE CENSUS IS AN IDENTITY JOIN, NOT A COUNT EQUALITY. lists_agree compares membership in both
// directions, so no ordering is imposed on either side and neither list has to be sorted first. The keys produced must equal the keys expected
// in BOTH directions; a producer that emitted one right key and one wrong one passes any count check.
data expected_site_keys: List<String> = [
  "dag/gunbc/citing_module.dag probe_note retired-from dag/gunbc/retiring_module.dag :3"
]

fn keys_of(sites: List<ProseCitationSite>) -> List<String> {
  sites |> map(s => prose_citation_site_key(s: s))
}

fn lists_agree(a: List<String>, b: List<String>) -> Bool {
  (a |> count) == (b |> count)
    && fold(a, init: true, f: (ok, x) => ok && names_contains(names: b, wanted: x))
    && fold(b, init: true, f: (ok, x) => ok && names_contains(names: a, wanted: x))
}

test fn the_produced_site_identities_join_with_the_expected_ones_both_ways() -> Bool {
  lists_agree(a: keys_of(sites: sites_of(path: specimen_other, text: annotation_specimen, retired: ["probe_note"], home: specimen_home)), b: expected_site_keys)
}

// The rolled-up counts must be projections of the SAME site list, not a second count of it. A census
// whose totals disagreed with its own rows would be two authorities for one population.
test fn the_census_totals_are_projections_of_its_own_site_list() -> Bool {
  let sites = sites_of(path: specimen_other, text: annotation_specimen, retired: ["probe_note"], home: specimen_home)
  let census = prose_citation_census_of(baseline: "probe", sites: sites, retired_row_count: 1)
  census.site_count == (sites |> count)
    && census.annotation_site_count == 1
    && census.prose_row_site_count == 0
    && census.another_file_site_count == 1
    && census.ambiguous_origin_site_count == 0
    && census.absent_everywhere_site_count == 1
    && census.survives_elsewhere_site_count == 0
    && census.cited_name_count == 1
}


// THE BASELINE READ IS PARSED BY gunbc.prose_row_frontier AND NOT BY A SECOND RECOGNISER, so these
// controls run the real membership rule on the real match shape git emits: `<ref>:<path>:data NAME:
// String = "`. The pair matters as much as it does above -- accepting a prose row alone is satisfied by
// a parser that accepts everything, which would enrol every `data NAME: String` row in the corpus.
data baseline_ref_specimen: String = "2afe322f774dbc908afc6106bf3fa55372fccf89"

fn baseline_row_of(line: String) -> List<ProseRowRef> {
  prose_citation_baseline_rows(matches: line, ref_len: string_length(s: baseline_ref_specimen))
}

test fn a_baseline_match_line_yields_its_path_and_name() -> Bool {
  let rows = baseline_row_of(line: concat(baseline_ref_specimen, ":dag/gunbc/retiring_module.dag:data probe_note: String = \""))
  (rows |> count) == 1
    && fold(rows, init: true, f: (ok, r) => ok && r.decl_name == "probe_note" && r.path == "dag/gunbc/retiring_module.dag")
}

// A `data NAME: String` row that is NOT a prose row is program data, and enrolling it would put every
// string-valued declaration in the corpus into the retired universe.
test fn a_baseline_match_that_is_not_a_prose_row_yields_nothing() -> Bool {
  (baseline_row_of(line: concat(baseline_ref_specimen, ":dag/gunbc/retiring_module.dag:data probe_label: String = \"")) |> count) == 0
}

test fn a_baseline_line_with_no_path_separator_yields_nothing() -> Bool {
  (baseline_row_of(line: baseline_ref_specimen) |> count) == 0
}

// THE COLLISION ARM, which had no control at all until review 58228 named it. Two baseline rows sharing
// a name is not hypothetical -- 38 prose-row names in the pre-sweep baseline are declared in more than
// one file across 119 rows -- and the retired SUBSET happening to carry 4002 distinct names over 4002
// rows is a property of today's tree, not of the construction. The pair below is what makes the
// ambiguity real rather than declared: one origin resolves to a locality, several refuse to.
test fn a_name_retired_from_one_path_resolves_its_locality() -> Bool {
  let here = prose_citation_locality_of(origin: RetiredFromOnePath { path: specimen_home }, rel_path: specimen_home)
  let elsewhere = prose_citation_locality_of(origin: RetiredFromOnePath { path: specimen_home }, rel_path: specimen_other)
  match here { InRetiringFile => true, InAnotherFile => false, RetiringFileAmbiguous => false }
    && match elsewhere { InAnotherFile => true, InRetiringFile => false, RetiringFileAmbiguous => false }
}

// A Bool cross_file would have had to answer this case true or false. It refuses instead, and the
// refusal is counted in the census rather than folded into either of the other two arms.
test fn a_name_retired_from_several_paths_refuses_to_pick_a_locality() -> Bool {
  let rows = [
    ProseRowRef { path: specimen_home, decl_name: "probe_note" },
    ProseRowRef { path: specimen_other, decl_name: "probe_note" }
  ]
  let sites = prose_citation_sites_in_source(rel_path: specimen_other, text: annotation_specimen, retired: prose_citation_retired_index(rows: rows), live_bare: empty_map())
  (sites |> count) == 1
    && fold(sites, init: true, f: (ok, s) => ok && match s.locality { RetiringFileAmbiguous => true, InRetiringFile => false, InAnotherFile => false })
}

// The merge is idempotent on a repeated path: the SAME row seen twice is one origin, not an ambiguity.
// Without this, any duplicate in the baseline read would degrade every site to ambiguous.
test fn the_same_path_seen_twice_is_still_one_origin() -> Bool {
  let rows = [
    ProseRowRef { path: specimen_home, decl_name: "probe_note" },
    ProseRowRef { path: specimen_home, decl_name: "probe_note" }
  ]
  let sites = prose_citation_sites_in_source(rel_path: specimen_home, text: annotation_specimen, retired: prose_citation_retired_index(rows: rows), live_bare: empty_map())
  (sites |> count) == 1
    && fold(sites, init: true, f: (ok, s) => ok && match s.locality { InRetiringFile => true, InAnotherFile => false, RetiringFileAmbiguous => false })
}

// THE RESOLUTION SPLIT, which review 58234 is the reason this file has at all. The pair is the whole
// content: the SAME site, the SAME retired row, differing only in whether the cited spelling is
// declared anywhere today, must land in different arms. A census keyed on bare-name liveness could not
// produce the second row at all -- the site would simply not be reported.
test fn a_cited_name_declared_nowhere_and_one_surviving_elsewhere_are_different_states() -> Bool {
  let retired = retired_index_of(names: ["probe_note"], home: specimen_home)
  let dead = prose_citation_sites_in_source(rel_path: specimen_other, text: annotation_specimen, retired: retired, live_bare: empty_map())
  let survives = prose_citation_sites_in_source(rel_path: specimen_other, text: annotation_specimen, retired: retired, live_bare: map_insert(empty_map(), "probe_note", true))
  (dead |> count) == 1 && (survives |> count) == 1
    && fold(dead, init: true, f: (ok, s) => ok && match s.resolution { CitedNameAbsentEverywhere => true, CitedNameSurvivesElsewhere => false })
    && fold(survives, init: true, f: (ok, s) => ok && match s.resolution { CitedNameSurvivesElsewhere => true, CitedNameAbsentEverywhere => false })
}

// The qualified key is the join both halves use, so a control on its spelling is a control on the
// join. `module.name` and nothing else -- a separator drift here would silently retire everything.
test fn the_qualified_identity_is_the_module_dot_name_spelling() -> Bool {
  prose_citation_qualified(module_path: "gunbc.retiring_module", decl_name: "probe_note") == "gunbc.retiring_module.probe_note"
}

// The baseline module read has the same shape as the declaration read and the same failure mode: a
// line that is not a module line must contribute nothing rather than a wrong path-to-module entry.
test fn the_module_index_reads_module_lines_and_ignores_others() -> Bool {
  let ref = baseline_ref_specimen
  let n = string_length(s: ref)
  let idx = prose_citation_module_index(
    matches: concat(concat(ref, ":dag/gunbc/retiring_module.dag:module gunbc.retiring_module\n"), concat(ref, ":dag/gunbc/other.dag:data not_a_module_note: String = \"")),
    ref_len: n
  )
  match lookup(idx, "dag/gunbc/retiring_module.dag") {
    Absent => false
    Present { value: m } => m == "gunbc.retiring_module" && !map_contains_key(idx, "dag/gunbc/other.dag")
  }
}
