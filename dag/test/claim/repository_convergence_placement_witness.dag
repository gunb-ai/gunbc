// EVERY WITNESS HERE IS PURE-OR-SUBSTRATE, AND SAYING SO IS WHAT MAKES THEM RUN. The floor's default
// disposition is fail-closed -- a file that declares none is treated as ReadsLiveTree and DECLINED,
// discovered and counted and never executed. That is the inert-family shape DESIGN indicts, where a
// reader counts witnesses named for a subject and concludes it is covered. Nothing below reaches git
// or a subprocess, and the ONLY filesystem access is the checkout-input carve-out: the absent-receipt
// row reads a path under the checkout root, where absence is read OFF THE COMMIT -- input access, not
// host state -- which is exactly what SubstrateInputsOnly declares. The principal observation is
// driven through its DECODER over an authored read outcome rather than through the read.
data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE CANDIDATE USED THROUGHOUT IS A FIXTURE OBJECT ID, forty lowercase hex characters, so the shape
// admission it must pass is the production one rather than a relaxed test spelling.
data fixture_candidate: String = "0123456789abcdef0123456789abcdef01234567"

// THE PRIOR RUN'S CANDIDATE: a second forty-hex object id, so the stale RED above differs from the
// positive control by the ONE fact that matters -- which run the receipt names -- and not by shape.
data fixture_stale_candidate: String = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

// THE SAME SIXTY-FOUR CHARACTERS IN A NON-CANONICAL SPELLING. Git's cited decoder admits only the
// lowercase hex spelling of an object id (one commit, one name), so this is the fixture the binding
// must REFUSE on each side it touches -- used by the case-drift row below.
data fixture_candidate_upper_tail: String = "0123456789ABCDEF0123456789abcdef01234567"

// THE SUBJECT THE READBACK ANSWERS FOR, on the route the deploy actually takes: the per-instance
// receipts directory. Tests that exercise the text route pass this as the read's path so the
// refusal reports a REAL location rather than an invented placeholder (review 86287), and the
// entry-level rows hand it to the wet entry as its `receipt` argument.
data fixture_receipt_path: String = "/opt/gunbc/receipts/repository-convergence.json"

data fixture_object_source: String = "/home/ghrunner/work/gunbc/gunbc"

fn srv1_service_user() -> String {
  deployment_spec_srv1().service.service_user as String
}

fn srv1_repo_root() -> String {
  deployment_spec_srv1().service.repo_root as String
}

fn principal_read_outcome(name: String) -> EffectivePosixPrincipalReadOutcome {
  EffectivePosixPrincipalReadOutcome {
    read: EffectivePosixPrincipalRead {},
    exit_code: 0,
    success: true,
    stdout: name,
    stderr: "",
  }
}

fn admission_for(observed_name: String) -> ConvergencePrincipalAdmission {
  convergence_principal_admission(
    expected: srv1_service_user(),
    result: effective_posix_principal_observation(
      outcome: principal_read_outcome(name: observed_name),
    ),
  )
}

fn is_principal_admitted(a: ConvergencePrincipalAdmission) -> Bool {
  match a {
    ConvergencePrincipalAdmitted { name: _ } => true
    ConvergencePrincipalMismatch { expected: _, observed: _ } => false
    ConvergencePrincipalUnobservable { reason: _ } => false
  }
}

// THE POSITIVE CONTROL AND THE DISCRIMINATING RED OF THE WALL THIS MODULE EXISTS FOR. The service
// user is admitted; the CI runner -- the account the deploy actually runs as, which is the mistake
// being prevented -- is refused, and the refusal NAMES BOTH SIDES rather than answering a bare
// false. Asserting only the refusal would pass against a wall that refuses everything.
test fn the_service_principal_is_admitted_and_the_ci_runner_is_refused() -> Bool {
  is_principal_admitted(a: admission_for(observed_name: srv1_service_user()))
    && !is_principal_admitted(a: admission_for(observed_name: "ghrunner"))
    && match admission_for(observed_name: "ghrunner") {
      ConvergencePrincipalMismatch { expected: e, observed: o } =>
        e == srv1_service_user() && o == "ghrunner"
      ConvergencePrincipalAdmitted { name: _ } => false
      ConvergencePrincipalUnobservable { reason: _ } => false
    }
}

// A READ THAT DID NOT ANSWER IS NOT AN ADMITTING ANSWER, and it is a THIRD state rather than a
// spelling of mismatch: the remedy for "whoami failed" is not the remedy for "the wrong account is
// running this". A trailing newline on a successful read must NOT be one of these -- the decoder
// trims -- so the same witness pins that the ordinary shell output shape still admits.
test fn an_unobservable_principal_refuses_as_its_own_state() -> Bool {
  let failed = EffectivePosixPrincipalReadOutcome {
    read: EffectivePosixPrincipalRead {},
    exit_code: 1,
    success: false,
    stdout: "",
    stderr: "whoami: cannot find name for user ID 1001",
  }
  let unobservable = convergence_principal_admission(
    expected: srv1_service_user(),
    result: effective_posix_principal_observation(outcome: failed),
  )
  match unobservable {
    ConvergencePrincipalUnobservable { reason: r } => r != ""
    ConvergencePrincipalAdmitted { name: _ } => false
    ConvergencePrincipalMismatch { expected: _, observed: _ } => false
  }
    && is_principal_admitted(a: admission_for(observed_name: concat(srv1_service_user(), "\n")))
}

fn complete_serve(object_source: String) -> ObjectSourceServeAdmission {
  ObjectSourceCanServe { source: object_source }
}

fn admitted_operands(candidate: String, object_source: String) -> ConvergencePlacementOperands? {
  match convergence_operands_for(
    spec: deployment_spec_srv1(),
    candidate: candidate,
    object_source: object_source,
    object_source_serve: complete_serve(object_source: object_source),
  ) {
    ConvergenceOperandsAdmitted { operands: o } => Present { value: o }
    ConvergenceOperandsRefused { reason: _ } => none
  }
}

fn operands_refused(candidate: String, object_source: String) -> Bool {
  match convergence_operands_for(
    spec: deployment_spec_srv1(),
    candidate: candidate,
    object_source: object_source,
    object_source_serve: complete_serve(object_source: object_source),
  ) {
    ConvergenceOperandsAdmitted { operands: _ } => false
    ConvergenceOperandsRefused { reason: r } => r != ""
  }
}

// THE OPERANDS COME FROM THE SPEC, WHICH IS THE POINT: the repo is the deployed tree's own root
// read from one field, and the base ref is the module's declared authority rather than a caller
// string. The object source is the only path that comes from outside, and it is the runner
// checkout -- never the target. The primary worktree path is no longer among them: #9555 moved
// that derivation into repository_converge_wet, which reads it from git's own roster.
test fn the_operands_derive_from_the_deployment_spec() -> Bool {
  match admitted_operands(candidate: fixture_candidate, object_source: fixture_object_source) {
    Absent => false
    Present { value: o } =>
      o.repo == srv1_repo_root()
        && o.base_ref == convergence_base_ref
        && o.candidate == fixture_candidate
        && o.remote == fixture_object_source
        && o.remote != srv1_repo_root()
  }
}

// AN ABBREVIATED CANDIDATE IS THE DANGEROUS ONE AND IT IS THE ONE A LENIENT CHECK ADMITS. git would
// resolve it -- against the TARGET's object store, which is a different population from the one that
// admitted the revision -- so a shape check that only refused the empty string would let the deploy
// converge to whatever that abbreviation happens to name on the host today.
test fn a_candidate_that_is_not_a_full_object_id_refuses() -> Bool {
  operands_refused(candidate: "", object_source: fixture_object_source)
    && operands_refused(candidate: "0123456", object_source: fixture_object_source)
    && operands_refused(
      candidate: "0123456789ABCDEF0123456789abcdef01234567",
      object_source: fixture_object_source,
    )
    && operands_refused(
      candidate: "0123456789abcdef0123456789abcdef0123456z",
      object_source: fixture_object_source,
    )
    && !operands_refused(candidate: fixture_candidate, object_source: fixture_object_source)
}

// AN ABSENT OR RELATIVE OBJECT SOURCE IS THE ENVIRONMENT FILE NOT HAVING REACHED THE UNIT. Admitting
// it would send `git fetch` at a path nobody chose, from a process whose working directory is `/`.
test fn an_object_source_that_is_not_an_absolute_path_refuses() -> Bool {
  operands_refused(candidate: fixture_candidate, object_source: "")
    && operands_refused(candidate: fixture_candidate, object_source: "   ")
    && operands_refused(candidate: fixture_candidate, object_source: "gunbc")
    && !operands_refused(candidate: fixture_candidate, object_source: fixture_object_source)
}

test fn a_promisor_object_source_refuses_naming_the_source_and_the_cause() -> Bool {
  let serve = object_source_serve_admission(
    source: fixture_object_source,
    standing: PartialClonePromisor { detail: "extensions.partialClone=origin" },
  )
  match serve {
    ObjectSourceCanServe { source: _ } => false
    ObjectSourceServeDecideAtApplyPwd => false
    ObjectSourceCannotServe { source: s, cause: c } =>
      s == fixture_object_source
        && string_contains(s: c, pattern: "promisor")
        && string_contains(s: object_source_serve_refusal_text(admission: serve), pattern: fixture_object_source)
        && match convergence_operands_for(
          spec: deployment_spec_srv1(),
          candidate: fixture_candidate,
          object_source: fixture_object_source,
          object_source_serve: serve,
        ) {
          ConvergenceOperandsAdmitted { operands: _ } => false
          ConvergenceOperandsRefused { reason: r } =>
            string_contains(s: r, pattern: fixture_object_source)
              && string_contains(s: r, pattern: "promisor")
        }
  }
}

test fn a_complete_object_source_admits() -> Bool {
  match object_source_serve_admission(source: fixture_object_source, standing: ObjectStoreComplete) {
    ObjectSourceCannotServe { source: _, cause: _ } => false
    ObjectSourceServeDecideAtApplyPwd => false
    ObjectSourceCanServe { source: s } =>
      s == fixture_object_source
        && !operands_refused(candidate: fixture_candidate, object_source: fixture_object_source)
  }
}

fn srv1_unit_text() -> String {
  convergence_unit_doc(
    spec: deployment_spec_srv1(),
    candidate: fixture_candidate,
    receipt_path: convergence_receipt_path(instance_root: "/opt/gunbc"),
    working_directory: fixture_object_source,
  )
}

// THE UNIT IS THE PLACEMENT, so the two directives that MAKE it the placement are pinned exactly.
// `User=` is what causes the repository's owner to perform the transition; without it the unit runs
// as root and the whole construction is pointless.
test fn the_unit_runs_as_the_service_user_in_a_oneshot() -> Bool {
  let unit = srv1_unit_text()
  string_contains(s: unit, pattern: concat("User=", srv1_service_user()))
    && string_contains(s: unit, pattern: concat("Group=", srv1_service_user()))
    && string_contains(s: unit, pattern: "Type=oneshot")
    && string_contains(s: unit, pattern: "EnvironmentFile=/etc/gunbc-tree-sync.env")
    && !string_contains(s: unit, pattern: "User=root")
}

// THE ONESHOT RUNS INSIDE THE RUNNER CHECKOUT IT READS. A systemd unit's cwd is `/` unless told
// otherwise; the admitted binary discovers its workspace root by walking cwd's ancestors for `.git`
// and then requires every source root under it. The first two deploys through `gunbc converge
// --mode deploy` on srv1 refused from this unit in exactly those two ways, after the binary had been
// installed and before the service was restarted. The working directory is therefore the object
// source the ExecStart's roots live under -- the same path the env file names -- and it is a
// parameter because only the deploying shell knows it.
test fn the_unit_runs_inside_the_runner_checkout_it_reads() -> Bool {
  string_contains(s: srv1_unit_text(), pattern: concat("WorkingDirectory=", fixture_object_source))
}

// THE ONESHOT IS BOUNDED, AND STRICTLY INSIDE THE STEP THAT WAITS ON IT. A Type=oneshot unit with
// no TimeoutStartSec= never times out, and the deploy's `systemctl restart` of it blocks until it
// finishes, so fleet-converge run 36032847731 sat silent until the workflow step's ceiling killed
// it with no receipt. The discriminating half is the relation: a bound at or above the step
// ceiling renders a TimeoutStartSec= line and still loses the diagnosis to the step kill.
test fn the_unit_start_is_bounded_inside_the_deploy_step() -> Bool {
  let bound = second_count(s: convergence_unit_start_timeout)
  string_contains(s: srv1_unit_text(), pattern: concat("TimeoutStartSec=", to_string(value: bound)))
    && bound > 0
    && bound < gunbc_ci_live_deploy_step_timeout_minutes * 60
}

// THE ONESHOT RUNS IN ITS OWN SLICE, NOT THE DEPLOYMENT'S SERVING ONE. The admitted binary refuses to
// plan without a cgroup memory bound on the process (HostBudgetUnreadable, measured on srv1 from this
// unit under system.slice), so the unit must name a bounded slice; it used to name gunbc-roadmap.slice
// and was reclaim-throttled there by the serving members' growth (fleet-converge run 36204703858). The
// discriminating half is the absence: a unit naming both would pass the presence check alone.
test fn the_unit_joins_the_repository_convergence_slice() -> Bool {
  let unit = srv1_unit_text()
  string_contains(s: unit, pattern: concat("Slice=", gunbc_repository_convergence_slice_unit_name as String))
    && !string_contains(s: unit, pattern: "Slice=gunbc-roadmap.slice")
}

fn rendering_refused(slice: String) -> Bool {
  match convergence_unit_rendering(
    spec: deployment_spec_srv1(),
    slice: slice as NonEmptyStr,
    candidate: fixture_candidate,
    receipt_path: convergence_receipt_path(instance_root: "/opt/gunbc"),
    working_directory: fixture_object_source,
  ) {
    ConvergenceUnitRendered { text: _ } => false
    ConvergenceUnitPlacementRefused { reason: r } => string_contains(s: r, pattern: slice)
  }
}

// THE RED THE BRIEF NAMES: placing the oneshot in a serving slice REFUSES AT THE MODEL, before any
// unit text exists. Three cases, each a different way to be inside one: the roadmap deployment slice
// itself (the placement that failed), the approval broker's slice, and a CHILD of the roadmap slice --
// systemd reads the dash in gunbc-roadmap-convergence.slice as a parent edge, so that name is charged
// against the roadmap bound and an equality-only admission would pass it. The positive control is the
// declared convergence slice, and a sibling name under the gunbc prefix that is inside no serving
// slice, so a wall that refused every slice fails this claim too.
test fn a_serving_slice_placement_refuses_and_the_convergence_slice_is_admitted() -> Bool {
  rendering_refused(slice: deployment_slice_unit_name(names: deployment_spec_srv1().names) as String)
    && rendering_refused(slice: gunbc_approval_broker_slice_unit_name as String)
    && rendering_refused(slice: "gunbc-roadmap-convergence.slice")
    && !rendering_refused(slice: gunbc_repository_convergence_slice_unit_name as String)
    && !rendering_refused(slice: "gunbc-roadmapx.slice")
}

// THE CORPUS COMES FROM THE RUNNER CHECKOUT AND THE BINARY FROM THE INSTALL, AND THIS IS THE WITNESS
// FOR THE ACCEPTANCE CLAUSE ABOUT A STALE TARGET. The target's tree is 637 commits behind and its
// corpus predates the convergence module, so a source root under the deployed repo root would make
// the unit ask a 2026-08-19 corpus to run an operation authored later. Both source roots and the
// entry therefore sit under the expanded GUNBC_TREE_SRC, and the deployed repo root appears NOWHERE
// in the command -- which is the discriminating half: asserting only the presence of the runner
// paths would pass a command that named both.
test fn the_unit_runs_the_admitted_binary_over_the_runner_checkout_corpus() -> Bool {
  let spec = deployment_spec_srv1()
  let cmd = convergence_exec_start(
    spec: spec,
    candidate: fixture_candidate,
    receipt_path: convergence_receipt_path(instance_root: "/opt/gunbc"),
  )
  starts_with(s: cmd, prefix: concat(fixed_serve_binary_path(binary: spec.service.serve_binary), " run"))
    && string_contains(s: cmd, pattern: "--source-root $\{GUNBC_TREE_SRC\}/dag")
    && string_contains(s: cmd, pattern: "--source-root $\{GUNBC_TREE_SRC\}/src/v2")
    && string_contains(
      s: cmd,
      pattern: "--entry $\{GUNBC_TREE_SRC\}/dag/gunbc/live_deploy/repository_convergence_placement.dag",
    )
    && string_contains(s: cmd, pattern: "--arg object_source=$\{GUNBC_TREE_SRC\}")
    && string_contains(s: cmd, pattern: concat("--arg candidate=", fixture_candidate))
    && string_contains(s: cmd, pattern: concat("--arg instance_id=", spec.instance_id as String))
    && !string_contains(s: cmd, pattern: concat("--source-root ", srv1_repo_root()))
}

// THE RECEIPT IS NOT WRITTEN INSIDE THE REPOSITORY THE TRANSITION RESETS. A path under the worktree
// is either destroyed by `reset --hard` or reported by the adjudication as untracked residue that
// refuses the very transition that produced it.
test fn the_receipt_is_written_outside_the_converged_worktree() -> Bool {
  let path = convergence_receipt_path(instance_root: "/opt/gunbc")
  path == "/opt/gunbc/receipts/repository-convergence.json"
    && !starts_with(s: path, prefix: concat(srv1_repo_root(), "/"))
    && convergence_receipt_path(instance_root: "/srv/twin")
      == "/srv/twin/receipts/repository-convergence.json"
}

// THE ROUND TRIP IS CHECKED BY RE-SERIALISING THE DECODED VALUE AND COMPARING BYTES, which is a
// stronger equality than comparing the two receipts: it fails if any field was dropped, reordered
// into a different member, or silently defaulted, whereas a value comparison that ignored one field
// would pass while that field was lost.
fn round_trips(receipt: ConvergencePlacementReceipt) -> Bool {
  let text = placement_receipt_text(receipt: receipt)
  match decode_placement_receipt(text: text) {
    PlacementReceiptUnreadable { cause: _ } => false
    PlacementReceiptDecoded { receipt: back } => placement_receipt_text(receipt: back) == text
  }
}

// THE READBACK REACHES THE OUTER TRANSACTION WITH THE CAUSE INTACT, which is the acceptance clause
// about carrying a typed result rather than an exit code. Every arm round-trips, including the two
// that never touch git -- if a refused placement decoded as anything else, the deploy would be told
// a story about git that git was never asked.
test fn every_receipt_arm_round_trips_through_the_json_codec() -> Bool {
  round_trips(receipt: PlacementConverged { candidate: fixture_candidate, repo: srv1_repo_root() })
    && round_trips(receipt: PlacementConvergenceRefused {
      candidate: fixture_candidate,
      repo: srv1_repo_root(),
      detail: "convergence base-ref moved: expected aaa observed bbb",
    })
    && round_trips(receipt: PlacementWrongPrincipal {
      expected: srv1_service_user(),
      observed: "ghrunner",
    })
    && round_trips(receipt: PlacementPrincipalUnobservable { reason: "whoami failed" })
    && round_trips(receipt: PlacementOperandsRefused { reason: "the candidate revision is empty" })
}

// A DETAIL FIELD CARRYING THE CHARACTERS JSON RESERVES MUST SURVIVE, because the payload it carries
// is another module's diagnostic prose and that prose contains quotes, backslashes and newlines.
// A codec that corrupted them would hand the operator a mangled cause for a real failure.
test fn a_detail_carrying_json_metacharacters_survives_the_round_trip() -> Bool {
  round_trips(receipt: PlacementConvergenceRefused {
    candidate: fixture_candidate,
    repo: srv1_repo_root(),
    detail: "ref \"refs/heads/x\" vanished\n\tpath C:\\tmp -- see `git update-ref`",
  })
}

// THE DECODE REFUSES RATHER THAN GUESSING, and the duplicated-verdict case is the one that matters:
// RFC 8259 does not say which member wins, so a last-wins reader would let a second verdict override
// the first. A document with two verdicts is refused, not resolved.
fn receipt_text_is_unreadable(text: String) -> Bool {
  match decode_placement_receipt(text: text) {
    PlacementReceiptUnreadable { cause: c } => c != ""
    PlacementReceiptDecoded { receipt: _ } => false
  }
}

test fn a_malformed_or_ambiguous_receipt_refuses_instead_of_decoding() -> Bool {
  receipt_text_is_unreadable(text: "not json at all")
    && receipt_text_is_unreadable(text: "{\"schema\": \"gunbc.repository-convergence-placement.v1\"}")
    && receipt_text_is_unreadable(text: "{\"schema\": \"someone.elses.schema\", \"verdict\": \"converged\"}")
    && receipt_text_is_unreadable(text: "{\"schema\": \"gunbc.repository-convergence-placement.v1\", \"verdict\": \"invented\"}")
    && receipt_text_is_unreadable(text: "{\"schema\": \"gunbc.repository-convergence-placement.v1\", \"verdict\": \"converged\", \"verdict\": \"operands-refused\"}")
}

// AN UNREPORTED TRANSITION IS NOT A CONVERGED ONE. The unit failing before its write, the file being
// absent, and the document being unreadable all reach the deploy as NOT converged -- the alternative
// is a transaction that proceeds over a repository nobody moved.
test fn only_a_decoded_converged_receipt_lets_the_transaction_proceed() -> Bool {
  let converged = PlacementConverged { candidate: fixture_candidate, repo: srv1_repo_root() }
  convergence_readback_holds(
    readback: convergence_readback_of_text_bound(
      text: placement_receipt_text(receipt: converged),
      path: fixture_receipt_path,
      expected_candidate: fixture_candidate,
    ),
  )
    && !convergence_readback_holds(readback: convergence_readback_of_text_bound(
      text: "",
      path: fixture_receipt_path,
      expected_candidate: fixture_candidate,
    ))
    && !convergence_readback_holds(readback: ConvergenceReadbackRefused { cause: "no receipt" })
    && !convergence_readback_holds(
      readback: convergence_readback_of_text_bound(
        text: placement_receipt_text(
          receipt: PlacementWrongPrincipal { expected: srv1_service_user(), observed: "ghrunner" },
        ),
        path: fixture_receipt_path,
        expected_candidate: fixture_candidate,
      ),
    )
    && placement_converged(receipt: converged)
    && !placement_converged(receipt: PlacementOperandsRefused { reason: "x" })
    && !placement_converged(receipt: PlacementPrincipalUnobservable { reason: "x" })
    && !placement_converged(receipt: PlacementConvergenceRefused {
      candidate: fixture_candidate,
      repo: srv1_repo_root(),
      detail: "x",
    })
}

// THE POSITIVE CONTROL OF THE BINDING. A fresh receipt written by THIS run -- the candidate on it is
// the plan's, the same fixture string operand admission admitted -- converges. This row is what
// keeps the RED below honest: without it, a readback that refused EVERYTHING would satisfy the stale
// assertions and read as covered.
test fn a_fresh_receipt_naming_the_plan_candidate_converges() -> Bool {
  let fresh = PlacementConverged { candidate: fixture_candidate, repo: srv1_repo_root() }
  match convergence_readback_of_text_bound(
    text: placement_receipt_text(receipt: fresh),
    path: fixture_receipt_path,
    expected_candidate: fixture_candidate,
  ) {
    ConvergenceReadbackDecoded { receipt: r } => placement_converged(receipt: r)
      && convergence_readback_holds(readback: convergence_readback_of_text_bound(
        text: placement_receipt_text(receipt: fresh),
        path: fixture_receipt_path,
        expected_candidate: fixture_candidate,
      ))
    _ => false
  }
}

// THE RED (S83469995): A STALE RECEIPT READS AS STALE, NEVER AS SUCCESS. A prior run converged
// candidate X and wrote the per-instance receipt; this plan asks for candidate Y. The readback must
// refuse with the TYPED stale cause, naming both identities. REVERT THE BINDING AND THIS FAILS: the
// pre-fix readback took only the text, and a prior run's CONVERGED receipt exited 0 for any plan --
// which is the silent wrong answer the store migration found. The typed cause is the point: an
// untyped refusal could be produced by a reader that simply never finds anything, and then this row
// would be green for the wrong reason; the shape below asks for the stale arm specifically, with the
// expected identity normalized and the found identity named.
test fn a_prior_run_receipt_read_back_for_another_plan_refuses_as_stale() -> Bool {
  let stale = PlacementConverged { candidate: fixture_stale_candidate, repo: srv1_repo_root() }
  let readback = convergence_readback_of_text_bound(
    text: placement_receipt_text(receipt: stale),
    path: fixture_receipt_path,
    expected_candidate: fixture_candidate,
  )
  !convergence_readback_holds(readback: readback)
    && match readback {
      // THE STALE CAUSE, TYPED, WITH ALL THREE LOCATIONS CARRIED. The path is NOT fabricated: the
      // caller hands the read its subject in, and the refusal reports THAT path back -- review
      // 86287 found the earlier shape inventing a placeholder instead, and this row is its
      // regression. The wet route's own row below pins the same shape through the entry.
      ConvergenceReadbackStale { path: p, expected: e, found: f } =>
        p == fixture_receipt_path
          && e == fixture_candidate
          && f == fixture_stale_candidate
          && string_contains(s: convergence_readback_line(readback: readback), pattern: "stale-receipt")
          && string_contains(s: convergence_readback_line(readback: readback), pattern: fixture_receipt_path)
      _ => false
    }
}

// A RECEIPT THAT NAMES NO CANDIDATE IS ALSO NEVER SUCCESS. The decoder requires the candidate field
// to exist, but nothing requires it to be an identity -- a writer that emitted `"candidate": ""` (or
// any malformed spelling) produced a receipt that the unbound readback accepted. Under the binding,
// an unnameable candidate fails the comparison from the artifact side, which is the stale arm: the
// file does not answer for this run.
test fn a_receipt_naming_no_candidate_refuses_as_stale() -> Bool {
  let unbound = PlacementConverged { candidate: "", repo: srv1_repo_root() }
  match convergence_readback_of_text_bound(
    text: placement_receipt_text(receipt: unbound),
    path: fixture_receipt_path,
    expected_candidate: fixture_candidate,
  ) {
    ConvergenceReadbackStale { path: _, expected: e, found: f } =>
      e == fixture_candidate
        && string_contains(s: f, pattern: "names no candidate")
    _ => false
  }
}

// THE QUESTION ITSELF CAN BE MALFORMED, AND THAT IS A DIFFERENT CAUSE. If upstream hands the
// readback an expected candidate that is not an identity, no file could ever answer -- the repair is
// upstream, not on the host. Collapsing this into stale would send an operator to delete a receipt
// that is not the problem, so the causes stay separate and the refusal carries the malformed
// expectation it refuses to bind against.
test fn a_malformed_expected_candidate_refuses_as_wrong_candidate() -> Bool {
  let fresh = PlacementConverged { candidate: fixture_candidate, repo: srv1_repo_root() }
  match convergence_readback_of_text_bound(
    text: placement_receipt_text(receipt: fresh),
    path: fixture_receipt_path,
    expected_candidate: "not-a-git-object-id",
  ) {
    ConvergenceReadbackWrongCandidate { expected: e } =>
      e == "not-a-git-object-id"
        && string_contains(
          s: convergence_readback_line(readback: ConvergenceReadbackWrongCandidate { expected: e }),
          pattern: "wrong-candidate",
        )
    _ => false
  }
}

// THE BINDING IS GIT'S DECODER RULE, NOT A LOOSE COMPARISON. The decoder's rule is the canonical
// spelling -- hex, lowercase, forty -- and the binding uses it on BOTH sides, so an uppercase
// spelling is refused rather than folded away (the operand admission refuses it for the same
// reason: one commit cannot have two names). An uppercase `expected` is a malformed question and
// refuses as wrong-candidate; an uppercase candidate stamped on a receipt normalizes to nothing and
// that receipt is stale. If the binding had used a case-insensitive compare, this row would be the
// one to notice it drifting from the admission's rule.
test fn case_drift_refuses_on_both_sides_rather_than_folding() -> Bool {
  let fresh = PlacementConverged { candidate: fixture_candidate, repo: srv1_repo_root() }
  let upper = PlacementConverged { candidate: fixture_candidate_upper_tail, repo: srv1_repo_root() }
  match convergence_readback_of_text_bound(
    text: placement_receipt_text(receipt: fresh),
    path: fixture_receipt_path,
    expected_candidate: fixture_candidate_upper_tail,
  ) {
    ConvergenceReadbackWrongCandidate { expected: e } => e == fixture_candidate_upper_tail
    _ => false
  }
    && match convergence_readback_of_text_bound(
      text: placement_receipt_text(receipt: upper),
      path: fixture_receipt_path,
      expected_candidate: fixture_candidate,
    ) {
      ConvergenceReadbackStale { path: _, expected: e, found: f } =>
        e == fixture_candidate && f == fixture_candidate_upper_tail
      _ => false
    }
    && !convergence_readback_holds(readback: convergence_readback_of_text_bound(
      text: placement_receipt_text(
        receipt: PlacementConverged { candidate: fixture_stale_candidate, repo: srv1_repo_root() },
      ),
      path: fixture_receipt_path,
      expected_candidate: fixture_candidate,
    ))
}

// THE ENTRY POINT ITSELF REFUSES AN UNBOUND CALL. `repository_convergence_readback_wet` is the route
// the store migration found unguarded -- the installed binary reaches it with `run --function ...`
// and no restart leg in front of it -- and its second argument is the run it answers for. This row
// is HERMETIC-SAFE: an empty candidate returns its refusal BEFORE any filesystem read, so no host
// effect is touched and no mock is needed; it pins that the entry has the parameter AND requires it,
// rather than defaulting to the old unbound read that let a prior run's CONVERGED receipt exit 0.
// The composition the entry performs -- hand `candidate` to the bound read -- is pinned by the
// stale RED above (which IS that bound read) plus the apply-plan witness that pins `--arg candidate`
// on the readback leg's argv.
test fn the_readback_entry_refuses_without_the_candidate_it_answers_for() -> Bool {
  match repository_convergence_readback_wet(receipt: "/opt/gunbc/receipts/repository-convergence.json", candidate: "") {
    ExitFailure { code: _, reason: r } => string_contains(s: r, pattern: "candidate")
    ExitSuccess => false
  }
}

// THE ENTRY STILL REFUSES WITHOUT ITS SUBJECT, AND THE TWO REFUSALS ARE DISTINCT. The receipt path
// and the candidate are BOTH required; neither empty-argument refusal touches the filesystem, so a
// caller that supplies only one gets a specific message, not a spurious absent-file error.
test fn the_readback_entry_refuses_without_a_receipt_path() -> Bool {
  match repository_convergence_readback_wet(receipt: "", candidate: fixture_candidate) {
    ExitFailure { code: _, reason: r } => string_contains(s: r, pattern: "receipt")
    ExitSuccess => false
  }
}

// THE PATH ROUTE CARRIES ITS OWN CAUSE SHAPE. `read_convergence_receipt_bound` is what the wet entry
// calls once the arguments hold; a missing file refuses as ReceiptAbsent naming the path, NOT as
// stale -- a file that does not exist answers for no run and must not be reported as a stale one
// (which would send an operator hunting for a writer that never wrote). The path is a
// NONEXISTENT FILE UNDER THE CHECKOUT ROOT, which the hermetic route serves as a real read (absence
// off the commit is input access, not host state), so this row is hermetic-safe: it observes the
// read's refusal rather than needing a mock. Absence is concluded ONLY from the host's not_found
// for the exact path -- the classifier is `filesystem_exact_read`, and the entry-level row below
// proves the sibling arms (unreadable, unrecognized kind) stay separate from this one.
test fn an_absent_receipt_refuses_as_absent_not_stale() -> Bool {
  match read_convergence_receipt_bound(
    receipt_path: "gunbc-nonexistent-repository-convergence-receipt.json",
    expected_candidate: fixture_candidate,
  ) {
    ConvergenceReadbackReceiptAbsent { path: p } =>
      string_contains(s: p, pattern: "repository-convergence")
        && !convergence_readback_holds(readback: ConvergenceReadbackReceiptAbsent { path: p })
        && string_contains(
          s: convergence_readback_line(readback: ConvergenceReadbackReceiptAbsent { path: p }),
          pattern: "UNREPORTED",
        )
    _ => false
  }
}

// THE CONVERGENCE'S OWN EXIT MAPS TO THE RECEIPT WITHOUT INVENTING A CAUSE. A failure carries the
// adjudication's located prose through verbatim; a success carries the operands it converged. The
// RED is that a failure must NOT decode as converged, which is what a truthy-exit reader would do.
test fn the_convergence_exit_maps_onto_the_receipt_without_fabricating() -> Bool {
  match admitted_operands(candidate: fixture_candidate, object_source: fixture_object_source) {
    Absent => false
    Present { value: o } => {
      let ok = placement_receipt_of_convergence(operands: o, exit: ExitSuccess)
      let bad = placement_receipt_of_convergence(
        operands: o,
        exit: ExitFailure { code: 1, reason: "convergence head moved without a reflog entry" },
      )
      placement_converged(receipt: ok)
        && !placement_converged(receipt: bad)
        && match bad {
          PlacementConvergenceRefused { candidate: c, repo: r, detail: d } =>
            c == fixture_candidate
              && r == srv1_repo_root()
              && d == "convergence head moved without a reflog entry"
          PlacementConverged { candidate: _, repo: _ } => false
          PlacementWrongPrincipal { expected: _, observed: _ } => false
          PlacementPrincipalUnobservable { reason: _ } => false
          PlacementOperandsRefused { reason: _ } => false
        }
    }
  }
}

// THE FETCH SOURCE IS TRUSTED AT ITS GIT DIR (#12246 follow-up). The expected values are written
// out, not re-derived, so the oracle is git's observed refusal and not the derivation under test:
// srv1 journal 2026-09-25 02:07:36 refused `-c safe.directory=<checkout>` with "detected dubious
// ownership in repository at <checkout>/.git". RED: the worktree-only path #12246 passed is not
// the path passed now. A second source gets its own git dir, never the fixture's, never `*`.
//
// DECLARED FRONTIER: the execution-level control (a local fetch across two owning principals) is
// not creatable in a session container -- one uid, no sudo, no user namespaces, and release git
// ignores GIT_TEST_ASSUME_DIFFERENT_OWNER. Its trigger is the next srv1 dashboard_deploy, whose
// ConvergenceObjectImportRefused arm reds on this exact cause.
test fn the_fetch_source_is_trusted_at_its_git_dir_not_its_worktree() -> Bool {
  convergence_fetch_upload_pack(remote: fixture_object_source) != "git -c 'safe.directory=/home/ghrunner/work/gunbc/gunbc' upload-pack"
    && convergence_fetch_upload_pack(remote: "/srv/another-checkout") == "git -c 'safe.directory=/srv/another-checkout/.git' upload-pack"
    && convergence_fetch_upload_pack(remote: fixture_object_source) != "git -c 'safe.directory=*' upload-pack"
}

// THE SOURCE TRUST IS CARRIED INSIDE --upload-pack (srv1 dashboard_deploy run 36100865330). The
// oracle is srv1's A/B (extdeps.git git_local_fetch_upload_pack_command): `-c` on the fetch REFUSED,
// `--upload-pack="git -c safe.directory=<S>/.git upload-pack"` fetched. Expected strings are
// written out. RED: the bare `git-upload-pack` default (no carriage) and an unquoted splice both
// differ; a path carrying an apostrophe and a space stays ONE shell word.
test fn the_fetch_source_trust_rides_inside_upload_pack_quoted() -> Bool {
  convergence_fetch_upload_pack(remote: fixture_object_source) == "git -c 'safe.directory=/home/ghrunner/work/gunbc/gunbc/.git' upload-pack"
    && convergence_fetch_upload_pack(remote: fixture_object_source) != "git-upload-pack"
    && convergence_fetch_upload_pack(remote: fixture_object_source) != "git -c safe.directory=/home/ghrunner/work/gunbc/gunbc/.git upload-pack"
    && convergence_fetch_upload_pack(remote: "/srv/it's here") == "git -c 'safe.directory=/srv/it'\\''s here/.git' upload-pack"
}

// THE ENTRY IS EXECUTED, NOT REASONED ABOUT. Every row above exercises a helper; the side-chat
// review of head 079aefa85c55 named exactly the gap those rows leave: an ENTRY that ignored its
// candidate would keep every helper row green, because no row ran the entry on a readable receipt
// with two nonempty arguments. These rows close it. The instrument is the modeled operation
// realization (gunbc.filesystem_model through std.witness_evaluation), the same one
// dag/test/claim/modeled_filesystem_witness.dag runs durable-hold production code through: the
// subject below is the PRODUCTION ENTRY, and the model answers ONLY its Filesystem.Read, through
// the real dispatcher and the transport projection that fills the operation's `error_kind` field.
// A path inside the model is host state the MODEL owns, so no checkout carve-out or scratch file
// is touched. The runner executes as root, where a chmod 000 control could never bite --
// permission denial is therefore modeled the way the model says it (`refused_reads`), which is
// also the answer `filesystem_exact_read` must classify as unreadable-and-never-absent.
data readback_frame_identity: NonEmptyStr = "convergence-readback-entry-witness" as NonEmptyStr

fn readback_grant(verb: std.effect_grant.Verb) -> Grant {
  Grant {
    verb: verb
    root: NamespacePosition { tree: ServiceOpTree { service: "Filesystem" }, path: [] }
    binding: ModeledRealization { realization: readback_frame_identity as String }
    lifecycle: LifecycleByConstruction
  }
}

fn readback_frame(initial: ModeledFilesystem) -> WitnessEvaluationFrame<ModeledFilesystem> {
  WitnessEvaluationFrame {
    envelope: Envelope {
      frame: Frame { name: "convergence-readback-entry-witness", kind: SharedStateFrame }
      grants: [readback_grant(verb: Read)]
    }
    rest_fixtures: []
    realization: Present { value: OperationRealization {
      identity: readback_frame_identity,
      initial: initial,
      epoch: virtual_clock_origin(),
      bindings: filesystem_bindings(get: fn(fs) { fs }, put: fn(fs, next) { next }, cwd: fn(fs) { "/" }),
      advance: fn(fs, now) { fs },
    } }
  }
}

fn readback_model_with(content: String) -> ModeledFilesystem {
  ModeledFilesystem {
    directories: ["/", "/opt", "/opt/gunbc", "/opt/gunbc/receipts"],
    files: [ModeledFile { path: fixture_receipt_path, content: content }],
    refused_reads: [],
    stats: [],
  }
}

fn readback_model_refusing() -> ModeledFilesystem {
  ModeledFilesystem {
    directories: ["/", "/opt", "/opt/gunbc", "/opt/gunbc/receipts"],
    files: [ModeledFile { path: fixture_receipt_path, content: "unreadable-but-present" }],
    refused_reads: [fixture_receipt_path],
    stats: [],
  }
}

fn readback_model_empty() -> ModeledFilesystem {
  ModeledFilesystem {
    directories: ["/", "/opt", "/opt/gunbc", "/opt/gunbc/receipts"],
    files: [],
    refused_reads: [],
    stats: [],
  }
}

fn receipt_text_for(candidate: String) -> String {
  placement_receipt_text(receipt: PlacementConverged { candidate: candidate, repo: srv1_repo_root() })
}

// THE POSITIVE CONTROL, AT THE ENTRY. A receipt readable at the path, naming THIS plan's candidate,
// exits 0. This is the row that would stay green for a vacuous entry too -- which is why it is the
// FIRST half of the pair below and never stands alone.
test fn the_executed_entry_converges_on_a_fresh_receipt_naming_the_plan_candidate() -> Bool {
  match evaluate_in_witness_frame(
    frame: readback_frame(initial: readback_model_with(content: receipt_text_for(candidate: fixture_candidate))),
    subject: fn(_scope) { repository_convergence_readback_wet(receipt: fixture_receipt_path, candidate: fixture_candidate) },
  ) {
    WitnessReturned { value } => match value { ExitSuccess => true _ => false }
    _ => false
  }
}

// THE ENTRY-LEVEL RED, EXECUTED THROUGH THE ENTRY. The model holds a CONVERGED receipt for candidate
// X; the entry is called for plan Y. It must exit nonzero with the stale-receipt cause AND the real
// receipt path in the reason -- the path the read actually took, not a placeholder (review 86287
// found the text-level constructor filling `path` with "(text readback -- no path was involved)" and
// the read leg passing it through, so the installed-binary route reported the wrong location).
// MUTATION-SENSITIVITY, THE PART THE HELPER ROWS COULD NOT CARRY: an entry that dropped or ignored
// `candidate` would exit 0 on this receipt (its helper twin green), reddening exactly this row.
test fn the_executed_entry_refuses_a_prior_run_receipt_with_the_stale_cause_and_the_real_path() -> Bool {
  match evaluate_in_witness_frame(
    frame: readback_frame(initial: readback_model_with(content: receipt_text_for(candidate: fixture_stale_candidate))),
    subject: fn(_scope) { repository_convergence_readback_wet(receipt: fixture_receipt_path, candidate: fixture_candidate) },
  ) {
    WitnessReturned { value } =>
      match value {
        ExitFailure { code: _, reason: r } =>
          string_contains(s: r, pattern: "stale-receipt")
            && string_contains(s: r, pattern: fixture_receipt_path)
            && string_contains(s: r, pattern: fixture_candidate)
            && string_contains(s: r, pattern: fixture_stale_candidate)
            && !string_contains(s: r, pattern: "no path was involved")
        ExitSuccess => false
      }
    _ => false
  }
}

// PERMISSION DENIED IS UNREADABLE, AND THE ENTRY NEVER CALLS IT ABSENCE. The model refuses the read
// of a PRESENT file -- the shape a chmod-000 or SELinux denial produces on a real host, modeled
// because the runner is root and no file mode can deny root. The entry's refusal must say the
// receipt EXISTS and is being withheld (the unreadable arm's words), must name the host's kind, and
// must NOT speak the absent arm's sentence ("did not reach its write") -- conflating the two sends
// the operator to hunt a writer that wrote (DESIGN 5: typed, located; S83469995's class is exactly
// an answer read from the wrong run, and absence-vs-withholding is the same conflation one level
// down). This is the typed-channel control the Bool `success` channel could not express.
test fn the_executed_entry_refuses_a_present_but_unreadable_receipt_as_unreadable_not_absent() -> Bool {
  match evaluate_in_witness_frame(
    frame: readback_frame(initial: readback_model_refusing()),
    subject: fn(_scope) { repository_convergence_readback_wet(receipt: fixture_receipt_path, candidate: fixture_candidate) },
  ) {
    WitnessReturned { value } =>
      match value {
        ExitFailure { code: _, reason: r } =>
          string_contains(s: r, pattern: "NOT absence")
            && string_contains(s: r, pattern: "permission_denied")
            && string_contains(s: r, pattern: fixture_receipt_path)
            && !string_contains(s: r, pattern: "did not reach its write")
        ExitSuccess => false
      }
    _ => false
  }
}

// THE ABSENT ENTRY STAYS ITSELF. The model holds nothing at the path -- NotFound for the exact path
// is the ONLY thing that concludes absence -- and the entry refuses with the absent arm's sentence,
// NOT the unreadable one. Paired with the row above, the two refusal sentences never appear in the
// other's output: only NotFound is absence, and every other kind keeps its own arms.
test fn the_executed_entry_refuses_an_absent_receipt_as_absent_never_unreadable() -> Bool {
  match evaluate_in_witness_frame(
    frame: readback_frame(initial: readback_model_empty()),
    subject: fn(_scope) { repository_convergence_readback_wet(receipt: fixture_receipt_path, candidate: fixture_candidate) },
  ) {
    WitnessReturned { value } =>
      match value {
        ExitFailure { code: _, reason: r } =>
          string_contains(s: r, pattern: "did not reach its write")
            && string_contains(s: r, pattern: fixture_receipt_path)
            && !string_contains(s: r, pattern: "NOT absence")
        ExitSuccess => false
      }
    _ => false
  }
}

// THE FOLD'S OWN ARMS, INCLUDING THE ONE NO HOST MODEL CAN PRODUCE. A host kind outside the closed
// roster (a future kernel error, a version-skewed host) arrives on the `error_kind` channel as a
// string this module does not recognize. The fold refuses to fold THAT into absence -- the host did
// not say the file is missing -- and the refusal carries the observed spelling. The model can only
// answer recognized kinds, so this arm is driven at its boundary directly, where the string enters.
test fn an_unrecognized_host_kind_is_never_classified_as_absent_or_unreadable() -> Bool {
  match filesystem_exact_read(
    path: fixture_receipt_path,
    content: "",
    success: false,
    error: "some future errno",
    error_kind: "quota_exceeded",
  ) {
    FilesystemExactPathKindUnrecognized { path: p, observed: o, error: e } =>
      p == fixture_receipt_path && o == "quota_exceeded" && e == "some future errno"
        && string_contains(s: convergence_readback_line(readback: ConvergenceReadbackKindUnrecognized {
          path: p, observed: o, error: e,
        }), pattern: "never")
        && string_contains(s: convergence_readback_line(readback: ConvergenceReadbackKindUnrecognized {
          path: p, observed: o, error: e,
        }), pattern: "quota_exceeded")
        && !string_contains(s: convergence_readback_line(readback: ConvergenceReadbackKindUnrecognized {
          path: p, observed: o, error: e,
        }), pattern: "did not reach its write")
    _ => false
  }
    && match filesystem_exact_read(
      path: fixture_receipt_path,
      content: "",
      success: false,
      error: "No such file or directory",
      error_kind: "not_found",
    ) {
      FilesystemExactPathAbsent { path: p } => p == fixture_receipt_path
      _ => false
    }
    && match filesystem_exact_read(
      path: fixture_receipt_path,
      content: "",
      success: false,
      error: "Not a directory",
      error_kind: "not_a_directory",
    ) {
      FilesystemExactPathUnreadable { path: p, kind: _, error: _ } => p == fixture_receipt_path
      _ => false
    }
    && match filesystem_exact_read(
      path: fixture_receipt_path,
      content: "payload",
      success: true,
      error: "",
      error_kind: "",
    ) {
      FilesystemExactPathRead { path: p, content: c } => p == fixture_receipt_path && c == "payload"
      _ => false
    }
}
