module test.claim.namespace_migration_kit_list_push

import std.types { Bool, List, String }
import std.optional { Present, Absent }
import std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import gunbc.namespace_cut.ambient_name_home { AmbientNameHome, ambient_name_homes }
import gunbc.instruments.ambient_name_census_reading { ambient_census_kit_rows }
import gunbc.namespace_cut.migration_kit { kit_binding_finding, kit_ambient_route_count, kit_emit_finding, kit_emit_unimported_finding, EmitFinding, EmitIdentityHolds, EmitNotRunnable, UnimportedEmitFinding, UnimportedRefused, UnimportedCompilesWithoutDeclaration, ContractFinding, ContractAbsent, ContractStillPresent, ContractControlBroken, kit_contract_finding, binding_reading, reading_is_unbound, reading_is_bound_to, KitFinding, KitMigrated, KitNoImportDoesNotRefuse, KitImportDoesNotClear, KitNotRunnable }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// THE ROW IS READ, NOT RESTATED: ambient_census_kit_rows() is the one roster the census label also runs, so a wave that
// edits the candidate's home or contract, or lands the row in ambient_name_homes(), moves this claim with it.
fn list_push_rows() -> List<AmbientNameHome> {
  ambient_census_kit_rows() |> filter(h => h.name == "list_push")
}

fn with_row(f: fn(AmbientNameHome) -> Bool) -> Bool {
  match first(list_push_rows()) { Present { value: r } => f(r)  Absent => false }
}

test fn list_push_has_exactly_one_kit_row() -> Bool {
  count(list_push_rows()) == 1
}

// THE DISPOSITION IS DERIVED from the namespace authority: list_push is migrated iff ambient_name_homes() carries its row,
// so the wave's one row edit flips the tree and this expectation together (no claim-local copy). Every claim below asserts the reading that disposition entails,
// so each is GREEN on both sides of the migration and RED when the tree disagrees with the row (an expecting-red
// reading that becomes the permanent regression control, DESIGN 4b). On main list_push is not migrated: it resolves
// ambiently, its contract is rostered, and no declaration is emitted.
fn list_push_migrated() -> Bool {
  count(ambient_name_homes() |> filter(h => h.name == "list_push")) > 0
}

fn is_migrated(f: KitFinding) -> Bool { match f { KitMigrated => true  _ => false } }

// THE JUDGE AT ITS OWN INTERFACE, lines SUPPLIED in the census's printed format (the format is held by the
// ambient-name-census fixture). Each RED is paired with its positive; the real-census inhabitance claim is the kit
// label's, not this module's.
data judge_module: String = "examples.kit_list_push_imported"
data judge_unimported_module: String = "examples.kit_list_push_unimported"
data judge_declared: String = "binding\texamples.kit_list_push_imported\tlist_push\t0\tdeclared\tstd.algebra.list_push\t5:3\n"
data judge_other_home: String = "binding\texamples.kit_list_push_imported\tlist_push\t0\tdeclared\tother.list_push\t5:3\n"
data judge_ambient: String = "binding\texamples.kit_list_push_imported\tlist_push\t0\tambient:primitive_authority\tstd.primitives.list_push\t5:3\n"
data judge_ambient_unimported: String = "binding\texamples.kit_list_push_unimported\tlist_push\t0\tambient:primitive_authority\tstd.primitives.list_push\t5:3\n"
data judge_unbound: String = "binding_unbound\texamples.kit_list_push_unimported\tlist_push\t5:3\n"

test fn judge_declared_binds_exact_identity() -> Bool {
  reading_is_bound_to(r: binding_reading(stdout: judge_declared, module: judge_module, spelling: "list_push"), identity: "std.algebra.list_push")
}

test fn judge_same_spelling_other_home_is_not_the_identity() -> Bool {
  !reading_is_bound_to(r: binding_reading(stdout: judge_other_home, module: judge_module, spelling: "list_push"), identity: "std.algebra.list_push")
}

test fn judge_ambient_is_not_bound_to_declaration() -> Bool {
  !reading_is_bound_to(r: binding_reading(stdout: judge_ambient, module: judge_module, spelling: "list_push"), identity: "std.algebra.list_push")
    && !reading_is_unbound(r: binding_reading(stdout: judge_ambient, module: judge_module, spelling: "list_push"))
}

test fn judge_unbound_is_unbound_and_no_row_is_not_reached() -> Bool {
  reading_is_unbound(r: binding_reading(stdout: judge_unbound, module: judge_unimported_module, spelling: "list_push"))
    && !reading_is_unbound(r: binding_reading(stdout: "", module: judge_module, spelling: "list_push"))
}

// CHECK 3: the retired contract is rostered iff the row is not migrated; its pairing control (concat_contract, which
// stays) must NOT be broken, so an import-shape failure cannot pass as "absent".
test fn list_push_contract_matches_the_row_disposition() -> Bool {
  with_row(r => match kit_contract_finding(row: r, control_contract: "concat_contract") {
    ContractAbsent => list_push_migrated()
    ContractStillPresent => !list_push_migrated()
    _ => false
  })
}

test fn probe_contract_control_is_not_broken() -> Bool {
  with_row(r => match kit_contract_finding(row: r, control_contract: "concat_contract") { ContractControlBroken => false  _ => true })
}

// THE IDENTITY VERDICT on supplied census output: declared home -> migrated; ambient on the unimported side -> the
// no-import RED does not fire; unbound unimported plus ambient imported -> import does not clear.
test fn identity_verdict_migrated_on_declared_import() -> Bool {
  with_row(r => is_migrated(f: kit_binding_finding(unimported_stdout: judge_unbound, imported_stdout: judge_declared, row: r)))
}

test fn identity_verdict_reads_ambient_as_not_refusing() -> Bool {
  with_row(r => match kit_binding_finding(unimported_stdout: judge_ambient_unimported, imported_stdout: judge_declared, row: r) { KitNoImportDoesNotRefuse => true  _ => false })
}

test fn identity_verdict_other_home_does_not_clear() -> Bool {
  with_row(r => match kit_binding_finding(unimported_stdout: judge_unbound, imported_stdout: judge_other_home, row: r) { KitImportDoesNotClear => true  _ => false })
}

// CHECK 4 (host_symbol per the Rust realization of list_push, v1_rt::rc_list_push; self path crate::std_algebra::list_push(
// per the emitted path convention in resolved_call_emission_identity_witness). The finding names WHICH arm fired: migrated
// asserts the host symbol is emitted and the self-call is not; not migrated asserts the imported fixture is REFUSED
// (so there is no emission to read), never a bare false that a non-compiling fixture would also give.
test fn list_push_emission_matches_the_row_disposition() -> Bool {
  with_row(r => match kit_emit_finding(row: r, host_symbol: "v1_rt::rc_list_push(", self_path: "crate::std_algebra::list_push(") {
    EmitIdentityHolds => list_push_migrated()
    EmitNotRunnable { cause: _ } => !list_push_migrated()
    _ => false
  })
}

// Migrated: the unimported call is refused (check 1's RED), so nothing is emitted. Not migrated: it resolves ambiently,
// compiles, and does not select the declaration path.
test fn list_push_unimported_does_not_select_the_declaration_path() -> Bool {
  with_row(r => match kit_emit_unimported_finding(row: r, self_path: "crate::std_algebra::list_push(") {
    UnimportedRefused => list_push_migrated()
    UnimportedCompilesWithoutDeclaration => !list_push_migrated()
    _ => false
  })
}

// CHECK 6 on supplied census lines: an ambient row for the spelling is a second route; a declared one is not; and the
// count is taken per spelling, so another name's ambient row does not satisfy or break it.
test fn no_ambient_route_when_only_declared_rows() -> Bool {
  kit_ambient_route_count(stdout: judge_declared, spelling: "list_push") == 0
}

test fn an_ambient_row_is_counted_as_a_second_route() -> Bool {
  kit_ambient_route_count(stdout: judge_ambient + judge_declared, spelling: "list_push") == 1
}

test fn another_spellings_ambient_row_is_not_this_names_route() -> Bool {
  kit_ambient_route_count(stdout: judge_ambient, spelling: "map_lookup") == 0
}
