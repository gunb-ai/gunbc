module test.claim.namespace_migration_kit_list_push

import std.types { Bool, NonEmptyStr, String }
import std.optional { optional_present }
import std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import gunbc.namespace_cut.ambient_name_home { AmbientNameHome, ambient_name_homes, ExistingDeclaration, PrimitiveAuthorityTable }
import gunbc.namespace_cut.migration_kit { kit_binding_finding, kit_ambient_route_count, kit_emit_identity_holds, kit_emit_unimported_does_not_select_declaration, ContractFinding, ContractAbsent, ContractStillPresent, ContractControlBroken, kit_contract_finding, binding_reading, reading_is_unbound, reading_is_bound_to, KitFinding, KitMigrated, KitNoImportDoesNotRefuse, KitImportDoesNotClear, KitNotRunnable }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// SUPPLIED ROW for list_push (#14751's wave). Until that wave adds its ambient_name_homes() row this is the
// kit's one subject; the wave replaces this module's row with its own and keeps the claim.
fn list_push_row() -> AmbientNameHome {
  AmbientNameHome {
    name: "list_push" as NonEmptyStr,
    home: "std.algebra" as NonEmptyStr,
    table: PrimitiveAuthorityTable,
    origin: ExistingDeclaration,
    retired_contract: optional_present(value: "list_push_contract" as NonEmptyStr)
  }
}

// THE DISPOSITION IS DERIVED from the namespace authority: list_push is migrated iff ambient_name_homes() carries its row,
// so the wave's one row edit flips the tree and this expectation together (no claim-local copy). Every claim below asserts the reading that disposition entails,
// so each is GREEN on both sides of the migration and RED when the tree disagrees with the row (an expecting-red
// reading that becomes the permanent regression control, DESIGN 4b). On main list_push is not migrated: it resolves
// ambiently, its contract is rostered, and no declaration is emitted.
fn list_push_migrated() -> Bool {
  count(ambient_name_homes() |> filter(h => h.name == "list_push")) > 0
}

fn is_migrated(f: KitFinding) -> Bool { match f { KitMigrated => true  _ => false } }

// THE JUDGE AT ITS OWN INTERFACE, lines SUPPLIED in the census's printed format (the format is held by the
// ambient-name-census fixture). Each RED is paired with its positive; the real-census inhabitance claim is the kit
// label's, not this module's.
data judge_module: String = "probe_migration_kit"
data judge_declared: String = "binding\tprobe_migration_kit\tlist_push\t0\tdeclared\tstd.algebra.list_push\t5:3\n"
data judge_other_home: String = "binding\tprobe_migration_kit\tlist_push\t0\tdeclared\tother.list_push\t5:3\n"
data judge_ambient: String = "binding\tprobe_migration_kit\tlist_push\t0\tambient:primitive_authority\tstd.primitives.list_push\t5:3\n"
data judge_unbound: String = "binding_unbound\tprobe_migration_kit\tlist_push\t5:3\n"

test fn judge_declared_binds_exact_identity() -> Bool {
  reading_is_bound_to(r: binding_reading(stdout: judge_declared, module: judge_module, spelling: "list_push"), identity: "std.algebra.list_push")
}

test fn judge_same_spelling_other_home_is_not_the_identity() -> Bool {
  !reading_is_bound_to(r: binding_reading(stdout: judge_other_home, module: judge_module, spelling: "list_push"), identity: "std.algebra.list_push")
}

test fn judge_ambient_is_not_bound_to_declaration() -> Bool {
  !reading_is_bound_to(r: binding_reading(stdout: judge_ambient, module: judge_module, spelling: "list_push"), identity: "std.algebra.list_push")
    && !reading_is_unbound(r: binding_reading(stdout: judge_ambient, module: judge_module, spelling: "list_push"))
}

test fn judge_unbound_is_unbound_and_no_row_is_not_reached() -> Bool {
  reading_is_unbound(r: binding_reading(stdout: judge_unbound, module: judge_module, spelling: "list_push"))
    && !reading_is_unbound(r: binding_reading(stdout: "", module: judge_module, spelling: "list_push"))
}

// CHECK 3: the retired contract is rostered iff the row is not migrated; its pairing control (concat_contract, which
// stays) must NOT be broken, so an import-shape failure cannot pass as "absent".
test fn list_push_contract_matches_the_row_disposition() -> Bool {
  match kit_contract_finding(row: list_push_row(), control_contract: "concat_contract") {
    ContractAbsent => list_push_migrated()
    ContractStillPresent => !list_push_migrated()
    _ => false
  }
}

test fn probe_contract_control_is_not_broken() -> Bool {
  match kit_contract_finding(row: list_push_row(), control_contract: "concat_contract") { ContractControlBroken => false  _ => true }
}

// THE IDENTITY VERDICT on supplied census output: declared home -> migrated; ambient on the unimported side -> the
// no-import RED does not fire; unbound unimported plus ambient imported -> import does not clear.
test fn identity_verdict_migrated_on_declared_import() -> Bool {
  is_migrated(f: kit_binding_finding(unimported_stdout: judge_unbound, imported_stdout: judge_declared, row: list_push_row()))
}

test fn identity_verdict_reads_ambient_as_not_refusing() -> Bool {
  match kit_binding_finding(unimported_stdout: judge_ambient, imported_stdout: judge_declared, row: list_push_row()) { KitNoImportDoesNotRefuse => true  _ => false }
}

test fn identity_verdict_other_home_does_not_clear() -> Bool {
  match kit_binding_finding(unimported_stdout: judge_unbound, imported_stdout: judge_other_home, row: list_push_row()) { KitImportDoesNotClear => true  _ => false }
}

// CHECK 4 (host_symbol per the Rust realization of list_push, v1_rt::rc_list_push; self path crate::std_algebra::list_push(
// per the emitted path convention in resolved_call_emission_identity_witness).
test fn list_push_emission_matches_the_row_disposition() -> Bool {
  kit_emit_identity_holds(row: list_push_row(), host_symbol: "v1_rt::rc_list_push(", self_path: "crate::std_algebra::list_push(") == list_push_migrated()
}

test fn list_push_unimported_does_not_select_the_declaration_path() -> Bool {
  kit_emit_unimported_does_not_select_declaration(row: list_push_row(), self_path: "crate::std_algebra::list_push(")
}

// CHECK 6 on supplied census lines: an ambient row for the spelling is a second route; a declared one is not; and the
// count is taken per spelling, so another name's ambient row does not satisfy or break it.
test fn no_ambient_route_when_only_declared_rows() -> Bool {
  kit_ambient_route_count(stdout: judge_declared, spelling: "list_push") == 0
}

test fn an_ambient_row_is_counted_as_a_second_route() -> Bool {
  kit_ambient_route_count(stdout: judge_ambient + judge_declared, spelling: "list_push") == 1
}

test fn another_spellings_ambient_row_is_not_this_names_route() -> Bool {
  kit_ambient_route_count(stdout: judge_ambient, spelling: "map_lookup") == 0
}
