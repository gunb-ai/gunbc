module test.claim.namespace_clause_e_projection_law_witness_test


data namespace_clause_e_projection_law_witness_note: String = "Planted controls for gunbc.namespace_clause_e_projection_law assess_controlled_two_mention_provenance_projection. Each NamespaceClauseEProjectionFailure variant is exercised on a hand-built ReferenceDerivedClauseEProductionReady carrier using the full projection fields. B2 row-closure over OrdinaryLoadedCompilationClosure is excluded from this witness file."

fn contract_witness_consumer_file() -> std.types.FilePath {
  "app/consumer.dag"
}

fn contract_witness_provider_file() -> std.types.FilePath {
  "app/provider.dag"
}

fn contract_witness_ref_one() -> std.occurrence_identity.OccurrenceId {
  std.occurrence_identity.OccurrenceId { value: 200 }
}

fn contract_witness_ref_two() -> std.occurrence_identity.OccurrenceId {
  std.occurrence_identity.OccurrenceId { value: 201 }
}

fn contract_witness_declaration() -> std.occurrence_identity.OccurrenceId {
  std.occurrence_identity.OccurrenceId { value: 300 }
}

fn contract_witness_declaration_alt() -> std.occurrence_identity.OccurrenceId {
  std.occurrence_identity.OccurrenceId { value: 301 }
}

fn contract_witness_provenance(
  reference_occurrence: std.occurrence_identity.OccurrenceId,
  declaration_occurrence: std.occurrence_identity.OccurrenceId,
) -> std.occurrence_binding_candidates.CrossFileBindingProvenance {
  std.occurrence_binding_candidates.CrossFileBindingProvenance {
    reference_occurrence: reference_occurrence,
    declaration_occurrence: declaration_occurrence,
    consumer_file: contract_witness_consumer_file(),
    provider_file: contract_witness_provider_file(),
  }
}

fn contract_witness_provider(
  reference_occurrence: std.occurrence_identity.OccurrenceId,
  declaration_occurrence: std.occurrence_identity.OccurrenceId,
) -> std.occurrence_binding_candidates.BoundReferenceProvider {
  std.occurrence_binding_candidates.BoundReferenceProvider {
    reference_occurrence: reference_occurrence,
    declaration_occurrence: declaration_occurrence,
    consumer_module: "app.consumer",
    provider_module: "app.provider",
  }
}

fn contract_witness_file_dependency() -> std.occurrence_binding_candidates.DirectFileDependency {
  std.occurrence_binding_candidates.DirectFileDependency {
    consumer_file: contract_witness_consumer_file(),
    provider_file: contract_witness_provider_file(),
  }
}

fn contract_witness_production(
  provenances: List<std.occurrence_binding_candidates.CrossFileBindingProvenance>,
  dependencies: List<std.occurrence_binding_candidates.DirectFileDependency>,
  providers: List<std.occurrence_binding_candidates.BoundReferenceProvider>,
) -> std.occurrence_binding_candidates.ReferenceDerivedClauseEProduction {
  std.occurrence_binding_candidates.ReferenceDerivedClauseEProductionReady {
    projection: std.occurrence_binding_candidates.ReferenceDerivedDependencyProjectionReady {
      binding_provenance: provenances,
      file_dependencies: dependencies,
      bound_population: std.occurrence_binding_candidates.AllReferencesBound { providers: providers },
    },
    consumer_file: contract_witness_consumer_file(),
  }
}

fn contract_witness_controlled_production() -> std.occurrence_binding_candidates.ReferenceDerivedClauseEProduction {
  contract_witness_production(
    provenances: [
      contract_witness_provenance(
        reference_occurrence: contract_witness_ref_one(),
        declaration_occurrence: contract_witness_declaration(),
      ),
      contract_witness_provenance(
        reference_occurrence: contract_witness_ref_two(),
        declaration_occurrence: contract_witness_declaration(),
      ),
    ],
    dependencies: [contract_witness_file_dependency()],
    providers: [
      contract_witness_provider(
        reference_occurrence: contract_witness_ref_one(),
        declaration_occurrence: contract_witness_declaration(),
      ),
      contract_witness_provider(
        reference_occurrence: contract_witness_ref_two(),
        declaration_occurrence: contract_witness_declaration(),
      ),
    ],
  )
}

test fn witness_substrate_establishes_controlled_scenario() -> Bool {
  match assess_controlled_two_mention_provenance_projection(
    production: contract_witness_controlled_production(),
  ) {
    NamespaceClauseEProjectionEstablished => true
    _ => false
  }
}

test fn witness_substrate_refuses_one_mention_only() -> Bool {
  match assess_controlled_two_mention_provenance_projection(
    production: contract_witness_production(
      provenances: [
        contract_witness_provenance(
          reference_occurrence: contract_witness_ref_one(),
          declaration_occurrence: contract_witness_declaration(),
        ),
      ],
      dependencies: [contract_witness_file_dependency()],
      providers: [
        contract_witness_provider(
          reference_occurrence: contract_witness_ref_one(),
          declaration_occurrence: contract_witness_declaration(),
        ),
      ],
    ),
  ) {
    NamespaceClauseEProjectionRefused {
      failure: BindingProvenanceCountWrong { expected: 2, found: 1 },
    } => true
    _ => false
  }
}

test fn witness_substrate_refuses_two_declarations_same_provider_file() -> Bool {
  match assess_controlled_two_mention_provenance_projection(
    production: contract_witness_production(
      provenances: [
        contract_witness_provenance(
          reference_occurrence: contract_witness_ref_one(),
          declaration_occurrence: contract_witness_declaration(),
        ),
        contract_witness_provenance(
          reference_occurrence: contract_witness_ref_two(),
          declaration_occurrence: contract_witness_declaration_alt(),
        ),
      ],
      dependencies: [contract_witness_file_dependency()],
      providers: [
        contract_witness_provider(
          reference_occurrence: contract_witness_ref_one(),
          declaration_occurrence: contract_witness_declaration(),
        ),
        contract_witness_provider(
          reference_occurrence: contract_witness_ref_two(),
          declaration_occurrence: contract_witness_declaration_alt(),
        ),
      ],
    ),
  ) {
    NamespaceClauseEProjectionRefused {
      failure: DeclarationOccurrencesNotShared,
    } => true
    _ => false
  }
}

test fn witness_substrate_refuses_duplicate_reference_occurrence() -> Bool {
  match assess_controlled_two_mention_provenance_projection(
    production: contract_witness_production(
      provenances: [
        contract_witness_provenance(
          reference_occurrence: contract_witness_ref_one(),
          declaration_occurrence: contract_witness_declaration(),
        ),
        contract_witness_provenance(
          reference_occurrence: contract_witness_ref_one(),
          declaration_occurrence: contract_witness_declaration(),
        ),
      ],
      dependencies: [contract_witness_file_dependency()],
      providers: [
        contract_witness_provider(
          reference_occurrence: contract_witness_ref_one(),
          declaration_occurrence: contract_witness_declaration(),
        ),
        contract_witness_provider(
          reference_occurrence: contract_witness_ref_one(),
          declaration_occurrence: contract_witness_declaration(),
        ),
      ],
    ),
  ) {
    NamespaceClauseEProjectionRefused {
      failure: ReferenceOccurrencesNotDistinct,
    } => true
    _ => false
  }
}

test fn witness_substrate_refuses_two_file_dependencies() -> Bool {
  match assess_controlled_two_mention_provenance_projection(
    production: contract_witness_production(
      provenances: [
        contract_witness_provenance(
          reference_occurrence: contract_witness_ref_one(),
          declaration_occurrence: contract_witness_declaration(),
        ),
        contract_witness_provenance(
          reference_occurrence: contract_witness_ref_two(),
          declaration_occurrence: contract_witness_declaration(),
        ),
      ],
      dependencies: [
        contract_witness_file_dependency(),
        std.occurrence_binding_candidates.DirectFileDependency {
          consumer_file: contract_witness_consumer_file(),
          provider_file: "app/other_provider.dag",
        },
      ],
      providers: [
        contract_witness_provider(
          reference_occurrence: contract_witness_ref_one(),
          declaration_occurrence: contract_witness_declaration(),
        ),
        contract_witness_provider(
          reference_occurrence: contract_witness_ref_two(),
          declaration_occurrence: contract_witness_declaration(),
        ),
      ],
    ),
  ) {
    NamespaceClauseEProjectionRefused {
      failure: FileDependencyCountWrong { expected: 1, found: 2 },
    } => true
    _ => false
  }
}

test fn witness_substrate_refuses_changed_declaration_identity_in_bound_population() -> Bool {
  match assess_controlled_two_mention_provenance_projection(
    production: contract_witness_production(
      provenances: [
        contract_witness_provenance(
          reference_occurrence: contract_witness_ref_one(),
          declaration_occurrence: contract_witness_declaration(),
        ),
        contract_witness_provenance(
          reference_occurrence: contract_witness_ref_two(),
          declaration_occurrence: contract_witness_declaration(),
        ),
      ],
      dependencies: [contract_witness_file_dependency()],
      providers: [
        contract_witness_provider(
          reference_occurrence: contract_witness_ref_one(),
          declaration_occurrence: contract_witness_declaration(),
        ),
        contract_witness_provider(
          reference_occurrence: contract_witness_ref_two(),
          declaration_occurrence: contract_witness_declaration_alt(),
        ),
      ],
    ),
  ) {
    NamespaceClauseEProjectionRefused {
      failure: BoundPopulationInconsistentWithProvenance,
    } => true
    _ => false
  }
}

test fn witness_substrate_refuses_projection_inconsistent_with_bound_population() -> Bool {
  match assess_controlled_two_mention_provenance_projection(
    production: contract_witness_production(
      provenances: [
        contract_witness_provenance(
          reference_occurrence: contract_witness_ref_one(),
          declaration_occurrence: contract_witness_declaration(),
        ),
        contract_witness_provenance(
          reference_occurrence: contract_witness_ref_two(),
          declaration_occurrence: contract_witness_declaration(),
        ),
      ],
      dependencies: [
        std.occurrence_binding_candidates.DirectFileDependency {
          consumer_file: contract_witness_consumer_file(),
          provider_file: "app/wrong_provider.dag",
        },
      ],
      providers: [
        contract_witness_provider(
          reference_occurrence: contract_witness_ref_one(),
          declaration_occurrence: contract_witness_declaration(),
        ),
        contract_witness_provider(
          reference_occurrence: contract_witness_ref_two(),
          declaration_occurrence: contract_witness_declaration(),
        ),
      ],
    ),
  ) {
    NamespaceClauseEProjectionRefused {
      failure: ProvenanceProjectionInconsistent,
    } => true
    _ => false
  }
}

test fn witness_substrate_refuses_reference_population_refused() -> Bool {
  match assess_controlled_two_mention_provenance_projection(
    production: std.occurrence_binding_candidates.ReferenceDerivedClauseEProductionReady {
      projection: std.occurrence_binding_candidates.ReferenceDerivedDependencyProjectionReady {
        binding_provenance: [
          contract_witness_provenance(
            reference_occurrence: contract_witness_ref_one(),
            declaration_occurrence: contract_witness_declaration(),
          ),
          contract_witness_provenance(
            reference_occurrence: contract_witness_ref_two(),
            declaration_occurrence: contract_witness_declaration(),
          ),
        ],
        file_dependencies: [contract_witness_file_dependency()],
        bound_population: std.occurrence_binding_candidates.ReferencePopulationRefused {
          first_failure: std.occurrence_binding_candidates.ReferenceBindingProjectionUnbound {
            occurrence: std.occurrence_identity.OccurrenceId { value: 99 },
          },
          more_failures: [],
        },
      },
      consumer_file: contract_witness_consumer_file(),
    },
  ) {
    NamespaceClauseEProjectionRefused {
      failure: ProjectionBindingRefused { population: _ },
    } => true
    _ => false
  }
}

test fn witness_substrate_refuses_file_path_missing() -> Bool {
  match assess_controlled_two_mention_provenance_projection(
    production: std.occurrence_binding_candidates.ReferenceDerivedClauseEProductionReady {
      projection: std.occurrence_binding_candidates.ReferenceDerivedDependencyProjectionFileRefused {
        first_failure: std.occurrence_binding_candidates.CrossFileBindingProvenanceProjectionFilePathMissing {
          module_path: "app.missing" as std.types.NonEmptyStr,
        },
        more_failures: [],
      },
      consumer_file: contract_witness_consumer_file(),
    },
  ) {
    NamespaceClauseEProjectionRefused {
      failure: ProjectionFileRefused {
        first_failure: CrossFileBindingProvenanceProjectionFilePathMissing { module_path: _ },
        more_failures: _,
      },
    } => true
    _ => false
  }
}
