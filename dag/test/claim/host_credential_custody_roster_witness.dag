module test.claim.host_credential_custody_roster_witness

// The read-only roster predicate the deploy-artifact gate asks (PR #16587). The gate treats an OIDC
// client-secret file as covered when fleet custody declares it; these controls pin that custody_roster_declares
// answers true for a path the roster declares on that host and false otherwise. It is pure data -- no converge,
// no install, no cycle to gunbc.live_deploy.apply_legs -- so it runs hermetically.

import std.types { Bool }
import gunbc.fleet.fleet_host_identity { operator_host_srv1, operator_host_srv2 }
import gunbc.fleet.host_credential_custody_roster { custody_roster_declares }

// The tracker-web-stage client secret is rostered at /etc/gunbc-oidc/tracker-web-stage-client-secret, on srv1
// only (the row's host_scope is CustodyOnlyOnHost { host: srv1 }). So srv1 declares it.
test fn the_roster_declares_a_rostered_srv1_secret() -> Bool {
  custody_roster_declares(host: operator_host_srv1, path: "/etc/gunbc-oidc/tracker-web-stage-client-secret")
}

// The same path is NOT declared on a host the row does not name: CustodyOnlyOnHost binds it to srv1, so srv2
// does not declare it. This proves the host_scope is honoured, not ignored.
test fn the_roster_does_not_declare_a_single_host_row_on_another_host() -> Bool {
  !custody_roster_declares(host: operator_host_srv2, path: "/etc/gunbc-oidc/tracker-web-stage-client-secret")
}

// A path no roster row carries is not declared on any host.
test fn the_roster_declares_nothing_for_an_unrostered_path() -> Bool {
  !custody_roster_declares(host: operator_host_srv1, path: "/etc/gunbc-oidc/not-a-rostered-secret")
}
