module test.claim.served_surface_browser_observation_witness

import std.types { NonEmptyStr }
import std.measure { byte_size }
import extdeps.browser.chromium {
  ChromiumErrConnectionRefused,
  ChromiumErrHttpResponseCodeFailure,
  ChromiumWebDataErrorDocument,
  ChromiumWebDataErrorUrl,
  ChromiumSourceRevisionUnobserved,
  chromium_151_0_7922_34,
}
import extdeps.automation.playwright {
  PlaywrightManagedChromiumDownload,
  playwright_1_62_1,
}
import gunbc.served_surface_browser_observation {
  ConnectionRefusedSpecimen,
  EmptyBody502Specimen,
  SentinelBody502Specimen,
  TcpConnectionRefusedStimulus,
  HttpResponseStimulus,
  EmptyNavigationResponseBody,
  Utf8NavigationResponseBody,
  LocalSyntheticHarness,
  ChromiumNavigationFailed,
  NavigationReturnedHttpResponse,
  ChromiumInternalPresentedDocument,
  NetworkResponsePresentedDocument,
  ExactSpecimenCoverage,
  ExplicitReload,
  HealthyResponseDocumentObserved,
  PlaywrightDefaultChromiumLaunch,
  playwright_chromium_151_linux_arm64_headless_navigation_run,
  local_http_url,
  navigation_specimen_coverage,
}

test fn witness_run_owns_one_execution_identity() -> Bool {
  let run = playwright_chromium_151_linux_arm64_headless_navigation_run
  run.environment.chromium_build == chromium_151_0_7922_34
    && run.environment.chromium_build.source_identity == ChromiumSourceRevisionUnobserved
    && run.environment.playwright_build == playwright_1_62_1
    && run.environment.browser_binary_provenance == PlaywrightManagedChromiumDownload
    && match run.environment.launch_configuration {
      PlaywrightDefaultChromiumLaunch { executable_path: _ } => true
    }
    && count(run.specimens) == 3
}

test fn witness_connection_refusal_is_exact_specimen() -> Bool {
  let specimen = playwright_chromium_151_linux_arm64_headless_navigation_run.specimens.first()
  specimen.id == ConnectionRefusedSpecimen
    && match specimen.stimulus {
      TcpConnectionRefusedStimulus { requested_url: _, origin } => origin == LocalSyntheticHarness
      _ => false
    }
    && specimen.navigation == ChromiumNavigationFailed { error: ChromiumErrConnectionRefused }
    && specimen.document == ChromiumInternalPresentedDocument {
      document: ChromiumWebDataErrorDocument,
      final_url: ChromiumWebDataErrorUrl,
    }
}

test fn witness_empty_502_is_exact_not_total_profile() -> Bool {
  let specimen = playwright_chromium_151_linux_arm64_headless_navigation_run.specimens.skip(n: 1).first()
  specimen.id == EmptyBody502Specimen
    && navigation_specimen_coverage(specimen: specimen) == ExactSpecimenCoverage {
      specimen: EmptyBody502Specimen,
    }
    && match specimen.stimulus {
      HttpResponseStimulus { requested_url: _, origin, status, configured_headers: _, body } =>
        origin == LocalSyntheticHarness && status == 502 && body == EmptyNavigationResponseBody
      _ => false
    }
    && specimen.navigation == ChromiumNavigationFailed { error: ChromiumErrHttpResponseCodeFailure }
}

test fn witness_bodied_502_retains_network_document() -> Bool {
  let specimen = playwright_chromium_151_linux_arm64_headless_navigation_run.specimens.skip(n: 2).first()
  specimen.id == SentinelBody502Specimen
    && match specimen.stimulus {
      HttpResponseStimulus { requested_url: _, origin, status, configured_headers: _, body } =>
        origin == LocalSyntheticHarness && status == 502 && body == Utf8NavigationResponseBody {
          text: "GUNBC_TYPED_ERROR_SENTINEL",
          bytes: byte_size(26),
        }
      _ => false
    }
    && specimen.navigation == NavigationReturnedHttpResponse { status: 502 }
    && specimen.document == NetworkResponsePresentedDocument {
      final_url: local_http_url(locator: "127.0.0.1:43821/body" as NonEmptyStr),
      response_specimen: SentinelBody502Specimen,
    }
}

test fn witness_reload_trial_claims_sufficiency_not_necessity() -> Bool {
  let specimen = playwright_chromium_151_linux_arm64_headless_navigation_run.specimens.first()
  let trial = specimen.recovery_trials.first()
  trial.action == ExplicitReload
    && trial.outcome == HealthyResponseDocumentObserved
}
