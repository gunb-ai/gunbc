module test.claim.served_surface_browser_observation_witness


test fn witness_run_owns_one_execution_identity() -> Bool {
  let run = playwright_chromium_151_linux_arm64_headless_navigation_run
  let environment = run.environment
  environment.chromium_build == extdeps.browser.chromium.chromium_151_0_7922_34
    && environment.chromium_build.source_identity == ChromiumSourceRevisionUnobserved
    && environment.playwright_build == extdeps.automation.playwright.playwright_1_62_1
    && environment.browser_binary_provenance == PlaywrightManagedChromiumDownload
    && environment.container_userland == Debian12Bookworm
    && environment.container_visible_host_kernel == gunbc.served_surface_browser_observation.ContainerVisibleHostKernel {
      visible_release: "6.8.0-124-generic" as gunbc.served_surface_browser_observation.LinuxKernelRelease,
    }
    && environment.architecture == extdeps.toolchain.types.Aarch64
    && environment.presentation_mode == HeadlessPresentation
    && environment.launch_configuration == gunbc.served_surface_browser_observation.PlaywrightDefaultChromiumLaunch {
      executable_path: "/session-home/.cache/ms-playwright/chromium-1234/chrome-linux/chrome" as std.types.FilePath,
    }
    && run.observed_on == "2026-08-01T04:58:15Z" as extdeps.time.rfc3339.Rfc3339Timestamp
}

test fn witness_connection_refusal_is_exact_specimen() -> Bool {
  let observation = playwright_chromium_151_linux_arm64_headless_navigation_run.specimens.connection_refused
  let presentation = connection_refused_presentation(specimen: observation)
  match presentation.stimulus {
    TcpConnectionRefusedStimulus { requested_url: _, origin } => origin == LocalSyntheticHarness
    _ => false
  }
    && presentation.navigation == gunbc.served_surface_browser_observation.ChromiumNavigationFailed { error: ChromiumErrConnectionRefused }
    && presentation.document == gunbc.served_surface_browser_observation.ChromiumInternalPresentedDocument {
      document: ChromiumWebDataErrorDocument,
      final_url: ChromiumWebDataErrorUrl,
    }
}

test fn witness_empty_502_is_exact_not_total_profile() -> Bool {
  let observation = playwright_chromium_151_linux_arm64_headless_navigation_run.specimens.empty_502
  let presentation = empty_body_502_presentation(specimen: observation)
  match presentation.stimulus {
    HttpResponseStimulus { requested_url: _, origin, status, configured_headers, body } =>
      origin == LocalSyntheticHarness
        && status == 502
        && configured_headers == [
          gunbc.served_surface_browser_observation.ContentLengthHeader { bytes: byte_size(0) },
          Empty502SpecimenHeader,
        ]
        && body == EmptyNavigationResponseBody
    _ => false
  }
    && presentation.navigation == gunbc.served_surface_browser_observation.ChromiumNavigationFailed { error: ChromiumErrHttpResponseCodeFailure }
    && presentation.document == gunbc.served_surface_browser_observation.ChromiumInternalPresentedDocument {
      document: ChromiumWebDataErrorDocument,
      final_url: ChromiumWebDataErrorUrl,
    }
}

test fn witness_bodied_502_retains_network_document() -> Bool {
  let observation = playwright_chromium_151_linux_arm64_headless_navigation_run.specimens.sentinel_502
  let presentation = sentinel_body_502_presentation(specimen: observation)
  match presentation.stimulus {
    HttpResponseStimulus { requested_url: _, origin, status, configured_headers, body } =>
      origin == LocalSyntheticHarness
        && status == 502
        && configured_headers == [
          gunbc.served_surface_browser_observation.ContentLengthHeader { bytes: byte_size(26) },
          TextPlainUtf8ContentTypeHeader,
          Sentinel502SpecimenHeader,
        ]
        && body == gunbc.served_surface_browser_observation.Utf8NavigationResponseBody {
          text: "GUNBC_TYPED_ERROR_SENTINEL",
          bytes: byte_size(26),
        }
    _ => false
  }
    && presentation.navigation == gunbc.served_surface_browser_observation.NavigationReturnedHttpResponse { status: 502 }
    && presentation.document == gunbc.served_surface_browser_observation.NetworkResponsePresentedDocument {
      final_url: local_http_url(locator: "127.0.0.1:43821/body" as std.types.NonEmptyStr),
    }
}

test fn witness_reload_trial_claims_sufficiency_not_necessity() -> Bool {
  let observation = playwright_chromium_151_linux_arm64_headless_navigation_run.specimens.connection_refused
  let trial = observation.recovery_trials.first()
  trial.action == ExplicitReload
    && trial.outcome == HealthyResponseDocumentObserved
}
