data nested_container_source: String = "module probe_alias_nested_container\nimport std.types { Int, Bool }\ntype Boxed<T> { v: T }\ntype IntBox = Boxed<Int>\nfn p(b: List<List<Boxed<Int>>>) -> List<List<IntBox>> { b }\n"

