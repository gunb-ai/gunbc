module test.claim.alias_identity_every_check_witness

import gunbc.compile_diagnostic_census {
  CompileDiagnosticCensus,
  CensusObserved,
  CensusNotRunnable,
  census_rows_of_class,
  census_total_count
}
import std.types { String, Bool, Int }
import std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// ONE alias/expansion pair (`IntBox = Boxed<Int>` against `Boxed<Int>`) pushed through every check that
// compares types. Each arm must accept: the alias IS its expansion (DESIGN 4: identity by resolved
// declaration). A refusing arm names a site that still decides alias identity by spelling.
// gunbc.recurring_failure_mode a_rule_is_applied_at_the_site_that_prompted_it_and_not_its_sibling.
fn refusal_count(source: String) -> Int {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: rows } => census_total_count(rows: census_rows_of_class(rows: rows, wanted: "TypeMismatch"))
      + census_total_count(rows: census_rows_of_class(rows: rows, wanted: "DeclaredTypeNotInhabited"))
      + census_total_count(rows: census_rows_of_class(rows: rows, wanted: "InternalError"))
    CensusNotRunnable { cause: _ } => 0 - 1
  }
}

data if_source: String = "module probe_alias_if\nimport std.types { Int, Bool }\ntype Boxed<T> { v: T }\ntype IntBox = Boxed<Int>\nfn p(c: Bool, a: IntBox, b: Boxed<Int>) -> Boxed<Int> { if c { a } else { b } }\n"

test fn w_alias_and_expansion_agree_at_if() -> Bool {
  refusal_count(source: if_source) == 0
}

data match_arm_source: String = "module probe_alias_match_arm\nimport std.types { Int, Bool }\ntype Boxed<T> { v: T }\ntype IntBox = Boxed<Int>\nfn p(c: Bool, a: IntBox, b: Boxed<Int>) -> Boxed<Int> { match c { true => a\n false => b } }\n"

test fn w_alias_and_expansion_agree_at_match_arm() -> Bool {
  refusal_count(source: match_arm_source) == 0
}

data argument_source: String = "module probe_alias_argument\nimport std.types { Int, Bool }\ntype Boxed<T> { v: T }\ntype IntBox = Boxed<Int>\nfn take(x: IntBox) -> Int { x.v }\nfn p(b: Boxed<Int>) -> Int { take(x: b) }\n"

test fn w_alias_and_expansion_agree_at_argument() -> Bool {
  refusal_count(source: argument_source) == 0
}

data record_field_source: String = "module probe_alias_record_field\nimport std.types { Int, Bool }\ntype Boxed<T> { v: T }\ntype IntBox = Boxed<Int>\ntype R { f: IntBox }\nfn p(b: Boxed<Int>) -> R { R { f: b } }\n"

test fn w_alias_and_expansion_agree_at_record_field() -> Bool {
  refusal_count(source: record_field_source) == 0
}

data return_source: String = "module probe_alias_return\nimport std.types { Int, Bool }\ntype Boxed<T> { v: T }\ntype IntBox = Boxed<Int>\nfn p(b: Boxed<Int>) -> IntBox { b }\n"

test fn w_alias_and_expansion_agree_at_return() -> Bool {
  refusal_count(source: return_source) == 0
}

