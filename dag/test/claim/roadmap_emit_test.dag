module test.claim.roadmap_emit

import extdeps.languages.markdown { serialize_markdown_source }
import gunbc.roadmap_emit { project_roadmap_section }
import gunbc.roadmap_model { RoadmapNodeId, RoadmapNode, RoadmapEdge, Pointer, NodeSizing, Unsized, SectionElement, section_group }
import gunbc.roadmap_status { RoadmapItem, DerivableLine, AuthoredLine, SupersededLine, Signoff, Unsigned, SignedOff }
import gunbc.roadmap_execution_contract { ExecutionContractUnspecified }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data parent_id: RoadmapNodeId = "invert-hand-maintained"
data child_id: RoadmapNodeId = "pr-checkbox-status"

fn parent_node() -> RoadmapNode {
  RoadmapNode {
    node: parent_id,
    line: AuthoredLine { done: false, content: "**invert hand-maintained**" },
    carriers: [Pointer { label: "plan", path: "docs/plans/invert-hand-maintained.md" }],
    sizing: Unsized,
    execution: ExecutionContractUnspecified,
    owner: "",
    signoff: Unsigned,
  }
}

fn child_node() -> RoadmapNode {
  RoadmapNode {
    node: child_id,
    line: DerivableLine { prs: [5491], title: "**PR-checkbox status**", description: "" },
    carriers: [],
    sizing: Unsized,
    execution: ExecutionContractUnspecified,
    owner: "",
    signoff: Unsigned,
  }
}

fn signed_child_node() -> RoadmapNode {
  RoadmapNode {
    node: child_id,
    line: DerivableLine { prs: [5491], title: "**PR-checkbox status**", description: "" },
    carriers: [],
    sizing: Unsized,
    execution: ExecutionContractUnspecified,
    owner: "",
    signoff: SignedOff { by: "operator", works: true, scope_equivalent: true, as_expected: true },
  }
}

fn nodes() -> List<RoadmapNode> { [parent_node(), child_node()] }
fn edges() -> List<RoadmapEdge> { [RoadmapEdge { child: child_id, parent: parent_id }] }

fn emit_nodes(nodes: List<RoadmapNode>, merged: List<Int>) -> String {
  serialize_markdown_source(doc: project_roadmap_section(
    title: "6. Expansion", elements: [section_group(label: "", nodes: nodes, edges: edges())], merged: merged,
  ))
}

fn emit(merged: List<Int>) -> String {
  emit_nodes(nodes: nodes(), merged: merged)
}

test fn witness_heading() -> Bool {
  string_contains(s: emit(merged: [5491]), pattern: "## 6. Expansion")
}

test fn witness_parent_authored_box_and_link() -> Bool {
  let out = emit(merged: [5491])
  string_contains(s: out, pattern: "- [ ] **invert hand-maintained**")
    && string_contains(s: out, pattern: "[plan](docs/plans/invert-hand-maintained.md)")
}

test fn witness_child_merged_unsigned_awaiting_signoff() -> Bool {
  let out = emit(merged: [5491])
  string_contains(s: out, pattern: "[ ] **PR-checkbox status**")
    && string_contains(s: out, pattern: "⏳ awaiting sign-off")
    && !string_contains(s: out, pattern: "[x] **PR-checkbox status**")
}

test fn witness_child_signed_checked() -> Bool {
  let out = emit_nodes(nodes: [parent_node(), signed_child_node()], merged: [])
  string_contains(s: out, pattern: "[x] **PR-checkbox status**")
    && string_contains(s: out, pattern: "✓ signed off: operator")
}

test fn witness_child_derived_unchecked_when_unmerged() -> Bool {
  let out = emit(merged: [])
  string_contains(s: out, pattern: "[ ] **PR-checkbox status**")
    && !string_contains(s: out, pattern: "[x] **PR-checkbox status**")
    && !string_contains(s: out, pattern: "⏳ awaiting sign-off")
}

fn superseded_child_node() -> RoadmapNode {
  RoadmapNode {
    node: child_id,
    line: SupersededLine { by: "successor-lane", content: "**PR-checkbox status**" },
    carriers: [],
    sizing: Unsized,
    execution: ExecutionContractUnspecified,
    owner: "",
    signoff: Unsigned,
  }
}

test fn witness_superseded_checked_struck_no_signoff_suffix() -> Bool {
  let out = emit_nodes(nodes: [parent_node(), superseded_child_node()], merged: [])
  string_contains(s: out, pattern: "[x] ~~**PR-checkbox status**~~ **superseded →** successor-lane")
    && !string_contains(s: out, pattern: "⏳ awaiting sign-off")
}
