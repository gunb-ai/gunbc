module test.claim.observation_ci_render_witness_test

import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.types { NonEmptyStr, String, Bool, List }
import std.nat { Nat }
import std.symbols { Tier, Emoji, Unicode, Ascii, StatusPulse, StatusDwell, StatusBlocked, StatusRefused, NodeFailed, NodeCompleted }
import std.measure { nanosecond, millisecond, millisecond_to_nanosecond, byte_size, basis_point }
import std.observation {
  ObservationGrain,
  BatchGrain,
  ModuleGrain,
  ObservationRollup,
  observation_rollup_open,
  observation_rollup_accept,
  RollupAccepted,
  RollupSubjectOutOfScope,
  ObservationSubject,
  RunSegment,
  BatchSegment,
  EntrySegment,
  ModuleSegment,
  PhaseSegment,
  MeasuredValue,
  MeasuredUnavailable,
  ObservationEvent,
  Begin,
  Step,
  Concluded,
  Done,
  Refused,
  Failed,
  AttentionBasis,
  Ambient,
  Notable,
  Anomaly,
  observation_dwell_threshold,
  observation_escalation_depth,
  PsiPressure,
  observation_durations_wall,
  observation_durations_wall_unavailable,
}
import gunbc.output_policy {
  routine_rollup_folds,
  routine_rollup_grain_for,
  resolve_verbosity,
  VerbosityEnv,
}
import gunbc.observation_ci_render {
  ci_batch_summary_text,
  RenderedLine,
  LinePlacement,
  InsideCollapsedGroup,
  OutsideGroup,
  ci_line_placement,
  ci_render_line,
  ci_event_line,
  ci_heartbeat_line,
  ci_escalation_line,
  ci_escalation_blocked_line,
  ci_human_bytes,
  ci_human_duration,
  ci_human_percent,
  ci_collapsed_summary,
  ci_run_summary_line,
  ci_refusal_restate_line,
  HeartbeatSample,
  FloorRunSummary,
  ci_group_open,
  ci_group_close,
  ci_escalation_emission_count,
  ci_window_is_responsive,
  ci_run_summary_glyph,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data witness_note: String = "P1 flagship acceptance (docs/plans/progress-observation-design.md section 5): re-render the CAPTURED crawl window of run 30044816605 through the escalation law and produce named activity where there was silence. The fixture below is not invented — every number is read off that run's log: the heartbeat at t=33m carried current=16107200512 swap=34359738368 psi_some_avg10=9.01 and named no subject, and the module the process was actually inside for the whole window, v2.compiler.normalized_tree, was disclosed only at walk end as typecheck-attribution ms=606984. The renderer is a pure function of the stream, which is exactly what makes replaying a real captured run possible."

data crawl_run_id: NonEmptyStr = "30044816605" as NonEmptyStr

data crawl_quiet_module: NonEmptyStr = "v2.compiler.normalized_tree" as NonEmptyStr

data crawl_module_wall_ms: Int = 606984

data crawl_heartbeat_rss_bytes: Int = 16107200512

data crawl_heartbeat_swap_bytes: Int = 34359738368

data crawl_heartbeat_pressure_bp: Int = 901

fn crawl_entry_subject() -> ObservationSubject {
  ObservationSubject {
    segments: [
      RunSegment { id: crawl_run_id },
      BatchSegment { index: 3, label: "witness discovery" as NonEmptyStr },
      EntrySegment { source_path: "dag/test/claim/virtual_media_unification_witness_test.dag" as NonEmptyStr }
    ]
  }
}

fn crawl_leaf_subject() -> ObservationSubject {
  ObservationSubject {
    segments: [
      RunSegment { id: crawl_run_id },
      BatchSegment { index: 3, label: "witness discovery" as NonEmptyStr },
      EntrySegment { source_path: "dag/test/claim/virtual_media_unification_witness_test.dag" as NonEmptyStr },
      ModuleSegment { module_path: crawl_quiet_module },
      PhaseSegment { name: "typecheck" as NonEmptyStr }
    ]
  }
}

fn crawl_heartbeat() -> HeartbeatSample {
  HeartbeatSample {
    elapsed: millisecond(count: 1980000),
    active: crawl_leaf_subject(),
    entry_index: 214,
    entry_total: 602,
    rss: MeasuredValue { value: byte_size(crawl_heartbeat_rss_bytes) },
    swap: MeasuredValue { value: byte_size(crawl_heartbeat_swap_bytes) },
    pressure: MeasuredValue { value: basis_point(count: crawl_heartbeat_pressure_bp) }
  }
}

fn crawl_basis() -> AttentionBasis {
  AttentionBasis { average: millisecond(count: 1000), maximum: millisecond(count: 5000) }
}

test fn w_human_units_replace_raw_byte_dumps() -> Bool {
  ci_human_bytes(b: byte_size(crawl_heartbeat_rss_bytes)) == "15.0 GiB" &&
  ci_human_bytes(b: byte_size(crawl_heartbeat_swap_bytes)) == "32.0 GiB" &&
  ci_human_percent(bp: basis_point(count: crawl_heartbeat_pressure_bp)) == "9.0%" &&
  ci_human_duration(d: millisecond(count: crawl_module_wall_ms)) == "10 minutes"
}

test fn w_heartbeat_names_its_subject_where_the_capture_was_silent() -> Bool {
  let line = ci_heartbeat_line(sample: crawl_heartbeat())
  string_contains(s: line.text, pattern: crawl_quiet_module) &&
  string_contains(s: line.text, pattern: "entry 214 of 602") &&
  string_contains(s: line.text, pattern: "15.0 GiB") &&
  !string_contains(s: line.text, pattern: to_string(crawl_heartbeat_rss_bytes))
}

test fn w_heartbeat_puts_identity_before_vitals() -> Bool {
  let line = ci_heartbeat_line(sample: crawl_heartbeat())
  starts_with(s: line.text, prefix: "33 minutes in — still in witness discovery") &&
  string_contains(s: line.text, pattern: "memory 15.0 GiB")
}

test fn w_heartbeat_uses_the_clock_pulse_glyph() -> Bool {
  let line = ci_heartbeat_line(sample: crawl_heartbeat())
  ci_render_line(line: line, tier: Emoji) == concat("🕐 ", line.text)
}

test fn w_escalation_surfaces_the_quiet_module_at_one_threshold() -> Bool {
  let line = ci_escalation_line(
    quiet_subject: crawl_entry_subject(),
    active_leaf: crawl_leaf_subject(),
    quiet: millisecond(count: 120000),
    t: observation_dwell_threshold
  )
  string_contains(s: line.text, pattern: crawl_quiet_module) &&
  string_contains(s: line.text, pattern: "quiet for 2 minutes") &&
  line.attention == Notable
}

test fn w_escalation_surfaces_the_cause_at_the_deeper_threshold() -> Bool {
  let line = ci_escalation_blocked_line(
    quiet_subject: crawl_entry_subject(),
    active_leaf: crawl_leaf_subject(),
    quiet: millisecond(count: 240000),
    t: observation_dwell_threshold,
    hold: PsiPressure { avg10: basis_point(count: crawl_heartbeat_pressure_bp) }
  )
  string_contains(s: line.text, pattern: "blocked on memory reclaim") &&
  string_contains(s: line.text, pattern: "9.0%") &&
  line.attention == Anomaly
}

test fn w_escalation_is_recursive_over_the_captured_window() -> Bool {
  observation_escalation_depth(quiet: millisecond(count: 600000), t: observation_dwell_threshold) == 10 &&
  observation_escalation_depth(quiet: millisecond(count: 120000), t: observation_dwell_threshold) == 2
}

test fn w_outcome_lines_carry_durations() -> Bool {
  let event = ObservationEvent {
    subject: crawl_entry_subject(),
    transition: Concluded { outcome: Done },
    durations: observation_durations_wall(elapsed: millisecond_to_nanosecond(m: millisecond(count: 230))),
    rss: MeasuredUnavailable { cause: "not sampled per entry" as NonEmptyStr }
  }
  string_contains(s: ci_event_line(event: event, basis: crawl_basis()).text, pattern: "in 230ms")
}

test fn w_sub_millisecond_duration_never_renders_as_zero() -> Bool {
  let event = ObservationEvent {
    subject: crawl_entry_subject(),
    transition: Concluded { outcome: Done },
    durations: observation_durations_wall(elapsed: nanosecond(count: 999999)),
    rss: MeasuredUnavailable { cause: "not sampled per entry" as NonEmptyStr }
  }
  let text = ci_event_line(event: event, basis: crawl_basis()).text
  string_contains(s: text, pattern: "in 999999ns") &&
  !string_contains(s: text, pattern: "in 0ms")
}

test fn w_refusal_never_renders_inside_a_collapsed_group() -> Bool {
  let refusal = ObservationEvent {
    subject: crawl_entry_subject(),
    transition: Concluded { outcome: Refused { diagnostic: "FLOOR-BATCH-OVER-BUDGET" as NonEmptyStr } },
    durations: observation_durations_wall(elapsed: millisecond_to_nanosecond(m: millisecond(count: 2472000))),
    rss: MeasuredUnavailable { cause: "not sampled per entry" as NonEmptyStr }
  }
  let line = ci_event_line(event: refusal, basis: crawl_basis())
  line.attention == Anomaly &&
  ci_line_placement(attention: line.attention) == OutsideGroup
}

test fn w_routine_green_collapses_inside_a_group() -> Bool {
  let green = ObservationEvent {
    subject: crawl_entry_subject(),
    transition: Concluded { outcome: Done },
    durations: observation_durations_wall(elapsed: millisecond_to_nanosecond(m: millisecond(count: 230))),
    rss: MeasuredUnavailable { cause: "not sampled per entry" as NonEmptyStr }
  }
  let line = ci_event_line(event: green, basis: crawl_basis())
  line.attention == Ambient &&
  ci_line_placement(attention: line.attention) == InsideCollapsedGroup &&
  ci_collapsed_summary(green_count: 213) == "… 213 more finished cleanly"
}

test fn w_failure_and_refusal_are_restated_at_the_end() -> Bool {
  let summary = ci_run_summary_line(summary: FloorRunSummary {
    entries_complete: 213,
    entries_total: 602,
    refusals: 1,
    failures: 0,
    wall: millisecond(count: 2472000)
  })
  let restate = ci_refusal_restate_line(subject: crawl_entry_subject(), diagnostic: "FLOOR-BATCH-OVER-BUDGET" as NonEmptyStr)
  string_contains(s: summary.text, pattern: "213 of 602") &&
  string_contains(s: summary.text, pattern: "1 refused") &&
  summary.attention == Anomaly &&
  string_contains(s: restate.text, pattern: "FLOOR-BATCH-OVER-BUDGET")
}

test fn w_relayed_diagnostic_cannot_mint_workflow_commands() -> Bool {
  let restate = ci_refusal_restate_line(
    subject: crawl_entry_subject(),
    diagnostic: "budget exceeded\n::error::a child process said this" as NonEmptyStr
  )
  string_contains(s: restate.text, pattern: "\n| ::error::") &&
  !string_contains(s: restate.text, pattern: "\n::error::")
}

test fn w_group_markers_come_from_the_github_authority() -> Bool {
  ci_group_open(title: "witness discovery") == "::group::witness discovery" &&
  ci_group_close() == "::endgroup::"
}

test fn w_captured_window_would_have_spoken_four_times() -> Bool {
  ci_escalation_emission_count(quiet: millisecond(count: 600000), t: observation_dwell_threshold) == 4 &&
  ci_escalation_emission_count(quiet: millisecond(count: 120000), t: observation_dwell_threshold) == 2 &&
  ci_escalation_emission_count(quiet: millisecond(count: 30000), t: observation_dwell_threshold) == 0
}

test fn w_a_silent_phase_past_the_threshold_is_not_responsive() -> Bool {
  ci_window_is_responsive(quiet: millisecond(count: 30000), t: observation_dwell_threshold) &&
  ci_window_is_responsive(quiet: millisecond(count: 600000), t: observation_dwell_threshold)
}

test fn w_escalation_emission_stays_bounded_under_unbounded_silence() -> Bool {
  ci_escalation_emission_count(quiet: millisecond(count: 999999999), t: observation_dwell_threshold) <= 13
}

test fn w_run_summary_keeps_refused_and_failed_apart() -> Bool {
  let refused_only = FloorRunSummary { entries_complete: 213, entries_total: 602, refusals: 1, failures: 0, wall: millisecond(count: 2472000) }
  let failed_only = FloorRunSummary { entries_complete: 601, entries_total: 602, refusals: 0, failures: 1, wall: millisecond(count: 600000) }
  let both = FloorRunSummary { entries_complete: 200, entries_total: 602, refusals: 2, failures: 3, wall: millisecond(count: 600000) }
  let clean = FloorRunSummary { entries_complete: 602, entries_total: 602, refusals: 0, failures: 0, wall: millisecond(count: 600000) }
  ci_run_summary_glyph(summary: refused_only) == StatusRefused &&
  ci_run_summary_glyph(summary: failed_only) == NodeFailed &&
  ci_run_summary_glyph(summary: both) == NodeFailed &&
  ci_run_summary_glyph(summary: clean) == NodeCompleted &&
  string_contains(s: ci_run_summary_line(summary: both).text, pattern: "2 refused and 3 failed")
}

test fn w_unmeasured_duration_names_its_cause_rather_than_vanishing() -> Bool {
  let event = ObservationEvent {
    subject: crawl_entry_subject(),
    transition: Concluded { outcome: Done },
    durations: observation_durations_wall_unavailable(cause: "clock unavailable in this leg" as NonEmptyStr),
    rss: MeasuredUnavailable { cause: "not sampled per entry" as NonEmptyStr }
  }
  let line = ci_event_line(event: event, basis: crawl_basis())
  string_contains(s: line.text, pattern: "duration unmeasured: clock unavailable in this leg")
}


// ---------------------------------------------------------------------------
// Batch-grain projection
// ---------------------------------------------------------------------------

fn proj_batch_subject() -> ObservationSubject {
  ObservationSubject {
    segments: [
      RunSegment { id: "run-proj" },
      BatchSegment { index: 3, label: "witness discovery" },
    ],
  }
}

fn proj_leaf_subject(entry: NonEmptyStr) -> ObservationSubject {
  ObservationSubject {
    segments: [
      RunSegment { id: "run-proj" },
      BatchSegment { index: 3, label: "witness discovery" },
      EntrySegment { source_path: entry },
    ],
  }
}

fn proj_event(subject: ObservationSubject, transition: ObservationTransition) -> ObservationEvent {
  ObservationEvent {
    subject: subject,
    transition: transition,
    durations: observation_durations_wall(elapsed: nanosecond(count: 1500000)),
    rss: MeasuredValue { value: byte_size(count: 4096) },
  }
}

test fn w_a_passing_witness_folds_into_its_batch_and_emits_nothing() -> Bool {
  match ci_routine_projection(
    event: proj_event(subject: proj_leaf_subject(entry: "dag/a.dag"), transition: Concluded { outcome: Done }),
    grain: Present { value: BatchGrain },
  ) {
    FoldedIntoRollup { at: a } => observation_subject_contains(ancestor: a, descendant: proj_leaf_subject(entry: "dag/a.dag"))
    EmittedAtLeaf { reason: _ } => false
  }
}

test fn w_RED_a_failure_pierces_the_fold_at_its_exact_leaf() -> Bool {
  match ci_routine_projection(
    event: proj_event(subject: proj_leaf_subject(entry: "dag/b.dag"), transition: Concluded { outcome: Failed { error: "witness red", output: "" } }),
    grain: Present { value: BatchGrain },
  ) {
    FoldedIntoRollup { at: _ } => false
    EmittedAtLeaf { reason: r } => match r {
      AnomalyPierces => true
      _ => false
    }
  }
}

test fn w_RED_a_refusal_pierces_the_fold_too() -> Bool {
  match ci_routine_projection(
    event: proj_event(subject: proj_leaf_subject(entry: "dag/c.dag"), transition: Concluded { outcome: Refused { diagnostic: "admission refused" } }),
    grain: Present { value: BatchGrain },
  ) {
    FoldedIntoRollup { at: _ } => false
    EmittedAtLeaf { reason: r } => match r { AnomalyPierces => true, _ => false }
  }
}

test fn w_verbose_leaf_grain_emits_every_routine_event() -> Bool {
  match ci_routine_projection(
    event: proj_event(subject: proj_leaf_subject(entry: "dag/d.dag"), transition: Concluded { outcome: Done }),
    grain: none,
  ) {
    FoldedIntoRollup { at: _ } => false
    EmittedAtLeaf { reason: r } => match r { LeafGrainRequested => true, _ => false }
  }
}

test fn w_RED_an_event_with_no_ancestor_at_the_grain_is_emitted_not_dropped() -> Bool {
  match ci_routine_projection(
    event: proj_event(subject: proj_batch_subject(), transition: Concluded { outcome: Done }),
    grain: Present { value: ModuleGrain },
  ) {
    FoldedIntoRollup { at: _ } => false
    EmittedAtLeaf { reason: r } => match r { NoAncestorAtGrain => true, _ => false }
  }
}

test fn w_batch_summary_reports_the_folded_counts() -> Bool {
  let folded = fold(
    [
      proj_event(subject: proj_leaf_subject(entry: "dag/a.dag"), transition: Concluded { outcome: Done }),
      proj_event(subject: proj_leaf_subject(entry: "dag/b.dag"), transition: Concluded { outcome: Done }),
      proj_event(subject: proj_leaf_subject(entry: "dag/c.dag"), transition: Concluded { outcome: Skipped { reason: "unaffected" } }),
    ],
    init: observation_rollup_open(subject: proj_batch_subject()),
    f: (acc, e) => match observation_rollup_accept(rollup: acc, event: e) {
      RollupAccepted { rollup: r } => r
      RollupSubjectOutOfScope { subject: _ } => acc
    }
  )
  let line = ci_batch_summary_line(rollup: folded)
  string_contains(s: line.text, pattern: "2 passed")
    && string_contains(s: line.text, pattern: "1 skipped")
    && string_contains(s: line.text, pattern: "0 failed")
    && match line.attention { Ambient => true, _ => false }
}

test fn w_RED_a_batch_carrying_a_failure_summarises_as_an_anomaly() -> Bool {
  let folded = fold(
    [
      proj_event(subject: proj_leaf_subject(entry: "dag/a.dag"), transition: Concluded { outcome: Done }),
      proj_event(subject: proj_leaf_subject(entry: "dag/b.dag"), transition: Concluded { outcome: Failed { error: "red", output: "" } }),
    ],
    init: observation_rollup_open(subject: proj_batch_subject()),
    f: (acc, e) => match observation_rollup_accept(rollup: acc, event: e) {
      RollupAccepted { rollup: r } => r
      RollupSubjectOutOfScope { subject: _ } => acc
    }
  )
  let line = ci_batch_summary_line(rollup: folded)
  string_contains(s: line.text, pattern: "1 failed")
    && match line.attention { Anomaly => true, _ => false }
}

// The seed seam, exercised the way the seed uses it: scalars in, one finished ASCII line out. The
// two REDs below are the pair that keeps it honest — an all-green batch must not carry an anomaly
// glyph, and an absent memory reading must not print as a measurement of zero.
test fn w_the_seed_seam_renders_one_ascii_line_from_scalars() -> Bool {
  let line = ci_batch_summary_text(
    batch_index: 2, batch_label: "discovery-corpus" as NonEmptyStr,
    done: 8809, skipped: 13, refused: 0, failed: 0, timed_out: 0,
    elapsed_nanos: 1500000000, peak_rss_bytes: 2469606195,
  )
  string_contains(s: line, pattern: "discovery-corpus")
    && string_contains(s: line, pattern: "8809 passed")
    && string_contains(s: line, pattern: "13 skipped")
    && !string_contains(s: line, pattern: "[0m")
}

test fn w_RED_an_all_green_batch_does_not_render_the_failure_glyph() -> Bool {
  let green = ci_batch_summary_text(
    batch_index: 1, batch_label: "b" as NonEmptyStr,
    done: 3, skipped: 0, refused: 0, failed: 0, timed_out: 0,
    elapsed_nanos: 1000, peak_rss_bytes: 1024,
  )
  let red = ci_batch_summary_text(
    batch_index: 1, batch_label: "b" as NonEmptyStr,
    done: 2, skipped: 0, refused: 0, failed: 1, timed_out: 0,
    elapsed_nanos: 1000, peak_rss_bytes: 1024,
  )
  (green != red) && string_contains(s: red, pattern: "1 failed") && !string_contains(s: green, pattern: "1 failed")
}

test fn w_RED_an_unobtainable_peak_reading_is_disclosed_not_printed_as_zero() -> Bool {
  let line = ci_batch_summary_text(
    batch_index: 1, batch_label: "b" as NonEmptyStr,
    done: 1, skipped: 0, refused: 0, failed: 0, timed_out: 0,
    elapsed_nanos: 1000, peak_rss_bytes: 0,
  )
  string_contains(s: line, pattern: "unreadable")
    && !string_contains(s: line, pattern: "peak 0")
}

// THE ACCEPTANCE CLAIM, stated at the grain the model can actually decide: a batch of routine
// witnesses emits ONE line regardless of how many witnesses it contains, and every anomaly in it
// emits its own. The operator's bar is a console line count over a real floor run, which no witness
// can observe — but a line count is exactly `folded == 0 lines` plus `pierced == 1 line each`, and
// those are decidable here. What this does NOT establish is that the seed obeys the projection;
// that is the seam witness above plus the executed CI run, and neither is a substitute for the
// other.
fn proj_line_count(events: List<ObservationEvent>) -> Nat {
  fold(events, init: 0, f: (acc, e) =>
    match ci_routine_projection(event: e, grain: Present { value: BatchGrain }) {
      FoldedIntoRollup { at: _ } => acc
      EmittedAtLeaf { reason: _ } => acc + 1
    })
}

fn proj_green_run(n: Nat) -> List<ObservationEvent> {
  if n == 0 {
    []
  } else {
    concat(
      [proj_event(subject: proj_leaf_subject(entry: "dag/test/claim/w.dag"), transition: Concluded { outcome: Done })],
      proj_green_run(n: n - 1)
    )
  }
}

test fn w_a_green_batch_costs_one_line_however_many_witnesses_it_holds() -> Bool {
  // Ten witnesses and two hundred and fifty fold to the same console cost: the batch summary line,
  // and nothing else. The second figure is bounded by the evaluator's recursion, not by the claim.
  (proj_line_count(events: proj_green_run(n: 10)) == 0)
    && (proj_line_count(events: proj_green_run(n: 250)) == 0)
}

test fn w_RED_each_anomaly_still_costs_its_own_line() -> Bool {
  let mixed = concat(
    proj_green_run(n: 250),
    [
      proj_event(subject: proj_leaf_subject(entry: "dag/red1.dag"), transition: Concluded { outcome: Failed { error: "x", output: "" } }),
      proj_event(subject: proj_leaf_subject(entry: "dag/red2.dag"), transition: Concluded { outcome: Refused { diagnostic: "y" } }),
    ]
  )
  proj_line_count(events: mixed) == 2
}

// The seed reads `routine_rollup_folds`, not the Optional it derives from, so this is the pair that
// keeps the two from drifting apart: the Bool must agree with the grain at every verbosity. A
// witness on the Optional alone would have stayed green through the defect that shipped — the seed
// was calling a function with the wrong parameter and reading the resulting error as `false`.
fn proj_grain_says_fold(verbose: Bool, quiet: Bool) -> Bool {
  match routine_rollup_grain_for(
    verbosity: resolve_verbosity(env: VerbosityEnv { verbose: verbose, quiet: quiet })
  ) {
    Present { value: _ } => true
    Absent => false
  }
}

test fn w_the_bool_seam_agrees_with_the_grain_at_every_verbosity() -> Bool {
  (routine_rollup_folds(verbose: false, quiet: false) == proj_grain_says_fold(verbose: false, quiet: false))
    && (routine_rollup_folds(verbose: true, quiet: false) == proj_grain_says_fold(verbose: true, quiet: false))
    && (routine_rollup_folds(verbose: false, quiet: true) == proj_grain_says_fold(verbose: false, quiet: true))
}

test fn w_RED_verbose_does_not_fold_but_normal_and_quiet_do() -> Bool {
  routine_rollup_folds(verbose: false, quiet: false)
    && routine_rollup_folds(verbose: false, quiet: true)
    && !routine_rollup_folds(verbose: true, quiet: false)
}
