module test.claim.credential_dispatch_probe

import std.types { AuthScheme, Bearer, String, Secret, NonEmptyStr, Int }
import std.optional { Present, Absent }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import std.measure { nanosecond }
import std.nat { Nat, Zero }
import std.checked_arithmetic { checked_int_to_nat }
import std.credentials {
  AcquisitionClockRead, AcquisitionClockObserved, AcquisitionClockUnread, acquisition_clock_reading_of,
  observe_credential_monotonic, CredentialUseRequirement,
}
import std.credential_admission { CredentialPresented, CredentialPresentationRefused }
import extdeps.time.rfc3339 { rfc3339_instant_of_unix }
import extdeps.transports.rest { RestResult, RestAnswered, RestRefused, RestCredentialRefused }
import extdeps.cloud.gcp.iam { GcpImpersonatedAccessCredential, impersonated_access_credential_of, gcp_impersonated_presentation }

// THE DISPATCH BOUNDARY, EXECUTED AGAINST A COUNTING ENDPOINT. Run wet with `gunbc run --entry
// dag/test/claim/credential_dispatch_probe.dag --function <probe>` while a capture server on
// 127.0.0.1:18080 counts requests and records each Authorization header. This is the executing half of
// the presentation boundary: the claim witness (test.claim.credential_validity_witness) judges the
// presentation decision hermetically, and this module counts what actually reaches the wire.
//
// THE ADAPTER OWNS THE OPERATION. echo_with_gcp_credential takes the sealed credential and the
// operation's own argument, presents immediately before invoking the service, and returns the
// service's result. No caller holds a CredentialPresentation (gcp_impersonated_presentation admits only
// adapters), so a retained or reused presentation is not writable outside one; a caller-owned retry
// calls the adapter again and is judged at its own instant. Production adapters arrive with their
// operations (heal publication, P3).

service probe.CredentialEcho {
  config {
    endpoint: "http://127.0.0.1:18080"
    auth: Bearer
    auth_input: auth_token
  }
  operation Echo {
    input { auth_token: Secret, attempt: String }
    output { ok: String }
    transport rest { method: GET, path: "/attempt/{attempt}" }
    response {
      200 => String
    }
  }
}

service probe.Pause {
  operation ThreeSeconds {
    input {}
    output { ok: String from "stdout" }
    transport shell { argv: ["sleep", "3"] }
    exit {
      0 => Unit
    }
  }
}

data probe_sa: String = "heal-publisher@gunbai-secrets.iam.gserviceaccount.com"
data probe_scope: String = "https://www.googleapis.com/auth/cloud-platform"
data probe_wall_unix: Int = 1793986828

fn nat0() -> Nat { match checked_int_to_nat(n: 0) { Present { value: v } => v  Absent => Zero } }

data no_margin: CredentialUseRequirement = CredentialUseRequirement { required_remaining: nanosecond(count: nat0()), skew_margin: nanosecond(count: nat0()) }

// A credential acquired on this process's monotonic clock with the fixed wall instant probe_wall_unix;
// its deadline is that monotonic reading plus (expire_time - wall).
fn probe_credential(expire_time: String) -> GcpImpersonatedAccessCredential?
  uses clk: std.resources.Clock
  admit_callers: [
    decl_ref(module_path: "test.claim.credential_dispatch_probe", decl_name: "probe_fresh"),
    decl_ref(module_path: "test.claim.credential_dispatch_probe", decl_name: "probe_stale"),
    decl_ref(module_path: "test.claim.credential_dispatch_probe", decl_name: "probe_wrong_binding"),
    decl_ref(module_path: "test.claim.credential_dispatch_probe", decl_name: "probe_expiring_retry"),
  ]
{
  match observe_credential_monotonic(label: "probe-acquisition") {
    Absent => none
    Present { value: now } =>
      match rfc3339_instant_of_unix(unix_seconds: probe_wall_unix, nanos: 0) {
        Absent => none
        Present { value: wall } =>
          match acquisition_clock_reading_of(send_monotonic: now, send_wall: wall) {
            AcquisitionClockUnread { detail: _ } => none
            AcquisitionClockObserved { reading: acq } =>
              Present { value: impersonated_access_credential_of(
                token: "SYNTH-TOKEN-7c1e" as Secret, expire_time: expire_time,
                target_service_account: probe_sa, scopes: [probe_scope], acquisition: acq,
              ) }
          }
      }
  }
}

// THE ADAPTER: presentation and dispatch in one call; the presentation never leaves it.
fn echo_with_gcp_credential(credential: GcpImpersonatedAccessCredential, required_service_account: String, attempt: String) -> RestResult<String>
  uses net: std.resources.Network, clk: std.resources.Clock
{
  match gcp_impersonated_presentation(credential: credential, required_service_account: required_service_account, required_scopes: [probe_scope], requirement: no_margin) {
    CredentialPresented { secret_released_only_by_admission: s } => probe.CredentialEcho.Echo(auth_token: s, attempt: attempt)
    CredentialPresentationRefused { refusal: r } => RestRefused { refusal: RestCredentialRefused { refusal: r } }
  }
}

fn outcome_word(r: RestResult<String>) -> String {
  match r {
    RestAnswered { answer: _ } => "dispatched"
    RestRefused { refusal: RestCredentialRefused { refusal: _ } } => "refused-not-sent"
    RestRefused { refusal: _ } => "other-refusal"
  }
}

fn report(words: String) -> ProcessExit { exit_failure(reason: concat("PROBE-OUTCOME ", words)) }

fn probe_fresh() -> ProcessExit uses net: std.resources.Network, clk: std.resources.Clock {
  match probe_credential(expire_time: "2026-12-01T00:00:00Z") {
    Absent => report(words: "no-credential")
    Present { value: c } => report(words: outcome_word(r: echo_with_gcp_credential(credential: c, required_service_account: probe_sa, attempt: "fresh")))
  }
}

fn probe_stale() -> ProcessExit uses net: std.resources.Network, clk: std.resources.Clock {
  match probe_credential(expire_time: "2000-01-01T00:00:00Z") {
    Absent => report(words: "no-credential")
    Present { value: c } => report(words: outcome_word(r: echo_with_gcp_credential(credential: c, required_service_account: probe_sa, attempt: "stale")))
  }
}

fn probe_wrong_binding() -> ProcessExit uses net: std.resources.Network, clk: std.resources.Clock {
  match probe_credential(expire_time: "2026-12-01T00:00:00Z") {
    Absent => report(words: "no-credential")
    Present { value: c } => report(words: outcome_word(r: echo_with_gcp_credential(credential: c, required_service_account: "someone-else@gunbai-secrets.iam.gserviceaccount.com", attempt: "wrong-binding")))
  }
}

// AN OWNED RETRY AFTER EXPIRY. The credential is usable for two seconds past its acquisition; the
// first attempt is admitted and sent, the pause outlasts the deadline, and the retry calls the adapter
// again, so it is judged at its own instant and refused without a send.
fn probe_expiring_retry() -> ProcessExit uses net: std.resources.Network, clk: std.resources.Clock {
  match probe_credential(expire_time: "2026-11-06T17:40:30Z") {
    Absent => report(words: "no-credential")
    Present { value: c } => {
      let first = outcome_word(r: echo_with_gcp_credential(credential: c, required_service_account: probe_sa, attempt: "retry-first"))
      let paused = probe.Pause.ThreeSeconds()
      let second = outcome_word(r: echo_with_gcp_credential(credential: c, required_service_account: probe_sa, attempt: "retry-second"))
      report(words: concat(concat(first, " then "), second))
    }
  }
}
