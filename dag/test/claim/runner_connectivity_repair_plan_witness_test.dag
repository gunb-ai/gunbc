module test.claim.runner_connectivity_repair_plan_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn act_ts(s: String) -> std.types.Timestamp {
  s as std.types.Timestamp
}

fn fixture_slot() -> gunbc.build_cache_instance.RunnerSlotIdentity {
  gunbc.build_cache_instance.RunnerSlotIdentity { host: operator_host_srv1, slot_index: 1 }
}

fn wedged_snapshot(act: std.types.Timestamp) -> gunbc.runner_connectivity_recovery.RunnerSlotConnectivitySnapshot {
  let slot = fixture_slot()
  let inc = gunbc.runner_connectivity_recovery.RunnerLocalIncarnation {
    slot: slot,
    process: ProcessIdentity {
      boot_id: "boot-a" as std.types.NonEmptyStr,
      pid: 4242,
      start_time: "80000000" as std.types.NonEmptyStr,
    },
    unit: "actions-runner@srv1-01.service" as std.types.NonEmptyStr,
  }
  gunbc.runner_connectivity_recovery.RunnerSlotConnectivitySnapshot {
    slot: slot,
    local: gunbc.runner_connectivity_recovery.RunnerLocalObservation {
      incarnation: inc,
      systemd_active: true,
      observed_at: act,
    },
    remote: gunbc.runner_connectivity_recovery.RunnerRemoteObservation {
      evidence: gunbc.runner_broker_progress_watchdog.RemoteRegistrationObserved {
        registration: RunnerRemoteOffline,
        registration_id: "",
        grade: ObservedEvidence,
      },
      observed_at: act,
      control_plane_error_burst: false,
    },
    broker: gunbc.runner_broker_progress_watchdog.BrokerProgressSilent {
      silence_seconds: runner_broker_progress_silence_bound_seconds,
      grade: ObservedEvidence,
    },
    worker: gunbc.runner_broker_progress_watchdog.RunnerWorkerAbsent { grade: ObservedEvidence },
    registration_grace_elapsed: true,
    confirmed_at: act,
    last_restart_at: Absent,
  }
}

test fn replace_action_projects_five_step_repair_sequence() -> Bool {
  let act = act_ts(s: "2026-08-06T20:00:00Z")
  let snap = wedged_snapshot(act: act)
  let action = decide_runner_connectivity_action_for_snapshot(
    snap: snap,
    prior: snap,
    act_at: act,
    reach: HostReachAdmitted,
    allow_replace: true,
  )
  let plan = project_connectivity_action_to_repair_plan(action: action)
  repair_plan_is_execute(plan: plan)
    && repair_execute_step_count(plan: plan) == 5
    && match plan {
         RepairExecute { slot: _, steps: steps } =>
           list_length(items: steps) == 5
             && match steps.first() {
                  ObserveRunnerLocalState { slot: _ } => true
                  _ => false
                }
             && match steps.skip(n: 1).first() {
                  ObserveGitHubRunnerRegistration { slot: _ } => true
                  _ => false
                }
             && match steps.skip(n: 2).first() {
                  ReplaceRunnerIncarnation { slot: _, from: _, unit: _ } => true
                  _ => false
                }
             && match steps.skip(n: 3).first() {
                  ObserveRunnerLocalState { slot: _ } => true
                  _ => false
                }
             && match steps.skip(n: 4).first() {
                  ObserveGitHubRunnerRegistration { slot: _ } => true
                  _ => false
                }
         RepairNoop { reason: _ } => false
         RepairRefusedPlan { slot: _, reason: _ } => false
       }
}

test fn noop_action_projects_empty_repair_plan() -> Bool {
  let act = act_ts(s: "2026-08-06T20:00:00Z")
  let snap = wedged_snapshot(act: act)
  let connected = gunbc.runner_connectivity_recovery.RunnerSlotConnectivitySnapshot {
    slot: snap.slot,
    local: snap.local,
    remote: gunbc.runner_connectivity_recovery.RunnerRemoteObservation {
      evidence: gunbc.runner_broker_progress_watchdog.RemoteRegistrationObserved {
        registration: gunbc.runner_broker_progress_watchdog.RunnerRemoteOnline {
          runner_name: "actions-runner@srv1-01.service" as std.types.NonEmptyStr,
          labels: ["self-hosted"],
        },
        registration_id: "reg-1",
        grade: ObservedEvidence,
      },
      observed_at: act,
      control_plane_error_burst: false,
    },
    broker: snap.broker,
    worker: snap.worker,
    registration_grace_elapsed: snap.registration_grace_elapsed,
    confirmed_at: act,
    last_restart_at: Absent,
  }
  let action = decide_runner_connectivity_action_for_snapshot(
    snap: connected,
    prior: connected,
    act_at: act,
    reach: HostReachAdmitted,
    allow_replace: true,
  )
  match project_connectivity_action_to_repair_plan(action: action) {
    RepairNoop { reason: _ } => true
    RepairExecute { slot: _, steps: _ } => false
    RepairRefusedPlan { slot: _, reason: _ } => false
  }
}
