module test.claim.roadmap_static_site_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn fixture_site_artifact_digest(body: String) -> std.content_hash.ContentHash {
  content_hash_atom(value: body as std.types.NonEmptyStr)
}

test fn witness_site_artifact_model_populated() -> Bool {
  let alloc = roadmap_site_static_allocation()
  count(alloc.artifacts) == 2
    && alloc.service.stateless
    && alloc.service.health_path == roadmap_site_health_path
    && alloc.route.dns_manual
}

test fn witness_roadmap_artifact_matches_authority() -> Bool {
  let a = roadmap_site_roadmap_md_artifact()
  match a.kind {
    RoadmapMarkdown => a.body == expected_roadmap_md()
    _ => false
  }
}

test fn witness_dispatch_artifact_matches_file_content() -> Bool {
  let a = roadmap_site_dispatch_json_artifact()
  match a.kind {
    RoadmapDispatchJson => a.body == roadmap_dispatch_file_content()
    _ => false
  }
}

test fn witness_artifact_digests_are_content_hashes() -> Bool {
  all(roadmap_site_text_artifacts(), a =>
    a.digest == fixture_site_artifact_digest(body: a.body)
  )
}

test fn witness_healthz_route_json_ok() -> Bool {
  roadmap_site_surface_readiness_group_holds(release_revision: deploy_witness_release_revision)
}

test fn witness_static_site_route_authority_paths_locked() -> Bool {
  let paths = roadmap_site_static_route_authority_paths()
  count(paths) == 3
    && paths == [
      roadmap_site_roadmap_url_path as String,
      roadmap_site_dispatch_url_path as String,
      roadmap_site_health_path as String,
    ]
}

test fn witness_text_routes_include_health_and_artifacts() -> Bool {
  count(roadmap_site_text_static_routes()) == 3
}

test fn witness_readback_shell_marked_scaffold() -> Bool {
  match roadmap_site_readback_script_scaffold {
    Scaffold { dissolves_to: _, bind: _ } => true
    Terminal { reason: _ } => false
  }
}

test fn witness_readback_script_checks_health_and_digests() -> Bool {
  let sh = roadmap_site_readback_script(port: 8080)
  string_contains(s: sh, pattern: "/healthz")
    && string_contains(s: sh, pattern: "healthz json parse failed")
    && string_contains(s: sh, pattern: "--connect-timeout")
    && string_contains(s: sh, pattern: "--max-time")
    && string_contains(s: sh, pattern: roadmap_site_roadmap_url_path)
    && string_contains(s: sh, pattern: roadmap_site_dispatch_url_path)
    && string_contains(s: sh, pattern: "digest mismatch")
    && string_contains(s: sh, pattern: "dispatch json parse failed")
    && string_contains(s: sh, pattern: "roadmap-site-receipt")
    && string_contains(s: sh, pattern: "read_back_ts=")
}

test fn witness_readback_script_curls_are_wall_clock_bounded() -> Bool {
  let sh = roadmap_site_readback_script(port: 8080)
  let prefix = curl_localhost_bounded_get_argv_prefix()
  string_contains(s: sh, pattern: prefix)
    && string_contains(s: sh, pattern: "--connect-timeout 2")
    && string_contains(s: sh, pattern: "--max-time 5")
}

test fn witness_roadmap_route_is_plain_text() -> Bool {
  let routes = roadmap_site_text_static_routes()
  let roadmap = roadmap_site_roadmap_md_artifact()
  any(routes, r =>
    r.body == roadmap.body
      && media_type_wire_label(m: r.content_type) == "text/plain; charset=utf-8"
  )
}

