module test.claim.print_pass_route_witness
import std.types { Bool, String }
import std.bytes { bytes_octets, utf8_encode_bytes }
import std.content_hash { Sha256Digest }
import extdeps.crypto.sha2 { sha256_computed_digest }
import gunbc.fleet.fleet_asset_identity { printer_01 }
import gunbc.fleet.print_request { PrintRequest, PrintRequestRecord, print_attempt_id }
import gunbc.fleet.print_converge {
  print_pass_route, print_pass_refusal_text,
  PrintPassPrepare, PrintPassStartRecorded, PrintPassRecordRefused,
  RecordAbsent, RecordPresent, RecordRefused,
}

// THE APPROVAL IS THE GATE, NOT THE REF (operator ruling 2026-11-05, gunbc.design_ruling
// printer_start_gate_is_the_approval_not_the_ref, superseding design A of 2026-10-25). The route is
// decided from the durable record alone; the run's ref is not an input, so a recorded request reaches
// the approval-and-start pass from any ref.

fn digest_of(s: String) -> Sha256Digest { sha256_computed_digest(message: bytes_octets(b: utf8_encode_bytes(s: s))) }

fn branch_designed_record() -> PrintRequestRecord {
  let r = PrintRequest { request_id: "ring-1", root: "a16-plug-fit-ring", plate: "plate", recipe: "a1-mini-pla-prototype-v1", printer: printer_01 }
  PrintRequestRecord { request: r, source_revision: "branchsha", artifact_sha256: digest_of(s: "branch plate"), artifact_location: "/var/lib/gunbc/print-runs/ring-1-77.3mf", attempt_id: print_attempt_id(request: r, artifact_sha256: digest_of(s: "branch plate")) }
}

// RED (was PrinterStartRefusedOffReviewedMain): a recorded request reaches the start pass carrying the
// RECORDED artifact, with no ref to refuse on. A route that refused off main, or re-derived the artifact,
// turns this red.
test fn a_recorded_request_reaches_the_start_pass_from_any_ref() -> Bool {
  let rec = branch_designed_record()
  match print_pass_route(record: RecordPresent { record: rec }) {
    PrintPassStartRecorded { record: r } => (r.artifact_location as String) == (rec.artifact_location as String) && (r.artifact_sha256.hex as String) == (rec.artifact_sha256.hex as String) && (r.attempt_id as String) == (rec.attempt_id as String)
    PrintPassPrepare => false
    PrintPassRecordRefused { cause: _ } => false
  } && print_pass_refusal_text(route: print_pass_route(record: RecordPresent { record: rec })) == ""
}

test fn an_unrecorded_request_prepares() -> Bool {
  match print_pass_route(record: RecordAbsent) { PrintPassPrepare => true _ => false }
}

// An unreadable record still refuses, whatever ran: the refusals the approval gate sits beside are kept.
test fn an_unreadable_record_refuses() -> Bool {
  match print_pass_route(record: RecordRefused { cause: "x" }) { PrintPassRecordRefused { cause: c } => c == "x" _ => false }
}
