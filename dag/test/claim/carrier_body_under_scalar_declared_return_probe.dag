module test.claim.carrier_body_under_scalar_declared_return_probe

// REPRO PROBE (silent-owl-221, adhoc-4d5ad4ff-fbf). Three shapes of a CARRIER (a generic coproduct,
// the v2.std.diagnostic.Outcome class) produced at a position DECLARING A KERNEL SCALAR:
//   A. a fn declared `-> String` whose body's trailing expr is `outcome_accepted(value: "x")`;
//   B. a `String` parameter applied to an `Outcome<String>`;
//   C. a record with a `String` field built with an `Outcome<String>` at that field.
// Plus the controls that make the wall's idleness or liveness decidable: the same call at a
// position declaring the carrier (must stay accepted), and a bare `String` literal under `-> Int`
// (the one pair the existing wall is known to refuse).
//
// This file is a MEASUREMENT PROBE, not a claim of held status: every arm reports its observed
// blocking count in the ExitFailure reason, so ONE claim_batch run answers "which of the three
// shapes does the checker accept", with the class breakdown beside each total.

import gunbc.compile_diagnostic_census {
  CompileDiagnosticCensus,
  CensusObserved,
  CensusNotRunnable,
  census_blocking_rows,
  census_blocking_rows_of_class,
  census_total_count
}
import std.types { String, Int, Bool, List }
import gunbc.compile_diagnostic_census { CompileDiagnosticCensusRow }
import std.algebra { Cons, Empty }
import std.process { ProcessExit, ExitSuccess, ExitFailure }
import std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// THE CARRIER IS LOCAL AND IS THE SAME SHAPE AS THE CORPUS ONE. `type Outcome<T> = Accepted<T> |
// Rejected<String>` with `fn outcome_accepted<T>(value: T) -> Outcome<T>` is v2.std.diagnostic's
// carrier and its Accepted constructor's smart constructor in two lines, so the probe measures the
// checker's judgment about the SHAPE (a coproduct application under a kernel scalar), not about the
// name.

data carrier_prelude: String = "import std.types { String }\ntype Outcome<T> = Accepted { value: T } | Rejected { reason: String }\nfn outcome_accepted<T>(value: T) -> Outcome<T> { Accepted { value: value } }\n"

fn probe_source(body: String) -> String {
  concat("module probe_carrier_scalar\n", concat(carrier_prelude, body))
}

fn cause_length(cause: String) -> Int {
  string_length(s: cause)
}

fn not_runnable_cause(c: CompileDiagnosticCensus) -> String {
  match c {
    CensusObserved { rows: _ } => ""
    CensusNotRunnable { cause: cause_text } => cause_text
  }
}

fn rows_of_census(c: CompileDiagnosticCensus) -> List<CompileDiagnosticCensusRow> {
  match c {
    CensusNotRunnable { cause: _ } => []
    CensusObserved { rows: rows } => rows
  }
}

fn row_text(rows: List<CompileDiagnosticCensusRow>, rest: String) -> String {
  match rows {
    Empty => concat(rest, "-")
    Cons { head: head_row, tail: tail_rows } => {
      let with_class: String = concat(rest, head_row.diagnostic_class)
      let with_subject: String = concat(concat(with_class, "/"), head_row.subject_name)
      let with_count: String = concat(with_subject, to_string(value: head_row.count))
      let with_block: String = concat(with_count, " blocking=")
      let with_flag: String = concat(with_block, bool_text(value: head_row.blocking))
      concat(with_flag, row_text(rows: tail_rows, rest: ";"))
    }
  }
}

fn bool_text(value: Bool) -> String {
  if value {
    "Y"
  } else {
    "N"
  }
}

fn census_of(body: String) -> CompileDiagnosticCensus {
  compile_dag_diagnostic_census(source: probe_source(body: body))
}

fn blocking_total(c: CompileDiagnosticCensus) -> Int {
  match c {
    CensusNotRunnable { cause: cause_text } => 0 - cause_length(cause: cause_text)
    CensusObserved { rows: rows } => census_total_count(rows: census_blocking_rows(rows: rows))
  }
}

fn blocking_class(c: CompileDiagnosticCensus, wanted: String) -> Int {
  match c {
    CensusNotRunnable { cause: cause_text } => 0 - cause_length(cause: cause_text)
    CensusObserved { rows: rows } =>
      census_total_count(rows: census_blocking_rows_of_class(rows: rows, wanted: wanted))
  }
}

// A. declared `-> String`, body produces the carrier.
data shape_a_body: String = "fn probe() -> String { outcome_accepted(value: \"x\") }\n"

data shape_a_control_body: String = "fn probe() -> Outcome<String> { outcome_accepted(value: \"x\") }\n"

// The wall-is-not-idle control: the pair the existing wall DOES refuse.
data idle_control_body: String = "fn probe() -> Int { \"x\" }\n"

// B. a String parameter, applied to the carrier.
data shape_b_body: String = "fn takes(x: String) -> Int { 1 }\nfn probe() -> Int { takes(x: outcome_accepted(value: \"x\")) }\n"

data shape_b_control_body: String = "fn takes(x: String) -> Int { 1 }\nfn probe() -> Int { takes(x: \"x\") }\n"

// C. a record with a String field, built with the carrier at that field.
data shape_c_body: String = "type Box { text: String }\nfn probe() -> Box { Box { text: outcome_accepted(value: \"x\") } }\n"

data shape_c_control_body: String = "type Box { text: String }\nfn probe() -> Box { Box { text: \"x\" } }\n"

// The classes a refusal for this pair could land under, each named with its seam in the seed:
// DeclaredTypeNotInhabited (the conformance chain's own class), TypeMismatch (its terminal arm),
// TypeError (the call-argument seam's class), DirectCallArgumentType (the call-argument wall).
data probe_classes: List<String> = [
  "DeclaredTypeNotInhabited",
  "TypeMismatch",
  "TypeError",
  "DirectCallArgumentType"
]

fn class_counts_named(classes: List<String>, c: CompileDiagnosticCensus) -> String {
  match classes {
    Empty => ""
    Cons { head: first, tail: rest } => {
      let hits: Int = blocking_class(c: c, wanted: first)
      let labelled: String = concat(first, "=")
      let with_count: String = concat(labelled, to_string(value: hits))
      match rest {
        Empty => with_count
        Cons { head: _, tail: _ } => concat(concat(with_count, ","), class_counts_named(classes: rest, c: c))
      }
    }
  }
}

fn class_counts(c: CompileDiagnosticCensus) -> String {
  class_counts_named(classes: probe_classes, c: c)
}

fn report(label: String, c: CompileDiagnosticCensus) -> String {
  let total: Int = blocking_total(c: c)
  let labelled: String = concat(label, " total=")
  let with_total: String = concat(labelled, to_string(value: total))
  let classes_label: String = concat(with_total, " {")
  concat(concat(classes_label, class_counts(c: c)), "}")
}

fn step(prev: String, label: String, c: CompileDiagnosticCensus) -> String {
  concat(concat(prev, " | "), report(label: label, c: c))
}

test fn carrier_under_scalar_three_shape_probe_reports_observed_counts() -> ProcessExit {
  let census_a: CompileDiagnosticCensus = census_of(body: shape_a_body)
  let census_a_control: CompileDiagnosticCensus = census_of(body: shape_a_control_body)
  let census_idle: CompileDiagnosticCensus = census_of(body: idle_control_body)
  let census_b: CompileDiagnosticCensus = census_of(body: shape_b_body)
  let census_b_control: CompileDiagnosticCensus = census_of(body: shape_b_control_body)
  let census_c: CompileDiagnosticCensus = census_of(body: shape_c_body)
  let census_c_control: CompileDiagnosticCensus = census_of(body: shape_c_control_body)
  let step1: String = report(label: "A", c: census_a)
  let step2: String = step(prev: step1, label: "A+", c: census_a_control)
  let step3: String = step(prev: step2, label: "idle", c: census_idle)
  let step4: String = step(prev: step3, label: "B", c: census_b)
  let step5: String = step(prev: step4, label: "B+", c: census_b_control)
  let step6: String = step(prev: step5, label: "C", c: census_c)
  let step7: String = step(prev: step6, label: "C+", c: census_c_control)
  let blocking_a: List<CompileDiagnosticCensusRow> = census_blocking_rows(rows: rows_of_census(c: census_a))
  let blocking_c: List<CompileDiagnosticCensusRow> = census_blocking_rows(rows: rows_of_census(c: census_c))
  let note: String = concat(concat(" || A rows=", row_text(rows: blocking_a, rest: "")), concat(" || C rows=", row_text(rows: blocking_c, rest: "")))
  // THE ANSWER IS ENCODED IN THE EXIT CODE as seven digits, because claim_batch prints the code and
  // not the reason: digits are A, A+, idle, B, B+, C, C+ blocking-row counts (-1 shows as the digit
  // sequence borrowing, so read the code as the decimal expansion of the seven counts, each 0..9).
  let d1: Int = blocking_total(c: census_a)
  let d2: Int = blocking_total(c: census_a_control)
  let d3: Int = blocking_total(c: census_idle)
  let d4: Int = blocking_total(c: census_b)
  let d5: Int = blocking_total(c: census_b_control)
  let d6: Int = blocking_total(c: census_c)
  let d7: Int = blocking_total(c: census_c_control)
  let code_value: Int = ((((((d1 * 10) + d2) * 10 + d3) * 10 + d4) * 10 + d5) * 10 + d6) * 10 + d7
  ExitFailure {
    code: code_value,
    reason: concat(step7, note)
  }
}
