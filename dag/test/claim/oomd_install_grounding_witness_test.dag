  gunbc.oomd_install.OomdEffectiveRead {
    slice_present: true,
    unit_active: Active,
    unit_file_state: extdeps.os.systemctl.UnitEnabled,
    effective_managed_oom_memory_pressure: extdeps.os.oomd.ManagedOomKill,
    effective_per_session_memory_max: gunbc.ci_floor_measurement.CapEffective { bytes: std.measure.byte_size(10737418240) },
    effective_parent_slice_memory_max: gunbc.ci_floor_measurement.CapEffective { bytes: std.measure.byte_size(21474836480) },
    effective_managed_oom_memory_pressure_limit: std.measure.percent(60),
    oomctl_manages_slice: true,
    membership: all_legacy_membership(),
  }
}

