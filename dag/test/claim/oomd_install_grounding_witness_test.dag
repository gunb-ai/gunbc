test fn witness_wrong_parent_slice_cap_fails_closed() -> Bool { !grounds(read: wrong_parent_slice_cap_read()) }
test fn witness_wrong_pressure_limit_fails_closed() -> Bool { !grounds(read: wrong_pressure_limit_read()) }
test fn witness_oomctl_unmanaged_fails_closed() -> Bool { !grounds(read: oomctl_unmanaged_read()) }

test fn witness_unmeasured_aggregate_fails_closed() -> Bool {
