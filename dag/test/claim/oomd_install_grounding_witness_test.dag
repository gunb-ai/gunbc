fn unmeasured_aggregate_thresholds() -> gunbc.oomd_install.OomdGroundingThresholds {
  gunbc.oomd_install.OomdGroundingThresholds {
    per_session_cap: std.measure.byte_size(10737418240),
    parent_slice_cap: gunbc.ci_floor_measurement.SessionAggregateUnmeasured,
    pressure_limit: std.measure.percent(60),
  }
}

fn all_legacy_membership() -> gunbc.oomd_install.SliceMembershipSignal {
  gunbc.oomd_install.SliceMembershipSignal { sessions_in_slice: 0, sessions_legacy_flat: 5 }
}

fn empty_host_membership() -> gunbc.oomd_install.SliceMembershipSignal {
  gunbc.oomd_install.SliceMembershipSignal { sessions_in_slice: 0, sessions_legacy_flat: 0 }
}

fn partial_migration_membership() -> gunbc.oomd_install.SliceMembershipSignal {
  gunbc.oomd_install.SliceMembershipSignal { sessions_in_slice: 3, sessions_legacy_flat: 2 }
}

fn membership_check_passes(m: gunbc.oomd_install.SliceMembershipSignal) -> Bool {
  match gunbc.oomd_install.membership_grounding_check(m: m) {
    GroundingPass => true
    gunbc.oomd_install.GroundingFail { reason: _ } => false
  }
}

