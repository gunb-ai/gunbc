fn grounding_is_enforced(g: std.realization_reconcile.Grounding<OomdEnforcementEvidence>) -> Bool {
  match g {
    Grounds { evidence: e } =>
      match e {
        OomdEnforced => true
        OomdUnverified => false
      }
    DoesNotGround { reason: _ } => false
  }
}

fn grounds(read: OomdEffectiveRead) -> Bool {
  grounding_is_enforced(g: ground_oomd_from_read(read: read, req: test_thresholds()))
}

test fn witness_full_conjunction_grounds_enforced() -> Bool {
  grounds(read: good_read())
}

test fn witness_slice_absent_fails_closed() -> Bool { !grounds(read: slice_absent_read()) }
test fn witness_inactive_fails_closed() -> Bool { !grounds(read: inactive_read()) }
test fn witness_disabled_fails_closed() -> Bool { !grounds(read: disabled_read()) }
