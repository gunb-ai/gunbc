module test.claim.oomd_install_grounding_witness


data live_tree_disposition: LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn test_thresholds() -> gunbc.oomd_install.OomdGroundingThresholds {
  gunbc.oomd_install.OomdGroundingThresholds {
    per_session_cap: std.measure.byte_size(10737418240),
    parent_slice_cap: gunbc.ci_floor_measurement.SessionAggregateMeasured { bytes: std.measure.byte_size(21474836480) },
    pressure_limit: std.measure.percent(60),
  }
}

fn good_membership() -> gunbc.oomd_install.SliceMembershipSignal {
  gunbc.oomd_install.SliceMembershipSignal { sessions_in_slice: 5, sessions_legacy_flat: 0 }
}

fn good_read() -> gunbc.oomd_install.OomdEffectiveRead {
  gunbc.oomd_install.OomdEffectiveRead {
    slice_present: true,
    unit_active: Active,
    unit_file_state: extdeps.os.systemctl.UnitEnabled,
    effective_managed_oom_memory_pressure: extdeps.os.oomd.ManagedOomKill,
    effective_per_session_memory_max: gunbc.ci_floor_measurement.CapEffective { bytes: std.measure.byte_size(10737418240) },
    effective_parent_slice_memory_max: gunbc.ci_floor_measurement.CapEffective { bytes: std.measure.byte_size(21474836480) },
    effective_managed_oom_memory_pressure_limit: std.measure.percent(60),
    oomctl_manages_slice: true,
    membership: good_membership(),
  }
}

