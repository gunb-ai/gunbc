module test.claim.function_derive_alias_hop_witness

import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data function_derive_alias_hop_witness_note: String = "Executing regression control for function-valued carrier derive admissibility through a type-alias hop. A function value implements Clone through the Rust Rc<dyn Fn> realization, but it implements neither Debug nor serde Serialize/Deserialize; changing Rc therefore cannot repair those impossible derives. The positive fixture makes a record reach a callable through a structural alias and requires Clone-only emission. The Bytes fixture is the discriminating native-realization control: Bytes has a Rust checkpoint, so the alias RHS is not the emitted representation and must not narrow its holder. The plain structural alias proves the walk does not narrow every alias. All rows cross the real emitter through compile_dag_rust_emit_check."

test fn structural_alias_to_callable_derives_clone_only() -> Bool {
  compile_dag_rust_emit_check(
    "module function_derive_alias_hop_witness.structural\n\ntype Handler = fn(Int) -> Int\n\ntype HoldsHandler {\n  handler: Handler\n}\n",
    "src/function_derive_alias_hop_witness_structural.rs",
    ["#[derive(Clone)]\npub struct HoldsHandler"],
    ["Serialize)]\npub struct HoldsHandler", "Debug, Clone"]
  )
}

test fn native_alias_does_not_expose_function_rhs() -> Bool {
  compile_dag_rust_emit_check(
    "module function_derive_alias_hop_witness.native\n\ntype Bytes = fn(Int) -> Int\n\ntype HoldsNativeAlias {\n  value: Bytes\n}\n",
    "src/function_derive_alias_hop_witness_native.rs",
    ["serde::Deserialize)]\npub struct HoldsNativeAlias"],
    ["#[derive(Clone)]\npub struct HoldsNativeAlias"]
  )
}

test fn structural_alias_to_plain_value_keeps_full_derives() -> Bool {
  compile_dag_rust_emit_check(
    "module function_derive_alias_hop_witness.plain\n\ntype Plain {\n  value: Int\n}\n\ntype PlainAlias = Plain\n\ntype HoldsPlainAlias {\n  value: PlainAlias\n}\n",
    "src/function_derive_alias_hop_witness_plain.rs",
    ["serde::Deserialize)]\npub struct HoldsPlainAlias"],
    ["#[derive(Clone)]\npub struct HoldsPlainAlias"]
  )
}
