module test.claim.self_host_compile_phase_live_gate_witness

import std.types { Bool, Int, String, NonEmptyStr }
import std.content_hash { content_hash_atom }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import gunbc.self_host_compile_phase_frontier {
  TargetDefaultedToHost,
  TargetPinnedOnInvocation,
  CompilePhaseFrontierReceipt,
  CompilePhaseFrontierStanding,
  CompilePhaseFrontierValidated,
  current_compile_phase_frontier_standing,
  self_host_compile_phase_frontier_receipts,
  ParseReached,
  CompilePhaseInvocation
}
import tools.emission_entry_instrument {
  EmissionMeasurement,
  EmissionSubjectUnestablished,
  StageBinaries
}
import gunbc.self_host_compile_phase_live_gate {
  LiveToolchainReading,
  LiveObservationTaken,
  LiveObservationNotTaken,
  live_observation_from_measurement,
  live_tree_verdict_for_measurement,
  LiveCompilePhaseObservation,
  LiveFrontierHeld,
  LiveFrontierRefused,
  LiveFrontierUnmeasured,
  LiveComparable,
  LiveIncomparable,
  live_comparability,
  live_tree_frontier_verdict
}

// THE SUBJECT OF EVERY PROBE BELOW IS THE JOIN, NOT A SECOND CENSUS. Each one builds the live
// observation FROM THE LATEST PERSISTED RECEIPT'S OWN POPULATIONS and then perturbs exactly one
// thing. That is what makes the positive control mean something: an unperturbed live tree is the
// tree the latest receipt describes, so it must hold, and every red below is attributable to the
// single perturbation rather than to any difference between two independently authored fixtures.
//
// They are also written against the SERIES rather than against a named receipt, so appending a
// receipt cannot silently retire them: whatever the latest receipt is, the probes re-derive from
// it. No count literal appears anywhere in this file.
data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn latest_receipt() -> CompilePhaseFrontierReceipt? {
  match current_compile_phase_frontier_standing() {
    CompilePhaseFrontierValidated { latest: latest } => Present { value: latest }
    standing => none
  }
}

fn toolchain_of(receipt: CompilePhaseFrontierReceipt) -> LiveToolchainReading {
  LiveToolchainReading {
    cargo_identity: receipt.subject.cargo_identity,
    rustc_identity: receipt.subject.rustc_identity,
    invocation: receipt.subject.invocation,
    classification_policy_digest: receipt.subject.classification_policy_digest
  }
}

fn observation_of(receipt: CompilePhaseFrontierReceipt, identities: List<String>) -> LiveCompilePhaseObservation {
  match receipt.parse_evidence {
    ParseReached { evidence: parse } => LiveCompilePhaseObservation {
      parse_observation: parse,
      raw_error_diagnostic_identities: identities,
      toolchain: toolchain_of(receipt: receipt)
    }
  }
}

// THE ACCEPTED POSITIVE CONTROL, and it carries more than "the gate can say yes". The live census
// here is the latest receipt's own raw identity rows, folded by the frontier's fold rather than
// copied from the receipt's board — so a green also establishes that the live path and the
// persisted path derive the SAME board from one census. A fold that disagreed would red here.
test fn a_live_census_equal_to_the_latest_receipt_holds() -> Bool {
  match latest_receipt() {
    Absent => false
    Present { value: latest } =>
      match live_tree_frontier_verdict(
        series: self_host_compile_phase_frontier_receipts,
        observation: observation_of(receipt: latest, identities: latest.raw_error_diagnostic_identities)
      ) {
        LiveFrontierHeld { live_identity_count: n } => n == count(latest.raw_error_diagnostic_identities)
        verdict => false
      }
  }
}

// THE DISCRIMINATING RED. One identity the latest receipt does not carry, planted in a file the
// receipt already holds diagnostics for so no newly-exposed cause could admit it, must refuse and
// must NAME the planted identity — a red that did not name it would leave a reader unable to tell
// this regression from any other.
data planted_live_regression_identity: String = "src/v2_compile.rs:1:1\tE0308\tmismatched types"

test fn a_live_tree_that_gained_an_identity_refuses_and_names_it() -> Bool {
  match latest_receipt() {
    Absent => false
    Present { value: latest } =>
      match live_tree_frontier_verdict(
        series: self_host_compile_phase_frontier_receipts,
        observation: observation_of(
          receipt: latest,
          identities: concat(latest.raw_error_diagnostic_identities, [planted_live_regression_identity])
        )
      ) {
        LiveFrontierRefused { identities: ids, reason: _ } =>
          any(ids, identity => identity == planted_live_regression_identity)
        verdict => false
      }
  }
}

// A COUNT-ONLY GATE WOULD ACCEPT THIS. One identity removed and one added, cardinality unchanged:
// the join must refuse at identity grain. This is the probe that would go green if anyone replaced
// the join with a population-size comparison.
test fn a_live_tree_that_swapped_an_identity_at_equal_cardinality_refuses() -> Bool {
  match latest_receipt() {
    Absent => false
    Present { value: latest } =>
      match live_tree_frontier_verdict(
        series: self_host_compile_phase_frontier_receipts,
        observation: observation_of(
          receipt: latest,
          identities: concat(
            latest.raw_error_diagnostic_identities |> skip(n: 1),
            [planted_live_regression_identity]
          )
        )
      ) {
        LiveFrontierRefused { identities: ids, reason: _ } =>
          any(ids, identity => identity == planted_live_regression_identity)
        verdict => false
      }
  }
}

// PROGRESS IS NOT A REGRESSION. A ratchet that refused a strictly smaller population would make
// every repair unlandable, which is the failure direction opposite to the one above and is just as
// disqualifying.
test fn a_live_tree_that_removed_an_identity_holds() -> Bool {
  match latest_receipt() {
    Absent => false
    Present { value: latest } =>
      match live_tree_frontier_verdict(
        series: self_host_compile_phase_frontier_receipts,
        observation: observation_of(
          receipt: latest,
          identities: latest.raw_error_diagnostic_identities |> skip(n: 1)
        )
      ) {
        LiveFrontierHeld { live_identity_count: _ } => true
        verdict => false
      }
  }
}

// A MEASUREMENT TAKEN UNDER A DIFFERENT TOOLCHAIN IS NOT A SMALLER OR LARGER POPULATION, IT IS NOT
// A POPULATION AT ALL. The arm must be Unmeasured rather than Held: this is the one the CI runner
// architecture makes live, because the persisted receipts were measured on x86_64 and a host that
// is not that host would otherwise silently compare two different censuses and call it a pass.
test fn a_live_observation_from_another_host_target_is_unmeasured_not_held() -> Bool {
  match latest_receipt() {
    Absent => false
    Present { value: latest } => {
      let foreign = LiveCompilePhaseObservation {
        parse_observation: match latest.parse_evidence { ParseReached { evidence: parse } => parse },
        raw_error_diagnostic_identities: latest.raw_error_diagnostic_identities,
        toolchain: LiveToolchainReading {
          cargo_identity: latest.subject.cargo_identity,
          rustc_identity: latest.subject.rustc_identity,
          invocation: CompilePhaseInvocation {
            target: concat(latest.subject.invocation.target, "-not-this-host"),
            target_selection: latest.subject.invocation.target_selection,
            profile: latest.subject.invocation.profile,
            features: latest.subject.invocation.features
          },
          classification_policy_digest: latest.subject.classification_policy_digest
        }
      }
      match live_tree_frontier_verdict(series: self_host_compile_phase_frontier_receipts, observation: foreign) {
        LiveFrontierUnmeasured { reason: why } => string_contains(s: why as String, pattern: "host target")
        verdict => false
      }
    }
  }
}

// A PINNED LIVE MEASUREMENT AGAINST A DEFAULTED RECEIPT IS NOT COMPARABLE, AND THIS IS THE PROBE
// THAT WOULD HAVE STAYED GREEN BEFORE THE FIX. Both sides spell the SAME triple -- the two persisted
// receipts record x86_64-unknown-linux-gnu, and a pinned invocation on that host passes exactly that
// string -- so every field a String comparison can see agrees. What differs is how the value was
// obtained: the receipt recorded what rustc reported as the host while the measured `cargo check`
// passed no --target, and a pinned invocation records what cargo was told to compile. If this arm
// answered Comparable, the ratchet would compare a population measured under one instrument against
// one measured under another and call the agreement a pass. The RED is authorable only because the
// distinction is a constructor rather than a note: with `target` a bare String there is nothing here
// to perturb.
test fn a_pinned_live_invocation_is_incomparable_to_a_defaulted_receipt() -> Bool {
  match latest_receipt() {
    Absent => false
    Present { value: latest } => {
      let pinned = LiveToolchainReading {
        cargo_identity: latest.subject.cargo_identity,
        rustc_identity: latest.subject.rustc_identity,
        invocation: CompilePhaseInvocation {
          target: latest.subject.invocation.target,
          target_selection: TargetPinnedOnInvocation,
          profile: latest.subject.invocation.profile,
          features: latest.subject.invocation.features
        },
        classification_policy_digest: latest.subject.classification_policy_digest
      }
      match live_comparability(latest: latest, live: pinned) {
        LiveIncomparable { reason: why } =>
          string_contains(s: why as String, pattern: "selects its target differently")
            && latest.subject.invocation.target == pinned.invocation.target
        LiveComparable => false
      }
    }
  }
}

// The comparability predicate's own accepted control, so the probe above is not simply "this
// predicate always refuses".
test fn a_live_observation_on_the_receipts_own_toolchain_is_comparable() -> Bool {
  match latest_receipt() {
    Absent => false
    Present { value: latest } =>
      match live_comparability(latest: latest, live: toolchain_of(receipt: latest)) {
        LiveComparable => true
        LiveIncomparable { reason: _ } => false
      }
  }
}

// AN EMPTY FRONTIER IS NOT A CLEAN ONE. With no persisted receipt there is nothing for the live
// tree to be ratcheted against, and the honest answer is that no comparison was made — the arm a
// gate is most tempted to render as a pass.
test fn an_empty_receipt_series_leaves_the_live_tree_unmeasured_rather_than_held() -> Bool {
  match latest_receipt() {
    Absent => false
    Present { value: latest } =>
      match live_tree_frontier_verdict(
        series: [],
        observation: observation_of(receipt: latest, identities: latest.raw_error_diagnostic_identities)
      ) {
        LiveFrontierUnmeasured { reason: why } => string_contains(s: why as String, pattern: "empty")
        verdict => false
      }
  }
}

// A SERIES THAT DOES NOT VALIDATE MUST REFUSE, NOT PASS THE LIVE TREE ON THE STRENGTH OF ITS LAST
// ROW. Dropping the genesis leaves a series whose first row is typed as a successor, which the
// frontier's own fold already refuses; the live gate must inherit that refusal rather than reach
// past it to a board.
test fn a_non_validating_receipt_series_refuses_the_live_tree() -> Bool {
  match latest_receipt() {
    Absent => false
    Present { value: latest } =>
      match live_tree_frontier_verdict(
        series: self_host_compile_phase_frontier_receipts |> skip(n: 1),
        observation: observation_of(receipt: latest, identities: latest.raw_error_diagnostic_identities)
      ) {
        LiveFrontierRefused { identities: _, reason: why } =>
          string_contains(s: why as String, pattern: "does not validate")
        verdict => false
      }
  }
}

// THE SIXTH COMPARISON INPUT, WITNESSED SEPARATELY BECAUSE IT IS THE ONE THAT CANNOT FIRE ON THE
// REAL PATH TODAY. Both receipts and the actuator name one live symbol for the classification
// policy, so on main the two sides are equal by construction. That makes the guard exactly the kind
// of conjunct that can be deleted without reddening anything -- unless its RED is authored, which
// is what this is. The perturbation is authorable here even though it is unreachable in production,
// because a reading is a value a fixture may build; the frontier's own duplicate-population wall
// carries the same shape and the same justification.
test fn a_live_observation_folded_under_another_classification_policy_is_unmeasured() -> Bool {
  match latest_receipt() {
    Absent => false
    Present { value: latest } => {
      let reading = toolchain_of(receipt: latest)
      let foreign = LiveToolchainReading {
        cargo_identity: reading.cargo_identity,
        rustc_identity: reading.rustc_identity,
        invocation: reading.invocation,
        classification_policy_digest: content_hash_atom(value: "not-the-frontier-classification-policy" as NonEmptyStr)
      }
      match live_comparability(latest: latest, live: foreign) {
        LiveIncomparable { reason: why } => string_contains(s: why as String, pattern: "classification policy")
        LiveComparable => false
      }
    }
  }
}

// THE FALSIFIER FOR THE GATE BEING QUIETLY DISCONNECTED, AND IT IS THE MOST IMPORTANT ONE HERE.
//
// The catastrophic arm is not a missed regression, it is a MEASUREMENT FAILURE READ AS A CLEAN
// TREE. An empty census against a nonempty receipt is a strict removal, which this ratchet reads as
// progress and greens -- so an OOM, a killed instrument, a truncated diagnostic stream, a missing
// artifact, or the actuator's measurement call simply being deleted would each render as the
// emitted compiler having been repaired. There is no count in the verdict for a reviewer to notice
// was suspiciously good.
//
// The wall is that an observation has exactly one constructor and it is the EmissionMeasured arm.
// This drives an unreached measurement through the real entry point and requires Unmeasured. It
// goes red if anyone gives LiveCompilePhaseObservation a second way in, which is the change that
// would re-open the arm.
data unreached_measurement: EmissionMeasurement = EmissionSubjectUnestablished {
  entry: "src/v2/compiler/00_compile.dag",
  stage: StageBinaries,
  cause: "planted: the instrument never reached cargo"
}

test fn a_measurement_that_never_reached_cargo_is_unmeasured_and_never_held() -> Bool {
  match latest_receipt() {
    Absent => false
    Present { value: latest } =>
      match live_tree_verdict_for_measurement(
        series: self_host_compile_phase_frontier_receipts,
        m: unreached_measurement,
        toolchain: toolchain_of(receipt: latest)
      ) {
        LiveFrontierUnmeasured { reason: why } => string_contains(s: why as String, pattern: "absent census is not an empty one")
        verdict => false
      }
  }
}

// The same fact one level down, so the wall is pinned at the constructor rather than only at the
// verdict: no observation is produced at all, which is what makes the empty-census spelling
// unwritable rather than merely unwritten.
test fn an_unreached_measurement_yields_no_observation_at_all() -> Bool {
  match latest_receipt() {
    Absent => false
    Present { value: latest } =>
      match live_observation_from_measurement(
        m: unreached_measurement,
        toolchain: toolchain_of(receipt: latest)
      ) {
        LiveObservationNotTaken { cause: _ } => true
        LiveObservationTaken { observation: _ } => false
      }
  }
}

// THE CONTROL THAT MAKES THE TWO ABOVE MEAN SOMETHING, and it is the one that would catch the wall
// being tightened into "nothing is ever measurable". A completed measurement whose census is
// genuinely EMPTY is the success state this whole frontier is aiming at -- the emitted compiler
// finally compiling -- and it must hold rather than refuse. So the distinction being enforced is
// measurement-ABSENT versus census-EMPTY, exactly as claimed, and not a blanket suspicion of small
// populations. Without this probe, "always answer Unmeasured" would pass every test above.
test fn an_empty_census_from_a_completed_measurement_still_holds() -> Bool {
  match latest_receipt() {
    Absent => false
    Present { value: latest } =>
      match live_tree_frontier_verdict(
        series: self_host_compile_phase_frontier_receipts,
        observation: observation_of(receipt: latest, identities: [])
      ) {
        LiveFrontierHeld { live_identity_count: n } => n == 0
        verdict => false
      }
  }
}
