module test.claim.githooks_pre_push_emit

import gunbc.githooks.githooks_pre_push_emit {
  expected_githooks_pre_push_sh,
  githooks_pre_push_emit_concat_body_dissolution
}
import gunbc.local_tidy_spec { githooks_pre_push_emit_scaffold }
import std.disposition { Scaffold, RealizationDispatch, SingleAuthority, SubstrateMandatoryTag }
import std.dissolution { dissolution_description }
import std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

fn has(s: String, p: String) -> Bool {
  string_contains(s: s, pattern: p)
}

test fn witness_generated_header() -> Bool {
  let sh = expected_githooks_pre_push_sh()
  has(s: sh, p: "GENERATED by dag/gunbc/githooks/githooks_pre_push_emit.dag")
    && has(s: sh, p: "set -euo pipefail")
}

test fn witness_fmt_is_the_body() -> Bool {
  let sh = expected_githooks_pre_push_sh()
  has(s: sh, p: "cargo fmt --all --check")
    && has(s: sh, p: "rustfmt drift")
    && has(s: sh, p: "exit 1")
}

test fn witness_no_claim_batch_dependency() -> Bool {
  let sh = expected_githooks_pre_push_sh()
  !has(s: sh, p: "claim_batch")
    && !has(s: sh, p: "--pre-push")
    && !has(s: sh, p: "ensure_bins")
    && !has(s: sh, p: "CLAIM_BATCH")
}

test fn witness_no_in_hook_build() -> Bool {
  let sh = expected_githooks_pre_push_sh()
  !has(s: sh, p: "cargo build")
    && !has(s: sh, p: "CTRL_BUILD_WRAP_CARGO")
}

test fn witness_no_corpus_or_witness_run() -> Bool {
  let sh = expected_githooks_pre_push_sh()
  !has(s: sh, p: "gunbc_ci_witness_corpus_only_batches")
    && !has(s: sh, p: "doc_graph_has_no_orphan_docs")
    && !has(s: sh, p: "--claim-run")
    && !has(s: sh, p: "run_generated_artifact_drift_gate_body")
}

// The budget exists to catch RE-HEAVYING — a roster edit that puts a corpus run, an in-hook cargo
// build, or a claim_batch exec back on the push path (gunbc.githooks.githooks_pre_push_emit
// pre_push_fmt_only_note). It is a proxy for that property, and the four witnesses above assert the
// property directly, which is why raising the ceiling here does not weaken the gate. It moved 700
// -> 1000 when the fmt failure arm was split three ways: the could-not-run branch carries a
// ~230-character diagnostic that names cargo and proposes no cargo-dependent remedy, which is the
// whole point of the split and is not weight on the push path (it is a message, not work). It moved
// 1000 -> 1500 when lane-2 added idempotent repo-local git config convergence on the push path
// (~350 characters of gunbc run argv and failure text — still no cargo build or claim_batch exec;
// the structural witnesses remain authoritative). A hook that re-acquires actual work still trips
// the structural witnesses regardless of this number.

// witness_line_budget (length(sh) < N) DELETED 2026-08-09: it was a tree-measured
// numeric oracle — a merge-blocking literal grounded in a measurement of the current
// hook rather than a policy budget (DESIGN §5 oracle rule; the giveaway was that adding
// the correct fleet-ref preamble forced the cap up to fit the code it was meant to
// bound — a ratchet quietly loosening). The invariant it weakly proxied ("the hook stays
// a thin dispatcher, no heavy work") is asserted STRUCTURALLY and precisely by
// witness_no_in_hook_build, witness_no_corpus_or_witness_run,
// witness_no_claim_batch_dependency, and witness_no_tree_mutation — none of which is a
// tree-measured literal. A byte count added nothing those do not already bound (DESIGN §2).
test fn witness_no_tree_mutation() -> Bool {
  let sh = expected_githooks_pre_push_sh()
  !has(s: sh, p: "chore: apply cargo fmt")
    && !has(s: sh, p: "chore: regenerate committed projections")
    && !has(s: sh, p: "git add")
    && !has(s: sh, p: "git commit")
}

// THE CONCAT BODY IS COUNTED, NOT SILENT — the typed reader (the §3c consumer of the carrier).
// Carrier: DissolutionCondition, chosen over rung_drop (nothing is withdrawn from a gate — the
// artifact and its behavior persist while git keeps executing the hook) and over
// gunbc.retained_shell_script (Charter 2 exits that roster empty; zesty-tern-692 is deleting
// bridges there). The Scaffold registration for this surface stays the single authority in
// gunbc.local_tidy_spec (githooks_pre_push_emit_scaffold); this module adds only the dissolution
// row naming the capability, mirroring the sibling
// gunbc.githooks.githooks_repo_local_git_config_emit converge-block carrier.
// The row is CONSUMED here, not just declared: dissolution_description is called on it and the
// named trigger capability must survive in its text — the eight emitter forms the cutover waits
// on, the grammar module that owes them, and the scaffold's bound declaration. Perturbing the
// trigger text to drop any named form reddens this witness with every module compiling. The
// deletion control (row removed, all modules still compiling) is the sibling claim module
// test.claim.githooks_pre_push_emit_residual_census: it runs the production fold
// gunbc.census_closure_frontier.census_closure_frontier_rows() and counts exactly one row whose
// subject is expected_githooks_pre_push_sh, importing neither githooks module — so deleting the
// FrontierRow or dropping the registration from the fold reddens that claim without breaking
// compilation.
test fn witness_carrier_reader_reads_the_row() -> Bool {
  let d = dissolution_description(condition: githooks_pre_push_emit_concat_body_dissolution)
  has(s: d, p: "gunbc.languages.bash")
    && has(s: d, p: "shebang")
    && has(s: d, p: "comment")
    && has(s: d, p: "set -euo pipefail")
    && has(s: d, p: "while-read")
    && has(s: d, p: "case/esac")
    && has(s: d, p: "[[ ]]")
    && has(s: d, p: "$(( ))")
    && has(s: d, p: ">&2")
    && (match githooks_pre_push_emit_scaffold {
        Scaffold { dissolves_to: RealizationDispatch, bind: b } =>
          (b.module_path as String) == "gunbc.githooks.githooks_pre_push_emit"
            && (b.decl_name as String) == "expected_githooks_pre_push_sh"
        Scaffold { dissolves_to: SingleAuthority, bind: _ } => false
        Scaffold { dissolves_to: SubstrateMandatoryTag, bind: _ } => false
        Terminal { reason: _ } => false
      })
}
