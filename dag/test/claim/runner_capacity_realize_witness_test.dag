module test.claim.runner_capacity_realize_witness

import std.logic { Bool }
import gunbc.fleet_intent_network { operator_host_srv3, operator_host_srv4 }
import gunbc.runner_capacity_plan {
  runner_capacity_plan,
  runner_capacity_add_count,
  PlanReady,
  PlanRefused,
}
import gunbc.fleet_runner_connectivity {
  organization_runner_roster_evidence,
  organization_runner_roster_converged_seven_evidence,
}
import gunbc.runner_capacity_realize {
  runner_capacity_apply_plan,
  runner_capacity_reapply_plans_zero_additions,
  RunnerCapacityApplyRefused,
  RunnerCapacityApplySucceeded,
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn apply_seam_plans_two_additions_not_count_refusal() -> Bool {
  let plan = runner_capacity_plan(
    srv3_width: 7,
    srv4_width: 7,
    roster: organization_runner_roster_evidence(),
  )
  match plan {
    PlanReady { hosts: _ } =>
      runner_capacity_add_count(plan: plan, host: operator_host_srv3) == 2
        && runner_capacity_add_count(plan: plan, host: operator_host_srv4) == 2
    PlanRefused { reason: _ } => false
  }
}

test fn apply_seam_refuses_unobservable_disk_not_width_five() -> Bool {
  let plan = runner_capacity_plan(
    srv3_width: 7,
    srv4_width: 7,
    roster: organization_runner_roster_evidence(),
  )
  match runner_capacity_apply_plan(plan: plan) {
    RunnerCapacityApplyRefused { reason: r } =>
      string_contains(s: r, pattern: "disk unobservable")
        && string_contains(s: r, pattern: "7")
        && (string_contains(s: r, pattern: "width 5") == false)
    RunnerCapacityApplySucceeded { add_actions_executed: _ } => false
  }
}

test fn replay_apply_is_no_op_when_observed_width_satisfies_request() -> Bool {
  runner_capacity_reapply_plans_zero_additions(
    srv3_width: 7,
    srv4_width: 7,
    observed_srv3: 7,
    observed_srv4: 7,
  )
    && runner_capacity_reapply_plans_zero_additions(
      srv3_width: 5,
      srv4_width: 5,
      observed_srv3: 5,
      observed_srv4: 5,
    )
}

test fn converged_roster_plans_zero_additions_and_apply_succeeds() -> Bool {
  let plan = runner_capacity_plan(
    srv3_width: 7,
    srv4_width: 7,
    roster: organization_runner_roster_converged_seven_evidence(),
  )
  match plan {
    PlanReady { hosts: _ } =>
      runner_capacity_add_count(plan: plan, host: operator_host_srv3) == 0
        && runner_capacity_add_count(plan: plan, host: operator_host_srv4) == 0
        && match runner_capacity_apply_plan(plan: plan) {
          RunnerCapacityApplySucceeded { add_actions_executed: n } => n == 0
          RunnerCapacityApplyRefused { reason: _ } => false
        }
    PlanRefused { reason: _ } => false
  }
}
