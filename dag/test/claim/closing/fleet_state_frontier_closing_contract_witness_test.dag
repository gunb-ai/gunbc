module test.claim.closing.fleet_state_frontier_closing_contract_witness_test

// The closing witness for node fleet-state-frontier. The node's bar: an
// undeclared file, service, credential, or device refuses before anything is
// changed. The witness calls frontier_gate (gunbc.host.host_converge), the
// production classification function added by this node, supplying inputs only.
// The refusing arm (FrontierRefused) carries the undeclared artifact by name.
//
// Red pair:
//   an_undeclared_artifact_refuses_before_anything_is_changed — discriminating;
//     fails if frontier_gate admits an artifact not in the declared roster.
//   a_fully_classified_inventory_admits — positive control; fails if a declared
//     artifact is refused.

import std.types { Bool, String }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import gunbc.host.host_converge {
  FrontierAdmitted,
  FrontierRefused,
  DerivedByUs,
  frontier_gate,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn an_undeclared_artifact_refuses_before_anything_is_changed() -> Bool {
  // An artifact not in the declared frontier classification must be refused,
  // carrying the artifact name in the verdict. The converge path will not
  // attempt any change on its behalf.
  //
  // Discriminating: if frontier_gate admitted undeclared artifacts (the
  // classification gate bypassed), this test fails.
  match frontier_gate(artifact_name: "undeclared.credential.srv9_api_key") {
    FrontierRefused { artifact: "undeclared.credential.srv9_api_key", cause: _ } => true
    FrontierAdmitted { artifact: _, class: _ } => false
  }
}

test fn a_fully_classified_inventory_admits() -> Bool {
  // A declared artifact admits with its classification. The positive control
  // proves the gate is not vacuously refusing everything.
  //
  // Discriminating: if frontier_gate refused a declared artifact, this test
  // fails.
  match frontier_gate(artifact_name: "gunbc.memory.high") {
    FrontierAdmitted { artifact: "gunbc.memory.high", class: DerivedByUs } => true
    FrontierRefused { artifact: _, cause: _ } => false
  }
}
