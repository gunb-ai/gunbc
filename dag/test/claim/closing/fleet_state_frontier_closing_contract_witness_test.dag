module test.claim.closing.fleet_state_frontier_closing_contract_witness_test

// The closing witness for node fleet-state-frontier. The node's bar: an
// undeclared file, service, credential, or device refuses before anything is
// changed. The frontier classification lives in the carrier (host_converge.dag);
// the production converge route calls frontier_validate_knobs via
// frontier_gate_host before admitting any host.
//
// Red pair:
//   an_undeclared_artifact_refuses_before_anything_is_changed — discriminating;
//     drives frontier_validate_knobs (the production gate) with an undeclared
//     knob and asserts FrontierRefused carries the artifact.
//   a_fully_classified_inventory_admits — positive control; drives the full
//     converge route (fleet_converge_policy_from → converge_hosts_of_plan →
//     frontier_gate_host → frontier_validate_knobs) through the real production
//     plan and asserts the policy is derived (all knobs classified).

import std.types { Bool, String }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import extdeps.systemd { systemd_memory_max_property }
import gunbc.ci.ci_runner_placement {
  runner_deployment_plan,
  runner_image_baked_deployment_plan,
}
import gunbc.host.host_converge {
  ConvergeKnob,
  ConvergePolicyDerived,
  ConvergePolicyUnsound,
  FrontierAdmitted,
  FrontierRefused,
  DerivedByUs,
  SessionsSlice,
  VerifyOnlyCap,
  fleet_converge_policy_from,
  frontier_validate_knobs,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn an_undeclared_artifact_refuses_before_anything_is_changed() -> Bool {
  // A knob whose name is not in the declared frontier classification must be
  // refused by the production gate (frontier_validate_knobs), which the
  // converge route (frontier_gate_host) calls before admitting any host.
  // The refusing arm carries the undeclared artifact by name.
  //
  // Discriminating: if frontier_validate_knobs admitted undeclared knobs (the
  // classification gate bypassed or the roster widened silently), this test fails.
  let undeclared_knob = ConvergeKnob {
    slice: SessionsSlice,
    name: "undeclared.credential.srv9_api_key",
    desired: "redacted",
    target: VerifyOnlyCap {
      slice_unit: "srv9.slice",
      property: systemd_memory_max_property,
    },
  }
  match frontier_validate_knobs(knobs: [undeclared_knob]) {
    FrontierRefused { artifact: "undeclared.credential.srv9_api_key", cause: _ } => true
    FrontierAdmitted { artifact: _, class: _ } => false
  }
}

test fn a_fully_classified_inventory_admits() -> Bool {
  // Positive control: the real production converge route (fleet_converge_policy_from
  // → converge_hosts_of_plan → frontier_gate_host → frontier_validate_knobs)
  // admits the production plan because every knob in it is classified.
  // This proves the gate does not vacuously refuse declared artifacts and
  // executes the real path end-to-end.
  //
  // Discriminating: if the frontier gate refused any declared knob in the
  // production plan, the policy would be ConvergePolicyUnsound and this fails.
  match fleet_converge_policy_from(
    plan: runner_deployment_plan(),
    image_baked: runner_image_baked_deployment_plan(),
  ) {
    ConvergePolicyDerived { hosts: hs } => hs.length() > 0
    ConvergePolicyUnsound { reason: _ } => false
  }
}
