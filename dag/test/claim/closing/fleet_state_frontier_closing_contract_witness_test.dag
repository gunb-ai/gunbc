module test.claim.closing.fleet_state_frontier_closing_contract_witness_test

// The closing witness for node fleet-state-frontier. The node's bar: an
// undeclared file, service, credential, or device refuses before anything is
// changed. The witness drives frontier_validate_knobs (gunbc.host.host_converge),
// the production gate called by the converge route (converge_hosts_of_plan →
// frontier_gate_host → frontier_validate_knobs) before admitting a host.
// The witness supplies knob inputs only; the refusing arm (FrontierRefused)
// carries the undeclared artifact by name.
//
// Red pair:
//   an_undeclared_artifact_refuses_before_anything_is_changed — discriminating;
//     fails if frontier_validate_knobs admits a knob not in the declared roster.
//   a_fully_classified_inventory_admits — positive control; fails if a fully
//     declared knob set is refused.

import std.types { Bool, String }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import extdeps.systemd { systemd_memory_max_property }
import gunbc.host.host_converge {
  ConvergeKnob,
  FrontierAdmitted,
  FrontierRefused,
  DerivedByUs,
  SessionsSlice,
  VerifyOnlyCap,
  frontier_validate_knobs,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn an_undeclared_artifact_refuses_before_anything_is_changed() -> Bool {
  // A knob whose name is not in the declared frontier classification must be
  // refused by the production gate. The converge route will not admit the host
  // carrying this knob; no change is attempted on its behalf.
  //
  // Discriminating: if frontier_validate_knobs admitted undeclared knobs (the
  // classification gate bypassed), this test fails.
  let undeclared_knob = ConvergeKnob {
    slice: SessionsSlice,
    name: "undeclared.credential.srv9_api_key",
    desired: "redacted",
    target: VerifyOnlyCap {
      slice_unit: "srv9.slice",
      property: systemd_memory_max_property,
    },
  }
  match frontier_validate_knobs(knobs: [undeclared_knob]) {
    FrontierRefused { artifact: "undeclared.credential.srv9_api_key", cause: _ } => true
    FrontierAdmitted { artifact: _, class: _ } => false
  }
}

test fn a_fully_classified_inventory_admits() -> Bool {
  // Every knob in the declared frontier classification admits. The positive
  // control proves the gate is not vacuously refusing everything.
  //
  // Discriminating: if frontier_validate_knobs refused a declared knob, this
  // test fails.
  let declared_knob = ConvergeKnob {
    slice: SessionsSlice,
    name: "slice_max_bytes",
    desired: "4294967296",
    target: VerifyOnlyCap {
      slice_unit: "srv1.slice",
      property: systemd_memory_max_property,
    },
  }
  match frontier_validate_knobs(knobs: [declared_knob]) {
    FrontierAdmitted { artifact: "all", class: DerivedByUs } => true
    FrontierRefused { artifact: _, cause: _ } => false
  }
}
