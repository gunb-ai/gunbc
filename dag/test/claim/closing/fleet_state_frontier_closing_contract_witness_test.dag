module test.claim.closing.fleet_state_frontier_closing_contract_witness_test

// The machine-artifact classification authority (files, services, credentials,
// devices) does not yet exist in the tree. Per the centering plan, this witness
// targets gunbc.host.host_assimilation_program's roster refusal directly as the
// standing construction. The refusal mechanism is the closed-roster discipline:
// canonical_participation gates admission through participation_list_contains,
// and fleet_participation_in_canonical_roster is the authoritative Bool gate
// whose exhaustive match (fail_closed) prevents any variant from bypassing it.
//
// The claim is scoped to the roster's admission/refusal discipline and does NOT
// assert whole-host state truth (epistemic_humility).
//
// Red pair:
//   an_undeclared_artifact_refuses_before_anything_is_changed — discriminating;
//     fails if canonical_participation returns the full roster regardless of the
//     request (the gate is bypassed), proving the closed-roster refusal is live.
//   a_fully_classified_inventory_admits — positive control; fails if the roster
//     check rejects members it should admit.

import std.types { Bool, List, String }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import gunbc.host.host_assimilation_program {
  canonical_participation,
  fleet_participation_in_canonical_roster,
}
import gunbc.fleet.fleet_enrollment {
  FleetParticipation,
  CiRunnerParticipation,
  InferenceServingParticipation,
  InteractiveSessionParticipation,
  participation_list_contains,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn an_undeclared_artifact_refuses_before_anything_is_changed() -> Bool {
  // A machine artifact declares its participation as CiRunnerParticipation only.
  // The standing construction gates admission through the closed roster: only
  // items BOTH declared in the roster AND present in the request are admitted.
  // InferenceServingParticipation and InteractiveSessionParticipation are
  // undeclared for this artifact — the roster gate refuses them. They never
  // appear in the admitted set, so no downstream change is attempted on their
  // behalf ("before anything is changed").
  //
  // Discriminating: if canonical_participation returned the full canonical
  // roster regardless of the request (the gate bypassed), the length check
  // would fail because the output would contain all three rather than one.
  // The refused items are named by the assertions carrying them: they are
  // asserted absent from the admitted set.
  let admitted = canonical_participation(ps: [CiRunnerParticipation])
  admitted.length() == 1
    && participation_list_contains(ps: admitted, wanted: CiRunnerParticipation)
    && !participation_list_contains(ps: admitted, wanted: InferenceServingParticipation)
    && !participation_list_contains(ps: admitted, wanted: InteractiveSessionParticipation)
}

test fn a_fully_classified_inventory_admits() -> Bool {
  // Positive control: when every machine-touching artifact's participation is
  // declared in the canonical roster, all of them admit. Each passes both the
  // roster-membership gate (fleet_participation_in_canonical_roster) and the
  // canonical_participation filter.
  //
  // Discriminating: if fleet_participation_in_canonical_roster returned false
  // for a declared member, or if canonical_participation dropped a member it
  // should admit, this test fails.
  let all_declared = [
    CiRunnerParticipation,
    InferenceServingParticipation,
    InteractiveSessionParticipation,
  ]
  let admitted = canonical_participation(ps: all_declared)
  admitted.length() == 3
    && participation_list_contains(ps: admitted, wanted: CiRunnerParticipation)
    && participation_list_contains(ps: admitted, wanted: InferenceServingParticipation)
    && participation_list_contains(ps: admitted, wanted: InteractiveSessionParticipation)
    && fleet_participation_in_canonical_roster(p: CiRunnerParticipation)
    && fleet_participation_in_canonical_roster(p: InferenceServingParticipation)
    && fleet_participation_in_canonical_roster(p: InteractiveSessionParticipation)
}
