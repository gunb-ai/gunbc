// CLOSING CONTRACT for roadmap node test-reference-discipline-remainder: the discriminating reds
// of the test-reference wall execute where merges are decided. The wall is a single rule -- a
// reference that reaches a TestMarked declaration refuses (TestCodeReferenced) -- so the one claim
// held here is placement: the wall witness test.claim.test_reference_wall_witness is enrolled on
// the required gate's authored-module roster, at exact module grain (no prefix family admits it),
// so its refusal arms execute on every required run. This claim is placement, not re-execution:
// re-running the wall's probes here would be identical call+input duplication (DESIGN 2). The
// ledger, its corpus-membership census and the orphan and budget refusals were deleted: no
// production row remained, so they preserved a test of their own machinery.

import v2.workflow.required_floor { required_gate_authored_modules, required_gate_prefixes }

data wall_module: String = "test.claim.test_reference_wall_witness"

fn test_reference_closing_roster_contains(xs: List<String>, needle: String) -> Bool {
  any(xs, x => x == needle)
}

// CLAUSE 1: enrolled on the required gate, and by the roster whose rule fits a single module --
// the authored-module roster admits at named-module grain, while the prefix roster admits every
// suffix neighbour of a row. A future sibling planted under test.claim.test_reference_wall_*
// stays OUTSIDE the gate unless it is deliberately enrolled, which is what exact grain buys.
// starts_with is the std runtime primitive (src/v1/runtime_rust.dag): this module deliberately
// declares no bare helper under that name -- bare names resolve by global uniqueness, and a
// local declaration under a common name re-binds other witnesses' bare uses through the flat
// bare channel, dragging them into this module's reach.
fn gate_enrollment_holds() -> Bool {
  test_reference_closing_roster_contains(xs: required_gate_authored_modules(), needle: wall_module)
    && !any(required_gate_prefixes(), p => starts_with(s: wall_module, prefix: p))
}

test fn test_reference_discipline_remainder_closing_contract_holds() -> Bool {
  gate_enrollment_holds()
}
