module test.claim.gcp_estate_convergence_binding

import std.types { Bool, List }
import gunbc.auth.oidc_claim_pins { OidcClaimPin, claim_pins_admit }
import gunbc.auth.github_gcp_federation { github_wif_principal_set }
import gunbc.auth.gcp_iam_converge { gcp_iam_converge_targets }
import gunbc.auth.fleet_convergence_federation {
  fleet_convergence_claim_pins, fleet_convergence_principal_set, fleet_convergence_attribute_condition,
  fleet_convergence_federation, fleet_convergence_provider_resource,
}
import gunbc.fleet_host_key_enrollment { probe_identity_secret_access_requirement }
import gunbc.gcp_estate_adoption { gcp_estate_desired_convergence_binding }

fn dispatch_claims() -> List<OidcClaimPin> {
  map(fleet_convergence_claim_pins(), p => p)
}

fn with_claim(claim: String, value: String) -> List<OidcClaimPin> {
  map(fleet_convergence_claim_pins(), p => if (p.claim as String) == claim { OidcClaimPin { claim: p.claim, value: value } } else { p })
}

// Accepting control: the fleet-converge workflow dispatched at main is admitted.
test fn the_fleet_converge_dispatch_at_main_is_admitted() -> Bool {
  claim_pins_admit(pins: fleet_convergence_claim_pins(), claims: dispatch_claims())
}

// Refusing controls: a pull request, the merge queue, a main-ref job of another workflow (heal-publish,
// witnesses), a branch dispatch and another repository each fail a pin.
test fn no_other_run_is_admitted() -> Bool {
  let pins = fleet_convergence_claim_pins()
  !claim_pins_admit(pins: pins, claims: with_claim("event_name", "pull_request"))
    && !claim_pins_admit(pins: pins, claims: with_claim("event_name", "merge_group"))
    && !claim_pins_admit(pins: pins, claims: with_claim("event_name", "workflow_run"))
    && !claim_pins_admit(pins: pins, claims: with_claim("workflow_ref", "gunb-ai/gunbc/.github/workflows/witnesses.yml@refs/heads/main"))
    && !claim_pins_admit(pins: pins, claims: with_claim("workflow_ref", "gunb-ai/gunbc/.github/workflows/fleet-converge.yml@refs/heads/session/x"))
    && !claim_pins_admit(pins: pins, claims: with_claim("ref", "refs/pull/13509/merge"))
    && !claim_pins_admit(pins: pins, claims: with_claim("repository_id", "1"))
}

test fn the_condition_names_the_workflow_and_the_dispatch() -> Bool {
  let c = fleet_convergence_attribute_condition()
  c.contains("assertion.workflow_ref == ") && c.contains("fleet-converge.yml@refs/heads/main") && c.contains("assertion.event_name == 'workflow_dispatch'")
}

// The estate binding, the consumers' provider and the converge target all name the pinned federation,
// and the repository-wide principal set is nowhere among them: no PR-reachable principal can impersonate it.
test fn the_account_is_reached_only_through_the_pinned_pool() -> Bool {
  let b = gcp_estate_desired_convergence_binding()
  let f = fleet_convergence_federation()
  b.member == fleet_convergence_principal_set()
    && b.member != github_wif_principal_set()
    && probe_identity_secret_access_requirement.wif_principal_set == fleet_convergence_principal_set()
    && probe_identity_secret_access_requirement.wif_provider_resource == fleet_convergence_provider_resource()
    && f.principal_set == fleet_convergence_principal_set()
    && f.attribute_condition == fleet_convergence_attribute_condition()
    && gcp_iam_converge_targets.any(t => t.principal_set == fleet_convergence_principal_set() && t.service_account == b.account)
    && gcp_iam_converge_targets.all(t => t.service_account != b.account || t.principal_set != github_wif_principal_set())
}
