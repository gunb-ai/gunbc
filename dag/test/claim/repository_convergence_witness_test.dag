module test.claim.repository_convergence_witness_test

import std.types { String, Bool, List }
import extdeps.git.enumeration {
  GitRefSetObservation, GitRefSetObserved, GitRefSetReadRefused, GitRefSetUndecodable, git_ref_set_observation_of,
}
import extdeps.git.worktree_enumeration {
  GitWorktreeSetObservation, GitWorktreeSetObserved, git_worktree_set_observation_of,
}
import gunbc.live_deploy.repository_convergence {
  RepositoryState,
  RepositoryConvergenceOutcome,
  ConvergenceCompleted, ConvergenceAlreadyAtCandidate,
  ConvergencePreStateUnobservable, ConvergencePostStateUnobservable,
  ConvergenceRefDisappeared, ConvergenceWorktreeDisappeared, ConvergenceWorktreeRebound,
  ConvergenceHeadNotAtCandidate, ConvergenceHeadMovedWithoutReflog,
  repository_convergence_verdict,
  repository_convergence_converged,
}

data old_sha: String = "1111111111111111111111111111111111111111"
data new_sha: String = "2222222222222222222222222222222222222222"
data dispatch_sha: String = "3333333333333333333333333333333333333333"
data base_ref: String = "refs/remotes/origin/main"
data primary: String = "/opt/gunbc/gunbc"
data linked: String = "/opt/gunbc/dispatch-worktrees/attempt-a"

// FIXTURES ARE BUILT FROM GIT'S OWN WIRE TEXT AND DECODED, not hand-constructed. `GitObjectId` is a
// sole-constructor validated type -- `git_sha1_object_id` refuses anything that is not lowercase hex
// of a git object width -- so a witness CANNOT cast a String into one, and the first cut of this file
// tried to and failed at runtime on all nine rows. That refusal is the carrier working as designed.
//
// Going through the decoders is the better fixture anyway: the pre- and post-states these witnesses
// compare are exactly what `ForEachRefIn` and `WorktreeListIn` produce, so the adjudication is
// exercised over the shape it will really receive rather than over a shape assembled to suit it.
//
// WHAT THAT STILL DOES NOT ESTABLISH, and the sibling decoder witnesses say the same: nothing here
// shows that git EMITS these bytes for any given repository state. That is a transport claim, it
// cannot execute in the hermetic fold, and reporting these as coverage for it would be rung
// inflation (DESIGN §4b).
fn ref_record(name: String, oid: String) -> String {
  concat(concat(name, concat("\0", oid)), "\0")
}

fn refs_wire(records: List<String>) -> GitRefSetObservation {
  git_ref_set_observation_of(raw: join(records, ""), exit_code: 0, stderr: "")
}

fn base_ref_record(oid: String) -> String {
  concat(ref_record(name: base_ref, oid: oid), "\n")
}

data dispatch_ref_name: String = "refs/dispatch/attempt-a"

fn dispatch_ref_record() -> String {
  concat(ref_record(name: dispatch_ref_name, oid: dispatch_sha), "\n")
}

fn wt_entry(attributes: List<String>) -> String {
  concat(join(attributes, "\0"), "\0\0")
}

fn primary_entry(oid: String) -> String {
  wt_entry(attributes: [
    concat("worktree ", primary),
    concat("HEAD ", oid),
    "branch refs/heads/main",
  ])
}

fn linked_entry() -> String {
  wt_entry(attributes: [
    concat("worktree ", linked),
    concat("HEAD ", dispatch_sha),
    "branch refs/heads/dispatch/attempt-a",
  ])
}

fn linked_entry_detached() -> String {
  wt_entry(attributes: [
    concat("worktree ", linked),
    concat("HEAD ", dispatch_sha),
    "detached",
  ])
}

fn worktrees_wire(entries: List<String>) -> GitWorktreeSetObservation {
  git_worktree_set_observation_of(raw: join(entries, ""), exit_code: 0, stderr: "")
}

fn state_of(
  refs: GitRefSetObservation,
  worktrees: GitWorktreeSetObservation,
  head: String,
  reflog: String,
) -> RepositoryState {
  RepositoryState { refs: refs, worktrees: worktrees, head: head, reflog: reflog }
}

fn before_state() -> RepositoryState {
  state_of(
    refs: refs_wire(records: [base_ref_record(oid: old_sha), dispatch_ref_record()]),
    worktrees: worktrees_wire(entries: [primary_entry(oid: old_sha), linked_entry()]),
    head: old_sha,
    reflog: "old-reflog",
  )
}

fn verdict_for(after: RepositoryState) -> RepositoryConvergenceOutcome {
  repository_convergence_verdict(
    before: before_state(),
    after: after,
    candidate: new_sha,
    base_ref: base_ref,
    primary_path: primary,
  )
}

fn is_completed(o: RepositoryConvergenceOutcome) -> Bool {
  match o {
    ConvergenceCompleted { candidate: _, refs_preserved: _, worktrees_preserved: _ } => true
    _ => false
  }
}

// THE GREEN CONTROL. Base ref advanced, dispatch ref untouched, linked worktree still bound to its
// own branch, HEAD at the candidate, reflog grew. Without this every RED below would be satisfied by
// a function that refuses unconditionally.
test fn a_clean_transition_converges() -> Bool {
  let after = state_of(
    refs: refs_wire(records: [base_ref_record(oid: new_sha), dispatch_ref_record()]),
    worktrees: worktrees_wire(entries: [primary_entry(oid: new_sha), linked_entry()]),
    head: new_sha,
    reflog: "old-reflog\nnew-entry",
  )
  is_completed(o: verdict_for(after: after)) && repository_convergence_converged(outcome: verdict_for(after: after))
}

// THE PACKED-REFS DELETION TRAP, which is the defect a wholesale `packed-refs` replacement causes.
// The dispatch ref is simply gone from the post-state. Note the CARDINALITY IS UNCHANGED -- one ref
// left and the base ref moved -- so a count-equality check would pass here. Identity is the check.
test fn a_dispatch_ref_that_vanished_refuses() -> Bool {
  let after = state_of(
    refs: refs_wire(records: [base_ref_record(oid: new_sha)]),
    worktrees: worktrees_wire(entries: [primary_entry(oid: new_sha), linked_entry()]),
    head: new_sha,
    reflog: "old-reflog\nnew-entry",
  )
  match verdict_for(after: after) {
    ConvergenceRefDisappeared { refname: r, objectname: _ } => r == dispatch_ref_name
    _ => false
  }
}

// A LINKED WORKTREE'S REGISTRATION DROPPED. That is somebody's in-flight dispatch attempt, and it
// has nothing to do with this release.
test fn a_linked_worktree_that_vanished_refuses() -> Bool {
  let after = state_of(
    refs: refs_wire(records: [base_ref_record(oid: new_sha), dispatch_ref_record()]),
    worktrees: worktrees_wire(entries: [primary_entry(oid: new_sha)]),
    head: new_sha,
    reflog: "old-reflog\nnew-entry",
  )
  match verdict_for(after: after) {
    ConvergenceWorktreeDisappeared { path: p } => p == linked
    _ => false
  }
}

// A LINKED WORKTREE SILENTLY DETACHED. Present, same path, still counted -- and no longer on its
// branch, so the attempt's commits would land nowhere. Presence is not preservation.
test fn a_linked_worktree_rebound_to_detached_refuses() -> Bool {
  let after = state_of(
    refs: refs_wire(records: [base_ref_record(oid: new_sha), dispatch_ref_record()]),
    worktrees: worktrees_wire(entries: [primary_entry(oid: new_sha), linked_entry_detached()]),
    head: new_sha,
    reflog: "old-reflog\nnew-entry",
  )
  match verdict_for(after: after) {
    ConvergenceWorktreeRebound { path: p, detail: _ } => p == linked
    _ => false
  }
}

// THE SIGNATURE OF THE REALIZATION THIS REPLACES. HEAD reached the candidate and the reflog did not
// grow, so whatever moved it was not git -- a file written over `refs/**` leaves exactly this trace.
// Everything else about the post-state looks correct, which is why the check has to exist.
test fn a_head_that_moved_without_a_reflog_entry_refuses() -> Bool {
  let after = state_of(
    refs: refs_wire(records: [base_ref_record(oid: new_sha), dispatch_ref_record()]),
    worktrees: worktrees_wire(entries: [primary_entry(oid: new_sha), linked_entry()]),
    head: new_sha,
    reflog: "old-reflog",
  )
  match verdict_for(after: after) {
    ConvergenceHeadMovedWithoutReflog { candidate: c } => c == new_sha
    _ => false
  }
}

// THE NO-OP IS NOT THE REFLOG DEFECT, and this is the pair that keeps the check above honest. An
// already-converged repository legitimately adds no reflog entry; refusing it would fire on the
// healthy case. The two differ only in whether the BEFORE head was already the candidate.
test fn an_already_converged_repository_is_not_the_reflog_defect() -> Bool {
  let already = state_of(
    refs: refs_wire(records: [base_ref_record(oid: new_sha), dispatch_ref_record()]),
    worktrees: worktrees_wire(entries: [primary_entry(oid: new_sha), linked_entry()]),
    head: new_sha,
    reflog: "same-reflog",
  )
  let v = repository_convergence_verdict(
    before: state_of(
      refs: refs_wire(records: [base_ref_record(oid: new_sha), dispatch_ref_record()]),
      worktrees: worktrees_wire(entries: [primary_entry(oid: new_sha), linked_entry()]),
      head: new_sha,
      reflog: "same-reflog",
    ),
    after: already,
    candidate: new_sha,
    base_ref: base_ref,
    primary_path: primary,
  )
  match v {
    ConvergenceAlreadyAtCandidate { candidate: c } => c == new_sha
    _ => false
  }
}

// THE PRIMARY IS EXEMPT AND THE EXEMPTION IS NARROW. Its head moved from old to new, which is the
// operation's own effect, and that must not read as a rebinding. If the primary were checked like a
// linked worktree this returns Rebound and the operation could never succeed.
test fn the_primary_moving_is_not_a_rebinding() -> Bool {
  is_completed(o: verdict_for(after: state_of(
    refs: refs_wire(records: [base_ref_record(oid: new_sha), dispatch_ref_record()]),
    worktrees: worktrees_wire(entries: [primary_entry(oid: new_sha), linked_entry()]),
    head: new_sha,
    reflog: "old-reflog\nnew-entry",
  )))
}

// AN UNOBSERVABLE POST-STATE IS NOT A PRESERVED ONE. A refused enumeration carries no refs, and a
// comparison that treated it as an empty set would find nothing missing and report success -- the
// empty-observation narrow. This is the arm that makes ordering the observability check first
// load-bearing rather than tidy.
test fn an_unreadable_post_state_refuses_rather_than_reporting_preservation() -> Bool {
  let after = RepositoryState {
    refs: GitRefSetReadRefused { exit_code: 128, stderr: "not a git repository" },
    worktrees: worktrees_wire(entries: [primary_entry(oid: new_sha), linked_entry()]),
    head: new_sha,
    reflog: "old-reflog\nnew-entry",
  }
  match verdict_for(after: after) {
    ConvergencePostStateUnobservable { detail: d } => string_contains(s: d, pattern: "not a git repository")
    _ => false
  }
}

// HEAD SHORT OF THE CANDIDATE IS ITS OWN ARM, not folded into a generic failure: the remedy is to
// look at why the transition did not land, which is different from every preservation fault.
test fn a_head_short_of_the_candidate_refuses() -> Bool {
  let after = state_of(
    refs: refs_wire(records: [base_ref_record(oid: new_sha), dispatch_ref_record()]),
    worktrees: worktrees_wire(entries: [primary_entry(oid: old_sha), linked_entry()]),
    head: old_sha,
    reflog: "old-reflog\nnew-entry",
  )
  match verdict_for(after: after) {
    ConvergenceHeadNotAtCandidate { candidate: c, observed: o } => c == new_sha && o == old_sha
    _ => false
  }
}

test fn diag_refs_decode() -> Bool {
  match refs_wire(records: [base_ref_record(oid: old_sha), dispatch_ref_record()]) {
    GitRefSetObserved { refs: rs } => count(rs) == 2
    _ => false
  }
}

test fn diag_refs_not_undecodable() -> Bool {
  match refs_wire(records: [base_ref_record(oid: old_sha)]) {
    GitRefSetUndecodable { record_index: _, raw_record: _, reason: _ } => false
    _ => true
  }
}

test fn diag_worktrees_decode() -> Bool {
  match worktrees_wire(entries: [primary_entry(oid: old_sha), linked_entry()]) {
    GitWorktreeSetObserved { worktrees: ws } => count(ws) == 2
    _ => false
  }
}

test fn diag_worktrees_single() -> Bool {
  match worktrees_wire(entries: [primary_entry(oid: old_sha)]) {
    GitWorktreeSetObserved { worktrees: ws } => count(ws) == 1
    _ => false
  }
}

test fn diag_primary_path_is_bare() -> Bool {
  match worktrees_wire(entries: [primary_entry(oid: old_sha)]) {
    GitWorktreeSetObserved { worktrees: ws } =>
      match ws.first() {
        Present { value: w } => w.path == primary
        Absent => false
      }
    _ => false
  }
}
