module test.claim.constructor_tag_route_probe

// Controls for the std ConstructorTag<T> model (std.primitives). The carrier is imported, not
// declared here: a probe that re-declares its own carrier proves nothing about std, which is what
// the previous shape of this file did (it carried `ConstructorTag<T> = ConstructorTag { name:
// String }` and compared tags with `==` — a string discriminant in the public shape, the exact
// thing the design forbids).

import std.primitives { ConstructorTag, tag_of, same_arm }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

type WideProbe
  = W01 { a: Int }
  | W02 { a: String }
  | W03 { a: Int, b: Int }
  | W04
  | W05 { a: String }
  | W06 { a: Int }
  | W07 { a: String, b: String }
  | W08
  | W09 { a: Int }
  | W10 { a: String }
  | W11 { a: Int }
  | W12 { a: String }

// CONTROL 1: a value inhabits its own arm.
test fn tag_matches_the_value_it_came_from() -> Bool {
  same_arm(tag: tag_of(v: W11 { a: 1 }), v: W11 { a: 1 })
}

// CONTROL 2: the wrong arm answers FALSE — the comparison discriminates.
test fn wrong_arm_answers_false() -> Bool {
  !same_arm(tag: tag_of(v: W10 { a: "x" }), v: W12 { a: "x" })
}

// CONTROL 3: two distinct unit arms are not confused.
test fn distinct_unit_arms_answer_false() -> Bool {
  !same_arm(tag: tag_of(v: W04), v: W08)
}

// CONTROL 4: payload-blind. The same arm with different payloads answers TRUE.
test fn payload_is_blind_on_a_match() -> Bool {
  same_arm(tag: tag_of(v: W11 { a: 1 }), v: W11 { a: 2 })
}

// CONTROL 5 (RED i, positive form): a consumer that compares arms through the tag needs NO edit
// when the coproduct grows a variant. This file names only W10, W11, W12 and W04/W08; adding
// W13 to WideProbe leaves every control below compiling and answering the same. The refusal
// counterpart — a consumer that enumerates arms and therefore MUST be edited — is what
// `same_attestation_arm` used to be before it deleted.
test fn consumer_names_only_two_of_twelve_arms() -> Bool {
  same_arm(tag: tag_of(v: W01 { a: 1 }), v: W12 { a: "s" }) == false
    && same_arm(tag: tag_of(v: W03 { a: 1, b: 2 }), v: W03 { a: 9, b: 9 })
}

// CONTROL 7: the same for a unit arm, and it still discriminates.
test fn unit_arm_tag_reference_agrees_and_discriminates() -> Bool {
  discriminant(v: W08) == discriminant(v: W08)
    && same_arm(tag: tag_of(v: W08), v: W08)
    && !same_arm(tag: tag_of(v: W08), v: W04)
}
