module test.claim.floor_batch_clamp_authority_witness

import std.realization_schedule {
  RunnableBatchClamp,
  runnable_batch_clamp_ms,
}
import std.decl_ref { decl_ref }
import std.measure { second, millisecond, second_count, millisecond_count }
import std.types { NonEmptyStr }
import gunbc.ci_spec { gunbc_ci_floor_batch_clamp_params, gunbc_ci_compile_clean_clamp }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// The two populations that feed one aligned clamp list, asserted at their own declarations. A
// refusal that reports one population's number while citing the other's row is the defect these
// witnesses exist to keep unwritable (gunbc#7869: clamp_ms=360000 beside
// gunbc_ci_floor_batch_clamp_params[0], whose overhead is 240 seconds).
fn positional_clamp_row_zero() -> RunnableBatchClamp {
  match gunbc_ci_floor_batch_clamp_params {
    Empty => gunbc_ci_compile_clean_clamp
    Cons { head: h, tail: _ } => h
  }
}

// DECLARED RUNG DROP, and it is a real reduction rather than a climb. This population used to
// be the LIVE clamp of v1_claim_scoped_witness_batch — the only batch in the tree that owned
// its clamp instead of drawing a positional row. The v1 cut retired that batch with its subject
// (receipt: gunbc.ci_layer_roots v1_claim_scoped_witness_retirement_receipt), and no other
// clamp-owning batch exists, so there is nothing live to point this half at.
//
// WHAT IS LOST, stated exactly: the claim that some ACTUAL scheduled batch correctly cites its
// own declaration. That claim has no subject today and is not asserted anywhere.
// WHAT IS KEPT: the MECHANISM claim — that a batch-owned clamp and the positional row are
// distinguishable by authority and by value, so a refusal citing the wrong one is decidable.
// That is what the class was ever about and it stays real for the next clamp-owning batch.
// The synthetic carrier is deliberately NOT given ci_spec's module path or the positional row's
// 240-second overhead, because the whole discrimination is that the two differ on both axes.
// Restore-on: the next batch that owns a clamp repoints scoped_clamp at it and this note goes.
fn scoped_clamp() -> RunnableBatchClamp {
  RunnableBatchClamp {
    overhead: second(count: 720),
    per_unit: millisecond(count: 0),
    authority: decl_ref(
      module_path: "test.claim.floor_batch_clamp_authority_witness",
      decl_name: "scoped_clamp",
    ),
  }
}

test fn positional_clamp_row_zero_cites_the_ci_spec_list_it_lives_in() -> Bool {
  let c = positional_clamp_row_zero()
  (c.authority.module_path as String == "gunbc.ci_spec")
    && (c.authority.decl_name as String == "gunbc_ci_floor_batch_clamp_params")
    && (second_count(s: c.overhead) == 240)
}

test fn a_batch_owned_clamp_cites_its_own_declaration_not_the_positional_list() -> Bool {
  let c = scoped_clamp()
  (c.authority.module_path as String != "gunbc.ci_spec")
    && (c.authority.decl_name as String != "gunbc_ci_floor_batch_clamp_params")
    && (second_count(s: c.overhead) == 720)
    && (millisecond_count(m: c.per_unit) == 0)
}

// THE DISCRIMINATING CONTROL, and the reason the pair above is not two restatements of one fact:
// the two authorities carry DIFFERENT numbers, so a citation pointing at the wrong one is decidable
// rather than cosmetic. Re-point the scoped clamp's authority at gunbc.ci_spec and this goes red;
// so does making the two overheads equal, which would silently restore the ambiguity.
test fn the_two_clamp_authorities_are_distinguishable_by_value() -> Bool {
  let positional = positional_clamp_row_zero()
  let scoped = scoped_clamp()
  let positional_decl = positional.authority.decl_name as String
  let scoped_decl = scoped.authority.decl_name as String
  let positional_ms = runnable_batch_clamp_ms(clamp: positional, units: 27)
  let scoped_ms = runnable_batch_clamp_ms(clamp: scoped, units: 27)
  (positional_decl != scoped_decl) && (positional_ms != scoped_ms)
}

// units IS in the expression and contributes exactly zero on this row. The refusal prints
// `units=27`, which invites trimming the roster or splitting the batch; neither can move the
// threshold, and the split form would hand the same work a second overhead allowance.
test fn scoped_clamp_is_identical_at_one_unit_and_at_twenty_seven() -> Bool {
  let c = scoped_clamp()
  (runnable_batch_clamp_ms(clamp: c, units: 1) == runnable_batch_clamp_ms(clamp: c, units: 27))
    && (runnable_batch_clamp_ms(clamp: c, units: 27) == 720000)
}

// The positive control for the one above: a row whose rate is NONZERO must move with the unit
// count, or the equality test proves nothing about the formula and only that this file's arithmetic
// is constant.
test fn a_nonzero_rate_clamp_does_move_with_the_unit_count() -> Bool {
  let priced = RunnableBatchClamp {
    overhead: second(count: 300),
    per_unit: millisecond(count: 1000),
    authority: decl_ref(
      module_path: "test.claim.floor_batch_clamp_authority_witness",
      decl_name: "a_nonzero_rate_clamp_does_move_with_the_unit_count",
    ),
  }
  (runnable_batch_clamp_ms(clamp: priced, units: 1) == 301000)
    && (runnable_batch_clamp_ms(clamp: priced, units: 27) == 327000)
}
