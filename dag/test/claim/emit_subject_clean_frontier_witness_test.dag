module test.claim.emit_subject_clean_frontier_witness

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE RATCHET'S OWN EVIDENCE. Every input here is authored beside its expected verdict, so nothing
// is compared against a measurement taken from the tree these claims judge — the fold's live-corpus
// population is a separate claim with a separate cost, and pinning one here would be the tree-copied
// census DESIGN §5 refuses.
//
// THE REDS ARE THE POINT, and they come in three kinds. The ratchet's two directions each have one
// (an entry that stops being clean refuses; an admission row whose debt was paid refuses), and the
// third is the one the whole carrier exists for: a reading that established no population must not
// arrive as CLEAN. That last claim is asserted against a control that differs from it in exactly one
// field, so a green cannot be an accident of the fixture.

data fixture_roots: List<String> = ["dag", "src/v2"]

fn fixture_policy() -> RosterDiscoveryPolicy {
  DeclarationIndexUnderRoots { roots: fixture_roots }
}

data fixture_alpha: String = "dag/fixture/alpha.dag"
data fixture_beta: String = "dag/fixture/beta.dag"

data fixture_roster: List<String> = [fixture_alpha, fixture_beta]

data fixture_blocking_diagnostic: GunbcDiagnostic = GunbcDiagnostic {
  severity: "error",
  location: "dag/fixture/alpha.dag:1",
  message: "a blocking diagnostic"
}

data fixture_advisory_diagnostic: GunbcDiagnostic = GunbcDiagnostic {
  severity: "advisory",
  location: "dag/fixture/alpha.dag:2",
  message: "an advisory diagnostic"
}

fn fixture_admission_for(entry: String) -> EmitDebtAdmission {
  emit_debt_admission(
    entry: entry,
    owner: "test.claim.emit_subject_clean_frontier_witness",
    reason: "fixture admission — this entry is admitted as debt so the held arm has an input",
    dissolution: unbound_dissolution(description: "🟡 dissolve-on: the fixture is deleted with its claims")
  )
}

fn fixture_reading(entry: String, outcome: EmitSubjectOutcome) -> EmitSubjectReading {
  EmitSubjectReading { entry: entry, outcome: outcome }
}

fn fixture_fold_of(
  roster: List<String>,
  admissions: List<EmitDebtAdmission>,
  readings: List<EmitSubjectReading>
) -> EmitSubjectCleanRatchet {
  fold_emit_subject_clean_ratchet_over_readings(
    universe: IndexOnlyUniverse { policy: fixture_policy(), entries: roster },
    admissions: admissions,
    selection: SelectionWholeRoster,
    readings: readings
  )
}

fn fixture_verdict_rows(
  roster: List<String>,
  admissions: List<EmitDebtAdmission>,
  readings: List<EmitSubjectReading>
) -> List<String> {
  map(
    fixture_fold_of(roster: roster, admissions: admissions, readings: readings).verdicts,
    v => emit_ratchet_verdict_row(v: v)
  )
}

fn fixture_standing_holds(
  roster: List<String>,
  admissions: List<EmitDebtAdmission>,
  readings: List<EmitSubjectReading>
) -> Bool {
  match emit_ratchet_standing(r: fixture_fold_of(roster: roster, admissions: admissions, readings: readings)) {
    EmitRatchetHeld { subject_count: _ } => true
    EmitRatchetRefused { failing_rows: _ } => false
  }
}

fn fixture_failing_rows(
  roster: List<String>,
  admissions: List<EmitDebtAdmission>,
  readings: List<EmitSubjectReading>
) -> List<String> {
  match emit_ratchet_standing(r: fixture_fold_of(roster: roster, admissions: admissions, readings: readings)) {
    EmitRatchetHeld { subject_count: _ } => []
    EmitRatchetRefused { failing_rows: rows } => rows
  }
}

fn fixture_dual_fold(
  inventory: List<String>,
  readings: List<EmitSubjectReading>
) -> EmitSubjectCleanRatchet {
  fold_emit_subject_clean_ratchet_over_readings(
    universe: DualUniverse {
      policy: fixture_policy(),
      entries: fixture_roster,
      inventory: inventory
    },
    admissions: [],
    selection: SelectionWholeRoster,
    readings: readings
  )
}

fn fixture_both_clean() -> List<EmitSubjectReading> {
  [fixture_reading(entry: fixture_alpha, outcome: EmitSubjectClean), fixture_reading(entry: fixture_beta, outcome: EmitSubjectClean)]
}

// ---------------------------------------------------------------------------------------------
// THE DERIVATION: a population becomes a standing, and the extent decides the zero case.
// ---------------------------------------------------------------------------------------------

test fn a_complete_population_with_no_blocking_diagnostic_is_clean() -> Bool {
  emit_outcome_of_population(ds: [fixture_advisory_diagnostic], files: FilesEmitted { count: 12 })
    == EmitSubjectClean
}

// THE CENTRAL RED, AND ITS CONTROL IS THE CLAIM ABOVE. The two differ in exactly one field: whether
// emit reported a tree. A population of zero blocking diagnostics taken from a run that returned
// before writing one is a prefix of unknown length, and reading it as CLEAN is the defect this whole
// carrier exists to prevent — the empty observation rendered as the passing verdict.
test fn a_zero_population_of_unestablished_extent_is_not_clean() -> Bool {
  emit_outcome_of_population(ds: [fixture_advisory_diagnostic], files: FilesNotWritten)
    == EmitSubjectNotEvaluated { cause: ExtentUnestablished }
}

// A blocking diagnostic found in a prefix is still a blocking diagnostic, so the extent must NOT
// promote a suspect population to unestablished.
test fn a_blocking_diagnostic_is_suspect_whatever_the_extent() -> Bool {
  emit_outcome_of_population(ds: [fixture_blocking_diagnostic], files: FilesNotWritten)
    == EmitSubjectBlocked { cause: BlockingDiagnostics { blocking: 1 } }
    && emit_outcome_of_population(ds: [fixture_blocking_diagnostic], files: FilesEmitted { count: 3 })
      == EmitSubjectBlocked { cause: BlockingDiagnostics { blocking: 1 } }
}

// A refusal that PRINTED diagnostics reports them; only one that printed none falls back to the
// exit code. Reporting the exit code in both cases would discard what the compiler did say.
test fn a_refusal_reports_its_diagnostics_and_falls_back_only_without_them() -> Bool {
  emit_outcome_of_refusal(exit_code: 1, ds: [fixture_blocking_diagnostic])
    == EmitSubjectBlocked { cause: BlockingDiagnostics { blocking: 1 } }
    && emit_outcome_of_refusal(exit_code: 101, ds: [fixture_advisory_diagnostic])
      == EmitSubjectBlocked { cause: RefusedWithoutBlockingPopulation { exit_code: 101 } }
}

// RED, ACROSS THE MEASUREMENT SEAM RATHER THAN INSIDE THE DERIVATION: a measurement that never
// reached the emitter carries no population at all, and the reading it produces must say so rather
// than reporting an empty one.
test fn a_measurement_that_never_reached_the_emitter_produces_no_population() -> Bool {
  emit_subject_reading(
    m: EmissionSubjectUnestablished {
      entry: fixture_alpha,
      stage: StageBinaries,
      cause: "the release binaries are not buildable"
    }
  ) == EmitSubjectReading {
    entry: fixture_alpha,
    outcome: EmitSubjectNotEvaluated {
      cause: PopulationUnproduced {
        stage: StageBinaries,
        cause: "the release binaries are not buildable"
      }
    }
  }
}

// THE OWNER SPLIT, RUN IN BOTH DIRECTIONS OVER THE SAME SHAPE. A stage BEFORE the emitter says no
// population was produced; a stage AFTER it says the population exists and the READER could not
// recover it. The two arms have opposite owners and opposite repairs, and this is the arm hole 3's
// live specimen lands in: `dag/std/abi.dag` loses the entry-scope marker to a bounded stderr tail,
// so the emitter ran fine and only the read failed. Collapsing both into `PopulationUnproduced`
// would tell a human the compiler produced nothing, which is false about the subject.
test fn a_read_that_failed_after_the_emitter_ran_names_the_reader_and_not_the_emitter() -> Bool {
  not_evaluated_cause_for_stage(stage: StageEmitDecode, cause: "scope unconfirmed")
    == PopulationUnreadable { stage: StageEmitDecode, cause: "scope unconfirmed" }
    && not_evaluated_cause_for_stage(stage: StageEmit, cause: "the emitter never ran")
      == PopulationUnproduced { stage: StageEmit, cause: "the emitter never ran" }
    && not_evaluated_cause_for_stage(stage: StageBinaries, cause: "no binaries")
      == PopulationUnproduced { stage: StageBinaries, cause: "no binaries" }
}

// AND NEITHER ARM IS COMPARABLE TO CLEAN. The owner split is a repair to the TEXT a person acts on;
// it must not become a second route by which a not-evaluated subject stops stopping the line.
test fn an_unreadable_population_is_still_not_evaluated_and_still_refuses() -> Bool {
  let readings = [
    fixture_reading(
      entry: fixture_alpha,
      outcome: EmitSubjectNotEvaluated {
        cause: PopulationUnreadable { stage: StageEmitDecode, cause: "scope unconfirmed" }
      }
    ),
    fixture_reading(entry: fixture_beta, outcome: EmitSubjectClean)
  ]
  !fixture_standing_holds(roster: fixture_roster, admissions: [], readings: readings)
    && !fixture_standing_holds(
      roster: fixture_roster,
      admissions: [fixture_admission_for(entry: fixture_alpha)],
      readings: readings
    )
}

// ---------------------------------------------------------------------------------------------
// THE JOIN: the two ratchet directions.
// ---------------------------------------------------------------------------------------------

test fn a_roster_measured_clean_with_no_admissions_holds() -> Bool {
  fixture_standing_holds(roster: fixture_roster, admissions: [], readings: fixture_both_clean())
    && fixture_verdict_rows(roster: fixture_roster, admissions: [], readings: fixture_both_clean())
      == ["clean-held\tdag/fixture/alpha.dag", "clean-held\tdag/fixture/beta.dag"]
}

// RED, DIRECTION ONE: an entry carrying no admission row that stops being clean is the regression
// the contract exists to prevent, and it refuses at identity grain — the row names the entry.
test fn an_entry_off_the_frontier_that_stops_being_clean_refuses_by_name() -> Bool {
  let readings = [
    fixture_reading(entry: fixture_alpha, outcome: EmitSubjectBlocked { cause: BlockingDiagnostics { blocking: 4 } }),
    fixture_reading(entry: fixture_beta, outcome: EmitSubjectClean)
  ]
  !fixture_standing_holds(roster: fixture_roster, admissions: [], readings: readings)
    && fixture_failing_rows(roster: fixture_roster, admissions: [], readings: readings)
      == ["REGRESSED\tdag/fixture/alpha.dag\t4 blocking diagnostic(s)\tthis entry carries no admission row, so it is expected to emit clean"]
}

// THE SAME READING, ADMITTED: one admission row is the entire difference between the refusal above
// and the hold here, which is what makes admission the mechanism rather than the count.
test fn the_same_suspect_entry_holds_once_it_carries_an_admission_row() -> Bool {
  let readings = [
    fixture_reading(entry: fixture_alpha, outcome: EmitSubjectBlocked { cause: BlockingDiagnostics { blocking: 4 } }),
    fixture_reading(entry: fixture_beta, outcome: EmitSubjectClean)
  ]
  fixture_standing_holds(roster: fixture_roster, admissions: [fixture_admission_for(entry: fixture_alpha)], readings: readings)
    && fixture_verdict_rows(roster: fixture_roster, admissions: [fixture_admission_for(entry: fixture_alpha)], readings: readings)
      == [
        "debt-held\tdag/fixture/alpha.dag\t4 blocking diagnostic(s)",
        "clean-held\tdag/fixture/beta.dag"
      ]
}

// RED, DIRECTION TWO, AND IT IS WHAT MAKES THIS A RATCHET RATHER THAN A SNAPSHOT: an admission row
// whose entry now emits clean is a false statement about the tree, and a debt roster that keeps
// paid rows stops describing the remaining work.
test fn an_admission_row_whose_debt_was_paid_refuses_until_it_is_deleted() -> Bool {
  !fixture_standing_holds(roster: fixture_roster, admissions: [fixture_admission_for(entry: fixture_alpha)], readings: fixture_both_clean())
    && fixture_failing_rows(roster: fixture_roster, admissions: [fixture_admission_for(entry: fixture_alpha)], readings: fixture_both_clean())
      == ["FRONTIER-STALE\tdag/fixture/alpha.dag\tthe entry emits clean and its admission row is now a false statement about the tree — delete the row"]
}

// RED: a not-evaluated outcome is neither of the two ratchet directions and takes neither's arm.
// It refuses whether or not the entry carries an admission row, because an admission is a statement
// about a MEASURED debt and nothing here was measured.
test fn a_not_evaluated_outcome_refuses_on_and_off_the_frontier() -> Bool {
  let readings = [
    fixture_reading(entry: fixture_alpha, outcome: EmitSubjectNotEvaluated { cause: ExtentUnestablished }),
    fixture_reading(entry: fixture_beta, outcome: EmitSubjectNotEvaluated { cause: ExtentUnestablished })
  ]
  !fixture_standing_holds(roster: fixture_roster, admissions: [], readings: readings)
    && !fixture_standing_holds(roster: fixture_roster, admissions: [fixture_admission_for(entry: fixture_alpha)], readings: readings)
}

// RED: a run that measured some of its roster cannot answer a closed-universe claim, and the
// unmeasured subjects are named rather than absorbed into the ones that were measured.
test fn a_partial_run_refuses_and_names_the_subjects_it_did_not_measure() -> Bool {
  let readings = [fixture_reading(entry: fixture_alpha, outcome: EmitSubjectClean)]
  !fixture_standing_holds(roster: fixture_roster, admissions: [], readings: readings)
    && fixture_failing_rows(roster: fixture_roster, admissions: [], readings: readings)
      == ["UNMEASURED\tdag/fixture/beta.dag\ton_frontier\tfalse\tthe instrument was asked about this subject and produced no reading for it — a deficit in the run, not its scope"]
}

// RED: an admission row naming a subject the discovered roster does not contain is a row to delete,
// and it is reported as itself rather than as one more unmeasured subject — the two have opposite
// owners.
test fn an_admission_row_outside_the_roster_is_an_orphan_not_a_missing_measurement() -> Bool {
  let admissions = [fixture_admission_for(entry: "dag/fixture/departed.dag")]
  !fixture_standing_holds(roster: fixture_roster, admissions: admissions, readings: fixture_both_clean())
    && fixture_failing_rows(roster: fixture_roster, admissions: admissions, readings: fixture_both_clean())
      == ["ADMISSION-ORPHAN\tdag/fixture/departed.dag\tthis admission row names a subject the discovered roster does not contain"]
}

// RED: an admission with no owner is not an admission. The owner is the fact std.roster_frontier's
// row does not carry and the reason this carrier decomposes it rather than reusing the row bare.
test fn an_admission_without_an_owner_is_malformed() -> Bool {
  let admissions = [
    emit_debt_admission(
      entry: fixture_alpha,
      owner: "",
      reason: "a reason with nobody accountable for retiring it",
      dissolution: unbound_dissolution(description: "🟡 dissolve-on: never, which is the point")
    )
  ]
  count(
    filter(
      fixture_failing_rows(roster: fixture_roster, admissions: admissions, readings: fixture_both_clean()),
      row => string_contains(s: row, pattern: "ADMISSION-MALFORMED\tdag/fixture/alpha.dag")
    )
  ) == 1
}

// ---------------------------------------------------------------------------------------------
// THE UNIVERSE ITSELF.
// ---------------------------------------------------------------------------------------------

// RED, AND IT IS THE EMPTY-OBSERVATION NARROW IN ITS PUREST FORM: a discovery that returned nothing
// would otherwise report the strongest standing available, because every claim holds vacuously over
// an empty universe. It refuses instead, and names the policy that discovered nothing.
test fn a_roster_of_no_subjects_refuses_rather_than_holding_vacuously() -> Bool {
  !fixture_standing_holds(roster: [], admissions: [], readings: [])
    && count(
      filter(
        fixture_failing_rows(roster: [], admissions: [], readings: []),
        row => string_contains(s: row, pattern: "ROSTER-EMPTY")
      )
    ) == 1
}

// The standing travels with the universe it was folded over: a report that carries a verdict
// without the roster that produced it cannot be joined to any other run.
test fn the_report_carries_the_discovery_policy_and_the_roster_digest() -> Bool {
  let rows = emit_ratchet_report_rows(binding: BindingAbsent, selection: SelectionWholeRoster, r: fixture_fold_of(roster: fixture_roster, admissions: [], readings: fixture_both_clean()))
  count(filter(rows, row => string_contains(s: row, pattern: "roster_policy\tparsed declaration index under dag, src/v2"))) == 1
    && count(filter(rows, row => string_contains(s: row, pattern: "roster_digest\t"))) == 1
    && count(filter(rows, row => string_contains(s: row, pattern: "roster_subjects\t2"))) == 1
}

// TWO DIFFERENT ROSTERS ARE TWO DIFFERENT UNIVERSES, and the digest is what says so. A standing
// read without it cannot tell a run over the whole roster from a run over a roster that lost
// subjects — and a lost subject is exactly how a count-shaped contract reports progress it did not
// make.
test fn a_roster_that_lost_a_subject_carries_a_different_digest() -> Bool {
  match universe_roster_identity(u: IndexOnlyUniverse { policy: fixture_policy(), entries: fixture_roster }) {
    RosterEmpty { policy: _, denominators: _ } => false
    RosterIdentified { policy: _, denominators: _, subject_count: _, digest: whole } =>
      match universe_roster_identity(u: IndexOnlyUniverse { policy: fixture_policy(), entries: [fixture_alpha] }) {
        RosterEmpty { policy: _, denominators: _ } => false
        RosterIdentified { policy: _, denominators: _, subject_count: _, digest: partial } =>
          !(whole.digest as String == partial.digest as String)
      }
  }
}

// EVERY VERDICT NAMES ITS SUBJECT, whichever arm it took. That is what "identity grain" means
// operationally: there is no arm from which the entry has to be recovered by position in a list
// parallel to the roster, which is how a verdict and its subject drift apart.
test fn every_verdict_carries_the_entry_it_is_about() -> Bool {
  let readings = [
    fixture_reading(entry: fixture_alpha, outcome: EmitSubjectNotEvaluated { cause: ExtentUnestablished })
  ]
  map(
    fixture_fold_of(roster: fixture_roster, admissions: [], readings: readings).verdicts,
    v => emit_ratchet_verdict_entry(v: v)
  ) == fixture_roster
}

// ---------------------------------------------------------------------------------------------
// THE TWO DECLARED HOLES, PINNED BY EXECUTION.
//
// Both claims are GREEN WHILE THE HOLE IS OPEN. That inversion is deliberate and it is the only
// thing that makes a pinned defect safe: each identity is named after the DEFECT rather than after
// a check, so a reader scanning green rows reads the gap rather than counting coverage. When the
// wall lands, the claim goes RED and its own name says why — which is what forces its deletion
// instead of leaving a note nobody re-reads.
// ---------------------------------------------------------------------------------------------

// HOLE 1. A subject already carrying a blocker can acquire another and the frontier does not move:
// it was blocked before, it is blocked now, the admission row still covers it, nothing refuses.
// The two readings below differ in blocker COUNT and produce the SAME held verdict, which is the
// hole exactly — and the count is display here, never the thing admission turns on, because a
// count-keyed ratchet is defeated by an upstream refusal that makes the count FALL.
//
// DISSOLVES WHEN: the emitter reports semantic blocker identities, `added_blockers` activates, and
// admission moves to cause grain. At that point this claim goes red and is deleted with the hole.
test fn blocked_subject_gaining_a_blocker_is_held_not_refused() -> Bool {
  let one = [
    fixture_reading(entry: fixture_alpha, outcome: EmitSubjectBlocked { cause: BlockingDiagnostics { blocking: 1 } }),
    fixture_reading(entry: fixture_beta, outcome: EmitSubjectClean)
  ]
  let two = [
    fixture_reading(entry: fixture_alpha, outcome: EmitSubjectBlocked { cause: BlockingDiagnostics { blocking: 2 } }),
    fixture_reading(entry: fixture_beta, outcome: EmitSubjectClean)
  ]
  fixture_standing_holds(roster: fixture_roster, admissions: [fixture_admission_for(entry: fixture_alpha)], readings: one)
    && fixture_standing_holds(roster: fixture_roster, admissions: [fixture_admission_for(entry: fixture_alpha)], readings: two)
}

// AND THE WALL THAT DOES HOLD, stated beside the hole so the pair cannot be read as "the ratchet
// does nothing". `Clean -> Blocked` refuses for every subject carrying no admission row, which is
// acceptance mutation 1a and needs no blocker identity — only the ability to tell zero blockers
// from nonzero, which the three-valued outcome already does.
test fn clean_subject_gaining_a_blocker_refuses_which_is_the_wall_that_holds() -> Bool {
  let regressed = [
    fixture_reading(entry: fixture_alpha, outcome: EmitSubjectBlocked { cause: BlockingDiagnostics { blocking: 1 } }),
    fixture_reading(entry: fixture_beta, outcome: EmitSubjectClean)
  ]
  !fixture_standing_holds(roster: fixture_roster, admissions: [], readings: regressed)
}

// HOLE 2, NOW CLOSED — AND THIS IS THE SAME CLAIM FLIPPED, NOT A NEW ONE. It was pinned as
// `a_file_the_index_cannot_classify_vanishes_from_the_universe_instead_of_blocking`, green while
// the hole was open. The dual denominator turns it red, so per §4b(4) it is converted to the
// regression control that keeps the closure real rather than deleted with the machinery it
// obsoleted: the climb deletes the production handling, never the evidence.
//
// A file on disk that the index could not classify is a SUBJECT and it is BLOCKED. The control
// beside it is the index-only universe, which still loses the file entirely — so the pair shows the
// second denominator doing the work, and not some other difference between the two runs.
test fn a_file_the_index_cannot_classify_blocks_instead_of_vanishing() -> Bool {
  let hidden = "dag/fixture/unclassifiable.dag"
  let dual = fixture_dual_fold(
    inventory: [fixture_alpha, fixture_beta, hidden],
    readings: fixture_both_clean()
  )
  count(dual.verdicts) == 3
    && count(
      filter(ratchet_failing_rows(r: dual), row => string_contains(s: row, pattern: hidden))
    ) == 1
    && count(fixture_fold_of(roster: fixture_roster, admissions: [], readings: fixture_both_clean()).verdicts) == 2
}

// AND IT BLOCKS RATHER THAN READING AS NOT-EVALUATED, which is the distinction the closure turns
// on. "The instrument did not reach it" and "nothing can reach it at all" are different facts:
// nothing can name an unclassified file as an entry, so there is no compile to run, and calling
// that an unreached measurement would invite someone to go and take one.
test fn an_unclassified_file_is_blocked_at_classification_not_merely_unmeasured() -> Bool {
  let hidden = "dag/fixture/unclassifiable.dag"
  map(
    universe_classification_readings(
      u: DualUniverse {
        policy: fixture_policy(),
        entries: fixture_roster,
        inventory: [fixture_alpha, hidden]
      }
    ),
    reading => reading.outcome
  ) == [EmitSubjectBlocked { cause: UnclassifiedByModuleIndex }]
}

// A MEASUREMENT CANNOT OVERWRITE A CLASSIFICATION. An unclassified file has no compile to run, so a
// reading claiming to have measured one is incoherent — and the fold enforces that by ordering
// rather than by a check, since lookup takes the first match.
test fn a_measurement_cannot_overwrite_an_unclassified_files_classification() -> Bool {
  let hidden = "dag/fixture/unclassifiable.dag"
  let dual = fold_emit_subject_clean_ratchet_over_readings(
    universe: DualUniverse {
      policy: fixture_policy(),
      entries: fixture_roster,
      inventory: [fixture_alpha, fixture_beta, hidden]
    },
    admissions: [],
    selection: SelectionWholeRoster,
    readings: concat(fixture_both_clean(), [fixture_reading(entry: hidden, outcome: EmitSubjectClean)])
  )
  count(
    filter(ratchet_failing_rows(r: dual), row => string_contains(s: row, pattern: hidden))
  ) == 1
}

// ACCEPTANCE MUTATION 2, AND IT HOLDS TODAY. An upstream refusal that masks a subject's population
// must not read as improvement. The masked subject was BLOCKED and its mask makes it look clean to
// any instrument that counts diagnostics — here it becomes NOT-EVALUATED and the standing refuses,
// so the mask surfaces as a stopped line rather than as progress.
//
// The discriminating pair is the point: the SAME subject reported as genuinely clean HOLDS. So the
// refusal is a fact about the mask and not about the fixture.
test fn an_upstream_mask_refuses_rather_than_reading_as_improvement() -> Bool {
  let masked = [
    fixture_reading(entry: fixture_alpha, outcome: EmitSubjectNotEvaluated { cause: ExtentUnestablished }),
    fixture_reading(entry: fixture_beta, outcome: EmitSubjectClean)
  ]
  !fixture_standing_holds(roster: fixture_roster, admissions: [fixture_admission_for(entry: fixture_alpha)], readings: masked)
    && !fixture_standing_holds(roster: fixture_roster, admissions: [], readings: masked)
    && fixture_standing_holds(roster: fixture_roster, admissions: [], readings: fixture_both_clean())
}

// ---------------------------------------------------------------------------------------------
// THE ENROLMENT WALL, PER MODE.
//
// The wall used to answer one question from one fact, and the witness beneath it proved both arms of
// that one fact reachable. That is no longer enough, and the reason is a change in the tree rather
// than a change of mind: while the denominator was the only disqualifier, permitting on it was
// permitting on everything. Hole 2 closed, dual-denominator folds became producible, and the same
// wall then said PERMITTED about a carrier whose subjects have no verdicts at all.
//
// So these claims are written against the fact that DISCRIMINATES the two modes, not against the
// mode label. Each pairs a refusing input with a control differing in exactly one field, so a green
// cannot be an accident of the fixture, and each names WHICH mode it refuses -- an observation that
// refuses for a gate's reasons would be the empty-observation narrow, and a gate that permits for an
// observation's reasons is the merge-blocking baseline this lane exists to prevent.
// ---------------------------------------------------------------------------------------------

fn fixture_empty_dual_fold() -> EmitSubjectCleanRatchet {
  fold_emit_subject_clean_ratchet_over_readings(
    universe: DualUniverse { policy: fixture_policy(), entries: [], inventory: [] },
    admissions: [],
    selection: SelectionWholeRoster,
    readings: []
  )
}

fn fixture_one_unevaluated() -> List<EmitSubjectReading> {
  [
    fixture_reading(entry: fixture_alpha, outcome: EmitSubjectClean),
    fixture_reading(entry: fixture_beta, outcome: EmitSubjectNotEvaluated { cause: ExtentUnestablished })
  ]
}

fn fixture_one_regressed() -> List<EmitSubjectReading> {
  [
    fixture_reading(entry: fixture_alpha, outcome: EmitSubjectClean),
    fixture_reading(entry: fixture_beta, outcome: EmitSubjectBlocked { cause: BlockingDiagnostics { blocking: 1 } })
  ]
}

fn fixture_gate_admission(r: EmitSubjectCleanRatchet) -> EmitRatchetEnrolmentAdmission {
  emit_ratchet_enrolment_admission(enrolment: EnrolledAsGate, r: r)
}

fn fixture_observation_admission(r: EmitSubjectCleanRatchet) -> EmitRatchetEnrolmentAdmission {
  emit_ratchet_enrolment_admission(enrolment: EnrolledAsObservation, r: r)
}

fn fixture_admission_permits(admission: EmitRatchetEnrolmentAdmission) -> Bool {
  match admission {
    EnrolmentPermitted { enrolment: _ } => true
    EnrolmentRefusedNoUniverse { enrolment: _ } => false
    EnrolmentRefusedDenominator { enrolment: _, missing: _ } => false
    EnrolmentRefusedUnevaluated { enrolment: _, subjects: _ } => false
  }
}

// RED: a single-denominator carrier still cannot be gated on, and WHICH refusal it receives is
// asserted as a VARIANT rather than as a substring of the refusal's prose. The refusal does still
// name the missing denominator -- that is what `missing` carries -- but the naming is REPORT
// RENDERING and this row's declared subject is the semantic admission, so pinning the wording here
// would red this claim on an edit to a different authority. The control is the SAME readings under a
// dual denominator, so the refusal is about the universe's provenance and not about the fixture.
test fn a_single_denominator_carrier_refuses_a_gate_and_permits_none() -> Bool {
  match fixture_gate_admission(r: fixture_fold_of(roster: fixture_roster, admissions: [], readings: fixture_both_clean())) {
    EnrolmentRefusedDenominator { enrolment: e, missing: _ } => e == EnrolledAsGate
    EnrolmentPermitted { enrolment: _ } => false
    EnrolmentRefusedNoUniverse { enrolment: _ } => false
    EnrolmentRefusedUnevaluated { enrolment: _, subjects: _ } => false
  }
    && fixture_admission_permits(
      admission: fixture_gate_admission(r: fixture_dual_fold(inventory: fixture_roster, readings: fixture_both_clean()))
    )
}

// AND THE SAME CARRIER IS AN ADMISSIBLE OBSERVATION. This is the claim that makes the two modes
// different questions rather than one question with a label: refusing to LOOK because the universe
// was discovered under one denominator is the narrow, committed at the point where the reading is
// taken. What a single denominator disqualifies is DECIDING, and the report prints its denominators
// so the reading cannot be quoted wider than it was taken.
test fn a_single_denominator_carrier_is_still_an_admissible_observation() -> Bool {
  fixture_admission_permits(
    admission: fixture_observation_admission(r: fixture_fold_of(roster: fixture_roster, admissions: [], readings: fixture_both_clean()))
  )
    && !fixture_admission_permits(
      admission: fixture_gate_admission(r: fixture_fold_of(roster: fixture_roster, admissions: [], readings: fixture_both_clean()))
    )
}

// RED, AND IT IS THE ONE THE OLD WALL COULD NOT PRODUCE: a DUAL-denominator fold — everything the
// previous wall consulted, answered in the permitting direction — whose roster contains a subject
// with no verdict at all. Gating on it would decide a closed-universe question over an open one, so
// it refuses and NAMES the subjects that have no verdict, because that list is the work that closes
// the gap. The control differs in exactly one field: the same fold with that one reading clean
// permits, which is what makes this a wall over the verdicts rather than a second denominator check.
test fn a_gate_refuses_a_dual_denominator_fold_whose_subjects_were_never_evaluated() -> Bool {
  match fixture_gate_admission(r: fixture_dual_fold(inventory: fixture_roster, readings: fixture_one_unevaluated())) {
    EnrolmentRefusedUnevaluated { enrolment: _, subjects: ss } => ss == [fixture_beta]
    EnrolmentPermitted { enrolment: _ } => false
    EnrolmentRefusedNoUniverse { enrolment: _ } => false
    EnrolmentRefusedDenominator { enrolment: _, missing: _ } => false
  }
    && fixture_admission_permits(
      admission: fixture_gate_admission(r: fixture_dual_fold(inventory: fixture_roster, readings: fixture_both_clean()))
    )
}

// AND AN UNEVALUATED SUBJECT DOES NOT STOP THE OBSERVATION. It is the observation's CONTENT: hole 3
// says a realistic universe folds to a wall of not-evaluated rows today, and a reading that refuses
// to be taken because its subjects are unmeasured reports nothing about the very population it was
// built to expose. The standing still refuses inside it — this claim is about who may be told, not
// about the news being good.
test fn an_unevaluated_subject_is_observed_rather_than_suppressed() -> Bool {
  fixture_admission_permits(
    admission: fixture_observation_admission(r: fixture_dual_fold(inventory: fixture_roster, readings: fixture_one_unevaluated()))
  )
    && !fixture_admission_permits(
      admission: fixture_gate_admission(r: fixture_dual_fold(inventory: fixture_roster, readings: fixture_one_unevaluated()))
    )
}

// ---------------------------------------------------------------------------------------------
// EXECUTION PROVENANCE: the observation that was not taken, and the observation whose news is bad.
//
// DESIGN's test is stated as an equality between renderings: if a count of zero and an unreached
// stage produce the same output, the number is not an observation. These two claims are that test
// run in both directions, and the pair is the point — either alone is satisfiable by a carrier that
// simply always refuses or always permits.
// ---------------------------------------------------------------------------------------------

// RED: a fold that discovered nothing DISPATCHES TO THE NOT-TAKEN ARM, and it names the refusal
// STRUCTURALLY rather than by matching prose.
//
// WHAT THIS ROW DELIBERATELY DOES NOT ASSERT, because the first shape of it did and the assertion
// could not fail: that the not-taken arm holds no standing. That is true, and it is true BY
// CONSTRUCTION -- the variant has no such field, so the violating state is unauthorable in the
// corpus AND in a fixture, which §4b names as exactly the case where the right answer is no check
// at all. Three of that row's four conjuncts were substring matches over rendered text, so the one
// artifact a reader would have cited as proof of execution provenance was a change detector: red on
// any wording edit, green on any cause carrying the phrase. The property survives in the type; only
// its fake evidence is gone.
//
// WHAT REMAINS IS THE PART THAT CAN FAIL FOR THE RIGHT REASON: which arm an unobservable fold routes
// to, and which refusal it carries. Both halves are now variant matches, so a prose edit moves
// nothing here and a dispatch change reds it.
test fn an_empty_dual_fold_yields_no_observation() -> Bool {
  match emit_ratchet_observation(binding: BindingAbsent, selection: SelectionWholeRoster, r: fixture_empty_dual_fold()) {
    ObservationNotTaken { binding: _, admission: a } =>
      match a {
        EnrolmentRefusedNoUniverse { enrolment: e } => e == EnrolledAsObservation
        EnrolmentPermitted { enrolment: _ } => false
        EnrolmentRefusedDenominator { enrolment: _, missing: _ } => false
        EnrolmentRefusedUnevaluated { enrolment: _, subjects: _ } => false
      }
    ObservationTaken { binding: _, selection: _, roster: _, unevaluated_subjects: _, standing: _ } => false
  }
    && match emit_ratchet_observation(binding: BindingAbsent, selection: SelectionWholeRoster, r: fixture_dual_fold(inventory: fixture_roster, readings: fixture_both_clean())) {
      ObservationTaken { binding: _, selection: _, roster: _, unevaluated_subjects: _, standing: s } => s == EmitRatchetHeld { subject_count: 2 }
      ObservationNotTaken { binding: _, admission: _ } => false
    }
}

// AND THE OTHER DIRECTION, which is the half a carrier that always refuses would fail: an entry that
// STOPPED being clean is a TAKEN observation carrying a REFUSING standing. The observation succeeded;
// the corpus is what is wrong. Collapsing this into the not-taken arm would be the mirror defect —
// bad news rendered as no news — and it is what would make an observation-first enrolment worthless.
test fn a_refusing_standing_is_a_taken_observation_and_not_a_missing_one() -> Bool {
  match emit_ratchet_observation(binding: BindingAbsent, selection: SelectionWholeRoster, r: fixture_dual_fold(inventory: fixture_roster, readings: fixture_one_regressed())) {
    ObservationTaken { binding: _, selection: _, roster: _, unevaluated_subjects: _, standing: s } =>
      match s {
        EmitRatchetRefused { failing_rows: rows } =>
          count(
            filter(
              rows,
              row =>
                row == emit_ratchet_verdict_row(
                  v: RatchetRegressed {
                    entry: fixture_beta,
                    cause: BlockingDiagnostics { blocking: 1 }
                  }
                )
            )
          ) == 1
        EmitRatchetHeld { subject_count: _ } => false
      }
    ObservationNotTaken { binding: _, admission: _ } => false
  }
}

// AND THE REPORT INHERITS THE SPLIT RATHER THAN RE-DERIVING IT. A reader of the artifact — which is
// the only thing that survives the run — must be able to tell the two apart on the bytes, and must
// be able to see that what they are holding is not a gate verdict.
//
// THE EXPECTED ROWS ARE COMPOSED FROM THE RENDERER, never hand-written. A literal fragment here
// would pin the renderer's current wording into an unrelated claim, so an edit to one authority
// would red the other — the fork §3 forbids, arriving as a test fixture. What is asserted is that
// the report CARRIES the observation's own rendering and that the two renderings DIFFER, which is
// the distinction the row is named for and the only one it should own.
fn fixture_observation_row(r: EmitSubjectCleanRatchet) -> String {
  concat("observation\t", emit_ratchet_observation_text(observation: emit_ratchet_observation(binding: BindingAbsent, selection: SelectionWholeRoster, r: r)))
}

test fn the_report_distinguishes_an_untaken_observation_from_a_clean_one() -> Bool {
  let clean = fixture_dual_fold(inventory: fixture_roster, readings: fixture_both_clean())
  let empty = fixture_empty_dual_fold()
  count(filter(emit_ratchet_report_rows(binding: BindingAbsent, selection: SelectionWholeRoster, r: clean), row => row == fixture_observation_row(r: clean))) == 1
    && count(filter(emit_ratchet_report_rows(binding: BindingAbsent, selection: SelectionWholeRoster, r: empty), row => row == fixture_observation_row(r: empty))) == 1
    && !(fixture_observation_row(r: clean) == fixture_observation_row(r: empty))
    && count(
      filter(
        emit_ratchet_report_rows(binding: BindingAbsent, selection: SelectionWholeRoster, r: clean),
        row => row == concat("enrolment_gate\t", emit_ratchet_enrolment_admission_text(admission: fixture_gate_admission(r: clean)))
      )
    ) == 1
}

// A ZERO-FILE TREE IS NOT A CLEAN ENTRY.
//
// THE REASON IS AN INHERITED DEPENDENCY, not a general suspicion of zero. `EmittedFileCount` does
// not ASSERT the emitted/not-written distinction: `FilesNotWritten` is what the ABSENCE of the
// compiler's `compiled:` summary line decodes to, and the compiler prints that line only on the
// path that wrote a tree. So the distinction is inherited from the producer's printing discipline,
// which nothing pins — and if the seed ever printed a summary on a path that wrote nothing, the
// population would arrive here as `FilesEmitted { count: 0 }`.
//
// Reading that as CLEAN would be this ratchet's own failure mode, committed through its own
// load-bearing arm: a run that emitted nothing reported as a run that emitted zero, and a subject
// reading clean when it was never evaluated. So the zero refuses, and the hypothesised misprint
// lands in NotEvaluated either way rather than in a verdict.
//
// The control is the line beside it: a NONZERO count with the same empty population IS clean, so
// the refusal is about the zero and not about the fixture.
test fn a_zero_file_tree_is_not_evaluated_rather_than_clean() -> Bool {
  emit_outcome_of_population(ds: [fixture_advisory_diagnostic], files: FilesEmitted { count: 0 })
    == EmitSubjectNotEvaluated { cause: EmittedNothing }
    && emit_outcome_of_population(ds: [fixture_advisory_diagnostic], files: FilesEmitted { count: 1 })
      == EmitSubjectClean
}

// AND THE THREE NOT-EVALUATED CAUSES STAY DISTINCT, because they have three different owners: the
// instrument never ran, the emitter returned before writing a tree, or the emitter wrote a tree of
// nothing. Collapsing them would send three different repairs to one place.
test fn the_three_not_evaluated_causes_are_not_collapsed() -> Bool {
  emit_outcome_of_population(ds: [], files: FilesNotWritten)
    == EmitSubjectNotEvaluated { cause: ExtentUnestablished }
    && !(
      emit_outcome_of_population(ds: [], files: FilesEmitted { count: 0 })
        == EmitSubjectNotEvaluated { cause: ExtentUnestablished }
    )
}


// ---------------------------------------------------------------------------------------------
// WHO RUNS THE RUNNER: the third state, which is neither a good fold nor a bad one.
//
// "The ratchet has not run yet" and "the ratchet will never run here" render identically as an
// absent report, and only the second is terminal. The first is a fold that was attempted; the
// second is a carrier with no scheduled route at all, and it is the state this ratchet is in today.
// The claim asserts today's answer and its control in one breath, so the derivation cannot be a
// constant wearing a standing's name.
// ---------------------------------------------------------------------------------------------

// RED-ON-ENROLMENT BY CONSTRUCTION: this claim is green because the runner has NO consumer, and it
// goes red on the day one is agreed and the cadence row changes. That inversion is deliberate and it
// is the only mechanism that forces this claim and the block it mirrors to be rewritten together —
// a declaration that survives its own falsification is the rung inflation DESIGN calls worse than
// sitting low.
test fn the_ratchet_runner_has_no_executing_consumer_today() -> Bool {
  match emit_ratchet_runner_execution_standing(cadence: emit_ratchet_runner_cadence) {
    UnexecutedDeferredWitness { entry: e, function: f } =>
      e == "dag/tools/emit_subject_clean_ratchet.dag" && f == "observe"
    WitnessHasExecutingConsumer { cadence: _ } => false
    LegacyFrozenPathDeferral { entry: _, function: _ } => false
    UnclassifiedPathDeferral { entry: _, function: _ } => false
    DeclaredCadenceUnrealized { cadence: _, entry: _, function: _ } => false
  }
    && match emit_ratchet_runner_execution_standing(cadence: DiscoverySelection) {
      WitnessHasExecutingConsumer { cadence: c } => c == DiscoverySelection
      UnexecutedDeferredWitness { entry: _, function: _ } => false
      LegacyFrozenPathDeferral { entry: _, function: _ } => false
      UnclassifiedPathDeferral { entry: _, function: _ } => false
      DeclaredCadenceUnrealized { cadence: _, entry: _, function: _ } => false
    }
}

// ---------------------------------------------------------------------------------------------
// THE TWO VERDICT QUESTIONS ARE PROJECTIONS OF ONE CLASSIFICATION, and the relation between them is
// asserted rather than left to be rediscovered by comparing two functions arm by arm.
//
// WHY THIS ROW EXISTS AT ALL: the divergence between `holds` and `evaluated` was previously an
// EMERGENT fact -- two independent matches that happened to disagree on two arms, discoverable only
// by measuring them against each other, which is exactly how it came up in review. Routing both
// through `emit_ratchet_verdict_standing` makes the divergence a named class, and this claim pins
// the two properties that make the split load-bearing rather than decorative.

// ---------------------------------------------------------------------------------------------
// THE SELECTION SPLIT: ONE SILENCE, TWO OWNERS.
//
// A roster subject with no reading used to render as UNMEASURED whether the run had asked about it
// or not. The two facts have opposite remedies -- fix the instrument, or widen the run -- so a
// reader handed one count could not tell which they were looking at. The pair below is the whole
// evidence for the split, and it is a ONE-FIELD control: the roster, the admissions and the
// readings are IDENTICAL across both claims and only the selection differs. A green that survived
// collapsing the two arms would therefore have to be an accident of the selection alone.
// ---------------------------------------------------------------------------------------------

fn fixture_beta_verdict_under(selection: SubjectSelection) -> List<EmitRatchetVerdict> {
  filter(
    fold_emit_subject_clean_ratchet_over_readings(
      universe: IndexOnlyUniverse { policy: fixture_policy(), entries: fixture_roster },
      admissions: [],
      selection: selection,
      readings: [fixture_reading(entry: fixture_alpha, outcome: EmitSubjectClean)]
    ).verdicts,
    v => emit_ratchet_verdict_entry(v: v) == fixture_beta
  )
}

// RED: a subject the run never asked about must not be reported as one the instrument failed on.
// If the classifier stops consulting the selection, this arm collapses into the one below.
test fn a_subject_the_run_never_selected_is_scope_rather_than_a_deficit() -> Bool {
  fixture_beta_verdict_under(selection: SelectionSubset { entries: [fixture_alpha] })
    == [RatchetSubjectNotSelected { entry: fixture_beta, on_frontier: false }]
}

// RED: the same silence, from a run that DID ask, is a deficit and keeps its old name. This is the
// control that makes the claim above discriminating rather than a rename.
test fn a_subject_the_run_selected_and_could_not_measure_is_still_a_deficit() -> Bool {
  fixture_beta_verdict_under(selection: SelectionWholeRoster)
    == [RatchetSubjectUnmeasured { entry: fixture_beta, on_frontier: false }]
}

// NEITHER IS A VERDICT. The split names two owners; it does not promote scope into evidence, and a
// gate must still refuse over both. If the new arm were ever classified as established, a subset
// run would start answering a closed-universe question it never asked.
test fn neither_silence_establishes_a_verdict() -> Bool {
  count(
    filter(
      [
        RatchetSubjectNotSelected { entry: fixture_beta, on_frontier: false },
        RatchetSubjectUnmeasured { entry: fixture_beta, on_frontier: false }
      ],
      v => emit_ratchet_verdict_evaluated(v: v) || emit_ratchet_verdict_holds(v: v)
    )
  ) == 0
}

data every_verdict_shape: List<EmitRatchetVerdict> = [
  RatchetCleanHeld { entry: fixture_alpha },
  RatchetDebtHeld { entry: fixture_alpha, cause: BlockingDiagnostics { blocking: 1 } },
  RatchetRegressed { entry: fixture_alpha, cause: BlockingDiagnostics { blocking: 1 } },
  RatchetFrontierStale { entry: fixture_alpha },
  RatchetNotEvaluated { entry: fixture_alpha, on_frontier: false, cause: ExtentUnestablished },
  RatchetSubjectUnmeasured { entry: fixture_alpha, on_frontier: false },
  RatchetSubjectNotSelected { entry: fixture_alpha, on_frontier: false }
]

// A HELD VERDICT IS ALWAYS AN EVALUATED ONE -- the ratchet cannot hold over a subject nobody
// measured. If this ever fails, some arm is reporting a verdict it never established.
test fn holding_a_verdict_entails_having_established_it() -> Bool {
  count(
    filter(
      every_verdict_shape,
      v => emit_ratchet_verdict_holds(v: v) && !emit_ratchet_verdict_evaluated(v: v)
    )
  ) == 0
}

// AND THE CONVERSE MUST NOT HOLD, which is the half that makes the two questions distinct rather
// than one question spelled twice. An ESTABLISHED-AND-REFUSED verdict is evaluated and does not
// hold; if this set were empty the split would be a decoration and `evaluated` could be deleted.
test fn an_established_verdict_that_refuses_is_what_separates_the_two_questions() -> Bool {
  count(
    filter(
      every_verdict_shape,
      v => emit_ratchet_verdict_evaluated(v: v) && !emit_ratchet_verdict_holds(v: v)
    )
  ) == 2
    && count(
      filter(
        every_verdict_shape,
        v => emit_ratchet_verdict_standing(v: v) == VerdictEstablishedAndRefused
      )
    ) == 2
}

fn membership_with_candidates(candidates: List<String>, closure: List<String>) -> SubjectMembership {
  SubjectMembership {
    resolution_candidates: MembershipObserved { members: candidates },
    closure: MembershipObserved { members: closure },
    checked: MembershipObserved { members: closure }
  }
}

// A SUBJECT WHOSE RESOLUTION REACHED OUTSIDE ITS CLOSURE IS NOT EVALUATED, EVEN THOUGH THE
// INSTRUMENT CALLED IT CLEAN. This is the dangerous direction: the measurement succeeded and said
// nothing was wrong, and it said it about a larger thing than the roster names.
test fn a_clean_reading_over_a_broken_subject_boundary_becomes_not_evaluated() -> Bool {
  emit_outcome_under_membership(
    membership: membership_with_candidates(candidates: ["a", "outsider"], closure: ["a"]),
    outcome: EmitSubjectClean
  ) == EmitSubjectNotEvaluated { cause: ResolutionPopulationExceedsClosure { outside: ["outsider"] } }
}

// ITS CONTROL: a subject whose candidates sit inside its closure keeps the outcome the instrument
// measured, so the arm above is discriminating rather than replacing every verdict.
test fn a_reading_over_an_intact_subject_boundary_is_left_alone() -> Bool {
  emit_outcome_under_membership(
    membership: membership_with_candidates(candidates: ["a"], closure: ["a", "b"]),
    outcome: EmitSubjectClean
  ) == EmitSubjectClean
}

// AND THE ARM THAT DECIDES WHETHER THIS IS A WALL OR AN ABSORBING FALLBACK. The candidate population
// is unobservable today, so this relation is NOT-EVALUATED for every real subject. If that arm
// refused, the ratchet would refuse its whole roster on the strength of a measurement nobody took.
// It does not.
test fn an_unobserved_subject_boundary_does_not_refuse_the_measurement_it_could_not_check() -> Bool {
  let unobserved = SubjectMembership {
    resolution_candidates: unobserved_resolution_candidates(),
    closure: MembershipObserved { members: ["a"] },
    checked: MembershipObserved { members: ["a"] }
  }
  (emit_outcome_under_membership(membership: unobserved, outcome: EmitSubjectClean) == EmitSubjectClean)
    && (emit_outcome_under_membership(
          membership: unobserved,
          outcome: EmitSubjectBlocked { cause: BlockingDiagnostics { blocking: 3 } }
        ) == EmitSubjectBlocked { cause: BlockingDiagnostics { blocking: 3 } })
}

// =============================================================================================
// THE OBSERVATION CONTEXT'S EVIDENCE, one claim per ruled acceptance control.
//
// Every fixture below is a ONE-FIELD control: two subjects identical except in the component under
// test. That is what makes a green mean "the fold noticed THIS component" rather than "the fold
// noticed something".
// =============================================================================================

fn fixture_subject(revision: String, compiler_hex: String, tree: WorkingTreeStanding) -> EmissionMeasurementSubject {
  EmissionMeasurementSubject {
    entry: fixture_alpha,
    source_revision: revision as CommitSha,
    working_tree: tree,
    compiler: sha256_digest(hex: compiler_hex as NonEmptyStr),
    assembler: sha256_digest(hex: "bbbb" as NonEmptyStr),
    assembly_mode: SeedLinkedAssembly { std_bridge_dir: "dag/std" }
  }
}

data fixture_revision_a: String = "1111111111111111111111111111111111111111"
data fixture_revision_b: String = "2222222222222222222222222222222222222222"

fn fixture_coordinate(value: String) -> ActionsRunCoordinate {
  ActionsRunCoordinateObserved { value: value }
}

fn fixture_binding_of(subjects: List<EmissionMeasurementSubject>) -> ObservationBinding {
  observation_binding(
    subjects: subjects,
    run_identity: fixture_coordinate(value: "run-1"),
    run_attempt: fixture_coordinate(value: "1"),
    runner_binding: fixture_coordinate(value: "runner-a")
  )
}

fn fixture_clean_subject() -> EmissionMeasurementSubject {
  fixture_subject(revision: fixture_revision_a, compiler_hex: "aaaa", tree: WorkingTreeClean)
}

// CONTROL 1: one logical subject measured at two source revisions stays ONE subject with two
// contexts. This is the claim that proves the revision was NOT folded into subject identity -- had
// it been, each commit would mint a new subject and silently retire all prior debt.
test fn a_subject_measured_at_two_revisions_is_still_one_subject() -> Bool {
  let two = [
    fixture_clean_subject(),
    fixture_subject(revision: fixture_revision_b, compiler_hex: "aaaa", tree: WorkingTreeClean)
  ]
  count(distinct_component_values(subjects: two, component: SourceRevisionComponent)) == 2
    && count(distinct_component_values(subjects: two, component: CompilerComponent)) == 1
    && fixture_binding_of(subjects: two)
      == BindingDivergent {
        component: SourceRevisionComponent,
        values: [fixture_revision_a, fixture_revision_b]
      }
}

// CONTROL 2: a report cannot be reused under a different compiler digest. Same revision, different
// compiler -- the binding must diverge on the COMPILER rather than on whatever component the fold
// happens to check first.
test fn a_binding_refuses_two_compilers_over_one_revision() -> Bool {
  fixture_binding_of(
    subjects: [
      fixture_clean_subject(),
      fixture_subject(revision: fixture_revision_a, compiler_hex: "cccc", tree: WorkingTreeClean)
    ]
  ) == BindingDivergent { component: CompilerComponent, values: ["aaaa", "cccc"] }
}

// The agreeing case, which is what makes the two claims above discriminating rather than a fold
// that diverges on everything.
test fn one_run_over_agreeing_subjects_establishes_a_context() -> Bool {
  match fixture_binding_of(subjects: [fixture_clean_subject(), fixture_clean_subject()]) {
    BindingEstablished { context: ctx } =>
      (ctx.source_revision as String) == fixture_revision_a
        && (ctx.compiler.hex as String) == "aaaa"
    BindingDivergent { component: _, values: _ } => false
    BindingAbsent => false
  }
}

// CONTROL 3: two workflow attempts stay distinguishable. The coordinates are separate fields, so a
// re-run of ONE run is not confusable with a different run -- a composed single key would answer
// "same attempt?" while destroying "same run, different attempt?".
test fn two_attempts_of_one_run_stay_distinguishable() -> Bool {
  let first = observation_binding(
    subjects: [fixture_clean_subject()],
    run_identity: fixture_coordinate(value: "run-1"),
    run_attempt: fixture_coordinate(value: "1"),
    runner_binding: fixture_coordinate(value: "runner-a")
  )
  let second = observation_binding(
    subjects: [fixture_clean_subject()],
    run_identity: fixture_coordinate(value: "run-1"),
    run_attempt: fixture_coordinate(value: "2"),
    runner_binding: fixture_coordinate(value: "runner-a")
  )
  (first != second)
    && match first {
      BindingEstablished { context: a } =>
        match second {
          BindingEstablished { context: b } =>
            (a.run_identity == b.run_identity) && (a.run_attempt != b.run_attempt)
          BindingDivergent { component: _, values: _ } => false
          BindingAbsent => false
        }
      BindingDivergent { component: _, values: _ } => false
      BindingAbsent => false
    }
}

// A population that carried no subject at all is BindingAbsent and never an established context
// over fabricated coordinates.
test fn a_population_with_no_subject_establishes_no_context() -> Bool {
  fixture_binding_of(subjects: []) == BindingAbsent
}

// THE POPULATION SURVIVES A DIVERGENT BINDING. This is the claim that separates the typed
// disagreement from the refusal it replaced: the standing is still computed and still reported,
// so thirty-eight good measurements are not discarded to avoid publishing one false binding.
test fn a_divergent_binding_still_carries_the_standing() -> Bool {
  match emit_ratchet_observation(
    binding: fixture_binding_of(
      subjects: [
        fixture_clean_subject(),
        fixture_subject(revision: fixture_revision_b, compiler_hex: "aaaa", tree: WorkingTreeClean)
      ]
    ),
    selection: SelectionWholeRoster,
    r: fixture_dual_fold(inventory: fixture_roster, readings: fixture_both_clean())
  ) {
    ObservationTaken { binding: b, selection: _, roster: _, unevaluated_subjects: _, standing: s } =>
      (s == EmitRatchetHeld { subject_count: 2 })
        && (b == BindingDivergent {
          component: SourceRevisionComponent,
          values: [fixture_revision_a, fixture_revision_b]
        })
    ObservationNotTaken { binding: _, admission: _ } => false
  }
}

fn fixture_taken_observation(subjects: List<EmissionMeasurementSubject>) -> EmitRatchetObservation {
  emit_ratchet_observation(
    binding: fixture_binding_of(subjects: subjects),
    selection: SelectionWholeRoster,
    r: fixture_dual_fold(inventory: fixture_roster, readings: fixture_both_clean())
  )
}

data fixture_persisted: EmitObservationPersistence = ObservationPersisted {
  report_artifact: "/tmp/ratchet.tsv",
  report_digest: sha256_digest(hex: "dddd" as NonEmptyStr),
  report_bytes: 4096
}

fn fixture_receipt(
  subjects: List<EmissionMeasurementSubject>,
  persistence: EmitObservationPersistence
) -> EmitPricingReceipt {
  emit_pricing_receipt(
    observation: fixture_taken_observation(subjects: subjects),
    persistence: persistence,
    wall_ms: 1000,
    cpu_ms: 900,
    peak_rss_bytes: 12345
  )
}

// CONTROL 7 and 6: report size comes from the PERSISTED ARTIFACT, and every dimension comes from
// one observation and one context rather than six joined measurements.
test fn a_bound_receipt_takes_its_report_size_from_the_persisted_artifact() -> Bool {
  match fixture_receipt(subjects: [fixture_clean_subject()], persistence: fixture_persisted) {
    PricingReceiptBound { context: ctx, dimensions: d } =>
      (d.report_bytes == 4096)
        && (d.roster_size == 2)
        && (d.unevaluated_subject_count == 0)
        && ((ctx.source_revision as String) == fixture_revision_a)
    PricingReceiptRefused { cause: _ } => false
  }
}

// CONTROL 5: failed persistence cannot render as zero subjects or zero bytes. The refusal names
// persistence rather than publishing a receipt whose report_bytes happens to be 0 -- a figure that
// would read as a measured empty report.
test fn a_failed_persistence_is_not_a_receipt_of_zero_bytes() -> Bool {
  fixture_receipt(
    subjects: [fixture_clean_subject()],
    persistence: ObservationPersistenceRefused { cause: "disk full" }
  ) == PricingReceiptRefused { cause: PricingReportNotPersisted { cause: "disk full" } }
}

// CONTROL 4: a dirty tree refuses the pricing receipt. A cost measured over a tree nobody can check
// out again is not citable, and publishing it with a caveat is what this refusal exists to prevent.
test fn a_dirty_working_tree_refuses_the_pricing_receipt() -> Bool {
  fixture_receipt(
    subjects: [fixture_subject(revision: fixture_revision_a, compiler_hex: "aaaa", tree: WorkingTreeDirty)],
    persistence: fixture_persisted
  ) == PricingReceiptRefused { cause: PricingWorkingTreeDirty }
}

// CONTROL 4, second half: an unbound run coordinate refuses too, and NAMES the variable. Outside
// Actions every coordinate is legitimately absent, so this is the ordinary local-run outcome --
// which is the point: a local run cannot produce a receipt that claims to be a CI measurement.
test fn an_unbound_run_coordinate_refuses_and_names_the_variable() -> Bool {
  emit_pricing_receipt(
    observation: emit_ratchet_observation(
      binding: observation_binding(
        subjects: [fixture_clean_subject()],
        run_identity: ActionsRunCoordinateMissing { variable: "GITHUB_RUN_ID" },
        run_attempt: fixture_coordinate(value: "1"),
        runner_binding: fixture_coordinate(value: "runner-a")
      ),
      selection: SelectionWholeRoster,
      r: fixture_dual_fold(inventory: fixture_roster, readings: fixture_both_clean())
    ),
    persistence: fixture_persisted,
    wall_ms: 1000,
    cpu_ms: 900,
    peak_rss_bytes: 12345
  ) == PricingReceiptRefused { cause: PricingRunCoordinateUnbound { coordinate: "GITHUB_RUN_ID" } }
}

// A DIVERGENT BINDING CANNOT BE PRICED, which is the whole construction: there is no path from a
// population whose provenance is not uniform to six numbers attached to a context.
test fn a_divergent_binding_cannot_be_priced() -> Bool {
  fixture_receipt(
    subjects: [
      fixture_clean_subject(),
      fixture_subject(revision: fixture_revision_b, compiler_hex: "aaaa", tree: WorkingTreeClean)
    ],
    persistence: fixture_persisted
  ) == PricingReceiptRefused {
    cause: PricingBindingDivergent {
      component: SourceRevisionComponent,
      values: [fixture_revision_a, fixture_revision_b]
    }
  }
}

// THE UNEVALUATED COUNT MUST REACH THE READER. It is carried on the dimensions record, but a field
// nobody renders is a field nobody reads -- and this is the one dimension a reader will treat as
// bookkeeping. Per-entry measurement mapped across a roster covers the union of those entries'
// closures, never the corpus, so this number is how much the receipt does NOT speak for. A clean
// board printed without it reads as coverage while being precisely the shape that is not.
test fn a_bound_receipt_reports_what_it_does_not_speak_for() -> Bool {
  let rendered = emit_pricing_receipt_text(
    receipt: fixture_receipt(subjects: [fixture_clean_subject()], persistence: fixture_persisted)
  )
  string_contains(s: rendered, pattern: "unevaluated_subjects\t0")
    && string_contains(s: rendered, pattern: "roster_size\t2")
    && string_contains(s: rendered, pattern: "report_bytes\t4096")
}

// A REFUSED RECEIPT RENDERS AS A REFUSAL NAMING ITS CAUSE, never as a row of zeroes. Zeroed cost
// figures beside a refusal would read as a measured cheap run.
test fn a_refused_receipt_renders_no_dimensions_at_all() -> Bool {
  let rendered = emit_pricing_receipt_text(
    receipt: fixture_receipt(
      subjects: [fixture_subject(revision: fixture_revision_a, compiler_hex: "aaaa", tree: WorkingTreeDirty)],
      persistence: fixture_persisted
    )
  )
  string_contains(s: rendered, pattern: "pricing NOT TAKEN")
    && string_contains(s: rendered, pattern: "cannot be checked out again")
    && !string_contains(s: rendered, pattern: "wall_ms")
    && !string_contains(s: rendered, pattern: "unevaluated_subjects")
}
