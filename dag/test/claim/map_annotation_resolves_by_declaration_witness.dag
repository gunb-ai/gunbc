module test.claim.map_annotation_resolves_by_declaration_witness

import std.types { String, Bool, Int, List }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import gunbc.instruments.multi_module_compile_fixture {
  MultiModuleCompileFixture,
  MultiModuleCompileFixtureOutcome,
  FixtureInstrumentRefused,
  FixtureCompileRefused,
  FixtureCompileCompleted,
  fixture_source,
  compile_fixture,
  fixture_has_class
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE CLASS: A `Map<..>` ANNOTATION NAMES THE DECLARATION IT RESOLVES TO, NEVER THE KERNEL CONTAINER
// BY LEAF NAME (ruling gunbc.design_ruling kernel_map_is_the_host_realization_of_the_finitely_supported_function,
// the Map instance of text_crossings_go_through_the_unfold). The seed once minted every Map spelling
// as the kernel container whatever the import said, so std.types Map = FinitelySupportedFunction
// could not be the one concept.
//
// The fixture supplies its own `Map` declaration (a manifest has no corpus roots, so std.types is
// unavailable, the same reason as undeclared_bare_type_reference_class_witness). The function
// returns a value of the declaration's target type at a `Map<String, Int>` annotation: it compiles
// only if the annotation resolved to the declaration; were it the kernel container the return would
// mismatch.

data mad_definer_source: String = "module mad.definer\n\ntype MadFunction<key, value> {\n  support: List<key>\n  codomain: List<value>\n}\n\ntype Map<key, value> = MadFunction<key, value>\n"

data mad_user_imported_source: String = "module mad.user\n\nimport mad.definer { Map, MadFunction }\n\nfn mad_identity(f: MadFunction<String, Int>) -> Map<String, Int> {\n  f\n}\n"

data mad_user_unimported_source: String = "module mad.user\n\nimport mad.definer { MadFunction }\n\nfn mad_identity(f: MadFunction<String, Int>) -> Map<String, Int> {\n  f\n}\n"

fn mad_run(user_source: String) -> MultiModuleCompileFixtureOutcome {
  compile_fixture(MultiModuleCompileFixture {
    sources: [
      fixture_source("mad/definer.dag", mad_definer_source),
      fixture_source("mad/user.dag", user_source)
    ],
    entry: "mad/user.dag"
  })
}

fn mad_diagnosed_as(o: MultiModuleCompileFixtureOutcome, wanted: String) -> Bool {
  match o {
    FixtureCompileRefused { module_count: n, diagnostics: rows, source_digest: sd, compiler_digest: cd } =>
      fixture_has_class(rows: rows, wanted: wanted),
    FixtureCompileCompleted { module_count: n, emitted_files: files, resolved_rust_functions: _, diagnostics: rows, source_digest: sd, compiler_digest: cd } =>
      fixture_has_class(rows: rows, wanted: wanted),
    FixtureInstrumentRefused { cause: c } => false
  }
}

fn mad_completed_clean(o: MultiModuleCompileFixtureOutcome) -> Bool {
  match o {
    FixtureCompileCompleted { module_count: n, emitted_files: files, resolved_rust_functions: _, diagnostics: rows, source_digest: sd, compiler_digest: cd } =>
      count(rows) == 0 && count(files) > 0 && n > 0,
    FixtureCompileRefused { module_count: n, diagnostics: rows, source_digest: sd, compiler_digest: cd } => false,
    FixtureInstrumentRefused { cause: c } => false
  }
}

// THE POSITIVE CONTROL: the imported Map annotation is the declaration, so the declaration's own
// target type inhabits it.
test fn an_imported_map_annotation_resolves_to_its_declaration() -> Bool {
  mad_completed_clean(mad_run(mad_user_imported_source))
}

// THE DISCRIMINATING RED: the same bytes minus the import edge. The Map spelling names no
// declaration, so it refuses as unbound (UnresolvedType); it is not silently the kernel container.
test fn a_map_annotation_without_an_import_refuses_as_unbound() -> Bool {
  mad_diagnosed_as(mad_run(mad_user_unimported_source), "UnresolvedType")
}

// ONE IDENTITY AT A JOIN, KEYED ON THE DECLARATION. A Map whose declaration aliases THE keyed algebra
// (the std.algebra FinitelySupportedFunction declaration) resolves as the kernel keyed container, the
// same identity that declaration resolves to, so an `if` joining a `Map<String, Int>` arm with a
// `FinitelySupportedFunction<String, Int>` arm is one type. Resolving it as a user generic of the
// alias minted a second identity and refused the joins at v2.std.compilers.lexing
// lex_rule_set_insert_keyword_class ('Map(...) vs Map(...)'). The fixture names the module std.algebra
// and std.types so both declaration identities are the real ones.
data mad_keyed_algebra_source: String = "module std.algebra\n\ntype FinitelySupportedFunction<K, V> {\n  support: List<K>\n}\n"

data mad_keyed_types_source: String = "module std.types\n\nimport std.algebra { FinitelySupportedFunction }\n\ntype Map<key, value> = FinitelySupportedFunction<key, value>\n"

data mad_keyed_join_source: String = "module mad.join\n\nimport std.algebra { FinitelySupportedFunction }\nimport std.types { Map }\n\nfn mad_join(m: Map<String, Int>, n: FinitelySupportedFunction<String, Int>, c: Bool) -> Map<String, Int> {\n  if c { m } else { n }\n}\n"

test fn a_map_aliasing_the_keyed_algebra_joins_its_declaration_as_one_type() -> Bool {
  match compile_fixture(MultiModuleCompileFixture {
    sources: [
      fixture_source("std/algebra.dag", mad_keyed_algebra_source),
      fixture_source("std/types.dag", mad_keyed_types_source),
      fixture_source("mad/join.dag", mad_keyed_join_source)
    ],
    entry: "mad/join.dag"
  }) {
    FixtureCompileCompleted { module_count: n, emitted_files: files, resolved_rust_functions: _, diagnostics: rows, source_digest: sd, compiler_digest: cd } =>
      count(rows) == 0 && count(files) > 0,
    FixtureCompileRefused { module_count: n, diagnostics: rows, source_digest: sd, compiler_digest: cd } => false,
    FixtureInstrumentRefused { cause: c } => false
  }
}

// THE IDENTITY RED: a LOCAL record that is merely NAMED FinitelySupportedFunction, aliased as Map, is
// not the keyed algebra. Its Map resolves through its own declaration, so the record's field is read;
// were the test keyed on the spelling, the Map would be the kernel container and `m.support` would
// refuse.
data mad_lookalike_source: String = "module mad.lookalike\n\ntype FinitelySupportedFunction<K, V> {\n  support: List<K>\n}\n\ntype Map<key, value> = FinitelySupportedFunction<key, value>\n\nfn mad_support(m: Map<String, Int>) -> List<String> {\n  m.support\n}\n"

test fn a_lookalike_record_named_finitely_supported_function_aliased_as_map_is_not_the_kernel_container() -> Bool {
  match compile_fixture(MultiModuleCompileFixture {
    sources: [fixture_source("mad/lookalike.dag", mad_lookalike_source)],
    entry: "mad/lookalike.dag"
  }) {
    FixtureCompileCompleted { module_count: n, emitted_files: files, resolved_rust_functions: _, diagnostics: rows, source_digest: sd, compiler_digest: cd } =>
      count(rows) == 0 && count(files) > 0,
    FixtureCompileRefused { module_count: n, diagnostics: rows, source_digest: sd, compiler_digest: cd } => false,
    FixtureInstrumentRefused { cause: c } => false
  }
}

// THE FAIL-OPEN FIX (review 87351 finding 2) AND ITS EXECUTABLE CONSUMER. The unbound-container
// refusal in v1.compiler.resolve (src/v1/04_resolve.dag, unbound_container_diagnostics) once read
// `declaration_resolved_container(name: name) && map_is_empty(m: env.source_visible_names) == false
// && map_has(m: env.source_visible_names, key: name) == false`. The middle conjunct switched the
// refusal OFF in exactly the context where NOTHING is visible -- an empty visible set -- which is the
// strongest case for refusing, not an escape. Absence is now judged by `map_has == false` alone:
// fail-closed on absence, never 'the set is non-empty and misses it'.
//
// THE CONSUMER IS a_map_annotation_without_an_import_refuses_as_unbound ABOVE: it feeds source that
// hits the guard (mad.user imports mad.definer { MadFunction } but NOT Map, so Map is absent from
// env.source_visible_names) and asserts the typed refusal (UnresolvedType at the annotation), which
// the guard is the only thing that emits. An earlier revision of this block asserted the fix with
// three string_contains greps over the seed file text; review 87521 ruled those grep-as-consumer
// (DESIGN 5: "a typecheck and a .contains() grep are not consumers") and they are deleted, not
// repaired: the executable test above already covers both directions (mad_user_imported_source
// accepts with Map visible, mad_user_unimported_source refuses without it), so a reinstated
// map_is_empty conjunct flips the unimported case from refusal to acceptance and THAT test goes red.
// The empty-visible-set corner itself is fixture-unreachable by construction -- build_type_env folds
// kernel_type_set into source_visible_names (v1.compiler.infer, `let svn_kernel = fold(map_keys(
// kernel_type_set), init: svn_local, ...)`), so no compile_fixture source can produce the set the old
// guard skipped on; that is how the fail-open survived CI. Reaching it would need a direct call into
// v1.compiler.resolve with a hand-built TypeEnv, and the witness universe is rooted at dag and src/v2,
// never src/v1 (dag/test/claim/trait_bound_witness.dag:7-18 records that lane's import failure). The
// sibling guard on the UNLISTED IMPORT check, same file, keeps its map_is_empty conjunct legitimately:
// a name cannot be an unlisted import in a module with no imports, so emptiness is disqualifying there
// and disqualifying nowhere here.
