module test.claim.measurement_provenance_witness

import std.types { Bool, Int, String, NonEmptyStr }
import std.measure { byte_size }
import std.content_hash { content_hash_of_value, sha256_hex_digest }

import extdeps.git.object_store { git_object_id_from_untagged_hex }

import gunbc.devboot.outcome {
  BuildExecutionOutcome,
  ExecutionProduced,
  ExecutionFailed,
  ExecutionRefused,
  BuildFailureCause,
  CompilationFailed,
  InfrastructureRefusalCause,
  SubjectNotFetchable,
  ArtifactAvailability,
  ArtifactAvailable,
  ArtifactMissing,
  ArtifactUnreadable,
  StoredArtifact,
  availability_permits_retrieval,
}
import gunbc.devboot.produce { corrupt_artifact_observation }

import gunbc.measurement_provenance {
  Observation,
  Observed,
  InstrumentNotHeld,
  SubjectNotHeld,
  observe,
  observation_is_bound,
}

// WHAT THIS WITNESS COVERS. observe folds two devboot retrievability observations into an
// Observation<Value>. The claim is that the bound arm (Observed) is reachable only when BOTH
// sides landed on ArtifactAvailable — never on the strength of a past ExecutionProduced, and
// never when either side's bytes are missing, corrupt or unreadable — regardless of how
// plausible the value handed to observe looks.
//
// The four specimens the carrier was built from appear here as four separate rows rather than
// as one, because they fail on different axes: (3) is an instrument whose build failed, (4) is
// a subject that could not be fetched, and (1) is the one the fold onto devboot newly closes —
// a build that genuinely succeeded in the past, whose artifact is not the artifact now.

data instrument_blob_hex: String = "8a472fff9e9000600e33cc3559ecfad4ba55e3a3"

data subject_blob_hex: String = "b2c4d6e8f0a1b3c5d7e9f0a2b4c6d8e0f2a4b6c8"

data instrument_sha_hex: String = "1f2e3d4c5b6a798807162534435261708f9e0d1c2b3a49586776859403122130"

data subject_sha_hex: String = "0a1b2c3d4e5f60718293a4b5c6d7e8f90112233445566778899aabbccddeeff0"

// ONE BUILDER FOR EVERY AVAILABLE ARM, so a row meaning to vary one axis cannot accidentally
// vary another. It returns an option because both hex parsers refuse rather than fabricate —
// a fixture that cast bad hex into a digest would be asserting the property the parser exists
// to establish, which is the fabrication this repository forbids.
fn an_available_artifact(tag: NonEmptyStr, blob_hex: String, sha_hex: String) -> ArtifactAvailability? {
  match git_object_id_from_untagged_hex(hex: blob_hex) {
    Absent => none
    Present { value: blob } =>
      match sha256_hex_digest(hex: sha_hex) {
        Absent => none
        Present { value: digest } =>
          Present {
            value: ArtifactAvailable {
              artifact: StoredArtifact {
                subject_digest: content_hash_of_value(value: tag),
                blob_oid: blob,
                sha256: digest,
                bytes: byte_size(count: 4096),
              },
            },
          }
      }
  }
}

fn an_available_instrument() -> ArtifactAvailability? {
  an_available_artifact(
    tag: "instrument-bytes-fixture",
    blob_hex: instrument_blob_hex,
    sha_hex: instrument_sha_hex,
  )
}

fn an_available_subject() -> ArtifactAvailability? {
  an_available_artifact(
    tag: "subject-tree-fixture",
    blob_hex: subject_blob_hex,
    sha_hex: subject_sha_hex,
  )
}

// Specimen (3): `cargo build 2>&1 | tail -4 && next` took tail's exit status, so a failed
// compilation proceeded as success. Typed here as what it was — a fact about the subject, for
// which retrying without changing the source is pointless.
fn a_failed_build() -> BuildExecutionOutcome {
  ExecutionFailed {
    cause: CompilationFailed {
      detail: "cargo build exited nonzero; the pipe to `tail -4` swallowed the exit code",
    },
  }
}

// Specimen (4): the treatment merge that refused on a shallow clone. This is an infrastructure
// refusal rather than a build failure, and devboot keeps the two apart precisely so that the
// difference in remedy survives — the same subject may well fetch once the clone is deepened.
fn an_unfetchable_subject() -> BuildExecutionOutcome {
  ExecutionRefused {
    cause: SubjectNotFetchable { detail: "refusing to merge unrelated histories" },
  }
}

fn bound(
  instrument_execution: BuildExecutionOutcome,
  instrument_availability: ArtifactAvailability,
  subject_execution: BuildExecutionOutcome,
  subject_availability: ArtifactAvailability,
) -> Bool {
  observation_is_bound(
    o: observe(
      instrument_execution: instrument_execution,
      instrument_availability: instrument_availability,
      subject_execution: subject_execution,
      subject_availability: subject_availability,
      value: 42,
    )
  )
}

// POSITIVE CONTROL. Without this, every RED below is satisfied by a predicate that refuses
// unconditionally — one incapable of ever reporting a bound observation, which is exactly the
// broken instrument shape this work item exists about.
test fn both_sides_available_yields_a_bound_observation() -> Bool {
  match an_available_instrument() {
    Absent => false
    Present { value: instrument } =>
      match an_available_subject() {
        Absent => false
        Present { value: subject } =>
          bound(
            instrument_execution: ExecutionProduced,
            instrument_availability: instrument,
            subject_execution: ExecutionProduced,
            subject_availability: subject,
          )
      }
  }
}

// THE DISCRIMINATING RED FOR SPECIMEN (3). A build that failed behind an unguarded pipe must
// not let the downstream measurement be reported as bound to any instrument at all — there is
// no arm on Observation carrying a StoredArtifact for the plausible value to ride along with.
test fn w_RED_a_failed_instrument_build_never_yields_a_bound_observation() -> Bool {
  match an_available_subject() {
    Absent => false
    Present { value: subject } =>
      !bound(
        instrument_execution: a_failed_build(),
        instrument_availability: ArtifactMissing,
        subject_execution: ExecutionProduced,
        subject_availability: subject,
      )
  }
}

// THE SAME LAW ON THE SUBJECT HALF, SPECIMEN (4). A treatment merge that refused on a shallow
// clone must not let the baseline's numbers be reported as though they described the treatment.
test fn w_RED_an_unfetchable_subject_never_yields_a_bound_observation() -> Bool {
  match an_available_instrument() {
    Absent => false
    Present { value: instrument } =>
      !bound(
        instrument_execution: ExecutionProduced,
        instrument_availability: instrument,
        subject_execution: an_unfetchable_subject(),
        subject_availability: ArtifactMissing,
      )
  }
}

// THE RED THE FOLD ONTO devboot NEWLY BUYS, SPECIMEN (1). The instrument's build SUCCEEDED —
// ExecutionProduced, genuinely, in the past — and the bytes now in the store do not match the
// digest that success recorded. That is the stale-binary specimen exactly: a past success read
// as evidence about a present binary. The earlier revision of this carrier had no arm that
// could tell these apart and declared the axis outside the modeled guarantee; observe now
// selects on availability alone, so history has no vote and this refuses.
test fn w_RED_a_past_build_success_does_not_bind_when_the_artifact_is_corrupt_now() -> Bool {
  match an_available_subject() {
    Absent => false
    Present { value: subject } =>
      !bound(
        instrument_execution: ExecutionProduced,
        instrument_availability: corrupt_artifact_observation(
          expected_hex: instrument_sha_hex,
          observed_hex: subject_sha_hex,
        ),
        subject_execution: ExecutionProduced,
        subject_availability: subject,
      )
  }
}

// A doubly-unavailable fold reports the INSTRUMENT refusal, not a merged or widened one, and
// carries the execution axis with it so the caller can still answer 'is retry pointless'.
// Asserted rather than assumed, since DESIGN section 5 forbids a failure arm absorbing a second
// failure into silence.
test fn a_doubly_unavailable_fold_reports_the_instrument_refusal() -> Bool {
  match observe(
    instrument_execution: a_failed_build(),
    instrument_availability: ArtifactMissing,
    subject_execution: an_unfetchable_subject(),
    subject_availability: ArtifactMissing,
    value: 42,
  ) {
    InstrumentNotHeld { execution, availability } => true
    SubjectNotHeld { execution, availability } => false
    Observed { instrument, subject, value } => false
  }
}

// THE AGREEMENT ROW, and the reason observe is allowed to match on availability itself rather
// than call devboot's Bool-returning authority: it needs the StoredArtifact out of the arm,
// which a Bool cannot hand back. That makes the agreement a claim rather than a tautology, so
// it is executed here on every arm of ArtifactAvailability instead of asserted in a comment.
// If devboot ever changes which arms permit retrieval and this fold does not follow, this goes
// red — which is the point of writing it as a join rather than as two independent rules.
test fn binding_agrees_with_devboot_availability_authority_on_every_arm() -> Bool {
  match an_available_instrument() {
    Absent => false
    Present { value: instrument } =>
      match an_available_subject() {
        Absent => false
        Present { value: subject } =>
          (bound(
            instrument_execution: ExecutionProduced,
            instrument_availability: instrument,
            subject_execution: ExecutionProduced,
            subject_availability: subject,
          ) == availability_permits_retrieval(availability: instrument))
          && (bound(
            instrument_execution: ExecutionProduced,
            instrument_availability: ArtifactMissing,
            subject_execution: ExecutionProduced,
            subject_availability: subject,
          ) == availability_permits_retrieval(availability: ArtifactMissing))
          && (bound(
            instrument_execution: ExecutionProduced,
            instrument_availability: ArtifactUnreadable { detail: "store read returned EIO" },
            subject_execution: ExecutionProduced,
            subject_availability: subject,
          ) == availability_permits_retrieval(
            availability: ArtifactUnreadable { detail: "store read returned EIO" }
          ))
          && (bound(
            instrument_execution: ExecutionProduced,
            instrument_availability: corrupt_artifact_observation(
              expected_hex: instrument_sha_hex,
              observed_hex: subject_sha_hex,
            ),
            subject_execution: ExecutionProduced,
            subject_availability: subject,
          ) == availability_permits_retrieval(
            availability: corrupt_artifact_observation(
              expected_hex: instrument_sha_hex,
              observed_hex: subject_sha_hex,
            )
          ))
      }
  }
}
