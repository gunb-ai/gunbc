}
import extdeps.storage.western_digital { wd_black_sn850x_2tb_catalog }
import extdeps.ssh.keys { Ed25519, SshPublicKey }
import extdeps.toolchain.types { Aarch64, X86_64 }
import extdeps.bmc.endpoint { AmiMegaRac }
import extdeps.provisioning.network_boot { LegacyBiosPxe, UefiHttpBoot, UefiPxe }
