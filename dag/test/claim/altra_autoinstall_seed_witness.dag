data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// ---------------------------------------------------------------------------
// Fixtures. A witness's evidence should be readable without a builder call chain; nothing here names a
// fleet host, and the two disks that collide are named by serial alone.
// ---------------------------------------------------------------------------

data unit_a_key: UnitKey = "altra-unit-a" as UnitKey
data unit_b_key: UnitKey = "altra-unit-b" as UnitKey
data attempt_one: IntakeAttemptId = "intake-20261017-0001" as IntakeAttemptId
data attempt_two: IntakeAttemptId = "intake-20261017-0002" as IntakeAttemptId

data unit_key_bound_a: UnitKeyStanding = UnitKeyBound { key: unit_a_key }
data unit_key_bound_b: UnitKeyStanding = UnitKeyBound { key: unit_b_key }
data unit_key_unbound: UnitKeyStanding = UnitKeyRefused { cause: BoardSerialAbsent }
data bmc_family_observed: BmcFirmwareFamilyStanding = FamilyObserved { family: AmiMegaRac }
data bmc_family_unobserved: BmcFirmwareFamilyStanding = FamilyUnobserved {
  discriminator: "AST2500 firmware string never read" as NonEmptyStr,
}

data target_altra: AltraAutoinstallTarget = admit_altra_autoinstall_target(
  unit_key: unit_key_bound_a,
  architecture: Aarch64,
  bmc_firmware: bmc_family_observed,
  role: AltraProvisioningTarget,
  kernel_flavour: Noble2404GaLinux68,
)

data target_altra_b: AltraAutoinstallTarget = admit_altra_autoinstall_target(
  unit_key: unit_key_bound_b,
  architecture: Aarch64,
  bmc_firmware: bmc_family_observed,
  role: AltraProvisioningTarget,
  kernel_flavour: Noble2404GaLinux68,
)

// Two bays carrying the SAME serial: the population an 8-bay board really presents when a tray is swapped
// or a label copied, and the case a device-name selector would silently resolve by enumeration order.
data twin_disk_one: StorageDevice = NvmeDevice {
  catalog: wd_black_sn850x_2tb_catalog,
  serial: Present { value: "TWIN-SERIAL-0001" },
  persistence: Persistent,
}

data twin_disk_two: StorageDevice = NvmeDevice {
  catalog: wd_black_sn850x_2tb_catalog,
  serial: Present { value: "TWIN-SERIAL-0001" },
  persistence: Persistent,
}

data unique_disk: StorageDevice = NvmeDevice {
  catalog: wd_black_sn850x_2tb_catalog,
  serial: Present { value: "UNIQUE-SERIAL-0007" },
  persistence: Persistent,
}

// The same serial on a disk that is NOT persistent: identity matches, kind does not.
data ephemeral_disk: StorageDevice = NvmeDevice {
  catalog: wd_black_sn850x_2tb_catalog,
  serial: Present { value: "UNIQUE-SERIAL-0007" },
  persistence: Ephemeral,
}

data cached_mirror_disk: StorageDevice = NvmeDevice {
  catalog: wd_black_sn850x_2tb_catalog,
  serial: Present { value: "UNIQUE-SERIAL-0007" },
  persistence: CachedMirror,
}

// A disk the probe could not read a serial for — reported as unexamined, never as "nothing matches".
data serial_unread_disk: StorageDevice = NvmeDevice {
  catalog: wd_black_sn850x_2tb_catalog,
  serial: Absent,
  persistence: Persistent,
}

// BMC virtual media presents the install image as an attached device on the board itself, so an extra
// device really does appear in the probe's view during such an install. Only an identity-bearing rule
// keeps the install off it.
data bmc_virtual_media_device: StorageDevice = BareDevice {
  capacity: byte_size(8589934592),
  medium: EphemeralFs,
  serial: Present { value: "BMC-VIRTUAL-CDROM" },
  read_bandwidth: Absent,
  write_bandwidth: Absent,
  persistence: Ephemeral,
}

data bay_population: List<StorageDevice> = [unique_disk, twin_disk_one, twin_disk_two]

// THE SAME MODEL, SAME CAPACITY, DIFFERENT SERIAL: two physically distinct drives the catalog rule cannot tell
// apart, which is what makes "same rule, different drive" expressible without the rule itself being the variable.
data sibling_disk: StorageDevice = NvmeDevice {
  catalog: wd_black_sn850x_2tb_catalog,
  serial: Present { value: "SIBLING-SERIAL-0009" },
  persistence: Persistent,
}

data serial_selector: TargetDiskSelector = ByObservedSerial { serial: "UNIQUE-SERIAL-0007" }
data twin_selector: TargetDiskSelector = ByObservedSerial { serial: "TWIN-SERIAL-0001" }
data absent_selector: TargetDiskSelector = ByObservedSerial { serial: "NO-SUCH-DISK" }
data catalog_selector: TargetDiskSelector = ByCatalogIdentity {
  part_number: "WDS200T2X0E",
  capacity_bytes: byte_size(2000398934016),
}
data wrong_capacity_selector: TargetDiskSelector = ByCatalogIdentity {
  part_number: "WDS200T2X0E",
  capacity_bytes: byte_size(1000000000000),
}

data provisioning_key: SshPublicKey = SshPublicKey {
  algorithm: Ed25519,
  material: "AAAAC3NzaC1lZDI1NTE5AAAAIAcKDRATFhkcHyIlKCsuMTQ3Oj1AQ0ZJTE9SVVhbXmFk" as NonEmptyStr,
  comment: "gunbc-provisioning",
}

data one_key: List<SshPublicKey> = [provisioning_key]
data no_keys: List<SshPublicKey> = []

data network_posture: SeedNetworkPosture = SeedNetworkPosture {
  addressing: SeededNetplan { source: "00-gunbc.yaml" as NonEmptyStr },
  family: Ipv4Only,
  mirror: Present { value: NamedMirrorAuthority { host: "mirror.internal.invalid" as NonEmptyStr } },
}

data posture_no_mirror: SeedNetworkPosture = SeedNetworkPosture {
  addressing: SeededNetplan { source: "00-gunbc.yaml" as NonEmptyStr },
  family: Ipv4Only,
  mirror: Absent,
}

// THE HOST THAT USED TO COLLIDE WITH ABSENCE. `absent` is a legal NonEmptyStr, so it is nameable here — which is
// the point: the digest preimage must keep it a different seed from the posture above, where no mirror was given.
data posture_host_named_absent: SeedNetworkPosture = SeedNetworkPosture {
  addressing: SeededNetplan { source: "00-gunbc.yaml" as NonEmptyStr },
  family: Ipv4Only,
  mirror: Present { value: NamedMirrorAuthority { host: "absent" as NonEmptyStr } },
}

data posture_installer_managed: SeedNetworkPosture = SeedNetworkPosture {
  addressing: InstallerManaged,
  family: DualStack,
  mirror: Present { value: NamedMirrorAuthority { host: "mirror.internal.invalid" as NonEmptyStr } },
}

// EVERY PACKAGE HERE DECLARES WHICH OF THE THREE KNOWLEDGE ARMS IT IS IN. openssh-server and postfix both
// ship debconf config scripts that ask something on a fresh install, so each carries an ANSWER; nothing in the
// green fixtures is left as an unexamined string, because an unexamined package is a refusal, not a pass.
data clean_packages: List<PackageIntent> = [
  QuestionAnswered {
    package: OpenSshServerPackage,
      answers: debconf_answer_for(
        package: OpenSshServerPackage,
        kind: AnswerBoolean,
        label: "openssh-server/password-authentication" as NonEmptyStr,
        value: "false" as NonEmptyStr,
      ),
  },
  QuestionAnswered {
    package: PostfixPackage,
      answers: debconf_answer_for(
        package: PostfixPackage,
        kind: AnswerSelect,
        label: "postfix/main_mailer_type" as NonEmptyStr,
        value: "No configuration" as NonEmptyStr,
      ),
  },
]

// THE SAME TWO PACKAGES, OTHER ORDER. The digest must not move, or it stops meaning "the same
// configuration" and starts meaning "the same configuration, typed the same way".
data reversed_packages: List<PackageIntent> = [
  QuestionAnswered {
    package: PostfixPackage,
      answers: debconf_answer_for(
        package: PostfixPackage,
        kind: AnswerSelect,
        label: "postfix/main_mailer_type" as NonEmptyStr,
        value: "No configuration" as NonEmptyStr,
      ),
  },
  QuestionAnswered {
    package: OpenSshServerPackage,
      answers: debconf_answer_for(
        package: OpenSshServerPackage,
        kind: AnswerBoolean,
        label: "openssh-server/password-authentication" as NonEmptyStr,
        value: "false" as NonEmptyStr,
      ),
  },
]

// THE ARMS THE AUDIT MUST REFUSE, ONE EACH. QuestionUnanswered is a known question nobody answered;
// UnclassifiedPackage is a package nobody checked — which the old audit let through as answerless-and-fine.
data unseeded_tzdata_packages: List<PackageIntent> = [
  QuestionAnswered {
    package: OpenSshServerPackage,
      answers: debconf_answer_for(
        package: OpenSshServerPackage,
        kind: AnswerBoolean,
        label: "openssh-server/password-authentication" as NonEmptyStr,
        value: "false" as NonEmptyStr,
      ),
  },
  QuestionUnanswered { package: TzdataPackage },
]

// A HALF-ANSWERED tzdata, which is the defect the two-key table exists to catch. tzdata's postinst does
// db_get tzdata/Areas and then db_get "tzdata/Zones/$AREA", so text that names only the region leaves the
// second question live and the installer stopped — with nobody at the panel to answer it. A single-key table
// credited this as closed, and the seed proved non-interactive on a seed that was not. This fixture must stay
// a refusal, and its digest must differ from the fully answered one.
data half_answered_tzdata_packages: List<PackageIntent> = [
  QuestionAnswered {
    package: OpenSshServerPackage,
      answers: debconf_answer_for(
        package: OpenSshServerPackage,
        kind: AnswerBoolean,
        label: "openssh-server/password-authentication" as NonEmptyStr,
        value: "false" as NonEmptyStr,
      ),
  },
  QuestionAnswered {
    package: TzdataPackage,
      answers: debconf_answer_for(
        package: TzdataPackage,
        kind: AnswerSelect,
        label: "tzdata/Areas" as NonEmptyStr,
        value: "America" as NonEmptyStr,
      ),
  },
]

// THE SAME PACKAGE, BOTH KEYS PRESENT — the region AND a zone under it. This is what "answered" has to mean
// when the package asks a pair, and it is the control that stops the half-answer refusal being a bug rather
// than a rule: if the fully seeded text also refused, the audit would be wrong in the other direction and
// would strand an operator whose seed was fine.
data answered_tzdata_packages: List<PackageIntent> = [
  QuestionAnswered {
    package: OpenSshServerPackage,
      answers: debconf_answer_for(
        package: OpenSshServerPackage,
        kind: AnswerBoolean,
        label: "openssh-server/password-authentication" as NonEmptyStr,
        value: "false" as NonEmptyStr,
      ),
  },
  QuestionAnswered {
    package: TzdataPackage,
    answers: list_append(left: debconf_answer_for(
      package: TzdataPackage,
      kind: AnswerSelect,
      label: "tzdata/Areas" as NonEmptyStr,
      value: "America" as NonEmptyStr,
    ),
      right: debconf_answer_for(
        package: TzdataPackage,
        kind: AnswerSelect,
        label: "tzdata/Zones/America" as NonEmptyStr,
        value: "New_York" as NonEmptyStr,
      )),
  },
]

// CLEAN_PACKAGES plus one more ANSWERED question: the only difference is a question that was closed.
data two_answered_packages: List<PackageIntent> = [
  QuestionAnswered {
    package: OpenSshServerPackage,
      answers: debconf_answer_for(
        package: OpenSshServerPackage,
        kind: AnswerBoolean,
        label: "openssh-server/password-authentication" as NonEmptyStr,
        value: "false" as NonEmptyStr,
      ),
  },
  QuestionAnswered {
    package: PostfixPackage,
      answers: debconf_answer_for(
        package: PostfixPackage,
        kind: AnswerSelect,
        label: "postfix/main_mailer_type" as NonEmptyStr,
        value: "No configuration" as NonEmptyStr,
      ),
  },
  QuestionAnswered {
    package: KeyboardConfigurationPackage,
      answers: debconf_answer_for(
        package: KeyboardConfigurationPackage,
        kind: AnswerSelect,
        label: "keyboard-configuration/layout" as NonEmptyStr,
        value: "English (US)" as NonEmptyStr,
      ),
  },
]

data unclassified_packages: List<PackageIntent> = [
  QuestionAnswered {
    package: OpenSshServerPackage,
      answers: debconf_answer_for(
        package: OpenSshServerPackage,
        kind: AnswerBoolean,
        label: "openssh-server/password-authentication" as NonEmptyStr,
        value: "false" as NonEmptyStr,
      ),
  },
  UnclassifiedPackage {
    name: "some-fleet-exporter" as NonEmptyStr,
    answers: [],
  },
]

// THE UNCLASSIFIED ARM WITH A CLEAN HEAD — the same shape unseeded_tzdata_packages gives the open-question
// arm. A scan that stops at the head, or drops the tail, reports the seed non-interactive here and installs a
// board that hangs on the first debconf question with nobody at the console.
data clean_head_then_unclassified_tail: List<PackageIntent> = [
  QuestionAnswered {
    package: PostfixPackage,
      answers: debconf_answer_for(
        package: PostfixPackage,
        kind: AnswerSelect,
        label: "postfix/main_mailer_type" as NonEmptyStr,
        value: "No configuration" as NonEmptyStr,
      ),
  },
  UnclassifiedPackage {
    name: "some-fleet-exporter" as NonEmptyStr,
    answers: [],
  },
]

// A BLOCKER HIDING BEHIND A CLEAN HEAD STILL REFUSES THE SEED, AND NAMES A PACKAGE FROM THE LIST. Both arms
// are checked; each is checked on its own list so a defect in one arm cannot be covered by the other. Which
// of two simultaneous blockers a scan reports first is deliberately NOT pinned — package order is not
// semantic for the digest (see package_order_does_not_move_the_digest), so freezing a scan direction would
// turn an implementation detail into a contract.
test fn a_blocker_anywhere_in_the_list_refuses_the_seed() -> Bool {
  match admit_admin_access_authorisation(authorised_keys: one_key, console_entry: locked_console) {
    Present { value: entry } =>
      audit_refuses_naming_one_of_its_own_packages(
        packages: unseeded_tzdata_packages,
        entry: entry,
      )
        && audit_refuses_naming_one_of_its_own_packages(
          packages: clean_head_then_unclassified_tail,
          entry: entry,
        )
    Absent => false
  }
}

// ONE AUDIT, THE CLAIM STATED AS A SUM-TYPE MATCH. The green arm must be false, and the only true arms are the
// two causes naming the packages these fixtures actually contain ("tzdata" and "some-fleet-exporter"); every
// other cause is false, so the witness cannot be satisfied by an unrelated refusal leaking in from elsewhere in
// the seed, nor by a cause naming a package nobody asked for. Called only on those two fixtures.
fn audit_refuses_naming_one_of_its_own_packages(
  packages: List<PackageIntent>,
  entry: AdminAccessAuthorisation,
) -> Bool {
  match audit_altra_autoinstall_seed( network: network_posture, install_packages: packages, late_packages: [], locale: EnUsUtf8, entry: entry, strategy: virtual_media_strategy, ) {
    SeedIsNonInteractive => false
    SeedRefused { cause: cause } =>
      match cause {
        PackagePrompts { name: named, question: _ } => named == "tzdata" as NonEmptyStr
        PackagePromptingUnclassified { name: named } =>
          named == "some-fleet-exporter" as NonEmptyStr
        AddressingIsInstallerManaged => false
        ArchiveMirrorAbsent => false
        NoEntrypointAtAll => false
      }
  }
}

// THE SAME UNCHECKED PACKAGE, WITH AN ANSWER ATTACHED. The answer cannot make it classifiable: what is missing
// is not a value but the knowledge of whether the package asks anything at all, and a seed must not be able to
// launder that by stuffing a string into the field.
data unclassified_but_seeded_packages: List<PackageIntent> = [
  UnclassifiedPackage {
    name: "some-fleet-exporter" as NonEmptyStr,
    answers: debconf_answer(
      owner: "some-fleet-exporter" as NonEmptyStr,
      kind: AnswerString,
      label: "some-fleet-exporter/dummy" as NonEmptyStr,
      value: "true" as NonEmptyStr,
    ),
  },
]

data pxe_strategy: SeedDeliveryStrategy = PxeStrategy {
  boot_mode: UefiPxe { tftp_root: Uri { scheme: Https, locator: "tftp.internal.invalid" } },
}

data http_boot_strategy: SeedDeliveryStrategy = PxeStrategy { boot_mode: UefiHttpBoot }

data virtual_media_strategy: SeedDeliveryStrategy = VirtualMediaStrategy {
  media_stem: "gunbc-altra-arm64-2026-10-17" as NonEmptyStr,
}

// BIOS PXE IS THE THIRD TRANSPORT AND THE ONLY ONE THAT SHARES A CONSOLE STANZA WITH VIRTUAL MEDIA: both
// suppress the console, so any test of "the transport reaches the digest" that compares PXE against virtual
// media can pass on the console clause alone. This fixture is what forces the transport token itself to
// carry the difference.
data legacy_bios_strategy: SeedDeliveryStrategy = PxeStrategy {
  boot_mode: LegacyBiosPxe { tftp_root: Uri { scheme: Https, locator: "pxe-edge.internal.invalid" } },
}

data same_stem_virtual_media: SeedDeliveryStrategy = VirtualMediaStrategy {
  media_stem: "gunbc-altra-arm64-2026-10-17" as NonEmptyStr,
}

data unlocked_console: ConsoleEntryAuthorisation = ConsoleEntryUnlocked {
  reason: BmcSolConsoleUnlocked,
}

// THE OTHER UNLOCK KIND. Same posture, different exposure: a getty on the panel serial versus SOL over the
// BMC network. On a headless board only the second is reachable, which is why the distinction is worth a type.
data unlocked_serial_console: ConsoleEntryAuthorisation = ConsoleEntryUnlocked {
  reason: SerialConsoleGettyUnlocked,
}

// THE SAME SECRET, IN A DIFFERENT STORE. A credential's version moving within one store and the store itself
// moving are different operator events with different remedies, and a digest that could see only the first
// would answer "the machine booted seed X" wrongly after a migration. Both fixtures differ in the LOCATOR only,
// so this pair is what proves the locator is digested rather than decorative — a field no witness observes is a
// field a refactor may drop.
data relocated_handle: AdminCredentialPosture = PasswordHandle {
  handle: admin_password_handle(
    secret_locator: "vault://gunbc-alternate-store/provisioning/altra/admin" as NonEmptyStr,
    secret_version: "v7" as NonEmptyStr,
  ),
}

data locked_console: ConsoleEntryAuthorisation = ConsoleEntryLocked

data seeded_handle: AdminCredentialPosture = PasswordHandle {
  handle: admin_password_handle(
    secret_locator: "vault://gunbc/provisioning/altra/admin" as NonEmptyStr,
    secret_version: "v7" as NonEmptyStr,
  ),
}

data rotated_handle: AdminCredentialPosture = PasswordHandle {
  handle: admin_password_handle(
    secret_locator: "vault://gunbc/provisioning/altra/admin" as NonEmptyStr,
    secret_version: "v8" as NonEmptyStr,
  ),
}

// ---------------------------------------------------------------------------
// The disk rule, in BOTH halves. Zero and many are different arms, caught by different tests: a single
// test over both would pass if one arm were deleted.
// ---------------------------------------------------------------------------

// CATCHES: a selector matching nothing being treated as "fine, install anyway".
test fn zero_match_selection_is_refused_not_defaulted() -> Bool {
  match select_target_disk(selector: absent_selector, observed: [unique_disk]) {
    SelectionRefused { cause: NoDiskMatches { selector: _ } } => true
    _ => false
  }
}

// CATCHES: a selector matching several disks resolving to the first one — the wrong-disk install on an
// 8-bay board, and the mutation that a "pick head" refactor would introduce.
test fn multiple_match_selection_is_refused_and_names_no_single_disk() -> Bool {
  match select_target_disk(selector: twin_selector, observed: bay_population) {
    SelectionRefused { cause: MultipleDisksMatch { selector: _, candidates: candidates } } =>
      list_length_is(candidates: candidates, expected: 2)
    _ => false
  }
}

// CATCHES: the refusal arms being swapped for each other (zero reported as many, many as zero).
test fn zero_and_multiple_are_distinguishable_arms() -> Bool {
  match select_target_disk(selector: absent_selector, observed: [unique_disk]) {
    SelectionRefused { cause: MultipleDisksMatch { selector: _, candidates: _ } } => false
    _ =>
      match select_target_disk(selector: twin_selector, observed: bay_population) {
        SelectionRefused { cause: NoDiskMatches { selector: _ } } => false
        _ => true
      }
  }
}

// CATCHES: the discriminating count being computed wrongly, e.g. counting all observed disks rather
// than admitted ones (which would make every rule refuse).
test fn exactly_one_match_selects_that_device() -> Bool {
  match select_target_disk(selector: serial_selector, observed: bay_population) {
    DiskSelected { provenance: _ } => true
    SelectionRefused { cause: _ } => false
  }
}

// CATCHES: the BMC's virtual-media device being installable onto. Such a device appears on the board
// during a virtual-media install, and any rule that admits it has erased the operator's own image.
test fn virtual_media_device_is_never_admitted() -> Bool {
  !selector_admits_observed(selector: serial_selector, device: bmc_virtual_media_device)
    && !selector_admits_observed(selector: catalog_selector, device: bmc_virtual_media_device)
}

// CATCHES: the persistence check being dropped, so an ephemeral drive with a matching serial is
// selected — a root filesystem written onto a cache device.
test fn matching_serial_on_a_non_persistent_disk_is_refused() -> Bool {
  !selector_admits_observed(selector: serial_selector, device: ephemeral_disk)
    && !selector_admits_observed(selector: serial_selector, device: cached_mirror_disk)
}

// CATCHES: "the probe could not read the serial" being laundered into "no disk matches", which tells the
// operator to tighten a rule that is already correct.
test fn unread_serial_is_reported_as_unexamined_not_as_no_match() -> Bool {
  match select_target_disk(selector: serial_selector, observed: [serial_unread_disk]) {
    SelectionRefused { cause: CandidateIdentityUnobserved { part_number: _ } } => true
    _ => false
  }
}

// THE UNREAD DISK BEHIND A CLEAN ONE. The unread case above is a one-element list, so an implementation that
// looked only at the head and never scanned the tail would still refuse it, and would then silently install
// onto the disk whose serial nobody read — the exact disk this rule exists to stop. With a readable disk
// first, only a full scan reaches the refusal, and the cause must still name the UNREAD disk by part number,
// not the one at the head.
test fn an_unread_disk_behind_a_readable_one_is_still_caught() -> Bool {
  match select_target_disk(selector: serial_selector, observed: [unique_disk, serial_unread_disk]) {
    SelectionRefused { cause: CandidateIdentityUnobserved { part_number: number } } =>
      number == ("WDS200T2X0E" as NonEmptyStr)
    _ => false
  }
}

// CATCHES: the fixture lying about the probe — if the unread-serial disk actually carries a serial, or a
// bare device is counted as an unexamined candidate, the refusal above is meaningless.
// WHAT THIS ROW CAN AND CANNOT CLAIM (review: merry-fox-82, HOLD section 6). The name it carried — "the probe
// really did not read that serial" — claimed a fact about a hardware probe that this file has no way to observe.
// What is actually being checked is FIXTURE CONSISTENCY: the device authored as serial-unread really is Absent
// under the serial accessor, the serial rule really does treat it as an unexamined candidate, and the two devices
// that DO carry a serial are really not admitted by that rule. Rename it honestly and the claim matches the
// evidence; the probe's own behaviour belongs to S2's witnesses, not here.
test fn the_serial_unread_fixture_agrees_with_the_serial_rule() -> Bool {
  match storage_device_serial(d: serial_unread_disk) {
    Absent =>
      match unexamined_candidate(selector: serial_selector, device: serial_unread_disk) {
        Present { value: _ } =>
          match unexamined_candidate(selector: serial_selector, device: unique_disk) {
            Absent =>
              match unexamined_candidate(selector: serial_selector, device: bmc_virtual_media_device) {
                Absent => true
                Present { value: _ } => false
              }
            Present { value: _ } => false
          }
        Absent => false
      }
    Present { value: _ } => false
  }
}

// CATCHES: the catalog identity's capacity being decorative — a rule naming the right part number and
// the wrong size must refuse, not select.
test fn catalog_identity_requires_the_measured_capacity_to_agree() -> Bool {
  match select_target_disk(selector: catalog_selector, observed: [unique_disk]) {
    DiskSelected { provenance: _ } =>
      match select_target_disk(selector: wrong_capacity_selector, observed: [unique_disk]) {
        SelectionRefused { cause: _ } => true
        DiskSelected { provenance: _ } => false
      }
    SelectionRefused { cause: _ } => false
  }
}

// ---------------------------------------------------------------------------
// Credentials: a handle, and no-valid-way-in is unrepresentable.
// ---------------------------------------------------------------------------

// CATCHES: the guard being removed from the only constructor, so zero authorized keys and a locked
// console becomes a legal record — a headless box that installs and then admits nobody.
test fn no_keys_and_locked_console_cannot_be_constructed() -> Bool {
  match admit_admin_access_authorisation(authorised_keys: no_keys, console_entry: locked_console) {
    Absent => true
    Present { value: _ } => false
  }
}

// CATCHES: the console-unlocked escape being widened into "no keys is always fine", which would make
// the guard above decorative.
test fn no_keys_is_admitted_only_when_the_console_is_deliberately_unlocked() -> Bool {
  match admit_admin_access_authorisation(authorised_keys: no_keys, console_entry: unlocked_console) {
    Present { value: _ } => true
    Absent => false
  }
}

// CATCHES: the entrypoint audit arm firing for a unit that DOES have a way in (the guard inverted), or
// failing to fire when the only way in was removed.
test fn an_unlocked_console_is_not_refused_as_having_no_entrypoint() -> Bool {
  match admit_admin_access_authorisation(authorised_keys: no_keys, console_entry: unlocked_console) {
    Present { value: entry } =>
      match audit_altra_autoinstall_seed( network: network_posture, install_packages: clean_packages, late_packages: [], locale: EnUsUtf8, entry: entry, strategy: virtual_media_strategy, ) {
        SeedRefused { cause: NoEntrypointAtAll } => false
        _ => true
      }
    Absent => false
  }
}

// CATCHES: the credential posture being decorative — a seed that dropped its password and one that kept
// it would render identically, so a boot log could not tell "this unit authenticates by key alone" from
// "someone forgot the handle", even though the operational consequences differ completely.
test fn dropping_the_password_handle_changes_the_seed() -> Bool {
  match build_seed_fixture( network: network_posture, packages: clean_packages, entry_keys: one_key, console: locked_console, credential: seeded_handle, delivery: virtual_media_strategy, target: target_altra, ) {
    Present { value: with_handle } =>
      match build_seed_fixture( network: network_posture, packages: clean_packages, entry_keys: one_key, console: locked_console, credential: PasswordUnset, delivery: virtual_media_strategy, target: target_altra, ) {
        Present { value: without_handle } =>
          !content_hash_eq_structural(
            left: altra_autoinstall_seed_digest(seed: with_handle),
            right: altra_autoinstall_seed_digest(seed: without_handle),
          )
        Absent => false
      }
    Absent => false
  }
}

// A MALFORMED KEY BUILDS NO SEED — THE VALIDATION IS ON THE PRODUCTION ADMISSION ROUTE, NOT AN AUXILIARY MINT
// (review: merry-fox-82, HOLD section 3, item A). AdminAccessAuthorisation is sole_constructor and its ONLY mint
// is admit_admin_access_authorisation, which build_seed_fixture calls before build_altra_autoinstall_seed; so a
// key the ssh parser rejects cannot reach the seed at all — there is no path that hands build_altra_autoinstall_seed
// an entry it did not vet. The positive arm (one_key builds) lives INSIDE this test so that a mutation which made
// the builder always refuse could not turn these five refusals into a green. Each malformed fixture isolates a
// different clause of ssh_ed25519_key_identity (canonical-base64 length / exact-51-octet length / the nineteen
// header octets / an algorithm with no parser), so weakening one clause reddens exactly its row.
test fn no_malformed_key_reaches_the_seed_through_the_builder() -> Bool {
  // POSITIVE CONTROL FIRST: the real provisioning key, same route, DOES build.
  match build_seed_fixture( network: network_posture, packages: clean_packages, entry_keys: one_key, console: locked_console, credential: seeded_handle, delivery: virtual_media_strategy, target: target_altra, ) {
    Absent => false
    Present { value: _ } =>
      list_length(items: [key_not_base64_length, key_trailing_octets, key_declared_wrong_length, keys_rsa, keys_ecdsa]) == 5
        && (match build_seed_fixture( network: network_posture, packages: clean_packages, entry_keys: key_not_base64_length, console: locked_console, credential: seeded_handle, delivery: virtual_media_strategy, target: target_altra, ) {
            Absent => true
            Present { value: _ } => false
          })
        && (match build_seed_fixture( network: network_posture, packages: clean_packages, entry_keys: key_trailing_octets, console: locked_console, credential: seeded_handle, delivery: virtual_media_strategy, target: target_altra, ) {
            Absent => true
            Present { value: _ } => false
          })
        && (match build_seed_fixture( network: network_posture, packages: clean_packages, entry_keys: key_declared_wrong_length, console: locked_console, credential: seeded_handle, delivery: virtual_media_strategy, target: target_altra, ) {
            Absent => true
            Present { value: _ } => false
          })
        && (match build_seed_fixture( network: network_posture, packages: clean_packages, entry_keys: keys_rsa, console: locked_console, credential: seeded_handle, delivery: virtual_media_strategy, target: target_altra, ) {
            Absent => true
            Present { value: _ } => false
          })
        && (match build_seed_fixture( network: network_posture, packages: clean_packages, entry_keys: keys_ecdsa, console: locked_console, credential: seeded_handle, delivery: virtual_media_strategy, target: target_altra, ) {
            Absent => true
            Present { value: _ } => false
          })
  }
}

// ---------------------------------------------------------------------------
// Non-interactivity: the four accidental-prompt mechanisms, each refused by name.
// ---------------------------------------------------------------------------

// CATCHES: a prompting package entering the seed unseeded (the hang nobody can answer), or the audit
// refusing seeded packages.
test fn unseeded_prompting_package_refuses_the_seed() -> Bool {
  match build_seed_fixture( network: network_posture, packages: unseeded_tzdata_packages, entry_keys: one_key, console: locked_console, credential: seeded_handle, delivery: virtual_media_strategy, target: target_altra, ) {
    Absent => true
    Present { value: _ } => false
  }
}

// CATCHES: the missing mirror being treated as harmless. With no archive authority the installer has
// nothing to answer the archive-location question with, so the seed is interactive although no package
// prompts.
test fn absent_mirror_refuses_the_seed() -> Bool {
  match build_seed_fixture( network: posture_no_mirror, packages: clean_packages, entry_keys: one_key, console: locked_console, credential: seeded_handle, delivery: virtual_media_strategy, target: target_altra, ) {
    Absent => true
    Present { value: _ } => false
  }
}

// EACH REFUSAL NAMES ITS OWN MECHANISM. "Refused" is cheap and four causes are available, so a witness that
// only asks "was it refused?" survives a cause being swapped for a sibling — and the cause arm IS the diagnosis:
// a missing archive and installer-managed addressing send the operator to two different files. Each posture is
// therefore matched against the one cause it must produce, which makes any swap between the arms fail at least
// two assertions rather than none. The unclassified arm has its own witness (it must also carry NO question).
test fn each_refusal_names_its_own_mechanism() -> Bool {
  match admit_admin_access_authorisation(authorised_keys: one_key, console_entry: locked_console) {
    Present { value: entry } =>
      match audit_altra_autoinstall_seed( network: posture_no_mirror, install_packages: clean_packages, late_packages: [], locale: EnUsUtf8, entry: entry, strategy: virtual_media_strategy, ) {
        SeedRefused { cause: ArchiveMirrorAbsent } =>
          match audit_altra_autoinstall_seed( network: posture_installer_managed, install_packages: clean_packages, late_packages: [], locale: EnUsUtf8, entry: entry, strategy: virtual_media_strategy, ) {
            SeedRefused { cause: AddressingIsInstallerManaged } =>
              match audit_altra_autoinstall_seed( network: network_posture, install_packages: unseeded_tzdata_packages, late_packages: [], locale: EnUsUtf8, entry: entry, strategy: virtual_media_strategy, ) {
                SeedRefused { cause: PackagePrompts { name: named, question: _ } } =>
                  match named {
                    "tzdata" =>
                      match audit_altra_autoinstall_seed( network: network_posture, install_packages: unclassified_packages, late_packages: [], locale: EnUsUtf8, entry: entry, strategy: virtual_media_strategy, ) {
                        SeedRefused { cause: PackagePromptingUnclassified { name: un } } =>
                          un == "some-fleet-exporter" as NonEmptyStr
                        _ => false
                      }
                    _ => false
                  }
                _ => false
              }
            _ => false
          }
        _ => false
      }
    Absent => false
  }
}

// THE ENTRYPOINT TOKEN DISTINGUISHES THE TWO POSTURES A SEED CAN ACTUALLY INHABIT. The token table has exactly
// two rows because the third (no key AND a locked console) is unnameable; this asserts both rows are observable
// and that they say different things, which is what keeps a swap of the two tokens from surviving. It also
// asserts the key count rides in the token, so dropping an authorized key moves the render.
test fn the_entrypoint_token_distinguishes_the_two_reachable_postures() -> Bool {
  match build_seed_fixture( network: network_posture, packages: clean_packages, entry_keys: no_keys, console: unlocked_console, credential: seeded_handle, delivery: virtual_media_strategy, target: target_altra, ) {
    Present { value: via_console } =>
      match build_seed_fixture( network: network_posture, packages: clean_packages, entry_keys: one_key, console: locked_console, credential: seeded_handle, delivery: virtual_media_strategy, target: target_altra, ) {
        Present { value: via_keys } => entrypoint_tokens_are_distinguishable(
          console_seed: via_console,
          keys_seed: via_keys,
        )
        Absent => false
      }
    Absent => false
  }
}

// CATCHES: installer-managed addressing (the multi-NIC "which interface?" prompt) being accepted.
test fn installer_managed_addressing_refuses_the_seed() -> Bool {
  match build_seed_fixture( network: posture_installer_managed, packages: clean_packages, entry_keys: one_key, console: locked_console, credential: seeded_handle, delivery: virtual_media_strategy, target: target_altra, ) {
    Absent => true
    Present { value: _ } => false
  }
}

// CATCHES: the audit being replaced by a constant, so a well-formed seed stops being accepted (the
// other half of every refusal test above: those prove refusal, this proves acceptance).
test fn a_fully_answerless_seed_is_accepted_with_its_proof() -> Bool {
  match build_seed_fixture( network: network_posture, packages: clean_packages, entry_keys: one_key, console: locked_console, credential: seeded_handle, delivery: virtual_media_strategy, target: target_altra, ) {
    Present { value: _ } => true
    Absent => false
  }
}

// ---------------------------------------------------------------------------
// The target gate: an absent observation is turned away, never defaulted.
// ---------------------------------------------------------------------------

// CATCHES: an unbound unit key being admitted (a seed bound to nothing is a seed replayable onto any
// unit).
test fn unbound_unit_key_cannot_reach_a_target_standing() -> Bool {
  match admit_altra_autoinstall_target( unit_key: unit_key_unbound, architecture: Aarch64, bmc_firmware: bmc_family_observed, role: AltraProvisioningTarget, kernel_flavour: Noble2404GaLinux68, ) {
    TargetRefused { reason: _ } => true
    TargetAdmitted { standing: _ } => false
  }
}

// CATCHES: defaulting an unobserved BMC firmware family, which would silently choose a console stanza
// nobody observed the hardware to support.
test fn unobserved_bmc_family_cannot_reach_a_target_standing() -> Bool {
  match admit_altra_autoinstall_target( unit_key: unit_key_bound_a, architecture: Aarch64, bmc_firmware: bmc_family_unobserved, role: AltraProvisioningTarget, kernel_flavour: Noble2404GaLinux68, ) {
    TargetRefused { reason: _ } => true
    TargetAdmitted { standing: _ } => false
  }
}

// CATCHES: a seed being rendered for a role whose disks are not its own to erase.
test fn a_runner_role_is_refused_a_seed() -> Bool {
  match admit_altra_autoinstall_target( unit_key: unit_key_bound_a, architecture: Aarch64, bmc_firmware: bmc_family_observed, role: RunnerBacked, kernel_flavour: Noble2404GaLinux68, ) {
    TargetRefused { reason: _ } => true
    TargetAdmitted { standing: _ } => false
  }
}

// CATCHES: the architecture gate, i.e. the arm64 package and driver set reaching an x86 unit.
test fn a_non_aarch64_unit_is_refused() -> Bool {
  match admit_altra_autoinstall_target( unit_key: unit_key_bound_a, architecture: X86_64, bmc_firmware: bmc_family_observed, role: AltraProvisioningTarget, kernel_flavour: Noble2404GaLinux68, ) {
    TargetRefused { reason: _ } => true
    TargetAdmitted { standing: _ } => false
  }
}

// CATCHES: a seed being buildable for a refused target.
test fn a_refused_target_yields_no_seed() -> Bool {
  match admit_altra_autoinstall_target( unit_key: unit_key_unbound, architecture: Aarch64, bmc_firmware: bmc_family_observed, role: AltraProvisioningTarget, kernel_flavour: Noble2404GaLinux68, ) {
    TargetRefused { reason: _ } =>
      match build_seed_fixture( network: network_posture, packages: clean_packages, entry_keys: one_key, console: locked_console, credential: seeded_handle, delivery: virtual_media_strategy, target: admit_altra_autoinstall_target( unit_key: unit_key_unbound, architecture: Aarch64, bmc_firmware: bmc_family_observed, role: AltraProvisioningTarget, kernel_flavour: Noble2404GaLinux68, ),
      ) {
        Absent => true
        Present { value: _ } => false
      }
    TargetAdmitted { standing: _ } => false
  }
}

// ---------------------------------------------------------------------------
// The digest: a function of decisions, insensitive to order and sensitive to substance.
// ---------------------------------------------------------------------------

// CATCHES: a rendering that reads a list in call order, which would make two callers with the same
// package set produce two different seed identities.
test fn package_order_does_not_move_the_digest() -> Bool {
  match build_seed_fixture( network: network_posture, packages: clean_packages, entry_keys: one_key, console: locked_console, credential: seeded_handle, delivery: virtual_media_strategy, target: target_altra, ) {
    Present { value: first } =>
      match build_seed_fixture( network: network_posture, packages: reversed_packages, entry_keys: one_key, console: locked_console, credential: seeded_handle, delivery: virtual_media_strategy, target: target_altra, ) {
        Present { value: second } =>
          content_hash_eq_structural(
            left: altra_autoinstall_seed_digest(seed: first),
            right: altra_autoinstall_seed_digest(seed: second),
          )
        Absent => false
      }
    Absent => false
  }
}

// CATCHES: the delivery strategy being decorative in the digest — two installs that differ in transport
// would be indistinguishable in a boot log.
test fn the_transport_moves_the_digest() -> Bool {
  match build_seed_fixture( network: network_posture, packages: clean_packages, entry_keys: one_key, console: locked_console, credential: seeded_handle, delivery: virtual_media_strategy, target: target_altra, ) {
    Present { value: via_media } =>
      match build_seed_fixture( network: network_posture, packages: clean_packages, entry_keys: one_key, console: locked_console, credential: seeded_handle, delivery: pxe_strategy, target: target_altra, ) {
        Present { value: via_pxe } =>
          !content_hash_eq_structural(
            left: altra_autoinstall_seed_digest(seed: via_media),
            right: altra_autoinstall_seed_digest(seed: via_pxe),
          )
        Absent => false
      }
    Absent => false
  }
}

// CATCHES: THE COLLISION THE TAG EXISTS TO PREVENT (review 83255). The digest preimage once rendered an absent
// mirror as the bare word "absent" and a named one as the bare host, so a mirror whose host was literally
// `absent` — a legal NonEmptyStr, and the kind of string a broken config really contains — fed the seed digest
// EXACTLY the bytes of "no mirror at all". That pair is the worst possible collision here, because the two
// postures are one bit apart in the world: with no mirror the seed is REFUSED outright, while a host called
// `absent` is a misconfiguration that goes on to install from a host that does not exist. A digest that cannot
// tell them apart is worse than no digest, because it reads as evidence.
//
// ASSERTED AT THE SPELLING, NOT AT PAIRS OF SEEDS, and that is forced rather than chosen: the refused posture has
// no seed to digest (absent_mirror_refuses_the_seed above proves the producer returns nothing for it), so "two
// seeds that should not collide" is not a constructible question here. What is constructible — and is exactly
// where the bug lived — is the arm spellings that the render concatenates, plus the live seed that does exist.
// So: the two arm spellings must differ (this is the RED this witness must produce against the old code); the
// host arm must not collapse onto any other host; the misconfigured seed must really EXIST (proving the collision
// had a live, receipted side, not two hypotheticals); and its digest must be stable, since a receipt that moved
// every run would be the same class of lie.
// THE TWO SPELLINGS THE PREIMAGE GIVES THE MIRROR, pulled out so the assertions below read as comparisons
// between facts rather than as calls with casts in them. The cast to String is on one line because this
// language will not continue an expression across a newline before `as` — the parse refuses it.
fn absent_mirror_spelling() -> String {
  mirror_diagnostic(mirror: Absent) as String
}

fn host_mirror_spelling(host: NonEmptyStr) -> String {
  mirror_diagnostic(mirror: Present { value: NamedMirrorAuthority { host: host } }) as String
}

test fn a_host_named_after_the_absence_token_is_never_spelled_as_no_host_at_all() -> Bool {
  // THE COLLIDING SPELLING AND THE ABSENT SPELLING MUST DIFFER. Under the preimage this replaced, both sides
  // were the string "absent", and this is the leg that goes RED against it.
  host_mirror_spelling(host: "absent" as NonEmptyStr) != absent_mirror_spelling()
    // THE HOST ARM IS INJECTIVE OVER HOSTS, so the tag is not passing the check above by returning one fixed
    // string for every present mirror: a constant host arm fails here for the right reason.
    && host_mirror_spelling(host: "absent" as NonEmptyStr)
      != host_mirror_spelling(host: "ports.ubuntu.com" as NonEmptyStr)
    && host_mirror_spelling(host: "absent" as NonEmptyStr) != host_mirror_spelling(host: "absentx" as NonEmptyStr)
    // THE ABSENT TOKEN IS NOT ANY OTHER HOST'S SPELLING, swept over hosts a real config could plausibly
    // contain rather than over the single string the review happened to name. There is deliberately no
    // EMPTY-host leg: NonEmptyStr refuses "" at the door, so an arm for it could never go RED -- which is the
    // dead-row defect the earlier reviews filed twice in this module.
    // AND THE COLLISION HAD A LIVE SIDE: the misconfigured seed is PRODUCED, not refused, which is what made
    // the collision consequential instead of theoretical.
    && match build_seed_fixture(
      network: posture_host_named_absent,
      packages: clean_packages,
      entry_keys: one_key,
      console: locked_console,
      credential: seeded_handle,
      delivery: virtual_media_strategy,
      target: target_altra,
    ) {
      Absent => false
      // ITS OWN DIGEST IS STABLE. Not compared to a sibling's: there is no sibling seed to compare it to, for
      // the reason given above, and inventing one would have meant weakening the refusal that keeps the refused
      // posture unproducible.
      Present { value: misconfigured } => content_hash_eq_structural(
        left: altra_autoinstall_seed_digest(seed: misconfigured),
        right: altra_autoinstall_seed_digest(seed: misconfigured),
      )
    }
}

// CATCHES: the persistence decision being taken by a hand-written Bool instead of the exhaustive match
// (review 83320; mutations M26-Persist-AdmissibleArmRefuses / -EphemeralAdmitted / -CacheMirrorAdmitted /
// -DerivedBoolAlwaysTrue / -GateRemovedFromAdmission). This is the decision about whether the installer may
// ERASE a device on an eight-bay board, so it is the one place in the module where "the arms are listed by hand"
// is unacceptable: a new `PersistenceKind` must be decided, not inherited. Asserted per ARM and over all three,
// so the function cannot pass by being constant in either direction.
test fn only_a_persistent_device_is_ever_authorised_to_be_erased_onto() -> Bool {
  // THE ADMISSIBLE ARM PRESENTS THE KIND IT WAS ADMITTED AS, rather than a bare true: the kind is the evidence,
  // and a caller that refuses a device reports it.
  match disk_erase_authorisation(device: unique_disk) {
    Absent => false
    Present { value: kind } =>
      match kind {
        Persistent =>
          // BOTH DENIED KINDS ARE REFUSED, each named, so the module cannot pass by only handling the arm it
          // happens to see on the happy path.
          match disk_erase_authorisation(device: ephemeral_disk) {
            Present { value: _ } => false
            Absent => match disk_erase_authorisation(device: cached_mirror_disk) {
              Present { value: _ } => false
              Absent =>
                // AND THE FILTER'S BOOL IS THE PROJECTION'S PRESENCE, not an independent opinion: a device the
                // projection refuses is the same device the filter drops. If these ever disagreed, the refusal a
                // human reads and the disk the installer picks would be decided twice.
                match disk_erase_authorisation(device: bmc_virtual_media_device) {
                  Present { value: _ } => false
                  Absent =>
                    !disk_may_be_erased_onto(device: ephemeral_disk)
                      && !disk_may_be_erased_onto(device: cached_mirror_disk)
                      && !disk_may_be_erased_onto(device: bmc_virtual_media_device)
                      && disk_may_be_erased_onto(device: unique_disk)
                      // A DISK THE PROBE COULD NOT READ A SERIAL FOR IS STILL ERASABLE: admissibility is about
                      // persistence, and unreadable identity is refused by its OWN arm (CandidateIdentityUnobserved),
                      // not by quietly becoming "not persistent" — collapsing those two is how a serial-less drive
                      // would be reported as the wrong defect page.
                      && disk_may_be_erased_onto(device: serial_unread_disk)
                }
            }
          }
        Ephemeral => false
        CachedMirror => false
      }
  }
}

// CATCHES: a rotated credential leaving the digest alone, which would let a boot log claim "seed X" for
// an install that used a stale secret.
test fn a_rotated_credential_moves_the_digest() -> Bool {
  match build_seed_fixture( network: network_posture, packages: clean_packages, entry_keys: one_key, console: locked_console, credential: seeded_handle, delivery: virtual_media_strategy, target: target_altra, ) {
    Present { value: before } =>
      match build_seed_fixture( network: network_posture, packages: clean_packages, entry_keys: one_key, console: locked_console, credential: rotated_handle, delivery: virtual_media_strategy, target: target_altra, ) {
        Present { value: after } =>
          !content_hash_eq_structural(
            left: altra_autoinstall_seed_digest(seed: before),
            right: altra_autoinstall_seed_digest(seed: after),
          )
        Absent => false
      }
    Absent => false
  }
}

// CATCHES: the console stanza being stored rather than derived from the transport — a virtual-media seed
// must not promise a console a PXE seed may allow, and vice versa.
test fn the_console_stanza_is_derived_from_the_transport() -> Bool {
  match console_stanza_for(strategy: virtual_media_strategy) {
    ConsoleSuppressed =>
      match console_stanza_for(strategy: pxe_strategy) {
        ConsoleAnsweredByUnattended => true
        ConsoleSuppressed => false
      }
    ConsoleAnsweredByUnattended => false
  }
}

// CATCHES: the transport token collapsing every ClientNetworkBootMode member to one spelling. BIOS PXE and
// BMC virtual media both suppress the console, so these two seeds differ ONLY in the transport axis; if they
// hash alike, the digest cannot answer "which transport did this board boot", and the pair of states a boot
// log most needs to tell apart — firmware-side PXE vs BMC-served media — become one answer.
test fn two_transports_sharing_a_console_stanza_do_not_share_a_digest() -> Bool {
  match build_seed_fixture( network: network_posture, packages: clean_packages, entry_keys: one_key, console: locked_console, credential: seeded_handle, delivery: legacy_bios_strategy, target: target_altra, ) {
    Present { value: via_bios } =>
      match build_seed_fixture( network: network_posture, packages: clean_packages, entry_keys: one_key, console: locked_console, credential: seeded_handle, delivery: same_stem_virtual_media, target: target_altra, ) {
        Present { value: via_media } =>
          match console_stanza_for(strategy: legacy_bios_strategy) {
            ConsoleSuppressed =>
              match console_stanza_for(strategy: same_stem_virtual_media) {
                ConsoleSuppressed =>
                  !content_hash_eq_structural(
                    left: altra_autoinstall_seed_digest(seed: via_bios),
                    right: altra_autoinstall_seed_digest(seed: via_media),
                  )
                ConsoleAnsweredByUnattended => false
              }
            ConsoleAnsweredByUnattended => false
          }
        Absent => false
      }
    Absent => false
  }
}

// CATCHES: a boot-mode token with a default arm. UEFI-PXE and UEFI-HTTP-boot answer the same console
// question and differ only in who owns the delivery failure, so the digest is the only place that
// distinction survives — and a future ClientNetworkBootMode member must not be able to borrow either
// spelling silently.
test fn the_boot_mode_moves_the_digest_within_one_transport() -> Bool {
  match build_seed_fixture( network: network_posture, packages: clean_packages, entry_keys: one_key, console: locked_console, credential: seeded_handle, delivery: pxe_strategy, target: target_altra, ) {
    Present { value: via_tftp } =>
      match build_seed_fixture( network: network_posture, packages: clean_packages, entry_keys: one_key, console: locked_console, credential: seeded_handle, delivery: http_boot_strategy, target: target_altra, ) {
        Present { value: via_http } =>
          !content_hash_eq_structural(
            left: altra_autoinstall_seed_digest(seed: via_tftp),
            right: altra_autoinstall_seed_digest(seed: via_http),
          )
        Absent => false
      }
    Absent => false
  }
}

// ---------------------------------------------------------------------------
// The projection edge: upstream wants a hashed_password string, and the only door admits a digest.
// ---------------------------------------------------------------------------

// THE DOOR IS A PARSE, NOT A PREFIX TEST, AND THESE ARE THE CANDIDATES THAT PROVE IT. Every string below is a
// REAL sha512-crypt digest or a deliberately malformed one; the accepted fixture is a digest generated locally
// with `openssl passwd -6 -salt saltsalt hunter2`, quoted verbatim so the acceptance claim is reproducible and
// not a shape the author drew from memory. The old fixtures were 64 fabricated characters and passed only
// because the previous door's floor was 20 — which is exactly how a validation pass masquerades as a parse.
//
// CATCHES: a caller putting a plaintext password into the field subiquity writes to the image's shadow entry.
// "$6$hunter2hunter2hunter2" is the case that used to be accepted: it starts with "$6$" and is longer than 20
// characters, so the old heuristic waved it through. It is refused now because it has three '$'-segments, not
// the four a digest must have.
test fn a_plaintext_password_is_refused_by_the_receipt() -> Bool {
  match refuses(crypt_digest: "hunter2")
    && refuses(crypt_digest: "password12345678901234")
    && refuses(crypt_digest: "$6$hunter2hunter2hunter2")
    && refuses(crypt_digest: "6$saltsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj.")
    && refuses(crypt_digest: "$6$saltsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj")
    && refuses(crypt_digest: "$6$saltsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnjXX")
    && refuses(crypt_digest: "$5$saltsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj.")
    && accepts(crypt_digest: "$6$saltsaltX$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj.")
    // A SALT MAY HOLD PUNCTUATION, BUT NOT ANY PUNCTUATION, AND THIS IS THE LINE THAT WAS WRONG TWICE. An
    // earlier revision refused "sa!tsalt" because it read the accepted set as an allowed-alphabet; the spec
    // reading then flipped it to accept, because the .hash grammar's salt class [^$:\r\n] admits '!'. Both
    // readings were asking the wrong question. The grammar describes the SHAPE of a salt token; the ACCEPTANCE
    // CONTRACT is the shared scan over the whole setting, which refuses '!' (and : ; * \ and every non-printable
    // byte) before the sha512crypt parser is ever reached. Measured against the shipped library, four candidates
    // differing only in this one respect: "$6$saltsalt$..." hashes, "$6$sa!tsalt$..." and "$6$sa:lt$..." are both
    // refused. So '!' is a refusal, the punctuation that is genuinely permitted is the class below, and the
    // difference between a grammar and a contract is the whole reason this shelf cites the source it cites.
    && refuses(crypt_digest: "$6$sa!tsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj.")
    // A COLON is refused too, and by the SAME rule — the shared scan, not the salt class. Pinning which rule
    // refused it is the point: an operator told "your salt holds a forbidden character" goes looking at their
    // credential generator, when the thing to fix is that the setting carries a delimiter at all.
    && refuses(crypt_digest: "$6$sa:tsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj.")
    && refuses(crypt_digest: "$6$rounds=abc$saltsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj.")
    && refuses(crypt_digest: "$6$saltsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6d!9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj.")
    && refuses(crypt_digest: "x$6$saltsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj.")
    && refuses(crypt_digest: "$6$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj.")
    && refuses(crypt_digest: "$6$saltsalt$")
    // AN EMPTY SALT WITH OTHERWISE-EVERYTHING-VALID. Four segments, a legal scheme token, a legal 86-character
    // digest: the ONLY defect is that the salt holds no character at all, so only the width floor can reject it.
    // Without this candidate, deleting the too-short check was invisible (measured GREEN at 60/60) — every other
    // short-salt string on file also broke an earlier rule. An empty salt is the case that matters most: shadow
    // would store a digest with no salt, which makes every credential sharing that digest identical.
    && refuses(crypt_digest: "$6$$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj.")
    // THE COST FIELD, AS ITS CLASS IS WRITTEN: `rounds=[1-9][0-9]+` within 1000..999,999,999. Both bounds are
    // powers of ten, so the range is decidable from the digit COUNT — which is why a single digit, three digits
    // and ten digits are each refused without the door ever converting the text to a number. "rounds=5" is not a
    // cheap-but-valid cost, it is a malformed one: silently parsing it would install a credential whose cost
    // nobody chose, on a board nobody can reach to fix.
    && refuses(crypt_digest: "$6$rounds=5$saltsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj.")
    && refuses(crypt_digest: "$6$rounds=999$saltsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj.")
    && refuses(crypt_digest: "$6$rounds=10000000000$saltsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj.")
    // A LEADING ZERO is outside [1-9], so "rounds=05000" is malformed rather than a slower spelling of 5000.
    && refuses(crypt_digest: "$6$rounds=05000$saltsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj.")
    // A NON-NUMERIC COST OF LEGAL WIDTH. "rounds=abc" above is only three characters, so it is refused by the
    // width check and the digit-strip check is never reached -- a mutation that disabled the strip would be
    // invisible. At four characters the width check passes and ONLY the strip can reject it.
    && refuses(crypt_digest: "$6$rounds=abcd$saltsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj.")
    // ...AND A COST THAT STARTS WITH A DIGIT AND THEN DEVIATES: "rounds=abcd" above is caught by the leading
    // class as much as by the digit strip, so disabling the strip alone was invisible. At "1abc" the first
    // character is a legal [1-9], the width is legal, and ONLY the strip can reject it.
    && refuses(crypt_digest: "$6$rounds=1abc$saltsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj.")
    // ...and the two documented ENDS of the range are accepted, so the check is not secretly a smaller range.
    && accepts(crypt_digest: "$6$rounds=1000$saltsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj.")
    && accepts(crypt_digest: "$6$rounds=999999999$saltsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj.")
    // A DIGEST LONGER THAN 86, as well as the 85-character truncation above. Refusing "at least 86" instead of
    // "exactly 86" accepts this one, and both directions have to be on file or the width is a floor in disguise.
    && refuses(crypt_digest: "$6$saltsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj.XX")
    && accepts(crypt_digest: "$6$saltsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj.")
    // '.' and '/' both occur in real digests; an alphabet missing either would refuse these.
    && accepts(crypt_digest: "$6$sa.lt/sa$d7hkejY7HJ5ZGqHGdfuXgD/tCnk8xlC1ExIqtNkaEkqudX/tH4520c9i883Ib3JvJBsBfcFvy.XSsiW.zAtL01")
    // The explicit-cost spelling is what some generators emit and shadow accepts.
    && accepts(crypt_digest: "$6$rounds=5000$saltsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj.") {
    True => true
    False => false
  }
}

fn refuses(crypt_digest: String) -> Bool {
  match admin_password_hash_receipt(credential: seeded_handle, crypt_digest: crypt_digest as NonEmptyStr) {
    ReceiptRefused { cause: _ } => true
    ReceiptAccepted { receipt: _ } => false
  }
}

// A COUNT, ON THE SAME AXIS THE ROW USES. The witness compares the door's reported widths against the row and
// against the spec's own numbers; writing `seen == 85` against a CharacterCount would be comparing a host integer
// to a measure, which is the mix the carrier exists to prevent. Written once here, so no count in this file is a
// bare Int by accident.
fn char_count(n: Int) -> CharacterCount {
  character_count(count: n)
}

fn accepts(crypt_digest: String) -> Bool {
  match admin_password_hash_receipt(credential: seeded_handle, crypt_digest: crypt_digest as NonEmptyStr) {
    ReceiptRefused { cause: _ } => false
    ReceiptAccepted { receipt: _ } => true
  }
}

// THE FIGURES ARE CITED, AND THE DOOR READS THEM RATHER THAN RESTATING THEM. Two sides, both needed. (1) The
// row's standing must actually be a citation and its read obligation must be Absent: if the standing is ever
// downgraded to a bare constant, or quietly re-typed as an uncited transcription, the obligation appears and this
// goes red — a citation that only exists in a comment is the §4d failure DESIGN says a reader cannot see later.
// (2) The refusal's payload must equal the ROW's figures, not literals in this file: that is what proves the door
// reads upstream. Together they are two-sided — widen the row and the spec pins below go red; hard-code the door
// and the comparison to the row goes red. Either edit alone leaves one witness standing.
//
// The literals are the sha512crypt `.hash` line of crypt(5) at libcrypt1 1:4.4.36-4build1 (Noble arm64), whose
// sha512crypt row is byte-identical to the CI image’s 4.4.38: salt {1,16}, digest
// [./0-9A-Za-z]{86}, cost [1-9][0-9]+ within 1000..999,999,999 (which, both bounds being powers of ten, is the
// digit-count pair 4..9).
test fn the_crypt_figures_are_cited_and_the_door_reads_them() -> Bool {
  match sha512_crypt_figure_read_obligation() {
    // Cited, so nothing is owed before the figures are believed.
    Absent =>
      match sha512_crypt_format {
        Sha512CryptFormat {
          scheme_token: token, cost_marker: marker, salt_forbidden_characters: forbidden,
          salt_least_characters: salt_min, salt_greatest_characters: salt_max, digest_alphabet: alphabet,
          digest_exact_characters: width, cost_least_digits: cost_min, cost_greatest_digits: cost_max,
          figure_standing: standing,
        } =>
          match (token as String) == "6"
            && (marker as String) == "rounds="
            && salt_min == char_count(1) && salt_max == char_count(16)
            && width == char_count(86)
            && cost_min == char_count(4) && cost_max == char_count(9)
            && list_length(items: alphabet) == 64
            && list_length(items: forbidden) == 4
          {
            False => false
            True =>
              // THE STANDING IS THE CITATION, NOT A PLACEHOLDER.
              match standing {
                CitedToAuthority { authority: source } =>
                  match (source.uri.locator as String).contains("besser82/libxcrypt") {
                    False => false
                    True =>
                      // AND THE DOOR'S REFUSALS QUOTE THE ROW. An 85-character digest must report the ROW's
                      // width, and a 17-character salt the ROW's ceiling: if the door carried its own copy of
                      // either number, these two comparisons are where the split shows.
                      match cause_of(crypt_digest: "$6$saltsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj") {
                        Present { value: DigestWrongLength { length: reported, expected: quoted_width } } =>
                          match quoted_width == width && reported == char_count(85) {
                            False => false
                            True =>
                              match cause_of(crypt_digest: "$6$12345678901234567$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj.") {
                                Present { value: SaltTooLong { length: seen_salt, ceiling: quoted_ceiling } } =>
                                  seen_salt == char_count(17) && quoted_ceiling == salt_max && salt_min == char_count(1)
                                _ => false
                              }
                          }
                        _ => false
                      }
                  }
                // An uncited transcription would make the figures a bet consumed as fact. Red on purpose.
                TranscribedUncited { read_obligation: _ } => false
                ObservedByReceipt { observed: _ } => false
              }
          }
      }
    // Somebody owes a read: the figures are not admissible as fact yet.
    Present { value: _ } => false
  }
}

// THE REFUSAL IS TYPED, AND EACH ARM IS REACHED BY ITS OWN CANDIDATE. A refusal that names the wrong part is a
// worse outcome than no refusal at all, because the operator acts on the name: "your digest is 85 characters"
// says re-copy it, "your salt is not over the crypt alphabet" says the credential store handed out something
// that was never a digest. These are different shelves, and a door that collapsed them into one cause (or into a
// bare Absent) would send whoever is holding the secret to the wrong one. Each candidate differs from the
// accepted digest in exactly ONE part, so a cause can only appear if the check that owns that part produced it.
test fn each_refusal_arm_names_the_part_that_failed() -> Bool {
  match cause_of(crypt_digest: "hunter2") {
    Present { value: NotACryptDigest } =>
      match cause_of(crypt_digest: "$6$saltsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj") {
        Present { value: DigestWrongLength { length: seen, expected: wanted } } =>
          seen == char_count(85) && wanted == char_count(86)
          && match cause_of(crypt_digest: "$5$saltsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj.") {
            Present { value: SchemeUnsupported } =>
              // ':' IN THE SALT IS REFUSED, AND BY THE SHARED SCAN — the arm that runs first, exactly as
              // libxcrypt runs it (crypt.c scans the whole setting before dispatching to the scheme parser). It
              // used to be pinned as SaltHoldsForbiddenCharacter, which was true only because the scan did not
              // exist yet; keeping the old pin would have meant the witness was describing a rule order the code
              // no longer has. The salt class is not therefore untested: it is provably SUBSUMED by this scan,
              // and the_salt_character_class_is_subsumed_by_the_shared_scan pins that (including the space and
              // backslash cases the class does not even cover), so if the order ever moves the subsumption
              // witness goes red rather than this one quietly crediting the wrong rule.
              match cause_of(crypt_digest: "$6$sa:tsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj.") {
                Present { value: SettingHoldsReservedCharacter { reserved: delimiter } } =>
                  (delimiter as String) == ":"
                  && match cause_of(crypt_digest: "$6$rounds=abc$saltsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj.") {
                    Present { value: RoundsMalformed } =>
                      match cause_of(crypt_digest: "$6$12345678901234567$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj.") {
                        Present { value: SaltTooLong { length: seen_salt, ceiling: allowed } } =>
                          seen_salt == char_count(17) && allowed == char_count(16)
                          // AND A SALT LONG ENOUGH TO BE REFUSED OUTRIGHT must be refused, not merely reported:
                          // a witness that only ever read the payload would stay green with the ceiling raised to
                          // 64, because 17 > 16 would no longer be true and no check would fire.
                          && match cause_of(crypt_digest: "$6$123456789012345678$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj.") {
                            Present { value: SaltTooLong { length: longer, ceiling: same_ceiling } } =>
                              longer == char_count(18) && same_ceiling == char_count(16)
                              // AND THE FLOOR MUST BLAME THE ABSENT SALT, not the digest: four segments, a legal
                              // token, a legal 86-character digest, and a salt holding no character at all. Only
                              // the width floor can reject that, so it is blamed on SaltAbsent by name -- a
                              // refusal that reached DigestAbsent instead would send the operator to re-paste a
                              // digest that is already correct.
                              && match cause_of(crypt_digest: "$6$$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj.") {
                                Present { value: SaltAbsent } => true
                                _ => false
                              }
                            _ => false
                          }
                        _ => false
                      }
                    _ => false
                  }
                _ => false
              }
            _ => false
          }
        _ => false
      }
    _ => false
  }
}

fn cause_of(crypt_digest: String) -> Optional<AdminPasswordRefusalCause> {
  match admin_password_hash_receipt(credential: seeded_handle, crypt_digest: crypt_digest as NonEmptyStr) {
    ReceiptRefused { cause: cause } => Present { value: cause }
    ReceiptAccepted { receipt: _ } => Absent
  }
}

// THREE CANDIDATES, EACH DEFECTIVE IN EXACTLY ONE WAY, AND THE BLAME MUST LAND ON THAT PART. Refusing is half
// the job: a refusal naming the wrong part sends the operator off to fix something that is not broken, and on a
// headless board the only diagnosis is the one this returns. These three exist because the one-line mutations
// that disabled the digest-alphabet check, the leading-segment check and the segment-count check all came back
// GREEN at 58/58 -- every candidate already on file was defective in several ways at once and was rejected by an
// earlier check, so no witness could see the arm that had been switched off. Isolating one defect per candidate
// is what makes each check load-bearing (DESIGN §4b: an obligation nobody can falsify is not a test).
test fn a_single_defect_candidate_is_blamed_on_the_part_that_is_broken() -> Bool {
  // 86 characters and otherwise well formed, so ONLY the digest-alphabet check can reject it.
  //
  // WHY '#' AND NOT '!', WHICH IS WHAT THIS CANDIDATE USED TO CARRY. A candidate defective in several ways makes
  // every rule but the first untestable, and '!' is defective in two: it is outside the digest alphabet AND it is
  // one of the five characters the shared scan refuses before the parser is ever reached. Pinning the
  // digest-alphabet arm with '!' therefore left that arm unobservable — the scan answered first, and the arm
  // could be deleted with this witness still green. '#' is printable, is not reserved, and is outside the digest
  // alphabet: it passes every earlier check and reaches exactly one. (The shipping library is more lenient here
  // and would take '#' silently; that leniency is filed in the shelf as receipt-only, and refusing it here is the
  // shadow-entry contract crypt.5 states rather than the library's behaviour.)
  match cause_of(crypt_digest: "$6$saltsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6d#9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj.") {
    Present { value: DigestNotInCryptAlphabet } =>
      // four well-formed segments; fails only because the leading segment is not empty.
      match cause_of(crypt_digest: "x$6$saltsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj.") {
        Present { value: NotACryptDigest } =>
          // nothing after the final separator: the digest is absent, not malformed.
          match cause_of(crypt_digest: "$6$saltsalt$") {
            Present { value: DigestAbsent } => true
            _ => false
          }
        _ => false
      }
    _ => false
  }
}

// THE ONE CASE THAT MUST NOT BE A FALSE REFUSAL. An alphabet missing '.' or '/' refuses a credential that was
// generated correctly, and on a board with no console that failure mode is discovered only when nobody can log
// in. This pins both characters as admitted, in a digest produced by a real generator.
test fn a_digest_containing_dot_and_slash_is_accepted() -> Bool {
  accepts(crypt_digest: "$6$sa.lt/sa$d7hkejY7HJ5ZGqHGdfuXgD/tCnk8xlC1ExIqtNkaEkqudX/tH4520c9i883Ib3JvJBsBfcFvy.XSsiW.zAtL01")
}

// CATCHES: the projection accepting an absent receipt, which would put a fabricated string into the
// upstream record. Named rather than Absent: "nothing was read" is an operator event with a page in the
// runbook, and a bare absence is what made it indistinguishable from the other two ways this fails.
test fn the_projection_needs_a_receipt() -> Bool {
  match built_seed_and_binding() {
    Present { value: pair } =>
      match project_autoinstall_identity(
        seed: pair.seed,
        binding_hostname: "unit-a-altra" as NonEmptyStr,
        receipt: Absent,
      ) {
        IdentityReceiptMissing => true
        _ => false
      }
    Absent => false
  }
}

// THE HEADER'S CLAIM ABOUT THE CALLER-SUPPLIED LABEL, CHECKED. The hostname reaches the upstream identity
// VERBATIM — not dropped, not defaulted to a constant — and two different labels produce two different
// identities. Why this is the right test rather than a digest comparison: the label cannot move the seed
// digest because `altra_autoinstall_seed_digest` takes ONLY a seed, so there is no signature in which to
// write "mix the hostname into the digest" — the guarantee is the parameter list, and the digest's actual
// content is pinned axis-by-axis by the digest witnesses below. What IS falsifiable here, and what this
// catches, is the projection substituting a baked hostname (a per-unit special case wearing a config
// field, which is precisely what the module forbids) or dropping the label.
test fn the_projection_carries_the_supplied_label_verbatim_and_never_invents_one() -> Bool {
  match admin_password_hash_receipt( credential: seeded_handle, crypt_digest: "$6$saltsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj." as NonEmptyStr, ) {
    ReceiptRefused { cause: _ } => false
    ReceiptAccepted { receipt: receipt } =>
      match built_seed_and_binding() {
        Absent => false
        Present { value: pair } =>
          match project_autoinstall_identity( seed: pair.seed, binding_hostname: "unit-a-altra" as NonEmptyStr, receipt: Present { value: receipt }, ) {
            ProjectedIdentity { identity: first } =>
              match project_autoinstall_identity( seed: pair.seed, binding_hostname: "an-entirely-different-label" as NonEmptyStr, receipt: Present { value: receipt }, ) {
                ProjectedIdentity { identity: second } =>
                  first.hostname == ("unit-a-altra" as NonEmptyStr)
                    && second.hostname
                      == ("an-entirely-different-label" as NonEmptyStr)
                    && first.hostname != second.hostname
                _ => false
              }
            _ => false
          }
      }
  }
}

// ---------------------------------------------------------------------------
// The binding.
// ---------------------------------------------------------------------------

// CATCHES: a binding whose digest was not computed from the seed it names — the evidence-free claim the
// sole_constructor exists to forbid, checked by asking the binding to re-verify the seed.
test fn a_binding_confirms_the_very_seed_it_was_built_from() -> Bool {
  match built_seed_and_binding() {
    Present { value: pair } =>
      match check_binding_against_seed( binding: pair.binding, seed: pair.seed, unit_key: unit_a_key, attempt: attempt_one, ) {
        BoundConfigurationMatchesSeed => true
        _ => false
      }
    Absent => false
  }
}

// CATCHES: a digest comparison that always says "same", which would let a wrong seed be reported as the
// one that booted.
test fn a_different_seed_is_reported_as_a_different_seed() -> Bool {
  match built_seed_and_binding() {
    Present { value: pair } =>
      match build_seed_fixture( network: network_posture, packages: clean_packages, entry_keys: one_key, console: locked_console, credential: rotated_handle, delivery: virtual_media_strategy, target: target_altra, ) {
        Present { value: other } =>
          match check_binding_against_seed( binding: pair.binding, seed: other, unit_key: unit_a_key, attempt: attempt_one, ) {
            BoundConfigurationDiffersFromSeed => true
            _ => false
          }
        Absent => false
      }
    Absent => false
  }
}

// CATCHES: a binding answering a question about a different unit or attempt, which is the "answer from
// memory" failure the binding record exists to remove.
test fn a_binding_for_another_unit_or_attempt_is_foreign() -> Bool {
  match built_seed_and_binding() {
    Present { value: pair } =>
      match check_binding_against_seed( binding: pair.binding, seed: pair.seed, unit_key: unit_b_key, attempt: attempt_one, ) {
        // THE ARM IS NAMED, NOT WILDCARDED. Accepting "anything but BoundConfigurationMatchesSeed" would also
        // accept a missing-arm defect that routed a foreign binding to BoundConfigurationDiffersFromSeed -- the
        // two verdicts have opposite remedies (wrong machine vs same machine, stale seed), so only the foreign
        // verdict proves the identity check ran.
        BindingIsForeign =>
          match check_binding_against_seed( binding: pair.binding, seed: pair.seed, unit_key: unit_a_key, attempt: attempt_two, ) {
            BindingIsForeign => true
            _ => false
          }
        _ => false
      }
    Absent => false
  }
}

// CATCHES: the same seed on two units colliding in the binding address space — the seeds must agree (one
// config, one digest) while the bindings must not (two events).
test fn two_units_sharing_a_seed_do_not_share_a_binding_identity() -> Bool {
  // EVERY DIGEST IN THE COMPARISON IS READ OUT OF A REAL BINDING THROUGH THE PUBLIC CONSTRUCTOR, and a bind that
  // refuses makes the row false rather than substituting anything (review: merry-fox-82). The previous version
  // called a helper whose refused arm returned a fixed-string digest, so the row could have been satisfied by
  // comparing two stand-ins while reading as a comparison of two bindings' digests.
  match build_seed_fixture( network: network_posture, packages: clean_packages, entry_keys: one_key, console: locked_console, credential: seeded_handle, delivery: virtual_media_strategy, target: target_altra, ) {
    Present { value: seed } =>
      match build_seed_fixture( network: network_posture, packages: clean_packages, entry_keys: one_key, console: locked_console, credential: seeded_handle, delivery: virtual_media_strategy, target: target_altra_b, ) {
        Present { value: sibling } =>
          match binding_digest_of(seed: seed, unit: unit_a_key, attempt: attempt_one) {
            Absent => false
            Present { value: first_digest } =>
              match binding_digest_of(seed: seed, unit: unit_b_key, attempt: attempt_one) {
                Absent => false
                Present { value: second_digest } =>
                  // SAME SEED on both sides: the configuration digest must be identical, and the binding
                  // addresses must not be.
                  content_hash_eq_structural(
                    left: altra_autoinstall_seed_digest(seed: seed),
                    right: altra_autoinstall_seed_digest(seed: sibling),
                  )
                    && !content_hash_eq_structural(left: first_digest, right: second_digest)
              }
          }
        Absent => false
      }
    Absent => false
  }
}

// CATCHES: a binding existing for a disk the rules refused — a record of an install that could not have
// happened.
// The binding carries WHICH gate refused it, and does not swap them. A binding over a refused
// target that blamed the disk would send the operator to the storage shelf for a firmware
// standing that was never observed.
test fn a_refused_target_binds_with_a_target_blocker_not_a_disk_blocker() -> Bool {
  match build_seed_fixture( network: network_posture, packages: clean_packages, entry_keys: one_key, console: locked_console, credential: seeded_handle, delivery: virtual_media_strategy, target: target_altra, ) {
    Present { value: seed } =>
      match bind_altra_autoinstall_seed( seed: seed, target: target_refused_by_unbound_key(), unit_key: unit_a_key, attempt: attempt_one, selection: select_target_disk(selector: serial_selector, observed: bay_population),
        ) {
        BindRefused { blocker: TargetNotAdmitted { cause: UnitKeyUnbound { cause: BoardSerialAbsent } } } => true
        _ => false
      }
    Absent => false
  }
}

// A target turned away for the same reason the witness above pins, built once so the refusal under test is
// the door's own output rather than a hand-written record that could drift from it.
fn target_refused_by_unbound_key() -> AltraAutoinstallTarget {
  admit_altra_autoinstall_target(
    unit_key: unit_key_unbound,
    architecture: Aarch64,
    bmc_firmware: bmc_family_observed,
    role: AltraProvisioningTarget,
    kernel_flavour: Noble2404GaLinux68,
  )
}

test fn a_binding_cannot_exist_over_a_refused_disk_selection() -> Bool {
  match build_seed_fixture( network: network_posture, packages: clean_packages, entry_keys: one_key, console: locked_console, credential: seeded_handle, delivery: virtual_media_strategy, target: target_altra, ) {
    Present { value: seed } =>
      match bind_altra_autoinstall_seed( seed: seed, target: target_altra, unit_key: unit_a_key, attempt: attempt_one, selection: select_target_disk(selector: twin_selector, observed: bay_population),
        ) {
        BindRefused { blocker: _ } => true
        Bound { binding: _ } => false
      }
    Absent => false
  }
}

// CATCHES: the selected disk's identity not being recorded in the binding, which is what makes "what did
// that install write to?" answerable from the record alone.
test fn a_binding_records_the_serial_it_wrote_to() -> Bool {
  match built_seed_and_binding() {
    Present { value: pair } =>
      match pair.binding.disk_selection {
        BoundDisk { serial: recorded, matched: _, observed: _ } => recorded == ("UNIQUE-SERIAL-0007" as NonEmptyStr)
        _ => false
      }
    Absent => false
  }
}

// ---------------------------------------------------------------------------
// Helpers. Each returns Optional so the tests above stay single-assertion.
// ---------------------------------------------------------------------------

type SeedAndBinding {
  seed: AltraAutoinstallSeed
  binding: AltraAutoinstallSeedBinding
}

fn built_seed_and_binding() -> Optional<SeedAndBinding> {
  match build_seed_fixture( network: network_posture, packages: clean_packages, entry_keys: one_key, console: locked_console, credential: seeded_handle, delivery: virtual_media_strategy, target: target_altra, ) {
    Present { value: seed } =>
      match bind_altra_autoinstall_seed( seed: seed, target: target_altra, unit_key: unit_a_key, attempt: attempt_one, selection: select_target_disk(selector: serial_selector, observed: bay_population),
        ) {
        Bound { binding: binding } => Present { value: SeedAndBinding { seed: seed, binding: binding } }
        BindRefused { blocker: _ } => Absent
      }
    Absent => Absent
  }
}

fn binding_digest_of(
  seed: AltraAutoinstallSeed,
  unit: UnitKey,
  attempt: IntakeAttemptId,
) -> Optional<Fnv1a64Structural> {
  match bind_altra_autoinstall_seed( seed: seed, target: target_altra, unit_key: unit, attempt: attempt, selection: select_target_disk(selector: serial_selector, observed: bay_population),
    ) {
    // NO PLACEHOLDER ON EITHER ARM (review: merry-fox-82). The refused arm used to return a stand-in digest of
    // a fixed string, which let the comparison below pass on two stand-ins while claiming to compare two
    // bindings' digests. A refused bind now yields Absent and the caller fails — which is what "no evidence"
    // means, and it makes it impossible for a row to compare one real digest against one invented one.
    Bound { binding: binding } => Present { value: binding_digest(binding: binding) }
    BindRefused { blocker: _ } => Absent
  }
}

// THE ONE CANONICAL ACCEPTED sha512-CRYPT DIGEST THIS RIG READS FROM THE SECRET STORE. Every fixture that needs a
// credential whose hash has passed the format door goes through here, so the accepted shape exists once. Its
// widths and alphabet are not invented in this file — they are extdeps.libxcrypt.crypt_scheme's, and the
// accepted-vs-refused status of exactly this string is one row of the measured acceptance ledger in the module
// under test. The ledger's size is not transcribed here (DESIGN §6): the three per-arm tallies below fold it, and
// a row is matched against the ledger by its setting string rather than by an index into a hand-counted list.
data rig_credential_digest: String = "$6$saltsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj."

// PASSWORD_READ_FOR IS THE RIG'S STAND-IN FOR WHOEVER READS THE VAULT, not a second authority. The seed module
// never reads a secret; it receives a receipt that some other layer produced by reading the handle named in the
// seed. A witness cannot read a vault, so it mints the receipt through the SAME public constructor that producer
// uses, over the canonical accepted digest — which keeps the claim honest in both directions: a PasswordHandle
// seed always arrives with a format-accepted read naming its own secret, and a handle with no read is reachable
// only by asking for it explicitly (tested separately), because the public constructor refuses a seed whose read
// names a different secret.
fn password_read_for(credential: AdminCredentialPosture) -> Optional<AdminPasswordHashReceipt> {
  match admin_password_hash_receipt(credential: credential, crypt_digest: rig_credential_digest as NonEmptyStr) {
    ReceiptAccepted { receipt: accepted } => Present { value: accepted }
    ReceiptRefused { cause: _ } => Absent
  }
}

// THE CANONICAL DIGEST AS PLAIN TEXT, for rows that must say what must NOT appear in a rendered document.
data crypt_digest_as_text: String = "$6$saltsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj."

// A DECLINED CREDENTIAL CARRIES NO READ, AND A READ ON A DECLINED CREDENTIAL IS A LOST SEED. The mirror image
// of the cross-secret row above: a seed that says it has no password, handed a receipt naming some secret, is not
// a seed with extra evidence — it is a caller who has lost track of which seed they are holding, and the
// constructor refuses. Without this arm, a declined-posture seed could be built holding a hash that its own
// posture says does not exist, and the document would carry a credential its admission argument forbids.
test fn a_declined_credential_holding_a_receipt_never_becomes_a_seed() -> Bool {
  match password_read_for(credential: seeded_handle) {
    // The read has to be admissible on its own, or the row would refuse for the wrong reason.
    Absent => false
    Present { value: read } =>
      match build_seed_fixture_with_read(read: Present { value: read }, credential: PasswordUnset) {
        Absent => true
        Present { value: mismatched } => false
      }
  }
}

// A HANDLE WHOSE VAULT READ FAILED: the seed is buildable, and it refuses to produce a document, by name.
fn password_read_absent() -> Optional<AdminPasswordHashReceipt> {
  Absent
}

// THE CROSS-SECRET JOIN, REACHED THROUGH THE PUBLIC CONSTRUCTOR (review: merry-fox-82). The seed says the
// credential is seeded_handle; the caller hands over a receipt minted for rotated_handle — same alphabet, same
// width, a real accepted digest, the wrong secret. The constructor refuses, because a receipt is evidence about
// ONE secret and a seed that ships a hash read from a different one would look internally consistent in every
// record except the truth. This is the only row that names a wrong join; deleting the pairing check from the
// constructor makes it go red without touching any other arm.
// THE PAIRING CHECKS BOTH FIELDS OF THE HANDLE, AND THE TWO ARE TESTED SEPARATELY. seeded_handle and
// rotated_handle share their locator and differ ONLY in secret_version ("v7"/"v8"), so this row is the one that
// pins the version half of the join: if the comparison were dropped, or shortened to a prefix, or replaced by a
// locator-only lookup, the rotated secret's read would ride into the seed built for the live secret and the
// rendered shadow entry would carry a hash the vault has already retired. The locator half has its own row
// (the cross-SECRET fixture below) so neither half can be carried by the other.
test fn a_receipt_for_another_secret_never_becomes_a_seed() -> Bool {
  match admin_password_hash_receipt(credential: rotated_handle, crypt_digest: rig_credential_digest as NonEmptyStr) {
    // The other handle's own read must be admissible on its own, or the row would prove nothing: a refusal from
    // the format door would make the build Absent for the wrong reason.
    ReceiptRefused { cause: _ } => false
    ReceiptAccepted { receipt: for_other_secret } =>
      // THE TWO HANDLES MUST BE GENUINELY THE SAME SECRET AT TWO VERSIONS. If a fixture edit gave the rotated
      // handle a different locator, this row would silently degrade into the locator-only test and the version
      // comparison would go unexercised.
      match provenance_pairing_inputs_are_version_only() {
        False => false
        True =>
          match build_seed_fixture_with_read(read: Present { value: for_other_secret }, credential: seeded_handle) {
            Absent => true
            Present { value: wrongly_paired } => false
          }
      }
  }
}

// THE FIXTURE ISOLATES THE VERSION AXIS: same locator, different version. Asserted separately so a fixture edit
// cannot turn the row above into a duplicate of the cross-locator test while still passing.
fn provenance_pairing_inputs_are_version_only() -> Bool {
  match seeded_handle {
    PasswordUnset => false
    PasswordHandle { handle: live } =>
      match rotated_handle {
        PasswordUnset => false
        PasswordHandle { handle: retired } =>
          live.secret_locator == retired.secret_locator && live.secret_version != retired.secret_version
      }
  }
}

// TWO HANDLES WHOSE PARTS COULD SWIM PAST AN UNFRAMED JOIN (review: merry-fox-82, HOLD section 4). Built so that
// gluing locator and version with a separator puts the boundary in different places for the two of them: the
// first locator ENDS with what the second's version begins. Their diagnostics must differ, which is only true
// while each part carries its own label and its own character count.
data boundary_left_locator: NonEmptyStr = "vault://s4/admin|version=v1" as NonEmptyStr
data boundary_left_version: NonEmptyStr = "v2" as NonEmptyStr
data boundary_right_locator: NonEmptyStr = "vault://s4/admin" as NonEmptyStr
data boundary_right_version: NonEmptyStr = "v1|version=v2" as NonEmptyStr

// THE LENGTH PREFIX HAS TO BE ARITHMETIC, NOT ORNAMENT (mutation: the count dropped from the prefix). A label
// with a bracket and no width is only marginally better than the bare "|" it replaced: "locator[v1]|version[...]"
// and "locator[v1|version[...]" differ only because somebody happened not to write a bracket. The prefix earns
// its place by being RECOMPUTED from the value, so this row checks the digits against the length of what follows
// them — for both parts — which is a claim about one handle's own text rather than a difference between two.
test fn the_framing_prefixes_each_part_with_its_own_recomputed_length() -> Bool {
  match credential_diagnostic(
    posture: PasswordHandle {
      handle: admin_password_handle(
        secret_locator: boundary_left_locator,
        secret_version: boundary_right_version,
      ),
    },
  ) {
    text =>
      match text.contains(
        needle: concat("locator[", to_string(boundary_left_locator.length()) as NonEmptyStr) as NonEmptyStr,
      ) {
        False => false
        True =>
          text.contains(
            needle: concat("version[", to_string(boundary_right_version.length()) as NonEmptyStr) as NonEmptyStr,
          )
      }
  }
}

test fn two_handles_whose_parts_could_swim_past_an_unframed_join_are_distinguished() -> Bool {
  match credential_diagnostic(
    posture: PasswordHandle {
      handle: admin_password_handle(secret_locator: boundary_left_locator, secret_version: boundary_left_version),
    },
  ) {
    left_text =>
      match credential_diagnostic(
        posture: PasswordHandle {
          handle: admin_password_handle(
            secret_locator: boundary_right_locator,
            secret_version: boundary_right_version,
          ),
        },
      ) {
        right_text => left_text != right_text
      }
  }
}


// THE SAME BUILDER, WITH THE MODULE LIST AS A PARAMETER, so one witness can vary ONLY the loadable-module axis.
// A variant builder rather than a defaulted parameter: the default would silently make every other witness
// pass with an empty module list, and "empty" is exactly the state this axis is meant to refuse.

fn build_seed_fixture_with_modules(
  network: SeedNetworkPosture,
  packages: List<PackageIntent>,
  entry_keys: List<SshPublicKey>,
  console: ConsoleEntryAuthorisation,
  credential: AdminCredentialPosture,
  delivery: SeedDeliveryStrategy,
  target: AltraAutoinstallTarget,
  modules: List<AltraLoadableModule>,
) -> Optional<AltraAutoinstallSeed> {
  match admit_admin_access_authorisation(authorised_keys: entry_keys, console_entry: console) {
    Present { value: entry } =>
      build_altra_autoinstall_seed(
        target: target,
        network: network,
        install_drivers: [NvmeCliDriver, LinuxFirmwareDriver],
        loadable_modules: modules,
        late_drivers: [KipmiSiDriver, IpmiWatchdogDriver],
        install_packages: packages,
        late_packages: [],
        disk: serial_selector,
        entry: entry,
        credential: credential,
        password_read: password_read_for(credential: credential),
        locale: EnUsUtf8,
        delivery: delivery,
        keyboard: UsLayout,
      )
    Absent => Absent
  }
}

// THE FIXTURE SEED, BUILT UNDER A NAMED RULE. The disk rule is a parameter rather than a constant because the
// binding's "same rule, different drive" witness has to hold the RULE fixed and vary the DRIVE; a builder that
// hardwired a selector can only produce fixtures whose rule moves, which is exactly the case the seed/target join
// now (correctly) refuses — so the witness would have compared a bound binding against a refused one and called
// that two addresses. The unparameterised name below is this builder under the rule every existing caller already
// used, so those call sites keep their meaning unchanged.
//
// THE LATE SET IS THE REAL ONE. It used to be `late_packages: []`, which is what made the "the produced seed
// installs the Altra late package set" witness a witness about an empty list: a nonempty claim can only be
// falsified if the fixture is nonempty, and it was not. It now carries the four cited-silent rows the board
// actually needs, which only the fourth PackageIntent arm made expressible.
fn build_seed_fixture_under_rule(
  rule: TargetDiskSelector,
  network: SeedNetworkPosture,
  packages: List<PackageIntent>,
  entry_keys: List<SshPublicKey>,
  console: ConsoleEntryAuthorisation,
  credential: AdminCredentialPosture,
  delivery: SeedDeliveryStrategy,
  target: AltraAutoinstallTarget,
) -> Optional<AltraAutoinstallSeed> {
  match admit_admin_access_authorisation(authorised_keys: entry_keys, console_entry: console) {
    Present { value: entry } =>
      build_altra_autoinstall_seed(
        target: target,
        network: network,
        install_drivers: [NvmeCliDriver, LinuxFirmwareDriver],
        loadable_modules: [AhciPlatformModule, NvmeBlockModule],
        late_drivers: [KipmiSiDriver, IpmiWatchdogDriver],
        install_packages: packages,
        late_packages: altra_required_late_package_rows(),
        disk: rule,
        entry: entry,
        credential: credential,
        password_read: password_read_for(credential: credential),
        locale: EnUsUtf8,
        delivery: delivery,
        keyboard: UsLayout,
      )
    Absent => Absent
  }
}

// THE SAME BUILDER UNDER THE RULE EVERY FIXTURE HAS ALWAYS USED, stated once so a future caller that needs a
// different rule says so at the call site instead of silently installing onto whatever a helper decided for it.
fn build_seed_fixture(
  network: SeedNetworkPosture,
  packages: List<PackageIntent>,
  entry_keys: List<SshPublicKey>,
  console: ConsoleEntryAuthorisation,
  credential: AdminCredentialPosture,
  delivery: SeedDeliveryStrategy,
  target: AltraAutoinstallTarget,
) -> Optional<AltraAutoinstallSeed> {
  build_seed_fixture_under_rule(
    rule: serial_selector,
    network: network,
    packages: packages,
    entry_keys: entry_keys,
    console: console,
    credential: credential,
    delivery: delivery,
    target: target,
  )}

// THE SAME BUILDER, WITH THE VAULT READ SUPPLIED EXPLICITLY. Only one thing varies against
// build_seed_fixture_under_rule: which read the caller hands the constructor. That is the whole difference
// between "the secret was read" and "the read failed", and it must be reachable without editing any other axis,
// because the arm it drives (no document) is the arm that keeps a placeholder out of a credential field.
fn build_seed_fixture_with_read(
  read: Optional<AdminPasswordHashReceipt>,
  credential: AdminCredentialPosture,
) -> Optional<AltraAutoinstallSeed> {
  match admit_admin_access_authorisation(authorised_keys: one_key, console_entry: locked_console) {
    Present { value: entry } =>
      build_altra_autoinstall_seed(
        target: target_altra,
        network: network_posture,
        install_drivers: [NvmeCliDriver, LinuxFirmwareDriver],
        loadable_modules: [AhciPlatformModule, NvmeBlockModule],
        late_drivers: [KipmiSiDriver, IpmiWatchdogDriver],
        install_packages: clean_packages,
        late_packages: altra_required_late_package_rows(),
        disk: serial_selector,
        entry: entry,
        credential: credential,
        password_read: read,
        locale: EnUsUtf8,
        delivery: virtual_media_strategy,
        keyboard: UsLayout,
      )
    Absent => Absent
  }
}

// THE TWO REFUSALS AN OPERATOR HAS TO TELL APART, held apart deliberately. "No disk matched your rule" and
// "we could not read the serials" send the operator to different remedies — the first says tighten the rule,
// the second says go re-probe the board — and a selection path that collapsed them would send someone to
// tighten a rule that is already correct. Distinguishing them here (rather than only asserting both refuse) is
// what makes the arms load-bearing.
test fn unreadable_serial_and_zero_match_are_different_refusals() -> Bool {
  match select_target_disk(selector: serial_selector, observed: [serial_unread_disk]) {
    SelectionRefused { cause: CandidateIdentityUnobserved { part_number: _ } } =>
      match select_target_disk(selector: absent_selector, observed: [unique_disk]) {
        SelectionRefused { cause: NoDiskMatches { selector: _ } } => true
        _ => false
      }
    _ => false
  }
}

// THE HEAD OF THE FIX FOR THE FAIL-OPEN AUDIT. A package nobody has classified used to reach the green arm as
// "answerless, therefore nothing to answer". It is now a refusal in its own right, and the refusal must NOT
// carry a question — this module has not observed one, and printing a plausible question is the fabricated
// output the audit exists to prevent.
test fn an_unclassified_package_refuses_the_seed_without_inventing_a_question() -> Bool {
  match build_seed_fixture( network: network_posture, packages: unclassified_packages, entry_keys: one_key, console: locked_console, credential: seeded_handle, delivery: virtual_media_strategy, target: target_altra, ) {
    Present { value: _ } => false
    Absent =>
      match admit_admin_access_authorisation(authorised_keys: one_key, console_entry: locked_console) {
        Present { value: entry } =>
          match audit_altra_autoinstall_seed( network: network_posture, install_packages: unclassified_packages, late_packages: [], locale: EnUsUtf8, entry: entry, strategy: virtual_media_strategy, ) {
            SeedRefused { cause: PackagePromptingUnclassified { name: _ } } => true
            _ => false
          }
        Absent => false
      }
  }
}

// AN ANSWER CANNOT CLASSIFY A PACKAGE. A caller who does not know whether a package prompts must not be able to
// launder it into the green arm by stuffing a string into the seed field: what is missing is knowledge, not a
// value. This is the difference between this audit and a flag.
test fn a_debconf_seed_cannot_classify_an_unchecked_package() -> Bool {
  match admit_admin_access_authorisation(authorised_keys: one_key, console_entry: locked_console) {
    Present { value: entry } =>
      match audit_altra_autoinstall_seed( network: network_posture, install_packages: unclassified_but_seeded_packages, late_packages: [], locale: EnUsUtf8, entry: entry, strategy: virtual_media_strategy, ) {
        SeedRefused { cause: PackagePromptingUnclassified { name: _ } } => true
        _ => false
      }
    Absent => false
  }
}

// THE CONSOLE STANZA IS DERIVED FROM THE TRANSPORT ARM BY ARM. Each of the four transports states which of the
// two console stories it gets, so a collapsed arm (the mutation this row exists for) shows up here rather than
// being inferred from a digest. Asserting the mapping directly is the honest test: two transports that share a
// console story can still differ in the digest via the transport token, so digest equality would prove nothing
// about this function, and digest inequality would prove the wrong thing.
test fn each_transport_states_its_own_console_story() -> Bool {
  console_stanza_is_suppressed(stanza: console_stanza_for(strategy: legacy_bios_strategy))
    && console_stanza_is_suppressed(stanza: console_stanza_for(strategy: virtual_media_strategy))
    && console_stanza_is_answered(stanza: console_stanza_for(strategy: pxe_strategy))
    && console_stanza_is_answered(stanza: console_stanza_for(strategy: http_boot_strategy))
}

// THE STANZA'S RENDERED SPELLING, NOT JUST ITS ARM. The witness above checks the semantic arm; this checks
// the token that reaches a boot log and the digest. They are different guarantees: an implementation that
// rendered ConsoleAnsweredByUnattended with the suppression spelling kept every arm-level witness green while
// making the two postures indistinguishable in the only artifact anyone reads after the fact — and a seed
// that claims its prompts were suppressed when UEFI in fact prints to a console is a false non-interactivity
// proof. Each transport must say exactly one of the two, and must not say the other.
test fn the_stanza_token_says_suppression_or_answering_and_never_both() -> Bool {
  suppressed_transports_render_suppressed() && answered_transports_render_unattended_answer()
}

fn suppressed_transports_render_suppressed() -> Bool {
  match build_seed_fixture( network: network_posture, packages: clean_packages, entry_keys: one_key, console: locked_console, credential: seeded_handle, delivery: legacy_bios_strategy, target: target_altra, ) {
    Absent => false
    Present { value: bios } =>
      match build_seed_fixture( network: network_posture, packages: clean_packages, entry_keys: one_key, console: locked_console, credential: seeded_handle, delivery: virtual_media_strategy, target: target_altra, ) {
        Absent => false
        Present { value: media } =>
          render_altra_autoinstall_seed(seed: bios).contains("console=suppressed")
            && render_altra_autoinstall_seed(seed: media).contains("console=suppressed")
            && !render_altra_autoinstall_seed(seed: bios).contains("console=unattended-answer")
            && !render_altra_autoinstall_seed(seed: media).contains("console=unattended-answer")
      }
  }
}

fn answered_transports_render_unattended_answer() -> Bool {
  match build_seed_fixture( network: network_posture, packages: clean_packages, entry_keys: one_key, console: locked_console, credential: seeded_handle, delivery: pxe_strategy, target: target_altra, ) {
    Absent => false
    Present { value: pxe } =>
      match build_seed_fixture( network: network_posture, packages: clean_packages, entry_keys: one_key, console: locked_console, credential: seeded_handle, delivery: http_boot_strategy, target: target_altra, ) {
        Absent => false
        Present { value: http } =>
          render_altra_autoinstall_seed(seed: pxe).contains("console=unattended-answer")
            && render_altra_autoinstall_seed(seed: http).contains("console=unattended-answer")
            && !render_altra_autoinstall_seed(seed: pxe).contains("console=suppressed")
            && !render_altra_autoinstall_seed(seed: http).contains("console=suppressed")
      }
  }
}

fn console_stanza_is_suppressed(stanza: NonInteractiveConsoleStanza) -> Bool {
  match stanza {
    ConsoleSuppressed => true
    ConsoleAnsweredByUnattended => false
  }
}

fn console_stanza_is_answered(stanza: NonInteractiveConsoleStanza) -> Bool {
  match stanza {
    ConsoleSuppressed => false
    ConsoleAnsweredByUnattended => true
  }
}

// THE PROOF COUNTS ONLY QUESTIONS THAT WERE ACTUALLY ANSWERED. Without this witness the count is decorative:
// a reader of a seed digest sees "N questions closed" as the module's own evidence of independence, and a count
// that credited an unclassified package would inflate the rung the evidence establishes (DESIGN.md §4b
// meta-obligation 1). Two seeds that differ by exactly one ANSWERED question must differ in the count; if the
// count moved for an unclassified package too, the mutation the reviewer named would be invisible.
test fn the_closed_question_count_moves_only_with_answers() -> Bool {
  match admit_admin_access_authorisation(authorised_keys: one_key, console_entry: locked_console) {
    Present { value: entry } =>
      match audit_altra_autoinstall_seed( network: network_posture, install_packages: clean_packages, late_packages: [], locale: EnUsUtf8, entry: entry, strategy: virtual_media_strategy, ) {
        SeedIsNonInteractive { evidence: one_answer } =>
          match audit_altra_autoinstall_seed( network: network_posture, install_packages: two_answered_packages, late_packages: [], locale: EnUsUtf8, entry: entry, strategy: virtual_media_strategy, ) {
            SeedIsNonInteractive { evidence: two_answers } =>
              two_answers.questions_closed > one_answer.questions_closed
            _ => false
          }
        _ => false
      }
    Absent => false
  }
}

// THE REFUSAL NAMES THE PACKAGE IN THE ARCHIVE'S OWN SPELLING. Nothing else in this module or any other is
// allowed to spell a prompting package's name, so the refusal an operator reads has to be the one spelling the
// table holds — and it has to be the ARCHIVE spelling, because that string is what they will type into a debconf
// preseed. A witness that only matched `PackagePrompts { name: _ }` would let the table's names drift to anything
// and stay green, which is precisely the second source of truth review 81772 removed.
test fn the_refusal_names_the_package_in_its_archive_spelling() -> Bool {
  match admit_admin_access_authorisation(authorised_keys: one_key, console_entry: locked_console) {
    Present { value: entry } =>
      match audit_altra_autoinstall_seed( network: network_posture, install_packages: unseeded_tzdata_packages, late_packages: [], locale: EnUsUtf8, entry: entry, strategy: virtual_media_strategy, ) {
        SeedRefused { cause: PackagePrompts { name: named, question: asked } } =>
          named == "tzdata" as NonEmptyStr
            // BOTH keys, not one. The shipped package asks tzdata/Areas and then tzdata/Zones/<area>, and the
            // reason the old single-key spelling was a defect is that satisfying one leaves the other live: a seed
            // that names only the region still stops the installer, and a refusal text that named one question
            // could not tell the operator that. The invented "tzdata/configure_timezone" appears nowhere in the
            // shipped control scripts; this asserts the two keys that do.
            && asked.contains("tzdata/Areas")
            && asked.contains("tzdata/Zones/")
            && known_prompting_package_name(package: TzdataPackage) == named
        _ => false
      }
    Absent => false
  }
}

// THE COUNT IS PINNED TO A NUMBER, not merely shown to move. A monotonic witness ("more answers, higher
// count") survives a mutation that shifts the whole count by a constant, and the arithmetic has four terms
// (answered intents, seeded addressing, present mirror, earned entrypoint) of which three are +1 each — exactly
// the kind of term that silently disappears in a refactor. Pinning the exact total for a fixture whose every
// term is known is the only version of this claim that can go red.
test fn the_closed_question_count_is_the_exact_arithmetic() -> Bool {
  match admit_admin_access_authorisation(authorised_keys: one_key, console_entry: locked_console) {
    Present { value: entry } =>
      match audit_altra_autoinstall_seed( network: network_posture, install_packages: clean_packages, late_packages: [], locale: EnUsUtf8, entry: entry, strategy: virtual_media_strategy, ) {
        // TWO answered debconf questions + seeded addressing + present mirror + the entrypoint the caller had
        // to earn. Not a magic number: two packages each in the QuestionAnswered arm, then one each of the
        // three structural terms questions_closed_count adds.
        SeedIsNonInteractive { evidence: proof } => proof.questions_closed == 5
        _ => false
      }
    Absent => false
  }
}

// THE RENDERED AUTHORITY OF EACH DRIVER ROW IS IN THE SEED, not merely the spelling. A package and a module can
// share a plausible name; the axis prefix and the Kconfig symbol in the token are what keep them from sharing a
// digest. If either token part were dropped, two different configurations would hash alike and the binding
// could not later say which one the board booted.
test fn each_driver_token_carries_its_axis_and_authority() -> Bool {
  let pkg_token = install_driver_list_diagnostic(drivers: [NvmeCliDriver])
  let mod_token = loadable_module_list_diagnostic(modules: [NvmeBlockModule])
  // THREE GENUINELY DIFFERENT DRIVER LISTS, each pair compared: empty, one, two. The first version of this
  // line read `late_driver_list_diagnostic(drivers: []) != late_driver_list_diagnostic(drivers: [])`, which is
  // false by identity — a copy-paste that asserted nothing while looking like coverage of the empty case.
  let empty_late = late_driver_list_diagnostic(drivers: [])
  let one_late = late_driver_list_diagnostic(drivers: [KipmiSiDriver])
  let two_late = late_driver_list_diagnostic(drivers: [KipmiSiDriver, IpmiWatchdogDriver])
  pkg_token.contains("pkg:nvme-cli")
    && !pkg_token.contains("mod:")
    && mod_token.contains("mod:nvme")
    && mod_token.contains("BLK_DEV_NVME")
    && one_late.contains("mod:ipmi_si")
    && one_late.contains("IPMI_SI")
    // AN INPUT-DIFFERENTIATING COMPARISON, not two renderings of the same call.
    && empty_late != one_late
    && one_late != two_late
}

// WHAT THE SEED SAYS ABOUT ITS OWN PACKAGES AND MODULES. The digest witnesses prove the render MOVES; this one
// proves it SAYS something: each package is named with its package-axis warrant and each module with its
// module-axis warrant, so an operator reading a seed (or a boot log carrying its digest) can tell which kind of
// thing the board was told to have. A render that lost either prefix would keep producing digests and would be
// invisible to every equality witness here.
test fn the_seed_names_its_packages_and_modules_by_axis() -> Bool {
  match build_seed_fixture_with_modules(
    network: network_posture,
    packages: clean_packages,
    entry_keys: one_key,
    console: locked_console,
    credential: seeded_handle,
    delivery: virtual_media_strategy,
    target: target_altra,
    modules: [AhciPlatformModule, NvmeBlockModule],
  ) {
    Present { value: seed } =>
      let rendered = render_altra_autoinstall_seed(seed: seed)
      rendered.contains("pkg:nvme-cli")
        && rendered.contains("pkg:linux-firmware")
        && rendered.contains("mod:ahci_platform")
        && rendered.contains("mod:nvme")
        && rendered.contains("SATA_AHCI_PLATFORM")
        && rendered.contains("drivers/ata/Kconfig")
    Absent => false
  }
}

// THE CREDENTIAL LOCATOR IS OBSERVED, NOT DECORATIVE. The handle's locator is a string because no module in
// this repository owns secret-store addressing syntax (extdeps.cloud.gcp.secret_ref is GCP-specific and this
// fleet is on-premises, so importing it would state a requirement the board does not have; and extdeps.uri has
// no scheme for a vault, which I will not add to a file I do not own). That makes the string the honest type
// today — which is precisely why it needs a witness: an unobserved string is where a placeholder survives.
// Rotating a version is already covered (a_rotated_credential_moves_the_digest); this covers MOVING THE STORE.
test fn a_relocated_credential_moves_the_digest() -> Bool {
  match build_seed_fixture( network: network_posture, packages: clean_packages, entry_keys: one_key, console: locked_console, credential: seeded_handle, delivery: virtual_media_strategy, target: target_altra, ) {
    Present { value: in_store } =>
      match build_seed_fixture( network: network_posture, packages: clean_packages, entry_keys: one_key, console: locked_console, credential: relocated_handle, delivery: virtual_media_strategy, target: target_altra, ) {
        Present { value: relocated } =>
          !content_hash_eq_structural(
            left: altra_autoinstall_seed_digest(seed: in_store),
            right: altra_autoinstall_seed_digest(seed: relocated),
          )
            && render_altra_autoinstall_seed(seed: relocated).contains("gunbc-alternate-store")
        Absent => false
      }
    Absent => false
  }
}

// THE PASSWORD STANZA STATES THE POSTURE, IN BOTH DIRECTIONS. The posture is a two-member sum and the token is
// the ONLY thing a boot log carries about it, so both spellings are pinned: an implementation that rendered the
// same token for both postures ("always handle") is the failure this module was asked to make unrepresentable —
// "the operator forgot the credential" and "the operator decided on key-only entry" would be indistinguishable
// after the fact, when the remedies are opposite. Pinning the spelling rather than only digest-inequality is
// what makes the collapse go red even if some other token happens to differ.
test fn the_password_stanza_states_which_posture_was_chosen() -> Bool {
  match build_seed_fixture( network: network_posture, packages: clean_packages, entry_keys: one_key, console: locked_console, credential: PasswordUnset, delivery: virtual_media_strategy, target: target_altra, ) {
    Present { value: unset_seed } =>
      match build_seed_fixture( network: network_posture, packages: clean_packages, entry_keys: one_key, console: locked_console, credential: seeded_handle, delivery: virtual_media_strategy, target: target_altra, ) {
        Present { value: handle_seed } =>
          render_altra_autoinstall_seed(seed: unset_seed).contains("password=unset")
            && !render_altra_autoinstall_seed(seed: unset_seed).contains("password=handle")
            && !render_altra_autoinstall_seed(seed: handle_seed).contains("password=unset")
            // THE HANDLE IS SPOKEN OF, NOT HELD — and each part of it is FRAMED with its own label and character
            // count rather than glued with separators a value could contain. "password=locator=" was the old
            // unframed spelling; this is the framed one, and the row is the reason the framing is visible.
            && render_altra_autoinstall_seed(seed: handle_seed).contains("password=locator[")
            && !render_altra_autoinstall_seed(seed: handle_seed).contains(crypt_digest_as_text)
        Absent => false
      }
    Absent => false
  }
}

// THE MODULE AXIS REACHES THE DIGEST, ON ITS OWN. Two seeds that differ only in which kernel modules they
// demand are different configurations — one may not be able to see its disk at all — so the digest must move
// when the module list moves while every package list stays identical. Without this the module axis would be
// decoration: authorable, rendered nowhere, digested by nothing.
test fn the_loadable_module_axis_moves_the_digest() -> Bool {
  match build_seed_fixture_with_modules(
    network: network_posture,
    packages: clean_packages,
    entry_keys: one_key,
    console: locked_console,
    credential: seeded_handle,
    delivery: virtual_media_strategy,
    target: target_altra,
    modules: [AhciPlatformModule, NvmeBlockModule],
  ) {
    Present { value: with_modules } =>
      match build_seed_fixture_with_modules(
        network: network_posture,
        packages: clean_packages,
        entry_keys: one_key,
        console: locked_console,
        credential: seeded_handle,
        delivery: virtual_media_strategy,
        target: target_altra,
        modules: [],
      ) {
        Present { value: without_modules } =>
          !content_hash_eq_structural(
            left: altra_autoinstall_seed_digest(seed: with_modules),
            right: altra_autoinstall_seed_digest(seed: without_modules),
          )
        Absent => false
      }
    Absent => false
  }
}

// THE TWO REACHABLE ENTRYPOINT POSTURES, RENDERED. Kept as a function of the two seeds so the lets sit at the
// top of a body (the form this dialect allows) and the assertions read as one claim: the tokens differ, each
// says what it means, and the digests follow.
fn entrypoint_tokens_are_distinguishable(
  console_seed: AltraAutoinstallSeed,
  keys_seed: AltraAutoinstallSeed,
) -> Bool {
  let console_render = render_altra_autoinstall_seed(seed: console_seed)
  let keys_render = render_altra_autoinstall_seed(seed: keys_seed)
  // The console token is pinned, and the key COUNT is pinned SEPARATELY from the key coverage. The count is no
  // longer the whole claim (see authorised_key_coverage): the coverage hash beside it is what makes a swap of key
  // material move the digest. Pinning "keys=1" alone was the weak assertion that let a count-only render pass,
  // so the two halves are checked as two things, and the digest inequality is the load-bearing one.
  console_render.contains("console=unlocked-bmc-sol,keys=")
    && console_render.contains(",count=0")
    && keys_render.contains("console=locked,keys=")
    && keys_render.contains(",count=1")
    && !content_hash_eq_structural(
      left: altra_autoinstall_seed_digest(seed: console_seed),
      right: altra_autoinstall_seed_digest(seed: keys_seed),
    )
}

// WHICH CONSOLE IS OPEN IS NOT DECORATIVE. A serial getty at the panel and a BMC SOL console over the network
// are different exposures with different remedies, and on a headless board only one is reachable — so a seed
// that renders both identically hides the thing an operator would act on. Both must render, differently, and
// both must move the digest.
test fn the_two_unlock_kinds_are_distinguishable_in_the_render() -> Bool {
  match build_seed_fixture( network: network_posture, packages: clean_packages, entry_keys: no_keys, console: unlocked_console, credential: seeded_handle, delivery: virtual_media_strategy, target: target_altra, ) {
    Present { value: sol } =>
      match build_seed_fixture( network: network_posture, packages: clean_packages, entry_keys: no_keys, console: unlocked_serial_console, credential: seeded_handle, delivery: virtual_media_strategy, target: target_altra, ) {
        Present { value: getty } =>
          render_altra_autoinstall_seed(seed: sol).contains("console=unlocked-bmc-sol")
            && render_altra_autoinstall_seed(seed: getty).contains("console=unlocked-serial-getty")
            && !render_altra_autoinstall_seed(seed: sol).contains("console=unlocked-serial-getty")
            && !content_hash_eq_structural(
              left: altra_autoinstall_seed_digest(seed: sol),
              right: altra_autoinstall_seed_digest(seed: getty),
            )
        Absent => false
      }
    Absent => false
  }
}

fn list_length_is(candidates: List<NonEmptyStr>, expected: Int) -> Bool {
  list_length(items: candidates) == expected
}

// ---------------------------------------------------------------------------
// HOLD ROUND (merry-fox-82): disk join, projection keeps the disk, receipt joins
// the credential, shared reserved-character scan, content in the digest.
// ---------------------------------------------------------------------------

// THE REFUSAL THAT COULD NEVER FIRE, NOW FIRES. Before the split, the selector's own predicate dropped
// ephemeral devices, so a volatile disk could never be the one match and CandidateIsNotPersistent was dead
// code behind a safety-net name. A population whose ONLY match is volatile is the single fixture that can
// tell the two designs apart: under the old filter it answers "your rule matched nothing", which sends the
// operator to the selector when the problem is the drive. The near-miss refusal here is NoDiskMatches, and
// accepting that would be wrong twice — it is the wrong cause, and it is the wrong page of the runbook.
test fn a_matched_but_volatile_disk_is_refused_as_not_persistent() -> Bool {
  match select_target_disk(selector: serial_selector, observed: [ephemeral_disk]) {
    SelectionRefused { cause: CandidateIsNotPersistent { serial: named, persistence: kind } } =>
      named == ("UNIQUE-SERIAL-0007" as NonEmptyStr) && kind == Ephemeral
    _ => false
  }
}

// THE SAME ARM FOR THE CACHE MIRROR, WHICH IS A DIFFERENT DEVICE CLASS AND MUST NOT SLIP THROUGH THE
// Ephemeral BRANCH. A CachedMirror survives a reset only as long as its cache partner does; erasing one to
// hold a root filesystem is a data-loss event dressed as a provisioning step.
test fn a_matched_cache_mirror_is_refused_as_not_persistent() -> Bool {
  match select_target_disk(selector: serial_selector, observed: [cached_mirror_disk]) {
    SelectionRefused { cause: CandidateIsNotPersistent { persistence: CachedMirror } } => true
    _ => false
  }
}

// A REFUSAL IS NOT A PASS THROUGH. The exact fixture above must never select. Written as the negation as
// well so that a future change which makes the arm refuse AND select (two arms of the sum both reachable)
// cannot quietly satisfy the witness above.
test fn a_volatile_disk_is_never_selected_even_though_it_matches() -> Bool {
  match select_target_disk(selector: serial_selector, observed: [ephemeral_disk]) {
    DiskSelected { provenance: _ } => false
    SelectionRefused { cause: _ } => true
  }
}

// THE SEAL IS A WALL, NOT A SIGN, AND THE CENSUS PROVES IT. disk_selection_provenance is the only fn that turns a
// selector plus a probe reading into "install here", so it is the place a caller could author BOTH the selector and
// the chosen device and hand the binding a provenance whose chosen disk never passed selector_matches_rule or the
// persistence gate (merry's item 2). admit_callers restricts the mint to select_target_disk; sole_constructor on
// the record already refused a hand-written literal, but a public mint fn was still an open door. These three rows
// are the evidence that the door is shut for a foreign module: the census compiles an inline foreign source that
// calls the sealed fn and asks whether the host reported a ConstructorCallAdmissionRefused. The CONTROL proves the
// harness is not simply always-refuse: the same census over a lawful select_target_disk source reports zero. A
// census that could not run reads as 0 - 1 and the row goes RED, so an unresolvable probe source cannot masquerade
// as a refusal. (Idiom and class name copied from test.claim.fabric.flex_seal_witness; live_tree_disposition is
// already ReadsLiveTree for this reason.)
data forged_disk_provenance_source: String = "module probe_altra_disk_provenance\nimport std.types { List }\nimport extdeps.storage.types { StorageDevice }\nimport gunbc.provisioning.altra_autoinstall_seed { disk_selection_provenance, DiskSelectionProvenance, TargetDiskSelector }\nfn forged(selector: TargetDiskSelector, admitted: StorageDevice, observed: List<StorageDevice>) -> DiskSelectionProvenance {\n  disk_selection_provenance(selector: selector, admitted: admitted, observed: observed)\n}\n"

// THE INDIRECT WRAPPER: a foreign module that buries the sealed mint one hop down and hands the caller a fully
// built DiskSelected. The admission check runs at the call site wherever it is nested, so wrapping does not launder
// it — the census still reports the refusal. Without this row, a reader could believe the seal only covered the
// direct call and that a helper module could re-export a ready-made DiskSelected.
data forged_disk_selection_wrapper_source: String = "module probe_altra_disk_selection_wrapper\nimport std.types { List }\nimport extdeps.storage.types { StorageDevice }\nimport gunbc.provisioning.altra_autoinstall_seed { disk_selection_provenance, DiskSelected, TargetDiskSelection, TargetDiskSelector }\nfn forged(selector: TargetDiskSelector, admitted: StorageDevice, observed: List<StorageDevice>) -> TargetDiskSelection {\n  DiskSelected { provenance: disk_selection_provenance(selector: selector, admitted: admitted, observed: observed) }\n}\n"

// THE CONTROL, NOT A TRUISM: the very same census machinery over a source that reaches for the disk only through
// select_target_disk. If the harness flagged every source, the two refusal rows above would prove nothing; this row
// pins that a lawful selection produces zero admission refusals.
data lawful_disk_selection_source: String = "module probe_altra_disk_selection_lawful\nimport std.types { List }\nimport extdeps.storage.types { StorageDevice }\nimport gunbc.provisioning.altra_autoinstall_seed { select_target_disk, TargetDiskSelection, TargetDiskSelector }\nfn lawful(selector: TargetDiskSelector, observed: List<StorageDevice>) -> TargetDiskSelection {\n  select_target_disk(selector: selector, observed: observed)\n}\n"

// THE SECOND SEAL, PROBED THE SAME WAY: serve_seed_bundle is the only fn that renders the served bundle (user-data
// plus the debconf answer file plus their combined digest) and is admit_callers-restricted to
// bind_altra_autoinstall_seed, so the digest that goes into the binding address cannot be authored by hand. A
// foreign caller that tried to build its own served bundle — the carrier merry's item 1 and item 5 depend on — is
// refused, which is what makes "the machine booted seed X" answerable from evidence rather than a caller's memory.
data forged_served_bundle_source: String = "module probe_altra_served_bundle\nimport std.optional { Optional }\nimport gunbc.provisioning.altra_autoinstall_seed { serve_seed_bundle, AltraAutoinstallSeed, ServedSeedBundle }\nfn forged(seed: AltraAutoinstallSeed) -> Optional<ServedSeedBundle> {\n  serve_seed_bundle(seed: seed)\n}\n"

fn blocking_of_class(source: String, class: String) -> Int {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: rows } => census_total_count(rows: census_rows_of_class(rows: census_blocking_rows(rows: rows), wanted: class))
    CensusNotRunnable { cause: _ } => 0 - 1
  }
}

test fn a_foreign_direct_mint_of_disk_provenance_is_refused() -> Bool {
  blocking_of_class(source: forged_disk_provenance_source, class: "ConstructorCallAdmissionRefused") >= 1
}

test fn a_foreign_indirect_wrapper_around_the_disk_provenance_mint_is_refused() -> Bool {
  blocking_of_class(source: forged_disk_selection_wrapper_source, class: "ConstructorCallAdmissionRefused") >= 1
}

test fn a_foreign_mint_of_the_served_bundle_is_refused() -> Bool {
  blocking_of_class(source: forged_served_bundle_source, class: "ConstructorCallAdmissionRefused") >= 1
}

// THE CONTROL, AND IT IS THE LOAD-BEARING ONE. Same harness, same class, a source that only calls the public
// selector: zero refusals. If someone made the census flag every source, the three rows above would still "pass" and
// this one would go RED — which is the whole reason the control is a test and not a comment.
test fn a_lawful_select_target_disk_source_raises_no_admission_refusal() -> Bool {
  blocking_of_class(source: lawful_disk_selection_source, class: "ConstructorCallAdmissionRefused") == 0
}

// THE RULE STILL PICKED OUT TWO DISKS AND THE RECORD SAYS SO. Admissibility and matching are separate
// counts, and the provenance carries both. Here the rule matches the installable drive AND the volatile one
// (same serial, different persistence), so the selection is legal but its provenance must report matched=2 of
// 3 — a rule that only works because seven of eight devices were ineligible is a rule nobody has tested, and
// the counts are the only place that fact can be seen afterwards.
test fn provenance_records_the_rule_s_discriminating_power() -> Bool {
  match select_target_disk(
    selector: serial_selector,
    observed: [unique_disk, ephemeral_disk, twin_disk_one],
  ) {
    DiskSelected { provenance: provenance } =>
      // THE IDENTITY COMES OUT OF THE SEALED PROVENANCE, not out of a second argument the reader could have
      // substituted. What the rule chose is a fact ABOUT this selection, so it travels inside it.
      match provenance_chosen_identity(provenance: provenance) {
        // THE SERIAL IS READ OUT OF THE RECORD, not out of a device handed to the check. The rule's whole
        // answer — which disk, out of how many admitted, out of how many observed — arrives together, so a
        // reader cannot pair this provenance with a different drive.
        BoundDisk { serial: serial, matched: matched, observed: observed } =>
          serial == ("UNIQUE-SERIAL-0007" as NonEmptyStr)
            && matched == 2
            && observed == 3
            && matched == provenance.matched
            && observed == provenance.observed
            && provenance.selector == serial_selector
        BoundDiskUnread { part_number: _ } => false
      }
    SelectionRefused { cause: _ } => false
  }
}

// A DISK PICKED BY ANOTHER RULE IS NOT THIS SEED'S DISK. The defect: a valid disk selected under a different
// selector could be bound, and the receipt recorded a rule that was never run. The selection below is
// genuine — minted by select_target_disk, not forged — which is the whole point: a bare-record forgery
// proves the seal, not the join, and the seal is already tested by the census. This is the join.
test fn a_disk_selected_under_a_different_rule_cannot_be_bound() -> Bool {
  match build_seed_fixture(
    network: network_posture,
    packages: clean_packages,
    entry_keys: one_key,
    console: locked_console,
    credential: seeded_handle,
    delivery: virtual_media_strategy,
    target: target_altra,
  ) {
    Absent => false
    Present { value: seed } =>
      // twin_disk_one + twin_disk_two both match twin_selector, so the honest selection under that rule is a
      // refusal; the legal one under it needs a single twin. Selecting the twin population and binding it to
      // a seed whose disk field is serial_selector is the mismatch under test.
      match bind_altra_autoinstall_seed(
        seed: seed,
        target: target_altra,
        unit_key: unit_a_key,
        attempt: attempt_one,
        selection: select_target_disk(selector: twin_selector, observed: [twin_disk_one]),
      ) {
        Bound { binding: _ } => false
        // WHICH SIDE THE REFUSAL BLAMES IS PART OF THE CLAIM. `run` is the rule that was executed against the
        // probe; `seed` is the rule the seed commanded. An earlier revision put the EXECUTED rule under `seed:`,
        // and a witness that pinned only `rule == twin_selector` stayed green through that — while every operator
        // reading a real refusal was told their seed asked for the wrong disk when it was their selection that had
        // moved. Both halves are pinned now, so the naming is a tested property rather than a cosmetic one.
        BindRefused { blocker: DiskSelectorDisagreesWithSeed { seed: commanded, run: executed } } =>
          executed.selector == twin_selector && commanded == serial_selector
        BindRefused { blocker: _ } => false
      }
  }
}

// THE CONTROL FOR THE TEST ABOVE, AND THE REASON IT IS NOT A FALSE REFUSAL. The same seed, bound with a
// selection produced under the seed's OWN rule, must Bind and must record the disk. Without this the
// mismatch witness would be satisfied by a bind that always refuses.
test fn the_same_selection_under_the_seed_s_own_rule_binds() -> Bool {
  match built_seed_and_binding() {
    Present { value: pair } =>
      match pair.binding.disk_selection {
        BoundDisk { serial: named, matched: m, observed: o } =>
          named == ("UNIQUE-SERIAL-0007" as NonEmptyStr) && m == 1 && o == 3
        _ => false
      }
    Absent => false
  }
}

// THE BINDING'S ADDRESS MOVES WHEN THE DISK MOVES. Two bindings of the SAME seed to the SAME unit and
// attempt, differing only in the drive, used to share one binding digest — so a stored receipt could be
// overwritten by a second attempt onto another bay and nobody could tell. This is the "the machine booted
// seed X, onto drive Y" guarantee, and it is worth nothing if Y is not in the address.
test fn two_different_disks_under_one_seed_are_two_binding_addresses() -> Bool {
  // ONE RULE, TWO DRIVES. catalog_selector names part number and capacity; unique_disk and sibling_disk carry
  // that same catalog row and differ only in serial, so the SAME rule run against a population holding one of
  // them legally selects that one. Holding the rule fixed is what makes this the disk test and not the join test:
  // an earlier revision varied the SELECTOR between the two bindings, which after the seed/target join is a
  // refusal — so the witness was comparing a bound binding against a refused one and reporting "two addresses"
  // for a case in which the second binding never happened at all.
  match build_seed_fixture_under_rule(
    rule: catalog_selector,
    network: network_posture,
    packages: clean_packages,
    entry_keys: one_key,
    console: locked_console,
    credential: seeded_handle,
    delivery: virtual_media_strategy,
    target: target_altra,
  ) {
    Absent => false
    Present { value: seed } =>
      match bind_altra_autoinstall_seed(
        seed: seed,
        target: target_altra,
        unit_key: unit_a_key,
        attempt: attempt_one,
        selection: select_target_disk(selector: catalog_selector, observed: [unique_disk]),
      ) {
        BindRefused { blocker: _ } => false
        Bound { binding: first } =>
          match bind_altra_autoinstall_seed(
            seed: seed,
            target: target_altra,
            unit_key: unit_a_key,
            attempt: attempt_one,
            selection: select_target_disk(selector: catalog_selector, observed: [sibling_disk]),
          ) {
            // The second selection must itself be legal, or the comparison below would be vacuous.
            BindRefused { blocker: _ } => false
            Bound { binding: second } =>
              !content_hash_eq_structural(
                left: binding_digest(binding: first),
                right: binding_digest(binding: second),
              )
              && content_hash_eq_structural(
                left: first.seed_digest,
                right: second.seed_digest,
              )
              // AND THE DIGEST MOVED BECAUSE THE DRIVE MOVED, not for some unrelated reason: a digest that
              // drifted for an incidental reason would satisfy the inequality above without ever having named a
              // disk. Each side records the serial it selected.
              && match first.disk_selection {
                BoundDisk { serial: a, matched: _, observed: _ } =>
                  a == ("UNIQUE-SERIAL-0007" as NonEmptyStr)
                BoundDiskUnread { part_number: _ } => false
              }
              && match second.disk_selection {
                BoundDisk { serial: b, matched: _, observed: _ } =>
                  b == ("SIBLING-SERIAL-0009" as NonEmptyStr)
                BoundDiskUnread { part_number: _ } => false
              }
          }
      }
  }
}

// THE PROJECTION KEEPS THE DISK IT WAS GIVEN. The upstream policy has no device field and this module may
// not edit it, so a projection that returned only the policy would report success and drop the one fact the
// decision turned on. The projection now carries the evidence and the provenance beside the policy; a
// downstream consumer that ignores both is visible as doing so.
test fn the_storage_projection_carries_the_selected_device() -> Bool {
  match project_storage_policy(selection: select_target_disk(selector: serial_selector, observed: bay_population)) {
    Projected { policy: policy, device: evidence, provenance: provenance } =>
      match evidence {
        BoundDisk { serial: named, matched: m, observed: o } =>
          match policy {
            StoragePolicyDirectLayout =>
              named == ("UNIQUE-SERIAL-0007" as NonEmptyStr)
                && m == 1
                && o == 3
                && provenance.selector == serial_selector
            // spelled, not omitted: the projected policy is the closed union from the autoinstall shelf, so the
            // witness must say what it would mean for the projection to hand back no layout at all -- a device
            // with no layout to install onto is not a carried device, so this arm is false by definition.
            StoragePolicyAbsent => false
          }
        // Spelled for the same reason: an unreadable selected disk is exactly the case this witness is about,
        // so it must be named and rejected rather than swept.
        BoundDiskUnread { part_number: _ } => false
      }
    ProjectionUnresolved { cause: _ } => false
  }
}

// AND THE REFUSAL SIDE OF THE PROJECTION NAMES ITS CAUSE. Dropped causes are how a caller ends up retrying
// forever: the zero-match refusal and the unread-identity refusal need different fixes, and a caller handed
// a bare absence cannot tell them apart.
test fn the_storage_projection_reports_the_refusal_cause() -> Bool {
  match project_storage_policy(selection: select_target_disk(selector: absent_selector, observed: bay_population)) {
    ProjectionUnresolved { cause: NoDiskMatches { selector: _ } } => true
    _ => false
  }
}

// THE RECEIPT CARRIES THE CREDENTIAL IT WAS READ FROM, FILLED FROM THE HANDLE AND NOT FROM A PARAMETER.
// The defect: a digest alone could be paired with any handle, so a board could be handed a hash read from a
// different secret than the one its seed names. The minter has no locator argument, so the fields below can
// only ever be what the handle said.
test fn the_receipt_records_which_secret_it_came_from() -> Bool {
  match admin_password_hash_receipt(
    credential: seeded_handle,
    crypt_digest: "$6$saltsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj." as NonEmptyStr,
  ) {
    ReceiptRefused { cause: _ } => false
    ReceiptAccepted { receipt: issued } =>
      issued.secret_locator == ("vault://gunbc/provisioning/altra/admin" as NonEmptyStr)
        && issued.secret_version == ("v7" as NonEmptyStr)
  }
}

// A RECEIPT FOR A DECLINED CREDENTIAL IS REFUSED, AND NOT AS A FORMAT FAILURE. The seed said no password;
// there is no secret to have read. Naming the cause distinguishes it from NotACryptDigest, whose remedy is
// different — one is a wiring bug, the other a broken string.
test fn a_receipt_for_a_declined_credential_is_refused_by_name() -> Bool {
  match admin_password_hash_receipt(
    credential: PasswordUnset,
    crypt_digest: "$6$saltsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj." as NonEmptyStr,
  ) {
    ReceiptRefused { cause: CredentialHandleUnset } => true
    ReceiptRefused { cause: _ } => false
    ReceiptAccepted { receipt: _ } => false
  }
}

// THE JOIN REJECTS A FOREIGN RECEIPT, AND SAYS WHICH SECRET WAS EXPECTED. The version fixture is a legal
// digest read from v8 while the seed's handle is v7; before the join that projected successfully. The names
// in the verdict are references, never the secret, so they can be logged.
test fn a_receipt_from_another_secret_version_is_refused_by_name() -> Bool {
  match build_seed_fixture(
    network: network_posture,
    packages: clean_packages,
    entry_keys: one_key,
    console: locked_console,
    credential: seeded_handle,
    delivery: virtual_media_strategy,
    target: target_altra,
  ) {
    Absent => false
    Present { value: seed } =>
      match admin_password_hash_receipt(
        credential: rotated_handle,
        crypt_digest: "$6$saltsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj." as NonEmptyStr,
      ) {
        ReceiptRefused { cause: _ } => false
        ReceiptAccepted { receipt: from_v8 } =>
          match project_autoinstall_identity(
            seed: seed,
            binding_hostname: "unit-a-altra" as NonEmptyStr,
            receipt: Present { value: from_v8 },
          ) {
            IdentityReceiptIsForeign { expected: wanted, presented: offered } =>
              wanted == ("vault://gunbc/provisioning/altra/admin@v7" as NonEmptyStr)
                && offered == ("vault://gunbc/provisioning/altra/admin@v8" as NonEmptyStr)
            _ => false
          }
      }
  }
}

// A SEED WITH NO PASSWORD LOCKS THE ACCOUNT; IT DOES NOT SET A DEFAULT (mutation M23-LockMarker-Placeholder:
// the PasswordUnset arm made the field "changeme"). This is the login gate on a board nobody is standing at, so
// the two ways to fail it are "nobody can log in" (acceptable, and the honest answer when a credential was never
// provisioned) and "the first password anyone guesses works" (unacceptable). The assertion is on the EXACT field
// the renderer will write, not on a substring: '!' is in libxcrypt's reserved set, which is what makes the marker
// un-collidable with any admitted digest — no password hash can equal it or even begin with it. A row that only
// checked the document "does not contain changeme" would pass over a default of "password", "password123", or the
// empty string, so the marker is compared to, not searched for.
test fn a_seed_with_no_password_locks_the_account_instead_of_setting_a_default() -> Bool {
  match build_seed_fixture(
    network: network_posture,
    packages: clean_packages,
    entry_keys: one_key,
    console: locked_console,
    credential: PasswordUnset,
    delivery: virtual_media_strategy,
    target: target_altra,
  ) {
    Absent => false
    Present { value: seed } =>
      match password_field_from(seed: seed) {
        Absent => false
        Present { value: field } =>
          match (field as String) == (password_lock_marker as String) {
            False => false
            // AND THE DOCUMENT STILL BUILDS. Refusing the document here would be the other wrong answer: the
            // board is legitimately key-only, and a seed that cannot render cannot be installed at all.
            True =>
              match seed_document(seed: seed) {
                DocumentBuilt { payload: _, content: _ } => true
                DocumentRefused { reason: _ } => false
              }
          }
      }
  }
}

// THE LOCK MARKER, STATED BY THE WITNESS AND NOT IMPORTED FROM THE MODULE: if the two agreed by sharing one
// constant, the row would compare the renderer with itself.
data password_lock_marker: NonEmptyStr = "!*"

// THE SAME HANDLE JOINS, WHICH IS THE CONTROL THAT MAKES THE REFUSAL ABOVE A TEST AND NOT A WALL.
test fn a_receipt_from_the_named_secret_joins() -> Bool {
  match built_seed_and_binding() {
    Absent => false
    Present { value: pair } =>
      match admin_password_hash_receipt(
        credential: seeded_handle,
        crypt_digest: "$6$saltsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj." as NonEmptyStr,
      ) {
        ReceiptRefused { cause: _ } => false
        ReceiptAccepted { receipt: issued } =>
          match project_autoinstall_identity(
            seed: pair.seed,
            binding_hostname: "unit-a-altra" as NonEmptyStr,
            receipt: Present { value: issued },
          ) {
            ProjectedIdentity { identity: who } => who.hostname == ("unit-a-altra" as NonEmptyStr)
            _ => false
          }
      }
  }
}

// A SEED WITH NO CREDENTIAL SAYS SO, RATHER THAN FAILING. A key-only board is legitimate; reporting its
// missing hash as an error would make the common case indistinguishable from the broken one.
test fn a_key_only_seed_reports_no_credential_rather_than_an_error() -> Bool {
  match build_seed_fixture(
    network: network_posture,
    packages: clean_packages,
    entry_keys: one_key,
    console: unlocked_console,
    credential: PasswordUnset,
    delivery: virtual_media_strategy,
    target: target_altra,
  ) {
    Absent => false
    Present { value: seed } =>
      match project_autoinstall_identity(
        seed: seed,
        binding_hostname: "unit-a-altra" as NonEmptyStr,
        receipt: Absent,
      ) {
        IdentityHasNoCredential { posture: posture } => posture == ("credential-unset" as NonEmptyStr)
        _ => false
      }
  }
}

// THE SHARED SCAN REFUSES WHAT THE SCHEME ROW CANNOT SEE, IN EVERY FIELD. A '!' in the DIGEST is the case the
// scheme alphabet would wave through if the alphabet were generous, and a ':' in the SALT is refused by the
// shared scan alone. Pinning both fields, and pinning them to the shared arm rather than the alphabet arm, is
// the difference between an operator re-deriving a hash and an operator fixing a shell quoting bug.
test fn the_shared_scan_refuses_reserved_characters_wherever_they_sit() -> Bool {
  match cause_of(crypt_digest: "$6$saltsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfn!") {
    Present { value: SettingHoldsReservedCharacter { reserved: named } } => named == ("!" as NonEmptyStr)
    _ => false
  }
    && match cause_of(crypt_digest: "$6$sa:lsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj.") {
      Present { value: SettingHoldsReservedCharacter { reserved: named } } => named == (":" as NonEmptyStr)
      _ => false
    }
}

// AND A PERMITTED PUNCTUATION MARK IS STILL ACCEPTED. Without this control the shared scan above could be
// "tightened" into a refusal of all punctuation, which strands an operator whose only console is the BMC: a
// generator that legitimately uses '.' or '~' in a salt would be refused by us and accepted by the board.
// THE RESERVED LIST ITSELF IS THE TEST INPUT, NOT A HAND-PICKED CHARACTER. Earlier rounds tested upstream's
// shared restriction with two characters written into fixtures, so the suite's coverage was a list of things
// someone remembered, and deleting a member from crypt_shared_restriction.reserved_characters would have deleted
// the only test for it. This does the differential instead, which is the only claim that survives the shelf
// being changed: for every character the shelf CLAIMS is reserved, the observed scan must actually refuse it, and
// it checks at two positions because upstream scans the whole setting (salt and digest alike) before dispatching
// to the scheme — a rule that fired only on salts would be wrong and invisible.
//
// WHY '$' IS SPOILED OUT OF THE SWEEP, AND WHY THAT IS NOT A HOLE. '$' is the segment delimiter: a candidate
// holding one is no longer the setting being adjudicated but a different setting with an extra segment, so
// splicing it would test the segment count and report that it had tested the alphabet. Its refusal is asserted
// where it can honestly be stated — the consuming module's segment-count arm, which counts the delimiters it is
// given — so nothing is unclaimed here. CR and LF are not members of the shelf's list today and are written
// nowhere in this file, because a candidate cannot carry either and stay a single-line setting; had I spliced an
// escape for them, the escape itself is what the parser would have complained about, not the rule.
//
// THE DENOMINATOR IS DERIVED FROM THE SAME STORED LIST THE SWEEP ITERATES, AND AN EMPTY LIST IS A FAILURE.
// `testable` counts the shelf's own members (minus the delimiter case explained above) and both splice tallies
// must equal it, so the denominator is not a number someone typed: widen the stored list and the expectation
// widens with it, and empty the list and `testable > 0` fails the row outright. That guard is load-bearing in a
// way the tallies are not -- a fold over an empty list reports 0 == 0 == 0 and every comparison above passes, so
// deleting the entire alphabet rule from the shelf would keep this row green while the module began accepting
// settings the board's crypt(3) refuses. That is the exact catastrophe this shelf exists to prevent, which is why
// a vacuous sweep is reported as a failure rather than a pass. Mutation M46 is this row's only test, and only the
// `testable > 0` guard catches it.
// EVERY RESERVED CHARACTER THE SHELF CLAIMS MUST BE REFUSED IN BOTH POSITIONS, AT A FIXED CANDIDATE WIDTH
// (review: merry-fox-82). Both the salt and the digest are adjudicated, and each is adjudicated by REPLACING one
// character rather than inserting one. Insertion is the trap this row used to walk into: building a digest with a
// reserved character spliced in makes an 87-character digest, which the door refuses for the wrong reason — the
// digest-length arm fires first and the alphabet rule could be deleted from the module while this row stayed
// green. Replacing keeps the candidate exactly as long as the accepted setting, so the ONLY thing left to refuse
// it is the character rule, and the required cause is named (SettingHoldsReservedCharacter), so a refusal from
// any other arm is a failure here.
test fn every_reserved_character_the_shelf_claims_is_actually_refused_in_both_positions() -> Bool {
  let reserved = crypt_reserved_characters()
  let salt = "saltsalt"
  let digest = "8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj."
  // THE CONTROLS THAT MAKE THE SWEEP MEAN SOMETHING (mutation: the helper's arm test loosened from
  // SettingHoldsReservedCharacter to "any refusal"). Both candidates below ARE refused, but by a DIFFERENT arm —
  // the admitted string is admitted, and the truncated digest is refused for its width — so a helper that accepts
  // any refusal turns both from false to true and this row goes red. Without them, a sweep that reported refusals
  // it never earned would still balance two sums.
  let admitted_is_admitted = match refuses_fixed_width(setting: setting_with(salt: salt, digest: digest)) {
    True => false
    False => true
  }
  let width_arm_is_separate = match refuses_fixed_width(
    setting: setting_with(salt: salt, digest: digest.substring(start: 1, end: digest.length())),
  ) {
    True => false
    False => true
  }
  // '$' is the segment delimiter: a candidate holding one is no longer the setting being adjudicated but a
  // setting with an extra segment, so splicing it would test the segment count and report it had tested the
  // alphabet. Its refusal is stated honestly where it belongs — the consuming module's segment-count arm.
  let testable = fold(
    reserved,
    init: 0,
    f: (counted, character) =>
      match (character as String) == "$" {
        True => counted
        False => counted + 1
      },
  )
  let refused_in_digest = fold(
    reserved,
    init: 0,
    f: (counted, character) =>
      match (character as String) == "$" {
        True => counted
        False =>
          match refuses_fixed_width(
            setting: setting_with(salt: salt, digest: replaced_at(text: digest, position: 40, with: character as String)),
          ) {
            True => counted + 1
            False => counted
          }
      },
  )
  let refused_in_salt = fold(
    reserved,
    init: 0,
    f: (counted, character) =>
      match (character as String) == "$" {
        True => counted
        False =>
          match refuses_fixed_width(
            setting: setting_with(salt: replaced_at(text: salt, position: 3, with: character as String), digest: digest),
          ) {
            True => counted + 1
            False => counted
          }
      },
  )
  // THE SPOICE MUST REPLACE, NOT INSERT (mutation: the splice kept the character it was replacing). An insertion
  // makes the candidate longer; the width arm then refuses it, the reserved arm never runs, and the sweep would
  // report a refusal for every character it never actually adjudicated. Every candidate therefore has to be
  // exactly as long as the admitted setting it was cut from, which is what kept_width counts.
  let kept_width = fold(
    reserved,
    init: 0,
    f: (counted, character) =>
      match (character as String) == "$" {
        True => counted
        False =>
          match setting_with(salt: salt, digest: replaced_at(text: digest, position: 40, with: character as String)).length()
            == setting_with(salt: salt, digest: digest).length() {
            True => counted + 1
            False => counted
          }
      },
  )
  admitted_is_admitted && width_arm_is_separate && kept_width == testable &&
  // THE DENOMINATOR IS ASSERTED, NOT ASSUMED, AND AN EMPTY LIST IS A FAILURE. A fold over an empty list reports
  // 0 == 0 == 0 and every comparison above passes, so emptying crypt_shared_restriction.reserved_characters --
  // deleting the entire alphabet rule from the shelf -- would keep this row green while the module began accepting
  // settings the board's crypt(3) refuses. That is the exact catastrophe this shelf exists to prevent, which is
  // why a vacuous sweep is reported as a failure rather than a pass.
  testable > 0 && refused_in_digest == testable && refused_in_salt == testable
}

// ONE CHARACTER REPLACED, WIDTH PRESERVED. Position is a plain Int because it is an index into a fixture this
// file wrote, not a measurement of anything; the thing that needed a unit was the WIDTH, and the width is not
// written down anywhere here — it is whatever the accepted digest is, so it cannot drift from it.
fn replaced_at(text: String, position: Int, with: String) -> String {
  concat(
    concat(text.substring(start: 0, end: position), with),
    text.substring(start: position + 1, end: text.length()),
  )
}

fn setting_with(salt: String, digest: String) -> String {
  concat(concat(concat("$6$", salt), "$"), digest)
}

// THE REFUSAL MUST COME FROM THE CHARACTER ARM, NOT MERELY BE A REFUSAL. Any refusal would let the width, the
// alphabet or the segment count take the blame and leave the scan deletable.
fn refuses_fixed_width(setting: String) -> Bool {
  match cause_of(crypt_digest: setting) {
    Present { value: SettingHoldsReservedCharacter { reserved: _ } } => true
    _ => false
  }
}

// THE ADMITTED HALF IS CHECKED AT ITS ENDPOINTS. Asserting only refusals would let the printable range quietly
// narrow and still pass every other row in this file, and narrowing is the direction of error that strands an
// operator: a hash containing a byte WE reject and upstream accepts means a password someone set elsewhere stops
// working on the board, with the BMC as the only console. So both bounds of the range are pinned from inside and
// from outside, which is what a mutation to either bound has to survive. THE RANGE BELONGS TO UPSTREAM'S SCAN
// OVER THE WHOLE SETTING, not to the salt token grammar, and an earlier revision of this comment claimed the
// opposite — that a '~' in a salt could not be an accepted fixture because the grammar's class excluded it. That
// sentence was false and it contradicted the row below it and the ledger row that carries the same setting: the
// scan's printable range admits '~', and it is the reserved set, not the range, that does not. The claim is now
// made where it is tested.
// THE COST IS READ AT ITS POSITION, NOT FOUND ANYWHERE IN THE SETTING (mutation H15: starts_with relaxed to
// "some field contains the marker"). A candidate whose second field merely CONTAINS the marker is a four-field
// setting whose SALT is that field, and the shipping library hashes on it as the salt (measured), so we must. The
// readings separate by the cause they NAME: positionally this field is a salt, and only a substring scan would
// call it a cost with no salt — a wrong sentence that sends an operator to the wrong shelf. The digits are legal
// on purpose, so nothing but position distinguishes this from a real cost.
test fn a_cost_marker_sitting_inside_a_field_is_salt_and_not_a_cost() -> Bool {
  match cause_of(crypt_digest: "$6$xrounds=10000$saltsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj.") {
    // THE POSITIONAL READING, named exactly: field 2 is not the marker at its position, so this is a five-field
    // setting with a field the grammar has no name for — and the salt is field 3 by elimination.
    Present { value: UnaccountedFieldBeforeSalt { fields_seen: seen } } => seen == 5
    // The substring reading is the one this row exists to refuse: find the marker anywhere and the same bytes
    // become a cost form, the salt is read as field 3 with 8 legal characters, the digest is field 4 with 86
    // legal characters, and the candidate is ADMITTED. "Never admitted" is therefore the whole difference
    // between the two grammars, and it is why every other arm fails this row.
    Present { value: _ } => false
    Absent => false
  }
}

test fn the_printable_range_admits_its_endpoints_and_refuses_just_outside() -> Bool {
  shared_restriction_character_is_printable(code: 33)
    && shared_restriction_character_is_printable(code: 126)
    && shared_restriction_character_is_printable(code: 32) == false
    && shared_restriction_character_is_printable(code: 127) == false
    && shared_restriction_character_is_printable(code: 0) == false
}

// THE ADMITTED PUNCTUATION STILL WORKS, '~' included: it is printable and it is not one of the reserved
// characters, so a generator that uses it must keep working here. The companion to this row is the sweep that
// refuses the reserved set — together they pin both sides of the line, which is the only way a widening or a
// narrowing of either side shows up as a red row.
test fn permitted_punctuation_in_the_salt_is_still_accepted() -> Bool {
  accepts(crypt_digest: "$6$~a.b_c-d+e$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj.")
}

// THE ORDER IS PART OF THE CONTRACT, NOT AN IMPLEMENTATION DETAIL. Upstream scans the whole setting before
// dispatching to the scheme, so a candidate that breaks BOTH rules must be reported as the shared failure —
// the alphabet verdict would be true about the alphabet and wrong about what to do. The candidate below has a
// '!' in a digest that is otherwise the right length, so only the shared scan can be the first diagnosis.
// THE SALT CHARACTER CLASS IS SUBSUMED BY THE SHARED SCAN, AND THE PIN SAYS SO. The class forbids four
// characters; three of them (':', CR, LF) also violate the shared printable/no-delimiter rule, and the fourth
// ('$') cannot appear inside a segment because '$' is the split character. So while the walk runs in upstream
// order, the class can never be the thing that refuses a candidate — the shared scan always gets there first.
//
// THAT IS A PROPERTY, NOT AN OBSERVATION, AND IT HAS TO BE FALSIFIABLE. Delete the shared scan, or move it after
// the scheme walk, and the causes below change from SettingHoldsReservedCharacter to
// SaltHoldsForbiddenCharacter: same refusal, different remedy named for the operator, and this witness is what
// notices. It is also the reason the class is kept rather than deleted as dead code — it is the backstop if the
// ordering ever moves, and "unreachable today" is a statement about an ordering, not about the rule's worth.
test fn the_salt_character_class_is_subsumed_by_the_shared_scan() -> Bool {
  // ':' in the salt: refused, and by the SCAN, naming the reserved character rather than the salt class.
  match cause_of(crypt_digest: "$6$sa:tsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj.") {
    Present { value: SettingHoldsReservedCharacter { reserved: seen } } => (seen as String) == ":"
    _ => false
  }
  // A SPACE, WHICH IS NEITHER RESERVED NOR IN THE SALT CLASS. This is the case that separates the two rules
  // rather than showing them agree: the class forbids four characters and space is not one of them, and the
  // reserved list names five and space is not among them — the shared predicate refuses space through its
  // PRINTABLE-RANGE clause (below 0x21). So a shelf carrying the class and the reserved list and nothing else
  // would have accepted "$6$sa ltsalt$...", and a hash with a space in it is exactly the kind of thing that
  // arrives from a copy-paste through a terminal.
  && match cause_of(crypt_digest: "$6$sa ltsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj.") {
    Present { value: SettingHoldsReservedCharacter { reserved: _ } } => true
    _ => false
  }
  && refuses(crypt_digest: "$6$sa ltsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj.")
  // THE BACKSLASH CASE, WHICH THE SALT CLASS DOES NOT EVEN MENTION. The class forbids four characters and
  // backslash is not one of them, yet a setting carrying it is refused — because the shared scan refuses it. A
  // shelf holding only the class would have accepted this candidate, and that is the difference between the two
  // rules stated as one sentence: the class is narrower than the contract, so the contract has to run.
  && match cause_of(crypt_digest: "$6$sa\\lt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj.") {
    Present { value: SettingHoldsReservedCharacter { reserved: _ } } => true
    _ => false
  }
  // ...AND IT IS A REFUSAL AND NOT AN ACCEPTANCE, stated separately because the two arms above would also be
  // satisfied by a candidate that failed for a different reason. This is the line that pins the direction.
  && refuses(crypt_digest: "$6$sa\\lt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj.")
}

test fn the_shared_scan_is_answered_before_the_scheme_grammar() -> Bool {
  match cause_of(crypt_digest: "$6$rounds=abc$saltsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfn!") {
    Present { value: SettingHoldsReservedCharacter { reserved: _ } } => true
    _ => false
  }
}

// THE RULES AND THEIR ORDER ARE DATA ON THE SHELF, NOT A PROPERTY OF THE CODE THAT CALLS THEM. Two rows, in
// upstream order, each naming the authority that grounds it. If someone reorders the door this witness does not
// go red — which is exactly why the door's own ordering witness above exists. This one earns its keep the other
// way: it makes the pair readable without reading the door, and it goes red if a rule is dropped from the shelf
// while the door keeps calling the other one.
test fn the_shelf_states_both_rules_in_upstream_order() -> Bool {
  match crypt_acceptance_rules {
    Cons {
      head: SharedReservedCharacterScan { authority: _ },
      tail: Cons { head: SchemeFormatRules { authority: _ }, tail: Empty },
    } => true
    _ => false
  }
}

// THE COST IS READ AT ITS POSITION: A MALFORMED COST IS NEVER A SALT. This is the specific shape that the
// old `count == 5` rule ACCEPTED (three segments, so no cost check ran, and "rounds=abc" is a legal salt by
// the salt's own forbidden set) while the shipped library refuses it. Pinned to RoundsMalformed rather than
// SaltTooLong: the near-miss cause is the difference between sending an operator to the drive and sending
// them to the generator that emitted the string.
test fn a_cost_written_where_no_salt_field_exists_is_refused_for_its_arity() -> Bool {
  // THE HONEST VERDICT IS THE STRUCTURAL ONE. Three fields is neither documented spelling, so the arity arm
  // fires before any per-field test can be reached — and that is also what the shipping library does with this
  // string (it is a REFUSED row in the ledger). The claim this row makes, and can make, is that the candidate is
  // never accepted and never blamed on a field nobody wrote: no salt field exists here, so "your salt is
  // malformed" would send the operator to the wrong shelf. A malformed cost in a setting that DOES have a salt
  // is refused as RoundsMalformed, pinned by the ledger's "$6$rounds=abc$saltsalt$…" row and by
  // a_repeated_cost_marker_is_refused_though_its_digits_are_legal.
  match cause_of(crypt_digest: "$6$rounds=abc$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj.") {
    // THE STRUCTURAL ARM, WHICHEVER OF THE TWO STRUCTURAL NAMES IT CARRIES, and never a field blame. Both
    // structural arms are accepted deliberately: which one fires depends on whether the grammar recognised a
    // cost marker at its position, and the CLAIM this row defends is the one an operator acts on — the candidate
    // is refused for its SHAPE, not blamed on a salt or a digest nobody wrote. Pinning a single arm would let a
    // reordering inside the walk change the sentence this row is about; pinning the family cannot. Deleting the
    // layout arm entirely makes the walk fall through to the salt and digest arms, which is what this refuses.
    Present { value: NotACryptDigest } => true
    Present { value: CostFormMissingSalt { fields_seen: seen } } => seen == 4
    _ => false
  }
}

// THE WHOLE COST FIELD IS VALIDATED, INCLUDING WHAT HIDES BEHIND A VALID PREFIX. Splitting on the marker
// anywhere gave "1000" as the digits and never looked at "rounds=garbage" after it; the digits are legal, so
// a digits-only test passes. This is the counterexample that makes the whole-field rule non-vacuous.
test fn a_repeated_cost_marker_is_refused_though_its_digits_are_legal() -> Bool {
  match cause_of(crypt_digest: "$6$rounds=1000rounds=garbage$saltsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj.") {
    Present { value: RoundsMalformed } => true
    _ => false
  }
}

// AND THE ADMITTED COST STILL WORKS, BOTH ENDS OF THE RANGE. Without this the two refusals above could be a
// blanket refusal of every cost, which on a headless board means an operator cannot install at all.
test fn a_well_formed_cost_at_each_range_end_is_accepted() -> Bool {
  accepts(crypt_digest: "$6$rounds=1000$saltsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj.")
    && accepts(crypt_digest: "$6$rounds=999999999$saltsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj.")
}

// MATERIAL CONTENT MOVES THE DIGEST, AT EQUAL COUNTS. Three substitutions a count-only render could not see:
// an authorized key replaced by a different key of the same length, the Netplan source rewritten, and a
// debconf answer changed to another legal answer. Each keeps every count identical and each must move the
// digest, because the digest is what "the machine booted seed X" is answered with later.
test fn equal_count_substitutions_of_material_content_move_the_digest() -> Bool {
  match build_seed_fixture(
    network: network_posture,
    packages: clean_packages,
    entry_keys: one_key,
    console: locked_console,
    credential: seeded_handle,
    delivery: virtual_media_strategy,
    target: target_altra,
  ) {
    Absent => false
    Present { value: baseline } =>
      match build_seed_fixture(
        network: network_posture_alt_netplan,
        packages: clean_packages,
        entry_keys: one_key,
        console: locked_console,
        credential: seeded_handle,
        delivery: virtual_media_strategy,
        target: target_altra,
      ) {
        Absent => false
        Present { value: other_netplan } =>
          match build_seed_fixture(
            network: network_posture,
            packages: answered_tzdata_packages,
            entry_keys: one_key,
            console: locked_console,
            credential: seeded_handle,
            delivery: virtual_media_strategy,
            target: target_altra,
          ) {
            Absent => false
            Present { value: other_answers } =>
              !content_hash_eq_structural(
                left: altra_autoinstall_seed_digest(seed: baseline),
                right: altra_autoinstall_seed_digest(seed: other_netplan),
              )
                && !content_hash_eq_structural(
                  left: altra_autoinstall_seed_digest(seed: baseline),
                  right: altra_autoinstall_seed_digest(seed: other_answers),
                )
          }
      }
  }
}

// THE RENDERING SAYS WHAT IT IS, AND THE IDENTITY IS DERIVED FROM IT. The render is a diagnostic with a
// documented standing; the digest is taken from the rendered text, so if the render and the digest ever stop
// agreeing, "the machine booted seed X" is answered from something other than what was shipped.
test fn the_digest_is_taken_from_the_rendering_it_ships() -> Bool {
  match built_seed_and_binding() {
    Absent => false
    Present { value: pair } =>
      content_hash_eq_structural(
        left: content_hash_atom(value: pair.binding.seed_rendering),
        right: content_hash_atom(value: render_altra_autoinstall_seed(seed: pair.seed)),
      )
  }
}

// THE PRODUCED SEED'S OWN PROOF, NOT A SIDE CALL. The audit proof the seed carries must agree with a fresh
// audit of the same posture: a record whose stored proof disagreed with what the audit computes would let a
// mutated seed still read as non-interactive. Questions-closed and the console stanza are the two facts the
// proof asserts, so both are compared.
test fn the_produced_seed_carries_a_proof_that_agrees_with_a_fresh_audit() -> Bool {
  match built_seed_and_binding() {
    Absent => false
    Present { value: pair } =>
      match audit_seed_interactivity(
        network: pair.seed.network,
        install_packages: pair.seed.install_packages,
        late_packages: pair.seed.late_packages,
        locale: pair.seed.locale,
        strategy: pair.seed.delivery,
      ) {
        SeedIsNonInteractive { evidence: fresh } =>
          // THE PROOF THE SEED CARRIES, NOT A SECOND CALL. The record's own proof must be what a fresh audit
          // of the same inputs computes; a mutated or stale record would otherwise still read as non-interactive
          // to anything that trusts the field.
          fresh.questions_closed == pair.seed.proof.questions_closed
            && fresh.console_stanza == pair.seed.proof.console_stanza
        SeedRefused { cause: _ } => false
      }
  }
}

// THE LATE PACKAGE SET IS NOT EMPTY. An empty package list passes every structural rule above and installs a
// board with no NVMe tooling, no IPMI tooling and no firmware — which is a board that boots and cannot be
// managed, on a fleet where nobody can reach the panel. The set is a claim about this hardware, so the claim
// is asserted rather than assumed.
test fn the_produced_seed_installs_the_altra_late_package_set() -> Bool {
  match built_seed_and_binding() {
    Absent => false
    Present { value: pair } =>
      list_length(items: pair.seed.late_packages) >= 4
        && pair.seed.late_packages.any(intent => package_intent_diagnostic(intent: intent).contains("nvme-cli"))
        && pair.seed.late_packages.any(intent => package_intent_diagnostic(intent: intent).contains("ipmitool"))
        && pair.seed.late_packages.any(intent => package_intent_diagnostic(intent: intent).contains("dmidecode"))
  }
}

// EVERY SEED THE BINDER PRODUCES IS BOUND, NEVER A REFUSAL WITH A PLACEHOLDER RECORD. A binding whose digest
// was filled in on the refusal path would answer "the machine booted seed X" for a machine that booted
// nothing. This walks the ordinary construction and requires the Bound arm, twice over, from both fixtures.
test fn both_fixtures_yield_bound_records_rather_than_placeholders() -> Bool {
  match built_seed_and_binding() {
    Absent => false
    Present { value: first } =>
      match built_second_unit_binding() {
        Absent => false
        Present { value: second } =>
          first.binding.unit_key != second.binding.unit_key
            && first.binding.seed_digest == second.binding.seed_digest
      }
  }
}

// THE NETPLAN SOURCE THE SEED CARRIES, IN A SECOND SPELLING. The old render emitted only the tag
// "seeded-netplan", so one source could be swapped for another — a VLAN change, a static that never brings the
// BMC-reachable interface up — and the digest stayed identical. Same family, same mirror, same everything else:
// the source is the ONLY difference, so this pair proves the source is digested rather than decorative.
data network_posture_alt_netplan: SeedNetworkPosture = SeedNetworkPosture {
  addressing: SeededNetplan { source: "99-gunbc-alt.yaml" as NonEmptyStr },
  family: Ipv4Only,
  mirror: Present { value: NamedMirrorAuthority { host: "mirror.internal.invalid" as NonEmptyStr } },
}

// THE SAME SEED ON THE OTHER UNIT, for the witness that requires both bindings to be Bound rather than
// placeholder records. Two units, one seed: the seed digests agree and the binding identities do not, which is
// the whole reason the two digests are computed under different tags.
fn built_second_unit_binding() -> Optional<SeedAndBinding> {
  match build_seed_fixture(
    network: network_posture,
    packages: clean_packages,
    entry_keys: one_key,
    console: locked_console,
    credential: seeded_handle,
    delivery: virtual_media_strategy,
    target: target_altra,
  ) {
    Absent => Absent
    Present { value: seed } =>
      match bind_altra_autoinstall_seed(
        seed: seed,
        target: target_altra,
        unit_key: unit_b_key,
        attempt: attempt_two,
        selection: select_target_disk(selector: serial_selector, observed: bay_population),
      ) {
        Bound { binding: binding } => Present { value: SeedAndBinding { seed: seed, binding: binding } }
        BindRefused { blocker: _ } => Absent
      }
  }
}

// A HALF-ANSWERED tzdata IS STILL AN OPEN QUESTION. The shipped postinst does db_get tzdata/Areas and then
// db_get "tzdata/Zones/$AREA", so text naming only the region leaves the second question live and the installer
// stopped with nobody at the panel. The old one-key table credited this as answered and the seed proved
// non-interactive on a seed that was not — the exact hung install this cut was chartered to prevent. The
// near-miss is a successful build: the package name is right, the arm is QuestionAnswered, and only the key
// list knows that half a question is still a question.
test fn a_half_answered_tzdata_is_refused_though_it_was_answered() -> Bool {
  match build_seed_fixture(
    network: network_posture,
    packages: half_answered_tzdata_packages,
    entry_keys: one_key,
    console: locked_console,
    credential: seeded_handle,
    delivery: virtual_media_strategy,
    target: target_altra,
  ) {
    Present { value: _ } => false
    Absent => true
  }
}

// AND THE FULLY ANSWERED PAIR BUILDS, WHICH IS THE CONTROL THAT MAKES THE REFUSAL ABOVE A RULE AND NOT A BUG.
// Refusing every tzdata would keep the board safe and strand the operator; the audit has to accept the seed
// that actually answered both questions.
test fn a_fully_answered_tzdata_builds() -> Bool {
  match build_seed_fixture(
    network: network_posture,
    packages: answered_tzdata_packages,
    entry_keys: one_key,
    console: locked_console,
    credential: seeded_handle,
    delivery: virtual_media_strategy,
    target: target_altra,
  ) {
    Absent => false
    Present { value: _ } => true
  }
}

// A SALT THAT MERELY CONTAINS THE COST MARKER IS A SALT. Measured on the shipped library: this candidate
// hashes, because libxcrypt memcmps the marker at position zero of its field and the match is case-sensitive.
// So "does the candidate contain rounds=" cannot decide anything, and a rule that decided by substring would
// refuse a legal digest here — a false refusal on a headless board is worse than a late one, because the
// operator cannot read the error at a console.
test fn a_salt_that_merely_contains_the_cost_marker_is_still_accepted() -> Bool {
  accepts(crypt_digest: "$6$sarounds=1000$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj.")
}

// THE PACKAGE TABLE IS THE ARCHIVE-VERIFIED SET, AND NOTHING ELSE. Each of these seven names was checked
// against the Noble arm64 release index (ports.ubuntu.com, main+universe, 69,641 packages); the five that used
// to be here — ast-ahc, dca-tools, ahci, r8169-firmware, realtek-firmware — are absent from that index, and a
// seed naming a package the mirror does not carry is the hung unattended install this module exists to
// prevent. Pinning the exact set rather than "at least one" is what makes an ungrounded row a witness failure
// rather than a review finding: ifupdown was removed on the same evidence (Noble ships no debconf templates at
// all), and re-adding it, or adding anything else nobody has verified, fails here.
test fn the_prompting_package_table_is_the_verified_set_exactly() -> Bool {
  let names = known_prompting_packages().map(row => known_prompting_package_name(package: row))
  list_length(items: names) == 7
    && names.any(row => row == ("console-setup" as NonEmptyStr))
    && names.any(row => row == ("keyboard-configuration" as NonEmptyStr))
    && names.any(row => row == ("tzdata" as NonEmptyStr))
    && names.any(row => row == ("postfix" as NonEmptyStr))
    && names.any(row => row == ("ntp" as NonEmptyStr))
    && names.any(row => row == ("openssh-server" as NonEmptyStr))
    && names.any(row => row == ("cloud-init" as NonEmptyStr))
    && !names.any(row => row == ("ifupdown" as NonEmptyStr))
    && !names.any(row => row == ("ast-ahc" as NonEmptyStr))
    && !names.any(row => row == ("dca-tools" as NonEmptyStr))
}

// THE KEY MATERIAL ITSELF, AT IDENTICAL COUNT AND IDENTICAL LENGTH. The claim in that sentence is now LITERAL and
// was not before: this is provisioning_key's 51-octet RFC 8709 blob with EXACTLY ONE KEY OCTET flipped (the 32nd)
// and therefore EXACTLY ONE base64 CHARACTER differing out of 68. Equal count, equal length, equal algorithm,
// equal header octets -- the only difference in the whole seed is which key is authorized. Under the old render,
// which emitted "keys=1", these two seeds digested identically, so a board could be handed a seed with somebody
// else's key and the receipt would not know. This is the fixture that makes the key hash load-bearing rather than
// decorative: nothing else can move the digest here, so if the digest does not move, the render is not covering
// the key. Both fixtures are now REAL keys that extdeps.ssh.keys' parser accepts, which the earlier typed-in
// strings were not -- see admit_admin_access_authorisation, which refuses a key that parser rejects.
// KEY MATERIALS THAT LOOK EXACTLY AS PLAUSIBLE AS A REAL ONE AND ARE NOT ONE. Each isolates a different clause of
// extdeps.ssh.keys' ssh_ed25519_key_identity, so weakening one clause cannot hide behind the other two.
// not_base64_length is 69 characters and 69 is a length base64 never produces (mod 4 == 1), so the canonical
// decoder refuses it before any SSH rule is reached. trailing_octets is 132 characters that decode cleanly to 99
// octets with a perfect header and a declared length of 32 -- only the exact 51-octet length clause can refuse it.
// declared_wrong_length is EXACTLY 51 octets, so the length clause PASSES and the nineteen header octets alone
// refuse it: the declared key length is 31, and its first key octet is 7, chosen NOT to alias the 32 the header
// demands, so the mismatch is real rather than an accident of layout. rsa/ecdsa carry a perfectly good blob under
// an algorithm this repository has no parser for, which is a refusal, not a pass.
//
// THESE ARE THE SHAPES MY SEEDS AUTHORISED BEFORE THIS ROUND. That is the defect this row set exists for: a
// typed-in string shaped like a key reached the render, the digest and the board's admin account, the install
// would have completed, and nobody could have logged in. They are kept here -- not deleted -- because a refusal
// that no longer has a fixture is a refusal nobody can see rotting.
data key_not_base64_length: List<SshPublicKey> = [
  SshPublicKey {
    algorithm: Ed25519,
    material: "AAAAC3NzaC1lZDI1NTE5AAAAIProvisioningKeyMaterialIsPublicAndNotASecret" as NonEmptyStr,
    comment: "shaped-like-a-key",
  },
]

data key_trailing_octets: List<SshPublicKey> = [
  SshPublicKey {
    algorithm: Ed25519,
    material: "AAAAC3NzaC1lZDI1NTE5AAAAIAABAgMEBQYHCAkKCwwNDg8QERITFBUWFxgZGhscHR4fAAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8gISIjJCUmJygpKissLS4v" as NonEmptyStr,
    comment: "forty-eight-octets-too-many",
  },
]

data key_declared_wrong_length: List<SshPublicKey> = [
  SshPublicKey {
    algorithm: Ed25519,
    material: "AAAAC3NzaC1lZDI1NTE5AAAAHwcBAgMEBQYHCAkKCwwNDg8QERITFBUWFxgZGhscHR4f" as NonEmptyStr,
    comment: "header-claims-31",
  },
]

data keys_rsa: List<SshPublicKey> = [
  SshPublicKey {
    algorithm: Rsa,
    material: "AAAAC3NzaC1lZDI1NTE5AAAAIAABAgMEBQYHCAkKCwwNDg8QERITFBUWFxgZGhscHR4fAAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8gISIjJCUmJygpKissLS4v" as NonEmptyStr,
    comment: "rsa-has-no-parser-in-this-repo",
  },
]

data keys_ecdsa: List<SshPublicKey> = [
  SshPublicKey {
    algorithm: EcdsaP256,
    material: "AAAAC3NzaC1lZDI1NTE5AAAAIAABAgMEBQYHCAkKCwwNDg8QERITFBUWFxgZGhscHR4fAAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8gISIjJCUmJygpKissLS4v" as NonEmptyStr,
    comment: "ecdsa-has-no-parser-in-this-repo",
  },
]

// ONE OCTET OF THE 32-OCTET ED25519 PUBLIC KEY IS FLIPPED, and nothing else changes: the same algorithm, the
// same comment, and the same 68-character base64 spelling (one octet inside a 6-octet base64 group changes one
// character without changing the length). The earlier fixture changed the comment too, so a digest built from
// comment-and-count alone — ignoring the key material entirely — satisfied the row that was supposed to prove
// material was hashed. Now the ONLY difference between the two seeds is a bit of key material, so any control
// that passes without hashing material is this row going red. (review: merry-fox-82)
data one_other_key: List<SshPublicKey> = [
  SshPublicKey {
    algorithm: Ed25519,
    material: "AAAAC3NzaC1lZDI1NTE5AAAAIAcKDRATFhkcHyIlKCsuMTQ3Oj1AQ0ZJTE9SVVhbXmFl" as NonEmptyStr,
    comment: "gunbc-provisioning",
  },
]

test fn different_key_material_at_equal_count_moves_the_digest() -> Bool {
  match build_seed_fixture(
    network: network_posture,
    packages: clean_packages,
    entry_keys: one_key,
    console: locked_console,
    credential: seeded_handle,
    delivery: virtual_media_strategy,
    target: target_altra,
  ) {
    Absent => false
    Present { value: with_first } =>
      match build_seed_fixture(
        network: network_posture,
        packages: clean_packages,
        entry_keys: one_other_key,
        console: locked_console,
        credential: seeded_handle,
        delivery: virtual_media_strategy,
        target: target_altra,
      ) {
        Absent => false
        Present { value: with_other } =>
          list_length(items: with_first.entry.authorised_keys)
            == list_length(items: with_other.entry.authorised_keys)
            && !content_hash_eq_structural(
              left: altra_autoinstall_seed_digest(seed: with_first),
              right: altra_autoinstall_seed_digest(seed: with_other),
            )
      }
  }
}

// ---------------------------------------------------------------------------
// CONTROLS FOR THE RULES AND DERIVED SPELLINGS THAT NO EARLIER WITNESS CONSTRAINED.
// Every block below exists because a mutation of the rule underneath it was MEASURED GREEN: the suite reported a
// full pass while the rule was deleted, widened, or frozen to a constant. The method is to ask what a mutation
// could HIDE BEHIND rather than what it changes — a rule that is never the sole arm able to fire, or a derived
// spelling no assertion reads, reports exactly as green as it did before the rule was quietly removed. Kept apart
// from the defect fixtures above because the subject here is the test surface rather than the wire format.
// ---------------------------------------------------------------------------

// A SECOND KEY, so the authorised-key line can be shown to COUNT rather than to echo a fixture. The two
// materials differ from each other, so this is two keys and not one key written twice.
data two_distinct_keys: List<SshPublicKey> = [
  SshPublicKey {
    algorithm: Ed25519,
    material: "AAAAC3NzaC1lZDI1NTE5AAAAIAcSHSgzPklUX2p1gIuWoay3ws3Y4+75CRQfKjVAS1Zh" as NonEmptyStr,
    comment: "gunbc-operator-a",
  },
  SshPublicKey {
    algorithm: Ed25519,
    material: "AAAAC3NzaC1lZDI1NTE5AAAAIAcKDRATFhkcHyIlKCsuMTQ3Oj1AQ0ZJTE9SVVhbXmFl" as NonEmptyStr,
    comment: "gunbc-operator-b",
  },
]

// THE SEGMENT-COUNT RULE MUST BE AN ASSERTION, NOT A FLOOR — AND IT MUST BE THE ONLY ARM THAT CAN FIRE.
// crypt.5 says a setting is four segments without a cost and five with one. This candidate is SIX, and it is
// built so that nothing else can refuse it: the shared scan sees only printable characters, the scheme token is
// the cited "6", the cost is read at position two and reads as a well-formed rounds field, the salt is read one
// segment from the END (so it reads "extra" — ten legal printable characters), and the digest is the cited 86
// characters from the fixtures above. So the permissive bound that a mutation of this rule produces, `count >= 4`,
// mints a receipt for a string that is not a sha512-crypt setting at all, and the credential would be accepted
// with an unexamined '$' sitting inside its salt region. It must come back NotACryptDigest, which is the only
// honest cause: nothing about that text is malformed in its cost, its salt or its digest — it is not the format.
// The ceiling side (four and five both admitted) is already pinned above by the cost-bearing accepted digest, so
// the bound cannot be silently narrowed to a flat `count == 4` either; together the two make this a rule rather
// than a guess.
test fn an_unexpected_segment_count_is_refused_as_not_a_digest() -> Bool {
  match admin_password_hash_receipt(
    credential: seeded_handle,
    crypt_digest: "$6$rounds=1000$saltsalt$extra$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj." as NonEmptyStr,
  ) {
    ReceiptAccepted { receipt: _ } => false
    ReceiptRefused { cause: NotACryptDigest } => true
    ReceiptRefused { cause: _ } => false
  }
}

// AN ANSWER SUPPLIED FOR AN UNKNOWN PACKAGE IS ATTRIBUTED IN THAT ROW'S RENDER SPELLING. The builder refuses an
// unclassified row, so no seed can ever carry one — which is also why nothing above could see this arm: the
// spelling is asserted directly on the function that produces it, because that string is what the render would
// carry the day the refusal is relaxed (and the day it is relaxed is the day an operator needs it). The coverage
// is the whole content of the row: an unclassified row deliberately reports NO question, because this module has
// not observed one and printing a question would fabricate the very evidence the refusal complains about. So if
// the answer's coverage goes too, a refused seed states only "some package we do not know" and the operator
// cannot tell the attempt where an answer was supplied from the one where nothing was — different work was done
// for each, and the digest cannot tell them apart. Asserted both ways: the coverage is present, and a seeded row
// does not spell the same as an unseeded one.
test fn an_unclassified_row_carries_the_answer_it_was_given() -> Bool {
  let seeded = package_intent_diagnostic(intent: UnclassifiedPackage {
    name: "some-fleet-exporter" as NonEmptyStr,
    answers: debconf_answer(
      owner: "some-fleet-exporter" as NonEmptyStr,
      kind: AnswerString,
      label: "some-fleet-exporter/dummy" as NonEmptyStr,
      value: "true" as NonEmptyStr,
    ),
  })
  let unseeded = package_intent_diagnostic(intent: UnclassifiedPackage {
    name: "some-fleet-exporter" as NonEmptyStr,
    answers: [],
  })
  seeded.contains("some-fleet-exporter")
    && seeded.contains("unclassified")
    // THE ANSWER'S COVERAGE IS IN THE SEEDED SPELLING AND IN NO OTHER, so the row records that an answer was
    // supplied without reproducing it: an unseeded row says only that the package is unknown.
    && seeded.contains("answers=")
    && !unseeded.contains("answers=")
}

// THE AUTHORISED-KEY LINE COUNTS THE KEYS IT WAS GIVEN. Two mutations hide here and they hide from each other:
// dropping the count (leaving the digest of the key list as the only trace, so the line no longer states how many
// keys are authorised) and freezing it (so the line states a number that has stopped tracking the list — and a
// dropped authorised key then moves the digest while the render keeps reassuringly claiming one key). Four
// assertions, and the last is what separates the two: the line appears verbatim in the render, it carries the
// posture the seed was admitted under, its count is the length of the list the entry actually carries, and the
// SAME fixture under two keys renders count=2 and no longer contains count=1.
test fn the_authorised_key_line_counts_the_keys_it_was_given() -> Bool {
  match build_seed_fixture(
    network: network_posture,
    packages: clean_packages,
    entry_keys: one_key,
    console: locked_console,
    credential: seeded_handle,
    delivery: virtual_media_strategy,
    target: target_altra,
  ) {
    Absent => false
    Present { value: one } =>
      match build_seed_fixture(
        network: network_posture,
        packages: clean_packages,
        entry_keys: two_distinct_keys,
        console: locked_console,
        credential: seeded_handle,
        delivery: virtual_media_strategy,
        target: target_altra,
      ) {
        Absent => false
        Present { value: two } =>
          list_length(items: one.entry.authorised_keys) == 1
            && list_length(items: two.entry.authorised_keys) == 2
            && render_altra_autoinstall_seed(seed: one).contains("keys=")
            && render_altra_autoinstall_seed(seed: one).contains("count=1")
            && render_altra_autoinstall_seed(seed: two).contains("count=2")
            // THE COUNT IS NOT A CONSTANT: one key and two keys cannot both read "count=1".
            && !render_altra_autoinstall_seed(seed: two).contains("count=1")
      }
  }
}

// A VERIFIED SILENCE CLOSES NO QUESTION, AND IS STILL SHIPPED. The four required late rows are the packages this
// board cannot be reached without — nvme-cli, ipmitool, dmidecode, rasdaemon — and each was verified silent
// against its own shipped .deb. Three assertions, each killing a defect the suite previously let through:
//   - THE TALLY DOES NOT COUNT THEM. The shipped late set closes exactly the same five questions the bare set
//     does, while adding one genuinely answered debconf question raises the count to six. That second half is what
//     makes the first a claim about silence rather than about a fixture that happens to ask nothing: the mutation
//     this exists for credits a silent row as an answered question, which inflates the tally by four — and the
//     tally is RENDERED and hashed, so two seeds differing only in how many packages were CLAIMED silent would be
//     told apart by luck.
//   - THE SEED IS NOT REFUSED. A package whose silence is cited asks nothing; refusing it is a bug, and was the
//     original one, which had every produced-seed fixture pass an empty late list to get green at all.
//   - THE BUILD AND THE STANDING ARE IN THE RENDER. The build is what the silence is ABOUT, and the standing says
//     how far to trust it: without them "nvme-cli, silently, according to somebody" hashes the same as "nvme-cli
//     2.8-1build2, per its shipped package", and the binding — the record an operator quotes years later to answer
//     "what did this board actually get" — would carry neither.
test fn a_verified_silence_closes_no_question_but_is_still_shipped() -> Bool {
  match admit_admin_access_authorisation(authorised_keys: one_key, console_entry: locked_console) {
    Absent => false
    Present { value: entry } =>
      match audit_altra_autoinstall_seed(
        network: network_posture,
        install_packages: clean_packages,
        late_packages: [],
        locale: EnUsUtf8,
        entry: entry,
        strategy: virtual_media_strategy,
      ) {
        SeedRefused { cause: _ } => false
        SeedIsNonInteractive { evidence: bare } =>
          match audit_altra_autoinstall_seed(
            network: network_posture,
            install_packages: clean_packages,
            late_packages: altra_required_late_package_rows(),
            locale: EnUsUtf8,
            entry: entry,
            strategy: virtual_media_strategy,
          ) {
            SeedRefused { cause: _ } => false
            SeedIsNonInteractive { evidence: silent } =>
              // THE CONTROL, in the SAME LIST the four silent rows occupy: one genuinely answered row there
              // raises the tally by one. Without it, "silent == bare" could be read as "this tally never moves".
              match audit_altra_autoinstall_seed(
                network: network_posture,
                install_packages: clean_packages,
                late_packages: [QuestionAnswered {
                  package: CloudInitPackage,
                    answers: debconf_answer_for(
                      package: CloudInitPackage,
                      kind: AnswerMultiselect,
                      label: "cloud-init/datasources" as NonEmptyStr,
                      value: "None" as NonEmptyStr,
                    ),
                }],
                locale: EnUsUtf8,
                entry: entry,
                strategy: virtual_media_strategy,
              ) {
                SeedRefused { cause: _ } => false
                SeedIsNonInteractive { evidence: answered } =>
                  // FOUR SILENT ROWS AND NOTHING CLOSED — and pinned to the ARITHMETIC, not merely shown equal:
                  // the fixture's three answered install rows, plus netplan, plus a named mirror, plus the locale
                  // term. A mutation that credits a silent row as an answered question reads 10 here, which no
                  // relative comparison would catch. The third audit is the control that makes the equality above
                  // a claim about SILENCE rather than about a fixture that happens to ask nothing: it drops the
                  // four silent rows and keeps the same three answered ones, so the only difference between the
                  // two counts is the four rows that must contribute zero.
                  silent.questions_closed == bare.questions_closed
                    && silent.questions_closed == 5
                    && answered.questions_closed == 6
                    // THE SHIPPED RENDER, build and standing included.
                    && match build_seed_fixture(
                      network: network_posture,
                      packages: clean_packages,
                      entry_keys: one_key,
                      console: locked_console,
                      credential: seeded_handle,
                      delivery: virtual_media_strategy,
                      target: target_altra,
                    ) {
                      Absent => false
                      Present { value: built } =>
                        render_altra_autoinstall_seed(seed: built)
                          .contains("nvme-cli+silent,silent@2.8-1build2,cited,answered=0")
                          && render_altra_autoinstall_seed(seed: built)
                            .contains("ipmitool+silent,silent@1.8.19-7build2,cited,answered=0")
                    }
              }
          }
      }
  }
}

// A SEED UNDER THE SHIPPED DISK RULE WITH AN EXPLICIT LATE SET. The shared builder pins the shipped rows, which
// is right for every witness that cares about the seed's other axes and wrong for the two that care about the late
// set's spelling: those must be able to restate one row (at another build, or under another standing) without
// touching a shared fixture.
fn build_seed_with_late(late: List<PackageIntent>) -> Optional<AltraAutoinstallSeed> {
  match admit_admin_access_authorisation(authorised_keys: one_key, console_entry: locked_console) {
    Present { value: entry } =>
      build_altra_autoinstall_seed(
        target: target_altra,
        network: network_posture,
        install_drivers: [NvmeCliDriver, LinuxFirmwareDriver],
        loadable_modules: [AhciPlatformModule, NvmeBlockModule],
        late_drivers: [KipmiSiDriver, IpmiWatchdogDriver],
        install_packages: clean_packages,
        late_packages: late,
        disk: serial_selector,
        entry: entry,
        credential: seeded_handle,
        password_read: password_read_for(credential: seeded_handle),
        locale: EnUsUtf8,
        delivery: virtual_media_strategy,
        keyboard: UsLayout,
      )
    Absent => Absent
  }
}

// AN OWED READING IS SPOKEN, NOT IMPLIED. The silence diagnostic has two arms: a cited claim ends ",cited", and
// a claim whose reading is still owed must carry the text that says what has to be read. The cited arm is pinned
// by the witness above; NOTHING pinned this one, which is how a mutation that deletes the obligation text (leaving
// a bare ",owed" marker, or nothing at all) survives: the row would still read as a silence claim, and the only
// reader that could tell a transcribed figure from a cited one — the one that cannot re-open the artifact — loses
// the sentence that tells it what to go read. Asserted on the render, because the render is the artifact that
// travels; and asserted as CONTAINMENT of the standing's own text rather than a literal, so the diagnostic cannot
// invent its own obligation and cannot paraphrase the standing into silence.
test fn a_silence_whose_reading_is_owed_says_what_must_be_read() -> Bool {
  match build_seed_fixture(
    network: network_posture,
    packages: clean_packages,
    entry_keys: one_key,
    console: locked_console,
    credential: seeded_handle,
    delivery: virtual_media_strategy,
    target: target_altra,
  ) {
    Absent => false
    Present { value: built } =>
      // The shipped rows are cited, so the render carries ",cited" and no owed text...
      render_altra_autoinstall_seed(seed: built).contains("nvme-cli+silent,silent@2.8-1build2,cited,answered=0")
        // ...and a row whose standing owes a reading carries the obligation itself, verbatim from the standing.
        && match build_seed_with_late(
          late: [
            // THE RECEIPT CARRIES ITS OWN PACKAGE, so there is no name field here to mismatch: an
            // nvme-cli version pinned beside an ipmitool claim is not a thing this file can write.
            PackageVerifiedSilent {
              silence: SilentReceipt {
                package: "nvme-cli" as NonEmptyStr,
                observed_version: "2.8-1build2" as NonEmptyStr,
                standing: TranscribedUncited {
                  read_obligation: "read the Noble arm64 archive index before believing this row" as NonEmptyStr,
                },
              },
            },
            PackageVerifiedSilent { silence: ipmitool_silence_receipt },
            PackageVerifiedSilent { silence: dmidecode_silence_receipt },
            PackageVerifiedSilent { silence: rasdaemon_silence_receipt },
          ]
        ) {
          Absent => false
          Present { value: owed } =>
            render_altra_autoinstall_seed(seed: owed)
              .contains(",owed=read the Noble arm64 archive index before believing this row")
              && !render_altra_autoinstall_seed(seed: owed).contains("nvme-cli+silent,silent@2.8-1build2,cited")
        }
  }
}

// THE BOUND DISK IS THE PROBE'S OWN LABEL, NEVER AN INVENTED CONSTANT. The unread arm has no serial to report, so
// it reports the label the probe gave the device when it read the model and nothing else. The mutation this exists
// for is the laundering that makes a fabrication look like evidence: recording an unread disk as a BOUND disk with
// a placeholder serial, which answers "what did that install write to?" with a serial nobody observed — and the
// binding digest then agrees with itself, so nothing downstream can tell the two records apart. The fixture is a
// CATALOG rule over the drive whose serial the probe could not read: a catalog rule is the one rule the upstream
// module lets an unread serial through, because its identity is part number and capacity and both WERE measured.
// So no other part of the projection may be the reason it resolves, and the honest arm is the only one left to
// test against. The provenance is asserted in the same breath: the record must say which rule chose the disk and
// out of how many, which is what lets a reviewer disagree with the choice later.
// THE UNREAD ARM IS NOT A BOUND DISK WITH A PLACEHOLDER SERIAL (mutation H25: the arm collapsed into a BoundDisk
// whose serial was the device label). bound_disk_identity is the ONLY way a caller gets a disk identity out of a
// selection, so the shape it returns is inherited by the projection, the binding and the digest alike. A BoundDisk
// holding a made-up serial is INDISTINGUISHABLE BY TYPE from one whose serial was read — which is precisely how a
// fabricated serial survives a digest compare: the binding digests whatever it is given. So the assertion here is
// on the VARIANT reaching this fold, from the other direction to the row below: given a device whose serial the
// probe could not read, BoundDisk must be UNREACHABLE at any serial value.
test fn a_device_with_no_read_serial_never_produces_a_bound_disk_shape() -> Bool {
  match select_target_disk(selector: catalog_selector, observed: [serial_unread_disk]) {
    // THE SELECTION SUCCEEDED, or the arms below would be vacuously true and the row would prove nothing.
    SelectionRefused { cause: _ } => false
    DiskSelected { provenance: provenance } =>
      match provenance_chosen_identity(provenance: provenance) {
        // Must be unreachable: no reader can tell a laundered serial from an observed one at this type.
        BoundDisk { serial: _, matched: _, observed: _ } => false
        // Must name the ONE field the probe did read, so an unidentified disk is still checkable against the
        // tray. An unread arm naming nothing would be a refusal wearing a projection's clothes.
        BoundDiskUnread { part_number: identity } => identity.length() > 0
      }
  }
}

test fn an_unread_selected_disk_is_recorded_as_unread_not_as_a_fabricated_serial() -> Bool {
  match project_storage_policy(selection: select_target_disk(selector: catalog_selector, observed: [serial_unread_disk])) {
    ProjectionUnresolved { cause: _ } => false
    Projected { policy: _, device: evidence, provenance: provenance } =>
      match evidence {
        // THE ONLY HONEST ANSWER: unread, named by the one thing that WAS observed — the catalog's own part
        // number, so an unread disk stays findable in the fleet without anybody guessing at it.
        BoundDiskUnread { part_number: part } =>
          part == ("WDS200T2X0E" as NonEmptyStr)
            && provenance.selector == catalog_selector
            && provenance.matched == 1
            && provenance.observed == 1
        // A serial in this arm is a fabrication: the probe read none, so no arm that reports a serial can be right.
        BoundDisk { serial: _, matched: _, observed: _ } => false
      }
  }
}


// ---------------------------------------------------------------------------
// THE SHIPPING LIBRARY, AS A DIFFERENTIAL RATHER THAN A REMEMBERED FACT.
// crypt_library_acceptance is this repository's measurement of the libcrypt that ships in the target image, and
// it lives in the observing layer (DESIGN §3b: observations belong to the consumer, not to extdeps). A measurement
// nobody re-runs is a memory, and memories about a third-party library rot silently: the accepted set here was
// established by calling crypt_r on Noble's 1:4.4.36-4build1 and on the CI image's 4.4.38-1, and the only way it
// stays true is by being checked against THIS module's door on every run. These two witnesses together require
// every recorded row to agree with the verdict this module would give: a flipped row, a deleted row, or a door
// that has drifted from the library reddens one of them. They are separate because the two directions fail for
// different reasons and send an operator to different shelves.
// ---------------------------------------------------------------------------

// EVERY RECORDED ACCEPTANCE MUST ALSO BE ACCEPTED HERE. The library let these through, and a door that refuses
// one is a door that would deny a board a credential its own crypt(3) verifies — the failure mode this module has
// been corrected for twice (the allowed-alphabet salt check refused "$6$sa!tsalt$", which libxcrypt accepts). The
// fold keeps going after the first disagreement and counts them, because a candidate that fails four rules
// simultaneously makes a fifth rule untestable, and a witness that stops at the first would hide the rest.
test fn everything_the_shipping_library_accepted_is_accepted_here_too() -> Bool {
  let disagreements = fold(
    crypt_library_verdicts(),
    init: 0,
    f: (counted, verdict) =>
      match verdict {
        LibraryAccepted { setting: setting } =>
          match admin_password_hash_receipt(credential: seeded_handle, crypt_digest: setting) {
            ReceiptAccepted { receipt: _ } => counted
            ReceiptRefused { cause: _ } => counted + 1
          }
        // NOT PART OF THIS SWEEP, AND DELIBERATELY SO. The library hashed these settings without ever reading
        // the digest slot, so demanding agreement with it here would force this module to accept a credential no
        // login can reproduce. Their own sweep is the one below.
        LibraryAcceptedButNotAStoredHash { setting: _, gap: _ } => counted
        LibraryRefused { setting: _ } => counted
      },
  )
  // THE DENOMINATOR IS ASSERTED, NOT ASSUMED: a fold over an empty list also reports zero disagreements, and an
  // empty list is exactly what a deleted or mis-wired row set looks like. 0/0 is not clean here any more than it
  // is in the mutation harness. The three per-arm counts partition the row set, so a row MOVED between arms —
  // the cheapest way to make one of these sweeps pass by accident — reddens this line.
  disagreements == 0
    && list_length(items: crypt_library_verdicts()) == 24
    && accepted_row_count() == 7
    && stored_hash_gap_row_count() == 4
    && refused_row_count() == 13
    && list_length(items: crypt_library_acceptance.observed_on) == 3
    && crypt_library_acceptance.observed_build.contains("4.4.36-4build1")
}

// EVERY RECORDED REFUSAL MUST ALSO BE REFUSED HERE, AND BY THE ARM THAT FITS THE REMEDY. Refusing something the
// library refuses is the cheap half; the half that rots is WHICH CAUSE is named, because the cause is what tells
// an operator what to fix. Each recorded refusal must land on the shared reserved-character scan or on the cost
// field — the two rules the library actually enforces — and never on the digest alphabet or the segment count,
// which are this module's own contract and would let an operator chase the wrong shelf.
test fn everything_the_shipping_library_refused_is_refused_here_by_the_matching_arm() -> Bool {
  let disagreements = fold(
    crypt_library_verdicts(),
    init: 0,
    f: (counted, verdict) =>
      match verdict {
        LibraryRefused { setting: setting } =>
          match admin_password_hash_receipt(credential: seeded_handle, crypt_digest: setting) {
            ReceiptAccepted { receipt: _ } => counted + 1
            ReceiptRefused { cause: cause } =>
              match cause {
                SettingHoldsReservedCharacter { reserved: _ } => counted
                RoundsMalformed => counted
                // The library refused, so an acceptance-free pass is fine; a refusal by an UNRELATED arm means
                // this module and the library disagree about WHY, which is the drift this row exists to catch.
                _ => counted + 1
              }
          }
        LibraryAccepted { setting: _ } => counted
        LibraryAcceptedButNotAStoredHash { setting: _, gap: _ } => counted
      },
  )
  disagreements == 0
}

// THE ROWS, COUNTED BY ARM. Folds rather than literals copied into the assertion above, so the counts are
// re-derived from the ledger every time the sweep runs and cannot be edited into agreement with a changed row
// set. An arm nobody recognises contributes to no count, which the total check in the sweep catches.
fn accepted_row_count() -> Int {
  fold(
    crypt_library_verdicts(),
    init: 0,
    f: (counted, verdict) =>
      match verdict {
        LibraryAccepted { setting: _ } => counted + 1
        LibraryAcceptedButNotAStoredHash { setting: _, gap: _ } => counted
        LibraryRefused { setting: _ } => counted
      },
  )
}

fn stored_hash_gap_row_count() -> Int {
  fold(
    crypt_library_verdicts(),
    init: 0,
    f: (counted, verdict) =>
      match verdict {
        LibraryAccepted { setting: _ } => counted
        LibraryAcceptedButNotAStoredHash { setting: _, gap: _ } => counted + 1
        LibraryRefused { setting: _ } => counted
      },
  )
}

fn refused_row_count() -> Int {
  fold(
    crypt_library_verdicts(),
    init: 0,
    f: (counted, verdict) =>
      match verdict {
        LibraryAccepted { setting: _ } => counted
        LibraryAcceptedButNotAStoredHash { setting: _, gap: _ } => counted
        LibraryRefused { setting: _ } => counted + 1
      },
  )
}

// EVERY SETTING THE LIBRARY HASHED WITHOUT PRODUCING A STORED HASH MUST BE REFUSED HERE, BY THE GAP ARM THAT
// NAMES IT (review: merry-fox-82). This is the sweep the other two cannot do. A fold demanding agreement with
// every library success would force this module to accept "$6$rounds=1000$<86>", which the library really does
// hash — using the 86 characters as its SALT, so the stored entry could never reproduce a login. On those rows
// the library is not an oracle, and the closed middle arm is where that is recorded rather than argued. Each row
// must land on the refusal arm its gap names: a cost with no salt is refused as CostFormMissingSalt, not as a
// wrong-length digest, because "your cost form has no salt" is the sentence that fixes the generator.
test fn every_setting_the_library_hashed_without_a_stored_hash_is_refused_by_its_gap_arm() -> Bool {
  let disagreements = fold(
    crypt_library_verdicts(),
    init: 0,
    f: (counted, verdict) =>
      match verdict {
        LibraryAccepted { setting: _ } => counted
        LibraryRefused { setting: _ } => counted
        LibraryAcceptedButNotAStoredHash { setting: setting, gap: gap } =>
          match admin_password_hash_receipt(credential: seeded_handle, crypt_digest: setting) {
            // Accepted by us where the library hashed it: that agreement IS the defect this row keeps visible, so
            // it counts as a disagreement rather than as a pass.
            ReceiptAccepted { receipt: _ } => counted + 1
            ReceiptRefused { cause: cause } =>
              match gap {
                GapCostFormMissingSalt { fields_seen: _ } =>
                  match cause {
                    CostFormMissingSalt { fields_seen: _ } => counted
                    _ => counted + 1
                  }
                GapUnaccountedFieldBeforeSalt { fields_seen: _ } =>
                  match cause {
                    UnaccountedFieldBeforeSalt { fields_seen: _ } => counted
                    _ => counted + 1
                  }
              }
          }
      },
  )
  // The count is asserted here as well as in the accepted sweep: a fold over a middle arm that has been emptied
  // reports zero disagreements while proving nothing.
  disagreements == 0 && stored_hash_gap_row_count() == 4
}

// TWO FULLY ANSWERED tzdata SEEDS THAT DIFFER ONLY IN THE VALUE, not in which questions were asked (review:
// merry-fox-82). The previous "an admitted answer moves the digest" control swapped Postfix for tzdata, which
// changes the package SET and so proves almost nothing — and its second arm reached an UnclassifiedPackage
// diagnostic the builder refuses, so the comparison it thought it was making never ran. Here both seeds carry the
// same package, the same two keys, the same types and the same number of records; only New_York vs Los_Angeles
// differs, and BOTH seeds are admitted (both build). An answer that is not in the identity is caught by this row
// going red, and it cannot be dodged by a refusal on either side.
data los_angeles_tzdata_packages: List<PackageIntent> = [
  QuestionAnswered {
    package: OpenSshServerPackage,
      answers: debconf_answer_for(
        package: OpenSshServerPackage,
        kind: AnswerBoolean,
        label: "openssh-server/password-authentication" as NonEmptyStr,
        value: "false" as NonEmptyStr,
      ),
  },
  QuestionAnswered {
    package: TzdataPackage,
    answers: list_append(left: debconf_answer_for(
      package: TzdataPackage,
      kind: AnswerSelect,
      label: "tzdata/Areas" as NonEmptyStr,
      value: "America" as NonEmptyStr,
    ),
      right: debconf_answer_for(
        package: TzdataPackage,
        kind: AnswerSelect,
        label: "tzdata/Zones/America" as NonEmptyStr,
        value: "Los_Angeles" as NonEmptyStr,
      )),
  },
]

test fn an_admitted_answer_value_moves_the_seed_digest_without_moving_admission() -> Bool {
  match build_seed_fixture(
    network: network_posture,
    packages: answered_tzdata_packages,
    entry_keys: one_key,
    console: locked_console,
    credential: seeded_handle,
    delivery: virtual_media_strategy,
    target: target_altra,
  ) {
    // BOTH SEEDS MUST BE BUILT, not one built and one refused: a comparison against a refusal is not a
    // comparison of two admitted configurations.
    Absent => false
    Present { value: york } =>
      match build_seed_fixture(
        network: network_posture,
        packages: los_angeles_tzdata_packages,
        entry_keys: one_key,
        console: locked_console,
        credential: seeded_handle,
        delivery: virtual_media_strategy,
        target: target_altra,
      ) {
        Absent => false
        Present { value: la } =>
          !content_hash_eq_structural(
            left: altra_autoinstall_seed_digest(seed: york),
            right: altra_autoinstall_seed_digest(seed: la),
          )
      }
  }
}

// THE BINDING OF A GIVEN PACKAGE SET, for the pairing witnesses: same unit, attempt, selector and population as
// built_seed_and_binding, only the packages vary — so two seeds bound through here differ in exactly what their
// package intents make differ, and nothing else. A Refused bind is Absent (never a stand-in digest), so a caller
// that compares two bindings can never be comparing one real one against an invented one.
fn binding_with_packages(packages: List<PackageIntent>) -> Optional<AltraAutoinstallSeedBinding> {
  match build_seed_fixture(
    network: network_posture,
    packages: packages,
    entry_keys: one_key,
    console: locked_console,
    credential: seeded_handle,
    delivery: virtual_media_strategy,
    target: target_altra,
  ) {
    Absent => Absent
    Present { value: seed } =>
      match bind_altra_autoinstall_seed(
        seed: seed,
        target: target_altra,
        unit_key: unit_a_key,
        attempt: attempt_one,
        selection: select_target_disk(selector: serial_selector, observed: bay_population),
      ) {
        Bound { binding: binding } => Present { value: binding }
        BindRefused { blocker: _ } => Absent
      }
  }
}

// THE ANSWER-PAIRING WITNESS — THE SERVED PRESEED IS COVERED BY THE BINDING ADDRESS, NOT DECORATION ON IT (review:
// merry-fox-82, HOLD sections 1 and 5; the module's binding_digest comment names THIS row as the one that goes RED
// if the "preseed" term inside served_bundle_digest is deleted, so the comment is only honest if the row exists).
// Two seeds that are the SAME unit, attempt, disk, credential and delivery, differing only in the VALUE of one
// debconf answer (America/New_York vs America/Los_Angeles — same package, same label, same answer kind). The
// autoinstall user-data document carries NO debconf field (its fields are identity, locale, keyboard, the ssh
// bool and the storage marker), so the document digest is PROVABLY EQUAL across the pair; the answer value lives
// only in the served preseed file, and so it can move the bundle digest and the binding address through no other
// route. That isolates the preseed term: delete it from served_bundle_digest and bundle_digest/document_digest/
// binding_digest all become equal across the pair, and the two NOT-equal claims below go RED. (The document term
// of the same fold has its own separate discriminator, the vault-read row; each sub-term is severable only by its
// own witness, which is why this is a distinct test rather than a second assertion in that one.)
test fn a_changed_answer_value_moves_the_served_bundle_and_address_without_moving_the_document() -> Bool {
  match binding_with_packages(packages: answered_tzdata_packages) {
    Absent => false
    Present { value: york } =>
      match binding_with_packages(packages: los_angeles_tzdata_packages) {
        Absent => false
        Present { value: la } =>
          // THE DOCUMENT IS THE SAME: the user-data half cannot see the answer, so the only thing that can move
          // the bundle digest is the preseed half. If this equality ever fails, the document has begun to fold
          // answers and the preseed term stops being the sole differentiator — which this row would then have to
          // say so about, not silently pass.
          content_hash_eq_structural(
            left: york.document_digest,
            right: la.document_digest,
          )
            // THE PRESEED DIFFERS, so the bundle's combined digest moves with it.
            && !content_hash_eq_structural(
              left: york.served.bundle_digest,
              right: la.served.bundle_digest,
            )
            // AND THE ADDRESS MOVED WITH THE BUNDLE — the claim that makes the preseed term load-bearing rather
            // than decoration. Delete the preseed term from served_bundle_digest and this row reddens.
            && !content_hash_eq_structural(
              left: binding_digest(binding: york),
              right: binding_digest(binding: la),
            )
      }
  }
}

// THE ANSWER TEXT THAT LOOKS LIKE AN ANSWER BUT IS A COMMENT, AND THE AREA/ZONE JOIN THAT DOES NOT LINE UP
// (review: merry-fox-82). Both are refusals through the PUBLIC producer, and they are the two ways a substring
// audit was fooled before this round. The first is `# tzdata/Areas tzdata/Zones/` — every required key name
// appears in it, and debconf's own reader drops the whole line as a comment, so nothing is established and the
// installer would stop on tzdata's first question with nobody at the panel. The second selects Etc while the only
// zone record is under America: the key the area record BUILDS is tzdata/Zones/Etc, no record carries it, and a
// substring check on "tzdata/Zones/" passed it. Both are decided by established_answer_from and
// first_unestablished in gunbc.provisioning.altra_autoinstall_seed, and both are asserted here through the public
// producer rather than against those helpers directly, so a change that removes the helpers from the producer's
// path reddens these rows instead of leaving them green over dead code.
data comment_only_tzdata_packages: List<PackageIntent> = [
  QuestionAnswered {
    package: OpenSshServerPackage,
      answers: debconf_answer_for(
        package: OpenSshServerPackage,
        kind: AnswerBoolean,
        label: "openssh-server/password-authentication" as NonEmptyStr,
        value: "false" as NonEmptyStr,
      ),
  },
  QuestionAnswered {
    package: TzdataPackage,
    // ONLY THE AREA RECORD. THE ZONE RECORD IS DELIBERATELY MISSING, and what it replaces is the line that used
    // to close this audit by subterfuge: under the old tokenizer, a line COMMENTING a zone template — "# tzdata
    // tzdata/Zones/America select New_York" — was matched by substring and certified the question answered while
    // debconf's own reader drops comment lines and the package asks the question anyway. With records there is no
    // text for that comment to live in, so the omission is the whole test: the audit asks for the key the area
    // builds (tzdata/Zones/America), finds no record carrying it, and refuses the seed.
    answers: debconf_answer_for(
      package: TzdataPackage,
      kind: AnswerSelect,
      label: "tzdata/Areas" as NonEmptyStr,
      value: "America" as NonEmptyStr,
    ),
  },
]

data mismatched_area_tzdata_packages: List<PackageIntent> = [
  QuestionAnswered {
    package: OpenSshServerPackage,
      answers: debconf_answer_for(
        package: OpenSshServerPackage,
        kind: AnswerBoolean,
        label: "openssh-server/password-authentication" as NonEmptyStr,
        value: "false" as NonEmptyStr,
      ),
  },
  QuestionAnswered { package: TzdataPackage, answers: mismatched_area_records() },
]

// THE SEEDED TEXT BEHIND THE AREA/ZONE REFUSAL, IN ONE PLACE. The refusal row and the row that pins which key
// the audit looks for both read this, so the two claims cannot drift apart. It used to be typed twice, and the
// second copy carried a two-character escape the lexer does not expand — so the key claim was made about a
// string that was never two records, and it passed by accident. One spelling, one truth.
fn mismatched_area_records() -> List<DebconfSelectionRecord> {
  list_append(left: debconf_answer_for(
    package: TzdataPackage,
    kind: AnswerSelect,
    label: "tzdata/Areas" as NonEmptyStr,
    value: "Etc" as NonEmptyStr,
  ),
      right: debconf_answer_for(
      package: TzdataPackage,
      kind: AnswerSelect,
      label: "tzdata/Zones/America" as NonEmptyStr,
      value: "New_York" as NonEmptyStr,
    ))
}

// THE OWNER FIELD IS THE ANSWER'S OTHER HALF (mutation: a scan that ignores the owner). "tzdata tzdata/Areas
// select America" written by the WRONG owner must close nothing. The line is otherwise perfectly shaped — four
// fields, a value, the right label — so only the name in the first position separates it from an answer, which
// is exactly the property a scan that matched only label+value would throw away.
test fn an_answer_record_written_by_another_package_closes_nothing_and_the_seed_is_refused() -> Bool {
  match admit_admin_access_authorisation(authorised_keys: one_key, console_entry: locked_console) {
    Present { value: entry } =>
      match audit_altra_autoinstall_seed(
        network: network_posture,
        install_packages: impersonated_tzdata_packages,
        late_packages: [],
        locale: EnUsUtf8,
        entry: entry,
        strategy: virtual_media_strategy,
      ) {
        SeedIsNonInteractive { evidence: _ } => false
        SeedRefused { cause: PackagePrompts { name: named, question: _ } } =>
          named == known_prompting_package_name(package: TzdataPackage)
        SeedRefused { cause: _ } => false
      }
    Absent => false
  }
}

// EVERY REQUIRED KEY IS PRESENT UNDER THE RIGHT LABELS — but claimed by openssh-server, which is not tzdata.
data impersonated_tzdata_packages: List<PackageIntent> = [
  QuestionAnswered {
    package: TzdataPackage,
    // THE OWNER IS openssh-server, NOT tzdata — and it has to be spelled through the generic mint for exactly
    // that reason. debconf_answer_for derives the owner from the package the arm names, which is right for every
    // honest fixture and useless for this one: the point here is a well-shaped record, with the right label and
    // the right value, claimed by a package that does not own the question. Only the first field separates it
    // from an answer, which is the property a scan matching label+value alone would throw away.
    answers: list_append(left: debconf_answer(
      owner: "openssh-server" as NonEmptyStr,
      kind: AnswerSelect,
      label: "tzdata/Areas" as NonEmptyStr,
      value: "America" as NonEmptyStr,
    ),
      right: debconf_answer(
        owner: "openssh-server" as NonEmptyStr,
        kind: AnswerSelect,
        label: "tzdata/Zones/America" as NonEmptyStr,
        value: "New_York" as NonEmptyStr,
      )),
  },
]

test fn a_comment_naming_every_question_is_not_an_answer_and_the_seed_is_refused() -> Bool {
  match build_seed_fixture(
    network: network_posture,
    packages: comment_only_tzdata_packages,
    entry_keys: one_key,
    console: locked_console,
    credential: seeded_handle,
    delivery: virtual_media_strategy,
    target: target_altra,
  ) {
    // REFUSED, through the public producer — not merely reported by a helper the producer never calls.
    Absent => true
    Present { value: built } => false
  }
}

test fn an_area_and_a_zone_that_do_not_join_are_refused_and_the_zone_key_names_the_join() -> Bool {
  let refused = match build_seed_fixture(
    network: network_posture,
    packages: mismatched_area_tzdata_packages,
    entry_keys: one_key,
    console: locked_console,
    credential: seeded_handle,
    delivery: virtual_media_strategy,
    target: target_altra,
  ) {
    Absent => true
    Present { value: built } => false
  }
  // THE JOIN IS CHECKED AGAINST THE AREA THE SEED CHOSE, not against some zone the file happens to mention.
  // established_zone_key reads the area record and builds the key itself, so this pins which key the audit looks
  // for: Etc's answer must be looked up as tzdata/Zones/Etc.
  let key = established_zone_key(
    // THE SAME RECORDS the refusal above is about, read through the shared fixture rather than re-typed: this
    // file re-typed the pair once before, and the copy drifted. One fixture, one spelling, no drift between the
    // two claims.
    answers: mismatched_area_records(),
    owner: known_prompting_package_name(package: TzdataPackage),
  )
  match key {
    Absent => false
    Present { value: built } => refused && built == "tzdata/Zones/Etc" as NonEmptyStr
  }
}

// WHERE THE OBSERVED BYTES WERE FETCHED FROM. One closed authority record, built the same way every other
// externally-sourced fact in this module is built: a specific artifact at a specific address, so a later reader
// can go and look. Not the archive's own URL — this is the delivery source the seed's strategy names, and the
// boot observation must name the place the bytes actually came from.
fn archive_authority() -> ExternalAuthority {
  ExternalAuthority {
    uri: Uri {
      scheme: Https
      locator: "ports.ubuntu.com/ubuntu-ports/dists/noble/main/binary-arm64/Packages.gz"
    }
  }
}

// WHAT THE MEASUREMENT OWES, STATED RATHER THAN IMPLIED. The row's `owed` field is the honest boundary of the
// whole shelf: *0 is libxcrypt's matches-nothing marker, so a probe can establish THAT the library refused and
// not WHY — reserved-character and malformed-cost both arrive as the same refusal. A future reader must be able to
// see that limit from the data, or the refusals above will be read as a specification of the library's grammar.
test fn the_measurement_states_the_cause_it_could_not_observe() -> Bool {
  match crypt_library_acceptance.owed {
    Absent => false
    Present { value: owed } => owed.contains("*0") && owed.contains("errno=22")
  }
}

// THE VAULT-READ DISCRIMINATOR — THE WITNESS THAT THE ADDRESS COVERS THE SERVED BYTES, NOT JUST THE CONFIGURATION
// (review: merry-fox-82, HOLD sections 1 and 5; the module's binding_digest comment names THIS row as the one that
// goes RED if the "bundle" term is deleted, so the comment is only honest if the row exists). TWO SEEDS THAT ARE
// THE SAME CONFIGURATION IN EVERY AXIS THE SEED DIGEST FOLDS — same handle, same packages, same disk, same
// delivery — differing only in WHICH VALID SECRET THE VAULT HANDED BACK: two format-admitted sha512-crypt digests
// under the one handle. credential_diagnostic covers the handle's locator and version only, and the render takes
// the posture, not the read, so seed_digest and seed_rendering are PROVABLY equal across the pair; the served
// document carries the digest (password_field_from returns issued.crypt_digest), so the bundle digest and the
// binding address differ. Delete the bundle term from binding_digest and the last claim goes RED — that is the
// severance this row exists to make observable. If the alternate digest stopped passing the format door the row
// fails at its own control rather than passing vacuously.
// One character differs from rig_credential_digest (the 'd' at body index 40 is 'Z'); every character is in the
// libxcrypt base-64 alphabet "./A-Za-z0-9", so it passes the same format door the rig digest passes and the row
// below is a real comparison, not one that fails at its own control.
data alternate_rig_credential_digest: String = "$6$saltsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6Zy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj."

fn binding_of_a_read(read: Optional<AdminPasswordHashReceipt>) -> Optional<AltraAutoinstallSeedBinding> {
  match build_seed_fixture_with_read(read: read, credential: seeded_handle) {
    Absent => Absent
    Present { value: seed } =>
      match bind_altra_autoinstall_seed( seed: seed, target: target_altra, unit_key: unit_a_key, attempt: attempt_one, selection: select_target_disk(selector: serial_selector, observed: bay_population),
        ) {
        Bound { binding: binding } => Present { value: binding }
        BindRefused { blocker: _ } => Absent
      }
  }
}

test fn a_second_valid_vault_read_moves_the_address_without_moving_the_configuration() -> Bool {
  match admin_password_hash_receipt(credential: seeded_handle, crypt_digest: alternate_rig_credential_digest as NonEmptyStr) {
    // THE CONTROL FIRST: if the alternate digest were not admissible the comparison below would compare a real
    // binding against nothing, and a vacuous pass is exactly what this programme refuses.
    ReceiptRefused { cause: _ } => false
    ReceiptAccepted { receipt: alternate } =>
      match binding_of_a_read(read: password_read_for(credential: seeded_handle)) {
        Absent => false
        Present { value: rig } =>
          match binding_of_a_read(read: Present { value: alternate }) {
            Absent => false
            Present { value: other } =>
              // SAME CONFIGURATION: the axes the seed digest folds cannot see the read.
              content_hash_eq_structural( left: rig.seed_digest, right: other.seed_digest )
                // SAME RENDERING: the document identity the address carries internally is equal too, so the
                // ONLY differentiator left is the served bundle's own digest.
                && (rig.seed_rendering as String) == (other.seed_rendering as String)
                // THE SERVED BYTES DIFFER — both halves, because the password field is one of them.
                && !content_hash_eq_structural( left: rig.served.bundle_digest, right: other.served.bundle_digest )
                && !content_hash_eq_structural( left: rig.document_digest, right: other.document_digest )
                // AND THE ADDRESS MOVED WITH THEM. This is the claim the bundle term in binding_digest carries;
                // delete that term and this is the row that reddens.
                && !content_hash_eq_structural( left: binding_digest(binding: rig), right: binding_digest(binding: other) )
          }
      }
  }
}

// THE RENDERER IS THE ONE THE PROGRAMME SHIPS. The seed renders through
// gunbc.os_install_emit::autoinstall_user_data — the same writer that lays out cloud-init's lateconfig — and this
// calls THAT function again from the other side, on the payload read OUT OF the built document rather than passed
// in from outside. Two independent failures trip it: bytes produced by anything else differ from the emitter's
// re-derivation, and a document whose payload and body disagree differ too. It is not a second copy of the
// render's rules (DESIGN §5) because it invokes the emitter's own function instead of restating its layout, and
// this file carries no YAML of its own.
fn document_body_is_the_emitters_own(payload: UbuntuAutoinstallPayload, body: NonEmptyStr) -> Bool {
  match autoinstall_user_data(payload: payload) {
    AutoinstallUserDataRefused { reason: _ } => false
    AutoinstallUserDataRendered { content: emitted } => (emitted as String) == (body as String)
  }
}

// ============================================================ THE RENDERED DOCUMENT AND WHAT THE BOARD BOOTED
//
// THE BINDING'S DOCUMENT DIGEST IS THE DIGEST OF THE RENDERER'S OWN BYTES, AND NOTHING ELSE CAN BE THE SOURCE
// (review: merry-fox-82, HOLD section 1). This module used to hash its own seed_rendering and report it as the
// thing the board booted, which made "what did this machine boot?" answerable from a summary the module wrote for
// itself — a memory, not evidence. Now the digest the binding carries is taken over the content that
// gunbc.os_install_emit::autoinstall_user_data produced, so this row goes RED the moment anyone disconnects the
// binding from the real renderer: point the digest back at the internal rendering, or at a fixture string, and the
// two digests stop agreeing. It is the connection, not the number, that is being asserted.
// THE BINDING'S document_digest MUST BE EXACTLY THE RENDERER'S OWN SHA-256 OVER THESE BYTES. The digest fn now
// returns `Absent` when the host hands back no hex (no fabricated stand-in — review 83764 #1), and this is where
// that honesty is checked: if the digest ever came back `Absent` the binding would have carried a value it could
// not derive, so the comparison is false and the row goes RED. A witness that re-hashed the content itself could
// never see that fault; this one reads the module's own digest back out.
fn document_digest_matches_content(binding_digest: Fnv1a64Structural, content: NonEmptyStr) -> Bool {
  match rendered_document_digest(content: content) {
    Absent => false
    Present { value: digest } => content_hash_eq_structural(left: binding_digest, right: digest)
  }
}

test fn the_binding_digests_the_bytes_the_renderer_produced_not_a_summary_of_its_own() -> Bool {
  match built_seed_and_binding() {
    Absent => false
    Present { value: pair } =>
      match seed_document(seed: pair.seed) {
        DocumentRefused { reason: _ } => false
        DocumentBuilt { payload: payload, content: content } =>
          // THE RENDERER IS REACHED, AND WHAT IT RETURNS LOOKS LIKE ITS OUTPUT. These markers are spelled by
          // gunbc.os_install_emit and nowhere else in this module: the header line and the autoinstall mapping key
          // prove the content came out of the real cloud-config writer rather than from this file's expectations,
          // and the identity's username and the ssh allow-password line are entries only that writer lays out.
          content.contains("#cloud-config")
            && content.contains("autoinstall")
            && content.contains("gunbc-admin")
            && content.contains("allow-pw")
            // THE CREDENTIAL THAT WAS READ IS IN THE BYTES, and the placeholder that would fill its absence is not.
            && content.contains(rig_credential_digest)
            && !content.contains("changeme")
            // (2) THE DIGEST ON THE BINDING IS THE ONE COMPUTED OVER THESE BYTES, by the renderer's own digest
            //     fn rather than by a witness-side re-hash of a string this file already holds: swapping the
            //     module's hash for a hash of any fixed string still equals a witness that hashes that same
            //     fixed string, which is how this claim used to be satisfied while proving nothing.
            && document_digest_matches_content(binding_digest: pair.binding.document_digest, content: content)
            // (3) THOSE BYTES ARE THE SHIPPED EMITTER'S OWN, recomputed from the payload READ OUT OF THE
            //     DOCUMENT. A hand-built string with the right header and the right keys above passes every
            //     marker before this line and cannot pass this one (review: merry-fox-82, HOLD section 1).
            && document_body_is_the_emitters_own(payload: payload, body: content)
      }
  }
}

// A HANDLE WHOSE VAULT READ FAILED PRODUCES NO DOCUMENT AND NO BINDING, BY NAME (review: merry-fox-82). The seed
// is still buildable — "the vault is down" is not "this seed is bad" — but nothing may be served, and the reason
// is reported as its own blocker rather than as a refusal to build or as a document with a hole in it. Before
// this, a handle with no read reached the payload with a placeholder hash and the witness compared placeholders.
test fn a_handle_with_no_read_builds_but_never_renders_and_never_binds() -> Bool {
  match build_seed_fixture_with_read(read: password_read_absent(), credential: seeded_handle) {
    // Buildable: the seed exists so the refusal can be reported about it.
    Absent => false
    Present { value: seed } =>
      match seed_document(seed: seed) {
        DocumentBuilt { payload: _, content: _ } => false
        DocumentRefused { reason: _ } =>
          match bind_altra_autoinstall_seed(
            seed: seed,
            target: target_altra,
            unit_key: unit_a_key,
            attempt: attempt_one,
            selection: select_target_disk(selector: serial_selector, observed: bay_population),
          ) {
            Bound { binding: _ } => false
            BindRefused { blocker: blocker } =>
              match blocker {
                SeedHasNoRenderableDocument { reason: _ } => true
                _ => false
              }
          }
      }
  }
}

// THE SUPPLIED-DOCUMENT COMPARISON ANSWERS ABOUT RECORDS AND MAKES NO BOOT CLAIM (review: merry-fox-82, HOLD
// section 4, option (a)). Four arms, each reached through the public recording fn and the module's join:
//  * nothing supplied            -> NothingSupplied                        (never defaultable to the flattering arm)
//  * supplied bytes ARE this binding's promised bytes -> SuppliedBytesAreWhatThisBindingPromised
//  * supplied bytes are different                     -> SuppliedBytesAreNotWhatThisBindingPromised
//  * supplied record names another (unit, attempt)    -> SuppliedRecordIsNotAboutThisAttempt
// The digest compare lives in the module, not in this file, so no arm can be conjured here — and no arm's NAME
// claims that a boot happened, because this module never contacted a board. A future writer of the delivery
// seam joins its own transport report with this record; neither half alone is boot evidence.
test fn the_supplied_document_standing_is_answered_only_by_the_joined_record() -> Bool {
  match built_seed_and_binding() {
    Absent => false
    Present { value: pair } =>
      match seed_document(seed: pair.seed) {
        DocumentRefused { reason: _ } => false
        DocumentBuilt { payload: _, content: content } =>
          // (1) NOTHING SUPPLIED YET. A binding that agrees with its seed proves no bytes were ever fetched.
          match supplied_document_standing(binding: pair.binding, supplied: Absent) {
            NothingSupplied =>
              // (2) SOMEBODY SUPPLIED THE BYTES THIS BINDING PROMISED, for THIS attempt.
              match supplied_document_standing(
                binding: pair.binding,
                  supplied: record_supplied_served_document(
                    unit_key: unit_a_key,
                    attempt: attempt_one,
                    supplied_user_data: content,
                    supplied_preseed: pair.binding.served.preseed,
                    supplied_from: archive_authority(),
                  ),
              ) {
                SuppliedBytesAreWhatThisBindingPromised =>
                  // (3) SUPPLIED BYTES ARE DIFFERENT. Same recording path, different text: the answer must be
                  // the mismatch arm, not the flattering one and not "foreign".
                  match supplied_document_standing(
                    binding: pair.binding,
                      supplied: record_supplied_served_document(
                        unit_key: unit_a_key,
                        attempt: attempt_one,
                        supplied_user_data: "#cloud-config\nautoinstall:\n  version: 1\n" as NonEmptyStr,
                        supplied_preseed: pair.binding.served.preseed,
                        supplied_from: archive_authority(),
                      ),
                  ) {
                    SuppliedBytesAreNotWhatThisBindingPromised =>
                      // (4) A RECORD FOR ANOTHER ATTEMPT CANNOT SPEAK ABOUT THIS ONE — even when the bytes are
                      // the right bytes (merry: "The same observation can also be applied to another unit's
                      // binding with the same document digest"). The identity join runs BEFORE the digest
                      // compare, so the answer is foreign, never promised.
                      match supplied_document_standing(
                        binding: pair.binding,
                          supplied: record_supplied_served_document(
                            unit_key: unit_a_key,
                            attempt: attempt_two,
                            supplied_user_data: content,
                            supplied_preseed: pair.binding.served.preseed,
                            supplied_from: archive_authority(),
                          ),
                      ) {
                        SuppliedRecordIsNotAboutThisAttempt =>
                          // AND THE IDENTITY JOIN IS NOT THE BYTE COMPARE: a foreign record whose bytes are
                          // wrong is STILL foreign — it never gets to answer about bytes it cannot own.
                          match supplied_document_standing(
                            binding: pair.binding,
                              supplied: record_supplied_served_document(
                                unit_key: unit_b_key,
                                attempt: attempt_one,
                                supplied_user_data: "#cloud-config\nautoinstall:\n  version: 1\n" as NonEmptyStr,
                                supplied_preseed: pair.binding.served.preseed,
                                supplied_from: archive_authority(),
                              ),
                          ) {
                            SuppliedRecordIsNotAboutThisAttempt => true
                            _ => false
                          }
                        _ => false
                      }
                    _ => false
                  }
                _ => false
              }
            _ => false
          }
      }
  }
}

// THE SUPPLIED RECORD CARRIES WHO SUPPLIED IT. A digest with no source is a number, and a number cannot be
// audited later; the record's evidence includes where the bytes came from, in the same closed shape every other
// externally-sourced fact in this programme uses.
test fn a_supplied_served_document_names_where_the_bytes_came_from() -> Bool {
  match record_supplied_served_document(
    unit_key: unit_a_key,
    attempt: attempt_one,
    supplied_user_data: "#cloud-config\n" as NonEmptyStr,
    supplied_preseed: NoDebconfQuestionsToAnswer,
    supplied_from: archive_authority(),
  ) {
    Absent => false
    Present { value: record } =>
      match (record.supplied_from.uri.locator as String).contains("ports.ubuntu.com") {
        True => true
        False => false
      }
  }
}

// THE SILENCE RECEIPT NAMES THE PACKAGE IT SILENCES, SO IT CANNOT BE MOVED (review: merry-fox-82, HOLD section
// 5). A receipt that recorded only "someone audited a preseed" can be pasted onto any package and the verdict
// stays green, which is how an unverified package ends up looking verified on a board nobody is standing at. The
// package identity is inside the receipt, and the verdict reads it back out.
test fn a_verified_silence_carries_the_package_it_was_observed_about() -> Bool {
  match package_prompting_verdict(intent: PackageVerifiedSilent { silence: nvme_cli_silence_receipt }) {
    NothingToAsk { name: name, silence: silence } =>
      // THE NAME IN THE VERDICT IS THE NAME IN THE RECEIPT — read out of the evidence, not re-spelled beside it —
      // and it is the package this row is about, not merely some plausible string.
      name == silenced_package(receipt: silence) && name == "nvme-cli" as NonEmptyStr
    ClosedQuestion { name: _, question: _ } => false
    OpenQuestion { name: _, question: _ } => false
    UnclassifiedPrompting { name: _ } => false
  }
}

// AND THE PACKAGE NAME IN THE RECEIPT IS THE PACKAGE BEING SILENCED, not a label the author liked: a different
// package's name in the same receipt would make the row above false, and the two receipts differ in that field
// alone. This is what stops the four silent rows from being four copies of one receipt.
test fn silence_receipts_do_not_interchange_across_packages() -> Bool {
  match silenced_package(receipt: nvme_cli_silence_receipt) {
    nvme_name =>
      match silenced_package(receipt: ipmitool_silence_receipt) {
        ipmi_name =>
          // TWO DIFFERENT NAMES IN TWO RECEIPTS that look interchangeable otherwise: same standing, same
          // shape, same module. If the package field were ever dropped from the receipt, both readers would
          // return the same string and this row would go red rather than bless a copy-paste.
          nvme_name != ipmi_name && nvme_name != "ipmitool" as NonEmptyStr
      }
  }
}

// THE SELECTOR IDENTITY IS COMPARED FIELD BY FIELD, NOT OVER AN UNFRAMED DIAGNOSTIC (review: merry-fox-82, HOLD
// section 2). The old compare hashed a string assembled by gluing free-form values with separators, so two
// different selectors could hash alike when a value happened to contain the separator. Fields are compared here,
// and the rendered identity is framed with a labelled character count, so the rendering can no longer collide
// either — the pair below is the pair that used to collide in the disk-identity case.
test fn two_selectors_that_differ_only_inside_a_value_are_not_the_same_selector() -> Bool {
  let glued_looking_one = ByCatalogIdentity {
    part_number: "MOON-512|capacity=512" as NonEmptyStr,
    capacity_bytes: byte_size(1099511627776),
  }
  let glued_looking_two = ByCatalogIdentity {
    part_number: "MOON-512" as NonEmptyStr,
    capacity_bytes: byte_size(549755813888),
  }
  // NOT THE SAME SELECTOR, under either the field compare or the framed identity.
  !selectors_are_the_same(a: glued_looking_one, b: glued_looking_two)
    && !content_hash_eq_structural(
      left: content_hash_atom(value: configuration_identity_of_selector(selector: glued_looking_one)),
      right: content_hash_atom(value: configuration_identity_of_selector(selector: glued_looking_two)),
    )
}

// ===========================================================================
// THE DEBCONF SHELF: THE RECORD IS THE TRUTH AND THE LINE IS DERIVED FROM IT
// (review 83132). The seed AUTHORS its answers, so the tokenizer this module used to carry existed only to
// recover parts the module already knew — and it is where the comment-line trap lived, because text can
// mention a question that no answer answered. These rows hold the two properties the replacement owes: the
// wire spelling is DERIVED from the semantic arms rather than stored beside them (so it can never go stale,
// which is the failure the sibling libxcrypt shelf actually had), and an answer that could not survive the
// trip to the installer is unauthorizable rather than mis-rendered.
// ===========================================================================

// THE DERIVED LINE IS THE CANONICAL FOUR-FIELD FORM. Upstream's reader is
// /^\s*(\S+)\s+(\S+)\s+(\S+)(?:\s(.*))?/ (debconf-set-selections, debconf 1.5.86ubuntu1, line 132):
// owner, label, type, then the content to the end of the line. This is the row that makes the derivation
// load-bearing — drop a separator and the string differs; store the kind word beside the arm instead of
// deriving it and it goes stale exactly the way the sibling shelf's alphabet list did.
test fn a_record_renders_the_canonical_four_field_line() -> Bool {
  match debconf_answer_record(
    owner: "tzdata" as NonEmptyStr,
    label: "tzdata/Areas" as NonEmptyStr,
    kind: AnswerSelect,
    value: "America" as NonEmptyStr,
  ) {
    RefusedAtTheMint { cause: _ } => false
    MintedSelection { record: record } =>
      (debconf_selection_line(record: record) as String) == "tzdata tzdata/Areas select America"
  }
}

// THE VALUE'S OWN WHITESPACE SURVIVES VERBATIM and only the three separators are added. "English (US)" is a
// real answer whose value contains a space, and the regex's last group is (.*) precisely so the tail is taken
// as-is. A derivation that re-split or re-joined the value would change what the installer selects while
// leaving every field accessor untouched — the record/rendering seam is exactly where that class of bug
// lives, so the separator COUNT is asserted, not merely the shape.
test fn a_value_with_spaces_renders_with_exactly_three_separators() -> Bool {
  match debconf_answer_record(
    owner: "keyboard-configuration" as NonEmptyStr,
    label: "keyboard-configuration/layout" as NonEmptyStr,
    kind: AnswerSelect,
    value: "English (US)" as NonEmptyStr,
  ) {
    RefusedAtTheMint { cause: _ } => false
    MintedSelection { record: record } =>
      match (debconf_selection_line(record: record) as String) {
        line =>
          line == "keyboard-configuration keyboard-configuration/layout select English (US)"
            // THREE SEPARATORS ADDED, ONE SPACE PRESERVED. The value carries a space of its own, so a count of
            // four is the only number that is simultaneously "the derivation added exactly three" and "nothing
            // was stripped from the value". Three would mean the value lost its space; five would mean the
            // derivation added a separator somewhere.
            && count_character(text: line, character: " ", seen: 0) == 4
      }
  }
}

// SPACES, COUNTED ONE CHARACTER AT A TIME. The language exposes no character indexing for a String, so the
// count walks substrings; it is written here rather than imported because the number it checks is this row's
// own claim about how many separators a derived line may contain.
fn count_character(text: String, character: String, seen: Int) -> Int {
  match text.length() {
    0 => seen
    _ =>
      match text.substring(start: 0, end: 1) == character {
        True => count_character(text: text.substring(start: 1, end: text.length()), character: character, seen: seen + 1)
        False => count_character(text: text.substring(start: 1, end: text.length()), character: character, seen: seen)
      }
  }
}

// THE NINE DERIVED SPELLINGS ARE EXACTLY UPSTREAM'S WORDS, IN ORDER. The list on the shelf is the citation of
// `my @knowntypes = qw(select boolean string multiselect note password text title);` together with `my
// @knownflags = qw(seen);`; this row is the equation between that citation and the union's arms. An arm added
// without its word, or a word whose spelling drifted, fails here — the only defence against the drift review
// caught in the sibling shelf, where a stored list disagreed with the rule printed beside it.
// EVERY LEGAL TYPE WORD IS DERIVED, AND THE EXPECTED WORDS LIVE HERE RATHER THAN ON THE SHELF. Upstream keeps
// them in two lists — `my @knowntypes = qw(select boolean string multiselect note password text title);` and
// `my @knownflags = qw(seen);` (debconf-set-selections 77-78) — and this row's own copy of those two lists is the
// transcription: the expected value of the check that notices drift. Production holds none of them; the shelf
// derives every word from an arm (review 83188 deleted the stored list this row used to compare against, because
// a stored copy of a word is exactly the thing that goes stale, and a comment asserting a sweep of it is not the
// sweep). Order matters as well as content: @knowntypes' order is the order upstream's `grep { $_ eq $type }`
// scans, so a permutation would show up here even though every word is individually right.
test fn every_answer_kind_spells_itself_the_word_upstream_accepts() -> Bool {
  let derived = [
    debconf_selection_kind_spelling(kind: Answered { kind: AnswerSelect }),
    debconf_selection_kind_spelling(kind: Answered { kind: AnswerBoolean }),
    debconf_selection_kind_spelling(kind: Answered { kind: AnswerString }),
    debconf_selection_kind_spelling(kind: Answered { kind: AnswerMultiselect }),
    debconf_selection_kind_spelling(kind: Answered { kind: AnswerNote }),
    debconf_selection_kind_spelling(kind: Answered { kind: AnswerPassword }),
    debconf_selection_kind_spelling(kind: Answered { kind: AnswerText }),
    debconf_selection_kind_spelling(kind: Answered { kind: AnswerTitle }),
    debconf_selection_kind_spelling(kind: Flagged { flag: SeenFlag }),
  ]
  let upstream = [
    "select" as NonEmptyStr,
    "boolean" as NonEmptyStr,
    "string" as NonEmptyStr,
    "multiselect" as NonEmptyStr,
    "note" as NonEmptyStr,
    "password" as NonEmptyStr,
    "text" as NonEmptyStr,
    "title" as NonEmptyStr,
    "seen" as NonEmptyStr,
  ]
  match derived.length() == upstream.length() {
    False => false
    True => same_spelling_list(left: derived, right: upstream)
  }
}

// THE FLAG WORD COMES FROM THE FLAG SET AND CANNOT BE REACHED THROUGH THE ANSWER SPELLER, and vice versa. The
// two vocabularies being separate functions is what makes a flag that has drifted into the answer vocabulary a
// compile error rather than a legal-looking row; the single wire function exists only to delegate.
test fn the_flag_word_and_the_answer_words_are_separate_vocabularies() -> Bool {
  match (debconf_flag_spelling(flag: SeenFlag) as String) {
    word => word == "seen"
  }
}

// STRUCTURAL WALK, NOT AN INDEXED READ. Both sides are lists this shelf owns, so equality is settled by taking
// them apart. An index into either list would be a second, partial definition of what "the same list" means, and
// a length mismatch that outranks a word mismatch is exactly the kind of thing an indexed loop hides (an
// off-by-one simply stops early instead of failing).
fn same_spelling_list(left: List<NonEmptyStr>, right: List<NonEmptyStr>) -> Bool {
  match left {
    Empty =>
      match right {
        Empty => true
        Cons { head: _, tail: _ } => false
      }
    Cons { head: one, tail: rest } =>
      match right {
        Empty => false
        Cons { head: other, tail: tail } =>
          match (one as String) == (other as String) {
            False => false
            True => same_spelling_list(left: rest, right: tail)
          }
      }
  }
}

// THE FLAG IS LEGAL IN THE FIELD AND ANSWERS NOTHING, checked through the PUBLIC PRODUCER. Upstream routes
// `seen` to set_flag rather than load_answer (lines 136-144): it marks a question as already seen, a question that
// has to EXIST first. A seed that let a flag certify an answer would be hung by a package that still asks, on a
// board with nobody at the console.
//
// WHY THE FIXTURE COMES FROM THE SHELF AND NOT FROM THE SEED'S OWN ANSWER DOOR (review 83188). The seed's answer
// mint now takes a DebconfAnswerKind, so this row could not build a flag through it even if it wanted to — and
// asserting the refusal through a door that cannot name a flag would prove nothing about the audit. The record is
// therefore obtained the way any consumer that had received preseed text would obtain it, from the shelf, and
// handed to the audit directly. That is the claim that matters: whatever a record's provenance, a flag line is not
// credited. The shelf mints it because a legal line stays legal; the audit refuses it because an answer is a
// different set.
//
// THE ZONE RECORD IS SUPPLIED AS A REAL ANSWER ON PURPOSE, so the seed's fate hinges on the FLAG ALONE. A
// flag-only fixture would be refused whatever the audit does with the flag, because tzdata's second question is
// parametric on the first and there would be no zone record to satisfy it — the row would then be unable to tell
// "the flag closed no question" from "the parametric key closed nothing". With the zone answered, crediting the
// flag would complete BOTH requirements and the seed would render; refusing it leaves tzdata/Areas open. That is
// the difference this row measures.
// THE FIXTURE, AS A CONSUMER WOULD BUILD IT FROM RECEIVED TEXT: the flag minted on the shelf (the seed's own
// answer door cannot name a flag at all) and the zone answered through the seed's public mint. Two records, or
// fewer if a mint starts refusing a legal line — which the row below checks before it trusts the fixture.
fn flag_for_area_plus_answered_zone() -> List<DebconfSelectionRecord> {
  match debconf_flag_record(
    owner: "tzdata" as NonEmptyStr,
    label: "tzdata/Areas" as NonEmptyStr,
    flag: SeenFlag,
    value: "America" as NonEmptyStr,
  ) {
    RefusedAtTheMint { cause: _ } => []
    MintedSelection { record: flag_record } =>
      list_append(
        left: [flag_record],
        right: debconf_answer_for(
          package: TzdataPackage,
          kind: AnswerSelect,
          label: "tzdata/Zones/America" as NonEmptyStr,
          value: "New_York" as NonEmptyStr,
        ),
      )
  }
}

test fn a_seen_flag_closes_nothing_and_the_seed_is_refused_as_prompting() -> Bool {
  match flag_for_area_plus_answered_zone() {
    records =>
      match list_length(items: records) {
        // BOTH RECORDS MINTED: the flag is legal, so a refusal to mint it here would silently turn this row into a
        // test of a two-record seed with one record missing.
        2 =>
          match admit_admin_access_authorisation(authorised_keys: one_key, console_entry: locked_console) {
            Present { value: entry } =>
              match audit_altra_autoinstall_seed(
                network: network_posture,
                install_packages: [QuestionAnswered { package: TzdataPackage, answers: records }],
                late_packages: [],
                locale: EnUsUtf8,
                entry: entry,
                strategy: virtual_media_strategy,
              ) {
                SeedIsNonInteractive { evidence: _ } => false
                // THE QUESTION REPORTED IS tzdata/Areas — the flag's own label — and not the zone, so a future
                // reordering that refused on the parametric key instead would be visible here rather than silently
                // changing which question the operator is told about.
                SeedRefused { cause: PackagePrompts { name: named, question: asked } } =>
                  named == known_prompting_package_name(package: TzdataPackage)
                    && (asked as String).contains("tzdata/Areas")
                SeedRefused { cause: _ } => false
              }
            Absent => false
          }
        _ => false
      }
  }
}

// THE SPLIT IS IN THE TYPE, NOT IN A PREDICATE (review 83188). Three things are pinned here that a Bool over one
// union could not pin, and each fails for a different edit:
//   (a) a flag line MINTS and renders — its owner, label, derived word and value are all upstream's, so refusing
//       it at the mint would make a real preseed unrepresentable;
//   (b) the crediting PROJECTION hands back no answer kind for it, which is a type-level fact: the flag arm has no
//       DebconfAnswerKind to return, so no call site can credit it;
//   (c) EVERY answer arm does return one, so (b) is exactly one arm wide and not a projection that quietly
//       returns Absent for everything (which would satisfy the refusal row by making all seeds refuse).
// A future debconf answer type is an arm of DebconfAnswerKind and needs no edit to (c); a future flag is an arm of
// DebconfFlag and stays out by construction. Neither is a row somebody can forget to update.
test fn a_flag_mints_and_renders_while_the_answer_projection_skips_it() -> Bool {
  match debconf_flag_record(
    owner: "tzdata" as NonEmptyStr,
    label: "tzdata/Areas" as NonEmptyStr,
    flag: SeenFlag,
    value: "true" as NonEmptyStr,
  ) {
    RefusedAtTheMint { cause: _ } => false
    MintedSelection { record: flag_record } =>
      match (debconf_selection_line(record: flag_record) as String) {
        line =>
          match line == "tzdata tzdata/Areas seen true" {
            False => false
            True =>
              match debconf_selection_answer(record: flag_record) {
                Present { value: _ } => false
                Absent =>
                  match debconf_answer_record(
                    owner: "tzdata" as NonEmptyStr,
                    label: "tzdata/Areas" as NonEmptyStr,
                    kind: AnswerSelect,
                    value: "America" as NonEmptyStr,
                  ) {
                    RefusedAtTheMint { cause: _ } => false
                    MintedSelection { record: answer_record } =>
                      match debconf_selection_answer(record: answer_record) {
                        Absent => false
                        Present { value: credited } => credited == AnswerSelect
                      }
                  }
              }
          }
      }
  }
}

// A RECORD THAT COULD NOT SURVIVE THE TRIP IS NEVER WRITTEN, AND THE REFUSAL REACHES THE AUDIT (mutation:
// key_field_is_well_formed returning true unconditionally). Upstream splits the first three fields as (\S+)
// runs, so an owner carrying a space does not parse as that owner — it shifts every field after it, and the
// answer lands on a package nobody meant to configure while tzdata's own question stays live. The mint refusing
// it is half the claim; that a seed assembled from it is REFUSED AS PROMPTING is the half that matters,
// because collapsing an illegal record to no-records is only safe if no-records still means unanswered.
test fn an_answer_whose_owner_carries_a_space_closes_nothing_and_the_seed_is_refused() -> Bool {
  // THE MINT REFUSED IT FIRST, so the audit is being handed no records at all. Asserted separately from the
  // refusal below: an audit that credited an owner-mismatched record would still refuse THIS seed (its own
  // owner is "tzdata extra", which never matches tzdata's question), so the refusal alone cannot tell a
  // well-formed refusal from an accepted-but-ignored record. The two claims together pin the whole path.
  match list_length(items: debconf_answer(
    owner: "tzdata extra" as NonEmptyStr,
    kind: AnswerSelect,
    label: "tzdata/Areas" as NonEmptyStr,
    value: "America" as NonEmptyStr,
  )) {
    // ZERO RECORDS: the mint refused it, which is what makes the audit's refusal mean something.
    0 =>
      match admit_admin_access_authorisation(authorised_keys: one_key, console_entry: locked_console) {
        Present { value: entry } =>
          match audit_altra_autoinstall_seed(
            network: network_posture,
            install_packages: [QuestionAnswered {
              package: TzdataPackage,
              answers: debconf_answer(
                owner: "tzdata extra" as NonEmptyStr,
                kind: AnswerSelect,
                label: "tzdata/Areas" as NonEmptyStr,
                value: "America" as NonEmptyStr,
              ),
            }],
            late_packages: [],
            locale: EnUsUtf8,
            entry: entry,
            strategy: virtual_media_strategy,
          ) {
            SeedIsNonInteractive { evidence: _ } => false
            SeedRefused { cause: PackagePrompts { name: named, question: _ } } =>
              named == known_prompting_package_name(package: TzdataPackage)
            SeedRefused { cause: _ } => false
          }
        Absent => false
      }
    // A RECORD MINTED FROM THAT OWNER WOULD BE THE DEFECT: it means key_field_is_well_formed let a delimiter
    // through, and the seed below would then be hung by a question nobody can answer.
    _ => false
  }
}

// A RECORD THAT COULD NOT SURVIVE THE TRIP IS NEVER WRITTEN, field by field, and each refusal is separately
// load-bearing AND SEPARATELY NAMED (mutations M24-KeyField-SpaceAllowed / -TabAllowed / -NewlineAllowed /
// M24-Value-SelectsAnything / M24-Value-WalkerBaseCase, one per check; and M25-Cause-OwnerReportedAsValue /
// M25-Cause-ValueFactsCollapsed, one per cause arm). Review 83255 asked whether a refusal that carries no cause
// would force a caller to re-derive which defect it got — and re-deriving means re-running these same checks. So
// the mint answers with one arm per refused fact, and each arm is asserted BY NAME below, with the other three
// arms present as controls that must NOT be the one reported: a refusal that arrives with the wrong cause sends
// the caller to fix the wrong field, which is the same failure the cause union exists to prevent. The reasons
// come from upstream's reader rather than from taste. A SPACE IN A KEY FIELD re-aligns every field after it —
// upstream splits the first three as (\S+) runs, so the answer lands on a package nobody meant to configure
// while tzdata's own question stays live.
test fn the_mint_refuses_the_fields_that_could_not_survive_the_trip() -> Bool {
  match debconf_answer_record(
    owner: "tzdata extra" as NonEmptyStr,
    label: "tzdata/Areas" as NonEmptyStr,
    kind: AnswerSelect,
    value: "America" as NonEmptyStr,
  ) {
    MintedSelection { record: _ } => false
    RefusedAtTheMint { cause: cause } => match cause {
      // THE CAUSE NAMES THE FIELD, and carries the offending value back so the diagnostic is located rather than
      // merely categorised.
      OwnerCarriesAFieldBoundary { owner: reported } =>
        (reported as String) == "tzdata extra"
          && match debconf_answer_record(
            owner: "tzdata" as NonEmptyStr,
            label: "tzdata Areas" as NonEmptyStr,
            kind: AnswerSelect,
            value: "America" as NonEmptyStr,
          ) {
            MintedSelection { record: _ } => false
            RefusedAtTheMint { cause: label_cause } => match label_cause {
              LabelCarriesAFieldBoundary { label: reported_label } =>
                (reported_label as String) == "tzdata Areas"
                  && match debconf_answer_record(
                    owner: "tzdata" as NonEmptyStr,
                    label: "tzdata/Areas" as NonEmptyStr,
                    kind: AnswerSelect,
                    value: "America\ntzdata tzdata/Zones/America select New_York" as NonEmptyStr,
                  ) {
                    MintedSelection { record: _ } => false
                    RefusedAtTheMint { cause: value_cause } => match value_cause {
                      // A NEWLINE IN A VALUE IS A STRUCTURAL DEFECT, not the selects-nothing defect: the record
                      // would render as two lines and the second is read as a separate record whose owner is
                      // whatever follows — an answer smuggled in as a continuation.
                      ValueEndsTheLine { value: reported_value } =>
                        (reported_value as String) ==
                          "America\ntzdata tzdata/Zones/America select New_York"
                          && match debconf_answer_record(
                            owner: "tzdata" as NonEmptyStr,
                            label: "tzdata/Areas" as NonEmptyStr,
                            kind: AnswerSelect,
                            value: "  " as NonEmptyStr,
                          ) {
                            MintedSelection { record: _ } => false
                            RefusedAtTheMint { cause: blank_cause } => match blank_cause {
                              // THE WHITESPACE-ONLY VALUE TAKES ITS OWN ARM. Upstream stores an empty content
                              // happily (lines 133-135) and the package prompts anyway, so this programme is
                              // stricter than upstream on purpose; the refinement already refuses the empty
                              // string, and what this arm covers is the blank a human actually types.
                              ValueSelectsNothing { value: reported_blank } =>
                                (reported_blank as String) == "  "
                                  // AND A LEGAL RECORD STILL MINTS, so the refusals above are not a mint that
                                  // always fails. Its fields are read back through the accessors rather than
                                  // compared as a whole record, because a record whose fields were swapped at the
                                  // constructor would still be "the record the caller asked for" under a
                                  // whole-record compare.
                                  && match debconf_answer_record(
                                    owner: "tzdata" as NonEmptyStr,
                                    label: "tzdata/Areas" as NonEmptyStr,
                                    kind: AnswerSelect,
                                    value: "America" as NonEmptyStr,
                                  ) {
                                    MintedSelection { record: good } =>
                                      (debconf_selection_owner(record: good) as String) == "tzdata"
                                        && (debconf_selection_label(record: good) as String) == "tzdata/Areas"
                                        && (debconf_selection_value(record: good) as String) == "America"
                                        && match debconf_selection_answer(record: good) {
                                            Present { value: AnswerSelect } => true
                                            Present { value: _ } => false
                                            Absent => false
                                          }
                                    RefusedAtTheMint { cause: _ } => false
                                  }
                              LabelCarriesAFieldBoundary { label: _ } => false
                              OwnerCarriesAFieldBoundary { owner: _ } => false
                              ValueEndsTheLine { value: _ } => false
                              ValueCarriesTheContinuationCharacter { value: _ } => false
                            }
                          }
                        ValueSelectsNothing { value: _ } => false
                        OwnerCarriesAFieldBoundary { owner: _ } => false
                        LabelCarriesAFieldBoundary { label: _ } => false
                        ValueCarriesTheContinuationCharacter { value: _ } => false
                      }
                  }
              OwnerCarriesAFieldBoundary { owner: _ } => false
              ValueEndsTheLine { value: _ } => false
              ValueSelectsNothing { value: _ } => false
              ValueCarriesTheContinuationCharacter { value: _ } => false
            }
          }
      LabelCarriesAFieldBoundary { label: _ } => false
      ValueEndsTheLine { value: _ } => false
      ValueSelectsNothing { value: _ } => false
      ValueCarriesTheContinuationCharacter { value: _ } => false
    }
  }
}

// THE OTHER TWO DELIMITERS AND THE ONE-CHARACTER VALUE, refused at the mint. The sibling row above covers a SPACE
// in the owner and in a label; upstream's reader refuses all of space, tab and NEWLINE in the first three fields
// because each is what (\S+) treats as a boundary — a tab re-aligns the later fields exactly as a space does, and
// a newline in a key field is worse still because it ends the line, so the record's remaining fields are read from
// whatever the NEXT line happens to be. The third leg is the one-character value " ": it is non-empty (so the
// refinement lets it through) and it contains a separator, so the mint's own single-character arm is what refuses
// it — distinct code from the whitespace-walker path that "  " travels.
test fn a_tab_in_a_key_field_a_newline_in_a_key_field_and_a_one_character_value_are_all_refused() -> Bool {
  match debconf_answer_record(
    owner: "tzdata\textra" as NonEmptyStr,
    label: "tzdata/Areas" as NonEmptyStr,
    kind: AnswerSelect,
    value: "America" as NonEmptyStr,
  ) {
    MintedSelection { record: _ } => false
    RefusedAtTheMint { cause: cause } => match cause {
      // THE TAB IS REPORTED AS THE OWNER'S DEFECT, the same arm a space takes: both are (\S+) boundaries, so
      // they are the same fact about the field and get the same cause — a distinct arm per delimiter instead would
      // be a second copy of the boundary rule, split by which character happened to trigger it.
      OwnerCarriesAFieldBoundary { owner: _ } =>
        match debconf_answer_record(
          owner: "tzdata" as NonEmptyStr,
          label: "tzdata/Areas\nzones" as NonEmptyStr,
          kind: AnswerSelect,
          value: "America" as NonEmptyStr,
        ) {
          MintedSelection { record: _ } => false
          RefusedAtTheMint { cause: label_cause } => match label_cause {
            LabelCarriesAFieldBoundary { label: _ } =>
              match debconf_answer_record(
                owner: "tzdata" as NonEmptyStr,
                label: "tzdata/Areas" as NonEmptyStr,
                kind: AnswerSelect,
                value: " " as NonEmptyStr,
              ) {
                MintedSelection { record: _ } => false
                RefusedAtTheMint { cause: blank_cause } => match blank_cause {
                  // THE LONE SPACE TAKES THE SAME ARM AS THE LONGER BLANK, because the walker refuses "any string
                  // made entirely of separators" and does not special-case length: the earlier hand-written
                  // single-space branch was deleted for duplicating exactly that.
                  ValueSelectsNothing { value: _ } =>
                    // AND A ONE-CHARACTER VALUE THAT IS NOT A SEPARATOR STILL MINTS, so the arm above is about
                    // separators specifically and not a mint that refuses short values out of hand.
                    match debconf_answer_record(
                      owner: "x" as NonEmptyStr,
                      label: "x/y" as NonEmptyStr,
                      kind: AnswerBoolean,
                      value: "1" as NonEmptyStr,
                    ) {
                      RefusedAtTheMint { cause: _ } => false
                      MintedSelection { record: short } => (debconf_selection_value(record: short) as String) == "1"
                    }
                  ValueEndsTheLine { value: _ } => false
                  OwnerCarriesAFieldBoundary { owner: _ } => false
                  LabelCarriesAFieldBoundary { label: _ } => false
                  ValueCarriesTheContinuationCharacter { value: _ } => false
                }
            }
            OwnerCarriesAFieldBoundary { owner: _ } => false
            ValueEndsTheLine { value: _ } => false
            ValueSelectsNothing { value: _ } => false
            ValueCarriesTheContinuationCharacter { value: _ } => false
          }
        }
      ValueEndsTheLine { value: _ } => false
      ValueSelectsNothing { value: _ } => false
      LabelCarriesAFieldBoundary { label: _ } => false
      ValueCarriesTheContinuationCharacter { value: _ } => false
    }
  }
}

// PERL'S \s IS SIX CHARACTERS AND BOTH DOORS MUST KNOW ALL SIX (review: merry-fox-82; review 83816 — the mint
// hand-listed space, tab and newline; upstream's field regex is Perl, whose \s also matches \v (0b), \f (0c) and
// \r (0d)). An owner pasted from a CRLF file carried \r and was minted as well-formed, so the record and the line
// debconf parses from it disagree — the exact state the sole mint exists to make unnameable. A value of "\r" was
// credited as an answer while selecting nothing. THE DENOMINATOR IS ASSERTED BEFORE ANY LEG IS CHECKED: six members
// is the claim (Perl 5.18 added the last two; Noble ships perl 5.38), and a fold over a truncated authority would
// otherwise "pass" by checking less than it claims. Then every member is checked in BOTH doors — as a whole value
// it must take ValueSelectsNothing, and embedded in an owner it must take OwnerCarriesAFieldBoundary — because
// the whole point of the shared authority row is that the two doors cannot drift apart, and a set only one door
// consults is exactly the defect being repaired.
data perl_whitespace_members: List<String> = [" ", "\t", "\n", "\u{b}", "\u{c}", "\r"]

// THE VALUE-DOOR REFUSAL, ANY OF THE THREE VALUE ARMS. A separator typed as the whole value is refused, and which
// of the three value arms fires is a property of the CHARACTER, not something this row should force: "\n" is caught
// by value_ends_the_line (it splits the record) before the nothing-check is reached, while space/tab/CR/FF/VT are
// caught by the nothing-check itself. What must hold for ALL SIX is that none of them mints — the review defect was
// that three of the six minted at all. The exact nothing-arm attribution for the three characters the old mint
// missed (CR, FF, VT) is asserted separately, more sharply, below.
fn value_refused_by_a_value_arm(cause: DebconfSelectionRefusalCause) -> Bool {
  match cause {
    ValueEndsTheLine { value: _ } => true
    ValueCarriesTheContinuationCharacter { value: _ } => true
    ValueSelectsNothing { value: _ } => true
    _ => false
  }
}

fn refusals_from_both_doors(members: List<String>, missing: Int) -> Bool {
  match members {
    Empty => missing == 0
    Cons { head: one, tail: rest } =>
      match debconf_answer_record(
        owner: "tzdata" as NonEmptyStr,
        label: "tzdata/Areas" as NonEmptyStr,
        kind: AnswerSelect,
        value: one as NonEmptyStr,
      ) {
        // A SEPARATOR AS A WHOLE VALUE IS NEVER AN ANSWER — refused by one of the three value arms.
        MintedSelection { record: _ } => false
        RefusedAtTheMint { cause: value_cause } =>
          match value_refused_by_a_value_arm(cause: value_cause) {
            True =>
              match debconf_answer_record(
                owner: concat("tzdata", concat(one, "extra")) as NonEmptyStr,
                label: "tzdata/Areas" as NonEmptyStr,
                kind: AnswerSelect,
                value: "America" as NonEmptyStr,
              ) {
                // THE SAME CHARACTER EMBEDDED IN A KEY FIELD IS REFUSED BY THE FIELD DOOR.
                MintedSelection { record: _ } => false
                RefusedAtTheMint { cause: field_cause } =>
                  match field_cause {
                    OwnerCarriesAFieldBoundary { owner: _ } => refusals_from_both_doors(members: rest, missing: missing)
                    _ => false
                  }
              }
            False => false
          }
      }
  }
}

test fn perl_whitespace_class_is_six_members_and_both_doors_know_all_six() -> Bool {
  match list_length(items: perl_whitespace_members) {
    // THE CLAIMED SIZE OF PERL's \s. If upstream's reader ever decodes Unicode whitespace, the row grows and this
    // number moves with it — but never silently, and never in one door only.
    6 => refusals_from_both_doors(members: perl_whitespace_members, missing: 0)
    _ => false
  }
}

// THE THREE CHARACTERS THE OLD MINT MISSED ARE NOW REFUSED BY THE NOTHING-ARM SPECIFICALLY (the precise review
// 83816 defect). CR, FF and VT do not contain a newline and do not end in a backslash, so the ONLY door that can
// refuse a whole-value of them is the separator-authority nothing-check — which used to know only space, tab and
// newline, so these three reached MintedSelection and were credited as answers that select nothing. Each must take
// ValueSelectsNothing by name, so this row cannot pass on the weaker "refused by some value arm" above and cannot
// pass if the nothing-check regresses to three members.
fn nothing_arm_refuses(members: List<String>) -> Bool {
  match members {
    Empty => true
    Cons { head: one, tail: rest } =>
      match debconf_answer_record(
        owner: "tzdata" as NonEmptyStr,
        label: "tzdata/Areas" as NonEmptyStr,
        kind: AnswerSelect,
        value: one as NonEmptyStr,
      ) {
        MintedSelection { record: _ } => false
        RefusedAtTheMint { cause: cause } =>
          match cause {
            ValueSelectsNothing { value: _ } => nothing_arm_refuses(members: rest)
            _ => false
          }
      }
  }
}

// CR (0d), FORM-FEED (0c), VERTICAL-TAB (0b) — Perl's \s members the mint used to miss.
data perl_added_whitespace: List<String> = ["\u{c}", "\u{b}", "\r"]

test fn the_three_perl_added_separators_are_refused_by_the_nothing_arm() -> Bool {
  match list_length(items: perl_added_whitespace) {
    3 => nothing_arm_refuses(members: perl_added_whitespace)
    _ => false
  }
}

// THE AUTHORITY THE MODULE USES IS THE AUTHORITY THE WITNESS CHECKS, not a witness-side copy that could agree with
// a stale mint. This row reads the module's OWN declaration and requires it to hold the same six characters the
// Perl class has: a mint that dropped \v or \f would keep every leg above green only by checking against a
// different list than the one it enforces, and this is the row that forbids that. Compared by length AND by
// containment of each member in both directions, so a member substituted for another (say 0x85 for 0x0b) reddens.
test fn the_mint_separator_authority_is_the_six_ascii_class_it_proclaims() -> Bool {
  match list_length(items: debconf_perl_whitespace) {
    6 =>
      fold(
        perl_whitespace_members,
        init: true,
        f: (agree, one) =>
          match a_declared_separator_appears(text: one, separators: debconf_perl_whitespace) {
            True => agree
            False => false
          },
      )
    _ => false
  }
}

// THE ssh BLOCK IN THE SERVED DOCUMENT FOLLOWS THE PACKAGE SET. The payload carries the section as
// Optional<AutoinstallSshServer> (gunbc.extdeps.os.ubuntu_autoinstall), so presence is the install state and there is no
// flag to disagree with the package set; the tie is still measured through the real emitter. A headless board whose package set contains
// openssh-server must be handed an ssh block, or nobody can log into the machine it just installed; a board that
// does not contain it must NOT be handed one, because `install-server: true` for an absent package is a promise the
// installer cannot keep. Both directions are checked on the SERVED user-data bytes (the document the board
// actually receives, via the binder's served bundle), not on the model value, so a mutation that hardcodes the section
// in either direction reddens exactly one leg.
fn packages_without_openssh() -> List<PackageIntent> {
  [QuestionAnswered {
    package: PostfixPackage,
      answers: debconf_answer_for(
        package: PostfixPackage,
        kind: AnswerSelect,
        label: "postfix/main_mailer_type" as NonEmptyStr,
        value: "No configuration" as NonEmptyStr,
      ),
  }]
}

test fn the_served_document_installs_the_ssh_server_exactly_when_the_package_set_names_it() -> Bool {
  match binding_with_packages(packages: clean_packages) {
    Absent => false
    Present { value: with_ssh } =>
      match binding_with_packages(packages: packages_without_openssh()) {
        Absent => false
        Present { value: without_ssh } =>
          // THE PACKAGE SET CONTAINS openssh-server, SO THE SERVED USER-DATA MUST ASK FOR THE SSH SERVER.
          with_ssh.served.user_data.contains(needle: "install-server")
            // THE PACKAGE SET DOES NOT CONTAIN IT, SO THE SERVED USER-DATA MUST NOT. An ssh block naming a
            // package nobody installs is the fabricated-promise half of the same defect.
            && !without_ssh.served.user_data.contains(needle: "install-server")
      }
  }
}

// THE PRESEED IS THE INTENT LIST'S RECORDS AND NOTHING ELSE (review: merry-fox-82 HOLD 1). The audit certifies
// the answer set; the thing that has to reach the board is this file, so the two properties it owes are measured
// through the PUBLIC producer. SILENT PACKAGES CONTRIBUTE NO LINE: a cited silent package has no question, and
// debconf would store an answer to a question that does not exist, so an intent that renders a line without ever
// having been asked one is a defect. ANSWERED INTENTS CONTRIBUTE ALL THEIR RECORDS: dropping one would leave the
// question live on a board with nobody at the panel while the audit still reported the seed non-interactive — that
// direction is covered by a mutation (M24-Preseed-AnsweredRecordsDropped, M24-Preseed-UnclassifiedRecordsDropped).
// The ABSENCE asserted here is the other direction and its evidence is this row rather than a mutation: a silent
// arm carries no records, so "render a line for it anyway" is not a one-line edit of an existing expression but
// new code that could not resolve, which means there is no mutation to run and the assertion has to stand on its
// own. Saying so is the honest version of claiming the property is tested.
test fn the_preseed_names_every_answered_record_and_invents_no_line_for_a_silent_package() -> Bool {
  match seed_preseed_file(intents: [
    PackageVerifiedSilent { silence: nvme_cli_silence_receipt },
    QuestionAnswered {
      package: TzdataPackage,
      answers: list_append(
        left: debconf_answer_for(
          package: TzdataPackage,
          kind: AnswerSelect,
          label: "tzdata/Areas" as NonEmptyStr,
          value: "America" as NonEmptyStr,
        ),
        right: debconf_answer_for(
          package: TzdataPackage,
          kind: AnswerSelect,
          label: "tzdata/Zones/America" as NonEmptyStr,
          value: "New_York" as NonEmptyStr,
        ),
      ),
    },
    PackageVerifiedSilent { silence: ipmitool_silence_receipt },
  ]) {
    file =>
      // BOTH ANSWER LINES PRESENT, in intent order.
      match (file == "tzdata tzdata/Areas select America\ntzdata tzdata/Zones/America select New_York") {
        False => false
        // AND NO LINE FOR EITHER SILENT PACKAGE, checked on the package NAMES rather than on a line count: a
        // count would be satisfied by any two stray lines, and the names are what a silent package could forge.
        True =>
          match file.contains(needle: "nvme-cli") {
            True => false
            False =>
              match file.contains(needle: "ipmitool") {
                True => false
                False => true
              }
          }
      }
  }
}

// AN UNCLASSIFIED ROW'S ANSWERS TRAVEL TOO. UnclassifiedPackage is the arm for a package whose question behaviour
// this programme has not classified, and it carries records for exactly the same reason QuestionAnswered does —
// so its arm must not be the one that quietly renders nothing while the digest still counts the answer. Both
// record-bearing arms therefore have a row here, each mutating separately.
test fn the_preseed_carries_the_records_of_an_unclassified_row() -> Bool {
  match seed_preseed_file(intents: [
    UnclassifiedPackage {
      name: "some-asker" as NonEmptyStr,
      answers: debconf_answer(
        owner: "some-asker" as NonEmptyStr,
        kind: AnswerString,
        label: "some-asker/first" as NonEmptyStr,
        value: "yes" as NonEmptyStr,
      ),
    },
  ]) {
    file => file == "some-asker some-asker/first string yes"
  }
}

// THE PRESEED IS EMPTY WHEN NOTHING IS ANSWERED, INCLUDING A SEED FULL OF SILENT PACKAGES. This is the same
// claim as the row above reached from the other side: the file's emptiness is a property of the ANSWERS and not
// of the package list, so a seed with five packages and no questions ships no preseed at all. It is also the arm
// that makes `seed_preseed_file` total — every seed has a preseed, and for a seed with no questions that preseed
// is legitimately the empty file rather than a refusal, because there is nothing for the installer to read.
test fn a_seed_of_silent_packages_alone_yields_an_empty_preseed() -> Bool {
  match seed_preseed_file(intents: [
    PackageVerifiedSilent { silence: nvme_cli_silence_receipt },
    PackageVerifiedSilent { silence: ipmitool_silence_receipt },
  ]) {
    file => file.length() == 0
  }
}

// THE FILE IS THE RECORDS, IN ORDER, JOINED BY EXACTLY ONE NEWLINE AND NO MORE. The records are the truth and
// the text is derived, which is the whole claim of this shelf — so the derived text needs an executing reader,
// not a comment, or the shelf has grown a render path nothing walks (DESIGN §3c). The claim worth a row is the
// JOINER: one newline between lines, none after the last. A trailing newline is an extra empty record for any
// reader that splits rather than matches, and a missing joiner welds two answers into one unparseable line —
// both are invisible in the record list and visible only here. tzdata's two records are used because a
// one-record file cannot distinguish "joined" from "terminated".
test fn the_file_is_the_records_joined_by_one_newline_and_no_more() -> Bool {
  match list_append(
    left: debconf_answer_for(
      package: TzdataPackage,
      kind: AnswerSelect,
      label: "tzdata/Areas" as NonEmptyStr,
      value: "America" as NonEmptyStr,
    ),
    right: debconf_answer_for(
      package: TzdataPackage,
      kind: AnswerSelect,
      label: "tzdata/Zones/America" as NonEmptyStr,
      value: "New_York" as NonEmptyStr,
    ),
  ) {
    records =>
      match (debconf_selection_file(records: records) as String) {
        file =>
          file == "tzdata tzdata/Areas select America\ntzdata tzdata/Zones/America select New_York"
            && count_character(text: file, character: "\n", seen: 0) == 1
      }
  }
}

// A TRAILING CONTINUATION NEVER SWALLOWS THE RECORD BELOW IT (review: merry-fox-82, HOLD section 6). Upstream
// debconf joins a line ending in `\` to the line BELOW before matching, so a two-record file whose first value ends
// in the continuation character is read as ONE malformed record: the answer smuggles the second record's owner and
// label into its own content, and the second question goes unanswered on a board with no operator to answer it.
// The joiner cannot be handed that pair, because the mint refuses the swallowing record outright. Both halves are
// asserted: the swallowing record is refused with the TYPED continuation cause (not ValueEndsTheLine — that arm is
// a newline in the value — and not ValueSelectsNothing), and the file built from the surviving records is the clean
// answer ALONE, so the swallowing record contributed nothing that could reach the line below it.
test fn a_trailing_continuation_never_swallows_the_record_below_it() -> Bool {
  // THE POSITIVE REFUSAL, NAMED. A value that is otherwise a legal answer (one character that is not a separator,
  // no embedded newline) but ends in `\` is refused specifically for the continuation, which is the arm that must
  // be distinguishable from its two neighbours. If the continuation check were collapsed into either neighbour,
  // this arm would not match and the row would go RED.
  match debconf_answer_record(
    owner: "tzdata" as NonEmptyStr,
    label: "tzdata/Areas" as NonEmptyStr,
    kind: AnswerSelect,
    value: "America\\" as NonEmptyStr,
  ) {
    MintedSelection { record: _ } => false
    RefusedAtTheMint { cause: cause } =>
      match cause {
        ValueCarriesTheContinuationCharacter { value: _ } =>
          // THE TWO-RECORD BATCH: the swallowing record and a clean one below it. The swallowing record mints to
          // no records at all, so the joined file is the clean answer alone — the swallowing record has no line
          // with which to reach the record below it, and there is no trailing `\` anywhere in what is served.
          match list_length(items: debconf_answer_for(
            package: TzdataPackage,
            kind: AnswerSelect,
            label: "tzdata/Areas" as NonEmptyStr,
            value: "America\\" as NonEmptyStr,
          )) {
            0 =>
              match list_append(
                left: debconf_answer_for(
                  package: TzdataPackage,
                  kind: AnswerSelect,
                  label: "tzdata/Areas" as NonEmptyStr,
                  value: "America\\" as NonEmptyStr,
                ),
                right: debconf_answer_for(
                  package: TzdataPackage,
                  kind: AnswerSelect,
                  label: "tzdata/Zones/America" as NonEmptyStr,
                  value: "New_York" as NonEmptyStr,
                ),
              ) {
                joined =>
                  match (debconf_selection_file(records: joined) as String) {
                    file =>
                      // THE CLEAN ANSWER ALONE, one line, no continuation character, and — decisively — the second
                      // question still present on its own line rather than consumed by the first.
                      file == "tzdata tzdata/Zones/America select New_York"
                        && !file.contains("\\")
                        && count_character(text: file, character: "\n", seen: 0) == 0
                  }
              }
            _ => false
          }
        _ => false
      }
  }
}

// NOTHING TO ANSWERS ASKERS RENDERS NO FILE AT ALL, not an empty line and not a newline. Both `lines_from_records`
// and `file_from_lines` reach their Empty arm here, and the installer treats "no file" and "no lines" alike; a
// rendered newline in the empty case ships an almost-empty file whose single empty record is only harmless
// because upstream's own reader skips blank lines — an argument about THEIR parser standing in for a claim about
// ours.
test fn nothing_to_answer_renders_no_file_at_all() -> Bool {
  match (debconf_selection_file(records: []) as String) {
    file => file.length() == 0
  }
}

// THE CITATION IS CLOSED AND NOTHING IS OWED, read through the shelf's own obligation so the number of arms is
// the claim rather than a sentence about it. CitedToAuthority is the only standing today, which is the honest
// description: the nine type words and the separator rule are transcriptions from a named release, the release is
// named on the shelf, and a consumer may rely on them. Add a rung whose standing nobody read and this row goes RED
// instead of a silent answer shipping under an obligation nobody opened — the same discipline the sibling
// libxcrypt shelf states for its figure.
test fn the_debconf_citation_carries_no_unread_obligation() -> Bool {
  // THE SHELF'S OWN STANDING, ASKED OF THE SHARED READER. Not a wrapper on the shelf: the shared
  // extdeps.external_authority reader already decides, exhaustively over the three arms of CitedFigureStanding,
  // whether a figure carries an obligation, and a per-shelf copy of that decision would be a second
  // representation of a rule the model carries once (§5). The contrast arm is what makes this a claim and not a
  // tautology: the SAME authority, standing TranscribedUncited, must come back Present — otherwise the row would
  // still pass if the reader always answered Absent, which is the failure mode a "cited" claim has to exclude.
  match cited_figure_read_obligation(standing: debconf_selection_standing) {
    Present { value: _ } => false
    Absent =>
      match cited_figure_read_obligation(
        standing: TranscribedUncited { read_obligation: "read debconf-set-selections before believing it" as NonEmptyStr },
      ) {
        Absent => false
        Present { value: owed } => (owed as String) == "read debconf-set-selections before believing it"
      }
  }
}

// THE CITATION IS DERIVED FROM THE SINGLE VERSION DECLARATION, NOT RETYPED. The version now exists in exactly one
// place (`debconf_package_version`) and the citation's source path is BUILT from it (`debconf_source_locator`), so
// the locator and the transcription cannot drift apart on a version bump — the citation's version equals the
// transcription's BY CONSTRUCTION, not because a test hopes to notice a mismatch. This row is the consumer that
// makes that construction observable: it reconstructs the full expected path from the declared version and demands
// the authority the caller actually reaches (`debconf_selection_authority`, the only public door to the anchor) be
// EXACTLY that string. A mutation that hardcodes the anchor locator back to a literal version — the state this row
// replaces — makes the two strings differ and goes RED; it is not the `.contains`-on-itself grep the review
// rejected, because the version value flows through the comparison rather than a string matching its own copy.
// (review: merry-fox-82; review 83752.)
test fn the_citation_is_the_declared_version_with_the_fixed_path_built_around_it() -> Bool {
  match debconf_selection_authority() {
    authority =>
      (authority.uri.locator as String)
        == ((concat(
          concat("sources.debian.org/api/src/debconf/", debconf_package_version),
          "/tools/debconf-set-selections",
        )) as String)
  }
}

// THE DERIVATION IS ACTUALLY A FUNCTION OF THE VERSION, NOT A CONSTANT THAT HAPPENS TO MATCH IT TODAY. Ask the
// builder what locator it would produce for a DIFFERENT version and require the answer to carry that version in
// the pinned path segment. A `debconf_source_locator` that had been quietly replaced by a constant string would
// keep the row above green on the one real version while being wrong for every other; this row is the one that
// would not survive it. (If the path shape changes upstream, update the two literals here to match the new shape.)
test fn the_source_locator_truly_delegates_to_the_version_it_is_given() -> Bool {
  match (debconf_source_locator(version: "9.9.9-fake" as NonEmptyStr) as String) {
    built =>
      built.contains(needle: "/api/src/debconf/9.9.9-fake/tools/")
        && !built.contains(needle: "1.5.86ubuntu1")
  }
}
