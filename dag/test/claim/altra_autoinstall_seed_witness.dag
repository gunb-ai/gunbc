  ByObservedSerial,
  ByCatalogIdentity,
  NvmeCliDriver,
  LinuxFirmwareDriver,
  AhciPlatformModule,
  NvmeBlockModule,
  KipmiSiDriver,
  IpmiWatchdogDriver,
  ConsoleEntryLocked,
  ConsoleEntryUnlocked,
  ClosedQuestion,
  OpenQuestion,
  UnclassifiedPrompting,
  QuestionAnswered,
