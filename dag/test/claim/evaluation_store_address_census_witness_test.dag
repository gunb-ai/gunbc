module test.claim.evaluation_store_address_census_witness

import std.types { Bool, List }
import std.decl_ref { DeclarationRef }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import gunbc.materialization_provider_targets {
  evaluation_store_address_producer,
  evaluation_store_address_production_consumers,
  evaluation_store_address_persist_callers_expected,
  evaluation_store_address_admitted_consumers_expected,
  evaluation_store_address_duplicate_consumers
}
import gunbc.evaluation_store_address_census {
  evaluation_store_address_alias_mutation_callers,
  evaluation_store_address_same_leaf_decoy_callers,
  evaluation_store_address_ref_in_module
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn evaluation_store_address_census_joins_exact_head_declaration_graph() -> Bool {
  let direct = evaluation_store_address_production_consumers
  let persist = evaluation_store_address_persist_callers_expected
  let admitted = evaluation_store_address_admitted_consumers_expected
  ((evaluation_store_address_duplicate_consumers(xs: direct) |> count()) == 0)
    && ((evaluation_store_address_duplicate_consumers(xs: persist) |> count()) == 0)
    && ((evaluation_store_address_duplicate_consumers(xs: admitted) |> count()) == 0)
    && ((evaluation_store_address_producer.decl_name as String) == "evaluation_store_address")
    && ((direct |> count()) != (persist |> count()))
}

test fn evaluation_store_address_resolver_distinguishes_alias_same_leaf_and_qualified() -> Bool {
  let home_callers = evaluation_store_address_alias_mutation_callers()
  let decoy_callers = evaluation_store_address_same_leaf_decoy_callers()
  evaluation_store_address_ref_in_module(
    module_path: "test.fixture.evaluation_store_address_alias.aliased",
    name: "aliased_call",
    xs: home_callers
  )
    && evaluation_store_address_ref_in_module(
      module_path: "test.fixture.evaluation_store_address_alias.qualified",
      name: "qualified_call",
      xs: home_callers
    )
    && evaluation_store_address_ref_in_module(
      module_path: "test.fixture.evaluation_store_address_alias.same_leaf",
      name: "same_leaf_imported_call",
      xs: decoy_callers
    )
    && (evaluation_store_address_ref_in_module(
      module_path: "test.fixture.evaluation_store_address_alias.same_leaf",
      name: "same_leaf_imported_call",
      xs: home_callers
    ) == false)
}
