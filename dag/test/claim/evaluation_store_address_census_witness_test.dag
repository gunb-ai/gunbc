module test.claim.evaluation_store_address_census_witness

import std.types { Bool, Int, List }
import std.decl_ref { DeclarationRef }
import gunbc.materialization_provider_targets {
  evaluation_store_address_producer,
  evaluation_store_address_production_consumers,
  evaluation_store_address_persist_callers_expected,
  evaluation_store_address_admitted_consumers_expected,
  evaluation_store_address_joined,
  evaluation_store_address_missing_expected,
  evaluation_store_address_unresolved,
  evaluation_store_address_duplicate_consumers
}
import gunbc.evaluation_store_address_census {
  evaluation_store_address_observed_direct_callers,
  evaluation_store_address_observed_persist_callers,
  evaluation_store_address_observed_admitted_consumers,
  evaluation_store_address_observed_duplicate_producers
}

fn census_lists_agree(expected: List<DeclarationRef>, observed: List<DeclarationRef>) -> Bool {
  ((evaluation_store_address_missing_expected(expected: expected, observed: observed) |> count()) == 0)
    && ((evaluation_store_address_unresolved(expected: expected, observed: observed) |> count()) == 0)
    && ((evaluation_store_address_joined(expected: expected, observed: observed) |> count()) == (expected |> count()))
}

test fn evaluation_store_address_census_joins_exact_head_declaration_graph() -> Bool {
  let direct = evaluation_store_address_observed_direct_callers()
  let persist = evaluation_store_address_observed_persist_callers()
  let admitted = evaluation_store_address_observed_admitted_consumers()
  let dups = evaluation_store_address_observed_duplicate_producers()
  census_lists_agree(expected: evaluation_store_address_production_consumers, observed: direct)
    && census_lists_agree(expected: evaluation_store_address_persist_callers_expected, observed: persist)
    && census_lists_agree(expected: evaluation_store_address_admitted_consumers_expected, observed: admitted)
    && ((dups |> count()) == 0)
    && ((evaluation_store_address_duplicate_consumers(xs: direct) |> count()) == 0)
    && ((evaluation_store_address_producer.decl_name as String) == "evaluation_store_address")
    && ((direct |> count()) != (persist |> count()))
}
