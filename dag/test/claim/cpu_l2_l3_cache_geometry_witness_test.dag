module test.claim.cpu_l2_l3_cache_geometry_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data ampere_altra_l2_mebibytes_per_core: std.nat.Nat = 1
data ampere_altra_l2_line_bytes: std.nat.Nat = 64
data ampere_altra_max_l3_mebibytes: std.nat.Nat = 16
data ampere_altra_classic_l3_mebibytes: std.nat.Nat = 32
data ampere_altra_l3_line_bytes: std.nat.Nat = 64

test fn w_ampere_l2_geometry_matches_datasheet() -> Bool {
  let g = extdeps.cpu.ampere.ampere_altra_l2_cache_geometry
  std.measure.byte_size_count(b: g.capacity_per_core) == ampere_altra_l2_mebibytes_per_core * 1024 * 1024
    && std.measure.byte_size_count(b: g.line_size) == ampere_altra_l2_line_bytes
}

test fn w_ampere_catalog_rows_share_cited_l2_geometry() -> Bool {
  altra_max_m12830_catalog.l2_cache == extdeps.cpu.ampere.ampere_altra_l2_cache_geometry
    && altra_q6430_catalog.l2_cache == extdeps.cpu.ampere.ampere_altra_l2_cache_geometry
}

test fn w_ampere_l2_citations_cover_all_fields() -> Bool {
  let citations = extdeps.cpu.ampere.ampere_altra_l2_cache_citations
  std.types.list_length(items: citations) == 2
    && citations.first().authority == extdeps.cpu.ampere.ampere_altra_rev_a1_datasheet_authority
}

test fn w_ampere_l3_geometry_diverges_by_sku() -> Bool {
  std.measure.byte_size_count(b: altra_max_m12830_catalog.l3_cache.capacity) == ampere_altra_max_l3_mebibytes * 1024 * 1024
    && std.measure.byte_size_count(b: altra_q6430_catalog.l3_cache.capacity) == ampere_altra_classic_l3_mebibytes * 1024 * 1024
    && std.measure.byte_size_count(b: altra_max_m12830_catalog.l3_cache.line_size) == ampere_altra_l3_line_bytes
    && std.measure.byte_size_count(b: altra_q6430_catalog.l3_cache.line_size) == ampere_altra_l3_line_bytes
    && altra_max_m12830_catalog.l3_cache == extdeps.cpu.ampere.ampere_altra_max_l3_cache_geometry
    && altra_q6430_catalog.l3_cache == extdeps.cpu.ampere.ampere_altra_classic_l3_cache_geometry
}

test fn w_ampere_l3_citations_diverge_by_family_datasheet() -> Bool {
  std.types.list_length(items: altra_max_m12830_catalog.l3_cache_citations) == 2
    && std.types.list_length(items: altra_q6430_catalog.l3_cache_citations) == 2
    && altra_max_m12830_catalog.l3_cache_citations.first().authority == extdeps.cpu.ampere.ampere_altra_rev_a1_datasheet_authority
    && altra_q6430_catalog.l3_cache_citations.first().authority == extdeps.cpu.ampere.ampere_altra_classic_rev_a1_datasheet_authority
}

