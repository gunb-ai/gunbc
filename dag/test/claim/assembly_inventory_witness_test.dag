module test.claim.assembly_inventory_witness
import product.printed_chassis.assembly_inventory { ReserveParts, PartReservation, InspectPart, transition_inventory, InventoryTransitionRefused, InventoryTransitionPrepared, StaleInventoryBaseline, ReservationUnavailable, InspectionAttemptMismatch }
import product.printed_chassis.assembly_inventory_store { capture_at_generation }
import std.durable_compare_and_set { cas_generation_first, cas_generation_successor, CasSuccessorGeneration }
import product.printed_chassis.residential_review { residential_assembly, ResidentialAssemblyReady, ResidentialAssemblyRefused }
import product.printed_chassis.assembly_inventory { required_printed_parts }
import std.types { Bool, List }
import product.printed_chassis.assembly_inventory { InspectionEvidence, RequiredPart, InventoryEntry, InventoryCaptured, InventoryUnread, PartAccepted, PartRejected, PartReserved, PartAwaitingInspection, assess_inventory, DuplicateObservedSlot, PhysicalItemReused }
import std.goal_assessment { GoalSatisfied, GoalDiverged, GoalIndeterminate, GoalAssessmentRefused }
import product.printed_chassis.assembly_inventory { decode_inventory, observe_inventory }
import std.goal_assessment { ObservationRefused }

fn desired() -> List<RequiredPart> { [RequiredPart {slot:"M140",revision:"r1"},RequiredPart {slot:"G140",revision:"r1"}] }
fn accepted() -> InventoryEntry { InventoryEntry {slot:"M140",revision:"r1",state:PartAccepted {physical_item:"physical-M",attempt:"attempt-1",evidence:InspectionEvidence {reference:"inspection-1",observed_at:"2026-10-05T20:00:00Z"}}} }

test fn uncovered_is_not_absent() -> Bool {
 let unread = match assess_inventory(desired:desired(),observed:InventoryCaptured {snapshot:"partial-capture",covered_slots:[],entries:[]}) { GoalIndeterminate {known_deviations:d,unknowns:_} => count(d)==0 _=>false }
 let absent = match assess_inventory(desired:desired(),observed:InventoryCaptured {snapshot:"capture-1",covered_slots:["M140","G140"],entries:[]}) { GoalDiverged {deviations:_}=>true _=>false }
 unread && absent
}
test fn partial_acceptance_preserves_the_good_sibling() -> Bool {
 match assess_inventory(desired:desired(),observed:InventoryCaptured {snapshot:"capture-2",covered_slots:["M140","G140"],entries:[accepted(),InventoryEntry {slot:"G140",revision:"r1",state:PartReserved {attempt:"attempt-2"}}]}) { GoalIndeterminate {known_deviations:d,unknowns:_}=>count(d)==0 _=>false }
}
test fn finish_does_not_satisfy_inventory() -> Bool {
 match assess_inventory(desired:desired(),observed:InventoryCaptured {snapshot:"capture-3",covered_slots:["M140","G140"],entries:[accepted(),InventoryEntry {slot:"G140",revision:"r1",state:PartAwaitingInspection {physical_item:"physical-G",attempt:"attempt-2"}}]}) { GoalIndeterminate {known_deviations:d,unknowns:_}=>count(d)==0 _=>false }
}
test fn only_compatible_accepted_parts_satisfy() -> Bool {
 let good=InventoryEntry {slot:"G140",revision:"r1",state:PartAccepted {physical_item:"physical-G",attempt:"attempt-2",evidence:InspectionEvidence {reference:"inspection-2",observed_at:"2026-10-05T20:00:00Z"}}}
 let old=InventoryEntry {slot:"G140",revision:"old",state:good.state}
 let satisfied=match assess_inventory(desired:desired(),observed:InventoryCaptured {snapshot:"capture-4",covered_slots:["M140","G140"],entries:[accepted(),good]}) {GoalSatisfied {evidence:_}=>true _=>false}
 let mismatch=match assess_inventory(desired:desired(),observed:InventoryCaptured {snapshot:"capture-5",covered_slots:["M140","G140"],entries:[accepted(),old]}) {GoalIndeterminate {known_deviations:_,unknowns:_}=>true _=>false}
 satisfied && mismatch
}
test fn duplicate_slots_refuse() -> Bool {
 match assess_inventory(desired:desired(),observed:InventoryCaptured {snapshot:"capture-6",covered_slots:["M140","G140"],entries:[accepted(),accepted()]}) {GoalAssessmentRefused {cause:DuplicateObservedSlot}=>true _=>false}
}
test fn one_physical_part_cannot_fill_two_slots() -> Bool {
 match assess_inventory(desired:desired(),observed:InventoryCaptured {snapshot:"capture-7",covered_slots:["M140","G140"],entries:[accepted(),InventoryEntry {slot:"G140",revision:"r1",state:accepted().state}]}) {GoalAssessmentRefused {cause:PhysicalItemReused}=>true _=>false}
}


test fn malformed_capture_cannot_become_empty_inventory() -> Bool {
 let bad=match decode_inventory(text:"{\"snapshot\":\"s\",\"covered_slots\":[\"M140\"],\"entries\":[{\"slot\":\"M140\",\"status\":\"accepted\"}]}") {Absent=>true Present {value:_}=>false}
 let good=match decode_inventory(text:"{\"snapshot\":\"s\",\"covered_slots\":[\"M140\"],\"entries\":[]}") {Present {value:_}=>true Absent=>false}
 bad && good
}
test fn failed_capture_read_is_observation_refusal() -> Bool {
 match observe_inventory(path:"/this-inventory-does-not-exist/capture.json",request:true) {ObservationRefused {cause:_}=>true _=>false}
}
test fn rejection_does_not_erase_missing_coverage() -> Bool {
 match assess_inventory(desired:desired(),observed:InventoryCaptured {snapshot:"partial",covered_slots:["G140"],entries:[InventoryEntry {slot:"G140",revision:"r1",state:PartRejected {physical_item:"failed-G",attempt:"failed-attempt",evidence:InspectionEvidence {reference:"photo-receipt",observed_at:"2026-10-05T20:00:00Z"}}}]}) {GoalIndeterminate {known_deviations:d,unknowns:_}=>count(d)==1 _=>false}
}

test fn reservations_are_atomic_and_stale_requests_refuse() -> Bool {
 let initial=InventoryCaptured {snapshot:"b0",covered_slots:["M140","G140"],entries:[]}
 let request=ReserveParts {baseline:"b0",next_snapshot:"b1",reservations:map(desired(),p=>PartReservation {part:p,attempt:"batch-1"})}
 match transition_inventory(observed:initial,mutation:request) {
 InventoryTransitionRefused {cause:_}=>false
 InventoryTransitionPrepared {next:n}=>{
 let held=match assess_inventory(desired:desired(),observed:n) {GoalIndeterminate {known_deviations:d,unknowns:_}=>count(d)==0 _=>false}
 let stale=match transition_inventory(observed:n,mutation:request) {InventoryTransitionRefused {cause:StaleInventoryBaseline}=>true _=>false}
 held && stale
 }
 }
}
test fn uncovered_sibling_refuses_whole_reservation() -> Bool {
 match transition_inventory(observed:InventoryCaptured {snapshot:"b0",covered_slots:["M140"],entries:[]},mutation:ReserveParts {baseline:"b0",next_snapshot:"b1",reservations:map(desired(),p=>PartReservation {part:p,attempt:"batch-1"})}) {InventoryTransitionRefused {cause:ReservationUnavailable}=>true _=>false}
}
test fn inspection_binds_attempt_and_preserves_siblings() -> Bool {
 let reserved=InventoryCaptured {snapshot:"b1",covered_slots:["M140","G140"],entries:[InventoryEntry {slot:"M140",revision:"r1",state:PartReserved {attempt:"batch-1"}},InventoryEntry {slot:"G140",revision:"r1",state:PartReserved {attempt:"batch-1"}}]}
 let wrong=match transition_inventory(observed:reserved,mutation:InspectPart {baseline:"b1",next_snapshot:"inspection-wrong",part:RequiredPart {slot:"M140",revision:"r1"},attempt:"other-attempt",physical_item:"physical-M",evidence:InspectionEvidence {reference:"photo",observed_at:"2026-10-05T20:00:00Z"},accepted:true}) {InventoryTransitionRefused {cause:InspectionAttemptMismatch}=>true _=>false}
 let right=match transition_inventory(observed:reserved,mutation:InspectPart {baseline:"b1",next_snapshot:"inspection-right",part:RequiredPart {slot:"M140",revision:"r1"},attempt:"batch-1",physical_item:"physical-M",evidence:InspectionEvidence {reference:"photo",observed_at:"2026-10-05T20:00:00Z"},accepted:true}) {InventoryTransitionPrepared {next:n}=>match assess_inventory(desired:desired(),observed:n) {GoalIndeterminate {known_deviations:d,unknowns:_}=>count(d)==0 _=>false} _=>false}
 wrong && right
}

test fn store_generation_prevents_receipt_label_aba() -> Bool {
 let body=InventoryCaptured {snapshot:"reused-receipt-label",covered_slots:["M140","G140"],entries:[]}
 let first=capture_at_generation(capture:body,generation:cas_generation_first())
 let second=match cas_generation_successor(g:cas_generation_first()) {CasSuccessorGeneration {generation:g}=>capture_at_generation(capture:body,generation:g) _=>return false}
 let before=match first {InventoryCaptured {snapshot:s,covered_slots:_,entries:_}=>s}
 match transition_inventory(observed:second,mutation:ReserveParts {baseline:before,next_snapshot:"new-reservation",reservations:map(desired(),p=>PartReservation {part:p,attempt:"attempt"})}) {InventoryTransitionRefused {cause:StaleInventoryBaseline}=>true _=>false}
}

test fn satisfaction_carries_inspection_evidence() -> Bool {
 match assess_inventory(desired:[RequiredPart {slot:"M140",revision:"r1"}],observed:InventoryCaptured {snapshot:"read",covered_slots:["M140"],entries:[accepted()]}) {
 GoalSatisfied {evidence:rows}=>count(rows)==1 && any(rows,row=>match row.state {PartAccepted {physical_item:p,attempt:a,evidence:e}=>p=="physical-M" && a=="attempt-1" && e.reference=="inspection-1" && e.observed_at!="" _=>false})
 _=>false
 }
}

test fn residential_producer_unobserved_inventory_requests_observation() -> Bool {
 match residential_assembly() {
 ResidentialAssemblyRefused {reason:_}=>false
 ResidentialAssemblyReady {parts:parts,joints:_,pitch:_,cooling:_}=>{
 let required=required_printed_parts(parts:parts,revision:"test-revision")
 let membership=any(required,p=>p.slot=="M140") && any(required,p=>p.slot=="G140") && !any(required,p=>p.slot=="BOARD")
 membership && match assess_inventory(desired:required,observed:InventoryCaptured {snapshot:"independent-empty-coverage",covered_slots:[],entries:[]}) {GoalIndeterminate {known_deviations:d,unknowns:u}=>count(d)==0 && count(u.tail)+1==count(required) _=>false}
 }
 }
}
