module test.claim.fabric_demand_effect_witness_test


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

// The claim this file exists to hold is the two-provider argument demand.dag
// makes in prose: a withdrawal arriving from one provider must not destroy Work
// that a demand from another provider still requires. A witness that only
// exercised the single-demand path would pass against an implementation that
// cancels on every withdrawal, which is the exact defect the core surface
// exists to prevent - so every population assertion below is paired with its
// mirror.

fn work_of(principal: std.types.NonEmptyStr, key: product.fabric.identity.WorkKey) -> product.fabric.identity.FabricIdentity<std.types.NonEmptyStr, product.fabric.identity.WorkKey> {
  product.fabric.identity.FabricIdentity { principal: principal, key: key }
}

fn demand_id(principal: std.types.NonEmptyStr, key: product.fabric.identity.DemandKey) -> product.fabric.identity.FabricIdentity<std.types.NonEmptyStr, product.fabric.identity.DemandKey> {
  product.fabric.identity.FabricIdentity { principal: principal, key: key }
}

fn terms() -> product.fabric.demand.AdmissionTerms {
  product.fabric.demand.AdmissionTerms {
    priority_class: "default",
    deadline: none,
    buy: product.fabric.demand.BuyTerms {
      budget_account: "fleet-ci",
      currency: std.currency.Usd,
      reservation_price: std.measure.money_amount_micro(count: 100000),
      maximum_buy_order: std.measure.money_amount_micro(count: 200000),
    },
  }
}

fn attaching_satisfaction() -> product.fabric.demand.SatisfactionRequirement {
  product.fabric.demand.SatisfactionRequirement {
    terminal_receipt_may_satisfy: true,
    new_attempt_required: false,
    step_reuse_permitted: true,
  }
}

fn demand_of(
  principal: std.types.NonEmptyStr,
  key: product.fabric.identity.DemandKey,
  work_key: product.fabric.identity.WorkKey,
  satisfaction: product.fabric.demand.SatisfactionRequirement,
) -> product.fabric.demand.Demand<std.types.NonEmptyStr> {
  product.fabric.demand.Demand {
    id: demand_id(principal: principal, key: key),
    work: work_of(principal: principal, key: work_key),
    origin: "observation-1",
    submitted_at: "2026-08-24T00:00:00Z",
    admission: terms(),
    satisfaction: satisfaction,
  }
}

// The two-provider setup. Both demands name the SAME work identity, which is
// what makes them demands on one computation rather than two: the work
// identity is constructed with a single principal, because a shared Work is
// shared under one accounting scope, while each demand keeps its own requester
// identity. Reproducing that here rather than fabricating two work identities
// is what makes the withdrawal test discriminate at all.

fn github_demand() -> product.fabric.demand.Demand<std.types.NonEmptyStr> {
  product.fabric.demand.Demand {
    id: demand_id(principal: "github", key: "demand-gh"),
    work: work_of(principal: "fabric", key: "work-1"),
    origin: "gh-pr-7",
    submitted_at: "2026-08-24T00:00:00Z",
    admission: terms(),
    satisfaction: attaching_satisfaction(),
  }
}

fn gitlab_demand() -> product.fabric.demand.Demand<std.types.NonEmptyStr> {
  product.fabric.demand.Demand {
    id: demand_id(principal: "gitlab", key: "demand-gl"),
    work: work_of(principal: "fabric", key: "work-1"),
    origin: "gl-mr-3",
    submitted_at: "2026-08-24T00:00:01Z",
    admission: terms(),
    satisfaction: attaching_satisfaction(),
  }
}

fn running_grant() -> product.fabric.execution.ExecutionGrant<std.types.NonEmptyStr> {
  product.fabric.execution.ExecutionGrant {
    id: product.fabric.identity.FabricIdentity { principal: "fabric", key: "grant-1" },
    object: product.fabric.execution.FabricGrantObject {
      offer: product.fabric.identity.FabricIdentity { principal: "supplier", key: "offer-1" },
      quote: product.fabric.supply.QuotedFlatPerGrant(
        std.measure.MoneyOnce { amount: std.measure.money_amount_micro(count: 50000), currency: std.currency.Usd },
      ),
    },
    context: product.fabric.execution.FabricGrantContext {
      demand: demand_id(principal: "github", key: "demand-gh"),
      work: work_of(principal: "fabric", key: "work-1"),
      attempt: product.fabric.identity.FabricIdentity { principal: "fabric", key: "attempt-1" },
      executor: "supplier",
      lease: product.fabric.execution.LeaseIdentity {
        lease_key: "lease-1",
        resource_fingerprint: std.content_hash.content_hash_of_value(value: "slice-a"),
        generation: 1,
      },
      issued_at: "2026-08-24T00:00:02Z",
      maximum_liability: std.measure.money_amount_micro(count: 200000),
    },
    evidence: product.fabric.execution.FabricGrantEvidence {
      fungibility_receipt: "ev-1",
      offer_authority: "ev-2",
      resource_conservation: "ev-3",
      budget_conservation: "ev-4",
      principal_authority: "ev-5",
    },
    resource_reservations: ["res-cpu-1"],
    money_reservation: "res-money-1",
  }
}

// Every assertion names the arm it expects rather than testing that something
// happened. An effect label collapses to a single string exactly once per arm,
// so a test asserting "released" cannot be satisfied by a refusal and a test
// asserting a refusal cannot be satisfied by the wrong cause.

fn effect_label(e: product.fabric.arbitration.DemandCommandEffect<std.types.NonEmptyStr>) -> std.types.NonEmptyStr {
  match e {
    product.fabric.arbitration.CommandRefused { refusal: r } => refusal_label(r: r)
    product.fabric.arbitration.DemandAdmitted { population: _, directive: d } => directive_label(d: d)
    product.fabric.arbitration.WorkStillRequiredNothingRunning { population: _, remaining: _ } =>
      "still-required-nothing-running"
    product.fabric.arbitration.WorkStillRequiredAttemptContinues { population: _, remaining: _, attempts: _ } =>
      "still-required-attempt-continues"
    product.fabric.arbitration.WorkReleasedAttemptStops { population: _, work: _, release_plan: _ } =>
      "released-attempt-stops"
    product.fabric.arbitration.WorkReleasedNothingRunning { population: _, work: _ } => "released-nothing-running"
  }
}

fn refusal_label(r: product.fabric.demand.DemandRefusal<std.types.NonEmptyStr>) -> std.types.NonEmptyStr {
  match r {
    product.fabric.demand.UnknownDemand { demand: _ } => "unknown-demand"
    product.fabric.demand.AttestationDoesNotCoverPrincipal { attested: _, acting: _ } => "attestation-does-not-cover-principal"
    product.fabric.demand.DemandPrincipalMismatch { demand: _ } => "principal-mismatch"
    product.fabric.demand.DuplicateDemand { demand: _ } => "duplicate-demand"
    product.fabric.demand.ReplacementAlreadyRegistered { demand: _ } => "replacement-already-registered"
    product.fabric.demand.SupersedeCrossesPrincipal { superseded: _, replacement: _ } => "supersede-crosses-principal"
    product.fabric.demand.ReplacementWorkMismatch { superseded_work: _, replacement_work: _ } => "replacement-work-mismatch"
  }
}

fn directive_label(d: product.fabric.demand.SatisfactionDirective) -> std.types.NonEmptyStr {
  match d {
    product.fabric.demand.SatisfiedByTerminalReceipt => "satisfied-by-terminal-receipt"
    product.fabric.demand.AttachToExistingExecution => "attach-to-existing-execution"
    product.fabric.demand.AwaitAdmission => "await-admission"
    product.fabric.demand.RequireNewAttempt { reuse: p } =>
      match p {
        product.fabric.demand.ReuseAcceptedStepReceipts => "new-attempt-reusing-steps"
        product.fabric.demand.RefuseStepReuseAtDeclaredFrame => "new-attempt-refusing-step-reuse"
      }
  }
}

// A refusal carries no population at all, so the helper cannot return one; the
// empty registry is the honest stand-in and every test that reads it is
// asserting an arm it already named, never inferring the refusal from emptiness.
fn effect_population(e: product.fabric.arbitration.DemandCommandEffect<std.types.NonEmptyStr>) -> product.fabric.demand.DemandPopulation<std.types.NonEmptyStr> {
  match e {
    product.fabric.arbitration.CommandRefused { refusal: _ } => product.fabric.demand.empty_demand_population()
    product.fabric.arbitration.DemandAdmitted { population: p, directive: _ } => p
    product.fabric.arbitration.WorkStillRequiredAttemptContinues { population: p, remaining: _, attempts: _ } => p
    product.fabric.arbitration.WorkStillRequiredNothingRunning { population: p, remaining: _ } => p
    product.fabric.arbitration.WorkReleasedAttemptStops { population: p, work: _, release_plan: _ } => p
    product.fabric.arbitration.WorkReleasedNothingRunning { population: p, work: _ } => p
  }
}

fn released_reservations(e: product.fabric.arbitration.DemandCommandEffect<std.types.NonEmptyStr>) -> List<product.fabric.execution.ReservationRef> {
  match e {
    product.fabric.arbitration.CommandRefused { refusal: _ } => []
    product.fabric.arbitration.DemandAdmitted { population: _, directive: _ } => []
    product.fabric.arbitration.WorkStillRequiredAttemptContinues { population: _, remaining: _, attempts: _ } => []
    product.fabric.arbitration.WorkStillRequiredNothingRunning { population: _, remaining: _ } => []
    product.fabric.arbitration.WorkReleasedNothingRunning { population: _, work: _ } => []
    product.fabric.arbitration.WorkReleasedAttemptStops { population: _, work: _, release_plan: plan } =>
      plan |> flat_map(rel => concat([rel.money_reservation], rel.resource_reservations))
  }
}

fn withdraw(principal: std.types.NonEmptyStr, key: product.fabric.identity.DemandKey) -> product.fabric.demand.DemandCommand<std.types.NonEmptyStr> {
  product.fabric.demand.WithdrawDemand { demand: demand_id(principal: principal, key: key), evidence: "withdrawal-1" }
}

// The two-provider registry can only be built by submitting both demands
// through the core, because a DemandPopulation has no literal. That is the
// point of the seal: the fixture cannot author a population omitting one
// provider any more than a provider binding can.
fn both_demands() -> product.fabric.demand.DemandPopulation<std.types.NonEmptyStr> {
  let first = decide_as(
    attested: "github",
    population: product.fabric.demand.empty_demand_population(),
    grants: [],
    command: product.fabric.demand.SubmitDemand { demand: github_demand() },
  )
  effect_population(
    e: decide_as(
      attested: "gitlab",
      population: effect_population(e: first),
      grants: [],
      command: product.fabric.demand.SubmitDemand { demand: gitlab_demand() },
    ),
  )
}

// The ordinary helper attests the principal the command acts as, so every
// existing test below still exercises the population and execution logic rather
// than the attestation gate. The gate has its own tests, where the attestation
// and the command deliberately disagree.
// The witness reaches an attestation through the mint, not a record literal,
// because a record literal is exactly what the carrier no longer admits. That
// is not a concession to the wall - it is the whole population of routes to a
// CommandAttestation, which is what makes the wall worth having.
fn single_github_registry() -> product.fabric.demand.DemandPopulation<std.types.NonEmptyStr> {
  effect_population(
    e: decide_as(
      attested: "github",
      population: product.fabric.demand.empty_demand_population(),
      grants: [],
      command: product.fabric.demand.SubmitDemand { demand: github_demand() },
    ),
  )
}

fn single_gitlab_registry() -> product.fabric.demand.DemandPopulation<std.types.NonEmptyStr> {
  effect_population(
    e: decide_as(
      attested: "gitlab",
      population: product.fabric.demand.empty_demand_population(),
      grants: [],
      command: product.fabric.demand.SubmitDemand { demand: gitlab_demand() },
    ),
  )
}

fn attesting(principal: std.types.NonEmptyStr) -> product.fabric.demand.CommandAttestation<std.types.NonEmptyStr> {
  product.fabric.demand.attest_command_principal(
    principal: principal,
    evidence: "binding-auth-1",
    verification_authority: std.decl_ref.decl_ref(
      module_path: "test.claim.fabric_demand_effect_witness_test",
      decl_name: "attesting",
    ),
  )
}

// Every route to a decision below goes through admit_command, because that is
// the only route there is: decide_demand_command takes a CoreCommand, and a
// CoreCommand has no cross-module literal. A test that could hand the fold a
// command with no attestation would be testing a shape the model does not have.
fn admitted_core(
  attested: std.types.NonEmptyStr,
  command: product.fabric.demand.DemandCommand<std.types.NonEmptyStr>,
) -> List<product.fabric.demand.CoreCommand<std.types.NonEmptyStr>> {
  match product.fabric.demand.admit_command(attestation: attesting(principal: attested), command: command) {
    product.fabric.demand.CommandAdmitted { core: c } => [c]
    product.fabric.demand.CommandAdmissionRefused { refusal: _ } => []
  }
}

fn admission_label(a: product.fabric.demand.CommandAdmission<std.types.NonEmptyStr>) -> std.types.NonEmptyStr {
  match a {
    product.fabric.demand.CommandAdmitted { core: _ } => "admitted"
    product.fabric.demand.CommandAdmissionRefused { refusal: r } => refusal_label(r: r)
  }
}

// An admission refusal and an effect refusal are the same refusal vocabulary
// reached at two different boundaries, so the helper reports the admission
// cause rather than inventing a third state for "never reached the fold".
fn decide_as(
  attested: std.types.NonEmptyStr,
  population: product.fabric.demand.DemandPopulation<std.types.NonEmptyStr>,
  grants: List<product.fabric.execution.ExecutionGrant<std.types.NonEmptyStr>>,
  command: product.fabric.demand.DemandCommand<std.types.NonEmptyStr>,
) -> product.fabric.arbitration.DemandCommandEffect<std.types.NonEmptyStr> {
  match admitted_core(attested: attested, command: command) {
    Empty {} =>
      product.fabric.arbitration.CommandRefused {
        refusal: product.fabric.demand.AttestationDoesNotCoverPrincipal {
          attested: attested,
          acting: product.fabric.demand.acting_principal(command: command),
        }
      }
    Cons { head: c, tail: _ } =>
      product.fabric.arbitration.decide_demand_command(
        registry: population,
        grants: grants,
        terminal: product.fabric.demand.NoTerminalReceipt,
        core: c,
      )
  }
}

fn decide(
  population: List<product.fabric.demand.Demand<std.types.NonEmptyStr>>,
  grants: List<product.fabric.execution.ExecutionGrant<std.types.NonEmptyStr>>,
  command: product.fabric.demand.DemandCommand<std.types.NonEmptyStr>,
) -> product.fabric.arbitration.DemandCommandEffect<std.types.NonEmptyStr> {
  decide_as(
    attested: product.fabric.demand.acting_principal(command: command),
    population: population,
    grants: grants,
    command: command,
  )
}

// THE TWO-PROVIDER CLAIM, FIRST DIRECTION. One of two demands withdraws and the
// Work survives with the other still attached, so the running attempt
// continues. This is the case the prose says a provider binding cannot decide
// on its own, because only the core holds the second demand.

test fn withdrawing_one_of_two_demands_leaves_the_work_required() -> Bool {
  let e = decide(population: both_demands(), grants: [running_grant()], command: withdraw(principal: "github", key: "demand-gh"))
  effect_label(e: e) == "still-required-attempt-continues"
    && product.fabric.demand.population_demands(p: effect_population(e: e)).length() == 1
    && released_reservations(e: e).length() == 0
}

// THE MIRROR. Withdraw the second demand as well and the Work is released, the
// attempt stops, and both reservation sets are named for release. Without this
// direction the test above is satisfied by an implementation that never
// releases anything at all.

test fn withdrawing_the_last_demand_releases_the_work_and_stops_the_attempt() -> Bool {
  let after_first = decide(population: both_demands(), grants: [running_grant()], command: withdraw(principal: "github", key: "demand-gh"))
  let e = decide(
    population: effect_population(e: after_first),
    grants: [running_grant()],
    command: withdraw(principal: "gitlab", key: "demand-gl"),
  )
  effect_label(e: e) == "released-attempt-stops"
    && product.fabric.demand.population_demands(p: effect_population(e: e)).length() == 0
    && released_reservations(e: e).length() == 2
}

// Losing the last demand before any grant issued is a real state with its own
// arm, not a release directive naming an attempt that does not exist.

test fn releasing_a_work_with_nothing_running_names_no_attempt() -> Bool {
  let e = decide(population: single_github_registry(), grants: [], command: withdraw(principal: "github", key: "demand-gh"))
  effect_label(e: e) == "released-nothing-running"
    && released_reservations(e: e).length() == 0
}

// The cross-principal wall. The key is registered; the principal is not the one
// presenting it, and the refusal names the principal half rather than reporting
// the demand as unknown.
//
// That an unauthorized withdrawal cannot also have cancelled something is NOT
// asserted here, because it is not a runtime property to assert: CommandRefused
// carries no population and no release directive, so a refusal that took effect
// has no spelling. Asserting an empty population through the helper below would
// only measure that the helper returns the empty list on the refusal arm - a
// permanently green check standing where the carrier already made the state
// unwritable.

test fn a_withdrawal_from_the_wrong_principal_refuses_by_principal_not_as_unknown() -> Bool {
  effect_label(e: decide(population: both_demands(), grants: [running_grant()], command: withdraw(principal: "gitlab", key: "demand-gh")))
    == "principal-mismatch"
}

// The discriminating pair for the refusal vocabulary itself: an entirely
// unregistered key must refuse for a DIFFERENT reason than a key registered to
// someone else. One cause covering both would report a cross-tenant attempt as
// a stale binding.

test fn an_unregistered_key_refuses_as_unknown_not_as_a_principal_mismatch() -> Bool {
  effect_label(e: decide(population: both_demands(), grants: [], command: withdraw(principal: "github", key: "demand-none")))
    == "unknown-demand"
}

// terminal_receipt_may_satisfy, consumed independently. Same population, same
// execution state, same other two fields - only this one moves, and it moves
// the output between satisfaction and execution.

fn decide_with_receipt(command: product.fabric.demand.DemandCommand<std.types.NonEmptyStr>) -> product.fabric.arbitration.DemandCommandEffect<std.types.NonEmptyStr> {
  match admitted_core(attested: "github", command: command) {
    Empty {} => product.fabric.arbitration.CommandRefused { refusal: product.fabric.demand.UnknownDemand { demand: demand_id(principal: "github", key: "unreachable") } }
    Cons { head: c, tail: _ } =>
      product.fabric.arbitration.decide_demand_command(
        registry: product.fabric.demand.empty_demand_population(),
        grants: [],
        terminal: product.fabric.demand.TerminalReceiptPresent,
        core: c,
      )
  }
}

test fn the_terminal_receipt_answer_alone_decides_whether_a_receipt_satisfies() -> Bool {
  let may = demand_of(principal: "github", key: "d-1", work_key: "w-1", satisfaction: product.fabric.demand.SatisfactionRequirement { terminal_receipt_may_satisfy: true, new_attempt_required: false, step_reuse_permitted: true })
  let may_not = demand_of(principal: "github", key: "d-1", work_key: "w-1", satisfaction: product.fabric.demand.SatisfactionRequirement { terminal_receipt_may_satisfy: false, new_attempt_required: false, step_reuse_permitted: true })
  effect_label(e: decide_with_receipt(command: product.fabric.demand.SubmitDemand { demand: may }))
    == "satisfied-by-terminal-receipt"
    && effect_label(e: decide_with_receipt(command: product.fabric.demand.SubmitDemand { demand: may_not }))
      == "await-admission"
}

// new_attempt_required, consumed independently. With an execution in flight,
// this field alone decides between attaching to it and demanding a fresh
// attempt - the answer a system offering only "rerun" cannot give separately.

test fn the_new_attempt_answer_alone_decides_attach_versus_fresh_attempt() -> Bool {
  let attaches = github_demand()
  let reruns = product.fabric.demand.Demand {
    id: demand_id(principal: "github", key: "demand-gh"),
    work: work_of(principal: "fabric", key: "work-1"),
    origin: "gh-pr-7",
    submitted_at: "2026-08-24T00:00:00Z",
    admission: terms(),
    satisfaction: product.fabric.demand.SatisfactionRequirement { terminal_receipt_may_satisfy: true, new_attempt_required: true, step_reuse_permitted: true },
  }
  effect_label(e: decide(population: single_gitlab_registry(), grants: [running_grant()], command: product.fabric.demand.SubmitDemand { demand: attaches }))
    == "attach-to-existing-execution"
    && effect_label(e: decide(population: single_gitlab_registry(), grants: [running_grant()], command: product.fabric.demand.SubmitDemand { demand: reruns }))
      == "new-attempt-reusing-steps"
}

// step_reuse_permitted, consumed independently. It changes what the fresh
// attempt may reuse WITHOUT changing whether that attempt exists, which is the
// separation the three-field decomposition is for: wanting a re-execution must
// not force a clean recompute.

test fn the_step_reuse_answer_alone_decides_what_the_new_attempt_may_reuse() -> Bool {
  let reusing = demand_of(principal: "github", key: "d-2", work_key: "w-2", satisfaction: product.fabric.demand.SatisfactionRequirement { terminal_receipt_may_satisfy: false, new_attempt_required: true, step_reuse_permitted: true })
  let clean = demand_of(principal: "github", key: "d-2", work_key: "w-2", satisfaction: product.fabric.demand.SatisfactionRequirement { terminal_receipt_may_satisfy: false, new_attempt_required: true, step_reuse_permitted: false })
  effect_label(e: decide(population: product.fabric.demand.empty_demand_population(), grants: [], command: product.fabric.demand.SubmitDemand { demand: reusing }))
    == "new-attempt-reusing-steps"
    && effect_label(e: decide(population: product.fabric.demand.empty_demand_population(), grants: [], command: product.fabric.demand.SubmitDemand { demand: clean }))
      == "new-attempt-refusing-step-reuse"
}

// A supersede whose replacement names a different Work is a withdrawal plus a
// submission, and admitting it would move a demand across Works under a command
// that promises not to. The mirror is the same supersede with the Works
// matching, which must be admitted - otherwise the refusal above is satisfied
// by an implementation that refuses every supersede.

test fn a_supersede_onto_a_different_work_refuses_while_the_matching_one_is_admitted() -> Bool {
  let elsewhere = demand_of(principal: "github", key: "demand-gh2", work_key: "work-2", satisfaction: attaching_satisfaction())
  let same_work = product.fabric.demand.Demand {
    id: demand_id(principal: "github", key: "demand-gh2"),
    work: work_of(principal: "fabric", key: "work-1"),
    origin: "gh-pr-8",
    submitted_at: "2026-08-24T00:01:00Z",
    admission: terms(),
    satisfaction: attaching_satisfaction(),
  }
  let refused = decide(
    population: both_demands(),
    grants: [running_grant()],
    command: product.fabric.demand.SupersedeDemand { superseded: demand_id(principal: "github", key: "demand-gh"), replacement: elsewhere, evidence: "sup-1" },
  )
  let admitted = decide(
    population: both_demands(),
    grants: [running_grant()],
    command: product.fabric.demand.SupersedeDemand { superseded: demand_id(principal: "github", key: "demand-gh"), replacement: same_work, evidence: "sup-1" },
  )
  effect_label(e: refused) == "replacement-work-mismatch"
    && effect_label(e: admitted) == "attach-to-existing-execution"
    && product.fabric.demand.population_demands(p: effect_population(e: admitted)).length() == 2
}

// A supersede never releases a Work, because it removes one demand and adds
// one. Stating it as a test rather than as prose is what keeps a later
// refactor of the population transition from making a supersede look like a
// withdrawal to the execution half.

test fn a_supersede_of_the_only_demand_never_releases_the_work() -> Bool {
  let replacement = product.fabric.demand.Demand {
    id: demand_id(principal: "github", key: "demand-gh2"),
    work: work_of(principal: "fabric", key: "work-1"),
    origin: "gh-pr-8",
    submitted_at: "2026-08-24T00:01:00Z",
    admission: terms(),
    satisfaction: attaching_satisfaction(),
  }
  let e = decide(
    population: single_github_registry(),
    grants: [running_grant()],
    command: product.fabric.demand.SupersedeDemand { superseded: demand_id(principal: "github", key: "demand-gh"), replacement: replacement, evidence: "sup-1" },
  )
  effect_label(e: e) == "attach-to-existing-execution"
    && product.fabric.demand.population_demands(p: effect_population(e: e)).length() == 1
    && released_reservations(e: e).length() == 0
}

// A supersede may only replace the presenting requester's own demand. Without
// this wall a binding could retire another provider's demand by presenting a
// replacement under its own principal, which is the two-provider failure
// arriving through the supersede door instead of the withdrawal one.

test fn a_supersede_may_not_replace_another_principals_demand() -> Bool {
  let intruder = demand_of(principal: "gitlab", key: "demand-gh2", work_key: "work-1", satisfaction: attaching_satisfaction())
  effect_label(
    e: decide(
      population: both_demands(),
      grants: [running_grant()],
      command: product.fabric.demand.SupersedeDemand { superseded: demand_id(principal: "github", key: "demand-gh"), replacement: intruder, evidence: "sup-1" },
    ),
  ) == "supersede-crosses-principal"
}

// Re-submitting under a live identity refuses rather than overwriting. An
// overwrite would let a binding change a live demand's buy terms and
// satisfaction requirement without presenting the evidence a supersede needs.

test fn resubmitting_a_registered_identity_refuses_rather_than_overwriting() -> Bool {
  effect_label(e: decide(population: both_demands(), grants: [], command: product.fabric.demand.SubmitDemand { demand: github_demand() }))
    == "duplicate-demand"
}

// THE IMPERSONATION WALL (review 55256, first finding). The refusal is asserted
// at admit_command rather than at the fold, because that is where it now lives:
// an inconsistent CoreCommand is unconstructable, so the fold has no such arm to
// exercise. The mirror still runs the full decision, which is what proves the
// mint admits as well as refuses.
//
// The identity presented
// is entirely correct - right principal, right key, registered exactly as
// spelled - and that is the point: the principal-mismatch arm cannot see this
// case at all, because there is no mismatch to see. What refuses it is that the
// caller attested to being github and acted as gitlab.
//
// The mirror is the same command with a truthful attestation, which must be
// admitted. Without it, this test is satisfied by a gate that refuses every
// withdrawal.

test fn a_binding_may_not_withdraw_a_demand_it_did_not_attest_to() -> Bool {
  let impersonating = product.fabric.demand.admit_command(
    attestation: attesting(principal: "github"),
    command: withdraw(principal: "gitlab", key: "demand-gl"),
  )
  let truthful = decide_as(
    attested: "gitlab",
    population: both_demands(),
    grants: [running_grant()],
    command: withdraw(principal: "gitlab", key: "demand-gl"),
  )
  admission_label(a: impersonating) == "attestation-does-not-cover-principal"
    && effect_label(e: truthful) == "still-required-attempt-continues"
}

// The gate covers submission too, so a binding cannot register a demand under a
// principal it did not authenticate and then withdraw it truthfully afterwards.

test fn a_binding_may_not_submit_a_demand_under_a_principal_it_did_not_attest_to() -> Bool {
  admission_label(
    a: product.fabric.demand.admit_command(
      attestation: attesting(principal: "github"),
      command: product.fabric.demand.SubmitDemand { demand: gitlab_demand() },
    ),
  ) == "attestation-does-not-cover-principal"
}

// THE RESERVATION LEAK (review 55256, second finding). new_attempt_required
// admits a fresh attempt while one is running, so two grants against one Work
// is an ordinary state rather than a corner. When the last demand goes, EVERY
// grant's capacity and budget must be named for release: an effect that
// released the first and dropped the tail would strand a machine still billing
// under a Work nothing requires.
//
// The count is the discriminator. Each grant carries one money reservation and
// one resource reservation, so two grants must yield four named reservations -
// a head-only implementation yields two and this goes red.

fn second_running_grant() -> product.fabric.execution.ExecutionGrant<std.types.NonEmptyStr> {
  product.fabric.execution.ExecutionGrant {
    id: product.fabric.identity.FabricIdentity { principal: "fabric", key: "grant-2" },
    object: product.fabric.execution.FabricGrantObject {
      offer: product.fabric.identity.FabricIdentity { principal: "supplier", key: "offer-2" },
      quote: product.fabric.supply.QuotedFlatPerGrant(
        std.measure.MoneyOnce { amount: std.measure.money_amount_micro(count: 50000), currency: std.currency.Usd },
      ),
    },
    context: product.fabric.execution.FabricGrantContext {
      demand: demand_id(principal: "gitlab", key: "demand-gl"),
      work: work_of(principal: "fabric", key: "work-1"),
      attempt: product.fabric.identity.FabricIdentity { principal: "fabric", key: "attempt-2" },
      executor: "supplier",
      lease: product.fabric.execution.LeaseIdentity {
        lease_key: "lease-2",
        resource_fingerprint: std.content_hash.content_hash_of_value(value: "slice-b"),
        generation: 1,
      },
      issued_at: "2026-08-24T00:00:03Z",
      maximum_liability: std.measure.money_amount_micro(count: 200000),
    },
    evidence: product.fabric.execution.FabricGrantEvidence {
      fungibility_receipt: "ev-1",
      offer_authority: "ev-2",
      resource_conservation: "ev-3",
      budget_conservation: "ev-4",
      principal_authority: "ev-5",
    },
    resource_reservations: ["res-cpu-2"],
    money_reservation: "res-money-2",
  }
}

test fn releasing_a_work_names_every_grants_reservations_not_just_the_first() -> Bool {
  let after_first = decide(
    population: both_demands(),
    grants: [running_grant(), second_running_grant()],
    command: withdraw(principal: "github", key: "demand-gh"),
  )
  let released = decide(
    population: effect_population(e: after_first),
    grants: [running_grant(), second_running_grant()],
    command: withdraw(principal: "gitlab", key: "demand-gl"),
  )
  effect_label(e: released) == "released-attempt-stops"
    && released_reservations(e: released).length() == 4
}

// The same blindness on the surviving-work arm: while a Work is still required,
// every running attempt continues, and an arm naming one of them would tell the
// caller to keep one alive while saying nothing about the others.

test fn a_surviving_work_names_every_running_attempt() -> Bool {
  let e = decide(
    population: both_demands(),
    grants: [running_grant(), second_running_grant()],
    command: withdraw(principal: "github", key: "demand-gh"),
  )
  effect_label(e: e) == "still-required-attempt-continues"
    && continuing_attempts(e: e).length() == 2
}

fn continuing_attempts(
  e: product.fabric.arbitration.DemandCommandEffect<std.types.NonEmptyStr>,
) -> List<product.fabric.identity.FabricIdentity<std.types.NonEmptyStr, product.fabric.identity.ExecutionAttemptKey>> {
  match e {
    product.fabric.arbitration.CommandRefused { refusal: _ } => []
    product.fabric.arbitration.DemandAdmitted { population: _, directive: _ } => []
    product.fabric.arbitration.WorkStillRequiredNothingRunning { population: _, remaining: _ } => []
    product.fabric.arbitration.WorkReleasedNothingRunning { population: _, work: _ } => []
    product.fabric.arbitration.WorkReleasedAttemptStops { population: _, work: _, release_plan: _ } => []
    product.fabric.arbitration.WorkStillRequiredAttemptContinues { population: _, remaining: _, attempts: a } => a
  }
}

// THE POPULATION SEAL (review 55310, first finding). The two-provider claim was
// only as strong as the population argument carrying it: a caller handing in an
// ordinary List could omit the other provider's demand, and the fold would
// correctly conclude nothing required the Work and release it. The list was the
// forgery surface the attestation work had already closed one layer in.
//
// This test is the positive half - the registry threaded through the core's own
// transitions holds both demands, so the withdrawal finds the survivor. The
// negative half is not a test and cannot be: a DemandPopulation omitting a
// demand has no literal, so the fixture cannot author one to feed in. That
// refusal is measured as a compile-time RED probe rather than asserted here,
// because a runtime test of an unconstructable value would be permanently green.

test fn the_registry_can_only_be_built_by_the_cores_own_transitions() -> Bool {
  product.fabric.demand.population_demands(p: both_demands()).length() == 2
    && effect_label(
      e: decide(
        population: both_demands(),
        grants: [running_grant()],
        command: withdraw(principal: "github", key: "demand-gh"),
      ),
    ) == "still-required-attempt-continues"
}

// THE VERIFIER PROVENANCE REACHES THE RELEASE (review 55310, second finding).
// verification_authority named who vouched on the attestation and was then
// dropped when the effect was produced, so the artifact a later reader actually
// finds - the release - could not answer it. Asserting the receipt alone would
// have passed against that defect, which is why this reads the authority.

test fn a_release_names_the_authority_that_vouched_for_the_command() -> Bool {
  let after_first = decide(
    population: both_demands(),
    grants: [running_grant()],
    command: withdraw(principal: "github", key: "demand-gh"),
  )
  let released = decide(
    population: effect_population(e: after_first),
    grants: [running_grant()],
    command: withdraw(principal: "gitlab", key: "demand-gl"),
  )
  effect_label(e: released) == "released-attempt-stops"
    && release_authorities(e: released).length() == 1
}

fn release_authorities(e: product.fabric.arbitration.DemandCommandEffect<std.types.NonEmptyStr>) -> List<std.decl_ref.DeclarationRef> {
  match e {
    product.fabric.arbitration.CommandRefused { refusal: _ } => []
    product.fabric.arbitration.DemandAdmitted { population: _, directive: _ } => []
    product.fabric.arbitration.WorkStillRequiredNothingRunning { population: _, remaining: _ } => []
    product.fabric.arbitration.WorkStillRequiredAttemptContinues { population: _, remaining: _, attempts: _ } => []
    product.fabric.arbitration.WorkReleasedNothingRunning { population: _, work: _ } => []
    product.fabric.arbitration.WorkReleasedAttemptStops { population: _, work: _, release_plan: plan } =>
      plan
        |> filter(rel => rel.vouched_by == witness_authority())
        |> map(rel => rel.vouched_by)
  }
}

fn witness_authority() -> std.decl_ref.DeclarationRef {
  std.decl_ref.decl_ref(
    module_path: "test.claim.fabric_demand_effect_witness_test",
    decl_name: "attesting",
  )
}
