test fn a_generic_applied_to_a_type_variable_keeps_its_reading() -> Bool {
  eq_admitted(source: "module test.claim.deq_applied_var_control\ntype DeqBox<C> { value: C }\nfn deq_same<T>(a: DeqBox<T>, b: DeqBox<T>) -> Bool { a == b }\n")
    && compile_dag_rust_emit_check(
      "module test.claim.deq_applied_var_control\ntype DeqBox<C> { value: C }\nfn deq_same<T>(a: DeqBox<T>, b: DeqBox<T>) -> Bool { a == b }\n",
      "src/test_claim_deq_applied_var_control.rs",
      ["fn deq_same"],
      []
    )
}

// A container nested in a container is walked, not cut. The walk recorded a container's own identity as
// visited, so the inner List of List<Arm> -> Acc -> List<Facts> met "already visited" and returned a step with
// no plan: the generic Witness below it was never seen, the outer record was judged synthesizable, and its
// synthesized body compared Arm, whose own walk does see Witness, so the module refused its own generated
// code (measured on v2.compiler.infer InferBranchHold, then on this four-declaration shape). The red is the
// authored comparison of the outer record, which must now refuse at the author's site; the control is the same
// nesting over a routed Node with no generic, which must stay planned and define its function.
test fn a_generic_below_nested_containers_refuses_at_the_authored_comparison() -> Bool {
  eq_blocking_count(source: "module test.claim.deq_nested_container_red\nimport v2.std.node { Node }\nimport v2.std.witness { Witness }\nimport std.types { List }\ntype DeqNestFacts { descent: Witness<Int>  at: Node }\ntype DeqNestAcc { facts: List<DeqNestFacts> }\ntype DeqNestArm { settled: DeqNestAcc  n: Node }\ntype DeqNestHold { held: List<DeqNestArm> }\nfn same(a: DeqNestHold, b: DeqNestHold) -> Bool { a == b }\n", wanted: "EqualityMemberUnjudgeable") >= 1
}

test fn nested_containers_over_a_routed_leaf_still_define_their_derived_equality() -> Bool {
  compile_dag_rust_emit_check(
    "module test.claim.deq_nested_container_green\nimport v2.std.node { Node }\nimport std.types { List }\ntype DeqNestFacts { at: Node }\ntype DeqNestAcc { facts: List<DeqNestFacts> }\ntype DeqNestArm { settled: DeqNestAcc  n: Node }\ntype DeqNestHold { held: List<DeqNestArm> }\nfn same(a: DeqNestHold, b: DeqNestHold) -> Bool { a == b }\n",
    "src/test_claim_deq_nested_container_green.rs",
    ["fn equality_derived_deq_nest_hold(", "fn equality_derived_deq_nest_arm(", "fn equality_derived_deq_nest_facts("],
    []
  )
}

test fn presence_test_stays_admitted() -> Bool {
  eq_census_clean(source: presence_test_green_source)
}

// T? == T (gunbc.recurring_failure_mode optional_compared_with_required_value). Before the arm
// in v1.compiler.infer equality_admission_diags these compiled clean and the Rust emitter
// rendered `Option<T> == T` (rustc E0308, std.filesystem is_text_readable). The red is a
// field typed `Kind?` compared with a bare variant, in both operand orders; the controls are
// the explicit spellings the refusal names (a Present comparison, a match) and two optionals
// compared with each other, which the arm must not widen into.
data optionality_mismatch_red_source: String = "module eq_probe_optionality\ntype Kind = A | B\ntype Row { kind: Kind? }\nfn is_a(r: Row) -> Bool { r.kind == A }\n"

data optionality_mismatch_reversed_red_source: String = "module eq_probe_optionality_rev\ntype Kind = A | B\ntype Row { kind: Kind? }\nfn is_a(r: Row) -> Bool { A != r.kind }\n"

// The value-position `Present { value: .. }` imports std.optional explicitly: the `T?` sugar names the
// declaration at the TYPE grain only and grants no ambient prelude (gunbc.design_ruling
// optional_sugar_is_declaration_bound), so the constructor must be in scope for the arm/payload/member
// to resolve and the Present to admit (gunbc.design_ruling explicit_present_is_the_authoring_policy).
data optionality_explicit_present_green_source: String = "module eq_probe_optionality_present\nimport std.optional { Present }\ntype Kind = A | B\ntype Row { kind: Kind? }\nfn is_a(r: Row) -> Bool { r.kind == Present { value: A } }\n"

data optionality_explicit_match_green_source: String = "module eq_probe_optionality_match\ntype Kind = A | B\ntype Row { kind: Kind? }\nfn is_a(r: Row) -> Bool {\n  match r.kind {\n    Present { value: k } => k == A\n    Absent => false\n  }\n}\n"

data optionality_both_optional_green_source: String = "module eq_probe_optionality_both\ntype Kind = A | B\ntype Row { kind: Kind? }\nfn same(a: Row, b: Row) -> Bool { a.kind == b.kind }\n"

test fn optional_compared_with_required_value_refuses_blocking() -> Bool {
  eq_blocking_count(source: optionality_mismatch_red_source, wanted: "EqualityOptionalityMismatch") == 1
}

test fn required_compared_with_optional_value_refuses_blocking() -> Bool {
  eq_blocking_count(source: optionality_mismatch_reversed_red_source, wanted: "EqualityOptionalityMismatch") == 1
}

test fn explicit_present_comparison_stays_admitted() -> Bool {
  eq_admitted(source: optionality_explicit_present_green_source)
}

test fn explicit_match_on_optional_stays_admitted() -> Bool {
  eq_admitted(source: optionality_explicit_match_green_source)
}

test fn optional_compared_with_optional_stays_admitted() -> Bool {
  eq_admitted(source: optionality_both_optional_green_source)
}

// C5 (gunbc.recurring_failure_mode bare_value_admitted_where_optional_is_declared), AT THE DECLARED RETURN: a fn declared `-> T?` whose body produces a bare T. No
// declared coercion lifts T into T?, and the Rust emission refused it (E0308, gunbc.running_release_
// identity running_release_member_string). The red is a bare-Int body under `-> Int?`; the controls
// are the explicit present spelling and the absent spelling, which the arm must not widen into.
data return_lift_red_source: String = "module ret_probe_lift\nfn f(x: Int) -> Int? { x }\n"

// The value-position `Present { value: .. }` imports std.optional explicitly: the `T?` sugar names the
// declaration at the TYPE grain only and grants no ambient prelude (gunbc.design_ruling
// optional_sugar_is_declaration_bound), so the constructor must be in scope for the arm/payload/member
// to resolve and the Present to admit (gunbc.design_ruling explicit_present_is_the_authoring_policy).
data return_explicit_present_green_source: String = "module ret_probe_present\nimport std.optional { Present }\nfn f(x: Int) -> Int? { Present { value: x } }\n"

data return_absent_green_source: String = "module ret_probe_absent\nfn f(x: Int) -> Int? { none }\n"

test fn required_body_at_optional_return_refuses_blocking() -> Bool {
  eq_blocking_count(source: return_lift_red_source, wanted: "DeclaredTypeNotInhabited") == 1
}

test fn explicit_present_return_stays_admitted() -> Bool {
  eq_admitted(source: return_explicit_present_green_source)
}

test fn absent_return_stays_admitted() -> Bool {
  eq_admitted(source: return_absent_green_source)
}

data return_lift_match_arm_red_source: String = "module ret_probe_arm\nfn g(s: String) -> String? {\n  match s {\n    \"a\" => s\n    _ => none\n  }\n}\n"

test fn required_arm_at_optional_return_refuses_blocking() -> Bool {
  eq_blocking_count(source: return_lift_match_arm_red_source, wanted: "DeclaredTypeNotInhabited") >= 1
}

// Arm ORDER must not decide the verdict (review 76904): the join keeps the first arm's type, so with
// `none` listed first the bare arm was never judged against the declared return.
data return_lift_match_arm_swapped_red_source: String = "module ret_probe_arm_swapped\nfn g(s: String) -> String? {\n  match s {\n    \"b\" => none\n    _ => s\n  }\n}\n"

test fn required_arm_after_none_arm_refuses_blocking() -> Bool {
  eq_blocking_count(source: return_lift_match_arm_swapped_red_source, wanted: "DeclaredTypeNotInhabited") >= 1
}

// CLAIMED SCOPE of the match-arm wall (ruling B, gunbc#13280): an arm whose whole body is the payload
// binding of `Present { value: x }` is not judged, because infer types that payload single-level (see
// nested_optional_collapsed_by_infer_carried_by_emission). The control is the mtcollins1 shape; the red
// proves the exclusion is narrow: the same arm returning a bare non-binding value still refuses.
data present_payload_arm_control_source: String = "module present_payload_probe\nfn g(xs: List<String?>) -> String? {\n  match xs.first() {\n    Absent => none\n    Present { value: r } => r\n  }\n}\n"

data present_payload_arm_narrow_red_source: String = "module present_payload_probe_red\nfn g(xs: List<String?>, s: String) -> String? {\n  match xs.first() {\n    Absent => none\n    Present { value: r } => s\n  }\n}\n"

// The exclusion switches off ONLY the bare-versus-optional check: a payload-binding arm that is
// genuinely disjoint from its sibling (String vs Int) still reaches the proven-disjoint wall.
data present_payload_arm_disjoint_red_source: String = "module present_payload_probe_disjoint\nfn g(x: Int?) -> String {\n  match x {\n    Absent => \"s\"\n    Present { value: r } => r\n  }\n}\n"

test fn present_payload_arm_disjoint_from_sibling_still_refuses() -> Bool {
  eq_blocking_count_at_subject(
    source: present_payload_arm_disjoint_red_source,
    wanted: "InternalError",
    subject: "match arms produce proven-disjoint types: Primitive(String) vs Primitive(Int)") == 1
}

test fn present_payload_binding_arm_stays_admitted() -> Bool {
  eq_admitted(source: present_payload_arm_control_source)
}

test fn present_pattern_arm_with_other_bare_value_still_refuses() -> Bool {
  eq_blocking_count(source: present_payload_arm_narrow_red_source, wanted: "DeclaredTypeNotInhabited") >= 1
}

// THE SAME CLASS AT A DATA INITIALIZER (ruling A on gunbc#13202). A `data r: T? = <bare T>` row was
// emitted bare against Option<..> and refused only downstream by rustc; the checker now refuses it.
// The red's T is a coproduct with a nested-record variant, the specimen that exposed the class; the
// control is the same row spelled Present { value: .. }.
data data_row_bare_lift_red_source: String = "module data_probe_lift\ntype Inner {\n  n: Int\n}\ntype Shape\n  = Circle { inner: Inner }\n  | NoShape\ndata shape_row: Shape? = Circle { inner: Inner { n: 1 } }\n"

// The value-position `Present { value: .. }` imports std.optional explicitly: the `T?` sugar names the
// declaration at the TYPE grain only and grants no ambient prelude (gunbc.design_ruling
// optional_sugar_is_declaration_bound), so the constructor must be in scope for the arm/payload/member
// to resolve and the Present to admit (gunbc.design_ruling explicit_present_is_the_authoring_policy).
data data_row_present_spelled_green_source: String = "module data_probe_present\nimport std.optional { Present }\ntype Inner {\n  n: Int\n}\ntype Shape\n  = Circle { inner: Inner }\n  | NoShape\ndata shape_row: Shape? = Present { value: Circle { inner: Inner { n: 1 } } }\n"

test fn bare_data_initializer_at_optional_row_refuses_blocking() -> Bool {
  eq_blocking_count(source: data_row_bare_lift_red_source, wanted: "DeclaredTypeNotInhabited") == 1
}

test fn present_spelled_data_initializer_stays_admitted() -> Bool {
  eq_admitted(source: data_row_present_spelled_green_source)
}

// THE TABLE IS KEYED BY DECLARATION IDENTITY, NOT BY NAME (review of gunbc#15175, condition 1). Two modules declare a type named
// DkCell: dk.cell_a's carries a function member (no derived equality), dk.cell_b's is plain. Each holder applies the generic
// DkBox to ITS cell and each compare is judged by its own cell's reading. The insert key (node_declaration_identity) and the
// lookup key (type_reference_identity over the resolved reference) both end in node_declaration_identity, so they are one
// function. A name-keyed table answers one of the two holders wrongly, so the two directions below can not both hold.
// ORDER: realize_module realizes a module's resolved_imports before typechecking it and the seed drivers walk dependencies
// first, so a holder's lookup of an imported declaration finds the entry its declaring module inserted; a same-batch peer is
// never imported and is never looked up.
data dk_box_source: String = "module dk.box\ntype DkBox<C> { value: C }\n"

data dk_cell_a_source: String = "module dk.cell_a\ntype DkCell { f: fn(Int) -> Int }\n"

data dk_cell_b_source: String = "module dk.cell_b\ntype DkCell { v: Int }\n"

data dk_entry_source: String = "module dk.entry\nimport dk.hold_a { DkHoldA }\nimport dk.hold_b { DkHoldB }\n"

data dk_hold_a_plain_source: String = "module dk.hold_a\nimport dk.box { DkBox }\nimport dk.cell_a { DkCell }\ntype DkHoldA { b: DkBox<DkCell> }\n"

data dk_hold_a_compares_source: String = "module dk.hold_a\nimport dk.box { DkBox }\nimport dk.cell_a { DkCell }\ntype DkHoldA { b: DkBox<DkCell> }\nfn dk_same_a(x: DkHoldA, y: DkHoldA) -> Bool { x == y }\n"

data dk_hold_b_plain_source: String = "module dk.hold_b\nimport dk.box { DkBox }\nimport dk.cell_b { DkCell }\ntype DkHoldB { b: DkBox<DkCell> }\n"

data dk_hold_b_compares_source: String = "module dk.hold_b\nimport dk.box { DkBox }\nimport dk.cell_b { DkCell }\ntype DkHoldB { b: DkBox<DkCell> }\nfn dk_same_b(x: DkHoldB, y: DkHoldB) -> Bool { x == y }\n"

fn dk_run(a_compares: Bool, b_compares: Bool) -> MultiModuleCompileFixtureOutcome {
  compile_fixture(MultiModuleCompileFixture {
    sources: [
      fixture_source("dk/box.dag", dk_box_source),
      fixture_source("dk/cell_a.dag", dk_cell_a_source),
      fixture_source("dk/cell_b.dag", dk_cell_b_source),
      fixture_source("dk/hold_a.dag", (if a_compares { dk_hold_a_compares_source } else { dk_hold_a_plain_source })),
      fixture_source("dk/hold_b.dag", (if b_compares { dk_hold_b_compares_source } else { dk_hold_b_plain_source })),
      fixture_source("dk/entry.dag", dk_entry_source)
    ],
    entry: "dk/entry.dag"
  })
}

test fn the_table_answers_the_holder_of_the_function_member_cell_by_identity() -> Bool {
  match dk_run(a_compares: true, b_compares: false) {
    FixtureCompileRefused { module_count: _, diagnostics: rows, source_digest: _, compiler_digest: _ } =>
      fixture_has_class(rows: rows, wanted: "EqualityOnFunctionMember") || fixture_has_class(rows: rows, wanted: "EqualityMemberUnjudgeable")
    FixtureCompileCompleted { module_count: _, emitted_files: _, resolved_rust_functions: _, diagnostics: _, source_digest: _, compiler_digest: _ } => false
    FixtureInstrumentRefused { cause: _ } => false
  }
}

test fn the_table_admits_the_holder_of_the_same_named_plain_cell_by_identity() -> Bool {
  match dk_run(a_compares: false, b_compares: true) {
    FixtureCompileCompleted { module_count: _, emitted_files: _, resolved_rust_functions: _, diagnostics: rows, source_digest: _, compiler_digest: _ } =>
      count(fixture_blocking_rows(rows: rows)) == 0
    FixtureCompileRefused { module_count: _, diagnostics: _, source_digest: _, compiler_digest: _ } => false
    FixtureInstrumentRefused { cause: _ } => false
  }
}

// AN IMPORTED GENERIC KEEPS ITS APPLIED ARGUMENTS (gunbc#15175, measured srdk22-srdk24 on gunbc compile): comparing
// DkBox<S9Cell> with DkBox declared in another module and S9Cell a local function-member record was admitted with zero
// diagnostics, directly and through a holder, while the same shapes refused when the generic was declared in the
// comparing module. The reference's expansion is a declaration, and walking that declaration as a fresh operand dropped
// the arguments. The control is the same compare over a plain cell, which must stay admitted.
data dk_s9_red_source: String = "module dk.s9\nimport dk.box { DkBox }\ntype S9Cell { f: fn(Int) -> Int }\nfn s9_same(x: DkBox<S9Cell>, y: DkBox<S9Cell>) -> Bool { x == y }\n"

data dk_s9_control_source: String = "module dk.s9\nimport dk.box { DkBox }\ntype S9Cell { v: Int }\nfn s9_same(x: DkBox<S9Cell>, y: DkBox<S9Cell>) -> Bool { x == y }\n"

fn dk_s9_run(s9_source: String) -> MultiModuleCompileFixtureOutcome {
  compile_fixture(MultiModuleCompileFixture {
    sources: [
      fixture_source("dk/box.dag", dk_box_source),
      fixture_source("dk/s9.dag", s9_source)
    ],
    entry: "dk/s9.dag"
  })
}

test fn an_imported_generic_applied_to_a_function_member_cell_refuses() -> Bool {
  match dk_s9_run(s9_source: dk_s9_red_source) {
    FixtureCompileRefused { module_count: _, diagnostics: rows, source_digest: _, compiler_digest: _ } =>
      fixture_has_class(rows: rows, wanted: "EqualityMemberUnjudgeable") || fixture_has_class(rows: rows, wanted: "EqualityOnFunctionMember")
    FixtureCompileCompleted { module_count: _, emitted_files: _, resolved_rust_functions: _, diagnostics: rows, source_digest: _, compiler_digest: _ } =>
      fixture_has_class(rows: rows, wanted: "EqualityMemberUnjudgeable") || fixture_has_class(rows: rows, wanted: "EqualityOnFunctionMember")
    FixtureInstrumentRefused { cause: _ } => false
  }
}

test fn an_imported_generic_applied_to_a_plain_cell_stays_admitted() -> Bool {
  match dk_s9_run(s9_source: dk_s9_control_source) {
    FixtureCompileCompleted { module_count: _, emitted_files: _, resolved_rust_functions: _, diagnostics: rows, source_digest: _, compiler_digest: _ } =>
      count(fixture_blocking_rows(rows: rows)) == 0
    FixtureCompileRefused { module_count: _, diagnostics: _, source_digest: _, compiler_digest: _ } => false
    FixtureInstrumentRefused { cause: _ } => false
  }
}

// A MARKER DECLARATION APPLIED AS AN ARGUMENT STAYS ADMITTED, BY A POSITIVE FACT (gunbc#15175, heal run 41981909434 on extdeps.vendor):
// Vendor<Hardware> compares in dag/extdeps/cpu/types.dag with Hardware declared as `type Hardware` in another module. The table named only
// declarations with members, so the argument fell to the end of equality_argument_by_target and was refused. A declaration with no
// members, refinement, annotation or head-erasing property is a marker (equality_declaration_is_marker, read from the declaration) and the
// table now names it. Absence from the table is still a refusal: the RED below applies the same generic to an alias of a function type, a
// head in scope whose equality cannot be judged, and it must refuse. The positive row is the phantom marker.
data dk_phantom_source: String = "module dk.phantom\ntype DkPhantom\n"

data dk_s10_source: String = "module dk.s10\nimport dk.box { DkBox }\nimport dk.phantom { DkPhantom }\nfn s10_same(x: DkBox<DkPhantom>, y: DkBox<DkPhantom>) -> Bool { x == y }\n"

fn dk_s10_run() -> MultiModuleCompileFixtureOutcome {
  compile_fixture(MultiModuleCompileFixture {
    sources: [
      fixture_source("dk/box.dag", dk_box_source),
      fixture_source("dk/phantom.dag", dk_phantom_source),
      fixture_source("dk/s10.dag", dk_s10_source)
    ],
    entry: "dk/s10.dag"
  })
}

test fn an_imported_generic_applied_to_a_nullary_declared_type_stays_admitted() -> Bool {
  match dk_s10_run() {
    FixtureCompileCompleted { module_count: _, emitted_files: _, resolved_rust_functions: _, diagnostics: rows, source_digest: _, compiler_digest: _ } =>
      count(fixture_blocking_rows(rows: rows)) == 0
    FixtureCompileRefused { module_count: _, diagnostics: _, source_digest: _, compiler_digest: _ } => false
    FixtureInstrumentRefused { cause: _ } => false
  }
}

data dk_s10_red_source: String = "module dk.s10\nimport dk.box { DkBox }\ntype DkFnAlias = fn(Int) -> Int\nfn s10_same(x: DkBox<DkFnAlias>, y: DkBox<DkFnAlias>) -> Bool { x == y }\n"

fn dk_s10_red_run() -> MultiModuleCompileFixtureOutcome {
  compile_fixture(MultiModuleCompileFixture {
    sources: [
      fixture_source("dk/box.dag", dk_box_source),
      fixture_source("dk/s10.dag", dk_s10_red_source)
    ],
    entry: "dk/s10.dag"
  })
}

test fn an_imported_generic_applied_to_an_alias_of_a_function_type_still_refuses() -> Bool {
  match dk_s10_red_run() {
    FixtureCompileRefused { module_count: _, diagnostics: rows, source_digest: _, compiler_digest: _ } =>
      fixture_has_class(rows: rows, wanted: "EqualityMemberUnjudgeable") || fixture_has_class(rows: rows, wanted: "EqualityOnFunctionMember")
    FixtureCompileCompleted { module_count: _, emitted_files: _, resolved_rust_functions: _, diagnostics: rows, source_digest: _, compiler_digest: _ } =>
      fixture_has_class(rows: rows, wanted: "EqualityMemberUnjudgeable") || fixture_has_class(rows: rows, wanted: "EqualityOnFunctionMember")
    FixtureInstrumentRefused { cause: _ } => false
  }
}

// ============================================================================
// ALIAS OPERANDS OF == ARE JUDGED BY THEIR EXPANSION (srdk26 a4/a5; this change).
//
// The equality admission wall must judge an alias operand by the structure it names,
// not by the alias shell. Before the fix, `expand_nominal_alias_rhs_by_name` returned
// the ungrounded NoConnective leaf for a same-module nominal alias (TypeBinding.resolved
// is the ungrounded leaf; the target lives on TypeBinding.alias_rhs), so `== ` on an
// alias-to-record-with-a-function-member was ADMITTED with the member never judged --
// the exposure_refusal branch let the shell through. The fix grounds a nominal alias
// from binding.alias_rhs via resolve_node_bounded, so the walk sees the record's fn
// member and refuses, exactly as it does for the concrete record (BASE).
//
// The reds assert the wall refuses with subject == the ALIAS name (OpsAlias), the sharp
// discriminator: it is 0 before the fix and 1 after, and it proves the ALIAS operand --
// not some other leaf -- is what got judged. a5 is the same defect reached one level in
// (a record HOLDING the alias), proving the grounding composes through the structural
// walk, not just at the top operand.
//
// The greens are the admissions the fix must NOT widen into: a plain (non-function)
// alias-to-record, and a local generic alias to a plain-cell instantiation. Both stay
// admitted; they were green before and must stay green.
//
// a1/a3 (IMPORTED generic alias, and a local generic alias to a fn-bearing cell) are NOT
// asserted here: they need the applied-args-on-re-entry arm landing in #15175 and were
// measured unchanged (a3: 0 rows; a1: 42 rows, none of class EqualityOnFunctionMember)
// both before and after this fix. They are reported as a separate follow-up boundary,
// not claimed as this change's behaviour.
data alias_fn_record_eq_red_source: String = "module eq_probe_alias_fn_record\ntype Ops {\n  step: fn(Int) -> Int\n}\ntype OpsAlias = Ops\nfn same(a: OpsAlias, b: OpsAlias) -> Bool { a == b }\n"

data alias_holder_of_alias_eq_red_source: String = "module eq_probe_alias_holder\ntype Ops {\n  step: fn(Int) -> Int\n}\ntype OpsAlias = Ops\ntype Holder {\n  ops: OpsAlias\n}\nfn same(a: Holder, b: Holder) -> Bool { a == b }\n"

data plain_alias_eq_green_source: String = "module eq_probe_alias_plain\ntype Cell {\n  value: Int\n}\ntype CellAlias = Cell\nfn same(a: CellAlias, b: CellAlias) -> Bool { a == b }\n"

data local_generic_plain_alias_eq_green_source: String = "module eq_probe_alias_local_generic_plain\ntype Cell<T> {\n  value: T\n}\ntype CellInt = Cell<Int>\nfn same(a: CellInt, b: CellInt) -> Bool { a == b }\n"

test fn alias_operand_of_equality_refuses_by_expansion() -> Bool {
  eq_blocking_count_at_subject(source: alias_fn_record_eq_red_source, wanted: "EqualityOnFunctionMember", subject: "OpsAlias") >= 1
}

test fn alias_held_by_record_operand_refuses_by_expansion() -> Bool {
  eq_blocking_count_at_subject(source: alias_holder_of_alias_eq_red_source, wanted: "EqualityOnFunctionMember", subject: "OpsAlias") >= 1
}

test fn plain_non_function_alias_operand_stays_admitted() -> Bool {
  eq_admitted(source: plain_alias_eq_green_source)
}

test fn local_generic_plain_alias_operand_stays_admitted() -> Bool {
  eq_admitted(source: local_generic_plain_alias_eq_green_source)
}
