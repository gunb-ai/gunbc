// An Edge carries provenance (Edge.declaration) that derived == compares and the erasure routes do not:
// declared equality-inadmissible. The positive control is structural_record_equality_stays_admitted.
test fn edge_equality_refuses_blocking() -> Bool {
  eq_blocking_count(source: edge_eq_red_source, wanted: "EqualityOnInadmissibleType") >= 1
}

// Below the root an Edge member is a value: the record compares it through its route
// (node_edge_equal_ignoring_provenance), member by member, so the record is admitted.
test fn edge_reached_through_a_record_is_admitted_through_its_route() -> Bool {
  eq_admitted(source: edge_in_record_eq_green_source)
}

// Node reaches Edge through its children: derived == on a Node compares occurrence ids and
// Edge.declaration. The named erasure routes are the positive control.
test fn node_equality_refuses_blocking() -> Bool {
  eq_blocking_count(source: node_eq_red_source, wanted: "EqualityOnInadmissibleType") >= 1
}

test fn node_erasure_routes_stay_admitted() -> Bool {
  eq_admitted(source: node_erasure_route_green_source)
}

// DERIVED EQUALITY WITH ROUTED LEAVES (std.operator_realization EqualityPlan): a composite reaching Node is
// admitted anywhere, comparing a bare Node member as a value and a NodeOccurrence member as the same
// occurrence; a NodeOccurrence is itself comparable at the root, a bare Node or Edge is not. What each
// comparison answers is exercised by execution in v2.test.claim.derived_equality_routes.
test fn composite_reaching_node_is_admitted_through_the_plan() -> Bool {
  eq_admitted(source: composite_reaching_node_green_source)
}

test fn composite_reaching_node_and_node_occurrence_is_admitted() -> Bool {
  eq_admitted(source: composite_reaching_node_occurrence_green_source)
}

test fn node_occurrence_root_is_admitted() -> Bool {
  eq_admitted(source: node_occurrence_root_green_source)
}

// THE RESIDUAL'S CENSUS ROWS ARE NEVER A VERDICT (gunbc.rung_drop derived_equality_residual_field_equality,
// condition of sleek-owl-397's 2026-10-25 admission): each source below is ACCEPTED -- no blocking row --
// while carrying its census row, so promoting either class into a gate turns these red.
fn eq_class_count(source: String, wanted: String) -> Int {
  match eq_census_of(source: source) {
    CensusObserved { rows: rows } => census_total_count(rows: census_rows_of_class(rows: rows, wanted: wanted))
    CensusNotRunnable { cause: _ } => 0 - 1
  }
}

test fn generic_eq_census_row_is_present_and_the_program_stays_accepted() -> Bool {
  eq_admitted(source: generic_eq_census_row_source)
    && eq_class_count(source: generic_eq_census_row_source, wanted: "EqualityInstantiationBlindGenericSite") >= 1
}

test fn collection_key_census_row_is_present_and_the_program_stays_accepted() -> Bool {
  eq_admitted(source: collection_key_census_row_source)
    && eq_class_count(source: collection_key_census_row_source, wanted: "CollectionKeyReachesEqualityRoute") >= 1
}

// THE POPULATION IS A BOUND, NOT A SUBSET (manager ruling msg_7f0d6824, blocker 1). The declared walk
// alone reports 0 for a module whose only routed key type is inferred, so the drop row's subject --
// EVERY emitted use -- would have outrun its population. It must not be able to.
// RED TODAY, MEASURED (gunbc#15175, srv1): an un-annotated generic-call binding reports no row because no
// per-call type-argument substitution exists. Held as a declared red in
// v2.workflow.floor_expected_red floor_expected_red_chunk_inferred_collection_key_census; trigger: per-call
// fresh instantiation (gunbc.recurring_failure_mode
// field_access_on_a_generic_call_result_keeps_the_uninstantiated_parameter).
test fn inferred_collection_key_census_row_is_present_and_the_program_stays_accepted() -> Bool {
  eq_admitted(source: collection_key_inferred_census_row_source)
    && eq_class_count(source: collection_key_inferred_census_row_source, wanted: "CollectionKeyReachesEqualityRoute") >= 1
}

// CONTROL: an ordinary value key is not the residual. Same shape, Int key, so the inferred walk must
// report nothing -- it counts by the same walker, not by "any Map in a body".
data collection_key_inferred_control_source: String = "module eq_probe_collection_key_inferred_ctl\nimport std.types { Map, Int }\nimport std.algebra { empty_map, map_insert, map_contains_key }\nfn has_one(n: Int) -> Bool {\n  let m = map_insert(m: empty_map(), key: n, value: 1)\n  map_contains_key(m: m, key: n)\n}\n"

test fn inferred_collection_key_census_control_reports_nothing() -> Bool {
  eq_admitted(source: collection_key_inferred_control_source)
    && eq_class_count(source: collection_key_inferred_control_source, wanted: "CollectionKeyReachesEqualityRoute") == 0
}

// ONE CALLING CONVENTION (sleek-owl-397's RED). A planned `==` emits as one call of the declared derived
// equality, and the emitter carries no hand-spelled conversion of a routed leaf's arguments: the routed call
// is inside that declaration's ordinary body. The forbidden text is what the retired plan reader emitted.
test fn planned_equality_emits_one_declared_call_and_no_hand_spelled_route() -> Bool {
  compile_dag_rust_emit_check(
    "module test.claim.deq_emit_probe\nimport v2.std.node { Node }\ntype DeqEmitWrap { n: Node }\nfn same(a: DeqEmitWrap, b: DeqEmitWrap) -> Bool { a == b }\n",
    "src/test_claim_deq_emit_probe.rs",
    ["equality_derived_"],
    ["::core::convert::From::from("]
  )
}

// THE ROUTE, NOT ONLY THE ANSWER (DESIGN section 3, the pairing obligation): admitted-or-refused reads the same
// whether a Node leaf compares through its declared route or by another path, so these read the emitted
// step. The routed function the table names must be called, open paren included, so a name that merely shares
// a prefix with it does not satisfy the control; a table row whose function changes turns it red.
test fn node_occurrence_root_emits_the_declared_route_function() -> Bool {
  compile_dag_rust_emit_check(
    "module test.claim.deq_route_occurrence_probe\nimport v2.std.node { NodeOccurrence }\nfn same(a: NodeOccurrence, b: NodeOccurrence) -> Bool { a == b }\n",
    "src/test_claim_deq_route_occurrence_probe.rs",
    ["::node_occurrence_eq("],
    []
  )
}

// A CALL LOWERED WITH NO DEFINITION IS THE DEFECT (gunbc#15175): the call side lowers a planned `==` to
// equality_derived_<decl> and the declaring module must synthesize that function. The emitted module that
// calls it must define it; measured red before the fix by cargo check, E0425 cannot find function
// equality_derived_deq_route_wrap.
test fn a_planned_equality_call_has_its_definition_in_the_emitted_module() -> Bool {
  compile_dag_rust_emit_check(
    "module test.claim.deq_route_node_probe\nimport v2.std.node { Node }\ntype DeqRouteWrap { n: Node }\nfn same(a: DeqRouteWrap, b: DeqRouteWrap) -> Bool { a == b }\n",
    "src/test_claim_deq_route_node_probe.rs",
    ["equality_derived_deq_route_wrap(a.clone(), b.clone())", "fn equality_derived_deq_route_wrap("],
    []
  )
}

// (A plan exists only where a routed member such as Node is reachable; without one `==` is the target structural equality and needs no function.)
// A generic declaration is never synthesized (one function per instance would be needed), so a record reaching
// one as a field has no derived equality: comparing it refuses with the typed member cause, and the emitted
// module defines no function for it and calls none. Measured red before the fix: the record's synthesized body
// called equality_derived_gen, which no module defines (E0425). The positive control is
// a_planned_equality_call_has_its_definition_in_the_emitted_module.
test fn comparing_a_record_with_a_generic_applied_field_refuses_blocking() -> Bool {
  eq_blocking_count(source: "module test.claim.deq_generic_field_red\nimport v2.std.node { Node }\ntype DeqGen<C> = DeqGenHolds { value: C } | DeqGenNode { n: Node }\ntype DeqGenHolder { g: DeqGen<Int> }\nfn same(a: DeqGenHolder, b: DeqGenHolder) -> Bool { a == b }\n", wanted: "EqualityMemberUnjudgeable") >= 1
}

test fn a_record_with_a_generic_applied_field_gets_no_derived_equality_call() -> Bool {
  compile_dag_rust_emit_check(
    "module test.claim.deq_generic_field_emit\nimport v2.std.node { Node }\ntype DeqGen<C> = DeqGenHolds { value: C } | DeqGenNode { n: Node }\ntype DeqGenHolder { g: DeqGen<Int> }\nfn make(g: DeqGen<Int>) -> DeqGenHolder { DeqGenHolder { g: g } }\n",
    "src/test_claim_deq_generic_field_emit.rs",
    ["fn make("],
    ["equality_derived_deq_gen", "fn equality_derived_deq_gen_holder("]
  )
}

test fn presence_test_stays_admitted() -> Bool {
  eq_census_clean(source: presence_test_green_source)
}

// T? == T (gunbc.recurring_failure_mode optional_compared_with_required_value). Before the arm
// in v1.compiler.infer equality_admission_diags these compiled clean and the Rust emitter
// rendered `Option<T> == T` (rustc E0308, std.filesystem is_text_readable). The red is a
// field typed `Kind?` compared with a bare variant, in both operand orders; the controls are
// the explicit spellings the refusal names (a Present comparison, a match) and two optionals
// compared with each other, which the arm must not widen into.
data optionality_mismatch_red_source: String = "module eq_probe_optionality\ntype Kind = A | B\ntype Row { kind: Kind? }\nfn is_a(r: Row) -> Bool { r.kind == A }\n"

data optionality_mismatch_reversed_red_source: String = "module eq_probe_optionality_rev\ntype Kind = A | B\ntype Row { kind: Kind? }\nfn is_a(r: Row) -> Bool { A != r.kind }\n"

data optionality_explicit_present_green_source: String = "module eq_probe_optionality_present\ntype Kind = A | B\ntype Row { kind: Kind? }\nfn is_a(r: Row) -> Bool { r.kind == Present { value: A } }\n"

data optionality_explicit_match_green_source: String = "module eq_probe_optionality_match\ntype Kind = A | B\ntype Row { kind: Kind? }\nfn is_a(r: Row) -> Bool {\n  match r.kind {\n    Present { value: k } => k == A\n    Absent => false\n  }\n}\n"

data optionality_both_optional_green_source: String = "module eq_probe_optionality_both\ntype Kind = A | B\ntype Row { kind: Kind? }\nfn same(a: Row, b: Row) -> Bool { a.kind == b.kind }\n"

test fn optional_compared_with_required_value_refuses_blocking() -> Bool {
  eq_blocking_count(source: optionality_mismatch_red_source, wanted: "EqualityOptionalityMismatch") == 1
}

test fn required_compared_with_optional_value_refuses_blocking() -> Bool {
  eq_blocking_count(source: optionality_mismatch_reversed_red_source, wanted: "EqualityOptionalityMismatch") == 1
}

test fn explicit_present_comparison_stays_admitted() -> Bool {
  eq_admitted(source: optionality_explicit_present_green_source)
}

test fn explicit_match_on_optional_stays_admitted() -> Bool {
  eq_admitted(source: optionality_explicit_match_green_source)
}

test fn optional_compared_with_optional_stays_admitted() -> Bool {
  eq_admitted(source: optionality_both_optional_green_source)
}

// C5 (gunbc.recurring_failure_mode bare_value_admitted_where_optional_is_declared), AT THE DECLARED RETURN: a fn declared `-> T?` whose body produces a bare T. No
// declared coercion lifts T into T?, and the Rust emission refused it (E0308, gunbc.running_release_
// identity running_release_member_string). The red is a bare-Int body under `-> Int?`; the controls
// are the explicit present spelling and the absent spelling, which the arm must not widen into.
data return_lift_red_source: String = "module ret_probe_lift\nfn f(x: Int) -> Int? { x }\n"

data return_explicit_present_green_source: String = "module ret_probe_present\nfn f(x: Int) -> Int? { Present { value: x } }\n"

data return_absent_green_source: String = "module ret_probe_absent\nfn f(x: Int) -> Int? { none }\n"

test fn required_body_at_optional_return_refuses_blocking() -> Bool {
  eq_blocking_count(source: return_lift_red_source, wanted: "DeclaredTypeNotInhabited") == 1
}

test fn explicit_present_return_stays_admitted() -> Bool {
  eq_admitted(source: return_explicit_present_green_source)
}

test fn absent_return_stays_admitted() -> Bool {
  eq_admitted(source: return_absent_green_source)
}

data return_lift_match_arm_red_source: String = "module ret_probe_arm\nfn g(s: String) -> String? {\n  match s {\n    \"a\" => s\n    _ => none\n  }\n}\n"

test fn required_arm_at_optional_return_refuses_blocking() -> Bool {
  eq_blocking_count(source: return_lift_match_arm_red_source, wanted: "DeclaredTypeNotInhabited") >= 1
}

// Arm ORDER must not decide the verdict (review 76904): the join keeps the first arm's type, so with
// `none` listed first the bare arm was never judged against the declared return.
data return_lift_match_arm_swapped_red_source: String = "module ret_probe_arm_swapped\nfn g(s: String) -> String? {\n  match s {\n    \"b\" => none\n    _ => s\n  }\n}\n"

test fn required_arm_after_none_arm_refuses_blocking() -> Bool {
  eq_blocking_count(source: return_lift_match_arm_swapped_red_source, wanted: "DeclaredTypeNotInhabited") >= 1
}

// CLAIMED SCOPE of the match-arm wall (ruling B, gunbc#13280): an arm whose whole body is the payload
// binding of `Present { value: x }` is not judged, because infer types that payload single-level (see
// nested_optional_collapsed_by_infer_carried_by_emission). The control is the mtcollins1 shape; the red
// proves the exclusion is narrow: the same arm returning a bare non-binding value still refuses.
data present_payload_arm_control_source: String = "module present_payload_probe\nfn g(xs: List<String?>) -> String? {\n  match xs.first() {\n    Absent => none\n    Present { value: r } => r\n  }\n}\n"

data present_payload_arm_narrow_red_source: String = "module present_payload_probe_red\nfn g(xs: List<String?>, s: String) -> String? {\n  match xs.first() {\n    Absent => none\n    Present { value: r } => s\n  }\n}\n"

// The exclusion switches off ONLY the bare-versus-optional check: a payload-binding arm that is
// genuinely disjoint from its sibling (String vs Int) still reaches the proven-disjoint wall.
data present_payload_arm_disjoint_red_source: String = "module present_payload_probe_disjoint\nfn g(x: Int?) -> String {\n  match x {\n    Absent => \"s\"\n    Present { value: r } => r\n  }\n}\n"

test fn present_payload_arm_disjoint_from_sibling_still_refuses() -> Bool {
  eq_blocking_count_at_subject(
    source: present_payload_arm_disjoint_red_source,
    wanted: "InternalError",
    subject: "match arms produce proven-disjoint types: Primitive(String) vs Primitive(Int)") == 1
}

test fn present_payload_binding_arm_stays_admitted() -> Bool {
  eq_admitted(source: present_payload_arm_control_source)
}

test fn present_pattern_arm_with_other_bare_value_still_refuses() -> Bool {
  eq_blocking_count(source: present_payload_arm_narrow_red_source, wanted: "DeclaredTypeNotInhabited") >= 1
}

// THE SAME CLASS AT A DATA INITIALIZER (ruling A on gunbc#13202). A `data r: T? = <bare T>` row was
// emitted bare against Option<..> and refused only downstream by rustc; the checker now refuses it.
// The red's T is a coproduct with a nested-record variant, the specimen that exposed the class; the
// control is the same row spelled Present { value: .. }.
data data_row_bare_lift_red_source: String = "module data_probe_lift\ntype Inner {\n  n: Int\n}\ntype Shape\n  = Circle { inner: Inner }\n  | NoShape\ndata shape_row: Shape? = Circle { inner: Inner { n: 1 } }\n"

data data_row_present_spelled_green_source: String = "module data_probe_present\ntype Inner {\n  n: Int\n}\ntype Shape\n  = Circle { inner: Inner }\n  | NoShape\ndata shape_row: Shape? = Present { value: Circle { inner: Inner { n: 1 } } }\n"

test fn bare_data_initializer_at_optional_row_refuses_blocking() -> Bool {
  eq_blocking_count(source: data_row_bare_lift_red_source, wanted: "DeclaredTypeNotInhabited") == 1
}

test fn present_spelled_data_initializer_stays_admitted() -> Bool {
  eq_admitted(source: data_row_present_spelled_green_source)
}
