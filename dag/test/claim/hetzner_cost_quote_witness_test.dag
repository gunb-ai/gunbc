module test.claim.hetzner_cost_quote_witness


data live_tree_disposition: LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn hetzner_cax41_hourly_micros() -> std.nat.Nat {
  gunbc.ci_fleet.cost_estimate_unit_price_micros(
    gunbc.plans.md_helpers.quote: gunbc.ci_fleet.per_second_billed_cost_quote(
      unit_price: extdeps.cloud.hetzner.cax41_catalog.hourly,
      currency: extdeps.cloud.hetzner.cax41_catalog.currency,
    ),
  )
}

fn hetzner_cax41_cost_class_is_per_second_billed() -> Bool {
  let gunbc.plans.md_helpers.quote = gunbc.ci_fleet.per_second_billed_cost_quote(
    unit_price: extdeps.cloud.hetzner.cax41_catalog.hourly,
    currency: extdeps.cloud.hetzner.cax41_catalog.currency,
  )
  match gunbc.plans.md_helpers.quote.model.cost_class {
    PerSecondBilled => true
    OwnedMarginalZero => false
    Metered => false
    DeveloperAttention => false
  }
}

fn hetzner_cax41_currency_is_eur() -> Bool {
  match extdeps.cloud.hetzner.cax41_catalog.currency {
    Eur => true
    _ => false
  }
}

fn hetzner_cax41_unit_price_matches_catalog() -> Bool {
  hetzner_cax41_hourly_micros() == 50500
}

test fn hetzner_cost_quote_witness_holds() -> Bool {
  hetzner_cax41_cost_class_is_per_second_billed()
    && hetzner_cax41_currency_is_eur()
    && hetzner_cax41_unit_price_matches_catalog()
}
