module test.claim.container_alias_empty_collection_witness

// THE CLASS THIS FILE HOLDS OPEN (regression from #15539, d0969ea38a8).
// v1.compiler.infer expected_type_is_keyed_collection / expected_type_is_set_collection once admitted
// a call to empty_map()/empty_set() whose expected type RESOLVED to a Map/Set carrier. #15539 replaced
// the resolved-core test with an authored-leaf spelling test (container_spelling_is_algebra on the
// written leaf name), so an alias whose written name is not a roster spelling -- a module-local alias,
// or an imported alias such as gunbc.scm.object_table_json.DecodePositions = Map<String, ScmObjectRef>
// used at repository_envelope.dag -- was refused at empty_map()/empty_set() ("expected type is not a
// keyed collection"). The repair decides the expected type on its RESOLVED carrier declaration through
// the kernel container roster, never the written leaf.
//
// Each row hands the compiler an isolated fixture module through gunbc.compile_census_probe, so a pass
// row and a refusal row coexist without one closure diagnostic aborting the whole file. The refusals
// (non-collection record, Map carrier asked for empty_set) are the controls that MUST keep refusing;
// the alias rows are the regression controls (red on the #15539 binary, green on the fix).

import gunbc.compile_census_probe { census_exit, census_verdict, total_blocking_census }

// PASS: a module-local alias of Map<String, Int> used as the expected type of empty_map(). Zero blocking diagnostics.
data local_map_alias_empty_map_source: String = "module ca_local_map\nimport std.types { Bool, String, Int, Map }\nimport std.algebra { empty_map }\ntype LocalMap = Map<String, Int>\nfn use_map(positions: LocalMap) -> Bool { true }\nfn probe() -> Bool { use_map(positions: empty_map()) }\n"

test fn a_local_map_alias_at_empty_map_is_clean() -> ProcessExit {
  census_exit(census_verdict(census: total_blocking_census(source: local_map_alias_empty_map_source), holds: fn(n) { n == 0 }))
}

// PASS: a module-local alias of Set<String> used as the expected type of empty_set(). Zero blocking diagnostics.
// This is the row that is RED on the #15539 binary (node_is_set_collection does not resolve a module-local alias).
data local_set_alias_empty_set_source: String = "module ca_local_set\nimport std.types { Bool, String, Set }\nimport std.algebra { empty_map }\ntype LocalSet = Set<String>\nfn use_set(tags: LocalSet) -> Bool { true }\nfn probe() -> Bool { use_set(tags: empty_set()) }\n"

test fn a_local_set_alias_at_empty_set_is_clean() -> ProcessExit {
  census_exit(census_verdict(census: total_blocking_census(source: local_set_alias_empty_set_source), holds: fn(n) { n == 0 }))
}

// REFUSAL CONTROL: a record that is not a collection at empty_map() must still refuse.
data record_at_empty_map_source: String = "module ca_record\nimport std.types { Bool, String, Int, Map }\nimport std.algebra { empty_map }\ntype LocalPoint = { x: String, y: Int }\nfn use_point(p: LocalPoint) -> Bool { true }\nfn probe() -> Bool { use_point(p: empty_map()) }\n"

test fn a_record_at_empty_map_is_refused() -> ProcessExit {
  census_exit(census_verdict(census: total_blocking_census(source: record_at_empty_map_source), holds: fn(n) { n >= 1 }))
}

// REFUSAL CONTROL: a Map carrier used as the expected type of empty_set() must still refuse.
data map_alias_at_empty_set_source: String = "module ca_map_set\nimport std.types { Bool, String, Int, Map, Set }\nimport std.algebra { empty_map }\ntype LocalMap = Map<String, Int>\nfn use_set(tags: LocalMap) -> Bool { true }\nfn probe() -> Bool { use_set(tags: empty_set()) }\n"

test fn a_map_alias_at_empty_set_is_refused() -> ProcessExit {
  census_exit(census_verdict(census: total_blocking_census(source: map_alias_at_empty_set_source), holds: fn(n) { n >= 1 }))
}

// PASS: a CONCRETE (non-alias) Map used as the expected type of empty_map() stays clean, so the
// resolved-carrier decision is not only rescuing aliases -- the written roster spelling still works.
data concrete_map_empty_map_source: String = "module ca_concrete_map\nimport std.types { Bool, String, Int, Map }\nimport std.algebra { empty_map }\nfn use_map(positions: Map<String, Int>) -> Bool { true }\nfn probe() -> Bool { use_map(positions: empty_map()) }\n"

test fn a_concrete_map_at_empty_map_is_clean() -> ProcessExit {
  census_exit(census_verdict(census: total_blocking_census(source: concrete_map_empty_map_source), holds: fn(n) { n == 0 }))
}

// WELL-TYPED POSITIVE CONTROL: the same call written correctly stays at zero, so the fixture itself is not broken.
data well_typed_map_source: String = "module ca_well_typed\nimport std.types { Bool, String, Int, Map }\nimport std.algebra { empty_map, map_insert }\nfn probe() -> Map<String, Int> { map_insert(m: empty_map(), key: \"k\", value: 1) }\n"

test fn the_well_typed_map_call_is_clean() -> ProcessExit {
  census_exit(census_verdict(census: total_blocking_census(source: well_typed_map_source), holds: fn(n) { n == 0 }))
}
