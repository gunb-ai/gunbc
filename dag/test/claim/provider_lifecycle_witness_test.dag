module test.claim.provider_lifecycle_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

test fn claude_lifecycle_consumes_cli_authority() -> Bool {
  claude_cli_lifecycle_external_authority.uri.locator == claude_cli_external_authority_anchor.uri.locator
}

fn fixture_instance() -> extdeps.llm.cli_lifecycle.ProviderInstance {
  extdeps.llm.cli_lifecycle.ProviderInstance {
    kind: ClaudeCliProvider,
    host: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
    executable: "claude" as std.types.NonEmptyStr,
    observed_version: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
    state_directory: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
    credential_storage_method: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
    service_identity: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
  }
}

test fn recorded_credentials_do_not_imply_refreshable_authentication() -> Bool {
  let recorded = provider_readiness_label(readiness: ProviderCredentialsRecordedUnverified)
  let failed = provider_readiness_label(readiness: extdeps.llm.cli_lifecycle.ProviderRefreshFailed {
    reason: "invalid_refresh_token" as std.types.NonEmptyStr,
  })
  recorded == "credentials recorded, unverified"
    && failed == "authentication refresh failed"
    && recorded != failed
}

test fn model_access_and_sandbox_readiness_are_independent() -> Bool {
  let observation = gunbc.worker_lifecycle.WorkerObservation {
    configured_provider: fixture_instance(),
    process: gunbc.worker_lifecycle.WorkerProcessExited {
      exit_code: 0,
      last_command: "env",
    },
    provider_instance: gunbc.worker_lifecycle.ProviderEvidenceUnobserved {
      reason: "fixture process tree unobserved" as std.types.NonEmptyStr,
    },
    provider_readiness: ProviderAuthenticated,
    tool_readiness: extdeps.llm.cli_lifecycle.SandboxProbeFailed {
      reason: "bwrap loopback RTM_NEWADDR refused" as std.types.NonEmptyStr,
    },
    phase: gunbc.worker_lifecycle.WorkerPhaseUnobserved {
      reason: "no progress transcript" as std.types.NonEmptyStr,
    },
  }
  provider_readiness_label(readiness: observation.provider_readiness) == "authenticated"
    && worker_process_evidence_label(evidence: observation.process) == "process exited"
    && tool_execution_readiness_label(readiness: observation.tool_readiness) == "sandbox unavailable"
    && worker_phase_label(phase: observation.phase) == "phase unobserved"
}

test fn session_presence_cannot_promote_setup_to_execution() -> Bool {
  let observation = gunbc.worker_lifecycle.WorkerObservation {
    configured_provider: fixture_instance(),
    process: gunbc.worker_lifecycle.WorkerProcessUnobserved {
      reason: "session-only fixture" as std.types.NonEmptyStr,
    },
    provider_instance: gunbc.worker_lifecycle.ProviderEvidenceUnobserved {
      reason: "fixture process tree unobserved" as std.types.NonEmptyStr,
    },
    provider_readiness: ProviderSetupRequired,
    tool_readiness: extdeps.llm.cli_lifecycle.ToolExecutionReadinessUnobserved {
      reason: "provider has not reached tool execution" as std.types.NonEmptyStr,
    },
    phase: WorkerWaitingForHumanSetup,
  }
  provider_readiness_label(readiness: observation.provider_readiness) == "setup required"
    && provider_kind_label(kind: observation.configured_provider.kind) == "Claude"
    && provider_evidence_label(evidence: observation.provider_instance) == "unobserved"
    && worker_phase_label(phase: observation.phase) == "waiting for human setup"
    && tool_execution_readiness_label(readiness: observation.tool_readiness) == "tool readiness unobserved"
}

test fn terminal_evidence_accepts_only_terminal_outcomes() -> Bool {
  let completed_phase = gunbc.worker_lifecycle.WorkerTerminal { outcome: WorkerTerminalCompleted }
  let failed_outcome = gunbc.worker_lifecycle.WorkerTerminalFailed {
    reason: "provider exited nonzero" as std.types.NonEmptyStr,
  }
  worker_phase_label(phase: completed_phase) == "completed"
    && worker_terminal_outcome_label(outcome: failed_outcome) == "failed"
    && terminal_outcome_evidence_label(
      evidence: gunbc.worker_lifecycle.TerminalOutcomeObserved { outcome: failed_outcome }) == "observed"
}

test fn provider_lifecycle_keystone_holds() -> Bool {
  claude_lifecycle_consumes_cli_authority()
    && recorded_credentials_do_not_imply_refreshable_authentication()
    && model_access_and_sandbox_readiness_are_independent()
    && session_presence_cannot_promote_setup_to_execution()
    && terminal_evidence_accepts_only_terminal_outcomes()
}
