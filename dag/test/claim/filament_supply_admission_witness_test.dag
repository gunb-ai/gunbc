module test.claim.filament_supply_admission_witness_test

import product.printed_chassis.filament_supply {
  InventoryLotEvidence,
  FilamentSupplyIdentifierObservation,
  ManufacturerRfidObserved,
  OperatorLabelObserved,
  AdmittedFilamentSupply,
  FilamentSupplyAdmission,
  FilamentSupplyAdmitted,
  FilamentSupplyAssetAbsent,
  FilamentSupplyAssetDuplicate,
  FilamentSupplyLedgerEvidenceUnavailable,
  FilamentSupplySourceLotUnobserved,
  FilamentSupplySourceLotRepeated,
  FilamentSupplySourceLotConflict,
  FilamentSupplyLotRecordAbsent,
  FilamentSupplyProductUnresolved,
  FilamentSupplyProductMismatch,
  FilamentSupplyIdentifierUnestablished,
  FilamentSupplyIdentifierConflict,
  admit_filament_supply,
}
import product.inventory {
  ProcurementLot,
  InventoryEvent,
  InventoryLotIdentity,
  ReceiptRecorded,
  CatalogRowExact,
  CatalogRowUnread,
  LandedCostRecorded,
  LotAcquired,
  LotReceived,
  QuantityQualified,
  QuantityInstalled,
  InstallFromAvailable,
  inventory_lot_allocator_initial,
  mint_inventory_lot_identity,
}
import product.placement_supply { PhysicalAsset, PhysicalAssetIdentity, ProcurementReceiptIdentity }
import std.decl_ref { DeclarationRef, WholeDeclaration, decl_ref }
import std.measure { MoneyOnce, money_amount_micro }
import extdeps.currency.currency { Usd }
import std.types { Bool, List, NonEmptyStr, String }
import std.nat { Nat }
import std.minted_identity { minted_id_eq }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE NINE CONTROLS THE FILAMENT BOUNDARY WAS SPECIFIED WITH, plus the refusals that are this
// module's own rather than inventory's. The first six state that an EXACT SOURCE-LOT BINDING FOR THE
// REQUESTED ASSET is what admission needs -- not full individuation of every sibling in the
// installation event -- which is the property that lets product.inventory stay permissive. The last
// three are the ones that keep the derivation honest: a refused ledger, an event naming a foreign
// lot, and the same asset claimed by two separately valid ledgers must each refuse rather than
// producing a plausible binding.
//
// THE FIXTURES CITE extdeps.printing.fdm AS THE PRODUCT MODULE AND THAT IS NOT A PRODUCT CLAIM. No
// filament PRODUCT authority exists in this corpus -- fdm declares FilamentMaterial as a material
// CLASS, which is exactly what a supply must not be cataloged as -- and authoring one for hardware
// nobody has unboxed would be the fabricated row this lane has already refused to write once. What
// makes the fixtures sound anyway is that the module compares the ASSET's catalog module against the
// LOT's, a RELATIVE check that needs no such authority to exist: it refuses an asset whose catalog
// disagrees with the lot it was drawn from, whatever either one names. The absolute question -- is
// this module a filament product at all -- has no wall here, and the trigger for one is the same
// missing authority.
fn fs_lot_a() -> InventoryLotIdentity {
  mint_inventory_lot_identity(alloc: inventory_lot_allocator_initial()).id
}

fn fs_lot_b() -> InventoryLotIdentity {
  let first = mint_inventory_lot_identity(alloc: inventory_lot_allocator_initial())
  mint_inventory_lot_identity(alloc: first.alloc).id
}

fn fs_spool() -> PhysicalAssetIdentity { "spool-fs-a" as PhysicalAssetIdentity }
fn fs_other() -> PhysicalAssetIdentity { "spool-fs-b" as PhysicalAssetIdentity }

fn fs_product_module() -> NonEmptyStr { "extdeps.printing.fdm" as NonEmptyStr }

fn fs_catalog_ref() -> DeclarationRef {
  decl_ref(module_path: "extdeps.printing.fdm", decl_name: "FilamentMaterial")
}

fn fs_foreign_catalog_ref() -> DeclarationRef {
  decl_ref(module_path: "extdeps.printing.bambu_studio", decl_name: "bambu_studio_platform_support")
}

fn fs_asset(id: PhysicalAssetIdentity, catalog: DeclarationRef) -> PhysicalAsset {
  PhysicalAsset { identity: id, catalog: catalog, physical_serial: Absent, procurement: Absent }
}

fn fs_roster() -> List<PhysicalAsset> {
  [fs_asset(id: fs_spool(), catalog: fs_catalog_ref()), fs_asset(id: fs_other(), catalog: fs_catalog_ref())]
}

fn fs_cost(count: Nat) -> MoneyOnce {
  MoneyOnce { amount: money_amount_micro(count: count), currency: Usd }
}

fn fs_lot(id: InventoryLotIdentity, label: NonEmptyStr) -> ProcurementLot {
  ProcurementLot {
    identity: id,
    receipt: ReceiptRecorded { receipt: "receipt-fs" as ProcurementReceiptIdentity },
    catalog: CatalogRowExact { row: fs_catalog_ref() },
    display_label: label,
    quantity_acquired: 10,
    landed_cost: LandedCostRecorded { cost: fs_cost(count: 1000000) },
  }
}

fn fs_unread_lot(id: InventoryLotIdentity) -> ProcurementLot {
  ProcurementLot {
    identity: id,
    receipt: ReceiptRecorded { receipt: "receipt-fs" as ProcurementReceiptIdentity },
    catalog: CatalogRowUnread {
      observed_family: "PLA" as NonEmptyStr,
      read_obligation: "read the spool package SKU" as NonEmptyStr,
    },
    display_label: "lot-unread" as NonEmptyStr,
    quantity_acquired: 10,
    landed_cost: LandedCostRecorded { cost: fs_cost(count: 1000000) },
  }
}

fn fs_prologue(id: InventoryLotIdentity) -> List<InventoryEvent> {
  [
    LotAcquired { lot: id },
    LotReceived { lot: id, quantity: 10 },
    QuantityQualified { lot: id, quantity: 10 },
  ]
}

fn fs_install(lot: InventoryLotIdentity, quantity: Nat, assets: List<PhysicalAssetIdentity>) -> InventoryEvent {
  QuantityInstalled { lot: lot, quantity: quantity, origin: InstallFromAvailable, assets: assets }
}

fn fs_evidence(lot: ProcurementLot, tail: List<InventoryEvent>) -> InventoryLotEvidence {
  InventoryLotEvidence { lot: lot, events: concat(fs_prologue(id: lot.identity), tail) }
}

fn fs_label() -> List<FilamentSupplyIdentifierObservation> {
  [OperatorLabelObserved { label: "SPOOL-A" as NonEmptyStr }]
}

fn fs_admit(evidence: List<InventoryLotEvidence>, identifiers: List<FilamentSupplyIdentifierObservation>) -> FilamentSupplyAdmission {
  admit_filament_supply(
    evidence: evidence,
    asset_inventory: fs_roster(),
    requested: fs_spool(),
    identifier_evidence: identifiers
  )
}

// The admitted spool, or false. Written once because eleven rows below need the same question and a
// re-spelled match at each site is a second place the acceptance rule lives.
fn fs_admits_from_lot(admission: FilamentSupplyAdmission, lot: InventoryLotIdentity) -> Bool {
  match admission {
    FilamentSupplyAdmitted { supply: s } =>
      minted_id_eq(left: s.source_lot.identity, right: lot)
        && s.asset.identity as String == "spool-fs-a"
        && s.source_lot.quantity_acquired == 10
    FilamentSupplyAssetAbsent { requested: _ } => false
    FilamentSupplyAssetDuplicate { requested: _, matches: _ } => false
    FilamentSupplyLedgerEvidenceUnavailable { requested: _, lot: _, cause_label: _, event_ordinal: _ } => false
    FilamentSupplySourceLotUnobserved { requested: _ } => false
    FilamentSupplySourceLotRepeated { requested: _, occurrences: _ } => false
    FilamentSupplySourceLotConflict { requested: _, first_lot: _, further_lots: _ } => false
    FilamentSupplyLotRecordAbsent { requested: _, lot: _ } => false
    FilamentSupplyProductUnresolved { requested: _, lot: _, observed_family: _ } => false
    FilamentSupplyProductMismatch { requested: _, expected_module: _, found_module: _ } => false
    FilamentSupplyIdentifierUnestablished { requested: _ } => false
    FilamentSupplyIdentifierConflict { requested: _, distinct_values: _ } => false
  }
}

// CONTROL 1. Two units installed, one of them named. The requested spool's source lot resolves even
// though the population is NOT fully individuated -- an implementation demanding
// `named count == quantity` before binding anything would refuse this, and it is the exact shape
// day-two inventory takes once a second spool is installed unlabelled.
test fn w_the_requested_spool_binds_although_its_sibling_is_anonymous() -> Bool {
  fs_admits_from_lot(
    admission: fs_admit(
      evidence: [fs_evidence(lot: fs_lot(id: fs_lot_a(), label: "lot-fs-a" as NonEmptyStr), tail: [fs_install(lot: fs_lot_a(), quantity: 2, assets: [fs_spool()])])],
      identifiers: fs_label()
    ),
    lot: fs_lot_a()
  )
}

// CONTROL 2. The same install with the population fully individuated. Paired with control 1 this
// states that individuation is not a PREREQUISITE, rather than that it is irrelevant.
test fn w_the_requested_spool_binds_when_the_population_is_individuated() -> Bool {
  fs_admits_from_lot(
    admission: fs_admit(
      evidence: [fs_evidence(lot: fs_lot(id: fs_lot_a(), label: "lot-fs-a" as NonEmptyStr), tail: [fs_install(lot: fs_lot_a(), quantity: 2, assets: [fs_spool(), fs_other()])])],
      identifiers: fs_label()
    ),
    lot: fs_lot_a()
  )
}

// CONTROL 6. The day-one singleton: one unit, one named spool. This is the shape the first two real
// spools will be recorded in, and it is a POSITIVE control -- without it every refusal below could
// be satisfied by a mint that refuses everything.
test fn w_the_day_one_singleton_install_admits_the_supply() -> Bool {
  fs_admits_from_lot(
    admission: fs_admit(
      evidence: [fs_evidence(lot: fs_lot(id: fs_lot_a(), label: "lot-fs-a" as NonEmptyStr), tail: [fs_install(lot: fs_lot_a(), quantity: 1, assets: [fs_spool()])])],
      identifiers: fs_label()
    ),
    lot: fs_lot_a()
  )
}

// CONTROL 3. The asset named twice inside one event is malformed evidence, not one sighting seen
// clearly. It refuses as repeated rather than binding to the lot both occurrences agree on.
test fn w_an_asset_named_twice_refuses_as_repeated() -> Bool {
  match fs_admit(
    evidence: [fs_evidence(lot: fs_lot(id: fs_lot_a(), label: "lot-fs-a" as NonEmptyStr), tail: [fs_install(lot: fs_lot_a(), quantity: 2, assets: [fs_spool(), fs_spool()])])],
    identifiers: fs_label()
  ) {
    FilamentSupplySourceLotRepeated { requested: r, occurrences: n } => r as String == "spool-fs-a" && n == 2
    FilamentSupplyAdmitted { supply: _ } => false
    FilamentSupplyAssetAbsent { requested: _ } => false
    FilamentSupplyAssetDuplicate { requested: _, matches: _ } => false
    FilamentSupplyLedgerEvidenceUnavailable { requested: _, lot: _, cause_label: _, event_ordinal: _ } => false
    FilamentSupplySourceLotUnobserved { requested: _ } => false
    FilamentSupplySourceLotConflict { requested: _, first_lot: _, further_lots: _ } => false
    FilamentSupplyLotRecordAbsent { requested: _, lot: _ } => false
    FilamentSupplyProductUnresolved { requested: _, lot: _, observed_family: _ } => false
    FilamentSupplyProductMismatch { requested: _, expected_module: _, found_module: _ } => false
    FilamentSupplyIdentifierUnestablished { requested: _ } => false
    FilamentSupplyIdentifierConflict { requested: _, distinct_values: _ } => false
  }
}

// CONTROLS 4 AND 9, WHICH ARE ONE CASE UNDER THIS SHAPE. The same spool is named once in each of two
// SEPARATELY VALID lot ledgers. Both are admitted by inventory, so nothing upstream refuses; the
// conflict is visible only to a projection that scans every admitted ledger rather than stopping at
// the first match. First-match or last-match resolution would silently pick a lot here, and the
// binding would look exactly as authoritative as a correct one.
test fn w_the_same_spool_in_two_valid_ledgers_conflicts_rather_than_picking_one() -> Bool {
  match fs_admit(
    evidence: [
      fs_evidence(lot: fs_lot(id: fs_lot_a(), label: "lot-fs-a" as NonEmptyStr), tail: [fs_install(lot: fs_lot_a(), quantity: 1, assets: [fs_spool()])]),
      fs_evidence(lot: fs_lot(id: fs_lot_b(), label: "lot-fs-b" as NonEmptyStr), tail: [fs_install(lot: fs_lot_b(), quantity: 1, assets: [fs_spool()])]),
    ],
    identifiers: fs_label()
  ) {
    FilamentSupplySourceLotConflict { requested: r, first_lot: f, further_lots: rest } =>
      r as String == "spool-fs-a" && minted_id_eq(left: f, right: fs_lot_a()) && count(rest) == 1
    FilamentSupplyAdmitted { supply: _ } => false
    FilamentSupplyAssetAbsent { requested: _ } => false
    FilamentSupplyAssetDuplicate { requested: _, matches: _ } => false
    FilamentSupplyLedgerEvidenceUnavailable { requested: _, lot: _, cause_label: _, event_ordinal: _ } => false
    FilamentSupplySourceLotUnobserved { requested: _ } => false
    FilamentSupplySourceLotRepeated { requested: _, occurrences: _ } => false
    FilamentSupplyLotRecordAbsent { requested: _, lot: _ } => false
    FilamentSupplyProductUnresolved { requested: _, lot: _, observed_family: _ } => false
    FilamentSupplyProductMismatch { requested: _, expected_module: _, found_module: _ } => false
    FilamentSupplyIdentifierUnestablished { requested: _ } => false
    FilamentSupplyIdentifierConflict { requested: _, distinct_values: _ } => false
  }
}

// CONTROL 5. The install names only the sibling. The requested spool is UNOBSERVED -- not absent
// from the world, and not refused as malformed: nothing in admitted history binds it to a lot.
test fn w_a_spool_no_admitted_event_names_is_unobserved() -> Bool {
  match fs_admit(
    evidence: [fs_evidence(lot: fs_lot(id: fs_lot_a(), label: "lot-fs-a" as NonEmptyStr), tail: [fs_install(lot: fs_lot_a(), quantity: 2, assets: [fs_other()])])],
    identifiers: fs_label()
  ) {
    FilamentSupplySourceLotUnobserved { requested: r } => r as String == "spool-fs-a"
    FilamentSupplyAdmitted { supply: _ } => false
    FilamentSupplyAssetAbsent { requested: _ } => false
    FilamentSupplyAssetDuplicate { requested: _, matches: _ } => false
    FilamentSupplyLedgerEvidenceUnavailable { requested: _, lot: _, cause_label: _, event_ordinal: _ } => false
    FilamentSupplySourceLotRepeated { requested: _, occurrences: _ } => false
    FilamentSupplySourceLotConflict { requested: _, first_lot: _, further_lots: _ } => false
    FilamentSupplyLotRecordAbsent { requested: _, lot: _ } => false
    FilamentSupplyProductUnresolved { requested: _, lot: _, observed_family: _ } => false
    FilamentSupplyProductMismatch { requested: _, expected_module: _, found_module: _ } => false
    FilamentSupplyIdentifierUnestablished { requested: _ } => false
    FilamentSupplyIdentifierConflict { requested: _, distinct_values: _ } => false
  }
}

// CONTROL 7, THE MOST IMPORTANT ONE. A raw QuantityInstalled row names the requested spool, and it
// is individually plausible -- but the ledger carrying it refuses, here for insufficient stock. No
// source-lot binding may issue, and the refusal must name the CAUSE rather than reporting the spool
// as unobserved: an operator told "unobserved" would go looking for a missing event, when the real
// state is that the inventory authority rejected the history that event belongs to. This is the row
// that proves the projection reads accepted history and not plausible-looking authored events.
test fn w_a_refused_ledger_cannot_establish_a_source_lot() -> Bool {
  match fs_admit(
    evidence: [fs_evidence(lot: fs_lot(id: fs_lot_a(), label: "lot-fs-a" as NonEmptyStr), tail: [fs_install(lot: fs_lot_a(), quantity: 11, assets: [fs_spool()])])],
    identifiers: fs_label()
  ) {
    FilamentSupplyLedgerEvidenceUnavailable { requested: r, lot: l, cause_label: c, event_ordinal: _ } =>
      r as String == "spool-fs-a" && minted_id_eq(left: l, right: fs_lot_a()) && c as String == "insufficient_stock"
    FilamentSupplyAdmitted { supply: _ } => false
    FilamentSupplyAssetAbsent { requested: _ } => false
    FilamentSupplyAssetDuplicate { requested: _, matches: _ } => false
    FilamentSupplySourceLotUnobserved { requested: _ } => false
    FilamentSupplySourceLotRepeated { requested: _, occurrences: _ } => false
    FilamentSupplySourceLotConflict { requested: _, first_lot: _, further_lots: _ } => false
    FilamentSupplyLotRecordAbsent { requested: _, lot: _ } => false
    FilamentSupplyProductUnresolved { requested: _, lot: _, observed_family: _ } => false
    FilamentSupplyProductMismatch { requested: _, expected_module: _, found_module: _ } => false
    FilamentSupplyIdentifierUnestablished { requested: _ } => false
    FilamentSupplyIdentifierConflict { requested: _, distinct_values: _ } => false
  }
}

// CONTROL 8. The event names a lot other than the ledger's subject. It refuses as a ledger evidence
// failure naming event_lot_mismatch, never as a resolved binding to the lot the event mentions --
// which is what a scanner keyed on the asset name alone would produce, because the asset matches.
test fn w_an_event_naming_a_foreign_lot_cannot_establish_a_source_lot() -> Bool {
  match fs_admit(
    evidence: [fs_evidence(lot: fs_lot(id: fs_lot_a(), label: "lot-fs-a" as NonEmptyStr), tail: [fs_install(lot: fs_lot_b(), quantity: 1, assets: [fs_spool()])])],
    identifiers: fs_label()
  ) {
    FilamentSupplyLedgerEvidenceUnavailable { requested: _, lot: _, cause_label: c, event_ordinal: _ } =>
      c as String == "event_lot_mismatch"
    FilamentSupplyAdmitted { supply: _ } => false
    FilamentSupplyAssetAbsent { requested: _ } => false
    FilamentSupplyAssetDuplicate { requested: _, matches: _ } => false
    FilamentSupplySourceLotUnobserved { requested: _ } => false
    FilamentSupplySourceLotRepeated { requested: _, occurrences: _ } => false
    FilamentSupplySourceLotConflict { requested: _, first_lot: _, further_lots: _ } => false
    FilamentSupplyLotRecordAbsent { requested: _, lot: _ } => false
    FilamentSupplyProductUnresolved { requested: _, lot: _, observed_family: _ } => false
    FilamentSupplyProductMismatch { requested: _, expected_module: _, found_module: _ } => false
    FilamentSupplyIdentifierUnestablished { requested: _ } => false
    FilamentSupplyIdentifierConflict { requested: _, distinct_values: _ } => false
  }
}

// THIS MODULE'S OWN REFUSALS BEGIN HERE. The roster does not carry the requested spool at all.
test fn w_a_spool_absent_from_the_roster_refuses() -> Bool {
  match admit_filament_supply(
    evidence: [fs_evidence(lot: fs_lot(id: fs_lot_a(), label: "lot-fs-a" as NonEmptyStr), tail: [fs_install(lot: fs_lot_a(), quantity: 1, assets: [fs_spool()])])],
    asset_inventory: [],
    requested: fs_spool(),
    identifier_evidence: fs_label()
  ) {
    FilamentSupplyAssetAbsent { requested: r } => r as String == "spool-fs-a"
    FilamentSupplyAdmitted { supply: _ } => false
    FilamentSupplyAssetDuplicate { requested: _, matches: _ } => false
    FilamentSupplyLedgerEvidenceUnavailable { requested: _, lot: _, cause_label: _, event_ordinal: _ } => false
    FilamentSupplySourceLotUnobserved { requested: _ } => false
    FilamentSupplySourceLotRepeated { requested: _, occurrences: _ } => false
    FilamentSupplySourceLotConflict { requested: _, first_lot: _, further_lots: _ } => false
    FilamentSupplyLotRecordAbsent { requested: _, lot: _ } => false
    FilamentSupplyProductUnresolved { requested: _, lot: _, observed_family: _ } => false
    FilamentSupplyProductMismatch { requested: _, expected_module: _, found_module: _ } => false
    FilamentSupplyIdentifierUnestablished { requested: _ } => false
    FilamentSupplyIdentifierConflict { requested: _, distinct_values: _ } => false
  }
}

// The roster carries it twice. A duplicate is not a stronger sighting: the two rows may disagree on
// catalog or serial, so which one the supply would be minted from is undecidable.
test fn w_a_spool_listed_twice_in_the_roster_refuses() -> Bool {
  match admit_filament_supply(
    evidence: [fs_evidence(lot: fs_lot(id: fs_lot_a(), label: "lot-fs-a" as NonEmptyStr), tail: [fs_install(lot: fs_lot_a(), quantity: 1, assets: [fs_spool()])])],
    asset_inventory: [fs_asset(id: fs_spool(), catalog: fs_catalog_ref()), fs_asset(id: fs_spool(), catalog: fs_catalog_ref())],
    requested: fs_spool(),
    identifier_evidence: fs_label()
  ) {
    FilamentSupplyAssetDuplicate { requested: r, matches: n } => r as String == "spool-fs-a" && n == 2
    FilamentSupplyAdmitted { supply: _ } => false
    FilamentSupplyAssetAbsent { requested: _ } => false
    FilamentSupplyLedgerEvidenceUnavailable { requested: _, lot: _, cause_label: _, event_ordinal: _ } => false
    FilamentSupplySourceLotUnobserved { requested: _ } => false
    FilamentSupplySourceLotRepeated { requested: _, occurrences: _ } => false
    FilamentSupplySourceLotConflict { requested: _, first_lot: _, further_lots: _ } => false
    FilamentSupplyLotRecordAbsent { requested: _, lot: _ } => false
    FilamentSupplyProductUnresolved { requested: _, lot: _, observed_family: _ } => false
    FilamentSupplyProductMismatch { requested: _, expected_module: _, found_module: _ } => false
    FilamentSupplyIdentifierUnestablished { requested: _ } => false
    FilamentSupplyIdentifierConflict { requested: _, distinct_values: _ } => false
  }
}

// THE LOT'S CATALOG WAS NEVER READ. The material family is known -- PLA -- and that is precisely what
// a supply may not be cataloged as: PLA is a material class, not a product, and admitting on family
// alone would let formulation-specific facts be inherited from a row this spool was never shown to
// be. The refusal carries the observed family so the operator knows what to go read.
test fn w_a_lot_whose_catalog_was_never_read_refuses_as_product_unresolved() -> Bool {
  match fs_admit(
    evidence: [InventoryLotEvidence {
      lot: fs_unread_lot(id: fs_lot_a()),
      events: concat(fs_prologue(id: fs_lot_a()), [fs_install(lot: fs_lot_a(), quantity: 1, assets: [fs_spool()])]),
    }],
    identifiers: fs_label()
  ) {
    FilamentSupplyProductUnresolved { requested: r, lot: _, observed_family: f } =>
      r as String == "spool-fs-a" && f as String == "PLA"
    FilamentSupplyAdmitted { supply: _ } => false
    FilamentSupplyAssetAbsent { requested: _ } => false
    FilamentSupplyAssetDuplicate { requested: _, matches: _ } => false
    FilamentSupplyLedgerEvidenceUnavailable { requested: _, lot: _, cause_label: _, event_ordinal: _ } => false
    FilamentSupplySourceLotUnobserved { requested: _ } => false
    FilamentSupplySourceLotRepeated { requested: _, occurrences: _ } => false
    FilamentSupplySourceLotConflict { requested: _, first_lot: _, further_lots: _ } => false
    FilamentSupplyLotRecordAbsent { requested: _, lot: _ } => false
    FilamentSupplyProductMismatch { requested: _, expected_module: _, found_module: _ } => false
    FilamentSupplyIdentifierUnestablished { requested: _ } => false
    FilamentSupplyIdentifierConflict { requested: _, distinct_values: _ } => false
  }
}

// The asset's catalog names a different product module than the lot it was drawn from. One of the
// two rows is wrong and the module does not guess which: it names both.
test fn w_an_asset_whose_catalog_disagrees_with_its_lot_refuses() -> Bool {
  match admit_filament_supply(
    evidence: [fs_evidence(lot: fs_lot(id: fs_lot_a(), label: "lot-fs-a" as NonEmptyStr), tail: [fs_install(lot: fs_lot_a(), quantity: 1, assets: [fs_spool()])])],
    asset_inventory: [fs_asset(id: fs_spool(), catalog: fs_foreign_catalog_ref())],
    requested: fs_spool(),
    identifier_evidence: fs_label()
  ) {
    FilamentSupplyProductMismatch { requested: _, expected_module: e, found_module: f } =>
      e as String == "extdeps.printing.fdm" && f as String == "extdeps.printing.bambu_studio"
    FilamentSupplyAdmitted { supply: _ } => false
    FilamentSupplyAssetAbsent { requested: _ } => false
    FilamentSupplyAssetDuplicate { requested: _, matches: _ } => false
    FilamentSupplyLedgerEvidenceUnavailable { requested: _, lot: _, cause_label: _, event_ordinal: _ } => false
    FilamentSupplySourceLotUnobserved { requested: _ } => false
    FilamentSupplySourceLotRepeated { requested: _, occurrences: _ } => false
    FilamentSupplySourceLotConflict { requested: _, first_lot: _, further_lots: _ } => false
    FilamentSupplyLotRecordAbsent { requested: _, lot: _ } => false
    FilamentSupplyProductUnresolved { requested: _, lot: _, observed_family: _ } => false
    FilamentSupplyIdentifierUnestablished { requested: _ } => false
    FilamentSupplyIdentifierConflict { requested: _, distinct_values: _ } => false
  }
}

// NO DURABLE IDENTIFIER WAS OBSERVED. Provenance is resolved and the roster row exists, and the
// supply still refuses -- because the handling chain from spool to printer to coupon to measurement
// runs through a human reading a label, and an unlabelled spool breaks it at the first step.
test fn w_a_spool_with_no_identifier_evidence_refuses() -> Bool {
  match fs_admit(
    evidence: [fs_evidence(lot: fs_lot(id: fs_lot_a(), label: "lot-fs-a" as NonEmptyStr), tail: [fs_install(lot: fs_lot_a(), quantity: 1, assets: [fs_spool()])])],
    identifiers: []
  ) {
    FilamentSupplyIdentifierUnestablished { requested: r } => r as String == "spool-fs-a"
    FilamentSupplyAdmitted { supply: _ } => false
    FilamentSupplyAssetAbsent { requested: _ } => false
    FilamentSupplyAssetDuplicate { requested: _, matches: _ } => false
    FilamentSupplyLedgerEvidenceUnavailable { requested: _, lot: _, cause_label: _, event_ordinal: _ } => false
    FilamentSupplySourceLotUnobserved { requested: _ } => false
    FilamentSupplySourceLotRepeated { requested: _, occurrences: _ } => false
    FilamentSupplySourceLotConflict { requested: _, first_lot: _, further_lots: _ } => false
    FilamentSupplyLotRecordAbsent { requested: _, lot: _ } => false
    FilamentSupplyProductUnresolved { requested: _, lot: _, observed_family: _ } => false
    FilamentSupplyProductMismatch { requested: _, expected_module: _, found_module: _ } => false
    FilamentSupplyIdentifierConflict { requested: _, distinct_values: _ } => false
  }
}

// TWO ROUTES REPORTING DIFFERENT VALUES IS A CONFLICT EVEN THOUGH NEITHER REPEATED ITSELF. The RFID
// read and the operator label are two observations of ONE physical object; if they disagree, the
// object in hand has not been identified, and choosing the machine-read value because it feels more
// authoritative would be the heuristic standing where a fact was owed.
test fn w_an_rfid_read_disagreeing_with_the_operator_label_refuses() -> Bool {
  match fs_admit(
    evidence: [fs_evidence(lot: fs_lot(id: fs_lot_a(), label: "lot-fs-a" as NonEmptyStr), tail: [fs_install(lot: fs_lot_a(), quantity: 1, assets: [fs_spool()])])],
    identifiers: [
      ManufacturerRfidObserved { tag: "RFID-9001" as NonEmptyStr },
      OperatorLabelObserved { label: "SPOOL-A" as NonEmptyStr },
    ]
  ) {
    FilamentSupplyIdentifierConflict { requested: r, distinct_values: n } => r as String == "spool-fs-a" && n == 2
    FilamentSupplyAdmitted { supply: _ } => false
    FilamentSupplyAssetAbsent { requested: _ } => false
    FilamentSupplyAssetDuplicate { requested: _, matches: _ } => false
    FilamentSupplyLedgerEvidenceUnavailable { requested: _, lot: _, cause_label: _, event_ordinal: _ } => false
    FilamentSupplySourceLotUnobserved { requested: _ } => false
    FilamentSupplySourceLotRepeated { requested: _, occurrences: _ } => false
    FilamentSupplySourceLotConflict { requested: _, first_lot: _, further_lots: _ } => false
    FilamentSupplyLotRecordAbsent { requested: _, lot: _ } => false
    FilamentSupplyProductUnresolved { requested: _, lot: _, observed_family: _ } => false
    FilamentSupplyProductMismatch { requested: _, expected_module: _, found_module: _ } => false
    FilamentSupplyIdentifierUnestablished { requested: _ } => false
  }
}

// AND TWO ROUTES AGREEING IS ONE IDENTIFICATION, NOT TWO. Without this control the conflict arm
// above would be satisfied by an implementation that refused any spool carrying more than one
// observation -- which would refuse exactly the day-one practice of labelling every spool by hand
// even when its RFID reads.
test fn w_an_rfid_read_agreeing_with_the_operator_label_admits() -> Bool {
  fs_admits_from_lot(
    admission: fs_admit(
      evidence: [fs_evidence(lot: fs_lot(id: fs_lot_a(), label: "lot-fs-a" as NonEmptyStr), tail: [fs_install(lot: fs_lot_a(), quantity: 1, assets: [fs_spool()])])],
      identifiers: [
        ManufacturerRfidObserved { tag: "SPOOL-A" as NonEmptyStr },
        OperatorLabelObserved { label: "SPOOL-A" as NonEmptyStr },
      ]
    ),
    lot: fs_lot_a()
  )
}
