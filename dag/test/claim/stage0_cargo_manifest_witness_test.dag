module test.claim.stage0_cargo_manifest_witness

import gunbc.stage0_cargo_manifest {
  stage0_cargo_bin_repo_paths_from_manifest_ref,
  stage0_cargo_manifest_authority_note,
  stage0_cargo_toml_repo_path
}
import v2.std.text { String }

data stage0_cargo_manifest_witness_note: String = "Host-derived stage0 Cargo [[bin]] manifest: v1_compiler.cli_run.stage0_cargo_bin_repo_paths_from_manifest reads src/v1/stage0/Cargo.toml at witness execution — no hand-listed bin rows in .dag (operator rework 2026-07-29)."

test fn stage0_cargo_manifest_note_forbids_hand_list() -> Bool {
  string_contains(s: stage0_cargo_manifest_authority_note, pattern: "NOT hand-listed")
    && string_contains(s: stage0_cargo_manifest_authority_note, pattern: "stage0_cargo_bin_repo_paths_from_manifest")
}

test fn stage0_cargo_manifest_ref_points_at_host_deriver() -> Bool {
  stage0_cargo_bin_repo_paths_from_manifest_ref.module_path == "v1_compiler.cli_run"
    && stage0_cargo_bin_repo_paths_from_manifest_ref.decl_name == "stage0_cargo_bin_repo_paths_from_manifest"
}

test fn stage0_cargo_manifest_toml_path_holds() -> Bool {
  stage0_cargo_toml_repo_path == "src/v1/stage0/Cargo.toml"
}

test fn stage0_cargo_manifest_derived_nonempty_holds() -> Bool {
  stage0_cargo_bin_manifest_count() > 0
}

test fn stage0_cargo_manifest_parse_complete_holds() -> Bool {
  stage0_cargo_bin_manifest_parse_complete_holds()
}

test fn stage0_cargo_manifest_paths_unique_holds() -> Bool {
  stage0_cargo_bin_manifest_paths_unique_holds()
}

test fn stage0_cargo_manifest_all_under_package_root_holds() -> Bool {
  stage0_cargo_bin_manifest_all_under_package_root_holds()
}
