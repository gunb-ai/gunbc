module test.claim.zz_probe_witness

import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn a_eh() -> Bool {
  compile_dag_rust_emit_check("module map_key_witness.pz\nimport v2.std.collection { Map }\ntype Tagged<K> {\n  subject: K\n}\nfn f<K, V>(m: Map<String, V>, k: K) -> Map<String, V> {\n  m\n}\n", "src/map_key_witness_pz.rs", ["pub fn f<K: Clone + std::cmp::Eq + std::hash::Hash"], [])
}
test fn a_cl() -> Bool {
  compile_dag_rust_emit_check("module map_key_witness.pz\nimport v2.std.collection { Map }\ntype Tagged<K> {\n  subject: K\n}\nfn f<K, V>(m: Map<String, V>, k: K) -> Map<String, V> {\n  m\n}\n", "src/map_key_witness_pz.rs", ["pub fn f<K: Clone,"], [])
}
test fn a_bare() -> Bool {
  compile_dag_rust_emit_check("module map_key_witness.pz\nimport v2.std.collection { Map }\ntype Tagged<K> {\n  subject: K\n}\nfn f<K, V>(m: Map<String, V>, k: K) -> Map<String, V> {\n  m\n}\n", "src/map_key_witness_pz.rs", ["pub fn f<K,"], [])
}
