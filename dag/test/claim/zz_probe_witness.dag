module test.claim.zz_probe_witness

import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn a_plain_k_bare() -> Bool {
  compile_dag_rust_emit_check("module map_key_witness.pz\nimport v2.std.collection { Map }\ntype Tagged<K> {\n  subject: K\n}\nfn f<K, V>(m: Map<String, V>, k: K) -> Map<String, V> {\n  m\n}\n", "src/map_key_witness_pz.rs", ["pub fn f<K,"], [])
}
test fn b_tagged_param_bare() -> Bool {
  compile_dag_rust_emit_check("module map_key_witness.pz\nimport v2.std.collection { Map }\ntype Tagged<K> {\n  subject: K\n}\nfn f<K, V>(m: Map<String, V>, t: Tagged<K>) -> Map<String, V> {\n  m\n}\n", "src/map_key_witness_pz.rs", ["pub fn f<K,"], [])
}
test fn c_int_key_tagged_bare() -> Bool {
  compile_dag_rust_emit_check("module map_key_witness.pz\nimport v2.std.collection { Map }\ntype Tagged<K> {\n  subject: K\n}\nfn f<K, V>(m: Map<Int, V>, t: Tagged<K>) -> Map<Int, V> {\n  m\n}\n", "src/map_key_witness_pz.rs", ["pub fn f<K,"], [])
}
test fn d_no_map_tagged_bare() -> Bool {
  compile_dag_rust_emit_check("module map_key_witness.pz\nimport v2.std.collection { Map }\ntype Tagged<K> {\n  subject: K\n}\nfn f<K, V>(t: Tagged<K>, v: V) -> Int {\n  1\n}\n", "src/map_key_witness_pz.rs", ["pub fn f<K,"], [])
}
