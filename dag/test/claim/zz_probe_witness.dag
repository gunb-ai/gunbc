module test.claim.map_key_derive_requirement_witness

import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// Executing floor witness for the USAGE-DERIVED half of v1.compiler.trait_derive_emit derive selection
// (v1.compiler.trait_derive_emit v1_with_map_key_requirement). compile_dag_rust_emit_check is the
// enrolled consumer: it
// compiles an inline fixture through the real emit path and asserts emitted Rust spellings, so a claim
// here is green by execution rather than by declaration. THE SUBJECT: a type that reaches a keyed-
// collection key position must derive Eq + Hash, because the container Map lowers to im::HashMap whose
// key parameter is bounded K: Hash + Eq — a fact about the type's USE that no shape classification
// produces. Every positive row is paired with a control that must stay silent, because the failure
// mode this mechanism can have is not missing the requirement (rustc refuses loudly) but fabricating
// it on a type no one keys by, which nothing downstream would ever report.
// w_non_key_record_derives_no_hash is that control at record grain and
// w_map_value_position_does_not_seed is the sharper one: it puts the SAME type in the VALUE position
// of the same container, so a rule that keyed on 'mentioned by a Map' rather than 'occupies the key
// slot' goes red on it while every other row here stays green.
// w_map_key_requirement_propagates_to_field_types pins the fixpoint rather than a one-hop read, and
// w_nullary_coproduct_key_gains_only_hash pins the union's idempotence — a nullary coproduct already
// deriving Eq and Ord from its shape roster must gain Hash alone, which is the asymmetry a wider
// constant roster cannot express and the reason the union is append-only.
// w_fn_field_record_as_map_key_refuses pins the fail-closed arm: Rc<dyn Fn> is neither Eq nor Hash, so
// a callable-field record in a key position is refused with compile_error! rather than emitted with a
// derive that cannot hold.
test fn h1_list_bare() -> Bool {
  compile_dag_rust_emit_check(
    "module map_key_witness.deep_forwarded\nimport v2.std.collection { Map, empty_map }\nimport std.optional { Optional }\ntype Wrapper<K> {\n  subject: K\n}\ntype Idx<K, V> {\n  slots: Map<Wrapper<K>, V>\n  first: Optional<V>\n}\nfn build_idx<K, V>(x: List<K>) -> Idx<K, V> {\n  Idx { slots: empty_map(), first: Absent }\n}\nfn first_of<A, B>(x: List<A>) -> Optional<B> {\n  build_idx(x: x).first\n}\n",
    "src/map_key_witness_deep_forwarded.rs",
    ["std::cmp::Eq + std::hash::Hash, B"],
    []
  )
}

