test fn sol_silent_past_timeout_is_hung_or_inconclusive_not_success() -> Bool {
  let hung = diagnose_os_install_actuation(
    intent: srv3_diagnostic_intent_fixture,
    observations: base_observations(
      serve_process: ServeProcessesPresent,
      serve_port: ServePortListening { port: extdeps.bmc.webui.nbd_proxy_serve.srv3_nbd_proxy_local_port, owner_matches_expected: true },
      iso: IsoPresent { observed_sha256: "abababababababababababababababababababababababababababababababab" },
      redfish_boot_enabled: BootOverrideDisabled,
      elapsed_ms: srv3_install_hang_no_router_lease_ms,
      sol: SolConsoleContentObservation {
        bytes_captured: byte_size(0),
        duration_ms: srv3_install_hang_no_installer_progress_ms,
        contains_grub: false,
        contains_subiquity: false,
        contains_autoinstall: false,
        contains_firmware_menu: false,
        contains_error: false,
        capture_available: true,
      },
      router_table: srv3_pre_install_lease_table,
    ),
  )
  hung == InstallerHungVerdict
    && !install_diagnostic_verdict_is_os_installed(verdict: hung)
}

test fn serve_ready_pre_boot_is_ready_to_boot() -> Bool {
  let verdict = diagnose_os_install_actuation(
    intent: srv3_diagnostic_intent_fixture,
    observations: serve_ready_sol_silent_pre_boot_observations(),
  )
  install_diagnostic_verdict_is_ready_to_boot(verdict: verdict)
    && verdict == ReadyToBootVerdict
}

