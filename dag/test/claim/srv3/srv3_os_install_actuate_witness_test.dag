module test.claim.srv3_os_install_actuate


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// A SUPPLIED user-data body: the fixture needs the input's shape, not the renderer's output; the
// real rendering route is exercised by test.claim.srv3_seeded_install_media.
data srv3_seeded_user_data_fixture: NonEmptyStr = "#cloud-config\nautoinstall:\n  identity:\n    hostname: srv3\n" as NonEmptyStr

// A SUPPLIED resolved image (DESIGN §3: a witness discriminates at one interface). What these
// claims check does not depend on which bytes the actuator serves, only on the path reaching the
// intent; the real resolution route is exercised by test.claim.mtcollins1_census_image.
data srv3_resolved_image_fixture: SeededImageResolution = SeededImageResolved {
  built: ubuntu_seeded_install_media_built(
    input: srv3_seeded_install_media_input_for(user_data_body: srv3_seeded_user_data_fixture),
    output_digest: "abababababababababababababababababababababababababababababababab",
  ),
  path: "/var/lib/gunbc/artifacts/ubuntu-24.04.3-live-server-srv3-seeded-abababababababab.iso",
}

// Was "has three steps". The count only ever mattered as a proxy for the plan
// being derived from the solved mechanism, and srv3's BMC upgrade now exercises
// that derivation directly: the solve refuses, so the plan refuses with it. A
// plan still offering three nbd-proxy steps for a host whose firmware does not
// implement nbd-proxy is the failure this replaces.
test fn srv3_actuator_plan_follows_the_solve_and_refuses() -> Bool {
  srv3_os_install_actuator_plan_refuses_on_unestablished_path(image: srv3_resolved_image_fixture)
    && match srv3_os_install_actuator_plan_standing(image: srv3_resolved_image_fixture) {
      ActuatorPlanRefused { cause: _ } => true
      ActuatorPlanReady { plan: _, intents: _ } => false
    }
}

test fn srv3_nbd_proxy_serve_intent_targets_vm_slot_index() -> Bool {
  let intent = gunbc.srv3_nbd_proxy_serve_intent.srv3_nbd_proxy_serve_intent(
    iso_path: "/var/lib/gunbc/artifacts/ubuntu-24.04.3-live-server-srv3-seeded-abababababababab.iso",
  )
  intent.bmc_host == asrock_srv3_live_bmc_host
    && intent.ws_path == bmcweb_nbd_proxy_ws_path(variant: VmSlotIndexEndpoint, slot: 0, index: 0)
    && asrock_altrad8ud_openbmc_2_07_00_nbd_proxy_primary_endpoint == VmSlotIndexEndpoint
    && intent.iso_path == "/var/lib/gunbc/artifacts/ubuntu-24.04.3-live-server-srv3-seeded-abababababababab.iso"
}

test fn srv3_bmcweb_login_body_snapshot_uses_factory_when_unresolved() -> Bool {
  string_contains(s: srv3_bmcweb_login_body_content(), pattern: "\"username\":\"root\"")
    && string_contains(s: srv3_bmcweb_login_body_content(), pattern: "\"password\":\"0penBmc\"")
}

test fn srv3_actuate_prep_paths_are_declared() -> Bool {
  string_contains(s: srv3_bmcweb_token_path, pattern: "/tmp/srv3_bmcweb_token")
    && srv3_os_install_actuate_runbook_is_declared()
}

// FIELD GRAIN, not a joined surface: the programs against their cited identity rows, and the
// two words the intent's facts must reach (the file export and the wss URL) by membership. The
// joined-string supervision-grammar arm this witness used to assert retired with the raw word
// lists -- the law it enforced is structural on the transient-unit realization surface.
test fn srv3_nbd_proxy_serve_argv_is_emittable_from_intent() -> Bool {
  let intent = gunbc.srv3_nbd_proxy_serve_intent.srv3_nbd_proxy_serve_intent(iso_path: "/var/lib/gunbc/artifacts/fixture.iso")
  let websocat = websocat_nbd_proxy_bridge_command(
    bmc_host: intent.bmc_host,
    ws_path: intent.ws_path,
    session_token: intent.session_token,
    local_nbd_port: intent.local_nbd_port,
  )
  let nbdkit = nbdkit_readonly_file_serve_command(
    port: intent.local_nbd_port,
    backing_path: intent.iso_path,
  )
  websocat.program.invocation == websocat_install_path
    && nbdkit.program.invocation == nbdkit_cli_tool.program.invocation
    && fold(nbdkit.arguments, init: false, f: (acc, w) => acc || w == concat("file=", intent.iso_path as String))
    && fold(websocat.arguments, init: false, f: (acc, w) => acc || w == concat("wss://", concat(intent.bmc_host, intent.ws_path)))
}

// PINNED PLACEMENT, NOT AN ENDORSEMENT: the BMCWEB session token rides in the `--header=` argv
// word -- gunbc.credential_argv_exposure instance 3, measured latent. This witness holds the
// placement (word-for-word, quotes and all) so the repair that moves the token out of argv
// cannot land silently beside it; the spelling it pins is the obligation
// extdeps.tools.websocat websocat_header_argv_word_dissolution_trigger records. The word must
// equal its derivation from the intent's own token, so a dropped header or a dead token
// reference fails here.
test fn nbd_proxy_serve_session_token_is_literal_in_websocat_argv() -> Bool {
  let intent = gunbc.srv3_nbd_proxy_serve_intent.srv3_nbd_proxy_serve_intent(iso_path: "/var/lib/gunbc/artifacts/fixture.iso")
  let websocat = websocat_nbd_proxy_bridge_command(
    bmc_host: intent.bmc_host,
    ws_path: intent.ws_path,
    session_token: intent.session_token,
    local_nbd_port: intent.local_nbd_port,
  )
  fold(argv_words(command: websocat), init: false, f: (acc, w) =>
    acc || w == concat("--header=\"", concat(concat("Authorization: Token ", intent.session_token as String), "\"")))
}

test fn srv3_os_install_actuate_shell_runner_carries_dissolution_trigger() -> Bool {
  match srv3_os_install_actuate_shell_runner_scaffold {
    Scaffold { dissolves_to: _, bind: _ } => true
    Terminal { reason: _ } => false
  }
}
