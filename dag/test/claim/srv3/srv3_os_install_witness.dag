module test.claim.srv3.srv3_os_install_witness

import std.types { Bool, String }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import extdeps.provisioning.network_boot { ProxyDhcp, NativeDhcpBootOptions, UefiHttpBoot, UefiPxe, LegacyBiosPxe }
import extdeps.provisioning.ubuntu_install_media { noble_numbat_2404_3_amd64_uefi_network_boot_chain, ubuntu_network_boot_loader_chain }
import gunbc.os_install {
  OsInstallPlanBootDeliveryPlanIncoherent,
  srv3_os_install_plan_standing_for,
  srv3_ubuntu_autoinstall,
  srv3_os_install_plan_standing,
  srv3_pxe_network_boot_chain,
  LanInstallInfraSurvey,
  survey_implied_dhcp_direction,
  OsInstallPlanRefused,
  OsInstallPlanReady,
}
import gunbc.boot_artifact_delivery { BootDeliveryPlanned, BootDeliveryRefused }
import gunbc.fleet.fleet_boot_delivery_solution { srv3_boot_delivery_solution }
import test.fixture.boot_delivery_plans { incoherent_pxe_solution, pxe_solution }


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// ARCH-GROUNDED is still the claim, now asserted on the amd64 chain row Canonical documents (the
// uncited grubnet filename map it replaced is deleted),
// which is where it lives. The srv3 clause that used to read the architecture off
// a Ready plan is now the plan's refusal: with no delivery mechanism selectable
// on 3.22.00 there is no plan to take an architecture from, and taking one anyway
// would be reading a field off a plan that does not exist.
test fn bootloader_artifact_is_arch_grounded() -> Bool {
  match srv3_os_install_plan_standing {
    OsInstallPlanRefused { cause: _ } => true
    OsInstallPlanReady { plan: _ } => false
  }
    && (ubuntu_network_boot_loader_chain(chain: noble_numbat_2404_3_amd64_uefi_network_boot_chain).members.head.served_path as String) == "bootx64.efi"
    && map(ubuntu_network_boot_loader_chain(chain: noble_numbat_2404_3_amd64_uefi_network_boot_chain).members.tail, m => m.served_path as String) == ["grubx64.efi", "grub/grub.cfg", "vmlinuz", "initrd"]
}

test fn srv3_pxe_chain_is_uefi_http_boot_when_modeled() -> Bool {
  match srv3_pxe_network_boot_chain.boot_mode {
    UefiHttpBoot => true
    LegacyBiosPxe { tftp_root: _ } => false
    UefiPxe { tftp_root: _ } => false
  }
}

test fn srv3_survey_forces_proxy_dhcp() -> Bool {
  match srv3_pxe_network_boot_chain.dhcp_direction {
    ProxyDhcp => true
    NativeDhcpBootOptions => false
  }
    && match survey_implied_dhcp_direction(
      survey: LanInstallInfraSurvey {
        existing_dhcp_configurable: true,
        dedicated_install_server_present: false,
      }
    ) {
      ProxyDhcp => false
      NativeDhcpBootOptions => true
    }
}

// Now asserted through the standing, so a refusal cannot read as a satisfied plan: the plan
// arm must be Ready AND its delivery virtual-media, both derived from srv3's firmware evidence.
// SOLVER-DERIVED is the claim, and the two halves moving TOGETHER is the proof.
// A plan hardcoded to nbd-proxy virtual media would still be Ready now that the
// solve refuses; because it is derived, both refuse. Asserting the pair is
// strictly more discriminating than the old version, which could not tell a
// derived plan from a hardcoded one while the solve happened to agree with it.
test fn srv3_plan_is_solver_derived_and_refuses_with_the_solve() -> Bool {
  match srv3_os_install_plan_standing {
    OsInstallPlanRefused { cause: _ } => true
    OsInstallPlanReady { plan: _ } => false
  }
    && match srv3_boot_delivery_solution {
      BootDeliveryRefused { cause: _ } => true
      BootDeliveryPlanned { plan: _ } => false
    }
}

// The plan's TARGET facts — Ubuntu 24.04, Cd, Once, fully-automated seed — are
// not assertable while no plan exists, and this witness now says that instead of
// describing one. They are not lost: they are what the INSTALL-0 lane must
// reproduce once srv3 has an established delivery path again, at which point this
// witness reds and is replaced by the real target assertions rather than
// silently continuing to pass.
test fn srv3_plan_target_facts_are_unassertable_while_the_plan_refuses() -> Bool {
  match srv3_os_install_plan_standing {
    OsInstallPlanRefused { cause: _ } => true
    OsInstallPlanReady { plan: _ } => false
  }
}

// P1a RED: a contradictory plan (PXE delivery, removable-media control) is refused as incoherent before any
// arm or install plan is read from its fields.
test fn a_contradictory_plan_yields_no_install_plan() -> Bool {
  match srv3_os_install_plan_standing_for(solution: incoherent_pxe_solution, autoinstall: srv3_ubuntu_autoinstall) {
    OsInstallPlanRefused { cause: OsInstallPlanBootDeliveryPlanIncoherent { cause: _ } } => true
    _ => false
  }
}

// Control: the coherent plan is not refused as incoherent, so the refusal above is the contradiction.
test fn a_coherent_plan_is_not_refused_as_incoherent_for_install() -> Bool {
  match srv3_os_install_plan_standing_for(solution: pxe_solution, autoinstall: srv3_ubuntu_autoinstall) {
    OsInstallPlanRefused { cause: OsInstallPlanBootDeliveryPlanIncoherent { cause: _ } } => false
    _ => true
  }
}
