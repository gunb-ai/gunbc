module test.claim.srv3_host_effect_realize_witness

import std.logic { Bool }
import std.types { NonEmptyStr, FilePath }
import gunbc.host_effect {
  OsInstallActuatorToolchainEnsure,
  HostOs,
  BmcController,
  host_effect_identity_evidence,
  LocalShell,
  EmitArtifactThenThinRun,
  BootstrapFragment,
  ThinInvocation,
}
import gunbc.host_effect_realize {
  host_effect_apply,
  srv3_argv_with_bin,
}
import gunbc.fleet_intent { srv1_host }
import std.realization_reconcile { NotConverged }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import extdeps.shell { posix_command_v_check_argv, shell_test_is_executable_argv }
import extdeps.apt { apt_installed_bin_path }
import gunbc.fleet_known_hosts_anchor { portable_remote_words }
import v2.std.optional { Present, Absent }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn os_install_actuator_toolchain_ensure_rejects_bmc_controller_target() -> Bool {
  match host_effect_apply(
    target: BmcController { node: srv1_host },
    effect: OsInstallActuatorToolchainEnsure {},
    evidence: host_effect_identity_evidence,
    transport: LocalShell,
  ) {
    NotConverged { reason: why, applied: _ } =>
      string_contains(s: why, pattern: "OsInstallActuatorToolchainEnsure")
    _ => false
  }
}

test fn os_install_actuator_toolchain_ensure_rejects_emit_artifact_transport() -> Bool {
  match host_effect_apply(
    target: HostOs { node: srv1_host },
    effect: OsInstallActuatorToolchainEnsure {},
    evidence: host_effect_identity_evidence,
    transport: EmitArtifactThenThinRun {
      bootstrap: BootstrapFragment { script: "true" },
      invocation: ThinInvocation { argv: ["true"] },
    },
  ) {
    NotConverged { reason: why, applied: _ } =>
      string_contains(s: why, pattern: "EmitArtifactThenThinRun")
    _ => false
  }
}

test fn argv_with_bin_prepends_bin_path_to_args() -> Bool {
  srv3_argv_with_bin(bin_path: "/usr/bin/apt-get", args: ["install", "-y", "curl"]) ==
    ["/usr/bin/apt-get", "install", "-y", "curl"]
}

test fn argv_with_bin_on_empty_args_is_just_bin_path() -> Bool {
  srv3_argv_with_bin(bin_path: "/usr/bin/apt-get", args: []) == ["/usr/bin/apt-get"]
}


test fn posix_command_v_check_argv_shapes_a_command_v_invocation() -> Bool {
  posix_command_v_check_argv(command: "curl" as NonEmptyStr) ==
    ["sh", "-c", "command -v \"$1\"", "sh", "curl"]
}

test fn shell_test_is_executable_argv_shapes_a_test_dash_x_invocation() -> Bool {
  shell_test_is_executable_argv(path: "/usr/bin/curl" as FilePath) == ["test", "-x", "/usr/bin/curl"]
}

test fn fleet_ssh_apt_tool_presence_argv_is_portable() -> Bool {
  match portable_remote_words(
    raws: shell_test_is_executable_argv(path: apt_installed_bin_path(binary: "sshpass" as NonEmptyStr)),
  ) {
    Present { value: _ } => true
    Absent => false
  }
}

test fn posix_command_v_check_argv_is_not_portable() -> Bool {
  match portable_remote_words(raws: posix_command_v_check_argv(command: "sshpass" as NonEmptyStr)) {
    Present { value: _ } => false
    Absent => true
  }
}
