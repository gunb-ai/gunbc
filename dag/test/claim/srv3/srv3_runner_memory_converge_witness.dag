module test.claim.srv3.srv3_runner_memory_converge_witness

import gunbc.fleet.fleet_enrollment { apply_mode_for_host, converge_apply_mode_label }
import gunbc.host.host_converge { ConvergeKnob, HostConverge, VerdictAbsent, VerdictConverged, legacy_converge_knob, runner_instance_glob }
import gunbc.host.host_converge_slice1 { converge_knob_by_name, host_converge_from_policy }
import gunbc.host.host_runner_memory_provision { provision_runner_memory_caps_routes_through_host_effect_apply, runner_memory_cap_readback_verdict }
import gunbc.host.host_standup { host_standup_fleet_converge_policy }
import gunbc.instruments.host_prelude { fold }
import gunbc.runner.runner_slot_allocation { gunbc_committed_host_runner_slot_allocation }
import gunbc.runner.runner_slot_desired { gunbc_runner_slot_desired }
import gunbc.runner.runner_unit_live_read { runner_unit_live_read_typed }
import std.algebra { string_contains }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.measure { byte_size_count }
import std.types { Bool, List, String }
import std.upsert_decision { Drifted }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn srv3_memory_max_knob_name() -> String {
  "per_slot_memory_max_bytes"
}

fn srv3_memory_high_knob_name() -> String {
  "per_slot_memory_high_bytes"
}

fn srv3_host_converge_from_standup_policy() -> HostConverge? {
  host_converge_from_policy(policy: host_standup_fleet_converge_policy(), host: operator_host_srv3)
}

fn srv3_memory_knob(host: HostConverge, name: String) -> ConvergeKnob? {
  converge_knob_by_name(host: host, name: name)
}

fn last_runner_slice_knob_name(knobs: List<ConvergeKnob>) -> String {
  fold(knobs, init: "", f: (acc, k) => match k.slice {
    GunbcSlice => acc
    RunnerSlice => k.name
    SessionsSlice => acc
  })
}

test fn witness_srv3_committed_allocation_matches_authority() -> Bool {
  let desired = gunbc_runner_slot_desired()
  match gunbc_committed_host_runner_slot_allocation(host: operator_host_srv3) {
    HostSlotAllocationWidthUnresolved { host: _, cause: _ } => false
    HostSlotAllocationAdmitted { allocation: alloc } =>
      alloc.host == operator_host_srv3
        && byte_size_count(b: alloc.per_slot.memory_max) == byte_size_count(b: desired.memory_max)
        && byte_size_count(b: alloc.per_slot.memory_high) == byte_size_count(b: desired.memory_high)
  }
}

test fn witness_srv3_standup_converge_policy_includes_host() -> Bool {
  match srv3_host_converge_from_standup_policy() {
    Present { value: host } => host.identity == operator_host_srv3
    Absent => false
  }
}

test fn witness_srv3_memory_max_knob_grounds_authority() -> Bool {
  match srv3_host_converge_from_standup_policy() {
    Present { value: host } =>
      match srv3_memory_knob(host: host, name: srv3_memory_max_knob_name()) {
        Present { value: knob } =>
          knob.desired == to_string(byte_size_count(b: gunbc_runner_slot_desired().memory_max))
            && match knob.target {
              PerSlotMemoryCap { dropin_path: _, instance_glob: glob, property: p, bytes_value: b } =>
                p == systemd_memory_max_property
                  && b == knob.desired
                  && string_contains(s: glob, pattern: "srv3")
              _ => false
            }
        Absent => false
      }
    Absent => false
  }
}

test fn witness_srv3_memory_high_knob_grounds_authority() -> Bool {
  match srv3_host_converge_from_standup_policy() {
    Present { value: host } =>
      match srv3_memory_knob(host: host, name: srv3_memory_high_knob_name()) {
        Present { value: knob } =>
          knob.desired == to_string(byte_size_count(b: gunbc_runner_slot_desired().memory_high))
            && match knob.target {
              PerSlotMemoryCap {
                dropin_path: path,
                instance_glob: glob,
                property: p,
                bytes_value: b,
              } =>
                path == gunbc_runner_per_slot_high_dropin_path
                  && p == systemd_memory_high_property
                  && b == knob.desired
                  && string_contains(s: glob, pattern: "srv3")
              _ => false
            }
        Absent => false
      }
    Absent => false
  }
}

test fn witness_srv3_memory_high_is_throttle_line_below_max() -> Bool {
  let desired = gunbc_runner_slot_desired()
  byte_size_count(b: desired.memory_high) < byte_size_count(b: desired.memory_max)
    && byte_size_count(b: desired.memory_high) >= byte_size_count(b: gunbc_floor_minimum_viable_armed_budget)
}

// srv3's converge reloads by standing up a fresh tree, and the claim now reads its OWN enrollment row
// (R4, gunbc.plans.fleet_machine_authority): the apply mode is a column on
// gunbc.fleet.fleet_enrollment's HostEnrollmentIntent, not a comparison in gunbc.host.host_converge,
// so the claim reads the row instead of calling the deleted gunbc_apply_mode_for_host. The
// roster-absent side of the same claim lives in dag/test/claim/fleet/fleet_enrollment_policy_witness.dag,
// where it executes; it does not belong here, where the module has no import block at all.
test fn witness_srv3_apply_mode_is_fresh_standup() -> Bool {
  match apply_mode_for_host(host: operator_host_srv3) {
    Present { value: mode } => converge_apply_mode_label(m: mode) == "fresh_standup"
    Absent => false
  }
}

test fn witness_srv3_memory_knobs_precede_runner_width_widen() -> Bool {
  match srv3_host_converge_from_standup_policy() {
    Present { value: host } =>
      last_runner_slice_knob_name(knobs: host.knobs) == "runner_count"
        && fold(host.knobs, init: false, f: (acc, k) => acc || k.name == srv3_memory_max_knob_name())
        && fold(host.knobs, init: false, f: (acc, k) => acc || k.name == srv3_memory_high_knob_name())
    Absent => false
  }
}

test fn witness_provision_routes_through_host_effect_apply() -> Bool {
  provision_runner_memory_caps_routes_through_host_effect_apply()
}

// witness_provision_apply_interprets_per_slot_memory_cap WAS HERE, and it was green by
// INTERPRETATION only — it asserted that a PerSlotMemoryCap knob lowers to a non-empty shell
// body, which is now precisely the thing that must not happen. Its subject (the converge-side
// apply arm) is deleted, so the witness goes with it rather than being inverted into an
// assertion that the arm is missing: the arm's absence is established by the module being gone,
// not by a test that could be satisfied by a stub. The knob-selection half it also exercised is
// still covered by witness_srv3_memory_knobs_precede_runner_width_widen above, which asserts both
// memory knobs are present (from the standup policy, not the caps-only selection) and does not
// touch apply at all.

test fn witness_readback_verdict_drifts_RED_when_live_mismatch() -> Bool {
  match runner_memory_cap_readback_verdict(
    read: runner_unit_live_read_typed(row: gunbc_srv1_runner_unit_live_read_fixture),
    knob: legacy_converge_knob(
      slice: RunnerSlice,
      name: srv3_memory_max_knob_name(),
      desired: to_string(byte_size_count(b: gunbc_runner_slot_desired().memory_max)),
      target: PerSlotMemoryCap {
        dropin_path: gunbc_runner_per_slot_dropin_path,
        instance_glob: runner_instance_glob(host: operator_host_srv3),
        property: systemd_memory_max_property,
        bytes_value: to_string(byte_size_count(b: gunbc_runner_slot_desired().memory_max)),
      }
    ),
  ) {
    Present { value: Drifted } => true
    Present { value: VerdictConverged } => false
    Absent => false
    Present { value: VerdictAbsent } => false
  }
}

