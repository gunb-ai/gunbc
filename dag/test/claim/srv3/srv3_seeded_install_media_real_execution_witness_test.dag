module test.claim.srv3_seeded_install_media_real_execution

import std.logic { Bool }
import std.types { String, NonEmptyStr }
import gunbc.srv3_seeded_install_media_artifact { srv3_seeded_grub_kernel_cmdline }
import extdeps.provisioning.ubuntu_seeded_install_media_remaster { install_media_remaster_ensure_grub_cmdline, install_media_remaster_grub_cfg_with_cmdline, GrubCmdlineApplied, GrubCmdlineRefused }
import extdeps.provisioning.ubuntu_install_media { noble_numbat_2404_3_live_server_arm64_grub_cfg }
import gunbc.host_command_binding { LocalCommandHost }
import extdeps.shell
import extdeps.filesystem.filesystem_io
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data real_execution_home_doc: String = "This witness drives real shell/filesystem effects (shell.Mktemp.Dir, Filesystem.Write/Read, shell.Remove.RecursiveForce have no mock_response - dag/extdeps/shell/shell.dag - so it cannot run in CI's default Hermetic discovery corpus, dag/std/execution_mode.dag). Split out of srv3_seeded_install_media_witness_test.dag so that file's pure witnesses keep hermetic per-PR discovery; excluded from discovery (gunbc.ci_layer_roots witness_exclusion_substrings) and executed per PR by the required floor's local-repo wet lane (v2.workflow.local_repo_wet_terminal local_repo_wet_schedule; gunbc.ci_layer_roots excl_install_media_seeded_local_wet_reason)."

// THE EDIT RUNS ON THIS HOST'S REAL FILESYSTEM: the stock member is written to a real file, the builder
// measures it with a real sha256sum and writes its edit; a file that is NOT the stock member is refused
// without being written.
test fn install_media_remaster_ensure_grub_cmdline_inserts_by_real_execution() -> Bool  {
  let dir = shell.Mktemp.Dir()
  let grub_cfg = concat(dir.path as String, "/grub.cfg") as NonEmptyStr
  let stock = noble_numbat_2404_3_live_server_arm64_grub_cfg
  let cmdline = srv3_seeded_grub_kernel_cmdline
  let wrote = Filesystem.Write(path: grub_cfg as String, content: stock.content)
  let applied = match install_media_remaster_ensure_grub_cmdline(host: LocalCommandHost, grub_cfg: grub_cfg, stock: stock, cmdline: cmdline, scope_root: dir.path as NonEmptyStr) { GrubCmdlineApplied => true _ => false }
  let after = Filesystem.Read(path: grub_cfg as String)
  let not_stock = concat(dir.path as String, "/other.cfg") as NonEmptyStr
  let wrote_other = Filesystem.Write(path: not_stock as String, content: "menuentry x \{\n  linux /v ---\n\}\n")
  let refused_other = match install_media_remaster_ensure_grub_cmdline(host: LocalCommandHost, grub_cfg: not_stock, stock: stock, cmdline: cmdline, scope_root: dir.path as NonEmptyStr) { GrubCmdlineRefused { reason: _ } => true _ => false }
  let other_after = Filesystem.Read(path: not_stock as String)
  let cleaned = shell.Remove.RecursiveForce(path: dir.path)
  dir.success && wrote.success && applied && after.success
    && after.content == install_media_remaster_grub_cfg_with_cmdline(grub_cfg: stock.content, cmdline: cmdline)
    && string_contains(s: after.content, pattern: cmdline as String)
    && wrote_other.success && refused_other && other_after.success && !string_contains(s: other_after.content, pattern: cmdline as String)
    && cleaned.success
}
