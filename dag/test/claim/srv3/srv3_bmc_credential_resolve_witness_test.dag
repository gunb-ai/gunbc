module test.claim.srv3_bmc_credential_resolve


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn srv3_credential_resolve_factory_observation_uses_factory() -> Bool {
  let intent = srv3_os_install_actuate_credential_intent()
  let resolution = resolve_bmc_credential(intent: intent, observation: FactoryCredentialActive)
  bmc_credential_resolution_uses_factory(resolution: resolution)
}

test fn srv3_credential_resolve_rotated_observation_uses_secret_ref() -> Bool {
  let intent = srv3_os_install_actuate_credential_intent()
  let resolution = resolve_bmc_credential(intent: intent, observation: RotatedCredentialActive)
  bmc_credential_resolution_uses_secret_ref(resolution: resolution)
}

test fn srv3_credential_intent_grounds_bmc_srv3_admin_secret_ref() -> Bool {
  srv3_os_install_actuate_credential_intent().rotated_secret_ref == bmc_srv3_admin_secret_ref
}

test fn srv3_credential_resolve_unknown_observation_is_refused() -> Bool {
  let intent = srv3_os_install_actuate_credential_intent()
  match resolve_bmc_credential(
    intent: intent,
    observation: CredentialStateUnknown { reason: "probe failed" },
  ) {
    CredentialResolutionRefused { reason: r } => string_contains(s: r, pattern: "probe failed")
    _ => false
  }
}
