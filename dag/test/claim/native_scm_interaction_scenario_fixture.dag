module test.claim.native_scm_interaction_scenario_fixture


type NativeScmScenario
  = TwoIndependentChangesLand
  | StaleTargetAutoResync
  | DuplicateSubmissionAppliesOnce
  | RenameReferenceUniqueMeaning
  | TwoLegitimateMeaningsNeedChoice
  | IncompatibleGoalsNeedAuthorizedDecider
  | EvidenceGatheredInternally
  | ToolModelProofDeficitRoutesInternally
  | ProjectionFailureRepairsWithoutReinterpretation
  | ConventionalScmImportWithoutManualRewrite
  | VisibilityAuthorizedDetails

type NativeScmSubmissionLedger {
  applied: List<String>
}

fn native_scm_identity_for(
  scenario: NativeScmScenario,
) -> gunbc.native_scm_interaction_contract.NativeScmProposalIdentity {
  match scenario {
    TwoIndependentChangesLand => gunbc.native_scm_interaction_contract.NativeScmProposalIdentity {
      name: "two-independent-changes",
      attempt_key: "attempt-two-independent-changes",
    }
    StaleTargetAutoResync => gunbc.native_scm_interaction_contract.NativeScmProposalIdentity {
      name: "stale-target-auto-resync",
      attempt_key: "attempt-stale-target-auto-resync",
    }
    DuplicateSubmissionAppliesOnce => gunbc.native_scm_interaction_contract.NativeScmProposalIdentity {
      name: "duplicate-submission-applies-once",
      attempt_key: "attempt-duplicate-submission",
    }
    RenameReferenceUniqueMeaning => gunbc.native_scm_interaction_contract.NativeScmProposalIdentity {
      name: "rename-reference-unique-meaning",
      attempt_key: "attempt-rename-reference",
    }
    TwoLegitimateMeaningsNeedChoice => gunbc.native_scm_interaction_contract.NativeScmProposalIdentity {
      name: "two-legitimate-meanings-need-choice",
      attempt_key: "attempt-two-legitimate-meanings",
    }
    IncompatibleGoalsNeedAuthorizedDecider => gunbc.native_scm_interaction_contract.NativeScmProposalIdentity {
      name: "incompatible-goals-need-authorized-decider",
      attempt_key: "attempt-incompatible-goals",
    }
    EvidenceGatheredInternally => gunbc.native_scm_interaction_contract.NativeScmProposalIdentity {
      name: "evidence-gathered-internally",
      attempt_key: "attempt-evidence-gathered-internally",
    }
    ToolModelProofDeficitRoutesInternally => gunbc.native_scm_interaction_contract.NativeScmProposalIdentity {
      name: "tool-model-proof-deficit-routes-internally",
      attempt_key: "attempt-tool-model-proof-deficit",
    }
    ProjectionFailureRepairsWithoutReinterpretation => gunbc.native_scm_interaction_contract.NativeScmProposalIdentity {
      name: "projection-failure-repairs-without-reinterpretation",
      attempt_key: "attempt-projection-failure",
    }
    ConventionalScmImportWithoutManualRewrite => gunbc.native_scm_interaction_contract.NativeScmProposalIdentity {
      name: "conventional-scm-import-without-manual-rewrite",
      attempt_key: "attempt-conventional-scm-import",
    }
    VisibilityAuthorizedDetails => gunbc.native_scm_interaction_contract.NativeScmProposalIdentity {
      name: "visibility-authorized-details",
      attempt_key: "attempt-visibility-authorized-details",
    }
  }
}

fn fixture_transition(
  scenario: NativeScmScenario,
) -> gunbc.native_scm_interaction_contract.NativeScmCommitTransition {
  match scenario {
    ToolModelProofDeficitRoutesInternally =>
      gunbc.native_scm_interaction_contract.NativeScmCommitTransitionUncommitted
    TwoLegitimateMeaningsNeedChoice =>
      gunbc.native_scm_interaction_contract.NativeScmCommitTransitionUncommitted
    IncompatibleGoalsNeedAuthorizedDecider =>
      gunbc.native_scm_interaction_contract.NativeScmCommitTransitionUncommitted
    TwoIndependentChangesLand => gunbc.native_scm_interaction_contract.NativeScmCommitTransitionCommitted
    StaleTargetAutoResync => gunbc.native_scm_interaction_contract.NativeScmCommitTransitionCommitted
    DuplicateSubmissionAppliesOnce => gunbc.native_scm_interaction_contract.NativeScmCommitTransitionCommitted
    RenameReferenceUniqueMeaning => gunbc.native_scm_interaction_contract.NativeScmCommitTransitionCommitted
    EvidenceGatheredInternally => gunbc.native_scm_interaction_contract.NativeScmCommitTransitionCommitted
    ProjectionFailureRepairsWithoutReinterpretation =>
      gunbc.native_scm_interaction_contract.NativeScmCommitTransitionCommitted
    ConventionalScmImportWithoutManualRewrite =>
      gunbc.native_scm_interaction_contract.NativeScmCommitTransitionCommitted
    VisibilityAuthorizedDetails => gunbc.native_scm_interaction_contract.NativeScmCommitTransitionCommitted
  }
}

fn fixture_primary(
  scenario: NativeScmScenario,
  identity: gunbc.native_scm_interaction_contract.NativeScmProposalIdentity,
) -> gunbc.native_scm_interaction_contract.NativeScmPrimaryOutcome {
  match scenario {
    TwoIndependentChangesLand => gunbc.native_scm_interaction_contract.Landed {
      result_preview: "two independent changes both land on the same accepted target",
    }
    StaleTargetAutoResync => gunbc.native_scm_interaction_contract.Landed {
      result_preview: "stale target is replayed against the current target, then lands",
    }
    DuplicateSubmissionAppliesOnce => gunbc.native_scm_interaction_contract.Landed {
      result_preview: "duplicate submission reuses the stable proposal identity and applies once",
    }
    RenameReferenceUniqueMeaning => gunbc.native_scm_interaction_contract.Landed {
      result_preview: "rename plus reference resolves to one unique meaning",
    }
    TwoLegitimateMeaningsNeedChoice => gunbc.native_scm_interaction_contract.ChoiceRequired {
      question: "The call can follow the rename or stay separate. Which meaning should land?",
      continuation: gunbc.native_scm_interaction_contract.NativeScmContinuation {
        proposal: identity,
        options: gunbc.native_scm_interaction_contract.NativeScmContinuationOptions {
          first_option: gunbc.native_scm_interaction_contract.NativeScmContinuationOption {
            label: "follow the rename",
            result_preview: "follow the rename: keep the new spelling and move the call",
            resume_token: "resume-follow-the-rename",
          },
          second_option: gunbc.native_scm_interaction_contract.NativeScmContinuationOption {
            label: "keep a separate name",
            result_preview: "keep a separate name: preserve the old spelling as a distinct meaning",
            resume_token: "resume-keep-separate-name",
          },
          additional_options: [],
        },
      },
    }
    IncompatibleGoalsNeedAuthorizedDecider => gunbc.native_scm_interaction_contract.ChoiceRequired {
      question: "Two requested goals cannot both be retained. Which one should the authorized decider keep?",
      continuation: gunbc.native_scm_interaction_contract.NativeScmContinuation {
        proposal: identity,
        options: gunbc.native_scm_interaction_contract.NativeScmContinuationOptions {
          first_option: gunbc.native_scm_interaction_contract.NativeScmContinuationOption {
            label: "retain goal A",
            result_preview: "retain goal A and drop goal B",
            resume_token: "resume-retain-goal-a",
          },
          second_option: gunbc.native_scm_interaction_contract.NativeScmContinuationOption {
            label: "retain goal B",
            result_preview: "retain goal B and drop goal A",
            resume_token: "resume-retain-goal-b",
          },
          additional_options: [],
        },
      },
    }
    EvidenceGatheredInternally => gunbc.native_scm_interaction_contract.Landed {
      result_preview: "support was gathered internally, so the proposal lands without a user question",
    }
    ToolModelProofDeficitRoutesInternally => gunbc.native_scm_interaction_contract.InProgress {
      progress_preview: "tool, model, and proof work remain internal; the proposal is still progressing",
    }
    ProjectionFailureRepairsWithoutReinterpretation => gunbc.native_scm_interaction_contract.Landed {
      result_preview: "accepted result remains landed while its compatibility projection is repaired separately",
    }
    ConventionalScmImportWithoutManualRewrite => gunbc.native_scm_interaction_contract.Landed {
      result_preview: "a conventional SCM import lands as an ordinary import with no manual synchronization rewrite",
    }
    VisibilityAuthorizedDetails => gunbc.native_scm_interaction_contract.Landed {
      result_preview: "details stay optional and can be projected only when visibility authorizes them",
    }
  }
}

fn fixture_details(
  scenario: NativeScmScenario,
) -> v2.std.optional.Optional<String> {
  match scenario {
    TwoIndependentChangesLand => v2.std.optional.Present {
      value: "details: both changes are independently grounded and both land",
    }
    StaleTargetAutoResync => v2.std.optional.Present {
      value: "details: the stale receipt is replayed against the current target before landing",
    }
    DuplicateSubmissionAppliesOnce => v2.std.optional.Present {
      value: "details: stable proposal identity deduplicates repeated submission",
    }
    RenameReferenceUniqueMeaning => v2.std.optional.Present {
      value: "details: rename transport preserves the unique meaning of the reference",
    }
    TwoLegitimateMeaningsNeedChoice => v2.std.optional.Present {
      value: "details: the selected alternative advances to the next reconciliation state",
    }
    IncompatibleGoalsNeedAuthorizedDecider => v2.std.optional.Present {
      value: "details: the authorized decider chooses which incompatible goal to retain",
    }
    EvidenceGatheredInternally => v2.std.optional.Present {
      value: "details: obtainable evidence is gathered inside the machine before the user sees a result",
    }
    ToolModelProofDeficitRoutesInternally => v2.std.optional.Present {
      value: "details: internal progress stays internal until the machine finishes its own continuation",
    }
    ProjectionFailureRepairsWithoutReinterpretation => v2.std.optional.Present {
      value: "details: compatibility repair updates only the projection, not the semantic result",
    }
    ConventionalScmImportWithoutManualRewrite => v2.std.optional.Present {
      value: "details: import is accepted through its native realization without a manual synchronization rewrite",
    }
    VisibilityAuthorizedDetails => v2.std.optional.Present {
      value: "details: this text is only available when visibility authorizes it",
    }
  }
}

fn fixture_check(
  scenario: NativeScmScenario,
) -> gunbc.native_scm_interaction_contract.NativeScmLifecycle {
  match scenario {
    ToolModelProofDeficitRoutesInternally => gunbc.native_scm_interaction_contract.NativeScmLifecyclePending
    TwoIndependentChangesLand => gunbc.native_scm_interaction_contract.NativeScmLifecycleReady
    StaleTargetAutoResync => gunbc.native_scm_interaction_contract.NativeScmLifecycleReady
    DuplicateSubmissionAppliesOnce => gunbc.native_scm_interaction_contract.NativeScmLifecycleReady
    RenameReferenceUniqueMeaning => gunbc.native_scm_interaction_contract.NativeScmLifecycleReady
    TwoLegitimateMeaningsNeedChoice => gunbc.native_scm_interaction_contract.NativeScmLifecycleReady
    IncompatibleGoalsNeedAuthorizedDecider => gunbc.native_scm_interaction_contract.NativeScmLifecycleReady
    EvidenceGatheredInternally => gunbc.native_scm_interaction_contract.NativeScmLifecycleReady
    ProjectionFailureRepairsWithoutReinterpretation =>
      gunbc.native_scm_interaction_contract.NativeScmLifecycleReady
    ConventionalScmImportWithoutManualRewrite => gunbc.native_scm_interaction_contract.NativeScmLifecycleReady
    VisibilityAuthorizedDetails => gunbc.native_scm_interaction_contract.NativeScmLifecycleReady
  }
}

fn fixture_operational(
  scenario: NativeScmScenario,
) -> gunbc.native_scm_interaction_contract.NativeScmOperationalState {
  match scenario {
    ProjectionFailureRepairsWithoutReinterpretation =>
      gunbc.native_scm_interaction_contract.NativeScmProjectionRepairPending
    ToolModelProofDeficitRoutesInternally =>
      gunbc.native_scm_interaction_contract.NativeScmInternalWorkPending
    TwoIndependentChangesLand => gunbc.native_scm_interaction_contract.NativeScmOperationalReady
    StaleTargetAutoResync => gunbc.native_scm_interaction_contract.NativeScmOperationalReady
    DuplicateSubmissionAppliesOnce => gunbc.native_scm_interaction_contract.NativeScmOperationalReady
    RenameReferenceUniqueMeaning => gunbc.native_scm_interaction_contract.NativeScmOperationalReady
    TwoLegitimateMeaningsNeedChoice => gunbc.native_scm_interaction_contract.NativeScmOperationalReady
    IncompatibleGoalsNeedAuthorizedDecider => gunbc.native_scm_interaction_contract.NativeScmOperationalReady
    EvidenceGatheredInternally => gunbc.native_scm_interaction_contract.NativeScmOperationalReady
    ConventionalScmImportWithoutManualRewrite => gunbc.native_scm_interaction_contract.NativeScmOperationalReady
    VisibilityAuthorizedDetails => gunbc.native_scm_interaction_contract.NativeScmOperationalReady
  }
}

fn native_scm_scenario_fixture_projection(
  scenario: NativeScmScenario,
) -> gunbc.native_scm_interaction_contract.NativeScmProjection {
  let workspace = match scenario {
    ProjectionFailureRepairsWithoutReinterpretation =>
      "/workspaces/native-scm-projection-repair"
    ConventionalScmImportWithoutManualRewrite =>
      "/workspaces/native-scm-conventional-import"
    TwoIndependentChangesLand => "/workspaces/native-scm-contract"
    StaleTargetAutoResync => "/workspaces/native-scm-contract"
    DuplicateSubmissionAppliesOnce => "/workspaces/native-scm-contract"
    RenameReferenceUniqueMeaning => "/workspaces/native-scm-contract"
    TwoLegitimateMeaningsNeedChoice => "/workspaces/native-scm-contract"
    IncompatibleGoalsNeedAuthorizedDecider => "/workspaces/native-scm-contract"
    EvidenceGatheredInternally => "/workspaces/native-scm-contract"
    ToolModelProofDeficitRoutesInternally => "/workspaces/native-scm-contract"
    VisibilityAuthorizedDetails => "/workspaces/native-scm-contract"
  }
  gunbc.native_scm_interaction_contract.NativeScmProjection {
    workspace: v2.std.optional.optional_present(value: workspace),
    target: v2.std.optional.optional_present(value: "main"),
    realizations: [],
  }
}

fn native_scm_receipt_for(
  scenario: NativeScmScenario,
) -> gunbc.native_scm_interaction_contract.NativeScmReceipt {
  let identity = native_scm_identity_for(scenario: scenario)
  gunbc.native_scm_interaction_contract.NativeScmReceipt {
    identity: identity,
    transition: fixture_transition(scenario: scenario),
    review: gunbc.native_scm_interaction_contract.NativeScmLifecycleReady,
    access: gunbc.native_scm_interaction_contract.NativeScmLifecycleReady,
    check: fixture_check(scenario: scenario),
    operational: fixture_operational(scenario: scenario),
    projections: native_scm_scenario_fixture_projection(scenario: scenario),
    primary: fixture_primary(
      scenario: scenario,
      identity: identity,
    ),
    receipt_details: fixture_details(scenario: scenario),
  }
}

fn native_scm_submission_ledger() -> NativeScmSubmissionLedger {
  NativeScmSubmissionLedger { applied: [] }
}

fn native_scm_apply_once(
  ledger: NativeScmSubmissionLedger,
  receipt: gunbc.native_scm_interaction_contract.NativeScmReceipt,
) -> NativeScmSubmissionLedger {
  if all(ledger.applied, applied =>
    applied != receipt.identity.attempt_key
  ) {
    NativeScmSubmissionLedger {
      applied: concat(
        ledger.applied,
        [receipt.identity.attempt_key],
      ),
    }
  } else {
    ledger
  }
}

fn native_scm_rekey_receipt(
  receipt: gunbc.native_scm_interaction_contract.NativeScmReceipt,
  attempt_key: String,
) -> gunbc.native_scm_interaction_contract.NativeScmReceipt {
  gunbc.native_scm_interaction_contract.NativeScmReceipt {
    identity: gunbc.native_scm_interaction_contract.NativeScmProposalIdentity {
      name: receipt.identity.name,
      attempt_key: attempt_key,
    },
    transition: receipt.transition,
    review: receipt.review,
    access: receipt.access,
    check: receipt.check,
    operational: receipt.operational,
    projections: receipt.projections,
    primary: receipt.primary,
    receipt_details: receipt.receipt_details,
  }
}

fn native_scm_applied_count(
  ledger: NativeScmSubmissionLedger,
) -> Int {
  ledger.applied.length()
}
