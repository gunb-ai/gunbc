module test.claim.observation_seed_scoped_run_witness


fn entry() -> NonEmptyStr {
  "dag/example/scoped_run.dag" as NonEmptyStr
}

fn function() -> NonEmptyStr {
  "check_scoped_run" as NonEmptyStr
}

fn module_path() -> NonEmptyStr {
  "test.fixtures.scoped_run" as NonEmptyStr
}

test fn scoped_run_pty_begin_projects_exact_overwrite_bytes_and_open_state() -> Bool {
  match gunbc.observation_seed_render.scoped_run_begin_write(
    entry_file: entry(),
    module_path: module_path(),
    function: function(),
    addressable: true,
    emoji: false,
    prior: DynamicLineClosed
  ) {
    gunbc.observation_seed_render.ScopedRunWriteRefused { cause: _ } => false
    gunbc.observation_seed_render.ScopedRunWriteProjected { bytes: b, next: n } =>
      b == concat(
        extdeps.render.ansi.ansi_carriage_return,
        concat(extdeps.render.ansi.ansi_erase_entire_line(), "◐ started decl=test.fixtures.scoped_run::check_scoped_run#whole")
      ) && n == DynamicLineOpen
  }
}

test fn scoped_run_pipe_begin_appends_without_terminal_controls() -> Bool {
  match gunbc.observation_seed_render.scoped_run_begin_write(
    entry_file: entry(),
    module_path: module_path(),
    function: function(),
    addressable: false,
    emoji: false,
    prior: DynamicLineClosed
  ) {
    gunbc.observation_seed_render.ScopedRunWriteRefused { cause: _ } => false
    gunbc.observation_seed_render.ScopedRunWriteProjected { bytes: b, next: n } =>
      b == concat("◐ started decl=test.fixtures.scoped_run::check_scoped_run#whole", extdeps.render.ansi.ansi_line_feed) && n == DynamicLineClosed
  }
}

test fn scoped_run_refused_is_persistent_append_and_closes_open_line() -> Bool {
  match gunbc.observation_seed_render.scoped_run_refused_write(
    entry_file: entry(),
    module_path: module_path(),
    function: function(),
    diagnostic: "claim returned non-Bool" as NonEmptyStr,
    addressable: true,
    emoji: false,
    prior: DynamicLineOpen
  ) {
    gunbc.observation_seed_render.ScopedRunWriteRefused { cause: _ } => false
    gunbc.observation_seed_render.ScopedRunWriteProjected { bytes: b, next: n } =>
      b == concat(
        extdeps.render.ansi.ansi_carriage_return,
        concat(
          extdeps.render.ansi.ansi_erase_entire_line(),
          concat(
            "⛔ decl=test.fixtures.scoped_run::check_scoped_run#whole refused: claim returned non-Bool (duration unmeasured: scoped run wall is not measured)",
            extdeps.render.ansi.ansi_line_feed
          )
        )
      ) && n == DynamicLineClosed
  }
}

test fn scoped_run_intrinsic_failures_ignore_unavailable_basis() -> Bool {
  match gunbc.observation_seed_render.scoped_run_failed_write(
    entry_file: entry(),
    module_path: module_path(),
    function: function(),
    error: "runtime failed" as NonEmptyStr,
    addressable: true,
    emoji: false,
    prior: DynamicLineClosed
  ) {
    gunbc.observation_seed_render.ScopedRunWriteRefused { cause: _ } => false
    gunbc.observation_seed_render.ScopedRunWriteProjected { bytes: b, next: n } =>
      string_contains(s: b, pattern: "failed: runtime failed") && string_contains(s: b, pattern: "\n") && n == DynamicLineClosed
  } &&
  match gunbc.observation_seed_render.scoped_run_timed_out_write(
    entry_file: entry(),
    module_path: module_path(),
    function: function(),
    basis: std.measure.CpuClock,
    budget: std.measure.millisecond(count: 10),
    elapsed: std.measure.millisecond(count: 11),
    addressable: true,
    emoji: false,
    prior: DynamicLineClosed
  ) {
    gunbc.observation_seed_render.ScopedRunWriteRefused { cause: _ } => false
    gunbc.observation_seed_render.ScopedRunWriteProjected { bytes: b, next: n } =>
      string_contains(s: b, pattern: "timed out after") && string_contains(s: b, pattern: "\n") && n == DynamicLineClosed
  }
}

test fn scoped_run_clean_final_appends_and_closes_dynamic_line() -> Bool {
  match gunbc.observation_seed_render.scoped_run_final_write(
    entry_file: entry(),
    module_path: module_path(),
    function: function(),
    addressable: true,
    emoji: false,
    prior: DynamicLineOpen
  ) {
    gunbc.observation_seed_render.ScopedRunWriteRefused { cause: _ } => false
    gunbc.observation_seed_render.ScopedRunWriteProjected { bytes: b, next: n } =>
      string_contains(s: b, pattern: extdeps.render.ansi.ansi_carriage_return) &&
      string_contains(s: b, pattern: extdeps.render.ansi.ansi_erase_entire_line()) &&
      string_contains(s: b, pattern: "finished with 0 problems shown") &&
      string_contains(s: b, pattern: "\n") &&
      n == DynamicLineClosed
  }
}

test fn scoped_run_routine_measured_wall_preserves_unavailable_basis_refusal() -> Bool {
  match gunbc.observation_seed_render.scoped_run_routine_measured_without_basis(
    entry_file: entry(),
    module_path: module_path(),
    function: function(),
    elapsed: std.measure.millisecond(count: 7),
    addressable: true,
    emoji: false,
    prior: DynamicLineClosed
  ) {
    gunbc.observation_seed_render.ScopedRunWriteProjected { bytes: _, next: _ } => false
    gunbc.observation_seed_render.ScopedRunWriteRefused { cause: c } => c == "scoped run has no attention basis"
  }
}

test fn scoped_run_measured_nanosecond_precision_matrix_is_projected() -> Bool {
  match gunbc.observation_seed_render.scoped_run_refused_write_measured(entry_file: entry(), module_path: module_path(), function: function(), diagnostic: "claim returned non-Bool" as NonEmptyStr, wall: std.measure.nanosecond(count: 1), addressable: false, emoji: false, prior: DynamicLineClosed) {
    gunbc.observation_seed_render.ScopedRunMeasuredRefused { cause: _ } => false
    gunbc.observation_seed_render.ScopedRunMeasuredProjected { bytes: one, next: one_state, wall: one_wall } =>
      match gunbc.observation_seed_render.scoped_run_refused_write_measured(entry_file: entry(), module_path: module_path(), function: function(), diagnostic: "claim returned non-Bool" as NonEmptyStr, wall: std.measure.nanosecond(count: 999999), addressable: false, emoji: false, prior: DynamicLineClosed) {
        gunbc.observation_seed_render.ScopedRunMeasuredRefused { cause: _ } => false
        gunbc.observation_seed_render.ScopedRunMeasuredProjected { bytes: sub_ms, next: sub_ms_state, wall: sub_ms_wall } =>
          match gunbc.observation_seed_render.scoped_run_refused_write_measured(entry_file: entry(), module_path: module_path(), function: function(), diagnostic: "claim returned non-Bool" as NonEmptyStr, wall: std.measure.nanosecond(count: 1000000), addressable: false, emoji: false, prior: DynamicLineClosed) {
            gunbc.observation_seed_render.ScopedRunMeasuredRefused { cause: _ } => false
            gunbc.observation_seed_render.ScopedRunMeasuredProjected { bytes: one_ms, next: one_ms_state, wall: one_ms_wall } =>
              one_state == DynamicLineClosed && sub_ms_state == DynamicLineClosed && one_ms_state == DynamicLineClosed &&
              std.measure.nanosecond_count(n: one_wall) == 1 && std.measure.nanosecond_count(n: sub_ms_wall) == 999999 && std.measure.nanosecond_count(n: one_ms_wall) == 1000000
          }
      }
  }
}

test fn scoped_run_clean_final_is_unmeasured_and_end_receipt_is_typed() -> Bool {
  match gunbc.observation_seed_render.scoped_run_final_write(entry_file: entry(), module_path: module_path(), function: function(), addressable: false, emoji: false, prior: DynamicLineClosed) {
    gunbc.observation_seed_render.ScopedRunWriteRefused { cause: _ } => false
    gunbc.observation_seed_render.ScopedRunWriteProjected { bytes: _, next: final_state } =>
      match gunbc.observation_seed_render.scoped_run_timing_receipt(wall: std.measure.nanosecond(count: 1000000), seed_resolution: std.measure.nanosecond(count: 999999)) {
        gunbc.observation_seed_render.ScopedRunTimingProjected { wall: wall, seed_resolution: seed } =>
          final_state == DynamicLineClosed && std.measure.nanosecond_count(n: wall) == 1000000 && std.measure.nanosecond_count(n: seed) == 999999
      }
  }
}

test fn scoped_run_propagates_terminal_state_refusal() -> Bool {
  match gunbc.observation_seed_render.scoped_run_begin_write(
    entry_file: entry(),
    module_path: module_path(),
    function: function(),
    addressable: false,
    emoji: false,
    prior: DynamicLineOpen
  ) {
    gunbc.observation_seed_render.ScopedRunWriteProjected { bytes: _, next: _ } => false
    gunbc.observation_seed_render.ScopedRunWriteRefused { cause: c } =>
      c == "non-addressable terminal cannot continue an open dynamic line"
  }
}

test fn scoped_run_closes_before_deferred_diagnostics() -> Bool {
  match gunbc.observation_seed_render.scoped_run_close_before_deferred_write(
    entry_file: entry(),
    module_path: module_path(),
    function: function(),
    addressable: true,
    emoji: false,
    prior: DynamicLineOpen
  ) {
    gunbc.observation_seed_render.ScopedRunWriteRefused { cause: _ } => false
    gunbc.observation_seed_render.ScopedRunWriteProjected { bytes: b, next: n } =>
      b == concat(extdeps.render.ansi.ansi_carriage_return, extdeps.render.ansi.ansi_erase_entire_line()) && n == DynamicLineClosed
  }
}
