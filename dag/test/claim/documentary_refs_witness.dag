module test.claim.documentary_refs_witness

import std.types { Bool, String }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import v2.lens.module_graph { ModuleDeclarationFact }
import v2.std.decl_index { DeclFact, FnItem, TypeItem, decl_facts_at }
import v2.std.decl_facts_skeleton { decl_facts_matching_qualified_name }
import v2.lens.enforcement.receipts { enforcement_red_probe_body_leaf }
import v2.std.decl_ref_resolution_host { cited_declaration_ref_refusal_count }
import gunbc.documentary_refs {
  documentary_ref_symbol_text,
  generated_document_declaration_refs,
  document_ledger_declaration_refs,
  v1_maintenance_standing_ref,
  required_gate_subjects_ref,
}
import gunbc.design_document { expected_design_md }
import gunbc.design_ruling { DesignRuling, design_rulings, ruling_ledger_notes }

// THE PERTURBATIONS ARE THE POINT, AND EACH RUNS AGAINST THE SAME RESOLVER PRODUCTION USES.
// cited_declaration_ref_refusal_count is v2.std.decl_ref_resolution's own counter -- the one the
// required cited-symbol gate calls -- so a refusal proved here is a refusal on the real acceptance
// path rather than a second algorithm agreeing with it. The fact populations below are planted
// rather than live because the SUBJECT of these claims is the mechanism: that a reference which
// cannot resolve refuses, and that the same reference against an intact population does not. The
// smallest crossing specimen is the requirement plus one.

fn fixture_modules() -> List<ModuleDeclarationFact> {
  [
    ModuleDeclarationFact { module: "v2.std.symbol_index", path: "src/v2/std/symbol_index.dag" },
    ModuleDeclarationFact { module: "v2.compiler.resolve", path: "src/v2/compiler/resolve.dag" },
    ModuleDeclarationFact { module: "gunbc.roadmap.roadmap_authority", path: "dag/gunbc/roadmap/roadmap_authority.dag" },
    ModuleDeclarationFact { module: "gunbc.v1.v1_maintenance_standing", path: "dag/gunbc/v1/v1_maintenance_standing.dag" },
    ModuleDeclarationFact { module: "gunbc.emitted_subject_build_gate", path: "dag/gunbc/emitted_subject_build_gate.dag" },
    ModuleDeclarationFact { module: "gunbc.design_ruling", path: "dag/gunbc/design_ruling.dag" },
  ]
}

fn fixture_fact(qualified_name: String, name: String, path: String) -> DeclFact {
  DeclFact {
    qualified_name: qualified_name,
    name: name,
    kind: FnItem,
    node: enforcement_red_probe_body_leaf,
    rel_path: path,
  }
}

// The declarations the generated document names, present exactly once each, one per row of
// generated_document_declaration_refs(). This is the
// control that proves the refusals below are caused by the perturbation rather than by a fixture
// that never resolved anything.
fn fixed_facts() -> List<DeclFact> {
  [
    fixture_fact(
      qualified_name: "gunbc.v1.v1_maintenance_standing.v1_seed_standing",
      name: "v1_seed_standing",
      path: "dag/gunbc/v1/v1_maintenance_standing.dag",
    ),
    fixture_fact(
      qualified_name: "gunbc.emitted_subject_build_gate.emitted_subject_build_rows",
      name: "emitted_subject_build_rows",
      path: "dag/gunbc/emitted_subject_build_gate.dag",
    ),
  ]
}

// The ruling rows' facts come from the same roster the document's references do, so a ruling
// added to gunbc.design_ruling design_rulings() is resolved and render-checked with no edit here.
fn ruling_facts() -> List<DeclFact> {
  map(design_rulings(), r => fixture_fact(
    qualified_name: concat("gunbc.design_ruling.", r.reference.decl_name as String),
    name: r.reference.decl_name as String,
    path: "dag/gunbc/design_ruling.dag",
  ))
}

fn intact_facts() -> List<DeclFact> {
  concat(fixed_facts(), ruling_facts())
}

// THE RESOLVER'S POPULATION IS THE WHOLE LEDGER (document_ledger_declaration_refs), so the fixture
// that proves a refusal is caused by the perturbation covers uncited rows too.
fn refusals_against(facts: List<DeclFact>) -> Int {
  cited_declaration_ref_refusal_count(
    refs: document_ledger_declaration_refs(),
    facts: facts,
    modules: fixture_modules(),
  )
}

test fn documentary_refs_intact_population_resolves_clean() -> Bool {
  refusals_against(facts: intact_facts()) == 0
}

// THE PRODUCT RED. A referenced system is renamed -- here by removing the declaration the document
// names and leaving the rest of the population intact -- and NO DOCUMENT SOURCE IS EDITED. The
// refusal count rises, which is the whole claim: the generated paragraph names its systems through
// typed rows, so the rename reaches the required gate rather than leaving a sentence quietly
// describing a declaration that no longer exists. Before this change that same rename moved
// nothing, because the name lived inside a string literal.

fn facts_without(qualified_name: String) -> List<DeclFact> {
  fold(intact_facts(), init: [], f: fn(acc, f) {
    if f.qualified_name == qualified_name { acc } else { concat(acc, [f]) }
  })
}

test fn documentary_refs_renamed_system_refuses() -> Bool {
  let clean = refusals_against(facts: intact_facts())
  let renamed = refusals_against(
    facts: facts_without(qualified_name: "gunbc.v1.v1_maintenance_standing.v1_seed_standing")
  )
  clean == 0 && renamed == 1
}

// THE SECOND PERTURBATION, AND IT IS A DIFFERENT FAILURE FROM THE FIRST. A system forked into two
// same-named declarations still EXISTS -- an existence check passes and a grep passes -- so only a
// resolver that answers zero/one/many catches it. The document's reference no longer identifies one
// system, which is exactly the §3 fork the citation rule is about, and it must refuse rather than
// pick the first.

test fn documentary_refs_ambiguous_system_refuses() -> Bool {
  let forked = concat(
    intact_facts(),
    [
      fixture_fact(
        qualified_name: "gunbc.v1.v1_maintenance_standing.v1_seed_standing",
        name: "v1_seed_standing",
        path: "dag/gunbc/v1_maintenance_standing_fork.dag",
      ),
    ]
  )
  refusals_against(facts: forked) == 1
}

// THE TWO FIXED SYSTEM ROWS ARE RENDERED, WHERE THAT IS A REAL CHECK. For a ruling row, "the
// population contains it" and "the document contains its symbol text" are the same predicate (the
// population is defined by that containment), so holding them against each other could never fail --
// and that is exactly why the ruling half is not checked this way. The two fixed rows are different:
// they are in the population BY CONSTRUCTION, not by document containment, so requiring the rendered
// document to actually carry their symbol text is a claim that can fail -- deleting either reference
// from the projection's source turns it red. The ruling half is held by the named-citation claim and
// the cited-or-noted join below.
test fn documentary_refs_generated_document_renders_the_rows() -> Bool {
  let md = expected_design_md()
  string_contains(s: md, pattern: documentary_ref_symbol_text(reference: v1_maintenance_standing_ref))
    && string_contains(s: md, pattern: documentary_ref_symbol_text(reference: required_gate_subjects_ref))
}

// COMPLETENESS IS AN IDENTITY JOIN, NOT A COUNT: design_rulings() = cited rows UNION noted rows, in
// both directions. Cited-ness is derived from the rendered document, so without this join a row could
// fall out of the population quietly -- its citation deleted, or a new row added the document never
// cites -- and nothing would refuse. A row the document does not cite MUST carry a ruling_ledger_note
// saying the document leaves it out; a row with no note must be cited. The notes are therefore the
// checked complement of the cited set, not free-floating commentary: deleting a citation from
// gunbc/design_document.dag without adding a note turns this claim red.
test fn documentary_refs_every_ruling_is_cited_by_the_document_or_noted() -> Bool {
  let md = expected_design_md()
  all(design_rulings(), r =>
    string_contains(s: md, pattern: documentary_ref_symbol_text(reference: r.reference))
      || any(ruling_ledger_notes(), n => n.ruling.decl_name == r.reference.decl_name && n.ruling.module_path == r.reference.module_path)
  )
}

// THE JOIN IS DISJOINT, SO THE TWO POPULATIONS ARE NOT OVERLAPPING CLAIMS ON THE SAME ROW: a row the
// document cites may not also carry a note asserting the document leaves it out, and a noted row may
// not be rendered. Citing a noted row (or noting a cited one) turns this claim red, which is the
// direction the notes alone could not check. A note carries ONLY its typed ruling -- its explanation
// is a // comment, which no program text reads; RED B (editing those comments changes no verdict)
// proves the prose is quarantine, not authority.
test fn documentary_refs_no_ruling_is_both_cited_and_noted() -> Bool {
  let md = expected_design_md()
  all(ruling_ledger_notes(), n => !string_contains(s: md, pattern: documentary_ref_symbol_text(reference: n.ruling)))
}

// THE CITATION ACTUALLY REACHES THE POPULATION, NAMED. Cited-ness is derived from the rendered
// document; if the document's citation of a ruling is deleted, the row drops out of the population
// with no other notice -- which is exactly right for the population, and exactly why a claim must
// NAME a few citations and fail when one vanishes. These three cover both ways the projection cites
// a row: the ruling() renderer (chain_re_derivation, coercion_is_the_implicit_safe_subset) and prose
// backticks (where_refinements_retire_for_checked_constructors). Deleting any of those citations from
// gunbc/design_document.dag turns this claim red; the ledger half of the document (uncited rows)
// stays green, as it should.
test fn documentary_refs_named_document_citations_reach_the_population() -> Bool {
  let md = expected_design_md()
  let population = generated_document_declaration_refs(document: md)
  any(population, p => p.decl_name == "chain_re_derivation")
    && any(population, p => p.decl_name == "coercion_is_the_implicit_safe_subset")
    && any(population, p => p.decl_name == "where_refinements_retire_for_checked_constructors")
}

// THE POPULATION IS EXACTLY THE NOTES' COMPLEMENT. The independent side of this identity join is
// NOT a re-run of the product's citation filter (that would be the product compared with itself,
// green no matter what it computes): it is every ruling row whose reference is not named by any
// ruling_ledger_note(). The population must equal that set exactly, both directions and by count.
// If the product's filter drifted -- an authored predicate re-introduced, a filter over the notes,
// a count shortcut -- a row the notes claim is uncited would still sit in the population, or a
// cited row would be missing, and this claim refuses.
test fn documentary_refs_population_is_exactly_the_notes_complement() -> Bool {
  let md = expected_design_md()
  let product = generated_document_declaration_refs(document: md)
  let complement = map(
    filter(design_rulings(), r => !any(ruling_ledger_notes(), n => n.ruling.decl_name == r.reference.decl_name && n.ruling.module_path == r.reference.module_path)),
    r => r.reference,
  )
  length(xs: product) == length(xs: concat([v1_maintenance_standing_ref, required_gate_subjects_ref], complement))
    && all(complement, p => any(product, q => q.decl_name == p.decl_name && q.module_path == p.module_path))
    && all(product, q =>
      (q.decl_name == v1_maintenance_standing_ref.decl_name && q.module_path == v1_maintenance_standing_ref.module_path)
        || (q.decl_name == required_gate_subjects_ref.decl_name && q.module_path == required_gate_subjects_ref.module_path)
        || any(complement, p => p.decl_name == q.decl_name && p.module_path == q.module_path))
}

// THE INHABITANCE HALF. The fixture above derives the ruling facts from the rows' own references, so
// it proves the resolver's behaviour, not that a row's reference names the row: a row whose
// decl_name drifted from its declaration would plant its own matching fact and stay green. This
// claim reads the live declaration pool, keyed, so each ruling reference must name exactly one real
// declaration. The pool is read ONCE with every ruling's key and each ruling is joined against
// that read by its own key, so a ruling answers with exactly the rows a one-key read would give.
fn documentary_ruling_key(r: DesignRuling) -> String {
  concat("gunbc.design_ruling.", r.reference.decl_name as String)
}

test fn documentary_refs_ruling_references_name_live_declarations() -> Bool {
  let facts = decl_facts_at(
    pool_roots: ["dag"],
    qualified_names: map(design_rulings(), r => documentary_ruling_key(r: r)),
    type_names: [],
  )
  all(design_rulings(), r => length(xs: decl_facts_matching_qualified_name(qn: documentary_ruling_key(r: r), facts: facts)) == 1)
}
