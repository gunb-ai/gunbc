module test.claim.optional_carrier_signature_test


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data optional_carrier_signature_witness_note: String = "THE SIGNATURE HALF OF THE v1-EMITTER OPTIONAL-RENDERING FAMILY, migrated from src/v1/tests/src/optional_carrier_signature_test.rs (v1-test-migration). The behavior: a declared optional return renders its Rust signature wrapped — `-> String?` becomes `-> Option<String>` and, on a shared (recursive) type, `-> Node?` becomes `-> Option<Rc<Node>>` — and the wrap is CARDINALITY-DERIVED rather than blanket, so a non-optional return of the same carrier stays bare. The defect this family exists to catch was the text-carrier early return short-circuiting the Optional template, which emitted a bare `String` while the body already produced Some/None: the dominant E0308 cluster in the faithful Route-A seed.\\n\\nEACH WITNESS PINS THE WHOLE SIGNATURE, NOT A SUBSTRING OF IT. The Rust module had to slice the emitted text from `fn <name>` to the body opener before asserting `contains(\\\"Option<\\\")`, because the runtime's own types legitimately mention Option and a whole-file scan would pass on them. Naming the entire expected signature removes the need for that scoping and is strictly stronger: it fixes parameter spelling and carrier rendering too, so a change that kept `Option<` while altering the rest still reds. The negative controls exclude the SPECIFIC wrapped signature rather than the bare token `Option<`, for the same reason — an unscoped exclusion would red on unrelated runtime code and would be a guard that fires for the wrong reason."

fn optional_string_return_source() -> String {
  "module optcarrierstr\n\nimport std.types { Bool, String }\n\nfn maybe_label(flag: Bool) -> String? {\n  if flag { Present { value: \"x\" } } else { none }\n}\n"
}

fn non_optional_string_return_source() -> String {
  "module optcarrierstrbare\n\nimport std.types { Bool, String }\n\nfn always_label(flag: Bool) -> String {\n  \"x\"\n}\n"
}

fn optional_shared_type_return_source() -> String {
  "module optcarriernode\n\nimport std.types { Bool }\n\ntype Node = Product { child: Node? }\n\nfn maybe_node(flag: Bool) -> Node? {\n  if flag { Present { value: Node { child: none } } } else { none }\n}\n"
}

fn non_optional_shared_type_return_source() -> String {
  "module optcarriernodebare\n\nimport std.types { Bool }\n\ntype Node = Product { child: Node? }\n\nfn always_node(flag: Bool) -> Node {\n  Node { child: none }\n}\n"
}

test fn optional_string_return_renders_option_signature() -> Bool {
  compile_dag_rust_emit_check(
    optional_string_return_source(),
    "src/optcarrierstr.rs",
    ["fn maybe_label(flag: bool) -> Option<String>"],
    []
  )
}

test fn non_optional_string_return_stays_bare() -> Bool {
  compile_dag_rust_emit_check(
    non_optional_string_return_source(),
    "src/optcarrierstrbare.rs",
    ["fn always_label(flag: bool) -> String"],
    ["fn always_label(flag: bool) -> Option<"]
  )
}

test fn optional_shared_type_return_renders_option_rc_signature() -> Bool {
  compile_dag_rust_emit_check(
    optional_shared_type_return_source(),
    "src/optcarriernode.rs",
    ["fn maybe_node(flag: bool) -> Option<Rc<Node>>"],
    []
  )
}

test fn non_optional_shared_type_return_stays_bare_rc() -> Bool {
  compile_dag_rust_emit_check(
    non_optional_shared_type_return_source(),
    "src/optcarriernodebare.rs",
    ["fn always_node(flag: bool) -> Rc<Node>"],
    ["fn always_node(flag: bool) -> Option<"]
  )
}
