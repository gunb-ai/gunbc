module test.claim.float_add_associativity_law_witness_test


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

test fn w_float_add_associativity_refuted_by_execution() -> Bool {
  gunbc.float_add_associativity_observation.float_add_associativity_refutation_holds()
}

test fn w_float_add_associativity_associative_triple_control() -> Bool {
  let a = 1.0
  let b = 2.0
  let c = 3.0
  let left = (a + b) + c
  let right = a + (b + c)
  left == right
}

test fn w_float_add_associativity_rejects_fabricated_left_fold_result() -> Bool {
  let witness = float_add_associativity_refuted.witness
  let fabricated = std.algebra_law.AssociativityCounterexampleWitness {
    left_operand: witness.left_operand,
    middle_operand: witness.middle_operand,
    right_operand: witness.right_operand,
    left_fold_result: witness.right_fold_result,
    right_fold_result: witness.right_fold_result,
  }
  let bad_receipt = std.algebra_law.AssociativityRefutationReceipt {
    subject: gunbc.float_add_associativity_observation.float_add_associativity_subject,
    witness: fabricated,
  }
  !std.algebra_law.associativity_refutation_holds_for_float_add(receipt: bad_receipt)
}

test fn w_float_kernel_type_in_std_types_roster() -> Bool {
  std.algebra_law.float_kernel_type_in_authority_roster()
}

test fn w_float_add_associativity_subject_is_float_add_coproduct() -> Bool {
  gunbc.float_add_associativity_observation.float_add_associativity_subject == std.algebra_law.AssociativityFloatAdd {}
}
