module test.claim.vast_ai_offer_decode_witness

import std.types { Bool, Int, List, String }
import std.optional { Present, Absent }
import std.decimal { ExactDecimal }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import extdeps.cloud.vast_ai { VastAiOffer }
import extdeps.transports.rest { RestAnswered, RestRefused, RestResponseObserved, RestBodyRead }
import v2.std.witness_evaluation { WitnessReturned, WitnessRefused, WitnessInterrupted, evaluate_in_witness_frame }
import test.claim.rest_exchange_replay { replay_frame, fixture_for }
import test.fixture.rest_exchange_replay_probe

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// A DECLARED ExactDecimal DECODES EXACTLY FROM THE WIRE NUMBER (gunbc.recurring_failure_mode
// rest_response_declared_exact_decimal_decoded_as_float). The body is the shape of one offer a live
// type=bid search answered from srv1 on 2026-10-18 (offer 44111199, an RTX PRO 6000 WS): money fields are
// JSON numbers, storage_cost carries a float's full shortest spelling, and cuda_max_good (declared
// ExactDecimal?) is 13.0. Served through the REST replay seam, so the interpreter's own response decode
// produces the values judged. On the old decode every one of these arrived as a Float, and reading
// `units` off it refused the whole pass on srv1 (fleet-converge run 39202648251).
data live_offer_body: String = "{\"offers\":[{\"id\":44111199,\"machine_id\":7001,\"gpu_name\":\"RTX PRO 6000 WS\",\"num_gpus\":1,\"compute_cap\":1200,\"gpu_arch\":\"nvidia\",\"verification\":\"verified\",\"geolocation\":\"US\",\"rentable\":true,\"rented\":false,\"is_bid\":false,\"min_bid\":0.269,\"dph_total\":0.27122222222222225,\"storage_cost\":0.19999999999999998,\"inet_up_cost\":0.0020,\"inet_down_cost\":0.002,\"gpu_ram\":97887,\"driver_version\":\"580.159.03\",\"cuda_max_good\":13.0,\"inet_down\":1203.4}]}"

type OfferReading
  = OfferDecoded { offer: VastAiOffer }
  | OfferNotDecoded

fn decoded_offer() -> OfferReading {
  let result = evaluate_in_witness_frame(
    frame: replay_frame(fixtures: [fixture_for(
      operation: "VastOffersPage",
      observation: RestResponseObserved { status: 200, body: RestBodyRead { body: live_offer_body } }
    )]),
    subject: fn(_scope) {
      match test.RestReplay.VastOffersPage() {
        RestAnswered { answer } => match first(answer.offers) {
          Present { value: o } => OfferDecoded { offer: o }
          Absent => OfferNotDecoded
        }
        RestRefused { refusal: _ } => OfferNotDecoded
      }
    }
  )
  match result {
    WitnessReturned { value } => value
    WitnessRefused { diagnostic: _ } => OfferNotDecoded
    WitnessInterrupted { at: _, route: _, state: _ } => OfferNotDecoded
  }
}

fn decimal_is(d: ExactDecimal, units: Int, fraction_digits: Int) -> Bool {
  (d.units == units) && (d.fraction_digits == fraction_digits)
}

fn optional_decimal_is(d: ExactDecimal?, units: Int, fraction_digits: Int) -> Bool {
  match d {
    Present { value: v } => decimal_is(d: v, units: units, fraction_digits: fraction_digits)
    Absent => false
  }
}

test fn a_wire_number_declared_exact_decimal_decodes_to_its_exact_digits() -> Bool {
  match decoded_offer() {
    OfferNotDecoded => false
    OfferDecoded { offer: o } =>
      decimal_is(d: o.min_bid, units: 269, fraction_digits: 3)
        && decimal_is(d: o.storage_cost, units: 19999999999999998, fraction_digits: 17)
        && decimal_is(d: o.dph_total, units: 27122222222222225, fraction_digits: 17)
  }
}

test fn an_optional_exact_decimal_decodes_through_its_optional_layer() -> Bool {
  match decoded_offer() {
    OfferNotDecoded => false
    OfferDecoded { offer: o } =>
      optional_decimal_is(d: o.cuda_max_good, units: 130, fraction_digits: 1)
        && optional_decimal_is(d: o.inet_down, units: 12034, fraction_digits: 1)
  }
}


// THE WIRE'S SCALE IS KEPT AND A NUMBER BEYOND INT UNITS REFUSES. inet_up_cost arrives as 0.0020 and must
// decode to (20, 4), not the shortest-f64 (2, 3); a decode routed through f64 loses that trailing zero. A
// price spelled with 20 significant digits has no Int units, so the decode refuses the page rather than
// rounding it to the nearest double.
data overlong_offer_body: String = "{\"offers\":[{\"id\":1,\"machine_id\":1,\"gpu_name\":\"RTX PRO 6000 WS\",\"num_gpus\":1,\"compute_cap\":1200,\"verification\":\"verified\",\"geolocation\":\"US\",\"rentable\":true,\"rented\":false,\"min_bid\":0.12345678901234567891,\"dph_total\":0.3,\"storage_cost\":0.2,\"inet_up_cost\":0.002,\"inet_down_cost\":0.002,\"gpu_ram\":97887}]}"

fn overlong_decoded() -> Bool {
  let result = evaluate_in_witness_frame(
    frame: replay_frame(fixtures: [fixture_for(
      operation: "VastOffersPage",
      observation: RestResponseObserved { status: 200, body: RestBodyRead { body: overlong_offer_body } }
    )]),
    subject: fn(_scope) {
      match test.RestReplay.VastOffersPage() {
        RestAnswered { answer: _ } => true
        RestRefused { refusal: _ } => false
      }
    }
  )
  match result {
    WitnessReturned { value } => value
    WitnessRefused { diagnostic: _ } => false
    WitnessInterrupted { at: _, route: _, state: _ } => false
  }
}

test fn the_wire_scale_is_kept_and_an_overlong_number_refuses() -> Bool {
  (match decoded_offer() {
    OfferNotDecoded => false
    OfferDecoded { offer: o } => decimal_is(d: o.inet_up_cost, units: 20, fraction_digits: 4)
  }) && !overlong_decoded()
}

// A HOSTILE EXPONENT REFUSES, IT DOES NOT HANG OR WIDEN (review 82479). `0e9223372036854775807` has a zero
// mantissa, which never overflows, so an unbounded scaling loop would not return; `1e-999999999` names a
// billion fraction digits. Both must refuse the page in bounded time.
fn offer_body_with_min_bid(min_bid: String) -> String {
  join(["{\"offers\":[{\"id\":1,\"machine_id\":1,\"gpu_name\":\"RTX PRO 6000 WS\",\"num_gpus\":1,\"compute_cap\":1200,\"verification\":\"verified\",\"geolocation\":\"US\",\"rentable\":true,\"rented\":false,\"min_bid\":", min_bid, ",\"dph_total\":0.3,\"storage_cost\":0.2,\"inet_up_cost\":0.002,\"inet_down_cost\":0.002,\"gpu_ram\":97887}]}"], "")
}

fn body_decodes(body: String) -> Bool {
  let result = evaluate_in_witness_frame(
    frame: replay_frame(fixtures: [fixture_for(
      operation: "VastOffersPage",
      observation: RestResponseObserved { status: 200, body: RestBodyRead { body: body } }
    )]),
    subject: fn(_scope) {
      match test.RestReplay.VastOffersPage() {
        RestAnswered { answer: _ } => true
        RestRefused { refusal: _ } => false
      }
    }
  )
  match result {
    WitnessReturned { value } => value
    WitnessRefused { diagnostic: _ } => false
    WitnessInterrupted { at: _, route: _, state: _ } => false
  }
}

test fn a_hostile_exponent_refuses_in_bounded_time() -> Bool {
  !body_decodes(body: offer_body_with_min_bid(min_bid: "0e9223372036854775807"))
    && !body_decodes(body: offer_body_with_min_bid(min_bid: "1e-999999999"))
    && body_decodes(body: offer_body_with_min_bid(min_bid: "2.69e-1"))
}

// A SMALL PRICE KEEPS ITS SCALE. A live offer answered inet_down_cost 0.00026041666666666666: 17 significant
// digits that fit Int units, at 20 fraction digits. A decode that capped the scale at 19 refused it, and with
// it the whole offer page (fleet-converge run 39222150650).
// ...but leading zeros do not buy an unbounded scale (review 82586): `0.` then forty zeros then `1` has
// exponent 0 and a mantissa of 1, so only the scale cap refuses it.
test fn a_small_price_with_a_deep_scale_decodes_exactly() -> Bool {
  body_decodes(body: offer_body_with_min_bid(min_bid: "0.00026041666666666666"))
    && !body_decodes(body: offer_body_with_min_bid(min_bid: "0.00000000000000000000000000000000000000001"))
}
