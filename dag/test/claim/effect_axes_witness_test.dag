module test.claim.effect_axes_witness_test

import std.types { Bool, String, List }
import std.effect_grant {
  Grant, Envelope, NamespacePosition, filesystem_position,
  Read, Write, RealTransport, Replay,
  LifecycleByConvention,
}
import std.materialization_ladder { LadderFrame, SharedStateFrame }
import std.effect_axes {
  EffectRegion, SubstrateClosure, RepoTree, FrameScratch, UnclassifiedRegion,
  classify_region,
  region_substrate_closure_root, region_repo_root, region_frame_scratch_root,
  envelope_replayable, envelope_isolated, envelope_live_tree_intersects,
}
import v2.std.execution_envelope {
  hermetic_envelope, wet_envelope, record_envelope,
  derive_live_tree_disposition,
}
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree, SubstrateInputsOnly }

data effect_axes_witness_note: String = "Discriminating witnesses for the P-C derived axes (std.effect_axes) and the ExecutionMode presets (v2.std.execution_envelope). classify_region is derived from the grant root position via position_under (each region + the UnclassifiedRegion residue). The three axes over the presets: hermetic reads substrate-closure + writes frame-scratch, so replayable AND isolated AND NOT live-tree; wet reads+writes the repo tree for real, so NOT replayable AND NOT isolated AND reads-live; record is reach-identical to wet by construction (capture is orthogonal). derive_live_tree_disposition bridges to the real v2.std.live_tree.LiveTreeDisposition (the retire target for the 763 hand-stamped rows). Two REDs pin the fail-closed choices: an UnclassifiedRegion read is ASSUMED live (unknown region never silently skips); and a Replay-bound RepoTree read is replayable AND NOT live -- the binding-aware control that would flip if live_tree_intersects were root-only, proving 'replayable => SubstrateInputsOnly' holds."

data red_frame: Frame = LadderFrame { name: "axes-red", kind: SharedStateFrame }

fn unclassified_read_envelope() -> Envelope {
  Envelope {
    frame: red_frame,
    grants: [
      Grant {
        verb: Read,
        root: filesystem_position(path: ["elsewhere"]),
        binding: RealTransport,
        lifecycle: LifecycleByConvention
      }
    ]
  }
}

fn replay_repo_read_envelope() -> Envelope {
  Envelope {
    frame: red_frame,
    grants: [
      Grant {
        verb: Read,
        root: region_repo_root,
        binding: Replay { fixture_store: "fx" },
        lifecycle: LifecycleByConvention
      }
    ]
  }
}

test fn classify_region_closure_is_substrate() -> Bool {
  match classify_region(root: region_substrate_closure_root) {
    SubstrateClosure => true
    RepoTree => false
    FrameScratch => false
    UnclassifiedRegion => false
  }
}

test fn classify_region_repo_is_repo() -> Bool {
  match classify_region(root: region_repo_root) {
    RepoTree => true
    SubstrateClosure => false
    FrameScratch => false
    UnclassifiedRegion => false
  }
}

test fn classify_region_scratch_is_frame_scratch() -> Bool {
  match classify_region(root: region_frame_scratch_root) {
    FrameScratch => true
    SubstrateClosure => false
    RepoTree => false
    UnclassifiedRegion => false
  }
}

test fn classify_region_unknown_is_unclassified() -> Bool {
  match classify_region(root: filesystem_position(path: ["elsewhere"])) {
    UnclassifiedRegion => true
    SubstrateClosure => false
    RepoTree => false
    FrameScratch => false
  }
}

test fn hermetic_is_replayable_isolated_not_live() -> Bool {
  envelope_replayable(env: hermetic_envelope())
    && envelope_isolated(env: hermetic_envelope())
    && !envelope_live_tree_intersects(env: hermetic_envelope())
}

test fn wet_is_not_replayable_not_isolated_reads_live() -> Bool {
  !envelope_replayable(env: wet_envelope())
    && !envelope_isolated(env: wet_envelope())
    && envelope_live_tree_intersects(env: wet_envelope())
}

test fn record_reach_identical_to_wet() -> Bool {
  (envelope_replayable(env: record_envelope()) == envelope_replayable(env: wet_envelope()))
    && (envelope_isolated(env: record_envelope()) == envelope_isolated(env: wet_envelope()))
    && (envelope_live_tree_intersects(env: record_envelope()) == envelope_live_tree_intersects(env: wet_envelope()))
}

test fn derive_disposition_hermetic_is_substrate_only() -> Bool {
  match derive_live_tree_disposition(env: hermetic_envelope()) {
    SubstrateInputsOnly => true
    ReadsLiveTree => false
  }
}

test fn derive_disposition_wet_is_reads_live() -> Bool {
  match derive_live_tree_disposition(env: wet_envelope()) {
    ReadsLiveTree => true
    SubstrateInputsOnly => false
  }
}

test fn unclassified_read_assumed_live_failclosed() -> Bool {
  envelope_live_tree_intersects(env: unclassified_read_envelope())
}

test fn replay_repo_read_is_replayable_not_live() -> Bool {
  envelope_replayable(env: replay_repo_read_envelope())
    && !envelope_live_tree_intersects(env: replay_repo_read_envelope())
}
