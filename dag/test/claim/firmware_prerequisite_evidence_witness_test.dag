module test.claim.firmware_prerequisite_evidence_witness_test


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

// A SECOND, LOWER REFUSAL, authored rather than observed — the fixture that
// makes order-independence testable at all. With one refusal and one
// acceptance a first-wins accumulator and a real max/min return the SAME
// answer, so a two-element list cannot distinguish them however it is
// ordered. Only a second refusal forces the fold to choose.
data synthetic_lower_refusal: extdeps.firmware.types.FirmwarePrerequisiteObservation = extdeps.firmware.types.FirmwarePrerequisiteObservation {
  board: AsrockRackAltrad8ud1l2t,
  subject: HostBios,
  image_kind: OpenBmcWebUiTar,
  gating_target: extdeps.firmware.types.BmcController,
  gating_version: firmware_semantic_version(major: 1, minor: 0, patch: 0),
  outcome: extdeps.firmware.types.PushRefusedByTarget { diagnostic: "authored probe; no such push was executed" },
  observed_at: 1786579200000,
}

data forward_evidence: List<extdeps.firmware.types.FirmwarePrerequisiteObservation> = [
  asrock_altrad8ud_bios_310_push_refused_at_bmc_207,
  synthetic_lower_refusal,
  asrock_altrad8ud_bios_310_push_accepted_at_bmc_322,
]

data reversed_evidence: List<extdeps.firmware.types.FirmwarePrerequisiteObservation> = [
  asrock_altrad8ud_bios_310_push_accepted_at_bmc_322,
  synthetic_lower_refusal,
  asrock_altrad8ud_bios_310_push_refused_at_bmc_207,
]

// THE ORACLE IS AN IDENTITY JOIN, not a copy. An earlier revision hand-wrote
// 3.22.00 here and claimed in a comment to be comparing the same number the
// catalog declares — which it was not: changing the release row would have
// left these tests green until someone remembered to edit the witness too.
// That is the tree-copied oracle DESIGN section 5 forbids, and the comment
// asserting otherwise is what made it look already checked. The minimum now
// comes from the release row itself, so editing the catalog moves the tests.
//
// The two halves of a RED control are governed differently, and conflating them
// is what an earlier revision of this note did. Its falsifying INPUT -- the
// minimum deliberately set above or below the evidence -- stays authored, because
// a probe chosen to contradict the catalog would be unauthorable if joined to it.
// Its EXPECTED value is an oracle like any other and joins to the row that
// supplies it, so a control asserting which version was refused reads that from
// the refusal row rather than transcribing it.
fn verdict_against_declared_minimum(
  observations: List<extdeps.firmware.types.FirmwarePrerequisiteObservation>,
) -> extdeps.firmware.types.PrerequisiteEvidenceVerdict {
  match asrock_altrad8ud_bios_3_10_openbmc_release.prerequisite {
    RequiresMinimumTargetFirmware { target: _, minimum: m } =>
      prerequisite_evidence_verdict(minimum: m, observations: observations)
    NoFirmwarePrerequisite => PrerequisiteEvidenceAbsent
  }
}

fn same_firmware_version(a: extdeps.firmware.types.FirmwareSemanticVersion, b: extdeps.firmware.types.FirmwareSemanticVersion) -> Bool {
  a.major == b.major && a.minor == b.minor && a.patch == b.patch
}

// The bounds the EXECUTED pair establishes, JOINED to the observation rows that
// establish them rather than transcribed. Held once and applied to several
// orderings below, so an ordering that answered differently could not be papered
// over by a second copy of the expected numbers.
//
// The join is the point, not a stylistic preference (DESIGN §5 test-oracle rule,
// and the same pattern this file already uses for the declared minimum): written
// as literals, `2/7` and `3/22` were a second copy of two numbers whose single
// authority is the gating_version on each row. Re-flashing at a different version
// would move the rows and leave this witness green until someone remembered to
// edit it -- exactly the failure this PR removes from the minimum path. Caught in
// review 51524.
//
// Joining does NOT weaken the discrimination, which is what makes it safe here:
// both orderings below carry a THIRD, lower refusal at 1.00.00, so a first-wins
// fold reports that instead of the refused row's own 2.07.00 and still fails.
fn bounds_are_the_executed_pair(
  observations: List<extdeps.firmware.types.FirmwarePrerequisiteObservation>,
) -> Bool {
  match verdict_against_declared_minimum(observations: observations) {
    PrerequisiteConsistentUpperBound { highest_refusal: r, lowest_acceptance: a } =>
      match r {
        Present { value: rv } =>
          match a {
            Present { value: av } =>
              same_firmware_version(a: rv, b: asrock_altrad8ud_bios_310_push_refused_at_bmc_207.gating_version)
                && same_firmware_version(a: av, b: asrock_altrad8ud_bios_310_push_accepted_at_bmc_322.gating_version)
            Absent => false
          }
        Absent => false
      }
    _ => false
  }
}

// The executed pair supports the declared minimum, and the positive arm says
// what it actually establishes: an UPPER BOUND. 3.06.00 exists in the
// capability catalog and was never pushed, so the true threshold may be lower.
test fn executed_pair_supports_the_declared_minimum_as_an_upper_bound() -> Bool {
  bounds_are_the_executed_pair(observations: asrock_altrad8ud_bios_openbmc_prerequisite_evidence)
}

// ORDER INDEPENDENCE, and it took a third observation to make it real. The
// claim is that the accumulator takes the HIGHEST refusal rather than
// whichever it met first. An earlier revision compared two orderings of the
// two-element executed pair, which cannot decide that: with exactly one
// refusal in the list, first-wins and max return the same version whatever
// the order. Both lists below carry a second, LOWER refusal at 1.00.00, so a
// first-wins fold reports 1.00.00 on the reversed ordering and fails here.
test fn the_bounds_do_not_depend_on_authoring_order() -> Bool {
  bounds_are_the_executed_pair(observations: forward_evidence) && bounds_are_the_executed_pair(observations: reversed_evidence)
}

// A bound with no observation behind it is ABSENT, never filled in from the
// declared minimum. Acceptance-only evidence has no refusal to report, and
// reporting one would fabricate a push that never happened. The acceptance bound
// is joined to the single row supplied as evidence, so the claim is that the fold
// REPORTS that row's own gating_version -- not that it happens to match a number
// transcribed here (review 51524).
test fn an_acceptance_only_history_reports_no_refusal_bound() -> Bool {
  match verdict_against_declared_minimum(
    observations: [asrock_altrad8ud_bios_310_push_accepted_at_bmc_322],
  ) {
    PrerequisiteConsistentUpperBound { highest_refusal: r, lowest_acceptance: a } =>
      match r {
        Absent =>
          match a {
            Present { value: av } =>
              same_firmware_version(a: av, b: asrock_altrad8ud_bios_310_push_accepted_at_bmc_322.gating_version)
            Absent => false
          }
        Present { value: _ } => false
      }
    _ => false
  }
}

// RED control. Declaring a minimum ABOVE the version that demonstrably
// accepted the bytes is contradicted by the acceptance, not merely unsupported
// — this is the arm that catches a minimum inflated past its evidence.
test fn a_minimum_above_the_accepting_version_is_contradicted() -> Bool {
  match prerequisite_evidence_verdict(
    minimum: firmware_semantic_version(major: 4, minor: 0, patch: 0),
    observations: asrock_altrad8ud_bios_openbmc_prerequisite_evidence,
  ) {
    PrerequisiteContradictedByAcceptanceBelowMinimum { accepted_at: a } =>
      same_firmware_version(a: a, b: asrock_altrad8ud_bios_310_push_accepted_at_bmc_322.gating_version)
    _ => false
  }
}

// RED control, the other direction. Declaring a minimum at or below the
// version that was REFUSED is contradicted by the refusal — this catches a
// minimum relaxed below its evidence, which is the direction that would let an
// unappliable push be admitted.
test fn a_minimum_at_or_below_the_refusing_version_is_contradicted() -> Bool {
  match prerequisite_evidence_verdict(
    minimum: firmware_semantic_version(major: 2, minor: 0, patch: 0),
    observations: asrock_altrad8ud_bios_openbmc_prerequisite_evidence,
  ) {
    PrerequisiteContradictedByRefusalAtOrAboveMinimum { refused_at: r } =>
      same_firmware_version(a: r, b: asrock_altrad8ud_bios_310_push_refused_at_bmc_207.gating_version)
    _ => false
  }
}

// With no observations the verdict is ABSENT, never consistent. An unevidenced
// minimum must not read the same as an evidenced one.
test fn no_observations_yields_absent_not_consistent() -> Bool {
  match verdict_against_declared_minimum(observations: []) {
    PrerequisiteEvidenceAbsent => true
    _ => false
  }
}
