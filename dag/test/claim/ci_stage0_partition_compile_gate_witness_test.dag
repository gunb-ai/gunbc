module test.claim.ci_stage0_partition_compile_gate_witness


fn gate_materialized_render(plan: EffectPlan<BashBoundOperationInvocation>) -> String {
  ci_stage0_partition_compile_gate_render(plan: plan)
}

fn gate_plan_refuses(plan: EffectPlan<BashBoundOperationInvocation>) -> Bool {
  match effect_plan_bash_materialize(plan: plan) {
    EffectPlanBashMaterialized { source: _ } => false
    EffectPlanBashMaterializationRefused { refusal: _ } => true
  }
}

test fn w_stage0_partition_gate_package_count_holds() -> Bool {
  ci_stage0_partition_compile_gate_package_count_holds()
}

test fn w_stage0_partition_gate_script_names_all_seven_packages() -> Bool {
  let script = ci_stage0_partition_compile_gate_script()
  string_contains(s: script, pattern: "v1-stage0-runtime")
    && string_contains(s: script, pattern: "v1-stage0-std-core")
    && string_contains(s: script, pattern: "v1-stage0-std-surface")
    && string_contains(s: script, pattern: "v1-stage0-extdeps-languages")
    && string_contains(s: script, pattern: "v1-stage0-v1-infer")
    && string_contains(s: script, pattern: "v1-stage0-v1-artifact")
    && string_contains(s: script, pattern: "v1-stage0-emit-core")
}

test fn w_stage0_partition_gate_shell_emit_is_scaffold_holds() -> Bool {
  match ci_stage0_partition_compile_gate_shell_emit_scaffold {
    Scaffold { dissolves_to: _, bind: _ } => true
    _ => false
  }
}

test fn w_stage0_partition_gate_emit_carries_dissolve_marker_holds() -> Bool {
  string_contains(
    s: ci_stage0_partition_compile_gate_script(),
    pattern: "🟡 dissolve-on: ci_stage0_partition_compile_gate_script"
  )
}

test fn w_stage0_partition_gate_script_is_typed_plan_plus_marker() -> Bool {
  let expected = concat(
    concat(
      "# ",
      concat(dissolution_description(condition: ci_stage0_partition_compile_gate_shell_emit_dissolution_trigger), "\n")
    ),
    concat(
      gate_materialized_render(plan: ci_stage0_partition_compile_gate_intent()),
      "\n"
    )
  )
  ci_stage0_partition_compile_gate_script() == expected
}

test fn w_build_job_enrolls_stage0_partition_compile_gate_holds() -> Bool {
  fold(ci_build_job().steps, init: false, f: (acc, step) => {
    acc || match step {
      RunStep { name: _, id: _, run: cmd, shell: _, env: _, working_directory: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } =>
        string_contains(s: cmd, pattern: "v1-stage0-runtime")
          && string_contains(s: cmd, pattern: "v1-stage0-emit-core")
      UsesStep { name: _, id: _, uses: _, with: _, env: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } => false
    }
  })
}

test fn w_stage0_partition_gate_RED_missing_operation_refuses() -> Bool {
  let bad_step = bash_bind_operation_invocation(
    at: OperationRef {
      path: "dag/extdeps/rust/cargo_build.dag",
      service: "cargo.Build",
      operation: "NoSuchCheck"
    },
    bindings: [
      operation_argv_bind_text_list(
        name: "extra_args",
        items: ci_stage0_partition_compile_gate_extra_args(package_name: "v1-stage0-runtime")
      )
    ]
  )
  let refused_plan = EffectPlan {
    steps: [Do { effect: bad_step }],
    on_failure: FailFast
  }
  gate_plan_refuses(plan: refused_plan)
    && string_contains(
      s: gate_materialized_render(plan: refused_plan),
      pattern: ci_stage0_partition_compile_gate_refusal_prefix
    )
}
