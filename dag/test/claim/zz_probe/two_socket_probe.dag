module test.claim.zz_probe.two_socket_probe

import std.types { String }
import v2.std.witness_evaluation { WitnessReturned, WitnessRefused, WitnessInterrupted, witness_diagnostic_rendered_reason }
import test.claim.machine_intake.mtcollins1_boot_acceptance_matrix_test { run_attempt, world_with_console, console_of, two_socket_census_capture, outcome_reason, census_ended }

fn probe() -> String {
  match run_attempt(world: world_with_console(lines: console_of(capture: two_socket_census_capture, begin_after: 60, end_after: 240))) {
    WitnessReturned { value } => join(["RETURNED ", outcome_reason(a: value), " census_ended=", if census_ended(a: value) { "yes" } else { "no" }], "")
    WitnessRefused { diagnostic } => concat("REFUSED ", witness_diagnostic_rendered_reason(diagnostic: diagnostic))
    WitnessInterrupted { at: _ } => "INTERRUPTED"
  }
}
