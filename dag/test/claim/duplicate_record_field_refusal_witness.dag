module test.claim.duplicate_record_field_refusal_witness

import std.types { String, Int, Bool }
import std.process { ProcessExit }
import gunbc.compile_census_probe { blocking_class_census, blocking_subject_census, census_verdict, census_exit }
import std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// A RECORD LITERAL THAT ASSIGNS ONE FIELD TWICE MUST REFUSE, AND THE SAME LITERAL ASSIGNING EACH
// FIELD ONCE MUST BE ACCEPTED.
//
// THIS RED IS NOW A REGRESSION CONTROL (DESIGN section 4b(4)). It was enrolled in
// `v2.workflow.floor_expected_red` while the duplicate was ACCEPTED and the LAST assignment won --
// measured at main 4b7371d1f64, `{ a: 1, a: 2, b: 3 }` answered 2. The wall landed in the one fold
// over a record literal's field list, `v1.compiler.parse` `parse_field_init_list_acc`, which refuses
// the repeated key naming the field and both positions; the enrolment was retired by that landing,
// and the pair stays enrolled as the evidence the wall still stands. The class is
// `gunbc.recurring_failure_mode.duplicate_record_literal_field_silently_last_wins`.
//
// WHY THE SUBJECT IS A SOURCE STRING RATHER THAN AN INLINE LITERAL, which is the only shape that
// works. Writing `{ a: 1, a: 2 }` directly in this module would compile and pass TODAY, and on the
// day the wall lands this FILE WOULD STOP PARSING -- so the probe would not flip red, it would break
// the corpus, and the wall would be unlandable over its own regression control. DESIGN section 4b
// answers this exactly: a state unrepresentable in the ACCEPTED corpus is still representable as
// SOURCE HANDED TO THE COMPILER BY A FIXTURE, and a compiler is precisely a thing whose regression
// probes are invalid programs. So the duplicate lives in a string, the corpus never contains it, and
// the assertion flips on the wall alone.
//
// THAT FAILURE MODE IS NOT HYPOTHETICAL AND MAIN IS SHOWING IT RIGHT NOW. At 4b7371d1f64 the FLOOR
// LANE REFUSES -- the whole phase, not one witness -- because
// `dag/test/claim/fleet/fleet_converge_launch_scope_non_interference.dag` writes
// `__launch_excess_field_probe` INLINE into a `LaunchEnvironmentConverge` literal. That probe was
// authored when the compiler ADMITTED an excess field. The field-set check has since reached it, and
// the probe did not flip red: it took the lane down, and it would have made its own wall unlandable.
// This file is the same probe written the other way.
//
// WHAT THE PAIR DISCRIMINATES. Both sources go through the real acceptance path and differ in
// EXACTLY one character position -- whether field `a` is named once or twice. Asserting
// `blocking >= 1` alone would be satisfied by any malformed source, so the red carries no
// information without the control: the control is what says a refusal is ABOUT THE REPEATED KEY and
// not about the fixture being unparseable for some unrelated reason. That is not hypothetical here.
// The first measurement of this class ran both arms and got IDENTICAL failures from a workspace-root
// path panic, which is the same observation a passing wall produces; the control is the only reason
// the verdict was ACCEPTED rather than a confident and wrong REFUSED.
//
// THE OTHER TWO DIRECTIONS ALREADY REFUSE, which is why this is a gap in a standing wall rather than
// a missing one. A field set can be wrong three ways: too few keys, an unknown key, the same key
// twice. `MissPair { a: 1 }` on a two-field type refuses with `missing required field 'b'`, located.
// An unknown key refuses too -- that is what main's floor lane is refusing on above. The duplicate is
// the only one of the three that is silent, and the code that must refuse it is already holding the
// field list when the repeated key arrives.

// NOT-RUNNABLE IS NOT ZERO. A census that could not run has observed nothing: it is
// CensusUnobserved, neither the control's zero nor the red's positive count, so a harness that stops
// working fails in BOTH directions instead of passing by silence.
fn blocking_parse_error_verdict(source: String, holds: fn(Int) -> Bool) -> ProcessExit {
  census_exit(census_verdict(census: blocking_class_census(source: source, wanted_class: "ParseError"), holds: holds))
}

data red_duplicate_field_source: String = "module probe_duplicate_record_field\ntype DupPair {\n  a: Int\n  b: Int\n}\nfn answers() -> Int {\n  let p = DupPair { a: 1, a: 2, b: 3 }\n  p.a\n}\n"

data green_each_field_once_source: String = "module probe_single_record_field\ntype DupPair {\n  a: Int\n  b: Int\n}\nfn answers() -> Int {\n  let p = DupPair { a: 1, b: 3 }\n  p.a\n}\n"

test fn a_record_literal_assigning_one_field_twice_refuses() -> ProcessExit {
  blocking_parse_error_verdict(source: red_duplicate_field_source, holds: fn(n) { n >= 1 })
}

// THE REFUSAL IS ABOUT THE REPEATED KEY AND NAMES BOTH POSITIONS. A ParseError count alone is
// satisfied by any malformed source; this reads the refusal's own subject, which for a parse error
// is its message, and requires the field name and the line:col of BOTH assignments -- line 7,
// columns 21 and 27 in the fixture above.
test fn the_refusal_names_the_field_and_both_positions() -> ProcessExit {
  census_exit(census_verdict(census: blocking_subject_census(source: red_duplicate_field_source, wanted_class: "ParseError", wanted_subject: "duplicate field 'a' in record literal: first at 7:21, again at 7:27"), holds: fn(n) { n == 1 }))
}

test fn the_same_literal_assigning_each_field_once_is_accepted() -> ProcessExit {
  blocking_parse_error_verdict(source: green_each_field_once_source, holds: fn(n) { n == 0 })
}
