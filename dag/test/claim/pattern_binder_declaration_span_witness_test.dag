module test.claim.pattern_binder_declaration_span_witness_test

import v1.compiler.compile { SourceFile, compile_to_resolved }
import v1.compiler.infer_items { TypedModule }
import v1.compiler.parse { parse_with_table }
import v1.compiler.tokenize { tokenize }
import v1.std.core {
  ExprData, MatchPattern, Node, VarBindingKind, arm_body, arm_pattern, build_newline_index,
  empty_intern_table, field_binding_pattern, match_arm_nodes, module_items, node_name_span
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn pattern_binder_source() -> String {
  "module pattern_spans\n\ntype Boxed { value: Int }\ntype Nest { value: Boxed }\n\nfn direct(x: Int) -> Int {\n  match x {\n    direct_bind => direct_bind\n  }\n}\n\nfn aliased(x: Boxed) -> Int {\n  match x {\n    Boxed { value: alias_bind } => alias_bind\n  }\n}\n\nfn shorthand(x: Boxed) -> Int {\n  match x {\n    Boxed { value } => value\n  }\n}\n\nfn nested(x: Nest) -> Int {\n  match x {\n    Nest { value: Boxed { value: nested_bind } } => nested_bind\n  }\n}\n".to_string()
}

fn typed_pattern_binder_source() -> String {
  "module typed_pattern_spans\n\ntype Duo = Left { value: Int } | Right { value: Int }\n\nfn separate_arms(x: Duo) -> Int {\n  match x {\n    Left { value: y } => y\n    Right { value: y } => y\n  }\n}\n".to_string()
}

fn source_index_from(haystack: String, needle: String, pos: Int) -> Int? {
  let needle_len = string_length(s: needle)
  let haystack_len = string_length(s: haystack)
  if needle_len == 0 {
    Present { value: pos }
  } else if pos + needle_len > haystack_len {
    none
  } else if substring(s: haystack, start: pos, end: pos + needle_len) == needle {
    Present { value: pos }
  } else {
    source_index_from(haystack: haystack, needle: needle, pos: pos + 1)
  }
}

fn source_index(haystack: String, needle: String) -> Int? {
  source_index_from(haystack: haystack, needle: needle, pos: 0)
}

fn item_body_named(module: Node, name: String) -> Node? {
  match module_items(n: module) |> filter(item => item.name == name) |> first() {
    Present { value: item } => item.body
    Absent => none
  }
}

fn typed_item_body_named(typed_module: TypedModule, name: String) -> Node? {
  match typed_module.items |> filter(item => item.name == name) |> first() {
    Present { value: item } => item.body
    Absent => none
  }
}

fn direct_binder_start(source: String) -> Int? {
  match source_index(haystack: source, needle: "direct_bind =>".to_string()) {
    Present { value: start } => Present { value: start }
    Absent => none
  }
}

fn alias_binder_start(source: String) -> Int? {
  match source_index(haystack: source, needle: "value: alias_bind".to_string()) {
    Present { value: start } => Present { value: start + string_length(s: "value: ") }
    Absent => none
  }
}

fn shorthand_binder_start(source: String) -> Int? {
  match source_index(haystack: source, needle: "Boxed { value }".to_string()) {
    Present { value: start } => Present { value: start + string_length(s: "Boxed { ") }
    Absent => none
  }
}

fn nested_binder_start(source: String) -> Int? {
  match source_index(
    haystack: source,
    needle: "value: Boxed { value: nested_bind }".to_string()
  ) {
    Present { value: start } => Present { value: start + string_length(s: "value: Boxed { value: ") }
    Absent => none
  }
}

fn match_first_arm(body: Node) -> Node? {
  first(match_arm_nodes(texpr: body))
}

fn typed_resolved_module() -> TypedModule? {
  let source = typed_pattern_binder_source()
  let resolved = compile_to_resolved(
    sources: [SourceFile { path: "typed_pattern_spans.dag".to_string(), content: source }]
  )
  match resolved.graph {
    Present { value: graph } => first(graph.modules)
    Absent => none
  }
}

test fn parse_direct_bind_uses_binder_token_span() -> Bool {
  let source = pattern_binder_source()
  let file = "pattern_binder_spans.dag".to_string()
  let parsed = parse_with_table(
    tokens: tokenize(source: source, file: file.clone()),
    source_indices: map_insert(empty_map(), file, build_newline_index(file: file, source: source.clone())),
    intern_table: empty_intern_table()
  )
  match parsed.result.module {
    Present { value: module } =>
      match item_body_named(module: module, name: "direct".to_string()) {
        Present { value: body } =>
          match match_first_arm(body: body) {
            Present { value: arm } =>
              match arm_pattern(n: arm) {
                MatchPattern::Bind { declaration_span, .. } =>
                  match direct_binder_start(source: source) {
                    Present { value: expected } => declaration_span.start == expected
                    Absent => false
                  }
                _ => false
              }
            Absent => false
          }
        Absent => false
      }
    Absent => false
  }
}

test fn parse_explicit_alias_uses_binder_span_not_label_span() -> Bool {
  let source = pattern_binder_source()
  let file = "pattern_binder_spans.dag".to_string()
  let parsed = parse_with_table(
    tokens: tokenize(source: source, file: file.clone()),
    source_indices: map_insert(empty_map(), file, build_newline_index(file: file, source: source.clone())),
    intern_table: empty_intern_table()
  )
  match parsed.result.module {
    Present { value: module } =>
      match item_body_named(module: module, name: "aliased".to_string()) {
        Present { value: body } =>
          match match_first_arm(body: body) {
            Present { value: arm } =>
              match arm_pattern(n: arm) {
                MatchPattern::VariantPattern { field_bindings, .. } =>
                  match first(field_bindings) {
                    Present { value: field_binding } =>
                      match field_binding_pattern(n: field_binding) {
                        MatchPattern::Bind { declaration_span, .. } =>
                          match alias_binder_start(source: source) {
                            Present { value: expected } =>
                              declaration_span.start == expected
                                && declaration_span.start != node_name_span(n: field_binding).start
                            Absent => false
                          }
                        _ => false
                      }
                    Absent => false
                  }
                _ => false
              }
            Absent => false
          }
        Absent => false
      }
    Absent => false
  }
}

test fn parse_shorthand_uses_field_label_span() -> Bool {
  let source = pattern_binder_source()
  let file = "pattern_binder_spans.dag".to_string()
  let parsed = parse_with_table(
    tokens: tokenize(source: source, file: file.clone()),
    source_indices: map_insert(empty_map(), file, build_newline_index(file: file, source: source.clone())),
    intern_table: empty_intern_table()
  )
  match parsed.result.module {
    Present { value: module } =>
      match item_body_named(module: module, name: "shorthand".to_string()) {
        Present { value: body } =>
          match match_first_arm(body: body) {
            Present { value: arm } =>
              match arm_pattern(n: arm) {
                MatchPattern::VariantPattern { field_bindings, .. } =>
                  match first(field_bindings) {
                    Present { value: field_binding } =>
                      match field_binding_pattern(n: field_binding) {
                        MatchPattern::Bind { declaration_span, .. } =>
                          declaration_span.start == node_name_span(n: field_binding).start
                        _ => false
                      }
                    Absent => false
                  }
                _ => false
              }
            Absent => false
          }
        Absent => false
      }
    Absent => false
  }
}

test fn parse_nested_bind_uses_innermost_binder_span() -> Bool {
  let source = pattern_binder_source()
  let file = "pattern_binder_spans.dag".to_string()
  let parsed = parse_with_table(
    tokens: tokenize(source: source, file: file.clone()),
    source_indices: map_insert(empty_map(), file, build_newline_index(file: file, source: source.clone())),
    intern_table: empty_intern_table()
  )
  match parsed.result.module {
    Present { value: module } =>
      match item_body_named(module: module, name: "nested".to_string()) {
        Present { value: body } =>
          match match_first_arm(body: body) {
            Present { value: arm } =>
              match arm_pattern(n: arm) {
                MatchPattern::VariantPattern { field_bindings, .. } =>
                  match first(field_bindings) {
                    Present { value: outer_field_binding } =>
                      match field_binding_pattern(n: outer_field_binding) {
                        MatchPattern::VariantPattern { field_bindings: inner_field_bindings, .. } =>
                          match first(inner_field_bindings) {
                            Present { value: inner_field_binding } =>
                              match field_binding_pattern(n: inner_field_binding) {
                                MatchPattern::Bind { declaration_span, .. } =>
                                  match nested_binder_start(source: source) {
                                    Present { value: expected } => declaration_span.start == expected
                                    Absent => false
                                  }
                                _ => false
                              }
                            Absent => false
                          }
                        _ => false
                      }
                    Absent => false
                  }
                _ => false
              }
            Absent => false
          }
        Absent => false
      }
    Absent => false
  }
}

fn typed_match_bound_binding_span_from_arm(arm: Node) -> Int {
  match arm_pattern(n: arm) {
    MatchPattern::VariantPattern { field_bindings, .. } =>
      match first(field_bindings) {
        Present { value: field_binding } =>
          match field_binding_pattern(n: field_binding) {
            MatchPattern::Bind { declaration_span, .. } => declaration_span.start
            _ => -1
          }
        Absent => -1
      }
    _ => -1
  }
}

fn typed_expr_var_binding_span(expr: Node) -> Int {
  match expr.expr_data {
    ExprData::ExprVar { binding_kind } =>
      match binding_kind {
        Present { value: VarBindingKind::MatchBoundBinding { declaration_span } } => declaration_span.start
        _ => -1
      }
    _ => -1
  }
}

test fn typed_separate_arms_carry_each_own_binding_span() -> Bool {
  let source = typed_pattern_binder_source()
  match typed_resolved_module() {
    Present { value: typed_module } =>
      match typed_item_body_named(typed_module: typed_module, name: "separate_arms".to_string()) {
        Present { value: body } =>
          let arms = match_arm_nodes(texpr: body)
          let expected = arms |> map(arm => typed_match_bound_binding_span_from_arm(arm: arm))
          let expr_spans = arms |> map(arm => typed_expr_var_binding_span(expr: arm_body(n: arm)))
          match first(expected) {
            Present { value: expected_left } =>
              match last(expected) {
                Present { value: expected_right } =>
                  match first(expr_spans) {
                    Present { value: expr_left } =>
                      match last(expr_spans) {
                        Present { value: expr_right } =>
                          expected_left != -1
                            && expected_right != -1
                            && expr_left == expected_left
                            && expr_right == expected_right
                            && expected_left != expected_right
                        Absent => false
                      }
                    Absent => false
                  }
                Absent => false
              }
            Absent => false
          }
        Absent => false
      }
    Absent => false
  }
}
