module test.claim.pattern_binder_declaration_span_witness_test

import v1.compiler.compile { SourceFile, compile_to_resolved }
import v1.compiler.parse { parse_with_table }
import v1.compiler.tokenize { tokenize }
import v1.std.core {
  ExprData, MatchPattern, NewlineIndex, VarBindingKind, arm_body, arm_pattern, build_newline_index,
  empty_intern_table, field_binding_pattern, match_arm_nodes, module_items, node_name_span
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn pattern_binder_source() -> String {
  "module pattern_spans\n\ntype Boxed { value: Int }\ntype Nest { value: Boxed }\n\na fn direct(x: Int) -> Int {\n  match x {\n    direct_bind => direct_bind\n  }\n}\n\nfn aliased(x: Boxed) -> Int {\n  match x {\n    Boxed { value: alias_bind } => alias_bind\n  }\n}\n\nfn shorthand(x: Boxed) -> Int {\n  match x {\n    Boxed { value } => value\n  }\n}\n\nfn nested(x: Nest) -> Int {\n  match x {\n    Nest { value: Boxed { value: nested_bind } } => nested_bind\n  }\n}\n".to_string()
}

fn typed_pattern_binder_source() -> String {
  "module typed_pattern_spans\n\ntype Duo = Left { value: Int } | Right { value: Int }\n\nfn separate_arms(x: Duo) -> Int {\n  match x {\n    Left { value: y } => y\n    Right { value: y } => y\n  }\n}\n".to_string()
}

fn source_index_from(haystack: String, needle: String, pos: Int) -> Int? {
  let needle_len = string_length(s: needle)
  let haystack_len = string_length(s: haystack)
  if needle_len == 0 {
    Present { value: pos }
  } else if pos + needle_len > haystack_len {
    none
  } else if substring(s: haystack, start: pos, end: pos + needle_len) == needle {
    Present { value: pos }
  } else {
    source_index_from(haystack: haystack, needle: needle, pos: pos + 1)
  }
}

fn source_index(haystack: String, needle: String) -> Int? {
  source_index_from(haystack: haystack, needle: needle, pos: 0)
}

fn item_named(items: List<Node>, name: String) -> Node? {
  fold(items, init: none, f: fn(acc, item) {
    match acc {
      Present { value: found } => Present { value: found }
      Absent =>
        if item.name == name {
          Present { value: item }
        } else {
          none
        }
    }
  })
}

fn item_body_named(module: Node, name: String) -> Node? {
  match item_named(items: module_items(n: module), name: name) {
    Present { value: item } => item.body
    Absent => none
  }
}

fn direct_binder_start(source: String) -> Int? {
  match source_index(haystack: source, needle: "direct_bind =>".to_string()) {
    Present { value: start } => Present { value: start }
    Absent => none
  }
}

fn alias_binder_start(source: String) -> Int? {
  match source_index(haystack: source, needle: "value: alias_bind".to_string()) {
    Present { value: start } => Present { value: start + string_length(s: "value: ") }
    Absent => none
  }
}

fn shorthand_binder_start(source: String) -> Int? {
  match source_index(haystack: source, needle: "Boxed { value }".to_string()) {
    Present { value: start } => Present { value: start + string_length(s: "Boxed { ") }
    Absent => none
  }
}

fn nested_binder_start(source: String) -> Int? {
  match source_index(
    haystack: source,
    needle: "value: Boxed { value: nested_bind }".to_string()
  ) {
    Present { value: start } => Present { value: start + string_length(s: "value: Boxed { value: ") }
    Absent => none
  }
}

test fn parse_match_binder_declaration_spans_are_exact() -> Bool {
  let source = pattern_binder_source()
  let parsed = parse_with_table(
    tokens: tokenize(source: source, file: "pattern_binder_spans.dag".to_string()),
    source_indices: {
      let si = build_newline_index(file: "pattern_binder_spans.dag".to_string(), source: source.clone())
      map_insert(empty_map(), si.file, si)
    },
    intern_table: empty_intern_table()
  )

  match parsed.result.module {
    Present { value: module } =>
      match (
        item_body_named(module: module.clone(), name: "direct".to_string()),
        item_body_named(module: module.clone(), name: "aliased".to_string()),
        item_body_named(module: module.clone(), name: "shorthand".to_string()),
        item_body_named(module: module.clone(), name: "nested".to_string())
      ) {
        (Present { value: direct_body }, Present { value: alias_body }, Present { value: shorthand_body }, Present { value: nested_body }) =>
          match (
            direct_binder_start(source: source.clone()),
            alias_binder_start(source: source.clone()),
            shorthand_binder_start(source: source.clone()),
            nested_binder_start(source: source.clone())
          ) {
            (Present { value: direct_start }, Present { value: alias_start }, Present { value: shorthand_start }, Present { value: nested_start }) =>
              match match_arm_nodes(direct_body).first() {
                Present { value: direct_arm } =>
                  match arm_pattern(direct_arm).as_ref() {
                    MatchPattern::Bind { declaration_span, .. } =>
                      match match_arm_nodes(alias_body).first() {
                        Present { value: alias_arm } =>
                          match arm_pattern(alias_arm).as_ref() {
                            MatchPattern::VariantPattern { field_bindings, .. } =>
                              match field_bindings.first() {
                                Present { value: alias_field_binding } =>
                                  match field_binding_pattern(alias_field_binding).as_ref() {
                                    MatchPattern::Bind { declaration_span: alias_decl, .. } =>
                                      match match_arm_nodes(shorthand_body).first() {
                                        Present { value: shorthand_arm } =>
                                          match arm_pattern(shorthand_arm).as_ref() {
                                            MatchPattern::VariantPattern { field_bindings: shorthand_fields, .. } =>
                                              match shorthand_fields.first() {
                                                Present { value: shorthand_field_binding } =>
                                                  match field_binding_pattern(shorthand_field_binding).as_ref() {
                                                    MatchPattern::Bind { declaration_span: shorthand_decl, .. } =>
                                                      match match_arm_nodes(nested_body).first() {
                                                        Present { value: nested_arm } =>
                                                          match arm_pattern(nested_arm).as_ref() {
                                                            MatchPattern::VariantPattern { field_bindings: outer_nested_fields, .. } =>
                                                              match outer_nested_fields.first() {
                                                                Present { value: outer_nested_field_binding } =>
                                                                  match field_binding_pattern(outer_nested_field_binding).as_ref() {
                                                                    MatchPattern::VariantPattern { field_bindings: inner_nested_fields, .. } =>
                                                                      match inner_nested_fields.first() {
                                                                        Present { value: inner_nested_field_binding } =>
                                                                          match field_binding_pattern(inner_nested_field_binding).as_ref() {
                                                                            MatchPattern::Bind { declaration_span: nested_decl, .. } =>
                                                                              declaration_span.start == direct_start
                                                                                && alias_decl.start == alias_start
                                                                                && alias_decl.start != node_name_span(n: alias_field_binding.clone()).start
                                                                                && shorthand_decl.start == shorthand_start
                                                                                && shorthand_decl.start == node_name_span(n: shorthand_field_binding.clone()).start
                                                                                && nested_decl.start == nested_start
                                                                            _ => false
                                                                          }
                                                                        _ => false
                                                                      }
                                                                    _ => false
                                                                  }
                                                                _ => false
                                                              }
                                                            _ => false
                                                          }
                                                        _ => false
                                                      }
                                                    _ => false
                                                  }
                                                _ => false
                                              }
                                            _ => false
                                          }
                                        _ => false
                                      }
                                    _ => false
                                  }
                                _ => false
                              }
                            _ => false
                          }
                        _ => false
                      }
                    _ => false
                  }
                _ => false
              }
            _ => false
          }
        _ => false
      }
    Absent => false
  }
}

fn typed_match_bound_binding_spans_use_each_arm_declaration() -> Bool {
  let source = typed_pattern_binder_source()
  let resolved = compile_to_resolved(
    sources: [SourceFile { path: "typed_pattern_spans.dag".to_string(), content: source.clone() }]
  )

  match resolved.graph {
    Present { value: graph } =>
      match graph.modules.first() {
        Present { value: typed_module } =>
          match item_body_named(module: typed_module.module.clone(), name: "separate_arms".to_string()) {
            Present { value: separate_body } =>
              match (
                source_index(haystack: source.clone(), needle: "value: y".to_string()),
                source_index_from(haystack: source.clone(), needle: "Right { value: y }".to_string(), pos: 0)
              ) {
                (Present { value: left_value_start }, Present { value: right_value_start }) =>
                  let arms = match_arm_nodes(separate_body.clone())
                  let expr_vars = arms |> map(arm => arm_body(arm))
                  let expected = arms |> map(arm =>
                    match arm_pattern(arm).as_ref() {
                      MatchPattern::VariantPattern { field_bindings, .. } =>
                        match field_bindings.first() {
                          Present { value: binding } =>
                            match field_binding_pattern(binding).as_ref() {
                              MatchPattern::Bind { declaration_span, .. } => declaration_span.start
                              _ => -1
                            }
                          _ => -1
                        }
                      _ => -1
                    }
                  )
                  (count(expected) == 2)
                    && (first(expected).value != last(expected).value)
                    && (count(expr_vars) == 2)
                    && match expr_vars.first() {
                      Present { value: expr_var_0 } =>
                        match expr_var_0.expr_data.as_ref() {
                          ExprData::ExprVar { binding_kind } =>
                            match binding_kind {
                              Present { value: VarBindingKind::MatchBoundBinding { declaration_span } } =>
                                declaration_span.start == first(expected).value
                              _ => false
                            }
                          _ => false
                        }
                      _ => false
                    }
                    && match expr_vars.last() {
                      Present { value: expr_var_1 } =>
                        match expr_var_1.expr_data.as_ref() {
                          ExprData::ExprVar { binding_kind } =>
                            match binding_kind {
                              Present { value: VarBindingKind::MatchBoundBinding { declaration_span } } =>
                                declaration_span.start == last(expected).value
                                  && declaration_span.start != left_value_start
                                  && declaration_span.start == right_value_start + string_length(s: "Right { value: ") - string_length(s: "y }")
                              _ => false
                            }
                          _ => false
                        }
                      _ => false
                    }
                _ => false
              }
            Absent => false
          }
        _ => false
      }
    Absent => false
  }
}
