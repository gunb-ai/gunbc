module test.claim.busybox_argv_builders

import std.logic { Bool }
import std.types { String, List }
import extdeps.exec.command {
  curl_download_command,
  mkdir_p_command,
  tar_extract_command,
  make_command,
  sed_in_place_command,
  cp_command,
}

test fn busybox_argv_builders_derive_expected() -> Bool {
  curl_download_command(url: "URL", destination: "DEST").argv == ["curl", "-fsL", "-o", "DEST", "URL"]
    && mkdir_p_command(directory: "D").argv == ["mkdir", "-p", "D"]
    && tar_extract_command(archive: "A", into_directory: "D", strip_components: 1).argv == ["tar", "xf", "A", "-C", "D", "--strip-components=1"]
    && make_command(directory: "D", arguments: ["ARCH=arm", "defconfig"]).argv == ["make", "-C", "D", "ARCH=arm", "defconfig"]
    && sed_in_place_command(expression: "E", path: "P").argv == ["sed", "-i", "E", "P"]
    && cp_command(source: "S", destination: "T").argv == ["cp", "S", "T"]
}

test fn busybox_argv_builders_red_control() -> Bool {
  mkdir_p_command(directory: "D").argv != ["mkdir", "D"]
    && tar_extract_command(archive: "A", into_directory: "D", strip_components: 2).argv != ["tar", "xf", "A", "-C", "D", "--strip-components=1"]
    && curl_download_command(url: "U", destination: "V").argv != ["curl", "-o", "V", "U"]
}
