module test.claim.scm_object_store_witness

// Slice 1 of NATIVE-COMMIT-0 (docs/plans/dag-native-scm-design.md §7): a commit is a root object id
// plus the closure reachable from it, and checking one out either reconstructs the exact program or
// refuses with a located missing object. Nothing here merges yet.
//
// Every claim below is paired with its discriminating control, written as a NEGATED assertion so a
// vacuous implementation reds rather than passing quietly: a checkout that fabricated a program
// would pass round_trip_holds, and a refusal that fired unconditionally would pass the two refusal
// claims. The controls are what make those two impossible.

import std.types { String, Bool, List, Int, NonEmptyStr }
import std.occurrence_identity { OccurrenceId }

import v2.std.node {
  Node,
  NodeKind,
  TypeNode,
  Connective,
  Atom,
  Conj,
  Edge,
  EdgeLabel,
  Named,
  Symbol,
  Connective,
  ComputationNode,
  node_synthetic,
  node_with_occurrence_id,
  node_occurrence_minted,
  content_hash,
  symbol_identity_digest,
  canonicalize_node_for_content_hash,
}

import gunbc.scm.object_store {
  ObjectId,
  ObjectRecord,
  StoredEdge,
  ObjectStore,
  ObjectRecord,
  find_object,
  copy_object,
  empty_store,
  store_node,
  object_id_eq,
  StoreResult,
}
import gunbc.scm.checkout {
  Commit,
  CheckoutRefusal,
  MissingObject,
  commit_of_root,
  checkout,
  CheckedOut,
  CheckoutRefused,
}

fn atom_node(identity: Symbol) -> Node {
  node_synthetic(kind: TypeNode { connective: Atom { identity: identity } }, children: [])
}

fn named_edge(name: Symbol, target: Node) -> Edge {
  Edge { label: Named { name: name }, target: target }
}

fn program_a() -> Node {
  node_synthetic(
    kind: TypeNode { connective: Conj },
    children: [named_edge(name: ^left, target: atom_node(identity: ^L))],
  )
}

fn program_ab() -> Node {
  node_synthetic(
    kind: TypeNode { connective: Conj },
    children: [
      named_edge(name: ^left, target: atom_node(identity: ^L)),
      named_edge(name: ^right, target: atom_node(identity: ^R)),
    ],
  )
}

// The same program rebuilt with MINTED occurrence ids instead of synthetic ones. Occurrence ids are
// graph-scoped allocator output (std.occurrence_identity occurrence_identity_scope_law), so two
// independent parses of one authored program get DIFFERENT ids for the same construct. If object
// identity were sensitive to them, no commit could ever be recognised as one already stored.
fn minted_atom_node(identity: Symbol, id: Int) -> Node {
  node_with_occurrence_id(
    kind: TypeNode { connective: Atom { identity: identity } },
    children: [],
    occurrence_id: node_occurrence_minted(id: OccurrenceId { value: id }),
  )
}

fn minted_program_ab(base: Int) -> Node {
  node_with_occurrence_id(
    kind: TypeNode { connective: Conj },
    children: [
      named_edge(name: ^left, target: minted_atom_node(identity: ^L, id: base + 1)),
      named_edge(name: ^right, target: minted_atom_node(identity: ^R, id: base + 2)),
    ],
    occurrence_id: node_occurrence_minted(id: OccurrenceId { value: base }),
  )
}

// AN ORACLE INDEPENDENT OF THE SUBJECT UNDER TEST. This used to compare content_hash(got) against
// content_hash(expected) -- but content_hash is exactly what the store keys on, so a wrong record
// sharing an identity passed the round-trip claim BY DEFINITION rather than by reconstructing
// anything. The comparison below walks both programs structurally and never hashes a node: the
// digest may remain the subject, but it cannot also be the judge.
fn render_symbol(sym: Symbol) -> String {
  symbol_identity_digest(sym: sym).digest as String
}

fn render_kind(kind: NodeKind) -> String {
  match kind {
    TypeNode { connective: c } =>
      match c {
        Atom { identity: a } => concat("atom:", render_symbol(sym: a))
        Conj => "conj"
        Disj => "disj"
        Arrow => "arrow"
        Cardinality => "cardinality"
        Instantiation => "instantiation"
      }
    ComputationNode { behavior: _ } => "computation"
  }
}

fn render_label(label: EdgeLabel) -> String {
  match label {
    Named { name: n } => concat("named:", render_symbol(sym: n))
    Positional => "positional"
  }
}

fn render_node(n: Node) -> String {
  concat(
    concat("(", render_kind(kind: n.kind)),
    concat(
      fold(n.children, init: "", f: fn(acc, e) {
        concat(acc, concat(concat("[", render_label(label: e.label)), concat(render_node(n: e.target), "]")))
      }),
      ")",
    ),
  )
}

fn structurally_same(left: Node, right: Node) -> Bool {
  render_node(n: left) == render_node(n: right)
}

// CHECKOUT RETURNS THE CANONICAL PROGRAM, so the expectation is canonicalized too. This is not the
// oracle quietly adopting the subject: canonicalization is a Node-to-Node normalization, and the
// comparison below still walks structure without hashing anything. What it concedes -- honestly --
// is that named-edge order is not a fact a commit preserves, because it is not a fact the
// substrate's identity preserves either.
fn checkout_matches(store: ObjectStore, commit: Commit, expected: Node) -> Bool {
  match checkout(store: store, commit: commit) {
    CheckoutRefused { cause: _ } => false
    CheckedOut { program: got } =>
      structurally_same(left: got, right: canonicalize_node_for_content_hash(n: expected))
  }
}

// The refusal must NAME the absent object, not merely occur. A refusal that is typed but not
// located leaves the caller to rediscover what was missing, and the PR claims located refusal.
fn refusal_names(store: ObjectStore, commit: Commit, expected: ObjectId) -> Bool {
  match checkout(store: store, commit: commit) {
    CheckedOut { program: _ } => false
    CheckoutRefused { cause: cause } =>
      match cause {
        MissingObject { identity: identity } => object_id_eq(left: identity, right: expected)
      }
  }
}

fn checkout_refuses(store: ObjectStore, commit: Commit) -> Bool {
  match checkout(store: store, commit: commit) {
    CheckoutRefused { cause: _ } => true
    CheckedOut { program: _ } => false
  }
}

// A store holding the root record and none of its children. Used to reach the refusal through the
// recursive descent rather than at the entry lookup. It is built by GRAFTING the root out of a
// complete store, which is the only way a record enters a store other than being derived -- so this
// fixture can be incomplete but cannot be dishonest.
fn store_of_root_only(full: ObjectStore, root: ObjectId) -> ObjectStore {
  copy_object(from: full, to: empty_store(), identity: root)
}

// CRITERION 2 -- a commit reconstructs its exact program from its own closure.
test fn round_trip_reconstructs_the_exact_program() -> Bool {
  let stored = store_node(store: empty_store(), n: program_ab())
  checkout_matches(
    store: stored.store,
    commit: commit_of_root(root: stored.identity),
    expected: program_ab(),
  )
}

// CONTROL for the claim above: checkout_matches must be able to say no.
test fn round_trip_refuses_a_wrong_expectation() -> Bool {
  let stored = store_node(store: empty_store(), n: program_ab())
  !checkout_matches(
    store: stored.store,
    commit: commit_of_root(root: stored.identity),
    expected: program_a(),
  )
}

// CRITERION 1 -- growing the store cannot change what an existing commit means.
test fn later_objects_do_not_change_an_existing_commit() -> Bool {
  let first = store_node(store: empty_store(), n: program_a())
  let grown = store_node(store: first.store, n: program_ab())
  checkout_matches(
    store: grown.store,
    commit: commit_of_root(root: first.identity),
    expected: program_a(),
  )
}

// An incomplete closure refuses rather than substituting, at the entry lookup.
test fn absent_root_refuses() -> Bool {
  let stored = store_node(store: empty_store(), n: program_ab())
  checkout_refuses(
    store: empty_store(),
    commit: commit_of_root(root: stored.identity),
  )
}

// The STRONGER missing-object case: the root IS present and its children are not, so the refusal
// has to come from the recursive descent, not from a guard on the entry point.
test fn missing_reachable_child_refuses() -> Bool {
  let stored = store_node(store: empty_store(), n: program_ab())
  let severed = store_of_root_only(full: stored.store, root: stored.identity)
  checkout_refuses(
    store: severed,
    commit: commit_of_root(root: stored.identity),
  )
}

// The severed store's refusal names the CHILD that is gone, not the root it still holds. This is
// what distinguishes a located refusal from a refusal that merely echoes what was asked for.
test fn the_refusal_names_the_missing_child_not_the_root() -> Bool {
  let stored = store_node(store: empty_store(), n: program_ab())
  let severed = store_of_root_only(full: stored.store, root: stored.identity)
  let left_child = store_node(store: empty_store(), n: atom_node(identity: ^L))
  refusal_names(
    store: severed,
    commit: commit_of_root(root: stored.identity),
    expected: left_child.identity,
  ) && !object_id_eq(left: left_child.identity, right: stored.identity)
}

// CONTROL for the case above: the severed store is not merely empty. If it were, the claim would be
// a restatement of absent_root_refuses rather than a statement about a missing child.
test fn severed_store_still_holds_its_root() -> Bool {
  let stored = store_node(store: empty_store(), n: program_ab())
  let severed = store_of_root_only(full: stored.store, root: stored.identity)
  length(severed.objects) == 1
}

// CONTROL for both refusal claims: refusal is not unconditional.
test fn a_complete_closure_does_not_refuse() -> Bool {
  let stored = store_node(store: empty_store(), n: program_ab())
  !checkout_refuses(
    store: stored.store,
    commit: commit_of_root(root: stored.identity),
  )
}

// ONE IDENTITY, ONE RECORD -- the ambiguity review found and the author first dismissed.
//
// content_hash is a QUOTIENT: it identifies a node up to a deliberate equivalence relation, erasing
// occurrence provenance and named-edge order alike. That is the substrate's intended semantics, not
// a hazard, and this witness does not reopen it. The defect was one layer up: the key identified the
// canonical equivalence CLASS while the payload stored an arbitrary FIRST-OBSERVED REPRESENTATIVE of
// that class. So the commit identity stayed a perfectly valid class identity, and what broke was
// that reconstruction became insertion-history dependent -- store one program, check out a different
// child order, depending on what some earlier caller happened to write first.
fn alpha_first() -> Node {
  node_synthetic(
    kind: TypeNode { connective: Conj },
    children: [
      named_edge(name: ^alpha, target: atom_node(identity: ^A)),
      named_edge(name: ^beta, target: atom_node(identity: ^B)),
    ],
  )
}

fn beta_first() -> Node {
  node_synthetic(
    kind: TypeNode { connective: Conj },
    children: [
      named_edge(name: ^beta, target: atom_node(identity: ^B)),
      named_edge(name: ^alpha, target: atom_node(identity: ^A)),
    ],
  )
}

test fn reordered_named_children_share_one_identity() -> Bool {
  object_id_eq(left: content_hash(n: alpha_first()), right: content_hash(n: beta_first()))
}

// A record rendered as its canonical edge sequence: labels and child identities in stored order.
// Comparing RECORDS rather than counting them is what makes the next claim discriminating -- an
// object count of one was already true under the defect, because dedup was keyed on identity and
// the identity was never in question.
fn render_record(store: ObjectStore, identity: ObjectId) -> String {
  match find_object(store: store, identity: identity) {
    Absent => "absent"
    Present { value: record } =>
      fold(record.children, init: "", f: fn(acc, stored) {
        concat(acc, concat(render_label(label: stored.label), stored.target.digest as String))
      })
  }
}

// THE DISCRIMINATING CLAIM. Both insertion histories must yield the SAME stored record, not merely
// the same number of them. Under the defect this was false: the payload was whichever order arrived
// first, so these two renderings differed while every count and every identity agreed.
test fn both_insertion_orders_produce_the_same_canonical_record() -> Bool {
  let a_then_b = store_node(store: store_node(store: empty_store(), n: alpha_first()).store, n: beta_first())
  let b_then_a = store_node(store: store_node(store: empty_store(), n: beta_first()).store, n: alpha_first())
  render_record(store: a_then_b.store, identity: a_then_b.identity)
    == render_record(store: b_then_a.store, identity: b_then_a.identity)
}

// CONTROL for the claim above: the rendering is not vacuously equal for everything, and in
// particular an absent record does not read as equal to a present one.
test fn the_record_rendering_discriminates() -> Bool {
  let stored = store_node(store: empty_store(), n: alpha_first())
  render_record(store: stored.store, identity: stored.identity)
    != render_record(store: empty_store(), identity: stored.identity)
}

// The store holds ONE record for that one identity, whichever order arrived first.
test fn storing_both_orders_adds_one_object_in_either_write_order() -> Bool {
  let a_then_b = store_node(store: store_node(store: empty_store(), n: alpha_first()).store, n: beta_first())
  let b_then_a = store_node(store: store_node(store: empty_store(), n: beta_first()).store, n: alpha_first())
  length(a_then_b.store.objects) == length(store_node(store: empty_store(), n: alpha_first()).store.objects)
    && length(b_then_a.store.objects) == length(a_then_b.store.objects)
}

// And checking that identity out gives the SAME program regardless of which order was written
// first. This is the claim the old store failed: it returned whichever order happened to be stored.
test fn checkout_is_independent_of_which_order_was_written_first() -> Bool {
  let a_then_b = store_node(store: store_node(store: empty_store(), n: alpha_first()).store, n: beta_first())
  let b_then_a = store_node(store: store_node(store: empty_store(), n: beta_first()).store, n: alpha_first())
  match checkout(store: a_then_b.store, commit: commit_of_root(root: a_then_b.identity)) {
    CheckoutRefused { cause: _ } => false
    CheckedOut { program: first } =>
      match checkout(store: b_then_a.store, commit: commit_of_root(root: b_then_a.identity)) {
        CheckoutRefused { cause: _ } => false
        CheckedOut { program: second } => structurally_same(left: first, right: second)
      }
  }
}

// CONTROL: the two orders are genuinely different authored values, so the three claims above are
// about canonicalization rather than about comparing a program with itself.
test fn the_two_orders_are_different_as_authored() -> Bool {
  !structurally_same(left: alpha_first(), right: beta_first())
}

// CRITERION 3, first half -- identical content stores identically no matter how it was built. Both
// programs are constructed independently, so nothing correlates their nodes.
test fn independently_built_equal_programs_share_one_identity() -> Bool {
  let one = store_node(store: empty_store(), n: program_ab())
  let two = store_node(store: empty_store(), n: program_ab())
  object_id_eq(left: one.identity, right: two.identity)
}

// CRITERION 3, second half -- and the gap the first half leaves open. If every node carried the same
// SyntheticOccurrence, equal identities would be consistent with an identity that reads the
// occurrence id and merely finds it equal. These are the same program under three DIFFERENT
// occurrence allocations, and all three must land on one object identity.
test fn identity_survives_reminted_occurrences() -> Bool {
  let synthetic = store_node(store: empty_store(), n: program_ab())
  let minted_low = store_node(store: empty_store(), n: minted_program_ab(base: 10))
  let minted_high = store_node(store: empty_store(), n: minted_program_ab(base: 900))
  object_id_eq(left: synthetic.identity, right: minted_low.identity)
    && object_id_eq(left: minted_low.identity, right: minted_high.identity)
}

// CONTROL for the remint claim: the two bases really do allocate different occurrence ids, so the
// claim above is about insensitivity rather than about two identical inputs.
test fn reminted_programs_carry_different_occurrences() -> Bool {
  minted_program_ab(base: 10).occurrence_id != minted_program_ab(base: 900).occurrence_id
}

// CONTROL for identity itself: object_id_eq is not degenerate.
test fn different_programs_get_different_identities() -> Bool {
  let one = store_node(store: empty_store(), n: program_a())
  let two = store_node(store: empty_store(), n: program_ab())
  !object_id_eq(left: one.identity, right: two.identity)
}

// Storing the same program twice adds nothing: content addressing makes writes idempotent.
test fn restoring_one_program_adds_no_objects() -> Bool {
  let one = store_node(store: empty_store(), n: program_ab())
  let twice = store_node(store: one.store, n: program_ab())
  length(one.store.objects) == length(twice.store.objects)
}
