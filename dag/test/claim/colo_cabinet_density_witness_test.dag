module test.claim.colo_cabinet_density_witness

import std.types { Bool, Int }
import std.algebra { FreeSemigroup }
import std.measure { Watt, watt, watt_count, volt_ampere }
import v2.std.optional { Present, Absent }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import extdeps.colo.types {
  CabinetDensityClaim, DensityPublished, PublishedDensityFigure, DensityUnread,
  CoolingMediumStanding, AirCoolingPublished, LiquidCoolingPublished, CoolingMediumUnspecified,
  CabinetPowerFigure, PublishedRealPower, PublishedApparentPower,
  PublishedPowerQuantity, MarketedAtMost, CapabilityAtLeast, PublishedAverage,
  MarketedRealInterval, MarketedApparentInterval,
  FigureVerificationStanding, WordingVerbatim,
  DensityFigureLookup, FigureFound, FigureAbsent, FigureDuplicated, density_figure_for_medium,
  DensityScreen, ScreenHolds, ScreenUndetermined, ScreenNeedsEvidence,
  density_wording_covers, density_ceiling_refuses, density_claim_contains_figure,
  figure_wording_is_verified, density_claim_wording_is_verified,
  density_claim_figures, figure_is_unspecified,
  quantity_ceiling,
  CabinetPowerCeiling, CeilingAt, ceiling_refuses,
  RetailGrainStanding, SingleCabinetOffered, CageOrSuiteMinimum, RetailGrainUnread,
}
import extdeps.colo.databank { databank_lga4_density, databank_lga4_retail_grain }
import extdeps.colo.iron_mountain {
  iron_mountain_nje1_density, iron_mountain_wpa1_density, iron_mountain_nje1_retail_grain,
}
import gunbc.colo_census_coverage {
  RegionCoverage, RegionSurveyOutcome, FacilitiesModelled, SurveyedNoRetailOperator, RegionUnsurveyed,
  coverage_facility_count,
  nj_hudson_bergen_essex_corridor, southern_new_jersey, hudson_valley, census_regions,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE CARRIER'S CONSUMER. Review 62722 found the first cut of this module dangling: a type, two
// functions and six data rows that nothing read, with the controls living only in a scratch probe
// the author ran and deleted. A probe that is deleted is not evidence the wall stays standing -
// DESIGN section 3c is explicit that a declaration nobody consumes is red regardless of how well
// it is modelled, and section 5 that a run nobody can repeat is not a consumer. These are those
// controls, enrolled.

// A CEILING IS ASKED WHETHER IT REFUSES A REQUIREMENT; IT IS NEVER ASKED WHAT THE CABINET SUPPLIES.
// These two helpers are the whole surface the witnesses use, and neither yields a Watt - which is
// the point of review 62791's fix: a bound handed to something wanting a reading is now ill-typed
// rather than defended by a comment.
// EVERY HELPER TAKES THE MEDIUM, AND THAT IS THE SAME FINDING AS THE CARRIER'S ONE LEVEL DOWN. The
// first cut of this module wrote `ceiling_refuses_at`, `admits_at` and `has_ceiling` with air baked
// into their bodies, mirroring the carrier's air-only accessors - so when the carrier generalised,
// the tests would have kept exercising exactly one coordinate and the liquid path would have had no
// executing evidence at all. A test helper that hard-codes the parameter under test measures the
// helper.
//
// THE THREE-STATE SCREEN IS FLATTENED TO Bool HERE DELIBERATELY AND ONLY HERE. ScreenNeedsEvidence
// reads as false in both directions - a contested claim neither covers nor refuses - which is the
// correct reading for every witness below EXCEPT the duplication one, which asks for the arm itself
// through `needs_evidence` rather than through these. Flattening in the carrier is what the review
// found; flattening in a caller that has just been shown the arm is a caller's choice.
fn refuses_at(d: CabinetDensityClaim, requested: CoolingMediumStanding, required: Int) -> Bool {
  match density_ceiling_refuses(d: d, requested: requested, required: watt(count: required)) {
    ScreenHolds => true,
    ScreenUndetermined => false,
    ScreenNeedsEvidence { contested_medium } => false,
  }
}

fn covers_at(d: CabinetDensityClaim, requested: CoolingMediumStanding, required: Int) -> Bool {
  match density_wording_covers(d: d, requested: requested, required: watt(count: required)) {
    ScreenHolds => true,
    ScreenUndetermined => false,
    ScreenNeedsEvidence { contested_medium } => false,
  }
}

fn needs_evidence(d: CabinetDensityClaim, requested: CoolingMediumStanding, required: Int) -> Bool {
  match density_wording_covers(d: d, requested: requested, required: watt(count: required)) {
    ScreenHolds => false,
    ScreenUndetermined => false,
    ScreenNeedsEvidence { contested_medium } => true,
  }
}

fn has_figure_for(d: CabinetDensityClaim, requested: CoolingMediumStanding) -> Bool {
  match density_figure_for_medium(d: d, requested: requested) {
    FigureFound { figure } => true,
    FigureAbsent { absent_medium } => false,
    FigureDuplicated { duplicated_medium } => false,
  }
}

fn has_ceiling_for(d: CabinetDensityClaim, requested: CoolingMediumStanding) -> Bool {
  match density_figure_for_medium(d: d, requested: requested) {
    FigureFound { figure } => match quantity_ceiling(q: figure.quantity) {
      Present { value } => true,
      Absent => false,
    },
    FigureAbsent { absent_medium } => false,
    FigureDuplicated { duplicated_medium } => false,
  }
}

// A FIXTURE REPRODUCING THE READING THAT FOUND THE DEFECT. Telehouse Chelsea publishes "standard
// power to rack at 3.5kVA with scalable options to 5kVA", and an earlier carrier had no arm for
// apparent power, so the numeral landed in a field named for kilowatts. The fixture lives here
// rather than in an operator module because it is evidence about the CARRIER, not a census row -
// the real Telehouse rows belong to whichever lane reads that operator.
// THIS FIXTURE'S MEDIUM IS UNSPECIFIED BECAUSE ITS WORDING SAYS SO, AND THE FIRST CUT OF THE MEDIUM
// SPLIT GOT IT WRONG. "Standard power to rack at 3.5kVA" names a rack and a unit and NO cooling
// medium, so the honest coordinate is CoolingMediumUnspecified. It was authored as
// AirCoolingPublished - by me, in the same commit that added the medium coordinate - because the kVA
// controls standing on this fixture go red the moment it stops answering air questions, and an air
// label made them green again.
//
// THAT IS THE WALL-DEFEAT THIS SPLIT EXISTS TO PREVENT, PERFORMED ON THE SPLIT'S OWN CONTROL. It is
// worse than doing it to a census row: a census row is re-derived by whoever reads the operator's
// page next, and a shared test fixture is the one file everybody edits and nobody re-derives, because
// it is "just the test module". Caught by silent-heron-303 on review of the rebase surface rather
// than by any check here, which is itself the measurement - nothing in this file could have caught it.
//
// THE REPAIR IS TWO FIXTURES, EACH TRUE, NOT ONE FIXTURE BENT TO KEEP TESTS GREEN. This one keeps its
// real wording and its real medium and now serves the MEDIUM control. The kVA-versus-kW control moves
// to a fixture that is explicitly air-labelled apparent power below, so it still tests the unit
// crossing it exists for. A control restored to green by editing its subject is not a control.
data medium_unspecified_interval_fixture: CabinetDensityClaim = DensityPublished {
  figures: FreeSemigroup {
    head: PublishedDensityFigure {
      medium: CoolingMediumUnspecified,
      quantity: MarketedApparentInterval {
        lower: volt_ampere(count: 3500),
        upper: volt_ampere(count: 5000),
      },
      wording: "Standard power to rack at 3.5kVA with scalable options to 5kVA",
      citation: "witness fixture reproducing the Telehouse Chelsea publication shape verbatim, INCLUDING that it names no cooling medium; the live rows are carried by the operator's own module",
      verification: WordingVerbatim {
        retrieval: "Fixture. The wording is the publication shape this fixture exists to reproduce, so it is verbatim BY CONSTRUCTION rather than by retrieval - which is exactly why a fixture must never be counted as census coverage.",
      },
    },
    tail: [],
  },
}

// THE UNIT CONTROL, AIR-LABELLED SO IT STILL REACHES THE AIR PATH. Same interval, same apparent-power
// unit, but a medium the operator stated - so this fixture exercises kW <= kVA rather than the medium
// coordinate, and the two concerns stop being tested through one row where either could mask the
// other. It is a fixture and not a census row for exactly the reason the one above is.
data apparent_power_fixture: CabinetDensityClaim = DensityPublished {
  figures: FreeSemigroup {
    head: PublishedDensityFigure {
      medium: AirCoolingPublished,
      quantity: MarketedApparentInterval {
        lower: volt_ampere(count: 3500),
        upper: volt_ampere(count: 5000),
      },
      wording: "witness fixture: an apparent-power interval the operator labelled air",
      citation: "witness fixture isolating the apparent-to-real crossing from the medium coordinate; no live row publishes an air-labelled kVA interval, which is why this is constructed rather than cited",
      verification: WordingVerbatim {
        retrieval: "Fixture, verbatim by construction. See the note on the unspecified twin above.",
      },
    },
    tail: [],
  },
}

// AN AIR-LABELLED CAP, WHICH NO LIVE ROW ON MAIN PROVIDES. Iron Mountain was the corpus's only
// published cap and its page names no medium, so after the medium split it correctly stops answering
// air questions - which leaves the ceiling's POSITIVE control with no live subject. That is a real
// gap in the corpus rather than in the carrier: nobody in this metro has yet been read publishing a
// cap AND naming air. The fixture stands in until one is, and it is marked as a carrier fixture for
// the same reason the apparent-power one is - it is evidence about the type, not a census row.
data air_labelled_cap_fixture: CabinetDensityClaim = DensityPublished {
  figures: FreeSemigroup {
    head: PublishedDensityFigure {
      medium: AirCoolingPublished,
      quantity: MarketedAtMost { upper: PublishedRealPower { power: watt(count: 30000) } },
      wording: "witness fixture: a cap the operator labelled air",
      citation: "witness fixture reproducing the shape of an air-labelled marketed maximum; no live row on main publishes one, which is itself the observation",
      verification: WordingVerbatim {
        retrieval: "Fixture, verbatim by construction.",
      },
    },
    tail: [],
  },
}

// TWO AIR FIGURES ON ONE CLAIM, WHICH IS THE STATE THE PREVIOUS CARRIER ANSWERED AND SHOULD HAVE
// REFUSED. `air_figure` filtered to air and took `.first()`, so this fixture would have screened
// against whichever cell an author happened to type first, with no signal that the page contradicted
// itself. The two quantities are deliberately in OPPOSITE directions and would produce opposite
// answers - a 30 kW cap ceilings and covers nothing, a 35kW+ floor covers and ceilings nothing - so a
// `.first()` implementation does not merely pick, it picks the entire MEANING of the row from list
// order. No live row constructs this; it is the RED that makes the refusal real.
data duplicated_air_fixture: CabinetDensityClaim = DensityPublished {
  figures: FreeSemigroup {
    head: PublishedDensityFigure {
      medium: AirCoolingPublished,
      quantity: MarketedAtMost { upper: PublishedRealPower { power: watt(count: 30000) } },
      wording: "witness fixture, first cell: up to 30 kW per rack",
      citation: "witness fixture reproducing a self-contradicting page; no live row publishes two air figures",
      verification: WordingVerbatim {
        retrieval: "Fixture, verbatim by construction.",
      },
    },
    tail: [
      PublishedDensityFigure {
        medium: AirCoolingPublished,
        quantity: CapabilityAtLeast { lower: PublishedRealPower { power: watt(count: 35000) } },
        wording: "witness fixture, second cell: 35kW+ air",
        citation: "witness fixture reproducing a self-contradicting page; no live row publishes two air figures",
        verification: WordingVerbatim {
          retrieval: "Fixture, verbatim by construction.",
        },
      },
    ],
  },
}

// POSITIVE CONTROL, AND IT IS NOW THE CAP ROW RATHER THAN BOTH ROWS. Iron Mountain publishes
// "high-density up to 30 kW/rack" - a MarketedAtMost - so a ceiling exists, refuses 30001 W and
// does not refuse 29999 W. Not-refused is undetermined, never admitted, which is why the second
// conjunct is negated rather than read as a fit.
test fn w_a_published_cap_bounds_from_above() -> Bool {
  has_ceiling_for(d: air_labelled_cap_fixture, requested: AirCoolingPublished)
    && refuses_at(d: air_labelled_cap_fixture, requested: AirCoolingPublished, required: 30001)
    && !refuses_at(d: air_labelled_cap_fixture, requested: AirCoolingPublished, required: 29999)
}

// THE DISCRIMINATING RED FOR THE QUANTIFIER SPLIT, ON THE LIVE ROW THAT MOTIVATED IT. DataBank
// publishes "35kW+ Cab Density Air" - the plus is the operator's own - so the figure is a marketed
// FLOOR and bounds nothing from above. Before the split this row fed `cabinet_power_ceiling` and
// produced a 35 kW ceiling: a number of the right unit and the right magnitude pointing the wrong
// way, which every check passed. If the floor arm ever derives a ceiling again, THIS GOES RED - and
// it is the only witness that can, because a wrong ceiling is indistinguishable from a right one at
// every other seam. The 999999 W conjunct is what separates absent-ceiling from generous-ceiling:
// an absent ceiling refuses nothing at all, including the absurd.
test fn w_a_marketed_floor_yields_no_ceiling() -> Bool {
  !has_ceiling_for(d: databank_lga4_density, requested: AirCoolingPublished)
    && !refuses_at(d: databank_lga4_density, requested: AirCoolingPublished, required: 999999)
}

// A RANGE CEILINGS AT ITS CAP AND DISCARDS ITS FLOOR, AND THE FLOOR CONJUNCT IS WHY THIS WITNESS
// EXISTS RATHER THAN JUST THE CAP ONE. Telehouse publishes "standard power to rack at 3.5kVA with
// scalable options to 5kVA" - two real numbers, and only the larger bounds from above. A carrier
// that ceilinged at the FLOOR would refuse 3501 W and would look perfectly reasonable doing it, so
// the second conjunct is the one that catches it. kW <= kVA carries the crossing, so 5001 W is
// refused on published evidence alone without any power factor being assumed.
test fn w_an_interval_bounds_at_its_upper_end_not_its_lower() -> Bool {
  refuses_at(d: apparent_power_fixture, requested: AirCoolingPublished, required: 5001)
    && !refuses_at(d: apparent_power_fixture, requested: AirCoolingPublished, required: 3501)
    && !refuses_at(d: apparent_power_fixture, requested: AirCoolingPublished, required: 4999)
}

// AN UNREAD CLAIM YIELDS NOTHING ON EITHER AXIS. The earlier accessor answered 0 here - a
// fabricated in-band reading on the same axis as real ones - and this is the control that keeps
// the zero unconstructible. WPA-1 is the live row: a review asserted 20 kW cabinets there, the
// page states no density at all, and the row records the absence rather than the assertion.
test fn w_unread_density_establishes_and_bounds_nothing() -> Bool {
  !has_ceiling_for(d: iron_mountain_wpa1_density, requested: AirCoolingPublished)
    && !refuses_at(d: iron_mountain_wpa1_density, requested: AirCoolingPublished, required: 999999)
}

// A READ DENSITY AND A SELLABLE GRAIN ARE INDEPENDENT FACTS. A cabinet marketed at 30 kW that the
// operator will only sell as part of a suite is not a candidate for one cabinet, and a 3 kW
// cabinet sold singly is. Fusing them would have made one of the two unaskable.
fn grain_admits_single_cabinet(g: RetailGrainStanding) -> Bool {
  match g {
    SingleCabinetOffered { wording, citation } => true,
    CageOrSuiteMinimum { wording, citation } => false,
    RetailGrainUnread { obligation } => false,
  }
}

test fn w_density_and_grain_are_separate_facts() -> Bool {
  grain_admits_single_cabinet(g: databank_lga4_retail_grain)
    && grain_admits_single_cabinet(g: iron_mountain_nje1_retail_grain)
    && has_ceiling_for(d: air_labelled_cap_fixture, requested: AirCoolingPublished)
    && !has_ceiling_for(d: databank_lga4_density, requested: AirCoolingPublished)
}

// AN UNREAD DENSITY REFUSES NOTHING, WHICH IS THE ARM THAT KEEPS THE CEILING FROM BEING A FREE
// ADMISSION. `ceiling_refuses_at` answers false for an absent ceiling, and false means UNDETERMINED
// rather than fits - so this asserts the pair that separates the two: a real ceiling refuses an
// impossible requirement, and an absent one refuses nothing at all. Reading a bare false as "fits"
// would admit every unread cabinet in the census.
test fn w_absent_ceiling_refuses_nothing_and_a_real_one_does() -> Bool {
  !refuses_at(d: iron_mountain_wpa1_density, requested: AirCoolingPublished, required: 999999)
    && refuses_at(d: apparent_power_fixture, requested: AirCoolingPublished, required: 999999)
}

// THE COVERAGE CARRIER'S CONSUMER, ENROLLED FOR THE SAME REASON AS THE ONES ABOVE. Review 62758
// found `gunbc.colo_census_coverage` dangling on this branch - a type, two accessors and three
// rows nothing imported - which is the identical section 3c finding review 62722 made about the
// density carrier one commit earlier. Landing the same defect twice in one PR is the receipt that
// the first fix was applied to an instance and not to the habit.

fn facility_count_or_sentinel(c: RegionCoverage) -> Int {
  match coverage_facility_count(c: c) {
    Present { value } => value,
    Absent => 0 - 1,
  }
}

// A FIXTURE FOR THE UNSURVEYED ARM, AND THE REASON IT HAD TO BE ONE. Writing this witness is what
// established that `RegionUnsurveyed` HAS NO INHABITANT in the live roster - all three rows are
// surveyed - so the distinction the module exists to draw could not be discriminated by any test
// over the census as it stands. DESIGN section 4b: where the forbidden state is unauthorable on
// the live corpus, the fixture is where the RED becomes expressible, and declining to write one
// leaves a wall that is permanently green by construction. The roster's own growth note explains
// why no live unsurveyed row exists yet - an unsurveyed roster over an undecided geographic scope
// has a length that is an artefact of where the author stopped typing - so the arm is real, is
// reachable, and is deliberately uninhabited rather than dead.
data unsurveyed_fixture: RegionCoverage = RegionCoverage {
  region_label: "witness fixture: a region nobody has surveyed",
  region_code: "XX",
  outcome: RegionUnsurveyed {
    obligation: "fixture standing for the arm the live roster does not yet inhabit",
  },
}

// THE DISCRIMINATING RED, AND THE ONLY REASON THE MODULE EXISTS. A region somebody surveyed and
// found empty answers ZERO facilities; a region nobody has looked at answers NOTHING. If these two
// ever agree, the module has collapsed expensive knowledge into an open obligation and a reader
// cannot tell a measurement from a gap - which is the error this census already made once,
// reporting the absence of any New York row as a consequence of a refused-operator ruling rather
// than as nobody having surveyed the state.
test fn w_surveyed_empty_and_unsurveyed_do_not_agree() -> Bool {
  facility_count_or_sentinel(c: southern_new_jersey) == 0
    && facility_count_or_sentinel(c: unsurveyed_fixture) == 0 - 1
}

// THE SAME DISTINCTION ON A LIVE ROW, WHICH IS WHAT KEEPS THE FIXTURE FROM BEING THE ONLY EVIDENCE.
// The Hudson Valley yielded no retail colocation and is the row a reader is most tempted to misread
// as nobody having looked - enterprise and hyperscale sites are present there, they just do not
// sell retail cabinets. It answers ZERO, so the presence of the count is what says it was surveyed,
// and no second predicate is consulted to find that out.
test fn w_a_surveyed_empty_region_is_not_an_unsurveyed_one() -> Bool {
  facility_count_or_sentinel(c: hudson_valley) == 0
}

// A SURVEYED REGION WITH FACILITIES ANSWERS ITS COUNT, and this witness is kept together with an
// honest statement of what it CANNOT see. The relation is asserted rather than the literal, because
// a witness repeating a hand-authored number it cannot re-derive proves only that the file was not
// edited. But the relation chosen - read densities never exceed facilities - was too weak to
// discriminate the error that actually occurred: the corridor row carried 28 when the corpus holds
// 27, and 1 <= 28 is exactly as true as 1 <= 27, so this stayed green beside the miscount for as
// long as it existed. Avoiding the literal was right; this relation was not the answer. The answer
// is derivation, and silent-heron-303 is landing it - both counts folded from the facility and
// claim rows themselves, which makes a miscount unwritable rather than merely checkable. This
// witness stays as the transposition control it always was, and stops being cited as evidence the
// counts are right.
//
// AND THE LINE THAT SAID `census_regions.length() == 3` IS GONE, KILLED BY bright-swift-678 WHOSE
// ROW MADE IT FOUR. A roster-length literal reds on every legitimate addition and catches no defect
// the relation beside it does not already catch, so the next lane adding a region would have had to
// edit a test to make its own row legal. The uncomfortable part is that this annotation ALREADY
// argued for asserting the relation rather than the literal, and the literal was in the body it
// annotates - the principle was stated correctly one line above the place it was not applied. The
// fold now runs the relation over EVERY row rather than the one row the author happened to name,
// which is both stronger and free of the roster's length.
fn density_reads_never_exceed_facilities(c: RegionCoverage) -> Bool {
  match c.outcome {
    FacilitiesModelled { facility_count, density_read_count } =>
      density_read_count <= facility_count && density_read_count >= 0 && facility_count > 0,
    SurveyedNoRetailOperator { searched, causes, surveyed_on, surveyed_by } => true,
    RegionUnsurveyed { obligation } => true,
  }
}

test fn w_read_densities_never_exceed_the_facilities_they_were_read_from() -> Bool {
  all(census_regions, c => density_reads_never_exceed_facilities(c: c))
    && facility_count_or_sentinel(c: nj_hudson_bergen_essex_corridor) > 0
}

// THE ADMITTING DIRECTION, WHICH IS WHY A FLOOR IS WORTH CARRYING RATHER THAN DISCARDING. DataBank
// publishes "35kW+ Cab Density Air" and the planned cabinet draws 27,300 W, so the requirement sits
// below what the operator advertises being able to build: admitted on published evidence. The same
// row admits NOTHING at 35,001 W, because a floor says at least, not at most - and Iron Mountain's
// "up to 30 kW" admits nothing at any requirement at all, since a marketed maximum is a product
// statement rather than a promise that a cabinet is available at it.
//
// THE THIRD CONJUNCT IS THE ONE THAT WOULD CATCH A REVERSAL. If the arms were ever swapped - floors
// answering the ceiling and caps answering admission - the first two conjuncts could still pass on
// the right numerals while the meaning had inverted; a cap that admits is the state this asserts
// cannot exist.
test fn w_a_marketed_floor_admits_below_itself_and_a_cap_admits_nothing() -> Bool {
  covers_at(d: databank_lga4_density, requested: AirCoolingPublished, required: 27300)
    && !covers_at(d: databank_lga4_density, requested: AirCoolingPublished, required: 35001)
    && !covers_at(d: air_labelled_cap_fixture, requested: AirCoolingPublished, required: 27300)
    && !covers_at(d: iron_mountain_wpa1_density, requested: AirCoolingPublished, required: 1)
}

// AN APPARENT-POWER FLOOR ADMITS NOTHING, WHICH IS THE CROSSING REFUSED IN THE DIRECTION THE
// CEILING ALLOWS IT. kW <= kVA lets a kVA figure bound real power from ABOVE, so the interval
// fixture ceilings; the same inequality means a kVA floor is a WEAKER claim than the same numeral
// in watts, so admitting on it would be one power factor more generous than the operator's own
// sentence. The fixture's lower end is 3.5 kVA and 1 W is not admitted by it.
test fn w_an_apparent_power_lower_end_admits_nothing() -> Bool {
  !covers_at(d: apparent_power_fixture, requested: AirCoolingPublished, required: 1)
    && refuses_at(d: apparent_power_fixture, requested: AirCoolingPublished, required: 5001)
}

// THE DISCRIMINATING RED FOR THE MEDIUM AXIS, on the live row that motivated it. Iron Mountain's
// NJE-1 page publishes "high-density up to 30 kW/rack" and names NO cooling medium, so its figure is
// CoolingMediumUnspecified. Before this split it inhabited an arm called AirOnly and
// the carrier's air-only ceiling accessor answered 30 kW for it - an air answer assembled from a page that never
// said air. If an unspecified medium is ever allowed to satisfy an air query again, THIS GOES RED.
//
// The second conjunct is what stops the fix being a blanket silencing: DataBank's air figure IS
// labelled air by the operator's own cell, so it still answers, and a repair that simply made every
// medium fall through would pass the first conjunct and fail here.
// THE FIRST CONJUNCT NAMES THE CAUSE, AND IT WAS ADDED BECAUSE THE OTHERS ONLY NAME A CONSEQUENCE.
// silent-heron-303's rule, generalised from this witness: AN OUTCOME THAT IS THE UNION OF N CAUSES
// CANNOT SERVE AS THE CONTROL FOR ONE OF THEM. `!has_ceiling_for` is true when the figure is absent,
// when it is duplicated, AND when it is found but yields no ceiling - three causes, one answer - so
// asserting it proves only that SOME ONE of them fired. It happens to discriminate here, because Iron
// Mountain's quantity is a cap and a cap does yield a ceiling, so deleting the medium coordinate would
// red this row. That is accidental: it is a property of the fixture's quantity arm, not of the
// coordinate under test, and a subject whose quantity were a floor would have left this permanently
// green while the coordinate was gone.
//
// `has_figure_for` returns FigureFound only, so its negation names absence directly and reds exactly
// when the coordinate stops working. Same shape as the Undetermined-versus-NeedsEvidence ruling one
// level down: collapsing distinct causes into one answer is what makes the specific one invisible,
// whether the collapse is in the type or in the assertion.
test fn w_an_unspecified_medium_does_not_answer_an_air_question() -> Bool {
  !has_figure_for(d: iron_mountain_nje1_density, requested: AirCoolingPublished)
    && !has_ceiling_for(d: iron_mountain_nje1_density, requested: AirCoolingPublished)
    && !covers_at(d: iron_mountain_nje1_density, requested: AirCoolingPublished, required: 1)
    && has_figure_for(d: databank_lga4_density, requested: AirCoolingPublished)
}

// A LIQUID FIGURE IS NOT AN AIR FIGURE EITHER, and DataBank is the row that can tell the difference
// because it publishes both. Its air figure is a 35kW+ floor and its liquid figure is a 100kW+ floor;
// if air selection ever walked to the first figure in the list rather than the first AIR one, a
// consumer would screen against 100 kW of liquid capacity for an air-cooled cabinet. The admitting
// direction is where that shows: 40 kW is above the air floor and below the liquid one.
test fn w_air_selection_does_not_return_the_liquid_figure() -> Bool {
  covers_at(d: databank_lga4_density, requested: AirCoolingPublished, required: 35000)
    && !covers_at(d: databank_lga4_density, requested: AirCoolingPublished, required: 40000)
}

// THE MEDIUM CONTROL ON THE FIXTURE THAT MOTIVATED IT. Telehouse's real wording names no medium, so
// the claim answers nothing on the air axis however good its figures are - and the second conjunct is
// what stops this being satisfied by breaking apparent power generally, since the air-labelled twin
// carrying the IDENTICAL interval still bounds. Two fixtures differing in exactly one coordinate is
// the only way to show the coordinate is what is being read.
test fn w_an_unlabelled_interval_answers_nothing_while_its_air_twin_bounds() -> Bool {
  !has_ceiling_for(d: medium_unspecified_interval_fixture, requested: AirCoolingPublished)
    && !covers_at(d: medium_unspecified_interval_fixture, requested: AirCoolingPublished, required: 1)
    && refuses_at(d: apparent_power_fixture, requested: AirCoolingPublished, required: 5001)
}

// THE DISCRIMINATING RED FOR THE DUPLICATION REFUSAL, AND THE REASON IT ASKS FOR THE ARM RATHER THAN
// FOR A FALSE. Two air figures on one claim used to be answered by whichever came first; now the
// lookup counts before it selects and returns FigureDuplicated, which propagates as
// ScreenNeedsEvidence in BOTH directions. The first conjunct asserts the arm itself - a witness that
// only checked `!covers_at` would be equally green if the lookup had silently gone absent, which is
// the absorbing fallback wearing the refusal's clothes.
//
// CONJUNCTS TWO AND THREE ARE THE OPPOSITE-DIRECTION PAIR. Under `.first()` this fixture's head is a
// 30 kW cap, so the old code REFUSED at 999999 and covered nothing; reverse the fixture's list order
// and it would have COVERED at 1 and refused nothing. Both are now false, so neither list order can
// produce an answer. The fourth conjunct is what stops the fix being a blanket silencing of air: the
// single-figure air fixture still ceilings.
test fn w_two_air_figures_refuse_rather_than_pick() -> Bool {
  needs_evidence(d: duplicated_air_fixture, requested: AirCoolingPublished, required: 1)
    && !covers_at(d: duplicated_air_fixture, requested: AirCoolingPublished, required: 1)
    && !refuses_at(d: duplicated_air_fixture, requested: AirCoolingPublished, required: 999999)
    && has_ceiling_for(d: air_labelled_cap_fixture, requested: AirCoolingPublished)
}

// ONE LOOKUP ANSWERS LIQUID TOO, WHICH IS THE WHOLE POINT OF THE MEDIUM BECOMING A PARAMETER.
// DataBank publishes both media on one page, so it is the only live row that can discriminate: its
// liquid figure is a 100kW+ floor, so liquid covers 100000 and not 100001. THE THIRD CONJUNCT IS THE
// ONE THAT MATTERS - air must NOT answer with the liquid figure, and a lookup that ignored the
// requested medium would pass the first two conjuncts and fail only here.
test fn w_the_same_lookup_answers_liquid_without_air_borrowing_it() -> Bool {
  covers_at(d: databank_lga4_density, requested: LiquidCoolingPublished, required: 100000)
    && !covers_at(d: databank_lga4_density, requested: LiquidCoolingPublished, required: 100001)
    && !covers_at(d: databank_lga4_density, requested: AirCoolingPublished, required: 100000)
    && !has_figure_for(d: air_labelled_cap_fixture, requested: LiquidCoolingPublished)
}

// REQUESTING AN UNSPECIFIED MEDIUM ANSWERS NOTHING, AND THE SUBJECT IS THE ROW MOST LIKELY TO MAKE IT
// LOOK REASONABLE. Iron Mountain's only figure IS CoolingMediumUnspecified, so a lookup implemented
// as plain equality on the coordinate would match it and hand back a 30 kW cap for a question that
// named no cooling at all - the medium defect restored through the query side after being closed on
// the figure side. Unspecified is a fact about what the PAGE said, never a medium anything can be
// deployed into, so it satisfies no request including its own.
test fn w_requesting_an_unspecified_medium_answers_nothing() -> Bool {
  !has_figure_for(d: iron_mountain_nje1_density, requested: CoolingMediumUnspecified)
    && !refuses_at(d: iron_mountain_nje1_density, requested: CoolingMediumUnspecified, required: 999999)
    && has_figure_for(d: databank_lga4_density, requested: AirCoolingPublished)
}

// MODEL OCCUPANCY IS NOT SCREEN UTILITY, AND IRON MOUNTAIN IS THE ROW THAT PROVES THEY DIVERGE. Its
// page publishes a real figure, so `density_claim_contains_figure` is TRUE - and because the page
// named no medium, every screen over it is undetermined. A census keyed on the ceiling accessor
// would count this verified reading as absent; that is the exact miscount the predicate exists to
// prevent, and this witness is the pair of answers that cannot both come from one function.
//
// The third conjunct keeps the predicate from being constant-true now that an empty published claim
// is unconstructible: DensityUnread still answers false, so the function still discriminates the two
// arms rather than the two list lengths it used to.
test fn w_model_occupancy_is_not_screen_utility() -> Bool {
  density_claim_contains_figure(d: iron_mountain_nje1_density)
    && !has_figure_for(d: iron_mountain_nje1_density, requested: AirCoolingPublished)
    && !density_claim_contains_figure(d: iron_mountain_wpa1_density)
}

// THREE QUESTIONS, THREE ANSWERS, ONE ROW - WHICH IS WHY THEY ARE THREE FUNCTIONS. Iron Mountain's
// NJE-1 is the row that separates every pair of them: it CONTAINS a modelled figure, its wording is
// NOT verified (summarizing fetch tool, raw re-fetch blocked at HTTP 429), and it screens
// undetermined on air because the page named no medium. Any census keyed on one of these three and
// reporting it as the others would miscount this row, in a different direction each time.
//
// DataBank is the positive control on the axis under test: raw fetch at HTTP 200, literal spec-table
// cells, so its air figure IS verified. Without that conjunct a blanket `false` from
// `figure_wording_is_verified` would pass the first three, which is the permanently-green shape.
test fn w_occupancy_verification_and_utility_are_three_facts() -> Bool {
  density_claim_contains_figure(d: iron_mountain_nje1_density)
    && !density_claim_wording_is_verified(d: iron_mountain_nje1_density)
    && !has_figure_for(d: iron_mountain_nje1_density, requested: AirCoolingPublished)
    && density_claim_wording_is_verified(d: databank_lga4_density)
}

// A FIGURE THE SCREEN CANNOT REACH IS STILL A READING THE CENSUS MUST COUNT, and Iron Mountain is the
// row that holds both halves at once. Its single figure is CoolingMediumUnspecified, so no air or
// liquid request returns it and no request for unspecified is answerable either - and it is
// nonetheless a verbatim-sourced published reading that a coverage roster has to see. The inventory
// route returns it; the screening route does not; and asserting BOTH in one witness is what stops a
// later author "fixing" the second by making unspecified requestable.
//
// THE SECOND CONJUNCT IS THE ONE THAT WOULD CATCH THAT FIX. If `medium_matches` ever answered true for
// an unspecified request, this goes red - the same defect `w_requesting_an_unspecified_medium_answers_nothing`
// guards, asserted here from the inventory side so neither route can be changed alone.
//
// The DataBank conjunct is the positive control on the count: two figures in, two figures out, so an
// inventory route that silently returned only the head would fail here and nowhere else.
test fn w_an_unscreenable_figure_is_still_inventoried() -> Bool {
  density_claim_figures(d: iron_mountain_nje1_density).length() == 1
    && !has_figure_for(d: iron_mountain_nje1_density, requested: CoolingMediumUnspecified)
    && all(density_claim_figures(d: iron_mountain_nje1_density), f => figure_is_unspecified(f: f))
    && density_claim_figures(d: databank_lga4_density).length() == 2
    && density_claim_figures(d: iron_mountain_wpa1_density).length() == 0
}
