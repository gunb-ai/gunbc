import extdeps.colo.colocation_america { colocation_america_cabinet_density, colocation_america_retail_grain }
import extdeps.colo.equinix { equinix_retail_grain }
import extdeps.colo.digital_realty { digital_realty_retail_grain }
import extdeps.colo.h5 { h5_secaucus_retail_grain }
import extdeps.colo.halsey_165 { halsey_165_retail_grain }
