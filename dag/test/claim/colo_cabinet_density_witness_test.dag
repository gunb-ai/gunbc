data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE CARRIER'S CONSUMER. Review 62722 found the first cut of this module dangling: a type, two
// functions and six data rows that nothing read, with the controls living only in a scratch probe
// the author ran and deleted. A probe that is deleted is not evidence the wall stays standing -
// DESIGN section 3c is explicit that a declaration nobody consumes is red regardless of how well
// it is modelled, and section 5 that a run nobody can repeat is not a consumer. These are those
// controls, enrolled.

// A CEILING IS ASKED WHETHER IT REFUSES A REQUIREMENT; IT IS NEVER ASKED WHAT THE CABINET SUPPLIES.
// These two helpers are the whole surface the witnesses use, and neither yields a Watt - which is
// the point of review 62791's fix: a bound handed to something wanting a reading is now ill-typed
// rather than defended by a comment.
// EVERY HELPER TAKES THE MEDIUM, AND THAT IS THE SAME FINDING AS THE CARRIER'S ONE LEVEL DOWN. The
// first cut of this module wrote `ceiling_refuses_at`, `admits_at` and `has_ceiling` with air baked
// into their bodies, mirroring the carrier's air-only accessors - so when the carrier generalised,
// the tests would have kept exercising exactly one coordinate and the liquid path would have had no
// executing evidence at all. A test helper that hard-codes the parameter under test measures the
// helper.
//
// THE THREE-STATE SCREEN IS FLATTENED TO Bool HERE DELIBERATELY AND ONLY HERE. ScreenNeedsEvidence
// reads as false in both directions - a contested claim neither covers nor refuses - which is the
// correct reading for every witness below EXCEPT the duplication one, which asks for the arm itself
// through `needs_evidence` rather than through these. Flattening in the carrier is what the review
// found; flattening in a caller that has just been shown the arm is a caller's choice.
fn outside_maximum(d: CabinetDensityClaim, requested: CoolingMedium, required: Int) -> Bool {
  match published_requirement_standing(d: d, requested: requested, required: watt(count: required)) {
    OutsidePublishedMaximum { figure } => true,
    CoveredByPublishedFloor { figure } => false,
    CoveredByPublishedRangeFloor { figure } => false,
    NonBoundingPublication { figure } => false,
    PublishedQuantityUnreadable { figure, reason } => false,
    RequirementMediumAbsent { requested: r } => false,
    RequirementClaimUnread { obligation } => false,
    RequirementFigureContested { contested } => false,
  }
}

fn covered_by_floor(d: CabinetDensityClaim, requested: CoolingMedium, required: Int) -> Bool {
  match published_requirement_standing(d: d, requested: requested, required: watt(count: required)) {
    CoveredByPublishedFloor { figure } => true,
    CoveredByPublishedRangeFloor { figure } => false,
    OutsidePublishedMaximum { figure } => false,
    NonBoundingPublication { figure } => false,
    PublishedQuantityUnreadable { figure, reason } => false,
    RequirementMediumAbsent { requested: r } => false,
    RequirementClaimUnread { obligation } => false,
    RequirementFigureContested { contested } => false,
  }
}

fn covered_by_range_floor(d: CabinetDensityClaim, requested: CoolingMedium, required: Int) -> Bool {
  match published_requirement_standing(d: d, requested: requested, required: watt(count: required)) {
    CoveredByPublishedRangeFloor { figure } => true,
    CoveredByPublishedFloor { figure } => false,
    OutsidePublishedMaximum { figure } => false,
    NonBoundingPublication { figure } => false,
    PublishedQuantityUnreadable { figure, reason } => false,
    RequirementMediumAbsent { requested: r } => false,
    RequirementClaimUnread { obligation } => false,
    RequirementFigureContested { contested } => false,
  }
}

fn non_bounding(d: CabinetDensityClaim, requested: CoolingMedium, required: Int) -> Bool {
  match published_requirement_standing(d: d, requested: requested, required: watt(count: required)) {
    NonBoundingPublication { figure } => true,
    CoveredByPublishedFloor { figure } => false,
    CoveredByPublishedRangeFloor { figure } => false,
    OutsidePublishedMaximum { figure } => false,
    PublishedQuantityUnreadable { figure, reason } => false,
    RequirementMediumAbsent { requested: r } => false,
    RequirementClaimUnread { obligation } => false,
    RequirementFigureContested { contested } => false,
  }
}

fn medium_absent(d: CabinetDensityClaim, requested: CoolingMedium, required: Int) -> Bool {
  match published_requirement_standing(d: d, requested: requested, required: watt(count: required)) {
    RequirementMediumAbsent { requested: r } => true,
    CoveredByPublishedFloor { figure } => false,
    CoveredByPublishedRangeFloor { figure } => false,
    OutsidePublishedMaximum { figure } => false,
    NonBoundingPublication { figure } => false,
    PublishedQuantityUnreadable { figure, reason } => false,
    RequirementClaimUnread { obligation } => false,
    RequirementFigureContested { contested } => false,
  }
}

fn claim_unread(d: CabinetDensityClaim, requested: CoolingMedium, required: Int) -> Bool {
  match published_requirement_standing(d: d, requested: requested, required: watt(count: required)) {
    RequirementClaimUnread { obligation } => true,
    CoveredByPublishedFloor { figure } => false,
    CoveredByPublishedRangeFloor { figure } => false,
    OutsidePublishedMaximum { figure } => false,
    NonBoundingPublication { figure } => false,
    PublishedQuantityUnreadable { figure, reason } => false,
    RequirementMediumAbsent { requested: r } => false,
    RequirementFigureContested { contested } => false,
  }
}

fn needs_evidence(d: CabinetDensityClaim, requested: CoolingMedium, required: Int) -> Bool {
  match published_requirement_standing(d: d, requested: requested, required: watt(count: required)) {
    RequirementFigureContested { contested } => true,
    CoveredByPublishedFloor { figure } => false,
    CoveredByPublishedRangeFloor { figure } => false,
    OutsidePublishedMaximum { figure } => false,
    NonBoundingPublication { figure } => false,
    PublishedQuantityUnreadable { figure, reason } => false,
    RequirementMediumAbsent { requested: r } => false,
    RequirementClaimUnread { obligation } => false,
  }
}

fn has_figure_for(d: CabinetDensityClaim, requested: CoolingMedium) -> Bool {
  match density_figure_for_medium(d: d, requested: requested) {
    FigureFound { figure } => true,
    RequestedMediumAbsent { requested: r } => false,
    ClaimUnread { obligation } => false,
    FigureDuplicated { duplicated } => false,
  }
}

// WHETHER THE PUBLICATION BOUNDS FROM ABOVE AT ALL, asked by handing the relation a requirement no
// published cabinet figure in this corpus reaches. It replaces a `has_ceiling_for` that read the
// quantity's ceiling directly: there is no ceiling to read any more, because a marketed maximum no
// longer becomes one. What a caller can still ask is whether this publication would place ANY
// requirement outside its published range, and that is this.
fn bounds_above(d: CabinetDensityClaim, requested: CoolingMedium) -> Bool {
  outside_maximum(d: d, requested: requested, required: 99999999)
}

// SUPPORT FROM BELOW, ACROSS BOTH ARMS THAT CAN GIVE IT. Used ONLY in negative position, where it is
// strictly stronger than either arm alone: asserting that neither a floor nor a range supports a
// requirement rules out both, while every positive assertion names its exact arm so the two can never
// be satisfied by each other.
fn supports_from_below(d: CabinetDensityClaim, requested: CoolingMedium, required: Int) -> Bool {
  covered_by_floor(d: d, requested: requested, required: required)
    || covered_by_range_floor(d: d, requested: requested, required: required)
}

// VERIFICATION READ AT THE SCREEN BOUNDARY, WHICH IS THE ONLY PLACE THE LOSS WAS OBSERVABLE. The
// standing carries the figure on every arm that has one, so a caller reaches the verification grade of
// the exact reading it is about to act on. Before that, a summarized-wording figure and a raw-byte
// verbatim figure produced identical answers and nothing downstream could tell them apart. The four
// evidence-gap arms answer false because there is no reading to grade, which is a different fact from
// an unverified one and is why they are not fused here either.
fn standing_is_verbatim(d: CabinetDensityClaim, requested: CoolingMedium, required: Int) -> Bool {
  match published_requirement_standing(d: d, requested: requested, required: watt(count: required)) {
    CoveredByPublishedFloor { figure } => figure_is_verbatim(f: figure),
    CoveredByPublishedRangeFloor { figure } => figure_is_verbatim(f: figure),
    OutsidePublishedMaximum { figure } => figure_is_verbatim(f: figure),
    NonBoundingPublication { figure } => figure_is_verbatim(f: figure),
    PublishedQuantityUnreadable { figure, reason } => figure_is_verbatim(f: figure),
    RequirementMediumAbsent { requested: r } => false,
    RequirementClaimUnread { obligation } => false,
    RequirementFigureContested { contested } => false,
  }
}

fn quantity_is_unreadable(d: CabinetDensityClaim, requested: CoolingMedium, required: Int) -> Bool {
  match published_requirement_standing(d: d, requested: requested, required: watt(count: required)) {
    PublishedQuantityUnreadable { figure, reason } => true,
    CoveredByPublishedFloor { figure } => false,
    CoveredByPublishedRangeFloor { figure } => false,
    OutsidePublishedMaximum { figure } => false,
    NonBoundingPublication { figure } => false,
    RequirementMediumAbsent { requested: r } => false,
    RequirementClaimUnread { obligation } => false,
    RequirementFigureContested { contested } => false,
  }
}

// THE SIZE OF THE REMEDY POPULATION, WHICH IS THE ONLY THING THAT SEES A FIRST-WINS NARROWING.
fn unverified_count(d: CabinetDensityClaim) -> Int {
  match claim_wording_standing(d: d) {
    ClaimWordingVerified => 0,
    ClaimWordingUnread => 0,
    ClaimWordingSummarized { unverified } => non_empty_to_list(xs: unverified).length(),
  }
}

fn figure_is_verbatim(f: PublishedDensityFigure) -> Bool {
  match f.verification {
    WordingVerbatim { retrieval } => true,
    WordingSummarized { retrieval, discharge } => false,
  }
}

// A FIXTURE REPRODUCING THE READING THAT FOUND THE DEFECT. Telehouse Chelsea publishes "standard
// power to rack at 3.5kVA with scalable options to 5kVA", and an earlier carrier had no arm for
// apparent power, so the numeral landed in a field named for kilowatts. The fixture lives here
// rather than in an operator module because it is evidence about the CARRIER, not a census row -
// the real Telehouse rows belong to whichever lane reads that operator.
// THIS FIXTURE'S MEDIUM IS UNSPECIFIED BECAUSE ITS WORDING SAYS SO, AND THE FIRST CUT OF THE MEDIUM
// SPLIT GOT IT WRONG. "Standard power to rack at 3.5kVA" names a rack and a unit and NO cooling
// medium, so the honest coordinate is CoolingMediumUnspecified. It was authored as
// AirCoolingPublished - by me, in the same commit that added the medium coordinate - because the kVA
// controls standing on this fixture go red the moment it stops answering air questions, and an air
// label made them green again.
//
// THAT IS THE WALL-DEFEAT THIS SPLIT EXISTS TO PREVENT, PERFORMED ON THE SPLIT'S OWN CONTROL. It is
// worse than doing it to a census row: a census row is re-derived by whoever reads the operator's
// page next, and a shared test fixture is the one file everybody edits and nobody re-derives, because
// it is "just the test module". Caught by silent-heron-303 on review of the rebase surface rather
// than by any check here, which is itself the measurement - nothing in this file could have caught it.
//
// THE REPAIR IS TWO FIXTURES, EACH TRUE, NOT ONE FIXTURE BENT TO KEEP TESTS GREEN. This one keeps its
// real wording and its real medium and now serves the MEDIUM control. The kVA-versus-kW control moves
// to a fixture that is explicitly air-labelled apparent power below, so it still tests the unit
// crossing it exists for. A control restored to green by editing its subject is not a control.
data medium_unspecified_interval_fixture: CabinetDensityClaim = DensityPublished {
  figures: FreeSemigroup {
    head: PublishedDensityFigure {
      medium: CoolingMediumUnspecified,
      quantity: marketed_apparent_interval(
        lower: volt_ampere(count: 3500),
        upper: volt_ampere(count: 5000),
      ),
      wording: "Standard power to rack at 3.5kVA with scalable options to 5kVA",
      citation: "witness fixture reproducing the Telehouse Chelsea publication shape verbatim, INCLUDING that it names no cooling medium; the live rows are carried by the operator's own module",
      verification: WordingVerbatim {
        retrieval: "Fixture. The wording is the publication shape this fixture exists to reproduce, so it is verbatim BY CONSTRUCTION rather than by retrieval - which is exactly why a fixture must never be counted as census coverage.",
      },
    },
    tail: [],
  },
}

// THE UNIT CONTROL, AIR-LABELLED SO IT STILL REACHES THE AIR PATH. Same interval, same apparent-power
// unit, but a medium the operator stated - so this fixture exercises kW <= kVA rather than the medium
// coordinate, and the two concerns stop being tested through one row where either could mask the
// other. It is a fixture and not a census row for exactly the reason the one above is.
data apparent_power_fixture: CabinetDensityClaim = DensityPublished {
  figures: FreeSemigroup {
    head: PublishedDensityFigure {
      medium: CoolingMediumPublished { medium: AirCooling },
      quantity: marketed_apparent_interval(
        lower: volt_ampere(count: 3500),
        upper: volt_ampere(count: 5000),
      ),
      wording: "witness fixture: an apparent-power interval the operator labelled air",
      citation: "witness fixture isolating the apparent-to-real crossing from the medium coordinate; no live row publishes an air-labelled kVA interval, which is why this is constructed rather than cited",
      verification: WordingVerbatim {
        retrieval: "Fixture, verbatim by construction. See the note on the unspecified twin above.",
      },
    },
    tail: [],
  },
}

// AN AIR-LABELLED CAP, WHICH NO LIVE ROW ON MAIN PROVIDES. Iron Mountain was the corpus's only
// published cap and its page names no medium, so after the medium split it correctly stops answering
// air questions - which leaves the ceiling's POSITIVE control with no live subject. That is a real
// gap in the corpus rather than in the carrier: nobody in this metro has yet been read publishing a
// cap AND naming air. The fixture stands in until one is, and it is marked as a carrier fixture for
// the same reason the apparent-power one is - it is evidence about the type, not a census row.
data air_labelled_cap_fixture: CabinetDensityClaim = DensityPublished {
  figures: FreeSemigroup {
    head: PublishedDensityFigure {
      medium: CoolingMediumPublished { medium: AirCooling },
      quantity: MarketedAtMost { upper: PublishedRealPower { power: watt(count: 30000) } },
      wording: "witness fixture: a cap the operator labelled air",
      citation: "witness fixture reproducing the shape of an air-labelled marketed maximum; no live row on main publishes one, which is itself the observation",
      verification: WordingVerbatim {
        retrieval: "Fixture, verbatim by construction.",
      },
    },
    tail: [],
  },

// #10862's TWO WITNESSES OVER THESE FIXTURES ARE NOT DROPPED, THEY ARE RE-KEYED, AND ONE OF THEM
// MOVED SUBJECT FIRST. `w_published_kilowatts_establish_real_power` and
// `w_apparent_power_establishes_no_real_power` asserted through `established_watts`,
// `ceiling_refuses_at` and `has_ceiling`, all three of which this change deletes: the first read a
// published figure as an exact MEASUREMENT, and no arm of this carrier can honestly answer that.
//
// Their CLAIMS survive. The published-maximum half is asserted by `w_a_published_cap_bounds_from_above`
// and by the Iron Mountain conjunct in `w_density_and_grain_are_separate_facts`, which now asks
// `outside_maximum` at 30,001 W instead of an equality against 30000. The apparent-power half is
// `w_an_apparent_power_lower_end_admits_nothing`.
//
// AND THAT LANE'S RULE IS KEPT WITH THEM: an outcome that is the union of N causes cannot be the
// control for one of them. Their sentinel witness would have stayed green if its fixture were edited
// to DensityUnread, so they paired it with a published-ness conjunct. The same hazard exists here in
// a different shape - `!supports_from_below` is true of an unread row too - which is why the
// apparent-power witness pairs it with `outside_maximum`, an arm only a FOUND and bounding figure
// can reach.
}

// TWO AIR FIGURES ON ONE CLAIM, WHICH IS THE STATE THE PREVIOUS CARRIER ANSWERED AND SHOULD HAVE
// REFUSED. `air_figure` filtered to air and took `.first()`, so this fixture would have screened
// against whichever cell an author happened to type first, with no signal that the page contradicted
// itself. The two quantities are deliberately in OPPOSITE directions and would produce opposite
// answers - a 30 kW cap ceilings and covers nothing, a 35kW+ floor covers and ceilings nothing - so a
// `.first()` implementation does not merely pick, it picks the entire MEANING of the row from list
// order. No live row constructs this; it is the RED that makes the refusal real.
data duplicated_air_fixture: CabinetDensityClaim = DensityPublished {
  figures: FreeSemigroup {
    head: PublishedDensityFigure {
      medium: CoolingMediumPublished { medium: AirCooling },
      quantity: MarketedAtMost { upper: PublishedRealPower { power: watt(count: 30000) } },
      wording: "witness fixture, first cell: up to 30 kW per rack",
      citation: "witness fixture reproducing a self-contradicting page; no live row publishes two air figures",
      verification: WordingVerbatim {
        retrieval: "Fixture, verbatim by construction.",
      },
    },
    tail: [
      PublishedDensityFigure {
        medium: CoolingMediumPublished { medium: AirCooling },
        quantity: CapabilityAtLeast { lower: PublishedRealPower { power: watt(count: 35000) } },
        wording: "witness fixture, second cell: 35kW+ air",
        citation: "witness fixture reproducing a self-contradicting page; no live row publishes two air figures",
        verification: WordingVerbatim {
          retrieval: "Fixture, verbatim by construction.",
        },
      },
    ],
  },
}

// A REAL-POWER INTERVAL, WHICH NOTHING IN THE CORPUS CONSTRUCTED UNTIL THIS FIXTURE. The dimension
// split gave MarketedRealInterval and MarketedApparentInterval separate arms, and both live fixtures
// were apparent - so the REAL arm's covers path, `required <= lower`, was the only new
// admission-granting path in the change and was reached only by typecheck. DESIGN section 5 is
// explicit that a typecheck is not a consumer, and an admission path is the worst place to accept
// one: it is the direction that puts a cabinet on a breaker.
//
// The numerals are NJFX Wall's published wording, "power densities ranging from 2 kW to 16 kW per
// cabinet", because a two-ended real-power claim should be tested against a shape an operator
// actually publishes. It is air-labelled and therefore a FIXTURE rather than a census row - that page
// names no medium, and the live row belongs to the lane reading that operator.
data real_interval_fixture: CabinetDensityClaim = DensityPublished {
  figures: FreeSemigroup {
    head: PublishedDensityFigure {
      medium: CoolingMediumPublished { medium: AirCooling },
      quantity: marketed_real_interval(lower: watt(count: 2000), upper: watt(count: 16000)),
      wording: "witness fixture: a real-power interval the operator labelled air",
      citation: "witness fixture reproducing NJFX Wall's two-ended publication shape in real power; no live row is both an interval and air-labelled, which is why this is constructed rather than cited",
      verification: WordingVerbatim {
        retrieval: "Fixture, verbatim by construction.",
      },
    },
    tail: [],
  },
}

// AN AVERAGE, WHICH IS THE ARM THAT EXISTS SO A READING IS NOT FILED AS AN OBLIGATION. "Cooling level
// average is 3kW per cabinet" was read by a census lane that had no arm for it and had to record a
// real reading as DensityUnread. The arm's whole design is that it is representable, countable and
// citable while supporting NO bound in either direction - and until this fixture that claim rested on
// two match arms nothing ever reached.
//
// A DECLARATION THAT NO OPERATION CONSUMES STILL NEEDS EVIDENCE THAT IT CONSUMES NOTHING. The carrier
// annotation says "the arm exists and NO OPERATION CONSUMES IT"; that is a machine claim, and DESIGN
// section 4b(1) says a rung is established by executed evidence rather than by a sentence.
data published_average_fixture: CabinetDensityClaim = DensityPublished {
  figures: FreeSemigroup {
    head: PublishedDensityFigure {
      medium: CoolingMediumPublished { medium: AirCooling },
      quantity: PublishedAverage { average: PublishedRealPower { power: watt(count: 3000) } },
      wording: "witness fixture: cooling level average is 3kW per cabinet",
      citation: "witness fixture reproducing the average publication shape a lane read and could not file; air-labelled so it REACHES the screen and can be shown to answer nothing once there",
      verification: WordingVerbatim {
        retrieval: "Fixture, verbatim by construction.",
      },
    },
    tail: [],
  },
}

// POSITIVE CONTROL, AND IT IS NOW THE CAP ROW RATHER THAN BOTH ROWS. Iron Mountain publishes
// "high-density up to 30 kW/rack" - a MarketedAtMost - so a ceiling exists, refuses 30001 W and
// does not refuse 29999 W. Not-refused is undetermined, never admitted, which is why the second
// conjunct is negated rather than read as a fit.
test fn w_a_published_cap_bounds_from_above() -> Bool {
  bounds_above(d: air_labelled_cap_fixture, requested: AirCooling)
    && outside_maximum(d: air_labelled_cap_fixture, requested: AirCooling, required: 30001)
    && !outside_maximum(d: air_labelled_cap_fixture, requested: AirCooling, required: 29999)
}

// THE DISCRIMINATING RED FOR THE QUANTIFIER SPLIT, ON THE LIVE ROW THAT MOTIVATED IT. DataBank
// publishes "35kW+ Cab Density Air" - the plus is the operator's own - so the figure is a marketed
// FLOOR and bounds nothing from above. Before the split this row fed `cabinet_power_ceiling` and
// produced a 35 kW ceiling: a number of the right unit and the right magnitude pointing the wrong
// way, which every check passed. If the floor arm ever derives a ceiling again, THIS GOES RED - and
// it is the only witness that can, because a wrong ceiling is indistinguishable from a right one at
// every other seam. The 999999 W conjunct is what separates absent-ceiling from generous-ceiling:
// an absent ceiling refuses nothing at all, including the absurd.
test fn w_a_marketed_floor_yields_no_ceiling() -> Bool {
  !bounds_above(d: databank_lga4_density, requested: AirCooling)
    && !outside_maximum(d: databank_lga4_density, requested: AirCooling, required: 999999)
}

// A RANGE CEILINGS AT ITS CAP AND DISCARDS ITS FLOOR, AND THE FLOOR CONJUNCT IS WHY THIS WITNESS
// EXISTS RATHER THAN JUST THE CAP ONE. Telehouse publishes "standard power to rack at 3.5kVA with
// scalable options to 5kVA" - two real numbers, and only the larger bounds from above. A carrier
// that ceilinged at the FLOOR would refuse 3501 W and would look perfectly reasonable doing it, so
// the second conjunct is the one that catches it. kW <= kVA carries the crossing, so 5001 W is
// refused on published evidence alone without any power factor being assumed.
test fn w_an_interval_bounds_at_its_upper_end_not_its_lower() -> Bool {
  outside_maximum(d: apparent_power_fixture, requested: AirCooling, required: 5001)
    && !outside_maximum(d: apparent_power_fixture, requested: AirCooling, required: 3501)
    && !outside_maximum(d: apparent_power_fixture, requested: AirCooling, required: 4999)
}

// AN UNREAD CLAIM YIELDS NOTHING ON EITHER AXIS. The earlier accessor answered 0 here - a
// fabricated in-band reading on the same axis as real ones - and this is the control that keeps
// the zero unconstructible. WPA-1 is the live row: a review asserted 20 kW cabinets there, the
// page states no density at all, and the row records the absence rather than the assertion.
test fn w_unread_density_establishes_and_bounds_nothing() -> Bool {
  !bounds_above(d: iron_mountain_wpa1_density, requested: AirCooling)
    && !outside_maximum(d: iron_mountain_wpa1_density, requested: AirCooling, required: 999999)
}

// A READ DENSITY AND A SELLABLE GRAIN ARE INDEPENDENT FACTS. A cabinet marketed at 30 kW that the
// operator will only sell as part of a suite is not a candidate for one cabinet, and a 3 kW
// cabinet sold singly is. Fusing them would have made one of the two unaskable.
fn grain_admits_single_cabinet(g: RetailGrainStanding) -> Bool {
  match g {
    SingleCabinetOffered { wording, citation } => true,
    CageOrSuiteMinimum { wording, citation } => false,
    RetailGrainUnread { obligation } => false,
  }
}

// IRON MOUNTAIN IS THE PAIR THAT PROVES THE INDEPENDENCE, AND IT PROVES IT IN THE HARDER DIRECTION.
// Its grain is readable - the operator sells single cabinets - while its density answers NO medium
// request at all, because its page names no cooling medium. So one axis screens and the other cannot,
// on one row, which is what "separate facts" has to mean to be worth asserting.
//
// THE MEDIUM CAUGHT AN ERROR IN THIS WITNESS RATHER THAN IN A ROW. Merging #10862 re-keyed its
// `established_watts(iron_mountain_nje1_density) == 30000` to `outside_maximum(..., AirCooling,
// 30001)`, and that FAILED - correctly. NJE-1 publishes "high-density up to 30 kW/rack" and names no
// medium, so an air request finds no figure and the screen refuses for absence rather than for the
// ceiling. The re-key had quietly restored the pre-migration inference that an unlabelled figure
// answers an air question, inside the change that exists to remove it. The honest conjunct is that the
// air request finds NOTHING here while the grain still reads.
test fn w_density_and_grain_are_separate_facts() -> Bool {
  grain_admits_single_cabinet(g: databank_lga4_retail_grain)
    && grain_admits_single_cabinet(g: iron_mountain_nje1_retail_grain)
    && bounds_above(d: air_labelled_cap_fixture, requested: AirCooling)
    && !bounds_above(d: databank_lga4_density, requested: AirCooling)
    && !has_figure_for(d: iron_mountain_nje1_density, requested: AirCooling)
    && density_claim_figures(d: iron_mountain_nje1_density).length() == 1
}

// AN UNREAD DENSITY REFUSES NOTHING, WHICH IS THE ARM THAT KEEPS THE CEILING FROM BEING A FREE
// ADMISSION. `ceiling_refuses_at` answers false for an absent ceiling, and false means UNDETERMINED
// rather than fits - so this asserts the pair that separates the two: a real ceiling refuses an
// impossible requirement, and an absent one refuses nothing at all. Reading a bare false as "fits"
// would admit every unread cabinet in the census.
test fn w_absent_ceiling_refuses_nothing_and_a_real_one_does() -> Bool {
  !outside_maximum(d: iron_mountain_wpa1_density, requested: AirCooling, required: 999999)
    && outside_maximum(d: apparent_power_fixture, requested: AirCooling, required: 999999)
}

// THE COVERAGE CARRIER'S CONSUMER, ENROLLED FOR THE SAME REASON AS THE ONES ABOVE. Review 62758
// found `gunbc.colo_census_coverage` dangling on this branch - a type, two accessors and three
// rows nothing imported - which is the identical section 3c finding review 62722 made about the
// density carrier one commit earlier. Landing the same defect twice in one PR is the receipt that
// the first fix was applied to an instance and not to the habit.

fn facility_count_or_sentinel(c: RegionCoverage) -> Int {
  match coverage_facility_count(c: c) {
    Present { value } => value,
    Absent => 0 - 1,
  }
}

// A FIXTURE FOR THE UNSURVEYED ARM, AND THE REASON IT HAD TO BE ONE. Writing this witness is what
// established that `RegionUnsurveyed` HAS NO INHABITANT in the live roster - all three rows are
// surveyed - so the distinction the module exists to draw could not be discriminated by any test
// over the census as it stands. DESIGN section 4b: where the forbidden state is unauthorable on
// the live corpus, the fixture is where the RED becomes expressible, and declining to write one
// leaves a wall that is permanently green by construction. The roster's own growth note explains
// why no live unsurveyed row exists yet - an unsurveyed roster over an undecided geographic scope
// has a length that is an artefact of where the author stopped typing - so the arm is real, is
// reachable, and is deliberately uninhabited rather than dead.
data unsurveyed_fixture: RegionCoverage = RegionCoverage {
  region_label: "witness fixture: a region nobody has surveyed",
  region_code: "XX",
  outcome: RegionUnsurveyed {
    obligation: "fixture standing for the arm the live roster does not yet inhabit",
  },
}

// THE DISCRIMINATING RED, AND THE ONLY REASON THE MODULE EXISTS. A region somebody surveyed and
// found empty answers ZERO facilities; a region nobody has looked at answers NOTHING. If these two
// ever agree, the module has collapsed expensive knowledge into an open obligation and a reader
// cannot tell a measurement from a gap - which is the error this census already made once,
// reporting the absence of any New York row as a consequence of a refused-operator ruling rather
// than as nobody having surveyed the state.
test fn w_surveyed_empty_and_unsurveyed_do_not_agree() -> Bool {
  facility_count_or_sentinel(c: southern_new_jersey) == 0
    && facility_count_or_sentinel(c: unsurveyed_fixture) == 0 - 1
}

// THE SAME DISTINCTION ON A LIVE ROW, WHICH IS WHAT KEEPS THE FIXTURE FROM BEING THE ONLY EVIDENCE.
// The Hudson Valley yielded no retail colocation and is the row a reader is most tempted to misread
// as nobody having looked - enterprise and hyperscale sites are present there, they just do not
// sell retail cabinets. It answers ZERO, so the presence of the count is what says it was surveyed,
// and no second predicate is consulted to find that out.
test fn w_a_surveyed_empty_region_is_not_an_unsurveyed_one() -> Bool {
  facility_count_or_sentinel(c: hudson_valley) == 0
}

// A SURVEYED REGION WITH FACILITIES ANSWERS ITS COUNT, and this witness is kept together with an
// honest statement of what it CANNOT see. The relation is asserted rather than the literal, because
// a witness repeating a hand-authored number it cannot re-derive proves only that the file was not
// edited. But the relation chosen - read densities never exceed facilities - was too weak to
// discriminate the error that actually occurred: the corridor row carried 28 when the corpus holds
// 27, and 1 <= 28 is exactly as true as 1 <= 27, so this stayed green beside the miscount for as
// long as it existed. Avoiding the literal was right; this relation was not the answer. The answer
// is derivation, and silent-heron-303 is landing it - both counts folded from the facility and
// claim rows themselves, which makes a miscount unwritable rather than merely checkable. This
// witness stays as the transposition control it always was, and stops being cited as evidence the
// counts are right.
//
// AND THE LINE THAT SAID `census_regions.length() == 3` IS GONE, KILLED BY bright-swift-678 WHOSE
// ROW MADE IT FOUR. A roster-length literal reds on every legitimate addition and catches no defect
// the relation beside it does not already catch, so the next lane adding a region would have had to
// edit a test to make its own row legal. The uncomfortable part is that this annotation ALREADY
// argued for asserting the relation rather than the literal, and the literal was in the body it
// annotates - the principle was stated correctly one line above the place it was not applied. The
// fold now runs the relation over EVERY row rather than the one row the author happened to name,
// which is both stronger and free of the roster's length.
fn read_count_or_sentinel(c: RegionCoverage) -> Int {
  match coverage_density_read_count(c: c) {
    Present { value } => value,
    Absent => 0 - 1,
  }
}

// THE VACUOUS ARM IS AT facilities <= 0, NOT < 0, AND THAT DISTINCTION IS WHAT REVIEW 62803 CAUGHT.
// A surveyed-empty region answers Present 0 facilities and Absent reads, so the sentinels are 0 and
// -1; guarding only on facilities < 0 left southern_new_jersey and hudson_valley failing both
// reads >= 0 and facilities > 0, and quantifying over the roster turned that from unreachable into
// two live violators. Zero facilities cannot be exceeded by any number of reads, so it is vacuously
// true rather than a violation. Both discriminating REDs survive the widening: a transposed pair
// (1 facility, 27 reads) still fails, and reads going Absent while facilities are present - the
// real inconsistency between the two accessors - fails on reads >= 0.
//
// Both sides are now DERIVED from the facility and claim rows rather than transcribed, so the
// transposition this control was written to catch is no longer authorable from the region row.
fn density_reads_never_exceed_facilities(c: RegionCoverage) -> Bool {
  let facilities_seen = facility_count_or_sentinel(c: c)
  let reads_seen = read_count_or_sentinel(c: c)
  facilities_seen <= 0 || (reads_seen >= 0 && reads_seen <= facilities_seen)
}

// THE CONTROLLED FIXTURE THAT MAKES THE READ COUNT FALSIFIABLE. Asserting the live corridor's count
// against a literal would be a change detector: the roster is authored, so measure() == measure()
// and the assertion's whole content is that nobody edited the file. This fixture is the grounding
// DESIGN section 5 asks for instead - a universe of exactly two density claims whose arms are known
// by construction, one published and one unread - so the count is checked against a fact about the
// claims rather than against a copy of itself. It reds if density_claim_is_read ever answers on the
// wrong arm, which is the only way the derived count can now be wrong.
//
// ITS CLAIMS ARE CONSTRUCTED HERE RATHER THAN BORROWED FROM THE CENSUS, WHICH THEY WERE UNTIL
// review 62966. It read databank_ewr1_density and hivelocity_jfk1_density - live production rows -
// so the word "fixture" was doing work the declaration did not: a universe built from the corpus is
// not controlled, and section 5's grounding requirement is precisely that the literal be checked
// against something the corpus cannot move. The coupling was not hypothetical. databank_ewr1_density
// is the corridor's only read density and is the row under an operator HOLD; had it been demoted,
// this witness would have changed what it proves without anyone editing it, and the fold's proof
// would have moved for a reason that has nothing to do with the fold. The two arms are what this
// tests, so the two arms are what it constructs.
data fixture_published_claim: CabinetDensityClaim = DensityPublished {
  figures: FreeSemigroup {
    head: PublishedDensityFigure {
      medium: CoolingMediumPublished { medium: AirCooling },
      quantity: MarketedAtMost { upper: PublishedRealPower { power: watt(count: 7000) } },
      wording: "witness fixture: a published air-cooled cabinet maximum",
      citation: "witness fixture, constructed here rather than read from any operator - its only job is to inhabit the published arm so the counting fold has something to count",
      verification: WordingVerbatim {
        retrieval: "Fixture, verbatim by construction.",
      },
    },
    tail: [],
  },
}

data fixture_unread_claim: CabinetDensityClaim = DensityUnread {
  obligation: "witness fixture: a claim nobody read, constructed here so the fold has an unread arm to skip",
}

data two_claim_fixture: RegionCoverage = RegionCoverage {
  region_label: "witness fixture: one read claim and one unread claim",
  region_code: "XX",
  outcome: FacilitiesModelled {
    facilities: [databank_ewr1_newark, hivelocity_jfk1],
    densities: [fixture_published_claim, fixture_unread_claim],
  },
}

test fn w_a_read_claim_counts_and_an_unread_one_does_not() -> Bool {
  read_count_or_sentinel(c: two_claim_fixture) == 1
}

test fn w_read_densities_never_exceed_the_facilities_they_were_read_from() -> Bool {
  all(census_regions, c => density_reads_never_exceed_facilities(c: c))
    && facility_count_or_sentinel(c: nj_hudson_bergen_essex_corridor) > 0
}

// THE ADMITTING DIRECTION, WHICH IS WHY A FLOOR IS WORTH CARRYING RATHER THAN DISCARDING. DataBank
// publishes "35kW+ Cab Density Air" and the planned cabinet draws 27,300 W, so the requirement sits
// below what the operator advertises being able to build: admitted on published evidence. The same
// row admits NOTHING at 35,001 W, because a floor says at least, not at most - and Iron Mountain's
// "up to 30 kW" admits nothing at any requirement at all, since a marketed maximum is a product
// statement rather than a promise that a cabinet is available at it.
//
// THE THIRD CONJUNCT IS THE ONE THAT WOULD CATCH A REVERSAL. If the arms were ever swapped - floors
// answering the ceiling and caps answering admission - the first two conjuncts could still pass on
// the right numerals while the meaning had inverted; a cap that admits is the state this asserts
// cannot exist.
test fn w_a_marketed_floor_admits_below_itself_and_a_cap_admits_nothing() -> Bool {
  covered_by_floor(d: databank_lga4_density, requested: AirCooling, required: 27300)
    && !supports_from_below(d: databank_lga4_density, requested: AirCooling, required: 35001)
    && !supports_from_below(d: air_labelled_cap_fixture, requested: AirCooling, required: 27300)
    && !supports_from_below(d: iron_mountain_wpa1_density, requested: AirCooling, required: 1)
}

// THE CORRIDOR'S CENTRAL FINDING, MADE MACHINE-CHECKABLE RATHER THAN ASSERTED IN A PR COMMENT.
// The survey's headline is that the density axis CANNOT screen this corridor - one readable density
// across the whole of it - while the grain axis can: the corridor will sell one cabinet, it just will not
// say in public what that cabinet may draw. Stated in prose that is a claim nobody can re-derive.
// Stated as this pairing it is a property of named rows, and DESIGN section 6 asks for exactly that
// direction - name the producer that re-derives a measurement rather than transcribing its output.
//
// EIGHT ROWS ARRIVED WITH NO CONSUMER AND REVIEW 62843 WAS RIGHT TO CALL THEM RED. The offered
// repair was an annotation naming a later consumer, which section 3c does admit; this takes the
// other arm it offers, because the consumer exists TODAY and a declared frontier would have been a
// promise where execution was available. A frontier is honest when nothing can read the row yet,
// not when writing the reader is the work being avoided.
data corridor_cabinet_grain_rows: List<RetailGrainStanding> = [
  centersquare_retail_grain,
  coresite_secaucus_retail_grain,
  dataverge_retail_grain,
  evocative_ewr1_retail_grain,
  interserver_retail_grain,
  lumen_retail_grain,
  summit_retail_grain,
  three_sixty_five_retail_grain,
]

// Every row this census reports as selling at cabinet grain or finer actually says so on its own
// arm. This is NOT a count assertion - section 5 forbids comparing a live population to a literal -
// it is a property each named row must hold, and it goes RED the moment one of them is downgraded
// to Unread or to a cage minimum without leaving this list. That downgrade is the realistic edit:
// summit's DENSITY was withdrawn on this branch when its 12 kW figure turned out to belong to a
// Chicago-area banner, and its grain survived on separate evidence. Nothing but this test stands
// between a similar withdrawal and a corridor that still claims eight cabinet-grain operators.
test fn w_every_row_listed_as_cabinet_grain_admits_a_single_cabinet() -> Bool {
  all(corridor_cabinet_grain_rows, g => grain_admits_single_cabinet(g: g))
}

// THE PAIRING ITSELF, ON THE ROWS WHERE BOTH AXES ARE KNOWN AND THEY DISAGREE. Summit sells a
// single cabinet by its own wording and publishes no density this census may read. If a later edit
// ever imports a density into that row - from the operator's other metro, from the building's
// megawatts, from a peer - this goes red, which is the exact inference the carrier was built to
// make unwritable and the exact one that was ALREADY attempted here once.
test fn w_the_corridor_sells_a_cabinet_it_will_not_rate() -> Bool {
  grain_admits_single_cabinet(g: summit_retail_grain)
    && claim_unread(d: summit_secaucus_density, requested: AirCooling, required: 5000)
    && !bounds_above(d: summit_secaucus_density, requested: AirCooling)
}

// THE CONTROL THAT KEEPS UNREAD FROM DRIFTING INTO AN ADMISSION. An unread grain must never answer
// "yes, one cabinet" - absence of a minimum-footprint sentence is not permission to buy one. These
// are the corridor's genuinely unread rows plus the out-of-corridor operator, and every one of them
// must refuse. Without this, RetailGrainUnread could be quietly widened to admit and nothing in the
// census would notice; with it, the widening is a red test rather than a silent policy change.
data corridor_unread_grain_rows: List<RetailGrainStanding> = [
  colocation_america_retail_grain,
  databank_ewr1_retail_grain,
  digital_realty_retail_grain,
  equinix_retail_grain,
  h5_secaucus_retail_grain,
  halsey_165_retail_grain,
  hivelocity_jfk1_retail_grain,
  qts_retail_grain,
]

test fn w_an_unread_grain_never_admits_a_single_cabinet() -> Bool {
  all(corridor_unread_grain_rows, g => !grain_admits_single_cabinet(g: g))
}

// A PAGE THAT WAS READ PROPERLY AND PUBLISHES NOTHING, WHICH IS A DIFFERENT FACT FROM EVERY
// NEIGHBOUR IT WAS CONFUSED WITH. This row has now been wrong twice in the same direction and both
// errors were the reader's: first it recorded the operator as refusing a fetch, when the refusal was
// a missing user-agent, and then the facility it describes was DELETED on a "zero occurrences of
// Secaucus" that came from a tag-stripper which destroyed the page - the raw bytes carry the
// operator's own heading, NEW JERSEY DC 2, 275 HARTZ WAY. Read correctly, the page publishes no
// per-cabinet figure and the word "cabinet" does not occur in it. So the claim must establish
// nothing and bound nothing, and this is the control that keeps a genuinely-read silence from ever
// answering like a reading.
test fn w_a_read_page_that_publishes_no_density_establishes_nothing() -> Bool {
  claim_unread(d: colocation_america_cabinet_density, requested: AirCooling, required: 5000)
    && !bounds_above(d: colocation_america_cabinet_density, requested: AirCooling)
    && !outside_maximum(d: colocation_america_cabinet_density, requested: AirCooling, required: 999999)
    && !supports_from_below(d: colocation_america_cabinet_density, requested: AirCooling, required: 1)
}

// THE PENNSYLVANIA LANE'S ROWS, EXECUTED RATHER THAN MERELY DECLARED. Review 62794 found the
// Philadelphia and Lehigh Valley rows dangling under DESIGN section 3c: twelve density claims and
// their grain standings that no fold read. These are that consumer, written as the region's own
// findings so that changing a row moves a test rather than only a citation string.
//
// THE ONE READ DENSITY IN EASTERN PENNSYLVANIA, COUNTED RATHER THAN MEASURED. Netrality publishes a
// cabinet-density cell at 401 North Broad and it is the only one any operator publishes in this
// region - which is a fact about the REGION and is what this witness is for.
//
// IT NO LONGER ASSERTS 30,000 W AS A READING, AND THAT IS THE POINT OF THE CARRIER CHANGE. The
// original said `established_watts == 30000` over a page whose words are "Cabinet density up to
// 30kW": a marketed ceiling read as a measurement, the same shape that demoted DataBank LGA4. It also
// asked its ceiling to refuse 30,001 W, which this carrier answers only through a medium - and that
// page names no cooling medium, so no medium request reaches the figure at all. Both halves of the
// original are now either unaskable or dishonest.
//
// What survives is the count, which is what the region's finding actually was: one published figure
// here, none anywhere else in eastern Pennsylvania. `w_philadelphia_publishes_one_ceiling_reachable_at_no_medium`
// carries the per-row half - inventoried, unspecified, screenable at no medium.
test fn w_philadelphia_has_exactly_one_published_density() -> Bool {
  density_claim_figures(d: netrality_401_n_broad_density).length() == 1
    && density_claim_figures(d: h5_philadelphia_density).length() == 0
    && density_claim_figures(d: five_9s_allentown_density).length() == 0
}

// AN APPARENT-POWER FLOOR ADMITS NOTHING, WHICH IS THE CROSSING REFUSED IN THE DIRECTION THE
// CEILING ALLOWS IT. kW <= kVA lets a kVA figure bound real power from ABOVE, so the interval
// fixture ceilings; the same inequality means a kVA floor is a WEAKER claim than the same numeral
// in watts, so admitting on it would be one power factor more generous than the operator's own
// sentence. The fixture's lower end is 3.5 kVA and 1 W is not admitted by it.
test fn w_an_apparent_power_lower_end_admits_nothing() -> Bool {
  !supports_from_below(d: apparent_power_fixture, requested: AirCooling, required: 1)
    && outside_maximum(d: apparent_power_fixture, requested: AirCooling, required: 5001)
}

// THE DISCRIMINATING RED FOR THE MEDIUM AXIS, on the live row that motivated it. Iron Mountain's
// NJE-1 page publishes "high-density up to 30 kW/rack" and names NO cooling medium, so its figure is
// CoolingMediumUnspecified. Before this split it inhabited an arm called AirOnly and
// the carrier's air-only ceiling accessor answered 30 kW for it - an air answer assembled from a page that never
// said air. If an unspecified medium is ever allowed to satisfy an air query again, THIS GOES RED.
//
// The second conjunct is what stops the fix being a blanket silencing: DataBank's air figure IS
// labelled air by the operator's own cell, so it still answers, and a repair that simply made every
// medium fall through would pass the first conjunct and fail here.
// THE FIRST CONJUNCT NAMES THE CAUSE, AND IT WAS ADDED BECAUSE THE OTHERS ONLY NAME A CONSEQUENCE.
// silent-heron-303's rule, generalised from this witness: AN OUTCOME THAT IS THE UNION OF N CAUSES
// CANNOT SERVE AS THE CONTROL FOR ONE OF THEM. `!has_ceiling_for` is true when the figure is absent,
// when it is duplicated, AND when it is found but yields no ceiling - three causes, one answer - so
// asserting it proves only that SOME ONE of them fired. It happens to discriminate here, because Iron
// Mountain's quantity is a cap and a cap does yield a ceiling, so deleting the medium coordinate would
// red this row. That is accidental: it is a property of the fixture's quantity arm, not of the
// coordinate under test, and a subject whose quantity were a floor would have left this permanently
// green while the coordinate was gone.
//
// `has_figure_for` returns FigureFound only, so its negation names absence directly and reds exactly
// when the coordinate stops working. Same shape as the Undetermined-versus-NeedsEvidence ruling one
// level down: collapsing distinct causes into one answer is what makes the specific one invisible,
// whether the collapse is in the type or in the assertion.
test fn w_an_unspecified_medium_does_not_answer_an_air_question() -> Bool {
  !has_figure_for(d: iron_mountain_nje1_density, requested: AirCooling)
    && !bounds_above(d: iron_mountain_nje1_density, requested: AirCooling)
    && !supports_from_below(d: iron_mountain_nje1_density, requested: AirCooling, required: 1)
    && has_figure_for(d: databank_lga4_density, requested: AirCooling)
}

// A LIQUID FIGURE IS NOT AN AIR FIGURE EITHER, and DataBank is the row that can tell the difference
// because it publishes both. Its air figure is a 35kW+ floor and its liquid figure is a 100kW+ floor;
// if air selection ever walked to the first figure in the list rather than the first AIR one, a
// consumer would screen against 100 kW of liquid capacity for an air-cooled cabinet. The admitting
// direction is where that shows: 40 kW is above the air floor and below the liquid one.
test fn w_air_selection_does_not_return_the_liquid_figure() -> Bool {
  covered_by_floor(d: databank_lga4_density, requested: AirCooling, required: 35000)
    && !supports_from_below(d: databank_lga4_density, requested: AirCooling, required: 40000)
}

// THE MEDIUM CONTROL ON THE FIXTURE THAT MOTIVATED IT. Telehouse's real wording names no medium, so
// the claim answers nothing on the air axis however good its figures are - and the second conjunct is
// what stops this being satisfied by breaking apparent power generally, since the air-labelled twin
// carrying the IDENTICAL interval still bounds. Two fixtures differing in exactly one coordinate is
// the only way to show the coordinate is what is being read.
test fn w_an_unlabelled_interval_answers_nothing_while_its_air_twin_bounds() -> Bool {
  !bounds_above(d: medium_unspecified_interval_fixture, requested: AirCooling)
    && !supports_from_below(d: medium_unspecified_interval_fixture, requested: AirCooling, required: 1)
    && outside_maximum(d: apparent_power_fixture, requested: AirCooling, required: 5001)
}

// THE DISCRIMINATING RED FOR THE DUPLICATION REFUSAL, AND THE REASON IT ASKS FOR THE ARM RATHER THAN
// FOR A FALSE. Two air figures on one claim used to be answered by whichever came first; now the
// lookup counts before it selects and returns FigureDuplicated, which propagates as
// ScreenNeedsEvidence in BOTH directions. The first conjunct asserts the arm itself - a witness that
// only checked `!covers_at` would be equally green if the lookup had silently gone absent, which is
// the absorbing fallback wearing the refusal's clothes.
//
// CONJUNCTS TWO AND THREE ARE THE OPPOSITE-DIRECTION PAIR. Under `.first()` this fixture's head is a
// 30 kW cap, so the old code REFUSED at 999999 and covered nothing; reverse the fixture's list order
// and it would have COVERED at 1 and refused nothing. Both are now false, so neither list order can
// produce an answer. The fourth conjunct is what stops the fix being a blanket silencing of air: the
// single-figure air fixture still ceilings.
test fn w_two_air_figures_refuse_rather_than_pick() -> Bool {
  needs_evidence(d: duplicated_air_fixture, requested: AirCooling, required: 1)
    && !supports_from_below(d: duplicated_air_fixture, requested: AirCooling, required: 1)
    && !outside_maximum(d: duplicated_air_fixture, requested: AirCooling, required: 999999)
    && bounds_above(d: air_labelled_cap_fixture, requested: AirCooling)
}

// ONE LOOKUP ANSWERS LIQUID TOO, WHICH IS THE WHOLE POINT OF THE MEDIUM BECOMING A PARAMETER.
// DataBank publishes both media on one page, so it is the only live row that can discriminate: its
// liquid figure is a 100kW+ floor, so liquid covers 100000 and not 100001. THE THIRD CONJUNCT IS THE
// ONE THAT MATTERS - air must NOT answer with the liquid figure, and a lookup that ignored the
// requested medium would pass the first two conjuncts and fail only here.
test fn w_the_same_lookup_answers_liquid_without_air_borrowing_it() -> Bool {
  covered_by_floor(d: databank_lga4_density, requested: LiquidCooling, required: 100000)
    && !supports_from_below(d: databank_lga4_density, requested: LiquidCooling, required: 100001)
    && !supports_from_below(d: databank_lga4_density, requested: AirCooling, required: 100000)
    && !has_figure_for(d: air_labelled_cap_fixture, requested: LiquidCooling)
}

// REQUESTING AN UNSPECIFIED MEDIUM ANSWERS NOTHING, AND THE SUBJECT IS THE ROW MOST LIKELY TO MAKE IT
// LOOK REASONABLE. Iron Mountain's only figure IS CoolingMediumUnspecified, so a lookup implemented
// as plain equality on the coordinate would match it and hand back a 30 kW cap for a question that
// named no cooling at all - the medium defect restored through the query side after being closed on
// the figure side. Unspecified is a fact about what the PAGE said, never a medium anything can be
// deployed into, so it satisfies no request including its own.
// MODEL OCCUPANCY IS NOT SCREEN UTILITY, AND IRON MOUNTAIN IS THE ROW THAT PROVES THEY DIVERGE. Its
// page publishes a real figure, so the inventory route is NON-EMPTY - and because the page
// named no medium, every screen over it is undetermined. A census keyed on the ceiling accessor
// would count this verified reading as absent; that is the exact miscount the predicate exists to
// prevent, and this witness is the pair of answers that cannot both come from one function.
//
// The third conjunct keeps the predicate from being constant-true now that an empty published claim
// is unconstructible: DensityUnread still answers false, so the function still discriminates the two
// arms rather than the two list lengths it used to.
test fn w_model_occupancy_is_not_screen_utility() -> Bool {
  density_claim_figures(d: iron_mountain_nje1_density).length() > 0
    && !has_figure_for(d: iron_mountain_nje1_density, requested: AirCooling)
    && density_claim_figures(d: iron_mountain_wpa1_density).length() == 0
}

// THREE QUESTIONS, THREE ANSWERS, ONE ROW - WHICH IS WHY THEY ARE THREE FUNCTIONS. Iron Mountain's
// NJE-1 is the row that separates every pair of them: it CONTAINS a modelled figure, its wording is
// NOT verified (summarizing fetch tool, raw re-fetch blocked at HTTP 429), and it screens
// undetermined on air because the page named no medium. Any census keyed on one of these three and
// reporting it as the others would miscount this row, in a different direction each time.
//
// DataBank is the positive control on the axis under test: raw fetch at HTTP 200, literal spec-table
// cells, so its air figure IS verified. Without that conjunct a blanket `false` from
// `figure_wording_is_verified` would pass the first three, which is the permanently-green shape.
fn wording_standing_is(d: CabinetDensityClaim, expect_verified: Bool, expect_summarized: Bool) -> Bool {
  match claim_wording_standing(d: d) {
    ClaimWordingVerified => expect_verified,
    ClaimWordingSummarized { unverified } => expect_summarized,
    ClaimWordingUnread => !expect_verified && !expect_summarized,
  }
}

// THREE ROWS, THREE DIFFERENT ARMS, WHICH THE Bool THIS REPLACES COULD NOT DISTINGUISH. The earlier
// version asserted `!verified` for Iron Mountain and `verified` for DataBank, and would have been
// equally green if Iron Mountain had answered UNREAD - because a projection to false fused
// nobody-read-it with read-through-a-summarizer. Those have opposite remedies, so the witness now
// names the arm each row lands in:
//
//   DataBank LGA4        raw fetch, HTTP 200, literal spec cells   -> ClaimWordingVerified
//   Iron Mountain NJE-1  summarizing tool, raw re-fetch 429'd      -> ClaimWordingSummarized
//   Iron Mountain WPA-1  page states no density at all             -> ClaimWordingUnread
//
// The fourth conjunct keeps occupancy and utility separate from both, which is the original point of
// this witness: NJE-1 is inventoried, is not screenable on air, and is not verified - three answers
// from three functions about one row.
test fn w_occupancy_verification_and_utility_are_three_facts() -> Bool {
  wording_standing_is(d: databank_lga4_density, expect_verified: true, expect_summarized: false)
    && wording_standing_is(d: iron_mountain_nje1_density, expect_verified: false, expect_summarized: true)
    && wording_standing_is(d: iron_mountain_wpa1_density, expect_verified: false, expect_summarized: false)
    && density_claim_figures(d: iron_mountain_nje1_density).length() > 0
    && !has_figure_for(d: iron_mountain_nje1_density, requested: AirCooling)
}

// THE WITNESS THAT USED TO STAND HERE DISSOLVED WHEN ITS CLASS CLIMBED, AND THE NOTE IS THE RECEIPT.
// `w_requesting_an_unspecified_medium_answers_nothing` asserted that asking for the unspecified medium
// returned no figure and bounded nothing. It guarded a real defect: a lookup written as plain equality
// over one three-arm coordinate would have matched Iron Mountain's unlabelled figure and handed back a
// 30 kW cap for a question that named no cooling at all.
//
// The request type is now `CoolingMedium`, which has two constructors, and the invalid request cannot
// be written - not here, not in a fixture, not anywhere a caller could reach. DESIGN section 4b is
// explicit that a check whose RED is not authorable is not a weak wall but a decoration: permanently
// green by construction, carrying no information, and worse than absent because it would be cited as
// coverage. The class moved from mechanically preventable to structurally impossible, and the
// production machinery that enforced it - the rejecting arm inside `medium_matches` - went with it.
//
// The half that IS still authorable is kept, in this witness: a figure whose PAGE named no medium
// answers no air and no liquid request. That is a fact about the publication rather than about the
// request, it stays fully expressible, and it is the arm a future author could actually break.

// A FIGURE THE SCREEN CANNOT REACH IS STILL A READING THE CENSUS MUST COUNT, and Iron Mountain is the
// row that holds both halves at once. Its single figure is CoolingMediumUnspecified, so no air or
// liquid request returns it and no request for unspecified is answerable either - and it is
// nonetheless a verbatim-sourced published reading that a coverage roster has to see. The inventory
// route returns it; the screening route does not; and asserting BOTH in one witness is what stops a
// later author "fixing" the second by widening the publication side.
//
// THE SECOND AND THIRD CONJUNCTS ARE THE ONES THAT WOULD CATCH THAT FIX. If `medium_matches` ever
// answered true for a figure whose page named no medium, both go red. There is no companion witness
// on the REQUEST side to point at any more and this annotation must not imply one: an unspecified
// request has no constructor, so that half of the class is closed by construction rather than by an
// enrolled control, and the note above this witness records why.
//
// The DataBank conjunct is the positive control on the count: two figures in, two figures out, so an
// inventory route that silently returned only the head would fail here and nowhere else.
test fn w_an_unscreenable_figure_is_still_inventoried() -> Bool {
  density_claim_figures(d: iron_mountain_nje1_density).length() == 1
    && !has_figure_for(d: iron_mountain_nje1_density, requested: AirCooling)
    && !has_figure_for(d: iron_mountain_nje1_density, requested: LiquidCooling)
    && all(density_claim_figures(d: iron_mountain_nje1_density), f => medium_standing_eq(a: f.medium, b: CoolingMediumUnspecified))
    && density_claim_figures(d: databank_lga4_density).length() == 2
    && density_claim_figures(d: iron_mountain_wpa1_density).length() == 0
}


// THE REAL INTERVAL COVERS FROM ITS LOWER END AND CEILINGS AT ITS UPPER, AND THE APPARENT TWIN DOES
// NEITHER. This is the only executed evidence for `required <= lower` on the real arm - the sole new
// admission-granting path in this change, and previously reachable only by typecheck.
//
// CONJUNCTS ONE TO THREE PIN THE LOWER END EXACTLY: 2000 W is covered because it equals the published
// floor, 1999 W because it sits below it, and 2001 W is NOT - an interval covers up to where the
// operator's sentence reaches and no further. An implementation covering to the UPPER end would pass
// the first two and fail the third, which is the reversal worth catching, because it would admit 16 kW
// on a page promising 2.
//
// CONJUNCT FOUR IS THE DIMENSION-SPLIT CONTROL. The apparent fixture carries the same shape in kVA and
// covers NOTHING, so the pair shows the split is doing work rather than being a rename: identical
// structure, different dimension, opposite answer on the admitting side.
test fn w_a_real_interval_covers_from_its_lower_end_only() -> Bool {
  covered_by_range_floor(d: real_interval_fixture, requested: AirCooling, required: 2000)
    && covered_by_range_floor(d: real_interval_fixture, requested: AirCooling, required: 1999)
    && !supports_from_below(d: real_interval_fixture, requested: AirCooling, required: 2001)
    && !supports_from_below(d: apparent_power_fixture, requested: AirCooling, required: 1)
}

// THE SAME FIXTURE BOUNDS FROM ABOVE AT ITS UPPER END, the other half of the interval's contract and
// the half the ceiling accessor reads. 16001 W exceeds the published maximum and is refused on the
// operator's own sentence; 15999 W is NOT refused, and not-refused is undetermined rather than
// admitted. A carrier that ceilinged at the LOWER end would refuse 2001 W and look entirely reasonable
// doing it, so that conjunct is the one that catches the transposition.
test fn w_a_real_interval_bounds_from_above_at_its_upper_end() -> Bool {
  outside_maximum(d: real_interval_fixture, requested: AirCooling, required: 16001)
    && !outside_maximum(d: real_interval_fixture, requested: AirCooling, required: 15999)
    && !outside_maximum(d: real_interval_fixture, requested: AirCooling, required: 2001)
}

// AN AVERAGE BOUNDS NOTHING IN EITHER DIRECTION, EXECUTED RATHER THAN ASSERTED IN PROSE. The carrier's
// annotation claims no operation consumes this arm; this is the discriminating input for that claim.
//
// 1 W IS THE CONJUNCT THAT MATTERS. It sits far below the published 3 kW average, so an implementation
// reading an average as a floor - the single most tempting misreading, since half the cabinets do
// exceed it - would cover it, and this reds. The ceiling side is asserted at an absurd requirement for
// the same reason `w_a_marketed_floor_yields_no_ceiling` uses 999999: an absent ceiling refuses nothing
// at all, including the impossible, which is what separates it from a generous one.
//
// The fourth conjunct keeps this from being satisfiable by breaking the air path generally.
test fn w_a_published_average_supports_no_bound_in_either_direction() -> Bool {
  !supports_from_below(d: published_average_fixture, requested: AirCooling, required: 1)
    && !supports_from_below(d: published_average_fixture, requested: AirCooling, required: 3000)
    && !outside_maximum(d: published_average_fixture, requested: AirCooling, required: 999999)
    && bounds_above(d: air_labelled_cap_fixture, requested: AirCooling)}

// ============================================================================================
// PENNSYLVANIA, RE-KEYED ONTO THE CARRIER RATHER THAN TRANSLATED CALL-FOR-CALL. These five witnesses
// landed on main while this branch was open and every one of them called an accessor this branch
// deletes - `established_watts`, `has_ceiling`, `ceiling_refuses_at` in their air-baked forms. Git
// merged both sides with NO CONFLICT MARKERS in the ranges concerned: one side removed definitions,
// the other side kept calling them, and the edits were nowhere near each other. A textual merge
// cannot see that by construction, and neither can a brace count, an orphan scan or a marker grep.
//
// The check that found it is keen-newt-324's and generalises: AFTER ANY MERGE, FOR EACH NAME YOUR
// BRANCH DELETED, GREP FOR A DEFINITION AND FOR CALLS. def=0 with calls>0 is the defect; def=0
// calls=0 is clean; def>0 is your deletion being reverted. Run on this branch it printed exactly one
// stranded module outside the four this PR edits - netrality - plus these five witnesses.
// ============================================================================================

// PHILADELPHIA PUBLISHES ONE CABINET DENSITY, IT IS A CEILING RATHER THAN A READING, AND NO MEDIUM
// REQUEST REACHES IT. Netrality's page says "Cabinet density up to 30kW" - a marketed maximum - so it
// bounds from above and establishes nothing about what any cabinet supplies. The original witness
// asserted `established_watts == 30000`, which read the ceiling as a measurement; that accessor is
// deleted precisely because no arm can honestly answer it.
//
// THE MEDIUM CHANGED WITH THE MIGRATION AND THAT COSTS THE SCREEN, NOT THE ROW. The page names no
// cooling medium, so the row is CoolingMediumUnspecified. An air request does not return it - the
// pre-migration row DID answer that question, off an inference from the absence of a liquid figure,
// and losing that answer is the whole point of the coordinate. Nor is "unspecified" requestable at all
// - it is not a `CoolingMedium` and has no constructor on the request side - so this figure is
// screenable at NO medium: the conjuncts assert that both requestable media refuse for want of a
// figure, and that neither bounds it from above. That is a CONSTRUCTION argument rather than a guarded
// one, which is why no witness is cited here for it; a citation would read as coverage already
// enrolled, and no Accepted program can read an annotation.
//
// THE THIRD CONJUNCT IS WHY THAT IS A SCREEN LOSS AND NOT A DATA LOSS. The figure is still inventoried,
// verbatim-sourced and countable by a coverage roster; only the medium-keyed question has no answer.
test fn w_philadelphia_publishes_one_ceiling_reachable_at_no_medium() -> Bool {
  !has_figure_for(d: netrality_401_n_broad_density, requested: AirCooling)
    && !has_figure_for(d: netrality_401_n_broad_density, requested: LiquidCooling)
    && !bounds_above(d: netrality_401_n_broad_density, requested: AirCooling)
    && !bounds_above(d: netrality_401_n_broad_density, requested: LiquidCooling)
    && density_claim_figures(d: netrality_401_n_broad_density).length() == 1
    && all(density_claim_figures(d: netrality_401_n_broad_density), f => medium_standing_eq(a: f.medium, b: CoolingMediumUnspecified))
}

// EVERY OTHER PENNSYLVANIA ROW PUBLISHED NOTHING, ASSERTED AS EMPTY INVENTORY RATHER THAN AS A
// SENTINEL. The original folded absence into `established_watts == -1`, an in-band integer standing
// for "no reading" on the same axis as real readings. Empty inventory is the same fact with no
// sentinel to collide: a claim nobody read has no figures, and over a structurally non-empty carrier
// that is exactly the unread arm.
test fn w_every_other_pennsylvania_density_published_nothing() -> Bool {
  density_claim_figures(d: tierpoint_philadelphia_density).length() == 0
    && density_claim_figures(d: tierpoint_allentown_density).length() == 0
    && density_claim_figures(d: tierpoint_bethlehem_density).length() == 0
    && density_claim_figures(d: tierpoint_lehigh_valley_density).length() == 0
    && density_claim_figures(d: tierpoint_valley_forge_density).length() == 0
    && density_claim_figures(d: h5_philadelphia_density).length() == 0
    && density_claim_figures(d: databank_phl1_density).length() == 0
    && density_claim_figures(d: lightwave_philadelphia_density).length() == 0
    && density_claim_figures(d: flexential_philadelphia_collegeville_density).length() == 0
    && density_claim_figures(d: five_9s_allentown_density).length() == 0
    && density_claim_figures(d: three_sixty_five_philadelphia_density).length() == 0
    && density_claim_figures(d: three_sixty_five_philadelphia_university_city_density).length() == 0
}

// AN UNREAD ROW BOUNDS NOTHING, INCLUDING THE ABSURD. 1,000,000 W is the discriminating requirement
// for the same reason 999999 is elsewhere in this file: an absent ceiling refuses nothing at all,
// which is what separates it from a generous one. Asked on the medium the pages do not state, so a
// carrier that answered unspecified requests would red here too.
test fn w_unread_pennsylvania_densities_have_no_ceiling() -> Bool {
  !outside_maximum(d: h5_philadelphia_density, requested: AirCooling, required: 1000000)
    && !outside_maximum(d: five_9s_allentown_density, requested: AirCooling, required: 1000000)
    && claim_unread(d: h5_philadelphia_density, requested: AirCooling, required: 1000000)
    && !has_figure_for(d: h5_philadelphia_density, requested: AirCooling)
}

// A REVERSED RANGE, WHICH IS THE ONLY WAY TO REACH QuantityUnreadable AND THEREFORE THE POSITIVE
// CONTROL ON THE INTERVAL WALL. `marketed_real_interval` is the sole route to the real-interval arm,
// its payload is std.interval's sole_constructor carrier, and a reversed pair cannot become one - so
// this fixture is what proves the mint refuses rather than silently swapping the endpoints into
// order. A swap would be the absorbing fallback: a plausible 2 kW-16 kW range where the page said
// something this carrier cannot read.
data reversed_interval_fixture: CabinetDensityClaim = DensityPublished {
  figures: FreeSemigroup {
    head: PublishedDensityFigure {
      medium: CoolingMediumPublished { medium: AirCooling },
      quantity: marketed_real_interval(lower: watt(count: 16000), upper: watt(count: 2000)),
      wording: "witness fixture: endpoints in the wrong order",
      citation: "witness fixture. No operator publishes a reversed range; this exists to prove the mint refuses one, which is not observable from any live row",
      verification: WordingVerbatim {
        retrieval: "Fixture, verbatim by construction.",
      },
    },
    tail: [],
  },
}

// TWO SUMMARIZED FIGURES, WHICH IS THE ONLY SHAPE THAT DISTINGUISHES "ALL THE REMEDIES" FROM "THE
// FIRST ONE". With one summarized figure both answers agree, so a claim carrying two is the
// discriminating input for the verification fold - and no live row has two, because the census has
// not yet read an operator publishing separate air and liquid figures under a summarizing tool.
data two_summarized_figures_fixture: CabinetDensityClaim = DensityPublished {
  figures: FreeSemigroup {
    head: PublishedDensityFigure {
      medium: CoolingMediumPublished { medium: AirCooling },
      quantity: CapabilityAtLeast { lower: PublishedRealPower { power: watt(count: 20000) } },
      wording: "witness fixture: air figure read through a summarizing tool",
      citation: "witness fixture for the verification fold; both figures are summarized so the fold has two remedies to return",
      verification: WordingSummarized {
        retrieval: "Fixture: summarized retrieval, air figure.",
        discharge: "Re-fetch the air specification page as raw bytes.",
      },
    },
    tail: [
      PublishedDensityFigure {
        medium: CoolingMediumPublished { medium: LiquidCooling },
        quantity: CapabilityAtLeast { lower: PublishedRealPower { power: watt(count: 80000) } },
        wording: "witness fixture: liquid figure read through a summarizing tool",
        citation: "witness fixture for the verification fold; the SECOND remedy, which a first-wins fold would never surface",
        verification: WordingSummarized {
          retrieval: "Fixture: summarized retrieval, liquid figure.",
          discharge: "Request the liquid-cooling addendum from the operator.",
        },
      },
    ],
  },
}

// GRAIN AND DENSITY MOVE INDEPENDENTLY ACROSS THIS REGION, which is what makes it worth quoting at
// all. TierPoint sells single cabinets at five sites and publishes no density anywhere; DataBank's
// Philadelphia suite publishes neither; Netrality publishes both. A consumer reading grain off
// density, in either direction, breaks here.
test fn w_pennsylvania_grain_is_independent_of_density() -> Bool {
  grain_admits_single_cabinet(g: netrality_401_n_broad_retail_grain)
    && grain_admits_single_cabinet(g: tierpoint_philadelphia_retail_grain)
    && grain_admits_single_cabinet(g: tierpoint_allentown_retail_grain)
    && grain_admits_single_cabinet(g: tierpoint_bethlehem_retail_grain)
    && grain_admits_single_cabinet(g: tierpoint_lehigh_valley_retail_grain)
    && grain_admits_single_cabinet(g: tierpoint_valley_forge_retail_grain)
    && grain_admits_single_cabinet(g: h5_philadelphia_retail_grain)
    && density_claim_figures(d: tierpoint_philadelphia_density).length() == 0
    && !grain_admits_single_cabinet(g: databank_phl1_retail_grain)
    && !grain_admits_single_cabinet(g: lightwave_philadelphia_retail_grain)
    && !grain_admits_single_cabinet(g: flexential_philadelphia_collegeville_retail_grain)
    && !grain_admits_single_cabinet(g: five_9s_allentown_retail_grain)
    && !grain_admits_single_cabinet(g: three_sixty_five_philadelphia_retail_grain)
}

// THE REGION'S OWN COVERAGE RECEIPT, FOLDED. Review 62827 found the Pennsylvania survey landing in
// extdeps with no row in the observing layer, which is the case the coverage module exists to
// prevent: a region somebody surveyed rendering identically to one nobody has opened. This is the
// count RELATION, not the count - the literal is a hand-authored number a witness cannot re-derive,
// and a test repeating it would prove only that the file was not edited.
test fn w_the_pennsylvania_survey_is_a_recorded_measurement() -> Bool {
  facility_count_or_sentinel(c: pa_philadelphia_and_lehigh_valley) > 0
    && density_reads_never_exceed_facilities(c: pa_philadelphia_and_lehigh_valley)
}

// ============================================================================================
// THE FOUR CAPABILITIES THE HEAD REVIEW ASKED FOR, EACH WITH THE INPUT THAT DISCRIMINATES IT.
// ============================================================================================

// A REVERSED RANGE REFUSES AT THE MINT AND REACHES A CONSUMER AS AN UNREADABLE QUANTITY. This is the
// positive control on consuming std.interval rather than re-declaring endpoint pairs: the reversed
// figure is neither covered nor outside nor merely non-bounding, it is the arm that says the page's
// numbers formed no range. THE SECOND AND THIRD CONJUNCTS ARE WHAT MAKE IT A WALL RATHER THAN A
// LABEL - an unreadable quantity must never admit and must never refuse, in either direction, at any
// requirement. A mint that silently swapped the endpoints would make the first conjunct red and the
// well-ordered twin below still green, so the two cannot be satisfied by one another.
test fn w_a_reversed_range_is_unreadable_and_bounds_in_neither_direction() -> Bool {
  quantity_is_unreadable(d: reversed_interval_fixture, requested: AirCooling, required: 5000)
    && !supports_from_below(d: reversed_interval_fixture, requested: AirCooling, required: 1)
    && !bounds_above(d: reversed_interval_fixture, requested: AirCooling)
    && covered_by_range_floor(d: real_interval_fixture, requested: AirCooling, required: 2000)
}

// AN UNREAD CLAIM AND A PUBLISHED CLAIM SILENT ON THE MEDIUM ARE DIFFERENT ANSWERS. They were one
// arm until this change: `FigureAbsent` was returned both when nobody had read the operator's page
// and when a read page simply had no figure for the medium asked about. The second carries a remedy
// the first does not - the row names WHAT MUST BE READ - and fusing them discarded that obligation at
// the first seam it crossed. A census that cannot tell "we looked and the page is silent on liquid"
// from "nobody has looked" cannot rank its own remaining work.
//
// DataBank LGA4 published air and liquid, so asking it for liquid finds a figure; Iron Mountain's
// WPA-1 is DensityUnread; and Iron Mountain's NJE-1 is published but names no medium, which is the
// row that separates the two failure arms with nothing else varying.
test fn w_an_unread_claim_is_not_a_silent_one() -> Bool {
  claim_unread(d: iron_mountain_wpa1_density, requested: AirCooling, required: 5000)
    && !medium_absent(d: iron_mountain_wpa1_density, requested: AirCooling, required: 5000)
    && medium_absent(d: iron_mountain_nje1_density, requested: AirCooling, required: 5000)
    && !claim_unread(d: iron_mountain_nje1_density, requested: AirCooling, required: 5000)
    && has_figure_for(d: databank_lga4_density, requested: LiquidCooling)
}

// MARKETING EXCLUDES AND NEVER ADMITS, AND THE TWO ANSWERS NO LONGER SHARE A NAME. An earlier cut
// returned one bare affirmative from both questions, so "the published floor covers 27.3 kW" and "the
// requirement is outside the published maximum" were THE SAME VALUE; once stored, the proposition was
// gone and reading an exclusion as coverage admitted a cabinet the page had ruled out.
//
// The arms are disjoint at figures that answer BOTH questions on live rows rather than contrived
// ones: DataBank's air floor covers 27.3 kW and never excludes, and the air-labelled cap fixture
// excludes above 30 kW and covers NOTHING - not even 1 W, because "up to 30kW" is a product statement
// and not a guarantee that any cabinet is available at it.
test fn w_a_marketed_maximum_excludes_and_covers_nothing() -> Bool {
  outside_maximum(d: air_labelled_cap_fixture, requested: AirCooling, required: 30001)
    && !supports_from_below(d: air_labelled_cap_fixture, requested: AirCooling, required: 1)
    && covered_by_floor(d: databank_lga4_density, requested: AirCooling, required: 27300)
    && !outside_maximum(d: databank_lga4_density, requested: AirCooling, required: 27300)
}

// VERIFICATION SURVIVES THE SCREEN BOUNDARY, WHICH IS WHERE IT USED TO BE DISCARDED. The standing
// carries the figure, so a caller reaches the verification grade of the exact reading it is acting
// on. Before this, a summarized-wording figure and a raw-byte-verbatim figure produced identical
// answers at identical requirements and nothing downstream could tell them apart.
//
// THE TWO SUBJECTS ARE MATCHED ON EVERYTHING BUT VERIFICATION. Both are air-labelled published
// claims that answer the same requirement in the same arm; only the verification standing differs,
// so a boundary that dropped it would make these two conjuncts agree.
test fn w_verification_standing_survives_the_screen() -> Bool {
  covered_by_floor(d: databank_lga4_density, requested: AirCooling, required: 27300)
    && standing_is_verbatim(d: databank_lga4_density, requested: AirCooling, required: 27300)
    && covered_by_floor(d: two_summarized_figures_fixture, requested: AirCooling, required: 15000)
    && !standing_is_verbatim(d: two_summarized_figures_fixture, requested: AirCooling, required: 15000)
}

// EVERY UNVERIFIED FIGURE IS RETURNED, NOT THE FIRST. One summarized member settles the VERDICT, and
// an earlier fold used that to justify returning one remedy. The verdict is not the whole answer: a
// claim with two summarized figures has two retrieval routes to run, and handing back one tells a
// reader how to verify one figure while leaving the population it belongs to unstated - the missing
// work invisible rather than pending.
//
// THE COUNT IS THE CONJUNCT THAT DISCRIMINATES. A first-wins fold returns a one-element population on
// this fixture and every other assertion here still passes, so length is the only thing that can see
// the narrowing. Iron Mountain has exactly one summarized figure, which is why it CANNOT serve as
// this control and is asserted separately as the one-remedy case.
test fn w_the_verification_fold_returns_every_remedy() -> Bool {
  unverified_count(d: two_summarized_figures_fixture) == 2
    && unverified_count(d: iron_mountain_nje1_density) == 1
    && unverified_count(d: databank_lga4_density) == 0
    && wording_standing_is(d: two_summarized_figures_fixture, expect_verified: false, expect_summarized: true)
}
