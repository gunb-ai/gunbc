module test.claim.posix_principal_allocation_witness

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// CONTROLS OVER THE NEW ARMS, authored because their absence is what made the previous attempt
// unverifiable. That attempt reported 25/25 passing witnesses as validation of a new account model
// while every one of those witnesses enumerated only the four legacy principals -- so the new rows
// were never evaluated, and the probe spellings they carried would have FAILED the module's own
// invariant had anything called it. A test population that cannot reach the code under test is not
// weak evidence; it is no evidence, and it reads exactly like success.
data posix_principal_allocation_control_note: String = "Every control here names an arm the legacy witnesses cannot reach: the two new semantic principals, the allocation standing, and the grounding outcome. The central claim under test is that one fleet principal may wear different host-local labels and different numeric identities on two hosts while remaining one principal with one policy -- and that nothing can present an unallocated or unobserved account as grounded."

data spark5: HostIdentity = "srv5" as HostIdentity
data spark6: HostIdentity = "srv6" as HostIdentity

fn occurrence(host: HostIdentity, key: FleetPosixAccountKey) -> PosixAccountOccurrence {
  PosixAccountOccurrence { host: host, principal: key }
}

// Two DELIBERATELY DIFFERENT arbitrary labels and two different numeric identities for the SAME
// semantic principal. The words carry no role, host, product or location -- that is the property
// under test, and any code that assumes a global static username fails against these immediately.
fn alloc(host: HostIdentity, name: NonEmptyStr, uid: Int) -> PosixAccountAllocation {
  PosixAccountAllocation {
    occurrence: occurrence(host: host, key: FleetAccountAutomation),
    local_name: name,
    uid: uid,
    gid: uid,
    domain: HostLocalIdentityDomain { host: host },
    name_scheme: "arbitrary-word-v1" as NonEmptyStr,
    name_attempt: 0,
  }
}

fn observed(a: PosixAccountAllocation, name: NonEmptyStr, uid: Int) -> PosixAccountObservation {
  PosixAccountObservation {
    allocation: a,
    observed_user: PosixUser { name: name, uid: uid, gid: uid },
  }
}

fn grounded_name(o: GroundedPosixPrincipalOutcome) -> NonEmptyStr? {
  match o {
    PrincipalGrounded { principal: p } => Present { value: p.posix.name }
    PrincipalUnallocated => none
    PrincipalUnobserved => none
    PrincipalDrifted { causes: _ } => none
  }
}


fn outcome_is_drift(o: GroundedPosixPrincipalOutcome) -> Bool {
  match o {
    PrincipalDrifted { causes: c } => c.length() > 0
    PrincipalGrounded { principal: _ } => false
    PrincipalUnallocated => false
    PrincipalUnobserved => false
  }
}

fn requirements_forbid_domain_meaning(r: NameRequirements) -> Bool {
  match r.semantic_encoding {
    NoDomainMeaning => true
    MnemonicOnly => false
    MeaningRequired { authority: _ } => false
  }
}

fn requirements_are_independent_per_occurrence(r: NameRequirements) -> Bool {
  match r.uniformity {
    IndependentPerOccurrence => true
    EqualWithinScope { scope: _ } => false
  }
}

// CONTROL 1 -- one principal, two hosts, different labels AND different numeric identities, and it
// is still one principal with one policy. This is the whole decomposition in a single claim: the
// label and the uid are host-local allocations, the policy is the principal.
test fn witness_one_principal_wears_different_local_names_and_uids() -> Bool {
  let a5 = alloc(host: spark5, name: "lumen" as NonEmptyStr, uid: 1500)
  let a6 = alloc(host: spark6, name: "cobalt" as NonEmptyStr, uid: 1732)
  let g5 = ground_posix_principal(
    intent: fleet_principal_intent(key: FleetAccountAutomation),
    standing: AccountAllocated { allocation: a5 },
    observation: Present { value: observed(a: a5, name: "lumen" as NonEmptyStr, uid: 1500) },
  )
  let g6 = ground_posix_principal(
    intent: fleet_principal_intent(key: FleetAccountAutomation),
    standing: AccountAllocated { allocation: a6 },
    observation: Present { value: observed(a: a6, name: "cobalt" as NonEmptyStr, uid: 1732) },
  )
  let n5 = match grounded_name(o: g5) { Present { value: v } => v, Absent => "none" as NonEmptyStr }
  let n6 = match grounded_name(o: g6) { Present { value: v } => v, Absent => "none" as NonEmptyStr }
  // Different labels, different numbers, same principal. Both sides must actually have GROUNDED --
  // asserted explicitly, because two Absent answers would also compare unequal to nothing and the
  // claim would pass while proving the opposite of what it says.
  let both_grounded = n5 != "none" as NonEmptyStr && n6 != "none" as NonEmptyStr
  let same_principal = a5.occurrence.principal == a6.occurrence.principal
  both_grounded && n5 != n6 && a5.uid != a6.uid && same_principal
}

// CONTROL 2 -- an unallocated principal cannot be grounded. This is the wall replacing the reverted
// commit, which presented a desired account as a GroundedPosixPrincipal by authoring a name and uid
// for it. Nothing here can render useradd, User=, a home path, sudoers or authorized_keys.
test fn witness_unallocated_principal_cannot_ground() -> Bool {
  let o = ground_posix_principal(
    intent: fleet_principal_intent(key: FleetAccountAutomation),
    standing: spark_automation_allocation_standing(host: spark5),
    observation: none,
  )
  match o {
    PrincipalUnallocated => true
    PrincipalGrounded { principal: _ } => false
    PrincipalUnobserved => false
    PrincipalDrifted { causes: _ } => false
  }
}

// CONTROL 3 -- allocated but never observed is its OWN state, distinct from unallocated. An
// Optional return would have collapsed these two, and they have different remedies: one needs an
// allocation decision, the other needs the apply to actually run.
test fn witness_allocated_but_unobserved_is_its_own_state() -> Bool {
  let a = alloc(host: spark5, name: "lumen" as NonEmptyStr, uid: 1500)
  match ground_posix_principal(
    intent: fleet_principal_intent(key: FleetAccountAutomation),
    standing: AccountAllocated { allocation: a },
    observation: none,
  ) {
    PrincipalUnobserved => true
    PrincipalUnallocated => false
    PrincipalGrounded { principal: _ } => false
    PrincipalDrifted { causes: _ } => false
  }
}

// CONTROL 4 -- an observation that contradicts the allocation is DRIFT carrying both sides, never a
// silent acceptance and never rounded to absence. Two shapes: the label differs, and the number
// differs. The uid case matters most, because an inode records the number.
test fn witness_observation_contradicting_allocation_is_drift() -> Bool {
  let a = alloc(host: spark5, name: "lumen" as NonEmptyStr, uid: 1500)
  let name_drift = ground_posix_principal(
    intent: fleet_principal_intent(key: FleetAccountAutomation),
    standing: AccountAllocated { allocation: a },
    observation: Present { value: observed(a: a, name: "somethingelse" as NonEmptyStr, uid: 1500) },
  )
  let uid_drift = ground_posix_principal(
    intent: fleet_principal_intent(key: FleetAccountAutomation),
    standing: AccountAllocated { allocation: a },
    observation: Present { value: observed(a: a, name: "lumen" as NonEmptyStr, uid: 1999) },
  )
  outcome_is_drift(o: name_drift) && outcome_is_drift(o: uid_drift)
}

// CONTROL 5 -- the same label text on two different hosts does NOT merge the accounts. Identity is
// the occurrence, not the spelling; a name is a host-local handle and nothing more.
test fn witness_same_label_on_two_hosts_does_not_merge_identities() -> Bool {
  let a5 = alloc(host: spark5, name: "lumen" as NonEmptyStr, uid: 1500)
  let a6 = alloc(host: spark6, name: "lumen" as NonEmptyStr, uid: 1500)
  // identical label AND identical number, still two distinct occurrences
  a5.local_name == a6.local_name
    && a5.uid == a6.uid
    && a5.occurrence.host != a6.occurrence.host
}

// CONTROL 6 -- the service identity holds NO privilege, and the human principal is structurally
// marked human-only. The second half is the live fusion this split exists to end: automation had
// been resolving through the human principal.
test fn witness_service_has_no_privilege_and_human_is_marked_human_only() -> Bool {
  let svc = fleet_principal_intent(key: FleetAccountInferenceService)
  let human = fleet_principal_intent(key: FleetAccountOperator)
  let automation = fleet_principal_intent(key: FleetAccountAutomation)
  let is_human_only = match human.login_policy {
    HumanAccessOnly => true
    KeyOnlyAutomation => false
    NoLoginServiceIdentity => false
    LegacyHostAccount => false
  }
  let is_key_only = match automation.login_policy {
    KeyOnlyAutomation => true
    HumanAccessOnly => false
    NoLoginServiceIdentity => false
    LegacyHostAccount => false
  }
  svc.sudo_grants.length() == 0 && is_human_only && is_key_only
}

// CONTROL 7 -- the automation and service labels are required to carry NO domain meaning, while the
// human label is permitted a mnemonic. Asserted on the requirements rather than on any string, so
// it stays true whatever words a later allocation picks.
test fn witness_name_requirements_forbid_domain_meaning_for_machine_principals() -> Bool {
  requirements_forbid_domain_meaning(r: fleet_principal_intent(key: FleetAccountAutomation).name_requirements)
    && requirements_forbid_domain_meaning(r: fleet_principal_intent(key: FleetAccountInferenceService).name_requirements)
    && requirements_are_independent_per_occurrence(r: fleet_principal_intent(key: FleetAccountAutomation).name_requirements)
    && !requirements_forbid_domain_meaning(r: fleet_principal_intent(key: FleetAccountOperator).name_requirements)
}
