module test.claim.ci_yaml_parse_witness


data ci_yml_path: String = ".github/workflows/ci.yml"
data expected_parse_scratch: String = "/tmp/gunbc_ci_yml_expected_parse.yml"

func ci_yaml_parse_witness() -> std.process.ProcessExit {
  let committed = v2.extdeps.file_system.Filesystem.Read(path: ci_yml_path)
  let drift_ok = committed.success && !gunbc.ci_yaml_emit.ci_yml_drifted(committed: committed.content)
  let committed_parse = gunbc.ci_yaml_validate.ci_yml_parses(path: ci_yml_path)
  let w = v2.extdeps.file_system.Filesystem.Write(path: expected_parse_scratch, content: gunbc.ci_yaml_emit.expected_ci_yml())
  let expected_parse = w.success && gunbc.ci_yaml_validate.ci_yml_parses(path: expected_parse_scratch)
  return if drift_ok && committed_parse && expected_parse {
    ExitSuccess
  } else {
    std.process.exit_failure(reason: "ci.yml drift and/or YAML parse check failed")
  }
}
