module test.claim.string_length_char_count_witness

// CONTRACT: `.length()`, `.count()` and `.size()` on a String report the
// CHARACTER (codepoint) count, never the UTF-8 BYTE count. All three spellings
// are one arm -- `method_call.length { "length" | "count" | "size" }` in
// `v1_interpreter.rs`, registered as three authored spellings in
// `gunbc.v1_interpreter_primitive_surface` -- so they share a single
// implementation and a single regression exposure, and this witness covers all
// three rather than the two an earlier revision of this header claimed.
//
// The discriminating risk is a fast-path arm that reads a byte length: a naive
// `Value::Str(s) => Some(s.len())` (Rust byte length) would answer 3 for the
// single-codepoint CJK string below, not 1. Any future O(1) fast path -- an
// ASCII-flag read included -- must keep answering the character count on
// multibyte input, and these cases go red if it does not.

test fn ascii_string_length_is_char_count() -> Bool {
  "hello".length() == 5
}

// "\u{ef}" (lowercase i with diaeresis) encodes as 2 bytes in UTF-8.
// Byte length would be 2; character length must be 1.
test fn multibyte_two_byte_codepoint_length_is_one() -> Bool {
  "\u{ef}".length() == 1
}

// "\u{4e2d}" (CJK character) encodes as 3 bytes in UTF-8.
// Byte length would be 3; character length must be 1.
test fn multibyte_three_byte_codepoint_length_is_one() -> Bool {
  "\u{4e2d}".length() == 1
}

// "\u{1f600}" (an emoji) encodes as 4 bytes in UTF-8.
// Byte length would be 4; character length must be 1.
test fn multibyte_four_byte_codepoint_length_is_one() -> Bool {
  "\u{1f600}".length() == 1
}

// "na\u{ef}ve" is 5 characters but 6 UTF-8 bytes (the \u{ef} costs 2 bytes).
// Byte length would be 6; character length must be 5.
test fn mixed_ascii_and_multibyte_length_counts_chars_not_bytes() -> Bool {
  "na\u{ef}ve".length() == 5
}

test fn multibyte_string_count_matches_length() -> Bool {
  "\u{4e2d}\u{6587}".count() == 2
}

// `.size()` is the third authored spelling of the same arm. It carries the same
// byte-vs-character exposure, so it gets the same discriminating multibyte input
// rather than an ASCII-only case that a byte-length arm would also pass.
test fn multibyte_string_size_is_char_count() -> Bool {
  "\u{4e2d}\u{6587}".size() == 2
}

test fn mixed_ascii_and_multibyte_size_counts_chars_not_bytes() -> Bool {
  "na\u{ef}ve".size() == 5
}
