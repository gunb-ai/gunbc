module test.claim.reconstruction_door_fixture_probe


// Reconstruction-door probe (audit queue item 20a, stored-fixture replay; was labelled "ARM 1"). Declares a service
// whose `id` output is a refined `NonEmptyStr`. Run under `--record` once,
// then run each `witness_*` function under `--hermetic` against the SAME
// on-disk fixture, tampered per case as documented in
// docs/plans/compiler-guarantee-recovery-gap-analysis.md item 20. This file
// alone is not self-verifying: the tamper step happens on the recorded JSON
// file between runs, outside this module, per the doc's exact reproduction
// steps.

service DoorProbe {
  operation Fetch {
    input {}
    output { id: std.types.NonEmptyStr from "stdout" }
    readonly
    transport shell { argv: ["printf", "%s", "positive-control"] }
    exit {
      0 => Unit
      nonzero => String "unreachable: probe command always exits 0"
    }
  }
}

// Case 1 (positive control): recorded response is untampered.
func witness_id_equals_positive_control() -> Bool {
  DoorProbe.Fetch().id == "positive-control"
}

// Case 2 (predicate bypass, no `__type` tamper): fixture's `id.value` field
// is overwritten to "" before hermetic replay, violating NonEmptyStr's
// `non_empty` predicate.
func witness_id_equals_empty() -> Bool {
  DoorProbe.Fetch().id == ""
}

// Case 3 (undeclared-type fabrication): fixture's `response.__type` is
// overwritten to a name with no corresponding declaration anywhere in the
// source roots, `id.value` overwritten to "whatever-value".
func witness_id_equals_whatever() -> Bool {
  DoorProbe.Fetch().id == "whatever-value"
}

// Case 4 (Variant-arm fabrication): fixture's `response` is replaced wholesale
// with a `__tag: "Variant"` shape naming a fabricated `__type`/`__variant`
// pair, carrying an `id` field of "variant-value".
func witness_id_equals_variant_value() -> Bool {
  DoorProbe.Fetch().id == "variant-value"
}
