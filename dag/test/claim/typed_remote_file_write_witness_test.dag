module test.claim.typed_remote_file_write_witness

import std.types { Bool, String, NonEmptyStr, FilePath }
import extdeps.filesystem.filesystem_io { Filesystem }
import gunbc.file_access { FileTreeScope, path_within_file_tree_scope }
import gunbc.fleet_known_hosts_anchor { SshTarget, portable_remote_words }
import gunbc.typed_remote_file_write {
  TypedRemoteFileWrite,
  TypedRemoteFileWriteAdmitted,
  TypedRemoteFileWriteAdmissionRefused,
  typed_remote_file_write_seal,
  typed_remote_file_write_stdin_payload,
  typed_remote_file_write_remote_argv,
  typed_remote_file_write_argv_has_no_shell_body,
  typed_remote_file_write_content_digest_hex,
  typed_remote_file_write_tee_command,
  typed_remote_file_write_execute_preflight_outcome,
}
import gunbc.spark_serving_runtime_receipt { spark_serving_executor_home }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data witness_tmp_scope: FileTreeScope = FileTreeScope {
  root_path: "/tmp" as NonEmptyStr,
}

data witness_executor_home_scope: FileTreeScope = FileTreeScope {
  root_path: spark_serving_executor_home as NonEmptyStr,
}

data witness_metachar_payload: String = "alpha beta\ttab $dollar \"dq\"\n; rm -rf /"

data witness_path_outside_prefix: String = "/etc/passwd"

data witness_non_portable_path: String = "/tmp/path with spaces/unit"

data witness_dotdot_escape_path: String = "/tmp/../etc/passwd"

data witness_executor_home_substring_trap_path: String = "/home/gunbc-automation-evil/.config/systemd/user/gunbc-spark-serving.service"

data witness_preflight_ssh_target: SshTarget = SshTarget {
  endpoint: "srv-test.example" as NonEmptyStr,
  principal: "gunbc-automation" as NonEmptyStr,
}

test fn w_path_outside_prefix_refused() -> Bool {
  match typed_remote_file_write_seal(
    path: witness_path_outside_prefix as FilePath,
    content: "payload" as String,
    allowed_scope: witness_tmp_scope,
  ) {
    TypedRemoteFileWriteAdmissionRefused { cause: _ } => true
    TypedRemoteFileWriteAdmitted { write: _ } => false
  }
}

test fn w_dotdot_escape_refused() -> Bool {
  !path_within_file_tree_scope(
    scope: witness_tmp_scope,
    path: witness_dotdot_escape_path as NonEmptyStr,
  )
    && match typed_remote_file_write_seal(
      path: witness_dotdot_escape_path as FilePath,
      content: "payload" as String,
      allowed_scope: witness_tmp_scope,
    ) {
      TypedRemoteFileWriteAdmissionRefused { cause: _ } => true
      TypedRemoteFileWriteAdmitted { write: _ } => false
    }
}

test fn w_executor_home_substring_trap_refused() -> Bool {
  !path_within_file_tree_scope(
    scope: witness_executor_home_scope,
    path: witness_executor_home_substring_trap_path as NonEmptyStr,
  )
    && match typed_remote_file_write_seal(
      path: witness_executor_home_substring_trap_path as FilePath,
      content: "payload" as String,
      allowed_scope: witness_executor_home_scope,
    ) {
      TypedRemoteFileWriteAdmissionRefused { cause: _ } => true
      TypedRemoteFileWriteAdmitted { write: _ } => false
    }
}

test fn w_non_portable_path_refused() -> Bool {
  match typed_remote_file_write_seal(
    path: witness_non_portable_path as FilePath,
    content: "payload" as String,
    allowed_scope: witness_tmp_scope,
  ) {
    TypedRemoteFileWriteAdmissionRefused { cause: _ } => true
    TypedRemoteFileWriteAdmitted { write: _ } => false
  }
}

test fn w_metachar_payload_seals_without_interpretation() -> Bool {
  match typed_remote_file_write_seal(
    path: "/tmp/gunbc-trfw-metachar" as FilePath,
    content: witness_metachar_payload,
    allowed_scope: witness_tmp_scope,
  ) {
    TypedRemoteFileWriteAdmitted { write: w } => w.content == witness_metachar_payload
    TypedRemoteFileWriteAdmissionRefused { cause: _ } => false
  }
}

test fn w_remote_argv_is_tee_and_path_only() -> Bool {
  match typed_remote_file_write_seal(
    path: "/tmp/gunbc-trfw-argv" as FilePath,
    content: "x" as String,
    allowed_scope: witness_tmp_scope,
  ) {
    TypedRemoteFileWriteAdmitted { write: w } =>
      typed_remote_file_write_remote_argv(write: w)
        == [typed_remote_file_write_tee_command, "/tmp/gunbc-trfw-argv"]
        && typed_remote_file_write_argv_has_no_shell_body(
          argv: typed_remote_file_write_remote_argv(write: w),
        )
        && match portable_remote_words(raws: typed_remote_file_write_remote_argv(write: w)) {
          Present { value: _ } => true
          Absent => false
        }
    TypedRemoteFileWriteAdmissionRefused { cause: _ } => false
  }
}

test fn w_non_portable_remote_argv_fails_execute_portable_gate() -> Bool {
  match portable_remote_words(
    raws: [typed_remote_file_write_tee_command, witness_non_portable_path],
  ) {
    Absent => true
    Present { value: _ } => false
  }
}

test fn w_admitted_write_passes_execute_preflight() -> Bool {
  match typed_remote_file_write_seal(
    path: "/tmp/gunbc-trfw-preflight" as FilePath,
    content: witness_metachar_payload,
    allowed_scope: witness_tmp_scope,
  ) {
    TypedRemoteFileWriteAdmitted { write: w } =>
      match typed_remote_file_write_execute_preflight_outcome(
        target: witness_preflight_ssh_target,
        write: w,
      ) {
        Absent => true
        Present { value: _ } => false
      }
    TypedRemoteFileWriteAdmissionRefused { cause: _ } => false
  }
}

test fn w_stdin_payload_is_exact_content_not_transformed() -> Bool {
  match typed_remote_file_write_seal(
    path: "/tmp/gunbc-trfw-stdin" as FilePath,
    content: witness_metachar_payload,
    allowed_scope: witness_tmp_scope,
  ) {
    TypedRemoteFileWriteAdmitted { write: w } =>
      typed_remote_file_write_stdin_payload(write: w) == witness_metachar_payload
    TypedRemoteFileWriteAdmissionRefused { cause: _ } => false
  }
}

test fn w_content_digest_stable_for_same_bytes() -> Bool {
  match typed_remote_file_write_seal(
    path: "/tmp/gunbc-trfw-digest-a" as FilePath,
    content: witness_metachar_payload,
    allowed_scope: witness_tmp_scope,
  ) {
    TypedRemoteFileWriteAdmitted { write: a } =>
      match typed_remote_file_write_seal(
        path: "/tmp/gunbc-trfw-digest-b" as FilePath,
        content: witness_metachar_payload,
        allowed_scope: witness_tmp_scope,
      ) {
        TypedRemoteFileWriteAdmitted { write: b } =>
          typed_remote_file_write_content_digest_hex(write: a)
            == typed_remote_file_write_content_digest_hex(write: b)
        TypedRemoteFileWriteAdmissionRefused { cause: _ } => false
      }
    TypedRemoteFileWriteAdmissionRefused { cause: _ } => false
  }
}

test fn w_executor_home_unit_path_seals_for_spark_layout() -> Bool {
  match typed_remote_file_write_seal(
    path: concat(
      spark_serving_executor_home as String,
      "/.config/systemd/user/gunbc-spark-serving.service",
    ) as FilePath,
    content: "[Unit]\nDescription=test\n" as String,
    allowed_scope: witness_executor_home_scope,
  ) {
    TypedRemoteFileWriteAdmitted { write: _ } => true
    TypedRemoteFileWriteAdmissionRefused { cause: _ } => false
  }
}

func w_local_filesystem_roundtrip_preserves_bytes() -> Bool {
  let dest = "/tmp/gunbc-trfw-roundtrip-bytes" as FilePath
  match typed_remote_file_write_seal(
    path: dest,
    content: witness_metachar_payload,
    allowed_scope: witness_tmp_scope,
  ) {
    TypedRemoteFileWriteAdmissionRefused { cause: _ } => false
    TypedRemoteFileWriteAdmitted { write: w } => {
      let w_out = Filesystem.Write(path: dest as String, content: w.content)
      if !w_out.success {
        false
      } else {
        let read = Filesystem.Read(path: dest as String)
        read.success && read.content == witness_metachar_payload
      }
    }
  }
}

test fn w_local_filesystem_roundtrip_preserves_bytes_holds() -> Bool {
  w_local_filesystem_roundtrip_preserves_bytes()
}
