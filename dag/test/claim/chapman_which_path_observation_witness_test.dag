module test.claim.chapman_which_path_observation_witness_test


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

test fn w_chapman_four_model_comparison_holds() -> Bool {
  chapman_four_model_comparison_holds()
}

test fn w_chapman_all_four_prediction_cells_execute() -> Bool {
  all_four_model_predictions_execute()
    && four_model_cell_prediction(cell: ClassicalPassiveCell) == InterferenceFringeAbsent
    && four_model_cell_prediction(cell: ClassicalDistinguishableCell) == InterferenceFringeAbsent
    && four_model_cell_prediction(cell: CoherentPassiveCell) == InterferenceFringeVisible
    && four_model_cell_prediction(cell: CoherentDistinguishableCell) == InterferenceFringeAbsent
}

test fn w_chapman_cited_rows_match_coherent_not_classical() -> Bool {
  chapman_all_cited_rows_match_coherent_predictions()
    && chapman_not_all_cited_rows_match_classical_predictions()
}

test fn w_chapman_single_axis_insufficient_derivation() -> Bool {
  chapman_composition_axis_insufficient_alone()
    && chapman_disclosure_axis_insufficient_alone()
}

test fn w_chapman_rejects_classical_for_passive_visible_observation() -> Bool {
  chapman_four_model_rejects_classical_for_passive_visible_row(
    row: chapman_no_distinguishable_record_fringes_visible,
  )
}

test fn w_chapman_rejects_coherent_for_fabricated_passive_absent() -> Bool {
  let fabricated = ChapmanWhichPathObservationRow {
    apparatus: chapman_et_al_1995_atom_interferometer,
    which_path_distinguishability_record: DistinguishableWhichPathRecordNotProduced,
    interference_fringe_visibility: InterferenceFringeAbsent,
    grain: EnsembleGrain,
  }
  chapman_four_model_rejects_coherent_for_row(row: fabricated)
}

test fn w_chapman_rejects_coherent_for_fabricated_distinguishable_visible() -> Bool {
  let fabricated = ChapmanWhichPathObservationRow {
    apparatus: chapman_et_al_1995_atom_interferometer,
    which_path_distinguishability_record: DistinguishableWhichPathRecordProduced,
    interference_fringe_visibility: InterferenceFringeVisible,
    grain: EnsembleGrain,
  }
  chapman_four_model_rejects_coherent_for_row(row: fabricated)
}

test fn w_chapman_cited_observations_are_ensemble_grain() -> Bool {
  chapman_cited_observations_are_ensemble_grain()
}

test fn w_chapman_rejects_trial_grain_for_ensemble_gate() -> Bool {
  let trial_grain_row = ChapmanWhichPathObservationRow {
    apparatus: chapman_et_al_1995_atom_interferometer,
    which_path_distinguishability_record: DistinguishableWhichPathRecordNotProduced,
    interference_fringe_visibility: InterferenceFringeVisible,
    grain: TrialGrain,
  }
  !chapman_row_is_ensemble_grain(row: trial_grain_row)
}
