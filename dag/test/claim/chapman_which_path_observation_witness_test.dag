module test.claim.chapman_which_path_observation_witness_test


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

test fn w_chapman_four_model_comparison_holds() -> Bool {
  gunbc.chapman_which_path_observation.chapman_four_model_comparison_holds()
}

test fn w_chapman_all_four_prediction_cells_execute() -> Bool {
  gunbc.physics.which_path_four_model_comparison.all_four_model_predictions_execute()
    && gunbc.physics.which_path_four_model_comparison.four_model_cell_prediction(cell: gunbc.physics.which_path_four_model_comparison.ClassicalPassiveCell) == extdeps.physics.chapman_et_al_1995_atom_interferometer_which_path.InterferenceFringeAbsent
    && gunbc.physics.which_path_four_model_comparison.four_model_cell_prediction(cell: gunbc.physics.which_path_four_model_comparison.ClassicalDistinguishableCell) == extdeps.physics.chapman_et_al_1995_atom_interferometer_which_path.InterferenceFringeAbsent
    && gunbc.physics.which_path_four_model_comparison.four_model_cell_prediction(cell: gunbc.physics.which_path_four_model_comparison.CoherentPassiveCell) == extdeps.physics.chapman_et_al_1995_atom_interferometer_which_path.InterferenceFringeVisible
    && gunbc.physics.which_path_four_model_comparison.four_model_cell_prediction(cell: gunbc.physics.which_path_four_model_comparison.CoherentDistinguishableCell) == extdeps.physics.chapman_et_al_1995_atom_interferometer_which_path.InterferenceFringeAbsent
}

test fn w_chapman_cited_rows_match_coherent_not_classical() -> Bool {
  gunbc.chapman_which_path_observation.chapman_all_cited_rows_match_coherent_predictions()
    && gunbc.chapman_which_path_observation.chapman_not_all_cited_rows_match_classical_predictions()
}

test fn w_chapman_single_axis_insufficient_derivation() -> Bool {
  gunbc.chapman_which_path_observation.chapman_composition_axis_insufficient_alone()
    && gunbc.chapman_which_path_observation.chapman_disclosure_axis_insufficient_alone()
}

test fn w_chapman_rejects_classical_for_passive_visible_observation() -> Bool {
  gunbc.chapman_which_path_observation.chapman_four_model_rejects_classical_for_passive_visible_row(
    row: extdeps.physics.chapman_et_al_1995_atom_interferometer_which_path.chapman_no_distinguishable_record_fringes_visible,
  )
}

test fn w_chapman_rejects_coherent_for_fabricated_passive_absent() -> Bool {
  let fabricated = extdeps.physics.chapman_et_al_1995_atom_interferometer_which_path.ChapmanWhichPathObservationRow {
    apparatus: extdeps.physics.chapman_et_al_1995_atom_interferometer_which_path.chapman_et_al_1995_atom_interferometer,
    which_path_distinguishability_record: extdeps.physics.chapman_et_al_1995_atom_interferometer_which_path.DistinguishableWhichPathRecordNotProduced,
    interference_fringe_visibility: extdeps.physics.chapman_et_al_1995_atom_interferometer_which_path.InterferenceFringeAbsent,
    grain: extdeps.physics.chapman_et_al_1995_atom_interferometer_which_path.EnsembleGrain,
  }
  gunbc.chapman_which_path_observation.chapman_four_model_rejects_coherent_for_row(row: fabricated)
}

test fn w_chapman_rejects_coherent_for_fabricated_distinguishable_visible() -> Bool {
  let fabricated = extdeps.physics.chapman_et_al_1995_atom_interferometer_which_path.ChapmanWhichPathObservationRow {
    apparatus: extdeps.physics.chapman_et_al_1995_atom_interferometer_which_path.chapman_et_al_1995_atom_interferometer,
    which_path_distinguishability_record: extdeps.physics.chapman_et_al_1995_atom_interferometer_which_path.DistinguishableWhichPathRecordProduced,
    interference_fringe_visibility: extdeps.physics.chapman_et_al_1995_atom_interferometer_which_path.InterferenceFringeVisible,
    grain: extdeps.physics.chapman_et_al_1995_atom_interferometer_which_path.EnsembleGrain,
  }
  gunbc.chapman_which_path_observation.chapman_four_model_rejects_coherent_for_row(row: fabricated)
}

test fn w_chapman_cited_observations_are_ensemble_grain() -> Bool {
  gunbc.chapman_which_path_observation.chapman_cited_observations_are_ensemble_grain()
}

test fn w_chapman_rejects_trial_grain_for_ensemble_gate() -> Bool {
  let trial_grain_row = extdeps.physics.chapman_et_al_1995_atom_interferometer_which_path.ChapmanWhichPathObservationRow {
    apparatus: extdeps.physics.chapman_et_al_1995_atom_interferometer_which_path.chapman_et_al_1995_atom_interferometer,
    which_path_distinguishability_record: extdeps.physics.chapman_et_al_1995_atom_interferometer_which_path.DistinguishableWhichPathRecordNotProduced,
    interference_fringe_visibility: extdeps.physics.chapman_et_al_1995_atom_interferometer_which_path.InterferenceFringeVisible,
    grain: extdeps.physics.chapman_et_al_1995_atom_interferometer_which_path.TrialGrain,
  }
  !gunbc.chapman_which_path_observation.chapman_row_is_ensemble_grain(row: trial_grain_row)
}
