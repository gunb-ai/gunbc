module test.claim.scm_commit_closure_witness

// THE ONE CLAIM THESE WITNESSES EXIST FOR: an incomplete closure can NAME WHAT IT IS MISSING, and
// the name it gives is the content address of the actual absent object -- so it says what to fetch.
//
// The predecessor format could not do this at any price. It stored backward POSITIONS, so a
// reference that did not resolve inside the document denoted nothing outside it, and "supply the
// missing object" was unperformable. Every test below would have been unwritable against it -- not
// failing, unwritable, because there was no value to assert about.
//
// So the discriminating question is not "does unresolved_identities return a list". It is whether
// the returned identity is THE MISSING OBJECT'S OWN, which is what makes it fetchable rather than
// merely non-empty. `a_grafted_root_names_exactly_the_child_it_lacks` is the test that decides it.

import std.types { Bool, Int, List, list_length }
import std.process { ProcessExit, ExitSuccess, ExitFailure }
import v2.std.node { Node, Edge, Named, Conj, Atom, TypeNode, node_synthetic }
import gunbc.scm.object_store {
  ObjectId,
  ObjectStore,
  StoreOutcome,
  Stored,
  LocatorCollision,
  CopyOutcome,
  Copied,
  CopySourceAbsent,
  CopyLocatorCollision,
  empty_store,
  copy_object,
  store_node,
  object_id_eq,
  store_object_count,
}
import v2.std.collection { empty_map }
import extdeps.languages.json.emit { serialize_json, json_object, json_kv, json_string, JsonValue, JsonObject }
import extdeps.languages.json.parse { parse_json }
import gunbc.scm.commit_closure_json_v2 {
  ClosureDocRefusal,
  ClosureDocIncompleteWithoutAdmission,
  ClosureDocEncodeRefusal,
  ClosureDocTargetNotOneArm,
  ClosureDocMemberDuplicated,
  ClosureDocMemberWrongShape,
  TargetDecode,
  TargetDecoded,
  TargetDecodeFailed,
  decode_target,
  ClosureDocEncodeOutcome,
  ClosureDocEncoded,
  ClosureDocEncodeRefused,
  ClosureDocLoadOutcome,
  ClosureDocLoaded,
  ClosureDocRefused,
  encode_complete_closure_document,
  encode_admitted_partial_closure_document,
  decode_closure_document,
}
import gunbc.scm.commit_closure {
  CommitClosure,
  PartialClosureReason,
  ClosureTrimmedForTransfer,
  ClosureGraftedWithoutChildren,
  admit_partial_commit_closure,
  AdmittedPartialCommitClosure,
  PartialClosureAdmissionOutcome,
  PartialClosureAdmitted,
  ClosureCompleteSoNothingToAdmit,
  admitted_reason,
  admitted_unresolved,
  unresolved_identities,
  closure_is_complete,
}

fn child_node() -> Node {
  node_synthetic(kind: TypeNode { connective: Atom { identity: ^closure_witness_child } }, children: [])
}

fn parent_node() -> Node {
  node_synthetic(
    kind: TypeNode { connective: Conj },
    children: [Edge { label: Named { name: ^only_child }, target: child_node() }],
  )
}

// A store holding the parent AND its child, with the parent's identity.
type BuiltStore { store: ObjectStore, root: ObjectId, child: ObjectId }

fn build_full_store() -> BuiltStore {
  match store_node(store: empty_store(), n: child_node()) {
    LocatorCollision { identity: _, existing: _, incoming: _ } =>
      BuiltStore { store: empty_store(), root: fallback_id(), child: fallback_id() }
    Stored { store: s1, identity: child_id } =>
      match store_node(store: s1, n: parent_node()) {
        LocatorCollision { identity: _, existing: _, incoming: _ } =>
          BuiltStore { store: empty_store(), root: fallback_id(), child: fallback_id() }
        Stored { store: s2, identity: parent_id } =>
          BuiltStore { store: s2, root: parent_id, child: child_id }
      }
  }
}

// A deliberately wrong id used only where a probe could not be built; every test asserts a real
// structural fact that this value cannot satisfy, so a build failure cannot pass as a green.
fn fallback_id() -> ObjectId {
  match store_node(store: empty_store(), n: child_node()) {
    Stored { store: _, identity: i } => i
    LocatorCollision { identity: i, existing: _, incoming: _ } => i
  }
}

// A store holding ONLY the parent -- object_store's copy_object grafts a record without its children,
// which is the supported route to an incomplete closure and the reason the encoder could not assume
// completeness.
fn build_grafted_store() -> ObjectStore {
  let full = build_full_store()
  match copy_object(from: full.store, to: empty_store(), identity: full.root) {
    Copied { store: s, identity: _ } => s
    CopySourceAbsent { identity: _ } => empty_store()
    CopyLocatorCollision { identity: _, existing: _, incoming: _ } => empty_store()
  }
}

// TWO UNCONTAINED CHILDREN, IN ORDER, and this fixture exists because the ones above cannot see
// order at all. names_exactly is a membership fold and every other closure fixture asserts exactly
// ONE missing identity -- and a one-element list reversed is itself. So the unresolved list could
// have been emitted in any order and nothing here would have noticed.
//
// That was not hypothetical. uncontained_targets accumulates by prepend and reverses once (the cost
// shape DESIGN section 6 requires); dropping that reverse was measured to leave every claim in this
// file GREEN. A comment asserting the reverse was load-bearing would have been describing a wall
// that nothing held up, which is the failure this stack has now produced three times.
//
// The parent's two children are both absent from the grafted store, so both are uncontained, and
// this claim pins WHICH COMES FIRST. Reversing the fold flips alpha and beta and this goes red.
fn closure_alpha_child_node() -> Node {
  node_synthetic(kind: TypeNode { connective: Atom { identity: ^closure_witness_alpha } }, children: [])
}

fn closure_beta_child_node() -> Node {
  node_synthetic(kind: TypeNode { connective: Atom { identity: ^closure_witness_beta } }, children: [])
}

fn closure_two_child_parent_node() -> Node {
  node_synthetic(
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Named { name: ^alpha }, target: closure_alpha_child_node() },
      Edge { label: Named { name: ^beta }, target: closure_beta_child_node() },
    ],
  )
}

type TwoChildStore { store: ObjectStore, root: ObjectId, first: ObjectId, second: ObjectId }

fn two_child_fallback() -> TwoChildStore {
  TwoChildStore { store: empty_store(), root: fallback_id(), first: fallback_id(), second: fallback_id() }
}

fn build_two_child_store() -> TwoChildStore {
  match store_node(store: empty_store(), n: closure_alpha_child_node()) {
    LocatorCollision { identity: _, existing: _, incoming: _ } => two_child_fallback()
    Stored { store: s1, identity: alpha_id } =>
      match store_node(store: s1, n: closure_beta_child_node()) {
        LocatorCollision { identity: _, existing: _, incoming: _ } => two_child_fallback()
        Stored { store: s2, identity: beta_id } =>
          match store_node(store: s2, n: closure_two_child_parent_node()) {
            LocatorCollision { identity: _, existing: _, incoming: _ } => two_child_fallback()
            Stored { store: s3, identity: parent_id } =>
              TwoChildStore { store: s3, root: parent_id, first: alpha_id, second: beta_id }
          }
      }
  }
}

fn first_missing_is(missing: List<ObjectId>, expected: ObjectId) -> Bool {
  match fold(missing, init: none, f: fn(acc, id) {
    match acc {
      Present { value: _ } => acc
      Absent => Present { value: id }
    }
  }) {
    Present { value: id } => object_id_eq(left: id, right: expected)
    Absent => false
  }
}

test fn two_uncontained_children_are_named_in_order() -> Bool {
  let built = build_two_child_store()
  let grafted = match copy_object(from: built.store, to: empty_store(), identity: built.root) {
    Copied { store: s, identity: _ } => s
    CopySourceAbsent { identity: _ } => empty_store()
    CopyLocatorCollision { identity: _, existing: _, incoming: _ } => empty_store()
  }
  let missing = unresolved_identities(closure: CommitClosure { store: grafted, root: built.root })
  (store_object_count(store: grafted) == 1)
    && (list_length(items: missing) == 2)
    && first_missing_is(missing: missing, expected: built.first)
    && names_exactly(missing: missing, expected: built.second)
}

// CONTROL. A complete closure names nothing missing, and completeness is DERIVED from the objects
// rather than stored beside them -- there is no flag here that could disagree with the store.
test fn a_complete_closure_names_nothing_missing() -> Bool {
  let full = build_full_store()
  let closure = CommitClosure { store: full.store, root: full.root }
  (list_length(items: unresolved_identities(closure: closure)) == 0)
    && closure_is_complete(closure: closure)
    && (store_object_count(store: full.store) == 2)
}

// THE ACCEPTANCE TEST OF THE RECUT.
//
// A grafted root lacks its child. The closure must name EXACTLY ONE missing object, and that name
// must be the CHILD'S OWN CONTENT ADDRESS -- not a position, not a placeholder, not merely a
// non-empty list. Identity equality against the child id from the full store is what proves the
// answer is fetchable: it names the object a supplier would have to produce.
test fn a_grafted_root_names_exactly_the_child_it_lacks() -> Bool {
  let full = build_full_store()
  let grafted = build_grafted_store()
  let closure = CommitClosure { store: grafted, root: full.root }
  let missing = unresolved_identities(closure: closure)
  (store_object_count(store: grafted) == 1)
    && (list_length(items: missing) == 1)
    && names_exactly(missing: missing, expected: full.child)
    && !closure_is_complete(closure: closure)
}

fn names_exactly(missing: List<ObjectId>, expected: ObjectId) -> Bool {
  fold(missing, init: false, f: fn(acc, id) { acc || object_id_eq(left: id, right: expected) })
}

// THE ROOT IS A REFERENCE LIKE ANY OTHER. A closure whose store does not carry its own root is the
// sharpest incompleteness there is -- a document naming a commit whose top object is absent -- and
// the predecessor encoded the root positionally too, so this was as unnameable as the rest.
test fn a_closure_missing_its_own_root_names_the_root() -> Bool {
  let full = build_full_store()
  let closure = CommitClosure { store: empty_store(), root: full.root }
  let missing = unresolved_identities(closure: closure)
  (list_length(items: missing) == 1)
    && names_exactly(missing: missing, expected: full.root)
    && !closure_is_complete(closure: closure)
}

// THE ADMISSION IS A VALUE THAT SURVIVES BEING PASSED, which is what lets an encoder require one
// instead of trusting a caller's assurance. That `PartialClosureAdmission` is `sole_constructor` --
// so an undeclared partial closure has no constructor at all -- is a TYPECHECK property and cannot
// be witnessed by execution; it is stated in the module header, and a negative compile probe is the
// evidence that belongs with it. What executes here is only that the reason is carried faithfully,
// which is the part a later refactor could silently break.
test fn an_admission_carries_the_decision_that_produced_it() -> Bool {
  let full = build_full_store()
  let grafted = build_grafted_store()
  let closure = CommitClosure { store: grafted, root: full.root }
  match admit_partial_commit_closure(closure: closure, reason: ClosureTrimmedForTransfer) {
    ClosureCompleteSoNothingToAdmit => false
    PartialClosureAdmitted { admitted: transfer } =>
      match admit_partial_commit_closure(closure: closure, reason: ClosureGraftedWithoutChildren) {
        ClosureCompleteSoNothingToAdmit => false
        PartialClosureAdmitted { admitted: graft } =>
          reason_is_transfer(r: admitted_reason(admitted: transfer))
            && !reason_is_transfer(r: admitted_reason(admitted: graft))
      }
  }
}

// THE ADMISSION NAMES THE POPULATION IT ADMITS, derived from the closure rather than supplied. A
// caller-supplied population would reintroduce the same substitution one field down: an admission
// truthfully about closure A, carrying B's missing objects.
test fn an_admission_names_the_objects_it_admits_as_missing() -> Bool {
  let full = build_full_store()
  let grafted = build_grafted_store()
  match admitted_for(store: grafted, root: full.root) {
    ClosureCompleteSoNothingToAdmit => false
    PartialClosureAdmitted { admitted: a } =>
      (list_length(items: admitted_unresolved(admitted: a)) == 1)
        && names_exactly(missing: admitted_unresolved(admitted: a), expected: full.child)
  }
}

// THE MINT REFUSES A COMPLETE CLOSURE. Admitting a partial write for something with nothing missing
// is a category error, and letting it through would make the carrier's own name a lie -- an
// AdmittedPartialCommitClosure over a closure that is not partial.
//
// This is also the claim that keeps the mint honest about DERIVING the population: a mint that
// trusted a caller could mint this carrier over a complete closure and nothing here would object.
test fn the_mint_refuses_a_complete_closure() -> Bool {
  let full = build_full_store()
  match admitted_for(store: full.store, root: full.root) {
    PartialClosureAdmitted { admitted: _ } => false
    ClosureCompleteSoNothingToAdmit => true
  }
}


// Mints an admission for the closure under test, or reports the refusal. Every claim below routes
// through this, so none of them can accidentally encode a closure the mint never admitted.
fn admitted_for(store: ObjectStore, root: ObjectId) -> PartialClosureAdmissionOutcome {
  admit_partial_commit_closure(
    closure: CommitClosure { store: store, root: root },
    reason: ClosureTrimmedForTransfer
  )
}

fn json_is_object(v: JsonValue) -> Bool {
  match v {
    JsonObject { members: _ } => true
    _ => false
  }
}

fn reason_is_transfer(r: PartialClosureReason) -> Bool {
  match r {
    ClosureTrimmedForTransfer => true
    ClosureGraftedWithoutChildren => false
  }
}

fn commit_closure_witness_main() -> ProcessExit {
  if !a_complete_closure_names_nothing_missing() {
    ExitFailure { code: 1, reason: "a_complete_closure_names_nothing_missing" }
  } else if !a_grafted_root_names_exactly_the_child_it_lacks() {
    ExitFailure { code: 1, reason: "a_grafted_root_names_exactly_the_child_it_lacks" }
  } else if !a_closure_missing_its_own_root_names_the_root() {
    ExitFailure { code: 1, reason: "a_closure_missing_its_own_root_names_the_root" }
  } else if !an_admission_carries_the_decision_that_produced_it() {
    ExitFailure { code: 1, reason: "an_admission_carries_the_decision_that_produced_it" }
  } else if !a_partial_closure_encodes_only_with_an_admission() {
    ExitFailure { code: 1, reason: "a_partial_closure_encodes_only_with_an_admission" }
  } else if !an_uncontained_object_survives_the_wire_and_is_still_named() {
    ExitFailure { code: 1, reason: "an_uncontained_object_survives_the_wire_and_is_still_named" }
  } else if !a_target_must_carry_exactly_one_arm() {
    ExitFailure { code: 1, reason: "a_target_must_carry_exactly_one_arm" }
  } else if !a_target_carrying_one_arm_still_decodes() {
    ExitFailure { code: 1, reason: "a_target_carrying_one_arm_still_decodes" }
  } else if !a_duplicated_at_is_refused_against_at() {
    ExitFailure { code: 1, reason: "a_duplicated_at_is_refused_against_at" }
  } else if !a_non_string_at_is_refused_against_at() {
    ExitFailure { code: 1, reason: "a_non_string_at_is_refused_against_at" }
  } else if !two_uncontained_children_are_named_in_order() {
    ExitFailure { code: 1, reason: "two_uncontained_children_are_named_in_order" }
  } else if !an_admission_names_the_objects_it_admits_as_missing() {
    ExitFailure { code: 1, reason: "an_admission_names_the_objects_it_admits_as_missing" }
  } else if !the_mint_refuses_a_complete_closure() {
    ExitFailure { code: 1, reason: "the_mint_refuses_a_complete_closure" }
  } else {
    ExitSuccess
  }
}

// ------------------------------------------------------------------------------------------------
// THE WIRE HALF OF THE ACCEPTANCE TEST.
//
// The witnesses above prove an incomplete closure can NAME what it lacks at the LOGICAL layer. That
// is only half the claim: a format that cannot carry the name would leave the property true in
// memory and unrepresentable in the thing that actually gets written down. These execute the other
// half -- an uncontained reference surviving encode, serialization to text, and decode.
// ------------------------------------------------------------------------------------------------

// A PARTIAL CLOSURE REFUSES TO ENCODE UNTIL SOMEONE DECIDES IT SHOULD, and the two arms of this test
// are the whole admission wall: the same store, the same root, differing only in whether a decision
// token was supplied. The refusing arm is what stops a partial document being written by accident;
// the encoding arm is what stops that refusal being a wall against the feature itself.
test fn a_partial_closure_encodes_only_with_an_admission() -> Bool {
  let full = build_full_store()
  let grafted = build_grafted_store()
  let refused = match encode_complete_closure_document(
    closure: CommitClosure { store: grafted, root: full.root }
  ) {
    ClosureDocEncodeRefused { cause: c } => cause_is_incomplete_without_admission(cause: c)
    ClosureDocEncoded { value: _ } => false
  }
  let admitted = match admitted_for(store: grafted, root: full.root) {
    ClosureCompleteSoNothingToAdmit => false
    PartialClosureAdmitted { admitted: a } =>
      json_is_object(v: encode_admitted_partial_closure_document(admitted: a))
  }
  refused && admitted
}

// THIS HELPER IS NOW TOTAL BY CONSTRUCTION, and saying so is the point rather than an apology.
//
// Before the encode/decode split it discriminated: the cause could have been any of sixteen decode
// refusals and this asked whether it was the encode-only one. ClosureDocEncodeRefusal has a single
// arm, so the match cannot answer anything else, and the runtime question it used to pose is gone.
//
// That is what a climb to structural impossibility LOOKS like from the test side -- the check does
// not get stronger, it becomes unnecessary, because the state it excluded is no longer nameable
// here. DESIGN section 4b(4) says the production machinery a climb obsoletes is deleted while the
// evidence stays enrolled, so this stays as the positive control that encode still refuses an
// unadmitted partial closure; what it no longer carries is the discrimination, which moved to the
// type. The claim that the LOAD classifier cannot name this cause is a compile-time property and is
// recorded by the probe in the commit message, not by a runtime assertion that cannot express it.
fn cause_is_incomplete_without_admission(cause: ClosureDocEncodeRefusal) -> Bool {
  match cause {
    ClosureDocIncompleteWithoutAdmission { identity: _ } => true
  }
}

// THE CLAIM THE WHOLE RECUT WAS FOR, executed end to end through TEXT.
//
// A partial closure is encoded, SERIALIZED TO A STRING, parsed back, and decoded -- and the object it
// could not carry is still named, by its own content address, on the far side. Going through text
// matters: it is the only arm that proves the identity survives in the BYTES rather than in a value
// that never left memory. The predecessor could not have expressed this at any price.
test fn an_uncontained_object_survives_the_wire_and_is_still_named() -> Bool {
  let full = build_full_store()
  let grafted = build_grafted_store()
  match admitted_for(store: grafted, root: full.root) {
    ClosureCompleteSoNothingToAdmit => false
    PartialClosureAdmitted { admitted: a } =>
      match parse_json(
        s: serialize_json(v: encode_admitted_partial_closure_document(admitted: a))
      ) {
        Absent => false
        Present { value: reparsed } =>
          match decode_closure_document(v: reparsed) {
            ClosureDocRefused { cause: _ } => false
            ClosureDocLoaded { store: store, root: root } =>
              names_exactly(
                missing: unresolved_identities(closure: CommitClosure { store: store, root: root }),
                expected: full.child
              )
          }
      }
  }
}

// A TARGET CARRYING BOTH ARMS IS REFUSED, AND SO IS ONE CARRYING NEITHER.
//
// This exists because the module DOCUMENTED this refusal while the code did not perform it, and no
// witness executed the claim -- review found it by reading. The closed member set admits both keys
// (each is individually legal), so it could never have been what enforced the choice; the earlier
// code then read "at" first and SILENTLY DROPPED a digest sitting beside it. A document asserting
// two contradictory things about one target answered with one of them.
//
// The count is asserted, not just the refusal: `found` distinguishes both-arms from neither-arm,
// which the previous variant could not do because it was hardcoded to 0 at its only construction.
test fn a_target_must_carry_exactly_one_arm() -> Bool {
  let both = json_object(
    members: [
      json_kv(key: "at", value: json_string(s: "0")),
      json_kv(key: "uncontained", value: json_string(s: "0000000000000000")),
    ]
  )
  let neither = json_object(members: [])
  arm_count_refused(v: both, expected: 2) && arm_count_refused(v: neither, expected: 0)
}

fn arm_count_refused(v: JsonValue, expected: Int) -> Bool {
  match decode_target(positions: empty_map(), target_value: v) {
    TargetDecodeFailed { cause: c } =>
      match c {
        ClosureDocTargetNotOneArm { found: n } => n == expected
        _ => false
      }
    TargetDecoded { target: _ } => false
  }
}

// THE POSITIVE CONTROL, without which the two refusals above are satisfied by a decoder that refuses
// every target. One arm, well formed, resolves.
test fn a_target_carrying_one_arm_still_decodes() -> Bool {
  match decode_target(
    positions: empty_map(),
    target_value: json_object(
      members: [json_kv(key: "uncontained", value: json_string(s: "0000000000000000"))]
    )
  ) {
    TargetDecoded { target: _ } => true
    TargetDecodeFailed { cause: _ } => false
  }
}

// A BROKEN `at` IS REPORTED AGAINST `at`, NOT AGAINST THE ARM IT IS NOT.
//
// These two exist because the refusal was real but named the WRONG KEY, which no refusal-only
// assertion could ever have caught -- the decoder said no in both the correct and the broken build,
// so every existing claim here stayed green while the diagnostic pointed at an innocent member.
//
// The defect was selecting the arm on READ SUCCESS: a missing `at` and a malformed `at` both arrive
// as MemberFailed, so "at did not read" was treated as "this is the uncontained arm". A target
// carrying `at` twice fell into the uncontained read, where `uncontained` is legitimately absent,
// and was refused as a wrong-shape `uncontained` -- with the duplication never mentioned at all.
//
// Both claims therefore assert the CAUSE and its KEY, not the refusal. Under the previous code the
// first reports ClosureDocMemberWrongShape("uncontained") and the second ClosureDocMemberMissing(
// "uncontained"), so each goes red for a different wrong answer rather than by a shared accident.
test fn a_duplicated_at_is_refused_against_at() -> Bool {
  match decode_target(
    positions: empty_map(),
    target_value: json_object(
      members: [
        json_kv(key: "at", value: json_string(s: "0")),
        json_kv(key: "at", value: json_string(s: "1")),
      ]
    )
  ) {
    TargetDecodeFailed { cause: c } =>
      match c {
        ClosureDocMemberDuplicated { key: k } => k == "at"
        _ => false
      }
    TargetDecoded { target: _ } => false
  }
}

test fn a_non_string_at_is_refused_against_at() -> Bool {
  match decode_target(
    positions: empty_map(),
    target_value: json_object(
      members: [json_kv(key: "at", value: json_object(members: []))]
    )
  ) {
    TargetDecodeFailed { cause: c } =>
      match c {
        ClosureDocMemberWrongShape { key: k } => k == "at"
        _ => false
      }
    TargetDecoded { target: _ } => false
  }
}
