module test.claim.transport_script_stdin_byte_fidelity_witness

// The whole TransportScript construction wall rests on one transport fact:
// when the carrier became a sole_constructor record, `shell.Exec.Run` had to
// route `stdin: script.body` rather than a bare identifier, and NO corpus site
// had ever projected a record field to stdin. This witness is that fact's
// executing evidence, not a demonstration: it feeds a payload carrying a tab,
// an unexpanded dollar and embedded double quotes through the production
// bridge and asserts the bytes that come back are the bytes that went in.
//
// The second control exists because a strict round-trip comparison during the
// spike returned false and the cause was REASONED rather than executed. It
// pins the difference to the RETURN side (stdout's trailing newline), not to
// stdin delivery, by running the same shape with and without a terminal
// newline. Reasoning about which side ate a byte is exactly the thing this
// witness replaces.

// Both controls EXECUTE a real shell through the transport, so they are wet by
// construction: run dry, `shell.Exec.Run` returns no stdout and both compare
// false. That is exactly what CI reported on the first push, and the fix is
// enrollment rather than a weaker assertion -- a dry-satisfiable version of
// this witness would assert nothing about byte delivery, which is the one fact
// the wall rests on. Enrolled in `gunbc.ci.ci_layer_roots` as a BinWitnessWet
// exclusion from dry discovery plus two `bin_wet` roster rows, the same shape
// as `effect_plan_bash_materialize_real_execution_witness_test`.

import std.types { Bool, String }
import std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import gunbc.bash_materialized_transport { bash_materialized_transport }
import v2.std.effect_plan { Call, EffectPlan }
import v2.std.orchestration { FailFast }
import v2.workflow.effect_plan_bash_materialize { effect_plan_bash_materialize }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// The script reaches the shell through bash_materialized_transport, one of the two minters
// transport_script_seal admits: the bytes under test are the payload of a materialized `printf %s`
// Call, so the stdin carrier is exercised by text an effect plan actually emitted and no free
// minter or bridge is involved.
fn stdin_exact_bytes(payload: String) -> String {
  match bash_materialized_transport(materialization: effect_plan_bash_materialize(plan: EffectPlan {
    steps: [Call { callee: "printf", args: ["%s", payload] }],
    on_failure: FailFast,
  })) {
    Present { value: script } => shell.Exec.Run(script: script).stdout
    Absent => "REFUSED-TO-MATERIALIZE"
  }
}

test fn transport_script_stdin_delivers_exact_bytes() -> Bool {
  let payload = "alpha beta\ttab $dollar \"dq\" end"
  stdin_exact_bytes(payload: payload) == payload
}

// DECLARED DROP OF A CASE: the former control ran one body with and without a terminal newline on the
// SCRIPT. A materialized script has a fixed ending, so that axis is no longer reachable through an
// admitted minter and is not exercised here. What remains is the return-side half it pinned: the stdout
// read back is the same with and without a terminal newline on the payload, as the former control asserted.
test fn transport_script_stdout_is_independent_of_a_payload_terminal_newline() -> Bool {
  stdin_exact_bytes(payload: "newline-probe") == "newline-probe"
    && stdin_exact_bytes(payload: "newline-probe\n") == "newline-probe"
}
