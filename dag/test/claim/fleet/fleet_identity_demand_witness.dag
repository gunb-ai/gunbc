module test.claim.fleet.fleet_identity_demand_witness

import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.types { Bool, List, String }
import std.optional { Present, Absent }
import std.algebra { string_contains }
import gunbc.fleet.fleet_converge_workflow {
  fleet_converge_job, fleet_converge_fleet_identity_auth_condition, fleet_converge_fleet_identity_reader_candidates,
  fleet_identity_readers, fleet_identity_mint_condition, fleet_identity_reader_mint_condition, step_reads_fleet_identity,
  fleet_converge_mode_step_if, fleet_converge_fleet_ssh_key_step_if,
  FleetConvergeWorkflowMode, HostMemoryObserve, MicrovmSlotReserve, MicrovmSlotStart,
  MtCollins1CensusQemuHostObserve, MtCollins1CensusQemuToolchainConverge, WorkspaceTranscriptRateObserve,
  FabricWriterIdentityObserve, BootMediumReaderProbe, WorkspaceAllocationPlan, WorkspaceImageBuild,
  RevisionJobImageBuild, FullHostPlan, OrgActionsObserve, R2MintPreflight,
}
import extdeps.github.actions { Step, RunStep, UsesStep }
import extdeps.languages.yaml.types { kv, yaml_string }
import gunbc.action_use_admission { upload_artifact_action }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn step_id_of(s: Step) -> String {
  match s {
    RunStep { name: _, id: i, run: _, shell: _, env: _, working_directory: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } => match i { Present { value: v } => v  Absent => "" }
    UsesStep { name: _, id: i, uses: _, with: _, env: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } => match i { Present { value: v } => v  Absent => "" }
  }
}

fn step_if_of(s: Step) -> String {
  match s {
    RunStep { name: _, id: _, run: _, shell: _, env: _, working_directory: _, if_condition: c, continue_on_error: _, timeout_minutes: _ } => match c { Present { value: v } => v  Absent => "" }
    UsesStep { name: _, id: _, uses: _, with: _, env: _, if_condition: c, continue_on_error: _, timeout_minutes: _ } => match c { Present { value: v } => v  Absent => "" }
  }
}

fn run_step(run: String, condition: String) -> Step {
  RunStep { name: Present { value: "fixture" }, id: none, run: run, shell: none, env: none, working_directory: none, if_condition: Present { value: condition }, continue_on_error: none, timeout_minutes: none }
}

fn uses_step_with(value: String, condition: String) -> Step {
  UsesStep { name: Present { value: "fixture" }, id: none, uses: upload_artifact_action, with: Present { value: [kv(key: "token", value: yaml_string(s: value))] }, env: none, if_condition: Present { value: condition }, continue_on_error: none, timeout_minutes: none }
}

data compound_condition: String = "github.event.inputs.mode == 'plan' && github.ref == 'refs/heads/main'"

// FIXTURES OF THE DERIVATION ITSELF. A reader is found in any field of its emitted YAML, not by one
// spelling: the token read in a `run:` script and in a `with:` input both count, under a compound
// condition. RED: a derivation that scanned only `env` (the shape every reader happens to have today)
// finds neither, and the mint would not cover them.
test fn a_reader_in_run_or_with_under_a_compound_condition_widens_the_mint() -> Bool {
  let in_run = run_step(run: "curl -H \"Authorization: Bearer ${{ steps.wif_auth.outputs.access_token }}\" https://example.invalid", condition: compound_condition)
  let in_with = uses_step_with(value: "${{ steps['wif_auth'].outputs.access_token }}", condition: fleet_converge_mode_step_if(mode: OrgActionsObserve))
  let other = run_step(run: "echo ${{ steps.wif_auth_hetzner_cloud_control.outputs.access_token }}", condition: fleet_converge_mode_step_if(mode: HostMemoryObserve))
  step_reads_fleet_identity(step: in_run)
    && step_reads_fleet_identity(step: in_with)
    && !step_reads_fleet_identity(step: other)
    && fleet_identity_mint_condition(readers: fleet_identity_readers(candidates: [in_run, other, in_with]))
      == concat(concat(concat("(", compound_condition), ") || ("), concat(fleet_converge_mode_step_if(mode: OrgActionsObserve), ")"))
}

// A condition the mint cannot decide before the reader runs (another step's outcome, a status
// function) or no condition at all contributes `true`: the mint over-approximates rather than strand
// the reader. No reader at all never mints.
test fn an_undecidable_reader_condition_mints_and_no_reader_never_does() -> Bool {
  let late = run_step(run: "echo ${{ steps.wif_auth.outputs.access_token }}", condition: "steps.release_bins.outcome == 'success'")
  let status = run_step(run: "echo ${{ steps.wif_auth.outputs.access_token }}", condition: "failure() && github.event.inputs.mode == 'plan'")
  fleet_identity_reader_mint_condition(step: late) == "true"
    && fleet_identity_reader_mint_condition(step: status) == "true"
    && fleet_identity_mint_condition(readers: []) == "false"
}

// THE REAL JOB. The emitted mint is the derivation over the job's own post-mint steps, nothing beside
// it, and every reader's condition is one of its disjuncts.
test fn the_emitted_auth_step_is_the_reader_derivation() -> Bool {
  let auth = filter(fleet_converge_job().steps, s => step_id_of(s: s) == "wif_auth")
  let readers = fleet_identity_readers(candidates: fleet_converge_fleet_identity_reader_candidates())
  auth.length() == 1
    && readers.length() > 0
    && match auth.first() {
      Present { value: s } => step_if_of(s: s) == fleet_converge_fleet_identity_auth_condition()
      Absent => false
    }
    && all(readers, r => string_contains(s: fleet_converge_fleet_identity_auth_condition(), pattern: concat(concat("(", fleet_identity_reader_mint_condition(step: r)), ")")))
}

// THE FLEET KEY READS THE IDENTITY, so every key-consuming mode keeps the mint (RED: dropping the key
// step from the candidates would strand it). Own-step readers keep it too.
test fn the_fleet_key_and_own_step_readers_keep_the_mint() -> Bool {
  let auth = fleet_converge_fleet_identity_auth_condition()
  string_contains(s: auth, pattern: concat(concat("(", fleet_converge_fleet_ssh_key_step_if), ")"))
    && string_contains(s: auth, pattern: fleet_converge_mode_step_if(mode: FullHostPlan))
    && string_contains(s: auth, pattern: fleet_converge_mode_step_if(mode: OrgActionsObserve))
    && string_contains(s: auth, pattern: fleet_converge_mode_step_if(mode: R2MintPreflight))
}

data no_reader_modes: List<FleetConvergeWorkflowMode> = [
  HostMemoryObserve, MicrovmSlotReserve, MicrovmSlotStart, MtCollins1CensusQemuHostObserve,
  MtCollins1CensusQemuToolchainConverge, WorkspaceTranscriptRateObserve, FabricWriterIdentityObserve,
  BootMediumReaderProbe, WorkspaceAllocationPlan, WorkspaceImageBuild, RevisionJobImageBuild,
]

// MODES WITH NO READER DO NOT APPEAR IN THE MINT. host_memory_observe is the diagnostic that prompted
// this. The check reads the clause in a disjunction of readers' conditions; a reader gated on one of
// these modes, in any field, puts its clause there and turns this red.
test fn modes_with_no_reader_do_not_reach_the_mint() -> Bool {
  let auth = fleet_converge_fleet_identity_auth_condition()
  all(no_reader_modes, m => !string_contains(s: auth, pattern: fleet_converge_mode_step_if(mode: m)))
}
