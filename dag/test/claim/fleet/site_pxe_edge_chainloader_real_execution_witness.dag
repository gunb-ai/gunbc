module test.claim.fleet.site_pxe_edge_chainloader_real_execution_witness

import std.types { Bool, List, NonEmptyStr, String }
import extdeps.shell
import std.types { FilePath }
import std.algebra { non_empty_to_list }
import gunbc.fleet.site_pxe_edge_converge {
  SitePxeEdgeChainloaderObservation,
  SitePxeEdgeEmbeddedRevision,
  SitePxeEdgeMemberObservation,
  SitePxeEdgeEmbeddedObservation,
  SitePxeEdgeChainServable,
  SitePxeEdgeChainWithheld,
  site_pxe_edge_chainloader_pin,
  site_pxe_edge_arm64_ipxe_chain_pin,
  site_pxe_edge_chain_standing,
  site_pxe_edge_chain_cause_text,
  site_pxe_edge_digest_observation,
  site_pxe_edge_embedded_revision,
}
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE COMMITTED CHAINLOADER BY REAL EXECUTION. The pin's digest and embedded revision are read here from
// artifacts/ipxe/snponly-arm64.efi by the same two commands production runs on srv4 (`sha256sum`, and
// `grep -a -o -E "[(]g[0-9a-f]{5}[)]"`), and their stdout goes through the production parsers and the
// production per-chain fold. Swapping the blob, or flipping a byte inside its revision markers, reds here. The
// srv4 copy is still a different, later observation; this one is the checkout's.
// Refused by the hermetic envelope (shell.Exec and shell.Mktemp.Dir have no mock_response), so it is
// excluded from discovery and enrolled in gunbc.ci.ci_layer_roots as a real-execution witness.

data committed_image_path: String = "artifacts/ipxe/snponly-arm64.efi"


fn digest_observation(path: String) -> SitePxeEdgeChainloaderObservation {
  let r = shell.Exec.RunArgv(program: "sha256sum", arguments: [path])
  site_pxe_edge_digest_observation(path: path as NonEmptyStr, success: r.exit_code == 0, line: r.stdout)
}

fn embedded_revision(path: String) -> SitePxeEdgeEmbeddedRevision {
  let r = shell.Exec.RunArgv(program: "grep", arguments: ["-a", "-o", "-E", "[(]g[0-9a-f]{5}[)]", path])
  site_pxe_edge_embedded_revision(success: r.exit_code == 0, output: r.stdout)
}

// The arm64 chain's standing from the production per-chain fold, with the member read at `path`.
fn causes_for(path: String) -> String {
  match site_pxe_edge_chain_standing(
    pin: site_pxe_edge_arm64_ipxe_chain_pin(pin: site_pxe_edge_chainloader_pin),
    observations: [SitePxeEdgeMemberObservation { served_path: "snponly.efi", digest: digest_observation(path: path) }],
    embedded: [SitePxeEdgeEmbeddedObservation { served_path: "snponly.efi", revision: embedded_revision(path: path) }],
  ) {
    SitePxeEdgeChainServable { chain: _ } => ""
    SitePxeEdgeChainWithheld { architecture: _, causes: cs } => join(map(non_empty_to_list(xs: cs), c => site_pxe_edge_chain_cause_text(cause: c)), "\n")
  }
}

// POSITIVE CONTROL: the committed image satisfies the pin's digest and revision; only the Secure Boot
// standing (genuinely unobserved) remains.
test fn the_committed_image_satisfies_the_pin_by_real_execution() -> Bool {
  let causes = causes_for(path: committed_image_path)
  contains(causes, "ipxe-secure-boot-unobserved")
    && !contains(causes, "member-digest-mismatch snponly.efi")
    && !contains(causes, "ipxe-embedded-revision")
    && !contains(causes, "member-unobservable")
}

// RED: a copy with one byte flipped inside each of the THREE "(gc51ca)" markers (sed's /g changes all three, so three bytes) is refused as both a different digest
// and a different embedded revision.
test fn a_corrupted_copy_with_a_flipped_byte_in_each_marker_is_refused_by_real_execution() -> Bool {
  let dir = shell.Mktemp.Dir()
  if dir.success == false {
    false
  } else {
    let copy = join([dir.path as String, "/snponly-arm64.efi"], "")
    let copied = shell.Copy.File(source: committed_image_path as FilePath, destination: copy as FilePath)
    let edited = shell.Exec.RunArgv(program: "env", arguments: ["LC_ALL=C", "sed", "-i", "s/(gc51ca)/(gc51cb)/g", copy])
    let causes = causes_for(path: copy)
    let cleaned = shell.Remove.RecursiveForce(path: dir.path)
    copied.success
      && edited.exit_code == 0
      && contains(causes, "ipxe-embedded-revision-mismatch: image carries c51cb, pinned c51ca")
      && contains(causes, "member-digest-mismatch snponly.efi")
      && cleaned.success
  }
}
