module test.claim.fleet.fleet_wireless_link_witness

import std.types { Bool, Int, List, String, NonEmptyStr }
import v2.std.optional { Present, Absent }
import std.upsert_decision { UpsertDecision, Noop, Apply, Refuse }
import extdeps.iw {
  IwPowerSaveOn, IwPowerSaveOff, IwPowerSaveReadValue, IwPowerSaveUnreadable, iw_power_save_of_getter,
  IwLinkConnected, IwLinkNotConnected, IwLinkUnreadable, iw_link_of_stdout,
}
import extdeps.networkmanager.nmcli {
  NmPowersaveDefault, NmPowersaveDisable, NmPowersaveEnable, NmPowersaveReadValue, NmPowersaveUnreadable,
  nm_wireless_powersave_of_getter, nmcli_wireless_powersave_modify_argv,
  NmAuthRetriesIndefinitely, NmAuthRetriesGlobalDefault, NmAuthRetriesReadValue, NmAuthRetriesUnreadable,
  nm_auth_retries_of_getter, nmcli_auth_retries_modify_argv,
  NmDeviceActivated, NmDeviceDisconnected, nm_device_state_of_getter,
}
import gunbc.spark.host_effect_quiescence { ArgvRun, ArgvRan, ArgvLegDidNotRun }
import gunbc.fleet_intent_network { operator_host_srv7, operator_host_srv12 }
import gunbc.fleet_wireless_link {
  WirelessLinkDesired, WirelessLinkObservation, WirelessLinkPlan,
  DisconnectCountRead, kernel_disconnect_line_count,
  JournalLineCountRead, networkmanager_no_secrets_line_count,
  wireless_link_standing, LinkActivated, LinkDisconnectedNoSecrets, LinkDisconnected,
  wireless_link_uncovered_spark_hosts,
  wireless_link_desired_for, spark_wireless_link_desired, wireless_link_decide, wireless_link_converge,
  WirelessLinkAlreadyConverged, WirelessLinkApplied, WirelessLinkRefused,
}

fn srv7_desired() -> WirelessLinkDesired { spark_wireless_link_desired(host: operator_host_srv7) }

// ── upstream parses ──────────────────────────────────────────────────────────

test fn witness_iw_power_save_getter_reads_on_off_and_refuses_garbage() -> Bool {
  let on = match iw_power_save_of_getter(stdout: "Power save: on\n") { IwPowerSaveReadValue { value: IwPowerSaveOn } => true  _ => false }
  let off = match iw_power_save_of_getter(stdout: "Power save: off") { IwPowerSaveReadValue { value: IwPowerSaveOff } => true  _ => false }
  let empty = match iw_power_save_of_getter(stdout: "") { IwPowerSaveUnreadable { text: _ } => true  _ => false }
  on && off && empty
}

test fn witness_nmcli_getter_reads_nick_and_refuses_empty() -> Bool {
  let disable = match nm_wireless_powersave_of_getter(stdout: "disable\n") { NmPowersaveReadValue { value: NmPowersaveDisable } => true  _ => false }
  let enable = match nm_wireless_powersave_of_getter(stdout: "enable") { NmPowersaveReadValue { value: NmPowersaveEnable } => true  _ => false }
  let empty = match nm_wireless_powersave_of_getter(stdout: "") { NmPowersaveUnreadable { text: _ } => true  _ => false }
  disable && enable && empty
}

test fn witness_nmcli_modify_argv_carries_numeric_disable() -> Bool {
  join(nmcli_wireless_powersave_modify_argv(connection: "Verizon_39TTYV" as NonEmptyStr, value: NmPowersaveDisable), " ")
    == "nmcli connection modify Verizon_39TTYV 802-11-wireless.powersave 2"
}

data iw_link_connected_sample: String = "Connected to ac:91:9b:c4:4d:b6 (on wlP9s9)\n\tSSID: Verizon_39TTYV\n\tfreq: 5180.0\n\tRX: 1234 bytes (10 packets)\n\tsignal: -52 dBm\n\ttx bitrate: 864.8 MBit/s\n"

test fn witness_iw_link_parses_bssid_freq_signal() -> Bool {
  match iw_link_of_stdout(stdout: iw_link_connected_sample) {
    IwLinkConnected { bssid: b, freq_mhz: f, signal_dbm: s } => b as String == "ac:91:9b:c4:4d:b6" && f == 5180 && s == -52
    _ => false
  }
}

test fn witness_iw_link_not_connected_and_missing_signal_is_unreadable() -> Bool {
  let nc = match iw_link_of_stdout(stdout: "Not connected.\n") { IwLinkNotConnected => true  _ => false }
  let partial = match iw_link_of_stdout(stdout: "Connected to ac:91:9b:c4:4d:b6 (on wlP9s9)\n\tfreq: 5180\n") { IwLinkUnreadable { text: _ } => true  _ => false }
  nc && partial
}

test fn witness_disconnect_count_matches_only_the_interface() -> Bool {
  let log = "1.0 srv7 kernel: wlP9s9: disconnect from AP ac:91:9b:c4:4d:b6 for new auth\n1.1 srv7 kernel: wlP9s9: authenticate with ac:91:9b:c4:4d:b6\n2.0 srv7 kernel: wlP9s9: disconnect from AP ac:91:9b:c4:4d:b6 for new auth\n3.0 srv7 kernel: wlan1: disconnect from AP 00:00:00:00:00:01 for new auth\n"
  kernel_disconnect_line_count(interface: "wlP9s9" as NonEmptyStr, kernel_log: log) == 2
}

// ── desired roster ───────────────────────────────────────────────────────────

test fn witness_spark_rows_present_including_srv12() -> Bool {
  let srv7 = match wireless_link_desired_for(host: operator_host_srv7) {
    Present { value: d } => d.interface as String == "wlP9s9" && d.connection as String == "Verizon_39TTYV"
    Absent => false
  }
  let srv12 = match wireless_link_desired_for(host: operator_host_srv12) {
    Present { value: d } => d.interface as String == "wlP9s9" && d.connection as String == "Verizon_39TTYV"
    Absent => false
  }
  srv7 && srv12
}

// THE COVERAGE JOIN: every procured Spark identity has a wireless row. Removing srv12's row (the
// state main held until 2026-10-04, which let spark-2196 keep NetworkManager's power-save default)
// reds this claim.
test fn witness_every_procured_spark_has_a_wireless_row() -> Bool {
  length(wireless_link_uncovered_spark_hosts()) == 0
}

// ── auth retries and the no-secrets standing ─────────────────────────────────

test fn witness_auth_retries_getter_decodes_upstream_encoding() -> Bool {
  let dflt = match nm_auth_retries_of_getter(stdout: "-1\n") { NmAuthRetriesReadValue { value: NmAuthRetriesGlobalDefault } => true  _ => false }
  let forever = match nm_auth_retries_of_getter(stdout: "0") { NmAuthRetriesReadValue { value: NmAuthRetriesIndefinitely } => true  _ => false }
  let empty = match nm_auth_retries_of_getter(stdout: "") { NmAuthRetriesUnreadable { text: _ } => true  _ => false }
  let below = match nm_auth_retries_of_getter(stdout: "-2") { NmAuthRetriesUnreadable { text: _ } => true  _ => false }
  dflt && forever && empty && below
}

test fn witness_auth_retries_modify_argv_is_zero_for_indefinitely() -> Bool {
  join(nmcli_auth_retries_modify_argv(connection: "Verizon_39TTYV" as NonEmptyStr, value: NmAuthRetriesIndefinitely), " ")
    == "nmcli connection modify Verizon_39TTYV connection.auth-retries 0"
}

// spark-2196 read 2026-10-04: auth-retries -1 (global default, 3 attempts, the last one prompts).
test fn witness_default_auth_retries_is_drift_planned_to_zero() -> Bool {
  match wireless_link_decide(desired: srv7_desired(), observed: obs_auth(runtime: "Power save: off", persisted: "disable", auth: "-1")) {
    Apply { plan: p } =>
      (match p.auth_retries { Present { value: NmAuthRetriesIndefinitely } => true  _ => false })
      && (match p.persisted { Absent => true  Present { value: _ } => false })
    _ => false
  }
}

data nm_no_secrets_journal: String = "1759470000.0 srv8 NetworkManager[1022]: <warn>  [1759470000.0] device (wlP9s9): no secrets: No agents were available for this request.\n1759470001.0 srv8 NetworkManager[1022]: <info>  [1759470001.0] device (wlP9s9): state change: need-auth -> failed\n"

test fn witness_disconnected_with_no_secrets_is_named() -> Bool {
  let o = obs_full(runtime: "Power save: off", persisted: "disable", auth: "0", device: "30 (disconnected)", journal: nm_no_secrets_journal)
  match wireless_link_standing(o: o) { LinkDisconnectedNoSecrets { failures: n } => n == 1  _ => false }
}

test fn witness_plain_disconnect_and_activated_are_not_no_secrets() -> Bool {
  let plain = match wireless_link_standing(o: obs_full(runtime: "Power save: off", persisted: "disable", auth: "0", device: "30 (disconnected)", journal: "")) { LinkDisconnected => true  _ => false }
  let up = match wireless_link_standing(o: obs_full(runtime: "Power save: off", persisted: "disable", auth: "0", device: "100 (connected)", journal: nm_no_secrets_journal)) { LinkActivated => true  _ => false }
  plain && up
}

// ── decision over supplied observations ──────────────────────────────────────

fn obs_full(runtime: String, persisted: String, auth: String, device: String, journal: String) -> WirelessLinkObservation {
  WirelessLinkObservation {
    runtime: iw_power_save_of_getter(stdout: runtime),
    persisted: nm_wireless_powersave_of_getter(stdout: persisted),
    auth_retries: nm_auth_retries_of_getter(stdout: auth),
    link: IwLinkNotConnected,
    device: nm_device_state_of_getter(stdout: device),
    disconnects: DisconnectCountRead { count: 0 },
    no_secrets_failures: JournalLineCountRead { count: networkmanager_no_secrets_line_count(journal: journal) },
  }
}

fn obs_auth(runtime: String, persisted: String, auth: String) -> WirelessLinkObservation {
  obs_full(runtime: runtime, persisted: persisted, auth: auth, device: "100 (connected)", journal: "")
}

fn obs(runtime: String, persisted: String) -> WirelessLinkObservation {
  obs_auth(runtime: runtime, persisted: persisted, auth: "0")
}

test fn witness_both_off_is_noop() -> Bool {
  match wireless_link_decide(desired: srv7_desired(), observed: obs(runtime: "Power save: off", persisted: "disable")) {
    Noop => true
    _ => false
  }
}

test fn witness_persisted_enable_is_drift_runtime_untouched() -> Bool {
  match wireless_link_decide(desired: srv7_desired(), observed: obs(runtime: "Power save: off", persisted: "enable")) {
    Apply { plan: p } =>
      (match p.persisted { Present { value: NmPowersaveDisable } => true  _ => false })
      && (match p.runtime { Absent => true  Present { value: _ } => false })
    _ => false
  }
}

test fn witness_persisted_default_is_drift_not_converged() -> Bool {
  match wireless_link_decide(desired: srv7_desired(), observed: obs(runtime: "Power save: off", persisted: "default")) {
    Apply { plan: _ } => true
    _ => false
  }
}

test fn witness_runtime_on_is_drift() -> Bool {
  match wireless_link_decide(desired: srv7_desired(), observed: obs(runtime: "Power save: on", persisted: "disable")) {
    Apply { plan: p } => match p.runtime { Present { value: IwPowerSaveOff } => true  _ => false }
    _ => false
  }
}

test fn witness_unreadable_is_refusal_not_absence() -> Bool {
  let rt = match wireless_link_decide(desired: srv7_desired(), observed: obs(runtime: "", persisted: "disable")) { Refuse { reason: _ } => true  _ => false }
  let ps = match wireless_link_decide(desired: srv7_desired(), observed: obs(runtime: "Power save: off", persisted: "")) { Refuse { reason: _ } => true  _ => false }
  rt && ps
}

// ── the converge route, driven by a supplied runner ──────────────────────────
//
// A pure runner cannot change state between the apply and the readback, which is what makes the
// readback route discriminating: a host that keeps reporting drift after every set exits 0 must
// refuse, not report applied.

fn fake_run(runtime: String, persisted: String, modify_exit: Int) -> fn(List<String>) -> ArgvRun {
  fn(argv) {
    let line = join(argv, " ")
    if line == "iw dev wlP9s9 get power_save" { ArgvRan { exit_code: 0, stdout: runtime, stderr: "" } }
    else if line == "nmcli -g 802-11-wireless.powersave connection show Verizon_39TTYV" { ArgvRan { exit_code: 0, stdout: persisted, stderr: "" } }
    else if line == "iw dev wlP9s9 link" { ArgvRan { exit_code: 0, stdout: iw_link_connected_sample, stderr: "" } }
    else if line == "journalctl -k -b --no-pager -o short-unix" { ArgvRan { exit_code: 0, stdout: "", stderr: "" } }
    else if line == "nmcli -g connection.auth-retries connection show Verizon_39TTYV" { ArgvRan { exit_code: 0, stdout: "0", stderr: "" } }
    else if line == "nmcli -g GENERAL.STATE device show wlP9s9" { ArgvRan { exit_code: 0, stdout: "100 (connected)", stderr: "" } }
    else if line == "journalctl -u NetworkManager -b --no-pager -o short-unix" { ArgvRan { exit_code: 0, stdout: "", stderr: "" } }
    else if line == "nmcli connection modify Verizon_39TTYV 802-11-wireless.powersave 2" { ArgvRan { exit_code: modify_exit, stdout: "", stderr: "denied" } }
    else if line == "iw dev wlP9s9 set power_save off" { ArgvRan { exit_code: 0, stdout: "", stderr: "" } }
    else { ArgvLegDidNotRun { cause: join(["unexpected argv: ", line], "") } }
  }
}

test fn witness_converge_already_off_is_noop() -> Bool {
  match wireless_link_converge(desired: srv7_desired(), run: fake_run(runtime: "Power save: off", persisted: "disable", modify_exit: 0)) {
    WirelessLinkAlreadyConverged { observed: o } => match o.link { IwLinkConnected { bssid: _, freq_mhz: f, signal_dbm: _ } => f == 5180  _ => false }
    _ => false
  }
}

test fn witness_converge_readback_still_drifted_refuses() -> Bool {
  match wireless_link_converge(desired: srv7_desired(), run: fake_run(runtime: "Power save: on", persisted: "enable", modify_exit: 0)) {
    WirelessLinkRefused { stage: s, cause: _ } => s as String == "readback"
    _ => false
  }
}

test fn witness_converge_failed_modify_refuses_at_apply() -> Bool {
  match wireless_link_converge(desired: srv7_desired(), run: fake_run(runtime: "Power save: off", persisted: "enable", modify_exit: 1)) {
    WirelessLinkRefused { stage: s, cause: _ } => s as String == "apply"
    _ => false
  }
}

test fn witness_converge_unreadable_refuses_at_observe() -> Bool {
  match wireless_link_converge(desired: srv7_desired(), run: fake_run(runtime: "garbage", persisted: "disable", modify_exit: 0)) {
    WirelessLinkRefused { stage: s, cause: _ } => s as String == "observe"
    _ => false
  }
}
