}

fn srv7_desired() -> WirelessLinkDesired { spark_wireless_link_desired(host: operator_host_srv7) }

// ── upstream parses ──────────────────────────────────────────────────────────

test fn witness_iw_power_save_getter_reads_on_off_and_refuses_garbage() -> Bool {
  let on = match iw_power_save_of_getter(stdout: "Power save: on\n") { IwPowerSaveReadValue { value: IwPowerSaveOn } => true  _ => false }
  let off = match iw_power_save_of_getter(stdout: "Power save: off") { IwPowerSaveReadValue { value: IwPowerSaveOff } => true  _ => false }
  let empty = match iw_power_save_of_getter(stdout: "") { IwPowerSaveUnreadable { text: _ } => true  _ => false }
  on && off && empty
}

test fn witness_nmcli_getter_reads_nick_and_refuses_empty() -> Bool {
  let disable = match nm_wireless_powersave_of_getter(stdout: "disable\n") { NmPowersaveReadValue { value: NmPowersaveDisable } => true  _ => false }
  let enable = match nm_wireless_powersave_of_getter(stdout: "enable") { NmPowersaveReadValue { value: NmPowersaveEnable } => true  _ => false }
  let empty = match nm_wireless_powersave_of_getter(stdout: "") { NmPowersaveUnreadable { text: _ } => true  _ => false }
  disable && enable && empty
}

test fn witness_nmcli_modify_argv_carries_numeric_disable() -> Bool {
  join(nmcli_wireless_powersave_modify_argv(connection: "Verizon_39TTYV" as NonEmptyStr, value: NmPowersaveDisable), " ")
    == "nmcli connection modify Verizon_39TTYV 802-11-wireless.powersave 2"
}

data iw_link_connected_sample: String = "Connected to ac:91:9b:c4:4d:b6 (on wlP9s9)\n\tSSID: Verizon_39TTYV\n\tfreq: 5180.0\n\tRX: 1234 bytes (10 packets)\n\tsignal: -52 dBm\n\ttx bitrate: 864.8 MBit/s\n"

test fn witness_iw_link_parses_bssid_freq_signal() -> Bool {
  match iw_link_of_stdout(stdout: iw_link_connected_sample) {
    IwLinkConnected { bssid: b, freq_mhz: f, signal_dbm: s } => b as String == "ac:91:9b:c4:4d:b6" && f == 5180 && s == -52
    _ => false
  }
}

test fn witness_iw_link_not_connected_and_missing_signal_is_unreadable() -> Bool {
  let nc = match iw_link_of_stdout(stdout: "Not connected.\n") { IwLinkNotConnected => true  _ => false }
  let partial = match iw_link_of_stdout(stdout: "Connected to ac:91:9b:c4:4d:b6 (on wlP9s9)\n\tfreq: 5180\n") { IwLinkUnreadable { text: _ } => true  _ => false }
  nc && partial
}

test fn witness_disconnect_count_matches_only_the_interface() -> Bool {
  let log = "1.0 srv7 kernel: wlP9s9: disconnect from AP ac:91:9b:c4:4d:b6 for new auth\n1.1 srv7 kernel: wlP9s9: authenticate with ac:91:9b:c4:4d:b6\n2.0 srv7 kernel: wlP9s9: disconnect from AP ac:91:9b:c4:4d:b6 for new auth\n3.0 srv7 kernel: wlan1: disconnect from AP 00:00:00:00:00:01 for new auth\n"
  kernel_disconnect_line_count(interface: "wlP9s9" as NonEmptyStr, kernel_log: log) == 2
}

// ── desired roster ───────────────────────────────────────────────────────────

test fn witness_spark_rows_present_including_srv12() -> Bool {
  let srv7 = match wireless_link_desired_for(host: operator_host_srv7) {
    Present { value: d } => d.interface as String == "wlP9s9" && d.connection as String == "Verizon_39TTYV"
    Absent => false
  }
  let srv12 = match wireless_link_desired_for(host: operator_host_srv12) {
    Present { value: d } => d.interface as String == "wlP9s9" && d.connection as String == "Verizon_39TTYV"
    Absent => false
  }
  srv7 && srv12
}

// THE COVERAGE JOIN: every procured Spark identity has a wireless row. Removing srv12's row (the
// state main held until 2026-10-04, which let spark-2196 keep NetworkManager's power-save default)
// reds this claim.
test fn witness_every_procured_spark_has_a_wireless_row() -> Bool {
  length(wireless_link_uncovered_spark_hosts()) == 0
}

// ── auth retries and the no-secrets standing ─────────────────────────────────

test fn witness_auth_retries_getter_decodes_upstream_encoding() -> Bool {
  let dflt = match nm_retry_budget_of_getter(stdout: "-1\n") { NmRetryBudgetReadValue { value: NmRetryGlobalDefault } => true  _ => false }
  let forever = match nm_retry_budget_of_getter(stdout: "0") { NmRetryBudgetReadValue { value: NmRetryIndefinitely } => true  _ => false }
  let empty = match nm_retry_budget_of_getter(stdout: "") { NmRetryBudgetUnreadable { text: _ } => true  _ => false }
  let below = match nm_retry_budget_of_getter(stdout: "-2") { NmRetryBudgetUnreadable { text: _ } => true  _ => false }
  dflt && forever && empty && below
}

test fn witness_auth_retries_modify_argv_is_zero_for_indefinitely() -> Bool {
  join(nmcli_retry_budget_modify_argv(connection: spark_2196_profile_uuid as NonEmptyStr, property: nm_connection_auth_retries_property, value: NmRetryIndefinitely), " ")
    == join(["nmcli connection modify ", spark_2196_profile_uuid, " connection.auth-retries 0"], "")
  && join(nmcli_retry_budget_modify_argv(connection: spark_2196_profile_uuid as NonEmptyStr, property: nm_connection_autoconnect_retries_property, value: NmRetryIndefinitely), " ")
    == join(["nmcli connection modify ", spark_2196_profile_uuid, " connection.autoconnect-retries 0"], "")
}

// spark-2196 read 2026-10-04: auth-retries -1 (global default, 3 attempts, the last one prompts).
test fn witness_default_auth_retries_is_drift_planned_to_zero() -> Bool {
  match wireless_link_decide(desired: srv7_desired(), observed: obs_retries(auth: "-1", autoconnect: "0")) {
    Apply { plan: p } =>
      (match p.auth_retries { Present { value: NmRetryIndefinitely } => true  _ => false })
      && (match p.autoconnect_retries { Absent => true  Present { value: _ } => false })
      && (match p.persisted { Absent => true  Present { value: _ } => false })
      && p.profile as String == spark_2196_profile_uuid
    _ => false
  }
}

// spark-2196 read 2026-10-04: autoconnect-retries -1 (global default, 4 tries then blocked). Still
// at the upstream default is drift, planned to 0 on the governing profile.
test fn witness_default_autoconnect_retries_is_drift_planned_to_zero() -> Bool {
  match wireless_link_decide(desired: srv7_desired(), observed: obs_retries(auth: "0", autoconnect: "-1")) {
    Apply { plan: p } =>
      (match p.autoconnect_retries { Present { value: NmRetryIndefinitely } => true  _ => false })
      && (match p.auth_retries { Absent => true  Present { value: _ } => false })
    _ => false
  }
}

// ── the governing profile is read from the device ────────────────────────────

data spark_2196_profile_uuid: String = "a653b65d-3648-4382-9587-c6b417614626"
data active_line_spark: String = "a653b65d-3648-4382-9587-c6b417614626:wlP9s9:Verizon_39TTYV"

test fn witness_active_parser_picks_the_interface_row_and_unescapes_the_name() -> Bool {
  let picked = match nm_active_connection_on(interface: "wlP9s9" as NonEmptyStr, stdout: join(["11111111-0000-0000-0000-000000000000:enp1s0f1np1:netplan-fabric\n", active_line_spark, "\n"], "")) {
    NmActiveConnectionOn { connection: c } => c.uuid as String == spark_2196_profile_uuid && c.name == "Verizon_39TTYV"
    _ => false
  }
  let escaped = match nm_active_connection_on(interface: "wlP9s9" as NonEmptyStr, stdout: "22222222-0000-0000-0000-000000000000:wlP9s9:Guest\\:5G") {
    NmActiveConnectionOn { connection: c } => c.name == "Guest:5G"
    _ => false
  }
  let none_on = match nm_active_connection_on(interface: "wlP9s9" as NonEmptyStr, stdout: "11111111-0000-0000-0000-000000000000:enp1s0f1np1:netplan-fabric") { NmNoActiveConnection => true  _ => false }
  let two = match nm_active_connection_on(interface: "wlP9s9" as NonEmptyStr, stdout: join([active_line_spark, "\n33333333-0000-0000-0000-000000000000:wlP9s9:Other"], "")) { NmActiveConnectionUnreadable { text: _ } => true  _ => false }
  picked && escaped && none_on && two
}

test fn witness_a_different_active_profile_refuses() -> Bool {
  let o = obs_with_active(active: "44444444-0000-0000-0000-000000000000:wlP9s9:Neighbour")
  match wireless_link_decide(desired: srv7_desired(), observed: o) { Refuse { reason: r } => (r as String).contains("Neighbour")  _ => false }
}

test fn witness_no_active_profile_refuses() -> Bool {
  match wireless_link_decide(desired: srv7_desired(), observed: obs_with_active(active: "")) { Refuse { reason: _ } => true  _ => false }
}

// THE RED THE REVIEW OF gunbc#13199 ASKED FOR: the desired profile, looked up by NAME, is correct
// (disable), while the profile actually active on wlP9s9, looked up by UUID, is drifting (enable).
// An observe that reads by name reports converged; this one reads the governing profile.
test fn witness_desired_profile_correct_active_profile_drifting_is_drift() -> Bool {
  match wireless_link_converge(desired: srv7_desired(), run: fake_run_split(name_persisted: "disable", uuid_persisted: "enable")) {
    WirelessLinkAlreadyConverged { observed: _ } => false
    WirelessLinkApplied { before: _, plan: _, after: _ } => false
    WirelessLinkRefused { stage: s, cause: _ } => s as String == "readback"
  }
}

data nm_no_secrets_journal: String = "1759470000.0 srv8 NetworkManager[1022]: <warn>  [1759470000.0] device (wlP9s9): no secrets: No agents were available for this request.\n1759470001.0 srv8 NetworkManager[1022]: <info>  [1759470001.0] device (wlP9s9): state change: need-auth -> failed\n"

test fn witness_disconnected_with_no_secrets_is_named() -> Bool {
  let o = obs_full(runtime: "Power save: off", persisted: "disable", auth: "0", device: "30 (disconnected)", journal: nm_no_secrets_journal)
  match wireless_link_standing(o: o) { LinkDisconnectedNoSecrets { failures: n } => n == 1  _ => false }
}

test fn witness_plain_disconnect_and_activated_are_not_no_secrets() -> Bool {
  let plain = match wireless_link_standing(o: obs_full(runtime: "Power save: off", persisted: "disable", auth: "0", device: "30 (disconnected)", journal: "")) { LinkDisconnected => true  _ => false }
  let up = match wireless_link_standing(o: obs_full(runtime: "Power save: off", persisted: "disable", auth: "0", device: "100 (connected)", journal: nm_no_secrets_journal)) { LinkActivated => true  _ => false }
  plain && up
}

// ── decision over supplied observations ──────────────────────────────────────

// The MERGED passthrough subtree as `netplan get wifis.NM-<uuid>.networkmanager.passthrough` prints
// it (keys at the top level of the answer; values quoted as netplan writes them).
fn merged_passthrough_with(powersave: String) -> String {
  join([powersave, "connection.auth-retries: \"0\"\nconnection.autoconnect-retries: \"0\"\n"], "")
}

data merged_passthrough_converged: String = merged_passthrough_with(powersave: "wifi.powersave: \"2\"\n")

fn merged(passthrough: String) -> PersistedAuthorityRead {
  AuthorityNetplanMerged { provenance: "/etc/netplan/90-NM-x.yaml" as NonEmptyStr, definition: "NM-x" as NonEmptyStr, passthrough: passthrough }
}

data authority_converged: PersistedAuthorityRead = merged(passthrough: merged_passthrough_converged)

fn obs_all(runtime: String, persisted: String, auth: String, autoconnect: String, active: String, device: String, journal: String) -> WirelessLinkObservation {
  obs_authority(runtime: runtime, persisted: persisted, auth: auth, autoconnect: autoconnect, active: active, device: device, journal: journal, authority: authority_converged)
}

fn obs_authority(runtime: String, persisted: String, auth: String, autoconnect: String, active: String, device: String, journal: String, authority: PersistedAuthorityRead) -> WirelessLinkObservation {
  WirelessLinkObservation {
    persistence: authority,
    active: nm_active_connection_on(interface: "wlP9s9" as NonEmptyStr, stdout: active),
    runtime: iw_power_save_of_getter(stdout: runtime),
    persisted: nm_wireless_powersave_of_getter(stdout: persisted),
    auth_retries: nm_retry_budget_of_getter(stdout: auth),
    autoconnect_retries: nm_retry_budget_of_getter(stdout: autoconnect),
    link: IwLinkNotConnected,
    device: nm_device_state_of_getter(stdout: device),
    disconnects: DisconnectCountRead { count: 0 },
    no_secrets_failures: JournalLineCountRead { count: networkmanager_no_secrets_line_count(journal: journal) },
  }
}

fn obs_full(runtime: String, persisted: String, auth: String, device: String, journal: String) -> WirelessLinkObservation {
  obs_all(runtime: runtime, persisted: persisted, auth: auth, autoconnect: "0", active: active_line_spark, device: device, journal: journal)
}

fn obs_retries(auth: String, autoconnect: String) -> WirelessLinkObservation {
  obs_all(runtime: "Power save: off", persisted: "disable", auth: auth, autoconnect: autoconnect, active: active_line_spark, device: "100 (connected)", journal: "")
}

fn obs_with_active(active: String) -> WirelessLinkObservation {
  obs_all(runtime: "Power save: off", persisted: "disable", auth: "0", autoconnect: "0", active: active, device: "100 (connected)", journal: "")
}

fn obs(runtime: String, persisted: String) -> WirelessLinkObservation {
  obs_full(runtime: runtime, persisted: persisted, auth: "0", device: "100 (connected)", journal: "")
}

test fn witness_both_off_is_noop() -> Bool {
  match wireless_link_decide(desired: srv7_desired(), observed: obs(runtime: "Power save: off", persisted: "disable")) {
    Noop => true
    _ => false
  }
}

test fn witness_persisted_enable_is_drift_runtime_untouched() -> Bool {
  match wireless_link_decide(desired: srv7_desired(), observed: obs(runtime: "Power save: off", persisted: "enable")) {
    Apply { plan: p } =>
      (match p.persisted { Present { value: NmPowersaveDisable } => true  _ => false })
      && (match p.runtime { Absent => true  Present { value: _ } => false })
    _ => false
  }
}

test fn witness_persisted_default_is_drift_not_converged() -> Bool {
  match wireless_link_decide(desired: srv7_desired(), observed: obs(runtime: "Power save: off", persisted: "default")) {
    Apply { plan: _ } => true
    _ => false
  }
}

test fn witness_runtime_on_is_drift() -> Bool {
  match wireless_link_decide(desired: srv7_desired(), observed: obs(runtime: "Power save: on", persisted: "disable")) {
    Apply { plan: p } => match p.runtime { Present { value: IwPowerSaveOff } => true  _ => false }
    _ => false
  }
}

test fn witness_unreadable_is_refusal_not_absence() -> Bool {
  let rt = match wireless_link_decide(desired: srv7_desired(), observed: obs(runtime: "", persisted: "disable")) { Refuse { reason: _ } => true  _ => false }
  let ps = match wireless_link_decide(desired: srv7_desired(), observed: obs(runtime: "Power save: off", persisted: "")) { Refuse { reason: _ } => true  _ => false }
  rt && ps
}

// ── the converge route, driven by a supplied runner ──────────────────────────
//
// A pure runner cannot change state between the apply and the readback, which is what makes the
// readback route discriminating: a host that keeps reporting drift after every set exits 0 must
// refuse, not report applied.

fn fake_run_full(runtime: String, name_persisted: String, uuid_persisted: String, modify_exit: Int) -> fn(List<String>) -> ArgvRun {
  fake_run_merged(runtime: runtime, name_persisted: name_persisted, uuid_persisted: uuid_persisted, modify_exit: modify_exit, merged_answer: merged_passthrough_converged)
}

fn fake_run_merged(runtime: String, name_persisted: String, uuid_persisted: String, modify_exit: Int, merged_answer: String) -> fn(List<String>) -> ArgvRun {
  fn(argv) {
    let line = join(argv, " ")
    let by_uuid = join(["connection show ", spark_2196_profile_uuid], "")
    if line == "iw dev wlP9s9 get power_save" { ArgvRan { exit_code: 0, stdout: runtime, stderr: "" } }
    else if line == "nmcli -t -f UUID,DEVICE,NAME connection show --active" { ArgvRan { exit_code: 0, stdout: active_line_spark, stderr: "" } }
    else if line == "nmcli -g 802-11-wireless.powersave connection show Verizon_39TTYV" { ArgvRan { exit_code: 0, stdout: name_persisted, stderr: "" } }
    else if line == join(["nmcli -g 802-11-wireless.powersave ", by_uuid], "") { ArgvRan { exit_code: 0, stdout: uuid_persisted, stderr: "" } }
    else if line == join(["nmcli -g connection.auth-retries ", by_uuid], "") { ArgvRan { exit_code: 0, stdout: "0", stderr: "" } }
    else if line == join(["nmcli -g connection.autoconnect-retries ", by_uuid], "") { ArgvRan { exit_code: 0, stdout: "0", stderr: "" } }
    else if line == "nmcli -t -f UUID,FILENAME connection show" { ArgvRan { exit_code: 0, stdout: join([spark_2196_profile_uuid, ":/run/NetworkManager/system-connections/netplan-NM-", spark_2196_profile_uuid, "-Verizon_39TTYV.nmconnection\nffff-other:/etc/NetworkManager/system-connections/Wired.nmconnection"], ""), stderr: "" } }
    else if line == join(["netplan get wifis.NM-", spark_2196_profile_uuid, ".networkmanager.passthrough"], "") { ArgvRan { exit_code: 0, stdout: merged_answer, stderr: "" } }
    else if line == "iw dev wlP9s9 link" { ArgvRan { exit_code: 0, stdout: iw_link_connected_sample, stderr: "" } }
    else if line == "journalctl -k -b --no-pager -o short-unix" { ArgvRan { exit_code: 0, stdout: "", stderr: "" } }
    else if line == "nmcli -g GENERAL.STATE device show wlP9s9" { ArgvRan { exit_code: 0, stdout: "100 (connected)", stderr: "" } }
    else if line == "journalctl -u NetworkManager -b --no-pager -o short-unix" { ArgvRan { exit_code: 0, stdout: "", stderr: "" } }
    else if line == join(["nmcli connection modify ", spark_2196_profile_uuid, " 802-11-wireless.powersave 2"], "") { ArgvRan { exit_code: modify_exit, stdout: "", stderr: "denied" } }
    else if line == "iw dev wlP9s9 set power_save off" { ArgvRan { exit_code: 0, stdout: "", stderr: "" } }
    else { ArgvLegDidNotRun { cause: join(["unexpected argv: ", line], "") } }
  }
}

fn fake_run(runtime: String, persisted: String, modify_exit: Int) -> fn(List<String>) -> ArgvRun {
  fake_run_full(runtime: runtime, name_persisted: persisted, uuid_persisted: persisted, modify_exit: modify_exit)
}

fn fake_run_split(name_persisted: String, uuid_persisted: String) -> fn(List<String>) -> ArgvRun {
  fake_run_full(runtime: "Power save: off", name_persisted: name_persisted, uuid_persisted: uuid_persisted, modify_exit: 0)
}

test fn witness_converge_already_off_is_noop() -> Bool {
  match wireless_link_converge(desired: srv7_desired(), run: fake_run(runtime: "Power save: off", persisted: "disable", modify_exit: 0)) {
    WirelessLinkAlreadyConverged { observed: o } => match o.link { IwLinkConnected { bssid: _, freq_mhz: f, signal_dbm: _ } => f == 5180  _ => false }
    _ => false
  }
}

test fn witness_converge_readback_still_drifted_refuses() -> Bool {
  match wireless_link_converge(desired: srv7_desired(), run: fake_run(runtime: "Power save: on", persisted: "enable", modify_exit: 0)) {
    WirelessLinkRefused { stage: s, cause: _ } => s as String == "readback"
    _ => false
  }
}

test fn witness_converge_failed_modify_refuses_at_apply() -> Bool {
  match wireless_link_converge(desired: srv7_desired(), run: fake_run(runtime: "Power save: off", persisted: "enable", modify_exit: 1)) {
    WirelessLinkRefused { stage: s, cause: _ } => s as String == "apply"
    _ => false
  }
}

test fn witness_converge_unreadable_refuses_at_observe() -> Bool {
  match wireless_link_converge(desired: srv7_desired(), run: fake_run(runtime: "garbage", persisted: "disable", modify_exit: 0)) {
    WirelessLinkRefused { stage: s, cause: _ } => s as String == "observe"
    _ => false
  }
}


// ── the persisted AUTHORITY: netplan's MERGED value, not the projection nmcli reads ─────
//
// On the Sparks the profile is netplan-generated (spark-2196, 2026-10-05): the /run keyfile nmcli
// reads is regenerated from the merge of every netplan layer, of which 90-NM-<uuid>.yaml is one input.

fn obs_with_authority(authority: PersistedAuthorityRead) -> WirelessLinkObservation {
  obs_authority(runtime: "Power save: off", persisted: "disable", auth: "0", autoconnect: "0", active: active_line_spark, device: "100 (connected)", journal: "", authority: authority)
}

test fn witness_filename_listing_picks_the_profile_row() -> Bool {
  let listing = "aaaa:/run/NetworkManager/system-connections/netplan-NM-aaaa-W.nmconnection\nbbbb:/etc/NetworkManager/system-connections/Wired.nmconnection"
  let picked = match nm_connection_filename_of(uuid: "aaaa" as NonEmptyStr, stdout: listing) {
    NmConnectionFilename { path: p } => p as String == "/run/NetworkManager/system-connections/netplan-NM-aaaa-W.nmconnection"
    NmConnectionFilenameUnreadable { text: _ } => false
  }
  let missing = match nm_connection_filename_of(uuid: "cccc" as NonEmptyStr, stdout: listing) {
    NmConnectionFilenameUnreadable { text: _ } => true
    NmConnectionFilename { path: _ } => false
  }
  picked && missing
}

test fn witness_passthrough_reads_either_quote_and_absence() -> Bool {
  let dq = match netplan_passthrough_value(yaml: "wifi.powersave: \"2\"\n", key: "wifi.powersave" as NonEmptyStr) { PassthroughValue { word: w } => w == "2"  PassthroughKeyAbsent => false }
  let sq = match netplan_passthrough_value(yaml: "wifi.powersave: '3'\n", key: "wifi.powersave" as NonEmptyStr) { PassthroughValue { word: w } => w == "3"  PassthroughKeyAbsent => false }
  let absent = match netplan_passthrough_value(yaml: "connection.auth-retries: \"0\"\n", key: "wifi.powersave" as NonEmptyStr) { PassthroughKeyAbsent => true  PassthroughValue { word: _ } => false }
  dq && sq && absent
}

// A LATER LAYER OVERRIDES 90-NM: the profile's own file says 2 (and nmcli reads 'disable'), but a
// 99-override.yaml sets 3, so the merge -- what the next generate renders -- says 3. Drift, planned
// to the persisted setter. Reading only the 90-NM file would have returned Noop here.
test fn witness_a_later_layer_overriding_the_profile_file_is_drift() -> Bool {
  match wireless_link_decide(desired: srv7_desired(), observed: obs_with_authority(authority: merged(passthrough: merged_passthrough_with(powersave: "wifi.powersave: '3'\n")))) {
    Apply { plan: p } => match p.persisted { Present { value: NmPowersaveDisable } => true  _ => false }
    _ => false
  }
}

// THE KEY ABSENT FROM 90-NM BUT SUPPLIED BY ANOTHER LAYER: the merge carries it, so the profile file's
// omission is not read as the default.
test fn witness_a_key_supplied_by_another_layer_is_read_from_the_merge() -> Bool {
  match wireless_link_decide(desired: srv7_desired(), observed: obs_with_authority(authority: authority_converged)) {
    Noop => true
    _ => false
  }
}

// No layer supplies the key: the merge omits it, the generated keyfile omits it, NetworkManager uses
// its default, which is not 'disable'.
test fn witness_a_key_no_layer_supplies_is_the_default_and_drift() -> Bool {
  match wireless_link_decide(desired: srv7_desired(), observed: obs_with_authority(authority: merged(passthrough: merged_passthrough_with(powersave: "")))) {
    Apply { plan: p } => match p.persisted { Present { value: NmPowersaveDisable } => true  _ => false }
    _ => false
  }
}

test fn witness_merged_retry_drift_is_planned_even_when_nmcli_reads_zero() -> Bool {
  match wireless_link_decide(desired: srv7_desired(), observed: obs_with_authority(authority: merged(passthrough: "wifi.powersave: \"2\"\n"))) {
    Apply { plan: p } =>
      (match p.auth_retries { Present { value: NmRetryIndefinitely } => true  _ => false })
      && (match p.persisted { Absent => true  Present { value: _ } => false })
    _ => false
  }
}

// THE ACTIVE PROFILE AGREEING WHILE ITS KEYFILE ON DISK MAY NOT: that backend's file is not read, so
// agreement is not minted from the in-memory profile; it refuses, like a runtime-only or unread one.
test fn witness_keyfile_runtime_only_or_unread_persistence_refuses() -> Bool {
  let keyfile = match wireless_link_decide(desired: srv7_desired(), observed: obs_with_authority(authority: AuthorityKeyfileUnmodeled { path: "/etc/NetworkManager/system-connections/W.nmconnection" as NonEmptyStr })) { Refuse { reason: _ } => true  _ => false }
  let volatile = match wireless_link_decide(desired: srv7_desired(), observed: obs_with_authority(authority: AuthorityRuntimeOnly { path: "/run/NetworkManager/system-connections/W.nmconnection" as NonEmptyStr })) { Refuse { reason: _ } => true  _ => false }
  let unread = match wireless_link_decide(desired: srv7_desired(), observed: obs_with_authority(authority: AuthorityUnreadable { cause: "x" })) { Refuse { reason: _ } => true  _ => false }
  keyfile && volatile && unread
}

// THE ROUTE: the real observe reads the FILENAME listing, classifies the netplan /run keyfile, asks
// netplan for the merged passthrough of NM-<uuid>, and decides on it. An override in the merge reds a
// converge that would otherwise be Noop; deleting the merged read reds both claims.
test fn witness_observe_reads_the_merged_netplan_value_by_uuid() -> Bool {
  match wireless_link_converge(desired: srv7_desired(), run: fake_run(runtime: "Power save: off", persisted: "disable", modify_exit: 0)) {
    WirelessLinkAlreadyConverged { observed: o } => match o.persistence {
      AuthorityNetplanMerged { provenance: y, definition: d, passthrough: _ } =>
        y as String == join(["/etc/netplan/90-NM-", spark_2196_profile_uuid, ".yaml"], "") && d as String == join(["NM-", spark_2196_profile_uuid], "")
      _ => false
    }
    _ => false
  }
}

test fn witness_converge_over_a_merged_override_does_not_report_converged() -> Bool {
  let run = fake_run_merged(runtime: "Power save: off", name_persisted: "disable", uuid_persisted: "disable", modify_exit: 0, merged_answer: merged_passthrough_with(powersave: "wifi.powersave: \"3\"\n"))
  match wireless_link_converge(desired: srv7_desired(), run: run) {
    WirelessLinkRefused { stage: s, cause: _ } => s as String == "readback"
    _ => false
  }
}

test fn witness_an_empty_merge_answer_refuses() -> Bool {
  let run = fake_run_merged(runtime: "Power save: off", name_persisted: "disable", uuid_persisted: "disable", modify_exit: 0, merged_answer: "")
  match wireless_link_converge(desired: srv7_desired(), run: run) {
    WirelessLinkRefused { stage: s, cause: _ } => s as String == "observe"
    _ => false
  }
}
