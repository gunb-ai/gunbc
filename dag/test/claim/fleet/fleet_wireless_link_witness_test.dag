  NmPowersaveDefault, NmPowersaveDisable, NmPowersaveEnable, NmPowersaveReadValue, NmPowersaveUnreadable,
  nm_wireless_powersave_of_getter, nmcli_wireless_powersave_modify_argv,
  NmRetryIndefinitely, NmRetryGlobalDefault, NmRetryBudgetReadValue, NmRetryBudgetUnreadable,
  nm_retry_budget_of_getter, nmcli_retry_budget_modify_argv,
  nm_connection_auth_retries_property, nm_connection_autoconnect_retries_property,
  NmActiveConnectionOn, NmNoActiveConnection, NmActiveConnectionUnreadable, nm_active_connection_on,
  NmDeviceActivated, NmDeviceDisconnected, nm_device_state_of_getter,
  NmConnectionFilename, NmConnectionFilenameUnreadable, nm_connection_filename_of,
}
