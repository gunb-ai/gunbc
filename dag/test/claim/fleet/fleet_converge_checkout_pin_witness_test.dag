module test.claim.fleet.fleet_converge_checkout_pin_witness_test

import std.types { Bool, String, List }
import std.optional { Present, Absent }
import extdeps.languages.yaml.types { kv, yaml_string }
import extdeps.github.actions { Workflow, Job, UsesStep, WorkflowDispatch, HostedRunner, UbuntuLatest }
import extdeps.github.action.upload_artifact { upload_artifact_v6_0_0 }
import extdeps.github.expressions { Expression, ContextAccess, Github, Inputs, StringLiteral, Equals, LogicalOr, LogicalAnd, interpolate }
import gunbc.action_use_admission {
  checkout_action, checkout_ref_admitted, checkout_ref_entry,
  admit_workflow_checkout_refs, WorkflowCheckoutRefsAdmission, WorkflowCheckoutRefsAdmitted, WorkflowCheckoutRefsRefused,
}
import gunbc.fleet_converge_workflow { fleet_converge_checkout_ref }

// THE SUBJECT IS gunbc.action_use_admission admit_workflow_checkout_refs, at its own interface: each
// claim SUPPLIES an Expression or a one-step workflow. The real path is not re-walked here -- every
// generated workflow's expected_*_yml calls the admission and refuses emission, and the generated lane
// executes that on every run (DESIGN s3, a witness discriminates at one interface).
fn github_context(path: List<String>) -> Expression { ContextAccess { context: Github, path: path } }
fn dispatch_input(name: String) -> Expression { ContextAccess { context: Inputs, path: [name] } }
fn either(l: Expression, r: Expression) -> Expression { LogicalOr { left: l, right: r } }
fn mode_is(m: String) -> Expression { Equals { left: github_context(path: ["event", "inputs", "mode"]), right: StringLiteral { value: m } } }

// The fleet-converge tree with a chosen tail: github.sha now, github.ref before this change.
fn fleet_shape(tail: Expression) -> Expression {
  either(l: either(l: LogicalAnd { left: either(l: either(l: mode_is(m: "mtcollins1_boot"), r: mode_is(m: "gcp_iam_converge")), r: mode_is(m: "namecheap_observe")), right: github_context(path: ["sha"]) },
           r: github_context(path: ["event", "inputs", "expected_revision"])),
     r: tail)
}

// RED: THE EXPRESSION main EMITTED BEFORE THIS CHANGE. With no expected_revision it fell back to
// github.ref, so a consumer job that queued behind a merge checked out a later main than the build
// job and release-bins refused it (ConsumerSourceTreeMismatch, runs 36764203649 and 36766990321).
test fn red_the_pre_fix_branch_fallback_is_refused() -> Bool {
  !checkout_ref_admitted(ref_expression: fleet_shape(tail: github_context(path: ["ref"])))
    && !checkout_ref_admitted(ref_expression: github_context(path: ["ref"]))
    && !checkout_ref_admitted(ref_expression: StringLiteral { value: "main" })
}

// RED: A BRANCH-VALUED OPERAND IN FRONT OF A SHA TAIL. `||` takes the first non-empty operand, so the
// sha tail is never reached when the branch operand is set.
test fn red_a_branch_term_before_the_sha_tail_is_refused() -> Bool {
  !checkout_ref_admitted(ref_expression: either(l: github_context(path: ["head_ref"]), r: github_context(path: ["sha"])))
    && !checkout_ref_admitted(ref_expression: either(l: github_context(path: ["event", "pull_request", "head", "ref"]), r: github_context(path: ["sha"])))
    && !checkout_ref_admitted(ref_expression: either(l: dispatch_input(name: "branch"), r: github_context(path: ["sha"])))
}

// RED: A CONDITION WITH NO FALLBACK. `cond && github.sha` alone yields `false` when cond is false.
test fn red_a_condition_with_no_fallback_is_refused() -> Bool {
  !checkout_ref_admitted(ref_expression: LogicalAnd { left: mode_is(m: "x"), right: github_context(path: ["sha"]) })
}

// POSITIVE: every commit-valued form the generated workflows declare.
test fn commit_valued_checkout_refs_are_admitted() -> Bool {
  checkout_ref_admitted(ref_expression: github_context(path: ["sha"]))
    && checkout_ref_admitted(ref_expression: github_context(path: ["event", "pull_request", "head", "sha"]))
    && checkout_ref_admitted(ref_expression: dispatch_input(name: "head_sha"))
    && checkout_ref_admitted(ref_expression: either(l: dispatch_input(name: "expected_healed_sha"), r: github_context(path: ["sha"])))
    && checkout_ref_admitted(ref_expression: fleet_shape(tail: github_context(path: ["sha"])))
}

// THE RENDERING: the fleet-converge ref renders to the bytes the regenerated fleet-converge.yml
// carries, with the mode disjunction grouped under the && (extdeps.github.expressions precedence).
test fn the_fleet_converge_ref_renders_to_the_emitted_bytes() -> Bool {
  interpolate(expression: fleet_converge_checkout_ref)
    == "${{ (github.event.inputs.mode == 'mtcollins1_boot' || github.event.inputs.mode == 'gcp_iam_converge' || github.event.inputs.mode == 'namecheap_observe') && github.sha || github.event.inputs.expected_revision || github.sha }}"
}

fn one_step_workflow(uses_checkout: Bool, ref_text: String) -> Workflow {
  Workflow {
    name: "fixture", run_name: none, on: [WorkflowDispatch { inputs: [] }], concurrency: none,
    jobs: [Job {
      id: "j", name: none, runner: HostedRunner { label: UbuntuLatest }, environment: none,
      steps: [UsesStep {
        name: none, id: none,
        uses: if uses_checkout { checkout_action } else { upload_artifact_v6_0_0 },
        with: Present { value: [kv(key: "ref", value: yaml_string(s: ref_text))] },
        env: none, if_condition: none, continue_on_error: none, timeout_minutes: none,
      }],
      needs: [], env: none, outputs: none, if_condition: none, timeout_minutes: none, continue_on_error: none, concurrency: none, permissions: none,
    }],
    env: none, permissions: none,
  }
}

fn admitted(a: WorkflowCheckoutRefsAdmission) -> Bool {
  match a { WorkflowCheckoutRefsAdmitted => true  WorkflowCheckoutRefsRefused { refusals: _ } => false }
}

// THE WORKFLOW WALL: a checkout `ref` must be the rendering of a declared Expression. A hand-typed
// string refuses even when it spells an admissible commit; a declared, admitted one passes; a
// declared but inadmissible one refuses even though its text matches.
test fn a_checkout_ref_must_render_a_declared_admitted_expression() -> Bool {
  !admitted(a: admit_workflow_checkout_refs(workflow: one_step_workflow(uses_checkout: true, ref_text: "${{ github.sha }}"), declared: []))
    && admitted(a: admit_workflow_checkout_refs(workflow: one_step_workflow(uses_checkout: true, ref_text: "${{ github.sha }}"), declared: [github_context(path: ["sha"])]))
    && !admitted(a: admit_workflow_checkout_refs(workflow: one_step_workflow(uses_checkout: true, ref_text: "${{ github.ref }}"), declared: [github_context(path: ["ref"])]))
}

// THE ADMISSION READS actions/checkout ONLY: another action's `ref` input is not a checkout.
test fn a_ref_input_on_another_action_is_not_read() -> Bool {
  admitted(a: admit_workflow_checkout_refs(workflow: one_step_workflow(uses_checkout: false, ref_text: "main"), declared: []))
}
