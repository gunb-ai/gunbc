module test.claim.fleet.board_function_admission_witness

import std.types { Bool, List, String }
import std.decl_ref { decl_ref }
import extdeps.boards.types {
  BoardFunction, BmcManagementFunction, BmcGraphicsController, PcieErrorFirmwareFirstHandling, OnboardEthernetPort,
  BoardFunctionSwitch, JumperSwitch, FirmwareSetupSwitch, SwitchNotStated,
}
import extdeps.boards.types { OnboardEthernetPortRow }
import extdeps.boards.asrock_rack { asrock_altrad8ud_1l2t_catalog, asrock_altrad8ud_1l2t_lan1, asrock_altrad8ud_1l2t_lan2, asrock_altrad8ud_1l2t_lan3 }
import extdeps.boards.supermicro_h11ssl { supermicro_h11ssl_catalog, supermicro_h11ssl_function_switch, supermicro_h11ssl_lan1, supermicro_h11ssl_lan2 }
import extdeps.boards.gigabyte { gigabyte_mp72_hb0_catalog }
import std.optional { Present, Absent }
import gunbc.fleet.board_function_topology { asrock_altrad8ud_1l2t_x550_route }
import gunbc.fleet.bmc_network_attachment { BmcOnDedicatedPort, BmcOnSharedPort }
import gunbc.fleet.board_function_admission {
  BoardFunctionRemoval, NothingToRemove, RemovedAtBoard, RemovedByHostAfterBoot,
  RemovalUnmodeled,
  BoardFunctionAdmission, FunctionAdmitted, FunctionNotAdmitted, AdmissionUnread,
  port_admission_by_bmc, controller_removal,
  HostBoardFunctionPlan, PlannedFunction, PlannedUnreadPorts,
  board_functions, board_function_listed, board_function_removal, fleet_board_function_plans, machine_board_function_plans,
}
import gunbc.fleet.machine_board { MachineBoardRow, MachineBoardCatalogued, machine_board_rows }
import gunbc.fleet.fleet_host_identity {
  operator_hosts, operator_host_srv1, operator_host_srv4, operator_host_6ce85c, operator_host_mtjade1, operator_host_183527,
}
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn removed_at_board_by_jumper(r: BoardFunctionRemoval, designator: String) -> Bool {
  match r {
    RemovedAtBoard { switch } => match switch {
      JumperSwitch { designator: d, off_position: _, citation: _ } => (d as String) == designator
      FirmwareSetupSwitch { menu: _, item: _, off_meaning: _, citation: _ } => false
      SwitchNotStated { coarser: _ } => false
    }
    _ => false
  }
}

fn removed_at_board_by_setup_item(r: BoardFunctionRemoval, item: String) -> Bool {
  match r {
    RemovedAtBoard { switch } => match switch {
      JumperSwitch { designator: _, off_position: _, citation: _ } => false
      FirmwareSetupSwitch { menu: _, item: i, off_meaning: _, citation: _ } => (i as String) == item
      SwitchNotStated { coarser: _ } => false
    }
    _ => false
  }
}

fn removed_by_host_after_boot(r: BoardFunctionRemoval) -> Bool {
  match r {
    RemovedByHostAfterBoot { residue: _, route: _ } => true
    _ => false
  }
}

fn removal_unmodeled(r: BoardFunctionRemoval) -> Bool {
  match r {
    RemovalUnmodeled { cause: _ } => true
    _ => false
  }
}

fn kept_for(r: BoardFunctionRemoval, module_path: String, decl_name: String) -> Bool {
  match r {
    NothingToRemove { consumer } => consumer == decl_ref(module_path: module_path, decl_name: decl_name)
    _ => false
  }
}

fn kept_for_reset_roster(r: BoardFunctionRemoval) -> Bool {
  kept_for(r: r, module_path: "gunbc.host.host_reset_subject_roster", decl_name: "reset_subject_roster")
}

fn port(p: OnboardEthernetPortRow) -> BoardFunction {
  OnboardEthernetPort { port: p }
}

// Roster completeness, both directions: every arm is listed (the exhaustive match in
// board_function_listed), and the list holds each arm once.
test fn every_board_function_is_listed_once() -> Bool {
  board_function_listed(f: BmcManagementFunction)
    && board_function_listed(f: BmcGraphicsController)
    && board_function_listed(f: PcieErrorFirmwareFirstHandling)
    && !board_function_listed(f: port(p: asrock_altrad8ud_1l2t_lan1))
    && length(board_functions) == 3
}

// The BMC is admitted for its consumer on both boards, so nothing removes it.
test fn the_bmc_is_kept_for_power_control_on_both_boards() -> Bool {
  kept_for_reset_roster(r: board_function_removal(host: operator_host_srv1, catalog: asrock_altrad8ud_1l2t_catalog, f: BmcManagementFunction))
    && kept_for_reset_roster(r: board_function_removal(host: operator_host_6ce85c, catalog: supermicro_h11ssl_catalog, f: BmcManagementFunction))
}

// The discriminating pair for the graphics function. The H11SSL states a graphics-only jumper and
// the plan uses it. The ALTRAD8UD states only BMC_DIS, which removes the admitted BMC too, so the
// plan must NOT pick it: a plan that took the coarser jumper would read as RemovedAtBoard by BMC_DIS
// and fail the first conjunct.
test fn bmc_graphics_is_removed_by_the_narrowest_stated_route() -> Bool {
  let altra = board_function_removal(host: operator_host_srv1, catalog: asrock_altrad8ud_1l2t_catalog, f: BmcGraphicsController)
  removed_by_host_after_boot(r: altra)
    && !removed_at_board_by_jumper(r: altra, designator: "BMC_DIS")
    && removed_at_board_by_jumper(r: board_function_removal(host: operator_host_6ce85c, catalog: supermicro_h11ssl_catalog, f: BmcGraphicsController), designator: "JPG1")
}

// Firmware-first handling: switched off in setup where the manual states the item; where it states
// none, unmodeled. The _OSC AER grant is not accepted as proof the handler is off: it shows who owns
// the AER registers, a separate fact from whether firmware takes an error source first.
test fn firmware_first_error_handling_is_not_admitted() -> Bool {
  removed_at_board_by_setup_item(r: board_function_removal(host: operator_host_srv1, catalog: asrock_altrad8ud_1l2t_catalog, f: PcieErrorFirmwareFirstHandling), item: "PCIe AER Firmware First")
    && removal_unmodeled(r: board_function_removal(host: operator_host_6ce85c, catalog: supermicro_h11ssl_catalog, f: PcieErrorFirmwareFirstHandling))
}

// A board whose switches were never read refuses by name for every function it does not admit,
// rather than borrowing another board's answer.
test fn an_unread_board_refuses() -> Bool {
  removal_unmodeled(r: board_function_removal(host: operator_host_srv1, catalog: gigabyte_mp72_hb0_catalog, f: BmcGraphicsController))
    && removal_unmodeled(r: board_function_removal(host: operator_host_srv1, catalog: gigabyte_mp72_hb0_catalog, f: PcieErrorFirmwareFirstHandling))
}

fn removed_by_route(r: BoardFunctionRemoval) -> Bool {
  match r {
    RemovedByHostAfterBoot { residue: _, route } => route == asrock_altrad8ud_1l2t_x550_route
    _ => false
  }
}

// ETHERNET PORTS ARE ADMITTED PER HOST: by the host's primary network, then by the BMC's read attachment.
// srv1's network is on its I210 (LAN3), so LAN3 is kept for host_primary_network_rows. Its BMC is read on the
// dedicated IPMI LAN, so neither X550 port has a consumer and both are removed by the X550's one route. srv4
// has no primary-network row, so none of its ports may be removed: a plan that removed srv4's X550 by a
// board-wide default could take the port its network runs on, whatever its BMC uses.
test fn ethernet_ports_follow_the_host_network_then_the_bmc() -> Bool {
  kept_for(r: board_function_removal(host: operator_host_srv1, catalog: asrock_altrad8ud_1l2t_catalog, f: port(p: asrock_altrad8ud_1l2t_lan3)), module_path: "gunbc.host.host_primary_network_desired", decl_name: "host_primary_network_rows")
    && removed_by_route(r: board_function_removal(host: operator_host_srv1, catalog: asrock_altrad8ud_1l2t_catalog, f: port(p: asrock_altrad8ud_1l2t_lan1)))
    && removed_by_route(r: board_function_removal(host: operator_host_srv1, catalog: asrock_altrad8ud_1l2t_catalog, f: port(p: asrock_altrad8ud_1l2t_lan2)))
    && removal_unmodeled(r: board_function_removal(host: operator_host_srv4, catalog: asrock_altrad8ud_1l2t_catalog, f: port(p: asrock_altrad8ud_1l2t_lan1)))
    && removal_unmodeled(r: board_function_removal(host: operator_host_srv4, catalog: asrock_altrad8ud_1l2t_catalog, f: port(p: asrock_altrad8ud_1l2t_lan2)))
    && removal_unmodeled(r: board_function_removal(host: operator_host_6ce85c, catalog: supermicro_h11ssl_catalog, f: port(p: supermicro_h11ssl_lan1)))
}

fn is_unread(a: BoardFunctionAdmission) -> Bool { match a { AdmissionUnread { obligation: _ } => true _ => false } }
fn is_not_admitted(a: BoardFunctionAdmission) -> Bool { match a { FunctionNotAdmitted { reason: _ } => true _ => false } }
fn is_admitted(a: BoardFunctionAdmission) -> Bool { match a { FunctionAdmitted { consumer: _ } => true _ => false } }

// THE BMC'S ATTACHMENT DECIDES A PORT THE HOST NETWORK DOES NOT USE, at supplied attachments. Without a read
// the shared LAN1 stays unread -- the manual's marking names the BMC as a possible consumer -- and so does
// LAN2, whose sharing the manual is silent on; a BMC on LAN1 admits LAN1 and not LAN2; a BMC on its dedicated
// port admits neither.
test fn the_bmc_attachment_admits_only_the_port_it_uses() -> Bool {
  let dedicated = Present { value: BmcOnDedicatedPort { grounds: "supplied" } }
  let on_lan1 = Present { value: BmcOnSharedPort { port: asrock_altrad8ud_1l2t_lan1, grounds: "supplied" } }
  is_unread(a: port_admission_by_bmc(port: asrock_altrad8ud_1l2t_lan1, attachment: Absent))
    && is_unread(a: port_admission_by_bmc(port: asrock_altrad8ud_1l2t_lan2, attachment: Absent))
    && is_admitted(a: port_admission_by_bmc(port: asrock_altrad8ud_1l2t_lan1, attachment: on_lan1))
    && is_not_admitted(a: port_admission_by_bmc(port: asrock_altrad8ud_1l2t_lan2, attachment: on_lan1))
    && is_not_admitted(a: port_admission_by_bmc(port: asrock_altrad8ud_1l2t_lan1, attachment: dedicated))
    && is_not_admitted(a: port_admission_by_bmc(port: asrock_altrad8ud_1l2t_lan2, attachment: dedicated))
}

// THE CONTROLLER IS REMOVED WHOLE OR NOT AT ALL. One admitted or unread port keeps the X550 -- and so the
// port being judged -- up, because the host cannot take one of its ports down alone; with every port not
// admitted, the route is the removal, and a controller whose tree was never read has none.
test fn an_ethernet_controller_is_removed_only_when_no_port_on_it_is_admitted() -> Bool {
  let siblings = [asrock_altrad8ud_1l2t_lan1, asrock_altrad8ud_1l2t_lan2]
  let off = FunctionNotAdmitted { reason: "supplied" }
  let route = Present { value: asrock_altrad8ud_1l2t_x550_route }
  removal_unmodeled(r: controller_removal(port: asrock_altrad8ud_1l2t_lan2, siblings: siblings, sibling_admissions: [FunctionAdmitted { consumer: decl_ref(module_path: "supplied", decl_name: "supplied") }, off], route: route))
    && removal_unmodeled(r: controller_removal(port: asrock_altrad8ud_1l2t_lan2, siblings: siblings, sibling_admissions: [AdmissionUnread { obligation: "supplied" }, off], route: route))
    && removal_unmodeled(r: controller_removal(port: asrock_altrad8ud_1l2t_lan2, siblings: siblings, sibling_admissions: [off, off], route: Absent))
    && removed_by_route(r: controller_removal(port: asrock_altrad8ud_1l2t_lan2, siblings: siblings, sibling_admissions: [off, off], route: route))
}

// Where the H11SSL removes a port at the board, it uses that port's own jumper.
test fn h11ssl_lan_ports_have_their_own_jumpers() -> Bool {
  match supermicro_h11ssl_function_switch(f: port(p: supermicro_h11ssl_lan2)) {
    JumperSwitch { designator: d, off_position: _, citation: _ } => (d as String) == "JPL2"
    _ => false
  }
}

fn plan_for(plans: List<HostBoardFunctionPlan>, host: String, f: BoardFunction) -> List<HostBoardFunctionPlan> {
  filter(plans, p => (p.host as String) == host && p.subject == PlannedFunction { board_function: f })
}

// A catalogued board whose port list is unread gets one refusing plan for its ports, not none. srv1 is
// planned on the Gigabyte catalog here only to supply a board whose ports are PortRowsNotRead.
test fn an_unread_port_list_is_a_refusing_plan() -> Bool {
  let unread = filter(machine_board_function_plans(row: MachineBoardRow { host: operator_host_srv1, board: MachineBoardCatalogued { catalog: gigabyte_mp72_hb0_catalog, source: decl_ref(module_path: "extdeps.boards.gigabyte", decl_name: "gigabyte_mp72_hb0_catalog") } }), p => p.subject == PlannedUnreadPorts)
  length(unread) == 1 && all(unread, p => removal_unmodeled(r: p.removal))
}

fn plans_of(plans: List<HostBoardFunctionPlan>, host: String) -> List<HostBoardFunctionPlan> {
  filter(plans, p => (p.host as String) == host)
}

// The real route over every machine the operator holds: the roster has one board row per identity in
// operator_hosts, and each machine gets one plan per function its board carries -- the three common
// functions plus the board's own ports (three on the ALTRAD8UD-1L2T, two on the H11SSL) -- while a board
// with no catalog row gets the three common plans, each refusing, and a provider-owned guest gets none.
test fn fleet_plans_cover_every_machine_by_its_board() -> Bool {
  let plans = fleet_board_function_plans()
  length(machine_board_rows) == length(operator_hosts)
    && all(operator_hosts, h => length(filter(machine_board_rows, r => (r.host as String) == (h as String))) == 1)
    && length(plans_of(plans: plans, host: operator_host_srv1 as String)) == 6
    && length(plans_of(plans: plans, host: operator_host_6ce85c as String)) == 5
    && all(plans_of(plans: plans, host: operator_host_mtjade1 as String), p => removal_unmodeled(r: p.removal))
    && length(plans_of(plans: plans, host: operator_host_mtjade1 as String)) == 3
    && length(plans_of(plans: plans, host: operator_host_183527 as String)) == 0
    && all(plan_for(plans: plans, host: operator_host_srv1 as String, f: BmcGraphicsController), p => removed_by_host_after_boot(r: p.removal))
}
