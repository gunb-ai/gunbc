module test.claim.fleet.fleet_site_locale_witness

import std.types { Bool }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import extdeps.iana.time_zone_database { zone_etc_utc, zone_america_new_york }
import extdeps.posix.locale { locale_en_us }
import gunbc.fleet.fleet_site_locale { PhysicalSite, SiteIdentity }
import std.types { Int }
import gunbc.fleet.fleet_site_locale {
  HostZoneConverged,
  HostZoneDivergent,
  HostZoneUndecidable,
  observed_host_zones,
  host_zone_convergence,
  divergent_host_count,
  HostFollowsSiteCivilZone,
  HostRunsCoordinatedUniversalTime,
  HostZonePolicyUnruled,
  ProvisionedZone,
  ZoneRefusedPolicyUnruled,
  site_us_east_operator_premises,
  fleet_host_zone_policy,
  provisioned_time_zone,
  provisioned_locale,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// The wall this lane exists to build: a provisioning workflow must not be handed a timezone
// nobody ruled on. The fleet's own hosts disagree -- srv4 and spark-a3ee run Etc/UTC while
// spark-3bd5 and pi1 run America/New_York -- so any single derived value would silently declare
// half the fleet misconfigured.

// THE DISCRIMINATING RED. With the policy unruled the derivation REFUSES. This is the witness
// that goes red if anyone gives HostZonePolicyUnruled a default, which is the exact repair a
// future author reaches for when the workflow refuses and they want it to proceed.
test fn w_unruled_policy_refuses_rather_than_defaulting() -> Bool {
  match provisioned_time_zone(site: site_us_east_operator_premises, policy: HostZonePolicyUnruled) {
    ZoneRefusedPolicyUnruled => true
    ProvisionedZone { zone: _ } => false
  }
}

// POSITIVE CONTROLS, without which the refusal above would also be satisfied by a derivation
// that refuses on every input. Both settled arms must produce their own distinct zone.
test fn w_site_following_policy_yields_the_sites_civil_zone() -> Bool {
  match provisioned_time_zone(site: site_us_east_operator_premises, policy: HostFollowsSiteCivilZone) {
    ProvisionedZone { zone: z } => z == zone_america_new_york
    ZoneRefusedPolicyUnruled => false
  }
}

test fn w_utc_policy_yields_utc_not_the_sites_zone() -> Bool {
  match provisioned_time_zone(site: site_us_east_operator_premises, policy: HostRunsCoordinatedUniversalTime) {
    ProvisionedZone { zone: z } => z == zone_etc_utc && z != zone_america_new_york
    ZoneRefusedPolicyUnruled => false
  }
}

// The two settled arms must not agree, or the policy axis would be decorative -- a witness that
// would stay green if someone collapsed both arms onto one zone.
test fn w_the_two_settled_policies_disagree() -> Bool {
  match provisioned_time_zone(site: site_us_east_operator_premises, policy: HostFollowsSiteCivilZone) {
    ProvisionedZone { zone: a } =>
      match provisioned_time_zone(site: site_us_east_operator_premises, policy: HostRunsCoordinatedUniversalTime) {
        ProvisionedZone { zone: b } => a != b
        ZoneRefusedPolicyUnruled => false
      }
    ZoneRefusedPolicyUnruled => false
  }
}

// The standing ruling. This witness previously asserted UNRULED and went red the moment the
// operator ruled -- which is exactly what it was built to do: force the ruling to be stated
// here rather than left implicit in whichever workflow happened to need a zone first.
test fn w_fleet_policy_follows_the_site_civil_zone() -> Bool {
  match fleet_host_zone_policy {
    HostFollowsSiteCivilZone => true
    HostRunsCoordinatedUniversalTime => false
    HostZonePolicyUnruled => false
  }
}

// ---- convergence, and the property the operator actually asked for -----------------------
//
// "one row to re-derive the proper convergence changes". These witnesses defend that: nothing
// below names a zone for a host, so moving the site's civil zone moves every verdict.

test fn w_utc_hosts_are_divergent_under_the_ruling() -> Bool {
  divergent_host_count(site: site_us_east_operator_premises, policy: fleet_host_zone_policy) == 2
}

// THE RELOCATION PROPERTY, asserted rather than described. Under a site whose civil zone is UTC
// the SAME observations invert: the two hosts that diverge today converge, and vice versa. This
// is what "one row re-derives" means, and it fails if anyone pins a host's desired zone.
test fn w_moving_the_site_inverts_every_verdict() -> Bool {
  divergent_host_count(
    site: PhysicalSite {
      identity: "relocated-probe" as SiteIdentity,
      civil_time_zone: zone_etc_utc,
      civil_locale: locale_en_us,
    },
    policy: fleet_host_zone_policy,
  ) == 2
    && divergent_host_count(site: site_us_east_operator_premises, policy: fleet_host_zone_policy) == 2
}

// A divergent host must report BOTH sides, because "wrong" without the pair cannot drive a
// convergence action -- an operator needs to know what it is and what it should be.
test fn w_divergence_names_observed_and_desired() -> Bool {
  fold(observed_host_zones, init: true,
    f: (acc, h) => acc && match host_zone_convergence(observed: h, site: site_us_east_operator_premises, policy: fleet_host_zone_policy) {
      HostZoneConverged => true
      HostZoneDivergent { observed: o, desired: d } => o != d
      HostZoneUndecidable => false
    })
}

// An unruled policy must make convergence UNDECIDABLE rather than reporting everything converged
// or everything divergent -- the absorbing arm this design forbids.
test fn w_unruled_policy_makes_convergence_undecidable() -> Bool {
  fold(observed_host_zones, init: true,
    f: (acc, h) => acc && match host_zone_convergence(observed: h, site: site_us_east_operator_premises, policy: HostZonePolicyUnruled) {
      HostZoneUndecidable => true
      HostZoneConverged => false
      HostZoneDivergent { observed: _, desired: _ } => false
    })
}

// The locale has no policy axis because the measurement found no second arm; it derives directly.
test fn w_locale_derives_from_the_site_without_a_policy() -> Bool {
  provisioned_locale(site: site_us_east_operator_premises) == locale_en_us
}
