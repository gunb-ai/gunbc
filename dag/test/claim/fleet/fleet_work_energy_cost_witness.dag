module test.claim.fleet.fleet_work_energy_cost_witness

import std.types { Bool, Int, NonEmptyStr, String }
import std.algebra { string_contains }
import std.measure { second, watt, watt_count, money_per_kilowatt_hour_micros }
import extdeps.energy.con_edison {
  el1_marginal_volumetric_rate, el1_delivery_rate, el1_system_benefit_rate, el1_supply_rate,
  el1_components, tariff_component_is_marginal,
}
import gunbc.fleet.fleet_host_power {
  fleet_host_power_roster, host_power_profile, power_is_measured,
  measured_host_count, inferred_host_count, srv1_power, host_power_profile, cpu_power_cap_readings,
  reported_saving_upper_bound, power_is_measured,
  MeasuredOnHost, InferredFromSimilarBuild, PowerProvenance,
  confounded_host_power_readings, host_figure_is_still_inferred,
}
import std.algebra { string_contains }
import std.optional { Absent, Present }
import std.measure { hertz_count }
import gunbc.fleet.fleet_host_assembly { host_installed_components, psu_srv1, psu_srv1_b }
import gunbc.fleet.fleet_host_identity { operator_host_srv1, operator_host_srv2 }
import gunbc.fleet.fleet_asset_identity { gpu_board_01, gpu_board_04, gpu_board_05, gpu_board_06 }
import product.placement_supply { physical_asset_identity_eq }
import std.list { list_member }
import gunbc.fleet.cpu_freq_cap_boot_state { cpu_freq_ceiling_standing_read }
import gunbc.fleet.fleet_work_energy_cost {
  WorkEnergyCostOutcome, EnergyCostDerived, EnergyCostRefused, ReadingAppliesToSupersededAssembly,
  DrawPowerStateAttribution, DrawAttributableToHostPowerState, DrawNotAttributableToHostPowerState,
  CpuCeilingNotReadHolding, HostFigureStillInferredWhilePowerStateMoved,
  work_energy_cost, cost_micros, cost_rests_on_measured_power,
}

// THE RATE IS THE SUM OF THE VOLUMETRIC LINE ITEMS AND NOTHING ELSE. Asserting the three
// components separately and their sum means a transcription error in any one row reds here rather
// than silently shifting every price. 20.277 + 0.801 + 16.549 cents = 37.627 cents = 376270 micros.
test fn witness_marginal_rate_sums_only_the_volumetric_components() -> Bool {
  money_per_kilowatt_hour_micros(q: el1_delivery_rate) == 202770
    && money_per_kilowatt_hour_micros(q: el1_system_benefit_rate) == 8010
    && money_per_kilowatt_hour_micros(q: el1_supply_rate) == 165490
    && money_per_kilowatt_hour_micros(q: el1_marginal_volumetric_rate()) == 376270
}

// THE DISCRIMINATING RED FOR THE SUNK-COST RULE. The basic service charge is 22.10 USD per month
// and is paid whether or not any job runs. If it ever leaked into the marginal rate the sum above
// would move, but more importantly the component roster must keep classifying it as non-marginal:
// exactly three components may answer true, and the fixed and proportional ones may not.
test fn witness_fixed_and_proportional_components_are_not_marginal() -> Bool {
  count(filter(el1_components, c => tariff_component_is_marginal(c: c))) == 3
    && count(el1_components) == 7
}

// AN UNCHANGED ASSEMBLY PRICES EXACTLY AS BEFORE THIS MIGRATION. srv2 carries srv1's build-similarity
// figure and its installed configuration is unchanged since it was taken, so the applicability join accepts
// it and the arithmetic is the untouched 94 W one: 94 W x 600 s x 376270 / 3.6e6 truncates to 5894 micro-USD.
// This is the positive half of the discriminating control -- the join must price an applicable reading, not
// refuse everything. The literal is derived from the modeled rows by arithmetic this test restates
// independently, not copied from a run of the code under test.
test fn witness_unchanged_assembly_prices_as_today() -> Bool {
  match work_energy_cost(host: "srv2", duration: second(count: 600)) {
    EnergyCostDerived { cost } =>
      cost_micros(c: cost) == 5894 && watt_count(w: cost.draw) == 94
    EnergyCostRefused { cause: _ } => false
  }
}

// Zero duration costs nothing, and the truncation direction is visible on an applicable reading: a
// one-second job on srv2's 94 W is 94 x 376270 / 3600000 = 9.82 micros, truncating to 9 -- an UNDERSTATEMENT,
// as the carrier says. Asserting the truncated value pins the direction rather than leaving it to prose.
test fn witness_short_work_truncates_downward() -> Bool {
  match work_energy_cost(host: "srv2", duration: second(count: 1)) {
    EnergyCostDerived { cost } => cost_micros(c: cost) == 9
    EnergyCostRefused { cause: _ } => false
  }
}

// AN UNMODELED HOST REFUSES rather than falling back to a fleet average. A default would answer
// every question including the ones about hosts nobody declared, which is the absorbing fallback
// gunbc.design_argument::fail_closed forbids: it destroys the signal that the roster is missing a host.
test fn witness_unknown_host_refuses_rather_than_averaging() -> Bool {
  match work_energy_cost(host: "srv99", duration: second(count: 600)) {
    EnergyCostRefused { cause: _ } => true
    EnergyCostDerived { cost: _ } => false
  }
}

// PROVENANCE SURVIVES INTO THE COST, and the applicability join does not disturb it. srv2 is inferred by
// build similarity and its assembly is unchanged, so it still DERIVES -- it is not refused merely for being
// inferred -- but its cost must report as NOT resting on a measured draw, distinct from a measured host.
// (The fleet's only measured host, srv1, currently refuses on its changed assembly; its measured provenance
// is still preserved on the reading and asserted by the roster and history witnesses below.)
test fn witness_inferred_applicable_host_derives_but_is_flagged_unmeasured() -> Bool {
  match work_energy_cost(host: "srv2", duration: second(count: 600)) {
    EnergyCostDerived { cost } => !cost_rests_on_measured_power(c: cost)
    EnergyCostRefused { cause: _ } => false
  }
}

// The roster's own honesty: three hosts are measured today and one is inferred. This reded on
// 2026-11-24, when the srv3 and srv4 rows stopped being carried on srv1's build similarity and became their
// own ssh readings; the one that remains is srv2, which still refuses the key, and
// per_host_measurement_trigger now names it and nothing else.
test fn witness_roster_reports_three_measured_and_srv2_inferred() -> Bool {
  measured_host_count() == 3
    && inferred_host_count() == 1
    && count(fleet_host_power_roster) == 4
    && power_is_measured(p: srv1_power)
    && match host_power_profile(host: "srv2") {
        Absent => false
        Present { value: p } => !power_is_measured(p: p)
      }
}

// -------------------------------------------------------------------------------------------
// THE 2.0 GHz CAP READINGS. srv3 and srv4 now price work on figures taken under a ceiling their
// srv1 basis never had, so the ceiling has to be a field and not a rumour, and the pair behind each
// figure has to survive as a pair: a single "saving" number would hide the fact that the load changed
// between the two reads.
// -------------------------------------------------------------------------------------------

// EVERY FIGURE SITS UNDER A NAMED CEILING, and the capped hosts' profile figures are the upper end of
// their own band -- the row and the band beside it are the same reading, so neither can drift alone. srv1
// and srv2 keep the 3.0 GHz ceiling they were read under, which is the point: without the field, two of
// these four figures would look comparable to the other two and not be.
test fn witness_capped_hosts_carry_their_ceiling_and_their_band() -> Bool {
  let s3 = match host_power_profile(host: "srv3") {
    Absent => false
    Present { value: p } => p.cpu_ceiling_mhz == 2000 && watt_count(w: p.draw) == 31
  }
  let s4 = match host_power_profile(host: "srv4") {
    Absent => false
    Present { value: p } => p.cpu_ceiling_mhz == 2000 && watt_count(w: p.draw) == 42
  }
  let s2 = match host_power_profile(host: "srv2") {
    Absent => false
    Present { value: p } => p.cpu_ceiling_mhz == 3000
  }
  s3 && s4 && s2 && srv1_power.cpu_ceiling_mhz == 3000
}

// THE PAIR IS COMPLETE AND ORDERED for both capped hosts -- one uncapped reading, one capped band, the
// band's own ends in order -- and no reading pretends to be more than what the instrument was: single
// readings of a named sensor.
test fn witness_cap_readings_are_paired_ordered_and_name_their_instrument() -> Bool {
  ["srv3", "srv4"].all(h =>
    count(filter(cpu_power_cap_readings, r => r.host == h && r.ceiling_mhz == 3000)) == 1
      && count(filter(cpu_power_cap_readings, r => r.host == h && r.ceiling_mhz == 2000)) == 1
      && filter(cpu_power_cap_readings, r => r.host == h).all(r =>
        watt_count(w: r.low_watts) <= watt_count(w: r.high_watts)
          && string_contains(s: r.instrument as String, pattern: "apm_xgene")
          && !string_contains(s: r.instrument as String, pattern: "average of"))
  )
}

// THE SAVING IS A BOUND, AND ONLY WHERE THE TWO READS EXIST: present on the two hosts that were read
// before and after, absent on the two that were not. The absence is the load-bearing half -- a fold that
// invented a saving for srv1 or srv2 out of a nine-month-old read taken at another ceiling would sail
// through a test that only checked the positive cases.
fn bound_matches(host: NonEmptyStr, expected_watts: Nat) -> Bool {
  match reported_saving_upper_bound(host: host) {
    Absent => expected_watts == 0
    Present { value: w } => expected_watts > 0 && watt_count(w: w) == expected_watts
  }
}

test fn witness_saving_bound_exists_only_where_both_reads_do() -> Bool {
  bound_matches(host: "srv3", expected_watts: 34)
    && bound_matches(host: "srv4", expected_watts: 59)
    && bound_matches(host: "srv1", expected_watts: 0)
    && bound_matches(host: "srv2", expected_watts: 0)
}

// THE 2026-11-24 STEP DOWN DID NOT BUY A MEASURED FIGURE. The operator read each Strata host's CPU package power
// either side of the power caps going in -- srv4 101 W and then 39-42 W, srv3 65 W and then 29-31 W -- and the
// load on the host moved between the two readings, so the step belongs to the caps and the quieter machine
// together. Both halves are asserted at once, because they are one standing: every confounded reading names a host
// whose roster figure is STILL the carried srv1 inference (provenance half -- promote srv3 or srv4 to
// MeasuredOnHost on the strength of these numbers and this goes red), and each row's band is in the order the
// operator reported it, later band below the earlier reading (transcription half -- flip 39 W and 42 W, or copy a
// low figure into the profile, and it goes red too).
test fn witness_confounded_cap_readings_leave_their_hosts_inferred() -> Bool {
  confounded_host_power_readings.length() == 2
    && confounded_host_power_readings.all(r =>
      host_figure_is_still_inferred(host: r.host)
        && watt_count(w: r.later_low_watts) < watt_count(w: r.later_high_watts)
        && watt_count(w: r.later_high_watts) < watt_count(w: r.earlier_watts)
        && string_contains(s: r.confound as String, pattern: "load")
        && match host_power_profile(host: r.host) {
          Absent => false
          Present { value: p } =>
            watt_count(w: p.draw) == 94
              && match p.provenance {
                InferredFromSimilarBuild { basis_host, basis_reason: _ } => (basis_host as String) == "srv1"
                MeasuredOnHost { sample_count: _, sensor: _, observed_on: _ } => false
              }
        })
}

// THE CAP STATE TRAVELS WITH THE PRICE. srv3 keeps pricing -- the roster's only figure for it is srv1's, and
// refusing would leave its work unquotable rather than honest -- but the cost it produces now carries BOTH gaps
// that separate that figure from the machine it runs on: the CPU ceiling applied on 2026-11-24 whose standing no
// read has settled (with the unit, the applied figure, the part's rated clock, and the one read that would make
// the figure attributable), and the cap-day wattage pair that moved together with the load (with the basis host
// and what confounded it). srv2, which has no ceiling and no confounded pair, is the control: it answers
// Attributable, so this is a claim about these hosts' state and not a label the fold stamps on everyone. If a
// standing is ever promoted to read-holding, or one half of the confounded pair is promoted into the priced
// figure, this reds -- which is the point: the cost can no longer say a figure describes a host whose clock
// nobody has read.
test fn witness_capped_hosts_price_while_their_power_state_stays_unattributed() -> Bool {
  let srv3_attribution = match work_energy_cost(host: "srv3", duration: second(count: 600)) {
    EnergyCostDerived { cost: c } => Present { value: c.power_state_attribution }
    EnergyCostRefused { cause: _ } => Absent
  }
  let srv2_attribution = match work_energy_cost(host: "srv2", duration: second(count: 600)) {
    EnergyCostDerived { cost: c } => Present { value: c.power_state_attribution }
    EnergyCostRefused { cause: _ } => Absent
  }
  match srv3_attribution {
    Absent => false
    Present { value: a } => match a {
      DrawAttributableToHostPowerState { host: _ } => false
      DrawNotAttributableToHostPowerState { host: h, gaps } =>
        (h as String) == "srv3"
          && gaps.length() == 2
          && gaps.any(g => match g {
            CpuCeilingNotReadHolding {
              host: gh, unit_path, applied_on, applied_ceiling, parts_rated_clock,
              sits_below_the_parts_rated_clock, what_would_make_it_attributable,
            } =>
              (gh as String) == "srv3"
                && (unit_path as String) == "/etc/systemd/system/cpu-freq-cap.service"
                && (applied_on as String) == "2026-11-24"
                && hertz_count(h: applied_ceiling) == 2000000000
                && hertz_count(h: parts_rated_clock) == 3000000000
                && sits_below_the_parts_rated_clock
                && (what_would_make_it_attributable as String) == (cpu_freq_ceiling_standing_read as String)
            HostFigureStillInferredWhilePowerStateMoved {
              host: _, basis_host: _, observed_on: _, confound: _,
            } => false
          })
          && gaps.any(g => match g {
            CpuCeilingNotReadHolding {
              host: _, unit_path: _, applied_on: _, applied_ceiling: _, parts_rated_clock: _,
              sits_below_the_parts_rated_clock: _, what_would_make_it_attributable: _,
            } => false
            HostFigureStillInferredWhilePowerStateMoved {
              host: gh, basis_host, observed_on, confound,
            } =>
              (gh as String) == "srv3"
                && (basis_host as String) == "srv1"
                && string_contains(s: observed_on as String, pattern: "2026-11-24")
                && string_contains(s: confound as String, pattern: "load")
          })
    }
  }
    && match srv2_attribution {
      Absent => false
      Present { value: a } => match a {
        DrawAttributableToHostPowerState { host: h } => (h as String) == "srv2"
        DrawNotAttributableToHostPowerState { host: _, gaps: _ } => false
      }
    }
}
