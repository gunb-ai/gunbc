module test.claim.fleet.fleet_converge_arrival_step_budget_witness

// WHY THIS WITNESS EXISTS. Dispatch 44249358201 ran the arrival lane and killed it before the controller
// was ever contacted: the arrival-converge STEP carried the flat gunbc_ci_aux_step_timeout_minutes figure,
// and the door's closure spent ~107 s of load, 80 s of compile.frontend and 4 s of compile.normalize, so
// GitHub ended the step at 313 s of wall with reconcile still open. The receipt's own lines say what that
// cost: zero ipmitool or curl calls, so zero carriers, zero prior-life archive, zero BmcSecure standing,
// no interlock acquired and nothing to release -- one day out of srv15's install window, spent on loading.
// The mode is named in the roadmap at gunbc.recurring_failure_mode.gunbc_run_pays_a_large_fixed_pre_entry_cost_per_invocation,
// and fan_observe and the runner-host read steps already moved off the flat figure after the same kill.
// These claims hold the arrival lane's replacement: the step's budget is the FOLD over the door's declared
// phases, the job's backstop covers its steps under the platform ceiling, and a revert to either flat
// figure is RED in review instead of RED only inside a live dispatch.

import gunbc.fleet.fleet_converge_workflow {
  fleet_converge_arrival_converge_job,
  fleet_converge_arrival_converge_step_timeout_minutes,
  fleet_converge_arrival_converge_job_backstop_timeout_minutes,
  fleet_converge_arrival_converge_backstop_holds,
  fleet_converge_gunbc_run_step_timeout_minutes,
}
import gunbc.fleet.fleet_workflow_steps {
  gunbc_ci_aux_step_timeout_minutes,
  gunbc_ci_artifact_transfer_step_timeout_minutes,
  gunbc_ci_prelude_allowance_minutes,
  gunbc_ci_gunbc_run_resolve_step_timeout_minutes,
}
import gunbc.auth.secret_manager_shell_fetch { gunbc_ci_sm_max_time }
import gunbc.machine_intake.arrival_run {
  arrival_candidate_channel_numbers, arrival_single_ipmi_legs, arrival_counted_census_ops,
  arrival_ipmi_leg_bound, arrival_wet_ipmi_legs_bound,
}
import gunbc.machine_intake.prior_life_capture_live {
  live_prior_life_ipmi_legs, live_prior_life_redfish_single_call_legs, live_ipmi_leg_bound,
  live_prior_life_legs_bound, live_redfish_read_budget, live_log_services_read_bound,
}
import extdeps.github.actions { Step, RunStep, UsesStep, max_job_timeout_minutes }
import std.types { Bool, List, NonEmptyStr, String }
import std.optional { Present, Absent }
import std.measure { second_count }

fn step_id_of(s: Step) -> NonEmptyStr {
  match s {
    RunStep { name: _, id: i, run: _, shell: _, env: _, working_directory: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } =>
      match i {
        Present { value: v } => v
        Absent => ""
      }
    UsesStep { name: _, id: i, uses: _, with: _, env: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } =>
      match i {
        Present { value: v } => v
        Absent => ""
      }
  }
}

fn step_timeout_of(s: Step) -> Int {
  match s {
    RunStep { name: _, id: _, run: _, shell: _, env: _, working_directory: _, if_condition: _, continue_on_error: _, timeout_minutes: t } =>
      match t {
        Present { value: m } => m
        Absent => 0
      }
    UsesStep { name: _, id: _, uses: _, with: _, env: _, if_condition: _, continue_on_error: _, timeout_minutes: t } =>
      match t {
        Present { value: m } => m
        Absent => 0
      }
  }
}

// The timeouts of the arrival job's steps that carry a given id: exactly one row per step, so a claim
// that sees length 1 is a claim about ONE step, not about a name that matches nothing.
fn arrival_step_timeouts(step_id: NonEmptyStr) -> List<Int> {
  fold(fleet_converge_arrival_converge_job().steps, init: [], f: (acc, s) =>
    if step_id_of(s) == step_id { acc + [step_timeout_of(s: s)] } else { acc })
}

fn arrival_job_timeout_minutes() -> Int {
  match fleet_converge_arrival_converge_job().timeout_minutes {
    Present { value: m } => m
    Absent => 0
  }
}

// The converge step's timeout IS the fold, read off the job that runs it.
// RED if the fold's call site is edited away while the figure stays plausible.
test fn the_arrival_converge_step_carries_the_step_fold() -> Bool {
  let t = arrival_step_timeouts(step_id: "arrival_converge")
  t.length() == 1
    && any(t, m => m == fleet_converge_arrival_converge_step_timeout_minutes())
    && all(t, m => m == fleet_converge_gunbc_run_step_timeout_minutes(phases: [gunbc_ci_sm_max_time, arrival_wet_ipmi_legs_bound(), live_prior_life_legs_bound()]))
}

// RED: put the step back on gunbc_ci_aux_step_timeout_minutes. That is the figure that killed
// 44249358201 in load, with the door's first BMC call still queued; the step must outlive the closure's
// load by the door's whole BMC wall, so it is strictly greater than the aux figure, not merely different.
test fn the_arrival_converge_step_is_not_on_the_flat_aux_figure() -> Bool {
  let t = arrival_step_timeouts(step_id: "arrival_converge")
  t.length() == 1
    && all(t, m => m > gunbc_ci_aux_step_timeout_minutes && m != gunbc_ci_aux_step_timeout_minutes)
}

// THE FOLD COVERS ITS PHASES, each counted once: the resolve allowance plus the credential read plus both
// leg rosters, in seconds, is inside the minute figure the step carries. This is the claim that fails if a
// leg is added to a roster and the step's phases list stops naming the bound.
test fn the_step_fold_covers_the_resolve_allowance_and_every_declared_leg() -> Bool {
  let seconds = (gunbc_ci_gunbc_run_resolve_step_timeout_minutes * 60)
    + (second_count(s: gunbc_ci_sm_max_time) as Int)
    + (second_count(s: arrival_wet_ipmi_legs_bound()) as Int)
    + (second_count(s: live_prior_life_legs_bound()) as Int)
  (fleet_converge_arrival_converge_step_timeout_minutes() * 60) >= seconds
}

// THE PHASES COME FROM THE DECLARED LEGS, not from a number typed at the call site: each roster is
// non-empty, and each bound is at least one per-leg bound per declared leg. A roster emptied to make a
// budget fit is RED here before it is a live run that reads less than the controller has to say.
test fn the_leg_rosters_are_what_the_bounds_fold() -> Bool {
  let ipmi_legs = length(xs: live_prior_life_ipmi_legs)
  let redfish_legs = length(xs: live_prior_life_redfish_single_call_legs)
  ipmi_legs > 0
    && redfish_legs > 0
    && (second_count(s: live_prior_life_legs_bound()) as Int)
        >= (ipmi_legs * (second_count(s: live_ipmi_leg_bound()) as Int))
          + ((redfish_legs + live_log_services_read_bound) * (second_count(s: live_redfish_read_budget) as Int))
    && length(xs: arrival_single_ipmi_legs) > 0
    && length(xs: arrival_counted_census_ops) > 0
    && length(xs: arrival_candidate_channel_numbers) > 0
    && (second_count(s: arrival_wet_ipmi_legs_bound()) as Int)
        >= ((length(xs: arrival_candidate_channel_numbers)
            + length(xs: arrival_single_ipmi_legs)
            + length(xs: arrival_counted_census_ops)) * (second_count(s: arrival_ipmi_leg_bound()) as Int))
}

// THE JOB'S BACKSTOP IS THE SUM OF ITS STEPS, and the projection carries that sum, not the old
// aux + 20. RED: put the job back on aux + 20 -- a step with room and a job that kills it earlier is the
// same refusal with a different line number.
test fn the_arrival_job_backstop_covers_its_steps_and_is_not_the_flat_sum() -> Bool {
  let job = arrival_job_timeout_minutes()
  let steps = (gunbc_ci_prelude_allowance_minutes + gunbc_ci_artifact_transfer_step_timeout_minutes
      + (3 * gunbc_ci_aux_step_timeout_minutes) + fleet_converge_arrival_converge_step_timeout_minutes())
  job > 0
    && job == fleet_converge_arrival_converge_job_backstop_timeout_minutes()
    && job >= steps
    && job != gunbc_ci_aux_step_timeout_minutes + 20
}

// THE CEILING IS CHECKED, NEVER CLAMPED: the job's backstop sits under
// extdeps.github.actions max_job_timeout_minutes, and the predicate that guards emission is the one the
// generation route consults. If a future leg roster pushes the figure past the ceiling, generation
// refuses with a named reason -- the claim goes RED at the same moment, which is the point.
test fn the_arrival_job_backstop_holds_under_the_platform_ceiling() -> Bool {
  arrival_converge_ceiling_holds()
    && arrival_job_timeout_minutes() <= max_job_timeout_minutes
}

fn arrival_converge_ceiling_holds() -> Bool {
  fleet_converge_arrival_converge_backstop_holds()
}

// THE STEPS AROUND THE DOOR KEEP THEIR OWN BUDGETS: the credential-free admission and the WIF auth stay
// on the aux figure -- they print nothing and read nothing from the controller, so widening them would
// hide a change of character. Pinned so the arrival step's raise cannot be used as cover.
test fn the_arrival_jobs_aux_steps_stay_on_the_aux_figure() -> Bool {
  let admit = arrival_step_timeouts(step_id: "arrival_admit")
  admit.length() == 1 && all(admit, m => m == gunbc_ci_aux_step_timeout_minutes)
}
