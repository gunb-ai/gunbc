module test.claim.fleet.fleet_machine_unit_binding_witness

// W1 (physical half) of gunbc.plans.fleet_machine_authority: the A2 admission over observed board serials.
// The registry half (a handle or a name claimed twice, a pending name colliding) is
// test.claim.hostname_allocation_witness. Fixture serials below are planted; the duplicate case uses the
// srv13/srv15 serial because that is the shape that entered the fleet twice
// (gunbc.integration_concern::srv13_and_srv15_name_one_board).

import std.types { Bool, List, NonEmptyStr, String }
import std.optional { Absent, Present }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import product.host_identity { HostIdentity }
import gunbc.machine_intake.subject {
  BmcFru,
  BmcObserved,
  BoardSerialContradictory,
  BoardSerialDuplicatedAcrossUnits,
  BoardSerialObservation,
  HostSmbios,
  UnitIdentityInputs,
  UnitKey,
  BoardUnitKey,
  ProviderUnitKey,
  UnitKeyBound,
  UnitKeyRefused,
  ProviderResourceIdAbsent,
  UnitIdentityKindContradictory,
  IntakeAttemptId,
  MachineIntakeSubject,
  qualification_subject_of,
  bind_unit_key,
}
import extdeps.bmc.endpoint { BmcEndpoint, Ipmi }
import product.supplier.hetzner { hetzner_provider_ref, hetzner_nuremberg_route }
import gunbc.fleet.fleet_host_provider_observation { provider_resource_unit_identity_inputs }
import gunbc.machine_intake.mtcollins1_bmc_secure_observation {
  mtcollins1_unit_identity_inputs,
  mtcollins1_unit_key_standing,
  mtcollins1_assembly,
  mtcollins1_firmware_manifest,
}
import gunbc.fleet.fleet_host_identity { operator_host_mtcollins1, operator_host_183527, operator_host_3dde7f }
import gunbc.fleet.fleet_host_backing { OwnedMachine, OwnedProvisioning, Bmc, InstalledViaVirtualMedia, HostUnitUnobserved, ProviderResourcePresent, resolve_host_unit }
import gunbc.host.physical_machine_binding { PhysicalMachineRefused, PhysicalMachineSubjectUnitMismatch, PhysicalMachineUnitKeyRefused, PhysicalMachineAdmitted, physical_machine_admission }
import gunbc.fleet.fleet_machine_unit_binding {
  MachineUnitEvidence,
  MachineUnitBound,
  MachineUnitRefused,
  MachineUnitUnitHeldByAnother,
  MachineEvidenceRepeated,
  MachineUnitBinding,
  admit_machine_units,
  fleet_machine_unit_admission,
  machine_unit_admission_refusals,
  machine_unit_standing,
  machine_unit_standing_in,
  bound_unit_keys_except_in,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn machine(label: String) -> HostIdentity { label as HostIdentity }

// A fixture BMC endpoint for board-evidence rows. bind_unit_key never reads it, so its value
// is immaterial to what these witnesses check (the 'BMC IP changes: same unit' property is
// exactly that non-dependence); only a board reading is ever claimed.
fn fixture_bmc_endpoint() -> BmcEndpoint {
  BmcEndpoint { host: "127.0.0.1" as NonEmptyStr, protocol: Ipmi }
}

fn evidence(m: String, fru: String, smbios: String) -> MachineUnitEvidence {
  MachineUnitEvidence {
    machine: machine(label: m),
    inputs: BmcObserved {
      bmc_endpoint: fixture_bmc_endpoint(),
      board_serial_observations: [
        BoardSerialObservation { source: BmcFru, serial: fru as NonEmptyStr },
        BoardSerialObservation { source: HostSmbios, serial: smbios as NonEmptyStr },
      ],
    },
  }
}

// RED: two machines observed on one board serial. The second is refused and the refusal names both.
test fn two_machines_on_one_observed_serial_refuse_naming_both() -> Bool {
  let admission = admit_machine_units(evidence: [
    evidence(m: "fixture-a", fru: "BR80S6102300049", smbios: "BR80S6102300049"),
    evidence(m: "fixture-b", fru: "BR80S6102300049", smbios: "BR80S6102300049"),
  ])
  match admission.standings.get(index: 1) {
    Present { value: s } => match s {
      MachineUnitUnitHeldByAnother { machine: m, holder: h, unit: d } =>
        (m as String) == "fixture-b" && (h as String) == "fixture-a" && (d.value as String) == "BR80S6102300049"
      MachineUnitBound { machine: _, unit: _ } => false
      MachineUnitRefused { machine: _, cause: _ } => false
      MachineEvidenceRepeated { machine: _ } => false
    }
    Absent => false
  }
}

// THE INJECTIVE MAP: after a duplicate, the serial is bound once, to its first holder, and the second machine's
// standing is bind_unit_key's duplicate refusal.
test fn a_duplicate_serial_is_bound_once_and_the_second_machine_refuses() -> Bool {
  let admission = admit_machine_units(evidence: [
    evidence(m: "fixture-a", fru: "BR80S6102300049", smbios: "BR80S6102300049"),
    evidence(m: "fixture-c", fru: "SERIAL-THREE", smbios: "SERIAL-THREE"),
    evidence(m: "fixture-b", fru: "BR80S6102300049", smbios: "BR80S6102300049"),
  ])
  let once = map(admission.bound, b => b.unit.value as String) == ["BR80S6102300049", "SERIAL-THREE"]
  let second = match machine_unit_standing_in(admission: admission, machine: machine(label: "fixture-b")) {
    Present { value: u } => match u {
      UnitKeyRefused { cause: c } => match c {
        BoardSerialDuplicatedAcrossUnits { serial: d } => (d as String) == "BR80S6102300049"
        _ => false
      }
      UnitKeyBound { key: _ } => false
    }
    Absent => false
  }
  let order = map(admission.standings, s => match s {
    MachineUnitBound { machine: m, unit: _ } => m as String
    MachineUnitRefused { machine: m, cause: _ } => m as String
    MachineUnitUnitHeldByAnother { machine: m, holder: _, unit: _ } => m as String
    MachineEvidenceRepeated { machine: m } => m as String
  }) == ["fixture-a", "fixture-c", "fixture-b"]
  once && second && order
}

// RED: the BMC's FRU and the host's SMBIOS disagree, so the machine binds no unit.
test fn contradictory_serial_readings_refuse() -> Bool {
  match admit_machine_units(evidence: [evidence(m: "fixture-a", fru: "SERIAL-ONE", smbios: "SERIAL-TWO")]).standings.first() {
    Present { value: s } => match s {
      MachineUnitRefused { machine: _, cause: c } => match c {
        BoardSerialContradictory { observations: o } => o.length() == 2
        _ => false
      }
      MachineUnitBound { machine: _, unit: _ } => false
      MachineUnitUnitHeldByAnother { machine: _, holder: _, unit: _ } => false
      MachineEvidenceRepeated { machine: _ } => false
    }
    Absent => false
  }
}

// RED: a machine's evidence given twice with DIFFERENT serials is re-judged over all its readings, so it is
// refused with bind_unit_key's BoardSerialContradictory, reported as repeated, holds no binding, and the
// downstream physical-machine admission refuses to seal against the first serial.
test fn repeated_contradictory_evidence_leaves_no_actionable_binding() -> Bool {
  let admission = admit_machine_units(evidence: [
    evidence(m: "fixture-a", fru: "SERIAL-ONE", smbios: "SERIAL-ONE"),
    evidence(m: "fixture-a", fru: "SERIAL-TWO", smbios: "SERIAL-TWO"),
  ])
  let reported = any(machine_unit_admission_refusals(standings: admission.standings), s => match s {
    MachineEvidenceRepeated { machine: m } => (m as String) == "fixture-a"
    MachineUnitBound { machine: _, unit: _ } => false
    MachineUnitRefused { machine: _, cause: _ } => false
    MachineUnitUnitHeldByAnother { machine: _, holder: _, unit: _ } => false
  })
  let unbound = admission.bound.length() == 0
  match machine_unit_standing_in(admission: admission, machine: machine(label: "fixture-a")) {
    Present { value: u } =>
      reported && unbound
        && (match u {
          UnitKeyRefused { cause: c } => match c {
            BoardSerialContradictory { observations: o } => o.length() == 4
            _ => false
          }
          UnitKeyBound { key: _ } => false
        })
        && (match physical_machine_admission(
          host: machine(label: "fixture-a"),
          unit_standing: u,
          current_subject: Present { value: subject_for(unit: UnitKey { kind: BoardUnitKey, value: "SERIAL-ONE" }) },
          fleet: Absent,
          control: Absent,
        ) {
          PhysicalMachineRefused { cause: PhysicalMachineUnitKeyRefused { cause: _ } } => true
          _ => false
        })
    Absent => false
  }
}

// A repeated row whose readings AGREE is reported but still binds its one serial: a reading repeated is not a
// contradiction, and the fold invents no refusal bind_unit_key does not have. The serial is bound once.
test fn repeated_agreeing_evidence_is_reported_and_binds_once() -> Bool {
  let admission = admit_machine_units(evidence: [
    evidence(m: "fixture-a", fru: "SERIAL-ONE", smbios: "SERIAL-ONE"),
    evidence(m: "fixture-a", fru: "SERIAL-ONE", smbios: "SERIAL-ONE"),
  ])
  let reported = machine_unit_admission_refusals(standings: admission.standings).length() == 1
  let once = map(admission.bound, b => b.unit.value as String) == ["SERIAL-ONE"]
  reported && once
}

// A MACHINE REFUSED THEN BOUND IS BOUND, IN EVERY READING OF THE FOLD: its first row has no serial
// (BoardSerialAbsent), its second supplies agreeing readings, so the standing, the bound list and the keys a
// second machine is checked against all name its serial -- and a rival machine on that serial refuses.
fn unread_evidence(m: String) -> MachineUnitEvidence {
  MachineUnitEvidence {
    machine: machine(label: m),
    inputs: BmcObserved { bmc_endpoint: fixture_bmc_endpoint(), board_serial_observations: [] },
  }
}

test fn a_machine_refused_then_bound_is_bound_everywhere() -> Bool {
  let admission = admit_machine_units(evidence: [
    unread_evidence(m: "fixture-a"),
    evidence(m: "fixture-a", fru: "SERIAL-ONE", smbios: "SERIAL-ONE"),
  ])
  let standing = match machine_unit_standing_in(admission: admission, machine: machine(label: "fixture-a")) {
    Present { value: u } => match u {
      UnitKeyBound { key: k } => (k.value as String) == "SERIAL-ONE"
      UnitKeyRefused { cause: _ } => false
    }
    Absent => false
  }
  let listed = map(admission.bound, b => b.unit.value as String) == ["SERIAL-ONE"]
  let rival = match bind_unit_key(
    inputs: evidence(m: "fixture-b", fru: "SERIAL-ONE", smbios: "SERIAL-ONE").inputs,
    other_units: bound_unit_keys_except_in(admission: admission, machine: machine(label: "fixture-b")),
  ) {
    UnitKeyRefused { cause: c } => match c {
      BoardSerialDuplicatedAcrossUnits { serial: _ } => true
      _ => false
    }
    UnitKeyBound { key: _ } => false
  }
  standing && listed && rival
}

// A REFUSED HOLDER'S CLAIM STILL RESERVES ITS SERIAL: A claims S1, then contradicts itself with S2 and is
// refused. B arriving on S1 refuses as duplicated, A's own re-read of S1 refuses too (its exclusion lapses with
// its binding), and A's physical binding stays refused.
test fn a_refused_holders_claim_still_refuses_an_arrival() -> Bool {
  let admission = admit_machine_units(evidence: [
    evidence(m: "fixture-a", fru: "SERIAL-ONE", smbios: "SERIAL-ONE"),
    evidence(m: "fixture-a", fru: "SERIAL-TWO", smbios: "SERIAL-TWO"),
  ])
  let duplicated = fn(u) {
    match u {
      UnitKeyRefused { cause: c } => match c {
        BoardSerialDuplicatedAcrossUnits { serial: d } => (d as String) == "SERIAL-ONE"
        _ => false
      }
      UnitKeyBound { key: _ } => false
    }
  }
  let rival = duplicated(bind_unit_key(
    inputs: evidence(m: "fixture-b", fru: "SERIAL-ONE", smbios: "SERIAL-ONE").inputs,
    other_units: bound_unit_keys_except_in(admission: admission, machine: machine(label: "fixture-b")),
  ))
  let reread = duplicated(bind_unit_key(
    inputs: evidence(m: "fixture-a", fru: "SERIAL-ONE", smbios: "SERIAL-ONE").inputs,
    other_units: bound_unit_keys_except_in(admission: admission, machine: machine(label: "fixture-a")),
  ))
  let still_refused = match machine_unit_standing_in(admission: admission, machine: machine(label: "fixture-a")) {
    Present { value: u } => match physical_machine_admission(
      host: machine(label: "fixture-a"),
      unit_standing: u,
      current_subject: Present { value: subject_for(unit: UnitKey { kind: BoardUnitKey, value: "SERIAL-ONE" }) },
      fleet: Absent,
      control: Absent,
    ) {
      PhysicalMachineRefused { cause: PhysicalMachineUnitKeyRefused { cause: _ } } => true
      _ => false
    }
    Absent => false
  }
  rival && reread && still_refused && admission.bound.length() == 0 && admission.claims.length() == 1
}

// RE-ENTRY: an admitted machine read again binds its own serial (its own binding is not among the other units),
// while a second machine claiming that serial still refuses as duplicated.
test fn an_admitted_machine_rereads_its_own_serial_and_another_still_refuses() -> Bool {
  let admission = admit_machine_units(evidence: [
    evidence(m: "fixture-a", fru: "SERIAL-ONE", smbios: "SERIAL-ONE"),
    evidence(m: "fixture-c", fru: "SERIAL-THREE", smbios: "SERIAL-THREE"),
  ])
  let reread = bind_unit_key(
    inputs: evidence(m: "fixture-a", fru: "SERIAL-ONE", smbios: "SERIAL-ONE").inputs,
    other_units: bound_unit_keys_except_in(admission: admission, machine: machine(label: "fixture-a")),
  )
  let rival = bind_unit_key(
    inputs: evidence(m: "fixture-b", fru: "SERIAL-ONE", smbios: "SERIAL-ONE").inputs,
    other_units: bound_unit_keys_except_in(admission: admission, machine: machine(label: "fixture-b")),
  )
  (match reread {
    UnitKeyBound { key: k } => (k.value as String) == "SERIAL-ONE"
    UnitKeyRefused { cause: _ } => false
  }) && (match rival {
    UnitKeyRefused { cause: c } => match c {
      BoardSerialDuplicatedAcrossUnits { serial: d } => (d as String) == "SERIAL-ONE"
      _ => false
    }
    UnitKeyBound { key: _ } => false
  })
}

// A REGISTERED MACHINE WITH NO READING is absent from A2, and its backing row stays unobserved with its read
// obligation rather than claiming a key.
test fn unread_machine_is_absent_and_its_backing_unobserved() -> Bool {
  let admission = admit_machine_units(evidence: [evidence(m: "fixture-a", fru: "SERIAL-ONE", smbios: "SERIAL-ONE")])
  let unread = machine_unit_standing_in(admission: admission, machine: machine(label: "fixture-unread"))
  let absent = match unread {
    Absent => true
    Present { value: _ } => false
  }
  let unobserved = match resolve_host_unit(backing: OwnedMachine {
    provisioning: OwnedProvisioning { control: Bmc, delivery: InstalledViaVirtualMedia },
    unit: unread,
  }) {
    HostUnitUnobserved { trigger: _ } => true
    _ => false
  }
  absent && unobserved
}

// A BOARD SWAP REBINDS THE SAME HANDLE: a later reading binds the machine to the new unit, and a qualification
// subject built for the old board refuses to seal against it.
fn subject_for(unit: UnitKey) -> MachineIntakeSubject {
  MachineIntakeSubject {
    subject: qualification_subject_of(unit_key: unit, assembly: mtcollins1_assembly, firmware: mtcollins1_firmware_manifest),
    attempt_id: "fixture-attempt" as IntakeAttemptId,
  }
}

test fn board_swap_rebinds_the_handle_and_old_subject_refuses() -> Bool {
  let after = admit_machine_units(evidence: [evidence(m: "fixture-a", fru: "SERIAL-NEW", smbios: "SERIAL-NEW")])
  match machine_unit_standing_in(admission: after, machine: machine(label: "fixture-a")) {
    Present { value: u } => match u {
      UnitKeyBound { key: k } =>
        (k.value as String) == "SERIAL-NEW"
          && (match physical_machine_admission(
            host: machine(label: "fixture-a"),
            unit_standing: u,
            current_subject: Present { value: subject_for(unit: UnitKey { kind: BoardUnitKey, value: "SERIAL-OLD" }) },
            fleet: Absent,
            control: Absent,
          ) {
            PhysicalMachineRefused { cause: PhysicalMachineSubjectUnitMismatch { physical_unit: p, subject_unit: s } } =>
              (p.value == "SERIAL-NEW") && (s.value == "SERIAL-OLD")
            _ => false
          })
      UnitKeyRefused { cause: _ } => false
    }
    Absent => false
  }
}

// POSITIVE CONTROL ON THE REAL PRODUCER: the production evidence admits with no refusal, and mtcollins1 is bound
// to exactly the unit its own intake observation binds (gunbc.machine_intake.mtcollins1_bmc_secure_observation).
test fn production_evidence_admits_and_mtcollins1_binds_its_observed_unit() -> Bool {
  let clean = machine_unit_admission_refusals(standings: fleet_machine_unit_admission.standings).length() == 0
  let same = match machine_unit_standing(machine: operator_host_mtcollins1) {
    Present { value: u } => match u {
      UnitKeyBound { key: k } => match mtcollins1_unit_key_standing {
        UnitKeyBound { key: expected } => k == expected
        UnitKeyRefused { cause: _ } => false
      }
      UnitKeyRefused { cause: _ } => false
    }
    Absent => false
  }
  clean && same
}

// ===================== W1 provider half: Hetzner guests through the SAME fold =====================
// P3's Hetzner coverage: a rented guest's unit identity is grounded by its acquired provider
// resource id (the existing ProviderResourceBinding), and it arrives at A2 through the very fold
// the board serials use -- never by its host name. gunbc.plans.fleet_machine_authority P3/P10.x.

fn unit_is_provider_kind(unit: UnitKey) -> Bool {
  match unit.kind {
    ProviderUnitKey { provider: _ } => true
    BoardUnitKey => false
  }
}

fn unit_is_board_kind(unit: UnitKey) -> Bool {
  match unit.kind {
    BoardUnitKey => true
    ProviderUnitKey { provider: _ } => false
  }
}

fn bound_is_provider_kind(bound: List<MachineUnitBinding>, m: String) -> Bool {
  bound |> any(b => (b.machine as String) == m && unit_is_provider_kind(unit: b.unit))
}

fn bound_is_board_kind(bound: List<MachineUnitBinding>, m: String) -> Bool {
  bound |> any(b => (b.machine as String) == m && unit_is_board_kind(unit: b.unit))
}

// THE GUESTS BIND THROUGH THE REAL FOLD FROM THEIR BINDING ROWS. host-183527 (nbg1) and host-3dde7f
// (hel1) are in the production evidence; each must be bound to exactly its provider resource id, and
// bound under the PROVIDER kind naming Hetzner -- not as a board. This runs the real A2 fold over the
// real producer rows (gunbc.fleet.fleet_host_provider_observation), not a hand-planted unit.
// A provider-resource fixture carrying `serial` as the provider resource id. The production guest<->resource
// mapping is gunbc.fleet.hetzner_cloud_acquisition hetzner_guest_bindings (which the fold derives its real
// guest rows from); these tests only need a provider input of a chosen text, so they mint one with the
// producer's own adapter instead of a per-guest export.
fn provider_fixture(serial: String) -> UnitIdentityInputs {
  provider_resource_unit_identity_inputs(
    provider: hetzner_provider_ref(),
    acquisition: Present { value: ProviderResourcePresent { resource_id: serial as NonEmptyStr, route: hetzner_nuremberg_route() } },
  )
}

test fn hetzner_guests_bind_their_provider_resource_id_through_the_real_fold() -> Bool {
  let nbg_binds = match machine_unit_standing(machine: operator_host_183527) {
    Present { value: UnitKeyBound { key: k } } => (k.value as String) == "169308819"
    _ => false
  }
  let hel_binds = match machine_unit_standing(machine: operator_host_3dde7f) {
    Present { value: UnitKeyBound { key: k } } => (k.value as String) == "169308796"
    _ => false
  }
  let nbg_provider_kinded = bound_is_provider_kind(bound: fleet_machine_unit_admission.bound, m: operator_host_183527 as String)
  let hel_provider_kinded = bound_is_provider_kind(bound: fleet_machine_unit_admission.bound, m: operator_host_3dde7f as String)
  nbg_binds && hel_binds && nbg_provider_kinded && hel_provider_kinded
}

// FAIL CLOSED: a guest whose binding is not acquired refuses typed, and nothing binds it by its
// host name. Absent acquisition is the awaited/unbound state; A2 refuses it with ProviderResourceIdAbsent
// and it appears nowhere in the bound list -- not under its resource id (there is none) and not under
// its name.
test fn a_guest_with_no_acquired_binding_refuses_typed_and_never_binds_by_name() -> Bool {
  let name = "guest-with-no-binding"
  let ev = MachineUnitEvidence {
    machine: machine(label: name),
    inputs: provider_resource_unit_identity_inputs(provider: hetzner_provider_ref(), acquisition: Absent),
  }
  let admission = admit_machine_units(evidence: [ev])
  let refused_typed = match machine_unit_standing_in(admission: admission, machine: machine(label: name)) {
    Present { value: UnitKeyRefused { cause: ProviderResourceIdAbsent { provider: _ } } } => true
    _ => false
  }
  let absent_from_bound = admission.bound |> all(b => (b.machine as String) != name)
  let binds_no_name = admission.bound |> all(b => (b.unit.value as String) != name)
  refused_typed && absent_from_bound && binds_no_name
}

// THE KIND DOES ITS JOB: a provider resource id and a board serial with the SAME text are different
// keys. The nbg1 guest's resource id is "169308819"; a board machine observed with that same serial must
// still bind, and so must the guest -- neither is refused as held-by-another, and each is bound under its
// OWN authority's kind. Without the kind, the fold would key both to "169308819" and refuse the second.
test fn a_provider_resource_id_and_a_board_serial_of_equal_text_are_different_keys() -> Bool {
  let text = "169308819"
  let board_label = "board-shares-the-resource-id-text"
  let guest_label = "guest-with-that-resource-id"
  let board_ev = MachineUnitEvidence {
    machine: machine(label: board_label),
    inputs: BmcObserved {
      bmc_endpoint: fixture_bmc_endpoint(),
      board_serial_observations: [BoardSerialObservation { source: BmcFru, serial: text as NonEmptyStr }],
    },
  }
  // The guest carries the identical text as its provider resource id (nbg1 = "169308819").
  let guest_ev = MachineUnitEvidence { machine: machine(label: guest_label), inputs: provider_fixture(serial: text) }
  let admission = admit_machine_units(evidence: [board_ev, guest_ev])
  let no_refusals = machine_unit_admission_refusals(standings: admission.standings).length() == 0
  let board_binds_same_text = match machine_unit_standing_in(admission: admission, machine: machine(label: board_label)) {
    Present { value: UnitKeyBound { key: k } } => (k.value as String) == text
    _ => false
  }
  let guest_binds_same_text = match machine_unit_standing_in(admission: admission, machine: machine(label: guest_label)) {
    Present { value: UnitKeyBound { key: k } } => (k.value as String) == text
    _ => false
  }
  let board_is_board = bound_is_board_kind(bound: admission.bound, m: board_label)
  let guest_is_provider = bound_is_provider_kind(bound: admission.bound, m: guest_label)
  no_refusals && board_binds_same_text && guest_binds_same_text && board_is_board && guest_is_provider
}

// FAIL CLOSED ON CONTRADICTION: a machine given readings from BOTH authorities -- a board reading
// first, then a provider resource -- is not resolved last-writer-wins. It refuses typed with
// UnitIdentityKindContradictory, binds nothing, and appears nowhere in the bound list. This is the
// fail_closed arm of the fold (gunbc.fleet.fleet_machine_unit_binding, machine_unit_step): two
// grounding authorities claiming one machine is a contest, not a repeat to re-judge.
test fn a_machine_given_both_authorities_refuses_the_contradiction() -> Bool {
  let label = "guest-given-board-and-provider"
  let board_ev = MachineUnitEvidence {
    machine: machine(label: label),
    inputs: BmcObserved {
      bmc_endpoint: fixture_bmc_endpoint(),
      board_serial_observations: [BoardSerialObservation { source: BmcFru, serial: "CONTRADICTION-SERIAL" as NonEmptyStr }],
    },
  }
  let guest_ev = MachineUnitEvidence { machine: machine(label: label), inputs: provider_fixture(serial: "169308819") }
  let admission = admit_machine_units(evidence: [board_ev, guest_ev])
  let refused_contradiction = match machine_unit_standing_in(admission: admission, machine: machine(label: label)) {
    Present { value: UnitKeyRefused { cause: UnitIdentityKindContradictory { provider: _ } } } => true
    _ => false
  }
  let unbound = admission.bound |> all(b => (b.machine as String) != label)
  refused_contradiction && unbound
}

// THE BOARD BINDINGS ARE UNCHANGED by adding the guests: the production admission still refuses nothing,
// and both board machines -- mtcollins1 (its intake FRU+SMBIOS readings) and srv4 (the in-band read) --
// are still bound. The provider rows share the fold's claimed_by space but, being a different authority,
// cost the board machines nothing.
test fn adding_the_guests_leaves_the_board_bindings_unchanged() -> Bool {
  let no_refusals = machine_unit_admission_refusals(standings: fleet_machine_unit_admission.standings).length() == 0
  let mtcollins1_bound = match machine_unit_standing(machine: operator_host_mtcollins1) {
    Present { value: UnitKeyBound { key: _ } } => true
    _ => false
  }
  let srv4_bound = match machine_unit_standing(machine: operator_host_srv4) {
    Present { value: UnitKeyBound { key: _ } } => true
    _ => false
  }
  no_refusals && mtcollins1_bound && srv4_bound
}
