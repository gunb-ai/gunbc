module test.claim.fleet_runner_connectivity_witness

import std.logic { Bool }
import std.types { String, NonEmptyStr, List }
import std.nat { Nat }
import gunbc.build_cache_instance { RunnerSlotIdentity }
import gunbc.fleet_intent_network {
  operator_host_srv1, operator_host_srv2, operator_host_srv3, operator_host_srv4,
}
import gunbc.fleet_runner_connectivity {
  incident_2026_08_06_roster_fixture,
  runner_slot_connectivity_verdict,
  runner_slot_connectivity_verdict_for_incarnation,
  connectivity_verdicts_for_active_incarnations,
  connectivity_verdict_is_healthy,
  connectivity_verdict_is_detached,
  connectivity_verdict_is_orphaned,
  connectivity_verdict_is_unknown,
  connectivity_verdict_labels_diverge,
  RunnerSlotConnectivityVerdict,
  roster_unavailable_yields_unknown_not_detached,
  fleet_runner_capacity_width_snapshot,
  fleet_runner_capacity_width_snapshot_from_roster,
  fleet_achieved_runner_widths_from_roster,
  local_runner_slot_incarnations,
  runner_slot_incarnation,
  incident_2026_08_06_registrations,
  RosterObserved,
  RosterObservedPartial,
  RosterReadUnavailable,
  OrganizationRunnerRosterEvidence,
  organization_runner_roster_from_page,
  AchievedWidthsObserved,
  AchievedWidthsUnobserved,
  SlotConnectivityHealthy,
  SlotConnectivityDetached,
  SlotConnectivityLabelsDiverge,
  SlotConnectivityOrphaned,
  SlotConnectivityUnknown,
  FleetRunnerCapacityWidthSnapshot,
}
import extdeps.github.ci_runner {
  GitHubSelfHostedRunnerRegistration,
  GitHubRunnerOnline,
  GitHubRunnerOffline,
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// These rows pin the 2026-08-06 broker-session incident exactly. Fifteen registrations are offline,
// one is online and busy, and local systemd units stayed active throughout — the wedge shape PR B's
// repair loop must not misread as detached on a roster API blip.

test fn srv1_01_is_healthy_while_busy() -> Bool {
  match runner_slot_connectivity_verdict(
    slot: RunnerSlotIdentity { host: operator_host_srv1, slot_index: 1 }
  ) {
    SlotConnectivityHealthy { slot: _, registration_id: id } => id == 1
    _ => false
  }
}

test fn active_offline_registration_is_detached_not_healthy() -> Bool {
  match runner_slot_connectivity_verdict(
    slot: RunnerSlotIdentity { host: operator_host_srv1, slot_index: 2 }
  ) {
    SlotConnectivityDetached { slot: _, registration_id: _ } => true
    _ => false
  }
}

test fn active_without_registration_is_orphaned() -> Bool {
  match runner_slot_connectivity_verdict(
    slot: RunnerSlotIdentity { host: operator_host_srv2, slot_index: 3 }
  ) {
    SlotConnectivityOrphaned { slot: _ } => true
    _ => false
  }
    && match runner_slot_connectivity_verdict(
      slot: RunnerSlotIdentity { host: operator_host_srv3, slot_index: 3 }
    ) {
      SlotConnectivityOrphaned { slot: _ } => true
      _ => false
    }
}

// THE FAIL-CLOSED ROW PR B'S SAFETY DEPENDS ON: a roster read failure must render UNKNOWN on every
// active slot, never detached. Zero-width achieved fields must stay unobserved rather than
// fabricated as zero registrations.

test fn roster_unavailable_yields_unknown_on_every_active_slot() -> Bool {
  let roster = RosterReadUnavailable { reason: "GitHub org runners API returned 503" }
  roster_unavailable_yields_unknown_not_detached(roster: roster)
    && all(
      connectivity_verdicts_for_active_incarnations(roster: roster),
      v => connectivity_verdict_is_unknown(v: v)
    )
}

test fn roster_unavailable_does_not_fabricate_zero_achieved_widths() -> Bool {
  let snapshot = fleet_runner_capacity_width_snapshot_from_roster(
    roster: RosterReadUnavailable { reason: "GitHub org runners API returned 503" }
  )
  match snapshot.achieved {
    AchievedWidthsUnobserved { reason: _ } => true
    AchievedWidthsObserved { registered_width: _, connected_width: _, schedulable_width: _, executing_width: _ } => false
  }
}

test fn incident_registered_sixteen_does_not_imply_connected_sixteen() -> Bool {
  let snapshot = fleet_runner_capacity_width_snapshot()
  match snapshot.achieved {
    AchievedWidthsObserved {
      registered_width: r,
      connected_width: c,
      schedulable_width: s,
      executing_width: e,
    } => r == 16 && c == 1 && s == 0 && e == 1 && r != c
    AchievedWidthsUnobserved { reason: _ } => false
  }
}

test fn desired_width_stays_twenty_two_while_connected_is_one() -> Bool {
  let snapshot = fleet_runner_capacity_width_snapshot()
  snapshot.desired_width == 22
    && match snapshot.achieved {
      AchievedWidthsObserved { registered_width: _, connected_width: c, schedulable_width: _, executing_width: _ } =>
        c == 1
      AchievedWidthsUnobserved { reason: _ } => false
    }
}

test fn materialized_and_unit_active_widths_are_twenty_not_desired() -> Bool {
  let snapshot = fleet_runner_capacity_width_snapshot()
  snapshot.materialized_width == 20
    && snapshot.unit_active_width == 20
    && snapshot.desired_width > snapshot.materialized_width
}

test fn detached_count_matches_offline_registrations_on_active_slots() -> Bool {
  let roster = incident_2026_08_06_roster_fixture()
  let verdicts = connectivity_verdicts_for_active_incarnations(roster: roster)
  count_matching(verdicts: verdicts, matched: v => connectivity_verdict_is_detached(v: v)) == 15
}

test fn healthy_count_is_one_and_orphaned_count_is_four() -> Bool {
  let roster = incident_2026_08_06_roster_fixture()
  let verdicts = connectivity_verdicts_for_active_incarnations(roster: roster)
  count_matching(verdicts: verdicts, matched: v => connectivity_verdict_is_healthy(v: v)) == 1
    && count_matching(verdicts: verdicts, matched: v => connectivity_verdict_is_orphaned(v: v)) == 4
}

test fn local_incarnation_observation_covers_twenty_active_units() -> Bool {
  local_runner_slot_incarnations().length() == 20
    && all(
      local_runner_slot_incarnations(),
      inc => inc.unit_active
    )
}

test fn fleet_runner_connectivity_RED_orphaned_slot_must_not_read_detached() -> Bool {
  match runner_slot_connectivity_verdict(
    slot: RunnerSlotIdentity { host: operator_host_srv4, slot_index: 3 }
  ) {
    SlotConnectivityOrphaned { slot: _ } => true
    SlotConnectivityDetached { slot: _, registration_id: _ } => false
    _ => false
  }
}

fn count_matching(
  verdicts: List<RunnerSlotConnectivityVerdict>,
  matched: fn(RunnerSlotConnectivityVerdict) -> Bool,
) -> Int {
  fold(
    verdicts,
    init: 0,
    f: (n, v) => if matched(v) { n + 1 } else { n }
  )
}

// ---------------------------------------------------------------------------
// TRUNCATED ROSTER: the discriminating pair for the paginated-read repair.
//
// The org runners API is paginated. Measured 2026-08-27T21:29Z: total_count 522
// against a 100-row page. A read that SUCCEEDS is therefore not a read that saw
// everything, and the defect this pair pins is that a slot missing from a PREFIX
// was never observed to be missing -- rendering it Orphaned is the empty-observation
// narrow, and Orphaned is what maps to a restart at
// gunbc.runner_capacity_plan connectivity_replace_action.
//
// THE PAIR IS THE POINT. The RED arm alone would also pass if Orphaned had simply
// been disabled everywhere, so the complete-roster control is what makes it
// discriminating rather than merely green.

// BOTH FIXTURES DERIVE THEIR TOTAL FROM THE SPECIMEN, so neither can silently change meaning when
// a registration row is added. A hand-written total would make "partial" and "complete" facts about
// a literal someone remembered to update rather than facts about the pair.
fn truncated_incident_roster() -> OrganizationRunnerRosterEvidence {
  organization_runner_roster_from_page(
    observed_on: "2026-08-27" as NonEmptyStr,
    registrations: incident_2026_08_06_registrations,
    authority_total: incident_2026_08_06_registrations.length() + 1,
  )
}

fn complete_incident_roster() -> OrganizationRunnerRosterEvidence {
  organization_runner_roster_from_page(
    observed_on: "2026-08-27" as NonEmptyStr,
    registrations: incident_2026_08_06_registrations,
    authority_total: incident_2026_08_06_registrations.length(),
  )
}

// NO TRANSCRIBED COUNT. Asserting the specimen list's current length would pin a literal measured
// from the tree it is testing (DESIGN section 5 on oracles) and would rot the next time a
// registration row is added. The property under test is the RELATION: a page smaller than the
// authority's own total is partial, whatever either number happens to be.
test fn prefix_below_authority_total_is_partial() -> Bool {
  match truncated_incident_roster() {
    RosterObservedPartial { observed_on: _, registrations: _, observed_count: seen, authority_total: total } =>
      seen < total
    _ => false
  }
}

test fn page_equal_to_authority_total_is_complete() -> Bool {
  match complete_incident_roster() {
    RosterObserved { observed_on: _, registrations: _ } => true
    _ => false
  }
}

// THE RED. Before the repair every unseen slot rendered Orphaned here.
test fn truncated_roster_never_orphans_an_unseen_slot() -> Bool {
  all(
    connectivity_verdicts_for_active_incarnations(roster: truncated_incident_roster()),
    v => !connectivity_verdict_is_orphaned(v: v)
  )
}

// THE POSITIVE CONTROL. The required refusal must SURVIVE the repair: over a roster
// the authority itself calls complete, a slot with no registration is genuinely gone
// and must still be Orphaned. If this arm ever goes green-by-absence the RED above
// has stopped discriminating.
test fn complete_roster_still_orphans_an_unseen_slot() -> Bool {
  !all(
    connectivity_verdicts_for_active_incarnations(roster: complete_incident_roster()),
    v => !connectivity_verdict_is_orphaned(v: v)
  )
}

// PER-QUESTION, NOT PER-ROSTER. A truncated read still answers exactly about every
// slot INSIDE the prefix; refusing the whole roster would be a widen that stops
// reconciliation on hosts the read covered perfectly well.
test fn truncated_roster_still_answers_slots_inside_the_prefix() -> Bool {
  !all(
    connectivity_verdicts_for_active_incarnations(roster: truncated_incident_roster()),
    v => connectivity_verdict_is_unknown(v: v)
  )
}

// ── registration-label readback: the desired side is runner_registration_labels(slot host) ───────
// ONE ONLINE REGISTRATION, VARIED ONLY IN ITS LABELS, read through the real verdict fold over a
// complete roster. The expected sets are spelled here rather than computed from the composition, so
// a composition that dropped a label would turn the positive control red.
fn online_srv4_01_under(labels: List<NonEmptyStr>) -> RunnerSlotConnectivityVerdict {
  runner_slot_connectivity_verdict_for_incarnation(
    incarnation: runner_slot_incarnation(host: operator_host_srv4, slot_index: 1, unit_active: true),
    roster: organization_runner_roster_from_page(
      observed_on: "2026-09-19" as NonEmptyStr,
      registrations: [
        GitHubSelfHostedRunnerRegistration {
          id: 9401,
          name: "srv4-01" as NonEmptyStr,
          status: GitHubRunnerOnline,
          busy: false,
          ephemeral: Present { value: true },
          version: Present { value: "2.334.0" as NonEmptyStr },
          os: "Linux" as NonEmptyStr,
          labels: labels,
        },
      ],
      authority_total: 1,
    ),
  )
}

test fn online_registration_under_its_own_class_and_host_labels_is_healthy() -> Bool {
  connectivity_verdict_is_healthy(
    v: online_srv4_01_under(labels: ["srv4" as NonEmptyStr, "arm64" as NonEmptyStr, "gunbc-heavy" as NonEmptyStr, "linux" as NonEmptyStr, "self-hosted" as NonEmptyStr]),
  )
}

test fn online_registration_missing_the_class_label_is_not_healthy() -> Bool {
  connectivity_verdict_labels_diverge(
    v: online_srv4_01_under(labels: ["self-hosted" as NonEmptyStr, "linux" as NonEmptyStr, "arm64" as NonEmptyStr, "srv4" as NonEmptyStr]),
  )
}

test fn online_registration_missing_the_host_label_is_not_healthy() -> Bool {
  connectivity_verdict_labels_diverge(
    v: online_srv4_01_under(labels: ["self-hosted" as NonEmptyStr, "linux" as NonEmptyStr, "arm64" as NonEmptyStr, "gunbc-heavy" as NonEmptyStr]),
  )
}

// WRONG HOST: an srv3-labelled runner answering to srv4-01's name must not read as srv4's.
test fn online_registration_under_another_hosts_label_is_not_healthy() -> Bool {
  connectivity_verdict_labels_diverge(
    v: online_srv4_01_under(labels: ["self-hosted" as NonEmptyStr, "linux" as NonEmptyStr, "arm64" as NonEmptyStr, "gunbc-heavy" as NonEmptyStr, "srv3" as NonEmptyStr]),
  )
}

// GITHUB LABEL EQUIVALENCE (case-insensitive): a mixed-case spelling of srv4's own set is Healthy,
// so a case-only difference proposes no repair; a mixed-case wrong host still diverges.
test fn online_registration_under_a_case_variant_of_its_labels_is_healthy() -> Bool {
  connectivity_verdict_is_healthy(
    v: online_srv4_01_under(labels: ["Self-Hosted" as NonEmptyStr, "Linux" as NonEmptyStr, "ARM64" as NonEmptyStr, "GUNBC-HEAVY" as NonEmptyStr, "SRV4" as NonEmptyStr]),
  )
}

test fn online_registration_under_a_mixed_case_wrong_host_label_is_not_healthy() -> Bool {
  connectivity_verdict_labels_diverge(
    v: online_srv4_01_under(labels: ["self-hosted" as NonEmptyStr, "Linux" as NonEmptyStr, "ARM64" as NonEmptyStr, "gunbc-heavy" as NonEmptyStr, "SRV3" as NonEmptyStr]),
  )
}
