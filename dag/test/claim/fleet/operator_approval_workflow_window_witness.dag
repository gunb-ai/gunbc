module test.claim.fleet.operator_approval_workflow_window_witness
// THE EMITTED JOB AND STEP CEILINGS BEHIND EVERY OPERATOR CARD'S WAIT.

import std.types { Bool }
import std.measure { second_count }
import std.integer { nat_to_int }
import extdeps.github.actions { max_job_timeout_minutes }
import gunbc.auth.approval_gate { approval_poll_overrun_ticks, approval_request_window }
import gunbc.auth.gcp_iam_converge_run {
  gcp_iam_converge_step_timeout_minutes, gcp_iam_converge_pre_decision_allowance,
  gcp_iam_converge_step_margin, gcp_iam_converge_poll_cadence, iam_converge_token_lifetime,
}
import gunbc.auth.branch_run_grant {
  branch_run_grant_step_timeout_minutes, branch_run_grant_pre_decision_allowance,
  branch_run_grant_step_margin, branch_run_grant_poll_cadence,
}
import gunbc.fleet.printer_operator_approval {
  printer_operator_approval_window, printer_operator_approval_poll_cadence,
  printer_approval_pre_decision_allowance,
  printer_approval_post_decision_allowance, printer_approval_step_margin,
  printer_converge_preparation_allowance,
}
import gunbc.fleet.fleet_converge_workflow {
  printer_converge_step_timeout_minutes,
  fleet_converge_printer_job_backstop_timeout_minutes,
  fleet_converge_gcp_iam_job_backstop_timeout_minutes,
  fleet_converge_gcp_iam_bootstrap_request_job_backstop_timeout_minutes,
}
import gunbc.fleet.fleet_workflow_steps {
  gunbc_ci_prelude_allowance_minutes, gunbc_ci_artifact_transfer_step_timeout_minutes,
  gunbc_ci_aux_step_timeout_minutes,
}

// WHY THIS WITNESS IS SEPARATE, AND WHY IT IS THE ONLY ONE THAT PAYS FOR THIS IMPORT. The step and job
// ceilings live in gunbc.fleet.fleet_converge_workflow, whose projection alone outruns the witness
// harness's per-test budget (gunbc#15901: a claim that imports the converge workflow took 4316 s of a
// 5400 s budget and starved the suite). Everything checkable from the approval and polling modules
// without it lives in test.claim.fleet.operator_approval_window_witness; only what is genuinely a fact
// about the EMITTED jobs lives here.

// THE PRINTER STEP'S CEILING COVERS ITS WHOLE PASS: preparation, the operator's entire decision window,
// the deadline overrun reads, the post-decision delivery, and the stated margin. Before 2026-11-10 this
// number was 45, with a comment naming the fifteen-minute window inside it -- a hand-carried copy, so the
// step could not outlast the card and the card could not outlast the step.
test fn the_printer_step_covers_its_preparation_and_its_operators_whole_window() -> Bool {
  let step = printer_converge_step_timeout_minutes() * 60
  let need = nat_to_int(n: second_count(s: printer_converge_preparation_allowance))
    + nat_to_int(n: second_count(s: printer_approval_pre_decision_allowance))
    + nat_to_int(n: second_count(s: printer_operator_approval_window()))
    + nat_to_int(n: second_count(s: printer_operator_approval_poll_cadence))
      * approval_poll_overrun_ticks
    + nat_to_int(n: second_count(s: printer_approval_post_decision_allowance))
    + nat_to_int(n: second_count(s: printer_approval_step_margin))
  step >= need
}

// THE PRINTER JOB CAN HOLD THE CARD IT POLLS, and stays inside what a GitHub job may run. The bound is
// stated from the DECLARED rows -- the card's window and the site's own allowances -- not from the step
// ceiling the backstop itself folds: a claim that recomputes the formula it checks only ever agrees with
// itself (review 93489 on gunbc#16304). Red the day a backstop is edited down, a bookkeeping step is
// dropped from the fold, or a window is raised past what the job may run.
test fn the_printer_job_backstop_holds_the_card_it_polls_and_the_platform_ceiling() -> Bool {
  let job_seconds = fleet_converge_printer_job_backstop_timeout_minutes() * 60
  let card_and_work_seconds = nat_to_int(n: second_count(s: printer_operator_approval_window()))
    + nat_to_int(n: second_count(s: printer_approval_pre_decision_allowance))
    + nat_to_int(n: second_count(s: printer_approval_post_decision_allowance))
    + nat_to_int(n: second_count(s: printer_operator_approval_poll_cadence)) * approval_poll_overrun_ticks
    + nat_to_int(n: second_count(s: printer_approval_step_margin))
    + nat_to_int(n: second_count(s: printer_converge_preparation_allowance))
  let bookkeeping_seconds = (gunbc_ci_prelude_allowance_minutes
      + gunbc_ci_artifact_transfer_step_timeout_minutes * 2 + gunbc_ci_aux_step_timeout_minutes * 2) * 60
  job_seconds >= card_and_work_seconds + bookkeeping_seconds && job_seconds < max_job_timeout_minutes * 60
}

// THE IAM-CONVERGE JOB CAN HOLD EITHER CARD IT MAY HOST. Its two request steps are gated to different
// modes, so one dispatch waits on one card -- and the backstop has to survive whichever one it is. Each
// bound is stated from the POLICY ROW the card reads plus that site's declared allowances, never from the
// step ceilings the fold consumes (review 93489: comparing a formula with itself checks nothing). Red the
// day someone raises a window without raising the job, drops a bookkeeping step, or sums the two mutually
// exclusive waits into a backstop no dispatch can ever reach.
test fn the_iam_converge_job_backstop_holds_either_card_and_the_platform_ceiling() -> Bool {
  let job_seconds = fleet_converge_gcp_iam_job_backstop_timeout_minutes() * 60
  let window_seconds = nat_to_int(n: second_count(s: approval_request_window))
  let bookkeeping_seconds = (gunbc_ci_prelude_allowance_minutes + gunbc_ci_artifact_transfer_step_timeout_minutes
      + gunbc_ci_aux_step_timeout_minutes * 3 + (gunbc_ci_aux_step_timeout_minutes + 10) * 2) * 60
  let iam_card_seconds = window_seconds
    + nat_to_int(n: second_count(s: gcp_iam_converge_pre_decision_allowance))
    + nat_to_int(n: second_count(s: gcp_iam_converge_poll_cadence)) * approval_poll_overrun_ticks
    + nat_to_int(n: second_count(s: iam_converge_token_lifetime))
    + nat_to_int(n: second_count(s: gcp_iam_converge_step_margin))
  let grant_card_seconds = window_seconds
    + nat_to_int(n: second_count(s: branch_run_grant_pre_decision_allowance))
    + nat_to_int(n: second_count(s: branch_run_grant_poll_cadence)) * approval_poll_overrun_ticks
    + nat_to_int(n: second_count(s: branch_run_grant_step_margin))
  job_seconds >= iam_card_seconds + bookkeeping_seconds
    && job_seconds >= grant_card_seconds + bookkeeping_seconds
    && job_seconds < max_job_timeout_minutes * 60
}

// THE BOOTSTRAP DELTA'S REQUEST JOB, the same discipline: one wait per job by construction, because its
// actuation is a separate job behind a fresh federation, so the bound is one card's window and allowances
// plus the job's own bookkeeping -- and inside the platform ceiling.
//
// The bookkeeping is this job's own four non-polling steps, named one by one off its step list (event-sha
// checkout, release-bins download, release-bins unpack and verify, WIF auth) rather than copied from the
// fold, so a step dropped from the backstop's sum -- or a step added to the job without raising it -- is
// red here. The card half is read off the policy row and the site's declared rows, never from the step
// ceiling the backstop consumes (review 93489 on gunbc#16304: a claim that recomputes its own formula only
// ever agrees with itself).
test fn the_bootstrap_request_job_backstop_holds_its_card_and_the_platform_ceiling() -> Bool {
  let job_seconds = fleet_converge_gcp_iam_bootstrap_request_job_backstop_timeout_minutes() * 60
  let bookkeeping_seconds = (gunbc_ci_prelude_allowance_minutes + gunbc_ci_artifact_transfer_step_timeout_minutes
      + gunbc_ci_aux_step_timeout_minutes * 2) * 60
  let card_seconds = nat_to_int(n: second_count(s: approval_request_window))
    + nat_to_int(n: second_count(s: gcp_iam_converge_pre_decision_allowance))
    + nat_to_int(n: second_count(s: gcp_iam_converge_poll_cadence)) * approval_poll_overrun_ticks
    + nat_to_int(n: second_count(s: iam_converge_token_lifetime))
    + nat_to_int(n: second_count(s: gcp_iam_converge_step_margin))
  job_seconds >= card_seconds + bookkeeping_seconds && job_seconds < max_job_timeout_minutes * 60
}
