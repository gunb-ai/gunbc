module test.claim.fleet.fleet_known_hosts_anchor_witness

import std.types { String, Bool, List, NonEmptyStr }
import product.host_identity { HostIdentity }
import gunbc.fleet.fleet_host_identity { operator_host_srv14 }
import std.types { Port }
import extdeps.network.endpoint { SocketAddress, socket_address, host_by_name }
import extdeps.dns.domain_name { DnsLabel, HostName, DomainName, PartiallyQualified }
import gunbc.fleet.fleet_converge_workflow {
  FleetConvergeWorkflowMode, HostnameConverge, TailscaleJoinConverge, RunnerHostFileConverge, fleet_converge_mode_facts,
}
import gunbc.fleet.fleet_host_key_enrollment {
  known_host_row_field,
  first_contact_lan_keys,
  srv14_first_contact_key,
  KnownHostKeyRow,
  HostKeyEnrollmentProvenance,
  ScannedFirstContact,
  fleet_name_at_ssh_port,
}
import gunbc.fleet.fleet_known_hosts_anchor {
  first_contact_admission_for_hostname_mode,
  first_contact_admission_for_tailscale_join_mode,
  anchored_host_key_row,
  first_contact_known_host_rows,
  first_contact_ssh_target,
  fleet_known_hosts_rows, known_hosts_file_rows,
  FirstContactAdmission, FirstContactModeNotAdmitted,
  SshTargetRefused,
  SshTargetResolved,
  canonical_known_hosts_fragment,
  canonical_known_hosts_identity,
  known_hosts_endpoint_conflict,
  FleetSshAttemptIdentity,
  fleet_ssh_attempt_identity,
  fleet_known_hosts_anchor_path,
  known_hosts_anchor_path,
  fleet_known_hosts_registry_identity,
}
import std.content_hash { compare_content_hash, ContentHashEqual, ContentHashDifferent, ContentHashCrossFamilyIncomparable }

// The constructor is partial, so a fixture must decide what an unsafe id means. Refusing to a
// distinguishable sentinel rather than a plausible-looking default keeps a construction failure from
// silently becoming a passing comparison between two identical fallbacks.
fn attempt(raw: String) -> FleetSshAttemptIdentity {
  match fleet_ssh_attempt_identity(raw: raw) {
    Present { value: a } => a
    Absent => "REFUSED-UNSAFE-ATTEMPT-ID" as FleetSshAttemptIdentity
  }
}

fn row(host: String, endpoint: String, key: String) -> KnownHostKeyRow {
  row_at(host: host, address: fleet_name_at_ssh_port(labels: [endpoint as DnsLabel]), key: key)
}

fn row_at(host: String, address: SocketAddress, key: String) -> KnownHostKeyRow {
  KnownHostKeyRow {
    host: host as HostIdentity,
    address: address,
    key_type: "ssh-ed25519",
    public_key_base64: key,
    sha256_fingerprint: concat("SHA256:", key),
    provenance: ScannedFirstContact { scanned_from: "synthetic fixture" as NonEmptyStr },
  }
}

// The SAME registry authored in two orders. These are one set of trusted keys, so they must be one
// registry -- and before canonicalization they were two, because the identity was a function of the
// list's traversal rather than of the enrollments it denotes.
fn forward_rows() -> List<KnownHostKeyRow> {
  [row(host: "a", endpoint: "alpha", key: "AAAA"), row(host: "b", endpoint: "bravo", key: "BBBB"), row(host: "c", endpoint: "charlie", key: "CCCC")]
}

fn reversed_rows() -> List<KnownHostKeyRow> {
  [row(host: "c", endpoint: "charlie", key: "CCCC"), row(host: "b", endpoint: "bravo", key: "BBBB"), row(host: "a", endpoint: "alpha", key: "AAAA")]
}

fn identities_agree(left: List<KnownHostKeyRow>, right: List<KnownHostKeyRow>) -> Bool {
  match compare_content_hash(
    left: canonical_known_hosts_identity(rows: left),
    right: canonical_known_hosts_identity(rows: right),
  ) {
    ContentHashEqual => true
    ContentHashDifferent => false
    ContentHashCrossFamilyIncomparable => false
  }
}

// THE REVERSAL CONTROL. Reordering the enrollments must change neither the anchor's identity nor the
// bytes ssh reads. Asserting BOTH matters: canonicalizing only the hash would give one identity to
// two different files, which is strictly worse than the defect it replaced -- the digest would then
// certify bytes it did not describe, and the anchor's whole claim is that its identity IS its
// content.
test fn w_reordered_registry_is_the_same_registry() -> Bool {
  identities_agree(left: forward_rows(), right: reversed_rows()) && canonical_known_hosts_fragment(rows: forward_rows()) == canonical_known_hosts_fragment(rows: reversed_rows())
}

// POSITIVE CONTROL, without which the reversal claim is satisfiable by a constant. A registry that
// differs in CONTENT rather than order must still receive a different identity.
test fn w_a_different_registry_is_a_different_registry() -> Bool {
  !identities_agree(
    left: forward_rows(),
    right: [row(host: "a", endpoint: "alpha", key: "DDDD"), row(host: "b", endpoint: "bravo", key: "BBBB"), row(host: "c", endpoint: "charlie", key: "CCCC")],
  )
}

// A duplicate endpoint is a CONFLICT, not a redundancy: known_hosts accepts a key matching any line
// for that endpoint, so two rows naming one endpoint widen what is trusted while the registry reads
// as if it pinned one key. Refusing is the only honest arm -- hashing it would mint an anchor
// certifying a widened trust set.
test fn w_duplicate_endpoint_refuses() -> Bool {
  match known_hosts_endpoint_conflict(rows: [
    row(host: "a", endpoint: "alpha", key: "AAAA"),
    row(host: "impostor", endpoint: "alpha", key: "EVIL"),
  ]) {
    Present { value: _ } => true
    Absent => false
  }
}

// The refusal must not fire on a registry that is merely varied -- otherwise the arm above would
// pass by refusing everything, and the live six-row registry could never materialize.
test fn red_control_distinct_endpoints_do_not_conflict() -> Bool {
  match known_hosts_endpoint_conflict(rows: forward_rows()) {
    Absent => true
    Present { value: _ } => false
  }
}

fn alpha_on(port: Port) -> SocketAddress {
  socket_address(host: host_by_name(name: HostName { name: DomainName { labels: ["alpha" as DnsLabel] }, qualification: PartiallyQualified }), port: port)
}

// THE CONFLICT IS COUNTED AT HOST AND PORT, the grain ssh looks a key up by. One host's sshd on 22 and
// a forwarded sshd on 11055 are two daemons with two keys, so pinning both is not a widened set.
test fn w_one_host_on_two_ports_does_not_conflict() -> Bool {
  match known_hosts_endpoint_conflict(rows: [
    row_at(host: "a", address: alpha_on(port: 22), key: "AAAA"),
    row_at(host: "a", address: alpha_on(port: 11055), key: "FFFF"),
  ]) {
    Absent => true
    Present { value: _ } => false
  }
}

// RED for the row above: two rows on the SAME non-standard port conflict, and the refusal names the
// bracketed host field rather than the bare host, so the port was not dropped on the way to the key.
test fn w_duplicate_non_standard_port_refuses_under_its_bracketed_field() -> Bool {
  match known_hosts_endpoint_conflict(rows: [
    row_at(host: "a", address: alpha_on(port: 11055), key: "AAAA"),
    row_at(host: "impostor", address: alpha_on(port: 11055), key: "EVIL"),
  ]) {
    Present { value: c } => string_contains(c, "[alpha]:11055")
    Absent => false
  }
}

// THE ATTEMPT OWNS THE PATH. An earlier revision derived the anchor path from the registry digest
// alone and argued in-source that identical content made a shared path safe. That argument was
// wrong: identical content does not establish immutability -- a later writer can modify the path
// after another attempt has sealed its anchor, so the sealed value proves what was read at
// construction rather than what ssh reads when the leg runs. Two attempts holding the SAME registry
// must therefore still receive different paths, which is exactly what this asserts and what the old
// derivation could not satisfy.
test fn w_two_attempts_do_not_share_one_anchor_path() -> Bool {
  fleet_known_hosts_anchor_path(attempt: attempt(raw: "attempt-a")) != fleet_known_hosts_anchor_path(attempt: attempt(raw: "attempt-b"))
}

// POSITIVE CONTROL: the digest half still does its work. One attempt asking twice must land on one
// path -- otherwise the claim above is satisfiable by any per-call unique name, and the filename
// would stop being a claim about content that the readback checks.
test fn w_one_attempt_derives_one_stable_path() -> Bool {
  fleet_known_hosts_anchor_path(attempt: attempt(raw: "attempt-a")) == fleet_known_hosts_anchor_path(attempt: attempt(raw: "attempt-a"))
}

// THE OWNERSHIP BOUNDARY IS THE POINT OF THE SEGMENT, so an id that would escape it must refuse
// rather than be sanitized. A traversal component or a separator would put one attempt's anchor
// outside its own directory -- which is exactly the shared-mutable-path failure the attempt scoping
// exists to close, reintroduced through the identity instead of the path.
test fn w_unsafe_attempt_identity_refuses() -> Bool {
  match fleet_ssh_attempt_identity(raw: "../escape") {
    Absent => true
    Present { value: _ } => false
  }
}

// Positive control: the refusal is discriminating, not total. Without it the claim above passes by
// refusing every id and no anchor could ever be materialized.
test fn w_ordinary_attempt_identity_is_admitted() -> Bool {
  match fleet_ssh_attempt_identity(raw: "run-31469703605-attempt-1") {
    Present { value: _ } => true
    Absent => false
  }
}

// THE REGISTRY IS A PARAMETER OF THE PATH: two registries under one attempt must land on different
// files, or a rented inventory's anchor could be read as the fleet's. The fleet path is exactly the
// generalized path at the fleet's own registry, so the generalization removed no fleet behavior.
test fn w_two_registries_under_one_attempt_do_not_share_an_anchor_path() -> Bool {
  known_hosts_anchor_path(attempt: attempt(raw: "attempt-a"), registry_identity: canonical_known_hosts_identity(rows: [row(host: "r1", endpoint: "r1", key: "AAAA")]))
    != known_hosts_anchor_path(attempt: attempt(raw: "attempt-a"), registry_identity: canonical_known_hosts_identity(rows: [row(host: "r2", endpoint: "r2", key: "BBBB")]))
}

test fn w_the_fleet_path_is_the_generalized_path_at_the_fleet_registry() -> Bool {
  fleet_known_hosts_anchor_path(attempt: attempt(raw: "attempt-a"))
    == known_hosts_anchor_path(attempt: attempt(raw: "attempt-a"), registry_identity: fleet_known_hosts_registry_identity())
}

// ── the first-contact hop (B3b, srv14/butch pre-join) ──────────────────────────────────────────
// srv14's ONLY modeled reach before it joins is the hop: one pinned key (the #16276 host key) at its
// DHCP lease address. It joins the verification registry like any anchor (so the hop is key-pinned),
// never becomes an ANCHORED row (so anchored modes refuse it), and admits exactly the two modes that
// make a host joinable -- checked here against the workflow's own mode facts, so a renamed wire that
// stops matching the hop list FAILS.

// The hop rows are IN the file the host verifies against (known_hosts_file_rows = anchored registry
// + hop rows), and they are NOT anchors -- anchored_host_key_row reads only the enrollment registry,
// never this list (a_host_with_only_a_hop_has_no_anchored_row proves the separation).
test fn the_hop_rows_join_the_verification_registry() -> Bool {
  all(first_contact_known_host_rows(), r =>
    any(known_hosts_file_rows(), k => known_host_row_field(k: k) == known_host_row_field(k: r)))
    && !any(first_contact_known_host_rows(), r =>
      any(fleet_known_hosts_rows(), k => known_host_row_field(k: k) == known_host_row_field(k: r)))
}

// KEYED, not counted (still-fox-404): a second host's datum must not redden a claim about BUTCH's key,
// and a missing-but-ordered-first datum must not pass it. The refusal half is the discriminator the
// count never was.
test fn the_hop_carries_the_enrolled_butch_host_key() -> Bool {
  any(
    first_contact_lan_keys,
    k =>
      (k.host as String) == (operator_host_srv14 as String)
        && k.public_key_base64 == srv14_first_contact_key.public_key_base64
        && k.sha256_fingerprint == srv14_first_contact_key.sha256_fingerprint,
  )
    && !any(first_contact_known_host_rows(), r => (r.host as String) == "srv1")
}

test fn a_host_with_only_a_hop_has_no_anchored_row() -> Bool {
  match anchored_host_key_row(host: "srv14" as HostIdentity) {
    Present { value: _ } => false
    Absent => true
  }
}

// ADMISSION IS THE TOKEN TYPE, NOT A STRING (review 96277): the two join-making modes hold the only
// two constructible tokens; any other caller (custody, runner converge -- today and forever) offers
// Absent and is refused the hop. The claim that the workflow's mode facts still spell the two wires
// lives beside this one (fleet_converge_mode_facts vs the leaf datums), so a renamed wire still fails.
test fn the_hop_admits_only_the_token_holding_modes() -> Bool {
  match first_contact_ssh_target(host: "srv14" as HostIdentity, principal: "ubuntu", admission: Present { value: first_contact_admission_for_hostname_mode() }) {
    SshTargetResolved { target: _ } => true
    SshTargetRefused { endpoint: _, refusal: _ } => false
  }
    && match first_contact_ssh_target(host: "srv14" as HostIdentity, principal: "ubuntu", admission: Present { value: first_contact_admission_for_tailscale_join_mode() }) {
      SshTargetResolved { target: _ } => true
      SshTargetRefused { endpoint: _, refusal: _ } => false
    }
    && match first_contact_ssh_target(host: "srv14" as HostIdentity, principal: "ubuntu", admission: none) {
      SshTargetResolved { target: _ } => false
      SshTargetRefused { endpoint: _, refusal: FirstContactModeNotAdmitted { host: _ } } => true
      SshTargetRefused { endpoint: _, refusal: _ } => false
    }
}

test fn the_hop_admits_nothing_for_a_host_with_no_pinned_key() -> Bool {
  match first_contact_ssh_target(host: "not-a-fleet-host" as HostIdentity, principal: "ubuntu", admission: Present { value: first_contact_admission_for_tailscale_join_mode() }) {
    SshTargetResolved { target: _ } => false
    SshTargetRefused { endpoint: _, refusal: _ } => true
  }
}
