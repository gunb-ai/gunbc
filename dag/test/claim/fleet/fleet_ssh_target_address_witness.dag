module test.claim.fleet.fleet_ssh_target_address_witness

import std.types { String, Bool, Int, List, NonEmptyStr, Port }
import std.optional { Present, Absent, Optional }
import std.measure { second_count }
import std.content_hash { serialize_content_hash }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import product.host_identity { HostIdentity }
import extdeps.network.endpoint { SocketAddress, socket_address, host_by_ipv4, NetworkHostNameMalformed, NetworkHostIpv4Malformed }
import extdeps.network.ipv4 { ipv4_address }
import gunbc.fleet.fleet_known_hosts_anchor {
  FleetRemoteLeg,
  ProbeLeg,
  SshTarget, SshTargetResolution, SshTargetResolved, SshTargetRefused, SshTargetRefusal, TargetEndpointUnparseable,
  fleet_ssh_target_at_standard_port, ssh_target_wire, portable_remote_words,
  FleetBareWordLeg, shape_fleet_ssh_exec, shape_fleet_ssh_password_exec_trusting,
  FleetLegKind, ProbeLeg, ActuationLeg, RepositoryConvergenceLeg, ProvisioningLeg,
  fleet_remote_leg_wall_deadline,
  fleet_known_hosts_registry_identity, fleet_ssh_multiplex_control_path,
}
