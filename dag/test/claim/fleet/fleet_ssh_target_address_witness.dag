// THE POPULATION THE RECORDING WAS TAKEN OVER, SUPPLIED AT THE CROSSING. The pin is a fact about the
// crossing and the two shapers, so its inputs are the endpoint text each recorded host crossed with, not
// the live enrollment: a host enrolled after the recording (mtcollins1, gunbc#14762) has no "before" to be
// byte-identical to, and drawing the population live made the pin red on every enrollment while every
// shaper byte was unchanged. That the real producer still resolves every enrolled host, recorded or not, is
// the inhabitance claims' subject (an_enrolled_fleet_host_resolves_at_port_22_through_the_real_producer and
// the_key_and_password_argv_differ_for_every_enrolled_host, both over fleet_reach_probe_targets).
type WRecordedHost {
  host: String
  endpoint: String
}

data w_recorded_hosts: List<WRecordedHost> = [
  WRecordedHost { host: "srv1", endpoint: "srv1" },
  WRecordedHost { host: "srv2", endpoint: "srv2" },
  WRecordedHost { host: "srv3", endpoint: "srv3" },
  WRecordedHost { host: "srv4", endpoint: "srv4" },
  WRecordedHost { host: "host-183527", endpoint: "178.104.134.135" },
  WRecordedHost { host: "host-3dde7f", endpoint: "62.238.115.145" },
]

// The same layout re-derived through the new route: each recorded host's endpoint text crosses at
// fleet_ssh_target_at_standard_port, the wire is ssh_target_wire, and both shapers render the argv. A
// host whose text refused prints a refusal line the recording does not contain.
fn w_renders_over(hosts: List<WRecordedHost>) -> String {
  match fleet_ssh_execution_context_hermetic_witness_fixture() {
    Absent => "NO-CONTEXT"
    Present { value: ctx } =>
      match portable_remote_words(raws: ["hostname"]) {
        Absent => "NO-WORDS"
        Present { value: words } =>
          join(map(hosts, r =>
            match fleet_ssh_target_at_standard_port(endpoint: r.endpoint, principal: fleet_automation_principal_login) {
              SshTargetRefused { endpoint: e, refusal: _ } => join(["host=", r.host, " REFUSED ", e, "\n"], "")
              SshTargetResolved { target: t } =>
                join([
                  "host=", r.host, " wire=", ssh_target_wire(target: t) as String, "\n",
                  "key=", join(shape_fleet_ssh_exec(context: ctx, target: t, words: words), "\n  | "), "\n",
                  "pw=", join(shape_fleet_ssh_password_exec_trusting(trust: ctx.trust, target: t, words: words), "\n  | "), "\n",
                ], "")
            }), "")
      }
  }
}

// POSITIVE CONTROL: for every host the recording covers, at port 22, both shapers' argv and the receipt
// wire are byte-identical to what they were before the target carried a port.
test fn every_recorded_host_renders_byte_identically_at_port_22() -> Bool {
  w_renders_over(hosts: w_recorded_hosts) == w_recorded_port_22_renders
}

// THE SUPPLIED POPULATION IS A READING OF THE REAL PRODUCER: every recorded host is still enrolled and
// crosses with the endpoint text gunbc.fleet.fleet_reach_endpoint fleet_probe_endpoint_for gives it today,
// so a change to a recorded host's endpoint reds here instead of passing the pin unseen. A host enrolled
// after the recording is not required to be in it (the join runs recorded -> enrolled only).
test fn every_recorded_host_is_enrolled_at_its_recorded_endpoint() -> Bool {
  all(w_recorded_hosts, r => any(fleet_reach_probe_targets, h => h == r.host) && fleet_probe_endpoint_for(host: r.host) == r.endpoint)
}

// The two arms the pin covers are distinct for every host, so the control above discriminates the key
// arm from the password arm rather than pinning one argv twice.
test fn the_key_and_password_argv_differ_for_every_enrolled_host() -> Bool {
  all(fleet_reach_probe_targets, h =>
    match fleet_ssh_target_at_standard_port(endpoint: fleet_probe_endpoint_for(host: h), principal: fleet_automation_principal_login) {
      SshTargetResolved { target: t } => w_key_argv(target: t) != "" && w_key_argv(target: t) != w_password_argv(target: t)
      SshTargetRefused { endpoint: _, refusal: _ } => false
    })
}
