module test.claim.fleet.fleet_converge_checkout_trust

import std.types { Bool, String }
import std.algebra { string_contains }
import extdeps.github.expressions { interpolate }
import gunbc.fleet.fleet_converge_workflow {
  fleet_converge_checkout_ref_expr, fleet_converge_event_sha_checkout_ref_expr, fleet_converge_build_checkout_ref,
  FleetConvergeWorkflowMode, fleet_converge_workflow_modes, fleet_converge_mode_job_id, fleet_converge_shared_job_id,
  fleet_converge_shared_job_if, fleet_converge_any_mode_step_if, fleet_converge_workflow_mode_wire
}

// THE CHECKOUT TRUST BOUNDARY, ASSERTED PER JOB KIND (one shared predicate for the three mode
// witnesses that each carried its own copy of the pre-#14314 equality). Authority for the split is
// gunbc#14314 (86466c5a05f, "apply/deploy execute at the plan receipt's revision"): apply and deploy
// check out needs.build.outputs.revision, build exports the plan-revision job's output, and every
// other job (boot, observe, printer, namecheap) checks out the event sha with no input in the
// expression. A revision nobody approved must not change a byte we execute, so each ref is pinned
// by EQUALITY, not by containing the sha, and none may mention a dispatch input.
// RED: pointing an observe/boot job at needs.build.outputs, the apply ref losing its event-sha
// fallback, the build output reading a dispatch input, or any of the refs naming expected_revision.
fn fleet_converge_checkout_trust_holds() -> Bool {
  let build_ref = interpolate(expression: fleet_converge_build_checkout_ref)
  fleet_converge_event_sha_checkout_ref_expr == "${{ github.sha }}"
    && fleet_converge_checkout_ref_expr == "${{ needs.build.outputs.revision || github.sha }}"
    && build_ref == "${{ needs['plan-revision'].outputs.revision || github.sha }}"
    && !string_contains(s: fleet_converge_checkout_ref_expr, pattern: "expected_revision")
    && !string_contains(s: build_ref, pattern: "expected_revision")
    && !string_contains(s: fleet_converge_checkout_ref_expr, pattern: "inputs")
    && !string_contains(s: build_ref, pattern: "inputs")
}

// THE POSITIVE MODE SET OF THE SHARED JOB. The shared job checks out needs.build.outputs.revision,
// so a mode that must be shielded from that ref has its own job and must never run in the shared
// one. Pinned by EQUALITY against the condition derived from the modes whose job id is the shared
// one, minus the excluded mode, so `always()`, `true`, a reformatted comparison or the excluded
// mode joining the shared job all go red; the excluded mode keeping a job of its own is asserted
// separately because the derivation alone would follow it into the shared set.
fn fleet_converge_shared_job_runs_all_but(excluded: FleetConvergeWorkflowMode) -> Bool {
  fleet_converge_mode_job_id(mode: excluded) != fleet_converge_shared_job_id
    && fleet_converge_shared_job_if == fleet_converge_any_mode_step_if(modes: filter(fleet_converge_workflow_modes, mode => fleet_converge_mode_job_id(mode: mode) == fleet_converge_shared_job_id && mode != excluded))
    && string_contains(s: fleet_converge_shared_job_if, pattern: concat(concat("github.event.inputs.mode != '", fleet_converge_workflow_mode_wire(mode: excluded)), "'"))
}
