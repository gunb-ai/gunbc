data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// These rows pin the 2026-08-06 broker-session incident exactly. Fifteen registrations are offline,
// one is online and busy, and local systemd units stayed active throughout — the wedge shape PR B's
// repair loop must not misread as detached on a roster API blip.

test fn srv1_01_is_healthy_while_busy() -> Bool {
  match runner_slot_connectivity_verdict(receipt: ReceiptAbsent, 
    slot: RunnerSlotIdentity { host: operator_host_srv1, slot_index: 1 }
  ) {
    SlotConnectivityHealthy { slot: _, registration_id: id } => id == 1
    _ => false
  }
}

test fn active_offline_registration_is_detached_not_healthy() -> Bool {
  match runner_slot_connectivity_verdict(receipt: ReceiptAbsent, 
    slot: RunnerSlotIdentity { host: operator_host_srv1, slot_index: 2 }
  ) {
    SlotConnectivityDetached { slot: _, registration_id: _ } => true
    _ => false
  }
}

test fn active_without_registration_is_orphaned() -> Bool {
  match runner_slot_connectivity_verdict(receipt: ReceiptAbsent, 
    slot: RunnerSlotIdentity { host: operator_host_srv2, slot_index: 3 }
  ) {
    SlotConnectivityOrphaned { slot: _ } => true
    _ => false
  }
    && match runner_slot_connectivity_verdict(receipt: ReceiptAbsent, 
      slot: RunnerSlotIdentity { host: operator_host_srv3, slot_index: 3 }
    ) {
      SlotConnectivityOrphaned { slot: _ } => true
      _ => false
    }
}

// THE FAIL-CLOSED ROW PR B'S SAFETY DEPENDS ON: a roster read failure must render UNKNOWN on every
// active slot, never detached. Zero-width achieved fields must stay unobserved rather than
// fabricated as zero registrations.

test fn roster_unavailable_yields_unknown_on_every_active_slot() -> Bool {
  let roster = RosterReadUnavailable { reason: "GitHub org runners API returned 503" }
  roster_unavailable_yields_unknown_not_detached(receipt: ReceiptAbsent, roster: roster)
    && all(
      connectivity_verdicts_for_active_incarnations(receipt: ReceiptAbsent, roster: roster),
      v => connectivity_verdict_is_unknown(v: v)
    )
}

test fn roster_unavailable_does_not_fabricate_zero_achieved_widths() -> Bool {
  let snapshot = fleet_runner_capacity_width_snapshot_from_roster(
    roster: RosterReadUnavailable { reason: "GitHub org runners API returned 503" }
  )
  match snapshot.achieved {
    AchievedWidthsUnobserved { reason: _ } => true
    AchievedWidthsObserved { registered_width: _, connected_width: _, schedulable_width: _, executing_width: _ } => false
  }
}

test fn incident_registered_sixteen_does_not_imply_connected_sixteen() -> Bool {
  let snapshot = fleet_runner_capacity_width_snapshot()
  match snapshot.achieved {
    AchievedWidthsObserved {
      registered_width: r,
      connected_width: c,
      schedulable_width: s,
      executing_width: e,
    } => r == 16 && c == 1 && s == 0 && e == 1 && r != c
    AchievedWidthsUnobserved { reason: _ } => false
  }
}

test fn desired_width_stays_twenty_two_while_connected_is_one() -> Bool {
  let snapshot = fleet_runner_capacity_width_snapshot()
  snapshot.desired_width == 22
    && match snapshot.achieved {
      AchievedWidthsObserved { registered_width: _, connected_width: c, schedulable_width: _, executing_width: _ } =>
        c == 1
      AchievedWidthsUnobserved { reason: _ } => false
    }
}

test fn materialized_and_unit_active_widths_are_twenty_not_desired() -> Bool {
  let snapshot = fleet_runner_capacity_width_snapshot()
  snapshot.materialized_width == 20
    && snapshot.unit_active_width == 20
    && snapshot.desired_width > snapshot.materialized_width
}

test fn detached_count_matches_offline_registrations_on_active_slots() -> Bool {
  let roster = incident_2026_08_06_roster_fixture()
  let verdicts = connectivity_verdicts_for_active_incarnations(receipt: ReceiptAbsent, roster: roster)
  count_matching(verdicts: verdicts, matched: v => connectivity_verdict_is_detached(v: v)) == 15
}

test fn healthy_count_is_one_and_orphaned_count_is_four() -> Bool {
  let roster = incident_2026_08_06_roster_fixture()
  let verdicts = connectivity_verdicts_for_active_incarnations(receipt: ReceiptAbsent, roster: roster)
  count_matching(verdicts: verdicts, matched: v => connectivity_verdict_is_healthy(v: v)) == 1
    && count_matching(verdicts: verdicts, matched: v => connectivity_verdict_is_orphaned(v: v)) == 4
}

test fn local_incarnation_observation_covers_twenty_active_units() -> Bool {
  local_runner_slot_incarnations().length() == 20
    && all(
      local_runner_slot_incarnations(),
      inc => inc.unit_active
    )
}

test fn fleet_runner_connectivity_RED_orphaned_slot_must_not_read_detached() -> Bool {
  match runner_slot_connectivity_verdict(receipt: ReceiptAbsent, 
    slot: RunnerSlotIdentity { host: operator_host_srv4, slot_index: 3 }
  ) {
    SlotConnectivityOrphaned { slot: _ } => true
    SlotConnectivityDetached { slot: _, registration_id: _ } => false
    _ => false
  }
}

fn count_matching(
  verdicts: List<RunnerSlotConnectivityVerdict>,
  matched: fn(RunnerSlotConnectivityVerdict) -> Bool,
) -> Int {
  fold(
    verdicts,
    init: 0,
    f: (n, v) => if matched(v) { n + 1 } else { n }
  )
}

// ---------------------------------------------------------------------------
// TRUNCATED ROSTER: the discriminating pair for the paginated-read repair.
//
// The org runners API is paginated. Measured 2026-08-27T21:29Z: total_count 522
// against a 100-row page. A read that SUCCEEDS is therefore not a read that saw
// everything, and the defect this pair pins is that a slot missing from a PREFIX
// was never observed to be missing -- rendering it Orphaned is the empty-observation
// narrow, and Orphaned is what maps to a restart at
// gunbc.runner.runner_capacity_plan connectivity_replace_action.
//
// THE PAIR IS THE POINT. The RED arm alone would also pass if Orphaned had simply
// been disabled everywhere, so the complete-roster control is what makes it
// discriminating rather than merely green.

// BOTH FIXTURES DERIVE THEIR TOTAL FROM THE SPECIMEN, so neither can silently change meaning when
// a registration row is added. A hand-written total would make "partial" and "complete" facts about
// a literal someone remembered to update rather than facts about the pair.
fn truncated_incident_roster() -> OrganizationRunnerRosterEvidence {
  organization_runner_roster_from_page(
    observed_on: "2026-08-27" as NonEmptyStr,
    registrations: incident_2026_08_06_registrations,
    authority_total: incident_2026_08_06_registrations.length() + 1,
  )
}

fn complete_incident_roster() -> OrganizationRunnerRosterEvidence {
  organization_runner_roster_from_page(
    observed_on: "2026-08-27" as NonEmptyStr,
    registrations: incident_2026_08_06_registrations,
    authority_total: incident_2026_08_06_registrations.length(),
  )
}

// NO TRANSCRIBED COUNT. Asserting the specimen list's current length would pin a literal measured
// from the tree it is testing (DESIGN section 5 on oracles) and would rot the next time a
// registration row is added. The property under test is the RELATION: a page smaller than the
// authority's own total is partial, whatever either number happens to be.
test fn prefix_below_authority_total_is_partial() -> Bool {
  match truncated_incident_roster() {
    RosterObservedPartial { observed_on: _, registrations: _, observed_count: seen, authority_total: total } =>
      seen < total
    _ => false
  }
}

test fn page_equal_to_authority_total_is_complete() -> Bool {
  match complete_incident_roster() {
    RosterObserved { observed_on: _, registrations: _ } => true
    _ => false
  }
}

// THE RED. Before the repair every unseen slot rendered Orphaned here.
test fn truncated_roster_never_orphans_an_unseen_slot() -> Bool {
  all(
    connectivity_verdicts_for_active_incarnations(receipt: ReceiptAbsent, roster: truncated_incident_roster()),
    v => !connectivity_verdict_is_orphaned(v: v)
  )
}

// THE POSITIVE CONTROL. The required refusal must SURVIVE the repair: over a roster
// the authority itself calls complete, a slot with no registration is genuinely gone
// and must still be Orphaned. If this arm ever goes green-by-absence the RED above
// has stopped discriminating.
test fn complete_roster_still_orphans_an_unseen_slot() -> Bool {
  !all(
    connectivity_verdicts_for_active_incarnations(receipt: ReceiptAbsent, roster: complete_incident_roster()),
    v => !connectivity_verdict_is_orphaned(v: v)
  )
}

// PER-QUESTION, NOT PER-ROSTER. A truncated read still answers exactly about every
// slot INSIDE the prefix; refusing the whole roster would be a widen that stops
// reconciliation on hosts the read covered perfectly well.
test fn truncated_roster_still_answers_slots_inside_the_prefix() -> Bool {
  !all(
    connectivity_verdicts_for_active_incarnations(receipt: ReceiptAbsent, roster: truncated_incident_roster()),
    v => connectivity_verdict_is_unknown(v: v)
  )
}

// ── registration-label readback: the desired side is runner_evidence_gated_registration_labels(slot host, receipt) ──
// ONE ONLINE REGISTRATION, VARIED ONLY IN ITS LABELS, read through the real verdict fold over a
// complete roster. The expected sets are spelled here rather than computed from the composition, so
// a composition that dropped a label would turn the positive control red.
//
// SRV4'S CI SLOT CARRIES gunbc-user-session exactly when the converge receipt the leg read grants it
// (gunbc.runner.runner_registration_labels runner_evidence_gated_registration_labels); the receipt is a parameter
// here, supplied at this boundary. test.claim.runner.runner_user_session_label_witness covers the receipt-backed side.
// Controls that do not concern the label supply ReceiptAbsent explicitly.
fn online_srv4_01_under(labels: List<NonEmptyStr>, receipt: RunnerUserSessionReceiptInput) -> RunnerSlotConnectivityVerdict {
  online_01_under(host: operator_host_srv4, name: "srv4-01", labels: labels, receipt: receipt)
}

fn online_01_under(host: HostIdentity, name: String, labels: List<NonEmptyStr>, receipt: RunnerUserSessionReceiptInput) -> RunnerSlotConnectivityVerdict {
  runner_slot_connectivity_verdict_for_incarnation(receipt: receipt, main: committed_incarnation_main_process_unread,
    incarnation: runner_slot_incarnation(host: host, slot_index: 1, unit_active: true),
    roster: organization_runner_roster_from_page(
      observed_on: "2026-09-19" as NonEmptyStr,
      registrations: [
        GitHubSelfHostedRunnerRegistration {
          id: 9401,
          name: name as NonEmptyStr,
          status: GitHubRunnerOnline,
          busy: false,
          ephemeral: Present { value: true },
          version: Present { value: "2.334.0" as NonEmptyStr },
          os: "Linux" as NonEmptyStr,
          labels: labels,
        },
      ],
      authority_total: 1,
    ),
  )
}

test fn online_registration_under_its_own_class_and_host_labels_is_healthy() -> Bool {
  connectivity_verdict_is_healthy(
    v: online_srv4_01_under(labels: ["srv4" as NonEmptyStr, "arm64" as NonEmptyStr, "gunbc-heavy" as NonEmptyStr, "linux" as NonEmptyStr, "self-hosted" as NonEmptyStr], receipt: ReceiptAbsent),
  )
}

// THE READBACK EXPECTS THE LABEL EXACTLY WHEN THE RECEIPT GRANTS IT: srv4 is rostered, so its CI registration
// carrying gunbc-user-session is healthy under a fresh holding receipt and diverges under no receipt (the grant
// lapsed or was never made, and the label is held on roster membership alone); an unrostered host carrying it
// diverges under any receipt -- a stale config, a hand-edited .credential file.
// RED control: tolerate the label on roster alone and the no-receipt arm goes red; ignore the receipt and the
// healthy arm goes red; license it on every host and the srv3 arm goes red.
test fn the_user_session_label_is_healthy_only_under_a_receipt_that_grants_it() -> Bool {
  connectivity_verdict_is_healthy(
    v: online_srv4_01_under(labels: ["srv4" as NonEmptyStr, "arm64" as NonEmptyStr, "gunbc-heavy" as NonEmptyStr, "linux" as NonEmptyStr, "self-hosted" as NonEmptyStr, "gunbc-user-session" as NonEmptyStr], receipt: srv4_holding_input()),
  )
    && connectivity_verdict_labels_diverge(
      v: online_srv4_01_under(labels: ["srv4" as NonEmptyStr, "arm64" as NonEmptyStr, "gunbc-heavy" as NonEmptyStr, "linux" as NonEmptyStr, "self-hosted" as NonEmptyStr, "gunbc-user-session" as NonEmptyStr], receipt: ReceiptAbsent),
    )
    && connectivity_verdict_labels_diverge(
      v: online_01_under(host: operator_host_srv3, name: "srv3-01", labels: ["srv3" as NonEmptyStr, "arm64" as NonEmptyStr, "gunbc-heavy" as NonEmptyStr, "linux" as NonEmptyStr, "self-hosted" as NonEmptyStr, "gunbc-user-session" as NonEmptyStr], receipt: srv4_holding_input()),
    )
    && connectivity_verdict_is_unknown(
      v: online_srv4_01_under(labels: ["srv4" as NonEmptyStr, "arm64" as NonEmptyStr, "gunbc-heavy" as NonEmptyStr, "linux" as NonEmptyStr, "self-hosted" as NonEmptyStr, "gunbc-user-session" as NonEmptyStr], receipt: ReceiptUnreadable { why: "converge receipt read, run listing: absence not established" }),
    )
    && connectivity_verdict_is_unknown(
      v: online_srv4_01_under(labels: ["srv4" as NonEmptyStr, "arm64" as NonEmptyStr, "gunbc-heavy" as NonEmptyStr, "linux" as NonEmptyStr, "self-hosted" as NonEmptyStr], receipt: ReceiptUnreadable { why: "converge receipt read, run listing: absence not established" }),
    )
}

test fn online_registration_missing_the_class_label_is_not_healthy() -> Bool {
  connectivity_verdict_labels_diverge(
    v: online_srv4_01_under(labels: ["self-hosted" as NonEmptyStr, "linux" as NonEmptyStr, "arm64" as NonEmptyStr, "srv4" as NonEmptyStr], receipt: ReceiptAbsent),
  )
}

test fn online_registration_missing_the_host_label_is_not_healthy() -> Bool {
  connectivity_verdict_labels_diverge(
    v: online_srv4_01_under(labels: ["self-hosted" as NonEmptyStr, "linux" as NonEmptyStr, "arm64" as NonEmptyStr, "gunbc-heavy" as NonEmptyStr], receipt: ReceiptAbsent),
  )
}

// WRONG HOST: an srv3-labelled runner answering to srv4-01's name must not read as srv4's.
test fn online_registration_under_another_hosts_label_is_not_healthy() -> Bool {
  connectivity_verdict_labels_diverge(
    v: online_srv4_01_under(labels: ["self-hosted" as NonEmptyStr, "linux" as NonEmptyStr, "arm64" as NonEmptyStr, "gunbc-heavy" as NonEmptyStr, "srv3" as NonEmptyStr], receipt: ReceiptAbsent),
  )
}

// GITHUB LABEL EQUIVALENCE (case-insensitive): a mixed-case spelling of srv4's own set is Healthy,
// so a case-only difference proposes no repair; a mixed-case wrong host still diverges.
test fn online_registration_under_a_case_variant_of_its_labels_is_healthy() -> Bool {
  connectivity_verdict_is_healthy(
    v: online_srv4_01_under(labels: ["Self-Hosted" as NonEmptyStr, "Linux" as NonEmptyStr, "ARM64" as NonEmptyStr, "GUNBC-HEAVY" as NonEmptyStr, "SRV4" as NonEmptyStr], receipt: ReceiptAbsent),
  )
}

test fn online_registration_under_a_mixed_case_wrong_host_label_is_not_healthy() -> Bool {
  connectivity_verdict_labels_diverge(
    v: online_srv4_01_under(labels: ["self-hosted" as NonEmptyStr, "Linux" as NonEmptyStr, "ARM64" as NonEmptyStr, "gunbc-heavy" as NonEmptyStr, "SRV3" as NonEmptyStr], receipt: ReceiptAbsent),
  )
}

// ── JIT INCARNATIONS: one registration per incarnation, the current one picked by the unit's pid ──
// The fleet's runners register as <slot>-<epoch>-<pid> (gunbc.runner.runner_incarnation
// parse_jit_registration_name). These claims supply rosters of that shape at the join's boundary; the
// live shape is roster 41694782240 (134 srv1-02 rows, one online). RED for the group: put
// find_registration_by_name back as the only lookup in registration_verdict_or and the current-
// incarnation claims read Orphaned.

test fn a_jit_name_parses_only_under_its_own_slot_with_two_numeric_tokens() -> Bool {
  (match parse_jit_registration_name(name: "srv1-02-1793731396-1395494", slot_instance: "srv1-02") {
    Present { value: n } => n.minted_epoch == 1793731396 && n.wrapper_pid == 1395494
    Absent => false
  })
    && (match parse_jit_registration_name(name: "srv1-02-1793731396-1395494", slot_instance: "srv1-0") { Present { value: _ } => false Absent => true })
    && (match parse_jit_registration_name(name: "srv1-02", slot_instance: "srv1-02") { Present { value: _ } => false Absent => true })
    && (match parse_jit_registration_name(name: "srv1-02-x-1395494", slot_instance: "srv1-02") { Present { value: _ } => false Absent => true })
    && (match parse_jit_registration_name(name: "srv1-02-1-2-3", slot_instance: "srv1-02") { Present { value: _ } => false Absent => true })
}

data srv4_healthy_labels: List<NonEmptyStr> = ["srv4" as NonEmptyStr, "arm64" as NonEmptyStr, "gunbc-heavy" as NonEmptyStr, "linux" as NonEmptyStr, "self-hosted" as NonEmptyStr]

fn jit_row(id: Nat, name: String, online: Bool) -> GitHubSelfHostedRunnerRegistration {
  GitHubSelfHostedRunnerRegistration {
    id: id,
    name: name as NonEmptyStr,
    status: if online { GitHubRunnerOnline } else { GitHubRunnerOffline },
    busy: false,
    ephemeral: Present { value: true },
    version: Present { value: "2.334.0" as NonEmptyStr },
    os: "Linux" as NonEmptyStr,
    labels: srv4_healthy_labels,
  }
}

// One hundred rows of another slot ahead of srv4-01's, so srv4-01's rows sit past the first 100 -- the
// rows the hand-installed reconcile's per_page=100 read never saw.
data jit_other_slot_rows: List<GitHubSelfHostedRunnerRegistration> = map(nat_range_inclusive(lo: 1, hi: 100), i => jit_row(id: 7000 + i, name: concat("srv4-02-1793600000-", to_string(i)), online: false))

data jit_ghost_rows: List<GitHubSelfHostedRunnerRegistration> = [
  jit_row(id: 8101, name: "srv4-01-1793700000-111", online: false),
  jit_row(id: 8102, name: "srv4-01-1793700660-222", online: false),
]

fn jit_main(pid: Nat) -> RunnerUnitMainProcess {
  // Absolute start one second after the fixture rows' minted epoch (1793701320), i.e. the wrapper minted
  // its name and exec-ed within the declared fork-to-exec bound -- a genuine same-boot match, not a
  // recycled pid. The recycled-pid and unread-start arms are covered in the honest-main-reads region.
  MainProcess { process: ProcessIdentity { boot_id: "b" as NonEmptyStr, pid: pid, start_time: "t" as NonEmptyStr }, absolute_start: StartObserved { started_at: 1793701321 } }
}

fn jit_complete_roster(rows: List<GitHubSelfHostedRunnerRegistration>) -> OrganizationRunnerRosterEvidence {
  RosterObserved { observed_on: "2026-11-04" as NonEmptyStr, registrations: rows }
}

fn srv4_01_verdict(main: RunnerUnitMainProcess, roster: OrganizationRunnerRosterEvidence) -> RunnerSlotConnectivityVerdict {
  runner_slot_connectivity_verdict_for_incarnation(
    incarnation: runner_slot_incarnation(host: operator_host_srv4, slot_index: 1, unit_active: true),
    main: main,
    roster: roster,
    receipt: ReceiptAbsent,
  )
}

// The current incarnation (pid 333) is online at row 103, behind 100 other rows and two of its own
// slot's dead incarnations: Healthy. Offline under the same pid it is Detached -- the live one, not a ghost.
test fn the_current_jit_incarnation_is_found_by_its_pid_past_the_first_hundred_rows() -> Bool {
  connectivity_verdict_is_healthy(v: srv4_01_verdict(main: jit_main(pid: 333), roster: jit_complete_roster(rows: concat(jit_other_slot_rows, concat(jit_ghost_rows, [jit_row(id: 8103, name: "srv4-01-1793701320-333", online: true)])))))
    && connectivity_verdict_is_detached(v: srv4_01_verdict(main: jit_main(pid: 333), roster: jit_complete_roster(rows: concat(jit_other_slot_rows, concat(jit_ghost_rows, [jit_row(id: 8103, name: "srv4-01-1793701320-333", online: false)])))))
}

// Dead incarnations are not the current one: with only ghosts under the slot and the pid read, the
// current incarnation has no registration (Orphaned under a complete roster); with the pid NOT read, the
// current one cannot be told apart, which is Unknown -- never Orphaned or Detached. That second arm is the
// false-WEDGED class: an offline row read as the live incarnation's.
test fn dead_incarnations_never_stand_in_for_the_current_one() -> Bool {
  connectivity_verdict_is_orphaned(v: srv4_01_verdict(main: jit_main(pid: 333), roster: jit_complete_roster(rows: concat(jit_other_slot_rows, jit_ghost_rows))))
    && connectivity_verdict_is_unknown(v: srv4_01_verdict(main: committed_incarnation_main_process_unread, roster: jit_complete_roster(rows: concat(jit_other_slot_rows, jit_ghost_rows))))
}

// With the pid not read, the one online row under the slot is the current incarnation's.
test fn with_no_pid_the_single_online_jit_row_is_the_current_incarnation() -> Bool {
  connectivity_verdict_is_healthy(v: srv4_01_verdict(main: committed_incarnation_main_process_unread, roster: jit_complete_roster(rows: concat(jit_ghost_rows, [jit_row(id: 8103, name: "srv4-01-1793701320-333", online: true)]))))
}

// A truncated roster that does not reach the current incarnation's row is Unknown, never Orphaned.
test fn a_partial_roster_without_the_current_row_is_unknown() -> Bool {
  connectivity_verdict_is_unknown(v: srv4_01_verdict(main: jit_main(pid: 333), roster: RosterObservedPartial { observed_on: "2026-11-04" as NonEmptyStr, registrations: concat(jit_other_slot_rows, jit_ghost_rows), observed_count: 102, authority_total: 2028 }))
}

fn decodes_as_live_slot(reg: GitHubSelfHostedRunnerRegistration) -> Bool {
  match decode_registration_slot(reg: reg) {
    RegistrationNamesCommittedSlot { slot: _ } => true
    _ => false
  }
}

fn decodes_as_dead_incarnation(reg: GitHubSelfHostedRunnerRegistration) -> Bool {
  match decode_registration_slot(reg: reg) {
    RegistrationNamesDeadIncarnation { slot: _ } => true
    _ => false
  }
}

fn decodes_as_foreign(reg: GitHubSelfHostedRunnerRegistration) -> Bool {
  match decode_registration_slot(reg: reg) {
    RegistrationNamesNoCommittedSlot { registration_name: _ } => true
    _ => false
  }
}

// The capacity plan's population decode over a JIT fleet: an online `<slot>-<epoch>-<pid>` row IS the slot's
// registration, an offline one is a dead incarnation (no population member, no Foreign refusal), and a name
// that fits no committed slot's grammar stays Foreign.
test fn a_jit_registration_decodes_to_its_slot_live_or_dead_and_a_stranger_stays_foreign() -> Bool {
  decodes_as_live_slot(reg: jit_row(id: 1, name: "srv4-01-1793701320-333", online: true))
    && decodes_as_dead_incarnation(reg: jit_row(id: 2, name: "srv4-01-1793701320-333", online: false))
    && decodes_as_foreign(reg: jit_row(id: 3, name: "srv4-01-notanumber-333", online: true))
    && decodes_as_foreign(reg: jit_row(id: 4, name: "elsewhere-01-1793701320-333", online: false))
}

data srv4_01_slot: RunnerSlotIdentity = RunnerSlotIdentity { host: operator_host_srv4, slot_index: 1 }

fn srv4_01_registrations_are(roster: OrganizationRunnerRosterEvidence, live: Int, dead: Int) -> Bool {
  match observe_slot_registrations(slot: srv4_01_slot, roster: roster) {
    SlotRegistrationsObserved { slot: _, live: l, dead: d } => l == live && d == dead
    SlotRegistrationsUnobserved { slot: _, reason: _ } => false
  }
}

fn srv4_01_registrations_unobserved(roster: OrganizationRunnerRosterEvidence) -> Bool {
  match observe_slot_registrations(slot: srv4_01_slot, roster: roster) {
    SlotRegistrationsObserved { slot: _, live: _, dead: _ } => false
    SlotRegistrationsUnobserved { slot: _, reason: _ } => true
  }
}

// ObserveGitHubRunnerRegistration over the real decode: past the first hundred other-slot rows, srv4-01's one
// online JIT row counts live and its two ghosts count dead; the other slot's hundred count for neither.
test fn the_registration_observation_counts_a_slots_live_and_dead_jit_rows_through_the_decode() -> Bool {
  srv4_01_registrations_are(
    roster: jit_complete_roster(rows: concat(concat(jit_other_slot_rows, jit_ghost_rows), [jit_row(id: 8103, name: "srv4-01-1793701320-333", online: true)])),
    live: 1,
    dead: 2,
  )
}

// POSITIVE CONTROL for the RED below: a slot with no rows of its own reads live=0 dead=0 on a complete roster.
test fn a_complete_roster_without_the_slots_rows_observes_zero_and_zero() -> Bool {
  srv4_01_registrations_are(roster: jit_complete_roster(rows: jit_other_slot_rows), live: 0, dead: 0)
}

// RED: absence from a prefix is not absence from the organization. A partial or unavailable roster is
// UNOBSERVED, and is never rendered as the zero the control above proves a complete roster can answer.
test fn a_partial_or_unavailable_roster_never_observes_a_zero() -> Bool {
  srv4_01_registrations_unobserved(roster: RosterObservedPartial { observed_on: "2026-11-04" as NonEmptyStr, registrations: jit_other_slot_rows, observed_count: 100, authority_total: 233 })
    && srv4_01_registrations_unobserved(roster: RosterReadUnavailable { reason: "no token" })
    && !slot_registration_observation_settled(o: observe_slot_registrations(slot: srv4_01_slot, roster: RosterReadUnavailable { reason: "no token" }))
}

// ── THE RECYCLED-PID CHECK: a pid-matched row is only the current incarnation if it agrees with the
//    running process's observed absolute start (model C: wall clock read at the boundary, compared here) ──

fn current_333_online_roster() -> OrganizationRunnerRosterEvidence {
  jit_complete_roster(rows: concat(jit_other_slot_rows, concat(jit_ghost_rows, [jit_row(id: 8103, name: "srv4-01-1793701320-333", online: true)])))
}

fn jit_main_at(pid: Nat, abs: ProcessAbsoluteStart) -> RunnerUnitMainProcess {
  MainProcess { process: ProcessIdentity { boot_id: "b" as NonEmptyStr, pid: pid, start_time: "t" as NonEmptyStr }, absolute_start: abs }
}

// POSITIVE CONTROL (same-boot match): the row's mint (1793701320) and the process start (1793701321)
// agree within the fork-to-exec bound, so the online pid-matched row is the current incarnation.
test fn a_same_boot_pid_match_is_the_current_incarnation() -> Bool {
  connectivity_verdict_is_healthy(v: srv4_01_verdict(main: jit_main_at(pid: 333, abs: StartObserved { started_at: 1793701321 }), roster: current_333_online_roster()))
}

// DISCRIMINATING RED (recycled across a reboot): an online row keeps srv4-01's pid 333 from a dead boot,
// but the running process started long after that row was minted. Without the start comparison this is
// the false-HEALTHY (or false-wedged) case; with it the slot is Unknown, never Healthy or Detached.
test fn a_pid_recycled_across_a_reboot_is_unknown_not_healthy() -> Bool {
  connectivity_verdict_is_unknown(v: srv4_01_verdict(main: jit_main_at(pid: 333, abs: StartObserved { started_at: 1793701720 }), roster: current_333_online_roster()))
}

// DISCRIMINATING RED (minted after start): the row claims a mint AFTER the process began, which no
// genuine wrapper can do -- a pid borrowed from a name it never owned. Unknown, not Healthy.
test fn a_row_minted_after_the_process_started_is_unknown() -> Bool {
  connectivity_verdict_is_unknown(v: srv4_01_verdict(main: jit_main_at(pid: 333, abs: StartObserved { started_at: 1793701220 }), roster: current_333_online_roster()))
}

// DISCRIMINATING RED (unread start): with the absolute start unread the current incarnation cannot be
// told apart from a recycled pid, and it is NEVER guessed -- Unknown, not Healthy and not Orphaned.
test fn an_unread_absolute_start_is_unknown_not_a_guess() -> Bool {
  connectivity_verdict_is_unknown(v: srv4_01_verdict(main: jit_main_at(pid: 333, abs: StartUnread { cause: "btime unread" as NonEmptyStr }), roster: current_333_online_roster()))
}

// The wet entry's pure half: with the roster unreadable (the arm it records when no admitted token source minted),
// every committed slot's line is UNOBSERVED, so the receipt can never carry a zero it did not read.
test fn the_wet_entrys_lines_for_an_unavailable_roster_are_unobserved_per_slot() -> Bool {
  runner_connectivity_observation_lines(roster: RosterReadUnavailable { reason: "no token" })
    == map(local_runner_slot_incarnations(), inc => slot_registration_observation_wire(o: SlotRegistrationsUnobserved { slot: inc.slot, reason: "roster unavailable: no token" }))
}

// The srv4 holding receipt, built here from the receipt module's own document writer and parser rather than imported
// from test.claim.runner.runner_user_session_label_witness: that witness imports fleet_converge_workflow (and through
// it the CI spec emitters), which put 3,000+ files and a 90-minute timeout in this witness's closure (DESIGN section 3,
// a witness discriminates at one interface). The label witness keeps the receipt-backed grant claims.
fn srv4_holding_input() -> RunnerUserSessionReceiptInput {
  runner_user_session_receipt_input_of_text(
    text: join(
      [
        "context_receipt: agent accepted\n",
        runner_user_session_converge_receipt_document_text(
          receipt: RunnerUserSessionConvergeReceipt {
            host: "srv4",
            probed_at: "2026-10-28T00:00:00Z",
            enable_linger: parse_user_session_linger_enable(rest: "ok"),
            linger: parse_loginctl_linger_reading(rest: "yes"),
            bus: parse_user_session_answer(rest: "answered"),
          },
          job_user: "ghrunner",
        ),
      ],
      "",
    ),
    read_at: "2026-10-28T00:00:00Z",
  )
}
