// THE RECEIPT CANNOT SAY 'APPLIED' ABOUT WORK IT DID NOT DO.
//
// Found on srv1 apply run 44428803079 (plan 44423114994). The plan listed two cap drop-in CHANGEs and
// four runner-slot REMOVEs (srv1-10/11/12/14). The apply was CORRECTLY fail-closed and did none of them:
// the cap axis is never emitted into apply.sh, because writing a drop-in is live_deploy's authority, and
// the four teardowns were withheld -- apply.sh echoed `__GUNBC_CONVERGE_WITHHELD__ ... cause=no
// retirement evidence`, because srv1-07/08/09 were still running. The receipt read:
//
//     partially_applied|7|slot=5 cap=0 timer=0 fabric-cell=0 activation=2
//
// with exit 0 and the word `applied` under it. Every number on that line is a refusal, and nothing on it
// was owed: the terminal was minted from refusal counts alone, so withheld and plan-only rows landed in
// neither the applied nor the refused column and simply vanished. The LiveDeployMemberBasis arm of the
// same function already refuses to call a non-empty plan FullyApplied, and its comment names this exact
// failure -- "the plan says work is needed, nothing does it, the terminal reports applied". The
// FullHostConverge arm, the one srv1 runs under, had no such guard.
//
// THE CONTROL THESE CLAIMS HOLD TOGETHER is that the receipt's numbers are READ OFF the two artifacts the
// operator already has: the rows come from the plan and the lines come from the script. A claim here
// compares the receipt against the artifact it was minted with, so a future change that counts something
// else -- or counts nothing -- has to break one of these rather than quietly re-tune a constant.
module test.claim.fleet.fleet_converge_owed_work_witness

import std.types { Bool, Int, List, NonEmptyStr, String }
import std.algebra { string_contains }
import gunbc.fleet.fleet_converge_plan {
  FleetConvergePlanArtifact,
  FleetConvergeSlotFamily,
  fleet_converge_cap_plan_only_members,
  fleet_converge_cap_plan_only_row_count,
  fleet_converge_plan_artifact,
  fleet_converge_slot_family,
  slot_family_withheld_units,
}
import gunbc.fleet.fleet_converge_terminal {
  AwaitingCapability,
  FleetConvergeApplyTerminal,
  FleetConvergeOwedWork,
  FullyApplied,
  PartiallyApplied,
  fleet_converge_apply_terminal_of_wire,
  fleet_converge_apply_terminal_wire,
  fleet_converge_full_host_terminal,
  OwedReportContradiction,
  fleet_converge_owed_work_is_clear,
}
import gunbc.fleet.fleet_host_identity {
  operator_host_srv1,
  operator_host_srv3,
}
import gunbc.fabric.fabric_cell_observation_admission { fabric_cell_observation_unobserved }
import gunbc.host.host_axis_caps { CapMember }
import gunbc.host.host_converge { gunbc_runner_per_slot_dropin_path }
import gunbc.runner.runner_service_activation {
  runner_activation_readiness_unobserved_no_transaction,
  runner_unit_standings_unobserved_no_transaction,
}
import gunbc.runner.runner_slot_provision {
  RunnerSlotMember,
  SlotProvenanceObserved,
  SlotUnregistered,
  converge_line_is_withheld,
  runner_slot_member_observed,
}
import gunbc.runner.runner_slot_retirement {
  SlotRetirementEvidence,
  SlotRetirementEvidenceAbsent,
  SlotRetirementEvidencePresent,
  srv1_width_interruption_authorization,
  transition_retirement_admission_over,
}
import test.claim.fleet.fleet_host_grant_fixture { witness_grants_rendered }

data owed_witness_host: NonEmptyStr = "srv1" as NonEmptyStr

// THE FOUR TREES THE 44423114994 PLAN LISTED. The provenance is the one that ADMITS a removal -- in
// grammar, unregistered, inactive, disabled -- so these members reach the teardown gate instead of being
// refused before it. Refusing them earlier would test the wrong gate: the srv1 run got four REMOVE rows
// and four withheld teardowns, not four refusals, and the receipt's silence is only reproducible on the
// path where the plan really did list the work.
fn owed_witness_slots() -> List<RunnerSlotMember> {
  [
    runner_slot_member_observed(
      instance_name: "srv1-10",
      provenance: SlotProvenanceObserved {
        in_host_grammar: true,
        registration: SlotUnregistered,
        unit_active: false,
        unit_enabled: false,
      },
    ),
    runner_slot_member_observed(
      instance_name: "srv1-11",
      provenance: SlotProvenanceObserved {
        in_host_grammar: true,
        registration: SlotUnregistered,
        unit_active: false,
        unit_enabled: false,
      },
    ),
    runner_slot_member_observed(
      instance_name: "srv1-12",
      provenance: SlotProvenanceObserved {
        in_host_grammar: true,
        registration: SlotUnregistered,
        unit_active: false,
        unit_enabled: false,
      },
    ),
    runner_slot_member_observed(
      instance_name: "srv1-14",
      provenance: SlotProvenanceObserved {
        in_host_grammar: true,
        registration: SlotUnregistered,
        unit_active: false,
        unit_enabled: false,
      },
    ),
  ]
}

// THE srv1 DROP-INS AS THEY STAND ON DISK, byte for byte, read read-only on 2026-11-19: the 2026-10-30
// live_deploy render of the SUPERSEDED 22 GiB ceiling. The model has demanded 25 GiB since the 2026-11-04
// ruling, so the difference is real -- which is what makes the old "content drift" line so damaging: it
// described a genuine 3 GiB gap in words that could not be told apart from a false positive.
fn srv1_width_dropin_observed() -> CapMember {
  CapMember {
    dropin_path: gunbc_runner_per_slot_dropin_path as NonEmptyStr,
    content: "[Service]\nMemoryMax=23622320128\n",
  }
}

// THE ONE FACT THE FIXTURE CHANGES: no retirement observation is admitted, exactly as on the srv1 run. The
// tree-removal gate cannot be satisfied without it, so every removal the plan lists is withheld -- which is
// what the receipt has to say out loud.
//
// THE EVIDENCE IS MINTED BY THE MODEL, NOT TYPED OUT. The permission is the model's own srv1 authorization
// (`srv1_width_interruption_authorization`, the 2026-09-17 decision over slots 13-50 plus the 2026-10-16
// cut's 03-06), the required retirees are the three units the 44428803079 finding names as still running on
// the host, and the observation is deliberately empty -- nothing was retired on this pass. The model's own
// admission function (runner_slot_retirement.dag's `transition_retirement_admission_over`) then refuses the
// transition and writes its own cause: that the transition "requires retiring units the operator has not
// authorized interrupting ... retiring only the covered subset would release ceilings against a population
// still running". That is the srv1 condition in the model's words, and no cause prose here is the fixture's
// invention. `none` means the admission came back PERMITTED, which would make this fixture a different
// fixture: the claims that need withheld teardowns then FAIL rather than pass over work they did not ask for.
fn owed_witness_evidence() -> SlotRetirementEvidence? {
  match transition_retirement_admission_over(
    host: operator_host_srv1,
    auth: srv1_width_interruption_authorization,
    required: owed_witness_required_retirees(),
    standings: [],
  ) {
    SlotRetirementEvidenceAbsent { cause: c } =>
      // THE PASS-THROUGH IS THE POINT: the cause is the model's sentence, written by the admission function
      // above, and nothing here re-types it. It is wrapped rather than returned bare because the match's
      // arms must all inhabit the function's declared `SlotRetirementEvidence?` -- handing the checker a
      // bare `SlotRetirementEvidence` on one side and the empty case on the other leaves the arms with no
      // common type, which is what the first cut did.
      Present { value: SlotRetirementEvidenceAbsent { cause: c } }
    SlotRetirementEvidencePresent { authorization: _, standings: _ } => Absent
  }
}

// THE UNITS THAT WERE STILL RUNNING WHEN 44428803079 RAN, from the finding that opened this work. They are
// outside every srv1 authorization's scope -- the 09-17 decision says so outright ("does not name
// srv1-01..12") -- which is why the admission above cannot come back permitted.
fn owed_witness_required_retirees() -> List<NonEmptyStr> {
  [
    "actions-runner@srv1-07.service" as NonEmptyStr,
    "actions-runner@srv1-08.service" as NonEmptyStr,
    "actions-runner@srv1-09.service" as NonEmptyStr,
  ]
}

fn artifact_with(
  observed_caps: List<CapMember>,
  observed_slots: List<RunnerSlotMember>,
) -> FleetConvergePlanArtifact? {
  match owed_witness_evidence() {
    Absent => none
    Present { value: evidence } => artifact_with_evidence(
      observed_caps: observed_caps,
      observed_slots: observed_slots,
      evidence: evidence,
    )
  }
}

fn artifact_with_evidence(
  observed_caps: List<CapMember>,
  observed_slots: List<RunnerSlotMember>,
  evidence: SlotRetirementEvidence,
) -> FleetConvergePlanArtifact? {
  fleet_converge_plan_artifact(
    host: owed_witness_host,
    prior_generation: 0,
    observed_timers: [],
    observed_caps: observed_caps,
    observed_slots: observed_slots,
    observed_fabric_cells: fabric_cell_observation_unobserved(host: operator_host_srv3),
    observed_activation_readiness: runner_activation_readiness_unobserved_no_transaction,
    observed_unit_standings: runner_unit_standings_unobserved_no_transaction,
    observed_retirement: evidence,
    observed_host_grants: witness_grants_rendered(host: owed_witness_host),
  )
}

fn artifact_with_withheld_teardowns() -> FleetConvergePlanArtifact? {
  artifact_with(observed_caps: [], observed_slots: owed_witness_slots())
}

fn plan_rows_starting_with(plan_body: String, prefix: String) -> Int {
  count(filter(split(s: plan_body, delimiter: "\n"), l => starts_with(s: l, prefix: prefix)))
}

// THE WITHHELD LINES IN THE SCRIPT THE OPERATOR ACTUALLY RUNS -- the same predicate the count on the
// receipt uses, applied here through the exported predicate rather than through the planner, so the two
// sides of the comparison are genuinely separate readings of one artifact.
fn withheld_lines_in(shell: String) -> Int {
  count(filter(split(s: shell, delimiter: "\n"), l => converge_line_is_withheld(line: l)))
}

fn owed_of(terminal: FleetConvergeApplyTerminal) -> FleetConvergeOwedWork? {
  match terminal {
    PartiallyApplied { refused_axis_count: _, owed: o, detail: _ } => o
    FullyApplied => Absent
    AwaitingCapability { capability: _ } => Absent
    OwedReportContradiction { detail: _ } => Absent
  }
}

// (1) THE HEADLINE CONTROL. A plan that lists removals and withholds every one of them is not
// FullyApplied, and its wire is not `fully_applied`. On main this claim is RED: the same fixture minted
// FullyApplied whenever no axis refused, because the arm read only refusal counts.
test fn a_plan_that_withholds_every_teardown_it_lists_is_not_fully_applied() -> Bool {
  match artifact_with_withheld_teardowns() {
    Absent => false
    Present { value: artifact } => {
      let listed = plan_rows_starting_with(plan_body: artifact.plan_body, prefix: "REMOVE runner-slot ")
      listed > 0
        && (match artifact.apply_terminal {
          FullyApplied => false
          AwaitingCapability { capability: _ } => false
          OwedReportContradiction { detail: _ } => false
          PartiallyApplied { refused_axis_count: _, owed: o, detail: _ } => match o {
            Absent => false
            Present { value: owed } =>
              owed.withheld_row_count == listed
                && owed.withheld_row_count > 0
                && fleet_converge_apply_terminal_wire(terminal: artifact.apply_terminal) != "fully_applied"
                // AND THE SAME RENDER'S REPORT WITH THE REFUSALS TAKEN AWAY. The 44428803079 receipt failed
                // because owed work counted on no axis at all, so the claim cannot lean on this fixture's
                // refusals to keep the terminal honest: it must hold with zero refusals too, which is the
                // one shape the mint's owed-work guard decides. Reverting that guard turns THIS red.
                && (match fleet_converge_full_host_terminal(
                  refused_axis_count: 0,
                  owed: owed,
                  detail: "slot=0 cap=0 timer=0 fabric-cell=0 activation=0",
                ) {
                  FullyApplied => false
                  _ => true
                })
          }
        })
    }
  }
}

// (2) THE RECEIPT RECONCILES WITH PLAN.TXT ROW FOR ROW. The withheld count is the plan's own REMOVE rows
// -- not a count of script lines wearing a row's clothes. An operator who counts the lines in plan.txt
// must arrive at the number on the receipt.
test fn the_withheld_row_count_is_the_plans_own_remove_rows() -> Bool {
  match artifact_with_withheld_teardowns() {
    Absent => false
    Present { value: artifact } => match owed_of(terminal: artifact.apply_terminal) {
      Absent => false
      Present { value: owed } =>
        owed.withheld_row_count
          == plan_rows_starting_with(plan_body: artifact.plan_body, prefix: "REMOVE runner-slot ")
    }
  }
}

// (3) AND THE SCRIPT'S OWN LINES ARE A SEPARATE, NAMED NUMBER. This is the 39. The apply script echoes
// withheld lines for obligations the plan never lists -- the required-retiree and ungranted-actuation
// gates -- so a receipt that reported only the plan's rows would still under-report what the run
// withheld. Both numbers are on the wire, and the gap between them is on the wire too: nothing here
// folds one into the other.
test fn the_withheld_lines_the_script_echoes_are_counted_from_the_script() -> Bool {
  match artifact_with_withheld_teardowns() {
    Absent => false
    Present { value: artifact } => {
      let lines = withheld_lines_in(shell: artifact.apply_shell)
      match owed_of(terminal: artifact.apply_terminal) {
        Absent => false
        Present { value: owed } =>
          owed.withheld_line_total_count == lines
            && owed.withheld_beyond_plan_rows_count == lines - owed.withheld_row_count
            && owed.withheld_beyond_plan_rows_count >= 0
      }
    }
  }
}

// (4) A CAP ROW IS PLAN-ONLY AND SAYS SO, AND IT NAMES THE AUTHORITY THAT WOULD ACT. Converge has never
// emitted a cap line into apply.sh; the rows existed only as mutations the plan could not perform. The
// row stays -- deleting it would make the plan and the receipt disagree about the same fact, and the 25
// GiB envelope srv1 still owes is real outstanding work -- but it is no longer a promise.
test fn a_cap_row_is_rendered_as_plan_only_and_never_as_a_mutation() -> Bool {
  match artifact_with(observed_caps: [srv1_width_dropin_observed()], observed_slots: []) {
    Absent => false
    Present { value: artifact } => {
      let rows = plan_rows_starting_with(plan_body: artifact.plan_body, prefix: "PLAN-ONLY cap ")
      rows > 0
        && string_contains(s: artifact.plan_body, pattern: "plan-only: live_deploy authority")
        && !string_contains(s: artifact.plan_body, pattern: "content drift")
        && !string_contains(s: artifact.plan_body, pattern: "CHANGE cap ")
        && !string_contains(s: artifact.plan_body, pattern: "ADD cap ")
        && !string_contains(s: artifact.plan_body, pattern: "REMOVE cap ")
        && match owed_of(terminal: artifact.apply_terminal) {
          Absent => false
          Present { value: owed } => owed.plan_only_row_count == rows
        }
    }
  }
}

// (5) THE DRIFT LINE SPEAKS. The old line was `CHANGE cap <path> -> content drift`, which named no
// directive and no value on either side -- so a genuine 22 GiB-vs-25 GiB gap was indistinguishable from a
// false positive, and the operator reading it had no way to ask which. The wanted value is read from the
// model's own settings list and the observed side is the bytes the whole-file compare actually saw.
test fn the_cap_row_names_the_directive_and_both_values_rather_than_drift() -> Bool {
  match artifact_with(observed_caps: [srv1_width_dropin_observed()], observed_slots: []) {
    Absent => false
    Present { value: artifact } =>
      string_contains(s: artifact.plan_body, pattern: "23622320128")
        && string_contains(s: artifact.plan_body, pattern: "26843545600")
        && string_contains(s: artifact.plan_body, pattern: "MemoryMax=")
  }
}

// (6) RED CONTROL, THE OLD SHAPE. The pre-count wire -- the byte string 44428803079 actually carried --
// still decodes, still says nothing about owed work, and re-mints to itself. THIS CLAIM PASSES ON MAIN
// AND MUST: its point is that the old wire had nowhere to put a withheld count, so the under-report was
// not a misreading of the receipt but the only thing that receipt could ever have said.
test fn the_44428803079_wire_decodes_with_nothing_to_say_about_owed_work() -> Bool {
  let wire = "partially_applied|7|slot=5 cap=0 timer=0 fabric-cell=0 activation=2"
  match fleet_converge_apply_terminal_of_wire(text: wire) {
    Absent => false
    Present { value: terminal } => match terminal {
      PartiallyApplied { refused_axis_count: n, owed: o, detail: d } =>
        n == 7
          && (match o {
            Absent => true
            Present { value: _ } => false
          })
          && string_contains(s: d, pattern: "slot=5")
          && string_contains(s: d, pattern: "activation=2")
          && fleet_converge_apply_terminal_wire(terminal: terminal) == wire
      FullyApplied => false
      AwaitingCapability { capability: _ } => false
      OwedReportContradiction { detail: _ } => false
    }
  }
}

// (7) THE OTHER HALF OF THAT CONTROL: a wire that DOES carry the counts is not confused with the old
// shape, and it survives the trip. `withheld=` is the first thing after the refusal count, so a detail
// that opens with an axis name cannot be read as a count.
test fn a_count_carrying_wire_round_trips_and_is_not_the_legacy_shape() -> Bool {
  let owed = FleetConvergeOwedWork {
    withheld_row_count: 4,
    plan_only_row_count: 2,
    withheld_line_total_count: 43,
    withheld_beyond_plan_rows_count: 39,
  }
  let terminal = PartiallyApplied {
    refused_axis_count: 7,
    owed: Present { value: owed },
    detail: "slot=5 cap=0 timer=0 fabric-cell=0 activation=2",
  }
  let wire = fleet_converge_apply_terminal_wire(terminal: terminal)
  match fleet_converge_apply_terminal_of_wire(text: wire) {
    Absent => false
    Present { value: back } => match back {
      PartiallyApplied { refused_axis_count: n, owed: o, detail: d } =>
        n == 7
          && string_contains(s: d, pattern: "activation=2")
          && (match o {
            Absent => false
            Present { value: got } =>
              got.withheld_row_count == 4
                && got.plan_only_row_count == 2
                && got.withheld_line_total_count == 43
                && got.withheld_beyond_plan_rows_count == 39
          })
          && fleet_converge_apply_terminal_wire(terminal: back) == wire
      FullyApplied => false
      AwaitingCapability { capability: _ } => false
      OwedReportContradiction { detail: _ } => false
    }
  }
}

// (8) NOTHING IS CLEARED BY A ZERO IN ONE COLUMN. Each owed count gates on its own: a receipt with only
// plan-only rows, only withheld rows, or only beyond-plan lines is still not clear. The srv1 run had all
// three non-zero at once, which is why no single-number check would have caught it.
test fn every_owed_count_gates_fully_applied_on_its_own() -> Bool {
  let zero = FleetConvergeOwedWork {
    withheld_row_count: 0,
    plan_only_row_count: 0,
    withheld_line_total_count: 0,
    withheld_beyond_plan_rows_count: 0,
  }
  let withheld = FleetConvergeOwedWork {
    withheld_row_count: 1,
    plan_only_row_count: 0,
    withheld_line_total_count: 1,
    withheld_beyond_plan_rows_count: 0,
  }
  let plan_only = FleetConvergeOwedWork {
    withheld_row_count: 0,
    plan_only_row_count: 2,
    withheld_line_total_count: 0,
    withheld_beyond_plan_rows_count: 0,
  }
  let beyond = FleetConvergeOwedWork {
    withheld_row_count: 0,
    plan_only_row_count: 0,
    withheld_line_total_count: 39,
    withheld_beyond_plan_rows_count: 39,
  }
  fleet_converge_owed_work_is_clear(owed: zero)
    && !fleet_converge_owed_work_is_clear(owed: withheld)
    && !fleet_converge_owed_work_is_clear(owed: plan_only)
    && !fleet_converge_owed_work_is_clear(owed: beyond)
}

// (9) A PLAN THAT OWES WORK AND REFUSES NOTHING IS STILL NOT FULLY APPLIED -- the shape the guard is for.
// Zero refusals was exactly what made the srv1 case survivable for so long: every axis reported itself
// clean, because none of them had been asked to do anything.
test fn zero_refusals_with_owed_work_is_not_fully_applied() -> Bool {
  let owed = FleetConvergeOwedWork {
    withheld_row_count: 4,
    plan_only_row_count: 2,
    withheld_line_total_count: 43,
    withheld_beyond_plan_rows_count: 39,
  }
  // MINTED, NOT CONSTRUCTED. Asking the type for a `PartiallyApplied` would prove only that the type has
  // that constructor; the state this claim is about is produced by `fleet_converge_full_host_terminal`, and
  // the red control (that branch's one-line guard revert) has to be able to turn THIS claim red.
  let terminal = fleet_converge_full_host_terminal(
    refused_axis_count: 0,
    owed: owed,
    detail: "slot=0 cap=0 timer=0 fabric-cell=0 activation=0",
  )
  let wire = fleet_converge_apply_terminal_wire(terminal: terminal)
  (match terminal {
    FullyApplied => false
    AwaitingCapability { capability: _ } => false
    OwedReportContradiction { detail: _ } => false
    PartiallyApplied { refused_axis_count: refused, owed: o, detail: _ } =>
      refused == 0
        && (match o {
            Absent => false
            Present { value: report } =>
              report.withheld_row_count == 4 && report.withheld_beyond_plan_rows_count == 39
          })
  })
    && wire != "fully_applied"
    && string_contains(s: wire, pattern: "withheld=4")
    && string_contains(s: wire, pattern: "plan-only=2")
    && string_contains(s: wire, pattern: "withheld-lines=43")
    && string_contains(s: wire, pattern: "withheld-beyond-plan-rows=39")
    && !fleet_converge_owed_work_is_clear(owed: owed)
}

// (10) THE PLAN-ONLY COUNT COMES FROM THE AXIS THAT RENDERS THE ROWS, not from a count of the rendered
// text, so the receipt and plan.txt agree by construction rather than by two parsers agreeing. This
// compares the planner's own count against the rows a reader would count in the plan body.
test fn the_plan_only_count_and_the_plan_lines_agree_by_construction() -> Bool {
  let observed = [srv1_width_dropin_observed()]
  match artifact_with(observed_caps: observed, observed_slots: []) {
    Absent => false
    Present { value: artifact } => {
      let owed_members = fleet_converge_cap_plan_only_members(
        host: owed_witness_host,
        observed_caps: observed,
      )
      count(owed_members) > 0
        && count(owed_members)
          == plan_rows_starting_with(plan_body: artifact.plan_body, prefix: "PLAN-ONLY cap ")
        // Not just the same SIZE: every drop-in the axis owes a write for is named on a line of its own,
        // so the number on the receipt is a count of lines an operator can point at.
        && all(owed_members, m =>
        string_contains(s: artifact.plan_body, pattern: concat("PLAN-ONLY cap ", m.dropin_path as String)),
      )
    }
  }
}

// (11) THE COUNT NAMES THE SAME UNITS THE SCRIPT ECHOES. A number that merely adds up is not evidence:
// this puts the plan's own withheld rows next to the lines the rendered script echoes and asks that they
// be ABOUT THE SAME UNITS. It is also the reason `SlotTeardownRow` carries a unit at all -- without it the
// most a control could check is that two lists are the same size.
test fn every_withheld_plan_row_names_a_unit_the_script_echoes_as_withheld() -> Bool {
  match artifact_with_withheld_teardowns() {
    Absent => false
    Present { value: artifact } => match owed_witness_evidence() {
      Absent => false
      Present { value: evidence } => {
      let family = fleet_converge_slot_family(
        host: owed_witness_host,
        observed_slots: owed_witness_slots(),
        retirement_evidence: evidence,
      )
      let units = slot_family_withheld_units(family: family)
      count(units) > 0
        && all(units, u => string_contains(s: artifact.apply_shell, pattern: u))
      }
    }
  }
}

// (12) THE RECONCILIATION IS A GATE, NOT A TAUTOLOGY. The three script-side numbers are read from the
// artifacts, so `lines == rows + beyond` is a claim about the renderer rather than an identity between two
// of the numbers themselves. This puts a wire in front of the decoder whose four integers do not add up --
// the shape a tampered receipt, or a renderer that had lost a withheld line, would produce -- and requires
// the whole wire be refused. A decoder that accepted it would keep a terminal whose owed work is nonsense,
// and the receipt would still read `applied`.
test fn owed_numbers_that_do_not_add_up_are_refused_on_the_wire() -> Bool {
  let does_not_add_up =
    "partially_applied|7|withheld=4|plan-only=2|withheld-lines=43|withheld-beyond-plan-rows=40|slot=5 cap=0 timer=0 fabric-cell=0 activation=2"
  let negative_gap =
    "partially_applied|7|withheld=5|plan-only=0|withheld-lines=4|withheld-beyond-plan-rows=-1|slot=5 cap=0 timer=0 fabric-cell=0 activation=2"
  match fleet_converge_apply_terminal_of_wire(text: does_not_add_up) {
    Absent => match fleet_converge_apply_terminal_of_wire(text: negative_gap) {
      Absent => true
      Present { value: _ } => false
    }
    Present { value: _ } => false
  }
}

// (13) AND A WIRE THAT CLAIMS TO CARRY COUNTS AND DOES NOT IS NOT READ BACK AS A LEGACY ONE. Three of the
// four keys is neither shape; falling through to the pre-count reading would hand an operator a terminal
// whose detail begins `withheld=4|plan-only=…` and whose owed work is Absent -- the under-report again,
// wearing the old format.
test fn a_half_written_count_wire_is_refused_rather_than_read_as_legacy() -> Bool {
  let missing_one_key =
    "partially_applied|7|withheld=4|plan-only=2|withheld-lines=43|slot=5 cap=0 timer=0 fabric-cell=0 activation=2"
  match fleet_converge_apply_terminal_of_wire(text: missing_one_key) {
    Absent => true
    Present { value: _ } => false
  }
}

// (14) THE REAL PLAN RECONCILES. Not a fixture of four numbers anyone typed: the plan and the script this
// branch renders for srv1 with four withheld removals must satisfy the equality the gate checks, and the
// beyond-plan count must be a non-zero observation of lines the plan never listed. Zero here would mean the
// obligation gates had gone quiet, and the number would be vacuously passing.
test fn the_rendered_plan_and_script_reconcile_and_name_a_real_gap() -> Bool {
  match artifact_with_withheld_teardowns() {
    Absent => false
    Present { value: artifact } => match owed_of(terminal: artifact.apply_terminal) {
      Absent => false
      Present { value: owed } =>
        owed.withheld_line_total_count == owed.withheld_row_count + owed.withheld_beyond_plan_rows_count
          && owed.withheld_row_count > 0
          && owed.withheld_beyond_plan_rows_count > 0
          && owed.withheld_line_total_count > owed.withheld_row_count
    }
  }
}

// (15) A DISAGREEING OWED REPORT IS NEVER MINTED AS A RECEIPT NO READER CAN DECODE -- AND THE REFUSAL IS
// NOT WORN UNDER SOMEONE ELSE'S MEANING. Claim (12) shows the decoder refusing such a wire; this is the
// other half, the one the module's own comment promised: the MINT must not produce one. The numbers are put
// in front of the minted decision directly, which is the only way the reconciliation is ever executed rather
// than described. Three things have to hold: the terminal is not `FullyApplied`; it is not a
// `PartiallyApplied` carrying those numbers (that would be a receipt the decoder refuses, so the operator's
// tooling would find its own receipt unreadable); and it is NOT `AwaitingCapability` -- everywhere else that
// variant means one thing, a host grant is missing and a retry after the grant is the right response
// (`host_grant_awaiting_capability` is the only other producer). A renderer whose arithmetic contradicts is
// not a grant to wait for, and one name carrying two meanings is a meaning fork
// (`gunbc.design_argument::single_authority`); a consumer that treated this as a grant would re-dispatch
// forever. So it must be its own state, naming the numbers, and its wire must still decode to itself.
test fn a_disagreeing_owed_report_is_refused_at_the_mint_rather_than_written() -> Bool {
  let disagreeing = FleetConvergeOwedWork {
    withheld_row_count: 4,
    plan_only_row_count: 2,
    withheld_line_total_count: 43,
    withheld_beyond_plan_rows_count: 40,
  }
  let terminal = fleet_converge_full_host_terminal(
    refused_axis_count: 7,
    owed: disagreeing,
    detail: "slot=5 cap=0 timer=0 fabric-cell=0 activation=2",
  )
  match terminal {
    FullyApplied => false
    PartiallyApplied { refused_axis_count: _, owed: _, detail: _ } => false
    AwaitingCapability { capability: _ } => false
    OwedReportContradiction { detail: d } =>
      string_contains(s: d, pattern: "withheld=4")
        && string_contains(s: d, pattern: "beyond-plan-rows=40")
        && string_contains(s: d, pattern: "does not reconcile")
        && match fleet_converge_apply_terminal_of_wire(text: fleet_converge_apply_terminal_wire(terminal: terminal)) {
            Absent => false
            Present { value: read } => match read {
              OwedReportContradiction { detail: back } => back == d
              _ => false
            }
          }
  }
}

// (15b) THE WIRE THE CONTRADICTION WRITES IS NOT THE WIRE A GRANT WRITES. If the two collapsed on the wire,
// a receipt reader that only compares strings would put a renderer defect in the retry-when-granted queue.
test fn the_contradiction_wire_is_not_the_awaiting_capability_wire() -> Bool {
  let disagreement_wire = fleet_converge_apply_terminal_wire(
    terminal: fleet_converge_full_host_terminal(
      refused_axis_count: 7,
      owed: FleetConvergeOwedWork {
        withheld_row_count: 4,
        plan_only_row_count: 2,
        withheld_line_total_count: 43,
        withheld_beyond_plan_rows_count: 40,
      },
      detail: "slot=5 cap=0 timer=0 fabric-cell=0 activation=2",
    ),
  )
  let grant_wire = fleet_converge_apply_terminal_wire(
    terminal: AwaitingCapability { capability: "host grant is missing: runner-ctl-reload" },
  )
  starts_with(s: disagreement_wire, prefix: "owed_report_contradiction|")
    && !starts_with(s: disagreement_wire, prefix: "awaiting_capability|")
    && starts_with(s: grant_wire, prefix: "awaiting_capability|")
    && !starts_with(s: disagreement_wire, prefix: "partially_applied|")
}

// (16) AND THE SAME MINT STILL GETS IT RIGHT WHEN THE NUMBERS DO RECONCILE. Without this, (15) would pass
// on a mint that refused everything.
test fn a_reconciling_owed_report_is_minted_as_a_receipt_and_round_trips() -> Bool {
  let reconciling = FleetConvergeOwedWork {
    withheld_row_count: 4,
    plan_only_row_count: 2,
    withheld_line_total_count: 43,
    withheld_beyond_plan_rows_count: 39,
  }
  let terminal = fleet_converge_full_host_terminal(
    refused_axis_count: 7,
    owed: reconciling,
    detail: "slot=5 cap=0 timer=0 fabric-cell=0 activation=2",
  )
  match terminal {
    FullyApplied => false
    AwaitingCapability { capability: _ } => false
    OwedReportContradiction { detail: _ } => false
    PartiallyApplied { refused_axis_count: refused, owed: owed, detail: detail } =>
      refused == 7
        && detail == "slot=5 cap=0 timer=0 fabric-cell=0 activation=2"
        && match owed {
            Absent => false
            Present { value: o } =>
              o.withheld_row_count == 4
                && o.plan_only_row_count == 2
                && o.withheld_line_total_count == 43
                && o.withheld_beyond_plan_rows_count == 39
          }
        && match fleet_converge_apply_terminal_of_wire(text: fleet_converge_apply_terminal_wire(terminal: terminal)) {
            Absent => false
            Present { value: read } => match read {
              PartiallyApplied { refused_axis_count: _, owed: back, detail: _ } => match back {
                Absent => false
                Present { value: o } => o.withheld_beyond_plan_rows_count == 39
              }
              _ => false
            }
          }
  }
}
