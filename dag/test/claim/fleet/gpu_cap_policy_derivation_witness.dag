data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// ── THE REAL PATH ────────────────────────────────────────────────────────────────────────────────────

fn target_of(ts: List<DeviceRuleTarget>, board: PhysicalAssetIdentity) -> DeviceRuleTarget? {
  filter(ts, t => match t {
    RuleTargetDerived { host: _, board: b, gpu_uuid: _, control: _, rated: _, minimum: _, maximum: _, unclamped: _, target: _, clamp: _, current: _ } => physical_asset_identity_eq(a: b, b: board)
    RuleTargetUnread { host: _, board: b, cause: _ } => physical_asset_identity_eq(a: b, b: board)
  }).first()
}

fn lands_at(t: DeviceRuleTarget?, rated: Nat, unclamped: Nat, target: Nat, raised: Bool) -> Bool {
  match t {
    Absent => false
    Present { value: x } => match x {
      RuleTargetUnread { host: _, board: _, cause: _ } => false
      RuleTargetDerived { host: _, board: _, gpu_uuid: _, control: _, rated: r, minimum: _, maximum: _, unclamped: u, target: w, clamp: c, current: _ } =>
        watt_count(w: r) == rated && watt_count(w: u) == unclamped && watt_count(w: w) == target
          && match c { RaisedToDeviceMinimum => raised  WithinDeviceRange => !raised  _ => false }
    }
  }
}

// THE RULE, ON THE CARDS THE FLEET HOLDS, READ FROM THEIR OWN DEVICE ROWS. These are the operator's worked
// examples: 60 percent of the card's read default, clamped into its range -- the Workstation card stays at
// 360 W, the Max-Q's 180 W rises to its 250 W floor, the Ada's 42 W is inside its range, the R9700's 180 W
// rises to 210 W and the T10's 90 W to 100 W. srv4's Ada carries its default only because this change put the
// read 70 W on its row: before, the rule had no rated basis there and named that read instead.
test fn the_rule_lands_each_held_card_where_the_operator_worked_it() -> Bool {
  let inputs = fleet_cap_derivation_inputs()
  lands_at(t: target_of(ts: rule_targets_on(inputs: inputs, host: operator_host_srv1), board: gpu_board_01), rated: 600, unclamped: 360, target: 360, raised: false)
    && lands_at(t: target_of(ts: rule_targets_on(inputs: inputs, host: operator_host_srv1), board: gpu_board_04), rated: 300, unclamped: 180, target: 250, raised: true)
    && lands_at(t: target_of(ts: rule_targets_on(inputs: inputs, host: operator_host_srv4), board: gpu_board_05), rated: 70, unclamped: 42, target: 42, raised: false)
    && lands_at(t: target_of(ts: rule_targets_on(inputs: inputs, host: operator_host_6ce85c), board: gpu_board_02), rated: 300, unclamped: 180, target: 210, raised: true)
    && lands_at(t: target_of(ts: rule_targets_on(inputs: inputs, host: operator_host_e2d4b7), board: gpu_board_11), rated: 150, unclamped: 90, target: 100, raised: true)
    // john's three cards, read 2026-11-28: 60 percent of each read default lands INSIDE each card's range, so no
    // clamp applies -- 300 -> 180 W (floor 150), 250 -> 150 W (floor 125), 250 -> 150 W (floor 100).
    && lands_at(t: target_of(ts: rule_targets_on(inputs: inputs, host: operator_host_ba61f9), board: gpu_board_14), rated: 300, unclamped: 180, target: 180, raised: false)
    && lands_at(t: target_of(ts: rule_targets_on(inputs: inputs, host: operator_host_ba61f9), board: gpu_board_15), rated: 250, unclamped: 150, target: 150, raised: false)
    && lands_at(t: target_of(ts: rule_targets_on(inputs: inputs, host: operator_host_ba61f9), board: gpu_board_16), rated: 250, unclamped: 150, target: 150, raised: false)
}

fn needs_of(d: HostCapDerivation) -> List<HeadroomNeed> {
  match d {
    HostHeadroomUnestablished { host: _, targets: _, needs: ns } => ns
    _ => [] as List<HeadroomNeed>
  }
}

fn host_of_derivation(d: HostCapDerivation) -> HostIdentity? {
  match d {
    HostHeadroomUnestablished { host: h, targets: _, needs: _ } => Present { value: h }
    _ => Absent
  }
}

fn derivation_for(ds: List<HostCapDerivation>, host: HostIdentity) -> List<HeadroomNeed> {
  flat_map(ds, d => match host_of_derivation(d: d) {
    Present { value: h } => if host_identity_eq(a: h, b: host) { needs_of(d: d) } else { [] as List<HeadroomNeed> }
    Absent => [] as List<HeadroomNeed>
  })
}

// THE ROUTE THE REAL FLEET TAKES TODAY, ASSERTED AS A ROUTE: every GPU host is WITHHELD, and each is withheld
// for the reads its own rows name -- not for one generic reason. srv1 has a cited supply, so what it waits on
// is the supply's efficiency floor, its non-GPU ceiling and its breaker's rating; srv3 waits on its two cards'
// identities; host-6ce85c on the T10 nobody inventoried. A derivation that handed any of them a number would
// put 42 W on srv3/srv4's cards on a strip whose rating nobody has read, and this claim reds.
test fn every_gpu_host_is_withheld_today_for_the_reads_its_rows_name() -> Bool {
  let ds = derive_fleet_caps()
  let srv1 = derivation_for(ds: ds, host: operator_host_srv1)
  let srv3 = derivation_for(ds: ds, host: operator_host_srv3)
  let h11 = derivation_for(ds: ds, host: operator_host_6ce85c)
  ds.length() == 6
    && all(ds, d => match d { HostHeadroomUnestablished { host: _, targets: _, needs: ns } => ns.length() > 0  _ => false })
    && any(srv1, n => match n { PsuEfficiencyFloorUnreadNeed { host: _, read_obligation: _ } => true  _ => false })
    && any(srv1, n => match n { NonGpuCeilingUnreadNeed { host: _, read_obligation: _ } => true  _ => false })
    // srv1's breaker carries the operator's stated 1800 W since 2026-11-28, so its rating is no longer a need.
    && !any(srv1, n => match n { CircuitRatingUnreadNeed { circuit: _, read_obligation: _ } => true  _ => false })
    && !any(srv1, n => match n { PsuUnreadNeed { host: _, read_obligation: _ } => true  _ => false })
    && any(srv3, n => match n { UnidentifiedGpuNeed { host: _, reported: _, read_obligation: _ } => true  _ => false })
    && any(h11, n => match n { UnidentifiedGpuNeed { host: _, reported: r, read_obligation: _ } => string_contains(s: r as String, pattern: "T10")  _ => false })
}

fn conforms_on(inputs: CapDerivationInputs, t: DeviceRuleTarget?) -> Bool {
  match t {
    Present { value: x } => match decision_conformance(inputs: inputs, t: x) { ConformsToRule { cap: _, decided_on: _ } => true  _ => false }
    Absent => false
  }
}

fn departs_on(inputs: CapDerivationInputs, t: DeviceRuleTarget?, cap: Nat, rule: Nat) -> Bool {
  match t {
    Present { value: x } => match decision_conformance(inputs: inputs, t: x) {
      DepartsFromRule { cap: c, rule_target: r, decided_on: _, said: s } => watt_count(w: c) == cap && watt_count(w: r) == rule && (s as String) != ""
      _ => false
    }
    Absent => false
  }
}

// THE OPERATOR'S STANDING DECISIONS, CLASSIFIED -- NOT REWRITTEN. h11's 210 W and ken's 100 W are what the rule
// derives (each card's own floor), so they conform; srv1's 300 W departs on both cards, in opposite directions
// (above the Max-Q's 250 W, below the Workstation's 360 W), and srv4's 30 W departs below 42 W. A departure keeps
// the operator's words.
test fn the_standing_decisions_conform_or_depart_with_the_operators_words() -> Bool {
  let inputs = fleet_cap_derivation_inputs()
  conforms_on(inputs: inputs, t: target_of(ts: rule_targets_on(inputs: inputs, host: operator_host_6ce85c), board: gpu_board_02))
    && conforms_on(inputs: inputs, t: target_of(ts: rule_targets_on(inputs: inputs, host: operator_host_e2d4b7), board: gpu_board_11))
    && departs_on(inputs: inputs, t: target_of(ts: rule_targets_on(inputs: inputs, host: operator_host_srv1), board: gpu_board_04), cap: 300, rule: 250)
    && departs_on(inputs: inputs, t: target_of(ts: rule_targets_on(inputs: inputs, host: operator_host_srv1), board: gpu_board_01), cap: 300, rule: 360)
    && departs_on(inputs: inputs, t: target_of(ts: rule_targets_on(inputs: inputs, host: operator_host_srv4), board: gpu_board_05), cap: 30, rule: 42)
    // john's held floors (gunbc.design_ruling::operator_holds_live_gpu_caps_accepting_circuit_overcommit_2026_11_28)
    // depart below every rule target: the hold is a decision, and the classification still says so.
    && departs_on(inputs: inputs, t: target_of(ts: rule_targets_on(inputs: inputs, host: operator_host_ba61f9), board: gpu_board_14), cap: 150, rule: 180)
    && departs_on(inputs: inputs, t: target_of(ts: rule_targets_on(inputs: inputs, host: operator_host_ba61f9), board: gpu_board_15), cap: 125, rule: 150)
    && departs_on(inputs: inputs, t: target_of(ts: rule_targets_on(inputs: inputs, host: operator_host_ba61f9), board: gpu_board_16), cap: 100, rule: 150)
}

// THE RELATION COVERS EXACTLY THE HOSTS THE DERIVATION READS: an identity join, both directions, over every GPU
// host and every other member of a circuit carrying one. A host that gains a card with no constraint row is
// withheld (HostConstraintRowMissing), and a row for a host that is neither -- no GPU and on no GPU host's
// circuit -- is dead data. srv2 is in the population only as the 15 A breaker's GPU-less member, and butch, taken
// off that breaker on 2026-11-28 and carrying no card, is in neither the population nor the rows.
test fn every_read_host_has_exactly_one_constraint_row_and_no_row_is_idle() -> Bool {
  let hosts = related_hosts_of(inputs: fleet_cap_derivation_inputs())
  all(hosts, h => filter(host_power_constraint_rows, r => host_identity_eq(a: r.host, b: h)).length() == 1)
    && all(host_power_constraint_rows, r => any(hosts, h => host_identity_eq(a: h, b: r.host)))
    && any(hosts, h => host_identity_eq(a: h, b: operator_host_srv2))
    && !any(gpu_hosts_of(inputs: fleet_cap_derivation_inputs()), h => host_identity_eq(a: h, b: operator_host_srv2))
    && !any(hosts, h => host_identity_eq(a: h, b: operator_host_srv14))
}

// ── john AND THE 15 A BREAKER, ON THE REAL PATH ───────────────────────────────────────────────────────

fn is_member_unestablished(n: HeadroomNeed, member: HostIdentity) -> Bool {
  match n { CircuitMemberUnestablished { circuit: _, member: m } => host_identity_eq(a: m, b: member)  _ => false }
}

// THE BREAKER IS THE OPERATOR'S OF 2026-11-28: srv1, srv2, john and ken -- butch, hedged onto it in the second
// statement, taken off in the third -- with the operator's stated 1800 W carrying that ruling's reference. The
// member set is asserted as an identity join (each named member present, nothing else), so adding or dropping a
// host reds it.
test fn the_breaker_carries_srv1_srv2_john_and_ken_at_the_operators_1800_w() -> Bool {
  let c = breaker_srv1_ken_circuit
  c.members.length() == 4
    && circuit_carries(c: c, host: operator_host_srv1)
    && circuit_carries(c: c, host: operator_host_srv2)
    && circuit_carries(c: c, host: operator_host_ba61f9)
    && circuit_carries(c: c, host: operator_host_e2d4b7)
    && !circuit_carries(c: c, host: operator_host_srv14)
    && match c.rating {
      RatingOperatorStated { carry_limit: w, stated_by: r } =>
        watt_count(w: w) == 1800 && declaration_ref_eq(a: r, b: breaker_circuit_members_and_john_power_facts_2026_11_28.reference)
      _ => false
    }
}

// john IS WITHHELD FOR EXACTLY WHAT IS STILL UNREAD, AND FOR NOTHING THE OPERATOR ANSWERED. Its own facts leave one
// need -- the supply's efficiency floor (no model, no 80 PLUS level) -- and its circuit leaves the NEC continuous
// fraction (still transcribed) and the three other members, none of whose facts resolve: srv1 (efficiency floor,
// non-GPU ceiling), srv2 (supply, non-GPU ceiling) and ken (supply, non-GPU ceiling). Asserted as the exact set:
// no need for john's supply being unread, its non-GPU ceiling, an unidentified card, or the breaker's rating --
// the facts of 2026-11-28 closed each of those, and a regression that re-opened one reds this claim.
test fn john_is_withheld_for_exactly_its_floor_the_nec_fraction_and_three_members() -> Bool {
  let ns = derivation_for(ds: derive_fleet_caps(), host: operator_host_ba61f9)
  ns.length() == 5
    && any(ns, n => match n { PsuEfficiencyFloorUnreadNeed { host: h, read_obligation: _ } => host_identity_eq(a: h, b: operator_host_ba61f9)  _ => false })
    && any(ns, n => match n { ContinuousFractionUngrounded { read_obligation: _ } => true  _ => false })
    && any(ns, n => is_member_unestablished(n: n, member: operator_host_srv1))
    && any(ns, n => is_member_unestablished(n: n, member: operator_host_srv2))
    && any(ns, n => is_member_unestablished(n: n, member: operator_host_e2d4b7))
    && !any(ns, n => match n { PsuUnreadNeed { host: _, read_obligation: _ } => true  _ => false })
    && !any(ns, n => match n { NonGpuCeilingUnreadNeed { host: _, read_obligation: _ } => true  _ => false })
    && !any(ns, n => match n { UnidentifiedGpuNeed { host: _, reported: _, read_obligation: _ } => true  _ => false })
    && !any(ns, n => match n { CircuitRatingUnreadNeed { circuit: _, read_obligation: _ } => true  _ => false })
}

// ── SUPPLIED FLEETS: THE ARMS THE REAL FLEET CANNOT REACH YET ─────────────────────────────────────────

data fixture_authority: ExternalAuthority = ExternalAuthority { uri: Uri { scheme: Https, locator: "fixture.invalid/cited" } }
data host_a: HostIdentity = "fixture-host-a" as HostIdentity
data host_b: HostIdentity = "fixture-host-b" as HostIdentity
data board_a1: PhysicalAssetIdentity = "fixture-board-a1" as PhysicalAssetIdentity
data board_a2: PhysicalAssetIdentity = "fixture-board-a2" as PhysicalAssetIdentity
data board_b1: PhysicalAssetIdentity = "fixture-board-b1" as PhysicalAssetIdentity

fn device(host: HostIdentity, board: PhysicalAssetIdentity, lo: Nat, hi: Nat, rated: Nat, control: GpuPowerLimitControl) -> GpuDeviceObservation {
  GpuDeviceEnumerated {
    host: host, board: board, gpu_uuid: Present { value: join(["GPU-", board as String], "") as NonEmptyStr },
    pci_address: "0000:01:00.0" as PciAddress,
    power_limit_minimum: watt(count: lo), power_limit_maximum: watt(count: hi), power_limit_current: watt(count: rated),
    power_limit_default: Present { value: watt(count: rated) }, power_limit_control: control, read_on: "fixture" as NonEmptyStr,
  }
}

fn known_host(host: HostIdentity, psu_rated: Nat, non_gpu: Nat) -> HostPowerConstraints {
  HostPowerConstraints {
    host: host,
    psu: PsuCatalogued {
      component: join(["fixture-psu-", host as String], "") as PhysicalAssetIdentity,
      catalog: PowerSupplyCatalogRow { model: "FIXTURE" as NonEmptyStr, manufacturer: asrock, rated_output: watt(count: psu_rated), efficiency: Gold },
      catalog_source: decl_ref(module_path: "test.claim.fleet.gpu_cap_policy_derivation_witness", decl_name: "fixture_psu"),
      efficiency_floor: EfficiencyFloorStated { floor: percent(count: 90), standing: CitedToAuthority { authority: fixture_authority } },
    },
    non_gpu_draw: NonGpuCeilingStated { dc_watts: watt(count: non_gpu), standing: CitedToAuthority { authority: fixture_authority } },
    unidentified_gpus: [],
  }
}

fn circuit_of(carry: Nat) -> SharedPowerCircuit {
  SharedPowerCircuit {
    identity: decl_ref(module_path: "test.claim.fleet.gpu_cap_policy_derivation_witness", decl_name: "fixture_circuit"),
    label: "fixture circuit" as NonEmptyStr,
    members: [host_a, host_b],
    rating: RatingCited { carry_limit: watt(count: carry), standing: CitedToAuthority { authority: fixture_authority } },
    member_draw_bound: BoundUnstated { read_obligation: "fixture: no member bound" as NonEmptyStr },
    trips: [],
  }
}

data cited_fraction: ContinuousLoadFraction = ContinuousLoadFraction { fraction: percent(count: 80), standing: CitedToAuthority { authority: fixture_authority } }

// Host A carries a 600 W card (range 150-600, rule target 360) and a 300 W card (range 250-325, rule target
// raised to 250): targets 610 W, floors 400 W. Host B carries one 150 W card (range 100-150, target 100).
fn fleet(carry: Nat, b_control: GpuPowerLimitControl, fraction: ContinuousLoadFraction, a_rows: List<HostPowerConstraints>) -> CapDerivationInputs {
  CapDerivationInputs {
    policy: fleet_gpu_cap_default,
    continuous_fraction: fraction,
    constraint_rows: concat(a_rows, [known_host(host: host_b, psu_rated: 1000, non_gpu: 100)]),
    installed: [
      HostContainsComponent { host: host_a, component: board_a1 },
      HostContainsComponent { host: host_a, component: board_a2 },
      HostContainsComponent { host: host_b, component: board_b1 },
    ],
    devices: [
      device(host: host_a, board: board_a1, lo: 150, hi: 600, rated: 600, control: NvidiaSmiPowerLimit),
      device(host: host_a, board: board_a2, lo: 250, hi: 325, rated: 300, control: NvidiaSmiPowerLimit),
      device(host: host_b, board: board_b1, lo: 100, hi: 150, rated: 150, control: b_control),
    ],
    circuits: [circuit_of(carry: carry)],
    decisions: [],
  }
}

fn known_fleet(psu_a: Nat, carry: Nat) -> CapDerivationInputs {
  fleet(carry: carry, b_control: NvidiaSmiPowerLimit, fraction: cited_fraction, a_rows: [known_host(host: host_a, psu_rated: psu_a, non_gpu: 200)])
}

fn no_cap() -> Nat { 0 }

fn cap_on(caps: List<DerivedDeviceCap>, board: PhysicalAssetIdentity) -> Nat {
  fold(caps, init: no_cap(), f: (acc, c) => if physical_asset_identity_eq(a: c.board, b: board) { watt_count(w: c.cap) } else { acc })
}

// EVERYTHING KNOWN AND ROOMY: the default fits, std.decision selects it, and the receipt names this host's
// subject -- the route through select_realization, not a short cut around it.
test fn a_known_host_with_room_selects_the_default_through_std_decision() -> Bool {
  match derive_host_caps_with(inputs: known_fleet(psu_a: 1600, carry: 3000), host: host_a) {
    HostCapsSelected { host: _, targets: _, caps: cs, allocation: a, receipt: r } =>
      cap_on(caps: cs, board: board_a1) == 360 && cap_on(caps: cs, board: board_a2) == 250
        && match a { PolicyDefaultFits { tightest: _, slack: _ } => true  _ => false }
        && string_contains(s: r.scope.decision_subject.decl_name as String, pattern: "fixture-host-a")
    _ => false
  }
}

// THE SUPPLY BINDS AND NOTHING IS CHOSEN: 700 W less 200 W non-GPU leaves 500 W for 610 W of targets over 400 W of
// floors. The floors fit and the default does not, and no allocation policy is ruled (the operator deferred it on
// 2026-11-28), so the host is HostSelectionNeedsPolicy carrying the supply, its 500 W budget, the 610 W of targets
// and the 400 W of floors -- and NO caps. A derivation that minted reduced caps here reds this claim.
fn over_is(d: HostCapDerivation, budget: Nat, targets: Nat, minima: Nat) -> Bool {
  match d {
    HostSelectionNeedsPolicy { host: _, targets: _, over: o } => o.budget == budget && o.targets == targets && o.minima == minima
    _ => false
  }
}

test fn a_tight_supply_is_reported_over_budget_and_chooses_no_caps() -> Bool {
  let d = derive_host_caps_with(inputs: known_fleet(psu_a: 700, carry: 3000), host: host_a)
  over_is(d: d, budget: 500, targets: 610, minima: 400)
    && match d {
      HostSelectionNeedsPolicy { host: _, targets: _, over: o } => match o.binding {
        PsuSustainedOutput { psu: _, rated_output: r, non_gpu: g } => watt_count(w: r) == 700 && watt_count(w: g) == 200
        _ => false
      }
      _ => false
    }
}

// CIRCUIT DENSITY IS SUMMED OVER EVERY MEMBER: 1200 W x 80 % continuous x 90 % floor = 864 W DC, less 300 W of the
// members' non-GPU ceilings, leaves 564 W for 710 W of targets over 500 W of floors. Each host's own bounds may
// fit (host B's 100 W does), and still neither is selected: the circuit is over budget with no allocation policy,
// and both members report the circuit's own figures.
test fn circuit_density_is_summed_over_every_member_and_leaves_both_over_budget() -> Bool {
  let inputs = known_fleet(psu_a: 1600, carry: 1200)
  let a = derive_host_caps_with(inputs: inputs, host: host_a)
  over_is(d: a, budget: 564, targets: 710, minima: 500)
    && over_is(d: derive_host_caps_with(inputs: inputs, host: host_b), budget: 564, targets: 710, minima: 500)
    && match a {
      HostSelectionNeedsPolicy { host: _, targets: _, over: o } => match o.binding {
        CircuitContinuousAllowance { circuit: _, carry_limit: l, continuous_fraction: _, lowest_efficiency_floor: _, members_non_gpu: n } => watt_count(w: l) == 1200 && watt_count(w: n) == 300
        _ => false
      }
      _ => false
    }
}

// RED: EVEN EVERY CARD AT ITS FLOOR DOES NOT FIT. 550 W less 200 W leaves 350 W against 400 W of floors. The host
// REFUSES naming the supply; it is not handed its minima as "the best we can do".
test fn a_host_whose_floors_exceed_its_supply_refuses_naming_the_supply() -> Bool {
  match derive_host_caps_with(inputs: known_fleet(psu_a: 550, carry: 3000), host: host_a) {
    HostCapsRefused { host: _, targets: _, violated: v, causes: cz, scope: _ } =>
      v.length() == 1 && cz.length() > 0
        && all(v, b => match b { PsuSustainedOutput { psu: _, rated_output: r, non_gpu: _ } => watt_count(w: r) == 550  _ => false })
    _ => false
  }
}

// RED: A SUPPLY NOBODY READ YIELDS THE READ, NOT A NUMBER -- and it withholds the OTHER member of its circuit
// too, because a circuit with a member of unknown draw has no sum.
test fn an_unread_supply_withholds_its_host_and_its_circuit_partner() -> Bool {
  let unread_a = HostPowerConstraints {
    host: host_a,
    psu: PsuUnread { component: Absent, read_obligation: "fixture: read the supply" as NonEmptyStr },
    non_gpu_draw: NonGpuCeilingStated { dc_watts: watt(count: 200), standing: CitedToAuthority { authority: fixture_authority } },
    unidentified_gpus: [],
  }
  let inputs = fleet(carry: 3000, b_control: NvidiaSmiPowerLimit, fraction: cited_fraction, a_rows: [unread_a])
  let a_withheld = match derive_host_caps_with(inputs: inputs, host: host_a) {
    HostHeadroomUnestablished { host: _, targets: _, needs: ns } => any(ns, n => match n { PsuUnreadNeed { host: _, read_obligation: _ } => true  _ => false })
    _ => false
  }
  let b_withheld = match derive_host_caps_with(inputs: inputs, host: host_b) {
    HostHeadroomUnestablished { host: _, targets: _, needs: ns } => any(ns, n => match n { CircuitMemberUnestablished { circuit: _, member: m } => host_identity_eq(a: m, b: host_a)  _ => false })
    _ => false
  }
  a_withheld && b_withheld
}

// RED: THE NEC FRACTION AS THIS REPOSITORY CARRIES IT IS TRANSCRIBED, so a fleet whose every other fact is
// known is still withheld on it, naming the read.
test fn a_transcribed_continuous_fraction_withholds_rather_than_derates() -> Bool {
  let inputs = fleet(carry: 3000, b_control: NvidiaSmiPowerLimit, fraction: nec_continuous_load_fraction, a_rows: [known_host(host: host_a, psu_rated: 1600, non_gpu: 200)])
  match derive_host_caps_with(inputs: inputs, host: host_a) {
    HostHeadroomUnestablished { host: _, targets: _, needs: ns } => ns.length() == 1 && any(ns, n => match n { ContinuousFractionUngrounded { read_obligation: _ } => true  _ => false })
    _ => false
  }
}

// AN amdgpu CARD HAS NO DOCUMENTED COUPLING OF ITS CAP TO SUSTAINED DRAW, so a host carrying one defers through
// std.decision's own closure (CausalModelUnestablished) even when every bound is known.
test fn an_amdgpu_host_defers_on_its_undocumented_cap_coupling() -> Bool {
  let inputs = fleet(carry: 3000, b_control: AmdgpuHwmonPowerCap { attribute: Power1Cap }, fraction: cited_fraction, a_rows: [known_host(host: host_a, psu_rated: 1600, non_gpu: 200)])
  match derive_host_caps_with(inputs: inputs, host: host_b) {
    HostSelectionNeedsEvidence { host: _, targets: _, needs: ns } => ns.length() > 0
    _ => false
  }
}

// THE REPORT IS THE DERIVATION'S OWN OUTPUT: an over-budget host renders its figures and chooses nothing, a refused
// one renders REFUSED with the violated bound.
test fn the_report_renders_selected_and_refused_rows_from_the_derivation() -> Bool {
  let over = fleet_gpu_cap_report_md_with(inputs: known_fleet(psu_a: 700, carry: 3000))
  let refused = fleet_gpu_cap_report_md_with(inputs: known_fleet(psu_a: 550, carry: 3000))
  string_contains(s: over, pattern: "| fixture-host-a | fixture-board-a1 GPU-fixture-board-a1 | 600 W | 150-600 W | 360 W -> 360 W | OVER BUDGET (none chosen) | over budget, no allocation policy ruled: supply fixture-psu-fixture-host-a: 700 W DC less 200 W non-GPU leaves 500 W DC for 610 W of rule targets (floors 400 W); overcommit 110 W")
    && string_contains(s: refused, pattern: "| REFUSED | violates supply fixture-psu-fixture-host-a: 550 W DC less 200 W non-GPU")
}

// ── THE 15 A BREAKER WITH EVERY FACT SUPPLIED ─────────────────────────────────────────────────────────
//
// SUPPLIED AT THE DERIVATION'S INTERFACE (gunbc.design_argument::single_authority, a witness discriminates at one
// interface): the real cards, containment, decisions-free, and the REAL breaker row -- its four members and the
// operator's 1800 W -- with the facts nobody has given yet supplied as values: an 88 percent efficiency floor on
// every member's supply, srv1's non-GPU ceiling at 200 W, srv2's and ken's at 150 W, and the continuous fraction
// grounded at 80 percent. john keeps its real operator-stated supply (1000 W) and its declared 200 W budget, with
// only its floor supplied. srv2's and ken's supply ratings are supplied as 1000 W: they bound only those hosts'
// own sums and do not enter the circuit's arithmetic. The real path stays exercised by
// john_is_withheld_for_exactly_its_floor_the_nec_fraction_and_three_members above.
//
// THE ARITHMETIC, BY HAND: 1800 W x 80 % = 1440 W AC held continuously; x 88 % = 1267 W DC (floored); less the
// members' non-GPU 200 + 150 + 200 + 150 = 700 W leaves 567 W DC for every GPU on the circuit. The cards' FLOORS
// alone are srv1 150 + 250, john 150 + 125 + 100, ken 3 x 100 = 1075 W (their rule targets 1390 W). The floors do
// not fit, so every GPU member REFUSES and names the circuit's continuous allowance: john's share with srv1 and ken
// at their floors is 567 - 700 < 0, below its own 375 W of floors. Its own supply (1000 - 200 = 800 W) is not
// violated, so the circuit is the one violated constraint. This is the overcommit the operator accepted on
// 2026-11-28 (gunbc.design_ruling::operator_holds_live_gpu_caps_accepting_circuit_overcommit_2026_11_28); the
// derivation reports it rather than softening it.

fn supplied_row(host: HostIdentity, psu_rated: Nat, non_gpu: Nat) -> HostPowerConstraints {
  HostPowerConstraints {
    host: host,
    psu: PsuCatalogued {
      component: join(["fixture-psu-", host as String], "") as PhysicalAssetIdentity,
      catalog: PowerSupplyCatalogRow { model: "FIXTURE" as NonEmptyStr, manufacturer: asrock, rated_output: watt(count: psu_rated), efficiency: Gold },
      catalog_source: decl_ref(module_path: "test.claim.fleet.gpu_cap_policy_derivation_witness", decl_name: "fixture_psu"),
      efficiency_floor: EfficiencyFloorStated { floor: percent(count: 88), standing: CitedToAuthority { authority: fixture_authority } },
    },
    non_gpu_draw: NonGpuCeilingStated { dc_watts: watt(count: non_gpu), standing: CitedToAuthority { authority: fixture_authority } },
    unidentified_gpus: [],
  }
}

// john's real row with only its unread floor supplied; `stated_by` stays whatever the real row carries.
fn john_with_floor(stated_by_override: Bool) -> HostPowerConstraints {
  HostPowerConstraints {
    host: john_ba61f9_power_constraints.host,
    psu: match john_ba61f9_power_constraints.psu {
      PsuRatedOutputOperatorStated { component: c, rated_output: r, stated_by: by, efficiency_floor: _, model_read_obligation: o } => PsuRatedOutputOperatorStated {
        component: c, rated_output: r,
        stated_by: if stated_by_override { decl_ref(module_path: "test.claim.fleet.gpu_cap_policy_derivation_witness", decl_name: "not_a_ruling") } else { by },
        efficiency_floor: EfficiencyFloorStated { floor: percent(count: 88), standing: CitedToAuthority { authority: fixture_authority } },
        model_read_obligation: o,
      }
      _ => john_ba61f9_power_constraints.psu
    },
    non_gpu_draw: john_ba61f9_power_constraints.non_gpu_draw,
    unidentified_gpus: john_ba61f9_power_constraints.unidentified_gpus,
  }
}

fn breaker_fleet(john_row: HostPowerConstraints) -> CapDerivationInputs {
  CapDerivationInputs {
    policy: fleet_gpu_cap_default,
    continuous_fraction: cited_fraction,
    constraint_rows: [
      supplied_row(host: operator_host_srv1, psu_rated: 1600, non_gpu: 200),
      supplied_row(host: operator_host_srv2, psu_rated: 1000, non_gpu: 150),
      supplied_row(host: operator_host_e2d4b7, psu_rated: 1000, non_gpu: 150),
      john_row,
    ],
    installed: installed_gpu_board_containments,
    devices: current_gpu_device_observations,
    circuits: [breaker_srv1_ken_circuit],
    decisions: [],
  }
}

fn refused_on_the_breaker(d: HostCapDerivation) -> Bool {
  match d {
    HostCapsRefused { host: _, targets: _, violated: v, causes: cz, scope: _ } =>
      v.length() == 1 && cz.length() > 0
        && all(v, b => match b {
          CircuitContinuousAllowance { circuit: _, carry_limit: l, continuous_fraction: f, lowest_efficiency_floor: e, members_non_gpu: n } =>
            watt_count(w: l) == 1800 && percent_count(p: f) == 80 && percent_count(p: e) == 88 && watt_count(w: n) == 700
          _ => false
        })
    _ => false
  }
}

test fn the_breaker_with_every_fact_supplied_refuses_because_its_floors_exceed_567_w() -> Bool {
  let inputs = breaker_fleet(john_row: john_with_floor(stated_by_override: false))
  match resolve_circuit(inputs: inputs, c: breaker_srv1_ken_circuit) {
    CircuitResolved { circuit: _, members: ms, binding: _, budget: b, minima: m, targets: t } => ms.length() == 4 && b == 567 && m == 1075 && t == 1390
    CircuitUnresolved { needs: _ } => false
  }
    && refused_on_the_breaker(d: derive_host_caps_with(inputs: inputs, host: operator_host_ba61f9))
    && refused_on_the_breaker(d: derive_host_caps_with(inputs: inputs, host: operator_host_srv1))
    && refused_on_the_breaker(d: derive_host_caps_with(inputs: inputs, host: operator_host_e2d4b7))
}

// RED: AN OPERATOR-STATED FIGURE IS GROUNDED BY ITS RULING AND BY NOTHING ELSE. The same supplied breaker with
// john's supply citing a declaration that is not a rostered gunbc.design_ruling row: the supply's figure is not
// taken, john is withheld on it, and the refusal above is not reached.
test fn an_operator_stated_supply_citing_no_ruling_is_withheld_not_summed() -> Bool {
  let inputs = breaker_fleet(john_row: john_with_floor(stated_by_override: true))
  match derive_host_caps_with(inputs: inputs, host: operator_host_ba61f9) {
    HostHeadroomUnestablished { host: _, targets: _, needs: ns } =>
      any(ns, n => match n { PsuUnreadNeed { host: h, read_obligation: o } => host_identity_eq(a: h, b: operator_host_ba61f9) && string_contains(s: o as String, pattern: "not_a_ruling")  _ => false })
    _ => false
  }
}

// THE REAL REPORT CARRIES THE GPU-LESS BREAKER MEMBER AND WHAT IT OWES. srv2 has no derivation of its own, so the
// relation table and the fact checklist reach it only through related_hosts_of: its row shows the family-only
// supply and the unread ceiling, and the checklist names its two reads. A report that dropped srv2 would hide the
// facts that keep the breaker from being summed.
test fn the_real_report_lists_srv2_and_its_reads() -> Bool {
  let md = fleet_gpu_cap_report_md_with(inputs: fleet_cap_derivation_inputs())
  string_contains(s: md, pattern: "| srv2 | psu-srv2 (model/rating unread) |")
    && string_contains(s: md, pattern: "- srv2 supply: ")
    && string_contains(s: md, pattern: "- srv2 non-GPU draw ceiling unread")
    && string_contains(s: md, pattern: "| host-ba61f9 | operator-stated 1000 W DC (breaker_circuit_members_and_john_power_facts_2026_11_28), model unread; efficiency floor unread |")
}
