import std.nat { Nat }
import std.algebra { string_contains }
import std.list { distinct_by_key, first_where }
import std.measure { byte_size, byte_size_count, gibibyte, gibibyte_to_byte_size }
import gunbc.fleet.fleet_host_truth_read {
  HostTruthAxis,
  TruthDeclaredHardwareEnumerates,
  TruthEnabledUnitHasItsHardware,
  TruthIdentityAnchoredNotAddressed,
  TruthCapBindsDeclaredWorkingSet,
  TruthSlotSwapBackingDeclared,
  host_truth_axis_rule,
  host_truth_axes,
  host_truth_axes_match,
  HostTruthRead,
  HostTruthReadCause,
  HostTruthObserved,
  HostTruthReadBlank,
  HostTruthReadRefused,
  HostTruthProbeAbsent,
  HostTruthProbeThrew,
  HostTruthHostUnreachable,
  HostTruthOutputUnparseable,
  HostTruthExpectation,
  HostTruthDeclared,
  HostTruthNothingDeclared,
  HostTruthComparison,
  HostTruthValue,
  TruthSize,
  TruthUnbounded,
  TruthCount,
  TruthMarking,
  HostTruthClass,
  TruthClassAgreement,
  TruthClassDivergence,
  TruthClassRefusal,
  TruthClassUndeclared,
  host_truth_class,
  TruthAgrees,
  TruthDivergent,
  TruthUnread,
  TruthReadBlank,
  TruthNoReadSupplied,
  TruthNoExpectationForRead,
  TruthOutsideTheModel,
  TruthDuplicateRead,
  TruthDuplicateExpectation,
  TruthValueShapeRefused,
  TruthPairingRefused,
  host_truth_compare,
  host_truth_compare_roster,
  host_truth_divergence_locator,
  HostTruthVerdict,
  HostTruthFollowsDesiredState,
  HostTruthDiverges,
  HostTruthRefused,
  HostTruthNothingRead,
  fleet_host_truth_verdict_for_host,
  fleet_truth_admits_host,
  fleet_truth_roster_hosts,
  fleet_truth_roster_refusals,
  host_truth_host_text,
}

// EVERY INPUT IS SUPPLIED, so every arm of the comparison and all four of the verdict are reachable
// from a claim on any machine -- which is the whole reason the read's decision lives here and not inline in
// the converge step that will eventually read the hosts (gunbc.host.memory_envelope's header states the
// same rule; the frontier of this entry, including the mode that consumes it, is in
// gunbc.fleet.fleet_host_truth_read).
//
// THE FIVE REDS below plant one divergence per axis, each at the grain the operator's report of 2026-11-21
// found the real one at.

fn declared(host: NonEmptyStr, axis: HostTruthAxis, expected: HostTruthValue, by: String) -> HostTruthExpectation {
  HostTruthDeclared { host: host, axis: axis, expected: expected, declared_by: by }
}

fn nothing_declared(host: NonEmptyStr, axis: HostTruthAxis, because: String) -> HostTruthExpectation {
  HostTruthNothingDeclared { host: host, axis: axis, because: because }
}

// THE VALUES A READ OR A DECLARATION ANSWERS WITH. The fixtures spell a size in GiB because that is how the
// operator's report spelled it, and the axis relates ByteSize -- which is the point: one size written two
// ways is one size, and the read that answered 42949672960 bytes agrees with a declaration of 40 GiB.
fn truth_size(gib: Nat) -> HostTruthValue { TruthSize { size: gibibyte_to_byte_size(g: gibibyte(count: gib)) } }
fn truth_bytes(count: Nat) -> HostTruthValue { TruthSize { size: byte_size(count: count) } }
fn truth_unbounded() -> HostTruthValue { TruthUnbounded }
fn truth_count(n: Nat) -> HostTruthValue { TruthCount { count: n } }
fn truth_marking(text: String) -> HostTruthValue { TruthMarking { text: text } }

fn observed(host: NonEmptyStr, axis: HostTruthAxis, value: HostTruthValue) -> HostTruthRead {
  HostTruthObserved { host: host, axis: axis, observed: value, at_run: "44962462283" as NonEmptyStr, receipt: "supplied by the caller" }
}

fn refused(host: NonEmptyStr, axis: HostTruthAxis, cause: HostTruthReadCause) -> HostTruthRead {
  HostTruthReadRefused { host: host, axis: axis, cause: cause }
}

fn diverges(read: HostTruthRead, expectation: HostTruthExpectation) -> Bool {
  match host_truth_compare(read: read, expectation: expectation) {
    TruthDivergent { host: _, axis: _, observed: _, expected: _, declared_by: _ } => true
    TruthAgrees { host: _, axis: _, at_run: _, receipt: _ } => false
    TruthUnread { host: _, axis: _, cause: _ } => false
    TruthReadBlank { host: _, axis: _ } => false
    TruthNoReadSupplied { host: _, axis: _ } => false
    TruthNoExpectationForRead { host: _, axis: _ } => false
    TruthOutsideTheModel { host: _, axis: _, because: _ } => false
    TruthValueShapeRefused { host: _, axis: _, why: _ } => false
    TruthDuplicateRead { host: _, axis: _, read_count: _ } => false
    TruthDuplicateExpectation { host: _, axis: _, declaration_count: _ } => false
    TruthValueShapeRefused { host: _, axis: _, why: _ } => false
    TruthPairingRefused { why: _, pairing: _ } => false
  }
}

// A claim asks which class one comparison fell into by reading the classification itself, not a yes/no
// helper standing next to it.
fn refuses(comparison: HostTruthComparison) -> Bool {
  host_truth_class(comparison: comparison) == TruthClassRefusal
}

fn class_of(comparison: HostTruthComparison) -> HostTruthClass {
  host_truth_class(comparison: comparison)
}

fn agrees(read: HostTruthRead, expectation: HostTruthExpectation) -> Bool {
  class_of(comparison: host_truth_compare(read: read, expectation: expectation)) == TruthClassAgreement
}

// THE FIVE AXES ARE THE REPORT'S FIVE, each with a recognition rule a refusal can say out loud.
test fn the_axes_carry_five_distinct_recognition_rules() -> Bool {
  host_truth_axes().length() == 5
    && host_truth_axes().all(axis => host_truth_axis_rule(axis: axis) != "")
    && distinct_by_key(xs: host_truth_axes().map(axis => host_truth_axis_rule(axis: axis)), key: fn(rule) { rule }).length() == 5
}

// RED AXIS 1 -- DESIRED STATE NAMES HARDWARE THAT IS GONE. butch, 2026-11-17: four A2s out of PCI
// (lspci counts zero nvidia functions) while the model still declared four.
test fn RED_a_declared_device_count_that_no_longer_enumerates_diverges() -> Bool {
  diverges(
    read: observed(host: "butch" as NonEmptyStr, axis: TruthDeclaredHardwareEnumerates, value: truth_count(0)),
    expectation: declared(host: "butch" as NonEmptyStr, axis: TruthDeclaredHardwareEnumerates, expected: truth_count(4), by: "the serving layout's pool row"),
  )
}

// RED AXIS 2 -- AN ENABLED UNIT WHOSE HARDWARE IS GONE. dan (reported as h11), every boot: the expert-lock
// unit pinning GiB for A16s that were removed in favour of R9700s.
test fn RED_an_enabled_unit_over_hardware_that_does_not_enumerate_diverges() -> Bool {
  diverges(
    read: observed(host: "dan" as NonEmptyStr, axis: TruthEnabledUnitHasItsHardware, value: truth_marking("strata-expert-lock=enabled,gpu=a16-count=0")),
    expectation: declared(host: "dan" as NonEmptyStr, axis: TruthEnabledUnitHasItsHardware, expected: truth_marking("strata-expert-lock=enabled,gpu=a16-count=2"), by: "serving/host memory"),
  )
}

// RED AXIS 3 -- IDENTITY PINNED TO AN ADDRESS. butch moved .205 -> .238 in nine days and .238 carried a
// previous occupant's host key: the key it presents no longer matches the enrolled anchor, and from the
// outside that is indistinguishable from a man in the middle.
test fn RED_a_presented_key_that_does_not_match_the_enrolled_anchor_diverges() -> Bool {
  diverges(
    read: observed(host: "butch" as NonEmptyStr, axis: TruthIdentityAnchoredNotAddressed, value: truth_marking("ed25519 SHA256:9kQ2...")),
    expectation: declared(host: "butch" as NonEmptyStr, axis: TruthIdentityAnchoredNotAddressed, expected: truth_marking("ed25519 SHA256:4fB7..."), by: "fleet/host key enrollment"),
  )
}

// RED AXIS 4 -- A CAP THAT DEGRADES INSTEAD OF REFUSING. srv4: 40 GiB of MemoryHigh under a 56 GiB working
// set, 5.1 tok/s against 24.5-29.1, 41.5 GB read per request, no alarm.
test fn RED_a_binding_cap_below_the_declared_working_set_diverges() -> Bool {
  diverges(
    read: observed(host: "srv4" as NonEmptyStr, axis: TruthCapBindsDeclaredWorkingSet, value: truth_size(40)),
    expectation: declared(host: "srv4" as NonEmptyStr, axis: TruthCapBindsDeclaredWorkingSet, expected: truth_size(56), by: "the serving grant's slot"),
  )
}

// RED AXIS 5 -- THE SLOT CGROUP'S SWAP BACKING, not the host's. The report's 3.3 read host swap as cgroup
// swap; the axis here can only be about the cgroup, and the witness that says so is the next one.
test fn RED_a_slot_swap_backing_that_does_not_match_the_envelope_diverges() -> Bool {
  diverges(
    read: observed(host: "butch" as NonEmptyStr, axis: TruthSlotSwapBackingDeclared, value: truth_unbounded()),
    expectation: declared(host: "butch" as NonEmptyStr, axis: TruthSlotSwapBackingDeclared, expected: truth_size(0), by: "the runner slot's desired shape"),
  )
}

// HOST SWAP IS NOT AN AXIS, and a question about it is the model's own gap rather than a divergence: the
// envelope judges swap at the slot cgroup (gunbc.host.memory_envelope), so an expectation written as
// "nothing declared here" answers as outside the model and never as a fault.
test fn a_question_the_model_does_not_ask_answers_as_outside_the_model_not_as_a_fault() -> Bool {
  match host_truth_compare(
    read: observed(host: "butch" as NonEmptyStr, axis: TruthSlotSwapBackingDeclared, value: truth_unbounded()),
    expectation: nothing_declared(host: "butch" as NonEmptyStr, axis: TruthSlotSwapBackingDeclared, because: "no slot is placed on this host while its serving engines are retired"),
  ) {
    TruthOutsideTheModel { host: _, axis: _, because: _ } => true
    TruthDivergent { host: _, axis: _, observed: _, expected: _, declared_by: _ } => false
    TruthAgrees { host: _, axis: _, at_run: _, receipt: _ } => false
    TruthUnread { host: _, axis: _, cause: _ } => false
    TruthReadBlank { host: _, axis: _ } => false
    TruthNoReadSupplied { host: _, axis: _ } => false
    TruthNoExpectationForRead { host: _, axis: _ } => false
    TruthDuplicateRead { host: _, axis: _, read_count: _ } => false
    TruthDuplicateExpectation { host: _, axis: _, declaration_count: _ } => false
    TruthValueShapeRefused { host: _, axis: _, why: _ } => false
    TruthPairingRefused { why: _, pairing: _ } => false
  }
}

// RED -- A PROBE THAT IS NOT ON THE HOST IS A REFUSAL, NOT A ZERO. The fleet is NVIDIA and AMD; the
// benchmark sampler's nvidia-smi threw per-sample and left empty power columns that were read as absence
// (gunbc.recurring_failure_mode::failed_value_read_scored_as_value_absent).
test fn RED_a_missing_probe_refuses_and_never_becomes_agreement() -> Bool {
  refuses(host_truth_compare(
    read: refused(host: "ken" as NonEmptyStr, axis: TruthDeclaredHardwareEnumerates, cause: HostTruthProbeAbsent { probe: "nvidia-smi" }),
    expectation: declared(host: "ken" as NonEmptyStr, axis: TruthDeclaredHardwareEnumerates, expected: truth_count(1), by: "the build roster's slot row"),
  ))
    && refuses(host_truth_compare(
      read: refused(host: "ken" as NonEmptyStr, axis: TruthDeclaredHardwareEnumerates, cause: HostTruthProbeThrew { where: "background sample thread" }),
      expectation: declared(host: "ken" as NonEmptyStr, axis: TruthDeclaredHardwareEnumerates, expected: truth_count(1), by: "the build roster's slot row"),
    ))
    && refuses(host_truth_compare(
      read: refused(host: "ken" as NonEmptyStr, axis: TruthDeclaredHardwareEnumerates, cause: HostTruthOutputUnparseable { raw: "" }),
      expectation: declared(host: "ken" as NonEmptyStr, axis: TruthDeclaredHardwareEnumerates, expected: truth_count(1), by: "the build roster's slot row"),
    ))
}

// RED -- "PINGS BUT REFUSES TCP" IS AN ACL ANSWER (the untagged-join specimen), and it refuses rather than
// appearing as a host with nothing to report.
test fn RED_a_host_that_refuses_connections_refuses_on_the_identity_axis() -> Bool {
  refuses(host_truth_compare(
    read: refused(host: "butch" as NonEmptyStr, axis: TruthIdentityAnchoredNotAddressed, cause: HostTruthHostUnreachable { route: "192.168.1.238" }),
    expectation: declared(host: "butch" as NonEmptyStr, axis: TruthIdentityAnchoredNotAddressed, expected: truth_marking("ed25519 SHA256:4fB7..."), by: "fleet/host key enrollment"),
  ))
}

// RED -- A BLANK ANSWER IS NOT A VALUE. The reader must project, including zero; blank refuses.
test fn RED_a_blank_read_refuses_and_is_not_read_as_zero() -> Bool {
  refuses(host_truth_compare(
    read: HostTruthReadBlank { host: "srv3" as NonEmptyStr as NonEmptyStr, axis: TruthCapBindsDeclaredWorkingSet },
    expectation: declared(host: "srv3" as NonEmptyStr, axis: TruthCapBindsDeclaredWorkingSet, expected: truth_size(48), by: "the build roster's slot row"),
  ))
}

// RED -- A READ AND A DECLARATION THAT WERE MATCHED WRONG refuse instead of agreeing. The projections here
// are identical on purpose: only the hosts differ, so any implementation that compares values without
// pairing would report agreement.
test fn RED_a_mispaired_read_and_declaration_refuse_though_the_values_match() -> Bool {
  match host_truth_compare(
    read: observed(host: "srv3" as NonEmptyStr, axis: TruthCapBindsDeclaredWorkingSet, value: truth_size(48)),
    expectation: declared(host: "srv4" as NonEmptyStr, axis: TruthCapBindsDeclaredWorkingSet, expected: truth_size(48), by: "the build roster's slot row"),
  ) {
    TruthDuplicateRead { host: _, axis: _, read_count: _ } => true
    TruthDuplicateExpectation { host: _, axis: _, declaration_count: _ } => true
    TruthValueShapeRefused { host: _, axis: _, why: _ } => false
    TruthPairingRefused { why: _, pairing: _ } => true
    TruthAgrees { host: _, axis: _, at_run: _, receipt: _ } => false
    TruthDivergent { host: _, axis: _, observed: _, expected: _, declared_by: _ } => false
    TruthUnread { host: _, axis: _, cause: _ } => false
    TruthReadBlank { host: _, axis: _ } => false
    TruthNoReadSupplied { host: _, axis: _ } => false
    TruthNoExpectationForRead { host: _, axis: _ } => false
    TruthOutsideTheModel { host: _, axis: _, because: _ } => false
    TruthValueShapeRefused { host: _, axis: _, why: _ } => false
  }
    && match host_truth_compare(
      read: observed(host: "srv3" as NonEmptyStr, axis: TruthCapBindsDeclaredWorkingSet, value: truth_size(48)),
      expectation: declared(host: "srv3" as NonEmptyStr, axis: TruthSlotSwapBackingDeclared, expected: truth_size(48), by: "the build roster's slot row"),
    ) {
      TruthDuplicateRead { host: _, axis: _, read_count: _ } => true
      TruthDuplicateExpectation { host: _, axis: _, declaration_count: _ } => true
      TruthPairingRefused { why: _, pairing: _ } => true
      TruthAgrees { host: _, axis: _, at_run: _, receipt: _ } => false
      TruthDivergent { host: _, axis: _, observed: _, expected: _, declared_by: _ } => false
      TruthUnread { host: _, axis: _, cause: _ } => false
      TruthReadBlank { host: _, axis: _ } => false
      TruthNoReadSupplied { host: _, axis: _ } => false
      TruthNoExpectationForRead { host: _, axis: _ } => false
      TruthOutsideTheModel { host: _, axis: _, because: _ } => false
      TruthValueShapeRefused { host: _, axis: _, why: _ } => false
    }
}

// RED -- A HOST THE ROSTER ASKED ABOUT AND DID NOT READ refuses. This is the difference between the
// instrument and a flag: the gap between the question and the answer is itself a finding.
test fn RED_an_expectation_with_no_read_supplied_refuses() -> Bool {
  let verdict = fleet_host_truth_verdict_for_host(
    host: "srv4" as NonEmptyStr,
    reads: [],
    expectations: [declared(host: "srv4" as NonEmptyStr, axis: TruthCapBindsDeclaredWorkingSet, expected: truth_size(56), by: "the serving grant's slot")],
  )
  match verdict {
    HostTruthRefused { host: h, refusals: r } => host_truth_host_text(host: h) == "srv4"
      && r.all(comparison => match comparison { TruthNoReadSupplied { host: _, axis: _ } => true TruthAgrees { host: _, axis: _, at_run: _, receipt: _ } => false TruthDivergent { host: _, axis: _, observed: _, expected: _, declared_by: _ } => false TruthUnread { host: _, axis: _, cause: _ } => false TruthReadBlank { host: _, axis: _ } => false TruthNoExpectationForRead { host: _, axis: _ } => false TruthOutsideTheModel { host: _, axis: _, because: _ } => false
 TruthValueShapeRefused { host: _, axis: _, why: _ } => false TruthDuplicateRead { host: _, axis: _, read_count: _ } => false TruthDuplicateExpectation { host: _, axis: _, declaration_count: _ } => false
 TruthValueShapeRefused { host: _, axis: _, why: _ } => false TruthDuplicateRead { host: _, axis: _, read_count: _ } => false
 TruthDuplicateExpectation { host: _, axis: _, declaration_count: _ } => false
 TruthValueShapeRefused { host: _, axis: _, why: _ } => false
 TruthPairingRefused { why: _, pairing: _ } => false })
    HostTruthNothingRead { host: _, why: _ } => false
    HostTruthFollowsDesiredState { host: _, compared: _, undeclared: _ } => false
    HostTruthDiverges { host: _, divergences: _ } => false
  }
    && fleet_truth_admits_host(verdict: verdict) == false
}

// RED -- A HOST NEITHER READ NOR DECLARED ANYTHING ABOUT is unknown, not clean.
test fn RED_a_host_neither_read_nor_declared_is_not_admitted() -> Bool {
  let verdict = fleet_host_truth_verdict_for_host(host: "ken" as NonEmptyStr, reads: [], expectations: [])
  match verdict {
    HostTruthNothingRead { host: h, why: _ } => host_truth_host_text(host: h) == "ken"
    HostTruthRefused { host: _, refusals: _ } => false
    HostTruthFollowsDesiredState { host: _, compared: _, undeclared: _ } => false
    HostTruthDiverges { host: _, divergences: _ } => false
  }
    && fleet_truth_admits_host(verdict: verdict) == false
}

// RED -- A READ WITH NOTHING DECLARED AGAINST IT refuses the host it was read from: an instrument begins
// to fail open the day its output has no consumer attached to it.
test fn RED_a_read_with_nothing_declared_against_it_refuses_the_roster() -> Bool {
  let verdict = fleet_host_truth_verdict_for_host(
    host: "dan" as NonEmptyStr,
    reads: [observed(host: "dan" as NonEmptyStr, axis: TruthEnabledUnitHasItsHardware, value: truth_marking("strata-expert-lock=enabled,gpu=a16-count=0"))],
    expectations: [declared(host: "dan" as NonEmptyStr, axis: TruthCapBindsDeclaredWorkingSet, expected: truth_size(48), by: "the build roster's slot row")],
  )
  match verdict {
    HostTruthRefused { host: h, refusals: r } => host_truth_host_text(host: h) == "dan"
      && r.length() == 2
      && r.all(comparison => match comparison { TruthNoExpectationForRead { host: _, axis: _ } => true TruthNoReadSupplied { host: _, axis: _ } => true TruthAgrees { host: _, axis: _, at_run: _, receipt: _ } => false TruthDivergent { host: _, axis: _, observed: _, expected: _, declared_by: _ } => false TruthUnread { host: _, axis: _, cause: _ } => false TruthReadBlank { host: _, axis: _ } => false TruthOutsideTheModel { host: _, axis: _, because: _ } => false
 TruthValueShapeRefused { host: _, axis: _, why: _ } => false TruthDuplicateRead { host: _, axis: _, read_count: _ } => false TruthDuplicateExpectation { host: _, axis: _, declaration_count: _ } => false
 TruthValueShapeRefused { host: _, axis: _, why: _ } => false TruthDuplicateRead { host: _, axis: _, read_count: _ } => false
 TruthDuplicateExpectation { host: _, axis: _, declaration_count: _ } => false
 TruthValueShapeRefused { host: _, axis: _, why: _ } => false
 TruthPairingRefused { why: _, pairing: _ } => false })
    HostTruthNothingRead { host: _, why: _ } => false
    HostTruthFollowsDesiredState { host: _, compared: _, undeclared: _ } => false
    HostTruthDiverges { host: _, divergences: _ } => false
  }
    && fleet_truth_admits_host(verdict: verdict) == false
    && fleet_truth_roster_hosts(
      reads: [observed(host: "dan" as NonEmptyStr, axis: TruthEnabledUnitHasItsHardware, value: truth_marking("strata-expert-lock=enabled,gpu=a16-count=0"))],
      expectations: [declared(host: "dan" as NonEmptyStr, axis: TruthCapBindsDeclaredWorkingSet, expected: truth_size(48), by: "the build roster's slot row")],
    ).length() == 1
}

// RED -- A HOST WHOSE EVERY AXIS IS UNDECLARED IS NOT ADMITTED. Nothing was compared about it, and a pass
// made out of an empty comparison set is admission fabricated from silence: the host is unknown, not clean.
test fn RED_a_host_whose_every_axis_is_undeclared_is_not_admitted() -> Bool {
  let verdict = fleet_host_truth_verdict_for_host(
    host: "butch" as NonEmptyStr,
    reads: [observed(host: "butch" as NonEmptyStr, axis: TruthEnabledUnitHasItsHardware, value: truth_marking("strata-pool@a=enabled,gpu=nvidia-functions=0"))],
    expectations: [nothing_declared(host: "butch" as NonEmptyStr, axis: TruthEnabledUnitHasItsHardware, because: "its serving engines are retired and nothing is declared about the units")],
  )
  match verdict {
    HostTruthNothingRead { host: h, why: _ } => host_truth_host_text(host: h) == "butch"
    HostTruthRefused { host: _, refusals: _ } => false
    HostTruthFollowsDesiredState { host: _, compared: _, undeclared: _ } => false
    HostTruthDiverges { host: _, divergences: _ } => false
  }
    && fleet_truth_admits_host(verdict: verdict) == false
}

// A HOST WITH SOMETHING COMPARED AND SOMETHING UNDECLARED admits, and says how much of it the model does
// not declare -- the count that keeps "we agree" from hiding the axes nobody has written a rule for yet.
test fn a_host_admits_and_counts_what_the_model_leaves_undeclared() -> Bool {
  let verdict = fleet_host_truth_verdict_for_host(
    host: "srv3" as NonEmptyStr,
    reads: [
      observed(host: "srv3" as NonEmptyStr, axis: TruthCapBindsDeclaredWorkingSet, value: truth_size(48)),
      observed(host: "srv3" as NonEmptyStr, axis: TruthDeclaredHardwareEnumerates, value: truth_count(1)),
    ],
    expectations: [
      declared(host: "srv3" as NonEmptyStr, axis: TruthCapBindsDeclaredWorkingSet, expected: truth_size(48), by: "the build roster's slot row"),
      nothing_declared(host: "srv3" as NonEmptyStr, axis: TruthDeclaredHardwareEnumerates, because: "srv3's devices are catalogued only as a build slot's demand"),
    ],
  )
  match verdict {
    HostTruthFollowsDesiredState { host: h, compared: c, undeclared: u } => host_truth_host_text(host: h) == "srv3" && c == 2 && u == 1
    HostTruthNothingRead { host: _, why: _ } => false
    HostTruthRefused { host: _, refusals: _ } => false
    HostTruthDiverges { host: _, divergences: _ } => false
  }
    && fleet_truth_admits_host(verdict: verdict)
}

// DRIFT OUTRANKS REFUSAL for the same host, and neither arm admits.
test fn a_host_that_drifted_and_could_not_be_read_reports_the_drift() -> Bool {
  let verdict = fleet_host_truth_verdict_for_host(
    host: "butch" as NonEmptyStr,
    reads: [
      observed(host: "butch" as NonEmptyStr, axis: TruthDeclaredHardwareEnumerates, value: truth_count(0)),
      refused(host: "butch" as NonEmptyStr, axis: TruthIdentityAnchoredNotAddressed, cause: HostTruthHostUnreachable { route: "butch.tailnet" }),
    ],
    expectations: [
      declared(host: "butch" as NonEmptyStr, axis: TruthDeclaredHardwareEnumerates, expected: truth_count(4), by: "the serving layout's pool row"),
      declared(host: "butch" as NonEmptyStr, axis: TruthIdentityAnchoredNotAddressed, expected: truth_marking("ed25519 SHA256:4fB7..."), by: "fleet/host key enrollment"),
    ],
  )
  match verdict {
    HostTruthDiverges { host: h, divergences: d } => host_truth_host_text(host: h) == "butch" && d.length() == 1 && d.all(comparison => class_of(comparison: comparison) == TruthClassDivergence)
    HostTruthNothingRead { host: _, why: _ } => false
    HostTruthRefused { host: _, refusals: _ } => false
    HostTruthFollowsDesiredState { host: _, compared: _, undeclared: _ } => false
  }
    && fleet_truth_admits_host(verdict: verdict) == false
}

// RED -- THE ROSTER ADMITS HOST BY HOST. A clean srv3 does not carry a drifted butch: the verdict is per
// host because admission is per host, and a batch that averaged them would put a drifting machine on the
// roster behind a healthy one.
test fn RED_a_clean_host_does_not_carry_a_drifted_one_onto_the_roster() -> Bool {
  let reads = [
    observed(host: "srv3" as NonEmptyStr, axis: TruthCapBindsDeclaredWorkingSet, value: truth_size(48)),
    observed(host: "butch" as NonEmptyStr, axis: TruthDeclaredHardwareEnumerates, value: truth_count(0)),
  ]
  let expectations = [
    declared(host: "srv3" as NonEmptyStr, axis: TruthCapBindsDeclaredWorkingSet, expected: truth_size(48), by: "the build roster's slot row"),
    declared(host: "butch" as NonEmptyStr, axis: TruthDeclaredHardwareEnumerates, expected: truth_count(4), by: "the serving layout's pool row"),
  ]
  fleet_truth_roster_hosts(reads: reads, expectations: expectations).length() == 2
    && fleet_truth_roster_refusals(reads: reads, expectations: expectations).length() == 1
    && fleet_truth_roster_refusals(reads: reads, expectations: expectations).all(verdict =>
      match verdict {
        HostTruthDiverges { host: h, divergences: _ } => host_truth_host_text(host: h) == "butch"
        HostTruthNothingRead { host: _, why: _ } => false
        HostTruthRefused { host: _, refusals: _ } => false
        HostTruthFollowsDesiredState { host: _, compared: _, undeclared: _ } => false
      }
    )
}

// THE REFUSAL NAMES THE RULE AND THE HOST, never a count: a divergence on srv4's cap has to be actionable
// from the refusal line alone.
test fn a_divergence_says_which_rule_it_broke_on_which_host() -> Bool {
  let comparison = host_truth_compare(
    read: observed(host: "srv4" as NonEmptyStr, axis: TruthCapBindsDeclaredWorkingSet, value: truth_size(40)),
    expectation: declared(host: "srv4" as NonEmptyStr, axis: TruthCapBindsDeclaredWorkingSet, expected: truth_size(56), by: "the serving grant's slot"),
  )
  let text = host_truth_divergence_locator(comparison: comparison)
  // the remedy is part of the line now: the row's red_control is that the five arms stay separate because
  // their remedies are separate, and a line that named only the drift would leave the choice of remedy to the
  // reader. This expected string is this file's own words for the cap axis's remedy -- the same oracle the two
  // RED_ remedy claims use, not a read-back of host_truth_remedy_says.
  text == host_truth_axis_rule(axis: TruthCapBindsDeclaredWorkingSet) + " -- host srv4 carries a cap below the working set the serving grant's slot declares for the role it runs; remedy: refuse the placement whose binding cap sits under the working set the role declares"
    && string_contains(s: text, pattern: "srv4")
    && string_contains(s: text, pattern: "the serving grant's slot")
    && string_contains(s: text, pattern: "refuse the placement")
    // the quantities ride on the arm as quantities, not only as text in the line: whoever refuses the host
    // can act on the cap it found, and "40 GiB" is one size however the cgroup file spelled it.
    && match comparison {
      TruthDivergent { host: _, axis: _, observed: TruthSize { size: got }, expected: TruthSize { size: wants }, declared_by: _ } =>
        byte_size_count(b: got) < byte_size_count(b: wants)
      _ => false
    }
}

// THE ROSTER'S COMPARISON SET IS EVERY PAIR, INCLUDING THE ONES THAT REFUSE: the count a clean verdict
// reports is the count of comparisons actually made, so nothing is dropped on the way to a pass.
test fn the_roster_compares_every_pair_and_keeps_the_refusals_visible() -> Bool {
  let compared = host_truth_compare_roster(
    reads: [observed(host: "ken" as NonEmptyStr, axis: TruthSlotSwapBackingDeclared, value: truth_size(0))],
    expectations: [
      declared(host: "ken" as NonEmptyStr, axis: TruthSlotSwapBackingDeclared, expected: truth_size(0), by: "the runner slot's desired shape"),
      declared(host: "ken" as NonEmptyStr, axis: TruthCapBindsDeclaredWorkingSet, expected: truth_size(64), by: "the build roster's slot row"),
    ],
  )
  compared.length() == 2
    && compared.any(comparison => match comparison { TruthAgrees { host: _, axis: _, at_run: _, receipt: _ } => true  _ => false })
    && compared.any(comparison => match comparison { TruthNoReadSupplied { host: _, axis: _ } => true  _ => false })
}

// RED -- ONE HOST AND AXIS ANSWERED TWICE. Two probes, one of them stale, is how a per-host read starts
// failing open: the roster taking the first of two answers is a silent choice of which reader is the
// authority, and when that first answer happens to agree with the model the host would be admitted on a
// contradiction. So the pair is refused by name and the host is not admitted.
test fn RED_two_reads_answering_one_host_and_axis_refuse_the_host() -> Bool {
  let reads = [
    observed(host: "butch" as NonEmptyStr, axis: TruthDeclaredHardwareEnumerates, value: truth_count(4)),
    observed(host: "butch" as NonEmptyStr, axis: TruthDeclaredHardwareEnumerates, value: truth_count(0)),
  ]
  let expectations = [declared(host: "butch" as NonEmptyStr, axis: TruthDeclaredHardwareEnumerates, expected: truth_count(4), by: "the serving layout's pool row")]
  let verdict = fleet_host_truth_verdict_for_host(host: "butch" as NonEmptyStr, reads: reads, expectations: expectations)
  match verdict {
    HostTruthRefused { host: h, refusals: r } => host_truth_host_text(host: h) == "butch"
      && fleet_truth_admits_host(verdict: verdict) == false
      && r.any(comparison => string_contains(s: host_truth_divergence_locator(comparison: comparison), pattern: "read more than once"))
    HostTruthFollowsDesiredState { host: _, compared: _, undeclared: _ } => false
    HostTruthDiverges { host: _, divergences: _ } => false
    HostTruthNothingRead { host: _, why: _ } => false
  }
}

// RED -- ONE HOST AND AXIS DECLARED TWICE. Two rows claim the same fact with different values and nothing in
// the roster says which row is the authority. Even where one of the two happens to agree with the read, the
// doubled declaration is named and the host is not admitted: a contradiction inside the model is drift, not
// a choice of comparator.
test fn RED_two_declarations_covering_one_host_and_axis_are_named_and_refuse() -> Bool {
  let reads = [observed(host: "dan" as NonEmptyStr, axis: TruthSlotSwapBackingDeclared, value: truth_size(0))]
  let expectations = [
    declared(host: "dan" as NonEmptyStr, axis: TruthSlotSwapBackingDeclared, expected: truth_size(0), by: "gunbc.host.memory_envelope"),
    declared(host: "dan" as NonEmptyStr, axis: TruthSlotSwapBackingDeclared, expected: truth_size(8), by: "an older slot row"),
  ]
  let compared = host_truth_compare_roster(reads: reads, expectations: expectations)
  let verdict = fleet_host_truth_verdict_for_host(host: "dan" as NonEmptyStr, reads: reads, expectations: expectations)
  compared.length() == 3
    && compared.any(comparison => string_contains(s: host_truth_divergence_locator(comparison: comparison), pattern: "declared more than once"))
    && fleet_truth_admits_host(verdict: verdict) == false
}

// RED -- A CAP ROOMIER THAN THE ROLE DECLARES IS NOT DRIFT. The axis's own rule is an at-or-above relation,
// and a string comparison of two writings of a size answered it wrong in both directions: srv4 capped at
// 64 GiB against the 40 GiB the role declares was reported as a drift that would have dropped a healthy
// host from admission, while the report's 3.2 -- the leaf at 40 GiB under a 56 GiB expert set, 5.1 tok/s
// with 41.5 GB read per request -- is the divergence this axis exists to catch.
test fn RED_a_cap_at_or_above_the_working_set_declared_agrees_and_a_smaller_one_diverges() -> Bool {
  agrees(
    read: observed(host: "srv4" as NonEmptyStr, axis: TruthCapBindsDeclaredWorkingSet, value: truth_size(64)),
    expectation: declared(host: "srv4" as NonEmptyStr, axis: TruthCapBindsDeclaredWorkingSet, expected: truth_size(40), by: "the serving grant's slot"),
  )
    && diverges(
      read: observed(host: "srv4" as NonEmptyStr, axis: TruthCapBindsDeclaredWorkingSet, value: truth_size(40)),
      expectation: declared(host: "srv4" as NonEmptyStr, axis: TruthCapBindsDeclaredWorkingSet, expected: truth_size(56), by: "the serving grant's slot"),
    )
}

// ONE SIZE, TWO WAYS OF WRITING IT. The reader answers a cgroup file in bytes and the model declares GiB;
// those are one quantity, and comparing the texts would call a healthy host drifted. The values arrive as
// ByteSize precisely so this question cannot be asked in the wrong way.
test fn RED_one_size_written_in_bytes_and_one_written_in_gibibytes_is_the_same_size() -> Bool {
  agrees(
    read: observed(host: "srv4" as NonEmptyStr, axis: TruthCapBindsDeclaredWorkingSet, value: truth_bytes(42949672960)),
    expectation: declared(host: "srv4" as NonEmptyStr, axis: TruthCapBindsDeclaredWorkingSet, expected: truth_size(40), by: "the serving grant's slot"),
  )
}

// A CEILING THE MACHINE DOES NOT SET. An unset memory.high sits at or above any working set, so this axis
// passes; whether the leaf must carry a ceiling at all is gunbc.host.memory_envelope's rule, and this module
// does not answer a question the axis does not ask.
test fn a_cap_the_machine_does_not_set_is_at_or_above_any_working_set_the_role_declares() -> Bool {
  agrees(
    read: observed(host: "srv4" as NonEmptyStr, axis: TruthCapBindsDeclaredWorkingSet, value: truth_unbounded()),
    expectation: declared(host: "srv4" as NonEmptyStr, axis: TruthCapBindsDeclaredWorkingSet, expected: truth_size(40), by: "the serving grant's slot"),
  )
}

// RED -- A VALUE THAT IS NOT THE SHAPE ITS AXIS RELATES. A count projected onto the cap axis is a malformed
// read, not a host out of compliance: comparing it would invent a relation over a quantity the reader never
// answered, so the comparison refuses and says which side got the projection wrong.
test fn RED_a_value_that_is_not_the_shape_its_axis_relates_refuses_instead_of_guessing() -> Bool {
  refuses(host_truth_compare(
    read: observed(host: "srv4" as NonEmptyStr, axis: TruthCapBindsDeclaredWorkingSet, value: truth_count(4)),
    expectation: declared(host: "srv4" as NonEmptyStr, axis: TruthCapBindsDeclaredWorkingSet, expected: truth_size(40), by: "the serving grant's slot"),
  ))
    && refuses(host_truth_compare(
      read: observed(host: "srv4" as NonEmptyStr, axis: TruthCapBindsDeclaredWorkingSet, value: truth_size(40)),
      expectation: declared(host: "srv4" as NonEmptyStr, axis: TruthCapBindsDeclaredWorkingSet, expected: truth_marking("memory.high=40G"), by: "a row that spelled its size as text"),
    ))
    && string_contains(s: host_truth_divergence_locator(comparison: host_truth_compare(
      read: observed(host: "srv4" as NonEmptyStr, axis: TruthCapBindsDeclaredWorkingSet, value: truth_count(4)),
      expectation: declared(host: "srv4" as NonEmptyStr, axis: TruthCapBindsDeclaredWorkingSet, expected: truth_size(40), by: "the serving grant's slot"),
    )), pattern: "the read did not supply one")
}

// THE FIVE REMEDIES AND THE ADMIT WITNESS PER ARM, planted before the fold that carries them. The row's own
// red_control, verbatim: "A planted divergence that does not refuse, or an arm collapsed into another because
// the merged verdict was easier to carry, fails the row: the arms stay separate because their remedies are
// separate (remove hardware, retire a unit, re-anchor a key, refuse a placement, provision backing)."
//
// MEASURED AT THE COMMIT THIS BLOCK WAS PLANTED INTO, in dag/gunbc/fleet/fleet_host_truth_read.dag with the
// word-boundary pattern (^|[^a-z0-9_])WORD([^a-z0-9_]|$), counting matching lines: "remove" in a rule or
// relation string 0, retire 0, re-anchor 0, reanchor 0, placement 0, provision 0. The module says which rule a
// divergence broke and which two quantities differ, and never says which of the five remedies follows -- so a
// reader of a refusal line still has to open this file to know what to do, and nothing in the tree can tell
// that a merged remedy would have been wrong. The two remedy claims below are RED at this commit for exactly
// that reason and turn green only when a remedy authority joins the line, one per axis.
//
// THE MARKERS ARE THIS FILE'S OWN ORACLE, not a read-back of the model. Deriving the expected word from the
// remedy authority would make the claim `measure() == measure()`, which is a change detector and not a witness
// (gunbc.design_argument::fail_closed). Its referent is the row's parenthesised list of five remedies.
fn remedy_marker(axis: HostTruthAxis) -> String {
  match axis {
    TruthDeclaredHardwareEnumerates => "remove"
    TruthEnabledUnitHasItsHardware => "retire"
    TruthIdentityAnchoredNotAddressed => "re-anchor"
    TruthCapBindsDeclaredWorkingSet => "placement"
    TruthSlotSwapBackingDeclared => "provision"
  }
}

// THE PLANTED DIVERGENCE PER AXIS, at the grain the five RED_ controls above already plant (the same hosts,
// the same values, the same declaring authorities) so the remedy claim runs on the row's divergence and not on
// a softer one.
fn planted_divergence_host(axis: HostTruthAxis) -> NonEmptyStr {
  match axis {
    TruthDeclaredHardwareEnumerates => "butch" as NonEmptyStr
    TruthEnabledUnitHasItsHardware => "dan" as NonEmptyStr
    TruthIdentityAnchoredNotAddressed => "butch" as NonEmptyStr
    TruthCapBindsDeclaredWorkingSet => "srv4" as NonEmptyStr
    TruthSlotSwapBackingDeclared => "butch" as NonEmptyStr
  }
}

fn planted_divergence_read(axis: HostTruthAxis) -> HostTruthRead {
  match axis {
    TruthDeclaredHardwareEnumerates => observed(host: "butch" as NonEmptyStr, axis: axis, value: truth_count(0))
    TruthEnabledUnitHasItsHardware => observed(host: "dan" as NonEmptyStr, axis: axis, value: truth_marking("strata-expert-lock=enabled,gpu=a16-count=0"))
    TruthIdentityAnchoredNotAddressed => observed(host: "butch" as NonEmptyStr, axis: axis, value: truth_marking("ed25519 SHA256:9kQ2..."))
    TruthCapBindsDeclaredWorkingSet => observed(host: "srv4" as NonEmptyStr, axis: axis, value: truth_size(40))
    TruthSlotSwapBackingDeclared => observed(host: "butch" as NonEmptyStr, axis: axis, value: truth_unbounded())
  }
}

fn planted_divergence_declaration(axis: HostTruthAxis) -> HostTruthExpectation {
  match axis {
    TruthDeclaredHardwareEnumerates => declared(host: "butch" as NonEmptyStr, axis: axis, expected: truth_count(4), by: "the serving layout's pool row")
    TruthEnabledUnitHasItsHardware => declared(host: "dan" as NonEmptyStr, axis: axis, expected: truth_marking("strata-expert-lock=enabled,gpu=a16-count=2"), by: "serving/host memory")
    TruthIdentityAnchoredNotAddressed => declared(host: "butch" as NonEmptyStr, axis: axis, expected: truth_marking("ed25519 SHA256:4fB7..."), by: "fleet/host key enrollment")
    TruthCapBindsDeclaredWorkingSet => declared(host: "srv4" as NonEmptyStr, axis: axis, expected: truth_size(56), by: "the serving grant's slot")
    TruthSlotSwapBackingDeclared => declared(host: "butch" as NonEmptyStr, axis: axis, expected: truth_size(0), by: "the runner slot's desired shape")
  }
}

// THE READ THAT AGREES on the same axis against the same declaration -- the pair that lets the admit claims
// below say "this axis, this host, divergence in, agreement out" instead of resting on the fixture's shape.
fn agreeing_read(axis: HostTruthAxis) -> HostTruthRead {
  match axis {
    TruthDeclaredHardwareEnumerates => observed(host: "butch" as NonEmptyStr, axis: axis, value: truth_count(4))
    TruthEnabledUnitHasItsHardware => observed(host: "dan" as NonEmptyStr, axis: axis, value: truth_marking("strata-expert-lock=enabled,gpu=a16-count=2"))
    TruthIdentityAnchoredNotAddressed => observed(host: "butch" as NonEmptyStr, axis: axis, value: truth_marking("ed25519 SHA256:4fB7..."))
    TruthCapBindsDeclaredWorkingSet => observed(host: "srv4" as NonEmptyStr, axis: axis, value: truth_size(64))
    TruthSlotSwapBackingDeclared => observed(host: "butch" as NonEmptyStr, axis: axis, value: truth_size(0))
  }
}

fn planted_divergence_line(axis: HostTruthAxis) -> String {
  host_truth_divergence_locator(comparison: host_truth_compare(
    read: planted_divergence_read(axis: axis),
    expectation: planted_divergence_declaration(axis: axis),
  ))
}

// RED -- A PLANTED DIVERGENCE THAT DOES NOT SAY WHAT TO DO ABOUT IT. One per axis, over all five axes.
test fn RED_a_planted_divergence_names_the_remedy_for_its_axis() -> Bool {
  host_truth_axes().all(axis => string_contains(s: planted_divergence_line(axis: axis), pattern: remedy_marker(axis: axis)))
}

// ONE LEVEL OF LAMBDA PER CLAIM: the axis list is projected by named helpers rather than nested inline, so
// every call's callee identity is established where it is made.
fn axes_matching(axis: HostTruthAxis) -> List<HostTruthAxis> {
  host_truth_axes().filter(other => host_truth_axes_match(left: axis, right: other))
}

fn axes_other_than(axis: HostTruthAxis) -> List<HostTruthAxis> {
  host_truth_axes().filter(other => host_truth_axes_match(left: other, right: axis) == false)
}

fn line_names_marker(line: String, axis: HostTruthAxis) -> Bool {
  string_contains(s: line, pattern: remedy_marker(axis: axis))
}

fn line_names_any_other_axis_marker(line: String, axis: HostTruthAxis) -> Bool {
  axes_other_than(axis: axis).any(other => string_contains(s: line, pattern: remedy_marker(axis: other)))
}

// RED -- AN ARM COLLAPSED INTO ANOTHER BECAUSE THE MERGED VERDICT WAS EASIER TO CARRY. Every axis must name
// its own marker and none of the other four, so one sentence shared by two axes, or one sentence shared by
// all five, fails here even if it passes the claim above.
test fn RED_no_axis_borrows_another_axis_remedy() -> Bool {
  host_truth_axes().all(axis =>
    line_names_marker(line: planted_divergence_line(axis: axis), axis: axis)
      && line_names_any_other_axis_marker(line: planted_divergence_line(axis: axis), axis: axis) == false
  )
}

// THE FIVE PLANTED DIVERGENCES DIVERGE; none of them is a refusal, and none is agreement. The row's control
// starts from a planted divergence that does not refuse, so the planting itself is witnessed before the
// remedy is asked of it.
test fn the_five_planted_divergences_are_divergences_and_not_refusals() -> Bool {
  host_truth_axes().all(axis =>
    class_of(comparison: host_truth_compare(
      read: planted_divergence_read(axis: axis),
      expectation: planted_divergence_declaration(axis: axis),
    )) == TruthClassDivergence
  )
}

// TWO AXES CANNOT BE READ AS ONE, and the mechanism is the model's own pairing refusal rather than a parallel
// one invented here: a hardware read answered against a cap declaration refuses, and the refusal carries both
// axes so the crossing is locatable. Green before the remedy fold and it must stay green -- this is the half
// of the control that a fold which merged the axes would break.
test fn a_read_answered_against_another_axis_refuses_and_names_both_axes() -> Bool {
  match host_truth_compare(
    read: observed(host: "srv4" as NonEmptyStr, axis: TruthDeclaredHardwareEnumerates, value: truth_count(4)),
    expectation: declared(host: "srv4" as NonEmptyStr, axis: TruthCapBindsDeclaredWorkingSet, expected: truth_size(56), by: "the serving grant's slot"),
  ) {
    TruthPairingRefused { why: _, pairing: p } =>
      host_truth_axes_match(left: p.read_axis, right: p.expectation_axis) == false
        && host_truth_axes_match(left: p.read_axis, right: TruthDeclaredHardwareEnumerates)
        && host_truth_axes_match(left: p.expectation_axis, right: TruthCapBindsDeclaredWorkingSet)
    _ => false
  }
}

// ONE REMEDY PER AXIS PRESUPPOSES ONE AXIS PER AXIS. Each of the five matches exactly one member of the sum,
// so a remedy keyed on an axis cannot be keyed on two of them.
test fn each_axis_matches_itself_and_no_other_axis() -> Bool {
  host_truth_axes().all(axis => axes_matching(axis: axis).length() == 1)
}

// THE ADMIT WITNESS PER ARM (first_slice: "one planted-divergence witness per arm and one admit witness per
// arm"). Measured at the commit this block was planted into: 26 test fns, 19 RED_ prefixed, 3 whose names
// mention admission and none of them per axis -- so the per-arm half of first_slice is what is missing, not a
// duplicate of what is there. Each claim admits the host on the strength of one axis and asks whether the
// axis's own divergence takes it off: the grain a roster acts at.
fn axis_admits(host: NonEmptyStr, axis: HostTruthAxis, read: HostTruthRead) -> Bool {
  fleet_truth_admits_host(verdict: fleet_host_truth_verdict_for_host(
    host: host,
    reads: [read],
    expectations: [planted_divergence_declaration(axis: axis)],
  ))
}

test fn the_hardware_axis_divergence_alone_keeps_the_host_off_admission() -> Bool {
  axis_admits(host: planted_divergence_host(axis: TruthDeclaredHardwareEnumerates), axis: TruthDeclaredHardwareEnumerates, read: agreeing_read(axis: TruthDeclaredHardwareEnumerates))
    && axis_admits(host: planted_divergence_host(axis: TruthDeclaredHardwareEnumerates), axis: TruthDeclaredHardwareEnumerates, read: planted_divergence_read(axis: TruthDeclaredHardwareEnumerates)) == false
}

test fn the_enabled_unit_axis_divergence_alone_keeps_the_host_off_admission() -> Bool {
  axis_admits(host: planted_divergence_host(axis: TruthEnabledUnitHasItsHardware), axis: TruthEnabledUnitHasItsHardware, read: agreeing_read(axis: TruthEnabledUnitHasItsHardware))
    && axis_admits(host: planted_divergence_host(axis: TruthEnabledUnitHasItsHardware), axis: TruthEnabledUnitHasItsHardware, read: planted_divergence_read(axis: TruthEnabledUnitHasItsHardware)) == false
}

test fn the_identity_axis_divergence_alone_keeps_the_host_off_admission() -> Bool {
  axis_admits(host: planted_divergence_host(axis: TruthIdentityAnchoredNotAddressed), axis: TruthIdentityAnchoredNotAddressed, read: agreeing_read(axis: TruthIdentityAnchoredNotAddressed))
    && axis_admits(host: planted_divergence_host(axis: TruthIdentityAnchoredNotAddressed), axis: TruthIdentityAnchoredNotAddressed, read: planted_divergence_read(axis: TruthIdentityAnchoredNotAddressed)) == false
}

test fn the_cap_axis_divergence_alone_keeps_the_host_off_admission() -> Bool {
  axis_admits(host: planted_divergence_host(axis: TruthCapBindsDeclaredWorkingSet), axis: TruthCapBindsDeclaredWorkingSet, read: agreeing_read(axis: TruthCapBindsDeclaredWorkingSet))
    && axis_admits(host: planted_divergence_host(axis: TruthCapBindsDeclaredWorkingSet), axis: TruthCapBindsDeclaredWorkingSet, read: planted_divergence_read(axis: TruthCapBindsDeclaredWorkingSet)) == false
}

test fn the_swap_backing_axis_divergence_alone_keeps_the_host_off_admission() -> Bool {
  axis_admits(host: planted_divergence_host(axis: TruthSlotSwapBackingDeclared), axis: TruthSlotSwapBackingDeclared, read: agreeing_read(axis: TruthSlotSwapBackingDeclared))
    && axis_admits(host: planted_divergence_host(axis: TruthSlotSwapBackingDeclared), axis: TruthSlotSwapBackingDeclared, read: planted_divergence_read(axis: TruthSlotSwapBackingDeclared)) == false
}

// A REFUSAL CARRIES NO REMEDY. A read that did not happen establishes nothing about the machine, so what it
// owes is the probe repaired or the host reached -- not a judgment about hardware, units, keys, caps or
// backing. Printing a machine remedy on an unread axis would attach a remedy to a fact nobody read, which is
// the fabricated located cause gunbc.design_argument::fail_closed refuses, and it is the same discipline that
// keeps host_truth_read_cause_explains from naming WHICH kind of "no" a cgroup property gave. So: the cause is
// the loud half of a refusal, the remedy is the loud half of a divergence, and neither stands in for the other.
test fn a_refusal_names_its_cause_and_invents_no_remedy() -> Bool {
  let line = host_truth_divergence_locator(comparison: host_truth_compare(
    read: refused(host: "butch" as NonEmptyStr, axis: TruthDeclaredHardwareEnumerates, cause: HostTruthProbeAbsent { probe: "the per-host PCI class count" }),
    expectation: declared(host: "butch" as NonEmptyStr, axis: TruthDeclaredHardwareEnumerates, expected: truth_count(4), by: "the serving layout's pool row"),
  ))
  string_contains(s: line, pattern: "the probe this axis needs is not on that host")
    && string_contains(s: line, pattern: "remedy:") == false
}

// EACH REMEDY MARKER APPEARS ON EXACTLY ONE AXIS LINE. Five markers, five axes, one axis each: a fold that
// merged two axes into one remedy would leave a marker missing from one line and present on two, and this
// counts it rather than trusting that the fold was written carefully.
test fn each_remedy_marker_appears_on_exactly_one_axis_line() -> Bool {
  host_truth_axes().all(axis =>
    host_truth_axes()
      .filter(other => string_contains(s: planted_divergence_line(axis: other), pattern: remedy_marker(axis: axis)))
      .length() == 1
  )
}
