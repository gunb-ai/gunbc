module test.claim.fleet_converge_privilege_hold_witness

import std.types { Bool, Int, list_length }
import gunbc.fleet_posix_accounts {
  fleet_posix_operator_sudo_grants,
  fleet_posix_ci_runner_sudo_grants,
  fleet_posix_operator_sudo_grant_is_hostnamectl_only,
}
import gunbc.fleet_converge_cli {
  converge_cli_receipt_owner_readback_required,
  converge_cli_expected_receipt_owner_name,
}
import gunbc.host_converge_slice1 {
  host_converge_slice1_shadow_revert_script_matches_authority,
  host_converge_slice1_probe_unit,
  host_converge_slice1_cap_author_before_shadow_revert_enforced,
}
import gunbc.host_axis_caps {
  runner_memory_cap_author_ready_for_shadow_revert,
  derived_runner_memory_cap_members,
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// RED control: whole-binary install/systemctl on the operator roster is root-equivalent
// and held for operator ruling — not an accidental merge artifact.
test fn witness_operator_roster_not_widened_to_whole_binary_install_or_systemctl() -> Bool {
  list_length(items: fleet_posix_operator_sudo_grants()) == 1
    && fleet_posix_operator_sudo_grant_is_hostnamectl_only()
    && list_length(items: fleet_posix_ci_runner_sudo_grants()) >= 2
}

// witness_convergence_suppresses_memory_max_set_property WAS HERE AND ITS DELETION IS THE POINT.
// It read two `data ...: Bool = true` flags and asserted them, so it executed `true && true` and
// could not have failed for any state of the tree — including the state the tree was actually in,
// where the converge-side apply arm it claimed was suppressed was still wired and reachable.
// The privilege hold it named is now enforced by the absence of that arm
// (gunbc.host_effect_realize converge_in_process_apply_withdrawn_reason, and the deleted
// gunbc.host_converge_realize), so deleting this test removes a false guarantee rather than a
// real one. A reviewer counting tests should read this as one fewer assertion and one more wall.

// Residue removal uses systemctl revert (inverse of set-property), not a new set-property apply.
test fn witness_control_shadow_revert_script_is_revert_not_set_property() -> Bool {
  host_converge_slice1_shadow_revert_script_matches_authority(unit: host_converge_slice1_probe_unit)
}

test fn witness_cap_author_before_shadow_revert_enforced_in_slice1() -> Bool {
  host_converge_slice1_cap_author_before_shadow_revert_enforced
}

test fn witness_shadow_revert_blocked_without_derived_dropins_on_disk() -> Bool {
  !runner_memory_cap_author_ready_for_shadow_revert(observed: [])
    && runner_memory_cap_author_ready_for_shadow_revert(observed: derived_runner_memory_cap_members())
}

test fn witness_receipt_owner_readback_required() -> Bool {
  converge_cli_receipt_owner_readback_required
    && converge_cli_expected_receipt_owner_name() == "briansrls"
}
