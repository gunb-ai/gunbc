module test.claim.fleet.fleet_host_budget

import product.fabric.envelope { memory_envelope }
import std.types { Int, List, String, Bool }
import std.measure { ByteSize, byte_size, byte_size_count, HardwareThreadCount, hardware_thread_count, hardware_thread_count_value }
import product.budget_tree { BudgetNode, node_conserves }
import gunbc.fleet.fleet_container {
  FleetContainerType,
  GhaRunnerContainer,
  ContainerBaseline,
  ContainerBaselineMeasured,
  ContainerBaselineUnmeasured,
  BaselineResolution,
  BaselineResolved,
  BaselineUnmeasured,
  container_baseline_bytes,
  gha_runner_container,
}
import gunbc.fleet.fleet_host_budget {
  HeadroomPolicy,
  HeadroomSet,
  HeadroomUnset,
  HeadroomResolution,
  HeadroomResolved,
  HeadroomUnsound,
  resolve_headroom,
  oomd_actuation_floor,
  FleetHostPlan,
  FleetHostPlanDerived,
  FleetHostPlanUnsound,
  fleet_host_plan,
  fleet_host_plan_for,
  fleet_host_budget_tree,
  runner_slice_cap,
  runner_slice_cap_drifted,
  gunbc_fleet_oomd_floor_basis,
  compile_pool_bytes_for,
  CompilePoolDerived,
  CompilePoolUnresolved,
}
import gunbc.host.host_layout { CompilePoolSliceDeclared, CompilePoolInRunnerSlots }
import gunbc.ci.ci_floor_measurement {
  OomdEnforcementEvidence,
  OomdEnforced,
  OomdUnverified,
  RunnerSliceCapEffectiveness,
  CapEffective,
  CapUnbounded,
}
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn runner_idle_bytes() -> ByteSize {
  byte_size(314572800)
}

fn fixture_runner_measured() -> FleetContainerType {
  GhaRunnerContainer { baseline: ContainerBaselineMeasured { idle: memory_envelope(min_bytes: runner_idle_bytes()) } }
}

fn fixture_runner_unmeasured() -> FleetContainerType {
  GhaRunnerContainer { baseline: ContainerBaselineUnmeasured }
}

fn host_125gib() -> ByteSize {
  byte_size(134217728000)
}

fn overhead_16gib() -> ByteSize {
  byte_size(17179869184)
}

fn session_slice_fixture() -> ByteSize {
  byte_size(40000000000)
}

fn fitting_headroom() -> HeadroomPolicy {
  HeadroomSet { bytes: byte_size(16106127360) }
}

fn fitting_headroom_bytes() -> ByteSize {
  byte_size(16106127360)
}

fn is_unsound(plan: FleetHostPlan) -> Bool {
  match plan {
    FleetHostPlanUnsound { reason: _ } => true
    FleetHostPlanDerived { name: _, tree: _, runner_slice_cap: _, effective_runner_cpu_cap: _ } => false
  }
}

fn full_plan(
  runner: FleetContainerType,
  session_slice: ByteSize,
  policy: HeadroomPolicy,
  oomd: OomdEnforcementEvidence
) -> FleetHostPlan {
  fleet_host_plan_for(
    name: "fixture",
    host: host_125gib(),
    overhead: overhead_16gib(),
    nproc: hardware_thread_count(count: 128),
    runner: runner,
    session_slice: session_slice,
    policy: policy,
    oomd: oomd
  )
}

fn sound_plan() -> FleetHostPlan {
  full_plan(runner: fixture_runner_measured(), session_slice: session_slice_fixture(), policy: fitting_headroom(), oomd: OomdEnforced)
}

test fn witness_live_plan_fail_closed() -> Bool {
  is_unsound(plan: fleet_host_plan())
}

// RED (A2): with the jobserver sizing retired, a declared separate compile-pool slice has no sizing
// authority and refuses; the in-slot placement charges zero.
test fn witness_a_declared_compile_pool_slice_is_unsized() -> Bool {
  (match compile_pool_bytes_for(placement: CompilePoolSliceDeclared { slice_unit: "gunbc-compile-pool.slice" }) {
    CompilePoolUnresolved { reason: _ } => true
    CompilePoolDerived { bytes: _ } => false
  })
    && (match compile_pool_bytes_for(placement: CompilePoolInRunnerSlots) {
      CompilePoolDerived { bytes: b } => byte_size_count(b: b) == 0
      CompilePoolUnresolved { reason: _ } => false
    })
}

test fn witness_runner_baseline_unmeasured_unsound() -> Bool {
  is_unsound(plan: full_plan(runner: fixture_runner_unmeasured(), session_slice: session_slice_fixture(), policy: fitting_headroom(), oomd: OomdEnforced))
}

test fn witness_headroom_unset_unsound() -> Bool {
  is_unsound(plan: full_plan(runner: fixture_runner_measured(), session_slice: session_slice_fixture(), policy: HeadroomUnset, oomd: OomdEnforced))
}

test fn witness_oomd_unverified_unsound() -> Bool {
  is_unsound(plan: full_plan(runner: fixture_runner_measured(), session_slice: session_slice_fixture(), policy: fitting_headroom(), oomd: OomdUnverified))
}

test fn witness_headroom_below_floor_unsound() -> Bool {
  let floor = oomd_actuation_floor(host: host_125gib())
  match resolve_headroom(policy: HeadroomSet { bytes: byte_size(1073741824) }, floor: floor) {
    HeadroomUnsound { reason: _ } => true
    HeadroomResolved { bytes: _ } => false
  }
}

test fn witness_headroom_at_or_above_floor_resolved() -> Bool {
  let floor = oomd_actuation_floor(host: host_125gib())
  match resolve_headroom(policy: HeadroomSet { bytes: floor }, floor: floor) {
    HeadroomResolved { bytes: b } => byte_size_count(b: b) == byte_size_count(b: floor)
    HeadroomUnsound { reason: _ } => false
  }
}

// The effective runner CPU cap is the host threads less the declared host reserve (8): 128 -> 120.
test fn witness_runner_cpu_cap_is_cores_minus_reserve() -> Bool {
  match sound_plan() {
    FleetHostPlanDerived { name: _, tree: _, runner_slice_cap: _, effective_runner_cpu_cap: cpu } =>
      hardware_thread_count_value(t: cpu) == 120
    FleetHostPlanUnsound { reason: _ } => false
  }
}

test fn witness_plan_derives_and_conserves() -> Bool {
  match sound_plan() {
    FleetHostPlanDerived { name: _, tree: t, runner_slice_cap: slice, effective_runner_cpu_cap: cpu } =>
      node_conserves(node: t)
        && hardware_thread_count_value(t: cpu) > 0
        && byte_size_count(b: slice) > 0
    FleetHostPlanUnsound { reason: _ } => false
  }
}

test fn witness_runner_slice_is_session_worstcase_only() -> Bool {
  let slice = runner_slice_cap(host: host_125gib(), overhead: overhead_16gib(), session_slice: session_slice_fixture(), headroom: fitting_headroom_bytes(), compile_pool: byte_size(0))
  let expected = byte_size_count(b: host_125gib()) - byte_size_count(b: overhead_16gib()) - byte_size_count(b: session_slice_fixture()) - byte_size_count(b: fitting_headroom_bytes())
  byte_size_count(b: slice) == expected
}

test fn witness_host_conserves_exactly() -> Bool {
  let slice = runner_slice_cap(host: host_125gib(), overhead: overhead_16gib(), session_slice: session_slice_fixture(), headroom: fitting_headroom_bytes(), compile_pool: byte_size(0))
  let whole = byte_size_count(b: overhead_16gib()) + byte_size_count(b: session_slice_fixture()) + byte_size_count(b: fitting_headroom_bytes()) + byte_size_count(b: slice)
  whole == byte_size_count(b: host_125gib())
}

test fn witness_tree_conserves() -> Bool {
  let slice = runner_slice_cap(host: host_125gib(), overhead: overhead_16gib(), session_slice: session_slice_fixture(), headroom: fitting_headroom_bytes(), compile_pool: byte_size(0))
  let tree = fleet_host_budget_tree(name: "fixture", host: host_125gib(), overhead: overhead_16gib(), runner_baseline: runner_idle_bytes(), session_slice: session_slice_fixture(), headroom: fitting_headroom_bytes(), runner_slice: slice, compile_pool: byte_size(0))
  node_conserves(node: tree)
}

test fn witness_overcommit_tree_refused() -> Bool {
  let bloated_slice = byte_size(byte_size_count(b: host_125gib()))
  let tree = fleet_host_budget_tree(name: "overcommit", host: host_125gib(), overhead: overhead_16gib(), runner_baseline: runner_idle_bytes(), session_slice: session_slice_fixture(), headroom: fitting_headroom_bytes(), runner_slice: bloated_slice, compile_pool: byte_size(0))
  !node_conserves(node: tree)
}

test fn witness_runner_slice_cap_drift_red_receipt() -> Bool {
  let disk = byte_size(70391285350)
  runner_slice_cap_drifted(disk_cap: disk, effective: CapUnbounded)
    && !runner_slice_cap_drifted(disk_cap: disk, effective: CapEffective { bytes: disk })
    && runner_slice_cap_drifted(disk_cap: disk, effective: CapEffective { bytes: byte_size(55307438489) })
}

