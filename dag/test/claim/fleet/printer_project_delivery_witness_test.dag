module test.claim.fleet.printer_project_delivery_witness_test

import std.types { Bool, String, NonEmptyStr, FilePath }
import std.nat { Nat }
import extdeps.crypto.hash { Digest, sha256_digest }
import extdeps.exec.command { ArgvCommand, argv_words }
import extdeps.ietf.ftps {
  FtpsEndpoint, FtpsExplicit, FtpsImplicit, FtpsVerifyPeer,
  FtpsPeerVerificationDisabled, DeviceCertificateSubjectIsSerialNotAddress,
  ftps_default_port, ftps_verifies_peer, ftps_endpoint,
}
import gunbc.fleet.printer_project_delivery {
  remote_name_for_digest, bambu_lan_endpoint, ftps_upload_url, ftps_scheme,
  refused_delivery, ProjectDelivery, ProjectDeliveryRefused, ProjectDeliveryRefusedResidueRemains,
  ProjectDelivered, ProjectDeliveryUnattempted, ProjectTransferredCleanupRefused,
  ProjectDeliveryProvisionRequired, ProjectDeliveryUnattemptedResidueRemains,
  ProjectDeliveryProvisionRequiredResidueRemains, unattempted_delivery,
  PayloadIdentification, PayloadIdentified, PayloadIdentificationRefused,
  PayloadIdentificationRefusedResidueRemains, identification_refusal,
}
import extdeps.tools.curl { curl_ftps_upload_command }
import gunbc.fleet_asset_identity { printer_01 }
import gunbc.auth.netrc_binding {
  NetrcPlacement, NetrcBindingPlaced, NetrcBindingRefused, NetrcBindingRefusedResidueRemains,
  netrc_write_refusal,
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE FIXTURE IS A DIGEST, NOT A PAYLOAD, because IdentifiedProjectPayload is sole_constructor and a
// witness that could forge one would be testing the very thing the seal exists to prevent.
fn probe_name(hex: NonEmptyStr) -> NonEmptyStr {
  remote_name_for_digest(content: sha256_digest(hex: hex))
}

// THE PORT IS DERIVED FROM THE NEGOTIATION, BOTH WAYS. A comparison answering one way for every
// input satisfies either half alone. Pairing them is what catches an implicit endpoint pinned to 21,
// which connects and then stalls with a diagnostic that blames nothing.
test fn w_the_ftps_port_follows_the_negotiation_in_both_directions() -> Bool {
  ftps_default_port(negotiation: FtpsImplicit) == 990
  && ftps_default_port(negotiation: FtpsExplicit) == 21
}

// AND VERIFICATION IS A DECISION, NOT A DEFAULT. If this ever reads false for FtpsVerifyPeer, a
// weakening authored for ONE enumerated peer class has escaped to every endpoint. The device is not
// self-signed -- it presents a BBL CA chain, measured -- and the waiver is narrower than "the cert
// is bad": it exists because the subject names the serial rather than the dialed address.
test fn w_peer_verification_is_waived_only_by_the_enumerated_peer_class() -> Bool {
  ftps_verifies_peer(v: FtpsVerifyPeer)
  && ftps_verifies_peer(
       v: FtpsPeerVerificationDisabled { peer: DeviceCertificateSubjectIsSerialNotAddress }
     ) == false
}

// THE REMOTE NAME IS THE CONTENT, so two different projects cannot land on one remote filename and
// silently overwrite whichever print was queued first. Equal bytes SHOULD collide -- that overwrite
// is a no-op -- so the witness asserts both directions rather than only distinctness.
test fn w_the_remote_name_distinguishes_content_and_only_content() -> Bool {
  (probe_name(hex: "aa11") as String) != (probe_name(hex: "bb22") as String)
  && (probe_name(hex: "aa11") as String) == (probe_name(hex: "aa11") as String)
}

// THE LOCAL FILENAME NEVER REACHES THE WIRE. curl appends the local basename when a URL ends in a
// slash, so a URL that did not spell the remote name would silently name the file after whatever the
// local path happened to be -- and the local path here is deliberately misleading in the fixture.
test fn w_the_upload_url_carries_the_derived_name_not_the_local_one() -> Bool {
  let url = ftps_upload_url(
    endpoint: bambu_lan_endpoint(host: "printer.invalid"),
    remote_name: probe_name(hex: "aa11"),
  )
  url == "ftps://printer.invalid:990/gunbc-aa11.3mf"
  && any(argv_words(command: probe_command()), a => a == url)
}

// THE TRANSFER CANNOT DEGRADE TO CLEARTEXT, IN EITHER OF THE TWO WAYS CURL OFFERS. --ssl merely
// PREFERS TLS and exits 0 after proceeding in the clear when the server declines. --ftp-ssl-control
// is the subtler one: it encrypts the LOGIN and leaves the DATA connection clear, so the access code
// is protected and the file is not -- a form that would pass any check looking only for "some TLS
// flag". This asserts the required form is present and BOTH permissive forms are absent, because a
// builder emitting one of each would satisfy a one-sided check.
test fn w_the_upload_requires_tls_rather_than_preferring_it() -> Bool {
  let argv = argv_words(command: probe_command())
  any(argv, a => a == "--ssl-reqd")
  && any(argv, a => a == "--ssl") == false
  && any(argv, a => a == "--ftp-ssl-control") == false
}

// THE CREDENTIAL REACHES CURL AS A BINDING, NEVER AS AN ARGUMENT. This is the enrolled control for
// gunbc.credential_argv_exposure at this call site: on this fleet /proc has no hidepid and
// /proc/PID/cmdline is 0444, so a --user word is readable by any job payload on a runner slot. The
// witness asserts the netrc form is present AND that curl's two argv-borne credential flags are
// absent -- an assertion that stays authorable, and would go red the moment someone "fixed" an auth
// failure by adding --user back to the builder.
test fn w_no_credential_is_ever_spelled_into_the_upload_argv() -> Bool {
  let argv = argv_words(command: probe_command())
  any(argv, a => a == "--netrc-file")
  && any(argv, a => a == "--user") == false
  && any(argv, a => a == "-u") == false
}

// THE LOCAL PATH IN THE FIXTURE IS DELIBERATELY MISLEADING: curl appends the local basename when a
// URL ends in a slash, so a builder that failed to spell the remote name would name the remote file
// after this, and the url witness would catch it.
// THE WITNESS CAN NO LONGER FORGE THE BINDING, WHICH IS THE POINT. It used to call
// upload_command_for with a fixture path it had never placed -- which was the live demonstration
// that the seal did not hold at that boundary. upload_command_for now requires a NetrcBinding, and
// NetrcBinding is sole_constructor, so this fixture cannot supply one. It therefore drops to the
// curl syntax helper, which is FilePath-parametric on purpose and is NOT where the credential
// guarantee lives. The argv shape assertions below are unchanged and still run against the same URL
// builder; what is gone is a witness that could spell a state production can no longer reach.
fn probe_command() -> ArgvCommand {
  curl_ftps_upload_command(
    url: ftps_upload_url(
      endpoint: bambu_lan_endpoint(host: "printer.invalid"),
      remote_name: probe_name(hex: "aa11")),
    local_path: "/tmp/whatever-the-local-file-is-called.3mf",
    netrc_path: "/tmp/a-fixture-netrc-that-is-never-created" as FilePath,
    skip_verification: true,
  )
}

// A FAILED TRANSFER AND A FAILED TRANSFER THAT LEFT THE ACCESS CODE ON DISK ARE NOT ONE OUTCOME.
// Both arms were reachable before this pair existed; only one was spellable, because the refused
// path computed the shred result and dropped it. The two remedies differ -- a plain refusal may be
// retried, a residue refusal must send someone to look at the disk first -- so a witness asserting
// only that "a refusal is returned" would stay green through exactly the collapse this prevents.
// Hence the pair: same stderr, cleanliness the ONLY variable, and each arm must reject the other's
// answer. Holding stderr fixed is what makes cleanliness the discriminator rather than the message.
test fn a_clean_failed_transfer_is_not_reported_as_leaving_residue() -> Bool {
  match refused_delivery(printer: printer_01, stderr: "connection reset", cleaned: true) {
    ProjectDeliveryRefused { printer: _, cause: _ } => true
    ProjectDeliveryRefusedResidueRemains { printer: _, cause: _ } => false
    ProjectDelivered { receipt: _ } => false
    ProjectDeliveryUnattempted { printer: _, cause: _ } => false
    ProjectTransferredCleanupRefused { receipt: _, cause: _ } => false
    ProjectDeliveryProvisionRequired { printer: _, desired: _ } => false
    ProjectDeliveryUnattemptedResidueRemains { printer: _, cause: _ } => false
    ProjectDeliveryProvisionRequiredResidueRemains { printer: _, desired: _, cause: _ } => false
  }
}

test fn a_failed_transfer_whose_shred_also_failed_names_the_residue() -> Bool {
  match refused_delivery(printer: printer_01, stderr: "connection reset", cleaned: false) {
    ProjectDeliveryRefusedResidueRemains { printer: _, cause: _ } => true
    ProjectDeliveryRefused { printer: _, cause: _ } => false
    ProjectDelivered { receipt: _ } => false
    ProjectDeliveryUnattempted { printer: _, cause: _ } => false
    ProjectTransferredCleanupRefused { receipt: _, cause: _ } => false
    ProjectDeliveryProvisionRequired { printer: _, desired: _ } => false
    ProjectDeliveryUnattemptedResidueRemains { printer: _, cause: _ } => false
    ProjectDeliveryProvisionRequiredResidueRemains { printer: _, desired: _, cause: _ } => false
  }
}

// A PAYLOAD COPY THAT SURVIVED A REFUSAL IS NOT SPELLED LIKE ONE THAT DID NOT. refuse_and_drop bound
// its removal result to `_`, so an abandoned delivery that left a 226915-byte copy in /tmp returned
// the identical value as one that cleaned up -- and that is the path most likely to leave residue,
// because it runs before any transfer is attempted. Same cause text in both arms below, removal
// success the ONLY variable, so a collapse cannot hide behind a differing message.
test fn an_unattempted_delivery_that_cleaned_up_is_not_reported_as_leaving_residue() -> Bool {
  match unattempted_delivery(printer: printer_01, cause: "no locus", removed: true) {
    ProjectDeliveryUnattempted { printer: _, cause: _ } => true
    ProjectDeliveryUnattemptedResidueRemains { printer: _, cause: _ } => false
    ProjectDelivered { receipt: _ } => false
    ProjectDeliveryRefused { printer: _, cause: _ } => false
    ProjectDeliveryRefusedResidueRemains { printer: _, cause: _ } => false
    ProjectTransferredCleanupRefused { receipt: _, cause: _ } => false
    ProjectDeliveryProvisionRequired { printer: _, desired: _ } => false
    ProjectDeliveryProvisionRequiredResidueRemains { printer: _, desired: _, cause: _ } => false
  }
}

test fn an_unattempted_delivery_whose_removal_failed_names_the_residue() -> Bool {
  match unattempted_delivery(printer: printer_01, cause: "no locus", removed: false) {
    ProjectDeliveryUnattemptedResidueRemains { printer: _, cause: _ } => true
    ProjectDeliveryUnattempted { printer: _, cause: _ } => false
    ProjectDelivered { receipt: _ } => false
    ProjectDeliveryRefused { printer: _, cause: _ } => false
    ProjectDeliveryRefusedResidueRemains { printer: _, cause: _ } => false
    ProjectTransferredCleanupRefused { receipt: _, cause: _ } => false
    ProjectDeliveryProvisionRequired { printer: _, desired: _ } => false
    ProjectDeliveryProvisionRequiredResidueRemains { printer: _, desired: _, cause: _ } => false
  }
}

// IDENTIFICATION REFUSES AFTER IT HAS ALREADY COPIED SOMETHING, so its refusal has to say whether
// the copy is still there. Both arms below refuse for the SAME reason; the only difference is
// whether the workspace removal succeeded, which is what the caller needs in order to know if
// a human has to go look. Removal success is passed as the discriminating input rather than being
// provoked through the shell: rm -rf exits 0 on a MISSING path even under an unwritable parent, so
// the obvious fixture would have been green while asserting nothing at all.
test fn an_identification_refusal_that_cleaned_up_is_not_reported_as_leaving_residue() -> Bool {
  match identification_refusal(
    local_path: "/tmp/does-not-exist.3mf",
    workspace: "/tmp/print-n-witness-workspace" as FilePath,
    cause: "the copied realization could not be read, so its content identity was never observed",
    removed: true
  ) {
    PayloadIdentificationRefused { local_path: _, cause: _ } => true
    PayloadIdentificationRefusedResidueRemains { local_path: _, residue_path: _, cause: _ } => false
    PayloadIdentified { payload: _ } => false
  }
}

test fn an_identification_refusal_whose_workspace_survived_names_the_path() -> Bool {
  match identification_refusal(
    local_path: "/tmp/does-not-exist.3mf",
    workspace: "/tmp/print-n-witness-workspace" as FilePath,
    cause: "the copied realization could not be read, so its content identity was never observed",
    removed: false
  ) {
    PayloadIdentificationRefusedResidueRemains { local_path: _, residue_path: rp, cause: _ } =>
      (rp as String) == "/tmp/print-n-witness-workspace"
    PayloadIdentificationRefused { local_path: _, cause: _ } => false
    PayloadIdentified { payload: _ } => false
  }
}

// A NETRC WRITE THAT FAILED IS NOT EVIDENCE THAT NOTHING WAS WRITTEN. WriteOwnerOnly reports only
// success, so a write that died partway leaves an owner-only file holding a prefix of the netrc --
// and the credential is the LAST field on that line, so a truncated one is the likely shape. The
// old refusal asserted "no credential was placed", a claim about the disk the return value could
// not support. Three arms, because the two ways of leaving material behind have different stories:
// a partial write we could not clean, and a pre-existing file we never owned.
//
// THE SECOND WITNESS ASSERTS THE ABSENCE OF THE PATH, not its value. It used to compare the
// rendered locus against the fixture path -- which was the defect wearing the costume of coverage:
// a green witness whose green MEANT a credential-bearing path had reached a printable string. The
// outcome carries NO locator at all now -- not a sealed one, which was an earlier repair that did
// not hold -- so the property worth holding is that the cause carries the FACT and cannot carry the
// location.
test fn a_netrc_write_failure_that_cleaned_up_reports_no_credential_on_disk() -> Bool {
  match netrc_write_refusal(
    path: "/tmp/print-n-witness-netrc" as FilePath,
    cleared_before_write: true, removed_after_failure: true
  ) {
    NetrcBindingRefused { cause: _ } => true
    NetrcBindingRefusedResidueRemains { cause: _ } => false
    NetrcBindingPlaced { binding: _ } => false
  }
}

test fn a_netrc_partial_write_that_survived_removal_states_the_fact_without_the_path() -> Bool {
  match netrc_write_refusal(
    path: "/tmp/print-n-witness-netrc" as FilePath,
    cleared_before_write: true, removed_after_failure: false
  ) {
    NetrcBindingRefusedResidueRemains { cause: c } =>
      (c as String).contains("may remain") && (c as String).contains("/tmp/") == false
    NetrcBindingRefused { cause: _ } => false
    NetrcBindingPlaced { binding: _ } => false
  }
}

test fn a_netrc_path_that_was_never_ours_is_not_reported_as_our_partial_write() -> Bool {
  match netrc_write_refusal(
    path: "/tmp/print-n-witness-netrc" as FilePath,
    cleared_before_write: false, removed_after_failure: false
  ) {
    NetrcBindingRefusedResidueRemains { cause: c } =>
      (c as String).contains("unknown origin")
    NetrcBindingRefused { cause: _ } => false
    NetrcBindingPlaced { binding: _ } => false
  }
}

// THE SCHEME AND THE PORT MUST MOVE TOGETHER, and asserting either alone passes while the pair is
// wrong. curl reads ftps:// as implicit TLS from the first byte and ftp:// + --ssl-reqd as an
// explicit upgrade, so an explicit endpoint emitted as ftps://host:21 is implicit TLS aimed at the
// explicit port -- a connection that hangs or resets with a diagnostic blaming neither. The port
// half was already derived and the scheme half was hardcoded "ftps://", so this witness is the one
// that would have been red the whole time.
test fn the_ftps_scheme_follows_the_negotiation_in_both_directions() -> Bool {
  ftps_scheme(negotiation: FtpsImplicit) == "ftps://"
    && ftps_scheme(negotiation: FtpsExplicit) == "ftp://"
    && ftps_scheme(negotiation: FtpsImplicit) != ftps_scheme(negotiation: FtpsExplicit)
}

test fn an_explicit_endpoint_is_never_emitted_as_an_implicit_url() -> Bool {
  let explicit = ftps_endpoint(
    host: "printer.invalid",
    negotiation: FtpsExplicit,
    verification: FtpsPeerVerificationDisabled { peer: DeviceCertificateSubjectIsSerialNotAddress },
  )
  let url = ftps_upload_url(endpoint: explicit, remote_name: probe_name(hex: "aa11"))
  url.contains("ftp://printer.invalid:21/") && url.contains("ftps://") == false
}
