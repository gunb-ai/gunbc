module test.claim.fleet.managed_principal_provider_witness_test

import std.types { Bool, List, NonEmptyStr, String }
import std.nat { Nat }
import extdeps.ssh { SshPublicKey, ssh_public_key_line }
import gunbc.fleet_ssh_access { fleet_automation_ssh_key }
import std.realization_dependency {
  CapabilityRequirement, requirement_key,
  CapabilityProvider,
  DependencyClosureStanding, DependencyClosureResolved,
  RequirementWithoutProvider, RequirementWithMultipleProviders, DependencyCycle,
  resolve_dependency_closure,
  ProviderExecutionStanding, ProviderScheduleExecutable, ProviderHandlerMissing,
}
import gunbc.managed_principal_session {
  FleetCredentialIdentity, fleet_declared_credential_identity, fleet_credential_identity,
  PosixAccountReadback, AuthorizedKeyReadback,
  ManagedPosixAccountReady, ManagedAuthorizedKeyReady,
  managed_principal_providers, principal_session_requirement, membership_requirement,
}
import gunbc.managed_principal_provider {
  ManagedProviderKind,
  BootstrapAdministratorSessionProvider, FleetPrivateKeyBindingProvider,
  ManagedAccountProvider, ManagedAuthorizedKeyProvider,
  ManagedMembershipProvider, ManagedPrincipalSessionProvider,
  managed_provider_kind_label, managed_provider_has_handler, managed_provider_kind_of,
  provider_row_has_handler, admit_managed_schedule,
  ManagedProviderOutcome, ProviderRealized, ProviderRefused, ProviderUnattempted,
  provider_outcome_kind, provider_outcome_realized, provider_outcome_label,
  AccountProviderTerminal, realize_managed_account,
  KeyProviderTerminal, realize_managed_authorized_key,
}

data w_host: NonEmptyStr = "192.168.1.225" as NonEmptyStr
data w_principal: NonEmptyStr = "gunbc-automation" as NonEmptyStr
data w_admin: NonEmptyStr = "briansrls" as NonEmptyStr
data w_group: NonEmptyStr = "docker" as NonEmptyStr

fn w_declared() -> FleetCredentialIdentity { fleet_declared_credential_identity() }

fn w_good_account_readback() -> PosixAccountReadback {
  PosixAccountReadback {
    observed_principal: w_principal,
    observed_home: "/home/gunbc-automation" as NonEmptyStr,
    observed_shell: "/bin/bash" as NonEmptyStr,
    instrument: "getent passwd after creation" as NonEmptyStr,
  }
}

fn w_unread_account_readback() -> PosixAccountReadback {
  PosixAccountReadback {
    observed_principal: "<unread>" as NonEmptyStr,
    observed_home: "<unread>" as NonEmptyStr,
    observed_shell: "<unread>" as NonEmptyStr,
    instrument: "the script produced no parseable readback" as NonEmptyStr,
  }
}

fn w_key_readback(line: String, owner: String, mode: String) -> AuthorizedKeyReadback {
  AuthorizedKeyReadback {
    observed_line: line as NonEmptyStr,
    observed_owner: owner as NonEmptyStr,
    observed_mode: mode as NonEmptyStr,
    instrument: "grep and stat after the install" as NonEmptyStr,
  }
}

fn w_good_key_readback() -> AuthorizedKeyReadback {
  w_key_readback(line: ssh_public_key_line(k: fleet_automation_ssh_key), owner: "gunbc-automation", mode: "600")
}

fn w_account_terminal(bootstrap_realized: Bool, apply_succeeded: Bool, readback: PosixAccountReadback) -> AccountProviderTerminal {
  realize_managed_account(
    host: w_host, principal: w_principal,
    bootstrap_realized: bootstrap_realized,
    apply_succeeded: apply_succeeded,
    apply_detail: "the account script exited non-zero" as NonEmptyStr,
    readback: readback,
  )
}

fn w_key_terminal(account: AccountProviderTerminal, apply_succeeded: Bool, readback: AuthorizedKeyReadback) -> KeyProviderTerminal {
  realize_managed_authorized_key(
    account_ready: account.ready,
    credential: w_declared(),
    expected_key: fleet_automation_ssh_key,
    apply_succeeded: apply_succeeded,
    apply_detail: "the key script exited non-zero" as NonEmptyStr,
    readback: readback,
  )
}

// ── THE POSITIVE CHAIN, WITHOUT WHICH EVERY UNATTEMPTED ROW PASSES VACUOUSLY ───────────────────
test fn an_observed_account_and_an_observed_key_both_realize() -> Bool {
  let account = w_account_terminal(bootstrap_realized: true, apply_succeeded: true, readback: w_good_account_readback())
  let key = w_key_terminal(account: account, apply_succeeded: true, readback: w_good_key_readback())
  provider_outcome_realized(o: account.outcome) && provider_outcome_realized(o: key.outcome)
}

// ── CONTROL 5: A FAILED ACCOUNT LEAVES THE KEY UNATTEMPTED, NOT FAILED ────────────────────────
//
// THE ROW THE OLD APPLY COULD NOT PRODUCE. Four legs evaluated and aggregated meant a refused account creation
// still ran the key install, which then reported ITS OWN failure -- so one cause surfaced as two findings and a
// reader saw a host broken in two ways.
test fn a_refused_account_leaves_the_key_provider_unattempted() -> Bool {
  let account = w_account_terminal(bootstrap_realized: true, apply_succeeded: false, readback: w_unread_account_readback())
  let key = w_key_terminal(account: account, apply_succeeded: true, readback: w_good_key_readback())
  match key.outcome {
    ProviderUnattempted { kind: k, blocked_by: b } =>
      match b {
        ManagedAccountProvider => true
        BootstrapAdministratorSessionProvider => false
        FleetPrivateKeyBindingProvider => false
        ManagedAuthorizedKeyProvider => false
        ManagedMembershipProvider => false
        ManagedPrincipalSessionProvider => false
      }
    ProviderRealized { kind: _, detail: _ } => false
    ProviderRefused { kind: _, cause: _ } => false
  }
}

// AND THE KEY PROVIDER PRODUCES NO HANDLE, which is what makes the next link unattemptable in turn rather than
// merely advised against.
test fn a_refused_account_leaves_the_key_handle_absent() -> Bool {
  let account = w_account_terminal(bootstrap_realized: true, apply_succeeded: false, readback: w_unread_account_readback())
  let key = w_key_terminal(account: account, apply_succeeded: true, readback: w_good_key_readback())
  match key.ready {
    Absent => true
    Present { value: _ } => false
  }
}

// AND AN UNREALIZED BOOTSTRAP SESSION LEAVES THE ACCOUNT UNATTEMPTED, so the chain's first edge is structural
// too rather than assumed by the order the wet route happens to call things in.
test fn an_unrealized_bootstrap_leaves_the_account_unattempted() -> Bool {
  let account = w_account_terminal(bootstrap_realized: false, apply_succeeded: true, readback: w_good_account_readback())
  match account.outcome {
    ProviderUnattempted { kind: _, blocked_by: b } =>
      match b {
        BootstrapAdministratorSessionProvider => true
        FleetPrivateKeyBindingProvider => false
        ManagedAccountProvider => false
        ManagedAuthorizedKeyProvider => false
        ManagedMembershipProvider => false
        ManagedPrincipalSessionProvider => false
      }
    ProviderRealized { kind: _, detail: _ } => false
    ProviderRefused { kind: _, cause: _ } => false
  }
}

// ── CONTROL 6: THE WRITE SUCCEEDED AND THE READBACK DISAGREES ─────────────────────────────────
//
// THE CASE `grep -c .` REPORTED AS CONVERGED. The install exits zero having appended the line; the file is
// group-writable, so sshd ignores it and the key authenticates nothing. The write and the readback are separate
// facts and only the second produces a handle.
test fn a_successful_write_with_a_group_writable_file_refuses_and_mints_nothing() -> Bool {
  let account = w_account_terminal(bootstrap_realized: true, apply_succeeded: true, readback: w_good_account_readback())
  let key = w_key_terminal(
    account: account, apply_succeeded: true,
    readback: w_key_readback(line: ssh_public_key_line(k: fleet_automation_ssh_key), owner: "gunbc-automation", mode: "660"),
  )
  match key.outcome {
    ProviderRefused { kind: _, cause: c } => string_contains(s: c as String, pattern: "cannot authenticate")
    ProviderRealized { kind: _, detail: _ } => false
    ProviderUnattempted { kind: _, blocked_by: _ } => false
  }
}

// AND A SUCCESSFUL WRITE WHOSE LINE IS SOMEBODY ELSE'S KEY IS ALSO A REFUSAL, with the write's own success
// named in the cause so a reader is not sent looking for a failed command.
test fn a_successful_write_of_the_wrong_line_refuses() -> Bool {
  let account = w_account_terminal(bootstrap_realized: true, apply_succeeded: true, readback: w_good_account_readback())
  let key = w_key_terminal(
    account: account, apply_succeeded: true,
    readback: w_key_readback(line: "ssh-ed25519 AAAASOMEONEELSE other@host", owner: "gunbc-automation", mode: "600"),
  )
  match key.outcome {
    ProviderRefused { kind: _, cause: c } => string_contains(s: c as String, pattern: "the write succeeded")
    ProviderRealized { kind: _, detail: _ } => false
    ProviderUnattempted { kind: _, blocked_by: _ } => false
  }
}

// AND AN UNPARSEABLE READBACK AFTER A SUCCESSFUL ACCOUNT SCRIPT IS A REFUSAL, because the sentinel cannot pass
// the admission -- which is the point of a located sentinel rather than an empty string.
test fn a_successful_account_script_with_an_unread_readback_refuses() -> Bool {
  let account = w_account_terminal(bootstrap_realized: true, apply_succeeded: true, readback: w_unread_account_readback())
  match account.outcome {
    ProviderRefused { kind: _, cause: c } => string_contains(s: c as String, pattern: "readback disagrees")
    ProviderRealized { kind: _, detail: _ } => false
    ProviderUnattempted { kind: _, blocked_by: _ } => false
  }
}

// ── CONTROL 4 AT THE DOMAIN GRAIN: THE MEMBERSHIP PROVIDER HAS NO HANDLER TODAY ───────────────
//
// THE ROW THAT KEEPS STANDING TWO FROM BEING DECORATIVE. Nothing in this repository upserts a supplementary
// group, so a graph that requires one RESOLVES and is NOT executable -- and this asserts the honest answer
// rather than a blanket yes. When a membership upsert with its own readback lands, this row flips and the
// dissolution is visible.
test fn the_membership_provider_reports_no_handler() -> Bool {
  !managed_provider_has_handler(k: ManagedMembershipProvider)
}

test fn every_other_provider_reports_a_handler() -> Bool {
  managed_provider_has_handler(k: BootstrapAdministratorSessionProvider)
    && managed_provider_has_handler(k: FleetPrivateKeyBindingProvider)
    && managed_provider_has_handler(k: ManagedAccountProvider)
    && managed_provider_has_handler(k: ManagedAuthorizedKeyProvider)
    && managed_provider_has_handler(k: ManagedPrincipalSessionProvider)
}

// SO A GRAPH REQUIRING A MEMBERSHIP RESOLVES AND IS REFUSED EXECUTION, naming the provider that cannot run.
// This is the two standings visibly separate on one subject.
test fn a_graph_requiring_a_membership_resolves_but_is_not_executable() -> Bool {
  let standing = resolve_dependency_closure(
    providers: managed_principal_providers(host: w_host, principal: w_principal, admin_principal: w_admin, credential: w_declared(), required_groups: [w_group]),
    roots: [principal_session_requirement(host: w_host, principal: w_principal, credential: w_declared())],
  )
  match standing {
    DependencyClosureResolved { bindings: _, batches: _ } =>
      match admit_managed_schedule(standing: standing) {
        Present { value: e } =>
          match e {
            ProviderHandlerMissing { provider_identity: id, requirement_key: _ } =>
              string_contains(s: id as String, pattern: "managed-membership-upsert")
            ProviderScheduleExecutable { batches: _, provider_identities: _ } => false
          }
        Absent => false
      }
    RequirementWithoutProvider { requirement: _, demanded_by: _ } => false
    RequirementWithMultipleProviders { requirement: _, provider_identities: _ } => false
    DependencyCycle { unresolved_keys: _ } => false
  }
}

// AND THE SAME GRAPH WITHOUT A MEMBERSHIP IS EXECUTABLE, so the row above is not passing because the schedule
// admission refuses everything.
test fn the_same_graph_without_a_membership_is_executable() -> Bool {
  let standing = resolve_dependency_closure(
    providers: managed_principal_providers(host: w_host, principal: w_principal, admin_principal: w_admin, credential: w_declared(), required_groups: []),
    roots: [principal_session_requirement(host: w_host, principal: w_principal, credential: w_declared())],
  )
  match admit_managed_schedule(standing: standing) {
    Present { value: e } =>
      match e {
        ProviderScheduleExecutable { batches: b, provider_identities: ids } => count(b) == 4 && count(ids) == 5
        ProviderHandlerMissing { provider_identity: _, requirement_key: _ } => false
      }
    Absent => false
  }
}

// ── AN UNRECOGNISED PROVIDER ROW HAS NO HANDLER, WHICH KEEPS THE WALL FAIL-CLOSED ─────────────
//
// A provider authored elsewhere must not borrow executability from the fact that this module has never seen its
// name. This is the arm that would otherwise let a foreign row into a schedule this executor cannot run.
test fn an_unrecognised_provider_identity_has_no_kind_and_no_handler() -> Bool {
  match managed_provider_kind_of(provider_identity: "some-provider-nobody-modelled" as NonEmptyStr) {
    Absent => true
    Present { value: _ } => false
  }
}

// AND THE RECEIPT LABEL DISTINGUISHES THE THREE OUTCOMES, because the receipt is what a person reads and
// "REFUSED" on a leg that never ran is how one cause becomes several findings.
test fn the_unattempted_label_names_the_blocking_provider_rather_than_itself() -> Bool {
  let account = w_account_terminal(bootstrap_realized: true, apply_succeeded: false, readback: w_unread_account_readback())
  let key = w_key_terminal(account: account, apply_succeeded: true, readback: w_good_key_readback())
  let label = provider_outcome_label(o: key.outcome)
  string_contains(s: label, pattern: "unattempted")
    && string_contains(s: label, pattern: "managed-posix-account-upsert")
    && !string_contains(s: label, pattern: "REFUSED")
}
