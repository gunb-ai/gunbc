module test.claim.org_actions_standing_witness

import std.types { Bool, Int, NonEmptyStr, List }
import gunbc.fleet.org_actions_standing {
  desired_repo_access, ObservedGroupAccess, observed_admits, OrgActionsGoal, RepoRunnerAccess,
  OrgActionsAgreement, OrgActionsDeviation, RepoAdmissionDiverges, RepoPublicExposureDiverges,
  desired_org_actions_goal, assess_org_actions,
}
import v2.std.cardinality { Never }
import v2.std.algebra { non_empty_to_list }
import std.goal_assessment { GoalAssessment, GoalSatisfied, GoalDiverged }

data grp_private_closed: ObservedGroupAccess = ObservedGroupAccess {
  group_name: "default",
  allows_public_repositories: false,
  repositories: ["gunb-ai/gunbc-private"],
}

data grp_private_open: ObservedGroupAccess = ObservedGroupAccess {
  group_name: "default",
  allows_public_repositories: true,
  repositories: ["gunb-ai/gunbc-private"],
}

data grp_other_open: ObservedGroupAccess = ObservedGroupAccess {
  group_name: "sandbox",
  allows_public_repositories: true,
  repositories: ["gunb-ai/some-other-repo"],
}

test fn witness_desired_rows_demand_fleet_reach() -> Bool {
  fold(desired_repo_access, init: true, f: fn(acc, r) { acc && r.must_reach_fleet })
    && observed_admits(groups: [grp_private_closed], repository: "gunb-ai/gunbc-private")
    && !observed_admits(groups: [grp_private_closed], repository: "gunb-ai/gunbc")
}

// THE ASSESSMENT BOUND TO std.goal_assessment. Each claim supplies group rows at the assessor's
// interface and asserts the ARM and the located deviation, not a count: the diff this replaced
// reported two integers, so a repository could drift and the verdict could not say which.
fn admission_diverges_for(a: GoalAssessment<OrgActionsAgreement, OrgActionsDeviation, Never, Never>, repository: NonEmptyStr) -> Bool {
  match a {
    GoalDiverged { deviations } => any(non_empty_to_list(xs: deviations), d => match d {
      RepoAdmissionDiverges { repository: r, observed_admitted: seen, desired: wanted } => r == repository && !seen && wanted
      _ => false
    })
    _ => false
  }
}

fn exposure_diverges_for(a: GoalAssessment<OrgActionsAgreement, OrgActionsDeviation, Never, Never>, repository: NonEmptyStr) -> Bool {
  match a {
    GoalDiverged { deviations } => any(non_empty_to_list(xs: deviations), d => match d {
      RepoPublicExposureDiverges { repository: r, exposing_groups } => r == repository && count(exposing_groups) == 1
      _ => false
    })
    _ => false
  }
}

data grp_both_closed: ObservedGroupAccess = ObservedGroupAccess {
  group_name: "fleet",
  allows_public_repositories: false,
  repositories: ["gunb-ai/gunbc", "gunb-ai/gunbc-private"],
}

test fn witness_assessment_satisfied_when_every_desired_repo_is_admitted_privately() -> Bool {
  match assess_org_actions(goal: desired_org_actions_goal, observed: [grp_both_closed]) {
    GoalSatisfied { evidence } => evidence.repositories_checked == count(desired_repo_access)
    _ => false
  }
}

test fn witness_assessment_names_the_unadmitted_and_the_exposed_repository() -> Bool {
  let a = assess_org_actions(goal: desired_org_actions_goal, observed: [grp_private_open])
  admission_diverges_for(a: a, repository: "gunb-ai/gunbc")
    && exposure_diverges_for(a: a, repository: "gunb-ai/gunbc-private")
    && !admission_diverges_for(a: a, repository: "gunb-ai/gunbc-private")
}

// An organization with no runner groups is an established empty list, and the assessor must
// convict every must-reach row rather than read nothing as agreement.
test fn witness_assessment_of_no_groups_diverges_rather_than_agrees() -> Bool {
  let a = assess_org_actions(goal: desired_org_actions_goal, observed: [])
  admission_diverges_for(a: a, repository: "gunb-ai/gunbc")
    && admission_diverges_for(a: a, repository: "gunb-ai/gunbc-private")
}

// Public exposure is convicted only by a group that ADMITS the repository (review 57611): a
// public-allowing group serving some other repository can neither convict nor acquit.
test fn witness_exposure_is_convicted_only_by_the_serving_group() -> Bool {
  let a = assess_org_actions(goal: desired_org_actions_goal, observed: [grp_private_closed, grp_other_open])
  !exposure_diverges_for(a: a, repository: "gunb-ai/gunbc-private")
    && admission_diverges_for(a: a, repository: "gunb-ai/gunbc")
}

// The other direction of the comparison (review 57611): a row FORBIDDING fleet reach that is
// observed admitted anyway diverges, and is never read as holding merely because it is admitted.
test fn witness_forbidden_row_admitted_anyway_diverges() -> Bool {
  let goal = OrgActionsGoal {
    access: [RepoRunnerAccess { repository: "gunb-ai/gunbc-private", must_reach_fleet: false, reason: "probe: forbidden-access row" }],
    allows_public_repositories: false,
  }
  match assess_org_actions(goal: goal, observed: [grp_private_closed]) {
    GoalDiverged { deviations } => any(non_empty_to_list(xs: deviations), d => match d {
      RepoAdmissionDiverges { repository: r, observed_admitted: seen, desired: wanted } => r == "gunb-ai/gunbc-private" && seen && !wanted
      _ => false
    })
    _ => false
  }
}
