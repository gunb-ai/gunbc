import std.list { first_duplicate_by_key }
import extdeps.dhcp.v4 { Active, StaticDhcpReservation }
import extdeps.network.ipv4 { ipv4_address }
import extdeps.network.mac { mac_address, mac_addresses_are_equal }
import gunbc.fleet.fleet_asset_identity { printer_01, printer_02 }
import gunbc.fleet.fleet_host_identity {
  operator_host_srv10, operator_host_srv11, operator_host_srv9, operator_host_e2d4b7,
}
import gunbc.fleet.fleet_intent_network {
  fleet_intent_network, host_lan_address, ken_host_lan_endpoint, operator_lan_gateway_endpoint, printer_01_lan_endpoint, printer_01_lan_reservation, printer_02_lan_endpoint, printer_02_lan_reservation, srv1_bmc_endpoint, srv1_host_lan_endpoint, srv1_tailscale_endpoint, srv2_bmc_endpoint, srv2_host_lan_endpoint, srv2_tailscale_endpoint, srv3_bmc_endpoint, srv3_host_lan_endpoint, srv4_bmc_endpoint, srv4_host_lan_endpoint,
}
