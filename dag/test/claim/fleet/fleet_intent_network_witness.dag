}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn fleet_intent_network_container_to_bmc_allowed() -> Bool {
  network_reachability(from: ContainerRunner, to: BmcManagement)
}

test fn fleet_intent_network_container_to_host_lan_denied() -> Bool {
  network_reachability(from: ContainerRunner, to: HostLan) == false
}

// THE COUNT ORACLE IS REPLACED, NOT BUMPED, AND THAT IS THE POINT OF THIS EDIT (DCH-0, 2026-09-02).
// The row here read `list_length(items: fleet_intent_network.endpoints) == 11`. Enrolling srv5/srv6
// turns it red at 11 -> 13, and the tempting repair -- editing the literal to 13 -- is the change
// detector gunbc.design_argument::fail_closed names in terms: a measurement copied from the same current tree is not an
// oracle, and automating the literal's update collapses the assertion to `measure() == measure()`.
// A count also cannot distinguish "every expected endpoint is present" from "some other endpoint
// answered instead": it stays green under any substitution of one row for another, which is exactly
// the fabrication the per-host address rows below were originally written to catch and which the count could
// not see.
//
// So completeness is asserted as an IDENTITY JOIN over the endpoint labels, in both directions and
// with duplicates refused, against the roster of rows this module declares by name. This is the same
// shape gunbc.spark.serving_observation_scope `spark_observation_coverage` already uses for
// observation coverage, and it is deliberately the same shape rather than a second one -- missing
// and foreign are different defects (an endpoint dropped from the list versus an endpoint in the
// list that no named row declares), so the join is read in both directions rather than as one count.
//
// THE RESIDUAL, STATED RATHER THAN IMPLIED. The expected roster below is AUTHORED, not discovered:
// a NetworkEndpoint declared in gunbc.fleet.fleet_intent_network and added to neither this roster nor the
// topology list is invisible to this witness. Closing that needs the subject universe discovered
// from the module's own declarations -- a lens over the Node tree, not something a claim witness can
// express -- so that lens is this row's next-rung trigger. What the join does buy over the count is
// exact: every named row must be reachable in the topology, and every topology member must be a
// named row, each exactly once.

fn topology_endpoint_labels(items: List<NetworkEndpoint>) -> List<String> {
  map(items, e => e.label)
}

fn topology_label_multiplicity(labels: List<String>, needle: String) -> Int {
  length(filter(labels, l => l == needle))
}

fn topology_labels_missing(expected: List<String>, actual: List<String>) -> List<String> {
  filter(expected, e => topology_label_multiplicity(labels: actual, needle: e) == 0)
}

fn topology_labels_duplicated(labels: List<String>) -> List<String> {
  filter(labels, l => topology_label_multiplicity(labels: labels, needle: l) > 1)
}

data declared_topology_endpoints: List<NetworkEndpoint> = [
  operator_lan_gateway_endpoint,
  srv1_host_lan_endpoint,
  srv2_host_lan_endpoint,
  srv3_host_lan_endpoint,
  srv4_host_lan_endpoint,
  srv14_host_lan_endpoint,
  ken_host_lan_endpoint,
  srv1_bmc_endpoint,
  srv2_bmc_endpoint,
  srv3_bmc_endpoint,
  srv4_bmc_endpoint,
  srv14_bmc_endpoint,
  srv1_tailscale_endpoint,
  srv2_tailscale_endpoint,
  printer_01_lan_endpoint,
  printer_02_lan_endpoint,
]

test fn fleet_intent_network_topology_membership_is_an_identity_join() -> Bool {
  let expected = topology_endpoint_labels(items: declared_topology_endpoints)
  let actual = topology_endpoint_labels(items: fleet_intent_network.endpoints)
  length(topology_labels_missing(expected: expected, actual: actual)) == 0
    && length(topology_labels_missing(expected: actual, actual: expected)) == 0
    && length(topology_labels_duplicated(labels: actual)) == 0
    && length(topology_labels_duplicated(labels: expected)) == 0
}

test fn fleet_intent_network_srv1_addresses_holds() -> Bool {
  srv1_host_lan_endpoint.address == "192.168.1.203"
    && srv1_bmc_endpoint.address == "192.168.1.183"
}

// The count row above is a tripwire, not a fact about srv3 — it reds on ANY topology edit and says
// nothing about WHICH endpoint appeared. This row is the discriminating half for the 2026-07-24
// srv3 host addition, mirroring fleet_intent_network_srv1_addresses_holds: srv3 must be modeled
// with BOTH of its interfaces distinguished by role (its BMC at .192 was modeled since the srv3
// onboarding lane; its host OS at .221 was not, so a model that named srv3 could still not name the
// machine). Asserting both addresses AND the role split is what makes a regression that collapses
// host onto BMC — the exact confusion this row was added to end — go red rather than merely
// shifting a count.

test fn fleet_intent_network_srv3_addresses_holds() -> Bool {
  srv3_host_lan_endpoint.address == "192.168.1.221"
    && srv3_host_lan_endpoint.role == HostOperatingSystem
    && srv3_bmc_endpoint.address == "192.168.1.192"
    && srv3_bmc_endpoint.role == BmcOutOfBand
}

// The sold Group B slots are no longer in the topology (rung drop serving_fixtures_name_sold_group_b_hosts).
// srv10 and srv11 keep their endpoint rows as fixtures for serving; this pins them against the transcribed
// reservation values. The Spark host slots were enrolled, each bound to its own identity, at the address its
// CR1000A static reservation carries in gunbc.spark.dgx_procurement, with the role split asserted so a model
// that collapses a Spark's host OS onto some other attachment role reds rather than shifting a count.
// It pins the corpus against the transcribed reservation authority -- a citation check, not a
// readback from the host.
//
// srv9 is GONE from this claim on 2026-11-18, and the claim's name went with it: srv9 (spark-0c75) is sold
// (gunbc.spark.dgx_procurement::dgx_spark_group_b_sale_2026_10_10), and its .236 endpoint row is retired
// because a live machine -- ken, host-e2d4b7 -- is now observed at that address. A fixture row that maps a
// sold host to an address a live host answers at is not neutral test data: it is the exact shape that makes a
// later reader conclude the address belongs to the sold cage. The claim was renamed rather than silently
// narrowed, so the rung drop's comment and any later audit see that this fixture population shrank.

// GROUP B IS SOLD, SO NO SOLD HOST HOLDS AN ENDPOINT ROW. The operator's ruling of 2026-10-10
// @ref(gunbc.spark.dgx_procurement::dgx_spark_group_b_sale_2026_10_10) is explicit -- "Group B (srv9-srv12) is sold
// too: every one of the eight procured units is now sold, and none may remain a reachable fleet host" -- and
// @ref(gunbc.spark.dgx_procurement::dgx_spark_disposed_units) carries each router label at its former slot.
//
// This replaces fleet_intent_network_srv10_enrolled_at_its_reserved_address, which pinned 192.168.1.237 to srv10.
// That claim was itself part of the defect: a test that kept a sold cage addressable. It is deleted rather than
// narrowed, because nothing about a sold host's address is worth pinning -- every value it named is an address no
// fleet mode may dispatch to. What is kept is the identity pin below: srv9, srv10, srv11 and srv12 stay declared in
// gunbc.fleet.fleet_host_identity, which is where a sold unit belongs, and that contrast is the whole difference
// between an identity row and an endpoint row. The executed half is therefore the absence: no endpoint row the
// topology roster carries may name a Group B host as its subject, at any address. That is the guard against
// re-introduction, and it is why the three stale declarations this PR deletes cannot come back as roster rows.
test fn fleet_intent_network_no_sold_group_b_host_holds_an_endpoint_row() -> Bool {
  length(filter(fleet_intent_network.endpoints, e =>
    e.subject == EndpointHost { host: operator_host_srv9 }
      || e.subject == EndpointHost { host: operator_host_srv10 }
      || e.subject == EndpointHost { host: operator_host_srv11 }
      || e.subject == EndpointHost { host: operator_host_srv12 })) == 0
    && operator_host_srv9 == "srv9" && operator_host_srv10 == "srv10"
    && operator_host_srv11 == "srv11" && operator_host_srv12 == "srv12"
}


// ONE ADDRESS, ONE HOLDER, EXECUTED OVER THE TOPOLOGY ROSTER. The .236 cut above and the pending .238 cut are the
// same hazard seen twice: a unit is sold, another machine is observed at its address, and if the old endpoint row
// is left standing the model says two hosts answer at one address -- the exact shape that routes an effect to the
// wrong machine. The per-address claims pin the known cases one at a time; this one refuses the class, so an
// endpoint row added without its retirement reds here instead of waiting for someone to notice a pair.
//
// HONEST REACH, AND A LIMIT THIS PR REMOVES. It ranges over the rows
// gunbc.fleet.fleet_intent_network.endpoints carries -- host, BMC, asset and tailnet rows together, because a
// collision between a host NIC and a management port is the same defect wearing a different hat. The limit that
// mattered when this claim was written was that srv10_host_lan_endpoint, srv11_host_lan_endpoint and
// srv12_host_lan_endpoint existed as declarations while sitting OUTSIDE that roster, so a pair on .237, .238 or
// .239 was invisible to every executed check the repo had. Those three declarations are deleted in this PR on the
// operator's Group B sale ruling, so the blind spot is gone rather than merely documented -- which is the point of
// fleet_intent_network_no_sold_group_b_host_holds_an_endpoint_row above: it is what stops any of them coming back
// as a roster row. What this claim still cannot see is an address held by one rostered row and one unrostered
// declaration of any kind, and that shape is why retired rows should be deleted rather than left standing outside
// the roster.
//
// Single pass by construction: @ref(std.list::first_duplicate_by_key) folds once, carrying the keys it has seen,
// and stops at the first repeat. Review 96631 caught the first version re-filtering the whole roster once per row
// -- a quadratic fold -- which gunbc.design_argument::how_to_work forbids regardless of how small n is today.
test fn fleet_intent_network_no_two_endpoint_rows_hold_one_address() -> Bool {
  match first_duplicate_by_key(xs: fleet_intent_network.endpoints, key: e => e.address) {
    Absent => true
    Present { value: _ } => false
  }
}

// THE RETIREMENT, MADE CHECKABLE. srv9 keeps its identity row -- retiring an endpoint is not deleting a host
// from the register, and this pins that the two did not move together -- while its LAN address answer is gone
// and the only topology row naming 192.168.1.236 belongs to ken, host-e2d4b7. A model that re-added a sold
// cage at that address, or that left both hosts claiming it, reds here. The claim also pins ken's row's shape
// (host-attached, LAN-locality, host-OS role), because a row filed under some other role would answer
// host_lan_address differently and is exactly the kind of slip a fixture edit introduces.
test fn fleet_intent_network_sold_srv9_holds_no_lan_address_and_ken_holds_it_once() -> Bool {
  host_lan_address(host: operator_host_srv9) == none
    && host_lan_address(host: operator_host_e2d4b7) == Present { value: "192.168.1.236" }
    && ken_host_lan_endpoint.role == HostOperatingSystem
    && ken_host_lan_endpoint.locality == Lan
    && ken_host_lan_endpoint.subject == EndpointHost { host: operator_host_e2d4b7 }
    && ken_host_lan_endpoint.address == "192.168.1.236"
    && length(filter(fleet_intent_network.endpoints, e => e.address == "192.168.1.236")) == 1
}

// THE OBSERVATION-VS-INTENT DISTINCTION for ken_host_lan_endpoint is witnessed where the standing lives:
// dag/test/claim/machine_intake/supermicro_h11ssl_unit3_intake_witness.dag, which pins that the row this
// address points at keeps its read_obligation and that the claimant is a dated observation, not a reservation.

// THE BINDING review 59815 REQUIRED, MADE EXECUTABLE. Before the repair the printer endpoint and the
// printer asset were joined only by the label string "printer-01-lan", so the two could drift with
// nothing failing. This asserts the endpoint names printer_01 STRUCTURALLY -- it goes red if the
// endpoint is repointed at another asset, and it could not have been written at all against the old
// `host: HostIdentity?` field, because there was no place on the record to put a PhysicalAssetIdentity.
test fn w_the_printer_endpoint_names_the_registered_printer_asset() -> Bool {
  printer_01_lan_endpoint.subject == EndpointAsset { asset: printer_01 }
    && printer_01_lan_endpoint.role == FabricationAppliance
    && printer_02_lan_endpoint.subject == EndpointAsset { asset: printer_02 }
    && printer_02_lan_endpoint.address == "192.168.1.235"
    && printer_02_lan_endpoint.role == FabricationAppliance
}

test fn w_both_printer_addresses_are_active_static_mac_bound_reservations() -> Bool {
  mac_addresses_are_equal(
      left: printer_01_lan_reservation.mac_address,
      right: mac_address(octet1: 104, octet2: 238, octet3: 143, octet4: 102, octet5: 42, octet6: 40),
    )
    && printer_01_lan_reservation.ipv4_address == ipv4_address(octet1: 192, octet2: 168, octet3: 1, octet4: 234)
    && printer_01_lan_reservation.lease == StaticDhcpReservation {
         reservation_label: "printer-01" as NonEmptyStr,
         status: Active,
       }
    && mac_addresses_are_equal(
      left: printer_02_lan_reservation.mac_address,
      right: mac_address(octet1: 104, octet2: 238, octet3: 143, octet4: 96, octet5: 172, octet6: 20),
    )
    && printer_02_lan_reservation.ipv4_address == ipv4_address(octet1: 192, octet2: 168, octet3: 1, octet4: 235)
    && printer_02_lan_reservation.lease == StaticDhcpReservation {
         reservation_label: "printer-02" as NonEmptyStr,
         status: Active,
       }
}

// AND THE GATEWAY IS UNREGISTERED, NOT UNBOUND. It is a real device this repository holds no
// inventory row for, which is a different fact from an endpoint that addresses nothing. If the
// router ever gets an asset row this arm changes and nothing else does.
test fn w_the_lan_gateway_subject_is_unregistered_rather_than_a_null() -> Bool {
  operator_lan_gateway_endpoint.subject == EndpointSubjectUnregistered
}
