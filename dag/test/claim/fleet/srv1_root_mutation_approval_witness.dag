// THE srv1 ROOT-MUTATION GATE (gunbc.fleet.srv1_root_mutation_approval_run), witnessed at the gate
// fold with SUPPLIED poll standings (DESIGN section 3, a witness discriminates at one interface), and
// at the emitted jobs for the inhabitance half: the real jobs carry the gate before their root step.

// The fixture's job string doubles as the MODE key, because that is what the run hands the request
// builder: the roster row for that mode supplies the destructiveness and the purpose sentence.
fn fixture_mode_authority(mode: String) -> Srv1RootMutationModeAuthority {
  match srv1_root_mutation_mode_authority(mode: mode) {
    ModeAuthorityRead { authority: authority } => authority
    // A fixture mode with no row is a bug in the witness, not a mode the product can run: the claim
    // every_fixture_mode_is_on_the_roster is the RED for it.
    ModeAuthorityUnlisted { mode: m } => Srv1RootMutationModeAuthority {
      mode: m as NonEmptyStr,
      destructive: false,
      purpose_note: "UNDECLARED FIXTURE MODE" as NonEmptyStr,
    }
  }
}

fn fixture_selected_request(job: String, attempt: String, plan_hash: String) -> AuthorizationRequest<Srv1RootMutationApproval> {
  srv1_root_mutation_request(
    job: job as NonEmptyStr,
    escalation_id: srv1_root_mutation_escalation_id(job: job as NonEmptyStr, run_id: "4242" as NonEmptyStr, run_attempt: attempt as NonEmptyStr),
    execution_revision: "fixture-sha" as NonEmptyStr,
    selects: [
      Srv1RootMutationSelect { input: "plan_workflow_run_id" as NonEmptyStr, value: "100" },
      Srv1RootMutationSelect { input: "plan_artifact_hash" as NonEmptyStr, value: plan_hash },
    ],
    authority: fixture_mode_authority(mode: job),
  )
}

fn fixture_request(job: String, attempt: String) -> AuthorizationRequest<Srv1RootMutationApproval> {
  fixture_selected_request(job: job, attempt: attempt, plan_hash: "plan-a")
}

// WHAT THE OPERATOR READS IS PER MODE, AND THE ROSTER AND THE GENERATOR CANNOT DRIFT: every mode whose
// job carries the gate step has its own row, keyed by the mode's OWN wire name (not a job-name
// spelling), read straight off the generator's mode vocabulary.
test fn every_root_mutation_mode_declares_its_own_row() -> Bool {
  all([
    fleet_converge_workflow_mode_wire(mode: DashboardDeploy),
    fleet_converge_workflow_mode_wire(mode: ApprovalBrokerDarkInstall),
    fleet_converge_workflow_mode_wire(mode: MicrovmControllerInstall),
    fleet_converge_workflow_mode_wire(mode: ApprovalNtfyRetire),
  ], m => match srv1_root_mutation_mode_authority(mode: m) {
    ModeAuthorityRead { authority: authority } => (authority.mode as String) == m
    ModeAuthorityUnlisted { mode: _ } => false
  })
}

test fn every_fixture_mode_is_on_the_roster() -> Bool {
  all(
    ["dashboard_deploy", "approval_broker_dark_install", "microvm_controller_install", "approval_ntfy_retire"],
    m => !string_contains(s: fixture_mode_authority(mode: m).purpose_note as String, pattern: "UNDECLARED FIXTURE MODE"),
  )
}

// THE RED THE RULING ASKED FOR: the retirement tells the operator it IS destructive and names what it
// takes off the host -- the account, the state root and the binary. A sentence that stops at "writes
// under /etc and /usr/local" over an uninstall is the defect this closes (DESIGN section 5: no
// plausible output is fabricated, and the flag is the one thing the approver reads about risk).
test fn the_retirement_declares_itself_destructive_and_names_every_removal() -> Bool {
  let retire = fixture_selected_request(job: "approval_ntfy_retire", attempt: "1", plan_hash: "plan-a")
  retire.destructive
    && string_contains(s: retire.purpose as String, pattern: "gunbc-ntfy ACCOUNT")
    && string_contains(s: retire.purpose as String, pattern: "/etc/gunbc-ntfy")
    && string_contains(s: retire.purpose as String, pattern: "/var/lib/gunbc-ntfy")
    && string_contains(s: retire.purpose as String, pattern: "/usr/local/bin/ntfy")
    && string_contains(s: retire.purpose as String, pattern: "not undone")
}

// THE CONTROL, so the flag keeps its meaning instead of becoming a constant nobody trusts: an install
// says it is not destructive and says plainly that it takes nothing off the host.
test fn an_install_mode_declares_it_takes_nothing_off_the_host() -> Bool {
  all(
    ["dashboard_deploy", "approval_broker_dark_install", "microvm_controller_install"],
    m => match srv1_root_mutation_mode_authority(mode: m) {
      ModeAuthorityRead { authority: authority } => !authority.destructive
        && string_contains(s: authority.purpose_note as String, pattern: "takes nothing off the host")
      ModeAuthorityUnlisted { mode: _ } => false
    },
  )
}

// A MODE WITH NO ROW HAS NO DESCRIPTION TO BORROW: the lookup refuses, so the gate files nothing rather
// than dressing an unclassified run in another mode's purpose.
test fn an_unclassified_mode_has_no_row_to_read() -> Bool {
  match srv1_root_mutation_mode_authority(mode: "some_new_root_mutation_mode") {
    ModeAuthorityRead { authority: _ } => false
    ModeAuthorityUnlisted { mode: m } => m == "some_new_root_mutation_mode"
  }
}

// THE MODE REACHES EVERY STEP OF THE JOB AT JOB LEVEL: the gate step AND the inheriting steps rebuild
// the same request from the run's variables, so a mode only one step could see would make the others
// refuse mid-job, after the operator has already said yes.
fn job_binds_its_mode_at_job_level(j: Job) -> Bool {
  match j.env {
    Absent => false
    Present { value: kvs } => any(kvs, e => match e {
      YamlKeyValue { key: k, value: YamlString { value: v } } => k == srv1_root_mutation_mode_env
        && v == "${{ github.event.inputs.mode }}"
      _ => false
    })
  }
}

test fn every_root_mutation_job_hands_its_mode_to_every_step() -> Bool {
  job_binds_its_mode_at_job_level(j: fleet_converge_dashboard_deploy_job())
    && job_binds_its_mode_at_job_level(j: fleet_converge_approval_broker_dark_install_job())
    && job_binds_its_mode_at_job_level(j: fleet_converge_microvm_controller_install_job())
    && job_binds_its_mode_at_job_level(j: fleet_converge_approval_ntfy_retire_job())
    && !job_binds_its_mode_at_job_level(j: fleet_converge_printer_job())
}

// WHAT THE OPERATOR IS ASKED FOR IS WHAT THE INHERITING WRITES ARE ADMITTED AGAINST: one value, and
// the census root's site is this module's gate.
test fn the_request_asks_for_exactly_the_scopes_the_census_root_grants() -> Bool {
  fixture_request(job: "dashboard_deploy", attempt: "1").scopes == srv1_root_mutation_approval_root.approved_scopes
    && srv1_root_mutation_approved_scopes == srv1_root_mutation_approval_root.approved_scopes
    && (srv1_root_mutation_approval_row.site.module_path as String) == "gunbc.fleet.srv1_root_mutation_approval_run"
    && (srv1_root_mutation_approval_row.site.decl_name as String) == "srv1_root_mutation_after_gate"
}

test fn each_job_attempt_files_its_own_escalation() -> Bool {
  let a = fixture_request(job: "dashboard_deploy", attempt: "1").escalation_id
  let b = fixture_request(job: "dashboard_deploy", attempt: "2").escalation_id
  let c = fixture_request(job: "microvm_controller_install", attempt: "1").escalation_id
  a != b && a != c && b != c && string_contains(s: a as String, pattern: "dashboard_deploy")
}

// THE POSITIVE CONTROL AND ITS RED: the operator's approval of this job's request admits it, and the
// same decision does not admit another job's request -- an approval is never spent on another job.
test fn an_approval_admits_its_own_job_and_not_another() -> Bool {
  let deploy = fixture_request(job: "dashboard_deploy", attempt: "1")
  let install = fixture_request(job: "microvm_controller_install", attempt: "1")
  let approved = PollApproved { revision: request_revision_of(request: deploy), decided_by: "fixture-operator", decided_at: "2026-10-26T12:00:00Z", execute_by: "2026-10-26T12:30:00Z" }
  (match approval_gate_from_poll(poll: approved, request: deploy, observed_at: "2026-10-26T12:01:00Z") {
    GateAdmitted { authorization: _ } => true
    GateRefused { cause: _ } => false
  })
    && (match approval_gate_from_poll(poll: approved, request: install, observed_at: "2026-10-26T12:01:00Z") {
      GateAdmitted { authorization: _ } => false
      GateRefused { cause: _ } => true
    })
}

// A DENIAL OR AN EXPIRY ENDS THE JOB, and the reason says no root step runs.
test fn a_refused_gate_fails_the_step_before_any_root_step() -> Bool {
  let deploy = fixture_request(job: "dashboard_deploy", attempt: "1")
  let denied = approval_gate_from_poll(
    poll: PollDenied { revision: request_revision_of(request: deploy), decided_by: "fixture-operator", decided_at: "2026-10-26T12:00:00Z", reason: "not now" },
    request: deploy, observed_at: "2026-10-26T12:01:00Z",
  )
  let expired = approval_gate_from_poll(poll: PollExpired, request: deploy, observed_at: "2026-10-26T12:01:00Z")
  all([denied, expired], g => match srv1_root_mutation_after_gate(gate: g, request: deploy, receipt_path: "fixture-unwritten-receipt.txt") {
    ExitSuccess => false
    ExitFailure { code: _, reason: r } => string_contains(s: r, pattern: "no root step runs")
  })
}

fn step_id_of(st: Step) -> String {
  match st {
    RunStep { name: _, id: Present { value: i }, run: _, shell: _, env: _, working_directory: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } => i
    UsesStep { name: _, id: Present { value: i }, uses: _, with: _, env: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } => i
    _ => ""
  }
}

// THE ORDER, read off the emitted job: WIF auth, then the gate, then the root step. The fold's state
// is how far the sequence has got; a root step seen before the gate is sticky at -1.
fn gated_before(j: Job, root_step: String) -> Bool {
  let reached = fold(j.steps, init: 0, f: fn(at, st) {
    let id = step_id_of(st: st)
    if at < 0 { at }
    else if id == root_step { if at == 2 { 3 } else { 0 - 1 } }
    else if id == "wif_auth" && at == 0 { 1 }
    else if id == "srv1_root_mutation_approval" && at == 1 { 2 }
    else { at }
  })
  reached == 3
}

test fn every_srv1_root_mutation_job_runs_the_gate_before_its_root_step() -> Bool {
  gated_before(j: fleet_converge_dashboard_deploy_job(), root_step: "dashboard_deploy")
    && gated_before(j: fleet_converge_approval_broker_dark_install_job(), root_step: "approval_broker_dark_install")
    && gated_before(j: fleet_converge_microvm_controller_install_job(), root_step: "microvm_controller_install")
    && gated_before(j: fleet_converge_approval_ntfy_retire_job(), root_step: "approval_ntfy_retire")
}

// THE STEP'S SHELL IS RENDERED FROM bash_build NODES: a rejected tree renders the refusal poison, so
// the claim reads the rendered text for the key export and the gate's entry, and refuses the poison.
test fn the_gate_step_renders_from_nodes_and_exports_only_the_submission_key() -> Bool {
  let text = gunbc_ci_srv1_root_mutation_approval_invoke()
  string_contains(s: text, pattern: "GUNBC_APPROVAL_SUBMISSION_MAC_KEY_FILE=")
    && string_contains(s: text, pattern: "srv1_root_mutation_approval_wet")
    && string_contains(s: text, pattern: "'trap'")
    && !string_contains(s: text, pattern: "GUNBC_ORG_ADMIN_TOKEN")
    && !string_contains(s: text, pattern: "dissolve-on")
    && !string_contains(s: text, pattern: "__GUNBC_INVOKE_EMIT_REFUSED__")
    && !string_contains(s: text, pattern: "/artifacts")
}

// THE UPLOADED PATH AND THE WRITTEN PATH ARE ONE TEMPLATE, checked against spellings stated here
// independently: GitHub's expression syntax for the upload, and a supplied RUNNER_TEMP for the write.
// Both sit outside the checkout, which is what the deploy's clean-tree check needs.
test fn the_receipt_is_uploaded_from_where_it_is_written_outside_the_checkout() -> Bool {
  srv1_root_mutation_approval_artifact_glob == "${{ runner.temp }}/srv1-root-mutation-approval-receipt.txt"
    && srv1_root_mutation_approval_receipt_path(runner_temp_dir: "/fixture/runner-temp") == Present { value: "/fixture/runner-temp/srv1-root-mutation-approval-receipt.txt" }
}

// THE APPROVAL BINDS THE SELECTION (review 5649820707): one job, one attempt, one commit, two plans.
// The operator's decision on plan A does not admit plan B, and the purpose the operator reads names
// the plan it is approving.
test fn a_decision_for_one_plan_does_not_admit_another_at_the_same_commit() -> Bool {
  let plan_a = fixture_selected_request(job: "dashboard_deploy", attempt: "1", plan_hash: "plan-a")
  let plan_b = fixture_selected_request(job: "dashboard_deploy", attempt: "1", plan_hash: "plan-b")
  let approved_a = PollApproved { revision: request_revision_of(request: plan_a), decided_by: "fixture-operator", decided_at: "2026-10-26T12:00:00Z", execute_by: "2026-10-26T12:30:00Z" }
  string_contains(s: plan_a.purpose as String, pattern: "plan_artifact_hash=plan-a")
    && (match approval_gate_from_poll(poll: approved_a, request: plan_a, observed_at: "2026-10-26T12:01:00Z") {
      GateAdmitted { authorization: _ } => true
      GateRefused { cause: _ } => false
    })
    && (match approval_gate_from_poll(poll: approved_a, request: plan_b, observed_at: "2026-10-26T12:01:00Z") {
      GateAdmitted { authorization: _ } => false
      GateRefused { cause: _ } => true
    })
}

fn kv_strings(kvs: List<YamlKeyValue>?) -> List<String> {
  match kvs {
    Absent => []
    Present { value: xs } => fold(xs, init: [], f: fn(acc, e) {
      match e.value {
        YamlString { value: v } => concat(acc, [v])
        _ => acc
      }
    })
  }
}

fn step_input_strings(st: Step) -> List<String> {
  match st {
    RunStep { name: _, id: _, run: _, shell: _, env: e, working_directory: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } => kv_strings(kvs: e)
    UsesStep { name: _, id: _, uses: _, with: w, env: e, if_condition: _, continue_on_error: _, timeout_minutes: _ } => concat(kv_strings(kvs: w), kv_strings(kvs: e))
  }
}

// EVERY DISPATCH INPUT A ROOT STEP CONSUMES IS IN THE APPROVED SELECTION, read off the emitted job:
// each env or with value after the gate that reads an input names one the gate binds, or host / mode,
// which the job's own condition fixes. A step that starts reading a new input without the selection
// naming it fails here, so the approved subject cannot silently fall behind what the job converges.
fn later_inputs_are_selected(j: Job, selects: List<String>) -> Bool {
  let bound = concat(selects, ["host", "mode"])
  let after = fold(j.steps, init: [], f: fn(acc, st) {
    if step_id_of(st: st) == "srv1_root_mutation_approval" { [st] } else if acc == [] { acc } else { concat(acc, [st]) }
  })
  after != []
    && all(after.skip(n: 1), st => all(step_input_strings(st: st), v =>
      !string_contains(s: v, pattern: "inputs.")
        || any(bound, n => string_contains(s: v, pattern: join(["inputs.", n, " "], "")))))
}

test fn every_input_a_root_step_consumes_is_in_the_approved_selection() -> Bool {
  later_inputs_are_selected(j: fleet_converge_dashboard_deploy_job(), selects: fleet_converge_dashboard_deploy_selected_inputs)
    && later_inputs_are_selected(j: fleet_converge_microvm_controller_install_job(), selects: fleet_converge_microvm_controller_install_selected_inputs)
    && later_inputs_are_selected(j: fleet_converge_approval_broker_dark_install_job(), selects: fleet_converge_approval_broker_dark_install_selected_inputs)
    && later_inputs_are_selected(j: fleet_converge_approval_ntfy_retire_job(), selects: fleet_converge_approval_ntfy_retire_selected_inputs)
    && !later_inputs_are_selected(j: fleet_converge_dashboard_deploy_job(), selects: ["plan_workflow_run_id"])
}

// A NON-srv1 DISPATCH NEVER REACHES THE CREDENTIAL (review 5649820707): the host check is the job's
// own condition, so the WIF step and the submission-key fetch never run on another host's runner.
fn job_admits_srv1_only(j: Job) -> Bool {
  match j.if_condition {
    Absent => false
    Present { value: c } => string_contains(s: c, pattern: "github.event.inputs.host == 'srv1'")
  }
}

test fn a_non_srv1_dispatch_never_reaches_the_credential_steps() -> Bool {
  job_admits_srv1_only(j: fleet_converge_dashboard_deploy_job())
    && job_admits_srv1_only(j: fleet_converge_approval_broker_dark_install_job())
    && job_admits_srv1_only(j: fleet_converge_microvm_controller_install_job())
    && job_admits_srv1_only(j: fleet_converge_approval_ntfy_retire_job())
}

// ── AN INHERITING STEP'S GRANT (srv1_root_mutation_inheritance), with supplied standings ────────────
// The microVM controller install re-reads its job's decision and admits the install only when the
// grant covers every scope the install exercises. Each claim supplies the poll standing and decides
// with the same fold the install runs.

fn inherit_with(poll_request: AuthorizationRequest<Srv1RootMutationApproval>, own: AuthorizationRequest<Srv1RootMutationApproval>, required: List<AuthorizationScope>) -> Bool {
  let approved = PollApproved { revision: request_revision_of(request: poll_request), decided_by: "fixture-operator", decided_at: "2026-10-26T12:00:00Z", execute_by: "2026-10-26T12:30:00Z" }
  match srv1_root_mutation_inheritance(
    gate: approval_gate_from_poll(poll: approved, request: own, observed_at: "2026-10-26T12:01:00Z"),
    request: own,
    required: required,
    observed_at: "2026-10-26T12:01:00Z",
  ) {
    Srv1InheritedGrantAdmitted { grant: _ } => true
    Srv1InheritedGrantRefused { reason: _ } => false
  }
}

// THE POSITIVE CONTROL: the job's own approval admits the controller install's scopes.
test fn the_job_approval_admits_the_controller_install_scopes() -> Bool {
  let install = fixture_request(job: "microvm_controller_install", attempt: "1")
  inherit_with(poll_request: install, own: install, required: microvm_controller_install_root_scopes)
}

// THE REDS: another job's approval does not admit it, a scope outside the approved trees does not, and
// a write that states no scope is not covered vacuously.
test fn another_job_approval_an_unapproved_scope_and_an_empty_scope_list_refuse() -> Bool {
  let install = fixture_request(job: "microvm_controller_install", attempt: "1")
  let deploy = fixture_request(job: "dashboard_deploy", attempt: "1")
  !inherit_with(poll_request: deploy, own: install, required: microvm_controller_install_root_scopes)
    && !inherit_with(poll_request: install, own: install, required: [srv1_root_write_scope(path: ["srv", "outside"])])
    && !inherit_with(poll_request: install, own: install, required: [])
}

// THE CENSUS ROW AND THE INSTALL ASK FOR ONE VALUE: the controller install's row requires exactly the
// scopes the install authorizes against.
test fn the_census_row_requires_the_scopes_the_install_authorizes() -> Bool {
  any(privileged_effect_census, row =>
    declaration_ref_display_key(ref: row.site) == "gunbc.host.host_effect_realize::microvm_controller_staged_write_steps"
      && match row.effect.witness_discharge {
        EntailedByApprovedConvergence { root: _, required_scopes: r } => r == microvm_controller_install_root_scopes
        _ => false
      })
}

fn step_name_of(st: Step) -> String {
  match st {
    RunStep { name: Present { value: n }, id: _, run: _, shell: _, env: _, working_directory: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } => n
    UsesStep { name: Present { value: n }, id: _, uses: _, with: _, env: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } => n
    _ => ""
  }
}

fn is_key_step(st: Step) -> Bool { string_contains(s: step_name_of(st: st), pattern: "Materialize fleet key in-run") }
fn is_key_cleanup_step(st: Step) -> Bool { string_contains(s: step_name_of(st: st), pattern: "kill the in-run ssh-agent") }

// THE ADMINISTRATOR'S KEY EXISTS ONLY IN AN APPROVED RUN, read off the emitted job: the gate, then the
// key, then the install, and the agent's teardown last. A key step before the gate leaves the fold
// sticky at -1; a job with no key step, or no teardown after the install, never reaches 4.
test fn the_controller_install_holds_the_fleet_key_only_after_its_approval() -> Bool {
  let j = fleet_converge_microvm_controller_install_job()
  let reached = fold(j.steps, init: 0, f: fn(at, st) {
    if at < 0 { at }
    else if step_id_of(st: st) == "srv1_root_mutation_approval" { if at == 0 { 1 } else { at } }
    else if is_key_step(st: st) { if at == 1 { 2 } else { 0 - 1 } }
    else if step_id_of(st: st) == "microvm_controller_install" { if at == 2 { 3 } else { 0 - 1 } }
    else if is_key_cleanup_step(st: st) { if at == 3 { 4 } else { 0 - 1 } }
    else { at }
  })
  reached == 4
}
