module test.claim.fleet.srv1_root_mutation_approval_witness

import std.types { Bool, Int, NonEmptyStr, String, List }
import std.algebra { string_contains }
import std.optional { Present, Absent }
import std.process { ProcessExit, ExitSuccess, ExitFailure }
import std.scoped_authorization { AuthorizationRequest }
import extdeps.github.actions { Job, Step, RunStep, UsesStep }
import gunbc.auth.approval_decision_store { request_revision_of }
import gunbc.auth.approval_request_client { PollApproved, PollDenied, PollExpired }
import gunbc.auth.approval_gate { approval_gate_from_poll, GateAdmitted, GateRefused, ApprovalDenied }
import gunbc.fleet.srv1_root_mutation_approval_run {
  srv1_root_mutation_request, srv1_root_mutation_escalation_id, srv1_root_mutation_after_gate,
  srv1_root_mutation_approved_scopes, Srv1RootMutationApproval,
}
import gunbc.auth.privileged_effect_census { srv1_root_mutation_approval_root, srv1_root_mutation_approval_row }
import gunbc.fleet.fleet_converge_workflow {
  fleet_converge_dashboard_deploy_job, fleet_converge_approval_broker_dark_install_job, fleet_converge_microvm_controller_install_job,
}

// THE srv1 ROOT-MUTATION GATE (gunbc.fleet.srv1_root_mutation_approval_run), witnessed at the gate
// fold with SUPPLIED poll standings (DESIGN section 3, a witness discriminates at one interface), and
// at the emitted jobs for the inhabitance half: the real jobs carry the gate before their root step.

fn fixture_request(job: String, attempt: String) -> AuthorizationRequest<Srv1RootMutationApproval> {
  srv1_root_mutation_request(
    job: job as NonEmptyStr,
    escalation_id: srv1_root_mutation_escalation_id(job: job as NonEmptyStr, run_id: "4242" as NonEmptyStr, run_attempt: attempt as NonEmptyStr),
    execution_revision: "fixture-sha" as NonEmptyStr,
  )
}

// WHAT THE OPERATOR IS ASKED FOR IS WHAT THE INHERITING WRITES ARE ADMITTED AGAINST: one value, and
// the census root's site is this module's gate.
test fn the_request_asks_for_exactly_the_scopes_the_census_root_grants() -> Bool {
  fixture_request(job: "dashboard_deploy", attempt: "1").scopes == srv1_root_mutation_approval_root.approved_scopes
    && srv1_root_mutation_approved_scopes == srv1_root_mutation_approval_root.approved_scopes
    && (srv1_root_mutation_approval_row.site.module_path as String) == "gunbc.fleet.srv1_root_mutation_approval_run"
    && (srv1_root_mutation_approval_row.site.decl_name as String) == "srv1_root_mutation_after_gate"
}

test fn each_job_attempt_files_its_own_escalation() -> Bool {
  let a = fixture_request(job: "dashboard_deploy", attempt: "1").escalation_id
  let b = fixture_request(job: "dashboard_deploy", attempt: "2").escalation_id
  let c = fixture_request(job: "microvm_controller_install", attempt: "1").escalation_id
  a != b && a != c && b != c && string_contains(s: a as String, pattern: "dashboard_deploy")
}

// THE POSITIVE CONTROL AND ITS RED: the operator's approval of this job's request admits it, and the
// same decision does not admit another job's request -- an approval is never spent on another job.
test fn an_approval_admits_its_own_job_and_not_another() -> Bool {
  let deploy = fixture_request(job: "dashboard_deploy", attempt: "1")
  let install = fixture_request(job: "microvm_controller_install", attempt: "1")
  let approved = PollApproved { revision: request_revision_of(request: deploy), decided_by: "fixture-operator", decided_at: "2026-10-26T12:00:00Z", execute_by: "2026-10-26T12:30:00Z" }
  (match approval_gate_from_poll(poll: approved, request: deploy, observed_at: "2026-10-26T12:01:00Z") {
    GateAdmitted { authorization: _ } => true
    GateRefused { cause: _ } => false
  })
    && (match approval_gate_from_poll(poll: approved, request: install, observed_at: "2026-10-26T12:01:00Z") {
      GateAdmitted { authorization: _ } => false
      GateRefused { cause: _ } => true
    })
}

// A DENIAL OR AN EXPIRY ENDS THE JOB, and the reason says no root step runs.
test fn a_refused_gate_fails_the_step_before_any_root_step() -> Bool {
  let deploy = fixture_request(job: "dashboard_deploy", attempt: "1")
  let denied = approval_gate_from_poll(
    poll: PollDenied { revision: request_revision_of(request: deploy), decided_by: "fixture-operator", decided_at: "2026-10-26T12:00:00Z", reason: "not now" },
    request: deploy, observed_at: "2026-10-26T12:01:00Z",
  )
  let expired = approval_gate_from_poll(poll: PollExpired, request: deploy, observed_at: "2026-10-26T12:01:00Z")
  all([denied, expired], g => match srv1_root_mutation_after_gate(gate: g, request: deploy) {
    ExitSuccess => false
    ExitFailure { code: _, reason: r } => string_contains(s: r, pattern: "no root step runs")
  })
}

fn step_id_of(st: Step) -> String {
  match st {
    RunStep { name: _, id: Present { value: i }, run: _, shell: _, env: _, working_directory: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } => i
    UsesStep { name: _, id: Present { value: i }, uses: _, with: _, env: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } => i
    _ => ""
  }
}

// THE ORDER, read off the emitted job: WIF auth, then the gate, then the root step. The fold's state
// is how far the sequence has got; a root step seen before the gate is sticky at -1.
fn gated_before(j: Job, root_step: String) -> Bool {
  let reached = fold(j.steps, init: 0, f: fn(at, st) {
    let id = step_id_of(st: st)
    if at < 0 { at }
    else if id == root_step { if at == 2 { 3 } else { 0 - 1 } }
    else if id == "wif_auth" && at == 0 { 1 }
    else if id == "srv1_root_mutation_approval" && at == 1 { 2 }
    else { at }
  })
  reached == 3
}

test fn every_srv1_root_mutation_job_runs_the_gate_before_its_root_step() -> Bool {
  gated_before(j: fleet_converge_dashboard_deploy_job(), root_step: "dashboard_deploy")
    && gated_before(j: fleet_converge_approval_broker_dark_install_job(), root_step: "approval_broker_dark_install")
    && gated_before(j: fleet_converge_microvm_controller_install_job(), root_step: "microvm_controller_install")
}
