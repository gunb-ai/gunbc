// THE srv1 ROOT-MUTATION GATE (gunbc.fleet.srv1_root_mutation_approval_run), witnessed at the gate
// fold with SUPPLIED poll standings (DESIGN section 3, a witness discriminates at one interface), and
// at the emitted jobs for the inhabitance half: the real jobs carry the gate before their root step.

// THE FIXTURE IS A MODE, NOT A STRING: the request builder takes the family coproduct, so a fixture
// cannot name a mode the model does not have, and there is no unlisted arm left to invent a stand-in
// authority for -- every claim below runs on a mode the product can actually dispatch.
fn fixture_selected_request(mode: Srv1RootMutationMode, attempt: String, plan_hash: String) -> AuthorizationRequest<Srv1RootMutationApproval> {
  let job = srv1_root_mutation_mode_job_id(mode: mode)
  srv1_root_mutation_request(
    job: job as NonEmptyStr,
    escalation_id: srv1_root_mutation_escalation_id(job: job as NonEmptyStr, run_id: "4242" as NonEmptyStr, run_attempt: attempt as NonEmptyStr),
    execution_revision: "fixture-sha" as NonEmptyStr,
    selects: [
      Srv1RootMutationSelect { input: "plan_workflow_run_id" as NonEmptyStr, value: "100" },
      Srv1RootMutationSelect { input: "plan_artifact_hash" as NonEmptyStr, value: plan_hash },
    ],
    mode: mode,
  )
}

fn fixture_request(mode: Srv1RootMutationMode, attempt: String) -> AuthorizationRequest<Srv1RootMutationApproval> {
  fixture_selected_request(mode: mode, attempt: attempt, plan_hash: "plan-a")
}

// THE RED THE RULING ASKED FOR: the retirement tells the operator it IS destructive and names what it
// takes off the host -- the account, the group the account leaves behind, the config directory, the
// state root and the binary. A sentence
// that stops at "writes under /etc and /usr/local" over an uninstall is the defect this closes
// (DESIGN section 5: no plausible output is fabricated, and the flag is the one thing the approver
// reads about risk). The group is named here because a deletion the approver was never told about is
// the same defect in the other direction.
test fn the_retirement_declares_itself_destructive_and_names_every_removal() -> Bool {
  let retire = fixture_selected_request(mode: ApprovalNtfyRetire, attempt: "1", plan_hash: "plan-a")
  retire.destructive
    && string_contains(s: retire.purpose as String, pattern: "gunbc-ntfy ACCOUNT")
    && string_contains(s: retire.purpose as String, pattern: "gunbc-ntfy GROUP")
    && string_contains(s: retire.purpose as String, pattern: "/etc/gunbc-ntfy")
    && string_contains(s: retire.purpose as String, pattern: "/var/lib/gunbc-ntfy")
    && string_contains(s: retire.purpose as String, pattern: "/usr/local/bin/ntfy")
    && string_contains(s: retire.purpose as String, pattern: "not undone")
}

// THE CONTROL, so the flag keeps its meaning instead of becoming a constant nobody trusts: exactly one
// mode in the family takes anything off the host, and it is the retirement. Enumerated over the
// family's own list, so a flag flipped on an install -- or a new mode that quietly declares itself
// destructive -- is red.
test fn only_the_retirement_takes_anything_off_the_host() -> Bool {
  all(srv1_root_mutation_modes, m => srv1_root_mutation_mode_authority(mode: m).destructive == (m == ApprovalNtfyRetire))
}

// A WIRE THE FAMILY DOES NOT HAVE HAS NO DESCRIPTION TO BORROW: the run's `mode` string is parsed
// through the family's own wire fn, and a wire outside the family is refused -- the gate files nothing
// rather than dressing an unclassified run in another mode's purpose. The second half is the
// round-trip: every member of the family parses back to itself.
test fn a_wire_outside_the_family_is_refused_and_every_member_round_trips() -> Bool {
  (match srv1_root_mutation_mode_of_wire(wire: "some_new_root_mutation_mode") {
    ModeRead { mode: _ } => false
    ModeWireUnreadable { wire: w } => w == "some_new_root_mutation_mode"
  })
    && all(srv1_root_mutation_modes, m => match srv1_root_mutation_mode_of_wire(wire: srv1_root_mutation_mode_wire(mode: m)) {
      ModeRead { mode: read } => read == m
      ModeWireUnreadable { wire: _ } => false
    })
}

// WHAT THE OPERATOR IS ASKED FOR IS WHAT THE INHERITING WRITES ARE ADMITTED AGAINST: one value, and
// the census root's site is this module's gate.
test fn the_request_asks_for_exactly_the_scopes_the_census_root_grants() -> Bool {
  fixture_request(mode: DashboardDeploy, attempt: "1").scopes == srv1_root_mutation_approval_root.approved_scopes
    && srv1_root_mutation_approved_scopes == srv1_root_mutation_approval_root.approved_scopes
    && (srv1_root_mutation_approval_row.site.module_path as String) == "gunbc.fleet.srv1_root_mutation_approval_run"
    && (srv1_root_mutation_approval_row.site.decl_name as String) == "srv1_root_mutation_after_gate"
}

test fn each_job_attempt_files_its_own_escalation() -> Bool {
  let a = fixture_request(mode: DashboardDeploy, attempt: "1").escalation_id
  let b = fixture_request(mode: DashboardDeploy, attempt: "2").escalation_id
  let c = fixture_request(mode: MicrovmControllerInstall, attempt: "1").escalation_id
  a != b && a != c && b != c && string_contains(s: a as String, pattern: srv1_root_mutation_mode_job_id(mode: DashboardDeploy))
}

// THE POSITIVE CONTROL AND ITS RED: the operator's approval of this job's request admits it, and the
// same decision does not admit another job's request -- an approval is never spent on another job.
test fn an_approval_admits_its_own_job_and_not_another() -> Bool {
  let deploy = fixture_request(mode: DashboardDeploy, attempt: "1")
  let install = fixture_request(mode: MicrovmControllerInstall, attempt: "1")
  let approved = PollApproved { revision: request_revision_of(request: deploy), decided_by: "fixture-operator", decided_at: "2026-10-26T12:00:00Z", execute_by: "2026-10-26T12:30:00Z" }
  (match approval_gate_from_poll(poll: approved, request: deploy, observed_at: "2026-10-26T12:01:00Z") {
    GateAdmitted { authorization: _ } => true
    GateRefused { cause: _ } => false
  })
    && (match approval_gate_from_poll(poll: approved, request: install, observed_at: "2026-10-26T12:01:00Z") {
      GateAdmitted { authorization: _ } => false
      GateRefused { cause: _ } => true
    })
}

// A DENIAL OR AN EXPIRY ENDS THE JOB, and the reason says no root step runs.
test fn a_refused_gate_fails_the_step_before_any_root_step() -> Bool {
  let deploy = fixture_request(mode: DashboardDeploy, attempt: "1")
  let denied = approval_gate_from_poll(
    poll: PollDenied { revision: request_revision_of(request: deploy), decided_by: "fixture-operator", decided_at: "2026-10-26T12:00:00Z", reason: "not now" },
    request: deploy, observed_at: "2026-10-26T12:01:00Z",
  )
  let expired = approval_gate_from_poll(poll: PollExpired, request: deploy, observed_at: "2026-10-26T12:01:00Z")
  all([denied, expired], g => match srv1_root_mutation_after_gate(gate: g, request: deploy, receipt_path: "fixture-unwritten-receipt.txt") {
    ExitSuccess => false
    ExitFailure { code: _, reason: r } => string_contains(s: r, pattern: "no root step runs")
  })
}

// THE STEP'S SHELL IS RENDERED FROM bash_build NODES: a rejected tree renders the refusal poison, so
// the claim reads the rendered text for the key export and the gate's entry, and refuses the poison.
test fn the_gate_step_renders_from_nodes_and_exports_only_the_submission_key() -> Bool {
  let text = gunbc_ci_srv1_root_mutation_approval_invoke()
  string_contains(s: text, pattern: "GUNBC_APPROVAL_SUBMISSION_MAC_KEY_FILE=")
    && string_contains(s: text, pattern: "srv1_root_mutation_approval_wet")
    && string_contains(s: text, pattern: "'trap'")
    && !string_contains(s: text, pattern: "GUNBC_ORG_ADMIN_TOKEN")
    && !string_contains(s: text, pattern: "dissolve-on")
    && !string_contains(s: text, pattern: "__GUNBC_INVOKE_EMIT_REFUSED__")
    && !string_contains(s: text, pattern: "/artifacts")
}

// THE UPLOADED PATH AND THE WRITTEN PATH ARE ONE TEMPLATE, checked against spellings stated here
// independently: GitHub's expression syntax for the upload, and a supplied RUNNER_TEMP for the write.
// Both sit outside the checkout, which is what the deploy's clean-tree check needs.
test fn the_receipt_is_uploaded_from_where_it_is_written_outside_the_checkout() -> Bool {
  srv1_root_mutation_approval_artifact_glob == "${{ runner.temp }}/srv1-root-mutation-approval-receipt.txt"
    && srv1_root_mutation_approval_receipt_path(runner_temp_dir: "/fixture/runner-temp") == Present { value: "/fixture/runner-temp/srv1-root-mutation-approval-receipt.txt" }
}

// THE APPROVAL BINDS THE SELECTION (review 5649820707): one job, one attempt, one commit, two plans.
// The operator's decision on plan A does not admit plan B, and the purpose the operator reads names
// the plan it is approving.
test fn a_decision_for_one_plan_does_not_admit_another_at_the_same_commit() -> Bool {
  let plan_a = fixture_selected_request(mode: DashboardDeploy, attempt: "1", plan_hash: "plan-a")
  let plan_b = fixture_selected_request(mode: DashboardDeploy, attempt: "1", plan_hash: "plan-b")
  let approved_a = PollApproved { revision: request_revision_of(request: plan_a), decided_by: "fixture-operator", decided_at: "2026-10-26T12:00:00Z", execute_by: "2026-10-26T12:30:00Z" }
  string_contains(s: plan_a.purpose as String, pattern: "plan_artifact_hash=plan-a")
    && (match approval_gate_from_poll(poll: approved_a, request: plan_a, observed_at: "2026-10-26T12:01:00Z") {
      GateAdmitted { authorization: _ } => true
      GateRefused { cause: _ } => false
    })
    && (match approval_gate_from_poll(poll: approved_a, request: plan_b, observed_at: "2026-10-26T12:01:00Z") {
      GateAdmitted { authorization: _ } => false
      GateRefused { cause: _ } => true
    })
}

// ── AN INHERITING STEP'S GRANT (srv1_root_mutation_inheritance), with supplied standings ────────────
// The microVM controller install re-reads its job's decision and admits the install only when the
// grant covers every scope the install exercises. Each claim supplies the poll standing and decides
// with the same fold the install runs.

fn inherit_with(poll_request: AuthorizationRequest<Srv1RootMutationApproval>, own: AuthorizationRequest<Srv1RootMutationApproval>, required: List<AuthorizationScope>) -> Bool {
  let approved = PollApproved { revision: request_revision_of(request: poll_request), decided_by: "fixture-operator", decided_at: "2026-10-26T12:00:00Z", execute_by: "2026-10-26T12:30:00Z" }
  match srv1_root_mutation_inheritance(
    gate: approval_gate_from_poll(poll: approved, request: own, observed_at: "2026-10-26T12:01:00Z"),
    request: own,
    required: required,
    observed_at: "2026-10-26T12:01:00Z",
  ) {
    Srv1InheritedGrantAdmitted { grant: _ } => true
    Srv1InheritedGrantRefused { reason: _ } => false
  }
}

// THE POSITIVE CONTROL: the job's own approval admits the controller install's scopes.
test fn the_job_approval_admits_the_controller_install_scopes() -> Bool {
  let install = fixture_request(mode: MicrovmControllerInstall, attempt: "1")
  inherit_with(poll_request: install, own: install, required: microvm_controller_install_root_scopes)
}

// THE REDS: another job's approval does not admit it, a scope outside the approved trees does not, and
// a write that states no scope is not covered vacuously.
test fn another_job_approval_an_unapproved_scope_and_an_empty_scope_list_refuse() -> Bool {
  let install = fixture_request(mode: MicrovmControllerInstall, attempt: "1")
  let deploy = fixture_request(mode: DashboardDeploy, attempt: "1")
  !inherit_with(poll_request: deploy, own: install, required: microvm_controller_install_root_scopes)
    && !inherit_with(poll_request: install, own: install, required: [srv1_root_write_scope(path: ["srv", "outside"])])
    && !inherit_with(poll_request: install, own: install, required: [])
}

// THE CENSUS ROW AND THE INSTALL ASK FOR ONE VALUE: the controller install's row requires exactly the
// scopes the install authorizes against.
test fn the_census_row_requires_the_scopes_the_install_authorizes() -> Bool {
  any(privileged_effect_census, row =>
    declaration_ref_display_key(ref: row.site) == "gunbc.host.host_effect_realize::microvm_controller_staged_write_steps"
      && match row.effect.witness_discharge {
        EntailedByApprovedConvergence { root: _, required_scopes: r } => r == microvm_controller_install_root_scopes
        _ => false
      })
}

// ── The wait ends on the model's own verdict, not on the runner's clock ────────────────────────
//
// Run 41972155901 is the witness in the wild: the operator never tapped, the poll was still polling at
// the runner's 32-minute step limit, and the step was KILLED two minutes before the approval's own
// expires_at (09:14:12Z + 30 min = 09:44:12Z; killed 09:42:04Z). Nothing mutated -- the actuation step
// was skipped -- but the run died with a runner timeout where the model had a typed thing to say, and
// the receipt was never written. These claims are what makes that shape unwriteable again: the gate
// must name the expiry itself, the polls must reach past the deadline, and the runner's patience must
// be strictly longer than the model's worst case.

test fn the_unanswered_window_refuses_with_the_expiry_the_model_knows() -> Bool {
  let deploy = fixture_request(mode: DashboardDeploy, attempt: "1")
  match approval_gate_from_poll(poll: PollExpired, request: deploy, observed_at: "2026-10-26T12:31:00Z") {
    // THE CAUSE IS NAMED, not merely "some refusal": a run that ends on a spent tick budget reports
    // ApprovalPending (approval_gate's PollBudgetExhausted arm), and an unreadable clock reports
    // ApprovalStoreUnreadable. Reading an expiry as either would send an operator who never answered
    // back through the wrong remedy.
    GateRefused { cause: ApprovalExpired } => true
    GateRefused { cause: _ } => false
    GateAdmitted { authorization: _ } => false
  }
}

// THE TICKETS OUTLIVE THE WINDOW THEY POLL. If the budget ran out first, the fold would report a spent
// budget instead of the expiry it is holding, which is the confusion this module's own comments forbid
// ("a run that stops on budget is not an expired window"). One full cadence strictly past expires_at is
// the minimum: it is what guarantees a clock read at or after the deadline.
test fn the_poll_budget_outlives_the_window_it_polls() -> Bool {
  nat_to_int(n: second_count(s: srv1_root_mutation_poll_cadence)) * srv1_root_mutation_poll_tick_budget()
    > nat_to_int(n: second_count(s: srv1_root_mutation_approval_window())) + nat_to_int(n: second_count(s: srv1_root_mutation_poll_cadence))
    && srv1_root_mutation_expiry_overrun_ticks > 0
}

// THE RUNNER IS PATIENT LONGER THAN THE MODEL IS. The step timeout must clear the model's own worst
// case -- prelude, window, overrun -- and still leave the stated margin: a runner kill would mean the
// model failed to end its own wait, and that is a defect to fix rather than a number to raise. The
// 32-minute limit that killed 41972155901 is the counterexample these numbers are built against.
test fn the_step_timeout_clears_the_models_worst_case_by_the_stated_margin() -> Bool {
  let timeout_secs = nat_to_int(n: minute_count(m: srv1_root_mutation_approval_step_timeout_minutes())) * 60
  let model_worst_case = nat_to_int(n: second_count(s: srv1_root_mutation_prelude_allowance))
    + nat_to_int(n: second_count(s: srv1_root_mutation_approval_window()))
    + nat_to_int(n: second_count(s: srv1_root_mutation_poll_cadence)) * srv1_root_mutation_expiry_overrun_ticks
  timeout_secs >= model_worst_case + nat_to_int(n: second_count(s: srv1_root_mutation_step_margin))
    && model_worst_case > 32 * 60
}

// ONE ROW, TWO READERS. The instant this run stamps into the filing as expires_at and the bound the
// gate's own wait is measured against come off the SAME row in the approval model
// (gunbc.auth.approval_gate approval_request_window). Before this, the window was a literal in the run
// module and the broker's stamp was a separate read of it, which is exactly how run 41972155901 ended up
// with a runner killing its step two minutes before the deadline it had itself declared: two readers,
// two numbers. The claim fails the moment anyone gives one side its own value -- including by "temporarily"
// hardening a literal here or in the run module.
//
// WHY NO STAMPED INSTANT IS ASKED FOR HERE. approval_expires_at folds through Clock.TimestampAdd, an
// operation with no arm on the hermetic route, so a claim that called it would be UNOBSERVED rather than
// red -- a witness that cannot run proves nothing. DESIGN 3: a witness discriminates at ONE interface and
// takes the rest as supplied values, so this compares the two SECOND values the two readers hold, which is
// where a divergence would actually be introduced. Stamping an instant onto a record is the filing path's
// own work, and it is the same function every approval in the fleet passes through.
test fn the_filing_and_the_gate_wait_read_one_window_row() -> Bool {
  srv1_root_mutation_approval_window() == approval_request_window
    && nat_to_int(n: second_count(s: srv1_root_mutation_approval_window())) > 0
    && nat_to_int(n: minute_count(m: srv1_root_mutation_approval_step_timeout_minutes())) * 60
      < max_job_timeout_minutes * 60
}
