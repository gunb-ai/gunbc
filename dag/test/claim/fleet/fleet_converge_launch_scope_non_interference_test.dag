module test.claim.fleet_converge_launch_scope_non_interference

import std.types { String, Bool, Int, List }
import gunbc.compile_diagnostic_census {
  CompileDiagnosticCensus,
  CensusObserved,
  CensusNotRunnable,
  CompileDiagnosticCensusRow,
  census_blocking_rows,
  census_total_count,
}
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }

// THE LAUNCH-SCOPE NON-INTERFERENCE WALL AFTER ITS RUNG CLIMB.
//
// The compiler once admitted full-host observation families as excess fields on a
// LaunchEnvironmentConverge literal. The runtime probe in this module consequently constructed a
// request with a production-shaped runner-slot population and proved that the launch projection
// discarded it. That was a rung-2 guarantee: the invalid state remained writable and safety
// depended on the projection continuing to ignore it.
//
// gunbc.fleet_converge_plan now gives LaunchEnvironmentConverge exactly two positions -- host and
// observed_timers. Runner slots have a position on FullHostConverge, not on the launch constructor,
// so the invalid state is structurally impossible in an Accepted program. DESIGN 4b(4) requires the
// discriminating RED and its positive control to remain enrolled after that climb. They therefore
// live here as source handed to the compiler: the clean constructor must be accepted, while the
// same constructor carrying observed_slots must receive the exact FieldNotFound refusal.
//
// This is intentionally production-specific rather than another general payload-arm fixture. The
// generic field wall is independently exercised by test.claim.infer_record_lit_variant_field_witness;
// this pair establishes that the canonical LaunchEnvironmentConverge constructor actually has the
// narrow shape on the live tree. Its subject is the field boundary, not the downstream projection,
// so the retired runtime equality and its fabricated request do not survive beside the stronger
// construction wall.

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

fn launch_environment_probe_source(
  slots: String,
  activation: String,
  caps: String,
  fabric: String,
  all_once: String,
  all_terminal: String,
  all_emission: String,
) -> String {
  join([
    "module probe_launch_environment_scope\n",
    "import std.types { NonEmptyStr }\n",
    "import gunbc.fleet_converge_plan { FleetConvergeRequest, LaunchEnvironmentConverge }\n",
    "fn slots() -> FleetConvergeRequest { LaunchEnvironmentConverge { host: \"srv1\" as NonEmptyStr, observed_timers: []", slots, " } }\n",
    "fn activation() -> FleetConvergeRequest { LaunchEnvironmentConverge { host: \"srv1\" as NonEmptyStr, observed_timers: []", activation, " } }\n",
    "fn caps() -> FleetConvergeRequest { LaunchEnvironmentConverge { host: \"srv1\" as NonEmptyStr, observed_timers: []", caps, " } }\n",
    "fn fabric() -> FleetConvergeRequest { LaunchEnvironmentConverge { host: \"srv1\" as NonEmptyStr, observed_timers: []", fabric, " } }\n",
    "fn all_once() -> FleetConvergeRequest { LaunchEnvironmentConverge { host: \"srv1\" as NonEmptyStr, observed_timers: []", all_once, " } }\n",
    "fn all_terminal() -> FleetConvergeRequest { LaunchEnvironmentConverge { host: \"srv1\" as NonEmptyStr, observed_timers: []", all_terminal, " } }\n",
    "fn all_emission() -> FleetConvergeRequest { LaunchEnvironmentConverge { host: \"srv1\" as NonEmptyStr, observed_timers: []", all_emission, " } }\n",
  ], "")
}

data clean_census: CompileDiagnosticCensus =
  compile_dag_diagnostic_census(launch_environment_probe_source(
    slots: "", activation: "", caps: "", fabric: "", all_once: "", all_terminal: "", all_emission: "",
  ))

data foreign_axis_census: CompileDiagnosticCensus =
  compile_dag_diagnostic_census(
    launch_environment_probe_source(
      slots: ", observed_slots: []",
      activation: ", observed_activation_readiness: [], observed_unit_standings: []",
      caps: ", observed_caps: []",
      fabric: ", observed_fabric_cells: []",
      all_once: ", observed_slots: [], observed_activation_readiness: [], observed_unit_standings: [], observed_caps: [], observed_fabric_cells: []",
      all_terminal: ", observed_slots: [], observed_activation_readiness: [], observed_unit_standings: [], observed_caps: [], observed_fabric_cells: []",
      all_emission: ", observed_slots: [], observed_activation_readiness: [], observed_unit_standings: [], observed_caps: [], observed_fabric_cells: []",
    ),
  )

fn census_rows_or_empty(census: CompileDiagnosticCensus) -> List<CompileDiagnosticCensusRow> {
  match census {
    CensusObserved { rows: rows } => rows
    CensusNotRunnable { cause: _ } => []
  }
}

fn census_ran(census: CompileDiagnosticCensus) -> Bool {
  match census {
    CensusObserved { rows: _ } => true
    CensusNotRunnable { cause: _ } => false
  }
}

fn blocking_count(census: CompileDiagnosticCensus) -> Int {
  census_total_count(rows: census_blocking_rows(rows: census_rows_or_empty(census: census)))
}

fn row_identity(row: CompileDiagnosticCensusRow) -> String {
  join([row.diagnostic_class as String, "|", row.subject_name, "|", to_string(row.blocking)], "")
}

fn identity_count(census: CompileDiagnosticCensus, wanted: String) -> Int {
  fold(
    census_rows_or_empty(census: census),
    init: 0,
    f: (count, row) => if row_identity(row: row) == wanted { count + row.count } else { count },
  )
}

fn diagnostic_identities(census: CompileDiagnosticCensus) -> List<String> {
  map(census_rows_or_empty(census: census), row => row_identity(row: row))
}

// Every identity on either side is compared. This prevents a +1 FieldNotFound from concealing an
// unrelated diagnostic that disappeared between the two otherwise-identical fixture sources.
fn only_expected_identity_differs(
  clean: CompileDiagnosticCensus,
  refused: CompileDiagnosticCensus,
  expected_a: String,
  expected_b: String,
  expected_c: String,
  expected_d: String,
  expected_e: String,
) -> Bool {
  all(
    concat(diagnostic_identities(census: clean), diagnostic_identities(census: refused)),
    id => id == expected_a
      || id == expected_b
      || id == expected_c
      || id == expected_d
      || id == expected_e
      || identity_count(census: clean, wanted: id) == identity_count(census: refused, wanted: id),
  )
}

data observed_slots_field_not_found: String = "FieldNotFound|observed_slots|true"
data observed_activation_readiness_field_not_found: String = "FieldNotFound|observed_activation_readiness|true"
data observed_unit_standings_field_not_found: String = "FieldNotFound|observed_unit_standings|true"
data observed_caps_field_not_found: String = "FieldNotFound|observed_caps|true"
data observed_fabric_cells_field_not_found: String = "FieldNotFound|observed_fabric_cells|true"

// THE POSITIVE AND RED ARE ONE ENROLLED CLAIM. Refusing both sources would make the discriminating
// RED meaningless, while separating them would pay the same two live-tree compilations twice under
// the per-claim floor budget. The clean half admits seven canonical constructors; the mutated half
// rejects the seven former smuggling sites at their twenty foreign field occurrences.
test fn the_seven_foreign_axis_constructors_are_refused_at_all_twenty_fields() -> Bool {
  census_ran(census: clean_census)
    && blocking_count(census: clean_census) == 0
    && identity_count(census: clean_census, wanted: observed_slots_field_not_found) == 0
    && census_ran(census: foreign_axis_census)
    && blocking_count(census: foreign_axis_census) == blocking_count(census: clean_census) + 20
    && identity_count(census: foreign_axis_census, wanted: observed_slots_field_not_found) == 4
    && identity_count(census: foreign_axis_census, wanted: observed_activation_readiness_field_not_found) == 4
    && identity_count(census: foreign_axis_census, wanted: observed_unit_standings_field_not_found) == 4
    && identity_count(census: foreign_axis_census, wanted: observed_caps_field_not_found) == 4
    && identity_count(census: foreign_axis_census, wanted: observed_fabric_cells_field_not_found) == 4
    && only_expected_identity_differs(
         clean: clean_census,
         refused: foreign_axis_census,
         expected_a: observed_slots_field_not_found,
         expected_b: observed_activation_readiness_field_not_found,
         expected_c: observed_unit_standings_field_not_found,
         expected_d: observed_caps_field_not_found,
         expected_e: observed_fabric_cells_field_not_found,
       )
}
