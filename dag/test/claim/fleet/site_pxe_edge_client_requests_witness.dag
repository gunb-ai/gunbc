module test.claim.fleet.site_pxe_edge_client_requests_witness

import std.types { Bool, String, NonEmptyStr, EpochMs }
import std.optional { Present, Absent }
import std.algebra { string_contains }
import extdeps.network.mac { MacParsed, MacParseFailed, parse_mac_address, Eui48Address }
import gunbc.fleet.site_pxe_edge_client_requests { SitePxeEdgeRequestWindow, ClientRequestsRead, ClientRequestsUnread, site_pxe_edge_client_requests_unread, site_pxe_edge_client_requests_of, site_pxe_edge_client_requests_wire, site_pxe_edge_client_requests_argv, site_pxe_edge_request_window, site_pxe_edge_request_window_wire }

data witness_window_until_ms: EpochMs = 1700086400000

fn witness_window() -> SitePxeEdgeRequestWindow {
  site_pxe_edge_request_window(until_epoch_ms: witness_window_until_ms)
}

data witness_journal: String = "1.0 srv4 dnsmasq-dhcp[1]: DHCPDISCOVER(eno1) AA:BB:CC:00:11:22\n1.1 srv4 dnsmasq-dhcp[1]: vendor class: PXEClient:Arch:00007:UNDI:003016\n1.2 srv4 dnsmasq-dhcp[1]: DHCPREQUEST(eno1) 10.0.0.9 aa:bb:cc:00:11:22\n1.3 srv4 dnsmasq-dhcp[1]: DHCPDISCOVER(eno1) 00:11:22:33:44:55\n1.4 srv4 dnsmasq-dhcp[1]: DHCPDISCOVER(eno1) not-a-mac\n1.5 srv4 dnsmasq[1]: started\n"

fn witness_mac(text: String) -> Eui48Address? {
  match parse_mac_address(text: text) {
    MacParseFailed { error: _ } => none
    MacParsed { address: a } => Present { value: a }
  }
}

test fn a_sender_is_counted_once_per_mac_across_case_and_request_kind() -> Bool {
  match site_pxe_edge_client_requests_of(journal: witness_journal, window: witness_window()) {
    ClientRequestsUnread { reason: _ } => false
    ClientRequestsRead { macs: ms, request_lines: n, malformed_request_lines: bad, pxe_vendor_class_lines: v, window: _ } =>
      length(xs: ms) == 2 && n == 4 && bad == 1 && v == 1
        && ms |> any(m => witness_mac(text: "aa:bb:cc:00:11:22") == Present { value: m.mac } && m.requests == 2)
        && ms |> any(m => witness_mac(text: "00:11:22:33:44:55") == Present { value: m.mac } && m.requests == 1)
  }
}

test fn an_empty_journal_is_a_zero_reading_and_never_unread() -> Bool {
  match site_pxe_edge_client_requests_of(journal: "", window: witness_window()) {
    ClientRequestsUnread { reason: _ } => false
    ClientRequestsRead { macs: ms, request_lines: n, malformed_request_lines: _, pxe_vendor_class_lines: _, window: _ } => length(xs: ms) == 0 && n == 0
  }
}

test fn the_wire_states_it_is_not_a_host_attribution_and_an_unread_is_named() -> Bool {
  string_contains(s: site_pxe_edge_client_requests_wire(reading: site_pxe_edge_client_requests_of(journal: witness_journal, window: witness_window())), pattern: "not_a_host_attribution")
    && string_contains(s: site_pxe_edge_client_requests_wire(reading: site_pxe_edge_client_requests_of(journal: witness_journal, window: witness_window())), pattern: "line_shape=TRANSCRIBED-UNCITED")
    && string_contains(s: site_pxe_edge_client_requests_wire(reading: ClientRequestsUnread { reason: "x" }), pattern: "UNOBSERVABLE x")
}

test fn the_request_log_argv_reads_the_named_unit_journal_over_the_explicit_window() -> Bool {
  site_pxe_edge_client_requests_argv(unit: "gunbc-site-pxe-edge.service" as NonEmptyStr, window: witness_window())
    == ["journalctl", "-u", "gunbc-site-pxe-edge.service", "--since", "@1700000000", "--until", "@1700086400", "--no-pager", "-o", "short-unix"]
}

test fn the_window_survives_into_the_reading_and_the_receipt() -> Bool {
  match site_pxe_edge_client_requests_of(journal: witness_journal, window: witness_window()) {
    ClientRequestsUnread { reason: _ } => false
    ClientRequestsRead { macs: _, request_lines: _, malformed_request_lines: _, pxe_vendor_class_lines: _, window: w } =>
      w == witness_window()
  } && string_contains(s: site_pxe_edge_client_requests_wire(reading: site_pxe_edge_client_requests_of(journal: witness_journal, window: witness_window())), pattern: "window=since=@1700000000 until=@1700086400 output_cap=none")
}

data witness_malformed_layouts: String = "1.0 srv4 dnsmasq-dhcp[1]: DHCPDISCOVER(eno1) aa:bb:cc:00:11:22 00:11:22:33:44:55\n1.1 srv4 dnsmasq-dhcp[1]: DHCPDISCOVER(eno1) 00:11:22:33:44:55 aa:bb:cc:00:11:22\n1.2 srv4 dnsmasq-dhcp[1]: DHCPREQUEST(eno1) 10.0.0.9 extra aa:bb:cc:00:11:22\n"

test fn a_line_off_the_declared_layout_is_malformed_and_credits_no_mac() -> Bool {
  match site_pxe_edge_client_requests_of(journal: witness_malformed_layouts, window: witness_window()) {
    ClientRequestsUnread { reason: _ } => false
    ClientRequestsRead { macs: ms, request_lines: n, malformed_request_lines: bad, pxe_vendor_class_lines: _, window: _ } =>
      length(xs: ms) == 0 && n == 3 && bad == 3
  }
}

test fn only_an_unread_reading_reds_the_observe_run() -> Bool {
  site_pxe_edge_client_requests_unread(reading: ClientRequestsUnread { reason: "x" })
    && site_pxe_edge_client_requests_unread(reading: site_pxe_edge_client_requests_of(journal: "", window: witness_window())) == false
}
