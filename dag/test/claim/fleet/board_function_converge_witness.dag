module test.claim.fleet.board_function_converge_witness

import std.types { Bool, List, String }
import std.optional { Present, Absent }
import extdeps.boards.types { BmcGraphicsController, PcieErrorFirmwareFirstHandling }
import extdeps.boards.asrock_rack { asrock_altrad8ud_1l2t_catalog }
import gunbc.fleet.fleet_host_identity { operator_host_srv1 }
import gunbc.fleet.board_function_topology { PcieFunctionIdentity, PcieDetachRoute, asrock_altrad8ud_1l2t_bmc_graphics_route }
import gunbc.fleet.board_function_admission {
  RemovedByHostAfterBoot, PlannedFunction, board_function_removal, fleet_board_function_plans,
}
import gunbc.fleet.board_function_converge {
  PcieFunctionReading, PcieFunctionEnumerated, PcieFunctionNotEnumerated, PcieFunctionUnread,
  LinkControlReading, LinkControlRead, LinkControlUnread,
  BehindReading, PcieDetachObservation,
  BelowBridgeReading, BelowBridgeListed, BelowBridgeNotEnumerated, BelowBridgeUnread,
  PcieDetachDecision, DetachConverged, DetachApply, DetachRefused,
  pcie_detach_decision, converge_plan,
}
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// SUPPLIED READINGS AT THE DECISION'S BOUNDARY (DESIGN §3, a witness discriminates at one interface). The
// real producer, observe_pcie_detach over sysfs and setpci, runs on srv1 itself; its run is the PR's
// receipt, because no CI host carries this board.
fn route() -> PcieDetachRoute { asrock_altrad8ud_1l2t_bmc_graphics_route }

fn present(f: PcieFunctionIdentity) -> PcieFunctionReading {
  PcieFunctionEnumerated { vendor: f.vendor as String, device: f.device as String }
}

// Link Control as read from a root port whose link is up (0040: Common Clock Configuration only) and as
// read after Link Disable is Set (0050).
data link_enabled: LinkControlReading = LinkControlRead { value: 64 }
data link_disabled: LinkControlReading = LinkControlRead { value: 80 }

fn named_below() -> BelowBridgeReading {
  BelowBridgeListed { functions: map(route().behind, f => f.address as String) }
}

fn observation_below(root: PcieFunctionReading, bridge: PcieFunctionReading, vga: PcieFunctionReading, below: BelowBridgeReading, link: LinkControlReading) -> PcieDetachObservation {
  let r = route()
  PcieDetachObservation {
    root_port: root,
    detached: bridge,
    behind: map(r.behind, f => BehindReading { identity: f, reading: vga }),
    below: below,
    link: link,
  }
}

// What the host lists below the bridge when it holds exactly the named functions, or nothing when the bridge
// is gone -- the shape observe_below_bridge produces.
fn below_for(bridge: PcieFunctionReading) -> BelowBridgeReading {
  match bridge {
    PcieFunctionEnumerated { vendor: _, device: _ } => named_below()
    PcieFunctionNotEnumerated => BelowBridgeNotEnumerated
    PcieFunctionUnread { cause: _ } => BelowBridgeNotEnumerated
  }
}

fn observation(root: PcieFunctionReading, bridge: PcieFunctionReading, vga: PcieFunctionReading, link: LinkControlReading) -> PcieDetachObservation {
  observation_below(root: root, bridge: bridge, vga: vga, below: below_for(bridge: bridge), link: link)
}

fn decide(o: PcieDetachObservation) -> PcieDetachDecision { pcie_detach_decision(route: route(), observation: o) }

fn refused(d: PcieDetachDecision) -> Bool {
  match d { DetachRefused { cause: _ } => true _ => false }
}

fn vga() -> PcieFunctionIdentity {
  match route().behind.first() { Present { value: f } => f Absent => route().detached }
}

// A fresh boot: everything the firmware brought up is there, so the bridge is removed and the link disabled.
test fn a_fresh_boot_removes_the_bridge_and_disables_the_link() -> Bool {
  let r = route()
  decide(o: observation(root: present(f: r.root_port), bridge: present(f: r.detached), vga: present(f: vga()), link: link_enabled))
    == DetachApply { remove_detached: true, disable_link: true }
}

// Idempotent: a second run in the same boot applies nothing.
test fn a_removed_bridge_behind_a_disabled_link_is_converged() -> Bool {
  let r = route()
  decide(o: observation(root: present(f: r.root_port), bridge: PcieFunctionNotEnumerated, vga: PcieFunctionNotEnumerated, link: link_disabled))
    == DetachConverged
}

// Each half is judged on its own: removal alone is not convergence, and neither is the link alone.
test fn each_half_of_the_route_is_checked_on_its_own() -> Bool {
  let r = route()
  decide(o: observation(root: present(f: r.root_port), bridge: PcieFunctionNotEnumerated, vga: PcieFunctionNotEnumerated, link: link_enabled))
    == DetachApply { remove_detached: false, disable_link: true }
    && decide(o: observation(root: present(f: r.root_port), bridge: present(f: r.detached), vga: present(f: vga()), link: link_disabled))
    == DetachApply { remove_detached: true, disable_link: false }
}

// THE IDENTITY REDS. Each is a host whose tree is not the observed one; acting on it would remove or cut off
// a function the route never named.
test fn a_different_tree_refuses_before_anything_is_written() -> Bool {
  let r = route()
  let other = PcieFunctionEnumerated { vendor: "8086", device: "1563" }
  refused(d: decide(o: observation(root: other, bridge: present(f: r.detached), vga: present(f: vga()), link: link_enabled)))
    && refused(d: decide(o: observation(root: PcieFunctionNotEnumerated, bridge: present(f: r.detached), vga: present(f: vga()), link: link_enabled)))
    && refused(d: decide(o: observation(root: present(f: r.root_port), bridge: other, vga: present(f: vga()), link: link_enabled)))
    && refused(d: decide(o: observation(root: present(f: r.root_port), bridge: present(f: r.detached), vga: other, link: link_enabled)))
    && refused(d: decide(o: observation(root: present(f: r.root_port), bridge: PcieFunctionNotEnumerated, vga: present(f: vga()), link: link_disabled)))
}

// THE UNNAMED-FUNCTION RED. Removing the bridge removes everything below it, so a function there that the route
// does not name -- a second function of the VGA device, or one below a function the route names -- refuses
// before the bridge is touched; and a listing that could not be read is not an empty one.
test fn an_unnamed_function_below_the_bridge_refuses() -> Bool {
  let r = route()
  let named = map(r.behind, f => f.address as String)
  refused(d: decide(o: observation_below(root: present(f: r.root_port), bridge: present(f: r.detached), vga: present(f: vga()), below: BelowBridgeListed { functions: concat(named, ["0003:02:00.1"]) }, link: link_enabled)))
    && refused(d: decide(o: observation_below(root: present(f: r.root_port), bridge: present(f: r.detached), vga: present(f: vga()), below: BelowBridgeListed { functions: [] }, link: link_enabled)))
    && refused(d: decide(o: observation_below(root: present(f: r.root_port), bridge: present(f: r.detached), vga: present(f: vga()), below: BelowBridgeUnread { cause: "listing refused" }, link: link_enabled)))
    && decide(o: observation_below(root: present(f: r.root_port), bridge: present(f: r.detached), vga: present(f: vga()), below: named_below(), link: link_enabled))
      == DetachApply { remove_detached: true, disable_link: true }
}

// An unreadable reading is never read as absence.
test fn an_unread_reading_refuses() -> Bool {
  let r = route()
  let unread = PcieFunctionUnread { cause: "listing refused" }
  refused(d: decide(o: observation(root: present(f: r.root_port), bridge: unread, vga: PcieFunctionNotEnumerated, link: link_disabled)))
    && refused(d: decide(o: observation(root: present(f: r.root_port), bridge: PcieFunctionNotEnumerated, vga: unread, link: link_disabled)))
    && refused(d: decide(o: observation(root: present(f: r.root_port), bridge: PcieFunctionNotEnumerated, vga: PcieFunctionNotEnumerated, link: LinkControlUnread { cause: "setpci exited 1" })))
}

// The plan the converge route consumes carries this route: srv1's graphics removal is the ALTRAD8UD-1L2T's
// observed tree, not a route the converge module chose for itself.
test fn the_plan_carries_the_route_the_converge_acts_on() -> Bool {
  match board_function_removal(host: operator_host_srv1, catalog: asrock_altrad8ud_1l2t_catalog, f: BmcGraphicsController) {
    RemovedByHostAfterBoot { residue: _, route: r } => r == route()
    _ => false
  }
}

// A plan the route does not act on is reported, never refused and never claimed set: srv1's firmware-first
// setting is the operator's, and nothing here reads it back.
test fn an_operator_switch_is_reported_not_claimed() -> Bool {
  let plans = filter(fleet_board_function_plans(), p => (p.host as String) == (operator_host_srv1 as String)
    && p.subject == PlannedFunction { board_function: PcieErrorFirmwareFirstHandling })
  length(plans) == 1 && all(plans, p => {
    let line = converge_plan(plan: p)
    !line.refused && contains(line.text, "operator switch") && contains(line.text, "not claimed set")
  })
}
