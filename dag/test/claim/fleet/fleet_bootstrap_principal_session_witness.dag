module test.claim.fleet.fleet_bootstrap_principal_session_witness

import extdeps.network.endpoint { SocketAddress, socket_address, host_by_name }
import extdeps.dns.domain_name { DnsLabel, HostName, DomainName, PartiallyQualified }
import std.types { Bool, List, String, NonEmptyStr }
import gunbc.fleet.fleet_posix_accounts { fleet_posix_operator_user, fleet_bootstrap_principal_login }
import gunbc.host.host_cli_dependency { HostCliDependencyAbsence }
import extdeps.tools.sshpass { sshpass_cli_tool }
import gunbc.fleet.fleet_bootstrap_principal_session {
  FleetSshPrincipalSession,
  FleetSshKeySession,
  FleetSshPasswordSession,
  fleet_ssh_session_for_principal,
  fleet_bootstrap_credential_path_env,
  FleetBootstrapCredentialLocus,
  BootstrapCredentialFileHeld,
  BootstrapCredentialInRunEnvironment,
  BootstrapCredentialNotHeld,
  FleetBootstrapCredentialPathReady,
  FleetBootstrapCredentialPathAbsent,
  resolve_fleet_bootstrap_credential_path,
  PasswordLegPrerequisiteReady,
  PasswordLegPrerequisiteRefused,
  fleet_password_leg_from_host_observation,
  exec_as_fleet_principal_with_stdin_observed,
  FleetPrincipalLegRan,
  FleetPrincipalLegRefused,
}
import gunbc.fleet.fleet_known_hosts_anchor { SshTarget, portable_remote_words, FleetOpenSshTrustPolicy }
import std.optional { Present, Absent }
import test.claim.typed_remote_file_write_fleet_ssh_fixture {
  fixture_attempt,
  known_hosts_anchor_hermetic_witness_fixture,
  rental_known_hosts_anchor_hermetic_witness_fixture,
  fleet_openssh_trust_policy_hermetic_witness_fixture,
  fleet_ssh_execution_context_hermetic_witness_fixture,
}

// THE CONTROLS FOR ONE MEASURED DEFECT, AND THEY ARE DISCRIMINATING RATHER THAN DESCRIPTIVE.
//
// mode=spark_grants refused on every one of srv9-srv12 on 2026-09-11 (runs 34575801880, 34579018156,
// 34579022921, 34579027462) because gunbc.spark.managed_grant_install and
// gunbc.spark.grant_privileged_operation reached briansrls -- the bootstrap principal, which holds no
// fleet key on any host this repository provisioned -- over the KEY session. Every assertion below
// goes RED against that code and GREEN against the derivation that replaced it, which is what makes
// them evidence rather than restatement. The grant installer's own refusal receipt is the before-state.
fn session_is_password(session: FleetSshPrincipalSession) -> Bool {
  match session {
    FleetSshPasswordSession => true
    FleetSshKeySession => false
  }
}

// RED ON THE OLD CODE: the bootstrap principal resolved to whatever shaper each call site named, and
// two of them named the key session. There was no declaration this could even be asked of.
test fn the_bootstrap_principal_resolves_to_the_password_session() -> Bool {
  with_trust(rental: false, f: t => session_is_password(session: fleet_ssh_session_for_principal(principal: fleet_bootstrap_principal_login(), trust: t)))
}

fn with_trust(rental: Bool, f: fn(FleetOpenSshTrustPolicy) -> Bool) -> Bool {
  match fixture_attempt() {
    Absent => false
    Present { value: a } =>
      f(fleet_openssh_trust_policy_hermetic_witness_fixture(anchor: if rental { rental_known_hosts_anchor_hermetic_witness_fixture(attempt: a) } else { known_hosts_anchor_hermetic_witness_fixture(attempt: a) }))
  }
}

// A RENTED HOST THAT LOGS IN UNDER THE BOOTSTRAP NAME IS NOT THE FLEET'S ACCOUNT: it keeps the key
// session its declared credential names, and is never diverted onto the fleet administrator password.
test fn a_rental_logging_in_as_the_bootstrap_name_keeps_its_declared_key_session() -> Bool {
  with_trust(rental: true, f: t => !session_is_password(session: fleet_ssh_session_for_principal(principal: fleet_bootstrap_principal_login(), trust: t)))
}

// THE LOGIN IS NOT SPELLED TWICE, AND THERE IS NOW EXACTLY ONE SPELLING TO CHECK. The second literal
// (gunbc.spark.managed_access_bootstrap spark_operator_bootstrap_login) was deleted after review 63721
// read the fork as load-bearing: the derivation below compares against this name, so two literals that
// drifted apart would resolve every bootstrap leg to the key session and refuse. This asserts the
// derivation consumes the ACCOUNT MODEL rather than any string, so reintroducing a literal anywhere
// cannot leave it green while the session fact points at a login nobody uses.
test fn the_bootstrap_login_is_the_operator_account_from_the_account_model() -> Bool {
  (fleet_bootstrap_principal_login() as String) == (fleet_posix_operator_user.name as String)
}

// THE MANAGED EXECUTOR KEEPS THE KEY SESSION. The repair must not overshoot into "everything is a
// password leg": gunbc-automation is an account this repository created and keyed, and its proof leg
// in gunbc.spark.managed_access_apply is the one that establishes key-only authentication. If this
// went password-only, that proof would be testing something else entirely.
test fn the_managed_executor_resolves_to_the_key_session() -> Bool {
  with_trust(rental: false, f: t => managed_executor_is_key(t: t))
}

fn managed_executor_is_key(t: FleetOpenSshTrustPolicy) -> Bool {
  !session_is_password(session: fleet_ssh_session_for_principal(principal: "gunbc-automation" as NonEmptyStr, trust: t))
    && !session_is_password(session: fleet_ssh_session_for_principal(principal: "gunbc-inference" as NonEmptyStr, trust: t))
    && !session_is_password(session: fleet_ssh_session_for_principal(principal: "ghrunner" as NonEmptyStr, trust: t))
    && !session_is_password(session: fleet_ssh_session_for_principal(principal: "root" as NonEmptyStr, trust: t))
}

// A HELD FILE IS THE PATH THAT WAS HELD, unchanged. The operator-workstation entry materializes its own
// owner-only file, so the locus must pass it through rather than reaching for the runner's environment.
test fn a_held_credential_file_resolves_to_that_exact_path() -> Bool {
  match resolve_fleet_bootstrap_credential_path(
    locus: BootstrapCredentialFileHeld { path: "/run/gunbc-witness-credential" as NonEmptyStr },
  ) {
    FleetBootstrapCredentialPathReady { path: p } => (p as String) == "/run/gunbc-witness-credential"
    FleetBootstrapCredentialPathAbsent { cause: _ } => false
  }
}

// NOT-HELD REFUSES, AND THE REFUSAL NAMES THE PRINCIPAL IT IS ABOUT. This is the arm that keeps a leg
// with no credential from silently becoming a key leg -- the exact substitution that produced the
// srv9-srv12 refusals, one layer down.
test fn declaring_no_credential_refuses_and_names_the_bootstrap_principal() -> Bool {
  match resolve_fleet_bootstrap_credential_path(locus: BootstrapCredentialNotHeld) {
    FleetBootstrapCredentialPathAbsent { cause: why } =>
      string_contains(why as String, fleet_bootstrap_principal_login() as String)
        && string_contains(why as String, "NOT attempted")
    FleetBootstrapCredentialPathReady { path: _ } => false
  }
}

// THE ENVIRONMENT VARIABLE NAMES A PATH, NOT A SECRET, and it says so in its own name. Carried over
// from the witness that guarded it at its previous home so the rehoming did not drop the check.
test fn the_credential_environment_variable_names_a_file_and_not_a_secret() -> Bool {
  string_contains(fleet_bootstrap_credential_path_env as String, "FILE")
    && !string_contains(fleet_bootstrap_credential_path_env as String, "PASSWORD")
    && !string_contains(fleet_bootstrap_credential_path_env as String, "SECRET")
}

// ── THE DISCRIMINATOR, BY EXECUTION ─────────────────────────────────────────────────────────────
//
// Everything above reads the derivation. These two read WHICH UPSTREAM OPERATION THE LEG ACTUALLY
// REACHED, which is the only thing that would have caught the defect: the old code produced a
// perfectly well-typed leg, it just sent it down ssh.Session instead of ssh.PasswordFileSsh. The two
// hermetic mocks answer with different stdout, so the operation is observable rather than inferred --
// and the bootstrap assertion below is RED against the pre-repair code, where this principal reached
// the key transport.
data witness_bootstrap_target_address: SocketAddress = socket_address(host: host_by_name(name: HostName { name: DomainName { labels: ["srv-test" as DnsLabel, "example" as DnsLabel] }, qualification: PartiallyQualified }), port: 22)

fn witness_leg_stdout(principal: NonEmptyStr, credential: FleetBootstrapCredentialLocus) -> String? {
  match fleet_ssh_execution_context_hermetic_witness_fixture() {
    Absent => none
    Present { value: context } =>
      match portable_remote_words(raws: ["id", "-un"]) {
        Absent => none
        Present { value: words } =>
          match exec_as_fleet_principal_with_stdin_observed(
            context: context,
            target: SshTarget { address: witness_bootstrap_target_address, principal: principal },
            words: words,
            stdin_payload: "",
            credential: credential,
            absence: none,
          ) {
            FleetPrincipalLegRefused { cause: _ } => none
            FleetPrincipalLegRan { session: _, result: r } => Present { value: r.stdout }
          }
      }
  }
}

test fn the_bootstrap_principal_leg_reaches_the_password_transport_by_execution() -> Bool {
  match witness_leg_stdout(
    principal: fleet_bootstrap_principal_login(),
    credential: BootstrapCredentialFileHeld { path: "/run/gunbc-witness-credential" as NonEmptyStr },
  ) {
    Absent => false
    Present { value: out } =>
      out == "mock-password-file-ssh-portable-words-stdin"
        && out != "mock-ssh-portable-words-stdin"
  }
}

test fn the_managed_principal_leg_reaches_the_key_transport_by_execution() -> Bool {
  match witness_leg_stdout(
    principal: "gunbc-automation" as NonEmptyStr,
    credential: BootstrapCredentialNotHeld,
  ) {
    Absent => false
    Present { value: out } =>
      out == "mock-ssh-portable-words-stdin"
        && out != "mock-password-file-ssh-portable-words-stdin"
  }
}

// THE FIXTURE BINDS THE MODEL, THE ORACLE STAYS A LITERAL, and the split is deliberate. The
// injected absence takes its tool from sshpass_cli_tool.program so the INPUT tracks the enrolled
// declaration; the assertion below checks the rendered cause against the bare word "sshpass",
// which is grounded in the upstream this repository cites (sourceforge.net/projects/sshpass) and
// is therefore an INDEPENDENT oracle. Binding both ends would make the row self-satisfying -- a
// cause built from a name, checked against the same name, cannot fail -- and that is the
// measure-itself shape §5 rejects. Kept apart, renaming the binary reddens this row, which is the
// correct outcome: it forces a deliberate update rather than silently following.
//
// THE REFUSAL WITNESS EXERCISES THE SEAM, NOT THE HELPER, and that distinction is the whole point
// of the row. An earlier cut called fleet_password_leg_from_host_observation directly and asserted
// it returns PasswordLegPrerequisiteRefused -- true, and useless as a regression wall: the claim
// being made is "missing sshpass, so the leg refuses BEFORE the transport", and a test of the
// helper alone stays green if exec_as_fleet_principal_with_stdin_observed later ignores the helper
// result and calls password_file_ssh_exec_portable_words_with_stdin anyway. The ordering is the
// subject, so the integration function must be what runs.
//
// THE `FleetPrincipalLegRan => false` ARM IS THE ASSERTION THAT THE TRANSPORT WAS NOT REACHED. Both
// transports carry a mock_response with distinct stdout, so under the hermetic envelope a leg that
// did reach one comes back as Ran with that stdout -- there is no way for the transport to run and
// this row to stay green. Refused is only reachable by stopping first.
//
// THE REFUSAL HAS ITS OWN WITNESS, hermetic, because the discriminator above must not carry it.
// Both call the pure decision with an INJECTED observation, so neither is moved by the PATH of the
// host that runs it: the discriminator supplies a satisfied prerequisite and stays a statement
// about which TRANSPORT the principal derivation selects, and this pair is the statement about the
// prerequisite. Before the split the discriminator observed PATH inline and went red on any host
// without sshpass -- passing on srv1/srv2 and failing on srv3/srv4, flaky by whichever runner
// picked the job up, while appearing to measure transport selection.
test fn a_missing_password_session_binary_refuses_before_the_transport() -> Bool {
  match fleet_ssh_execution_context_hermetic_witness_fixture() {
    Absent => false
    Present { value: context } =>
      match portable_remote_words(raws: ["id", "-un"]) {
        Absent => false
        Present { value: words } =>
          match exec_as_fleet_principal_with_stdin_observed(
            context: context,
            target: SshTarget {
              address: witness_bootstrap_target_address,
              principal: fleet_bootstrap_principal_login(),
            },
            words: words,
            stdin_payload: "",
            credential: BootstrapCredentialFileHeld {
              path: "/run/gunbc-witness-credential" as NonEmptyStr,
            },
            absence: Present {
              value: HostCliDependencyAbsence {
                tool: sshpass_cli_tool.program.invocation,
                hint: "apt install sshpass",
              },
            },
          ) {
            FleetPrincipalLegRan { session: _, result: _ } => false
            FleetPrincipalLegRefused { cause: c } =>
              string_contains(c as String, "sshpass")
                && string_contains(c as String, "NOT attempted")
          }
      }
  }
}

// THE SATISFIED SIDE, which is what makes the row above discriminating rather than a one-armed
// assertion: with no absence the same fold reaches the credential and yields the password file, so
// a refusal that fired unconditionally would redden here.
test fn a_present_password_session_binary_reaches_the_credential() -> Bool {
  match fleet_password_leg_from_host_observation(
    absence: none,
    credential: BootstrapCredentialFileHeld { path: "/run/gunbc-witness-credential" as NonEmptyStr },
  ) {
    PasswordLegPrerequisiteReady { password_file: p } =>
      (p as String) == "/run/gunbc-witness-credential"
    PasswordLegPrerequisiteRefused { cause: _ } => false
  }
}
