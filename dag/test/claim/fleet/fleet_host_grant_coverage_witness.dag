module test.claim.fleet.fleet_host_grant_coverage_witness

import std.types { Bool, String, NonEmptyStr }
import std.optional { Absent, Present }
import std.algebra { string_contains }
import std.content_hash { serialize_content_hash }
import gunbc.fleet.fleet_converge_scope { FullHost }
import gunbc.fleet.fleet_converge_terminal { AwaitingCapability, FullyApplied, PartiallyApplied }
import gunbc.fleet.fleet_host_grant_coverage {
  HostGrantObservation,
  host_grant_rows,
  host_grant_observation_unobserved_no_transaction,
}
import gunbc.fleet.fleet_converge_plan {
  FleetConvergeRequest,
  FullHostConverge,
  FleetConvergeApplyAdmission,
  ApplyAdmitted,
  ApplyAwaitingCapability,
  ApplyMemberSetMismatch,
  fleet_converge_plan_artifact,
  fleet_converge_apply_artifact_admits,
  fleet_converge_member_set_fingerprint,
  fleet_converge_scope_wire,
}
import gunbc.runner.runner_service_activation { runner_activation_readiness_unobserved_no_transaction, runner_unit_standings_unobserved_no_transaction }
import gunbc.fabric.fabric_cell_observation_admission { fabric_cell_observation_unobserved }
import gunbc.fleet.fleet_host_identity { operator_host_srv3 }
import gunbc.runner.runner_slot_retirement { SlotRetirementEvidenceAbsent }
import test.claim.fleet.fleet_host_grant_fixture {
  witness_grants_rendered,
  witness_grants_outside_the_model,
  witness_grants_listed_installed_unreadable,
  witness_grants_missing,
  witness_grants_listing_unread,
  witness_grant_rules,
}

data grant_host: NonEmptyStr = "srv3" as NonEmptyStr

fn grant_request(grants: HostGrantObservation) -> FleetConvergeRequest {
  FullHostConverge {
    host: grant_host,
    observed_timers: [],
    observed_caps: [],
    observed_slots: [],
    observed_fabric_cells: fabric_cell_observation_unobserved(host: operator_host_srv3),
    observed_activation_readiness: runner_activation_readiness_unobserved_no_transaction,
    observed_unit_standings: runner_unit_standings_unobserved_no_transaction,
    observed_retirement: SlotRetirementEvidenceAbsent { cause: "this fixture binds no retirement observation" },
    observed_host_grants: grants,
  }
}

fn grant_admission(grants: HostGrantObservation) -> FleetConvergeApplyAdmission {
  let r = grant_request(grants: grants)
  fleet_converge_apply_artifact_admits(
    planned_host_text: grant_host as String,
    planned_scope_wire: fleet_converge_scope_wire(scope: FullHost),
    planned_fingerprint_text: serialize_content_hash(hash: fleet_converge_member_set_fingerprint(request: r)) as String,
    observed: r,
  )
}

fn grant_plan_body(grants: HostGrantObservation) -> String {
  match fleet_converge_plan_artifact(
    host: grant_host,
    prior_generation: 0,
    observed_timers: [],
    observed_caps: [],
    observed_slots: [],
    observed_fabric_cells: fabric_cell_observation_unobserved(host: operator_host_srv3),
    observed_activation_readiness: runner_activation_readiness_unobserved_no_transaction,
    observed_unit_standings: runner_unit_standings_unobserved_no_transaction,
    observed_retirement: SlotRetirementEvidenceAbsent { cause: "this fixture binds no retirement observation" },
    observed_host_grants: grants,
  ) {
    Absent => ""
    Present { value: artifact } => artifact.plan_body
  }
}

// The specimen: srv3 apply 39127216304's first host grant.
data specimen_rule: String = "/usr/bin/install -d -m 00755 -o ghrunner -g ghrunner /var/lib/gunbc/fleet-converge"

// RED: a host whose installed sudoers lacks the rule refuses AwaitingCapability, naming the exact
// missing rule, at ADMISSION -- before the apply script (and its first `sudo -n`) can run.
test fn a_host_without_the_rule_refuses_awaiting_capability_naming_it() -> Bool {
  match grant_admission(grants: witness_grants_missing(host: grant_host)) {
    ApplyAwaitingCapability { capability: c } =>
      string_contains(s: c, pattern: "missing sudoers rule: ")
        && string_contains(s: c, pattern: specimen_rule)
    _ => false
  }
}

// Positive control: the same host with the rule rendered-and-installed admits.
test fn a_host_with_the_rendered_rule_admits() -> Bool {
  match grant_admission(grants: witness_grants_rendered(host: grant_host)) {
    ApplyAdmitted => true
    _ => false
  }
}

// §5: a probe that cannot observe is unobserved, never covered.
test fn an_unread_listing_refuses_as_unobserved_never_covered() -> Bool {
  match grant_admission(grants: witness_grants_listing_unread()) {
    ApplyAwaitingCapability { capability: c } => string_contains(s: c, pattern: "unobserved sudoers rule")
    _ => false
  } && match grant_admission(grants: host_grant_observation_unobserved_no_transaction) {
    ApplyAwaitingCapability { capability: _ } => true
    _ => false
  }
}

// Listed by sudo but not rendered by us: admits, typed, printed as one countable plan.txt line.
test fn a_rule_covered_outside_the_model_admits_and_is_printed() -> Bool {
  let g = witness_grants_outside_the_model(host: grant_host)
  let body = grant_plan_body(grants: g)
  match grant_admission(grants: g) {
    ApplyAdmitted => true
    _ => false
  } && string_contains(s: body, pattern: "# host-grants covered-outside-the-model (")
    && string_contains(s: body, pattern: specimen_rule)
}

// Listed, but the drop-in (root:root 0440) was unreadable: covered-source-unobserved, admits,
// printed -- and never counted as rendered.
test fn listed_with_an_unreadable_dropin_admits_as_source_unobserved_not_rendered() -> Bool {
  let g = witness_grants_listed_installed_unreadable(host: grant_host)
  let body = grant_plan_body(grants: g)
  match grant_admission(grants: g) {
    ApplyAdmitted => true
    _ => false
  } && string_contains(s: body, pattern: "# host-grants covered-source-unobserved (")
    && !string_contains(s: body, pattern: "# host-grants covered-outside-the-model (")
}

// The standing is a PREMISE: moving it moves the member-set fingerprint, so a plan taken over a
// missing rule cannot be applied after the rule arrives (or the reverse) without a re-plan.
test fn the_grant_standing_moves_the_member_set_fingerprint() -> Bool {
  fleet_converge_member_set_fingerprint(request: grant_request(grants: witness_grants_missing(host: grant_host)))
    != fleet_converge_member_set_fingerprint(request: grant_request(grants: witness_grants_rendered(host: grant_host)))
}

// The terminal agrees with admission: AwaitingCapability, not FullyApplied, over a missing rule.
test fn the_plan_terminal_is_awaiting_capability_over_a_missing_rule() -> Bool {
  let body = grant_plan_body(grants: witness_grants_missing(host: grant_host))
  string_contains(s: body, pattern: "# host-grants missing (")
}

// Pairing: the fixture's rules are the renderer's, and srv3 has a host-wide rule set to cover.
test fn the_specimen_rule_is_among_the_hosts_modeled_rules() -> Bool {
  host_grant_rows(host: grant_host, observation: witness_grants_rendered(host: grant_host)) != []
}
