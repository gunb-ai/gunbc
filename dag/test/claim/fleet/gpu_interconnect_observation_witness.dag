module test.claim.fleet.gpu_interconnect_observation_witness

// A WITNESS IS AN ASSERTION THAT COULD HAVE COME OUT FALSE. What is under test is not the sentence "srv1 has
// no GPU P2P" -- any corpus can carry that sentence -- but the joins that let a consumer act on it: absence
// must require a reading in BOTH directions rather than a plausible-looking one; an explanation must not be
// usable as a premise; and a gap must arrive with the obligation to close it instead of silently shrinking
// the table. The negatives below are the load-bearing lines: the same joins over a pair with no readings, or
// over a relayed-only collective, must answer no.

import std.types { Bool, List, NonEmptyStr, String }
import std.nat { Nat }
import std.algebra { string_contains }
import std.measure { Bandwidth, ByteSize, Microsecond, Second, bandwidth, bandwidth_count, byte_size, byte_size_count, microsecond, microsecond_count, second_count }
import std.optional { Absent, Present }
import std.content_hash { lower_hex_64 }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import extdeps.pci.identity { PciAddress }
import extdeps.storage.types { PcieLink, Gen4, Gen5, pcie_generation_wire }
import product.host_identity { HostIdentity }
import product.placement_supply { PhysicalAssetIdentity }
import gunbc.fleet.fleet_host_identity { operator_host_srv1 }
import gunbc.fleet.fleet_asset_identity { gpu_board_01, gpu_board_04, gpu_board_05 }
import gunbc.fleet.gpu_interconnect_observation {
  HypothesisStanding, Hypothesis, Bet,
  Srv1ReadingWarrant, ReadByThisSession, Relayed, Unread, srv1_reading_is_read, srv1_reading_obligation,
  PeerAccessVerdict, GpuPeerAccessReading, PeerToPeerPossible, PeerToPeerRefusedByChipset,
  PeerToPeerRefusedUnattributed, PeerToPeerRefusedByLinkType, PeerToPeerVerdictNotAnswered, peer_access_is_absent,
  gpu_pair_peer_access_is_absent, gpu_pair_interconnect_readings_complete,
  srv1_gpu_pcie_link_readings, gpu_pcie_link_is_narrower_than_the_endpoint,
  srv1_acs_redirects_at_both_root_ports, srv1_iommu_translates_both_gpu_groups,
  srv1_interconnect_explanations, interconnect_explanations_on,
  srv1_gpu_pair_topology_readings, srv1_gpu_peer_access_readings, srv1_collective_transport_readings, CollectiveTransportReading,
  srv1_collective_transport_readings_unloaded_2026_11_09,
  srv1_nccl_arm_default, srv1_nccl_arm_p2p_disabled,
  srv1_collective_read_obligation, srv1_collective_read_executed_2026_11_09,
  srv1_collective_read_window_duration, srv1_collective_read_measurement_duration, srv1_window_seconds_between,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// srv1's two PRO 6000s: the chipset refused peer access in both directions, the topology instrument put the
// pair at NODE across two host bridges, the links are narrower than the cards advertise, both root ports
// redirect with ACS, and the SMMU translates both GPU groups.
// Does this row's verdict claim a cause its own instrument could have reported? `nvidia-smi topo -p2p r` prints a
// token whose wording names the chipset; cudaDeviceCanAccessPeer answers can-yes-or-can-no and nothing else, so a
// chipset arm on one of those rows is a cause borrowed from a different instrument. Retyping a CUDA row as
// PeerToPeerRefusedByChipset, or dropping CNS from a topo row, fails here -- which is the point.
fn verdict_attribution_is_honest(r: GpuPeerAccessReading) -> Bool {
  let from_topo = string_contains(s: r.instrument as String, pattern: "nvidia-smi topo")
  match r.verdict {
    PeerToPeerRefusedByChipset { token: t } => from_topo && (t as String) == "CNS"
    PeerToPeerRefusedUnattributed { token: t } => !from_topo && (t as String) == "0"
    PeerToPeerPossible { token: _ } => false
    PeerToPeerRefusedByLinkType { token: _ } => false
    PeerToPeerVerdictNotAnswered { token: _ } => false
  }
}

test fn srv1_pair_reads_as_no_peer_access_over_two_host_bridges() -> Bool {
  gpu_pair_peer_access_is_absent(host: operator_host_srv1, left_board: gpu_board_04, right_board: gpu_board_01)
    && srv1_gpu_pair_topology_readings.length() == 1
    && srv1_gpu_pair_topology_readings.all(t =>
      (t.link_code as String) == "NODE" && t.separate_host_bridges
        && (t.left_root_port as String) == "0001:00:01.0" && (t.right_root_port as String) == "0004:00:01.0"
        && srv1_reading_is_read(w: t.warrant))
    && srv1_acs_redirects_at_both_root_ports()
    && srv1_iommu_translates_both_gpu_groups()
    && srv1_gpu_peer_access_readings.length() == 4
    && srv1_gpu_peer_access_readings.all(r => srv1_reading_is_read(w: r.warrant)
      && peer_access_is_absent(r: r) && verdict_attribution_is_honest(r: r))
    // Two rows per cause, and neither cause is allowed to migrate: the chipset answer comes from the two
    // nvidia-smi topo tokens, the causeless answer from the two CUDA runtime calls.
    && srv1_gpu_peer_access_readings.filter(r => match r.verdict {
         PeerToPeerRefusedByChipset { token: _ } => true
         PeerToPeerRefusedUnattributed { token: _ } => false
         PeerToPeerPossible { token: _ } => false
         PeerToPeerRefusedByLinkType { token: _ } => false
         PeerToPeerVerdictNotAnswered { token: _ } => false
       }).length() == 2
    && srv1_gpu_peer_access_readings.filter(r => match r.verdict {
         PeerToPeerRefusedUnattributed { token: _ } => true
         PeerToPeerRefusedByChipset { token: _ } => false
         PeerToPeerPossible { token: _ } => false
         PeerToPeerRefusedByLinkType { token: _ } => false
         PeerToPeerVerdictNotAnswered { token: _ } => false
       }).length() == 2
    && srv1_gpu_pcie_link_readings.length() == 2
    && srv1_gpu_pcie_link_readings.all(k => gpu_pcie_link_is_narrower_than_the_endpoint(k: k)
      && pcie_generation_wire(g: k.endpoint_advertises.generation) == "gen5" && pcie_generation_wire(g: k.negotiated.generation) == "gen4" && k.negotiated.lane_count == 16)
}

// THE DISCRIMINATORS ON ABSENCE. A pair with no readings is NOT absent -- it is unread, which is a different
// thing and the one that keeps a missing instrument from becoming a finding. And a single yes in one direction
// defeats absence, so the join is not merely "some reading refuses".
test fn absence_requires_a_refusal_in_every_direction() -> Bool {
  !gpu_pair_peer_access_is_absent(host: operator_host_srv1, left_board: gpu_board_04, right_board: gpu_board_05)
    && !gpu_pair_peer_access_is_absent(host: operator_host_srv1, left_board: gpu_board_05, right_board: gpu_board_01)
    && peer_access_is_absent(r: GpuPeerAccessReading {
      host: operator_host_srv1, from_board: gpu_board_04, to_board: gpu_board_01,
      instrument: "fixture" as NonEmptyStr,
      verdict: PeerToPeerRefusedByChipset { token: "CNS" as NonEmptyStr },
      warrant: ReadByThisSession { read_on: "fixture" as NonEmptyStr, instrument: "fixture" as NonEmptyStr },
    })
    && !peer_access_is_absent(r: GpuPeerAccessReading {
      host: operator_host_srv1, from_board: gpu_board_04, to_board: gpu_board_01,
      instrument: "fixture" as NonEmptyStr,
      verdict: PeerToPeerPossible { token: "OK" as NonEmptyStr },
      warrant: ReadByThisSession { read_on: "fixture" as NonEmptyStr, instrument: "fixture" as NonEmptyStr },
    })
}

// THE COLLECTIVE SWEEP IS FIRST-HAND IN BOTH ARMS, AND THE ARMS ARE NOT COPIES OF EACH OTHER. Both halves of
// the TP=2 gate are now read on this host, so the join is true -- and it must stay false for a pair with no
// readings, which is the line that keeps a missing instrument from reading as a finding. The bands are the
// discriminators: the four default-arm rows all finish under 6 ms and two of them clear 10 GB/s, while the
// NCCL_P2P_DISABLE=1 arm has a row over 10 ms and no row at 10 GB/s at all. An edit that filled one arm from
// the other -- the exact failure mode a truncated table invites -- fails one of these four lines, and one that
// dropped the re-run obligation fails the last two.
// WHAT A WARRANT SAYS OUT LOUD, whatever its shape: the reading's own words. Used to check that every row of
// the sweep carries its receipt, not just that a row exists.
fn warrant_text(w: Srv1ReadingWarrant) -> String {
  match w {
    ReadByThisSession { read_on: _, instrument: i } => i as String
    Relayed { asked_of: _, answered_on: _, said: s, read_obligation: _ } => s as String
    Unread { read_obligation: o } => o as String
  }
}

fn arm_rows(arm: NonEmptyStr) -> List<CollectiveTransportReading> {
  srv1_collective_transport_readings.filter(c => (c.env_arm as String) == (arm as String))
}

// WHEN a collective row was read, in the row's own words. The loaded sweep and the unloaded re-run are two
// different runs of the same instrument, and the claims about them are opposite; a consumer that cannot say
// which run a row belongs to cannot tell the two stories apart, so the run is part of what the row states.
fn read_on_of(w: Srv1ReadingWarrant) -> String {
  match w {
    ReadByThisSession { read_on: r, instrument: _ } => r as String
    Relayed { asked_of: _, answered_on: _, said: s, read_obligation: _ } => s as String
    Unread { read_obligation: o } => o as String
  }
}

fn arm_rows_in(list: List<CollectiveTransportReading>, arm: NonEmptyStr) -> List<CollectiveTransportReading> {
  list.filter(c => (c.env_arm as String) == (arm as String))
}

// The two arms at ONE size, within tolerance: each arm must be at least `numerator/denominator` of the other.
// The ratio pair is written that way on purpose -- `a*D >= B*N` and `B*D >= A*N` bounds the RATIO, so passing
// N=8,D=10 means neither arm is below four-fifths of the other. (The first cut of this helper passed N=5,D=4,
// which asks a >= 1.25b AND b >= 1.25a: unsatisfiable, so the control read false on correct data and the
// failure was in the test, not the machine -- the kind of mistake a tolerance written as one inequality hides.)
// Pinning both rows to the same message size is what makes this the pair at that size and not any two rows
// that happen to be close: the 16 KiB pair is uninteresting and would pass any tolerance, which is exactly how
// a vacuous control is born.
fn arms_within(list: List<CollectiveTransportReading>, at_bytes: ByteSize, numerator: Nat, denominator: Nat) -> Bool {
  list.any(a => list.any(b =>
    (a.env_arm as String) == (srv1_nccl_arm_default as String)
      && (b.env_arm as String) == (srv1_nccl_arm_p2p_disabled as String)
      && message_bytes_count(a) == byte_size_count(at_bytes)
      && message_bytes_count(b) == byte_size_count(at_bytes)
      && bandwidth_count(b: bus_bw_of(c: a)) * denominator >= bandwidth_count(b: bus_bw_of(c: b)) * numerator
      && bandwidth_count(b: bus_bw_of(c: b)) * denominator >= bandwidth_count(b: bus_bw_of(c: a)) * numerator))
}

fn elapsed_of(c: CollectiveTransportReading) -> Microsecond {
  match c.elapsed {
    Present { value: e } => e
    Absent => microsecond(count: 0)
  }
}

// The optional measurement cells are optional, so a consumer says what absent means instead of letting an
// absent cell compare equal to a zero-filled one. Both helpers are only used where the row is a READ row,
// and the sizes they pin are nonzero, so `Absent => 0` can never satisfy a comparison here by accident.
fn message_bytes_count(c: CollectiveTransportReading) -> Nat {
  match c.message_bytes {
    Present { value: v } => byte_size_count(v)
    Absent => 0
  }
}

fn transport_of(c: CollectiveTransportReading) -> String {
  match c.transport {
    Present { value: t } => t as String
    Absent => ""
  }
}

fn bus_bw_of(c: CollectiveTransportReading) -> Bandwidth {
  match c.bus_bandwidth {
    Present { value: b } => b
    Absent => bandwidth(0)
  }
}

test fn the_collective_sweep_is_first_hand_and_the_two_arms_differ() -> Bool {
  let default_arm = arm_rows(arm: srv1_nccl_arm_default)
  let disabled_arm = arm_rows(arm: srv1_nccl_arm_p2p_disabled)
  gpu_pair_interconnect_readings_complete(host: operator_host_srv1, left_board: gpu_board_04, right_board: gpu_board_01)
    && !gpu_pair_interconnect_readings_complete(host: operator_host_srv1, left_board: gpu_board_04, right_board: gpu_board_05)
    && srv1_collective_transport_readings.length() == 8
    && default_arm.length() == 4
    && disabled_arm.length() == 4
    && srv1_collective_transport_readings.all(c => srv1_reading_is_read(w: c.warrant)
      && match srv1_reading_obligation(w: c.warrant) { Absent => true Present { value: _ } => false }
      && match c.transport { Present { value: t } => (t as String) == "SHM/direct" Absent => false })
    && srv1_collective_transport_readings.all(c => string_contains(s: warrant_text(w: c.warrant), pattern: "nccl_test.py")
      && string_contains(s: warrant_text(w: c.warrant), pattern: "2ad6245e058d"))
    && default_arm.all(c => microsecond_count(m: elapsed_of(c: c)) < 6000)
    && disabled_arm.any(c => microsecond_count(m: elapsed_of(c: c)) >= 10000)
    && default_arm.any(c => bandwidth_count(b: bus_bw_of(c: c)) >= 10000000000)
    && !disabled_arm.any(c => bandwidth_count(b: bus_bw_of(c: c)) >= 10000000000)
    && any(srv1_collective_read_executed_2026_11_09.containers_removed, c => string_contains(s: c as String, pattern: "lil-flash-next"))
    // THE RECORD AND THE ROWS IT PRODUCED NAME THE SAME INSTRUMENT, BY DIGEST. That link -- not a sentence
    // saying "these rows came from that run" -- is what makes the two agree: a row re-measured with a different
    // instrument, or a record pasted over someone else's sweep, stops matching.
    && srv1_collective_transport_readings_unloaded_2026_11_09.all(r =>
      r.instrument_sha256 == srv1_collective_read_executed_2026_11_09.instrument_sha256 && r.host == operator_host_srv1)
    && srv1_collective_transport_readings_unloaded_2026_11_09.length() == 8
}

// THE TWO RUNS NAME THEIR ARMS WITH THE SAME VALUES. This is the control that caught a real defect in the rows
// I added: the 2026-11-08 pair names the disabled arm "NCCL_P2P_DISABLE=1" and my unloaded rows wrote
// "p2pdisabled", so arm_rows_in over the NEW rows returned an EMPTY list and the "no penalty" assertions were
// about nothing -- a negative control that selects nothing is the same mistake as a self-confirming oracle, and
// it survived my own reading of the test because one conjunct counted rows and only that one went red. The
// labels are two values in the module now; this claim refuses any other spelling in either run, so a third run
// cannot drift out of the comparison, and it pins four rows per arm per run.
test fn the_two_runs_name_their_arms_with_the_same_labels() -> Bool {
  let loaded = srv1_collective_transport_readings
  let unloaded = srv1_collective_transport_readings_unloaded_2026_11_09
  loaded.length() == 8
    && unloaded.length() == 8
    && all(loaded, c => (c.env_arm as String) == (srv1_nccl_arm_default as String)
      || (c.env_arm as String) == (srv1_nccl_arm_p2p_disabled as String))
    && all(unloaded, c => (c.env_arm as String) == (srv1_nccl_arm_default as String)
      || (c.env_arm as String) == (srv1_nccl_arm_p2p_disabled as String))
    && all(loaded, c => any(unloaded, d => (d.env_arm as String) == (c.env_arm as String)))
    && all(unloaded, c => any(loaded, d => (d.env_arm as String) == (c.env_arm as String)))
    && length(arm_rows_in(list: unloaded, arm: srv1_nccl_arm_p2p_disabled)) == 4
    && length(arm_rows_in(list: unloaded, arm: srv1_nccl_arm_default)) == 4
    && length(arm_rows(arm: srv1_nccl_arm_p2p_disabled)) == 4
}

// THE CONTROL THE 2026-11-08 PAIR COULD NOT RUN, RUN AT LAST. Same instrument (sha 702a2bce..), same four
// sizes, same arm order, and NOTHING serving on the host: both lil-replica units stopped and their containers
// removed for the interval. The test is not that the numbers are close to the loaded ones -- they are not
// supposed to be -- it is that the SIGN OF THE DIFFERENCE IS NOT A PROPERTY OF THE FLAG: loaded, the disabled
// arm had no row at 10 GB/s and a row over 10 ms; unloaded, the disabled arm clears 10 GB/s and no unloaded row
// takes 10 ms, and at 4 MiB and 64 MiB the two arms sit inside 25% of each other. So the 2x cannot be cited as
// the price of NCCL_P2P_DISABLE=1, and the explanation row keeps it a Hypothesis for that reason. The loaded
// assertions above stay exactly as they were: they describe the loaded run, and they remain first-hand.
test fn the_unloaded_re_run_does_not_reproduce_the_switch_penalty() -> Bool {
  let unloaded = srv1_collective_transport_readings_unloaded_2026_11_09
  let unloaded_default = arm_rows_in(list: unloaded, arm: srv1_nccl_arm_default)
  let unloaded_disabled = arm_rows_in(list: unloaded, arm: srv1_nccl_arm_p2p_disabled)
  unloaded.length() == 8
    && unloaded_default.length() == 4
    && unloaded_disabled.length() == 4
    // run identity on every row: the window, and what had to be stopped to take the read
    && unloaded.all(c => srv1_reading_is_read(w: c.warrant)
      && string_contains(s: read_on_of(w: c.warrant), pattern: "2026-11-09T22:40:35Z")
      && string_contains(s: read_on_of(w: c.warrant), pattern: "replicas stopped")
      && string_contains(s: c.instrument_sha256 as String, pattern: "702a2bce")
      && transport_of(c: c) == "SHM/direct")
    // the two runs of the same instrument state DIFFERENT windows; no row of one can be read as the other
    && !unloaded.any(c => string_contains(s: read_on_of(w: c.warrant), pattern: "2026-11-08T22:22"))
    // the loaded discriminators invert here: the disabled arm reaches the 10 GB/s class, and no row is slow
    && unloaded_disabled.any(c => bandwidth_count(b: bus_bw_of(c: c)) >= 10000000000)
    && !unloaded_disabled.any(c => microsecond_count(m: elapsed_of(c: c)) >= 10000)
    && !unloaded_default.any(c => microsecond_count(m: elapsed_of(c: c)) >= 10000)
    // and at the two sizes where the loaded pair was ~2x apart, unloaded neither arm falls below
    // four-fifths of the other
    && arms_within(list: unloaded, at_bytes: byte_size(4 * 1024 * 1024), numerator: 8, denominator: 10)
    && arms_within(list: unloaded, at_bytes: byte_size(64 * 1024 * 1024), numerator: 8, denominator: 10)
    // the obligation now names the run it was executed in, the confounder that had to be removed, and the
    // fact that it was the re-run the earlier pair asked for
    && any(srv1_collective_read_executed_2026_11_09.containers_removed, c => string_contains(s: c as String, pattern: "lil-flash-next"))
    && string_contains(s: srv1_collective_read_executed_2026_11_09.results_log_path as String, pattern: "jh_nccl_results")
}

// A NEGATIVE FOR THE NEGATIVE: if the unloaded rows were filled from the loaded ones, or if either arm had
// been copied from the other, the size-pinned comparison would still pass while the arms went identical. This
// says the unloaded arms are NOT the loaded rows under a new date, and that both arms differ from each other
// at the small sizes, which is what a real sweep looks like at 16 KiB and 256 KiB.
test fn the_unloaded_rows_are_not_the_loaded_rows_relabelled() -> Bool {
  let unloaded = srv1_collective_transport_readings_unloaded_2026_11_09
  let loaded = srv1_collective_transport_readings
  unloaded.all(c => !loaded.any(d =>
    (d.env_arm as String) == (c.env_arm as String)
      && message_bytes_count(d) == message_bytes_count(c)
      && microsecond_count(m: elapsed_of(c: d)) == microsecond_count(m: elapsed_of(c: c))))
    && unloaded.any(c => unloaded.any(d =>
      (c.env_arm as String) != (d.env_arm as String)
      && message_bytes_count(c) == message_bytes_count(d)
      && microsecond_count(m: elapsed_of(c: c)) * 4 >= microsecond_count(m: elapsed_of(c: d))))
}

// AN OPEN TASK AND ITS COMPLETION RECORD DO NOT SHARE A ROW. The unloaded re-run discharged one obligation, and
// the tempting edit was to overwrite the obligation string with the record of the run: same name, opposite
// meaning, no type change. Anything reading the row by its name would get a closed task where an open one was
// promised -- the meaning fork DESIGN's single-authority rule forbids ("holding a name constant may not silently
// change obligations", review 92817). The record got its own row and the obligation keeps only what is STILL
// owed. This claim is what makes the split stick: no completion word in the obligation, the three open controls
// named there, and the run window plus the rows it summarises carried by the record.
test fn an_open_task_and_its_completion_record_do_not_share_a_row() -> Bool {
  let obligation = srv1_collective_read_obligation as String
  let record = srv1_collective_read_executed_2026_11_09
  !string_contains(s: obligation, pattern: "EXECUTED")
    && !string_contains(s: obligation, pattern: "DONE")
    && !string_contains(s: obligation, pattern: "COMPLETED")
    && string_contains(s: obligation, pattern: "STILL OWED")
    && string_contains(s: obligation, pattern: "reverse the arm order")
    && string_contains(s: obligation, pattern: "NCCL_DEBUG_SUBSYS=TRANSPORT")
    && string_contains(s: obligation, pattern: "TP=2")
    && string_contains(s: obligation, pattern: "srv1_collective_read_executed_2026_11_09")
    && record.measurement_start_utc as String == "2026-11-09T22:40:35Z"
    && record.window_start_utc as String == "2026-11-09T22:39:48Z"
    && record.window_end_utc as String == "2026-11-09T22:47:37Z"
    // the record points at its evidence by digest and path, not by naming a list of rows in prose
    && record.instrument_sha256 as String == "702a2bce83cb6c76ca51699457822fb06e840c37ba377bb0b5247a8b2653b1cc"
    && string_contains(s: record.results_log_path as String, pattern: "jh_nccl_results_20261109T224035Z")
    && lower_hex_64(value: record.results_log_sha256) && record.results_log_sha256 != record.instrument_sha256
    // the record names the things that had to be stopped, and the instrument by digest, so a later
    // reader can tell this run from the loaded pair without parsing prose
    && length(record.units_stopped) == 2
    && any(record.containers_removed, c => string_contains(s: c as String, pattern: "lil-flash-next"))
    && lower_hex_64(value: record.instrument_sha256)
    && lower_hex_64(value: record.results_log_sha256)
}

// THE RECORD'S SPANS ARE COMPUTED, NOT REPEATED. The window and the measurement inside it are differences of
// the record's own instants, read through the shared ISO 8601 calendar (extdeps.units.iso8601_calendar) -- the
// same route srv1_serving_replica_layout's router-window row reads them through, so 469 s and 16 s exist in
// exactly one place. The green control re-measures the same pair the record names; the red controls are what a
// transcription error looks like -- an instant 7 s off, a pair typed in the wrong order, a year or a leading
// zero wrong -- and each must answer by refusing, not by producing a number.
test fn the_record_spans_are_computed_from_its_instants() -> Bool {
  let run = srv1_collective_read_executed_2026_11_09
  match srv1_collective_read_window_duration(run: run) {
    Absent => false
    Present { value: w } => second_count(w) == 469
  }
    && match srv1_collective_read_measurement_duration(run: run) {
      Absent => false
      Present { value: m } => second_count(m) == 16
    }
    // and the smaller span is still inside the larger one, which only holds while BOTH come from the same pair
    && match srv1_collective_read_window_duration(run: run) {
      Absent => false
      Present { value: w } =>
        match srv1_collective_read_measurement_duration(run: run) {
          Absent => false
          Present { value: m } => second_count(m) < second_count(w)
        }
    }
    && match srv1_window_seconds_between(earlier: "2026-11-09T22:47:37Z" as NonEmptyStr, later: "2026-11-09T22:39:48Z" as NonEmptyStr) {
      Absent => true
      Present { value: _ } => false
    }
    && match srv1_window_seconds_between(earlier: "2026-11-09T22:39:41Z" as NonEmptyStr, later: "2026-11-09T22:47:37Z" as NonEmptyStr) {
      Absent => false
      Present { value: w } => second_count(w) == 476
    }
    && match srv1_window_seconds_between(earlier: "2026/11/09 22:39:48" as NonEmptyStr, later: "2026-11-09T22:47:37Z" as NonEmptyStr) {
      Absent => true
      Present { value: _ } => false
    }
}

// AN EXPLANATION IS NEVER A PREMISE. Both srv1 rows -- the one about what missing peer access accounts for,
// and the one about a switch card -- fail the fact test, and each names the observation that would settle it.
test fn the_causal_sentences_stay_explanations() -> Bool {
  let srv1_explanations = interconnect_explanations_on(host: operator_host_srv1)
  srv1_interconnect_explanations.length() == 3
    && srv1_explanations.filter(e => match e.standing { Bet { claim: _, would_be_settled_by: _ } => true Hypothesis { claim: _, would_be_settled_by: _ } => false }).length() == 1
    // Exactly two stay hypotheses; retyping either as the established standing is not even writable, and
    // retyping one as the other standing fails this count.
    && srv1_explanations.filter(e => match e.standing { Hypothesis { claim: _, would_be_settled_by: _ } => true Bet { claim: _, would_be_settled_by: _ } => false }).length() == 2
    && srv1_explanations.all(e => match e.standing {
      Hypothesis { claim: c, would_be_settled_by: w } => ((c as String) != "") && ((w as String) != "")
      Bet { claim: c, would_be_settled_by: w } => ((c as String) != "") && ((w as String) != "")
    })
    && srv1_explanations.any(e => match e.standing {
      Hypothesis { claim: _, would_be_settled_by: _ } => string_contains(s: e.subject as String, pattern: "TP=2")
      Bet { claim: _, would_be_settled_by: _ } => false
    })
}
