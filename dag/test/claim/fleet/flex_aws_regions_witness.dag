module test.claim.fleet.flex_aws_regions_witness

import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.types { Bool, String, NonEmptyStr, List }
import std.optional { Present, Absent }
import gunbc.fleet.flex_aws_regions { flex_aws_ipv4, flex_aws_regions_asked, flex_aws_weights_bucket, flex_aws_event_pattern }
import extdeps.languages.json.emit { serialize_json }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// The card ingress admits exactly one IPv4 address: what checkip answers, and nothing that only looks like
// one (an empty octet, an octet past 255, a leading zero, an IPv6 address, an error page).
test fn only_one_plain_ipv4_address_becomes_the_ingress() -> Bool {
  flex_aws_ipv4(text: "96.224.201.7")
    && !flex_aws_ipv4(text: "96.224.201")
    && !flex_aws_ipv4(text: "96.224.201.256")
    && !flex_aws_ipv4(text: "96.224.01.7")
    && !flex_aws_ipv4(text: "96..201.7")
    && !flex_aws_ipv4(text: "2001:db8::1")
    && !flex_aws_ipv4(text: "<html>")
}

// A region is set up only where the pass scans: all of them, or a named list of scanned ones; a region the
// pass would never launch in is refused, and so is an empty list.
test fn only_scanned_regions_are_set_up() -> Bool {
  (match flex_aws_regions_asked(regions: "all") { Present { value: rs } => count(rs) == 9  Absent => false })
    && (match flex_aws_regions_asked(regions: "us-east-2, ap-south-1") { Present { value: rs } => map(rs, r => r as String) == ["us-east-2", "ap-south-1"]  Absent => false })
    && (match flex_aws_regions_asked(regions: "us-east-2,sa-east-1") { Absent => true  Present { value: _ } => false })
    && (match flex_aws_regions_asked(regions: "") { Absent => true  Present { value: _ } => false })
}

// The names the pass and the card read: the bucket the card's parameter must name, and the rule pattern the
// queue is fed by (the shape read from the hand-made us-west-2 rules on 2026-11-25).
test fn the_bucket_and_rule_shapes_match_the_first_regions() -> Bool {
  ((flex_aws_weights_bucket(account: "000000000000" as NonEmptyStr, region: "us-east-2" as NonEmptyStr) as String) == "gunbc-flex-weights-000000000000-us-east-2")
    && (serialize_json(v: flex_aws_event_pattern(detail_type: "EC2 Instance Rebalance Recommendation")) == "\{\"source\": [\"aws.ec2\"], \"detail-type\": [\"EC2 Instance Rebalance Recommendation\"]}")
}
