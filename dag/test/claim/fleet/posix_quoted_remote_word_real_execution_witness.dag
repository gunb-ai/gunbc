module test.claim.fleet.posix_quoted_remote_word_real_execution_witness

import std.types { Bool, List, NonEmptyStr, String }
import std.algebra { trim }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import extdeps.shell
import std.types { FilePath }
import gunbc.fleet.fleet_known_hosts_anchor {
  PosixLoginShellProof,
  LoginShellPosix,
  LoginShellNotPosix,
  LoginShellUnreadable,
  login_shell_standing,
  posix_quoted_remote_words,
  portable_remote_words_strings,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE INJECTION BOUNDARY BY REAL EXECUTION (merry-fox-82 condition 3): the rendered words, joined into the one command
// string the transport sends, are handed as ONE argv word to an actual `sh -c` (extdeps.shell shell.Sh Reparse; no
// wrapping quotes, so no second copy of the quoting under test, review 85958) -- the same re-parse the remote login shell performs on the transported command -- prefixed by
// `printf '%s\n'`, so each word the shell sees becomes one output line. The words pass when the lines equal the raw
// words exactly (no hostile word is empty, so the non-empty lines are compared: a runner that trims the final
// newline changes nothing, and a word split in two still reds), and no expansion ran: the canary path named inside a $( ) word and a backtick word is never created.
// Refused by the hermetic envelope (shell.Exec and shell.Mktemp.Dir have no mock_response), so it is a LocalRepoWetLane
// exclusion in gunbc.ci.ci_layer_roots.

fn proof_for_this_shell() -> PosixLoginShellProof? {
  match login_shell_standing(principal: "witness", success: true, output: "witness:x:1000:1000::/home/witness:/bin/sh") {
    LoginShellPosix { proof: p } => Present { value: p }
    LoginShellNotPosix { principal: _, shell: _ } => Absent
    LoginShellUnreadable { principal: _, reason: _ } => Absent
  }
}

fn hostile_words(canary: String) -> List<String> {
  [
    "plain",
    "a b  c",
    "*",
    "grub-efi-amd64-signed_1.202.5+2.12-1ubuntu7.3_amd64.deb",
    concat(concat("$(touch ", canary), ")"),
    concat(concat("`touch ", canary), "`"),
    concat("x;touch ", canary),
    concat("x&&touch ", canary),
    "it's",
    "'\"",
    "a\\b",
    "$HOME",
    "~",
    "[ab]",
    "!x",
    "#x",
  ]
}

test fn hostile_words_reach_sh_as_one_literal_word_each() -> Bool {
  let dir = shell.Mktemp.Dir()
  if dir.success == false {
    false
  } else {
    let canary = join([dir.path as String, "/canary"], "")
    let words = hostile_words(canary: canary)
    match proof_for_this_shell() {
      Absent => false
      Present { value: p } =>
        match posix_quoted_remote_words(raws: concat(["printf", "%s\\n"], words), shell: p) {
          Absent => false
          Present { value: rendered } => {
            let command = join(portable_remote_words_strings(words: rendered), " ")
            let ran = shell.Sh.Reparse(command: command as NonEmptyStr)
            let canary_present = shell.Test.IsFile(path: canary as FilePath)
            let cleaned = shell.Remove.RecursiveForce(path: dir.path)
            ran.success
              && filter(split(s: ran.stdout, delimiter: "\n"), l => l != "") == words
              && canary_present.is_file == false
              && cleaned.success
          }
        }
    }
  }
}

// INHABITANCE OF THE PRODUCER (review 85942): the real `getent passwd <user>` this runner answers, for the user the
// witness runs as, read through the production parser, against an independent oracle -- the seventh field of the
// passwd FILE read by awk (a second producer, argv only; review 85958). The route is the producer's actual output -- its trailing
// newline and NSS formatting included -- not a typed-in line; the fleet leg itself (read_fleet_login_shell over the
// SSH edge) is a frontier row whose consumer is the srv4 placement step.
test fn the_real_getent_output_mints_the_proof_for_its_own_principal() -> Bool {
  let who = shell.Id.UserName()
  let name = trim(s: who.stdout)
  if who.success == false || name == "" {
    false
  } else {
    let entry = shell.Passwd.Entry(name: name as NonEmptyStr)
    let oracle = trim(s: shell.Passwd.FileShellField(name: name as NonEmptyStr).stdout)
    entry.success
      && (match login_shell_standing(principal: name as NonEmptyStr, success: entry.success, output: entry.stdout) {
        LoginShellPosix { proof: p } => (p.principal as String) == name && (p.shell as String) == oracle
        LoginShellNotPosix { principal: pr, shell: sh } => (pr as String) == name && sh == oracle
        LoginShellUnreadable { principal: _, reason: _ } => false
      })
  }
}
