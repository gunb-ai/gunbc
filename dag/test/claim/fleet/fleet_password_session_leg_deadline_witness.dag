// ============================================================================================
// REVIEW 96706 R1 -- "EVERY FLEET LEG" MEANS EVERY LEG, INCLUDING THE PASSWORD SESSION.
//
// A FleetSshPasswordSession leg used to carry its kind on the leg while nothing READ it: the
// password transport op (ssh.PasswordFileSsh.ExecPortableWordsWithStdin) took no wall_deadline, so
// the kind was decoration and the leg ran unbounded. The fix threads the same caller-passed ceiling
// through the password transport and decodes its result at the SAME one site as the key transport.
//
// What is checkable without a live password-authenticated host is the half that matters for the
// model: the password transport's result record has the same shape as the key transport's, so it
// flows through the SAME single decode, and an overrun comes back as a VALUE carrying the deadline
// rather than as an error or a fabricated completion. A red control on each illegal wire
// combination is what stops a future sink change from silently re-typing an overrun.
// ============================================================================================

// THE PASSWORD LEG'S CEILING IS THE SAME AUTHORITY, not a password-specific number. A password
// provisioning leg gets exactly the ProvisioningLeg ceiling the key path would give it.
test fn a_password_leg_ceiling_comes_from_the_same_kind_authority() -> Bool {
  second_count(s: fleet_leg_wall_deadline(kind: ProvisioningLeg)) == 900
    && second_count(s: fleet_leg_wall_deadline(kind: ProbeLeg)) == 15
}

// AN OVERRUN ON THE PASSWORD TRANSPORT IS SessionOverran, CARRYING THE DEADLINE IT TRIPPED ON. The
// record below is what ssh.PasswordFileSsh.ExecPortableWordsWithStdin returns when its own kill
// fired: overran true, the deadline echoed back, and an exit code that means NOTHING (a killed
// transport can exit any code -- this is why there is no exit-124 sentinel).
test fn a_password_leg_past_its_deadline_decodes_as_overran_with_the_value() -> Bool {
  let wall = fleet_leg_wall_deadline(kind: ProvisioningLeg)
  let result = SshSessionExecResult {
    exit_code: -1,
    success: false,
    stdout: "",
    stderr: "",
    overran: true,
    wall_deadline_seconds: Present { value: wall },
  }
  match ssh_session_exec_outcome(result: result) {
    SessionOverran { deadline: d } => second_count(s: d) == 900
    SessionCompleted { exit_code: _, success: _, stdout: _, stderr: _ } => false
    SessionWireInconsistent { fault: _ } => false
  }
}

// RED CONTROL 1 -- an overrun with NO echoed deadline is refused, and named. A sink that killed the
// group but lost the deadline would otherwise hand the consumer an overrun it cannot report; the
// consumer must not invent one either.
test fn an_overran_that_echoes_no_deadline_is_refused_and_named() -> Bool {
  let result = SshSessionExecResult {
    exit_code: 0,
    success: true,
    stdout: "",
    stderr: "",
    overran: true,
    wall_deadline_seconds: Absent,
  }
  match ssh_session_exec_outcome(result: result) {
    SessionWireInconsistent { fault: f } =>
      string_contains(s: ssh_session_exec_wire_refusal_text(fault: f), pattern: "overran=true")
    SessionCompleted { exit_code: _, success: _, stdout: _, stderr: _ } => false
    SessionOverran { deadline: _ } => false
  }
}

// RED CONTROL 2 -- a deadline echoed WITHOUT an overrun is refused too. A leg that completed does
// not report a ceiling it never tripped; accepting that pair is how a green run starts to look like
// it was rescued by a deadline.
test fn a_deadline_without_an_overrun_is_refused_and_named() -> Bool {
  let result = SshSessionExecResult {
    exit_code: 0,
    success: true,
    stdout: "ok",
    stderr: "",
    overran: false,
    wall_deadline_seconds: Present { value: second(count: 900) },
  }
  match ssh_session_exec_outcome(result: result) {
    SessionWireInconsistent { fault: f } =>
      string_contains(s: ssh_session_exec_wire_refusal_text(fault: f), pattern: "overran=false")
    SessionCompleted { exit_code: _, success: _, stdout: _, stderr: _ } => false
    SessionOverran { deadline: _ } => false
  }
}

// THE COMPLETED PASSWORD LEG STILL DECODES CLEANLY, and is the ONLY arm that reaches a Ran. The
// wire record for a leg that finished inside its ceiling carries overran=false and Absent, and the
// decode hands back the fields rather than the raw record -- which is review 96706 R2: the consumer
// builds Ran from the SessionCompleted fields, so a future variant of this sum cannot fall into Ran
// through a wildcard.
test fn a_completed_password_leg_is_the_only_route_to_the_ran_fields() -> Bool {
  let result = SshSessionExecResult {
    exit_code: 0,
    success: true,
    stdout: "converged",
    stderr: "",
    overran: false,
    wall_deadline_seconds: Absent,
  }
  match ssh_session_exec_outcome(result: result) {
    SessionCompleted { exit_code: code, success: ok, stdout: out, stderr: err } =>
      code == 0 && ok && out == "converged" && err == ""
    SessionOverran { deadline: _ } => false
    SessionWireInconsistent { fault: _ } => false
  }
}

// THE DECODE IS TOTAL AND DISCRIMINATING: the three arms partition the legal records, so an overrun
// never reads as a completion and a completion never reads as an overrun. Both wrong readings are
// fail-open in different directions -- the first hides a killed leg, the second invents one.
test fn the_decode_never_reads_an_overrun_as_a_completion_or_vice_versa() -> Bool {
  let wall = fleet_leg_wall_deadline(kind: ProbeLeg)
  let overran = ssh_session_exec_outcome(
    result: SshSessionExecResult {
      exit_code: 0, success: true, stdout: "", stderr: "",
      overran: true, wall_deadline_seconds: Present { value: wall },
    }
  )
  let completed = ssh_session_exec_outcome(
    result: SshSessionExecResult {
      exit_code: 0, success: true, stdout: "", stderr: "",
      overran: false, wall_deadline_seconds: Absent,
    }
  )
  match overran {
    SessionOverran { deadline: _ } => match completed {
      SessionCompleted { exit_code: _, success: _, stdout: _, stderr: _ } => true
      SessionOverran { deadline: _ } => false
      SessionWireInconsistent { fault: _ } => false
    }
    SessionCompleted { exit_code: _, success: _, stdout: _, stderr: _ } => false
    SessionWireInconsistent { fault: _ } => false
  }
}

// ----------------------------------------------------------------------------------------
// THE THREADING ITSELF, not only the decode: review 96706 R1 requires it, and this is its red
// control. The password route arms its ceiling through the armed leg, which is what is handed to
// ssh.PasswordFileSsh.ExecPortableWordsWithStdin. Before this change that transport declared no
// ceiling field at all, so the kind sitting on the password leg was decoration and a password session
// could hang forever. Read the armed leg back: EVERY kind must arrive as Present(the kind ceiling from
// the one authority), and NO kind may arrive unbounded -- an unbounded leg is what 0-means-none was.
// Delete the wall_deadline line from fleet_ssh_armed_password_leg, the mutation that reproduces the
// pre-fix state, and BOTH witnesses below go red while every witness above stays green.
// ----------------------------------------------------------------------------------------

fn with_password_trust(f: fn(FleetOpenSshTrustPolicy) -> Bool) -> Bool {
  match fixture_attempt() {
    Absent => false
    Present { value: a } => f(fleet_openssh_trust_policy_hermetic_witness_fixture(anchor: known_hosts_anchor_hermetic_witness_fixture(attempt: a)))
  }
}

fn armed_password_deadline_for(trust: FleetOpenSshTrustPolicy, kind: FleetLegKind) -> Optional<Second> {
  match fleet_ssh_target_at_standard_port(endpoint: "srv1.tailecbe08.ts.net", principal: fleet_automation_principal_login) {
    SshTargetResolved { target: t } => match portable_remote_words(raws: ["hostname"]) {
      Absent => Absent
      Present { value: words } => {
        let armed = fleet_ssh_armed_password_leg(trust: trust, leg: FleetBareWordLeg { target: t, words: words, kind: kind })
        armed.wall_deadline
      }
    }
    SshTargetRefused { endpoint: _, refusal: _ } => Absent
  }
}

fn is_present_seconds(value: Optional<Second>) -> Bool {
  match value {
    Absent => false
    Present { value: _ } => true
  }
}

test fn every_password_leg_kind_arms_its_ceiling_into_the_transport() -> Bool {
  with_password_trust(f =>
    armed_password_deadline_for(trust: f, kind: ProbeLeg) == Present { value: fleet_leg_wall_deadline(kind: ProbeLeg) }
      && armed_password_deadline_for(trust: f, kind: ActuationLeg) == Present { value: fleet_leg_wall_deadline(kind: ActuationLeg) }
      && armed_password_deadline_for(trust: f, kind: RepositoryConvergenceLeg) == Present { value: fleet_leg_wall_deadline(kind: RepositoryConvergenceLeg) }
      && armed_password_deadline_for(trust: f, kind: ProvisioningLeg) == Present { value: fleet_leg_wall_deadline(kind: ProvisioningLeg) })
}

test fn no_password_leg_kind_is_left_unbounded() -> Bool {
  with_password_trust(f =>
    is_present_seconds(armed_password_deadline_for(trust: f, kind: ProbeLeg))
      && is_present_seconds(armed_password_deadline_for(trust: f, kind: ActuationLeg))
      && is_present_seconds(armed_password_deadline_for(trust: f, kind: RepositoryConvergenceLeg))
      && is_present_seconds(armed_password_deadline_for(trust: f, kind: ProvisioningLeg)))
}

// ============================================================================================
// 4th-ARM FAMILY (follow-up of #16984) -- THE PRODUCER OF THE DISPATCHED-UNKNOWN ARM.
//
// The malformed-wire fixtures above feed the REAL decoder (ssh_session_exec_outcome). This control
// drives one of those same malformed wire shapes through the ENTIRE pure producer chain that the
// effectful sink calls AFTER the leg has already gone out -- the decoder, the single conversion
// gunbc.fleet.fleet_bootstrap_principal_session.fleet_principal_leg_of_exec (which all five fleet sink
// sites now share), and the real HostLeg mapper gunbc.host_command_binding.host_leg_of_typed_argv via
// the bridge -- and asserts the leg is carried as DISPATCHED, EFFECT UNKNOWN end to end, never as
// "never dispatched". The arm is the discriminator: a leg that was sent must never read as LegNotDispatched.
//
// RED (mutation): restoring FleetPrincipalLegRefused at the SessionWireInconsistent arm of
// fleet_principal_leg_of_exec -- the #16984 fold this family retires -- makes the chain produce
// TypedArgvExecRefused -> LegNotDispatched, and this control FAILS by running and returning false.
// ============================================================================================
test fn a_wire_inconsistent_exec_is_carried_dispatched_unknown_through_the_real_producer_chain() -> Bool {
  // The exact malformed shape review 96706 R1 named: overran=true with no echoed deadline. It is NOT an
  // overrun the consumer can report and NOT a completed leg -- it is "the reply arrived but was unreadable".
  let result = SshSessionExecResult {
    exit_code: 0,
    success: true,
    stdout: "",
    stderr: "",
    overran: true,
    wall_deadline_seconds: Absent,
  }
  let exec = ssh_session_exec_outcome(result: result)
  // The real decoder must classify it as an inconsistent wire shape, not an overrun and not completed.
  let decoded_is_wire = match exec {
    SessionWireInconsistent { fault: _ } => true
    SessionCompleted { exit_code: _, success: _, stdout: _, stderr: _ } => false
    SessionOverran { deadline: _ } => false
  }
  // The real single conversion (shared by all five sink sites) must give it its OWN dispatched-unknown arm.
  let converted = fleet_principal_leg_of_exec(session: FleetSshKeySession, exec: exec)
  let converted_is_wire = match converted {
    FleetPrincipalLegWireInconsistent { session: _, fault: _ } => true
    _ => false
  }
  // The bridge maps the fleet dispatched-unknown arm onto the typed argv dispatched-unknown arm...
  let bridged = match converted {
    FleetPrincipalLegWireInconsistent { fault: f } => TypedArgvExecWireInconsistent { fault: f }
    _ => TypedArgvExecRefused { reason: "not a wire-inconsistent leg" }
  }
  // ...and the REAL HostLeg mapper must settle it to LegUnanswered (the effect is unknown), never LegNotDispatched.
  let leg = host_leg_of_typed_argv(bridged)
  let maps_to_unanswered = match leg {
    LegUnanswered { cause: _ } => true
    _ => false
  }
  decoded_is_wire && converted_is_wire && maps_to_unanswered
}
