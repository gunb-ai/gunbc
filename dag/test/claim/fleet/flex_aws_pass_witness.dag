data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// SUPPLIED at the pass's pure seams: what the files leave routed and what the running router reports; the purchase
// record and the roster; a parameter listing. The inhabitance run is the srv1 loop's receipt.

fn reading(rows: List<String>) -> FlexAwsRouterReading { FlexAwsRouterReading { unplaceable: 0, rows: rows, cards: [] } }

// THE RUNNING ROUTER AGAINST THE FILES, by every row of ours it routes (reviews of fb2594de and e50999ce). The last
// card was evicted, its row left the files, and the HUP failed: the pass sees no live card at all, yet the router
// still routes aws-i-0old, so the reload is owed. The files route a new card the router does not: owed. Agreement,
// and a first-party rented row that is not ours, owe nothing.
test fn a_reload_the_router_has_not_taken_is_owed_on_the_next_pass() -> Bool {
  flex_aws_reload_owed(routed: [], reading: reading(rows: ["aws-i-0old"]))
    && flex_aws_reload_owed(routed: ["aws-i-0new"], reading: reading(rows: []))
    && flex_aws_reload_owed(routed: ["aws-i-0new"], reading: reading(rows: ["aws-i-0new", "aws-i-0old"]))
    && !flex_aws_reload_owed(routed: ["aws-i-0new"], reading: reading(rows: ["aws-i-0new"]))
    && !flex_aws_reload_owed(routed: [], reading: reading(rows: ["vast-rented-1"]))
}

fn rate(micros: Int) -> MoneyPerHour { MoneyPerHour { amount: money_amount_micro(count: micros), currency: Usd } }

fn launch() -> FlexAwsLaunch {
  FlexAwsLaunch { candidate: FlexAwsCandidate { region: "us-east-1" as NonEmptyStr, zone: "us-east-1b" as NonEmptyStr, instance_type: "g7e.2xlarge" as NonEmptyStr, market: FlexAwsSpot, gpus: 1, vcpus: 8, rate: Present { value: rate(micros: 1000000) }, per_gpu_hour_micros: Present { value: 1000000 }, walls: [] }, max_price: rate(micros: 1000000), fallbacks: [] }
}

// AN UNREADABLE REGION, OR AN UNREADABLE PURCHASE RECORD, BLOCKS EVERY LAUNCH, and only launches: draining a card
// that was seen still goes ahead.
test fn an_incomplete_inventory_launches_nothing() -> Bool {
  (match flex_aws_inventory_gate(decision: launch(), blind: ["eu-west-2"]) { FlexAwsHold { why: w } => w.contains("eu-west-2")  _ => false })
    && (match flex_aws_inventory_gate(decision: launch(), blind: []) { FlexAwsLaunch { candidate: _, max_price: _, fallbacks: _ } => true  _ => false })
    && (match flex_aws_inventory_gate(decision: FlexAwsDrain { instance_id: "i-0a" as NonEmptyStr, why: FlexAwsDrainIdle { idle_seconds: 1800 } }, blind: ["eu-west-2"]) { FlexAwsDrain { instance_id: _, why: _ } => true  _ => false })
    && (match flex_aws_intent_gate(decision: launch(), blocked: "the launch intent is unreadable: x") { FlexAwsHold { why: w } => w.contains("unreadable")  _ => false })
    && (match flex_aws_intent_gate(decision: launch(), blocked: "") { FlexAwsLaunch { candidate: _, max_price: _, fallbacks: _ } => true  _ => false })
}

// 2026-11-25T03:00:00Z
data now_unix: Int = 1795575600

fn intent(instance_id: String, created: Int) -> FlexAwsIntent {
  FlexAwsIntent {
    token: "gunbc-flex-us-east-1b-1795575540" as NonEmptyStr, region: "us-east-1" as NonEmptyStr, zone: "us-east-1b" as NonEmptyStr,
    instance_type: "g7e.2xlarge" as NonEmptyStr, rate: rate(micros: 2350500), ami: "ami-0123" as NonEmptyStr, subnet: "subnet-0123" as NonEmptyStr,
    security_group: "sg-0123" as NonEmptyStr, created_unix: created, instance_id: instance_id,
  }
}

fn listed(id: String) -> AwsEc2Instance {
  AwsEc2Instance {
    instance_id: id as NonEmptyStr, instance_type: "g7e.2xlarge" as NonEmptyStr,
    placement: AwsEc2Placement { availability_zone: "us-east-1b" as NonEmptyStr },
    state: AwsEc2InstanceState { code: 48, name: AwsEc2Terminated },
    state_reason: none, instance_lifecycle: none, spot_instance_request_id: none,
    launch_time: "2026-11-25T02:59:00+00:00", public_ip_address: none, tags: [],
  }
}

// THE PURCHASE RECORD IS THE REQUEST (review of e50999ce): written and read back it is the same purchase -- token,
// zone, rate, image, subnet, group -- so asking again is asking for the same card; a record missing a field is
// unreadable, never read as no purchase.
test fn the_purchase_record_reads_back_as_the_same_request() -> Bool {
  (match flex_aws_intent_of(text: flex_aws_intent_json(i: intent(instance_id: "", created: now_unix))) {
    FlexAwsIntentOpen { intent: i } => ((i.token as String) == "gunbc-flex-us-east-1b-1795575540") && ((i.zone as String) == "us-east-1b") && (money_per_hour_micros(q: i.rate) == 2350500)
      && ((i.ami as String) == "ami-0123") && ((i.subnet as String) == "subnet-0123") && ((i.security_group as String) == "sg-0123") && (i.created_unix == now_unix) && (i.instance_id == "")
    _ => false
  })
  && (match flex_aws_intent_of(text: flex_aws_intent_json(i: intent(instance_id: "i-0new", created: now_unix))) { FlexAwsIntentOpen { intent: i } => i.instance_id == "i-0new"  _ => false })
  && (match flex_aws_intent_of(text: "\{\"token\": \"t\", \"region\": \"us-east-1\"}") { FlexAwsIntentUnreadable { cause: _ } => true  _ => false })
  && (match flex_aws_intent_of(text: "not json") { FlexAwsIntentUnreadable { cause: _ } => true  _ => false })
}

// WHERE A PURCHASE STANDS: listed once EC2 lists its card (in any state); waiting while its card is named but not
// listed; asked again while its answer was never read; lapsed, loudly, past fifteen minutes -- except in a region
// whose ownership was not read, where its card may be there unseen.
test fn a_purchase_is_counted_until_ec2_lists_it() -> Bool {
  (match flex_aws_intent_step(i: intent(instance_id: "i-0new", created: now_unix - 60), owned: [listed(id: "i-0new")], blind: [], now_unix: now_unix) { FlexAwsIntentListed => true  _ => false })
    && (match flex_aws_intent_step(i: intent(instance_id: "i-0new", created: now_unix - 60), owned: [listed(id: "i-0other")], blind: [], now_unix: now_unix) { FlexAwsIntentWaiting => true  _ => false })
    && (match flex_aws_intent_step(i: intent(instance_id: "", created: now_unix - 60), owned: [], blind: [], now_unix: now_unix) { FlexAwsIntentAskAgain => true  _ => false })
    && (match flex_aws_intent_step(i: intent(instance_id: "i-0new", created: now_unix - 900), owned: [], blind: [], now_unix: now_unix) { FlexAwsIntentLapsed { age_seconds: a } => a == 900  _ => false })
    && (match flex_aws_intent_step(i: intent(instance_id: "i-0new", created: now_unix - 899), owned: [], blind: [], now_unix: now_unix) { FlexAwsIntentWaiting => true  _ => false })
    && (match flex_aws_intent_step(i: intent(instance_id: "i-0new", created: now_unix - 5000), owned: [], blind: ["us-east-1"], now_unix: now_unix) { FlexAwsIntentWaiting => true  _ => false })
}

fn param(name: String, age: Int) -> AwsSsmParameterListed { AwsSsmParameterListed { name: name as NonEmptyStr, last_modified_unix: now_unix - age } }

// THE ORPHAN SWEEP (review of e50999ce: a key outliving EC2's hour-long listing of its terminated card was never
// found again). Under the key prefix: a card EC2 lists keeps its key; an unlisted card's key older than an hour is
// an orphan; a younger one, and the card an open purchase names, are kept; a name under another prefix is not this
// listing's.
test fn a_key_whose_card_ec2_no_longer_lists_is_swept() -> Bool {
  let listing = [
    param(name: "/gunbc-flex/pool-key/i-0live", age: 9000),
    param(name: "/gunbc-flex/pool-key/i-0gone", age: 3600),
    param(name: "/gunbc-flex/pool-key/i-0young", age: 3599),
    param(name: "/gunbc-flex/pool-key/i-0bought", age: 9000),
    param(name: "/gunbc-flex/heartbeat", age: 9000),
  ]
  map(flex_aws_orphans(listed: listing, prefix: "/gunbc-flex/pool-key/", listed_ids: ["i-0live"], keep: "i-0bought", now_unix: now_unix), n => n as String) == ["/gunbc-flex/pool-key/i-0gone"]
}

// A REGION IS ADMITTED ON ITS READY MARKER (review of e50999ce): exactly the weights revision admits it; a stale
// revision, or no marker, does not.
test fn only_a_region_marked_with_the_weights_revision_offers_candidates() -> Bool {
  flex_aws_region_provisioned(marker: AwsCliReadOk { value: flex_aws_weights_revision() })
    && !flex_aws_region_provisioned(marker: AwsCliReadOk { value: "0000000000000000000000000000000000000000" as NonEmptyStr })
    && !flex_aws_region_provisioned(marker: AwsCliReadRefused { cause: "ParameterNotFound" })
}

// REAL EXECUTION of the two intent writes, in a scratch directory: a purchase is opened create-only (a second
// open over it refuses, so an open purchase is never forgotten), and naming its card replaces the record and
// reads back. The naming write was once refused on the file the opening write had made.
test fn an_opened_purchase_is_named_in_place_and_never_opened_twice() -> Bool {
  let path = concat(shell.Mktemp.DirWithTemplate(template: "/tmp/gunbc_flex_intent.XXXXXX").path, "/launch-intent.json")
  let opened = flex_aws_open_intent_at(path: path, i: intent(instance_id: "", created: 1795575540))
  let again = flex_aws_open_intent_at(path: path, i: intent(instance_id: "", created: 1795575541))
  let named = flex_aws_name_intent_at(path: path, i: intent(instance_id: "i-0new", created: 1795575540))
  let back = Filesystem.Read(path: path)
  (opened == "") && (again == "another purchase is already recorded") && (named == "")
    && (match flex_aws_intent_of(text: back.content) { FlexAwsIntentOpen { intent: i } => (i.instance_id == "i-0new") && (i.created_unix == 1795575540)  _ => false })
}

// ---- what a card costs, and the record kept when it is released ---------------------------------------

// A card as the roster reads it: running, spot unless said otherwise, launched at `launched`.
fn card_in(id: String, zone: String, launched: String, spot: Bool) -> AwsEc2Instance {
  AwsEc2Instance {
    instance_id: id as NonEmptyStr, instance_type: "g7e.2xlarge" as NonEmptyStr,
    placement: AwsEc2Placement { availability_zone: zone as NonEmptyStr },
    state: AwsEc2InstanceState { code: 16, name: AwsEc2Running },
    state_reason: none, instance_lifecycle: if spot { Present { value: AwsEc2LifecycleSpot } } else { none }, spot_instance_request_id: none,
    launch_time: launched, public_ip_address: none, tags: [],
  }
}

// THE BILLING START IS THE LAUNCH TIME, READ BY THE RFC 3339 READER, in the spelling the AWS CLI prints; a launch time
// that does not parse is no start at all. RED: answering 0 (or now) for an unreadable time.
test fn a_cards_billing_start_is_its_launch_time_or_unread() -> Bool {
  (unix_or_negative(t: flex_aws_launch_unix(i: card_in(id: "i-0a", zone: "us-east-1b", launched: "2026-11-25T02:59:00+00:00", spot: true))) == now_unix - 60)
    && (unix_or_negative(t: flex_aws_launch_unix(i: card_in(id: "i-0a", zone: "us-east-1b", launched: "2026-11-25T02:59:00.000Z", spot: true))) == now_unix - 60)
    && (unix_or_negative(t: flex_aws_launch_unix(i: card_in(id: "i-0a", zone: "us-east-1b", launched: "yesterday", spot: true))) == -1)
}

fn spot_price(zone: String, micros: Int) -> AwsEc2SpotPrice {
  AwsEc2SpotPrice { availability_zone: zone as NonEmptyStr, instance_type: "g7e.2xlarge" as NonEmptyStr, product_description: "Linux/UNIX" as NonEmptyStr, spot_price: rate(micros: micros), timestamp: "2026-11-25T02:58:00+00:00" }
}

fn observed_scan(region: String, prices: List<AwsEc2SpotPrice>) -> FlexAwsRegionScan {
  FlexAwsRegionScan { region: region as NonEmptyStr, owned: AwsCliReadOk { value: [] }, launchable: FlexAwsRegionScanned {
    quota: 8,
    observation: FlexAwsRegionObserved { region: region as NonEmptyStr, offerings: [], types: [], prices: prices, spot_quota_vcpus: 8, on_demand_quota_vcpus: 0, owned: [] },
    queue: FlexAwsQueueRefused { cause: "not read in this witness" }, provisioned: AwsCliReadRefused { cause: "not read in this witness" },
  } }
}

fn micros_of(r: MoneyPerHour?) -> Int { match r { Present { value: x } => money_per_hour_micros(q: x) as Int  Absent => -1 } }

fn at(region: String, zone: String, spot: Bool) -> FlexAwsOwnedIn {
  FlexAwsOwnedIn { region: region as NonEmptyStr, instance: card_in(id: "i-0a", zone: zone, launched: "2026-11-25T02:59:00+00:00", spot: spot) }
}

fn unix_or_negative(t: Int?) -> Int { match t { Present { value: x } => x  Absent => -1 } }

// THE RATE A CARD IS BILLED AT IS THE SPOT PRICE OBSERVED FOR ITS OWN ZONE AND TYPE, IN ITS OWN REGION: a card in
// us-east-1b reads us-east-1b's price, not us-east-1a's; a card in a region this pass did not observe, a card in a zone
// no price was answered for, and a card that is not spot have no rate -- absent, never zero or a neighbour's price.
// RED: reading the first price of the region, or defaulting to 0, fails an arm.
test fn a_cards_rate_is_its_own_zones_observed_spot_price_or_unread() -> Bool {
  let scans = [
    observed_scan(region: "us-east-1", prices: [spot_price(zone: "us-east-1a", micros: 1111111), spot_price(zone: "us-east-1b", micros: 2350500)]),
    FlexAwsRegionScan { region: "eu-west-2" as NonEmptyStr, owned: AwsCliReadOk { value: [] }, launchable: FlexAwsRegionSkipped { why: "no spot quota" } },
  ]
  (micros_of(r: flex_aws_card_rate(scans: scans, o: at(region: "us-east-1", zone: "us-east-1b", spot: true))) == 2350500)
    && (micros_of(r: flex_aws_card_rate(scans: scans, o: at(region: "us-east-1", zone: "us-east-1c", spot: true))) == -1)
    && (micros_of(r: flex_aws_card_rate(scans: scans, o: at(region: "us-east-1", zone: "us-east-1b", spot: false))) == -1)
    && (micros_of(r: flex_aws_card_rate(scans: scans, o: at(region: "eu-west-2", zone: "eu-west-2a", spot: true))) == -1)
}

fn ledger(hourly: Int, since: Int, read: Bool) -> FlexAwsCardLedger {
  FlexAwsCardLedger {
    instance_id: "i-0a" as NonEmptyStr, region: "us-east-1" as NonEmptyStr, zone: "us-east-1b" as NonEmptyStr, instance_type: "g7e.2xlarge" as NonEmptyStr,
    billed_since_unix: if since < 0 { none } else { Present { value: since } }, terminated_unix: now_unix, why: FlexAwsTerminateDrained { drain_seconds: 120 },
    hourly: if hourly < 0 { none } else { Present { value: rate(micros: hourly) } },
    tallies: if read { FlexAwsTalliesRead { members: [json_kv(key: "requests", value: json_int(n: 7)), json_kv(key: "first_turn_unix", value: json_null())] } } else { FlexAwsTalliesUnread { cause: "router stats unread: the CLI exited 7" } },
  }
}

// A RELEASED CARD'S RECORD IS ONE JSON LINE: what the card was, its billing start and end, why it was let go (the
// decision's own wire), its rate and its spend -- rate x billed seconds, to the nearest micro: 3.6 USD/h over 1.5 h
// is 5.4 -- and the router's tallies as read. A rate or a start the pass could not read leaves rate and spend null;
// tallies not read are recorded unread with their cause, never as zeros.
// RED: a spend computed from a zero rate (or a zero start) when either is unread; tallies_unread dropped or written as
// a tallies object.
test fn a_released_cards_record_carries_its_cost_and_the_routers_tallies() -> Bool {
  let full = flex_aws_card_ledger_json(l: ledger(hourly: 3600000, since: now_unix - 5400, read: true))
  let unpriced = flex_aws_card_ledger_json(l: ledger(hourly: -1, since: now_unix - 5400, read: false))
  let unstarted = flex_aws_card_ledger_json(l: ledger(hourly: 3600000, since: -1, read: true))
  full.contains("\"instance_id\": \"i-0a\"") && full.contains("\"row\": \"aws-i-0a\"") && full.contains("\"instance_type\": \"g7e.2xlarge\"")
    && full.contains(concat("\"billed_since_unix\": ", to_string(now_unix - 5400))) && full.contains(concat("\"terminated_unix\": ", to_string(now_unix)))
    && full.contains("\"terminate_reason\": \"drained drain_s=120\"") && full.contains("\"hourly_usd\": 3.6,") && full.contains("\"spend_usd\": 5.4,")
    && full.contains("\"tallies\": \{\"requests\": 7, \"first_turn_unix\": null}") && !full.contains("tallies_unread") && !full.contains("\n")
    && unpriced.contains("\"hourly_usd\": null") && unpriced.contains("\"spend_usd\": null") && unpriced.contains("\"tallies_unread\": \"router stats unread: the CLI exited 7\"") && !unpriced.contains("\"tallies\":")
    && unstarted.contains("\"billed_since_unix\": null") && unstarted.contains("\"hourly_usd\": 3.6,") && unstarted.contains("\"spend_usd\": null")
}

// REAL EXECUTION of the record write, in a scratch directory: a card's record is created whole, once; a second write
// for the same card is refused rather than overwriting the first, and the file reads back as the one line written.
// RED: a plain Write here would answer written twice and keep the second record.
test fn a_released_cards_record_is_written_once() -> Bool {
  let path = concat(shell.Mktemp.DirWithTemplate(template: "/tmp/gunbc_flex_ledger.XXXXXX").path, "/card-ledger-i-0a.json")
  let first = flex_aws_write_card_ledger_at(path: path, l: ledger(hourly: 3600000, since: now_unix - 5400, read: true))
  let second = flex_aws_write_card_ledger_at(path: path, l: ledger(hourly: -1, since: now_unix - 5400, read: false))
  let back = Filesystem.Read(path: path)
  first.starts_with("ledger=written ") && second.starts_with("ledger=kept (already recorded) ")
    && (back.content == concat(flex_aws_card_ledger_json(l: ledger(hourly: 3600000, since: now_unix - 5400, read: true)), "\n"))
}
