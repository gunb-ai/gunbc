module test.claim.fleet.fleet_microvm_workflow_witness

import std.types { Bool, String, List }
import std.optional { Absent, Present }
import v2.std.diagnostic { outcome_accepted_value }
import gunbc.fleet.fleet_converge_workflow { fleet_converge_microvm_host_converge_step, fleet_converge_microvm_boot_probe_step }
import gunbc.actions_run_binding { fleet_converge_expected_host_env_name }
import extdeps.github.actions { Step, RunStep }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE BINDING IS ONLY A WALL IF THE STEP TELLS IT WHICH HOST WAS SELECTED, and for one revision it
// did not. gunbc.runner.runner_microvm_host_ready seals the operator's choice against the machine's own
// hostname before any fetch, install or receipt write, reading that choice from
// FLEET_CONVERGE_EXPECTED_HOST -- and both micro-VM steps carried `env: none`, so every dispatch of
// either mode would have exited ExpectedHostAbsent having done nothing. The readback the repair
// exists to deliver had a route that terminated in a refusal, which is gunbc.design_argument::consumption's
// consumption question answered in the negative: a named consumer that cannot start.
//
// This asserts over the STEP VALUES rather than the emitted YAML text, because the text is a
// projection and the defect was in what the projection was given. Both modes are checked: they fail
// independently, so a control over one would have left the other dark.
fn microvm_step_env_names(step: Step) -> List<String> {
  match step {
    RunStep { name: _, id: _, run: _, shell: _, env: e, working_directory: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } =>
      match e { Present { value: kvs } => map(kvs, p => p.key)  Absent => [] }
    _ => []
  }
}

// The two micro-VM step builders now yield Outcome<Step>. The type checker accepts an Outcome<Step> where a
// Step is declared, so handing one straight to the RunStep match above would silently miss and return the
// empty list -- a false red. Unwrap the accepted step; a refusal yields the empty list so the assertion fails
// closed instead of passing on a fabricated blank (any([]) is false, so the claim cannot be satisfied by a
// refused step).
fn microvm_step_env_names_of(step: Outcome<Step>) -> List<String> {
  match outcome_accepted_value(step) {
    Present { value: s } => microvm_step_env_names(step: s)
    Absent => []
  }
}

test fn both_microvm_steps_pass_the_selected_host_to_the_binding() -> Bool {
  let converge_env = microvm_step_env_names_of(step: fleet_converge_microvm_host_converge_step())
  let probe_env = microvm_step_env_names_of(step: fleet_converge_microvm_boot_probe_step())
  any(converge_env, n => n == fleet_converge_expected_host_env_name)
    && any(probe_env, n => n == fleet_converge_expected_host_env_name)
}
