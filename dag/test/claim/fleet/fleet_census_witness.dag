test fn census_srv3_is_eligible() -> Bool {
  match census_host_standing(host: operator_host_srv3) {
    Present { value: CensusEligible { host: _ } } => true
    _ => false
  }
}

test fn census_srv4_is_eligible() -> Bool {
  match census_host_standing(host: operator_host_srv4) {
    Present { value: CensusEligible { host: _ } } => true
    _ => false
  }
}

test fn census_unenrolled_host_is_excluded_with_reason() -> Bool {
  match census_host_standing(host: operator_host_srv9) {
    Present { value: CensusExcluded { host: _, reason: r } } => length(r) > 0
    _ => false
  }
}

test fn census_no_host_is_silently_absent() -> Bool {
  fold(
    operator_hosts,
    init: true,
    f: (acc, h) =>
      acc && match census_host_standing(host: h) {
        Present { value: _ } => true
        Absent => false
      },
  )
}

test fn capacity_not_available_without_job_executed() -> Bool {
  let evidence = CapacityEvidence {
    services_healthy: true,
    registrations_observed: true,
    resource_admission_resolved: true,
    job_executed: false,
  }
  match capacity_standing(host: operator_host_srv3, evidence: evidence) {
    CapacityNotYetAvailable { host: _, missing: m } =>
      fold(m, init: false, f: (acc, s) => acc || string_contains(s: s, pattern: "job"))
    CapacityAvailable { host: _ } => false
  }
}

test fn capacity_available_with_all_four_conditions() -> Bool {
  let evidence = CapacityEvidence {
    services_healthy: true,
    registrations_observed: true,
    resource_admission_resolved: true,
    job_executed: true,
  }
  match capacity_standing(host: operator_host_srv3, evidence: evidence) {
    CapacityAvailable { host: _ } => true
    CapacityNotYetAvailable { host: _, missing: _ } => false
  }
}

test fn capacity_missing_lists_all_unmet_conditions() -> Bool {
  let evidence = CapacityEvidence {
    services_healthy: false,
    registrations_observed: false,
    resource_admission_resolved: false,
    job_executed: false,
  }
  length(capacity_missing_conditions(evidence: evidence)) == 4
}
