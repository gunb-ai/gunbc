test fn census_covers_every_identified_host() -> Bool {
  census_covers_all_identified_hosts()
}

test fn census_gives_srv1_a_standing() -> Bool {
  match census_host_standing(host: operator_host_srv1) {
    Present { value: _ } => true
    Absent => false
  }
}

