module test.claim.fleet.fleet_converge_roster_reach_inhabitance_witness

import std.types { Bool, List, String }
import std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import gunbc.ci.ci_spec { gunbc_run_step_targets, gunbc_ci_runner_host_file_converge_target, GunbcRunStepTarget }
import v2.std.fn_index { FnArrowDecl, call_reachable_decls_from_root, fn_arrow_decl_facts_live }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// INHABITANCE CLAIM (DESIGN §3 pairing) FOR fleet_converge_roster_token_prelude_witness. That witness SUPPLIES
// the targets whose entry reaches the roster read; this one runs the REAL call-reach walk over the pool and
// asserts the route: the supplied target does reach organization_runner_roster_live_read, and no other
// pool target does. Deleting the walk, or a new roster-reading mode appearing, makes this fail. Its cost is the
// one fn_arrow_decl_facts_live pass over the pool, paid once
// here and not per claim.
//
// REACH, AND WHAT IT DOES NOT SEE. The walk follows calls through the pool modules only (the runner
// and fleet trees); a target whose entry module lies outside the pool is not evaluated, and a roster
// read written as a service call rather than a bare call is invisible to the declaration census
// (see fleet_health_read_only_witness). The claim below pins that the walk does enter
// the bracket route (count == 1), so a pool that loses it fails here rather than narrowing the claim.
data pool_roots: List<String> = ["dag/gunbc/runner", "dag/gunbc/fleet"]

data roster_read_name: String = "gunbc.fleet.organization_runner_roster_read.organization_runner_roster_live_read"

fn slashes_to_dots(s: String) -> String {
  if string_length(s: s) == 0 { "" } else {
    let head = substring(s: s, start: 0, end: 1)
    concat(if head == "/" { "." } else { head }, slashes_to_dots(s: substring(s: s, start: 1, end: string_length(s: s))))
  }
}

fn entry_module(t: GunbcRunStepTarget) -> String {
  slashes_to_dots(s: substring(s: t.entry, start: 4, end: string_length(s: t.entry) - 4))
}

fn decl_module(d: FnArrowDecl) -> String {
  substring(s: d.qualified_name, start: 0, end: string_length(s: d.qualified_name) - string_length(s: d.name) - 1)
}

fn in_pool(t: GunbcRunStepTarget) -> Bool {
  any(pool_roots, r => string_contains(s: t.entry, pattern: r))
}

fn reaches_roster_read_over(t: GunbcRunStepTarget, decls: List<FnArrowDecl>) -> Bool {
  let reach = call_reachable_decls_from_root(
    entry_module: entry_module(t: t),
    fn_name: t.function,
    terminal_callee_symbols: [],
    closure_modules: map(decls, d => decl_module(d: d)),
    decls: decls
  )
  any(reach.reached, d => d.qualified_name == roster_read_name)
}

fn pool_decls() -> List<FnArrowDecl> {
  fn_arrow_decl_facts_live(pool_roots: pool_roots, pool_files: [])
}

fn roster_reading_targets(decls: List<FnArrowDecl>) -> List<GunbcRunStepTarget> {
  filter(gunbc_run_step_targets(), t => in_pool(t: t) && reaches_roster_read_over(t: t, decls: decls))
}

test fn the_real_walk_derives_exactly_the_host_file_converge_target() -> Bool {
  let derived = roster_reading_targets(decls: pool_decls())
  count(derived) == 1 && all(derived, t => t.function == gunbc_ci_runner_host_file_converge_target.function)
}
