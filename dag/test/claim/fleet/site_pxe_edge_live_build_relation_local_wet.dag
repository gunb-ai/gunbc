module test.claim.fleet.site_pxe_edge_live_build_relation_local_wet

import std.types { Bool, NonEmptyStr, String }
import std.content_hash { ContentHash, Sha256Hash, Sha256Digest }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import extdeps.shell
import extdeps.filesystem.filesystem_io { Filesystem }
import extdeps.tools.sha256sum { Sha256FileDigest, Sha256FileDigestUnavailable, sha256sum_file_digest_via_shell }
import extdeps.provisioning.ubuntu_seeded_install_media { UbuntuSeededInstallMediaBuildInput, ubuntu_seeded_install_media_built, ubuntu_seeded_install_media_record_path }
import gunbc.machine_intake.boot_image_fetch { boot_image_published_path }
import gunbc.machine_intake.mtcollins1_census_image { CensusImageDerived, CensusImageRefused, mtcollins1_census_image }
import gunbc.host_command_binding { LocalCommandHost }
import gunbc.fleet.site_pxe_edge_live_build_relation { BuildRelationRead, BuildRelationUnread, site_pxe_edge_live_build_relation_on }
import gunbc.fleet.site_pxe_edge_converge { SitePxeEdgeLiveImage, LiveBuildEstablished, LiveBuildNotTheImages, site_pxe_edge_live_build_standing }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE INHABITANCE HALF OF the converge witness's build-relation arms (gunbc.design_argument::witness_one_interface). The sealed relation can only be
// minted by site_pxe_edge_live_build_relation_on reading the publisher's derivation record and re-measuring the file, and a sealed value cannot be
// built by a hermetic witness. This claim runs that producer against a real directory: a record naming the file's own measured digest reads as a
// relation (the positive control); the same record at another served path, over other bytes, or before any record exists is unread. DELETING THE
// PRODUCER CALL MAKES THIS FAIL: the positive arm needs BuildRelationRead and nothing else in the module can supply it.
fn census_authority_input() -> UbuntuSeededInstallMediaBuildInput? {
  match mtcollins1_census_image {
    CensusImageRefused { reason: _ } => Absent
    CensusImageDerived { input: i } => Present { value: i }
  }
}

fn digest_of(path: NonEmptyStr) -> NonEmptyStr {
  match sha256sum_file_digest_via_shell(path: path) {
    Sha256FileDigestUnavailable { path: _, reason: _ } => "unreadable" as NonEmptyStr
    Sha256FileDigest { digest: x } => x.hex
  }
}

fn image_hash(hex: NonEmptyStr) -> ContentHash {
  Sha256Hash(Sha256Digest { hex: hex as String })
}

test fn the_build_relation_is_read_from_the_publisher_by_real_execution() -> Bool {
  match census_authority_input() {
    Absent => false
    Present { value: input } =>
      let dir = shell.Mktemp.Dir()
      let d = dir.path as NonEmptyStr
      let probe = concat(dir.path as String, "/probe") as NonEmptyStr
      let wrote_probe = Filesystem.Write(path: probe as String, content: "census-image-bytes")
      let digest = digest_of(path: probe)
      let record = ubuntu_seeded_install_media_record_path(dir: d, input: input)
      let image = boot_image_published_path(export_dir: d, image_name: ubuntu_seeded_install_media_built(input: input, output_digest: digest).image_name)
      let before_record = match site_pxe_edge_live_build_relation_on(host: LocalCommandHost, input: input, dir: d, served_path: image) {
        BuildRelationUnread { reason: r } => string_contains(s: r, pattern: "no derivation record")
        BuildRelationRead { relation: _ } => false
      }
      let wrote_record = Filesystem.Write(path: record as String, content: concat(digest as String, "\n"))
      let image_absent = match site_pxe_edge_live_build_relation_on(host: LocalCommandHost, input: input, dir: d, served_path: image) {
        BuildRelationUnread { reason: r } => string_contains(s: r, pattern: "absent")
        BuildRelationRead { relation: _ } => false
      }
      let wrote_other = Filesystem.Write(path: image as String, content: "some-other-bytes")
      let diverged = match site_pxe_edge_live_build_relation_on(host: LocalCommandHost, input: input, dir: d, served_path: image) {
        BuildRelationUnread { reason: r } => string_contains(s: r, pattern: "measures")
        BuildRelationRead { relation: _ } => false
      }
      let wrote_same = Filesystem.Write(path: image as String, content: "census-image-bytes")
      let elsewhere = match site_pxe_edge_live_build_relation_on(host: LocalCommandHost, input: input, dir: d, served_path: concat(dir.path as String, "/other.iso") as NonEmptyStr) {
        BuildRelationUnread { reason: r } => string_contains(s: r, pattern: "not at the path the edge serves")
        BuildRelationRead { relation: _ } => false
      }
      let reading = site_pxe_edge_live_build_relation_on(host: LocalCommandHost, input: input, dir: d, served_path: image)
      let read = match reading {
        BuildRelationRead { relation: rel } => (rel.built.output_digest as String) == (digest as String) && (rel.path as String) == (image as String)
        BuildRelationUnread { reason: _ } => false
      }
      let established = match site_pxe_edge_live_build_standing(build: input, reading: reading, image: SitePxeEdgeLiveImage { served_path: image, digest: image_hash(hex: digest) }) {
        LiveBuildEstablished => true
        LiveBuildNotTheImages { reason: _ } => false
      }
      let other_digest = match site_pxe_edge_live_build_standing(build: input, reading: reading, image: SitePxeEdgeLiveImage { served_path: image, digest: image_hash(hex: "1111111111111111111111111111111111111111111111111111111111111111" as NonEmptyStr) }) {
        LiveBuildNotTheImages { reason: r } => string_contains(s: r, pattern: "digest")
        LiveBuildEstablished => false
      }
      let cleaned = shell.Remove.RecursiveForce(path: dir.path)
      dir.success && wrote_probe.success && wrote_record.success && wrote_other.success && wrote_same.success
        && before_record && image_absent && diverged && elsewhere && read && established && other_digest
  }
}
