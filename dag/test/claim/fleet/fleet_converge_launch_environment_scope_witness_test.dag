data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE SUBJECT: RLM-2's launch environment is a NARROWER convergence obligation than the host, and
// the evidence below is that narrowing observed as a DIFFERENCE rather than asserted as a property.
//
// THE INCIDENT. The RLM-2b plan run over srv1 landed
// `partially_applied|33|slot=31 cap=0 timer=0 fabric-cell=0 activation=2`. Thirty-one of those are
// REFUSED-REMOVAL on runner slots whose ownership no provenance signal establishes, and two are the
// runner-service activation stall every production caller supplies. Both belong to CI runner
// capacity and to its own plan. The RLM deployment fold accepts only FullyApplied, so the launch
// environment could not be proven converged for reasons that say nothing about it.
//
// THE SCOPE CARRIES TIMER RETIREMENT AND NOTHING ELSE, and an earlier cut of this file tested a
// wider one. Caps and fabric cells were removed after review measured them as foreign -- caps
// because gunbc_runner_per_slot_dropin_path resolves under /etc/systemd/system/actions-runner@
// .service.d and is therefore the same CI-capacity family reached by another name, and fabric cells
// because docs/plans/roadmap-launch-mvp-plan.md rules them off this proof's path outright. The
// controls below now pin BOTH exclusions, not just the slot and activation ones.
//
// EVERY CLAIM IS A PAIR OVER ONE HOST OBSERVATION, full-host beside launch-environment, so a red is
// attributable to the scope rather than to the harness. Asserting only that a launch plan is
// FullyApplied would stay green if the refusal disappeared for any reason at all.

data witness_unmodeled_host: NonEmptyStr = "srv9" as NonEmptyStr
data witness_host_srv1: NonEmptyStr = "srv1" as NonEmptyStr

// AN UNMODELED HOST IS THE MINIMAL DISCRIMINATING OBSERVATION: its runner-slot family refuses
// (REFUSED-UNMODELED-HOST, one refusal) while its caps, timers and fabric cells have nothing
// refused, so every difference below is attributable to the slot and activation axes alone.
fn witness_full_host_request() -> FleetConvergeRequest {
  FullHostConverge {
    host: witness_unmodeled_host,
    observed_timers: [],
    observed_caps: [],
    observed_spark: [],
    observed_slots: [],
    observed_fabric_cells: fabric_cell_observation_unobserved(host: witness_unmodeled_host as HostIdentity),
    observed_activation_readiness: runner_activation_readiness_unobserved_no_transaction,
  }
}

fn witness_launch_environment_request() -> FleetConvergeRequest {
  LaunchEnvironmentConverge { host: witness_unmodeled_host, observed_timers: [] }
}

fn terminal_is_fully_applied(t: FleetConvergeApplyTerminal) -> Bool {
  match t {
    FullyApplied => true
    PartiallyApplied { refused_axis_count: _, detail: _ } => false
  }
}

fn scope_is_launch_environment(s: FleetConvergeScope) -> Bool {
  match s {
    LaunchEnvironment => true
    FullHost => false
    FabricExecutionCellsOnly => false
    FabricAllocationStoreOnly => false
  }
}

// THE PAIR. One observation, two scopes, opposite terminals -- and the full-host half is the
// control that makes the launch-environment half mean anything.
test fn the_launch_environment_scope_is_fully_applied_where_the_host_scope_is_not() -> Bool {
  terminal_is_fully_applied(t: fleet_converge_apply_terminal(request: witness_launch_environment_request()))
    && !terminal_is_fully_applied(t: fleet_converge_apply_terminal(request: witness_full_host_request()))
}

// THE WIRE IS WHAT RLM-2's DEPLOYMENT FOLD READS: it requires the exact token and cannot re-derive
// a refusal count, so the terminal being FullyApplied and the wire spelling it are two facts.
test fn the_launch_environment_terminal_wire_is_the_token_the_rlm_join_requires() -> Bool {
  fleet_converge_apply_terminal_wire(
    terminal: fleet_converge_apply_terminal(request: witness_launch_environment_request()),
  ) == "fully_applied"
}

// WITHOUT THIS, the pair above would also be satisfied by a full-host plan refusing for some
// unrelated reason.
test fn the_host_scope_detail_still_attributes_its_refusal_to_the_slot_axis() -> Bool {
  match fleet_converge_apply_terminal(request: witness_full_host_request()) {
    FullyApplied => false
    PartiallyApplied { refused_axis_count: _, detail: d } =>
      string_contains(s: d, pattern: "slot=1") && string_contains(s: d, pattern: "activation=")
  }
}

// THE SCOPE IS NOT A CEREMONIAL EMPTY ONE, WHICH THE REVIEW EXPLICITLY DID NOT AUTHORIZE.
//
// Timer retirement is a real obligation: the legacy srv1 timers are OBSERVED, they enter the
// baseline the subject fingerprints and apply compare-and-swaps against, they render as REMOVE
// lines in the reviewed plan body, and they emit actual teardown work into apply.sh. A scope whose
// only axis produced no rows, no baseline members and no executed lines would be a receipt wearing
// a plan's shape; this asserts all four in one claim so none can quietly become vacuous.
fn witness_legacy_timer_launch_request() -> FleetConvergeRequest {
  LaunchEnvironmentConverge {
    host: witness_host_srv1,
    observed_timers: timer_retirement_observed_legacy_srv1(),
  }
}

test fn the_launch_environment_scope_carries_a_real_timer_obligation() -> Bool {
  let req = witness_legacy_timer_launch_request()
  let baseline = observed_baseline_text(request: req)
  let shell = fleet_converge_apply_shell(
    request: req,
    terminal: fleet_converge_apply_terminal(request: req),
  )
  let artifact = fleet_converge_launch_environment_plan_artifact(
    host: witness_host_srv1,
    prior_generation: 0,
    observed_timers: timer_retirement_observed_legacy_srv1(),
  )
    string_contains(s: baseline, pattern: "timer:")
      && string_contains(s: artifact.plan_body, pattern: "# timer-retirement")
      && string_contains(s: artifact.plan_body, pattern: "REMOVE timer-unit ")
      && string_contains(s: shell, pattern: "systemctl")
      && (serialize_content_hash(hash: fleet_converge_plan_subject(request: req).member_set_fingerprint) as String)
           != (serialize_content_hash(
                hash: fleet_converge_plan_subject(
                  request: LaunchEnvironmentConverge { host: witness_host_srv1, observed_timers: [] },
                ).member_set_fingerprint,
              ) as String)
}

// THE EXECUTED SCRIPT CARRIES NO FOREIGN AXIS. A terminal that omitted the axes while the script
// still emitted their work would be the worse failure of the two: a converged launch environment
// reported while CI runner capacity nobody planned is actuated.
test fn the_launch_environment_apply_script_emits_no_foreign_axis_work() -> Bool {
  let le = fleet_converge_apply_shell(
    request: witness_launch_environment_request(),
    terminal: fleet_converge_apply_terminal(request: witness_launch_environment_request()),
  )
  let fh = fleet_converge_apply_shell(
    request: witness_full_host_request(),
    terminal: fleet_converge_apply_terminal(request: witness_full_host_request()),
  )
  !string_contains(s: le, pattern: "# runner-slot membership")
    && !string_contains(s: le, pattern: "# runner-service activation (gunbc.runner_service_activation)")
    && !string_contains(s: le, pattern: "REFUSED-UNMODELED-HOST")
    && !string_contains(s: le, pattern: "fabric-cell")
    && !string_contains(s: le, pattern: gunbc_runner_per_slot_dropin_path)
    && string_contains(s: fh, pattern: "# runner-slot membership")
    && string_contains(s: fh, pattern: "# runner-service activation (gunbc.runner_service_activation)")
    && string_contains(s: fh, pattern: "REFUSED-UNMODELED-HOST")
}

// THE REVIEWED BODY CARRIES ONE COUNTER, AND FOUR ARE ABSENT. A `# cap-refusals=0` row under a
// scope that never observed caps is the empty-observation narrow in its reporting form: zero reads
// as "nothing was refused on this axis", a claim about the host, where the truth is that the axis
// was never this scope's obligation.
test fn the_launch_environment_plan_body_carries_only_its_own_axis_counter() -> Bool {
  let artifact = fleet_converge_launch_environment_plan_artifact(
    host: witness_unmodeled_host,
    prior_generation: 0,
    observed_timers: [],
  )
    string_contains(s: artifact.plan_body, pattern: "# scope=scope:launch-environment")
      && string_contains(s: artifact.plan_body, pattern: "# timer-refusals=")
      && !string_contains(s: artifact.plan_body, pattern: "# slot-refusals=")
      && !string_contains(s: artifact.plan_body, pattern: "# activation-refusals=")
      && !string_contains(s: artifact.plan_body, pattern: "# cap-refusals=")
      && !string_contains(s: artifact.plan_body, pattern: "# fabric-cell-refusals=")
      && !string_contains(s: artifact.plan_body, pattern: "# cap-axis")
      && !string_contains(s: artifact.plan_body, pattern: "# fabric-cell")
      && string_contains(s: artifact.plan_body, pattern: "# apply-terminal: FullyApplied")
}

// THE CONTROL THAT SEPARATES "the launch scope omits these axes" FROM "these axes were deleted".
test fn the_full_host_plan_body_still_carries_the_slot_and_activation_counters() -> Bool {
  match fleet_converge_plan_artifact(
    host: witness_unmodeled_host,
    prior_generation: 0,
    observed_timers: [],
    observed_caps: [],
    spark_axis: SparkServingAxisNotApplicable { host: witness_unmodeled_host as HostIdentity },
    observed_slots: [],
    observed_fabric_cells: fabric_cell_observation_unobserved(host: witness_unmodeled_host as HostIdentity),
    observed_activation_readiness: runner_activation_readiness_unobserved_no_transaction,
  ) {
    FleetConvergePlanArtifactRefused { refusal: _ } => false
    FleetConvergePlanArtifactReady { artifact: artifact } =>
      string_contains(s: artifact.plan_body, pattern: "# scope=scope:full-host")
        && string_contains(s: artifact.plan_body, pattern: "# slot-refusals=")
        && string_contains(s: artifact.plan_body, pattern: "# activation-refusals=")
        && string_contains(s: artifact.plan_body, pattern: "# cap-refusals=")
        && string_contains(s: artifact.plan_body, pattern: "# fabric-cell-refusals=")
        && string_contains(s: artifact.plan_body, pattern: "# apply-terminal: PartiallyApplied")
  }
}

// CAP DRIFT IS OBSERVABLE UNDER FULL-HOST AND HAS NO POSITION UNDER LAUNCH.
//
// A cap drop-in whose content differs from desired is a real, actionable difference. Under
// full-host it reaches the reviewed body as a cap action on a path under the runner unit template's
// drop-in directory. Under launch-environment there is no field to observe it into, so no plan body
// can mention it -- which is the point, because the launch scope's apply.sh never emitted cap work
// anyway (drop-in writes are live_deploy deploy-principal authority), so counting cap refusals
// there would have reported an axis whose work this script cannot perform.
fn drifted_cap() -> CapMember {
  CapMember {
    dropin_path: gunbc_runner_per_slot_dropin_path as NonEmptyStr,
    content: "[Service]\nMemoryMax=1\n",
  }
}

test fn cap_drift_is_visible_under_full_host_and_unconstructible_under_launch() -> Bool {
  let full_with_drift = fleet_converge_plan_artifact(
    host: witness_host_srv1,
    prior_generation: 0,
    observed_timers: [],
    observed_caps: [drifted_cap()],
    spark_axis: SparkServingAxisNotApplicable { host: witness_host_srv1 as HostIdentity },
    observed_slots: [],
    observed_fabric_cells: fabric_cell_observation_unobserved(host: witness_host_srv1 as HostIdentity),
    observed_activation_readiness: runner_activation_readiness_unobserved_no_transaction,
  )
  let launch = fleet_converge_launch_environment_plan_artifact(
    host: witness_host_srv1,
    prior_generation: 0,
    observed_timers: [],
  )
  match full_with_drift {
    FleetConvergePlanArtifactRefused { refusal: _ } => false
    FleetConvergePlanArtifactReady { artifact: fh } => {
      let le = launch
      string_contains(s: fh.plan_body, pattern: "# cap-axis")
            && string_contains(s: fh.plan_body, pattern: gunbc_runner_per_slot_dropin_path)
            && !string_contains(s: le.plan_body, pattern: gunbc_runner_per_slot_dropin_path)
            && !string_contains(s: le.plan_body, pattern: "# cap-axis")
            && !string_contains(s: le.apply_shell, pattern: gunbc_runner_per_slot_dropin_path)
    }
  }
}

// THE CAP PATH IS A RUNNER-UNIT PATH, WHICH IS THE MEASUREMENT THAT CONDEMNED THE EARLIER CUT.
// This is not decoration beside the claim above: it is the fact that makes caps foreign rather
// than merely out of budget, and nothing else in this file would notice if the path moved.
test fn the_cap_axis_lives_under_the_actions_runner_unit_template() -> Bool {
  string_contains(s: gunbc_runner_per_slot_dropin_path, pattern: runner_unit_prefix)
    && string_contains(s: gunbc_runner_per_slot_dropin_path, pattern: runner_unit_template_name as String)
}

// A FABRIC OBSERVATION MOVES THE SCOPES THAT OWN IT AND CANNOT ENTER THIS ONE. srv3 has an expected
// fabric cell, so an unobserved population there is a REFUSAL for a scope carrying that axis; the
// launch body cannot render it under any host because the arm has no field for it.
test fn a_refusing_fabric_observation_moves_full_host_and_cannot_enter_launch() -> Bool {
  let fh = fleet_converge_plan_artifact(
    host: operator_host_srv3 as NonEmptyStr,
    prior_generation: 0,
    observed_timers: [],
    observed_caps: [],
    spark_axis: SparkServingAxisNotApplicable { host: operator_host_srv3 },
    observed_slots: [],
    observed_fabric_cells: fabric_cell_observation_unobserved(host: operator_host_srv3),
    observed_activation_readiness: runner_activation_readiness_unobserved_no_transaction,
  )
  let le = fleet_converge_launch_environment_plan_artifact(
    host: operator_host_srv3 as NonEmptyStr,
    prior_generation: 0,
    observed_timers: [],
  )
  match fh {
    FleetConvergePlanArtifactRefused { refusal: _ } => false
    FleetConvergePlanArtifactReady { artifact: f } => {
      let l = le
      string_contains(s: f.plan_body, pattern: "REFUSED-OBSERVATION fabric-cell")
            && !string_contains(s: l.plan_body, pattern: "fabric-cell")
            && terminal_is_fully_applied(t: fleet_converge_apply_terminal(
                 request: LaunchEnvironmentConverge { host: operator_host_srv3 as NonEmptyStr, observed_timers: [] },
               ))
    }
  }
}

// ---------------------------------------------------------------------------
// SCOPE-CROSSING AND MUTATION CONTROLS
// ---------------------------------------------------------------------------

test fn a_launch_environment_plan_cannot_be_applied_against_a_full_host_reobservation() -> Bool {
  match fleet_converge_apply_artifact_admits(
    planned_host_text: witness_unmodeled_host as String,
    planned_scope_wire: fleet_converge_scope_wire(scope: LaunchEnvironment),
    planned_fingerprint_text: serialize_content_hash(
      hash: fleet_converge_plan_subject(request: witness_launch_environment_request()).member_set_fingerprint,
    ) as String,
    observed: witness_full_host_request(),
  ) {
    ApplyScopeMismatch { planned_wire: p, observed_wire: o } =>
      p == "scope:launch-environment" && o == "scope:full-host"
    ApplyAdmitted => false
    ApplySubjectHostMismatch { planned: _, observed: _ } => false
    ApplyScopeUndecodable { cause: _ } => false
    ApplyMemberSetMismatch => false
    ApplyAllocationStorePrestateMismatch { namespace_path: _, store_path: _, observed: _ } => false
  }
}

// THE REVERSE, because a one-directional refusal leaves open the arm that actually actuates: a
// full-host plan admitted against a launch re-observation runs slot work under a scope that never
// reviewed it.
test fn a_full_host_plan_cannot_be_applied_against_a_launch_environment_reobservation() -> Bool {
  match fleet_converge_apply_artifact_admits(
    planned_host_text: witness_unmodeled_host as String,
    planned_scope_wire: fleet_converge_scope_wire(scope: FullHost),
    planned_fingerprint_text: serialize_content_hash(
      hash: fleet_converge_plan_subject(request: witness_full_host_request()).member_set_fingerprint,
    ) as String,
    observed: witness_launch_environment_request(),
  ) {
    ApplyScopeMismatch { planned_wire: p, observed_wire: o } =>
      p == "scope:full-host" && o == "scope:launch-environment"
    ApplyAdmitted => false
    ApplySubjectHostMismatch { planned: _, observed: _ } => false
    ApplyScopeUndecodable { cause: _ } => false
    ApplyMemberSetMismatch => false
    ApplyAllocationStorePrestateMismatch { namespace_path: _, store_path: _, observed: _ } => false
  }
}

fn admission_is_scope_undecodable(wire: String) -> Bool {
  match fleet_converge_apply_artifact_admits(
    planned_host_text: witness_unmodeled_host as String,
    planned_scope_wire: wire,
    planned_fingerprint_text: serialize_content_hash(
      hash: fleet_converge_plan_subject(request: witness_launch_environment_request()).member_set_fingerprint,
    ) as String,
    observed: witness_launch_environment_request(),
  ) {
    ApplyScopeUndecodable { cause: _ } => true
    ApplyAdmitted => false
    ApplySubjectHostMismatch { planned: _, observed: _ } => false
    ApplyScopeMismatch { planned_wire: _, observed_wire: _ } => false
    ApplyMemberSetMismatch => false
    ApplyAllocationStorePrestateMismatch { namespace_path: _, store_path: _, observed: _ } => false
  }
}

// DEFAULTING TO FullHost FOR AN UNREADABLE WIRE WOULD WIDEN APPLY FROM ONE RESOURCE FAMILY TO EVERY
// FAMILY ON THE HOST, invisibly, because the wider run is what the old signature always did.
test fn a_mutated_persisted_scope_wire_refuses_rather_than_choosing_a_scope() -> Bool {
  admission_is_scope_undecodable(wire: "scope:launch-environmen")
    && admission_is_scope_undecodable(wire: "scope:launch environment")
    && admission_is_scope_undecodable(wire: "")
    && admission_is_scope_undecodable(wire: "scope:launch-environment-extended")
}

fn admission_is_admitted(planned: FleetConvergeRequest, observed: FleetConvergeRequest) -> Bool {
  match fleet_converge_apply_artifact_admits(
    planned_host_text: fleet_converge_request_host(request: planned) as String,
    planned_scope_wire: fleet_converge_scope_wire(scope: fleet_converge_request_scope(request: planned)),
    planned_fingerprint_text: serialize_content_hash(
      hash: fleet_converge_plan_subject(request: planned).member_set_fingerprint,
    ) as String,
    observed: observed,
  ) {
    ApplyAdmitted => true
    ApplySubjectHostMismatch { planned: _, observed: _ } => false
    ApplyScopeUndecodable { cause: _ } => false
    ApplyScopeMismatch { planned_wire: _, observed_wire: _ } => false
    ApplyMemberSetMismatch => false
    ApplyAllocationStorePrestateMismatch { namespace_path: _, store_path: _, observed: _ } => false
  }
}

// IDENTICAL-LOOKING POPULATIONS, DIFFERENT SCOPES. A slot-less full-host observation and a
// timer-less launch observation of one host agree on every MEMBER, so a fingerprint over members
// alone would admit one against the other. The scope row is inside the hashed baseline, so it does
// not. The conjunction matters: each side's OWN fingerprint still admits, which is what makes the
// refusal attributable to the crossing rather than to a fingerprint matching nothing.
test fn an_identical_looking_population_under_the_other_scope_still_refuses() -> Bool {
  admission_is_admitted(planned: witness_launch_environment_request(), observed: witness_launch_environment_request())
    && admission_is_admitted(planned: witness_full_host_request(), observed: witness_full_host_request())
    && !admission_is_admitted(planned: witness_launch_environment_request(), observed: witness_full_host_request())
    && !admission_is_admitted(planned: witness_full_host_request(), observed: witness_launch_environment_request())
}

test fn the_launch_environment_wire_round_trips_through_the_decode() -> Bool {
  match fleet_converge_scope_of_wire(wire: "scope:launch-environment") {
    ScopeDecoded { scope: s } => scope_is_launch_environment(s: s)
    ScopeUndecodable { cause: _ } => false
  }
    && scope_is_launch_environment(s: fleet_converge_request_scope(request: witness_launch_environment_request()))
}

// SCOPE EQUALITY IS NOW ASKED OF THE WIRE FOLD, so the property the old pairwise match had for
// free must be stated: two scopes sharing a wire spelling would compare equal, and the decode's
// inverse would be ambiguous too. This pins the four wires pairwise distinct.
test fn every_scope_wire_is_distinct() -> Bool {
  let wires = [
    fleet_converge_scope_wire(scope: FullHost),
    fleet_converge_scope_wire(scope: LaunchEnvironment),
    fleet_converge_scope_wire(scope: FabricExecutionCellsOnly),
    fleet_converge_scope_wire(scope: FabricAllocationStoreOnly),
  ]
  all(wires, w => list_length(items: filter(wires, x => x == w)) == 1)
}

test fn the_two_scopes_fingerprint_the_same_host_differently() -> Bool {
  let le = fleet_converge_plan_subject(request: witness_launch_environment_request())
  let fh = fleet_converge_plan_subject(request: witness_full_host_request())
  (serialize_content_hash(hash: le.member_set_fingerprint) as String)
    != (serialize_content_hash(hash: fh.member_set_fingerprint) as String)
    && string_contains(
      s: observed_baseline_text(request: witness_launch_environment_request()),
      pattern: "scope:launch-environment",
    )
    && !string_contains(
      s: observed_baseline_text(request: witness_launch_environment_request()),
      pattern: "scope:full-host",
    )
}

// ---------------------------------------------------------------------------
// THE PRODUCTION-SHAPED CONTROL: THE EXACT OBSERVATION THAT PRODUCED THE INCIDENT
// ---------------------------------------------------------------------------

// The thirty-one are spelled out rather than generated from a range: for a control whose content is
// the number 31, a range expression would let a boundary slip unobserved.
fn srv1_surplus_slot_names() -> List<String> {
  [
    "jit-runner.sh", "runner-liveness-reconcile.sh",
    "srv1-22", "srv1-23", "srv1-24", "srv1-25", "srv1-26", "srv1-27", "srv1-28", "srv1-29",
    "srv1-30", "srv1-31", "srv1-32", "srv1-33", "srv1-34", "srv1-35", "srv1-36", "srv1-37",
    "srv1-38", "srv1-39", "srv1-40", "srv1-41", "srv1-42", "srv1-43", "srv1-44", "srv1-45",
    "srv1-46", "srv1-47", "srv1-48", "srv1-49", "srv1-50",
  ]
}

fn srv1_production_shaped_slots() -> List<RunnerSlotMember> {
  map(srv1_surplus_slot_names(), nm => runner_slot_member_from_instance_name(instance_name: nm as NonEmptyStr))
}

fn srv1_full_host_request() -> FleetConvergeRequest {
  FullHostConverge {
    host: witness_host_srv1,
    observed_timers: [],
    observed_caps: fleet_converge_desired_caps(),
    observed_spark: [],
    observed_slots: srv1_production_shaped_slots(),
    observed_fabric_cells: fabric_cell_observation_unobserved(host: witness_host_srv1 as HostIdentity),
    observed_activation_readiness: runner_activation_readiness_unobserved_no_transaction,
  }
}

// THE INCIDENT, REPRODUCED AND THEN SPLIT. Same host, same timers, same everything the launch scope
// can see; the only difference is that one request type has runner-slot, activation, cap and fabric
// positions and the other has none.
test fn the_production_shaped_srv1_observation_splits_on_the_scope_alone() -> Bool {
  match fleet_converge_apply_terminal(request: srv1_full_host_request()) {
    FullyApplied => false
    PartiallyApplied { refused_axis_count: n, detail: d } =>
      n == 33
        && string_contains(s: d, pattern: "slot=31")
        && string_contains(s: d, pattern: "activation=2")
        && string_contains(s: d, pattern: "cap=0")
        && string_contains(s: d, pattern: "timer=0")
        && string_contains(s: d, pattern: "fabric-cell=0")
  }
    && terminal_is_fully_applied(t: fleet_converge_apply_terminal(
         request: LaunchEnvironmentConverge { host: witness_host_srv1, observed_timers: [] },
       ))
}

// THE EXCLUDED FAMILIES STILL REFUSE LOUDLY UNDER THE SCOPE THAT OWNS THEM. The narrowing removed
// an obligation from RLM and removed nothing from the fleet program.
test fn the_excluded_families_still_refuse_loudly_under_the_scope_that_owns_them() -> Bool {
  match fleet_converge_plan_artifact(
    host: witness_host_srv1,
    prior_generation: 0,
    observed_timers: [],
    observed_caps: fleet_converge_desired_caps(),
    spark_axis: SparkServingAxisNotApplicable { host: witness_host_srv1 as HostIdentity },
    observed_slots: srv1_production_shaped_slots(),
    observed_fabric_cells: fabric_cell_observation_unobserved(host: witness_host_srv1 as HostIdentity),
    observed_activation_readiness: runner_activation_readiness_unobserved_no_transaction,
  ) {
    FleetConvergePlanArtifactRefused { refusal: _ } => false
    FleetConvergePlanArtifactReady { artifact: artifact } =>
      string_contains(s: artifact.plan_body, pattern: "REFUSED-REMOVAL runner-slot")
        && string_contains(s: artifact.plan_body, pattern: "OwnershipUnknown")
        && string_contains(s: artifact.plan_body, pattern: "# slot-refusals=31")
        && string_contains(s: artifact.plan_body, pattern: "# activation-refusals=2")
  }
}

// ---------------------------------------------------------------------------
// THE SLOT-AND-ACTIVATION EXCLUSION ARGUMENT, COMPUTED RATHER THAN ASSERTED.
//
// SCOPE OF THIS CLAIM, NARROWED AFTER REVIEW: it proves that the deployment the RLM transaction
// installs owns no RUNNER UNIT, and therefore that the slot and activation axes are foreign to it.
// It says nothing about caps or fabric cells -- caps are excluded by
// the_cap_axis_lives_under_the_actions_runner_unit_template above (their path IS a runner-unit
// path), and fabric cells by the governing plan document, not by this join. An earlier cut let this
// claim read as proving the whole scope clean, which is exactly how caps survived in it.
//
// Both populations are asserted nonempty: a disjointness claim over an empty set is free and would
// go green if either producer silently stopped answering.
// ---------------------------------------------------------------------------
test fn the_launch_environment_owns_no_runner_unit_and_no_runner_unit_owns_it() -> Bool {
  let owned = map(deployment_owned_steps_retract_order(spec: deployment_spec_srv1()), s => s.path as String)
  let runner_units = concat(
    [runner_unit_template_name as String],
    map(committed_slot_identities(host: witness_host_srv1 as HostIdentity), i => runner_slot_unit_name(slot: i) as String),
  )
  list_length(items: owned) > 0
    && list_length(items: runner_units) > 0
    && !any(owned, p => any(runner_units, u => string_contains(s: p, pattern: u)))
    && !any(owned, p => string_contains(s: p, pattern: runner_unit_prefix))
}
