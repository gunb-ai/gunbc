module test.claim.fleet.fleet_host_key_enrollment_witness

import std.types { Bool, String, List, NonEmptyStr }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import product.host_identity { HostIdentity }
import extdeps.network.endpoint { socket_address, host_by_ipv4 }
import extdeps.network.ipv4 { ipv4_address }
// mac_address is called by the ProvisionedInstall fixtures below (added by #16107's planning
// consolidation on 2026-11-09) but its import was dropped in that pass, so this witness failed to
// resolve on main. Restoring it lets the uniqueness claims over fleet_host_key_enrollments -- which
// the butch row this PR adds must satisfy -- actually run.
import extdeps.network.mac { mac_address }
import gunbc.fleet.fleet_host_key_enrollment {
  KnownHostKeyRow,
  ScannedFirstContact,
  ProvisionedInstall,
  host_key_provenance_label,
  fleet_host_key_public_halves_are_unique,
  fleet_host_key_enrollments,
  enrolled_fingerprint_for,
  known_hosts_line,
  LanEndpointHostKey,
  lan_endpoint_host_keys,
  lan_endpoint_host_key_row,
  known_host_row_field,
}
import gunbc.fleet.fleet_host_identity { operator_host_srv14 }
import gunbc.host.host_reach_identity_probe {
  classify_reach_probe_wire_with_expectation,
  ProbeHostKeyUnenrolled,
  ProbeHostKeyMismatch,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// Hosts are read from the registry, never a roster name. The Absent subject cannot equal
// any enrolled host because it is prefixed and then the enrolled names themselves; adding
// or dropping a row cannot make it Present. The Present subject is the first row when the
// registry holds one.
fn host_the_registry_does_not_hold() -> String {
  concat("unenrolled:", join(map(fleet_host_key_enrollments, k => k.host as String), ","))
}

fn first_enrolled_host() -> String? {
  match fleet_host_key_enrollments.first() {
    Present { value: k } => Present { value: k.host as String }
    Absent => none
  }
}

// Acceptance item 4: a host the registry does not hold answers none (no fabricated
// Mismatch from an unenrolled lookup), and a known_hosts line renders exactly
// "endpoint keytype key". The line-shape row is a supplied fixture, not a roster cite.
test fn witness_unenrolled_host_yields_no_expectation_and_line_shape_is_exact() -> Bool {
  let absent_host = host_the_registry_does_not_hold()
  !any(fleet_host_key_enrollments, k => (k.host as String) == absent_host)
    && match enrolled_fingerprint_for(host: absent_host) {
      Present { value: _ } => false
      Absent => true
    }
    && known_hosts_line(k: KnownHostKeyRow {
      host: "srv5" as HostIdentity,
      address: socket_address(host: host_by_ipv4(addr: ipv4_address(octet1: 192, octet2: 168, octet3: 1, octet4: 222)), port: 22),
      key_type: "ssh-ed25519",
      public_key_base64: "AAAAC3NzaC1lZDI1NTE5AAAAIFAKEFAKEFAKE",
      sha256_fingerprint: "SHA256:fakefake",
      provenance: ScannedFirstContact { scanned_from: "192.168.1.222 fixture" as NonEmptyStr },
    }) == "192.168.1.222 ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFAKEFAKEFAKE"
}

// The same row behind a provider's ssh port mapping is written under the bracketed form ssh looks it up
// by; the bare form above is the port-22 control, byte-identical to the line before the address had a
// port.
test fn witness_a_row_on_a_non_standard_port_writes_the_bracketed_host_field() -> Bool {
  known_hosts_line(k: KnownHostKeyRow {
    host: "srv5" as HostIdentity,
    address: socket_address(host: host_by_ipv4(addr: ipv4_address(octet1: 192, octet2: 168, octet3: 1, octet4: 222)), port: 15648),
    key_type: "ssh-ed25519",
    public_key_base64: "AAAAC3NzaC1lZDI1NTE5AAAAIFAKEFAKEFAKE",
    sha256_fingerprint: "SHA256:fakefake",
    provenance: ScannedFirstContact { scanned_from: "192.168.1.222 fixture" as NonEmptyStr },
  }) == "[192.168.1.222]:15648 ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFAKEFAKEFAKE"
}

// A registry row's fingerprint reaches the probe classifier as a Present expectation:
// with it, a host-key verification failure classifies Mismatch carrying that exact
// expected fingerprint; without it, the same wire stays Unenrolled — the enrollment is
// what moves a host between the two remedies. The Present host is the first registry
// row; an empty registry is the Unenrolled control.
test fn witness_enrolled_expectation_moves_wire_from_unenrolled_to_mismatch() -> Bool {
  let expectation = match first_enrolled_host() {
    Present { value: h } => enrolled_fingerprint_for(host: h)
    Absent => none
  }
  match classify_reach_probe_wire_with_expectation(
    success: false,
    stdout: "",
    stderr: "Host key verification failed.",
    expected_fingerprint: expectation,
  ) {
    ProbeHostKeyUnenrolled { transport_diagnostic: _ } => match first_enrolled_host() { Absent => true  Present { value: _ } => false }
    ProbeHostKeyMismatch { expected_fingerprint: e, observed_fingerprint: _ } =>
      match first_enrolled_host() {
        Present { value: h } => match enrolled_fingerprint_for(host: h) { Present { value: f } => e == f  Absent => false }
        Absent => false
      }
    _ => false
  }
    && match classify_reach_probe_wire_with_expectation(
      success: false,
      stdout: "",
      stderr: "Host key verification failed.",
      expected_fingerprint: Present { value: "SHA256:enrolled" },
    ) {
      ProbeHostKeyMismatch { expected_fingerprint: e, observed_fingerprint: _ } => e == "SHA256:enrolled"
      _ => false
    }
}

// CLAIM: ONE PUBLIC HALF, ONE ROW -- ACROSS HOSTS AND ACROSS INSTALLS (T2's catalog rule,
// gunbc.plans.host_trust_provisioned_key (deleted 2026-11-08)). The same key material at two identities is the clone
// case: a cloned image or a cloned disk putting one private key at two hosts, a second install
// of ONE host re-enrolling the first install's key, and the same slot stating one half twice
// (the verbatim paste). All three refuse, whichever provenance arms carry them. The distinct
// case, one host's key stated at several addresses with corroborating records, and the REAL
// registry pass, so the rule is a live invariant of the committed catalog, not a fixture-only
// wish. Fixtures carry ProvisionedInstall provenance to pin the per-install reading: two rows
// of one host differing only in which attempt installed them still contradict when they share
// the public half.
test fn witness_the_same_public_half_enrolled_twice_refuses_the_catalog() -> Bool {
  let shared = KnownHostKeyRow {
    host: "srv9t" as HostIdentity,
    address: socket_address(host: host_by_ipv4(addr: ipv4_address(octet1: 192, octet2: 168, octet3: 1, octet4: 91)), port: 22),
    key_type: "ssh-ed25519",
    public_key_base64: "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
    sha256_fingerprint: "SHA256:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
    provenance: ProvisionedInstall { install_client_mac: mac_address(octet1: 0, octet2: 37, octet3: 144, octet4: 0, octet5: 0, octet6: 11), install_attempt: "attempt-9t-1", authority: "fixture: console capture plus receipt" },
  }
  let same_key_other_host = KnownHostKeyRow {
    host: "srv9u" as HostIdentity,
    address: socket_address(host: host_by_ipv4(addr: ipv4_address(octet1: 192, octet2: 168, octet3: 1, octet4: 92)), port: 22),
    key_type: "ssh-ed25519",
    public_key_base64: shared.public_key_base64,
    sha256_fingerprint: shared.sha256_fingerprint,
    provenance: ProvisionedInstall { install_client_mac: mac_address(octet1: 0, octet2: 37, octet3: 144, octet4: 0, octet5: 0, octet6: 11), install_attempt: "attempt-9u-1", authority: "fixture: console capture plus receipt" },
  }
  let same_key_later_install = KnownHostKeyRow {
    host: shared.host,
    address: shared.address,
    key_type: "ssh-ed25519",
    public_key_base64: shared.public_key_base64,
    sha256_fingerprint: shared.sha256_fingerprint,
    provenance: ProvisionedInstall { install_client_mac: mac_address(octet1: 0, octet2: 37, octet3: 144, octet4: 0, octet5: 0, octet6: 11), install_attempt: "attempt-9t-2", authority: "fixture: console capture plus receipt" },
  }
  let distinct = KnownHostKeyRow {
    host: "srv9v" as HostIdentity,
    address: socket_address(host: host_by_ipv4(addr: ipv4_address(octet1: 192, octet2: 168, octet3: 1, octet4: 93)), port: 22),
    key_type: "ssh-ed25519",
    public_key_base64: "BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB",
    sha256_fingerprint: "SHA256:BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB",
    provenance: ProvisionedInstall { install_client_mac: mac_address(octet1: 0, octet2: 37, octet3: 144, octet4: 0, octet5: 0, octet6: 11), install_attempt: "attempt-9v-1", authority: "fixture: console capture plus receipt" },
  }
  // The verbatim paste: the SAME ROW twice, the most likely copy-paste mistake, is a
  // contradiction too -- a check that field-compares two rows waves it through.
  fleet_host_key_public_halves_are_unique([shared, distinct])
    && !fleet_host_key_public_halves_are_unique([distinct, distinct])
    && !fleet_host_key_public_halves_are_unique([shared, same_key_other_host])
    && !fleet_host_key_public_halves_are_unique([shared, same_key_later_install])
    && !fleet_host_key_public_halves_are_unique([shared, same_key_other_host, distinct])
    && fleet_host_key_public_halves_are_unique(fleet_host_key_enrollments)
}

// CLAIM: THE PROVISIONED ARM RENDERS ITS LABEL -- the catalog speaks of this provenance by name;
// the label is not the scanned one and not the transcribed one.
test fn witness_the_provisioned_arm_renders_its_label() -> Bool {
  host_key_provenance_label(p: ProvisionedInstall { install_client_mac: mac_address(octet1: 0, octet2: 37, octet3: 144, octet4: 0, octet5: 0, octet6: 11), install_attempt: "attempt-x-1", authority: "fixture: record" }) == "provisioned-install"
    && host_key_provenance_label(p: ProvisionedInstall { install_client_mac: mac_address(octet1: 0, octet2: 37, octet3: 144, octet4: 0, octet5: 0, octet6: 11), install_attempt: "attempt-x-1", authority: "fixture: record" }) != "scanned-first-contact"
}

// A KEY ENROLLED AT A LAN ENDPOINT DERIVES ITS ROW FROM THE TOPOLOGY. Every observation in
// lan_endpoint_host_keys yields a row, so a topology edit that strands a key is red here rather than a
// silently shorter roster; srv14's row is pinned under the address measured on butch on 2026-11-10
// (`ip -o addr show enP2p4s0`), read through gunbc.fleet.fleet_intent_network srv14_host_lan_endpoint
// rather than restated; and a host with no LAN endpoint derives no row instead of a fabricated address.
test fn every_lan_endpoint_key_derives_its_row() -> Bool {
  let unaddressed = LanEndpointHostKey {
    host: "lan-endpoint-fixture-without-topology" as HostIdentity,
    key_type: "ssh-ed25519",
    public_key_base64: "fixture",
    sha256_fingerprint: "SHA256:fixture",
    provenance: ScannedFirstContact { scanned_from: "fixture" as NonEmptyStr },
  }
  all(lan_endpoint_host_keys, o => match lan_endpoint_host_key_row(observation: o) {
    Present { value: _ } => true
    Absent => false
  })
    && any(fleet_host_key_enrollments, k => (k.host as String) == (operator_host_srv14 as String) && known_host_row_field(k: k) == "192.168.1.205")
    && match lan_endpoint_host_key_row(observation: unaddressed) {
      Present { value: _ } => false
      Absent => true
    }
}
