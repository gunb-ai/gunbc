    Absent => false
  }
}

test fn convergence_refuses_a_baseline_without_the_cpld() -> Bool  {
  match admission_of(verdict: run_full(w: shape(power_off: true), baseline: baseline_of(label: "no CPLD", releases: [mt_collins_bmc_0_45_3_hpm, mt_collins_bios_0acod014_hpm, mt_collins_scp_2_10_hpm]), records: [], boot: Absent)) {
    Present { value: a } => match a { BaselineMissingTarget { target: t } => (t == MainboardCpld)  _ => false }
    Absent => false
  }
}

test fn convergence_refuses_a_duplicated_target() -> Bool  {
  match admission_of(verdict: run_full(w: shape(power_off: true), baseline: baseline_of(label: "two BMC rows", releases: [mt_collins_bmc_0_45_3_hpm, mt_collins_bmc_0_45_3_hpm, mt_collins_bios_0acod014_hpm, mt_collins_scp_2_10_hpm, mt_collins_mb_cpld_v06_hpm]), records: [], boot: Absent)) {
    Present { value: a } => match a { BaselineDuplicateTarget { target: t } => (t == BmcController)  _ => false }
    Absent => false
  }
}

// A BIOS row at 0.14.0 -- so it PAIRS with SCP 2.10 -- whose digest is not the Basic-Auth build's.
fn bios_014_unknown_digest() -> FirmwareReleaseRow {
  let r = mt_collins_bios_0acod014_hpm
  FirmwareReleaseRow {
    board: r.board, target: r.target, version: r.version, released_on: r.released_on,
    image_kind: r.image_kind, image_uri: r.image_uri, image_bytes: r.image_bytes,
    image_digest: Present { value: wrong_digest }, release_notes: "a 0.14.0 BIOS of unknown family", prerequisite: r.prerequisite,
    authority: r.authority,
  }
}

// RED (review on ff66edd): pairing passes, Basic-Auth interop fails, and convergence refuses it directly.
test fn convergence_refuses_a_paired_but_interop_invalid_baseline() -> Bool  {
  match admission_of(verdict: run_full(w: shape(power_off: true), baseline: baseline_of(label: "paired, not Basic-Auth", releases: [mt_collins_bmc_0_45_3_hpm, bios_014_unknown_digest(), mt_collins_scp_2_10_hpm, mt_collins_mb_cpld_v06_hpm]), records: [], boot: Absent)) {
    Present { value: a } => match a { BaselineInteropUnmet { when_target: w, requires_target: q } => (w == BmcController) && (q == HostBios)  _ => false }
    Absent => false
  }
}

// RED (review 74383): 0ACOC017 beside BMC 0.45.3. Isolated on the interop predicate, because pairing would
// also exclude this baseline and a selection-level RED could not tell which wall fired.
data bios_0acoc017_row: FirmwareReleaseRow = FirmwareReleaseRow {
  board: mt_collins_bios_0acod014_hpm.board, target: HostBios, version: v(major: 0, minor: 17, patch: 0),
  released_on: mt_collins_bios_0acod014_hpm.released_on, image_kind: mt_collins_bios_0acod014_hpm.image_kind,
  image_uri: mt_collins_bios_0acod014_hpm.image_uri, image_bytes: mt_collins_bios_0acod014_hpm.image_bytes,
  image_digest: Absent, release_notes: "0ACOC017 as shipped on mtcollins1; no image retained",
  prerequisite: mt_collins_bios_0acod014_hpm.prerequisite, authority: mt_collins_bios_0acod014_hpm.authority,
}

fn interop_met(b: FirmwareBaseline) -> Bool {
  all(mt_collins_interop_requirements, req => interop_requirement_met(b: b, req: req))
}

test fn bmc_0_45_3_beside_0acoc017_fails_basic_auth_interop() -> Bool  {
  let b = baseline_of(label: "BMC 0.45.3 beside BIOS 0ACOC017", releases: [mt_collins_bmc_0_45_3_hpm, bios_0acoc017_row, mt_collins_scp_2_10_hpm, mt_collins_mb_cpld_v06_hpm])
  !interop_met(b: b) && interop_met(b: baseline_ampere_ticket_7426_delivery)
}

// ── Positive route ────────────────────────────────────────────────────────────────────────────
test fn fresh_host_is_due_bmc_first() -> Bool  {
  is_due(verdict: run(w: shape(power_off: true), records: []), t: BmcController)
}

test fn host_at_baseline_is_converged() -> Bool  {
  let s = shape(power_off: true)
  match run(w: WorldShape { power_off: true, installed: installed_at_baseline, cpus: [], rollbacks: [], sel: Absent, endpoint: s.endpoint, managed_epoch: 1, foreign_attempt: false }, records: []) {
    FirmwareBaselineConverged { uncited_readbacks: u } => list_length(u) == 0
    _ => false
  }
}

test fn flashed_bmc_without_ac_cycle_waits_for_the_human_step() -> Bool  {
  let b = bmc_shape()
  match run(w: shape(power_off: true), records: [record(t: BmcController, r: RecordShape { pre: b.pre, completed_at: b.completed_at, digest: b.digest, credential: b.credential, ac: Absent, readback: b.readback })]) {
    FirmwareAwaitingHumanStep { after: t, step: s, receipt: _ } => (t == BmcController) && s.identity as String == "mtcollins1_ac_power_cycle_after_firmware_step"
    _ => false
  }
}

// The ROUTE, not only the answer: a grounded BMC record is walked past and BIOS becomes due.
test fn grounded_bmc_step_advances_to_bios() -> Bool  {
  is_due(verdict: run(w: shape(power_off: true), records: [bmc_good()]), t: HostBios)
}

test fn powered_on_host_refuses_before_any_step() -> Bool  {
  match refusal_of(verdict: run(w: shape(power_off: false), records: [])) {
    Present { value: c } => match c { HostNotPoweredOff => true  _ => false }
    Absent => false
  }
}

// ── Discriminating REDs on an executed step ───────────────────────────────────────────────────
fn bmc_variant(digest: Digest, ac: AcPowerCycleWitness?, readback: FirmwareSemanticVersion) -> FlashStepRecord {
  let b = bmc_shape()
  record(t: BmcController, r: RecordShape { pre: b.pre, completed_at: b.completed_at, digest: digest, credential: b.credential, ac: ac, readback: readback })
}

test fn wrong_digest_refuses() -> Bool  {
  match refusal_of(verdict: run(w: shape(power_off: true), records: [bmc_variant(digest: wrong_digest, ac: good_ac_cycle(t: BmcController), readback: v(major: 0, minor: 45, patch: 3))])) {
    Present { value: c } => match c { ImageDigestMismatch { target: _, expected: _, sent: _ } => true  _ => false }
    Absent => false
  }
}

test fn out_of_order_step_refuses() -> Bool  {
  match refusal_of(verdict: run(w: shape(power_off: true), records: [step_good(t: HostBios, r: mt_collins_bios_0acod014_hpm)])) {
    Present { value: c } =>
      match c {
        StepOutOfOrder { attempted: a, unconverged_predecessor: p } => (a == HostBios) && (p == BmcController)
        _ => false
      }
    Absent => false
  }
}

test fn readback_mismatch_refuses() -> Bool  {
  match refusal_of(verdict: run(w: shape(power_off: true), records: [bmc_variant(digest: digest_of(r: mt_collins_bmc_0_45_3_hpm), ac: good_ac_cycle(t: BmcController), readback: v(major: 0, minor: 32, patch: 0))])) {
    Present { value: c } => match c { ReadbackMismatch { target: _, reason: _ } => true  _ => false }
    Absent => false
  }
}

fn bmc_reporting(upgrade_failed: Bool, bmc_silent: Bool) -> FlashStepRecord {
  let g = bmc_good()
  FlashStepRecord {
    target: BmcController, pre_flash: g.pre_flash, flash_started_at: g.flash_started_at, flash_completed_at: g.flash_completed_at,
    sent_image_digest: g.sent_image_digest,
    upgrade: if upgrade_failed { HpmUpgradeFailed { stage: HpmActivateFirmware, diagnostic: "activation timed out" } } else { HpmUpgradeCompleted },
    bmc_after: if bmc_silent { BmcNotAnswering { reason: "no RMCP+ answer for 300 s" } } else { BmcAnswering },
    credential_after: Absent, ac_cycle: Absent, readback: Absent,
  }
}

test fn hpm_upgrade_failure_refuses() -> Bool  {
  match refusal_of(verdict: run(w: shape(power_off: true), records: [bmc_reporting(upgrade_failed: true, bmc_silent: false)])) {
    Present { value: c } => match c { HpmUpgradeRefused { target: _, stage: _, diagnostic: _ } => true  _ => false }
    Absent => false
  }
}

test fn bmc_silent_after_flash_refuses() -> Bool  {
  match refusal_of(verdict: run(w: shape(power_off: true), records: [bmc_reporting(upgrade_failed: false, bmc_silent: true)])) {
    Present { value: c } => match c { BmcNotAnsweringAfterFlash { target: _, reason: _ } => true  _ => false }
    Absent => false
  }
}

test fn short_ac_cycle_refuses() -> Bool  {
  match refusal_of(verdict: run(w: shape(power_off: true), records: [bmc_variant(digest: digest_of(r: mt_collins_bmc_0_45_3_hpm), ac: Present { value: AcPowerCycleWitness { ac_off: second(count: 3), completed_at: ac_done(t: BmcController), witnessed_by: "operator" } }, readback: v(major: 0, minor: 45, patch: 3))])) {
    Present { value: c } => match c { AcPowerCycleTooShort { target: _, observed: s, minimum: m } => second_count(s: s) == 3 && second_count(s: m) == 10  _ => false }
    Absent => false
  }
}

// ── Preconditions AS THEY STOOD AT EXECUTION (review on ff66edd) ──────────────────────────────────
fn bmc_with_pre(pre: PreFlashReceipt) -> FlashStepRecord {
  let b = bmc_shape()
  record(t: BmcController, r: RecordShape { pre: pre, completed_at: b.completed_at, digest: b.digest, credential: b.credential, ac: b.ac, readback: b.readback })
}

// RED: four otherwise valid records, the BMC one flashed with the host ON, must not converge.
test fn step_executed_with_the_host_on_refuses() -> Bool  {
  match refusal_of(verdict: run(w: shape(power_off: true), records: [bmc_with_pre(pre: pre_flash(t: BmcController, off: false, sel: bmc_sel())), step_good(t: HostBios, r: mt_collins_bios_0acod014_hpm), step_good(t: ScpFirmware, r: mt_collins_scp_2_10_hpm), step_good(t: MainboardCpld, r: mt_collins_mb_cpld_v06_hpm)])) {
    Present { value: c } => match c { HostNotPoweredOffWhenFlashed { target: t } => (t == BmcController)  _ => false }
    Absent => false
  }
}

// RED: a SEL snapshot read before this attempt opened does not protect this attempt's BMC flash.
test fn stale_sel_snapshot_on_an_executed_bmc_step_refuses() -> Bool  {
  match refusal_of(verdict: run(w: shape(power_off: true), records: [bmc_with_pre(pre: pre_flash(t: BmcController, off: true, sel: SelCaptured { capture: sel_read_capture(at: opened_at - 86400000) }))])) {
    Present { value: c } => match c { SelSnapshotStale { target: _, read_at: _, bound: b } => b == opened_at  _ => false }
    Absent => false
  }
}

test fn executed_bmc_step_without_a_sel_snapshot_refuses() -> Bool  {
  match refusal_of(verdict: run(w: shape(power_off: true), records: [bmc_with_pre(pre: pre_flash(t: BmcController, off: true, sel: SelNotRequired))])) {
    Present { value: c } => match c { SelSnapshotMissingFromExecutedStep { target: _ } => true  _ => false }
    Absent => false
  }
}

test fn step_started_before_its_predecessor_completed_refuses() -> Bool  {
  let early = record(t: HostBios, r: RecordShape {
    pre: PreFlashReceipt { host_power: HostPoweredOff, power_observed_at: opened_at + 1, sel: SelNotRequired },
    completed_at: flash_end(t: HostBios), digest: digest_of(r: mt_collins_bios_0acod014_hpm), credential: Absent, ac: good_ac_cycle(t: HostBios), readback: v(major: 0, minor: 14, patch: 0),
  })
  let bios_early = FlashStepRecord {
    target: HostBios, pre_flash: early.pre_flash, flash_started_at: flash_start(t: BmcController) + 1, flash_completed_at: early.flash_completed_at,
    sent_image_digest: early.sent_image_digest, upgrade: early.upgrade, bmc_after: early.bmc_after,
    credential_after: early.credential_after, ac_cycle: early.ac_cycle, readback: early.readback,
  }
  match refusal_of(verdict: run(w: shape(power_off: true), records: [bmc_good(), bios_early])) {
    Present { value: c } => match c { StepStartedBeforePredecessorCompleted { target: t, predecessor: p } => (t == HostBios) && (p == BmcController)  _ => false }
    Absent => false
  }
}

// ── The credential swap a BMC reflash implies, bound to this controller and this flash ───────────
// No re-establishment recorded: the window is open and the re-provision is due, naming the epoch in force.
test fn bmc_flash_opens_the_factory_credential_window() -> Bool  {
  match run(w: shape(power_off: true), records: [bmc_with_credential(c: Absent)]) {
    FirmwareCredentialReprovisionDue { after: t, invalidated: m, factory_use: u } =>
      (t == BmcController) && m.credential_epoch == 1
        && match u { PatternSelected { pattern: _, receipt: _ } => true  _ => false }
    _ => false
  }
}

test fn step_inside_the_factory_credential_window_refuses() -> Bool  {
  match refusal_of(verdict: run(w: shape(power_off: true), records: [bmc_with_credential(c: Absent), step_good(t: HostBios, r: mt_collins_bios_0acod014_hpm)])) {
    Present { value: c } => match c { StepDuringFactoryCredentialWindow { attempted: a, window_opened_by: _ } => (a == HostBios)  _ => false }
    Absent => false
  }
}

// A copy of `r` whose flash ran from `started` to `started + 100000`, with its AC cycle and readback after.
fn restarted(r: FlashStepRecord, started: EpochMs) -> FlashStepRecord {
  FlashStepRecord {
    target: r.target,
    pre_flash: PreFlashReceipt { host_power: r.pre_flash.host_power, power_observed_at: started - 10000, sel: r.pre_flash.sel },
    flash_started_at: started, flash_completed_at: started + 100000,
    sent_image_digest: r.sent_image_digest, upgrade: r.upgrade, bmc_after: r.bmc_after, credential_after: r.credential_after,
    ac_cycle: ac_cycle_at(at: started + 120000), readback: readback_at(t: r.target, version: mt_collins_bios_0acod014_hpm.version, at: started + 140000),
  }
}

// RED (review on 76e6f8c): the window cannot be backfilled. BIOS starts after the BMC flash completed
// but BEFORE the re-establishment probes, and the re-establishment succeeds later. The BMC record is
// fully grounded, and the BIOS flash still ran while only the factory credential worked.
test fn step_before_a_later_successful_restoration_refuses_as_the_window() -> Bool  {
  let bios = restarted(r: step_good(t: HostBios, r: mt_collins_bios_0acod014_hpm), started: flash_end(t: BmcController) + 50000)
  match refusal_of(verdict: run(w: shape(power_off: true), records: [bmc_good(), bios])) {
    Present { value: c } => match c { StepDuringFactoryCredentialWindow { attempted: a, window_opened_by: o } => (a == HostBios) && (o == BmcController)  _ => false }
    Absent => false
  }
}

// RED: after the credential is back but before the BMC step's AC cycle and readback, the step is still open.
test fn step_before_the_predecessor_ac_cycle_and_readback_refuses() -> Bool  {
  let bios = restarted(r: step_good(t: HostBios, r: mt_collins_bios_0acod014_hpm), started: ac_done(t: BmcController) - 5000000)
  match refusal_of(verdict: run(w: shape(power_off: true), records: [bmc_good(), bios])) {
    Present { value: c } => match c { StepStartedBeforePredecessorClosed { target: t, predecessor: p, predecessor_closed_at: at } => (t == HostBios) && (p == BmcController) && at == read_back_at(t: BmcController)  _ => false }
    Absent => false
  }
}

// CONTROL for the two REDs above: the same rebuilt BIOS record, started after the BMC step closed, grounds.
test fn step_after_the_predecessor_closed_advances() -> Bool  {
  let bios = restarted(r: step_good(t: HostBios, r: mt_collins_bios_0acod014_hpm), started: read_back_at(t: BmcController) + 50000)
  is_due(verdict: run(w: shape(power_off: true), records: [bmc_good(), bios]), t: ScpFirmware)
}

// RED: an AC cycle witnessed before the flash completed is not the cycle after it.
test fn ac_cycle_witnessed_before_the_flash_completed_refuses() -> Bool  {
  match refusal_of(verdict: run(w: shape(power_off: true), records: [bmc_variant(digest: digest_of(r: mt_collins_bmc_0_45_3_hpm), ac: ac_cycle_at(at: flash_end(t: BmcController) - 1), readback: v(major: 0, minor: 45, patch: 3))])) {
    Present { value: c } => match c { AcCycleWitnessPrecedesFlash { target: t, flash_completed_at: _, completed_at: _ } => (t == BmcController)  _ => false }
    Absent => false
  }
}

// RED: a readback taken before the AC cycle read the image the cycle had not yet activated.
test fn readback_before_the_ac_cycle_refuses() -> Bool  {
  match refusal_of(verdict: run(w: shape(power_off: true), records: [bmc_variant(digest: digest_of(r: mt_collins_bmc_0_45_3_hpm), ac: ac_cycle_at(at: read_back_at(t: BmcController) + 1), readback: v(major: 0, minor: 45, patch: 3))])) {
    Present { value: c } => match c { ReadbackPrecedesAcCycle { target: t, ac_completed_at: _, observed_at: at } => (t == BmcController) && at == read_back_at(t: BmcController)  _ => false }
    Absent => false
  }
}

test fn reprovision_with_managed_credential_rejected_refuses() -> Bool  {
  match refusal_of(verdict: run(w: shape(power_off: true), records: [bmc_with_credential(c: with_rights(ipmi: reestablished(epoch: 2, previous: 1, managed_accepted: false), rights: good_rights()))])) {
    Present { value: c } => match c { CredentialNotReestablished { target: _, cause: _ } => true  _ => false }
    Absent => false
  }
}

// INHABITANCE: the real mtcollins1 standing from the 2026-09-13 intake, at epoch 1 -- the epoch in force.
test fn pre_flash_standing_does_not_reestablish() -> Bool  {
  match refusal_of(verdict: run(w: shape(power_off: true), records: [bmc_with_credential(c: with_rights(ipmi: mtcollins1_bmc_secure_standing(), rights: good_rights()))])) {
    Present { value: c } => match c { CredentialEpochNotAdvancedPastFlash { target: _, invalidated_epoch: i, observed_epoch: o } => i == 1 && o == 1  _ => false }
    Absent => false
  }
}

fn shape_with(endpoint: BmcControllerEndpoint, epoch: Int, foreign_attempt: Bool) -> WorldShape {
  let s = shape(power_off: true)
  WorldShape { power_off: true, installed: s.installed, cpus: s.cpus, rollbacks: s.rollbacks, sel: s.sel, endpoint: endpoint, managed_epoch: epoch, foreign_attempt: foreign_attempt }
}

// RED: a standing derived for another intake attempt does not close this attempt's window.
test fn standing_for_another_subject_refuses() -> Bool  {
  match refusal_of(verdict: run(w: shape_with(endpoint: mtcollins1_endpoint, epoch: 1, foreign_attempt: true), records: [bmc_good()])) {
    Present { value: c } => match c { CredentialForAnotherSubject { target: _ } => true  _ => false }
    Absent => false
  }
}

data other_controller: BmcControllerEndpoint = BmcControllerEndpoint { host: "192.168.1.229" }

// RED: a standing secured at another controller's endpoint does not close this one's window.
test fn standing_for_another_endpoint_refuses() -> Bool  {
  match refusal_of(verdict: run(w: shape_with(endpoint: other_controller, epoch: 1, foreign_attempt: false), records: [bmc_good()])) {
    Present { value: c } => match c { CredentialForAnotherEndpoint { target: _, expected: _, found: _ } => true  _ => false }
    Absent => false
  }
}

// RED: after a first flash minted epoch 2, a SECOND flash invalidates epoch 2, and the epoch-2 standing
// replayed from before it does not re-establish; the epoch-3 standing does.
test fn epoch_replay_after_a_second_flash_refuses() -> Bool  {
  match refusal_of(verdict: run(w: shape_with(endpoint: mtcollins1_endpoint, epoch: 2, foreign_attempt: false), records: [bmc_good()])) {
    Present { value: c } => match c { CredentialEpochNotAdvancedPastFlash { target: _, invalidated_epoch: i, observed_epoch: o } => i == 2 && o == 2  _ => false }
    Absent => false
  }
}

test fn next_epoch_after_a_second_flash_reestablishes() -> Bool  {
  is_due(verdict: run(w: shape_with(endpoint: mtcollins1_endpoint, epoch: 2, foreign_attempt: false), records: [bmc_with_credential(c: with_rights(ipmi: reestablished(epoch: 3, previous: 2, managed_accepted: true), rights: good_rights()))]), t: HostBios)
}

// RED: a standing whose probes all precede the flash is evidence about the credential BEFORE the reset.
test fn standing_probed_before_the_flash_refuses() -> Bool  {
  let b = bmc_shape()
  let late = 1789300000000
  match refusal_of(verdict: run(w: shape(power_off: true), records: [FlashStepRecord {
    target: BmcController, pre_flash: b.pre, flash_started_at: flash_start(t: BmcController), flash_completed_at: late,
    sent_image_digest: b.digest, upgrade: HpmUpgradeCompleted, bmc_after: BmcAnswering, credential_after: b.credential,
    ac_cycle: b.ac, readback: readback_for(t: BmcController, version: b.readback),
  }])) {
    Present { value: c } => match c { CredentialProbePrecedesFlash { target: _, flash_completed_at: f, probed_at: _ } => f == late  _ => false }
    Absent => false
  }
}

fn run_with_rights(rights: ManagedRightsReceipt) -> FirmwareConvergenceVerdict {
  run(w: shape(power_off: true), records: [bmc_with_credential(c: with_rights(ipmi: reestablished(epoch: 2, previous: 1, managed_accepted: true), rights: rights))])
}

