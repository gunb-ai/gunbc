    Absent => false
  }
}

// RED, the 2026-10-03 reset: administrator left on LAN channel 1 only -- channel 7 not granted refuses.
test fn admin_missing_on_lan_channel_7_refuses() -> Bool  {
  match refusal_of(verdict: run_with_rights(rights: rights_receipt(endpoint: mtcollins1_endpoint, account: mtcollins1_managed_credential.account, at: mtcollins1_managed_probe_at, withheld: Present { value: IpmiAdministratorOnLanChannel { channel: 7 } }, drop: Absent))) {
    Present { value: c } => match c { ManagedRightNotRestored { target: _, right: r, detail: _ } => (r == IpmiAdministratorOnLanChannel { channel: 7 })  _ => false }
    Absent => false
  }
}

// RED: a receipt that never read KVM is missing evidence, not a grant.
test fn kvm_right_absent_from_the_receipt_refuses() -> Bool  {
  match refusal_of(verdict: run_with_rights(rights: rights_receipt(endpoint: mtcollins1_endpoint, account: mtcollins1_managed_credential.account, at: mtcollins1_managed_probe_at, withheld: Absent, drop: Present { value: KvmRight }))) {
    Present { value: c } => match c { ManagedRightMissingFromReceipt { target: _, right: r } => (r == KvmRight)  _ => false }
    Absent => false
  }
}

// RED: a receipt for ANOTHER account (factory admin) says nothing about the managed one.
test fn rights_receipt_for_another_account_refuses() -> Bool  {
  match refusal_of(verdict: run_with_rights(rights: rights_receipt(endpoint: mtcollins1_endpoint, account: "admin", at: mtcollins1_managed_probe_at, withheld: Absent, drop: Absent))) {
    Present { value: c } => match c { RightsReceiptForAnotherEndpointOrAccount { target: _ } => true  _ => false }
    Absent => false
  }
}

// RED: a receipt read before this flash completed is historical.
test fn rights_receipt_before_the_flash_refuses() -> Bool  {
  match refusal_of(verdict: run_with_rights(rights: rights_receipt(endpoint: mtcollins1_endpoint, account: mtcollins1_managed_credential.account, at: flash_end(t: BmcController) - 1, withheld: Absent, drop: Absent))) {
    Present { value: c } => match c { RightsReceiptPrecedesFlash { target: _, flash_completed_at: _, observed_at: _ } => true  _ => false }
    Absent => false
  }
}

// RED, the 2026-10-03 reset: remote media wiped (remote_media_support 0) refuses until images enumerate.
test fn remote_media_not_restored_refuses() -> Bool  {
  match refusal_of(verdict: run(w: shape(power_off: true), records: [bmc_with_credential(c: with_all(ipmi: reestablished(epoch: 2, previous: 1, managed_accepted: true), rights: good_rights(), m: media(readback: RemoteMediaNotConfigured { detail: "remote_media_support 0" })))])) {
    Present { value: c } => match c { RemoteMediaNotRestored { target: _, detail: _ } => true  _ => false }
    Absent => false
  }
}

// RED: configured but enumerating nothing is not restored.
test fn remote_media_with_no_images_refuses() -> Bool  {
  match refusal_of(verdict: run(w: shape(power_off: true), records: [bmc_with_credential(c: with_all(ipmi: reestablished(epoch: 2, previous: 1, managed_accepted: true), rights: good_rights(), m: media(readback: RemoteMediaImagesEnumerated { image_count: 0, cd_error_code: 0 })))])) {
    Present { value: c } => match c { RemoteMediaNotRestored { target: _, detail: _ } => true  _ => false }
    Absent => false
  }
}

// ── The dry realization ───────────────────────────────────────────────────────────────────────
fn render(cmds: List<List<String>>) -> List<String> {
  map(cmds, c => join(c, " "))
}

fn dry(w: WorldShape, records: List<FlashStepRecord>, image: NonEmptyStr) -> List<String> {
  match mtcollins1_intake_subject() {
    Absent => []
    Present { value: s } =>
      render(cmds: dry_realize(
        baseline: baseline_ampere_ticket_7426_delivery, world: world_of(subject: s, w: w), records: records,
        image_path: image, bmc_host: "mtcollins1-bmc", username: "admin", password_file: "/run/bmc.pw",
      ))
  }
}

test fn dry_bmc_step_renders_the_vendor_block_size() -> Bool  {
  let lines = dry(w: shape(power_off: true), records: [], image: "/srv/fw/MtCollinsBmc0_45_3.hpm")
  any(lines, l => l == "ipmitool -I lanplus -H mtcollins1-bmc -U admin -f /run/bmc.pw -z 30000 hpm upgrade /srv/fw/MtCollinsBmc0_45_3.hpm force")
    && !any(lines, l => contains(l, "raw 0x3c"))
}

// The SCP step is reached on the real route, by grounding BMC and BIOS first. It sends no bank select:
// BMC 0.45.3 refuses the SOP's `raw 0x3c 0x0b` with 0xc9, so rendering it would script a known refusal.
test fn dry_scp_step_renders_no_bank_select() -> Bool  {
  let lines = dry(w: shape(power_off: true), records: [bmc_good(), step_good(t: HostBios, r: mt_collins_bios_0acod014_hpm)], image: "/srv/fw/altra_scp_signed_2.10.20230126.hpm")
  list_length(lines) == 2
    && any(lines, l => l == "ipmitool -I lanplus -H mtcollins1-bmc -U admin -f /run/bmc.pw -z 8196 hpm upgrade /srv/fw/altra_scp_signed_2.10.20230126.hpm force")
    && !any(lines, l => contains(l, "hpm check"))
    && !any(lines, l => contains(l, "raw 0x3c"))
}

// The MB CPLD step renders its observed (downstream) 30000-byte block.
test fn dry_cpld_step_renders_the_observed_block_size() -> Bool  {
  let lines = dry(w: shape(power_off: true), records: [bmc_good(), step_good(t: HostBios, r: mt_collins_bios_0acod014_hpm), step_good(t: ScpFirmware, r: mt_collins_scp_2_10_hpm)], image: "/srv/fw/cpld.hpm")
  any(lines, l => l == "ipmitool -I lanplus -H mtcollins1-bmc -U admin -f /run/bmc.pw -z 30000 hpm upgrade /srv/fw/cpld.hpm force")
}

test fn dry_realization_renders_nothing_when_refused() -> Bool  {
  list_length(dry(w: shape(power_off: false), records: [], image: "/srv/fw/x.hpm")) == 0
}

// ── The boot readback after the whole set ─────────────────────────────────────────────────────
test fn whole_set_grounded_asks_for_the_boot_readback() -> Bool  {
  match run(w: shape(power_off: true), records: whole_set()) {
    FirmwareBootReadbackDue => true
    _ => false
  }
}

// ── THE POST-SET READBACK IS DERIVED FROM A POWER-ON ACCOUNT, never authored (ruling R1) ─────────
// The accounts below run the real console readers over console text: the 2026-10-03 loop from its
// committed capture excerpt, and the UEFI cases from the lines the firmware summary and the AMI setup
// prompt print (gunbc.machine_intake_mtcollins1_console_milestone_observation).
// branch mtcollins1-captures-2026-10-03, mtcollins1/step1-j1j17-20261003T042447Z/sol.raw
// (sha256 6f33812ce2af74aacf9deba90931aa9144b1ba974532ae9e890b90a57c5900c1), lines 138-205;
// excerpt sha256 edbcaabead8194544201251f9a8a5eb26ba3dfbb8da1caec9627487f260d153d.
data step1_last_two_cycles: String = "NOTICE:  DRAM FW version 220414\r\nCP: 0ff00900\r\nMEMC param:\r\n  mcu_enable_mask = 00000001 [default: 000000ff]\r\nMCU param:\r\n  ecc_en = 00000002 [default: 00000001]\r\nDRAM populated DIMMs:\r\n  SK0 MC0 S0: RDIMM[ad:80] 16GB 2666 ECC 1R x4 RCD[32:86] HMA82GR7AFR4N-VK    \r\nCP: 3ff00100\r\nCP: 3ff00200\r\nCP: 00f01902\r\nCP: 0ff00a00\r\nCP: 0ff00b01\r\nCP: 00f01901\r\nCP: 00f01904\r\nCP: 00f02901\r\nCP: 00f01905\r\nCP: 00f02902\r\nCP: 00f02903\r\nCP: 00f02904\r\nCP: 00f01907\r\nCP: 00f01906\r\nCP: 00f01908\r\nCP: 00f01909\r\nCP: 0ff00b02\r\nCP: 0ff00c00\r\nCP: 3ff00300\r\nCP: 00001a02\r\nCP: 00001a03\r\nCP: 00001a04\r\nCP: 00001a05\r\nCP: 00f01a07\r\nCP: 00001a09\r\nCP: 00001a0a\r\nNOTICE:  DRAM FW version 220414\r\nCP: 0ff00900\r\nMEMC param:\r\n  mcu_enable_mask = 00000001 [default: 000000ff]\r\nMCU param:\r\n  ecc_en = 00000002 [default: 00000001]\r\nDRAM populated DIMMs:\r\n  SK0 MC0 S0: RDIMM[ad:80] 16GB 2666 ECC 1R x4 RCD[32:86] HMA82GR7AFR4N-VK    \r\nCP: 3ff00100\r\nCP: 3ff00200\r\nCP: 00f01902\r\nCP: 0ff00a00\r\nCP: 0ff00b01\r\nCP: 00f01901\r\nCP: 00f01904\r\nCP: 00f02901\r\nCP: 00f01905\r\nCP: 00f02902\r\nCP: 00f02903\r\nCP: 00f02904\r\nCP: 00f01907\r\nCP: 00f01906\r\nCP: 00f01908\r\nCP: 00f01909\r\nCP: 0ff00b02\r\nCP: 0ff00c00\r\nCP: 3ff00300\r\nCP: 00001a02\r\nCP: 00001a03\r\nCP: 00001a04\r\nCP: 00001a05\r\nCP: 00f01a07\r\nCP: 00001a09\r\nCP: 00001a0a\r\n"

// Real "System Restart" rows of the step-1 loop (sel-after.txt), as the SEL reader types them.
// After a confirmed power-on with no power-up record, the first such row is ambiguous (it may be the
// power-on's own boot) and opens no cycle; each later one is a distinct reset (rows 33, 37, 3b).
data loop_restarts: List<SelWindowEvent> = [
  SelWindowEvent { record_id: 51, bmc_clock_rendering: "10/02/2026 07:32:01 PM UTC", kind: BootRestart { offset: SystemRestart } },
  SelWindowEvent { record_id: 55, bmc_clock_rendering: "10/02/2026 07:32:27 PM UTC", kind: BootRestart { offset: SystemRestart } },
  SelWindowEvent { record_id: 59, bmc_clock_rendering: "10/02/2026 07:32:52 PM UTC", kind: BootRestart { offset: SystemRestart } },
]

fn account_over(lines: List<String>, restarts: List<SelWindowEvent>) -> PowerOnAccount {
  let digest = Sha256FileDigest { digest: sha256_digest(hex: "6f33812ce2af74aacf9deba90931aa9144b1ba974532ae9e890b90a57c5900c1") }
  mtcollins1_power_on_account(e: PowerOnEvidence {
    configuration: AttemptConfigurationReceipt {
      subject: "mtcollins1", attempt: "witness", expected: ExpectedSockets { sockets: [0, 1], source: "witness" },
      requested: StimulusRequestNotRecorded { reason: "witness" }, applied: StimulusApplicationNotRecorded { reason: "witness" },
      cpus: PopulationNotRecorded { reason: "witness" }, dimms: PopulationNotRecorded { reason: "witness" }, firmware: FirmwareReadbacksNotRecorded { reason: "witness" },
    },
    handoff: HandoffPoweredOn, smpro: [],
    console: ConsoleRead {
      capture: digest, firmware: firmware_console_report(lines: lines), firmware_error_lines: 0,
      dram: ampere_dram_console_observation(lines: lines), checkpoints: ampere_checkpoint_console_observation(lines: lines), relations: [],
      milestones: mtcollins1_console_milestones(lines: lines), sockets: ampere_socket_console_observation(lines: lines),
      loader: grub_console_report(lines: lines), linux: linux_boot_console_observation(lines: lines), modules: kernel_module_decompression_observation(lines: lines), span_readings: span_console_readings(lines: lines),
    },
    sel: SelEventsRead { events: restarts }, watchdog: WatchdogUnobserved { reason: "witness" }, bmc_anomalies: [], census_ended: false, coverage: [],
  })
}

data uefi_cycle: List<String> = ["NOTICE:  DRAM FW version 220414", "CP: 0ff00900", "UEFI RC version: 2.10", "    Number of active sockets    : 1", "Press <DEL> or <ESC> to Entering the Setup."]

data dram_only_cycle: List<String> = ["NOTICE:  DRAM FW version 220414", "CP: 0ff00900", "CP: 00001a0a"]

fn readback_over(lines: List<String>, restarts: List<SelWindowEvent>) -> FirmwareSetBootReadback? {
  Present { value: firmware_set_boot_readback(a: account_over(lines: lines, restarts: restarts)) }
}

// The set converges on UEFI, and the converged verdict NAMES every readback grounded through an
// uncited decode -- the SMpro word for the SCP and the self-observed hpm check projections for the
// BMC, BIOS and CPLD -- so none is promoted to an unqualified observation.
test fn whole_set_reaching_uefi_converges_naming_every_uncited_decode() -> Bool  {
  match run_booted(w: shape(power_off: true), records: whole_set(), boot: readback_over(lines: uefi_cycle, restarts: [])) {
    FirmwareBaselineConverged { uncited_readbacks: u } =>
      list_length(u) == 4 && any(u, x => (x.target == ScpFirmware)) && any(u, x => (x.target == BmcController))
    _ => false
  }
}

// RED, the 2026-10-03 loop, derived from its capture: the set did not reach UEFI and the host restarted
// repeatedly, so convergence refuses with the account's own ending.
test fn the_2026_10_03_loop_after_the_set_refuses_with_the_derived_ending() -> Bool  {
  match refusal_of(verdict: run_booted(w: shape(power_off: true), records: whole_set(), boot: readback_over(lines: host_capture_lines(capture: HostCaptureLiveStream { text: step1_last_two_cycles }), restarts: loop_restarts.take(n: 2)))) {
    Present { value: c } => match c { BootProgressLostAfterFirmwareSet { ending: e, last_relation: _ } => (match e { RestartedRepeatedly { cycles: n, last_cycle_ended_after: _, cadence: _, console_errors: k, sel_restarts: _, watchdog: _, reset_cause: _ } => n == 2 && k == 0 _ => false }) _ => false }
    Absent => false
  }
}

// RED: reaching UEFI is a milestone, not an ending. UEFI in cycle 1 and then a loop that never got as far
// again is not a converged boot.
test fn uefi_then_a_restart_loop_refuses() -> Bool  {
  match refusal_of(verdict: run_booted(w: shape(power_off: true), records: whole_set(), boot: readback_over(lines: concat(uefi_cycle, concat(dram_only_cycle, dram_only_cycle)), restarts: loop_restarts))) {
    Present { value: c } => match c { BootReachedUefiThenRestartedRepeatedly { cycle: k, ending: _ } => k == 1 _ => false }
    Absent => false
  }
}

// The set is atomic: three of four grounded is a step due, never a boot readback.
test fn three_of_four_steps_is_not_a_boot_readback() -> Bool  {
  is_due(verdict: run(w: shape(power_off: true), records: [bmc_good(), step_good(t: HostBios, r: mt_collins_bios_0acod014_hpm), step_good(t: ScpFirmware, r: mt_collins_scp_2_10_hpm)]), t: MainboardCpld)
}

// ── Facts 3 and 7: the SEL snapshot and the WHOLE-SET pre-flight ──────────────────────────────────
fn shape_sel(sel: SelCapture?) -> WorldShape {
  let s = shape(power_off: true)
  WorldShape { power_off: true, installed: s.installed, cpus: s.cpus, rollbacks: s.rollbacks, sel: sel, endpoint: s.endpoint, managed_epoch: 1, foreign_attempt: false }
}

test fn bmc_step_without_sel_snapshot_asks_for_it() -> Bool  {
  match run(w: shape_sel(sel: Absent), records: []) {
    FirmwareSelSnapshotDue { before: t } => (t == BmcController)
    _ => false
  }
}

test fn bmc_step_with_untaken_sel_snapshot_refuses() -> Bool  {
  match refusal_of(verdict: run(w: shape_sel(sel: Present { value: SelCapture { snapshot: SelSnapshotNotTaken { reason: "skipped" }, read_at: sel_read_at } }), records: [])) {
    Present { value: c } => match c { SelSnapshotNotTakenBeforeStep { target: _, reason: _ } => true  _ => false }
    Absent => false
  }
}

// RED: a SEL read before the attempt opened does not admit this attempt's BMC step.
test fn pending_bmc_step_with_a_stale_sel_snapshot_refuses() -> Bool  {
  match refusal_of(verdict: run(w: shape_sel(sel: Present { value: sel_read_capture(at: opened_at - 1) }), records: [])) {
    Present { value: c } => match c { SelSnapshotStale { target: _, read_at: _, bound: _ } => true  _ => false }
    Absent => false
  }
}

// The SEL gate is the BMC's alone: BIOS is due with no world snapshot once BMC has grounded.
test fn bios_step_needs_no_sel_snapshot() -> Bool  {
  is_due(verdict: run(w: shape_sel(sel: Absent), records: [bmc_good()]), t: HostBios)
}

fn shape_pre(cpus: List<MtCollins1SocketCpu>, rollbacks: List<RollbackImageReading>, installed: List<InstalledVersionReading>) -> WorldShape {
  let s = shape(power_off: true)
  WorldShape { power_off: true, installed: installed, cpus: cpus, rollbacks: rollbacks, sel: s.sel, endpoint: s.endpoint, managed_epoch: 1, foreign_attempt: false }
}

// RED + INHABITANCE: mtcollins1's real socket table (socket 0 an engineering sample) refuses before any step.
test fn engineering_sample_cpu_refuses_preflight() -> Bool  {
  match refusal_of(verdict: run(w: shape_pre(cpus: mtcollins1_socket_cpus, rollbacks: all_rollbacks_kept(), installed: installed_before), records: [])) {
    Present { value: c } => match c { CpuSiliconSupportUnstated { socket: s, bios_family: _ } => s == 0  _ => false }
    Absent => false
  }
}

// RED: an empty CPU inventory is missing evidence, never a pass.
test fn empty_cpu_inventory_refuses_preflight() -> Bool  {
  match refusal_of(verdict: run(w: shape_pre(cpus: [], rollbacks: all_rollbacks_kept(), installed: installed_before), records: [])) {
    Present { value: c } => match c { CpuInventoryIncomplete { observed: o, expected: e } => o == 0 && e == 2  _ => false }
    Absent => false
  }
}

// RED (review on 76e6f8c): the pre-flight does not drop out once records exist. Four grounded records
// over an empty CPU inventory, or over no retained image, refuse exactly as the fresh host does.
test fn whole_set_recorded_over_an_empty_cpu_inventory_refuses() -> Bool  {
  match refusal_of(verdict: run(w: shape_pre(cpus: [], rollbacks: all_rollbacks_kept(), installed: installed_before), records: whole_set())) {
    Present { value: c } => match c { CpuInventoryIncomplete { observed: o, expected: e } => o == 0 && e == 2  _ => false }
    Absent => false
  }
}

test fn whole_set_recorded_with_no_rollback_images_refuses() -> Bool  {
  match refusal_of(verdict: run(w: shape_pre(cpus: production_cpus(), rollbacks: [], installed: installed_before), records: whole_set())) {
    Present { value: c } => match c { NoRollbackImageRetained { target: t, reason: _ } => (t == BmcController)  _ => false }
    Absent => false
  }
}

