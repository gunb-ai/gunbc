  match refusal_of(verdict: run(w: shape_pre(cpus: [socket_0_cpu(), socket_0_cpu()], rollbacks: all_rollbacks_kept(), installed: installed_before), records: [])) {
    Present { value: c } => match c { CpuSocketReadTwice { socket: s } => s == 0  _ => false }
    Absent => false
  }
}

test fn cpu_row_for_a_socket_the_board_lacks_refuses() -> Bool  {
  match refusal_of(verdict: run(w: shape_pre(cpus: [socket_0_cpu(), socket_2_cpu()], rollbacks: all_rollbacks_kept(), installed: installed_before), records: [])) {
    Present { value: c } => match c { CpuSocketOutOfRange { socket: s, socket_count: n } => s == 2 && n == 2  _ => false }
    Absent => false
  }
}

test fn cpu_inventory_missing_socket_1_refuses() -> Bool  {
  match refusal_of(verdict: run(w: shape_pre(cpus: [socket_0_cpu()], rollbacks: all_rollbacks_kept(), installed: installed_before), records: [])) {
    Present { value: c } => match c { CpuInventoryIncomplete { observed: o, expected: e } => o == 1 && e == 2  _ => false }
    Absent => false
  }
}

// RED (fact 7, whole set): no 0ACOC017 image was kept, so the BMC step -- the FIRST one -- is not due.
test fn no_bios_rollback_means_the_bmc_step_is_not_due() -> Bool  {
  let rollbacks = [
    kept(t: BmcController, version: v(major: 0, minor: 32, patch: 0)),
    RollbackImageUnavailable { target: HostBios, reason: "no 0ACOC017 image was retained" },
    kept(t: ScpFirmware, version: v(major: 1, minor: 8, patch: 0)),
    kept(t: MainboardCpld, version: v(major: 4, minor: 0, patch: 0)),
  ]
  match refusal_of(verdict: run(w: shape_pre(cpus: production_cpus(), rollbacks: rollbacks, installed: installed_before), records: [])) {
    Present { value: c } => match c { NoRollbackImageRetained { target: t, reason: _ } => (t == HostBios)  _ => false }
    Absent => false
  }
}

test fn rollback_image_of_another_version_refuses() -> Bool  {
  let rollbacks = [
    kept(t: BmcController, version: v(major: 0, minor: 30, patch: 0)),
    kept(t: HostBios, version: v(major: 0, minor: 17, patch: 0)),
    kept(t: ScpFirmware, version: v(major: 1, minor: 8, patch: 0)),
    kept(t: MainboardCpld, version: v(major: 4, minor: 0, patch: 0)),
  ]
  match refusal_of(verdict: run(w: shape_pre(cpus: production_cpus(), rollbacks: rollbacks, installed: installed_before), records: [])) {
    Present { value: c } => match c { RollbackImageNotTheInstalledVersion { target: t } => (t == BmcController)  _ => false }
    Absent => false
  }
}

// RED: two installed readings for one target refuse rather than taking the first.
test fn duplicated_installed_reading_refuses() -> Bool  {
  let installed = concat(installed_before, [reading(t: HostBios, version: v(major: 0, minor: 14, patch: 0))])
  match refusal_of(verdict: run(w: shape_pre(cpus: production_cpus(), rollbacks: all_rollbacks_kept(), installed: installed), records: [])) {
    Present { value: c } => match c { DuplicateInstalledReading { target: t } => (t == HostBios)  _ => false }
    Absent => false
  }
}

// ── Fact 1: the SCP read from SMpro, carried with its uncited decode standing ───────────────────
fn observed_is(rb: VersionReadback, major: Int, minor: Int) -> Bool {
  match rb.reading {
    EnsureObserved { evidence: x } => x.major == major && x.minor == minor
    _ => false
  }
}

fn decode_uncited(rb: VersionReadback) -> Bool {
  match rb.decode {
    TranscribedUncited { read_obligation: _ } => true
    CitedToAuthority { authority: _ } => false
  }
}

test fn scp_readback_decodes_the_smpro_words_as_an_uncited_bet() -> Bool  {
  let before = scp_readback_of(o: SmproWordRead { raw: smpro_raw(), word: 2049 }, observed_at: opened_at)
  let after = scp_readback_of(o: SmproWordRead { raw: smpro_raw(), word: 2562 }, observed_at: read_back_at(t: ScpFirmware))
  observed_is(rb: before, major: 1, minor: 8) && observed_is(rb: after, major: 2, minor: 10) && decode_uncited(rb: after)
}

test fn scp_readback_unsent_is_not_a_version() -> Bool  {
  match scp_readback_of(o: SmproNotSent { socket: 0, register: "SCP_VERSION", reason: "control read failed" }, observed_at: read_back_at(t: ScpFirmware)).reading {
    EnsureObserved { evidence: _ } => false
    _ => true
  }
}
