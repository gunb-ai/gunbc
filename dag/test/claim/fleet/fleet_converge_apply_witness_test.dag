module test.claim.fleet_converge_apply_witness

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn fixture_srv3_host_converge() -> HostConverge {
  HostConverge {
    identity: operator_host_srv3,
    knobs: [
      ConvergeKnob {
        slice: GunbcSlice,
        name: "pinned_tree_sha",
        desired: gunbc_pinned_tree_desired_label,
        target: GunbcPinnedTree {
          gunbc_root_env_key: gunbc_root_env_key,
          gunbc_root_path: gunbc_host_gunbc_root_path,
          dag_root: DeferToSubmodule { submodule_path: gunbc_dag_root_submodule_path },
          ctrl_checkout_path: gunbc_host_ctrl_checkout_path,
          binary: gunbc_pinned_binary_provenance_policy(),
          pin_read_script: gunbc_ctrl_read_pin_script,
          green_place_marker: gunbc_green_place_marker_spec(),
          live_apply: gunbc_dashboard_live_apply_policy(),
        },
        apply_mode: FreshStandup,
        no_op: BlindApply,
      }
    ],
    membership: NoMembershipProbe,
  }
}

test fn witness_unsound_policy_refused() -> Bool {
  match world_converge(
    subject: HostConvergenceSubject { identity: operator_host_srv3 },
    context: HostConvergenceContext {
      policy: ConvergePolicyUnsound { reason: "fixture" },
      transport: LocalShell,
    },
    handler: host_world_convergence_handler,
  ) {
    WorldNotConverged { subject: _, refusal: HostConvergencePolicyUnsound { reason: why } } => why == "fixture"
    _ => false
  }
}

test fn witness_converge_apply_fail_closed_on_knob_frontier() -> Bool {
  match world_converge(
    subject: HostConvergenceSubject { identity: operator_host_srv3 },
    context: HostConvergenceContext {
      policy: ConvergePolicyDerived { hosts: [fixture_srv3_host_converge()] },
      transport: LocalShell,
    },
    handler: host_world_convergence_handler,
  ) {
    WorldNotConverged { subject: _, refusal: HostConvergenceApplyRefused { reason: _ } } => true
    _ => false
  }
}

test fn witness_thin_invocation_argv() -> Bool {
  let inv = fleet_converge_thin_invocation(host: operator_host_srv3)
  inv.argv.length() == 4
}

test fn witness_emit_artifact_carriers_name_bash_emit_scaffolds() -> Bool {
  match bootstrap_fragment_script_carrier_scaffold {
    Terminal { reason: _ } => true
    Scaffold { dissolves_to: _, bind: _ } => false
  }
    && match thin_invocation_argv_carrier_scaffold {
      Scaffold {
        dissolves_to: RealizationDispatch,
        bind: DeclarationRef { module_path: m, decl_name: d, field: WholeDeclaration },
      } =>
        m == "gunbc.fleet_converge_apply" && d == "fleet_converge_thin_invocation"
      _ => false
    }
}

test fn witness_unknown_subject_identity_refuses_before_realization() -> Bool {
  match world_converge(
    subject: HostConvergenceSubject { identity: "not-enrolled" as HostIdentity },
    context: HostConvergenceContext {
      policy: ConvergePolicyDerived { hosts: [fixture_srv3_host_converge()] },
      transport: LocalShell,
    },
    handler: host_world_convergence_handler,
  ) {
    WorldNotConverged { subject: _, refusal: HostConvergenceUnknownIdentity { identity: identity } } =>
      identity as String == "not-enrolled"
    _ => false
  }
}

// THE TRANSPORT CLASS THIS FILE HAS ALWAYS GUARDED, RE-ENROLLED AGAINST THE NEW ROOT RATHER THAN
// RETIRED WITH IT. The old claim called converge_apply, which world convergence replaced, so it
// could not survive verbatim -- but DESIGN 4b(4) retires the obsolete PRODUCTION machinery, never
// the class's evidence.
//
// THE FIRST RE-ENROLMENT DID NOT DISCRIMINATE TRANSPORT, AND ITS OWN NOTE CLAIMED IT DID. It
// accepted ANY refusal constructor through a wildcard and called that "the transport is the only
// varied input", but the sibling knob-frontier claim uses this same fixture under LocalShell and
// already refuses -- so substituting LocalShell here left the witness green. A claim named for a
// boundary, passing for a reason unrelated to that boundary, is worse than no claim: it is cited as
// coverage for a wall it never touched. Same failure as an arm that is wrong only once someone
// reaches it.
//
// SO THE CONTROL IS INSIDE THE CLAIM RATHER THAN BESIDE IT. Both halves are asserted together: the
// emit transport must refuse with the reason that names the fresh-standup bootstrap boundary, AND
// the identical fixture under LocalShell must NOT satisfy that same assertion. A realization that
// ignored transport and answered both alike fails the second half, so the claim cannot be satisfied
// without the distinction existing. Routing EmitArtifactThenThinRun through the in-process arm
// turns the first half red while leaving the LocalShell half untouched.
fn transport_refusal_reason(transport: HostEffectTransport) -> String {
  match world_converge(
    subject: HostConvergenceSubject { identity: operator_host_srv3 },
    context: HostConvergenceContext {
      policy: ConvergePolicyDerived { hosts: [fixture_srv3_host_converge()] },
      transport: transport,
    },
    handler: host_world_convergence_handler,
  ) {
    WorldNotConverged { subject: _, refusal: HostConvergenceApplyRefused { reason: reason } } => reason
    WorldNotConverged { subject: _, refusal: _ } => "refused for a non-apply reason"
    WorldConverged { subject: _, observed: _, receipt: _ } => "converged"
  }
}

test fn witness_emit_artifact_transport_rejects_shell_command() -> Bool {
  let emit = transport_refusal_reason(transport: EmitArtifactThenThinRun {
    bootstrap: BootstrapFragment { script: "true" },
    invocation: fleet_converge_thin_invocation(host: operator_host_srv3),
  })
  let local = transport_refusal_reason(transport: LocalShell)
  string_contains(s: emit, pattern: "EmitArtifactThenThinRun fresh-standup")
    && !string_contains(s: local, pattern: "EmitArtifactThenThinRun fresh-standup")
}
