module test.claim.live_deploy.apply

import gunbc.live_deploy.apply {
  live_deploy_apply_readiness_gate_with_readiness,
}
import gunbc.roadmap_static_site {
  roadmap_site_digest_readback_script,
  roadmap_site_roadmap_url_path,
  roadmap_site_dispatch_url_path,
}
import gunbc.live_deploy.spec { deployment_plan_listen_port }
import gunbc.live_deploy.readiness {
  service_ready_apply_effect,
  ServiceReadyApplyEffect,
  ServiceReadyEvidence,
}
import gunbc.live_deploy.service_ready {
  service_not_ready_reason,
  ServiceNotReady,
  live_deploy_service_ready_poll_bound,
  live_deploy_service_ready_unit_authority,
  live_deploy_service_ready_endpoint_authority,
  UnitDiagnosisUnavailable,
}
import gunbc.host_effect {
  ShellCommand,
  HostOs,
  host_effect_identity_evidence,
  LocalShell,
  HostEffectIntent,
  HostEffectEvidence,
  ShellEffectApplied,
}
import gunbc.live_deploy.spec { deployment_spec_srv1 }
import gunbc.fleet_intent { srv1_host }
import std.realization_reconcile {
  Reconciliation,
  reconciliation_converged,
  Converged,
  NotConverged,
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn fixture_converged_mutation() -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  Converged {
    evidence: ShellEffectApplied {
      exit_code: 0,
      stdout: "live-deploy-mutation-applied",
    },
    applied: HostEffectIntent {
      target: HostOs { node: srv1_host },
      effect: ShellCommand { script: "mutation-marker" },
      evidence: host_effect_identity_evidence,
      transport: LocalShell,
      privilege_denial: none,
    },
  }
}

fn fixture_service_not_ready_readiness() -> Reconciliation<ServiceReadyApplyEffect, ServiceReadyEvidence> {
  NotConverged {
    reason: service_not_ready_reason(refusal: ServiceNotReady {
      unit: live_deploy_service_ready_unit_authority,
      endpoint: live_deploy_service_ready_endpoint_authority,
      waited: live_deploy_service_ready_poll_bound,
      last_probe: "health probe never succeeded",
      unit_diagnosis: UnitDiagnosisUnavailable,
    }),
    applied: service_ready_apply_effect(),
  }
}

test fn witness_red_control_mutation_without_readiness_cannot_converge() -> Bool {
  !reconciliation_converged(
    r: live_deploy_apply_readiness_gate_with_readiness(
      mutation: fixture_converged_mutation(),
      readiness: fixture_service_not_ready_readiness(),
    )
  )
}

test fn witness_red_control_service_not_ready_reason_surfaces_on_blocked_apply() -> Bool {
  match live_deploy_apply_readiness_gate_with_readiness(
    mutation: fixture_converged_mutation(),
    readiness: fixture_service_not_ready_readiness(),
  ) {
    NotConverged { reason: why, applied: _ } =>
      string_contains(s: why, pattern: "ServiceNotReady")
        && string_contains(s: why, pattern: "health probe never succeeded")
    Converged { evidence: _, applied: _ } => false
  }
}

test fn witness_digest_readback_script_is_bounded_and_post_mutation() -> Bool {
  let port = deployment_plan_listen_port(spec: deployment_spec_srv1())
  let script = roadmap_site_digest_readback_script(port: port)
  string_contains(s: script, pattern: roadmap_site_roadmap_url_path)
    && string_contains(s: script, pattern: roadmap_site_dispatch_url_path)
    && string_contains(s: script, pattern: "roadmap-site-readback")
    && string_contains(s: script, pattern: "--connect-timeout")
    && string_contains(s: script, pattern: "--max-time")
    && !string_contains(s: script, pattern: "healthz json parse failed")
}

