          match e {
            UserManagerSandboxEnforcementUnobserved { obligation: _ } => true
            UserManagerSandboxUnobserved { obligation: _ } => false
            UserManagerSandboxSysctlUnreadable { value: _ } => false
            UserManagerDoesNotEnforceSandbox { wrote_into_home: _ } => false
          }
        LabOsUnobserved { obligation: _ } => false
        LabToolchainUnobserved { obligation: _ } => false
      }
    LabPlanReady { host: _, os_package_manager: _, tailscale_client: _, git_path: _, jq_path: _, timeout_path: _, worker_sandbox: _ } => false
  }
}

test fn unobserved_apparmor_with_known_os_refuses_sandbox_rather_than_defaulting() -> Bool {
  let surface = software_surface(
    host: operator_host_srv2,
    os: srv1_software_surface().os_release.value,
    kernel: blank_kernel(),
    apparmor: srv1_software_surface().apparmor_userns.value,
    programs: srv1_software_surface().programs.value,
    sudo_policy: srv1_software_surface().sudo_policy.value,
    cgroup: blank_cgroup(),
    toolchain: srv1_software_surface().toolchain_paths.value,
  )
  let cleared = software_surface(
    host: operator_host_srv2,
    os: surface.os_release.value,
    kernel: blank_kernel(),
    apparmor: HostSysctlFact {
      name: apparmor_restrict_unprivileged_userns_sysctl_name,
      value: none,
      standing: unobserved_software_surface(host: operator_host_srv2).apparmor_userns.value.standing,
    },
    programs: surface.programs.value,
    sudo_policy: surface.sudo_policy.value,
    cgroup: blank_cgroup(),
    toolchain: srv1_software_surface().toolchain_paths.value,
  )
  match lab_deploy_plan_from_software(surface: cleared) {
    LabPlanRefused { cause: c } =>
      match c {
        LabSandbox { cause: e } =>
          match e {
            UserManagerSandboxUnobserved { obligation: _ } => true
            UserManagerSandboxEnforcementUnobserved { obligation: _ } => false
            UserManagerSandboxSysctlUnreadable { value: _ } => false
            UserManagerDoesNotEnforceSandbox { wrote_into_home: _ } => false
          }
        LabOsUnobserved { obligation: _ } => false
        LabToolchainUnobserved { obligation: _ } => false
      }
    LabPlanReady { host: _, os_package_manager: _, tailscale_client: _, git_path: _, jq_path: _, timeout_path: _, worker_sandbox: _ } => false
  }
}

test fn unreadable_apparmor_sysctl_refuses_as_sysctl_unreadable_not_unobserved() -> Bool {
  let surface = software_surface(
    host: operator_host_srv2,
    os: srv1_software_surface().os_release.value,
    kernel: blank_kernel(),
    apparmor: HostSysctlFact {
      name: apparmor_restrict_unprivileged_userns_sysctl_name,
      value: Present { value: 2 },
      standing: srv1_software_surface().apparmor_userns.value.standing,
    },
    programs: srv1_software_surface().programs.value,
    sudo_policy: srv1_software_surface().sudo_policy.value,
    cgroup: blank_cgroup(),
    toolchain: srv1_software_surface().toolchain_paths.value,
  )
  match lab_deploy_plan_from_software(surface: surface) {
    LabPlanRefused { cause: c } =>
      match c {
        LabSandbox { cause: e } =>
          match e {
            UserManagerSandboxSysctlUnreadable { value: n } => n == 2
            UserManagerSandboxUnobserved { obligation: _ } => false
            UserManagerSandboxEnforcementUnobserved { obligation: _ } => false
            UserManagerDoesNotEnforceSandbox { wrote_into_home: _ } => false
          }
        LabOsUnobserved { obligation: _ } => false
        LabToolchainUnobserved { obligation: _ } => false
      }
    LabPlanReady { host: _, os_package_manager: _, tailscale_client: _, git_path: _, jq_path: _, timeout_path: _, worker_sandbox: _ } => false
  }
}

test fn refused_plan_fields_are_unobserved_so_emit_refuses() -> Bool {
  let fields = lab_plan_deploy_fields(
    plan: lab_deploy_plan_from_software(surface: unobserved_software_surface(host: operator_host_srv2)),
  )
  match fields.os_package_manager {
    Present { value: _ } => false
    Absent =>
      match fields.tailscale_client {
        ScopedRemovalUnobserved { reason: _ } => true
        ScopedRemovalSupported { observed: _ } => false
        ScopedRemovalUnsupported { observed: _ } => false
      }
  }
}

test fn srv1_deploy_target_reads_the_ready_plan_fields() -> Bool {
  let fields = lab_plan_deploy_fields(plan: srv1_lab_deploy_plan())
  match deployment_srv1_target().os_package_manager {
    Absent => false
    Present { value: pm } =>
      match fields.os_package_manager {
        Absent => false
        Present { value: fm } =>
          package_manager_is_apt(m: pm) && package_manager_is_apt(m: fm)
            && match deployment_srv1_target().tailscale_client {
              ScopedRemovalSupported { observed: _ } =>
                match fields.tailscale_client {
                  ScopedRemovalSupported { observed: _ } => true
                  ScopedRemovalUnsupported { observed: _ } => false
                  ScopedRemovalUnobserved { reason: _ } => false
                }
              ScopedRemovalUnsupported { observed: _ } => false
              ScopedRemovalUnobserved { reason: _ } => false
            }
      }
  }
}

test fn system_manager_launcher_wiring_is_a_named_unbound_frontier() -> Bool {
  !dissolution_is_bound(condition: system_manager_launcher_wiring_frontier)
}
