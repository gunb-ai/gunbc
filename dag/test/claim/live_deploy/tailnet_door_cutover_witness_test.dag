module test.claim.live_deploy.tailnet_door_cutover_witness_test

import std.types { Bool, String, List, Int }
import gunbc.readiness { Ready, Pending, Refused }
import gunbc.live_deploy.readiness {
  ServiceReadiness, ServiceReadyEvidence, ServiceProbeUnanswered, ServiceReadinessIdentityPending, ProcessRevisionMismatch,
}
import std.types { NonEmptyStr }
import std.realization_reconcile { reconciliation_converged, Converged, NotConverged }
import test.claim.live_deploy.apply { fixture_converged_mutation }
import gunbc.live_deploy.apply { tailnet_door_cutover_reconciliation, live_deploy_tailnet_door_cutover_gate }
import gunbc.live_deploy.desired { deployment_spec_srv1, selected_deployment_spec, srv1_lab_desired_deployment }
import gunbc.live_deploy.emit { tailscale_serve_mapping_apply_steps, deployment_serve_route_script }
import gunbc.live_deploy.readiness { live_deploy_proxied_health_url }
import gunbc.live_deploy.tailnet_door_cutover_host { serve_route_observation_of_status }
import gunbc.live_deploy.candidate_identity { CandidateRelease }
import test.claim.live_deploy.readiness { witness_expected_surface_identity }
import test.claim.live_deploy.deploy_release_fixture { deploy_witness_release_revision }
import gunbc.ci_deploy_access { ci_deploy_srv1_access }
import gunbc.host_effect { LocalShell }
import gunbc.roadmap_dashboard_instance { srv1_live_dashboard_instance, dashboard_instance_tailnet_door_socket }
import gunbc.roadmap_static_site { roadmap_site_health_path }
import extdeps.tailscale.serve { TailscaleServeEndpoint, ServeRootMount, tailscale_serve_backend_of_proxy_target, tailscale_serve_proxy_url }
import gunbc.live_deploy.tailnet_door_cutover {
  ServeRouteObservation, ServeRouteTargets, ServeRouteUnreadable,
  CapturedServeBackend, CapturedBackend, CapturedNoRoute,
  ServeCutoverEffects, ServeCutoverRun, ServeCutoverStep,
  CutoverObserved, CutoverRepointApplied, CutoverProxiedProbed, CutoverRestoreApplied,
  CutoverCommitted, CutoverRefused, CutoverRolledBack,
  CutoverDoorNotReady, CutoverPriorRouteUnreadable, CutoverPriorRouteAmbiguous, CutoverAlreadyRoutedButProxiedPathFailed,
  CutoverRouteNotAtDoorAfterRepoint, CutoverProxiedPathFailed,
  RestoredAndProven, PriorStillInPlace, RestoreSkippedNewerMapping, RestoreUnproven,
  tailnet_door_cutover_run, serve_cutover_outcome_committed, serve_cutover_outcome_reason,
}

// EVERY CLAIM HERE RUNS THE TRANSACTION ITSELF (gunbc.live_deploy.tailnet_door_cutover
// tailnet_door_cutover_run) over supplied effects: the route observations a scenario describes,
// answered in order, and a proxied-path answer. The run's step record is what says which effects
// were performed. The captured backend is deliberately not the port production serves on, so a
// restore that passes can only have used what the first observation showed.

data door: String = "unix:/srv/fixture/tailnet-door.sock"
data prior: String = "http://127.0.0.1:9191"
data intruder: String = "http://127.0.0.1:7777"

fn ready() -> ServiceReadiness {
  Ready { evidence: ServiceReadyEvidence { body: "door healthz body" } }
}

fn unanswered(detail: String) -> ServiceReadiness {
  Pending { cause: ServiceProbeUnanswered { detail: detail } }
}

fn at(target: String) -> ServeRouteObservation {
  ServeRouteTargets { targets: [target] }
}

fn scenario(observations: List<ServeRouteObservation>, proxied: ServiceReadiness) -> ServeCutoverEffects {
  ServeCutoverEffects {
    observe: fn(n) {
      match first(skip(observations, n: n)) {
        Present { value: o } => o
        Absent => ServeRouteUnreadable { detail: "the scenario supplies no further observation" }
      }
    },
    repoint: fn(permit) { "" },
    proxied: fn() { proxied },
    restore: fn(captured) { "" },
  }
}

fn repoints(run: ServeCutoverRun) -> Int {
  count(filter(run.steps, s => s == CutoverRepointApplied))
}

fn restores(run: ServeCutoverRun) -> List<CapturedServeBackend> {
  flat_map(run.steps, s => match s {
    CutoverRestoreApplied { prior: p } => [p]
    CutoverObserved { observation: _ } => []
    CutoverRepointApplied => []
    CutoverProxiedProbed => []
  })
}

// DOOR ABSENT OR UNANSWERED => NO RE-POINT, and nothing else either: the transaction performs no
// effect at all without the permit.
test fn an_unanswering_door_performs_no_effect() -> Bool {
  let run = tailnet_door_cutover_run(door: unanswered(detail: "curl: (7) Couldn't connect to server"), door_target: door, effects: scenario(observations: [at(target: prior)], proxied: ready()))
  count(run.steps) == 0
    && run.outcome == CutoverRefused { cause: CutoverDoorNotReady { detail: "curl: (7) Couldn't connect to server" } }
    && !serve_cutover_outcome_committed(outcome: run.outcome)
}

// WRONG RELEASE OR SURFACE => NO RE-POINT.
test fn a_door_serving_another_release_performs_no_effect() -> Bool {
  let stale = Pending { cause: ServiceReadinessIdentityPending { cause: ProcessRevisionMismatch { expected: "aaaa", observed: "bbbb" } } }
  let run = tailnet_door_cutover_run(door: stale, door_target: door, effects: scenario(observations: [at(target: prior)], proxied: ready()))
  count(run.steps) == 0 && repoints(run: run) == 0 && !serve_cutover_outcome_committed(outcome: run.outcome)
}

// EXACT READINESS => EXACTLY ONE RE-POINT, read back at the door, the proxied path exercised, and
// only then committed. This is the positive control for every refusal and rollback here.
test fn a_ready_door_is_repointed_once_read_back_exercised_and_committed() -> Bool {
  let run = tailnet_door_cutover_run(door: ready(), door_target: door, effects: scenario(observations: [at(target: prior), at(target: door)], proxied: ready()))
  run.outcome == CutoverCommitted { repointed: true }
    && run.steps == [CutoverObserved { observation: at(target: prior) }, CutoverRepointApplied, CutoverObserved { observation: at(target: door) }, CutoverProxiedProbed]
    && repoints(run: run) == 1
    && count(restores(run: run)) == 0
}

// THE ROUTE AS IT STANDS MUST BE READABLE AND SINGLE BEFORE IT IS TOUCHED: with no captured backend
// there is nothing to restore to, so an unreadable or ambiguous prior route refuses the re-point.
test fn an_unreadable_or_ambiguous_prior_route_refuses_the_repoint() -> Bool {
  let unreadable = tailnet_door_cutover_run(door: ready(), door_target: door, effects: scenario(observations: [ServeRouteUnreadable { detail: "tailscale serve status exited 1" }], proxied: ready()))
  let ambiguous = tailnet_door_cutover_run(door: ready(), door_target: door, effects: scenario(observations: [ServeRouteTargets { targets: [prior, intruder] }], proxied: ready()))
  repoints(run: unreadable) == 0 && repoints(run: ambiguous) == 0
    && unreadable.outcome == CutoverRefused { cause: CutoverPriorRouteUnreadable { detail: "tailscale serve status exited 1" } }
    && ambiguous.outcome == CutoverRefused { cause: CutoverPriorRouteAmbiguous { targets: [prior, intruder] } }
}

// PROXIED FAILURE => RESTORE THE CAPTURED BACKEND AND PROVE IT. The route reads back at the door,
// the proxied path does not answer, the route is read again and still shows the door, so the
// backend the FIRST observation showed is restored and the restoration is read back.
test fn a_failed_proxied_path_restores_the_captured_backend_and_proves_it() -> Bool {
  let run = tailnet_door_cutover_run(door: ready(), door_target: door, effects: scenario(observations: [at(target: prior), at(target: door), at(target: door), at(target: prior)], proxied: unanswered(detail: "HTTP 502")))
  run.outcome == CutoverRolledBack { failure: CutoverProxiedPathFailed { detail: "HTTP 502" }, restoration: RestoredAndProven { prior: CapturedBackend { target: prior } } }
    && restores(run: run) == [CapturedBackend { target: prior }]
    && repoints(run: run) == 1
    && !serve_cutover_outcome_committed(outcome: run.outcome)
    && string_contains(s: serve_cutover_outcome_reason(outcome: run.outcome), pattern: prior)
}

// A ROUTE THAT HAD NO MAPPING IS RESTORED TO NO MAPPING, not to a port.
test fn a_failed_cutover_from_no_route_restores_no_route() -> Bool {
  let none_at_all = ServeRouteTargets { targets: [] }
  let run = tailnet_door_cutover_run(door: ready(), door_target: door, effects: scenario(observations: [none_at_all, at(target: door), at(target: door), none_at_all], proxied: unanswered(detail: "HTTP 502")))
  restores(run: run) == [CapturedNoRoute]
    && run.outcome == CutoverRolledBack { failure: CutoverProxiedPathFailed { detail: "HTTP 502" }, restoration: RestoredAndProven { prior: CapturedNoRoute } }
}

// POST-RE-POINT STATUS MISMATCH, three ways. Unreadable after the re-point: the captured backend is
// restored and proven. Still the captured backend: the re-point did not take, nothing is restored
// because nothing moved. Neither is committed and the proxied path is never exercised.
test fn a_route_not_at_the_door_after_the_repoint_is_not_committed() -> Bool {
  let unreadable = tailnet_door_cutover_run(door: ready(), door_target: door, effects: scenario(observations: [at(target: prior), ServeRouteUnreadable { detail: "status timed out" }, at(target: prior)], proxied: ready()))
  let did_not_take = tailnet_door_cutover_run(door: ready(), door_target: door, effects: scenario(observations: [at(target: prior), at(target: prior)], proxied: ready()))
  restores(run: unreadable) == [CapturedBackend { target: prior }]
    && (match unreadable.outcome {
      CutoverRolledBack { failure: CutoverRouteNotAtDoorAfterRepoint { observed: _, repoint_detail: _ }, restoration: RestoredAndProven { prior: _ } } => true
      other => false
    })
    && count(restores(run: did_not_take)) == 0
    && (match did_not_take.outcome {
      CutoverRolledBack { failure: CutoverRouteNotAtDoorAfterRepoint { observed: _, repoint_detail: _ }, restoration: PriorStillInPlace { prior: _ } } => true
      other => false
    })
    && count(filter(unreadable.steps, s => s == CutoverProxiedProbed)) == 0
    && count(filter(did_not_take.steps, s => s == CutoverProxiedProbed)) == 0
}

// NO RESTORE OVER A NEWER MAPPING. After the re-point, and again after a failed proxied probe, a
// route showing a backend that is neither the door nor the capture was written by someone else:
// it is left in place and reported, and no restore effect is performed.
test fn a_newer_mapping_is_never_overwritten_by_the_restore() -> Bool {
  let after_repoint = tailnet_door_cutover_run(door: ready(), door_target: door, effects: scenario(observations: [at(target: prior), at(target: intruder)], proxied: ready()))
  let after_probe = tailnet_door_cutover_run(door: ready(), door_target: door, effects: scenario(observations: [at(target: prior), at(target: door), at(target: intruder)], proxied: unanswered(detail: "HTTP 502")))
  count(restores(run: after_repoint)) == 0 && count(restores(run: after_probe)) == 0
    && (match after_repoint.outcome {
      CutoverRolledBack { failure: _, restoration: RestoreSkippedNewerMapping { observed } } => observed == [intruder]
      other => false
    })
    && (match after_probe.outcome {
      CutoverRolledBack { failure: CutoverProxiedPathFailed { detail: _ }, restoration: RestoreSkippedNewerMapping { observed } } => observed == [intruder]
      other => false
    })
}

// A RESTORE THAT CANNOT BE READ BACK IS NOT REPORTED AS A RESTORATION.
test fn an_unproven_restore_says_the_route_may_still_target_the_door() -> Bool {
  let run = tailnet_door_cutover_run(door: ready(), door_target: door, effects: scenario(observations: [at(target: prior), at(target: door), at(target: door), at(target: door)], proxied: unanswered(detail: "HTTP 502")))
  restores(run: run) == [CapturedBackend { target: prior }]
    && (match run.outcome {
      CutoverRolledBack { failure: _, restoration: RestoreUnproven { detail: _ } } => true
      other => false
    })
    && string_contains(s: serve_cutover_outcome_reason(outcome: run.outcome), pattern: "MAY STILL TARGET THE DOOR")
}

// A SUCCESSFUL RETRY IS IDEMPOTENT: the route already targets the door, so nothing is re-pointed,
// nothing is restored, and the proxied path alone decides. If that path fails on a retry there is
// no captured backend, so the run refuses and performs no restore.
test fn a_retry_over_an_already_routed_door_repoints_nothing() -> Bool {
  let committed = tailnet_door_cutover_run(door: ready(), door_target: door, effects: scenario(observations: [at(target: door)], proxied: ready()))
  let failing = tailnet_door_cutover_run(door: ready(), door_target: door, effects: scenario(observations: [at(target: door)], proxied: unanswered(detail: "HTTP 502")))
  committed.outcome == CutoverCommitted { repointed: false }
    && committed.steps == [CutoverObserved { observation: at(target: door) }, CutoverProxiedProbed]
    && repoints(run: committed) == 0 && repoints(run: failing) == 0
    && count(restores(run: failing)) == 0
    && failing.outcome == CutoverRefused { cause: CutoverAlreadyRoutedButProxiedPathFailed { detail: "HTTP 502" } }
}

// ── The transaction as the deploy runs it ───────────────────────────────────────────────────────

fn production_door_target() -> String {
  concat("unix:", dashboard_instance_tailnet_door_socket(instance: srv1_live_dashboard_instance()) as String)
}

// THE RE-POINT IS NOT IN THE BULK MUTATION. Production's mapping member contributes no apply step,
// so applying the deployment cannot redirect the route on its own; the port-routed twin still
// re-asserts its mapping there. The cutover's own effect is the one script that writes the route,
// and it names the door.
test fn the_door_route_is_written_by_the_cutover_and_not_by_the_bulk_apply() -> Bool {
  let live = deployment_spec_srv1()
  let twin = selected_deployment_spec(row: srv1_lab_desired_deployment())
  let script = deployment_serve_route_script(endpoint: live.names.tailscale_serve_endpoint, enabled: true)
  let off = deployment_serve_route_script(endpoint: live.names.tailscale_serve_endpoint, enabled: false)
  count(tailscale_serve_mapping_apply_steps(spec: live)) == 0
    && count(tailscale_serve_mapping_apply_steps(spec: twin)) == 1
    && string_contains(s: script, pattern: join(["'tailscale' 'serve' '--bg' '--https=443' '", production_door_target(), "'"], ""))
    && string_contains(s: off, pattern: "'tailscale' 'serve' '--https=443' 'off'")
    && tailscale_serve_proxy_url(endpoint: live.names.tailscale_serve_endpoint) == production_door_target()
}

// THE DEPLOY'S OWN GATE, with the door not ready: live_deploy_tailnet_door_cutover_gate on the
// production deployment answers NotConverged naming the door and performs no host effect -- the
// permit is refused before the effects it would sequence are reached. With no door (the twin) the
// gate is the identity.
test fn the_deploy_gate_refuses_an_unready_door_before_any_host_effect() -> Bool {
  let candidate = CandidateRelease { revision: deploy_witness_release_revision, expected_surface_identity: witness_expected_surface_identity() }
  let refused = live_deploy_tailnet_door_cutover_gate(
    spec: deployment_spec_srv1(), candidate: candidate, transport: LocalShell, access: ci_deploy_srv1_access,
    readiness: unanswered(detail: "the tailnet door is not serving this release"), mutation: fixture_converged_mutation(),
  )
  let twin = live_deploy_tailnet_door_cutover_gate(
    spec: selected_deployment_spec(row: srv1_lab_desired_deployment()), candidate: candidate, transport: LocalShell, access: ci_deploy_srv1_access,
    readiness: unanswered(detail: "irrelevant"), mutation: fixture_converged_mutation(),
  )
  reconciliation_converged(r: twin)
    && (match refused {
      NotConverged { reason: why, applied: _ } => string_contains(s: why, pattern: "refused before any re-point") && string_contains(s: why, pattern: "the tailnet door is not serving this release")
      Converged { evidence: _, applied: _ } => false
    })
}

// ONLY A COMMITTED CUTOVER LEAVES THE DEPLOYMENT CONVERGED, and a rollback's reason says what
// became of the route.
test fn only_a_committed_cutover_leaves_the_deployment_converged() -> Bool {
  let rolled_back = tailnet_door_cutover_reconciliation(
    mutation: fixture_converged_mutation(),
    outcome: CutoverRolledBack { failure: CutoverProxiedPathFailed { detail: "HTTP 502" }, restoration: RestoredAndProven { prior: CapturedBackend { target: prior } } },
  )
  reconciliation_converged(r: tailnet_door_cutover_reconciliation(mutation: fixture_converged_mutation(), outcome: CutoverCommitted { repointed: true }))
    && reconciliation_converged(r: tailnet_door_cutover_reconciliation(mutation: fixture_converged_mutation(), outcome: CutoverCommitted { repointed: false }))
    && (match rolled_back {
      NotConverged { reason: why, applied: _ } => string_contains(s: why, pattern: "HTTP 502") && string_contains(s: why, pattern: "restored to its captured backend") && string_contains(s: why, pattern: prior)
      Converged { evidence: _, applied: _ } => false
    })
}

// THE RESTORE RESTATES WHAT WAS CAPTURED. A loopback port target restates as its port and a unix
// target as itself, each round-tripping through the status form; a target of any other shape
// restates as nothing, which the restore reports rather than approximating.
test fn a_captured_target_restates_as_its_own_backend_or_not_at_all() -> Bool {
  let port_backend = tailscale_serve_backend_of_proxy_target(target: prior)
  let unix_backend = tailscale_serve_backend_of_proxy_target(target: door)
  port_backend == Present { value: "9191" as NonEmptyStr }
    && unix_backend == Present { value: door as NonEmptyStr }
    && tailscale_serve_proxy_url(endpoint: TailscaleServeEndpoint { https_port: 443, mount: ServeRootMount, backend: "9191" as NonEmptyStr }) == prior
    && tailscale_serve_backend_of_proxy_target(target: "https://elsewhere.example:8443") == none
    && tailscale_serve_backend_of_proxy_target(target: "http://127.0.0.1:not-a-port") == none
    && tailscale_serve_backend_of_proxy_target(target: "unix:") == none
}

// THE TWO READS, AS THE DEPLOY TAKES THEM: the route observation is the status document projected
// at production's route key, and the proxied path is asked for at the deployment's tailnet name
// on the default listener, at the health route.
test fn the_route_observation_and_proxied_url_are_the_deployments_own() -> Bool {
  let live = deployment_spec_srv1()
  let status = join(["\{\"Web\":\{\"srv1.example.ts.net:443\":\{\"Handlers\":\{\"/\":\{\"Proxy\":\"", production_door_target(), "\"\}\}\},\"srv1.example.ts.net:10000\":\{\"Handlers\":\{\"/\":\{\"Proxy\":\"unix:/elsewhere.sock\"\}\}\}\}\}"], "")
  serve_route_observation_of_status(status_json: status, spec: live) == at(target: production_door_target())
    && serve_route_observation_of_status(status_json: "\{\"TCP\":\{\}\}", spec: live) == ServeRouteTargets { targets: [] }
    && (match serve_route_observation_of_status(status_json: "not-json", spec: live) {
      ServeRouteUnreadable { detail: _ } => true
      ServeRouteTargets { targets: _ } => false
    })
    && (match live_deploy_proxied_health_url(spec: live) {
      Absent => false
      Present { value: url } => starts_with(s: url as String, prefix: "https://srv1.") && ends_with(s: url as String, suffix: roadmap_site_health_path) && !string_contains(s: url as String, pattern: ":443")
    })
}
