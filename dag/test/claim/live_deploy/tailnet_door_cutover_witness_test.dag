import gunbc.live_deploy.readiness { live_deploy_proxied_health_url }
import gunbc.live_deploy.tailnet_door_cutover_host { serve_route_observation_of_status, cutover_journal_record_json, cutover_journal_record_of_json }
import gunbc.live_deploy.candidate_identity { CandidateRelease }
import test.claim.live_deploy.readiness { witness_expected_surface_identity }
import test.claim.live_deploy.deploy_release_fixture { deploy_witness_release_revision }
import gunbc.ci_deploy_access { ci_deploy_srv1_access }
import gunbc.host_effect { LocalShell }
import gunbc.roadmap_dashboard_instance { srv1_live_dashboard_instance, dashboard_instance_tailnet_door_socket }
import gunbc.roadmap_static_site { roadmap_site_health_path }
import extdeps.tailscale.serve { TailscaleServeEndpoint, ServeRootMount, tailscale_serve_backend_of_proxy_target, tailscale_serve_proxy_url }
