  CutoverObserved, CutoverJournaled, CutoverRepointApplied, CutoverProxiedProbed, CutoverRestoreApplied,
  CutoverCommitted, CutoverRefused, CutoverRolledBack,
  CutoverJournalNotReadable, CutoverJournalForeign, CutoverJournalNotRecorded,
  CutoverDoorNotReady, CutoverPriorRouteUnreadable, CutoverPriorRouteAmbiguous, CutoverPriorRouteNotRestorable, CutoverAlreadyRoutedButProxiedPathFailed,
  CutoverRouteNotAtDoorAfterRepoint, CutoverProxiedPathFailed, CutoverDoorNotReadyOnResume, CutoverRollbackResumed, CutoverCommitNotRecorded,
  RestoredAndProven, PriorStillInPlace, RestoreSkippedNewerMapping, RestoreUnproven, RouteLeftAtDoor,
  tailnet_door_cutover_run, serve_cutover_outcome_committed, serve_cutover_outcome_reason,
}

// EVERY CLAIM HERE RUNS THE TRANSACTION ITSELF (gunbc.live_deploy.tailnet_door_cutover
// tailnet_door_cutover_run) over supplied effects: the journal as a run finds it, the route
// observations a scenario describes, answered in order, and a proxied-path answer. The run's step
// record is what says which effects were performed. The captured backend is deliberately not the
// port production serves on, so a restore that passes can only have used a capture.
//
// AN INTERRUPTION IS A RUN THAT STARTS FROM THE JOURNAL THE INTERRUPTED ONE LEFT: the record its
// last journal write made, and the route wherever the interrupted run's last route effect put it.

data door: String = "unix:/srv/fixture/tailnet-door.sock"
data prior: String = "http://127.0.0.1:9191"
data intruder: String = "http://127.0.0.1:7777"
data route_name: String = "fixture 443:/"

fn binding() -> CutoverBinding {
  CutoverBinding { route: route_name, door_target: door, release_revision: "release-b" }
}

fn captured() -> CapturedServeBackend {
  CapturedRestorableBackend { target: prior, backend: "9191" as NonEmptyStr }
}

fn ready() -> ServiceReadiness {
  Ready { evidence: ServiceReadyEvidence { body: "door healthz body" } }
}

fn unanswered(detail: String) -> ServiceReadiness {
  Pending { cause: ServiceProbeUnanswered { detail: detail } }
}

fn at(target: String) -> ServeRouteObservation {
  ServeRouteTargets { targets: [target] }
}

// The journal an interrupted run of THIS release left at this phase, with its capture.
fn left_at(phase: CutoverPhase) -> CutoverJournalRead {
  left_by(release_revision: "release-b", phase: phase)
}

fn left_by(release_revision: String, phase: CutoverPhase) -> CutoverJournalRead {
  CutoverJournalPresent { record: CutoverJournalRecord { route: route_name, door_target: door, release_revision: release_revision, prior: captured(), phase: phase }, generation: 4 }
}

fn scenario_over(journal: CutoverJournalRead, write: CutoverJournalWrite?, observations: List<ServeRouteObservation>, proxied: ServiceReadiness) -> ServeCutoverEffects {
  ServeCutoverEffects {
    journal_read: fn() { journal },
    journal_write: fn(expected_generation, record) {
      match write {
        Present { value: forced } => forced
        Absent => CutoverJournalWritten { generation: expected_generation + 1 }
      }
    },
    observe: fn(n) {
      match first(skip(observations, n: n)) {
        Present { value: o } => o
        Absent => ServeRouteUnreadable { detail: "the scenario supplies no further observation" }
      }
    },
    repoint: fn(permit) { "" },
    proxied: fn() { proxied },
    restore: fn(captured_backend) { "" },
  }
}

fn scenario(observations: List<ServeRouteObservation>, proxied: ServiceReadiness) -> ServeCutoverEffects {
  scenario_over(journal: CutoverJournalAbsent, write: none, observations: observations, proxied: proxied)
}

fn run_of(door_standing: ServiceReadiness, effects: ServeCutoverEffects) -> ServeCutoverRun {
  tailnet_door_cutover_run(door: door_standing, binding: binding(), effects: effects)
}

fn repoints(run: ServeCutoverRun) -> Int {
  count(filter(run.steps, s => s == CutoverRepointApplied))
}

fn restores(run: ServeCutoverRun) -> List<CapturedServeBackend> {
  flat_map(run.steps, s => match s {
    CutoverRestoreApplied { prior: p } => [p]
    CutoverObserved { observation: _ } => []
    CutoverJournaled { phase: _ } => []
    CutoverRepointApplied => []
    CutoverProxiedProbed => []
  })
}

fn journaled(run: ServeCutoverRun) -> List<CutoverPhase> {
  flat_map(run.steps, s => match s {
    CutoverJournaled { phase: p } => [p]
    CutoverObserved { observation: _ } => []
    CutoverRestoreApplied { prior: _ } => []
    CutoverRepointApplied => []
    CutoverProxiedProbed => []
  })
}

fn route_effects(run: ServeCutoverRun) -> Int {
  repoints(run: run) + count(restores(run: run))
}

// DOOR ABSENT OR UNANSWERED => NO RE-POINT, and nothing else either: with no in-flight record the
// transaction performs no effect at all without the permit.
test fn an_unanswering_door_performs_no_effect() -> Bool {
  let run = run_of(door_standing: unanswered(detail: "curl: (7) Couldn't connect to server"), effects: scenario(observations: [at(target: prior)], proxied: ready()))
  count(run.steps) == 0
    && run.outcome == CutoverRefused { cause: CutoverDoorNotReady { detail: "curl: (7) Couldn't connect to server" } }
    && !serve_cutover_outcome_committed(outcome: run.outcome)
}

// WRONG RELEASE OR SURFACE => NO RE-POINT.
test fn a_door_serving_another_release_performs_no_effect() -> Bool {
  let stale = Pending { cause: ServiceReadinessIdentityPending { cause: ProcessRevisionMismatch { expected: "aaaa", observed: "bbbb" } } }
  let run = run_of(door_standing: stale, effects: scenario(observations: [at(target: prior)], proxied: ready()))
  count(run.steps) == 0 && !serve_cutover_outcome_committed(outcome: run.outcome)
}

// EXACT READINESS => EXACTLY ONE RE-POINT, with the capture journaled BEFORE it: observe, journal
// Prepared, re-point, journal Repointed, read back at the door, exercise the proxied path, journal
// Committed. This is the positive control for every refusal and rollback here.
test fn a_ready_door_is_journaled_repointed_once_read_back_exercised_and_committed() -> Bool {
  let run = run_of(door_standing: ready(), effects: scenario(observations: [at(target: prior), at(target: door)], proxied: ready()))
  run.outcome == CutoverCommitted { repointed: true }
    && run.steps == [
      CutoverObserved { observation: at(target: prior) },
      CutoverJournaled { phase: CutoverPrepared },
      CutoverRepointApplied,
      CutoverJournaled { phase: CutoverRepointed },
      CutoverObserved { observation: at(target: door) },
      CutoverProxiedProbed,
      CutoverJournaled { phase: CutoverSettledCommitted },
    ]
    && repoints(run: run) == 1
    && count(restores(run: run)) == 0
}

// THE CAPTURE MUST BE RESTORABLE AND DURABLE BEFORE THE ROUTE IS TOUCHED. An unreadable prior
// route, an ambiguous one, ONE PRIOR TARGET THAT CANNOT BE PUT BACK, and a capture the journal did
// not record -- refused or fenced by another run -- each cause zero route effects.
test fn an_unrestorable_or_unjournaled_capture_causes_zero_route_effects() -> Bool {
  let unreadable = run_of(door_standing: ready(), effects: scenario(observations: [ServeRouteUnreadable { detail: "tailscale serve status exited 1" }], proxied: ready()))
  let ambiguous = run_of(door_standing: ready(), effects: scenario(observations: [ServeRouteTargets { targets: [prior, intruder] }], proxied: ready()))
  let unrepresentable = run_of(door_standing: ready(), effects: scenario(observations: [at(target: "https://elsewhere.example:8443"), at(target: door)], proxied: ready()))
  let fenced = run_of(door_standing: ready(), effects: scenario_over(journal: CutoverJournalAbsent, write: Present { value: CutoverJournalFenced }, observations: [at(target: prior), at(target: door)], proxied: ready()))
  let store_refused = run_of(door_standing: ready(), effects: scenario_over(journal: CutoverJournalAbsent, write: Present { value: CutoverJournalWriteRefused { detail: "store unavailable" } }, observations: [at(target: prior), at(target: door)], proxied: ready()))
  route_effects(run: unreadable) == 0 && route_effects(run: ambiguous) == 0 && route_effects(run: unrepresentable) == 0
    && route_effects(run: fenced) == 0 && route_effects(run: store_refused) == 0
    && unreadable.outcome == CutoverRefused { cause: CutoverPriorRouteUnreadable { detail: "tailscale serve status exited 1" } }
    && ambiguous.outcome == CutoverRefused { cause: CutoverPriorRouteAmbiguous { targets: [prior, intruder] } }
    && unrepresentable.outcome == CutoverRefused { cause: CutoverPriorRouteNotRestorable { target: "https://elsewhere.example:8443" } }
    && store_refused.outcome == CutoverRefused { cause: CutoverJournalNotRecorded { detail: "store unavailable" } }
    && (match fenced.outcome {
      CutoverRefused { cause: CutoverJournalNotRecorded { detail: _ } } => true
      other => false
    })
}

// A JOURNAL THAT CANNOT BE READ, OR IS ABOUT ANOTHER ROUTE OR DOOR, REFUSES BEFORE ANYTHING: an
// interrupted cutover cannot be ruled out, or the record is not this run's to act on.
test fn an_unreadable_or_foreign_journal_refuses_before_any_effect() -> Bool {
  let unreadable = run_of(door_standing: ready(), effects: scenario_over(journal: CutoverJournalUnreadable { detail: "slot head malformed" }, write: none, observations: [at(target: prior), at(target: door)], proxied: ready()))
  let other_door = run_of(door_standing: ready(), effects: scenario_over(
    journal: CutoverJournalPresent { record: CutoverJournalRecord { route: route_name, door_target: "unix:/srv/other.sock", release_revision: "release-a", prior: captured(), phase: CutoverRepointed }, generation: 4 },
    write: none, observations: [at(target: door)], proxied: unanswered(detail: "HTTP 502")))
  let other_route = run_of(door_standing: ready(), effects: scenario_over(
    journal: CutoverJournalPresent { record: CutoverJournalRecord { route: "elsewhere 443:/", door_target: door, release_revision: "release-a", prior: captured(), phase: CutoverRepointed }, generation: 4 },
    write: none, observations: [at(target: door)], proxied: unanswered(detail: "HTTP 502")))
  count(unreadable.steps) == 0 && count(other_door.steps) == 0 && count(other_route.steps) == 0
    && unreadable.outcome == CutoverRefused { cause: CutoverJournalNotReadable { detail: "slot head malformed" } }
    && other_door.outcome == CutoverRefused { cause: CutoverJournalForeign { route: route_name, door_target: "unix:/srv/other.sock", release_revision: "release-a" } }
    && other_route.outcome == CutoverRefused { cause: CutoverJournalForeign { route: "elsewhere 443:/", door_target: door, release_revision: "release-a" } }
}

// A CUTOVER LEFT IN FLIGHT BY ANOTHER RELEASE IS NOT THIS RUN'S TO RESUME: Prepared, Repointed and
// RollingBack records of another release each refuse with no effect at all, whatever the route
// shows. A SETTLED record of another release is history, and a fresh attempt follows it.
test fn another_releases_in_flight_cutover_refuses_and_its_settled_one_does_not() -> Bool {
  let prepared = run_of(door_standing: ready(), effects: scenario_over(journal: left_by(release_revision: "release-a", phase: CutoverPrepared), write: none, observations: [at(target: prior), at(target: door)], proxied: ready()))
  let repointed = run_of(door_standing: ready(), effects: scenario_over(journal: left_by(release_revision: "release-a", phase: CutoverRepointed), write: none, observations: [at(target: door), at(target: door), at(target: prior)], proxied: unanswered(detail: "HTTP 502")))
  let rolling = run_of(door_standing: ready(), effects: scenario_over(journal: left_by(release_revision: "release-a", phase: CutoverRollingBack), write: none, observations: [at(target: door), at(target: prior)], proxied: ready()))
  let settled = run_of(door_standing: ready(), effects: scenario_over(journal: left_by(release_revision: "release-a", phase: CutoverSettledRolledBack), write: none, observations: [at(target: prior), at(target: door)], proxied: ready()))
  count(prepared.steps) == 0 && count(repointed.steps) == 0 && count(rolling.steps) == 0
    && repointed.outcome == CutoverRefused { cause: CutoverJournalForeign { route: route_name, door_target: door, release_revision: "release-a" } }
    && !serve_cutover_outcome_committed(outcome: prepared.outcome) && !serve_cutover_outcome_committed(outcome: rolling.outcome)
    && settled.outcome == CutoverCommitted { repointed: true } && repoints(run: settled) == 1
}

// A BLIND RESTORE NEEDS THE JOURNAL. When the route cannot be read after the re-point, the capture
// is restored only by a run whose RollingBack write lands at the generation it holds; a run fenced
// out by a newer one restores nothing and says the route may still target the door.
test fn an_unreadable_route_is_restored_only_by_the_run_holding_the_journal() -> Bool {
  let holding = run_of(door_standing: ready(), effects: scenario_over(journal: left_at(phase: CutoverRepointed), write: none, observations: [ServeRouteUnreadable { detail: "status timed out" }, at(target: prior)], proxied: ready()))
  let fenced_out = run_of(door_standing: ready(), effects: scenario_over(journal: left_at(phase: CutoverRepointed), write: Present { value: CutoverJournalFenced }, observations: [ServeRouteUnreadable { detail: "status timed out" }, at(target: prior)], proxied: ready()))
  restores(run: holding) == [captured()]
    && journaled(run: holding) == [CutoverRollingBack, CutoverSettledRolledBack]
    && route_effects(run: fenced_out) == 0
    && (match fenced_out.outcome {
      CutoverRolledBack { failure: _, restoration: RestoreUnproven { detail: _ } } => true
      other => false
    })
}

// PROXIED FAILURE => RESTORE THE CAPTURED BACKEND AND PROVE IT, journaled on both sides: the route
// reads back at the door, the proxied path does not answer, the route is read again and still
// shows the door, RollingBack is journaled, the capture is restored and read back, RolledBack is
// journaled.
test fn a_failed_proxied_path_restores_the_captured_backend_and_proves_it() -> Bool {
  let run = run_of(door_standing: ready(), effects: scenario(observations: [at(target: prior), at(target: door), at(target: door), at(target: prior)], proxied: unanswered(detail: "HTTP 502")))
  run.outcome == CutoverRolledBack { failure: CutoverProxiedPathFailed { detail: "HTTP 502" }, restoration: RestoredAndProven { prior: captured() } }
    && restores(run: run) == [captured()]
    && repoints(run: run) == 1
    && journaled(run: run) == [CutoverPrepared, CutoverRepointed, CutoverRollingBack, CutoverSettledRolledBack]
    && string_contains(s: serve_cutover_outcome_reason(outcome: run.outcome), pattern: prior)
}

// A ROUTE THAT HAD NO MAPPING IS RESTORED TO NO MAPPING, not to a port.
test fn a_failed_cutover_from_no_route_restores_no_route() -> Bool {
  let none_at_all = ServeRouteTargets { targets: [] }
  let run = run_of(door_standing: ready(), effects: scenario(observations: [none_at_all, at(target: door), at(target: door), none_at_all], proxied: unanswered(detail: "HTTP 502")))
  restores(run: run) == [CapturedNoRoute]
    && run.outcome == CutoverRolledBack { failure: CutoverProxiedPathFailed { detail: "HTTP 502" }, restoration: RestoredAndProven { prior: CapturedNoRoute } }
}

// POST-RE-POINT STATUS MISMATCH. Unreadable after the re-point: the capture is restored and
// proven. Still the capture: the re-point did not take and nothing is restored. Neither is
// committed and the proxied path is never exercised.
test fn a_route_not_at_the_door_after_the_repoint_is_not_committed() -> Bool {
  let unreadable = run_of(door_standing: ready(), effects: scenario(observations: [at(target: prior), ServeRouteUnreadable { detail: "status timed out" }, at(target: prior)], proxied: ready()))
  let did_not_take = run_of(door_standing: ready(), effects: scenario(observations: [at(target: prior), at(target: prior)], proxied: ready()))
  restores(run: unreadable) == [captured()]
    && (match unreadable.outcome {
      CutoverRolledBack { failure: CutoverRouteNotAtDoorAfterRepoint { observed: _, repoint_detail: _ }, restoration: RestoredAndProven { prior: _ } } => true
      other => false
    })
    && count(restores(run: did_not_take)) == 0
    && (match did_not_take.outcome {
      CutoverRolledBack { failure: CutoverRouteNotAtDoorAfterRepoint { observed: _, repoint_detail: _ }, restoration: PriorStillInPlace { prior: _ } } => true
      other => false
    })
    && count(filter(unreadable.steps, s => s == CutoverProxiedProbed)) == 0
    && count(filter(did_not_take.steps, s => s == CutoverProxiedProbed)) == 0
}

// NO RESTORE OVER A NEWER MAPPING. After the re-point, and again after a failed proxied probe, a
// route showing a backend that is neither the door nor the capture was written by someone else:
// it is left in place and reported, and no restore effect is performed.
test fn a_newer_mapping_is_never_overwritten_by_the_restore() -> Bool {
  let after_repoint = run_of(door_standing: ready(), effects: scenario(observations: [at(target: prior), at(target: intruder)], proxied: ready()))
  let after_probe = run_of(door_standing: ready(), effects: scenario(observations: [at(target: prior), at(target: door), at(target: intruder)], proxied: unanswered(detail: "HTTP 502")))
  let on_resume = run_of(door_standing: ready(), effects: scenario_over(journal: left_at(phase: CutoverRepointed), write: none, observations: [at(target: intruder)], proxied: ready()))
  count(restores(run: after_repoint)) == 0 && count(restores(run: after_probe)) == 0 && route_effects(run: on_resume) == 0
    && (match after_repoint.outcome {
      CutoverRolledBack { failure: _, restoration: RestoreSkippedNewerMapping { observed } } => observed == [intruder]
      other => false
    })
    && (match after_probe.outcome {
      CutoverRolledBack { failure: CutoverProxiedPathFailed { detail: _ }, restoration: RestoreSkippedNewerMapping { observed } } => observed == [intruder]
      other => false
    })
    && (match on_resume.outcome {
      CutoverRolledBack { failure: _, restoration: RestoreSkippedNewerMapping { observed } } => observed == [intruder]
      other => false
    })
}

// A RESTORE THAT CANNOT BE READ BACK IS NOT REPORTED AS A RESTORATION, and the journal is left
// RollingBack so the next run resumes it rather than starting afresh.
test fn an_unproven_restore_stays_in_flight_in_the_journal() -> Bool {
  let run = run_of(door_standing: ready(), effects: scenario(observations: [at(target: prior), at(target: door), at(target: door), at(target: door)], proxied: unanswered(detail: "HTTP 502")))
  restores(run: run) == [captured()]
    && journaled(run: run) == [CutoverPrepared, CutoverRepointed, CutoverRollingBack]
    && (match run.outcome {
      CutoverRolledBack { failure: _, restoration: RestoreUnproven { detail: _ } } => true
      other => false
    })
    && string_contains(s: serve_cutover_outcome_reason(outcome: run.outcome), pattern: "MAY STILL TARGET THE DOOR")
}

// INTERRUPTED AFTER THE RE-POINT. The journal says Repointed and carries the capture; the route is
// at the door. A resuming run whose proxied path fails restores THE JOURNAL'S capture -- it made
// none of its own, and the route no longer shows what it used to be. With the proxied path
// answering it commits without re-pointing. With its own door not ready it rolls back all the same.
test fn an_interruption_after_the_repoint_resumes_from_the_journaled_capture() -> Bool {
  let failing = run_of(door_standing: ready(), effects: scenario_over(journal: left_at(phase: CutoverRepointed), write: none, observations: [at(target: door), at(target: door), at(target: prior)], proxied: unanswered(detail: "HTTP 502")))
  let answering = run_of(door_standing: ready(), effects: scenario_over(journal: left_at(phase: CutoverRepointed), write: none, observations: [at(target: door)], proxied: ready()))
  let door_dead = run_of(door_standing: unanswered(detail: "door unit exited"), effects: scenario_over(journal: left_at(phase: CutoverRepointed), write: none, observations: [at(target: door), at(target: prior)], proxied: ready()))
  failing.outcome == CutoverRolledBack { failure: CutoverProxiedPathFailed { detail: "HTTP 502" }, restoration: RestoredAndProven { prior: captured() } }
    && restores(run: failing) == [captured()] && repoints(run: failing) == 0
    && answering.outcome == CutoverCommitted { repointed: false }
    && route_effects(run: answering) == 0
    && journaled(run: answering) == [CutoverRepointed, CutoverSettledCommitted]
    && door_dead.outcome == CutoverRolledBack { failure: CutoverDoorNotReadyOnResume { detail: "door unit exited" }, restoration: RestoredAndProven { prior: captured() } }
    && restores(run: door_dead) == [captured()]
    && count(filter(door_dead.steps, s => s == CutoverProxiedProbed)) == 0
}

// INTERRUPTED BEFORE THE RE-POINT, or between it and its journal write. The journal says Prepared.
// Route still the capture: nothing moved, so a ready run re-points now under the SAME capture and
// an unready one settles the record without touching the route. Route already at the door: the
// re-point landed unrecorded and is treated exactly as Repointed.
test fn an_interruption_at_prepared_resumes_with_the_same_capture() -> Bool {
  let never_moved = run_of(door_standing: ready(), effects: scenario_over(journal: left_at(phase: CutoverPrepared), write: none, observations: [at(target: prior), at(target: door)], proxied: ready()))
  let never_moved_unready = run_of(door_standing: unanswered(detail: "door unit exited"), effects: scenario_over(journal: left_at(phase: CutoverPrepared), write: none, observations: [at(target: prior)], proxied: ready()))
  let moved_unrecorded = run_of(door_standing: ready(), effects: scenario_over(journal: left_at(phase: CutoverPrepared), write: none, observations: [at(target: door), at(target: door), at(target: prior)], proxied: unanswered(detail: "HTTP 502")))
  never_moved.outcome == CutoverCommitted { repointed: true } && repoints(run: never_moved) == 1
    && route_effects(run: never_moved_unready) == 0
    && journaled(run: never_moved_unready) == [CutoverSettledRolledBack]
    && !serve_cutover_outcome_committed(outcome: never_moved_unready.outcome)
    && restores(run: moved_unrecorded) == [captured()]
    && moved_unrecorded.outcome == CutoverRolledBack { failure: CutoverProxiedPathFailed { detail: "HTTP 502" }, restoration: RestoredAndProven { prior: captured() } }
}

// INTERRUPTED DURING THE ROLLBACK. The journal says RollingBack. After the restore but before its
// proof: the route already shows the capture, so the record is settled with no further route
// effect. Before the restore landed: the route is still the door, and the restore is applied from
// the journal's capture and proven. Neither exercises the proxied path or re-points.
test fn an_interruption_during_the_rollback_finishes_the_rollback() -> Bool {
  let after_restore = run_of(door_standing: ready(), effects: scenario_over(journal: left_at(phase: CutoverRollingBack), write: none, observations: [at(target: prior)], proxied: ready()))
  let before_restore = run_of(door_standing: ready(), effects: scenario_over(journal: left_at(phase: CutoverRollingBack), write: none, observations: [at(target: door), at(target: prior)], proxied: ready()))
  after_restore.outcome == CutoverRolledBack { failure: CutoverRollbackResumed, restoration: PriorStillInPlace { prior: captured() } }
    && route_effects(run: after_restore) == 0
    && journaled(run: after_restore) == [CutoverSettledRolledBack]
    && before_restore.outcome == CutoverRolledBack { failure: CutoverRollbackResumed, restoration: RestoredAndProven { prior: captured() } }
    && restores(run: before_restore) == [captured()] && repoints(run: before_restore) == 0
    && count(filter(after_restore.steps, s => s == CutoverProxiedProbed)) == 0
    && count(filter(before_restore.steps, s => s == CutoverProxiedProbed)) == 0
}

// A COMMITTED CUTOVER IS NEVER ROLLED BACK BY A RETRY. Under a Committed record (or none) with the
// route at the door, nothing is re-pointed or restored: the proxied path answering is an
// idempotent success, and its failing is a refusal, because a settled record's capture is not
// this run's to restore.
test fn a_retry_over_a_committed_cutover_never_rolls_back() -> Bool {
  let committed = run_of(door_standing: ready(), effects: scenario_over(journal: left_at(phase: CutoverSettledCommitted), write: none, observations: [at(target: door)], proxied: ready()))
  let failing = run_of(door_standing: ready(), effects: scenario_over(journal: left_at(phase: CutoverSettledCommitted), write: none, observations: [at(target: door)], proxied: unanswered(detail: "HTTP 502")))
  let no_journal = run_of(door_standing: ready(), effects: scenario(observations: [at(target: door)], proxied: unanswered(detail: "HTTP 502")))
  committed.outcome == CutoverCommitted { repointed: false }
    && committed.steps == [CutoverObserved { observation: at(target: door) }, CutoverProxiedProbed]
    && route_effects(run: committed) == 0 && route_effects(run: failing) == 0 && route_effects(run: no_journal) == 0
    && failing.outcome == CutoverRefused { cause: CutoverAlreadyRoutedButProxiedPathFailed { detail: "HTTP 502" } }
    && no_journal.outcome == CutoverRefused { cause: CutoverAlreadyRoutedButProxiedPathFailed { detail: "HTTP 502" } }
}

// A COMMIT THE JOURNAL DID NOT RECORD IS NOT REPORTED AS A COMMIT. The route is left at the door,
// where the proxied path answers, and the record stays in flight for the next run to commit.
test fn an_unrecorded_commit_is_not_converged_and_leaves_the_route_working() -> Bool {
  let run = run_of(door_standing: ready(), effects: scenario_over(journal: left_at(phase: CutoverRepointed), write: Present { value: CutoverJournalFenced }, observations: [at(target: door)], proxied: ready()))
  route_effects(run: run) == 0
    && !serve_cutover_outcome_committed(outcome: run.outcome)
    && (match run.outcome {
      CutoverRolledBack { failure: CutoverCommitNotRecorded { detail: _ }, restoration: RouteLeftAtDoor } => true
      other => false
    })
}

// ── The transaction as the deploy runs it ───────────────────────────────────────────────────────

fn production_door_target() -> String {
  concat("unix:", dashboard_instance_tailnet_door_socket(instance: srv1_live_dashboard_instance()) as String)
}

// THE RE-POINT IS NOT IN THE BULK MUTATION. Production's mapping member contributes no apply step,
// so applying the deployment cannot redirect the route on its own; the port-routed twin still
// re-asserts its mapping there. The cutover's own effect is the one script that writes the route,
// and it names the door.
test fn the_door_route_is_written_by_the_cutover_and_not_by_the_bulk_apply() -> Bool {
  let live = deployment_spec_srv1()
  let twin = selected_deployment_spec(row: srv1_lab_desired_deployment())
  let script = deployment_serve_route_script(endpoint: live.names.tailscale_serve_endpoint, enabled: true)
  let off = deployment_serve_route_script(endpoint: live.names.tailscale_serve_endpoint, enabled: false)
  count(tailscale_serve_mapping_apply_steps(spec: live)) == 0
    && count(tailscale_serve_mapping_apply_steps(spec: twin)) == 1
    && string_contains(s: script, pattern: join(["'tailscale' 'serve' '--bg' '--https=443' '", production_door_target(), "'"], ""))
    && string_contains(s: off, pattern: "'tailscale' 'serve' '--https=443' 'off'")
    && tailscale_serve_proxy_url(endpoint: live.names.tailscale_serve_endpoint) == production_door_target()
}

// THE DEPLOY'S OWN GATE. On the production deployment with a journal that cannot be read (an
// unplaced fabric store), live_deploy_tailnet_door_cutover_gate answers NotConverged and performs
// no host effect -- the route is not observed, let alone written, when an interrupted cutover
// cannot be ruled out. With no door (the twin) the gate is the identity and reads no journal.
test fn the_deploy_gate_refuses_an_unreadable_journal_before_any_host_effect() -> Bool {
  let candidate = CandidateRelease { revision: deploy_witness_release_revision, expected_surface_identity: witness_expected_surface_identity() }
  let refused = live_deploy_tailnet_door_cutover_gate(
    spec: deployment_spec_srv1(), candidate: candidate, transport: LocalShell, access: ci_deploy_srv1_access,
    readiness: ready(), mutation: fixture_converged_mutation(), journal: FabricStorageBindingUnplaced,
  )
  let twin = live_deploy_tailnet_door_cutover_gate(
    spec: selected_deployment_spec(row: srv1_lab_desired_deployment()), candidate: candidate, transport: LocalShell, access: ci_deploy_srv1_access,
    readiness: unanswered(detail: "irrelevant"), mutation: fixture_converged_mutation(), journal: FabricStorageBindingUnplaced,
  )
  reconciliation_converged(r: twin)
    && (match refused {
      NotConverged { reason: why, applied: _ } => string_contains(s: why, pattern: "refused with no route effect") && string_contains(s: why, pattern: "journal could not be read")
      Converged { evidence: _, applied: _ } => false
    })
}

// A MUTATION THAT DID NOT CONVERGE YIELDS NO PERMIT, whatever the readiness poll said, so the gate
// can resume or roll back an interrupted cutover but can never start one.
test fn a_failed_mutation_cannot_permit_a_repoint() -> Bool {
  let failed = NotConverged { reason: "unit install failed", applied: match fixture_converged_mutation() { Converged { evidence: _, applied: intent } => intent NotConverged { reason: _, applied: intent } => intent } }
  tailnet_door_cutover_door_standing(mutation: fixture_converged_mutation(), readiness: ready()) == ready()
    && (match tailnet_door_cutover_door_standing(mutation: failed, readiness: ready()) {
      Ready { evidence: _ } => false
      Pending { cause: _ } => true
      Refused { cause: _ } => true
    })
}

// THE JOURNAL RECORD ROUND-TRIPS, capture included, and a stored record whose capture could not be
// put back does not decode -- so a run never resumes from a capture it could not restore.
test fn the_journal_record_round_trips_and_an_unrestorable_capture_does_not_decode() -> Bool {
  let with_backend = CutoverJournalRecord { route: route_name, door_target: door, release_revision: "release-a", prior: captured(), phase: CutoverRepointed }
  let with_no_route = CutoverJournalRecord { route: route_name, door_target: door, release_revision: "release-a", prior: CapturedNoRoute, phase: CutoverRollingBack }
  cutover_journal_record_of_json(text: cutover_journal_record_json(record: with_backend) as String) == Present { value: with_backend }
    && cutover_journal_record_of_json(text: cutover_journal_record_json(record: with_no_route) as String) == Present { value: with_no_route }
    && cutover_journal_record_of_json(text: "\{\"route\":\"r\",\"door_target\":\"d\",\"release\":\"x\",\"prior_target\":\"https://elsewhere.example:8443\",\"phase\":\"repointed\"\}") == none
    && cutover_journal_record_of_json(text: "\{\"route\":\"r\",\"door_target\":\"d\",\"release\":\"x\",\"prior_target\":\"\",\"phase\":\"halfway\"\}") == none
    && cutover_journal_record_of_json(text: "not-json") == none
}

// ONLY A COMMITTED CUTOVER LEAVES THE DEPLOYMENT CONVERGED, and a rollback's reason says what
// became of the route.
test fn only_a_committed_cutover_leaves_the_deployment_converged() -> Bool {
  let rolled_back = tailnet_door_cutover_reconciliation(
    mutation: fixture_converged_mutation(),
    outcome: CutoverRolledBack { failure: CutoverProxiedPathFailed { detail: "HTTP 502" }, restoration: RestoredAndProven { prior: captured() } },
  )
  reconciliation_converged(r: tailnet_door_cutover_reconciliation(mutation: fixture_converged_mutation(), outcome: CutoverCommitted { repointed: true }))
    && reconciliation_converged(r: tailnet_door_cutover_reconciliation(mutation: fixture_converged_mutation(), outcome: CutoverCommitted { repointed: false }))
    && (match rolled_back {
      NotConverged { reason: why, applied: _ } => string_contains(s: why, pattern: "HTTP 502") && string_contains(s: why, pattern: "restored to its captured backend") && string_contains(s: why, pattern: prior)
      Converged { evidence: _, applied: _ } => false
    })
}

// THE RESTORE RESTATES WHAT WAS CAPTURED. A loopback port target restates as its port and a unix
// target as itself, each round-tripping through the status form; a target of any other shape
// restates as nothing, which the restore reports rather than approximating.
test fn a_captured_target_restates_as_its_own_backend_or_not_at_all() -> Bool {
  let port_backend = tailscale_serve_backend_of_proxy_target(target: prior)
  let unix_backend = tailscale_serve_backend_of_proxy_target(target: door)
  port_backend == Present { value: "9191" as NonEmptyStr }
    && unix_backend == Present { value: door as NonEmptyStr }
    && tailscale_serve_proxy_url(endpoint: TailscaleServeEndpoint { https_port: 443, mount: ServeRootMount, backend: "9191" as NonEmptyStr }) == prior
    && tailscale_serve_backend_of_proxy_target(target: "https://elsewhere.example:8443") == none
    && tailscale_serve_backend_of_proxy_target(target: "http://127.0.0.1:not-a-port") == none
    && tailscale_serve_backend_of_proxy_target(target: "unix:") == none
}

// THE TWO READS, AS THE DEPLOY TAKES THEM: the route observation is the status document projected
// at production's route key, and the proxied path is asked for at the deployment's tailnet name
// on the default listener, at the health route.
test fn the_route_observation_and_proxied_url_are_the_deployments_own() -> Bool {
  let live = deployment_spec_srv1()
  let status = join(["\{\"Web\":\{\"srv1.example.ts.net:443\":\{\"Handlers\":\{\"/\":\{\"Proxy\":\"", production_door_target(), "\"\}\}\},\"srv1.example.ts.net:10000\":\{\"Handlers\":\{\"/\":\{\"Proxy\":\"unix:/elsewhere.sock\"\}\}\}\}\}"], "")
  serve_route_observation_of_status(status_json: status, spec: live) == at(target: production_door_target())
    && serve_route_observation_of_status(status_json: "\{\"TCP\":\{\}\}", spec: live) == ServeRouteTargets { targets: [] }
    && (match serve_route_observation_of_status(status_json: "not-json", spec: live) {
      ServeRouteUnreadable { detail: _ } => true
      ServeRouteTargets { targets: _ } => false
    })
    && (match live_deploy_proxied_health_url(spec: live) {
      Absent => false
      Present { value: url } => starts_with(s: url as String, prefix: "https://srv1.") && ends_with(s: url as String, suffix: roadmap_site_health_path) && !string_contains(s: url as String, pattern: ":443")
    })
}
