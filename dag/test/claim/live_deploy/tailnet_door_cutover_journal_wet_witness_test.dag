module test.claim.live_deploy.tailnet_door_cutover_journal_wet_witness_test

import std.types { Bool, String, NonEmptyStr }
import extdeps.shell
import gunbc.fabric_storage_client { FabricStorageLocalFiles }
import gunbc.fabric_storage_file_store { fabric_storage_file_root, fabric_storage_file_root_ensure, FabricStorageRootReady }
import gunbc.live_deploy.tailnet_door_cutover {
  CutoverBinding, CutoverJournalRecord, CapturedRestorableBackend,
  CutoverPrepared, CutoverRepointed, CutoverSettledCommitted,
  CutoverJournalAbsent, CutoverJournalPresent, CutoverJournalUnreadable,
  CutoverJournalWritten, CutoverJournalFenced, CutoverJournalWriteRefused,
}
import gunbc.live_deploy.tailnet_door_cutover_host { tailnet_door_cutover_journal_read, tailnet_door_cutover_journal_write }

// THE JOURNAL IS DURABLE AND FENCED, on a real store. A record written by one handle on the store
// is read back, capture and phase, by a fresh handle on the same files -- what a run that replaces
// an interrupted one does. A write naming the generation it read lands; a second write naming that
// same, now stale, generation is fenced by the store and changes nothing; and another route's
// journal is another slot, absent until written.
test fn the_cutover_journal_survives_its_writer_and_fences_a_stale_write() -> Bool {
  let directory = shell.Mktemp.Dir()
  let root = fabric_storage_file_root(root: directory.path)
  let passed = if !directory.success { false } else { match fabric_storage_file_root_ensure(root: root) {
    FabricStorageRootReady => {
      let store = FabricStorageLocalFiles { root: root }
      let binding = CutoverBinding { route: "fixture 443:/", door_target: "unix:/srv/fixture/tailnet-door.sock", release_revision: "release-a" }
      let other = CutoverBinding { route: "elsewhere 443:/", door_target: "unix:/srv/fixture/tailnet-door.sock", release_revision: "release-a" }
      let capture = CapturedRestorableBackend { target: "http://127.0.0.1:9191", backend: "9191" as NonEmptyStr }
      let prepared = CutoverJournalRecord { route: binding.route, door_target: binding.door_target, release_revision: binding.release_revision, prior: capture, phase: CutoverPrepared }
      let repointed = CutoverJournalRecord { route: binding.route, door_target: binding.door_target, release_revision: binding.release_revision, prior: capture, phase: CutoverRepointed }
      let committed = CutoverJournalRecord { route: binding.route, door_target: binding.door_target, release_revision: binding.release_revision, prior: capture, phase: CutoverSettledCommitted }
      let empty_first = tailnet_door_cutover_journal_read(store: store, binding: binding) == CutoverJournalAbsent
      match tailnet_door_cutover_journal_write(store: store, binding: binding, expected_generation: 0, record: prepared) {
        CutoverJournalFenced => false
        CutoverJournalWriteRefused { detail: _ } => false
        CutoverJournalWritten { generation: first_generation } => {
          let reopened = FabricStorageLocalFiles { root: fabric_storage_file_root(root: directory.path) }
          let survived = tailnet_door_cutover_journal_read(store: reopened, binding: binding) == CutoverJournalPresent { record: prepared, generation: first_generation }
          let advanced = tailnet_door_cutover_journal_write(store: reopened, binding: binding, expected_generation: first_generation, record: repointed)
          let stale = tailnet_door_cutover_journal_write(store: store, binding: binding, expected_generation: first_generation, record: committed)
          let from_absent = tailnet_door_cutover_journal_write(store: store, binding: binding, expected_generation: 0, record: committed)
          empty_first && survived
            && (match advanced {
              CutoverJournalWritten { generation: second_generation } =>
                second_generation > first_generation
                  && tailnet_door_cutover_journal_read(store: store, binding: binding) == CutoverJournalPresent { record: repointed, generation: second_generation }
              CutoverJournalFenced => false
              CutoverJournalWriteRefused { detail: _ } => false
            })
            && stale == CutoverJournalFenced
            && from_absent == CutoverJournalFenced
            && tailnet_door_cutover_journal_read(store: store, binding: other) == CutoverJournalAbsent
        }
      }
    }
    other => false
  } }
  let cleaned = shell.Remove.RecursiveForce(path: directory.path)
  passed && cleaned.success
}
