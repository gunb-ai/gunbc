module test.claim.live_deploy.provider_state_member_witness_test

import std.types { Bool, String, NonEmptyStr }
import gunbc.live_deploy.spec { deployment_directory_demands }
import gunbc.live_deploy.desired { deployment_spec_srv1, spec_owned_identities }
import gunbc.live_deploy.emit { owned_directory_apply_steps }
import gunbc.live_deploy.member_identity { DirectoryRoot, converged_effect_plan }
import gunbc.live_deploy.member_observe { deployment_member_roster }
import gunbc.owned_directory { owned_directory_path }
import gunbc.roadmap_dashboard_instance { srv1_live_dashboard_instance, dashboard_instance_provider_state_root, dashboard_instance_provider_state_directory }
import test.claim.live_deploy.apply_emission_projection { pipeline_steps_text }
import test.claim.live_deploy.deploy_release_fixture { deploy_witness_release_target, deploy_witness_spec_with_only_directory }

// THE PROVIDER-STATE ROOT IS CREATED ON THE PRODUCTION ROUTE AND READ BACK AS A MEMBER (CONVERGENCE-ONE
// C7), now as one owned-directory demand among the instance's (gunbc.roadmap_dashboard_instance
// dashboard_instance_provider_state_directory) rather than an ensured dependency of its own. The
// expected path comes from the instance's own projection, which is what the provider preflight reads.

fn srv1_provider_state_root() -> String {
  dashboard_instance_provider_state_root(instance: srv1_live_dashboard_instance()) as String
}

// THE DEMAND'S PATH IS THE PATH THE PROVIDER READS: the join between the two authorities.
test fn the_provider_state_demand_is_the_instance_provider_state_path() -> Bool {
  (owned_directory_path(t: dashboard_instance_provider_state_directory(instance: srv1_live_dashboard_instance())) as String) == srv1_provider_state_root()
    && any(deployment_directory_demands(spec: deployment_spec_srv1()), t => (owned_directory_path(t: t) as String) == srv1_provider_state_root())
}

// THE PRODUCTION APPLY EMITS ITS INSTALL when the plan makes no claim about it.
test fn the_production_apply_emits_the_provider_state_install() -> Bool {
  let spec = deployment_spec_srv1()
  string_contains(
    s: pipeline_steps_text(steps: owned_directory_apply_steps(spec: deploy_witness_spec_with_only_directory(spec: spec, path: srv1_provider_state_root()), plan: converged_effect_plan(roster: [], target: deploy_witness_release_target(spec: spec)))),
    pattern: srv1_provider_state_root(),
  )
}

// The same directory is read back as a member, so a host whose provider login has nowhere to write
// reports a member to create rather than a converged host.
test fn the_provider_state_root_is_a_read_back_directory_member() -> Bool {
  any(deployment_member_roster(spec: deployment_spec_srv1()), m => match m {
    DirectoryRoot { path } => (path as String) == srv1_provider_state_root()
    _ => false
  })
}

// Retract never tears down the provider login: no owned step names it.
test fn retract_never_owns_the_provider_state_root() -> Bool {
  !any(spec_owned_identities(spec: deployment_spec_srv1()), id => string_contains(s: id, pattern: srv1_provider_state_root()))
}
