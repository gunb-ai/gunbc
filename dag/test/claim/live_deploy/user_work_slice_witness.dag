    SliceControlRefused { cause: _ } => true
    SliceControlNotOwed => false
    SliceControlDerived { caps: _ } => false
  }
}

// THE ONE CHECK, row by row: a process whose cgroup chain carries a binding memory.max and forbids
// swap is bounded whatever its unit is called; no binding limit, swap allowed everywhere, zero, or no
// reading never admits -- and all of them refuse through the one located cause. Levels and swap values
// are parsed by extdeps.linux.cgroup_v2_memory's own parser.
fn bound_standing(levels: List<CgroupMemoryLevel>, swap: List<String>) -> String {
  user_work_scope_standing_wire(s: user_work_scope_standing(unit_test: false, github_actions: false,
    cgroup: CgroupText { text: "0::/system.slice/gunbc-revision-job.service" },
    bound: CgroupChainRead { levels: levels, swap_max: map(swap, w => parse_cgroup_memory_limit(body: w)) },
    user_manager_reachable: false, xdg_runtime_dir: false
  ))
}

test fn a_binding_memory_max_with_swap_forbidden_bounds_the_process_whatever_its_unit_is_called() -> Bool {
  string_contains(s: bound_standing(levels: [level_at(dir: "/sys/fs/cgroup/system.slice/gunbc-revision-job.service", max: "21474836480"), level_at(dir: "/sys/fs/cgroup/system.slice", max: "max")], swap: ["0", "max"]), pattern: "ExemptUnderObservedBound:unmodeled-system-unit:system.slice:gunbc-revision-job.service:")
    && string_contains(s: bound_standing(levels: [level_at(dir: "/sys/fs/cgroup/system.slice/gunbc-revision-job.service", max: "21474836480"), level_at(dir: "/sys/fs/cgroup/system.slice", max: "max")], swap: ["0", "max"]), pattern: ":21474836480")
    && string_contains(s: bound_standing(levels: [level_at(dir: "/sys/fs/cgroup/system.slice/x.service", max: "max"), level_at(dir: "/sys/fs/cgroup/system.slice", max: "8589934592")], swap: ["max", "0"]), pattern: ":8589934592")
}

test fn unbounded_or_swap_allowed_or_unread_chains_refuse() -> Bool {
  string_contains(s: bound_standing(levels: [level_at(dir: "/sys/fs/cgroup/system.slice/x.service", max: "max")], swap: ["0"]), pattern: "UncappedEnclosingCgroup:unmodeled-system-unit:system.slice:gunbc-revision-job.service @ 0::/system.slice/gunbc-revision-job.service: no finite memory.max")
    && string_contains(s: bound_standing(levels: [level_at(dir: "/sys/fs/cgroup/system.slice/x.service", max: "21474836480")], swap: ["max"]), pattern: "is not binding: no level on the chain sets memory.swap.max to 0")
    && string_contains(s: bound_standing(levels: [], swap: []), pattern: "no finite memory.max")
    && string_contains(s: bound_standing(levels: [level_at(dir: "/sys/fs/cgroup/system.slice/x.service", max: "0")], swap: ["0"]), pattern: "memory.max is 0 at /sys/fs/cgroup/system.slice/x.service, which systemd reads as no limit")
    && string_contains(s: bound_standing(levels: [level_at(dir: "/sys/fs/cgroup/system.slice/x.service", max: "21474836480"), level_at(dir: "/sys/fs/cgroup/system.slice", max: "0")], swap: ["0", "max"]), pattern: "memory.max is 0 at /sys/fs/cgroup/system.slice,")
    && string_contains(s: user_work_scope_standing_wire(s: user_work_scope_standing(unit_test: false, github_actions: false,
         cgroup: CgroupText { text: "0::/system.slice/x.service" }, bound: CgroupChainUnread { detail: "unreadable" },
         user_manager_reachable: false, xdg_runtime_dir: false
  )), pattern: "memory.max unreadable: unreadable; no level of the chain yielded a reading")
}

test fn wrap_keeps_the_tighter_of_caller_and_slice() -> Bool {
  match user_work_pool_slots() {
    UserWorkPoolSlotsDerived { slots } => {
      let slice_max = user_work_slice_memory_max_of(slots: slots)
      let caller_max = byte_size(8589934592)
      let slice = UserWorkSliceInstalled { memory_max: slice_max, memory_high: MemoryUnbounded }
      let caller = CallerEnvelopeObserved { memory_max: MemoryCapped { bytes: caller_max }, memory_high: MemoryUnbounded }
      byte_size_count(b: slice_max) > byte_size_count(b: caller_max)
        && has_property(
          props: user_work_wrap_ready_properties(slice: slice, caller: caller),
          needle: join(["MemoryMax=", to_string(byte_size_count(b: caller_max))], ""),
        )
        && has_property(
          props: user_work_wrap_envelope_properties(memory_max: caller_max, memory_high: MemoryUnbounded),
          needle: join(["MemoryMax=", to_string(byte_size_count(b: caller_max))], ""),
        )
    }
  }
}

