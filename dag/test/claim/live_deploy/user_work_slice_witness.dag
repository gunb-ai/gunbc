test fn the_gunbc_test_user_work_scope_is_the_declared_wrap() -> Bool {
  match gunbc_test_user_work_scope_command(label: "//gunbc/instruments:self-host") {
    SystemdRunCommandRefused { cause: _ } => false
    SystemdRunCommandReady { command } =>
      slice_hits(words: argv_words(command: command)) == 1
        && any(argv_words(command: command), w => w == "--user")
        && any(argv_words(command: command), w => w == "--scope")
        && any(argv_words(command: command), w => w == "test")
  }
}

test fn host_converge_backstop_knobs_name_user_at_service_uid() -> Bool {
  match user_manager_backstop_for(host: operator_host_srv1) {
    UserManagerBackstopNotOwed => false
    UserManagerBackstopRefused { cause: _ } => false
    UserManagerBackstopDerived { knobs } =>
      knobs.length() == 2
        && string_contains(s: user_manager_instance_unit(), pattern: "user@1000.service")
        && any(knobs, k => k.name == "user_manager_memory_max_bytes")
        && any(knobs, k => k.name == "user_manager_memory_swap_max_bytes")
  }
}

test fn user_manager_backstop_is_owed_only_on_the_placed_host() -> Bool {
  match user_manager_backstop_for(host: operator_host_srv1) {
    UserManagerBackstopDerived { knobs } =>
      knobs.length() == 2
        && match user_manager_backstop_for(host: operator_host_srv3) {
          UserManagerBackstopNotOwed => true
          UserManagerBackstopDerived { knobs: _ } => false
          UserManagerBackstopRefused { cause: _ } => false
        }
    UserManagerBackstopNotOwed => false
    UserManagerBackstopRefused { cause: _ } => false
  }
}

test fn approval_broker_runtime_caps_are_the_model_14_16_on_the_placed_host() -> Bool {
  match approval_broker_runtime_caps_for(host: operator_host_srv1) {
    ApprovalBrokerRuntimeCapsNotOwed => false
    ApprovalBrokerRuntimeCapsRefused { cause: _ } => false
    ApprovalBrokerRuntimeCapsDerived { knobs } =>
      any(knobs, k => k.name == "approval_broker_memory_max_bytes" && k.desired == to_string(byte_size_count(b: approval_broker_slice_memory_max)))
        && any(knobs, k => k.name == "approval_broker_memory_high_bytes" && k.desired == to_string(byte_size_count(b: approval_broker_slice_memory_high)))
        && match approval_broker_runtime_caps_for(host: operator_host_srv3) {
          ApprovalBrokerRuntimeCapsNotOwed => true
          ApprovalBrokerRuntimeCapsDerived { knobs: _ } => false
          ApprovalBrokerRuntimeCapsRefused { cause: _ } => false
        }
  }
}

test fn slice_control_caps_include_sessions_and_broker_on_srv1_only() -> Bool {
  match slice_control_caps_for(host: operator_host_srv1) {
    SliceControlNotOwed => false
    SliceControlRefused { cause: _ } => false
    SliceControlDerived { caps } =>
      non_empty_to_list(xs: caps).length() == 2
        && any(non_empty_to_list(xs: caps), c => c.unit as String == "sessions.slice" && byte_size_count(b: c.memory_max) == 137438953472)
        && any(non_empty_to_list(xs: caps), c => c.unit as String == "gunbc-approval-broker.slice" && byte_size_count(b: c.memory_max) == 17179869184 && byte_size_count(b: c.memory_high) == 15032385536)
        && match slice_control_caps_for(host: operator_host_srv3) {
          SliceControlNotOwed => true
          SliceControlDerived { caps: _ } => false
          SliceControlRefused { cause: _ } => false
        }
  }
}

test fn slice_control_refuses_when_session_reservation_is_unestablished() -> Bool {
  match slice_control_caps_for(host: operator_host_srv2) {
    SliceControlRefused { cause: _ } => true
    SliceControlNotOwed => false
    SliceControlDerived { caps: _ } => false
  }
}

// THE OBSERVED-BOUND ARM: a process whose cgroup chain carries a binding memory.max and forbids swap
// is bounded whatever its unit is called; no binding limit, swap allowed everywhere, or no reading
// never admits. Levels and swap values are parsed by extdeps.linux.cgroup_v2_memory's own parser.
fn level(dir: NonEmptyStr, max: String) -> CgroupMemoryLevel {
  CgroupMemoryLevelRead { dir: dir, max: parse_cgroup_memory_limit(body: max), high: CgroupMemoryUnlimited }
}

fn bound_standing(levels: List<CgroupMemoryLevel>, swap: List<String>) -> String {
  user_work_scope_standing_wire(s: user_work_scope_standing(unit_test: false, github_actions: false,
    cgroup: CgroupText { text: "0::/system.slice/gunbc-revision-job.service" },
    bound: CgroupChainRead { levels: levels, swap_max: map(swap, w => parse_cgroup_memory_limit(body: w)) },
    user_manager_reachable: false, xdg_runtime_dir: false, slice_memory: RootMemoryUnreadable
  ))
}

test fn a_binding_memory_max_with_swap_forbidden_bounds_the_process_whatever_its_unit_is_called() -> Bool {
  bound_standing(levels: [level(dir: "/sys/fs/cgroup/system.slice/gunbc-revision-job.service", max: "21474836480"), level(dir: "/sys/fs/cgroup/system.slice", max: "max")], swap: ["0", "max"]) == "BoundedByObservedCgroup"
    && bound_standing(levels: [level(dir: "/sys/fs/cgroup/system.slice/x.service", max: "max"), level(dir: "/sys/fs/cgroup/system.slice", max: "8589934592")], swap: ["max", "0"]) == "BoundedByObservedCgroup"
}

test fn unbounded_or_swap_allowed_or_unread_chains_refuse() -> Bool {
  bound_standing(levels: [level(dir: "/sys/fs/cgroup/system.slice/x.service", max: "max")], swap: ["0"]) == "UncappedSystemSlice:system.slice:gunbc-revision-job.service"
    && bound_standing(levels: [level(dir: "/sys/fs/cgroup/system.slice/x.service", max: "21474836480")], swap: ["max"]) == "UncappedSystemSlice:system.slice:gunbc-revision-job.service"
    && bound_standing(levels: [], swap: []) == "UncappedSystemSlice:system.slice:gunbc-revision-job.service"
    && bound_standing(levels: [level(dir: "/sys/fs/cgroup/system.slice/x.service", max: "0")], swap: ["0"]) == "UncappedSystemSlice:system.slice:gunbc-revision-job.service"
    && bound_standing(levels: [level(dir: "/sys/fs/cgroup/system.slice/x.service", max: "21474836480"), level(dir: "/sys/fs/cgroup/system.slice", max: "0")], swap: ["0", "max"]) == "UncappedSystemSlice:system.slice:gunbc-revision-job.service"
    && user_work_scope_standing_wire(s: user_work_scope_standing(unit_test: false, github_actions: false,
         cgroup: CgroupText { text: "0::/system.slice/x.service" }, bound: CgroupChainUnread { detail: "unreadable" },
         user_manager_reachable: false, xdg_runtime_dir: false, slice_memory: RootMemoryUnreadable
  )) == "UncappedSystemSlice:system.slice:x.service"
}

test fn wrap_keeps_the_tighter_of_caller_and_slice() -> Bool {
  match user_work_pool_slots() {
    UserWorkPoolSlotsDerived { slots } => {
      let slice_max = user_work_slice_memory_max_of(slots: slots)
      let caller_max = byte_size(8589934592)
      let slice = UserWorkSliceInstalled { memory_max: slice_max, memory_high: MemoryUnbounded }
      let caller = CallerEnvelopeObserved { memory_max: MemoryCapped { bytes: caller_max }, memory_high: MemoryUnbounded }
      byte_size_count(b: slice_max) > byte_size_count(b: caller_max)
        && has_property(
          props: user_work_wrap_ready_properties(slice: slice, caller: caller),
          needle: join(["MemoryMax=", to_string(byte_size_count(b: caller_max))], ""),
        )
        && has_property(
          props: user_work_wrap_envelope_properties(memory_max: caller_max, memory_high: MemoryUnbounded),
          needle: join(["MemoryMax=", to_string(byte_size_count(b: caller_max))], ""),
        )
    }
  }
}

test fn absent_slice_refuses_wrap() -> Bool {
  let caller = CallerEnvelopeObserved { memory_max: MemoryUnbounded, memory_high: MemoryUnbounded }
  match user_work_scope_standing_for_wrap(standing: UserManagerOwed, slice: UserWorkSliceNotInstalled, caller: caller) {
    UserWorkSliceAbsent =>
      match user_work_scope_standing_effect(s: UserWorkSliceAbsent) {
        RefuseUserWorkScope { standing: UserWorkSliceAbsent } => true
        _ => false
      }
    _ => false
  }
}

test fn uncapped_slice_refuses_wrap() -> Bool {
  let caller = CallerEnvelopeObserved { memory_max: MemoryUnbounded, memory_high: MemoryUnbounded }
  match user_work_scope_standing_for_wrap(standing: UserManagerOwed, slice: UserWorkSliceUncappedInstall, caller: caller) {
    UserWorkSliceUncapped =>
      match user_work_scope_standing_effect(s: UserWorkSliceUncapped) {
        RefuseUserWorkScope { standing: UserWorkSliceUncapped } => true
        _ => false
      }
    _ => false
  }
}

test fn installed_capped_slice_admits_wrap() -> Bool {
  match user_work_pool_slots() {
    UserWorkPoolSlotsDerived { slots } => {
      let slice_max = user_work_slice_memory_max_of(slots: slots)
      let slice = UserWorkSliceInstalled { memory_max: slice_max, memory_high: MemoryUnbounded }
      let caller = CallerEnvelopeObserved { memory_max: MemoryUnbounded, memory_high: MemoryUnbounded }
      match user_work_scope_standing_for_wrap(standing: UserManagerOwed, slice: slice, caller: caller) {
        UserManagerOwed =>
          has_property(
            props: user_work_wrap_ready_properties(slice: slice, caller: caller),
            needle: join(["MemoryMax=", to_string(byte_size_count(b: slice_max))], ""),
          )
        _ => false
      }
    }
  }
}

test fn skip_standings_ignore_a_missing_user_work_slice() -> Bool {
  let caller = CallerEnvelopeReadFailed
  let slice = UserWorkSliceNotInstalled
  match user_work_scope_standing_for_wrap(standing: AlreadyInSlice, slice: slice, caller: caller) {
    AlreadyInSlice =>
      match user_work_scope_standing_for_wrap(standing: RunnerSlotExempt, slice: slice, caller: caller) {
        RunnerSlotExempt =>
          match user_work_scope_standing_for_wrap(standing: CiExempt, slice: slice, caller: caller) {
            CiExempt =>
              match user_work_scope_standing_effect(s: AlreadyInSlice) {
                SkipUserWorkScope { standing: AlreadyInSlice } =>
                  match user_work_scope_standing_effect(s: RunnerSlotExempt) {
                    SkipUserWorkScope { standing: RunnerSlotExempt } =>
                      match user_work_scope_standing_effect(s: CiExempt) {
                        SkipUserWorkScope { standing: CiExempt } => true
                        _ => false
                      }
                    _ => false
                  }
                _ => false
              }
            _ => false
          }
        _ => false
      }
    _ => false
  }
}

// THE COMPOSED ENTRY DECIDES A MODELED SYSTEM SLICE FROM ITS LIVE READING. Under a systemd manager the
// composed entry reaches the modeled-slice arm; a finite slice memory.max exempts and an unbounded one
// refuses. Before slice_memory was a parameter this entry always supplied an unreadable reading, so the
// finite case could not yield ExemptSystemUnit (review 80620).
fn composed_modeled_slice_standing(slice_memory: RootCgroupMemoryRead) -> UserWorkScopeStanding {
  user_work_scope_standing_with_root_memory(
    unit_test: false,
    github_actions: false,
    cgroup: CgroupText {
      text: join([
        "0::/",
        gunbc_repository_convergence_slice_unit_name as String,
        "/",
        gunbc_tree_sync_unit_name as String,
      ], ""),
    }, bound: CgroupChainUnread { detail: "fixture" },
    systemd_manager_present: true,
    user_manager_reachable: false,
    xdg_runtime_dir: false,
    root_memory: RootMemoryUnreadable,
    slice_memory: slice_memory,
    buildbuddy_run_id: BuildBuddyRunIdAbsent,
  )
}

test fn the_composed_entry_exempts_a_modeled_slice_with_a_finite_live_cap() -> Bool {
  user_work_scope_standing_wire(s: composed_modeled_slice_standing(slice_memory: RootMemoryCapped { bytes: byte_size(25769803776) }))
    == "ExemptSystemUnit:gunbc-repository-convergence.slice:gunbc-tree-sync.service:25769803776"
}

test fn the_composed_entry_refuses_a_modeled_slice_with_an_unbounded_live_cap() -> Bool {
  user_work_scope_standing_wire(s: composed_modeled_slice_standing(slice_memory: RootMemoryUnbounded))
    == "UncappedSystemSlice:gunbc-repository-convergence.slice:gunbc-tree-sync.service"
}

// ── FCI-1 CONTROL SLICE (gunbc.live_deploy.slice_bounds fci1_controls_slice_unit_name) ──
// The same step is observed in three places. Only the declared slice with a live finite memory.max
// admits; the identical step in system.slice, in a slice that is not a declared row, or in the
// declared slice with no live finite cap refuses UncappedSystemSlice. Standing is a function of the
// modeled row AND the supplied memory.max reading, never of the name alone.
data fci1_witness_control_unit: NonEmptyStr = "fci1-bounded-driver.service"

fn fci1_control_standing(path: String, slice_memory: RootCgroupMemoryRead) -> UserWorkScopeStanding {
  user_work_scope_standing_with_root_memory(
    unit_test: false,
    github_actions: false,
    cgroup: CgroupText { text: join(["0::/", path], "") },
    bound: CgroupChainUnread { detail: "fixture" },
    systemd_manager_present: true,
    user_manager_reachable: false,
    xdg_runtime_dir: false,
    root_memory: RootMemoryUnreadable,
    slice_memory: slice_memory,
    buildbuddy_run_id: BuildBuddyRunIdAbsent,
  )
}

fn fci1_declared_slice_path() -> String {
  join([fci1_controls_slice_unit_name as String, "/", fci1_witness_control_unit as String], "")
}

fn fci1_declared_slice_cap() -> RootCgroupMemoryRead {
  RootMemoryCapped { bytes: fci1_controls_slice_memory_max() }
}

test fn fci1_control_in_the_declared_capped_slice_is_exempt() -> Bool {
  user_work_scope_standing_wire(s: fci1_control_standing(path: fci1_declared_slice_path(), slice_memory: fci1_declared_slice_cap()))
    == join(["ExemptSystemUnit:", fci1_controls_slice_unit_name as String, ":", fci1_witness_control_unit as String, ":", to_string(byte_size_count(b: fci1_controls_slice_memory_max()))], "")
}

test fn fci1_control_in_the_declared_slice_without_a_finite_cap_refuses() -> Bool {
  user_work_scope_standing_wire(s: fci1_control_standing(path: fci1_declared_slice_path(), slice_memory: RootMemoryUnbounded))
    == join(["UncappedSystemSlice:", fci1_controls_slice_unit_name as String, ":", fci1_witness_control_unit as String], "")
    && user_work_scope_standing_wire(s: fci1_control_standing(path: fci1_declared_slice_path(), slice_memory: RootMemoryUnreadable))
      == join(["UncappedSystemSlice:", fci1_controls_slice_unit_name as String, ":", fci1_witness_control_unit as String], "")
}

test fn fci1_control_in_system_slice_refuses_even_with_a_finite_reading() -> Bool {
  user_work_scope_standing_wire(s: fci1_control_standing(path: join(["system.slice/", fci1_witness_control_unit as String], ""), slice_memory: fci1_declared_slice_cap()))
    == join(["UncappedSystemSlice:system.slice:", fci1_witness_control_unit as String], "")
}

test fn fci1_control_in_an_undeclared_slice_of_the_same_shape_refuses() -> Bool {
  user_work_scope_standing_wire(s: fci1_control_standing(path: join(["gunbc-fci1-other.slice/", fci1_witness_control_unit as String], ""), slice_memory: fci1_declared_slice_cap()))
    == join(["UncappedSystemSlice:gunbc-fci1-other.slice:", fci1_witness_control_unit as String], "")
}

// JOIN row <-> envelope: the slice cap is the FCI-1 context's own memory_max/high, so a bounded child
// unit inside it (same MemoryMax) is never wider than its slice.
test fn fci1_control_slice_row_equals_the_fci1_envelope() -> Bool {
  match fci1_bounded_execution_context(checkout_root: ".") {
    Fci1BoundedExecutionContextBuilt { context: c } =>
      finite_byte_size_count(size: c.memory_max) == byte_size_count(b: fci1_controls_slice_memory_max())
        && match c.memory_high {
          Present { value: h } => finite_byte_size_count(size: h) == byte_size_count(b: fci1_controls_slice_memory_high())
          Absent => false
        }
        && any(declared_system_slice_memory_maxes(), r => (r.unit as String) == (fci1_controls_slice_unit_name as String))
    _ => false
  }
}

test fn fci1_control_slice_unit_file_is_emitted_from_the_row() -> Bool {
  let t = fci1_controls_slice_unit_text()
  string_contains(s: t, pattern: "[Slice]")
    && string_contains(s: t, pattern: join(["MemoryMax=", to_string(byte_size_count(b: fci1_controls_slice_memory_max()))], ""))
    && string_contains(s: t, pattern: join(["MemoryHigh=", to_string(byte_size_count(b: fci1_controls_slice_memory_high()))], ""))
    && string_contains(s: t, pattern: join(["MemorySwapMax=", to_string(byte_size_count(b: fci1_controls_slice_memory_swap_max))], ""))
    && string_contains(s: fci1_controls_slice_unit_path(), pattern: join(["/run/systemd/system/", fci1_controls_slice_unit_name as String], ""))
}

// INHABITANCE (DESIGN section 3 pairing): the real producer of the `.env` wrappers names the slice in
// exactly the bounded wrappers, and the unbounded control wrapper stays outside it, so its refusal is
// the wrap policy's UncappedSystemSlice rather than an absent control.
test fn fci1_bounded_wrappers_carry_the_slice_and_the_unbounded_control_does_not() -> Bool {
  match expected_fci1_bounded_execution_context_env() {
    Fci1BoundedExecutionContextEmitted { content: c } => {
      let slice_line = join(["--property=\"Slice=", fci1_controls_slice_unit_name as String, "\" \\\n"], "")
      string_contains(s: c, pattern: slice_line)
        && string_contains(s: c, pattern: "fci1_run_unbounded_memory_control() {\n  local unit=$1 checkout_root=$2; shift 2\n  systemd-run --quiet --wait --pipe --collect --unit=\"$unit\" \\\n    --property=\"WorkingDirectory=$checkout_root\" \\\n    --property=\"MemoryMax=infinity\"")
        && string_contains(s: c, pattern: "fci1_install_controls_slice()")
        && string_contains(s: c, pattern: "fci1_remove_controls_slice()")
    }
    _ => false
  }
}

// The scripts source the COMMITTED file, so the claim reads it: the committed bytes must equal the
// producer's, which carries the slice in the bounded wrappers, the install/remove functions, and no
// slice in the unbounded control.
test fn the_committed_fci1_env_equals_the_emitter_output() -> Bool {
  match expected_fci1_bounded_execution_context_env() {
    Fci1BoundedExecutionContextEmitted { content: c } =>
      filesystem_read(path: "tools/fabric_ci_fci1_bounded_execution_context.env").content == c
    _ => false
  }
}

// A control that greps a unit's output reads what `systemd-run --pipe` forwards: without it a
// `--wait` unit writes to the journal and the redirected file is empty, so a RED row (wrong cwd)
// can never name its refusal. Every emitted runner carries it; none is left on the journal-only form.
test fn every_emitted_fci1_runner_pipes_the_unit_output_to_the_caller() -> Bool {
  match expected_fci1_bounded_execution_context_env() {
    Fci1BoundedExecutionContextEmitted { content: c } =>
      string_contains(s: c, pattern: "fci1_run_bounded_driver() {\n  local checkout_root=$1; shift\n  systemd-run --quiet --wait --pipe --collect")
        && string_contains(s: c, pattern: "fci1_run_bounded_submitter() {\n  local unit=$1 checkout_root=$2; shift 2\n  systemd-run --quiet --wait --pipe --collect")
        && string_contains(s: c, pattern: "fci1_run_bounded_dependent_submitter() {\n  local unit=$1 checkout_root=$2 runtime_directory=$3; shift 3\n  systemd-run --quiet --wait --pipe --collect")
        && string_contains(s: c, pattern: "fci1_run_unbounded_memory_control() {\n  local unit=$1 checkout_root=$2; shift 2\n  systemd-run --quiet --wait --pipe --collect")
        && !string_contains(s: c, pattern: "--wait --collect")
    _ => false
  }
}

// THE SEED'S LIST IS THE DECLARED ROWS, IN BOTH DIRECTIONS. `RECOGNIZED_SYSTEM_SLICES` in the
// hand-retained seed (a declared seed-retained row of v2.compiler.self_host.seed_retention_frontier,
// so no stage0 regen rewrites it) must equal the capped rows of `declared_system_slice_memory_maxes`
// followed by the sessions slice, byte for byte. The older mirror claim checks that each declared
// capped unit appears in the seed; this one also refuses a seed literal no row declares, and any
// reordering, so the two sources cannot drift apart in either direction.
test fn the_seed_slice_list_equals_the_declared_capped_rows_plus_sessions() -> Bool {
  let seed = filesystem_read(path: seed_user_work_scope_path).content
  let capped = declared_system_slice_memory_maxes() |> filter(row => byte_size_count(b: row.memory_max) > 0)
  let rendered = join(
    concat(
      map(capped, row => join(["    \"", row.unit as String, "\",\n"], "")),
      [join(["    \"", gunbc_oomd_sessions_slice as String, "\",\n"], "")],
    ),
    "",
  )
  string_contains(s: seed, pattern: join(["const RECOGNIZED_SYSTEM_SLICES: &[&str] = &[\n", rendered, "];"], ""))
}

// A host without cgroups: only an operator's terminal run outside CI is admitted, and it skips the
// wrap with its wire; a non-terminal or CI run there refuses; a cgroup host is not classified here.
test fn a_host_without_cgroups_admits_only_an_operator_terminal_run() -> Bool {
  let admitted = match user_work_host_facility_standing(host: HostWithoutCgroups { stdin_terminal: true }, github_actions: false) {
    Present { value: s } => match user_work_scope_standing_effect(s: s) {
      SkipUserWorkScope { standing: _ } => user_work_scope_standing_wire(s: s) == "OperatorHostWithoutCgroups:no memory bound on this host"
      _ => false
    }
    Absent => false
  }
  let refused_without_terminal = match user_work_host_facility_standing(host: HostWithoutCgroups { stdin_terminal: false }, github_actions: false) {
    Present { value: s } => match user_work_scope_standing_effect(s: s) { RefuseUserWorkScope { standing: _ } => true  _ => false }
    Absent => false
  }
  let refused_in_ci = match user_work_host_facility_standing(host: HostWithoutCgroups { stdin_terminal: true }, github_actions: true) {
    Present { value: s } => match user_work_scope_standing_effect(s: s) { RefuseUserWorkScope { standing: _ } => true  _ => false }
    Absent => false
  }
  let cgroup_host_unclassified = match user_work_host_facility_standing(host: HostWithCgroups, github_actions: false) { Absent => true  Present { value: _ } => false }
  admitted && refused_without_terminal && refused_in_ci && cgroup_host_unclassified
}
