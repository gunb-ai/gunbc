}

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree
data seed_user_work_scope_path: String = "src/v1/stage0/src/cli_run/user_work_scope.rs"

fn property_words(props: List<SystemdRunProperty>) -> List<String> {
  props |> map(p => concat(systemd_unit_property_wire(property: p.property) as String, concat("=", p.value as String)))
}

fn has_property(props: List<SystemdRunProperty>, needle: String) -> Bool {
  any(property_words(props: props), p => string_contains(s: p, pattern: needle))
}

fn slice_needle() -> String {
  join(["Slice=", user_work_slice_unit_name as String], "")
}

fn slice_hits(words: List<String>) -> Int {
  filter(words, w => string_contains(s: w, pattern: slice_needle())).length()
}

test fn user_work_slice_max_is_pool_slots_times_the_runner_ceiling() -> Bool {
  match user_work_pool_slots() {
    UserWorkPoolSlotsDerived { slots } =>
      slots == user_work_charged_slots
        && byte_size_count(b: user_work_slice_memory_max_of(slots: slots))
          == byte_size_count(b: gunbc_runner_slot_desired().memory_max) * 2
        && byte_size_count(b: user_work_charged_in_served_allowance())
          == byte_size_count(b: user_work_slice_memory_max_of(slots: slots))
  }
}

test fn user_work_slice_high_is_one_gib_under_max() -> Bool {
  match user_work_pool_slots() {
    UserWorkPoolSlotsDerived { slots } => {
      let max = user_work_slice_memory_max_of(slots: slots)
      match user_work_slice_memory_high_of(memory_max: max) {
        UserWorkSliceHighGapExceedsMax => false
        UserWorkSliceHighDerived { bytes: high } =>
          byte_size_count(b: high) + 1073741824 == byte_size_count(b: max)
      }
    }
  }
}

test fn a_max_below_the_high_gap_refuses_rather_than_writing_zero() -> Bool {
  match user_work_slice_memory_high_of(memory_max: byte_size(0)) {
    UserWorkSliceHighGapExceedsMax => true
    UserWorkSliceHighDerived { bytes: _ } => false
  }
}

test fn user_manager_backstop_is_work_slice_plus_remainder() -> Bool {
  match user_work_pool_slots() {
    UserWorkPoolSlotsDerived { slots } => {
      let work = user_work_slice_memory_max_of(slots: slots)
      byte_size_count(b: user_slice_backstop_memory_max_of(work_slice_max: work))
        == byte_size_count(b: work) + byte_size_count(b: user_manager_remainder)
    }
  }
}

test fn the_grant_launch_binds_the_declared_slice_once() -> Bool {
  let props = compute_grant_unit_properties(granted: kibibyte(count: 1024), working_directory: "/wt", process_bounds: none)
  !has_property(props: props, needle: slice_needle())
    && has_property(props: props, needle: "MemoryMax=1048576")
    && match gunbc_user_work_wait_command(unit: "gunbc-compute-t" as NonEmptyStr, properties: props, setenv_bindings: [], command_argv: ["true"]) {
      SystemdSummaryPrintingWaitRefused { cause: _ } => false
      SystemdSummaryPrintingWaitReady { wait } =>
        slice_hits(words: systemd_summary_printing_wait_argv(w: wait)) == 1
          && filter(systemd_summary_printing_wait_argv(w: wait), w => string_contains(s: w, pattern: "MemorySwapMax=0")).length() == 1
    }
}

test fn the_reviewer_launch_binds_the_declared_slice_once() -> Bool {
  let inst = srv2_deploy_dashboard_instance()
  let props = dispatch_review_unit_properties(instance: inst, working_directory: inst.repo_root as String, log_path: "/r/log", review_dir: "/state/a/review", exit_hook: none)
  !has_property(props: props, needle: slice_needle())
    && match gunbc_user_work_transient_command(unit: "gunbc-review-t.service" as NonEmptyStr, properties: props, setenv_bindings: [], command_argv: ["true"]) {
      SystemdRunCommandRefused { cause: _ } => false
      SystemdRunCommandReady { command } =>
        slice_hits(words: argv_words(command: command)) == 1
          && filter(argv_words(command: command), w => string_contains(s: w, pattern: "MemorySwapMax=0")).length() == 1
    }
}

test fn the_ad_hoc_scope_wrap_injects_the_slice_the_raw_builder_omits() -> Bool {
  let raw_ok = match systemd_run_user_scope_command(properties: [], command_argv: ["true"]) {
    SystemdRunCommandRefused { cause: _ } => false
    SystemdRunCommandReady { command } =>
      !any(argv_words(command: command), w => string_contains(s: w, pattern: "Slice="))
  }
  match gunbc_user_work_scope_command(properties: [], command_argv: ["gunbc", "test", "//x"]) {
    SystemdRunCommandRefused { cause: _ } => false
    SystemdRunCommandReady { command } =>
      raw_ok
        && slice_hits(words: argv_words(command: command)) == 1
        && filter(argv_words(command: command), w => string_contains(s: w, pattern: "MemorySwapMax=0")).length() == 1
        && any(argv_words(command: command), w => w == "--user")
        && any(argv_words(command: command), w => w == "--scope")
  }
}

test fn the_seed_trampoline_mirrors_the_declared_wrap_prefix() -> Bool {
  let seed = filesystem_read(path: seed_user_work_scope_path).content
  let prefix = user_work_scope_wrap_prefix_argv()
  let swap_word = join(["--property=MemorySwapMax=", to_string(byte_size_count(b: user_work_slice_memory_swap_max))], "")
  let slice_word = join(["--property=Slice=", user_work_slice_unit_name as String], "")
  prefix.length() > 0
    && any(prefix, w => w == "systemd-run")
    && any(prefix, w => w == "--user")
    && any(prefix, w => w == "--scope")
    && any(prefix, w => w == slice_word)
    && any(prefix, w => w == swap_word)
    && string_contains(s: seed, pattern: "SEED MIRROR of `gunbc.live_deploy.slice_bounds user_work_slice_unit_name`")
    && string_contains(s: seed, pattern: "SEED MIRROR of `gunbc.live_deploy.slice_bounds user_work_slice_memory_swap_max`")
    && string_contains(s: seed, pattern: concat("\"", concat(user_work_slice_unit_name as String, "\"")))
    && string_contains(
      s: seed,
      pattern: concat(
        "const USER_WORK_SLICE_MEMORY_SWAP_MAX_BYTES: u64 = ",
        concat(to_string(byte_size_count(b: user_work_slice_memory_swap_max)), ";"),
      ),
    )
    && string_contains(s: seed, pattern: "CgroupUnreadable")
    && string_contains(s: seed, pattern: "UserManagerProbeFailed")
    && string_contains(s: seed, pattern: "std::process::exit(2)")
    && string_contains(s: seed, pattern: "--property=MemoryMax=")
    && string_contains(s: seed, pattern: "--property=MemoryHigh=")
    && string_contains(s: seed, pattern: "UserWorkSliceAbsent")
    && string_contains(s: seed, pattern: "SEED MIRROR of `gunbc.compute.unit_bounds user_work_scope_standing_for_wrap`")
}

test fn user_work_scope_standing_selects_from_supplied_observations() -> Bool {
  match user_work_scope_standing(unit_test: true, github_actions: true, cgroup: CgroupReadFailed, user_manager_reachable: true, xdg_runtime_dir: true) {
    UnitTestExempt =>
      match user_work_scope_standing(unit_test: false, github_actions: true, cgroup: CgroupReadFailed, user_manager_reachable: true, xdg_runtime_dir: true) {
        CiExempt =>
          match user_work_scope_standing(unit_test: false, github_actions: false, cgroup: CgroupReadFailed, user_manager_reachable: true, xdg_runtime_dir: true) {
            CgroupUnreadable =>
              match user_work_scope_standing(unit_test: false, github_actions: false, cgroup: CgroupText { text: user_work_slice_unit_name as String }, user_manager_reachable: false, xdg_runtime_dir: false) {
                AlreadyInSlice =>
                  match user_work_scope_standing(unit_test: false, github_actions: false, cgroup: CgroupText { text: runner_unit_prefix }, user_manager_reachable: false, xdg_runtime_dir: false) {
                    RunnerSlotExempt =>
                      match user_work_scope_standing(unit_test: false, github_actions: false, cgroup: CgroupText { text: join(["0::/system.slice/", gunbc_tree_sync_unit_name as String], "") }, user_manager_reachable: false, xdg_runtime_dir: false) {
                        UncappedSystemSlice { unit, slice } =>
                          unit == (gunbc_tree_sync_unit_name as String)
                            && slice == "system.slice"
                            && match user_work_scope_standing(unit_test: false, github_actions: false, cgroup: CgroupText { text: "" }, user_manager_reachable: true, xdg_runtime_dir: false) {
                              UserManagerOwed =>
                                match user_work_scope_standing(unit_test: false, github_actions: false, cgroup: CgroupText { text: "" }, user_manager_reachable: false, xdg_runtime_dir: true) {
                                  UserManagerProbeFailed =>
                                    match user_work_scope_standing(unit_test: false, github_actions: false, cgroup: CgroupText { text: "" }, user_manager_reachable: false, xdg_runtime_dir: false) {
                                      UserSessionAbsent => true
                                      _ => false
                                    }
                                  _ => false
                                }
                              _ => false
                            }
                        _ => false
                      }
                    _ => false
                  }
                _ => false
              }
            _ => false
          }
        _ => false
      }
    _ => false
  }
}

test fn user_session_absent_refuses_rather_than_skipping() -> Bool {
  match user_work_scope_standing_effect(s: UserSessionAbsent) {
    RefuseUserWorkScope { standing: UserSessionAbsent } =>
      match user_work_scope_standing_effect(s: CiExempt) {
        SkipUserWorkScope { standing: CiExempt } =>
          match user_work_scope_standing_effect(s: UserManagerOwed) {
            WrapIntoUserWorkSlice => true
            _ => false
          }
        _ => false
      }
    _ => false
  }
}

test fn the_seed_trampoline_mirrors_the_declared_wrap_standing() -> Bool {
  let seed = filesystem_read(path: seed_user_work_scope_path).content
  string_contains(s: seed, pattern: "SEED MIRROR of `gunbc.compute.unit_bounds user_work_scope_ci_env_name`")
    && string_contains(s: seed, pattern: concat("\"", concat(user_work_scope_ci_env_name, "\"")))
    && string_contains(s: seed, pattern: "SEED MIRROR of `gunbc.runner.runner_unit runner_unit_prefix`")
    && string_contains(s: seed, pattern: concat("\"", concat(runner_unit_prefix, "\"")))
    && string_contains(s: seed, pattern: "SEED MIRROR of `gunbc.compute.unit_bounds user_work_scope_xdg_runtime_dir_env_name`")
    && string_contains(s: seed, pattern: concat("\"", concat(user_work_scope_xdg_runtime_dir_env_name, "\"")))
    && string_contains(s: seed, pattern: user_work_scope_standing_wire(s: UserSessionAbsent))
    && string_contains(s: seed, pattern: user_work_scope_standing_wire(s: RunnerSlotExempt))
    && string_contains(s: seed, pattern: user_work_scope_standing_wire(s: CiExempt))
    && string_contains(s: seed, pattern: user_work_scope_standing_wire(s: UserManagerOwed))
    && string_contains(s: seed, pattern: "SEED MIRROR of `gunbc.compute.unit_bounds user_work_scope_user_slice_cgroup_needle`")
    && string_contains(s: seed, pattern: concat("\"", concat(user_work_scope_user_slice_cgroup_needle, "\"")))
    && string_contains(s: seed, pattern: "SEED MIRROR of `gunbc.compute.unit_bounds user_work_scope_service_unit_suffix`")
    && string_contains(s: seed, pattern: concat("\"", concat(user_work_scope_service_unit_suffix, "\"")))
    && string_contains(s: seed, pattern: "SEED MIRROR of `gunbc.compute.unit_bounds system_service_unit_from_cgroup`")
    && string_contains(s: seed, pattern: "SEED MIRROR of `gunbc.live_deploy.slice_bounds declared_system_slice_memory_maxes` unit names")
    && string_contains(s: seed, pattern: concat("\"", concat(repository_convergence_slice_unit_name as String, "\"")))
    && !any(
      declared_system_slice_memory_maxes(),
      row => byte_size_count(b: row.memory_max) > 0
        && !string_contains(s: seed, pattern: concat("\"", concat(row.unit as String, "\""))),
    )
    && !any(
      declared_system_slice_memory_maxes(),
      row => byte_size_count(b: row.memory_max) == 0
        && string_contains(s: seed, pattern: concat("\"", concat(row.unit as String, "\""))),
    )
    && string_contains(s: seed, pattern: "SEED MIRROR of `gunbc.compute.unit_bounds user_work_scope_slice_unit_suffix`")
    && string_contains(s: seed, pattern: concat("\"", concat(user_work_scope_slice_unit_suffix, "\"")))
    && string_contains(s: seed, pattern: "ExemptSystemUnit")
    && string_contains(s: seed, pattern: "UncappedSystemSlice")
    && string_contains(s: seed, pattern: "UserWorkScopeStanding::UserSessionAbsent =>")
    && string_contains(s: seed, pattern: "std::process::exit(2)")
    && string_contains(s: seed, pattern: "UserWorkSliceAbsent")
    && string_contains(s: seed, pattern: "UserWorkSliceUncapped")
    && string_contains(s: seed, pattern: "CallerEnvelopeUnreadable")
}

test fn a_system_slice_named_service_cgroup_refuses_uncapped() -> Bool {
  let cg = join(["0::/system.slice/", gunbc_tree_sync_unit_name as String], "")
  match system_service_unit_from_cgroup(text: cg) {
    NotSystemService => false
    SystemServiceNamed { unit, slice } =>
      unit == (gunbc_tree_sync_unit_name as String)
        && slice == "system.slice"
        && match user_work_scope_standing(unit_test: false, github_actions: false, cgroup: CgroupText { text: cg }, user_manager_reachable: false, xdg_runtime_dir: false) {
          UncappedSystemSlice { unit: u, slice: sl } =>
            u == unit
              && sl == "system.slice"
              && match user_work_scope_standing_effect(s: UncappedSystemSlice { unit: u, slice: sl }) {
                RefuseUserWorkScope { standing: UncappedSystemSlice { unit: ru, slice: rs } } =>
                  ru == u && rs == sl
                _ => false
              }
          _ => false
        }
  }
}

test fn tree_sync_under_its_declared_slice_is_exempt() -> Bool {
  let cg = join([
    "0::/",
    gunbc_repository_convergence_slice_unit_name as String,
    "/",
    gunbc_tree_sync_unit_name as String,
  ], "")
  match modeled_system_slice_memory_max(unit: gunbc_repository_convergence_slice_unit_name as String) {
    Absent => false
    Present { value: max } =>
      byte_size_count(b: max) == byte_size_count(b: repository_convergence_slice_memory_max)
        && match user_work_scope_standing(unit_test: false, github_actions: false, cgroup: CgroupText { text: cg }, user_manager_reachable: false, xdg_runtime_dir: false) {
          ExemptSystemUnit { unit, slice } =>
            unit == (gunbc_tree_sync_unit_name as String)
              && slice == (gunbc_repository_convergence_slice_unit_name as String)
              && match user_work_scope_standing_effect(s: ExemptSystemUnit { unit: unit, slice: slice }) {
                SkipUserWorkScope { standing: ExemptSystemUnit { unit: eu, slice: es } } =>
                  eu == unit && es == slice
                _ => false
              }
          _ => false
        }
  }
}

test fn declared_system_slice_caps_are_the_slice_bound_rows() -> Bool {
  let rows = declared_system_slice_memory_maxes()
  any(rows, r => (r.unit as String) == (repository_convergence_slice_unit_name as String)
    && byte_size_count(b: r.memory_max) == byte_size_count(b: repository_convergence_slice_memory_max))
    && any(rows, r => byte_size_count(b: r.memory_max) == byte_size_count(b: approval_broker_slice_memory_max))
}

test fn a_user_session_cgroup_still_owes_the_wrap() -> Bool {
  let cg = join([
    "0::",
    user_work_scope_user_slice_cgroup_needle,
    "user-1000.slice/user@1000.service/app.slice/run-u.scope",
  ], "")
  match system_service_unit_from_cgroup(text: cg) {
    NotSystemService =>
      match user_work_scope_standing(unit_test: false, github_actions: false, cgroup: CgroupText { text: cg }, user_manager_reachable: true, xdg_runtime_dir: true) {
        UserManagerOwed =>
          match user_work_scope_standing_effect(s: UserManagerOwed) {
            WrapIntoUserWorkSlice => true
            _ => false
          }
        _ => false
      }
    SystemServiceNamed { unit: _, slice: _ } => false
  }
}

test fn unreadable_cgroup_still_refuses() -> Bool {
  match user_work_scope_standing(unit_test: false, github_actions: false, cgroup: CgroupReadFailed, user_manager_reachable: true, xdg_runtime_dir: true) {
    CgroupUnreadable =>
      match user_work_scope_standing_effect(s: CgroupUnreadable) {
        RefuseUserWorkScope { standing: CgroupUnreadable } => true
        _ => false
      }
    _ => false
  }
}

test fn the_gunbc_test_user_work_scope_is_the_declared_wrap() -> Bool {
  match gunbc_test_user_work_scope_command(label: "//gunbc/instruments:self-host") {
    SystemdRunCommandRefused { cause: _ } => false
    SystemdRunCommandReady { command } =>
      slice_hits(words: argv_words(command: command)) == 1
        && any(argv_words(command: command), w => w == "--user")
        && any(argv_words(command: command), w => w == "--scope")
        && any(argv_words(command: command), w => w == "test")
  }
}

test fn host_converge_backstop_knobs_name_user_at_service_uid() -> Bool {
  match user_manager_backstop_for(host: operator_host_srv1) {
    UserManagerBackstopNotOwed => false
    UserManagerBackstopRefused { cause: _ } => false
    UserManagerBackstopDerived { knobs } =>
      knobs.length() == 2
        && string_contains(s: user_manager_instance_unit(), pattern: "user@1000.service")
        && any(knobs, k => k.name == "user_manager_memory_max_bytes")
        && any(knobs, k => k.name == "user_manager_memory_swap_max_bytes")
  }
}

test fn user_manager_backstop_is_owed_only_on_the_placed_host() -> Bool {
  match user_manager_backstop_for(host: operator_host_srv1) {
    UserManagerBackstopDerived { knobs } =>
      knobs.length() == 2
        && match user_manager_backstop_for(host: operator_host_srv3) {
          UserManagerBackstopNotOwed => true
          UserManagerBackstopDerived { knobs: _ } => false
          UserManagerBackstopRefused { cause: _ } => false
        }
    UserManagerBackstopNotOwed => false
    UserManagerBackstopRefused { cause: _ } => false
  }
}

test fn approval_broker_runtime_caps_are_the_model_14_16_on_the_placed_host() -> Bool {
  match approval_broker_runtime_caps_for(host: operator_host_srv1) {
    ApprovalBrokerRuntimeCapsNotOwed => false
    ApprovalBrokerRuntimeCapsRefused { cause: _ } => false
    ApprovalBrokerRuntimeCapsDerived { knobs } =>
      any(knobs, k => k.name == "approval_broker_memory_max_bytes" && k.desired == to_string(byte_size_count(b: approval_broker_slice_memory_max)))
        && any(knobs, k => k.name == "approval_broker_memory_high_bytes" && k.desired == to_string(byte_size_count(b: approval_broker_slice_memory_high)))
        && match approval_broker_runtime_caps_for(host: operator_host_srv3) {
          ApprovalBrokerRuntimeCapsNotOwed => true
          ApprovalBrokerRuntimeCapsDerived { knobs: _ } => false
          ApprovalBrokerRuntimeCapsRefused { cause: _ } => false
        }
  }
}

test fn slice_control_caps_include_sessions_and_broker_on_srv1_only() -> Bool {
  match slice_control_caps_for(host: operator_host_srv1) {
    SliceControlNotOwed => false
    SliceControlRefused { cause: _ } => false
    SliceControlDerived { caps } =>
      caps.length() == 2
        && any(caps, c => c.unit as String == "sessions.slice" && byte_size_count(b: c.memory_max) == 137438953472)
        && any(caps, c => c.unit as String == "gunbc-approval-broker.slice" && byte_size_count(b: c.memory_max) == 17179869184 && byte_size_count(b: c.memory_high) == 15032385536)
        && match slice_control_caps_for(host: operator_host_srv3) {
          SliceControlNotOwed => true
          SliceControlDerived { caps: _ } => false
          SliceControlRefused { cause: _ } => false
        }
  }
}

test fn slice_control_refuses_when_session_reservation_is_unestablished() -> Bool {
  match slice_control_caps_for(host: operator_host_srv2) {
    SliceControlRefused { cause: _ } => true
    SliceControlNotOwed => false
    SliceControlDerived { caps: _ } => false
  }
}

test fn wrap_keeps_the_tighter_of_caller_and_slice() -> Bool {
  match user_work_pool_slots() {
    UserWorkPoolSlotsDerived { slots } => {
      let slice_max = user_work_slice_memory_max_of(slots: slots)
      let caller_max = byte_size(8589934592)
      let slice = UserWorkSliceInstalled { memory_max: slice_max, memory_high: MemoryUnbounded }
      let caller = CallerEnvelopeObserved { memory_max: MemoryCapped { bytes: caller_max }, memory_high: MemoryUnbounded }
      byte_size_count(b: slice_max) > byte_size_count(b: caller_max)
        && has_property(
          props: user_work_wrap_ready_properties(slice: slice, caller: caller),
          needle: join(["MemoryMax=", to_string(byte_size_count(b: caller_max))], ""),
        )
        && has_property(
          props: user_work_wrap_envelope_properties(memory_max: caller_max, memory_high: MemoryUnbounded),
          needle: join(["MemoryMax=", to_string(byte_size_count(b: caller_max))], ""),
        )
    }
  }
}

test fn absent_slice_refuses_wrap() -> Bool {
  let caller = CallerEnvelopeObserved { memory_max: MemoryUnbounded, memory_high: MemoryUnbounded }
  match user_work_scope_standing_for_wrap(standing: UserManagerOwed, slice: UserWorkSliceNotInstalled, caller: caller) {
    UserWorkSliceAbsent =>
      match user_work_scope_standing_effect(s: UserWorkSliceAbsent) {
        RefuseUserWorkScope { standing: UserWorkSliceAbsent } => true
        _ => false
      }
    _ => false
  }
}

test fn uncapped_slice_refuses_wrap() -> Bool {
  let caller = CallerEnvelopeObserved { memory_max: MemoryUnbounded, memory_high: MemoryUnbounded }
  match user_work_scope_standing_for_wrap(standing: UserManagerOwed, slice: UserWorkSliceUncappedInstall, caller: caller) {
    UserWorkSliceUncapped =>
      match user_work_scope_standing_effect(s: UserWorkSliceUncapped) {
        RefuseUserWorkScope { standing: UserWorkSliceUncapped } => true
        _ => false
      }
    _ => false
  }
}

test fn installed_capped_slice_admits_wrap() -> Bool {
  match user_work_pool_slots() {
    UserWorkPoolSlotsDerived { slots } => {
      let slice_max = user_work_slice_memory_max_of(slots: slots)
      let slice = UserWorkSliceInstalled { memory_max: slice_max, memory_high: MemoryUnbounded }
      let caller = CallerEnvelopeObserved { memory_max: MemoryUnbounded, memory_high: MemoryUnbounded }
      match user_work_scope_standing_for_wrap(standing: UserManagerOwed, slice: slice, caller: caller) {
        UserManagerOwed =>
          has_property(
            props: user_work_wrap_ready_properties(slice: slice, caller: caller),
            needle: join(["MemoryMax=", to_string(byte_size_count(b: slice_max))], ""),
          )
        _ => false
      }
    }
  }
}

test fn skip_standings_ignore_a_missing_user_work_slice() -> Bool {
  let caller = CallerEnvelopeReadFailed
  let slice = UserWorkSliceNotInstalled
  match user_work_scope_standing_for_wrap(standing: AlreadyInSlice, slice: slice, caller: caller) {
    AlreadyInSlice =>
      match user_work_scope_standing_for_wrap(standing: RunnerSlotExempt, slice: slice, caller: caller) {
        RunnerSlotExempt =>
          match user_work_scope_standing_for_wrap(standing: CiExempt, slice: slice, caller: caller) {
            CiExempt =>
              match user_work_scope_standing_effect(s: AlreadyInSlice) {
                SkipUserWorkScope { standing: AlreadyInSlice } =>
                  match user_work_scope_standing_effect(s: RunnerSlotExempt) {
                    SkipUserWorkScope { standing: RunnerSlotExempt } =>
                      match user_work_scope_standing_effect(s: CiExempt) {
                        SkipUserWorkScope { standing: CiExempt } => true
                        _ => false
                      }
                    _ => false
                  }
                _ => false
              }
            _ => false
          }
        _ => false
      }
    _ => false
  }
}
