data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree
data seed_user_work_scope_path: String = "src/v1/stage0/src/cli_run/user_work_scope.rs"
data claim_batch_bin_path: String = "src/v1/stage0/src/bin/claim_batch.rs"

fn property_words(props: List<SystemdRunProperty>) -> List<String> {
  props |> map(p => match systemd_run_property_assignment(property: p) {
    SystemdRunPropertyAssignmentReady { assignment: a } => a
    SystemdRunPropertyAssignmentRefused { cause: _ } => ""
  })
}

fn has_property(props: List<SystemdRunProperty>, needle: String) -> Bool {
  any(property_words(props: props), p => string_contains(s: p, pattern: needle))
}

fn slice_needle() -> String {
  join(["Slice=", user_work_slice_unit_name as String], "")
}

fn slice_hits(words: List<String>) -> Int {
  filter(words, w => string_contains(s: w, pattern: slice_needle())).length()
}

test fn user_work_slice_max_is_pool_slots_times_the_runner_ceiling() -> Bool {
  match user_work_pool_slots() {
    UserWorkPoolSlotsDerived { slots } =>
      slots == user_work_charged_slots
        && byte_size_count(b: user_work_slice_memory_max_of(slots: slots))
          == byte_size_count(b: gunbc_runner_slot_desired().memory_max) * 2
        && byte_size_count(b: user_work_charged_in_served_allowance())
          == byte_size_count(b: user_work_slice_memory_max_of(slots: slots))
  }
}

test fn user_work_slice_high_is_one_gib_under_max() -> Bool {
  match user_work_pool_slots() {
    UserWorkPoolSlotsDerived { slots } => {
      let max = user_work_slice_memory_max_of(slots: slots)
      match user_work_slice_memory_high_of(memory_max: max) {
        UserWorkSliceHighGapExceedsMax => false
        UserWorkSliceHighDerived { bytes: high } =>
          byte_size_count(b: high) + 1073741824 == byte_size_count(b: max)
      }
    }
  }
}

test fn a_max_below_the_high_gap_refuses_rather_than_writing_zero() -> Bool {
  match user_work_slice_memory_high_of(memory_max: byte_size(0)) {
    UserWorkSliceHighGapExceedsMax => true
    UserWorkSliceHighDerived { bytes: _ } => false
  }
}

test fn user_manager_backstop_is_work_slice_plus_remainder() -> Bool {
  match user_work_pool_slots() {
    UserWorkPoolSlotsDerived { slots } => {
      let work = user_work_slice_memory_max_of(slots: slots)
      byte_size_count(b: user_slice_backstop_memory_max_of(work_slice_max: work))
        == byte_size_count(b: work) + byte_size_count(b: user_manager_remainder)
    }
  }
}

test fn the_grant_launch_binds_the_declared_slice_once() -> Bool {
  let props = compute_grant_unit_properties(granted: kibibyte(count: 1024), working_directory: "/wt", process_bounds: none)
  !has_property(props: props, needle: slice_needle())
    && has_property(props: props, needle: "MemoryMax=1048576")
    && match gunbc_user_work_wait_command(unit: "gunbc-compute-t" as NonEmptyStr, properties: props, setenv_bindings: [], command_argv: ["true"]) {
      SystemdSummaryPrintingWaitRefused { cause: _ } => false
      SystemdSummaryPrintingWaitReady { wait } =>
        slice_hits(words: systemd_summary_printing_wait_argv(w: wait)) == 1
          && filter(systemd_summary_printing_wait_argv(w: wait), w => string_contains(s: w, pattern: "MemorySwapMax=0")).length() == 1
    }
}

test fn the_reviewer_launch_binds_the_declared_slice_once() -> Bool {
  let inst = srv2_deploy_dashboard_instance()
  let props = dispatch_review_unit_properties(instance: inst, working_directory: inst.repo_root as String, log_path: "/r/log", review_dir: "/state/a/review", exit_hook: "+mkdir -- /i/attempt-exit-spool/inbox/x" as NonEmptyStr)
  !has_property(props: props, needle: slice_needle())
    && match gunbc_user_work_transient_command(unit: "gunbc-review-t.service" as NonEmptyStr, properties: props, setenv_bindings: [], command_argv: ["true"]) {
      SystemdRunCommandRefused { cause: _ } => false
      SystemdRunCommandReady { command } =>
        slice_hits(words: argv_words(command: command)) == 1
          && filter(argv_words(command: command), w => string_contains(s: w, pattern: "MemorySwapMax=0")).length() == 1
    }
}

test fn the_ad_hoc_scope_wrap_injects_the_slice_the_raw_builder_omits() -> Bool {
  let raw_ok = match systemd_run_user_scope_command(properties: [], command_argv: ["true"]) {
    SystemdRunCommandRefused { cause: _ } => false
    SystemdRunCommandReady { command } =>
      !any(argv_words(command: command), w => string_contains(s: w, pattern: "Slice="))
  }
  match gunbc_user_work_scope_command(properties: [], command_argv: ["gunbc", "test", "//x"]) {
    SystemdRunCommandRefused { cause: _ } => false
    SystemdRunCommandReady { command } =>
      raw_ok
        && slice_hits(words: argv_words(command: command)) == 1
        && filter(argv_words(command: command), w => string_contains(s: w, pattern: "MemorySwapMax=0")).length() == 1
        && any(argv_words(command: command), w => w == "--user")
        && any(argv_words(command: command), w => w == "--scope")
  }
}

test fn the_seed_trampoline_mirrors_the_declared_wrap_prefix() -> Bool {
  let seed = filesystem_read(path: seed_user_work_scope_path).content
  let prefix = user_work_scope_wrap_prefix_argv()
  let swap_word = join(["--property=MemorySwapMax=", to_string(byte_size_count(b: user_work_slice_memory_swap_max))], "")
  let slice_word = join(["--property=Slice=", user_work_slice_unit_name as String], "")
  prefix.length() > 0
    && any(prefix, w => w == "systemd-run")
    && any(prefix, w => w == "--user")
    && any(prefix, w => w == "--scope")
    && any(prefix, w => w == slice_word)
    && any(prefix, w => w == swap_word)
    && string_contains(s: seed, pattern: "SEED MIRROR of `gunbc.live_deploy.slice_bounds user_work_slice_unit_name`")
    && string_contains(s: seed, pattern: "SEED MIRROR of `gunbc.live_deploy.slice_bounds user_work_slice_memory_swap_max`")
    && string_contains(s: seed, pattern: concat("\"", concat(user_work_slice_unit_name as String, "\"")))
    && string_contains(
      s: seed,
      pattern: concat(
        "const USER_WORK_SLICE_MEMORY_SWAP_MAX_BYTES: u64 = ",
        concat(to_string(byte_size_count(b: user_work_slice_memory_swap_max)), ";"),
      ),
    )
    && string_contains(s: seed, pattern: "CgroupUnreadable")
    && string_contains(s: seed, pattern: "UserManagerProbeFailed")
    && string_contains(s: seed, pattern: "std::process::exit(2)")
    && string_contains(s: seed, pattern: "--property=MemoryMax=")
    && string_contains(s: seed, pattern: "--property=MemoryHigh=")
    && string_contains(s: seed, pattern: "UserWorkSliceAbsent")
    && string_contains(s: seed, pattern: "SEED MIRROR of `gunbc.compute.unit_bounds user_work_scope_standing_for_wrap`")
}

// THE ONE CHECK'S TWO ANSWERS, as rows can build them: an observation of the chain, and the standing
// the fold composes from a premise plus that observation.
fn chain(levels: List<CgroupMemoryLevel>, swap: List<String>) -> CgroupBoundObservation {
  CgroupChainRead { levels: levels, swap_max: map(swap, w => parse_cgroup_memory_limit(body: w)) }
}

fn unread_chain(detail: String) -> CgroupBoundObservation {
  CgroupChainUnread { detail: detail }
}

fn level_at(dir: String, max: String) -> CgroupMemoryLevel {
  CgroupMemoryLevelRead { dir: dir as NonEmptyStr, max: parse_cgroup_memory_limit(body: max), high: CgroupMemoryUnlimited }
}

// The standing for a cgroup path under a given chain reading, with the user-manager arms switched off
// so a premise-free path would land on UserSessionAbsent rather than blur the row.
fn standing_at(text: String, bound: CgroupBoundObservation) -> UserWorkScopeStanding {
  user_work_scope_standing(
    unit_test: false,
    github_actions: false,
    cgroup: CgroupText { text: text },
    bound: bound,
    user_manager_reachable: false,
    xdg_runtime_dir: false,
  )
}

fn wire_at(text: String, bound: CgroupBoundObservation) -> String {
  user_work_scope_standing_wire(s: standing_at(text: text, bound: bound))
}

fn ci_wire_at(text: String, bound: CgroupBoundObservation) -> String {
  user_work_scope_standing_wire(s: user_work_scope_standing(
    unit_test: false,
    github_actions: true,
    cgroup: CgroupText { text: text },
    bound: bound,
    user_manager_reachable: false,
    xdg_runtime_dir: false,
  ))
}

// THE FOLD'S LADDER, arm by arm, through the ONE check. Order matters and is pinned: the test-harness
// gate first (it claims no bound, so the check is never consulted); then an unreadable cgroup path,
// which refuses whatever else is true -- INCLUDING a set GITHUB_ACTIONS, where the old fold skipped
// (CiExempt could be reached with no cgroup at all); then a premise plus the check's answer, where the
// premise never carries the skip; then, with no premise, the user-manager arms.
test fn user_work_scope_standing_selects_from_supplied_observations() -> Bool {
  let bounded = chain(levels: [level_at(dir: "/sys/fs/cgroup/system.slice/job.service", max: "21474836480")], swap: ["0"])
  let unbounded = unread_chain(detail: "fixture")
  match user_work_scope_standing(unit_test: true, github_actions: true, cgroup: CgroupReadFailed, bound: unbounded, user_manager_reachable: true, xdg_runtime_dir: true) {
    UnitTestExempt =>
      // GITHUB_ACTIONS no longer outranks an unreadable cgroup path.
      match user_work_scope_standing(unit_test: false, github_actions: true, cgroup: CgroupReadFailed, bound: unbounded, user_manager_reachable: true, xdg_runtime_dir: true) {
        CgroupUnreadable =>
          match user_work_scope_standing_effect(s: CgroupUnreadable) {
            RefuseUserWorkScope { standing: CgroupUnreadable } =>
              // Every bound-premised path refuses, located, when the check observes no finite bound...
              match standing_at(text: user_work_slice_unit_name as String, bound: unbounded) {
                UncappedEnclosingCgroup { premise: AlreadyInDeclaredUserWorkSlice, cgroup: _, cause: _ } =>
                  match standing_at(text: runner_slot_fixture_cgroup(), bound: unbounded) {
                    UncappedEnclosingCgroup { premise: InRunnerSlotCgroup, cgroup: _, cause: _ } =>
                      match user_work_scope_standing(unit_test: false, github_actions: true, cgroup: CgroupText { text: "0::/system.slice/gunbc-cap-deploy.service" }, bound: unbounded, user_manager_reachable: true, xdg_runtime_dir: true) {
                        UncappedEnclosingCgroup { premise: InCiRunnerEnvironment, cgroup: _, cause: _ } =>
                          // ...and every one of them skips on the SAME evidence: a live finite memory.max.
                          match standing_at(text: user_work_slice_unit_name as String, bound: bounded) {
                            ExemptUnderObservedBound { premise: Present { value: AlreadyInDeclaredUserWorkSlice }, memory_max: m } =>
                              byte_size_count(b: m) == 21474836480
                                && match standing_at(text: runner_slot_fixture_cgroup(), bound: bounded) {
                                  ExemptUnderObservedBound { premise: Present { value: InRunnerSlotCgroup }, memory_max: s } =>
                                    byte_size_count(b: s) == 21474836480
                                      && match user_work_scope_standing(unit_test: false, github_actions: true, cgroup: CgroupText { text: "0::/system.slice/gunbc-cap-deploy.service" }, bound: bounded, user_manager_reachable: true, xdg_runtime_dir: true) {
                                        ExemptUnderObservedBound { premise: Present { value: InCiRunnerEnvironment }, memory_max: c } =>
                                          byte_size_count(b: c) == 21474836480
                                            && match standing_at(text: join(["0::/system.slice/", gunbc_tree_sync_unit_name as String], ""), bound: unbounded) {
                                              UncappedEnclosingCgroup { premise: UnderUnmodeledSystemUnit { unit, slice }, cgroup: _, cause: _ } =>
                                                unit == (gunbc_tree_sync_unit_name as String)
                                                  && slice == "system.slice"
                                                  && match user_work_scope_standing(unit_test: false, github_actions: false, cgroup: CgroupText { text: "" }, bound: unbounded, user_manager_reachable: true, xdg_runtime_dir: false) {
                                                    UserManagerOwed =>
                                                      match user_work_scope_standing(unit_test: false, github_actions: false, cgroup: CgroupText { text: "" }, bound: unbounded, user_manager_reachable: false, xdg_runtime_dir: true) {
                                                        UserManagerProbeFailed =>
                                                          match user_work_scope_standing(unit_test: false, github_actions: false, cgroup: CgroupText { text: "" }, bound: unbounded, user_manager_reachable: false, xdg_runtime_dir: false) {
                                                            UserSessionAbsent => true
                                                            _ => false
                                                          }
                                                        _ => false
                                                      }
                                                    _ => false
                                                  }
                                              _ => false
                                            }
                                        _ => false
                                      }
                                  _ => false
                                }
                            _ => false
                          }
                        _ => false
                      }
                    _ => false
                  }
                _ => false
              }
            _ => false
          }
        _ => false
      }
    _ => false
  }
}

// THE ONE CHECK IS THE ONLY DISCHARGE: each premise's skip wire is the same arm, and the refusal names
// the cgroup consulted and what its memory.max said -- so a log line answers "which cgroup, and what
// did it read" (the srv1 receipt said neither).
test fn every_bound_premised_arm_refuses_without_a_live_bound_and_skips_with_one() -> Bool {
  let ci = "0::/system.slice/gunbc-cap-deploy.service"
  let slot = runner_slot_fixture_cgroup()
  let slice = join(["0::/", gunbc_repository_convergence_slice_unit_name as String, "/", gunbc_tree_sync_unit_name as String], "")
  let bounded = chain(levels: [level_at(dir: "/sys/fs/cgroup/system.slice/x.service", max: "21474836480")], swap: ["0"])
  let unbounded = unread_chain(detail: "fixture")
  ci_wire_at(text: ci, bound: unbounded)
    == join(["UncappedEnclosingCgroup:ci-runner-environment @ ", ci, ": ", enclosing_bound_cause_text(cause: ChainUnreadable { detail: "fixture" })], "")
    && ci_wire_at(text: ci, bound: bounded)
      == join(["ExemptUnderObservedBound:ci-runner-environment:", "/sys/fs/cgroup/system.slice/x.service", ":", to_string(value: byte_size_count(b: byte_size(count: 21474836480)))], "")
    && wire_at(text: slot, bound: unbounded)
      == join(["UncappedEnclosingCgroup:runner-slot-cgroup @ ", slot, ": ", enclosing_bound_cause_text(cause: ChainUnreadable { detail: "fixture" })], "")
    && wire_at(text: slot, bound: bounded)
      == join(["ExemptUnderObservedBound:runner-slot-cgroup:/sys/fs/cgroup/system.slice/x.service:", to_string(value: byte_size_count(b: byte_size(count: 21474836480)))], "")
    && wire_at(text: slice, bound: unbounded)
      == join(["UncappedEnclosingCgroup:modeled-slice:", gunbc_repository_convergence_slice_unit_name as String, ":", gunbc_tree_sync_unit_name as String, " @ ", slice, ": ", enclosing_bound_cause_text(cause: ChainUnreadable { detail: "fixture" })], "")
    && wire_at(text: slice, bound: bounded)
      == join(["ExemptUnderObservedBound:modeled-slice:", gunbc_repository_convergence_slice_unit_name as String, ":", gunbc_tree_sync_unit_name as String, ":/sys/fs/cgroup/system.slice/x.service:", to_string(value: byte_size_count(b: byte_size(count: 21474836480)))], "")
}

// THE RECEIPT'S OWN PAIR, as two rows: GITHUB_ACTIONS set with the chain's memory.max reading `max`
// refuses (srv1 cap deploy run 38865847078 skipped as CiExempt and then died at resolve with
// HostBudgetUnreadable); a runner-slot cgroup with a finite memory.max skips.
test fn ci_environment_with_memory_max_at_max_refuses_and_a_slot_with_a_finite_max_skips() -> Bool {
  let ci = "0::/system.slice/gunbc-cap-deploy.service"
  let max_only = chain(levels: [level_at(dir: "/sys/fs/cgroup/system.slice/gunbc-cap-deploy.service", max: "max")], swap: ["0"])
  let refused = ci_wire_at(text: ci, bound: max_only)
  string_contains(s: refused, pattern: "UncappedEnclosingCgroup:ci-runner-environment")
    && string_contains(s: refused, pattern: ci)
    && string_contains(s: refused, pattern: "no finite memory.max: every memory.max on the chain reads max")
    && (match standing_at(text: runner_slot_fixture_cgroup(), bound: chain(levels: [level_at(dir: runner_slot_fixture_dir(), max: "21474836480")], swap: ["0"])) {
      ExemptUnderObservedBound { premise: Present { value: InRunnerSlotCgroup }, cgroup: g, memory_max: m } =>
        string_contains(s: g, pattern: "actions-runner@srv1-03.service")
          && byte_size_count(b: m) == 21474836480
      _ => false
    })
}

// The same pair for the slot arm read as the RED (no finite max) and its positive control (finite
// max), and for the already-in-slice arm.
test fn a_runner_slot_or_in_slice_path_refuses_without_a_finite_max_and_skips_with_one() -> Bool {
  let slot = runner_slot_fixture_cgroup()
  let in_slice = join(["0::/", user_work_slice_unit_name as String, "/gunbc-run.scope"], "")
  let max_only = chain(levels: [level_at(dir: runner_slot_fixture_dir(), max: "max")], swap: ["max"])
  let finite = chain(levels: [level_at(dir: runner_slot_fixture_dir(), max: "8589934592")], swap: ["0"])
  (match standing_at(text: slot, bound: max_only) {
    UncappedEnclosingCgroup { premise: InRunnerSlotCgroup, cgroup: _, cause: NoFiniteMemoryMax } => true
    _ => false
  })
    && (match standing_at(text: slot, bound: finite) {
      ExemptUnderObservedBound { premise: Present { value: InRunnerSlotCgroup }, memory_max: m } => byte_size_count(b: m) == 8589934592
      _ => false
    })
    && (match standing_at(text: in_slice, bound: max_only) {
      UncappedEnclosingCgroup { premise: AlreadyInDeclaredUserWorkSlice, cgroup: _, cause: _ } => true
      _ => false
    })
    && (match standing_at(text: in_slice, bound: chain(levels: [level_at(dir: "/sys/fs/cgroup/gunbc-user-work.slice", max: "1073741824")], swap: ["0"])) {
      ExemptUnderObservedBound { premise: Present { value: AlreadyInDeclaredUserWorkSlice }, memory_max: m } => byte_size_count(b: m) == 1073741824
      _ => false
    })
}

// Unreadable, zero and max are three shapes of the same refusal, each naming the cgroup that answered;
// none of them skips.
test fn unreadable_zero_and_max_all_refuse_the_same_way_with_their_own_cause() -> Bool {
  let slot = runner_slot_fixture_cgroup()
  (match standing_at(text: slot, bound: unread_chain(detail: "EACCES")) {
    UncappedEnclosingCgroup { premise: _, cgroup: _, cause: ChainUnreadable { detail: d } } => d == "EACCES"
    _ => false
  })
    && (match standing_at(text: slot, bound: chain(levels: [level_at(dir: "/sys/fs/cgroup/system.slice", max: "0")], swap: ["0"])) {
      UncappedEnclosingCgroup { premise: _, cgroup: _, cause: MemoryMaxZero { dir } } => string_contains(s: dir, pattern: "system.slice")
      _ => false
    })
    && (match standing_at(text: slot, bound: chain(levels: [level_at(dir: "/sys/fs/cgroup/system.slice", max: "max")], swap: ["max"])) {
      UncappedEnclosingCgroup { premise: _, cgroup: _, cause: NoFiniteMemoryMax } => true
      _ => false
    })
    && (match standing_at(text: slot, bound: chain(levels: [level_at(dir: "/sys/fs/cgroup/system.slice", max: "21474836480")], swap: ["max"])) {
      UncappedEnclosingCgroup { premise: _, cgroup: _, cause: SwapNotForbidden { dir: _, bytes: b } } => byte_size_count(b: b) == 21474836480
      _ => false
    })
    && enclosing_bound_cause_text(cause: NoFiniteMemoryMax) != (enclosing_bound_cause_text(cause: MemoryMaxZero { dir: "d" }))
}

// A premise-free process is ordinary user work: it skips only on an observed bound (the arm
// BoundedByObservedCgroup was) and otherwise reaches the user-manager arms.
test fn a_premise_free_process_skips_only_on_an_observed_bound() -> Bool {
  let session = join(["0::", user_work_scope_user_slice_cgroup_needle, "user-1000.slice/user@1000.service/app.slice/run-u.scope"], "")
  match standing_at(text: session, bound: chain(levels: [level_at(dir: "/sys/fs/cgroup/user.slice", max: "4096")], swap: ["0"])) {
    ExemptUnderObservedBound { premise: Absent, memory_max: m } =>
      byte_size_count(b: m) == 4096
        && match user_work_scope_standing_effect(s: standing_at(text: session, bound: chain(levels: [level_at(dir: "/sys/fs/cgroup/user.slice", max: "4096")], swap: ["0"]))) {
          SkipUserWorkScope { standing: _ } => true
          _ => false
        }
    _ => false
  }
    && match user_work_scope_standing(unit_test: false, github_actions: false, cgroup: CgroupText { text: session }, bound: unread_chain(detail: "fixture"), user_manager_reachable: true, xdg_runtime_dir: false) {
      UserManagerOwed => true
      _ => false
    }
}

// THE EFFECTS, one arm per verdict: a premise without an observed bound REFUSES (it used to skip --
// CiExempt skipped here), the test-harness arm skips without a bound, and a premise with one skips.
test fn user_session_absent_refuses_rather_than_skipping() -> Bool {
  match user_work_scope_standing_effect(s: UserSessionAbsent) {
    RefuseUserWorkScope { standing: UserSessionAbsent } =>
      match user_work_scope_standing_effect(s: UncappedEnclosingCgroup { premise: InCiRunnerEnvironment, cgroup: "c", cause: NoFiniteMemoryMax }) {
        RefuseUserWorkScope { standing: UncappedEnclosingCgroup { premise: InCiRunnerEnvironment, cgroup: g, cause: _ } } =>
          g == "c"
            && match user_work_scope_standing_effect(s: UnitTestExempt) {
              SkipUserWorkScope { standing: UnitTestExempt } =>
                match user_work_scope_standing_effect(s: ExemptUnderObservedBound { premise: Present { value: InCiRunnerEnvironment }, cgroup: "c", memory_max: byte_size(count: 4096) }) {
                  SkipUserWorkScope { standing: ExemptUnderObservedBound { memory_max: m } } =>
                    byte_size_count(b: m) == 4096
                      && match user_work_scope_standing_effect(s: UserManagerOwed) {
                        WrapIntoUserWorkSlice => true
                        _ => false
                      }
                  _ => false
                }
              _ => false
            }
        _ => false
      }
    _ => false
  }
}

test fn the_seed_trampoline_mirrors_the_declared_wrap_standing() -> Bool {
  let seed = filesystem_read(path: seed_user_work_scope_path).content
  string_contains(s: seed, pattern: "SEED MIRROR of `gunbc.compute.unit_bounds user_work_scope_ci_env_name`")
    && string_contains(s: seed, pattern: concat("\"", concat(user_work_scope_ci_env_name, "\"")))
    && string_contains(s: seed, pattern: "SEED MIRROR of `gunbc.runner.runner_unit runner_unit_prefix`")
    && string_contains(s: seed, pattern: concat("\"", concat(runner_unit_prefix, "\"")))
    && string_contains(s: seed, pattern: "SEED MIRROR of `gunbc.compute.unit_bounds user_work_scope_xdg_runtime_dir_env_name`")
    && string_contains(s: seed, pattern: concat("\"", concat(user_work_scope_xdg_runtime_dir_env_name, "\"")))
    && string_contains(s: seed, pattern: "SEED MIRROR of `gunbc.compute.unit_bounds user_work_scope_systemd_manager_dir`")
    && string_contains(s: seed, pattern: concat("\"", concat(user_work_scope_systemd_manager_dir, "\"")))
    && string_contains(s: seed, pattern: "SEED MIRROR of `gunbc.compute.unit_bounds user_work_scope_buildbuddy_run_id_env_name`")
    && string_contains(s: seed, pattern: concat("\"", concat(user_work_scope_buildbuddy_run_id_env_name, "\"")))
    && string_contains(s: seed, pattern: "ExternallyBoundedExecutor")
    && string_contains(s: seed, pattern: "SEED MIRROR of `gunbc.compute.unit_bounds namespaced_root_standing`")
    && string_contains(s: seed, pattern: user_work_scope_standing_wire(s: UserSessionAbsent))
    && string_contains(s: seed, pattern: user_work_scope_standing_wire(s: UserManagerOwed))
    && string_contains(s: seed, pattern: user_work_scope_standing_wire(s: UnitTestExempt))
    // THE ONE CHECK IS MIRRORED ONCE: the seed carries no per-arm discharge of its own -- no
    // `..._standing_from_cgroup`, no slice-memory reading for an exempt arm, no premise that returns a
    // skip without an observed bound.
    && string_contains(s: seed, pattern: "SEED MIRROR of `gunbc.compute.unit_bounds live_enclosing_bound`")
    && string_contains(s: seed, pattern: "fn live_enclosing_bound_in")
    && string_contains(s: seed, pattern: "SEED MIRROR of `gunbc.compute.unit_bounds wrap_exemption_premise`")
    // CODE-SHAPED negatives: the seed's prose may name the arms it replaced (the receipts do), but no
    // per-arm CONSTRUCTOR or reading may exist any more. Asserting the bare names would make the row
    // false on its own documentation.
    && !string_contains(s: seed, pattern: "UserWorkScopeStanding::CiExempt")
    && !string_contains(s: seed, pattern: "UserWorkScopeStanding::RunnerSlotExempt")
    && !string_contains(s: seed, pattern: "UserWorkScopeStanding::AlreadyInSlice")
    && !string_contains(s: seed, pattern: "UserWorkScopeStanding::ExemptSystemUnit")
    && !string_contains(s: seed, pattern: "UserWorkScopeStanding::UncappedSystemSlice")
    && !string_contains(s: seed, pattern: "UserWorkScopeStanding::BoundedByObservedCgroup")
    && !string_contains(s: seed, pattern: "fn live_modeled_slice_standing")
    && !string_contains(s: seed, pattern: "slice_memory: RootMemoryRead")
    && !string_contains(s: seed, pattern: "fn live_slice_memory")
    && !string_contains(s: seed, pattern: "fn modeled_slice_standing_from_cgroup")
    && !string_contains(s: seed, pattern: "fn system_unit_standing_from_cgroup")
    // A premise may not skip without the check being consulted: the seed's skip is composed FROM the
    // check's answer -- this is the fold's LiveEnclosingBound branch, and no other composition exists.
    && string_contains(s: seed, pattern: "EnclosingBoundObservation::LiveEnclosingBound { cgroup, memory_max } =>")
    && string_contains(s: seed, pattern: "SEED MIRROR of `gunbc.compute.unit_bounds user_work_scope_user_slice_cgroup_needle`")
    && string_contains(s: seed, pattern: concat("\"", concat(user_work_scope_user_slice_cgroup_needle, "\"")))
    && string_contains(s: seed, pattern: "SEED MIRROR of `gunbc.compute.unit_bounds user_work_scope_service_unit_suffix`")
    && string_contains(s: seed, pattern: concat("\"", concat(user_work_scope_service_unit_suffix, "\"")))
    && string_contains(s: seed, pattern: "SEED MIRROR of `gunbc.compute.unit_bounds last_cgroup_unit_with_dot_suffix`")
    && string_contains(s: seed, pattern: "SEED MIRROR of `gunbc.compute.unit_bounds system_service_unit_from_cgroup`")
    && string_contains(s: seed, pattern: "SEED MIRROR of `gunbc.compute.unit_bounds recognized_system_slice`")
    && string_contains(s: seed, pattern: concat("\"", concat(repository_convergence_slice_unit_name as String, "\"")))
    && string_contains(s: seed, pattern: concat("\"", concat(gunbc_oomd_sessions_slice as String, "\"")))
    && !any(
      declared_system_slice_memory_maxes(),
      row => byte_size_count(b: row.memory_max) > 0
        && !string_contains(s: seed, pattern: concat("\"", concat(row.unit as String, "\""))),
    )
    && !any(
      declared_system_slice_memory_maxes(),
      row => byte_size_count(b: row.memory_max) == 0
        && string_contains(s: seed, pattern: concat("\"", concat(row.unit as String, "\""))),
    )
    && string_contains(s: seed, pattern: "SEED MIRROR of `gunbc.compute.unit_bounds user_work_scope_slice_unit_suffix`")
    && string_contains(s: seed, pattern: concat("\"", concat(user_work_scope_slice_unit_suffix, "\"")))
    && string_contains(s: seed, pattern: "SEED MIRROR of `gunbc.compute.unit_bounds user_work_scope_scope_unit_suffix`")
    && string_contains(s: seed, pattern: concat("\"", concat(user_work_scope_scope_unit_suffix, "\"")))
    && string_contains(s: seed, pattern: "SEED MIRROR of `gunbc.compute.unit_bounds innermost_modeled_capped_slice`")
    && string_contains(s: seed, pattern: "UserWorkScopeStanding::UserSessionAbsent =>")
    && string_contains(s: seed, pattern: "SEED MIRROR of `gunbc.compute.unit_bounds cgroup_bound_fallthrough_wire`")
    // The three wire words are a RENDERING OF THE CHECK'S ANSWER (cgroup_bound_fallthrough_wire now
    // consumes EnclosingBoundObservation), so the rows pass the check itself -- a premise that skipped
    // the check could not print them.
    && string_contains(s: seed, pattern: concat("\"", concat(cgroup_bound_fallthrough_wire(bound: check_against(ci_fixture_cgroup(), live_fixture())), "\"")))
    && string_contains(s: seed, pattern: concat("\"", concat(cgroup_bound_fallthrough_wire(bound: check_against(ci_fixture_cgroup(), unread_chain(detail: "fixture"))), "\"")))
    && string_contains(s: seed, pattern: concat("\"", concat(cgroup_bound_fallthrough_wire(bound: check_against(ci_fixture_cgroup(), chain(levels: [level_at(dir: "/sys/fs/cgroup/system.slice", max: "max")], swap: ["0"]))), "\"")))
    // The refusal line the seed prints is the declared wire for the same standing, byte for byte: a
    // premise, the cgroup consulted, and what its memory.max said.
    && string_contains(s: seed, pattern: user_work_scope_standing_wire(s: UncappedEnclosingCgroup { premise: InCiRunnerEnvironment, cgroup: ci_fixture_cgroup(), cause: NoFiniteMemoryMax }))
    && string_contains(s: seed, pattern: user_work_scope_standing_wire(s: UncappedEnclosingCgroup { premise: InRunnerSlotCgroup, cgroup: runner_slot_fixture_cgroup(), cause: NoFiniteMemoryMax }))
    && string_contains(s: seed, pattern: user_work_scope_standing_wire(s: ExemptUnderObservedBound { premise: Present { value: InRunnerSlotCgroup }, cgroup: runner_slot_fixture_cgroup(), memory_max: byte_size(count: 21474836480) }))
    && string_contains(s: seed, pattern: user_work_scope_standing_wire(s: ExemptUnderObservedBound { premise: Present { value: InCiRunnerEnvironment }, cgroup: ci_fixture_cgroup(), memory_max: byte_size(count: 22548578304) }))
    && string_contains(s: seed, pattern: enclosing_bound_cause_text(cause: MemoryMaxZero { dir: "/sys/fs/cgroup/gunbc-repository-convergence.slice" }))
    && string_contains(s: seed, pattern: enclosing_bound_cause_text(cause: SwapNotForbidden { dir: "/sys/fs/cgroup/x", bytes: byte_size(count: 4096) }))
    && string_contains(s: seed, pattern: "std::process::exit(2)")
    && string_contains(s: seed, pattern: "UserWorkSliceAbsent")
    && string_contains(s: seed, pattern: "UserWorkSliceUncapped")
    && string_contains(s: seed, pattern: "CallerEnvelopeUnreadable")
    && !string_contains(s: seed, pattern: "unwrap_or(MemoryBound::Unbounded)")
    && string_contains(s: seed, pattern: "ExemptBoundedContainer")
    && string_contains(s: seed, pattern: "BoundedContainerUncapped")
    && string_contains(s: seed, pattern: "BoundedContainerUnreadable")
    && string_contains(s: seed, pattern: "SEED MIRROR of `gunbc.compute.unit_bounds user_work_scope_standing_with_root_memory`")
    && string_contains(s: seed, pattern: "fn standing_from_supplied")
    && string_contains(s: seed, pattern: "mod standing_fixture_tests")
}

// The fixture cgroups the seed's own #[cfg(test)] rows assert on, spelled once here so the declared
// wire and the seed's printed line are compared as the SAME string.
fn ci_fixture_cgroup() -> String {
  "0::/system.slice/gunbc-cap-deploy.service"
}

// A runner slot as CI actually creates it on srv1: an `actions-runner@<host>.service` unit under
// system.slice (the declared needle is gunbc.runner.runner_unit runner_unit_prefix, `actions-runner@`;
// the recorded floor log fixture shows this shape, with systemd's \x2d escape for the hyphen). The
// premise has to come from that needle, not from a name no host produces -- a made-up path is
// classified as an unmodeled system unit, and the row would pass without testing the slot arm at all.
fn runner_slot_fixture_cgroup() -> String {
  join(["0::/system.slice/system-actions", "\\x2d", "runner.slice/", runner_unit_prefix, "srv1-03.service"], "")
}

fn runner_slot_fixture_dir() -> String {
  join(["/sys/fs/cgroup/system.slice/system-actions", "\\x2d", "runner.slice/", runner_unit_prefix, "srv1-03.service"], "")
}

fn live_fixture() -> CgroupBoundObservation {
  chain(levels: [level_at(dir: "/sys/fs/cgroup/system.slice/job.service", max: "21474836480")], swap: ["0"])
}

// The ONE check applied to a chain reading, as the standing-composing fold receives it.
fn check_against(text: String, bound: CgroupBoundObservation) -> EnclosingBoundObservation {
  live_enclosing_bound(bound: bound, cgroup_text: text)
}

fn seed_fixture_assert_eq(seed: String, wire: String) -> Bool {
  string_contains(s: seed, pattern: concat("\"", concat(wire, "\"")))
    && string_contains(s: seed, pattern: "assert_eq!")
}

test fn the_seed_classifies_the_same_fixture_cgroups_as_the_fold() -> Bool {
  let seed = filesystem_read(path: seed_user_work_scope_path).content
  let sessions = join([
    "0::",
    user_work_scope_user_slice_cgroup_needle,
    "user-1000.slice/user@1000.service/app.slice/",
    gunbc_oomd_sessions_slice as String,
    "/docker-deadbeef.scope",
  ], "")
  let system_svc = join(["0::/system.slice/", gunbc_tree_sync_unit_name as String], "")
  let sessions_wire = user_work_scope_standing_wire(
    s: user_work_scope_standing(
      unit_test: false,
      github_actions: false,
      cgroup: CgroupText { text: sessions }, bound: CgroupChainUnread { detail: "fixture" },
      user_manager_reachable: false,
      xdg_runtime_dir: false,
    ),
  )
  let system_wire = user_work_scope_standing_wire(
    s: user_work_scope_standing(
      unit_test: false,
      github_actions: false,
      cgroup: CgroupText { text: system_svc }, bound: CgroupChainUnread { detail: "fixture" },
      user_manager_reachable: false,
      xdg_runtime_dir: false,
    ),
  )
  let capped_wire = user_work_scope_standing_wire(
    s: user_work_scope_standing_with_root_memory(
      unit_test: false,
      github_actions: false,
      cgroup: CgroupText { text: "0::/" }, bound: CgroupChainUnread { detail: "fixture" },
      systemd_manager_present: false,
      user_manager_reachable: false,
      xdg_runtime_dir: false,
      root_memory: RootMemoryCapped { bytes: byte_size(25769803776) },
      buildbuddy_run_id: BuildBuddyRunIdAbsent,
    ),
  )
  let unbounded_wire = user_work_scope_standing_wire(
    s: user_work_scope_standing_with_root_memory(
      unit_test: false,
      github_actions: false,
      cgroup: CgroupText { text: "0::/" }, bound: CgroupChainUnread { detail: "fixture" },
      systemd_manager_present: false,
      user_manager_reachable: false,
      xdg_runtime_dir: false,
      root_memory: RootMemoryUnbounded,
      buildbuddy_run_id: BuildBuddyRunIdAbsent,
    ),
  )
  let modeled = join([
    "0::/",
    gunbc_repository_convergence_slice_unit_name as String,
    "/",
    gunbc_tree_sync_unit_name as String,
  ], "")
  let exempt_wire = user_work_scope_standing_wire(
    s: user_work_scope_standing(
      unit_test: false,
      github_actions: false,
      cgroup: CgroupText { text: modeled }, bound: CgroupChainUnread { detail: "fixture" },
      user_manager_reachable: false,
      xdg_runtime_dir: false,
    ),
  )
  let zero_slice_wire = user_work_scope_standing_wire(
    s: user_work_scope_standing(
      unit_test: false,
      github_actions: false,
      cgroup: CgroupText { text: modeled },
      bound: CgroupChainUnread { detail: "fixture" },
      user_manager_reachable: false,
      xdg_runtime_dir: false,
    ),
  )
  string_contains(s: seed, pattern: sessions)
    && string_contains(s: seed, pattern: system_svc)
    && string_contains(s: seed, pattern: "0::/")
    && string_contains(s: seed, pattern: modeled)
    && seed_fixture_assert_eq(seed: seed, wire: sessions_wire)
    && seed_fixture_assert_eq(seed: seed, wire: system_wire)
    && seed_fixture_assert_eq(seed: seed, wire: capped_wire)
    && seed_fixture_assert_eq(seed: seed, wire: unbounded_wire)
    && seed_fixture_assert_eq(seed: seed, wire: exempt_wire)
    && seed_fixture_assert_eq(seed: seed, wire: zero_slice_wire)
    && string_contains(s: seed, pattern: "fn modeled_slice_with_zero_memory_max_refuses")
    && sessions_wire
      == join(["UncappedEnclosingCgroup:modeled-slice:", gunbc_oomd_sessions_slice as String, ":docker-deadbeef.scope @ ", sessions, ": ", enclosing_bound_cause_text(cause: ChainUnreadable { detail: "fixture" })], "")
    && system_wire
      == join(["UncappedEnclosingCgroup:unmodeled-system-unit:system.slice:", gunbc_tree_sync_unit_name as String, " @ ", system_svc, ": ", enclosing_bound_cause_text(cause: ChainUnreadable { detail: "fixture" })], "")
    && capped_wire == "ExemptBoundedContainer:25769803776"
    && unbounded_wire == "BoundedContainerUncapped"
    && exempt_wire
      == join(["UncappedEnclosingCgroup:modeled-slice:", gunbc_repository_convergence_slice_unit_name as String, ":", gunbc_tree_sync_unit_name as String, " @ ", modeled, ": ", enclosing_bound_cause_text(cause: ChainUnreadable { detail: "fixture" })], "")
    && zero_slice_wire == exempt_wire
}

test fn a_path_segment_without_a_dot_suffix_is_not_a_unit() -> Bool {
  match system_service_unit_from_cgroup(text: "0::/system.slice/gunbc-tree-syncservice") {
    NotSystemService => true
    SystemServiceNamed { unit: _, slice: _ } => false
  }
}

test fn a_system_slice_named_service_cgroup_refuses_uncapped() -> Bool {
  let cg = join(["0::/system.slice/", gunbc_tree_sync_unit_name as String], "")
  match system_service_unit_from_cgroup(text: cg) {
    NotSystemService => false
    SystemServiceNamed { unit, slice } =>
      unit == (gunbc_tree_sync_unit_name as String)
        && slice == "system.slice"
        && match standing_at(text: cg, bound: unread_chain(detail: "fixture")) {
          UncappedEnclosingCgroup { premise: UnderUnmodeledSystemUnit { unit: u, slice: sl }, cgroup: c, cause: _ } =>
            u == unit
              && sl == "system.slice"
              && c == cg
              && match user_work_scope_standing_effect(s: standing_at(text: cg, bound: unread_chain(detail: "fixture"))) {
                RefuseUserWorkScope { standing: _ } => true
                _ => false
              }
          _ => false
        }
  }
}

// A DECLARED CAP IS NOT AN ENCLOSING BOUND. The row keeps the census equality (the slice is modeled,
// so its premise names it) but the skip now comes only from the live reading: same path, declared cap
// in force, no observation -> refuse; observation of a finite memory.max -> skip carrying the OBSERVED
// magnitude, never the declared one.
test fn tree_sync_under_its_declared_slice_is_exempt_only_on_a_live_bound() -> Bool {
  let cg = join([
    "0::/",
    gunbc_repository_convergence_slice_unit_name as String,
    "/",
    gunbc_tree_sync_unit_name as String,
  ], "")
  match modeled_system_slice_memory_max(unit: gunbc_repository_convergence_slice_unit_name as String) {
    Absent => false
    Present { value: max } =>
      byte_size_count(b: max) == byte_size_count(b: repository_convergence_slice_memory_max)
        && match standing_at(text: cg, bound: unread_chain(detail: "fixture")) {
          UncappedEnclosingCgroup { premise: UnderModeledSlice { unit: u, slice: sl }, cgroup: _, cause: _ } =>
            u == (gunbc_tree_sync_unit_name as String)
              && sl == (gunbc_repository_convergence_slice_unit_name as String)
              && match standing_at(text: cg, bound: chain(levels: [level_at(dir: "/sys/fs/cgroup/gunbc-repository-convergence.slice", max: "21474836480")], swap: ["0"])) {
                ExemptUnderObservedBound { premise: Present { value: UnderModeledSlice { unit: eu, slice: es } }, memory_max: eb } =>
                  eu == u
                    && es == sl
                    && byte_size_count(b: eb) == 21474836480
                    && byte_size_count(b: eb) != byte_size_count(b: max)
                    && match user_work_scope_standing_effect(s: standing_at(text: cg, bound: chain(levels: [level_at(dir: "/sys/fs/cgroup/gunbc-repository-convergence.slice", max: "21474836480")], swap: ["0"]))) {
                      SkipUserWorkScope { standing: _ } => true
                      _ => false
                    }
                _ => false
              }
          _ => false
        }
  }
}

test fn an_attempt_worker_under_its_declared_slice_is_wrap_exempt_only_on_a_live_bound() -> Bool {
  let worker = "gunbc-attempt-n-k.service"
  let cg = join(["0::/", attempt_worker_slice_unit_name as String, "/", worker], "")
  match modeled_system_slice_memory_max(unit: attempt_worker_slice_unit_name as String) {
    Absent => false
    Present { value: max } =>
      byte_size_count(b: max) == byte_size_count(b: attempt_worker_slice_memory_max)
        && match standing_at(text: cg, bound: unread_chain(detail: "fixture")) {
          UncappedEnclosingCgroup { premise: UnderModeledSlice { unit: u, slice: sl }, cgroup: _, cause: _ } =>
            u == worker && sl == (attempt_worker_slice_unit_name as String)
              && match standing_at(text: cg, bound: chain(levels: [level_at(dir: "/sys/fs/cgroup/system.slice/job.service", max: "21474836480")], swap: ["0"])) {
                ExemptUnderObservedBound { premise: Present { value: UnderModeledSlice { unit: eu, slice: es } }, memory_max: eb } =>
                  eu == u && es == sl && byte_size_count(b: eb) == 21474836480
                    && match user_work_scope_standing_effect(s: standing_at(text: cg, bound: chain(levels: [level_at(dir: "/sys/fs/cgroup/system.slice/job.service", max: "21474836480")], swap: ["0"]))) {
                      SkipUserWorkScope { standing: _ } => true
                      _ => false
                    }
                _ => false
              }
          _ => false
        }
  }
}

test fn a_modeled_slice_without_a_live_memory_max_refuses() -> Bool {
  let cg = join([
    "0::/",
    gunbc_repository_convergence_slice_unit_name as String,
    "/",
    gunbc_tree_sync_unit_name as String,
  ], "")
  match standing_at(text: cg, bound: unread_chain(detail: "fixture")) {
    UncappedEnclosingCgroup { premise: UnderModeledSlice { unit, slice }, cgroup: _, cause: ChainUnreadable { detail: _ } } =>
      unit == (gunbc_tree_sync_unit_name as String)
        && slice == (gunbc_repository_convergence_slice_unit_name as String)
        && match user_work_scope_standing_effect(s: standing_at(text: cg, bound: unread_chain(detail: "fixture"))) {
          RefuseUserWorkScope { standing: _ } => true
          _ => false
        }
    _ => false
  }
}

test fn a_modeled_slice_with_unbounded_memory_max_refuses() -> Bool {
