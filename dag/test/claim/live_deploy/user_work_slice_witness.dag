      knobs.length() == 2
        && string_contains(s: user_manager_instance_unit(), pattern: "user@1000.service")
        && any(knobs, k => k.name == "user_manager_memory_max_bytes")
        && any(knobs, k => k.name == "user_manager_memory_swap_max_bytes")
