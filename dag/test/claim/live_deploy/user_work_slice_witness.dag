data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree
data seed_user_work_scope_path: String = "src/v1/stage0/src/cli_run/user_work_scope.rs"
data claim_batch_bin_path: String = "src/v1/stage0/src/bin/claim_batch.rs"

fn property_words(props: List<SystemdRunProperty>) -> List<String> {
  props |> map(p => match systemd_run_property_assignment(property: p) {
    SystemdRunPropertyAssignmentReady { assignment: a } => a
    SystemdRunPropertyAssignmentRefused { cause: _ } => ""
  })
}

fn has_property(props: List<SystemdRunProperty>, needle: String) -> Bool {
  any(property_words(props: props), p => string_contains(s: p, pattern: needle))
}

fn slice_needle() -> String {
  join(["Slice=", user_work_slice_unit_name as String], "")
}

fn slice_hits(words: List<String>) -> Int {
  filter(words, w => string_contains(s: w, pattern: slice_needle())).length()
}

test fn user_work_slice_max_is_pool_slots_times_the_runner_ceiling() -> Bool {
  match user_work_pool_slots() {
    UserWorkPoolSlotsDerived { slots } =>
      slots == user_work_charged_slots
        && byte_size_count(b: user_work_slice_memory_max_of(slots: slots))
          == byte_size_count(b: gunbc_runner_slot_desired().memory_max) * 2
        && byte_size_count(b: user_work_charged_in_served_allowance())
          == byte_size_count(b: user_work_slice_memory_max_of(slots: slots))
  }
}

test fn user_work_slice_high_is_one_gib_under_max() -> Bool {
  match user_work_pool_slots() {
    UserWorkPoolSlotsDerived { slots } => {
      let max = user_work_slice_memory_max_of(slots: slots)
      match user_work_slice_memory_high_of(memory_max: max) {
        UserWorkSliceHighGapExceedsMax => false
        UserWorkSliceHighDerived { bytes: high } =>
          byte_size_count(b: high) + 1073741824 == byte_size_count(b: max)
      }
    }
  }
}

test fn a_max_below_the_high_gap_refuses_rather_than_writing_zero() -> Bool {
  match user_work_slice_memory_high_of(memory_max: byte_size(0)) {
    UserWorkSliceHighGapExceedsMax => true
    UserWorkSliceHighDerived { bytes: _ } => false
  }
}

test fn user_manager_backstop_is_work_slice_plus_remainder() -> Bool {
  match user_work_pool_slots() {
    UserWorkPoolSlotsDerived { slots } => {
      let work = user_work_slice_memory_max_of(slots: slots)
      byte_size_count(b: user_slice_backstop_memory_max_of(work_slice_max: work))
        == byte_size_count(b: work) + byte_size_count(b: user_manager_remainder)
    }
  }
}

test fn the_grant_launch_binds_the_declared_slice_once() -> Bool {
  let props = compute_grant_unit_properties(granted: kibibyte(count: 1024), working_directory: "/wt", process_bounds: none)
  !has_property(props: props, needle: slice_needle())
    && has_property(props: props, needle: "MemoryMax=1048576")
    && match gunbc_user_work_wait_command(unit: "gunbc-compute-t" as NonEmptyStr, properties: props, setenv_bindings: [], command_argv: ["true"]) {
      SystemdSummaryPrintingWaitRefused { cause: _ } => false
      SystemdSummaryPrintingWaitReady { wait } =>
        slice_hits(words: systemd_summary_printing_wait_argv(w: wait)) == 1
          && filter(systemd_summary_printing_wait_argv(w: wait), w => string_contains(s: w, pattern: "MemorySwapMax=0")).length() == 1
    }
}

test fn the_reviewer_launch_binds_the_declared_slice_once() -> Bool {
  let inst = srv2_deploy_dashboard_instance()
  let props = dispatch_review_unit_properties(instance: inst, working_directory: inst.repo_root as String, log_path: "/r/log", review_dir: "/state/a/review", exit_hook: "+mkdir -- /i/attempt-exit-spool/inbox/x" as NonEmptyStr)
  !has_property(props: props, needle: slice_needle())
    && match gunbc_user_work_transient_command(unit: "gunbc-review-t.service" as NonEmptyStr, properties: props, setenv_bindings: [], command_argv: ["true"]) {
      SystemdRunCommandRefused { cause: _ } => false
      SystemdRunCommandReady { command } =>
        slice_hits(words: argv_words(command: command)) == 1
          && filter(argv_words(command: command), w => string_contains(s: w, pattern: "MemorySwapMax=0")).length() == 1
    }
}

test fn the_ad_hoc_scope_wrap_injects_the_slice_the_raw_builder_omits() -> Bool {
  let raw_ok = match systemd_run_user_scope_command(properties: [], command_argv: ["true"]) {
    SystemdRunCommandRefused { cause: _ } => false
    SystemdRunCommandReady { command } =>
      !any(argv_words(command: command), w => string_contains(s: w, pattern: "Slice="))
  }
  match gunbc_user_work_scope_command(properties: [], command_argv: ["gunbc", "test", "//x"]) {
    SystemdRunCommandRefused { cause: _ } => false
    SystemdRunCommandReady { command } =>
      raw_ok
        && slice_hits(words: argv_words(command: command)) == 1
        && filter(argv_words(command: command), w => string_contains(s: w, pattern: "MemorySwapMax=0")).length() == 1
        && any(argv_words(command: command), w => w == "--user")
        && any(argv_words(command: command), w => w == "--scope")
  }
}

test fn the_seed_trampoline_mirrors_the_declared_wrap_prefix() -> Bool {
  let seed = filesystem_read(path: seed_user_work_scope_path).content
  let prefix = user_work_scope_wrap_prefix_argv()
  let swap_word = join(["--property=MemorySwapMax=", to_string(byte_size_count(b: user_work_slice_memory_swap_max))], "")
  let slice_word = join(["--property=Slice=", user_work_slice_unit_name as String], "")
  prefix.length() > 0
    && any(prefix, w => w == "systemd-run")
    && any(prefix, w => w == "--user")
    && any(prefix, w => w == "--scope")
    && any(prefix, w => w == slice_word)
    && any(prefix, w => w == swap_word)
    && string_contains(s: seed, pattern: "SEED MIRROR of `gunbc.live_deploy.slice_bounds user_work_slice_unit_name`")
    && string_contains(s: seed, pattern: "SEED MIRROR of `gunbc.live_deploy.slice_bounds user_work_slice_memory_swap_max`")
    && string_contains(s: seed, pattern: concat("\"", concat(user_work_slice_unit_name as String, "\"")))
    && string_contains(
      s: seed,
      pattern: concat(
        "const USER_WORK_SLICE_MEMORY_SWAP_MAX_BYTES: u64 = ",
        concat(to_string(byte_size_count(b: user_work_slice_memory_swap_max)), ";"),
      ),
    )
    && string_contains(s: seed, pattern: "CgroupUnreadable")
    && string_contains(s: seed, pattern: "UserManagerProbeFailed")
    && string_contains(s: seed, pattern: "std::process::exit(2)")
    && string_contains(s: seed, pattern: "--property=MemoryMax=")
    && string_contains(s: seed, pattern: "--property=MemoryHigh=")
    && string_contains(s: seed, pattern: "UserWorkSliceAbsent")
    && string_contains(s: seed, pattern: "SEED MIRROR of `gunbc.compute.unit_bounds user_work_scope_standing_for_wrap`")
}

test fn user_work_scope_standing_selects_from_supplied_observations() -> Bool {
  match user_work_scope_standing(unit_test: true, github_actions: true, cgroup: CgroupReadFailed, bound: CgroupChainUnread { detail: "fixture" }, user_manager_reachable: true, xdg_runtime_dir: true, slice_memory: RootMemoryUnreadable) {
    UnitTestExempt =>
      match user_work_scope_standing(unit_test: false, github_actions: true, cgroup: CgroupReadFailed, bound: CgroupChainUnread { detail: "fixture" }, user_manager_reachable: true, xdg_runtime_dir: true, slice_memory: RootMemoryUnreadable) {
        CiExempt =>
          match user_work_scope_standing(unit_test: false, github_actions: false, cgroup: CgroupReadFailed, bound: CgroupChainUnread { detail: "fixture" }, user_manager_reachable: true, xdg_runtime_dir: true, slice_memory: RootMemoryUnreadable) {
            CgroupUnreadable =>
              match user_work_scope_standing(unit_test: false, github_actions: false, cgroup: CgroupText { text: user_work_slice_unit_name as String }, bound: CgroupChainUnread { detail: "fixture" }, user_manager_reachable: false, xdg_runtime_dir: false, slice_memory: RootMemoryUnreadable) {
                AlreadyInSlice =>
                  match user_work_scope_standing(unit_test: false, github_actions: false, cgroup: CgroupText { text: runner_unit_prefix }, bound: CgroupChainUnread { detail: "fixture" }, user_manager_reachable: false, xdg_runtime_dir: false, slice_memory: RootMemoryUnreadable) {
                    RunnerSlotExempt =>
                      match user_work_scope_standing(unit_test: false, github_actions: false, cgroup: CgroupText { text: join(["0::/system.slice/", gunbc_tree_sync_unit_name as String], "") }, bound: CgroupChainUnread { detail: "fixture" }, user_manager_reachable: false, xdg_runtime_dir: false, slice_memory: RootMemoryUnreadable) {
                        UncappedSystemSlice { unit, slice } =>
                          unit == (gunbc_tree_sync_unit_name as String)
                            && slice == "system.slice"
                            && match user_work_scope_standing(unit_test: false, github_actions: false, cgroup: CgroupText { text: "" }, bound: CgroupChainUnread { detail: "fixture" }, user_manager_reachable: true, xdg_runtime_dir: false, slice_memory: RootMemoryUnreadable) {
                              UserManagerOwed =>
                                match user_work_scope_standing(unit_test: false, github_actions: false, cgroup: CgroupText { text: "" }, bound: CgroupChainUnread { detail: "fixture" }, user_manager_reachable: false, xdg_runtime_dir: true, slice_memory: RootMemoryUnreadable) {
                                  UserManagerProbeFailed =>
                                    match user_work_scope_standing(unit_test: false, github_actions: false, cgroup: CgroupText { text: "" }, bound: CgroupChainUnread { detail: "fixture" }, user_manager_reachable: false, xdg_runtime_dir: false, slice_memory: RootMemoryUnreadable) {
                                      UserSessionAbsent => true
                                      _ => false
                                    }
                                  _ => false
                                }
                              _ => false
                            }
                        _ => false
                      }
                    _ => false
                  }
                _ => false
              }
            _ => false
          }
        _ => false
      }
    _ => false
  }
}

test fn user_session_absent_refuses_rather_than_skipping() -> Bool {
  match user_work_scope_standing_effect(s: UserSessionAbsent) {
    RefuseUserWorkScope { standing: UserSessionAbsent } =>
      match user_work_scope_standing_effect(s: CiExempt) {
        SkipUserWorkScope { standing: CiExempt } =>
          match user_work_scope_standing_effect(s: UserManagerOwed) {
            WrapIntoUserWorkSlice => true
            _ => false
          }
        _ => false
      }
    _ => false
  }
}

test fn the_seed_trampoline_mirrors_the_declared_wrap_standing() -> Bool {
  let seed = filesystem_read(path: seed_user_work_scope_path).content
  string_contains(s: seed, pattern: "SEED MIRROR of `gunbc.compute.unit_bounds user_work_scope_ci_env_name`")
    && string_contains(s: seed, pattern: concat("\"", concat(user_work_scope_ci_env_name, "\"")))
    && string_contains(s: seed, pattern: "SEED MIRROR of `gunbc.runner.runner_unit runner_unit_prefix`")
    && string_contains(s: seed, pattern: concat("\"", concat(runner_unit_prefix, "\"")))
    && string_contains(s: seed, pattern: "SEED MIRROR of `gunbc.compute.unit_bounds user_work_scope_xdg_runtime_dir_env_name`")
    && string_contains(s: seed, pattern: concat("\"", concat(user_work_scope_xdg_runtime_dir_env_name, "\"")))
    && string_contains(s: seed, pattern: "SEED MIRROR of `gunbc.compute.unit_bounds user_work_scope_systemd_manager_dir`")
    && string_contains(s: seed, pattern: concat("\"", concat(user_work_scope_systemd_manager_dir, "\"")))
    && string_contains(s: seed, pattern: "SEED MIRROR of `gunbc.compute.unit_bounds user_work_scope_buildbuddy_run_id_env_name`")
    && string_contains(s: seed, pattern: concat("\"", concat(user_work_scope_buildbuddy_run_id_env_name, "\"")))
    && string_contains(s: seed, pattern: "ExternallyBoundedExecutor")
    && string_contains(s: seed, pattern: "SEED MIRROR of `gunbc.compute.unit_bounds namespaced_root_standing`")
    && string_contains(s: seed, pattern: user_work_scope_standing_wire(s: UserSessionAbsent))
    && string_contains(s: seed, pattern: user_work_scope_standing_wire(s: RunnerSlotExempt))
    && string_contains(s: seed, pattern: user_work_scope_standing_wire(s: CiExempt))
    && string_contains(s: seed, pattern: user_work_scope_standing_wire(s: UserManagerOwed))
    && string_contains(s: seed, pattern: "SEED MIRROR of `gunbc.compute.unit_bounds user_work_scope_user_slice_cgroup_needle`")
    && string_contains(s: seed, pattern: concat("\"", concat(user_work_scope_user_slice_cgroup_needle, "\"")))
    && string_contains(s: seed, pattern: "SEED MIRROR of `gunbc.compute.unit_bounds user_work_scope_service_unit_suffix`")
    && string_contains(s: seed, pattern: concat("\"", concat(user_work_scope_service_unit_suffix, "\"")))
    && string_contains(s: seed, pattern: "SEED MIRROR of `gunbc.compute.unit_bounds last_cgroup_unit_with_dot_suffix`")
    && string_contains(s: seed, pattern: "SEED MIRROR of `gunbc.compute.unit_bounds system_service_unit_from_cgroup`")
    && string_contains(s: seed, pattern: "SEED MIRROR of `gunbc.compute.unit_bounds recognized_system_slice`")
    && string_contains(s: seed, pattern: concat("\"", concat(repository_convergence_slice_unit_name as String, "\"")))
    && string_contains(s: seed, pattern: concat("\"", concat(gunbc_oomd_sessions_slice as String, "\"")))
    && !any(
      declared_system_slice_memory_maxes(),
      row => byte_size_count(b: row.memory_max) > 0
        && !string_contains(s: seed, pattern: concat("\"", concat(row.unit as String, "\""))),
    )
    && !any(
      declared_system_slice_memory_maxes(),
      row => byte_size_count(b: row.memory_max) == 0
        && string_contains(s: seed, pattern: concat("\"", concat(row.unit as String, "\""))),
    )
    && string_contains(s: seed, pattern: "SEED MIRROR of `gunbc.compute.unit_bounds user_work_scope_slice_unit_suffix`")
    && string_contains(s: seed, pattern: concat("\"", concat(user_work_scope_slice_unit_suffix, "\"")))
    && string_contains(s: seed, pattern: "SEED MIRROR of `gunbc.compute.unit_bounds user_work_scope_scope_unit_suffix`")
    && string_contains(s: seed, pattern: concat("\"", concat(user_work_scope_scope_unit_suffix, "\"")))
    && string_contains(s: seed, pattern: "SEED MIRROR of `gunbc.compute.unit_bounds live_modeled_slice_standing`")
    && string_contains(s: seed, pattern: "SEED MIRROR of `gunbc.compute.unit_bounds innermost_modeled_capped_slice`")
    && string_contains(s: seed, pattern: "ExemptSystemUnit")
    && string_contains(s: seed, pattern: "UncappedSystemSlice")
    && string_contains(s: seed, pattern: "UserWorkScopeStanding::UserSessionAbsent =>")
    && string_contains(s: seed, pattern: "SEED MIRROR of `gunbc.compute.unit_bounds observed_cgroup_bound`")
    && string_contains(s: seed, pattern: "SEED MIRROR of `gunbc.compute.unit_bounds cgroup_bound_fallthrough_wire`")
    && string_contains(s: seed, pattern: concat("\"", concat(cgroup_bound_fallthrough_wire(bound: CgroupChainUnbounded), "\"")))
    && string_contains(s: seed, pattern: concat("\"", concat(cgroup_bound_fallthrough_wire(bound: CgroupChainNotObserved { detail: "" }), "\"")))
    && string_contains(s: seed, pattern: concat("\"", concat(user_work_scope_standing_wire(s: BoundedByObservedCgroup { cgroup: "", memory_max: byte_size(count: 0) }), "\"")))
    && string_contains(s: seed, pattern: "std::process::exit(2)")
    && string_contains(s: seed, pattern: "UserWorkSliceAbsent")
    && string_contains(s: seed, pattern: "UserWorkSliceUncapped")
    && string_contains(s: seed, pattern: "CallerEnvelopeUnreadable")
    && !string_contains(s: seed, pattern: "unwrap_or(MemoryBound::Unbounded)")
    && string_contains(s: seed, pattern: "ExemptBoundedContainer")
    && string_contains(s: seed, pattern: "BoundedContainerUncapped")
    && string_contains(s: seed, pattern: "BoundedContainerUnreadable")
    && string_contains(s: seed, pattern: "SEED MIRROR of `gunbc.compute.unit_bounds user_work_scope_standing_with_root_memory`")
    && string_contains(s: seed, pattern: "fn standing_from_supplied")
    && string_contains(s: seed, pattern: "mod standing_fixture_tests")
}

fn seed_fixture_assert_eq(seed: String, wire: String) -> Bool {
  string_contains(s: seed, pattern: concat("\"", concat(wire, "\"")))
    && string_contains(s: seed, pattern: "assert_eq!")
}

test fn the_seed_classifies_the_same_fixture_cgroups_as_the_fold() -> Bool {
  let seed = filesystem_read(path: seed_user_work_scope_path).content
  let sessions = join([
    "0::",
    user_work_scope_user_slice_cgroup_needle,
    "user-1000.slice/user@1000.service/app.slice/",
    gunbc_oomd_sessions_slice as String,
    "/docker-deadbeef.scope",
  ], "")
  let system_svc = join(["0::/system.slice/", gunbc_tree_sync_unit_name as String], "")
  let sessions_wire = user_work_scope_standing_wire(
    s: user_work_scope_standing(
      unit_test: false,
      github_actions: false,
      cgroup: CgroupText { text: sessions }, bound: CgroupChainUnread { detail: "fixture" },
      user_manager_reachable: false,
      xdg_runtime_dir: false,
      slice_memory: RootMemoryUnreadable,
    ),
  )
  let system_wire = user_work_scope_standing_wire(
    s: user_work_scope_standing(
      unit_test: false,
      github_actions: false,
      cgroup: CgroupText { text: system_svc }, bound: CgroupChainUnread { detail: "fixture" },
      user_manager_reachable: false,
      xdg_runtime_dir: false,
      slice_memory: RootMemoryUnreadable,
    ),
  )
  let capped_wire = user_work_scope_standing_wire(
    s: user_work_scope_standing_with_root_memory(
      unit_test: false,
      github_actions: false,
      cgroup: CgroupText { text: "0::/" }, bound: CgroupChainUnread { detail: "fixture" },
      systemd_manager_present: false,
      user_manager_reachable: false,
      xdg_runtime_dir: false,
      root_memory: RootMemoryCapped { bytes: byte_size(25769803776) },
      slice_memory: RootMemoryUnreadable,
      buildbuddy_run_id: BuildBuddyRunIdAbsent,
    ),
  )
  let unbounded_wire = user_work_scope_standing_wire(
    s: user_work_scope_standing_with_root_memory(
      unit_test: false,
      github_actions: false,
      cgroup: CgroupText { text: "0::/" }, bound: CgroupChainUnread { detail: "fixture" },
      systemd_manager_present: false,
      user_manager_reachable: false,
      xdg_runtime_dir: false,
      root_memory: RootMemoryUnbounded,
      slice_memory: RootMemoryUnreadable,
      buildbuddy_run_id: BuildBuddyRunIdAbsent,
    ),
  )
  let modeled = join([
    "0::/",
    gunbc_repository_convergence_slice_unit_name as String,
    "/",
    gunbc_tree_sync_unit_name as String,
  ], "")
  let exempt_wire = user_work_scope_standing_wire(
    s: user_work_scope_standing(
      unit_test: false,
      github_actions: false,
      cgroup: CgroupText { text: modeled }, bound: CgroupChainUnread { detail: "fixture" },
      user_manager_reachable: false,
      xdg_runtime_dir: false,
      slice_memory: RootMemoryCapped { bytes: byte_size(1) },
    ),
  )
  let zero_slice_wire = user_work_scope_standing_wire(
    s: user_work_scope_standing(
      unit_test: false,
      github_actions: false,
      cgroup: CgroupText { text: modeled },
      bound: CgroupChainUnread { detail: "fixture" },
      user_manager_reachable: false,
      xdg_runtime_dir: false,
      slice_memory: RootMemoryCapped { bytes: byte_size(0) },
    ),
  )
  string_contains(s: seed, pattern: sessions)
    && string_contains(s: seed, pattern: system_svc)
    && string_contains(s: seed, pattern: "0::/")
    && string_contains(s: seed, pattern: modeled)
    && seed_fixture_assert_eq(seed: seed, wire: sessions_wire)
    && seed_fixture_assert_eq(seed: seed, wire: system_wire)
    && seed_fixture_assert_eq(seed: seed, wire: capped_wire)
    && seed_fixture_assert_eq(seed: seed, wire: unbounded_wire)
    && seed_fixture_assert_eq(seed: seed, wire: exempt_wire)
    && seed_fixture_assert_eq(seed: seed, wire: zero_slice_wire)
    && string_contains(s: seed, pattern: "fn modeled_slice_with_zero_memory_max_refuses")
    && seed_fixture_assert_eq(seed: seed, wire: "UncappedSystemSlice:sessions.slice:docker-deadbeef.scope")
    && seed_fixture_assert_eq(seed: seed, wire: "ExemptSystemUnit:sessions.slice:docker-deadbeef.scope:137438953472")
    && sessions_wire == "UncappedSystemSlice:sessions.slice:docker-deadbeef.scope"
    && system_wire == "UncappedSystemSlice:system.slice:gunbc-tree-sync.service"
    && capped_wire == "ExemptBoundedContainer:25769803776"
    && unbounded_wire == "BoundedContainerUncapped"
    && exempt_wire == "ExemptSystemUnit:gunbc-repository-convergence.slice:gunbc-tree-sync.service:1"
    && zero_slice_wire == "UncappedSystemSlice:gunbc-repository-convergence.slice:gunbc-tree-sync.service"
}

test fn a_path_segment_without_a_dot_suffix_is_not_a_unit() -> Bool {
  match system_service_unit_from_cgroup(text: "0::/system.slice/gunbc-tree-syncservice") {
    NotSystemService => true
    SystemServiceNamed { unit: _, slice: _ } => false
  }
}

test fn a_system_slice_named_service_cgroup_refuses_uncapped() -> Bool {
  let cg = join(["0::/system.slice/", gunbc_tree_sync_unit_name as String], "")
  match system_service_unit_from_cgroup(text: cg) {
    NotSystemService => false
    SystemServiceNamed { unit, slice } =>
      unit == (gunbc_tree_sync_unit_name as String)
        && slice == "system.slice"
        && match user_work_scope_standing(unit_test: false, github_actions: false, cgroup: CgroupText { text: cg }, bound: CgroupChainUnread { detail: "fixture" }, user_manager_reachable: false, xdg_runtime_dir: false, slice_memory: RootMemoryUnreadable) {
          UncappedSystemSlice { unit: u, slice: sl } =>
            u == unit
              && sl == "system.slice"
              && match user_work_scope_standing_effect(s: UncappedSystemSlice { unit: u, slice: sl }) {
                RefuseUserWorkScope { standing: UncappedSystemSlice { unit: ru, slice: rs } } =>
                  ru == u && rs == sl
                _ => false
              }
          _ => false
        }
  }
}

test fn tree_sync_under_its_declared_slice_is_exempt() -> Bool {
  let cg = join([
    "0::/",
    gunbc_repository_convergence_slice_unit_name as String,
    "/",
    gunbc_tree_sync_unit_name as String,
  ], "")
  match modeled_system_slice_memory_max(unit: gunbc_repository_convergence_slice_unit_name as String) {
    Absent => false
    Present { value: max } =>
      byte_size_count(b: max) == byte_size_count(b: repository_convergence_slice_memory_max)
        && match user_work_scope_standing(unit_test: false, github_actions: false, cgroup: CgroupText { text: cg }, bound: CgroupChainUnread { detail: "fixture" }, user_manager_reachable: false, xdg_runtime_dir: false, slice_memory: RootMemoryCapped { bytes: max }) {
          ExemptSystemUnit { unit, slice, bound } =>
            unit == (gunbc_tree_sync_unit_name as String)
              && slice == (gunbc_repository_convergence_slice_unit_name as String)
              && byte_size_count(b: bound) == byte_size_count(b: max)
              && match user_work_scope_standing_effect(s: ExemptSystemUnit { unit: unit, slice: slice, bound: bound }) {
                SkipUserWorkScope { standing: ExemptSystemUnit { unit: eu, slice: es, bound: eb } } =>
                  eu == unit && es == slice && byte_size_count(b: eb) == byte_size_count(b: bound)
                _ => false
              }
          _ => false
        }
  }
}

