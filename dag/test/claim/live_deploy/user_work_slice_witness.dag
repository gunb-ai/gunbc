    SliceControlRefused { cause: _ } => false
    SliceControlDerived { caps } =>
      non_empty_to_list(xs: caps).length() == 2
        && any(non_empty_to_list(xs: caps), c => c.unit as String == "sessions.slice" && byte_size_count(b: c.memory_max) == 137438953472)
        && any(non_empty_to_list(xs: caps), c => c.unit as String == "gunbc-approval-broker.slice" && byte_size_count(b: c.memory_max) == 17179869184 && byte_size_count(b: c.memory_high) == 15032385536)
        && match slice_control_caps_for(host: operator_host_srv3) {
          SliceControlNotOwed => true
          SliceControlDerived { caps: _ } => false
          SliceControlRefused { cause: _ } => false
        }
