// A reachable user manager does NOT rescue a recognized slice whose own memory.max reads max: the
// premise refuses rather than falling through to UserManagerOwed, which would hide the deficit behind
// a second envelope (review 80751).
test fn sessions_slice_with_an_unbounded_local_memory_max_refuses() -> Bool {
  let max_chain = chain(levels: [level_at(dir: join(["/sys/fs/cgroup/", gunbc_oomd_sessions_slice as String], ""), max: "max")], swap: ["0"])
  match user_work_scope_standing(unit_test: false, github_actions: false, cgroup: CgroupText { text: sessions_scope_cgroup() }, bound: max_chain, user_manager_reachable: true, xdg_runtime_dir: true) {
    UncappedEnclosingCgroup { premise: UnderModeledSlice { unit, slice }, cgroup: _, cause: NoFiniteMemoryMax } =>
      unit == "docker-deadbeef.scope" && slice == (gunbc_oomd_sessions_slice as String)
    _ => false
  }
    && match user_work_scope_standing_effect(s: user_work_scope_standing(unit_test: false, github_actions: false, cgroup: CgroupText { text: sessions_scope_cgroup() }, bound: max_chain, user_manager_reachable: true, xdg_runtime_dir: true)) {
      RefuseUserWorkScope { standing: _ } => true
      _ => false
    }
}

