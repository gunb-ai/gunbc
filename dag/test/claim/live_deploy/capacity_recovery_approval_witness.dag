test fn recovery_selects_the_existing_convergence_pattern_from_its_actual_scopes() -> Bool {
  match recovery_approval_request(choice: CapacityResume, generation: cas_generation_first(), escalation_id: "recovery-1") {
    Err { value: _ } => false
    Ok { value: recovery } => capacity_recovery_approval_root(recovery: recovery).approved_scopes == recovery.request.scopes
      && (match site_verdict(row: capacity_recovery_root_helper_site(recovery: recovery)).selection {
        PatternSelected { pattern: ApprovedConvergenceGrant, receipt: _ } => true
        _ => false
      })
  }
}


test fn journal_cas_consumes_approval_by_advancing_generation_without_changing_record() -> Bool {
  let request = match recovery_approval_request(choice: CapacityResume, generation: cas_generation_first(), escalation_id: "recovery-1") {
    Err { value: _ } => { return false } Ok { value: value } => value
  }
  let observed = recovery_approval_slot(record: recovery_fixture_record(), generation: cas_generation_first())
  let bytes = capacity_cutover_record_encode(record: recovery_fixture_record())
  match capacity_recovery_consume_journal(subject: request.subject, observed: observed,
    attempt: request.request.attempt, at: "2026-10-30T00:01:00Z", commit: verified => {
      if verified.attempt.proposed != bytes || verified.attempt.key != request.subject.journal_key {
        CasStoreRefused { cause: CasGenerationPublicationRefused { detail: "claim changed the record or slot" } }
      } else { cas_decide(attempt: verified.attempt, observed: observed) }
    }) {
    ClaimHeld { state: _, generation: generation } => match cas_generation_successor(g: request.subject.generation) {
      CasSuccessorGeneration { generation: next } => generation == next
      CasSuccessorExhausted { head: _ } => false
    }
    _ => false
  }
}

test fn a_competing_journal_cas_refuses_the_approved_generation() -> Bool {
  let request = match recovery_approval_request(choice: CapacityResume, generation: cas_generation_first(), escalation_id: "recovery-1") {
    Err { value: _ } => { return false } Ok { value: value } => value
  }
  let next = match cas_generation_successor(g: cas_generation_first()) {
    CasSuccessorGeneration { generation: value } => value CasSuccessorExhausted { head: _ } => { return false }
  }
  let stale = recovery_approval_slot(record: recovery_fixture_record(), generation: cas_generation_first())
  let current = recovery_approval_slot(record: recovery_fixture_record(), generation: next)
  match capacity_recovery_consume_journal(subject: request.subject, observed: stale,
    attempt: request.request.attempt, at: "2026-10-30T00:01:00Z",
    commit: verified => cas_decide(attempt: verified.attempt, observed: current)) {
    ClaimLost { holder: _ } => true
    _ => false
  }
}

test fn crash_after_consumption_requires_fresh_approval_of_the_successor() -> Bool {
  let old = match recovery_approval_request(choice: CapacityResume, generation: cas_generation_first(), escalation_id: "recovery-1") {
    Err { value: _ } => { return false } Ok { value: value } => value
  }
  let next = match cas_generation_successor(g: cas_generation_first()) {
    CasSuccessorGeneration { generation: value } => value CasSuccessorExhausted { head: _ } => { return false }
  }
  // Same payload after the claim CAS: no actuator progress is fabricated.
  let current = recovery_approval_slot(record: recovery_fixture_record(), generation: next)
  let fresh = match recovery_approval_request(choice: CapacityResume, generation: next, escalation_id: "recovery-2") {
    Err { value: _ } => { return false } Ok { value: value } => value
  }
  (match capacity_recovery_consume_journal(subject: old.subject, observed: current,
    attempt: old.request.attempt, at: "2026-10-30T00:02:00Z",
    commit: verified => cas_decide(attempt: verified.attempt, observed: current)) {
    ClaimLost { holder: _ } => true _ => false
  }) && (match capacity_recovery_execute(request: fresh,
    reread: fn() { recovery_approval_observation(record: recovery_fixture_record(), generation: next, choice: CapacityResume) },
    authorization: recovery_approval_grant(recovery: fresh), at: "2026-10-30T00:02:00Z",
    claim: (subject, attempt, at) => capacity_recovery_consume_journal(subject: subject, observed: current,
      attempt: attempt, at: at, commit: verified => cas_decide(attempt: verified.attempt, observed: current)),
    execute: admitted => Ok { value: admitted.recovery.subject.apply_reference == old.subject.apply_reference
      && admitted.recovery.request.attempt != old.request.attempt }) {
    Ok { value: reached } => reached Err { value: _ } => false
  })
}

fn recovery_program_fixture(record_after_claim: CapacityCutoverRecord, use_claimed_generation: Bool) -> Result<CapacityRecoveryProgram, String> {
  let request = match recovery_approval_request(choice: CapacityResume, generation: cas_generation_first(), escalation_id: "program-fixture") {
    Err { value: why } => { return Err { value: why } } Ok { value: value } => value
  }
  let observed = recovery_approval_slot(record: recovery_fixture_record(), generation: cas_generation_first())
  let authorization = match capacity_recovery_claim(request: request,
    reread: fn() { recovery_approval_observation(record: recovery_fixture_record(), generation: cas_generation_first(), choice: CapacityResume) },
    authorization: recovery_approval_grant(recovery: request), at: "2026-10-30T00:01:00Z",
    claim: (subject, attempt, at) => capacity_recovery_consume_journal(subject: subject, observed: observed, attempt: attempt, at: at,
      commit: verified => cas_decide(attempt: verified.attempt, observed: observed))) {
    Err { value: why } => { return Err { value: why } } Ok { value: value } => value
  }
  capacity_recovery_program_bind(authorization: authorization, journal_root: request.subject.journal_root,
    journal_key: request.subject.journal_key, helper_digest: request.subject.helper_digest,
    observed: recovery_approval_slot(record: record_after_claim,
      generation: if use_claimed_generation { authorization.journal_generation } else { request.subject.generation }))
}

test fn the_consumed_successor_binds_the_exact_recovery_program() -> Bool {
  match recovery_program_fixture(record_after_claim: recovery_fixture_record(), use_claimed_generation: true) {
    Err { value: _ } => false
    Ok { value: program } => match capacity_recovery_program_run(program: program,
      now: fn() { Ok { value: "2026-10-30T00:02:00Z" } }, perform: leg => Ok { value: leg }) {
      Err { value: _ } => false
      Ok { value: executed } => executed == program.legs && count(executed) > 0
    }
  }
}

test fn a_pre_consumption_observation_cannot_bind_an_executor() -> Bool {
  match recovery_program_fixture(record_after_claim: recovery_fixture_record(), use_claimed_generation: false) {
    Err { value: why } => why == "recovery journal moved after approval consumption"
    Ok { value: _ } => false
  }
}

test fn record_changes_after_consumption_refuse_before_execution() -> Bool {
  let before = recovery_fixture_record()
  let after = CapacityCutoverRecord { plan: before.plan, attempt: before.attempt, target_revision: before.target_revision,
    prior: before.prior, target: before.target, planned_paths: before.planned_paths, created_paths: before.created_paths,
    artifacts: before.artifacts, phase: CapacityCleanupOnly }
  match recovery_program_fixture(record_after_claim: after, use_claimed_generation: true) {
    Err { value: why } => why == "recovery journal moved after approval consumption"
    Ok { value: _ } => false
  }
}

test fn expired_recovery_consent_never_reaches_a_leg_port() -> Bool {
  match recovery_program_fixture(record_after_claim: recovery_fixture_record(), use_claimed_generation: true) {
    Err { value: _ } => false
    Ok { value: program } => match capacity_recovery_program_run(program: program,
      now: fn() { Ok { value: "2026-10-30T02:00:00Z" } }, perform: leg => Ok { value: "effect reached" }) {
      Err { value: why } => why != "effect reached"
      Ok { value: _ } => false
    }
  }
}

test fn an_out_of_program_ordinal_cannot_select_an_effect() -> Bool {
  match recovery_program_fixture(record_after_claim: recovery_fixture_record(), use_claimed_generation: true) {
    Err { value: _ } => false
    Ok { value: program } => match capacity_recovery_leg_admit(program: program, ordinal: count(program.legs), at: "2026-10-30T00:02:00Z") {
      Err { value: why } => why == "recovery leg ordinal is outside the approved program"
      Ok { value: _ } => false
    }
  }
}

test fn the_broker_adds_the_root_helper_scope_exactly_once() -> Bool {
  match recovery_approval_request(choice: CapacityResume, generation: cas_generation_first(), escalation_id: "root-scope-fixture") {
    Err { value: _ } => false
    Ok { value: request } => count(filter(request.request.scopes, scope => scope == capacity_root_helper_scope)) == 1
      && count(filter(request.subject.scopes, scope => scope == capacity_root_helper_scope)) == 0
  }
}

// The commit port returns a distinct error if invoked. The typed observation
// refusal must win before consumption, preserving even the journal generation.
test fn partial_removal_refuses_before_the_recovery_claim_cas() -> Bool {
  let record = recovery_two_masks_record()
  let request = match capacity_recovery_request(leg: CapacityRecoveryRequireApproval { attempt: record.attempt, choice: CapacityResume },
    observed: recovery_approval_observation(record: record, generation: cas_generation_first(), choice: CapacityResume),
    escalation_id: "partial-removal", execution_revision: record.target_revision as NonEmptyStr) {
    Err { value: _ } => { return false } Ok { value: value } => value
  }
  let present = filter(record.artifacts, artifact => artifact.identity.st_ino == 43)
  match capacity_recovery_claim_checked(request: request, journal_root: "/fixture/journal", key: "record",
    choice: CapacityResume, helper_digest: approval_fixture_helper_digest,
    observed: recovery_approval_slot(record: record, generation: cas_generation_first()),
    authorization: recovery_approval_grant(recovery: request), at: "2026-10-30T00:01:00Z",
    read_entry: path => recovery_mask_read(artifacts: present, path: path),
    commit: verified => CasStoreRefused { cause: CasGenerationPublicationRefused { detail: "unexpected journal mutation" } }) {
    Err { value: CapacityRecoveryPartialInhibitionRemoval { recorded: recorded, observed_present: found, observed_absent: missing } } =>
      recorded == record.artifacts && found == present
        && missing == filter(record.artifacts, artifact => artifact.identity.st_ino == 42)
    _ => false
  }
}

test fn intact_inhibition_allows_the_checked_journal_consumption() -> Bool {
  let record = recovery_fixture_record()
  let request = match recovery_approval_request(choice: CapacityResume, generation: cas_generation_first(), escalation_id: "intact-masks") {
    Err { value: _ } => { return false } Ok { value: value } => value
  }
  let observed = recovery_approval_slot(record: record, generation: cas_generation_first())
  match capacity_recovery_claim_checked(request: request, journal_root: "/fixture/journal", key: "record",
    choice: CapacityResume, helper_digest: approval_fixture_helper_digest, observed: observed,
    authorization: recovery_approval_grant(recovery: request), at: "2026-10-30T00:01:00Z",
    read_entry: path => recovery_mask_read(artifacts: record.artifacts, path: path),
    commit: verified => cas_decide(attempt: verified.attempt, observed: observed)) {
    Err { value: _ } => false
    Ok { value: admitted } => match cas_generation_successor(g: request.subject.generation) {
      CasSuccessorGeneration { generation: next } => admitted.journal_generation == next
      CasSuccessorExhausted { head: _ } => false
    }
  }
}
