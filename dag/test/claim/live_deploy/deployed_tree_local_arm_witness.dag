module test.claim.live_deploy.deployed_tree_local_arm_witness

// THE DISCRIMINATING CONTROLS FOR THE LOCAL ARM of the deployed-tree instrument, added for the srv1
// production fault: '/' answered 409 with a full daily-workspace body whose every issue row read
// "Unknown", because the standings-refresh fold's pair gate took the instance's OWN deployed tree over
// FleetSsh, `prepare_fleet_ssh_agent_context` refused ("SSH_AUTH_SOCK is unset or empty" -- live_deploy
// emits no agent and no unit carries the variable), the fold never wrote, and the read side replayed the
// frozen 2026-10-10 observation at ObservationStale. The boundary was the TRANSPORT: a remote leg was
// used where executor and subject are the same machine. These claims hold the repair to that boundary:
// the arm chooses the transport, the arm is not caller-chosen, and the repo travels with the arm.
//
// What these claims CANNOT say, and the PR says so: the join itself is a live registry reading, so the
// admit path needs a wet witness on the host (posted as the command and count in the PR body), and a
// mock here would certify the test's own assumption about what `hostname -s` answers.

import std.types { String, NonEmptyStr, List, Bool }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import gunbc.host.host_effect { HostEffectTransport, LocalShell, FleetSsh }
import gunbc.product.host_identity { HostIdentity }
import gunbc.live_deploy.deployed_tree_observation {
  DeployedTreeLocus,
  LocalTreeLocus,
  deployed_tree_locus_transport,
  deployed_tree_locus_repo,
  deployed_tree_locus_host,
  deployed_tree_local_leg,
  DeployedTreeLegOutcome,
  DeployedTreeLegNotAttempted,
  deployed_tree_local_admission_verdict,
  ObservedHostSelectorAgreed,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn probe_host() -> HostIdentity {
  "srv1" as HostIdentity
}

fn probe_repo() -> NonEmptyStr {
  "/opt/gunbc/gunbc" as NonEmptyStr
}

// THE ARM IS THE TRANSPORT, AND THE LOCAL ARM IS NOT AN SSH LEG: no context, no agent, no endpoint. If
// the local arm were wired to reuse the remote delivery, this is the claim that fails -- which is the
// exact shape of the production fault.
test fn witness_the_local_arm_is_delivered_locally() -> Bool {
  match deployed_tree_locus_transport(
    locus: LocalTreeLocus {
      host: probe_host(),
      repo: probe_repo(),
      attempt: "claim" as NonEmptyStr,
    },
  ) {
    LocalShell => true
    _ => false
  }
}

// THE LOCAL ARM DOES NOT LEAK A CREDENTIAL LEG: it is not the FleetSsh arm under another name, so it
// cannot fail closed on a host with no agent -- the failure that froze the observation for six weeks.
test fn witness_the_local_arm_names_no_fleetssh_transport() -> Bool {
  match deployed_tree_locus_transport(
    locus: LocalTreeLocus {
      host: probe_host(),
      repo: probe_repo(),
      attempt: "claim" as NonEmptyStr,
    },
  ) {
    FleetSsh { target: _, context: _ } => false
    _ => true
  }
}

// THE PAIR TRAVELS TOGETHER (the module's standing law, now across two arms): the locus carries the
// repo, and the observation can only be read at the repo the locus sealed. A cross-host conflation --
// reading some other path while claiming this host -- has no mint.
test fn witness_the_local_locus_seals_its_repo_and_host() -> Bool {
  let locus = LocalTreeLocus {
    host: probe_host(),
    repo: probe_repo(),
    attempt: "claim" as NonEmptyStr,
  }
  deployed_tree_locus_repo(locus: locus) == probe_repo()
    && deployed_tree_locus_host(locus: locus) == "srv1"
}

// THE JOIN IS THE ADMISSION, NOT THE CALLER'S WORD: a claimed host whose spelling is not the observed
// one is not Agreed, so a process cannot mint the local arm for a machine it is not standing on by
// naming that machine. (Refused or Unjoinable both satisfy this; only Agreed would be the hole.)
test fn witness_a_mismatched_host_is_never_admitted() -> Bool {
  match deployed_tree_local_admission_verdict(
    host: probe_host(),
    observed_hostname: "srv2",
  ) {
    ObservedHostSelectorAgreed { host: _ } => false
    _ => true
  }
}

// A LEG THAT NAMES NOTHING DOES NOT SPAWN: the local delivery refuses an empty argv rather than
// handing the shell an empty command line.
test fn witness_the_local_leg_refuses_an_empty_argv() -> Bool {
  match deployed_tree_local_leg(argv: [] as List<String>) {
    DeployedTreeLegNotAttempted { reason: _ } => true
    _ => false
  }
}
