// THE SUBJECT IS THE BROKER RELEASE'S HELPER GRANT (gunbc.live_deploy.emit) AND THE HELPER'S WIRE
// (gunbc.auth.approval_ntfy_runtime_observe). The literals below are grounded in the controlled
// fixture revision and root, not copied from a measurement of the tree.

fn rev_a() -> ReleaseRevisionBinding {
  RevisionBoundAtEmission { revision: deploy_witness_release_revision }
}

fn rev_b() -> ReleaseRevisionBinding {
  RevisionBoundAtEmission { revision: deploy_witness_other_release_revision }
}

data snapshot_a_dir: String = "/opt/gunbc/approval-broker-helpers/0123456789abcdef0123456789abcdef01234567"
data release_a_dir: String = "/opt/gunbc/approval-broker/releases/0123456789abcdef0123456789abcdef01234567"

// ── ARGV PIN ──────────────────────────────────────────────────────────────────────────────
// The exact words the verb runs. There is no --arg, and no word is a pattern. Every path names the
// root-owned snapshot of one release. STALE EXPECTATION (bisect: already false at #13818 parent):
// the pin omitted env(1) + GUNBC_WORKSPACE_ROOT, which gunbc_entry_run_argv has carried since
// #12563 (RunGunbcEntryAs / env_prefixed_argv). Sibling the_grant_line_is_pinned already names
// that binding. The name of the env var is the scaffold row, not a second literal.
test fn the_helper_argv_is_pinned_word_for_word() -> Bool {
  approval_ntfy_runtime_observe_helper_argv(revision: rev_a()) == [
    "/usr/bin/sudo", "-n", "-u", "gunbc-ntfy",
    "/usr/bin/env",
    concat(gunbc_workspace_root_env_name, concat("=", snapshot_a_dir)),
    concat(snapshot_a_dir, "/gunbc"),
    "run",
    "--source-root", concat(snapshot_a_dir, "/dag"),
    "--source-root", concat(snapshot_a_dir, "/src/v2"),
    "--entry", concat(snapshot_a_dir, "/dag/gunbc/auth/approval_ntfy_runtime_observe.dag"),
    "--function", "approval_ntfy_runtime_observe",
  ]
}

test fn the_grant_line_is_pinned() -> Bool {
  (approval_broker_helper_sudoers_line(revision: rev_a()) as String) == join([
    "briansrls ALL=(gunbc-ntfy) NOPASSWD: /usr/bin/env GUNBC_WORKSPACE_ROOT\\=", snapshot_a_dir, " ",
    snapshot_a_dir, "/gunbc run --source-root ", snapshot_a_dir, "/dag --source-root ", snapshot_a_dir,
    "/src/v2 --entry ", snapshot_a_dir, "/dag/gunbc/auth/approval_ntfy_runtime_observe.dag --function approval_ntfy_runtime_observe",
  ], "")
}

// ── THE GRANT AUTHORIZES EXACTLY ITS OWN RELEASE'S ARGV ────────────────────────────────────
// sudo matches the words after its own four (`sudo -n -u <user>`) against the Cmnd, reading the
// Cmnd's escapes (sudoers(5): `,` `:` `=` `\` are backslash-escaped in arguments). So the argv words
// are compared in the escaped spelling. The env(1) binding carries a `=`, and without the escape the
// line would not name this argv.
fn command_words_after_sudo(argv: List<String>) -> String {
  join(map(argv |> skip(n: 4), w => sudoers_argument_word(w: w)), " ")
}

fn grant_authorizes(line: NonEmptyStr, argv: List<String>) -> Bool {
  ends_with(s: line as String, suffix: concat("NOPASSWD: ", command_words_after_sudo(argv: argv)))
}

test fn the_grant_authorizes_its_own_release_argv() -> Bool {
  grant_authorizes(line: approval_broker_helper_sudoers_line(revision: rev_a()), argv: approval_ntfy_runtime_observe_helper_argv(revision: rev_a()))
}

// RED: A GRANT NAMING A DIFFERENT SHA does not authorize this release, in either direction.
test fn a_grant_for_another_release_does_not_authorize_this_one() -> Bool {
  !grant_authorizes(line: approval_broker_helper_sudoers_line(revision: rev_a()), argv: approval_ntfy_runtime_observe_helper_argv(revision: rev_b()))
    && !grant_authorizes(line: approval_broker_helper_sudoers_line(revision: rev_b()), argv: approval_ntfy_runtime_observe_helper_argv(revision: rev_a()))
}

// ── RED: A STALE RELEASE'S LINE SURVIVING ─────────────────────────────────────────────────
// The drop-in is the whole grant population: exactly one non-comment line, naming only the release
// being installed. The rename replaces the file whole, so installing B leaves no line for A.
fn grant_lines(content: String) -> List<String> {
  fold(split(s: content, delimiter: "\n"), init: [], f: (acc, l) =>
    if l == "" || starts_with(s: l, prefix: "#") { acc } else { concat(acc, [l]) })
}

test fn installing_release_b_leaves_no_line_for_release_a() -> Bool {
  let content_b = approval_broker_helper_sudoers_content(revision: rev_b())
  count(grant_lines(content: content_b)) == 1
    && !string_contains(s: content_b, pattern: snapshot_a_dir)
    && string_contains(s: content_b, pattern: "/opt/gunbc/approval-broker-helpers/89abcdef0123456789abcdef0123456789abcdef/")
}

// ── RED: A MALFORMED SUDOERS LINE IS NOT EMITTED ──────────────────────────────────────────
test fn a_sudoers_special_word_refuses_the_grant() -> Bool {
  let refused = match approval_broker_helper_grant_admission_at(
    locus: HelperLocus { base: "/opt/gunbc/approval,broker", owner: "root" as NonEmptyStr },
    revision: rev_a(),
  ) {
    HelperGrantWordRefused { word: w } => string_contains(s: w, pattern: ",")
    HelperGrantAdmitted => false
    HelperGrantLocusWritableByGrantee { owner: _ } => false
  }
  let unbound_refused = match approval_broker_helper_grant_admission(revision: RevisionNotInstalled) {
    HelperGrantWordRefused { word: _ } => true
    HelperGrantAdmitted => false
    HelperGrantLocusWritableByGrantee { owner: _ } => false
  }
  refused && unbound_refused
}

// ── WALL 1: THE GRANTEE CANNOT WRITE WHAT THE GRANT EXECUTES ────────────────────────────────
// RED: a grantee-writable locus gets no grant. The release directory is owned by the broker's service
// user, which is the grantee, so a grant over it is refused. The positive control is the root-owned
// snapshot locus, which is admitted.
test fn a_grantee_writable_locus_gets_no_grant() -> Bool {
  match approval_broker_helper_grant_admission_at(locus: approval_broker_release_locus(spec: deployment_spec_srv1()), revision: rev_a()) {
    HelperGrantLocusWritableByGrantee { owner: o } => (o as String) == "briansrls"
    HelperGrantAdmitted => false
    HelperGrantWordRefused { word: _ } => false
  }
}

test fn the_root_owned_snapshot_locus_is_admitted() -> Bool {
  match approval_broker_helper_grant_admission(revision: rev_a()) {
    HelperGrantAdmitted => true
    HelperGrantWordRefused { word: _ } => false
    HelperGrantLocusWritableByGrantee { owner: _ } => false
  }
}

// A SOURCE BYTE REPLACED AFTER INSTALL IS IMPOSSIBLE, NOT DETECTED. Nothing the grant names lies in the
// grantee-owned release directory, and the snapshot is copied by root from the checkout, not from
// that directory. Before any grant is written, the install stops unless the snapshot and every
// ancestor are root-owned, not group- or world-writable, and contain no symlink.
test fn nothing_the_grant_executes_is_in_the_grantee_owned_release() -> Bool {
  let line = approval_broker_helper_sudoers_line(revision: rev_a()) as String
  let snapshot = pipeline_steps_text(steps: approval_broker_helper_snapshot_steps(revision: rev_a()))
  !string_contains(s: line, pattern: release_a_dir)
    && !string_contains(s: snapshot, pattern: release_a_dir)
    && string_contains(s: snapshot, pattern: "\"$PWD\"'/dag'")
    && string_contains(s: snapshot, pattern: "'--no-preserve=all'")
    && string_contains(s: snapshot, pattern: "'-P'")
}

test fn the_snapshot_readback_covers_every_ancestor_and_refuses_links() -> Bool {
  path_ancestors_inclusive(path: "/opt/gunbc/approval-broker-helpers") == ["/", "/opt", "/opt/gunbc", "/opt/gunbc/approval-broker-helpers"]
    && string_contains(s: step_text_at(i: 9), pattern: "_gunbc_helper_ancestors=$('find' '/' '/opt' '/opt/gunbc' '/opt/gunbc/approval-broker-helpers' '-maxdepth' '0' '(' '!' '-user' 'root' '-o' '-perm' '/022' '-o' '-type' 'l' ')' '-print')\n")
    && string_contains(s: step_text_at(i: 9), pattern: "_gunbc_helper_snapshot=$('find' ")
    && ends_with(s: step_text_at(i: 9), suffix: "'test' '-z' \"$_gunbc_helper_ancestors\"\"$_gunbc_helper_snapshot\"")
    && string_contains(s: step_text_at(i: 8), pattern: "candidate_revision=0123456789abcdef0123456789abcdef01234567")
    && string_contains(s: step_text_at(i: 8), pattern: "-o root -g root /dev/stdin /opt/gunbc/approval-broker-helpers/0123456789abcdef0123456789abcdef01234567/.gunbc-tree-receipt")
}

// ── WALL 2: THE DROP-IN'S IDENTITY AND AN ATOMIC REPLACE ──────────────────────────────────
fn step_text_at(i: Int) -> String {
  match approval_broker_helper_grant_steps(principal: fleet_posix_ci_runner_principal(), spec: deployment_spec_srv1(), revision: rev_a()) |> skip(n: i) |> first {
    Present { value: st } => pipeline_step_text(st: st)
    Absent => ""
  }
}

// Steps 0-9 are the snapshot (8 writes its tree receipt, 9 reads it back), 10-17 the grant, and 18
// retires previous snapshot directories.
//   10 stage  11 visudo -cf staged  12 install root:root 0440 to the dotted temp name
//   13 visudo -c -O -P -f temp     14 mv -T temp final  15 visudo -c -O -P -f final
//   16 privileged read of final into the stage           17 cmp
test fn the_grant_replaces_atomically_and_reads_back_identity_and_bytes() -> Bool {
  let temp = approval_broker_helper_sudoers_temp_path as String
  let final_path = approval_broker_helper_sudoers_path as String
  count(approval_broker_helper_grant_steps(principal: fleet_posix_ci_runner_principal(), spec: deployment_spec_srv1(), revision: rev_a())) == 19
    && string_contains(s: step_text_at(i: 10), pattern: "NOPASSWD:")
    && string_contains(s: step_text_at(i: 11), pattern: "'-cf'")
    && string_contains(s: step_text_at(i: 12), pattern: "'-o' 'root' '-g' 'root'")
    && string_contains(s: step_text_at(i: 12), pattern: "'0440'")
    && string_contains(s: step_text_at(i: 12), pattern: temp)
    && !string_contains(s: step_text_at(i: 12), pattern: "ghrunner")
    && string_contains(s: step_text_at(i: 13), pattern: "'-c' '-O' '-P' '-f'")
    && string_contains(s: step_text_at(i: 13), pattern: temp)
    && string_contains(s: step_text_at(i: 14), pattern: "'/usr/bin/mv' '-T'")
    && string_contains(s: step_text_at(i: 15), pattern: "'-c' '-O' '-P' '-f'")
    && ends_with(s: step_text_at(i: 15), suffix: concat(final_path, "'"))
    && string_contains(s: step_text_at(i: 16), pattern: final_path)
    && starts_with(s: step_text_at(i: 17), prefix: "'cmp'")
    && !string_contains(s: step_text_at(i: 17), pattern: "'-s'")
    && string_contains(s: step_text_at(i: 18), pattern: "'-type' 'd' '!' '-name' '0123456789abcdef0123456789abcdef01234567' '-exec' '/usr/bin/sudo' '-n' '/usr/bin/rm' '-rf' '--' '{}' '+'")
}

// ── WALL 2b: EVERY PRINCIPAL-SENSITIVE FACT OF THE APPLY DERIVES FROM ITS ONE DeployAccess ──────
// The gated dispatcher (gunbc.host.host_effect_realize host_effect_apply_gated) hands its one
// DeployAccess to realize_live_deploy_apply_on_host, which hands it to live_deploy_apply_script_for,
// which hands it to apply_intent_from_effects: the last pure link before the script runs, so these
// claims supply the access there and read the apply it emits. Two facts in that apply depend on who
// applies. The helper sudoers readback is compared unprivileged by the applying principal, so it must
// be owned by that principal; owned by the CI runner principal under every apply, the operator-local
// apply could not read it (`cmp` exit 2, srv1 prod 2026-10-12, twice). And the post-install roster
// probe must demand every command the apply then spends, so a miss refuses before any other mutation.
fn apply_step_texts_for(access: DeployAccess) -> List<String> {
  let spec = deployment_spec_srv1()
  map(
    apply_intent_from_effects(
      spec: spec,
      effects: apply_empty_host_effects(spec: spec),
      access: access,
      plan: deploy_witness_full_install_plan(spec: spec),
      cap_authorization: CapConvergeWithheld { cause: "the principal claims are not about the cap step" },
      oidc_now: claim_oidc_now(),
      object_source_serve: apply_complete_object_source_serve(),
    ).steps,
    st => pipeline_step_text(st: st)
  )
}

data operator_local_apply_step_texts: List<String> = apply_step_texts_for(access: ci_deploy_srv1_operator_local_access)
data ci_apply_step_texts: List<String> = apply_step_texts_for(access: ci_deploy_srv1_access)

fn readback_install_texts(texts: List<String>) -> List<String> {
  filter(xs: texts, predicate: t => string_contains(s: t, pattern: approval_broker_helper_sudoers_readback_stage_name) && string_contains(s: t, pattern: "'-o' '"))
}

fn readback_is_owned_by(texts: List<String>, principal: GroundedPosixPrincipal) -> Bool {
  let name = grounded_posix_principal_name(p: principal) as String
  let owner = join(["'-o' '", name, "' '-g' '", name, "'"], "")
  let readbacks = readback_install_texts(texts: texts)
  readbacks.length() == 1 && filter(xs: readbacks, predicate: t => !string_contains(s: t, pattern: owner)).length() == 0
}

fn probe_refusal_text(cmd: PrivilegedCommand) -> String {
  join([deploy_sudoers_post_install_refusal_prefix, " ", cmd.grant.command_path as String], "")
}

fn apply_probes_each(texts: List<String>, commands: List<PrivilegedCommand>) -> Bool {
  let program = join(texts, "\n")
  filter(xs: commands, predicate: c => !string_contains(s: program, pattern: probe_refusal_text(cmd: c))).length() == 0
}

// THE APPLY IS EMITTED FROM `access`: its readback is owned by that access's principal, and its
// post-install probe demands that access's commands, which cover every command the apply spends.
fn apply_is_emitted_from(access: DeployAccess, texts: List<String>) -> Bool {
  readback_is_owned_by(texts: texts, principal: access.principal)
    && apply_probes_each(texts: texts, commands: access.privileged_commands)
    && apply_probes_each(texts: texts, commands: live_deploy_spent_privileged_commands())
}

// RED on main, where the readback was owned by the CI runner principal under every apply.
test fn the_operator_local_apply_is_emitted_from_the_operator_local_access() -> Bool {
  apply_is_emitted_from(access: ci_deploy_srv1_operator_local_access, texts: operator_local_apply_step_texts)
    && readback_is_owned_by(texts: operator_local_apply_step_texts, principal: fleet_posix_operator_principal())
}

// POSITIVE CONTROL: the CI apply is still its own access's, byte for byte as before.
test fn the_ci_apply_is_emitted_from_the_ci_access() -> Bool {
  apply_is_emitted_from(access: ci_deploy_srv1_access, texts: ci_apply_step_texts)
    && readback_is_owned_by(texts: ci_apply_step_texts, principal: fleet_posix_ci_runner_principal())
}

// THE MUTANTS: an apply whose readback belongs to one principal judged as the other's fails both
// ways, so the predicate above discriminates the pairing rather than holding of any apply.
test fn an_apply_paired_with_the_other_principal_fails() -> Bool {
  !apply_is_emitted_from(access: ci_deploy_srv1_operator_local_access, texts: ci_apply_step_texts)
    && !apply_is_emitted_from(access: ci_deploy_srv1_access, texts: operator_local_apply_step_texts)
}

// THE OPERATOR'S GRANT IS NOT ITS DEMAND. An operator-local access whose demand is the operator's
// own grant roster (hostnamectl alone, gunbc.fleet.fleet_posix_accounts
// fleet_posix_operator_sudo_grants) emits an apply whose probe checks one command and then spends
// the roster unprobed; this is the access the operator-local entry would have carried had its
// demand been projected from its grants, and the claim fails it through the same route.
test fn an_operator_local_apply_that_probes_only_the_operator_grant_fails() -> Bool {
  let principal = fleet_posix_operator_principal()
  let granted_only = DeployAccess {
    principal: principal,
    host: ci_deploy_srv1_operator_local_access.host,
    transport: ci_deploy_srv1_operator_local_access.transport,
    privileged_commands: map(principal.sudo_grants, g => posix_sudo_grant_to_privileged(g: g)),
  }
  !apply_is_emitted_from(access: granted_only, texts: apply_step_texts_for(access: granted_only))
    && readback_is_owned_by(texts: apply_step_texts_for(access: granted_only), principal: principal)
}

// THE SAME AUTHORITY AS THE RECEIPT: the readback's owner is the very name the v4 receipt's
// provenance renders for the operator-local apply (gunbc.live_deploy.apply
// live_deploy_operator_local_admitted: principal: grounded_posix_principal_name(p: access.principal)).
test fn the_readback_owner_is_the_name_the_receipt_provenance_carries() -> Bool {
  let name = grounded_posix_principal_name(p: ci_deploy_srv1_operator_local_access.principal) as String
  name == "briansrls" && readback_is_owned_by(texts: operator_local_apply_step_texts, principal: ci_deploy_srv1_operator_local_access.principal)
}

// INTERRUPTION BEFORE THE RENAME LEAVES THE PREVIOUS POLICY: sudoers(5) skips an #includedir file
// whose name contains a `.`, so the temp file is never read by sudo, whatever state it is in. The
// final name contains none, so the renamed file is included.
fn basename(p: String) -> String {
  match split(s: p, delimiter: "/") |> last {
    Present { value: b } => b
    Absent => p
  }
}

test fn only_the_renamed_file_is_ever_included_by_sudo() -> Bool {
  string_contains(s: basename(p: approval_broker_helper_sudoers_temp_path as String), pattern: ".")
    && !string_contains(s: basename(p: approval_broker_helper_sudoers_path as String), pattern: ".")
    && !string_contains(s: basename(p: approval_broker_helper_sudoers_path as String), pattern: "~")
}

// ── THE RUN-AS GENERALISATION MOVES NO EXISTING GRANT ──────────────────────────────────────
test fn a_root_operation_still_renders_root_and_plain_sudo() -> Bool {
  (executor_privileged_operation_sudoers_line(grantee: "ghrunner" as NonEmptyStr, op: SystemdDaemonReload) as String)
    == "ghrunner ALL=(root) NOPASSWD: /usr/bin/systemctl daemon-reload"
    && executor_privileged_operation_elevated_argv(op: SystemdDaemonReload)
      == sudo_elevate_argv(command: map(executor_privileged_operation_argv(op: SystemdDaemonReload), w => w as String))
}

// ── THE REVISION REACHES THE VERB AS A NAMED ARGUMENT ─────────────────────────────────────
test fn the_revision_argument_names_the_release() -> Bool {
  match approval_broker_release_revision_argument(revision: rev_a()) {
    NamedArgumentAdmitted { argument: a } =>
      a.name == "release_revision" && a.value == "0123456789abcdef0123456789abcdef01234567"
    NamedArgumentNameEmpty => false
    NamedArgumentNameHoldsSeparator { name: _ } => false
  }
}

// ── THE HELPER'S WIRE ────────────────────────────────────────────────────────────────────
data sample_observation: NtfyRuntimeProcessObservation = NtfyRuntimeProcessObservation {
  main_pid: 4242,
  start_ticks_before: 991,
  start_ticks_after: 991,
  environment_names: ["LANG", "PATH"],
  exe_target: "/usr/local/bin/ntfy",
  exe_inode: 131,
  open_fds: [
    NtfyOpenFd { target: "/var/lib/gunbc-ntfy/auth.db (deleted)", target_inode: 77 },
    NtfyOpenFd { target: "socket:[55123]", target_inode: 55123 },
    NtfyOpenFd { target: "/tmp/a=b c", target_inode: 12 },
  ],
}

fn round_trips(o: NtfyRuntimeObserveOutcome) -> Bool {
  match ntfy_runtime_observe_decode(text: ntfy_runtime_observe_encode(outcome: o)) {
    NtfyRuntimeReadingDecoded { outcome: back } => back == o
    NtfyRuntimeReadingUndecodable { cause: _ } => false
  }
}

// Verbatim targets survive, including ` (deleted)`, `socket:[N]`, `=`, spaces and a newline.
test fn an_observation_round_trips_verbatim() -> Bool {
  round_trips(o: NtfyRuntimeObserved { observation: sample_observation })
    && round_trips(o: NtfyRuntimeObserved { observation: NtfyRuntimeProcessObservation {
      main_pid: 4242, start_ticks_before: 1, start_ticks_after: 1, environment_names: [],
      exe_target: "/usr/local/bin/ntfy", exe_inode: 1,
      open_fds: [NtfyOpenFd { target: "/tmp/a\nb \"q\"", target_inode: 2 }],
    } })
}

test fn a_refusal_round_trips() -> Bool {
  round_trips(o: NtfyRuntimeObserveRefused { read: "unit", cause: "ActiveState=inactive MainPID=0" })
}

fn undecodable(text: String) -> Bool {
  match ntfy_runtime_observe_decode(text: text) {
    NtfyRuntimeReadingUndecodable { cause: _ } => true
    NtfyRuntimeReadingDecoded { outcome: _ } => false
  }
}

data observed_head: String = "{\"outcome\":\"observed\",\"start_ticks_before\":1,\"start_ticks_after\":1,\"environment_names\":[\"LANG\"],\"exe_target\":\"/usr/local/bin/ntfy\",\"exe_inode\":1,\"open_fds\":[{\"target\":\"socket:[5]\",\"target_inode\":5}]"

fn observed_with(tail: String) -> String {
  concat(observed_head, concat(tail, "}"))
}

data refused_ok: String = "{\"outcome\":\"refused\",\"read\":\"unit\",\"cause\":\"inactive\"}"

// REDs over the decoder. Each is one defect away from an accepted text, and the first two conjuncts
// are the positive controls. The mixed-outcome cases are review 70435's: each arm must refuse the
// other arm's members instead of dropping them.
test fn the_decoder_refuses_every_malformed_text() -> Bool {
  !undecodable(text: observed_with(tail: ",\"main_pid\":7"))
    && !undecodable(text: refused_ok)
    && undecodable(text: observed_with(tail: ",\"main_pid\":7,\"read\":\"unit\",\"cause\":\"x\""))
    && undecodable(text: "{\"outcome\":\"refused\",\"read\":\"unit\",\"cause\":\"inactive\",\"main_pid\":7,\"open_fds\":[]}")
    && undecodable(text: observed_head)
    && undecodable(text: observed_with(tail: ""))
    && undecodable(text: observed_with(tail: ",\"main_pid\":0"))
    && undecodable(text: observed_with(tail: ",\"main_pid\":7,\"main_pid\":8"))
    && undecodable(text: observed_with(tail: ",\"main_pid\":\"7\""))
    && undecodable(text: observed_with(tail: ",\"main_pid\":7,\"surprise\":1"))
    && undecodable(text: concat(
      "{\"outcome\":\"observed\",\"main_pid\":7,\"start_ticks_before\":1,\"start_ticks_after\":1,\"environment_names\":[],\"exe_target\":\"/usr/local/bin/ntfy\",\"exe_inode\":1,",
      "\"open_fds\":[{\"target\":\"socket:[5]\",\"target_inode\":5,\"mode\":1}]}",
    ))
    && undecodable(text: "{\"outcome\":\"maybe\"}")
    && undecodable(text: "outcome=observed\n")
}

// §3b: THE GRANT IS A PRIVILEGED-EFFECT SITE, CLASSIFIED BY EXECUTING THE SELECTION (review 70452).
// The verdict is computed by gunbc.auth.privileged_effect_census, not stated here.
test fn the_helper_grant_site_conforms_in_the_privileged_effect_census() -> Bool {
  let hits = filter(census_verdicts(), v => v.site.module_path == "gunbc.live_deploy.emit" && v.site.decl_name == "approval_broker_helper_grant_steps")
  count(hits) == 1 && all(hits, v => match v.conformance {
    Conforms => true
    DivergesWithReason { reason: _ } => false
    Diverges => false
    SiteNotDecidable { standing: _ } => false
  })
}
