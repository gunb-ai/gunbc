module test.claim.live_deploy.observed_sha256_guard_real_execution

import std.logic { Bool }
import std.types { String }
import std.optional { Present, Absent }
import extdeps.exec.command { LocalExec }
import extdeps.languages.bash.invocation { bash_program_command }
import gunbc.command_runner { run_shell_command_observe }
import gunbc.live_deploy.operations { deploy_observed_digest_var, deploy_stage_dir_var, deploy_stage_read_command }
import gunbc.live_deploy.emit {
  deploy_stage_cleanup_frame_pipeline, deploy_observed_sha256_guarded_write_steps, emit_pipeline_or_poison, deploy_raw,
}
import v2.std.orchestration { Pipeline, Let, ExprLit, FailFast }
import gunbc.shell_command_text { shell_command_text_of_argv }
import std.content_hash { lower_hex_64 }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE OBSERVED-SHA256 GUARD, BY REAL EXECUTION OF THE EMITTED PIPELINE. The refusal is a fact about what bash does
// with the steps gunbc.live_deploy.emit deploy_observed_sha256_guarded_write_steps emits, so this renders exactly
// those steps (the If-Not-admitted then Exit 1, and the staged write) through the orchestration-to-bash emitter
// (emit_pipeline_or_poison) inside the real stage-directory frame (deploy_stage_cleanup_frame_pipeline), with the
// Let that binds the observation replaced by a fixture ExprLit, and executes that text. Nothing here spells shell:
// changing the emitted If, its Exit or its guard changes what runs. A refused line must exit nonzero, never reach
// the marker and print no staged file.
data write_marker: String = "GUNBC-DIGEST-WRITE-REACHED"
data stage_file: String = "digest.env"
data hex64: String = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

fn guard_pipeline(observed_line: String) -> Pipeline {
  let frame = deploy_stage_cleanup_frame_pipeline(bind_vars: [deploy_stage_dir_var], trap_vars: [deploy_stage_dir_var])
  Pipeline {
    steps: concat(
      concat(frame.steps, [Let { name: deploy_observed_digest_var, value: ExprLit { spelling: observed_line } }]),
      concat(
        deploy_observed_sha256_guarded_write_steps(env_name: "NAME", stage_name: stage_file),
        [
          deploy_raw(command: deploy_stage_read_command(stage_name: stage_file)),
          deploy_raw(command: shell_command_text_of_argv(argv: ["echo", write_marker])),
        ],
      ),
    ),
    on_failure: FailFast,
  }
}

fn guard_program(observed_line: String) -> String {
  emit_pipeline_or_poison(p: guard_pipeline(observed_line: observed_line), refused: "exit 97")
}

fn refused(observed_line: String) -> Bool {
  let obs = run_shell_command_observe(command: bash_program_command(script: guard_program(observed_line: observed_line)), transport: LocalExec)
  obs.exit_code != 0 && !string_contains(s: obs.stdout, pattern: write_marker) && !string_contains(s: obs.stdout, pattern: "NAME=")
}

// POSITIVE CONTROL: a well-formed sha256sum line is admitted and writes exactly NAME=<its 64 digits>.
test fn a_valid_sha256sum_line_is_written_by_real_execution() -> Bool {
  let obs = run_shell_command_observe(
    command: bash_program_command(script: guard_program(observed_line: join([hex64, "  /opt/x/bin"], ""))),
    transport: LocalExec,
  )
  obs.exit_code == 0 && string_contains(s: obs.stdout, pattern: join(["NAME=", hex64], "")) && string_contains(s: obs.stdout, pattern: write_marker)
}

// RED: empty, 63-digit, uppercase, non-hex and missing-separator observations are each refused before any write.
test fn an_empty_observation_is_refused_before_any_write_by_real_execution() -> Bool {
  refused(observed_line: "")
}

test fn a_short_digest_is_refused_before_any_write_by_real_execution() -> Bool {
  refused(observed_line: "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcde  /opt/x/bin")
}

test fn an_uppercase_digest_is_refused_before_any_write_by_real_execution() -> Bool {
  refused(observed_line: "0123456789ABCDEF0123456789abcdef0123456789abcdef0123456789abcdef  /opt/x/bin")
}

test fn a_non_hex_digest_is_refused_before_any_write_by_real_execution() -> Bool {
  refused(observed_line: "zzzz456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef  /opt/x/bin")
}

// MISSING SEPARATOR: a 64-digit line with no separator, and one with a single space, are refused -- the two-space
// separator is half of deploy_observed_sha256_line_ere.
test fn a_digest_without_the_separator_is_refused_before_any_write_by_real_execution() -> Bool {
  refused(observed_line: hex64)
}

test fn a_digest_with_a_single_space_separator_is_refused_before_any_write_by_real_execution() -> Bool {
  refused(observed_line: join([hex64, " /opt/x/bin"], ""))
}

fn first_field(line: String) -> String {
  match get(xs: split(s: line, delimiter: " "), index: 0) {
    Present { value: f } => f
    Absent => ""
  }
}

// AGREEMENT, BY EXECUTION: for each fixture line whose separator is well formed, the real guard refuses exactly when
// std.content_hash lower_hex_64 rejects the line's first field. The grep pattern is derived from the validator's
// width (lower_hex_prefix_ere); this is the claim that the derivation did not drift.
fn guard_agrees(line: String) -> Bool {
  let obs = run_shell_command_observe(command: bash_program_command(script: guard_program(observed_line: line)), transport: LocalExec)
  (obs.exit_code == 0) == lower_hex_64(value: first_field(line: line))
}

test fn the_guard_agrees_with_the_sha256_digest_hex_validator() -> Bool {
  guard_agrees(line: join([hex64, "  /p"], ""))
    && guard_agrees(line: "  /p")
    && guard_agrees(line: "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcde  /p")
    && guard_agrees(line: "0123456789ABCDEF0123456789abcdef0123456789abcdef0123456789abcdef  /p")
    && guard_agrees(line: "zzzz456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef  /p")
}
