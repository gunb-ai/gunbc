// THE PLAN'S SERVE-ENTRY VERDICT, WITNESSED AT THE DISTINCTIONS IT EXISTS FOR. The rule the document
// carries is: the swap consumes the plan's compile answer for ITS OWN ROW ONLY -- the row of the
// document whose (subject_host, instance_id) is the picked deployment's address, inside a document
// every row of which the roster knows -- and then ONLY under a four-way identity match (source
// revision, entry, serve argv, release binary). Every other case refuses BY NAME with no cold resolve
// behind it. Each witness flips exactly one thing.
//
// WHAT THIS FILE GREW FOR (deploy2 run 45749803682): the requirement used to be scoped by prod-role
// identity, so the lab row -- which is not the fleet prod-role holder -- was exempted inside a CI
// transaction that DID have a plan job, took the cold serve-entry compile, and met the 60-minute
// bound. The scope is now the admitted plan run pointer, read through the ONE constant the pointer
// admission itself reads, and the plan produces a row for every roster row the CI apply selection
// accepts. The legs below are the two halves of that claim: the pointer decides the arm for BOTH
// rows, and the producer's row set and dedupe come from the deploy job's own selection.

// THE POINTER TEXT the pointer-keyed legs supply. A non-empty run id is what an admitted pointer is;
// the empty string is what an operator-local run has.
data pointer_present_text: String = "45722153952"
data pointer_absent_text: String = ""

data fixture_revision: String = "0123456789abcdef0123456789abcdef01234567"
data fixture_entry: String = "dag/gunbc/roadmap/roadmap_serve.dag"
data fixture_argv_digest: String = "argv-digest-aaa"
data fixture_bin_hex: String = "bin-digest-bbb"

// THE TWO ADDRESSES THE ROSTER ACTUALLY KNOWS, read from the roster itself rather than restated: a
// fixture that invented a host would pass against a model whose roster had no such row, which is the
// very confusion the row-absent and foreign-row refusals exist to prevent.
fn prod_subject() -> String {
  srv1_production_desired_deployment().target.host.identity as String
}

fn prod_instance() -> String {
  instance_id_text(id: srv1_production_desired_deployment().instance.instance_id)
}

fn lab_subject() -> String {
  srv1_lab_desired_deployment().target.host.identity as String
}

fn lab_instance() -> String {
  instance_id_text(id: srv1_lab_desired_deployment().instance.instance_id)
}

fn fixture_row(subject_host: String, instance_id: String, compile: ServeEntryCompileVerdict) -> ServeEntryVerdictRecord {
  ServeEntryVerdictRecord {
    subject_host: subject_host,
    instance_id: instance_id,
    source_revision: fixture_revision,
    entry: fixture_entry,
    argv_digest: fixture_argv_digest,
    compiler_bin_sha256_hex: fixture_bin_hex,
    compile: compile,
  }
}

fn fixture_admitted() -> ServeEntryVerdictRecord {
  fixture_row(subject_host: prod_subject(), instance_id: prod_instance(), compile: ServeEntryCompileAdmitted)
}

fn fixture_blocked() -> ServeEntryVerdictRecord {
  fixture_row(
    subject_host: prod_subject(),
    instance_id: prod_instance(),
    compile: ServeEntryCompileBlocked {
      blocking: 2,
      diagnostics: ["type error at roadmap_serve.dag:1", "unresolved import x"] as List<String>,
    },
  )
}

fn fixture_unobserved() -> ServeEntryVerdictRecord {
  fixture_row(
    subject_host: prod_subject(),
    instance_id: prod_instance(),
    compile: ServeEntryCompileUnobserved { detail: "spawn refused" },
  )
}

fn fixture_lab_admitted() -> ServeEntryVerdictRecord {
  fixture_row(subject_host: lab_subject(), instance_id: lab_instance(), compile: ServeEntryCompileAdmitted)
}

fn record_tag(record: ServeEntryVerdictRecord) -> String {
  compile_verdict_tag(verdict: record.compile)
}

fn consumption_tag(consumption: ServeEntryVerdictConsumption) -> String {
  match consumption {
    Consumed { compile } => compile_verdict_tag(verdict: compile)
    ConsumedAbsent { detail: _ } => "absent"
    ConsumedSchemaMismatch { expected: _, seen: _ } => "schema-mismatch"
    ConsumedRowAbsent { subject_host: _, instance_id: _ } => "row-absent"
    ConsumedRosterForeignRow { subject_host: _, instance_id: _ } => "roster-foreign-row"
    ConsumedIdentityMismatch { field: _, expected: _, seen: _ } => "mismatch"
  }
}

fn mismatch_field(consumption: ServeEntryVerdictConsumption) -> String {
  match consumption {
    ConsumedIdentityMismatch { field: field, expected: _, seen: _ } => field
    _ => "not-mismatch"
  }
}

fn row_absent_text(consumption: ServeEntryVerdictConsumption) -> String {
  match consumption {
    ConsumedRowAbsent { subject_host, instance_id } => join([subject_host, ":", instance_id], "")
    _ => ""
  }
}

fn roster_foreign_row_text(consumption: ServeEntryVerdictConsumption) -> String {
  match consumption {
    ConsumedRosterForeignRow { subject_host, instance_id } => join([subject_host, ":", instance_id], "")
    _ => ""
  }
}

fn compile_verdict_tag(verdict: ServeEntryCompileVerdict) -> String {
  match verdict {
    ServeEntryCompileAdmitted => "admitted"
    ServeEntryCompileBlocked { blocking: _, diagnostics: _ } => "blocked"
    ServeEntryCompileUnobserved { detail: _ } => "unobserved"
  }
}

fn compile_verdict_detail(verdict: ServeEntryCompileVerdict) -> String {
  match verdict {
    ServeEntryCompileUnobserved { detail: detail } => detail
    _ => ""
  }
}

fn string_has_prefix(text: String, prefix: String) -> Bool {
  text.length() >= prefix.length() && text.substring(start: 0, end: prefix.length()) == prefix
}

// Flip one identity field of the admitted product, keeping the carried verdict and the address.
fn admitted_with(field: String, value: String) -> ServeEntryVerdictRecord {
  if field == "source_revision" {
    ServeEntryVerdictRecord {
      subject_host: prod_subject(),
      instance_id: prod_instance(),
      source_revision: value,
      entry: fixture_entry,
      argv_digest: fixture_argv_digest,
      compiler_bin_sha256_hex: fixture_bin_hex,
      compile: ServeEntryCompileAdmitted,
    }
  } else if field == "entry" {
    ServeEntryVerdictRecord {
      subject_host: prod_subject(),
      instance_id: prod_instance(),
      source_revision: fixture_revision,
      entry: value,
      argv_digest: fixture_argv_digest,
      compiler_bin_sha256_hex: fixture_bin_hex,
      compile: ServeEntryCompileAdmitted,
    }
  } else if field == "argv_digest" {
    ServeEntryVerdictRecord {
      subject_host: prod_subject(),
      instance_id: prod_instance(),
      source_revision: fixture_revision,
      entry: fixture_entry,
      argv_digest: value,
      compiler_bin_sha256_hex: fixture_bin_hex,
      compile: ServeEntryCompileAdmitted,
    }
  } else {
    ServeEntryVerdictRecord {
      subject_host: prod_subject(),
      instance_id: prod_instance(),
      source_revision: fixture_revision,
      entry: fixture_entry,
      argv_digest: fixture_argv_digest,
      compiler_bin_sha256_hex: value,
      compile: ServeEntryCompileAdmitted,
    }
  }
}

// Flip one identity field of the blocked product, keeping the carried diagnostics list.
fn blocked_with_bin(bin_hex: String) -> ServeEntryVerdictRecord {
  ServeEntryVerdictRecord {
    subject_host: prod_subject(),
    instance_id: prod_instance(),
    source_revision: fixture_revision,
    entry: fixture_entry,
    argv_digest: fixture_argv_digest,
    compiler_bin_sha256_hex: bin_hex,
    compile: ServeEntryCompileBlocked {
      blocking: 2,
      diagnostics: ["type error at roadmap_serve.dag:1", "unresolved import x"] as List<String>,
    },
  }
}

// THE ADMISSION THE SWAP MAKES, over a document's rows: the swap's own row is the PROD row and the
// roster is the real desired_deployment_roster -- both read from the model, never restated here.
fn admit_rows(rows: List<ServeEntryVerdictRecord>) -> ServeEntryVerdictConsumption {
  admit_plan_serve_entry_verdict(
    rows: rows,
    roster: desired_deployment_roster(),
    subject_host: prod_subject(),
    instance_id: prod_instance(),
    expected_source_revision: fixture_revision,
    expected_entry: fixture_entry,
    expected_argv_digest: fixture_argv_digest,
    admitted_bin_sha256_hex: fixture_bin_hex,
  )
}

fn admit_with(record: ServeEntryVerdictRecord) -> ServeEntryVerdictConsumption {
  admit_rows(rows: [record])
}

fn document_rows(raw: String) -> List<ServeEntryVerdictRecord> {
  match serve_entry_verdict_document_decode(raw: raw) {
    ServeEntryVerdictDocumentDecoded { rows } => rows
    _ => [] as List<ServeEntryVerdictRecord>
  }
}

// ───────────────────────── encode / decode round-trips (the v2 document) ─────────────────────────

test fn witness_round_trip_admitted() -> Bool {
  let rows = document_rows(raw: serialize_json(v: serve_entry_verdict_document_json(rows: [fixture_admitted()])))
  rows.length() == 1
    && any(rows, r => record_tag(record: r) == "admitted" && r.subject_host == prod_subject() && r.instance_id == prod_instance())
}

// THE LOSS THE OLD FORK HID: the plan observed TWO diagnostics; the swap must see two, in order,
// byte for byte -- not one joined text. This is the gunbc.design_argument::minimize_redundancy consolidation's executing proof,
// now proven over the row set rather than a single record.
test fn witness_round_trip_blocked_keeps_the_diagnostics_list() -> Bool {
  let rows = document_rows(raw: serialize_json(v: serve_entry_verdict_document_json(rows: [fixture_blocked(), fixture_lab_admitted()])))
  rows.length() == 2
    && any(rows, r => match r.compile {
      ServeEntryCompileBlocked { blocking, diagnostics } =>
        blocking == 2
          && diagnostics.length() == 2
          && join(diagnostics, " || ") == "type error at roadmap_serve.dag:1 || unresolved import x"
          && r.source_revision == fixture_revision
          && r.subject_host == prod_subject()
      _ => false
    })
    && any(rows, r => record_tag(record: r) == "admitted" && r.subject_host == lab_subject())
}

test fn witness_round_trip_unobserved_keeps_detail() -> Bool {
  let rows = document_rows(raw: serialize_json(v: serve_entry_verdict_document_json(rows: [fixture_unobserved()])))
  rows.length() == 1
    && any(rows, r => match r.compile {
      ServeEntryCompileUnobserved { detail } => detail == "spawn refused"
      _ => false
    })
}

// THE ROW ITSELF IS A PRODUCT: an address, four identity fields and the carried verdict survive the
// encode together, so no field can be dropped on the write side and invent itself on the read side.
test fn witness_row_round_trip_keeps_address_and_identity() -> Bool {
  let encoded = serialize_json(v: serve_entry_verdict_row_json(record: fixture_admitted()))
  match serve_entry_verdict_document_decode(raw: join(["{\"schema\": \"live-deploy-serve-entry-verdict/v2\", \"rows\": [", encoded, "]}"], "")) {
    ServeEntryVerdictDocumentDecoded { rows } =>
      rows.length() == 1
        && any(rows, r => r.subject_host == prod_subject()
          && r.instance_id == prod_instance()
          && r.source_revision == fixture_revision
          && r.entry == fixture_entry
          && r.argv_digest == fixture_argv_digest
          && r.compiler_bin_sha256_hex == fixture_bin_hex)
    _ => false
  }
}

// ───────────────────────────── decode refusals, named ─────────────────────────────

fn raw_with_schema(schema: String) -> String {
  join([
    "{\"schema\": \"", schema, "\", \"rows\": [{\"subject_host\": \"", prod_subject(),
    "\", \"instance_id\": \"", prod_instance(),
    "\", \"source_revision\": \"", fixture_revision,
    "\", \"entry\": \"", fixture_entry,
    "\", \"argv_digest\": \"", fixture_argv_digest,
    "\", \"compiler_bin_sha256_hex\": \"", fixture_bin_hex,
    "\", \"compile_arm\": \"admitted\"}]}",
  ], "")
}

// THE SCHEMA CUT IS ONE MOTION (B amendment 3): a plan artifact written under v1 and read by this v2
// consumer refuses with the TYPED schema mismatch -- not Undecoded, and with no dual-read and no v1
// fallback behind it. The repair it names is re-run the plan.
test fn witness_v1_document_refuses_typed_schema_mismatch() -> Bool {
  match serve_entry_verdict_document_decode(raw: raw_with_schema(schema: "live-deploy-serve-entry-verdict/v1")) {
    ServeEntryVerdictSchemaMismatch { expected, seen } =>
      seen == "live-deploy-serve-entry-verdict/v1"
        && string_contains(s: expected, pattern: "live-deploy-serve-entry-verdict/v2")
    ServeEntryVerdictDocumentDecoded { rows: _ } => false
    ServeEntryVerdictUndecoded { detail: _ } => false
  }
}

test fn witness_foreign_schema_undecoded() -> Bool {
  match serve_entry_verdict_document_decode(raw: raw_with_schema(schema: "live-deploy-apply-receipt/v4")) {
    ServeEntryVerdictSchemaMismatch { expected, seen } =>
      seen == "live-deploy-apply-receipt/v4"
        && string_has_prefix(text: expected, prefix: "live-deploy-serve-entry-verdict/v2")
    ServeEntryVerdictDocumentDecoded { rows: _ } => false
    ServeEntryVerdictUndecoded { detail: _ } => false
  }
}

test fn witness_missing_entry_member_undecoded() -> Bool {
  match serve_entry_verdict_document_decode(raw: join([
    "{\"schema\": \"live-deploy-serve-entry-verdict/v2\", \"rows\": [{\"subject_host\": \"", prod_subject(),
    "\", \"instance_id\": \"", prod_instance(), "\", \"source_revision\": \"r\", \"argv_digest\": \"a\", \"compiler_bin_sha256_hex\": \"b\", \"compile_arm\": \"admitted\"}]}",
  ], "")) {
    ServeEntryVerdictUndecoded { detail } => string_contains(s: detail, pattern: "entry")
    ServeEntryVerdictDocumentDecoded { rows: _ } => false
    ServeEntryVerdictSchemaMismatch { expected: _, seen: _ } => false
  }
}

test fn witness_plain_admitted_document_decodes() -> Bool {
  match serve_entry_verdict_document_decode(raw: raw_with_schema(schema: "live-deploy-serve-entry-verdict/v2")) {
    ServeEntryVerdictDocumentDecoded { rows } => rows.length() == 1 && any(rows, r => record_tag(record: r) == "admitted")
    _ => false
  }
}

// A row that omits its ADDRESS is unreadable, not an unaddressed verdict: without it the swap has no
// row to select, and inventing one is how a verdict reaches a machine it was never about.
test fn witness_row_missing_address_member_undecoded() -> Bool {
  match serve_entry_verdict_document_decode(raw: join([
    "{\"schema\": \"live-deploy-serve-entry-verdict/v2\", \"rows\": [{\"instance_id\": \"", prod_instance(),
    "\", \"source_revision\": \"", fixture_revision, "\", \"entry\": \"", fixture_entry,
    "\", \"argv_digest\": \"", fixture_argv_digest, "\", \"compiler_bin_sha256_hex\": \"", fixture_bin_hex, "\", \"compile_arm\": \"admitted\"}]}",
  ], "")) {
    ServeEntryVerdictUndecoded { detail } => string_contains(s: detail, pattern: "subject_host")
    _ => false
  }
}

// The blocked arm's diagnostics ARRAY is required: a blocked row without it is not a verdict with
// zero diagnostics -- it is an unreadable verdict.
test fn witness_blocked_missing_diagnostics_undecoded() -> Bool {
  match serve_entry_verdict_document_decode(raw: join([
    "{\"schema\": \"live-deploy-serve-entry-verdict/v2\", \"rows\": [{\"subject_host\": \"", prod_subject(),
    "\", \"instance_id\": \"", prod_instance(), "\", \"source_revision\": \"", fixture_revision,
    "\", \"entry\": \"", fixture_entry, "\", \"argv_digest\": \"", fixture_argv_digest,
    "\", \"compiler_bin_sha256_hex\": \"", fixture_bin_hex, "\", \"compile_arm\": \"blocked\", \"compile_blocking\": \"2\"}]}",
  ], "")) {
    ServeEntryVerdictUndecoded { detail } => detail == "compile_diagnostics is not an array"
    _ => false
  }
}

// A diagnostics array of non-strings is unreadable, named.
test fn witness_blocked_non_string_diagnostics_undecoded() -> Bool {
  match serve_entry_verdict_document_decode(raw: join([
    "{\"schema\": \"live-deploy-serve-entry-verdict/v2\", \"rows\": [{\"subject_host\": \"", prod_subject(),
    "\", \"instance_id\": \"", prod_instance(), "\", \"source_revision\": \"", fixture_revision,
    "\", \"entry\": \"", fixture_entry, "\", \"argv_digest\": \"", fixture_argv_digest,
    "\", \"compiler_bin_sha256_hex\": \"", fixture_bin_hex,
    "\", \"compile_arm\": \"blocked\", \"compile_blocking\": \"1\", \"compile_diagnostics\": [3]}]}",
  ], "")) {
    ServeEntryVerdictUndecoded { detail } => detail == "a compile diagnostics entry is not a string"
    _ => false
  }
}

// ───────────────────── row selection: the swap reads ONLY its own row ─────────────────────

// THE ROW-ABSENT REFUSAL IS A TYPED ARM WITH NO FALLBACK (B amendment 4): a document that carries no
// row for the picked deployment refuses, NAMING THE SUBJECT AND THE INSTANCE. This is the leg the
// red control runs: the same input (a document carrying ONLY the prod row) and the lab deployment as
// the picked row take the cold compile at red_at and refuse typed at green_at.
test fn witness_row_absent_names_subject_and_instance() -> Bool {
  let consumption = admit_plan_serve_entry_verdict(
    rows: [fixture_admitted()],
    roster: desired_deployment_roster(),
    subject_host: lab_subject(),
    instance_id: lab_instance(),
    expected_source_revision: fixture_revision,
    expected_entry: fixture_entry,
    expected_argv_digest: fixture_argv_digest,
    admitted_bin_sha256_hex: fixture_bin_hex,
  )
  consumption_tag(consumption: consumption) == "row-absent"
    && row_absent_text(consumption: consumption) == join([lab_subject(), ":", lab_instance()], "")
}

// THE REFUSAL PROJECTS ONTO THE SWAP AS AN UNOBSERVED VERDICT THAT NAMES THE MISSING ADDRESS AND
// REFUSES A COLD RESOLVE -- the arm must not silently fall back to the cold compile it was exempted
// from, which is how run 45749803682 spent its 60 minutes.
test fn witness_row_absent_maps_to_named_unobserved_no_cold_resolve() -> Bool {
  let verdict = serve_entry_verdict_as_compile_verdict(
    consumption: ConsumedRowAbsent { subject_host: lab_subject(), instance_id: lab_instance() },
  )
  compile_verdict_tag(verdict: verdict) == "unobserved"
    && string_contains(s: compile_verdict_detail(verdict: verdict), pattern: lab_subject())
    && string_contains(s: compile_verdict_detail(verdict: verdict), pattern: lab_instance())
    && string_contains(s: compile_verdict_detail(verdict: verdict), pattern: "no cold resolve fallback")
}

// A DOCUMENT CANNOT CARRY A ROW THE ROSTER DOES NOT KNOW (B amendment 4's added leg): a stranger row
// refuses rather than being ignored -- and it refuses even when the swap's OWN row is present, which
// is the case an "ignore what you do not need" implementation would let through.
test fn witness_roster_foreign_row_refuses_even_with_the_swap_row_present() -> Bool {
  let consumption = admit_rows(rows: [fixture_admitted(), fixture_row(subject_host: "some-other-machine", instance_id: "some-other-instance", compile: ServeEntryCompileAdmitted)])
  consumption_tag(consumption: consumption) == "roster-foreign-row"
    && roster_foreign_row_text(consumption: consumption) == "some-other-machine:some-other-instance"
}

test fn witness_roster_foreign_row_refuses_alone() -> Bool {
  let consumption = admit_rows(rows: [fixture_row(subject_host: "not-in-the-roster", instance_id: "nor-this-instance", compile: ServeEntryCompileAdmitted)])
  consumption_tag(consumption: consumption) == "roster-foreign-row"
    && roster_foreign_row_text(consumption: consumption) == "not-in-the-roster:nor-this-instance"
}

test fn witness_roster_foreign_row_maps_to_named_unobserved_no_fallback() -> Bool {
  let verdict = serve_entry_verdict_as_compile_verdict(
    consumption: ConsumedRosterForeignRow { subject_host: "not-in-the-roster", instance_id: "nor-this-instance" },
  )
  compile_verdict_tag(verdict: verdict) == "unobserved"
    && string_contains(s: compile_verdict_detail(verdict: verdict), pattern: "not-in-the-roster:nor-this-instance")
    && string_contains(s: compile_verdict_detail(verdict: verdict), pattern: "desired_deployment_roster")
}

// THE SCHEMA MISMATCH PROJECTS TOO: the swap's compile answer is an unobserved verdict naming both
// schema texts, so the operator's repair (re-run the plan) is in the refusal, not in a log search.
test fn witness_schema_mismatch_maps_to_named_unobserved() -> Bool {
  let verdict = serve_entry_verdict_as_compile_verdict(
    consumption: ConsumedSchemaMismatch { expected: "live-deploy-serve-entry-verdict/v2", seen: "live-deploy-serve-entry-verdict/v1" },
  )
  compile_verdict_tag(verdict: verdict) == "unobserved"
    && string_contains(s: compile_verdict_detail(verdict: verdict), pattern: "live-deploy-serve-entry-verdict/v1")
    && string_contains(s: compile_verdict_detail(verdict: verdict), pattern: "re-run the plan")
}

// THE ROSTER ADMISSION AND THE SELECTOR ARE SEPARABLE FACTS, both witnessed: a document whose rows the
// roster knows selects its own row, and the same selector over a document of only the OTHER row says
// the address is missing rather than picking the nearest match.
test fn witness_selector_picks_the_addressed_row_not_the_first_row() -> Bool {
  match serve_entry_verdict_row_select(rows: [fixture_lab_admitted(), fixture_admitted()], subject_host: prod_subject(), instance_id: prod_instance()) {
    RowSelected { record } => record.subject_host == prod_subject() && record.instance_id == prod_instance()
    RowMissing { subject_host: _, instance_id: _ } => false
  }
}

test fn witness_selector_reports_the_missing_address() -> Bool {
  match serve_entry_verdict_row_select(rows: [fixture_admitted()], subject_host: lab_subject(), instance_id: lab_instance()) {
    RowMissing { subject_host, instance_id } => subject_host == lab_subject() && instance_id == lab_instance()
    RowSelected { record: _ } => false
  }
}

test fn witness_roster_admission_accepts_the_real_roster_rows() -> Bool {
  match serve_entry_verdict_roster_admission(rows: [fixture_admitted(), fixture_lab_admitted()], roster: desired_deployment_roster()) {
    RosterRowsAdmitted => true
    RosterRowForeign { subject_host: _, instance_id: _ } => false
  }
}

test fn witness_roster_admission_names_the_foreign_row() -> Bool {
  match serve_entry_verdict_roster_admission(rows: [fixture_row(subject_host: "stranger", instance_id: "stranger-instance", compile: ServeEntryCompileAdmitted)], roster: desired_deployment_roster()) {
    RosterRowForeign { subject_host, instance_id } => subject_host == "stranger" && instance_id == "stranger-instance"
    RosterRowsAdmitted => false
  }
}

// THE ADDRESS SPELLING IS ONE FUNCTION for both sides of the contract: the document's members and a
// roster row go through the same join, so no second spelling can drift into a different key.
test fn witness_the_row_address_is_one_spelling_on_both_sides() -> Bool {
  serve_entry_verdict_row_address(subject_host: prod_subject(), instance_id: prod_instance())
    == serve_entry_verdict_row_address_of(row: srv1_production_desired_deployment())
    && serve_entry_verdict_row_address(subject_host: lab_subject(), instance_id: lab_instance())
      == serve_entry_verdict_row_address_of(row: srv1_lab_desired_deployment())
}

// ───────────────────────── identity: one field flipped at a time ─────────────────────────
// REBOUND TO THE ROW-SELECTED PATH (B item 7b): these now prove the identity check runs ON THE
// SELECTED ROW -- the field that differs is named, and a verdict about other bytes is named as
// foreign rather than laundered into this row's compile answer.

test fn witness_identity_full_match_admits() -> Bool {
  consumption_tag(admit_with(record: fixture_admitted())) == "admitted"
}

test fn witness_foreign_revision_names_revision() -> Bool {
  mismatch_field(admit_with(record: admitted_with(field: "source_revision", value: "ffffffffffffffffffffffffffffffffffffffff"))) == "source_revision"
}

test fn witness_foreign_entry_names_entry() -> Bool {
  mismatch_field(admit_with(record: admitted_with(field: "entry", value: "dag/gunbc/some/other_serve.dag"))) == "entry"
}

test fn witness_foreign_argv_names_argv_digest() -> Bool {
  mismatch_field(admit_with(record: admitted_with(field: "argv_digest", value: "argv-digest-other"))) == "argv_digest"
}

test fn witness_foreign_binary_names_compiler_bin() -> Bool {
  mismatch_field(admit_with(record: admitted_with(field: "compiler_bin_sha256_hex", value: "bin-digest-other"))) == "compiler_bin_sha256_hex"
}

// A blocked verdict about DIFFERENT bytes is named as foreign, not laundered into a compile
// answer: identity is checked first on every arm.
test fn witness_blocked_foreign_binary_is_mismatch_not_blocked() -> Bool {
  consumption_tag(admit_with(record: blocked_with_bin(bin_hex: "bin-digest-other"))) == "mismatch"
}

// Identity-clean consumption CARRIES the observed list -- the same ServeEntryCompileVerdict the
// plan's spawn observed, diagnostics and all.
test fn witness_blocked_matching_identity_carries_diagnostics() -> Bool {
  match admit_with(record: fixture_blocked()) {
    Consumed { compile } =>
      match compile {
        ServeEntryCompileBlocked { blocking, diagnostics } =>
          blocking == 2
            && diagnostics.length() == 2
            && string_contains(s: join(diagnostics, " | "), pattern: "type error at roadmap_serve.dag:1")
            && string_contains(s: join(diagnostics, " | "), pattern: "unresolved import x")
        _ => false
      }
    _ => false
  }
}

test fn witness_unobserved_matching_identity_names_detail() -> Bool {
  match admit_with(record: fixture_unobserved()) {
    Consumed { compile } => compile_verdict_tag(verdict: compile) == "unobserved" && compile_verdict_detail(verdict: compile) == "spawn refused"
    _ => false
  }
}

// THE ROW IS SELECTED BEFORE THE IDENTITY IS READ, so the identity refusal can only ever be about
// THIS row's bytes: a document whose other row mismatches must not produce a mismatch for the swap.
test fn witness_identity_is_read_on_the_selected_row_only() -> Bool {
  let foreign_lab = ServeEntryVerdictRecord {
    subject_host: lab_subject(),
    instance_id: lab_instance(),
    source_revision: "ffffffffffffffffffffffffffffffffffffffff",
    entry: "dag/gunbc/some/other_serve.dag",
    argv_digest: "argv-digest-other",
    compiler_bin_sha256_hex: "bin-digest-other",
    compile: ServeEntryCompileAdmitted,
  }
  consumption_tag(admit_rows(rows: [foreign_lab, fixture_admitted()])) == "admitted"
}

// ─────────────────── the no-fallback surface, projected onto the swap ───────────────────

test fn witness_absent_maps_to_named_unobserved_no_cold_resolve() -> Bool {
  let verdict = serve_entry_verdict_as_compile_verdict(consumption: ConsumedAbsent { detail: "could not read /tmp/x: no such file" })
  compile_verdict_tag(verdict: verdict) == "unobserved"
    && string_has_prefix(text: compile_verdict_detail(verdict: verdict), prefix: "the plan run published no serve-entry verdict")
    && string_contains(s: compile_verdict_detail(verdict: verdict), pattern: "refusing without a cold resolve")
}

test fn witness_mismatch_maps_to_named_unobserved_no_fallback() -> Bool {
  let verdict = serve_entry_verdict_as_compile_verdict(consumption: ConsumedIdentityMismatch { field: "entry", expected: "e", seen: "other" })
  compile_verdict_tag(verdict: verdict) == "unobserved"
    && string_has_prefix(text: compile_verdict_detail(verdict: verdict), prefix: "plan serve-entry verdict identity mismatch on entry")
    && string_contains(s: compile_verdict_detail(verdict: verdict), pattern: "no cold resolve fallback")
}

test fn witness_blocked_projection_stays_blocked() -> Bool {
  compile_verdict_tag(
    verdict: serve_entry_verdict_as_compile_verdict(consumption: Consumed { compile: ServeEntryCompileBlocked { blocking: 1, diagnostics: ["one line"] as List<String> } }),
  ) == "blocked"
}

test fn witness_admitted_projection_stays_admitted() -> Bool {
  compile_verdict_tag(verdict: serve_entry_verdict_as_compile_verdict(consumption: Consumed { compile: ServeEntryCompileAdmitted })) == "admitted"
}

// ─────────────────────────── the serve argv identity itself ───────────────────────────

test fn witness_argv_identity_binds_the_real_serve_entry() -> Bool {
  let spec = selected_deployment_spec(row: srv1_production_desired_deployment())
  string_contains(s: serve_entry_argv_identity_text(spec: spec), pattern: spec.service.serve_entry as String)
}

test fn witness_argv_identity_binds_port_and_budgets() -> Bool {
  let spec = selected_deployment_spec(row: srv1_production_desired_deployment())
  let svc = spec.service
  let text = serve_entry_argv_identity_text(spec: spec)
  string_contains(s: text, pattern: " --entry ")
    && string_contains(s: text, pattern: " --function ")
    && string_contains(s: text, pattern: " --arg handler=")
    && string_contains(s: text, pattern: " --arg listener=tcp:")
    && string_contains(s: text, pattern: to_string(value: svc.listen.port))
}

test fn witness_argv_digest_is_deterministic_and_text_sensitive() -> Bool {
  serve_entry_argv_digest_of_text(text: "serve --x 1") == serve_entry_argv_digest_of_text(text: "serve --x 1")
    && serve_entry_argv_digest_of_text(text: "serve --x 1") != serve_entry_argv_digest_of_text(text: "serve --x 2")
}

// THE TWO ROSTER ROWS HAVE DIFFERENT SERVE ARGV IDENTITIES. The lab row's row in the document must
// carry ITS OWN entry and argv digest; if the roster's rows digested identically, a producer could
// copy the prod row and no leg below could tell.
test fn witness_the_lab_row_digests_an_argv_identity_of_its_own() -> Bool {
  let prod_spec = selected_deployment_spec(row: srv1_production_desired_deployment())
  let lab_spec = selected_deployment_spec(row: srv1_lab_desired_deployment())
  serve_entry_argv_digest(spec: lab_spec) != serve_entry_argv_digest(spec: prod_spec)
}

// ── THE OPERATOR-LOCAL DEPLOY ROUTE, DISSOLVED (review 90661, prod gap 1 F1) ─────────────────
// The route ends in a typed refusal that must (a) name the retired route and its verb, (b) name
// the ONE surviving deploy path, (c) state that nothing was mutated, and (d) not offer a
// fix-it-yourself verdict path (the verdict travels with the plan artifact only).

test fn the_operator_local_route_refusal_names_the_dissolution_and_the_surviving_path() -> Bool {
  let text = operator_local_deploy_dissolved_refusal()
  string_contains(s: text, pattern: "OperatorLocalDeployDissolved")
    && string_contains(s: text, pattern: "--mode deploy")
    && string_contains(s: text, pattern: "dashboard_deploy")
    && string_contains(s: text, pattern: "Nothing was mutated")
}

// ── THE SCOPE IS THE ADMITTED PLAN POINTER, NOT THE PROD ROLE ────────────────────────────────
// deploy2 run 45749803682: the lab row was exempted because it is not the fleet prod-role holder, so
// its wet step took the cold serve-entry compile inside a transaction that HAD a plan job, and the
// ~22-minute class compile met the 60-minute bound. The exemption's stated reason was operator-local
// (no plan job); its implementation was role identity. These legs hold the rule to the stated reason.

// THE POINTER IS THE ONLY KEY, both rows, both states: present = the verdict arm for BOTH the
// prod-role row and the lab row; absent = the cold compile arm for both (the operator-local route
// keeps the pre-gap mechanism UNCHANGED, slowness and all).
test fn an_admitted_pointer_puts_every_roster_row_on_the_verdict_arm() -> Bool {
  match swap_serve_entry_compile_arm_under(pointer: pointer_present_text, deployment: srv1_production_desired_deployment()) {
    SwapServeEntryCompileFromPlanVerdict { row: _ } =>
      match swap_serve_entry_compile_arm_under(pointer: pointer_present_text, deployment: srv1_lab_desired_deployment()) {
        SwapServeEntryCompileFromPlanVerdict { row: _ } => true
        SwapServeEntryCompileByColdResolve { row: _ } => false
      }
    SwapServeEntryCompileByColdResolve { row: _ } => false
  }
}

test fn no_pointer_keeps_every_roster_row_on_the_cold_compile_arm() -> Bool {
  match swap_serve_entry_compile_arm_under(pointer: pointer_absent_text, deployment: srv1_production_desired_deployment()) {
    SwapServeEntryCompileByColdResolve { row: _ } =>
      match swap_serve_entry_compile_arm_under(pointer: pointer_absent_text, deployment: srv1_lab_desired_deployment()) {
        SwapServeEntryCompileByColdResolve { row: _ } => true
        SwapServeEntryCompileFromPlanVerdict { row: _ } => false
      }
    SwapServeEntryCompileFromPlanVerdict { row: _ } => false
  }
}

// THE ARM CARRIES THE ROW IT WILL RUN, so "which route did THIS deployment take" is answerable from
// the arm alone -- the role predicate could not answer it for a second row at all.
test fn the_arm_names_the_row_it_will_run() -> Bool {
  match swap_serve_entry_compile_arm_under(pointer: pointer_present_text, deployment: srv1_lab_desired_deployment()) {
    SwapServeEntryCompileFromPlanVerdict { row } =>
      serve_entry_verdict_row_address_of(row: row) == join([lab_subject(), ":", lab_instance()], "")
    SwapServeEntryCompileByColdResolve { row: _ } => false
  }
}

// THE PREDICATE AND THE ARM AGREE, in both pointer states, for both rows: the predicate is kept under
// its name as a reading of the arm, never as a second decision that could drift from it.
test fn the_predicate_is_the_arm_and_not_a_second_decision() -> Bool {
  deployment_requires_plan_serve_entry_verdict(deployment: srv1_production_desired_deployment())
    == match swap_serve_entry_compile_arm_under(pointer: pointer_present_text, deployment: srv1_production_desired_deployment()) {
      SwapServeEntryCompileFromPlanVerdict { row: _ } => true
      SwapServeEntryCompileByColdResolve { row: _ } => false
    }
}

// WHICH CHILD RAN, AS DATA (B item 7g): the pointer decides the child, and the two children are
// DIFFERENT THINGS -- a document read at the verdict path for this row's own address, versus a
// spawn of this row's own serve entry. A leg that mixed the arms up would name the wrong child.
test fn the_pointer_decides_which_child_runs_and_the_children_differ() -> Bool {
  match swap_serve_entry_compile_child_under(pointer: pointer_present_text, deployment: srv1_lab_desired_deployment()) {
    CompileChildVerdictDocumentRead { path, subject_host, instance_id } =>
      path == serve_entry_verdict_path()
        && subject_host == lab_subject()
        && instance_id == lab_instance()
        && match swap_serve_entry_compile_child_under(pointer: pointer_absent_text, deployment: srv1_lab_desired_deployment()) {
          CompileChildServeCommandSpawn { entry, subject_host: cold_host, instance_id: cold_instance } =>
            entry == (selected_deployment_spec(row: srv1_lab_desired_deployment()).service.serve_entry as String)
              && cold_host == lab_subject()
              && cold_instance == lab_instance()
          CompileChildVerdictDocumentRead { path: _, subject_host: _, instance_id: _ } => false
        }
    CompileChildServeCommandSpawn { entry: _, subject_host: _, instance_id: _ } => false
  }
}

// THE POINTER READING IS THE ONE CONSTANT, not a name invented here: the presence test reads the
// same variable the pointer admission reads, and the test below fails if anyone re-declares it.
test fn the_pointer_presence_reads_the_admissions_own_env_name() -> Bool {
  (fleet_converge_plan_pointer_env_name as String) == "FLEET_CONVERGE_PLAN_RUN_POINTER"
    && admitted_plan_pointer_present_under(pointer: pointer_present_text)
    && !admitted_plan_pointer_present_under(pointer: pointer_absent_text)
    && !admitted_plan_pointer_present_under(pointer: "   ")
}

// THE ARM THE RUNNING PROCESS TAKES AGREES WITH THE POINTER IT ACTUALLY READS -- the environment
// under the one constant, not a text this file invented. In a claim run there is no pointer, so the
// cold compile arm is the one that runs and the operator-local route pays the compile UNCHANGED; a run
// that carried a pointer must take the verdict arm and demand the verdict. Either way the arm, the
// predicate and the environment have to agree, which is what a leg that compared a hand-written label
// could never check.
test fn the_run_takes_the_arm_its_own_pointer_reading_gives_it() -> Bool {
  let pointer = actions_variable_trimmed(name: fleet_converge_plan_pointer_env_name as NonEmptyStr)
  let present = admitted_plan_pointer_present_under(pointer: pointer)
  match swap_serve_entry_compile_arm(deployment: srv1_lab_desired_deployment()) {
    SwapServeEntryCompileByColdResolve { row: _ } =>
      !present && !deployment_requires_plan_serve_entry_verdict(deployment: srv1_lab_desired_deployment())
    SwapServeEntryCompileFromPlanVerdict { row: _ } =>
      present && deployment_requires_plan_serve_entry_verdict(deployment: srv1_lab_desired_deployment())
  }
}

// ── THE PLAN JOB'S ROW SET AND ITS DEDUPE ───────────────────────────────────────────────────
// THE ROW SET HAS ONE AUTHORITY (B amendment 2): the covered set IS the roster intersected with the
// CI apply selection the deploy job answers with. These legs check the covered set against that
// selection row by row -- an added or dropped row must be explainable by the selection's own answer,
// never by a list written beside it.

test fn the_covered_rows_are_exactly_the_rows_the_ci_selection_accepts() -> Bool {
  let covered = plan_covered_roster_rows(access: ci_deploy_srv1_access)
  let roster = desired_deployment_roster()
  let every_covered_row_is_selected = !any(
    covered.rows,
    row => match live_deploy_desired_apply_selection(instance_id: instance_id_text(id: row.instance.instance_id), access: ci_deploy_srv1_access) {
      DesiredApplySelected { deployment } => deployment.target.host.identity != row.target.host.identity
      DesiredApplyRefused { reason: _ } => true
    },
  )
  let every_uncovered_row_is_refused_by_name = !any(
    roster,
    row => {
      let instance_id = instance_id_text(id: row.instance.instance_id)
      let covered_here = any(covered.rows, r => instance_id_text(id: r.instance.instance_id) == instance_id)
      if covered_here {
        false
      } else {
        match live_deploy_desired_apply_selection(instance_id: instance_id, access: ci_deploy_srv1_access) {
          DesiredApplySelected { deployment: _ } => true
          DesiredApplyRefused { reason } => !any(covered.refusals, t => string_contains(s: t, pattern: reason))
        }
      }
    },
  )
  every_covered_row_is_selected && every_uncovered_row_is_refused_by_name
}

// The fleet's two roster rows -- the prod-role holder AND the lab row -- are both covered. This is
// the producer gap closed: the lab row had NO verdict producer, which is why its swap had nothing to
// consume and compiled cold.
test fn both_fleet_roster_rows_are_covered_by_the_producer() -> Bool {
  let covered = plan_covered_roster_rows(access: ci_deploy_srv1_access)
  any(covered.rows, r => r.target.host.identity == srv1_production_desired_deployment().target.host.identity)
    && any(covered.rows, r => r.target.host.identity == srv1_lab_desired_deployment().target.host.identity)
}

// THE LAB ROW RECORDS ITS OWN ENTRY AND ARGV DIGEST (B item 7c), not a copy of the prod row: the two
// rows are given DIFFERENT compiles, so a producer that copied the prod row across would put the
// prod answer on the lab row and this leg would fail.
test fn the_lab_row_records_the_lab_entry_and_argv_digest_not_the_prod_row() -> Bool {
  let prod_row = srv1_production_desired_deployment()
  let lab_row = srv1_lab_desired_deployment()
  let prod_identity = serve_entry_compile_identity_of(row: prod_row, source_revision: fixture_revision, compiler_bin_sha256_hex: fixture_bin_hex)
  let lab_identity = serve_entry_compile_identity_of(row: lab_row, source_revision: fixture_revision, compiler_bin_sha256_hex: fixture_bin_hex)
  let covered = PlanCoveredRosterRows { rows: [prod_row, lab_row], refusals: [] as List<String> }
  let results = [
    ServeEntryCompileResult { identity: prod_identity, compile: ServeEntryCompileAdmitted },
    ServeEntryCompileResult {
      identity: lab_identity,
      compile: ServeEntryCompileBlocked { blocking: 1, diagnostics: ["lab-only type error"] as List<String> },
    },
  ]
  let records = plan_serve_entry_verdict_records(
    covered: covered,
    results: results,
    source_revision: fixture_revision,
    compiler_bin_sha256_hex: fixture_bin_hex,
  )
  let lab_spec = selected_deployment_spec(row: lab_row)
  any(records, r =>
    r.subject_host == lab_subject()
      && r.instance_id == lab_instance()
      && r.entry == (lab_spec.service.serve_entry as String)
      && r.argv_digest == serve_entry_argv_digest(spec: lab_spec)
      && r.argv_digest != prod_identity.argv_digest
      && match r.compile {
        ServeEntryCompileBlocked { blocking, diagnostics } =>
          blocking == 1 && any(diagnostics, d => d == "lab-only type error")
        _ => false
      })
}

// THE SAME COMPILE IS REFERENCED, NEVER RE-RUN (B amendment 1): one demand per DISTINCT
// (source_revision, entry, argv_digest, compiler_bin_sha256_hex), and a row handed to the same
// identity twice adds nothing. A second compile per row would be ~22 minutes per row with no claim.
test fn the_compile_is_demanded_once_per_distinct_computation_identity() -> Bool {
  let prod_row = srv1_production_desired_deployment()
  let lab_row = srv1_lab_desired_deployment()
  let demands = plan_serve_entry_compile_demands(
    rows: [prod_row, lab_row, prod_row, lab_row],
    source_revision: fixture_revision,
    compiler_bin_sha256_hex: fixture_bin_hex,
  )
  demands.length() == 2
}

test fn rows_whose_identity_truly_differ_do_add_a_compile() -> Bool {
  let prod_row = srv1_production_desired_deployment()
  let lab_row = srv1_lab_desired_deployment()
  let same = plan_serve_entry_compile_demands(rows: [prod_row, prod_row], source_revision: fixture_revision, compiler_bin_sha256_hex: fixture_bin_hex)
  let other_bin = plan_serve_entry_compile_demands(rows: [prod_row, prod_row], source_revision: fixture_revision, compiler_bin_sha256_hex: "a-different-compiler")
  same.length() == 1 && other_bin.length() == 1
    && any(same, d => d.identity.compiler_bin_sha256_hex == fixture_bin_hex)
    && any(other_bin, d => d.identity.compiler_bin_sha256_hex == "a-different-compiler")
    && plan_serve_entry_compile_demands(
      rows: [prod_row, lab_row],
      source_revision: fixture_revision,
      compiler_bin_sha256_hex: fixture_bin_hex,
    ).length() == 2
}

// A ROW CANNOT BORROW ANOTHER ROW'S ANSWER: an identity no demand ran for fails closed into an
// unobserved verdict naming its own entry and argv digest, rather than picking up the nearest result.
test fn an_unanswered_identity_fails_closed_naming_its_own_identity() -> Bool {
  let lab_identity = serve_entry_compile_identity_of(row: srv1_lab_desired_deployment(), source_revision: fixture_revision, compiler_bin_sha256_hex: fixture_bin_hex)
  let verdict = plan_serve_entry_compile_for_identity(
    results: [ServeEntryCompileResult { identity: serve_entry_compile_identity_of(row: srv1_production_desired_deployment(), source_revision: fixture_revision, compiler_bin_sha256_hex: fixture_bin_hex), compile: ServeEntryCompileAdmitted }],
    identity: lab_identity,
  )
  compile_verdict_tag(verdict: verdict) == "unobserved"
    && string_contains(s: compile_verdict_detail(verdict: verdict), pattern: lab_identity.entry)
    && string_contains(s: compile_verdict_detail(verdict: verdict), pattern: lab_identity.argv_digest)
}

// THE WORKER PRINTS THE COST IT IS ABOUT TO PAY, from the real roster: every row's key tuple and the
// distinct count, plus any row the selection refused. The PR's dedupe evidence is this text.
test fn the_report_prints_every_row_key_tuple_and_the_distinct_count() -> Bool {
  let prod_row = srv1_production_desired_deployment()
  let lab_row = srv1_lab_desired_deployment()
  let covered = PlanCoveredRosterRows { rows: [prod_row, lab_row], refusals: ["srv1-dissolved: refused for a stated reason"] as List<String> }
  let demands = plan_serve_entry_compile_demands(rows: covered.rows, source_revision: fixture_revision, compiler_bin_sha256_hex: fixture_bin_hex)
  let text = plan_serve_entry_compile_report(covered: covered, demands: demands, source_revision: fixture_revision, compiler_bin_sha256_hex: fixture_bin_hex)
  string_contains(s: text, pattern: "covered roster rows: 2")
    && string_contains(s: text, pattern: "distinct serve-entry compiles: 2")
    && string_contains(s: text, pattern: join(["host=", prod_subject()], ""))
    && string_contains(s: text, pattern: join(["host=", lab_subject()], ""))
    && string_contains(s: text, pattern: join(["instance=", lab_instance()], ""))
    && string_contains(s: text, pattern: "argv_digest=")
    && string_contains(s: text, pattern: "compiler_bin_sha256_hex=")
    && string_contains(s: text, pattern: "refused for a stated reason")
}

// ── THE VERDICT DIRECTORY IS ADMITTED BEFORE THE WITNESS RUNS (pull/16891#issuecomment-7103879443) ──
// A person-owned run met "Permission denied" at the final write, after a 12-minute witness. The
// probe outcome now decides first: an unwritable directory refuses by name, and a writable one
// admits unchanged (so CI, which owns the directory, still passes).

test fn an_unwritable_verdict_dir_refuses_naming_the_dir_and_the_reason() -> Bool {
  match serve_entry_verdict_dir_admission(dir: "/tmp/fleet-converge-plan", probe_success: false, probe_error: "Permission denied (os error 13)") {
    ServeEntryVerdictDirRefused { dir, reason } => {
      let text = serve_entry_verdict_dir_refusal_text(dir: dir, reason: reason)
      string_contains(s: text, pattern: "/tmp/fleet-converge-plan")
        && string_contains(s: text, pattern: "Permission denied")
        && string_contains(s: text, pattern: "refused before the served-command witness ran")
    }
    ServeEntryVerdictDirWritable => false
  }
}

test fn a_writable_verdict_dir_is_admitted() -> Bool {
  match serve_entry_verdict_dir_admission(dir: "/tmp/fleet-converge-plan", probe_success: true, probe_error: "") {
    ServeEntryVerdictDirWritable => true
    ServeEntryVerdictDirRefused { dir, reason } => false
  }
}
