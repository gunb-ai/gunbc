// Witness for the TYPED LIVE_DEPLOY APPLY PLAN (gunbc.live_deploy.apply_legs deploy_apply_plan_legs):
// what the real srv1 plan contains, in what order, under which elevation, and what it refuses. These
// replace the claims that rendered the deleted apply script and searched its text; each reads the
// typed legs at the plan interface instead (DESIGN section 3: a witness discriminates at one
// interface), and the real route is reached once (the locus refusal) so supplying the plan never
// removes the last execution of production's entry.
module test.claim.live_deploy.live_deploy_apply_plan_witness

import std.types { Bool, String, Int, NonEmptyStr, List }
import std.algebra { Cons, Empty }
import std.optional { Optional, Present, Absent }
import std.realization_reconcile { Converged, NotConverged }
import std.content_hash { content_hash_atom }
import gunbc.auth.tracker_web_oauth_client { tracker_web_test_console_readback_observed_at_epoch }
import gunbc.host.host_effect { HostEffectIntent, HostOs, SshShell, EmitArtifactThenThinRun, BootstrapFragment, ThinInvocation, LiveDeployRetract, host_effect_identity_evidence }
import gunbc.fleet.fleet_intent { srv1_host }
import gunbc.host.host_effect_realize { realize_live_deploy_apply_on_host, deploy_apply_ports_on_host, deploy_apply_run_legs, DeployApplyPorts, ApplyRunOk, ApplyRunFailed }
import gunbc.host.host_axis_caps { CapConvergeWithheld }
import gunbc.live_deploy.apply_legs {
  DeployApplyLeg, DeployApplyPlan, ApplyPlanReady, ApplyPlanRefused,
  ApplyLegCommand, ApplyLegInstallFile, ApplyLegReport, ApplyLegEnsureDirectory, ApplyLegRepairDirectoryEntries,
  ApplyLegBrokerStateDirectories, ApplyLegObjectSource, ApplyLegDigestVerify, ApplyLegDiagnosedCommand,
  ApplyLegRootHelperSnapshot, HelperSnapshotInstall, ApplyLegBrokerTree, ApplyLegRetract, ApplyLegDependency, ApplyLegDigestEnvFile,
  deploy_apply_plan_legs, deploy_apply_leg_step, deploy_apply_oidc_plan, deploy_apply_step_plan,
  deploy_apply_git_worker_subtree_plan, deploy_apply_directories_plan,
}
import gunbc.live_deploy.desired { deployment_spec_srv1, srv1_lab_desired_deployment, selected_deployment_spec }
import gunbc.live_deploy.spec { DeploymentSpec, DeploymentArtifactStep, ArtifactStep, ComposeOwned, FleetConvergeTimerUnit, deployment_owns_the_host_approval_broker, Dependency, UpsertOwned, GunbcSourceTree }
import gunbc.live_deploy.member_identity { ReleaseEffectPlan, uniform_release_plan, KeepMember, InstallExecutable, RestartService, Executable, ServiceProcess }
import gunbc.live_deploy.member_observe { deployment_member_roster }
import gunbc.live_deploy.candidate_identity { CandidateRelease }
import gunbc.ci.ci_deploy_access { ci_deploy_srv1_access }
import gunbc.fleet.fleet_posix_accounts { fleet_posix_ci_runner_sudo_grants }
import extdeps.exec.command { ArgvCommand }
import extdeps.sudo.elevation { sudo_program }
import gunbc.live_deploy.emit { device_crypto_sidecar_binary_path }
import gunbc.live_deploy.release_locus { RevisionBoundAtEmission, release_locus_binary_path }
import test.claim.live_deploy.deploy_release_fixture { deploy_witness_full_install_plan, deploy_witness_release_target, deploy_witness_release_revision }

fn lab_spec() -> DeploymentSpec {
  selected_deployment_spec(row: srv1_lab_desired_deployment())
}

// THE OBSERVER CLOCK IS A SUPPLIED READING here: the lab twin owes an OIDC config whose standing is
// judged at a clock, and these claims are about the plan given a readable clock inside the console
// readback's own window, so the reading is that readback's observation instant (it moves with the
// readback, where a literal would expire). The unreadable clock is its own claim
// (lab_apply_oidc_refuses_without_an_observer_clock).
fn plan_for(spec: DeploymentSpec, plan: ReleaseEffectPlan) -> DeployApplyPlan {
  deploy_apply_plan_legs(spec: spec, plan: plan, authorization: CapConvergeWithheld { cause: "witness" }, source_root: "/src", oidc_now: tracker_web_test_console_readback_observed_at_epoch)
}

fn legs_of(p: DeployApplyPlan) -> List<DeployApplyLeg> {
  match p {
    ApplyPlanReady { legs: ls } => ls
    ApplyPlanRefused { step: _, reason: _ } => []
  }
}

fn full_legs(spec: DeploymentSpec) -> List<DeployApplyLeg> {
  legs_of(p: plan_for(spec: spec, plan: deploy_witness_full_install_plan(spec: spec)))
}

fn step_index_from(legs: List<DeployApplyLeg>, step: String, i: Int) -> Int {
  match legs {
    Empty => 0 - 1
    Cons { head: h, tail: rest } => if deploy_apply_leg_step(leg: h) == step { i } else { step_index_from(legs: rest, step: step, i: i + 1) }
  }
}

fn step_index(legs: List<DeployApplyLeg>, step: String) -> Int {
  step_index_from(legs: legs, step: step, i: 0)
}

fn has_step(legs: List<DeployApplyLeg>, step: String) -> Bool {
  step_index(legs: legs, step: step) >= 0
}

fn the_intent() -> HostEffectIntent {
  HostEffectIntent {
    target: HostOs { node: srv1_host },
    effect: LiveDeployRetract { spec: deployment_spec_srv1() },
    evidence: host_effect_identity_evidence,
    transport: SshShell { ssh_host: "srv-x" },
    privilege_denial: none,
  }
}

// INHABITANCE, ROUTE: the real apply realize is reached and refuses a non-local locus before any leg.
test fn the_real_apply_route_refuses_a_remote_locus_typed() -> Bool {
  let spec = deployment_spec_srv1()
  match realize_live_deploy_apply_on_host(
    spec: spec,
    candidate: CandidateRelease {
      revision: deploy_witness_release_revision,
      expected_surface_identity: content_hash_atom(value: "surface" as NonEmptyStr),
      expected_dispatch_digest: content_hash_atom(value: "dispatch" as NonEmptyStr),
    },
    plan: deploy_witness_full_install_plan(spec: spec),
    transport: SshShell { ssh_host: "srv-x" },
    intent: the_intent(),
    access: ci_deploy_srv1_access,
  ) {
    Converged { evidence: _, applied: _ } => false
    NotConverged { reason: r, applied: _ } => string_contains(s: r, pattern: "live_deploy apply refused over ssh host=srv-x")
  }
}

// INHABITANCE, PLAN: the srv1 full install is a Ready list of typed legs carrying every family, with the
// object source first.
test fn the_srv1_full_install_plan_is_ready_and_carries_every_family() -> Bool {
  let legs = full_legs(spec: deployment_spec_srv1())
  step_index(legs: legs, step: "object-source") == 0
    && has_step(legs: legs, step: "executable-install")
    && has_step(legs: legs, step: "tree-sync-restart")
    && has_step(legs: legs, step: "convergence-readback")
    && has_step(legs: legs, step: "attempt-unit-helper-snapshot")
    && has_step(legs: legs, step: "serve-unit")
    && has_step(legs: legs, step: "serve-restart")
}

// THE DEPLOYMENT'S ORDER: the binary is installed (and verified) before the tree converges, and the
// tree before the serve unit, because spec.steps orders ServeBinary, GunbcSourceTree, SystemdUnit.
test fn the_full_plan_lands_its_members_in_the_deployments_order() -> Bool {
  let legs = full_legs(spec: deployment_spec_srv1())
  let installed = step_index(legs: legs, step: "executable-installed-digest")
  step_index(legs: legs, step: "executable-source-digest") < step_index(legs: legs, step: "executable-install")
    && step_index(legs: legs, step: "executable-install") < installed
    && installed < step_index(legs: legs, step: "tree-root")
    && step_index(legs: legs, step: "convergence-readback") < step_index(legs: legs, step: "serve-unit")
}

// EVERY ELEVATED LEG STAYS WITHIN THE CI RUNNER'S GRANTS: the program sudo runs is one the roster
// grants (by path, or by the granted path's last component for a PATH-resolved program), and no leg
// elevates a generic mover the roster refuses.
fn granted(word: String) -> Bool {
  any(fleet_posix_ci_runner_sudo_grants(), g =>
    (g.command_path as String) == word || ends_with(s: g.command_path as String, suffix: join(["/", word], "")))
}

fn elevated_word(c: ArgvCommand) -> Optional<String> {
  let sudo: String = sudo_program().invocation as String
  let prog: String = c.program.invocation as String
  if prog != sudo {
    Absent
  } else {
    match c.arguments {
      Cons { head: _, tail: Cons { head: w, tail: _ } } => Present { value: w }
      Cons { head: _, tail: Empty } => Present { value: "" }
      Empty => Present { value: "" }
    }
  }
}

fn command_within_grants(c: ArgvCommand) -> Bool {
  match elevated_word(c: c) {
    Absent => true
    Present { value: w } => granted(word: w) && !string_contains(s: w, pattern: "rsync") && !string_contains(s: w, pattern: "chown")
  }
}

fn leg_within_grants(leg: DeployApplyLeg) -> Bool {
  match leg {
    ApplyLegCommand { step: _, command: c } => command_within_grants(c: c)
    ApplyLegInstallFile { step: _, command: c, payload: _ } => command_within_grants(c: c)
    ApplyLegDiagnosedCommand { step: _, command: c, diagnosis: g } => command_within_grants(c: c) && command_within_grants(c: g)
    ApplyLegRepairDirectoryEntries { command: c } => command_within_grants(c: c)
    ApplyLegReport { step: _, line: _ } => true
    ApplyLegEnsureDirectory { target: _ } => true
    ApplyLegBrokerStateDirectories { revision: _ } => true
    ApplyLegObjectSource => true
    ApplyLegDigestVerify { step: _, path: _, digest: _ } => true
    ApplyLegRootHelperSnapshot { locus: _, spine: _, revision: _, action: _ } => true
    ApplyLegBrokerTree { revision: _ } => true
    ApplyLegRetract { step: _, leg: _ } => true
    ApplyLegDependency { dep: _ } => true
    ApplyLegDigestEnvFile { step: _, binary: _, env_name: _, dest: _, owner: _ } => true
  }
}

test fn every_elevated_leg_stays_within_the_ci_runner_grants() -> Bool {
  let legs = full_legs(spec: deployment_spec_srv1())
  count(legs) > 0 && all(legs, l => leg_within_grants(leg: l))
}

// THE RED's other half: a leg elevating a program no grant names is outside the roster.
test fn a_leg_elevating_an_ungranted_program_is_outside_the_grants() -> Bool {
  !granted(word: "/usr/bin/rsync") && !granted(word: "/definitely/not/granted")
}

// A PLAN THAT ONLY CHANGES THE BINARY installs it and restarts the process, and never touches the tree.
fn binary_only_plan(spec: DeploymentSpec) -> ReleaseEffectPlan {
  uniform_release_plan(
    roster: deployment_member_roster(spec: spec),
    target: deploy_witness_release_target(spec: spec),
    mutation_for: m => match m {
      Executable => InstallExecutable
      ServiceProcess => RestartService
      _ => KeepMember
    },
  )
}

test fn a_binary_only_plan_installs_and_restarts_without_publishing_the_tree() -> Bool {
  let spec = deployment_spec_srv1()
  let legs = legs_of(p: plan_for(spec: spec, plan: binary_only_plan(spec: spec)))
  has_step(legs: legs, step: "executable-install")
    && has_step(legs: legs, step: "serve-restart")
    && !has_step(legs: legs, step: "tree-sync-restart")
    && !has_step(legs: legs, step: "serve-unit")
}

// A PLAN THAT KEEPS EVERY MEMBER installs, publishes and restarts nothing of the release.
test fn a_zero_mutation_plan_installs_publishes_and_restarts_nothing_of_the_release() -> Bool {
  let spec = deployment_spec_srv1()
  let legs = legs_of(p: plan_for(spec: spec, plan: uniform_release_plan(
    roster: deployment_member_roster(spec: spec),
    target: deploy_witness_release_target(spec: spec),
    mutation_for: m => KeepMember,
  )))
  has_step(legs: legs, step: "object-source")
    && !has_step(legs: legs, step: "executable-install")
    && !has_step(legs: legs, step: "tree-sync-restart")
    && !has_step(legs: legs, step: "serve-unit")
    && !has_step(legs: legs, step: "serve-restart")
}

// THE HOST BROKER IS A SINGLETON: the lab twin neither writes nor restarts it; the owning production
// apply does (the positive control without which the first is satisfied by an apply that never
// writes the broker).
test fn a_twin_apply_neither_writes_nor_restarts_the_host_broker() -> Bool {
  let legs = full_legs(spec: lab_spec())
  count(legs) > 0
    && !has_step(legs: legs, step: "approval-broker-tree")
    && !has_step(legs: legs, step: "approval-broker-unit")
    && !has_step(legs: legs, step: "approval-broker-restart")
    && !deployment_owns_the_host_approval_broker(spec: lab_spec())
}

test fn the_owning_apply_does_write_and_restart_the_host_broker() -> Bool {
  let legs = full_legs(spec: deployment_spec_srv1())
  deployment_owns_the_host_approval_broker(spec: deployment_spec_srv1())
    && step_index(legs: legs, step: "approval-broker-tree") < step_index(legs: legs, step: "approval-broker-unit")
    && step_index(legs: legs, step: "serve-restart") < step_index(legs: legs, step: "approval-broker-restart")
}

// THE TWIN'S LAUNCHER SNAPSHOT IS ITS OWN: the lab and production applies install into different loci, each
// named for its instance.
fn launcher_snapshot_base(legs: List<DeployApplyLeg>) -> String {
  match legs {
    Empty => ""
    Cons { head: h, tail: rest } =>
      match h {
        ApplyLegRootHelperSnapshot { locus: l, spine: _, revision: _, action: HelperSnapshotInstall } => l.base
        _ => launcher_snapshot_base(legs: rest)
      }
  }
}

test fn the_lab_and_production_applies_install_their_own_launcher_snapshots() -> Bool {
  let prod = launcher_snapshot_base(legs: full_legs(spec: deployment_spec_srv1()))
  let lab = launcher_snapshot_base(legs: full_legs(spec: lab_spec()))
  prod != "" && lab != "" && prod != lab
    && string_contains(s: prod, pattern: deployment_spec_srv1().instance_id as String)
    && string_contains(s: lab, pattern: lab_spec().instance_id as String)
}

// THE LAB OIDC CONFIG REFUSES WITHOUT AN OBSERVER CLOCK, rather than reading an unknown as no file owed.
test fn lab_apply_oidc_refuses_without_an_observer_clock() -> Bool {
  let spec = lab_spec()
  match deploy_apply_oidc_plan(spec: spec, plan: deploy_witness_full_install_plan(spec: spec), oidc_now: Absent) {
    ApplyPlanRefused { step: s, reason: r } => s == "oidc-config" && string_contains(s: r, pattern: "observer clock unreadable")
    ApplyPlanReady { legs: _ } => false
  }
}

fn timer_step(spec: DeploymentSpec) -> DeploymentArtifactStep {
  DeploymentArtifactStep { kind: ComposeOwned { kind: FleetConvergeTimerUnit }, path: "/etc/systemd/system/ctrl-fleet-converge.timer" as NonEmptyStr }
}

// A SPEC STILL NAMING THE RETIRED FLEET-CONVERGE TIMER refuses the plan; the timer is never installed.
test fn a_retired_fleet_converge_timer_step_refuses_the_plan() -> Bool {
  let spec = deployment_spec_srv1()
  match deploy_apply_step_plan(
    step: ArtifactStep { step: timer_step(spec: spec) },
    effects: [],
    spec: spec,
    plan: deploy_witness_full_install_plan(spec: spec),
    source_root: "/src",
    oidc_now: Absent,
  ) {
    ApplyPlanRefused { step: s, reason: _ } => s == "fleet-converge-timer"
    ApplyPlanReady { legs: _ } => false
  }
}

// THE SIDECAR'S DIGEST ENV FILE READS THE SIDECAR AS INSTALLED, never the gunbc binary of the same locus, and
// it is written after the install and before the sidecar unit is restarted.
fn env_binary(legs: List<DeployApplyLeg>) -> String {
  match legs {
    Empty => ""
    Cons { head: h, tail: rest } =>
      match h {
        ApplyLegDigestEnvFile { step: _, binary: b, env_name: _, dest: _, owner: _ } => b
        ApplyLegCommand { step: _, command: _ } => env_binary(legs: rest)
        ApplyLegInstallFile { step: _, command: _, payload: _ } => env_binary(legs: rest)
        ApplyLegDiagnosedCommand { step: _, command: _, diagnosis: _ } => env_binary(legs: rest)
        ApplyLegRepairDirectoryEntries { command: _ } => env_binary(legs: rest)
        ApplyLegReport { step: _, line: _ } => env_binary(legs: rest)
        ApplyLegEnsureDirectory { target: _ } => env_binary(legs: rest)
        ApplyLegBrokerStateDirectories { revision: _ } => env_binary(legs: rest)
        ApplyLegObjectSource => env_binary(legs: rest)
        ApplyLegDigestVerify { step: _, path: _, digest: _ } => env_binary(legs: rest)
        ApplyLegRootHelperSnapshot { locus: _, spine: _, revision: _, action: _ } => env_binary(legs: rest)
        ApplyLegBrokerTree { revision: _ } => env_binary(legs: rest)
        ApplyLegRetract { step: _, leg: _ } => env_binary(legs: rest)
        ApplyLegDependency { dep: _ } => env_binary(legs: rest)
      }
  }
}

test fn the_sidecar_digest_env_reads_the_installed_sidecar_and_no_other() -> Bool {
  let spec = deployment_spec_srv1()
  let legs = full_legs(spec: spec)
  let rev = RevisionBoundAtEmission { revision: deploy_witness_release_revision }
  env_binary(legs: legs) == device_crypto_sidecar_binary_path(spec: spec, revision: rev)
    && env_binary(legs: legs) != release_locus_binary_path(root: spec.approval_broker.repo_root as String, revision: rev)
    && step_index(legs: legs, step: "approval-broker-tree") < step_index(legs: legs, step: "device-crypto-digest-env")
    && step_index(legs: legs, step: "device-crypto-digest-env") < step_index(legs: legs, step: "device-crypto-sidecar-restart")
}

// THE SIDECAR STANDS BEFORE THE BROKER UNIT IS SWAPPED (#14685, run 39545280023): the sidecar's unit, reload,
// enable and restart all precede the broker's slice and unit legs, and the broker's own restart comes after
// them. The bash claim this replaces read approval_broker_lifecycle_steps; here it is the real srv1 plan.
test fn the_sidecar_starts_before_the_broker_unit_is_swapped() -> Bool {
  let legs = full_legs(spec: deployment_spec_srv1())
  let restart = step_index(legs: legs, step: "device-crypto-sidecar-restart")
  all(["device-crypto-sidecar-unit", "device-crypto-sidecar-reload", "device-crypto-sidecar-enable", "device-crypto-sidecar-restart",
       "approval-broker-slice-unit", "approval-broker-unit", "approval-broker-restart"], st => has_step(legs: legs, step: st))
    && step_index(legs: legs, step: "device-crypto-sidecar-unit") < step_index(legs: legs, step: "device-crypto-sidecar-reload")
    && step_index(legs: legs, step: "device-crypto-sidecar-reload") < step_index(legs: legs, step: "device-crypto-sidecar-enable")
    && step_index(legs: legs, step: "device-crypto-sidecar-enable") < restart
    && restart < step_index(legs: legs, step: "approval-broker-slice-unit")
    && restart < step_index(legs: legs, step: "approval-broker-unit")
    && step_index(legs: legs, step: "approval-broker-unit") < step_index(legs: legs, step: "approval-broker-restart")
}

// C1 AND C2 THROUGH THE PRODUCTION ADAPTER. The run-witness controls supply the ensure-directory and
// retract ports, so they stop at the dispatch. Here the ports are production's deploy_apply_ports_on_host
// over EmitArtifactThenThinRun, a real transport arm that refuses typed argv before any command, and the
// leg is the real srv1 plan's own: the run stops at that leg, and the transport's refusal survives into
// the reason (an unreadable directory never reads as absent). An adapter that no longer reaches C1 or C2
// cannot produce this reason.
fn refusing_production_ports() -> DeployApplyPorts {
  deploy_apply_ports_on_host(
    spec: deployment_spec_srv1(),
    principal: ci_deploy_srv1_access.principal,
    source_root: "/src",
    transport: EmitArtifactThenThinRun {
      bootstrap: BootstrapFragment { script: "true" },
      invocation: ThinInvocation { argv: ["true"] },
    },
    intent: the_intent(),
  )
}

fn first_ensure_directory_leg(legs: List<DeployApplyLeg>) -> List<DeployApplyLeg> {
  match legs {
    Empty => []
    Cons { head: h, tail: rest } =>
      match h {
        ApplyLegEnsureDirectory { target: _ } => [h]
        _ => first_ensure_directory_leg(legs: rest)
      }
  }
}

fn first_retract_leg(legs: List<DeployApplyLeg>) -> List<DeployApplyLeg> {
  match legs {
    Empty => []
    Cons { head: h, tail: rest } =>
      match h {
        ApplyLegRetract { step: _, leg: _ } => [h]
        _ => first_retract_leg(legs: rest)
      }
  }
}

fn stops_at_the_leg_with_the_transport_refusal(legs: List<DeployApplyLeg>) -> Bool {
  let run = deploy_apply_run_legs(legs: legs, ports: refusing_production_ports())
  let refused = match run {
    ApplyRunFailed { step: _, reason: r, legs_run: n } => n == 0 && string_contains(s: r, pattern: "EmitArtifactThenThinRun")
    ApplyRunOk { legs_run: _, reports: _ } => false
  }
  count(legs) == 1 && refused
}

test fn the_production_adapter_reaches_c1_and_the_typed_transport_refusal() -> Bool {
  stops_at_the_leg_with_the_transport_refusal(legs: first_ensure_directory_leg(legs: full_legs(spec: deployment_spec_srv1())))
}

test fn the_production_adapter_reaches_c2_and_the_typed_transport_refusal() -> Bool {
  stops_at_the_leg_with_the_transport_refusal(legs: first_retract_leg(legs: full_legs(spec: deployment_spec_srv1())))
}

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// THE GIT-WORKER SUBTREE GROUP AS TYPED LEGS (WORKER-ROOT-EQUIVALENT-3, the typed-effects port of
// #14246/#14270; manager ruling msg_dd453af6 + plan approval msg_d56f89c8). These are the DRY half:
// they read the ORDER and the POSITION of the subtree group's legs at the plan interface (the same
// interface every other claim here uses), never rendered text. The pre-#14660 bash apply rendered five
// such claims over pipeline_steps_text; #14660 deleted that substrate and those claims. The premise is
// an EXIT-STATUS leg (git --git-dir=<repo>/.git rev-parse --absolute-git-dir), NOT a bash gate: it is
// the first leg after the tree plan's convergence readback, the installs are owned-directory legs, the
// sweep re-groups each declared child, the posture sets the three repo config keys, and the maintenance
// unit pair runs last as root. Every ordering claim is RED on main BY POSITION: on the pre-port head the
// whole group was one bash blob appended to the tree step's script, so no leg named any of these steps.
// ═══════════════════════════════════════════════════════════════════════════════════════════════

fn subtree_legs_for(spec: DeploymentSpec) -> List<DeployApplyLeg> {
  legs_of(p: deploy_apply_git_worker_subtree_plan(spec: spec, plan: deploy_witness_full_install_plan(spec: spec)))
}

fn standing_dir_legs_for(spec: DeploymentSpec) -> List<DeployApplyLeg> {
  legs_of(p: deploy_apply_directories_plan(spec: spec, plan: deploy_witness_full_install_plan(spec: spec)))
}

fn count_ensure_legs(legs: List<DeployApplyLeg>) -> Int {
  match legs {
    Empty => 0
    Cons { head: h, tail: rest } => (if deploy_apply_leg_step(leg: h) == "ensure-owned-directory" { 1 } else { 0 }) + count_ensure_legs(legs: rest)
  }
}

// THE PREMISE LEADS THE SUBTREE GROUP, IMMEDIATELY AFTER THE TREE PLAN CONVERGES. The repository must
// exist and be a git directory before ANY ownership leg runs; the chain appends the subtree plan right
// after the tree plan (whose tail is the convergence readback), and the group seeds its fold with the
// premise, so premise_index == convergence_readback_index + 1. A fold that put the premise anywhere
// else -- or dropped it -- is caught here by index adjacency, not by a substring.
test fn the_git_worker_subtree_premise_leg_follows_the_convergence_readback_immediately() -> Bool {
  // The premise↔readback adjacency is the ONE fact that needs the CHAINED full plan; the rest of the
  // order is read INSIDE the subtree group (subtree_legs_for), where the premise seeds index 0 and the
  // only "ensure-owned-directory" legs are the three git children -- a full-plan step_index on that
  // prefix would instead match a standing (non-git) dir leg emitted earlier by the directories plan.
  let legs = full_legs(spec: lab_spec())
  let readback = step_index(legs: legs, step: "convergence-readback")
  let premise = step_index(legs: legs, step: "git-worker-subtree-premise")
  let group = subtree_legs_for(spec: lab_spec())
  readback >= 0
    && premise == readback + 1
    && step_index(legs: group, step: "git-worker-subtree-premise") == 0
    && step_index(legs: group, step: "ensure-owned-directory") > step_index(legs: group, step: "git-worker-subtree-premise")
    && step_index(legs: group, step: "git-worker-subtree-regroup-.git/objects") > step_index(legs: group, step: "ensure-owned-directory")
    && step_index(legs: group, step: "repository-shared-posture-0") > step_index(legs: group, step: "git-worker-subtree-regroup-.git/logs")
    && step_index(legs: group, step: "git-maintenance-service-unit") > step_index(legs: group, step: "repository-shared-posture-2")
}

// THE SUBTREE LEGS ARE NOT A BASH BLOB AND TOUCH NOTHING IN .git ITSELF. Three structural facts: the
// premise leg is a diagnosed command (not an install, not a report); the three .git children arrive as
// OWNED-DIRECTORY legs (observe/decide/install/readback at the owned-directory interface), so the group
// is one authority for ensuring a directory, never a hand-laid chown; and the sweep names the SHARED
// ATTEMPT GROUP in the re-group argv. Nothing here writes .git itself, its hooks, its config or its info
// (the confinement #13942 pins) -- so the claim asserts the sweep's group token and NOT any hook/config path.
test fn the_git_worker_subtree_ensures_the_children_as_owned_directory_legs() -> Bool {
  let legs = subtree_legs_for(spec: lab_spec())
  let n_ensure = count_ensure_legs(legs: legs)
  let premise_is_diagnosed = any(legs, leg => match leg { ApplyLegDiagnosedCommand { step: st, command: _, diagnosis: _ } => st == "git-worker-subtree-premise"  _ => false })
  let regroup_names_shared_group = any(legs, leg => match leg {
    ApplyLegCommand { step: st, command: c } => string_contains(s: join(concat([st], c.arguments), " "), pattern: "gunbc-attempt")
    _ => false
  })
  premise_is_diagnosed
    && n_ensure == 3
    && has_step(legs: legs, step: "git-worker-subtree-regroup-.git/objects")
    && has_step(legs: legs, step: "git-worker-subtree-regroup-.git/refs")
    && has_step(legs: legs, step: "git-worker-subtree-regroup-.git/logs")
    && regroup_names_shared_group
    && has_step(legs: legs, step: "repository-shared-posture-0")
    && has_step(legs: legs, step: "git-maintenance-daemon-reload")
    && has_step(legs: legs, step: "git-maintenance-timer-enable")
}

// ONLY THE TREE-BEARING SPEC ACTIVATES THE GROUP (BOTH WAYS). With the GunbcSourceTree step present the
// three .git children are claimed by the subtree plan and so are ABSENT from the standing directories
// plan; remove the step and the group goes inactive (git_worker_subtree_group_active is false), the
// subtree plan emits ZERO legs, and the three demands fall back to the standing plan -- the position
// they hold today. So standing(ensure legs, without tree step) == standing(ensure legs, lab) + 3, and the
// subtree plan for the no-tree spec is empty while the lab's is not. A gate that dropped the demands on
// either side (the unconditional suppression defect) reddens the +3 or the zero-leg arm.
test fn a_spec_without_the_tree_step_keeps_the_git_demands_standing_and_emits_no_subtree_legs() -> Bool {
  let spec = lab_spec()
  let spec_no_tree = DeploymentSpec {
    role_singletons: spec.role_singletons,
    target: spec.target,
    steps: filter(spec.steps, s => match s {
      ArtifactStep { step: art } => art.kind != UpsertOwned { kind: GunbcSourceTree }
      Dependency { step: _ } => true
    }),
    service: spec.service,
    approval_broker: spec.approval_broker,
    names: spec.names,
    instance_id: spec.instance_id,
    directories: spec.directories,
  }
  count(subtree_legs_for(spec: lab_spec())) > 0
    && count(subtree_legs_for(spec: spec_no_tree)) == 0
    && count_ensure_legs(legs: standing_dir_legs_for(spec: spec_no_tree)) == count_ensure_legs(legs: standing_dir_legs_for(spec: lab_spec())) + 3
}

// NO FABRICATED ROOT. An unknown instance id has no repository to premise on: the subtree plan must
// REFUSE BY NAME at plan time (step "git-worker-subtree-premise"), never fall through to a premise that
// runs `git --git-dir=/.git` against an empty resolved root. This is the typed analogue of the bash
// version's emission poison. Discriminating: hand the group a KNOWN instance and it emits legs (not a
// refusal), so the refusal is instance-driven, not a constant.
test fn an_unknown_instance_refuses_the_subtree_group_by_name() -> Bool {
  let spec = lab_spec()
  let spec_unknown = DeploymentSpec {
    role_singletons: spec.role_singletons,
    target: spec.target,
    steps: spec.steps,
    service: spec.service,
    approval_broker: spec.approval_broker,
    names: spec.names,
    instance_id: "no-such-dashboard-instance-for-the-refusal-claim" as NonEmptyStr,
    directories: spec.directories,
  }
  match deploy_apply_git_worker_subtree_plan(spec: spec_unknown, plan: deploy_witness_full_install_plan(spec: spec_unknown)) {
    ApplyPlanRefused { step: s, reason: r } => s == "git-worker-subtree-premise" && string_contains(s: r, pattern: "no repository root")
    ApplyPlanReady { legs: _ } => false
  }
}

// PROD IS UNTOUCHED: a WorkerIsServiceUser host gains not one subtree leg. The prod spec (deployment_spec_srv1)
// carries the same GunbcSourceTree step and publishes the tree, so the group gate is ACTIVE and the empty
// result comes from the WorkerIsServiceUser arm -- not from the gate skipping. Discriminating: hand prod
// the lab's dedicated-account instance id and the same plan emits legs (the both-directions control for
// the structural claim), so the emptiness is a property of the worker arm, not of prod's tree being absent.
test fn the_dedicated_worker_arm_is_the_only_source_of_subtree_legs() -> Bool {
  count(subtree_legs_for(spec: deployment_spec_srv1())) == 0
    && count(subtree_legs_for(spec: lab_spec())) > 0
}

// THE REALIZED FOLD STOPS AT THE PREMISE LEG, BY ITS STEP NAME (the ruling's wet requirement, taken DRY).
// msg_dd453af6 asked the refusals to prove "the run stopping at the premise leg, by its step name". That is a
// PROPERTY OF THE FOLD, not of a live git: deploy_apply_run_legs halts at the FIRST failing leg and reports
// deploy_apply_leg_step(that leg). The premise seeds the group (index 0), and its ApplyLegDiagnosedCommand
// dispatches its command through the command PORT (the diagnosis runs only after the command fails). So
// driving the lab subtree plan through a command-port that refuses typed argv before any command
// (EmitArtifactThenThinRun -- the same production-arm refusal the C1/C2 adapter claims already use) must halt
// at step "git-worker-subtree-premise" with legs_run == 0 and the transport's own refusal in the reason.
// This is the honest wet requirement WITHOUT the wet blast radius: routing the ADMITS through the realized
// fold would also run the root belt/unit legs (systemctl, unit installs) against the qualification host,
// which is why the per-state admits stay direct-argv in the wet witness and only this halt-at-step fact is
// proven here through the fold. The ports drive only the command leg (the premise is leg 0), so reusing the
// srv1-shaped transport-refusing ports is sound -- their spec feeds the ensure/root ports that are never
// reached when the premise stops the run at index 0.
test fn the_realized_fold_stops_at_the_premise_leg_by_its_step_name() -> Bool {
  let legs = subtree_legs_for(spec: lab_spec())
  match deploy_apply_run_legs(legs: legs, ports: refusing_production_ports()) {
    ApplyRunFailed { step: s, reason: r, legs_run: n } =>
      n == 0 && s == "git-worker-subtree-premise" && string_contains(s: r, pattern: "EmitArtifactThenThinRun")
    ApplyRunOk { legs_run: _, reports: _ } => false
  }
}
