// THE CURSOR ATTEMPT RUNTIME PARENT is an instance directory: the attempt creates only its own base under it.
test fn the_cursor_attempt_runtime_parent_is_demanded_enrolled_and_rendered_by_the_srv1_transaction() -> Bool {
