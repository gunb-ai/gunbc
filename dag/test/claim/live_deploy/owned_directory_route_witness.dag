// A CONVERGED PLAN INSTALLS NO DIRECTORY: the emission is the decision's, not unconditional.
test fn a_converged_plan_emits_no_directory_install() -> Bool {
  let spec = deployment_spec_srv1()
  pipeline_steps_text(steps: owned_directory_apply_steps(
    spec: spec,
    plan: converged_effect_plan(roster: deployment_member_roster(spec: spec), target: deploy_witness_release_target(spec: spec)),
  )) == ""
}

// ── P1 CONTROL: A PROTECTED FABRIC TREE IS CONVERGED THROUGH THE DEPLOY PRINCIPAL'S PINNED READS ─────
//
// The fabric store's root admits only its owner, so its children are invisible to the job user's own
// listing and stat. The deploy observes through two pinned read-only grants per bound directory
// (gunbc.executor_privileged_operation ListDirectoryEntries, ReadDirectoryIdentity), which see the tree
// as it is. These claims supply exactly those reads -- each parent listing naming its child, and the
// line stat prints for each directory at its REAL derived owner, group and mode -- to the production
// observation contract (gunbc.owned_directory owned_directory_observe), the production projection
// (owned_directory_member_of_decision) and the production plan derivation, and require: every member
// converged, a plan that keeps them all, and a second deployment that emits no install. RED: the same
// child read the way the unprivileged job user reads it (its parent's listing refused) is unobservable.
fn derived_stat_line(t: OwnedDirectoryTarget) -> String {
  match owned_directory_mode(t: t) {
    OwnedDirectoryModeRefused { reason: _ } => ""
    OwnedDirectoryModeResolved { mode } =>
      join(["directory|", owned_directory_owner(t: t).user as String, "|", owned_directory_owner(t: t).group as String, "|", file_mode_octal(mode: mode)], "")
  }
}

fn fabric_tree() -> List<OwnedDirectoryTarget> {
  fabric_storage_directory_demands(realization: prod_role_actuated_realization(), instance: srv1_live_dashboard_instance())
}

// The privileged reads of a host holding exactly the fabric tree at its derived identities: a listing
// of a directory names the tree's children of it; a stat of a tree member prints its identity line.
fn privileged_listing_of_the_tree(dir: FilePath) -> ObserverRead {
  ObserverReadOut {
    stdout: join(map(filter(xs: fabric_tree(), predicate: t => (owned_directory_parent(path: owned_directory_path(t: t)) as String) == (dir as String)), t => owned_directory_basename(path: owned_directory_path(t: t))), "\n"),
  }
}

fn privileged_stat_of_the_tree(path: FilePath) -> ObserverRead {
  match first(filter(xs: fabric_tree(), predicate: t => (owned_directory_path(t: t) as String) == (path as String))) {
    Present { value: t } => ObserverReadOut { stdout: derived_stat_line(t: t) }
    Absent => ObserverReadFailed { origin: ObserverExited { exit_code: 1, stderr: "not in the tree" } }
  }
}

fn fabric_member_as_privileged_reads_see_it(t: OwnedDirectoryTarget) -> ObservedMember {
  let path = owned_directory_path(t: t) as String as NonEmptyStr
  owned_directory_member_of_decision(
    member: DirectoryRoot { path: path },
    path: path,
    target: t,
    observation: owned_directory_observe(path: owned_directory_path(t: t), list: d => privileged_listing_of_the_tree(dir: d), stat: p => privileged_stat_of_the_tree(path: p)),
  )
}

test fn a_protected_fabric_tree_is_converged_and_a_second_deployment_installs_nothing() -> Bool {
  let spec = deployment_spec_srv1()
  let tree = fabric_tree()
  let roster = map(tree, t => DirectoryRoot { path: owned_directory_path(t: t) as String as NonEmptyStr })
  let protected_root = any(tree, t => match owned_directory_mode(t: t) {
    OwnedDirectoryModeResolved { mode } => !mode.other.execute && !mode.group.read
    OwnedDirectoryModeRefused { reason: _ } => false
  })
  let derivation = derive_member_plan(
    roster: roster,
    desired: m => Present { value: match m { DirectoryRoot { path } => RootAt { root: DirectoryRootIdentity { path: path, standing: RootConverged } }  _ => RootAt { root: DirectoryRootIdentity { path: "/" as NonEmptyStr, standing: RootConverged } } } },
    observed: m => match first(filter(xs: tree, predicate: t => converged_member_eq(a: DirectoryRoot { path: owned_directory_path(t: t) as String as NonEmptyStr }, b: m))) {
      Present { value: t } => fabric_member_as_privileged_reads_see_it(t: t)
      Absent => MemberUnobservable { member: m, cause: "not a fabric demand" }
    },
    target: deploy_witness_release_target(spec: spec),
  )
  count(tree) > 0 && protected_root
    && all(tree, t => match fabric_member_as_privileged_reads_see_it(t: t) {
      MemberObserved { identity } => match identity { RootAt { root } => directory_root_standing_wire(s: root.standing) == "converged"  _ => false }
      _ => false
    })
    && match derivation {
      EffectsRefused { refusals: _ } => false
      EffectsDerived { plan } =>
        plan_mutation_count(plan: plan) == 0
          && all(tree, t => pipeline_steps_text(steps: owned_directory_apply_steps(spec: deploy_witness_spec_with_only_directory(spec: spec, path: owned_directory_path(t: t) as String), plan: plan)) == "")
    }
}

// RED: the child read as the unprivileged job user reads it -- the owner-only parent's listing refused
// -- is unobservable, so planning refuses rather than installing over it.
test fn an_unprivileged_read_of_a_protected_child_refuses_the_derivation() -> Bool {
  match first(filter(xs: fabric_tree(), predicate: t => string_contains(s: owned_directory_path(t: t) as String, pattern: "/objects"))) {
    Absent => false
    Present { value: t } => {
      let path = owned_directory_path(t: t) as String as NonEmptyStr
      match owned_directory_member_of_decision(
        member: DirectoryRoot { path: path },
        path: path,
        target: t,
        observation: owned_directory_observe(
          path: owned_directory_path(t: t),
          list: d => ObserverReadFailed { origin: ObserverExited { exit_code: 2, stderr: "" } },
          stat: p => ObserverReadFailed { origin: ObserverExited { exit_code: 1, stderr: "" } },
        ),
      ) {
        MemberUnobservable { member: _, cause: _ } => true
        _ => false
      }
    }
  }
}

// THE LAB'S PRE-EXISTING STATE, AS bright-moth-475 READ IT ON srv1 2026-10-17: every worker-writable
// directory the instance demands is already present, owned by the SERVICE USER AND ITS OWN PRIMARY
// GROUP (briansrls:briansrls, 775) from the pre-dedicated-worker era -- the demanded user matches, only
// the demanded group (the shared attempt group) differs. The stat line is printed in the exact format
// the observer parses (owned_directory_stat_format), with the TARGET'S OWN declared mode: only the
// group differs from what the target demands.

fn worker_dir_host_mode_text(t: OwnedDirectoryTarget) -> String {
  match owned_directory_mode(t: t) {
    OwnedDirectoryModeResolved { mode } => file_mode_octal(mode: mode) as String
    OwnedDirectoryModeRefused { reason: _ } => ""
  }
}

// THE REAL DERIVATION'S OBSERVED-MEMBER PROJECTION, over a SUPPLIED host observation: the directory is
// present, listed by its parent, and owned by exactly the supplied principal. This is the same
// projection the deploy's plan derivation (derive_member_plan, and behind it release_member_plan /
// deployment_effect_plan -- the fold that produced srv1's refusal string) runs; only the host's answer
// is supplied rather than a live read, which is what makes the host state testable without a host.

fn worker_dir_as_host_holds_it(t: OwnedDirectoryTarget, host_user: NonEmptyStr, host_group: NonEmptyStr) -> ObservedMember {
  let path = owned_directory_path(t: t) as String as NonEmptyStr
  let listing = owned_directory_basename(path: owned_directory_path(t: t)) as String
  let stat_line = join(["directory|", host_user as String, "|", host_group as String, "|", worker_dir_host_mode_text(t: t)], "")
  owned_directory_member_of_decision(
    member: DirectoryRoot { path: path },
    path: path,
    target: t,
    observation: owned_directory_observe(
      path: owned_directory_path(t: t),
      list: d => ObserverReadOut { stdout: listing },
      stat: p => ObserverReadOut { stdout: stat_line },
    ),
  )
}

fn worker_dirs_converged_desired(m: ConvergedMember) -> MemberIdentity? {
  Present { value: match m { DirectoryRoot { path } => RootAt { root: DirectoryRootIdentity { path: path, standing: RootConverged } }  _ => RootAt { root: DirectoryRootIdentity { path: "/" as NonEmptyStr, standing: RootConverged } } } }
}

fn worker_dirs_derivation(dirs: List<OwnedDirectoryTarget>, host_user: NonEmptyStr, host_group: NonEmptyStr) -> EffectDerivation {
  derive_member_plan(
    roster: map(dirs, t => DirectoryRoot { path: owned_directory_path(t: t) as String as NonEmptyStr }),
    desired: m => worker_dirs_converged_desired(m: m),
    observed: m => match first(filter(xs: dirs, predicate: t => converged_member_eq(a: DirectoryRoot { path: owned_directory_path(t: t) as String as NonEmptyStr }, b: m))) {
      Present { value: t } => worker_dir_as_host_holds_it(t: t, host_user: host_user, host_group: host_group)
      Absent => MemberUnobservable { member: m, cause: "not a demanded directory" }
    },
    target: deploy_witness_release_target(spec: deployment_spec_srv1()),
  )
}

// THE LAB EXISTING-HOST DERIVATION (the ARM 2 defect, and the claim the #14270 handoff demanded): the
// deploy's REAL plan derivation -- derive_member_plan, the fold whose every member refusal is exactly
// the "directory-root: ... refused" line that aborted srv1's lab deploy -- over a SUPPLIED host
// observation of an EXISTING briansrls:briansrls subtree must PRODUCE THE PLAN (the regroup), never a
// refusal, for every directory inside the declared worker set. Each planned step is the provider's own
// install, and it names the TARGET'S DECLARED group (the shared attempt group) -- never the group found
// on the host, which is the difference between a regroup and an adoption. The two controls keep the
// guard honest: a directory OUTSIDE the declared set, observed the same way (same user, foreign group),
// must still refuse ("ownership is never adopted"), and a directory INSIDE the set observed under a
// DIFFERENT USER must still refuse too -- the posture relaxes the group only, never the user. RED on
// main: there the same-user-different-group reading is the both-match conflation, so the six refuse.

// THE REGROUP THE PROVIDER PLANS NAMES THE TARGET'S DECLARED GROUP, never the group found on the host
// (which is what makes it a regroup and not an adoption). Each planned step comes from the provider's
// own install of this target.
// THE REGROUP THE PROVIDER PLANS NAMES THE TARGET'S DECLARED GROUP, never the group found on the host
// (which is what makes it a regroup and not an adoption). The expected step is the provider's OWN
// install command (gunbc.live_deploy.operations install_directory_owned_command -- the single renderer,
// the same one the emitter uses), built twice from the SAME target at the SAME mode, path and owner
// USER, differing only in the group token: the declared group must APPEAR and the group read off the
// host must NOT. Both strings come from the one serializer, so this is exact, not a hand-spelled argv.
fn worker_dir_install_names_declared_group(mode: FileMode, lab_spec: DeploymentSpec, t: OwnedDirectoryTarget, plan: ReleaseEffectPlan, host_group: NonEmptyStr) -> Bool {
  let owner = owned_directory_owner(t: t)
  let path = owned_directory_path(t: t) as String
  let steps = pipeline_steps_text(steps: owned_directory_apply_steps(
    spec: deploy_witness_spec_with_only_directory(spec: lab_spec, path: path),
    plan: plan,
  ))
  string_contains(s: steps, pattern: install_directory_owned_command(mode: mode, owner: owner.user, group: owner.group, path: path))
    && !string_contains(s: steps, pattern: install_directory_owned_command(mode: mode, owner: owner.user, group: host_group, path: path))
}

fn worker_dir_step_regroups_to_declared_group(lab_spec: DeploymentSpec, t: OwnedDirectoryTarget, plan: ReleaseEffectPlan, host_group: NonEmptyStr) -> Bool {
  match owned_directory_mode(t: t) {
    OwnedDirectoryModeRefused { reason: _ } => false
    OwnedDirectoryModeResolved { mode } => worker_dir_install_names_declared_group(mode: mode, lab_spec: lab_spec, t: t, plan: plan, host_group: host_group)
  }
}

fn existing_subtree_derives_the_regroup(lab_spec: DeploymentSpec, dirs: List<OwnedDirectoryTarget>, host_user: NonEmptyStr, host_group: NonEmptyStr) -> Bool {
  match worker_dirs_derivation(dirs: dirs, host_user: host_user, host_group: host_group) {
    EffectsRefused { refusals: _ } => false
    EffectsDerived { plan } =>
      count(dirs) == 6
        && plan_mutation_count(plan: plan) == count(dirs)
        && all(dirs, t => worker_dir_step_regroups_to_declared_group(lab_spec: lab_spec, t: t, plan: plan, host_group: host_group))
  }
}

fn refuses_all(dirs: List<OwnedDirectoryTarget>, host_user: NonEmptyStr, host_group: NonEmptyStr, expected: Int) -> Bool {
  match worker_dirs_derivation(dirs: dirs, host_user: host_user, host_group: host_group) {
    EffectsRefused { refusals } => count(refusals) == expected
    EffectsDerived { plan: _ } => false
  }
}

// THE LAB EXISTING-HOST DERIVATION (the ARM 2 defect, and the claim the #14270 handoff demanded): the
// deploy's REAL plan derivation -- derive_member_plan, the fold whose every member refusal is exactly
// the "directory-root: ... refused" line that aborted srv1's lab deploy -- over a SUPPLIED host
// observation of an EXISTING briansrls:briansrls subtree must PRODUCE THE PLAN (the regroup), never a
// refusal, for every directory inside the declared worker set. The two controls keep the guard honest:
// a directory OUTSIDE the declared set, observed the same way (same user, a foreign group), must still
// refuse ("ownership is never adopted"), and a directory INSIDE the set observed under a DIFFERENT USER
// must still refuse too -- the posture relaxes the group only, never the user. RED on main: there the
// same-user-different-group reading is the both-match conflation, so all six refuse.

test fn the_existing_lab_subtree_is_planned_by_the_provider_and_nothing_outside_it_is_adopted() -> Bool {
  let lab = srv1_lab_dashboard_instance()
  let lab_spec = selected_deployment_spec(row: srv1_lab_desired_deployment())
  let host = lab.directory_owner
  let worker_dirs = concat([
    dashboard_instance_dispatch_worktree_directory(instance: lab),
    dashboard_instance_dispatch_attempt_state_directory(instance: lab),
    dashboard_instance_provider_state_directory(instance: lab),
  ], dashboard_instance_worker_git_directories(instance: lab))
  let out_of_set = credential_acquisition_slots_directory(instance: lab)
  let intruder_user = "someone-else" as NonEmptyStr
  existing_subtree_derives_the_regroup(lab_spec: lab_spec, dirs: worker_dirs, host_user: host.user, host_group: host.group)
    && refuses_all(dirs: [out_of_set], host_user: host.user, host_group: intruder_user, expected: 1)
    && refuses_all(dirs: worker_dirs, host_user: intruder_user, host_group: host.group, expected: 6)
}

// THE PRINCIPAL HOLDS EXACTLY THE READS THE PLAN SPENDS: srv1's runner-host sudoers grants the job
// user a pinned stat of every demanded directory and a pinned listing of each demanded directory's
// parent -- read-only operations on named paths, no path-unrestricted grant.
test fn the_deploy_principal_is_granted_the_pinned_reads_the_plan_observes_through() -> Bool {
  match runner_host_deploy_for(host: operator_host_srv1) {
    RunnerHostDeployFound { deploy } => {
      let ops = runner_host_privileged_operations(deploy: deploy)
      all(deployment_directory_demands(spec: deployment_spec_srv1()), t =>
        any(ops, op => match op { ReadDirectoryIdentity { path } => (path as String) == (owned_directory_path(t: t) as String)  _ => false })
          && any(ops, op => match op { ListDirectoryEntries { path } => (path as String) == (owned_directory_parent(path: owned_directory_path(t: t)) as String)  _ => false }))
    }
    _ => false
  }
}
// THE OTHER SIDE OF THE SAME FACT (bright-moth-475, amendment 3 of msg_32acd088). The two git-subtree
// members and the maintenance unit belong to the DEDICATED-WORKER route and to NOTHING else. The move put
// them on the live_deploy roster, which is ALSO srv1_live's route -- so the load-bearing obligation is
// that a WorkerIsServiceUser host gains NOT ONE thing from it, while the lab's plan carries the whole set.
// The claim runs the PRODUCTION route's own builders (the roster builders, the full-install plan, and the
// two fragment apply-steps) rather than a hand-written list, so it is the transitive chain -- the roster
// gate excludes the members for prod, the plan therefore carries no regroup/assert mutation for them, and
// the fragments (which key on plan_mutation_is, not on the worker type) therefore render NOTHING -- proven
// end to end, not assumed. If the roster gate were widened to prod by mistake, the FIRST leg (the empty
// subtree/posture member lists) turns red before any apply step is even reached.
test fn the_dedicated_worker_move_touches_the_lab_and_leaves_prod_untouched() -> Bool {
  let prod_spec = deployment_spec_srv1()
  let lab_spec = selected_deployment_spec(row: srv1_lab_desired_deployment())
  let lab = srv1_lab_dashboard_instance()
  // THE PROD SIDE, through the route's own builders.
  let prod_subtrees = deployment_git_worker_subtree_members(spec: prod_spec)
  let prod_posture = deployment_repository_shared_posture_members(spec: prod_spec)
  let prod_plan = deploy_witness_full_install_plan(spec: prod_spec)
  let prod_subtree_steps = pipeline_steps_text(steps: git_worker_subtree_apply_steps(spec: prod_spec, plan: prod_plan))
  let prod_posture_steps = pipeline_steps_text(steps: repository_shared_posture_apply_steps(spec: prod_spec, plan: prod_plan))
  // THE LAB SIDE.
  let lab_subtrees = deployment_git_worker_subtree_members(spec: lab_spec)
  let lab_posture = deployment_repository_shared_posture_members(spec: lab_spec)
  let lab_plan = deploy_witness_full_install_plan(spec: lab_spec)
  let lab_subtree_steps = pipeline_steps_text(steps: git_worker_subtree_apply_steps(spec: lab_spec, plan: lab_plan))
  let lab_posture_steps = pipeline_steps_text(steps: repository_shared_posture_apply_steps(spec: lab_spec, plan: lab_plan))
  // prod gains nothing: no subtree member, no posture member in the roster ...
  count(prod_subtrees) == 0
    && count(prod_posture) == 0
    // ... nor one regroup/assert mutation for the lab's OWN members in prod's plan (checking the lab's
    // members against the PROD plan proves the plan -- not just the member list -- carries nothing) ...
    && all(lab_subtrees, m => !plan_mutation_is(plan: prod_plan, member: m, expected: RegroupGitWorkerSubtree))
    && all(lab_posture, m => !plan_mutation_is(plan: prod_plan, member: m, expected: AssertRepositorySharedPosture))
    // ... and both git fragments render NOTHING for prod (the privileged unit install included) ...
    && prod_subtree_steps == ""
    && prod_posture_steps == ""
    // the lab carries the whole set: the three declared subtree children and the posture member ...
    && count(lab_subtrees) == count(dashboard_git_worker_directory_children)
    && count(lab_posture) == 1
    // ... each subtree member is planned to REGROUP and the posture member to ASSERT ...
    && all(lab_subtrees, m => plan_mutation_is(plan: lab_plan, member: m, expected: RegroupGitWorkerSubtree))
    && all(lab_posture, m => plan_mutation_is(plan: lab_plan, member: m, expected: AssertRepositorySharedPosture))
    // ... the subtree apply actually emits the sweep naming the shared attempt group ...
    && string_contains(s: lab_subtree_steps, pattern: fleet_posix_worker_shared_group_name as String)
    // ... and the posture apply carries BOTH deferral keys AND the maintenance unit + timer. The unit and
    // the keys are one member and one fragment (bright-moth-475's amendment 1): a posture that switches off
    // the repo's only repack without installing its replacement is the externalized degradation the
    // amendment refused, so the keys and the unit must appear together or this leg is red.
    && string_contains(s: lab_posture_steps, pattern: "core.sharedRepository")
    && string_contains(s: lab_posture_steps, pattern: "gc.auto")
    && string_contains(s: lab_posture_steps, pattern: "maintenance.auto")
    && string_contains(s: lab_posture_steps, pattern: dashboard_git_maintenance_service_unit_name(instance: lab))
    && string_contains(s: lab_posture_steps, pattern: dashboard_git_maintenance_timer_unit_name(instance: lab))
}
