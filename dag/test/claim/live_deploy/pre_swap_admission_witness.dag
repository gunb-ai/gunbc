module test.claim.live_deploy.pre_swap_admission_witness

import std.types { Bool, String, Int, NonEmptyStr }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import gunbc.compile_diagnostic_census {
  CompileDiagnosticCensus,
  CensusObserved,
  CensusNotRunnable,
  CompileDiagnosticCensusRow,
}
import gunbc.live_deploy.desired {
  srv2_deploy_desired_deployment,
  production_admitted_branch,
  srv1_lab_desired_deployment,
}
import gunbc.live_deploy.pre_swap_admission {
  target_branch_admission,
  TargetBranchAdmitted,
  TargetBranchRefused,
  serve_entry_compile_of,
  ServeEntryCompileAdmitted,
  ServeEntryCompileBlocked,
  ServeEntryCompileUnobserved,
  observe_serve_entry_file_compile,
  live_deploy_pre_swap_admission,
  PreSwapAdmission,
  TargetBranchAdmission,
  PreSwapAdmitted,
  PreSwapRefused,
  checkout_branch_for_admission,
  CheckoutNamedBranch,
  DetachedHeadOnAdmittedBranch,
  DetachedHeadNotOnAdmittedBranch,
  pre_swap_from_checkout,
}
import extdeps.git.inspect {
  MergeBaseReported,
  NoCommonAncestor,
  MergeBaseRefused,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn blocking_row() -> CompileDiagnosticCensusRow {
  CompileDiagnosticCensusRow {
    diagnostic_class: "DeclaredTypeInhabitanceMismatch" as NonEmptyStr,
    subject_name: "f",
    blocking: true,
    count: 1,
  }
}

fn pre_swap_reason(a: PreSwapAdmission) -> String {
  match a {
    PreSwapAdmitted => ""
    PreSwapRefused { reason } => reason
  }
}

fn branch_reason(a: TargetBranchAdmission) -> String {
  match a {
    TargetBranchAdmitted => ""
    TargetBranchRefused { reason } => reason
  }
}

// RED: a non-main checkout aimed at the production admitted branch refuses.
test fn a_non_main_revision_aimed_at_production_refuses() -> Bool {
  match target_branch_admission(admitted: production_admitted_branch, observed: srv1_lab_desired_deployment().admitted_branch as String) {
    TargetBranchAdmitted => false
    TargetBranchRefused { reason } =>
      string_contains(s: reason, pattern: "DeployTargetBranchRefused")
        && string_contains(s: reason, pattern: production_admitted_branch)
        && string_contains(s: reason, pattern: srv1_lab_desired_deployment().admitted_branch as String)
  }
}

// Control: main to production proceeds.
test fn main_aimed_at_production_admits() -> Bool {
  match target_branch_admission(admitted: production_admitted_branch, observed: "main") {
    TargetBranchRefused { reason: _ } => false
    TargetBranchAdmitted => true
  }
}

// Control: the lab's own integration branch to the lab proceeds.
test fn lab_dev_aimed_at_lab_admits() -> Bool {
  match target_branch_admission(admitted: srv1_lab_desired_deployment().admitted_branch, observed: srv1_lab_desired_deployment().admitted_branch as String) {
    TargetBranchRefused { reason: _ } => false
    TargetBranchAdmitted => true
  }
}

// Main is not the lab integration branch.
test fn main_aimed_at_lab_refuses() -> Bool {
  match target_branch_admission(admitted: srv1_lab_desired_deployment().admitted_branch, observed: "main") {
    TargetBranchAdmitted => false
    TargetBranchRefused { reason } => string_contains(s: reason, pattern: srv1_lab_desired_deployment().admitted_branch as String)
  }
}

// srv2 declares main on its desired row; it is not an implicit production class.
test fn srv2_deploy_declares_main() -> Bool {
  srv2_deploy_desired_deployment().admitted_branch == production_admitted_branch
    && match target_branch_admission(admitted: srv2_deploy_desired_deployment().admitted_branch, observed: srv1_lab_desired_deployment().admitted_branch as String) {
      TargetBranchAdmitted => false
      TargetBranchRefused { reason } => string_contains(s: reason, pattern: production_admitted_branch)
    }
}

test fn an_empty_observed_branch_never_admits() -> Bool {
  match target_branch_admission(admitted: production_admitted_branch, observed: "") {
    TargetBranchAdmitted => false
    TargetBranchRefused { reason } => string_contains(s: reason, pattern: "DeployTargetBranchRefused")
  }
}

// RED: a blocking compile census refuses; the reason states nothing was mutated.
test fn a_blocking_compile_refuses_with_nothing_mutated() -> Bool {
  let compile = serve_entry_compile_of(census: CensusObserved { rows: [blocking_row()] })
  match live_deploy_pre_swap_admission(
    admitted: production_admitted_branch,
    observed_branch: "main",
    compile: compile,
  ) {
    PreSwapAdmitted => false
    PreSwapRefused { reason } =>
      string_contains(s: reason, pattern: "ServeEntryCompileBlocked")
        && string_contains(s: reason, pattern: "nothing was mutated")
  }
}

// Positive control: a clean compile on an admitted branch proceeds.
test fn a_clean_compile_on_main_to_production_proceeds() -> Bool {
  match live_deploy_pre_swap_admission(
    admitted: production_admitted_branch,
    observed_branch: "main",
    compile: ServeEntryCompileAdmitted,
  ) {
    PreSwapRefused { reason: _ } => false
    PreSwapAdmitted => true
  }
}

test fn an_unobserved_compile_refuses() -> Bool {
  match live_deploy_pre_swap_admission(
    admitted: production_admitted_branch,
    observed_branch: "main",
    compile: ServeEntryCompileUnobserved { detail: "census not runnable" },
  ) {
    PreSwapAdmitted => false
    PreSwapRefused { reason } => string_contains(s: reason, pattern: "ServeEntryCompileUnobserved")
  }
}

test fn a_not_runnable_census_is_unobserved_not_clean() -> Bool {
  match serve_entry_compile_of(census: CensusNotRunnable { cause: "harness" as NonEmptyStr }) {
    ServeEntryCompileAdmitted => false
    ServeEntryCompileBlocked { blocking: _ } => false
    ServeEntryCompileUnobserved { detail } => detail == "harness"
  }
}

test fn an_empty_observed_census_is_admitted() -> Bool {
  match serve_entry_compile_of(census: CensusObserved { rows: [] }) {
    ServeEntryCompileAdmitted => true
    ServeEntryCompileBlocked { blocking: _ } => false
    ServeEntryCompileUnobserved { detail: _ } => false
  }
}

// Branch refuses first: a blocked compile on the wrong branch still names the branch, so the
// cheaper gate is the one an operator sees.
test fn a_wrong_branch_refuses_before_the_compile_reason() -> Bool {
  let reason = pre_swap_reason(a: live_deploy_pre_swap_admission(
    admitted: production_admitted_branch,
    observed_branch: "session/x",
    compile: ServeEntryCompileBlocked { blocking: 1 },
  ))
  string_contains(s: reason, pattern: "DeployTargetBranchRefused")
    && !string_contains(s: reason, pattern: "ServeEntryCompileBlocked")
}

// Inhabitance of the census-to-verdict fold over a real compile of a supplied fixture: a
// type error is blocked; a matching Int body is admitted. The production wet path hands the
// same fold a census of the declared serve entry file.
test fn a_type_error_fixture_is_a_blocked_verdict() -> Bool {
  match serve_entry_compile_of(
    census: compile_dag_diagnostic_census("module probe_serve_entry_red\nfn f() -> Int { \"x\" }\n"),
  ) {
    ServeEntryCompileBlocked { blocking } => blocking > 0
    ServeEntryCompileAdmitted => false
    ServeEntryCompileUnobserved { detail: _ } => false
  }
}

test fn an_empty_serve_entry_path_is_unobserved() -> Bool {
  match observe_serve_entry_file_compile(entry: "") {
    ServeEntryCompileUnobserved { detail } => string_contains(s: detail, pattern: "empty")
    ServeEntryCompileAdmitted => false
    ServeEntryCompileBlocked { blocking: _ } => false
  }
}

test fn a_clean_int_fixture_is_an_admitted_verdict() -> Bool {
  match serve_entry_compile_of(
    census: compile_dag_diagnostic_census("module probe_serve_entry_green\nfn f() -> Int { 1 }\n"),
  ) {
    ServeEntryCompileAdmitted => true
    ServeEntryCompileBlocked { blocking: _ } => false
    ServeEntryCompileUnobserved { detail: _ } => false
  }
}

// RED: detached HEAD not reachable from origin/main. GITHUB_REF_NAME is not an input of this
// fold, so supplying the CI event name as "main" cannot admit (the hole review 80259 named).
test fn a_detached_candidate_not_reachable_from_main_is_refused_for_production() -> Bool {
  match pre_swap_from_checkout(
    standing: checkout_branch_for_admission(
      named: "HEAD",
      admitted: production_admitted_branch,
      head: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      outcome: MergeBaseReported { base_hex: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" },
    ),
    admitted: production_admitted_branch,
    compile: ServeEntryCompileAdmitted,
  ) {
    PreSwapAdmitted => false
    PreSwapRefused { reason } =>
      string_contains(s: reason, pattern: "DetachedHeadNotOnAdmittedBranch")
        && string_contains(s: reason, pattern: "refs/remotes/origin/main")
  }
}

test fn a_detached_candidate_reachable_from_main_is_admitted() -> Bool {
  let head = "cccccccccccccccccccccccccccccccccccccccc"
  match pre_swap_from_checkout(
    standing: checkout_branch_for_admission(
      named: "HEAD",
      admitted: production_admitted_branch,
      head: head,
      outcome: MergeBaseReported { base_hex: head },
    ),
    admitted: production_admitted_branch,
    compile: ServeEntryCompileAdmitted,
  ) {
    PreSwapRefused { reason: _ } => false
    PreSwapAdmitted => true
  }
}

// Named checkout is still string equality; a refused merge-base does not rewrite the branch.
test fn a_named_branch_checkout_ignores_merge_base_standing() -> Bool {
  match checkout_branch_for_admission(
    named: "main",
    admitted: production_admitted_branch,
    head: "dddddddddddddddddddddddddddddddddddddddd",
    outcome: MergeBaseRefused { exit_code: 128, stderr: "not a git repository" },
  ) {
    CheckoutNamedBranch { branch } => branch == "main"
    DetachedHeadOnAdmittedBranch { head: _, branch: _ } => false
    DetachedHeadNotOnAdmittedBranch { head: _, branch: _, cause: _ } => false
  }
}

test fn operator_local_admission_does_not_consult_github_ref_name() -> Bool {
  let github_ref_name = "main"
  match checkout_branch_for_admission(
    named: "HEAD",
    admitted: production_admitted_branch,
    head: "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
    outcome: NoCommonAncestor,
  ) {
    DetachedHeadNotOnAdmittedBranch { cause } =>
      string_contains(s: cause, pattern: "DetachedHeadNotOnAdmittedBranch")
        && !string_contains(s: cause, pattern: "GITHUB_REF_NAME")
        && github_ref_name == (production_admitted_branch as String)
    CheckoutNamedBranch { branch: _ } => false
    DetachedHeadOnAdmittedBranch { head: _, branch: _ } => false
  }
}

test fn a_detached_merge_base_refusal_is_not_an_admission() -> Bool {
  match checkout_branch_for_admission(
    named: "HEAD",
    admitted: production_admitted_branch,
    head: "ffffffffffffffffffffffffffffffffffffffff",
    outcome: MergeBaseRefused { exit_code: 128, stderr: "fatal: Not a valid object name" },
  ) {
    DetachedHeadNotOnAdmittedBranch { cause } =>
      string_contains(s: cause, pattern: "exit 128")
    CheckoutNamedBranch { branch: _ } => false
    DetachedHeadOnAdmittedBranch { head: _, branch: _ } => false
  }
}
