module test.claim.live_deploy.service_ready

import gunbc.live_deploy.service_ready {
  ServiceNotReady,
  live_deploy_service_ready_scaffold,
  live_deploy_service_ready_scaffold_dissolution_trigger,
  live_deploy_host_sleep_generalization_dissolution_trigger,
  live_deploy_service_ready_unit_authority,
  live_deploy_service_ready_endpoint_authority,
  service_not_ready_reason,
  service_not_ready_refusal_at_poll_bound,
  live_deploy_readiness_poll_bound_is_positive,
  live_deploy_readiness_poll_bound_seconds,
  live_deploy_service_ready_poll_bound,
  live_deploy_service_ready_poll_cadence,
  live_deploy_service_ready_poll_max_attempts,
  UnitDiagnosis,
  UnitDiagnosisUnavailable,
  UnitDiagnosisCaptured,
}
import gunbc.live_deploy.spec { gunbc_roadmap_unit_name }
import gunbc.roadmap_static_site { roadmap_site_health_path }
import std.disposition { Scaffold, RealizationDispatch, Terminal }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.measure { second, second_count, measure_fit_count_floor }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn witness_service_ready_unit_authority() -> Bool {
  live_deploy_service_ready_unit_authority == gunbc_roadmap_unit_name
}

fn witness_service_ready_endpoint_authority() -> Bool {
  live_deploy_service_ready_endpoint_authority == roadmap_site_health_path
}

fn witness_service_not_ready_reason_is_located() -> Bool {
  let reason = service_not_ready_reason(refusal: ServiceNotReady {
    unit: gunbc_roadmap_unit_name,
    endpoint: roadmap_site_health_path,
    waited: second(count: 1),
    last_probe: "connection refused",
    unit_diagnosis: UnitDiagnosisCaptured { text: "Active: failed (Result: exit-code)" },
  })
  string_contains(s: reason, pattern: "ServiceNotReady")
    && string_contains(s: reason, pattern: "gunbc-roadmap.service")
    && string_contains(s: reason, pattern: "/healthz")
    && string_contains(s: reason, pattern: "connection refused")
    && string_contains(s: reason, pattern: "Active: failed (Result: exit-code)")
}

fn witness_readiness_poll_bound_grounded_on_std_measure_second() -> Bool {
  live_deploy_readiness_poll_bound_is_positive()
    && second_count(s: live_deploy_readiness_poll_bound_seconds()) == 30
}

fn witness_health_probe_path_matches_service_ready_endpoint() -> Bool {
  live_deploy_service_ready_endpoint_authority == roadmap_site_health_path
}

fn witness_scaffold_dissolution_trigger_binds_readiness_poll() -> Bool {
  match live_deploy_service_ready_scaffold_dissolution_trigger {
    Scaffold {
      dissolves_to: RealizationDispatch,
      bind: DeclarationRef { module_path: m, decl_name: n, field: WholeDeclaration },
    } =>
      m == "gunbc.live_deploy.readiness" && n == "live_deploy_poll_until_service_ready"
    Terminal { reason: _ } => false
  }
}

fn witness_scaffold_carries_named_dissolution_trigger() -> Bool {
  match live_deploy_service_ready_scaffold {
    Scaffold {
      dissolves_to: RealizationDispatch,
      bind: DeclarationRef { module_path: m, decl_name: n, field: WholeDeclaration },
    } =>
      m == "gunbc.live_deploy.service_ready"
        && n == "live_deploy_service_ready_scaffold_dissolution_trigger"
    Terminal { reason: _ } => false
  }
}

fn witness_red_control_never_ready_refuses_at_poll_bound() -> Bool {
  let refusal = service_not_ready_refusal_at_poll_bound(
    last_probe: "health probe never succeeded",
    unit_diagnosis: UnitDiagnosisCaptured { text: "Active: failed (Result: exit-code) Main PID: 4242 (code=exited, status=1/FAILURE)" }
  )
  let reason = service_not_ready_reason(refusal: refusal)
  string_contains(s: reason, pattern: "ServiceNotReady")
    && string_contains(s: reason, pattern: "waited_s=30")
    && string_contains(s: reason, pattern: "health probe never succeeded")
    && string_contains(s: reason, pattern: "status=1/FAILURE")
    && !string_contains(s: reason, pattern: "converged")
    && !string_contains(s: reason, pattern: "proceed anyway")
}

fn witness_refusal_locates_unit_state_distinctly_from_probe() -> Bool {
  let probe_only = service_not_ready_refusal_at_poll_bound(
    last_probe: "connection refused",
    unit_diagnosis: UnitDiagnosisUnavailable
  )
  let located = service_not_ready_refusal_at_poll_bound(
    last_probe: "connection refused",
    unit_diagnosis: UnitDiagnosisCaptured { text: "Active: failed (Result: exit-code) error: failed to bind 0.0.0.0:8080: Address already in use" }
  )
  let probe_only_reason = service_not_ready_reason(refusal: probe_only)
  let located_reason = service_not_ready_reason(refusal: located)
  string_contains(s: probe_only_reason, pattern: "connection refused")
    && !string_contains(s: probe_only_reason, pattern: "Address already in use")
    && string_contains(s: located_reason, pattern: "connection refused")
    && string_contains(s: located_reason, pattern: "Address already in use")
    && probe_only_reason != located_reason
}

fn witness_host_sleep_frontier_trigger_binds_srv3_consumer() -> Bool {
  match live_deploy_host_sleep_generalization_dissolution_trigger {
    Scaffold {
      dissolves_to: RealizationDispatch,
      bind: DeclarationRef { module_path: m, decl_name: n, field: WholeDeclaration },
    } =>
      m == "gunbc.host_effect" && n == "Srv3BootOnceReadBackSleep"
    Terminal { reason: _ } => false
  }
}

fn witness_poll_max_attempts_is_thirty() -> Bool {
  live_deploy_service_ready_poll_max_attempts() == 30
}

fn witness_poll_max_attempts_tracks_cadence() -> Bool {
  live_deploy_service_ready_poll_max_attempts() == measure_fit_count_floor(capacity: live_deploy_service_ready_poll_bound, each: live_deploy_service_ready_poll_cadence)
}

test fn live_deploy_service_ready_witnesses() -> Bool {
  witness_service_ready_unit_authority()
    && witness_service_ready_endpoint_authority()
    && witness_service_not_ready_reason_is_located()
    && witness_readiness_poll_bound_grounded_on_std_measure_second()
    && witness_health_probe_path_matches_service_ready_endpoint()
    && witness_scaffold_carries_named_dissolution_trigger()
    && witness_scaffold_dissolution_trigger_binds_readiness_poll()
    && witness_host_sleep_frontier_trigger_binds_srv3_consumer()
    && witness_poll_max_attempts_is_thirty()
    && witness_poll_max_attempts_tracks_cadence()
    && witness_red_control_never_ready_refuses_at_poll_bound()
    && witness_refusal_locates_unit_state_distinctly_from_probe()
}
