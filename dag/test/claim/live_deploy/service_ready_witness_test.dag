module test.claim.live_deploy.service_ready


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

test fn witness_service_ready_unit_authority() -> Bool {
  gunbc.live_deploy.service_ready.live_deploy_service_ready_unit_authority == gunbc.live_deploy.spec.gunbc_roadmap_unit_name
}

test fn witness_service_ready_endpoint_authority() -> Bool {
  gunbc.live_deploy.service_ready.live_deploy_service_ready_endpoint_authority == gunbc.roadmap_site_surface_render.roadmap_site_health_path
}

test fn witness_service_not_ready_reason_is_located() -> Bool {
  let reason = gunbc.live_deploy.service_ready.service_not_ready_reason(refusal: gunbc.live_deploy.service_ready.ServiceNotReady {
    unit: gunbc.live_deploy.spec.gunbc_roadmap_unit_name,
    endpoint: gunbc.roadmap_site_surface_render.roadmap_site_health_path,
    waited: std.measure.second(count: 1),
    last_probe: "connection refused",
    unit_diagnosis: gunbc.live_deploy.service_ready.UnitDiagnosisCaptured { text: "Active: failed (Result: exit-code)" },
  })
  string_contains(s: reason, pattern: "ServiceNotReady")
    && string_contains(s: reason, pattern: "gunbc-roadmap.service")
    && string_contains(s: reason, pattern: "/healthz")
    && string_contains(s: reason, pattern: "connection refused")
    && string_contains(s: reason, pattern: "Active: failed (Result: exit-code)")
}

test fn witness_readiness_poll_bound_grounded_on_std_measure_second() -> Bool {
  gunbc.live_deploy.service_ready.live_deploy_readiness_poll_bound_is_positive()
    && std.measure.second_count(s: gunbc.live_deploy.service_ready.live_deploy_readiness_poll_bound_seconds()) == 120
}

test fn witness_poll_bound_strictly_exceeds_expected_startup() -> Bool {
  let expected = std.measure.second_count(s: gunbc.live_deploy.service_ready.live_deploy_roadmap_unit_expected_startup)
  let bound = std.measure.second_count(s: gunbc.live_deploy.service_ready.live_deploy_service_ready_poll_bound)
  bound > expected
    && gunbc.live_deploy.service_ready.live_deploy_service_ready_poll_bound_margin_factor > 1
    && bound == expected * gunbc.live_deploy.service_ready.live_deploy_service_ready_poll_bound_margin_factor
}

test fn witness_expected_startup_covers_measured_srv1_observations() -> Bool {
  let expected = std.measure.second_count(s: gunbc.live_deploy.service_ready.live_deploy_roadmap_unit_expected_startup)
  expected >= 39
}

test fn witness_health_probe_path_matches_service_ready_endpoint() -> Bool {
  gunbc.live_deploy.service_ready.live_deploy_service_ready_endpoint_authority == gunbc.roadmap_site_surface_render.roadmap_site_health_path
}

test fn witness_scaffold_dissolution_trigger_binds_readiness_poll() -> Bool {
  match gunbc.live_deploy.service_ready.live_deploy_service_ready_scaffold_dissolution_trigger {
    std.disposition.Scaffold {
      dissolves_to: std.disposition.RealizationDispatch,
      bind: std.decl_ref.DeclarationRef { module_path: m, decl_name: n, field: std.decl_ref.WholeDeclaration },
    } =>
      m == "gunbc.live_deploy.readiness" && n == "live_deploy_poll_until_service_ready"
    std.disposition.Terminal { reason: _ } => false
  }
}

test fn witness_scaffold_carries_named_dissolution_trigger() -> Bool {
  match gunbc.live_deploy.service_ready.live_deploy_service_ready_scaffold {
    std.disposition.Scaffold {
      dissolves_to: std.disposition.RealizationDispatch,
      bind: std.decl_ref.DeclarationRef { module_path: m, decl_name: n, field: std.decl_ref.WholeDeclaration },
    } =>
      m == "gunbc.live_deploy.service_ready"
        && n == "live_deploy_service_ready_scaffold_dissolution_trigger"
    std.disposition.Terminal { reason: _ } => false
  }
}

test fn witness_red_control_never_ready_refuses_at_poll_bound() -> Bool {
  let refusal = gunbc.live_deploy.service_ready.service_not_ready_refusal_at_poll_bound(
    last_probe: "health probe never succeeded",
    unit_diagnosis: gunbc.live_deploy.service_ready.UnitDiagnosisCaptured { text: "Active: failed (Result: exit-code) Main PID: 4242 (code=exited, status=1/FAILURE)" }
  )
  let reason = gunbc.live_deploy.service_ready.service_not_ready_reason(refusal: refusal)
  string_contains(s: reason, pattern: "ServiceNotReady")
    && string_contains(s: reason, pattern: "waited_s=120")
    && string_contains(s: reason, pattern: "health probe never succeeded")
    && string_contains(s: reason, pattern: "status=1/FAILURE")
    && !string_contains(s: reason, pattern: "converged")
    && !string_contains(s: reason, pattern: "proceed anyway")
}

test fn witness_refusal_locates_unit_state_distinctly_from_probe() -> Bool {
  let probe_only = gunbc.live_deploy.service_ready.service_not_ready_refusal_at_poll_bound(
    last_probe: "connection refused",
    unit_diagnosis: gunbc.live_deploy.service_ready.UnitDiagnosisUnavailable
  )
  let located = gunbc.live_deploy.service_ready.service_not_ready_refusal_at_poll_bound(
    last_probe: "connection refused",
    unit_diagnosis: gunbc.live_deploy.service_ready.UnitDiagnosisCaptured { text: "Active: failed (Result: exit-code) error: failed to bind 0.0.0.0:8080: Address already in use" }
  )
  let probe_only_reason = gunbc.live_deploy.service_ready.service_not_ready_reason(refusal: probe_only)
  let located_reason = gunbc.live_deploy.service_ready.service_not_ready_reason(refusal: located)
  string_contains(s: probe_only_reason, pattern: "connection refused")
    && !string_contains(s: probe_only_reason, pattern: "Address already in use")
    && string_contains(s: located_reason, pattern: "connection refused")
    && string_contains(s: located_reason, pattern: "Address already in use")
    && probe_only_reason != located_reason
}

test fn witness_host_sleep_frontier_trigger_binds_srv3_consumer() -> Bool {
  match gunbc.live_deploy.service_ready.live_deploy_host_sleep_generalization_dissolution_trigger {
    std.disposition.Scaffold {
      dissolves_to: std.disposition.RealizationDispatch,
      bind: std.decl_ref.DeclarationRef { module_path: m, decl_name: n, field: std.decl_ref.WholeDeclaration },
    } =>
      m == "gunbc.host_effect" && n == "Srv3BootOnceReadBackSleep"
    std.disposition.Terminal { reason: _ } => false
  }
}

test fn witness_poll_max_attempts_is_thirty() -> Bool {
  gunbc.live_deploy.service_ready.live_deploy_service_ready_poll_max_attempts() == 120
}

test fn witness_poll_max_attempts_tracks_cadence() -> Bool {
  gunbc.live_deploy.service_ready.live_deploy_service_ready_poll_max_attempts() == std.measure.measure_fit_count_floor(capacity: gunbc.live_deploy.service_ready.live_deploy_service_ready_poll_bound, each: gunbc.live_deploy.service_ready.live_deploy_service_ready_poll_cadence)
}

