data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// ══ THE WITNESS OF THE TYPED ENSURE-DIRECTORY LEAF (W8 / host_effect Phase B, C1) ═══════════════
//
// WHAT THIS WITNESS IS FOR. The apply script this leaf replaces ended every directory leg with
// `|| exit`, and the two things that made that carrier dangerous were (a) it could not distinguish
// "the directory is not there" from "the host was never reached", and (b) a step that failed could
// still leave the script reporting success if the failure landed in a pooled body. So the claims
// below are not "the argv looks right": they are the two discriminations the script could not make,
// plus the refusal-carrying property the cutover is required to preserve.
//
// PER DESIGN §3, BOUNDARY VALUES ARE SUPPLIED, NOT DISCOVERED. The leaf's host-touching work sits
// behind two pure verdicts (live_deploy_apply_observer_read_verdict, live_deploy_apply_install_verdict
// -- the same shape as the sibling C2 leaf's host_remove_verdict), and the converged/refused mapping
// is itself pure (live_deploy_apply_ensure_reconciliation). Every value a host would have produced is
// handed in here as a literal, and the provider -- not a fixture of my own invention -- decides what
// it means. `OwnedDirectoryEnsured` is `sole_constructor`, so a converged outcome here can ONLY be
// reached by driving the real provider over the observations supplied below: this witness cannot
// fabricate the success it asserts.
//
// ONE CLAIM RUNS THE REAL ROUTE (the last test): the real srv1 deployment spec's demanded
// directories, through the real fold into the real provider against the real transport runner, over
// a transport that fails closed before any exec. Nothing privileged spawns in CI (there is no
// /usr/bin/sudo here either), and what is asserted is that a demanded-directory apply reaches the
// leaf and returns a typed refusal naming the endpoint.

// THE FIXTURES. The demanded directory is the service account's artifact directory, declared
// everyone-traversable (0755). The stat payloads are the exact shape `stat -c "%F|%U|%G|%a"` emits, so
// the provider's parser accepts them as readings rather than as EnsureInaccessible.

fn w_path() -> FilePath = "/srv/gunbc/artifacts" as NonEmptyStr

fn w_owner() -> PosixOwnerNames {
  PosixOwnerNames { user: "gunbc" as NonEmptyStr, group: "gunbc" as NonEmptyStr }
}

fn w_target() -> OwnedDirectoryTarget {
  OwnedDirectoryDeclared {
    member: "witness-demanded-directory" as NonEmptyStr,
    path: w_path(),
    owner: w_owner(),
    mode: DirectoryOwnerAllEveryoneTraverse,
  }
}

fn w_target_at(member: String, path: String) -> OwnedDirectoryTarget {
  OwnedDirectoryDeclared {
    member: member as NonEmptyStr,
    path: path as NonEmptyStr,
    owner: w_owner(),
    mode: DirectoryOwnerAllEveryoneTraverse,
  }
}

// The declared mode, read off the SAME arm the provider reads -- not a mode literal of mine.
fn w_mode() -> FileMode = declared_directory_mode(m: DirectoryOwnerAllEveryoneTraverse)

// `stat -c "%F|%U|%G|%a"` for a 0755 directory owned by the demanded principal.
fn w_stat_line(owner: String, octal: String) -> ObserverRead {
  ObserverReadOut { stdout: join(["directory|", owner, "|", owner, "|", octal, "\n"], "") }
}

fn w_listing(entry: String) -> ObserverRead {
  ObserverReadOut { stdout: join([entry, "\n"], "") }
}

// THE OBSERVATIONS, SUPPLIED. Each is built by the provider's own `owned_directory_observe` out of
// two pure closures, so "present", "absent" and "inaccessible" are the provider's categories.
fn w_present() -> EnsureObservation<OwnedDirectoryReading> {
  owned_directory_observe(
    path: w_path(),
    list: _ => w_listing("artifacts"),
    stat: _ => w_stat_line(owner: "gunbc", octal: "755"),
  )
}

fn w_absent() -> EnsureObservation<OwnedDirectoryReading> {
  owned_directory_observe(
    path: w_path(),
    list: _ => w_listing("something-else"),
    stat: _ => w_stat_line(owner: "gunbc", octal: "755"),
  )
}

fn w_foreign_owner() -> EnsureObservation<OwnedDirectoryReading> {
  owned_directory_observe(
    path: w_path(),
    list: _ => w_listing("artifacts"),
    stat: _ => w_stat_line(owner: "root", octal: "755"),
  )
}

fn w_unreachable() -> EnsureObservation<OwnedDirectoryReading> {
  owned_directory_observe(
    path: w_path(),
    list: _ => ObserverReadFailed { origin: ObserverTransportRefused { cause: "the fleet session is closed" } },
    stat: _ => ObserverReadFailed { origin: ObserverTransportRefused { cause: "the fleet session is closed" } },
  )
}

fn w_intent() -> HostEffectIntent {
  HostEffectIntent {
    target: HostOs { node: srv1_host },
    effect: ReadEffectivePosixPrincipal { read: EffectivePosixPrincipalRead {} },
    evidence: host_effect_identity_evidence,
    transport: LocalShell,
    privilege_denial: none,
  }
}

// A transport that fails closed WITHOUT EXECUTING: run_argv_over_host_effect_transport's FleetSsh arm
// refuses typed, before touching a session, because that arm's own authority is a separate change.
// That is what makes the real-route claim below both real and hermetic.
fn w_unreachable_transport() -> HostEffectTransport {
  // ANNOTATED SCRUTINEE: the fixture hands back an optional and the checker will not guess an
  // arm's meaning from an uninstantiated generic, so the produced value carries its declared type.
  let context: FleetSshExecutionContext? = fleet_ssh_execution_context_hermetic_witness_fixture()
  match context {
    Absent => LocalShell
    Present { value: ctx } =>
      FleetSsh {
        target: SshTarget {
          address: socket_address(
            host: host_by_ipv4(addr: ipv4_address(octet1: 203, octet2: 0, octet3: 113, octet4: 7)),
            port: 22,
          ),
          principal: "gunbc" as NonEmptyStr,
        },
        context: ctx,
      }
  }
}

fn w_words_of(argv: List<String>) -> String = join(["", join(argv, "\n"), ""], "\n")

fn w_reason(r: Reconciliation<HostEffectIntent, HostEffectEvidence>) -> String {
  match r {
    NotConverged { reason } => reason
    Converged { evidence: _ } => ""
  }
}

fn w_is_refusal(r: Reconciliation<HostEffectIntent, HostEffectEvidence>) -> Bool {
  match r {
    NotConverged { reason: _, applied: _ } => true
    Converged { evidence: _, applied: _ } => false
  }
}

fn w_receipt(r: Reconciliation<HostEffectIntent, HostEffectEvidence>) -> String {
  match r {
    Converged { evidence: ShellEffectApplied { stdout } } => stdout
    Converged { evidence: _ } => ""
    NotConverged { reason: _, applied: _ } => ""
  }
}

// ══ THE DISCRIMINATION THE SCRIPT COULD NOT MAKE ═══════════════════════════════════════════════
// `test -d <path> || exit` gave one answer for two very different worlds. Here the two arrive as
// different observer failures and the provider treats them differently: an absence can lead to an
// install, a refused transport refuses outright. This is the leaf's reason for existing, so it is
// asserted at BOTH layers -- the verdict mapping, and the decision the provider reaches from it.
test fn a_refused_host_is_never_read_as_an_absent_directory() -> Bool {
  match live_deploy_apply_observer_read_verdict(
    outcome: RunArgvTransportRefused { reason: "ssh: connect to host timed out" },
  ) {
    ObserverReadFailed { origin: ObserverTransportRefused { cause } } =>
      string_contains(s: cause, pattern: "timed out")
    _ => false
  }
  && match live_deploy_apply_observer_read_verdict(
    outcome: RunArgvTransportObserved {
      observed: ShellExecObserved {
        exit_code: 1, success: false, stdout: "", stderr: "stat: cannot stat: No such file or directory",
      },
    },
  ) {
    ObserverReadFailed { origin: ObserverExited { exit_code, stderr } } =>
      (exit_code == 1) && string_contains(s: stderr, pattern: "No such file")
    _ => false
  }
  // ...and the two are NOT interchangeable downstream: absent is work to do, unreachable is a refusal.
  && is_apply(decision: owned_directory_decide(policy: EnsureMayApply, target: w_target(), observation: w_absent()))
  && is_refusal_decision(
    decision: owned_directory_decide(policy: EnsureMayApply, target: w_target(), observation: w_unreachable()),
  )
}

fn is_apply(decision: UpsertDecision<OwnedDirectoryInstallPlan>) -> Bool {
  match decision {
    Apply { plan: _ } => true
    _ => false
  }
}

fn is_refusal_decision(decision: UpsertDecision<OwnedDirectoryInstallPlan>) -> Bool {
  match decision {
    Refuse { reason: _ } => true
    _ => false
  }
}

fn is_noop(decision: UpsertDecision<OwnedDirectoryInstallPlan>) -> Bool {
  match decision {
    Noop => true
    _ => false
  }
}

// A step that did not run is NOT "nothing to do". The old script's `install -d ... || exit 1` failed
// loudly; the failure a re-implementation reintroduces is the opposite -- reporting success because
// nothing errored. Pinned at the pure verdict: only an exit-0 observation means applied.
test fn an_install_that_did_not_run_is_not_applied() -> Bool {
  (!live_deploy_apply_install_verdict(outcome: RunArgvTransportRefused { reason: "transport refused" }))
    && (!live_deploy_apply_install_verdict(
      outcome: RunArgvTransportObserved {
        observed: ShellExecObserved {
          exit_code: 1, success: false, stdout: "", stderr: "install: cannot create directory",
        },
      },
    ))
    && live_deploy_apply_install_verdict(
      outcome: RunArgvTransportObserved {
        observed: ShellExecObserved { exit_code: 0, success: true, stdout: "", stderr: "" },
      },
    )
}

// ══ CONVERGED, ON THE PROVIDER'S LAW, WITH THE READBACK AS THE RECEIPT ══════════════════════════
// Both observations supplied as the same satisfying reading: the directory is already what the demand
// declares, the provider decides Noop (asserted, so the claim cannot pass through some other path),
// and the leaf converges on the READBACK rather than on an exit status. `run` is supplied as `false`
// deliberately: a converged outcome here must not depend on an install having claimed to happen.
test fn a_directory_already_matching_the_demand_converges_on_its_readback() -> Bool {
  is_noop(decision: owned_directory_decide(policy: EnsureMayApply, target: w_target(), observation: w_present()))
    && match owned_directory_ensure(
      policy: EnsureMayApply,
      target: w_target(),
      observe: _ => w_present(),
      run: _ => false,
    ) {
      OwnedDirectoryEnsured { target, converged: _ } =>
        (owned_directory_path(t: target) as String) == "/srv/gunbc/artifacts"
      OwnedDirectoryEnsureRefused { target: _, reason: _ } => false
    }
    && match live_deploy_apply_ensure_reconciliation(
      outcome: owned_directory_ensure(
        policy: EnsureMayApply,
        target: w_target(),
        observe: _ => w_present(),
        run: _ => false,
      ),
      intent: w_intent(),
    ) {
      Converged { evidence: ShellEffectApplied { exit_code, stdout, stderr } } =>
        (exit_code == 0)
          && (stderr == "")
          && string_contains(s: stdout, pattern: "/srv/gunbc/artifacts converged")
      _ => false
    }
}

// ══ THE REDS: EVERY OLD `|| exit` ARM IS A TYPED REFUSAL, NOT A SILENT DEFAULT ═══════════════════

// RED 1 -- the install did not run. The provider decides Apply (the directory is absent and a plan
// exists), the run closure reports the install did not happen, and the reconciliation MUST refuse.
// If a future edit made "did not run" converge, every directory leg of the apply would silently
// report success on a host where nothing was created.
test fn a_decided_install_that_did_not_run_refuses_instead_of_reporting_no_change() -> Bool {
  let outcome = owned_directory_ensure(
    policy: EnsureMayApply,
    target: w_target(),
    observe: _ => w_absent(),
    run: _ => false,
  )
  is_apply(decision: owned_directory_decide(policy: EnsureMayApply, target: w_target(), observation: w_absent()))
    && (!owned_directory_outcome_converged(o: outcome))
    && match live_deploy_apply_ensure_reconciliation(outcome: outcome, intent: w_intent()) {
      NotConverged { reason, applied } =>
        string_contains(s: reason, pattern: "live_deploy apply:")
          && string_contains(s: reason, pattern: "/srv/gunbc/artifacts")
          && is_intent_of_host_os(applied: applied)
      Converged { evidence: _, applied: _ } => false
    }
}

// RED 2 -- a foreign-owned directory is never adopted. The path exists and is a directory, but the
// principal differs, so there is no plan and the provider refuses; the old carrier's chown-anything
// posture does not survive, and neither does a silent success.
test fn a_foreign_owned_directory_refuses_and_is_never_adopted() -> Bool {
  let outcome = owned_directory_ensure(
    policy: EnsureMayApply,
    target: w_target(),
    observe: _ => w_foreign_owner(),
    run: _ => true,
  )
  is_refusal_decision(
    decision: owned_directory_decide(policy: EnsureMayApply, target: w_target(), observation: w_foreign_owner()),
  )
    && (!owned_directory_outcome_converged(o: outcome))
    && match live_deploy_apply_ensure_reconciliation(outcome: outcome, intent: w_intent()) {
      NotConverged { reason } =>
        string_contains(s: reason, pattern: "live_deploy apply:")
          && string_contains(s: reason, pattern: "ownership is never adopted")
          && string_contains(s: reason, pattern: "root")
      Converged { evidence: _, applied: _ } => false
    }
}

// RED 3 -- an unreadable host refuses, and the refusal carries the transport's own reason. The
// provider's EnsureInaccessible path is what keeps the privileged install from ever being dispatched
// against a host that was never read; the old script had no such gate.
test fn an_unreadable_host_refuses_carrying_the_transport_reason() -> Bool {
  match live_deploy_apply_ensure_reconciliation(
    outcome: owned_directory_ensure(
      policy: EnsureMayApply,
      target: w_target(),
      observe: _ => w_unreachable(),
      run: _ => true,
    ),
    intent: w_intent(),
  ) {
    NotConverged { reason } =>
      string_contains(s: reason, pattern: "live_deploy apply:")
        && string_contains(s: reason, pattern: "presence of /srv/gunbc/artifacts not established")
        && string_contains(s: reason, pattern: "the fleet session is closed")
    Converged { evidence: _, applied: _ } => false
  }
}

// EVERY REFUSAL NAMES THE DIRECTORY IT REFUSED. The pooled script's stderr did not survive as a
// per-directory fact; each leaf refusal must carry its own path (the fold's halt depends on it).
test fn each_refusal_names_the_directory_it_refused() -> Bool {
  let not_run = live_deploy_apply_ensure_reconciliation(
    outcome: owned_directory_ensure(
      policy: EnsureMayApply, target: w_target(), observe: _ => w_absent(), run: _ => false,
    ),
    intent: w_intent(),
  )
  let no_host = live_deploy_apply_ensure_reconciliation(
    outcome: owned_directory_ensure(
      policy: EnsureMayApply, target: w_target(), observe: _ => w_unreachable(), run: _ => true,
    ),
    intent: w_intent(),
  )
  string_contains(s: w_reason(r: not_run), pattern: "/srv/gunbc/artifacts")
    && string_contains(s: w_reason(r: no_host), pattern: "/srv/gunbc/artifacts")
}

fn is_intent_of_host_os(applied: HostEffectIntent) -> Bool {
  match applied.target {
    HostOs { node: _ } => true
    _ => false
  }
}

// ══ WHAT GOES ON THE WIRE (byte-equivalence wall, DESIGN §5) ════════════════════════════════════
// THE WITNESS'S REAL JOB: what the leaf puts on the wire must be what the deleted script put on the
// wire. The expected command is built HERE, from the same builders the apply script used to call
// (coreutils_install_directory_owned_arguments for the operands, ci_runner_sudo_binary_path for the
// sudoers-granted install path, sudo's own calling convention from extdeps.sudo.elevation) -- not
// typed out by hand, so the claim cannot pass because I typed the wrong thing, and cannot silently
// drift if the sealed operation's row is ever edited. `-d` and `-m` and `-o`/`-g` and the path must
// appear in that order, each flag SEPARATE from its operand: nothing is quoted because nothing is
// re-joined into a string, and a path or owner containing a space cannot change the command's
// meaning. There is exactly one elevation word and no shell carrier.
test fn the_privileged_write_is_what_the_deleted_script_emitted() -> Bool {
  let plan = OwnedDirectoryInstallPlan { path: w_path(), owner: w_owner(), mode: w_mode() }
  let words = argv_words(
    command: executor_privileged_operation_elevated_command(op: live_deploy_apply_install_op(plan: plan)),
  )
  // THE EXPECTED COMMAND, SPELLED BY THE BUILDERS THE SCRIPT USED.
  let expected = concat(
    [
      sudo_program().invocation as String,
      sudo_non_interactive_flag as String,
      ci_runner_sudo_binary_path(b: SudoInstall) as String,
    ],
    coreutils_install_directory_owned_arguments(
      mode: w_mode(), owner: "gunbc" as NonEmptyStr, group: "gunbc" as NonEmptyStr, path: "/srv/gunbc/artifacts",
    ),
  )
  (words == expected)
    // One elevation, no second sudo, and no shell anywhere in the words.
    && (count_word(words: words, wanted: "-n") == 1)
    && (count_word(words: words, wanted: "/usr/bin/sudo") == 1)
    && (!string_contains(s: w_words_of(argv: words), pattern: "bash"))
    && (!string_contains(s: w_words_of(argv: words), pattern: "; "))
    // The flags are their own words, so no quoting is needed: assert the separation directly. The
    // mode OPERAND is spelled by the builder rather than as a literal here -- `install -d` takes the
    // four-digit file_mode_octal with a further leading zero ("00755"), and pinning a hand-typed
    // digit string would have the claim fail on my arithmetic rather than on the command.
    && (count_word(words: words, wanted: "-m") == 1)
    && (count_word(words: words, wanted: "-d") == 1)
    && (count_word(words: words, wanted: coreutils_directory_mode_operand(mode: w_mode())) == 1)
    && (count_word(words: words, wanted: "/srv/gunbc/artifacts") == 1)
}

fn count_word(words: List<String>, wanted: String) -> Int {
  fold(words, init: 0, f: (acc, word) => if word == wanted { acc + 1 } else { acc })
}

// ══ THE FOLD HALTS AT THE FIRST REFUSAL (set -e preserved, not weakened) ════════════════════════
// Two demanded directories with DIFFERENT paths, on a transport that refuses every leg. The fold must
// return the FIRST refusal and never reach the second -- if it kept folding, the reason would name the
// second path. That asymmetry is what makes this discriminating rather than decorative.
test fn the_fold_halts_at_the_first_refused_directory_and_names_it() -> Bool {
  let first = w_target_at(member: "first-demanded-directory", path: "/srv/gunbc/first-dir")
  let second = w_target_at(member: "second-demanded-directory", path: "/srv/gunbc/second-dir")
  let r = live_deploy_apply_ensure_directories_on_host(
    demands: [first, second],
    transport: w_unreachable_transport(),
    intent: w_intent(),
  )
  w_is_refusal(r: r)
    && string_contains(s: w_reason(r: r), pattern: "/srv/gunbc/first-dir")
    && (!string_contains(s: w_reason(r: r), pattern: "/srv/gunbc/second-dir"))
}

// ══ INHABITANCE ON THE REAL ROUTE (DESIGN §3: at least one claim where it actually runs) ═════════
// The demanded-directory fold, over the REAL srv1 deployment spec's demanded directories -- not a
// fixture target -- driving the real provider against the real transport runner. Hermetic because the
// transport is the FleetSsh arm, which the host-effect runner refuses before any exec (its own
// authority is a separate change), so nothing privileged is spawned: there is no /usr/bin/sudo in the
// CI image either. What is asserted is the real-route SHAPE: a demanded-directory apply reaches the
// leaf, the observation refuses, and the apply comes back NotConverged naming the endpoint -- never a
// panic, never a fabricated convergence, never an empty success. The demands are asserted non-empty
// first, so this cannot pass vacuously over an empty list.
test fn the_srv1_demanded_directories_reach_the_leaf_and_refuse_without_a_transport() -> Bool {
  let demands = deployment_directory_demands(spec: deployment_spec_srv1())
  (list_length(items: demands) > 0)
    && match live_deploy_apply_ensure_directories_on_host(
      demands: demands,
      transport: w_unreachable_transport(),
      intent: w_intent(),
    ) {
      NotConverged { reason, applied } =>
        string_contains(s: reason, pattern: "live_deploy apply:")
          && string_contains(s: reason, pattern: "refuses the FleetSsh transport")
          && string_contains(s: reason, pattern: "203.0.113.7")
          && is_intent_of_host_os(applied: applied)
      Converged { evidence: _, applied: _ } => false
    }
}
