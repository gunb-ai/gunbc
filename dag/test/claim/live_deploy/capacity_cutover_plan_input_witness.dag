module test.claim.live_deploy.capacity_cutover_plan_input_witness

import gunbc.live_deploy.capacity_migration_source { capacity_main_cutover_intent, CapacityActivatorProducerMissing, capacity_plan_source_fault_text }
import gunbc.live_deploy.desired { srv1_lab_desired_deployment, selected_deployment_spec }
import gunbc.live_deploy.capacity_migration_approval { capacity_cutover_claim_input }
import std.types { Bool, String, NonEmptyStr }
import std.error_primitives { Result, Ok, Err }
import std.optional { Present, Absent }
import std.content_hash { Sha256Digest, sha256_hex_digest, sha256_hex_of_text }
import std.scoped_authorization { ClaimHeld, ClaimedBy, ClaimUndecided }
import std.durable_compare_and_set { cas_generation_first }
import extdeps.systemd.manager { SystemManager, UserManager }
import gunbc.compute.capacity_migration { CapacityManagedUnit }
import gunbc.live_deploy.capacity_cutover_intent { CapacityCutoverIntent, CapacityGenerationOperation, CapacityManagerReload, CapacityAfterInhibition, CapacityAfterInstall, CapacityAfterRemoval, capacity_cutover_intent_text, capacity_cutover_plan_digest }
import gunbc.live_deploy.capacity_cutover_plan_input { capacity_cutover_plan_input }
import test.claim.live_deploy.capacity_migration_approval_witness { approval_fixture_intent, approval_fixture_request, approval_fixture_grant, approval_fixture_helper_digest }

fn plan_input_fixture() -> CapacityCutoverIntent {
  let prior = approval_fixture_intent()
  CapacityCutoverIntent { drain: prior.drain, controller_slot: prior.controller_slot, instance_id: prior.instance_id, selected_identity: prior.selected_identity, host: prior.host, revision: prior.revision, attempt: prior.attempt,
    operations: prior.operations, file_operations: prior.file_operations, captures: prior.captures,
    reloads: [CapacityManagerReload { manager: UserManager { uid: 1000 },
      boundaries: [CapacityAfterInhibition, CapacityAfterInstall, CapacityAfterRemoval] }],
    generations: [CapacityGenerationOperation { subject: CapacityManagedUnit { manager: SystemManager, unit: "fixture.service" },
      destination: "/etc/systemd/system/fixture.service", root: "/var/lib/gunbc/cutover-capture/cutover-fixture", digest: approval_fixture_helper_digest }] }
}

test fn the_complete_canonical_operation_manifest_round_trips() -> Bool {
  let intent = plan_input_fixture()
  match capacity_cutover_plan_digest(intent: intent) {
    Err { value: _ } => false
    Ok { value: digest } => capacity_cutover_plan_input(text: capacity_cutover_intent_text(intent: intent) as String, approved: digest) == Ok { value: intent }
  }
}

test fn modified_input_is_refused_before_a_claim_is_attempted() -> Bool {
  let intent = plan_input_fixture()
  let request = match approval_fixture_request(intent: intent, escalation_id: "input-fixture") {
    Err { value: _ } => { return false } Ok { value: value } => value
  }
  match capacity_cutover_claim_input(text: concat(capacity_cutover_intent_text(intent: intent) as String, " "),
    request: request, authorization: approval_fixture_grant(request: request), at: "2026-10-29T00:01:00Z",
    claim: (id, attempt, at) => ClaimUndecided { reason: "claim reached" }) {
    Err { value: why } => why == "cutover plan input digest differs from the approval"
    Ok { value: _ } => false
  }
}

test fn verified_data_input_reaches_the_existing_inherited_claim() -> Bool {
  let intent = plan_input_fixture()
  let request = match approval_fixture_request(intent: intent, escalation_id: "input-fixture") {
    Err { value: _ } => { return false } Ok { value: value } => value
  }
  match capacity_cutover_claim_input(text: capacity_cutover_intent_text(intent: intent) as String,
    request: request, authorization: approval_fixture_grant(request: request), at: "2026-10-29T00:01:00Z",
    claim: (id, attempt, at) => ClaimHeld { state: ClaimedBy { attempt: attempt, claimed_at: at }, generation: cas_generation_first() }) {
    Err { value: _ } => false
    Ok { value: approved } => approved.intent == intent && approved.request == request.request
  }
}

fn plan_input_rejects_even_if_digest_is_approved(text: String) -> Bool {
  match sha256_hex_digest(hex: sha256_hex_of_text(text: text)) {
    Absent => false
    Present { value: digest } => match capacity_cutover_plan_input(text: text, approved: digest) {
      Err { value: _ } => true Ok { value: _ } => false
    }
  }
}

test fn source_and_unknown_operation_shapes_are_not_plan_data() -> Bool {
  plan_input_rejects_even_if_digest_is_approved(text: "module attacker\nfn main() {}")
    && plan_input_rejects_even_if_digest_is_approved(text: "[\"gunbc.capacity-cutover.v6\",\"srv1\",\"1111111111111111111111111111111111111111\",\"fixture\",[[\"system\",\"fixture.service\",\"exec-arbitrary\"]],[],[],[],[],\"fixture-deployment\",[\"test.claim.live_deploy.capacity_migration_approval_witness\",\"approval_fixture_intent\",\"whole\"]]")
    && plan_input_rejects_even_if_digest_is_approved(text: "[\"gunbc.capacity-cutover.v999\",\"srv1\",\"1111111111111111111111111111111111111111\",\"fixture\",[],[],[],[],[]]")
}


test fn a_v5_manifest_without_source_selection_is_not_upgraded() -> Bool {
  plan_input_rejects_even_if_digest_is_approved(text: "[\"gunbc.capacity-cutover.v5\",\"srv1\",\"1111111111111111111111111111111111111111\",\"fixture\",[],[],[],[],[]]")
}

// Approval-bound data survives a producer/roster change because recovery has no
// producer callback: it can only decode the retained envelope.
test fn a_changed_controller_exception_cannot_spend_the_original_plan_digest() -> Bool {
  let original = plan_input_fixture()
  let changed = CapacityCutoverIntent { instance_id: original.instance_id, selected_identity: original.selected_identity,
    host: original.host, revision: original.revision, attempt: original.attempt,
    operations: original.operations, file_operations: original.file_operations, captures: original.captures,
    generations: original.generations, reloads: original.reloads, drain: original.drain,
    controller_slot: Present { value: CapacityManagedUnit { manager: SystemManager, unit: "different-controller.service" } } }
  match capacity_cutover_plan_digest(intent: original) {
    Err { value: _ } => false
    Ok { value: digest } => match capacity_cutover_plan_input(text: capacity_cutover_intent_text(intent: changed) as String, approved: digest) {
      Err { value: why } => why == "cutover plan input digest differs from the approval"
      Ok { value: _ } => false
    }
  }
}

test fn a_v6_plan_with_a_matching_digest_is_incomplete() -> Bool {
  let text = "[\"gunbc.capacity-cutover.v6\",\"srv1\",\"1111111111111111111111111111111111111111\",\"fixture\",[],[],[],[],[],\"fixture\",[\"fixture\",\"fixture\",\"whole\"]]"
  match sha256_hex_digest(hex: sha256_hex_of_text(text: text)) {
    Absent => false
    Present { value: digest } => match capacity_cutover_plan_input(text: text, approved: digest) {
      Err { value: why } => why == "plan incomplete: v6 has no retained drain inputs"
      Ok { value: _ } => false
    }
  }
}

// One producer inhabitance control: exercise the actual plan builder's missing
// activator boundary. The other wire controls use supplied resolved values.
test fn the_v7_plan_builder_refuses_the_unmodeled_live_agent_door() -> Bool {
  let desired = srv1_lab_desired_deployment()
  let fixture = plan_input_fixture()
  match capacity_main_cutover_intent(spec: selected_deployment_spec(row: desired),
    selected_identity: desired.selected_identity, host: "srv1", revision: fixture.revision, attempt: fixture.attempt,
    installed: [], runners: Ok { value: [] }, controller_slot: none, operations: [],
    file_operations: [], captures: [], reloads: [], generations: []) {
    Err { value: CapacityActivatorProducerMissing { producer: producer, evidence: evidence } } =>
      producer == "agent-door" && evidence == "live unit observed, no producer has ever existed on main"
        && capacity_plan_source_fault_text(fault: CapacityActivatorProducerMissing { producer: producer, evidence: evidence })
          == "activator producer missing: agent-door (live unit observed, no producer has ever existed on main)"
    _ => false
  }
}
