module test.claim.live_deploy.tailnet_door_witness_test

import std.types { Bool, String, NonEmptyStr, CommitSha, List }
import std.layout { render }
import extdeps.systemd.unit_file { serialize_systemd_unit_file }
import extdeps.tailscale.serve { tailscale_serve_enable_argv, tailscale_serve_unix_target_path, tailscale_serve_backend_is_unix_target }
import gunbc.live_deploy.desired { deployment_spec_srv1, selected_deployment_spec, srv1_lab_desired_deployment }
import gunbc.live_deploy.emit { live_deploy_serve_unit_file, live_deploy_tailnet_door_unit_file, live_deploy_protocol }
import gunbc.live_deploy.release_locus { ReleaseRevisionBinding, RevisionBoundAtEmission }
import gunbc.live_deploy.spec {
  DeploymentSpec, DeploymentStep, ArtifactStep, Dependency, TailnetDoorServeUnit, TailscaleServeMapping,
  deployment_tailnet_door_socket, deployment_tailnet_door_unit_path, deployment_tailnet_door_steps,
}
import gunbc.roadmap_dashboard_instance { srv1_live_dashboard_instance, dashboard_instance_tailnet_door_socket }
import gunbc.roadmap_serve { roadmap_serve_handle_door }
import test.claim.live_deploy.deploy_release_fixture { deploy_witness_release_revision }
import gunbc.readiness { Ready, Pending, Refused }
import gunbc.host_effect { LocalShell }
import extdeps.http.client { http_client_get_unix_socket_argv }
import std.measure { second }
import gunbc.live_deploy.readiness {
  ServiceReadiness, ServiceReadyEvidence, ServiceProbeUnanswered, ServiceReadinessIdentityPending, ServiceTailnetDoorPending,
  ProcessRevisionMismatch, HealthzBodyRead, HealthzProbeRefused,
  service_readiness_with_tailnet_door, service_readiness_reason, live_deploy_healthz_get_for_socket,
}

fn door_revision() -> ReleaseRevisionBinding {
  RevisionBoundAtEmission { revision: "b2dd729f92954e50e3d8d9bbd65022c2d58f14dd" as CommitSha }
}

fn door_socket() -> String {
  dashboard_instance_tailnet_door_socket(instance: srv1_live_dashboard_instance()) as String
}

fn unit_text(spec: DeploymentSpec) -> String {
  match live_deploy_tailnet_door_unit_file(spec: spec, revision: door_revision()) {
    Absent => ""
    Present { value: unit } => serialize_systemd_unit_file(file: unit)
  }
}

// ONE SOCKET, THREE READERS. Production's serve route targets the instance's door socket, the door
// unit binds that same path, and the mapping the deploy installs proxies to it: the route's
// backend is the only place the path is stated and the other two read it back. RED if the unit
// and the route can name different sockets, or the route goes back to a port.
test fn production_serve_route_unit_and_mapping_name_one_door_socket() -> Bool {
  let spec = deployment_spec_srv1()
  let argv = join(tailscale_serve_enable_argv(endpoint: spec.names.tailscale_serve_endpoint), " ")
  tailscale_serve_backend_is_unix_target(endpoint: spec.names.tailscale_serve_endpoint)
    && deployment_tailnet_door_socket(names: spec.names) == Present { value: door_socket() as NonEmptyStr }
    && argv == join(["serve --bg --https=443 unix:", door_socket()], "")
    && string_contains(s: unit_text(spec: spec), pattern: join([" --unix-socket ", door_socket(), " "], ""))
}

// THE DOOR UNIT IS THE LOOPBACK UNIT ON ANOTHER LISTENER AND ENTRY, and nothing else: replacing
// the door's description, entry function and listener with the loopback unit's yields the loopback
// unit's bytes, so the two cannot drift in principal, slice, tree, environment or evaluation caps.
// It launches the door entry and binds no TCP port.
test fn the_door_unit_differs_from_the_loopback_unit_only_in_entry_and_listener() -> Bool {
  let spec = deployment_spec_srv1()
  let door = unit_text(spec: spec)
  let loopback = serialize_systemd_unit_file(file: live_deploy_serve_unit_file(spec: spec, revision: door_revision()))
  let rebuilt = door
    .replace(from: "gunbc roadmap tailnet door (gunbc serve)", to: "gunbc roadmap HTTP server (gunbc serve)")
    .replace(from: " --function roadmap_serve_handle_door ", to: " --function roadmap_serve_handle ")
    .replace(from: join([" --unix-socket ", door_socket()], ""), to: join([" --host ", spec.service.listen.host, " --port ", to_string(spec.service.listen.port)], ""))
  door != "" && door != loopback && rebuilt == loopback
    && string_contains(s: door, pattern: " --function roadmap_serve_handle_door --unix-socket ")
    && !string_contains(s: door, pattern: " --port ")
}

fn step_is(step: DeploymentStep, door: Bool) -> Bool {
  match step {
    ArtifactStep { step: art } => if door { art.kind == TailnetDoorServeUnit } else { art.kind == TailscaleServeMapping }
    Dependency { step: _ } => false
  }
}

// Of the door unit and the serve mapping, whichever the steps reach first is the door.
fn door_is_first_of_the_pair(steps: List<DeploymentStep>) -> Bool {
  match first(filter(steps, s => step_is(step: s, door: true) || step_is(step: s, door: false))) {
    Present { value: s } => step_is(step: s, door: true)
    Absent => false
  }
}

// THE DOOR IS STARTED BEFORE THE ROUTE POINTS AT IT: production's steps carry exactly one door unit
// member, at its unit path, ahead of the serve mapping. A deployment whose route targets a port
// (the lab twin) has no door socket, no door unit and no door member.
test fn the_door_unit_precedes_the_mapping_and_a_port_routed_deployment_has_none() -> Bool {
  let spec = deployment_spec_srv1()
  let twin = selected_deployment_spec(row: srv1_lab_desired_deployment())
  let doors = deployment_tailnet_door_steps(names: spec.names)
  count(doors) == 1
    && all(doors, d => d.path == deployment_tailnet_door_unit_path(names: spec.names))
    && count(filter(spec.steps, s => step_is(step: s, door: true))) == 1
    && count(filter(spec.steps, s => step_is(step: s, door: false))) == 1
    && door_is_first_of_the_pair(steps: spec.steps)
    && deployment_tailnet_door_socket(names: twin.names) == none
    && unit_text(spec: twin) == ""
    && count(filter(twin.steps, s => step_is(step: s, door: true))) == 0
}

// THE ENTRY THE UNIT LAUNCHES EXISTS AND ANSWERS: the socket's attested peer crosses
// the real entry, security seam and route table. A GET to the POST-only dispatch route
// answers 405 before any host read or write. Page rendering is not this claim's subject;
// the roadmap serve witnesses retain the real unknown-route/404 coverage.
test fn the_door_entry_answers_a_request_with_an_attested_peer() -> Bool {
  let response = roadmap_serve_handle_door(
    method: "GET",
    path: "/dispatch/door-fixture",
    body: "",
    tailscale_identity: "operator@example.invalid",
    peer_user: "root",
    request_headers: [],
    release_revision: deploy_witness_release_revision,
  )
  response.status == 405 && string_contains(s: response.body, pattern: "POST")
}

// ── The door is part of deploy readiness ─────────────────────────────────────────────────────────

fn ready() -> ServiceReadiness {
  Ready { evidence: ServiceReadyEvidence { body: "loopback healthz body" } }
}

fn door_join(loopback: ServiceReadiness, door: ServiceReadiness) -> ServiceReadiness {
  service_readiness_with_tailnet_door(loopback: loopback, door_socket: Present { value: door_socket() as NonEmptyStr }, door: fn() { door })
}

fn is_door_pending_naming(r: ServiceReadiness, text: String) -> Bool {
  match r {
    Pending { cause: ServiceTailnetDoorPending { socket, detail: _ } } =>
      (socket as String) == door_socket()
        && string_contains(s: service_readiness_reason(r: r), pattern: door_socket())
        && string_contains(s: service_readiness_reason(r: r), pattern: text)
    Pending { cause: ServiceProbeUnanswered { detail: _ } } => false
    Pending { cause: ServiceReadinessIdentityPending { cause: _ } } => false
    Ready { evidence: _ } => false
    Refused { cause: _ } => false
  }
}

// A DEAD OR STALE DOOR IS NOT A READY DEPLOYMENT. With the loopback listener ready: a door that
// does not answer, and a door answering as another release, are each pending under the door's own
// arm, naming the socket and carrying the probe's own words -- which is what the poll bound turns
// into the deploy's refusal. RED if a ready loopback listener alone ever makes the deployment ready.
test fn a_dead_or_stale_door_holds_a_ready_loopback_listener_pending() -> Bool {
  let dead = door_join(loopback: ready(), door: Pending { cause: ServiceProbeUnanswered { detail: "curl: (7) Couldn't connect to server" } })
  let stale = door_join(loopback: ready(), door: Pending { cause: ServiceReadinessIdentityPending { cause: ProcessRevisionMismatch { expected: "aaaa", observed: "bbbb" } } })
  is_door_pending_naming(r: dead, text: "curl: (7)")
    && is_door_pending_naming(r: stale, text: "bbbb")
}

// POSITIVE CONTROL AND THE TWO BOUNDS OF THE JOIN: both listeners ready is ready; a deployment
// with no door is exactly its loopback observation; and a ready door never upgrades a loopback
// listener that is not.
test fn the_door_join_is_ready_only_when_both_listeners_are() -> Bool {
  let unanswered = Pending { cause: ServiceProbeUnanswered { detail: "loopback not answering" } }
  let both = door_join(loopback: ready(), door: ready())
  let no_door = service_readiness_with_tailnet_door(loopback: ready(), door_socket: none, door: fn() { unanswered })
  let loopback_down = door_join(loopback: unanswered, door: ready())
  both == ready() && no_door == ready() && loopback_down == unanswered
}

// THE PROBE THE DEPLOY RUNS, through its real route: the bounded GET over the door socket. Where
// no door is listening it is a refused probe, never a body, and its ssh spelling connects to the
// socket rather than to a port.
test fn the_door_probe_over_an_unanswering_socket_is_a_refused_probe() -> Bool {
  let read = live_deploy_healthz_get_for_socket(socket: "/nonexistent/gunbc-fixture/tailnet-door.sock" as NonEmptyStr, spec: deployment_spec_srv1(), transport: LocalShell)
  let argv = join(http_client_get_unix_socket_argv(socket: door_socket() as NonEmptyStr, url: "http://localhost/healthz" as NonEmptyStr, max_time: second(count: 5)), " ")
  (match read {
    HealthzProbeRefused { probe_error: _ } => true
    HealthzBodyRead { body: _ } => false
  })
    && string_contains(s: argv, pattern: join(["--unix-socket ", door_socket(), " "], ""))
    && !string_contains(s: argv, pattern: "127.0.0.1")
}
