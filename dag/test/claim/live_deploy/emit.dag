data unprivileged_principal_witness_note: String = "Discriminating RED for the run-29822498755 regression class: the ci-runner principal (fleet_posix_accounts FleetAccountCiRunner) holds NO rsync/chown/rmdir grant and no write on the service-user-owned tree, so a bare rsync/chown/rmdir in either script is a deploy that fails on the host again. Working-byte rsync and repository convergence must instead ride the service-user oneshot unit (principal User=briansrls), and every mutation outside it must be one of the roster-granted sudo -n commands (fleet_posix_ci_runner_sudo_grants). Post-hoc admission of each sudo -n command against the ci_deploy_access grant envelope is the named residue (carried by the annotation on gunbc.live_deploy.emit install_d_owned_command)."

test fn retract_script_stays_within_ci_runner_grants() -> Bool {
  let retract = witness_retract_script()
  !string_contains(s: retract, pattern: "chown")
    && !string_contains(s: retract, pattern: "rmdir")
    && !string_contains(s: retract, pattern: "rsync")
}

fn transports_git_metadata_as_files(unit: String) -> Bool {
  string_contains(s: unit, pattern: "$\{GUNBC_TREE_SRC\}/.git/")
    && string_contains(s: unit, pattern: "--include=/HEAD")
    && string_contains(s: unit, pattern: "--include=/objects/***")
    && string_contains(s: unit, pattern: "--include=/refs/***")
}

fn later_segments_contain_third_after_second(segments: List<String>, second: String, third: String) -> Bool {
  if segments.count() == 0 {
    false
  } else {
    let segment = segments.first()
    if string_contains(s: segment, pattern: second) {
      any(split(s: segment, sep: second).skip(n: 1), part => string_contains(s: part, pattern: third))
        || any(segments.skip(n: 1), part => string_contains(s: part, pattern: third))
    } else {
      later_segments_contain_third_after_second(segments: segments.skip(n: 1), second: second, third: third)
    }
  }
}

// ONE FORWARD PASS OVER SEGMENTS AFTER THE FIRST MARKER. The previous comparison computed four
// offsets by splitting from the start each time, and its first replacement rebuilt two large
// suffix strings; the required floor measured those shapes at 505ms and 511ms against a 500ms CPU
// line. These fixed literal markers do not contain one another, so a match cannot straddle a split
// boundary and the segments can be searched directly without either large join.
fn three_markers_in_order(text: String, first: String, second: String, third: String) -> Bool {
  let after_first = split(s: text, sep: first).skip(n: 1)
  string_contains(s: text, pattern: first)
    && any(after_first, part => string_contains(s: part, pattern: second))
    && later_segments_contain_third_after_second(segments: after_first, second: second, third: third)
}

data tree_sync_restart_diagnosis_witness_note: String = "Discriminating RED for #7011/receipt 29928424523: the tree-sync restart is synchronous and precedes the poll-based unit_diagnosis capture, so a bare restart failure carries no WHY. The apply script must fall through to the same unit-status-tail authority the roadmap-unit diagnosis already uses (never a second format), append it to stderr, and still fail the step — never proceed as if the restart had succeeded."

data owned_only_removes_exactly_its_own_endpoint_note: String = "THIS CONJUNCT HAS NOW BEEN WRONG IN BOTH DIRECTIONS, which is what makes the third version worth stating carefully. It first REQUIRED `sudo -n tailscale serve reset` — a claim named owned_only demanding the one command on the host that is definitionally not owned-only (review 45207). It was then inverted to forbid every privileged tailscale invocation and require a refusal marker, which was honest about the emission but rested on the emission being right, and it was not: the refusal existed because the model asserted, without citation, that the CLI has no scoped removal.\\n\\nSo the pattern to watch is that a witness cannot be more correct than the claim it transcribes. Both earlier versions were faithful readings of the artifact in front of them; neither could have found that the artifact was answering the wrong question, and no strengthening of a string match over the retract would have surfaced it.\\n\\nThe assertion is now positive and specific: the retract issues the scoped `off` for the endpoint this deployment configured, and never the node-global reset. Requiring the exact off spelling is what ties it to the apply — the upstream demands every original flag on an off command, so a retract whose flags drift from its apply removes nothing while exiting zero, and that is the failure this conjunct exists to catch."

test fn witness_retract_script_owned_only() -> Bool {
  let sh = witness_retract_script()
  !string_contains(s: sh, pattern: "sudo bash")
    && !string_contains(s: sh, pattern: "tailscale serve reset")
    && string_contains(s: sh, pattern: retract_leg_text(leg: RetractServeOff { endpoint: deployment_spec_srv1().names.tailscale_serve_endpoint }))
    && string_contains(s: sh, pattern: join(["disable-if-loaded ", gunbc_roadmap_unit_name as String], ""))
    && string_contains(s: sh, pattern: "remove-files /opt/gunbc/bin/gunbc")
    && string_contains(s: sh, pattern: "remove-empty-directory /opt/gunbc/dispatch-worktrees")
    && string_contains(s: sh, pattern: "remove-tree /opt/gunbc/gunbc")
    && !string_contains(s: sh, pattern: "remove-tree /opt/gunbc/dispatch-worktrees")
    && string_contains(s: sh, pattern: "remove-files /etc/systemd/system/gunbc-tree-sync.service")
    && string_contains(s: sh, pattern: "/etc/gunbc-tree-sync.env")
    && string_contains(s: sh, pattern: "/etc/systemd/system/gunbc-roadmap.service")
    && !string_contains(s: sh, pattern: "apt-get remove")
    && !string_contains(s: sh, pattern: "apt-get purge")
}

data apply_no_frozen_page_note: String = "The belt-B section-3 fix made executable: the apply script ships NO emitted node server and NO deploy-frozen page snapshot — the service renders the live roadmap per request. These two witnesses red if either ever creeps back into the apply script."

test fn witness_retract_owned_process_removes_serve_service() -> Bool {
  let sh = witness_retract_script()
  string_contains(s: sh, pattern: "/opt/gunbc/bin/gunbc")
    && string_contains(s: sh, pattern: gunbc_roadmap_unit_name)
    && !string_contains(s: sh, pattern: "tailscale serve reset")
    && string_contains(s: sh, pattern: retract_leg_text(leg: RetractServeOff { endpoint: deployment_spec_srv1().names.tailscale_serve_endpoint }))
    && string_contains(s: sh, pattern: join(["disable-if-loaded ", gunbc_roadmap_unit_name as String], ""))
    && !string_contains(s: sh, pattern: "roadmap-site-readback")
}

// THE PIN NOW ALSO GUARDS THE EVALUATION BUDGET, AND THAT IS THE POINT OF EXTENDING IT
// RATHER THAN ADDING A SEPARATE CONTAINS-CHECK. srv1 served with
// eval_budget_cpu_ms=unset eval_budget_wall_ms=unset on every restart of 2026-08-10
// because the unit passed neither flag; the deadline was armed with None on every request,
// and since the accept loop is serial an unbounded request held the queue for hours. A
// whole-line assertion is what makes silently dropping a flag red — a prefix check ending
// at --port 8080 stays green with both caps missing, which is precisely how the gap
// survived.
data execstart_budget_pin_note: String = "The two caps are pinned at their declared values, not merely asserted present. A present-but-different value is a policy amendment and must red here so it is reviewed as one; gunbc.live_deploy.spec dashboard_serve_budget_basis_note carries the measured basis those numbers answer to."

data execstart_pinned_exactly_note: String = "THE FULL ExecStart LINE, PINNED, WITH THE REVISION IN IT — WHICH IS WHAT THE DELETED GOLDEN NEVER ASSERTED. The committed script golden compared whole files, so it would have reddened on any change anywhere and located none of them; the sibling unit witness asserts only a command PREFIX and stops before the flag. Between them, a unit that emitted no --release-revision at all, or emitted it twice, or emitted a different value, passed every check in this file.\\n\\nSo this pins the entire line and the three REDs each break exactly one way it could be wrong: the flag missing, the value belonging to another candidate, or the flag duplicated. A prefix check cannot distinguish any of them, which is why the assertion is the whole line rather than a longer prefix."

test fn witness_execstart_carries_exactly_the_admitted_revision() -> Bool {
  let unit = live_deploy_systemd_unit_for(
    spec: deployment_spec_srv1(),
    revision: RevisionBoundAtEmission { revision: deploy_witness_release_revision },
    now_epoch: claim_oidc_now(),
  )
  let expected = join([
    "ExecStart=/opt/gunbc/bin/gunbc serve --source-root dag --source-root src/v2",
    " --entry dag/gunbc/roadmap/roadmap_serve.dag --function roadmap_serve_handle",
    " --host 127.0.0.1 --port 8080",
    " --release-revision ", deploy_witness_release_revision as String,
    " --eval-budget-cpu-ms 30000",
    " --eval-budget-wall-ms 120000",
  ], "")
  string_contains(s: unit, pattern: expected)
    && !string_contains(s: unit, pattern: concat(expected, " --release-revision"))
    && !string_contains(s: unit, pattern: deploy_witness_other_release_revision as String)
    && !string_contains(s: unit, pattern: "$")
}

test fn witness_execstart_omitting_the_revision_is_not_the_emitted_line() -> Bool {
  let unit = live_deploy_systemd_unit_for(
    spec: deployment_spec_srv1(),
    revision: RevisionBoundAtEmission { revision: deploy_witness_release_revision },
    now_epoch: claim_oidc_now(),
  )
  !string_contains(s: unit, pattern: "--port 8080\nRestart=")
    && !string_contains(s: unit, pattern: "--release-revision \n")
    && string_contains(s: unit, pattern: concat("--release-revision ", deploy_witness_release_revision as String))
}

test fn witness_execstart_at_another_candidate_differs() -> Bool {
  let a = live_deploy_systemd_unit_for(
    spec: deployment_spec_srv1(),
    revision: RevisionBoundAtEmission { revision: deploy_witness_release_revision },
    now_epoch: claim_oidc_now(),
  )
  let b = live_deploy_systemd_unit_for(
    spec: deployment_spec_srv1(),
    revision: RevisionBoundAtEmission { revision: deploy_witness_other_release_revision },
    now_epoch: claim_oidc_now(),
  )
  a != b
    && string_contains(s: b, pattern: deploy_witness_other_release_revision as String)
    && !string_contains(s: b, pattern: deploy_witness_release_revision as String)
}

test fn witness_systemd_unit_emitted() -> Bool {
  let unit = live_deploy_systemd_unit_for(spec: deployment_spec_srv1(), revision: RevisionBoundAtEmission { revision: deploy_witness_release_revision }, now_epoch: claim_oidc_now())
  string_contains(s: unit, pattern: "ExecStart=/opt/gunbc/bin/gunbc serve --source-root dag --source-root src/v2 --entry dag/gunbc/roadmap/roadmap_serve.dag --function roadmap_serve_handle --host 127.0.0.1 --port 8080")
    && string_contains(s: unit, pattern: "User=briansrls")
    && string_contains(s: unit, pattern: "Group=briansrls")
    && string_contains(s: unit, pattern: "WorkingDirectory=/opt/gunbc/gunbc")
    && !string_contains(s: unit, pattern: "node")
}

test fn witness_remote_mutation_service_op_realization_binds_emit_shell_phase_b_axis() -> Bool {
  match live_deploy_remote_mutation_service_op_realization_dissolution_trigger {
    Scaffold {
      dissolves_to: RealizationDispatch,
      bind: DeclarationRef { module_path: m, decl_name: n, field: WholeDeclaration },
    } =>
      m == "gunbc.live_deploy.emit"
        && n == "tree_sync_restart_step_with_diagnosis"
    Terminal { reason: _ } => false
    Scaffold { dissolves_to: SingleAuthority, bind: _ } => false
    Scaffold { dissolves_to: SubstrateMandatoryTag, bind: _ } => false
  }
}

test fn witness_dependency_graph_emit_frontier_binds_orch_emit_pipeline() -> Bool {
  match live_deploy_intent_dependency_graph_emit_dissolution_trigger {
    Scaffold {
      dissolves_to: RealizationDispatch,
      bind: DeclarationRef { module_path: m, decl_name: n, field: WholeDeclaration },
    } =>
      m == "v2.compiler.emit_orchestration" && n == "orch_emit_pipeline"
    Terminal { reason: _ } => false
    Scaffold { dissolves_to: SingleAuthority, bind: _ } => false
    Scaffold { dissolves_to: SubstrateMandatoryTag, bind: _ } => false
  }
}



data emit_poison_backstop_witness_note: String = "GOLDEN-INDEPENDENT backstop (calm-ferret pass-2 flag 2): the emit-level poison markers (teardown-dependency-unreachable, wholesale-refused) are the defense-in-depth backstop to the PRIMARY typed refusal (the EffectsOrRefusal SUM, proven golden-independent by w_effects_refuses_wholesale_on_any_refusal in the spine test). But the poison backstops are golden-DEPENDENT — a regen while a refusal was buggily active could commit a poisoned golden and the drift gate would then pass. These two witnesses call the refusal producers directly and assert the marker is present, golden-INDEPENDENT, so a golden-absorption can never hide that the arm still refuses loudly."

test fn witness_teardown_dependency_arm_refuses_golden_independent() -> Bool {
  match deploy_retract_effect_plan(
    effect: EffectRemove { from: Dependency { step: DeploymentDependencyStep { kind: TmuxPackage, subject: EnsuredPackage { package: package_tmux } } } },
    spec: deployment_spec_srv1(),
  ) {
    RetractPlanRefused { step: st, reason: _ } => st == "dependency-teardown"
    RetractPlanReady { legs: _ } => false
  }
}

data twin_on_one_host_witness_note: String = "THE CLAIM THAT WAS UNWRITABLE BEFORE THIS CHANGE, and it is the whole point of it. deployment_owned_steps and deployment_service_config took no arguments, so there was exactly one deployment in the model and a second one on the SAME machine could not be constructed at all — not merely inconvenient, unexpressible. That is what proved host was the wrong axis: if the only thing that varies is which host, then two deployments on one host is a contradiction, and a model that makes it a contradiction has fused two independent facts.\\n\\nSo the test is the twin. Same target — one machine, one ssh host, one package manager — and a different instance, and every owned path, the unit, the tailscale mapping and the port must come out disjoint. srv1_lab is a real declared instance rather than a synthetic one, so this also states that the two dashboards already declared today CAN both be deployed, which was false an hour ago.\\n\\nThe conjunct that would survive a bad fix is the target equality. Without it the claim passes trivially if someone makes the twin differ by host, which is precisely the abstraction this replaces."

fn srv1_twin_spec() -> DeploymentSpec {
  selected_deployment_spec(row: srv1_lab_desired_deployment())
}

fn spec_owned_paths(spec: DeploymentSpec) -> List<String> {
  deployment_owned_steps_retract_order(spec: spec) |> map(s => s.path as String)
}


// THE TWIN MIRRORS PRODUCTION AS AN IDENTITY JOIN ON ARTIFACT KIND, NOT A COUNT. Placement-scoped
// members are named by the functions that decide them and subtracted from each roster by path;
// every other production member must have a twin member of the same kind and vice versa. The count
// form this replaces (`twin + fabric == live`) went red the day #12747 added a second host-scoped
// member, though nothing about the twin was wrong. Production's extras are the fabric storage
// placement's two, the approval broker's front door, and the tailnet door (production's serve route
// targets a socket; the twin's does not). The twin's extra is the OIDC config file, present only
// where tracker_web_oidc_serve_placement is ServeReady. Each side must own none of the other's
// placement-scoped members.
fn placement_scoped_paths(spec: DeploymentSpec, instance: HostDashboardInstance) -> List<String> {
  concat(
    deployment_fabric_storage_steps(holding: spec.role_singletons, names: spec.names),
    concat(
      deployment_approval_broker_front_door_steps(holding: spec.role_singletons),
      concat(
        deployment_tailnet_door_steps(names: spec.names),
        deployment_oidc_config_steps(instance: instance),
      ),
    ),
  ) |> map(s => s.path as String)
}

test fn a_twin_deployment_on_one_host_collides_with_nothing() -> Bool {
  let live = deployment_spec_srv1()
  let twin = srv1_twin_spec()
  let live_instance = srv1_live_dashboard_instance()
  let lab_instance = srv1_lab_dashboard_instance()
  let live_paths = spec_owned_paths(spec: live)
  let twin_paths = spec_owned_paths(spec: twin)
  let live_scoped_paths = placement_scoped_paths(spec: live, instance: live_instance)
  let twin_scoped_paths = placement_scoped_paths(spec: twin, instance: lab_instance)
  let live_instance_scoped = filter(deployment_owned_steps_retract_order(spec: live), l => !any(live_scoped_paths, h => h == (l.path as String)))
  let twin_instance_scoped = filter(deployment_owned_steps_retract_order(spec: twin), t => !any(twin_scoped_paths, h => h == (t.path as String)))
  deployment_plan_host_identity(spec: live) == deployment_plan_host_identity(spec: twin)
    && !(deployment_plan_listen_port(spec: live) == deployment_plan_listen_port(spec: twin))
    && !(live.service.unit_name == twin.service.unit_name)
    && !(live.service.repo_root == twin.service.repo_root)
    && !(live.service.serve_binary == twin.service.serve_binary)
    && count(live_instance_scoped) > 0
    && all(live_scoped_paths, h => any(live_paths, l => l == h))
    && all(twin_scoped_paths, h => any(twin_paths, t => t == h))
    && all(live_instance_scoped, l => any(twin_instance_scoped, t => t.kind == l.kind))
    && all(twin_instance_scoped, t => any(live_instance_scoped, l => l.kind == t.kind))
    && count(deployment_fabric_storage_steps(holding: HoldsNoRoleSingleton, names: twin.names)) == 0
    && count(deployment_approval_broker_front_door_steps(holding: HoldsNoRoleSingleton)) == 0
    && count(deployment_tailnet_door_steps(names: twin.names)) == 0
    && count(deployment_oidc_config_steps(instance: live_instance)) == 0
    && count(deployment_oidc_config_steps(instance: lab_instance)) > 0
    && all(twin_paths, t => !any(live_paths, l => l == t))
}

data placement_scoped_members_note: String = "THE TWIN MIRRORS PRODUCTION ONE-FOR-ONE EXCEPT FOR THE PLACEMENT'S OWN MEMBERS. The fabric DB endpoint -- its serve unit and its tailscale route -- is a host singleton owned by the one instance that holds the fabric DB placement (gunbc.fabric.fabric_storage_placement fabric_storage_placed_on), so production carries exactly those members more than the twin, and the twin none. Production's tailnet door is the same: it exists because production's serve route targets a socket. The OIDC config file is the converse: tracker_web_oidc_serve_placement is ServeReady only for the lab instance assigned the realized TEST environment, so the twin carries that member and production none. The relation stays between two live rosters: the difference is named by the function that decides it, not typed as a number."

data non_degeneracy_without_transcription_note: String = "THE COUNTS ABOVE STOPPED BEING LITERALS (review, 2026-07-30 — the live-state count-transcription class ruled against on 2026-07-29 and swept in #7464). Five was read off the live owned roster, so authoring a correct sixth member reds a claim that has nothing to say about members, and the reviewer's habit becomes editing the number until the day the number is wrong for a real reason. #7478 adds exactly such a member.\\n\\nDeleting the conjunct outright would have been the wrong fix, which is why this is a replacement rather than a removal: `all` over an empty list is vacuously true, so without a non-degeneracy guard a twin whose owned set collapsed to nothing would satisfy the disjointness claim perfectly. The literal was doing real work in a way its shape disguised.\\n\\nWhat replaces it says the same thing without reading the roster's size into the test: the production set is non-empty, and the twin mirrors it one-for-one. Both survive a member being added — the relation is between two live rosters rather than between one roster and a number a human typed — and the second is strictly stronger than the literal pair, since it would also catch a twin that gained or lost a member production did not."

data teardown_safety_witness_note: String = "THE CLAIM THAT NAMES WHAT THE COLLISION WOULD HAVE COST, rather than only that paths differ. Every owned artifact is torn down by retract, so an overlap between two specs' owned sets is not an untidy duplicate — it is one deployment's retract deleting another's live files. The first version of the twin claim above went RED on exactly one path, the serve binary, because both instances read it from the host layout; a lab retract would have removed the binary production was executing.\\n\\nThis states the property directly in retract's own terms: nothing production owns appears in what the twin's teardown would remove. It is written over the retract order specifically, not the apply order, because teardown is the destructive direction and a claim about apply would not have caught it."

test fn twin_teardown_removes_nothing_production_owns() -> Bool {
  let live_paths = spec_owned_paths(spec: deployment_spec_srv1())
  let twin_teardown = deployment_owned_steps_retract_order(spec: srv1_twin_spec())
  count(twin_teardown) > 0
    && all(twin_teardown, t => !any(live_paths, l => l == (t.path as String)))
}

data two_lanes_converged_on_one_claim_note: String = "MAIN AND THIS BRANCH INDEPENDENTLY DELETED THE SAME COUNT TRANSCRIPTION AND WROTE THE SAME REPLACEMENT, which is worth recording because the merge resolution DROPPED one of them. #7478 replaced `count(deployment_owned_steps_retract_order()) == 5` with witness_retract_order_is_apply_order_reversed, citing the 2026-07-30 live-state-count ruling; this branch replaced it with the claim below, citing the same ruling. Same defect, same diagnosis, two lanes, no coordination.\\n\\nThis one is kept because it is strictly stronger, not because it was here first. #7478's version reads the NULLARY rosters this PR removed, and it compares the fixed production roster against its own reverse. This one takes a spec and asserts the retract order is the reverse of what THAT SPEC ACTUALLY APPLIED — so it holds for the twin as well as production, and it catches the case a fixed-roster comparison cannot: a spec constructed with a non-standard order, which is exactly when a hand-mirrored list goes wrong. It is exercised on the twin spec for that reason.\\n\\nThe coverage #7478 added around AttemptStateRoot is kept in full above; only the duplicated ordering claim was dropped."

test fn retract_is_the_reverse_of_what_this_spec_applies() -> Bool {
  let twin = srv1_twin_spec()
  let applied = deployment_steps_apply_order(
    instance: srv1_lab_dashboard_instance(),
    holding: twin.role_singletons,
    target: twin.target,
    names: twin.names,
  )
  let applied_paths = applied |> flat_map(s => match s {
    ArtifactStep { step } => [step.path as String]
    Dependency { step: _ } => []
  })
  spec_owned_paths(spec: twin) == reverse(applied_paths)
}

data emitted_effect_twin_note: String = "THE PATH-LIST TWIN CLAIM WAS COVERAGE BY ILLUSION AND THIS IS ITS REPLACEMENT. The previous claim compared five declared artifact paths and pinned count == 5, so its proof was bounded by the symbolic footprint — and three destructive effects lived outside it: the systemd unit hardcoded --function roadmap_serve_handle so a twin would IDENTIFY as production, tree-sync installed and deleted one host-wide unit and env file, and teardown ran a node-global `tailscale serve reset`. Every one of those passes a declared-member comparison while the emitted script is unsafe (review, 2026-07-30).\\n\\nSo this reads the EMITTED TEXT rather than the declared member list. It asserts over what apply and retract actually emit that production's identifying strings — its handler, its unit, its tree-sync files — appear in production's emission and are ABSENT from the twin's, and that the twin's own names are absent from production's. A string a reviewer can see in the emitted output is exactly the grain the previous claim could not reach.\\n\\nTHE APPLY HALF READS THE STEP PROJECTION, NOT THE ASSEMBLED PROGRAM (2026-09-14). test.claim.live_deploy.apply_emission_projection apply_emitted_steps_text is compose_host_script_mutate_steps over apply_intent_fragments — the mutate half apply_intent_from_effects hands to compose_host_script — with ONE input mocked: the membership effects, which in production come from observing the host and here are an empty host. So the dispatch is production's compose drop, and the strings asserted below are the bytes production's own producers emit when every Decide proceeds. Decide-only frame comments are outside this text. The reason is a cost ceiling rather than a modeling one, and it is stated at that module's header: one render of the assembled apply is ~194,000 eval steps against a per-claim ceiling of 72,300. The retract half still reads the assembled script, because retract has no such projection and no claim here needed one.\\n\\nThe negative direction is the load-bearing half. Asserting the twin contains its own names would pass even if it ALSO contained production's; only absence proves it cannot touch them. The tailscale conjunct asserts the refusal marker rather than a scoped command, because the CLI offers no per-port removal and the honest emission is a refusal — a claim expecting a scoped teardown would demand a widen that cannot be written safely."

data belt_spawn_root_witness_note: String = "THE CLAIM THE BELT-TIMER MEMBER MOST NEEDED AND DID NOT HAVE (review 46541). Every other member's twin-safety follows from its PATH differing, which spec_owned_paths and the disjointness claim above already cover. The belt timer is the one member whose damage is not expressible as a path collision: both instances install their own unit at their own path, and the twin's unit can still drive PRODUCTION's tree, because what selects the tree is an argument inside the unit body rather than the unit's name. A path-level witness cannot see it, which is exactly the shape deployment_service_handler_note records for the serve handler.\\n\\nSo this reads the emitted body. The twin's belt unit must carry the twin's own spawn root, and must not carry production's — and because GUNBC_BELT_SPAWN_WORKDIR is fail-closed in belt_run_once_cli, a unit that carried neither would refuse at run time rather than silently default, which is the third state this pins shut.\\n\\nIt is discriminating in the direction that matters: deleting the Environment= line, or hardcoding either root in the emitter, reds it. The earlier conditional-membership shape would also have redded it, since the twin would have had no belt unit at all to carry a root."

test fn emitted_twin_retract_removes_nothing_of_productions() -> Bool {
  let twin = retract_plan_text(spec: srv1_twin_spec())
  !string_contains(s: twin, pattern: "/etc/systemd/system/gunbc-roadmap.service")
    && !string_contains(s: twin, pattern: "/etc/gunbc-tree-sync.env")
    && !string_contains(s: twin, pattern: "tailscale serve reset")
    && !string_contains(s: twin, pattern: retract_leg_text(leg: RetractServeOff { endpoint: deployment_spec_srv1().names.tailscale_serve_endpoint }))
    && string_contains(s: twin, pattern: retract_leg_text(leg: RetractServeOff { endpoint: srv1_twin_spec().names.tailscale_serve_endpoint }))
}


data shell_quote_authority_note: String = "The authority itself, exercised on the character that broke the call site. This is the consume-never-fork half of the fix: the call site no longer spells quotes, and the one place that does is checked here rather than trusted. A second hand-rolled quoter elsewhere in the tree would not be caught by this claim — that is a lens question — but a regression in the shared one would be."

test fn shell_quote_escapes_an_embedded_apostrophe() -> Bool {
  shell_quote(arg: "deployment's routing") == "'deployment'\\''s routing'"
    && shell_quote(arg: "plain") == "'plain'"
}


data twin_creates_its_own_bin_dir_note: String = "THE PARENT DIRECTORY WAS THE LAST srv1 LITERAL IN THE APPLY (review 45197). serve_binary became instance-derived while the step that creates its containing directory kept production's `/opt/gunbc/bin`, and `install` does not create missing parents — so a twin apply would reach the copy with nowhere to copy to and fail on what reads as a permissions problem.\\n\\nThe claim is stated in BOTH directions because only the negative half proves it. Asserting the twin creates its own bin directory passes even if the emission ALSO still creates production's; asserting production's literal is absent from the twin script is what closes it. The production conjunct pins that the derivation did not move production — /opt/gunbc/bin/gunbc has parent /opt/gunbc/bin, so its emitted command is unchanged, which the committed golden independently confirms."

data teardown_disposition_after_the_mapping_started_acting_note: String = "THIS CLAIM ASSERTED THE WRONG ANSWER CONFIDENTLY, and it is worth keeping the record of how. review 45217 correctly found that the emitter was hand-walking three coproducts to decide teardown, and the repair lifted the fact to the model and gave the refusal a CAUSE — so the claim then pinned TailscaleServeMapping to TeardownWouldExceedOwnership and treated that as the discriminating half.\\n\\nThe discrimination was real and the cause was fiction. The mapping refused because the model asserted, with no citation, that the CLI's only removal verb is node-global; the upstream documents scoped removal. So a well-formed claim, over a well-modeled fact, faithfully pinned a false premise — and every conjunct here would have stayed green for as long as the premise went unchecked. A cause is only as good as its grounding, and nothing in a claim can supply that.\\n\\nWHAT SURVIVES is the shape rather than the cause list: every OWNED artifact acts, and the one surviving refusal is about ownership rather than tooling. TeardownWouldExceedOwnership is deleted with its premise, so the cause coproduct has one variant and this claim can no longer discriminate between two — it discriminates between the two LAYERS instead, which is the distinction that was always load-bearing.\\n\\nThe acting arms are the ratchet: if a future change made refusal the default for an owned artifact — the safe-looking direction — this reds instead of silently converting the retract into a no-op that still prints its convergence receipt."

test fn teardown_disposition_separates_owned_from_ensured() -> Bool {
  let mapping = match owned_artifact_teardown_disposition(kind: UpsertOwned { kind: TailscaleServeMapping }) {
    TeardownActs => true
    TeardownRefuses { cause: _ } => false
  }
  let binary = match owned_artifact_teardown_disposition(kind: UpsertOwned { kind: ServeBinary }) {
    TeardownActs => true
    TeardownRefuses { cause: _ } => false
  }
  let package = match deployment_step_teardown_disposition(
    step: Dependency {
      step: DeploymentDependencyStep { kind: TailscalePackage, subject: EnsuredPackage { package: package_tailscale } },
    },
  ) {
    TeardownActs => false
    TeardownRefuses { cause } =>
      match cause {
        TeardownOutsideOwnership => true
      }
  }
  mapping && binary && package
}

data endpoint_identity_is_the_collision_axis_note: String = "THE CLAIM THE TWIN PROOF WAS MISSING, and its absence is why a green twin suite shipped a production-destroying apply. Every earlier twin claim in this file compares roots, ports, units, handlers and tree-sync files, and all of them passed while BOTH deployments configured the identical tailscale endpoint - because tailscale_serve_path was an invented label the emitter never read, and the emitted command derived from the port alone, which a bare `serve` ignores in favour of the default listener at the root mount.\\n\\nSo this asserts over the axis tailscale actually keys on, in BOTH directions and on BOTH scripts. The positive half - the twin carries its own --set-path - would pass against an emission that also bound production's endpoint, which is exactly the broken state. Only the negative half closes it: production's endpoint spelling must be ABSENT from the twin's apply and from the twin's retract, so the twin can neither steal the route nor remove it.\\n\\nThe retract conjuncts are not a restatement of the apply ones. The upstream requires every original flag on an off command, so apply and off can drift independently - an off missing --set-path targets the ROOT mount, which is production's, and would remove production's routing while exiting zero. Asserting the exact off spelling on each side is what ties the two directions to one endpoint value.\\n\\nONE CLAIM BECAME FOUR, ONE PER EMITTED SCRIPT, AND NOTHING WAS DROPPED (2026-08-23). The seven conjuncts below are the seven that were here; only their grouping changed. The regrouping is lossless because NO CONJUNCT EVER COMPARED TWO EMITTED SCRIPTS: disjointness is asserted by pattern negation against a command spelling derived from the OTHER spec, which is a cheap argv join, never that spec's emitted script. A reader who assumes a disjointness claim needs both scripts by construction will re-fuse these and re-cross the line - this row said exactly that in a PR body and it was wrong, caught by two independent readers of the conjuncts.\\n\\nWHY THE GROUPING MATTERED AT ALL, stated so this is not mistaken for tidiness: emitting a script costs about 6,714 interpreter node-evals per emitted shell WORD, so a claim's cost is the number of SCRIPTS it builds. Four scripts in one claim put this row at ~5009ms against the 5000ms CPU safety deadline then standing and it was INTERRUPTED BEFORE VERDICT - not passing, not failing, unknown - which is a strictly worse outcome than either verdict. One script per claim puts each row where the module's ordinary rows already sit, and a red now locates which script and which direction rather than which of seven conjuncts.\\n\\nTHIS IS A LOCAL UNBLOCK AND NOT THE REPAIR, AND CONFLATING THEM IS THE REAL RISK HERE. Sixteen rows in this module sit at 70-96% of the same limit; this regrouping moves the one row that crossed and leaves the population where it was. The cost is systemic - every emit consumer in the corpus pays the same per-word rate - and its measurement, its falsified hypotheses and its next-rung trigger are docs/probes/live_deploy_emit_witness_cost_attribution_2026-08-23.md. The next fleet runner-slot width increase lengthens the emitted script again and the next-highest row crosses.\\n\\nONE THING THIS REGROUPING MAKES HARDER, DECLARED RATHER THAN DISCOVERED LATER. The claim as written is LITERAL: it negates a spelling. The strictly stronger form is RELATIONAL - assert the two emitted endpoint values differ FROM EACH OTHER, which catches a drift that keeps both spellings absent from each other's script while still colliding. That form genuinely needs both scripts in one claim, so adopting it re-fuses two of these rows and re-crosses the line at today's per-word cost. It is therefore gated on the emit-cost lane rather than on anyone's appetite, and it is named here so the stronger claim is a known deferral and not an idea nobody had."

test fn production_retract_offs_its_own_endpoint() -> Bool {
  string_contains(s: witness_retract_script(), pattern: retract_leg_text(leg: RetractServeOff { endpoint: deployment_spec_srv1().names.tailscale_serve_endpoint }))
}

test fn twin_retract_offs_its_own_endpoint_and_not_productions() -> Bool {
  let twin_retract = retract_plan_text(spec: srv1_twin_spec())
  string_contains(s: twin_retract, pattern: retract_leg_text(leg: RetractServeOff { endpoint: srv1_twin_spec().names.tailscale_serve_endpoint }))
    && !string_contains(s: twin_retract, pattern: retract_leg_text(leg: RetractServeOff { endpoint: deployment_spec_srv1().names.tailscale_serve_endpoint }))
}

data unobserved_client_refuses_before_emission_note: String = "THE VERSION WALL, AND THE REASON IT SITS AT EMISSION RATHER THAN IN THE SCRIPT. Scoped `serve <flags> off` arrived in tailscale client 1.52, so it is a fact about the binary installed on a host, not about tailscale. srv1 is measured at 1.102.2 and its target row records the measurement; no other fleet host has been measured, and asserting the capability for them from srv1 would be the same uncited generalization this whole change is repairing.\\n\\nAn in-script guard would have been the weaker answer: it puts a stop-the-line arm back among the teardowns, which is precisely the shape that once aborted every retract before it removed anything, and it only fires after the operator has already run the script. Refusing to EMIT means the dangerous artifact does not exist.\\n\\nThe claim needs all three arms because the failure mode is a two-into-one collapse. Unobserved and unsupported are DIFFERENT states — one host was never looked at, the other was looked at and cannot do it — and the tempting simplification is to treat unobserved as either capable (fail-open, the original defect) or as unsupported (which would silently misreport a host nobody has measured). Asserting that both refuse, that their refusals differ, and that the measured host still emits a real retract is what pins all three apart."

fn unmeasured_client_target() -> DeploymentHostTarget {
  let t = deployment_srv1_target()
  DeploymentHostTarget {
    host: t.host,
    ssh_host: t.ssh_host,
    tailscale_endpoint: t.tailscale_endpoint,
    tailnet_domain: t.tailnet_domain,
    lab_plan: t.lab_plan,
    os_package_manager: t.os_package_manager,
    tailscale_client: ScopedRemovalUnobserved { reason: "host never probed for a tailscale client version" },
    host_directories: t.host_directories,
  }
}

// The fixture's client version arrives through the parser like every other SemVerVersion
// (review 77150): no hand-built record with raw fields.
fn preserve_removal_client_target() -> DeploymentHostTarget {
  let t = deployment_srv1_target()
  let client = match semver_version_parse(cps: chars(text: "1.40.0" as String)) {
    Absent => ScopedRemovalUnobserved { reason: "the fixture client version label failed to parse — a defect in the fixture, not an observation gap" }
    Present { value: observed } => tailscale_scoped_removal_capability(observed: observed)
  }
  DeploymentHostTarget {
    host: t.host,
    ssh_host: t.ssh_host,
    tailscale_endpoint: t.tailscale_endpoint,
    tailnet_domain: t.tailnet_domain,
    lab_plan: t.lab_plan,
    os_package_manager: t.os_package_manager,
    tailscale_client: client,
    host_directories: t.host_directories,
  }
}

fn sandbox_refused_ready_client_target() -> DeploymentHostTarget {
  let t = deployment_srv1_target()
  DeploymentHostTarget {
    host: t.host,
    ssh_host: t.ssh_host,
    tailscale_endpoint: t.tailscale_endpoint,
    tailnet_domain: t.tailnet_domain,
    lab_plan: LabPlanRefused {
      cause: LabSandbox {
        cause: UserManagerSandboxEnforcementUnobserved {
          obligation: "sysctl is 0" as NonEmptyStr,
        },
      },
    },
    os_package_manager: t.os_package_manager,
    tailscale_client: t.tailscale_client,
    host_directories: t.host_directories,
  }
}

fn spec_with_target(target: DeploymentHostTarget) -> DeploymentSpec {
  deployment_spec_for(
    realization: prod_role_actuated_realization(),
    instance: srv1_live_dashboard_instance(),
    target: target,
    names: srv1_live_deployment_names(instance: srv1_live_dashboard_instance()),
  )
}

// INHABITANCE ON THE REAL ROUTE: realize_live_deploy_retract_on_host over the LOCAL locus reads the
// typed plan, and a plan refusal comes back as a typed NotConverged naming its step before any leg
// runs. The refusing specs are the unobserved and the lab-plan-refused targets.
fn retract_route_refusal(spec: DeploymentSpec) -> String {
  match realize_live_deploy_retract_on_host(
    spec: spec,
    transport: LocalShell,
    intent: HostEffectIntent {
      target: HostOs { node: srv1_host },
      effect: LiveDeployRetract { spec: spec },
      evidence: host_effect_identity_evidence,
      transport: LocalShell,
      privilege_denial: none,
    },
    access: ci_deploy_srv1_access,
  ) {
    NotConverged { reason: r, applied: _ } => r
    Converged { evidence: _, applied: _ } => "CONVERGED"
  }
}

test fn the_real_retract_route_refuses_typed_on_a_plan_refusal_before_any_leg() -> Bool {
  let unobserved = retract_route_refusal(spec: spec_with_target(target: unmeasured_client_target()))
  let lab = retract_route_refusal(spec: spec_with_target(target: sandbox_refused_ready_client_target()))
  string_contains(s: unobserved, pattern: "live_deploy retract refused at step tailscale-client")
    && string_contains(s: lab, pattern: "live_deploy retract refused at step lab-plan")
}

test fn retract_is_not_emitted_without_an_observed_scoped_removal() -> Bool {
  let unobserved = retract_plan_text(spec: spec_with_target(target: unmeasured_client_target()))
  let too_old = retract_plan_text(spec: spec_with_target(target: preserve_removal_client_target()))
  let measured = witness_retract_script()
  string_contains(s: unobserved, pattern: "REFUSED tailscale-client:")
    && string_contains(s: unobserved, pattern: "UNOBSERVED")
    && !string_contains(s: unobserved, pattern: "serve-off")
    && string_contains(s: too_old, pattern: "REFUSED tailscale-client:")
    && string_contains(s: too_old, pattern: "1.40.0")
    && !string_contains(s: too_old, pattern: "UNOBSERVED")
    && !string_contains(s: too_old, pattern: "serve-off")
    && !string_contains(s: measured, pattern: "REFUSED")
    && string_contains(s: measured, pattern: retract_leg_text(leg: RetractServeOff { endpoint: deployment_spec_srv1().names.tailscale_serve_endpoint }))
}

test fn a_lab_plan_refusal_is_not_an_unobserved_tailscale_client() -> Bool {
  let sandbox = retract_plan_text(spec: spec_with_target(target: sandbox_refused_ready_client_target()))
  let srv2 = retract_plan_text(spec: selected_deployment_spec(row: srv2_deploy_desired_deployment()))
  match sandbox_refused_ready_client_target().os_package_manager {
    Absent => false
    Present { value: pm } =>
      match pm {
        Apt =>
          string_contains(s: sandbox, pattern: "lab plan refused")
            && string_contains(s: sandbox, pattern: "sysctl is 0")
            && !string_contains(s: sandbox, pattern: "tailscale client version is UNOBSERVED")
            && string_contains(s: srv2, pattern: "lab plan refused")
            && !string_contains(s: srv2, pattern: "tailscale client version is UNOBSERVED")
        Winget => false
        HomebrewDeFacto => false
      }
  }
}

// The tailscale endpoint spellings are DERIVED from extdeps.tailscale.serve's argv rows, the
// same rows the emitter consumes, rather than transcribed. Transcribing them is what let an
// invented `tailscale_serve_path` label sit in the model while the emitted command derived from
// the port alone — endpoint_identity_is_the_collision_axis_note is the receipt.
// The absence conjuncts below cannot be spelled as a derived COMMAND, because what they assert is
// that no tailscale invocation was emitted at all — there is no particular command whose absence
// says that. They assert the binary WORD as the grammar spells it instead, which every invocation
// through the single authority must contain. Spelled `"sudo -n tailscale"` (as they were until the
// emitter's quoting moved into the bash grammar) the conjunct became VACUOUS rather than red: the
// unquoted prefix can no longer appear in any emitted script, so the absence held for a reason that
// has nothing to do with the refusal these claims exist to pin.
fn emitted_tailscale_binary_word() -> String {
  posix_single_quote(spelling: "tailscale")
}

fn tailscale_enable_command(endpoint: TailscaleServeEndpoint) -> String {
  shell_privileged_command_text_of_argv(
    argv: concat(["tailscale"], tailscale_serve_enable_argv(endpoint: endpoint)),
  )
}

fn tailscale_off_command(endpoint: TailscaleServeEndpoint) -> String {
  shell_privileged_command_text_of_argv(
    argv: concat(["tailscale"], tailscale_serve_off_argv(endpoint: endpoint)),
  )
}


// THE PUBLICATION PRINCIPAL IS ENSURED IN THE PREAMBLE, IDEMPOTENTLY, AS A SYSTEM ACCOUNT. The first
// deploy through `gunbc converge --mode deploy` on srv1 refused `install: invalid user
// 'gunbc-publication'` because the member installed spool directories for a principal nobody had
// created. The id-guard is what makes the second deploy a no-op; --system and nologin are what keep
// it a service identity rather than a login. The claim reads the preamble PRODUCER and the preamble
// step list, not a full apply render: the full render costs more than the floor's per-claim line and
// this claim's subject is two commands, so rendering the whole deployment to find them was a second
// full render whose cost belonged to the sibling claims that need it (required floor on PR #10696).
fn preamble_step_command(step: PipelineStep) -> String {
  match step {
    Do { run } => run.command
    _ => ""
  }
}


// THE STEP LIST IS TAKEN ONCE AND PASSED, not rebuilt per lookup: reading it from
// deployment_spec_srv1() inside the fold made four ordering comparisons construct the whole
// deployment spec four times. That is the copied-accumulator shape and the standing rule fixes it
// regardless of the realized n -- but THE MEASUREMENT DOES NOT CREDIT IT, and saying so is the
// point of this note. The claim read 469ms before the change and 496ms after, which is noise: the
// spec rebuild was not where its cost was, and the cost that remains is unattributed. What actually
// moved this claim was giving up the full apply render (4830ms -> ~480ms). A reader who takes this
// parameterization as the cost repair will look for the next one in the wrong place.
fn owned_step_index(steps: List<DeploymentStep>, kind: OwnedArtifactKind) -> Int {
  fold(
    steps,
    init: StepScan { at: 0, found: 0 - 1 },
    f: (acc, st) => StepScan {
      at: acc.at + 1,
      found: match st {
        ArtifactStep { step: art } => if art.kind == kind && acc.found < 0 { acc.at } else { acc.found }
        Dependency { step: _ } => acc.found
      },
    },
  ).found
}

type StepScan {
  at: Int
  found: Int
}

fn srv1_demands_directory(path: String) -> Bool {
  any(deployment_directory_demands(spec: deployment_spec_srv1()), t => (owned_directory_path(t: t) as String) == path)
}

// The fabric DB's store is created on the placement host's apply path, as an owned-directory demand.
test fn the_fabric_storage_store_root_reaches_the_srv1_apply_path() -> Bool {
  srv1_demands_directory(path: fabric_storage_store_root(instance: srv1_live_dashboard_instance()) as String)
}

// THE AREAS THE STORE WRITES INTO ARE DEMANDED, NOT ONLY THE ROOT. The paths are read from the file
// store's own root function -- the one the put and the head CAS write under -- so this goes red when
// the deployment ensures the root alone, which is the state that refused fleet-converge run
// 35818578751's host-effect claim with `object publication refused: not_found`.
test fn the_fabric_storage_store_areas_reach_the_srv1_apply_path() -> Bool {
  // THE AREAS THE DECLARATION IMPLIES, from the same rows the mint reads: this claim asserts the substrate
  // demands THOSE paths, and it spells them through fabric_store_area_paths so a change to the declaration
  // moves the demand and the assertion together.
  let files = fabric_store_area_paths(members: fabric_storage_slots, instance: srv1_live_dashboard_instance())
  srv1_demands_directory(path: files.objects as String) && srv1_demands_directory(path: files.heads as String)
}

// THE PLACEMENT'S DERIVED ENTRY MODE, from the real store directories: 0400, since the service
// principal is the store's only writer and reader once every writer goes through the door. The per-rule cases, and
// the refusal when a directory grants o+x, are witnessed on synthetic principals in
// test.claim.managed_directory_witness.
test fn the_placed_fabric_store_derives_entry_mode_0400() -> Bool {
  match fabric_storage_entry_mode(instance: srv1_live_dashboard_instance()) {
    FabricStorageEntryModeDerived { mode } => file_mode_octal(mode: mode) == "0400"
    FabricStorageEntryModeRefused { detail: _ } => false
  }
}

// THE LOG IS NOT DEPLOYMENT STATE: no retract may remove the store. Moving this root back into the
// owned roster (where the event-log mirror root sat, torn down with rm -rf) turns this red.
// A retract tears down owned steps only, so the store is safe exactly when it is demanded and no owned
// step names it.
test fn no_retract_can_remove_the_fabric_storage_store() -> Bool {
  srv1_demands_directory(path: fabric_storage_store_root(instance: srv1_live_dashboard_instance()) as String)
    && !any(deployment_spec_srv1().steps, st => match st {
      ArtifactStep { step: art } => (art.path as String) == (fabric_storage_store_root(instance: srv1_live_dashboard_instance()) as String)
      Dependency { step: _ } => false
    })
}


// MEASURED HOLE (bright-moth-475 srv1:~/bm475-prod-apply-c22acb7-2026-10-12.log): no
// __GUNBC_DEPLOY_REFUSED__; visudo of gunbc-approval-broker-helpers succeeded; last on-disk
// mutation that file at 04:12:13; roadmap unit already at 04:09:19; NeedDaemonReload=yes;
// outer shell exit=2. RED if UnitFile still writes the roadmap unit before the helper grant.
type UnitFileOrderScan
  = LookingForHelperGrant
  | LookingForRoadmapUnit
  | HelperGrantBeforeRoadmapUnit
  | RoadmapUnitBeforeHelperGrant

// ══════════════════════════════════════════════════════════════════════════════════════════════
// THE TWIN'S APPLY MUST NOT RE-OWN THE HOST'S BROKER — review 68094
// ══════════════════════════════════════════════════════════════════════════════════════════════
// teardown_safety_witness_note above says the twin claims were written over the RETRACT order
// "because teardown is the destructive direction and a claim about apply would not have caught it".
// The approval broker is the case where that stopped being true: it is a HOST singleton whose unit
// content is instance-derived, so the destructive direction for it is APPLY -- srv1-lab writing
// /etc/systemd/system/gunbc-approval-broker.service with the lab tree's WorkingDirectory and
// restarting it, killing production's broker on the same port.
//
// THE SUBJECT IS THE STEP LIST, NOT THE RENDERED SCRIPT, and that is a correction the floor forced:
// the first cut rendered a whole second apply script per claim to grep it for a unit name, which
// cost about 200k eval steps each against a 72300 budget. Rendering an entire deploy program to ask
// whether four steps were produced is DESIGN section 3's claim-reaches-too-far in its plainest
// form -- the claim's subject was one interface and its cost was the whole emitter's. Asking the
// producers directly is cheaper AND stronger: an empty list cannot be serialized into a script that
// happens not to mention the unit.
//
// THE RED IS THE SAME EDIT AS BEFORE: drop the ownership predicate from
// apply_approval_broker_unit_write_steps or approval_broker_lifecycle_steps and the twin's lists
// stop being empty.

// BOTH INSTALL PATHS BIND THE BROKER'S ONE PORT. The staged install and the release apply must
// describe the SAME process, so a reading taken at one is about the other. This reads the unit
// VALUE rather than either rendered script, for the same cost reason as above -- the port is a
// directive on a unit, and rendering two deploy programs to find it was paying for the emitter.
test fn both_install_paths_bind_the_brokers_one_port() -> Bool {
  let unit = live_deploy_approval_broker_unit_file(
    spec: deployment_spec_srv1(),
    revision: RevisionBoundAtEmission { revision: deploy_witness_release_revision },
  )
  service_has_execstart_containing(
    file: unit,
    fragment: join([" --port ", to_string(approval_broker_listen_port)], ""),
  )
}

fn service_has_execstart_containing(file: SystemdUnitFile, fragment: String) -> Bool {
  match file {
    ServiceUnitFile { unit: _, service: directives, install: _ } =>
      any(directives, d => match d {
        ExecStart { command: c } => string_contains(s: c as String, pattern: fragment)
        _ => false
      })
    _ => false
  }
}

// ── THE BROKER UNIT'S BYTE ORACLE: LOOPBACK, AND ITS OWN TREE ───────────────────────────────
// BOTH HALVES ARE STAGE-A REGRESSIONS, so this is two receipts rather than one assertion.
//
// --host 127.0.0.1: the unit inherited the ROADMAP instance's listen_host and bound 0.0.0.0. That
// state PASSED its own readiness probe, because the probe dials 127.0.0.1 and 0.0.0.0 includes
// loopback -- so nothing downstream could notice the broker was reachable from anything able to
// route to srv1, past the tailnet front door and therefore past the identity header the decide
// route requires. THE NEGATIVE CONJUNCT IS THE DISCRIMINATING ONE: asserting 127.0.0.1 is present
// stays green on a unit that binds both.
//
// WorkingDirectory: it pointed at the roadmap's deployed tree, frozen at a release predating this
// module, so the entry could not resolve and systemd restart-looped the unit. The second negative
// conjunct pins the roadmap root specifically, because the failure mode is not an ABSENT working
// directory but a plausible WRONG one.
test fn the_broker_unit_binds_loopback_and_runs_from_its_own_tree() -> Bool {
  let unit = serialize_systemd_unit_file(file: live_deploy_approval_broker_unit_file(
    spec: deployment_spec_srv1(),
    revision: RevisionBoundAtEmission { revision: deploy_witness_release_revision },
  ))
  let release_dir = release_locus_dir(
    root: srv1_gunbc_approval_broker_root as String,
    revision: RevisionBoundAtEmission { revision: deploy_witness_release_revision },
  )
  string_contains(s: unit, pattern: join(["--host ", approval_broker_listen_host as String, " --port "], ""))
    && !string_contains(s: unit, pattern: "0.0.0.0")
    && string_contains(s: unit, pattern: join(["WorkingDirectory=", release_dir], ""))
    && !string_contains(s: unit, pattern: join(["WorkingDirectory=", srv1_gunbc_repo_root as String, "\n"], ""))
    && string_contains(s: unit, pattern: join(["ExecStart=", release_dir, "/gunbc serve"], ""))
    && !string_contains(s: unit, pattern: "ExecStart=/opt/gunbc/bin/gunbc")
}


// ONE CONTROL PER ARM. The broker's config holds PerReleaseBinary and resolves to its release locus's binary under a
// bound revision; a fixed arm resolves to its own path.
test fn the_broker_serve_binary_is_the_per_release_arm_over_the_bound_revision() -> Bool {
  let spec = deployment_spec_srv1()
  let rev = RevisionBoundAtEmission { revision: deploy_witness_release_revision }
  serve_binary_path(binary: spec.approval_broker.serve_binary, release_root: spec.approval_broker.repo_root as String, revision: rev)
    == release_locus_binary_path(root: srv1_gunbc_approval_broker_root as String, revision: rev)
    && spec.approval_broker.serve_binary == PerReleaseBinary
}

test fn a_fixed_serve_binary_resolves_to_its_own_path_whatever_the_revision() -> Bool {
  let admitted = admit_fixed_serve_path(path: "/opt/gunbc/bin/gunbc" as NonEmptyStr)
  let fixed = FixedServeBinary { binary: admitted }
  fixed_serve_binary_path(binary: admitted) == "/opt/gunbc/bin/gunbc"
    && serve_binary_path(binary: fixed, release_root: "/x", revision: RevisionBoundAtEmission { revision: deploy_witness_release_revision }) == "/opt/gunbc/bin/gunbc"
}

// A per-release serve binary cannot be handed to a fixed-only renderer: DeploymentSpec.service is typed over
// AdmittedFixedServeBinary, which only admit_fixed_serve_path mints. No fixture here executes that refusal for this type (the generic
// sole_constructor probes execute the wall; a type-specific RED is a declared frontier). What executes here is the other half: every fixed-only renderer, reached by a non-apply route
// (the belt, publication and fabric-storage unit files, not desired_apply_host_checked), emits a production spec with no marker, while the
// broker's per-release unit resolves its own locus path.
test fn the_fixed_only_renderers_emit_no_unbound_marker_off_the_apply_route() -> Bool {
  let marker = "__GUNBC_DEPLOY_UNREACHABLE__"
  let spec = deployment_spec_srv1()
  let rev = RevisionBoundAtEmission { revision: deploy_witness_release_revision }
  let fabric = serialize_systemd_unit_file(file: live_deploy_fabric_storage_unit_file(spec: spec, revision: rev, door_socket: fabric_storage_door_socket(instance: srv1_live_dashboard_instance())))
  let belt = serialize_systemd_unit_file(file: live_deploy_belt_service_unit_file(spec: spec))
  let publication = serialize_systemd_unit_file(file: live_deploy_publication_service_unit_file(spec: spec))
  !string_contains(s: fabric, pattern: marker)
    && !string_contains(s: belt, pattern: marker)
    && !string_contains(s: publication, pattern: marker)
    && string_contains(s: belt, pattern: fixed_serve_binary_path(binary: spec.service.serve_binary))
}

// THE FABRIC DB ENDPOINT IS ITS DOOR SOCKET AND IS ROUTED BY TAILSCALE: its unit runs the fabric DB
// handler on the placement's unix socket and binds no TCP listener (never 0.0.0.0, and no loopback
// port any local account could reach with a forged identity header), and its route is tailscale
// serve's 10000 listener at the root mount, proxying to exactly that socket.
test fn the_fabric_storage_unit_binds_its_door_socket_and_its_route_proxies_to_it() -> Bool {
  let unit = serialize_systemd_unit_file(file: live_deploy_fabric_storage_unit_file(spec: deployment_spec_srv1(), revision: RevisionBoundAtEmission { revision: deploy_witness_release_revision }, door_socket: fabric_storage_door_socket(instance: srv1_live_dashboard_instance())))
  let route = deployment_fabric_storage_serve_endpoint(door_socket: fabric_storage_door_socket(instance: srv1_live_dashboard_instance()))
  unit.contains("--function fabric_storage_serve_handle")
    && unit.contains(join(["--unix-socket ", fabric_storage_door_socket(instance: srv1_live_dashboard_instance()) as String], ""))
    && !unit.contains("--host")
    && !unit.contains("--port")
    && route.https_port == fabric_storage_https_port
    && (route.backend as String) == join(["unix:", fabric_storage_door_socket(instance: srv1_live_dashboard_instance()) as String], "")
    && (match route.mount { ServeRootMount => true  ServeSetPath { path: _ } => false })
}

// Leftover timer retirement: present is disable+rm+reload+not-found readback; absent is the same
// script skipping disable because LoadState is already not-found (rm -f is a no-op).
test fn retract_leftover_timer_legs_retire_a_present_unit() -> Bool {
  let spec = deployment_spec_srv1()
  let unit = deployment_retired_belt_timer_unit_name(names: spec.names)
  let path = deployment_retired_belt_timer_unit_path(names: spec.names)
  let text = join(retract_leftover_timer_legs(unit: unit, path: path) |> map(l => retract_leg_text(leg: l)), "\n")
  string_contains(s: text, pattern: join(["disable-if-loaded ", unit as String], ""))
    && string_contains(s: text, pattern: join(["remove-files ", path as String], ""))
    && string_contains(s: text, pattern: "daemon-reload")
    && string_contains(s: text, pattern: join(["unit-gone-readback ", unit as String], ""))
}

fn occurrence_count(s: String, pattern: String) -> Int {
  count(split(s: s, sep: pattern)) - 1
}

// The retract half of #14332's a_refused_serve_unit_is_not_reloaded_enabled_or_restarted. Its apply
// half read the deleted bash fragments. Typed, an unreadable OIDC clock refuses the plan
// (live_deploy_apply_plan_witness lab_apply_oidc_refuses_without_an_observer_clock) and a refused plan
// dispatches no leg (the orchestrate controls in live_deploy_apply_run_witness). A ready plan is
// required here so that a plan refusal cannot satisfy the absence.
test fn the_retract_plan_never_restarts_the_serve_unit() -> Bool {
  let spec = srv1_twin_spec()
  let unit = spec.service.unit_name as String
  let retract_text = retract_plan_text(spec: spec)
  !string_contains(s: retract_text, pattern: "REFUSED ")
    && !string_contains(s: retract_text, pattern: join(["restart ", unit], ""))
}
