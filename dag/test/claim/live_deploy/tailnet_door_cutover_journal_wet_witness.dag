module test.claim.live_deploy.tailnet_door_cutover_journal_wet_witness

import std.types { Bool, String, NonEmptyStr, FilePath }
import extdeps.shell
import gunbc.fabric.fabric_storage_client { FabricStorageLocalFiles }
import gunbc.fabric.fabric_storage_file_store { fabric_storage_slots }
import test.claim.fabric.fabric_storage_fixture {
  fabric_wet_scenario, FabricWetScenarioReady, FabricWetScenarioUnready, fabric_wet_store,
  FabricWetStoreReady, FabricWetStoreUnready,
}
import gunbc.live_deploy.tailnet_door_cutover {
  CutoverBinding, CutoverJournalRecord, CapturedRestorableBackend,
  CutoverPrepared, CutoverRepointed, CutoverSettledCommitted,
  CutoverJournalAbsent, CutoverJournalPresent, CutoverJournalUnreadable,
  CutoverJournalWritten, CutoverJournalFenced, CutoverJournalWriteRefused,
}
import gunbc.live_deploy.tailnet_door_cutover_host { tailnet_door_cutover_journal_read, tailnet_door_cutover_journal_write, tailnet_door_cutover_store }

// THE JOURNAL IS DURABLE AND FENCED, on a real store. A record written by one handle on the store
// is read back, capture and phase, by a fresh handle on the same files -- what a run that replaces
// an interrupted one does. A write naming the generation it read lands; a second write naming that
// same, now stale, generation is fenced by the store and changes nothing; and another route's
// journal is another slot, absent until written.
test fn the_cutover_journal_survives_its_writer_and_fences_a_stale_write() -> Bool {
  // THE JOURNAL'S STORE IS OPENED THROUGH THE ONE MINT (the declared chain over an isolated instance of a
  // temporary directory): the claim writes the journal, REOPENS the store from the same declaration, and reads
  // the record back -- the seal does not change what a reopened store sees.
  let scenario = fabric_wet_scenario(template: "/tmp/gunbc_cutover_journal.XXXXXX" as NonEmptyStr)
  let passed = match scenario {
    FabricWetScenarioUnready { detail: _ } => false
    FabricWetScenarioReady { instance: scenario_instance, root: _ } => match fabric_wet_store(members: fabric_storage_slots, instance: scenario_instance) {
      FabricWetStoreUnready { area: _, detail: _ } => false
      FabricWetStoreReady { store: ops } => {
        let store = FabricStorageLocalFiles { operations: ops }
      let binding = CutoverBinding { route: "fixture 443:/", door_target: "unix:/srv/fixture/tailnet-door.sock", release_revision: "release-a" }
      let other = CutoverBinding { route: "elsewhere 443:/", door_target: "unix:/srv/fixture/tailnet-door.sock", release_revision: "release-a" }
      let capture = CapturedRestorableBackend { target: "http://127.0.0.1:9191", backend: "9191" as NonEmptyStr }
      let prepared = CutoverJournalRecord { route: binding.route, door_target: binding.door_target, release_revision: binding.release_revision, prior: capture, phase: CutoverPrepared }
      let repointed = CutoverJournalRecord { route: binding.route, door_target: binding.door_target, release_revision: binding.release_revision, prior: capture, phase: CutoverRepointed }
      let committed = CutoverJournalRecord { route: binding.route, door_target: binding.door_target, release_revision: binding.release_revision, prior: capture, phase: CutoverSettledCommitted }
      let empty_first = tailnet_door_cutover_journal_read(store: tailnet_door_cutover_store(binding: store), binding: binding) == CutoverJournalAbsent
      match tailnet_door_cutover_journal_write(store: tailnet_door_cutover_store(binding: store), binding: binding, expected_generation: 0, record: prepared) {
        CutoverJournalFenced => false
        CutoverJournalWriteRefused { detail: _ } => false
        CutoverJournalWritten { generation: first_generation } => {
          let reopened = FabricStorageLocalFiles { operations: ops }
          let survived = tailnet_door_cutover_journal_read(store: tailnet_door_cutover_store(binding: reopened), binding: binding) == CutoverJournalPresent { record: prepared, generation: first_generation }
          let advanced = tailnet_door_cutover_journal_write(store: tailnet_door_cutover_store(binding: reopened), binding: binding, expected_generation: first_generation, record: repointed)
          let stale = tailnet_door_cutover_journal_write(store: tailnet_door_cutover_store(binding: store), binding: binding, expected_generation: first_generation, record: committed)
          let from_absent = tailnet_door_cutover_journal_write(store: tailnet_door_cutover_store(binding: store), binding: binding, expected_generation: 0, record: committed)
          empty_first && survived
            && (match advanced {
              CutoverJournalWritten { generation: second_generation } =>
                second_generation > first_generation
                  && tailnet_door_cutover_journal_read(store: tailnet_door_cutover_store(binding: store), binding: binding) == CutoverJournalPresent { record: repointed, generation: second_generation }
              CutoverJournalFenced => false
              CutoverJournalWriteRefused { detail: _ } => false
            })
            && stale == CutoverJournalFenced
            && from_absent == CutoverJournalFenced
            && tailnet_door_cutover_journal_read(store: tailnet_door_cutover_store(binding: store), binding: other) == CutoverJournalAbsent
        }
      }
    }
      }
    }
  let cleaned = match scenario {
    FabricWetScenarioUnready { detail: _ } => true
    FabricWetScenarioReady { instance: _, root: r } => shell.Remove.RecursiveForce(path: r as FilePath).success
  }
  passed && cleaned.success
}
