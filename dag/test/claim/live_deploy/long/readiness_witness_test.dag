import gunbc.live_deploy.candidate { CandidateRelease }
import gunbc.roadmap_site_surface_observe { materialize_live_roadmap_site_surface_bundle }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data witness_ssh_mock_stdout: String = "mock ssh stdin script executed"

// The revision half comes from the shared fixture; the candidate wrapper does not.
// deploy_witness_release_revision stays the one declared revision every deploy witness compares against,
// so this file spells no sha of its own. The surface half has no shared fixture because the two witnesses
// that need a whole candidate — the one-iteration probe and the poll-bound RED — both assert
// NON-convergence against a host that is not answering, so the identity they carry is never the reason
// they refuse. Declaring it here rather than in deploy_release_fixture keeps gunbc.live_deploy.candidate's
// import closure off every other deploy witness that only needs a sha.
fn witness_expected_surface_identity() -> Fnv1a64Structural {
  Fnv1a64Structural { digest: "0123456789abcdef" as NonEmptyStr }
}

fn witness_candidate_release() -> CandidateRelease {
  CandidateRelease {
    revision: deploy_witness_release_revision,
    expected_surface_identity: witness_expected_surface_identity(),
  }
}

test fn witness_green_readiness_names_the_green_unit() -> Bool {
  let spec = deployment_spec_srv1_green()
  let effect = service_ready_apply_effect_for_deploy(spec: spec)
  effect.unit == spec.service.unit_name
    && effect.unit != gunbc_roadmap_unit_name
}

test fn witness_healthz_mock_body_groundable() -> Bool {
  healthz_body_groundable(body: "{\"status\":\"ok\"}")
}

test fn witness_healthz_trailing_lf_body_groundable() -> Bool {
  healthz_body_groundable(body: concat("{\"status\":\"ok\"}", "\n"))
}

test fn witness_healthz_malformed_extension_not_groundable() -> Bool {
  !healthz_body_groundable(body: concat("{\"status\":\"ok\"}", "}"))
}

test fn witness_healthz_bad_body_not_groundable() -> Bool {
  !healthz_body_groundable(body: "")
}

test fn witness_ssh_mock_stdout_is_discriminating_red() -> Bool {
  !healthz_body_groundable(body: witness_ssh_mock_stdout)
    && match ground_service_ready_from_healthz(
      read: HealthzEffectiveRead {
        body: witness_ssh_mock_stdout,
        probe_error: "",
      },
      expected_revision: deploy_witness_release_revision,
      expected_surface_identity: witness_expected_surface_identity(),
    ) {
      DoesNotGround { reason: _ } => true
      Grounds { evidence: _ } => false
    }
}

fn witness_argv_join(argv: List<String>) -> String {
  fold_list(
    xs: argv,
    empty: "",
    cons: (acc, word) => if acc == "" { word } else { concat(acc, concat(" ", word)) },
  )
}

test fn witness_transport_probe_targets_localhost_healthz() -> Bool {
  let port = deployment_plan_listen_port(spec: deployment_spec_srv1())
  let url = live_deploy_health_url_for_port(port: port)
  let argv = http_client_get_argv(url: url)
  let surface = witness_argv_join(argv: argv)
  string_contains(s: surface, pattern: "curl")
    && string_contains(s: surface, pattern: "--connect-timeout")
    && string_contains(s: surface, pattern: to_string(second_count(s: curl_localhost_connect_timeout)))
    && string_contains(s: surface, pattern: "--max-time")
    && string_contains(s: surface, pattern: to_string(second_count(s: curl_localhost_max_time)))
    && string_contains(s: url as String, pattern: "127.0.0.1:")
    && string_contains(s: url as String, pattern: "/healthz")
}

test fn witness_accept_no_response_probe_fails_fast_not_hangs() -> Bool {
  match ground_service_ready_from_healthz(
    read: HealthzEffectiveRead {
      body: "",
      probe_error: "curl: (28) Operation timed out after 5000 milliseconds with 0 bytes received",
    },
    expected_revision: deploy_witness_release_revision,
    expected_surface_identity: witness_expected_surface_identity(),
  ) {
    DoesNotGround { reason: _ } => true
    Grounds { evidence: _ } => false
  }
}

test fn witness_transport_status_probe_uses_typed_systemctl_argv() -> Bool {
  systemctl_status_operation_argv_matches_authority(
    unit: live_deploy_service_ready_unit_authority
  )
}

test fn witness_transport_status_probe_realizes_hermetically() -> Bool {
  let r = systemd.Systemctl.Status(unit: live_deploy_service_ready_unit_authority)
  r.stdout != ""
}

test fn witness_transport_get_probe_over_ssh_does_not_ground_mock_stdout() -> Bool {
  let port = deployment_plan_listen_port(spec: deployment_spec_srv1())
  let read = live_deploy_healthz_get_for_port(
    port: port,
    transport: SshShell { ssh_host: "srv1" as NonEmptyStr },
  )
  !reconciliation_converged(
    r: reconcile_service_ready_read(
      read: ReadObserved { value: read },
      expected_revision: deploy_witness_release_revision,
      expected_surface_identity: witness_expected_surface_identity(),
    )
  )
}

test fn witness_sleep_second_carrier_projection_paces_poll() -> Bool {
  sleep_delay_seconds_second_carrier_projection(duration: live_deploy_service_ready_poll_cadence_seconds())
}

test fn witness_sleep_flat_scalar_dissolution_trigger_tracked() -> Bool {
  match sleep_delay_seconds_flat_scalar_dissolution_trigger {
    Scaffold {
      dissolves_to: RealizationDispatch,
      bind: DeclarationRef { module_path: m, decl_name: n, field: WholeDeclaration },
    } =>
      m == "extdeps.tools.sleep" && n == "sleep_delay_seconds_second_carrier_projection"
    Terminal { reason: _ } => false
  }
}

test fn witness_bounded_poll_one_iteration_composes_probe_and_modeled_sleep() -> Bool {
  let spec = deployment_spec_srv1()
  let probe = live_deploy_service_ready_once_for_deploy(
    spec: spec,
    candidate: witness_candidate_release(),
    transport: ci_deploy_srv1_access.transport,
    access: ci_deploy_srv1_access,
  )
  let delay = sleep_delay_seconds_second_carrier_projection(duration: live_deploy_service_ready_poll_cadence_seconds())
  !reconciliation_converged(r: probe) && delay
}

test fn witness_bounded_poll_early_exit_on_grounded_read() -> Bool {
  reconciliation_converged(
    r: reconcile_service_ready_read(
      read: show_healthz_read_fixture_healthy_live(release_revision: deploy_witness_release_revision),
      expected_revision: deploy_witness_release_revision,
      expected_surface_identity: materialize_live_roadmap_site_surface_bundle().bundle_identity,
    )
  )
}

test fn witness_red_control_never_ready_refuses_at_poll_bound() -> Bool {
  let max_attempts = live_deploy_service_ready_poll_max_attempts()
  let r = live_deploy_poll_service_ready_after_attempts(
    spec: deployment_spec_srv1(),
    candidate: witness_candidate_release(),
    transport: ci_deploy_srv1_access.transport,
    access: ci_deploy_srv1_access,
    attempt: max_attempts,
    last_probe: "health probe never succeeded"
  )
  match r {
    NotConverged { reason: why, applied: _ } =>
      string_contains(s: why, pattern: "ServiceNotReady")
        && string_contains(s: why, pattern: "waited_s=120")
        && string_contains(s: why, pattern: "health probe never succeeded")
        && !string_contains(s: why, pattern: "converged")
    Converged { evidence: _, applied: _ } => false
  }
}

test fn witness_bounded_poll_max_attempts_derived_from_bound_over_cadence() -> Bool {
  live_deploy_service_ready_poll_max_attempts() == measure_fit_count_floor(capacity: live_deploy_service_ready_poll_bound, each: live_deploy_service_ready_poll_cadence_seconds())
}

test fn witness_service_not_ready_refusal_shape_matches_contract() -> Bool {
  let reason = service_not_ready_reason(refusal: ServiceNotReady {
    unit: live_deploy_service_ready_unit_authority,
    endpoint: live_deploy_service_ready_endpoint_authority,
    waited: live_deploy_service_ready_poll_bound,
    last_probe: "connection refused",
    unit_diagnosis: UnitDiagnosisCaptured { text: "Active: failed (Result: exit-code)" },
  })
  string_contains(s: reason, pattern: "ServiceNotReady")
    && string_contains(s: reason, pattern: "gunbc-roadmap.service")
    && string_contains(s: reason, pattern: "Active: failed (Result: exit-code)")
}
