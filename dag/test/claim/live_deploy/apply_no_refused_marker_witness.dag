module test.claim.live_deploy.apply_no_refused_marker_witness

import std.types { Bool, String, List }
import std.algebra { string_contains }
import gunbc.shell_command_text { shell_command_text_of_node, shell_command_text_refusal_marker }
import std.optional { Present, Absent }
import v2.workflow.bash_command_fold_serialize { bash_fold_serialize_node }
import v2.std.diagnostic { Accepted, Rejected, diagnostics_reason_lexemes }
import v2.extdeps.languages.bash_build {
  bash_build_if_else, bash_build_if_else_from_stmts, bash_build_stmt_list_from_nodes, bash_build_command_from_lits,
  bash_build_assign, bash_build_word_lit,
}

// The needle is DERIVED, in gunbc.shell_command_text ::shell_command_text_refusal_marker, from the
// authority constant that mints the marker -- this module used to re-type the token here, a second
// copy of one fact that could drift from the thing it copies. Absent means the needle could not be
// derived, which fails the claim rather than letting it pass on a weaker needle.

// The three apply-emission claims that stood here (the live srv1 apply script, and the object-source
// Decide step alone) were deleted with the bash apply emitter they read (gunbc#14660): the typed apply
// builds no bash for that step. The serializer claims below are #14586's repair and stay enrolled.

// THE REFUSAL NAMES ITS CAUSE: the old shape (an `if` node standing as else body, not wrapped in a
// statement list) is refused by the serializer, and the text the caller embeds carries the located
// reason rather than a constant. Controls the diagnosis above: this is the construct #14134 built.
test fn a_refused_intent_marker_carries_the_serializers_reason() -> Bool {
  let colon = bash_build_stmt_list_from_nodes(stmts: [bash_build_command_from_lits(lits: [":"])])
  let bare_nested = bash_build_if_else(
    cond: bash_build_command_from_lits(lits: ["true"]),
    then_body: colon,
    else_body: bash_build_if_else(cond: bash_build_command_from_lits(lits: ["true"]), then_body: colon, else_body: colon),
  )
  let text = shell_command_text_of_node(stmt: bare_nested)
  match shell_command_text_refusal_marker() {
    Absent => false
    Present { value: refused_marker } =>
      string_contains(s: text, pattern: refused_marker)
        && string_contains(s: text, pattern: "bash_fold_serialize_stmt_list_shape_refused")
  }
}

// THE SERIALIZER REFUSES AN OVER-ARITY LIST: a bare `if` node standing where a statement list is
// expected has more than the (prefix, statement) children; the fold must refuse with the shape
// reason rather than keep children 0/1 and drop the rest (DESIGN section 5).
test fn the_serializer_refuses_an_over_arity_statement_list_with_its_reason() -> Bool {
  let colon = bash_build_stmt_list_from_nodes(stmts: [bash_build_command_from_lits(lits: [":"])])
  let inner = bash_build_if_else(cond: bash_build_command_from_lits(lits: ["true"]), then_body: colon, else_body: colon)
  let bare_nested = bash_build_if_else(cond: bash_build_command_from_lits(lits: ["true"]), then_body: colon, else_body: inner)
  match bash_fold_serialize_node(stmt: bare_nested) {
    Rejected { diagnostics: ds } =>
      string_contains(s: diagnostics_reason_lexemes(diagnostics: ds), pattern: "bash_fold_serialize_stmt_list_shape_refused")
    Accepted { value: _, diagnostics: _ } => false
  }
}

// THE SAME REFUSAL REACHES AN ASSIGN: the shape the seed build's parameter default handed -- one
// assignment standing as an `if` arm, three positional children (tag, name, value) -- is refused with
// the shape reason too. This is the half of the contract that kept the fold honest while
// dag/gunbc/repo/repo_self_build.dag's `default_from` was emitting a refusal marker into all four
// required workflows in place of the folded build preamble: the fold was right, the caller was wrong.
test fn a_bare_assign_as_an_if_else_arm_refuses_with_the_shape_reason() -> Bool {
  let one_arm = bash_build_assign(name: "GUNBC_SEED_TARGET", value: bash_build_word_lit(text: "/target"))
  let bare_arms = bash_build_if_else(
    cond: bash_build_command_from_lits(lits: ["test", "-n", "$GUNBC_SEED_TARGET"]),
    then_body: one_arm,
    else_body: one_arm,
  )
  match bash_fold_serialize_node(stmt: bare_arms) {
    Rejected { diagnostics: ds } =>
      string_contains(s: diagnostics_reason_lexemes(diagnostics: ds), pattern: "bash_fold_serialize_stmt_list_shape_refused")
    Accepted { value: _, diagnostics: _ } => false
  }
}

// THE BUILDER OWED BY THE FOLD'S CONTRACT EXISTS AND FOLDS: an `if`/`else` whose two arms are single
// statements, built through the ONE builder for that shape (bash_build_if_else_from_stmts, the twin
// of bash_build_if_from_stmts and bash_build_subshell_from_stmts), carries no refusal marker and
// spells both arms. The claims above pin what the fold refuses; this pins the route the vocabulary
// must offer so a caller never has to hand the fold a bare statement to get one statement per arm.
test fn the_one_if_else_builder_folds_single_statement_arms() -> Bool {
  let folded = bash_build_if_else_from_stmts(
    cond: bash_build_command_from_lits(lits: ["test", "-n", "$SOURCE"]),
    then_stmts: [bash_build_assign(name: "TARGET", value: bash_build_word_lit(text: "keep"))],
    else_stmts: [bash_build_assign(name: "TARGET", value: bash_build_word_lit(text: "fallback"))],
  )
  let text = shell_command_text_of_node(stmt: folded)
  match shell_command_text_refusal_marker() {
    Absent => false
    Present { value: refused_marker } =>
      (!string_contains(s: text, pattern: refused_marker))
        && string_contains(s: text, pattern: "TARGET='keep'")
        && string_contains(s: text, pattern: "TARGET='fallback'")
  }
}
