module test.claim.live_deploy.apply_no_refused_marker_witness

import std.types { Bool, String, List }
import std.algebra { string_contains }
import gunbc.live_deploy.desired { selected_deployment_spec, srv1_production_desired_deployment }
import gunbc.live_deploy.emit {
  apply_intent_fragments, compose_host_script_decide_steps, compose_host_script_mutate_steps,
  apply_object_source_pwd_serve_decide_command,
}
import gunbc.shell_command_text { shell_command_text_of_node }
import v2.workflow.bash_command_fold_serialize { bash_fold_serialize_node }
import v2.std.diagnostic { Accepted, Rejected, diagnostics_reason_lexemes }
import gunbc.ci.ci_deploy_access { ci_deploy_srv1_access }
import gunbc.host.host_axis_caps { CapConvergeWithheld }
import v2.extdeps.languages.bash_build {
  bash_build_if_else, bash_build_stmt_list_from_nodes, bash_build_command_from_lits,
}
import test.claim.live_deploy.apply_emission_projection {
  pipeline_steps_text, apply_empty_host_effects, claim_oidc_now, apply_complete_object_source_serve,
}
import test.claim.live_deploy.deploy_release_fixture { deploy_witness_full_install_plan }

data refused_marker: String = "__GUNBC_BASH_EMIT_REFUSED__"

// THE LIVE SRV1 SPEC'S WHOLE APPLY, through the real apply emission with the host observation supplied
// (an empty host; the object source supplied as servable, which selects the same Decide fragment the
// wet apply's $PWD decide selects). The refusal of a command intent by the bash serializer is not
// valid shell, so one such marker anywhere in the script makes the host step fail at parse time:
// a lab deploy failed closed at line 14 on exactly this, in the object-source Decide step. RED
// when any step of the live spec's complete apply (Decide and Mutate halves) carries the marker.
test fn the_live_apply_script_contains_no_refused_bash_marker() -> Bool {
  let spec = selected_deployment_spec(row: srv1_production_desired_deployment())
  let fragments = apply_intent_fragments(
    spec: spec,
    effects: apply_empty_host_effects(spec: spec),
    access: ci_deploy_srv1_access,
    plan: deploy_witness_full_install_plan(spec: spec),
    cap_authorization: CapConvergeWithheld { cause: "apply refused-marker witness" },
    oidc_now: claim_oidc_now(),
    object_source_serve: apply_complete_object_source_serve(),
  )
  !string_contains(s: pipeline_steps_text(steps: compose_host_script_decide_steps(fragments: fragments)), pattern: refused_marker)
    && !string_contains(s: pipeline_steps_text(steps: compose_host_script_mutate_steps(fragments: fragments)), pattern: refused_marker)
}

// THE OBJECT-SOURCE DECIDE STEP ALONE: the construct that was refused (a bare `if` as the else body,
// where the grammar's else body is a statement LIST), taken at the unit that builds it.
test fn the_object_source_decide_step_serializes_without_the_marker() -> Bool {
  let cmd = apply_object_source_pwd_serve_decide_command()
  !string_contains(s: cmd, pattern: refused_marker) && string_contains(s: cmd, pattern: "rev-parse")
}

// NOTHING IS DROPPED: the config probes' nested unreadable-config refusal (exit neither 0 nor 1) must
// survive serialization. A serializer that keeps a prefix of children emits no marker and loses it.
test fn the_object_source_decide_step_keeps_the_unreadable_config_refusal() -> Bool {
  let cmd = apply_object_source_pwd_serve_decide_command()
  string_contains(s: cmd, pattern: "exited neither 0 nor 1")
}

// THE REFUSAL NAMES ITS CAUSE: the old shape (an `if` node standing as else body, not wrapped in a
// statement list) is refused by the serializer, and the text the caller embeds carries the located
// reason rather than a constant. Controls the diagnosis above: this is the construct #14134 built.
test fn a_refused_intent_marker_carries_the_serializers_reason() -> Bool {
  let colon = bash_build_stmt_list_from_nodes(stmts: [bash_build_command_from_lits(lits: [":"])])
  let bare_nested = bash_build_if_else(
    cond: bash_build_command_from_lits(lits: ["true"]),
    then_body: colon,
    else_body: bash_build_if_else(cond: bash_build_command_from_lits(lits: ["true"]), then_body: colon, else_body: colon),
  )
  let text = shell_command_text_of_node(stmt: bare_nested)
  string_contains(s: text, pattern: refused_marker)
    && string_contains(s: text, pattern: "bash_fold_serialize_stmt_list_shape_refused")
}

// THE SERIALIZER REFUSES AN OVER-ARITY LIST: a bare `if` node standing where a statement list is
// expected has more than the (prefix, statement) children; the fold must refuse with the shape
// reason rather than keep children 0/1 and drop the rest (DESIGN section 5).
test fn the_serializer_refuses_an_over_arity_statement_list_with_its_reason() -> Bool {
  let colon = bash_build_stmt_list_from_nodes(stmts: [bash_build_command_from_lits(lits: [":"])])
  let inner = bash_build_if_else(cond: bash_build_command_from_lits(lits: ["true"]), then_body: colon, else_body: colon)
  let bare_nested = bash_build_if_else(cond: bash_build_command_from_lits(lits: ["true"]), then_body: colon, else_body: inner)
  match bash_fold_serialize_node(stmt: bare_nested) {
    Rejected { diagnostics: ds } =>
      string_contains(s: diagnostics_reason_lexemes(diagnostics: ds), pattern: "bash_fold_serialize_stmt_list_shape_refused")
    Accepted { value: _, diagnostics: _ } => false
  }
}
