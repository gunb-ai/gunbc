module test.claim.live_deploy.serving_footprint_witness

import std.types { Bool, String }
import std.process { ProcessExit, ExitSuccess, ExitFailure }
import std.measure { ByteSize, byte_size, byte_size_count, kibibyte_count }
import gunbc.live_deploy.slice_bounds { user_work_slot_memory_max, user_work_slice_memory_max_of }
import gunbc.live_deploy.user_work_pool_slots { user_work_charged_slots }
import std.nat { Succ }
import gunbc.live_deploy.serving_child_observations {
  ServingChildHostOverride, serving_child_engine_bound, serving_child_worst_instrumented,
  serving_child_residency, serving_child_residency_for, serving_child_engine_bound_is_positive,
  no_serving_child_host_override_undercuts_the_engine,
  serving_child_bound_covers_the_worst_instrumented_reading,
  serving_child_bound_stands_on_the_engine_print,
  user_work_serving_door_residency, user_work_serving_census_headroom,
  user_work_request_footprint_of, user_work_slice_fits,
}

fn check_or_name(name: String, held: Bool) -> String {
  if held { "" } else { concat(name, " ") }
}

// ── THE PER-REQUEST FOOTPRINT AND THE SLICE-FIT INEQUALITY ───────────────────────────────────
// Claims for the authority that closed the srv3 OOM class (2026-11-26): slots x footprint +
// per-slice headroom <= slice memory.max, with footprint = unit MemoryMax + serving child bound +
// door residency (the door waits synchronously on the child, so it is per request; the census is
// the fixed per-slice headroom; the probe runs client-side and is out of the slice entirely).
// The shapes below are the model's own numbers for srv1, srv3, butch and ken. Pure arithmetic;
// hermetic per-PR discovery executes every one.

data claim_grant_22gib: ByteSize = byte_size(23622320128)
data claim_child_6gib: ByteSize = byte_size(6442450944)
data claim_door: ByteSize = byte_size(409432059)
data claim_footprint: ByteSize = byte_size(30474203131)

// THE FOOTPRINT IS THE SUM, EXACTLY: 22 GiB grant + 6.0 GiB child bound + door residency.
fn the_footprint_is_the_unit_ceiling_beside_the_child_and_the_door() -> Bool {
  byte_size_count(b: user_work_request_footprint_of(unit_memory_max: claim_grant_22gib, child_residency: claim_child_6gib))
    == byte_size_count(b: claim_footprint)
}

// THE DOOR RESIDENCY COVERS ITS MEASURED RUN (max_rss 391248 KiB = 400586752 bytes) — the
// per-request reading, per the model's synchronous hand-off.
fn the_door_residency_covers_the_measured_door_run() -> Bool {
  byte_size_count(b: user_work_serving_door_residency) >= 400586752
}

// THE CENSUS HEADROOM COVERS THE MEASURED CENSUS-CLASS RUN — the fixed per-slice reading.
fn the_census_headroom_covers_the_measured_census_leg() -> Bool {
  byte_size_count(b: user_work_serving_census_headroom) >= 400586752
}

// THE CHILD BOUND IS POSITIVE — a zero bound would erase the uncharged resident from every sum.
fn the_child_bound_is_positive() -> Bool {
  serving_child_engine_bound_is_positive()
}

// THE CHILD BOUND SITS AT OR ABOVE THE WORST INSTRUMENTED SERVING-ROUTE READING (review 99177's
// fix as a change detector: an edit dropping the bound under 6090188 KiB turns this red), and the
// reading is the typed KiB quantity it claims to be (review 99193: no unit-named bare Ints).
fn the_child_bound_covers_the_worst_instrumented_reading() -> Bool {
  serving_child_bound_covers_the_worst_instrumented_reading()
    && kibibyte_count(k: serving_child_worst_instrumented) == 6090188
}

// THE BOUNDARY IS DISCRIMINATED AT ITS REAL PRODUCERS (witness_one_interface): the footprint and
// the fits answer below are composed ONLY from the fleet's own rows -- the standing slot ceiling,
// the residency function, the declared slice ceiling -- never supplied literals.
fn the_producers_inhabit_the_boundary() -> Bool {
  let produced_footprint = user_work_request_footprint_of(unit_memory_max: user_work_slot_memory_max, child_residency: serving_child_residency(host: "srv3"))
  // The slice ceiling is read at the STANDING POOL'S OWN COUNT (user_work_charged_slots), which the
  // CI-cost ruling re-priced to footprint seats (session quiet-pike-440, #17181, ruling
  // remote_build_capacity_ruling_ci_cost_option_a_default_approved_2026_11_27). Under footprint
  // pricing the ceiling that max_of emits is exactly slots x footprint + census, so the discriminating
  // pair moved from (1 fits / 2 refused) to (charged fits / charged+1 refused) -- the same boundary
  // test, one notch up, because the slice now honestly holds what it buys. One-slot slices still
  // admit one and refuse two (the grant-only oversell class): pinned in the claim below.
  let produced_slice = user_work_slice_memory_max_of(slots: user_work_charged_slots)
  user_work_slice_fits(slots: user_work_charged_slots, footprint: produced_footprint, slice_max: produced_slice)
    && !user_work_slice_fits(slots: Succ { prev: user_work_charged_slots }, footprint: produced_footprint, slice_max: produced_slice)
    && byte_size_count(b: produced_footprint) == byte_size_count(b: claim_footprint)
    // THE ONE-SEAT SLICE STILL REFUSES A SECOND: the grant-only oversell class, at the smallest pool.
    && user_work_slice_fits(slots: 1, footprint: produced_footprint, slice_max: user_work_slice_memory_max_of(slots: 1))
    && !user_work_slice_fits(slots: 2, footprint: produced_footprint, slice_max: user_work_slice_memory_max_of(slots: 1))
}

// THE BOUND STANDS ON THE ENGINE'S OWN PRINT, not on a transcribed plan quote or a stale
// different-subject figure — the exact regression review 99177 caught.
fn the_child_bound_stands_on_an_instrument() -> Bool {
  serving_child_bound_stands_on_the_engine_print()
}

// THE STANDING HOST TABLE NEVER UNDERCUTS THE ENGINE BOUND.
fn the_host_rows_stay_above_the_engine_bound() -> Bool {
  no_serving_child_host_override_undercuts_the_engine()
}

// A HOST WITHOUT ITS OWN ROW IS GOVERNED BY THE ENGINE BOUND — no host is left unbounded.
fn an_unmeasured_host_takes_the_engine_bound() -> Bool {
  byte_size_count(b: serving_child_residency(host: "srv3")) == byte_size_count(b: serving_child_engine_bound.bytes)
}

// A HOST ROW DECIDES FOR ITS HOST AND RAISES THE BOUND.
fn a_host_row_speaks_for_its_host() -> Bool {
  let raised = [ServingChildHostOverride { host: "srv9", bytes: byte_size(7516192768) }]
  byte_size_count(b: serving_child_residency_for(raised: raised, host: "srv9")) == 7516192768
    && byte_size_count(b: serving_child_residency_for(raised: raised, host: "srv3")) == byte_size_count(b: serving_child_engine_bound.bytes)
}

// A HOST ROW CANNOT FABRICATE HEADROOM UNDER THE ENGINE BOUND.
fn a_host_row_cannot_fabricate_headroom() -> Bool {
  let sunken = [ServingChildHostOverride { host: "srv9", bytes: byte_size(1073741824) }]
  byte_size_count(b: serving_child_residency_for(raised: sunken, host: "srv9")) == byte_size_count(b: serving_child_engine_bound.bytes)
}

// SRV1 SHAPE, THE OVERSELL CLASS, NOW CLOSED HONESTLY. Under the OLD grant-only pricing the
// standing 2-slot slice (44 GiB) admitted ONE 22 GiB-grant request and refused a second — the
// ledger said two; the slice held one; that over-sell is what the footprint authority exists to
// catch. The CI-cost ruling (msg_3789e805, default-approved; session quiet-pike-440's row
// remote_build_capacity_ruling_ci_cost_option_a_default_approved_2026_11_27) closed it the honest
// way: the standing slice was RE-PRICED to footprint seats, so its ceiling now holds exactly the
// seats it sells -- charged seats fit, one more than charged is refused. If the ceiling ever drifts
// from the seats it advertises (an oversell returning), THIS claim is where it reds.
fn srv1_holds_its_seats_and_refuses_one_more() -> Bool {
  user_work_slice_fits(slots: user_work_charged_slots, footprint: claim_footprint, slice_max: user_work_slice_memory_max_of(slots: user_work_charged_slots))
    && !user_work_slice_fits(slots: Succ { prev: user_work_charged_slots }, footprint: claim_footprint, slice_max: user_work_slice_memory_max_of(slots: user_work_charged_slots))
}

// SRV3 SHAPE, THE RED CONTROL OF THE NIGHT: under today's carve (one CI slot, 25 GiB) the slice
// REFUSES even ONE 22 GiB-grant served request. Every srv3 request leg that died was this
// arithmetic, enforced by the kernel instead of the model.
fn srv3_refuses_a_single_granted_build_under_todays_carve() -> Bool {
  !user_work_slice_fits(slots: 1, footprint: claim_footprint, slice_max: byte_size(26843545600))
}

// THE VACUOUS ARM IS VACUOUS, NOT ADMITTING: zero slots fit any slice, and a slice that cannot
// even hold its headroom admits nothing above zero.
fn zero_slots_always_fit_and_headroom_over_ceiling_fails_closed() -> Bool {
  user_work_slice_fits(slots: 0, footprint: claim_footprint, slice_max: byte_size(26843545600))
    && user_work_slice_fits(slots: 0, footprint: claim_footprint, slice_max: byte_size(1048576))
    && !user_work_slice_fits(slots: 1, footprint: claim_footprint, slice_max: byte_size(1048576))
}

// BUTCH SHAPE, CHANGED DETECTOR: under the INSTRUMENTED child bound the 192 GiB pool holds SIX
// footprints beside the headroom, not the seven the 3.4-GiB plan figure allowed — the instrument
// supersedes the plan quote, exactly as review 99177 required. If a future measured reading lets
// the bound down, THIS claim is where the seat count moves, together with the bound.
fn butch_192gib_holds_six_not_seven() -> Bool {
  user_work_slice_fits(slots: 6, footprint: claim_footprint, slice_max: byte_size(206158430208))
    && !user_work_slice_fits(slots: 7, footprint: claim_footprint, slice_max: byte_size(206158430208))
}

// KEN SHAPE, PER THE RULING: ken's ruled pool is ONE seat at footprint + headroom; it admits one
// and refuses two. The 56 GiB live read is a DIFFERENT number (the old gate-witness figure) and
// is stated separately below — the ruling supersedes it as the pool, not as the read.
fn ken_ruled_pool_holds_exactly_one() -> Bool {
  let ruled_pool = byte_size(byte_size_count(b: claim_footprint) + byte_size_count(b: user_work_serving_census_headroom))
  user_work_slice_fits(slots: 1, footprint: claim_footprint, slice_max: ruled_pool)
    && !user_work_slice_fits(slots: 2, footprint: claim_footprint, slice_max: ruled_pool)
}

// KEN'S 56 GiB LIVE READ, KEPT AS WHAT IT IS: a read of the host, not a pool. Even that room
// holds one footprint, not two — nobody may size ken's admissions off it as if it were a pool.
fn ken_live_56gib_read_holds_one_not_two() -> Bool {
  user_work_slice_fits(slots: 1, footprint: claim_footprint, slice_max: byte_size(60129542144))
    && !user_work_slice_fits(slots: 2, footprint: claim_footprint, slice_max: byte_size(60129542144))
}

// THE FOOTPRINT IS NEVER BELOW THE UNIT CEILING ALONE: a caller that sized seats by the grant
// alone (the old division) is provably sizing below what one request occupies.
fn the_footprint_exceeds_the_grant_alone() -> Bool {
  byte_size_count(b: user_work_request_footprint_of(unit_memory_max: user_work_slot_memory_max, child_residency: claim_child_6gib))
    > byte_size_count(b: user_work_slot_memory_max)
}

// THE WHOLE WITNESS IN ONE PROCESS EXIT: zero when every claim above held. Hermetic discovery
// runs each claim per PR; this entry is the manual-receipt route the PR body cites.
fn run_serving_footprint_witness() -> ProcessExit {
  let red = join([
    check_or_name(name: "the_footprint_is_the_unit_ceiling_beside_the_child_and_the_door", held: the_footprint_is_the_unit_ceiling_beside_the_child_and_the_door()),
    check_or_name(name: "the_door_residency_covers_the_measured_door_run", held: the_door_residency_covers_the_measured_door_run()),
    check_or_name(name: "the_census_headroom_covers_the_measured_census_leg", held: the_census_headroom_covers_the_measured_census_leg()),
    check_or_name(name: "the_child_bound_is_positive", held: the_child_bound_is_positive()),
    check_or_name(name: "the_child_bound_covers_the_worst_instrumented_reading", held: the_child_bound_covers_the_worst_instrumented_reading()),
    check_or_name(name: "the_child_bound_stands_on_an_instrument", held: the_child_bound_stands_on_an_instrument()),
    check_or_name(name: "the_producers_inhabit_the_boundary", held: the_producers_inhabit_the_boundary()),
    check_or_name(name: "the_host_rows_stay_above_the_engine_bound", held: the_host_rows_stay_above_the_engine_bound()),
    check_or_name(name: "an_unmeasured_host_takes_the_engine_bound", held: an_unmeasured_host_takes_the_engine_bound()),
    check_or_name(name: "a_host_row_speaks_for_its_host", held: a_host_row_speaks_for_its_host()),
    check_or_name(name: "a_host_row_cannot_fabricate_headroom", held: a_host_row_cannot_fabricate_headroom()),
    check_or_name(name: "srv1_holds_its_seats_and_refuses_one_more", held: srv1_holds_its_seats_and_refuses_one_more()),
    check_or_name(name: "srv3_refuses_a_single_granted_build_under_todays_carve", held: srv3_refuses_a_single_granted_build_under_todays_carve()),
    check_or_name(name: "zero_slots_always_fit_and_headroom_over_ceiling_fails_closed", held: zero_slots_always_fit_and_headroom_over_ceiling_fails_closed()),
    check_or_name(name: "butch_192gib_holds_six_not_seven", held: butch_192gib_holds_six_not_seven()),
    check_or_name(name: "ken_ruled_pool_holds_exactly_one", held: ken_ruled_pool_holds_exactly_one()),
    check_or_name(name: "ken_live_56gib_read_holds_one_not_two", held: ken_live_56gib_read_holds_one_not_two()),
    check_or_name(name: "the_footprint_exceeds_the_grant_alone", held: the_footprint_exceeds_the_grant_alone()),
  ], "")
  if red == "" {
    ExitSuccess
  } else {
    ExitFailure { code: 1, reason: join(["serving footprint claim red: ", red], "") }
  }
}
