// WHAT THE `_command_matches_transport` WITNESSES BELOW ACTUALLY PIN, since the name promises
// more than one assertion can carry. They compare the emitted TEXT against the argv rows, and
// the `_argv_matches_transport_row` witnesses above compare those same argv rows against the
// materialized transport. Neither reaches the transport from the text alone; chained, they do.
// Stated because this one was a transcribed literal until it went red in CI, and a transcribed
// expectation under a "matches transport" name is the worst of both — it looks like coherence
// and asserts a byte string nobody derived.
test fn witness_dpkg_status_command_matches_transport() -> Bool {
  dpkg_status_command(package: package_tailscale)
    == quoted_command(argv: dpkg_status_argv(package: package_tailscale))
}

test fn witness_apt_install_command_matches_transport() -> Bool {
  apt_install_command(package: package_nodejs, privileged: false)
    == quoted_command(argv: apt_install_argv(package: package_nodejs))
}

test fn witness_privileged_apt_install_command() -> Bool {
  apt_install_command(package: package_tailscale, privileged: true)
    == quoted_privileged_command(argv: apt_install_argv(package: package_tailscale))
}

test fn witness_systemctl_restart_command_matches_transport() -> Bool {
  systemctl_restart_command(unit: gunbc_roadmap_unit_name, privileged: true)
    == quoted_privileged_command(argv: systemctl_restart_argv(unit: gunbc_roadmap_unit_name))
}

test fn witness_systemctl_enable_command_matches_transport() -> Bool {
  systemctl_enable_command(unit: gunbc_roadmap_unit_name, privileged: true)
    == quoted_privileged_command(argv: systemctl_enable_argv(unit: gunbc_roadmap_unit_name))
}

test fn witness_systemctl_disable_now_command_matches_transport() -> Bool {
  systemctl_disable_now_command(unit: gunbc_roadmap_unit_name, privileged: true)
    == quoted_privileged_command(argv: systemctl_disable_now_argv(unit: gunbc_roadmap_unit_name))
}

test fn witness_systemctl_daemon_reload_command_privileged() -> Bool {
  systemctl_daemon_reload_command(privileged: true)
    == quoted_privileged_command(argv: systemctl_daemon_reload_argv())
}

test fn live_deploy_operations_RED_apt_install_wrong_package_golden() -> Bool {
  apt_install_command(package: package_tailscale, privileged: false)
    != quoted_command(argv: apt_install_argv(package: package_nodejs))
}

// RED discriminators against the former `join(argv, " ")` spelling returning. Under it an argv
// element carrying a space or an apostrophe lost its boundary and the host re-parsed it as
// several words; both assertions fail on that spelling and pass on the modelled command.
data spacey_package: NonEmptyStr = "tail scale"

test fn operations_RED_argv_element_with_a_space_keeps_its_boundary() -> Bool {
  string_contains(
    s: apt_install_command(package: spacey_package, privileged: false),
    pattern: posix_single_quote(spelling: spacey_package as String),
  )
}

test fn operations_RED_command_is_not_a_bare_space_join() -> Bool {
  apt_install_command(package: spacey_package, privileged: false)
    != argv_join(argv: apt_install_argv(package: spacey_package))
}
