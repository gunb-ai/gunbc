test fn witness_systemctl_enable_argv_matches_transport_row() -> Bool {
  let helper = systemctl_enable_argv(unit: gunbc_roadmap_unit_name)
  let transport = v2.std.operation_argv.operation_argv_tokens_or_refusal_label(
    m: shell_materialize_operation_argv(
      test.claim.live_deploy.operations_witness.systemctl_path,
      test.claim.live_deploy.operations_witness.systemctl_service,
      "Enable",
      [
        v2.std.operation_argv.operation_argv_bind_text(name: "unit", text: gunbc_roadmap_unit_name as String)
      ]
    )
