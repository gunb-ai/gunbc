module test.claim.live_deploy.operations_witness

import std.logic { Bool }
import extdeps.apt { package_nodejs, package_tailscale }
import gunbc.live_deploy.operations {
  dpkg_status_command,
  apt_install_command,
  systemctl_daemon_reload_command,
  systemctl_restart_command,
  systemctl_disable_now_command,
  privileged_command,
}
import gunbc.live_deploy.spec { gunbc_roadmap_unit_name }
import extdeps.os.systemctl { systemctl_daemon_reload_argv }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn witness_dpkg_status_command_matches_transport() -> Bool {
  dpkg_status_command(package: package_tailscale) == "dpkg -s tailscale"
}

fn witness_apt_install_command_matches_transport() -> Bool {
  apt_install_command(package: package_nodejs, privileged: false) == "apt-get install --yes nodejs"
}

fn witness_privileged_apt_install_command() -> Bool {
  apt_install_command(package: package_tailscale, privileged: true) == "sudo -n apt-get install --yes tailscale"
}

fn witness_systemctl_restart_command_matches_transport() -> Bool {
  systemctl_restart_command(unit: gunbc_roadmap_unit_name, privileged: true) == "sudo -n systemctl restart gunbc-roadmap.service"
}

fn witness_systemctl_disable_now_command_matches_transport() -> Bool {
  systemctl_disable_now_command(unit: gunbc_roadmap_unit_name, privileged: true) == "sudo -n systemctl disable --now gunbc-roadmap.service"
}

fn witness_privileged_command_prefixes_sudo_n() -> Bool {
  privileged_command(argv: systemctl_daemon_reload_argv()) == "sudo -n systemctl daemon-reload"
}

fn witness_systemctl_daemon_reload_command_privileged() -> Bool {
  systemctl_daemon_reload_command(privileged: true) == "sudo -n systemctl daemon-reload"
}

test fn live_deploy_operations_holds() -> Bool {
  witness_dpkg_status_command_matches_transport()
    && witness_apt_install_command_matches_transport()
    && witness_privileged_apt_install_command()
    && witness_systemctl_restart_command_matches_transport()
    && witness_systemctl_disable_now_command_matches_transport()
    && witness_privileged_command_prefixes_sudo_n()
    && witness_systemctl_daemon_reload_command_privileged()
}
