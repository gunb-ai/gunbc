test fn witness_dpkg_status_command_matches_transport() -> Bool {
  dpkg_status_command(package: package_tailscale) == "dpkg -s tailscale"
}

test fn witness_apt_install_command_matches_transport() -> Bool {
  apt_install_command(package: package_nodejs, privileged: false) == "apt-get install --yes nodejs"
}

test fn witness_privileged_apt_install_command() -> Bool {
  apt_install_command(package: package_tailscale, privileged: true) == "sudo -n apt-get install --yes tailscale"
}

test fn witness_systemctl_restart_command_matches_transport() -> Bool {
  systemctl_restart_command(unit: gunbc_roadmap_unit_name, privileged: true) == "sudo -n systemctl restart gunbc-roadmap.service"
}

test fn witness_systemctl_enable_command_matches_transport() -> Bool {
  systemctl_enable_command(unit: gunbc_roadmap_unit_name, privileged: true) == "sudo -n systemctl enable gunbc-roadmap.service"
}

test fn witness_systemctl_disable_now_command_matches_transport() -> Bool {
  systemctl_disable_now_command(unit: gunbc_roadmap_unit_name, privileged: true) == "sudo -n systemctl disable --now gunbc-roadmap.service"
}

test fn witness_privileged_command_prefixes_sudo_n() -> Bool {
  privileged_command(argv: systemctl_daemon_reload_argv()) == "sudo -n systemctl daemon-reload"
}

test fn witness_systemctl_daemon_reload_command_privileged() -> Bool {
  systemctl_daemon_reload_command(privileged: true) == "sudo -n systemctl daemon-reload"
}

test fn live_deploy_operations_RED_apt_install_wrong_package_golden() -> Bool {
  apt_install_command(package: package_tailscale, privileged: false) != "apt-get install --yes nodejs"
}
