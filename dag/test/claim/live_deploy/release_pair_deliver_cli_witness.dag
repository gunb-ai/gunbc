module test.claim.live_deploy.release_pair_deliver_cli_witness
// WITNESS for the PR-2a decode fns. Each injects a ProcessOutcome (the shape the admissible command seam,
// run_shell_command_capture over LocalExec, produces) and asserts the typed observation it decodes to. These are the
// fail-closed guarantees: a refusal or an empty observation NEVER becomes a head, a run, a fetched pack, or a verdict.
// (The effectful entry that PRODUCES these ProcessOutcomes runs the unit's own delivery at deploy; the argv builders
// are consumed there — this step witnesses the decoding that decision depends on.)

import std.types { String, NonEmptyStr, CommitSha }
import extdeps.git.object_store { git_object_id_from_untagged_hex, git_object_id_wire_hex }
import std.content_hash { Fnv1a64Structural }
import gunbc.live_deploy.release_binding {
  ReleaseBoundToTree,
  ReleaseMixed,
  ReleaseBindingUnobserved,
}
import gunbc.live_deploy.release_locus { RevisionBoundAtEmission, RevisionNotInstalled }
import std.optional { Optional, Present, Absent }
import extdeps.shell.exec { ProcessOutcome, ProcessOutputPresent, ProcessOutputAbsent, ProcessRefused }
import gunbc.live_deploy.release_pair_delivery {
  PackFetch, PackPresent, PackAbsent, PackVerify, VerifiedOn, Refused,
  release_pair_converged_noop, PlanWaits,
}
import gunbc.live_deploy.release_pair_deliver_cli {
  release_pair_decode_head, release_pair_decode_run, release_pair_pack_fetch, release_pair_pack_verify,
  release_pair_deliver_serving,
  release_pair_serving_poison_refused,
  ReleasePairRunLookup, RunLookupFound, RunLookupNoneForHead, RunLookupDiscoveryRefused,
  release_pair_run_discovery_refused_reason, release_pair_run_list_malformed_reason,
}

data head_hex: NonEmptyStr = "0123456789abcdef0123456789abcdef01234567"
// A DIFFERENT valid 40-hex revision, for the red control: a placed tree sitting on it is NOT converged with head_hex.
data other_head_hex: NonEmptyStr = "9923456789abcdef0123456789abcdef01234567"
data sha_hex: NonEmptyStr = "a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90"
// The real shape `sha256sum <path>` prints on stdout: "<64hex>  <path>". The digest binding must take the first field,
// not the whole line, so the fold's member path built from the digest is the bare hex, not a path-bearing string.
data sha_line_with_path: String = "a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90  /opt/gunbc/releases/incoming-release-bins/gunbc_serve"
data pack_dir_str: String = "/opt/gunbc/releases/incoming-release-bins"
data member_src_str: String = "/opt/gunbc/releases/incoming-release-bins/gunbc_serve"

// A clean head observation decodes to Present, naming the exact head printed.
test fn witness_decode_head_present_names_the_head() -> Bool {
  match release_pair_decode_head(ProcessOutputPresent { text: head_hex as String }) {
    Present { value: v } => (v as String) == (head_hex as String)
    none => false
  }
}

// A failed git rev-parse is NOT a head: a refusal decodes to none (keep last good, do not even try to deliver).
test fn witness_decode_head_refused_is_none() -> Bool {
  match release_pair_decode_head(ProcessRefused { exit_code: 128, stderr: "fatal: not a git repository" }) {
    none => true
    Present { value: _ } => false
  }
}

// Discovery that COULD NOT RUN (ProcessRefused: auth expired / network / rate limit, or ProcessOutputAbsent) is a
// DECLARED refusal, NOT a benign wait and NOT a fabricated run id — the timer must surface it (review 96216), so an
// expired gh token cannot make every tick exit green and silently stop tracking main.
test fn witness_decode_run_refused_is_discovery_refused() -> Bool {
  let refused = match release_pair_decode_run(ProcessRefused { exit_code: 1, stderr: "gh: auth expired" }) {
    RunLookupDiscoveryRefused { reason } => (reason as String) == (release_pair_run_discovery_refused_reason as String)
    _ => false
  }
  let absent = match release_pair_decode_run(ProcessOutputAbsent) {
    RunLookupDiscoveryRefused { reason: _ } => true
    _ => false
  }
  refused && absent
}

// The BENIGN wait is specifically "gh succeeded but returned no successful run for the head" (empty stdout): that
// decodes to RunLookupNoneForHead (keep-last-good, retry), distinct from the discovery-refused arm above.
test fn witness_decode_run_empty_is_none_for_head() -> Bool {
  match release_pair_decode_run(ProcessOutputPresent { text: "" }) {
    RunLookupNoneForHead => true
    _ => false
  }
}

// A fetched pack with an OBSERVED digest decodes to PackPresent naming the observed digest, dir and serve member.
test fn witness_pack_fetch_present_binds_observed_digest() -> Bool {
  let f = release_pair_pack_fetch(ProcessOutputAbsent, ProcessOutputPresent { text: sha_hex as String }, pack_dir_str, member_src_str)
  match f {
    PackPresent { sha256: d, pack_dir: pd, binary_source: bs } =>
      (d as String) == (sha_hex as String) && (pd as String) == pack_dir_str && (bs as String) == member_src_str
    PackAbsent { reason: _ } => false
  }
}

// A download that refused decodes to PackAbsent — the pair keeps serving, it is never delivered from a pack the host
// could not actually fetch.
test fn witness_pack_fetch_refused_is_absent() -> Bool {
  let f = release_pair_pack_fetch(ProcessRefused { exit_code: 1, stderr: "gh run download failed" }, ProcessOutputPresent { text: sha_hex as String }, pack_dir_str, member_src_str)
  match f {
    PackAbsent { reason: _ } => true
    PackPresent { sha256: _, pack_dir: _, binary_source: _ } => false
  }
}

// The `sha256sum` line "<hex>  <path>" binds the bare hex, NOT the whole line: the fold builds the member path from
// this digest, so a path-bearing digest would corrupt the placement. Proves the first-field extraction.
test fn witness_pack_fetch_binds_digest_from_sha256sum_line() -> Bool {
  let f = release_pair_pack_fetch(ProcessOutputAbsent, ProcessOutputPresent { text: sha_line_with_path }, pack_dir_str, member_src_str)
  match f {
    PackPresent { sha256: d, pack_dir: _, binary_source: _ } => (d as String) == (sha_hex as String)
    PackAbsent { reason: _ } => false
  }
}

// A digest line whose first field is not 64 lowercase hex is NOT a pack: the lower_hex_64 gate refuses it (red control
// for the digest binding — a corrupt or truncated digest can never authorize an install).
test fn witness_pack_fetch_rejects_non_hex_digest() -> Bool {
  let f = release_pair_pack_fetch(ProcessOutputAbsent, ProcessOutputPresent { text: "not-a-digest  /x" }, pack_dir_str, member_src_str)
  match f {
    PackAbsent { reason: _ } => true
    PackPresent { sha256: _, pack_dir: _, binary_source: _ } => false
  }
}

// The build-key check running clean is VerifiedOn the observed pack_dir.
test fn witness_pack_verify_clean_is_verified_on() -> Bool {
  match release_pair_pack_verify(ProcessOutputAbsent, pack_dir_str) {
    VerifiedOn { pack_dir: p } => (p as String) == pack_dir_str
    Refused { reason: _ } => false
  }
}

// The build-key check refusing is a named Refused, never VerifiedOn — fail closed.
test fn witness_pack_verify_refused_is_not_verified() -> Bool {
  match release_pair_pack_verify(ProcessRefused { exit_code: 1, stderr: "build key mismatch" }, pack_dir_str) {
    Refused { reason: _ } => true
    VerifiedOn { pack_dir: _ } => false
  }
}

// Serving-map witnesses. The OBSERVED bound tree revision must flow to the fold as RevisionBoundAtEmission
// carrying the same hex (via the single GitObjectId->hex authority), so keep-last-good protects the revision
// actually deployed. head_hex is the 40-hex sha1 fixture; git_object_id_from_untagged_hex/wire_hex round-trip it.
fn srv_surface() -> Fnv1a64Structural { Fnv1a64Structural { digest: "0123456789abcdef" as NonEmptyStr } }

test fn witness_serving_bound_carries_tree_revision_hex() -> Bool {
  match git_object_id_from_untagged_hex(hex: head_hex as String) {
    Absent => false
    Present { value: r } =>
      match release_pair_deliver_serving(ReleaseBoundToTree { revision: r, surface: srv_surface() }) {
        RevisionBoundAtEmission { revision: c } => (c as String) == (head_hex as String)
        RevisionNotInstalled => false
      }
  }
}

// Unobserved binding is fail-closed poison, never a usable binding (gunbc.design_argument::fail_closed).
test fn witness_serving_unobserved_is_poison() -> Bool {
  match release_pair_deliver_serving(ReleaseBindingUnobserved { cause: "no deployed tree" }) {
    RevisionNotInstalled => true
    RevisionBoundAtEmission { revision: _ } => false
  }
}

// A drifted (mixed) binding is also poison here: the serve gate refuses it upstream, so a bound arm must
// never be fabricated from a mixed tree. Discriminating control for the bound-arm mapping above.
test fn witness_serving_mixed_is_poison() -> Bool {
  match git_object_id_from_untagged_hex(hex: head_hex as String) {
    Absent => false
    Present { value: r } =>
      match release_pair_deliver_serving(ReleaseMixed { tree_revision: r, process_revision: "deadbeef" as CommitSha }) {
        RevisionNotInstalled => true
        RevisionBoundAtEmission { revision: _ } => false
      }
  }
}

// Review 96303 (red control): a MIXED serving observation (tree vs process disagree, or the surface cannot be resolved)
// is a poison state that must NEVER lead to a fresh placement -- the entry guard (release_pair_serving_poison_refused)
// refuses it RED. This witness asserts the guard says "refuse" for a Mixed binding.
test fn witness_serving_mixed_poison_refused() -> Bool {
  match git_object_id_from_untagged_hex(hex: head_hex as String) {
    Absent => false
    Present { value: r } => release_pair_serving_poison_refused(binding: ReleaseMixed { tree_revision: r, process_revision: "deadbeef" as CommitSha })
  }
}

// Review 96303 (red control): an UNOBSERVED serving observation (no observation yet) is a poison state that must NEVER
// lead to a fresh placement -- the entry guard refuses it RED. This witness asserts the guard says "refuse" for an
// Unobserved binding.
test fn witness_serving_unobserved_poison_refused() -> Bool {
  release_pair_serving_poison_refused(binding: ReleaseBindingUnobserved { cause: "no deployed tree" })
}

// The benign-vs-refusal split is NOT witnessed here: it moved to the typed DeliveryPlan arms
// (PlanWaits vs PlanKeepsLastGood) and is witnessed against the real producer release_pair_install_plan in
// release_pair_delivery_plan_witness, and the steady-state short-circuit is witnessed just below via the fold's pure
// release_pair_converged_noop route. The old string classifier this witness exercised is gone (review 96225).

// The run-list decode reads BOTH sides off the run metadata: the run id (download target) and the run's head_sha
// (the binary-side observation). A line without the tab separator is malformed and decodes to none (fail-closed).
test fn witness_decode_run_splits_run_id_and_head_sha() -> Bool {
  let ok = match release_pair_decode_run(outcome: ProcessOutputPresent { text: "44015305678\t1234567890abcdef1234567890abcdef12345678" }) {
    RunLookupFound { run: r } =>
      (r.run_id as String) == "44015305678" && (r.head_sha as String) == "1234567890abcdef1234567890abcdef12345678"
    _ => false
  }
  let no_tab = match release_pair_decode_run(outcome: ProcessOutputPresent { text: "44015305678" }) {
    RunLookupDiscoveryRefused { reason } => (reason as String) == (release_pair_run_list_malformed_reason as String)
    _ => false
  }
  if ok { no_tab } else { false }
}


// STEADY-STATE SHORT-CIRCUIT (review 96219 / 96225): a SECOND tick on an ALREADY-CONVERGED pair returns the benign
// PlanWaits no-op and performs NO fetch. The serving binding is supplied the way the entry receives it —
// release_pair_deliver_serving over the serve gate's observed DeployedReleaseBinding (the real producer, through the
// GitObjectId->hex authority) — with the head equal to the placed revision. The ROUTE claim: the fold's pure
// release_pair_converged_noop returns Present(PlanWaits), so the entry takes the keep-serving no-op and never reaches
// the fetch legs. Flip converged_noop to always-Absent and this reddens (the tick would re-fetch the same revision).
test fn witness_converged_pair_short_circuits_to_waits() -> Bool {
  match git_object_id_from_untagged_hex(hex: head_hex as String) {
    Absent => false
    Present { value: r } =>
      let serving = release_pair_deliver_serving(ReleaseBoundToTree { revision: r, surface: srv_surface() })
      match release_pair_converged_noop(serving: serving, head: head_hex) {
        Present { value: noop } => match noop {
          PlanWaits { kept: _, reason: _ } => true
          _ => false
        }
        none => false
      }
  }
}

// RED CONTROL for the short-circuit: it must not swallow the ticks that DO need to deliver. A placed tree on a
// DIFFERENT revision than the head, and a not-installed tree, both return none — the entry proceeds to the fetch.
// Widen converged_noop to always-Present and delivery silently stops tracking main forever; this reddens that.
test fn witness_diverged_or_uninstalled_pair_must_fetch() -> Bool {
  match git_object_id_from_untagged_hex(hex: head_hex as String) {
    Absent => false
    Present { value: a } =>
      match git_object_id_from_untagged_hex(hex: other_head_hex as String) {
        Absent => false
        Present { value: b } =>
          // Observed tree sits on b, the head to deploy is head_hex: NOT converged, so the fetch must run (none).
          let serving = release_pair_deliver_serving(ReleaseBoundToTree { revision: b, surface: srv_surface() })
          let diverged_proceeds = match release_pair_converged_noop(serving: serving, head: head_hex) {
            none => true
            Present { value: _ } => false
          }
          let uninstalled_proceeds = match release_pair_converged_noop(serving: RevisionNotInstalled, head: head_hex) {
            none => true
            Present { value: _ } => false
          }
          diverged_proceeds && uninstalled_proceeds
      }
  }
}
