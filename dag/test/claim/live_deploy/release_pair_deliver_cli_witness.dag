module test.claim.live_deploy.release_pair_deliver_cli_witness
// WITNESS for the PR-2a decode fns. Each injects a ProcessOutcome (the shape the admissible command seam,
// run_shell_command_capture over LocalExec, produces) and asserts the typed observation it decodes to. These are the
// fail-closed guarantees: a refusal or an empty observation NEVER becomes a head, a run, a fetched pack, or a verdict.
// (The effectful entry that PRODUCES these ProcessOutcomes runs the unit's own delivery at deploy; the argv builders
// are consumed there — this step witnesses the decoding that decision depends on.)

import std.types { String, NonEmptyStr, CommitSha, List }
import extdeps.git.object_store { git_object_id_from_untagged_hex, git_object_id_wire_hex }
import std.content_hash { Fnv1a64Structural }
import gunbc.live_deploy.release_binding {
  ReleaseBoundToTree,
  ReleaseMixed,
  ReleaseBindingUnobserved,
}
import gunbc.live_deploy.release_locus { RevisionBoundAtEmission, RevisionNotInstalled }
import std.optional { Optional, Present, Absent }
import std.algebra { string_contains }
import extdeps.shell.exec { ProcessOutcome, ProcessOutputPresent, ProcessOutputAbsent, ProcessRefused, ProcessRan, ProcessNotSpawned, process_observation }
import gunbc.live_deploy.release_pair_delivery {
  PackFetch, PackPresent, PackAbsent, PackVerify, VerifiedOn, Refused,
  release_pair_converged_noop, release_pair_already_at_head_reason, PlanWaits,
}
import gunbc.live_deploy.release_pair_deliver_cli {
  release_pair_decode_head, release_pair_pack_fetch, release_pair_pack_verify,
  release_pair_deliver_serving, ServingMapped, ServingRefused, release_pair_serving_poison_reason,
  release_pair_source_head_verdict, SourceHeadObserved, SourceHeadRefused,
  release_pair_source_head_mismatch_reason, release_pair_source_head_unobservable_reason,
  release_pair_source_placement_decision, PlacementCloneMissing, PlacementReuse, PlacementPresentAtOtherHead, PlacementAdd,
  release_pair_delivery_clone_missing_prefix, release_pair_source_placed_at_other_head_prefix,
  release_pair_delivery_clone_present, release_pair_source_fetch_verdict, release_pair_source_add_verdict, ActionPlaced, ActionRefused,
  ReleasePairRunLookup, RunLookupFound, RunLookupNoBuiltAncestor, RunLookupDiscoveryRefused,
  release_pair_run_discovery_refused_reason, release_pair_run_list_malformed_reason,
  release_pair_decode_ancestry, release_pair_decode_built_runs, release_pair_select_built_ancestor,
  ReleasePairAncestry, AncestryObserved, AncestryRefused, ReleasePairBuiltRuns, BuiltRunsObserved, BuiltRunsRefused,
  release_pair_ancestry_unobserved_reason, release_pair_ancestry_not_at_head_reason,
  release_pair_decode_build_job, BuildJobSucceeded, BuildJobNotSucceeded, BuildJobUnobservable,
}
import gunbc.live_deploy.deployed_tree_observation {
  DeployedTreeObserved, DeployedTreeUnobservable, DeployedScopeMatchesCommit, TreeCommandFailed,
}

data head_hex: NonEmptyStr = "0123456789abcdef0123456789abcdef01234567"
// A DIFFERENT valid 40-hex revision, for the red control: a placed tree sitting on it is NOT converged with head_hex.
data other_head_hex: NonEmptyStr = "9923456789abcdef0123456789abcdef01234567"
data sha_hex: NonEmptyStr = "a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90"
// The real shape `sha256sum <path>` prints on stdout: "<64hex>  <path>". The digest binding must take the first field,
// not the whole line, so the fold's member path built from the digest is the bare hex, not a path-bearing string.
data sha_line_with_path: String = "a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90  /opt/gunbc/releases/incoming-release-bins/gunbc_serve"
data pack_dir_str: String = "/opt/gunbc/releases/incoming-release-bins"
data member_src_str: String = "/opt/gunbc/releases/incoming-release-bins/gunbc_serve"

// A clean head observation decodes to Present, naming the exact head printed.
test fn witness_decode_head_present_names_the_head() -> Bool {
  match release_pair_decode_head(ProcessOutputPresent { text: head_hex as String }) {
    Present { value: v } => (v as String) == (head_hex as String)
    none => false
  }
}

// A failed git rev-parse is NOT a head: a refusal decodes to none (keep last good, do not even try to deliver).
test fn witness_decode_head_refused_is_none() -> Bool {
  match release_pair_decode_head(ProcessRefused { exit_code: 128, stderr: "fatal: not a git repository" }) {
    none => true
    Present { value: _ } => false
  }
}

// Discovery that COULD NOT RUN (ProcessRefused: auth expired / network / rate limit) is a DECLARED refusal, NOT a
// benign wait and NOT a fabricated run id — the timer must surface it (review 96216), so an expired gh token cannot
// make every tick exit green and silently stop tracking main. An exit-0 artifact query that printed nothing is an
// OBSERVED empty set (nothing built), which the selection turns into the benign wait below.
test fn witness_built_runs_refused_is_discovery_refused() -> Bool {
  let refused = match release_pair_decode_built_runs(outcome: ProcessRefused { exit_code: 1, stderr: "gh: auth expired" }) {
    BuiltRunsRefused { reason } => (reason as String) == (release_pair_run_discovery_refused_reason as String)
    BuiltRunsObserved { runs: _ } => false
  }
  let empty = match release_pair_decode_built_runs(outcome: ProcessOutputAbsent) {
    BuiltRunsObserved { runs } => length(xs: runs) == 0
    BuiltRunsRefused { reason: _ } => false
  }
  refused && empty
}

// An ancestry listing that could not be read, or printed nothing, refuses: the head itself must be listed.
test fn witness_ancestry_unobserved_refuses() -> Bool {
  let refused = match release_pair_decode_ancestry(outcome: ProcessRefused { exit_code: 1, stderr: "gh: 502" }) {
    AncestryRefused { reason } => (reason as String) == (release_pair_ancestry_unobserved_reason as String)
    AncestryObserved { shas: _ } => false
  }
  let empty = match release_pair_decode_ancestry(outcome: ProcessOutputPresent { text: "\n" }) {
    AncestryRefused { reason: _ } => true
    AncestryObserved { shas: _ } => false
  }
  refused && empty
}

// A fetched pack with an OBSERVED digest decodes to PackPresent naming the observed digest, dir and serve member.
test fn witness_pack_fetch_present_binds_observed_digest() -> Bool {
  let f = release_pair_pack_fetch(ProcessOutputAbsent, ProcessOutputPresent { text: sha_hex as String }, pack_dir_str, member_src_str)
  match f {
    PackPresent { sha256: d, pack_dir: pd, binary_source: bs } =>
      (d as String) == (sha_hex as String) && (pd as String) == pack_dir_str && (bs as String) == member_src_str
    PackAbsent { reason: _ } => false
  }
}

// A download that refused decodes to PackAbsent — the pair keeps serving, it is never delivered from a pack the host
// could not actually fetch.
test fn witness_pack_fetch_refused_is_absent() -> Bool {
  let f = release_pair_pack_fetch(ProcessRefused { exit_code: 1, stderr: "gh run download failed" }, ProcessOutputPresent { text: sha_hex as String }, pack_dir_str, member_src_str)
  match f {
    PackAbsent { reason: _ } => true
    PackPresent { sha256: _, pack_dir: _, binary_source: _ } => false
  }
}

// The `sha256sum` line "<hex>  <path>" binds the bare hex, NOT the whole line: the fold builds the member path from
// this digest, so a path-bearing digest would corrupt the placement. Proves the first-field extraction.
test fn witness_pack_fetch_binds_digest_from_sha256sum_line() -> Bool {
  let f = release_pair_pack_fetch(ProcessOutputAbsent, ProcessOutputPresent { text: sha_line_with_path }, pack_dir_str, member_src_str)
  match f {
    PackPresent { sha256: d, pack_dir: _, binary_source: _ } => (d as String) == (sha_hex as String)
    PackAbsent { reason: _ } => false
  }
}

// A digest line whose first field is not 64 lowercase hex is NOT a pack: the lower_hex_64 gate refuses it (red control
// for the digest binding — a corrupt or truncated digest can never authorize an install).
test fn witness_pack_fetch_rejects_non_hex_digest() -> Bool {
  let f = release_pair_pack_fetch(ProcessOutputAbsent, ProcessOutputPresent { text: "not-a-digest  /x" }, pack_dir_str, member_src_str)
  match f {
    PackAbsent { reason: _ } => true
    PackPresent { sha256: _, pack_dir: _, binary_source: _ } => false
  }
}

// The build-key check running clean is VerifiedOn the observed pack_dir.
test fn witness_pack_verify_clean_is_verified_on() -> Bool {
  match release_pair_pack_verify(ProcessOutputAbsent, pack_dir_str) {
    VerifiedOn { pack_dir: p } => (p as String) == pack_dir_str
    Refused { reason: _ } => false
  }
}

// The build-key check refusing is a named Refused, never VerifiedOn — fail closed.
test fn witness_pack_verify_refused_is_not_verified() -> Bool {
  match release_pair_pack_verify(ProcessRefused { exit_code: 1, stderr: "build key mismatch" }, pack_dir_str) {
    Refused { reason: _ } => true
    VerifiedOn { pack_dir: _ } => false
  }
}

// Serving-map witnesses. The OBSERVED bound tree revision must flow to the fold as RevisionBoundAtEmission
// carrying the same hex (via the single GitObjectId->hex authority), so keep-last-good protects the revision
// actually deployed. head_hex is the 40-hex sha1 fixture; git_object_id_from_untagged_hex/wire_hex round-trip it.
fn srv_surface() -> Fnv1a64Structural { Fnv1a64Structural { digest: "0123456789abcdef" as NonEmptyStr } }

test fn witness_serving_bound_carries_tree_revision_hex() -> Bool {
  match git_object_id_from_untagged_hex(hex: head_hex as String) {
    Absent => false
    Present { value: r } =>
      match release_pair_deliver_serving(ReleaseBoundToTree { revision: r, surface: srv_surface() }) {
        ServingMapped { binding: RevisionBoundAtEmission { revision: c } } => (c as String) == (head_hex as String)
        ServingMapped { binding: RevisionNotInstalled } => false
        ServingRefused { reason: _ } => false
      }
  }
}

// Unobserved binding is a REFUSAL in its own right (review 96348), never a usable binding and never a benign
// RevisionNotInstalled the fold would read as "proceed to a fresh fetch" (gunbc.design_argument::fail_closed).
test fn witness_serving_unobserved_is_poison() -> Bool {
  match release_pair_deliver_serving(ReleaseBindingUnobserved { cause: "no deployed tree" }) {
    ServingRefused { reason: why } => (why as String) == (release_pair_serving_poison_reason as String)
    ServingMapped { binding: _ } => false
  }
}

// A drifted (mixed) binding is likewise a REFUSAL: the bound arm must never be fabricated from a mixed tree.
// Discriminating control for the bound-arm mapping above.
test fn witness_serving_mixed_is_poison() -> Bool {
  match git_object_id_from_untagged_hex(hex: head_hex as String) {
    Absent => false
    Present { value: r } =>
      match release_pair_deliver_serving(ReleaseMixed { tree_revision: r, process_revision: "deadbeef" as CommitSha }) {
        ServingRefused { reason: _ } => true
        ServingMapped { binding: _ } => false
      }
  }
}

// The benign-vs-refusal split is NOT witnessed here: it moved to the typed DeliveryPlan arms
// (PlanWaits vs PlanKeepsLastGood) and is witnessed against the real producer release_pair_install_plan in
// release_pair_delivery_plan_witness, and the steady-state short-circuit is witnessed just below via the fold's pure
// release_pair_converged_noop route. The old string classifier this witness exercised is gone (review 96225).

// The built-run decode reads BOTH sides off each line: the run id (download target) and the run's head_sha (the
// binary-side observation). One line without the tab separator refuses the WHOLE observation (fail-closed), never
// drops it and selects among the rest.
test fn witness_built_runs_split_run_id_and_head_sha() -> Bool {
  let ok = match release_pair_decode_built_runs(outcome: ProcessOutputPresent { text: "44015305678\t1234567890abcdef1234567890abcdef12345678" }) {
    BuiltRunsObserved { runs } => match first(l: runs) {
      Present { value: r } => (r.run_id as String) == "44015305678" && (r.head_sha as String) == "1234567890abcdef1234567890abcdef12345678"
      Absent => false
    }
    BuiltRunsRefused { reason: _ } => false
  }
  let no_tab = match release_pair_decode_built_runs(outcome: ProcessOutputPresent { text: "44015305678\t1234567890abcdef1234567890abcdef12345678\n44015305679" }) {
    BuiltRunsRefused { reason } => (reason as String) == (release_pair_run_list_malformed_reason as String)
    BuiltRunsObserved { runs: _ } => false
  }
  if ok { no_tab } else { false }
}

// THE NEWEST BUILT ANCESTOR (gunbc.design_ruling::lab_tracks_main_lab_dev_retired_2026_11_22). Supplied values: a
// head H with no pack, its parent P1 with no pack, its grandparent P2 with a pack, and an older P3 with a pack.
data anc_head: String = "1111111111111111111111111111111111111111"
data anc_p1: String = "2222222222222222222222222222222222222222"
data anc_p2: String = "3333333333333333333333333333333333333333"
data anc_p3: String = "4444444444444444444444444444444444444444"
data anc_stranger: String = "5555555555555555555555555555555555555555"

fn anc_listing() -> ReleasePairAncestry {
  release_pair_decode_ancestry(outcome: ProcessOutputPresent { text: join([anc_head, anc_p1, anc_p2, anc_p3], "\n") })
}

fn anc_built(lines: List<String>) -> ReleasePairBuiltRuns {
  release_pair_decode_built_runs(outcome: ProcessOutputPresent { text: join(lines, "\n") })
}

fn anc_chosen(lookup: ReleasePairRunLookup) -> String {
  match lookup {
    RunLookupFound { run } => join([run.run_id as String, "@", run.head_sha as String], "")
    RunLookupNoBuiltAncestor => "none"
    RunLookupDiscoveryRefused { reason: _ } => "refused"
  }
}

// RED CONTROL 1: a head with no run, above an ancestor that has one, delivers that ancestor, and the NEWEST one:
// P2 is chosen over P3 even though P3's artifact is listed first (artifact order is not commit order).
test fn witness_head_without_a_run_delivers_the_newest_built_ancestor() -> Bool {
  let built = anc_built(lines: [join(["903\t", anc_p3], ""), join(["902\t", anc_p2], "")])
  anc_chosen(lookup: release_pair_select_built_ancestor(head: anc_head as NonEmptyStr, ancestry: anc_listing(), built: built))
    == join(["902@", anc_p2], "")
}

// RED CONTROL 2: no built ancestor in the window is the benign wait (PlanWaits upstream), not a delivery.
test fn witness_no_built_ancestor_waits() -> Bool {
  anc_chosen(lookup: release_pair_select_built_ancestor(head: anc_head as NonEmptyStr, ancestry: anc_listing(), built: anc_built(lines: [])))
    == "none"
}

// RED CONTROL 3 (never a non-ancestor): a pack built at a commit outside the head's ancestry is never chosen, even
// when it is the only pack; and an ancestry listing that does not start at the observed head refuses outright.
test fn witness_a_non_ancestor_is_never_delivered() -> Bool {
  let stranger_only = anc_chosen(lookup: release_pair_select_built_ancestor(
    head: anc_head as NonEmptyStr,
    ancestry: anc_listing(),
    built: anc_built(lines: [join(["905\t", anc_stranger], "")]),
  ))
  let wrong_tip = match release_pair_select_built_ancestor(
    head: anc_stranger as NonEmptyStr,
    ancestry: anc_listing(),
    built: anc_built(lines: [join(["902\t", anc_p2], "")]),
  ) {
    RunLookupDiscoveryRefused { reason } => (reason as String) == (release_pair_ancestry_not_at_head_reason as String)
    RunLookupFound { run: _ } => false
    RunLookupNoBuiltAncestor => false
  }
  stranger_only == "none" && wrong_tip
}

// The head itself is delivered when it is built (the exact-head case is the window's first entry).
test fn witness_a_built_head_is_delivered() -> Bool {
  let built = anc_built(lines: [join(["902\t", anc_p2], ""), join(["901\t", anc_head], "")])
  anc_chosen(lookup: release_pair_select_built_ancestor(head: anc_head as NonEmptyStr, ancestry: anc_listing(), built: built))
    == join(["901@", anc_head], "")
}

// RED CONTROL 4 (never an unverified pack): only the build job's literal conclusion "success" admits. A failed or
// cancelled job (a half-built pack) is NotSucceeded, and no conclusion or a failed read is Unobservable.
test fn witness_only_a_successful_build_job_admits() -> Bool {
  let ok = match release_pair_decode_build_job(outcome: ProcessOutputPresent { text: "success\n" }) {
    BuildJobSucceeded => true
    BuildJobNotSucceeded => false
    BuildJobUnobservable => false
  }
  let cancelled = match release_pair_decode_build_job(outcome: ProcessOutputPresent { text: "cancelled" }) {
    BuildJobNotSucceeded => true
    BuildJobSucceeded => false
    BuildJobUnobservable => false
  }
  let failed = match release_pair_decode_build_job(outcome: ProcessOutputPresent { text: "failure" }) {
    BuildJobNotSucceeded => true
    BuildJobSucceeded => false
    BuildJobUnobservable => false
  }
  let missing = match release_pair_decode_build_job(outcome: ProcessOutputAbsent) {
    BuildJobUnobservable => true
    BuildJobSucceeded => false
    BuildJobNotSucceeded => false
  }
  ok && cancelled && failed && missing
}


// STEADY-STATE SHORT-CIRCUIT (review 96219 / 96225): a SECOND tick on an ALREADY-CONVERGED pair returns the benign
// PlanWaits no-op and performs NO fetch. The serving binding is supplied the way the entry receives it —
// release_pair_deliver_serving over the serve gate's observed DeployedReleaseBinding (the real producer, through the
// GitObjectId->hex authority) — with the head equal to the placed revision. The ROUTE claim: the fold's pure
// release_pair_converged_noop returns Present(PlanWaits), so the entry takes the keep-serving no-op and never reaches
// the fetch legs. Flip converged_noop to always-Absent and this reddens (the tick would re-fetch the same revision).
test fn witness_converged_pair_short_circuits_to_waits() -> Bool {
  match git_object_id_from_untagged_hex(hex: head_hex as String) {
    Absent => false
    Present { value: r } =>
      match release_pair_deliver_serving(ReleaseBoundToTree { revision: r, surface: srv_surface() }) {
        ServingMapped { binding: serving } =>
          match release_pair_converged_noop(serving: serving, head: head_hex, reason: release_pair_already_at_head_reason) {
            Present { value: noop } => match noop {
              PlanWaits { kept: _, reason: _ } => true
              _ => false
            }
            none => false
          }
        ServingRefused { reason: _ } => false
      }
  }
}

// RED CONTROL for the short-circuit: it must not swallow the ticks that DO need to deliver. A placed tree on a
// DIFFERENT revision than the head, and a not-installed tree, both return none — the entry proceeds to the fetch.
// Widen converged_noop to always-Present and delivery silently stops tracking main forever; this reddens that.
test fn witness_diverged_or_uninstalled_pair_must_fetch() -> Bool {
  match git_object_id_from_untagged_hex(hex: head_hex as String) {
    Absent => false
    Present { value: a } =>
      match git_object_id_from_untagged_hex(hex: other_head_hex as String) {
        Absent => false
        Present { value: b } =>
          // Observed tree sits on b, the head to deploy is head_hex: NOT converged, so the fetch must run (none).
          match release_pair_deliver_serving(ReleaseBoundToTree { revision: b, surface: srv_surface() }) {
            ServingMapped { binding: serving } =>
              let diverged_proceeds = match release_pair_converged_noop(serving: serving, head: head_hex, reason: release_pair_already_at_head_reason) {
                none => true
                Present { value: _ } => false
              }
              let uninstalled_proceeds = match release_pair_converged_noop(serving: RevisionNotInstalled, head: head_hex, reason: release_pair_already_at_head_reason) {
                none => true
                Present { value: _ } => false
              }
              diverged_proceeds && uninstalled_proceeds
            ServingRefused { reason: _ } => false
          }
      }
  }
}

// ============================================================================
// SOURCE-SIDE F1 (item-2): the delivered source head is the head OBSERVED from a placed DELIVERY-CLONE tree
// (<base_root>/delivery-repo, fetched + worktree-added), NEVER the gh head query and never /opt/gunbc/gunbc. The pure
// verdict release_pair_source_head_verdict folds an observed DeployedTreeObservation against the requested head; the
// wiring turns a Refused verdict into PlanKeepsLastGood before anything installs. Positive + two RED controls below.
// ============================================================================

// Positive control: a placed tree whose observed revision equals the requested head is ACCEPTED and carries that
// revision into the source receipt (never the query value).
test fn witness_source_head_matches_requested() -> Bool {
  match git_object_id_from_untagged_hex(hex: head_hex as String) {
    Absent => false
    Present { value: r } =>
      match release_pair_source_head_verdict(
        observed: DeployedTreeObserved { revision: r, tree: r, content: DeployedScopeMatchesCommit },
        requested: head_hex as CommitSha,
      ) {
        SourceHeadObserved { revision: src } => (src as String) == (head_hex as String)
        SourceHeadRefused { reason: _ } => false
      }
  }
}

// RED CONTROL: a placed tree sitting on a DIFFERENT revision than the requested head refuses RED with the mismatch
// reason -- the source receipt can never name a head the placed delivery tree does not actually hold. Widen the
// verdict to trust the requested head (the pre-fix defect) and this reddens.
test fn witness_source_head_mismatch_refuses() -> Bool {
  match git_object_id_from_untagged_hex(hex: other_head_hex as String) {
    Absent => false
    Present { value: r } =>
      match release_pair_source_head_verdict(
        observed: DeployedTreeObserved { revision: r, tree: r, content: DeployedScopeMatchesCommit },
        requested: head_hex as CommitSha,
      ) {
        SourceHeadRefused { reason: reason } => (reason as String) == (release_pair_source_head_mismatch_reason as String)
        SourceHeadObserved { revision: _ } => false
      }
  }
}

// RED CONTROL: an UNOBSERVABLE placed tree (the observation leg could not be read over the fleet locus) refuses RED
// with the unobservable reason -- a missing reading is never mistaken for a matching head.
test fn witness_source_head_unobservable_refuses() -> Bool {
  match release_pair_source_head_verdict(
    observed: DeployedTreeUnobservable { cause: TreeCommandFailed { leg: "revision", exit_code: 128, stderr: "fatal: not a git repository" } },
    requested: head_hex as CommitSha,
  ) {
    SourceHeadRefused { reason: reason } => (reason as String) == (release_pair_source_head_unobservable_reason as String)
    SourceHeadObserved { revision: _ } => false
  }
}

// ============================================================================
// IDEMPOTENT PLACEMENT (review 96353): the actuator observes the target source tree at the per-revision locus BEFORE
// adding, so a re-run after a later-leg failure REUSES an already-correct placement, a tree at another head is REFUSED
// (never silently clobbered), an absent tree is ADDED, and an unseeded delivery clone REFUSES with its own reason
// (seeding is a deploy step under the operator gate -- never bootstrapped here). Every condition is its own variant +
// reason; 'unobservable' belongs only to the observe step (release_pair_source_head_verdict), never to placement.
// ============================================================================

// RED CONTROL: an unseeded delivery clone refuses with its own typed reason, even if a tree at the right head were
// (impossibly) observed -- a missing placement origin can never be mistaken for a deliverable source. Reuses the reason
// the decision builds from the same inputs so the assertion is exact without a string predicate.
test fn witness_delivery_clone_missing_refuses() -> Bool {
  match git_object_id_from_untagged_hex(hex: head_hex as String) {
    Absent => false
    Present { value: r } =>
      match release_pair_source_placement_decision(
        clone_present: false,
        clone_path: "/srv/pair/delivery-repo",
        pre_observed: DeployedTreeObserved { revision: r, tree: r, content: DeployedScopeMatchesCommit },
        requested: head_hex as CommitSha,
      ) {
        PlacementCloneMissing { reason: reason } =>
          (reason as String) == (join([release_pair_delivery_clone_missing_prefix as String, "/srv/pair/delivery-repo"], "") as String)
        PlacementReuse { revision: _ } => false
        PlacementPresentAtOtherHead { reason: _ } => false
        PlacementAdd => false
      }
  }
}

// Positive control: a placed tree already at the requested head is REUSED (no add), carrying that head into the receipt.
test fn witness_source_placement_present_match_reuses() -> Bool {
  match git_object_id_from_untagged_hex(hex: head_hex as String) {
    Absent => false
    Present { value: r } =>
      match release_pair_source_placement_decision(
        clone_present: true,
        clone_path: "/srv/pair/delivery-repo",
        pre_observed: DeployedTreeObserved { revision: r, tree: r, content: DeployedScopeMatchesCommit },
        requested: head_hex as CommitSha,
      ) {
        PlacementReuse { revision: src } => (src as String) == (head_hex as String)
        PlacementCloneMissing { reason: _ } => false
        PlacementPresentAtOtherHead { reason: _ } => false
        PlacementAdd => false
      }
  }
}

// RED CONTROL: a placed tree at a DIFFERENT head is REFUSED (never removed or overwritten silently), with a reason naming
// the actual head and the requested one. Reconstructs the decision's own reason string for an exact assertion.
test fn witness_source_placement_present_other_head_refuses() -> Bool {
  match git_object_id_from_untagged_hex(hex: other_head_hex as String) {
    Absent => false
    Present { value: r } =>
      match release_pair_source_placement_decision(
        clone_present: true,
        clone_path: "/srv/pair/delivery-repo",
        pre_observed: DeployedTreeObserved { revision: r, tree: r, content: DeployedScopeMatchesCommit },
        requested: head_hex as CommitSha,
      ) {
        PlacementPresentAtOtherHead { reason: reason } =>
          (reason as String) == (join([release_pair_source_placed_at_other_head_prefix as String, other_head_hex as String, ", not ", head_hex as String], "") as String)
        PlacementReuse { revision: _ } => false
        PlacementCloneMissing { reason: _ } => false
        PlacementAdd => false
      }
  }
}

// Positive control: an absent placed tree (the pre-observation could not read it) routes to PlacementAdd -- the actuator
// will fetch + worktree-add, and the observe step then validates the result.
test fn witness_source_placement_absent_adds() -> Bool {
  match release_pair_source_placement_decision(
    clone_present: true,
    clone_path: "/srv/pair/delivery-repo",
    pre_observed: DeployedTreeUnobservable { cause: TreeCommandFailed { leg: "revision", exit_code: 128, stderr: "fatal: not a git repository" } },
    requested: head_hex as CommitSha,
  ) {
    PlacementAdd => true
    PlacementReuse { revision: _ } => false
    PlacementPresentAtOtherHead { reason: _ } => false
    PlacementCloneMissing { reason: _ } => false
  }
}

// Idempotency: after a later-leg failure, a re-run observes the SAME already-placed tree and must reach the SAME
// PlacementReuse -- never a refusal and never a re-add. Two identical calls must both reuse the requested head.
test fn witness_source_placement_rerun_is_idempotent() -> Bool {
  match git_object_id_from_untagged_hex(hex: head_hex as String) {
    Absent => false
    Present { value: r } =>
      let first = release_pair_source_placement_decision(
        clone_present: true,
        clone_path: "/srv/pair/delivery-repo",
        pre_observed: DeployedTreeObserved { revision: r, tree: r, content: DeployedScopeMatchesCommit },
        requested: head_hex as CommitSha,
      )
      let second = release_pair_source_placement_decision(
        clone_present: true,
        clone_path: "/srv/pair/delivery-repo",
        pre_observed: DeployedTreeObserved { revision: r, tree: r, content: DeployedScopeMatchesCommit },
        requested: head_hex as CommitSha,
      )
      match first {
        PlacementReuse { revision: a } => match second {
          PlacementReuse { revision: b } => (a as String) == (b as String)
          _ => false
        }
        _ => false
      }
  }
}

// ============================================================================
// FAIL-CLOSED PLACEMENT ACTIONS (review 96360): the clone-probe has NO wildcard success (only ProcessOutputPresent is
// "seeded"); a REFUSED fetch or worktree-add refuses with its OWN typed reason, never collapsing into the observe step's
// 'unobservable' or a misleading 'tree at another head'. Each is witnessed over all three ProcessOutcome variants.
// ============================================================================

// RED CONTROL: the delivery clone counts as present ONLY on ProcessOutputPresent (the probe printed a head). The old
// wildcard success made ProcessOutputAbsent / ProcessRefused read as "seeded" and route to a fetch; both must read NOT
// present so the decision emits PlacementCloneMissing ("delivery clone not seeded / not readable at <path>").
test fn witness_delivery_clone_present_requires_output() -> Bool {
  let present = release_pair_delivery_clone_present(outcome: ProcessRan { observation: process_observation(exit_code: 0, stdout: head_hex as String, stderr: "") })
  let absent_is_present = release_pair_delivery_clone_present(outcome: ProcessRan { observation: process_observation(exit_code: 0, stdout: "", stderr: "") })
  let refused_is_present = release_pair_delivery_clone_present(outcome: ProcessRan { observation: process_observation(exit_code: 128, stdout: "", stderr: "fatal: not a git repository") })
  let not_spawned_is_present = release_pair_delivery_clone_present(outcome: ProcessNotSpawned { program: "git" as NonEmptyStr, cause: "git route wall: refusing ambient-repository mutation" as NonEmptyStr })
  present && (!absent_is_present) && (!refused_is_present) && (!not_spawned_is_present)
}

// RED CONTROL: a refused clone-side FETCH refuses with its own reason naming the revision and the command's stderr; exit-0
// (stdout present OR absent -- git fetch writes progress to stderr) is placement progress, not a refusal.
test fn witness_source_fetch_refused_reason_is_own() -> Bool {
  let refused = match release_pair_source_fetch_verdict(
    outcome: ProcessRan { observation: process_observation(exit_code: 128, stdout: "", stderr: "fatal: couldn't find remote ref") },
    rev: head_hex as String,
  ) {
    ActionRefused { reason: r } => (r as String) == (join(["fetch of ", head_hex as String, " refused: ", "fatal: couldn't find remote ref"], "") as String)
    ActionPlaced => false
  }
  let ok_present = match release_pair_source_fetch_verdict(outcome: ProcessRan { observation: process_observation(exit_code: 0, stdout: "ok", stderr: "") }, rev: head_hex as String) {
    ActionPlaced => true
    ActionRefused { reason: _ } => false
  }
  let ok_absent = match release_pair_source_fetch_verdict(outcome: ProcessRan { observation: process_observation(exit_code: 0, stdout: "", stderr: "") }, rev: head_hex as String) {
    ActionPlaced => true
    ActionRefused { reason: _ } => false
  }
  let not_spawned_refuses = match release_pair_source_fetch_verdict(outcome: ProcessNotSpawned { program: "git" as NonEmptyStr, cause: "git route wall" as NonEmptyStr }, rev: head_hex as String) {
    ActionRefused { reason: r } => string_contains(s: r as String, pattern: "not spawned")
    ActionPlaced => false
  }
  refused && ok_present && ok_absent && not_spawned_refuses
}

// RED CONTROL: a refused WORKTREE-ADD refuses with its own reason naming the command's stderr (distinct from fetch and from
// 'unobservable'); exit-0 (stdout present OR absent) is placement progress. A silent discard would surface the failure later
// as a misleading 'tree at another head'.
test fn witness_source_add_refused_reason_is_own() -> Bool {
  let refused = match release_pair_source_add_verdict(
    outcome: ProcessRan { observation: process_observation(exit_code: 128, stdout: "", stderr: "fatal: already registered") },
  ) {
    ActionRefused { reason: r } => (r as String) == (join(["worktree add refused: ", "fatal: already registered"], "") as String)
    ActionPlaced => false
  }
  let ok_present = match release_pair_source_add_verdict(outcome: ProcessRan { observation: process_observation(exit_code: 0, stdout: "ok", stderr: "") }) {
    ActionPlaced => true
    ActionRefused { reason: _ } => false
  }
  let ok_absent = match release_pair_source_add_verdict(outcome: ProcessRan { observation: process_observation(exit_code: 0, stdout: "", stderr: "") }) {
    ActionPlaced => true
    ActionRefused { reason: _ } => false
  }
  let not_spawned_refuses = match release_pair_source_add_verdict(outcome: ProcessNotSpawned { program: "git" as NonEmptyStr, cause: "git route wall" as NonEmptyStr }) {
    ActionRefused { reason: r } => string_contains(s: r as String, pattern: "not spawned")
    ActionPlaced => false
  }
  refused && ok_present && ok_absent && not_spawned_refuses
}
