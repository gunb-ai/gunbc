module test.claim.live_deploy.pre_swap_admission_merge_base_inhabitance_witness

import std.types { Bool, String, Int, NonEmptyStr, GitRef, FilePath }
import std.algebra { trim }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import gunbc.output_policy { OutcomeIsData }
import gunbc.retained_shell_script { retained_runtime }
import gunbc.live_deploy.desired { production_admitted_branch }
import gunbc.live_deploy.pre_swap_admission {
  checkout_branch_for_admission,
  DetachedHeadOnAdmittedBranch,
  DetachedHeadNotOnAdmittedBranch,
  CheckoutNamedBranch,
}
import extdeps.git
import extdeps.git.inspect { merge_base_outcome, MergeBaseOutcome }
import extdeps.shell

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data real_execution_home_doc: String = "Inhabitance for gunbc.live_deploy.pre_swap_admission checkout_branch_for_admission: git.Inspect.MergeBase over a real throwaway repository emits MergeBaseOutcome, and the admission fold consumes that shape. Hermetic discovery has no mock_response for MergeBase or Mktemp; this file is LocalRepoWetLane."

type AncestryScratch {
  root: String
  on_main: String
  off_main: String
}

fn line_at(raw: String, index: Int) -> String {
  fold(
    split(s: raw, delimiter: "\n"),
    init: LineScan { at: 0, found: "" },
    f: (acc, l) => LineScan { at: acc.at + 1, found: if acc.at == index { trim(s: l) } else { acc.found } },
  ).found
}

type LineScan {
  at: Int
  found: String
}

fn ancestry_scratch() -> AncestryScratch? {
  let result = shell.Exec.Run(
    script: retained_runtime(
      body: join([
        "set -eu",
        "root=$(mktemp -d)",
        "on=$root/on",
        "off=$root/off",
        "git init -q -b main \"$on\"",
        "git -C \"$on\" config user.email witness@example.invalid",
        "git -C \"$on\" config user.name witness",
        "printf on-main > \"$on/tracked\"",
        "git -C \"$on\" add tracked",
        "git -C \"$on\" commit -qm on-main",
        "git -C \"$on\" update-ref refs/remotes/origin/main HEAD",
        "git -C \"$on\" checkout -q --detach HEAD",
        "cp -a \"$on\" \"$off\"",
        "printf off-main > \"$off/tracked\"",
        "git -C \"$off\" add tracked",
        "git -C \"$off\" commit -qm off-main",
        "printf '%s\\n%s\\n%s\\n' \"$root\" \"$on\" \"$off\"",
      ], "\n"),
      reason: "detached-HEAD merge-base inhabitance fixture" as NonEmptyStr,
    ),
    expect: OutcomeIsData,
  )
  if result.success {
    Present { value: AncestryScratch {
      root: line_at(raw: result.stdout, index: 0),
      on_main: line_at(raw: result.stdout, index: 1),
      off_main: line_at(raw: result.stdout, index: 2),
    } }
  } else { none }
}

fn merge_base_standing(repo: String) -> MergeBaseProbe {
  let head = git.Core.RevParseInRepo(repo: repo as FilePath, target: "HEAD" as GitRef)
  let probe = git.Inspect.MergeBase(
    repository_path: repo,
    left: "HEAD" as GitRef,
    right: "refs/remotes/origin/main" as GitRef,
    expect: OutcomeIsData,
  )
  MergeBaseProbe {
    head: trim(s: head.revision),
    outcome: merge_base_outcome(exit_code: probe.exit_code, stdout: probe.sha as String, stderr: probe.stderr),
  }
}

type MergeBaseProbe {
  head: String
  outcome: MergeBaseOutcome
}

test fn git_merge_base_in_a_temp_repo_emits_the_standing_admission_consumes() -> Bool {
  match ancestry_scratch() {
    Absent => false
    Present { value: s } => {
      let on = merge_base_standing(repo: s.on_main)
      let off = merge_base_standing(repo: s.off_main)
      let cleaned = shell.Exec.Run(
        script: retained_runtime(
          body: join(["set -eu", concat("rm -rf ", s.root)], "\n"),
          reason: "detached-HEAD merge-base inhabitance cleanup" as NonEmptyStr,
        ),
        expect: OutcomeIsData,
      ).success
      let on_ok = match checkout_branch_for_admission(
        named: "HEAD",
        admitted: production_admitted_branch,
        head: on.head,
        outcome: on.outcome,
      ) {
        DetachedHeadOnAdmittedBranch { head, branch } =>
          head == on.head && branch == (production_admitted_branch as String)
        CheckoutNamedBranch { branch: _ } => false
        DetachedHeadNotOnAdmittedBranch { head: _, branch: _, cause: _ } => false
      }
      let off_ok = match checkout_branch_for_admission(
        named: "HEAD",
        admitted: production_admitted_branch,
        head: off.head,
        outcome: off.outcome,
      ) {
        DetachedHeadNotOnAdmittedBranch { cause } =>
          string_contains(s: cause, pattern: "DetachedHeadNotOnAdmittedBranch")
        CheckoutNamedBranch { branch: _ } => false
        DetachedHeadOnAdmittedBranch { head: _, branch: _ } => false
      }
      cleaned && on_ok && off_ok
    }
  }
}
