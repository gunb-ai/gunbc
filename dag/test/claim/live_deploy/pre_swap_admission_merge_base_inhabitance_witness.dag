module test.claim.live_deploy.pre_swap_admission_merge_base_inhabitance_witness

import std.types { Bool, String, GitRef, FilePath }
import std.algebra { trim }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import gunbc.output_policy { OutcomeIsData }
import gunbc.live_deploy.desired { production_admitted_branch }
import gunbc.live_deploy.pre_swap_admission {
  checkout_branch_for_admission,
  DetachedHeadOnAdmittedBranch,
  DetachedHeadNotOnAdmittedBranch,
  CheckoutNamedBranch,
}
import extdeps.git
import extdeps.git.inspect { merge_base_outcome, MergeBaseOutcome }
import extdeps.shell
import extdeps.shell.exec
import extdeps.filesystem.filesystem_io

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data real_execution_home_doc: String = "Inhabitance for gunbc.live_deploy.pre_swap_admission checkout_branch_for_admission: git.Inspect.MergeBase over a real throwaway repository emits MergeBaseOutcome, and the admission fold consumes that shape. Hermetic discovery has no mock_response for MergeBase or Mktemp; this file is LocalRepoWetLane."

type AncestryScratch {
  root: String
  on_main: String
  off_main: String
}

fn ancestry_scratch() -> AncestryScratch? {
  let dir = shell.Mktemp.Dir()
  let root = dir.path as String
  let on = concat(root, "/on")
  let off = concat(root, "/off")
  let init = shell.Exec.RunArgv(program: "git", arguments: ["init", "-q", "-b", "main", on])
  let email = git.Core.ConfigLocalSetInRepo(repo: on as FilePath, key: "user.email", value: "witness@example.invalid")
  let name = git.Core.ConfigLocalSetInRepo(repo: on as FilePath, key: "user.name", value: "witness")
  let wrote_on = Filesystem.Write(path: concat(on, "/tracked"), content: "on-main")
  let added_on = git.Core.AddAllInRepo(repo: on as FilePath)
  let committed_on = git.Core.CommitInRepo(repo: on as FilePath, message: "on-main")
  let tracked_ref = shell.Exec.RunArgv(program: "git", arguments: ["-C", on, "update-ref", "refs/remotes/origin/main", "HEAD"])
  let detached = shell.Exec.RunArgv(program: "git", arguments: ["-C", on, "checkout", "-q", "--detach", "HEAD"])
  let copied = shell.Exec.RunArgv(program: "cp", arguments: ["-a", on, off])
  let wrote_off = Filesystem.Write(path: concat(off, "/tracked"), content: "off-main")
  let added_off = git.Core.AddAllInRepo(repo: off as FilePath)
  let committed_off = git.Core.CommitInRepo(repo: off as FilePath, message: "off-main")
  if dir.success && init.exit_code == 0 && email.success && name.success && wrote_on.success && added_on.exit_code == 0 && committed_on.exit_code == 0 && tracked_ref.exit_code == 0 && detached.exit_code == 0 && copied.exit_code == 0 && wrote_off.success && added_off.exit_code == 0 && committed_off.exit_code == 0 {
    Present { value: AncestryScratch { root: root, on_main: on, off_main: off } }
  } else { none }
}

fn merge_base_standing(repo: String) -> MergeBaseProbe {
  let head = git.Core.RevParseInRepo(repo: repo as FilePath, target: "HEAD" as GitRef)
  let probe = git.Inspect.MergeBase(
    repository_path: repo,
    left: "HEAD" as GitRef,
    right: "refs/remotes/origin/main" as GitRef,
    expect: OutcomeIsData,
  )
  MergeBaseProbe {
    head: trim(s: head.revision),
    outcome: merge_base_outcome(exit_code: probe.exit_code, stdout: probe.sha as String, stderr: probe.stderr),
  }
}

type MergeBaseProbe {
  head: String
  outcome: MergeBaseOutcome
}

test fn git_merge_base_in_a_temp_repo_emits_the_standing_admission_consumes() -> Bool {
  match ancestry_scratch() {
    Absent => false
    Present { value: s } => {
      let on = merge_base_standing(repo: s.on_main)
      let off = merge_base_standing(repo: s.off_main)
      let cleaned = shell.Remove.RecursiveForce(path: s.root as FilePath).success
      let on_ok = match checkout_branch_for_admission(
        named: "HEAD",
        admitted: production_admitted_branch,
        head: on.head,
        outcome: on.outcome,
      ) {
        DetachedHeadOnAdmittedBranch { head, branch } =>
          head == on.head && branch == (production_admitted_branch as String)
        CheckoutNamedBranch { branch: _ } => false
        DetachedHeadNotOnAdmittedBranch { head: _, branch: _, cause: _ } => false
      }
      let off_ok = match checkout_branch_for_admission(
        named: "HEAD",
        admitted: production_admitted_branch,
        head: off.head,
        outcome: off.outcome,
      ) {
        DetachedHeadNotOnAdmittedBranch { cause } =>
          string_contains(s: cause, pattern: "DetachedHeadNotOnAdmittedBranch")
        CheckoutNamedBranch { branch: _ } => false
        DetachedHeadOnAdmittedBranch { head: _, branch: _ } => false
      }
      cleaned && on_ok && off_ok
    }
  }
}
