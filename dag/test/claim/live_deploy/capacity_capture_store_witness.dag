module test.claim.live_deploy.capacity_capture_store_witness

import std.types { Bool, NonEmptyStr, String }
import std.error_primitives { Result, Ok, Err }
import std.optional { Present, Absent }
import std.scoped_authorization { AttemptIdentity }
import std.materialization_provider { CutoverCaptureRequest }
import std.content_hash { sha256_hex_digest }
import std.fabric_blob { read_staged_fabric_blob, FabricBlobRead, FabricBlobReadRefused }
import extdeps.access.posix { FilePermissions, FileOwnership, file_mode_of_octal_text }
import gunbc.runner.runner_microvm_cell_readiness { StoreRootOwned }
import gunbc.runner.runner_microvm_cell_readiness_store { OwnershipRead }
import gunbc.live_deploy.capacity_capture_store { CapacityCaptureStore, CapturedUnitBlob, capacity_capture_store_admit, capacity_capture_blob_path, capacity_capture_blob_admit }

fn capture_fixture_store(mode: String) -> Result<CapacityCaptureStore, String> {
  match file_mode_of_octal_text(text: mode) {
    Absent => Err { value: "fixture mode malformed" }
    Present { value: bits } => capacity_capture_store_admit(attempt: "fixture-cutover" as NonEmptyStr as AttemptIdentity,
      ownership: OwnershipRead { ownership: StoreRootOwned },
      permissions: Ok { value: FilePermissions { ownership: FileOwnership { uid: 0, gid: 0 }, mode: bits } })
  }
}

// Hermetic blob handlers supply the empty digest/size. No root directory or file
// is created by this witness; the production provider is separately owed.
fn capture_fixture_blob() -> Result<CapturedUnitBlob, String> {
  match capture_fixture_store(mode: "700") {
    Err { value: why } => Err { value: why }
    Ok { value: store } => match sha256_hex_digest(hex: "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855") {
      Absent => Err { value: "fixture digest malformed" }
      Present { value: digest } => {
        let request = CutoverCaptureRequest { host: "srv1", source_unit: "/etc/systemd/system/fixture.service", digest: digest }
        match capacity_capture_blob_path(store: store, request: request) {
          Err { value: why } => Err { value: why }
          Ok { value: path } => match read_staged_fabric_blob(path: path) {
        FabricBlobReadRefused { fault: _ } => Err { value: "fixture blob reading unavailable" }
        FabricBlobRead { reading: reading } => capacity_capture_blob_admit(store: store, request: request, reading: reading)
      }
      } }
    }
  }
}

test fn root_private_capture_store_is_admitted() -> Bool {
  match capture_fixture_store(mode: "700") {
    Ok { value: store } => store.root == "/var/lib/gunbc/cutover-capture/fixture-cutover"
    Err { value: _ } => false
  }
}

test fn root_owned_but_publicly_readable_is_not_the_capture_store() -> Bool {
  match capture_fixture_store(mode: "755") {
    Err { value: why } => why == "cutover capture root must be root:root mode 0700"
    Ok { value: _ } => false
  }
}

test fn an_unprivileged_staging_blob_cannot_become_a_captured_unit() -> Bool {
  match capture_fixture_store(mode: "700") {
    Err { value: _ } => false
    Ok { value: store } => match read_staged_fabric_blob(path: "dag/test/fixture/fabric_blob/empty.bin") {
      FabricBlobReadRefused { fault: _ } => false
      FabricBlobRead { reading: reading } => match capacity_capture_blob_admit(store: store, request: CutoverCaptureRequest { host: "srv1", source_unit: "/etc/systemd/system/fixture.service", digest: reading.digest }, reading: reading) {
        Err { value: why } => why == "unit blob is outside the admitted provider part address"
        Ok { value: _ } => false
      }
    }
  }
}
