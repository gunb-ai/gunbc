module test.claim.live_deploy.apply_emission_projection
import std.types { String, List }
import std.measure { Second }
import gunbc.live_deploy.spec { DeploymentSpec, DeploymentStep }
import gunbc.live_deploy.member_identity { ReleaseEffectPlan }
import extdeps.git.partial_clone { ObjectSourceCanServe, ObjectSourceServeAdmission }
import gunbc.ci.ci_deploy_access { ci_deploy_srv1_access }
import gunbc.auth.tracker_web_oauth_client { tracker_web_test_console_readback_observed_at_epoch }
import gunbc.membership_reconcile { MemberEffect, EffectAdd, EffectReplace, EffectRemove }
import v2.std.orchestration {
  Do, Run, PipelineStep, Comment, Exit, If, For, While, Retry, Let,
  Pipeline, Predicate, ExitZero, LogMatches, StrEq, StrEmpty, StrNonempty, IntNe, Not, And, Or,
  ValueSource, CmdSubstLines, Glob, ModeledList, Expr, ExprLit, ExprVarRef, ExprCmdSubst,
}
import std.optional { Present, Absent }

// THE APPLY'S OWN STEP EMISSION, WITH THE HOST OBSERVATION MOCKED AND NOTHING ELSE CHANGED.
//
// WHY THIS MODULE EXISTS AT ALL, stated first because a projection module beside a fixture module
// is the shape a reviewer should be suspicious of. Two witness modules assert on what the deploy
// apply emits -- test.claim.live_deploy.emit and test.claim.shell_exec_run_argv_embed_witness --
// and both did it by rendering `live_deploy_apply_script_for` and grepping the result. Measured on
// the required floor (run 34888954422, artifact required-floor-claim-cost) one render is ~194,000
// eval steps against a per-claim ceiling of 72,300, and the fixed half of that cost is BELOW the
// emitter: the same fold over a plan that publishes nothing still reads 148,139, because
// `apply_intent_from_effects` reconciles membership against `deployment_apply_plan` regardless of
// the plan it is handed. So no witness can afford the assembled program even once, and the
// alternative to one shared projection is the same fold copied into two files.
//
// WHAT IS MOCKED IS EXACTLY ONE INPUT: the membership effects, which in production come from
// observing the host. Everything downstream is the production compose path -- this calls
// `compose_host_script_mutate_steps(apply_intent_fragments(...))`, the mutate half of the same
// fragments `apply_intent_from_effects` hands to `compose_host_script`. A per-step
// `apply_step_effects` flat-map is not that path: compose drops every Mutate when any Decide is
// HostScriptRefused, and the flat-map would keep sibling mutates. That distinction is the whole
// reason this module is shaped the way it is, and the first version of it got the shape wrong: it
// folded `emit_artifact_upsert` over every step, which is the producer for the artifacts
// `identity_member_of_step` answers `none` for -- the belt units, the tailscale mapping, the
// converge timer. For GunbcSourceTree, ServeBinary and SystemdUnit the apply goes through
// `emit_release_member_effects` instead, so three of the claims below would have been asserting on
// a producer their subject does not use, and they would have PASSED, because the two arms emit
// similar text. Green over the wrong producer is worse than red, and it is the exact substitution
// this repository's failure-mode list names.
//
// WHAT THE MOCK ASSERTS, so that it is a stated fixture rather than a convenient value: an EMPTY
// HOST. Every step is an addition, which is what the reconcile derives against a machine that holds
// none of them, and is the condition the emit witnesses have always described themselves as
// pinning ("the complete installation of an empty host"). Steps whose member is an identity member
// never consult this list at all -- `apply_step_fragments` routes those to the plan instead -- so
// the rows for them are inert rather than wrong; the rows that are READ are the ones for the
// directory roots and for every artifact the reconcile actually owns.
//
// WHAT IS NOT CARRIED is the Decide half of the frame (shell options, generated-by comments).
// Compose-mutate does carry Mutate frame, preamble, owned-directory, withheld-cap report, helper
// grant and receipt, because those ride the same drop as spec-step mutates. Access is the CI apply
// constant (`ci_deploy_srv1_access`) so the projection does not invent a second authorization; the
// cap authorization left with the instance apply's cap family (2026-10-30).
fn apply_empty_host_effects(spec: DeploymentSpec) -> List<MemberEffect<DeploymentStep>> {
  map(spec.steps, st => EffectAdd { to: st })
}

// THE FOLD IS TOTAL OVER `PipelineStep` AND DESCENDS, AND THE FIRST VERSION WAS NEITHER.
//
// It read `Do { run: r } => concat(acc, r.command)` with a `_ => acc` wildcard, which compiles, is
// exhaustive over the type, and DISCARDS THE PAYLOAD -- DESIGN's "total at the level examined,
// blind one level down", with the bare wildcard as the tell. What it dropped is not hypothetical:
// `ensure_apt_package_step` is an `If { cond: Not { inner: ExitZero { run } }, then_, else_ }`, so
// every dependency the deployment ensures was invisible. The projection of the production spec
// contained no `dpkg`, no `apt-get` and no `tmux` at all.
//
// THE FAILURE MODE THAT MAKES THIS WORTH SPELLING OUT IS NOT THE MISSING PRESENCE CLAIM -- that one
// went red and said so. It is the ABSENCE claims: `!string_contains(projection, X)` passes
// vacuously for any X the fold cannot see, so a fold with a wildcard turns every negative conjunct
// into a decoration. Both directions are fixed by the same move, which is to have no wildcard.
//
// SERIALIZING THROUGH THE REAL BASH EMITTER WOULD ALSO FIX IT AND IS NOT AFFORDABLE. Measured
// across the two plans on required floor run 34907066707: the step construction for the extra
// members costs ~14k eval steps and their serialization ~32k, so emitting the whole step list
// projects well past the 72,300 ceiling this module exists to fit under. The fold recovers the
// COMMAND TEXT rather than the bash rendering: what a claim can assert on is every command,
// predicate, binder and argument the steps carry, in order, without the grammar between them.
fn predicate_text(p: Predicate) -> String {
  match p {
    ExitZero { run: r } => r.command
    LogMatches { source: src, pattern: pat } => concat(src, pat)
    StrEq { lhs: a, rhs: b } => concat(a, b)
    StrEmpty { operand: o } => o
    StrNonempty { operand: o } => o
    IntNe { lhs: a, rhs: b } => concat(a, b)
    Not { inner: i } => predicate_text(p: i)
    And { lhs: a, rhs: b } => concat(predicate_text(p: a), predicate_text(p: b))
    Or { lhs: a, rhs: b } => concat(predicate_text(p: a), predicate_text(p: b))
  }
}

fn value_source_text(v: ValueSource) -> String {
  match v {
    CmdSubstLines { run: r } => r.command
    Glob { pattern: pat } => pat
    ModeledList { items: xs } => fold(xs, init: "", f: (acc, x) => concat(acc, x))
  }
}

fn expr_text(e: Expr) -> String {
  match e {
    ExprLit { spelling: sp } => sp
    ExprVarRef { name: n } => n
    ExprCmdSubst { callee: c, args: a } => concat(c, fold(a, init: "", f: (acc, x) => concat(acc, x)))
  }
}

fn pipeline_step_text(st: PipelineStep) -> String {
  match st {
    Do { run: r } => r.command
    Comment { text: t } => t
    Exit { status: st2 } => st2
    Let { name: n, value: v } => concat(n, expr_text(e: v))
    If { cond: c, then_: t, else_: e } => concat(
      predicate_text(p: c),
      concat(
        pipeline_text(p: t),
        match e {
          Present { value: pe } => pipeline_text(p: pe)
          Absent => ""
        },
      ),
    )
    For { binder: _, over: o, body: bd } => concat(value_source_text(v: o), pipeline_text(p: bd))
    While { cond: c, body: bd } => concat(predicate_text(p: c), pipeline_text(p: bd))
    Retry { body: bd, escalations: _, on_exhausted: oe } =>
      concat(pipeline_text(p: bd), pipeline_text(p: oe))
  }
}

fn pipeline_text(p: Pipeline) -> String {
  fold(p.steps, init: "", f: (acc, st) => concat(acc, pipeline_step_text(st: st)))
}

fn pipeline_steps_text(steps: List<PipelineStep>) -> String {
  fold(steps, init: "", f: (acc, st) => concat(acc, pipeline_step_text(st: st)))
}

fn claim_oidc_now() -> Second? {
  tracker_web_test_console_readback_observed_at_epoch
}

fn apply_complete_object_source_serve() -> ObjectSourceServeAdmission {
  ObjectSourceCanServe { source: "/home/ghrunner/work/gunbc/gunbc" }
}
