module test.claim.live_deploy.intent


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

test fn witness_readback_requires_service_ready_gate() -> Bool {
  let rb = gunbc.live_deploy.intent.live_deploy_readback_for_spec(spec: gunbc.live_deploy.spec.deployment_spec_srv1())
  std.measure.second_count(s: rb.after.timeout) == 120
    && rb.after.probe.health_url == gunbc.live_deploy.intent.live_deploy_health_url_for_port(port: 8080)
}

test fn witness_health_url_is_localhost_on_srv1() -> Bool {
  let url = gunbc.live_deploy.intent.live_deploy_health_url_for_port(port: 8080)
  starts_with(s: url as String, prefix: "http://127.0.0.1:8080")
    && ends_with(s: url as String, suffix: gunbc.roadmap_site_surface_render.roadmap_site_health_path)
}

test fn witness_service_ready_gate_is_required_on_readback() -> Bool {
  let gate = gunbc.live_deploy.intent.live_deploy_service_ready_gate_for_spec(spec: gunbc.live_deploy.spec.deployment_spec_srv1())
  gate.probe.health_url == gunbc.live_deploy.intent.live_deploy_health_url_for_port(port: 8080)
}

test fn witness_dependency_graph_emit_frontier_binds_orch_emit_pipeline() -> Bool {
  match gunbc.live_deploy.emit.live_deploy_intent_dependency_graph_emit_dissolution_trigger {
    std.disposition.Scaffold {
      dissolves_to: std.disposition.RealizationDispatch,
      bind: std.decl_ref.DeclarationRef { module_path: m, decl_name: n, field: std.decl_ref.WholeDeclaration },
    } =>
      m == "v2.compiler.emit_orchestration" && n == "orch_emit_pipeline"
    std.disposition.Terminal { reason: _ } => false
  }
}

