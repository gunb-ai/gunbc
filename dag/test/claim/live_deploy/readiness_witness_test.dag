module test.claim.live_deploy.readiness

import gunbc.live_deploy.readiness {
  DeploymentStepKey,
  DeploymentReadinessEdge,
  StepEnsuredTailscale,
  StepEnsuredNodeJs,
  StepOwnedServerScript,
  StepOwnedSystemdUnit,
  StepOwnedTailscaleServe,
  StepDeployReadback,
  deployment_readiness_edges,
  deployment_readiness_apply_order,
  deployment_readiness_order_valid,
  deployment_step_key_for_ensured,
  deployment_step_key_for_owned,
}
import gunbc.live_deploy.spec {
  TailscalePackage,
  NodeJsPackage,
  ServerScript,
  SystemdUnit,
  TailscaleServeMapping,
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn witness_readiness_edges_non_empty() -> Bool {
  count(deployment_readiness_edges()) == 5
}

fn witness_deploy_readback_depends_on_tailscale_serve() -> Bool {
  any(deployment_readiness_edges(), edge =>
    match edge {
      DeploymentReadinessEdge { dependent: StepDeployReadback, prerequisite: StepOwnedTailscaleServe } => true
      _ => false
    }
  )
}

fn witness_apply_order_respects_readiness_edges() -> Bool {
  deployment_readiness_order_valid(order: deployment_readiness_apply_order())
}

type LastStepSearch {
  last: DeploymentStepKey
}

fn witness_apply_order_ends_with_readback() -> Bool {
  let order = deployment_readiness_apply_order()
  fold(
    order,
    init: LastStepSearch { last: StepEnsuredTailscale },
    f: (acc, step) => LastStepSearch { last: step }
  ).last == StepDeployReadback
}

fn witness_ensured_step_keys_map() -> Bool {
  deployment_step_key_for_ensured(kind: TailscalePackage) == StepEnsuredTailscale
    && deployment_step_key_for_ensured(kind: NodeJsPackage) == StepEnsuredNodeJs
}

fn witness_owned_step_keys_map() -> Bool {
  deployment_step_key_for_owned(kind: ServerScript) == StepOwnedServerScript
    && deployment_step_key_for_owned(kind: SystemdUnit) == StepOwnedSystemdUnit
    && deployment_step_key_for_owned(kind: TailscaleServeMapping) == StepOwnedTailscaleServe
}

test fn live_deploy_readiness_witnesses() -> Bool {
  witness_readiness_edges_non_empty()
    && witness_deploy_readback_depends_on_tailscale_serve()
    && witness_apply_order_respects_readiness_edges()
    && witness_apply_order_ends_with_readback()
    && witness_ensured_step_keys_map()
    && witness_owned_step_keys_map()
}
