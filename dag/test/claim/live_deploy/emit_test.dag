data witness_script_producers_note: String = "THE COMMITTED SCRIPT ARTIFACTS ARE GONE, SO THESE WITNESSES CALL THE EMITTER DIRECTLY. Nothing executed .github/live-deploy-srv1-apply.sh or -retract.sh — the real deploy runs live_deploy_apply_srv1_wet through gunbc run — and their registry rows named a HostReconciler consumer that does not exist. A committed artifact nobody reads is not coverage; it is a false architectural claim that happened to be convenient as a byte oracle.\\n\\nThe coverage did not need the artifact. A fixture sha is forbidden in a committed PRODUCTION artifact, never in a witness, so these call live_deploy_apply_script_for with RevisionBoundAtEmission at the fixture revision and assert the same bytes the golden used to pin — with the ExecStart line now pinned EXACTLY, which the golden never did."

fn witness_apply_script() -> String {
  live_deploy_apply_script_for(
    spec: deployment_spec_srv1(),
    revision: RevisionBoundAtEmission { revision: deploy_witness_release_revision },
  )
}

fn witness_retract_script() -> String {
  live_deploy_retract_script_for(spec: deployment_spec_srv1())
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly


// ── RETIRED WITH THE BLUE/GREEN PARTITION ──────────────────────────────────────────────────────
//
// Three claims and one helper lived here:
// witness_blue_green_slots_are_disjoint_but_share_one_route_identity,
// witness_slot_and_route_specs_make_preflip_mapping_mutation_unwritable,
// witness_blue_and_green_retirement_both_preserve_reusable_dispatch_state, and
// retiring_slot_stops_only_runtime_and_preserves_reusable_dispatch_state. All four read the spec
// PARTITION — deployment_slot_spec, deployment_route_spec, deployment_retiring_slot_spec — which
// existed so a deploy could touch an idle slot's units without touching the shared route, then flip
// the route separately. One deployment has nothing to partition: its slot IS its route, and the
// three functions are deleted, so these claims have no subject rather than a changed one.
//
// The middle claim is the one that deserves its reason stated, because it was a construction wall:
// it asserted that a pre-flip mutation of the tailscale mapping was UNWRITABLE, by showing the slot
// spec carried zero mapping artifacts and the route spec carried exactly one. That wall guarded
// against mutating the live route while staging the idle slot. With no staging step there is no
// pre-flip window to protect — the deploy's only mapping write is its own, on the only slot. The
// guarantee is not weakened here, it is vacuous, and a claim kept alive over a vacuous subject is
// the specification-without-execution shape DESIGN section 5 names.
//
// Retired with them, and MISSED on the first pass: spec_artifact_kind_count, the helper all three
// read through. The receipt below enumerated the other dead helper and not this one, which is the
// residue class this cut kept tripping over — review found it as an orphan with a single occurrence
// (its own definition). Its OwnedArtifactKind imports go with it, keeping only the variants the
// surviving claims still name.
//
// NOT retired with them: witness_retract_attempt_state_root_refuses_when_nonempty, which the third
// claim called as a conjunct. It is independently enrolled as its own test fn below, so removing
// its caller costs no coverage — checked rather than assumed, since a conjunct that exists only
// inside a retired claim would disappear silently with it.

test fn witness_spec_targets_srv1() -> Bool {
  deployment_plan_host_identity(spec: deployment_spec_srv1()) == "srv1"
}

test fn witness_spec_uses_apt_package_manager() -> Bool {
  match deployment_spec_srv1().target.os_package_manager {
    Apt => true
    _ => false
  }
}

test fn witness_spec_listen_port_is_8080() -> Bool {
  deployment_plan_listen_port(spec: deployment_spec_srv1()) == 8080
}

test fn witness_owned_vs_ensured_typed() -> Bool {
  let spec = deployment_spec_srv1()
  let has_owned = fold(spec.steps, init: false, f: (acc, s) =>
    match s {
      ArtifactStep { step: _ } => true
      Dependency { step: _ } => acc
    }
  )
  let has_ensured = fold(spec.steps, init: false, f: (acc, s) =>
    match s {
      Dependency { step: _ } => true
      ArtifactStep { step: _ } => acc
    }
  )
  has_owned && has_ensured
}

data attempt_state_mode_derivation_witness_note: String = "This asserts the DERIVED mode, not a chosen one. srv1_attempt_state_directory declares exactly one dependent — the service principal, needing read, write, and execute — so managed_directory_permissions computes owner rwx and nothing for group or other, which serializes 0700. The witness compares against managed_directory_mode_octal rather than the literal `0700` on purpose: pinning the string would let the derivation break while the test stayed green by agreeing with itself in the wrong place, and it would also red for the RIGHT reason (a genuine new dependent widening the mode) as if it were a regression. What is actually being witnessed is that the emitted argv carries whatever the dependents imply — so this stays green when a dependent is legitimately added, and reds when emission stops consuming the derivation at all."

test fn witness_apply_provisions_attempt_state_root_owned() -> Bool {
  string_contains(
    s: witness_apply_script(),
    pattern: install_directory_owned_command(
      mode: managed_directory_mode_octal(d: srv1_attempt_state_directory()) as NonEmptyStr,
      owner: gunbc_service_user,
      group: gunbc_service_user,
      path: srv1_dispatch_attempt_state_root as String,
    ),
  )
}

test fn witness_attempt_state_mode_derives_to_owner_only() -> Bool {
  let perms = managed_directory_permissions(d: srv1_attempt_state_directory())
  let owner_full = perms.mode.owner.read && perms.mode.owner.write && perms.mode.owner.execute
  let group_none = !perms.mode.group.read && !perms.mode.group.write && !perms.mode.group.execute
  let other_none = !perms.mode.other.read && !perms.mode.other.write && !perms.mode.other.execute
  owner_full && group_none && other_none
}

test fn witness_retract_attempt_state_root_refuses_when_nonempty() -> Bool {
  let script = witness_retract_script()
  let path = srv1_dispatch_attempt_state_root as String
  let empty_dir_removal = string_contains(s: script, pattern: rm_empty_directory_command(path: path))
  let recursive_removal = string_contains(s: script, pattern: rm_force_recursive_command(path: path))
  empty_dir_removal && !recursive_removal
}

test fn witness_tailnet_domain_propagates_optional() -> Bool {
  match deployment_spec_srv1().target.tailnet_domain {
    Present { value: d } => d == "tailecbe08.ts.net"
    Absent => false
  }
}

test fn witness_tailnet_url_absent_not_fabricated() -> Bool {
  match deployment_tailnet_url(spec: deployment_spec_srv1()) {
    Present { value: url } => string_contains(s: url, pattern: "https://srv1.tailecbe08.ts.net")
    Absent => false
  }
}

test fn witness_dependency_ensure_is_idempotent() -> Bool {
  let tailscale = deployment_ensure_dependency_script(
    dep: DeploymentDependencyStep { kind: TailscalePackage, subject: EnsuredPackage { package: package_tailscale } }
  )
  let tmux = deployment_ensure_dependency_script(
    dep: DeploymentDependencyStep { kind: TmuxPackage, subject: EnsuredPackage { package: package_tmux } }
  )
  string_contains(s: tailscale, pattern: dpkg_status_command(package: package_tailscale))
    && string_contains(s: tailscale, pattern: apt_install_command(package: package_tailscale, privileged: false))
    && string_contains(s: tmux, pattern: dpkg_status_command(package: package_tmux))
    && string_contains(s: tmux, pattern: apt_install_command(package: package_tmux, privileged: false))
}

test fn witness_apply_emits_no_embedded_preflight_and_only_sudoers() -> Bool {
  let sh = witness_apply_script()
  !string_contains(s: sh, pattern: "deploy-access-bootstrap-preflight")
    && !string_contains(s: sh, pattern: "whoami")
    && !string_contains(s: sh, pattern: "sudo -n -l /usr/bin/tailscale >/dev/null 2>&1")
    && !string_contains(s: sh, pattern: "sudo -n /usr/sbin/visudo -V >/dev/null")
    && !string_contains(s: sh, pattern: "deploy-access-preflight: PASS")
    && string_contains(s: sh, pattern: "sudo -n /usr/sbin/visudo -cf")
    && string_contains(s: sh, pattern: "/etc/sudoers.d/gunbc-deploy")
    && !string_contains(s: sh, pattern: "gunbc-deploy-privileged")
}

test fn witness_retract_preamble_acknowledges_shared_sudoers_install() -> Bool {
  let sh = witness_retract_script()
  string_contains(s: sh, pattern: "first retract-after-flip may be the dropin install")
    && !string_contains(s: sh, pattern: "deploy-access-bootstrap-preflight")
    && !string_contains(s: sh, pattern: "sudo -n -l /usr/bin/tailscale >/dev/null 2>&1")
    && string_contains(s: sh, pattern: "sudo -n /usr/sbin/visudo -cf")
}

test fn witness_apply_script_contains_systemd_and_tailscale() -> Bool {
  let sh = witness_apply_script()
  !string_contains(s: sh, pattern: "sudo bash")
    && string_contains(s: sh, pattern: install_directory_owned_command(mode: "0755", owner: gunbc_service_user, group: gunbc_service_user, path: "/opt/gunbc/gunbc"))
    && string_contains(s: sh, pattern: deploy_stage_write_expansion_command(stage_name: "gunbc-tree-sync.env", format: "GUNBC_TREE_SRC=%s\n", expansion_var: "PWD"))
    && string_contains(s: sh, pattern: deploy_stage_install_command(stage_name: "gunbc-tree-sync.env", mode: "0644", dest: "/etc/gunbc-tree-sync.env"))
    && string_contains(s: sh, pattern: deploy_stage_install_command(stage_name: "gunbc-tree-sync.service", mode: "0644", dest: "/etc/systemd/system/gunbc-tree-sync.service"))
    && string_contains(s: sh, pattern: systemctl_restart_command(unit: deployment_spec_srv1().names.tree_sync_unit_name, privileged: true))
    && string_contains(s: sh, pattern: install_file_owned_command(mode: "0755", owner: gunbc_service_user, group: gunbc_service_user, source: "target/release/gunbc", dest: "/opt/gunbc/bin/gunbc"))
    && string_contains(s: sh, pattern: install_directory_owned_command(mode: "0755", owner: gunbc_service_user, group: gunbc_service_user, path: "/opt/gunbc/dispatch-worktrees"))
    && string_contains(s: sh, pattern: "[Service]")
    && string_contains(s: sh, pattern: systemctl_restart_command(unit: gunbc_roadmap_unit_name, privileged: true))
    && string_contains(s: sh, pattern: tailscale_enable_command(endpoint: deployment_spec_srv1().names.tailscale_serve_endpoint))
    && string_contains(s: sh, pattern: concat("if ! ", concat(dpkg_status_command(package: package_tailscale), concat(" >/dev/null 2>&1; then ", concat(apt_install_command(package: package_tailscale, privileged: true), "; fi")))))
    && string_contains(s: sh, pattern: concat("if ! ", concat(dpkg_status_command(package: package_tmux), concat(" >/dev/null 2>&1; then ", concat(apt_install_command(package: package_tmux, privileged: true), "; fi")))))
    && string_contains(s: sh, pattern: deploy_receipt_command(host: deployment_plan_host_identity(spec: deployment_spec_srv1()), fold: "apply"))
}

test fn witness_apply_script_wires_memory_cap_deploy_consumer() -> Bool {
  let target = deployment_srv1_target()
  let units = runner_slot_service_units_for_host(host: target.host.identity)
  let cap_block = deploy_memory_cap_apply_script_for_host(host: target.host.identity)
  let sh = witness_apply_script()
  deploy_memory_cap_script_author_precedes_shadow_revert(script: cap_block, units: units)
    && string_contains(s: sh, pattern: cap_block)
    && string_contains(s: sh, pattern: "20-fleet-width.conf")
    && string_contains(s: sh, pattern: deploy_memory_cap_shadow_revert_script(units: units))
    && string_contains(s: sh, pattern: to_string(byte_size_count(b: gunbc_runner_slot_desired().memory_max)))
}

data unprivileged_principal_witness_note: String = "Discriminating RED for the run-29822498755 regression class: the ci-runner principal (fleet_posix_accounts FleetAccountCiRunner) holds NO rsync/chown/rmdir grant and no write on the service-user-owned tree, so a bare rsync/chown/rmdir in either script is a deploy that fails on the host again. The tree sync must instead ride the service-user oneshot unit (both rsync directions live INSIDE gunbc-tree-sync.service, principal User=briansrls), and every mutation outside it must be one of the six roster-granted sudo -n commands. Post-hoc admission of each sudo -n command against the ci_deploy_access grant envelope is the named residue (emit_deploy_principal_note)."

test fn retract_script_stays_within_ci_runner_grants() -> Bool {
  let retract = witness_retract_script()
  !string_contains(s: retract, pattern: "chown")
    && !string_contains(s: retract, pattern: "rmdir")
    && !string_contains(s: retract, pattern: "rsync")
}

test fn apply_script_and_tree_sync_unit_stay_within_ci_runner_grants() -> Bool {
  let apply = witness_apply_script()
  let unit = live_deploy_tree_sync_unit_for(spec: deployment_spec_srv1())
  !string_contains(s: apply, pattern: "chown")
    && !string_contains(s: apply, pattern: "rmdir")
    && !string_contains(s: apply, pattern: "rsync -a ")
    && !string_contains(s: apply, pattern: "\nrsync")
    && string_contains(s: unit, pattern: "Type=oneshot")
    && string_contains(s: unit, pattern: "User=briansrls")
    && string_contains(s: unit, pattern: "EnvironmentFile=/etc/gunbc-tree-sync.env")
    && string_contains(s: unit, pattern: join([
      "ExecStart=/usr/bin/rsync -rlpt --delete ", deployed_tree_rsync_exclude_flags(),
      " \"$\{GUNBC_TREE_SRC\}/\" /opt/gunbc/gunbc/",
    ], ""))
    && string_contains(s: unit, pattern: "ExecStart=/usr/bin/rsync -rlpt --exclude=objects/pack/*.keep --exclude=objects/pack/tmp_pack_* --include=/HEAD --include=/objects/*** --include=/packed-refs --include=/refs/*** --exclude=* \"$\{GUNBC_TREE_SRC\}/.git/\" /opt/gunbc/gunbc/.git/")
    && !string_contains(s: unit, pattern: "rsync -rlpt \"$\{GUNBC_TREE_SRC\}/.git/\"")
    && !string_contains(s: unit, pattern: "--include=/config")
    && !string_contains(s: unit, pattern: "rsync -a")
    && string_contains(s: apply, pattern: unit)
}

data tree_sync_restart_diagnosis_witness_note: String = "Discriminating RED for #7011/receipt 29928424523: the tree-sync restart is synchronous and precedes the poll-based unit_diagnosis capture, so a bare restart failure carries no WHY. The apply script must fall through to the same unit-status-tail authority the roadmap-unit diagnosis already uses (never a second format), append it to stderr, and still fail the step — never proceed as if the restart had succeeded."

test fn witness_tree_sync_restart_diagnoses_on_failure() -> Bool {
  let sh = witness_apply_script()
  string_contains(
    s: sh,
    pattern: concat(
      systemctl_restart_command(unit: deployment_spec_srv1().names.tree_sync_unit_name, privileged: true),
      " || { echo '--- gunbc-tree-sync.service control-process diagnosis ---' >&2; systemctl status --no-pager --full gunbc-tree-sync.service 2>&1 | tail -n 40 >&2; exit 1; }",
    ),
  )
}

data owned_only_removes_exactly_its_own_endpoint_note: String = "THIS CONJUNCT HAS NOW BEEN WRONG IN BOTH DIRECTIONS, which is what makes the third version worth stating carefully. It first REQUIRED `sudo -n tailscale serve reset` — a claim named owned_only demanding the one command on the host that is definitionally not owned-only (review 45207). It was then inverted to forbid every privileged tailscale invocation and require a refusal marker, which was honest about the emission but rested on the emission being right, and it was not: the refusal existed because the model asserted, without citation, that the CLI has no scoped removal.\\n\\nSo the pattern to watch is that a witness cannot be more correct than the claim it transcribes. Both earlier versions were faithful readings of the artifact in front of them; neither could have found that the artifact was answering the wrong question, and no strengthening of a string match over the retract would have surfaced it.\\n\\nThe assertion is now positive and specific: the retract issues the scoped `off` for the endpoint this deployment configured, and never the node-global reset. Requiring the exact off spelling is what ties it to the apply — the upstream demands every original flag on an off command, so a retract whose flags drift from its apply removes nothing while exiting zero, and that is the failure this conjunct exists to catch."

test fn witness_retract_script_owned_only() -> Bool {
  let sh = witness_retract_script()
  !string_contains(s: sh, pattern: "sudo bash")
    && !string_contains(s: sh, pattern: "tailscale serve reset")
    && string_contains(s: sh, pattern: tailscale_off_command(endpoint: deployment_spec_srv1().names.tailscale_serve_endpoint))
    && string_contains(s: sh, pattern: concat("then ", concat(systemctl_disable_now_command(unit: gunbc_roadmap_unit_name, privileged: true), "; fi")))
    && string_contains(s: sh, pattern: rm_force_command(paths: ["/opt/gunbc/bin/gunbc"]))
    && string_contains(s: sh, pattern: rm_empty_directory_command(path: "/opt/gunbc/dispatch-worktrees"))
    && string_contains(s: sh, pattern: rm_force_recursive_command(path: "/opt/gunbc/gunbc"))
    && !string_contains(s: sh, pattern: rm_force_recursive_command(path: "/opt/gunbc/dispatch-worktrees"))
    && string_contains(s: sh, pattern: rm_force_command(paths: [
      "/etc/systemd/system/gunbc-tree-sync.service",
      "/etc/gunbc-tree-sync.env",
    ]))
    && string_contains(s: sh, pattern: rm_force_command(paths: ["/etc/systemd/system/gunbc-roadmap.service"]))
    && string_contains(s: sh, pattern: deploy_receipt_command(host: deployment_plan_host_identity(spec: deployment_spec_srv1()), fold: "retract"))
    && !string_contains(s: sh, pattern: "apt-get remove")
    && !string_contains(s: sh, pattern: "apt-get purge")
}

data apply_no_frozen_page_note: String = "The belt-B section-3 fix made executable: the apply script ships NO emitted node server and NO deploy-frozen page snapshot — the service renders the live roadmap per request. These two witnesses red if either ever creeps back into the apply script."

test fn witness_apply_script_has_no_node_server() -> Bool {
  let sh = witness_apply_script()
  !string_contains(s: sh, pattern: "require('http').createServer")
    && !string_contains(s: sh, pattern: "server.js")
    && string_contains(s: sh, pattern: "gunbc serve")
}

test fn witness_apply_script_has_no_frozen_page() -> Bool {
  let sh = witness_apply_script()
  !string_contains(s: sh, pattern: "roadmap-section")
    && !string_contains(s: sh, pattern: "<html")
}

test fn witness_apply_script_excludes_readback_curls() -> Bool {
  let sh = witness_apply_script()
  !string_contains(s: sh, pattern: "roadmap-site-readback")
    && !string_contains(s: sh, pattern: "roadmap-site-receipt")
    && !string_contains(s: sh, pattern: "dispatch json parse failed")
    && !string_contains(s: sh, pattern: "curl -sf 'http://127.0.0.1:8080/healthz'")
    && !string_contains(s: sh, pattern: "--connect-timeout")
}

test fn witness_retract_owned_process_removes_serve_service() -> Bool {
  let sh = witness_retract_script()
  string_contains(s: sh, pattern: "/opt/gunbc/bin/gunbc")
    && string_contains(s: sh, pattern: gunbc_roadmap_unit_name)
    && !string_contains(s: sh, pattern: "tailscale serve reset")
    && string_contains(s: sh, pattern: tailscale_off_command(endpoint: deployment_spec_srv1().names.tailscale_serve_endpoint))
    && string_contains(s: sh, pattern: "_gunbc_load_state=$('systemctl' 'show' 'gunbc-roadmap.service' '--property=LoadState' '--value')")
    && string_contains(s: sh, pattern: "if '[' \"$_gunbc_load_state\" '!=' 'not-found' ']'; then 'sudo' '-n' 'systemctl' 'disable' '--now' 'gunbc-roadmap.service'; fi")
    && !string_contains(s: sh, pattern: "_gunbc_load_state=$(systemctl")
    && !string_contains(s: sh, pattern: "systemctl disable --now gunbc-roadmap.service 2>/dev/null || true")
    && string_contains(s: sh, pattern: deploy_receipt_command(host: deployment_plan_host_identity(spec: deployment_spec_srv1()), fold: "retract"))
    && !string_contains(s: sh, pattern: "roadmap-site-readback")
}

// THE PIN NOW ALSO GUARDS THE EVALUATION BUDGET, AND THAT IS THE POINT OF EXTENDING IT
// RATHER THAN ADDING A SEPARATE CONTAINS-CHECK. srv1 served with
// eval_budget_cpu_ms=unset eval_budget_wall_ms=unset on every restart of 2026-08-10
// because the unit passed neither flag; the deadline was armed with None on every request,
// and since the accept loop is serial an unbounded request held the queue for hours. A
// whole-line assertion is what makes silently dropping a flag red — a prefix check ending
// at --port 8080 stays green with both caps missing, which is precisely how the gap
// survived.
data execstart_budget_pin_note: String = "The two caps are pinned at their declared values, not merely asserted present. A present-but-different value is a policy amendment and must red here so it is reviewed as one; gunbc.live_deploy.spec dashboard_serve_budget_basis_note carries the measured basis those numbers answer to."

data execstart_pinned_exactly_note: String = "THE FULL ExecStart LINE, PINNED, WITH THE REVISION IN IT — WHICH IS WHAT THE DELETED GOLDEN NEVER ASSERTED. The committed script golden compared whole files, so it would have reddened on any change anywhere and located none of them; the sibling unit witness asserts only a command PREFIX and stops before the flag. Between them, a unit that emitted no --release-revision at all, or emitted it twice, or emitted a different value, passed every check in this file.\\n\\nSo this pins the entire line and the three REDs each break exactly one way it could be wrong: the flag missing, the value belonging to another candidate, or the flag duplicated. A prefix check cannot distinguish any of them, which is why the assertion is the whole line rather than a longer prefix."

test fn witness_execstart_carries_exactly_the_admitted_revision() -> Bool {
  let unit = live_deploy_systemd_unit_for(
    spec: deployment_spec_srv1(),
    revision: RevisionBoundAtEmission { revision: deploy_witness_release_revision },
  )
  let expected = join([
    "ExecStart=/opt/gunbc/bin/gunbc serve --source-root dag --source-root src/v2",
    " --entry dag/gunbc/roadmap_serve.dag --function roadmap_serve_handle",
    " --host 0.0.0.0 --port 8080",
    " --release-revision ", deploy_witness_release_revision as String,
    " --eval-budget-cpu-ms 30000",
    " --eval-budget-wall-ms 30000",
  ], "")
  string_contains(s: unit, pattern: expected)
    && !string_contains(s: unit, pattern: concat(expected, " --release-revision"))
    && !string_contains(s: unit, pattern: deploy_witness_other_release_revision as String)
    && !string_contains(s: unit, pattern: "$")
}

test fn witness_execstart_omitting_the_revision_is_not_the_emitted_line() -> Bool {
  let unit = live_deploy_systemd_unit_for(
    spec: deployment_spec_srv1(),
    revision: RevisionBoundAtEmission { revision: deploy_witness_release_revision },
  )
  !string_contains(s: unit, pattern: "--port 8080\nRestart=")
    && !string_contains(s: unit, pattern: "--release-revision \n")
    && string_contains(s: unit, pattern: concat("--release-revision ", deploy_witness_release_revision as String))
}

test fn witness_execstart_at_another_candidate_differs() -> Bool {
  let a = live_deploy_systemd_unit_for(
    spec: deployment_spec_srv1(),
    revision: RevisionBoundAtEmission { revision: deploy_witness_release_revision },
  )
  let b = live_deploy_systemd_unit_for(
    spec: deployment_spec_srv1(),
    revision: RevisionBoundAtEmission { revision: deploy_witness_other_release_revision },
  )
  a != b
    && string_contains(s: b, pattern: deploy_witness_other_release_revision as String)
    && !string_contains(s: b, pattern: deploy_witness_release_revision as String)
}

test fn witness_systemd_unit_emitted() -> Bool {
  let unit = live_deploy_systemd_unit_for(spec: deployment_spec_srv1(), revision: RevisionBoundAtEmission { revision: deploy_witness_release_revision })
  string_contains(s: unit, pattern: "ExecStart=/opt/gunbc/bin/gunbc serve --source-root dag --source-root src/v2 --entry dag/gunbc/roadmap_serve.dag --function roadmap_serve_handle --host 0.0.0.0 --port 8080")
    && string_contains(s: unit, pattern: "User=briansrls")
    && string_contains(s: unit, pattern: "Group=briansrls")
    && string_contains(s: unit, pattern: "WorkingDirectory=/opt/gunbc/gunbc")
    && !string_contains(s: unit, pattern: "node")
}

test fn witness_remote_mutation_service_op_realization_binds_emit_shell_phase_b_axis() -> Bool {
  match live_deploy_remote_mutation_service_op_realization_dissolution_trigger {
    Scaffold {
      dissolves_to: RealizationDispatch,
      bind: DeclarationRef { module_path: m, decl_name: n, field: WholeDeclaration },
    } =>
      m == "gunbc.live_deploy.emit"
        && n == "live_deploy_emit_shell_dissolution_trigger"
    Terminal { reason: _ } => false
  }
}

test fn witness_emit_shell_dissolution_trigger_is_scaffold() -> Bool {
  match live_deploy_emit_shell_dissolution_trigger {
    Scaffold { dissolves_to: _, bind: _ } => true
    Terminal { reason: _ } => false
  }
}

test fn witness_dependency_graph_emit_frontier_binds_orch_emit_pipeline() -> Bool {
  match live_deploy_intent_dependency_graph_emit_dissolution_trigger {
    Scaffold {
      dissolves_to: RealizationDispatch,
      bind: DeclarationRef { module_path: m, decl_name: n, field: WholeDeclaration },
    } =>
      m == "v2.compiler.emit_orchestration" && n == "orch_emit_pipeline"
    Terminal { reason: _ } => false
  }
}



data emit_poison_backstop_witness_note: String = "GOLDEN-INDEPENDENT backstop (calm-ferret pass-2 flag 2): the emit-level poison markers (teardown-dependency-unreachable, wholesale-refused) are the defense-in-depth backstop to the PRIMARY typed refusal (the EffectsOrRefusal SUM, proven golden-independent by w_effects_refuses_wholesale_on_any_refusal in the spine test). But the poison backstops are golden-DEPENDENT — a regen while a refusal was buggily active could commit a poisoned golden and the drift gate would then pass. These two witnesses call the refusal producers directly and assert the marker is present, golden-INDEPENDENT, so a golden-absorption can never hide that the arm still refuses loudly."

test fn witness_teardown_dependency_arm_refuses_golden_independent() -> Bool {
  let steps = emit_deploy_teardown_dependency_refusal(dep: DeploymentDependencyStep { kind: TmuxPackage, subject: EnsuredPackage { package: package_tmux } })
  count(steps) == 1
    && any(steps, s => match s {
         Do { run: r } => string_contains(s: r.command, pattern: "__GUNBC_DEPLOY_UNREACHABLE__")
         _ => false
       })
}

test fn witness_wholesale_refused_poison_carries_marker() -> Bool {
  let poison = live_deploy_wholesale_refused_poison(refusals: [], fold_label: "APPLY")
  string_contains(s: poison, pattern: "__GUNBC_DEPLOY_REFUSED__")
    && string_contains(s: poison, pattern: "APPLY refused-member-count=0")
}

test fn witness_deploy_access_job_principal_refused_poison_golden_independent() -> Bool {
  let poison = deploy_access_job_principal_refused_emit_poison(
    refusal: DeployAccessJobPrincipalRefusal {
      job_user: "runner" as NonEmptyStr,
      runner: DeployRunnerPrincipal { unit_user: "root", job_user: "runner" as NonEmptyStr },
    }
  )
  string_contains(s: poison, pattern: "__GUNBC_DEPLOY_ACCESS_REFUSED__")
    && string_contains(s: poison, pattern: "job_user=runner")
}

test fn witness_apply_script_access_ready_not_deploy_access_poison() -> Bool {
  let sh = witness_apply_script()
  !string_contains(s: sh, pattern: "__GUNBC_DEPLOY_ACCESS_REFUSED__")
}

data twin_on_one_host_witness_note: String = "THE CLAIM THAT WAS UNWRITABLE BEFORE THIS CHANGE, and it is the whole point of it. deployment_owned_steps and deployment_service_config took no arguments, so there was exactly one deployment in the model and a second one on the SAME machine could not be constructed at all — not merely inconvenient, unexpressible. That is what proved host was the wrong axis: if the only thing that varies is which host, then two deployments on one host is a contradiction, and a model that makes it a contradiction has fused two independent facts.\\n\\nSo the test is the twin. Same target — one machine, one ssh host, one package manager — and a different instance, and every owned path, the unit, the tailscale mapping and the port must come out disjoint. srv1_lab is a real declared instance rather than a synthetic one, so this also states that the two dashboards already declared today CAN both be deployed, which was false an hour ago.\\n\\nThe conjunct that would survive a bad fix is the target equality. Without it the claim passes trivially if someone makes the twin differ by host, which is precisely the abstraction this replaces."

fn srv1_twin_spec() -> DeploymentSpec {
  deployment_spec_for(
    instance: srv1_lab_dashboard_instance(),
    target: deployment_srv1_target(),
    names: derived_deployment_names(instance: srv1_lab_dashboard_instance()),
  )
}

fn spec_owned_paths(spec: DeploymentSpec) -> List<String> {
  deployment_owned_steps_retract_order(spec: spec) |> map(s => s.path as String)
}

test fn a_twin_deployment_on_one_host_collides_with_nothing() -> Bool {
  let live = deployment_spec_srv1()
  let twin = srv1_twin_spec()
  let live_paths = spec_owned_paths(spec: live)
  let twin_paths = spec_owned_paths(spec: twin)
  deployment_plan_host_identity(spec: live) == deployment_plan_host_identity(spec: twin)
    && !(deployment_plan_listen_port(spec: live) == deployment_plan_listen_port(spec: twin))
    && !(live.service.unit_name == twin.service.unit_name)
    && !(live.service.repo_root == twin.service.repo_root)
    && !(live.service.serve_binary == twin.service.serve_binary)
    && count(live_paths) > 0
    && count(twin_paths) == count(live_paths)
    && all(twin_paths, t => !any(live_paths, l => l == t))
}

data non_degeneracy_without_transcription_note: String = "THE COUNTS ABOVE STOPPED BEING LITERALS (review, 2026-07-30 — the live-state count-transcription class ruled against on 2026-07-29 and swept in #7464). Five was read off the live owned roster, so authoring a correct sixth member reds a claim that has nothing to say about members, and the reviewer's habit becomes editing the number until the day the number is wrong for a real reason. #7478 adds exactly such a member.\\n\\nDeleting the conjunct outright would have been the wrong fix, which is why this is a replacement rather than a removal: `all` over an empty list is vacuously true, so without a non-degeneracy guard a twin whose owned set collapsed to nothing would satisfy the disjointness claim perfectly. The literal was doing real work in a way its shape disguised.\\n\\nWhat replaces it says the same thing without reading the roster's size into the test: the production set is non-empty, and the twin mirrors it one-for-one. Both survive a member being added — the relation is between two live rosters rather than between one roster and a number a human typed — and the second is strictly stronger than the literal pair, since it would also catch a twin that gained or lost a member production did not."

data teardown_safety_witness_note: String = "THE CLAIM THAT NAMES WHAT THE COLLISION WOULD HAVE COST, rather than only that paths differ. Every owned artifact is torn down by retract, so an overlap between two specs' owned sets is not an untidy duplicate — it is one deployment's retract deleting another's live files. The first version of the twin claim above went RED on exactly one path, the serve binary, because both instances read it from the host layout; a lab retract would have removed the binary production was executing.\\n\\nThis states the property directly in retract's own terms: nothing production owns appears in what the twin's teardown would remove. It is written over the retract order specifically, not the apply order, because teardown is the destructive direction and a claim about apply would not have caught it."

test fn twin_teardown_removes_nothing_production_owns() -> Bool {
  let live_paths = spec_owned_paths(spec: deployment_spec_srv1())
  let twin_teardown = deployment_owned_steps_retract_order(spec: srv1_twin_spec())
  count(twin_teardown) > 0
    && all(twin_teardown, t => !any(live_paths, l => l == (t.path as String)))
}

data two_lanes_converged_on_one_claim_note: String = "MAIN AND THIS BRANCH INDEPENDENTLY DELETED THE SAME COUNT TRANSCRIPTION AND WROTE THE SAME REPLACEMENT, which is worth recording because the merge resolution DROPPED one of them. #7478 replaced `count(deployment_owned_steps_retract_order()) == 5` with witness_retract_order_is_apply_order_reversed, citing the 2026-07-30 live-state-count ruling; this branch replaced it with the claim below, citing the same ruling. Same defect, same diagnosis, two lanes, no coordination.\\n\\nThis one is kept because it is strictly stronger, not because it was here first. #7478's version reads the NULLARY rosters this PR removed, and it compares the fixed production roster against its own reverse. This one takes a spec and asserts the retract order is the reverse of what THAT SPEC ACTUALLY APPLIED — so it holds for the twin as well as production, and it catches the case a fixed-roster comparison cannot: a spec constructed with a non-standard order, which is exactly when a hand-mirrored list goes wrong. It is exercised on the twin spec for that reason.\\n\\nThe coverage #7478 added around AttemptStateRoot is kept in full above; only the duplicated ordering claim was dropped."

test fn retract_is_the_reverse_of_what_this_spec_applies() -> Bool {
  let twin = srv1_twin_spec()
  let applied = deployment_steps_apply_order(
    instance: srv1_lab_dashboard_instance(),
    names: derived_deployment_names(instance: srv1_lab_dashboard_instance()),
  )
  let applied_paths = applied |> flat_map(s => match s {
    ArtifactStep { step } => [step.path as String]
    Dependency { step: _ } => []
  })
  spec_owned_paths(spec: twin) == reverse(applied_paths)
}

data emitted_effect_twin_note: String = "THE PATH-LIST TWIN CLAIM WAS COVERAGE BY ILLUSION AND THIS IS ITS REPLACEMENT. The previous claim compared five declared artifact paths and pinned count == 5, so its proof was bounded by the symbolic footprint — and three destructive effects lived outside it: the systemd unit hardcoded --function roadmap_serve_handle so a twin would IDENTIFY as production, tree-sync installed and deleted one host-wide unit and env file, and teardown ran a node-global `tailscale serve reset`. Every one of those passes a declared-member comparison while the emitted script is unsafe (review, 2026-07-30).\\n\\nSo this reads the SCRIPTS. It asserts over the actual apply and retract text that production's identifying strings — its handler, its unit, its tree-sync files — appear in production's emission and are ABSENT from the twin's, and that the twin's own names are absent from production's. A string a reviewer can see in the emitted output is exactly the grain the previous claim could not reach.\\n\\nThe negative direction is the load-bearing half. Asserting the twin contains its own names would pass even if it ALSO contained production's; only absence proves it cannot touch them. The tailscale conjunct asserts the refusal marker rather than a scoped command, because the CLI offers no per-port removal and the honest emission is a refusal — a claim expecting a scoped teardown would demand a widen that cannot be written safely."

test fn production_apply_carries_its_own_handler_and_tree_sync_env() -> Bool {
  let live = live_deploy_apply_script_for(spec: deployment_spec_srv1(), revision: RevisionBoundAtEmission { revision: deploy_witness_release_revision })
  string_contains(s: live, pattern: "--function roadmap_serve_handle ")
    && string_contains(s: live, pattern: "/etc/gunbc-tree-sync.env")
}

test fn emitted_twin_apply_touches_none_of_productions_effects() -> Bool {
  let twin = live_deploy_apply_script_for(spec: srv1_twin_spec(), revision: RevisionBoundAtEmission { revision: deploy_witness_release_revision })
  string_contains(s: twin, pattern: "--function roadmap_serve_handle_srv1_lab ")
    && !string_contains(s: twin, pattern: "--function roadmap_serve_handle ")
    && !string_contains(s: twin, pattern: "/etc/gunbc-tree-sync.env")
    && !string_contains(s: twin, pattern: "/etc/systemd/system/gunbc-roadmap.service")
}

data belt_spawn_root_witness_note: String = "THE CLAIM THE BELT-TIMER MEMBER MOST NEEDED AND DID NOT HAVE (review 46541). Every other member's twin-safety follows from its PATH differing, which spec_owned_paths and the disjointness claim above already cover. The belt timer is the one member whose damage is not expressible as a path collision: both instances install their own unit at their own path, and the twin's unit can still drive PRODUCTION's tree, because what selects the tree is an argument inside the unit body rather than the unit's name. A path-level witness cannot see it, which is exactly the shape deployment_service_handler_note records for the serve handler.\\n\\nSo this reads the emitted body. The twin's belt unit must carry the twin's own spawn root, and must not carry production's — and because GUNBC_BELT_SPAWN_WORKDIR is fail-closed in belt_run_once_cli, a unit that carried neither would refuse at run time rather than silently default, which is the third state this pins shut.\\n\\nIt is discriminating in the direction that matters: deleting the Environment= line, or hardcoding either root in the emitter, reds it. The earlier conditional-membership shape would also have redded it, since the twin would have had no belt unit at all to carry a root."

test fn twin_belt_unit_carries_the_twins_spawn_root_and_not_productions() -> Bool {
  let live_instance = srv1_live_dashboard_instance()
  let lab_instance = srv1_lab_dashboard_instance()
  let twin = live_deploy_apply_script_for(spec: srv1_twin_spec(), revision: RevisionBoundAtEmission { revision: deploy_witness_release_revision })
  let env = concat(belt_spawn_workdir_env_var as String, "=")
  string_contains(s: twin, pattern: concat(env, lab_instance.repo_root as String))
    && !string_contains(s: twin, pattern: concat(env, live_instance.repo_root as String))
    && !(live_instance.repo_root == lab_instance.repo_root)
}

test fn production_belt_unit_carries_productions_spawn_root() -> Bool {
  let live_instance = srv1_live_dashboard_instance()
  let live = live_deploy_apply_script_for(spec: deployment_spec_srv1(), revision: RevisionBoundAtEmission { revision: deploy_witness_release_revision })
  string_contains(s: live, pattern: concat(concat(belt_spawn_workdir_env_var as String, "="), live_instance.repo_root as String))
}

test fn emitted_twin_retract_removes_nothing_of_productions() -> Bool {
  let twin = live_deploy_retract_script_for(spec: srv1_twin_spec())
  !string_contains(s: twin, pattern: rm_force_command(paths: ["/etc/systemd/system/gunbc-roadmap.service"]))
    && !string_contains(s: twin, pattern: "/etc/gunbc-tree-sync.env")
    && !string_contains(s: twin, pattern: "tailscale serve reset")
    && !string_contains(s: twin, pattern: tailscale_off_command(endpoint: deployment_spec_srv1().names.tailscale_serve_endpoint))
    && string_contains(s: twin, pattern: tailscale_off_command(endpoint: srv1_twin_spec().names.tailscale_serve_endpoint))
}


data shell_quote_authority_note: String = "The authority itself, exercised on the character that broke the call site. This is the consume-never-fork half of the fix: the call site no longer spells quotes, and the one place that does is checked here rather than trusted. A second hand-rolled quoter elsewhere in the tree would not be caught by this claim — that is a lens question — but a regression in the shared one would be."

test fn shell_quote_escapes_an_embedded_apostrophe() -> Bool {
  shell_quote(arg: "deployment's routing") == "'deployment'\\''s routing'"
    && shell_quote(arg: "plain") == "'plain'"
}


data twin_creates_its_own_bin_dir_note: String = "THE PARENT DIRECTORY WAS THE LAST srv1 LITERAL IN THE APPLY (review 45197). serve_binary became instance-derived while the step that creates its containing directory kept production's `/opt/gunbc/bin`, and `install` does not create missing parents — so a twin apply would reach the copy with nowhere to copy to and fail on what reads as a permissions problem.\\n\\nThe claim is stated in BOTH directions because only the negative half proves it. Asserting the twin creates its own bin directory passes even if the emission ALSO still creates production's; asserting production's literal is absent from the twin script is what closes it. The production conjunct pins that the derivation did not move production — /opt/gunbc/bin/gunbc has parent /opt/gunbc/bin, so its emitted command is unchanged, which the committed golden independently confirms."

test fn production_apply_creates_productions_binary_parent_directory() -> Bool {
  let live = live_deploy_apply_script_for(spec: deployment_spec_srv1(), revision: RevisionBoundAtEmission { revision: deploy_witness_release_revision })
  string_contains(s: live, pattern: serve_binary_parent_install_command(instance: srv1_live_dashboard_instance()))
}

test fn twin_apply_creates_its_own_binary_parent_directory_and_not_productions() -> Bool {
  let twin = live_deploy_apply_script_for(spec: srv1_twin_spec(), revision: RevisionBoundAtEmission { revision: deploy_witness_release_revision })
  !string_contains(s: twin, pattern: serve_binary_parent_install_command(instance: srv1_live_dashboard_instance()))
    && string_contains(s: twin, pattern: serve_binary_parent_install_command(instance: srv1_lab_dashboard_instance()))
}

// The parent-directory command is DERIVED from the same instance field the binary path is derived
// from, at the same two calls the emitter makes (path_parent_dir over instance.serve_binary, then
// install_directory_command). Transcribing `install -d -m 0755 /opt/gunbc/bin` here — which this
// claim did until the emitter's quoting became the grammar's job — pinned a spelling, not the
// fact: the discriminating half is the PATH differing between the two instances, and a literal
// re-states production's path a second time, which is exactly the half-parameterization
// serve_binary_parent_was_a_literal_note records the cost of.
fn serve_binary_parent_install_command(instance: HostDashboardInstance) -> String {
  install_directory_command(
    mode: install_d_shared_mode,
    path: path_parent_dir(path: instance.serve_binary as String),
    privileged: true,
  )
}

data teardown_disposition_after_the_mapping_started_acting_note: String = "THIS CLAIM ASSERTED THE WRONG ANSWER CONFIDENTLY, and it is worth keeping the record of how. review 45217 correctly found that the emitter was hand-walking three coproducts to decide teardown, and the repair lifted the fact to the model and gave the refusal a CAUSE — so the claim then pinned TailscaleServeMapping to TeardownWouldExceedOwnership and treated that as the discriminating half.\\n\\nThe discrimination was real and the cause was fiction. The mapping refused because the model asserted, with no citation, that the CLI's only removal verb is node-global; the upstream documents scoped removal. So a well-formed claim, over a well-modeled fact, faithfully pinned a false premise — and every conjunct here would have stayed green for as long as the premise went unchecked. A cause is only as good as its grounding, and nothing in a claim can supply that.\\n\\nWHAT SURVIVES is the shape rather than the cause list: every OWNED artifact acts, and the one surviving refusal is about ownership rather than tooling. TeardownWouldExceedOwnership is deleted with its premise, so the cause coproduct has one variant and this claim can no longer discriminate between two — it discriminates between the two LAYERS instead, which is the distinction that was always load-bearing.\\n\\nThe acting arms are the ratchet: if a future change made refusal the default for an owned artifact — the safe-looking direction — this reds instead of silently converting the retract into a no-op that still prints its convergence receipt."

test fn teardown_disposition_separates_owned_from_ensured() -> Bool {
  let mapping = match owned_artifact_teardown_disposition(kind: TailscaleServeMapping) {
    TeardownActs => true
    TeardownRefuses { cause: _ } => false
  }
  let binary = match owned_artifact_teardown_disposition(kind: ServeBinary) {
    TeardownActs => true
    TeardownRefuses { cause: _ } => false
  }
  let package = match deployment_step_teardown_disposition(
    step: Dependency {
      step: DeploymentDependencyStep { kind: TailscalePackage, subject: EnsuredPackage { package: package_tailscale } },
    },
  ) {
    TeardownActs => false
    TeardownRefuses { cause } =>
      match cause {
        TeardownOutsideOwnership => true
      }
  }
  mapping && binary && package
}

data endpoint_identity_is_the_collision_axis_note: String = "THE CLAIM THE TWIN PROOF WAS MISSING, and its absence is why a green twin suite shipped a production-destroying apply. Every earlier twin claim in this file compares roots, ports, units, handlers and tree-sync files, and all of them passed while BOTH deployments configured the identical tailscale endpoint - because tailscale_serve_path was an invented label the emitter never read, and the emitted command derived from the port alone, which a bare `serve` ignores in favour of the default listener at the root mount.\\n\\nSo this asserts over the axis tailscale actually keys on, in BOTH directions and on BOTH scripts. The positive half - the twin carries its own --set-path - would pass against an emission that also bound production's endpoint, which is exactly the broken state. Only the negative half closes it: production's endpoint spelling must be ABSENT from the twin's apply and from the twin's retract, so the twin can neither steal the route nor remove it.\\n\\nThe retract conjuncts are not a restatement of the apply ones. The upstream requires every original flag on an off command, so apply and off can drift independently - an off missing --set-path targets the ROOT mount, which is production's, and would remove production's routing while exiting zero. Asserting the exact off spelling on each side is what ties the two directions to one endpoint value.\\n\\nONE CLAIM BECAME FOUR, ONE PER EMITTED SCRIPT, AND NOTHING WAS DROPPED (2026-08-23). The seven conjuncts below are the seven that were here; only their grouping changed. The regrouping is lossless because NO CONJUNCT EVER COMPARED TWO EMITTED SCRIPTS: disjointness is asserted by pattern negation against a command spelling derived from the OTHER spec, which is a cheap argv join, never that spec's emitted script. A reader who assumes a disjointness claim needs both scripts by construction will re-fuse these and re-cross the line - this row said exactly that in a PR body and it was wrong, caught by two independent readers of the conjuncts.\\n\\nWHY THE GROUPING MATTERED AT ALL, stated so this is not mistaken for tidiness: emitting a script costs about 6,714 interpreter node-evals per emitted shell WORD, so a claim's cost is the number of SCRIPTS it builds. Four scripts in one claim put this row at ~5009ms against the 5000ms required_floor_claim_cpu_safety_limit_ms and it was INTERRUPTED BEFORE VERDICT - not passing, not failing, unknown - which is a strictly worse outcome than either verdict. One script per claim puts each row where the module's ordinary rows already sit, and a red now locates which script and which direction rather than which of seven conjuncts.\\n\\nTHIS IS A LOCAL UNBLOCK AND NOT THE REPAIR, AND CONFLATING THEM IS THE REAL RISK HERE. Sixteen rows in this module sit at 70-96% of the same limit; this regrouping moves the one row that crossed and leaves the population where it was. The cost is systemic - every emit consumer in the corpus pays the same per-word rate - and its measurement, its falsified hypotheses and its next-rung trigger are docs/probes/live_deploy_emit_witness_cost_attribution_2026-08-23.md. The next fleet runner-slot width increase lengthens the emitted script again and the next-highest row crosses.\\n\\nONE THING THIS REGROUPING MAKES HARDER, DECLARED RATHER THAN DISCOVERED LATER. The claim as written is LITERAL: it negates a spelling. The strictly stronger form is RELATIONAL - assert the two emitted endpoint values differ FROM EACH OTHER, which catches a drift that keeps both spellings absent from each other's script while still colliding. That form genuinely needs both scripts in one claim, so adopting it re-fuses two of these rows and re-crosses the line at today's per-word cost. It is therefore gated on the emit-cost lane rather than on anyone's appetite, and it is named here so the stronger claim is a known deferral and not an idea nobody had."

test fn production_apply_serves_its_own_endpoint_and_scopes_no_path() -> Bool {
  let live_apply = live_deploy_apply_script_for(spec: deployment_spec_srv1(), revision: RevisionBoundAtEmission { revision: deploy_witness_release_revision })
  string_contains(s: live_apply, pattern: tailscale_enable_command(endpoint: deployment_spec_srv1().names.tailscale_serve_endpoint))
    && !string_contains(s: live_apply, pattern: "--set-path")
}

test fn twin_apply_serves_its_own_endpoint_and_not_productions() -> Bool {
  let twin_apply = live_deploy_apply_script_for(spec: srv1_twin_spec(), revision: RevisionBoundAtEmission { revision: deploy_witness_release_revision })
  string_contains(s: twin_apply, pattern: tailscale_enable_command(endpoint: srv1_twin_spec().names.tailscale_serve_endpoint))
    && !string_contains(s: twin_apply, pattern: tailscale_enable_command(endpoint: deployment_spec_srv1().names.tailscale_serve_endpoint))
}

test fn production_retract_offs_its_own_endpoint() -> Bool {
  let live_retract = live_deploy_retract_script_for(spec: deployment_spec_srv1())
  string_contains(s: live_retract, pattern: tailscale_off_command(endpoint: deployment_spec_srv1().names.tailscale_serve_endpoint))
}

test fn twin_retract_offs_its_own_endpoint_and_not_productions() -> Bool {
  let twin_retract = live_deploy_retract_script_for(spec: srv1_twin_spec())
  string_contains(s: twin_retract, pattern: tailscale_off_command(endpoint: srv1_twin_spec().names.tailscale_serve_endpoint))
    && !string_contains(s: twin_retract, pattern: tailscale_off_command(endpoint: deployment_spec_srv1().names.tailscale_serve_endpoint))
}

data unobserved_client_refuses_before_emission_note: String = "THE VERSION WALL, AND THE REASON IT SITS AT EMISSION RATHER THAN IN THE SCRIPT. Scoped `serve <flags> off` arrived in tailscale client 1.52, so it is a fact about the binary installed on a host, not about tailscale. srv1 is measured at 1.98.3 and its target row records the measurement; no other fleet host has been measured, and asserting the capability for them from srv1 would be the same uncited generalization this whole change is repairing.\\n\\nAn in-script guard would have been the weaker answer: it puts a stop-the-line arm back among the teardowns, which is precisely the shape that once aborted every retract before it removed anything, and it only fires after the operator has already run the script. Refusing to EMIT means the dangerous artifact does not exist.\\n\\nThe claim needs all three arms because the failure mode is a two-into-one collapse. Unobserved and unsupported are DIFFERENT states — one host was never looked at, the other was looked at and cannot do it — and the tempting simplification is to treat unobserved as either capable (fail-open, the original defect) or as unsupported (which would silently misreport a host nobody has measured). Asserting that both refuse, that their refusals differ, and that the measured host still emits a real retract is what pins all three apart."

fn unmeasured_client_target() -> DeploymentHostTarget {
  let t = deployment_srv1_target()
  DeploymentHostTarget {
    host: t.host,
    ssh_host: t.ssh_host,
    tailscale_endpoint: t.tailscale_endpoint,
    tailnet_domain: t.tailnet_domain,
    os_package_manager: t.os_package_manager,
    tailscale_client: ScopedRemovalUnobserved { reason: "host never probed for a tailscale client version" },
  }
}

fn preserve_removal_client_target() -> DeploymentHostTarget {
  let t = deployment_srv1_target()
  DeploymentHostTarget {
    host: t.host,
    ssh_host: t.ssh_host,
    tailscale_endpoint: t.tailscale_endpoint,
    tailnet_domain: t.tailnet_domain,
    os_package_manager: t.os_package_manager,
    tailscale_client: tailscale_scoped_removal_capability(
      observed: SemVerVersion { major: 1, minor: 40, patch: 0, pre_release: [], build: [] },
    ),
  }
}

fn spec_with_target(target: DeploymentHostTarget) -> DeploymentSpec {
  deployment_spec_for(
    instance: srv1_live_dashboard_instance(),
    target: target,
    names: srv1_live_deployment_names(instance: srv1_live_dashboard_instance()),
  )
}

test fn retract_is_not_emitted_without_an_observed_scoped_removal() -> Bool {
  let unobserved = live_deploy_retract_script_for(spec: spec_with_target(target: unmeasured_client_target()))
  let too_old = live_deploy_retract_script_for(spec: spec_with_target(target: preserve_removal_client_target()))
  let measured = witness_retract_script()
  string_contains(s: unobserved, pattern: "__GUNBC_DEPLOY_REFUSED__")
    && string_contains(s: unobserved, pattern: "UNOBSERVED")
    && !string_contains(s: unobserved, pattern: emitted_tailscale_binary_word())
    && string_contains(s: too_old, pattern: "__GUNBC_DEPLOY_REFUSED__")
    && string_contains(s: too_old, pattern: "1.40.0")
    && !string_contains(s: too_old, pattern: "UNOBSERVED")
    && !string_contains(s: too_old, pattern: emitted_tailscale_binary_word())
    && !string_contains(s: measured, pattern: "__GUNBC_DEPLOY_REFUSED__")
    && string_contains(s: measured, pattern: tailscale_off_command(endpoint: deployment_spec_srv1().names.tailscale_serve_endpoint))
}

// Fleet converge timer is RETIRED from live_deploy apply membership (sleek-heron-218).
// FleetConvergeTimerUnit is absent from deployment_owned_steps; on-demand plan/apply
// is emitted via fleet-converge.yml instead of a deploy-installed timer.
test fn fleet_converge_timer_not_installed_by_deploy_apply() -> Bool {
  let spec = deployment_spec_srv1()
  let live = live_deploy_apply_script_for(spec: spec, revision: RevisionBoundAtEmission { revision: deploy_witness_release_revision })
  !any(
    deployment_owned_steps(instance: srv1_live_dashboard_instance(), names: spec.names),
    s => match s.kind { FleetConvergeTimerUnit => true  _ => false }
  )
    && !string_contains(s: live, pattern: "OnCalendar=*:0/15")
    && !string_contains(s: live, pattern: "ctrl-fleet-converge.timer")
}

// The staged unit files stopped being here-documents. A here-doc ends at a line equal to its
// delimiter, so the delimiter is a value the CONTENT could contain — a unit body carrying the
// tag line would end the document early and the rest would run as shell. These REDs fail if any
// of the five converted writes goes back to that form, and the positive conjunct is the reason
// it is safe now: the body reaches the host as one quoted argument through the POSIX authority,
// which has no terminator to collide with.
test fn emit_RED_unit_files_are_not_written_through_here_documents() -> Bool {
  let sh = witness_apply_script()
  !string_contains(s: sh, pattern: "GUNBC_UNIT_EOF")
    && !string_contains(s: sh, pattern: "GUNBC_TREE_SYNC_EOF")
    && !string_contains(s: sh, pattern: "GUNBC_BELT_SERVICE_EOF")
    && !string_contains(s: sh, pattern: "GUNBC_BELT_TIMER_EOF")
    && !string_contains(s: sh, pattern: "GUNBC_TREE_REMOTE_EOF")
}

test fn emit_staged_unit_body_is_quoted_by_the_posix_authority() -> Bool {
  let sh = witness_apply_script()
  string_contains(s: sh, pattern: concat("'printf' '%s' ", concat("'", "[Unit]")))
}

// The tailscale endpoint spellings are DERIVED from extdeps.tailscale.serve's argv rows, the
// same rows the emitter consumes, rather than transcribed. Transcribing them is what let an
// invented `tailscale_serve_path` label sit in the model while the emitted command derived from
// the port alone — endpoint_identity_is_the_collision_axis_note is the receipt.
// The absence conjuncts below cannot be spelled as a derived COMMAND, because what they assert is
// that no tailscale invocation was emitted at all — there is no particular command whose absence
// says that. They assert the binary WORD as the grammar spells it instead, which every invocation
// through the single authority must contain. Spelled `"sudo -n tailscale"` (as they were until the
// emitter's quoting moved into the bash grammar) the conjunct became VACUOUS rather than red: the
// unquoted prefix can no longer appear in any emitted script, so the absence held for a reason that
// has nothing to do with the refusal these claims exist to pin.
fn emitted_tailscale_binary_word() -> String {
  posix_single_quote(spelling: "tailscale")
}

fn tailscale_enable_command(endpoint: TailscaleServeEndpoint) -> String {
  shell_privileged_command_text_of_argv(
    argv: concat(["tailscale"], tailscale_serve_enable_argv(endpoint: endpoint)),
  )
}

fn tailscale_off_command(endpoint: TailscaleServeEndpoint) -> String {
  shell_privileged_command_text_of_argv(
    argv: concat(["tailscale"], tailscale_serve_off_argv(endpoint: endpoint)),
  )
}


