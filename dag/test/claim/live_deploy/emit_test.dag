module test.claim.live_deploy.emit


data live_tree_disposition: LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn witness_spec_targets_srv1() -> Bool {
  gunbc.live_deploy.spec.deployment_plan_host_identity(spec: gunbc.live_deploy.spec.deployment_spec_srv1()) == "srv1"
}

fn witness_spec_uses_apt_package_manager() -> Bool {
  match gunbc.live_deploy.spec.deployment_spec_srv1().target.os_package_manager {
    Apt => true
    _ => false
  }
}

fn witness_spec_listen_port_is_8080() -> Bool {
  gunbc.live_deploy.spec.deployment_plan_listen_port(spec: gunbc.live_deploy.spec.deployment_spec_srv1()) == 8080
}

fn witness_owned_vs_ensured_typed() -> Bool {
  let spec = gunbc.live_deploy.spec.deployment_spec_srv1()
  let has_owned = fold(spec.steps, init: false, f: (acc, s) =>
    match s {
      Artifact { step: _ } => true
      gunbc.live_deploy.spec.Dependency { step: _ } => acc
    }
  )
  let has_ensured = fold(spec.steps, init: false, f: (acc, s) =>
    match s {
      gunbc.live_deploy.spec.Dependency { step: _ } => true
      Artifact { step: _ } => acc
    }
  )
  has_owned && has_ensured
}

fn witness_retract_owned_only() -> Bool {
  count(gunbc.live_deploy.spec.deployment_owned_steps_retract_order()) == 3
}

fn witness_tailnet_domain_propagates_optional() -> Bool {
  match gunbc.live_deploy.spec.deployment_spec_srv1().target.tailnet_domain {
    Present { value: d } => d == "tailecbe08.ts.net"
    Absent => false
  }
}

fn witness_tailnet_url_absent_not_fabricated() -> Bool {
  match gunbc.live_deploy.spec.deployment_tailnet_url(spec: gunbc.live_deploy.spec.deployment_spec_srv1()) {
    Present { value: url } => string_contains(s: url, pattern: "https://srv1.tailecbe08.ts.net")
    Absent => false
  }
}

fn witness_dependency_ensure_is_idempotent() -> Bool {
  let tailscale = gunbc.live_deploy.emit.deployment_ensure_dependency_script(
    dep: gunbc.live_deploy.spec.DeploymentDependencyStep { kind: TailscalePackage, package: extdeps.apt.package_tailscale }
  )
  let nodejs = gunbc.live_deploy.emit.deployment_ensure_dependency_script(
    dep: gunbc.live_deploy.spec.DeploymentDependencyStep { kind: gunbc.live_deploy.spec.NodeJsPackage, package: extdeps.apt.package_nodejs }
  )
  string_contains(s: tailscale, pattern: "dpkg -s tailscale")
    && string_contains(s: tailscale, pattern: "apt-get install --yes tailscale")
    && string_contains(s: nodejs, pattern: "dpkg -s nodejs")
    && string_contains(s: nodejs, pattern: "apt-get install --yes nodejs")
}

fn witness_apply_script_contains_systemd_and_tailscale() -> Bool {
  let sh = gunbc.live_deploy.emit.expected_live_deploy_apply_script()
  !string_contains(s: sh, pattern: "sudo bash")
    && string_contains(s: sh, pattern: "sudo -n install -m 0644 \"$_gunbc_stage/server.js\" /opt/gunbc/server.js")
    && string_contains(s: sh, pattern: "[Service]")
    && string_contains(s: sh, pattern: "sudo -n systemctl restart gunbc-roadmap.service")
    && string_contains(s: sh, pattern: "sudo -n tailscale serve --bg 8080")
    && string_contains(s: sh, pattern: "if ! dpkg -s tailscale >/dev/null 2>&1; then sudo -n apt-get install --yes tailscale; fi")
    && string_contains(s: sh, pattern: "if ! dpkg -s nodejs >/dev/null 2>&1; then sudo -n apt-get install --yes nodejs; fi")
    && string_contains(s: sh, pattern: "fold=apply verdict=converged")
}

fn witness_retract_script_owned_only() -> Bool {
  let sh = gunbc.live_deploy.emit.expected_live_deploy_retract_script()
  !string_contains(s: sh, pattern: "sudo bash")
    && string_contains(s: sh, pattern: "sudo -n tailscale serve reset")
    && string_contains(s: sh, pattern: "sudo -n systemctl disable --now gunbc-roadmap.service")
    && string_contains(s: sh, pattern: "sudo -n rm -f /opt/gunbc/server.js")
    && string_contains(s: sh, pattern: "sudo -n rm -f /etc/systemd/system/gunbc-roadmap.service")
    && string_contains(s: sh, pattern: "fold=retract verdict=converged")
    && !string_contains(s: sh, pattern: "apt-get remove")
    && !string_contains(s: sh, pattern: "apt-get purge")
}

fn witness_apply_script_contains_node_server() -> Bool {
  string_contains(s: gunbc.live_deploy.emit.expected_live_deploy_apply_script(), pattern: "require('http').createServer")
}

fn witness_apply_script_serves_roadmap_page() -> Bool {
  let sh = gunbc.live_deploy.emit.expected_live_deploy_apply_script()
  string_contains(s: sh, pattern: "gunbc — roadmap")
    && string_contains(s: sh, pattern: "roadmap-section")
    && !string_contains(s: sh, pattern: ">Browse<")
}

fn witness_apply_script_excludes_readback_curls() -> Bool {
  let sh = gunbc.live_deploy.emit.expected_live_deploy_apply_script()
  !string_contains(s: sh, pattern: "roadmap-site-readback")
    && !string_contains(s: sh, pattern: "roadmap-site-receipt")
    && !string_contains(s: sh, pattern: "dispatch json parse failed")
    && !string_contains(s: sh, pattern: "curl -sf 'http://127.0.0.1:8080/healthz'")
    && !string_contains(s: sh, pattern: "--connect-timeout")
}

fn witness_retract_owned_process_removes_static_site_server() -> Bool {
  let sh = gunbc.live_deploy.emit.expected_live_deploy_retract_script()
  string_contains(s: sh, pattern: gunbc.live_deploy.spec.gunbc_roadmap_server_path)
    && string_contains(s: sh, pattern: gunbc.live_deploy.spec.gunbc_roadmap_unit_name)
    && string_contains(s: sh, pattern: "tailscale serve reset")
    && string_contains(s: sh, pattern: "systemctl disable --now")
    && string_contains(s: sh, pattern: "fold=retract verdict=converged")
    && !string_contains(s: sh, pattern: "roadmap-site-readback")
}

fn witness_static_site_routes_in_dashboard_route_table() -> Bool {
  let site = gunbc.roadmap_static_site.roadmap_site_text_static_routes()
  let table = gunbc.node_http_server_emit.roadmap_dashboard_served_static_route_table().routes
  count(site) == 3
    && count(table) == count(site) + 2
    && all(site, site_route =>
      v2.std.algebra.any(table, table_route =>
        gunbc.roadmap_static_site.served_static_route_literal_path(route: site_route) == gunbc.roadmap_static_site.served_static_route_literal_path(route: table_route)
          && site_route.body == table_route.body
      )
    )
}

fn witness_static_site_paths_only_in_retracted_server() -> Bool {
  let src = gunbc.node_http_server_emit.roadmap_dashboard_node_http_server_source()
  string_contains(s: src, pattern: "createServer")
    && string_contains(s: src, pattern: "/^\\/ROADMAP\\.md$/")
    && string_contains(s: src, pattern: "/^\\/target\\/roadmap-dispatch\\.json$/")
    && string_contains(s: src, pattern: "/^\\/healthz$/")
}

fn witness_systemd_unit_emitted() -> Bool {
  let unit = gunbc.live_deploy.emit.live_deploy_systemd_unit_for(spec: gunbc.live_deploy.spec.deployment_spec_srv1())
  string_contains(s: unit, pattern: "ExecStart=/usr/bin/node /opt/gunbc/server.js")
    && string_contains(s: unit, pattern: "Environment=PORT=8080")
}

fn witness_remote_mutation_service_op_realization_binds_emit_shell_phase_b_axis() -> Bool {
  match gunbc.live_deploy.emit.live_deploy_remote_mutation_service_op_realization_dissolution_trigger {
    std.disposition.Scaffold {
      dissolves_to: std.disposition.RealizationDispatch,
      bind: std.decl_ref.DeclarationRef { module_path: m, decl_name: n, field: std.decl_ref.WholeDeclaration },
    } =>
      m == "gunbc.live_deploy.emit"
        && n == "live_deploy_emit_shell_dissolution_trigger"
    Terminal { reason: _ } => false
  }
}

fn witness_emit_shell_dissolution_trigger_is_scaffold() -> Bool {
  match gunbc.live_deploy.emit.live_deploy_emit_shell_dissolution_trigger {
    std.disposition.Scaffold { dissolves_to: _, bind: _ } => true
    Terminal { reason: _ } => false
  }
}

fn witness_dependency_graph_emit_frontier_binds_orch_emit_pipeline() -> Bool {
  match gunbc.live_deploy.emit.live_deploy_intent_dependency_graph_emit_dissolution_trigger {
    std.disposition.Scaffold {
      dissolves_to: std.disposition.RealizationDispatch,
      bind: std.decl_ref.DeclarationRef { module_path: m, decl_name: n, field: std.decl_ref.WholeDeclaration },
    } =>
      m == "v2.compiler.emit_orchestration" && n == "orch_emit_pipeline"
    Terminal { reason: _ } => false
  }
}

fn witness_apply_script_matches_committed_golden() -> Bool {
  let r = v2.extdeps.file_system.Filesystem.Read(path: artifact_path(a: LiveDeployApplyScriptArtifact))
  let expected = gunbc.live_deploy.emit.expected_live_deploy_apply_script()
  r.success
    && r.content == expected
    && !(concat(r.content, "x") == expected)
}

fn witness_retract_script_matches_committed_golden() -> Bool {
  let r = v2.extdeps.file_system.Filesystem.Read(path: artifact_path(a: LiveDeployRetractScriptArtifact))
  let expected = gunbc.live_deploy.emit.expected_live_deploy_retract_script()
  r.success
    && r.content == expected
    && !(concat(r.content, "x") == expected)
}

data emit_poison_backstop_witness_note: String = "GOLDEN-INDEPENDENT backstop (calm-ferret pass-2 flag 2): the emit-level poison markers (teardown-dependency-unreachable, wholesale-refused) are the defense-in-depth backstop to the PRIMARY typed refusal (the EffectsOrRefusal SUM, proven golden-independent by w_effects_refuses_wholesale_on_any_refusal in the spine test). But the poison backstops are golden-DEPENDENT — a regen while a refusal was buggily active could commit a poisoned golden and the drift gate would then pass. These two witnesses call the refusal producers directly and assert the marker is present, golden-INDEPENDENT, so a golden-absorption can never hide that the arm still refuses loudly."

fn witness_teardown_dependency_arm_refuses_golden_independent() -> Bool {
  let steps = gunbc.live_deploy.emit.emit_deploy_teardown_dependency_refusal(dep: gunbc.live_deploy.spec.DeploymentDependencyStep { kind: gunbc.live_deploy.spec.NodeJsPackage, package: extdeps.apt.package_nodejs })
  count(steps) == 1
    && v2.std.algebra.any(steps, s => match s {
         v2.std.orchestration.Do { run: r } => string_contains(s: r.command, pattern: "__GUNBC_DEPLOY_UNREACHABLE__")
         _ => false
       })
}

fn witness_wholesale_refused_poison_carries_marker() -> Bool {
  let poison = gunbc.live_deploy.emit.live_deploy_wholesale_refused_poison(refusals: [], fold_label: "APPLY")
  string_contains(s: poison, pattern: "__GUNBC_DEPLOY_REFUSED__")
    && string_contains(s: poison, pattern: "APPLY refused-member-count=0")
}

test fn live_deploy_emit_holds() -> Bool {
  witness_spec_targets_srv1()
    && witness_spec_uses_apt_package_manager()
    && witness_spec_listen_port_is_8080()
    && witness_owned_vs_ensured_typed()
    && witness_retract_owned_only()
    && witness_tailnet_domain_propagates_optional()
    && witness_tailnet_url_absent_not_fabricated()
    && witness_dependency_ensure_is_idempotent()
    && witness_apply_script_contains_systemd_and_tailscale()
    && witness_retract_script_owned_only()
    && witness_apply_script_contains_node_server()
    && witness_apply_script_serves_roadmap_page()
    && witness_apply_script_excludes_readback_curls()
    && witness_retract_owned_process_removes_static_site_server()
    && witness_static_site_routes_in_dashboard_route_table()
    && witness_static_site_paths_only_in_retracted_server()
    && witness_systemd_unit_emitted()
    && witness_apply_script_matches_committed_golden()
    && witness_retract_script_matches_committed_golden()
    && witness_remote_mutation_service_op_realization_binds_emit_shell_phase_b_axis()
    && witness_dependency_graph_emit_frontier_binds_orch_emit_pipeline()
    && witness_emit_shell_dissolution_trigger_is_scaffold()
    && witness_teardown_dependency_arm_refuses_golden_independent()
    && witness_wholesale_refused_poison_carries_marker()
}
