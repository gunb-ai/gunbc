module test.claim.live_deploy.emit

import std.types { Bool, String }
import std.os.types { Apt }
import gunbc.live_deploy.spec {
  DeploymentSpec,
  DeploymentEnsuredStep,
  TailscalePackage,
  NodeJsPackage,
  deployment_spec_srv1,
  deployment_plan_host_identity,
  deployment_plan_listen_port,
  deployment_owned_steps_retract_order,
  deployment_tailnet_url,
  gunbc_roadmap_unit_name,
  gunbc_roadmap_server_path,
}
import gunbc.live_deploy.emit {
  expected_live_deploy_apply_script,
  expected_live_deploy_retract_script,
  live_deploy_systemd_unit_for,
  deployment_ensure_dependency_script,
  live_deploy_emit_shell_dissolution_trigger,
  live_deploy_remote_mutation_service_op_realization_dissolution_trigger,
  live_deploy_intent_dependency_graph_emit_dissolution_trigger,
}
import std.disposition { Scaffold, RealizationDispatch, Terminal }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import gunbc.generated_artifact {
  LiveDeployApplyScriptArtifact,
  LiveDeployRetractScriptArtifact,
  artifact_path,
}
import extdeps.filesystem.filesystem_io { Filesystem }
import gunbc.node_http_server_emit {
  roadmap_dashboard_served_static_route_table,
  roadmap_dashboard_node_http_server_source,
}
import gunbc.roadmap_static_site {
  roadmap_site_health_path,
  roadmap_site_roadmap_url_path,
  roadmap_site_dispatch_url_path,
  roadmap_site_text_static_routes,
  served_static_route_literal_path,
}
import extdeps.apt { package_tailscale, package_nodejs }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn witness_spec_targets_srv1() -> Bool {
  deployment_plan_host_identity(spec: deployment_spec_srv1()) == "srv1"
}

fn witness_spec_uses_apt_package_manager() -> Bool {
  match deployment_spec_srv1().target.os_package_manager {
    Apt => true
    _ => false
  }
}

fn witness_spec_listen_port_is_8080() -> Bool {
  deployment_plan_listen_port(spec: deployment_spec_srv1()) == 8080
}

fn witness_owned_vs_ensured_typed() -> Bool {
  let spec = deployment_spec_srv1()
  let has_owned = fold(spec.steps, init: false, f: (acc, s) =>
    match s {
      Owned { step: _ } => true
      Ensured { step: _ } => acc
    }
  )
  let has_ensured = fold(spec.steps, init: false, f: (acc, s) =>
    match s {
      Ensured { step: _ } => true
      Owned { step: _ } => acc
    }
  )
  has_owned && has_ensured
}

fn witness_retract_owned_only() -> Bool {
  count(deployment_owned_steps_retract_order()) == 3
}

fn witness_tailnet_domain_propagates_optional() -> Bool {
  match deployment_spec_srv1().target.tailnet_domain {
    Present { value: d } => d == "tailecbe08.ts.net"
    Absent => false
  }
}

fn witness_tailnet_url_absent_not_fabricated() -> Bool {
  match deployment_tailnet_url(spec: deployment_spec_srv1()) {
    Present { value: url } => string_contains(s: url, pattern: "https://srv1.tailecbe08.ts.net")
    Absent => false
  }
}

fn witness_dependency_ensure_is_idempotent() -> Bool {
  let tailscale = deployment_ensure_dependency_script(
    dep: DeploymentEnsuredStep { kind: TailscalePackage, package: package_tailscale }
  )
  let nodejs = deployment_ensure_dependency_script(
    dep: DeploymentEnsuredStep { kind: NodeJsPackage, package: package_nodejs }
  )
  string_contains(s: tailscale, pattern: "dpkg -s tailscale")
    && string_contains(s: tailscale, pattern: "apt-get install -y tailscale")
    && string_contains(s: nodejs, pattern: "dpkg -s nodejs")
    && string_contains(s: nodejs, pattern: "apt-get install -y nodejs")
}

fn witness_apply_script_contains_systemd_and_tailscale() -> Bool {
  let sh = expected_live_deploy_apply_script()
  !string_contains(s: sh, pattern: "sudo bash")
    && string_contains(s: sh, pattern: "sudo -n install -m 0644 \"$_gunbc_stage/server.js\" /opt/gunbc/server.js")
    && string_contains(s: sh, pattern: "[Service]")
    && string_contains(s: sh, pattern: "sudo -n systemctl restart gunbc-roadmap.service")
    && string_contains(s: sh, pattern: "sudo -n tailscale serve --bg 8080")
    && string_contains(s: sh, pattern: "ensure_apt_package \"tailscale\"")
    && string_contains(s: sh, pattern: "ensure_apt_package \"nodejs\"")
    && string_contains(s: sh, pattern: "fold=apply verdict=converged")
}

fn witness_retract_script_owned_only() -> Bool {
  let sh = expected_live_deploy_retract_script()
  !string_contains(s: sh, pattern: "sudo bash")
    && string_contains(s: sh, pattern: "sudo -n tailscale serve reset")
    && string_contains(s: sh, pattern: "sudo -n systemctl disable --now gunbc-roadmap.service")
    && string_contains(s: sh, pattern: "sudo -n rm -f /opt/gunbc/server.js")
    && string_contains(s: sh, pattern: "sudo -n rm -f /etc/systemd/system/gunbc-roadmap.service")
    && string_contains(s: sh, pattern: "fold=retract verdict=converged")
    && !string_contains(s: sh, pattern: "apt-get remove")
    && !string_contains(s: sh, pattern: "apt-get purge")
}

fn witness_apply_script_contains_node_server() -> Bool {
  string_contains(s: expected_live_deploy_apply_script(), pattern: "require('http').createServer")
}

fn witness_apply_script_serves_roadmap_page() -> Bool {
  let sh = expected_live_deploy_apply_script()
  string_contains(s: sh, pattern: "gunbc — roadmap")
    && string_contains(s: sh, pattern: "roadmap-section")
    && !string_contains(s: sh, pattern: ">Browse<")
}

fn witness_apply_script_includes_digest_readback_without_healthz() -> Bool {
  let sh = expected_live_deploy_apply_script()
  string_contains(s: sh, pattern: roadmap_site_roadmap_url_path)
    && string_contains(s: sh, pattern: roadmap_site_dispatch_url_path)
    && string_contains(s: sh, pattern: "roadmap-site-readback")
    && string_contains(s: sh, pattern: "roadmap-site-receipt")
    && string_contains(s: sh, pattern: "dispatch json parse failed")
    && !string_contains(s: sh, pattern: "healthz json parse failed")
    && !string_contains(s: sh, pattern: "curl -sf 'http://127.0.0.1:8080/healthz'")
}

fn witness_retract_owned_process_removes_static_site_server() -> Bool {
  let sh = expected_live_deploy_retract_script()
  string_contains(s: sh, pattern: gunbc_roadmap_server_path)
    && string_contains(s: sh, pattern: gunbc_roadmap_unit_name)
    && string_contains(s: sh, pattern: "tailscale serve reset")
    && string_contains(s: sh, pattern: "systemctl disable --now")
    && string_contains(s: sh, pattern: "fold=retract verdict=converged")
    && !string_contains(s: sh, pattern: "roadmap-site-readback")
}

fn witness_static_site_routes_in_dashboard_route_table() -> Bool {
  let site = roadmap_site_text_static_routes()
  let table = roadmap_dashboard_served_static_route_table().routes
  count(site) == 3
    && count(table) == count(site) + 2
    && all(site, site_route =>
      any(table, table_route =>
        served_static_route_literal_path(route: site_route) == served_static_route_literal_path(route: table_route)
          && site_route.body == table_route.body
      )
    )
}

fn witness_static_site_paths_only_in_retracted_server() -> Bool {
  let src = roadmap_dashboard_node_http_server_source()
  string_contains(s: src, pattern: "createServer")
    && string_contains(s: src, pattern: "/^\\/ROADMAP\\.md$/")
    && string_contains(s: src, pattern: "/^\\/target\\/roadmap-dispatch\\.json$/")
    && string_contains(s: src, pattern: "/^\\/healthz$/")
}

fn witness_systemd_unit_emitted() -> Bool {
  let unit = live_deploy_systemd_unit_for(spec: deployment_spec_srv1())
  string_contains(s: unit, pattern: "ExecStart=/usr/bin/node /opt/gunbc/server.js")
    && string_contains(s: unit, pattern: "Environment=PORT=8080")
}

fn witness_remote_mutation_service_op_realization_binds_emit_shell_phase_b_axis() -> Bool {
  match live_deploy_remote_mutation_service_op_realization_dissolution_trigger {
    Scaffold {
      dissolves_to: RealizationDispatch,
      bind: DeclarationRef { module_path: m, decl_name: n, field: WholeDeclaration },
    } =>
      m == "gunbc.live_deploy.emit"
        && n == "live_deploy_emit_shell_dissolution_trigger"
    Terminal { reason: _ } => false
  }
}

fn witness_emit_shell_dissolution_trigger_is_scaffold() -> Bool {
  match live_deploy_emit_shell_dissolution_trigger {
    Scaffold { dissolves_to: _, bind: _ } => true
    Terminal { reason: _ } => false
  }
}

fn witness_dependency_graph_emit_frontier_binds_orch_emit_pipeline() -> Bool {
  match live_deploy_intent_dependency_graph_emit_dissolution_trigger {
    Scaffold {
      dissolves_to: RealizationDispatch,
      bind: DeclarationRef { module_path: m, decl_name: n, field: WholeDeclaration },
    } =>
      m == "v2.compiler.emit_orchestration" && n == "orch_emit_pipeline"
    Terminal { reason: _ } => false
  }
}

fn witness_apply_script_matches_committed_golden() -> Bool {
  let r = Filesystem.Read(path: artifact_path(a: LiveDeployApplyScriptArtifact))
  let expected = expected_live_deploy_apply_script()
  r.success
    && r.content == expected
    && !(concat(r.content, "x") == expected)
}

fn witness_retract_script_matches_committed_golden() -> Bool {
  let r = Filesystem.Read(path: artifact_path(a: LiveDeployRetractScriptArtifact))
  let expected = expected_live_deploy_retract_script()
  r.success
    && r.content == expected
    && !(concat(r.content, "x") == expected)
}

test fn live_deploy_emit_holds() -> Bool {
  witness_spec_targets_srv1()
    && witness_spec_uses_apt_package_manager()
    && witness_spec_listen_port_is_8080()
    && witness_owned_vs_ensured_typed()
    && witness_retract_owned_only()
    && witness_tailnet_domain_propagates_optional()
    && witness_tailnet_url_absent_not_fabricated()
    && witness_dependency_ensure_is_idempotent()
    && witness_apply_script_contains_systemd_and_tailscale()
    && witness_retract_script_owned_only()
    && witness_apply_script_contains_node_server()
    && witness_apply_script_serves_roadmap_page()
    && witness_apply_script_includes_digest_readback_without_healthz()
    && witness_retract_owned_process_removes_static_site_server()
    && witness_static_site_routes_in_dashboard_route_table()
    && witness_static_site_paths_only_in_retracted_server()
    && witness_systemd_unit_emitted()
    && witness_apply_script_matches_committed_golden()
    && witness_retract_script_matches_committed_golden()
    && witness_remote_mutation_service_op_realization_binds_emit_shell_phase_b_axis()
    && witness_dependency_graph_emit_frontier_binds_orch_emit_pipeline()
    && witness_emit_shell_dissolution_trigger_is_scaffold()
}
