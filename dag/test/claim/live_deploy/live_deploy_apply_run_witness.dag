// Witness for the TYPED LIVE_DEPLOY APPLY LEGS (gunbc.live_deploy.apply_legs) and their runner,
// verdict and orchestration (gunbc.host.host_effect_realize deploy_apply_run_legs,
// live_deploy_apply_verdict, live_deploy_apply_orchestrate).
//
// The folds are pinned over SUPPLIED RunArgvTransportOutcome / OwnedDirectoryEnsureOutcome values (DESIGN
// section 3: a witness discriminates at one interface). The transport has no mock arm (ruling
// 2026-08-23): effectful ports enter as function values to the same runner production calls, and the
// legs under test are the real plan's, not hand-built.
module test.claim.live_deploy.live_deploy_apply_run_witness

import gunbc.live_deploy.apply_legs { ApplyLegInstallUnit, apply_unit_install_command, apply_unit_install_preview }

import std.types { Bool, String, Int, NonEmptyStr, List }
import std.fabric_blob { read_staged_fabric_blob, FabricBlobRead, FabricBlobReadRefused, FabricBlobReading, fabric_blob_reading_digest }
import gunbc.live_deploy.unit_install { DeploymentUnitInstall, CapturedUnitDocument }
import extdeps.systemd.manager { SystemManager }
import extdeps.crypto.hash { sha256sum_file_command }

import std.algebra { Cons, Empty, skip }
import std.optional { Optional, Present, Absent }
import std.realization_reconcile { Reconciliation, Converged, NotConverged }
import gunbc.host.host_effect { HostEffectEvidence, HostEffectIntent, HostOs, SshShell, LiveDeployRetract, host_effect_identity_evidence }
import gunbc.fleet.fleet_intent { srv1_host }
import gunbc.host.host_effect_realize {
  RunArgvTransportOutcome, RunArgvTransportObserved, RunArgvTransportRefused, ShellExecObserved,
  DeployApplyPorts, DeployApplyRun, ApplyRunOk, ApplyRunFailed,
  deploy_apply_run_legs, live_deploy_apply_verdict, live_deploy_apply_orchestrate, credstore_copy_bracket,
  LiveDeployPreambleVerdict, PreambleConverged, PreambleRefused, ScratchAcquire,
  DeployRetractPorts, RemovedNoOp,
}
import gunbc.systemctl_show_read { SystemdPropertyCaptured }
import extdeps.systemd { systemd_unit_load_state_not_found_wire }
import gunbc.live_deploy.spec { PublicationHelperPathUnit, deployment_publication_path_unit_path, BeltEventPathUnit, deployment_belt_exit_path_unit_path }
import extdeps.exec.command { argv_words, ArgvCommand }
import gunbc.owned_directory { OwnedDirectoryEnsureOutcome, OwnedDirectoryEnsureRefused }
import gunbc.host.host_axis_caps { CapMember, CapConvergeAuthorized, CapConvergeWithheld }
import gunbc.live_deploy.apply_legs {
  DeployApplyLeg, DeployApplyPlan, ApplyPlanReady, ApplyPlanRefused,
  ApplyLegCommand, ApplyLegInstallFile, ApplyLegReport, ApplyLegEnsureDirectory, ApplyLegBrokerStateDirectories, ApplyLegObjectSource, ApplyLegDigestVerify, ApplyLegDiagnosedCommand,
  deploy_apply_memory_cap_plan, deploy_apply_leg_step, deploy_apply_tree_plan, deploy_apply_executable_plan,
  ApplyLegRootHelperSnapshot, ApplyLegBrokerTree, ApplyLegRepairDirectoryEntries, ApplyLegRetract, ApplyLegDependency, ApplyLegDigestEnvFile, deploy_apply_unit_plan, deploy_apply_upsert_plan,
  ApplyLegCredstoreCopy, CredstoreCopyBracket, CredstoreCopyCompleted, CredstoreCopyCompletedResidueRemains, CredstoreCopyNotEntered, CredstoreCopyNotEnteredResidueRemains,
}
import gunbc.live_deploy.desired { srv1_lab_desired_deployment, selected_deployment_spec }
import extdeps.git.partial_clone { ObjectSourceServeAdmission, ObjectSourceCanServe, ObjectSourceCannotServe }
import gunbc.live_deploy.desired { deployment_spec_srv1 }
import gunbc.live_deploy.release_locus { RevisionBoundAtEmission }
import std.types { CommitSha }
import extdeps.crypto.hash { Digest, sha256_digest }
import test.claim.live_deploy.deploy_release_fixture { deploy_witness_full_install_plan }
import product.host_identity { HostIdentity }

fn observed(code: Int, err: String) -> RunArgvTransportOutcome {
  RunArgvTransportObserved { observed: ShellExecObserved { exit_code: code, success: code == 0, stdout: "", stderr: err } }
}

fn the_intent() -> HostEffectIntent {
  HostEffectIntent {
    target: HostOs { node: srv1_host },
    effect: LiveDeployRetract { spec: deployment_spec_srv1() },
    evidence: host_effect_identity_evidence,
    transport: SshShell { ssh_host: "srv-x" },
    privilege_denial: none,
  }
}

fn grant_boom() -> Optional<String> {
  Present { value: "grant-boom" }
}

fn root_grant_boom() -> Optional<String> {
  Present { value: "root-grant-boom" }
}

fn broker_tree_boom() -> Optional<String> {
  Present { value: "broker-tree-boom" }
}

fn dependency_boom() -> Optional<String> {
  Present { value: "dependency-boom" }
}

fn ports(command_code: Int, stdin_code: Int) -> DeployApplyPorts {
  ports_serving(command_code: command_code, stdin_code: stdin_code, source: ObjectSourceCannotServe { source: "/src", cause: "source-boom" })
}

fn ports_serving(command_code: Int, stdin_code: Int, source: ObjectSourceServeAdmission) -> DeployApplyPorts {
  DeployApplyPorts {
    object_source: fn() { source },
    command: fn(c) { observed(code: command_code, err: "cmd-boom") },
    stdin: fn(c, p) { observed(code: stdin_code, err: "stdin-boom") },
    ensure_directory: fn(t) { OwnedDirectoryEnsureRefused { target: t, reason: "ensure-refused" } },
    state_directories: fn(r) { grant_boom() },
    root_helper_snapshot: fn(l, sp, r, a) { root_grant_boom() },
    broker_tree: fn(r) { broker_tree_boom() },
    dependency: fn(d) { dependency_boom() },
    retract: retract_ports(),
  }
}

fn retract_ports() -> DeployRetractPorts {
  DeployRetractPorts {
    command: fn(c) { observed(code: 0, err: "") },
    remove: fn(t) { Converged { evidence: RemovedNoOp { path: "/x" as NonEmptyStr }, applied: t } },
    load: fn(u) { SystemdPropertyCaptured { value: systemd_unit_load_state_not_found_wire as String } },
  }
}

fn the_member() -> CapMember {
  CapMember { dropin_path: "/etc/systemd/system/gunbc-a.service.d/20-cap.conf" as NonEmptyStr, content: "[Service]\nMemoryMax=1G\n" }
}

fn authorized_here() -> DeployApplyPlan {
  let spec = deployment_spec_srv1()
  deploy_apply_memory_cap_plan(
    spec: spec,
    authorization: CapConvergeAuthorized {
      host: spec.target.host.identity,
      authorized_retiring: [],
      target_units: ["gunbc-a.service" as NonEmptyStr],
      desired: [the_member()],
    },
  )
}

fn authorized_legs() -> List<DeployApplyLeg> {
  match authorized_here() {
    ApplyPlanReady { legs: ls } => ls
    ApplyPlanRefused { step: _, reason: _ } => []
  }
}

// ORDER IS CONSTRUCTED: install, then ONE reload, then the revert.
test fn an_authorized_cap_plan_is_install_then_reload_then_revert() -> Bool {
  match authorized_legs() {
    Cons { head: a, tail: Cons { head: b, tail: Cons { head: c, tail: Empty } } } =>
      deploy_apply_leg_step(leg: a) == "memory-cap-install"
        && deploy_apply_leg_step(leg: b) == "memory-cap-reload"
        && deploy_apply_leg_step(leg: c) == "memory-cap-revert"
    Cons { head: _, tail: _ } => false
    Empty => false
  }
}

test fn a_withheld_authorization_is_a_report_leg_and_no_mutation() -> Bool {
  match deploy_apply_memory_cap_plan(spec: deployment_spec_srv1(), authorization: CapConvergeWithheld { cause: "no census" }) {
    ApplyPlanReady { legs: Cons { head: l, tail: Empty } } =>
      match l {
        ApplyLegReport { step: _, line: line } => string_contains(s: line, pattern: "__GUNBC_CONVERGE_WITHHELD__ memory-cap apply: no census")
        ApplyLegCommand { step: _, command: _ } => false
        ApplyLegInstallFile { step: _, command: _, payload: _ } => false
        ApplyLegInstallUnit { step: _, install: install } => false
        ApplyLegEnsureDirectory { target: _ } => false
        ApplyLegRepairDirectoryEntries { command: _ } => false
        ApplyLegBrokerStateDirectories { revision: _ } => false
        ApplyLegObjectSource => false
        ApplyLegRootHelperSnapshot { locus: _, spine: _, revision: _, action: _ } => false
        ApplyLegBrokerTree { revision: _ } => false
        ApplyLegRetract { step: _, leg: _ } => false
        ApplyLegDependency { dep: _ } => false
        ApplyLegDigestEnvFile { step: _, binary: _, env_name: _, dest: _, owner: _ } => false
        ApplyLegCredstoreCopy { step: _, source: _, dest: _, file_name: _ } => false
        ApplyLegDigestVerify { step: _, path: _, digest: _ } => false
        ApplyLegDiagnosedCommand { step: _, command: _, diagnosis: _ } => false
      }
    ApplyPlanReady { legs: _ } => false
    ApplyPlanRefused { step: _, reason: _ } => false
  }
}

// An authorization is evidence about ONE host: spent on another it refuses the plan.
test fn an_authorization_for_another_host_refuses_the_plan() -> Bool {
  match deploy_apply_memory_cap_plan(
    spec: deployment_spec_srv1(),
    authorization: CapConvergeAuthorized { host: "elsewhere" as HostIdentity, authorized_retiring: [], target_units: ["u.service" as NonEmptyStr], desired: [the_member()] },
  ) {
    ApplyPlanRefused { step: s, reason: _ } => s == "memory-cap"
    ApplyPlanReady { legs: _ } => false
  }
}

test fn an_authorization_with_no_units_refuses_rather_than_converging_nothing() -> Bool {
  let spec = deployment_spec_srv1()
  match deploy_apply_memory_cap_plan(
    spec: spec,
    authorization: CapConvergeAuthorized { host: spec.target.host.identity, authorized_retiring: [], target_units: [], desired: [the_member()] },
  ) {
    ApplyPlanRefused { step: s, reason: _ } => s == "memory-cap"
    ApplyPlanReady { legs: _ } => false
  }
}

test fn the_success_route_runs_every_leg_through_its_port() -> Bool {
  match deploy_apply_run_legs(legs: authorized_legs(), ports: ports(command_code: 0, stdin_code: 0)) {
    ApplyRunOk { legs_run: n, reports: _ } => n == 3
    ApplyRunFailed { step: _, reason: _, legs_run: _ } => false
  }
}

// The install leg reaches the STDIN port: a failing stdin port stops the run at the first leg, and a
// runner that dispatched it through the command port would report success here.
test fn the_install_leg_reaches_the_stdin_port_and_stops_the_run() -> Bool {
  match deploy_apply_run_legs(legs: authorized_legs(), ports: ports(command_code: 0, stdin_code: 4)) {
    ApplyRunFailed { step: s, reason: r, legs_run: n } => s == "memory-cap-install" && n == 0 && r == "exit 4: stdin-boom"
    ApplyRunOk { legs_run: _, reports: _ } => false
  }
}

// A reload failure dispatches no revert: legs_run counts only the install.
test fn a_mid_run_refusal_dispatches_no_later_leg() -> Bool {
  match deploy_apply_run_legs(legs: authorized_legs(), ports: ports(command_code: 5, stdin_code: 0)) {
    ApplyRunFailed { step: s, reason: _, legs_run: n } => s == "memory-cap-reload" && n == 1
    ApplyRunOk { legs_run: _, reports: _ } => false
  }
}

// The state-directories leg reaches its port: the port's refusal stops the run at the leg named broker-state-directories,
// and the install leg before it still ran.
test fn the_state_directories_leg_reaches_its_port_and_stops_the_run() -> Bool {
  match deploy_apply_run_legs(
    legs: [ApplyLegBrokerStateDirectories { revision: RevisionBoundAtEmission { revision: "0123456789abcdef0123456789abcdef01234567" as CommitSha } }],
    ports: ports(command_code: 0, stdin_code: 0),
  ) {
    ApplyRunFailed { step: s, reason: r, legs_run: n } => s == "broker-state-directories" && r == "grant-boom" && n == 0
    ApplyRunOk { legs_run: _, reports: _ } => false
  }
}

// The object-source leg reaches its port: a source that cannot serve stops the run before any later leg,
// with the admission's own sentence; one that can serve lets the next leg run.
test fn an_object_source_that_cannot_serve_dispatches_no_later_leg() -> Bool {
  match deploy_apply_run_legs(
    legs: [ApplyLegObjectSource, ApplyLegReport { step: "r", line: "l" }],
    ports: ports(command_code: 0, stdin_code: 0),
  ) {
    ApplyRunFailed { step: s, reason: r, legs_run: n } => s == "object-source" && string_contains(s: r, pattern: "source-boom") && n == 0
    ApplyRunOk { legs_run: _, reports: _ } => false
  }
}

test fn an_object_source_that_can_serve_lets_the_next_leg_run() -> Bool {
  match deploy_apply_run_legs(
    legs: [ApplyLegObjectSource, ApplyLegReport { step: "r", line: "l" }],
    ports: ports_serving(command_code: 0, stdin_code: 0, source: ObjectSourceCanServe { source: "/src" }),
  ) {
    ApplyRunOk { legs_run: n, reports: _ } => n == 2
    ApplyRunFailed { step: _, reason: _, legs_run: _ } => false
  }
}

test fn a_report_leg_dispatches_nothing_and_is_carried_to_the_verdict() -> Bool {
  match deploy_apply_run_legs(
    legs: [ApplyLegReport { step: "memory-cap", line: "withheld-line" }],
    ports: ports(command_code: 9, stdin_code: 9),
  ) {
    ApplyRunOk { legs_run: n, reports: rs } => n == 1 && count(rs) == 1
    ApplyRunFailed { step: _, reason: _, legs_run: _ } => false
  }
}

test fn the_verdict_carries_reports_then_the_receipt_line() -> Bool {
  match live_deploy_apply_verdict(run: ApplyRunOk { legs_run: 1, reports: ["w"] }, host: "srv1" as NonEmptyStr, intent: the_intent()) {
    Converged { evidence: _, applied: _ } => true
    NotConverged { reason: _, applied: _ } => false
  }
}

test fn a_failed_run_is_not_converged_and_names_its_step() -> Bool {
  match live_deploy_apply_verdict(run: ApplyRunFailed { step: "memory-cap-reload", reason: "exit 1", legs_run: 2 }, host: "srv1" as NonEmptyStr, intent: the_intent()) {
    NotConverged { reason: r, applied: _ } => string_contains(s: r, pattern: "refused at step memory-cap-reload after 2 completed legs")
    Converged { evidence: _, applied: _ } => false
  }
}

fn preamble_converged(p: NonEmptyStr) -> LiveDeployPreambleVerdict {
  PreambleConverged { principal: "p", dropin: "/d" as NonEmptyStr, legs_consumed: 1 }
}

fn preamble_refused(p: NonEmptyStr) -> LiveDeployPreambleVerdict {
  PreambleRefused { step: ScratchAcquire, reason: "no scratch", legs_consumed: 0 }
}

fn orchestrate(preamble: fn(NonEmptyStr) -> LiveDeployPreambleVerdict, plan: DeployApplyPlan, p: DeployApplyPorts, locus: Optional<String>) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  live_deploy_apply_orchestrate(
    locus_refusal: locus, prepare: fn() { DeployApplyPrepared { plan: plan, ports: p } }, principal: "gunbc-publication" as NonEmptyStr,
    preamble: preamble, host: "srv1" as NonEmptyStr, intent: the_intent(),
  )
}

test fn the_orchestration_converges_over_all_ports_ok() -> Bool {
  match orchestrate(preamble: preamble_converged, plan: authorized_here(), p: ports(command_code: 0, stdin_code: 0), locus: none) {
    Converged { evidence: _, applied: _ } => true
    NotConverged { reason: _, applied: _ } => false
  }
}

// With every port succeeding a run that dispatched any leg would converge; NotConverged naming the
// preamble step proves nothing ran after the preamble refused.
test fn a_preamble_refusal_dispatches_no_leg() -> Bool {
  match orchestrate(preamble: preamble_refused, plan: authorized_here(), p: ports(command_code: 0, stdin_code: 0), locus: none) {
    NotConverged { reason: r, applied: _ } => string_contains(s: r, pattern: "refused at preamble step") && string_contains(s: r, pattern: "no scratch")
    Converged { evidence: _, applied: _ } => false
  }
}

test fn a_plan_refusal_precedes_the_preamble_and_every_leg() -> Bool {
  match orchestrate(preamble: preamble_converged, plan: ApplyPlanRefused { step: "memory-cap", reason: "r" }, p: ports(command_code: 0, stdin_code: 0), locus: none) {
    NotConverged { reason: r, applied: _ } => string_contains(s: r, pattern: "refused at step memory-cap: r")
    Converged { evidence: _, applied: _ } => false
  }
}

test fn a_locus_refusal_is_returned_before_the_plan() -> Bool {
  match orchestrate(preamble: preamble_converged, plan: authorized_here(), p: ports(command_code: 0, stdin_code: 0), locus: Present { value: "locus-no" }) {
    NotConverged { reason: r, applied: _ } => r == "locus-no"
    Converged { evidence: _, applied: _ } => false
  }
}

test fn a_mid_run_refusal_through_the_orchestration_is_not_converged() -> Bool {
  match orchestrate(preamble: preamble_converged, plan: authorized_here(), p: ports(command_code: 5, stdin_code: 0), locus: none) {
    NotConverged { reason: r, applied: _ } => string_contains(s: r, pattern: "refused at step memory-cap-reload")
    Converged { evidence: _, applied: _ } => false
  }
}

fn observed_out(code: Int, out: String) -> RunArgvTransportOutcome {
  RunArgvTransportObserved { observed: ShellExecObserved { exit_code: code, success: code == 0, stdout: out, stderr: "" } }
}

fn ports_command_out(out: RunArgvTransportOutcome) -> DeployApplyPorts {
  DeployApplyPorts {
    object_source: fn() { ObjectSourceCanServe { source: "/src" } },
    command: fn(c) { out },
    stdin: fn(c, p) { observed(code: 0, err: "") },
    ensure_directory: fn(t) { OwnedDirectoryEnsureRefused { target: t, reason: "ensure-refused" } },
    state_directories: fn(r) { grant_boom() },
    root_helper_snapshot: fn(l, sp, r, a) { root_grant_boom() },
    broker_tree: fn(r) { broker_tree_boom() },
    dependency: fn(d) { dependency_boom() },
    retract: retract_ports(),
  }
}

fn digest_leg() -> DeployApplyLeg {
  ApplyLegDigestVerify { step: "d", path: "/x/gunbc", digest: sha256_digest(hex: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" as NonEmptyStr) }
}

// A digest leg passes only on the planned hex; a different digest, an unreadable file and an unparseable
// line each stop the run at the leg.
test fn a_matching_digest_passes_and_a_different_one_stops_the_run() -> Bool {
  let good = deploy_apply_run_legs(legs: [digest_leg()], ports: ports_command_out(out: observed_out(code: 0, out: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa  /x/gunbc\n")))
  let other = deploy_apply_run_legs(legs: [digest_leg()], ports: ports_command_out(out: observed_out(code: 0, out: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb  /x/gunbc\n")))
  match good {
    ApplyRunOk { legs_run: n, reports: _ } =>
      n == 1 && match other {
        ApplyRunFailed { step: s, reason: r, legs_run: k } => s == "d" && k == 0 && string_contains(s: r, pattern: "is not the planned")
        ApplyRunOk { legs_run: _, reports: _ } => false
      }
    ApplyRunFailed { step: _, reason: _, legs_run: _ } => false
  }
}

test fn an_unreadable_or_unparseable_digest_is_a_refusal_not_a_match() -> Bool {
  let unreadable = deploy_apply_run_legs(legs: [digest_leg()], ports: ports_command_out(out: observed(code: 1, err: "no such file")))
  let unparsed = deploy_apply_run_legs(legs: [digest_leg()], ports: ports_command_out(out: observed_out(code: 0, out: "garbage")))
  match unreadable {
    ApplyRunFailed { step: _, reason: r, legs_run: _ } =>
      string_contains(s: r, pattern: "could not read") && match unparsed {
        ApplyRunFailed { step: _, reason: q, legs_run: _ } => string_contains(s: q, pattern: "no digest")
        ApplyRunOk { legs_run: _, reports: _ } => false
      }
    ApplyRunOk { legs_run: _, reports: _ } => false
  }
}

// A diagnosed command that fails still fails the leg, and the reason carries the diagnosis output.
test fn a_failed_diagnosed_command_fails_with_the_diagnosis_attached() -> Bool {
  let spec = deployment_spec_srv1()
  match deploy_apply_tree_plan(spec: spec, plan: deploy_witness_full_install_plan(spec: spec), source_root: "/src") {
    ApplyPlanReady { legs: legs } =>
      match deploy_apply_run_legs(legs: skip(xs: legs, n: 10), ports: ports_command_out(out: observed_out(code: 3, out: "unit-status-line"))) {
        ApplyRunFailed { step: s, reason: r, legs_run: _ } => s == "tree-sync-restart" && string_contains(s: r, pattern: "control-process diagnosis") && string_contains(s: r, pattern: "unit-status-line")
        ApplyRunOk { legs_run: _, reports: _ } => false
      }
    ApplyPlanRefused { step: _, reason: _ } => false
  }
}

test fn the_tree_plan_ends_with_a_diagnosed_restart_then_the_readback() -> Bool {
  let spec = deployment_spec_srv1()
  match deploy_apply_tree_plan(spec: spec, plan: deploy_witness_full_install_plan(spec: spec), source_root: "/src") {
    ApplyPlanReady { legs: legs } =>
      count(legs) == 12 && deploy_apply_leg_step(leg: last_leg(legs: legs)) == "convergence-readback"
    ApplyPlanRefused { step: _, reason: _ } => false
  }
}

fn digest_hex_eq(a: Digest, b: Digest) -> Bool {
  let x: String = a.hex
  let y: String = b.hex
  x == y
}

fn last_leg(legs: List<DeployApplyLeg>) -> DeployApplyLeg {
  match legs {
    Cons { head: h, tail: Empty } => h
    Cons { head: _, tail: rest } => last_leg(legs: rest)
    Empty => ApplyLegObjectSource
  }
}

test fn the_executable_plan_verifies_the_source_before_and_the_install_after() -> Bool {
  let spec = deployment_spec_srv1()
  match deploy_apply_executable_plan(spec: spec, plan: deploy_witness_full_install_plan(spec: spec), source_root: "/src") {
    ApplyPlanReady { legs: Cons { head: first, tail: _ } } =>
      match first {
        ApplyLegDigestVerify { step: _, path: p, digest: d } => p == "/src/target/release/gunbc" && digest_hex_eq(a: d, b: deploy_witness_full_install_plan(spec: spec).target.executable)
        ApplyLegCommand { step: _, command: _ } => false
        ApplyLegInstallFile { step: _, command: _, payload: _ } => false
        ApplyLegInstallUnit { step: _, install: install } => false
        ApplyLegReport { step: _, line: _ } => false
        ApplyLegEnsureDirectory { target: _ } => false
        ApplyLegRepairDirectoryEntries { command: _ } => false
        ApplyLegBrokerStateDirectories { revision: _ } => false
        ApplyLegObjectSource => false
        ApplyLegRootHelperSnapshot { locus: _, spine: _, revision: _, action: _ } => false
        ApplyLegBrokerTree { revision: _ } => false
        ApplyLegRetract { step: _, leg: _ } => false
        ApplyLegDependency { dep: _ } => false
        ApplyLegDigestEnvFile { step: _, binary: _, env_name: _, dest: _, owner: _ } => false
        ApplyLegCredstoreCopy { step: _, source: _, dest: _, file_name: _ } => false
        ApplyLegDiagnosedCommand { step: _, command: _, diagnosis: _ } => false
      }
    ApplyPlanReady { legs: Empty } => false
    ApplyPlanRefused { step: _, reason: _ } => false
  }
}

// THE UNIT FAMILY. The selected attempt-worker sandbox (slice, then the launcher's root-owned grant) is
// installed before the serve unit, and the restart follows the unit it restarts.
fn step_index_from(legs: List<DeployApplyLeg>, step: String, i: Int) -> Int {
  match legs {
    Empty => 0 - 1
    Cons { head: h, tail: rest } => if deploy_apply_leg_step(leg: h) == step { i } else { step_index_from(legs: rest, step: step, i: i + 1) }
  }
}

fn step_index(legs: List<DeployApplyLeg>, step: String) -> Int {
  step_index_from(legs: legs, step: step, i: 0)
}

test fn the_unit_plan_installs_the_sandbox_grant_before_the_unit_and_restarts_after() -> Bool {
  let spec = deployment_spec_srv1()
  match deploy_apply_unit_plan(spec: spec, plan: deploy_witness_full_install_plan(spec: spec), oidc_now: Absent) {
    ApplyPlanReady { legs: legs } => {
      let slice = step_index(legs: legs, step: "attempt-worker-slice")
      let grant = step_index(legs: legs, step: "attempt-unit-helper-snapshot")
      let unit = step_index(legs: legs, step: "serve-unit")
      let restart = step_index(legs: legs, step: "serve-restart")
      slice >= 0 && slice < grant && grant < unit && unit < restart
    }
    ApplyPlanRefused { step: _, reason: _ } => false
  }
}

// An OIDC readback that cannot be decided (no observer clock) refuses the plan at the serve unit; it is
// never read as a unit with nothing to write.
test fn an_unreadable_oidc_clock_refuses_the_unit_plan() -> Bool {
  let spec = selected_deployment_spec(row: srv1_lab_desired_deployment())
  match deploy_apply_unit_plan(spec: spec, plan: deploy_witness_full_install_plan(spec: spec), oidc_now: Absent) {
    ApplyPlanRefused { step: s, reason: r } => s == "serve-unit" && string_contains(s: r, pattern: "observer clock unreadable")
    ApplyPlanReady { legs: _ } => false
  }
}

// The launcher grant's port refusal stops the run at that leg, and no later leg is dispatched.
test fn a_refused_launcher_grant_stops_the_run_before_the_serve_unit() -> Bool {
  let spec = deployment_spec_srv1()
  match deploy_apply_unit_plan(spec: spec, plan: deploy_witness_full_install_plan(spec: spec), oidc_now: Absent) {
    ApplyPlanReady { legs: legs } =>
      match deploy_apply_run_legs(legs: legs, ports: ports(command_code: 0, stdin_code: 0)) {
        ApplyRunFailed { step: s, reason: r, legs_run: n } =>
          s == "attempt-unit-helper-snapshot" && r == "root-grant-boom" && n == step_index(legs: legs, step: "attempt-unit-helper-snapshot")
        ApplyRunOk { legs_run: _, reports: _ } => false
      }
    ApplyPlanRefused { step: _, reason: _ } => false
  }
}

// THE MEMBERSHIP-EFFECT UPSERTS. The publication helper retires the leftover timer through the retract
// fold's own legs before it enables and restarts the path unit.
fn publication_legs() -> List<DeployApplyLeg> {
  let spec = deployment_spec_srv1()
  match deploy_apply_upsert_plan(kind: PublicationHelperPathUnit, path: deployment_publication_path_unit_path(names: spec.names), spec: spec, plan: deploy_witness_full_install_plan(spec: spec), source_root: "/src") {
    ApplyPlanReady { legs: ls } => ls
    ApplyPlanRefused { step: _, reason: _ } => []
  }
}

test fn the_publication_upsert_retires_the_timer_before_restarting_the_path_unit() -> Bool {
  let legs = publication_legs()
  let retire = step_index(legs: legs, step: "publication-timer-retire")
  retire > step_index(legs: legs, step: "publication-path-unit")
    && retire < step_index(legs: legs, step: "publication-path-restart")
    && deploy_apply_leg_step(leg: last_leg(legs: legs)) == "publication-path-restart"
}

// The retirement runs through the retract runner: with every port succeeding the whole upsert runs;
// with the argv port failing it stops at the first leg, which dispatches nothing after it.
test fn the_publication_upsert_runs_whole_and_stops_at_a_failing_leg() -> Bool {
  let legs = publication_legs()
  let ok_ports = DeployApplyPorts {
    object_source: fn() { ObjectSourceCanServe { source: "/src" } },
    command: fn(c) { observed(code: 0, err: "") },
    stdin: fn(c, p) { observed(code: 0, err: "") },
    ensure_directory: fn(t) { OwnedDirectoryEnsureRefused { target: t, reason: "ensure-refused" } },
    state_directories: fn(r) { grant_boom() },
    root_helper_snapshot: fn(l, sp, r, a) { root_grant_boom() },
    broker_tree: fn(r) { broker_tree_boom() },
    dependency: fn(d) { dependency_boom() },
    retract: retract_ports(),
  }
  match deploy_apply_run_legs(legs: legs, ports: ok_ports) {
    ApplyRunOk { legs_run: n, reports: _ } =>
      n == count(legs) && match deploy_apply_run_legs(legs: legs, ports: ports(command_code: 1, stdin_code: 0)) {
        ApplyRunFailed { step: s, reason: _, legs_run: k } => s == "publication-spool-root" && k == 0
        ApplyRunOk { legs_run: _, reports: _ } => false
      }
    ApplyRunFailed { step: _, reason: _, legs_run: _ } => false
  }
}

// THE DIGEST ENV FILE IS WRITTEN FROM THE INSTALLED BINARY'S BYTES: the read must name the installed path, and the
// payload written is exactly NAME=<that digest>. A read of any other path, or a payload carrying any other value,
// fails the run; an unparseable read stops the leg before the write.
fn env_leg() -> DeployApplyLeg {
  ApplyLegDigestEnvFile { step: "env", binary: "/locus/sidecar", env_name: "D", dest: "/locus/d.env", owner: "u" as NonEmptyStr }
}

fn env_ports(read_out: String) -> DeployApplyPorts {
  DeployApplyPorts {
    object_source: fn() { ObjectSourceCanServe { source: "/src" } },
    command: fn(c) { if any(c.arguments, a => a == "/locus/sidecar") { observed_out(code: 0, out: read_out) } else { observed(code: 1, err: "read another path") } },
    stdin: fn(c, p) { if p == "D=cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc\n" { observed(code: 0, err: "") } else { observed(code: 1, err: "wrong payload") } },
    ensure_directory: fn(t) { OwnedDirectoryEnsureRefused { target: t, reason: "ensure-refused" } },
    state_directories: fn(r) { grant_boom() },
    root_helper_snapshot: fn(l, sp, r, a) { root_grant_boom() },
    broker_tree: fn(r) { broker_tree_boom() },
    dependency: fn(d) { dependency_boom() },
    retract: retract_ports(),
  }
}

test fn the_digest_env_is_written_from_the_installed_binarys_digest_and_no_other() -> Bool {
  let good = deploy_apply_run_legs(legs: [env_leg()], ports: env_ports(read_out: "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc  /locus/sidecar\n"))
  let other = deploy_apply_run_legs(legs: [env_leg()], ports: env_ports(read_out: "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd  /locus/sidecar\n"))
  let unparsed = deploy_apply_run_legs(legs: [env_leg()], ports: env_ports(read_out: "garbage"))
  (match good { ApplyRunOk { legs_run: n, reports: _ } => n == 1  ApplyRunFailed { step: _, reason: _, legs_run: _ } => false })
    && (match other { ApplyRunFailed { step: s, reason: r, legs_run: _ } => s == "env" && string_contains(s: r, pattern: "wrong payload")  ApplyRunOk { legs_run: _, reports: _ } => false })
    && (match unparsed { ApplyRunFailed { step: _, reason: r, legs_run: _ } => string_contains(s: r, pattern: "no digest")  ApplyRunOk { legs_run: _, reports: _ } => false })
}

// ── ASSERTIONS RESTORED FROM THE DELETED SCRIPT-TEXT CLAIMS ──────────────────────────────────────────
//
// c11aa2317029 (#14660) deleted these claims with the bash apply script they read; the typed claims above
// fix the cap plan's SHAPE and order by step name, and at main head d2b027b5f41 a production mutation of
// WHAT each leg names left all of them green (audit table on #14824). Each is restored as its own claim.

fn leg_words(leg: DeployApplyLeg) -> List<String> {
  match leg {
    ApplyLegCommand { step: _, command: c } => argv_words(command: c)
    ApplyLegInstallFile { step: _, command: c, payload: _ } => argv_words(command: c)
    ApplyLegInstallUnit { step: _, install: install } => argv_words(command: apply_unit_install_command(install: install))
    ApplyLegDiagnosedCommand { step: _, command: c, diagnosis: _ } => argv_words(command: c)
    ApplyLegRepairDirectoryEntries { command: c } => argv_words(command: c)
    ApplyLegReport { step: _, line: _ } => []
    ApplyLegEnsureDirectory { target: _ } => []
    ApplyLegBrokerStateDirectories { revision: _ } => []
    ApplyLegObjectSource => []
    ApplyLegDigestVerify { step: _, path: _, digest: _ } => []
    ApplyLegRootHelperSnapshot { locus: _, spine: _, revision: _, action: _ } => []
    ApplyLegBrokerTree { revision: _ } => []
    ApplyLegRetract { step: _, leg: _ } => []
    ApplyLegDependency { dep: _ } => []
    ApplyLegDigestEnvFile { step: _, binary: _, env_name: _, dest: _, owner: _ } => []
    ApplyLegCredstoreCopy { step: _, source: _, dest: _, file_name: _ } => []
  }
}

// THE REVERT NAMES THE AUTHORIZED UNIT (was the_writer_reverts_only_the_authorized_target_units). The order
// claim fixes one revert for one unit; this fixes WHICH unit, so a revert spent on any other unit cannot pass.
test fn the_cap_revert_names_the_authorized_target_unit() -> Bool {
  match authorized_legs() {
    Cons { head: _, tail: Cons { head: _, tail: Cons { head: c, tail: Empty } } } =>
      deploy_apply_leg_step(leg: c) == "memory-cap-revert" && any(leg_words(leg: c), w => w == "gunbc-a.service")
    Cons { head: _, tail: _ } => false
    Empty => false
  }
}

// THE INSTALL WRITES THE AUTHORIZED MEMBER'S BYTES TO THAT MEMBER'S OWN DROP-IN (was
// witness_apply_script_wires_memory_cap_deploy_consumer). The run claims supply port answers and never read a
// payload, so an install that wrote nothing, or wrote it elsewhere, passed them.
test fn the_cap_install_writes_the_members_content_to_its_dropin() -> Bool {
  match authorized_legs() {
    Empty => false
    Cons { head: a, tail: _ } =>
      match a {
        ApplyLegInstallFile { step: _, command: c, payload: p } =>
          p == the_member().content && any(argv_words(command: c), w => w == (the_member().dropin_path as String))
        ApplyLegInstallUnit { step: _, install: _ } => false
        ApplyLegCommand { step: _, command: _ } => false
        ApplyLegReport { step: _, line: _ } => false
        ApplyLegEnsureDirectory { target: _ } => false
        ApplyLegRepairDirectoryEntries { command: _ } => false
        ApplyLegBrokerStateDirectories { revision: _ } => false
        ApplyLegObjectSource => false
        ApplyLegRootHelperSnapshot { locus: _, spine: _, revision: _, action: _ } => false
        ApplyLegBrokerTree { revision: _ } => false
        ApplyLegRetract { step: _, leg: _ } => false
        ApplyLegDependency { dep: _ } => false
        ApplyLegDigestEnvFile { step: _, binary: _, env_name: _, dest: _, owner: _ } => false
        ApplyLegCredstoreCopy { step: _, source: _, dest: _, file_name: _ } => false
        ApplyLegDigestVerify { step: _, path: _, digest: _ } => false
        ApplyLegDiagnosedCommand { step: _, command: _, diagnosis: _ } => false
      }
  }
}

fn belt_legs() -> List<DeployApplyLeg> {
  let spec = deployment_spec_srv1()
  match deploy_apply_upsert_plan(kind: BeltEventPathUnit, path: deployment_belt_exit_path_unit_path(names: spec.names), spec: spec, plan: deploy_witness_full_install_plan(spec: spec), source_root: "/src") {
    ApplyPlanReady { legs: ls } => ls
    ApplyPlanRefused { step: _, reason: _ } => []
  }
}

// THE BELT UPSERT RETIRES THE RETIRED BELT TIMER AFTER ITS OWN UNITS STAND (the belt half of
// apply_retires_leftover_belt_and_publication_timers_and_installs_publication_path; the publication half is
// the_publication_upsert_retires_the_timer_before_restarting_the_path_unit above). A belt install that left
// the retired timer loaded would keep firing the superseded entry beside the path units.
test fn the_belt_upsert_retires_the_retired_belt_timer_after_its_units_stand() -> Bool {
  let legs = belt_legs()
  let retire = step_index(legs: legs, step: "belt-retired-timer-retire")
  retire >= 0 && retire > step_index(legs: legs, step: "belt-daemon-reload")
}

// ── THE CREDSTORE COPY'S BRACKET (gunbc.live_deploy.apply_legs ApplyLegCredstoreCopy) ─────────────────
//
// The fold is pinned over a SUPPLIED command port that answers by program: mktemp prints a stage, and the copy
// (install), the root install (sudo), rm and rmdir each answer the code given. Each arm is the bracket's remedy:
// a failed copy is NotEntered with the root install never run (had it run, the arm would be Completed), a failed
// rmdir is a residue arm, and a stage that cannot be made enters nothing.
fn credstore_port(mktemp: Int, copy: Int, root: Int, rmdir: Int) -> fn(ArgvCommand) -> RunArgvTransportOutcome {
  fn(c) {
    match argv_words(command: c).first() {
      Absent => observed(code: 1, err: "")
      Present { value: p } =>
        if p == "mktemp" { observed_out(code: mktemp, out: "/tmp/gunbc-credstore.abc123\n") }
        else if p == "install" { observed(code: copy, err: "") }
        else if ends_with(s: p, suffix: "sudo") { observed(code: root, err: "") }
        else if p == "rmdir" { observed(code: rmdir, err: "") }
        else { observed(code: 0, err: "") }
    }
  }
}

fn credstore_run(port: fn(ArgvCommand) -> RunArgvTransportOutcome) -> CredstoreCopyBracket {
  credstore_copy_bracket(source: "/home/svc/k" as NonEmptyStr, dest: "/etc/credstore/k-lab" as NonEmptyStr, file_name: "k" as NonEmptyStr, run: port)
}

test fn the_credstore_copy_bracket_answers_each_remedy() -> Bool {
  (match credstore_run(port: credstore_port(mktemp: 0, copy: 0, root: 0, rmdir: 0)) { CredstoreCopyCompleted { installed: i } => i  _ => false })
    && (match credstore_run(port: credstore_port(mktemp: 0, copy: 0, root: 1, rmdir: 0)) { CredstoreCopyCompleted { installed: i } => !i  _ => false })
    && (match credstore_run(port: credstore_port(mktemp: 0, copy: 1, root: 0, rmdir: 0)) { CredstoreCopyNotEntered { cause: _ } => true  _ => false })
    && (match credstore_run(port: credstore_port(mktemp: 0, copy: 1, root: 0, rmdir: 1)) { CredstoreCopyNotEnteredResidueRemains { cause: _ } => true  _ => false })
    && (match credstore_run(port: credstore_port(mktemp: 0, copy: 0, root: 0, rmdir: 1)) { CredstoreCopyCompletedResidueRemains { installed: i } => i  _ => false })
    && (match credstore_run(port: credstore_port(mktemp: 1, copy: 0, root: 0, rmdir: 0)) { CredstoreCopyNotEntered { cause: _ } => true  _ => false })
}


// The real publication producer supplies both typed unit records. A broken executor
// that merely reports success without delivering stdin fails the refused-port control.
test fn typed_unit_installs_reach_the_existing_stdin_transport() -> Bool {
  let units = filter(publication_legs(), leg => match leg {
    ApplyLegInstallUnit { step: _, install: _ } => true
    _ => false
  })
  count(units) == 2 && match deploy_apply_run_legs(legs: units, ports: ports(command_code: 0, stdin_code: 0)) {
    ApplyRunFailed { step: _, reason: _, legs_run: _ } => false
    ApplyRunOk { legs_run: n, reports: _ } => n == 2 && match deploy_apply_run_legs(legs: units, ports: ports(command_code: 0, stdin_code: 4)) {
      ApplyRunOk { legs_run: _, reports: _ } => false
      ApplyRunFailed { step: _, reason: reason, legs_run: n } => n == 0 && string_contains(s: reason, pattern: "stdin-boom")
    }
  }
}

fn captured_unit_ports(blob: FabricBlobReading, bad_destination: Bool) -> DeployApplyPorts {
  let base = ports(command_code: 1, stdin_code: 1)
  let digest = fabric_blob_reading_digest(reading: blob).hex as String
  DeployApplyPorts {
    command: fn(c) { observed_out(code: 0, out: concat(
      if bad_destination && c == sha256sum_file_command(path: "/fixture/unit.service") {
        "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
      } else { digest }, "  /fixture/file\n")) },
    stdin: base.stdin, object_source: base.object_source, ensure_directory: base.ensure_directory,
    state_directories: base.state_directories, root_helper_snapshot: base.root_helper_snapshot,
    broker_tree: base.broker_tree, dependency: base.dependency, retract: base.retract,
  }
}

// The reading mint uses the existing committed empty-blob fixture and the blob
// owner's hermetic handlers. Installation runs only over supplied command ports.
test fn captured_unit_bytes_use_the_typed_file_copy_not_stdin_rendering() -> Bool {
  match read_staged_fabric_blob(path: "dag/test/fixture/fabric_blob/empty.bin") {
    FabricBlobReadRefused { fault: _ } => false
    FabricBlobRead { reading: blob } => {
      let install = DeploymentUnitInstall { manager: SystemManager, unit: "unit.service", destination: "/fixture/unit.service", file: CapturedUnitDocument { blob: blob } }
      match deploy_apply_run_legs(legs: [ApplyLegInstallUnit { step: "captured", install: install }], ports: captured_unit_ports(blob: blob, bad_destination: false)) {
        ApplyRunOk { legs_run: n, reports: _ } => n == 1 && any(apply_unit_install_command(install: install).arguments, word => word == "dag/test/fixture/fabric_blob/empty.bin")
        _ => false
      }
    }
  }
}

test fn captured_unit_destination_digest_mismatch_stops_apply() -> Bool {
  match read_staged_fabric_blob(path: "dag/test/fixture/fabric_blob/empty.bin") {
    FabricBlobReadRefused { fault: _ } => false
    FabricBlobRead { reading: blob } => {
      let install = DeploymentUnitInstall { manager: SystemManager, unit: "unit.service", destination: "/fixture/unit.service", file: CapturedUnitDocument { blob: blob } }
      match deploy_apply_run_legs(legs: [ApplyLegInstallUnit { step: "captured", install: install }], ports: captured_unit_ports(blob: blob, bad_destination: true)) {
        ApplyRunFailed { step: _, reason: _, legs_run: _ } => true
        _ => false
      }
    }
  }
}
