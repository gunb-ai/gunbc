module test.claim.live_deploy.srv1_serving_engine_unit_witness

import std.types { Bool, String, NonEmptyStr }
import std.algebra { length, string_contains }
import std.measure { gibibyte, gibibyte_to_byte_size }
import gunbc.fleet.fleet_host_identity { operator_host_srv1, operator_host_srv2 }
import gunbc.live_deploy.srv1_serving_engine_unit {
  srv1_serving_engine_hosted_on, srv1_serving_engine_retired_hand_units, srv1_replica_boot_unit_names,
  srv1_boot_outcome_admitted, srv1_boot_outcome_units, srv1_boot_outcome_refusal,
  srv1_replica_boot_unit_name,
  srv1_serving_engine_unit_name, srv1_serving_engine_unit_path,
  srv1_serving_engine_enable_link_path, srv1_serving_engine_wrapper_path,
}
import gunbc.serving.srv1_serving_replica_layout {
  srv1_serving_replica_roster, srv1_admitted_launch_config, Srv1LaunchConfig, Srv1KvCacheDtype,
}
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// The engine boot path is srv1's only: it is gated on srv1 and every retirement is srv1's.
test fn the_engine_boot_path_is_hosted_on_srv1_only() -> Bool {
  srv1_serving_engine_hosted_on(host: operator_host_srv1)
    && !srv1_serving_engine_hosted_on(host: operator_host_srv2)
    && all(srv1_serving_engine_retired_hand_units, r => (r.host as String) == (operator_host_srv1 as String))
}

// THE LEGACY SINGLETON IS RETIRED BY PATH: an entry whose unit is the legacy singleton retires its unit file,
// its WantedBy enablement link and the wrapper that started the gpu=all container -- so an apply removes any
// that remain, and because apply_legs installs nothing there is no leg that could put them back. The older
// hand unit (srv1-lil-serve.service) is retired alongside it.
test fn the_legacy_singleton_and_hand_unit_are_retired() -> Bool {
  let retired = srv1_serving_engine_retired_hand_units
  let singleton_retired = any(retired, r => (r.unit as String) == (srv1_serving_engine_unit_name as String)
    && any(r.paths, p => (p as String) == (srv1_serving_engine_unit_path() as String))
    && any(r.paths, p => (p as String) == (srv1_serving_engine_enable_link_path() as String))
    && any(r.paths, p => (p as String) == (srv1_serving_engine_wrapper_path as String)))
  let hand_retired = any(retired, r => (r.unit as String) == "srv1-lil-serve.service")
  singleton_retired && hand_retired
}

// THE BOOT INSTANCES DERIVE FROM THE ROSTER: one lil-replica@<index>.service per card, the instance number the
// replica index -- the same roster the router rows and the gpu.sh launcher argument come from, so the boot
// path and the router are one fact.
test fn the_boot_instances_derive_from_the_roster() -> Bool {
  let names = srv1_boot_outcome_units(outcome: srv1_replica_boot_unit_names(config: srv1_admitted_launch_config))
  let all_present = all(srv1_serving_replica_roster, r => any(names, n => (n as String) == (srv1_replica_boot_unit_name(replica: r) as String)))
  let count_ok = length(names) == length(srv1_serving_replica_roster)
  let matches_roster = any(names, n => (n as String) == "lil-replica@0.service")
    && any(names, n => (n as String) == "lil-replica@1.service")
  all_present && count_ok && matches_roster
}

// THE ADMISSION GUARD GATES WHAT BOOT ENABLES (the guard's production consumer): with the admitted srv1
// launch configuration convergence arms both replica instances; with a shape an active defect refuses (here
// TP=2 on a P2P-less host + nvfp4) the outcome is REFUSED -- apply_legs turns that into ApplyPlanRefused
// (the whole leg stops loudly, reason carrying the defect identity), never "no enables while green". The
// executing route is apply_legs -> srv1_replica_boot_unit_names -> srv1_launch_admission, so the guard is
// not witness-only: a refusal has a real consequence on the boot plan.
test fn the_admission_guard_gates_what_boot_enables() -> Bool {
  let admitted = srv1_replica_boot_unit_names(config: srv1_admitted_launch_config)
  let refused_shape = Srv1LaunchConfig {
    tensor_parallel_size: 2,
    kv_cache_dtype: NvFp4,
    profile: "qwen38-flash-next" as NonEmptyStr,
    hardware: "rtx-pro-6000-pcie" as NonEmptyStr,
    lmcache_l1: gibibyte_to_byte_size(g: gibibyte(count: 12)),
    max_model_len: 229376,
    image_digest: "sha256:2ad6245e058de7b4d0b973b08d60f67b18f563e4bd63d6a0e9b0406222a098e9" as NonEmptyStr,
    lil_replicas: 1,
    host_gpu_p2p: false,
    // The knob groups are the ADMITTED rows: this shape must be refused for its TP=2 / nvfp4 shape and for
    // nothing else, so everything unrelated to the refusal is taken from the admitted config rather than
    // re-typed here (a re-typed value could silently differ and the test would then prove less than it says).
    engine_executable: srv1_admitted_launch_config.engine_executable,
    lmcache_l2_placement: srv1_admitted_launch_config.lmcache_l2_placement,
    checkpoint_retention: srv1_admitted_launch_config.checkpoint_retention,
    tls_material: srv1_admitted_launch_config.tls_material,
    api_key_reference: srv1_admitted_launch_config.api_key_reference,
    container_port: srv1_admitted_launch_config.container_port,
  }
  let refused = srv1_replica_boot_unit_names(config: refused_shape)
  srv1_boot_outcome_admitted(outcome: admitted)
    && length(srv1_boot_outcome_units(outcome: admitted)) == length(srv1_serving_replica_roster)
    && !srv1_boot_outcome_admitted(outcome: refused)
    && length(srv1_boot_outcome_units(outcome: refused)) == 0
    && string_contains(s: srv1_boot_outcome_refusal(outcome: refused), pattern: "srv1-f24-b12x-pcie-allreduce-tp2-hang")
}
