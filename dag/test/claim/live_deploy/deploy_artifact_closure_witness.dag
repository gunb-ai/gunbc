module test.claim.live_deploy.deploy_artifact_closure_witness

// Roadmap node: deploy-intent-owns-artifact-closure (node://adhoc-3e6e9bfb-d59, identity
//   rn_Z0G9G30XDNQJG7QYJ0M6NAVY0T, dag/gunbc/roadmap/roadmap_authority.dag, landed by #16504).
//   red_control 2 (this witness): "A deploy whose intent omits an artifact a unit reads refuses
//   before any unit is enabled; RED for each artifact the closure does not yet own."
//   The controls verify the artifact-closure PRIMITIVE (generic verdict + gate + inventory), its
//   integration with the deploy enable authority (gunbc.live_deploy.spec deployment_owned_steps via
//   deployment_artifact_read_rows), and the first closed unit — the attempt-unit DRAIN — whose READ
//   derives from its own module (gunbc.roadmap.attempt_system_unit_launch attempt_unit_drain_read_paths).
//   The drain's INSTALLED/OWNED snapshot is fed to the gate by the named follow-up (wire gate last,
//   over the fully-closed roster), where it is derived from the apply-leg install authority; the
//   drain gate controls below exercise the gate against an explicit installed set for that reason.
//
//   CONTROLS (true = PASS, false = reject): each returns true when the guarantee holds.
//
//   EVIDENCE (receipt, also in the pull request): controls run with one
//   `gunbc run --source-root dag --source-root src --claim-run` per function on the authorized
//   base-matched seed (Rust = branch base da9e9f5, no src delta), sha256 900599bd3a81...

import std.types { CommitSha, NonEmptyStr }
import std.algebra { fold_list, list_map }
import std.list { list_member, list_cover, first_where }
import std.optional { Present, Absent }
import gunbc.live_deploy.deploy_artifact_closure {
  ArtifactReadSet, DeployReadRow, ReadRow, Declared, NotYetModeled, InstalledArtifact,
  ClosureVerdict, Allowed, Refused, Unclosed,
  DeployGateDecision, DeployHaltCause, Proceed, Halt, MissingArtifact, UnclosedRead,
  deploy_gate_decision, deploy_gate,
  unit_closure_verdict, deploy_closure_verdict, combine_closure_verdicts,
  first_missing_artifact, deploy_artifact_inventory, ArtifactInventoryRow, DerivedRow, UnclosedRow, InstalledArtifactRow
}
import gunbc.live_deploy.spec {
  DeploymentSpec, DeploymentArtifactStep, UpsertOwned, ServeBinary, GunbcSourceTree, AttemptUnitDrainPathUnit,
  SystemdUnit, TailnetDoorServeUnit, AgentDoorServeUnit, ApprovalBrokerFrontDoor,
  deployment_owned_steps
}
import gunbc.live_deploy.deploy_artifact_read_sets {
  deployment_artifact_read_rows, deployment_artifact_read_set
}
import gunbc.live_deploy.emit {
  live_deploy_serve_unit_file_over,
  live_deploy_tailnet_door_unit_file, live_deploy_agent_door_unit_file,
  live_deploy_tailnet_door_unit_file_for_closure, live_deploy_agent_door_unit_file_for_closure,
  live_deploy_approval_broker_unit_file_for_closure,
  live_deploy_approval_broker_unit_file,
  device_crypto_deployed_digest_env_file_path,
  LiveDeployTailnetDoorUnitEmitted, LiveDeployTailnetDoorUnitNotDeployed,
  LiveDeployTailnetDoorUnitOidcReadbackRefused,
}
import gunbc.live_deploy.unit_standing {
  service_directive_exec_start, service_directive_working_directory, argv0_of_command
}
import extdeps.systemd.unit_file { SystemdUnitFile, ServiceUnitFile }
import test.claim.live_deploy.apply_emission_projection { claim_oidc_now_for }
import gunbc.live_deploy.desired { deployment_spec_srv1 }
import gunbc.live_deploy.release_locus { RevisionBoundAtEmission, ReleaseRevisionBinding, release_locus_dir }
import gunbc.live_deploy.serve_binary { serve_binary_path }
import gunbc.roadmap.roadmap_dashboard_instance { srv1_live_dashboard_instance, HostDashboardInstance }
import gunbc.roadmap.attempt_system_unit_launch { attempt_system_unit_launcher_dir, attempt_system_unit_launcher_helpers_root }

// ── row / verdict helpers ──

fn eq_str(a: String, b: String) -> Bool { a == b }

fn row_located(row: DeployReadRow) -> String {
  match row { ReadRow { located: l, reads: _ } => l }
}

fn is_allowed(v: ClosureVerdict) -> Bool { match v { Allowed => true, _ => false } }
fn is_refused(v: ClosureVerdict) -> Bool { match v { Refused { located: _, artifact: _ } => true, _ => false } }
fn is_unclosed(v: ClosureVerdict) -> Bool { match v { Unclosed { located: _ } => true, _ => false } }

fn refused_names(v: ClosureVerdict, want_loc: String, want_art: String) -> Bool {
  match v {
    Refused { located: l, artifact: a } => l == want_loc && a == want_art
    _ => false
  }
}

fn count_of<A>(xs: List<A>) -> Int {
  fold_list(xs: xs, empty: 0, cons: fn(acc, _x) { acc + 1 })
}

fn path_list_of(steps: List<DeploymentArtifactStep>) -> List<String> {
  list_map(xs: steps, f: fn(s) { s.path as String })
}

fn row_path_list(rows: List<DeployReadRow>) -> List<String> {
  list_map(xs: rows, f: fn(r) { row_located(r) })
}

// ── srv1 fixtures (hermetic; the gate's installed set is the intent-owned set, no host snapshot) ──

fn srv1_inst() -> HostDashboardInstance { srv1_live_dashboard_instance() }

fn srv1_spec() -> DeploymentSpec { deployment_spec_srv1() }

fn srv1_rev() -> ReleaseRevisionBinding { RevisionBoundAtEmission { revision: "6f3cc6b38c2abcd0ef123456789abcdef0123456" as CommitSha } }

fn srv1_steps() -> List<DeploymentArtifactStep> {
  let spec = deployment_spec_srv1()
  deployment_owned_steps(instance: srv1_live_dashboard_instance(), names: spec.names, holding: spec.role_singletons, lab_plan: spec.target.lab_plan)
}

fn srv1_rows() -> List<DeployReadRow> {
  deployment_artifact_read_rows(steps: srv1_steps(), spec: srv1_spec(), instance: srv1_inst(), revision: srv1_rev())
}

// ── step-kind helpers (source-of-truth checks against the model's total match) ──

fn kind_is_serve(s: DeploymentArtifactStep) -> Bool {
  match s.kind { UpsertOwned { kind: ServeBinary } => true, _ => false }
}

fn kind_is_drain(s: DeploymentArtifactStep) -> Bool {
  match s.kind { UpsertOwned { kind: AttemptUnitDrainPathUnit } => true, _ => false }
}

fn read_is_exactly(rs: ArtifactReadSet, want: List<String>) -> Bool {
  match rs {
    Declared { paths: ps } => list_cover(held: ps, expected: want, eq: eq_str) && list_cover(held: want, expected: ps, eq: eq_str)
    NotYetModeled { reason: _ } => false
    InstalledArtifact => false
  }
}

fn reason_is_present(rs: ArtifactReadSet) -> Bool {
  match rs {
    Declared { paths: _ } => true
    NotYetModeled { reason: r } => r != ""
    InstalledArtifact => true
  }
}

fn serve_read_is_binary_and_tree(s: DeploymentArtifactStep) -> Bool {
  if kind_is_serve(s) { read_is_exactly(deployment_artifact_read_set(step: s, spec: srv1_spec(), instance: srv1_inst(), revision: srv1_rev()), [s.path as String, srv1_inst().repo_root as String]) } else { true }
}

// The serve binary loads `gunbc run --entry` from its WorkingDirectory (svc.repo_root = instance.repo_root),
// so the tree MUST be a Declared read on the serve row — a deploy that installs the tree elsewhere, or not
// at all, must go red. This control is what keeps the serve→tree dependency counted (review 95615).
fn serve_read_declares_the_tree(s: DeploymentArtifactStep) -> Bool {
  if kind_is_serve(s) {
    let tree = srv1_inst().repo_root as String
    match deployment_artifact_read_set(step: s, spec: srv1_spec(), instance: srv1_inst(), revision: srv1_rev()) {
      Declared { paths: ps } => list_member(xs: ps, x: tree, eq: eq_str)
      NotYetModeled { reason: _ } => false
      InstalledArtifact => false
    }
  } else { true }
}

fn kind_is_source_tree(s: DeploymentArtifactStep) -> Bool {
  match s.kind { UpsertOwned { kind: GunbcSourceTree } => true, _ => false }
}

fn installed_artifact_classification(s: DeploymentArtifactStep) -> Bool {
  if kind_is_source_tree(s) {
    match deployment_artifact_read_set(step: s, spec: srv1_spec(), instance: srv1_inst(), revision: srv1_rev()) {
      InstalledArtifact => true
      _ => false
    }
  } else { true }
}

fn drain_read_is_its_snapshot(s: DeploymentArtifactStep) -> Bool {
  let snap = attempt_system_unit_launcher_dir(instance: srv1_inst(), revision: srv1_rev())
  if kind_is_drain(s) { read_is_exactly(deployment_artifact_read_set(step: s, spec: srv1_spec(), instance: srv1_inst(), revision: srv1_rev()), [snap]) } else { true }
}

// ─────────────────────────────────────────────────────────────────────────────────
// GENERIC MECHANISM CONTROLS (rows built directly — test the primitive)
// ─────────────────────────────────────────────────────────────────────────────────

test fn allowed_when_every_declared_read_is_installed() -> Bool {
  let row = ReadRow { located: "/srv/gunbc/bin/gunbc", reads: Declared { paths: ["/srv/gunbc/bin/gunbc", "/opt/gunbc/helpers"] } }
  is_allowed(deploy_closure_verdict(rows: [row], installed: ["/srv/gunbc/bin/gunbc", "/opt/gunbc/helpers"]))
}

test fn refuses_naming_the_first_missing_artifact() -> Bool {
  let row = ReadRow { located: "/srv/gunbc/bin/gunbc", reads: Declared { paths: ["/srv/gunbc/bin/gunbc", "/opt/gunbc/helpers"] } }
  refused_names(deploy_closure_verdict(rows: [row], installed: ["/srv/gunbc/bin/gunbc"]), "/srv/gunbc/bin/gunbc", "/opt/gunbc/helpers")
}

test fn not_yet_modeled_is_unclosed_never_allowed() -> Bool {
  let row = ReadRow { located: "/etc/gunbc/oidc.json", reads: NotYetModeled { reason: "reader read-set not declared" } }
  is_unclosed(deploy_closure_verdict(rows: [row], installed: ["/etc/gunbc/oidc.json"]))
}

test fn refused_wins_over_unclosed_regardless_of_order() -> Bool {
  let unclosed_row = ReadRow { located: "/etc/gunbc/oidc.json", reads: NotYetModeled { reason: "reader read-set not declared" } }
  let refused_row = ReadRow { located: "/srv/gunbc/bin/gunbc", reads: Declared { paths: ["/srv/gunbc/bin/gunbc"] } }
  let installed_only_oidc = ["/etc/gunbc/oidc.json"]
  let order_unclosed_first = deploy_closure_verdict(rows: [unclosed_row, refused_row], installed: installed_only_oidc)
  let order_refused_first = deploy_closure_verdict(rows: [refused_row, unclosed_row], installed: installed_only_oidc)
  refused_names(order_unclosed_first, "/srv/gunbc/bin/gunbc", "/srv/gunbc/bin/gunbc") && refused_names(order_refused_first, "/srv/gunbc/bin/gunbc", "/srv/gunbc/bin/gunbc")
}

test fn first_missing_artifact_keeps_installed_fixed() -> Bool {
  match first_missing_artifact(artifacts: ["/a", "/b", "/c"], installed: ["/a", "/c"]) {
    Present { value: m } => m == "/b"
    Absent => false
  }
}

test fn inventory_maps_every_row_to_derived_or_unclosed() -> Bool {
  let rows = [
    ReadRow { located: "/a", reads: Declared { paths: ["/a"] } },
    ReadRow { located: "/b", reads: NotYetModeled { reason: "no reader declared" } }
  ]
  let inv = deploy_artifact_inventory(rows: rows)
  count_of(inv) == 2 && all(inv, fn(r) { match r { DerivedRow { located: _, artifacts: _ } => true, UnclosedRow { located: _, reason: _ } => true, InstalledArtifactRow { located: _ } => false } })
}

// ─────────────────────────────────────────────────────────────────────────────────
// INTEGRATION CONTROLS (driven by the deploy enable authority — srv1 roster)
// ─────────────────────────────────────────────────────────────────────────────────

test fn the_deploy_roster_is_one_read_row_per_enabled_step() -> Bool {
  let steps = srv1_steps()
  let rows = deployment_artifact_read_rows(steps: steps, spec: srv1_spec(), instance: srv1_inst(), revision: srv1_rev())
  let step_paths = path_list_of(steps)
  let row_paths = row_path_list(rows)
  count_of(steps) > 0 && count_of(rows) == count_of(steps) && list_cover(held: row_paths, expected: step_paths, eq: eq_str) && list_cover(held: step_paths, expected: row_paths, eq: eq_str)
}

test fn a_fresh_host_never_allows_the_whole_roster() -> Bool {
  let v = deploy_closure_verdict(rows: srv1_rows(), installed: [])
  !is_allowed(v) && (is_refused(v) || is_unclosed(v))
}

test fn the_serve_binary_step_read_is_declared_binary_and_tree() -> Bool {
  let steps = srv1_steps()
  any(steps, fn(s) { kind_is_serve(s) }) && all(steps, fn(s) { serve_read_is_binary_and_tree(s) })
}

test fn the_serve_binary_step_read_declares_the_source_tree() -> Bool {
  // Discriminating for review 95615: if the serve row dropped the tree read, the gate could pass a
  // deploy that installs the tree where serve does not read it. Serve MUST declare instance.repo_root.
  let steps = srv1_steps()
  any(steps, fn(s) { kind_is_serve(s) }) && all(steps, fn(s) { serve_read_declares_the_tree(s) })
}

test fn the_source_tree_step_is_an_installed_artifact_never_a_self_read() -> Bool {
  // The source-tree step is a located installed artifact, not a unit reading its own path: a read
  // of its own step.path would restate the install fact and never go red (rung inflation). The real
  // reader (serve's --entry, the tree converger) carries the TreeContent read on its own row.
  let steps = srv1_steps()
  any(steps, fn(s) { kind_is_source_tree(s) }) && all(steps, fn(s) { installed_artifact_classification(s) })
}

test fn every_enabled_step_is_declared_or_not_yet_modeled_with_a_reason() -> Bool {
  all(srv1_steps(), fn(s) { reason_is_present(deployment_artifact_read_set(step: s, spec: srv1_spec(), instance: srv1_inst(), revision: srv1_rev())) })
}

// ─────────────────────────────────────────────────────────────────────────────────
// DEPLOY-GATE CONTROLS — Unclosed halts lives in deploy_gate_decision, not a comment.
// ─────────────────────────────────────────────────────────────────────────────────

test fn unclosed_reads_halt_the_deploy_gate_never_proceeds() -> Bool {
  let row = ReadRow { located: "/etc/gunbc/oidc.json", reads: NotYetModeled { reason: "reader read-set not declared" } }
  match deploy_gate(rows: [row], installed: ["/etc/gunbc/oidc.json"]) {
    Proceed => false
    Halt { cause: UnclosedRead { located: "/etc/gunbc/oidc.json" } } => true
    Halt { cause: _ } => false
  }
}

test fn allowed_reads_proceed_and_missing_read_halts() -> Bool {
  let ok_row = ReadRow { located: "/srv/bin/gunbc", reads: Declared { paths: ["/srv/bin/gunbc"] } }
  let proceed_case = match deploy_gate(rows: [ok_row], installed: ["/srv/bin/gunbc"]) { Proceed => true, Halt { cause: _ } => false }
  let missing_case = match deploy_gate(rows: [ok_row], installed: []) { Halt { cause: MissingArtifact { located: "/srv/bin/gunbc", artifact: "/srv/bin/gunbc" } } => true, _ => false }
  proceed_case && missing_case
}

test fn the_fresh_host_gate_halts_the_roster_never_proceeds() -> Bool {
  match deploy_gate(rows: srv1_rows(), installed: []) { Proceed => false, Halt { cause: _ } => true }
}

// ─────────────────────────────────────────────────────────────────────────────────
// DRAIN CLOSURE (first closed unit) — the drain's READ derives from its own module
// authority (attempt_unit_drain_read_paths / launcher dir); the drain gate control feeds
// the gate an explicit installed set (the installed/owned side is the gate wiring's job,
// derived from the apply-leg install authority in the follow-up), so omitting the read
// refuses without depending on a read-derived owned list (red_control 2).
// ─────────────────────────────────────────────────────────────────────────────────

fn drain_step() -> DeploymentArtifactStep {
  DeploymentArtifactStep { kind: UpsertOwned { kind: AttemptUnitDrainPathUnit }, path: "/etc/systemd/system/gunbc-attempt-unit-drain.path" as NonEmptyStr }
}

test fn the_drain_read_is_its_helper_snapshot_from_its_own_authority() -> Bool {
  let snap = attempt_system_unit_launcher_dir(instance: srv1_inst(), revision: srv1_rev())
  read_is_exactly(deployment_artifact_read_set(step: drain_step(), spec: srv1_spec(), instance: srv1_inst(), revision: srv1_rev()), [snap])
}

test fn the_drain_gate_allows_when_snapshot_installed_and_refuses_when_absent() -> Bool {
  let snap = attempt_system_unit_launcher_dir(instance: srv1_inst(), revision: srv1_rev())
  let row = ReadRow { located: "/etc/systemd/system/gunbc-attempt-unit-drain.path", reads: Declared { paths: [snap] } }
  let ok = match deploy_gate(rows: [row], installed: [snap]) { Proceed => true, Halt { cause: _ } => false }
  let missing = match deploy_gate(rows: [row], installed: []) { Halt { cause: MissingArtifact { located: _, artifact: a } } => a == snap, _ => false }
  ok && missing
}

test fn the_drain_step_read_is_its_snapshot_when_present_in_the_roster() -> Bool {
  // Requires the drain step to be PRESENT in the srv1 roster via any(), so the control cannot pass
  // vacuously when the step is absent, and all() asserts every present drain step reads the launcher
  // snapshot dir. Together the roster really has the drain step and its read is the snapshot.
  any(srv1_steps(), fn(s) { kind_is_drain(s) }) && all(srv1_steps(), fn(s) { drain_read_is_its_snapshot(s) })
}

fn drain_not_admitted_by_parent(s: DeploymentArtifactStep) -> Bool {
  // The concrete arm reads the revision-bound snapshot <root>/<instance>/<revision>/..., NOT the
  // shared parent root. (1) its declared path is the concrete launcher dir and the parent is not it;
  let snap = attempt_system_unit_launcher_dir(instance: srv1_inst(), revision: srv1_rev())
  let reads_concrete_not_parent = match deployment_artifact_read_set(step: s, spec: srv1_spec(), instance: srv1_inst(), revision: srv1_rev()) {
    Declared { paths: ps } => list_member(xs: ps, x: snap, eq: eq_str) && !list_member(xs: ps, x: attempt_system_unit_launcher_helpers_root, eq: eq_str) && snap != attempt_system_unit_launcher_helpers_root
    _ => false
  }
  // (2) with ONLY the shared parent installed (the concrete <instance>/<revision> release absent), the
  // row must be Refused — not Allowed (the release is missing) and not Unclosed (the read IS modeled,
  // just unsatisfied) — and the gate must Halt naming the missing release path. This is the false
  // admission the side chat found in #16513: a row that declared the shared parent would Proceed here.
  let row = ReadRow { located: s.path as String, reads: deployment_artifact_read_set(step: s, spec: srv1_spec(), instance: srv1_inst(), revision: srv1_rev()) }
  let refused = match deploy_closure_verdict(rows: [row], installed: [attempt_system_unit_launcher_helpers_root]) {
    Refused { located: _, artifact: a } => a == snap
    _ => false
  }
  let halts = match deploy_gate(rows: [row], installed: [attempt_system_unit_launcher_helpers_root]) {
    Halt { cause: MissingArtifact { located: _, artifact: a } } => a == snap
    _ => false
  }
  reads_concrete_not_parent && refused && halts
}

test fn the_attempt_drain_release_is_not_admitted_by_the_shared_parent_alone() -> Bool {
  // The drain ExecStarts its helper at the revision-bound launcher locus <root>/<instance>/<revision>/...,
  // NOT the shared parent root. With the concrete arm the row is a Declared read of that concrete locus,
  // so with ONLY the shared parent installed and the requested release absent the row is Refused (not
  // Unclosed, not Allowed) and the gate Halts naming the missing release path. Non-vacuous via any():
  // it requires a drain step present in the srv1 roster, and goes red if the arm ever re-declares the
  // shared parent (the false admission the side chat found in #16513).
  any(srv1_steps(), fn(s) { if kind_is_drain(s) { drain_not_admitted_by_parent(s) } else { false } })
}


// ─────────────────────────────────────────────────────────────────────────────────
// EXEC-START-DERIVED READ CONTROLS (item 1). The service units' argv[0] (ExecStart
// binary) and WorkingDirectory are read from the typed SystemdUnitFile the deploy
// emits, through gunbc.live_deploy.unit_standing (service_directive_exec_start /
// service_directive_working_directory) — NOT re-spelled here. The (B) controls assert
// the closure's per-unit accessor and the real emitted file agree, so a drift in the
// emit path goes red rather than letting the gate read a binary nobody installs.
// ─────────────────────────────────────────────────────────────────────────────────

fn kind_is_systemd_unit(s: DeploymentArtifactStep) -> Bool { match s.kind { ComposeOwned { kind: SystemdUnit } => true, _ => false } }
fn kind_is_broker(s: DeploymentArtifactStep) -> Bool { match s.kind { UpsertOwned { kind: ApprovalBrokerFrontDoor } => true, _ => false } }
fn kind_is_tailnet_door(s: DeploymentArtifactStep) -> Bool { match s.kind { ComposeOwned { kind: TailnetDoorServeUnit } => true, _ => false } }
fn kind_is_agent_door(s: DeploymentArtifactStep) -> Bool { match s.kind { ComposeOwned { kind: AgentDoorServeUnit } => true, _ => false } }

// The installed serve binary: the path the ServeBinary step installs. Every deploy service unit runs
// `gunbc run --entry ...`, so its ExecStart argv[0] is THIS binary. If a unit names another binary,
// that read is not an installed artifact and the gate must refuse — the discriminating check below.
fn installed_serve_binary() -> String {
  match first_where(xs: srv1_steps(), keep: fn(s) { kind_is_serve(s) }) {
    Present { value: s } => s.path as String
    Absent => ""
  }
}

// TEST ORACLES: independently parse a unit file's ExecStart argv[0] and WorkingDirectory straight from the
// typed service directives, NOT through the classifier. unit_files_agree_on_reads uses these to check the
// emitted file and the closure-accessor file parse identically (a file-vs-file agreement check); keeping
// this a separate route from the classifier means a classifier bug is not mirrored on the expectation side.
fn unit_argv0(f: SystemdUnitFile) -> String {
  match f {
    ServiceUnitFile { unit: _, service: ds, install: _ } =>
      match service_directive_exec_start(directives: ds) {
        Present { value: cmd } => match argv0_of_command(cmd) { Present { value: b } => b, Absent => "" }
        Absent => ""
      }
    _ => ""
  }
}

fn unit_wd(f: SystemdUnitFile) -> String {
  match f {
    ServiceUnitFile { unit: _, service: ds, install: _ } =>
      match service_directive_working_directory(directives: ds) { Present { value: w } => w, Absent => "" }
    _ => ""
  }
}

// The broker's expected reads, spelled from the EMITTER'S OWN producing authorities -- the exact functions
// live_deploy_approval_broker_serve_unit_file uses to WRITE those directives -- NOT parsed from the unit
// file and NOT via the classifier. This makes the broker controls independent of the classifier's argv[0]
// split: if the split is wrong, the classifier's derived set diverges from these authority values and the
// equality goes RED (whereas a file-parse expectation would be wrong on both sides together).
fn broker_expected_binary() -> String {
  serve_binary_path(binary: srv1_spec().approval_broker.serve_binary, release_root: srv1_spec().approval_broker.repo_root as String, revision: srv1_rev())
}

fn broker_expected_wd() -> String {
  release_locus_dir(root: srv1_spec().approval_broker.repo_root as String, revision: srv1_rev())
}

fn broker_expected_env() -> String {
  device_crypto_deployed_digest_env_file_path(root: srv1_spec().approval_broker.repo_root as String, revision: srv1_rev())
}

fn unit_files_agree_on_reads(a: SystemdUnitFile, b: SystemdUnitFile) -> Bool {
  unit_argv0(a) == unit_argv0(b) && unit_wd(a) == unit_wd(b)
}

// THE SERVE UNIT reads the installed serve binary (its own argv[0]). RED if its ExecStart names a
// binary the deploy does not install.
test fn the_serve_unit_reads_the_installed_serve_binary() -> Bool {
  let want = installed_serve_binary()
  let f = live_deploy_serve_unit_file_over(spec: srv1_spec(), revision: srv1_rev(), oidc_env: [])
  want != "" && unit_argv0(f) == want
}

// THE BROKER runs its OWN serve binary (serve_binary_path over spec.approval_broker's source), which on
// the srv1 fixture is NOT the served ServeBinary step path — so the honest item-1 property is that the
// adapter records exactly what the broker emits: its argv[0] and WorkingDirectory, read from its own
// typed file. The broker is an always-enabled role singleton, so srv1 MUST own an ApprovalBrokerFrontDoor
// step — a missing step is a fixture defect (false), not a silent pass (guarantee_ladder: no decoration).
// RED if the adapter drops either or fabricates a different path. Whether the intent OWNS
// that binary is the wired gate's concern (item 5): a broker naming a binary no step installs must then
// be refused, not silently allowed here.
test fn the_broker_read_set_is_derived_from_its_own_unit_file() -> Bool {
  // expected start binary + WorkingDirectory from the EMITTER'S OWN authorities (not parsed from the file)
  let binary = broker_expected_binary()
  let wd = broker_expected_wd()
  match first_where(xs: srv1_steps(), keep: fn(s) { kind_is_broker(s) }) {
    Present { value: s } => match deployment_artifact_read_set(step: s, spec: srv1_spec(), instance: srv1_inst(), revision: srv1_rev()) {
      // the broker's declared reads are derived from its own unit file and CONTAIN the start binary and
      // its WorkingDirectory. It is no longer asserted to be EXACTLY those two: the unit also carries a
      // required EnvironmentFile (see the_broker_refuses_when_its_required_env_file_is_absent).
      Declared { paths: paths } =>
        binary != ""
        && list_member(xs: paths, x: binary, eq: eq_str)
        && list_member(xs: paths, x: wd, eq: eq_str)
      _ => false
    }
    Absent => false
  }
}

// F1 (side-chat, exec-extractor PR): the broker unit carries a REQUIRED EnvironmentFile -- the
// device-crypto digest env file, written by its own ApplyLegDigestEnvFile apply leg. Before this change
// the unit's read set declared only argv[0] + WorkingDirectory, so with the binary and its directory
// installed and the digest env file ABSENT, the broker row read Allowed and the gate Proceeded -- a
// false admission. The read set is now derived by ONE exhaustive match over SystemdServiceDirective
// (gunbc.live_deploy.unit_standing::service_directive_required_reads), which declares the required
// EnvironmentFile. STRENGTHENED (per the manager): the derived read set must EQUAL the independently
// spelled set {start binary, WorkingDirectory, digest env file} -- the env path comes from
// device_crypto_deployed_digest_env_file_path over the spec's broker root, NOT from the derived set -- so
// a char-split, a dropped path, or a spurious element goes RED, not just a dropped EnvironmentFile. Then,
// through the real broker adapter: with only the binary and directory installed the row is Refused and the
// gate Halts naming that env file; with the complete installed set it is Allowed and the gate Proceeds.
test fn the_broker_refuses_when_its_required_env_file_is_absent() -> Bool {
  // expected values from the EMITTER'S OWN producing authorities -- independent of the classifier's split
  let binary = broker_expected_binary()
  let wd = broker_expected_wd()
  let env = broker_expected_env()
  let expected = [binary, wd, env]
  match first_where(xs: srv1_steps(), keep: fn(s) { kind_is_broker(s) }) {
    Absent => false
    Present { value: s } => match deployment_artifact_read_set(step: s, spec: srv1_spec(), instance: srv1_inst(), revision: srv1_rev()) {
      Declared { paths: paths } =>
        let row = ReadRow { located: s.path as String, reads: Declared { paths: paths } }
        let partial = [binary, wd]
        let same_set = list_cover(held: paths, expected: expected, eq: eq_str) && list_cover(held: expected, expected: paths, eq: eq_str)
        let refused_names_env = match deploy_closure_verdict(rows: [row], installed: partial) {
          Refused { located: _, artifact: a } => a == env
          _ => false
        }
        let halts_names_env = match deploy_gate(rows: [row], installed: partial) {
          Halt { cause: MissingArtifact { located: _, artifact: a } } => a == env
          _ => false
        }
        let allowed = match deploy_closure_verdict(rows: [row], installed: expected) {
          Allowed => true
          _ => false
        }
        let proceeds = match deploy_gate(rows: [row], installed: expected) {
          Proceed => true
          _ => false
        }
        same_set && refused_names_env && halts_names_env && allowed && proceeds
      _ => false
    }
  }
}

// (B) THE BROKER CLOSURE ACCESSOR == THE EMITTED FILE on argv[0]/WorkingDirectory. The accessor and
// the deploy wrapper share one producer (live_deploy_approval_broker_unit_file_on); the closure's
// sentinel broker_base_url feeds only an Environment directive, so agreement proves the closure reads
// the SAME process the deploy installs.
test fn the_broker_closure_accessor_equals_the_emitted_file_reads() -> Bool {
  let accessor = live_deploy_approval_broker_unit_file_for_closure(spec: srv1_spec(), revision: srv1_rev())
  let emitted = live_deploy_approval_broker_unit_file(spec: srv1_spec(), revision: srv1_rev(), broker_base_url: "https://broker.invalid" as NonEmptyStr)
  unit_files_agree_on_reads(a: accessor, b: emitted)
}

// (B) THE TAILNET DOOR CLOSURE ACCESSOR == THE EMITTED FILE. The expectation is tied to the ROSTER (the
// enable authority): a tailnet door the roster enables MUST be admitted by the emitter and compared on
// argv[0]/WorkingDirectory — a fixture that stops admitting (NotDeployed/Refused) while the roster still
// enables the door is a fixture defect and goes RED, it is never a silent pass. Only when the roster does
// NOT enable the door may the emitter be NotDeployed, and then the accessor must be absent too (they share
// the socket gate). A Present/Emitted disagreement is red.
test fn the_tailnet_door_closure_accessor_agrees_with_the_emitter() -> Bool {
  let roster_enables = any(xs: srv1_steps(), predicate: fn(s) { kind_is_tailnet_door(s) })
  let emitted = live_deploy_tailnet_door_unit_file(spec: srv1_spec(), revision: srv1_rev(), now_epoch: claim_oidc_now_for(spec: srv1_spec()))
  let accessor = live_deploy_tailnet_door_unit_file_for_closure(spec: srv1_spec(), revision: srv1_rev())
  match emitted {
    LiveDeployTailnetDoorUnitEmitted { file: e } => match accessor {
      Present { value: a } => unit_files_agree_on_reads(a: e, b: a)
      Absent => false
    }
    LiveDeployTailnetDoorUnitNotDeployed => !roster_enables && match accessor { Absent => true, Present { value: _ } => false }
    LiveDeployTailnetDoorUnitOidcReadbackRefused { cause: _ } => false
  }
}

// (B) THE AGENT DOOR CLOSURE ACCESSOR == THE EMITTED FILE. Same roster-tied contract as the tailnet door.
test fn the_agent_door_closure_accessor_agrees_with_the_emitter() -> Bool {
  let roster_enables = any(xs: srv1_steps(), predicate: fn(s) { kind_is_agent_door(s) })
  let emitted = live_deploy_agent_door_unit_file(spec: srv1_spec(), revision: srv1_rev(), now_epoch: claim_oidc_now_for(spec: srv1_spec()))
  let accessor = live_deploy_agent_door_unit_file_for_closure(spec: srv1_spec(), revision: srv1_rev())
  match emitted {
    LiveDeployTailnetDoorUnitEmitted { file: e } => match accessor {
      Present { value: a } => unit_files_agree_on_reads(a: e, b: a)
      Absent => false
    }
    LiveDeployTailnetDoorUnitNotDeployed => !roster_enables && match accessor { Absent => true, Present { value: _ } => false }
    LiveDeployTailnetDoorUnitOidcReadbackRefused { cause: _ } => false
  }
}

// THE ROSTER AGREEMENT (adapter wiring, not just the extractor): the always-on serve unit the roster
// enables reports a Declared read-set containing the installed serve binary (its own argv[0]). RED if
// the adapter stops sourcing the serve unit's ExecStart, or its binary drifts off the installed one.
test fn the_serve_unit_row_reads_the_installed_serve_binary() -> Bool {
  let want = installed_serve_binary()
  all(srv1_steps(), fn(s) {
    if kind_is_systemd_unit(s) {
      match deployment_artifact_read_set(step: s, spec: srv1_spec(), instance: srv1_inst(), revision: srv1_rev()) {
        Declared { paths: ps } => list_member(xs: ps, x: want, eq: eq_str)
        NotYetModeled { reason: _ } => false
        InstalledArtifact => false
      }
    } else { true }
  })
}
