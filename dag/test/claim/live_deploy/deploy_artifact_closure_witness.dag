module test.claim.live_deploy.deploy_artifact_closure_witness

// Roadmap node: deploy-intent-owns-artifact-closure (node://adhoc-3e6e9bfb-d59, identity
//   rn_Z0G9G30XDNQJG7QYJ0M6NAVY0T, dag/gunbc/roadmap/roadmap_authority.dag, landed by #16504).
//   red_control 2 (this witness): "A deploy whose intent omits an artifact a unit reads refuses
//   before any unit is enabled; RED for each artifact the closure does not yet own."
//   The controls verify the artifact-closure PRIMITIVE (generic verdict + gate + inventory), its
//   integration with the deploy enable authority (gunbc.live_deploy.spec deployment_owned_steps via
//   deployment_artifact_read_rows), and the first closed unit — the attempt-unit DRAIN — whose READ
//   derives from its own module (gunbc.roadmap.attempt_system_unit_launch attempt_unit_drain_read_paths).
//   The drain's INSTALLED/OWNED snapshot is fed to the gate by the named follow-up (wire gate last,
//   over the fully-closed roster), where it is derived from the apply-leg install authority; the
//   drain gate controls below exercise the gate against an explicit installed set for that reason.
//
//   CONTROLS (true = PASS, false = reject): each returns true when the guarantee holds.
//
//   EVIDENCE (receipt, also in the pull request): controls run with one
//   `gunbc run --source-root dag --source-root src --claim-run` per function on the authorized
//   base-matched seed (Rust = branch base da9e9f5, no src delta), sha256 900599bd3a81...

import std.types { CommitSha, NonEmptyStr }
import std.algebra { fold_list, list_map }
import std.list { list_member, list_cover }
import std.optional { Present, Absent }
import gunbc.live_deploy.deploy_artifact_closure {
  ArtifactReadSet, DeployReadRow, ReadRow, Declared, NotYetModeled, InstalledArtifact,
  ClosureVerdict, Allowed, Refused, Unclosed,
  DeployGateDecision, DeployHaltCause, Proceed, Halt, MissingArtifact, UnclosedRead,
  deploy_gate_decision, deploy_gate,
  unit_closure_verdict, deploy_closure_verdict, combine_closure_verdicts,
  first_missing_artifact, deploy_artifact_inventory, ArtifactInventoryRow, DerivedRow, UnclosedRow, InstalledArtifactRow
}
import gunbc.live_deploy.spec {
  DeploymentArtifactStep, UpsertOwned, ServeBinary, GunbcSourceTree, AttemptUnitDrainPathUnit,
  deployment_owned_steps
}
import gunbc.live_deploy.deploy_artifact_read_sets {
  deployment_artifact_read_rows, deployment_artifact_read_set
}
import gunbc.live_deploy.desired { deployment_spec_srv1 }
import gunbc.live_deploy.release_locus { RevisionBoundAtEmission, ReleaseRevisionBinding }
import gunbc.roadmap.roadmap_dashboard_instance { srv1_live_dashboard_instance, HostDashboardInstance }
import gunbc.roadmap.attempt_system_unit_launch { attempt_system_unit_launcher_dir, attempt_system_unit_launcher_helpers_root }

// ── row / verdict helpers ──

fn eq_str(a: String, b: String) -> Bool { a == b }

fn row_located(row: DeployReadRow) -> String {
  match row { ReadRow { located: l, reads: _ } => l }
}

fn is_allowed(v: ClosureVerdict) -> Bool { match v { Allowed => true, _ => false } }
fn is_refused(v: ClosureVerdict) -> Bool { match v { Refused { located: _, artifact: _ } => true, _ => false } }
fn is_unclosed(v: ClosureVerdict) -> Bool { match v { Unclosed { located: _ } => true, _ => false } }

fn refused_names(v: ClosureVerdict, want_loc: String, want_art: String) -> Bool {
  match v {
    Refused { located: l, artifact: a } => l == want_loc && a == want_art
    _ => false
  }
}

fn count_of<A>(xs: List<A>) -> Int {
  fold_list(xs: xs, empty: 0, cons: fn(acc, _x) { acc + 1 })
}

fn path_list_of(steps: List<DeploymentArtifactStep>) -> List<String> {
  list_map(xs: steps, f: fn(s) { s.path as String })
}

fn row_path_list(rows: List<DeployReadRow>) -> List<String> {
  list_map(xs: rows, f: fn(r) { row_located(r) })
}

// ── srv1 fixtures (hermetic; the gate's installed set is the intent-owned set, no host snapshot) ──

fn srv1_inst() -> HostDashboardInstance { srv1_live_dashboard_instance() }

fn srv1_rev() -> ReleaseRevisionBinding { RevisionBoundAtEmission { revision: "6f3cc6b38c2abcd0ef123456789abcdef0123456" as CommitSha } }

fn srv1_steps() -> List<DeploymentArtifactStep> {
  let spec = deployment_spec_srv1()
  deployment_owned_steps(instance: srv1_live_dashboard_instance(), names: spec.names, holding: spec.role_singletons, lab_plan: spec.target.lab_plan)
}

fn srv1_rows() -> List<DeployReadRow> {
  deployment_artifact_read_rows(steps: srv1_steps(), instance: srv1_inst(), revision: srv1_rev())
}

// ── step-kind helpers (source-of-truth checks against the model's total match) ──

fn kind_is_serve(s: DeploymentArtifactStep) -> Bool {
  match s.kind { UpsertOwned { kind: ServeBinary } => true, _ => false }
}

fn kind_is_drain(s: DeploymentArtifactStep) -> Bool {
  match s.kind { UpsertOwned { kind: AttemptUnitDrainPathUnit } => true, _ => false }
}

fn read_is_exactly(rs: ArtifactReadSet, want: List<String>) -> Bool {
  match rs {
    Declared { paths: ps } => list_cover(held: ps, expected: want, eq: eq_str) && list_cover(held: want, expected: ps, eq: eq_str)
    NotYetModeled { reason: _ } => false
    InstalledArtifact => false
  }
}

fn reason_is_present(rs: ArtifactReadSet) -> Bool {
  match rs {
    Declared { paths: _ } => true
    NotYetModeled { reason: r } => r != ""
    InstalledArtifact => true
  }
}

fn serve_read_is_binary_and_tree(s: DeploymentArtifactStep) -> Bool {
  if kind_is_serve(s) { read_is_exactly(deployment_artifact_read_set(step: s, instance: srv1_inst(), revision: srv1_rev()), [s.path as String, srv1_inst().repo_root as String]) } else { true }
}

// The serve binary loads `gunbc run --entry` from its WorkingDirectory (svc.repo_root = instance.repo_root),
// so the tree MUST be a Declared read on the serve row — a deploy that installs the tree elsewhere, or not
// at all, must go red. This control is what keeps the serve→tree dependency counted (review 95615).
fn serve_read_declares_the_tree(s: DeploymentArtifactStep) -> Bool {
  if kind_is_serve(s) {
    let tree = srv1_inst().repo_root as String
    match deployment_artifact_read_set(step: s, instance: srv1_inst(), revision: srv1_rev()) {
      Declared { paths: ps } => list_member(xs: ps, x: tree, eq: eq_str)
      NotYetModeled { reason: _ } => false
      InstalledArtifact => false
    }
  } else { true }
}

fn kind_is_source_tree(s: DeploymentArtifactStep) -> Bool {
  match s.kind { UpsertOwned { kind: GunbcSourceTree } => true, _ => false }
}

fn installed_artifact_classification(s: DeploymentArtifactStep) -> Bool {
  if kind_is_source_tree(s) {
    match deployment_artifact_read_set(step: s, instance: srv1_inst(), revision: srv1_rev()) {
      InstalledArtifact => true
      _ => false
    }
  } else { true }
}

fn drain_read_is_its_snapshot(s: DeploymentArtifactStep) -> Bool {
  let snap = attempt_system_unit_launcher_dir(instance: srv1_inst(), revision: srv1_rev())
  if kind_is_drain(s) { read_is_exactly(deployment_artifact_read_set(step: s, instance: srv1_inst(), revision: srv1_rev()), [snap]) } else { true }
}

// ─────────────────────────────────────────────────────────────────────────────────
// GENERIC MECHANISM CONTROLS (rows built directly — test the primitive)
// ─────────────────────────────────────────────────────────────────────────────────

test fn allowed_when_every_declared_read_is_installed() -> Bool {
  let row = ReadRow { located: "/srv/gunbc/bin/gunbc", reads: Declared { paths: ["/srv/gunbc/bin/gunbc", "/opt/gunbc/helpers"] } }
  is_allowed(deploy_closure_verdict(rows: [row], installed: ["/srv/gunbc/bin/gunbc", "/opt/gunbc/helpers"]))
}

test fn refuses_naming_the_first_missing_artifact() -> Bool {
  let row = ReadRow { located: "/srv/gunbc/bin/gunbc", reads: Declared { paths: ["/srv/gunbc/bin/gunbc", "/opt/gunbc/helpers"] } }
  refused_names(deploy_closure_verdict(rows: [row], installed: ["/srv/gunbc/bin/gunbc"]), "/srv/gunbc/bin/gunbc", "/opt/gunbc/helpers")
}

test fn not_yet_modeled_is_unclosed_never_allowed() -> Bool {
  let row = ReadRow { located: "/etc/gunbc/oidc.json", reads: NotYetModeled { reason: "reader read-set not declared" } }
  is_unclosed(deploy_closure_verdict(rows: [row], installed: ["/etc/gunbc/oidc.json"]))
}

test fn refused_wins_over_unclosed_regardless_of_order() -> Bool {
  let unclosed_row = ReadRow { located: "/etc/gunbc/oidc.json", reads: NotYetModeled { reason: "reader read-set not declared" } }
  let refused_row = ReadRow { located: "/srv/gunbc/bin/gunbc", reads: Declared { paths: ["/srv/gunbc/bin/gunbc"] } }
  let installed_only_oidc = ["/etc/gunbc/oidc.json"]
  let order_unclosed_first = deploy_closure_verdict(rows: [unclosed_row, refused_row], installed: installed_only_oidc)
  let order_refused_first = deploy_closure_verdict(rows: [refused_row, unclosed_row], installed: installed_only_oidc)
  refused_names(order_unclosed_first, "/srv/gunbc/bin/gunbc", "/srv/gunbc/bin/gunbc") && refused_names(order_refused_first, "/srv/gunbc/bin/gunbc", "/srv/gunbc/bin/gunbc")
}

test fn first_missing_artifact_keeps_installed_fixed() -> Bool {
  match first_missing_artifact(artifacts: ["/a", "/b", "/c"], installed: ["/a", "/c"]) {
    Present { value: m } => m == "/b"
    Absent => false
  }
}

test fn inventory_maps_every_row_to_derived_or_unclosed() -> Bool {
  let rows = [
    ReadRow { located: "/a", reads: Declared { paths: ["/a"] } },
    ReadRow { located: "/b", reads: NotYetModeled { reason: "no reader declared" } }
  ]
  let inv = deploy_artifact_inventory(rows: rows)
  count_of(inv) == 2 && all(inv, fn(r) { match r { DerivedRow { located: _, artifacts: _ } => true, UnclosedRow { located: _, reason: _ } => true, InstalledArtifactRow { located: _ } => false } })
}

// ─────────────────────────────────────────────────────────────────────────────────
// INTEGRATION CONTROLS (driven by the deploy enable authority — srv1 roster)
// ─────────────────────────────────────────────────────────────────────────────────

test fn the_deploy_roster_is_one_read_row_per_enabled_step() -> Bool {
  let steps = srv1_steps()
  let rows = deployment_artifact_read_rows(steps: steps, instance: srv1_inst(), revision: srv1_rev())
  let step_paths = path_list_of(steps)
  let row_paths = row_path_list(rows)
  count_of(steps) > 0 && count_of(rows) == count_of(steps) && list_cover(held: row_paths, expected: step_paths, eq: eq_str) && list_cover(held: step_paths, expected: row_paths, eq: eq_str)
}

test fn a_fresh_host_never_allows_the_whole_roster() -> Bool {
  let v = deploy_closure_verdict(rows: srv1_rows(), installed: [])
  !is_allowed(v) && (is_refused(v) || is_unclosed(v))
}

test fn the_serve_binary_step_read_is_declared_binary_and_tree() -> Bool {
  let steps = srv1_steps()
  any(steps, fn(s) { kind_is_serve(s) }) && all(steps, fn(s) { serve_read_is_binary_and_tree(s) })
}

test fn the_serve_binary_step_read_declares_the_source_tree() -> Bool {
  // Discriminating for review 95615: if the serve row dropped the tree read, the gate could pass a
  // deploy that installs the tree where serve does not read it. Serve MUST declare instance.repo_root.
  let steps = srv1_steps()
  any(steps, fn(s) { kind_is_serve(s) }) && all(steps, fn(s) { serve_read_declares_the_tree(s) })
}

test fn the_source_tree_step_is_an_installed_artifact_never_a_self_read() -> Bool {
  // The source-tree step is a located installed artifact, not a unit reading its own path: a read
  // of its own step.path would restate the install fact and never go red (rung inflation). The real
  // reader (serve's --entry, the tree converger) carries the TreeContent read on its own row.
  let steps = srv1_steps()
  any(steps, fn(s) { kind_is_source_tree(s) }) && all(steps, fn(s) { installed_artifact_classification(s) })
}

test fn every_enabled_step_is_declared_or_not_yet_modeled_with_a_reason() -> Bool {
  all(srv1_steps(), fn(s) { reason_is_present(deployment_artifact_read_set(step: s, instance: srv1_inst(), revision: srv1_rev())) })
}

// ─────────────────────────────────────────────────────────────────────────────────
// DEPLOY-GATE CONTROLS — Unclosed halts lives in deploy_gate_decision, not a comment.
// ─────────────────────────────────────────────────────────────────────────────────

test fn unclosed_reads_halt_the_deploy_gate_never_proceeds() -> Bool {
  let row = ReadRow { located: "/etc/gunbc/oidc.json", reads: NotYetModeled { reason: "reader read-set not declared" } }
  match deploy_gate(rows: [row], installed: ["/etc/gunbc/oidc.json"]) {
    Proceed => false
    Halt { cause: UnclosedRead { located: "/etc/gunbc/oidc.json" } } => true
    Halt { cause: _ } => false
  }
}

test fn allowed_reads_proceed_and_missing_read_halts() -> Bool {
  let ok_row = ReadRow { located: "/srv/bin/gunbc", reads: Declared { paths: ["/srv/bin/gunbc"] } }
  let proceed_case = match deploy_gate(rows: [ok_row], installed: ["/srv/bin/gunbc"]) { Proceed => true, Halt { cause: _ } => false }
  let missing_case = match deploy_gate(rows: [ok_row], installed: []) { Halt { cause: MissingArtifact { located: "/srv/bin/gunbc", artifact: "/srv/bin/gunbc" } } => true, _ => false }
  proceed_case && missing_case
}

test fn the_fresh_host_gate_halts_the_roster_never_proceeds() -> Bool {
  match deploy_gate(rows: srv1_rows(), installed: []) { Proceed => false, Halt { cause: _ } => true }
}

// ─────────────────────────────────────────────────────────────────────────────────
// DRAIN CLOSURE (first closed unit) — the drain's READ derives from its own module
// authority (attempt_unit_drain_read_paths / launcher dir); the drain gate control feeds
// the gate an explicit installed set (the installed/owned side is the gate wiring's job,
// derived from the apply-leg install authority in the follow-up), so omitting the read
// refuses without depending on a read-derived owned list (red_control 2).
// ─────────────────────────────────────────────────────────────────────────────────

fn drain_step() -> DeploymentArtifactStep {
  DeploymentArtifactStep { kind: UpsertOwned { kind: AttemptUnitDrainPathUnit }, path: "/etc/systemd/system/gunbc-attempt-unit-drain.path" as NonEmptyStr }
}

test fn the_drain_read_is_its_helper_snapshot_from_its_own_authority() -> Bool {
  let snap = attempt_system_unit_launcher_dir(instance: srv1_inst(), revision: srv1_rev())
  read_is_exactly(deployment_artifact_read_set(step: drain_step(), instance: srv1_inst(), revision: srv1_rev()), [snap])
}

test fn the_drain_gate_allows_when_snapshot_installed_and_refuses_when_absent() -> Bool {
  let snap = attempt_system_unit_launcher_dir(instance: srv1_inst(), revision: srv1_rev())
  let row = ReadRow { located: "/etc/systemd/system/gunbc-attempt-unit-drain.path", reads: Declared { paths: [snap] } }
  let ok = match deploy_gate(rows: [row], installed: [snap]) { Proceed => true, Halt { cause: _ } => false }
  let missing = match deploy_gate(rows: [row], installed: []) { Halt { cause: MissingArtifact { located: _, artifact: a } } => a == snap, _ => false }
  ok && missing
}

test fn the_drain_step_read_is_its_snapshot_when_present_in_the_roster() -> Bool {
  // Robust to the drain step being absent under a lab_plan that does not select the system-manager
  // launcher: all() over no drain steps is true; when present, the read is the launcher snapshot dir.
  all(srv1_steps(), fn(s) { drain_read_is_its_snapshot(s) })
}

fn drain_not_admitted_by_parent(s: DeploymentArtifactStep) -> Bool {
  // The concrete arm reads the revision-bound snapshot <root>/<instance>/<revision>/..., NOT the
  // shared parent root. (1) its declared path is the concrete launcher dir and the parent is not it;
  let snap = attempt_system_unit_launcher_dir(instance: srv1_inst(), revision: srv1_rev())
  let reads_concrete_not_parent = match deployment_artifact_read_set(step: s, instance: srv1_inst(), revision: srv1_rev()) {
    Declared { paths: ps } => list_member(xs: ps, x: snap, eq: eq_str) && !list_member(xs: ps, x: attempt_system_unit_launcher_helpers_root, eq: eq_str) && snap != attempt_system_unit_launcher_helpers_root
    _ => false
  }
  // (2) with ONLY the shared parent installed (the concrete <instance>/<revision> release absent), the
  // row must be Refused — not Allowed (the release is missing) and not Unclosed (the read IS modeled,
  // just unsatisfied) — and the gate must Halt naming the missing release path. This is the false
  // admission the side chat found in #16513: a row that declared the shared parent would Proceed here.
  let row = ReadRow { located: s.path as String, reads: deployment_artifact_read_set(step: s, instance: srv1_inst(), revision: srv1_rev()) }
  let refused = match deploy_closure_verdict(rows: [row], installed: [attempt_system_unit_launcher_helpers_root]) {
    Refused { located: _, artifact: a } => a == snap
    _ => false
  }
  let halts = match deploy_gate(rows: [row], installed: [attempt_system_unit_launcher_helpers_root]) {
    Halt { cause: MissingArtifact { located: _, artifact: a } } => a == snap
    _ => false
  }
  reads_concrete_not_parent && refused && halts
}

test fn the_attempt_drain_release_is_not_admitted_by_the_shared_parent_alone() -> Bool {
  // The drain ExecStarts its helper at the revision-bound launcher locus <root>/<instance>/<revision>/...,
  // NOT the shared parent root. With the concrete arm the row is a Declared read of that concrete locus,
  // so with ONLY the shared parent installed and the requested release absent the row is Refused (not
  // Unclosed, not Allowed) and the gate Halts naming the missing release path. Non-vacuous via any():
  // it requires a drain step present in the srv1 roster, and goes red if the arm ever re-declares the
  // shared parent (the false admission the side chat found in #16513).
  any(srv1_steps(), fn(s) { if kind_is_drain(s) { drain_not_admitted_by_parent(s) } else { false } })
}
