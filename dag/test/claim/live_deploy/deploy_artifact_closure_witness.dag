module test.claim.live_deploy.deploy_artifact_closure_witness

// Roadmap node: deploy-intent-owns-artifact-closure (node://adhoc-3e6e9bfb-d59, identity
//   rn_Z0G9G30XDNQJG7QYJ0M6NAVY0T, dag/gunbc/roadmap/roadmap_authority.dag, landed by #16504).
//   red_control 2 (this witness): "A deploy whose intent omits an artifact a unit reads refuses
//   before any unit is enabled; RED for each artifact the closure does not yet own."
//   The controls below verify the artifact-closure PRIMITIVE (generic verdict + inventory) and its
//   integration with the deploy enable authority (gunbc.live_deploy.spec deployment_owned_steps via
//   deployment_artifact_read_rows). They are the mechanism and inventory; the live apply-leg refusal
//   is the named follow-up (see the module header of deploy_artifact_closure.dag and the frontier
//   note on ClosureVerdict).
//
//   CONTROLS (true = PASS, false = reject): each returns true when the guarantee holds.
//
//   EVIDENCE CAVEAT: validated on prebuilt seed sha256 ff589391... (clever-raven-401 target, src
//   clean at a203519d8cc), which manager crisp-dove-117 reports has a DIRTY model (it failed claims
//   unchanged on main). So these PASSes are NOT trustworthy evidence; correctness rests on CI and the
//   manager's run on a current-seed binary matched to this branch's base.

import std.algebra { fold_list, list_map }
import std.list { list_member, list_cover }
import std.optional { Present, Absent }
import gunbc.live_deploy.deploy_artifact_closure {
  ArtifactReadSet, DeployReadRow, ReadRow, Declared, NotYetModeled,
  ClosureVerdict, Allowed, Refused, Unclosed,
  DeployGateDecision, DeployHaltCause, Proceed, Halt, MissingArtifact, UnclosedRead,
  deploy_gate_decision, deploy_gate,
  unit_closure_verdict, deploy_closure_verdict, combine_closure_verdicts,
  first_missing_artifact, deploy_artifact_inventory, ArtifactInventoryRow, DerivedRow, UnclosedRow
}
import gunbc.live_deploy.spec {
  DeploymentArtifactStep, UpsertOwned, ServeBinary, AttemptUnitDrainPathUnit,
  deployment_owned_steps
}
import gunbc.live_deploy.deploy_artifact_read_sets { deployment_artifact_read_rows, deployment_artifact_read_set }
import gunbc.live_deploy.desired { deployment_spec_srv1 }
import gunbc.roadmap.roadmap_dashboard_instance { srv1_live_dashboard_instance }
import gunbc.roadmap.attempt_system_unit_launch { attempt_system_unit_launcher_helpers_root }

// ── row / verdict helpers ──

fn eq_str(a: String, b: String) -> Bool { a == b }

fn row_located(row: DeployReadRow) -> String {
  match row { ReadRow { located: l, reads: _ } => l }
}

fn is_allowed(v: ClosureVerdict) -> Bool { match v { Allowed => true, _ => false } }
fn is_refused(v: ClosureVerdict) -> Bool { match v { Refused { located: _, artifact: _ } => true, _ => false } }
fn is_unclosed(v: ClosureVerdict) -> Bool { match v { Unclosed { located: _ } => true, _ => false } }

fn refused_names(v: ClosureVerdict, want_loc: String, want_art: String) -> Bool {
  match v {
    Refused { located: l, artifact: a } => l == want_loc && a == want_art
    _ => false
  }
}

fn count_of<A>(xs: List<A>) -> Int {
  fold_list(xs: xs, empty: 0, cons: fn(acc, _x) { acc + 1 })
}

fn path_list_of(steps: List<DeploymentArtifactStep>) -> List<String> {
  list_map(xs: steps, f: fn(s) { s.path as String })
}

fn row_path_list(rows: List<DeployReadRow>) -> List<String> {
  list_map(xs: rows, f: fn(r) { row_located(r) })
}

// ── step-kind helpers (source-of-truth checks against the model's total match) ──

fn kind_is_serve(s: DeploymentArtifactStep) -> Bool {
  match s.kind { UpsertOwned { kind: ServeBinary } => true, _ => false }
}

fn kind_is_drain(s: DeploymentArtifactStep) -> Bool {
  match s.kind { UpsertOwned { kind: AttemptUnitDrainPathUnit } => true, _ => false }
}

fn read_is_exactly(rs: ArtifactReadSet, want: List<String>) -> Bool {
  match rs {
    Declared { paths: ps } => list_cover(held: ps, expected: want, eq: eq_str) && list_cover(held: want, expected: ps, eq: eq_str)
    NotYetModeled { reason: _ } => false
  }
}

fn reason_is_present(rs: ArtifactReadSet) -> Bool {
  match rs {
    Declared { paths: _ } => true
    NotYetModeled { reason: r } => r != ""
  }
}

fn serve_read_is_own_binary(s: DeploymentArtifactStep) -> Bool {
  if kind_is_serve(s) { read_is_exactly(deployment_artifact_read_set(step: s), [s.path as String]) } else { true }
}

fn drain_read_is_helpers_root(s: DeploymentArtifactStep) -> Bool {
  if kind_is_drain(s) { read_is_exactly(deployment_artifact_read_set(step: s), [attempt_system_unit_launcher_helpers_root]) } else { true }
}

fn srv1_steps() -> List<DeploymentArtifactStep> {
  let spec = deployment_spec_srv1()
  deployment_owned_steps(instance: srv1_live_dashboard_instance(), names: spec.names, holding: spec.role_singletons, lab_plan: spec.target.lab_plan)
}

fn srv1_rows() -> List<DeployReadRow> {
  deployment_artifact_read_rows(steps: srv1_steps())
}

// ─────────────────────────────────────────────────────────────────────────────────
// GENERIC MECHANISM CONTROLS (rows built directly — test the primitive)
// ─────────────────────────────────────────────────────────────────────────────────

test fn allowed_when_every_declared_read_is_installed() -> Bool {
  let row = ReadRow { located: "/srv/gunbc/bin/gunbc", reads: Declared { paths: ["/srv/gunbc/bin/gunbc", "/opt/gunbc/helpers"] } }
  is_allowed(deploy_closure_verdict(rows: [row], installed: ["/srv/gunbc/bin/gunbc", "/opt/gunbc/helpers"]))
}

test fn refuses_naming_the_first_missing_artifact() -> Bool {
  let row = ReadRow { located: "/srv/gunbc/bin/gunbc", reads: Declared { paths: ["/srv/gunbc/bin/gunbc", "/opt/gunbc/helpers"] } }
  refused_names(deploy_closure_verdict(rows: [row], installed: ["/srv/gunbc/bin/gunbc"]), "/srv/gunbc/bin/gunbc", "/opt/gunbc/helpers")
}

test fn not_yet_modeled_is_unclosed_never_allowed() -> Bool {
  let row = ReadRow { located: "/etc/gunbc/oidc.json", reads: NotYetModeled { reason: "reader read-set not declared" } }
  is_unclosed(deploy_closure_verdict(rows: [row], installed: ["/etc/gunbc/oidc.json"]))
}

test fn refused_wins_over_unclosed_regardless_of_order() -> Bool {
  let unclosed_row = ReadRow { located: "/etc/gunbc/oidc.json", reads: NotYetModeled { reason: "reader read-set not declared" } }
  let refused_row = ReadRow { located: "/srv/gunbc/bin/gunbc", reads: Declared { paths: ["/srv/gunbc/bin/gunbc"] } }
  let installed_only_oidc = ["/etc/gunbc/oidc.json"]
  let order_unclosed_first = deploy_closure_verdict(rows: [unclosed_row, refused_row], installed: installed_only_oidc)
  let order_refused_first = deploy_closure_verdict(rows: [refused_row, unclosed_row], installed: installed_only_oidc)
  refused_names(order_unclosed_first, "/srv/gunbc/bin/gunbc", "/srv/gunbc/bin/gunbc") && refused_names(order_refused_first, "/srv/gunbc/bin/gunbc", "/srv/gunbc/bin/gunbc")
}

test fn first_missing_artifact_keeps_installed_fixed() -> Bool {
  match first_missing_artifact(artifacts: ["/a", "/b", "/c"], installed: ["/a", "/c"]) {
    Cons { head: m, tail: t } => m == "/b" && is_empty_list(t)
    Empty => false
  }
}

fn is_empty_list(xs: List<String>) -> Bool {
  match xs { Empty => true, Cons { head: _, tail: _ } => false }
}

test fn inventory_maps_every_row_to_derived_or_unclosed() -> Bool {
  let rows = [
    ReadRow { located: "/a", reads: Declared { paths: ["/a"] } },
    ReadRow { located: "/b", reads: NotYetModeled { reason: "no reader declared" } }
  ]
  let inv = deploy_artifact_inventory(rows: rows)
  count_of(inv) == 2 && all(inv, fn(r) { match r { DerivedRow { located: _, artifacts: _ } => true, UnclosedRow { located: _, reason: _ } => true } })
}

// ─────────────────────────────────────────────────────────────────────────────────
// INTEGRATION CONTROLS (driven by the deploy enable authority — srv1 roster)
// ─────────────────────────────────────────────────────────────────────────────────

test fn the_deploy_roster_is_one_read_row_per_enabled_step() -> Bool {
  let steps = srv1_steps()
  let rows = deployment_artifact_read_rows(steps: steps)
  let step_paths = path_list_of(steps)
  let row_paths = row_path_list(rows)
  count_of(steps) > 0 && count_of(rows) == count_of(steps) && list_cover(held: row_paths, expected: step_paths, eq: eq_str) && list_cover(held: step_paths, expected: row_paths, eq: eq_str)
}

test fn a_fresh_host_never_allows_the_whole_roster() -> Bool {
  // Nothing installed on a fresh host: the deploy must NOT be allowed — it must Refuse (a declared
  // read is missing) or at minimum report Unclosed (a read not yet checkable). fail_closed: unknown is
  // never silently allowed.
  let v = deploy_closure_verdict(rows: srv1_rows(), installed: [])
  !is_allowed(v) && (is_refused(v) || is_unclosed(v))
}

test fn the_serve_binary_step_read_is_declared_its_own_path() -> Bool {
  let steps = srv1_steps()
  any(steps, fn(s) { kind_is_serve(s) }) && all(steps, fn(s) { serve_read_is_own_binary(s) })
}

test fn the_attempt_drain_step_read_is_declared_the_helpers_root_when_present() -> Bool {
  // Robust to the drain step being absent under a lab_plan that does not select the system-manager
  // launcher: all() over no drain steps is true; when present, the read must be the launcher helpers root.
  all(srv1_steps(), fn(s) { drain_read_is_helpers_root(s) })
}

test fn every_enabled_step_is_declared_or_not_yet_modeled_with_a_reason() -> Bool {
  // No silent pass-through: every step's read-set is either Declared or a NotYetModeled WITH a
  // non-empty reason (fail_closed: every degradation is typed, located and countable).
  all(srv1_steps(), fn(s) { reason_is_present(deployment_artifact_read_set(step: s)) })
}

// ─────────────────────────────────────────────────────────────────────────────────
// DEPLOY-GATE CONTROLS — the obligation that Unclosed halts lives in deploy_gate_decision,
// not in a comment (Source annotations). These cover the total combinator directly.
// ─────────────────────────────────────────────────────────────────────────────────

test fn unclosed_reads_halt_the_deploy_gate_never_proceeds() -> Bool {
  // Even though the artifact is installed, a NotYetModeled read yields Unclosed, which the gate
  // maps to Halt (UnclosedRead) — never Proceed. There is no Proceed arm for Unclosed.
  let row = ReadRow { located: "/etc/gunbc/oidc.json", reads: NotYetModeled { reason: "reader read-set not declared" } }
  match deploy_gate(rows: [row], installed: ["/etc/gunbc/oidc.json"]) {
    Proceed => false
    Halt { cause: UnclosedRead { located: "/etc/gunbc/oidc.json" } } => true
    Halt { cause: _ } => false
  }
}

test fn allowed_reads_proceed_and_missing_read_halts() -> Bool {
  let ok_row = ReadRow { located: "/srv/bin/gunbc", reads: Declared { paths: ["/srv/bin/gunbc"] } }
  let proceed_case = match deploy_gate(rows: [ok_row], installed: ["/srv/bin/gunbc"]) { Proceed => true, Halt { cause: _ } => false }
  let missing_case = match deploy_gate(rows: [ok_row], installed: []) { Halt { cause: MissingArtifact { located: "/srv/bin/gunbc", artifact: "/srv/bin/gunbc" } } => true, _ => false }
  proceed_case && missing_case
}

test fn the_fresh_host_gate_halts_the_roster_never_proceeds() -> Bool {
  // The enable authority's rows, nothing installed: the gate must Halt, never Proceed — the apply-leg
  // follow-up acts on exactly this decision before enabling any unit.
  match deploy_gate(rows: srv1_rows(), installed: []) { Proceed => false, Halt { cause: _ } => true }
}
