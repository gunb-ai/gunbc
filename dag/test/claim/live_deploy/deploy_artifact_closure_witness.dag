  exec_start_binary_of_unit_file, working_directory_of_unit_file, watched_paths_of_unit_file
}
import extdeps.systemd.unit_file { SystemdUnitFile }
import test.claim.live_deploy.apply_emission_projection { claim_oidc_now_for }
import gunbc.live_deploy.desired { deployment_spec_srv1 }
import gunbc.live_deploy.release_locus { RevisionBoundAtEmission, ReleaseRevisionBinding }
