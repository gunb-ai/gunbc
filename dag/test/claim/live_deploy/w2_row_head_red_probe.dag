module test.claim.live_deploy.w2_row_head_red_probe

// SCRATCH RED PROBE (created only for the RED run on the runner; not committed). It asserts the
// one fact the reviewer asked to discriminate: the sealed command's PROGRAM is the row's
// materialized executable token, so changing dpkg.Package Status's transport-shell head changes
// the built command's program -- instead of meeting a stale literal check and refusing.
import std.types { Bool }
import extdeps.exec.command { argv_words }
import extdeps.package_managers.apt { package_tmux }
import extdeps.package_managers.dpkg {
  dpkg_status_command,
  DpkgStatusCommandReady,
  DpkgStatusCommandRefused,
}

test fn probe_program_follows_the_row_head() -> Bool {
  match dpkg_status_command(package: package_tmux) {
    DpkgStatusCommandRefused { cause: _ } => false
    DpkgStatusCommandReady { command: probe } =>
      argv_words(command: probe) == ["dpkg-follows-head", "-s", "tmux"]
  }
}
