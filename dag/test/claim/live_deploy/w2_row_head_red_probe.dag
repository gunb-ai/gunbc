module test.claim.live_deploy.w2_row_head_red_probe

// SCRATCH RED PROBE (created only for the RED run on the runner; not committed). It asserts the
// one fact the reviewer asked to discriminate: the sealed command's PROGRAM is the row's
// materialized executable token, so changing the apt.PackageManager Install row's transport-shell
// head changes the built command's program -- instead of meeting a stale literal check and
// refusing.
import std.types { Bool }
import extdeps.exec.command { argv_words }
import extdeps.package_managers.apt {
  package_tailscale,
  apt_get_install_command,
  AptGetInstallCommandReady,
  AptGetInstallCommandRefused,
}

test fn install_program_follows_the_row_head() -> Bool {
  match apt_get_install_command(package: package_tailscale) {
    AptGetInstallCommandRefused { cause: _ } => false
    AptGetInstallCommandReady { command: install } =>
      argv_words(command: install) == ["apt-get-follows-head", "install", "--yes", "tailscale"]
  }
}
