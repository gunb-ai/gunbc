module test.claim.live_deploy.release_pair_delivery_plan_witness

// THE STAGED WET LEG PLANS AN ORDERED INSTALL, AND REFUSES UNLESS THE VERDICT WAS OBSERVED ON THE FETCHED PACK.
// This witnesses the one authority the wet leg owns
// (gunbc.live_deploy.release_pair_delivery::release_pair_install_plan and its two feeder stages): it turns a
// pack-fetch OBSERVATION and a build-key-verify OBSERVATION into an ORDERED TYPED INSTALL (copy the fetched binary
// into the bound-pair locus -> write the bound source receipt -> restart serve), and it collapses to
// PlanKeepsLastGood on every refusal — including when the verify verdict was NOT observed on the pack the fetch
// actually produced. By stage 3 the fetch and verify have already run, so the plan carries ONLY the install steps;
// the binary placement names its SOURCE from the fetch observation (review 96059), so no file is placed from nowhere.
//
// BENIGN WAIT vs REFUSAL IS TYPED (review 96225 + 96234), not a string comparison — and install_plan NEVER produces
// the benign arm. It is reached only AFTER a successful run was found, so EVERY fold refusal it maps — an absent pack
// (refused download / unreadable digest: gh auth expired, disk full) or a present-but-refused pack (unverified digest,
// source/binary drift, wrong-pack verdict) — is a real PlanKeepsLastGood refusal that must surface RED (review 96234:
// a silent green here hides a broken delivery). The benign PlanWaits is produced ONLY upstream in the entry, for
// RunLookupNoneForHead (no successful run yet — genuinely not built) and the already-at-head no-op; those are
// witnessed in the CLI witness. The exit code is read from the plan variant, so re-wording any reason cannot flip it.
//
// ── WHY IT IS RED ON BASE ──────────────────────────────────────────────────────────────────────────────────
// On base the delivery leg does not exist — neither the stages nor their result types — so no plan is built and no
// refusal is representable. On head a good head whose pack was fetched AND verified on THAT pack yields a
// PlanToInstall whose binary placement copies the OBSERVED fetched file to the digest-named locus path, whose source
// receipt names the bound revision, and which restarts serve; while every bad head — pack unbuilt, pack unverified,
// source head mismatch, and the discriminating control a verify verdict for a DIFFERENT pack than the one fetched —
// yields PlanKeepsLastGood. That last control is what makes "verify before fetch" (review 96044) red: a verdict not
// observed on the fetched pack cannot install.

import std.types { String, NonEmptyStr, Bool, CommitSha }
import std.algebra { fold_list }
import extdeps.tools.gh { gh_run_download_argv }
import gunbc.live_deploy.release_pair_delivery {
  PackFetch, PackPresent, PackAbsent, PackVerify, VerifiedOn, Refused,
  DeliveryPlan, PlanToInstall, PlanKeepsLastGood, PlanWaits, FilePlacement, SourceReceiptWrite,
  release_pair_fetch_argv, release_pair_verify_dispatch, release_pair_install_plan,
  release_pair_incoming_pack_dir, release_pair_incoming_serve_source,
}
import gunbc.live_deploy.release_locus {
  ReleaseRevisionBinding, RevisionBoundAtEmission,
  release_locus_member_path, release_locus_tree_receipt_path,
}
import gunbc.live_deploy.operations { systemctl_restart_command }

// ── fixtures (hermetic; substrate inputs only, no live host) ───────────────────────────────────────────────
data base_root: String = "/opt/gunbc/releases"
data main_sha: String = "3333333333333333333333333333333333333333"
data last_good_sha: String = "2222222222222222222222222222222222222222"
data wrong_sha: String = "9999999999999999999999999999999999999999"
data bin_sha256: NonEmptyStr = "0f1e2d3c4b5a69788796a5b4c3d2e1f00f1e2d3c4b5a69788796a5b4c3d2e1f0"
data fetched_src: NonEmptyStr = release_pair_incoming_serve_source(base_root: base_root, revision: main_sha) as NonEmptyStr
data run_id: String = "43968177413"
data repo_slug: String = "gunb-ai/gunbc"
data pack_dir: NonEmptyStr = release_pair_incoming_pack_dir(base_root: base_root, revision: main_sha) as NonEmptyStr
data other_pack_dir: NonEmptyStr = "/opt/gunbc/releases/some-other-head"
data serve_unit_text: String = "gunbc-srv1-lab-codex-feedback-v0.service"

fn main_head() -> CommitSha { main_sha as CommitSha }
fn wrong_head() -> CommitSha { wrong_sha as CommitSha }
fn last_good_serving() -> ReleaseRevisionBinding { RevisionBoundAtEmission { revision: last_good_sha as CommitSha } }
fn serve_unit() -> NonEmptyStr { serve_unit_text as NonEmptyStr }

// the fetch the head actually produced: a present pack, its observed digest, the dir it landed in, and the file it
// produced (the placement source).
fn fetched_pack() -> PackFetch {
  PackPresent { sha256: bin_sha256, pack_dir: pack_dir, binary_source: fetched_src }
}
// the verify verdict observed on THAT pack (names the same dir the fetch observed).
fn verified_on_fetched() -> PackVerify { VerifiedOn { pack_dir: pack_dir } }

// join a List<String> into one String with fold_list, so the fetch argv is compared as a value without relying on
// list-equality (the claim batch is a pure subset; joining is the safe comparison).
fn join_argv(xs: List<String>) -> String {
  fold_list(xs: xs, empty: "", cons: fn(acc, x) { if acc == "" { x } else { join([acc, " ", x], "") } })
}

// ── STAGE 1: the fetch argv is the one gh-download authority's argv, unchanged ──────────────────────────────
// This witnesses that the fetch stage REUSES gh_run_download_argv (no hand-spelled gh command line): the argv it
// emits equals the download authority's argv for (run_id, repo, "release-bins", pack_dir), element for element.
test fn witness_stage1_fetch_argv_reuses_gh_download_authority() -> Bool {
  let got = release_pair_fetch_argv(base_root: base_root, run_id: run_id, repo: repo_slug, revision: main_sha)
  let want = gh_run_download_argv(run_id: run_id, repo: repo_slug, artifact: "release-bins", dir: pack_dir as String)
  join_argv(xs: got) == join_argv(xs: want)
}

// ── STAGE 2 IS DOWNSTREAM OF THE FETCH: a dispatch exists ONLY for a pack observed present ───────────────────
// The verify dispatch is a function OF the fetch observation. An absent pack yields no dispatch — nothing to verify
// — and a present pack yields one. The executor cannot ask "is it verified?" before asking "did the fetch produce
// a pack?".
test fn witness_verify_dispatch_exists_only_for_a_fetched_pack() -> Bool {
  let present_dispatch = release_pair_verify_dispatch(fetch: fetched_pack())
  let absent_dispatch = release_pair_verify_dispatch(fetch: PackAbsent { reason: "no pack" as NonEmptyStr })
  match present_dispatch {
    Present { value: _ } => match absent_dispatch { none => true, Present { value: _ } => false }
    none => false
  }
}

// ── the good head: the install copies the OBSERVED fetched file into the bound locus, then restarts serve ────
// WITNESS: a verified head whose pack was fetched and verified on THAT pack builds a PlanToInstall whose binary
// placement SOURCE is the fetched file the observation named (review 96059: not re-derived from a parameter) and
// whose DESTINATION is the digest-named locus member path; whose source receipt names the bound revision; and which
// restarts serve. Every value equals the recomputed typed value for the bound pair.
test fn witness_plan_good_head_builds_bound_install() -> Bool {
  let plan = release_pair_install_plan(
    base_root: base_root,
    serving: last_good_serving(),
    main_head: main_head(),
    source_head: main_head(),
    fetch: fetched_pack(),
    verify: verified_on_fetched(),
    serve_unit: serve_unit(),
  )
  let want_rev = RevisionBoundAtEmission { revision: main_head() }
  match plan {
    PlanToInstall { place_binary: FilePlacement { source: src, destination: dst }, write_source_receipt: SourceReceiptWrite { destination: rdst, revision: rrev, digest: rdg }, restart_command: rc, revision: _ } =>
      ((src as String) == (fetched_src as String)) &&
        (dst == release_locus_member_path(root: base_root, revision: want_rev, name: bin_sha256 as String)) &&
        (rdst == release_locus_tree_receipt_path(root: base_root, revision: want_rev)) &&
        (rc == systemctl_restart_command(unit: serve_unit(), privileged: true)) &&
        ((rrev as String) == main_sha) &&
        ((rdg as String) == (bin_sha256 as String))
    PlanKeepsLastGood { kept: _, reason: _ } => false
    PlanWaits { kept: _, reason: _ } => false
  }
}

// ── RED CONTROL (review 96234): an absent pack PAST a found run is a REFUSAL, not a benign wait ──────────────
// install_plan is reached only after RunLookupFound (a successful run exists), so an absent pack here is a refused
// download or an unreadable digest (expired gh auth, full disk) — NOT "not built yet" (that is RunLookupNoneForHead
// upstream, before any fetch). It must be PlanKeepsLastGood so the timer exits NON-ZERO; routing it green would
// keep a broken delivery silent. If a mutation sent PackAbsent to PlanWaits, this reddens.
test fn witness_plan_pack_fetch_absent_refuses() -> Bool {
  let plan = release_pair_install_plan(
    base_root: base_root,
    serving: last_good_serving(),
    main_head: main_head(),
    source_head: main_head(),
    fetch: PackAbsent { reason: "the release-bins download was refused (gh auth expired / disk full)" as NonEmptyStr },
    verify: Refused { reason: "not run — no pack was fetched" as NonEmptyStr },
    serve_unit: serve_unit(),
  )
  match plan {
    PlanToInstall { place_binary: _, write_source_receipt: _, restart_command: _, revision: _ } => false
    PlanKeepsLastGood { kept: _, reason: _ } => true
    PlanWaits { kept: _, reason: _ } => false
  }
}

// ── RED CONTROL (arm 2): a pack that fails build-key verification installs nothing ──────────────────────────
// The pack was fetched but the consumer's --verify-build-artifacts refused it against the build key, so its
// binaries are not trusted. The last-good pair keeps serving.
test fn witness_plan_pack_unverified_keeps_last_good() -> Bool {
  let plan = release_pair_install_plan(
    base_root: base_root,
    serving: last_good_serving(),
    main_head: main_head(),
    source_head: main_head(),
    fetch: fetched_pack(),
    verify: Refused { reason: "--verify-build-artifacts refused the pack" as NonEmptyStr },
    serve_unit: serve_unit(),
  )
  match plan {
    PlanToInstall { place_binary: _, write_source_receipt: _, restart_command: _, revision: _ } => false
    PlanKeepsLastGood { kept: _, reason: _ } => true
    // A present pack that the fold refused is a RED refusal, never a benign wait — this reddens a mutation that
    // routed a present-pack refusal into PlanWaits (the exit code is the variant, not the reason text).
    PlanWaits { kept: _, reason: _ } => false
  }
}

// ── RED CONTROL (arm 3, THE CROSS-STAGE CONTROL): a verify verdict for a pack that was NOT the one fetched ────
// The fetch observed a pack in pack_dir, but the verify observation names a DIFFERENT pack_dir. The verdict was
// never observed on the fetched pack, so it cannot authorize the install: the fold sees verified=false and refuses.
// This is the exact defect review 96044 named — verify must consume the fetch's observation, not run independently.
test fn witness_plan_verify_on_wrong_pack_keeps_last_good() -> Bool {
  let plan = release_pair_install_plan(
    base_root: base_root,
    serving: last_good_serving(),
    main_head: main_head(),
    source_head: main_head(),
    fetch: fetched_pack(),
    verify: VerifiedOn { pack_dir: other_pack_dir },
    serve_unit: serve_unit(),
  )
  match plan {
    PlanToInstall { place_binary: _, write_source_receipt: _, restart_command: _, revision: _ } => false
    PlanKeepsLastGood { kept: _, reason: _ } => true
    PlanWaits { kept: _, reason: _ } => false
  }
}

// ── RED CONTROL (arm 4): a source head that is not the head delivered for installs nothing ─────────────────
test fn witness_plan_source_head_mismatch_keeps_last_good() -> Bool {
  let plan = release_pair_install_plan(
    base_root: base_root,
    serving: last_good_serving(),
    main_head: main_head(),
    source_head: wrong_head(),
    fetch: fetched_pack(),
    verify: verified_on_fetched(),
    serve_unit: serve_unit(),
  )
  match plan {
    PlanToInstall { place_binary: _, write_source_receipt: _, restart_command: _, revision: _ } => false
    PlanKeepsLastGood { kept: _, reason: _ } => true
    PlanWaits { kept: _, reason: _ } => false
  }
}

// ── RED CONTROL (review 96225 + 96234): THE EXIT CODE FOLLOWS FROM THE VARIANT, NEVER THE REASON TEXT ─────────
// Two pack-ABSENT observations whose reason TEXTS are completely different (a refused download vs an unreadable
// digest, worded no differently) take the SAME red arm — PlanKeepsLastGood. A PRESENT pack the fold refused takes
// that same red arm. Only a well-formed bound pair (pack present, verified on the fetched pack, matching heads) is
// NOT red (PlanToInstall). So the exit class is decided by the fold's decision + the plan variant, never by the
// reason string: re-wording a refusal cannot flip it green, and the one green-producing arm (PlanWaits) is produced
// upstream by the entry (converged_noop / RunLookupNoneForHead), witnessed in the CLI witness — NOT by install_plan.
// If a mutation compared reason strings, or sent PackAbsent to PlanWaits, one of these assertions reddens.
fn plan_is_red(plan: DeliveryPlan) -> Bool {
  match plan {
    PlanKeepsLastGood { kept: _, reason: _ } => true
    PlanToInstall { place_binary: _, write_source_receipt: _, restart_command: _, revision: _ } => false
    PlanWaits { kept: _, reason: _ } => false
  }
}

test fn witness_refusal_exit_is_reason_independent() -> Bool {
  let absent_a = release_pair_install_plan(
    base_root: base_root, serving: last_good_serving(), main_head: main_head(), source_head: main_head(),
    fetch: PackAbsent { reason: "the release-bins download was refused (gh auth expired)" as NonEmptyStr },
    verify: Refused { reason: "not run" as NonEmptyStr }, serve_unit: serve_unit(),
  )
  let absent_b = release_pair_install_plan(
    base_root: base_root, serving: last_good_serving(), main_head: main_head(), source_head: main_head(),
    fetch: PackAbsent { reason: "the digest was unreadable — disk full (worded no differently)" as NonEmptyStr },
    verify: Refused { reason: "not run" as NonEmptyStr }, serve_unit: serve_unit(),
  )
  let present_refused = release_pair_install_plan(
    base_root: base_root, serving: last_good_serving(), main_head: main_head(), source_head: main_head(),
    fetch: fetched_pack(),
    verify: Refused { reason: "the build key rejected the pack" as NonEmptyStr },
    serve_unit: serve_unit(),
  )
  let good = release_pair_install_plan(
    base_root: base_root, serving: last_good_serving(), main_head: main_head(), source_head: main_head(),
    fetch: fetched_pack(), verify: verified_on_fetched(), serve_unit: serve_unit(),
  )
  // Both wordings of an absent pack are red; a present-but-refused pack is red; a good pair is not red.
  plan_is_red(plan: absent_a) && plan_is_red(plan: absent_b) && plan_is_red(plan: present_refused) && !plan_is_red(plan: good)
}
