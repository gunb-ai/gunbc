module test.claim.live_deploy.fleet_request_witness_test

import std.types { Bool, String, List, NonEmptyStr, CommitSha }
import std.decl_ref { declaration_ref_eq, declaration_ref_display_key }
import extdeps.crypto.hash { Digest, sha256_digest }
import std.content_hash { Fnv1a64Structural, content_hash_atom, serialize_content_hash }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import gunbc.live_deploy.candidate { CandidateRelease }
import gunbc.live_deploy.member_identity {
  ConvergedMember,
  DirectoryRoot,
  Executable,
  TreePublication,
  UnitFile,
  UnitManager,
  ServiceProcess,
  TreePublicationIdentity, UnitFileIdentity, ManagerLoadedCurrent,
  ProcessRunningRelease,
  MemberIdentity, TreeIdentity, ExecutableIdentity, UnitFileAt, UnitManagerAt, ProcessAt,
  ObservedMember, MemberObserved, MemberAbsentOnHost, MemberUnobservable,
  release_member_roster, plan_mutation_count,
  ReleaseTarget,
  converged_member_eq,
}
import gunbc.live_deploy.desired {
  DesiredDeployment,
  srv1_production_desired_deployment,
  srv1_lab_desired_deployment,
  srv1_production_selected_identity,
  srv1_lab_selected_identity,
}
import gunbc.live_deploy.fleet_request {
  admit_live_deploy_member_basis,
  admit_live_deploy_fleet_request,
  LiveDeployBasisAdmitted,
  LiveDeployBasisRefused,
  LiveDeployIncompletePopulation,
  LiveDeployUnreadableMember,
  LiveDeployForeignReplacement,
  LiveDeployEffectsRefused,
  live_deploy_admission_refusal_text,
  LiveDeployFleetRequestAdmission,
  LiveDeployFleetRequestAdmitted,
  LiveDeployFleetRequestIdentityMismatch,
  LiveDeployFleetRequestUnitMismatch,
  LiveDeployFleetRequestUnknownInstance,
  LiveDeployFleetRequestRosterRefused,
  LiveDeployFleetRequestBasisRefused,
  live_deploy_host_only_request_refusal_reason,
}
import gunbc.fleet_converge_plan {
  fleet_converge_scope_of_wire,
  fleet_converge_scope_wire,
  fleet_converge_request_scope,
  fleet_converge_plan_subject,
  observed_baseline_text,
  fleet_converge_apply_artifact_admits,
  fleet_converge_apply_shell,
  fleet_converge_apply_shell_axis_lines,
  fleet_converge_apply_terminal,
  fleet_converge_plan_artifact_of_request,
  live_deploy_converge_request,
  LiveDeploy,
  ApplyAdmitted,
  ApplyMemberSetMismatch,
  FullyApplied,
  ScopeDecoded,
  ScopeUndecodable,
}

fn rev_a() -> CommitSha { "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" as CommitSha }
fn rev_b() -> CommitSha { "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" as CommitSha }
fn bin_a() -> Digest { sha256_digest(hex: "1111111111111111111111111111111111111111111111111111111111111111" as NonEmptyStr) }
fn bin_b() -> Digest { sha256_digest(hex: "2222222222222222222222222222222222222222222222222222222222222222" as NonEmptyStr) }
fn unit_a() -> Fnv1a64Structural { content_hash_atom(value: "[Unit]\nDescription=a\n" as NonEmptyStr) }
fn unit_b() -> Fnv1a64Structural { content_hash_atom(value: "[Unit]\nDescription=b\n" as NonEmptyStr) }
fn unit_name() -> NonEmptyStr { "gunbc-roadmap.service" as NonEmptyStr }

fn candidate() -> CandidateRelease {
  CandidateRelease {
    revision: rev_a(),
    expected_surface_identity: content_hash_atom(value: "surface" as NonEmptyStr),
  }
}

fn target() -> ReleaseTarget {
  ReleaseTarget {
    revision: rev_a(),
    executable: bin_a(),
    unit: unit_name(),
  }
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn desired_tree() -> MemberIdentity { TreeIdentity { tree: TreePublicationIdentity { revision: rev_a(), tracked_projection_clean: true } } }
fn desired_bin() -> MemberIdentity { ExecutableIdentity { digest: bin_a() } }
fn desired_file() -> MemberIdentity { UnitFileAt { file: UnitFileIdentity { unit: unit_name(), document: unit_a() } } }
fn desired_file_for(unit: NonEmptyStr) -> MemberIdentity { UnitFileAt { file: UnitFileIdentity { unit: unit, document: unit_a() } } }
fn desired_manager() -> MemberIdentity { UnitManagerAt { standing: ManagerLoadedCurrent } }
fn desired_process() -> MemberIdentity { ProcessAt { process: ProcessRunningRelease { revision: rev_a() } } }

fn desired_for(m: ConvergedMember) -> MemberIdentity {
  match m {
    Executable => desired_bin()
    TreePublication => desired_tree()
    UnitFile => desired_file()
    UnitManager => desired_manager()
    ServiceProcess => desired_process()
    DirectoryRoot { path: _ } => desired_bin()
  }
}

fn desired_for_unit(unit: NonEmptyStr, m: ConvergedMember) -> MemberIdentity {
  match m {
    Executable => desired_bin()
    TreePublication => desired_tree()
    UnitFile => desired_file_for(unit: unit)
    UnitManager => desired_manager()
    ServiceProcess => desired_process()
    DirectoryRoot { path: _ } => desired_bin()
  }
}

fn matching_obs() -> List<ObservedMember> {
  map(release_member_roster(), m => MemberObserved { identity: desired_for(m: m) })
}

fn matching_obs_for(unit: NonEmptyStr) -> List<ObservedMember> {
  map(release_member_roster(), m => MemberObserved { identity: desired_for_unit(unit: unit, m: m) })
}

fn admit_obs(observed: List<ObservedMember>) -> gunbc.live_deploy.fleet_request.LiveDeployMemberBasisAdmission {
  admit_live_deploy_member_basis(
    candidate: candidate(),
    target: target(),
    observed: observed,
    desired: m => desired_for(m: m),
  )
}

fn one_drift(member: ConvergedMember, observed: ObservedMember) -> List<ObservedMember> {
  map(release_member_roster(), m =>
    if converged_member_eq(a: m, b: member) {
      observed
    } else {
      MemberObserved { identity: desired_for(m: m) }
    })
}

test fn matching_identities_derive_zero_operations() -> Bool {
  match admit_obs(observed: matching_obs()) {
    LiveDeployBasisRefused { cause: _ } => false
    LiveDeployBasisAdmitted { basis: b } => plan_mutation_count(plan: b.effects) == 0
  }
}

test fn fresh_absence_derives_creates() -> Bool {
  match admit_obs(observed: one_drift(member: Executable, observed: MemberAbsentOnHost { member: Executable })) {
    LiveDeployBasisRefused { cause: _ } => false
    LiveDeployBasisAdmitted { basis: b } => plan_mutation_count(plan: b.effects) > 0
  }
}

test fn stale_identities_derive_replacements() -> Bool {
  match admit_obs(observed: one_drift(
    member: Executable,
    observed: MemberObserved { identity: ExecutableIdentity { digest: bin_b() } },
  )) {
    LiveDeployBasisRefused { cause: _ } => false
    LiveDeployBasisAdmitted { basis: b } => plan_mutation_count(plan: b.effects) > 0
  }
}

test fn unreadable_members_refuse_because_the_observation_was_unusable() -> Bool {
  match admit_obs(observed: one_drift(
    member: Executable,
    observed: MemberUnobservable { member: Executable, cause: "sha256sum refused" },
  )) {
    LiveDeployBasisAdmitted { basis: _ } => false
    LiveDeployBasisRefused { cause: c } => match c {
      LiveDeployUnreadableMember { member: Executable, cause: why } =>
        why == "sha256sum refused"
          && string_contains(s: live_deploy_admission_refusal_text(cause: c), pattern: "sha256sum refused")
          && !string_contains(s: live_deploy_admission_refusal_text(cause: c), pattern: "IncompletePopulation")
      _ => false
    }
  }
}

test fn incomplete_member_populations_cannot_produce_an_admitted_empty_plan() -> Bool {
  match admit_obs(observed: [MemberObserved { identity: desired_bin() }]) {
    LiveDeployBasisAdmitted { basis: b } => plan_mutation_count(plan: b.effects) != 0
    LiveDeployBasisRefused { cause: c } => match c {
      LiveDeployIncompletePopulation { missing: m } => count(m) > 0
      _ => false
    }
  }
}

test fn a_foreign_unowned_member_cannot_derive_destructive_replacement() -> Bool {
  match admit_obs(observed: one_drift(
    member: UnitFile,
    observed: MemberObserved {
      identity: UnitFileAt {
        file: UnitFileIdentity {
          unit: "someone-elses.service" as NonEmptyStr,
          document: unit_b(),
        },
      },
    },
  )) {
    LiveDeployBasisAdmitted { basis: _ } => false
    LiveDeployBasisRefused { cause: c } => match c {
      LiveDeployForeignReplacement { member: UnitFile } => true
      _ => false
    }
  }
}

test fn a_desired_identity_for_another_member_refuses_the_effect_plan() -> Bool {
  match admit_live_deploy_member_basis(
    candidate: candidate(),
    target: target(),
    observed: matching_obs(),
    desired: m =>
      match m {
        Executable => desired_tree()
        _ => desired_for(m: m)
      },
  ) {
    LiveDeployBasisAdmitted { basis: _ } => false
    LiveDeployBasisRefused { cause: c } => match c {
      LiveDeployEffectsRefused { refusals: r } => count(r) > 0
      LiveDeployUnreadableMember { member: _, cause: _ } => false
      LiveDeployIncompletePopulation { missing: _ } => false
      _ => false
    }
  }
}

test fn live_deploy_is_a_decodable_fleet_converge_scope() -> Bool {
  match fleet_converge_scope_of_wire(wire: fleet_converge_scope_wire(scope: LiveDeploy)) {
    ScopeUndecodable { cause: _ } => false
    ScopeDecoded { scope: LiveDeploy } => true
    ScopeDecoded { scope: _ } => false
  }
}

fn admit_live_deploy_request_for(row: DesiredDeployment) -> LiveDeployFleetRequestAdmission {
  admit_live_deploy_fleet_request(
    desired: row,
    candidate: candidate(),
    observed: matching_obs_for(unit: row.names.unit_name),
    desired_member: m => desired_for_unit(unit: row.names.unit_name, m: m),
  )
}

fn admit_production_live_deploy_request() -> LiveDeployFleetRequestAdmission {
  admit_live_deploy_request_for(row: srv1_production_desired_deployment())
}

test fn a_host_only_live_deploy_request_has_no_spelling() -> Bool {
  string_contains(s: live_deploy_host_only_request_refusal_reason(), pattern: "hostname")
    && string_contains(s: live_deploy_host_only_request_refusal_reason(), pattern: "selected_identity")
}

test fn admit_binds_the_request_to_the_roster_selected_identity() -> Bool {
  match admit_production_live_deploy_request() {
    LiveDeployFleetRequestAdmitted { desired, basis } =>
      declaration_ref_eq(a: desired.selected_identity, b: srv1_production_selected_identity())
        && basis.effects.target.unit == desired.names.unit_name
    LiveDeployFleetRequestIdentityMismatch { carried: _, rostered: _ } => false
    LiveDeployFleetRequestUnknownInstance { instance_id: _ } => false
    LiveDeployFleetRequestRosterRefused { refusal: _ } => false
    LiveDeployFleetRequestBasisRefused { cause: _ } => false
    _ => false
  }
}

test fn admit_refuses_a_selected_identity_that_is_not_the_roster_row() -> Bool {
  let live = srv1_production_desired_deployment()
  match admit_live_deploy_fleet_request(
    desired: DesiredDeployment {
      instance: live.instance,
      target: live.target,
      names: live.names,
      selected_identity: srv1_lab_selected_identity(),
    },
    candidate: candidate(),
    observed: matching_obs_for(unit: live.names.unit_name),
    desired_member: m => desired_for_unit(unit: live.names.unit_name, m: m),
  ) {
    LiveDeployFleetRequestIdentityMismatch { carried, rostered } =>
      declaration_ref_eq(a: carried, b: srv1_lab_selected_identity())
        && declaration_ref_eq(a: rostered, b: srv1_production_selected_identity())
    LiveDeployFleetRequestAdmitted { desired: _, basis: _ } => false
    LiveDeployFleetRequestUnknownInstance { instance_id: _ } => false
    LiveDeployFleetRequestRosterRefused { refusal: _ } => false
    LiveDeployFleetRequestBasisRefused { cause: _ } => false
    _ => false
  }
}

test fn admit_refuses_a_desired_unit_that_is_not_the_roster_row_unit() -> Bool {
  let live = srv1_production_desired_deployment()
  match admit_live_deploy_fleet_request(
    desired: live,
    candidate: candidate(),
    observed: matching_obs(),
    desired_member: m => desired_for(m: m),
  ) {
    LiveDeployFleetRequestUnitMismatch { carried, rostered } =>
      (carried as String) == (unit_name() as String)
        && rostered == live.names.unit_name
        && !(carried == rostered)
    LiveDeployFleetRequestAdmitted { desired: _, basis: _ } => false
    _ => false
  }
}

test fn live_deploy_converge_is_the_live_deploy_scope_and_names_the_selected_identity() -> Bool {
  match admit_production_live_deploy_request() {
    LiveDeployFleetRequestAdmitted { desired, basis } => {
      let req = live_deploy_converge_request(desired: desired, basis: basis)
      let baseline = observed_baseline_text(request: req)
      let key = declaration_ref_display_key(ref: srv1_production_selected_identity())
      match fleet_converge_request_scope(request: req) {
        LiveDeploy =>
          string_contains(s: baseline, pattern: "scope:live-deploy")
            && string_contains(s: baseline, pattern: key)
            && string_contains(s: baseline, pattern: "member-observed:")
            && string_contains(s: baseline, pattern: desired.names.unit_name as String)
        _ => false
      }
    }
    _ => false
  }
}

test fn production_and_lab_live_deploy_requests_on_the_same_host_fingerprint_differently() -> Bool {
  match admit_production_live_deploy_request() {
    LiveDeployFleetRequestAdmitted { desired: prod, basis: prod_basis } =>
      match admit_live_deploy_request_for(row: srv1_lab_desired_deployment()) {
        LiveDeployFleetRequestAdmitted { desired: lab, basis: lab_basis } => {
          let prod_req = live_deploy_converge_request(desired: prod, basis: prod_basis)
          let lab_req = live_deploy_converge_request(desired: lab, basis: lab_basis)
          let prod_fp = serialize_content_hash(hash: fleet_converge_plan_subject(request: prod_req).member_set_fingerprint) as String
          let lab_fp = serialize_content_hash(hash: fleet_converge_plan_subject(request: lab_req).member_set_fingerprint) as String
          !(prod_fp == lab_fp)
            && fleet_converge_plan_subject(request: prod_req).host == fleet_converge_plan_subject(request: lab_req).host
            && prod_basis.effects.target.unit == prod.names.unit_name
            && lab_basis.effects.target.unit == lab.names.unit_name
            && !(prod_basis.effects.target.unit == lab_basis.effects.target.unit)
        }
        _ => false
      }
    _ => false
  }
}

test fn the_plan_fold_consumes_live_deploy_converge_without_emitting_host_effects() -> Bool {
  match admit_production_live_deploy_request() {
    LiveDeployFleetRequestAdmitted { desired, basis } => {
      let req = live_deploy_converge_request(desired: desired, basis: basis)
      let subject = fleet_converge_plan_subject(request: req)
      let artifact = fleet_converge_plan_artifact_of_request(request: req, prior_generation: 0)
      let shell = fleet_converge_apply_shell(
        request: req,
        terminal: fleet_converge_apply_terminal(request: req),
      )
      match fleet_converge_apply_terminal(request: req) {
        FullyApplied =>
          match fleet_converge_apply_artifact_admits(
            planned_host_text: subject.host as String,
            planned_scope_wire: fleet_converge_scope_wire(scope: LiveDeploy),
            planned_fingerprint_text: serialize_content_hash(hash: subject.member_set_fingerprint) as String,
            observed: req,
          ) {
            ApplyAdmitted =>
              string_contains(s: artifact.plan_body, pattern: "scope:live-deploy")
                && string_contains(s: artifact.plan_body, pattern: declaration_ref_display_key(ref: srv1_production_selected_identity()))
                && string_contains(s: shell, pattern: "emits no host effects")
                && count(fleet_converge_apply_shell_axis_lines(request: req)) == 0
                && !string_contains(s: shell, pattern: "sudo -n ")
            ApplyMemberSetMismatch => false
            _ => false
          }
        _ => false
      }
    }
    _ => false
  }
}
