  cross_file_clause_e_fixture_baseline_assembled_closure,
  cross_file_clause_e_fixture_perturbed_assembled_closure,
  cross_file_clause_e_fixture_unrelated_loaded_provider_row,
  cross_file_clause_e_fixture_provider_file,
}

// N3-C witnesses for gunbc.namespace_cut.namespace_pool_independence. Pool independence proper:
// unrelated_loaded_unrelated_spellings_preserves_full_carrier_holds assembles baseline vs perturbed
// (+unrelated loaded file, different spelling) via B0+B1 and compares full carriers. Class B
// silent-reselection discriminator: colliding_root_exported_homonym_refuses_ambiguity_holds —
// adding a colliding root-exported homonym must typed-refuse (ReferenceBindingProjectionAmbiguous
// on both consumer references), never produce Ready, never alternate-select, never add a dependency
// edge. Load-bearing RED: same-file reselection with unchanged file-deps. Per-clause RED controls
// exercise each PoolIndependenceFailure arm.

// EXECUTED CONCLUSION (loyal-ram-550 routing 2026-08-07): colliding decoy fixture (app.provider +
// app.decoy both root-export helper) — perturbed B1 projection is
// AssembledClosureDependencyProjectionBindingRefused with ReferenceBindingProjectionAmbiguous on
// BOTH consumer references; no Ready projection, no alternate selection, no extra dependency edge.
// Substrate behaviour is CORRECT under namespace-only double-bound-is-error; prior equality
// expectation was wrong. Stronger Class B control: proves silent pool-driven reselection does NOT
// occur. OPEN (operator, non-blocking): CrossFileProviderExportedExposure => RootExposure may be
// wrong exposure model if cross-module access is projection (provider.helper) not bare-name root
// injection — if exposure model changes later this control remains as regression evidence.

// OPEN QUESTION (loyal-ram-550 escalation 2026-08-07, operator-signed territory): fixture models
// cross-file provider export as CrossFileProviderExportedExposure => RootExposure, injecting helper
// into root scope. Namespace-only design says cross-module access is projection — sibling module
// visible, members reached as provider.helper, not bare-name injection. If projection governs,
// app.provider.helper and app.decoy.helper never collide at root and the decoy collision may be a
// fixture exposure artifact. Does not block N3-C;
// colliding_root_exported_homonym_refuses_ambiguity_holds stays enrolled regardless.

fn npi_witness_consumer_file() -> FilePath {
  "app/consumer.dag"
}

fn npi_witness_ref_one() -> OccurrenceId {
  OccurrenceId { value: 200 }
}

fn npi_witness_ref_two() -> OccurrenceId {
  OccurrenceId { value: 201 }
}

fn npi_witness_declaration() -> OccurrenceId {
  OccurrenceId { value: 300 }
}

fn npi_witness_declaration_alt() -> OccurrenceId {
  OccurrenceId { value: 301 }
}

fn npi_witness_provenance(
  reference_occurrence: OccurrenceId,
  declaration_occurrence: OccurrenceId,
) -> CrossFileBindingProvenance {
  CrossFileBindingProvenance {
    reference_occurrence: reference_occurrence,
    declaration_occurrence: declaration_occurrence,
    consumer_file: npi_witness_consumer_file(),
    provider_file: cross_file_clause_e_fixture_provider_file(),
  }
}

fn npi_witness_provider(
  reference_occurrence: OccurrenceId,
  declaration_occurrence: OccurrenceId,
) -> BoundReferenceProvider {
  BoundReferenceProvider {
    reference_occurrence: reference_occurrence,
    declaration_occurrence: declaration_occurrence,
    consumer_module: "app.consumer",
    provider_module: "app.provider",
  }
}

fn npi_witness_file_dependency() -> DirectFileDependency {
  DirectFileDependency {
    consumer_file: npi_witness_consumer_file(),
    provider_file: cross_file_clause_e_fixture_provider_file(),
  }
}

fn npi_witness_projection(
  provenances: List<CrossFileBindingProvenance>,
  dependencies: List<DirectFileDependency>,
  providers: List<BoundReferenceProvider>,
) -> ReferenceDerivedDependencyProjection {
  ReferenceDerivedDependencyProjectionReady {
    binding_provenance: provenances,
    file_dependencies: dependencies,
    bound_population: AllReferencesBound { providers: providers },
  }
}

fn npi_witness_baseline_projection() -> ReferenceDerivedDependencyProjection {
  npi_witness_projection(
    provenances: [
      npi_witness_provenance(
        reference_occurrence: npi_witness_ref_one(),
        declaration_occurrence: npi_witness_declaration(),
      ),
      npi_witness_provenance(
        reference_occurrence: npi_witness_ref_two(),
        declaration_occurrence: npi_witness_declaration(),
      ),
    ],
    dependencies: [npi_witness_file_dependency()],
    providers: [
      npi_witness_provider(
        reference_occurrence: npi_witness_ref_one(),
        declaration_occurrence: npi_witness_declaration(),
      ),
      npi_witness_provider(
        reference_occurrence: npi_witness_ref_two(),
        declaration_occurrence: npi_witness_declaration(),
      ),
    ],
  )
}

fn npi_projection_for_assembled_closure(
  closure: AssembledCrossFileBindingClosure,
) -> ReferenceDerivedDependencyProjection? {
  match reference_derived_dependency_projection_for_assembled_closure(closure: closure) {
    AssembledClosureDependencyProjectionReady { projection: projection } =>
      Present { value: projection }
    _ => Absent
  }
}

fn npi_pool_perturbation_preserves_full_carrier(
  unrelated_loaded_provider: CrossFileBindingClosureRow,
) -> Bool {
  let baseline_closure = cross_file_clause_e_fixture_baseline_assembled_closure()
  let perturbed_closure = cross_file_clause_e_fixture_perturbed_assembled_closure(
    unrelated_loaded_provider: unrelated_loaded_provider,
  )
  match npi_projection_for_assembled_closure(closure: baseline_closure) {
    Present { value: baseline } =>
      match npi_projection_for_assembled_closure(closure: perturbed_closure) {
        Present { value: perturbed } =>
          match assess_pool_independent_projection_equality(
            source_subject: npi_witness_consumer_file(),
            baseline: baseline,
            perturbed: perturbed,
          ) {
            PoolIndependenceEstablished => true
            _ => false
          }
        Absent => false
      }
    Absent => false
  }
}

test fn unrelated_loaded_unrelated_spellings_preserves_full_carrier_holds() -> Bool {
  npi_pool_perturbation_preserves_full_carrier(
    unrelated_loaded_provider: cross_file_clause_e_fixture_unrelated_loaded_provider_row(
      declaration_authored_name: "unrelated_noise",
      module_dotted: "app.unrelated",
      file_path: "app/unrelated.dag",
    ),
  )
}

fn npi_reference_occurrence_in_transport(
  occurrence: OccurrenceId,
  references: List<ReferenceOccurrence>,
) -> Bool {
  fold(
    references,
    init: false,
    f: (acc, reference) => acc || (reference.occurrence == occurrence),
  )
}

fn npi_colliding_decoy_row() -> CrossFileBindingClosureRow {
  cross_file_clause_e_fixture_unrelated_loaded_provider_row(
    declaration_authored_name: "helper",
    module_dotted: "app.decoy",
    file_path: "app/decoy.dag",
  )
}

test fn colliding_root_exported_homonym_refuses_ambiguity_holds() -> Bool {
  let baseline_closure = cross_file_clause_e_fixture_baseline_assembled_closure()
  let perturbed_closure = cross_file_clause_e_fixture_perturbed_assembled_closure(
    unrelated_loaded_provider: npi_colliding_decoy_row(),
  )
  match reference_derived_dependency_projection_for_assembled_closure(closure: baseline_closure) {
    AssembledClosureDependencyProjectionReady { projection: _ } =>
      match perturbed_closure {
        AssembledCrossFileBindingClosureReady {
          transport: transport,
          inputs: _,
          module_files: _,
          consumer_file: _,
        } =>
          match reference_derived_dependency_projection_for_assembled_closure(
            closure: perturbed_closure,
          ) {
            AssembledClosureDependencyProjectionRefused {
              refusal: AssembledClosureDependencyProjectionBindingRefused {
                population: ReferencePopulationRefused {
                  first_failure: ReferenceBindingProjectionAmbiguous {
                    occurrence: first_ambiguous,
                  },
                  more_failures: more_failures,
                },
              },
            } =>
              (transport.references |> count) == 2
                && npi_reference_occurrence_in_transport(
                  occurrence: first_ambiguous,
                  references: transport.references,
                )
                && match more_failures |> first {
                  Present {
                    value: ReferenceBindingProjectionAmbiguous {
                      occurrence: second_ambiguous,
                    },
                  } =>
                    (more_failures |> count) == 1
                      && npi_reference_occurrence_in_transport(
                        occurrence: second_ambiguous,
                        references: transport.references,
                      )
                      && first_ambiguous != second_ambiguous
                  Absent => false
                  Present { value: ReferenceBindingProjectionBound { provider: _ } } => false
                  Present { value: ReferenceBindingProjectionUnbound { occurrence: _ } } => false
                  Present { value: ReferenceBindingProjectionTransportRefused { refusal: _ } } => false
                  Present { value: ReferenceBindingProjectionModulePathRefused { refusal: _ } } => false
                  Present { value: ReferenceBindingProjectionExposureRefused { refusal: _ } } => false
                  Present { value: ReferenceBindingProjectionAuthoredOrderRefused { refusal: _ } } => false
                  Present { value: ReferenceBindingProjectionDeclarationBucketRefused { occurrence: _ } } => false
                  Present { value: ReferenceBindingProjectionModulePathMissing { occurrence: _ } } => false
                  Present { value: ReferenceBindingProjectionWrongCategory { occurrence: _, observed: _ } } => false
                }
            _ => false
          }
        _ => false
      }
    _ => false
  }
}

test fn same_file_reselection_red_refuses_full_carrier_holds() -> Bool {
  let baseline = npi_witness_baseline_projection()
  let perturbed = npi_witness_projection(
    provenances: [
      npi_witness_provenance(
        reference_occurrence: npi_witness_ref_one(),
        declaration_occurrence: npi_witness_declaration(),
      ),
      npi_witness_provenance(
        reference_occurrence: npi_witness_ref_two(),
        declaration_occurrence: npi_witness_declaration_alt(),
      ),
    ],
    dependencies: [npi_witness_file_dependency()],
    providers: [
      npi_witness_provider(
        reference_occurrence: npi_witness_ref_one(),
        declaration_occurrence: npi_witness_declaration(),
      ),
      npi_witness_provider(
        reference_occurrence: npi_witness_ref_two(),
        declaration_occurrence: npi_witness_declaration_alt(),
      ),
    ],
  )
  match assess_pool_independent_projection_equality(
    source_subject: npi_witness_consumer_file(),
    baseline: baseline,
    perturbed: perturbed,
  ) {
    PoolIndependenceRefused {
      failure: DeclarationOccurrenceIdentityMismatch,
    } => assess_file_dependencies_only_equality(baseline: baseline, perturbed: perturbed)
    _ => false
  }
}

test fn red_source_subject_mismatch_holds() -> Bool {
  match assess_pool_independent_projection_equality(
    source_subject: "app/wrong.dag",
    baseline: npi_witness_baseline_projection(),
    perturbed: npi_witness_baseline_projection(),
  ) {
    PoolIndependenceRefused {
      failure: SourceSubjectConsumerFileMismatch { expected: _, found: _ },
    } => true
    _ => false
  }
}

test fn red_reference_occurrence_identity_mismatch_holds() -> Bool {
  let baseline = npi_witness_baseline_projection()
  let perturbed = npi_witness_projection(
    provenances: [
      npi_witness_provenance(
        reference_occurrence: npi_witness_ref_two(),
        declaration_occurrence: npi_witness_declaration(),
      ),
      npi_witness_provenance(
        reference_occurrence: npi_witness_ref_one(),
        declaration_occurrence: npi_witness_declaration(),
      ),
    ],
    dependencies: [npi_witness_file_dependency()],
    providers: [
      npi_witness_provider(
        reference_occurrence: npi_witness_ref_two(),
        declaration_occurrence: npi_witness_declaration(),
      ),
      npi_witness_provider(
        reference_occurrence: npi_witness_ref_one(),
        declaration_occurrence: npi_witness_declaration(),
      ),
    ],
  )
  match assess_pool_independent_projection_equality(
    source_subject: npi_witness_consumer_file(),
    baseline: baseline,
    perturbed: perturbed,
  ) {
    PoolIndependenceRefused {
      failure: ReferenceOccurrenceIdentityMismatch,
    } => true
    _ => false
  }
}

test fn red_bound_population_mismatch_holds() -> Bool {
  let baseline = npi_witness_baseline_projection()
  let perturbed = npi_witness_projection(
    provenances: [
      npi_witness_provenance(
        reference_occurrence: npi_witness_ref_one(),
        declaration_occurrence: npi_witness_declaration(),
      ),
      npi_witness_provenance(
        reference_occurrence: npi_witness_ref_two(),
        declaration_occurrence: npi_witness_declaration(),
      ),
    ],
    dependencies: [npi_witness_file_dependency()],
    providers: [
      npi_witness_provider(
        reference_occurrence: npi_witness_ref_one(),
        declaration_occurrence: npi_witness_declaration(),
      ),
      BoundReferenceProvider {
        reference_occurrence: npi_witness_ref_two(),
        declaration_occurrence: npi_witness_declaration(),
        consumer_module: "app.other",
        provider_module: "app.provider",
      },
    ],
  )
  match assess_pool_independent_projection_equality(
    source_subject: npi_witness_consumer_file(),
    baseline: baseline,
    perturbed: perturbed,
  ) {
    PoolIndependenceRefused {
      failure: BoundReferencePopulationMismatch,
    } => true
    _ => false
