test fn red_file_dependency_mismatch_holds() -> Bool {
  let baseline = npi_witness_baseline_projection()
  let perturbed = ReferenceDerivedDependencyProjectionReady {
    binding_provenance: [
      npi_witness_provenance(
        reference_occurrence: npi_witness_ref_one(),
        declaration_occurrence: npi_witness_declaration(),
      ),
      npi_witness_provenance(
        reference_occurrence: npi_witness_ref_two(),
        declaration_occurrence: npi_witness_declaration(),
      ),
    ],
    file_dependencies: [
      npi_witness_file_dependency(),
      DirectFileDependency {
        consumer_file: npi_witness_consumer_file(),
        provider_file: "app/unrelated.dag",
      },
    ],
    bound_population: AllReferencesBound {
      providers: [
        npi_witness_provider(
          reference_occurrence: npi_witness_ref_one(),
          declaration_occurrence: npi_witness_declaration(),
        ),
        npi_witness_provider(
          reference_occurrence: npi_witness_ref_two(),
          declaration_occurrence: npi_witness_declaration(),
        ),
      ],
    },
  }
  match assess_pool_independent_projection_equality(
    source_subject: npi_witness_consumer_file(),
    baseline: baseline,
    perturbed: perturbed,
  ) {
    PoolIndependenceRefused { failure: FileDependencyMismatch } => true
    _ => false
  }
}

test fn red_refusal_outcome_mismatch_holds() -> Bool {
  let baseline = npi_witness_baseline_projection()
  let perturbed = ReferenceDerivedDependencyProjectionBindingRefused {
    population: ReferencePopulationRefused {
      first_failure: ReferenceBindingProjectionUnbound {
        occurrence: npi_witness_ref_one(),
      },
      more_failures: [],
    },
  }
  match assess_pool_independent_projection_equality(
    source_subject: npi_witness_consumer_file(),
    baseline: baseline,
    perturbed: perturbed,
  ) {
    PoolIndependenceRefused { failure: RefusalOutcomeMismatch } => true
    _ => false
  }
}

// NFR pool_independence_projection totalization witnesses (D2): assess_pool_independent_projection_equality
// and assess_file_dependencies_only_equality are now total over every (baseline, perturbed)
// ReferenceDerivedDependencyProjection variant pair — no wildcard arms remain. The REDs pin the
// pairs the old `_` arms silently absorbed (Ready vs BindingRefused; Ready vs FileRefused) to the
// verdicts those pairs carried before; the controls pin the lanes that already had named arms
// (FileRefused vs FileRefused equal payloads -> established; Ready-vs-Ready equal deps ->
// established for the full fn, agrees for the deps-only fn) and would fail if the new named
// arms regressed the behaviour the wildcards were covering.

fn npi_witness_ready_projection() -> ReferenceDerivedDependencyProjection {
  npi_witness_projection(
    provenances: [
      npi_witness_provenance(
        reference_occurrence: npi_witness_ref_one(),
        declaration_occurrence: npi_witness_declaration(),
      ),
    ],
    dependencies: [npi_witness_file_dependency()],
    providers: [
      npi_witness_provider(
        reference_occurrence: npi_witness_ref_one(),
        declaration_occurrence: npi_witness_declaration(),
      ),
    ],
  )
}

fn npi_witness_file_refused_projection() -> ReferenceDerivedDependencyProjection {
  ReferenceDerivedDependencyProjectionFileRefused {
    first_failure: CrossFileBindingProvenanceProjectionFilePathMissing {
      module_path: "app.missing" as NonEmptyStr,
    },
    more_failures: [],
  }
}

test fn pool_independence_projection_ready_vs_binding_refused_absorbed_pair_holds() -> Bool {
  match assess_pool_independent_projection_equality(
    source_subject: npi_witness_consumer_file(),
    baseline: npi_witness_ready_projection(),
    perturbed: ReferenceDerivedDependencyProjectionBindingRefused {
      population: AllReferencesBound {
        providers: [
          npi_witness_provider(
            reference_occurrence: npi_witness_ref_one(),
            declaration_occurrence: npi_witness_declaration(),
          ),
        ],
      },
    },
  ) {
    PoolIndependenceRefused { failure: RefusalOutcomeMismatch } => true
    _ => false
  }
}

test fn pool_independence_projection_file_refused_vs_file_refused_equal_payloads_control_holds() -> Bool {
  match assess_pool_independent_projection_equality(
    source_subject: npi_witness_consumer_file(),
    baseline: npi_witness_file_refused_projection(),
    perturbed: npi_witness_file_refused_projection(),
  ) {
    PoolIndependenceEstablished => true
    _ => false
  }
}

test fn pool_independence_projection_ready_vs_ready_equal_deps_control_holds() -> Bool {
  match assess_pool_independent_projection_equality(
    source_subject: npi_witness_consumer_file(),
    baseline: npi_witness_ready_projection(),
    perturbed: npi_witness_ready_projection(),
  ) {
    PoolIndependenceEstablished => true
    _ => false
  }
}

test fn file_dependencies_only_ready_vs_file_refused_absorbed_pair_holds() -> Bool {
  !assess_file_dependencies_only_equality(
    baseline: npi_witness_ready_projection(),
    perturbed: npi_witness_file_refused_projection(),
  )
}

test fn file_dependencies_only_ready_vs_ready_equal_deps_control_holds() -> Bool {
  assess_file_dependencies_only_equality(
    baseline: npi_witness_ready_projection(),
    perturbed: npi_witness_ready_projection(),
  )
}
