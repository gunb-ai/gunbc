module test.claim.decl_facts_reflection_witness_support


// Projection of the fixture module's single `data` authority, NOT a second
// decl_facts call over the same roots. A `data` initializer is evaluated once
// per interpreter context and cached; a `fn` body re-runs the whole-pool scan
// at every call site, which this cluster's rows make once each. Same facts,
// one scan for the module instead of one per row.
fn decl_facts_reflection_witness_support_facts() -> List<v2.std.decl_index.DeclFact> {
  decl_facts_reflection_fixture_facts
}

fn decl_facts_reflection_lookup(qn: String) -> v2.std.data_initializer_identity.DeclFactLookup {
  decl_fact_lookup_by_qualified_name(
    qn: qn,
    facts: decl_facts_reflection_witness_support_facts()
  )
}

fn decl_fact_lookup_candidate_rel_path_contains(lookup: v2.std.data_initializer_identity.DeclFactLookup, fragment: String) -> Bool {
  match lookup {
    DeclFactAmbiguous { candidates: cands } =>
      fold(cands, init: false, f: fn(found, fact) {
        found || fact.rel_path.contains(fragment)
      })
    DeclFactMissing => false
    DeclFactUnique { fact: _ } => false
  }
}

fn duplicate_qualified_identity_lookup_names_primary_and_shadow(lookup: v2.std.data_initializer_identity.DeclFactLookup) -> Bool {
  decl_fact_lookup_is_ambiguous(lookup: lookup)
    && decl_fact_lookup_candidate_count(lookup: lookup) == 2
    && decl_fact_lookup_candidate_rel_path_contains(
      lookup: lookup,
      fragment: "decl_facts_reflection_duplicate_qn/primary"
    )
    && decl_fact_lookup_candidate_rel_path_contains(
      lookup: lookup,
      fragment: "fixture_roots/decl_facts_reflection_duplicate_qn/shadow"
    )
}

fn decl_fact_projection_node_for_qualified_name(
  facts: List<v2.std.decl_index.DeclFact>,
  qn: String
) -> Optional<Node> {
  match decl_fact_optional_by_qualified_name(qn: qn, facts: facts) {
    Present { value: fact } => optional_present(value: fact.node)
    Absent => optional_absent()
  }
}

fn decl_facts_reflection_fact_node(qn: String) -> Optional<Node> {
  decl_fact_projection_node_for_qualified_name(
    facts: decl_facts_reflection_witness_support_facts(),
    qn: qn
  )
}

fn decl_facts_reflection_initializer_root(qn: String) -> Optional<Node> {
  match decl_facts_reflection_fact_node(qn: qn) {
    Present { value: node } =>
      if data_initializer_is_record_projection(node: node) {
        optional_present(value: node)
      } else if data_initializer_is_plain_record_projection(node: node) {
        optional_present(value: node)
      } else {
        optional_absent()
      }
    Absent => optional_absent()
  }
}

fn decl_facts_reflection_record_projection(qn: String) -> Optional<Node> {
  match decl_facts_reflection_initializer_root(qn: qn) {
    Present { value: node } =>
      if data_initializer_is_record_projection(node: node) {
        optional_present(value: node)
      } else {
        optional_absent()
      }
    Absent => optional_absent()
  }
}

fn decl_facts_reflection_constructor_parent(qn: String) -> Optional<String> {
  match decl_facts_reflection_record_projection(qn: qn) {
    Present { value: record } => record_constructor_parent_qualified_name_optional(record: record)
    Absent => optional_absent()
  }
}

fn decl_facts_reflection_constructor_variant(qn: String) -> Optional<String> {
  match decl_facts_reflection_record_projection(qn: qn) {
    Present { value: record } => record_constructor_variant_name_optional(record: record)
    Absent => optional_absent()
  }
}

fn decl_facts_reflection_field_projection(qn: String, field: String) -> Optional<Node> {
  match decl_facts_reflection_initializer_root(qn: qn) {
    Present { value: root } => projection_named_child_optional(node: root, label: field)
    Absent => optional_absent()
  }
}

fn decl_facts_reflection_value_identity_projection(qn: String) -> Optional<Node> {
  match decl_facts_reflection_fact_node(qn: qn) {
    Present { value: node } => projection_named_child_optional(node: node, label: "value_identity")
    Absent => optional_absent()
  }
}

fn decl_facts_reflection_nullary_value_projection(qn: String) -> Optional<Node> {
  match decl_facts_reflection_value_identity_projection(qn: qn) {
    Present { value: projection } => optional_present(value: projection)
    Absent =>
      match decl_facts_reflection_fact_node(qn: qn) {
        Present { value: node } =>
          if data_initializer_is_nullary_projection(node: node) {
            projection_named_child_optional(node: node, label: "value_identity")
          } else {
            optional_absent()
          }
        Absent => optional_absent()
      }
  }
}

fn decl_facts_reflection_resolved_nullary_parent(qn: String) -> Optional<String> {
  match decl_facts_reflection_nullary_value_projection(qn: qn) {
    Present { value: projection } =>
      if value_projection_is_resolved_variant(node: projection) {
        resolved_variant_parent_qualified_name_optional(node: projection)
      } else {
        optional_absent()
      }
    Absent => optional_absent()
  }
}

fn decl_facts_reflection_resolved_nullary_variant_name(qn: String) -> Optional<String> {
  match decl_facts_reflection_nullary_value_projection(qn: qn) {
    Present { value: projection } =>
      if value_projection_is_resolved_variant(node: projection) {
        resolved_variant_name_optional(node: projection)
      } else {
        optional_absent()
      }
    Absent => optional_absent()
  }
}

fn decl_facts_reflection_projection_variant_label_optional(node: Node) -> Optional<String> {
  if value_projection_is_resolved_variant(node: node) {
    resolved_variant_name_optional(node: node)
  } else if data_initializer_is_record_projection(node: node) {
    record_constructor_variant_name_optional(record: node)
  } else if data_initializer_is_plain_record_projection(node: node) {
    optional_absent()
  } else {
    optional_absent()
  }
}

fn decl_facts_reflection_decl_field_variant_name(qn: String) -> Optional<String> {
  match decl_facts_reflection_field_projection(qn: qn, field: "bind") {
    Present { value: bind_projection } =>
      match record_field_projection_optional(record: bind_projection, label: "field") {
        Present { value: field_projection } =>
          decl_facts_reflection_projection_variant_label_optional(node: field_projection)
        Absent => optional_absent()
      }
    Absent => optional_absent()
  }
}

fn decl_facts_reflection_plain_record_parent(qn: String) -> Optional<String> {
  match decl_facts_reflection_fact_node(qn: qn) {
    Present { value: node } =>
      if data_initializer_is_plain_record_projection(node: node) {
        plain_record_parent_qualified_name_optional(record: node)
      } else {
        optional_absent()
      }
    Absent => optional_absent()
  }
}

fn decl_facts_reflection_plain_record_parent_eq(record: Node, want: String) -> Bool {
  match plain_record_parent_qualified_name_optional(record: record) {
    Present { value: parent } => parent == want
    Absent => false
  }
}

fn projection_has_named_child(record: Node, label: String) -> Bool {
  match projection_named_child_optional(node: record, label: label) {
    Present { value: _ } => true
    Absent => false
  }
}

fn decl_facts_reflection_bind_is_declaration_ref_projection(qn: String) -> Bool {
  match decl_facts_reflection_field_projection(qn: qn, field: "bind") {
    Present { value: bind } =>
      data_initializer_is_plain_record_projection(node: bind)
        && decl_facts_reflection_plain_record_parent_eq(
          record: bind,
          want: "std.decl_ref.DeclarationRef"
        )
        && projection_has_named_child(record: bind, label: "module_path")
        && projection_has_named_child(record: bind, label: "decl_name")
    Absent => false
  }
}

fn decl_facts_reflection_decl_field_variant_eq(qn: String, want: String) -> Bool {
  match decl_facts_reflection_field_projection(qn: qn, field: "field") {
    Present { value: field } =>
      match decl_facts_reflection_projection_variant_label_optional(node: field) {
        Present { value: v } => v == want
        Absent => false
      }
    Absent => false
  }
}

fn decl_facts_reflection_named_field_projection_surfaces(qn: String) -> Bool {
  match decl_facts_reflection_fact_node(qn: qn) {
    Present { value: node } =>
      data_initializer_is_plain_record_projection(node: node)
        && decl_facts_reflection_plain_record_parent_eq(
          record: node,
          want: "std.decl_ref.DeclarationRef"
        )
        && decl_facts_reflection_decl_field_variant_eq(qn: qn, want: "NamedField")
    Absent => false
  }
}

fn duplicate_qn_pool_declaration_lookup_per_candidate_is_unique(lookup: v2.std.data_initializer_identity.DeclFactLookup) -> Bool {
  match lookup {
    DeclFactAmbiguous { candidates: cands } =>
      fold(cands, init: true, f: fn(ok, fact) {
        ok
          && decl_fact_lookup_is_unique(
            lookup: decl_fact_lookup_by_pool_declaration_identity(
              identity: pool_declaration_identity_from_fact(fact: fact),
              facts: decl_facts_reflection_witness_support_facts()
            )
          )
      })
    DeclFactMissing => false
    DeclFactUnique { fact: _ } => false
  }
}
