module test.claim.decl_facts_reflection_witness_support

import test.fixture.decl_facts_reflection.ambiguous_shared_b
import test.fixture.decl_facts_reflection.ambiguous_specimen
import test.fixture.decl_facts_reflection.globally_unique_carrier
import test.fixture.decl_facts_reflection.specimens
import test.fixture.decl_facts_reflection.unimported_globally_unique_user
import v2.std.decl_index { DeclFact, decl_facts }
import std.algebra { Empty }
import v2.std.optional { optional_present, optional_absent }
import v2.std.data_initializer_identity {
  projection_kind_lexeme_optional,
  projection_named_child_optional,
  record_constructor_parent_qualified_name_optional,
  record_constructor_variant_name_optional,
  record_field_projection_optional,
  resolved_variant_name_optional,
  resolved_variant_parent_qualified_name_optional,
  value_projection_is_resolved_variant,
  variant_declaration_name_optional,
  DeclFactLookup,
  decl_fact_lookup_by_qualified_name,
  decl_fact_lookup_is_ambiguous,
  decl_fact_lookup_candidate_count,
  decl_fact_optional_by_qualified_name,
  data_initializer_is_nullary_projection,
  data_initializer_is_record_projection,
  data_initializer_is_plain_record_projection,
  plain_record_parent_qualified_name_optional,
}

// Fixture-scoped pool: specimen rows + dimensionless positive-control deps only — not witness_layer_roots.
data decl_facts_reflection_fixture_pool_roots: List<String> = [
  "dag/test/fixture/decl_facts_reflection",
  "dag/test/fixture/decl_facts_reflection_duplicate_qn/primary",
  "test/fixture_roots/decl_facts_reflection_duplicate_qn/shadow",
  "dag/extdeps/units",
  "dag/extdeps/external_authority",
  "dag/std",
]

data decl_facts_reflection_fixture_facts: List<DeclFact> = decl_facts(pool_roots: decl_facts_reflection_fixture_pool_roots)

fn decl_facts_reflection_lookup(qn: String) -> DeclFactLookup {
  decl_fact_lookup_by_qualified_name(qn: qn, facts: decl_facts_reflection_fixture_facts)
}

fn decl_fact_lookup_candidate_rel_path_contains(lookup: DeclFactLookup, fragment: String) -> Bool {
  match lookup {
    DeclFactAmbiguous { candidates: cands } =>
      fold(cands, init: false, f: fn(found, fact) {
        found || fact.rel_path.contains(fragment)
      })
    DeclFactMissing => false
    DeclFactUnique { fact: _ } => false
  }
}

fn duplicate_qualified_identity_lookup_names_primary_and_shadow(lookup: DeclFactLookup) -> Bool {
  decl_fact_lookup_is_ambiguous(lookup: lookup)
    && decl_fact_lookup_candidate_count(lookup: lookup) == 2
    && decl_fact_lookup_candidate_rel_path_contains(
      lookup: lookup,
      fragment: "decl_facts_reflection_duplicate_qn/primary"
    )
    && decl_fact_lookup_candidate_rel_path_contains(
      lookup: lookup,
      fragment: "fixture_roots/decl_facts_reflection_duplicate_qn/shadow"
    )
}

fn decl_facts_reflection_fact(qn: String) -> Optional<DeclFact> {
  decl_fact_optional_by_qualified_name(qn: qn, facts: decl_facts_reflection_fixture_facts)
}

fn decl_facts_reflection_fact_node(qn: String) -> Optional<Node> {
  match decl_facts_reflection_fact(qn: qn) {
    Present { value: fact } => optional_present(value: fact.node)
    Absent => optional_absent()
  }
}

fn decl_facts_reflection_record_projection(qn: String) -> Optional<Node> {
  match decl_facts_reflection_fact_node(qn: qn) {
    Present { value: node } =>
      if data_initializer_is_record_projection(node: node) {
        optional_present(value: node)
      } else {
        optional_absent()
      }
    Absent => optional_absent()
  }
}

fn decl_facts_reflection_constructor_parent(qn: String) -> Optional<String> {
  match decl_facts_reflection_record_projection(qn: qn) {
    Present { value: record } => record_constructor_parent_qualified_name_optional(record: record)
    Absent => optional_absent()
  }
}

fn decl_facts_reflection_constructor_variant(qn: String) -> Optional<String> {
  match decl_facts_reflection_record_projection(qn: qn) {
    Present { value: record } => record_constructor_variant_name_optional(record: record)
    Absent => optional_absent()
  }
}

fn decl_facts_reflection_field_projection(qn: String, field: String) -> Optional<Node> {
  match decl_facts_reflection_record_projection(qn: qn) {
    Present { value: record } => record_field_projection_optional(record: record, label: field)
    Absent => optional_absent()
  }
}

fn decl_facts_reflection_nullary_value_projection(qn: String) -> Optional<Node> {
  match decl_facts_reflection_fact_node(qn: qn) {
    Present { value: node } =>
      if data_initializer_is_nullary_projection(node: node) {
        projection_named_child_optional(node: node, label: "value_identity")
      } else {
        optional_absent()
      }
    Absent => optional_absent()
  }
}

fn decl_facts_reflection_resolved_nullary_parent(qn: String) -> Optional<String> {
  match decl_facts_reflection_nullary_value_projection(qn: qn) {
    Present { value: projection } =>
      if value_projection_is_resolved_variant(node: projection) {
        resolved_variant_parent_qualified_name_optional(node: projection)
      } else {
        optional_absent()
      }
    Absent => optional_absent()
  }
}

fn decl_facts_reflection_resolved_nullary_variant_name(qn: String) -> Optional<String> {
  match decl_facts_reflection_nullary_value_projection(qn: qn) {
    Present { value: projection } =>
      if value_projection_is_resolved_variant(node: projection) {
        resolved_variant_name_optional(node: projection)
      } else {
        optional_absent()
      }
    Absent => optional_absent()
  }
}

fn decl_facts_reflection_projection_variant_label_optional(node: Node) -> Optional<String> {
  if value_projection_is_resolved_variant(node: node) {
    resolved_variant_name_optional(node: node)
  } else if data_initializer_is_record_projection(node: node) {
    record_constructor_variant_name_optional(record: node)
  } else {
    optional_absent()
  }
}

fn decl_facts_reflection_decl_field_variant_name(qn: String) -> Optional<String> {
  match decl_facts_reflection_field_projection(qn: qn, field: "bind") {
    Present { value: bind_projection } =>
      match record_field_projection_optional(record: bind_projection, label: "field") {
        Present { value: field_projection } =>
          decl_facts_reflection_projection_variant_label_optional(node: field_projection)
        Absent => optional_absent()
      }
    Absent => optional_absent()
  }
}

fn decl_facts_reflection_plain_record_parent(qn: String) -> Optional<String> {
  match decl_facts_reflection_fact_node(qn: qn) {
    Present { value: node } =>
      if data_initializer_is_plain_record_projection(node: node) {
        plain_record_parent_qualified_name_optional(record: node)
      } else {
        optional_absent()
      }
    Absent => optional_absent()
  }
}
