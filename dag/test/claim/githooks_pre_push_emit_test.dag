module test.claim.githooks_pre_push_emit


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = ReadsLiveTree

fn has(s: String, p: String) -> Bool {
  string_contains(s: s, pattern: p)
}

test fn witness_generated_header() -> Bool {
  let sh = expected_githooks_pre_push_sh()
  test.claim.githooks_pre_push_emit.has(s: sh, p: "GENERATED by dag/gunbc/githooks_pre_push_emit.dag")
    && test.claim.githooks_pre_push_emit.has(s: sh, p: "set -euo pipefail")
}

test fn witness_fmt_is_the_body() -> Bool {
  let sh = expected_githooks_pre_push_sh()
  test.claim.githooks_pre_push_emit.has(s: sh, p: "cargo fmt --all --check")
    && test.claim.githooks_pre_push_emit.has(s: sh, p: "rustfmt drift")
    && test.claim.githooks_pre_push_emit.has(s: sh, p: "exit 1")
}

test fn witness_no_claim_batch_dependency() -> Bool {
  let sh = expected_githooks_pre_push_sh()
  !test.claim.githooks_pre_push_emit.has(s: sh, p: "claim_batch")
    && !test.claim.githooks_pre_push_emit.has(s: sh, p: "--pre-push")
    && !test.claim.githooks_pre_push_emit.has(s: sh, p: "ensure_bins")
    && !test.claim.githooks_pre_push_emit.has(s: sh, p: "CLAIM_BATCH")
}

test fn witness_no_in_hook_build() -> Bool {
  let sh = expected_githooks_pre_push_sh()
  !test.claim.githooks_pre_push_emit.has(s: sh, p: "cargo build")
    && !test.claim.githooks_pre_push_emit.has(s: sh, p: "CTRL_BUILD_WRAP_CARGO")
}

test fn witness_no_corpus_or_witness_run() -> Bool {
  let sh = expected_githooks_pre_push_sh()
  !test.claim.githooks_pre_push_emit.has(s: sh, p: "gunbc_ci_witness_corpus_only_batches")
    && !test.claim.githooks_pre_push_emit.has(s: sh, p: "doc_graph_has_no_orphan_docs")
    && !test.claim.githooks_pre_push_emit.has(s: sh, p: "--claim-run")
    && !test.claim.githooks_pre_push_emit.has(s: sh, p: "run_generated_artifact_drift_gate_body")
}

test fn witness_no_tree_mutation() -> Bool {
  let sh = expected_githooks_pre_push_sh()
  !test.claim.githooks_pre_push_emit.has(s: sh, p: "chore: apply cargo fmt")
    && !test.claim.githooks_pre_push_emit.has(s: sh, p: "chore: regenerate committed projections")
    && !test.claim.githooks_pre_push_emit.has(s: sh, p: "git add")
    && !test.claim.githooks_pre_push_emit.has(s: sh, p: "git commit")
}

// witness_line_budget (length(sh) < N) DELETED 2026-08-09: it was a tree-measured
// numeric oracle — a merge-blocking literal grounded in a measurement of the current
// hook rather than a policy budget (DESIGN §5 oracle rule; the giveaway was that adding
// the correct fleet-ref preamble forced the cap up to fit the code it was meant to
// bound — a ratchet quietly loosening). The invariant it weakly proxied ("the hook stays
// a thin dispatcher, no heavy work") is asserted STRUCTURALLY and precisely by
// witness_no_in_hook_build, witness_no_corpus_or_witness_run,
// witness_no_claim_batch_dependency, and witness_no_tree_mutation — none of which is a
// tree-measured literal. A byte count added nothing those do not already bound (DESIGN §2).
data pre_push_line_budget_note: String = "The budget exists to catch RE-HEAVYING — a roster edit that puts a corpus run, an in-hook cargo build, or a claim_batch exec back on the push path (gunbc.githooks_pre_push_emit pre_push_fmt_only_note). It is a proxy for that property, and the four witnesses above assert the property directly, which is why raising the ceiling here does not weaken the gate. It moved 700 -> 1000 when the fmt failure arm was split three ways: the could-not-run branch carries a ~230-character diagnostic that names cargo and proposes no cargo-dependent remedy, which is the whole point of the split and is not weight on the push path (it is a message, not work). It moved 1000 -> 1500 when lane-2 added idempotent repo-local git config convergence on the push path (~350 characters of gunbc run argv and failure text — still no cargo build or claim_batch exec; the structural witnesses remain authoritative). A hook that re-acquires actual work still trips the structural witnesses regardless of this number."


