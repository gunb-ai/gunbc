module test.claim.githooks_pre_push_emit

import gunbc.githooks_pre_push_emit { expected_githooks_pre_push_sh }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

fn has(s: String, p: String) -> Bool {
  string_contains(s: s, pattern: p)
}

test fn witness_generated_header() -> Bool {
  let sh = expected_githooks_pre_push_sh()
  has(s: sh, p: "GENERATED by dag/gunbc/githooks_pre_push_emit.dag")
    && has(s: sh, p: "set -euo pipefail")
}

test fn witness_fmt_is_the_body() -> Bool {
  let sh = expected_githooks_pre_push_sh()
  has(s: sh, p: "cargo fmt --all --check")
    && has(s: sh, p: "rustfmt drift")
    && has(s: sh, p: "exit 1")
}

test fn witness_no_claim_batch_dependency() -> Bool {
  let sh = expected_githooks_pre_push_sh()
  !has(s: sh, p: "claim_batch")
    && !has(s: sh, p: "--pre-push")
    && !has(s: sh, p: "ensure_bins")
    && !has(s: sh, p: "CLAIM_BATCH")
}

test fn witness_no_in_hook_build() -> Bool {
  let sh = expected_githooks_pre_push_sh()
  !has(s: sh, p: "cargo build")
    && !has(s: sh, p: "CTRL_BUILD_WRAP_CARGO")
}

test fn witness_no_corpus_or_witness_run() -> Bool {
  let sh = expected_githooks_pre_push_sh()
  !has(s: sh, p: "gunbc_ci_witness_corpus_only_batches")
    && !has(s: sh, p: "doc_graph_has_no_orphan_docs")
    && !has(s: sh, p: "--claim-run")
    && !has(s: sh, p: "run_generated_artifact_drift_gate_body")
}

test fn witness_no_tree_mutation() -> Bool {
  let sh = expected_githooks_pre_push_sh()
  !has(s: sh, p: "chore: apply cargo fmt")
    && !has(s: sh, p: "chore: regenerate committed projections")
    && !has(s: sh, p: "git add")
    && !has(s: sh, p: "git commit")
}

test fn witness_line_budget() -> Bool {
  let sh = expected_githooks_pre_push_sh()
  length(sh) < 700
}

