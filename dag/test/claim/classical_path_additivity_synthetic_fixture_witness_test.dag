module test.claim.classical_path_additivity_synthetic_fixture_witness_test

import std.types { Bool }
import gunbc.physics.classical_path_additivity {
  PathAdditivityRefutationReceipt,
  PathAdditivitySyntheticFixture,
  PathAdditivityCounterexampleWitness,
  path_additivity_refutation_holds_for_synthetic_fixture,
  ObservedBelowPrediction,
  ObservedAbovePrediction,
}
import gunbc.classical_path_additivity_synthetic_fixture {
  classical_path_additivity_refutation_holds,
  classical_path_additivity_refuted,
  path_additivity_subject,
  classical_path_additivity_central_band_refutation_holds,
  synthetic_blocked_count_is_resolved_zero_not_missing,
  synthetic_missing_row_yields_incomplete_inputs,
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn w_synthetic_path_additivity_refuted_by_fold_derivation() -> Bool {
  classical_path_additivity_refutation_holds()
}

test fn w_synthetic_path_additivity_rejects_fabricated_both_open_count() -> Bool {
  let witness = classical_path_additivity_refuted.witness
  let fabricated = PathAdditivityCounterexampleWitness {
    left_alternative_count: witness.left_alternative_count,
    right_alternative_count: witness.right_alternative_count,
    both_open_observed_count: witness.classical_additive_prediction,
    classical_additive_prediction: witness.classical_additive_prediction,
    mismatch_direction: witness.mismatch_direction,
  }
  let bad_receipt = PathAdditivityRefutationReceipt {
    subject: path_additivity_subject,
    witness: fabricated,
    location: classical_path_additivity_refuted.location,
  }
  !path_additivity_refutation_holds_for_synthetic_fixture(receipt: bad_receipt)
}

test fn w_synthetic_path_additivity_rejects_corrupted_left_count() -> Bool {
  let witness = classical_path_additivity_refuted.witness
  let fabricated = PathAdditivityCounterexampleWitness {
    left_alternative_count: witness.left_alternative_count + 1,
    right_alternative_count: witness.right_alternative_count,
    both_open_observed_count: witness.both_open_observed_count,
    classical_additive_prediction: witness.classical_additive_prediction,
    mismatch_direction: witness.mismatch_direction,
  }
  let bad_receipt = PathAdditivityRefutationReceipt {
    subject: path_additivity_subject,
    witness: fabricated,
    location: classical_path_additivity_refuted.location,
  }
  !path_additivity_refutation_holds_for_synthetic_fixture(receipt: bad_receipt)
}

test fn w_synthetic_central_band_refutes_with_observed_above_prediction() -> Bool {
  classical_path_additivity_central_band_refutation_holds()
}

test fn w_synthetic_blocked_count_is_resolved_zero_not_missing() -> Bool {
  synthetic_blocked_count_is_resolved_zero_not_missing()
}

test fn w_synthetic_missing_row_yields_incomplete_inputs() -> Bool {
  synthetic_missing_row_yields_incomplete_inputs()
}

test fn w_synthetic_path_additivity_subject_is_synthetic_fixture_coproduct() -> Bool {
  path_additivity_subject == PathAdditivitySyntheticFixture {}
}

test fn w_synthetic_first_minimum_witness_below_prediction() -> Bool {
  classical_path_additivity_refuted.witness.both_open_observed_count == 5
    && classical_path_additivity_refuted.witness.classical_additive_prediction == 20
    && classical_path_additivity_refuted.witness.mismatch_direction == ObservedBelowPrediction
}
