module test.claim.interpreter_replacement_cut_witness_test


data interpreter_replacement_cut_witness_note: String = "The first production ReplacementCut, asserted at the state it is actually in. This suite does NOT assert the plan is admitted -- it asserts that it refuses, and that every cause is one of the two open-decision classes. If a cause of any other class appears, that is an authoring defect in the row and this suite reds; if the undecided or uncovered counts change, the open-decision set moved and the row must be re-earned rather than silently re-counted."

fn causes_of(admission: gunbc.replacement_cut.PlanAdmission) -> List<gunbc.replacement_cut.CutRefusalCause> {
  match admission {
    gunbc.replacement_cut.PlanAdmitted { admitted: _ } => []
    gunbc.replacement_cut.PlanRefused { causes: cs } => cs
  }
}

fn is_undecided_consumer(c: gunbc.replacement_cut.CutRefusalCause) -> Bool {
  match c {
    gunbc.replacement_cut.UndispositionedConsumer { consumer: _ } => true
    gunbc.replacement_cut.UncoveredSurvivingConsumer { consumer: _ } => false
    gunbc.replacement_cut.UndispositionedEvidence { evidence: _ } => false
    gunbc.replacement_cut.CoveredByOldRoot { consumer: _ } => false
    gunbc.replacement_cut.ReplacementNamesOldRoot { consumer: _ } => false
    gunbc.replacement_cut.ConsumerDuplicated { consumer: _ } => false
    gunbc.replacement_cut.EvidenceDuplicated { evidence: _ } => false
    gunbc.replacement_cut.RegionMemberDuplicated { member: _ } => false
    gunbc.replacement_cut.EnumeratedCensusEmpty => false
    gunbc.replacement_cut.ExternalRolesEnumeratedEmpty => false
    gunbc.replacement_cut.EmptyCoveredRegion => false
    gunbc.replacement_cut.NewRootEqualsOldRoot => false
    gunbc.replacement_cut.SelfReferentialDescent => false
  }
}

fn is_uncovered_surviving(c: gunbc.replacement_cut.CutRefusalCause) -> Bool {
  match c {
    gunbc.replacement_cut.UncoveredSurvivingConsumer { consumer: _ } => true
    gunbc.replacement_cut.UndispositionedConsumer { consumer: _ } => false
    gunbc.replacement_cut.UndispositionedEvidence { evidence: _ } => false
    gunbc.replacement_cut.CoveredByOldRoot { consumer: _ } => false
    gunbc.replacement_cut.ReplacementNamesOldRoot { consumer: _ } => false
    gunbc.replacement_cut.ConsumerDuplicated { consumer: _ } => false
    gunbc.replacement_cut.EvidenceDuplicated { evidence: _ } => false
    gunbc.replacement_cut.RegionMemberDuplicated { member: _ } => false
    gunbc.replacement_cut.EnumeratedCensusEmpty => false
    gunbc.replacement_cut.ExternalRolesEnumeratedEmpty => false
    gunbc.replacement_cut.EmptyCoveredRegion => false
    gunbc.replacement_cut.NewRootEqualsOldRoot => false
    gunbc.replacement_cut.SelfReferentialDescent => false
  }
}

fn count_matching(causes: List<gunbc.replacement_cut.CutRefusalCause>, p: fn(gunbc.replacement_cut.CutRefusalCause) -> Bool) -> Int {
  fold(causes, init: 0, f: fn(acc, c) { if p(c) { acc + 1 } else { acc } })
}

// The plan refuses, and that is the authored outcome rather than a defect.
test fn interpreter_cut_plan_refuses_with_open_decisions() -> Bool {
  let causes = causes_of(admission: gunbc.interpreter_replacement_cut.interpreter_cut_admission())
  list_length(items: causes) == 6
    && count_matching(causes: causes, p: is_undecided_consumer) == 3
    && count_matching(causes: causes, p: is_uncovered_surviving) == 3
}

// Every cause is one of the two open-decision classes. Any other class is an
// authoring defect in the row, not a fact about the world.
test fn every_refusal_cause_is_an_open_decision_not_a_defect() -> Bool {
  let causes = causes_of(admission: gunbc.interpreter_replacement_cut.interpreter_cut_admission())
  fold(
    causes,
    init: true,
    f: fn(acc, c) { acc && (is_undecided_consumer(c) || is_uncovered_surviving(c)) },
  )
}

fn census_rows(census: gunbc.replacement_cut.BoundaryCensus) -> List<gunbc.replacement_cut.BoundaryConsumer> {
  match census {
    gunbc.replacement_cut.ConsumersEnumerated { consumers: rows } => rows
    gunbc.replacement_cut.BoundaryDeclaredEmpty { basis: _ } => []
  }
}

fn is_causeless_disposition(d: gunbc.replacement_cut.ConsumerDisposition) -> Bool {
  match d {
    gunbc.replacement_cut.Retire { reason: _ } => true
    gunbc.replacement_cut.ReplacedByY { new_authority: _ } => true
    gunbc.replacement_cut.RetainSameContract { justification: _, coverage: _ } => false
    gunbc.replacement_cut.RetainChangedContract { terminal_contract: _, justification: _, coverage: _ } => false
    gunbc.replacement_cut.EvidenceOnly { surviving_claim: _, reenrolled_witness: _ } => false
    gunbc.replacement_cut.Undecided => false
  }
}

fn count_consumers(rows: List<gunbc.replacement_cut.BoundaryConsumer>, p: fn(gunbc.replacement_cut.ConsumerDisposition) -> Bool) -> Int {
  fold(rows, init: 0, f: fn(acc, r) { if p(r.disposition) { acc + 1 } else { acc } })
}

fn is_retire(d: gunbc.replacement_cut.ConsumerDisposition) -> Bool {
  match d {
    gunbc.replacement_cut.Retire { reason: _ } => true
    gunbc.replacement_cut.ReplacedByY { new_authority: _ } => false
    gunbc.replacement_cut.RetainSameContract { justification: _, coverage: _ } => false
    gunbc.replacement_cut.RetainChangedContract { terminal_contract: _, justification: _, coverage: _ } => false
    gunbc.replacement_cut.EvidenceOnly { surviving_claim: _, reenrolled_witness: _ } => false
    gunbc.replacement_cut.Undecided => false
  }
}

fn is_replaced(d: gunbc.replacement_cut.ConsumerDisposition) -> Bool {
  match d {
    gunbc.replacement_cut.ReplacedByY { new_authority: _ } => true
    gunbc.replacement_cut.Retire { reason: _ } => false
    gunbc.replacement_cut.RetainSameContract { justification: _, coverage: _ } => false
    gunbc.replacement_cut.RetainChangedContract { terminal_contract: _, justification: _, coverage: _ } => false
    gunbc.replacement_cut.EvidenceOnly { surviving_claim: _, reenrolled_witness: _ } => false
    gunbc.replacement_cut.Undecided => false
  }
}

// A row whose subject leaves with X needs no coverage authority. Asserted as the
// ARITHMETIC that distinguishes the arms rather than by re-stating the cause
// counts: four consumers are retired-or-replaced, ten are enumerated, and exactly
// the other six produce causes. Three DIFFERENT constants (3, 1, 10) can only hold
// together if the disposition field genuinely varies per row -- a constant or an
// unpopulated field cannot satisfy them at once.
test fn retiring_with_x_needs_no_coverage_authority() -> Bool {
  let rows = census_rows(census: gunbc.interpreter_replacement_cut.interpreter_replacement_cut().boundary_census)
  let causeless = count_consumers(rows: rows, p: is_causeless_disposition)
  list_length(items: rows) == 10
    && count_consumers(rows: rows, p: is_retire) == 3
    && count_consumers(rows: rows, p: is_replaced) == 1
    && causeless == 4
    && list_length(items: causes_of(admission: gunbc.interpreter_replacement_cut.interpreter_cut_admission()))
       == list_length(items: rows) - causeless
}

// The descent arm carries a BOUNDARY and no identifier. This is the assertion
// that the honest arm was not quietly upgraded into the joinable one.
test fn descent_names_a_boundary_and_carries_no_cut_id() -> Bool {
  match gunbc.interpreter_replacement_cut.interpreter_cut_why_not_higher() {
    gunbc.replacement_cut.DescentParentUnauthored { intended_parent_boundary: b, basis: _ } =>
      (b as String) == "the engine cut through the v1 driver region"
    gunbc.replacement_cut.OutermostBoundary => false
    gunbc.replacement_cut.DescendedFromRefusedCut { parent_cut: _, refusal_summary: _ } => false
  }
}

// The covered region is the exact set that leaves, and the old root is not in it.
test fn covered_region_is_the_deleted_set_and_excludes_the_old_root() -> Bool {
  let cut = gunbc.interpreter_replacement_cut.interpreter_replacement_cut()
  list_length(items: cut.covered_region) == 4
    && (cut.old_root_consumer as String) == "v1 .dag evaluation entry"
}
