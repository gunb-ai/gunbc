module test.claim.interpreter_replacement_cut_witness_test

import std.types { String, Bool, Int, List, list_length }
import gunbc.replacement_cut {
  ConsumerDisposition, RetainSameContract, RetainChangedContract, ReplacedByY,
  EvidenceOnly, Retire, Undecided,
  HigherBoundaryAnswer, OutermostBoundary, DescendedFromRefusedCut, DescentParentUnauthored,
  LegacyConsumerSurveyRow, LegacyReplacementSurvey,
  CutRegistration, RegisteredExactCut, RegisteredCutRemeasureRequired,
}
import gunbc.interpreter_replacement_cut {
  interpreter_replacement_survey,
  interpreter_cut_registration,
  interpreter_cut_why_not_higher,
}

data interpreter_replacement_cut_witness_note: String = "RECAST 2026-08-28 WITH THE ROW IT WITNESSES. This suite previously asserted that the interpreter ReplacementCut refuses with exactly the two open-decision cause classes. That claim no longer has a subject: the carrier re-grounded its boundary relation onto declaration-grain consumer x consumed-authority, the interpreter value was authored at module-or-binary grain over a ten-of-125 sample, and it is therefore now a LegacyReplacementSurvey plus a registered remeasurement obligation rather than an exact plan.\n\nTHE OLD ASSERTION IS NOT PRESERVED, AND THAT IS DELIBERATE RATHER THAN A LOSS. Its subject was the admission verdict of a plan that no longer exists in the exact carrier, so re-enrolling it would require reconstructing the coarse plan purely to keep asserting something about it -- the shape DESIGN §4b(4) forbids, where evidence is retained beside the machinery it was supposed to dissolve with. What survives is the pair below: the survey's measured content stays identity-bound so the historical record cannot drift, and the registration cannot be read as an admitted exact plan.\n\nWHY THE SECOND ONE IS THE LOAD-BEARING ONE: the whole risk of keeping a coarse survey in the tree is that some later consumer treats it as an exact census. RegisteredCutRemeasureRequired has no arm that yields a ReplacementCut, so that misreading is unwritable rather than merely discouraged -- but a control is enrolled anyway, because the arm could be widened by a later edit and the cost of that edit is exactly this class of laundering."

// ---------------------------------------------------------------------------
// 1. The historical survey stays identity-bound.
// ---------------------------------------------------------------------------

fn label_present(rows: List<LegacyConsumerSurveyRow>, name: String) -> Bool {
  fold(rows, init: false, f: fn(acc, r) { acc || (r.consumer_label as String) == name })
}

fn is_retire(d: ConsumerDisposition) -> Bool {
  match d {
    Retire { reason: _ } => true
    RetainSameContract { justification: _, coverage: _ } => false
    RetainChangedContract { terminal_contract: _, justification: _, coverage: _ } => false
    ReplacedByY { new_authority: _ } => false
    EvidenceOnly { surviving_claim: _, reenrolled_witness: _ } => false
    Undecided => false
  }
}

fn is_undecided(d: ConsumerDisposition) -> Bool {
  match d {
    Undecided => true
    Retire { reason: _ } => false
    RetainSameContract { justification: _, coverage: _ } => false
    RetainChangedContract { terminal_contract: _, justification: _, coverage: _ } => false
    ReplacedByY { new_authority: _ } => false
    EvidenceOnly { surviving_claim: _, reenrolled_witness: _ } => false
  }
}

fn count_rows(rows: List<LegacyConsumerSurveyRow>, p: fn(ConsumerDisposition) -> Bool) -> Int {
  fold(rows, init: 0, f: fn(acc, r) { if p(r.disposition) { acc + 1 } else { acc } })
}

test fn the_survey_keeps_its_measured_revision() -> Bool {
  (interpreter_replacement_survey().measured_revision as String) == "7f5fa6a94ec1"
}

// The grain is the whole reason this row cannot inhabit the exact carrier, so it is pinned rather
// than left to prose drift.
test fn the_survey_states_its_coarser_grain() -> Bool {
  let lim = interpreter_replacement_survey().limitation as String
  contains(lim, "ONE ROW PER CONSUMING MODULE OR BINARY")
}

test fn the_survey_keeps_its_ten_measured_consumer_rows() -> Bool {
  let s = interpreter_replacement_survey()
  list_length(items: s.consumer_rows) == 10
    && count_rows(rows: s.consumer_rows, p: is_retire) == 5
    && count_rows(rows: s.consumer_rows, p: is_undecided) == 1
}

// The four labels that named host Rust compilation units rather than .dag modules. They are pinned
// because they are the measured evidence for WHY this row could not migrate one-for-one: at exact
// grain each is a set of Rust items reached through gunbc.rust_item_host_observation, and one label
// may expand into many relations, into an uncitable impl method, or into none.
test fn the_four_host_rust_labels_are_still_recorded() -> Bool {
  let rows = interpreter_replacement_survey().consumer_rows
  label_present(rows: rows, name: "v1_compiler.cli_run")
    && label_present(rows: rows, name: "v1_compiler.coproduct_reflection")
    && label_present(rows: rows, name: "v1_compiler.pre_push")
    && label_present(rows: rows, name: "v1_compiler.v1_interpreter_dispatch_generated")
}

test fn descent_names_a_boundary_and_carries_no_cut_id() -> Bool {
  match interpreter_cut_why_not_higher() {
    DescentParentUnauthored { intended_parent_boundary: b, basis: _ } =>
      (b as String) != ""
    OutermostBoundary => false
    DescendedFromRefusedCut { parent_cut: _, refusal_summary: _ } => false
  }
}

// ---------------------------------------------------------------------------
// 2. The registration cannot be projected as an admitted exact plan.
// ---------------------------------------------------------------------------

fn registration_is_remeasure_required(r: CutRegistration) -> Bool {
  match r {
    RegisteredCutRemeasureRequired { identity: _, prior_survey: _, reason: _ } => true
    RegisteredExactCut { cut: _ } => false
  }
}

test fn the_interpreter_registration_is_a_remeasurement_obligation() -> Bool {
  registration_is_remeasure_required(r: interpreter_cut_registration())
}

test fn the_registration_keeps_the_identity_visible_for_parent_resolution() -> Bool {
  match interpreter_cut_registration() {
    RegisteredCutRemeasureRequired { identity: i, prior_survey: _, reason: _ } =>
      (i as String) == "cut-v1-interpreter"
    RegisteredExactCut { cut: _ } => false
  }
}

test fn the_registration_states_why_remeasurement_is_required() -> Bool {
  match interpreter_cut_registration() {
    RegisteredCutRemeasureRequired { identity: _, prior_survey: _, reason: r } =>
      (r as String) != ""
    RegisteredExactCut { cut: _ } => false
  }
}
