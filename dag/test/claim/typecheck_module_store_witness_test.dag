module test.claim.typecheck_module_store_witness

import std.types { Bool, List, String }
import std.content_hash { content_hash_atom, as_content_hash_structural, Fnv1a64Structural }
import std.interface_summary { InterfaceHash, module_key, typed_module_key }
import std.materialization_provider { request_key }
import gunbc.materialization_store_budgets {
  typecheck_module_family_entry_budget_unit,
  materialization_store_typed_module_budget_policy,
  typecheck_store_family_budget_frontier,
  typecheck_store_family_entry_bet,
  typecheck_store_family_entry_size_read_obligation,
}
import gunbc.typed_module_cache_capacity { typed_module_cache_entries_ceiling }
import gunbc.typecheck_module_store {
  typecheck_module_request,
  typecheck_module_request_from_hex,
  TypecheckModuleRequestBuilt,
  TypecheckModuleRequestDigestRefused,
  typecheck_module_payloads,
  typecheck_module_entry_bytes,
}
import std.measure { measure_count }
import std.optional { Present }
import extdeps.external_authority { TranscribedUncited, CitedToAuthority }

fn h(v: String) -> Fnv1a64Structural {
  content_hash_atom(value: v)
}

fn iface(v: String) -> InterfaceHash {
  content_hash_atom(value: v)
}

test fn typecheck_module_request_key_is_derived_from_the_judgment_contract() -> Bool {
  let src = h(v: "source-bytes-not-a-path")
  let imp = iface(v: "iface-1")
  let compiler = h(v: "compiler-x")
  let a = typecheck_module_request(source_digest: src, direct_import_interfaces: [imp], compiler_digest: compiler)
  let b = typecheck_module_request(source_digest: src, direct_import_interfaces: [imp], compiler_digest: compiler)
  let changed = typecheck_module_request(source_digest: src, direct_import_interfaces: [iface(v: "iface-2")], compiler_digest: compiler)
  let expected = typed_module_key(
    interface_key: module_key(source_hash: src, direct_import_interface_hashes: [imp]),
    compiler_identity: compiler
  )
  request_key(req: a) == request_key(req: b)
    && (request_key(req: a) == request_key(req: changed)) == false
    && request_key(req: a) == as_content_hash_structural(structural: expected)
}

test fn typecheck_module_request_from_hex_refuses_a_non_digest() -> Bool {
  match typecheck_module_request_from_hex(source_digest_hex: "not-a-digest", import_interface_hexes: [], compiler_digest_hex: "abcd") {
    TypecheckModuleRequestDigestRefused { which: w } => w == "source_digest"
    TypecheckModuleRequestBuilt { req: _ } => false
  }
}

test fn the_family_entry_size_is_a_transcribed_uncited_bet_naming_the_real_route_instrument() -> Bool {
  match typecheck_store_family_entry_bet.standing {
    TranscribedUncited { read_obligation: o } => (o as String) == (typecheck_store_family_entry_size_read_obligation as String)
    CitedToAuthority { authority: _ } => false
  }
}

test fn the_typed_module_family_budget_is_the_entry_unit_times_the_residency_ceiling() -> Bool {
  measure_count(m: materialization_store_typed_module_budget_policy)
    == measure_count(m: typecheck_module_family_entry_budget_unit()) * typed_module_cache_entries_ceiling
}

test fn a_typecheck_entry_for_the_probe_interface_fits_the_family_entry_budget_unit() -> Bool {
  let req = typecheck_module_request(source_digest: h(v: "mod-a"), direct_import_interfaces: [], compiler_digest: h(v: "compiler-x"))
  let payloads = typecheck_module_payloads(interface: "export fn f\n", diagnostics: "")
  match typecheck_module_entry_bytes(req: req, payloads: payloads) {
    Absent => false
    Present { value: n } => measure_count(m: n) <= measure_count(m: typecheck_module_family_entry_budget_unit())
  }
}
