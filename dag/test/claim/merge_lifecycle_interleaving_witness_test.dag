module test.claim.merge_lifecycle_interleaving_witness

import gunbc.merge_lifecycle {
  PrIdentity,
  LifecycleEvent, RunPrCi, MergePr, RosterBump,
  simulate_lifecycle,
  lifecycle_admits_unverified_tip,
  squash_result_tree,
  initial_lifecycle_state,
  event_sequences_of_length_4,
  count_unverified_admitting_sequences,
}
import gunbc.merge_admission {
  AdmissionPolicy,
  PerPrGateOnly, RequireUpToDateBase, KeyedReceipt, ReportedContextsAtMergeInstant,
}
import std.types { List, Bool, Int, String }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// The two PRs of the 2026-07-16 main-red, as symbolic identities (real receipts cited in
// gunbc.merge_lifecycle.merge_lifecycle_incident_note: #6663 green run 29459154549, first union red
// run 29461044828, root fix #6701). pr_a is #6663 (the P0 field wall), pr_b is #6686 (the std.types
// import edge). Zero file overlap, both green in isolation, union red — the judge-x-evidence squash
// race.

data pr_a: PrIdentity = PrIdentity {
  number: 6663,
  head_sha: "pr-6663-head-sha-fixture",
  squash_tag: "squash-pr-6663",
}

data pr_b: PrIdentity = PrIdentity {
  number: 6686,
  head_sha: "pr-6686-head-sha-fixture",
  squash_tag: "squash-pr-6686",
}

data pr_a_healed: PrIdentity = PrIdentity {
  number: 6663,
  head_sha: "pr-6663-healed-head-sha-fixture",
  squash_tag: "squash-pr-6663-healed",
}

fn incident_trace() -> List<LifecycleEvent> {
  [
    RunPrCi { pr: pr_a },
    RunPrCi { pr: pr_b },
    MergePr { pr: pr_b },
    MergePr { pr: pr_a },
  ]
}

test fn incident_trace_reds_main_under_per_pr_gate_only() -> Bool {
  lifecycle_admits_unverified_tip(policy: PerPrGateOnly, events: incident_trace())
}

test fn incident_trace_final_merge_refused_under_keyed_receipt() -> Bool {
  let end_state = simulate_lifecycle(policy: KeyedReceipt, events: incident_trace())
  let tip_after_b_only = squash_result_tree(pr: pr_b, base: initial_lifecycle_state().main_tip)
  !end_state.unverified_tip_seen && end_state.main_tip == tip_after_b_only
}

test fn incident_trace_lands_verified_when_pr_a_reruns_ci_first() -> Bool {
  let refreshed = [
    RunPrCi { pr: pr_a },
    RunPrCi { pr: pr_b },
    MergePr { pr: pr_b },
    RunPrCi { pr: pr_a },
    MergePr { pr: pr_a },
  ]
  let end_state = simulate_lifecycle(policy: KeyedReceipt, events: refreshed)
  let tip_b = squash_result_tree(pr: pr_b, base: initial_lifecycle_state().main_tip)
  !end_state.unverified_tip_seen && end_state.main_tip == squash_result_tree(pr: pr_a, base: tip_b)
}

test fn healed_head_cannot_reuse_old_head_evidence() -> Bool {
  let events = [
    RunPrCi { pr: pr_a },
    MergePr { pr: pr_a_healed },
  ]
  let end_state = simulate_lifecycle(policy: KeyedReceipt, events: events)
  !end_state.unverified_tip_seen && end_state.main_tip == initial_lifecycle_state().main_tip
}

test fn healed_head_lands_after_exact_head_revalidation() -> Bool {
  let events = [
    RunPrCi { pr: pr_a },
    RunPrCi { pr: pr_a_healed },
    MergePr { pr: pr_a_healed },
  ]
  let end_state = simulate_lifecycle(policy: KeyedReceipt, events: events)
  !end_state.unverified_tip_seen
    && end_state.main_tip == squash_result_tree(pr: pr_a_healed, base: initial_lifecycle_state().main_tip)
}

// The pair above differs only by the revalidation event. A receipt selected by PR number alone
// fails healed_head_cannot_reuse_old_head_evidence: the healed tree lands on the old head's green.
// Requiring the exact head refuses that trace, while RunPrCi(pr_a_healed) lands the paired trace —
// the repair does not reject every healed head.

// Alphabet = both incident PRs' RunPrCi and MergePr, a same-number/different-head healed MergePr,
// plus RosterBump (criteria drift). MergePr(pr_b) is enabled only by pr_b's own receipts and
// MergePr(pr_a_healed) only by evidence for that exact head, so the enumeration covers fresh
// merges, stale merges, re-runs, double-merges, roster drift, and an auto-heal head transition in
// every order of length 4 — 6^4 = 1296 sequences, all enumerated, none sampled.

fn interleaving_alphabet() -> List<LifecycleEvent> {
  [
    RunPrCi { pr: pr_a },
    RunPrCi { pr: pr_b },
    MergePr { pr: pr_a },
    MergePr { pr: pr_b },
    MergePr { pr: pr_a_healed },
    RosterBump,
  ]
}

fn window_4_sequences() -> List<List<LifecycleEvent>> {
  event_sequences_of_length_4(alphabet: interleaving_alphabet())
}

test fn window_4_enumerates_all_1296_sequences() -> Bool {
  length(window_4_sequences()) == 1296
}

test fn keyed_receipt_admits_no_unverified_tip_across_window_4() -> Bool {
  count_unverified_admitting_sequences(policy: KeyedReceipt, seqs: window_4_sequences()) == 0
}

test fn per_pr_gate_only_admits_unverified_tips_in_window_4() -> Bool {
  count_unverified_admitting_sequences(policy: PerPrGateOnly, seqs: window_4_sequences()) > 0
}

// The four counts quantify gunbc.plans.branch_merge_admission_model section 4 over EVERY length-4
// lifecycle, not authored scenarios: ReportedContextsAtMergeInstant (the live policy, per
// gunbc.merge_admission — GitHub strict flag false, no queue, and an unreported required context
// reading as not-failing) admits unverified tips with no evidence at all; PerPrGateOnly (named the
// live policy here until 2026-09-03, and stronger than the live one) admits unverified tips; RequireUpToDateBase (GitHub's strict boolean, tree axis only)
// still admits a tree verified under a superseded gate roster; KeyedReceipt admits zero across the
// window, including the same-PR healed-head transition — green-stays-green as a
// bounded-exhaustive theorem. The positive PerPrGateOnly count proves the enumerator can see
// violations; the paired heal witnesses locate the exact-head discrimination rather than relying
// on the aggregate zero.

test fn require_up_to_date_base_misses_the_roster_axis_in_window_4() -> Bool {
  count_unverified_admitting_sequences(policy: RequireUpToDateBase, seqs: window_4_sequences()) > 0
}

// THE ONE-EVENT PAIR IS THE DISCRIMINATOR FOR THE ABSENT-RECEIPT AXIS, and it is a PAIR rather
// than a single assertion because the whole content of the finding is that two policies disagree
// on exactly this input. A bare MergePr with no preceding RunPrCi is gunbc#10236 in this model's
// vocabulary: the merge call arrives before any required context has reported. Under
// ReportedContextsAtMergeInstant it lands an unverified tip; under PerPrGateOnly, whose admission
// is derived from a receipt, the same sequence refuses. Asserting only the first would be green
// under a policy_admits_absent_receipt that answered true for everything, which is exactly the
// defect the fold seed used to hide in the opposite direction.

test fn a_merge_before_any_run_lands_an_unverified_tip_under_the_live_policy() -> Bool {
  lifecycle_admits_unverified_tip(
    policy: ReportedContextsAtMergeInstant,
    events: [MergePr { pr: pr_a }],
  )
}

test fn a_merge_before_any_run_is_refused_under_per_pr_gate_only() -> Bool {
  !lifecycle_admits_unverified_tip(policy: PerPrGateOnly, events: [MergePr { pr: pr_a }])
}

test fn a_merge_before_any_run_is_refused_under_keyed_receipt() -> Bool {
  !lifecycle_admits_unverified_tip(policy: KeyedReceipt, events: [MergePr { pr: pr_a }])
}

// The window-4 count is asserted STRICTLY GREATER than PerPrGateOnly's rather than merely positive:
// the live policy admits everything PerPrGateOnly admits and additionally every sequence whose
// merges precede their runs, so an implementation that made the new arm behave like the old one
// would keep both positive counts and fail here.

test fn the_live_policy_admits_strictly_more_unverified_tips_than_per_pr_gate_only() -> Bool {
  count_unverified_admitting_sequences(
    policy: ReportedContextsAtMergeInstant,
    seqs: window_4_sequences(),
  ) > count_unverified_admitting_sequences(policy: PerPrGateOnly, seqs: window_4_sequences())
}
