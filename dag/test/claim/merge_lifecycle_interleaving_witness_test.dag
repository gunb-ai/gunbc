module test.claim.merge_lifecycle_interleaving_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data incident_fixture_note: String = "The two PRs of the 2026-07-16 main-red, as symbolic identities (real receipts cited in gunbc.merge_lifecycle.merge_lifecycle_incident_note: #6663 green run 29459154549, first union red run 29461044828, root fix #6701). pr_a is #6663 (the P0 field wall), pr_b is #6686 (the std.types import edge). Zero file overlap, both green in isolation, union red — the judge-x-evidence squash race."

data pr_a: gunbc.merge_lifecycle.PrIdentity = gunbc.merge_lifecycle.PrIdentity {
  number: 6663,
  head_sha: "pr-6663-head-sha-fixture",
  squash_tag: "squash-pr-6663",
}

data pr_b: gunbc.merge_lifecycle.PrIdentity = gunbc.merge_lifecycle.PrIdentity {
  number: 6686,
  head_sha: "pr-6686-head-sha-fixture",
  squash_tag: "squash-pr-6686",
}

data pr_a_healed: gunbc.merge_lifecycle.PrIdentity = gunbc.merge_lifecycle.PrIdentity {
  number: 6663,
  head_sha: "pr-6663-healed-head-sha-fixture",
  squash_tag: "squash-pr-6663-healed",
}

fn incident_trace() -> List<gunbc.merge_lifecycle.LifecycleEvent> {
  [
    gunbc.merge_lifecycle.RunPrCi { pr: pr_a },
    gunbc.merge_lifecycle.RunPrCi { pr: pr_b },
    gunbc.merge_lifecycle.MergePr { pr: pr_b },
    gunbc.merge_lifecycle.MergePr { pr: pr_a },
  ]
}

test fn incident_trace_reds_main_under_per_pr_gate_only() -> Bool {
  gunbc.merge_lifecycle.lifecycle_admits_unverified_tip(policy: gunbc.merge_admission.PerPrGateOnly, events: incident_trace())
}

test fn incident_trace_final_merge_refused_under_keyed_receipt() -> Bool {
  let end_state = gunbc.merge_lifecycle.simulate_lifecycle(policy: gunbc.merge_admission.KeyedReceipt, events: incident_trace())
  let tip_after_b_only = gunbc.merge_lifecycle.squash_result_tree(pr: pr_b, base: gunbc.merge_lifecycle.initial_lifecycle_state().main_tip)
  !end_state.unverified_tip_seen && end_state.main_tip == tip_after_b_only
}

test fn incident_trace_lands_verified_when_pr_a_reruns_ci_first() -> Bool {
  let refreshed = [
    gunbc.merge_lifecycle.RunPrCi { pr: pr_a },
    gunbc.merge_lifecycle.RunPrCi { pr: pr_b },
    gunbc.merge_lifecycle.MergePr { pr: pr_b },
    gunbc.merge_lifecycle.RunPrCi { pr: pr_a },
    gunbc.merge_lifecycle.MergePr { pr: pr_a },
  ]
  let end_state = gunbc.merge_lifecycle.simulate_lifecycle(policy: gunbc.merge_admission.KeyedReceipt, events: refreshed)
  let tip_b = gunbc.merge_lifecycle.squash_result_tree(pr: pr_b, base: gunbc.merge_lifecycle.initial_lifecycle_state().main_tip)
  !end_state.unverified_tip_seen && end_state.main_tip == gunbc.merge_lifecycle.squash_result_tree(pr: pr_a, base: tip_b)
}

test fn healed_head_cannot_reuse_old_head_evidence() -> Bool {
  let events = [
    gunbc.merge_lifecycle.RunPrCi { pr: pr_a },
    gunbc.merge_lifecycle.MergePr { pr: pr_a_healed },
  ]
  let end_state = gunbc.merge_lifecycle.simulate_lifecycle(policy: gunbc.merge_admission.KeyedReceipt, events: events)
  !end_state.unverified_tip_seen && end_state.main_tip == gunbc.merge_lifecycle.initial_lifecycle_state().main_tip
}

test fn healed_head_lands_after_exact_head_revalidation() -> Bool {
  let events = [
    gunbc.merge_lifecycle.RunPrCi { pr: pr_a },
    gunbc.merge_lifecycle.RunPrCi { pr: pr_a_healed },
    gunbc.merge_lifecycle.MergePr { pr: pr_a_healed },
  ]
  let end_state = gunbc.merge_lifecycle.simulate_lifecycle(policy: gunbc.merge_admission.KeyedReceipt, events: events)
  !end_state.unverified_tip_seen
    && end_state.main_tip == gunbc.merge_lifecycle.squash_result_tree(pr: pr_a_healed, base: gunbc.merge_lifecycle.initial_lifecycle_state().main_tip)
}

data heal_exact_head_discrimination_note: String = "The pair above differs only by the revalidation event. A receipt selected by PR number alone makes healed_head_cannot_reuse_old_head_evidence fail: the healed tree lands on the old head's green. Requiring the exact head refuses that trace, while RunPrCi(pr_a_healed) makes the paired trace land — proving the repair does not reject every healed head."

data interleaving_alphabet_note: String = "Alphabet = both incident PRs' RunPrCi and MergePr, a same-number/different-head healed MergePr, plus RosterBump (criteria drift). MergePr(pr_b) is enabled only by pr_b's own receipts, and MergePr(pr_a_healed) only by evidence for that exact head, so the enumeration exercises fresh merges, stale merges, re-runs, double-merges, roster drift, and an auto-heal head transition in every order of length 4 — 6^4 = 1296 sequences, all enumerated, none sampled."

fn interleaving_alphabet() -> List<gunbc.merge_lifecycle.LifecycleEvent> {
  [
    gunbc.merge_lifecycle.RunPrCi { pr: pr_a },
    gunbc.merge_lifecycle.RunPrCi { pr: pr_b },
    gunbc.merge_lifecycle.MergePr { pr: pr_a },
    gunbc.merge_lifecycle.MergePr { pr: pr_b },
    gunbc.merge_lifecycle.MergePr { pr: pr_a_healed },
    gunbc.merge_lifecycle.RosterBump,
  ]
}

fn window_4_sequences() -> List<List<gunbc.merge_lifecycle.LifecycleEvent>> {
  gunbc.merge_lifecycle.event_sequences_of_length_4(alphabet: interleaving_alphabet())
}

test fn window_4_enumerates_all_1296_sequences() -> Bool {
  length(window_4_sequences()) == 1296
}

test fn keyed_receipt_admits_no_unverified_tip_across_window_4() -> Bool {
  gunbc.merge_lifecycle.count_unverified_admitting_sequences(policy: gunbc.merge_admission.KeyedReceipt, seqs: window_4_sequences()) == 0
}

test fn per_pr_gate_only_admits_unverified_tips_in_window_4() -> Bool {
  gunbc.merge_lifecycle.count_unverified_admitting_sequences(policy: gunbc.merge_admission.PerPrGateOnly, seqs: window_4_sequences()) > 0
}

test fn require_up_to_date_base_misses_the_roster_axis_in_window_4() -> Bool {
  gunbc.merge_lifecycle.count_unverified_admitting_sequences(policy: gunbc.merge_admission.RequireUpToDateBase, seqs: window_4_sequences()) > 0
}

data policy_discrimination_note: String = "The three counts quantify gunbc.plans.branch_merge_admission_model section 4 over EVERY length-4 lifecycle instead of authored scenarios: PerPrGateOnly (the live policy — GitHub strict flag false, no queue) admits unverified tips; RequireUpToDateBase (GitHub's strict boolean, tree axis only) still admits landing a tree verified under a superseded gate roster; KeyedReceipt admits zero across the whole window, including the same-PR healed-head transition — green-stays-green as a bounded-exhaustive theorem, not a scenario. The positive PerPrGateOnly count proves the enumerator can see violations, while the paired heal witnesses locate the exact-head discrimination rather than relying only on the aggregate zero."
