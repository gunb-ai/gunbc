module test.claim.os_systemd_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

test fn witness_active_wire_decodes_to_active() -> Bool {
  match extdeps.systemd.parse_systemd_unit_active_state(raw: "active") {
    Present { value: extdeps.systemd.Active } => true
    _ => false
  }
}

test fn witness_wrong_case_does_not_decode() -> Bool {
  match extdeps.systemd.parse_systemd_unit_active_state(raw: "ACTIVE") {
    none => true
    _ => false
  }
}

test fn witness_roundtrip_failed() -> Bool {
  extdeps.systemd.systemd_unit_active_state_wire_label(s: extdeps.systemd.Failed) == "failed"
}

test fn witness_memory_limit_infinity_roundtrip() -> Bool {
  extdeps.systemd.systemd_memory_limit_wire_label(lim: extdeps.systemd.MemoryLimitUnbounded) == "infinity"
}

test fn witness_memory_limit_bytes_roundtrip() -> Bool {
  let cap = gunbc.ci_floor_measurement.gunbc_ci_runner_cgroup_memory_cap
  let raw = to_string(std.measure.byte_size_count(b: cap))
  match extdeps.systemd.parse_systemd_memory_limit_show(raw: raw) {
    extdeps.systemd.MemoryLimitBytes { bytes: b } =>
      extdeps.systemd.systemd_memory_limit_wire_label(lim: extdeps.systemd.MemoryLimitBytes { bytes: b }) == raw
    _ => false
  }
}
