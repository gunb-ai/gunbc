module test.claim.ci_oom_reclassify_witness


data live_tree_disposition: LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn bare_137_outcome() -> gunbc.ci_failure_class.FloorOutcome {
  gunbc.ci_failure_class.classify_floor_exit(e: std.process.ExitFailure { code: 137, reason: "Process completed with exit code 137." })
}

fn outcome_is_infra(o: gunbc.ci_failure_class.FloorOutcome) -> Bool {
  match o {
    NoFailure => false
    gunbc.ci_failure_class.FloorFailed { class: c } => match c {
      Infra { signature: _ } => true
      gunbc.ci_failure_class.Structural { reason: _ } => false
    }
  }
}

fn outcome_is_structural(o: gunbc.ci_failure_class.FloorOutcome) -> Bool {
  match o {
    NoFailure => false
    gunbc.ci_failure_class.FloorFailed { class: c } => match c {
      Infra { signature: _ } => false
      gunbc.ci_failure_class.Structural { reason: _ } => true
    }
  }
}

fn confirmed_cgroup_oom() -> gunbc.ci_oom_reclassify.OomKillObservation {
  gunbc.ci_oom_reclassify.observe_oom_kill(cgroup: gunbc.ci_oom_reclassify.oom_kill_from_cgroup_counter(oom_kill_count: 1), oomd: gunbc.ci_oom_reclassify.oom_kill_from_oomd_journal(oomd_kill_record_count: 0))
}

fn confirmed_oomd_oom() -> gunbc.ci_oom_reclassify.OomKillObservation {
  gunbc.ci_oom_reclassify.observe_oom_kill(cgroup: gunbc.ci_oom_reclassify.oom_kill_from_cgroup_counter(oom_kill_count: 0), oomd: gunbc.ci_oom_reclassify.oom_kill_from_oomd_journal(oomd_kill_record_count: 1))
}

fn no_oom() -> gunbc.ci_oom_reclassify.OomKillObservation {
  gunbc.ci_oom_reclassify.observe_oom_kill(cgroup: gunbc.ci_oom_reclassify.oom_kill_from_cgroup_counter(oom_kill_count: 0), oomd: gunbc.ci_oom_reclassify.oom_kill_from_oomd_journal(oomd_kill_record_count: 0))
}

fn clustered_simultaneous() -> gunbc.ci_oom_reclassify.ClusteringEvidence {
  gunbc.ci_oom_reclassify.Clustered { signal: gunbc.ci_oom_reclassify.SimultaneousMultiJobDeath { job_count: 3 } }
}

fn witness_clustered_oom_promotes_137_to_infra_nonblocking() -> Bool {
  let before = bare_137_outcome()
  let after = gunbc.ci_oom_reclassify.reclassify_floor_outcome(o: before, oom: confirmed_cgroup_oom(), clustering: clustered_simultaneous())
  outcome_is_structural(o: before)
    && gunbc.ci_failure_class.floor_outcome_blocks_merge(o: before)
    && outcome_is_infra(o: after)
    && (gunbc.ci_failure_class.floor_outcome_blocks_merge(o: after) == false)
}

fn witness_boot_id_reset_clustering_also_promotes() -> Bool {
  let before = bare_137_outcome()
  let clu = gunbc.ci_oom_reclassify.clustering_signal_from_boot_id(boot_id_before: "boot-uuid-A", boot_id_after: "boot-uuid-B")
  let after = gunbc.ci_oom_reclassify.reclassify_floor_outcome(o: before, oom: confirmed_oomd_oom(), clustering: clu)
  gunbc.ci_oom_reclassify.clustering_is_present(c: clu)
    && outcome_is_infra(o: after)
    && (gunbc.ci_failure_class.floor_outcome_blocks_merge(o: after) == false)
}

fn witness_lone_137_no_clustering_stays_structural_blocks() -> Bool {
  let before = bare_137_outcome()
  let after = gunbc.ci_oom_reclassify.reclassify_floor_outcome(o: before, oom: confirmed_cgroup_oom(), clustering: gunbc.ci_oom_reclassify.NotClustered)
  outcome_is_structural(o: after)
    && gunbc.ci_failure_class.floor_outcome_blocks_merge(o: after)
}

fn witness_no_confirmed_oom_stays_structural_blocks() -> Bool {
  let before = bare_137_outcome()
  let after = gunbc.ci_oom_reclassify.reclassify_floor_outcome(o: before, oom: no_oom(), clustering: clustered_simultaneous())
  (gunbc.ci_oom_reclassify.oom_is_confirmed(o: no_oom()) == false)
    && outcome_is_structural(o: after)
    && gunbc.ci_failure_class.floor_outcome_blocks_merge(o: after)
}

fn witness_dispatch_two_handlers_one_fact() -> Bool {
  gunbc.ci_oom_reclassify.oom_is_confirmed(o: confirmed_cgroup_oom())
    && gunbc.ci_oom_reclassify.oom_is_confirmed(o: confirmed_oomd_oom())
    && (gunbc.ci_oom_reclassify.oom_is_confirmed(o: no_oom()) == false)
}

fn witness_boot_id_oracle_discriminates() -> Bool {
  gunbc.ci_oom_reclassify.host_boot_id_reset(boot_id_before: "boot-uuid-A", boot_id_after: "boot-uuid-B")
    && (gunbc.ci_oom_reclassify.host_boot_id_reset(boot_id_before: "boot-uuid-A", boot_id_after: "boot-uuid-A") == false)
}

fn witness_reclassify_never_demotes_or_touches_non_137() -> Bool {
  let no_failure = gunbc.ci_oom_reclassify.reclassify_floor_outcome(o: gunbc.ci_failure_class.NoFailure, oom: confirmed_cgroup_oom(), clustering: clustered_simultaneous())
  let already_infra = gunbc.ci_failure_class.FloorFailed { class: gunbc.ci_failure_class.Infra { signature: gunbc.ci_failure_class.ClusteredOutOfMemoryKill } }
  let still_infra = gunbc.ci_oom_reclassify.reclassify_floor_outcome(o: already_infra, oom: no_oom(), clustering: gunbc.ci_oom_reclassify.NotClustered)
  let real_compile_error = gunbc.ci_failure_class.FloorFailed { class: gunbc.ci_failure_class.Structural { reason: "error[E0599]: no method named frobnicate" } }
  let unchanged = gunbc.ci_oom_reclassify.reclassify_floor_outcome(o: real_compile_error, oom: no_oom(), clustering: clustered_simultaneous())
  (match no_failure { NoFailure => true  gunbc.ci_failure_class.FloorFailed { class: _ } => false })
    && outcome_is_infra(o: still_infra)
    && outcome_is_structural(o: unchanged)
    && gunbc.ci_failure_class.floor_outcome_blocks_merge(o: unchanged)
}

test fn ci_oom_reclassify_witnesses() -> Bool {
  witness_clustered_oom_promotes_137_to_infra_nonblocking()
    && witness_boot_id_reset_clustering_also_promotes()
    && witness_lone_137_no_clustering_stays_structural_blocks()
    && witness_no_confirmed_oom_stays_structural_blocks()
    && witness_dispatch_two_handlers_one_fact()
    && witness_boot_id_oracle_discriminates()
    && witness_reclassify_never_demotes_or_touches_non_137()
}
