module test.claim.ci_oom_reclassify_witness

data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn bare_137_outcome() -> gunbc.ci_failure_class.FloorOutcome {
  classify_floor_exit(e: std.process.ExitFailure { code: 137, reason: "Process completed with exit code 137." })
}

fn outcome_is_infra(o: gunbc.ci_failure_class.FloorOutcome) -> Bool {
  match o {
    NoFailure => false
    FloorFailed { class: c } => match c {
      Infra { signature: _ } => true
      Structural { reason: _ } => false
    }
  }
}

fn outcome_is_structural(o: gunbc.ci_failure_class.FloorOutcome) -> Bool {
  match o {
    NoFailure => false
    FloorFailed { class: c } => match c {
      Infra { signature: _ } => false
      Structural { reason: _ } => true
    }
  }
}

fn confirmed_cgroup_oom() -> gunbc.ci_oom_reclassify.OomKillObservation {
  observe_oom_kill(cgroup: oom_kill_from_cgroup_counter(oom_kill_count: 1), oomd: oom_kill_from_oomd_journal(oomd_kill_record_count: 0))
}

fn confirmed_oomd_oom() -> gunbc.ci_oom_reclassify.OomKillObservation {
  observe_oom_kill(cgroup: oom_kill_from_cgroup_counter(oom_kill_count: 0), oomd: oom_kill_from_oomd_journal(oomd_kill_record_count: 1))
}

fn no_oom() -> gunbc.ci_oom_reclassify.OomKillObservation {
  observe_oom_kill(cgroup: oom_kill_from_cgroup_counter(oom_kill_count: 0), oomd: oom_kill_from_oomd_journal(oomd_kill_record_count: 0))
}

fn clustered_simultaneous() -> gunbc.ci_oom_reclassify.ClusteringEvidence {
  gunbc.ci_oom_reclassify.Clustered { signal: gunbc.ci_oom_reclassify.SimultaneousMultiJobDeath { job_count: 3 } }
}

test fn witness_clustered_oom_promotes_137_to_infra_nonblocking() -> Bool {
  let before = bare_137_outcome()
  let after = reclassify_floor_outcome(o: before, oom: confirmed_cgroup_oom(), clustering: clustered_simultaneous())
  outcome_is_structural(o: before)
    && floor_outcome_blocks_merge(o: before)
    && outcome_is_infra(o: after)
    && (floor_outcome_blocks_merge(o: after) == false)
}

test fn witness_boot_id_reset_clustering_also_promotes() -> Bool {
  let before = bare_137_outcome()
  let clu = clustering_signal_from_boot_id(boot_id_before: "boot-uuid-A", boot_id_after: "boot-uuid-B")
  let after = reclassify_floor_outcome(o: before, oom: confirmed_oomd_oom(), clustering: clu)
  clustering_is_present(c: clu)
    && outcome_is_infra(o: after)
    && (floor_outcome_blocks_merge(o: after) == false)
}

test fn witness_lone_137_no_clustering_stays_structural_blocks() -> Bool {
  let before = bare_137_outcome()
  let after = reclassify_floor_outcome(o: before, oom: confirmed_cgroup_oom(), clustering: NotClustered)
  outcome_is_structural(o: after)
    && floor_outcome_blocks_merge(o: after)
}

test fn witness_no_confirmed_oom_stays_structural_blocks() -> Bool {
  let before = bare_137_outcome()
  let after = reclassify_floor_outcome(o: before, oom: no_oom(), clustering: clustered_simultaneous())
  (oom_is_confirmed(o: no_oom()) == false)
    && outcome_is_structural(o: after)
    && floor_outcome_blocks_merge(o: after)
}

test fn witness_dispatch_two_handlers_one_fact() -> Bool {
  oom_is_confirmed(o: confirmed_cgroup_oom())
    && oom_is_confirmed(o: confirmed_oomd_oom())
    && (oom_is_confirmed(o: no_oom()) == false)
}

test fn witness_boot_id_oracle_discriminates() -> Bool {
  host_boot_id_reset(boot_id_before: "boot-uuid-A", boot_id_after: "boot-uuid-B")
    && (host_boot_id_reset(boot_id_before: "boot-uuid-A", boot_id_after: "boot-uuid-A") == false)
}

test fn witness_reclassify_never_demotes_or_touches_non_137() -> Bool {
  let no_failure = reclassify_floor_outcome(o: NoFailure, oom: confirmed_cgroup_oom(), clustering: clustered_simultaneous())
  let already_infra = gunbc.ci_failure_class.FloorFailed { class: gunbc.ci_failure_class.Infra { signature: ClusteredOutOfMemoryKill } }
  let still_infra = reclassify_floor_outcome(o: already_infra, oom: no_oom(), clustering: NotClustered)
  let real_compile_error = gunbc.ci_failure_class.FloorFailed { class: gunbc.ci_failure_class.Structural { reason: "error[E0599]: no method named frobnicate" } }
  let unchanged = reclassify_floor_outcome(o: real_compile_error, oom: no_oom(), clustering: clustered_simultaneous())
  (match no_failure { NoFailure => true  FloorFailed { class: _ } => false })
    && outcome_is_infra(o: still_infra)
    && outcome_is_structural(o: unchanged)
    && floor_outcome_blocks_merge(o: unchanged)
}

