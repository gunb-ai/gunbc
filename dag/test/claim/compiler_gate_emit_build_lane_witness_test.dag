module test.claim.compiler_gate_emit_build_lane_witness_test

import std.types { Bool, List, String }
import std.optional { Present, Absent }
import extdeps.github.actions { Step, RunStep, UsesStep, WorkflowPermissions }
import extdeps.languages.yaml.types { YamlString }
import gunbc.compiler_gate_workflow {
  compiler_gate_workflow,
  compiler_gate_required_job, compiler_gate_required_job_id,
  compiler_gate_fleet_job_condition,
  compiler_gate_emit_build_bound_steps,
  compiler_gate_emit_build_capability_closure_holds,
  compiler_gate_emit_build_notice_step,
  compiler_gate_emit_build_notice_lines,
  compiler_gate_emit_build_step
}
import gunbc.emitted_subject_build_gate {
  NativeEmitBuildStanding, EmitBuildExpectedGreen, EmitBuildExpectedRed, EmittedBuildSignature,
  emit_build_standing_notice_for,
  emitted_subject_build_rows,
  emitted_subject_build_label_text,
  emitted_subject_build_command,
  emitted_subject_build_step_name,
  native_fault_experiment_env_name, native_fault_experiment_skip_value,
  native_product_reuse_env_name, native_product_reuse_fresh_value,
  native_step_memory_bind_env_name, native_step_memory_trip_text
}
import extdeps.exec.command { shell_command_render }
import v2.std.algebra { length, filter }
import extdeps.filesystem.filesystem_io
import gunbc.instrument_targets { self_host_entry, v2_native_cli_entry }

// WHAT THIS FILE DISCRIMINATES, after the operator ruling of 2026-10-09 collapsed the emit-build
// lane and the aggregate that read it into ONE required job named `witnesses`: that the workflow
// runs exactly that job and nothing beside it; that the job's steps invoke the two declared
// instrument labels rather than a spelling of them, one step per subject; that every subject step
// asks for a FRESH product and the job binds no native product store, so a restored final product
// cannot stand in for the emission and build the job claims; that the job is fleet-guarded; and
// that the failure notice a stranger reads is rendered blocking, discriminating and owner-free.
//
// THE CLAIMS OVER THE DERIVED AGGREGATE LEFT WITH IT -- lane rows, standings, the env block and the
// shell conditionals folded from them. With one job there is no roster to join, and a claim that
// the job list equals a one-row roster would be a count of one standing where the job list is.
//
// THE INHABITANCE HALF IS THE LIVE WORKFLOW ITSELF (DESIGN section 3, the pairing obligation):
// every claim below reads `compiler_gate_workflow` or `compiler_gate_required_job` on the real
// value, so a change to the emitted workflow reddens this file.

fn step_run_text(step: Step) -> String {
  match step {
    RunStep { name: _, id: _, run: run, shell: _, env: _, working_directory: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } => run
    UsesStep { name: _, id: _, uses: _, with: _, env: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } => ""
  }
}

fn step_name_text(step: Step) -> String {
  match step {
    RunStep { name: n, id: _, run: _, shell: _, env: _, working_directory: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } =>
      match n { Present { value: v } => v  Absent => "" }
    UsesStep { name: n, id: _, uses: _, with: _, env: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } =>
      match n { Present { value: v } => v  Absent => "" }
  }
}

fn step_env_has(step: Step, key: String, value: String) -> Bool {
  match step {
    RunStep { name: _, id: _, run: _, shell: _, env: e, working_directory: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } =>
      match e {
        Present { value: kvs } => any(kvs, k =>
          k.key == key && (match k.value { YamlString { value: v } => v == value  _ => false }))
        Absent => false
      }
    UsesStep { name: _, id: _, uses: _, with: _, env: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } => false
  }
}

// ═══ ONE JOB, AND IT CARRIES THE RULESET'S CONTEXT ═══

// THE WORKFLOW RUNS EXACTLY THE REQUIRED JOB. Read at identity grain in both directions: a second
// job (an aggregate regrown, a lane returned) reds this, and so does a workflow that lost the job.
test fn the_workflow_runs_exactly_the_required_job() -> Bool {
  let ids = compiler_gate_workflow.jobs |> map(j => j.id)
  compiler_gate_required_job_id == "witnesses"
    && any(ids, id => id == compiler_gate_required_job_id)
    && all(ids, id => id == compiler_gate_required_job_id)
}

// THE FOUR WITHDRAWN LANES ARE NOT JOBS (operator ruling 2026-10-09, gunbc.rung_drop
// v1_required_lanes_withdrawn). Each id is named, because a workflow carrying one of them again is
// exactly the state a partial revert of the cut would leave; the claim above is the positive half.
data withdrawn_lane_job_ids: List<String> = ["rust-unit-tests", "seed", "floor", "generated", "emit-build"]

test fn w_RED_the_withdrawn_lanes_are_not_jobs() -> Bool {
  let ids = compiler_gate_workflow.jobs |> map(j => j.id)
  all(withdrawn_lane_job_ids, w => any(ids, id => id == w) == false)
}

// THE JOB IS FLEET-GUARDED: fork code does not run on the fleet, so a fork pull request produces no
// `witnesses` check (unobserved, never excused). The guard is the one authority
// (compiler_gate_fleet_job_condition) rather than a second spelling of it.
test fn the_required_job_is_fleet_guarded() -> Bool {
  match compiler_gate_required_job().if_condition {
    Present { value: c } =>
      c == compiler_gate_fleet_job_condition() && string_contains(s: c, pattern: "github.repository")
    Absent => false
  }
}

// ═══ THE SUBJECTS ═══

// THE SUBJECTS ARE THE TWO RETAINED NATIVE COMPILATIONS, BY LABEL. A green here that named one
// subject would be the coverage claim without the coverage; a third row is the growth the operator
// vetoed on 2026-10-09 (the roster "remains the two compiler products").
test fn the_job_runs_both_retained_emit_build_subjects() -> Bool {
  (emitted_subject_build_rows() |> map(r => emitted_subject_build_label_text(row: r))) == [
    "//gunbc/instruments:self-host",
    "//gunbc/instruments:v2-native-cli"
  ]
}

// THE ARGV IS `gunbc test <label>` AGAINST THE BUILT SEED BINARY, not a claim_executor flag: the
// withdrawn `--self-host` route is exactly the fork DESIGN's "Building & checks" section records.
test fn each_subject_is_invoked_through_gunbc_test() -> Bool {
  all(emitted_subject_build_rows(), row =>
    string_contains(
      s: shell_command_render(command: emitted_subject_build_command(row: row)),
      pattern: "target/release/gunbc"
    )
  )
}

// ONE STEP PER SUBJECT, JOINED AT IDENTITY RATHER THAN COUNTED. A job that grew a subject without
// growing a step would run one compilation and report on two; a job that kept a step for a subject
// no row declares would report on a compilation nobody rostered. Both directions are read by step
// NAME, which gunbc.emitted_subject_build_gate derives from the row's label.
test fn the_job_binds_one_step_per_subject() -> Bool {
  let names = compiler_gate_emit_build_bound_steps() |> map(b => b.step_name)
  let subject_names = emitted_subject_build_rows() |> map(r => emitted_subject_build_step_name(row: r))
  all(subject_names, s => length(xs: filter(xs: names, predicate: fn(n) { n == s })) == 1)
    && length(xs: filter(xs: names, predicate: fn(n) { string_contains(s: n, pattern: "emit and build ") }))
      == length(xs: subject_names)
}

// THE CARGO CONSUMER HAS A PROVIDER ORDERED BEFORE IT.
test fn the_job_capability_closure_holds() -> Bool {
  compiler_gate_emit_build_capability_closure_holds()
}

// ═══ FRESH PRODUCTS, NO STORE (operator ruling 2026-10-09, second correction) ═══

// EVERY SUBJECT STEP ASKS FOR A FRESH PRODUCT, BY VALUE. The runner under this input consults no
// native product store and refuses one if bound (native_lane_runner PRODUCT_REUSE_ENV), so the
// step's green means THIS run emitted and built the product. A step lacking the input, or carrying
// a different value, would let a restored hit satisfy the step.
test fn every_subject_step_requires_a_fresh_product() -> Bool {
  all(emitted_subject_build_rows(), row =>
    step_env_has(step: compiler_gate_emit_build_step(row: row), key: native_product_reuse_env_name, value: native_product_reuse_fresh_value))
}

// EVERY SUBJECT STEP CARRIES THE MEMORY ENVELOPE, BY VALUE: the bind input whose bytes gunbc test
// hands the kernel (gunbc.emitted_subject_build_gate native_step_memory_trip_bytes). A step without
// it runs unbounded inside the slot, and a trip would then be the slot's OOM rather than the
// step's -- the runner process among the kernel's candidates.
test fn every_subject_step_carries_the_memory_envelope() -> Bool {
  all(emitted_subject_build_rows(), row =>
    step_env_has(step: compiler_gate_emit_build_step(row: row), key: native_step_memory_bind_env_name, value: native_step_memory_trip_text()))
}

// AND THE FAILURE NOTICE EXPLAINS THE TRIP: the bytes, the exit code the kernel leaves, and that
// nothing retries bigger. A reader of an exit-137 step would otherwise read it as a crash.
test fn the_notice_names_the_trip_and_refuses_a_bigger_retry() -> Bool {
  let text = join(compiler_gate_emit_build_notice_lines(), "\n")
  string_contains(s: text, pattern: native_step_memory_trip_text())
    && string_contains(s: text, pattern: "exit of 137")
    && string_contains(s: text, pattern: "no larger runner and no retry")
    && string_contains(s: text, pattern: "MEMORY RECEIPT")
}

// THE JOB BINDS NO NATIVE PRODUCT STORE: no step names the store root variable, no step is a store
// federation or save, and the job mints no id-token (the store's federations were its only
// consumer). A store step returning beside the fresh input would make the two contradict, which
// the runner refuses -- but the contradiction is caught here first, at the authority.
data native_product_store_step_markers: List<String> = ["GUNBC_NATIVE_CACHE_ROOT", "native-product-read", "native-product-write", "native_product_save_wet"]

test fn w_RED_the_job_binds_no_native_product_store() -> Bool {
  let steps = compiler_gate_required_job().steps
  let no_store_text = all(steps, s =>
    all(native_product_store_step_markers, m =>
      (string_contains(s: step_run_text(step: s), pattern: m) == false)
        && (string_contains(s: step_name_text(step: s), pattern: m) == false)))
  let no_id_token = match compiler_gate_required_job().permissions {
    Present { value: p } => match p.id_token { Absent => true  Present { value: _ } => false }
    Absent => true
  }
  no_store_text && no_id_token
}

// THE PER-PR RELIEF IS A MODELED INPUT ON EVERY SUBJECT STEP (gunbc.rung_drop
// native_fault_experiment_off_pull_requests): each step passes the env var, whose expression skips
// on pull_request and runs otherwise. A step lacking it would run the fault experiment on PRs.
test fn every_subject_step_passes_the_fault_experiment_input() -> Bool {
  all(emitted_subject_build_rows(), row => match compiler_gate_emit_build_step(row: row) {
    RunStep { name: _, id: _, run: _, shell: _, env: e, working_directory: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } =>
      match e {
        Present { value: kvs } => any(kvs, k => k.key == native_fault_experiment_env_name)
        Absent => false
      }
    UsesStep { name: _, id: _, uses: _, with: _, env: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } => false
  })
}

// ═══ THE STANDING NOTICE: WHAT A STRANGER READS WHEN THEY CLICK THE RED X ═══
//
// THE LIVE STANDING IS GREEN, so the red arm is reachable only over a SUPPLIED standing. These
// claims render it through this probe, so the discriminator, the no-owner rule and the retirement
// condition stay exercised while no red is declared; the live claim asserts the green, blocking
// notice -- blocking because the job IS the required context, not because a row says so.
fn advisory_red_probe_notice() -> String {
  join(emit_build_standing_notice_for(standing: EmitBuildExpectedRed {
    known_signature: EmittedBuildSignature { error_code: "E9999", symbol: "Probe", emitted_path: "src/probe.rs" }
  }, lane_blocks: false), "\n")
}

test fn the_live_notice_is_green_and_blocking() -> Bool {
  let text = join(compiler_gate_emit_build_notice_lines(), "\n")
  string_contains(s: text, pattern: "BLOCKS your merge")
    && (string_contains(s: text, pattern: "does NOT block") == false)
    && string_contains(s: text, pattern: "REAL FINDING")
    && (string_contains(s: text, pattern: "E0573") == false)
    && (string_contains(s: text, pattern: "CONTRADICTION") == false)
}

// THE REASSURANCE ALONE WOULD BE WORSE THAN NOTHING: a standing red teaches every lane to ignore
// this job, which is how a detector dies without anyone deciding to kill it. So the notice must
// carry the DISCRIMINATOR -- what would be a genuinely new finding -- and not only the comfort.
test fn the_notice_carries_the_discriminator_and_not_only_the_reassurance() -> Bool {
  let text = join(compiler_gate_emit_build_notice_lines(), "\n")
  let probe = advisory_red_probe_notice()
  string_contains(s: probe, pattern: "does NOT block your merge")
    && string_contains(s: probe, pattern: "E9999 Probe at src/probe.rs")
    && string_contains(s: probe, pattern: "DIFFERENT error code")
    && string_contains(s: text, pattern: "REAL FINDING")
}

// THE NOTICE NAMES NO OWNING PULL REQUEST, and this claim exists because the first cut DID: a
// `String` naming a PR rots exactly as fast inside a well-typed row as in a comment.
test fn w_RED_the_notice_names_no_owning_pull_request() -> Bool {
  let text = join(compiler_gate_emit_build_notice_lines(), "\n")
  (string_contains(s: text, pattern: "#1") == false)
    && (string_contains(s: text, pattern: "#2") == false)
    && (string_contains(s: text, pattern: "PR #") == false)
    && string_contains(s: advisory_red_probe_notice(), pattern: "names no owning pull request")
    && (string_contains(s: advisory_red_probe_notice(), pattern: "#1") == false)
}

// AND IT TELLS A READER WHY THE CAUSE LINE CANNOT BE THE DISCRIMINATOR.
test fn the_notice_says_the_cause_line_does_not_discriminate() -> Bool {
  string_contains(s: advisory_red_probe_notice(), pattern: "cause=EmittedCompilerBuildFailed")
}

// THE REASSURANCE IS UNPRINTABLE ONCE THE STANDING FLIPS, rendered over a SUPPLIED standing because
// in production the Green arm is reachable only by editing the data row.
test fn w_RED_the_green_standing_cannot_print_the_expected_red_reassurance() -> Bool {
  let green = join(emit_build_standing_notice_for(standing: EmitBuildExpectedGreen, lane_blocks: false), "\n")
  let red = advisory_red_probe_notice()
  (string_contains(s: green, pattern: "CURRENTLY EXPECTED") == false)
    && (string_contains(s: green, pattern: "E9999") == false)
    && string_contains(s: green, pattern: "REAL FINDING")
    && string_contains(s: red, pattern: "CURRENTLY EXPECTED")
    && string_contains(s: red, pattern: "E9999 Probe at src/probe.rs")
}

// THE RETIREMENT CONDITION IS CONSUMED BY THE NOTICE, AND NAMES A CAPABILITY.
test fn the_live_notice_prints_its_retirement_capability() -> Bool {
  let text = advisory_red_probe_notice()
  string_contains(s: text, pattern: "THIS STANDING RETIRES WHEN: ")
    && string_contains(s: text, pattern: "//gunbc/instruments:self-host")
    && string_contains(s: text, pattern: "//gunbc/instruments:v2-native-cli")
    && string_contains(s: text, pattern: "all exit zero")
}

// A BLOCKING RENDERING NEVER PRINTS THE NON-BLOCKING REASSURANCE, and a blocking rendering with a
// still-Red standing prints the contradiction rather than "nothing for you to fix". The live job is
// always rendered blocking, so the advisory arm is exercised only through the probe.
test fn w_RED_a_blocking_rendering_never_prints_the_non_blocking_reassurance() -> Bool {
  let probe = EmitBuildExpectedRed {
    known_signature: EmittedBuildSignature { error_code: "E9999", symbol: "Probe", emitted_path: "src/probe.rs" }
  }
  let blocking_red = join(emit_build_standing_notice_for(standing: probe, lane_blocks: true), "\n")
  let blocking_green = join(emit_build_standing_notice_for(standing: EmitBuildExpectedGreen, lane_blocks: true), "\n")
  let advisory_red = join(emit_build_standing_notice_for(standing: probe, lane_blocks: false), "\n")
  (string_contains(s: blocking_red, pattern: "does NOT block") == false)
    && (string_contains(s: blocking_green, pattern: "does NOT block") == false)
    && string_contains(s: blocking_green, pattern: "BLOCKS your merge")
    && string_contains(s: blocking_red, pattern: "CONTRADICTION")
    && (string_contains(s: blocking_red, pattern: "nothing for you to fix") == false)
    && string_contains(s: advisory_red, pattern: "does NOT block")
}

// THE NOTICE RUNS ONLY ON FAILURE. On every passing PR in the repository it must print nothing.
test fn the_notice_step_runs_only_on_failure() -> Bool {
  match compiler_gate_emit_build_notice_step() {
    RunStep { name: _, id: _, run: r, shell: _, env: _, working_directory: _, if_condition: c, continue_on_error: _, timeout_minutes: _ } =>
      match c {
        Present { value: cond } => cond == "failure()"
        Absent => false
      }
    UsesStep { name: _, id: _, uses: _, with: _, env: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } => false
  }
}

// AND IT IS THE LAST STEP, so it appears directly beneath the diagnostic a reader is trying to
// interpret rather than scrolled away above it. Asserted by POSITION rather than by count.
test fn the_notice_is_the_last_step_in_the_job() -> Bool {
  fold(
    compiler_gate_emit_build_bound_steps(),
    init: "",
    f: (acc, b) => b.step_name
  ) == "Why this lane is red, and what would be a real finding"
}

// ═══ THE SEED'S CONSTANTS ARE PINNED TO THE .dag ROWS ═══
//
// The producer that emits is the seed's native lane runner, whose entries and inputs are Rust
// constants that cannot read a .dag row yet. These joins hold them equal to the rows, so moving
// either side alone reds here rather than leaving the runner silently ignoring the workflow's
// input or the census reporting a closure the job no longer compiles. Each constant is matched as
// its whole declaration line, so the join pins the NAME to the VALUE.
data native_lane_runner_source_path: String = "src/v1/stage0/src/cli_run/native_lane_runner.rs"

fn rust_str_const_line(name: String, value: String) -> String {
  join(["const ", name, ": &str = \"", value, "\";"], "")
}

test fn the_seed_lane_entries_are_the_instrument_rows() -> Bool {
  let runner = Filesystem.Read(path: native_lane_runner_source_path, expect: ExpectSuccess).content
  string_contains(s: runner, pattern: rust_str_const_line(name: "NATIVE_COMPILE_ENTRY", value: self_host_entry()))
    && string_contains(s: runner, pattern: rust_str_const_line(name: "V2_NATIVE_CLI_ENTRY", value: v2_native_cli_entry()))
}

test fn the_seed_fault_experiment_input_is_the_dag_rows() -> Bool {
  let runner = Filesystem.Read(path: native_lane_runner_source_path, expect: ExpectSuccess).content
  string_contains(s: runner, pattern: rust_str_const_line(name: "FAULT_EXPERIMENT_ENV", value: native_fault_experiment_env_name))
    && string_contains(s: runner, pattern: rust_str_const_line(name: "FAULT_EXPERIMENT_SKIP_VALUE", value: native_fault_experiment_skip_value))
}

// THE MEMORY BIND INPUT IS THE GOVERNOR'S OWN CONSTANT (memory_governor BIND_MEMORY_CGROUP_ENV),
// the variable claim_executor and claim_batch already read; the row and the constant are joined
// here so the workflow cannot ask for a bind in words the seed does not read.
data memory_governor_source_path: String = "src/v1/stage0/src/memory_governor.rs"

test fn the_seed_memory_bind_input_is_the_dag_row() -> Bool {
  let governor = Filesystem.Read(path: memory_governor_source_path, expect: ExpectSuccess).content
  string_contains(s: governor, pattern: rust_str_const_line(name: "BIND_MEMORY_CGROUP_ENV", value: native_step_memory_bind_env_name))
}

// THE FRESH-PRODUCT INPUT IS PINNED THE SAME WAY: the workflow passes the row's name and value, and
// the runner reads the constants; a rename on one side alone would leave the required job asking
// for a fresh product in words the runner does not read, and the store would serve a hit again.
test fn the_seed_product_reuse_input_is_the_dag_rows() -> Bool {
  let runner = Filesystem.Read(path: native_lane_runner_source_path, expect: ExpectSuccess).content
  string_contains(s: runner, pattern: rust_str_const_line(name: "PRODUCT_REUSE_ENV", value: native_product_reuse_env_name))
    && string_contains(s: runner, pattern: rust_str_const_line(name: "PRODUCT_REUSE_FRESH_VALUE", value: native_product_reuse_fresh_value))
}
