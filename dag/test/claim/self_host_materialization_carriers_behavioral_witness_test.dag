module test.claim.self_host_materialization_carriers_behavioral_witness

import tools.self_host_module_behavioral_transport_roster { compiler_module_behavioral_receipt_for }

// Wet self-host behavioral receipt (materialization_carriers): the driver (the roster's driver_rel)
// checks the .dag contract on the EMITTED module with no seed oracle -- materialization_allows_memo_store
// permits the memo store for Memoize and refuses it for Recompute and Share; --inject-fault asserts
// only that Recompute wrongly stores. It used to compare the prose v2_compiler_materialization_note
// against v1_compiler::v2_compiler_materialization_carriers, a module that no longer existed, so it
// could not build (gunbc.recurring_failure_mode hand_shim_shadows_an_emitted_module). Route
// standing is derived at row grain by v2.compiler.self_host.wet_receipt_route_standing
// wet_receipt_route_standings.

test fn self_host_materialization_carriers_behavioral_receipt_holds() -> Bool {
  compiler_module_behavioral_receipt_for(module_path: "src/v2/compiler/materialization_carriers.dag")
}
