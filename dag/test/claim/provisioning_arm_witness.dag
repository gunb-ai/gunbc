data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn fixture_origin() -> UbuntuNetworkOrigin? {
  ubuntu_noble_arm64_network_origin()
}

fn fixture_seed() -> UbuntuAutoinstallSeedBinding? {
  fixture_seed_for(unit: unit, attempt: attempt_one)
}

fn fixture_seed_for(unit: UnitKey, attempt: IntakeAttemptId) -> UbuntuAutoinstallSeedBinding? {
  match built_seed_and_binding_for(unit: unit, attempt: attempt) {
    Present { value: built } => Present { value: built.binding }
    Absent => Absent
  }
}

// FIRMWARE STANDINGS COME FROM S0'S REAL PRODUCER. NeedsPreparation and Ready are sealed (their payload
// records are call-walled to S0's own entries), so a witness here cannot spell them by hand; the only
// honest fixture is a supplied BMC observation run through firmware_network_boot_standing, and the
// inhabitance test below owes the claim that each observation really yields the shape its name says.
data fixture_authority: CitedFigureStanding = CitedToAuthority {
  authority: ExternalAuthority { uri: uri_https(locator: "example.invalid/witness-fixture-not-fleet-fact") },
}

data fixture_epoch: EpochMs = 1765000000000

fn observation_of(options: List<BootOption>, order: List<BootOrderEntry>) -> FirmwareBootObservation {
  firmware_boot_observation(
    boot_order: BootOrderObserved { devices: order },
    boot_options: BootOptionsObserved { options: options },
    nics: NicsObserved { nics: ["eth0"] },
    secure_boot: SecureBootDisabled,
    bios_version: BiosVersionObserved { version: "1.08" },
  )
}

fn standing_of(observation: FirmwareBootObservation) -> FirmwareNetworkBootStanding {
  firmware_network_boot_standing(
    observation: observation,
    authority: fixture_authority,
    observed_at: fixture_epoch,
    boot_mode: UefiHttpBoot,
  )
}

fn disk_option() -> BootOption { boot_option(reference: "0003", kind: BootTargetHdd, label: "NVMe0", enabled: true) }
fn http_option() -> BootOption { boot_option(reference: "0001", kind: BootTargetUefiHttp, label: "UEFI IPv4 HTTP", enabled: true) }
fn disk_entry() -> BootOrderEntry { boot_order_entry(reference: "0003", label: "NVMe0") }
fn http_entry() -> BootOrderEntry { boot_order_entry(reference: "0001", label: "UEFI IPv4 HTTP") }

// An enabled network option exists but the order heads with the disk: S0 answers a redirect.
fn fixture_firmware_needs_boot_next() -> FirmwareNetworkBootStanding {
  standing_of(observation_of(options: [disk_option(), http_option()], order: [disk_entry()]))
}

// A different unit enumerating its network option under another reference: S0 binds the redirect to THAT
// reference, so the standing differs in the route payload. (A unit with no network option at all is a
// Refused standing in S0 -- the stack attribute is not bindable -- so it cannot serve as a second
// NeedsPreparation.)
fn fixture_firmware_needs_other() -> FirmwareNetworkBootStanding {
  standing_of(observation_of(
    options: [disk_option(), boot_option(reference: "0002", kind: BootTargetUefiHttp, label: "UEFI IPv4 HTTP", enabled: true)],
    order: [disk_entry()],
  ))
}

fn fixture_firmware_ready() -> FirmwareNetworkBootStanding {
  standing_of(observation_of(options: [http_option(), disk_option()], order: [http_entry(), disk_entry()]))
}

data digest_a: ContentHash = Sha256Hash(Sha256Digest { hex: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" })

fn pin_with(secure_boot: SitePxeEdgeSecureBootStanding) -> SitePxeEdgeChainPin {
  site_pxe_edge_arm64_ipxe_chain_pin(pin: SitePxeEdgeChainloaderPinned {
    build: site_pxe_edge_chainloader_build_receipt(
      embedded_revision: "ipxe-fixture-revision",
      built_from_commit: "fixture-commit",
      build_target: ipxe_arm64_efi_snponly,
      architecture: Aarch64,
      artifact: SitePxeEdgeCommittedArtifact { path: "artifacts/ipxe/snponly-arm64.efi", digest: digest_a },
      installed_filename: "snponly.efi",
      secure_boot: secure_boot,
    )
  })
}

fn pinned() -> SitePxeEdgeChainPin {
  pin_with(secure_boot: SecureBootObserved { verdict: SecureBootVerdictBooted, evidence: "fixture: booted" })
}

fn media_available() -> VirtualMediaStanding {
  VirtualMediaAvailable { capability_observation: decl_ref(module_path: "fixture.bmc", decl_name: "virtual_media") }
}

fn evidence_with(firmware: FirmwareNetworkBootStanding, chain: SitePxeEdgeChainPin, virtual_media: VirtualMediaStanding) -> DeliveryEvidence {
  DeliveryEvidence {
    firmware: firmware,
    chain: chain,
    virtual_media: virtual_media,
    origin: fixture_origin(),
    seed: fixture_seed(),
  }
}

fn full_evidence() -> DeliveryEvidence {
  evidence_with(firmware: fixture_firmware_needs_boot_next(), chain: pinned(), virtual_media: media_available())
}

// The attempt every plan in the fixture is solved for: the fixture subject's own unit and intake attempt.
fn attempt() -> AttemptBinding {
  AttemptBinding { unit: unit, attempt: attempt_one }
}

fn arm_for(solution: BootDeliverySolution, evidence: DeliveryEvidence) -> ProvisioningArm {
  provisioning_arm_derive(solution: solution, evidence: evidence)
}

fn derive(solution: BootDeliverySolution, evidence: DeliveryEvidence) -> ArmShape {
  arm_for(solution: solution, evidence: evidence).shape
}

fn is_unobserved_as(arm: ArmShape, expected: ArmMissingEvidence) -> Bool {
  match arm {
    ArmUnobserved { missing: m } => m == expected
    ArmedPxeOrUefiHttp { chain: _, firmware: _, origin: _, seed: _ } => false
    ArmedVirtualMedia { media_observation: _, origin: _, seed: _ } => false
    ArmRefused { cause: _ } => false
  }
}

// Every field of every variant is named here, so adding an `alternates`/`fallback` field to any arm
// stops this witness compiling: the type's whole field set is pinned at this one site.
fn arm_field_set_is_closed(arm: ArmShape) -> Bool {
  match arm {
    ArmedPxeOrUefiHttp { chain: _, firmware: _, origin: _, seed: _ } => true
    ArmedVirtualMedia { media_observation: _, origin: _, seed: _ } => true
    ArmUnobserved { missing: _ } => true
    ArmRefused { cause: _ } => true
  }
}

test fn two_strategies_with_the_same_identity_derive_different_arms() -> Bool {
  let p = derive(solution: pxe_solution, evidence: full_evidence())
  let v = derive(solution: removable_media_solution, evidence: full_evidence())
  p != v
}

fn firmware_is_prepared_via_fixture(f: FirmwarePreparation) -> Bool {
  match fixture_firmware_needs_boot_next() {
    NeedsPreparation { admitted: AdmittedPreparation { route: r, blocking: b } } => f == FirmwarePreparedVia { route: r, blocking: b }
    _ => false
  }
}

test fn the_pxe_arm_carries_the_pinned_chainloader_and_the_preparation_route() -> Bool {
  match derive(solution: pxe_solution, evidence: full_evidence()) {
    ArmedPxeOrUefiHttp { chain: c, firmware: f, origin: _, seed: _ } => (c.members.head.member.served_path as String) == "snponly.efi" && firmware_is_prepared_via_fixture(f)
    ArmedVirtualMedia { media_observation: _, origin: _, seed: _ } => false
    ArmUnobserved { missing: _ } => false
    ArmRefused { cause: _ } => false
  }
}

test fn the_firmware_route_comes_from_the_standing_not_from_a_default() -> Bool {
  let a = derive(solution: pxe_solution, evidence: full_evidence())
  let b = derive(solution: pxe_solution, evidence: evidence_with(firmware: fixture_firmware_needs_other(), chain: pinned(), virtual_media: media_available()))
  a != b
}

test fn virtual_media_arm_does_not_need_a_pinned_chainloader() -> Bool {
  let e = evidence_with(firmware: Unobserved { unanswered: [] }, chain: SitePxeEdgeChainUnpinned { architecture: Aarch64, audience: EveryKnownClient, obligation: "fixture" }, virtual_media: media_available())
  match derive(solution: removable_media_solution, evidence: e) {
    ArmedVirtualMedia { media_observation: _, origin: _, seed: _ } => true
    ArmedPxeOrUefiHttp { chain: _, firmware: _, origin: _, seed: _ } => false
    ArmUnobserved { missing: _ } => false
    ArmRefused { cause: _ } => false
  }
}

test fn unobserved_firmware_is_an_unobserved_arm_not_a_fallback_to_virtual_media() -> Bool {
  let e = evidence_with(firmware: Unobserved { unanswered: [] }, chain: pinned(), virtual_media: media_available())
  is_unobserved_as(arm: derive(solution: pxe_solution, evidence: e), expected: FirmwareStandingNotObserved)
}

test fn an_unpinned_chainloader_is_an_unobserved_arm() -> Bool {
  let e = evidence_with(firmware: fixture_firmware_needs_boot_next(), chain: SitePxeEdgeChainUnpinned { architecture: Aarch64, audience: EveryKnownClient, obligation: "pin it" }, virtual_media: media_available())
  is_unobserved_as(arm: derive(solution: pxe_solution, evidence: e), expected: LoaderChainNotPinned { obligation: "pin it" })
}

test fn a_missing_origin_is_an_unobserved_arm_for_both_strategies() -> Bool {
  let e = DeliveryEvidence { firmware: fixture_firmware_needs_boot_next(), chain: pinned(), virtual_media: media_available(), origin: Absent, seed: fixture_seed() }
  is_unobserved_as(arm: derive(solution: pxe_solution, evidence: e), expected: OriginNotObserved)
    && is_unobserved_as(arm: derive(solution: removable_media_solution, evidence: e), expected: OriginNotObserved)
}

test fn a_missing_seed_is_an_unobserved_arm_for_both_strategies() -> Bool {
  let e = DeliveryEvidence { firmware: fixture_firmware_needs_boot_next(), chain: pinned(), virtual_media: media_available(), origin: fixture_origin(), seed: Absent }
  is_unobserved_as(arm: derive(solution: pxe_solution, evidence: e), expected: SeedBindingNotObserved)
    && is_unobserved_as(arm: derive(solution: removable_media_solution, evidence: e), expected: SeedBindingNotObserved)
}

test fn a_secure_boot_rejection_is_a_refused_arm() -> Bool {
  let e = evidence_with(firmware: fixture_firmware_needs_boot_next(), chain: pin_with(secure_boot: SecureBootObserved { verdict: SecureBootVerdictRejected, evidence: "fixture: rejected" }), virtual_media: media_available())
  match derive(solution: pxe_solution, evidence: e) {
    ArmRefused { cause: c } => c == SecureBootRejectsChainloader { evidence: "fixture: rejected" }
    ArmedPxeOrUefiHttp { chain: _, firmware: _, origin: _, seed: _ } => false
    ArmedVirtualMedia { media_observation: _, origin: _, seed: _ } => false
    ArmUnobserved { missing: _ } => false
  }
}

test fn unobserved_secure_boot_is_not_armed() -> Bool {
  let e = evidence_with(firmware: fixture_firmware_needs_boot_next(), chain: pin_with(secure_boot: SecureBootUnobserved { why: "not booted yet" }), virtual_media: media_available())
  match derive(solution: pxe_solution, evidence: e) {
    ArmUnobserved { missing: _ } => true
    ArmedPxeOrUefiHttp { chain: _, firmware: _, origin: _, seed: _ } => false
    ArmedVirtualMedia { media_observation: _, origin: _, seed: _ } => false
    ArmRefused { cause: _ } => false
  }
}

test fn unavailable_virtual_media_is_refused_not_rerouted_to_pxe() -> Bool {
  let e = evidence_with(firmware: fixture_firmware_needs_boot_next(), chain: pinned(), virtual_media: VirtualMediaUnavailable { cause: "catalog row lacks the capability" })
  match derive(solution: removable_media_solution, evidence: e) {
    ArmRefused { cause: _ } => true
    ArmedPxeOrUefiHttp { chain: _, firmware: _, origin: _, seed: _ } => false
    ArmedVirtualMedia { media_observation: _, origin: _, seed: _ } => false
    ArmUnobserved { missing: _ } => false
  }
}

test fn the_refused_firmware_standing_is_terminal() -> Bool {
  let e = evidence_with(firmware: Refused { cause: FirmwareReadRefused { refusal: VendorCommandRejected { detail: "fixture" as NonEmptyStr } }, gaps: [] }, chain: pinned(), virtual_media: media_available())
  match derive(solution: pxe_solution, evidence: e) {
    ArmRefused { cause: _ } => true
    ArmedPxeOrUefiHttp { chain: _, firmware: _, origin: _, seed: _ } => false
    ArmedVirtualMedia { media_observation: _, origin: _, seed: _ } => false
    ArmUnobserved { missing: _ } => false
  }
}

test fn an_arm_has_no_alternates_field_and_the_field_set_is_closed() -> Bool {
  arm_field_set_is_closed(arm: derive(solution: pxe_solution, evidence: full_evidence()))
    && arm_field_set_is_closed(arm: derive(solution: removable_media_solution, evidence: full_evidence()))
}

// PAIRING OBLIGATION: every other test supplies fixture_seed() as evidence, and an Absent fixture would
// route them all through the SeedBindingNotObserved arm while still passing the ones that expect it.
// This claim is what makes the supplied hypothesis a reading: the real S4 producer emits a binding.
test fn fixture_seed_is_a_real_binding_from_the_s4_producer() -> Bool {
  match fixture_seed() {
    Present { value: _ } => true
    Absent => false
  }
}

// The same route under a different blocker is a different arm: the arm reports what the standing said was
// in the way, so a derivation that drops the blocker (or defaults it) is indifferent to it and goes red here.
test fn the_fixture_standings_are_the_shapes_their_names_say() -> Bool {
  match fixture_firmware_needs_boot_next() {
    NeedsPreparation { admitted: AdmittedPreparation { route: _, blocking: _ } } =>
      match fixture_firmware_needs_other() {
        NeedsPreparation { admitted: AdmittedPreparation { route: _, blocking: _ } } =>
          match fixture_firmware_ready() {
            Ready { conclusion: _ } => true
            _ => false
          }
        _ => false
      }
    _ => false
  }
}

test fn a_ready_standing_arms_pxe_with_no_preparation() -> Bool {
  let e = evidence_with(firmware: fixture_firmware_ready(), chain: pinned(), virtual_media: media_available())
  match derive(solution: pxe_solution, evidence: e) {
    ArmedPxeOrUefiHttp { chain: _, firmware: FirmwareAlreadyReady, origin: _, seed: _ } => true
    _ => false
  }
}

// The ref is re-asserted as an independent literal so a silent rename in the module cannot leave the
// frontier quietly unsatisfiable.
test fn the_consumer_frontier_names_the_s9_actuator_literally() -> Bool {
  provisioning_arm_consumer_ref() == decl_ref(module_path: "gunbc.provisioning.network_boot_actuation", decl_name: "network_boot_arm_actuator_steps")
}

// THE FRONTIER IS WAITING, NOT SILENTLY ABSENT. With nothing present it must say Pending (not Fired:
// a missing consumer is not a delivered one); handed exactly the declaration it names it fires; handed
// a lookalike in the same module, or the S0 standing's own producer, it stays Pending, so a rename or a
// retarget to a non-consumer cannot discharge it. The status is computed by S0's frontier_status over
// the population handed in, so the state of the world is never written down here.
test fn the_arm_consumer_frontier_is_pending_until_the_named_actuator_appears() -> Bool {
  frontier_status(condition: provisioning_arm_consumer_frontier, present_decls: []) == DissolutionPending
    && frontier_status(
         condition: provisioning_arm_consumer_frontier,
         present_decls: [decl_ref(module_path: "gunbc.provisioning.network_boot_actuation", decl_name: "network_boot_arm_actuator_steps")],
       ) == DissolutionFired
    && frontier_status(
         condition: provisioning_arm_consumer_frontier,
         present_decls: [decl_ref(module_path: "gunbc.provisioning.network_boot_actuation", decl_name: "network_boot_arm_actuator_steps_other")],
       ) == DissolutionPending
}

// THE ROUTE IS THE SOLVER'S, NOT THE EVIDENCE'S. A plan that selected the PXE chain arms as network boot
// even when removable-media evidence is fully available; it can never come out as removable media.
test fn a_pxe_plan_never_arms_as_removable_media_even_with_media_available() -> Bool {
  match derive(solution: pxe_solution, evidence: full_evidence()) {
    ArmedPxeOrUefiHttp { chain: _, firmware: _, origin: _, seed: _ } => true
    _ => false
  }
}

test fn a_removable_media_plan_never_arms_as_network_boot() -> Bool {
  match derive(solution: removable_media_solution, evidence: full_evidence()) {
    ArmedVirtualMedia { media_observation: _, origin: _, seed: _ } => true
    _ => false
  }
}

test fn a_solution_that_planned_nothing_refuses_the_arm_whatever_the_evidence() -> Bool {
  match derive(solution: refused_solution, evidence: full_evidence()) {
    ArmRefused { cause: BootDeliveryNotPlanned { cause: _ } } => true
    _ => false
  }
}

// INHABITANCE: the solutions the REAL solver emits (not the supplied fixtures) drive the arm, and the arm
// follows the plan's route: a solved PXE plan yields the PXE arm, a solved media plan the media arm. The
// shapes also equal those derived from the supplied fixtures, so the fixtures inhabit the interface.
test fn the_solvers_emitted_plans_drive_the_arm_by_their_route() -> Bool {
  let p = derive(solution: solver_emitted_pxe_solution(), evidence: full_evidence())
  let v = derive(solution: solver_emitted_media_solution(), evidence: full_evidence())
  p == derive(solution: pxe_solution, evidence: full_evidence())
    && v == derive(solution: removable_media_solution, evidence: full_evidence())
    && p != v
}

// THE JOINS. Evidence arrives independently of the solver's plan, so each observation naming a unit or an
// attempt is compared with the plan's own subject; a mismatch withholds the arm. Each RED differs from the
// positive control (pxe_solution with full_evidence, armed above) in exactly one coordinate.
fn other_unit() -> UnitKey {
  "BRD-000778" as UnitKey
}

fn other_attempt() -> IntakeAttemptId {
  "intake-20260830-0002" as IntakeAttemptId
}

fn evidence_with_seed(seed: UbuntuAutoinstallSeedBinding?) -> DeliveryEvidence {
  DeliveryEvidence {
    firmware: fixture_firmware_needs_boot_next(),
    chain: pinned(),
    virtual_media: media_available(),
    origin: fixture_origin(),
    seed: seed,
  }
}

fn refused_for(shape: ArmShape, axis: PlanEvidenceAxis) -> Bool {
  shape == ArmRefused { cause: EvidenceNotForThisPlan { axis: axis } }
}

test fn a_seed_bound_for_another_unit_withholds_both_arms() -> Bool {
  let e = evidence_with_seed(seed: fixture_seed_for(unit: other_unit(), attempt: attempt_one))
  refused_for(shape: derive(solution: pxe_solution, evidence: e), axis: SeedBoundForOtherUnit)
    && refused_for(shape: derive(solution: removable_media_solution, evidence: e), axis: SeedBoundForOtherUnit)
}

test fn a_seed_bound_for_another_attempt_withholds_both_arms() -> Bool {
  let e = evidence_with_seed(seed: fixture_seed_for(unit: unit, attempt: other_attempt()))
  refused_for(shape: derive(solution: pxe_solution, evidence: e), axis: SeedBoundForOtherAttempt)
    && refused_for(shape: derive(solution: removable_media_solution, evidence: e), axis: SeedBoundForOtherAttempt)
}

// THE ADMISSION BOUNDARY. A supplied plan is not solver-admitted by being a BootDeliveryPlan: the arm refuses
// one whose fields do not cohere, whatever evidence exists.
fn incoherence_of(plan: BootDeliveryPlan) -> BootDeliveryPlanIncoherence? {
  match derive(solution: BootDeliveryPlanned { plan: plan }, evidence: full_evidence()) {
    ArmRefused { cause: BootDeliveryPlanNotCoherent { cause: c } } => Present { value: c }
    _ => none
  }
}

test fn a_media_plan_over_the_firmware_boot_order_route_is_incoherent() -> Bool {
  match incoherence_of(plan: BootDeliveryPlan {
    target: removable_media_plan.target,
    artifact: removable_media_plan.artifact,
    delivery: removable_media_plan.delivery,
    boot_control: removable_media_plan.boot_control,
    boot_control_route: BootControlByFirmwareBootOrder,
    eligibility: removable_media_plan.eligibility,
  }) {
    Present { value: PlanControlRouteNotTheTargets { target: _ } } => true
    _ => false
  }
}

test fn a_media_delivery_on_a_network_addressed_target_is_incoherent() -> Bool {
  match incoherence_of(plan: BootDeliveryPlan {
    target: network_target,
    artifact: removable_media_plan.artifact,
    delivery: removable_media_plan.delivery,
    boot_control: removable_media_plan.boot_control,
    boot_control_route: BootControlByFirmwareBootOrder,
    eligibility: removable_media_plan.eligibility,
  }) {
    Present { value: PlanControllerDeliveryWithoutController { target: _ } } => true
    _ => false
  }
}

test fn a_pxe_plan_carrying_another_targets_establishment_is_incoherent() -> Bool {
  match incoherence_of(plan: BootDeliveryPlan {
    target: NetworkAddressedTarget { subject: intake_subject, mac: mac_address(octet1: 2, octet2: 0, octet3: 0, octet4: 0, octet5: 0, octet6: 2) },
    artifact: pxe_plan.artifact,
    delivery: pxe_plan.delivery,
    boot_control: pxe_plan.boot_control,
    boot_control_route: pxe_plan.boot_control_route,
    eligibility: pxe_plan.eligibility,
  }) {
    Present { value: PlanNetworkEstablishmentForOtherTarget { plan_target: _, establishment_target: _ } } => true
    _ => false
  }
}

test fn a_media_plan_whose_eligibility_selected_another_delivery_is_incoherent() -> Bool {
  match incoherence_of(plan: BootDeliveryPlan {
    target: removable_media_plan.target,
    artifact: removable_media_plan.artifact,
    delivery: removable_media_plan.delivery,
    boot_control: removable_media_plan.boot_control,
    boot_control_route: removable_media_plan.boot_control_route,
    eligibility: pxe_plan.eligibility,
  }) {
    Present { value: PlanEligibilityNotTheDeliverys { selected: _ } } => true
    _ => false
  }
}

test fn a_plan_whose_boot_control_is_not_its_deliverys_is_incoherent() -> Bool {
  match incoherence_of(plan: BootDeliveryPlan {
    target: removable_media_plan.target,
    artifact: removable_media_plan.artifact,
    delivery: removable_media_plan.delivery,
    boot_control: BootFromUefiHttp,
    boot_control_route: removable_media_plan.boot_control_route,
    eligibility: removable_media_plan.eligibility,
  }) {
    Present { value: PlanBootControlNotTheDeliverys { declared: _, derived: _ } } => true
    _ => false
  }
}

// The seed witnesses' HTTP-boot fixture pairs a PxeChainBoot delivery with BootFromUefiHttp: it is a seed
// input, NOT an admitted plan, and the boundary refuses it. It is no evidence that HTTP delivery is admitted.
test fn the_seed_fixtures_http_boot_control_over_a_pxe_delivery_is_refused() -> Bool {
  match solution_selecting_control(control: BootFromUefiHttp, client_arch: Present { value: UefiArm64 }) {
    BootDeliveryPlanned { plan: p } =>
      match incoherence_of(plan: p) {
        Present { value: PlanBootControlNotTheDeliverys { declared: _, derived: _ } } => true
        _ => false
      }
    _ => false
  }
}

// An evidence-bearing arm must carry the evidence of ITS delivery: a UEFI HTTP delivery whose params serve
// another artifact is refused although its selected-evidence constructor family is right.
test fn a_uefi_http_delivery_serving_another_artifact_is_incoherent() -> Bool {
  match incoherence_of(plan: uefi_http_plan_serving(digest: content_hash_of_value(value: "another-artifact"))) {
    Present { value: PlanEligibilityNotTheDeliverys { selected: _ } } => true
    _ => false
  }
}

// Missing eligibility evidence is never an admitted fact: a UEFI HTTP plan serving the plan's artifact with an
// EMPTY evidence list is refused as not established (it passed admission before), and so is a configfs plan.
test fn an_empty_uefi_http_evidence_plan_is_not_admitted() -> Bool {
  match incoherence_of(plan: uefi_http_plan_serving(digest: intake_artifact.digest)) {
    Present { value: PlanEligibilityNotEstablished { delivery: _ } } => true
    _ => false
  }
}

test fn a_configfs_plan_with_an_empty_qualification_is_not_admitted() -> Bool {
  match incoherence_of(plan: configfs_plan_without_qualification()) {
    Present { value: PlanEligibilityNotEstablished { delivery: _ } } => true
    _ => false
  }
}


// INHABITANCE: the plans the real solver emits are admitted by the boundary, so the boundary refuses supplied
// incoherence without refusing the real producer's output (deleting the solver route makes this go red).
fn solver_plan_is_admitted(solution: BootDeliverySolution) -> Bool {
  match solution {
    BootDeliveryPlanned { plan: p } =>
      match admit_boot_delivery_plan(plan: p) {
        BootDeliveryPlanAdmitted { plan: _ } => true
        _ => false
      }
    _ => false
  }
}

test fn the_solvers_emitted_plans_are_admitted_and_the_fixtures_are_too() -> Bool {
  solver_plan_is_admitted(solution: solver_emitted_pxe_solution())
    && solver_plan_is_admitted(solution: solver_emitted_media_solution())
    && solver_plan_is_admitted(solution: pxe_solution)
    && solver_plan_is_admitted(solution: removable_media_solution)
}
