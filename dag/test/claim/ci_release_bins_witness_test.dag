module test.claim.ci_release_bins_witness

import gunbc.ci_release_bins {
  ci_floor_invoked_bins,
  witness_declared_release_bins,
  ci_floor_required_artifact_names,
  release_bin_is_enrolled,
  release_bin_list_contains
}
import gunbc.ci_spec { ci_release_build_line }
import gunbc.ci_yaml_emit { expected_ci_yml }
import gunbc.falsifier_workflow { expected_falsifier_yml }
import tools.host_prelude {
  witness_bin,
  witness_bin_ensure_built_typed,
  WitnessBinReady,
  WitnessBinRefused,
  WitnessBinNotEnrolled
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data ci_release_bins_witness_note: String = "Authority: gunbc.ci_release_bins. Pack membership is derived (floor ∪ witness-declared). Positives: measured gap bins cssl_assemble / frontier_probe_survey are enrolled and appear on the build line. Retirement negative: compile_clean_floor_skip_witness is absent from the roster, release build line, and both generated workflows. RED: no_such_witness_bin_zzz is NOT enrolled, and ensure_built refuses WitnessBinNotEnrolled without cargo (construction wall). Per-claim test fns (no AND-umbrella; #7287 pattern)."

test fn witness_pack_includes_every_floor_invoked() -> Bool {
  fold(
    ci_floor_invoked_bins,
    init: true,
    f: (ok, name) => ok && release_bin_list_contains(xs: ci_floor_required_artifact_names(), needle: name)
  )
}

test fn witness_pack_includes_every_witness_declared() -> Bool {
  fold(
    witness_declared_release_bins,
    init: true,
    f: (ok, name) => ok && release_bin_list_contains(xs: ci_floor_required_artifact_names(), needle: name)
  )
}

test fn witness_measured_gap_bins_enrolled() -> Bool {
  release_bin_is_enrolled(bin_name: "cssl_assemble")
    && release_bin_is_enrolled(bin_name: "frontier_probe_survey")
}

test fn witness_build_line_carries_gap_bins() -> Bool {
  let line = ci_release_build_line()
  string_contains(s: line, pattern: "--bin cssl_assemble")
    && string_contains(s: line, pattern: "--bin frontier_probe_survey")
    && string_contains(s: line, pattern: "--bin claim_executor")
}

test fn witness_negative_control_not_enrolled() -> Bool {
  !release_bin_is_enrolled(bin_name: "no_such_witness_bin_zzz")
}

test fn witness_retired_floor_skip_bin_absent_from_release_projections() -> Bool {
  let retired = "compile_clean_floor_skip_witness"
  !release_bin_is_enrolled(bin_name: retired)
    && !string_contains(s: ci_release_build_line(), pattern: retired)
    && !string_contains(s: expected_ci_yml(), pattern: retired)
    && !string_contains(s: expected_falsifier_yml(), pattern: retired)
}

test fn witness_unenrolled_ensure_built_refuses_not_enrolled() -> Bool {
  let readiness = witness_bin_ensure_built_typed(
    root: "/tmp",
    bin: witness_bin(var_name: "NO_SUCH", bin_name: "no_such_witness_bin_zzz")
  )
  match readiness {
    WitnessBinReady { path: _ } => false
    WitnessBinRefused { bin_name: name, path: _, reason: reason } =>
      name == "no_such_witness_bin_zzz" && reason == WitnessBinNotEnrolled
  }
}

// FLOOR MOVED 19 -> 18 BY A DECLARED REMOVAL, not by a re-measure. The v1 cut retired the
// v1_src_dag_parse bin: its corpus src/v1/*.dag is now empty, so the bin took its own
// fail-closed empty-corpus arm and its witness and transport are gone with it. Receipt and
// full reasoning: gunbc.proactive_verification_ledger v1_src_dag_parse_retirement_receipt.
//
// WHAT THIS LITERAL IS, STATED HONESTLY because DESIGN section 5 governs it. It is a one-sided
// count ratchet over a HAND-AUTHORED list, not an identity join and not an external authority,
// so it is the weaker of the two shapes that section admits and it is kept here only because
// its DIRECTION is protective: it cannot say which bin left, only that the pack shrank, which
// is exactly enough to force a human disposition on any shrink. It is decremented rather than
// re-derived, since automating the update would collapse it to measure() == measure(). The
// completeness direction — that nothing enrolled is silently omitted from the pack — is carried
// by witness_pack_includes_every_floor_invoked and witness_pack_includes_every_witness_declared,
// which ARE identity joins; this row is not their substitute and does not duplicate them.
// Dissolve-on: the host census named in ci_release_bins_authority_note derives
// witness_declared_release_bins from production WitnessBin.bin_name literals, at which point
// the roster is a closed discovered universe and this count retires in favour of that join.
test fn witness_pack_count_floor() -> Bool {
  ci_floor_required_artifact_names().length() >= 18
}
