module test.claim.bmc_onboarding_lifecycle


data live_tree_disposition: LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn phase_tag(gunbc.plans.md_helpers.p: gunbc.bmc_onboarding.BmcOnboardingPhase) -> Int {
  match gunbc.plans.md_helpers.p {
    FactoryDefault => 0
    CredentialsRotated => 1
    OsInstalled => 2
    FabricJoined => 3
  }
}

fn next_tag(gunbc.plans.md_helpers.p: gunbc.bmc_onboarding.BmcOnboardingPhase) -> Int {
  match gunbc.bmc_onboarding.bmc_onboarding_next_phase(phase: gunbc.plans.md_helpers.p) {
    Present { value: q } => phase_tag(gunbc.plans.md_helpers.p: q)
    Absent => -1
  }
}

test fn bmc_onboarding_lifecycle_is_linear_dag() -> Bool {
  next_tag(gunbc.plans.md_helpers.p: FactoryDefault) == 1
    && next_tag(gunbc.plans.md_helpers.p: gunbc.bmc_onboarding.CredentialsRotated) == 2
    && next_tag(gunbc.plans.md_helpers.p: OsInstalled) == 3
    && next_tag(gunbc.plans.md_helpers.p: gunbc.bmc_onboarding.FabricJoined) == -1
}

fn posture_tag(gunbc.plans.md_helpers.p: gunbc.bmc_onboarding.BmcCredentialPosture) -> Int {
  match gunbc.plans.md_helpers.p {
    FactoryPublished => 0
    RotatedSecretManaged => 1
    KeylessFederated => 2
  }
}

fn posture_is_keyless(gunbc.plans.md_helpers.p: gunbc.bmc_onboarding.BmcCredentialPosture) -> Bool {
  match gunbc.plans.md_helpers.p {
    FactoryPublished => false
    RotatedSecretManaged => false
    KeylessFederated => true
  }
}

test fn bmc_credential_posture_hardens_to_keyless_steady_state() -> Bool {
  posture_tag(gunbc.plans.md_helpers.p: gunbc.bmc_onboarding.bmc_phase_credential_posture(phase: FactoryDefault)) == 0
    && posture_tag(gunbc.plans.md_helpers.p: gunbc.bmc_onboarding.bmc_phase_credential_posture(phase: gunbc.bmc_onboarding.CredentialsRotated)) == 1
    && posture_tag(gunbc.plans.md_helpers.p: gunbc.bmc_onboarding.bmc_phase_credential_posture(phase: OsInstalled)) == 1
    && posture_tag(gunbc.plans.md_helpers.p: gunbc.bmc_onboarding.bmc_phase_credential_posture(phase: gunbc.bmc_onboarding.FabricJoined)) == 2
    && !posture_is_keyless(gunbc.plans.md_helpers.p: gunbc.bmc_onboarding.bmc_phase_credential_posture(phase: FactoryDefault))
    && !posture_is_keyless(gunbc.plans.md_helpers.p: gunbc.bmc_onboarding.bmc_phase_credential_posture(phase: OsInstalled))
    && posture_is_keyless(gunbc.plans.md_helpers.p: gunbc.bmc_onboarding.bmc_phase_credential_posture(phase: gunbc.bmc_onboarding.FabricJoined))
}

test fn bmc_lifecycle_fold_is_complete_and_monotone() -> Bool {
  gunbc.bmc_onboarding.bmc_lifecycle_length() == 4
    && gunbc.bmc_onboarding.bmc_lifecycle_is_monotone_hardening()
}

test fn bmc_plan_steady_state_is_keyless_wif() -> Bool {
  let steady = gunbc.bmc_onboarding.bmc_plan_steady_state_phase(plan: gunbc.bmc_onboarding.new_altra_onboarding_plan)
  (steady == gunbc.bmc_onboarding.FabricJoined)
    && posture_is_keyless(gunbc.plans.md_helpers.p: gunbc.bmc_onboarding.bmc_plan_steady_state_posture(plan: gunbc.bmc_onboarding.new_altra_onboarding_plan))
    && !string_contains(s: gunbc.assimilate.bmc_token_federation.emit_bmc_token_smoke_workflow_yaml(), pattern: "credentials_json")
    && string_contains(s: gunbc.assimilate.bmc_token_federation.emit_bmc_token_smoke_workflow_yaml(), pattern: "id-token: write")
}

fn prev_next_is_identity(gunbc.plans.md_helpers.p: gunbc.bmc_onboarding.BmcOnboardingPhase) -> Bool {
  match gunbc.bmc_onboarding.bmc_onboarding_next_phase(phase: gunbc.plans.md_helpers.p) {
    Present { value: nxt } =>
      match gunbc.bmc_onboarding.bmc_onboarding_prev_phase(phase: nxt) {
        Present { value: back } => back == gunbc.plans.md_helpers.p
        Absent => false
      }
    Absent => true
  }
}

fn next_prev_is_identity(gunbc.plans.md_helpers.p: gunbc.bmc_onboarding.BmcOnboardingPhase) -> Bool {
  match gunbc.bmc_onboarding.bmc_onboarding_prev_phase(phase: gunbc.plans.md_helpers.p) {
    Present { value: prv } =>
      match gunbc.bmc_onboarding.bmc_onboarding_next_phase(phase: prv) {
        Present { value: fwd } => fwd == gunbc.plans.md_helpers.p
        Absent => false
      }
    Absent => true
  }
}

test fn bmc_decom_is_two_sided_inverse_on_phase_ladder() -> Bool {
  prev_next_is_identity(gunbc.plans.md_helpers.p: FactoryDefault)
    && prev_next_is_identity(gunbc.plans.md_helpers.p: gunbc.bmc_onboarding.CredentialsRotated)
    && prev_next_is_identity(gunbc.plans.md_helpers.p: OsInstalled)
    && prev_next_is_identity(gunbc.plans.md_helpers.p: gunbc.bmc_onboarding.FabricJoined)
    && next_prev_is_identity(gunbc.plans.md_helpers.p: FactoryDefault)
    && next_prev_is_identity(gunbc.plans.md_helpers.p: gunbc.bmc_onboarding.CredentialsRotated)
    && next_prev_is_identity(gunbc.plans.md_helpers.p: OsInstalled)
    && next_prev_is_identity(gunbc.plans.md_helpers.p: gunbc.bmc_onboarding.FabricJoined)
}

test fn bmc_onboard_then_decom_recovers_factory_phase() -> Bool {
  let decom_after_install = gunbc.bmc_onboarding.bmc_decom_to_factory(phase: gunbc.bmc_onboarding.bmc_onboard_to_steady(phase: FactoryDefault))
  let install_after_decom = gunbc.bmc_onboarding.bmc_onboard_to_steady(phase: gunbc.bmc_onboarding.bmc_decom_to_factory(phase: gunbc.bmc_onboarding.FabricJoined))
  (decom_after_install == FactoryDefault) && (install_after_decom == gunbc.bmc_onboarding.FabricJoined)
}

fn factory_at(gunbc.plans.md_helpers.p: gunbc.bmc_onboarding.BmcOnboardingPhase) -> gunbc.bmc_onboarding.BmcLifecycleState {
  match gunbc.plans.md_helpers.p {
    FactoryDefault => gunbc.bmc_onboarding.bmc_factory_state()
    CredentialsRotated => gunbc.bmc_onboarding.bmc_install_step(s: gunbc.bmc_onboarding.bmc_factory_state())
    OsInstalled => gunbc.bmc_onboarding.bmc_install_step(s: gunbc.bmc_onboarding.bmc_install_step(s: gunbc.bmc_onboarding.bmc_factory_state()))
    FabricJoined => gunbc.bmc_onboarding.bmc_install_step(s: gunbc.bmc_onboarding.bmc_install_step(s: gunbc.bmc_onboarding.bmc_install_step(s: gunbc.bmc_onboarding.bmc_factory_state())))
  }
}

test fn bmc_decom_roundtrips_canonical_on_named_quotient() -> Bool {
  gunbc.bmc_onboarding.bmc_transition_roundtrips_on_quotient(s: factory_at(gunbc.plans.md_helpers.p: FactoryDefault))
    && gunbc.bmc_onboarding.bmc_transition_roundtrips_on_quotient(s: factory_at(gunbc.plans.md_helpers.p: gunbc.bmc_onboarding.CredentialsRotated))
    && gunbc.bmc_onboarding.bmc_transition_roundtrips_on_quotient(s: factory_at(gunbc.plans.md_helpers.p: OsInstalled))
}

fn decom_step_broken(s: gunbc.bmc_onboarding.BmcLifecycleState) -> gunbc.bmc_onboarding.BmcLifecycleState {
  match gunbc.bmc_onboarding.bmc_onboarding_prev_phase(phase: s.phase) {
    Present { value: prv } => gunbc.bmc_onboarding.BmcLifecycleState {
      phase: prv,
      credential: gunbc.bmc_onboarding.bmc_phase_credential_posture(phase: prv),
      secret_epoch: s.secret_epoch,
      boot_cleared: s.boot_cleared
    }
    Absent => s
  }
}

fn transition_does_not_roundtrip_on_quotient(s: gunbc.bmc_onboarding.BmcLifecycleState) -> Bool {
  let recovered = gunbc.bmc_onboarding.bmc_recoverable_quotient(s: decom_step_broken(s: gunbc.bmc_onboarding.bmc_install_step(s: s)))
  let original = gunbc.bmc_onboarding.bmc_recoverable_quotient(s: s)
  !(recovered == original)
}

test fn bmc_decom_does_not_roundtrip_when_inverse_is_wrong() -> Bool {
  transition_does_not_roundtrip_on_quotient(s: factory_at(gunbc.plans.md_helpers.p: gunbc.bmc_onboarding.CredentialsRotated))
}

test fn new_altra_plan_starts_factory_default_at_192() -> Bool {
  gunbc.bmc_onboarding.new_altra_onboarding_plan.bmc.host == "192.168.1.192"
    && phase_tag(gunbc.plans.md_helpers.p: gunbc.bmc_onboarding.new_altra_onboarding_plan.start_phase) == 0
    && match gunbc.bmc_onboarding.new_altra_onboarding_plan.rotated_credential {
      std.credentials.Stored { secret_name: s } => s == "bmc-srv3-admin"
      std.credentials.Chained { steps: _ } => false
    }
    && match gunbc.bmc_onboarding.new_altra_onboarding_plan.os_target {
      std.os.types.UbuntuOs { distro: d } =>
        match d {
          NobleNumbat2404Lts => true
        }
      std.os.types.WindowsOs { distro: _ } => false
      std.os.types.MacosOs { distro: _ } => false
    }
    && extdeps.bmc.types.redfish_boot_target_wire(t: gunbc.bmc_onboarding.new_altra_onboarding_plan.os_install_boot_target) == "Cd"
    && extdeps.bmc.types.redfish_boot_target_wire(t: extdeps.bmc.types.BootTargetCd) == "Cd"
    && extdeps.bmc.types.redfish_account_role_wire(role: gunbc.bmc_onboarding.new_altra_onboarding_plan.rotated_account_role) == "Administrator"
    && extdeps.bmc.types.redfish_account_role_wire(role: AccountRoleAdministrator) == "Administrator"
}

test fn credential_probe_maps_to_correct_phase() -> Bool {
  match gunbc.bmc_onboarding.bmc_credential_probe_to_phase(probe: gunbc.bmc_onboarding.FactoryCredentialActive) {
    Present { value: FactoryDefault } => true
    Present { value: _ } => false
    Absent => false
  }
    && match gunbc.bmc_onboarding.bmc_credential_probe_to_phase(probe: gunbc.bmc_onboarding.RotatedCredentialActive) {
      Present { value: gunbc.bmc_onboarding.CredentialsRotated } => true
      Present { value: _ } => false
      Absent => false
    }
    && match gunbc.bmc_onboarding.bmc_credential_probe_to_phase(probe: gunbc.bmc_onboarding.CredentialStateUnknown { reason: "test" }) {
      Absent => true
      Present { value: _ } => false
    }
}
