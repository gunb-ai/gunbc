module test.claim.bmc_onboarding_lifecycle


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn phase_tag(p: gunbc.bmc_onboarding.BmcOnboardingPhase) -> Int {
  match p {
    FactoryDefault => 0
    CredentialsRotated => 1
    OsInstalled => 2
    FabricJoined => 3
  }
}

fn next_tag(p: gunbc.bmc_onboarding.BmcOnboardingPhase) -> Int {
  match bmc_onboarding_next_phase(phase: p) {
    Present { value: q } => phase_tag(p: q)
    Absent => -1
  }
}

test fn bmc_onboarding_lifecycle_is_linear_dag() -> Bool {
  next_tag(p: FactoryDefault) == 1
    && next_tag(p: CredentialsRotated) == 2
    && next_tag(p: OsInstalled) == 3
    && next_tag(p: FabricJoined) == -1
}

fn posture_tag(p: gunbc.bmc_onboarding.BmcCredentialPosture) -> Int {
  match p {
    FactoryPublished => 0
    RotatedSecretManaged => 1
    KeylessFederated => 2
  }
}

fn posture_is_keyless(p: gunbc.bmc_onboarding.BmcCredentialPosture) -> Bool {
  match p {
    FactoryPublished => false
    RotatedSecretManaged => false
    KeylessFederated => true
  }
}

test fn bmc_credential_posture_hardens_to_keyless_steady_state() -> Bool {
  posture_tag(p: bmc_phase_credential_posture(phase: FactoryDefault)) == 0
    && posture_tag(p: bmc_phase_credential_posture(phase: CredentialsRotated)) == 1
    && posture_tag(p: bmc_phase_credential_posture(phase: gunbc.bmc_onboarding.OsInstalled)) == 1
    && posture_tag(p: bmc_phase_credential_posture(phase: FabricJoined)) == 2
    && !posture_is_keyless(p: bmc_phase_credential_posture(phase: FactoryDefault))
    && !posture_is_keyless(p: bmc_phase_credential_posture(phase: gunbc.bmc_onboarding.OsInstalled))
    && posture_is_keyless(p: bmc_phase_credential_posture(phase: FabricJoined))
}

test fn bmc_lifecycle_fold_is_complete_and_monotone() -> Bool {
  bmc_lifecycle_length() == 4
    && bmc_lifecycle_is_monotone_hardening()
}

test fn bmc_plan_steady_state_is_keyless_wif() -> Bool {
  let steady = bmc_plan_steady_state_phase(plan: srv3_onboarding_plan)
  (steady == FabricJoined)
    && posture_is_keyless(p: bmc_plan_steady_state_posture(plan: srv3_onboarding_plan))
    && !string_contains(s: emit_bmc_token_smoke_workflow_yaml(), pattern: "credentials_json")
    && string_contains(s: emit_bmc_token_smoke_workflow_yaml(), pattern: "id-token: write")
}

fn prev_next_is_identity(p: gunbc.bmc_onboarding.BmcOnboardingPhase) -> Bool {
  match bmc_onboarding_next_phase(phase: p) {
    Present { value: nxt } =>
      match bmc_onboarding_prev_phase(phase: nxt) {
        Present { value: back } => back == p
        Absent => false
      }
    Absent => true
  }
}

fn next_prev_is_identity(p: gunbc.bmc_onboarding.BmcOnboardingPhase) -> Bool {
  match bmc_onboarding_prev_phase(phase: p) {
    Present { value: prv } =>
      match bmc_onboarding_next_phase(phase: prv) {
        Present { value: fwd } => fwd == p
        Absent => false
      }
    Absent => true
  }
}

test fn bmc_decom_is_two_sided_inverse_on_phase_ladder() -> Bool {
  prev_next_is_identity(p: FactoryDefault)
    && prev_next_is_identity(p: CredentialsRotated)
    && prev_next_is_identity(p: OsInstalled)
    && prev_next_is_identity(p: FabricJoined)
    && next_prev_is_identity(p: FactoryDefault)
    && next_prev_is_identity(p: CredentialsRotated)
    && next_prev_is_identity(p: OsInstalled)
    && next_prev_is_identity(p: FabricJoined)
}

test fn bmc_onboard_then_decom_recovers_factory_phase() -> Bool {
  let decom_after_install = bmc_decom_to_factory(phase: bmc_onboard_to_steady(phase: FactoryDefault))
  let install_after_decom = bmc_onboard_to_steady(phase: bmc_decom_to_factory(phase: FabricJoined))
  (decom_after_install == FactoryDefault) && (install_after_decom == FabricJoined)
}

fn factory_at(p: gunbc.bmc_onboarding.BmcOnboardingPhase) -> gunbc.bmc_onboarding.BmcLifecycleState {
  match p {
    FactoryDefault => bmc_factory_state()
    CredentialsRotated => bmc_install_step(s: bmc_factory_state())
    OsInstalled => bmc_install_step(s: bmc_install_step(s: bmc_factory_state()))
    FabricJoined => bmc_install_step(s: bmc_install_step(s: bmc_install_step(s: bmc_factory_state())))
  }
}

test fn bmc_decom_roundtrips_canonical_on_named_quotient() -> Bool {
  bmc_transition_roundtrips_on_quotient(s: factory_at(p: FactoryDefault))
    && bmc_transition_roundtrips_on_quotient(s: factory_at(p: CredentialsRotated))
    && bmc_transition_roundtrips_on_quotient(s: factory_at(p: OsInstalled))
}

fn decom_step_broken(s: gunbc.bmc_onboarding.BmcLifecycleState) -> gunbc.bmc_onboarding.BmcLifecycleState {
  match bmc_onboarding_prev_phase(phase: s.phase) {
    Present { value: prv } => gunbc.bmc_onboarding.BmcLifecycleState {
      phase: prv,
      credential: bmc_phase_credential_posture(phase: prv),
      secret_epoch: s.secret_epoch,
      boot_cleared: s.boot_cleared
    }
    Absent => s
  }
}

fn transition_does_not_roundtrip_on_quotient(s: gunbc.bmc_onboarding.BmcLifecycleState) -> Bool {
  let recovered = bmc_recoverable_quotient(s: decom_step_broken(s: bmc_install_step(s: s)))
  let original = bmc_recoverable_quotient(s: s)
  !(recovered == original)
}

test fn bmc_decom_does_not_roundtrip_when_inverse_is_wrong() -> Bool {
  transition_does_not_roundtrip_on_quotient(s: factory_at(p: CredentialsRotated))
}

test fn srv3_plan_starts_factory_default_at_192() -> Bool {
  srv3_onboarding_plan.bmc.host == "192.168.1.192"
    && phase_tag(p: srv3_onboarding_plan.start_phase) == 0
    && srv3_onboarding_plan.secret_name == "bmc-srv3-admin"
    && redfish_boot_target_wire(t: BootTargetCd) == "Cd"
    && redfish_account_role_wire(role: srv3_onboarding_plan.rotated_account_role) == "Administrator"
    && redfish_account_role_wire(role: AccountRoleAdministrator) == "Administrator"
}

test fn srv4_plan_targets_195_with_srv4_secret() -> Bool {
  srv4_onboarding_plan.bmc.host == "192.168.1.195"
    && !(srv4_onboarding_plan.bmc.host == srv3_onboarding_plan.bmc.host)
    && phase_tag(p: srv4_onboarding_plan.start_phase) == 0
    && srv4_onboarding_plan.secret_name == "bmc-srv4-admin"
    && redfish_account_role_wire(role: srv4_onboarding_plan.rotated_account_role) == "Administrator"
}

test fn credential_probe_maps_to_correct_phase() -> Bool {
  match bmc_credential_probe_to_phase(probe: FactoryCredentialActive) {
    Present { value: FactoryDefault } => true
    Present { value: _ } => false
    Absent => false
  }
    && match bmc_credential_probe_to_phase(probe: RotatedCredentialActive) {
      Present { value: CredentialsRotated } => true
      Present { value: _ } => false
      Absent => false
    }
    && match bmc_credential_probe_to_phase(
      probe: gunbc.bmc_onboarding.CredentialAccessUpsertRequired {
        plan: gunbc.auth.access_token_source.GoogleCloudInteractiveAuthenticationRequired {},
      },
    ) {
      Absent => true
      Present { value: _ } => false
    }
    && match bmc_credential_probe_to_phase(probe: gunbc.bmc_onboarding.CredentialStateUnknown { reason: "test" }) {
      Absent => true
      Present { value: _ } => false
    }
}

// THE CONTRADICTION THIS REPAIR REMOVED, kept as the regression control. BmcOnboardingPlan used
// to carry os_install_boot_target, and altra_onboarding_plan put srv3's board-default CD target
// into EVERY host's plan — so srv4, whose firmware evidence justifies no delivery mechanism at
// all, still carried a plausible "boot CD" instruction. The previous version of this witness
// asserted exactly that (srv4_onboarding_plan.os_install_boot_target == "Cd"), enshrining the
// contradiction as the contract.
//
// The install fields are gone from the onboarding record entirely rather than wrapped in a
// standing: no production consumer ever read them (srv3_boot_once_cd, bmc_fan_converge,
// srv3_bmc_credential_resolve and the bmc_onboard tools use bmc / factory_login / secret_name),
// so forcing credential-only operations to unwrap an installation plan would have been a second
// fusion, not a repair. The boot target now lives with the evidence that derives it.
// srv3 HAS JOINED srv4. This previously read "per-host, and srv4 has none",
// pinning srv3 to a Cd target while srv4 refused — a real difference at the time,
// because srv3 still ran 2.07.00. Both hosts now run 3.22.00 and both refuse with
// the same cause, so asserting a difference would be asserting a fact that
// stopped being true when srv3's BMC was upgraded. The per-host machinery is
// unchanged and still reads each host's own evidence; the two hosts simply agree
// now, and the witness says which state that is rather than which it used to be.
test fn install_boot_target_refuses_alike_for_both_3_22_00_hosts() -> Bool {
  match srv3_install_boot_target_standing {
    InstallBootTargetRefused { cause: c3 } =>
      match c3 {
        InstallNoVirtualMediaAndNetworkBootUnestablished { firmware: _, missing: _ } => true
        _ => false
      }
    InstallBootTargetSelected { target: _ } => false
  }
    && match srv4_install_boot_target_standing {
         InstallBootTargetRefused { cause: c } =>
           match c {
             InstallNoVirtualMediaAndNetworkBootUnestablished { firmware: _, missing: _ } => true
             InstallFirmwareEvidenceAbsent { endpoint: _ } => false
             InstallFirmwareVersionUncatalogued { firmware: _ } => false
             InstallFirmwareVersionAmbiguous { firmware: _, count: _ } => false
             InstallNoBootSourceOverride { firmware: _ } => false
             InstallFirmwareTransitionUnestablished { firmware: _, missing: _ } => false
             InstallFirmwareTransitionAmbiguous { firmware: _, candidates: _ } => false
           }
         InstallBootTargetSelected { target: _ } => false
       }
}
