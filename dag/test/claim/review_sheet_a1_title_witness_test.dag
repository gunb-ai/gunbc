module test.claim.review_sheet_a1_title_witness

import std.types { Bool, String, NonEmptyStr, Int }
import gunbc.review_sheet_projection {
  A1Column,
  A1Cell,
  A1RowSpan,
}
import gunbc.review_sheet_sheets {
  sheet_a1_range_wire,
  sheet_qualified_cell,
  sheet_qualified_span,
  SheetA1Range,
  A1EndOpen,
  A1EndClosed,
  A1EndWholeTab,
  a1_readback_standing,
  A1ReadbackStanding,
  A1ReadbackAnchored,
  A1ReadbackUnreadable,
  value_range_includes_column_letter,
}

fn cell(letter: String, row: Int) -> A1Cell {
  A1Cell { column: A1Column { letter: letter as NonEmptyStr }, row: row }
}

fn standing_text(s: A1ReadbackStanding) -> String {
  match s {
    A1ReadbackAnchored { range: r } => concat("anchored|", concat(r.tab as String, concat("|", sheet_a1_range_wire(range: r))))
    A1ReadbackUnreadable { reason: why } => concat("unreadable|", why as String)
  }
}

// Each writer of a qualified range emits the quoted title exactly.
test fn each_writer_quotes_a_spaced_title_exactly() -> Bool {
  let tab = "Buyer Review" as NonEmptyStr
  sheet_a1_range_wire(range: SheetA1Range { tab: tab, origin: cell(letter: "A", row: 1), end: A1EndClosed { cell: cell(letter: "C", row: 1) } })
    == "'Buyer Review'!A1:C1"
    && sheet_a1_range_wire(range: SheetA1Range { tab: tab, origin: cell(letter: "A", row: 1), end: A1EndOpen { column: A1Column { letter: "C" as NonEmptyStr } } })
      == "'Buyer Review'!A1:C"
    && sheet_a1_range_wire(range: SheetA1Range { tab: tab, origin: cell(letter: "A", row: 1), end: A1EndWholeTab })
      == "'Buyer Review'"
    && sheet_qualified_cell(tab: tab, cell: cell(letter: "B", row: 2)) == "'Buyer Review'!B2"
    && sheet_qualified_span(tab: tab, span: A1RowSpan { start: cell(letter: "A", row: 1), end: cell(letter: "C", row: 1) })
      == "'Buyer Review'!A1:C1"
}

test fn each_writer_escapes_an_embedded_quote() -> Bool {
  sheet_qualified_cell(tab: "Bob's" as NonEmptyStr, cell: cell(letter: "A", row: 1)) == "'Bob''s'!A1"
}

// The spelling values.get returns in ValueRange.range for a spaced tab.
test fn readback_accepts_the_quoted_range_google_returns() -> Bool {
  standing_text(s: a1_readback_standing(range: "'Buyer Review'!A1:C1")) == "anchored|Buyer Review|'Buyer Review'!A1:C1"
    && standing_text(s: a1_readback_standing(range: "'Bob''s'!A1:E")) == "anchored|Bob's|'Bob''s'!A1:E"
    && standing_text(s: a1_readback_standing(range: "'Q3!final'!A1:C1")) == "anchored|Q3!final|'Q3!final'!A1:C1"
}

test fn readback_refuses_malformed_quoting_with_a_typed_reason() -> Bool {
  standing_text(s: a1_readback_standing(range: "'Buyer Review!A1:C1"))
    == "unreadable|A1 sheet title: unterminated quote: 'Buyer Review!A1:C1"
    && standing_text(s: a1_readback_standing(range: "'Bob's'!A1:C1"))
      == "unreadable|A1 sheet title: single quote not escaped as '' at offset 4: 'Bob's'!A1:C1"
    && standing_text(s: a1_readback_standing(range: "''!A1:C1"))
      == "unreadable|A1 sheet title: empty title: ''!A1:C1"
}

test fn column_letter_reader_decodes_a_bang_in_the_title() -> Bool {
  value_range_includes_column_letter(range: "'Q3!final'!A2:C2", letter: "B")
    && !value_range_includes_column_letter(range: "'Q3!final'!A2:C2", letter: "D")
}
