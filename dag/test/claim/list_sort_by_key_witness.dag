module test.claim.list_sort_by_key_witness

import std.types { Bool, Int, String, List }
import std.algebra { list_sort_by_key, int_total_order, string_total_order, TotalOrder, Ordering, Less, Equal, Greater, list_map }

// std.algebra list_sort_by_key is the MODELED realization of std.primitives sort_by_contract. Its
// reference is the host `sort_by` method on the same fixture: equal keys keep input order (a stable
// sort), and Int keys order by the canonical content order.
type Row {
  key: Int
  tag: String
}

data fixture_rows: List<Row> = [
  Row { key: 3, tag: "a" },
  Row { key: 1, tag: "b" },
  Row { key: 3, tag: "c" },
  Row { key: 2, tag: "d" },
  Row { key: 1, tag: "e" },
  Row { key: 3, tag: "f" },
  Row { key: 0 - 5, tag: "g" },
  Row { key: 2, tag: "h" }
]

fn row_tags(rows: List<Row>) -> List<String> {
  list_map(xs: rows, f: fn(r) { r.tag })
}

// A deliberately UNSTABLE comparator: an equal key reports Greater, so equal keys swap. The control
// below must see it differ from the host order, or the fixture does not discriminate stability.
fn unstable_int_compare(a: Int, b: Int) -> Ordering {
  if a < b { Less } else { Greater }
}

data unstable_int_order: TotalOrder<Int> = { compare: unstable_int_compare }

test fn modeled_sort_agrees_with_the_host_sort_on_duplicate_keys() -> Bool {
  row_tags(rows: list_sort_by_key(xs: fixture_rows, key: fn(r) { r.key }, order: int_total_order()))
    == row_tags(rows: fixture_rows |> sort_by(r => r.key))
}

test fn modeled_sort_keeps_input_order_among_equal_keys() -> Bool {
  row_tags(rows: list_sort_by_key(xs: fixture_rows, key: fn(r) { r.key }, order: int_total_order()))
    == ["g", "b", "e", "d", "h", "a", "c", "f"]
}

test fn an_unstable_comparator_is_a_discriminating_red() -> Bool {
  row_tags(rows: list_sort_by_key(xs: fixture_rows, key: fn(r) { r.key }, order: unstable_int_order))
    != row_tags(rows: fixture_rows |> sort_by(r => r.key))
}

// A second admitted key carrier: String keys under the canonical content order the host applies.
type NamedRow {
  name: String
  tag: Int
}

data named_rows: List<NamedRow> = [
  NamedRow { name: "pear", tag: 1 },
  NamedRow { name: "apple", tag: 2 },
  NamedRow { name: "pear", tag: 3 },
  NamedRow { name: "fig", tag: 4 },
  NamedRow { name: "apple", tag: 5 }
]

fn named_tags(rows: List<NamedRow>) -> List<Int> {
  list_map(xs: rows, f: fn(r) { r.tag })
}

test fn modeled_sort_agrees_with_the_host_sort_on_duplicate_string_keys() -> Bool {
  named_tags(rows: list_sort_by_key(xs: named_rows, key: fn(r) { r.name }, order: string_total_order()))
    == named_tags(rows: named_rows |> sort_by(r => r.name))
}

test fn modeled_string_sort_keeps_input_order_among_equal_keys() -> Bool {
  named_tags(rows: list_sort_by_key(xs: named_rows, key: fn(r) { r.name }, order: string_total_order()))
    == [2, 5, 4, 1, 3]
}

// The WRONG-ORDER RED for the declared String order: a reversed comparator sorts the same names out of order, so a
// migration row that appended the wrong order argument would fail the equality with the host order above.
fn string_compare_reversed(a: String, b: String) -> Ordering {
  if a < b { Greater } else { if a > b { Less } else { Equal } }
}

data reversed_string_order: TotalOrder<String> = { compare: string_compare_reversed }

test fn a_reversed_string_order_is_a_discriminating_red() -> Bool {
  named_tags(rows: list_sort_by_key(xs: named_rows, key: fn(r) { r.name }, order: reversed_string_order))
    != named_tags(rows: named_rows |> sort_by(r => r.name))
}

// The digest site's key kind: a lowercase-hex String (std.content_hash Fnv1a64StructuralDigestHex) orders under the same
// declared String order as the host sort.
test fn hex_digest_keys_order_under_the_declared_string_order() -> Bool {
  list_sort_by_key(xs: ["ff00000000000000", "0a00000000000000", "9000000000000000", "0a00000000000000"], key: fn(h) { h }, order: string_total_order())
    == ["0a00000000000000", "0a00000000000000", "9000000000000000", "ff00000000000000"]
}
