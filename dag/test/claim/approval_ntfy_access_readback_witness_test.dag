module test.claim.approval_ntfy_access_readback_witness_test

import std.logic { Bool }
import std.types { String, List, NonEmptyStr }
import extdeps.ntfy.access { NtfyRoleAdmin, NtfyReadWrite }
import extdeps.exec.command { LocalExec, argv_words }
import extdeps.shell.exec { ProcessNotSpawned }
import extdeps.posix.sh_invocation { posix_sh_program_command }
import gunbc.command_runner { run_shell_command_observe }
import gunbc.cli_wire { CliWireResponse, CliWirePrintable, CliWireUnprintable }
import gunbc.compile_diagnostic_census { CompileDiagnosticCensus }
import gunbc.guarantee_probe_corpus { census_blocking_count_for_class, census_blocking_count_for_subject }
import gunbc.auth.approval_ntfy_access_readback {
  ApprovalNtfyAclVerdict, AclEstablished, AclRefused,
  ApprovalNtfyAclDeviation, AclReadbackDidNotRun, AclListingUnparseable, AclDefaultAccessNotDeny, AclAnonymousHasGrants,
  AclPrincipalMissing, AclPrincipalDuplicated, AclPublisherNotWriteOnly, AclOperatorNotReadOnly, AclUnexpectedPrincipal,
  ActiveNtfyRuntimeUnbound, ActiveNtfyRuntimeGap,
  RuntimeObservationMalformed, RuntimeConfigChangedSinceStart, RuntimeExecutableNotDeclared,
  RuntimeVersionNotModeled, RuntimeCommandLineNotDeclared, RuntimeEnvironmentOverrides,
  RuntimeConfigDefaultAccessNotDeny, RuntimeConfigAccessCacheEnabled, RuntimeConfigListenNotDeclared,
  RuntimeAuthFileNotHeldOpen, RuntimeListenerNotDeclared, RuntimeNoListener,
  approval_ntfy_channel_verdict, approval_ntfy_channel_verdict_of_run, approval_ntfy_runtime_readback_command, approval_ntfy_runtime_readback_script,
}
import gunbc.auth.approval_device_routes { issue_device_enrolment_code }
import gunbc.auth.approval_device_redemption { approval_device_store_root }

// ── Enrolment-code issuance: one root, one live read, a verdict bound to the running server ────
// EVERY rt_* OBSERVATION BELOW IS REAL: the stdout of approval_ntfy_runtime_readback_script -- the
// exact text captured_with_script pins, which the_readback_is_one_elevated_read_as_the_server_principal
// asserts the module still renders -- run against the upstream ntfy v2.28.0 linux/arm64 release
// binary serving 127.0.0.1:2586 from a scratch config and auth database. Two edits are made to each
// capture, and only these: scratch paths are rewritten to the declared ones (/usr/bin/ntfy,
// /etc/gunbc-ntfy/server.yml, /var/lib/gunbc-ntfy/user.db, a log path), and the /proc/net/tcp and
// tcp6 tables keep their header and LISTEN rows only (the classifier reads no other row). The
// systemctl on the capture host was a stub answering the live server's PID, since that host runs no
// systemd. Each deviation was produced on the real server: an NTFY_* variable, a command-line flag,
// another executable path, a config key, a config touched after start, the auth database renamed
// under the running server, a metrics listener. The listing_* rows are real ntfy access stdout from
// the same binary, and the ACL claims place each one in the exact capture's @@access section.
// Synthetic rows say so beside their claim.
