// REAL: the config's listen-http is declared, but the server ALSO listens (metrics, on ::).
test fn a_second_listener_of_the_principal_refuses() -> Bool {
  match gap_of(fx: fx_metrics_extra) {
    Present { value: RuntimeListenerNotDeclared { local_address: a } } => string_contains(s: a, pattern: ":2383")
    _ => false
  }
}

// SYNTHETIC: the principal's uid owns no listening socket.
test fn no_listener_refuses() -> Bool {
  match gap_of(fx: with_read(fx: fx_exact, name: "server_uid", exit_code: 0, stdout: "4242\n", stderr: "")) {
    Present { value: RuntimeNoListener } => true
    _ => false
  }
}

// SYNTHETIC (documented tailscale serve status shape): a Funnel listener on the node.
test fn a_funnel_front_door_refuses() -> Bool {
  match gap_of(fx: with_read(fx: fx_exact, name: "front_door", exit_code: 0, stdout: "{\"TCP\":{\"443\":{\"HTTPS\":true}},\"Web\":{\"srv1.example.ts.net:443\":{\"Handlers\":{\"/\":{\"Proxy\":\"http://127.0.0.1:2586\"}}}},\"AllowFunnel\":{\"srv1.example.ts.net:443\":true}}", stderr: "")) {
    Present { value: FrontDoorFunnelled { host_ports: h } } => join(h, ",") == "srv1.example.ts.net:443"
    _ => false
  }
}

// SYNTHETIC: a front-door status that is not the documented JSON is unread, never "no Funnel".
test fn an_unreadable_front_door_refuses() -> Bool {
  match gap_of(fx: with_read(fx: fx_exact, name: "front_door", exit_code: 0, stdout: "Web: srv1:443", stderr: "")) {
    Present { value: RuntimeReadFailed { read: ReadFrontDoor, failure: ReadUnparseable { detail: _ } } } => true
    _ => false
  }
}

// ── ACL REDS: the bound runtime, each real listing in its access read ─────────────────────
fn with_listing(listing: String) -> List<FxRead> {
  with_read(fx: fx_exact, name: "access_list", exit_code: 0, stdout: listing, stderr: "")
}

test fn an_unplaced_listing_line_refuses() -> Bool {
  match refused_with(v: verdict_of(fx: with_listing(listing: stdout_of(fx: fx_exact, name: "access_list") + "WARN something unrelated\n"))) {
    Present { value: AclListingUnparseable { line: l, cause: _ } } => l == "WARN something unrelated"
    _ => false
  }
}

test fn default_access_not_deny_in_the_listing_refuses() -> Bool {
  match refused_with(v: verdict_of(fx: with_listing(listing: listing_default_rw))) {
    Present { value: AclDefaultAccessNotDeny { observed: NtfyReadWrite } } => true
    _ => false
  }
}

test fn an_anonymous_read_grant_refuses() -> Bool {
  match refused_with(v: verdict_of(fx: with_listing(listing: listing_anon_read))) {
    Present { value: AclAnonymousHasGrants { grants: g } } => count(g) == 1
    _ => false
  }
}

test fn a_publisher_that_can_read_refuses() -> Bool {
  match refused_with(v: verdict_of(fx: with_listing(listing: listing_pub_rw))) {
    Present { value: AclPublisherNotWriteOnly { role: _, admin_all_topics: false, grants: _ } } => true
    _ => false
  }
}

test fn an_admin_publisher_refuses() -> Bool {
  match refused_with(v: verdict_of(fx: with_listing(listing: listing_pub_admin))) {
    Present { value: AclPublisherNotWriteOnly { role: NtfyRoleAdmin, admin_all_topics: true, grants: _ } } => true
    _ => false
  }
}

test fn an_operator_that_can_write_refuses() -> Bool {
  match refused_with(v: verdict_of(fx: with_listing(listing: listing_op_rw))) {
    Present { value: AclOperatorNotReadOnly { role: _, admin_all_topics: _, grants: _ } } => true
    _ => false
  }
}

test fn an_operator_without_the_grant_refuses() -> Bool {
  match refused_with(v: verdict_of(fx: with_listing(listing: listing_op_nogrant))) {
    Present { value: AclOperatorNotReadOnly { role: _, admin_all_topics: _, grants: g } } => count(g) == 0
    _ => false
  }
}

test fn a_missing_operator_refuses() -> Bool {
  match refused_with(v: verdict_of(fx: with_listing(listing: listing_op_missing))) {
    Present { value: AclPrincipalMissing { user: u } } => u == "gunbc-approval-operator"
    _ => false
  }
}

test fn a_further_admin_refuses() -> Bool {
  match refused_with(v: verdict_of(fx: with_listing(listing: listing_admin_extra))) {
    Present { value: AclUnexpectedPrincipal { user: u, role: NtfyRoleAdmin } } => u == "root"
    _ => false
  }
}

test fn a_further_wildcard_reader_refuses() -> Bool {
  match refused_with(v: verdict_of(fx: with_listing(listing: listing_wildcard_reader))) {
    Present { value: AclUnexpectedPrincipal { user: u, role: _ } } => u == "eve"
    _ => false
  }
}

test fn a_duplicated_principal_refuses() -> Bool {
  match refused_with(v: verdict_of(fx: with_listing(listing: stdout_of(fx: fx_exact, name: "access_list") + "user gunbc-approval-operator (role: user, tier: none)\n- read-only access to topic gunbc-approvals\n"))) {
    Present { value: AclPrincipalDuplicated { user: u } } => u == "gunbc-approval-operator"
    _ => false
  }
}

// ── THE ROOT, BY REAL EXECUTION (claim_batch --wet) ─────────────────────────────────────────
// issue_device_enrolment_code accepts nothing, so this claim calls it exactly as production does.
// On a host with no gunbc-ntfy unit (a CI runner, a session container) its own first read fails,
// and the verb must refuse on THAT read, by name, before the store is touched. Forcing the verdict
// -- the verb proceeding without its reading -- turns this red: it then goes on to the clock, the
// entropy and the store instead.
fn path_exists(path: String) -> Bool {
  run_shell_command_observe(command: posix_sh_program_command(script: "test -e '" + path + "'\n"), transport: LocalExec).exit_code == 0
}

test fn the_root_refuses_on_its_own_failed_first_read_by_real_execution() -> Bool {
  let before = path_exists(path: approval_device_store_root as String)
  let r = issue_device_enrolment_code()
  !before
    && (match r {
      CliWireUnprintable { cause: c } => string_contains(s: c as String, pattern: "refused before any code was minted") && string_contains(s: c as String, pattern: "the read of the unit (first) failed")
      _ => false
    })
    && !path_exists(path: approval_device_store_root as String)
}

// ── THE SEALS: no second root compiles ─────────────────────────────────────────────────────
// A fresh module reaching each effect leaf, and the runtime reader, from an unadmitted
// declaration. Each call must be refused by admission, named by its subject.
data unadmitted_effect_caller_source: String = "module probe_enrolment_second_root\nimport gunbc.auth.approval_device_routes { mint_enrolment_code, issue_and_deliver_enrolment_code_until, deliver_enrolment_code, enrolment_code_notification }\nimport gunbc.auth.approval_device_redemption { issue_enrolment_code }\nimport gunbc.auth.approval_request_submission { read_publisher_token, publish_notification }\nimport gunbc.auth.approval_ntfy_access_readback { approval_ntfy_runtime_reading, approval_ntfy_run, ReadConfig }\nfn second_root() -> Bool {\n  let a = mint_enrolment_code()\n  let t = read_publisher_token()\n  let b = issue_enrolment_code(root: \"/tmp/x\", code: \"c\", issued_at: \"2026-09-21T20:00:00Z\", expires_at: \"2026-09-21T20:10:00Z\")\n  let c = issue_and_deliver_enrolment_code_until(root: \"/tmp/x\", now: \"2026-09-21T20:00:00Z\", expires_at: \"2026-09-21T20:10:00Z\", code: \"c\", publisher: t)\n  let d = deliver_enrolment_code(code: \"c\", expires_at: \"2026-09-21T20:10:00Z\", publisher: t)\n  let e = publish_notification(message: enrolment_code_notification(code: \"c\", expires_at: \"2026-09-21T20:10:00Z\"), publisher: t)\n  let f = approval_ntfy_runtime_reading()\n  let g = approval_ntfy_run(read: ReadConfig, pid: \"1\")\n  true\n}\n"

data sealed_effect_leaves: List<String> = ["mint_enrolment_code", "read_publisher_token", "issue_enrolment_code", "issue_and_deliver_enrolment_code_until", "deliver_enrolment_code", "publish_notification", "approval_ntfy_runtime_reading", "approval_ntfy_run"]

test fn a_second_root_is_refused_at_every_effect_leaf() -> Bool {
  let census = compile_dag_diagnostic_census(unadmitted_effect_caller_source)
  all(sealed_effect_leaves, leaf => match census_blocking_count_for_subject(census: census, wanted_class: "ConstructorCallAdmissionRefused", wanted_subject: leaf) {
    Present { value: n } => n >= 1
    Absent => false
  })
}

// GREEN CONTROL: the admitted root compiles with no admission refusal.
data admitted_root_caller_source: String = "module probe_enrolment_admitted_root\nimport gunbc.cli_wire { CliWireResponse }\nimport std.resources { Network }\nimport gunbc.auth.approval_device_routes { issue_device_enrolment_code }\nfn through_the_root() -> CliWireResponse uses net: Network { issue_device_enrolment_code() }\n"

test fn the_one_root_compiles_without_an_admission_refusal() -> Bool {
  match census_blocking_count_for_class(census: compile_dag_diagnostic_census(admitted_root_caller_source), wanted: "ConstructorCallAdmissionRefused") {
    Present { value: n } => n == 0
    Absent => false
  }
}
