fn run_of(fx: List<FxRead>, name: String) -> ProcessRunOutcome {
  match first(filter(fx, x => x.read == name)) {
    Present { value: x } => ProcessRan { observation: process_observation(exit_code: x.exit_code, stdout: x.stdout, stderr: x.stderr) }
    Absent => ProcessNotSpawned { program: "fixture", cause: "no such read in the fixture" }
  }
}

fn reads_of(fx: List<FxRead>) -> NtfyRuntimeReads {
  NtfyRuntimeReads {
    unit_before: run_of(fx: fx, name: "unit_before"), pid_stat_before: run_of(fx: fx, name: "pid_stat_before"),
    boot_time: run_of(fx: fx, name: "boot_time"), clock_ticks: run_of(fx: fx, name: "clock_ticks"),
    command_line: run_of(fx: fx, name: "command_line"), binary_ctime: run_of(fx: fx, name: "binary_ctime"),
    version: run_of(fx: fx, name: "version"), manager_environment: run_of(fx: fx, name: "manager_environment"),
    server_uid: run_of(fx: fx, name: "server_uid"), net_tcp: run_of(fx: fx, name: "net_tcp"), net_tcp6: run_of(fx: fx, name: "net_tcp6"),
    config_mtime: run_of(fx: fx, name: "config_mtime"), config: run_of(fx: fx, name: "config"),
    auth_file_birth: run_of(fx: fx, name: "auth_file_birth"), access_list: run_of(fx: fx, name: "access_list"),
    front_door: run_of(fx: fx, name: "front_door"), unit_after: run_of(fx: fx, name: "unit_after"),
    pid_stat_after: run_of(fx: fx, name: "pid_stat_after"),
  }
}

fn reading_of(fx: List<FxRead>) -> NtfyRuntimeReading {
  match approval_ntfy_unit_main_pid(run: run_of(fx: fx, name: "unit_before")) {
    Present { value: pid } => RuntimeReadsTaken { pid: pid, reads: reads_of(fx: fx) }
    Absent => RuntimeUnitUnresolved { unit_before: run_of(fx: fx, name: "unit_before") }
  }
}

// One read replaced: the replacement is found first.
fn with_read(fx: List<FxRead>, name: String, exit_code: Int, stdout: String, stderr: String) -> List<FxRead> {
  concat([FxRead { read: name, exit_code: exit_code, stdout: stdout, stderr: stderr }], fx)
}

fn stdout_of(fx: List<FxRead>, name: String) -> String {
  match first(filter(fx, x => x.read == name)) { Present { value: x } => x.stdout  Absent => "" }
}

fn verdict_of(fx: List<FxRead>) -> ApprovalNtfyAclVerdict {
  approval_ntfy_channel_verdict(reading: reading_of(fx: fx))
}

fn refused_with(v: ApprovalNtfyAclVerdict) -> ApprovalNtfyAclDeviation? {
  match v {
    AclRefused { deviation: d } => Present { value: d }
    AclEstablished => none
  }
}

fn gap_of(fx: List<FxRead>) -> ActiveNtfyRuntimeGap? {
  match refused_with(v: verdict_of(fx: fx)) {
    Present { value: ActiveNtfyRuntimeUnbound { gap: g } } => Present { value: g }
    _ => none
  }
}

fn pinned(read: NtfyRuntimeRead, want: String) -> Bool {
  join(argv_words(command: approval_ntfy_read_command(read: read, pid: "4242")), " ") == want
}

// ── POSITIVE CONTROL ──────────────────────────────────────────────────────────────────────
test fn the_bound_exact_acl_is_established() -> Bool {
  match verdict_of(fx: fx_exact) {
    AclEstablished => true
    _ => false
  }
}

// ── THE EIGHTEEN READS, EACH ARGV PINNED ───────────────────────────────────────────────────
test fn pin_unit_before() -> Bool { pinned(read: ReadUnitBefore, want: "timeout --kill-after 2s 10s /usr/bin/systemctl show --property=ActiveState,MainPID,Environment,EnvironmentFiles,PassEnvironment gunbc-ntfy.service") }
test fn pin_unit_after() -> Bool { pinned(read: ReadUnitAfter, want: "timeout --kill-after 2s 10s /usr/bin/systemctl show --property=ActiveState,MainPID,Environment,EnvironmentFiles,PassEnvironment gunbc-ntfy.service") }
test fn pin_pid_stat_before() -> Bool { pinned(read: ReadPidStatBefore, want: "timeout --kill-after 2s 10s cat /proc/4242/stat") }
test fn pin_pid_stat_after() -> Bool { pinned(read: ReadPidStatAfter, want: "timeout --kill-after 2s 10s cat /proc/4242/stat") }
test fn pin_boot_time() -> Bool { pinned(read: ReadBootTime, want: "timeout --kill-after 2s 10s cat /proc/stat") }
test fn pin_clock_ticks() -> Bool { pinned(read: ReadClockTicks, want: "timeout --kill-after 2s 10s getconf CLK_TCK") }
test fn pin_command_line() -> Bool { pinned(read: ReadCommandLine, want: "timeout --kill-after 2s 10s cat /proc/4242/cmdline") }
test fn pin_binary_ctime() -> Bool { pinned(read: ReadBinaryCtime, want: "timeout --kill-after 2s 10s /usr/bin/stat -c %Z -- /usr/bin/ntfy") }
test fn pin_version() -> Bool { pinned(read: ReadVersion, want: "timeout --kill-after 2s 10s /usr/bin/ntfy --version") }
test fn pin_manager_environment() -> Bool { pinned(read: ReadManagerEnvironment, want: "timeout --kill-after 2s 10s /usr/bin/systemctl show-environment") }
test fn pin_server_uid() -> Bool { pinned(read: ReadServerUid, want: "timeout --kill-after 2s 10s id -u -- gunbc-ntfy") }
test fn pin_net_tcp() -> Bool { pinned(read: ReadNetTcp, want: "timeout --kill-after 2s 10s cat /proc/net/tcp") }
test fn pin_net_tcp6() -> Bool { pinned(read: ReadNetTcp6, want: "timeout --kill-after 2s 10s cat /proc/net/tcp6") }
test fn pin_config_mtime() -> Bool { pinned(read: ReadConfigMtime, want: "timeout --kill-after 2s 10s /usr/bin/sudo -n -u gunbc-ntfy /usr/bin/stat -c %Y -- /etc/gunbc-ntfy/server.yml") }
test fn pin_config() -> Bool { pinned(read: ReadConfig, want: "timeout --kill-after 2s 10s /usr/bin/sudo -n -u gunbc-ntfy cat /etc/gunbc-ntfy/server.yml") }
test fn pin_auth_file_birth() -> Bool { pinned(read: ReadAuthFileBirth, want: "timeout --kill-after 2s 10s /usr/bin/sudo -n -u gunbc-ntfy /usr/bin/stat -c %W -- /var/lib/gunbc-ntfy/user.db") }
test fn pin_access_list() -> Bool { pinned(read: ReadAccessList, want: "timeout --kill-after 2s 10s /usr/bin/sudo -n -u gunbc-ntfy /usr/bin/ntfy access --config /etc/gunbc-ntfy/server.yml") }
test fn pin_front_door() -> Bool { pinned(read: ReadFrontDoor, want: "timeout --kill-after 2s 10s /usr/bin/sudo -n tailscale serve status --json") }

// ── FAIL-CLOSED PER READ ───────────────────────────────────────────────────────────────────
// REAL: the config was made unreadable under the running server. Its mtime read (before it) and
// every read after it succeeded; the one middle read that failed is the refusal, named.
test fn a_failed_middle_read_refuses_naming_it() -> Bool {
  match gap_of(fx: fx_config_unreadable) {
    Present { value: RuntimeReadFailed { read: ReadConfig, failure: ReadExitedNonzero { exit_code: 1, stderr: e } } } => string_contains(s: e, pattern: "Permission denied")
    _ => false
  }
}

// SYNTHETIC: a read whose program could not be spawned (no sudo on the host).
test fn a_read_that_could_not_spawn_refuses() -> Bool {
  match gap_of(fx: concat([FxRead { read: "config_mtime", exit_code: 0, stdout: "", stderr: "" }], fx_exact)) {
    Present { value: RuntimeReadFailed { read: ReadConfigMtime, failure: ReadUnparseable { detail: _ } } } => true
    _ => false
  }
    && (match approval_ntfy_channel_verdict(reading: RuntimeReadsTaken { pid: "1", reads: NtfyRuntimeReads {
      unit_before: run_of(fx: fx_exact, name: "unit_before"), pid_stat_before: run_of(fx: fx_exact, name: "pid_stat_before"),
      boot_time: run_of(fx: fx_exact, name: "boot_time"), clock_ticks: run_of(fx: fx_exact, name: "clock_ticks"),
      command_line: run_of(fx: fx_exact, name: "command_line"), binary_ctime: run_of(fx: fx_exact, name: "binary_ctime"),
      version: run_of(fx: fx_exact, name: "version"), manager_environment: run_of(fx: fx_exact, name: "manager_environment"),
      server_uid: run_of(fx: fx_exact, name: "server_uid"), net_tcp: run_of(fx: fx_exact, name: "net_tcp"), net_tcp6: run_of(fx: fx_exact, name: "net_tcp6"),
      config_mtime: ProcessNotSpawned { program: "/usr/bin/sudo", cause: "No such file or directory (os error 2)" }, config: run_of(fx: fx_exact, name: "config"),
      auth_file_birth: run_of(fx: fx_exact, name: "auth_file_birth"), access_list: run_of(fx: fx_exact, name: "access_list"),
      front_door: run_of(fx: fx_exact, name: "front_door"), unit_after: run_of(fx: fx_exact, name: "unit_after"),
      pid_stat_after: run_of(fx: fx_exact, name: "pid_stat_after"),
    } }) {
      AclRefused { deviation: ActiveNtfyRuntimeUnbound { gap: RuntimeReadFailed { read: ReadConfigMtime, failure: ReadNotSpawned { program: p, cause: _ } } } } => p == "/usr/bin/sudo"
      _ => false
    })
}

// SYNTHETIC: a read that timed out (coreutils timeout exits 124).
test fn a_read_that_timed_out_refuses() -> Bool {
  match gap_of(fx: with_read(fx: fx_exact, name: "access_list", exit_code: 124, stdout: "", stderr: "")) {
    Present { value: RuntimeReadFailed { read: ReadAccessList, failure: ReadExitedNonzero { exit_code: 124, stderr: _ } } } => true
    _ => false
  }
}

// ── THE UNIT AND THE BRACKET ───────────────────────────────────────────────────────────────
// SYNTHETIC unit stub: the unit is not running a main process (a server started by hand).
test fn a_server_outside_the_unit_refuses() -> Bool {
  match gap_of(fx: with_read(fx: fx_exact, name: "unit_before", exit_code: 0, stdout: "ActiveState=inactive\nMainPID=0\nEnvironment=\nEnvironmentFiles=\nPassEnvironment=\n", stderr: "")) {
    Present { value: RuntimeUnitNotActive { active_state: s, main_pid: p } } => s == "inactive" && p == "0"
    _ => false
  }
}

// REAL: the server was stopped and started again between the first and the last reads.
test fn a_restart_between_the_reads_refuses() -> Bool {
  match gap_of(fx: fx_restarted) {
    Present { value: RuntimeRestartedDuringRead { before: _, after: _ } } => true
    _ => false
  }
}

// ── THE PROCESS ─────────────────────────────────────────────────────────────────────────────
test fn a_command_line_override_refuses() -> Bool {
  match gap_of(fx: fx_cmdoverride) {
    Present { value: RuntimeCommandLineNotDeclared { observed: a } } => any(a, w => w == "--auth-default-access")
    _ => false
  }
}

test fn a_command_line_listener_override_refuses() -> Bool {
  match gap_of(fx: fx_wildcard_cmd) {
    Present { value: RuntimeCommandLineNotDeclared { observed: a } } => any(a, w => w == "--listen-http")
    _ => false
  }
}

test fn another_executable_refuses() -> Bool {
  match gap_of(fx: fx_otherexe) {
    Present { value: RuntimeCommandLineNotDeclared { observed: a } } => (match first(a) { Present { value: w } => w == "/opt/ntfy-other/ntfy"  Absent => false })
    _ => false
  }
}

test fn a_binary_changed_since_start_refuses() -> Bool {
  match gap_of(fx: fx_binary_touched) {
    Present { value: RuntimeBinaryChangedSinceStart { changed_at: c, started: s } } => c >= s
    _ => false
  }
}

// SYNTHETIC: the version line edited -- no second ntfy release was run.
test fn an_unmodeled_version_refuses() -> Bool {
  match gap_of(fx: with_read(fx: fx_exact, name: "version", exit_code: 0, stdout: "ntfy version 2.29.0\n", stderr: "")) {
    Present { value: RuntimeVersionNotModeled { observed: v } } => v == "ntfy version 2.29.0"
    _ => false
  }
}

