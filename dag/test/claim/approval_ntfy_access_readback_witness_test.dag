data captured_with_script: String = "set -eu\npid=$('systemctl' 'show' 'gunbc-ntfy.service' '--property=MainPID' '--value')\necho '@@mainpid'; echo \"$pid\"\necho '@@started'; now=$(date +%s); et=$(ps -o etimes= -p \"$pid\"); echo $((now - et))\necho '@@exe'; readlink \"/proc/$pid/exe\"\necho '@@version'; \"/proc/$pid/exe\" --version\necho '@@cmdline'; tr '\\000' '\\n' < \"/proc/$pid/cmdline\"\necho '@@environ-names'; tr '\\000' '\\n' < \"/proc/$pid/environ\" | sed -n 's/^\\(NTFY_[A-Za-z0-9_]*\\)=.*/\\1/p'\necho '@@fds'; for f in \"/proc/$pid/fd/\"*; do readlink \"$f\"; done\necho '@@tcp'; cat /proc/net/tcp\necho '@@tcp6'; cat /proc/net/tcp6\necho '@@config-mtime'; stat -c %Y '/etc/gunbc-ntfy/server.yml'\necho '@@config'; cat '/etc/gunbc-ntfy/server.yml'\necho '@@access'; env -i '/usr/bin/ntfy' 'access' '--config' '/etc/gunbc-ntfy/server.yml'\necho '@@end'\n"


fn verdict_of(stdout: String) -> ApprovalNtfyAclVerdict {
  approval_ntfy_channel_verdict(exit_code: 0, stdout: stdout, stderr: "")
}

fn refused_with(v: ApprovalNtfyAclVerdict) -> ApprovalNtfyAclDeviation? {
  match v {
    AclRefused { deviation: d } => Present { value: d }
    AclEstablished => none
  }
}

fn gap_of(stdout: String) -> ActiveNtfyRuntimeGap? {
  match refused_with(v: verdict_of(stdout: stdout)) {
    Present { value: ActiveNtfyRuntimeUnbound { gap: g } } => Present { value: g }
    _ => none
  }
}

fn exact_head() -> String {
  match first(split(s: rt_exact, delimiter: "@@access\n")) {
    Present { value: h } => h
    Absent => ""
  }
}

fn exact_listing() -> String {
  match last(split(s: rt_exact, delimiter: "@@access\n")) {
    Present { value: tail } => replace(s: tail, from: "@@end\n", to: "")
    Absent => ""
  }
}

// The exact capture with its @@access section replaced by another real listing.
fn with_listing(listing: String) -> String {
  exact_head() + "@@access\n" + listing + "@@end\n"
}

// ── POSITIVE CONTROL ──────────────────────────────────────────────────────────────────────
test fn the_bound_exact_acl_is_established() -> Bool {
  match verdict_of(stdout: rt_exact) {
    AclEstablished => true
    _ => false
  }
}

// The command is ONE elevated sh -c as the server's principal, and its script is the one every
// rt_* capture was taken with.
test fn the_readback_is_one_elevated_read_as_the_server_principal() -> Bool {
  let words = argv_words(command: approval_ntfy_runtime_readback_command())
  join(words.take(n: 6), " ") == "/usr/bin/sudo -n -u gunbc-ntfy sh -c"
    && count(words) == 7
    && approval_ntfy_runtime_readback_script() == captured_with_script
}

// ── RUNTIME BINDING REDS (each produced on the real server) ────────────────────────────────
test fn a_unit_with_no_main_process_refuses() -> Bool {
  match refused_with(v: approval_ntfy_channel_verdict(exit_code: 1, stdout: rt_notrunning, stderr: rt_notrunning_stderr)) {
    Present { value: AclReadbackDidNotRun { detail: d } } => string_contains(s: d, pattern: "process ID out of range")
    _ => false
  }
}

// A read whose process never started (no sudo on the host) is a typed refusal, not an abort.
test fn a_read_that_could_not_spawn_refuses() -> Bool {
  match refused_with(v: approval_ntfy_channel_verdict_of_run(run: ProcessNotSpawned { program: "/usr/bin/sudo", cause: "No such file or directory (os error 2)" })) {
    Present { value: AclReadbackDidNotRun { detail: d } } => string_contains(s: d, pattern: "could not be spawned")
    _ => false
  }
}

test fn an_ntfy_environment_override_refuses() -> Bool {
  match gap_of(stdout: rt_envoverride) {
    Present { value: RuntimeEnvironmentOverrides { names: n } } => join(n, ",") == "NTFY_AUTH_DEFAULT_ACCESS"
    _ => false
  }
}

test fn a_command_line_override_refuses() -> Bool {
  match gap_of(stdout: rt_cmdoverride) {
    Present { value: RuntimeCommandLineNotDeclared { observed: a } } => any(a, w => w == "--auth-default-access")
    _ => false
  }
}

test fn a_command_line_listener_override_refuses() -> Bool {
  match gap_of(stdout: rt_wildcard_cmd) {
    Present { value: RuntimeCommandLineNotDeclared { observed: a } } => any(a, w => w == "--listen-http")
    _ => false
  }
}

test fn another_executable_refuses() -> Bool {
  match gap_of(stdout: rt_otherexe) {
    Present { value: RuntimeExecutableNotDeclared { observed: e } } => e == "/opt/ntfy-other/ntfy"
    _ => false
  }
}

test fn the_access_cache_refuses() -> Bool {
  match gap_of(stdout: rt_cache) {
    Present { value: RuntimeConfigAccessCacheEnabled { observed: v } } => v == "true"
    _ => false
  }
}

test fn a_config_default_access_not_deny_refuses() -> Bool {
  match gap_of(stdout: rt_cfg_default_rw) {
    Present { value: RuntimeConfigDefaultAccessNotDeny { observed: v } } => v == "read-write"
    _ => false
  }
}

test fn a_wildcard_config_listener_refuses() -> Bool {
  match gap_of(stdout: rt_wildcard_cfg) {
    Present { value: RuntimeConfigListenNotDeclared { observed: v } } => v == ":2586"
    _ => false
  }
}

// The config's listen-http is the declared endpoint, but the server ALSO listens (metrics, on ::).
test fn a_second_listener_refuses_through_the_socket_join() -> Bool {
  match gap_of(stdout: rt_metrics_extra) {
    Present { value: RuntimeListenerNotDeclared { local_address: a } } => string_contains(s: a, pattern: ":2383")
    _ => false
  }
}

test fn a_config_written_after_start_refuses() -> Bool {
  match gap_of(stdout: rt_config_touched) {
    Present { value: RuntimeConfigChangedSinceStart { started: t0, config_mtime: m } } => m >= t0
    _ => false
  }
}

// The auth database was renamed under the running server and a copy put in its place: the server
// holds the renamed file, while the config (and so ntfy access) name the copy.
test fn an_auth_file_not_held_by_the_server_refuses() -> Bool {
  match gap_of(stdout: rt_authfile_replaced) {
    Present { value: RuntimeAuthFileNotHeldOpen { auth_file: f } } => f == "/var/lib/gunbc-ntfy/user.db"
    _ => false
  }
}

// SYNTHETIC: the exact capture with its version line edited -- no second ntfy release was run.
test fn an_unmodeled_version_refuses() -> Bool {
  match gap_of(stdout: replace(s: rt_exact, from: "ntfy version 2.28.0", to: "ntfy version 2.29.0")) {
    Present { value: RuntimeVersionNotModeled { observed: v } } => v == "ntfy version 2.29.0"
    _ => false
  }
}

// SYNTHETIC: the exact capture with its listening socket's fd line renamed away.
test fn no_listener_refuses() -> Bool {
  match gap_of(stdout: replace(s: rt_exact, from: "\nsocket:[", to: "\nnot-a-socket:[")) {
    Present { value: RuntimeNoListener } => true
    _ => false
  }
}

// SYNTHETIC: a truncated run (no @@end) is malformed, never a shorter observation.
test fn a_truncated_observation_refuses() -> Bool {
  match gap_of(stdout: replace(s: rt_exact, from: "@@end\n", to: "")) {
    Present { value: RuntimeObservationMalformed { cause: _ } } => true
    _ => false
  }
}

// ── ACL REDS: the exact runtime, with each real listing in its @@access section ───────────
test fn an_unplaced_listing_line_refuses() -> Bool {
  match refused_with(v: verdict_of(stdout: with_listing(listing: exact_listing() + "WARN something unrelated\n"))) {
    Present { value: AclListingUnparseable { line: l, cause: _ } } => l == "WARN something unrelated"
    _ => false
  }
}

test fn default_access_not_deny_in_the_listing_refuses() -> Bool {
  match refused_with(v: verdict_of(stdout: with_listing(listing: listing_default_rw))) {
    Present { value: AclDefaultAccessNotDeny { observed: NtfyReadWrite } } => true
    _ => false
  }
}

test fn an_anonymous_read_grant_refuses() -> Bool {
  match refused_with(v: verdict_of(stdout: with_listing(listing: listing_anon_read))) {
    Present { value: AclAnonymousHasGrants { grants: g } } => count(g) == 1
    _ => false
  }
}

test fn a_publisher_that_can_read_refuses() -> Bool {
  match refused_with(v: verdict_of(stdout: with_listing(listing: listing_pub_rw))) {
    Present { value: AclPublisherNotWriteOnly { role: _, admin_all_topics: false, grants: _ } } => true
    _ => false
  }
}

test fn an_admin_publisher_refuses() -> Bool {
  match refused_with(v: verdict_of(stdout: with_listing(listing: listing_pub_admin))) {
    Present { value: AclPublisherNotWriteOnly { role: NtfyRoleAdmin, admin_all_topics: true, grants: _ } } => true
    _ => false
  }
}

test fn an_operator_that_can_write_refuses() -> Bool {
  match refused_with(v: verdict_of(stdout: with_listing(listing: listing_op_rw))) {
    Present { value: AclOperatorNotReadOnly { role: _, admin_all_topics: _, grants: _ } } => true
    _ => false
  }
}

test fn an_operator_without_the_grant_refuses() -> Bool {
  match refused_with(v: verdict_of(stdout: with_listing(listing: listing_op_nogrant))) {
    Present { value: AclOperatorNotReadOnly { role: _, admin_all_topics: _, grants: g } } => count(g) == 0
    _ => false
  }
}

test fn a_missing_operator_refuses() -> Bool {
  match refused_with(v: verdict_of(stdout: with_listing(listing: listing_op_missing))) {
    Present { value: AclPrincipalMissing { user: u } } => u == "gunbc-approval-operator"
    _ => false
  }
}

test fn a_further_admin_refuses() -> Bool {
  match refused_with(v: verdict_of(stdout: with_listing(listing: listing_admin_extra))) {
    Present { value: AclUnexpectedPrincipal { user: u, role: NtfyRoleAdmin } } => u == "root"
    _ => false
  }
}

test fn a_further_wildcard_reader_refuses() -> Bool {
  match refused_with(v: verdict_of(stdout: with_listing(listing: listing_wildcard_reader))) {
    Present { value: AclUnexpectedPrincipal { user: u, role: _ } } => u == "eve"
    _ => false
  }
}

test fn a_duplicated_principal_refuses() -> Bool {
  match refused_with(v: verdict_of(stdout: with_listing(listing: exact_listing() + "user gunbc-approval-operator (role: user, tier: none)\n- read-only access to topic gunbc-approvals\n"))) {
    Present { value: AclPrincipalDuplicated { user: u } } => u == "gunbc-approval-operator"
    _ => false
  }
}

// ── THE ROOT, BY REAL EXECUTION (claim_batch --wet) ─────────────────────────────────────────
// issue_device_enrolment_code accepts nothing, so this claim calls it exactly as production does.
// On a host with no gunbc-ntfy principal (a CI runner, a session container) its own live read
// fails, and the verb must refuse on THAT, before the store is touched. Removing the live read --
// classifying anything but the run it just made -- turns this red: the verb then goes on to the
// clock, the entropy and the store instead of answering that the readback did not run.
fn path_exists(path: String) -> Bool {
  run_shell_command_observe(command: posix_sh_program_command(script: "test -e '" + path + "'\n"), transport: LocalExec).exit_code == 0
}

test fn the_root_refuses_on_its_own_failed_live_read_by_real_execution() -> Bool {
  let before = path_exists(path: approval_device_store_root as String)
  let r = issue_device_enrolment_code()
  !before
    && (match r {
      CliWireUnprintable { cause: c } => string_contains(s: c as String, pattern: "refused before any code was minted") && string_contains(s: c as String, pattern: "readback did not run")
      _ => false
    })
    && !path_exists(path: approval_device_store_root as String)
}

// ── THE SEALS: no second root compiles ─────────────────────────────────────────────────────
// A fresh module reaching each effect leaf from an unadmitted declaration. Each call must be
// refused by admission, named by its subject, so a seal dropped from any one leaf reds this.
data unadmitted_effect_caller_source: String = "module probe_enrolment_second_root\nimport gunbc.auth.approval_device_routes { mint_enrolment_code, issue_and_deliver_enrolment_code_until, deliver_enrolment_code, enrolment_code_notification }\nimport gunbc.auth.approval_device_redemption { issue_enrolment_code }\nimport gunbc.auth.approval_request_submission { read_publisher_token, publish_notification }\nfn second_root() -> Bool {\n  let a = mint_enrolment_code()\n  let t = read_publisher_token()\n  let b = issue_enrolment_code(root: \"/tmp/x\", code: \"c\", issued_at: \"2026-09-21T20:00:00Z\", expires_at: \"2026-09-21T20:10:00Z\")\n  let c = issue_and_deliver_enrolment_code_until(root: \"/tmp/x\", now: \"2026-09-21T20:00:00Z\", expires_at: \"2026-09-21T20:10:00Z\", code: \"c\", publisher: t)\n  let d = deliver_enrolment_code(code: \"c\", expires_at: \"2026-09-21T20:10:00Z\", publisher: t)\n  let e = publish_notification(message: enrolment_code_notification(code: \"c\", expires_at: \"2026-09-21T20:10:00Z\"), publisher: t)\n  true\n}\n"

data sealed_effect_leaves: List<String> = ["mint_enrolment_code", "read_publisher_token", "issue_enrolment_code", "issue_and_deliver_enrolment_code_until", "deliver_enrolment_code", "publish_notification"]

test fn a_second_root_is_refused_at_every_effect_leaf() -> Bool {
  let census = compile_dag_diagnostic_census(unadmitted_effect_caller_source)
  all(sealed_effect_leaves, leaf => match census_blocking_count_for_subject(census: census, wanted_class: "ConstructorCallAdmissionRefused", wanted_subject: leaf) {
    Present { value: n } => n >= 1
    Absent => false
  })
}

// GREEN CONTROL: the admitted root compiles with no admission refusal, so the wall above is not
// one that refuses everyone.
data admitted_root_caller_source: String = "module probe_enrolment_admitted_root\nimport gunbc.cli_wire { CliWireResponse }\nimport std.resources { Network }\nimport gunbc.auth.approval_device_routes { issue_device_enrolment_code }\nfn through_the_root() -> CliWireResponse uses net: Network { issue_device_enrolment_code() }\n"

test fn the_one_root_compiles_without_an_admission_refusal() -> Bool {
  match census_blocking_count_for_class(census: compile_dag_diagnostic_census(admitted_root_caller_source), wanted: "ConstructorCallAdmissionRefused") {
    Present { value: n } => n == 0
    Absent => false
  }
}
