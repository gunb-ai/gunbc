test fn an_ntfy_variable_in_the_unit_refuses() -> Bool {
  match gap_of(fx: fx_envoverride) {
    Present { value: RuntimeEnvironmentOverrides { names: n } } => join(n, ",") == "NTFY_AUTH_DEFAULT_ACCESS"
    _ => false
  }
}

// SYNTHETIC unit stub: an EnvironmentFile, whose contents this read does not see.
test fn an_environment_file_refuses() -> Bool {
  match gap_of(fx: with_read(fx: fx_exact, name: "unit_before", exit_code: 0, stdout: replace(s: stdout_of(fx: fx_exact, name: "unit_before"), from: "EnvironmentFiles=\n", to: "EnvironmentFiles=/etc/default/gunbc-ntfy (ignore_errors=no)\n"), stderr: "")) {
    Present { value: RuntimeEnvironmentFilesPresent { files: f } } => string_contains(s: f, pattern: "/etc/default/gunbc-ntfy")
    _ => false
  }
}

// SYNTHETIC manager environment: an NTFY_* variable every unit inherits.
test fn an_ntfy_variable_in_the_manager_refuses() -> Bool {
  match gap_of(fx: with_read(fx: fx_exact, name: "manager_environment", exit_code: 0, stdout: "LANG=C.UTF-8\nNTFY_AUTH_FILE=/tmp/other.db\n", stderr: "")) {
    Present { value: RuntimeEnvironmentOverrides { names: n } } => join(n, ",") == "NTFY_AUTH_FILE"
    _ => false
  }
}

