fn is_another_subject(fact: SourceByteFact) -> Bool {
  match fact {
    CoverageGapEvidenceNamesAnotherSubject { detail: _ } => true
    SourceBytesObserved { digest: _ } => false
    SourceProducedNoBytesInRange { range: _ } => false
    CoverageGapNotDurablyCommitted { standing: _ } => false
    CoverageGapCommitDoesNotBindThisChunk { binding: _ } => false
    CoverageGapContinuityBroken { continuity: _ } => false
    CoverageGapContinuityShortOfRange { verified_through: _, requested_end: _ } => false
    CoverageGapRangeNotCovered { requested: _, committed: _ } => false
    CoverageGapNotTheRecordingOwner { ownership: _ } => false
  }
}

fn is_recording_owner(id: RecordingOwnerIdentity) -> Bool {
  match id {
    RecordingOwner { session: _, generation: _ } => true
    NotTheRecordingOwner => false
  }
}

fn is_same_occurrence(relation: ChunkRelation) -> Bool {
  match relation {
    SameOccurrence => true
    DistinctOccurrencesEqualPayload => false
    DistinctOccurrencesDifferentPayload => false
    ChunkPayloadIncomparable { left: _, right: _ } => false
  }
}

fn is_distinct_equal_payload(relation: ChunkRelation) -> Bool {
  match relation {
    DistinctOccurrencesEqualPayload => true
    SameOccurrence => false
    DistinctOccurrencesDifferentPayload => false
    ChunkPayloadIncomparable { left: _, right: _ } => false
  }
}

fn is_distinct_different_payload(relation: ChunkRelation) -> Bool {
  match relation {
    DistinctOccurrencesDifferentPayload => true
    SameOccurrence => false
    DistinctOccurrencesEqualPayload => false
    ChunkPayloadIncomparable { left: _, right: _ } => false
  }
}

fn is_committed(standing: LocalCommitStanding) -> Bool {
  match standing {
    LocallyCommitted { committed_content: _ } => true
    LocalCommitFailed { cause: _ } => false
    LocalCommitNotAttempted => false
  }
}

fn is_reference_missing(standing: LocalCommitStanding) -> Bool {
  match standing {
    LocalCommitFailed { cause: cause } =>
      match cause {
        ChunkReferenceMissing { referenced: _ } => true
        SpoolDiskExhausted { attempted: _ } => false
        ChunkCorruptOnReadBack { expected: _, observed: _ } => false
        ChunkRetentionExpired { artifact_ref: _ } => false
        ChunkCommitRefused { detail: _ } => false
      }
    LocallyCommitted { committed_content: _ } => false
    LocalCommitNotAttempted => false
  }
}

fn is_commit_refused(standing: LocalCommitStanding) -> Bool {
  match standing {
    LocalCommitFailed { cause: cause } =>
      match cause {
        ChunkCommitRefused { detail: _ } => true
        SpoolDiskExhausted { attempted: _ } => false
        ChunkCorruptOnReadBack { expected: _, observed: _ } => false
        ChunkReferenceMissing { referenced: _ } => false
        ChunkRetentionExpired { artifact_ref: _ } => false
      }
    LocallyCommitted { committed_content: _ } => false
    LocalCommitNotAttempted => false
  }
}

fn refuses_foreign(outcome: OwnershipOutcome) -> Bool {
  match outcome {
    OwnershipRefused { cause: cause } =>
      match cause {
        ForeignInteractiveSessionNotStolen { observed: _ } => true
        OwnershipLeaseInaccessible => false
        OwnershipGenerationWentBackwards { observed: _, requested: _ } => false
        ReleaseWithoutHoldingTheLease { observed: _ } => false
      }
    OwnershipChanged { transition: _ } => false
  }
}

fn refuses_inaccessible(outcome: OwnershipOutcome) -> Bool {
  match outcome {
    OwnershipRefused { cause: cause } =>
      match cause {
        OwnershipLeaseInaccessible => true
        ForeignInteractiveSessionNotStolen { observed: _ } => false
        OwnershipGenerationWentBackwards { observed: _, requested: _ } => false
        ReleaseWithoutHoldingTheLease { observed: _ } => false
      }
    OwnershipChanged { transition: _ } => false
  }
}

fn refuses_backwards(outcome: OwnershipOutcome) -> Bool {
  match outcome {
    OwnershipRefused { cause: cause } =>
      match cause {
        OwnershipGenerationWentBackwards { observed: _, requested: _ } => true
        OwnershipLeaseInaccessible => false
        ForeignInteractiveSessionNotStolen { observed: _ } => false
        ReleaseWithoutHoldingTheLease { observed: _ } => false
      }
    OwnershipChanged { transition: _ } => false
  }
}

fn acquired(outcome: OwnershipOutcome) -> Bool {
  match outcome {
    OwnershipChanged { transition: transition } =>
      match transition {
        OwnershipAcquired { session: _, generation: _ } => true
        OwnershipRenewed { session: _, generation: _ } => false
        OwnershipTakenOver { session: _, from_generation: _, to_generation: _ } => false
        OwnershipReleased { session: _, generation: _ } => false
      }
    OwnershipRefused { cause: _ } => false
  }
}

fn renewed(outcome: OwnershipOutcome) -> Bool {
  match outcome {
    OwnershipChanged { transition: transition } =>
      match transition {
        OwnershipRenewed { session: _, generation: _ } => true
        OwnershipAcquired { session: _, generation: _ } => false
        OwnershipTakenOver { session: _, from_generation: _, to_generation: _ } => false
        OwnershipReleased { session: _, generation: _ } => false
      }
    OwnershipRefused { cause: _ } => false
  }
}

fn taken_over(outcome: OwnershipOutcome) -> Bool {
  match outcome {
    OwnershipChanged { transition: transition } =>
      match transition {
        OwnershipTakenOver { session: _, from_generation: _, to_generation: _ } => true
        OwnershipAcquired { session: _, generation: _ } => false
        OwnershipRenewed { session: _, generation: _ } => false
        OwnershipReleased { session: _, generation: _ } => false
      }
    OwnershipRefused { cause: _ } => false
  }
}
