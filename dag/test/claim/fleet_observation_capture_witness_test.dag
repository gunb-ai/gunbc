data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// SYNTHETIC SUBJECTS ONLY. Every value below is declared in this module; nothing here reads a real
// chassis, a real controller, or a real capture, so no simulated success can reach a host's verdict
// stream (the brief's evidence bar).

data t_session: CollectorSessionId = CollectorSessionId {
  collector_session: "synthetic-collector-a"
  enrolled_machine: "synthetic-machine-1"
}

data t_other_session: CollectorSessionId = CollectorSessionId {
  collector_session: "synthetic-collector-b"
  enrolled_machine: "synthetic-machine-1"
}

data t_authority: DeclarationRef = DeclarationRef {
  module_path: "test.claim.fleet_observation_capture_witness"
  decl_name: "t_authority"
  field: WholeDeclaration
}

fn t_range(first: Nat, len: Nat) -> SourceStreamRange {
  SourceStreamRange { first_offset: first, length: byte_size(count: len) }
}

fn t_lease(generation: Int) -> HeldLease {
  HeldLease {
    epoch: LeaseEpoch {
      lease_key: "synthetic-endpoint"
      resource_fingerprint: content_hash_of_value(value: "synthetic-endpoint")
      owner_fingerprint: content_hash_of_value(value: "synthetic-collector-a")
      generation: generation
    },
    observed: LeaseRunningExpected
  }
}

fn t_owner(fencing: EndpointFencing) -> EndpointOwnership {
  OwnerRecording { session: t_session, lease: t_lease(generation: 4), fencing: fencing }
}

data t_unfenced: EndpointFencing = RemoteFencingAbsent {
  limitation: "IPMI SOL arbitration is the controller's; this collector observes the result and cannot fence a remote client."
}

data t_fenced: EndpointFencing = RemoteFencingEnforced { authority: t_authority }

fn t_instant(origin: NonEmptyStr, since: Nat) -> ObservationInstant {
  ObservationInstant {
    domain: SharedMonotonic { origin: origin }
    basis: WallClock
    since_origin: since
  }
}

fn t_chunk(seq: Nat, generation: Int, payload: NonEmptyStr, first: Nat, len: Nat) -> CaptureChunk {
  CaptureChunk {
    occurrence: ChunkOccurrence {
      session: t_session
      ownership_generation: generation
      receive_sequence: seq
    },
    range: t_range(first: first, len: len)
    payload_digest: content_hash_of_value(value: payload)
    artifact_ref: "synthetic://chunk"
  }
}

fn t_envelope(
  ownership: EndpointOwnership,
  chunk: CaptureChunk,
  local_commit: LocalCommitStanding,
  continuity: StreamContinuity,
  downstream: DownstreamAcceptanceStanding,
) -> ObservationEnvelope {
  ObservationEnvelope {
    binding: SourceMachineBinding {
      enrolled_machine: "synthetic-machine-1"
      source_identity: "synthetic-sol"
      source_implementation: "synthetic-console"
      source_version: "0"
      authenticated_by: t_authority
    },
    source_generation: SourceGenerationUnavailable { reason: "synthetic source states no generation" }
    native_cursor: NoNativeCursor
    ownership: ownership,
    chunk: chunk,
    producer_timestamp: ProducerTimestampAbsent
    received: ReceiveObservation {
      wall: t_instant(origin: "synthetic-wall", since: 10)
      monotonic: t_instant(origin: "synthetic-mono", since: 10)
      observed_by: t_session
    },
    local_commit: local_commit,
    downstream: downstream,
    continuity: continuity,
  }
}

// THE FIXTURE MINTS THROUGH THE REAL CONSTRUCTOR, not by authoring a standing. That is the whole
// point of the repair: a receipt exists only because a compare-and-set committed something, and what
// it attests is what the store committed. A fixture that built LocallyCommitted directly could still
// line the digests up by hand, which is the circularity being removed.
fn t_commit_for(payload: NonEmptyStr) -> LocalCommitStanding {
  let outcome: CasOutcome<NonEmptyStr> = CasCommitted {
    committed: CasSlotVersion {
      generation: 1
      content: content_hash_of_value(value: payload)
      value: payload
    }
  }
  local_commit_from_cas(outcome: outcome)
}

// ── THE CENTRAL WALL ───────────────────────────────────────────────────────────────────────────

// A NEGATIVE OBSERVATION REQUIRES DURABLE COVERAGE. This is the modelled form of the 2026-09-12
// withdrawal (correction bf4cac9440): a quiet channel is not a boot. Each arm below removes exactly
// one piece of the evidence and the answer must become a COVERAGE GAP naming what is missing --
// never SourceProducedNoBytesInRange.
//
// This is the discriminating RED: if any guard in source_byte_fact were dropped or reordered so an
// empty payload short-circuited to silence, one of these four conjuncts goes false.
test fn w_silence_requires_committed_covered_continuous_bytes() -> Bool {
  let requested = t_range(first: 0, len: 100)
  let empty_chunk = t_chunk(seq: 1, generation: 4, payload: "no-host-bytes-received", first: 0, len: 0)
  let commit = t_commit_for(payload: "no-host-bytes-received")
  let uncommitted = t_envelope(
    ownership: t_owner(fencing: t_unfenced),
    chunk: empty_chunk,
    local_commit: LocalCommitNotAttempted,
    continuity: ContinuityEstablished { verified_through: 100 },
    downstream: DownstreamNotOffered,
  )
  let broken = t_envelope(
    ownership: t_owner(fencing: t_unfenced),
    chunk: empty_chunk,
    local_commit: commit,
    continuity: ContinuityGap {
      gap: t_range(first: 0, len: 40)
      cause: RetainedLogRolledOver { lost_through: 40 }
    },
    downstream: DownstreamNotOffered,
  )
  let not_owner = t_envelope(
    ownership: FollowerReadOnly { session: t_other_session },
    chunk: empty_chunk,
    local_commit: commit,
    continuity: ContinuityEstablished { verified_through: 100 },
    downstream: DownstreamNotOffered,
  )
  is_not_durably_committed(fact: source_byte_fact(envelope: uncommitted, requested: requested))
  && is_continuity_broken(fact: source_byte_fact(envelope: broken, requested: requested))
  && is_not_owner(fact: source_byte_fact(envelope: not_owner, requested: requested))
}

// CONTINUITY VERIFIED THROUGH 10 SAYS NOTHING ABOUT OFFSET 100. Reading the ESTABLISHED arm without
// reading how far it reaches was a real hole in the first draft of this fold, found by the
// interpretation lane on inspection: an envelope whose continuity stopped at 10 licensed silence
// over a range ending at 100. The shortfall now refuses and NAMES both figures.
test fn w_continuity_must_reach_the_requested_end() -> Bool {
  let requested = t_range(first: 0, len: 100)
  let commit = t_commit_for(payload: "no-host-bytes-received")
  let short = t_envelope(
    ownership: t_owner(fencing: t_unfenced),
    chunk: t_chunk(seq: 1, generation: 4, payload: "no-host-bytes-received", first: 0, len: 0),
    local_commit: commit,
    continuity: ContinuityEstablished { verified_through: 10 },
    downstream: DownstreamNotOffered,
  )
  is_continuity_short(fact: source_byte_fact(envelope: short, requested: requested))
  && continuity_covers_range(c: continuity_covers(continuity: ContinuityEstablished { verified_through: 100 }, through: 100))
  && continuity_falls_short(c: continuity_covers(continuity: ContinuityEstablished { verified_through: 99 }, through: 100))
}

// A COMMIT RECEIPT MUST ATTEST THIS CHUNK'S BYTES. A valid receipt for a DIFFERENT payload used to
// satisfy the durability guard, so an envelope could carry somebody else's commit and have it read
// as these bytes being kept. The two digests are never compared to each other -- the slot digest and
// the payload digest are different semantic facts -- so the receipt names the payload it attests and
// that is what is checked.
test fn w_commit_must_attest_this_chunks_payload() -> Bool {
  let requested = t_range(first: 0, len: 100)
  let mismatched = t_envelope(
    ownership: t_owner(fencing: t_unfenced),
    chunk: t_chunk(seq: 1, generation: 4, payload: "no-host-bytes-received", first: 0, len: 0),
    local_commit: t_commit_for(payload: "a-different-chunks-payload"),
    continuity: ContinuityEstablished { verified_through: 100 },
    downstream: DownstreamNotOffered,
  )
  is_commit_unbound(fact: source_byte_fact(envelope: mismatched, requested: requested))
}

// THE THREE IDENTITIES MUST NAME ONE SUBJECT. The recording owner's session, the chunk's occurrence
// and the authenticated source-to-machine binding are independently authored, and an envelope in
// which they disagree used to be answered as though it described one thing. Here the owner records at
// generation 4 while the chunk was received under generation 9.
test fn w_evidence_must_name_one_subject() -> Bool {
  let requested = t_range(first: 0, len: 100)
  let crossed = t_envelope(
    ownership: t_owner(fencing: t_unfenced),
    chunk: t_chunk(seq: 1, generation: 9, payload: "no-host-bytes-received", first: 0, len: 0),
    local_commit: t_commit_for(payload: "no-host-bytes-received"),
    continuity: ContinuityEstablished { verified_through: 100 },
    downstream: DownstreamNotOffered,
  )
  is_another_subject(fact: source_byte_fact(envelope: crossed, requested: requested))
}

// THE POSITIVE CONTROL, which is what keeps every refusal above from being green by vacancy. Silence
// IS mintable with full evidence, and it is a POSITIVE RECEIPT rather than a caller's assertion: a
// durably committed, continuity-verified EMPTY range. Presence is DERIVED from the committed byte
// count, so there is no caller-supplied flag left in the middle of the wall -- which is what the
// first draft got wrong.
test fn w_full_evidence_licenses_silence_and_payload() -> Bool {
  let requested = t_range(first: 0, len: 100)
  let silent = t_envelope(
    ownership: t_owner(fencing: t_unfenced),
    chunk: t_chunk(seq: 1, generation: 4, payload: "no-host-bytes-received", first: 0, len: 0),
    local_commit: t_commit_for(payload: "no-host-bytes-received"),
    continuity: ContinuityEstablished { verified_through: 100 },
    downstream: DownstreamNotOffered,
  )
  let spoke = t_envelope(
    ownership: t_owner(fencing: t_unfenced),
    chunk: t_chunk(seq: 1, generation: 4, payload: "host bytes", first: 0, len: 100),
    local_commit: t_commit_for(payload: "host bytes"),
    continuity: ContinuityEstablished { verified_through: 100 },
    downstream: DownstreamNotOffered,
  )
  is_silence(fact: source_byte_fact(envelope: silent, requested: requested))
  && is_observed(fact: source_byte_fact(envelope: spoke, requested: requested))
}

// COMMIT BYTES X, ASK ABOUT CHUNK Y: THE BINDING MUST NOT AGREE. This is the control for the
// circularity that used to sit in the CONSTRUCTOR rather than in the fold. LocallyCommitted once
// carried a caller-supplied attests_payload, so a caller could commit one payload and hand in the
// digest of another chunk, and commit_attests_chunk would answer CommitAttestsThisChunk by
// construction -- the binding guard proving nothing while looking verified.
//
// The attestation is now read off CasSlotVersion.content, so this fixture commits "bytes-X" through
// the real constructor and asks about a chunk whose payload is "bytes-Y". There is no argument left
// to pass that would make them agree.
test fn w_commit_over_other_bytes_cannot_bind_this_chunk() -> Bool {
  let commit_of_x = t_commit_for(payload: "bytes-X")
  let chunk_of_y = t_chunk(seq: 1, generation: 4, payload: "bytes-Y", first: 0, len: 10)
  let chunk_of_x = t_chunk(seq: 1, generation: 4, payload: "bytes-X", first: 0, len: 10)
  attests_other(b: commit_attests_chunk(standing: commit_of_x, chunk: chunk_of_y))
  && attests(b: commit_attests_chunk(standing: commit_of_x, chunk: chunk_of_x))
  && is_commit_unbound(fact: source_byte_fact(
    envelope: t_envelope(
      ownership: t_owner(fencing: t_unfenced),
      chunk: chunk_of_y,
      local_commit: commit_of_x,
      continuity: ContinuityEstablished { verified_through: 100 },
      downstream: DownstreamNotOffered,
    ),
    requested: t_range(first: 0, len: 100),
  ))
}

fn attests_other(b: CommitBinding) -> Bool {
  match b {
    CommitAttestsOtherPayload { attested: _, chunk_payload: _ } => true
    CommitAttestsThisChunk => false
    CommitNoReceipt { standing: _ } => false
    CommitBindingIncomparable { attested: _, chunk_payload: _ } => false
  }
}

// A MISSING RECEIPT IS A NAMED ABSENCE, NOT A MANUFACTURED DIGEST PAIR. commit_attests_chunk used to
// answer the no-receipt cases with the chunk's own digest in BOTH fields -- reporting "attests a
// different payload" while naming one payload twice, and inventing an attested digest for a receipt
// that does not exist. CommitNoReceipt carries the standing instead.
test fn w_absent_receipt_is_named_not_fabricated() -> Bool {
  let chunk = t_chunk(seq: 1, generation: 4, payload: "x", first: 0, len: 10)
  no_receipt(b: commit_attests_chunk(standing: LocalCommitNotAttempted, chunk: chunk))
  && no_receipt(b: commit_attests_chunk(standing: LocalCommitFailed { cause: ChunkCommitRefused { detail: "synthetic" } }, chunk: chunk))
  && attests(b: commit_attests_chunk(standing: t_commit_for(payload: "x"), chunk: chunk))
}

fn no_receipt(b: CommitBinding) -> Bool {
  match b {
    CommitNoReceipt { standing: _ } => true
    CommitAttestsThisChunk => false
    CommitAttestsOtherPayload { attested: _, chunk_payload: _ } => false
    CommitBindingIncomparable { attested: _, chunk_payload: _ } => false
  }
}

fn attests(b: CommitBinding) -> Bool {
  match b {
    CommitAttestsThisChunk => true
    CommitNoReceipt { standing: _ } => false
    CommitAttestsOtherPayload { attested: _, chunk_payload: _ } => false
    CommitBindingIncomparable { attested: _, chunk_payload: _ } => false
  }
}

fn continuity_covers_range(c: ContinuityCoverage) -> Bool {
  match c {
    ContinuityCoversRange => true
    ContinuityNotEstablished { continuity: _ } => false
    ContinuityShortOfRange { verified_through: _, requested_end: _ } => false
  }
}

fn continuity_falls_short(c: ContinuityCoverage) -> Bool {
  match c {
    ContinuityShortOfRange { verified_through: _, requested_end: _ } => true
    ContinuityCoversRange => false
    ContinuityNotEstablished { continuity: _ } => false
  }
}

// ── EQUAL PAYLOADS ARE NOT DUPLICATE EVENTS ────────────────────────────────────────────────────

// THE SEVEN IDENTICAL CAPTURES, as a test. Two chunks received at different sequences carrying
// byte-identical payloads are DISTINCT OCCURRENCES, and a fold that deduplicated on digest would
// return SameOccurrence here and erase the evidence that exposed the defect.
test fn w_equal_payloads_across_occurrences_are_distinct() -> Bool {
  let a = t_chunk(seq: 1, generation: 4, payload: "banner-only", first: 0, len: 86)
  let b = t_chunk(seq: 2, generation: 4, payload: "banner-only", first: 86, len: 86)
  let c = t_chunk(seq: 3, generation: 4, payload: "different", first: 172, len: 9)
  is_distinct_equal_payload(relation: relate_chunks(left: a, right: b))
  && is_same_occurrence(relation: relate_chunks(left: a, right: a))
  && is_distinct_different_payload(relation: relate_chunks(left: a, right: c))
}

// A DIFFERENT OWNERSHIP GENERATION IS A DIFFERENT OCCURRENCE even at the same receive sequence,
// which is what makes a reconnect's replayed bytes separable from the original.
test fn w_ownership_generation_separates_occurrences() -> Bool {
  let a = t_chunk(seq: 1, generation: 4, payload: "same", first: 0, len: 4)
  let b = t_chunk(seq: 1, generation: 5, payload: "same", first: 0, len: 4)
  is_distinct_equal_payload(relation: relate_chunks(left: a, right: b))
}

// ── FILE EXISTENCE IS NOT A PERSISTENCE PROOF ──────────────────────────────────────────────────

// THE ONLY ROUTE TO LocallyCommitted IS A CAS COMMIT, and each store refusal keeps its own remedy
// rather than collapsing to one failure.
test fn w_commit_standing_comes_only_from_cas() -> Bool {
  let good: CasOutcome<NonEmptyStr> = CasCommitted {
    committed: CasSlotVersion {
      generation: 1
      content: content_hash_of_value(value: "chunk")
      value: "chunk"
    },
  }
  let missing: CasOutcome<NonEmptyStr> = CasStoreRefused {
    cause: CasUnreadableContentMissing { referenced: content_hash_of_value(value: "absent") }
  }
  let refused: CasOutcome<NonEmptyStr> = CasStoreRefused {
    cause: CasUnreadableReadRefused { detail: "synthetic store refusal" }
  }
  is_committed(standing: local_commit_from_cas(outcome: good))
  && is_reference_missing(standing: local_commit_from_cas(outcome: missing))
  && is_commit_refused(standing: local_commit_from_cas(outcome: refused))
}

// ── OWNERSHIP IS OBSERVED, AND A FOREIGN SESSION IS NEVER STOLEN ────────────────────────────────

test fn w_foreign_session_is_never_stolen() -> Bool {
  refuses_foreign(outcome: acquire_ownership(session: t_session, observed: LeasePortForeign, observed_generation: 3, requested_generation: 9))
  && refuses_inaccessible(outcome: acquire_ownership(session: t_session, observed: LeaseInaccessible, observed_generation: 3, requested_generation: 9))
}

// A STALE LEASE IS A TAKEOVER, AN EXPECTED ONE IS A RENEWAL, AN ABSENT ONE IS AN ACQUISITION, and a
// backwards generation refuses in every case. Four different acts, four different answers.
test fn w_ownership_transitions_are_distinguished() -> Bool {
  acquired(outcome: acquire_ownership(session: t_session, observed: LeaseAbsent, observed_generation: 0, requested_generation: 1))
  && renewed(outcome: acquire_ownership(session: t_session, observed: LeaseRunningExpected, observed_generation: 4, requested_generation: 4))
  && taken_over(outcome: acquire_ownership(session: t_session, observed: LeaseRunningStale, observed_generation: 4, requested_generation: 5))
  && refuses_backwards(outcome: acquire_ownership(session: t_session, observed: LeaseRunningStale, observed_generation: 9, requested_generation: 2))
}

// RELEASE IS OBSERVED, AND ONLY THE HOLDER MAY RELEASE. A collector that simply stops is
// indistinguishable from one that died -- the stale-process case -- so handing the endpoint back is
// its own transition. Releasing a lease this session does not hold refuses, because it would retire a
// generation somebody else is recording under.
test fn w_release_is_observed_and_only_by_the_holder() -> Bool {
  released(outcome: release_ownership(session: t_session, observed: LeaseRunningExpected, observed_generation: 4, held_generation: 4))
  && refuses_unheld_release(outcome: release_ownership(session: t_session, observed: LeaseAbsent, observed_generation: 0, held_generation: 4))
  && refuses_unheld_release(outcome: release_ownership(session: t_session, observed: LeaseRunningStale, observed_generation: 4, held_generation: 4))
  && refuses_foreign(outcome: release_ownership(session: t_session, observed: LeasePortForeign, observed_generation: 4, held_generation: 4))
  && refuses_backwards(outcome: release_ownership(session: t_session, observed: LeaseRunningExpected, observed_generation: 9, held_generation: 4))
}

fn released(outcome: OwnershipOutcome) -> Bool {
  match outcome {
    OwnershipChanged { transition: transition } =>
      match transition {
        OwnershipReleased { session: _, generation: _ } => true
        OwnershipAcquired { session: _, generation: _ } => false
        OwnershipRenewed { session: _, generation: _ } => false
        OwnershipTakenOver { session: _, from_generation: _, to_generation: _ } => false
      }
    OwnershipRefused { cause: _ } => false
  }
}

fn refuses_unheld_release(outcome: OwnershipOutcome) -> Bool {
  match outcome {
    OwnershipRefused { cause: cause } =>
      match cause {
        ReleaseWithoutHoldingTheLease { observed: _ } => true
        OwnershipGenerationWentBackwards { observed: _, requested: _ } => false
        OwnershipLeaseInaccessible => false
        ForeignInteractiveSessionNotStolen { observed: _ } => false
      }
    OwnershipChanged { transition: _ } => false
  }
}

// ── EXCLUSIVITY IS CARRIED HONESTLY ────────────────────────────────────────────────────────────

// AN OWNER OVER AN UNFENCED ENDPOINT RECORDS BUT DOES NOT CLAIM STRUCTURAL EXCLUSIVITY. Reading the
// unfenced arm as enforced would claim a guarantee the transport does not provide (DESIGN section 4b
// rung inflation), and the four conjuncts below keep the two independent axes apart: being the
// recorder, and the endpoint being fenced. Collapsing them is what the deleted Bool did.
test fn w_unfenced_owner_records_without_claiming_exclusivity() -> Bool {
  is_recording_owner(id: recording_owner(ownership: t_owner(fencing: t_unfenced)))
  && !fencing_is_enforced(ownership: t_owner(fencing: t_unfenced))
  && fencing_is_enforced(ownership: t_owner(fencing: t_fenced))
  && !is_recording_owner(id: recording_owner(ownership: ForeignSessionHeld { observed: LeasePortForeign }))
  && !is_recording_owner(id: recording_owner(ownership: FollowerReadOnly { session: t_other_session }))
}

// THE WITNESS MATCHES THE CARRIER RATHER THAN CALLING A PREDICATE, which is the point: the
// distinction between "owner, not fenced" and "not the owner" is structural on EndpointOwnership,
// and a Bool over it -- which is what this module used to export -- collapsed the two into one false.
// This local reader exists only to phrase the assertion; it is not a published accessor.
fn fencing_is_enforced(ownership: EndpointOwnership) -> Bool {
  match ownership {
    OwnerRecording { session: _, lease: _, fencing: fencing } =>
      match fencing {
        RemoteFencingEnforced { authority: _ } => true
        RemoteFencingAbsent { limitation: _ } => false
      }
    FollowerReadOnly { session: _ } => false
    ForeignSessionHeld { observed: _ } => false
  }
}

// ── LOCAL DURABILITY IS NOT DOWNSTREAM ACCEPTANCE ──────────────────────────────────────────────

// THE INTERVAL THE REFUSED RETENTION PROMISE IS ABOUT: committed here, not accepted there.
test fn w_local_commit_does_not_imply_forwarding() -> Bool {
  let requested = t_range(first: 0, len: 10)
  let chunk = t_chunk(seq: 1, generation: 4, payload: "x", first: 0, len: 10)
  let commit = t_commit_for(payload: "x")
  let spooled = t_envelope(
    ownership: t_owner(fencing: t_unfenced),
    chunk: chunk,
    local_commit: commit,
    continuity: ContinuityEstablished { verified_through: 10 },
    downstream: DownstreamNotOffered,
  )
  let forwarded = t_envelope(
    ownership: t_owner(fencing: t_unfenced),
    chunk: chunk,
    local_commit: commit,
    continuity: ContinuityEstablished { verified_through: 10 },
    downstream: DownstreamAccepted { accepted_content: content_hash_of_value(value: "x") },
  )
  !is_forwarded(envelope: spooled)
  && is_forwarded(envelope: forwarded)
  && is_observed(fact: source_byte_fact(envelope: spooled, requested: requested))
}

// THE REFUSED RETENTION PROMISE HAS A CONSUMER, and this is it. A locally committed chunk that
// downstream has not accepted is EXPOSED to collector-host loss, and the refusal text it carries
// comes from retention_promise_this_slice rather than from a literal here -- so the roster is read
// rather than restated. Once downstream accepts, the exposure ends.
test fn w_retention_exposure_reads_the_refused_promise() -> Bool {
  let chunk = t_chunk(seq: 1, generation: 4, payload: "x", first: 0, len: 10)
  let commit = t_commit_for(payload: "x")
  let spooled = t_envelope(
    ownership: t_owner(fencing: t_unfenced),
    chunk: chunk,
    local_commit: commit,
    continuity: ContinuityEstablished { verified_through: 10 },
    downstream: DownstreamNotOffered,
  )
  let forwarded = t_envelope(
    ownership: t_owner(fencing: t_unfenced),
    chunk: chunk,
    local_commit: commit,
    continuity: ContinuityEstablished { verified_through: 10 },
    downstream: DownstreamAccepted { accepted_content: content_hash_of_value(value: "x") },
  )
  let unkept = t_envelope(
    ownership: t_owner(fencing: t_unfenced),
    chunk: chunk,
    local_commit: LocalCommitNotAttempted,
    continuity: ContinuityEstablished { verified_through: 10 },
    downstream: DownstreamNotOffered,
  )
  is_exposed(exposure: retention_exposure(envelope: spooled))
  && is_retained_beyond(exposure: retention_exposure(envelope: forwarded))
  && is_not_yet_retained(exposure: retention_exposure(envelope: unkept))
}

fn is_exposed(exposure: RetentionExposure) -> Bool {
  match exposure {
    ExposedToCollectorHostLoss { refusal: _ } => true
    RetainedBeyondCollectorHost => false
    NotYetRetained { standing: _ } => false
  }
}

fn is_retained_beyond(exposure: RetentionExposure) -> Bool {
  match exposure {
    RetainedBeyondCollectorHost => true
    ExposedToCollectorHostLoss { refusal: _ } => false
    NotYetRetained { standing: _ } => false
  }
}

fn is_not_yet_retained(exposure: RetentionExposure) -> Bool {
  match exposure {
    NotYetRetained { standing: _ } => true
    RetainedBeyondCollectorHost => false
    ExposedToCollectorHostLoss { refusal: _ } => false
  }
}

// ── readers ────────────────────────────────────────────────────────────────────────────────────

fn is_silence(fact: SourceByteFact) -> Bool {
  match fact {
    SourceProducedNoBytesInRange { range: _ } => true
    SourceBytesObserved { digest: _ } => false
    CoverageGapNotDurablyCommitted { standing: _ } => false
    CoverageGapContinuityBroken { continuity: _ } => false
    CoverageGapRangeNotCovered { requested: _, committed: _ } => false
    CoverageGapNotTheRecordingOwner { ownership: _ } => false
    CoverageGapCommitDoesNotBindThisChunk { binding: _ } => false
    CoverageGapContinuityShortOfRange { verified_through: _, requested_end: _ } => false
    CoverageGapEvidenceNamesAnotherSubject { detail: _ } => false
  }
}

fn is_observed(fact: SourceByteFact) -> Bool {
  match fact {
    SourceBytesObserved { digest: _ } => true
    SourceProducedNoBytesInRange { range: _ } => false
    CoverageGapNotDurablyCommitted { standing: _ } => false
    CoverageGapContinuityBroken { continuity: _ } => false
    CoverageGapRangeNotCovered { requested: _, committed: _ } => false
    CoverageGapNotTheRecordingOwner { ownership: _ } => false
    CoverageGapCommitDoesNotBindThisChunk { binding: _ } => false
    CoverageGapContinuityShortOfRange { verified_through: _, requested_end: _ } => false
    CoverageGapEvidenceNamesAnotherSubject { detail: _ } => false
  }
}

fn is_not_durably_committed(fact: SourceByteFact) -> Bool {
  match fact {
    CoverageGapNotDurablyCommitted { standing: _ } => true
    SourceBytesObserved { digest: _ } => false
    SourceProducedNoBytesInRange { range: _ } => false
    CoverageGapContinuityBroken { continuity: _ } => false
    CoverageGapRangeNotCovered { requested: _, committed: _ } => false
    CoverageGapNotTheRecordingOwner { ownership: _ } => false
    CoverageGapCommitDoesNotBindThisChunk { binding: _ } => false
    CoverageGapContinuityShortOfRange { verified_through: _, requested_end: _ } => false
    CoverageGapEvidenceNamesAnotherSubject { detail: _ } => false
  }
}

fn is_continuity_broken(fact: SourceByteFact) -> Bool {
  match fact {
    CoverageGapContinuityBroken { continuity: _ } => true
    SourceBytesObserved { digest: _ } => false
    SourceProducedNoBytesInRange { range: _ } => false
    CoverageGapNotDurablyCommitted { standing: _ } => false
    CoverageGapRangeNotCovered { requested: _, committed: _ } => false
    CoverageGapNotTheRecordingOwner { ownership: _ } => false
    CoverageGapCommitDoesNotBindThisChunk { binding: _ } => false
    CoverageGapContinuityShortOfRange { verified_through: _, requested_end: _ } => false
    CoverageGapEvidenceNamesAnotherSubject { detail: _ } => false
  }
}

fn is_range_not_covered(fact: SourceByteFact) -> Bool {
  match fact {
    CoverageGapRangeNotCovered { requested: _, committed: _ } => true
    SourceBytesObserved { digest: _ } => false
    SourceProducedNoBytesInRange { range: _ } => false
    CoverageGapNotDurablyCommitted { standing: _ } => false
    CoverageGapContinuityBroken { continuity: _ } => false
    CoverageGapNotTheRecordingOwner { ownership: _ } => false
    CoverageGapCommitDoesNotBindThisChunk { binding: _ } => false
    CoverageGapContinuityShortOfRange { verified_through: _, requested_end: _ } => false
    CoverageGapEvidenceNamesAnotherSubject { detail: _ } => false
  }
}

fn is_not_owner(fact: SourceByteFact) -> Bool {
  match fact {
    CoverageGapNotTheRecordingOwner { ownership: _ } => true
    SourceBytesObserved { digest: _ } => false
    SourceProducedNoBytesInRange { range: _ } => false
    CoverageGapNotDurablyCommitted { standing: _ } => false
    CoverageGapContinuityBroken { continuity: _ } => false
    CoverageGapRangeNotCovered { requested: _, committed: _ } => false
    CoverageGapCommitDoesNotBindThisChunk { binding: _ } => false
    CoverageGapContinuityShortOfRange { verified_through: _, requested_end: _ } => false
    CoverageGapEvidenceNamesAnotherSubject { detail: _ } => false
  }
}

fn is_continuity_short(fact: SourceByteFact) -> Bool {
  match fact {
    CoverageGapContinuityShortOfRange { verified_through: _, requested_end: _ } => true
    SourceBytesObserved { digest: _ } => false
    SourceProducedNoBytesInRange { range: _ } => false
    CoverageGapNotDurablyCommitted { standing: _ } => false
    CoverageGapCommitDoesNotBindThisChunk { binding: _ } => false
