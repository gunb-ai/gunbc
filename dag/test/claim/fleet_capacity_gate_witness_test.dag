module test.claim.fleet_capacity_gate_witness_test



fn live_instance() -> gunbc.roadmap_dashboard_instance.HostDashboardInstance {
  gunbc.roadmap_dashboard_instance.srv1_live_dashboard_instance()
}

fn declared_offers() -> List<gunbc.dispatch_selection.ProviderOffer> {
  gunbc.dispatch_selection.declared_provider_inventory_for_instance(instance: live_instance()).offers
}

fn withdraw_this_host() -> List<gunbc.fleet_capacity_control.HostCapacityWithdrawal> {
  [gunbc.fleet_capacity_control.HostCapacityWithdrawal {
    host: live_instance().host_identity as product.placement_supply.HostIdentity,
    cause: gunbc.fleet_capacity_control.WithdrawnForMaintenance { detail: "memory upgrade" as std.types.NonEmptyStr },
  }]
}

fn withdraw_codex() -> List<gunbc.fleet_capacity_control.ProviderCapacityWithdrawal> {
  [gunbc.fleet_capacity_control.ProviderCapacityWithdrawal {
    provider: extdeps.llm.cli_lifecycle.CodexCliProvider,
    cause: gunbc.fleet_capacity_control.WithdrawnToReduceSpend { detail: "quota exhausted" as std.types.NonEmptyStr },
  }]
}

// THE GATE ACTUALLY CUTS, WHICH IS THE CLAIM A NEUTRAL LIVE ROSTER CANNOT MAKE.
//
// The live rosters are empty, so the production inventory is unchanged by this wiring. That is
// correct and it is also why this witness authors its own withdrawal: without it every assertion
// here would be about the half of the gate that does nothing, and a wiring that silently failed to
// filter would stay green forever.
test fn withdrawing_this_host_removes_every_offer_it_had() -> Bool {
  let before = declared_offers()
  let after = gunbc.dispatch_selection.capacity_admitted_offers_in(
    host_rows: withdraw_this_host(), provider_rows: [],
    instance: live_instance(), offers: before,
  )
  (before |> count) > 0 && (after |> count) == 0
}

// AN INVENTORY EMPTIED BY WITHDRAWAL IS DISTINGUISHABLE FROM ONE THAT WAS NEVER FILLED.
//
// This is the empty-observation narrow, guarded. A bare filter renders both as the same empty
// list, and the two have opposite remedies -- restore the host, versus install a provider. The
// withdrawn list is what carries the distinguishing fact, so it must be NON-EMPTY exactly when the
// offers went away because someone cut them.
test fn a_withdrawn_empty_inventory_is_not_an_unfilled_one() -> Bool {
  let offers = declared_offers()
  let admitted = gunbc.dispatch_selection.capacity_admitted_offers_in(
    host_rows: withdraw_this_host(), provider_rows: [],
    instance: live_instance(), offers: offers,
  )
  let withdrawn = gunbc.dispatch_selection.capacity_withdrawn_offers_in(
    host_rows: withdraw_this_host(), provider_rows: [],
    instance: live_instance(), offers: offers,
  )
  (admitted |> count) == 0
    && (withdrawn |> count) == (offers |> count)
    && (withdrawn |> count) > 0
}

// CUTTING ONE RUNTIME IS NOT CUTTING THE HOST: THE PARTITION IS EXACT AND LOSES NOTHING.
//
// Every declared offer lands in exactly one of the two lists. A gate that dropped an offer from
// both -- or double-counted one -- would still look plausible on the admitted side alone, which is
// why this asserts the sum against the denominator rather than just that something was removed.
test fn the_gate_partitions_offers_without_losing_any() -> Bool {
  let offers = declared_offers()
  let admitted = gunbc.dispatch_selection.capacity_admitted_offers_in(
    host_rows: [], provider_rows: withdraw_codex(),
    instance: live_instance(), offers: offers,
  )
  let withdrawn = gunbc.dispatch_selection.capacity_withdrawn_offers_in(
    host_rows: [], provider_rows: withdraw_codex(),
    instance: live_instance(), offers: offers,
  )
  (admitted |> count) + (withdrawn |> count) == (offers |> count)
    && (offers |> count) > 0
}

// THE LIVE PRODUCTION INVENTORY IS UNCHANGED BY THIS WIRING.
//
// With empty rosters the gate is exactly the identity, and nothing is withdrawn. This is the
// no-op control: it goes red if the gate ever starts removing production capacity that no operator
// asked to remove, which is the failure this change could plausibly introduce.
test fn the_live_inventory_loses_nothing_to_the_gate() -> Bool {
  let declared = gunbc.dispatch_selection.declared_provider_inventory_for_instance(instance: live_instance())
  let gated = gunbc.dispatch_selection.provider_inventory_for_instance(instance: live_instance())
  let withdrawn = gunbc.dispatch_selection.provider_inventory_withdrawn_for_instance(instance: live_instance())
  (gated.offers |> count) == (declared.offers |> count)
    && (withdrawn |> count) == 0
    && (declared.offers |> count) > 0
}
