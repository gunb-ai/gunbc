module test.claim.workspace_prelaunch_expiry_hold_witness_test

import std.types { Bool, NonEmptyStr }
import extdeps.shell
import extdeps.languages.json.emit { serialize_json, json_array }
import gunbc.fabric_storage_client { FabricStorageLocalFiles }
import gunbc.fabric_storage_file_store { fabric_storage_file_root, fabric_storage_file_root_ensure, FabricStorageRootReady }
import gunbc.workspace_allocation_store { WorkspaceAllocation, WorkspaceWanted, WorkspaceRetired, WorkspaceReserved, WorkspaceReleased, WorkspaceStoreReadOk, WorkspaceStoreWriteRefused, workspace_owner_key, workspace_allocation_json, workspace_read_owner, workspace_record_request }
import gunbc.runner_microvm_slot_controller { workspace_slot_from_ledger, SlotControllerRefused }
import gunbc.test.claim.workspace_acquisition_storage_wet_witness_test { acquisition_fixture_write }
import gunbc.test.claim.workspace_launch_directive_witness_test { launch_fixture_allocation }
import gunbc.test.claim.workspace_allocation_lifecycle_witness_test { allocation_test_request }

// Executes the actual controller boundary against durable owner state. The hold authority is
// unreadable in this fixture, so expiry must retire intent but cannot release capacity or quota.
test fn expired_reserved_controller_retires_even_when_cleanup_is_uncertain() -> Bool {
  let directory = shell.Mktemp.Dir()
  let root = fabric_storage_file_root(root: concat(directory.path as String, "/fabric") as NonEmptyStr)
  if !directory.success { false } else { match fabric_storage_file_root_ensure(root: root) {
    FabricStorageRootReady => match launch_fixture_allocation() {
      Absent => false
      Present { value: fixture } => match fixture.plan {
        Absent => false
        Present { value: prepared } => {
          let reserved = WorkspaceAllocation { recorded_at: "2026-09-27T12:00:00Z", retired_at: "", desired: WorkspaceWanted,
            request: fixture.request, plan: fixture.plan, reservation: Present { value: prepared.reservation },
            phase: WorkspaceReserved, connection: "", observed_at: "", reason: "reserved but never launched" }
          let store = FabricStorageLocalFiles { root: root }
          if !acquisition_fixture_write(store: store, key: workspace_owner_key(owner: reserved.request.owner),
            value: serialize_json(v: json_array(elements: [workspace_allocation_json(allocation: reserved)])) as NonEmptyStr) { false }
          else { let refused = match workspace_slot_from_ledger(allocation: reserved, store: store, release_dir: "/fixture/not-installed", invocation_id: "0123456789abcdef0123456789abcdef") { SlotControllerRefused { refusal: _ } => true _ => false }
            if !refused { false } else { match workspace_read_owner(store: store, owner: reserved.request.owner) {
              WorkspaceStoreReadOk { snapshot } => match snapshot.allocations.first() {
                Absent => false
                Present { value: observed } => observed.desired == WorkspaceRetired && observed.phase != WorkspaceReleased
                  && match workspace_record_request(store: store, request: allocation_test_request(key: "must-remain-blocked")) { WorkspaceStoreWriteRefused { reason: _ } => true _ => false }
              }
              _ => false
            } }
          }
        }
      }
    }
    _ => false
  } }
}
