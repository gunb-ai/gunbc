module test.claim.fabric_witness_run

// Nat is imported explicitly because the strict floor does not supply it ambiently the way
// `gunbc run` does. This file carried no import list at all and resolved anyway under the
// looser path, so adding a Nat-typed parameter passed locally and refused in CI.
import std.nat { Nat }

// The subject is FUNGIBILITY AND AFFORDABILITY, two separate questions with two
// separate coproducts, so every witness here is a refusal on ONE of them or one
// of the controls that prove refusal is not the only reachable arm on either. A
// suite that only proved the happy path would establish that an offer can be
// accepted, which was never in doubt; what is in doubt is that it CANNOT be
// accepted when the executor does not satisfy the work (fungibility), or when
// the demand cannot afford it (affordability) -- and that the two never answer
// for each other's question.

fn t_source() -> SourceManifestRef {
  "gunbc.source.test-commit"
}

fn t_max_buy() -> MoneyAmountMicro {
  money_amount_micro(count: 1000000)
}

fn t_offer(
  threads: HardwareThreadCount,
  caps: CapabilityManifestRef,
  trust: TrustDomainRef,
  quote: OfferQuote,
) -> SupplierOffer<NonEmptyStr> {
  SupplierOffer {
    id: FabricIdentity { principal: "gunbc", key: "offer-srv1" },
    executor: "gunbc",
    shape: Shape { hard: HardRequirements { threads: threads } },
    capabilities: caps,
    trust_domain: trust,
    quantity_bound: 1,
    ready_at: "2026-08-19T00:00:00Z",
    quote: quote,
    billing_quantum_seconds: 0,
    evidence: ObservedSupply {
      observed_at: "2026-08-19T00:00:00Z",
      receipt: "gunbc.observation.fleet-1",
    },
  }
}

fn t_offer_with_quantum(
  quote: OfferQuote,
  quantum_seconds: Nat,
) -> SupplierOffer<NonEmptyStr> {
  SupplierOffer {
    id: FabricIdentity { principal: "gunbc", key: "offer-quantum" },
    executor: "gunbc",
    shape: Shape { hard: HardRequirements { threads: hardware_thread_count(count: 128) } },
    capabilities: "gunbc.capabilities.linux-rust-toolchain",
    trust_domain: "gunbc.trust.internal-fleet",
    quantity_bound: 1,
    ready_at: "2026-08-19T00:00:00Z",
    quote: quote,
    billing_quantum_seconds: quantum_seconds,
    evidence: ObservedSupply {
      observed_at: "2026-08-19T00:00:00Z",
      receipt: "gunbc.observation.fleet-1",
    },
  }
}

// BILLING QUANTUM CHANGES THE BILL, AND THIS IS THE INPUT THAT PROVES IT.
//
// One rate, one 90-second job, two suppliers. Continuous capacity is billed the 90
// seconds it used. An hourly-quantum supplier is billed the whole hour and wastes 3510
// seconds of it. If the fold ever went back to assuming one quantum for everybody, these
// two would collapse to the same number and this test goes red -- which is the point:
// the waste is the modeled advantage of owned compute, and a rate comparison that cannot
// see it ranks suppliers by the wrong number.
test fn billing_quantum_separates_continuous_capacity_from_an_hourly_supplier() -> Bool {
  let ninety = ExactGrantDuration { seconds: second(count: 90) }
  let rate = QuotedPerSecond(MoneyRate { amount: money_amount_micro(count: 1), currency: Usd })
  let continuous = offer_affordability_for(
    offer: t_offer_with_quantum(quote: rate, quantum_seconds: 0),
    maximum_buy_order: money_amount_micro(count: 100),
    budget_currency: Usd,
    duration: ninety,
  )
  let hourly = offer_affordability_for(
    offer: t_offer_with_quantum(quote: rate, quantum_seconds: 3600),
    maximum_buy_order: money_amount_micro(count: 100),
    budget_currency: Usd,
    duration: ninety,
  )
  affordable(a: continuous) && !affordable(a: hourly)
}

fn t_quote(amount: MoneyAmountMicro, currency: CurrencyCode) -> OfferQuote {
  QuotedFlatPerGrant(MoneyRate { amount: amount, currency: currency })
}

// THE OWNED-FLEET OFFER CARRIES AN ASKING PRICE, NOT AN OPPORTUNITY COST.
//
// An owned hour's marginal cash cost is not zero -- power and cooling are
// incurred by the act of running, so they are a real dispatch input -- and its
// OPPORTUNITY COST is not a field on the offer at all: what an hour could
// otherwise have earned depends on which OTHER demands could use it, so it
// belongs to the assignment evaluation, not to the supply row. An earlier
// revision of this comment claimed the quote WAS the opportunity cost; that was
// wrong in the same way the fold below is limited, and both are recorded rather
// than quietly reworded.
//
// What this scalar honestly is: the supplier-side ASKING PRICE for one grant.
// The affordability fold compares it to what the demand will pay. That is
// AFFORDABILITY SCREENING and it is not selection -- nothing here chooses among
// several affordable offers, and choosing would need the interval, tariff,
// commitment state and alternative uses that no carrier holds yet.
fn t_fleet_offer() -> SupplierOffer<NonEmptyStr> {
  t_offer(
    threads: hardware_thread_count(count: 128),
    caps: "gunbc.capabilities.linux-rust-toolchain",
    trust: "gunbc.trust.internal-fleet",
    quote: t_quote(amount: money_amount_micro(count: 40), currency: Usd),
  )
}

fn fungible(e: OfferFungibility) -> Bool {
  match e {
    Fungible => true
    ShapeNotCovered { required_threads: _, offered_threads: _ } => false
    TrustDomainMismatch { required: _, offered: _ } => false
    CapabilitiesNotOffered { required: _, offered: _ } => false
  }
}

// AffordableUnderEstimate is still affordable -- it is affordable AGAINST AN
// ESTIMATE, which is a different fact from Affordable but not a refusal. A
// helper that only accepted the exact arm would make the floor's own duration
// (EstimatedGrantDuration, see fabric_witness_run.dag) permanently ineligible
// by construction, which is exactly the fusion this suite exists to keep out.
fn affordable(a: DemandOfferAffordability) -> Bool {
  match a {
    Affordable => true
    AffordableUnderEstimate { duration_seconds: _, projected_total: _ } => true
    QuoteExceedsMaximumBuyOrder { quoted: _, maximum: _ } => false
    QuoteCurrencyMismatch { quoted: _, budgeted: _ } => false
  }
}

fn floor_fungibility(offer: SupplierOffer<NonEmptyStr>) -> OfferFungibility {
  floor_offer_fungibility(offer: offer)
}

fn floor_affordability(offer: SupplierOffer<NonEmptyStr>) -> DemandOfferAffordability {
  floor_offer_affordability(offer: offer, maximum_buy_order: t_max_buy(), budget_currency: Usd)
}

// CONTROLS. Without these, every refusal below is satisfied by a fold that
// refuses unconditionally -- the shape a wall takes when it is actually a brick.

test fn fleet_offer_is_eligible_for_the_floor() -> Bool {
  fungible(e: floor_fungibility(offer: t_fleet_offer())) && affordable(a: floor_affordability(offer: t_fleet_offer()))
}

// The shape wall is an INEQUALITY. An offer larger than the requirement must
// still be fungible; one that rejected a bigger machine would be a bug wearing
// a wall's clothing.
test fn larger_offer_is_still_eligible() -> Bool {
  fungible(e: floor_fungibility(offer: t_offer(
    threads: hardware_thread_count(count: 256),
    caps: "gunbc.capabilities.linux-rust-toolchain",
    trust: "gunbc.trust.internal-fleet",
    quote: t_quote(amount: money_amount_micro(count: 0), currency: Usd),
  )))
}

// DISCRIMINATING REDS -- fungibility side. None of these carry money, and the
// helper below asserts that on the type: floor_fungibility takes no ceiling and
// no currency at all, so a test proving a capability defect cannot accidentally
// be satisfied by a price change.

// A host outside the declared trust domain must be refused even when it is
// larger: capacity does not substitute for trust.
test fn foreign_trust_domain_refuses_despite_ample_capacity() -> Bool {
  match floor_fungibility(offer: t_offer(
    threads: hardware_thread_count(count: 1024),
    caps: "gunbc.capabilities.linux-rust-toolchain",
    trust: "gunbc.trust.public-cloud",
    quote: t_quote(amount: money_amount_micro(count: 0), currency: Usd),
  )) {
    TrustDomainMismatch { required: _, offered: _ } => true
    Fungible => false
    ShapeNotCovered { required_threads: _, offered_threads: _ } => false
    CapabilitiesNotOffered { required: _, offered: _ } => false
  }
}

test fn missing_capabilities_refuse() -> Bool {
  !fungible(e: floor_fungibility(offer: t_offer(
    threads: hardware_thread_count(count: 128),
    caps: "gunbc.capabilities.linux-x86_64-no-toolchain",
    trust: "gunbc.trust.internal-fleet",
    quote: t_quote(amount: money_amount_micro(count: 0), currency: Usd),
  )))
}

test fn insufficient_threads_refuse() -> Bool {
  !fungible(e: floor_fungibility(offer: t_offer(
    threads: hardware_thread_count(count: 2),
    caps: "gunbc.capabilities.linux-rust-toolchain",
    trust: "gunbc.trust.internal-fleet",
    quote: t_quote(amount: money_amount_micro(count: 0), currency: Usd),
  )))
}

// DISCRIMINATING REDS -- affordability side. These are the arm that makes
// gunbc's own CI an ordinary priced demand rather than an always-admitted path.
// The fleet offer above quotes zero and still goes THROUGH this check; these
// prove the check is reachable and can refuse, and none of them carry shape,
// trust domain or capabilities -- offer_affordability_for takes none of them.

test fn quote_above_the_maximum_buy_order_refuses() -> Bool {
  match floor_affordability(offer: t_offer(
    threads: hardware_thread_count(count: 128),
    caps: "gunbc.capabilities.linux-rust-toolchain",
    trust: "gunbc.trust.internal-fleet",
    quote: t_quote(amount: money_amount_micro(count: 9000000), currency: Usd),
  )) {
    QuoteExceedsMaximumBuyOrder { quoted: _, maximum: _ } => true
    Affordable => false
    AffordableUnderEstimate { duration_seconds: _, projected_total: _ } => false
    QuoteCurrencyMismatch { quoted: _, budgeted: _ } => false
  }
}

// Affordability and fungibility are SEPARATE arms with different remedies --
// raise the buy order, or find another supplier -- so a currency mismatch must
// not be reported through the fungibility coproduct at all, and does not need to
// be distinguished from an over-budget refusal because the two are now different
// TYPES, not two constructors of one type a caller could confuse.
test fn foreign_currency_quote_refuses_distinctly() -> Bool {
  match floor_affordability(offer: t_offer(
    threads: hardware_thread_count(count: 128),
    caps: "gunbc.capabilities.linux-rust-toolchain",
    trust: "gunbc.trust.internal-fleet",
    quote: t_quote(amount: money_amount_micro(count: 1), currency: Eur),
  )) {
    QuoteCurrencyMismatch { quoted: _, budgeted: _ } => true
    Affordable => false
    AffordableUnderEstimate { duration_seconds: _, projected_total: _ } => false
    QuoteExceedsMaximumBuyOrder { quoted: _, maximum: _ } => false
  }
}

// THE CEILING COMPARISON IS STRICT, AND THIS PINS THAT BOUNDARY. A zero-quoted
// offer clears a zero budget because zero is not GREATER than zero.
//
// This witness previously called t_fleet_offer() and asserted the same thing,
// with a comment reading "free capacity is affordable to a zero budget". That
// premise was true while the fleet fixture quoted zero and became FALSE the
// moment it was repriced -- 40 against a ceiling of 0 refuses -- so the witness
// went red on a claim nobody had reread. It now uses its OWN zero-quoted offer,
// because the property under test is the strictness of the comparison and has
// nothing to do with the fleet.
fn t_free_offer() -> SupplierOffer<NonEmptyStr> {
  t_offer(
    threads: hardware_thread_count(count: 128),
    caps: "gunbc.capabilities.linux-rust-toolchain",
    trust: "gunbc.trust.internal-fleet",
    quote: t_quote(amount: money_amount_micro(count: 0), currency: Usd),
  )
}

test fn a_zero_quote_clears_a_zero_ceiling_because_the_comparison_is_strict() -> Bool {
  affordable(a: floor_offer_affordability(
    offer: t_free_offer(),
    maximum_buy_order: money_amount_micro(count: 0),
    budget_currency: Usd,
  ))
}

// The control that keeps the row above from being satisfied by a fold that
// admits everything: one micro over the ceiling refuses.
test fn one_micro_over_a_zero_ceiling_refuses() -> Bool {
  !affordable(a: floor_offer_affordability(
    offer: t_offer(
      threads: hardware_thread_count(count: 128),
      caps: "gunbc.capabilities.linux-rust-toolchain",
      trust: "gunbc.trust.internal-fleet",
      quote: t_quote(amount: money_amount_micro(count: 1), currency: Usd),
    ),
    maximum_buy_order: money_amount_micro(count: 0),
    budget_currency: Usd,
  ))
}

// THE COMMAND. Derived facts, not restatements.

test fn floor_argv_carries_every_declared_source_root() -> Bool {
  let argv = floor_run_command().argv
  all(witness_layer_roots, r => any(argv, a => a == r))
    && length(xs: argv) == 2 + 2 * length(xs: witness_layer_roots)
}

// THE EMITTED STEP IS DERIVED FROM THE FABRIC'S COMMAND, NOT AGREED WITH IT.
//
// This replaces fabric_argv_and_workflow_step_agree_on_source_roots, which asserted that two
// independently-built invocations happened to name the same source roots. That was validation
// standing where construction was available (DESIGN §5) -- it stayed green over a second
// binary path, a second --required-floor spelling and any argument ORDER, because agreeing on
// the roots is not agreeing on the command. witness_floor_run_script now RENDERS
// floor_run_command, so there is one producer and nothing left to agree.
//
// The second clause is the discriminating half and the reason this is not a restatement of the
// implementation: '$ROOT/dag' was the old fork's exact spelling, and it is unrenderable from an
// argv, since shell_command_render single-quotes every word and '$ROOT/dag' does not expand.
// So its presence would mean someone hand-built the path back into the script, which is the
// only way the fork returns.
test fn workflow_step_renders_the_fabric_command_and_does_not_respell_it() -> Bool {
  let script = witness_floor_run_script()
  string_contains(s: script, pattern: shell_command_render(command: floor_run_command()))
    && !string_contains(s: script, pattern: "$ROOT/dag")
    && !string_contains(s: script, pattern: "$ROOT/target")
}

// The renderer must actually place every declared root in the emitted step, single-quoted.
// Without this the row above is satisfied by a renderer that emits nothing at all.
test fn every_declared_source_root_reaches_the_emitted_step() -> Bool {
  let script = witness_floor_run_script()
  all(witness_layer_roots, r => string_contains(s: script, pattern: concat("'", concat(r, "'"))))
}

// THE MODE ITSELF IS NOT SETTLED BY DERIVATION, SO IT KEEPS ITS OWN ROW.
//
// Rendering the script FROM the argv makes script-vs-argv agreement automatic -- that is the
// point of the row above. It says nothing about whether the argv names the RIGHT mode, which
// is a fact about floor_run_command alone and stays independently falsifiable. #8647 found
// exactly this live: both sides were re-pointed at `--required-ci` while the argv still said
// `--required-floor`, and the agreement witness of the day was green throughout. Deleting that
// witness in favour of construction would have dropped the one clause that caught it, so the
// clause is carried here rather than lost with its old carrier.
test fn fabric_command_names_the_consolidated_mode() -> Bool {
  let argv = floor_run_command().argv
  any(argv, a => a == "--required-ci") && !any(argv, a => a == "--required-floor")
}

test fn floor_inputs_manifest_ref_folds_the_same_authority() -> Bool {
  floor_inputs_manifest_ref() == "gunbc.floor.inputs.source-roots:dag+src/v2"
}

// ONE STEP, AND THE RECEIPT DISTINGUISHES MORE THAN IT USED TO.
//
// This asserted `steps == 2` -- the floor and the v1 parse gate as separate
// steps, so a receipt could say which one failed (gunbc#8466 -> #8519). The
// workflow no longer gates them separately: the phases moved into the binary, so
// the contract describes one step and the receipt names one of FOUR phases
// rather than one of two steps. The claim is not weakened by the change, so the
// witness is re-pointed rather than retired -- what it defends is that the
// contract matches the job shape, and the number is the thing that moved.
test fn floor_contract_is_one_composed_step() -> Bool {
  let steps = floor_work_contract(source: t_source()).steps
  length(xs: steps) == 1
    && all(steps, s => s.step_id == "required-ci")
}

// THE FLOOR IS AN ORDINARY PRICED DEMAND. These pin the two properties that,
// if they drift, silently turn gunbc's CI back into a privileged path -- which
// is invisible precisely because everything keeps working when it happens.

// Reuse is disabled for the cutover, and it is disabled ON THE DEMAND. If this
// ever reads true while the floor's purity is unproven, an identical tree stops
// re-running and today's Actions behaviour has been changed by a policy edit
// nobody made deliberately.
test fn floor_demand_requires_a_new_attempt() -> Bool {
  let s = floor_satisfaction_requirement()
  s.new_attempt_required && !s.terminal_receipt_may_satisfy
}

// Step reuse stays permitted: a materialization provider may accelerate a rerun.
// That is not the same claim as "the step completed", and the two must not
// collapse -- a build cache making the second attempt faster is not a receipt.
test fn floor_demand_still_permits_step_reuse() -> Bool {
  floor_satisfaction_requirement().step_reuse_permitted
}

// The buy terms carry a real ceiling that the affordability fold reads. This is
// the join between "the floor is priced" and "the price is checked": a demand
// whose maximum buy order is below an offer's quote must not be affordable to
// it, and that must hold through the floor's own terms rather than only through
// the hand-built ones above.
test fn floor_buy_terms_ceiling_is_the_one_eligibility_reads() -> Bool {
  let terms = floor_buy_terms(
    account: "gunbc.budget.ci",
    reservation_price: money_amount_micro(count: 0),
    maximum_buy_order: money_amount_micro(count: 5),
  )
  !affordable(a: floor_offer_affordability(
    offer: t_offer(
      threads: hardware_thread_count(count: 128),
      caps: "gunbc.capabilities.linux-rust-toolchain",
      trust: "gunbc.trust.internal-fleet",
      quote: t_quote(amount: money_amount_micro(count: 6), currency: Usd),
    ),
    maximum_buy_order: terms.maximum_buy_order,
    budget_currency: terms.currency,
  ))
}

// priority_class must not become a privilege escape. This asserts the floor
// carries an ordinary class string and nothing structural distinguishes it from
// any other demand's -- there is no field here that could admit an unaffordable
// demand.
test fn floor_admission_carries_no_privilege_field() -> Bool {
  let terms = floor_admission_terms(
    buy: floor_buy_terms(
      account: "gunbc.budget.ci",
      reservation_price: money_amount_micro(count: 0),
      maximum_buy_order: money_amount_micro(count: 5),
    ),
    deadline: none,
  )
  terms.priority_class == "gunbc.ci.floor"
}

// THE DISCRIMINATING PAIR FOR THE DIMENSIONAL DEFECT. maximum_buy_order is the
// ceiling on a single grant -- a TOTAL -- and an hourly rate is not one until it
// is multiplied by a duration. Before the fix, the fold read .amount off the
// rate and compared it to the ceiling directly, so an hourly quote of 1 against
// a ceiling of 1000 was unconditionally REFUSED regardless of duration or price
// -- the fold could not price a rate at all, so it treated "I cannot compare a
// rate to a total" as a fact about the supplier rather than a missing input.
// This witness proves the repaired fold prices the rate instead of refusing it
// by construction: a genuinely expensive hourly quote -- one whose amount times
// the grant's own duration exceeds the ceiling -- still refuses, for the real
// arithmetic reason rather than a blanket one.
test fn an_hourly_rate_priced_above_its_projected_total_still_refuses() -> Bool {
  !affordable(a: offer_affordability_for(
    offer: t_offer(
      threads: hardware_thread_count(count: 128),
      caps: "gunbc.capabilities.linux-rust-toolchain",
      trust: "gunbc.trust.internal-fleet",
      quote: QuotedPerHour(MoneyRate { amount: money_amount_micro(count: 10), currency: Usd }),
    ),
    maximum_buy_order: money_amount_micro(count: 9),
    budget_currency: Usd,
    duration: ExactGrantDuration { seconds: second(count: 3600) },
  ))
}

// The same bare amount quoted per SECOND and per HOUR differ by 3600x once a
// real duration is supplied, and were indistinguishable to the old fold, which
// refused both unconditionally without ever reading a duration. Over one hour
// (3600 seconds), a per-second quote of 1 projects to 3600 and a per-hour quote
// of 1 projects to 1: against a ceiling of 1000 the two now DIVERGE, one
// refusing and one affordable, which is the erasure being gone rather than
// merely relabelled.
test fn per_second_and_per_hour_quotes_diverge_once_a_duration_is_supplied() -> Bool {
  let duration = ExactGrantDuration { seconds: second(count: 3600) }
  let per_second = offer_affordability_for(
    offer: t_offer(
      threads: hardware_thread_count(count: 128),
      caps: "gunbc.capabilities.linux-rust-toolchain",
      trust: "gunbc.trust.internal-fleet",
      quote: QuotedPerSecond(MoneyRate { amount: money_amount_micro(count: 1), currency: Usd }),
    ),
    maximum_buy_order: money_amount_micro(count: 1000),
    budget_currency: Usd,
    duration: duration,
  )
  let per_hour = offer_affordability_for(
    offer: t_offer(
      threads: hardware_thread_count(count: 128),
      caps: "gunbc.capabilities.linux-rust-toolchain",
      trust: "gunbc.trust.internal-fleet",
      quote: QuotedPerHour(MoneyRate { amount: money_amount_micro(count: 1), currency: Usd }),
    ),
    maximum_buy_order: money_amount_micro(count: 1000),
    budget_currency: Usd,
    duration: duration,
  )
  !affordable(a: per_second) && affordable(a: per_hour)
}

// THE DISCRIMINATING RED THE FIX EXISTS FOR. Before the fix this claim was
// UNTESTABLE, not merely untested: every per-hour quote reached
// RateQuoteNotPriceableAgainstGrantCeiling unconditionally, so no offer of this
// shape could ever be constructed as eligible, and an hourly supplier -- the
// operator's own sourcing posture is x86 and arm at lowest cost, not anchored
// to owned hardware -- could never win a grant regardless of price. This offer
// is capable (satisfies the floor's own requirements), in-currency (Usd, which
// is what floor_offer_affordability budgets in), and cheap (10 micro/hour
// against the floor's estimated 1800-second grant rounds up to ONE billed
// hour -- billed_unit_count's whole-hour quantum, not a 0.5-hour fraction --
// and projects to 10, against a million-micro ceiling). It must be BOTH fungible and affordable,
// through the floor's own production functions -- not a hand-built duration --
// so this is the fix proven on the real codepath, not only on the isolated
// fold. KEEP THIS ENROLLED: per DESIGN section 4b, the evidence that a climb
// happened survives even if the production machinery it discriminates is later
// replaced.
test fn an_hourly_offer_that_is_capable_in_currency_and_cheap_is_eligible() -> Bool {
  let offer = t_offer(
    threads: hardware_thread_count(count: 128),
    caps: "gunbc.capabilities.linux-rust-toolchain",
    trust: "gunbc.trust.internal-fleet",
    quote: QuotedPerHour(MoneyRate { amount: money_amount_micro(count: 10), currency: Usd }),
  )
  fungible(e: floor_offer_fungibility(offer: offer))
    && affordable(a: floor_offer_affordability(
         offer: offer,
         maximum_buy_order: money_amount_micro(count: 1000000),
         budget_currency: Usd,
       ))
}

// THE POSITIVE CONTROL FOR THE REFUSAL. A per-grant total under the ceiling is
// still eligible, so the arm above refuses rates specifically and has not simply
// made every priced offer ineligible -- which would pass both reds above while
// destroying the fold.
test fn a_per_grant_total_under_the_ceiling_is_still_eligible() -> Bool {
  affordable(a: floor_offer_affordability(
    offer: t_offer(
      threads: hardware_thread_count(count: 128),
      caps: "gunbc.capabilities.linux-rust-toolchain",
      trust: "gunbc.trust.internal-fleet",
      quote: t_quote(amount: money_amount_micro(count: 6), currency: Usd),
    ),
    maximum_buy_order: money_amount_micro(count: 1000),
    budget_currency: Usd,
  ))
}

// SELF-CI IS NOT FREE BY CONSTRUCTION. The owned fleet carries an asking price,
// so a demand whose ceiling sits below it cannot claim the hour. This is the witness that would
// have been unwritable while the fleet quoted zero: at zero it clears every
// ceiling, so no ceiling can refuse it and the arm has no discriminating input.
test fn an_owned_hour_with_an_asking_price_can_be_outbid() -> Bool {
  !affordable(a: floor_offer_affordability(
    offer: t_fleet_offer(),
    maximum_buy_order: money_amount_micro(count: 39),
    budget_currency: Usd,
  ))
}

// The control for the row above: the same owned-fleet offer IS affordable to a
// demand willing to pay its asking price. Without this, refusing at 39 is
// equally explained by the fleet offer having become unaffordable outright.
test fn an_owned_hour_is_eligible_to_a_demand_that_meets_its_asking_price() -> Bool {
  affordable(a: floor_offer_affordability(
    offer: t_fleet_offer(),
    maximum_buy_order: money_amount_micro(count: 40),
    budget_currency: Usd,
  ))
}
