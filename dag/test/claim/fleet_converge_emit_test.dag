module test.claim.fleet_converge_emit


data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

fn fixture_runner_host() -> RunnerHostDeployment {
  RunnerHostDeployment {
    identity: "srv1",
    runner_count: 7,
    runner_slice_cap: byte_size(70391285350),
    per_runner_memory_cap: byte_size(30000000000),
    per_runner_memory_swap_cap: byte_size(5000000000),
    per_runner_memory_high_cap: byte_size(4000000000),
    build_tokens: hardware_thread_count(count: 12),
    runner: SelfHosted { labels: ["self-hosted", "linux", "arm64"] },
    workload_class: BatchLatencyTolerant,
  }
}

fn fixture_sound_plan() -> RunnerDeploymentPlan {
  PlanDerived { hosts: [fixture_runner_host()], fleet_concurrent_runs: 7 }
}

fn fixture_regime2_mode() -> SessionReservationMode {
  Regime2AggregateOomd {
    oomd_eviction_ceiling: byte_size(10737418240),
    session_concurrency: 16,
    aggregate_reservation: SessionAggregateMeasured { bytes: byte_size(21474836480) },
  }
}

fn fixture_sound_policy() -> ConvergePolicy {
  fleet_converge_policy_from(plan: fixture_sound_plan(), mode: fixture_regime2_mode())
}

fn fixture_sound_sh() -> String {
  fleet_converge_sh_for(policy: fixture_sound_policy())
}

fn has(s: String, p: String) -> Bool {
  string_contains(s: s, pattern: p)
}

fn witness_live_converge_thin_run_emitted() -> Bool {
  let sh = expected_fleet_converge_sh()
  !has(s: sh, p: "fleet-converge UNSOUND:")
    && has(s: sh, p: "gunbc converge --host \"srv1\"")
    && has(s: sh, p: "gunbc converge --host \"srv2\"")
    && has(s: sh, p: "gunbc converge --host \"srv3\"")
    && has(s: sh, p: "fresh-standup bootstrap (srv3 exemplar)")
}

fn witness_drift_red_receipt() -> Bool {
  let r = filesystem_read(path: ".github/fleet-converge.sh")
  has(s: r.content, p: "# GENERATED by dag/gunbc/fleet_converge_emit.dag")
    && !fleet_converge_drifted(committed: r.content)
    && fleet_converge_drifted(committed: concat(r.content, "x"))
}

fn witness_thin_header() -> Bool {
  let sh = fixture_sound_sh()
  has(s: sh, p: "#!/usr/bin/env bash")
    && has(s: sh, p: "set -euo pipefail")
    && has(s: sh, p: "Thin-run: steady-state converge via gunbc converge --host")
    && has(s: sh, p: "host_failed=0")
    && has(s: sh, p: "exit \"$host_failed\"")
}

fn witness_no_steady_state_shell() -> Bool {
  let sh = expected_fleet_converge_sh()
  !has(s: sh, p: "converge_slice_property(")
    && !has(s: sh, p: "converge_runner_width(")
    && !has(s: sh, p: "converge_gunbc_pinned_tree(")
    && !has(s: sh, p: "emit_receipt()")
    && !has(s: sh, p: "host_begin(")
    && !has(s: sh, p: "converge-receipt")
}

fn witness_fixture_sound_thin_only() -> Bool {
  let sh = fixture_sound_sh()
  has(s: sh, p: "gunbc converge --host \"srv1\" || host_failed=1")
    && !has(s: sh, p: "fresh-standup bootstrap")
}

fn last_runner_knob_name(knobs: List<ConvergeKnob>) -> String {
  fold(knobs, init: "", f: (acc, k) => match k.slice {
    GunbcSlice => acc
    RunnerSlice => k.name
    SessionsSlice => acc
  })
}

fn witness_caps_before_widen_order() -> Bool {
  match fixture_sound_policy() {
    ConvergePolicyDerived { hosts: hosts } =>
      hosts.length() > 0 && all(hosts, h => last_runner_knob_name(knobs: h.knobs) == "runner_count")
    ConvergePolicyUnsound { reason: _ } => false
  }
}

fn vlabel(effective: String, expected: String) -> String {
  converge_verdict_label(v: converge_verdict(effective: effective, expected: expected))
}

fn witness_verdict_discriminating() -> Bool {
  vlabel(effective: "kill", expected: "kill") == "converged"
    && vlabel(effective: "auto", expected: "kill") == "drifted"
    && vlabel(effective: "", expected: "kill") == "absent"
    && vlabel(effective: "70391285350", expected: "70391285350") == "converged"
    && vlabel(effective: "123", expected: "70391285350") == "drifted"
}

fn witness_gunbc_apply_mode_srv3_fresh_standup() -> Bool {
  converge_apply_mode_label(m: gunbc_apply_mode_for_host(host: operator_host_srv3)) == "fresh_standup"
    && converge_apply_mode_label(m: gunbc_apply_mode_for_host(host: "srv1")) == "existing_host_quiescent"
}

fn witness_gunbc_noop_predicate_process_and_green_place() -> Bool {
  let sha = "53e066417e00ee56deb084ea75a969a7f3f96592"
  let marker_line = concat(concat("pin=", sha), " first_green_at=2026-06-29T15:00:00Z")
  gunbc_sha_triple_coherent(binary_pin: sha, dag_pin: sha, ctrl_pin: sha)
    && gunbc_pinned_noop_satisfied(
      binary_pin: sha,
      dag_pin: sha,
      ctrl_pin: sha,
      process_pin: sha,
      marker_line: marker_line,
      marker_pin: sha,
    )
    && !gunbc_pinned_noop_satisfied(
      binary_pin: sha,
      dag_pin: sha,
      ctrl_pin: sha,
      process_pin: "",
      marker_line: marker_line,
      marker_pin: sha,
    )
    && !gunbc_green_place_marker_satisfied(marker_line: "pin=deadbeef", marker_pin: "deadbeef", desired_pin: sha)
    && converge_no_op_policy_label(p: gunbc_pinned_noop_policy()) == "skip_process_pin_coherent_and_marker"
    && gunbc_process_effective_converged(process_pin: sha, ctrl_pin: sha)
    && second_count(s: gunbc_spawn_retry_backstop_cadence) == 600
    && gunbc_pinned_tree_desired_label == "ctrl:third_party/gunbc"
}

fn first_host_knob_name(knobs: List<ConvergeKnob>) -> String {
  knobs.first().name
}

fn witness_gunbc_pinned_tree_runs_first() -> Bool {
  match fixture_sound_policy() {
    ConvergePolicyDerived { hosts: hosts } =>
      hosts.length() > 0 && all(hosts, h => first_host_knob_name(knobs: h.knobs) == "pinned_tree_sha")
    ConvergePolicyUnsound { reason: _ } => false
  }
}

fn witness_fresh_standup_bootstrap_emit_bytes_hold() -> Bool {
  let sh = expected_fleet_converge_sh()
  has(s: sh, p: fresh_standup_bootstrap_arm_golden())
    && has(s: sh, p: fresh_standup_bootstrap_script())
    && has(s: sh, p: concat("checkout=\"", gunbc_host_ctrl_checkout_path))
    && has(s: sh, p: gunbc_ctrl_read_pin_script)
    && has(s: sh, p: concat("export ", gunbc_root_env_key))
    && has(s: sh, p: gunbc_host_gunbc_root_path)
    && has(s: sh, p: "cargo build -p v1-compiler --release --bin gunbc")
    && !has(s: sh, p: fresh_standup_bootstrap_emit_refused_poison)
    && fresh_standup_bootstrap_committed_byte_oracle_holds()
}

fn witness_fresh_standup_bootstrap_arm_perturb_red() -> Bool {
  !has(s: expected_fleet_converge_sh(), p: concat(fresh_standup_bootstrap_arm_golden(), "x"))
    && !has(s: expected_fleet_converge_sh(), p: concat(fresh_standup_bootstrap_script(), "x"))
}

fn witness_fresh_standup_bootstrap_emit_dissolution_scaffold() -> Bool {
  match fleet_converge_fresh_standup_bootstrap_emit_dissolution_trigger {
    Terminal { reason: _ } => true
    Scaffold { dissolves_to: _, bind: _ } => false
  }
}

fn witness_steady_state_doc_projection_still_scaffold_pending_cli() -> Bool {
  match fleet_converge_steady_state_doc_projection_dissolution_trigger {
    Scaffold {
      dissolves_to: RealizationDispatch,
      bind: DeclarationRef { module_path: m, decl_name: d, field: WholeDeclaration },
    } =>
      m == "gunbc.fleet_converge_apply" && d == "fleet_converge_thin_invocation"
    Terminal { reason: _ } => false
  }
}

fn witness_bootstrap_script_not_poison() -> Bool {
  !has(s: fresh_standup_bootstrap_script(), p: fresh_standup_bootstrap_emit_refused_poison)
}

test fn fleet_converge_emit_bootstrap_holds() -> Bool {
  witness_bootstrap_script_not_poison()
    && witness_fresh_standup_bootstrap_emit_bytes_hold()
    && witness_fresh_standup_bootstrap_arm_perturb_red()
    && witness_fresh_standup_bootstrap_emit_dissolution_scaffold()
}

test fn fleet_converge_emit_thin_run_holds() -> Bool {
  witness_live_converge_thin_run_emitted()
    && witness_thin_header()
    && witness_no_steady_state_shell()
    && witness_fixture_sound_thin_only()
}

test fn fleet_converge_emit_policy_holds() -> Bool {
  witness_drift_red_receipt()
    && witness_caps_before_widen_order()
    && witness_verdict_discriminating()
    && witness_gunbc_noop_predicate_process_and_green_place()
    && witness_gunbc_apply_mode_srv3_fresh_standup()
    && witness_gunbc_pinned_tree_runs_first()
    && witness_steady_state_doc_projection_still_scaffold_pending_cli()
}

test fn fleet_converge_emit_holds() -> Bool {
  witness_bootstrap_script_not_poison()
    && witness_fresh_standup_bootstrap_emit_bytes_hold()
    && witness_fresh_standup_bootstrap_arm_perturb_red()
    && witness_fresh_standup_bootstrap_emit_dissolution_scaffold()
    && witness_live_converge_thin_run_emitted()
    && witness_thin_header()
    && witness_no_steady_state_shell()
    && witness_fixture_sound_thin_only()
    && witness_drift_red_receipt()
    && witness_caps_before_widen_order()
    && witness_verdict_discriminating()
    && witness_gunbc_noop_predicate_process_and_green_place()
    && witness_gunbc_apply_mode_srv3_fresh_standup()
    && witness_gunbc_pinned_tree_runs_first()
    && witness_steady_state_doc_projection_still_scaffold_pending_cli()
}
