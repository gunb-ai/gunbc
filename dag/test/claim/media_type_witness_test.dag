module test.claim.media_type_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

// D1 keystone: the served stack's Content-Type wire strings are a SERIALIZATION of the modeled MediaType (RFC 9110 section 8.3 type/subtype/parameters), not hand-composed strings hiding the structure. The five preset labels are pinned byte-exact (browsers are the consumer — these must NEVER drift), and the RED controls perturb a parameter value and a subtype so the wire string changes and the pin reds, proving the pin discriminates. ApplicationOctetStream's charset-less form falls out of an EMPTY parameter list, not a special variant.
test fn witness_preset_wire_strings_byte_exact() -> Bool {
  extdeps.http.server.media_type_wire_label(m: extdeps.http.server.text_html_utf8) == "text/html; charset=utf-8"
    && extdeps.http.server.media_type_wire_label(m: extdeps.http.server.text_plain_utf8) == "text/plain; charset=utf-8"
    && extdeps.http.server.media_type_wire_label(m: extdeps.http.server.application_json_utf8) == "application/json; charset=utf-8"
    && extdeps.http.server.media_type_wire_label(m: extdeps.http.server.text_javascript_utf8) == "text/javascript; charset=utf-8"
    && extdeps.http.server.media_type_wire_label(m: extdeps.http.server.application_octet_stream) == "application/octet-stream"
}

test fn witness_octet_stream_has_no_charset() -> Bool {
  count(application_octet_stream.parameters) == 0
    && !string_contains(s: extdeps.http.server.media_type_wire_label(m: extdeps.http.server.application_octet_stream), pattern: "charset")
    && count(text_html_utf8.parameters) == 1
    && string_contains(s: extdeps.http.server.media_type_wire_label(m: extdeps.http.server.text_html_utf8), pattern: "; charset=utf-8")
}

test fn witness_structure_projects() -> Bool {
  text_html_utf8.top_level == extdeps.http.server.TopLevelText
    && text_html_utf8.subtype == "html"
    && application_json_utf8.top_level == extdeps.http.server.TopLevelApplication
    && charset_utf8.name == "charset"
    && charset_utf8.value == "utf-8"
}

fn perturbed_charset_media_type() -> extdeps.http.server.MediaType {
  extdeps.http.server.MediaType {
    top_level: extdeps.http.server.TopLevelText,
    subtype: "html",
    parameters: [extdeps.http.server.MediaTypeParameter { name: "charset", value: "utf-16" }],
  }
}

// RED control: perturb the charset parameter value; the wire string changes, so the byte-exact pin above no longer holds — a silent drift would go red here.
test fn witness_perturbed_parameter_reds() -> Bool {
  extdeps.http.server.media_type_wire_label(m: perturbed_charset_media_type()) != "text/html; charset=utf-8"
    && extdeps.http.server.media_type_wire_label(m: perturbed_charset_media_type()) == "text/html; charset=utf-16"
}

test fn witness_perturbed_subtype_reds() -> Bool {
  let bad = extdeps.http.server.MediaType { top_level: extdeps.http.server.TopLevelText, subtype: "xml", parameters: [extdeps.http.server.charset_utf8] }
  extdeps.http.server.media_type_wire_label(m: bad) != extdeps.http.server.media_type_wire_label(m: extdeps.http.server.text_html_utf8)
    && extdeps.http.server.media_type_wire_label(m: bad) == "text/xml; charset=utf-8"
}

