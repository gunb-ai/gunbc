module test.claim.sibling_operand_effect_site_census_test

import std.types { Bool, Int }
import v2.std.algebra { all, filter, length }
import gunbc.sibling_operand_effect_site_census {
  sibling_operand_effect_sites,
  site_is_argument_list,
  site_is_record_literal,
  site_is_infix,
  site_is_false_positive,
  sibling_effect_site_count,
  sibling_effect_argument_list_count,
  sibling_effect_record_literal_count,
  sibling_effect_infix_count,
  sibling_effect_order_matters_count,
  sibling_effect_false_positive_count,
  sibling_effect_sites_the_wall_would_refuse
}

// WHAT THIS WITNESS IS, AND FIRST OF ALL WHAT IT IS NOT.
//
// IT DOES NOT ESTABLISH THAT THE CENSUS FOUND EVERY SITE. It cannot: the roster beside it is a
// source sweep, not a fold over lowered bodies, and no assertion here would move if a fourteenth
// site were authored tomorrow. Saying that first is the point, because a green witness sitting next
// to a census is precisely the artifact a reader mistakes for "the census is verified", and this
// census exists to gate a REFUSAL -- so a reader who over-reads it would enrol a wall believing the
// population was certified when only the roster's internal consistency was.
//
// WHAT IT DOES GUARD is the two places the carrier's types could not make a bad row unwritable.
// Everything else is already construction rather than validation: a site's stake is an exhaustive
// coproduct, so an undispositioned row has no constructor and needs no check (DESIGN section 5).
//
// NO COUNT IS ASSERTED AGAINST A LITERAL. Every number here is one fold over the roster compared to
// another fold over the same roster, so adding a site cannot make this file stale and no assertion
// can be silenced by editing a number -- which is the change-detector failure DESIGN section 5
// names when a test's whole content is a copied measurement.

// A SITE WITH FEWER THAN TWO EFFECT-REACHING CHILDREN IS NOT A SITE.
//
// The entire class is about TWO OR MORE siblings; a row reporting one would be counted by
// sibling_effect_sites_the_wall_would_refuse while describing something the wall does not refuse,
// which would overstate the wall's blast radius at exactly the moment that number is being used to
// admit it. RED CASE: set any row's effect_reaching_children to 1.
fn every_site_has_at_least_two_effect_reaching_children() -> Bool {
  sibling_operand_effect_sites |> all(s => s.effect_reaching_children >= 2)
}

// THE COUNT AND THE CALLEE LIST ARE TWO VIEWS OF ONE FACT AND MUST AGREE.
//
// effect_reaching_children is what the histogram folds and callees is what a reader takes to the
// source to check the row. A row where they disagree is a row that cannot be checked: the reader
// verifies the list, the arithmetic uses the number, and neither notices. RED CASE: leave a callee
// out of any row's list while keeping its count.
fn every_site_count_equals_its_callee_list() -> Bool {
  sibling_operand_effect_sites |> all(s => length(s.callees) == s.effect_reaching_children)
}

// A ROW MAY NOT CLAIM UNAMBIGUOUS RESOLUTION WITH NOTHING TO RESOLVE.
//
// callee_resolution_is_unambiguous is the field that stands in for the resolution a text sweep
// cannot perform, so it is the one a later author is most likely to copy forward without redoing
// the uniqueness check. A row asserting it over an empty callee list asserts it about nothing.
// RED CASE: file a row with true and an empty callees list.
fn every_unambiguous_claim_has_a_callee() -> Bool {
  sibling_operand_effect_sites |> all(s =>
    if s.callee_resolution_is_unambiguous { length(s.callees) > 0 } else { true }
  )
}

// THE KIND COLUMNS PARTITION THE ROSTER RATHER THAN MERELY FITTING INSIDE IT.
//
// This is the assertion that reds if a future SiblingListKind arm is added with a fold arm that
// returns false everywhere -- the one way a derived histogram silently under-reports while every
// individual count still looks plausible. A bound alone would not catch it, which is why the
// assertion is an equality over the sum and not a set of inequalities.
fn the_kind_columns_sum_to_the_roster() -> Bool {
  sibling_effect_argument_list_count()
    + sibling_effect_record_literal_count()
    + sibling_effect_infix_count()
    == sibling_effect_site_count()
}

// THE NUMBER THE WALL WOULD REFUSE IS EXACTLY THE NON-FALSE-POSITIVE ROWS.
//
// sibling_effect_sites_the_wall_would_refuse is the single number the owning lane is deciding on,
// so it is the one most likely to be hand-curated later into "the ones I think are real". This pins
// it to its definition and to the false-positive column it is the complement of. RED CASE: replace
// the filter with an authored list, or disposition a row as a false positive without the refused
// count moving.
fn the_refused_number_is_exactly_the_complement_of_the_false_positives() -> Bool {
  let refused = sibling_effect_sites_the_wall_would_refuse()
  refused + sibling_effect_false_positive_count() == sibling_effect_site_count()
    && sibling_effect_order_matters_count() <= refused
}

test fn site_has_at_least_two_effect_reaching_children() -> Bool {
  every_site_has_at_least_two_effect_reaching_children()
}

test fn site_count_equals_its_callee_list() -> Bool {
  every_site_count_equals_its_callee_list()
}

test fn unambiguous_claim_has_a_callee() -> Bool {
  every_unambiguous_claim_has_a_callee()
}

test fn kind_columns_sum_to_the_roster() -> Bool {
  the_kind_columns_sum_to_the_roster()
}

test fn refused_number_is_exactly_the_complement_of_the_false_positives() -> Bool {
  the_refused_number_is_exactly_the_complement_of_the_false_positives()
}
