module test.claim.materialized_ssh_key_file_real_execution_witness

import std.algebra { trim }
import std.types { String, NonEmptyStr, Secret, FilePath, Bool, PathSegment }
import extdeps.shell
import extdeps.filesystem.filesystem_io
import gunbc.auth.materialized_secret {
  gunbc_private_materialization_dir,
  ensure_gunbc_private_materialization_dir,
}
import gunbc.auth.private_secret_file {
  with_private_secret_file,
  PrivateSecretFileCompleted,
  PrivateSecretFileCompletedResidueRemains,
  PrivateSecretFileNotEntered,
  PrivateSecretFileNotEnteredResidueRemains,
}
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data real_execution_home_doc: String = "Wet execution witnesses for SECRETREF-WIRE-0 ssh key materialization: the SshKeyFile leg, now gunbc.auth.private_secret_file with_private_secret_file (a fresh 0700 directory per call, Filesystem.WriteOwnerOnly mode 0600 at creation via create_new/O_EXCL, file and directory removed after the body) and WriteOwnerOnly refusal when the path already exists. shell.Mktemp.Dir, shell.Mkdir, shell.Chmod, shell.Remove, Filesystem.Write/WriteOwnerOnly, and shell.Stat.ModeOf have no mock_response on the file-effect path (WriteOwnerOnly uses the v1 file transport, not shell.Exec mock), so hermetic discovery refuses this file; it is excluded from discovery (gunbc.ci.ci_layer_roots witness_exclusion_frontier) and enrolled in bin_witness_wet_entries. Local recipe: claim_batch --wet --source-root dag --source-root src/v2 --entry dag/test/claim/materialized_ssh_key_file_real_execution_witness.dag --functions witness_ssh_key_bracket_write_owner_only_shreds_and_not_under_target"

fn stat_octal_mode(path: String) -> String {
  let result = shell.Stat.ModeOf(path: path as FilePath)
  trim(result.stdout)
}

test fn witness_ssh_key_bracket_write_owner_only_shreds_and_not_under_target() -> Bool {
  let identity = "witness-bracket-key" as PathSegment
  let secret = "synthetic-ssh-private-key-material" as Secret
  let outcome = with_private_secret_file(
    file_name: identity,
    content: secret,
    use: fn(key_path) {
      let path = key_path as String
      let dir = replace(s: path, from: "/witness-bracket-key", to: "")
      if stat_octal_mode(path: path) == "600"
        && stat_octal_mode(path: dir) == "700"
        && !string_contains(s: path, pattern: "target/") {
        path
      } else {
        ""
      }
    },
  )
  match outcome {
    PrivateSecretFileCompleted { value: key_path } =>
      key_path != ""
        && !shell.Test.IsFile(path: key_path as FilePath).is_file
        && !shell.Test.IsDirectory(path: replace(s: key_path, from: "/witness-bracket-key", to: "") as FilePath).is_directory
    PrivateSecretFileCompletedResidueRemains { value: _ } => false
    PrivateSecretFileNotEntered { cause: _ } => false
    PrivateSecretFileNotEnteredResidueRemains { cause: _ } => false
  }
}

test fn witness_write_owner_only_refuses_when_path_already_exists() -> Bool {
  let dir = shell.Mktemp.Dir()
  if !dir.success {
    false
  } else {
    let root = dir.path as FilePath
    if !ensure_gunbc_private_materialization_dir(root: root) {
      false
    } else {
      let private_dir = gunbc_private_materialization_dir(root: root)
      let key_path = concat(
        concat(private_dir as String, "/"),
        "witness-preexist-key",
      )
      let stale = Filesystem.Write(path: key_path, content: "stale-key-bytes")
      let owner_only = Filesystem.WriteOwnerOnly(path: key_path, content: "fresh-key-bytes")
      let cleaned = shell.Remove.RecursiveForce(path: root)
      stale.success && !owner_only.success && cleaned.success
    }
  }
}
