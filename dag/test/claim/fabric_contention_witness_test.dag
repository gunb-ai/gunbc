module test.claim.fabric_contention_witness_test

// THE SUBJECT IS WHICH DEMAND WINS ONE SCARCE OFFER, which nothing in the
// fabric could answer before product.fabric.contention. A suite that only
// proved a winner comes back would establish that the fold returns something,
// which was never in doubt. What is in doubt, and what each witness below
// isolates, is that the answer is DERIVED from the pair rather than declared by
// the buyer, that it cannot be reached at all by a demand that did not clear
// the price, that it is invariant under the order candidates arrive in, and
// that every case the policy genuinely cannot decide refuses instead of
// returning a plausible one.

import std.nat { Nat }
import std.types { Bool, List, NonEmptyStr }
import std.currency { Usd }
import std.measure {
  MoneyAmountMicro, MoneyPerSecond, MoneyPerHour, MoneyOnce, Second,
  money_amount_micro, money_amount_micro_count, second, second_count,
  hardware_thread_count, HardwareThreadCount,
}
import product.fabric.identity { FabricIdentity, DemandKey, OfferKey }
import product.fabric.work { Shape, HardRequirements, CapabilityManifestRef, TrustDomainRef }
import product.fabric.envelope { unstated_envelope }
import product.fabric.isolation { current_runner_slot_profile }
import product.fabric.demand {
  Demand, AdmissionTerms, BuyTerms, SatisfactionRequirement, ObservationReceiptRef,
}
import product.fabric.supply {
  SupplierOffer, OfferQuote, QuotedPerSecond, QuotedPerHour, QuotedFlatPerGrant, ObservedSupply,
  GrantDuration, ExactGrantDuration, EstimatedGrantDuration,
  UnobservedGrantDuration,
  DemandOfferAffordability, Affordable, AffordableUnderEstimate,
  QuoteExceedsMaximumBuyOrder, QuoteCurrencyMismatch,
}
import product.fabric.contention {
  AdmittedDemand, DemandAdmission, DemandAdmitted, DemandNotAffordable,
  QuoteExceedsReservationPrice, GrantOccupiesNoBilledTime,
  DemandNotRankableWithoutDuration,
  ContentionOutcome, NoAdmissibleDemand, DemandSelected, ContentionRefused,
  OccupancyBasis, MeasuredOccupancy, ProjectedOccupancy,
  occupancy_basis_meet, occupancy_basis_bounded_lattice,
  admitted_occupancy_basis,
  ContentionRefusal, DemandsIndistinguishable, DuplicateCandidateIdentity,
  CandidatesJudgedAgainstDifferentOffers, OrderingContingentOnUnreadOpportunityCost,
  admit_demand_for_offer, admit_priced_pair, select_demand_for_offer,
  admitted_buyer_headroom, admitted_billed_occupancy, admitted_identity,
}

fn c_offer(key: NonEmptyStr, quote: OfferQuote, quantum: Second) -> SupplierOffer<NonEmptyStr> {
  SupplierOffer {
    id: FabricIdentity { principal: "gunbc", key: key },
    executor: "gunbc",
    shape: Shape {
      hard: HardRequirements { threads: hardware_thread_count(count: 8) },
      envelope: unstated_envelope(),
    },
    capabilities: "gunbc.capabilities.linux-rust-toolchain",
    trust_domain: "gunbc.trust.internal-fleet",
    isolation: current_runner_slot_profile(),
    quantity_bound: 1,
    ready_at: "2026-08-27T00:00:00Z",
    quote: quote,
    billing_quantum: quantum,
    evidence: ObservedSupply {
      observed_at: "2026-08-27T00:00:00Z",
      receipt: "gunbc.observation.fleet-1",
    },
  }
}

// Continuous owned capacity: one micro per second, no quantum, so the bill is
// the seconds used.
fn continuous_offer() -> SupplierOffer<NonEmptyStr> {
  c_offer(
    key: "offer-owned",
    quote: QuotedPerSecond(MoneyPerSecond { amount: money_amount_micro(count: 1), currency: Usd }),
    quantum: second(count: 0),
  )
}

// A rented hourly supplier: one hundred micros an hour, billed in whole hours
// rounded up, so any job under an hour costs a full hour.
fn hourly_offer() -> SupplierOffer<NonEmptyStr> {
  c_offer(
    key: "offer-hetzner",
    quote: QuotedPerHour(MoneyPerHour { amount: money_amount_micro(count: 100), currency: Usd }),
    quantum: second(count: 3600),
  )
}

fn c_demand(key: DemandKey, reservation: Nat) -> Demand<NonEmptyStr> {
  Demand {
    id: FabricIdentity { principal: "operator", key: key },
    work: FabricIdentity { principal: "operator", key: "work-1" },
    origin: "gunbc.observation.pr-1",
    submitted_at: "2026-08-27T00:00:00Z",
    admission: AdmissionTerms {
      deadline: none,
      buy: BuyTerms {
        budget_account: "fleet-ci",
        currency: Usd,
        reservation_price: money_amount_micro(count: reservation),
        maximum_buy_order: money_amount_micro(count: 1000),
      },
    },
    satisfaction: SatisfactionRequirement {
      terminal_receipt_may_satisfy: true,
      new_attempt_required: false,
      step_reuse_permitted: true,
    },
  }
}

// THE TWO BIDDERS THE MODE WITNESS TURNS ON. Short is a ninety-second job that
// will pay up to 200; long is a five-minute job that will pay up to 400.
fn short_demand() -> Demand<NonEmptyStr> { c_demand(key: "demand-short", reservation: 200) }

fn long_demand() -> Demand<NonEmptyStr> { c_demand(key: "demand-long", reservation: 400) }

fn short_duration() -> GrantDuration { ExactGrantDuration { seconds: second(count: 90) } }

fn long_duration() -> GrantDuration { ExactGrantDuration { seconds: second(count: 300) } }

fn unobserved_duration() -> GrantDuration {
  UnobservedGrantDuration {
    obligation: "Nobody has measured how long this job runs. Time it, or bound it, before asking the fabric to rank it against another buyer.",
  }
}

// AN UNMEASURED JOB IS REFUSED, NOT RANKED, AND THE REFUSAL CARRIES THE REMEDY.
//
// This is the executing evidence for the arm gunbc#9397 forced. The
// discriminating input is the duration: hold the demand and the offer fixed at
// the values that admit under short_duration -- proven by the positive control
// below -- and swap only the duration for an unobserved one. If the refusal
// ever regresses to a substituted number, this flips.
//
// WHICH OBLIGATION ARRIVES IS ASSERTED, NOT JUST THE VARIANT, and it is not the
// one this fixture authored. That is the point of pinning it.
//
// Two obligations exist for this call: the one carried on the duration itself
// (unobserved_duration below, naming the job to measure) and the one supply.dag
// raises when a RATE quote cannot be totalled without a duration. The second is
// what reaches the caller, because the affordability screen prices the quote
// before anything looks at the duration's own text, and the refusal is
// constructed from the quote's failure.
//
// THIS WITNESS WAS AUTHORED ASSERTING THE OTHER ONE AND WENT RED, which is the
// only reason the precedence is written down. A variant-only assertion would
// have passed either way and left a reader to assume the duration's obligation
// survives. It does not, and a caller building a remediation message from this
// refusal gets "measure the running time", never "measure THIS job".
test fn an_unobserved_duration_refuses_to_rank_rather_than_substituting_a_number() -> Bool {
  match admit_demand_for_offer(
    demand: short_demand(),
    offer: hourly_offer(),
    duration: unobserved_duration(),
  ) {
    DemandNotRankableWithoutDuration { obligation: why } =>
      why == "A rate quote cannot be totalled over an unobserved grant duration. Measure the work's running time, or bound it, before asking this quote for a per-grant total."
    DemandAdmitted { admitted: _ } => false
    DemandNotAffordable { refusal: _ } => false
    QuoteExceedsReservationPrice { quoted: _, reservation: _ } => false
    GrantOccupiesNoBilledTime { duration: _ } => false
  }
}

// THE POSITIVE CONTROL, AND IT IS WHAT MAKES THE WITNESS ABOVE DISCRIMINATING
// RATHER THAN MERELY GREEN. Without it, the refusal is equally consistent with
// this demand/offer pair being unrankable for some unrelated reason -- an
// affordability screen, a reservation ceiling -- and the witness would pass
// while proving nothing about the duration. The two differ in exactly one
// argument.
test fn the_same_pair_admits_once_the_duration_is_measured() -> Bool {
  match admit_demand_for_offer(
    demand: short_demand(),
    offer: hourly_offer(),
    duration: short_duration(),
  ) {
    DemandAdmitted { admitted: _ } => true
    DemandNotRankableWithoutDuration { obligation: _ } => false
    DemandNotAffordable { refusal: _ } => false
    QuoteExceedsReservationPrice { quoted: _, reservation: _ } => false
    GrantOccupiesNoBilledTime { duration: _ } => false
  }
}

// THE QUIET GUARD IS CALLED, SO IT CANNOT DECAY INTO A DECORATION.
//
// admit_priced_pair carries two refusal arms for an unobserved duration that its
// only production caller cannot reach, because admit_demand_for_offer screens
// affordability first. Review of gunbc#9492 confirmed those arms are a healthy
// guard being quiet rather than a decoration -- the mechanism is live in
// supply.dag and the join is reachable -- and then made the sharper point: the
// same argument that saves them makes their evidence ENROLLABLE, and a claim
// carried only by a comment is a claim no Accepted program can read (DESIGN
// section 4c).
//
// THE STATE NEITHER ARGUMENT COVERED IS DRIFT. Both of us reasoned about the
// shape as authored. A later refactor that makes the arm genuinely unreachable
// would break nothing, and the comment asserting reachability would quietly
// become false -- the decoration state arrived at by decay rather than by
// construction. This witness IS the second caller the comment says is one edit
// away, so that decay fails here instead of going unnoticed.
test fn the_ranked_fold_refuses_an_unobserved_duration_on_its_own_signature() -> Bool {
  match admit_priced_pair(
    demand: short_demand(),
    offer: hourly_offer(),
    duration: unobserved_duration(),
    affordability: Affordable,
  ) {
    DemandNotRankableWithoutDuration { obligation: _ } => true
    DemandAdmitted { admitted: _ } => false
    DemandNotAffordable { refusal: _ } => false
    QuoteExceedsReservationPrice { quoted: _, reservation: _ } => false
    GrantOccupiesNoBilledTime { duration: _ } => false
  }
}

// THE POSITIVE CONTROL FOR THE FOLD ITSELF, differing in exactly one argument.
// Without it the refusal above is equally consistent with admit_priced_pair
// refusing this pair for an unrelated reason, and the witness would pass while
// proving nothing about the duration.
test fn the_ranked_fold_admits_the_same_pair_once_the_duration_is_measured() -> Bool {
  match admit_priced_pair(
    demand: short_demand(),
    offer: hourly_offer(),
    duration: short_duration(),
    affordability: Affordable,
  ) {
    DemandAdmitted { admitted: _ } => true
    DemandNotRankableWithoutDuration { obligation: _ } => false
    DemandNotAffordable { refusal: _ } => false
    QuoteExceedsReservationPrice { quoted: _, reservation: _ } => false
    GrantOccupiesNoBilledTime { duration: _ } => false
  }
}

fn admitted_or_none(a: DemandAdmission<NonEmptyStr>) -> List<AdmittedDemand<NonEmptyStr>> {
  match a {
    DemandAdmitted { admitted: x } => [x]
    DemandNotAffordable { refusal: _ } => []
    QuoteExceedsReservationPrice { quoted: _, reservation: _ } => []
    GrantOccupiesNoBilledTime { duration: _ } => []
    DemandNotRankableWithoutDuration { obligation: _ } => []
  }
}

fn id_key(i: FabricIdentity<NonEmptyStr, DemandKey>) -> NonEmptyStr {
  i.key as NonEmptyStr
}

fn winner_key(o: ContentionOutcome<NonEmptyStr>) -> NonEmptyStr {
  match o {
    DemandSelected { winner: w, basis: _ } => id_key(i: admitted_identity(a: w))
    NoAdmissibleDemand => "none" as NonEmptyStr
    ContentionRefused { refusal: _ } => "refused" as NonEmptyStr
  }
}

fn contend(
  offer: SupplierOffer<NonEmptyStr>,
  candidates: List<AdmittedDemand<NonEmptyStr>>,
) -> ContentionOutcome<NonEmptyStr> {
  select_demand_for_offer(contended: offer.id, candidates: candidates)
}

fn field_against(offer: SupplierOffer<NonEmptyStr>) -> List<AdmittedDemand<NonEmptyStr>> {
  concat(
    admitted_or_none(a: admit_demand_for_offer(
      demand: short_demand(), offer: offer, duration: short_duration())),
    admitted_or_none(a: admit_demand_for_offer(
      demand: long_demand(), offer: offer, duration: long_duration())),
  )
}

// THE MODE WITNESS, AND IT IS THE ONE THAT WOULD GO RED IF THE RANKING WERE
// SCORED ON THE DEMAND ALONE.
//
// Two bidders, two suppliers, one rate structure each. On continuous owned
// capacity the short job is billed the 90 seconds it uses (headroom 200-90=110)
// and the long job the 300 it uses (400-300=100), so the SHORT job wins. On the
// hourly supplier both are billed one whole hour at 100 (headroom 100 and 300),
// so the LONG job wins. The same two demands rank in OPPOSITE orders against
// two offers.
//
// That flip is the entire argument for deriving the rank from the PAIR. Any
// design that gave a demand a standing priority -- a class string, an ordinal
// tier, a precomputed bid score -- would return one of these two answers for
// both suppliers and be silently wrong for the other, exactly in the cross-mode
// case the fleet is about to have. If offer_quoted_total_for_grant ever stopped
// seeing the billing quantum, both columns would collapse to the same winner
// and this goes red.
test fn the_same_two_bidders_rank_oppositely_on_continuous_and_hourly_supply() -> Bool {
  winner_key(o: contend(offer: continuous_offer(), candidates: field_against(offer: continuous_offer())))
    == "demand-short"
  && winner_key(o: contend(offer: hourly_offer(), candidates: field_against(offer: hourly_offer())))
    == "demand-long"
}

// THE HEADROOM IS DERIVED AGAINST THIS OFFER, NOT READ OFF THE POSTED BID. The long job posts
// the HIGHER reservation price on both suppliers and wins on only one of them,
// so the ordering cannot be reading the bid alone. This pins the arithmetic
// that separates them rather than only the verdict, because a verdict alone
// would still be produced by a fold that compared the wrong two numbers.
test fn buyer_headroom_is_the_ceiling_minus_the_projected_bill_for_this_offer() -> Bool {
  match field_against(offer: continuous_offer()) {
    Cons { head: s, tail: rest } =>
      match rest {
        Cons { head: l, tail: _ } =>
          money_amount_micro_count(m: admitted_buyer_headroom(a: s)) == 110
            && money_amount_micro_count(m: admitted_buyer_headroom(a: l)) == 100
            && second_count(s: admitted_billed_occupancy(a: s)) == 90
            && second_count(s: admitted_billed_occupancy(a: l)) == 300
        Empty {} => false
      }
    Empty {} => false
  }
}

// THE BILLED DENOMINATOR IS THE QUANTIZED ONE, AND THIS IS WHAT COLLAPSES THE
// RATE ORDERING ONTO THE TOTAL ORDERING UNDER AN HOURLY QUANTUM. The same two
// jobs that occupy 90 and 300 seconds of continuous capacity each occupy one
// whole billed hour of the hourly supplier, so their denominators are EQUAL and
// the comparator degenerates to comparing margins. If this ever reported the
// elapsed seconds instead, the hourly column of the two-mode witness would be
// decided by a rate nobody is billed for.
test fn an_hourly_quantum_gives_both_bidders_the_same_billed_occupancy() -> Bool {
  match field_against(offer: hourly_offer()) {
    Cons { head: s, tail: rest } =>
      match rest {
        Cons { head: l, tail: _ } =>
          second_count(s: admitted_billed_occupancy(a: s)) == 3600
            && second_count(s: admitted_billed_occupancy(a: l)) == 3600
        Empty {} => false
      }
    Empty {} => false
  }
}

// THE CASE THAT SEPARATES MARGIN FROM MARGIN-PER-SECOND, AND THE FIRST CUT OF
// THIS MODULE GOT IT WRONG.
//
// The two-mode witness above cannot decide between the two definitions, because
// its short job wins on BOTH -- 110 total against 100, and 1.22/s against
// 0.33/s. Agreement is not evidence, so this is the pair constructed to
// disagree: on continuous capacity a 90-second job earning 110 against a
// 300-second job earning 200. TOTAL margin says the long job (200 > 110).
// MARGIN PER BILLED SECOND says the short one (110/90 = 1.22 against 200/300 =
// 0.67), and the short one is right: continuous capacity is released the moment
// the grant ends, so taking the long job sells 300 seconds for 200 where the
// same 300 seconds could have sold the first 90 for 110 and still had 210 left
// to sell.
//
// Cross-multiplied, the comparison is 110*300 = 33000 against 200*90 = 18000,
// exactly and without rounding.
//
// SINCE THE CONTINGENT CASE NOW REFUSES, THE COMPARATOR'S ANSWER IS READ OFF
// THE REFUSAL rather than off a winner -- and it is still the discriminating
// evidence, because the refusal names WHICH candidate leads on rate. A
// comparator reverted to total margin would name demand-rich-slow there and
// this goes red exactly as before. The rate machinery did not become
// unobservable when it stopped selecting here; it moved into the payload.
//
// MEASURED, and RE-MEASURED, because an earlier revision of this note asserted
// the wrong number twice and the measurement is the only reason anyone knows.
// Forcing the comparator back to total headroom and re-running the whole suite
// against the CURRENT tree turns THREE witnesses red -- this one,
// a_free_offer_is_still_ranked_by_bid_per_second_not_by_bid, and
// a_contingent_ordering_refuses_and_names_both_candidates -- with the other
// eighteen green and the instrument control still false. The figure is stated
// with its subject (21 witnesses) because the previous figure in this slot,
// "two red, twelve green", was correct on a 14-witness tree and became
// unreadable the moment the tree grew: a count whose denominator is not written
// beside it cannot be compared with its own successor. Three independent
// witnesses over one comparator is stronger evidence than one, and the third
// only appeared because the contingent case moved its answer into the refusal
// payload -- the comparator is observable there too, which is exactly what that
// witness now proves. The point of recording it is that the count came from
// running the mutation, not from reasoning about which witness ought to notice.
fn rich_slow_demand() -> Demand<NonEmptyStr> { c_demand(key: "demand-rich-slow", reservation: 500) }

test fn a_larger_total_margin_loses_to_a_larger_margin_per_billed_second() -> Bool {
  let quick = admitted_or_none(a: admit_demand_for_offer(
    demand: short_demand(), offer: continuous_offer(), duration: short_duration()))
  let slow = admitted_or_none(a: admit_demand_for_offer(
    demand: rich_slow_demand(), offer: continuous_offer(), duration: long_duration()))
  match concat(quick, slow) {
    Cons { head: q, tail: rest } =>
      match rest {
        Cons { head: r, tail: _ } =>
          money_amount_micro_count(m: admitted_buyer_headroom(a: q)) == 110
            && money_amount_micro_count(m: admitted_buyer_headroom(a: r)) == 200
            && match contend(offer: continuous_offer(), candidates: concat(quick, slow)) {
                 ContentionRefused { refusal: rf } =>
                   match rf {
                     OrderingContingentOnUnreadOpportunityCost { leads_on_rate: lr, outbid_on_total: _ } =>
                       id_key(i: lr) == "demand-short"
                     DemandsIndistinguishable { tied: _ } => false
                     DuplicateCandidateIdentity { duplicated: _ } => false
                     CandidatesJudgedAgainstDifferentOffers { contended: _, mismatched: _ } => false
                   }
                 DemandSelected { winner: _, basis: _ } => false
                 NoAdmissibleDemand => false
               }
        Empty {} => false
      }
    Empty {} => false
  }
}

// UNDER AN HOURLY QUANTUM THE SAME PAIR FLIPS BACK, AND THAT IS THE POINT OF
// HAVING ONE DERIVATION RATHER THAN A MODE SWITCH.
//
// Those same two bidders on the hourly supplier both consume one whole billed
// hour, so the denominators cancel and the larger total margin wins -- which is
// correct there, because the supplier rounds up and the unused part of the hour
// is not resellable. Nothing in the policy branches on the quantum to get this;
// it falls out of billed_seconds being the denominator. A comparator that
// switched on billing mode would be a second authority for a fact the quantum
// already states, and it would agree with this one on exactly these two rows
// while being free to disagree on the next supplier.
test fn the_same_pair_flips_back_when_the_billed_hour_is_indivisible() -> Bool {
  let quick = admitted_or_none(a: admit_demand_for_offer(
    demand: short_demand(), offer: hourly_offer(), duration: short_duration()))
  let slow = admitted_or_none(a: admit_demand_for_offer(
    demand: rich_slow_demand(), offer: hourly_offer(), duration: long_duration()))
  winner_key(o: contend(offer: hourly_offer(), candidates: concat(quick, slow)))
    == "demand-rich-slow"
}

// THE PAID-THROUGH MODE: A ZERO QUOTE DOES NOT COLLAPSE THE RANKING TO RAW
// HIGHEST BID.
//
// An hour already bought is sunk, so its marginal cost for the remainder is
// zero, and the supply lane is making the quote reflect that. The exposure on
// this side is what the ranking does when the projected bill goes to zero for
// every candidate: the margin becomes the bid itself, and a comparator over
// TOTAL margin would degenerate to whoever posted the larger number regardless
// of how long they would hold the machine. It does not degenerate here, because
// the denominator survives -- the occupancy assertions below are what pin that,
// since a free offer with a collapsed denominator would rank on the bid alone.
//
// THIS WITNESS ABSORBED A SECOND ONE, and the merge is recorded rather than
// left to be noticed. a_zero_quote_ranks_by_bid_rate_and_the_larger_total_bid_loses
// asserted the same field: same offer, same two demands, the same margins and
// occupancies, and the same rate leader. Two witnesses over one field is the
// redundancy DESIGN section 2 prices, so its content lives here -- both margins,
// both billed occupancies, and the rate leader -- rather than in a near-copy.
// Nothing it asserted was dropped.
//
// WHAT IT ASSERTS NOW IS A REFUSAL, because the slow bidder's 500 margin is
// strictly larger than the quick bidder's 200 on an offer that costs nothing to
// run: the two orderings disagree, so which should win depends on whether the
// freed remainder can be resold. The rate comparator is still the discriminating
// evidence, read off leads_on_rate rather than off a winner.
fn paid_through_offer() -> SupplierOffer<NonEmptyStr> {
  c_offer(
    key: "offer-paid-through",
    quote: QuotedFlatPerGrant(MoneyOnce { amount: money_amount_micro(count: 0), currency: Usd }),
    quantum: second(count: 0),
  )
}

test fn a_free_offer_is_still_ranked_by_bid_per_second_not_by_bid() -> Bool {
  let quick = admitted_or_none(a: admit_demand_for_offer(
    demand: short_demand(), offer: paid_through_offer(), duration: short_duration()))
  let slow = admitted_or_none(a: admit_demand_for_offer(
    demand: rich_slow_demand(), offer: paid_through_offer(), duration: long_duration()))
  match concat(quick, slow) {
    Cons { head: q, tail: rest } =>
      match rest {
        Cons { head: r, tail: _ } =>
          money_amount_micro_count(m: admitted_buyer_headroom(a: q)) == 200
            && money_amount_micro_count(m: admitted_buyer_headroom(a: r)) == 500
            && second_count(s: admitted_billed_occupancy(a: q)) == 90
            && second_count(s: admitted_billed_occupancy(a: r)) == 300
            && match contend(offer: paid_through_offer(), candidates: concat(quick, slow)) {
                 ContentionRefused { refusal: rf } =>
                   match rf {
                     OrderingContingentOnUnreadOpportunityCost { leads_on_rate: lr, outbid_on_total: _ } =>
                       id_key(i: lr) == "demand-short"
                     DemandsIndistinguishable { tied: _ } => false
                     DuplicateCandidateIdentity { duplicated: _ } => false
                     CandidatesJudgedAgainstDifferentOffers { contended: _, mismatched: _ } => false
                   }
                 DemandSelected { winner: _, basis: _ } => false
                 NoAdmissibleDemand => false
               }
        Empty {} => false
      }
    Empty {} => false
  }
}

// A GRANT THAT BILLS NO TIME REFUSES RATHER THAN JOINING THE FIELD. Every
// zero-occupancy candidate cross-multiplies to zero against every other, so
// admitting one would report a field of perfectly distinguishable buyers as an
// unresolvable tie -- a fabricated verdict, not a cautious one.
test fn a_grant_billing_no_time_is_refused_rather_than_ranked_at_zero() -> Bool {
  match admit_demand_for_offer(
    demand: short_demand(),
    offer: continuous_offer(),
    duration: ExactGrantDuration { seconds: second(count: 0) },
  ) {
    GrantOccupiesNoBilledTime { duration: d } => second_count(s: d) == 0
    DemandAdmitted { admitted: _ } => false
    DemandNotAffordable { refusal: _ } => false
    QuoteExceedsReservationPrice { quoted: _, reservation: _ } => false
    DemandNotRankableWithoutDuration { obligation: _ } => false
  }
}

// THE SAME DEMAND TWICE REFUSES. The tie sweep excludes the leader by identity,
// which is the only honest way to say "not itself", so a duplicated candidate
// is excluded as though it were the leader and its perfect tie goes unreported
// -- first-one-wins reappearing inside the pass written to remove it. Refusing
// also refuses what a duplicate actually means: one demand admitted twice
// against one grant of capacity.
test fn the_same_demand_admitted_twice_refuses_rather_than_winning_against_itself() -> Bool {
  let once = admitted_or_none(a: admit_demand_for_offer(
    demand: short_demand(), offer: continuous_offer(), duration: short_duration()))
  match contend(offer: continuous_offer(), candidates: concat(once, once)) {
    ContentionRefused { refusal: r } =>
      match r {
        DuplicateCandidateIdentity { duplicated: d } => (d |> count) == 2
        DemandsIndistinguishable { tied: _ } => false
        CandidatesJudgedAgainstDifferentOffers { contended: _, mismatched: _ } => false
        OrderingContingentOnUnreadOpportunityCost { leads_on_rate: _, outbid_on_total: _ } => false
      }
    DemandSelected { winner: _, basis: _ } => false
    NoAdmissibleDemand => false
  }
}

// ORDER INVARIANCE. The leader fold keeps its incumbent on a tie, so a suite
// that only ever presented candidates in one order could not tell a real
// ordering from first-one-wins. Presenting the same field reversed must return
// the same winner.
test fn the_winner_does_not_depend_on_the_order_candidates_arrive_in() -> Bool {
  let forward = field_against(offer: continuous_offer())
  let reversed = concat(
    admitted_or_none(a: admit_demand_for_offer(
      demand: long_demand(), offer: continuous_offer(), duration: long_duration())),
    admitted_or_none(a: admit_demand_for_offer(
      demand: short_demand(), offer: continuous_offer(), duration: short_duration())),
  )
  winner_key(o: contend(offer: continuous_offer(), candidates: forward))
    == winner_key(o: contend(offer: continuous_offer(), candidates: reversed))
  && winner_key(o: contend(offer: continuous_offer(), candidates: reversed)) == "demand-short"
}

// A TIE REFUSES RATHER THAN PICKING ONE. Two demands with identical reservation
// prices and identical durations have identical margins, and every tie-break
// the model could reach for today -- submitted_at, the demand key -- is string
// collation wearing a schedule's or a merit's name. The refusal names both
// demands so the caller can decide something this policy cannot.
test fn two_indistinguishable_bidders_refuse_instead_of_one_winning_silently() -> Bool {
  let a = admitted_or_none(a: admit_demand_for_offer(
    demand: c_demand(key: "demand-a", reservation: 200),
    offer: continuous_offer(), duration: short_duration()))
  let b = admitted_or_none(a: admit_demand_for_offer(
    demand: c_demand(key: "demand-b", reservation: 200),
    offer: continuous_offer(), duration: short_duration()))
  match contend(offer: continuous_offer(), candidates: concat(a, b)) {
    ContentionRefused { refusal: r } =>
      match r {
        DemandsIndistinguishable { tied: t } => (t |> count) == 2
        DuplicateCandidateIdentity { duplicated: _ } => false
        CandidatesJudgedAgainstDifferentOffers { contended: _, mismatched: _ } => false
        OrderingContingentOnUnreadOpportunityCost { leads_on_rate: _, outbid_on_total: _ } => false
      }
    DemandSelected { winner: _, basis: _ } => false
    NoAdmissibleDemand => false
  }
}

// THE PRIVILEGE ESCAPE HAS NO SPELLING. A demand whose bid is below the bill
// never becomes a candidate at all: admit_demand_for_offer returns a refusal,
// AdmittedDemand is sole_constructor with no other route, and so there is no
// value a caller could hand to select_demand_for_offer that represents an
// unaffordable demand. This is the claim that used to be a prose note beside a
// string field, and the string witness beside it could not have gone red for
// it.
//
// The pair is discriminating in the way that matters: the SAME demand at the
// SAME price is admitted against the cheap supplier and refused against the
// expensive one, so the refusal is arithmetic about the pair and not a property
// of the demand.
test fn a_bid_below_the_bill_cannot_enter_contention_at_all() -> Bool {
  let poor = c_demand(key: "demand-poor", reservation: 95)
  let against_cheap = admit_demand_for_offer(
    demand: poor, offer: continuous_offer(), duration: short_duration())
  let against_hourly = admit_demand_for_offer(
    demand: poor, offer: hourly_offer(), duration: short_duration())
  match against_cheap {
    DemandAdmitted { admitted: _ } =>
      match against_hourly {
        QuoteExceedsReservationPrice { quoted: q, reservation: r } =>
          money_amount_micro_count(m: q) == 100
            && money_amount_micro_count(m: r) == 95
            && (admitted_or_none(a: against_hourly) |> count) == 0
        DemandAdmitted { admitted: _ } => false
        DemandNotAffordable { refusal: _ } => false
        GrantOccupiesNoBilledTime { duration: _ } => false
        DemandNotRankableWithoutDuration { obligation: _ } => false
      }
    DemandNotAffordable { refusal: _ } => false
    QuoteExceedsReservationPrice { quoted: _, reservation: _ } => false
    GrantOccupiesNoBilledTime { duration: _ } => false
    DemandNotRankableWithoutDuration { obligation: _ } => false
  }
}

// THE RESERVATION PRICE IS A SECOND CEILING, AND IT IS THIS MODULE'S. The demand
// above clears its maximum_buy_order of 1000 comfortably -- supply.dag's
// affordability screen says Affordable -- and is still refused, because 100
// exceeds the 50 the buyer said it would pay. Before this module nothing
// consulted reservation_price at all, so an offer could be "affordable" under a
// generous per-grant ceiling while sitting above the price the buyer named.
test fn clearing_the_grant_ceiling_is_not_clearing_the_buyers_own_price() -> Bool {
  match admit_demand_for_offer(
    demand: c_demand(key: "demand-ceiling", reservation: 50),
    offer: hourly_offer(),
    duration: short_duration(),
  ) {
    QuoteExceedsReservationPrice { quoted: _, reservation: _ } => true
    DemandAdmitted { admitted: _ } => false
    DemandNotAffordable { refusal: _ } => false
    GrantOccupiesNoBilledTime { duration: _ } => false
    DemandNotRankableWithoutDuration { obligation: _ } => false
  }
}

// HEADROOM DERIVED AGAINST A DIFFERENT OFFER REFUSES. Headroom is a fact about a
// pair, so a field mixing candidates judged against two suppliers holds values
// that are each individually true and are not comparable. The mint records the
// offer it judged, which is what gives this check something to check.
test fn a_field_judged_against_two_offers_refuses_rather_than_comparing() -> Bool {
  let owned = admitted_or_none(a: admit_demand_for_offer(
    demand: short_demand(), offer: continuous_offer(), duration: short_duration()))
  let rented = admitted_or_none(a: admit_demand_for_offer(
    demand: long_demand(), offer: hourly_offer(), duration: long_duration()))
  match contend(offer: continuous_offer(), candidates: concat(owned, rented)) {
    ContentionRefused { refusal: r } =>
      match r {
        CandidatesJudgedAgainstDifferentOffers { contended: _, mismatched: m } => (m |> count) == 1
        DemandsIndistinguishable { tied: _ } => false
        DuplicateCandidateIdentity { duplicated: _ } => false
        OrderingContingentOnUnreadOpportunityCost { leads_on_rate: _, outbid_on_total: _ } => false
      }
    DemandSelected { winner: _, basis: _ } => false
    NoAdmissibleDemand => false
  }
}

// NOTHING ADMISSIBLE IS AN OUTCOME, NOT A REFUSAL. Capacity going unsold is an
// ordinary market result whose remedy is more demand or a cheaper offer;
// collapsing it into the refusal arm would hand a caller a diagnostic for a
// working market.
test fn an_empty_field_reports_no_admissible_demand_rather_than_refusing() -> Bool {
  match contend(offer: continuous_offer(), candidates: []) {
    NoAdmissibleDemand => true
    DemandSelected { winner: _, basis: _ } => false
    ContentionRefused { refusal: _ } => false
  }
}

// THE DEFECT THIS PAIR EXISTS FOR: OCCUPANCY PROVENANCE READ FROM THE WRONG
// AUTHORITY.
//
// An earlier cut inferred whether the denominator was projected from the
// AFFORDABILITY verdict. This is the pair that catches it. Both demands carry
// an ESTIMATED duration, so both denominators are projected. The first is
// quoted per second, so affordability answers AffordableUnderEstimate and the
// old inference happened to be right. The second is quoted FLAT PER GRANT,
// where affordability correctly answers plain Affordable -- a flat quote does
// not depend on how long the grant runs -- while the occupancy denominator
// still does. Under the old inference that second demand reported a MEASURED
// basis over a projected denominator.
//
// Both must report ProjectedOccupancy, and the flat-quote one is the arm that
// goes red if provenance is ever read off affordability again.
fn per_second_offer() -> SupplierOffer<NonEmptyStr> {
  c_offer(
    key: "offer-per-second",
    quote: QuotedPerSecond(MoneyPerSecond { amount: money_amount_micro(count: 1), currency: Usd }),
    quantum: second(count: 0),
  )
}

fn flat_offer() -> SupplierOffer<NonEmptyStr> {
  c_offer(
    key: "offer-flat",
    quote: QuotedFlatPerGrant(MoneyOnce { amount: money_amount_micro(count: 50), currency: Usd }),
    quantum: second(count: 0),
  )
}

fn estimated_short() -> GrantDuration { EstimatedGrantDuration { seconds: second(count: 90) } }

fn basis_is_projected(b: OccupancyBasis) -> Bool {
  match b {
    ProjectedOccupancy => true
    MeasuredOccupancy => false
  }
}

test fn an_estimated_duration_projects_the_denominator_even_when_affordability_is_certain() -> Bool {
  match admitted_or_none(a: admit_demand_for_offer(
    demand: short_demand(), offer: per_second_offer(), duration: estimated_short())) {
    Cons { head: metered, tail: _ } =>
      match admitted_or_none(a: admit_demand_for_offer(
        demand: short_demand(), offer: flat_offer(), duration: estimated_short())) {
        Cons { head: flat, tail: _ } =>
          basis_is_projected(b: admitted_occupancy_basis(a: metered))
            && basis_is_projected(b: admitted_occupancy_basis(a: flat))
        Empty {} => false
      }
    Empty {} => false
  }
}

// AN EXACT DURATION IS THE POSITIVE CONTROL. Without it the witness above is
// satisfied by a function that answers ProjectedOccupancy unconditionally,
// which would be permanently green and carry no information.
test fn an_exact_duration_reports_a_measured_denominator() -> Bool {
  match admitted_or_none(a: admit_demand_for_offer(
    demand: short_demand(), offer: per_second_offer(), duration: short_duration())) {
    Cons { head: a, tail: _ } => !basis_is_projected(b: admitted_occupancy_basis(a: a))
    Empty {} => false
  }
}

// THE VERDICT'S BASIS IS THE FIELD'S, NOT THE WINNER'S, AND THIS IS THE CASE
// WHERE THEY DISAGREE. The winner carries an EXACT duration and beats a rival
// whose denominator was projected, so the ORDERING rested on a projection even
// though the selected demand did not. A consumer reading the winner's own basis
// would read this decision as measured; the outcome reports it as projected.
test fn a_selection_decided_against_a_projected_rival_reports_a_projected_basis() -> Bool {
  let exact_winner = admitted_or_none(a: admit_demand_for_offer(
    demand: short_demand(), offer: continuous_offer(), duration: short_duration()))
  let estimated_rival = admitted_or_none(a: admit_demand_for_offer(
    demand: long_demand(), offer: continuous_offer(),
    duration: EstimatedGrantDuration { seconds: second(count: 300) }))
  match contend(offer: continuous_offer(), candidates: concat(exact_winner, estimated_rival)) {
    DemandSelected { winner: w, basis: b } =>
      id_key(i: admitted_identity(a: w)) == "demand-short"
        && !basis_is_projected(b: admitted_occupancy_basis(a: w))
        && basis_is_projected(b: b)
    NoAdmissibleDemand => false
    ContentionRefused { refusal: _ } => false
  }
}

// AND AN ALL-EXACT FIELD REPORTS MEASURED, so the witness above is not
// satisfied by a fold that answers ProjectedOccupancy for every field.
test fn a_field_of_exact_durations_reports_a_measured_basis() -> Bool {
  match contend(offer: continuous_offer(), candidates: field_against(offer: continuous_offer())) {
    DemandSelected { winner: _, basis: b } => !basis_is_projected(b: b)
    NoAdmissibleDemand => false
    ContentionRefused { refusal: _ } => false
  }
}

// THE CONTINGENT ORDERING REFUSES, AND THE UNCONTESTED ONE STILL SELECTS.
// THAT PAIR IS THE WHOLE CLAIM.
//
// An earlier cut of these two witnesses asserted that a contingent field
// SELECTS and annotates the verdict. Review 56522 objected that reporting
// uncertainty is not fail-closed, and the arm is now a refusal, so the second
// witness asserts the opposite of what it once did. It is rewritten rather than
// deleted because the pair is what makes either half informative.
//
// UNCONTESTED STILL SELECTS, and this half refutes the objection I raised
// against refusing at all -- that it would refuse everything, since the
// opportunity-cost fact is absent always. It is absent always and it only
// MATTERS when the orderings disagree. Here they agree: on continuous capacity
// the short job leads on rate (110/90 against 100/300) AND on total (110
// against 100), so no opportunity-cost fact could change the winner and the
// fold answers unconditionally. If refusal ever widened to this case, the
// policy would have stopped being able to decide anything.
test fn a_winner_that_also_leads_on_total_margin_is_selected_unconditionally() -> Bool {
  match contend(offer: continuous_offer(), candidates: field_against(offer: continuous_offer())) {
    DemandSelected { winner: w, basis: _ } => id_key(i: admitted_identity(a: w)) == "demand-short"
    NoAdmissibleDemand => false
    ContentionRefused { refusal: _ } => false
  }
}

// AND THE CONTESTED HALF REFUSES, NAMING BOTH ANSWERS. On the free offer the
// quick bidder leads on rate (200/90 against 500/300) while the slow bidder's
// 500 margin is strictly larger, so which one should win depends on whether the
// freed remainder can be resold -- a fact nothing in this model states.
//
// The refusal names the rate leader AND who would have taken it on totals,
// because a caller that can answer the missing question needs both candidates
// to act on it; a bare "cannot decide" would make the caller re-derive the
// field this fold already ranked. product.fabric.supply made the same call for
// the same reason, declining to become a selector on these missing inputs and
// saying so in its own header.
test fn a_contingent_ordering_refuses_and_names_both_candidates() -> Bool {
  let quick = admitted_or_none(a: admit_demand_for_offer(
    demand: short_demand(), offer: paid_through_offer(), duration: short_duration()))
  let slow = admitted_or_none(a: admit_demand_for_offer(
    demand: rich_slow_demand(), offer: paid_through_offer(), duration: long_duration()))
  match contend(offer: paid_through_offer(), candidates: concat(quick, slow)) {
    ContentionRefused { refusal: r } =>
      match r {
        OrderingContingentOnUnreadOpportunityCost { leads_on_rate: lr, outbid_on_total: o } =>
          id_key(i: lr) == "demand-short"
            && (o |> count) == 1
            && match o {
                 Cons { head: h, tail: _ } => id_key(i: h) == "demand-rich-slow"
                 Empty {} => false
               }
        DemandsIndistinguishable { tied: _ } => false
        DuplicateCandidateIdentity { duplicated: _ } => false
        CandidatesJudgedAgainstDifferentOffers { contended: _, mismatched: _ } => false
      }
    DemandSelected { winner: _, basis: _ } => false
    NoAdmissibleDemand => false
  }
}

// THE LATTICE'S BOTTOM IS FAIL-CLOSED, AND THIS PINS THE ORIENTATION RATHER
// THAN ONLY THE FOLD THAT USES IT.
//
// field_occupancy_basis already witnesses the combination through the selection
// verdict, but only for the two orderings a field happens to produce. This
// asserts the meet's own law at every point: measured combines with measured to
// measured, and ANY projected member drags the result to projected regardless
// of which side it is on. Flipping top and bottom -- the one-character error
// that would let a field of one measured and one projected candidate report
// MEASURED -- turns this red, and the selection witnesses alone would catch it
// only in the orderings they happen to exercise.
test fn occupancy_evidence_degrades_to_the_weakest_member() -> Bool {
  match occupancy_basis_meet(a: MeasuredOccupancy, b: MeasuredOccupancy) {
    MeasuredOccupancy =>
      basis_is_projected(b: occupancy_basis_meet(a: MeasuredOccupancy, b: ProjectedOccupancy))
        && basis_is_projected(b: occupancy_basis_meet(a: ProjectedOccupancy, b: MeasuredOccupancy))
        && basis_is_projected(b: occupancy_basis_meet(a: ProjectedOccupancy, b: ProjectedOccupancy))
        && !basis_is_projected(b: occupancy_basis_bounded_lattice.top)
        && basis_is_projected(b: occupancy_basis_bounded_lattice.bottom)
    ProjectedOccupancy => false
  }
}
