module test.claim.jwt_oidc_claims_witness_test


data witness_purpose_note: String = "THESE MODULES HAD NO CONSUMER AT ALL, which is why their claims went unchecked long enough to encode one token as a specification. extdeps.auth.jwt, extdeps.auth.oidc and their codex composition typechecked, cited real RFCs, and were never executed by anything — the specification-without-execution tier exactly. A grep would have found the RFC numbers and concluded the modeling was grounded.\\n\\nSo this file is the first consumer, and it is written to go RED on the specific overclaims that were there rather than to restate the types. Each claim below names the wrong behaviour it discriminates against: mandatory registered claims, a normalized audience, an integer-only NumericDate, an unenforced colon rule, a provenance inference from URI shape, and required OIDC optional claims. Reverting any one of those corrections fails a claim here."

// THE CLAIM THAT WAS IMPOSSIBLE TO WRITE BEFORE. Every field of JwtRegisteredClaims was required, so a JWT carrying none of the registered claims — which RFC 7519 section 4.1 explicitly permits, since none of them are mandatory — could not be expressed at all. This constructs exactly that value. Under the previous shape this file would not compile, which is the sharpest available discrimination: the red is a type error, not a false assertion.
fn empty_registered_claims() -> extdeps.auth.jwt.JwtRegisteredClaims {
  extdeps.auth.jwt.JwtRegisteredClaims {
    issuer: none,
    subject: none,
    audience: none,
    expires_at: none,
    not_before: none,
    issued_at: none,
    jwt_id: none,
  }
}

test fn registered_claims_are_all_optional() -> Bool {
  let c = empty_registered_claims()
  match c.issuer {
    Present { value: _ } => false
    Absent =>
      match c.expires_at {
        Present { value: _ } => false
        Absent =>
          match c.jwt_id {
            Present { value: _ } => false
            Absent => true
          }
      }
  }
}

// THE COLON RULE IS NOW CHECKED, AND THE REFUSAL IS THE POINT. RFC 7519 section 2 requires that a StringOrURI containing a colon be a URI; the previous brand accepted any NonEmptyStr, so the rule was documented and unenforced.\n\nThe discriminating input is 9:30 — it contains a colon and its scheme position starts with a digit, which RFC 3986 forbids. A brand admits it silently. The decoder refuses it. The two positive cases bracket the refusal: a bare name with no colon is admissible and stays bare, and urn:openai:amr:passkey is admissible and decodes its scheme as urn, which extdeps.uri's closed scheme enum could not have represented.
test fn bare_string_without_colon_is_admitted() -> Bool {
  match jwt_string_or_uri_of_wire(raw: "pop" as std.types.NonEmptyStr) {
    StringOrUriRefused { raw: _, reason: _ } => false
    StringOrUriDecoded { value } =>
      match value {
        JwtUriString { value: _, scheme: _ } => false
        JwtBareString { value: v } => (v as String) == "pop"
      }
  }
}

test fn urn_scheme_is_admitted_and_decoded() -> Bool {
  match jwt_string_or_uri_of_wire(raw: "urn:openai:amr:passkey" as std.types.NonEmptyStr) {
    StringOrUriRefused { raw: _, reason: _ } => false
    StringOrUriDecoded { value } =>
      match value {
        JwtBareString { value: _ } => false
        JwtUriString { value: v, scheme } =>
          (scheme as String) == "urn"
            && (v as String) == "urn:openai:amr:passkey"
      }
  }
}

test fn colon_value_that_is_not_a_uri_is_refused() -> Bool {
  match jwt_string_or_uri_of_wire(raw: "9:30" as std.types.NonEmptyStr) {
    StringOrUriDecoded { value: _ } => false
    StringOrUriRefused { raw, reason: _ } => (raw as String) == "9:30"
  }
}

test fn string_or_uri_round_trips_to_its_wire_form() -> Bool {
  match jwt_string_or_uri_of_wire(raw: "https://auth.openai.com" as std.types.NonEmptyStr) {
    StringOrUriRefused { raw: _, reason: _ } => false
    StringOrUriDecoded { value } =>
      (jwt_string_or_uri_wire(value: value) as String) == "https://auth.openai.com"
  }
}

// THE SINGLE FORM AND THE ARRAY FORM ARE DIFFERENT VALUES, which is what normalizing aud to a list destroyed. RFC 7519 section 4.1.3 permits both, and a verifier re-serializing a token must emit the form it received or the signature stops covering the bytes.\n\nThe discrimination is structural: both audiences below project to the same one-element value list, so a claim written only against jwt_audience_values cannot tell them apart — and that is exactly the collapse the previous model performed at ingest. Matching the constructor distinguishes them, so the encoding survives.
fn single_audience() -> extdeps.auth.jwt.JwtAudience {
  extdeps.auth.jwt.JwtAudienceSingle { value: extdeps.auth.jwt.JwtBareString { value: "client-a" as std.types.NonEmptyStr } }
}

fn multiple_audience() -> extdeps.auth.jwt.JwtAudience {
  extdeps.auth.jwt.JwtAudienceMultiple {
    values: [extdeps.auth.jwt.JwtBareString { value: "client-a" as std.types.NonEmptyStr }],
  }
}

test fn audience_keeps_its_wire_encoding() -> Bool {
  let same_values = count(jwt_audience_values(audience: single_audience())) == 1
    && count(jwt_audience_values(audience: multiple_audience())) == 1
  let distinguishable = match single_audience() {
    JwtAudienceMultiple { values: _ } => false
    JwtAudienceSingle { value: _ } =>
      match multiple_audience() {
        JwtAudienceSingle { value: _ } => false
        JwtAudienceMultiple { values: _ } => true
      }
  }
  same_values && distinguishable
}

data numeric_date_note: String = "A FRACTIONAL NumericDate REFUSES INSTEAD OF ROUNDING. RFC 7519 section 2 admits non-integer values; an Int carrier silently rounds them, and rounding an expiry moves the instant the issuer named in one direction or the other without ever reporting that it did.\\n\\nThe positive claim pins the observed codex pair — iat and exp exactly 3600 seconds apart — so the arithmetic is still exercised on the case that actually occurs, and it compares through std.measure.Second rather than through a bare Int, so a lifetime returned in the wrong unit cannot satisfy it. The two negative claims are the discriminating ones: a fractional expiry produces a typed refusal where a truncating model would return a number and pass, and an expiry preceding issuance refuses where a clamp would report zero and look like an expired credential."

test fn whole_second_lifetime_is_exact() -> Bool {
  match numeric_date_lifetime(
    issued: extdeps.auth.jwt.NumericDateWholeSeconds { seconds: 1000000 },
    expires: extdeps.auth.jwt.NumericDateWholeSeconds { seconds: 1003600 },
  ) {
    LifetimeNotWholeSeconds { reason: _ } => false
    LifetimeExpiryPrecedesIssuance { issued_at: _, expires_at: _ } => false
    LifetimeWholeSeconds { seconds } =>
      second_count(s: seconds) == second_count(s: codex_id_token_observed_lifetime)
  }
}

test fn fractional_date_refuses_rather_than_rounding() -> Bool {
  match numeric_date_lifetime(
    issued: extdeps.auth.jwt.NumericDateWholeSeconds { seconds: 1000000 },
    expires: extdeps.auth.jwt.NumericDateFractionalSeconds {
      whole_seconds: 1003600,
      fractional_digits: "5" as std.types.NonEmptyStr,
    },
  ) {
    LifetimeWholeSeconds { seconds: _ } => false
    LifetimeExpiryPrecedesIssuance { issued_at: _, expires_at: _ } => false
    LifetimeNotWholeSeconds { reason: _ } => true
  }
}

test fn expiry_before_issuance_refuses_rather_than_clamping() -> Bool {
  match numeric_date_lifetime(
    issued: extdeps.auth.jwt.NumericDateWholeSeconds { seconds: 1003600 },
    expires: extdeps.auth.jwt.NumericDateWholeSeconds { seconds: 1000000 },
  ) {
    LifetimeWholeSeconds { seconds: _ } => false
    LifetimeNotWholeSeconds { reason: _ } => false
    LifetimeExpiryPrecedesIssuance { issued_at, expires_at } =>
      issued_at == 1003600 && expires_at == 1000000
  }
}

// THE URI ARM NAMES A SHAPE, NOT AN OWNER. RFC 8176 registers short names and says nothing about who may use a URI, so classifying every colon-bearing amr value as PRIVATE was an inference the specification does not license.\n\nAll four values observed in the codex token are decoded here through the shared StringOrURI rule: two registered short names and two URI-valued methods. The refusal case is the one the old local colon test could not produce — a colon-bearing value that is not a valid URI was previously filed as a vendor method, and is now refused.
fn amr_is_uri_valued(raw: std.types.NonEmptyStr) -> Bool {
  match oidc_amr_of_wire(raw: raw) {
    AmrRefused { raw: _, reason: _ } => false
    AmrDecoded { method } =>
      match method {
        AmrUriValuedMethod { value: _ } => true
        _ => false
      }
  }
}

fn amr_is_registered_pop(raw: std.types.NonEmptyStr) -> Bool {
  match oidc_amr_of_wire(raw: raw) {
    AmrRefused { raw: _, reason: _ } => false
    AmrDecoded { method } =>
      match method {
        AmrProofOfPossession => true
        _ => false
      }
  }
}

test fn observed_amr_values_decode_by_shape() -> Bool {
  count(codex_observed_id_token_amr_wire) == 4
    && amr_is_registered_pop(raw: "pop" as std.types.NonEmptyStr)
    && amr_is_uri_valued(raw: "urn:openai:amr:passkey" as std.types.NonEmptyStr)
    && amr_is_uri_valued(raw: "urn:openai:amr:google" as std.types.NonEmptyStr)
}

test fn unregistered_short_name_is_not_forced_into_the_uri_arm() -> Bool {
  match oidc_amr_of_wire(raw: "hwk" as std.types.NonEmptyStr) {
    AmrRefused { raw: _, reason: _ } => false
    AmrDecoded { method } =>
      match method {
        AmrUnregisteredName { name } => (name as String) == "hwk"
        _ => false
      }
  }
}

test fn malformed_colon_amr_refuses() -> Bool {
  match oidc_amr_of_wire(raw: "9:30" as std.types.NonEmptyStr) {
    AmrDecoded { method: _ } => false
    AmrRefused { raw, reason: _ } => (raw as String) == "9:30"
  }
}

// OIDC REQUIRES FIVE CLAIMS AND THE FIRST CUT REQUIRED ELEVEN. This constructs the minimal conforming ID Token: the five section-2 required claims present, and auth_time, nonce, acr, amr, azp, sid and every standard claim absent. None of those seven is universally required by any specification, and under the previous shape this value was unrepresentable.\n\nThe projection claim checks the direction that is safe — an ID Token's required core reads cleanly as RFC 7519 registered claims — while the reverse embedding, which is what the earlier model did, is what made the base type unable to describe a plain JWT.
fn minimal_id_token() -> extdeps.auth.oidc.OidcIdTokenClaims {
  extdeps.auth.oidc.OidcIdTokenClaims {
    issuer: extdeps.auth.jwt.JwtUriString {
      value: "https://auth.openai.com" as std.types.NonEmptyStr,
      scheme: "https" as std.types.NonEmptyStr,
    },
    subject: extdeps.auth.jwt.JwtBareString { value: "subject-identifier" as std.types.NonEmptyStr },
    audience: extdeps.auth.jwt.JwtAudienceSingle {
      value: extdeps.auth.jwt.JwtBareString { value: "client-a" as std.types.NonEmptyStr },
    },
    expires_at: extdeps.auth.jwt.NumericDateWholeSeconds { seconds: 1003600 },
    issued_at: extdeps.auth.jwt.NumericDateWholeSeconds { seconds: 1000000 },
    auth_time: none,
    nonce: none,
    acr: none,
    amr: none,
    azp: none,
    session_id: none,
    standard: extdeps.auth.oidc.OidcStandardClaims {
      email: none,
      email_verified: none,
      name: none,
    },
  }
}

test fn minimal_conforming_id_token_is_representable() -> Bool {
  let t = minimal_id_token()
  match t.auth_time {
    Present { value: _ } => false
    Absent =>
      match t.acr {
        Present { value: _ } => false
        Absent =>
          match t.session_id {
            Present { value: _ } => false
            Absent =>
              match t.standard.email_verified {
                Present { value: _ } => false
                Absent => true
              }
          }
      }
  }
}

test fn id_token_projects_onto_registered_claims() -> Bool {
  let r = oidc_id_token_registered_claims(claims: minimal_id_token())
  match r.issued_at {
    Absent => false
    Present { value: _ } =>
      match r.jwt_id {
        Present { value: _ } => false
        Absent => true
      }
  }
}

data observation_is_not_requirement_note: String = "THE PROFILE RECORDS PRESENCE; THE TYPE RECORDS OPTIONALITY, and this claim proves they are now separate rather than fused. Every claim the codex token was observed to carry is marked present in the profile, AND every one of those claims is optional in OidcIdTokenClaims — which is exactly the combination the previous model could not express, because it read observed presence as mandatory shape.\\n\\nThe minimal token above is the proof of the second half: it omits every claim this profile marks present and is still a well-typed ID Token. If any of those fields were re-required, that constructor stops compiling while this profile stays green — the two would have to be reconciled by hand, which is the fork this split removes."

fn profile_marks_present(claim: String) -> Bool {
  any(
    codex_observed_id_token_claim_profile,
    row => (row.claim as String) == claim && row.observed_present,
  )
}

test fn observed_presence_does_not_imply_required_shape() -> Bool {
  profile_marks_present(claim: "acr")
    && profile_marks_present(claim: "amr")
    && profile_marks_present(claim: "sid")
    && profile_marks_present(claim: "email")
    && !profile_marks_present(claim: "jti")
    && !profile_marks_present(claim: "nonce")
    && minimal_conforming_id_token_is_representable()
}

test fn jwt_oidc_claims_keystone_holds() -> Bool {
  registered_claims_are_all_optional()
    && bare_string_without_colon_is_admitted()
    && urn_scheme_is_admitted_and_decoded()
    && colon_value_that_is_not_a_uri_is_refused()
    && string_or_uri_round_trips_to_its_wire_form()
    && audience_keeps_its_wire_encoding()
    && whole_second_lifetime_is_exact()
    && fractional_date_refuses_rather_than_rounding()
    && expiry_before_issuance_refuses_rather_than_clamping()
    && observed_amr_values_decode_by_shape()
    && unregistered_short_name_is_not_forced_into_the_uri_arm()
    && malformed_colon_amr_refuses()
    && minimal_conforming_id_token_is_representable()
    && id_token_projects_onto_registered_claims()
    && observed_presence_does_not_imply_required_shape()
}
