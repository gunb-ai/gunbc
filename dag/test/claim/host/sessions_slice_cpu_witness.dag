module test.claim.host.sessions_slice_cpu_witness

import std.types { Bool, String, List, NonEmptyStr, Int }
import std.measure { byte_size, hardware_thread_count, hardware_thread_count_value }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import gunbc.fleet.fleet_host_identity { operator_host_srv1, operator_host_srv3 }
import gunbc.host.host_converge {
  SliceControlCaps,
  SliceControlUnit, SessionsSliceControl, UncappedSliceControl, SliceControlRefused,
  slice_control_units_for,
  sessions_slice_control_for,
}
import gunbc.host.host_axis_caps { slice_control_converge_stmts_for_unit }
import gunbc.shell_command_text { shell_command_text_of_stmts }

// Every claim is a function of declared rows; nothing reads the live tree.
data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn is_capped_sessions(u: SliceControlUnit) -> Bool {
  match u {
    SessionsSliceControl { caps: c, cpu_quota: t } => (c.unit as String) == "sessions.slice" && hardware_thread_count_value(t: t) > 0
    UncappedSliceControl { caps: _ } => false
    SliceControlRefused { unit: _, cause: _ } => false
  }
}

fn is_uncapped_broker(u: SliceControlUnit) -> Bool {
  match u {
    UncappedSliceControl { caps: c } => (c.unit as String) == "gunbc-approval-broker.slice"
    SessionsSliceControl { caps: _, cpu_quota: _ } => false
    SliceControlRefused { unit: _, cause: _ } => false
  }
}

// THE INHABITANCE CLAIM: srv1's real derivation reaches the sessions arm with a positive share,
// the broker stays uncapped, and srv3 (no sessions reservation) owes no sessions control at all.
test fn srv1_sessions_slice_is_owed_its_derived_cpu_cap() -> Bool {
  let srv1 = slice_control_units_for(host: operator_host_srv1)
  any(srv1, u => is_capped_sessions(u: u))
    && any(srv1, u => is_uncapped_broker(u: u))
    && slice_control_units_for(host: operator_host_srv3).length() == 0
}

fn fixture_sessions_caps() -> SliceControlCaps {
  SliceControlCaps { unit: "sessions.slice" as NonEmptyStr, memory_max: byte_size(137438953472), memory_high: byte_size(120259084288) }
}

// The CPU set-property follows MemoryHigh inside the one revert, at the supplied share (32 threads
// -> 3200%), and appears exactly once.
test fn the_sessions_cpu_cap_is_set_after_the_single_revert() -> Bool {
  let text = shell_command_text_of_stmts(stmts: slice_control_converge_stmts_for_unit(u: SessionsSliceControl { caps: fixture_sessions_caps(), cpu_quota: hardware_thread_count(count: 32) }))
  string_contains(s: text, pattern: "CPUQuota=3200%")
    && string_contains(s: text, pattern: "MemoryHigh=")
    && !string_contains(s: shell_command_text_of_stmts(stmts: slice_control_converge_stmts_for_unit(u: UncappedSliceControl { caps: fixture_sessions_caps() })), pattern: "CPUQuota")
}

// RED: a host whose CPU allocation does not derive refuses the whole sessions unit, so the revert
// can never run without the cap following it; the refusal renders as a failing step, not a skip.
test fn a_sessions_slice_without_a_derivable_cap_refuses() -> Bool {
  match sessions_slice_control_for(host: "srv9", caps: fixture_sessions_caps()) {
    SliceControlRefused { unit: _, cause: _ } =>
      !string_contains(s: shell_command_text_of_stmts(stmts: slice_control_converge_stmts_for_unit(u: SliceControlRefused { unit: "sessions.slice" as NonEmptyStr, cause: "fixture" })), pattern: "MemoryMax")
    SessionsSliceControl { caps: _, cpu_quota: _ } => false
    UncappedSliceControl { caps: _ } => false
  }
}
