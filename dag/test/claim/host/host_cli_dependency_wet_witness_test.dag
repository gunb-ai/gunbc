module test.claim.host_cli_dependency_wet_witness_test

import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import v2.std.optional { Present, Absent }
import std.types { Bool, NonEmptyStr }
import extdeps.tools { CliTool, SourceCoreutils }
import extdeps.tools.npm { npm_cli_tool }
import extdeps.tools.sshpass { sshpass_cli_tool }
import gunbc.host_cli_dependency {
  observe_host_cli_dependency,
  first_absent_password_session_host_cli_dependency,
  HostCliDependencyPresent,
  HostCliDependencyAbsent,
}

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data echo_cli_tool: CliTool = CliTool {
  name: "echo" as NonEmptyStr,
  min_version: none,
  installable_via: [SourceCoreutils],
}

data witness_note: String = "WET EXECUTION: observe_host_cli_dependency must not match shell.PosixCommandV.Check.path (Optional straddle; migrated off shell.Which.Check, crisp-wren-896, PR #8590). Present and absent are both successful typed observations — only a runtime error is RED."

test fn observe_echo_wet_posix_command_v_check_does_not_crash() -> Bool {
  match observe_host_cli_dependency(tool: echo_cli_tool) {
    HostCliDependencyPresent => true
    HostCliDependencyAbsent { absence: _ } => true
  }
}

test fn observe_npm_wet_posix_command_v_check_does_not_crash() -> Bool {
  match observe_host_cli_dependency(tool: npm_cli_tool) {
    HostCliDependencyPresent => true
    HostCliDependencyAbsent { absence: _ } => true
  }
}

// THE SAME SHAPE FOR THE PASSWORD-SESSION ENROLLMENT, and it is deliberately outcome-agnostic for
// the reason the note above states: this runner may or may not carry sshpass, and BOTH are typed
// observations. What would be RED is the state this whole enrollment exists to remove -- reaching
// the binary by exec and getting a raw os-error instead of an observation. A test asserting
// Present here would be an assertion about which runner happened to pick the job up, which is not
// a fact about this module.
test fn observe_sshpass_wet_posix_command_v_check_does_not_crash() -> Bool {
  match observe_host_cli_dependency(tool: sshpass_cli_tool) {
    HostCliDependencyPresent => true
    HostCliDependencyAbsent { absence: _ } => true
  }
}

// THE ENROLLED ROSTER WALKS WET, and what this row proves is narrower than what stood here before.
// The earlier annotation called it "the discriminating part: if a roster row resolves to no
// CliTool, this returns an absence carrying the row's provision sentence". That case no longer
// exists: the roster is a List<CliTool>, so a row without its tool has no constructor at all, and
// an annotation describing how a witness catches an unwritable state is
// worse than none -- it would be cited as coverage for a class that cannot occur (§4b: ask whether
// the check's RED is authorable before claiming the check).
//
// WHAT IT ACTUALLY PROVES: the roster walk reaches a real PATH observation for every enrolled row
// without raising, and any absence it reports is about the enrolled tool rather than some other
// row. Present and absent are both correct outcomes here -- which of the two this runner gives is
// a fact about the runner, not about the enrollment -- so the only RED is a runtime error, which
// is precisely the raw exec failure this whole enrollment exists to replace.
test fn password_session_enrollment_walks_wet_without_crashing() -> Bool {
  match first_absent_password_session_host_cli_dependency() {
    Present { value: absence } => absence.tool == sshpass_cli_tool.name
    Absent => true
  }
}
