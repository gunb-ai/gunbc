module test.claim.host.stdout_stderr_to_file_redirect_witness

import std.types { String, Bool }
import std.algebra { string_contains }
import extdeps.tools.gnu_coreutils { true_command }
import extdeps.posix.process {
  PosixProcessStdio,
  PosixProcessStdioUnchanged,
  PosixProcessStdoutAndStderrToOneFile,
  PosixProcessStdoutAndStderrToSeparateFiles,
  PosixFileTruncate,
}
import extdeps.posix.shell_command_language {
  RedirectPathContainsNul,
  RedirectPathContainsNewline,
  RedirectPathEmpty,
}
import gunbc.remote_shell_command {
  RemoteExecCommandBuilt,
  RemoteExecCommandRefused,
  RedirectPathRefused,
  SimpleCommandArgvRefused,
  RemoteExecInterpretationUnknown,
  remote_exec_command_rendered,
  remote_exec_command_string,
  PosixShellInterpreted,
}
import gunbc.host.host_effect_argv_stdio { host_effect_argv_stdio_remote_command }

fn today_no_redirect() -> String {
  match remote_exec_command_string(argv: ["true"], interpretation: PosixShellInterpreted) {
    RemoteExecCommandRefused { cause: _ } => "REFUSED"
    RemoteExecCommandBuilt { command: c } => remote_exec_command_rendered(command: c) as String
  }
}

fn one_file_truncate(path: String) -> PosixProcessStdio {
  PosixProcessStdoutAndStderrToOneFile { path: path, mode: PosixFileTruncate }
}

test fn stdout_and_stderr_to_serve_log_is_byte_exact() -> Bool {
  match host_effect_argv_stdio_remote_command(
    command: true_command(),
    stdio: one_file_truncate(path: "/root/serve/serve.log"),
  ) {
    RemoteExecCommandRefused { cause: _ } => false
    RemoteExecCommandBuilt { command: c } =>
      remote_exec_command_rendered(command: c) as String == "'true' >|'/root/serve/serve.log' 2>&1"
  }
}

test fn a_path_that_needs_quoting_renders_safely() -> Bool {
  match host_effect_argv_stdio_remote_command(
    command: true_command(),
    stdio: one_file_truncate(path: "/root/serve/it's a log.log"),
  ) {
    RemoteExecCommandRefused { cause: _ } => false
    RemoteExecCommandBuilt { command: c } =>
      remote_exec_command_rendered(command: c) as String == "'true' >|'/root/serve/it'\\''s a log.log' 2>&1"
  }
}

test fn embedded_nul_path_refuses_typed() -> Bool {
  match host_effect_argv_stdio_remote_command(
    command: true_command(),
    stdio: one_file_truncate(path: concat("/root/serve/", concat("\u{0}", "x.log"))),
  ) {
    RemoteExecCommandBuilt { command: _ } => false
    RemoteExecCommandRefused { cause: c } => match c {
      RedirectPathRefused { cause: inner } => match inner {
        RedirectPathContainsNul => true
        RedirectPathContainsNewline => false
        RedirectPathEmpty => false
      }
      SimpleCommandArgvRefused { cause: _ } => false
      RemoteExecInterpretationUnknown => false
    }
  }
}

test fn embedded_newline_path_refuses_typed() -> Bool {
  match host_effect_argv_stdio_remote_command(
    command: true_command(),
    stdio: one_file_truncate(path: "/root/serve/\nlog"),
  ) {
    RemoteExecCommandBuilt { command: _ } => false
    RemoteExecCommandRefused { cause: c } => match c {
      RedirectPathRefused { cause: inner } => match inner {
        RedirectPathContainsNewline => true
        RedirectPathContainsNul => false
        RedirectPathEmpty => false
      }
      SimpleCommandArgvRefused { cause: _ } => false
      RemoteExecInterpretationUnknown => false
    }
  }
}

test fn no_redirect_renders_byte_identical_to_today() -> Bool {
  match host_effect_argv_stdio_remote_command(command: true_command(), stdio: PosixProcessStdioUnchanged) {
    RemoteExecCommandRefused { cause: _ } => false
    RemoteExecCommandBuilt { command: c } =>
      remote_exec_command_rendered(command: c) as String == today_no_redirect()
        && today_no_redirect() == "'true'"
  }
}

test fn separate_files_are_two_opens_not_a_dup() -> Bool {
  match host_effect_argv_stdio_remote_command(
    command: true_command(),
    stdio: PosixProcessStdoutAndStderrToSeparateFiles {
      stdout_path: "/root/serve/out.log",
      stderr_path: "/root/serve/err.log",
      stdout_mode: PosixFileTruncate,
      stderr_mode: PosixFileTruncate,
    },
  ) {
    RemoteExecCommandRefused { cause: _ } => false
    RemoteExecCommandBuilt { command: c } =>
      let s = remote_exec_command_rendered(command: c) as String
      s == "'true' >|'/root/serve/out.log' 2>|'/root/serve/err.log'"
        && !string_contains(s: s, pattern: "2>&1")
  }
}
