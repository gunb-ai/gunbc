module test.claim.host.cap_raise_retirement_order_witness

import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.logic { Bool }
import std.types { NonEmptyStr }
import gunbc.host_axis_caps {
  CapConvergeAuthorized,
  CapConvergeWithheld,
  CapRaiseAdmitted,
  CapRaiseBlockedIncompleteEvidence,
  CapRaiseBlockedPendingRetirement,
  CapRaiseBlockedUnobserved,
  CapMember,
  SurplusSlotsObserved,
  SurplusSlotsUnobserved,
  authorized_caps_effects,
  cap_converge_decision,
  cap_converge_is_withheld,
  cap_raise_standing,
  cap_raise_standing_blocks,
  desired_cap_member,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE ORDER BETWEEN SHRINKING AND RAISING IS WHAT THESE ROWS DEFEND, and it is the one property a
// model cannot get from admission alone. Admission answers WHETHER a host may be written to;
// nothing before this answered WHEN. Narrowing a host's width from 21 to 12 narrows which units the
// drop-ins target -- it does not stop slots 13..21 existing or serving -- so a raise applied then
// commits the host to twelve slots at the new ceiling plus nine still holding the old one.

// THE POSITIVE CONTROL. Without it every row below is satisfied by a gate that blocks everything,
// which is the failure mode a refusal-only suite cannot see.
test fn an_empty_surplus_admits_the_raise() -> Bool {
  match cap_raise_standing(
    required_retiring: [],
    observation: SurplusSlotsObserved { retired: ["actions-runner@srv1-13.service"], still_present: [] }
  ) {
    CapRaiseAdmitted => true
    CapRaiseBlockedPendingRetirement { still_present: _ } => false
    CapRaiseBlockedIncompleteEvidence { missing: _ } => false
    CapRaiseBlockedUnobserved { cause: _ } => false
  }
}

// A SLOT STILL PRESENT BLOCKS, and the standing names WHICH -- a blocked raise that cannot say what
// it is waiting for gives an operator nothing to act on.
test fn a_surviving_surplus_slot_blocks_the_raise() -> Bool {
  match cap_raise_standing(
    required_retiring: [],
    observation: SurplusSlotsObserved {
      retired: ["actions-runner@srv1-13.service"],
      still_present: ["actions-runner@srv1-14.service"],
    }
  ) {
    CapRaiseBlockedPendingRetirement { still_present: sp } => sp.length() == 1
    CapRaiseAdmitted => false
    CapRaiseBlockedIncompleteEvidence { missing: _ } => false
    CapRaiseBlockedUnobserved { cause: _ } => false
  }
}

// THE ARM THAT MATTERS MOST: AN UNOBSERVED SURPLUS IS NOT AN EMPTY ONE. Rendering "I could not see
// the retiring set" as "there is nothing left to retire" is the empty-observation narrow, and it is
// what makes a shrink silently unsafe instead of loudly blocked.
test fn an_unobserved_surplus_blocks_rather_than_reading_as_empty() -> Bool {
  match cap_raise_standing(
    required_retiring: [],
    observation: SurplusSlotsUnobserved { cause: "no unit census was taken on this host" }
  ) {
    CapRaiseBlockedUnobserved { cause: _ } => true
    CapRaiseAdmitted => false
    CapRaiseBlockedPendingRetirement { still_present: _ } => false
    CapRaiseBlockedIncompleteEvidence { missing: _ } => false
  }
}

test fn both_blocked_standings_report_as_blocking() -> Bool {
  cap_raise_standing_blocks(
    standing: CapRaiseBlockedUnobserved { cause: "unobserved" }
  )
    && cap_raise_standing_blocks(
      standing: CapRaiseBlockedPendingRetirement { still_present: ["actions-runner@srv1-14.service"] }
    )
    && !cap_raise_standing_blocks(standing: CapRaiseAdmitted)
}

// ── THE CONTROLS THAT MUST RUN THROUGH THE EFFECT ROOTS, NOT THE PREDICATES ───────────────────
//
// A blocked raise used to be encoded as an EMPTY DESIRED SET, with a comment claiming that meant
// "no change". It does not: `caps_reconcile` treats an owned observed member absent from desired as
// `MemberRemoved`, which `membership_effects` renders as `EffectRemove`. A withheld raise would
// therefore have TORN DOWN the caps it was withheld from raising.
//
// NO PREDICATE-LEVEL ROW COULD HAVE CAUGHT THAT. `cap_raise_standing` was correct throughout; the
// defect lived in what its result was flattened into on the way to the effect decision. So these
// rows drive `authorized_caps_effects` with a NONEMPTY OBSERVED SET -- the only shape in which a
// removal can be produced at all.
fn observed_existing_caps() -> List<CapMember> {
  [
    desired_cap_member(
      dropin_path: "/etc/systemd/system/actions-runner@.service.d/10-resource-caps.conf" as NonEmptyStr,
      property: "MemoryMax" as NonEmptyStr,
      bytes_value: "17179869184" as NonEmptyStr,
    ),
  ]
}

test fn a_withheld_decision_emits_no_effects_against_existing_caps() -> Bool {
  authorized_caps_effects(
    decision: CapConvergeWithheld { cause: "unobserved" },
    observed: observed_existing_caps(),
  ).length() == 0
}

// THE DISCRIMINATING RED FOR THE TEARDOWN CLASS. An unobserved surplus, against a host that already
// carries owned caps, must emit NEITHER upserts NOR removals. Reinstating the empty-desired-set
// shape makes this row produce a removal and go red.
test fn an_unobserved_surplus_removes_nothing_that_exists() -> Bool {
  authorized_caps_effects(
    decision: cap_converge_decision(
      required_retiring: ["actions-runner@srv1-14.service" as NonEmptyStr],
      observation: SurplusSlotsUnobserved { cause: "no census" },
    ),
    observed: observed_existing_caps(),
  ).length() == 0
}

test fn a_pending_drain_removes_nothing_that_exists() -> Bool {
  authorized_caps_effects(
    decision: cap_converge_decision(
      required_retiring: ["actions-runner@srv1-14.service" as NonEmptyStr],
      observation: SurplusSlotsObserved {
        retired: [],
        still_present: ["actions-runner@srv1-14.service" as NonEmptyStr],
      },
    ),
    observed: observed_existing_caps(),
  ).length() == 0
}

// ── COVERAGE: EVIDENCE ABOUT THE SLOTS SOMEONE MENTIONED IS NOT EVIDENCE ABOUT THE SLOTS THAT
//    MUST GO ────────────────────────────────────────────────────────────────────────────────────

// AN OMITTED REQUIRED RETIREE. This is the counterexample that admitted before the required set was
// carried: no standings supplied at all projects to an empty surplus and used to read as done.
test fn an_omitted_required_retiree_blocks_rather_than_admits() -> Bool {
  match cap_raise_standing(
    required_retiring: ["actions-runner@srv1-14.service" as NonEmptyStr],
    observation: SurplusSlotsObserved { retired: [], still_present: [] },
  ) {
    CapRaiseBlockedIncompleteEvidence { missing: ms } => ms.length() == 1
    CapRaiseAdmitted => false
    CapRaiseBlockedPendingRetirement { still_present: _ } => false
    CapRaiseBlockedUnobserved { cause: _ } => false
  }
}

// DUPLICATE EVIDENCE MUST NOT SUBSTITUTE FOR A MISSING RETIREE. Two completions for slot 14 do not
// retire slot 15, and a coverage check that counted rather than joined on identity would pass this.
test fn duplicate_evidence_does_not_cover_a_second_retiree() -> Bool {
  match cap_raise_standing(
    required_retiring: [
      "actions-runner@srv1-14.service" as NonEmptyStr,
      "actions-runner@srv1-15.service" as NonEmptyStr,
    ],
    observation: SurplusSlotsObserved {
      retired: [
        "actions-runner@srv1-14.service" as NonEmptyStr,
        "actions-runner@srv1-14.service" as NonEmptyStr,
      ],
      still_present: [],
    },
  ) {
    CapRaiseBlockedIncompleteEvidence { missing: ms } => ms.length() == 1
    CapRaiseAdmitted => false
    CapRaiseBlockedPendingRetirement { still_present: _ } => false
    CapRaiseBlockedUnobserved { cause: _ } => false
  }
}

// A MISMATCHED IDENTITY IS NOT COVERAGE. Retiring a slot nobody asked about leaves the required one
// outstanding.
test fn a_mismatched_retirement_identity_does_not_cover() -> Bool {
  match cap_raise_standing(
    required_retiring: ["actions-runner@srv1-14.service" as NonEmptyStr],
    observation: SurplusSlotsObserved {
      retired: ["actions-runner@srv1-99.service" as NonEmptyStr],
      still_present: [],
    },
  ) {
    CapRaiseBlockedIncompleteEvidence { missing: _ } => true
    CapRaiseAdmitted => false
    CapRaiseBlockedPendingRetirement { still_present: _ } => false
    CapRaiseBlockedUnobserved { cause: _ } => false
  }
}

// AN INDEPENDENTLY ESTABLISHED EMPTY REQUIRED SET IS LEGITIMATE, INCLUDING THE SECOND PASS. A host
// with nothing to retire must admit, or convergence would never be idempotent -- refusing every
// empty list would make the no-change second pass impossible to reach.
test fn an_empty_required_set_admits_so_convergence_is_idempotent() -> Bool {
  match cap_raise_standing(
    required_retiring: [],
    observation: SurplusSlotsObserved { retired: [], still_present: [] },
  ) {
    CapRaiseAdmitted => true
    CapRaiseBlockedIncompleteEvidence { missing: _ } => false
    CapRaiseBlockedPendingRetirement { still_present: _ } => false
    CapRaiseBlockedUnobserved { cause: _ } => false
  }
}

// AND THE AUTHORIZED PATH STILL WRITES. Without this the suite is satisfied by a gate that withholds
// everything, which is the failure a refusal-only suite cannot see.
test fn an_authorized_decision_still_produces_cap_effects() -> Bool {
  match cap_converge_decision(
    required_retiring: [],
    observation: SurplusSlotsObserved { retired: [], still_present: [] },
  ) {
    CapConvergeAuthorized { desired: d } => d.length() == 2 && !cap_converge_is_withheld(
      d: CapConvergeAuthorized { desired: d }
    )
    CapConvergeWithheld { cause: _ } => false
  }
}
