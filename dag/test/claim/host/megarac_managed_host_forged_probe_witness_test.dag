module test.claim.megarac_managed_host_forged_probe_witness

import v2.std.algebra { filter }
import std.types { String, Bool, Int, List }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import gunbc.compile_diagnostic_census {
  CompileDiagnosticCensus, CompileDiagnosticCensusRow, CensusObserved, CensusNotRunnable,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE MEGARAC CARRIERS AND THE MEDIA SEALS, ENROLLED AS EXECUTED REDS. The probe source below authors an
// AdmittedMegaRacHost and a MegaRacSdrSocketNamingRule outside their mints, and calls the boot's media
// attach, its presentation look and every chassis effect beneath them from outside their admitted
// callers. This witness hands that source to the compiler through the diagnostic-census harness and
// requires the refusal CLASS at each SUBJECT by name. It is an identity join, so a probe refusing for
// any other reason measures another wall, and the harness control shows the census ran.
data forged_probe_source: String = "module probe_megarac_managed_host_forged\n\nimport std.types { NonEmptyStr, String }\nimport extdeps.bmc.megarac { megarac_firmware_0_32 }\nimport extdeps.bmc.ipmi_chassis_control { ChassisPowerObservation, ChassisUnreadable }\nimport gunbc.managed_host { ManagedHostBinding }\nimport gunbc.managed_host_unit_hold { UnitHoldProof }\nimport gunbc.megarac_managed_host { AdmittedMegaRacHost }\nimport gunbc.megarac_operation_standing { MegaRacVirtualMediaAttach }\nimport gunbc.machine_intake_megarac_sensor_observation { MegaRacSdrSocketNamingRule }\nimport gunbc.machine_intake_megarac_media_attach { MegaRacShareBinding }\nimport gunbc.machine_intake_megarac_boot_media_attach {\n  MegaRacIpmiReadBound, megarac_attach_boot_image, megarac_observe_boot_presentation, megarac_boot_media_chassis_power,\n  megarac_stale_power_off, megarac_stale_power_off_poll, megarac_power_after_stale_power_off,\n}\nimport gunbc.machine_intake_mtcollins1_boot_diagnostic_bundle { MtCollins1MediaAttachRecord, StaleMediumPowerOff }\nimport gunbc.machine_intake_megarac_media_attach { MegaRacAttachResult }\nimport std.types { EpochMs }\nimport extdeps.bmc.endpoint { BmcControllerEndpoint }\nimport extdeps.bmc.access_profile { BmcObservedIdentity }\nimport gunbc.machine_intake_receipt { EvidenceRef }\nimport gunbc.megarac_operation_standing { MegaRacOperationStanding, MegaRacBuildReading, MegaRacOperationReceipt, MegaRacFirmwareTransition, MegaRacOperationGrounding, MegaRacKvmCanvasStill }\nimport gunbc.megarac_managed_host { MegaRacHostAdmission, GroundedByExecutionOnly, megarac_grounded_admission }\nimport gunbc.megarac_operation_standing { MegaRacOperationEvidence, megarac_operation_evidence_of }\nimport gunbc.machine_intake_megarac_operation_evidence { mtcollins1_megarac_operation_evidence }\n\nfn forged_host(b: ManagedHostBinding) -> AdmittedMegaRacHost {\n  AdmittedMegaRacHost { binding: b, operation: MegaRacVirtualMediaAttach, firmware: megarac_firmware_0_32 }\n}\n\nfn forged_naming(b: ManagedHostBinding) -> MegaRacSdrSocketNamingRule {\n  MegaRacSdrSocketNamingRule { host: b.host.host, firmware: megarac_firmware_0_32, prefix: \"CPU\" }\n}\n\nfn attach_from_outside_the_boot(p: UnitHoldProof, share: MegaRacShareBinding, bound: MegaRacIpmiReadBound) -> MtCollins1MediaAttachRecord {\n  megarac_attach_boot_image(proof: p, image_name: \"x.iso\", image_sha256: \"00\", share: share, replaceable_seeded_stem: \"x\", bound: bound, password_file: \"/tmp/pw\", attempt: \"forged\")\n}\n\nfn observe_from_outside_the_boot(p: UnitHoldProof, share: MegaRacShareBinding) -> MegaRacAttachResult {\n  megarac_observe_boot_presentation(proof: p, image_name: \"x.iso\", share: share, password_file: \"/tmp/pw\", attempt: \"forged\", look: \"outside\")\n}\n\nfn read_chassis_with_a_carrier_in_hand(h: AdmittedMegaRacHost, bound: MegaRacIpmiReadBound) -> ChassisPowerObservation {\n  megarac_boot_media_chassis_power(host: h, password_file: \"/tmp/pw\", bound: bound)\n}\n\nfn power_off_with_a_carrier_in_hand(h: AdmittedMegaRacHost, share: MegaRacShareBinding, bound: MegaRacIpmiReadBound) -> StaleMediumPowerOff {\n  megarac_stale_power_off(host: h, before: ChassisUnreadable, password_file: \"/tmp/pw\", attempt: \"forged\", image_name: \"x.iso\", share: share, replaceable_seeded_stem: \"x\", bound: bound)\n}\n\nfn poll_with_a_carrier_in_hand(h: AdmittedMegaRacHost, bound: MegaRacIpmiReadBound) -> ChassisPowerObservation {\n  megarac_stale_power_off_poll(host: h, password_file: \"/tmp/pw\", bound: bound, remaining: 1)\n}\n\nfn fresh_read_with_a_carrier_in_hand(h: AdmittedMegaRacHost, off: StaleMediumPowerOff, bound: MegaRacIpmiReadBound) -> ChassisPowerObservation {\n  megarac_power_after_stale_power_off(host: h, before: ChassisUnreadable, off: off, password_file: \"/tmp/pw\", bound: bound)\n}\n\n\nfn forged_standing(i: BmcObservedIdentity, g: MegaRacOperationGrounding) -> MegaRacOperationStanding {\n  MegaRacOperationStanding { operation: MegaRacKvmCanvasStill, identity: i, grounding: g }\n}\n\nfn forged_reading(e: BmcControllerEndpoint, i: BmcObservedIdentity, v: EvidenceRef) -> MegaRacBuildReading {\n  MegaRacBuildReading { endpoint: e, identity: i, evidence: v, observed_at: 1 }\n}\n\nfn forged_receipt(e: BmcControllerEndpoint, v: EvidenceRef) -> MegaRacOperationReceipt {\n  MegaRacOperationReceipt { operation: MegaRacKvmCanvasStill, endpoint: e, receipt: v, executed_at: 1 }\n}\n\nfn admit_through_the_mint_helper(b: ManagedHostBinding, i: BmcObservedIdentity) -> MegaRacHostAdmission {\n  megarac_grounded_admission(evidence: mtcollins1_megarac_operation_evidence(), binding: b, operation: MegaRacVirtualMediaAttach, identity: i, requirement: GroundedByExecutionOnly)\n}\n\nfn drop_the_reflash_by_literal(e: MegaRacOperationEvidence) -> MegaRacOperationEvidence {\n  MegaRacOperationEvidence { readings: e.readings, receipts: e.receipts, transitions: [], recoveries: e.recoveries }\n}\n\nfn drop_the_reflash_through_the_mint(e: MegaRacOperationEvidence) -> MegaRacOperationEvidence {\n  megarac_operation_evidence_of(readings: e.readings, receipts: e.receipts, transitions: [], recoveries: e.recoveries)\n}\n"

fn probe() -> CompileDiagnosticCensus {
  compile_dag_diagnostic_census(forged_probe_source)
}

fn blocking_count_for_class_and_subject(c: CompileDiagnosticCensus, wanted: String, subject: String) -> Int {
  match c {
    CensusNotRunnable { cause: _ } => -1
    CensusObserved { rows: rows } =>
      rows
        |> filter(r => (r.diagnostic_class as String) == wanted && r.subject_name == subject && r.blocking)
        |> fold(init: 0, f: (acc, r) => acc + r.count)
  }
}

fn blocking_count_for_class(c: CompileDiagnosticCensus, wanted: String) -> Int {
  match c {
    CensusNotRunnable { cause: _ } => -1
    CensusObserved { rows: rows } =>
      rows |> filter(r => (r.diagnostic_class as String) == wanted && r.blocking) |> fold(init: 0, f: (acc, r) => acc + r.count)
  }
}

data harness_control_source: String = "module probe_megarac_managed_host_harness_control\nimport std.types { NonEmptyStr }\nimport gunbc.megarac_managed_host { MegaRacHostAdmission, megarac_host_admission_for }\nimport gunbc.megarac_operation_standing { MegaRacVirtualMediaAttach }\nfn admission(host: NonEmptyStr) -> MegaRacHostAdmission { megarac_host_admission_for(host: host, operation: MegaRacVirtualMediaAttach) }\n"

// THE CONTROL IS CLASS-SCOPED: a clean source reaching the admission through its real entry yields NO
// row of either class the reds count.
test fn the_harness_runs_and_a_clean_source_emits_neither_wall_class() -> Bool {
  let c = compile_dag_diagnostic_census(harness_control_source)
  blocking_count_for_class(c: c, wanted: "SoleConstructorViolation") == 0
    && blocking_count_for_class(c: c, wanted: "ConstructorCallAdmissionRefused") == 0
}

// AN ADMITTED MEGARAC HOST AND A SOCKET NAMING CANNOT BE AUTHORED OUTSIDE THEIR MINTS, so no endpoint,
// account, firmware or prefix reaches a MegaRAC effect except through admit_megarac_host.
test fn each_forged_megarac_carrier_is_refused_at_its_literal() -> Bool {
  let c = probe()
  blocking_count_for_class_and_subject(c: c, wanted: "SoleConstructorViolation", subject: "AdmittedMegaRacHost") >= 1
    && blocking_count_for_class_and_subject(c: c, wanted: "SoleConstructorViolation", subject: "MegaRacSdrSocketNamingRule") >= 1
}

// THE BOOT'S MEDIA ENTRIES AND EVERY CHASSIS EFFECT BENEATH THEM REFUSE AN OUTSIDE CALLER, even one
// holding a carrier: the effects run only inside the attach, which admits from the proof's own host.
test fn the_media_entries_and_their_chassis_effects_refuse_an_outside_caller() -> Bool {
  let c = probe()
  blocking_count_for_class_and_subject(c: c, wanted: "ConstructorCallAdmissionRefused", subject: "megarac_attach_boot_image") >= 1
    && blocking_count_for_class_and_subject(c: c, wanted: "ConstructorCallAdmissionRefused", subject: "megarac_observe_boot_presentation") >= 1
    && blocking_count_for_class_and_subject(c: c, wanted: "ConstructorCallAdmissionRefused", subject: "megarac_boot_media_chassis_power") >= 1
    && blocking_count_for_class_and_subject(c: c, wanted: "ConstructorCallAdmissionRefused", subject: "megarac_stale_power_off") >= 1
    && blocking_count_for_class_and_subject(c: c, wanted: "ConstructorCallAdmissionRefused", subject: "megarac_stale_power_off_poll") >= 1
    && blocking_count_for_class_and_subject(c: c, wanted: "ConstructorCallAdmissionRefused", subject: "megarac_power_after_stale_power_off") >= 1
}

// THE OPERATION EVIDENCE CANNOT BE AUTHORED AROUND ITS MINTS: a standing, a build reading and an
// operation receipt written as literals are each refused, so no operation is grounded at a build except
// by gunbc.megarac_operation_standing's join over committed rows.
test fn each_forged_operation_evidence_carrier_is_refused_at_its_literal() -> Bool {
  let c = probe()
  blocking_count_for_class_and_subject(c: c, wanted: "SoleConstructorViolation", subject: "MegaRacOperationStanding") >= 1
    && blocking_count_for_class_and_subject(c: c, wanted: "SoleConstructorViolation", subject: "MegaRacBuildReading") >= 1
    && blocking_count_for_class_and_subject(c: c, wanted: "SoleConstructorViolation", subject: "MegaRacOperationReceipt") >= 1
}

// NO CALLER OUTSIDE THE TWO ADMISSIONS MINTS THE CARRIER THROUGH THE HELPER THAT CONSTRUCTS IT: given a
// real binding and the committed evidence, an outside call to megarac_grounded_admission is refused at
// admission, so the family, grounding and current-build steps cannot be stepped around.
test fn the_carrier_mint_helper_refuses_an_outside_caller() -> Bool {
  blocking_count_for_class_and_subject(c: probe(), wanted: "ConstructorCallAdmissionRefused", subject: "megarac_grounded_admission") >= 1
}

// RED: GENUINE EVIDENCE WITH THE 2026-10-02 REFLASH DROPPED CANNOT BE BUILT. Every reading and receipt in
// it would still be genuine and sealed; it is the omission of the known transition that would make 0.32
// read as current. Rebuilding the population is refused both as a literal and through its mint, so the
// current-build gate only ever sees a complete committed population or a named witness fixture.
test fn a_population_rebuilt_without_its_known_transition_is_refused() -> Bool {
  let c = probe()
  blocking_count_for_class_and_subject(c: c, wanted: "SoleConstructorViolation", subject: "MegaRacOperationEvidence") >= 1
    && blocking_count_for_class_and_subject(c: c, wanted: "ConstructorCallAdmissionRefused", subject: "megarac_operation_evidence_of") >= 1
}
