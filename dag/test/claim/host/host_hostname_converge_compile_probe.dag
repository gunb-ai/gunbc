module test.claim.host.host_hostname_converge_compile_probe

// A DIAGNOSTIC PROBE, not a shipped claim: it pulls the smallest possible face of
// gunbc.host.host_hostname_converge (one pure function over a string) so a slow or stuck
// compile.frontend/normalize can be attributed to the module's effectful surface rather than guessed at.

import std.types { Bool, String }
import std.optional { Absent, Present }
import gunbc.host.host_hostname_converge { hostname_converge_direction_of }

test fn probe_direction_of_forward_resolves() -> Bool {
  match hostname_converge_direction_of(raw: "forward") {
    Present { value: _ } => true
    Absent => false
  }
}
