module test.claim.managed_host_witness

import std.types { Bool, String }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import gunbc.fleet_intent_network { operator_host_mtcollins1 }
import gunbc.managed_host { ResetNoUnitHold, ResetUnitHoldRequired, managed_hosts }
import gunbc.machine_intake_bmc_secure { bmc_secured_account }
import gunbc.host_reset_subject_roster { reset_subject_is_admitted, reset_subject_roster }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE ROUTE, NOT ONLY THE ANSWER. The managed set is exactly the mtcollins1 row, that row's subject
// bound and its secure standing names an account, the admission fold admits it, and the reset roster
// is exactly its host. Removing the row, or either of its Optionals going Absent, turns this red.
test fn w_reset_roster_is_exactly_mtcollins1_through_the_admission_fold() -> Bool {
  let hosts = managed_hosts()
  let roster = reset_subject_roster()
  count(hosts) == 1
    && hosts |> all(h =>
      (h.host as String) == (operator_host_mtcollins1 as String)
        && reset_subject_is_admitted(host: h)
        && match bmc_secured_account(standing: h.secure) {
          Absent => false
          Present { value: _ } => true
        }
        && match h.unit_hold {
          ResetUnitHoldRequired { key: _, store_host: _ } => true
          ResetNoUnitHold => false
        })
    && count(roster) == 1
    && roster |> all(r => (r as String) == (operator_host_mtcollins1 as String))
}
