module test.claim.host_effect_plan_witness

import std.logic { Bool }
import gunbc.host_effect {
  NodeControlPlane, HostOs,
  host_effect_identity_evidence,
  LocalShell,
  Srv3ReceiptEmit,
}
import gunbc.host_effect_plan {
  HostEffectPlan, HostEffectPlanContext,
  host_effect_plan_apply,
}
import v2.std.effect_plan {
  EffectPlan,
  If, Do,
}
import v2.std.orchestration {
  FailFast,
  ExitZero,
  Run,
}
import v2.std.collection { Present, Absent }
import std.realization_reconcile { Converged, NotConverged }
import gunbc.fleet_intent { srv1_host }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// Hermetic-safe Wave A2 host_effect_plan_apply witnesses: control-flow and empty-plan refusal arms
// only (no shell.Exec.Run). Shell converge/failure/sequential poles live in
// host_effect_plan_real_execution_witness_test.dag (Wet bin batch).

fn witness_host_os_target() -> NodeControlPlane {
  HostOs { node: srv1_host }
}

fn witness_plan_ctx() -> HostEffectPlanContext {
  HostEffectPlanContext {
    target: witness_host_os_target(),
    evidence: host_effect_identity_evidence,
    transport: LocalShell,
  }
}

fn witness_empty_plan() -> HostEffectPlan {
  EffectPlan { steps: Empty, on_failure: FailFast }
}

fn witness_if_control_flow_plan() -> HostEffectPlan {
  EffectPlan {
    steps: [
      If {
        cond: ExitZero {
          run: Run { command: "true", env: Empty, redirect: Absent, capture: Absent }
        },
        then_: EffectPlan { steps: [], on_failure: FailFast },
        else_: Absent,
      },
    ],
    on_failure: FailFast,
  }
}

test fn witness_empty_plan_refuses_without_fabricated_effect() -> Bool {
  match host_effect_plan_apply(plan: witness_empty_plan(), ctx: witness_plan_ctx()) {
    NotConverged { reason: why, applied: Absent } =>
      why == "host_effect_plan_apply: empty plan has no effect to apply"
    _ => false
  }
}

test fn witness_control_flow_step_refuses_without_fabricated_effect() -> Bool {
  match host_effect_plan_apply(plan: witness_if_control_flow_plan(), ctx: witness_plan_ctx()) {
    NotConverged { reason: why, applied: Absent } =>
      why == gunbc.host_effect_plan.host_effect_plan_unsupported_step_reason
    _ => false
  }
}

// Distinct receipt subjects distinguish the last attempted leaf from the first.
test fn witness_do_retains_actual_intent() -> Bool {
  let effect = Srv3ReceiptEmit { lines: ["last-effect"] }
  match host_effect_plan_apply(
    plan: EffectPlan {
      steps: [Do { effect: Srv3ReceiptEmit { lines: ["first-effect"] } }, Do { effect: effect }],
      on_failure: FailFast,
    },
    ctx: witness_plan_ctx(),
  ) {
    Converged { evidence: _, applied: Present { value: intent } } => intent.effect == effect
    _ => false
  }
}

test fn witness_failed_do_retains_attempt_and_stops_before_next_effect() -> Bool {
  let effect = gunbc.host_effect.RedfishAction { action: extdeps.bmc.types.GetSystem }
  match host_effect_plan_apply(
    plan: EffectPlan {
      steps: [Do { effect: effect }, Do { effect: Srv3ReceiptEmit { lines: ["must-not-run"] } }],
      on_failure: FailFast,
    },
    ctx: witness_plan_ctx(),
  ) {
    NotConverged { reason: _, applied: Present { value: intent } } => intent.effect == effect
    _ => false
  }
}

test fn witness_unsupported_step_stops_before_next_effect() -> Bool {
  match host_effect_plan_apply(
    plan: EffectPlan {
      steps: [
        If {
          cond: ExitZero { run: Run { command: "true", env: Empty, redirect: Absent, capture: Absent } },
          then_: witness_empty_plan(), else_: Absent,
        },
        Do { effect: Srv3ReceiptEmit { lines: ["must-not-run"] } },
      ],
      on_failure: FailFast,
    },
    ctx: witness_plan_ctx(),
  ) {
    NotConverged { reason: _, applied: Absent } => true
    _ => false
  }
}
