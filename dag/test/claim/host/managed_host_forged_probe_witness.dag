module test.claim.host.managed_host_forged_probe_witness

import std.types { String, Bool, Int, List }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import gunbc.compile_diagnostic_census {
  CompileDiagnosticCensus, CompileDiagnosticCensusRow, CensusObserved, CensusNotRunnable,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE MANAGED-HOST SEALS, ENROLLED AS EXECUTED REDS (eager-gull-22's review of gunbc#13055). The
// probe source below authors a ManagedHost, a BmcControlBinding, a BmcControlBoundRoute, an
// AdmittedResetSubject and an
// AdmittedBootSubject (with the reset arm's selection) outside their modules, mints a row through
// managed_host_fixture from an unadmitted caller, and drives host_reset_return_issue_and_watch and
// boot_drive_handoff with the forged subjects. This witness hands that source to the compiler
// through the diagnostic-census harness and requires the refusal CLASS at each SUBJECT by name. It
// is an identity join, so a probe refusing for any other reason measures another wall, and the
// harness control shows the census ran.
data forged_probe_source: String = "module probe_managed_host_forged\n\nimport std.types { EpochMs, NonEmptyStr, String, List }\nimport std.optional { Absent, Present }\nimport extdeps.bmc.capability { BmcFirmwareReleaseCapabilityRow }\nimport extdeps.bmc.megarac { megarac_firmware_0_45_3 }\nimport gunbc.host.megarac_managed_host { megarac_operation_evidence }\nimport gunbc.host.host_reset_return { ObserverSelfIdentity, ResetAttemptMint, ResetIssuanceRoute, ResetObserverSelection }\nimport extdeps.bmc.access_profile { BmcAccessObserved }\nimport gunbc.machine_intake.receipt { EvidenceRef }\nimport gunbc.machine_intake.megarac_operation_evidence { megarac_operation_evidence_fixture_for }\nimport std.content_hash { content_hash_of_value }\nimport gunbc.host.managed_host { managed_hosts }\nimport test.claim.host.managed_host_witness { witness_evidence_reporting }\nimport gunbc.fleet.fleet_host_identity { operator_host_mtcollins1 }\nimport gunbc.host.managed_host { ManagedHost, managed_host_fixture }\nimport gunbc.host.bmc_control_binding { BmcControlBinding, BmcControlBoundRoute }\nimport gunbc.host.host_reset_subject_roster { AdmittedResetSubject }\nimport gunbc.host.host_reset_return_run { host_reset_return_issue_and_watch }\nimport gunbc.machine_intake.mtcollins1_access_observation { mtcollins1_access_observation }\nimport gunbc.host.host_reset_boot_selection { reset_boot_selection }\nimport gunbc.host.virtual_media_boot_selection { VirtualMediaBootSelectionAdmitted, VirtualMediaBootSelectionRefused }\nimport extdeps.bmc.ipmi_boot_selection { IpmiBootCdrom, uefi_once_boot_selection }\nimport gunbc.host.managed_host_boot { AdmittedBootSubject }\nimport gunbc.host.boot_medium { stock_installer_boot_medium }\nimport gunbc.host.managed_host_unit_hold { UnitHoldProof, UnitHoldNotRequired }\nimport gunbc.host.managed_host_boot_handoff { BootHandoffResult, boot_drive_handoff }\nimport gunbc.host.managed_host_boot_image_fetch { fetch_boot_medium }\nimport std.process { ProcessExit }\n\nfn forged_row_named_mtcollins1(h: ManagedHost) -> ManagedHost {\n  ManagedHost {\n    host: operator_host_mtcollins1,\n    access: BmcAccessObserved { observation: mtcollins1_access_observation },\n    secure: h.secure,\n    smpro: h.smpro,\n  }\n}\n\nfn forged_row_through_the_fixture(h: ManagedHost) -> ManagedHost {\n  managed_host_fixture(host: operator_host_mtcollins1, access: h.access, secure: h.secure, smpro: h.smpro)\n}\n\nfn forged_binding(h: ManagedHost) -> BmcControlBinding {\n  BmcControlBinding { endpoint: mtcollins1_access_observation.endpoint, unit: h.secure.subject.subject.unit_key, secured: h.secure }\n}\n\nfn forged_route(h: ManagedHost) -> BmcControlBoundRoute {\n  BmcControlBoundRoute { binding: forged_binding(h: h), observation: mtcollins1_access_observation }\n}\n\n// THE FORGER'S ROW: an empty capability list under a catalogued identity. It exists so the forged\n// subjects still COMPILE -- the seal being measured is not this parameter, it is the roster on the\n// admitted-subject and fixture mints. A forger can hand a row over; what a forger cannot do is get\n// one admitted through a rostered door without the roster's consent.\nfn forged_empty_capability_row() -> BmcFirmwareReleaseCapabilityRow {\n  BmcFirmwareReleaseCapabilityRow { firmware: megarac_firmware_0_45_3, capabilities: [] }\n}\n\nfn forged_subject(h: ManagedHost) -> AdmittedResetSubject {\n  AdmittedResetSubject { host: h, route: forged_route(h: h), boot_selection: uefi_once_boot_selection(device: IpmiBootCdrom), capability_row: forged_empty_capability_row(), hold: UnitHoldNotRequired { host: h.host } }\n}\n\nfn drive_the_run_with_a_forged_subject(\n  h: ManagedHost,\n  selection: ResetObserverSelection,\n  identity: ObserverSelfIdentity,\n  route: ResetIssuanceRoute,\n  issued_at: EpochMs,\n) -> ResetAttemptMint {\n  host_reset_return_issue_and_watch(\n    proof: none,\n    candidate: forged_subject(h: h),\n    selection: selection,\n    identity: identity,\n    attempt: \"forged\",\n    route: route,\n    password_file: \"/tmp/pw\",\n    issued_at: issued_at,\n  )\n}\n\nfn forged_boot_subject_with_the_reset_selection(h: ManagedHost) -> AdmittedBootSubject {\n  // THE EVIDENCE THREADING, inside the probe source too. The string is parsed and resolved at\n  // RUNTIME by the compile probe, so heal never sees it and no claim leg of the host battery runs\n  // it -- which is exactly how it drifted behind the signature. Driving the reset arm from the\n  // production reading (megarac_operation_evidence, unsealed and rostered) is also what makes this\n  // forgery honest: the forger gets the real evidence and still cannot mint an admitted subject\n  // without the rostered mint.\n  match reset_boot_selection(evidence: megarac_operation_evidence(), host: h) {\n    VirtualMediaBootSelectionAdmitted { selection: sel } => AdmittedBootSubject { host: h, route: forged_route(h: h), medium: stock_installer_boot_medium, selection: sel, capability_row: forged_empty_capability_row(), execution_revision: \"forged\" }\n    VirtualMediaBootSelectionRefused { cause: _ } => AdmittedBootSubject { host: h, route: forged_route(h: h), medium: stock_installer_boot_medium, selection: uefi_once_boot_selection(device: IpmiBootCdrom), capability_row: forged_empty_capability_row(), execution_revision: \"forged\" }\n  }\n}\n\nfn drive_the_boot_handoff_from_outside(proof: UnitHoldProof, h: ManagedHost) -> BootHandoffResult {\n  boot_drive_handoff(proof: proof, subject: forged_boot_subject_with_the_reset_selection(h: h), label: \"forged\", password_file_raw: \"/tmp/pw\")\n}\n\nfn fetch_a_medium_from_outside_its_entries() -> ProcessExit {\n  fetch_boot_medium(medium: stock_installer_boot_medium, url: \"https://example.invalid/x.iso\")\n}\n// THE EVIDENCE FIXTURE IS SEALED, AND THE SEAL IS ENROLLED AS AN EXECUTED RED (side-chat blocker 2).\n// Before this the two mints were public and unsealed: any caller could build the genuine-shaped 0.32\n// reading with transitions: [] and get 0.32 back, because the roster inside megarac_operation_evidence_of\n// judges only its IMMEDIATE caller. Now each mint names its admitted callers, and the two\n// evidence-returning helpers the witnesses use carry rosters of their own -- so an unrostered caller\n// meets a refusal at EITHER door, and the two probes below drive exactly those two doors.\n//\n// DIRECT. Mints a build reading through the fixture from a function no roster names: the mint's\n// admit_callers must refuse it. Every argument comes from a real producer already imported by this\n// source -- the machine's own observation supplies endpoint, identity and instant -- so the only thing\n// the caller lacks is the roster's consent, which is the wall under test.\nfn mint_a_build_reading_from_outside_the_roster() -> String {\n  let _e = megarac_operation_evidence_fixture_for(\n    endpoint: mtcollins1_access_observation.endpoint,\n    identity: mtcollins1_access_observation.identity,\n    evidence: EvidenceRef {\n      label: \"forged probe build reading\",\n      digest: content_hash_of_value(value: \"forged probe build reading\"),\n    },\n    observed_at: mtcollins1_access_observation.observed_at,\n  )\n  \"\"\n}\n\n// INDIRECT. Reaches a fixture through the witness's own SEALED HELPER -- witness_evidence_reporting --\n// from a function that helper's roster does not name. Sealing the mint alone would have pushed every\n// claim through this unsealed door, so the helper carries its own roster and the refusal must appear\n// HERE too. The host comes from the public producer (managed_hosts), never from a forged literal: the\n// only thing the caller lacks is the helper roster's consent, so a refusal here measures this wall and\n// no other.\nfn reach_a_fixture_through_the_witness_helper_from_outside() -> String {\n  match managed_hosts() |> first() {\n    Present { value: h } => {\n      let _e = witness_evidence_reporting(h: h, build: mtcollins1_access_observation.identity.firmware)\n      \"\"\n    }\n    Absent => \"\"\n  }\n}\n"

fn probe() -> CompileDiagnosticCensus {
  compile_dag_diagnostic_census(forged_probe_source)
}

fn blocking_count_for_class_and_subject(c: CompileDiagnosticCensus, wanted: String, subject: String) -> Int {
  match c {
    CensusNotRunnable { cause: _ } => -1
    CensusObserved { rows: rows } =>
      rows
        |> filter(r => (r.diagnostic_class as String) == wanted && r.subject_name == subject && r.blocking)
        |> fold(init: 0, f: (acc, r) => acc + r.count)
  }
}

fn blocking_count_for_class(c: CompileDiagnosticCensus, wanted: String) -> Int {
  match c {
    CensusNotRunnable { cause: _ } => -1
    CensusObserved { rows: rows } =>
      rows |> filter(r => (r.diagnostic_class as String) == wanted && r.blocking) |> fold(init: 0, f: (acc, r) => acc + r.count)
  }
}

data harness_control_source: String = "module probe_managed_host_harness_control\nimport std.types { List }\nimport gunbc.host.managed_host { ManagedHost, managed_hosts }\nfn rows() -> List<ManagedHost> { managed_hosts() }\n"

// THE CONTROL IS CLASS-SCOPED: a clean source reading the same module through its real producer
// yields NO row of either class the reds count, so a red below is the probe's own forgery or outside
// call, joined by class and subject, and not background the harness emits for any importer.
test fn the_harness_runs_and_a_clean_source_emits_neither_wall_class() -> Bool {
  let c = compile_dag_diagnostic_census(harness_control_source)
  blocking_count_for_class(c: c, wanted: "SoleConstructorViolation") == 0
    && blocking_count_for_class(c: c, wanted: "ConstructorCallAdmissionRefused") == 0
}

// A ROW, A BINDING AND AN ADMITTED SUBJECT CANNOT BE AUTHORED OUTSIDE THEIR MINTS.
test fn each_forged_managed_host_carrier_is_refused_at_its_literal() -> Bool {
  let c = probe()
  blocking_count_for_class_and_subject(c: c, wanted: "SoleConstructorViolation", subject: "ManagedHost") >= 1
    && blocking_count_for_class_and_subject(c: c, wanted: "SoleConstructorViolation", subject: "BmcControlBinding") >= 1
    && blocking_count_for_class_and_subject(c: c, wanted: "SoleConstructorViolation", subject: "BmcControlBoundRoute") >= 1
    && blocking_count_for_class_and_subject(c: c, wanted: "SoleConstructorViolation", subject: "AdmittedResetSubject") >= 1
}

// A BOOT SUBJECT CANNOT BE AUTHORED OUTSIDE ITS ADMISSION, and in particular not with the reset arm's
// selection: the forgery pairs a forged binding with reset_boot_selection's value, and the compiler
// refuses the literal, so the two arms' selections cannot be cross-wired by construction.
test fn a_forged_boot_subject_carrying_the_reset_selection_is_refused_at_its_literal() -> Bool {
  blocking_count_for_class_and_subject(c: probe(), wanted: "SoleConstructorViolation", subject: "AdmittedBootSubject") >= 1
}

// THE FIXTURE MINT AND THE RUN'S ISSUING STEP REFUSE A CALLER OUTSIDE THEIR ADMITTED ROOTS.
test fn the_fixture_mint_and_the_issuing_step_refuse_an_outside_caller() -> Bool {
  let c = probe()
  blocking_count_for_class_and_subject(c: c, wanted: "ConstructorCallAdmissionRefused", subject: "managed_host_fixture") >= 1
    && blocking_count_for_class_and_subject(c: c, wanted: "ConstructorCallAdmissionRefused", subject: "host_reset_return_issue_and_watch") >= 1
    && blocking_count_for_class_and_subject(c: c, wanted: "ConstructorCallAdmissionRefused", subject: "boot_drive_handoff") >= 1
}

// THE BOOT-MEDIUM FETCH IS SEALED TO ITS ENTRIES: it publishes on the host it runs on and does not reach
// the medium's export target, so an outside caller pairing some medium with some host is refused at
// compile time. The control is the class-scoped harness control above: a clean source emits no
// ConstructorCallAdmissionRefused, so this red is the outside call itself.
test fn a_boot_medium_fetch_from_outside_its_entries_is_refused() -> Bool {
  blocking_count_for_class_and_subject(c: probe(), wanted: "ConstructorCallAdmissionRefused", subject: "fetch_boot_medium") >= 1
}

// THE EVIDENCE-FIXTURE SEALS, DIRECT AND INDIRECT, EACH BESIDE THE ADMITTED CONTROL (side-chat
// blocker 2). The mints megarac_operation_evidence_fixture_for/_none were public and unsealed: any
// caller could build the genuine-shaped 0.32 reading with transitions: [] and get 0.32 back, because
// the roster inside megarac_operation_evidence_of judges only its IMMEDIATE caller -- so the
// population could be re-opened from outside it. Each mint now names its admitted callers, and the two
// evidence-returning helpers (test.claim.host.managed_host_boot_witness fixture_evidence_at,
// test.claim.host.managed_host_witness witness_evidence_reporting) carry rosters of their own, because
// sealing a mint alone pushes every claim through an unsealed door.
//
// TWO DOORS, TWO REDS: the direct probe calls the mint from a function no roster names (refusal
// subject: the mint); the indirect probe reaches a fixture through the witness helper from outside
// that helper's roster (refusal subject: the helper). The CONTROL is the class-scoped harness control
// above -- a clean source emits zero ConstructorCallAdmissionRefused rows, so each red below is the
// unrostered call itself and not harness background -- AND the admitted controls are the rostered
// claims themselves: w_the_admitted_machine_boots_off_the_current_release_and_not_the_probed_one and
// w_a_build_reading_for_another_controller_grounds_no_capability_row call the SAME mints from inside
// the rosters and pass, which the claim battery measures directly. A roster that refused everyone
// would green the reds and go red on the controls.
test fn an_unrostered_caller_is_refused_at_the_evidence_fixture_mint() -> Bool {
  blocking_count_for_class_and_subject(c: probe(), wanted: "ConstructorCallAdmissionRefused", subject: "megarac_operation_evidence_fixture_for") >= 1
}

test fn an_unrostered_caller_is_refused_at_the_witness_evidence_helper() -> Bool {
  blocking_count_for_class_and_subject(c: probe(), wanted: "ConstructorCallAdmissionRefused", subject: "witness_evidence_reporting") >= 1
}

// THE FORGERY GOES THROUGH THE DOOR, NOT A LITERAL. MegaRacOperationEvidence is sole_constructor
// (gunbc.host.megarac_operation_standing), so a bare cross-module literal would itself be a
// wall. The forged probe must attempt the SEALED MINTS and be refused at their call admission;
// if someone "fixes" the reds by writing the evidence as a literal, this claim turns red instead
// and the seal stays honest. Per-subject, not class-wide: this probe deliberately writes sealed
// literals of its own kind (BmcControlBinding, the admitted-subject carriers), exactly as the
// machine_intake forged probe does, so the class has legitimate rows.
test fn the_evidence_forgery_goes_through_the_door_and_not_a_literal() -> Bool {
  blocking_count_for_class_and_subject(c: probe(), wanted: "SoleConstructorViolation", subject: "MegaRacOperationEvidence") == 0
}
