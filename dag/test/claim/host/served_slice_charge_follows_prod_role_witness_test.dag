module test.claim.host.served_slice_charge_follows_prod_role_witness_test

// The served deployment's slice charge lands on the host of the prod-role holder, not on the literal
// srv1. The realization is supplied (the resolver is judged in test.claim.prod_role_realization_witness_test);
// the inhabitance claim runs the real prod_role_realization route.

import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.types { Bool, List }
import product.host_identity { HostIdentity }
import gunbc.fleet_host_identity { operator_host_srv1, operator_host_srv2 }
import gunbc.deployment_risk { NoProdRole, ProdRoleHeldBy, srv2_deploy_deployment }
import gunbc.roadmap_dashboard_instance { HostDashboardInstance, prod_role_realization_in, srv1_live_dashboard_instance, srv2_deploy_dashboard_instance }
import gunbc.live_deploy.served_slice_charge {
  host_served_deployment_claim,
  host_served_deployment_claim_under,
  served_deployment_placement_of,
  ServedDeploymentClaimResolved,
  ServedDeploymentClaimUnmeasured,
  ServedDeploymentNotPlaced,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn roster() -> List<HostDashboardInstance> {
  [srv1_live_dashboard_instance(), srv2_deploy_dashboard_instance()]
}

test fn moving_the_role_moves_the_charge_off_srv1() -> Bool {
  let moved = served_deployment_placement_of(realization: prod_role_realization_in(selection: ProdRoleHeldBy { deployment: srv2_deploy_deployment }, instances: roster()))
  match host_served_deployment_claim_under(host: operator_host_srv2, placement: moved) {
    ServedDeploymentClaimResolved { memory: _ } =>
      match host_served_deployment_claim_under(host: operator_host_srv1, placement: moved) {
        ServedDeploymentNotPlaced => true
        _ => false
      }
    _ => false
  }
}

test fn no_prod_role_refuses_the_charge_and_never_falls_back_to_srv1() -> Bool {
  let none_held = served_deployment_placement_of(realization: prod_role_realization_in(selection: NoProdRole, instances: roster()))
  match host_served_deployment_claim_under(host: operator_host_srv1, placement: none_held) {
    ServedDeploymentClaimUnmeasured { cause: _ } => true
    _ => false
  }
}

// REAL ROUTE: the production switch, unsupplied, charges the holder's host.
test fn the_real_route_charges_the_holders_host() -> Bool {
  match host_served_deployment_claim(host: srv1_live_dashboard_instance().host_identity as HostIdentity) {
    ServedDeploymentClaimResolved { memory: _ } => true
    _ => false
  }
}
