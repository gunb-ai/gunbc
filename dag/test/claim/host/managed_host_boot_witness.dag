data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data revision: NonEmptyStr = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

fn observation_at(o: BmcAccessObservation, host: String) -> BmcAccessObservation {
  BmcAccessObservation {
    endpoint: BmcControllerEndpoint { host: host as NonEmptyStr },
    identity: o.identity,
    discovered_surfaces: o.discovered_surfaces,
    boot_control_routes: o.boot_control_routes,
    redfish_virtual_media_probe: o.redfish_virtual_media_probe,
    successful_read_surfaces: o.successful_read_surfaces,
    successful_write_surfaces: o.successful_write_surfaces,
    raw_response: o.raw_response,
    observed_at: o.observed_at,
  }
}

// THE REAL PATH: mtcollins1's one managed-host row admits a boot with the medium Mt. Collins boots
// today, and the subject carries that medium, the boot arm's own one-shot CD selection, and the
// binding's controller. This is the inhabitance claim for gunbc.host.managed_host_boot AdmittedBootSubject:
// the subject the boot run reads is minted from the real row, not supplied.
test fn w_the_real_row_admits_a_boot_with_its_medium_and_the_boot_selection() -> Bool {
  match boot_subject_admission_for(host: operator_host_mtcollins1, medium: mtcollins1_boot_medium, execution_revision: revision) {
    BootSubjectRefused { host: _, cause: _ } => false
    BootSubjectAdmitted { subject: s } =>
      (s.medium.image_name as String) == "gunbc-mtcollins1-census-ubuntu-24.04.3-arm64-161b98b9bb389a80.iso"
        && (s.medium.digest as String) == "161b98b9bb389a803805b582203fe73fa9a3ec421e3783b6463528124c2bd513"
        && (s.medium.export.dir as String) == "/srv/bmc"
        && (boot_subject_machine(subject: s) as String) == "mtcollins1"
        && (s.execution_revision as String) == (revision as String)
        && s.selection.architecture == Aarch64
        && s.selection.firmware_mode == IpmiBootEfi
        && s.selection.persistence == IpmiBootOnce
        && s.selection.device == IpmiBootCdrom
        && (ipmi_boot_selection_label(selection: s.selection) as String) == "cdrom/efi/once"
  }
}

// RED: A HOST THAT IS NOT A MANAGED HOST. srv1 is a fleet host with no managed-host row, so its boot
// is refused by that cause before any binding is read; the same admission over the real rows names
// mtcollins1 admitted, so the refusal is the missing row and not an empty roster.
test fn w_a_boot_of_a_host_that_is_not_managed_is_refused() -> Bool {
  let refused = match boot_subject_admission_for(host: operator_host_srv1, medium: mtcollins1_boot_medium, execution_revision: revision) {
    BootSubjectRefused { host: h, cause: BootSubjectHostNotManaged } => (h as String) == (operator_host_srv1 as String)
    _ => false
  }
  let admitted = match boot_subject_admission_in(hosts: managed_hosts(), host: operator_host_mtcollins1, medium: mtcollins1_boot_medium, execution_revision: revision) {
    BootSubjectAdmitted { subject: _ } => true
    BootSubjectRefused { host: _, cause: _ } => false
  }
  refused && admitted
    && (match boot_subject_admission_refusal(admission: boot_subject_admission_for(host: operator_host_srv1, medium: mtcollins1_boot_medium, execution_revision: revision)) {
      Present { value: t } => string_contains(s: t as String, pattern: "not a managed host")
      Absent => false
    })
}

// RED: AN UNBOUND HOST. The real row's secured account is kept beside an access observation of
// another controller; the binding refuses the pair, so no boot subject is minted for it -- unit A's
// account can never drive unit B's controller.
test fn w_a_boot_of_an_unbound_host_is_refused() -> Bool {
  managed_hosts() |> all(h => {
    let crossed = match h.access {
      BmcAccessUnobserved { endpoint: _ } => h
      BmcAccessObserved { observation: o } =>
        managed_host_fixture(host: h.host, access: BmcAccessObserved { observation: observation_at(o: o, host: "fixture-other-bmc") }, secure: h.secure, unit_hold: h.unit_hold, smpro: h.smpro)
    }
    match admit_boot_subject(host: crossed, medium: mtcollins1_boot_medium, execution_revision: revision) {
      BootSubjectRefused { host: _, cause: BootSubjectHostUnbound { standing: BmcControlEndpointMismatch { observed: ob, secured: _ } } } => (ob.host as String) == "fixture-other-bmc"
      _ => false
    }
  }) && count(managed_hosts()) == 1
}

// RED: A BOUND HOST ITS CONTROLLER CANNOT GIVE A SELECTION TO. The real row's standings are kept
// under a host name whose controller row carries no virtual-media capability, so the derived boot
// selection refuses and the boot is refused as selection-less: a bound controller is not a bootable
// host until its boot policy is decided, and the refusal is the capability row's, not a host-name
// branch.
test fn w_a_bound_host_with_no_boot_selection_is_refused() -> Bool {
  managed_hosts() |> all(h => {
    // (d) NO PER-UNIT ROW DECIDES THIS: the decider reads the capability row from the firmware
    // release the access observation REPORTS (the per-release catalog lookup). A build the catalog
    // has not yet read is uncatalogued, so the row does not resolve and the selection refuses with
    // its cause named -- no media-less per-unit datum is needed.
    let uncatalogued = bmc_firmware_release_identity_of_wire(family: AmiMegaRac, wire: "9.9.9")
    let unselected = managed_host_fixture(host: "fixture-uncatalogued-build", access: host_access_repoint_firmware(access: h.access, firmware: uncatalogued), secure: h.secure, unit_hold: h.unit_hold, smpro: h.smpro)
    match admit_boot_subject(host: unselected, medium: mtcollins1_boot_medium, execution_revision: revision) {
      BootSubjectRefused { host: x, cause: BootSubjectNoSelection { cause: _ } } => (x as String) == "fixture-uncatalogued-build"
      _ => false
    }
  }) && count(managed_hosts()) == 1
}

// RED AND CONTROL: A MEDIUM WHOSE READBACK DIGEST DIFFERS IS REFUSED. The census medium read back as
// the stock installer's bytes is refused, naming both digests; read back as its own digest it holds.
test fn w_a_medium_read_back_with_another_digest_is_refused() -> Bool {
  let held = match boot_medium_readback(medium: mtcollins1_boot_medium, observed: mtcollins1_boot_medium.digest) {
    BootMediumReadbackHeld => true
    BootMediumReadbackDigestDiffers { image_name: _, expected: _, observed: _ } => false
  }
  let differs = boot_medium_readback(medium: mtcollins1_boot_medium, observed: stock_installer_boot_medium.digest)
  let refused = match differs {
    BootMediumReadbackHeld => false
    BootMediumReadbackDigestDiffers { image_name: n, expected: e, observed: o } =>
      (n as String) == (mtcollins1_boot_medium.image_name as String)
        && (e as String) == (mtcollins1_boot_medium.digest as String)
        && (o as String) == (stock_installer_boot_medium.digest as String)
  }
  held && refused
}

// THE TWO ARMS DECIDE THEIR OWN SELECTIONS. Neither admission takes a selection as a parameter, so the
// reset arm's value cannot be handed to a boot; the forged-carrier probe
// (test.claim.host.managed_host_forged_probe_witness) pins that an AdmittedBootSubject cannot be authored
// with one. This claim executes both deciders over the real row: each decides one for mtcollins1 and
// the boot subject carries the boot arm's, from its own authority.
test fn w_the_reset_and_boot_arms_each_decide_their_own_selection() -> Bool {
  managed_hosts() |> all(h => match boot_selection(host: h) {
    VirtualMediaBootSelectionRefused { cause: _ } => false
    VirtualMediaBootSelectionAdmitted { selection: b } => match reset_boot_selection(host: h) {
      VirtualMediaBootSelectionRefused { cause: _ } => false
      VirtualMediaBootSelectionAdmitted { selection: _ } => match admit_boot_subject(host: h, medium: mtcollins1_boot_medium, execution_revision: revision) {
        BootSubjectAdmitted { subject: s } => (ipmi_boot_selection_label(selection: s.selection) as String) == (ipmi_boot_selection_label(selection: b) as String)
        BootSubjectRefused { host: _, cause: _ } => false
      }
    }
  }) && count(managed_hosts()) == 1
}

// RED1: A SECOND MACHINE WITH THE SAME CONTROLLER PROFILE GETS THE SAME SELECTION WITH NO CODE
// CHANGE. The real row's standings are kept under a host name that is not mtcollins1, with the same
// board and the same controller capability row. The generic derivation reads the selection off the
// board architecture and the row's virtual-media capability -- not off a host-name branch -- so the
// second machine admits the SAME selection mtcollins1 admits. No data row for the new host is
// needed; the code path is the same fn.
test fn w_a_second_machine_with_the_same_profile_gets_the_same_selection() -> Bool {
  managed_hosts() |> all(h => {
    let second = managed_host_fixture(host: "fixture-second-machine", access: h.access, secure: h.secure, unit_hold: h.unit_hold, smpro: h.smpro)
    match boot_selection(host: second) {
      VirtualMediaBootSelectionRefused { cause: _ } => false
      VirtualMediaBootSelectionAdmitted { selection: second_sel } => match boot_selection(host: h) {
        VirtualMediaBootSelectionRefused { cause: _ } => false
        VirtualMediaBootSelectionAdmitted { selection: real_sel } => (ipmi_boot_selection_label(selection: second_sel) as String) == (ipmi_boot_selection_label(selection: real_sel) as String)
      }
    }
  }) && count(managed_hosts()) == 1
}

// (d) RED: A REFASH CHANGES THE UNIT'S REPORTED BUILD, AND THE LOOKUP FOLLOWS IT. The capability row
// is a per-release fact: the same unit observed at the catalogued 0.32 build resolves that build's row
// and admits its selection; observed at a build the catalog has not yet read, it refuses with the
// uncatalogued cause -- with NO per-unit edit, because no per-unit row exists to go stale. This is the
// defect the per-unit mtcollins1_capability_row datum had: a reflash would have left it describing the
// old build. The next boot's pre-power hpm check is the reading that would catalogue the new build.
test fn w_a_reflash_resolves_the_new_builds_row_or_refuses_with_no_per_unit_edit() -> Bool {
  managed_hosts() |> all(h => {
    // The unit observed at its catalogued build resolves and admits.
    let at_0_32 = match boot_selection(host: h) {
      VirtualMediaBootSelectionRefused { cause: _ } => false
      VirtualMediaBootSelectionAdmitted { selection: _ } => true
    }
    // The same unit observed at a build the catalog has not read refuses, with no per-unit edit.
    let new_build = bmc_firmware_release_identity_of_wire(family: AmiMegaRac, wire: "9.9.9")
    let reflashed = managed_host_fixture(host: "fixture-reflash-build", access: host_access_repoint_firmware(access: h.access, firmware: new_build), secure: h.secure, unit_hold: h.unit_hold, smpro: h.smpro)
    let refused_uncatalogued = match boot_selection(host: reflashed) {
      VirtualMediaBootSelectionRefused { cause: VirtualMediaUnestablished } => true
      _ => false
    }
    at_0_32 && refused_uncatalogued
  }) && count(managed_hosts()) == 1
}

// THE ANTI-FABRICATION INVARIANT, claim-by-claim over the catalog: a row may call its firmware version
// MACHINE-READ only when its own evidence records an instrument reading it. The 0.32 row does (a committed
// hpm readback); the 0.45.3 row must NOT, because the run joined to it read no version and the version came
// from an operator's page read. Relabel that row MegaRacVersionMachineRead and this claim goes red even
// though every boot still admits — which is the point: 'the controller told us' must not be reachable by
// editing a label, and a boot's admission is not the evidence for it.
test fn w_the_catalog_never_labels_an_unread_build_machine_read() -> Bool {
  // Every row is internally coherent: a machine-read standing implies run evidence that read THIS release.
  let all_coherent = megarac_release_capability_catalog
    |> all(e => megarac_release_entry_is_coherent(entry: e))
  // Exactly one row is machine-read today, and it is the one backed by a committed instrument readback.
  let machine_read_rows = megarac_release_capability_catalog
    |> filter(e => megarac_release_version_is_machine_read(entry: e))
  let exactly_one_machine_read = count(machine_read_rows) == 1
  // ...and the 0.45.3 row is NOT among them, so the boot that admits against it is admitting on an
  // operator attestation, which is what its record says.
  let at_0_45_3_attested = match megarac_release_capability_catalog
    |> filter(e => bmc_firmware_release_identity_eq(a: e.row.firmware, b: megarac_firmware_0_45_3))
    |> first() {
    Present { value: e } => megarac_release_version_is_machine_read(entry: e) == false
      && megarac_release_entry_is_coherent(entry: e)
    Absent => false
  }
  all_coherent && exactly_one_machine_read && at_0_45_3_attested
}

// (d) RED, the real reflash: the unit moved 0.32 -> 0.45.3 on 2026-10-02. Observed at 0.45.3, the
// lookup resolves THAT build's catalog row -- a different row from 0.32's (the resolved rows carry the
// 0.45.3 release identity) -- and the boot selection still admits, so the boot does not refuse as
// uncatalogued once the observation records 0.45.3. No per-unit row was edited; the same generic
// derivation followed the reported build.
test fn w_the_observed_reflash_to_0_45_3_resolves_that_builds_row_and_still_admits() -> Bool {
  managed_hosts() |> all(h => {
    let at_0_45_3 = managed_host_fixture(host: "fixture-at-0-45-3", access: host_access_repoint_firmware(access: h.access, firmware: megarac_firmware_0_45_3), secure: h.secure, unit_hold: h.unit_hold, smpro: h.smpro)
    let admitted = match boot_selection(host: at_0_45_3) {
      VirtualMediaBootSelectionRefused { cause: _ } => false
      VirtualMediaBootSelectionAdmitted { selection: _ } => true
    }
    // the resolved row is the 0.45.3 build's own row, not 0.32's
    let resolves_the_new_row = match host_capability_row(access: at_0_45_3.access) {
      HostCapabilityRowKnown { row: row } => row.firmware.raw_version == "0.45.3"
      _ => false
    }
    admitted && resolves_the_new_row
  }) && count(managed_hosts()) == 1
}

// THE STOCK INSTALLER ROW IS ITS UPSTREAM ROW: the filename and digest cdimage's SHA256SUMS cites.
test fn w_the_stock_installer_medium_is_read_off_its_upstream_row() -> Bool {
  (stock_installer_boot_medium.image_name as String) == "ubuntu-24.04.3-live-server-arm64.iso"
    && (stock_installer_boot_medium.digest as String) == "2ee2163c9b901ff5926400e80759088ff3b879982a3956c02100495b489fd555"
    && (stock_installer_boot_medium.export.dir as String) == "/srv/bmc"
}

// THE HANDOFF REFUSES AN EMPTY CREDENTIAL PATH BEFORE ANY CONTROLLER WRITE, as the unit's handoff did:
// the empty path is a typed missing input, never a placeholder filename handed to ipmitool.
test fn w_an_empty_credential_path_is_missing_not_a_filename() -> Bool {
  (match boot_handoff_password_file(raw: "") { CredentialPathMissing => true  CredentialPathGiven { path: _ } => false })
    && (match boot_handoff_password_file(raw: "/run/pw") { CredentialPathGiven { path: p } => (p as String) == "/run/pw"  CredentialPathMissing => false })
}

// THE ADMISSION PROBE OVER EVERY MANAGED HOST'S REAL ROWS: each row admits its controller through its
// binding and its empty-capability control refuses, so the fold discriminates on live data. The
// unbound arm is the RED: the same row beside another controller's access is reported, not probed.
test fn w_the_handoff_admission_discriminates_on_every_managed_hosts_rows() -> Bool {
  managed_hosts() |> all(h => {
    let real = match boot_handoff_admission_probe_of(host: h) { Absent => true  Present { value: _ } => false }
    let crossed = match h.access {
      BmcAccessUnobserved { endpoint: _ } => h
      BmcAccessObserved { observation: o } =>
        managed_host_fixture(host: h.host, access: BmcAccessObserved { observation: observation_at(o: o, host: "fixture-other-bmc") }, secure: h.secure, unit_hold: h.unit_hold, smpro: h.smpro)
    }
    let red = match boot_handoff_admission_probe_of(host: crossed) { Present { value: why } => string_contains(s: why, pattern: "observed and secured controllers differ")  Absent => false }
    real && red
  }) && count(managed_hosts()) == 1
}

// THE MANAGER'S DRIFT RED: A ROW THAT DISAGREES WITH ITS OWN EVIDENCE REFUSES BEFORE ANY EFFECT.
// The catalog has ONE release key (entry.row.firmware), so a drifted entry cannot be built by
// authoring -- which is exactly why it needs a claim, not a comment: "structurally impossible" was
// the claim that let the old code delete its mismatch refusal. A supplied table is the only way to
// reach the state, and the three shipped entry points all pass the shipped catalog through these same
// implementations, so the refusal cannot be routed around.
//
// The drifted entry: keyed 0.45.3, machine-read standing, and its executed run's own bytes read 0.32.
// That is a row borrowing a run it does not belong to -- a capability set corroborated by evidence
// about a different build. Every public path must refuse it.
// The drifted entry, AUTHORED FIELD BY FIELD rather than derived from the shipped table: a
// derivation would inherit the shipped row's agreement with its own evidence and quietly stop being a
// drift. The forged parts are marked; the release identities, the capability set and the run id are
// the shipped ones, so only the disagreement is invented.
fn drifted_release_entry() -> MegaRacReleaseCapabilityEntry {
  MegaRacReleaseCapabilityEntry {
    // The release this row is keyed by -- the catalog's single key is exactly this field.
    row: BmcFirmwareReleaseCapabilityRow {
      firmware: megarac_firmware_0_45_3,
      capabilities: [
        CapabilityBootSourceOverride,
        CapabilityPowerControl,
        CapabilityOemRemoteMedia,
      ],
    },
    // FORGED: the row CLAIMS a machine read, which is the standing under which a row's release is
    // supposed to rest on a machine read of its own build.
    version: MegaRacVersionMachineRead {
      read_from: "a forged pre-power hpm check -- no such read exists",
    },
    // THE REAL RUN, whose committed bytes read NO version (the shipped value's own wording). A
    // machine-read standing beside an executed run that read nothing is the disagreement: capabilities
    // presented as machine-established on evidence that establishes nothing about the release.
    evidence: megarac_run_38789347052_evidence,
    citations: [bmc_capability_observation_citation(decl_name: "drifted_release_entry")],
  }
}

test fn w_a_row_its_own_evidence_does_not_support_refuses_on_every_public_path() -> Bool {
  let drifted = [drifted_release_entry()]
  match managed_hosts() |> first() {
    // An empty fixture set would make every assertion below vacuously true, so it is a refusal rather
    // than a silent pass: a claim that cannot see its subject has not established anything.
    Absent => false
    Present { value: h } => {
    // 1. THE CAPABILITY ROW refuses, rather than handing out a capability set its evidence does not
    // support -- and it names WHICH release it refused, so a witness can tell "refused" from "silent".
    let row_refuses = match host_capability_row_in(table: drifted, access: h.access) {
      HostCapabilityRowIncoherent { firmware: f } =>
        bmc_firmware_release_identity_eq(a: f, b: megarac_firmware_0_45_3)
      _ => false
    }
    // 2. BOOT SELECTION refuses BEFORE any effect: no selection, so no attach, no override, no cycle.
    let boot_refuses = match boot_selection_in(table: drifted, host: h) {
      VirtualMediaBootSelectionRefused { cause: _ } => true
      VirtualMediaBootSelectionAdmitted { selection: _ } => false
    }
    // 3. THE PUBLIC OUT-OF-BAND HANDOFF refuses: a host whose row cannot be trusted hands off nothing.
    let handoff_refuses = match h.access {
      BmcAccessObserved { observation: o } =>
        match oob_boot_handoff_admission_in(table: drifted, observation: o) {
          OobHandoffRowIncoherent { firmware: f } =>
            bmc_firmware_release_identity_eq(a: f, b: megarac_firmware_0_45_3)
          _ => false
        }
      BmcAccessUnobserved { endpoint: _ } => false
    }
    // AND THE CONTROL, without which all three refusals above would pass on a lookup that refused
    // everything: the shipped table, whose rows agree with their own evidence, resolves and selects.
    let shipped_resolves = match host_capability_row(access: h.access) {
      HostCapabilityRowKnown { row: row } =>
        bmc_firmware_release_identity_eq(a: row.firmware, b: megarac_firmware_0_45_3)
      _ => false
    }
    let shipped_boot = match boot_selection(host: h) {
      VirtualMediaBootSelectionAdmitted { selection: _ } => true
      VirtualMediaBootSelectionRefused { cause: _ } => false
    }
      row_refuses && boot_refuses && handoff_refuses && shipped_resolves && shipped_boot
    }
  }
}

// THE ATTESTATION INSTANT MEANS WHAT IT SAYS (review 81301, blocking). The draft declared
// origin "mtcollins1-bmc-web-ui-2026-10-16" and then stored the Unix-epoch offset in since_origin,
// which asserted the operator's read happened about 56.8 years after its own origin. std.measure
// only orders instants WITHIN one domain, so the defect stayed invisible until something compared
// two same-domain readings -- and then it would subtract to nonsense rather than refuse. This claim
// pins both halves: the count sits at the day it names in the domain it names, and a reading in a
// DIFFERENT domain comes away incomparable rather than nonsense.
test fn w_the_operator_attestation_instant_is_coherent_with_its_own_origin() -> Bool {
  let attested = megarac_0_45_3_operator_attestation_instant
  // The count, read as an offset from the epoch, is 2026-10-16T00:00:00Z: 1792108800 seconds at
  // nanosecond scale. Derived and checked against `date -u -d @1792108800`, not typed from memory.
  let epoch_days = nanosecond_count(n: attested.since_origin) == 1792108800000000000
  // The origin is the epoch itself, which is what makes that count mean 2026-10-16 rather than
  // "56.8 years after the day being read".
  let epoch_domain = match attested.domain {
    SharedMonotonic { origin: o } => (o as String) == "unix-epoch-1970-01-01T00:00:00Z"
    ProcessMonotonic { process: _ } => false
  }
  // A second reading in the SAME domain and basis subtracts sanely: five minutes later is after,
  // not 56.8-years-plus-five-minutes after its own origin.
  let later = ObservationInstant {
    domain: SharedMonotonic { origin: "unix-epoch-1970-01-01T00:00:00Z" },
    basis: WallClock,
    since_origin: nanosecond(count: 1792108800000000000 + 300000000000),
  }
  let same_domain_orders = match compare_instants(a: attested, b: later) {
    InstantBefore => true
    InstantSame => false
    InstantAfter => false
    InstantIncomparable { left: _, right: _ } => false
  }
  // AND THE REFUSAL: the same reading in ANOTHER domain does not compare at all. This is the half
  // the defect would have hidden -- the old origin, if anything had compared against it, produced a
  // plausible number instead of refusing.
  let other_domain = ObservationInstant {
    domain: SharedMonotonic { origin: "mtcollins1-bmc-web-ui-2026-10-16" },
    basis: WallClock,
    since_origin: attested.since_origin,
  }
  let cross_domain_refuses = match compare_instants(a: attested, b: other_domain) {
    InstantIncomparable { left: _, right: _ } => true
    InstantBefore => false
    InstantSame => false
    InstantAfter => false
  }
  // The instant is the one the 0.45.3 row actually rests on, and the day-resolution of the reading
  // is carried as a fact rather than left to the nanosecond field to imply: a date-only reading
  // stored at nanosecond scale is an EARLIEST BOUND, and a consumer needing sub-day ordering has to
  // be told it does not have it.
  // THE ROW ACTUALLY RESTS ON THIS INSTANT -- the strongest form of the claim, and the only one here
  // worth having: the 0.45.3 row's attestation is the same instant, in the same domain, down to the
  // count. (An earlier draft also asserted the row's citation had a non-empty path. That was both
  // unparseable and, once parseable, a §3c existence assertion with no independent referent -- a
  // FactCitation carries {fact: DeclarationRef, authority: ExternalAuthority{uri}}, so the path I
  // named does not even exist. Dropping it loses nothing the claim needs.)
  let row_carries_it = match megarac_release_capability_catalog
    |> filter(e => bmc_firmware_release_identity_eq(a: e.row.firmware, b: megarac_firmware_0_45_3))
    |> first() {
    Present { value: e } => match e.version {
      MegaRacVersionOperatorAttested { attested_on: on, detail: _, upgrade_read: _ } =>
        clock_domain_eq(a: on.domain, b: attested.domain)
        && nanosecond_count(n: on.since_origin) == nanosecond_count(n: attested.since_origin)
        && clock_basis_eq(a: on.basis, b: attested.basis)
      MegaRacVersionMachineRead { read_from: _ } => false
    }
    Absent => false
  }
  epoch_days && epoch_domain && same_domain_orders && cross_domain_refuses && row_carries_it

}
