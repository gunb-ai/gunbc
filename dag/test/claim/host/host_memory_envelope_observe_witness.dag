module test.claim.host.host_memory_envelope_observe_witness

import extdeps.external_authority {
  CitedFigureStanding,
  CitedToAuthority,
  ObservedByReceipt,
  TranscribedUncited,
}
import extdeps.systemd { MemoryLimitUnbounded, MemoryLimitBytes, MemoryLimitAbsent }
import extdeps.linux.cgroup_v2_memory {
  CgroupMemoryEventCounters, CgroupMemoryEventsObserved, CgroupMemoryEventsUnreadable,
  parse_cgroup_memory_events_systemd_property, cgroup_memory_events_wire,
}
import gunbc.fleet.fleet_host_identity { operator_host_srv1, operator_host_srv9 }
import gunbc.host.host_memory_observation { HostMemAvailableQuiescentRead }
import gunbc.host.host_memory_envelope_observe {
  HostMemoryEnvelopeObserved,
  HostMemoryEnvelopeRefused,
  HostMemQuiescentReadObserved,
  HostMemQuiescentReadRefused,
  SliceMemoryReading,
  gunbc_srv1_memory_envelope_sleek_owl_397_first,
  gunbc_srv1_memory_envelope_sleek_owl_397_first_probed_at,
  hermetic_envelope_standing,
  host_mem_available_projection,
  host_memory_envelope_from_meminfo_text,
  host_memory_envelope_includes_slice,
  host_memory_quiescent_read_for_subject,
  host_memory_quiescent_receipt_text,
  systemd_cgroup_memory_limit_wire,
  PeerSliceEventsRead, PeerSliceObserved, PeerSliceUnreadable, peer_show_field,
  host_memory_envelope_receipt_text,
  is_top_level_slice_unit,
  runner_parent_slice_unit,
  slice_current_bytes,
  slice_limit_bytes,
  slice_limit_is_bytes,
  slice_limit_is_unbounded,
  slice_memory_reading,
}
import product.host_identity { host_identity_eq }
import std.algebra { length, string_contains }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.measure { byte_size_count, kibibyte, kibibyte_to_byte_size }
import std.types { Bool, List, NonEmptyStr, String }
import std.process { ProcessExit, ExitSuccess, ExitFailure }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data envelope_meminfo_complete: String = "MemTotal:       16777216 kB\nMemFree:         1048576 kB\nMemAvailable:    8388608 kB\nBuffers:           65536 kB\nCached:          4194304 kB\nSwapTotal:       2097152 kB\nSwapFree:         524288 kB\n"

data envelope_meminfo_without_available: String = "MemTotal:       16777216 kB\nMemFree:         1048576 kB\nBuffers:           65536 kB\nCached:          4194304 kB\nSwapTotal:             0 kB\nSwapFree:              0 kB\n"

fn hermetic_slice_pair() -> List<SliceMemoryReading> {
  [
    slice_memory_reading(slice_unit: "system.slice" as NonEmptyStr, memory_current: slice_current_bytes(n: 1), memory_high: MemoryLimitUnbounded, memory_max: MemoryLimitUnbounded, memory_swap_max: slice_limit_bytes(n: 0), memory_events: CgroupMemoryEventsObserved { counters: CgroupMemoryEventCounters { low: 0, high: 3, max: 1, oom: 0, oom_kill: 0 } }),
    slice_memory_reading(slice_unit: "user.slice" as NonEmptyStr, memory_current: slice_current_bytes(n: 2), memory_high: MemoryLimitUnbounded, memory_max: MemoryLimitUnbounded, memory_swap_max: slice_limit_bytes(n: 0), memory_events: CgroupMemoryEventsUnreadable { detail: "no readable oom_kill=" }),
  ]
}

// PEER-EXECUTOR MEMORY READ witnesses (option (a), 2026-11-23). The self path keeps all its claims above
// untouched (host = subject is byte-for-byte today's behaviour); these cover the new subject branch.

// FAIL-CLOSED (gunbc.design_argument::fail_closed): a subject the anchor does not name -- an unreachable
// host -- REFUSES. It never yields a zero or an absent memory figure, because reporting the memory of a host
// it could not connect to would be a fabricated number on the CI budget. srv9 has no known-hosts anchor row,
// so the read refuses at the anchor gate; an anchored host would resolve and reach the ssh leg.
test fn an_unreachable_subject_refuses_and_never_reports_memory() -> Bool {
  match host_memory_quiescent_read_for_subject(hi: operator_host_srv9) {
    HostMemQuiescentReadRefused { host: _, reason: _ } => true
    HostMemQuiescentReadObserved { read: _, user_work_slice: _ } => false
  }
}

// THE SHAPE the srv14 memory-charge frontier names: the quiescent receipt carries host_total and
// mem_available (the pair trigger (2) requires), so the row authored from the receipt is grounded in the read.
test fn the_quiescent_receipt_carries_host_total_and_mem_available() -> Bool {
  let read = HostMemAvailableQuiescentRead {
    host: operator_host_srv1,
    account: "fleet-automation-peer-executor" as NonEmptyStr,
    read_at: "2026-11-23T00:00:00Z" as NonEmptyStr,
    host_total: kibibyte_to_byte_size(k: kibibyte(count: 16777216)),
    mem_available: kibibyte_to_byte_size(k: kibibyte(count: 8388608)),
  }
  let text = host_memory_quiescent_receipt_text(read: read, user_work_slice: PeerSliceUnreadable { slice_unit: "gunbc-user-work.slice" as NonEmptyStr, reason: "witness supplies no live slice read" })
  string_contains(s: text, pattern: "host=srv1")
    && string_contains(s: text, pattern: "host_total=")
    && string_contains(s: text, pattern: "mem_available=")
}

test fn witness_envelope_from_complete_meminfo_observes() -> Bool {
  match host_memory_envelope_from_meminfo_text(
    host: operator_host_srv1,
    probed_at: gunbc_srv1_memory_envelope_sleek_owl_397_first_probed_at,
    meminfo_text: envelope_meminfo_complete,
    active_runner_unit_count: 10,
    slice_readings: hermetic_slice_pair(),
    standing: hermetic_envelope_standing(),
  ) {
    HostMemoryEnvelopeRefused { host: _, reason: _ } => false
    HostMemoryEnvelopeObserved { observation: obs } =>
      host_identity_eq(a: obs.host, b: operator_host_srv1)
        && (obs.probed_at as String) == (gunbc_srv1_memory_envelope_sleek_owl_397_first_probed_at as String)
        && byte_size_count(b: obs.mem_total) == byte_size_count(b: kibibyte_to_byte_size(k: kibibyte(count: 16777216)))
        && byte_size_count(b: obs.mem_available) == byte_size_count(b: kibibyte_to_byte_size(k: kibibyte(count: 8388608)))
        && byte_size_count(b: obs.swap_total) == byte_size_count(b: kibibyte_to_byte_size(k: kibibyte(count: 2097152)))
        && byte_size_count(b: obs.swap_free) == byte_size_count(b: kibibyte_to_byte_size(k: kibibyte(count: 524288)))
        && obs.active_runner_unit_count == 10
        && length(obs.slice_readings) == 2
  }
}

test fn witness_envelope_missing_memavailable_refuses_not_widens() -> Bool {
  match host_memory_envelope_from_meminfo_text(
    host: operator_host_srv1,
    probed_at: gunbc_srv1_memory_envelope_sleek_owl_397_first_probed_at,
    meminfo_text: envelope_meminfo_without_available,
    active_runner_unit_count: 10,
    slice_readings: [],
    standing: hermetic_envelope_standing(),
  ) {
    HostMemoryEnvelopeObserved { observation: _ } => false
    HostMemoryEnvelopeRefused { host: h, reason: why } =>
      host_identity_eq(a: h, b: operator_host_srv1)
        && string_contains(s: why, pattern: "MemAvailable")
  }
}

test fn witness_top_level_slice_is_direct_child_of_root_cgroup() -> Bool {
  is_top_level_slice_unit(unit: "system.slice" as NonEmptyStr)
    && is_top_level_slice_unit(unit: "sessions.slice" as NonEmptyStr)
    && is_top_level_slice_unit(unit: "user.slice" as NonEmptyStr)
    && is_top_level_slice_unit(unit: "gunbc.slice" as NonEmptyStr)
    && !is_top_level_slice_unit(unit: "system-actions-runner.slice" as NonEmptyStr)
    && !is_top_level_slice_unit(unit: "gunbc-roadmap.slice" as NonEmptyStr)
    && !is_top_level_slice_unit(unit: "-.slice" as NonEmptyStr)
    && !is_top_level_slice_unit(unit: "actions-runner@srv1-01.service" as NonEmptyStr)
}

test fn witness_runner_parent_slice_is_read_though_not_top_level() -> Bool {
  !is_top_level_slice_unit(unit: runner_parent_slice_unit)
    && host_memory_envelope_includes_slice(unit: runner_parent_slice_unit)
    && (runner_parent_slice_unit as String) == "system-actions-runner.slice"
}

test fn witness_envelope_projects_host_mem_available_observation() -> Bool {
  match host_memory_envelope_from_meminfo_text(
    host: operator_host_srv1,
    probed_at: gunbc_srv1_memory_envelope_sleek_owl_397_first_probed_at,
    meminfo_text: envelope_meminfo_complete,
    active_runner_unit_count: 0,
    slice_readings: [],
    standing: hermetic_envelope_standing(),
  ) {
    HostMemoryEnvelopeRefused { host: _, reason: _ } => false
    HostMemoryEnvelopeObserved { observation: obs } =>
      let proj = host_mem_available_projection(obs: obs)
      host_identity_eq(a: proj.host, b: obs.host)
        && byte_size_count(b: proj.host_total) == byte_size_count(b: obs.mem_total)
        && byte_size_count(b: proj.mem_available) == byte_size_count(b: obs.mem_available)
  }
}

test fn witness_sleek_owl_397_receipt_instant_is_the_srv1_reading() -> Bool {
  (gunbc_srv1_memory_envelope_sleek_owl_397_first_probed_at as String) == "2026-10-14T00:10:39Z"
}

fn standing_is_sleek_owl_first(s: CitedFigureStanding) -> Bool {
  match s {
    TranscribedUncited { read_obligation: o } =>
      string_contains(s: o as String, pattern: "sleek-owl-397")
        && string_contains(s: o as String, pattern: "2026-10-14T00:10:39Z")
    CitedToAuthority { authority: _ } => false
    ObservedByReceipt { observed: _ } => false
  }
}

test fn witness_sleek_owl_397_first_receipt_carries_the_sanctioned_srv1_values() -> Bool {
  let obs = gunbc_srv1_memory_envelope_sleek_owl_397_first
  host_identity_eq(a: obs.host, b: operator_host_srv1)
    && (obs.probed_at as String) == "2026-10-14T00:10:39Z"
    && byte_size_count(b: obs.mem_total) == byte_size_count(b: kibibyte_to_byte_size(k: kibibyte(count: 526641732)))
    && byte_size_count(b: obs.mem_available) == byte_size_count(b: kibibyte_to_byte_size(k: kibibyte(count: 168249292)))
    && byte_size_count(b: obs.swap_total) == byte_size_count(b: kibibyte_to_byte_size(k: kibibyte(count: 260046840)))
    && byte_size_count(b: obs.swap_free) == byte_size_count(b: kibibyte_to_byte_size(k: kibibyte(count: 248930848)))
    && obs.active_runner_unit_count == 11
    && length(obs.slice_readings) == 4
    && any(obs.slice_readings, r => (r.slice_unit as String) == "gunbc.slice" && byte_size_count(b: r.memory_current) == 87153995776)
    && any(obs.slice_readings, r =>
      (r.slice_unit as String) == "sessions.slice"
        && byte_size_count(b: r.memory_current) == 29314482176
        && slice_limit_is_bytes(lim: r.memory_high, n: 120259084288)
        && slice_limit_is_bytes(lim: r.memory_max, n: 137438953472))
    && any(obs.slice_readings, r =>
      (r.slice_unit as String) == "user.slice"
        && byte_size_count(b: r.memory_current) == 175093350400
        && slice_limit_is_unbounded(lim: r.memory_high)
        && slice_limit_is_unbounded(lim: r.memory_max))
    && any(obs.slice_readings, r =>
      (r.slice_unit as String) == "system-actions-runner.slice"
        && byte_size_count(b: r.memory_current) == 129190301696)
    && standing_is_sleek_owl_first(s: obs.standing)
}

// THE MEMORY.EVENTS INSTRUMENT (the srv3 serving-child OOM class: two proof runs died in the slice
// with no surviving account because nothing read the counters). These claims hold the read path
// honest: every counter typed, a refusal that names its missing key rather than a zero, the receipt
// rendering that distinguishes "zero deaths" from "did not look", and the slice block riding both
// receipts the observe lane writes.

test fn memory_events_parses_all_five_counters() -> Bool {
  match parse_cgroup_memory_events_systemd_property(raw: "oom=521 oom_kill=40 low=0 high=932657525 max=6007630") {
    CgroupMemoryEventsObserved { counters: c } =>
      c.low == 0 && c.high == 932657525 && c.max == 6007630 && c.oom == 521 && c.oom_kill == 40
    _ => false
  }
}

// FAIL-CLOSED: a line missing one counter is Unreadable naming THAT counter -- never a partial
// reading with a fabricated zero for the gap.
test fn memory_events_refuses_naming_the_missing_counter() -> Bool {
  match parse_cgroup_memory_events_systemd_property(raw: "low=0 high=7 max=2 oom=1") {
    CgroupMemoryEventsUnreadable { detail: d } => string_contains(s: d, pattern: "oom_kill=")
    _ => false
  }
    && match parse_cgroup_memory_events_systemd_property(raw: "oom_kill=40") {
      CgroupMemoryEventsUnreadable { detail: d } => string_contains(s: d, pattern: "low=")
      _ => false
    }
    && match parse_cgroup_memory_events_systemd_property(raw: "low=x high=7 max=2 oom=1 oom_kill=40") {
      CgroupMemoryEventsUnreadable { detail: d } => string_contains(s: d, pattern: "low=")
      _ => false
    }
}

// THE RECEIPT DISTINGUISHES A QUIET SLICE FROM A BLIND ONE: zeros render as zeros, a refusal
// renders as the word unreadable with its cause -- the two blind proof runs would each have left a
// different receipt, and only one of them can be read as "no evidence".
test fn the_events_wire_renders_zeros_and_refusals_apart() -> Bool {
  string_contains(s: cgroup_memory_events_wire(reading: CgroupMemoryEventsObserved { counters: CgroupMemoryEventCounters { low: 0, high: 0, max: 0, oom: 0, oom_kill: 0 } }), pattern: "oom_kill=0")
    && string_contains(s: cgroup_memory_events_wire(reading: CgroupMemoryEventsUnreadable { detail: "the manager refused the MemoryEvents read" }), pattern: "unreadable(")
}

// THE ENVELOPE RECEIPT CARRIES THE SLICE BLOCK, not just a count: memory.max and the events per
// slice -- the figures the job's name always promised and the printed receipt never carried.
test fn the_envelope_receipt_prints_slice_limits_and_events() -> Bool {
  let obs = match host_memory_envelope_from_meminfo_text(
    host: operator_host_srv1,
    probed_at: gunbc_srv1_memory_envelope_sleek_owl_397_first_probed_at,
    meminfo_text: envelope_meminfo_complete,
    active_runner_unit_count: 10,
    slice_readings: hermetic_slice_pair(),
    standing: hermetic_envelope_standing(),
  ) {
    HostMemoryEnvelopeObserved { observation: o } => o
    HostMemoryEnvelopeRefused { host: _, reason: _ } => return false
  }
  let text = host_memory_envelope_receipt_text(obs: obs)
  string_contains(s: text, pattern: "slice=system.slice")
    && string_contains(s: text, pattern: "memory_max=infinity")
    && string_contains(s: text, pattern: "memory_events=low=0 high=3 max=1 oom=0 oom_kill=0")
    && string_contains(s: text, pattern: "slice=user.slice")
    && string_contains(s: text, pattern: "memory_events=unreadable(no readable oom_kill=)")
}

// THE QUIESCENT RECEIPT CARRIES THE SAME BLOCK, and its unreadable arm says so rather than going
// silent about the slice entirely.
test fn the_quiescent_receipt_carries_the_slice_block_both_ways() -> Bool {
  let read = HostMemAvailableQuiescentRead {
    host: operator_host_srv1,
    account: "fleet-automation-peer-executor" as NonEmptyStr,
    read_at: "2026-11-27T00:00:00Z" as NonEmptyStr,
    host_total: kibibyte_to_byte_size(k: kibibyte(count: 526252472)),
    mem_available: kibibyte_to_byte_size(k: kibibyte(count: 452213840)),
  }
  let observed = host_memory_quiescent_receipt_text(read: read, user_work_slice: PeerSliceObserved {
    slice_unit: "gunbc-user-work.slice" as NonEmptyStr,
    memory_max: MemoryLimitBytes { bytes: kibibyte_to_byte_size(k: kibibyte(count: 26214400)) },
    memory_current: Present { value: kibibyte_to_byte_size(k: kibibyte(count: 264192)) },
    memory_events: CgroupMemoryEventsObserved { counters: CgroupMemoryEventCounters { low: 0, high: 932657525, max: 6007630, oom: 521, oom_kill: 40 } },
  })
  let unreadable = host_memory_quiescent_receipt_text(read: read, user_work_slice: PeerSliceUnreadable {
    slice_unit: "gunbc-user-work.slice" as NonEmptyStr,
    reason: "systemctl show exited 1",
  })
  string_contains(s: observed, pattern: "slice=gunbc-user-work.slice")
    && string_contains(s: observed, pattern: "memory_max=26843545600")
    && string_contains(s: observed, pattern: "oom_kill=40")
    && string_contains(s: unreadable, pattern: "slice=gunbc-user-work.slice")
    && string_contains(s: unreadable, pattern: "memory_events=unreadable(systemctl show exited 1)")
}

// THE systemctl-show FIELD READER: a keyed line yields its value, an absent key yields absence --
// never the neighbouring key's value (the prefix join is exact through the "=" that systemd always
// prints after the key).
test fn peer_show_field_reads_the_keyed_line_and_nothing_else() -> Bool {
  let lines = ["MemoryMax=26843545600", "MemoryCurrent=264192", "MemoryEvents=low=0 oom_kill=40"]
  match peer_show_field(lines: lines, key: "MemoryMax" as NonEmptyStr) {
    Present { value: v } => v == "26843545600"
    _ => false
  }
    && match peer_show_field(lines: lines, key: "MemoryCurrent" as NonEmptyStr) {
      Present { value: v } => v == "264192"
      _ => false
    }
    && match peer_show_field(lines: lines, key: "MemorySwapMax" as NonEmptyStr) {
      Absent => true
      _ => false
    }
}

// THE LIMIT WIRES render the three standings distinctly -- an unbounded slice, a priced slice, and
// a limit the manager would not answer -- because a receipt that prints "0" for the third would
// read as a slice with no memory at all.
test fn the_limit_wires_render_the_three_standings_apart() -> Bool {
  systemd_cgroup_memory_limit_wire(limit: MemoryLimitUnbounded) == "infinity"
    && systemd_cgroup_memory_limit_wire(limit: MemoryLimitBytes { bytes: kibibyte_to_byte_size(k: kibibyte(count: 26214400)) }) == "26843545600"
    && string_contains(s: systemd_cgroup_memory_limit_wire(limit: MemoryLimitAbsent), pattern: "unreadable")
}

// ── THE DOOR ────────────────────────────────────────────────────────────────────────────────────────
//
// A single ProcessExit entry so the posted manual receipt is ONE command (gunbc run --entry <this file> --function run_host_memory_envelope_observe_witness). Every claim in
// this module is hermetic, so hermetic discovery remains the authority on WHICH claims exist and
// runs each of them independently of this list -- which is why this call list can stay a plain
// roster without a second enumeration of the module's declarations: completeness is owned by the
// discovery lane (single authority), and this door only aggregates verdicts for one receipt.
fn check_or_name(name: String, held: Bool) -> String {
  if held { return "" }
  return concat(name, "\n")
}

fn run_host_memory_envelope_observe_witness() -> ProcessExit {
  let red = join([
    check_or_name(name: "an_unreachable_subject_refuses_and_never_reports_memory", held: an_unreachable_subject_refuses_and_never_reports_memory()),
    check_or_name(name: "the_quiescent_receipt_carries_host_total_and_mem_available", held: the_quiescent_receipt_carries_host_total_and_mem_available()),
    check_or_name(name: "witness_envelope_from_complete_meminfo_observes", held: witness_envelope_from_complete_meminfo_observes()),
    check_or_name(name: "witness_envelope_missing_memavailable_refuses_not_widens", held: witness_envelope_missing_memavailable_refuses_not_widens()),
    check_or_name(name: "witness_top_level_slice_is_direct_child_of_root_cgroup", held: witness_top_level_slice_is_direct_child_of_root_cgroup()),
    check_or_name(name: "witness_runner_parent_slice_is_read_though_not_top_level", held: witness_runner_parent_slice_is_read_though_not_top_level()),
    check_or_name(name: "witness_envelope_projects_host_mem_available_observation", held: witness_envelope_projects_host_mem_available_observation()),
    check_or_name(name: "witness_sleek_owl_397_receipt_instant_is_the_srv1_reading", held: witness_sleek_owl_397_receipt_instant_is_the_srv1_reading()),
    check_or_name(name: "witness_sleek_owl_397_first_receipt_carries_the_sanctioned_srv1_values", held: witness_sleek_owl_397_first_receipt_carries_the_sanctioned_srv1_values()),
    check_or_name(name: "memory_events_parses_all_five_counters", held: memory_events_parses_all_five_counters()),
    check_or_name(name: "memory_events_refuses_naming_the_missing_counter", held: memory_events_refuses_naming_the_missing_counter()),
    check_or_name(name: "the_events_wire_renders_zeros_and_refusals_apart", held: the_events_wire_renders_zeros_and_refusals_apart()),
    check_or_name(name: "the_envelope_receipt_prints_slice_limits_and_events", held: the_envelope_receipt_prints_slice_limits_and_events()),
    check_or_name(name: "the_quiescent_receipt_carries_the_slice_block_both_ways", held: the_quiescent_receipt_carries_the_slice_block_both_ways()),
    check_or_name(name: "peer_show_field_reads_the_keyed_line_and_nothing_else", held: peer_show_field_reads_the_keyed_line_and_nothing_else()),
    check_or_name(name: "the_limit_wires_render_the_three_standings_apart", held: the_limit_wires_render_the_three_standings_apart()),
  ], "")
  if red == "" {
    ExitSuccess {}
  } else {
    ExitFailure { code: 1, reason: concat("host_memory_envelope_observe_witness claims red: ", red) }
  }
}
