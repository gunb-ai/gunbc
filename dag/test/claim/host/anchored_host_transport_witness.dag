data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// A transport must not become host-authenticated by a key nobody vouched for. These claims pin
// gunbc.host.anchored_host_transport at the edges an anchor exists to hold: a PRESENTED key that does not
// match the anchored statement refuses; a host with no row, or a row with no anchor, refuses outright --
// matching against nothing is accepting anything; a transport whose address reaches another machine never
// binds the anchored host. The positive control binds mtcollins1 on the fixture's public half read back
// whole. And the Q1 invariant -- the private half appears in no argv, no rendered string, no refusal text
// -- is pinned as its own claim, the class in
// dag/gunbc/recurring_failure_mode/a_secret_crosses_into_shell_stdin_as_a_plain_string.dag. The mechanism
// is generic; mtcollins1 enters ONLY through its row and the secret row its row cites.

// THE TRANSPORT, built the way the re-land's witness builds one (same route, same hermetic context):
// fleet_locus_ssh_target over the managed-host join, wrapped whole into the fleet arm. The address is
// what binds (gunbc.host.host_bound_transport), so nothing here hand-names a host the binding does not.
fn fleet_transport_to(host: HostIdentity) -> HostEffectTransport? admit_callers: [
  decl_ref(module_path: "test.claim.host.anchored_host_transport_witness", decl_name: "per_boot_binding"),
  decl_ref(module_path: "test.claim.host.anchored_host_transport_witness", decl_name: "a_wrong_presented_key_refuses_the_transport"),
  decl_ref(module_path: "test.claim.host.anchored_host_transport_witness", decl_name: "an_unanchored_host_refuses_the_transport"),
  decl_ref(module_path: "test.claim.host.anchored_host_transport_witness", decl_name: "no_anchor_refuses_the_transport"),
  decl_ref(module_path: "test.claim.host.anchored_host_transport_witness", decl_name: "matching_presented_key_binds_the_anchored_host"),
  decl_ref(module_path: "test.claim.host.anchored_host_transport_witness", decl_name: "a_transport_to_another_machine_never_binds_the_anchored_host"),
  decl_ref(module_path: "test.claim.host.anchored_host_transport_witness", decl_name: "an_empty_presented_line_never_binds"),
  decl_ref(module_path: "test.claim.host.anchored_host_transport_witness", decl_name: "an_anchor_for_another_machine_refuses_the_row"),
] {
  match fleet_ssh_execution_context_hermetic_witness_fixture() {
    Absent => none
    Present { value: ctx } =>
      match fleet_locus_ssh_target(host: host) {
        SshTargetRefused { endpoint: _, refusal: _ } => none
        SshTargetResolved { target: t } => Present { value: FleetSsh { target: t, context: ctx } }
      }
  }
}

// THE FIXTURE ROW: mtcollins1's production row with its anchor filled from the fixture's public half,
// through the one admitted mint. A row built beside the mint carries no standing; built through it, it
// cannot drop one -- the mint is the only door, and it is admitted here for exactly that reason.
fn anchored_fixture_row() -> AnchoredHostRow {
  let base = mtcollins1_anchored_host_row
  let anchor = anchored_host_trusted_row(
    host: base.host,
    address: base.address,
    host_key_secret: base.host_key_secret,
    read_obligation: base.read_obligation,
    public_key_base64: fixture_public_key.material as String,
    sha256_fingerprint: "SHA256:HERMETICWITNESSFIXTUREFINGERPRINT0",
  )
  AnchoredHostRow {
    host: base.host,
    anchor: Present { value: anchor },
    read_obligation: base.read_obligation,
    host_key_secret: base.host_key_secret,
    address: base.address,
  }
}

data wrong_public_key_base64: String = "AAAAC3NzaC1lZDI1NTE5AAAAIADIFFERENTDIFFERENTDIFFERENTDIFFERENT0"

// CLAIM: A WRONG PRESENTED KEY REFUSES THE TRANSPORT. The transport is a real mtcollins1 FleetSsh; the
// key presented differs from the anchored statement in its base64 body. It must refuse with the mismatch
// stated -- expected versus observed -- and never bind. This is the defect the anchor exists to close: a
// target resolved for mtcollins1 completes a session with whatever answers at the address, and a
// host-authenticated transport is the check that notices.
test fn a_wrong_presented_key_refuses_the_transport() -> Bool {
  let row = anchored_fixture_row()
  match fleet_transport_to(host: operator_host_mtcollins1) {
    Absent => false
    Present { value: t } =>
      match anchored_host_transport_against(row: row, anchor: the_present_anchor(row: row), transport: t, presented_key_line: join([known_host_row_field(k: the_present_anchor(row: row)), " ssh-ed25519 ", wrong_public_key_base64], "")) {
        AnchoredBindingBound { bound: _ } => false
        AnchoredBindingPresentedKeyMismatch { expected_line: expected, observed_line: observed } =>
          expected != observed
          && string_contains(s: observed, pattern: wrong_public_key_base64)
          && !string_contains(s: observed, pattern: fixture_public_key.material as String)
        AnchoredBindingAnchorNotForRow { cause: _ } => false
    AnchoredBindingAnchorAbsent { cause: _ } => false
        AnchoredBindingNotTheAnchoredHost { cause: _ } => false
        AnchoredBindingRefused { cause: _ } => false
      }
  }
}

// (helper) the fixture row's anchor, which the fixture construction above guarantees Present.
fn the_present_anchor(row: AnchoredHostRow) -> KnownHostKeyRow admit_callers: [
  decl_ref(module_path: "test.claim.host.anchored_host_transport_witness", decl_name: "per_boot_binding"),
  decl_ref(module_path: "test.claim.host.anchored_host_transport_witness", decl_name: "a_wrong_presented_key_refuses_the_transport"),
  decl_ref(module_path: "test.claim.host.anchored_host_transport_witness", decl_name: "no_anchor_refuses_the_transport"),
  decl_ref(module_path: "test.claim.host.anchored_host_transport_witness", decl_name: "matching_presented_key_binds_the_anchored_host"),
  decl_ref(module_path: "test.claim.host.anchored_host_transport_witness", decl_name: "a_transport_to_another_machine_never_binds_the_anchored_host"),
  decl_ref(module_path: "test.claim.host.anchored_host_transport_witness", decl_name: "a_local_shell_refuses_before_any_key_is_read"),
  decl_ref(module_path: "test.claim.host.anchored_host_transport_witness", decl_name: "an_empty_presented_line_never_binds"),
  decl_ref(module_path: "test.claim.host.anchored_host_transport_witness", decl_name: "an_anchor_for_another_machine_refuses_the_row"),
] {
  match row.anchor {
    Present { value: anchor } => anchor
    Absent => mtcollins1_placeholder_anchor
  }
}

// A row is never handed to the comparison with an absent anchor (the fixture fills it); this placeholder
// keeps the helper total, and it is never what the claims compare against.
data mtcollins1_placeholder_anchor: KnownHostKeyRow = KnownHostKeyRow {
  host: operator_host_mtcollins1,
  address: mtcollins1_anchored_host_row.address,
  key_type: "ssh-ed25519",
  public_key_base64: "AAAAC3NzaC1lZDI1NTE5AAAAIPLACEHOLDERPLACEHOLDERPLACEHOLDER0",
  sha256_fingerprint: "SHA256:PLACEHOLDERPLACEHOLDERPLACEHOLDER0",
  provenance: ScannedFirstContact { scanned_from: "never used: placeholder for a comparison the fixture never runs" as NonEmptyStr },
}

// CLAIM: AN EMPTY PRESENTED LINE NEVER BINDS. The presented key is a SUPPLIED VALUE at the boundary, so
// the empty string must be handled like any other non-matching value: refused, never accepted. (The
// anchored line can never be empty -- known_hosts_line renders host, key type and public material -- so
// equality with "" is structurally a mismatch; the claim pins it against a future edit that special-cases
// emptiness.)
test fn an_empty_presented_line_never_binds() -> Bool {
  let row = anchored_fixture_row()
  match fleet_transport_to(host: operator_host_mtcollins1) {
    Absent => false
    Present { value: t } =>
      match anchored_host_transport_against(row: row, anchor: the_present_anchor(row: row), transport: t, presented_key_line: "") {
        AnchoredBindingPresentedKeyMismatch { expected_line: _, observed_line: observed } => observed == ""
        AnchoredBindingBound { bound: _ } => false
        AnchoredBindingAnchorNotForRow { cause: _ } => false
    AnchoredBindingAnchorAbsent { cause: _ } => false
        AnchoredBindingNotTheAnchoredHost { cause: _ } => false
        AnchoredBindingRefused { cause: _ } => false
      }
  }
}

// CLAIM: A HOST WITH NO ANCHOR REFUSES -- the brief's RED, at the earliest check that can see each case.
// srv2 has no anchored row and is no managed host at all: the host layer itself refuses it ("is not the
// endpoint of any managed host", pinned in test.claim.host.host_bound_transport_witness), and this
// module passes that refusal through whole -- the transport NEVER binds. That pass-through is the point:
// there is no path where an unanchored host's transport ends up Bound.
test fn an_unanchored_host_refuses_the_transport() -> Bool {
  match fleet_transport_to(host: operator_host_srv2) {
    Absent => false
    Present { value: t } =>
      match anchored_host_transport_of(transport: t, presented_key_line: "mtcollins1 ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAITOTALGARBAGEKEY0") {
        AnchoredBindingRefused { cause: cause } => string_contains(s: cause, pattern: "not the endpoint of any managed host")
        AnchoredBindingBound { bound: _ } => false
        AnchoredBindingPresentedKeyMismatch { expected_line: _, observed_line: _ } => false
        AnchoredBindingAnchorNotForRow { cause: _ } => false
    AnchoredBindingAnchorAbsent { cause: _ } => false
        AnchoredBindingNotTheAnchoredHost { cause: _ } => false
      }
  }
}

test fn no_anchor_refuses_the_transport() -> Bool {
  match anchored_host_row_for(host: operator_host_mtcollins1) {
    Absent => false
    Present { value: row } => match row.anchor {
      Present { value: _ } => false
      Absent =>
        match fleet_transport_to(host: operator_host_mtcollins1) {
          Absent => false
          Present { value: t } =>
            match anchored_host_transport_of(transport: t, presented_key_line: known_hosts_line(k: the_present_anchor(row: anchored_fixture_row()))) {
              AnchoredBindingAnchorAbsent { cause: cause } =>
                string_contains(s: cause, pattern: "Read obligation")
                && string_contains(s: cause, pattern: "mtcollins1-ssh-host-key")
              AnchoredBindingAnchorNotForRow { cause: _ } => false
              AnchoredBindingBound { bound: _ } => false
              AnchoredBindingPresentedKeyMismatch { expected_line: _, observed_line: _ } => false
              AnchoredBindingNotTheAnchoredHost { cause: _ } => false
              AnchoredBindingRefused { cause: _ } => false
            }
        }
    }
  }
}

// CLAIM: THE POSITIVE CONTROL -- mtcollins1 BINDS. A real mtcollins1 FleetSsh, a fixture row anchored on
// the fixture public half, and a presented line built from the anchored row through the registry's own
// render (so the host field agrees by construction) bind: AnchoredBindingBound only stands behind a
// successful host_bound_transport_of, and the refusal text on the bound value itself says it is not a
// refusal.
test fn matching_presented_key_binds_the_anchored_host() -> Bool {
  let row = anchored_fixture_row()
  match fleet_transport_to(host: operator_host_mtcollins1) {
    Absent => false
    Present { value: t } =>
      let outcome = anchored_host_transport_against(row: row, anchor: the_present_anchor(row: row), transport: t, presented_key_line: known_hosts_line(k: the_present_anchor(row: row)))
      match outcome {
        AnchoredBindingBound { bound: _ } => anchored_host_binding_refusal_reason(b: outcome) == "bound; not a refusal"
        AnchoredBindingPresentedKeyMismatch { expected_line: _, observed_line: _ } => false
        AnchoredBindingAnchorNotForRow { cause: _ } => false
    AnchoredBindingAnchorAbsent { cause: _ } => false
        AnchoredBindingNotTheAnchoredHost { cause: _ } => false
        AnchoredBindingRefused { cause: _ } => false
      }
  }
}

// CLAIM: A TRANSPORT TO ANOTHER MACHINE NEVER BINDS THE ANCHORED HOST. srv2's own transport, compared
// against mtcollins1's anchored row with mtcollins1's anchored line presented, refuses and never binds --
// today the refusal arrives at the HOST layer (srv2 is no managed host, so host_bound_transport_of itself
// refuses; its cause names srv2). The AnchoredBindingNotTheAnchoredHost arm behind this is
// defense-in-depth for the day the managed-host join grows a second row -- the shape that closed the
// wrong-host defect in the re-land. (The host layer's own cross-host refusal is pinned in
// test.claim.host.host_bound_transport_witness; this is the anchored layer's share: even anchored and
// with the anchored line presented, nothing reaches Bound.)
test fn a_transport_to_another_machine_never_binds_the_anchored_host() -> Bool {
  let row = anchored_fixture_row()
  match fleet_transport_to(host: operator_host_srv2) {
    Absent => false
    Present { value: t } =>
      match anchored_host_transport_against(row: row, anchor: the_present_anchor(row: row), transport: t, presented_key_line: known_hosts_line(k: the_present_anchor(row: row))) {
        AnchoredBindingRefused { cause: cause } => string_contains(s: cause, pattern: "is not the endpoint of any managed host")
        AnchoredBindingNotTheAnchoredHost { cause: cause } => string_contains(s: cause, pattern: "srv2") && string_contains(s: cause, pattern: "mtcollins1")
        AnchoredBindingBound { bound: _ } => false
        AnchoredBindingPresentedKeyMismatch { expected_line: _, observed_line: _ } => false
        AnchoredBindingAnchorNotForRow { cause: _ } => false
    AnchoredBindingAnchorAbsent { cause: _ } => false
      }
  }
}

// CLAIM: THE LOCAL SHELL REFUSES BEFORE ANY KEY IS READ. It names no managed host, so with a row and an
// anchor in hand it still refuses at the host layer -- the comparison stage is never reached.
test fn a_local_shell_refuses_before_any_key_is_read() -> Bool {
  let row = anchored_fixture_row()
  match anchored_host_transport_against(row: row, anchor: the_present_anchor(row: row), transport: LocalShell, presented_key_line: known_hosts_line(k: the_present_anchor(row: row))) {
    AnchoredBindingRefused { cause: cause } => string_contains(s: cause, pattern: "local shell")
    AnchoredBindingBound { bound: _ } => false
    AnchoredBindingPresentedKeyMismatch { expected_line: _, observed_line: _ } => false
    AnchoredBindingAnchorNotForRow { cause: _ } => false
    AnchoredBindingAnchorAbsent { cause: _ } => false
    AnchoredBindingNotTheAnchoredHost { cause: _ } => false
  }
}

// CLAIM: AN ANCHOR FOR ANOTHER MACHINE REFUSES THE ROW (merry-fox-82 HOLD, structural anchor-to-row
// identity). The transport is a real mtcollins1 FleetSsh and the presented line is the anchor's OWN
// known_hosts line -- so a comparison that skipped the anchor-vs-row identity check would BIND. Two
// mismatches are pinned, one per identity component: an anchor naming srv2's host at the row's own
// address, and an anchor naming mtcollins1 at another address. Either must refuse at the typed
// AnchoredBindingAnchorNotForRow arm, name both machines, and never bind. This is the wrong-pairing
// defect the re-land closed one layer above -- an anchor authored for A vouching for B's row -- made
// unwritable below: the check lives INSIDE the sealed comparison, so no caller can route around it.
test fn an_anchor_for_another_machine_refuses_the_row() -> Bool {
  let row = anchored_fixture_row()
  let anchor = the_present_anchor(row: row)
  match fleet_transport_to(host: operator_host_mtcollins1) {
    Absent => false
    Present { value: t } => {
      let foreign_host_anchor = KnownHostKeyRow {
        host: operator_host_srv2,
        address: anchor.address,
        key_type: anchor.key_type,
        public_key_base64: anchor.public_key_base64,
        sha256_fingerprint: anchor.sha256_fingerprint,
        provenance: anchor.provenance,
      }
      let foreign_address_anchor = KnownHostKeyRow {
        host: anchor.host,
        address: fleet_name_at_ssh_port(labels: ["srv2" as DnsLabel]),
        key_type: anchor.key_type,
        public_key_base64: anchor.public_key_base64,
        sha256_fingerprint: anchor.sha256_fingerprint,
        provenance: anchor.provenance,
      }
      // Each mismatched anchor presents ITS OWN rendered known_hosts line. This is what makes the RED
      // discriminate: the sealed comparison renders its expectation from the SUPPLIED anchor
      // (known_hosts_line(k: <supplied anchor>) == presented), so an anchor that vouches for itself always
      // passes the key step. Presenting the original matching anchor's line instead (what the first draft
      // did) made the host case land in PresentedKeyMismatch for the wrong reason -- delete the identity
      // check and that claim stayed green. That is the defect merry-fox-82 caught.
      let presented_by_host = known_hosts_line(k: foreign_host_anchor)
      let presented_by_address = known_hosts_line(k: foreign_address_anchor)
      let by_host = anchored_host_transport_against(row: row, anchor: foreign_host_anchor, transport: t, presented_key_line: presented_by_host)
      let by_address = anchored_host_transport_against(row: row, anchor: foreign_address_anchor, transport: t, presented_key_line: presented_by_address)
      // THE DISCRIMINATION, shown rather than asserted: for each mismatched anchor, the sibling call that
      // differs in EXACTLY the component the identity check inspects (host for one, address for the other;
      // same transport, same key material, each presenting its own rendered line) lands Bound. So the
      // refused calls are refused by the identity check ALONE -- delete that check and both calls take the
      // sibling's path and bind, vouching for a machine (or endpoint) the anchor says nothing about.
      let host_sibling = KnownHostKeyRow {
        host: row.host,
        address: foreign_host_anchor.address,
        key_type: foreign_host_anchor.key_type,
        public_key_base64: foreign_host_anchor.public_key_base64,
        sha256_fingerprint: foreign_host_anchor.sha256_fingerprint,
        provenance: foreign_host_anchor.provenance,
      }
      let address_sibling = KnownHostKeyRow {
        host: foreign_address_anchor.host,
        address: row.address,
        key_type: foreign_address_anchor.key_type,
        public_key_base64: foreign_address_anchor.public_key_base64,
        sha256_fingerprint: foreign_address_anchor.sha256_fingerprint,
        provenance: foreign_address_anchor.provenance,
      }
      let host_sibling_binds = match anchored_host_transport_against(row: row, anchor: host_sibling, transport: t, presented_key_line: known_hosts_line(k: host_sibling)) {
        AnchoredBindingBound { bound: _ } => true
        AnchoredBindingNotTheAnchoredHost { cause: _ } => false
        AnchoredBindingAnchorNotForRow { cause: _ } => false
        AnchoredBindingAnchorAbsent { cause: _ } => false
        AnchoredBindingPresentedKeyMismatch { expected_line: _, observed_line: _ } => false
        AnchoredBindingRefused { cause: _ } => false
      }
      let address_sibling_binds = match anchored_host_transport_against(row: row, anchor: address_sibling, transport: t, presented_key_line: known_hosts_line(k: address_sibling)) {
        AnchoredBindingBound { bound: _ } => true
        AnchoredBindingNotTheAnchoredHost { cause: _ } => false
        AnchoredBindingAnchorNotForRow { cause: _ } => false
        AnchoredBindingAnchorAbsent { cause: _ } => false
        AnchoredBindingPresentedKeyMismatch { expected_line: _, observed_line: _ } => false
        AnchoredBindingRefused { cause: _ } => false
      }
      // And the host case additionally proves the refusal cannot be a key mismatch masquerading as one:
      // the rendered line is address + key type + key material (known_hosts_line), invisible to the
      // HostIdentity field, so the two anchors render the SAME line and only the check can tell them apart.
      let host_case_lines_are_identical = presented_by_host == known_hosts_line(k: anchor)
      anchored_pairing_refused(b: by_host) && anchored_pairing_refused(b: by_address)
        && host_sibling_binds && address_sibling_binds && host_case_lines_are_identical
    }
  }
}

// (helper) the pairing refusal, stated once so both halves of the claim above check the same thing:
// the typed arm fired, and its cause names the machine the anchor speaks for AND the machine the row
// belongs to -- a refusal that hides which pairing it refused is not locatable (DESIGN sec.5).
fn anchored_pairing_refused(b: AnchoredHostBinding) -> Bool admit_callers: [
  decl_ref(module_path: "test.claim.host.anchored_host_transport_witness", decl_name: "an_anchor_for_another_machine_refuses_the_row"),
] {
  match b {
    AnchoredBindingAnchorNotForRow { cause: cause } =>
      string_contains(s: cause, pattern: "srv2")
      && string_contains(s: cause, pattern: "mtcollins1")
      && !string_contains(s: cause, pattern: "PRIVATE")
    AnchoredBindingBound { bound: _ } => false
    AnchoredBindingNotTheAnchoredHost { cause: _ } => false
    AnchoredBindingAnchorAbsent { cause: _ } => false
    AnchoredBindingPresentedKeyMismatch { expected_line: _, observed_line: _ } => false
    AnchoredBindingRefused { cause: _ } => false
  }
}

// CLAIM: Q1 -- THE PRIVATE HALF NEVER APPEARS IN argv OR IN ANY RENDERED TEXT. The scan's rendered argv
// is ssh-keyscan's anonymous read: it must name the host and the key type and NOTHING that could carry
// secret material -- even the Secret's own name is refused in it, because argv is rendered wherever it
// runs (a_secret_crosses_into_shell_stdin_as_a_plain_string.dag: what lands in a rendered string is what
// gets read). The refusal texts carry no private material either.
test fn the_private_key_never_appears_in_argv_or_rendered_text() -> Bool {
  let argv = anchored_host_key_scan_argv_text(row: mtcollins1_anchored_host_row)
  let secret_name = mtcollins1_ssh_host_key_secret.secret as String
  let refusals = join([
    anchored_host_binding_refusal_reason(b: AnchoredBindingAnchorAbsent { cause: "anchor absent" }),
    anchored_host_binding_refusal_reason(b: AnchoredBindingNotTheAnchoredHost { cause: "not the anchored host" }),
    anchored_host_binding_refusal_reason(b: AnchoredBindingRefused { cause: "binding refused" }),
    anchored_host_binding_refusal_reason(b: AnchoredBindingPresentedKeyMismatch { expected_line: "exp", observed_line: "obs" }),
    anchored_host_key_scan_effect(host: operator_host_mtcollins1).subject as String,
  ], "\n")
  !string_contains(s: argv, pattern: secret_name)
  && !string_contains(s: argv, pattern: "PRIVATE")
  && !string_contains(s: argv, pattern: "-----BEGIN")
  && string_contains(s: argv, pattern: "ssh-keyscan")
  && string_contains(s: argv, pattern: "mtcollins1")
  && !string_contains(s: refusals, pattern: "PRIVATE")
  && !string_contains(s: refusals, pattern: "-----BEGIN")
}

// CLAIM: THE SCAN EFFECT IS CENSUS-CLASSIFIED AND CONFORMS. The gated readback's effect for the anchored
// row is folded from its own characteristics -- a named human step is its only surface, so the fold
// selects HumanOnlyStep and the census row realizes it; exactly one row stands in the census for the
// site, with a Conforms verdict (the pattern in test.claim.printer_authorization_census_witness).
test fn the_readback_scan_effect_is_census_classified() -> Bool {
  let go = anchored_host_key_readback_go_step(host: operator_host_mtcollins1)
  let rows = filter(privileged_effect_census, r => declaration_ref_eq(a: r.site, b: decl_ref(module_path: "gunbc.host.anchored_host_transport", decl_name: "anchored_host_key_scan_wet")))
  match anchored_host_key_scan_effect(host: operator_host_mtcollins1).surface {
    HumanSurfaceOnly { step: step } =>
      step.identity == go.identity
      && count(rows) == 1
      && all(rows, r => match site_verdict(row: r).conformance { Conforms => true DivergesWithReason { reason: _ } => false Diverges => false SiteNotDecidable { standing: _ } => false })
    _ => false
  }
}

// CLAIM: THE SELECTORS WERE EXECUTED, NOT HAND-PICKED. The scan's citations are the typed outputs of
// select_authorization_pattern and select_access_token_source over the census-classified effect -- those
// strings are only reachable by CALLING the selectors, so a citation in one of their possible shapes is
// the evidence the route asked rather than chose. (The selector behavior itself is pinned in
// test.claim.authorization_pattern_selection_witness and test.claim.access_token_source_witness.)
test fn the_transport_route_cites_the_executed_selectors() -> Bool {
  let pattern_cited = anchored_host_pattern_citation(host: operator_host_mtcollins1)
  let source_cited = anchored_host_token_source_citation()
  string_contains(s: pattern_cited, pattern: "select_authorization_pattern:")
  && string_contains(s: source_cited, pattern: "select_access_token_source:")
}

// THE OPEN GAPS ARE ROWS, NOT COMMENTS (review 85051, DESIGN sec.3c). The module carries four frontier
// rows for what this diff does NOT yet do in production: nothing routes a live transport through
// anchored_host_transport_of, no live readback has run, and nothing on the host consumes the placed key
// (no sshd in this slice). They must be well-formed and stand in the census-closure registry -- a gap in
// a comment dissolves; a row's trigger is checked.

fn anchored_census_has_frontier_subject(row: FrontierRow) -> Bool {
  any(census_closure_frontier_rows(), c => frontier_subject_eq(a: c.subject, b: row.subject))
}

test fn the_open_gaps_are_frontier_rows_and_registered() -> Bool {
  count(anchored_host_transport_frontier_rows) == 6
  && frontier_rows_well_formed(rows: anchored_host_transport_frontier_rows)
  && all(anchored_host_transport_frontier_rows, row => anchored_census_has_frontier_subject(row: row))
}

// ── THE MINT (review 85232: the step that CREATES the secret was unmodeled hand shell) ────────
//
// The mint is now a model: argv builders on admitted extdeps programs, a rendered shell the runbook
// copies from the render, a HumanIntervention, a PrivilegedEffect in the census, and a Scaffold
// marker naming the trigger that dissolves the hand execution. These claims pin each of those at
// the edge that matters -- and one of them is the Q1 RED: no mint argv word, and no rendered line,
// may carry private key material; the private half moves only as file CONTENTS through the cat pipe.

fn mint_word_is_clean(w: String) -> Bool {
  !string_contains(s: w, pattern: "PRIVATE KEY")
  && !string_contains(s: w, pattern: "ssh-ed25519 ")
  && !string_contains(s: w, pattern: "--data-file=/")
}

// CLAIM: THE MINT EFFECT IS CENSUS-CLASSIFIED AND THE FOLD DIVERGES WITH THE STATED REASON. Exactly
// one row stands for the mint site; the fold EXECUTED over the effect selects the operator-approval
// pattern (the witness gate fires -- irreversible with no discharge -- and the unbindable workload
// identity excludes the federated grant), while the row realizes the named human step; so the
// conformance is DivergesWithReason carrying the manual-API-beside-unlanded-adapter reason -- the
// same reason the ntfy publisher-token mint row carries, because the situation is the same: an
// ApiSurface gcloud effect no fleet principal is allowed to perform. The claim fails if the row is
// absent (an unclassified mint), if it diverges UNreasoned (an unexplained hole), if it silently
// conforms (the fold would have to be rigged), or if the effect's frequency drifts from the step's.
fn anchored_mint_verdict_selected_approval(v: SiteVerdict) -> Bool {
  match v.selection {
    PatternSelected { pattern: OperatorApprovedCapability, receipt: _ } => true
    _ => false
  }
}

fn anchored_mint_verdict_stated_divergence(v: SiteVerdict) -> Bool {
  match v.conformance {
    DivergesWithReason { reason: reason } => reason.statement == manual_api_effect_beside_unlanded_approval_adapter.statement
    Conforms => false
    Diverges => false
    SiteNotDecidable { standing: _ } => false
  }
}

test fn the_mint_effect_is_censused_and_diverges_with_reason() -> Bool {
  let rows = filter(privileged_effect_census, r => declaration_ref_eq(a: r.site, b: decl_ref(module_path: "gunbc.host.anchored_host_transport", decl_name: "anchored_host_key_mint_intervention")))
  count(rows) == 1
  && all(rows, r => anchored_mint_verdict_selected_approval(v: site_verdict(row: r)))
  && all(rows, r => anchored_mint_verdict_stated_divergence(v: site_verdict(row: r)))
  && anchored_host_key_mint_effect().frequency == anchored_host_key_mint_intervention().frequency
}

// CLAIM: NO MINT LEG CARRIES PRIVATE MATERIAL (rule Q1; the class in
// dag/gunbc/recurring_failure_mode/a_secret_crosses_into_shell_stdin_as_a_plain_string.dag). Every
// word of every mint argv command -- the keygen leg, both gcloud legs, the cleanup legs -- is free
// of key material: no PRIVATE KEY marker, no public-key line, and NO --data-file PATH that could
// make the CLI read the key from disk on a server-bound leg. The create leg has no --data-file word
// at all (an empty version 1 would be a lie the server serves), and the upload leg's only
// --data-file word is exactly "--data-file=-": the key reaches the server as stdin CONTENTS from
// cat and in no other way. Delete the stdin rule and the upload leg gains a path form here; widen
// the keygen leg with key material and this refuses.
test fn the_mint_render_carries_no_private_material() -> Bool {
  all(argv_words(command: anchored_host_key_mint_create_command()), w => mint_word_is_clean(w: w))
  && all(argv_words(command: anchored_host_key_mint_upload_command()), w => mint_word_is_clean(w: w))
  && all(argv_words(command: anchored_host_key_mint_keygen_command(mint_dir: "/dev/shm/mc-hostkey")), w => mint_word_is_clean(w: w))
  && all(anchored_host_key_mint_cleanup_commands(mint_dir: "/dev/shm/mc-hostkey"), c => all(argv_words(command: c), w => mint_word_is_clean(w: w)))
  && !string_contains(s: shell_command_render(command: anchored_host_key_mint_create_command()), pattern: "--data-file")
  && string_contains(s: shell_command_render(command: anchored_host_key_mint_upload_command()), pattern: "--data-file=-")
}

// The operator-facing runbook (docs/runbooks/mtcollins1-ssh-host-key-mint.md, Step 1) copies the mint
// shell into a ```bash fence. This folds the runbook text and returns the FIRST bash fence whose body
// carries the mint's ssh-keygen leg -- the mint block -- or "" if the file no longer has one. split /
// .skip / .take / join / fold are the claim-witness builtins (the shape at
// dag/test/claim/action_use_admission_witness.dag); filesystem_read reads the committed file under this
// module's SubstrateInputsOnly disposition, the same lane action_use_admission_witness reads real census
// files.
fn anchored_runbook_mint_block() -> String {
  let doc = filesystem_read(path: "docs/runbooks/mtcollins1-ssh-host-key-mint.md").content
  let parts = split(s: doc, delimiter: "```bash\n")
  fold(parts.skip(n: 1), init: "", f: fn(acc, chunk) {
    if acc != "" {
      acc
    } else {
      let body_parts = split(s: chunk, delimiter: "\n```")
      let body = join(body_parts.take(n: 1), "\n")
      if string_contains(s: body, pattern: "ssh-keygen") { body } else { acc }
    }
  })
}

// CLAIM: THE RUNBOOK'S MINT BLOCK IS THE MODEL RENDER, BYTE FOR BYTE (review 85414 finding 1). The
// runbook copies anchored_host_key_mint_shell() for a human to run during a secret mint; a hand-pasted
// copy is a second source for the command lines an operator executes, and DESIGN §6 names "a
// hand-authored projection the model should generate" as a scaffold tell. This is NOT the model checking
// itself: it reads the committed markdown file off disk and compares its fenced block to the render
// (the fence strips the render's trailing newline, so the block is re-terminated before the equality).
// Editing the runbook block to drift from the model -- retyping a gcloud leg, dropping the tmpfs guard,
// widening the trap -- fails HERE, not by convention. anchored_host_key_mint_shell() returns an
// Outcome<String> (review 85659: a rejected emission is a typed refusal, not a sentinel string inside
// the success type), so a Rejected emission REFUSES this claim rather than being compared against -- a
// refusal is never a pass. The failure companion prints both the file's block and the model render so
// the drift is located, not inferred.
fn anchored_mint_render_text() -> String {
  match anchored_host_key_mint_shell() {
    Accepted { value: text, diagnostics: _ } => text
    Rejected { diagnostics: _ } => "EMIT_REFUSED"
  }
}

test fn the_runbook_mint_block_is_the_model_render() -> Bool {
  match anchored_host_key_mint_shell() {
    Accepted { value: text, diagnostics: _ } => concat(anchored_runbook_mint_block(), "\n") == text
    Rejected { diagnostics: _ } => false
  }
}

fn the_runbook_mint_block_is_the_model_render_failure_receipt() -> String {
  match anchored_host_key_mint_shell() {
    Accepted { value: text, diagnostics: _ } => concat(concat(concat("RUNBOOK_BLOCK=[", anchored_runbook_mint_block()), "] MODEL_RENDER=["), concat(text, "]"))
    Rejected { diagnostics: _ } => "MODEL_RENDER=EMIT_REFUSED (bash_emit_stmts rejected the mint script)"
  }
}

// CLAIM: THE MINT RENDER IS COMPOSED FROM THE BUILDERS. The shell string contains the create leg's
// render, the upload leg's render, and the stdin pipe -- and the secret name and project it carries
// are the SecretRef's OWN fields, so the literals have no second spelling INSIDE THE MODEL: change
// the SecretRef and this render changes. Re-typing a gcloud leg by hand in the model, or retyping the
// literals, fails here. The runbook's own copy is checked against the render by
// the_runbook_mint_block_is_the_model_render, not by this claim.
test fn the_mint_render_is_the_builders_render() -> Bool {
  let shell = anchored_mint_render_text()
  shell != "EMIT_REFUSED"
  && string_contains(s: shell, pattern: shell_command_render(command: anchored_host_key_mint_create_command()))
  && string_contains(s: shell, pattern: shell_command_render(command: anchored_host_key_mint_upload_command()))
  && string_contains(s: shell, pattern: concat("'", mtcollins1_ssh_host_key_secret.secret as String, "'"))
  && string_contains(s: shell, pattern: concat("'", mtcollins1_ssh_host_key_secret.project as String, "'"))
  && string_contains(s: shell, pattern: " | ")
}

// CLAIM: THE HAND EXECUTION IS A DECLARED SCAFFOLD WITH A NAMED TRIGGER, AND THE STEP IS ONCE PER
// FLEET. The render's disposition is Scaffold dissolving to a real dispatch bound to
// anchored_host_key_mint_shell itself (the bash_emit precedent), and the operator-facing step is
// FleetOnce with no discharge site modeled yet -- the mint happens once per fleet, not per boot
// (per boot is the DELIVERY, the custody arm's job), and no witness standing discharges it.
test fn the_mint_is_a_declared_scaffold_and_a_fleet_once_step() -> Bool {
  match anchored_host_key_mint_shell_bash_emit_dissolution_trigger {
    Scaffold { dissolves_to: RealizationDispatch, bind: bind } =>
      declaration_ref_eq(a: bind, b: decl_ref(module_path: "gunbc.host.anchored_host_transport", decl_name: "anchored_host_key_mint_shell"))
    _ => false
  }
  && match anchored_host_key_mint_intervention().frequency {
    FleetOnce => true
    _ => false
  }
  && match anchored_host_key_mint_intervention().completion_evidence {
    NoDischargeSiteModeled => true
    _ => false
  }
}

// ── THE PER-BOOT PIN (S4: the image generates its host key each boot and prints the PUBLIC line on SOL) ──
//
// The console line is a supplied value at this boundary. NO PRODUCER EXISTS YET: the pairing obligation
// (the real image prints exactly this shape) is an open declared frontier, the per_boot_console_marker
// row in anchored_host_transport_frontier_rows, with its trigger. What is pinned here is the fleet's side: a pin binds only
// its own boot, only the key it carries, and only from a well-formed console read.

data per_boot_fixture_fingerprint: String = "SHA256:HERMETICWITNESSFIXTUREFINGERPRINT0"

fn per_boot_console_line(boot_id: String, key_b64: String) -> String {
  join(["GUNBC-HOST-KEY boot_id=", boot_id, " ssh-ed25519 ", key_b64, " ", per_boot_fixture_fingerprint], "")
}

fn per_boot_binding_kind(b: AnchoredHostBinding) -> String {
  match b {
    AnchoredBindingBound { bound: _ } => "bound"
    AnchoredBindingNotTheAnchoredHost { cause: _ } => "not-the-anchored-host"
    AnchoredBindingAnchorNotForRow { cause: _ } => "anchor-not-for-row"
    AnchoredBindingAnchorAbsent { cause: _ } => "anchor-absent"
    AnchoredBindingPresentedKeyMismatch { expected_line: _, observed_line: _ } => "presented-key-mismatch"
    AnchoredBindingRefused { cause: _ } => "refused"
  }
}

// the binding for a pin parsed from `console`, acting on `expected_boot` and presented `key_b64`
fn per_boot_binding(console: String, expected_boot: NonEmptyStr, key_b64: String) -> String {
  let row = anchored_fixture_row()
  match fleet_transport_to(host: operator_host_mtcollins1) {
    Absent => "no-transport"
    Present { value: t } => per_boot_binding_kind(b: anchored_host_transport_per_boot(
      transport: t,
      expected_boot_id: expected_boot,
      pin: per_boot_pin_from_console_line(row: row, line: console),
      presented_key_line: join([known_host_row_field(k: the_present_anchor(row: row)), " ssh-ed25519 ", key_b64], ""),
    ))
  }
}

// POSITIVE CONTROL: the sshd presents the key the console printed at THIS boot -> bound.
test fn a_per_boot_pin_binds_the_key_printed_at_that_boot() -> Bool {
  per_boot_binding(console: per_boot_console_line(boot_id: "boot-a", key_b64: fixture_public_key.material as String), expected_boot: "boot-a" as NonEmptyStr, key_b64: fixture_public_key.material as String) == "bound"
}

// RED: a pin read at boot A, presented while acting on boot B (the same key even) refuses before any key
// is compared -- a per-boot key vouches for its own boot only.
test fn a_pin_from_another_boot_refuses() -> Bool {
  per_boot_binding(console: per_boot_console_line(boot_id: "boot-a", key_b64: fixture_public_key.material as String), expected_boot: "boot-b" as NonEmptyStr, key_b64: fixture_public_key.material as String) == "anchor-not-for-row"
}

// RED: right boot, but the sshd presents a different key than the console printed.
test fn a_mismatched_key_under_a_per_boot_pin_refuses() -> Bool {
  per_boot_binding(console: per_boot_console_line(boot_id: "boot-a", key_b64: fixture_public_key.material as String), expected_boot: "boot-a" as NonEmptyStr, key_b64: wrong_public_key_base64) == "presented-key-mismatch"
}

// RED: no pin (nothing read from the console) refuses; so does every malformed read.
test fn no_per_boot_pin_refuses_and_so_does_every_malformed_console_read() -> Bool {
  let key = fixture_public_key.material as String
  let ok = per_boot_console_line(boot_id: "boot-a", key_b64: key)
  per_boot_binding(console: "", expected_boot: "boot-a" as NonEmptyStr, key_b64: key) == "anchor-absent"
  && per_boot_binding(console: join(["x", ok], " "), expected_boot: "boot-a" as NonEmptyStr, key_b64: key) == "anchor-absent"
  && per_boot_binding(console: join([ok, "extra"], " "), expected_boot: "boot-a" as NonEmptyStr, key_b64: key) == "anchor-absent"
  && per_boot_binding(console: join(["GUNBC-HOST-KEY boot_id= ssh-ed25519 ", key, " ", per_boot_fixture_fingerprint], ""), expected_boot: "boot-a" as NonEmptyStr, key_b64: key) == "anchor-absent"
  && per_boot_binding(console: join(["GUNBC-HOST-KEY boot_id=boot-a ssh-ed25519 ", key], ""), expected_boot: "boot-a" as NonEmptyStr, key_b64: key) == "anchor-absent"
  && per_boot_binding(console: join(["GUNBC-HOST-KEY boot_id=boot-a ssh-rsa ", key, " ", per_boot_fixture_fingerprint], ""), expected_boot: "boot-a" as NonEmptyStr, key_b64: key) == "anchor-absent"
}
