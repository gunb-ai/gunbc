  EnsureOps,
  EnsurePlanRefused,
  EnsureSkipped,
  EnsureTransportBlocked,
  ObserveAbsent,
  Ran,
  ObserveMisconfigured,
  ObserveReadBlocked,
  ObserveStatsOk,
  ObserveUnresponsive,
  FetchArchive,
  InstallStep,
  ReadDigest,
  RefusedBeforeInstall,
  Runs,
  UnitStep,
  build_cache_misconfigured_marker,
  build_cache_ensure_run,
  build_cache_ensure_run_legs,
  build_cache_plan_legs_of_kind,
  // THE CITED SELECTOR for the digest-read leg. Claim 3 above takes its probe leg from here rather than
