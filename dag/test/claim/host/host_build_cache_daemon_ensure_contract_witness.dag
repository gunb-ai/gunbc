  BuildCacheEnsureSuppliedOutcome,
  RunArgvTransportObserved,
  RunArgvTransportRefused,
  ShellExecObserved,
  build_cache_fold_ensure_ops_with_outcomes,
  // THE SHARED STEP, not only the fold that calls it. The pairing claim below needs to drive the step on its
  // own and compare it against the fold; a claim that could only reach the fold could not tell whether the
  // fold decided for itself or asked.
  build_cache_fold_op_executed,
  build_cache_run_ensure_ops,
  // THE PRODUCTION FUNCTION, not a test-local copy of it. A claim about "the route that actuates" that drives
