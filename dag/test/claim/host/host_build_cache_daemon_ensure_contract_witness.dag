}
// THE REALIZING SIDE OF THE DIGEST GATE. Importing the realizing module here is deliberate and is the only
// name taken from it: the fold that ACTUATES the plan lives there, and the executing pairing below has to
// drive that fold rather than a copy of it. Nothing in this module runs a transport that could touch a
// host — see the `EmitArtifactThenThinRun` choice.
import gunbc.host.host_effect {
  BootstrapFragment,
  EmitArtifactThenThinRun,
  HostEffectTransport,
  ThinInvocation,
}
