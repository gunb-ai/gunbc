  // block. A parameter type is a use.
  BuildCacheEnsureKind,
  EnsureDigestRefused,
  BuildCacheEnsureExecuted,
  BuildCacheEnsureOp,
  BuildCacheHostRunObserved,
  BuildCacheHostRunOutcome,
  BuildCacheObserve,
  CouldNotRun,
  EnsureCompleted,
