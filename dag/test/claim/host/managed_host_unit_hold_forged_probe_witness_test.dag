module test.claim.managed_host_unit_hold_forged_probe_witness

import std.types { String, Bool, Int, List }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import gunbc.compile_diagnostic_census {
  CompileDiagnosticCensus, CompileDiagnosticCensusRow, CensusObserved, CensusNotRunnable,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE UNIT-HOLD SEALS, ENROLLED AS EXECUTED REDS. The probe source below authors an
// AdmittedUnitHoldSubject, an AdmittedMaintenanceHold, a UnitHoldStoreExecutor and a UnitHoldProof outside
// gunbc.managed_host_unit_hold, and calls the acquire and each hold-owning entry from outside their
// admitted callers. This witness hands that source to the compiler through the diagnostic-census
// harness and requires the refusal CLASS at each SUBJECT by name. It is an identity join, so a probe
// refusing for any other reason measures another wall, and the harness control shows the census ran.
data forged_probe_source: String = "module probe_managed_host_unit_hold_forged\n\nimport std.types { NonEmptyStr, String }\nimport std.process { ProcessExit }\nimport std.durable_compare_and_set { cas_generation_first }\nimport std.durable_exclusive_hold { DurableHoldOwnerRef }\nimport gunbc.fleet_host_identity { operator_host_mtcollins1 }\nimport gunbc.managed_host { ManagedHost }\nimport gunbc.managed_host_unit_hold {\n  AdmittedMaintenanceHold, AdmittedUnitHoldSubject, ProbeHoldReleaseOutcome, UnitHoldAcquisition, UnitHoldProof, UnitHoldStoreExecutor,\n  boot_run_acquire_unit_hold, kvm_observer_acquire_unit_hold, kvm_observer_release_unit_hold, unit_hold_acquire, unit_hold_acquire_on_store_host,\n  maintenance_hold_take_admitted, maintenance_hold_release_admitted, maintenance_hold_release_on_store_host, kvm_observer_release_on_store_host,\n}\n\nfn forged_subject(h: ManagedHost) -> AdmittedUnitHoldSubject {\n  AdmittedUnitHoldSubject { host: h, key: \"mtjade1\", store_host: \"srv1\" }\n}\n\nfn forged_maintenance(h: ManagedHost) -> AdmittedMaintenanceHold {\n  AdmittedMaintenanceHold { subject: forged_subject(h: h), reason_env: \"GUNBC_FORGED_REASON\" }\n}\n\nfn forged_proof(h: ManagedHost) -> UnitHoldProof {\n  UnitHoldProof { subject: forged_subject(h: h), owner: \"forger\" as DurableHoldOwnerRef, generation: cas_generation_first() }\n}\n\nfn forged_executor(h: ManagedHost) -> UnitHoldStoreExecutor {\n  UnitHoldStoreExecutor { subject: forged_subject(h: h), observed_hostname: \"srv1\" }\n}\n\nfn reach_the_store_effect_with_a_claimed_executor(h: ManagedHost) -> UnitHoldAcquisition {\n  unit_hold_acquire_on_store_host(executor: forged_executor(h: h), owner: \"forger\" as DurableHoldOwnerRef)\n}\n\nfn take_under_hold_a_with_an_executor_for_b(a: AdmittedMaintenanceHold, b: UnitHoldStoreExecutor) -> ProcessExit {\n  maintenance_hold_take_admitted(hold: a, executor: b)\n}\n\nfn release_under_hold_a_with_an_executor_for_b(a: AdmittedMaintenanceHold, b: UnitHoldStoreExecutor) -> ProcessExit {\n  maintenance_hold_release_admitted(hold: a, executor: b)\n}\n\nfn release_with_whatever_executor_is_in_hand(b: UnitHoldStoreExecutor) -> ProcessExit {\n  maintenance_hold_release_on_store_host(executor: b)\n}\n\nfn probe_release_with_whatever_executor_is_in_hand(b: UnitHoldStoreExecutor) -> ProbeHoldReleaseOutcome {\n  kvm_observer_release_on_store_host(executor: b, run_id: \"forged\")\n}\n\nfn acquire_from_outside_the_roots(h: ManagedHost) -> UnitHoldAcquisition {\n  unit_hold_acquire(subject: forged_subject(h: h), owner: \"forger\" as DurableHoldOwnerRef)\n}\n\nfn take_the_boot_hold_from_outside_the_boot() -> UnitHoldAcquisition {\n  boot_run_acquire_unit_hold(host: operator_host_mtcollins1, run_id: \"forged\")\n}\n\nfn take_the_probe_hold_from_outside_the_probe() -> UnitHoldAcquisition {\n  kvm_observer_acquire_unit_hold(host: operator_host_mtcollins1, run_id: \"forged\")\n}\n\nfn release_the_probe_hold_from_outside_the_probe() -> ProbeHoldReleaseOutcome {\n  kvm_observer_release_unit_hold(host: operator_host_mtcollins1, run_id: \"forged\")\n}\n"

fn probe() -> CompileDiagnosticCensus {
  compile_dag_diagnostic_census(forged_probe_source)
}

fn blocking_count_for_class_and_subject(c: CompileDiagnosticCensus, wanted: String, subject: String) -> Int {
  match c {
    CensusNotRunnable { cause: _ } => -1
    CensusObserved { rows: rows } =>
      rows
        |> filter(r => (r.diagnostic_class as String) == wanted && r.subject_name == subject && r.blocking)
        |> fold(init: 0, f: (acc, r) => acc + r.count)
  }
}

fn blocking_count_for_class(c: CompileDiagnosticCensus, wanted: String) -> Int {
  match c {
    CensusNotRunnable { cause: _ } => -1
    CensusObserved { rows: rows } =>
      rows |> filter(r => (r.diagnostic_class as String) == wanted && r.blocking) |> fold(init: 0, f: (acc, r) => acc + r.count)
  }
}

data harness_control_source: String = "module probe_managed_host_unit_hold_harness_control\nimport std.types { NonEmptyStr }\nimport gunbc.managed_host_unit_hold { UnitHoldHostAdmission, unit_hold_admission_for }\nfn admission(host: NonEmptyStr) -> UnitHoldHostAdmission { unit_hold_admission_for(host: host) }\n"

// THE CONTROL IS CLASS-SCOPED: a clean source reaching the same module through its real admission
// yields NO row of either class the reds count, so a red below is the probe's own forgery or outside
// call, joined by class and subject, and not background the harness emits for any importer.
test fn the_harness_runs_and_a_clean_source_emits_neither_wall_class() -> Bool {
  let c = compile_dag_diagnostic_census(harness_control_source)
  blocking_count_for_class(c: c, wanted: "SoleConstructorViolation") == 0
    && blocking_count_for_class(c: c, wanted: "ConstructorCallAdmissionRefused") == 0
}

// AN ADMITTED SUBJECT, AN ADMITTED MAINTENANCE HOLD AND A PROOF CANNOT BE AUTHORED OUTSIDE THEIR MINTS.
test fn each_forged_unit_hold_carrier_is_refused_at_its_literal() -> Bool {
  let c = probe()
  blocking_count_for_class_and_subject(c: c, wanted: "SoleConstructorViolation", subject: "AdmittedUnitHoldSubject") >= 1
    && blocking_count_for_class_and_subject(c: c, wanted: "SoleConstructorViolation", subject: "AdmittedMaintenanceHold") >= 1
    && blocking_count_for_class_and_subject(c: c, wanted: "SoleConstructorViolation", subject: "UnitHoldProof") >= 1
    && blocking_count_for_class_and_subject(c: c, wanted: "SoleConstructorViolation", subject: "UnitHoldStoreExecutor") >= 1
}

// THE ACQUIRE AND EACH HOLD-OWNING ENTRY REFUSE A CALLER OUTSIDE THEIR ADMITTED ROOTS.
test fn the_acquire_and_each_hold_owning_entry_refuse_an_outside_caller() -> Bool {
  let c = probe()
  blocking_count_for_class_and_subject(c: c, wanted: "ConstructorCallAdmissionRefused", subject: "unit_hold_acquire") >= 1
    && blocking_count_for_class_and_subject(c: c, wanted: "ConstructorCallAdmissionRefused", subject: "boot_run_acquire_unit_hold") >= 1
    && blocking_count_for_class_and_subject(c: c, wanted: "ConstructorCallAdmissionRefused", subject: "kvm_observer_acquire_unit_hold") >= 1
    && blocking_count_for_class_and_subject(c: c, wanted: "ConstructorCallAdmissionRefused", subject: "kvm_observer_release_unit_hold") >= 1
    && blocking_count_for_class_and_subject(c: c, wanted: "ConstructorCallAdmissionRefused", subject: "unit_hold_acquire_on_store_host") >= 1
}

// A HOLD FOR ONE SUBJECT CANNOT BE PAIRED WITH AN EXECUTOR FOR ANOTHER. The operator's take and
// release helpers have no executor parameter -- each mints it from its own hold's subject -- and they,
// and the two functions that do take an executor, admit only their one in-module caller. The probe
// calls the take and the release with hold A and an executor B from outside, and calls the
// executor-taking release functions directly; each is refused at admission, by callee name.
test fn a_hold_cannot_be_operated_with_another_subjects_executor() -> Bool {
  let c = probe()
  blocking_count_for_class_and_subject(c: c, wanted: "ConstructorCallAdmissionRefused", subject: "maintenance_hold_take_admitted") >= 1
    && blocking_count_for_class_and_subject(c: c, wanted: "ConstructorCallAdmissionRefused", subject: "maintenance_hold_release_admitted") >= 1
    && blocking_count_for_class_and_subject(c: c, wanted: "ConstructorCallAdmissionRefused", subject: "maintenance_hold_release_on_store_host") >= 1
    && blocking_count_for_class_and_subject(c: c, wanted: "ConstructorCallAdmissionRefused", subject: "kvm_observer_release_on_store_host") >= 1
}
