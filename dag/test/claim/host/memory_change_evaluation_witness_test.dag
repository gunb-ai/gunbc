}

// Review 64358's exact unresolved-sample scenario. A market's Established
// field cannot override the mandatory production obligation; an explicitly
// bounded experiment remains purchasable but visible as a selection gap.
test fn w_sample_required_screen_cannot_be_overridden_by_market_compatibility() -> Bool {
  match mt_collins_channel_population_roles {
    PopulationRolesRefused { refusals: _ } => false
    PopulationRolesResolved { roles: fixture_roles } => {
      let uniform = memory_test_uniform(fixture_roles: fixture_roles)
      let r = memory_test_other_obligations_established(fixture_roles: fixture_roles, configuration: MemoryConfiguration {
        platform: uniform.platform, population: filter(uniform.population, dimm => dimm.position.socket == 0) })
      fold([true, false], init: true, f: (ok, production) => {
        let recipe = NodeRecipe { label: r.label, sockets: r.sockets, processor: r.processor, processor_label: r.processor_label,
          baseboard: r.baseboard, baseboard_label: r.baseboard_label, memory: r.memory, inclusions: r.inclusions,
          memory_purchase: if production { ProductionMemoryPurchase }
            else { QualificationMemoryPurchase { maximum_units: 16, completion: [MemoryTrainingFailureScreen] } },
          memory_evidence: MemoryEvaluationEvidence { revision: "sample-required control", mixtures: r.memory_evidence.mixtures,
            qualifications: r.memory_evidence.qualifications,
            training_failures: [PlatformTrainingFailure { board: uniform.platform.board, step: PhyWriteLeveling,
              standing: InferredFromSequencePosition,
              observed_population: [mta36ads2g72pz_2g1a1_catalog.part_number], observed_at: 0 }],
          },
        }
        let lines = resolve_build(recipe: recipe, rows: memory_test_market(recipe: recipe))
        let screened = filter(memory_screened_rows(recipe: recipe, rows: memory_test_market(recipe: recipe)),
          row => declaration_ref_eq(a: row.part, b: mtcollins_ads_part))
        ok && count(screened) == 1 && fold(screened, init: true, f: (passed, row) => passed && match row.compatibility {
          CompatibilityEvidenceUnread { obligation: _ } => production
          CompatibilityEstablished => !production
          _ => false
        }) && count(lines.lines) > 0 && fold(lines.lines, init: true, f: (passed, line) => passed &&
          if production { match line {
            LineRefused { line: _, cause: MemoryProposalNotAdmitted { assessment, reason: _ } } =>
              any(assessment.final_configuration.results, result => result.obligation == MemoryTrainingFailureScreen && match result.assessment {
                GoalIndeterminate { known_deviations, unknowns } => count(known_deviations) == 0 && match unknowns.head {
                  MemoryTrainingScreenUnresolved { dimm: _, implication: PartSampleQualificationRequired { step: _, standing: _ } } => true
                  _ => false
                }
                _ => false
              })
            _ => false
          } } else { match line {
            LineResolved { line: _, fulfillment: NewPurchase { part: _, quantity: _, unit_price: _, authority: _ } } =>
              count(candidate_missing_inputs(candidate: memory_test_candidate(build: lines), declared: Usd)) > 0
            _ => false
          } })
      })
    }
  }
}

test fn w_missing_printed_part_binding_refuses_inventory_evidence() -> Bool {
  match mt_collins_channel_population_roles {
    PopulationRolesRefused { refusals: _ } => false
    PopulationRolesResolved { roles: fixture_roles } => {
      let c = mtcollins_training_collector(configuration: mtcollins_witnessed_configuration(roles: fixture_roles), payload: memory_test_payload(fixture_roles: fixture_roles))
      let unbound = MemoryCollectorReceipt { source: c.source, printed_parts: [], printed_positions: c.printed_positions, expected_payload_token: c.expected_payload_token, session: c.session,
        expected_stimulus: c.expected_stimulus, observed_stimulus: c.observed_stimulus,
        coverage: c.coverage, exit_code: c.exit_code, payload: c.payload,
        capture_digest: c.capture_digest, previous_capture_digest: c.previous_capture_digest }
      match mtcollins_training_mixture_finding(expected_byte: 145, attempt: "missing token binding", configuration: mtcollins_witnessed_configuration(roles: fixture_roles), collector: unbound) {
        ObservationRefused { cause } => contains(cause as String, "binding")
        ObservationEstablished { observed: _ } => false
      }
    }
  }
}

// Collector health alone cannot authenticate positive qualification standings:
// the payload must also cover the configuration the receipt claims to qualify.
test fn w_partial_inventory_cannot_establish_positive_qualification() -> Bool {
  match mt_collins_channel_population_roles {
    PopulationRolesRefused { refusals: _ } => false
    PopulationRolesResolved { roles: fixture_roles } => {
      let uniform = memory_test_uniform(fixture_roles: fixture_roles)
      let r = memory_test_other_obligations_established(fixture_roles: fixture_roles, configuration: MemoryConfiguration {
        platform: uniform.platform, population: filter(uniform.population, dimm => dimm.position.socket == 0) })
      let evidence = MemoryEvaluationEvidence { revision: "partial qualification capture", mixtures: r.memory_evidence.mixtures,
        training_failures: [], qualifications: map(r.memory_evidence.qualifications, receipt => ConfigurationQualificationReceipt {
          configuration: receipt.configuration, standings: receipt.standings,
          collector: mtcollins_training_collector(configuration: mtcollins_witnessed_configuration(roles: fixture_roles), payload: "DRAM populated DIMMs:\n  SK0 MC0 S0: 36ADS2G72PZ-2G1A1"),
        }) }
      let a = evaluate_memory_configuration(configuration: r.memory.proposed, evidence: evidence, additional: [])
      memory_test_has_unknown(a: a, obligation: MemoryClassSupport)
        && memory_test_has_unknown(a: a, obligation: MemoryTraining)
        && memory_test_has_unknown(a: a, obligation: MemoryBoot)
    }
  }
}

// Each case runs the real fulfillment fold. The build-level qualification
// cause occurs exactly once per affected axis, regardless of line outcomes.
test fn w_qualification_gap_survives_unread_and_missing_supply_once() -> Bool {
  match mt_collins_channel_population_roles {
    PopulationRolesRefused { refusals: _ } => false
    PopulationRolesResolved { roles: fixture_roles } => {
      let recipe = memory_test_recipe(fixture_roles: fixture_roles, configuration: memory_test_uniform(fixture_roles: fixture_roles), production: false)
      fold([true, false], init: true, f: (ok, unread) => {
        let rows = map(memory_test_market(recipe: recipe), row => SupplyRow {
          part: row.part, owned: row.owned,
          compatibility: if unread { CompatibilityEvidenceUnread { obligation: "supplier compatibility unread" } } else { row.compatibility },
          market: if unread { row.market } else { MarketNotOffered },
        })
        let build = resolve_build(recipe: recipe, rows: rows)
        let gaps = candidate_missing_inputs(candidate: memory_test_candidate(build: build), declared: Usd)
        ok && count(build.lines) > 1
          && count(filter(gaps, gap => gap.cause == "qualification experiment is not a production-admitted build")) == 2
          && count(gaps) == 2 + 2 * count(build.lines)
          && fold(build.lines, init: true, f: (valid, line) => valid && match line {
            LineResolved { line: _, fulfillment: CompatibilityUnread { part: _, obligation: _ } } => unread
            LineResolved { line: _, fulfillment: SupplyMissing { part: _, requested: _, owned_available: _, market_units: _ } } => !unread
            _ => false
          })
      })
    }
  }
}

test fn w_intermediate_initialization_explanation_locates_conflict() -> Bool {
  match mt_collins_channel_population_roles {
    PopulationRolesRefused { refusals: _ } => false
    PopulationRolesResolved { roles: fixture_roles } => {
      let final = memory_test_uniform(fixture_roles: fixture_roles)
      let proposal = memory_test_proposal(fixture_roles: fixture_roles, configuration: final, actions: [MemoryInitialize, MemoryPowerOff,
        MemoryReplacePopulation { population: final.population }, MemoryReadbackRequired])
      let assessment = evaluate_memory_change(proposal: proposal, evidence: memory_test_evidence(fixture_roles: fixture_roles))
      let explanation = explain_memory_change(assessment: assessment)
      !memory_test_package_violates(a: assessment.final_configuration)
        && any(explanation.lines, line => line == "initialization at action 0")
        && any(explanation.lines, line => contains(line as String, "byte6(decimal)=145")
          && contains(line as String, "byte6(decimal)=0") && contains(line as String, "J9")
          && contains(line as String, "210525") && contains(line as String, "source "))
    }
  }
}

// The returned frontier is bound to a live retirement subject, not to the
// appearance of a future consumer. Both states use the shared dissolution fold.
test fn w_power_frontier_retirement_is_bound_to_existing_carrier() -> Bool {
  match mt_collins_channel_population_roles {
    PopulationRolesRefused { refusals: _ } => false
    PopulationRolesResolved { roles: fixture_roles } => {
      let assessment = evaluate_memory_change(proposal: memory_test_proposal(fixture_roles: fixture_roles, configuration: memory_test_uniform(fixture_roles: fixture_roles),
        actions: [MemoryReadbackRequired]), evidence: memory_test_evidence(fixture_roles: fixture_roles))
      let target = decl_ref(module_path: "product.node_power_envelope", decl_name: "PopulationModuleRead")
      match assessment.consumer_frontiers.first() {
        Absent => false
        Present { value: frontier } =>
          dissolution_status(condition: frontier.dissolution, present_decls: [target]) == DissolutionPending
            && dissolution_status(condition: frontier.dissolution, present_decls: []) == DissolutionFired
      }
    }
  }
}

// The generic collector accepts an explicitly bound alternative format. The
// Mt. Collins recognizer still refuses it as evidence of that particular boot.
test fn w_collector_format_belongs_to_observing_producer() -> Bool {
  match mt_collins_channel_population_roles {
    PopulationRolesRefused { refusals: _ } => false
    PopulationRolesResolved { roles: fixture_roles } => {
      let configuration = mtcollins_witnessed_configuration(roles: fixture_roles)
      let c = mtcollins_training_collector(configuration: mtcollins_witnessed_configuration(roles: fixture_roles), payload: memory_test_payload(fixture_roles: fixture_roles))
      let positions = map(configuration.population, dimm => MemoryPrintedPositionBinding {
        position: dimm.position, printed: concat("connector ", dimm.position.connector as String, ":") as NonEmptyStr,
      })
      let parts = map(c.printed_parts, part => MemoryPrintedPartBinding { part: part.part, printed: "controlled module", required_descriptors: [] })
      let payload = concat("controlled inventory\n", join(map(positions, p => concat(p.printed as String, " controlled module")), "\n"))
      fold([true, false], init: true, f: (ok, complete) => {
        let collector = MemoryCollectorReceipt {
          source: c.source, printed_parts: parts, printed_positions: if complete { positions } else { [] },
          expected_payload_token: "controlled inventory", session: c.session,
          expected_stimulus: c.expected_stimulus, observed_stimulus: c.observed_stimulus,
          coverage: c.coverage,
          exit_code: c.exit_code, payload: payload, capture_digest: "controlled alternative format", previous_capture_digest: none,
        }
        ok && match memory_collector_refusal(c: collector) { Absent => true, Present { value: _ } => false }
          && memory_capture_covers_population(configuration: configuration, collector: collector) == complete
          && match mtcollins_training_mixture_finding(expected_byte: 145, attempt: "alternate-format control", configuration: configuration, collector: collector) {
            ObservationRefused { cause: _ } => true
            ObservationEstablished { observed: _ } => false
          }
      })
    }
  }
}

// These malformed pair controls execute the same authority join and placement
// consumer as production. Neither refusal may become a partial green roster.
test fn w_population_role_refusals_remain_unresolved_in_placement() -> Bool {
  match mt_collins_channel_population_roles {
    PopulationRolesRefused { refusals: _ } => false
    PopulationRolesResolved { roles } => {
      let configuration = mtcollins_witnessed_configuration(roles: roles)
      all([
        MtCollinsChannelConnectorPair { processor_socket: 0, memory_controller: 0, table_left_connector: 1, table_right_connector: 3 },
        MtCollinsChannelConnectorPair { processor_socket: 0, memory_controller: 0, table_left_connector: 2, table_right_connector: 4 },
      ], pair => {
        let standing = mt_collins_population_role_standing(pairs: [pair])
        let facts = memory_placement_from_roles(configuration: configuration, standing: standing)
        count(facts.deviations) == 0 && count(facts.unknowns) == 1 && any(facts.unknowns, unknown => match unknown {
          MemoryPopulationRoleUnresolved { refusal } => refusal.table_left_connector == pair.table_left_connector
            && refusal.table_right_connector == pair.table_right_connector
            && refusal.cause == if pair.table_left_connector == 1 { BothMembersAtOneDpc } else { NeitherMemberAtOneDpc }
          _ => false
        })
      })
    }
  }
}

// A synthetic role contrary to today's roster tests the projection; it is not
// a new claim about the physical board or its documentation.
test fn w_position_projection_uses_role_identity_not_connector_parity() -> Bool {
  let role = MtCollinsChannelPopulationRole { processor_socket: 0, memory_controller: 0,
    connector_used_at_one_dpc: 2, additional_connector_at_two_dpc: 1 }
  let primary = mtcollins_memory_position(role: role, additional: false)
  let additional = mtcollins_memory_position(role: role, additional: true)
  primary.connector == concat(dimm_figure_connector_label_prefix, "2")
    && primary.slot == one_dpc_diagram_legend.slot_number
    && additional.connector == concat(dimm_figure_connector_label_prefix, "1")
    && additional.slot == additional_two_dpc_diagram_legend.slot_number
}
