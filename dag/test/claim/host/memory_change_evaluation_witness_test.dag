data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// Controlled transcript excerpt, not a receipt that this test drove hardware.
// The production replay independently reads and verifies the full artifact.
fn memory_test_inventory(configuration: MemoryConfiguration) -> String {
  let inventory = map(configuration.population, dimm => concat(
    "  SK", to_string(dimm.position.socket), " MC", to_string(dimm.position.controller), " S0: ",
    if declaration_ref_eq(a: dimm.part, b: mtcollins_ads_part) { "36ADS2G72PZ-2G1A1" } else { memory_module_label(dimm: dimm) as String }))
  concat("DRAM populated DIMMs:\n", join(inventory, "\n"))
}

fn memory_test_payload(fixture_roles: List<MtCollinsChannelPopulationRole>) -> String {
  concat("NOTICE:  DRAM FW version 210525\n", memory_test_inventory(configuration: mtcollins_witnessed_configuration(roles: fixture_roles)),
    "\nERR: CHANNEL Mismatch Byte 6 SLOT0[00] EXP[91] @MCU[4]\nERROR:   SK[0]: 00110010\nERROR:   Non-identical DIMM mixture NOT supported!")
}

fn memory_test_evidence(fixture_roles: List<MtCollinsChannelPopulationRole>) -> MemoryEvaluationEvidence {
  mtcollins_memory_evidence_from_capture(configuration: mtcollins_witnessed_configuration(roles: fixture_roles), payload: memory_test_payload(fixture_roles: fixture_roles))
}

fn memory_test_proposal(fixture_roles: List<MtCollinsChannelPopulationRole>, configuration: MemoryConfiguration, actions: List<MemoryPlanAction>) -> MemoryChangeProposal {
  MemoryChangeProposal { initial: mtcollins_witnessed_configuration(roles: fixture_roles), proposed: configuration,
    actions: actions, additional_requirements: [] }
}

fn memory_test_uniform(fixture_roles: List<MtCollinsChannelPopulationRole>) -> MemoryConfiguration {
  let original = mtcollins_witnessed_configuration(roles: fixture_roles)
  MemoryConfiguration { platform: original.platform, population: map(original.population, dimm =>
    mtcollins_memory_module(position: dimm.position, ads: true)) }
}

fn memory_test_assess(fixture_roles: List<MtCollinsChannelPopulationRole>, configuration: MemoryConfiguration) -> MemoryConfigurationAssessment {
  evaluate_memory_configuration(configuration: configuration, evidence: memory_test_evidence(fixture_roles: fixture_roles), additional: [])
}

fn memory_test_package_violates(a: MemoryConfigurationAssessment) -> Bool {
  any(a.results, r => r.obligation == MemoryPackageMixture && match r.assessment {
    GoalDiverged { deviations } => match deviations.head {
      MemoryPackageConflict { left, right, left_variant: _, right_variant: _, left_byte, right_byte, finding } =>
        left.position.socket == right.position.socket && left_byte != right_byte
          && finding.configuration.platform.firmware == "210525" && finding.comparison_socket == 0
      _ => false
    }
    GoalIndeterminate { known_deviations, unknowns: _ } => count(known_deviations) > 0
    _ => false
  })
}

fn memory_test_has_unknown(a: MemoryConfigurationAssessment, obligation: MemoryOperatingObligation) -> Bool {
  any(a.results, r => r.obligation == obligation && match r.assessment {
    GoalIndeterminate { known_deviations: _, unknowns: _ } => true
    _ => false
  })
}

fn memory_test_recipe(fixture_roles: List<MtCollinsChannelPopulationRole>, configuration: MemoryConfiguration, production: Bool) -> NodeRecipe {
  let proposal = memory_test_proposal(fixture_roles: fixture_roles, configuration: configuration,
    actions: [MemoryPowerOff, MemoryReplacePopulation { population: configuration.population }, MemoryReadbackRequired])
  NodeRecipe { label: "memory evaluation control", sockets: 2,
    processor: configuration.platform.processor, processor_label: "processor display label",
    baseboard: configuration.platform.board_part, baseboard_label: "board display label",
    memory: proposal, memory_evidence: memory_test_evidence(fixture_roles: fixture_roles),
    memory_purchase: if production { ProductionMemoryPurchase } else {
      QualificationMemoryPurchase { maximum_units: 16, completion: memory_operating_obligations }
    }, inclusions: [],
  }
}

// Controlled axis readings isolate the admission-gap projection. Fulfillment
// and its bound purpose/assessment come from resolve_build, not a fixture copy.
fn memory_test_candidate(build: BuildResolution) -> BuildCandidate {
  BuildCandidate {
    identity: decl_ref(module_path: "test.claim.memory_change_evaluation_witness", decl_name: "memory_test_candidate"),
    display_label: "qualification projection control",
    memory_capacity: byte_size(count: 1), wall_power: watt(count: 1), memory_bandwidth: Bandwidth { count: 1 },
    resolutions: build, cash: CashNoPurchaseLines,
    ceiling: CeilingDerived { builds: 1, bottlenecks: [], bottleneck_units: 1 },
  }
}

test fn w_witnessed_mixture_has_located_firmware_counterexample() -> Bool {
  match mt_collins_channel_population_roles {
    PopulationRolesRefused { refusals: _ } => false
    PopulationRolesResolved { roles: fixture_roles } => {
      memory_test_package_violates(a: memory_test_assess(fixture_roles: fixture_roles, configuration: mtcollins_witnessed_configuration(roles: fixture_roles)))
    }
  }
}

test fn w_uniform_ads_clears_only_the_observed_mixing_check() -> Bool {
  match mt_collins_channel_population_roles {
    PopulationRolesRefused { refusals: _ } => false
    PopulationRolesResolved { roles: fixture_roles } => {
      let a = memory_test_assess(fixture_roles: fixture_roles, configuration: memory_test_uniform(fixture_roles: fixture_roles))
      any(a.results, r => r.obligation == MemoryPackageMixture && match r.assessment { GoalSatisfied { evidence: _ } => true, _ => false })
        && memory_test_has_unknown(a: a, obligation: MemoryFirmwareScopeCoverage)
        && memory_test_has_unknown(a: a, obligation: MemoryTraining)
        && memory_test_has_unknown(a: a, obligation: MemoryBoot)
        && match memory_configuration_admission_refusal(a: a, purpose: ProductionMemoryPurchase) { Present { value: _ } => true, Absent => false }
    }
  }
}

test fn w_missing_candidate_package_is_unresolved() -> Bool {
  match mt_collins_channel_population_roles {
    PopulationRolesRefused { refusals: _ } => false
    PopulationRolesResolved { roles: fixture_roles } => {
      let original = memory_test_uniform(fixture_roles: fixture_roles)
      let configuration = MemoryConfiguration { platform: original.platform,
        population: map(original.population, dimm => PositionedMemoryModule {
          position: dimm.position, part: dimm.part, identity: dimm.identity, origin: dimm.origin,
          alternatives: map(dimm.alternatives, v => MemoryDeliveryVariant { identity: v.identity,
            package: if dimm.position.controller == 0 { none } else { v.package }, register_vendor: v.register_vendor }),
        }) }
      memory_test_has_unknown(a: memory_test_assess(fixture_roles: fixture_roles, configuration: configuration), obligation: MemoryPackageMixture)
    }
  }
}

test fn w_display_label_does_not_change_rejection() -> Bool {
  match mt_collins_channel_population_roles {
    PopulationRolesRefused { refusals: _ } => false
    PopulationRolesResolved { roles: fixture_roles } => {
      let a = memory_test_recipe(fixture_roles: fixture_roles, configuration: mtcollins_witnessed_configuration(roles: fixture_roles), production: true)
      let b = NodeRecipe { label: "unrelated new label", sockets: a.sockets, processor: a.processor,
        processor_label: a.processor_label, baseboard: a.baseboard, baseboard_label: a.baseboard_label,
        memory: a.memory, memory_evidence: a.memory_evidence, memory_purchase: a.memory_purchase, inclusions: a.inclusions }
      resolve_build(recipe: a, rows: []) == resolve_build(recipe: b, rows: [])
    }
  }
}

test fn w_changed_firmware_rechecks_applicability() -> Bool {
  match mt_collins_channel_population_roles {
    PopulationRolesRefused { refusals: _ } => false
    PopulationRolesResolved { roles: fixture_roles } => {
      let original = mtcollins_witnessed_configuration(roles: fixture_roles)
      let p = original.platform
      let changed = MemoryConfiguration { platform: gunbc.memory_configuration.MemoryPlatform {
        host: p.host, board: p.board, board_part: p.board_part, processor: p.processor, firmware: "different firmware", settings: p.settings }, population: original.population }
      let a = memory_test_assess(fixture_roles: fixture_roles, configuration: changed)
      !memory_test_package_violates(a: a) && memory_test_has_unknown(a: a, obligation: MemoryPackageMixture)
    }
  }
}

test fn w_socket_boundary_is_not_a_global_part_blocklist() -> Bool {
  match mt_collins_channel_population_roles {
    PopulationRolesRefused { refusals: _ } => false
    PopulationRolesResolved { roles: fixture_roles } => {
      let original = mtcollins_witnessed_configuration(roles: fixture_roles)
      let separated = MemoryConfiguration { platform: original.platform, population: map(original.population, dimm =>
        if dimm.position.socket == 0 { mtcollins_memory_module(position: dimm.position, ads: true) } else { dimm }) }
      !memory_test_package_violates(a: memory_test_assess(fixture_roles: fixture_roles, configuration: separated))
    }
  }
}

test fn w_intermediate_initialization_blocks_homogeneous_final_plan() -> Bool {
  match mt_collins_channel_population_roles {
    PopulationRolesRefused { refusals: _ } => false
    PopulationRolesResolved { roles: fixture_roles } => {
      let final = memory_test_uniform(fixture_roles: fixture_roles)
      let bad = memory_test_proposal(fixture_roles: fixture_roles, configuration: final, actions: [MemoryInitialize, MemoryPowerOff,
        MemoryReplacePopulation { population: final.population }, MemoryReadbackRequired])
      let good = memory_test_proposal(fixture_roles: fixture_roles, configuration: final, actions: [MemoryPowerOff,
        MemoryReplacePopulation { population: final.population }, MemoryReadbackRequired])
      let purpose = QualificationMemoryPurchase { maximum_units: 16, completion: memory_operating_obligations }
      match memory_change_admission_refusal(a: evaluate_memory_change(proposal: bad, evidence: memory_test_evidence(fixture_roles: fixture_roles)), purpose: purpose) {
        Absent => false
        Present { value: _ } => match memory_change_admission_refusal(a: evaluate_memory_change(proposal: good, evidence: memory_test_evidence(fixture_roles: fixture_roles)), purpose: purpose) {
          Absent => true
          Present { value: _ } => false
        }
      }
    }
  }
}

test fn w_empty_coverage_cannot_admit_production() -> Bool {
  match mt_collins_channel_population_roles {
    PopulationRolesRefused { refusals: _ } => false
    PopulationRolesResolved { roles: fixture_roles } => {
      let a = memory_test_assess(fixture_roles: fixture_roles, configuration: memory_test_uniform(fixture_roles: fixture_roles))
      let empty = MemoryConfigurationAssessment { configuration: a.configuration, evidence: a.evidence, mixture_observations: a.mixture_observations, required: [], results: [] }
      match memory_configuration_admission_refusal(a: empty, purpose: ProductionMemoryPurchase) { Present { value: _ } => true, Absent => false }
    }
  }
}

test fn w_production_fulfillment_refuses_witnessed_configuration() -> Bool {
  match mt_collins_channel_population_roles {
    PopulationRolesRefused { refusals: _ } => false
    PopulationRolesResolved { roles: fixture_roles } => {
      let recipe = memory_test_recipe(fixture_roles: fixture_roles, configuration: mtcollins_witnessed_configuration(roles: fixture_roles), production: true)
      let lines = resolve_build(recipe: recipe, rows: [])
      count(lines.lines) > 0 && fold(lines.lines, init: true, f: (ok, line) => ok && match line {
        LineRefused { line: _, cause: MemoryProposalNotAdmitted { assessment, reason: _ } } => memory_test_package_violates(a: assessment.final_configuration)
        _ => false
      }) && match incremental_cash_now(resolutions: lines, declared_currency: Usd) { CashRefused { cause: _ } => true, _ => false }
    }
  }
}

data memory_test_short_capture_seconds: Seconds = 3

fn memory_test_broken_collector(fixture_roles: List<MtCollinsChannelPopulationRole>, failed: Bool) -> MemoryCollectorReceipt {
  let c = mtcollins_training_collector(configuration: mtcollins_witnessed_configuration(roles: fixture_roles), payload: memory_test_payload(fixture_roles: fixture_roles))
  MemoryCollectorReceipt { source: c.source, printed_parts: c.printed_parts, printed_positions: c.printed_positions, expected_payload_token: c.expected_payload_token, session: c.session, expected_stimulus: c.expected_stimulus,
    observed_stimulus: c.observed_stimulus, coverage: if failed { c.coverage } else {
      MemoryCaptureInterval { required_start: 0, required_end: 645, collector_start: 0, collector_end: memory_test_short_capture_seconds } },
    exit_code: if failed { 1 } else { 0 }, payload: c.payload, capture_digest: c.capture_digest, previous_capture_digest: c.previous_capture_digest }
}

test fn w_incomplete_and_failed_collectors_cannot_construct_findings() -> Bool {
  match mt_collins_channel_population_roles {
    PopulationRolesRefused { refusals: _ } => false
    PopulationRolesResolved { roles: fixture_roles } => {
      fold([true, false], init: true, f: (ok, failed) => ok && match mtcollins_training_mixture_finding(expected_byte: 145,
        attempt: "control", configuration: mtcollins_witnessed_configuration(roles: fixture_roles), collector: memory_test_broken_collector(fixture_roles: fixture_roles, failed: failed)) {
          ObservationRefused { cause: _ } => true
          ObservationEstablished { observed: _ } => false
        })
    }
  }
}

test fn w_failed_collector_cannot_establish_class_qualification() -> Bool {
  match mt_collins_channel_population_roles {
    PopulationRolesRefused { refusals: _ } => false
    PopulationRolesResolved { roles: fixture_roles } => {
      let configuration = mtcollins_witnessed_configuration(roles: fixture_roles)
      let evidence = memory_test_evidence(fixture_roles: fixture_roles)
      let changed = MemoryEvaluationEvidence { revision: evidence.revision, mixtures: evidence.mixtures, training_failures: [],
        qualifications: [ConfigurationQualificationReceipt { configuration: configuration, collector: memory_test_broken_collector(fixture_roles: fixture_roles, failed: true),
          standings: map(configuration.population, dimm => HostMemoryStanding {
            host: configuration.platform.host, part_number: memory_module_label(dimm: dimm), population: [dimm.position.connector],
            class_support: ClassSupportedByBoard, part_qualification: PartQualificationUnobserved,
            training: TrainingOutcomeUnobserved, boot: BootOutcomeUnobserved, observed_at: 0,
          }) }] }
      memory_test_has_unknown(a: evaluate_memory_configuration(configuration: configuration, evidence: changed, additional: []), obligation: MemoryClassSupport)
    }
  }
}

test fn w_procurement_alternatives_name_the_delivery_condition() -> Bool {
  match mt_collins_channel_population_roles {
    PopulationRolesRefused { refusals: _ } => false
    PopulationRolesResolved { roles: fixture_roles } => {
      let original = mtcollins_witnessed_configuration(roles: fixture_roles)
      let uncertain = MemoryConfiguration { platform: original.platform, population: map(original.population, dimm =>
        PositionedMemoryModule { position: dimm.position, part: dimm.part, identity: dimm.identity, origin: dimm.origin,
          alternatives: if dimm.position.socket == 0 && dimm.position.controller == 0 {
            concat(mtcollins_memory_variants(ads: true), mtcollins_memory_variants(ads: false))
          } else { mtcollins_memory_variants(ads: false) } }) }
      let a = memory_test_assess(fixture_roles: fixture_roles, configuration: uncertain)
      !memory_test_package_violates(a: a) && any(a.results, r => r.obligation == MemoryPackageMixture && match r.assessment {
        GoalIndeterminate { known_deviations: _, unknowns } => any(concat([unknowns.head], unknowns.tail), u => match u {
          MemoryProcurementCondition { counterexample: _, condition: _ } => true
          _ => false
        })
        _ => false
      })
    }
  }
}

test fn w_unknown_register_vendor_does_not_prevent_package_comparison() -> Bool {
  match mt_collins_channel_population_roles {
    PopulationRolesRefused { refusals: _ } => false
    PopulationRolesResolved { roles: fixture_roles } => {
      let original = memory_test_uniform(fixture_roles: fixture_roles)
      let with_registers = MemoryConfiguration { platform: original.platform, population: map(original.population, dimm =>
        PositionedMemoryModule { position: dimm.position, part: dimm.part, identity: dimm.identity, origin: dimm.origin,
          alternatives: map(dimm.alternatives, v => MemoryDeliveryVariant { identity: v.identity, package: v.package,
            register_vendor: Present { value: "b3:80" } }) }) }
      let absent = memory_test_assess(fixture_roles: fixture_roles, configuration: original)
      let known = memory_test_assess(fixture_roles: fixture_roles, configuration: with_registers)
      any(absent.results, r => r.obligation == MemoryPackageMixture && match r.assessment { GoalSatisfied { evidence: _ } => true, _ => false })
        && any(known.results, r => r.obligation == MemoryPackageMixture && match r.assessment { GoalSatisfied { evidence: _ } => true, _ => false })
    }
  }
}

test fn w_identical_hashes_are_suspicion_not_self_observation_proof() -> Bool {
  match mt_collins_channel_population_roles {
    PopulationRolesRefused { refusals: _ } => false
    PopulationRolesResolved { roles: fixture_roles } => {
      let c = mtcollins_training_collector(configuration: mtcollins_witnessed_configuration(roles: fixture_roles), payload: memory_test_payload(fixture_roles: fixture_roles))
      let repeated = MemoryCollectorReceipt { source: c.source, printed_parts: c.printed_parts, printed_positions: c.printed_positions, expected_payload_token: c.expected_payload_token, session: c.session, expected_stimulus: c.expected_stimulus,
        observed_stimulus: c.observed_stimulus, coverage: c.coverage, exit_code: c.exit_code,
        payload: c.payload, capture_digest: c.capture_digest, previous_capture_digest: Present { value: c.capture_digest } }
      let incomplete = MemoryCollectorReceipt { source: repeated.source, printed_parts: repeated.printed_parts, printed_positions: repeated.printed_positions, expected_payload_token: repeated.expected_payload_token,
        session: repeated.session, expected_stimulus: repeated.expected_stimulus, observed_stimulus: repeated.observed_stimulus,
        coverage: MemoryCaptureInterval { required_start: 0, required_end: 645, collector_start: 0, collector_end: 0 }, exit_code: repeated.exit_code,
        payload: repeated.payload, capture_digest: repeated.capture_digest, previous_capture_digest: repeated.previous_capture_digest }
      let explained = match memory_collector_refusal(c: incomplete) {
        Present { value: cause } => contains(cause as String, "repeated capture digest") && contains(cause as String, "required stimulus interval")
        Absent => false
      }
      explained && match mtcollins_training_mixture_finding(expected_byte: 145, attempt: "control",
        configuration: mtcollins_witnessed_configuration(roles: fixture_roles), collector: repeated) {
          ObservationEstablished { observed: _ } => true
          ObservationRefused { cause: _ } => false
        }
    }
  }
}

test fn w_qualification_purchase_is_bound_and_not_production_ranked() -> Bool {
  match mt_collins_channel_population_roles {
    PopulationRolesRefused { refusals: _ } => false
    PopulationRolesResolved { roles: fixture_roles } => {
      let recipe = memory_test_recipe(fixture_roles: fixture_roles, configuration: memory_test_uniform(fixture_roles: fixture_roles), production: false)
      let rows = map(derive_bom(recipe: recipe), line => SupplyRow { part: line.part,
        compatibility: CompatibilityEstablished, owned: NoOwnedLot,
        market: MarketDepthCited { units_available: 32,
          unit_price: MoneyOnce { amount: money_amount_micro(count: 100), currency: Usd },
          authority: ExternalAuthority { uri: Uri { scheme: File, locator: "dag/test/claim/host/memory_change_evaluation_witness_test.dag" } } },
      })
      let lines = resolve_build(recipe: recipe, rows: rows)
      count(lines.lines) > 0 && fold(lines.lines, init: true, f: (ok, r) => ok && match r {
        LineResolved { line: _, fulfillment: NewPurchase { part: _, quantity: _, unit_price: _, authority: _ } } =>
          lines.memory_context.assessment.proposal == recipe.memory
            && lines.memory_context.assessment.final_configuration.evidence.revision == recipe.memory_evidence.revision
            && count(candidate_missing_inputs(candidate: memory_test_candidate(build: lines), declared: Usd)) == 2
        _ => false
      })
    }
  }
}

test fn w_unmodelled_required_obligation_is_executed_as_unresolved() -> Bool {
  match mt_collins_channel_population_roles {
    PopulationRolesRefused { refusals: _ } => false
    PopulationRolesResolved { roles: fixture_roles } => {
      let requirement = AdditionalMemoryRequirement { authority: decl_ref(module_path: "test.claim.memory_change_evaluation_witness", decl_name: "w_unmodelled_required_obligation_is_executed_as_unresolved") }
      let a = evaluate_memory_configuration(configuration: memory_test_uniform(fixture_roles: fixture_roles), evidence: memory_test_evidence(fixture_roles: fixture_roles), additional: [requirement])
      memory_test_has_unknown(a: a, obligation: requirement)
    }
  }
}


test fn w_incomplete_inventory_cannot_bind_a_firmware_finding() -> Bool {
  match mt_collins_channel_population_roles {
    PopulationRolesRefused { refusals: _ } => false
    PopulationRolesResolved { roles: fixture_roles } => {
      all(mtcollins_memory_evidence_from_capture(configuration: mtcollins_witnessed_configuration(roles: fixture_roles), payload: "NOTICE:  DRAM FW version 210525\nDRAM populated DIMMs:\nERR: CHANNEL Mismatch Byte 6 SLOT0[00] EXP[91] @MCU[4]\nERROR:   SK[0]: 00110010\nERROR:   Non-identical DIMM mixture NOT supported!").mixtures, attempt => match attempt {
        ObservationRefused { cause: _ } => true
        _ => false
      })
    }
  }
}


// Controlled positive axes isolate the firmware obligation in the production
// consumer. These hypothetical standings are NOT claims about uniform ADS on
// the real host. The observing failure basis remains the witnessed population.
fn memory_test_other_obligations_established(fixture_roles: List<MtCollinsChannelPopulationRole>, configuration: MemoryConfiguration) -> NodeRecipe {
  let r = memory_test_recipe(fixture_roles: fixture_roles, configuration: configuration, production: true)
  let e = memory_test_evidence(fixture_roles: fixture_roles)
  NodeRecipe { label: r.label, sockets: r.sockets, processor: r.processor, processor_label: r.processor_label,
    baseboard: r.baseboard, baseboard_label: r.baseboard_label, memory: r.memory,
    memory_purchase: r.memory_purchase, inclusions: r.inclusions,
    memory_evidence: MemoryEvaluationEvidence { revision: "controlled positive axes, not a machine observation", mixtures: e.mixtures,
      training_failures: [], qualifications: [ConfigurationQualificationReceipt {
        configuration: configuration, collector: mtcollins_training_collector(configuration: mtcollins_witnessed_configuration(roles: fixture_roles), payload: memory_test_inventory(configuration: configuration)),
        standings: map(configuration.population, dimm => HostMemoryStanding {
          host: configuration.platform.host, part_number: memory_module_label(dimm: dimm), population: [dimm.position.connector],
          class_support: ClassSupportedByBoard,
          part_qualification: ListedInVendorAvl {
            avl_authority: ExternalAuthority { uri: Uri { scheme: File, locator: "dag/test/claim/host/memory_change_evaluation_witness_test.dag" } },
            avl_issue: "hypothetical positive control",
          }, training: TrainingOperational { dimm_mask: "controlled" }, boot: BootReachedOperatingSystem, observed_at: 0,
        }),
      }] },
  }
}

fn memory_test_market(recipe: NodeRecipe) -> List<SupplyRow> {
  map(derive_bom(recipe: recipe), line => SupplyRow { part: line.part,
    compatibility: CompatibilityEstablished, owned: NoOwnedLot,
    market: MarketDepthCited { units_available: 32,
      unit_price: MoneyOnce { amount: money_amount_micro(count: 100), currency: Usd },
      authority: ExternalAuthority { uri: Uri { scheme: File, locator: "dag/test/claim/host/memory_change_evaluation_witness_test.dag" } } },
  })
}

test fn w_production_fulfillment_conflict_is_decisive_with_other_obligations_satisfied() -> Bool {
  match mt_collins_channel_population_roles {
    PopulationRolesRefused { refusals: _ } => false
    PopulationRolesResolved { roles: fixture_roles } => {
      let original = mtcollins_witnessed_configuration(roles: fixture_roles)
      let uniform = memory_test_uniform(fixture_roles: fixture_roles)
      let mixed = memory_test_other_obligations_established(fixture_roles: fixture_roles, configuration: MemoryConfiguration {
        platform: original.platform, population: filter(original.population, dimm => dimm.position.socket == 0) })
      let homogeneous = memory_test_other_obligations_established(fixture_roles: fixture_roles, configuration: MemoryConfiguration {
        platform: uniform.platform, population: filter(uniform.population, dimm => dimm.position.socket == 0) })
      let bad = resolve_build(recipe: mixed, rows: memory_test_market(recipe: mixed))
      let good = resolve_build(recipe: homogeneous, rows: memory_test_market(recipe: homogeneous))
      count(bad.lines) > 0 && count(good.lines) > 0
        && fold(bad.lines, init: true, f: (ok, r) => ok && match r {
          LineRefused { line: _, cause: MemoryProposalNotAdmitted { assessment, reason: _ } } => memory_test_package_violates(a: assessment.final_configuration)
          _ => false
        })
        && fold(good.lines, init: true, f: (ok, r) => ok && match r {
          LineResolved { line: _, fulfillment: NewPurchase { part: _, quantity: _, unit_price: _, authority: _ } } =>
            good.memory_context.purpose == ProductionMemoryPurchase && count(line_missing(acc: [], r: r)) == 0
          _ => false
        })
    }
  }
}


