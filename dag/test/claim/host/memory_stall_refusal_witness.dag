module test.claim.host.memory_stall_refusal_witness

import std.logic { Bool }
import std.types { String, Int }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.nat { Nat }
import std.measure {
  Millisecond,
  millisecond,
  millisecond_count,
  microsecond,
  basis_point_count,
  events_per_minute_count,
}
import gunbc.host.memory_stall_refusal {
  MemoryStallObservation,
  MemoryStallVerdict,
  StallWindowOpen,
  ProgressUnderMemoryAdmissible,
  StallRefusedPageThrash,
  memory_stall_verdict,
  memory_stall_verdict_refuses,
  memory_stall_major_fault_rate,
  memory_stall_self_cpu_share,
  memory_stall_refusal_pressure_text,
  memory_stall_major_fault_rate_threshold,
  memory_stall_verdict_window_minimum_wall,
  memory_stall_progress_cpu_share_floor,
  SupervisedSubjectWindow,
  SupervisedSubjectVerdict,
  SupervisedSubjectProgressing,
  SupervisedSubjectSilentWithoutEnvelopeEvidence,
  SupervisedSubjectRefusedEnvelopeThrottle,
  SupervisedSubjectRefusedPageThrash,
  supervised_subject_verdict,
  supervised_subject_verdict_refuses,
  supervised_subject_refusal_text,
  supervised_subject_no_progress_window_minimum_wall,
  supervised_subject_envelope_pressure_full_share_floor,
}
import extdeps.linux.psi { PsiStallInterval, PsiStallMeasured, PsiStallUnmeasurable }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data thrash_fixture_grounding_note: String = "BOTH PRESSURED FIXTURES ARE MEASURED SPECIMENS, and the pair is the module's whole content: rate alone cannot separate them. The RED is the 2026-08-30 default-VM treadmill shape, MEASURED on the reproduction trace (gunbc.host.memory_stall_refusal memory_stall_progress_cpu_share_floor's receipt, invocation dd090164-9f2b-45fe-93bc-789cdd4ef9c4): a swapless machine smaller than the working set sustained 178795 major faults/minute with user CPU flat at 0.8% of wall, because the wall is disk wait; the fixture's 60000/minute at 4% is the same shape at conservative magnitude -- a verdict that needs the full measured extremity to fire would be tuned to one specimen. The ADMITTED control is the CI floor runner specimen that the rate-only form of this verdict wrongly refused on its own first execution (memory_stall_admitted_under_pressure_receipt_note, gunbc run 33319823294): 163296 major faults over a 788140 ms window -- 12431/minute, over the rate line -- during one 13-minute CPU-bound typecheck under a memory.high reclaim throttle, a configuration that completes green on main daily. The CPU-share conjunct is what admits the second while refusing the first, and these two rows are the executable form of that distinction. The SLOW control is the other acceptance boundary: an hour of wall with the fault counter flat is merely slow, and no verdict may refuse it however long it runs -- time enters this decision only as a rate denominator."

fn treadmill_window() -> MemoryStallObservation {
  MemoryStallObservation {
    window_wall: millisecond(count: 120000),
    major_faults_in_window: 120000,
    self_user_cpu_in_window: millisecond(count: 4800),
    cache_evictions_in_window: 4213,
    cache_readmissions_in_window: 388,
  }
}

fn ci_progressing_under_pressure_window() -> MemoryStallObservation {
  MemoryStallObservation {
    window_wall: millisecond(count: 788140),
    major_faults_in_window: 163296,
    self_user_cpu_in_window: millisecond(count: 552000),
    cache_evictions_in_window: 0,
    cache_readmissions_in_window: 0,
  }
}

fn slow_but_progressing_hour() -> MemoryStallObservation {
  MemoryStallObservation {
    window_wall: millisecond(count: 3600000),
    major_faults_in_window: 60,
    self_user_cpu_in_window: millisecond(count: 3200000),
    cache_evictions_in_window: 0,
    cache_readmissions_in_window: 0,
  }
}

test fn RED_a_treadmill_window_refuses_and_names_the_pressure() -> Bool {
  let verdict = memory_stall_verdict(o: treadmill_window())
  memory_stall_verdict_refuses(v: verdict)
    && string_contains(
      s: memory_stall_refusal_pressure_text(v: verdict),
      pattern: "MemoryStallRefusedPageThrash"
    )
    && string_contains(
      s: memory_stall_refusal_pressure_text(v: verdict),
      pattern: "/proc/self/stat"
    )
    && string_contains(s: memory_stall_refusal_pressure_text(v: verdict), pattern: "--entry")
    && string_contains(s: memory_stall_refusal_pressure_text(v: verdict), pattern: "readmissions 388")
}

// The measured specimen the rate-only verdict wrongly refused: over the rate line, but
// computing for 70% of its wall. It must ADMIT, or the floor's own slow typecheck phases
// red every crowded runner.
test fn the_ci_runner_progressing_under_pressure_specimen_is_admitted() -> Bool {
  match memory_stall_verdict(o: ci_progressing_under_pressure_window()) {
    ProgressUnderMemoryAdmissible { major_fault_rate: rate, self_cpu_share: share } =>
      events_per_minute_count(r: rate) == 12431 && basis_point_count(bp: share) == 7003
    StallWindowOpen { window_wall: _, minimum_wall: _ } => false
    StallRefusedPageThrash {
      major_fault_rate: _,
      rate_threshold: _,
      self_cpu_share: _,
      cpu_share_floor: _,
      observation: _,
    } => false
  }
}

test fn a_slow_but_progressing_resolve_is_admitted_however_long_it_runs() -> Bool {
  match memory_stall_verdict(o: slow_but_progressing_hour()) {
    ProgressUnderMemoryAdmissible { major_fault_rate: rate, self_cpu_share: _ } =>
      events_per_minute_count(r: rate) == 1
    StallWindowOpen { window_wall: _, minimum_wall: _ } => false
    StallRefusedPageThrash {
      major_fault_rate: _,
      rate_threshold: _,
      self_cpu_share: _,
      cpu_share_floor: _,
      observation: _,
    } => false
  }
}

// A cold-start refault burst inside a short window is NOT a verdict in either direction:
// the window is still open, which is neither an admission (the treadmill also starts with
// a burst) nor a refusal (so does a healthy process's first read of its inputs).
test fn a_burst_below_the_minimum_window_is_an_open_window_not_a_verdict() -> Bool {
  match memory_stall_verdict(o: MemoryStallObservation {
    window_wall: millisecond(count: millisecond_count(m: memory_stall_verdict_window_minimum_wall) - 1),
    major_faults_in_window: 1000000,
    self_user_cpu_in_window: millisecond(count: 0),
    cache_evictions_in_window: 0,
    cache_readmissions_in_window: 0,
  }) {
    StallWindowOpen { window_wall: w, minimum_wall: m } =>
      millisecond_count(m: w) == millisecond_count(m: memory_stall_verdict_window_minimum_wall) - 1
        && millisecond_count(m: m) == millisecond_count(m: memory_stall_verdict_window_minimum_wall)
    ProgressUnderMemoryAdmissible { major_fault_rate: _, self_cpu_share: _ } => false
    StallRefusedPageThrash {
      major_fault_rate: _,
      rate_threshold: _,
      self_cpu_share: _,
      cpu_share_floor: _,
      observation: _,
    } => false
  }
}

// Tight at BOTH declared lines, derived from the rows rather than retyped: with the CPU
// share pinned below its floor, a fault count at the rate line admits and one more
// refuses; with the rate pinned above its line, a CPU share at the floor admits and one
// percentage point less refuses. A fixture at an extreme would delete this test.
test fn the_refusal_is_tight_at_both_declared_lines() -> Bool {
  let at_rate_line = memory_stall_verdict(o: MemoryStallObservation {
    window_wall: millisecond(count: 60000),
    major_faults_in_window: events_per_minute_count(r: memory_stall_major_fault_rate_threshold),
    self_user_cpu_in_window: millisecond(count: 0),
    cache_evictions_in_window: 0,
    cache_readmissions_in_window: 0,
  })
  let over_rate_line = memory_stall_verdict(o: MemoryStallObservation {
    window_wall: millisecond(count: 60000),
    major_faults_in_window: events_per_minute_count(r: memory_stall_major_fault_rate_threshold) + 1,
    self_user_cpu_in_window: millisecond(count: 0),
    cache_evictions_in_window: 0,
    cache_readmissions_in_window: 0,
  })
  let at_cpu_floor = memory_stall_verdict(o: MemoryStallObservation {
    window_wall: millisecond(count: 100000),
    major_faults_in_window: 100000,
    self_user_cpu_in_window: millisecond(count: basis_point_count(bp: memory_stall_progress_cpu_share_floor) * 10),
    cache_evictions_in_window: 0,
    cache_readmissions_in_window: 0,
  })
  let under_cpu_floor = memory_stall_verdict(o: MemoryStallObservation {
    window_wall: millisecond(count: 100000),
    major_faults_in_window: 100000,
    self_user_cpu_in_window: millisecond(count: basis_point_count(bp: memory_stall_progress_cpu_share_floor) * 10 - 10),
    cache_evictions_in_window: 0,
    cache_readmissions_in_window: 0,
  })
  !memory_stall_verdict_refuses(v: at_rate_line)
    && memory_stall_verdict_refuses(v: over_rate_line)
    && !memory_stall_verdict_refuses(v: at_cpu_floor)
    && memory_stall_verdict_refuses(v: under_cpu_floor)
}

test fn the_projections_are_per_minute_and_basis_points_of_wall() -> Bool {
  events_per_minute_count(r: memory_stall_major_fault_rate(o: treadmill_window())) == 60000
    && basis_point_count(bp: memory_stall_self_cpu_share(o: treadmill_window())) == 400
    && events_per_minute_count(r: memory_stall_major_fault_rate(o: ci_progressing_under_pressure_window())) == 12431
    && basis_point_count(bp: memory_stall_self_cpu_share(o: ci_progressing_under_pressure_window())) == 7003
}

// The non-refusing arms render no pressure clause: a consumer that logs the clause
// unconditionally must not fabricate pressure prose for a window that admitted.
test fn only_the_refusal_carries_pressure_text() -> Bool {
  memory_stall_refusal_pressure_text(v: memory_stall_verdict(o: slow_but_progressing_hour())) == ""
    && memory_stall_refusal_pressure_text(v: memory_stall_verdict(o: MemoryStallObservation {
      window_wall: millisecond(count: 1000),
      major_faults_in_window: 0,
      self_user_cpu_in_window: millisecond(count: 0),
      cache_evictions_in_window: 0,
      cache_readmissions_in_window: 0,
    })) == ""
}

// ── THE SUPERVISED SUBJECT (the observer outside the subject) ──────────────────────────────────
//
// The windows below are supplied at the verdict's interface. The real producer -- the heal round's
// generation supervisor reading the slot's memory.stat, cpu.stat, memory.pressure and memory.events
// -- is paired with an inhabitance claim on the host side (v1_compiler.required_regen_host tests),
// because only a live cgroup can say what those files hold.

// Fifteen minutes and one millisecond of silence, so every refusal below is past the window.
fn silent_wall_ms() -> Int {
  millisecond_count(m: supervised_subject_no_progress_window_minimum_wall) + 1
}

fn quiet_slot(wall_ms: Int) -> MemoryStallObservation {
  MemoryStallObservation {
    window_wall: millisecond(count: wall_ms),
    major_faults_in_window: 0,
    self_user_cpu_in_window: millisecond(count: 0),
    cache_evictions_in_window: 0,
    cache_readmissions_in_window: 0,
  }
}

fn full_stall(share_bp: Int, wall_ms: Int) -> PsiStallInterval {
  PsiStallMeasured {
    stalled: microsecond(count: wall_ms * share_bp / 10),
    window: microsecond(count: wall_ms * 1000),
  }
}

// THE RED THIS ARM EXISTS FOR: a subject silent past the window while the slot's tasks lost most of
// their wall to memory and the slot crossed memory.high. No fault-rate evidence at all -- the
// page-thrash arm alone would hold this run to the step timeout, which is the srv3 heal ending.
test fn RED_a_silent_subject_under_the_envelope_throttle_refuses() -> Bool {
  let v = supervised_subject_verdict(w: SupervisedSubjectWindow {
    since_progress: quiet_slot(wall_ms: silent_wall_ms()),
    pressure: full_stall(share_bp: 8000, wall_ms: silent_wall_ms()),
    envelope_events_in_window: 412,
  })
  supervised_subject_verdict_refuses(v: v)
    && string_contains(s: supervised_subject_refusal_text(v: v), pattern: "MemoryStallRefusedEnvelopeThrottle")
    && string_contains(s: supervised_subject_refusal_text(v: v), pattern: "80% of that wall")
    && string_contains(s: supervised_subject_refusal_text(v: v), pattern: "412 time(s)")
}

// SEMANTIC PROGRESS OUTRANKS EVERY COUNTER: the same pressure one millisecond inside the window is
// progressing, because a mark arrived recently enough. This is the arm that keeps a healthy run that
// crosses memory.high and reclaims from ever being judged on its counters.
test fn a_recent_progress_mark_admits_whatever_the_pressure() -> Bool {
  let wall = millisecond_count(m: supervised_subject_no_progress_window_minimum_wall) - 1
  match supervised_subject_verdict(w: SupervisedSubjectWindow {
    since_progress: quiet_slot(wall_ms: wall),
    pressure: full_stall(share_bp: 10000, wall_ms: wall),
    envelope_events_in_window: 100000,
  }) {
    SupervisedSubjectProgressing { since_progress_wall: w, minimum_wall: _ } => millisecond_count(m: w) == wall
    SupervisedSubjectSilentWithoutEnvelopeEvidence { since_progress_wall: _, pressure: _, envelope_events_in_window: _, page_thrash: _ } => false
    SupervisedSubjectRefusedEnvelopeThrottle { since_progress_wall: _, pressure_full_share: _, pressure_full_share_floor: _, envelope_events_in_window: _ } => false
    SupervisedSubjectRefusedPageThrash { since_progress_wall: _, page_thrash: _ } => false
  }
}

// PRESSURE WITHOUT THE ENVELOPE, AND THE ENVELOPE WITHOUT PRESSURE, BOTH ADMIT. A high-event count is
// a witness that the boundary was crossed, never by itself evidence of a stall; PSI with no envelope
// event is pressure from something the slot contract does not own.
test fn each_throttle_half_alone_admits() -> Bool {
  let pressure_only = supervised_subject_verdict(w: SupervisedSubjectWindow {
    since_progress: quiet_slot(wall_ms: silent_wall_ms()),
    pressure: full_stall(share_bp: 9000, wall_ms: silent_wall_ms()),
    envelope_events_in_window: 0,
  })
  let envelope_only = supervised_subject_verdict(w: SupervisedSubjectWindow {
    since_progress: quiet_slot(wall_ms: silent_wall_ms()),
    pressure: full_stall(share_bp: 100, wall_ms: silent_wall_ms()),
    envelope_events_in_window: 5000,
  })
  !supervised_subject_verdict_refuses(v: pressure_only) && !supervised_subject_verdict_refuses(v: envelope_only)
}

// Tight at the declared floor: at the floor refuses, one basis point under admits.
test fn the_throttle_arm_is_tight_at_its_floor() -> Bool {
  let floor = basis_point_count(bp: supervised_subject_envelope_pressure_full_share_floor)
  let at_floor = supervised_subject_verdict(w: SupervisedSubjectWindow {
    since_progress: quiet_slot(wall_ms: silent_wall_ms()),
    pressure: full_stall(share_bp: floor, wall_ms: silent_wall_ms()),
    envelope_events_in_window: 1,
  })
  let under_floor = supervised_subject_verdict(w: SupervisedSubjectWindow {
    since_progress: quiet_slot(wall_ms: silent_wall_ms()),
    pressure: full_stall(share_bp: floor - 1, wall_ms: silent_wall_ms()),
    envelope_events_in_window: 1,
  })
  supervised_subject_verdict_refuses(v: at_floor) && !supervised_subject_verdict_refuses(v: under_floor)
}

// WHERE PSI IS UNREADABLE the page-thrash arm still judges -- the verdict above, over the slot's
// counters, not a second copy -- so a swapless host with no PSI files keeps the measured treadmill
// refusal. And a silent slot with neither kind of evidence is admitted: a hang is the timeout's.
test fn without_psi_the_page_thrash_arm_still_refuses_and_silence_alone_admits() -> Bool {
  let unmeasured: PsiStallInterval = PsiStallUnmeasurable { cause: "memory.pressure is absent" }
  let thrash = supervised_subject_verdict(w: SupervisedSubjectWindow {
    since_progress: MemoryStallObservation {
      window_wall: millisecond(count: silent_wall_ms()),
      major_faults_in_window: silent_wall_ms() / 6,
      self_user_cpu_in_window: millisecond(count: silent_wall_ms() / 50),
      cache_evictions_in_window: 0,
      cache_readmissions_in_window: 0,
    },
    pressure: unmeasured,
    envelope_events_in_window: 0,
  })
  let silence = supervised_subject_verdict(w: SupervisedSubjectWindow {
    since_progress: quiet_slot(wall_ms: silent_wall_ms() * 4),
    pressure: unmeasured,
    envelope_events_in_window: 0,
  })
  let thrash_refused = match thrash {
    SupervisedSubjectRefusedPageThrash { since_progress_wall: _, page_thrash: _ } =>
      string_contains(s: supervised_subject_refusal_text(v: thrash), pattern: "MemoryStallRefusedPageThrash")
        && string_contains(s: supervised_subject_refusal_text(v: thrash), pattern: "pgmajfault")
    SupervisedSubjectProgressing { since_progress_wall: _, minimum_wall: _ } => false
    SupervisedSubjectSilentWithoutEnvelopeEvidence { since_progress_wall: _, pressure: _, envelope_events_in_window: _, page_thrash: _ } => false
    SupervisedSubjectRefusedEnvelopeThrottle { since_progress_wall: _, pressure_full_share: _, pressure_full_share_floor: _, envelope_events_in_window: _ } => false
  }
  thrash_refused && !supervised_subject_verdict_refuses(v: silence) && supervised_subject_refusal_text(v: silence) == ""
}
