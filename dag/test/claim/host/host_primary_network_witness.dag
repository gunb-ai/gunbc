  srv1_primary_network_receipt_2026_10_25, srv1_nic_boot_readings, srv1_i210_mac, srv1_x550_port1_mac,
  selector_missed_boots, x550_link_speed_bearing, BelowNameplateOnEveryReadBoot, NameplateReachedOnSomeBoot, NoLinkRead,
