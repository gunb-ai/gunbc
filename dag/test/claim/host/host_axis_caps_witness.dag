module test.claim.host.host_axis_caps_witness

import std.logic { Bool }
import std.types { NonEmptyStr, String, List, Int, list_length }
import gunbc.host.host_axis_caps {
  CapMember,
  control_shadow_residue_paths,
  control_shadow_removal_argvs,
  runner_slot_cap_properties,
  slice_control_converge_argvs_for_unit,
  desired_cap_member,
  cap_dropin_content,
  cap_setting_member,
  caps_reconcile,
  derived_runner_memory_max_cap_setting,
  derived_runner_memory_high_cap_setting,
  derived_runner_memory_swap_cap_setting,
  derived_runner_slot_cap_settings,
  derived_runner_slot_cap_members,
  cap_upsert_script,
}
import gunbc.host.host_converge { SliceControlCaps, UncappedSliceControl, SessionsSliceControl }
import std.measure { byte_size, byte_size_count, hardware_thread_count }
import extdeps.posix.shell_command_language { posix_single_quote }
import gunbc.membership_reconcile {
  EffectsOrRefusal,
  EffectsReady,
  ApplyRefused,
  membership_effects,
  membership_write_count,
  membership_removal_count,
  membership_refusal_count,
}
import gunbc.host.host_converge {
  gunbc_runner_per_slot_dropin_path,
  gunbc_runner_per_slot_swap_dropin_path,
}
import gunbc.runner.runner_slot_desired { gunbc_runner_slot_desired }

data path20: NonEmptyStr = gunbc_runner_per_slot_dropin_path as NonEmptyStr
data path30: NonEmptyStr = gunbc_runner_per_slot_swap_dropin_path as NonEmptyStr
data foreign_path: NonEmptyStr = "/etc/systemd/system/actions-runner@.service.d/99-foreign.conf"
data mem_max: NonEmptyStr = "MemoryMax"
data swap_max: NonEmptyStr = "MemorySwapMax"
data bytes16g: NonEmptyStr = "17179869184"
data bytes32g: NonEmptyStr = "34359738368"
data bytes8g: NonEmptyStr = "8589934592"

// The reconcile's effects and counts, read here through the membership spine the fleet plan reads
// caps_reconcile with (gunbc.fleet.fleet_converge_plan).
fn caps_effects(desired: List<CapMember>, observed: List<CapMember>) -> EffectsOrRefusal<CapMember> {
  membership_effects(plan: caps_reconcile(desired: desired, observed: observed))
}

fn caps_upsert_count(desired: List<CapMember>, observed: List<CapMember>) -> Int {
  membership_write_count(plan: caps_reconcile(desired: desired, observed: observed))
}

fn caps_teardown_count(desired: List<CapMember>, observed: List<CapMember>) -> Int {
  membership_removal_count(plan: caps_reconcile(desired: desired, observed: observed))
}

fn caps_refusal_count(desired: List<CapMember>, observed: List<CapMember>) -> Int {
  membership_refusal_count(plan: caps_reconcile(desired: desired, observed: observed))
}

fn srv_caps_desired() -> List<CapMember> {
  [
    desired_cap_member(dropin_path: path20, property: mem_max, bytes_value: bytes16g),
    desired_cap_member(dropin_path: path30, property: swap_max, bytes_value: bytes32g),
  ]
}

test fn caps_idempotence_zero_effects() -> Bool {
  let d = srv_caps_desired()
  caps_upsert_count(desired: d, observed: d) == 0
    && caps_teardown_count(desired: d, observed: d) == 0
    && caps_refusal_count(desired: d, observed: d) == 0
    && match caps_effects(desired: d, observed: d) {
         EffectsReady { effects: e } => list_length(items: e) == 0
         ApplyRefused { refusals: _ } => false
       }
}

test fn caps_perturb_names_exactly_the_drifted_row() -> Bool {
  let d = srv_caps_desired()
  let observed = [
    CapMember { dropin_path: path20, content: cap_dropin_content(property: mem_max, bytes_value: bytes8g) },
    desired_cap_member(dropin_path: path30, property: swap_max, bytes_value: bytes32g),
  ]
  caps_upsert_count(desired: d, observed: observed) == 1
    && caps_teardown_count(desired: d, observed: observed) == 0
    && caps_refusal_count(desired: d, observed: observed) == 0
    && caps_upsert_count(desired: d, observed: d) == 0
}

test fn caps_foreign_occupant_refuses_never_deletes() -> Bool {
  let d = srv_caps_desired()
  let foreign = CapMember { dropin_path: foreign_path, content: "[Service]\nMemoryMax=1\n" }
  let observed = [
    desired_cap_member(dropin_path: path20, property: mem_max, bytes_value: bytes16g),
    desired_cap_member(dropin_path: path30, property: swap_max, bytes_value: bytes32g),
    foreign,
  ]
  caps_refusal_count(desired: d, observed: observed) == 1
    && caps_teardown_count(desired: d, observed: observed) == 0
    && match caps_effects(desired: d, observed: observed) {
         ApplyRefused { refusals: r } => list_length(items: r) == 1
         EffectsReady { effects: _ } => false
       }
    && caps_teardown_count(
         desired: [desired_cap_member(dropin_path: path20, property: mem_max, bytes_value: bytes16g)],
         observed: d,
       ) == 1
}

test fn caps_content_is_derived_not_handspelled() -> Bool {
  cap_dropin_content(property: mem_max, bytes_value: bytes16g) == "[Service]\nMemoryMax=17179869184\n"
    && cap_dropin_content(property: swap_max, bytes_value: bytes32g) == "[Service]\nMemorySwapMax=34359738368\n"
    && cap_dropin_content(property: mem_max, bytes_value: bytes8g) != cap_dropin_content(property: mem_max, bytes_value: bytes16g)
}

test fn witness_derived_memory_caps_match_allocation_authority() -> Bool {
  let max = cap_setting_member(s: derived_runner_memory_max_cap_setting())
  let high = cap_setting_member(s: derived_runner_memory_high_cap_setting())
  let desired = gunbc_runner_slot_desired()
  string_contains(s: max.content, pattern: to_string(byte_size_count(b: desired.memory_max)))
    && string_contains(s: max.dropin_path as String, pattern: "20-fleet-width")
    && string_contains(s: high.content, pattern: to_string(byte_size_count(b: desired.memory_high)))
    && string_contains(s: high.dropin_path as String, pattern: "40-fleet-high")
}

test fn witness_derived_swap_cap_is_the_declared_zero() -> Bool {
  let swap = cap_setting_member(s: derived_runner_memory_swap_cap_setting())
  string_contains(s: swap.dropin_path as String, pattern: "30-fleet-swap")
    && string_contains(s: swap.content, pattern: "MemorySwapMax=0")
    && byte_size_count(b: gunbc_runner_slot_desired().memory_swap_max) == 0
}

// The quoting these three witnesses pin is the SERIALIZER'S, not this module's: the cap
// content is a word handed to a bash grammar tree, so an apostrophe inside it is encoded by
// extdeps.posix.shell_command_language posix_single_quote. Under the former hand-joined
// spelling ("printf '%s' '" ++ content ++ "' > path") the same content closed the quoting
// early and the rest of the drop-in became shell words — so each RED below is a real
// discriminator against that spelling returning, not a restatement of the emitter.
data apostrophe_cap_content: String = "[Service]\nEnvironment=CAP='quoted'\n"

data apostrophe_cap_member: CapMember = CapMember {
  dropin_path: path20,
  content: apostrophe_cap_content,
}

test fn witness_cap_upsert_script_quotes_content_through_posix_authority() -> Bool {
  string_contains(
    s: cap_upsert_script(m: apostrophe_cap_member),
    pattern: posix_single_quote(spelling: apostrophe_cap_content),
  )
}

test fn witness_cap_upsert_script_does_not_emit_raw_apostrophe_content() -> Bool {
  !string_contains(
    s: cap_upsert_script(m: apostrophe_cap_member),
    pattern: concat("'", concat(apostrophe_cap_content, "'")),
  )
}

test fn witness_cap_upsert_script_carries_no_hand_spelled_printf_quoting() -> Bool {
  !string_contains(s: cap_upsert_script(m: apostrophe_cap_member), pattern: "printf '%s' '")
}

// ── SET-PROPERTY RESIDUE IS REMOVED BY NAME, NEVER BY REVERTING THE UNIT ─────────────────────────────
//
// `systemctl revert UNIT` removed every drop-in of the unit, and on 2026-10-30 that took srv1-02's role
// drop-in (gunbc.recurring_failure_mode a_residue_teardown_removes_every_dropin_of_the_unit_it_names). The
// removal that replaced it names one file per property per control directory.

data role_dropin_unit: NonEmptyStr = "actions-runner@srv1-02.service"
data memory_properties: List<NonEmptyStr> = ["MemoryMax" as NonEmptyStr, "MemoryHigh" as NonEmptyStr]

fn last_word(argv: List<String>) -> String {
  fold(argv, init: "", f: (acc, w) => w)
}

// POSITIVE CONTROL: exactly the four set-property files, each an unlink-if-present, nothing recursive.
test fn the_residue_removal_names_one_set_property_file_per_property_and_directory() -> Bool {
  let argvs = control_shadow_removal_argvs(unit: role_dropin_unit, properties: memory_properties)
  map(argvs, a => last_word(argv: a)) == [
    "/etc/systemd/system.control/actions-runner@srv1-02.service.d/50-MemoryMax.conf",
    "/etc/systemd/system.control/actions-runner@srv1-02.service.d/50-MemoryHigh.conf",
    "/run/systemd/system.control/actions-runner@srv1-02.service.d/50-MemoryMax.conf",
    "/run/systemd/system.control/actions-runner@srv1-02.service.d/50-MemoryHigh.conf",
  ]
    && all(argvs, a => count(a) == 3 && any(a, w => w == "-f") && !any(a, w => w == "-rf" || w == "-r" || w == "revert"))
}

// RED: nothing under the unit's own drop-in directory, where the role drop-in lives, and no directory.
// A teardown that reached /etc/systemd/system/<unit>.d -- what revert did -- names a path this refuses.
test fn the_residue_removal_never_reaches_the_units_own_dropins_or_a_directory() -> Bool {
  let paths = map(control_shadow_residue_paths(unit: role_dropin_unit, properties: memory_properties), p => p as String)
  !any(paths, p => starts_with(s: p, prefix: "/etc/systemd/system/"))
    && all(paths, p => ends_with(s: p, suffix: ".conf"))
    && control_shadow_residue_paths(unit: role_dropin_unit, properties: []) == []
}

// The residue properties are the settings' own property field, one per setting, and each member the
// converge writes is rendered from the same setting, so the residue list and the written drop-ins
// cannot disagree on which properties exist (review 89000: the earlier reading parsed the rendered
// content back and dropped a member it could not parse).
test fn the_runner_cap_properties_are_the_settings_properties() -> Bool {
  let settings = derived_runner_slot_cap_settings()
  let members = derived_runner_slot_cap_members()
  runner_slot_cap_properties() == ["MemoryMax" as NonEmptyStr, "MemoryHigh" as NonEmptyStr, "MemorySwapMax" as NonEmptyStr, "TasksMax" as NonEmptyStr]
    && count(runner_slot_cap_properties()) == count(members)
    && all(settings, c => any(members, m => (m.dropin_path as String) == (c.dropin_path as String)
         && m.content == cap_dropin_content(property: c.property, bytes_value: c.value)))
}

fn slice_caps() -> SliceControlCaps {
  SliceControlCaps { unit: "gunbc-approval-broker.slice" as NonEmptyStr, memory_max: byte_size(count: 2048), memory_high: byte_size(count: 1024) }
}

// THE SLICE SEQUENCE: its own properties' residue removed, one reload, then each property set. The
// sessions slice also clears and sets its CPU cap; no step is a revert.
test fn the_slice_sequence_removes_its_residue_reloads_then_sets() -> Bool {
  let uncapped = slice_control_converge_argvs_for_unit(u: UncappedSliceControl { caps: slice_caps() })
  let sessions = slice_control_converge_argvs_for_unit(u: SessionsSliceControl { caps: slice_caps(), cpu_quota: hardware_thread_count(count: 4) })
  count(uncapped) == 7
    && map(filter(uncapped, a => any(a, w => w == "-f")), a => last_word(argv: a)) == map(control_shadow_residue_paths(unit: "gunbc-approval-broker.slice" as NonEmptyStr, properties: memory_properties), p => p as String)
    && all([0, 1, 2, 3], i => match get(xs: uncapped, index: i) { Present { value: a } => any(a, w => w == "-f")  Absent => false })
    && match get(xs: uncapped, index: 4) { Present { value: a } => a == ["systemctl", "daemon-reload"]  Absent => false }
    && all([5, 6], i => match get(xs: uncapped, index: i) { Present { value: a } => any(a, w => w == "set-property")  Absent => false })
    && count(sessions) == 10
    && any(sessions, a => last_word(argv: a) == "/run/systemd/system.control/gunbc-approval-broker.slice.d/50-CPUQuota.conf")
    && !any(concat(uncapped, sessions), a => any(a, w => w == "revert"))
}
