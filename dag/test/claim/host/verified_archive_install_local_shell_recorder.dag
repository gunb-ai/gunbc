module test.claim.host.verified_archive_install_local_shell_recorder

import std.types { String, List }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import extdeps.filesystem.filesystem_io { Filesystem }
import extdeps.exec.command { ArgvCommand, argv_words }
