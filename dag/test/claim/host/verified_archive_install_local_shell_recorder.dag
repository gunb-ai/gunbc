module test.claim.host.verified_archive_install_local_shell_recorder

import std.types { String, List }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import extdeps.exec.command { ArgvCommand, argv_words }
import gunbc.host.verified_archive_install {
  staged_archive_fetch_commands, staged_archive_install_commands,
  publish_staged_tree_command,
}
import gunbc.runner.runner_qemu_toolchain { qemu_toolchain_staged_archive }
import extdeps.virtualization.qemu { qemu_8_2_2_ubuntu_noble_arm64 }
import gunbc.runner.runner_browser_toolchain { node_release_archive, runner_browser_toolchain_node }
import gunbc.runner.runner_microvm_host_ready {
  firecracker_fetch_commands, firecracker_install_commands,
}
import extdeps.virtualization.firecracker { firecracker_release_aarch64 }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn argv_record_line(command: ArgvCommand) -> String {
  join(argv_words(command: command), "\n  | ")
}

fn argv_list_record(commands: List<ArgvCommand>) -> String {
  join(map(commands, c => argv_record_line(command: c)), "\n")
}

fn local_shell_legs_record_text() -> String {
  let qemu_a = qemu_toolchain_staged_archive(a: qemu_8_2_2_ubuntu_noble_arm64.archive)
  let node = node_release_archive(n: runner_browser_toolchain_node)
  join(
    [
      "qemu-fetch\n",
      argv_list_record(commands: staged_archive_fetch_commands(archives_dir: "/b/archives", a: qemu_a)),
      "\nqemu-install\n",
      argv_list_record(commands: staged_archive_install_commands(archives_dir: "/b/archives", tree: "/b/staging.X", a: qemu_a)),
      "\nqemu-publish\n",
      argv_record_line(command: publish_staged_tree_command(staging: "/b/staging.X", root: "/b/root")),
      "\nbrowser-node-fetch\n",
      argv_list_record(commands: staged_archive_fetch_commands(archives_dir: "/b/archives", a: node)),
      "\nbrowser-node-install\n",
      argv_list_record(commands: staged_archive_install_commands(archives_dir: "/b/archives", tree: "/b/staging.X", a: node)),
      "\nbrowser-publish\n",
      argv_record_line(command: publish_staged_tree_command(staging: "/b/staging.X", root: "/b/root")),
      "\nfirecracker-fetch\n",
      argv_list_record(commands: firecracker_fetch_commands(root: "/r", rel: firecracker_release_aarch64, scratch: "/r/scratch")),
      "\nfirecracker-install\n",
      argv_list_record(commands: firecracker_install_commands(root: "/r", rel: firecracker_release_aarch64, scratch: "/r/scratch")),
      "\n",
    ],
    "",
  )
}
