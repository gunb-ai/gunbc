test fn w_mtjade1_has_no_record_and_is_not_managed() -> Bool {
  match managed_host_binding_for(host: "mtjade1" as NonEmptyStr) {
    ManagedHostNotManaged { host: h } => (h as String) == "mtjade1" && count(managed_hosts()) == 1
    ManagedHostFound { control: _ } => false
    ManagedHostFoundUnderDeclaredDrop { control: _, drop: _, standing_subject: _, current_subject: _ } => false
  }
}

fn drop_with_identity_and_population(identity: NonEmptyStr, population: List<String>) -> RungDrop {
  let base = mtcollins1_bmc_secure_standing_predates_reflash
  match base.declaration {
    AuthoredProse { legacy: _, authored: _ } => base
    TypedDeclaration { previous: p, temporary: t, reason: r, population: _, restoration_trigger: rt } =>
      RungDrop {
        identity: identity,
        subject: base.subject,
        declared: base.declared,
        standing: Standing,
        declaration: TypedDeclaration {
          previous: p,
          temporary: t,
          reason: r,
          population: population,
          restoration_trigger: rt,
        },
      }
  }
}

fn drop_with_standing(standing: RungDropStanding) -> RungDrop {
  let base = mtcollins1_bmc_secure_standing_predates_reflash
  RungDrop {
    identity: base.identity,
    subject: base.subject,
    declared: base.declared,
    standing: standing,
    declaration: base.declaration,
  }
}

// A DECLARED DROP QUALIFIES ONLY WHILE IT STANDS, and the check is now a read of the record's own
// value -- no roster, no citation. Superseded is the honest shape of the 2026-10-04 ruling (its
// trigger never fired); Retired would CLAIM the trigger fired. Neither may default to membership.
test fn w_a_superseded_covering_drop_is_absent() -> Bool {
  match mtcollins1_managed_host_admission() {
    Absent => false
    Present { value: r } =>
      match managed_host_admission(
        host: r.host,
        subject: r.subject,
        access: r.access,
        secure: r.secure,
        hold: r.hold,
        smpro: r.smpro,
        receipt: r.receipt,
        current_subject: r.current_subject,
        covering_drop: Present {
          value: drop_with_standing(standing: Superseded {
            ruling: "test: a ruling that ended the row without its trigger firing" as NonEmptyStr,
            decision_record: "test.claim.host.managed_host_admission_witness" as NonEmptyStr,
            loss_holder: mtcollins1_bmc_secure_standing_predates_reflash.identity,
          }),
        },
      ) {
        superseded =>
          match project_managed_host_admission(
            record: superseded,
            current_subject: mtcollins1_current_intake_subject(),
            allocations: gunbc_fleet_hostname_allocations,
          ) {
            Absent => true
            Present { value: _ } => false
          }
      }
  }
}

test fn w_a_retired_covering_drop_is_absent() -> Bool {
  match mtcollins1_managed_host_admission() {
    Absent => false
    Present { value: r } =>
      match managed_host_admission(
        host: r.host,
        subject: r.subject,
        access: r.access,
        secure: r.secure,
        hold: r.hold,
        smpro: r.smpro,
        receipt: r.receipt,
        current_subject: r.current_subject,
        covering_drop: Present {
          value: drop_with_standing(standing: Retired {
            trigger_fired: "test: trigger fired after the standing was read" as NonEmptyStr,
          }),
        },
      ) {
        retired =>
          match project_managed_host_admission(
            record: retired,
            current_subject: mtcollins1_current_intake_subject(),
            allocations: gunbc_fleet_hostname_allocations,
          ) {
            Absent => true
            Present { value: _ } => false
          }
      }
  }
}

test fn w_a_matching_drop_whose_population_does_not_name_the_host_still_admits_mtcollins1() -> Bool {
  match mtcollins1_managed_host_admission() {
    Absent => false
    Present { value: r } =>
      match managed_host_admission(
        host: r.host,
        subject: r.subject,
        access: r.access,
        secure: r.secure,
        hold: r.hold,
        smpro: r.smpro,
        receipt: r.receipt,
        current_subject: r.current_subject,
        covering_drop: Present {
          value: drop_with_identity_and_population(
            identity: mtcollins1_bmc_secure_standing_predates_reflash.identity,
            population: ["unrelated bounded population with no unit name"],
          ),
        },
      ) {
        covered =>
          match project_managed_host_admission(
            record: covered,
            current_subject: mtcollins1_current_intake_subject(),
            allocations: gunbc_fleet_hostname_allocations,
          ) {
            Absent => false
            Present { value: m } => match m {
              OrdinaryMember { host: _ } => false
              MemberUnderDeclaredDrop { drop: d, standing_subject: _, current_subject: _, host: h } =>
                (d.identity as String) == (mtcollins1_bmc_secure_standing_predates_reflash.identity as String)
                  && (h.host as String) == (operator_host_mtcollins1 as String)
            }
          }
      }
  }
}
