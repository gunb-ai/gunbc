  ManagedHostFoundUnderDeclaredDrop,
}
import gunbc.machine_intake.mtcollins1_managed_host_admission { mtcollins1_current_intake_subject }
import gunbc.host.host_reset_subject_roster {
  ResetRosterHostUnderDeclaredDrop, OrdinaryResetRosterHost, reset_subject_roster, reset_subject_roster_of,
}
import gunbc.auth.managed_host_boot_federation {
  boot_federation_for, BootFederationProvisioned, BootFederationProvisionedUnderDeclaredDrop, BootFederationUnprovisioned,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn w_mtcollins1_membership_is_under_the_declared_drop() -> Bool {
  let rows = managed_host_memberships()
  count(rows) == 1
    && rows |> all(m => match m {
      OrdinaryMember { host: _ } => false
      MemberUnderDeclaredDrop { drop: d, standing_subject: standing, current_subject: current, host: h } =>
        (d.identity as String) == (mtcollins1_bmc_secure_standing_predates_reflash.identity as String)
          && (h.host as String) == (operator_host_mtcollins1 as String)
          && (standing.subject.unit_key as NonEmptyStr) == (current.subject.unit_key as NonEmptyStr)
          && content_hash_equal(left: standing.subject.firmware_manifest_digest, right: current.subject.firmware_manifest_digest) == false
    })
    && count(managed_hosts()) == 1
}

test fn w_reset_roster_and_boot_federation_match_the_declared_drop_arm() -> Bool {
  match managed_membership_for(host: operator_host_mtcollins1) {
    Absent => false
    Present { value: m } =>
      match m {
        OrdinaryMember { host: _ } => false
        MemberUnderDeclaredDrop { drop: d, standing_subject: _, current_subject: _, host: h } =>
          (d.identity as String) == (mtcollins1_bmc_secure_standing_predates_reflash.identity as String)
            && (h.host as String) == (operator_host_mtcollins1 as String)
            && count(reset_subject_roster()) == 1
            && reset_subject_roster() |> all(e => match e {
              OrdinaryResetRosterHost { host: _ } => false
              ResetRosterHostUnderDeclaredDrop { host: rh, drop: rd } =>
                (rh as String) == (operator_host_mtcollins1 as String)
                  && (rd.identity as String) == (d.identity as String)
            })
            && match boot_federation_for(host: h.host) {
              BootFederationProvisioned { federation: _ } => false
              BootFederationProvisionedUnderDeclaredDrop { federation: _, drop: fd, standing_subject: _, current_subject: _ } =>
                (fd.identity as String) == (d.identity as String)
              BootFederationUnprovisioned { host: _, cause: _ } => false
            }
      }
  }
}

test fn w_a_record_whose_subject_is_current_is_an_ordinary_member() -> Bool {
  match mtcollins1_managed_host_admission() {
    Absent => false
    Present { value: r } =>
      match project_managed_host_admission(
        record: r,
        current_subject: Present { value: r.subject },
        allocations: gunbc_fleet_hostname_allocations,
      ) {
        Absent => false
        Present { value: m } => match m {
          OrdinaryMember { host: h } => (h.host as String) == (operator_host_mtcollins1 as String)
          MemberUnderDeclaredDrop { drop: _, standing_subject: _, current_subject: _, host: _ } => false
        }
      }
  }
}

// A STALE SUBJECT UNDER NO DECLARED DROP REFUSES: covering is the record's own fact, so minting
// the same facts without the drop leaves the stale-subject arm with nothing to stand on.
test fn w_a_superseded_subject_with_no_declared_drop_is_absent() -> Bool {
  match mtcollins1_managed_host_admission() {
    Absent => false
    Present { value: r } =>
      match managed_host_admission(
        host: r.host,
        subject: r.subject,
        access: r.access,
        secure: r.secure,
        hold: r.hold,
        smpro: r.smpro,
        receipt: r.receipt,
        current_subject: r.current_subject,
        covering_drop: Absent,
      ) {
        without =>
          match project_managed_host_admission(
            record: without,
            current_subject: mtcollins1_current_intake_subject(),
            allocations: gunbc_fleet_hostname_allocations,
          ) {
            Absent => true
            Present { value: _ } => false
          }
      }
  }
}

test fn w_without_the_drop_mtcollins1_is_absent_and_reset_roster_empties() -> Bool {
  match mtcollins1_managed_host_admission() {
    Absent => false
    Present { value: r } =>
      match managed_host_admission(
        host: r.host,
        subject: r.subject,
        access: r.access,
        secure: r.secure,
        hold: r.hold,
        smpro: r.smpro,
        receipt: r.receipt,
        current_subject: r.current_subject,
        covering_drop: Absent,
      ) {
        without => {
          let hosts = managed_hosts_projected(
            records: [without],
            allocations: gunbc_fleet_hostname_allocations,
          )
          count(hosts) == 0 && count(reset_subject_roster_of(hosts: hosts)) == 0
        }
      }
  }
}

