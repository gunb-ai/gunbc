              temporary: Mitigatable,
              reason: DeletedWithoutReplacement,
              population_at_retirement: population_from_list(xs: ["test.population"]),
              restoration_trigger: "test restoration trigger",
            },
          }),
        },
      ) {
        retired =>
          match project_managed_host_admission(
            record: retired,
            current_subject: mtcollins1_current_intake_subject(),
            allocations: gunbc_fleet_hostname_allocations,
          ) {
            Absent => true
            Present { value: _ } => false
          }
      }
  }
}

// ADMISSION PERMITS A PLATFORM THAT DOES NOT CARRY SMpro (the manager's HOLD ruling, seam side).
// The x86 specimen is snappy's SUPPLIED WITNESS INPUT (his managed_host_witness owns the fixture and
// the row-side claim); the family here wraps the SAME cited catalog row (extdeps.cpu.amd
// .ryzen_9_7950x3d_catalog -- the corpus's real x86 silicon, DESIGN 5: the row carries the identity).
// Minting the whole mtcollins1 record with smpro := NotCarried must ADMIT, and the projection must
// still bind the member: standings_bound_to_record_subject now holds access==secure and compares an
// SMpro endpoint ONLY when the platform carries a site -- requiring one is what once forced an x86
// host to fabricate an Ampere site to be managed at all.
test fn w_admission_permits_a_platform_that_does_not_carry_smpro() -> Bool {
  let amd_7950x3d = SoCFamily {
    name: "Ryzen 9 7950X3D",
    models: [ryzen_9_7950x3d_catalog],
  }
  match mtcollins1_managed_host_admission() {
    Absent => false
    Present { value: r } =>
      match managed_host_admission(
        host: r.host,
        binding: r.binding,
        access: r.access,
        secure: r.secure,
        smpro: SmproPlatformNotCarried { family: amd_7950x3d },
        receipt: r.receipt,
        current_subject: r.current_subject,
        covering_drop: r.covering_drop,
      ) {
        notcarried =>
          match project_managed_host_admission(
            record: notcarried,
            current_subject: Present { value: r.binding.subject },
            allocations: gunbc_fleet_hostname_allocations,
          ) {
            Absent => false
            Present { value: m } => match m {
              OrdinaryMember { host: h } => (h.host as String) == (operator_host_mtcollins1 as String)
              MemberUnderDeclaredDrop { drop: _, standing_subject: _, current_subject: _, host: _ } => false
            }
          }
      }
  }
}

// A Dissolved row is the only form of a loss whose members no longer exist: it carries a
// RemovalTombstone and no population field. The helper mints one from the record's own cited value.
fn drop_dissolved_population_deleted() -> RungDrop {
  let base = mtcollins1_bmc_secure_standing_predates_reflash
  RungDrop {
    identity: base.identity,
    subject: base.subject,
    declared: base.declared,
    standing: Dissolved {
      removal: RemovalTombstone {
        removed_modules: FreeSemigroup { head: ModuleIdentity { name: "test.claim.host.removed_module" }, tail: [] },
        removed_at: "fa44b9810259b88f721e55ae0a3bd3cf7bc9b46f" as CommitSha,
        ruling: "test: a ruling declaring the rung's modules removed" as NonEmptyStr,
        decision_record: "test.claim.host.managed_host_admission_witness" as NonEmptyStr,
      },
      declaration: EndedTypedDeclaration {
        previous: MechanicallyPreventable,
        temporary: Mitigatable,
        reason: DeletedWithoutReplacement,
        restoration_trigger: "test restoration trigger",
      },
    },
  }
}

// A DISSOLUTION erases the drop from live accounting, so it can no longer qualify a subject: the declared-drop
// arm is gone and the stale-subject host drops out of the projection entirely.
test fn w_an_admissibly_dissolved_covering_drop_is_absent() -> Bool {
  match mtcollins1_managed_host_admission() {
    Absent => false
    Present { value: r } =>
      match managed_host_admission(
        host: r.host,
        binding: r.binding,
        access: r.access,
        secure: r.secure,
        smpro: r.smpro,
        receipt: r.receipt,
        current_subject: r.current_subject,
        covering_drop: Present {
          value: drop_dissolved_population_deleted(),
        },
      ) {
        dissolved =>
          match project_managed_host_admission(
            record: dissolved,
            current_subject: mtcollins1_current_intake_subject(),
            allocations: gunbc_fleet_hostname_allocations,
          ) {
            Absent => true
            Present { value: _ } => false
          }
      }
  }
}

test fn w_a_matching_drop_whose_population_does_not_name_the_host_still_admits_mtcollins1() -> Bool {
  match mtcollins1_managed_host_admission() {
    Absent => false
    Present { value: r } =>
      match managed_host_admission(
        host: r.host,
        binding: r.binding,
        access: r.access,
        secure: r.secure,
        smpro: r.smpro,
        receipt: r.receipt,
        current_subject: r.current_subject,
        covering_drop: Present {
          value: drop_with_identity_and_population(
            identity: mtcollins1_bmc_secure_standing_predates_reflash.identity,
            population: ["unrelated bounded population with no unit name"],
          ),
        },
      ) {
        covered =>
          match project_managed_host_admission(
            record: covered,
            current_subject: mtcollins1_current_intake_subject(),
            allocations: gunbc_fleet_hostname_allocations,
          ) {
            Absent => false
            Present { value: m } => match m {
              OrdinaryMember { host: _ } => false
              MemberUnderDeclaredDrop { drop: d, standing_subject: _, current_subject: _, host: h } =>
                (d.identity as String) == (mtcollins1_bmc_secure_standing_predates_reflash.identity as String)
                  && (h.host as String) == (operator_host_mtcollins1 as String)
            }
          }
      }
  }
}
