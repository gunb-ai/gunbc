module test.claim.host.pxe_boot_delivery_witness

import std.algebra { string_contains }
import std.types { Bool, NonEmptyStr, String }
import std.optional { Present, Absent }
import std.content_hash { ContentHash, content_hash_of_value }
import extdeps.bmc.ipmi_boot_selection { IpmiBootSelection, uefi_once_boot_selection, IpmiBootPxe }
import gunbc.host.megarac_managed_host { megarac_operation_evidence }
import gunbc.host.managed_host { managed_hosts }
import gunbc.host.managed_host_boot { admit_pxe_boot_subject, admit_boot_subject, BootSubjectAdmitted, BootSubjectRefused, AdmittedBootSubject }
import gunbc.machine_intake.mtcollins1_census_image { mtcollins1_census_boot_medium }
import gunbc.fleet.site_pxe_edge_live_boot_pair { SitePxeEdgeLiveExtraction, SitePxeEdgeLiveBootFile }
import gunbc.fleet.site_pxe_edge_live_evidence { site_pxe_edge_live_hash_of_hex }
import gunbc.network_boot_delivery { NetworkBootDeliveryUnestablished, NetworkBootDeliveryEvidenceRefused, NetworkBootClientBootMode, NetworkBootServingInfrastructure }
import test.fixture.boot_delivery_plans { established_network_boot_for, network_target }
import gunbc.host.pxe_boot_delivery {
  pxe_medium_edge_binding, pxe_medium_binding_refusal, PxeMediumBound, PxeMediumNotNetworkArm, PxeMediumDigestDiffersFromEdge,
  PxePowerOn, PxeNotPoweredOn, PxePoweredOn,
  pxe_delivery_run_record, PxeDeliveryEstablishedInRun, PxeDeliveryNotObservableBeforePowerOn, PxeDeliveryNoOfferObserved, PxeDeliveryEndedUnestablished,
  pxe_run_outcome, PxeRunDeliveryHeld, PxeRunEndedTyped,
}

data revision: NonEmptyStr = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

fn pxe_subject() -> AdmittedBootSubject? {
  match managed_hosts() |> first() {
    Absent => none
    Present { value: h } =>
      match admit_pxe_boot_subject(evidence: megarac_operation_evidence(), host: h, medium: mtcollins1_census_boot_medium, execution_revision: revision) {
        BootSubjectRefused { host: _, cause: _ } => none
        BootSubjectAdmitted { subject: s } => Present { value: s }
      }
  }
}

fn media_subject() -> AdmittedBootSubject? {
  match managed_hosts() |> first() {
    Absent => none
    Present { value: h } =>
      match admit_boot_subject(evidence: megarac_operation_evidence(), host: h, medium: mtcollins1_census_boot_medium, execution_revision: revision) {
        BootSubjectRefused { host: _, cause: _ } => none
        BootSubjectAdmitted { subject: s } => Present { value: s }
      }
  }
}

fn extraction_of(iso: ContentHash) -> SitePxeEdgeLiveExtraction {
  let f = SitePxeEdgeLiveBootFile { digest: content_hash_of_value(value: "member") }
  SitePxeEdgeLiveExtraction { iso_digest: iso, kernel: f, initrd: f }
}

// CONDITION 1. The edge's image digest equal to the medium's digest binds; another digest is a typed refusal (and the text names it); the removable-media arm
// has no edge. RED: with the comparison inverted the matching arm refuses, and with it dropped the differing arm binds.
test fn the_pxe_medium_binds_only_to_the_image_the_edge_extracted() -> Bool {
  match pxe_subject() {
    Absent => false
    Present { value: s } =>
      match site_pxe_edge_live_hash_of_hex(hex: s.medium.digest) {
        Absent => false
        Present { value: own } => {
          let bound = match pxe_medium_edge_binding(subject: s, extraction: extraction_of(iso: own)) { PxeMediumBound { image: _ } => true  _ => false }
          let other = extraction_of(iso: content_hash_of_value(value: "another image"))
          let differs = match pxe_medium_edge_binding(subject: s, extraction: other) { PxeMediumDigestDiffersFromEdge { medium: _, served: _ } => true  _ => false }
          let refusal_named = match pxe_medium_binding_refusal(binding: pxe_medium_edge_binding(subject: s, extraction: other)) { Present { value: _ } => true  Absent => false }
          let held_has_no_refusal = match pxe_medium_binding_refusal(binding: pxe_medium_edge_binding(subject: s, extraction: extraction_of(iso: own))) { Present { value: _ } => false  Absent => true }
          let media = match media_subject() {
            Absent => false
            Present { value: m } => match pxe_medium_edge_binding(subject: m, extraction: extraction_of(iso: own)) { PxeMediumNotNetworkArm => true  _ => false }
          }
          bound && differs && refusal_named && held_has_no_refusal && media
        }
      }
  }
}

fn powered() -> PxePowerOn {
  PxePoweredOn { selection: uefi_once_boot_selection(device: IpmiBootPxe) }
}

// CONDITION 2. An established delivery is carried into the record only from a powered-on run; before power-on the same standing is not observable.
// CONDITION 3. A standing missing the client's offer ends the run typed as no-offer, any other unestablished standing ends typed, and neither is a held delivery.
test fn a_pxe_run_holds_delivery_only_when_established_after_power_on_and_every_other_end_is_typed() -> Bool {
  let established = established_network_boot_for(t: network_target, digest: content_hash_of_value(value: "root"))
  let held = match pxe_run_outcome(record: pxe_delivery_run_record(power_on: powered(), standing: established)) { PxeRunDeliveryHeld { evidence: _ } => true  PxeRunEndedTyped { reason: _ } => false }
  let record_established = match pxe_delivery_run_record(power_on: powered(), standing: established) { PxeDeliveryEstablishedInRun { evidence: _ } => true  _ => false }
  let early = pxe_delivery_run_record(power_on: PxeNotPoweredOn { reason: "not yet" as NonEmptyStr }, standing: established)
  let early_typed = match early { PxeDeliveryNotObservableBeforePowerOn { reason: _ } => true  _ => false }
  let early_ends = match pxe_run_outcome(record: early) { PxeRunEndedTyped { reason: _ } => true  PxeRunDeliveryHeld { evidence: _ } => false }
  let no_offer_standing = NetworkBootDeliveryUnestablished { missing: [NetworkBootServingInfrastructure, NetworkBootClientBootMode] }
  let no_offer = match pxe_delivery_run_record(power_on: powered(), standing: no_offer_standing) { PxeDeliveryNoOfferObserved { missing: _ } => true  _ => false }
  let no_offer_ends = match pxe_run_outcome(record: pxe_delivery_run_record(power_on: powered(), standing: no_offer_standing)) { PxeRunEndedTyped { reason: r } => string_contains(s: r, pattern: "no DHCP/PXE offer")  PxeRunDeliveryHeld { evidence: _ } => false }
  let other = match pxe_delivery_run_record(power_on: powered(), standing: NetworkBootDeliveryUnestablished { missing: [NetworkBootServingInfrastructure] }) { PxeDeliveryEndedUnestablished { standing: _ } => true  _ => false }
  held && record_established && early_typed && early_ends && no_offer && no_offer_ends && other
}
