module test.claim.host_budget_source_witness

import std.logic { Bool }
import std.types { String, List }
import std.measure { byte_size, byte_size_count }
import std.os.types { KernelFamily, Linux, Darwin, WindowsNt, LinuxGuestOnWindows }
import extdeps.linux.cgroup_v2 { kernel_provides_cgroup_v2 }
import extdeps.linux.procfs {
  ProcfsPath,
  ProcMeminfo,
  ProcSelfStatus,
  ProcSelfCgroup,
  ProcSwaps,
  ProcfsAvailable,
  ProcfsAbsentOnKernel,
  kernel_provides_procfs,
  procfs_availability,
  procfs_availability_is_available,
  procfs_paths_read_by_this_repository,
  procfs_path_literal,
}
import gunbc.host_budget_source {
  HostBudgetSource,
  BudgetSourceCgroupMemoryHigh,
  BudgetSourceCgroupMemoryMax,
  BudgetSourceDarwinPhysicalMemory,
  HostBudgetResolution,
  HostBudgetResolved,
  HostBudgetObserved,
  HostBudgetDeclaredUnverified,
  HostBudgetUnreadable,
  KernelBudgetSourcing,
  SourcedStatically,
  SourcedAtRuntimeOrRefused,
  UnmodeledPlatform,
  host_budget_source_is_degraded,
  host_budget_source_reads_procfs,
  host_budget_source_bounds_this_process,
  host_budget_source_admissible_on_kernel,
  host_budget_source_admissible_as_bound_on_kernel,
  kernel_budget_sourcing,
  kernel_budget_sourcing_static_source,
  host_budget_resolution_bytes,
  host_budget_unreadable_on_kernel,
  host_budget_source_label,
  effective_planning_budget,
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// These rows are about the RELATION between a kernel family and a budget source, not about the machine running them, so they are SubstrateInputsOnly and give the same verdict on every platform. That is deliberate and is the point: the defect being walled is a claim the code makes about a platform, and a check that could only run on the affected platform would be untestable from the fleet's own Linux CI — which is how the fabricated label survived in the first place.
data all_kernels: List<KernelFamily> = [Linux, Darwin, WindowsNt, LinuxGuestOnWindows]

// WHY THESE CALLS SAY string_contains RATHER THAN contains, and it is a receipt rather than a style
// choice. Deriving the declared_high expectation from its authority row required importing
// gunbc.runner_slot_allocation into this module. v1-seed fn names are NOT module-scoped, so
// widening the import closure pulled v2.std.algebra into it, and that module's contains(xs, item,
// eq) over FreeMonoid captured the bare name these lines were using for the STRING
// contains(haystack, needle). Four calls on lines unrelated to the change refused with 'no
// parameter named haystack', and the floor fold aborted during preparation -- so the whole
// 9782-witness roster failed to run over a two-line edit elsewhere in the file.
//
// THE COST SHAPE IS THE POINT: an import added for one declaration silently re-resolved a bare name
// used by different declarations in the same module, and nothing local to those lines changed.
// string_contains is the unambiguous builtin and does not collide, so the calls are pinned to it.
// The gunbc.runner_slot_allocation import that first widened the closure is gone with the arm it
// fed, and the pinning deliberately stays: the hazard is the import closure, not that one import,
// so unpinning would only re-arm it for whoever widens the closure next. The general hazard is the
// same one std.decl_ref decl_ref_constructor_authority_note records for duplicated constructors --
// unqualified seed names make an import closure a name-capture surface -- and it dissolves when v1
// name resolution is namespace-scoped rather than bare.

// THIS ROW USED TO RETYPE THE MIRROR VALUE IT WAS MEASURING, and the arm it measured is now
// deleted, so the receipt is kept without the row. Both call sites constructed
// BudgetSourceMemAvailableCappedAtDeclaredHigh with byte_size(13958643712) -- the seed constant's
// own number, copied into the expectation -- so the witness greened whichever way the mirror went
// and could not have caught the eleven-day drift it sat next to. A measurement copied from the tree
// under test is not an oracle (2026-08-01 ruling).
//
// The arm went away for a different reason than this note: capping a host-shared reading at one
// fleet's declared slot line was a substitution, not a bound (gunbc.host_budget_source
// host_budget_source_seed_mirror_disposition). The lesson survives the arm, which is why this row
// does — a fixture derived from the tree under test is inert whatever it is measuring.

data all_sources: List<HostBudgetSource> = [
  BudgetSourceCgroupMemoryHigh { cgroup_dir: "/sys/fs/cgroup/system.slice" },
  BudgetSourceCgroupMemoryMax { cgroup_dir: "/sys/fs/cgroup/system.slice" },
  BudgetSourceDarwinPhysicalMemory,
]

test fn procfs_provision_follows_the_kernel_not_the_name() -> Bool {
  kernel_provides_procfs(kernel: Linux)
    && kernel_provides_procfs(kernel: LinuxGuestOnWindows)
    && !kernel_provides_procfs(kernel: Darwin)
    && !kernel_provides_procfs(kernel: WindowsNt)
}

test fn procfs_availability_is_absent_for_every_path_on_darwin() -> Bool {
  all(
    procfs_paths_read_by_this_repository,
    p =>
      !procfs_availability_is_available(a: procfs_availability(kernel: Darwin, path: p))
        && procfs_availability_is_available(a: procfs_availability(kernel: Linux, path: p))
  )
}

test fn every_procfs_path_renders_an_absolute_proc_path() -> Bool {
  all(
    procfs_paths_read_by_this_repository,
    p => starts_with(s: procfs_path_literal(p: p) as String, prefix: "/proc/")
  )
}

// The degraded axis is asserted as a PARTITION of the arms rather than arm-by-arm, so adding a
// source cannot leave the question unanswered: degraded is asserted to be exactly the complement of
// host_budget_source_bounds_this_process over all_sources, so the two axes cannot drift apart and a
// new arm must answer both. A witness that listed only the degraded arms would still pass if a new
// arm defaulted to non-degraded, which is the direction that actually costs something — a
// host-shared signal silently trusted as a private limit is the 2026-07-21 srv3 exit-137 shape.

test fn degraded_is_exactly_the_non_observed_sources() -> Bool {
  !host_budget_source_is_degraded(s: BudgetSourceCgroupMemoryHigh { cgroup_dir: "/sys/fs/cgroup" })
    && !host_budget_source_is_degraded(s: BudgetSourceCgroupMemoryMax { cgroup_dir: "/sys/fs/cgroup" })
    && host_budget_source_is_degraded(s: BudgetSourceDarwinPhysicalMemory)
}

test fn memory_high_is_an_observed_throttle_not_an_enforced_cap() -> Bool {
  !host_budget_source_bounds_this_process(
      s: BudgetSourceCgroupMemoryHigh { cgroup_dir: "/sys/fs/cgroup" }
    )
    && host_budget_source_bounds_this_process(
      s: BudgetSourceCgroupMemoryMax { cgroup_dir: "/sys/fs/cgroup" }
    )
}

// THE DISCRIMINATING PAIR FOR THE 2026-08-30 BUILDBUDDY SIGKILL, and it is a pair for the same
// reason the platform-wall pair below is: either half alone is satisfied by a degenerate predicate.
// The RED asserts that on a kernel WITH a private-limit mechanism, no source that fails to bound
// this process may serve as the budget — the sentence the deleted MemAvailable arm violated on
// every Linux runner whose cgroup files it could not read. The control asserts those same sources
// stay admissible on the kernels that have no such mechanism, which is what keeps hw.memsize
// legitimate on a Mac; without it, a predicate that refused everything would pass the RED and leave
// macOS unable to name any budget at all.
//
// A note on what the RED can and cannot catch now. The three meminfo arms are DELETED, so today the
// only source with a false bounds_this_process is the Darwin one and this row's Linux arm is
// carried by it. That is deliberate rather than incidental: the deletion is the wall (no
// constructor, so no substitution is authorable), and this predicate is the wall for the NEXT arm
// someone adds — it goes red the moment a host-shared reading is reintroduced and pointed at Linux,
// which is exactly how the deleted arm entered.

test fn RED_a_non_bounding_source_is_inadmissible_where_a_private_limit_exists() -> Bool {
  all(
    all_sources,
    s =>
      if host_budget_source_bounds_this_process(s: s) {
        true
      } else {
        !host_budget_source_admissible_as_bound_on_kernel(s: s, kernel: Linux)
          && !host_budget_source_admissible_as_bound_on_kernel(s: s, kernel: LinuxGuestOnWindows)
      }
  )
}

test fn a_non_bounding_source_stays_admissible_where_no_private_limit_exists() -> Bool {
  all(
    all_sources,
    s =>
      host_budget_source_admissible_as_bound_on_kernel(s: s, kernel: Darwin)
        && host_budget_source_admissible_as_bound_on_kernel(s: s, kernel: WindowsNt)
  )
}

test fn cgroup_v2_provision_follows_the_kernel_not_the_name() -> Bool {
  kernel_provides_cgroup_v2(kernel: Linux)
    && kernel_provides_cgroup_v2(kernel: LinuxGuestOnWindows)
    && !kernel_provides_cgroup_v2(kernel: Darwin)
    && !kernel_provides_cgroup_v2(kernel: WindowsNt)
}

// THE ROW THAT WOULD HAVE CAUGHT THE OLD SHAPE. host_budget_source_for_kernel answered
// BudgetSourceMemTotal for Linux: a declaration-time promise that a Linux host always has a budget,
// redeemable only by reading the whole machine. This asserts the opposite — a kernel that CAN
// express a private limit makes no static promise, because whether it does express one is a runtime
// fact — and it is red for any future edit that hands a procfs kernel a static source again.
//
// Its control is the Darwin arm: a kernel with no private-limit mechanism MUST answer statically,
// because there is nothing to wait for and refusing a Mac outright would be an over-refusal rather
// than a wall. WindowsNt answers UnmodeledPlatform, which is a third state and must not be
// reachable by either of the other two.

test fn RED_a_kernel_with_a_private_limit_promises_no_static_source() -> Bool {
  all(
    all_kernels,
    k =>
      if kernel_provides_cgroup_v2(kernel: k) {
        match kernel_budget_sourcing_static_source(g: kernel_budget_sourcing(kernel: k)) {
          Present { value: _ } => false
          Absent => true
        }
      } else {
        true
      }
  )
}

test fn darwin_sources_statically_and_windows_is_unmodeled() -> Bool {
  match kernel_budget_sourcing(kernel: Darwin) {
    SourcedStatically { source: s } =>
      !host_budget_source_reads_procfs(s: s)
        && host_budget_source_is_degraded(s: s)
        && host_budget_source_admissible_as_bound_on_kernel(s: s, kernel: Darwin)
    SourcedAtRuntimeOrRefused => false
    UnmodeledPlatform => false
  }
    && match kernel_budget_sourcing(kernel: WindowsNt) {
      SourcedStatically { source: _ } => false
      SourcedAtRuntimeOrRefused => false
      UnmodeledPlatform => true
    }
}

// THE DISCRIMINATING PAIR, and it is the whole reason this file exists. The live defect is that
// read_host_budget_bytes reports BudgetSourceMemTotal on a Darwin host — a procfs-reading source
// named on a kernel that provides no procfs. The first witness asserts every procfs-reading arm is
// INADMISSIBLE on both non-procfs kernels; the second asserts those same arms stay admissible on
// both procfs kernels.
//
// One without the other proves nothing. Asserting only inadmissibility is satisfied by a predicate
// that refuses everything, which would make the governor unable to name a legitimate cgroup read on
// Linux; asserting only admissibility is satisfied by the predicate that returns true
// unconditionally, which is the behaviour today. Together they pin the boundary exactly at 'reads
// procfs AND kernel lacks procfs', which is the sentence the bug violates.

test fn RED_procfs_sources_are_inadmissible_on_kernels_without_procfs() -> Bool {
  all(
    all_sources,
    s =>
      if host_budget_source_reads_procfs(s: s) {
        !host_budget_source_admissible_on_kernel(s: s, kernel: Darwin)
          && !host_budget_source_admissible_on_kernel(s: s, kernel: WindowsNt)
      } else {
        true
      }
  )
}

test fn procfs_sources_stay_admissible_on_kernels_with_procfs() -> Bool {
  all(
    all_sources,
    s =>
      host_budget_source_admissible_on_kernel(s: s, kernel: Linux)
        && host_budget_source_admissible_on_kernel(s: s, kernel: LinuxGuestOnWindows)
  )
}

// A statically-selected source must be admissible on the very kernel it was selected for, which sounds tautological and is exactly the property the old code violated: it selected a procfs source for Darwin. Both admissibility walls are asserted — the procfs one and the bound one — because a source can satisfy either alone and still be wrong.
test fn each_kernel_selects_a_source_admissible_on_itself() -> Bool {
  all(
    all_kernels,
    k =>
      match kernel_budget_sourcing_static_source(g: kernel_budget_sourcing(kernel: k)) {
        Present { value: s } =>
          host_budget_source_admissible_on_kernel(s: s, kernel: k)
            && host_budget_source_admissible_as_bound_on_kernel(s: s, kernel: k)
        Absent => true
      }
  )
}

// THE REFUSAL WITNESS, and it is the one that pins the operator ruling rather than restating it.
// HostBudgetUnreadable must yield NO bytes — not a ceiling, not a floor, not a zero. Each of those
// is a number a consumer would happily admit against, and the ceiling in particular is what
// cli_run's unwrap_or produced and what OOM-killed this corpus twice on the developer's machine.
// Asserting the absence of a value is the only form of this claim that a permissive default cannot
// satisfy: a fallback that returned ANY number would red this row, which is precisely the
// discrimination the previous shape could not express.

test fn RED_unreadable_budget_yields_no_number_at_all() -> Bool {
  all(
    all_kernels,
    k =>
      match host_budget_resolution_bytes(r: host_budget_unreadable_on_kernel(kernel: k)) {
        Present { value: _ } => false
        Absent => true
      }
  )
}

test fn a_resolved_budget_does_yield_its_bytes() -> Bool {
  match host_budget_resolution_bytes(
    r: HostBudgetResolved {
      effective_bytes: byte_size(17179869184),
      requested_bytes: none,
      observation: HostBudgetObserved {
        source: BudgetSourceDarwinPhysicalMemory,
        bytes: byte_size(17179869184)
      }
    }
  ) {
    Present { value: b } => byte_size_count(b: b) == 17179869184
    Absent => false
  }
}

test fn an_unverified_declaration_remains_a_planning_number_without_becoming_resolved() -> Bool {
  match host_budget_resolution_bytes(
    r: HostBudgetDeclaredUnverified {
      requested_bytes: byte_size(5368709120),
      reason: "an environment assertion constrains no allocation"
    }
  ) {
    Present { value: b } => byte_size_count(b: b) == 5368709120
    Absent => false
  }
}

test fn RED_operator_request_cannot_widen_an_observed_limit() -> Bool {
  match effective_planning_budget(
    requested: Present { value: byte_size(10737418240) },
    observation: Present { value: HostBudgetObserved {
      source: BudgetSourceCgroupMemoryHigh { cgroup_dir: "/sys/fs/cgroup/runner.slice" },
      bytes: byte_size(8589934592)
    } }
  ) {
    HostBudgetResolved {
      effective_bytes: b,
      requested_bytes: Present { value: requested },
      observation: HostBudgetObserved { source: BudgetSourceCgroupMemoryHigh { cgroup_dir: _ }, bytes: observed }
    } => byte_size_count(b: b) == 8589934592
      && byte_size_count(b: requested) == 10737418240
      && byte_size_count(b: observed) == 8589934592
    HostBudgetResolved { effective_bytes: _, requested_bytes: _, observation: _ } => false
    HostBudgetDeclaredUnverified { requested_bytes: _, reason: _ } => false
    HostBudgetUnreadable { reason: _ } => false
  }
}

test fn operator_request_may_narrow_an_observed_limit() -> Bool {
  match effective_planning_budget(
    requested: Present { value: byte_size(5368709120) },
    observation: Present { value: HostBudgetObserved {
      source: BudgetSourceCgroupMemoryMax { cgroup_dir: "/sys/fs/cgroup/runner.slice" },
      bytes: byte_size(8589934592)
    } }
  ) {
    HostBudgetResolved {
      effective_bytes: b,
      requested_bytes: Present { value: requested },
      observation: HostBudgetObserved { source: BudgetSourceCgroupMemoryMax { cgroup_dir: _ }, bytes: observed }
    } => byte_size_count(b: b) == 5368709120
      && byte_size_count(b: requested) == 5368709120
      && byte_size_count(b: observed) == 8589934592
    HostBudgetResolved { effective_bytes: _, requested_bytes: _, observation: _ } => false
    HostBudgetDeclaredUnverified { requested_bytes: _, reason: _ } => false
    HostBudgetUnreadable { reason: _ } => false
  }
}

// The label is the surface a human actually reads, so the wall has to hold there too and not only
// on the discriminant. This asserts the unavailable arm's rendering never claims a /proc path — the
// exact text `/proc/meminfo MemTotal` is what ships today on a machine with no /proc, and a typed
// source whose label still said that would have fixed nothing a reader can see.

test fn no_selected_source_label_claims_a_path_its_kernel_lacks() -> Bool {
  all(
    all_kernels,
    k =>
      match kernel_budget_sourcing_static_source(g: kernel_budget_sourcing(kernel: k)) {
        Present { value: s } =>
          if string_contains(s: host_budget_source_label(s: s) as String, pattern: "/proc/") {
            kernel_provides_procfs(kernel: k)
          } else {
            true
          }
        Absent => true
      }
  )
}

test fn procfs_reading_labels_do_name_their_path() -> Bool {
  string_contains(s: host_budget_source_label(s: BudgetSourceCgroupMemoryHigh { cgroup_dir: "/sys/fs/cgroup/system.slice" }) as String, pattern: "memory.high")
    && string_contains(s: host_budget_source_label(s: BudgetSourceCgroupMemoryMax { cgroup_dir: "/sys/fs/cgroup/system.slice" }) as String, pattern: "memory.max")
}

// The refusal above proves the resolution carries no NUMBER; this proves it carries the two things
// a stopped operator needs, because a line-stop that does not say how to restart the line is a stop
// nobody can analyze (DESIGN section 5, the factory model). The reason must name what was
// unreadable — the cgroup limit files — and the env request that cannot replace them. On the
// BuildBuddy runner that motivated this change the executor must expose the missing observation;
// a plausible environment integer is exactly the unverified state this change refuses.

test fn the_unreadable_reason_names_both_the_missing_bound_and_the_remedy() -> Bool {
  all(
    all_kernels,
    k =>
      match host_budget_unreadable_on_kernel(kernel: k) {
        HostBudgetUnreadable { reason: r } =>
          string_contains(s: r as String, pattern: "memory.high")
            && string_contains(s: r as String, pattern: "memory.max")
            && string_contains(s: r as String, pattern: "GUNBC_MEMORY_BUDGET_BYTES")
        HostBudgetResolved { effective_bytes: _, requested_bytes: _, observation: _ } => false
        HostBudgetDeclaredUnverified { requested_bytes: _, reason: _ } => false
      }
  )
}
