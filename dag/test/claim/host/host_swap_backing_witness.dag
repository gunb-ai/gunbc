module test.claim.host.host_swap_backing_witness

import gunbc.host.host_phase_status { fleet_subsumption_hosts, observation_verdict_eq }
import gunbc.host.host_swap_backing {
  SwapBackingNotRequired,
  SwapBackingRequired,
  host_swap_backing_host_verdict,
  host_swap_backing_observation,
  host_swap_backing_observed_producer_scaffold,
  host_swap_backing_requirement,
  host_swap_backing_verdict,
  swap_cap_verdict_backing_blind_widen_sketch,
  swap_cap_verdict_gate_accepts,
  swap_cap_verdict_qualified_by_backing,
}
import gunbc.runner.runner_slot_desired { gunbc_runner_slot_desired }
import std.algebra { length }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.disposition { Scaffold, SingleAuthority }
import std.measure { ByteSize, byte_size, byte_size_count }
import std.optional { Absent, Present }
import std.types { Bool, Int, String }
import std.upsert_decision { Converged, Drifted, Inaccessible, UnknownRefused }
import extdeps.tools.free { SwapStats }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// The fold under test takes its requirement as a parameter, so the claim that exercises its four
// arms supplies the requirement AT THE INTERFACE rather than reading the live one. The live
// `memory_swap_max` is byte_size(0) since the 2026-11-04 envelope ruling
// (@ref(gunbc.runner.runner_slot_desired::gunbc_runner_slot_desired), operator: "no thrashing
// allowed", class gunbc.recurring_failure_mode swap_zero_read_as_a_thrash_refusal), so
// host_swap_backing_requirement() answers SwapBackingNotRequired and host_swap_backing_verdict
// then returns Converged for every input -- the four arms collapse and the fold is never
// exercised. host_swap_backing_requirement() takes no parameter (it reads the cap from the
// authority itself), so the requirement cannot be produced by pushing a nonzero cap through the
// real relation; it is constructed here instead.
//
// THIS IS A HYPOTHESIS AT THE INTERFACE, NOT AN AUTHORITY. The numbers below belong to no
// declaration: they are not the swap cap (which is byte_size(0)), and deliberately not the
// memory cap either -- a memory ceiling is not a swap requirement, and calling this
// `min_total: gunbc_runner_slot_memory_max` would borrow that fact's authority for a meaning it
// does not carry. What the claim tests is the fold's shape: given *something* required of at
// least HYPOTHESIS_MIN_TOTAL bytes, does the read separate into UnknownRefused / Absent /
// Drifted / Converged. The live requirement and its authority are the job of
// witness_requirement_is_derived_from_the_declared_cap, which is this claim's inhabitance pair.
data hypothesis_min_total: ByteSize = byte_size(4294967296)

fn required_backing_at_interface() -> SwapBackingRequirement {
  SwapBackingRequired {
    min_total: hypothesis_min_total,
    requiring_declaration: DeclarationRef {
      module_path: "gunbc.runner.runner_slot_desired",
      decl_name: "gunbc_runner_slot_desired",
      field: WholeDeclaration,
    },
  }
}


fn stats_fixture(total_bytes: Int) -> SwapStats {
  SwapStats {
    total: byte_size(total_bytes),
    used: byte_size(0),
    free: byte_size(total_bytes),
  }
}

// The requirement must come from the DECLARED cap, not from a number typed into this witness, or
// the module is asserting its own invention. So the assertion is a relationship: the derived
// min_total equals gunbc_runner_slot_desired().memory_swap_max exactly, which means editing that
// one declaration moves the requirement and this witness together, and a hand-written swap size
// anywhere would break it.

test fn witness_requirement_is_derived_from_the_declared_cap() -> Bool {
  // Not a pin on one world's number: the requirement must be the declared cap when the cap is
  // positive, and there must be no requirement exactly when it is not. Pinning the positive
  // case alone (which this claim did) made it a claim about the pre-ruling world -- it went red
  // when the envelope ruling set memory_swap_max to byte_size(0), and nothing in it said which
  // of the two had changed.
  let cap = byte_size_count(b: gunbc_runner_slot_desired().memory_swap_max)
  match host_swap_backing_requirement() {
    SwapBackingRequired { min_total: m, requiring_declaration: d } =>
      cap > 0
        && byte_size_count(b: m) == cap
        && d.module_path == "gunbc.runner.runner_slot_desired"
        && d.decl_name == "gunbc_runner_slot_desired"
    SwapBackingNotRequired => cap == 0
  }
}

// The four backing states must stay distinct, because each names a different piece of work: no producer (build one), zero total (provision backing), undersized total (resize), sufficient total (done). A fold that collapsed any pair would make one of those disappear from every count derived from it. Absent is asserted specifically against zero rather than against small, because zero is the state the whole module exists for — a cap over nothing.
test fn witness_backing_verdict_separates_unknown_absent_drifted_converged() -> Bool {
  let req = required_backing_at_interface()
  let cap_bytes = byte_size_count(b: hypothesis_min_total)
  let no_producer = host_swap_backing_verdict(req: req, observed: none)
  let zero_backing = host_swap_backing_verdict(
    req: req,
    observed: Present { value: stats_fixture(total_bytes: 0) },
  )
  let undersized = host_swap_backing_verdict(
    req: req,
    observed: Present { value: stats_fixture(total_bytes: 1073741824) },
  )
  let sufficient = host_swap_backing_verdict(
    req: req,
    observed: Present { value: stats_fixture(total_bytes: cap_bytes) },
  )
  observation_verdict_eq(a: no_producer, b: std.upsert_decision.UnknownRefused)
    && observation_verdict_eq(a: zero_backing, b: std.upsert_decision.Absent)
    && observation_verdict_eq(a: undersized, b: std.upsert_decision.Drifted)
    && observation_verdict_eq(a: sufficient, b: std.upsert_decision.Converged)
    // fail-closed on the hypothesis itself: the Drifted arm is only a Drifted arm because the
    // undersized sample (1 GiB) really is under the required minimum, and the sufficient sample
    // is the minimum exactly, which production's fold reads as clearing it (total < min is the
    // Drifted test). If the minimum were ever set at or below the undersized sample, the third
    // conjunct would be exercising the wrong arm and still read green.
    && cap_bytes > 1073741824
}

// THE conjunct the module exists for. A per-slot MemorySwapMax read that says Converged is the input on every line here; only the backing term varies. With backing observed Converged the cap verdict passes through unchanged — the non-vacuity control, without which a qualifier that refused everything would look correct. With backing zero, unobserved, or unreachable, the same green cap must NOT survive as Converged, and each case must keep its own arm rather than rounding to a single 'not converged': absent backing is provisioning work, unobserved backing is producer work, unreachable backing is the A1 reach lane.
test fn witness_green_cap_does_not_survive_missing_backing() -> Bool {
  let green_cap = std.upsert_decision.Converged
  let with_backing = swap_cap_verdict_qualified_by_backing(cap: green_cap, backing: std.upsert_decision.Converged)
  let no_backing = swap_cap_verdict_qualified_by_backing(
    cap: green_cap,
    backing: std.upsert_decision.Absent,
  )
  let unobserved = swap_cap_verdict_qualified_by_backing(cap: green_cap, backing: std.upsert_decision.UnknownRefused)
  let unreachable = swap_cap_verdict_qualified_by_backing(cap: green_cap, backing: std.upsert_decision.Inaccessible)
  observation_verdict_eq(a: with_backing, b: std.upsert_decision.Converged)
    && observation_verdict_eq(a: no_backing, b: std.upsert_decision.Absent)
    && observation_verdict_eq(a: unobserved, b: std.upsert_decision.UnknownRefused)
    && observation_verdict_eq(a: unreachable, b: std.upsert_decision.Inaccessible)
}

// The qualification is a presupposition check and not a meet over some verdict ordering, and this conjunct pins the asymmetry so a later refactor cannot quietly turn it into one. A DRIFTED cap under CONVERGED backing stays Drifted — the backing does not repair the cap — while a CONVERGED cap under DRIFTED backing becomes Drifted. Under a symmetric meet those two would be the same value by construction and the direction of the check would be lost.
test fn witness_qualification_direction_is_asymmetric() -> Bool {
  let drifted_cap_good_backing = swap_cap_verdict_qualified_by_backing(
    cap: std.upsert_decision.Drifted,
    backing: std.upsert_decision.Converged,
  )
  let good_cap_drifted_backing = swap_cap_verdict_qualified_by_backing(
    cap: std.upsert_decision.Converged,
    backing: std.upsert_decision.Drifted,
  )
  observation_verdict_eq(a: drifted_cap_good_backing, b: std.upsert_decision.Drifted)
    && observation_verdict_eq(a: good_cap_drifted_backing, b: std.upsert_decision.Drifted)
    && !observation_verdict_eq(
      a: swap_cap_verdict_qualified_by_backing(cap: std.upsert_decision.Inaccessible, backing: std.upsert_decision.Converged),
      b: std.upsert_decision.Converged,
    )
}

data witness_red_control_note: String = "The discriminating RED control, and its perturbation is the corpus's CURRENT behaviour rather than an invented one: reporting the cap verdict with no backing term at all. The gate rejects the sketch and accepts the authority on identical inputs. Both halves are required — rejection alone would pass for a gate that rejects everything, acceptance alone for a gate that accepts everything — and the gate's own decision is computed from the backing argument, not from which function produced the verdict, so it cannot be satisfied by relabelling."

test fn witness_red_control_backing_blind_rejected_by_gate() -> Bool {
  let backing = std.upsert_decision.UnknownRefused
  let widened = swap_cap_verdict_backing_blind_widen_sketch(cap: std.upsert_decision.Converged, backing: backing)
  let authority = swap_cap_verdict_qualified_by_backing(cap: std.upsert_decision.Converged, backing: backing)
  observation_verdict_eq(a: widened, b: std.upsert_decision.Converged)
    && !swap_cap_verdict_gate_accepts(verdict: widened, backing: backing)
    && swap_cap_verdict_gate_accepts(verdict: authority, backing: backing)
}

test fn witness_gate_admits_a_green_cap_when_backing_is_present() -> Bool {
  swap_cap_verdict_gate_accepts(verdict: std.upsert_decision.Converged, backing: std.upsert_decision.Converged)
}

// THE OBSERVATION FRONTIER IS A SET OF NAMED HOSTS, NOT A COUNT -- AND ITS PROSE HAD DRIFTED FROM
// ITS FOLD WITHOUT ANYTHING BEING ABLE TO NOTICE. The previous form asserted
// host_swap_backing_fleet_unobserved_count() == fleet_subsumption_hosts.length(), and the note beside
// it said "all four enrolled hosts derive UnknownRefused today". There are SIX enrolled rows: srv1
// through srv4 for CI, and srv5 and srv6, the two DGX Spark units. The FOLD was right and the NOTE
// was stale -- written when four hosts were enrolled and never updated when the Sparks were.
//
// THAT IS THE ARGUMENT FOR IDENTITY GRAIN AND IT DOES NOT DEPEND ON EITHER BEING WRONG. A count has
// no members, so a count and its own description cannot contradict each other detectably: no review,
// no execution and no lens can compare "four" in a sentence against a number that never says who it
// counted. A named set can be read against its own note at a glance. Prose drift beside a count is
// undetectable in principle rather than merely unchecked, which is a stronger claim than DESIGN's
// existing one that counts are weaker oracles, and it is why this converts even though nothing about
// the assertion was false.
//
// gunbc.design_argument::fail_closed is the rule: completeness is an identity join, not a count equality.
//
// WHAT THIS DOES NOT SAY, recorded because an earlier revision of this block said it and it was
// FALSE: srv5 and srv6 are not empty rack positions and were never being miscounted. Both DGX Spark
// units arrived and are live on the operator LAN with ARP-confirmed MACs and static reservations
// (gunbc.spark.dgx_procurement dgx_spark_arrival_standing derives arrival from the observed
// reservation rows), and they carry distinct measured SSH host keys
// (gunbc.host.host_reach_identity_probe). They are real hosts nobody has measured swap on yet, which is
// exactly what this witness should say about them. Their inventory chassis rows are named
// "placeholder" because a desktop appliance has no RACKMOUNT CHASSIS asset -- that is rack furniture
// modelling, not a claim that the machine is absent, and reading it as one is the inference this
// note exists to stop the next reader from repeating.
//
// THE ADVERSARY THE OLD NOTE NAMED IS STILL CAUGHT. Someone adding a fabricated per-host fixture to
// make the matrix look greener removes that host from this set and reds the witness, now with the
// host's name in the failure.
//
// THE UNIVERSE IS THE ENROLLED POPULATION, NOT A LIST TYPED HERE. Joining against a hand-authored
// roster would replace a count pinned to a population with a list pinned to nothing -- the same
// defect with more typing. fleet_subsumption_hosts is independently authored and closed, which is
// what DESIGN requires of the subject universe.
// Inhabitance, the other half of supplying an input at an interface: the observation the fold
// consumes is a REGISTERED scaffold, not an invention of this witness. It is a Scaffold (not a
// transport that swallows a success), it dissolves to SingleAuthority, and it is bound to the
// effect transport realization has to fill -- so when a real /proc/swaps reader lands, this goes
// red and the unobserved claim above has to be re-derived against it.
test fn witness_the_backing_observation_is_a_registered_scaffold() -> Bool {
  // Two halves, one fact: the swap-backing deficit is real and it is registered.
  //  - the read is a registered Scaffold (not a transport that could swallow a success), it
  //    dissolves to SingleAuthority, and it is bound to the effect transport realization has to
  //    fill -- so this is the module's own admission of a missing producer, not a witness saying
  //    "nobody looked";
  //  - and the producer really does return nothing for every enrolled host, which is the
  //    deficit as a number: the moment a /proc/swaps reader lands, `any read` stops being 0 and
  //    this goes red rather than letting the fold keep a fiction green.
  let any_read = filter(
    fleet_subsumption_hosts,
    h => match host_swap_backing_observation(host: h) {
      Absent => false
      Present { value: s } => true
    },
  )
  match host_swap_backing_observed_producer_scaffold {
    Scaffold { dissolves_to: SingleAuthority, bind: b } =>
      b.module_path == "gunbc.host.host_effect"
        && b.decl_name == "HostEffectTransport"
        && length(any_read) == 0
        && length(fleet_subsumption_hosts) > 0
    _ => false
  }
}

