module test.claim.host.initialized_host_witness

import std.types { Bool, String }
import std.optional { Present, Absent }
import std.algebra { string_contains }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import product.host_identity { host_identity_eq }
import gunbc.fleet.fleet_host_identity { operator_host_mtcollins1 }
import gunbc.fleet.fleet_ssh_locus { fleet_locus_ssh_target }
import gunbc.fleet.fleet_known_hosts_anchor { SshTargetResolved, SshTargetRefused }
import gunbc.fleet.fleet_host_key_enrollment { known_hosts_line }
import gunbc.host.host_effect { HostEffectTransport, FleetSsh }
import gunbc.host.host_operation_exec { HostOperationOutcome, HostOperationObserved }
import gunbc.host.anchored_host_transport {
  AnchoredHostBinding, AnchoredBindingRefused, anchored_host_transport_against, mtcollins1_anchored_host_row,
}
import gunbc.host.initialized_host {
  HostInitialized, HostNotInitialized, InitializedHostUntrusted, InitializedHostBootUnread,
  initialized_host_over, initialized_host_live, initialized_host_identity, initialized_host_reach, initialized_host_os,
}
import gunbc.machine_intake.mtcollins1_boot_run { mtcollins1_boot_medium }
import test.claim.host.anchored_host_transport_witness { anchored_fixture_row }
import test.claim.typed_remote_file_write_fleet_ssh_fixture { fleet_ssh_execution_context_hermetic_witness_fixture }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE INITIALIZED-HOST RECORD (gunbc.host.initialized_host) at its one interface. The binding and the boot-id read
// are supplied values, built from mtcollins1's REAL row, its REAL fleet transport route and its REAL boot medium;
// only the pinned key is a fixture, because mtcollins1's production pin is absent until boot 7 reads it back. The
// pin-absent RED runs the production route itself.

data boot_uuid: String = "0b7c2d4e-5f60-4a1b-9c2d-3e4f5a6b7c8d"

fn mtcollins1_fleet_transport() -> HostEffectTransport? {
  match fleet_ssh_execution_context_hermetic_witness_fixture() {
    Absent => none
    Present { value: ctx } =>
      match fleet_locus_ssh_target(host: operator_host_mtcollins1) {
        SshTargetRefused { endpoint: _, refusal: _ } => none
        SshTargetResolved { target: t } => Present { value: FleetSsh { target: t, context: ctx } }
      }
  }
}

// THE BINDING over mtcollins1's real row with the fixture pin; presented_matches presents the pin's own line, otherwise another key.
fn mtcollins1_binding(presented_matches: Bool) -> AnchoredHostBinding {
  let row = anchored_fixture_row()
  match row.anchor {
    Absent => AnchoredBindingRefused { cause: "the fixture row carries no pin" }
    Present { value: anchor } =>
      match mtcollins1_fleet_transport() {
        Absent => AnchoredBindingRefused { cause: "no hermetic fleet transport to mtcollins1" }
        Present { value: t } =>
          anchored_host_transport_against(
            row: row,
            anchor: anchor,
            transport: t,
            presented_key_line: if presented_matches { known_hosts_line(k: anchor) } else { "mtcollins1 ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAINOTTHEPINNOTTHEPINNOTTHEPINNOTTHEPIN0" },
          )
      }
  }
}

fn boot_read(stdout: String) -> HostOperationOutcome {
  HostOperationObserved { stdout: stdout, success: true, stderr: none }
}

// POSITIVE CONTROL, AND THE SHAPE THE mtcollins1 ROUTE PRODUCES: its real fleet transport bound against its real
// row, its real boot medium, and a kernel boot id read back. The record names mtcollins1, reaches it at the row's
// address, and carries the medium's digest and the boot id read -- each asserted against its producer, not only
// "constructed".
test fn an_authenticated_host_with_a_read_boot_is_initialized_with_the_route_s_own_facts() -> Bool {
  match initialized_host_over(binding: mtcollins1_binding(presented_matches: true), medium: mtcollins1_boot_medium, read: boot_read(stdout: concat(boot_uuid, "\n"))) {
    HostInitialized { host: h } =>
      host_identity_eq(a: initialized_host_identity(host: h), b: operator_host_mtcollins1)
        && initialized_host_reach(host: h) == mtcollins1_anchored_host_row.address
        && (initialized_host_os(host: h).image_digest as String) == (mtcollins1_boot_medium.digest as String)
        && (initialized_host_os(host: h).image_name as String) == (mtcollins1_boot_medium.image_name as String)
        && (initialized_host_os(host: h).boot.boot_id as String) == boot_uuid
    HostNotInitialized { refusal: _ } => false
  }
}

// RED, ON THE PRODUCTION ROUTE: mtcollins1's pin is absent on main, so the live route refuses at the anchored
// transport, contacting nothing, and no record exists. A host with no pin is never initialized.
test fn a_host_with_no_pinned_key_is_refused_before_any_effect() -> Bool {
  match initialized_host_live(host: operator_host_mtcollins1, attempt_raw: "witness", medium: mtcollins1_boot_medium) {
    HostNotInitialized { refusal: InitializedHostUntrusted { cause: c } } =>
      string_contains(s: c, pattern: "no trusted statement about mtcollins1") && string_contains(s: c, pattern: "nothing contacted")
    _ => false
  }
}

// RED: a key that is not the pin is not trust, whatever the boot read says.
test fn a_presented_key_that_is_not_the_pin_is_not_initialized() -> Bool {
  match initialized_host_over(binding: mtcollins1_binding(presented_matches: false), medium: mtcollins1_boot_medium, read: boot_read(stdout: boot_uuid)) {
    HostNotInitialized { refusal: InitializedHostUntrusted { cause: _ } } => true
    _ => false
  }
}

// RED: trusted, but the kernel did not answer with a boot id.
test fn a_trusted_host_whose_boot_id_is_unread_is_not_initialized() -> Bool {
  match initialized_host_over(binding: mtcollins1_binding(presented_matches: true), medium: mtcollins1_boot_medium, read: boot_read(stdout: "not-a-boot")) {
    HostNotInitialized { refusal: InitializedHostBootUnread { cause: c } } => string_contains(s: c, pattern: "not a uuid")
    _ => false
  }
}
