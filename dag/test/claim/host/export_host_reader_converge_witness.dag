module test.claim.host.export_host_reader_converge_witness

import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.types { Bool, Int, List, NonEmptyStr, String }
import std.algebra { string_contains }
import std.optional { Present, Absent }
import extdeps.ssh.openssh_server_commands { sshd_effective_config_value }
import std.measure { second }
import gunbc.typed_argv_exec { TypedArgvExecOutcome, TypedArgvExecOverran, TypedArgvExecWireInconsistent, typed_argv_exec_wire_inconsistent_reason }
import extdeps.ssh.session { SshSessionWireFault, OverrunWithoutDeadline }
import gunbc.host_command_binding { HostLeg, LegAnswered, LegNotDispatched, LegUnanswered, host_leg_of_typed_argv }
import gunbc.host.export_host_reader_converge {
  ExportHostReaderLegs, ExportHostReaderRun, ExportHostReaderOutcome,
  ReaderRowsConverged, ReaderRowsRefused, ReaderRowsRolledBack, ReaderRowsRollbackFailed, ReaderRowsReloadUncertain,
  export_host_reader_apply_with, render_export_host_reader_run, export_host_reader_drop_in, authorized_keys_file_value, authorized_keys_file_option,
  export_host_reader_keys_path, boot_medium_reader_login,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn ok(stdout: String) -> HostLeg { LegAnswered { exit_code: 0, stdout: stdout, stderr: "" } }
fn bad() -> HostLeg { LegAnswered { exit_code: 1, stdout: "", stderr: "refused" } }

data effective_ours: String = "port 22\nauthorizedkeysfile .ssh/authorized_keys .ssh/authorized_keys2 /etc/ssh/authorized_keys.%u\npasswordauthentication no\n"

// The elevated parent listing (`ls -1 -A`) COMPLETED (exit 0) and does NOT name the drop-in: genuinely absent.
fn absent() -> HostLeg { LegAnswered { exit_code: 0, stdout: "00-base.conf\n", stderr: "" } }
// The elevated parent listing COMPLETED (exit 0) and DOES name the drop-in by name: present. A DANGLING symlink
// is named too (ls does not follow it), so it counts present, never absent.
fn present() -> HostLeg { LegAnswered { exit_code: 0, stdout: "00-base.conf\n50-gunbc-boot-medium-reader.conf\n", stderr: "" } }
// A genuinely ANSWERED leg with an explicit exit (e.g. a real ssh 255), and a leg the transport NEVER dispatched.
fn answered(exit: Int, out: String, err: String) -> HostLeg { LegAnswered { exit_code: exit, stdout: out, stderr: err } }
fn never(reason: String) -> HostLeg { LegNotDispatched { reason: reason } }

data effective_without_ours: String = "port 22\nauthorizedkeysfile .ssh/authorized_keys .ssh/authorized_keys2\n"

// A HEALTHY HOST: every leg answers as it should, and a test names only the legs it varies. A Bool leg (a
// converging write) holds when its override exits 0.
type LegOverride {
  leg: String
  answer: HostLeg
}

fn answer(name: String, overrides: List<LegOverride>, healthy: HostLeg) -> HostLeg {
  fold(overrides, init: healthy, f: (acc, o) => if o.leg == name { o.answer } else { acc })
}

fn holds(name: String, overrides: List<LegOverride>) -> Bool {
  match answer(name: name, overrides: overrides, healthy: ok(stdout: "")) {
    LegNotDispatched { reason: _ } => false
    LegUnanswered { cause: _ } => false
    LegAnswered { exit_code: ec, stdout: _, stderr: _ } => ec == 0
  }
}

fn legs_with(overrides: List<LegOverride>) -> ExportHostReaderLegs {
  ExportHostReaderLegs {
    precheck: fn() { answer(name: "precheck", overrides: overrides, healthy: ok(stdout: "")) },
    account_exists: fn() { answer(name: "account_exists", overrides: overrides, healthy: ok(stdout: "998")) },
    ensure_account: fn() { answer(name: "ensure_account", overrides: overrides, healthy: ok(stdout: "")) },
    write_keys: fn() { holds(name: "write_keys", overrides: overrides) },
    write_drop_in: fn() { holds(name: "write_drop_in", overrides: overrides) },
    test_config: fn() { answer(name: "test_config", overrides: overrides, healthy: ok(stdout: "")) },
    effective_config: fn() { answer(name: "effective_config", overrides: overrides, healthy: ok(stdout: effective_ours)) },
    reload: fn() { answer(name: "reload", overrides: overrides, healthy: ok(stdout: "")) },
    fresh_login: fn() { answer(name: "fresh_login", overrides: overrides, healthy: ok(stdout: "")) },
    remove_drop_in: fn() { answer(name: "remove_drop_in", overrides: overrides, healthy: ok(stdout: "")) },
    drop_in_listing: fn() { answer(name: "drop_in_listing", overrides: overrides, healthy: absent()) },
    rollback_reload: fn() { answer(name: "rollback_reload", overrides: overrides, healthy: ok(stdout: "")) },
    rollback_fresh_login: fn() { answer(name: "rollback_fresh_login", overrides: overrides, healthy: ok(stdout: "")) },
    effective_config_after_removal: fn() { answer(name: "effective_config_after_removal", overrides: overrides, healthy: ok(stdout: effective_without_ours)) },
  }
}

fn run(overrides: List<LegOverride>) -> ExportHostReaderRun {
  export_host_reader_apply_with(legs: legs_with(overrides: overrides))
}

fn word(o: ExportHostReaderOutcome) -> String {
  match o {
    ReaderRowsConverged => "converged"
    ReaderRowsRefused { stage: _, cause: _ } => "refused"
    ReaderRowsRolledBack { cause: _ } => "rolled-back"
    ReaderRowsRollbackFailed { cause: _, rollback: _ } => "rollback-failed"
    ReaderRowsReloadUncertain { cause: _, running: _, on_disk: _ } => "reload-uncertain"
  }
}

fn stages(r: ExportHostReaderRun) -> List<String> {
  map(r.stages, s => s as String)
}

fn reloads(r: ExportHostReaderRun) -> Int {
  fold(stages(r: r), init: 0, f: (acc, s) => if s == "reload" { acc + 1 } else { acc })
}

data writes: List<String> = ["sshd-t-option", "account-check", "write-keys", "write-drop-in"]

data through_reload: List<String> = ["sshd-t-option", "account-check", "write-keys", "write-drop-in", "sshd-t", "sshd-T", "reload"]

// CONDITION 1: .ssh/authorized_keys stays FIRST, so every existing login is unchanged; the drop-in is
// exactly that one setting.
test fn existing_authorized_keys_stays_first_in_the_drop_in() -> Bool {
  (authorized_keys_file_value as String).starts_with(".ssh/authorized_keys ")
    && export_host_reader_drop_in().content == concat(authorized_keys_file_option() as String, "\n")
    && match sshd_effective_config_value(text: effective_ours, keyword: "authorizedkeysfile") { Present { value: v } => v == (authorized_keys_file_value as String)  Absent => false }
}

// The file sshd reads for the reader (the %u entry, expanded for its login) is exactly the file written.
test fn the_percent_u_entry_names_the_written_key_file_for_the_reader() -> Bool {
  (authorized_keys_file_value as String).ends_with(suffix: concat(" ", (export_host_reader_keys_path as String).replace(from: boot_medium_reader_login as String, to: "%u")))
    && export_host_reader_keys_path as String == "/etc/ssh/authorized_keys.boot-medium-reader"
}

// CONTROL: a healthy host converges through every stage in order, reloading once.
test fn a_healthy_host_converges_through_every_stage_in_order() -> Bool {
  let r = run(overrides: [])
  word(o: r.outcome) == "converged" && stages(r: r) == concat(through_reload, ["fresh-login"])
}

// RED: an option sshd refuses against the live configuration writes nothing.
test fn a_refused_option_writes_nothing() -> Bool {
  let r = run(overrides: [LegOverride { leg: "precheck", answer: bad() }])
  word(o: r.outcome) == "refused" && stages(r: r) == ["sshd-t-option"]
}

// CONDITION 2 RED: sshd -t refusing the configuration with the drop-in removes the drop-in under the
// absence readback and never reloads.
test fn sshd_t_failure_removes_the_drop_in_and_does_not_reload() -> Bool {
  let r = run(overrides: [LegOverride { leg: "test_config", answer: bad() }])
  word(o: r.outcome) == "refused"
    && stages(r: r) == concat(writes, ["sshd-t", "remove-drop-in", "drop-in-absent-readback"])
    && reloads(r: r) == 0
}

// RED: an effective AuthorizedKeysFile other than ours (an earlier drop-in wins) removes the drop-in and
// never reloads.
test fn a_shadowed_setting_removes_the_drop_in_and_does_not_reload() -> Bool {
  let r = run(overrides: [LegOverride { leg: "effective_config", answer: ok(stdout: "authorizedkeysfile .ssh/authorized_keys\n") }])
  word(o: r.outcome) == "refused" && reloads(r: r) == 0 && stages(r: r).contains("remove-drop-in")
}

// CONDITIONS 3 AND 4 CONTROL: a fresh administrator login failing after the reload rolls back: the drop-in
// is removed AND confirmed absent, sshd is reloaded, and a second fresh login succeeds.
test fn a_failed_fresh_login_rolls_back_through_a_confirmed_removal_and_a_second_login() -> Bool {
  let r = run(overrides: [LegOverride { leg: "fresh_login", answer: bad() }])
  word(o: r.outcome) == "rolled-back"
    && stages(r: r) == concat(through_reload, ["fresh-login", "remove-drop-in", "drop-in-absent-readback", "reload", "fresh-login"])
}

// RED (side chat, HOLD 1): a removal that is not CONFIRMED means no second reload -- whether the completed
// parent listing still NAMES the drop-in (present, including a dangling link), the listing leg is unknown
// (its error, ssh's 255), the listing leg was NEVER DISPATCHED, or rm itself exited 0 over a file the listing
// still names. Only a completed listing that omits the entry confirms absence.
test fn an_unconfirmed_removal_means_no_second_reload() -> Bool {
  let still_there = run(overrides: [LegOverride { leg: "fresh_login", answer: bad() }, LegOverride { leg: "drop_in_listing", answer: present() }])
  let unknown = run(overrides: [LegOverride { leg: "fresh_login", answer: bad() }, LegOverride { leg: "drop_in_listing", answer: answered(exit: 255, out: "", err: "ssh: connection closed") }])
  let never_read = run(overrides: [LegOverride { leg: "fresh_login", answer: bad() }, LegOverride { leg: "drop_in_listing", answer: never(reason: "listing-never-dispatched-xyzzy") }])
  let rm_lied = run(overrides: [LegOverride { leg: "fresh_login", answer: bad() }, LegOverride { leg: "remove_drop_in", answer: ok(stdout: "") }, LegOverride { leg: "drop_in_listing", answer: present() }])
  word(o: still_there.outcome) == "rollback-failed" && reloads(r: still_there) == 1
    && stages(r: still_there) == concat(through_reload, ["fresh-login", "remove-drop-in", "drop-in-absent-readback"])
    && word(o: unknown.outcome) == "rollback-failed" && reloads(r: unknown) == 1
    && word(o: never_read.outcome) == "rollback-failed" && reloads(r: never_read) == 1
    && word(o: rm_lied.outcome) == "rollback-failed" && reloads(r: rm_lied) == 1
}

// RED: a confirmed removal whose rollback reload fails, or whose second fresh login fails, is a loud
// rollback failure, never "rolled back".
test fn a_rollback_is_claimed_only_when_its_reload_and_second_login_hold() -> Bool {
  let reload_failed = run(overrides: [LegOverride { leg: "fresh_login", answer: bad() }, LegOverride { leg: "rollback_reload", answer: bad() }])
  let still_locked = run(overrides: [LegOverride { leg: "fresh_login", answer: bad() }, LegOverride { leg: "rollback_fresh_login", answer: bad() }])
  word(o: reload_failed.outcome) == "rollback-failed" && !string_contains(s: render_export_host_reader_run(r: reload_failed), pattern: "rolled back")
    && word(o: still_locked.outcome) == "rollback-failed"
    && stages(r: still_locked) == concat(through_reload, ["fresh-login", "remove-drop-in", "drop-in-absent-readback", "reload", "fresh-login"])
}

// RED (side chat, HOLD 2): an initial reload that exits nonzero has an UNCERTAIN effect. The readbacks are
// required -- a fresh login of the running server, the confirmed removal, sshd -T of what is on disk --
// nothing is reloaded again, and the receipt never says unchanged or not reloaded.
test fn an_uncertain_initial_reload_requires_the_readbacks_and_never_claims_unchanged() -> Bool {
  let r = run(overrides: [LegOverride { leg: "reload", answer: bad() }])
  let text = render_export_host_reader_run(r: r)
  word(o: r.outcome) == "reload-uncertain"
    && stages(r: r) == concat(through_reload, ["fresh-login", "remove-drop-in", "drop-in-absent-readback", "sshd-T"])
    && reloads(r: r) == 1
    && string_contains(s: text, pattern: "RELOAD UNCERTAIN")
    && string_contains(s: text, pattern: "a fresh administrator login succeeded")
    && string_contains(s: text, pattern: "the drop-in is confirmed absent")
    && string_contains(s: text, pattern: "not ours")
    && !string_contains(s: text, pattern: "unchanged")
    && !string_contains(s: text, pattern: "not reloaded")
}

// The uncertain arm reports what its readbacks found, and stays loud when they are bad.
test fn an_uncertain_reload_reports_a_failed_login_and_an_unconfirmed_removal() -> Bool {
  let r = run(overrides: [LegOverride { leg: "reload", answer: bad() }, LegOverride { leg: "fresh_login", answer: bad() }, LegOverride { leg: "drop_in_listing", answer: present() }, LegOverride { leg: "effective_config_after_removal", answer: ok(stdout: effective_ours) }])
  let text = render_export_host_reader_run(r: r)
  word(o: r.outcome) == "reload-uncertain" && reloads(r: r) == 1
    && string_contains(s: text, pattern: "login FAILED")
    && string_contains(s: text, pattern: "NOT confirmed absent")
    && string_contains(s: text, pattern: "STILL reports ours")
}

// The account is created only when `id -u` does not find it; a creation that fails writes nothing.
test fn the_account_is_created_only_when_absent() -> Bool {
  let created = run(overrides: [LegOverride { leg: "account_exists", answer: bad() }])
  let refused = run(overrides: [LegOverride { leg: "account_exists", answer: bad() }, LegOverride { leg: "ensure_account", answer: bad() }])
  word(o: created.outcome) == "converged" && stages(r: created).contains("account-ensure")
    && word(o: refused.outcome) == "refused" && !stages(r: refused).contains("write-keys")
    && !stages(r: run(overrides: [])).contains("account-ensure")
}

// RED (Blocker 3a): an ensure-account leg that was DISPATCHED but got NO ANSWER reports the account's
// existence as UNCONFIRMED ("it may have run on the host"), NOT the definite "could not be created" that a
// never-dispatched ensure correctly gives. Reaching the ensure leg needs the account-check to report ABSENT
// (id -u exit 1). Red on pre-fix production, whose ensure-account LegUnanswered arm fabricated "the reader
// account could not be created" for a command that may have created it.
test fn an_unanswered_ensure_account_is_unconfirmed_not_could_not_be_created() -> Bool {
  let lost = LegUnanswered { cause: "the process group was killed before the host answered" }
  let r = run(overrides: [LegOverride { leg: "account_exists", answer: bad() }, LegOverride { leg: "ensure_account", answer: lost }])
  let c = match r.outcome { ReaderRowsRefused { stage: _, cause: cc } => cc _ => "" }
  word(o: r.outcome) == "refused"
    && stages(r: r).contains("account-ensure")
    && !stages(r: r).contains("write-keys")
    && string_contains(s: c, pattern: "UNCONFIRMED")
    && string_contains(s: c, pattern: "may have run on the host")
    && string_contains(s: c, pattern: "killed before the host answered")
    && !string_contains(s: c, pattern: "could not be created")
}

// A drop-in write that did not converge is withdrawn and nothing is tested or reloaded.
test fn an_unconverged_drop_in_is_withdrawn() -> Bool {
  let r = run(overrides: [LegOverride { leg: "write_drop_in", answer: bad() }])
  word(o: r.outcome) == "refused" && stages(r: r).contains("remove-drop-in") && reloads(r: r) == 0 && !stages(r: r).contains("sshd-t")
}

// THE HUMAN-READABLE DIAGNOSTIC of an outcome, whichever arm it is, so a control can assert what a leg was
// told without the fold inventing an exit code for a leg that never ran.
fn cause_of(o: ExportHostReaderOutcome) -> String {
  match o {
    ReaderRowsConverged => ""
    ReaderRowsRefused { stage: _, cause: c } => c
    ReaderRowsRolledBack { cause: c } => c
    ReaderRowsRollbackFailed { cause: _, rollback: r } => r
    ReaderRowsReloadUncertain { cause: c, running: _, on_disk: _ } => c
  }
}

// NEVER DISPATCHED, NEVER AN INVENTED EXIT (gunbc.design_argument::fail_closed). A precheck the transport
// never dispatched cannot confirm the option is accepted, so nothing is written and the refusal carries the
// transport's cause -- it does not report a fabricated "exit=". Red on the pre-fix fabricated exit 255.
test fn a_never_dispatched_precheck_refuses_without_inventing_an_exit() -> Bool {
  let r = run(overrides: [LegOverride { leg: "precheck", answer: never(reason: "sshd-precheck-never-dispatched-xyzzy") }])
  let d = cause_of(o: r.outcome)
  word(o: r.outcome) == "refused" && stages(r: r) == ["sshd-t-option"]
    && string_contains(s: d, pattern: "sshd-precheck-never-dispatched-xyzzy") && !string_contains(s: d, pattern: "exit=")
}

// A reload the transport never dispatched is NOT the same as a reload that ran and exited nonzero. The
// drop-in is still withdrawn and the fold refuses; it is never reported as the reload-uncertain outcome
// (which claims systemctl ran and exited nonzero -- a fabrication about a command that never started).
test fn a_never_dispatched_reload_withdraws_rather_than_claiming_reload_uncertain() -> Bool {
  let r = run(overrides: [LegOverride { leg: "reload", answer: never(reason: "systemctl-reload-never-dispatched-xyzzy") }])
  let d = cause_of(o: r.outcome)
  word(o: r.outcome) == "refused"
    && string_contains(s: d, pattern: "systemctl-reload-never-dispatched-xyzzy")
    && !string_contains(s: d, pattern: "exited nonzero")
}

// A NEVER-DISPATCHED REMOVAL READBACK IS NEVER CONFIRMED ABSENT. A leg that did not run cannot prove the
// drop-in is gone; it must stay "NOT confirmed absent" and carry its cause. If absence were fabricated as
// exit 1, this would flip to "confirmed absent and sshd was not reloaded" -- which is exactly the red.
test fn a_never_dispatched_removal_readback_is_never_confirmed_absent() -> Bool {
  let r = run(overrides: [LegOverride { leg: "test_config", answer: bad() },
                          LegOverride { leg: "drop_in_listing", answer: never(reason: "readback-transport-refused-xyzzy") }])
  let d = cause_of(o: r.outcome)
  word(o: r.outcome) == "refused"
    && string_contains(s: d, pattern: "NOT confirmed absent")
    && string_contains(s: d, pattern: "readback-transport-refused-xyzzy")
    && !string_contains(s: d, pattern: "confirmed absent and sshd was not reloaded")
}

// A REAL ANSWERED 255 STAYS AN ANSWERED EXIT, DISTINCT FROM NEVER DISPATCHED (reviewer ask). Same leg, two
// shapes: a genuinely answered ssh 255 renders its real "exit=255"; a never-dispatched leg carries its cause
// and is NEVER given "exit=255". Restoring a fabricated-255 thunk (a never-dispatched leg rendered as a
// LegAnswered{exit_code:255}) turns the never-dispatched run red on the final assertion.
test fn a_real_answered_255_stays_an_answered_exit_distinct_from_never_dispatched() -> Bool {
  let real = run(overrides: [LegOverride { leg: "test_config", answer: bad() },
                             LegOverride { leg: "drop_in_listing", answer: answered(exit: 255, out: "", err: "ssh-remote-hung-up-xyzzy") }])
  let nd   = run(overrides: [LegOverride { leg: "test_config", answer: bad() },
                             LegOverride { leg: "drop_in_listing", answer: never(reason: "dropin-never-dispatched-xyzzy") }])
  let dr = cause_of(o: real.outcome)
  let dn = cause_of(o: nd.outcome)
  word(o: real.outcome) == "refused" && word(o: nd.outcome) == "refused"
    && string_contains(s: dr, pattern: "exit=255") && string_contains(s: dr, pattern: "ssh-remote-hung-up-xyzzy")
    && string_contains(s: dn, pattern: "dropin-never-dispatched-xyzzy") && !string_contains(s: dn, pattern: "exit=255")
}

// CONTROL (reviewer, Blocker 1, root defect): a reload the transport DISPATCHED but got NO ANSWER for -- the
// leg overran its wall-clock deadline (TypedArgvExecOverran), routed through the PRODUCTION mapper
// host_leg_of_typed_argv -- has an UNKNOWN effect: sshd may already have taken the drop-in. It MUST reach the
// reload-uncertain arm and run the uncertainty readbacks (removal, the sshd -T of what is on disk, a fresh
// login), never be read as a never-dispatched reload that withdrew "sshd was not reloaded" without checking.
// RED against the pre-fix host_leg_of_typed_argv that mapped TypedArgvExecOverran onto LegNotDispatched
// (which withdrew without running the readbacks and left the daemon possibly running an unreported config).
test fn an_overran_initial_reload_runs_the_readbacks_and_never_says_not_reloaded() -> Bool {
  let overran = host_leg_of_typed_argv(outcome: TypedArgvExecOverran { deadline: second(count: 30) })
  let r = run(overrides: [LegOverride { leg: "reload", answer: overran }])
  let text = render_export_host_reader_run(r: r)
  word(o: r.outcome) == "reload-uncertain"
    && stages(r: r) == concat(through_reload, ["fresh-login", "remove-drop-in", "drop-in-absent-readback", "sshd-T"])
    && reloads(r: r) == 1
    && string_contains(s: text, pattern: "RELOAD UNCERTAIN")
    && string_contains(s: text, pattern: "DISPATCHED but its reply was lost")
    && string_contains(s: text, pattern: "the process group was killed before the host answered")
    && string_contains(s: text, pattern: "the drop-in is confirmed absent")
    && !string_contains(s: text, pattern: "not reloaded")
    && !string_contains(s: text, pattern: "unchanged")
}

// CONTROL (reviewer, Blocker 2): the absence read is elevated -- ONE parent listing -- and an elevated read can be
// DENIED by sudo policy WITHOUT the "sudo:" word -- "Sorry, user ... is not allowed to execute ..." -- and still
// exit 1, the same exit a genuine "absent" gave the OLD readback. Under the listing model, absence is claimed ONLY
// on a listing that COMPLETED (exit 0); an exit-1 policy denial establishes nothing, so the removal stays
// unconfirmed, the rollback FAILS loudly, and NO second reload runs. Red on the pre-fix readback_absent that
// read a bare exit-1 as absent: it would have confirmed a phantom absence, done a second reload, and could
// report rolled back. (Named against the pre-fix revision, not "current production". The name once said "both
// reads", from the two-test readback this listing replaced.)
test fn a_rollback_with_sudo_refusal_on_the_parent_listing_fails_without_a_second_reload() -> Bool {
  let policy_denied = answered(exit: 1, out: "", err: "Sorry, user deploy is not allowed to execute '/usr/bin/ls -1 -A -- /etc/ssh/sshd_config.d' as root")
  let r = run(overrides: [
    LegOverride { leg: "fresh_login", answer: bad() },
    LegOverride { leg: "remove_drop_in", answer: ok(stdout: "") },
    LegOverride { leg: "drop_in_listing", answer: policy_denied }])
  let text = render_export_host_reader_run(r: r)
  word(o: r.outcome) == "rollback-failed"
    && reloads(r: r) == 1
    && string_contains(s: text, pattern: "NOT confirmed absent")
    && string_contains(s: text, pattern: "is not allowed to execute")
    && !string_contains(s: text, pattern: "rolled back")
}

// CONTROL (reviewer, Blocker 2 positive): a removal whose rm reply was never dispatched is still CONFIRMED
// ABSENT when the elevated listing COMPLETED (exit 0) and does not name the entry -- the rollback reloads and
// reports rolled back. Guards the absence guarantee the disambiguation could otherwise over-block.
test fn an_unobserved_removal_is_still_confirmed_absent_by_valid_reads() -> Bool {
  let r = run(overrides: [
    LegOverride { leg: "fresh_login", answer: bad() },
    LegOverride { leg: "remove_drop_in", answer: never(reason: "rm-never-dispatched-xyzzy") },
    LegOverride { leg: "drop_in_listing", answer: absent() }])
  word(o: r.outcome) == "rolled-back"
    && reloads(r: r) == 2
}

// ── CONTROL: a wire-inconsistent reload is NOT "not dispatched" ──────────────────────────────────
// (follow-up of #16984, root_generalization). The command WAS sent; the reply arrived with an
// inconsistent wire shape; the effect is UNKNOWN. host_leg_of_typed_argv must map it to LegUnanswered
// (with the wire-fault cause), and reload_uncertain must run the recovery readbacks. This control is
// RED before the 4th arm existed: the wire fault arrived as TypedArgvExecRefused, mapped to
// LegNotDispatched, and the reload arm said "sshd was NOT reloaded" (skipping the recovery readbacks).

// Feed a TypedArgvExecWireInconsistent through the REAL mapper into the converge fold.
fn wire_inconsistent_via_real_mapper(fault: SshSessionWireFault) -> HostLeg {
  host_leg_of_typed_argv(outcome: TypedArgvExecWireInconsistent { fault: fault })
}

// CONTROL 1: the real mapper produces LegUnanswered (not LegNotDispatched) from a wire-inconsistent outcome.
test fn the_real_mapper_maps_wire_inconsistent_to_leg_unanswered() -> Bool {
  let leg = wire_inconsistent_via_real_mapper(fault: OverrunWithoutDeadline)
  match leg {
    LegUnanswered { cause: c } => string_contains(s: c, pattern: "dispatched but its reply carried an inconsistent wire shape")
    LegNotDispatched { reason: _ } => false
    LegAnswered { exit_code: _, stdout: _, stderr: _ } => false
  }
}

// CONTROL 2: a wire-inconsistent reload goes through the converge fold into reload_uncertain,
// the recovery readbacks run (fresh-login, sshd-T stages appear), and the cause does NOT say "deadline".
test fn a_wire_inconsistent_reload_enters_reload_uncertain_with_recovery_readbacks() -> Bool {
  let wire_leg = wire_inconsistent_via_real_mapper(fault: OverrunWithoutDeadline)
  let r = run(overrides: [LegOverride { leg: "reload", answer: wire_leg }])
  let text = render_export_host_reader_run(r: r)
  word(o: r.outcome) == "reload-uncertain"
    && reloads(r: r) == 1
    && stages(r: r).contains("fresh-login")
    && stages(r: r).contains("sshd-T")
    && string_contains(s: text, pattern: "DISPATCHED but its reply was lost")
    && !string_contains(s: text, pattern: "never dispatched, so sshd was not reloaded")
    && !string_contains(s: text, pattern: "overran its deadline")
}

// CONTROL 3: a wire-inconsistent reload does NOT claim "sshd was not reloaded" (the pre-fix lie).
test fn a_wire_inconsistent_reload_never_claims_sshd_was_not_reloaded() -> Bool {
  let wire_leg = wire_inconsistent_via_real_mapper(fault: OverrunWithoutDeadline)
  let r = run(overrides: [LegOverride { leg: "reload", answer: wire_leg }])
  let text = render_export_host_reader_run(r: r)
  !string_contains(s: text, pattern: "was not reloaded")
}

fn on_disk_of(o: ExportHostReaderOutcome) -> String {
  match o {
    ReaderRowsReloadUncertain { cause: _, running: _, on_disk: d } => d
    ReaderRowsConverged => ""
    ReaderRowsRefused { stage: _, cause: _ } => ""
    ReaderRowsRolledBack { cause: _ } => ""
    ReaderRowsRollbackFailed { cause: _, rollback: _ } => ""
  }
}

// CONTROL 4 (item 4): the reload-uncertain `on_disk` must carry the POST-removal sshd -T, not the pre-reload
// read. Both stages list "sshd-T", so stages.contains("sshd-T") cannot tell the two sshd -T reads apart -- the
// pre-reload one (effective_config) and the recovery readback (effective_config_after_removal). Give the POST read
// a distinct AuthorizedKeysFile value and assert it reaches on_disk: it only appears there if the fold's recovery
// readback read the post-removal leg (the default post value would not carry this marker).
test fn a_wire_inconsistent_reload_reports_the_post_removal_sshd_T() -> Bool {
  let wire_leg = wire_inconsistent_via_real_mapper(fault: OverrunWithoutDeadline)
  let r = run(overrides: [
    LegOverride { leg: "reload", answer: wire_leg },
    LegOverride { leg: "effective_config_after_removal", answer: ok(stdout: "port 22\nauthorizedkeysfile /etc/ssh/gunbc_post_removal_pin_BBBB.%u\n") }])
  let d = on_disk_of(o: r.outcome)
  word(o: r.outcome) == "reload-uncertain"
    && string_contains(s: d, pattern: "gunbc_post_removal_pin_BBBB")
}
