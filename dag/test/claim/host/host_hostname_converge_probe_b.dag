module test.claim.host.host_hostname_converge_probe_b

import std.types { Bool, String }
import std.optional { Absent, Present }
import gunbc.host.host_hostname_converge { HostnameConvergePlan, hostname_converge_plan, HostnameConvergeDirection }

test fn probe_single_fold_call() -> Bool {
  match hostname_converge_plan(direction: Forward, base: "a", desired: "b", live: "b") {
    NoopPlan { live: l } => l == "b"
    _ => false
  }
}
