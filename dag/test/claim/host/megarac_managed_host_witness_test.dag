module test.claim.megarac_managed_host_witness

import std.types { Bool, List, NonEmptyStr, String }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import extdeps.bmc.endpoint { BmcControllerEndpoint, BmcFirmwareFamily, AmiMegaRac, OpenBmc }
import extdeps.bmc.capability { BmcFirmwareReleaseIdentity, bmc_firmware_release_identity_of_wire }
import extdeps.bmc.access_profile { BmcAccessObservation, BmcAccessObserved, BmcAccessUnobserved, BmcObservedIdentity }
import gunbc.fleet_host_identity { operator_host_mtcollins1 }
import gunbc.managed_host {
  ManagedHost, managed_host_fixture, managed_hosts, ManagedHostAccessUnobserved, ManagedHostEndpointMismatch,
}
import gunbc.megarac_managed_host {
  MegaRacOperation, MegaRacVirtualMediaAttach, MegaRacKvmCanvasStill, MegaRacSdrSocketNaming,
  MegaRacHostAdmission, MegaRacHostAdmitted, MegaRacHostRefused,
  MegaRacHostNotManaged, MegaRacHostNotBound, MegaRacHostNotMegaRac, MegaRacBuildNotExecuted,
  admit_megarac_host, megarac_host_admission_in, megarac_host_refusal_text,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data megarac_operations: List<MegaRacOperation> = [MegaRacVirtualMediaAttach, MegaRacKvmCanvasStill, MegaRacSdrSocketNaming]

// THE INHABITANCE CLAIM, AND IT ASSERTS THE ROUTE. The one managed row, mtcollins1, is admitted for every
// MegaRAC operation the boot drives, and each carrier's endpoint, account and firmware are its binding's
// own: the endpoint the binding observed, the account the binding carries, and the firmware that
// observation read. Its observed family turning OpenBMC, its build changing, or its secure standing
// going Absent turns this red.
test fn w_the_real_row_is_admitted_for_each_megarac_operation_through_its_binding() -> Bool {
  let hosts = managed_hosts()
  count(hosts) == 1
    && hosts |> all(h => (h.host as String) == (operator_host_mtcollins1 as String)
      && megarac_operations |> all(op => match admit_megarac_host(host: h, operation: op) {
        MegaRacHostAdmitted { host: a } =>
          (a.binding.host.host as String) == (operator_host_mtcollins1 as String)
            && a.firmware.family == AmiMegaRac
            && (a.firmware.raw_version as String) == (a.binding.observation.identity.firmware.raw_version as String)
            && (a.binding.observation.endpoint.host as String) != ""
            && (a.binding.account as String) == "gunbc"
        MegaRacHostRefused { cause: _ } => false
      }))
}

fn identity_with(o: BmcAccessObservation, firmware: BmcFirmwareReleaseIdentity) -> BmcObservedIdentity {
  BmcObservedIdentity { baseboard: o.identity.baseboard, chassis_part_number: o.identity.chassis_part_number, firmware: firmware }
}

fn observation_with(o: BmcAccessObservation, host: String, firmware: BmcFirmwareReleaseIdentity) -> BmcAccessObservation {
  BmcAccessObservation {
    endpoint: BmcControllerEndpoint { host: host as NonEmptyStr },
    identity: identity_with(o: o, firmware: firmware),
    discovered_surfaces: o.discovered_surfaces,
    boot_control_routes: o.boot_control_routes,
    redfish_virtual_media_probe: o.redfish_virtual_media_probe,
    successful_read_surfaces: o.successful_read_surfaces,
    successful_write_surfaces: o.successful_write_surfaces,
    raw_response: o.raw_response,
    observed_at: o.observed_at,
  }
}

fn refused_for_every_operation(h: ManagedHost, refused: fn(MegaRacHostAdmission) -> Bool) -> Bool {
  megarac_operations |> all(op => refused(admit_megarac_host(host: h, operation: op)))
}

// RED: THE SAME BOUND CONTROLLER, OBSERVED AS OPENBMC. Everything else of the real row is kept; the
// observation's family is the only change, and every MegaRAC operation refuses it by family.
test fn w_a_controller_observed_as_openbmc_is_refused_for_every_megarac_operation() -> Bool {
  managed_hosts() |> all(h => match h.access {
    BmcAccessUnobserved { endpoint: _ } => false
    BmcAccessObserved { observation: o } => {
      let openbmc = managed_host_fixture(host: h.host, access: BmcAccessObserved { observation: observation_with(o: o, host: o.endpoint.host as String, firmware: bmc_firmware_release_identity_of_wire(family: OpenBmc, wire: o.identity.firmware.raw_version)) }, capability_row: h.capability_row, secure: h.secure, unit_hold: h.unit_hold, smpro: h.smpro)
      refused_for_every_operation(h: openbmc, refused: a => match a {
        MegaRacHostRefused { cause: MegaRacHostNotMegaRac { family: f } } => f == OpenBmc && string_contains(s: megarac_host_refusal_text(cause: MegaRacHostNotMegaRac { family: f }) as String, pattern: "not AMI MegaRAC")
        _ => false
      })
    }
  }) && count(managed_hosts()) == 1
}

// RED: THE SAME HOST WITH ITS CONTROLLER UNOBSERVED. There is no family to read, and every operation
// refuses it as unbound, before any request.
test fn w_a_controller_whose_family_is_unobserved_is_refused_for_every_megarac_operation() -> Bool {
  managed_hosts() |> all(h => match h.access {
    BmcAccessUnobserved { endpoint: _ } => false
    BmcAccessObserved { observation: o } => {
      let unobserved = managed_host_fixture(host: h.host, access: BmcAccessUnobserved { endpoint: o.endpoint }, capability_row: h.capability_row, secure: h.secure, unit_hold: h.unit_hold, smpro: h.smpro)
      refused_for_every_operation(h: unobserved, refused: a => match a {
        MegaRacHostRefused { cause: MegaRacHostNotBound { standing: ManagedHostAccessUnobserved { endpoint: _ } } } => true
        _ => false
      })
    }
  }) && count(managed_hosts()) == 1
}

// RED: A MEGARAC CONTROLLER OF ANOTHER BUILD. The family is still MegaRAC; the raw firmware is the one
// Mt. Jade's controller reports (gunbc.machine_intake_mtjade1_access_observation), a build none of these
// operations was executed on, so each refuses it by build and names the build.
test fn w_a_megarac_build_no_operation_was_executed_on_is_refused_for_every_operation() -> Bool {
  managed_hosts() |> all(h => match h.access {
    BmcAccessUnobserved { endpoint: _ } => false
    BmcAccessObserved { observation: o } => {
      let other = managed_host_fixture(host: h.host, access: BmcAccessObserved { observation: observation_with(o: o, host: o.endpoint.host as String, firmware: bmc_firmware_release_identity_of_wire(family: AmiMegaRac, wire: "2.11")) }, capability_row: h.capability_row, secure: h.secure, unit_hold: h.unit_hold, smpro: h.smpro)
      refused_for_every_operation(h: other, refused: a => match a {
        MegaRacHostRefused { cause: MegaRacBuildNotExecuted { operation: _, firmware: fw } } => (fw.raw_version as String) == "2.11"
        _ => false
      })
    }
  }) && count(managed_hosts()) == 1
}

// RED: CONTROLLER A'S SECURED ACCOUNT BESIDE CONTROLLER B'S ACCESS (the cut-0 join). The real row's
// secure standing is kept and its access observation is re-pointed at another controller; no MegaRAC
// carrier is minted, so the media attach, the viewer and the sensor read -- which take their endpoint
// and account only from a carrier -- cannot drive B with A's account.
test fn w_a_secured_account_beside_another_controllers_access_is_admitted_for_no_operation() -> Bool {
  managed_hosts() |> all(h => match h.access {
    BmcAccessUnobserved { endpoint: _ } => false
    BmcAccessObserved { observation: o } => {
      let crossed = managed_host_fixture(host: h.host, access: BmcAccessObserved { observation: observation_with(o: o, host: "fixture-other-bmc", firmware: o.identity.firmware) }, capability_row: h.capability_row, secure: h.secure, unit_hold: h.unit_hold, smpro: h.smpro)
      refused_for_every_operation(h: crossed, refused: a => match a {
        MegaRacHostRefused { cause: MegaRacHostNotBound { standing: ManagedHostEndpointMismatch { observed: ob, secured: _ } } } => (ob.host as String) == "fixture-other-bmc"
        _ => false
      })
    }
  }) && count(managed_hosts()) == 1
}

// RED: A HOST THAT IS NOT MANAGED. mtjade1 has no row (docs/plans/managed-host-untangle.md: its absence
// is the honest standing), so a procedure reached by its name refuses it for every operation.
test fn w_a_host_that_is_not_managed_is_refused_for_every_operation() -> Bool {
  megarac_operations |> all(op => match megarac_host_admission_in(hosts: managed_hosts(), host: "mtjade1", operation: op) {
    MegaRacHostRefused { cause: MegaRacHostNotManaged { host: x } } => (x as String) == "mtjade1"
    _ => false
  }) && count(managed_hosts()) == 1
}
