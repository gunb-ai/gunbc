module test.claim.host_effect_apply_witness

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn host_os_target() -> NodeControlPlane {
  HostOs { node: srv1_host }
}

fn bmc_target() -> NodeControlPlane {
  BmcController { node: srv1_host }
}

fn directive_is_settled(d: ConvergeDirective) -> Bool {
  match d {
    Settled => true
    ReDrive => false
    Refused { reason: _ } => false
  }
}

fn directive_is_redrive(d: ConvergeDirective) -> Bool {
  match d {
    Settled => false
    ReDrive => true
    Refused { reason: _ } => false
  }
}

fn directive_is_refused(d: ConvergeDirective) -> Bool {
  match d {
    Settled => false
    ReDrive => false
    Refused { reason: _ } => true
  }
}

test fn witness_typed_read_on_host_success_converges() -> Bool {
  reconciliation_converged(r: host_effect_apply(
    target: host_os_target(),
    effect: ReadEffectivePosixPrincipal { read: EffectivePosixPrincipalRead {} },
    evidence: host_effect_identity_evidence,
    transport: LocalShell
  ))
}

test fn witness_converge_frontier_failure_fails_closed() -> Bool {
  !reconciliation_converged(r: host_effect_apply(
    target: host_os_target(),
    effect: ConvergePlan { policy: fixture_srv1_host_converge() },
    evidence: host_effect_identity_evidence,
    transport: LocalShell
  ))
}

test fn witness_redfish_on_bmc_unimplemented_fails_closed() -> Bool {
  !reconciliation_converged(r: host_effect_apply(
    target: bmc_target(),
    effect: RedfishAction { action: GetSystem },
    evidence: host_effect_identity_evidence,
    transport: LocalShell
  ))
}

test fn witness_redfish_on_hostos_typed_mismatch() -> Bool {
  !reconciliation_converged(r: host_effect_apply(
    target: host_os_target(),
    effect: RedfishAction { action: GetSystem },
    evidence: host_effect_identity_evidence,
    transport: LocalShell
  ))
}

test fn witness_typed_read_on_bmc_typed_mismatch() -> Bool {
  !reconciliation_converged(r: host_effect_apply(
    target: bmc_target(),
    effect: ReadEffectivePosixPrincipal { read: EffectivePosixPrincipalRead {} },
    evidence: host_effect_identity_evidence,
    transport: LocalShell
  ))
}

test fn witness_runner_local_probe_remote_transport_refuses_before_execution() -> Bool {
  match host_effect_apply(
    target: RunnerLocalHost,
    effect: ProbeToolchainHomeInterference {},
    evidence: host_effect_identity_evidence,
    transport: SshShell { ssh_host: "203.0.113.1" as NonEmptyStr }
  ) {
    NotConverged { reason: why, applied: _ } =>
      string_contains(s: why, pattern: "requires LocalShell on RunnerLocalHost")
        && string_contains(s: why, pattern: "SshShell")
    Converged { evidence: _, applied: _ } => false
  }
}

test fn witness_converge_policy_redrives_not_converged() -> Bool {
  directive_is_redrive(d: host_effect_drive_directive(r: host_effect_apply(
    target: host_os_target(),
    effect: ReadEffectivePosixPrincipal { read: EffectivePosixPrincipalRead {} },
    evidence: host_effect_converge_loop_evidence,
    transport: EmitArtifactThenThinRun {
      bootstrap: BootstrapFragment { script: "" },
      invocation: ThinInvocation { argv: [] },
    }
  )))
}

test fn witness_oneshot_policy_terminal_not_converged() -> Bool {
  directive_is_settled(d: host_effect_drive_directive(r: host_effect_apply(
    target: host_os_target(),
    effect: ReadEffectivePosixPrincipal { read: EffectivePosixPrincipalRead {} },
    evidence: host_effect_identity_evidence,
    transport: EmitArtifactThenThinRun {
      bootstrap: BootstrapFragment { script: "" },
      invocation: ThinInvocation { argv: [] },
    }
  )))
}

test fn witness_incompatible_is_refused_terminal() -> Bool {
  directive_is_refused(d: host_effect_drive_directive(r: host_effect_apply(
