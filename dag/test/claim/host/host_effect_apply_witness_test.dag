// Controlled process observation tests the shared reconciliation boundary;
// script execution is no longer a constructible HostEffect.
test fn witness_process_failure_preserves_observed_stdout() -> Bool {
  match reconcile_shell_exec_observed(
    observed: ShellExecObserved {
      exit_code: 1, success: false,
      stdout: "host-effect-preflight-marker", stderr: "",
    },
    intent: HostEffectIntent {
      target: host_os_target(),
      effect: ReadEffectivePosixPrincipal { read: EffectivePosixPrincipalRead {} },
      evidence: host_effect_identity_evidence,
      transport: LocalShell,
      privilege_denial: none,
    },
  ) {
    NotConverged { reason: why, applied: _ } =>
      string_contains(s: why, pattern: "host-effect-preflight-marker")
        && string_contains(s: why, pattern: "--- stdout ---")
    Converged { evidence: _, applied: _ } => false
  }
}

test fn witness_identity_evidence_derives_oneshot_drive() -> Bool {
  host_effect_drive_from_evidence(evidence: host_effect_identity_evidence) == OneShot
}

test fn witness_converge_loop_evidence_derives_converge_drive() -> Bool {
  host_effect_drive_from_evidence(evidence: host_effect_converge_loop_evidence) == ConvergeLoop
}

data witness_arbitrary_non_idempotent_evidence: IdempotencyEvidence = NonIdempotent {
  shape: AppendEffect,
  reason: "breaking side effect — not a converge-loop authorization",
}

test fn witness_arbitrary_non_idempotent_derives_oneshot_not_redrive() -> Bool {
  host_effect_drive_from_evidence(evidence: witness_arbitrary_non_idempotent_evidence) == OneShot
}

test fn witness_lattice_breaking_shape_derives_oneshot_not_redrive() -> Bool {
  host_effect_drive_from_evidence(evidence: LatticeEffect { shape: AppendEffect }) == OneShot
}

fn fixture_srv1_host_converge() -> HostConverge {
  HostConverge {
    identity: srv1_host.identity,
    knobs: [
      ConvergeKnob {
        slice: GunbcSlice,
        name: "pinned_tree_sha",
        desired: gunbc_pinned_tree_desired_label,
        target: GunbcPinnedTree {
          gunbc_root_env_key: gunbc_root_env_key,
          gunbc_root_path: gunbc_host_gunbc_root_path,
          dag_root: DeferToSubmodule { submodule_path: gunbc_dag_root_submodule_path },
          ctrl_checkout_path: gunbc_host_ctrl_checkout_path,
          binary: gunbc_pinned_binary_provenance_policy(),
          pin_read_script: gunbc_ctrl_read_pin_script,
          green_place_marker: gunbc_green_place_marker_spec(),
          live_apply: gunbc_dashboard_live_apply_policy(),
        },
        apply_mode: FreshStandup,
        no_op: BlindApply,
      }
    ],
    membership: NoMembershipProbe,
  }
}

test fn witness_converge_plan_fail_closed_on_knob_frontier() -> Bool {
  !reconciliation_converged(r: host_effect_apply(
    target: host_os_target(),
    effect: ConvergePlan { policy: fixture_srv1_host_converge() },
    evidence: host_effect_converge_loop_evidence,
    transport: LocalShell
  ))
}

test fn witness_converge_plan_on_bmc_typed_mismatch() -> Bool {
  !reconciliation_converged(r: host_effect_apply(
    target: bmc_target(),
    effect: ConvergePlan { policy: fixture_srv1_host_converge() },
    evidence: host_effect_identity_evidence,
    transport: LocalShell
  ))
}

test fn witness_converge_plan_redrives_on_frontier() -> Bool {
  directive_is_redrive(d: host_effect_drive_directive(r: host_effect_apply(
    target: host_os_target(),
    effect: ConvergePlan { policy: fixture_srv1_host_converge() },
    evidence: host_effect_converge_loop_evidence,
    transport: LocalShell
  )))
}
