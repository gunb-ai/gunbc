data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// The name said `_in_shell` because the property was asserted on the read-back's script text. It is now
// asserted on the typed read-back's outcomes, which is the stronger claim: a non-zero exit, a read that
// could not run, and a read that answered are three different inputs, and only the third may converge.
test fn design_witness_read_back_fails_closed_on_typed_read_back() -> Bool {
  build_cache_provision_read_back_fails_closed()
}

test fn design_witness_unknown_catalog_refuses_at_gate() -> Bool {
