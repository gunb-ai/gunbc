// FIRST MATCH WINS, OVER THE ROW IN ORDER -- the property the old claim asserted by grepping the emitted
// script for `for frag in` and the absence of `elif`. That assertion was about SHAPE and could be satisfied
// by an unrolled chain that happened to lack the word `elif`; the typed route has no emitted script to
// grep, so what is left to assert is the behaviour, which is what the shape was ever for.
//
// With a capture containing BOTH cited fragments, the scan must return the FIRST. Last-match, any-match, or
// a chain built in a different order all fail here, and a row reordered without its consumers would fail
// too. What this claim can NOT discriminate is a hand-unrolled chain in the same order -- it behaves
// identically, so no behavioural claim could tell them apart; the thing that made unrolling a real risk was
// fragments living somewhere other than the cited row, and build_cache_classifier_covers_every_cited_fragment
// is the claim that catches that.
test fn design_witness_classifier_is_a_fold_not_an_unrolled_chain() -> Bool {
  // THE SUBJECT MATTER COMES FROM THE MODULE UNDER TEST, not from a list assembled here. The fragments a
  // classifier is claimed to scan are the classifier's own data, so the module that owns the classifier hands
  // them over; a claim that built its own fragment list would be testing its own copy as much as the
  // classifier.
  //
  // WHY THIS IS A FOLD AND NOT AN INDEX: the first cut of this claim reached the two fragments through
  // `get(xs:, index:)`, which type-checks and then fails at run time — `get` is an algebra FIELD (a receiver
  // plus a positional Int), not a named-parameter function. The claim came back UNOBSERVED, which is the
  // verdict a claim that never actually ran receives, and it sat looking enrolled for the whole time. A
  // permanently-unobserved claim is worse than a red one: red gets read, unobserved gets counted.
  let probe = build_cache_fragment_probe()
  match probe.first {
    Absent => false
    Present { value: a } =>
      match probe.second {
        Absent => false
        Present { value: b } =>
          match build_cache_matched_stats_fragment(capture: build_cache_two_fragment_capture(first: a, second: b)) {
            // THE FIRST MATCH WINS, which is the property under test: a fold that keeps the earliest fragment
            // rather than the latest. Were the classifier an unrolled chain that tested fragments in reverse,
            // this would return the second and refuse here.
            Present { value: got } => got == a
            Absent => false
          }
      }
  }
}

// THE FIRST TWO CITED FRAGMENTS, AS A PAIR, taken by INDEX so the claim cannot pass by hard-coding a
// fragment that happens to be first today. Absent when the row is shorter than two, which the caller fails

test fn design_witness_release_arch_token_is_fail_closed() -> Bool {
  match sccache_release_arch_token(arch: Aarch64) {
    Present { value: token } => token as String == "aarch64"
    Absent => false
  } && match sccache_release_arch_token(arch: X86_64) {
    Present { value: token } => token as String == "x86_64"
    Absent => false
  } && match sccache_release_arch_token(arch: Riscv64) {
    Absent => true
    Present { value: _ } => false
  } && match sccache_release_arch_token(arch: Wasm32) {
    Absent => true
    Present { value: _ } => false
  }
}

test fn design_witness_release_digest_is_fail_closed() -> Bool {
  match sccache_release_digest(rel: sccache_release_0_15_0, arch: Aarch64) {
    Present { value: d } => d == sccache_release_0_15_0.digest_aarch64
    Absent => false
  } && match sccache_release_digest(rel: sccache_release_0_15_0, arch: X86_64) {
    Present { value: d } => d == sccache_release_0_15_0.digest_x86_64
    Absent => false
  } && match sccache_release_digest(rel: sccache_release_0_15_0, arch: Riscv64) {
    Absent => true
    Present { value: _ } => false
  }
}

test fn design_witness_arch_unknown_host_refuses_realization() -> Bool {
  match realize_provision_build_cache(
    effect_intent: provision_build_cache_arch_unknown_intent_fixture(),
  ) {
    NotConverged { reason: why, applied: _ } =>
      string_contains(s: why, pattern: "cannot derive a target architecture")
        && string_contains(s: why, pattern: "no default arch")
    Converged { evidence: _, applied: _ } => false
  }
}

test fn design_witness_known_arch_host_does_not_refuse_for_arch() -> Bool {
  match provision_build_cache_host_arch(
    effect_intent: provision_build_cache_witness_intent(),
  ) {
    Present { value: arch } =>
      match sccache_release_arch_token(arch: arch) {
        Present { value: token } => token as String == "aarch64"
        Absent => false
      }
    Absent => false
  }
}
