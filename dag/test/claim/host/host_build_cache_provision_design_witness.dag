fn path_shadow_observation_fixture() -> BuildCacheDaemonObservation {
  DaemonPathShadowed { resolved: "/usr/bin/sccache", expected: "/usr/local/bin/sccache" }
}

test fn design_witness_path_shadow_refuses_fail_closed() -> Bool {
  match provision_build_cache_verdict(
    catalog_id: sccache_local_id,
    observed: path_shadow_observation_fixture(),
  ) {
    BuildCacheProvisionRefused { cause: RefusalPathShadowed, reason: reason } =>
      string_contains(s: reason as String, pattern: "/usr/bin/sccache")
        && string_contains(s: reason as String, pattern: "/usr/local/bin/sccache")
        && string_contains(s: reason as String, pattern: "Fail-closed")
    BuildCacheProvisionRefused { cause: _, reason: _ } => false
    BuildCacheProvisionConverged { catalog_id: _, stats_line: _ } => false
  }
}

test fn design_witness_red_control_widen_on_path_shadow_rejected_by_gate() -> Bool {
  match provision_build_cache_absorbing_fallback_widen_sketch(
    catalog_id: sccache_local_id,
    observed: path_shadow_observation_fixture(),
  ) {
    BuildCacheProvisionConverged { catalog_id: _, stats_line: _ } => true
    BuildCacheProvisionRefused { cause: _, reason: _ } => false
  } && !build_cache_provision_gate_accepts(
      catalog_id: sccache_local_id,
      verdict: provision_build_cache_absorbing_fallback_widen_sketch(
        catalog_id: sccache_local_id,
        observed: path_shadow_observation_fixture(),
      ),
      observed: path_shadow_observation_fixture(),
    )
    && build_cache_provision_gate_accepts(
      catalog_id: sccache_local_id,
      verdict: provision_build_cache_verdict(
        catalog_id: sccache_local_id,
        observed: path_shadow_observation_fixture(),
      ),
      observed: path_shadow_observation_fixture(),
    )
}

// THE PATH-AUTHORITY AND SUPERVISION OBSERVATIONS ARE NOT THE BUILD-CACHE ENSURE'S TO MAKE. Both belong to
// other authorities: endpoint path state to gunbc.build_cache.build_cache_endpoint_observe (which the
// realize path already runs as the PRE-flight), and unit supervision to whoever claims a systemd unit -- and
// neither question can be answered from inside the ensure, because `--show-stats` answers "does something
// answer this socket", never "who set it up". The retired script printed both kinds of receipt into its own
// stdout, where a later phase could grep them and read them as evidence; the typed route has no stdout for a
// phase to lie into, so the claim is now that no such PROBE is even derived.
//
// ASSERTED NON-VACUOUSLY, because a `!string_contains` claim is worth nothing if the string simply exists
// nowhere: each claim first requires text the ensure DOES derive, and the requirement is anchored on the
// legs the renderer must be looking at, not on text that merely happens to occur somewhere. The
// path-authority claim anchors on the digest read (a leg the ensure derives precisely because it installs
// something it has to identify), the supervision claim on the unit reload (a leg it derives precisely
// because it writes a unit). Both are asserted over the install-needing host, which is the host whose plan
// is longest, so a probe hidden in a leg only that host exercises still surfaces.
//
// The anchor choice is the substance of the guard. An earlier draft of the first claim anchored on
// `--show-stats`, which is the OBSERVE and READ-BACK command and is not an ensure operation at all -- a
// non-vacuity guard that can never be satisfied is not a guard, it is a permanently red claim, and it
// would have been deleted as flaky with its refusal unnoticed.
test fn design_witness_path_authority_probe_not_derived_by_the_ensure() -> Bool {
  let ops = build_cache_ensure_ops_under_witness()
  string_contains(s: ops, pattern: "sha256sum")
    && !string_contains(s: ops, pattern: "path_authority=SHADOWED")
    && !string_contains(s: ops, pattern: "command -v sccache")
}

test fn design_witness_supervision_probe_not_derived_by_the_ensure() -> Bool {
  let ops = build_cache_ensure_ops_under_witness()
  string_contains(s: ops, pattern: "daemon-reload")
    && !string_contains(s: ops, pattern: "is-active")
    && !string_contains(s: ops, pattern: "pgrep")
}

// THE ENSURE'S DERIVED OPERATIONS, RENDERED FOR READING. The same builder the production oracles use, called
// with the sccache release's own boundary values and BOTH legs requested (install + unit + restart), so a
// probe hidden in a leg the witness did not ask for still shows up. The newline join is what stops an
// assertion matching across two words of one argv.
fn build_cache_ensure_ops_under_witness() -> String {
  build_cache_ensure_ops_rendered(
    instance: ci_cache_instance(host: "srv1"),
    arch_token: "aarch64" as NonEmptyStr,
    digest: sccache_release_0_15_0.digest_aarch64,
    install_needed: true,
  )
}

test fn design_witness_install_is_cited_not_package_manager() -> Bool {
  build_cache_install_is_cited_not_package_manager()
}

// The unit-body-specific construction checks formerly here (execstart-matches-install-path,
// foreground-supervised, daemon-runs-until-stopped, plus the RED-control unit_self_exiting_sketch
// fixture reproducing #7206's self-exiting unit) are DROPPED, not relocated, per the A5 grain swap
// (ProvisionBuildCache -> EnsureBuildCacheInstance): they asserted properties of
// gunbc.host_build_cache_provision_script's hand-rolled build_cache_systemd_user_unit_body, which
// no longer exists. The same properties are now independently regression-tested against the real
// render, gunbc.build_cache.build_cache_unit render_build_cache_unit, in test.claim.build_cache_ensure
// (witness_the_rendered_unit_is_foreground_supervised,
// witness_the_generated_unit_reproduces_the_captured_environment) — asserted against a live srv1
// capture (2026-08-01) rather than a hand-authored sketch, which is a stronger oracle than this
// file's own string-matching RED control ever was. The incident history (#7206, srv3 2026-07-25,
// Duration 10min 8.215s status 0) is preserved in gunbc.build_cache.build_cache_unit's own
// foreground_supervision_note, not duplicated here a second time.

fn unsupervised_observation_fixture() -> BuildCacheDaemonObservation {
  DaemonUnsupervised { unit: "sccache.service", unit_state: "inactive (dead)" }
}

test fn design_witness_unsupervised_refuses_fail_closed() -> Bool {
  match provision_build_cache_verdict(
    catalog_id: sccache_local_id,
    observed: unsupervised_observation_fixture(),
  ) {
    BuildCacheProvisionRefused { cause: RefusalDaemonUnsupervised, reason: reason } =>
      string_contains(s: reason as String, pattern: "sccache.service")
        && string_contains(s: reason as String, pattern: "inactive (dead)")
        && string_contains(s: reason as String, pattern: "Fail-closed")
    BuildCacheProvisionRefused { cause: _, reason: _ } => false
    BuildCacheProvisionConverged { catalog_id: _, stats_line: _ } => false
  }
}

test fn design_witness_red_control_widen_on_unsupervised_rejected_by_gate() -> Bool {
  match provision_build_cache_absorbing_fallback_widen_sketch(
    catalog_id: sccache_local_id,
    observed: unsupervised_observation_fixture(),
  ) {
    BuildCacheProvisionConverged { catalog_id: _, stats_line: _ } => true
    BuildCacheProvisionRefused { cause: _, reason: _ } => false
  } && !build_cache_provision_gate_accepts(
      catalog_id: sccache_local_id,
      verdict: provision_build_cache_absorbing_fallback_widen_sketch(
        catalog_id: sccache_local_id,
        observed: unsupervised_observation_fixture(),
      ),
      observed: unsupervised_observation_fixture(),
    )
    && build_cache_provision_gate_accepts(
      catalog_id: sccache_local_id,
      verdict: provision_build_cache_verdict(
        catalog_id: sccache_local_id,
        observed: unsupervised_observation_fixture(),
      ),
      observed: unsupervised_observation_fixture(),
    )
}

test fn design_witness_classifier_covers_every_cited_fragment() -> Bool {
  build_cache_classifier_covers_every_cited_fragment()
