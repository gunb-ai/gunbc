    ProvisionBuildCacheCatalogRefused { reason: _ } => true
    ProvisionBuildCacheCatalogRealizable => false
  }
}

test fn design_witness_known_non_sccache_catalog_refuses_at_gate() -> Bool {
  match provision_build_cache_catalog_gate_verdict(catalog_id: gha_actions_cache_id) {
    ProvisionBuildCacheCatalogRefused { reason: reason } =>
      string_contains(s: reason as String, pattern: "not yet realized")
    ProvisionBuildCacheCatalogRealizable => false
  }
}

test fn design_witness_known_non_sccache_catalog_refuses_at_verdict() -> Bool {
  match provision_build_cache_verdict(
    catalog_id: gha_actions_cache_id,
    observed: DaemonStatsOk {
      stats_line: "compile_requests=1",
      placement: ServerManagedUnitOwned { unit: managed_compile_pool_slice_fixture },
    },
  ) {
    BuildCacheProvisionRefused { cause: RefusalCatalogUnknown, reason: reason } =>
      string_contains(s: reason as String, pattern: "not yet realized")
    BuildCacheProvisionConverged { catalog_id: _, stats_line: _ } => false
    BuildCacheProvisionRefused { cause: RefusalDaemonAbsent, reason: _ } => false
    BuildCacheProvisionRefused { cause: RefusalDaemonUnresponsive, reason: _ } => false
    BuildCacheProvisionRefused { cause: RefusalDaemonMisconfigured, reason: _ } => false
    BuildCacheProvisionRefused { cause: RefusalPrivilegeDenied, reason: _ } => false
    BuildCacheProvisionRefused { cause: RefusalPathShadowed, reason: _ } => false
    BuildCacheProvisionRefused { cause: RefusalDaemonUnsupervised, reason: _ } => false
    BuildCacheProvisionRefused { cause: RefusalServerRunnerOwned, reason: _ } => false
    BuildCacheProvisionRefused { cause: RefusalPlacementUnknown, reason: _ } => false
  }
}

