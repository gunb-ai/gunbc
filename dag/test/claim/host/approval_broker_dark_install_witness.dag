data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn rev() -> ReleaseRevisionBinding {
  RevisionBoundAtEmission { revision: "0123456789abcdef0123456789abcdef01234567" }
}

fn step_of(s: DarkState) -> DarkInstallStep? {
  match s {
    DarkOk => none
    DarkFailed { step: st, reason: _ } => Present { value: st }
  }
}

fn leg_step(l: DarkLeg) -> DarkInstallStep {
  match l {
    DarkLegArgv { step: s, command: _ } => s
    DarkLegStdin { step: s, command: _, payload: _ } => s
    DarkLegExpectEmpty { step: s, command: _ } => s
    DarkLegSameHash { step: s, left: _, right: _ } => s
  }
}

// SUPPLIED SCRATCH: the sudoers legs are pure over the scratch directory the caller acquired, so the
// claim supplies it. Order is the contract: stage, visudo, install, policy, rename, policy, readback,
// compare -- the compare is LAST, so convergence is the independent readback.
test fn the_sudoers_legs_stage_check_install_and_end_with_the_readback_compare() -> Bool {
  let legs = dark_sudoers_legs(revision: rev(), principal: fleet_posix_ci_runner_principal(), scratch: "/tmp/s")
  count(legs) == 8
    && match legs |> first { Present { value: l } => leg_step(l: l) == DarkStepSudoersStage
      Absent => false }
}

test fn the_sudoers_legs_end_with_the_compare() -> Bool {
  let legs = dark_sudoers_legs(revision: rev(), principal: fleet_posix_ci_runner_principal(), scratch: "/tmp/s")
  match legs |> last {
    Present { value: l } => match l {
      DarkLegSameHash { step: s, left: a, right: b } => s == DarkStepSudoersCompare && a != b
      _ => false
    }
    Absent => false
  }
}

test fn the_unit_legs_enable_and_restart_only_the_broker_unit_after_a_daemon_reload() -> Bool {
  let steps = map(dark_unit_legs(spec: deployment_spec_srv1(), revision: rev()), l => leg_step(l: l))
  steps == [DarkStepSliceUnit, DarkStepBrokerUnit, DarkStepDaemonReload, DarkStepEnable, DarkStepRestart]
}

// THE FREEZE RED (carried over from the deleted script-text claim): the enable and restart legs name the
// broker unit and never the roadmap unit, so a stage that restarts gunbc-roadmap.service fails here.
test fn the_unit_legs_never_name_the_roadmap_unit() -> Bool {
  let legs = dark_unit_legs(spec: deployment_spec_srv1(), revision: rev())
  let broker = gunbc_approval_broker_unit_name
  let roadmap = deployment_spec_srv1().service.unit_name as NonEmptyStr
  let enable_broker = DarkLegArgv { step: DarkStepEnable, command: sudo_elevate_command(command: systemctl_enable_argv(unit: broker)) }
  let restart_broker = DarkLegArgv { step: DarkStepRestart, command: sudo_elevate_command(command: systemctl_restart_argv(unit: broker)) }
  let enable_roadmap = DarkLegArgv { step: DarkStepEnable, command: sudo_elevate_command(command: systemctl_enable_argv(unit: roadmap)) }
  let restart_roadmap = DarkLegArgv { step: DarkStepRestart, command: sudo_elevate_command(command: systemctl_restart_argv(unit: roadmap)) }
  any(legs, l => l == enable_broker) && any(legs, l => l == restart_broker)
    && !any(legs, l => l == enable_roadmap) && !any(legs, l => l == restart_roadmap)
}

test fn the_snapshot_readback_runs_two_bare_finds() -> Bool {
  count(dark_snapshot_readback_legs(dir: "/opt/gunbc/approval-broker-helpers/x")) == 2
}

// SUPPLIED OUTCOMES: the pure steps dark_run_leg delegates to are driven with supplied outcomes, so no
// transport runs. A failed state is absorbing (dark_run_leg returns it before any leg runs), so a later
// leg cannot decide the verdict: the first failing step is the one named.
fn failed_exit(code: Int) -> RunArgvTransportOutcome {
  RunArgvTransportObserved { observed: ShellExecObserved { success: false, exit_code: code, stdout: "", stderr: "boom" } }
}

test fn a_failing_leg_stops_the_line_at_its_step() -> Bool {
  let first = dark_expect_empty_state(step: DarkStepSnapshotReadback, outcome: failed_exit(code: 1))
  let after = dark_run_leg(state: first, leg: DarkLegSameHash { step: DarkStepSudoersCompare, left: "a", right: "b" }, transport: LocalShell)
  step_of(s: first) == Present { value: DarkStepSnapshotReadback } && after == first
}

test fn an_unhashable_pair_fails_the_compare() -> Bool {
  step_of(s: dark_same_hash_state(step: DarkStepSudoersCompare, left: "a", right: "b",
    agreement: Sha256SideUnobserved { side: SourceSide, cause: Sha256RunFailed { stderr: "no such file" } }))
    == Present { value: DarkStepSudoersCompare }
}

test fn an_agreeing_pair_and_an_empty_clean_run_are_ok() -> Bool {
  step_of(s: dark_same_hash_state(step: DarkStepSudoersCompare, left: "a", right: "b", agreement: Sha256Agrees)) == none
    && step_of(s: dark_expect_empty_state(step: DarkStepSnapshotReadback,
      outcome: RunArgvTransportObserved { observed: ShellExecObserved { success: true, exit_code: 0, stdout: "", stderr: "" } })) == none
}

// INHABITANCE ON THE REAL ROUTE (pairs the supplied-outcome controls above): from DarkOk, dark_run_leg
// takes each leg through its real arm and the real transport dispatch. EmitArtifactThenThinRun refuses
// typed argv without invoking a shell, so the route runs hermetically and the refusal must surface at
// the leg's own step. Rewiring an arm (DarkOk unconditionally, wrong helper, dropped outcome) fails here.
data refusing_transport: HostEffectTransport = EmitArtifactThenThinRun {
  bootstrap: BootstrapFragment { script: "true" },
  invocation: ThinInvocation { argv: ["true"] },
}

fn refused_step(l: DarkLeg) -> DarkInstallStep? {
  step_of(s: dark_run_leg(state: DarkOk, leg: l, transport: refusing_transport))
}

test fn dark_run_leg_routes_each_leg_through_the_transport_to_its_own_step() -> Bool {
  let cmd = find_untrusted_entries_command(roots: ["/nonexistent-w6b/none"], top_only: true, owner: "root")
  refused_step(l: DarkLegArgv { step: DarkStepEnable, command: cmd }) == Present { value: DarkStepEnable }
    && refused_step(l: DarkLegStdin { step: DarkStepSudoersStage, command: cmd, payload: "x" }) == Present { value: DarkStepSudoersStage }
    && refused_step(l: DarkLegExpectEmpty { step: DarkStepSnapshotReadback, command: cmd }) == Present { value: DarkStepSnapshotReadback }
    && refused_step(l: DarkLegSameHash { step: DarkStepSudoersCompare, left: "a", right: "b" }) == Present { value: DarkStepSudoersCompare }
}

test fn an_empty_leg_list_is_ok() -> Bool {
  step_of(s: dark_run_legs(legs: [], transport: LocalShell)) == none
}

// THE ROSTER IS A FreeSemigroup, SO THERE IS NO EMPTY-ROSTER ARM TO TEST ANY MORE -- `units: []`
// does not type-check. This claim used to have one (`SliceControlPlanNotOwed => count(legs(units:
// [])) == 0`), which was worse than useless: it asserted the shape of a value that cannot be built,
// and it turned srv1 losing its slice reservation into a PASSING arm. srv1 owns both the sessions
// slice and the broker slice, so a plan that is not Derived here means the fixture moved, and the
// claim must FAIL rather than wave it through.
//
// THE BOUND, AND WHY IT IS NOT JUST A COUNT. >= count(units) is the floor the projection must clear
// (each unit fans out to three argv legs -- revert, MemoryMax, MemoryHigh -- plus CPUQuota for the
// sessions unit), but a count alone is satisfiable by a projection that emits ALL of unit 1's legs and
// NONE of unit 2's, and by one that emits one leg per unit while dropping two per unit. So the total is
// pinned to the upstream producer the real fold enumerates over -- host_axis_caps
// .slice_control_converge_argvs_for_unit, the same leaf test.claim.host.sessions_slice_cpu_witness reads
// rather than re-deriving -- and every argv that producer derives for EVERY unit must appear among the
// emitted legs. Consequences: dropping the last leg fails the total; collapsing the roster to its first
// unit fails the per-unit coverage; and both fail whatever the fixture's roster size happens to be, so
// the claim does not silently weaken if srv1 gains or loses a slice.
test fn slice_control_legs_follow_the_derived_plan() -> Bool {
  match slice_control_plan_for(host: deployment_spec_srv1().target.host.identity) {
    SliceControlPlanDerived { units: us } =>
      let legs = dark_slice_control_legs(units: us)
      let roster = non_empty_to_list(xs: us)
      // Built the same way the sibling claim above builds its expected legs: take the argvs from the
      // upstream producer and wrap each with sudo_elevate_command. Comparing bare argvs would fail on
      // unmutated code, because the projection elevates every slice-control leg.
      let expected = flat_map(roster, u =>
        list_map(xs: slice_control_converge_argvs_for_unit(u: u), f: argv =>
          DarkLegArgv { step: DarkStepSliceControl, command: sudo_elevate_command(command: argv) }))
      count(legs) >= count(roster)
        && count(legs) == count(expected)
        && all(legs, l => leg_step(l: l) == DarkStepSliceControl)
        && all(expected, e => any(legs, l => l == e))
    SliceControlPlanNotOwed => false
    SliceControlPlanRefused { cause: _ } => false
  }
}

// INHABITANCE ON THE REAL ROUTE: a spec that does not own the host's broker reaches the real function
// and is refused at the OWNER step before any leg runs.
test fn the_real_route_refuses_a_non_owning_spec_at_the_owner_step() -> Bool {
  match approval_broker_dark_install(
    spec: selected_deployment_spec(row: srv1_lab_desired_deployment()),
    revision: rev(),
    principal: fleet_posix_ci_runner_principal(),
    source_root: "/nonexistent-w6b-source",
    transport: LocalShell,
  ) {
    DarkInstallRefused { step: s, reason: _ } => s == DarkStepOwner
    DarkInstallConverged { broker_tree_digest: _ } => false
  }
}

// ── THE SIDECAR PRECEDES THE BROKER SWAP (run 39545280023) ─────────────────────────────────────
// The release locus has two executable members, enumerated once; a roster naming only gunbc is the defect.
test fn the_broker_locus_enumerates_the_gunbc_and_sidecar_binaries() -> Bool {
  approval_broker_release_locus_executables == [gunbc_release_bin_name, approval_device_crypto_serve_release_bin_name]
}

fn sidecar_plan() -> List<DarkLeg> {
  dark_sidecar_legs(spec: deployment_spec_srv1(), revision: rev(), digest: "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef")
}

fn inputs() -> DarkInstallInputs {
  DarkInstallInputs { spec: deployment_spec_srv1(), revision: rev(), principal: fleet_posix_ci_runner_principal(), source_root: "/nonexistent-sidecar-source", transport: refusing_transport }
}

// POSITIVE CONTROL: the real sidecar plan is the sidecar sequence, and every one of its steps is ordered before the broker's unit legs.
test fn the_real_sidecar_plan_precedes_every_broker_unit_leg() -> Bool {
  let unit_steps = map(dark_unit_legs(spec: deployment_spec_srv1(), revision: rev()), l => leg_step(l: l))
  map(sidecar_plan(), l => leg_step(l: l)) == [DarkStepSidecarEnv, DarkStepSidecarUnit, DarkStepSidecarDaemonReload, DarkStepSidecarEnable, DarkStepSidecarRestart]
    && !any(unit_steps, u => any(map(sidecar_plan(), l => leg_step(l: l)), t => t == u))
}

// RED: a locus whose sidecar binary cannot be observed refuses at the sidecar digest, before any sidecar or broker leg.
test fn a_locus_missing_the_sidecar_binary_refuses_before_any_leg() -> Bool {
  match dark_stage_sidecar_digest(i: inputs(), tree_digest: "t") {
    DarkInstallRefused { step: s, reason: _ } => s == DarkStepSidecarDigest
    DarkInstallConverged { broker_tree_digest: _ } => false
  }
}

// POSITIVE CONTROL: with the sidecar digest in hand, the same transport is first reached at the sidecar's own first leg.
test fn a_present_sidecar_binary_reaches_the_first_sidecar_leg() -> Bool {
  match dark_stage_sidecar(i: inputs(), tree_digest: "t", deployed: "d") {
    DarkInstallRefused { step: s, reason: _ } => s == DarkStepSidecarEnv
    DarkInstallConverged { broker_tree_digest: _ } => false
  }
}
