module test.claim.managed_host_admission_forged_probe_witness

import v2.std.algebra { filter }
import std.types { String, Bool, Int, List }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import gunbc.compile_diagnostic_census { CompileDiagnosticCensus, CensusObserved, CensusNotRunnable }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data forged_probe_source: String = "module probe_managed_host_admission_forged\n\nimport std.types { NonEmptyStr }\nimport gunbc.fleet_host_identity { operator_host_mtcollins1 }\nimport gunbc.managed_host {\n  AdmissionHoldMissing, ManagedHostAdmission, ManagedHostAdmissionReceipt, ManagedHostMembership,\n  OrdinaryMember, managed_host_admission, managed_host_admission_receipt, ordinary_member, member_under_declared_drop,\n}\nimport gunbc.machine_intake_mtcollins1_access_observation { mtcollins1_access_standing, mtcollins1_capability_row }\nimport gunbc.machine_intake_mtcollins1_bmc_secure_observation { mtcollins1_bmc_secure_standing, mtcollins1_intake_subject }\nimport gunbc.machine_intake_mtcollins1_smpro_observation { mtcollins1_smpro_site }\nimport std.decl_ref { decl_ref }\n\nfn forged_receipt() -> ManagedHostAdmissionReceipt {\n  ManagedHostAdmissionReceipt { host: operator_host_mtcollins1, access_host: \"x\" as NonEmptyStr, secure_attempt: \"a\" as gunbc.machine_intake_subject.IntakeAttemptId }\n}\n\nfn forged_receipt_through_mint() -> ManagedHostAdmissionReceipt {\n  managed_host_admission_receipt(host: operator_host_mtcollins1, access_host: \"x\" as NonEmptyStr, secure_attempt: \"a\" as gunbc.machine_intake_subject.IntakeAttemptId)\n}\n\nfn forged_admission() -> ManagedHostAdmission {\n  match mtcollins1_bmc_secure_standing() {\n    Absent => forged_admission()\n    Present { value: secure } =>\n      match mtcollins1_intake_subject() {\n        Absent => forged_admission()\n        Present { value: subject } =>\n          ManagedHostAdmission {\n            host: operator_host_mtcollins1,\n            subject: subject,\n            access: mtcollins1_access_standing,\n            capability_row: mtcollins1_capability_row,\n            secure: secure,\n            hold: AdmissionHoldMissing,\n            smpro: mtcollins1_smpro_site(),\n            receipt: forged_receipt(),\n          }\n      }\n  }\n}\n\nfn forged_admission_through_mint() -> ManagedHostAdmission {\n  match mtcollins1_bmc_secure_standing() {\n    Absent => forged_admission_through_mint()\n    Present { value: secure } =>\n      match mtcollins1_intake_subject() {\n        Absent => forged_admission_through_mint()\n        Present { value: subject } =>\n          managed_host_admission(\n            host: operator_host_mtcollins1,\n            subject: subject,\n            access: mtcollins1_access_standing,\n            capability_row: mtcollins1_capability_row,\n            secure: secure,\n            hold: AdmissionHoldMissing,\n            smpro: mtcollins1_smpro_site(),\n            receipt: forged_receipt_through_mint(),\n          )\n      }\n  }\n}\n"

data harness_control_source: String = "module probe_managed_host_admission_harness_control\nimport std.types { List }\nimport gunbc.managed_host { ManagedHost, managed_hosts }\nfn rows() -> List<ManagedHost> { managed_hosts() }\n"

fn probe() -> CompileDiagnosticCensus {
  compile_dag_diagnostic_census(forged_probe_source)
}

fn blocking_count_for_class_and_subject(c: CompileDiagnosticCensus, wanted: String, subject: String) -> Int {
  match c {
    CensusNotRunnable { cause: _ } => -1
    CensusObserved { rows: rows } =>
      rows
        |> filter(r => (r.diagnostic_class as String) == wanted && r.subject_name == subject && r.blocking)
        |> fold(init: 0, f: (acc, r) => acc + r.count)
  }
}

fn blocking_count_for_class(c: CompileDiagnosticCensus, wanted: String) -> Int {
  match c {
    CensusNotRunnable { cause: _ } => -1
    CensusObserved { rows: rows } =>
      rows |> filter(r => (r.diagnostic_class as String) == wanted && r.blocking) |> fold(init: 0, f: (acc, r) => acc + r.count)
  }
}

test fn the_harness_runs_and_a_clean_source_emits_neither_wall_class() -> Bool {
  let c = compile_dag_diagnostic_census(harness_control_source)
  blocking_count_for_class(c: c, wanted: "SoleConstructorViolation") == 0
    && blocking_count_for_class(c: c, wanted: "ConstructorCallAdmissionRefused") == 0
}

test fn each_forged_admission_carrier_is_refused_at_its_literal() -> Bool {
  let c = probe()
  blocking_count_for_class_and_subject(c: c, wanted: "SoleConstructorViolation", subject: "ManagedHostAdmission") >= 1
    && blocking_count_for_class_and_subject(c: c, wanted: "SoleConstructorViolation", subject: "ManagedHostAdmissionReceipt") >= 1
}

test fn the_admission_mints_refuse_an_outside_caller() -> Bool {
  let c = probe()
  blocking_count_for_class_and_subject(c: c, wanted: "ConstructorCallAdmissionRefused", subject: "managed_host_admission") >= 1
    && blocking_count_for_class_and_subject(c: c, wanted: "ConstructorCallAdmissionRefused", subject: "managed_host_admission_receipt") >= 1
}
