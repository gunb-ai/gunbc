module test.claim.host_effect_plan_real_execution

import std.logic { Bool }
import std.types { NonEmptyStr }
import extdeps.access.posix_effective_principal { EffectivePosixPrincipalRead }
import gunbc.host_effect {
  ReadEffectivePosixPrincipal,
  SshShell,
  NodeControlPlane, HostOs,
  host_effect_identity_evidence,
  LocalShell,
}
import gunbc.host_effect_plan {
  HostEffectPlan, HostEffectPlanContext,
  host_effect_plan_apply,
}
import v2.std.effect_plan { EffectPlan, Do }
import v2.std.orchestration { FailFast }
import std.realization_reconcile { reconciliation_converged }
import gunbc.fleet_intent { srv1_host }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data real_execution_home_doc: String = "Wet execution witnesses for Wave A2 Do-effect leaves: typed effective-principal read (LocalShell whoami / unreachable SSH) through host_effect_plan_apply. Split out of host_effect_plan_witness_test.dag so hermetic per-PR discovery keeps the pure refusal poles; excluded from discovery (gunbc.ci_layer_roots witness_exclusion_substrings) and re-enrolled in bin_witness_wet_entries, same lane as host_build_cache_provision_real_execution_witness_test.dag."

fn witness_host_os_target() -> NodeControlPlane {
  HostOs { node: srv1_host }
}

fn witness_plan_ctx() -> HostEffectPlanContext {
  HostEffectPlanContext {
    target: witness_host_os_target(),
    evidence: host_effect_identity_evidence,
    transport: LocalShell,
  }
}

fn witness_single_do_true_plan() -> HostEffectPlan {
  EffectPlan {
    steps: [Do { effect: ReadEffectivePosixPrincipal { read: EffectivePosixPrincipalRead {} } }],
    on_failure: FailFast,
  }
}

fn witness_unreachable_plan_ctx() -> HostEffectPlanContext {
  HostEffectPlanContext {
    target: witness_host_os_target(),
    evidence: host_effect_identity_evidence,
    transport: SshShell { ssh_host: "203.0.113.1" as NonEmptyStr },
  }
}

fn witness_sequential_do_plan() -> HostEffectPlan {
  EffectPlan {
    steps: [
      Do { effect: ReadEffectivePosixPrincipal { read: EffectivePosixPrincipalRead {} } },
      Do { effect: ReadEffectivePosixPrincipal { read: EffectivePosixPrincipalRead {} } },
    ],
    on_failure: FailFast,
  }
}

test fn host_effect_plan_ssh_failure_reason_carries_exit_code_by_real_execution() -> Bool {
  match host_effect_plan_apply(
    plan: witness_single_do_true_plan(),
    ctx: witness_unreachable_plan_ctx(),
  ) {
    Converged { evidence: _, applied: _ } => false
    NotConverged { reason: r, applied: _ } => string_contains(s: r, pattern: "exit=255")
  }
}

test fn host_effect_plan_typed_read_witness_holds_by_real_execution() -> Bool {
  reconciliation_converged(r: host_effect_plan_apply(
    plan: witness_single_do_true_plan(),
    ctx: witness_plan_ctx(),
  ))
    && !reconciliation_converged(r: host_effect_plan_apply(
      plan: witness_single_do_true_plan(),
      ctx: witness_unreachable_plan_ctx(),
    ))
    && reconciliation_converged(r: host_effect_plan_apply(
      plan: witness_sequential_do_plan(),
      ctx: witness_plan_ctx(),
    ))
}
