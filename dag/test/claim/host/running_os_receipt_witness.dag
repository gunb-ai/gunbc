module test.claim.host.running_os_receipt_witness

import std.types { Bool, Int, String, NonEmptyStr, CommitSha }
import std.optional { Present, Absent }
import std.algebra { string_contains }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import product.host_identity { host_identity_eq }
import extdeps.github.workflow_runs { github_workflow_run_id_of_wire }
import gunbc.fleet.fleet_host_identity { operator_host_mtcollins1, operator_host_mtjade1 }
import gunbc.host.host_boot_id { host_boot_id_of_kernel_text }
import extdeps.github.workflow_runs { WorkflowRun, Completed, Success }
import gunbc.fleet.fleet_converge_run_name { fleet_converge_run_title }
import gunbc.fleet.fleet_converge_producer_run { ProducerRunSelected, ProducerRunNone }
import gunbc.fleet.fleet_host_identity { operator_host_srv1 }
import gunbc.host.running_os_receipt_observed { running_os_receipt_producer_select }
import gunbc.machine_intake.mtcollins1_boot_receipts { mtcollins1_running_os_receipt_source, mtcollins1_boot_mode_wire }
import gunbc.host.running_os { RunningOsReading, RunningOsObserved, RunningOsUnobserved, RunningDeliveredArtifact }
import gunbc.host.running_os_receipt {
  RunningOsReceiptProducer, RunningOsReceiptAdmitted, RunningOsReceiptRefused,
  RunningOsReceiptDigestMismatch, RunningOsReceiptOfAnotherRun, RunningOsReceiptMalformed,
  RunningOsReceiptFieldAbsent, RunningOsReceiptFieldRepeated, RunningOsReceiptLineUnexpected, RunningOsReceiptHostKeyUnchecked,
  running_os_receipt_text, running_os_receipt_reading, running_os_receipt_producer_of_run,
  RunningOsReceiptComposition, RunningOsReceiptComposed, RunningOsReceiptReadingUnobserved, RunningOsReceiptKeyOfAnotherBoot,
  running_os_receipt_content_digest,
}

import gunbc.host.per_boot_console_pin { CheckedHostKey, checked_host_key, per_boot_pin_from_checked_key }
import gunbc.host.anchored_host_transport { mtcollins1_anchored_host_row }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE RUNNING-OS RECEIPT (gunbc.host.running_os_receipt) at its one interface: a reading and the run that wrote it
// go in, the document comes out, and the reader given the run it was downloaded from gives the reading back or a
// typed refusal. The reading is a supplied value at this boundary; that the boot run's real producer emits it is
// the initialized-host witness's inhabitance claim (test.claim.host.initialized_host_witness), and that a receipt
// before a reboot or of another host refuses is that witness's two REDs, which run downstream of this reader.

data receipt_boot: String = "aaaaaaaa-0000-4000-8000-000000000001"

data receipt_digest: String = "4f3c2a1b0e9d8c7b6a5f4e3d2c1b0a9f8e7d6c5b4a3f2e1d0c9b8a7f6e5d4c3b"

fn producer(run: Int, attempt: Int) -> RunningOsReceiptProducer {
  running_os_receipt_producer_of_run(run: github_workflow_run_id_of_wire(n: run), attempt: attempt)
}

fn observed_reading() -> RunningOsReading {
  match host_boot_id_of_kernel_text(text: receipt_boot) {
    Absent => RunningOsUnobserved { cause: "the fixture boot id is not a uuid" }
    Present { value: b } => RunningOsObserved { running: RunningDeliveredArtifact { digest: receipt_digest as NonEmptyStr }, observed_host: operator_host_mtcollins1, observed_on: b }
  }
}

// THE BOOT'S HOST KEY, as the boot run's SOL reader checks it (gunbc.runner.runner_host_medium
// runner_host_checked_key_of): a supplied ed25519 public key and the fingerprint that names it, on a stated boot.
data receipt_key_b64: String = "AAAAC3NzaC1lZDI1NTE5AAAAIErU2itxhvGPRx1UxiuCYkikYIV9DtuXiELy64bQpAXL"
data receipt_key_fingerprint: String = "SHA256:hIxG0YT2jIxXbxs4XGqwehgoA63kxD4xKP2j6YjG86w"
data other_boot: String = "aaaaaaaa-0000-4000-8000-000000000002"

fn key_on(boot: String) -> CheckedHostKey? {
  checked_host_key(boot_id: boot as NonEmptyStr, key_type: "ssh-ed25519", key_b64: receipt_key_b64, fingerprint: receipt_key_fingerprint)
}

fn text_with_key_on(boot: String) -> RunningOsReceiptComposition? {
  match key_on(boot: boot) {
    Absent => none
    Present { value: k } => Present { value: running_os_receipt_text(producer: producer(run: 41000000001, attempt: 1), reading: observed_reading(), host_key: k) }
  }
}

fn written() -> String {
  match text_with_key_on(boot: receipt_boot) {
    Present { value: RunningOsReceiptComposed { text: t } } => t
    _ => ""
  }
}

// POSITIVE CONTROL: the document read back from the run that wrote it is the reading it was written from, field by
// field.
test fn a_receipt_reads_back_as_the_reading_it_was_written_from() -> Bool {
  match running_os_receipt_reading(text: written(), fetched_from: producer(run: 41000000001, attempt: 1)) {
    RunningOsReceiptAdmitted { reading: RunningOsObserved { running: RunningDeliveredArtifact { digest: d }, observed_host: h, observed_on: b }, host_key: k } =>
      (d as String) == receipt_digest && host_identity_eq(a: h, b: operator_host_mtcollins1) && (b.boot_id as String) == receipt_boot
        && (k.boot_id as String) == receipt_boot && k.key_type == "ssh-ed25519" && k.public_key_base64 == receipt_key_b64 && k.sha256_fingerprint == receipt_key_fingerprint
    _ => false
  }
}

// RED: one stated fact changed after writing (the host), the stated digest kept: the content no longer digests to
// it, so the document is not what its producer wrote, and no reading is admitted.
test fn a_receipt_whose_digest_does_not_match_its_content_refuses() -> Bool {
  let tampered = written().replace(from: "host=mtcollins1", to: "host=mtjade1")
  string_contains(s: tampered, pattern: "host=mtjade1")
    && match running_os_receipt_reading(text: tampered, fetched_from: producer(run: 41000000001, attempt: 1)) {
      RunningOsReceiptRefused { refusal: RunningOsReceiptDigestMismatch { stated: s, computed: c } } => s != c
      _ => false
    }
}

// RED: an intact document downloaded from another run (or another attempt of the same run) names a producer it
// was not fetched from, so it refuses.
test fn a_receipt_downloaded_from_another_run_refuses() -> Bool {
  (match running_os_receipt_reading(text: written(), fetched_from: producer(run: 41000000002, attempt: 1)) {
    RunningOsReceiptRefused { refusal: RunningOsReceiptOfAnotherRun { stated: s, fetched_from: _ } } => string_contains(s: s, pattern: "41000000001")
    _ => false
  })
    && (match running_os_receipt_reading(text: written(), fetched_from: producer(run: 41000000001, attempt: 2)) {
      RunningOsReceiptRefused { refusal: RunningOsReceiptOfAnotherRun { stated: _, fetched_from: _ } } => true
      _ => false
    })
}

// RED: an unobserved reading writes no document, and bytes with no digest line are not a receipt.
test fn an_unobserved_reading_has_no_receipt_and_undigested_bytes_are_not_one() -> Bool {
  (match key_on(boot: receipt_boot) {
    Absent => false
    Present { value: k } => match running_os_receipt_text(producer: producer(run: 41000000001, attempt: 1), reading: RunningOsUnobserved { cause: "supplied" }, host_key: k) {
      RunningOsReceiptReadingUnobserved { cause: c } => c == "supplied"
      _ => false
    }
  })
    && (match running_os_receipt_reading(text: "running_os_receipt\nhost=mtcollins1\n", fetched_from: producer(run: 41000000001, attempt: 1)) {
      RunningOsReceiptRefused { refusal: RunningOsReceiptMalformed { cause: _ } } => true
      _ => false
    })
}

// A DOCUMENT WHOSE DIGEST IS CONSISTENT WITH ITS CONTENT, built from the written body with that body edited: the
// digest is recomputed over the edited body, so the edit survives the digest check and reaches the field reader.
// This is the shape a writer defect (or a writer that appends rather than replaces) would upload.
fn redigested(edit: fn(String) -> String) -> String {
  match written().split(delimiter: "content_sha256=").first() {
    Absent => ""
    Present { value: body } => {
      let edited = edit(body)
      join([edited, "content_sha256=", running_os_receipt_content_digest(body: edited), "\n"], "")
    }
  }
}

// RED: a second host line after the first, digest-consistent. Reading the first line would admit mtcollins1
// whatever the second says; the field is stated twice, so the document refuses and names the field and the count.
test fn a_receipt_stating_its_host_twice_refuses_rather_than_reading_the_first() -> Bool {
  let doubled = redigested(edit: b => concat(b, "host=mtjade1\n"))
  string_contains(s: doubled, pattern: "host=mtcollins1\n")
    && string_contains(s: doubled, pattern: "host=mtjade1\n")
    && match running_os_receipt_reading(text: doubled, fetched_from: producer(run: 41000000001, attempt: 1)) {
      RunningOsReceiptRefused { refusal: RunningOsReceiptFieldRepeated { prefix: p, occurrences: n } } => p == "host=" && n == 2
      _ => false
    }
}

// RED: the producer is read by the same rule, so a second run line naming another run cannot be shadowed by a
// first that matches the run the document was fetched from.
test fn a_receipt_stating_its_producer_run_twice_refuses() -> Bool {
  match running_os_receipt_reading(text: redigested(edit: b => concat(b, "producer_run=41000000002\n")), fetched_from: producer(run: 41000000001, attempt: 1)) {
    RunningOsReceiptRefused { refusal: RunningOsReceiptFieldRepeated { prefix: p, occurrences: n } } => p == "producer_run=" && n == 2
    _ => false
  }
}

// RED: a digest-consistent document that lost its host line refuses with the field it lacks.
test fn a_digest_consistent_receipt_without_its_host_line_refuses() -> Bool {
  match running_os_receipt_reading(text: redigested(edit: b => b.replace(from: "host=mtcollins1\n", to: "")), fetched_from: producer(run: 41000000001, attempt: 1)) {
    RunningOsReceiptRefused { refusal: RunningOsReceiptFieldAbsent { prefix: p } } => p == "host="
    _ => false
  }
}

// RED: the same field stated twice with the SAME value is still a repeat. The writer states each field once, so an
// identical second line is not this document either.
test fn a_receipt_stating_its_host_twice_identically_refuses() -> Bool {
  match running_os_receipt_reading(text: redigested(edit: b => concat(b, "host=mtcollins1\n")), fetched_from: producer(run: 41000000001, attempt: 1)) {
    RunningOsReceiptRefused { refusal: RunningOsReceiptFieldRepeated { prefix: p, occurrences: n } } => p == "host=" && n == 2
    _ => false
  }
}

// RED: a digest-consistent line the writer never states refuses and names the line, so the document cannot carry a
// fact no reader checks.
test fn a_receipt_carrying_a_line_its_writer_never_states_refuses() -> Bool {
  match running_os_receipt_reading(text: redigested(edit: b => concat(b, "trusted=yes\n")), fetched_from: producer(run: 41000000001, attempt: 1)) {
    RunningOsReceiptRefused { refusal: RunningOsReceiptLineUnexpected { line: l } } => l == "trusted=yes"
    _ => false
  }
}

// THE PRODUCER RUN IS FOUND BY ITS EXECUTOR, NOT ITS SUBJECT (review side chat, P1a). The mtcollins1 boot is
// dispatched with host srv1 (gunbc.machine_intake.mtcollins1_boot_admission mtcollins1_boot_dispatch_host), and the
// workflow titles the run from that input, so every admissible producer is titled with srv1. The run below is
// titled by the REAL title constructor for mode mtcollins1_boot and host srv1, completed, successful, on main; the
// mtcollins1 receipt source selects it. RED: the same run titled with the subject (mtcollins1) -- what the reader
// searched for before -- is a title no admitted boot writes, and the source does not select it.
fn boot_run(id: Int, title_host: String) -> WorkflowRun {
  WorkflowRun {
    id: id,
    name: Absent,
    display_title: Present { value: fleet_converge_run_title(mode: mtcollins1_boot_mode_wire, host: title_host, nonce: "n1") },
    path: Absent,
    head_sha: "1111111111111111111111111111111111111111" as CommitSha,
    head_branch: Present { value: "main" },
    event: "workflow_dispatch",
    status: Completed,
    conclusion: Present { value: Success },
    workflow_id: 9,
    run_number: 1,
    run_attempt: 1,
    actor: Absent,
    triggering_actor: Absent,
    html_url: "https://github.com/gunb-ai/gunbc/actions/runs/1" as NonEmptyStr,
    created_at: "2026-11-07T00:00:00Z",
    updated_at: "2026-11-07T00:00:00Z",
    pull_requests: [],
  }
}

test fn the_mtcollins1_receipt_source_selects_the_boot_run_dispatched_on_srv1() -> Bool {
  (match running_os_receipt_producer_select(source: mtcollins1_running_os_receipt_source, runs: [boot_run(id: 41000000001, title_host: operator_host_srv1 as String)]) {
    ProducerRunSelected { run: _, attempt: _, created_at: _ } => true
    ProducerRunNone { cause: _ } => false
  })
    && (match running_os_receipt_producer_select(source: mtcollins1_running_os_receipt_source, runs: [boot_run(id: 41000000002, title_host: operator_host_mtcollins1 as String)]) {
      ProducerRunNone { cause: _ } => true
      ProducerRunSelected { run: _, attempt: _, created_at: _ } => false
    })
    && host_identity_eq(a: mtcollins1_running_os_receipt_source.host, b: operator_host_mtcollins1)
}

// THE PIN ROUND-TRIPS (operator decision 2026-11-08: mtcollins1's host trust is the per-boot pin). The key the boot
// run wrote comes back checked, on the receipt's observed boot, and the pin minted from it through the pin's only
// mint (gunbc.host.per_boot_console_pin per_boot_pin_from_checked_key) names that boot and that key -- the pin the
// consumer authenticates the host by (gunbc.host.anchored_host_transport anchored_host_transport_live_per_boot).
test fn the_receipt_round_trips_the_per_boot_pin() -> Bool {
  match running_os_receipt_reading(text: written(), fetched_from: producer(run: 41000000001, attempt: 1)) {
    RunningOsReceiptAdmitted { reading: _, host_key: k } => {
      let pin = per_boot_pin_from_checked_key(row: mtcollins1_anchored_host_row, parsed: k)
      (pin.boot_id as String) == receipt_boot
        && pin.anchor.public_key_base64 == receipt_key_b64
        && pin.anchor.sha256_fingerprint == receipt_key_fingerprint
    }
    _ => false
  }
}

// RED: a key checked on another boot than the one the reading observed is not written beside it. The receipt states
// one boot; a running OS paired with another boot's key would let a pin vouch for a boot it was never printed on.
test fn a_key_from_another_boot_is_not_written_into_the_receipt() -> Bool {
  (match text_with_key_on(boot: other_boot) {
    Present { value: RunningOsReceiptKeyOfAnotherBoot { observed_on: o, key_checked_on: k } } => o == receipt_boot && k == other_boot
    _ => false
  })
    && string_contains(s: written(), pattern: "host_key_sha256=")
}

// RED: the fingerprint changed after writing and the digest recomputed over the edit (what a writer defect would
// upload): the digest holds, but the fingerprint no longer names the blob, so the key does not check and the
// receipt refuses -- no pin is minted from it.
test fn a_digest_consistent_receipt_whose_fingerprint_does_not_name_its_key_refuses() -> Bool {
  let tampered = redigested(edit: b => b.replace(from: concat("host_key_sha256=", receipt_key_fingerprint), to: "host_key_sha256=SHA256:hIxG0YT2jIxXbxs4XGqwehgoA63kxD4xKP2j6YjG86x"))
  string_contains(s: tampered, pattern: "86x\n")
    && match running_os_receipt_reading(text: tampered, fetched_from: producer(run: 41000000001, attempt: 1)) {
      RunningOsReceiptRefused { refusal: RunningOsReceiptHostKeyUnchecked { key_type: _, fingerprint: fp } } => string_contains(s: fp, pattern: "86x")
      _ => false
    }
}

// RED: a digest-consistent receipt that lost its key line refuses with the field it lacks, so a receipt without a
// pin never admits a reading a consumer would then try to authenticate with nothing.
test fn a_digest_consistent_receipt_without_its_host_key_line_refuses() -> Bool {
  match running_os_receipt_reading(text: redigested(edit: b => b.replace(from: concat("host_key_base64=", receipt_key_b64, "\n"), to: "")), fetched_from: producer(run: 41000000001, attempt: 1)) {
    RunningOsReceiptRefused { refusal: RunningOsReceiptFieldAbsent { prefix: p } } => p == "host_key_base64="
    _ => false
  }
}
