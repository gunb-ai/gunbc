        Absent => false
        Present { value: why } => string_contains(s: why, pattern: "/opt/gunbc|d|0755")
      }
  }
}

// PARTITION: an arbitrary file at the locus root that no writer of this locus declared is REFUSED by
// name -- not silently dropped. The complete fixture agreed, so this refusal is solely the rogue file.
test fn unexpected_file_at_locus_root_is_refused() -> Bool {
  let owner = gnbc()
  let with_rogue = concat(broker_complete_children(owner: owner), [rentry("rogue", TreeRegular, "755", root_owner())])
  match broker_agree(children_observed: with_rogue, spine_observed: broker_complete_spine(owner: owner), owner: owner, permitted: approval_broker_sibling_writer_footprint()) {
    Absent => false
    Present { value: why } => string_contains(s: why, pattern: "unexpected entry rogue")
  }
}

// PARTITION: a stray sibling of the src/v2 walk root (src/extra) is REFUSED, not tolerated, even though
// the walk parent's listing is folded into the same observation.
test fn stray_file_under_walk_parent_is_refused() -> Bool {
  let owner = gnbc()
  let with_stray = concat(broker_complete_children(owner: owner), [rentry("src/extra", TreeRegular, "644", owner)])
  match broker_agree(children_observed: with_stray, spine_observed: broker_complete_spine(owner: owner), owner: owner, permitted: approval_broker_sibling_writer_footprint()) {
    Absent => false
    Present { value: why } => string_contains(s: why, pattern: "unexpected entry src/extra")
  }
}

// PARTITION: the installer's own receipt is permitted and never required (absent on a first install).
test fn receipt_absent_still_agrees_and_present_tolerated() -> Bool {
  let owner = gnbc()
  let without_receipt = [
    rentry("dag", TreeDirectory, "755", owner),
    rentry("src", TreeDirectory, "755", owner),
    rentry("src/v2", TreeDirectory, "755", owner),
    rentry("gunbc", TreeRegular, "755", owner),
    rentry("approval_device_crypto_serve", TreeRegular, "755", owner),
    rentry("device-crypto-deployed-digest.env", TreeRegular, "644", owner),
  ]
  match broker_agree(children_observed: without_receipt, spine_observed: broker_complete_spine(owner: owner), owner: owner, permitted: approval_broker_sibling_writer_footprint()) {
    Present { value: _ } => false
    Absent => true
  }
}

// PARTITION + PER-LOCUS AUTHORITY: the device-crypto env file is tolerated ONLY because the broker
// footprint declares it. Feed the SAME observation to a locus given the EMPTY footprint (a helper
// locus gets only the receipt) and the very same env file is refused by name -- broker exceptions do
// not authorize a name in the helper locus.
test fn sibling_footprint_authorizes_its_own_locus_only() -> Bool {
  let owner = gnbc()
  match broker_agree(children_observed: broker_complete_children(owner: owner), spine_observed: broker_complete_spine(owner: owner), owner: owner, permitted: approval_broker_sibling_writer_footprint()) {
    Present { value: _ } => false
    Absent =>
      match broker_agree(children_observed: broker_complete_children(owner: owner), spine_observed: broker_complete_spine(owner: owner), owner: owner, permitted: []) {
        Absent => false
        Present { value: why } => string_contains(s: why, pattern: "unexpected entry device-crypto-deployed-digest.env")
      }
  }
}

// THE MICROVM LOCUS: its declared sibling footprint (vmm receipt, images/, firecracker, jailer, the
// two workspace-commissioning members) is tolerated, root-owned, and the agreement still holds. This is
// the real srv1 microvm root listing, fed through the one authority.
test fn microvm_footprint_tolerates_its_members() -> Bool {
  let owner = root_owner()
  let observed = [
    rentry("dag", TreeDirectory, "755", owner),
    rentry("src", TreeDirectory, "755", owner),
    rentry("src/v2", TreeDirectory, "755", owner),
    rentry("gunbc", TreeRegular, "755", owner),
    rentry(".gunbc-tree-receipt", TreeRegular, "644", owner),
    rentry(".gunbc-vmm-receipt", TreeRegular, "644", owner),
    rentry("images", TreeDirectory, "755", owner),
    rentry("firecracker", TreeRegular, "755", owner),
    rentry("jailer", TreeRegular, "755", owner),
    rentry("workspace-commissioning-helper", TreeRegular, "755", owner),
    rentry("workspace-commissioning-executor.sh", TreeRegular, "755", owner),
  ]
  match tree_locus_children_expectation_owned(subdirs: release_locus_tree_subdirs, executables: [gunbc_release_bin_name], owner: owner) {
    Absent => false
    Present { value: locus_expected } =>
      match tree_walk_root_expectation_owned(subdirs: release_locus_tree_subdirs, owner: owner) {
        Absent => false
        Present { value: wr_expected } =>
          match tree_spine_expectation_owned(spine: ctl_spine, locus: ctl_locus, owner: owner) {
            Absent => false
            Present { value: spine_expected } =>
              match tree_locus_agreement(
                source_expected: [], source_observed: [],
                locus_children_expected: locus_expected,
                locus_children_observed: observed,
                walk_root_expected: wr_expected,
                spine_expected: spine_expected,
                spine_observed: broker_complete_spine(owner: owner),
                permitted_extras: microvm_controller_sibling_writer_footprint(),
              ) {
                Present { value: _ } => false
                Absent => true
              }
          }
      }
  }
}

