}

// THE PRODUCTION ROSTER: approval_device_crypto_serve is installer-owned and REQUIRED -- its absence is
// a missing entry (refused), not a tolerated extra. This is the point the earlier witness got wrong.
test fn roster_executable_absent_is_refused() -> Bool {
  let owner = gnbc()
  let without_serve = [
    rentry("dag", TreeDirectory, "755", owner),
    rentry("src", TreeDirectory, "755", owner),
    rentry("src/v2", TreeDirectory, "755", owner),
    rentry("gunbc", TreeRegular, "755", owner),
    rentry(".gunbc-tree-receipt", TreeRegular, "644", owner),
    rentry("device-crypto-deployed-digest.env", TreeRegular, "644", owner),
  ]
  match broker_agree(children_observed: without_serve, spine_observed: broker_complete_spine(owner: owner), owner: owner, permitted: approval_broker_sibling_writer_footprint()) {
    Absent => false
    Present { value: why } => string_contains(s: why, pattern: "approval_device_crypto_serve")
  }
}

// THE PRODUCTION ROSTER, positive: with both executables present the broker locus agrees (asserts the
// roster is exactly [gunbc, approval_device_crypto_serve] and both are checked).
test fn roster_has_two_executables() -> Bool {
  count(broker_execs) == 2
    && any(broker_execs, e => e == gunbc_release_bin_name)
    && any(broker_execs, e => e == approval_device_crypto_serve_release_bin_name)
}

// THE WIRE FORMAT: real `find -printf '%P|%y|%m|%u|%g|%l|%s'` output for the locus root, fed through the
// production collector (tree_metadata_entries_of_stdout) into the one authority, agrees. No exec.
test fn captured_find_wire_output_flows_through_the_authority() -> Bool {
  let owner = gnbc()
  let wire = "dag|d|755|gunbc|gunbc||4096\nsrc|d|755|gunbc|gunbc||4096\nsrc/v2|d|755|gunbc|gunbc||4096\ngunbc|f|755|gunbc|gunbc||2048\napproval_device_crypto_serve|f|755|gunbc|gunbc||2048\n.gunbc-tree-receipt|f|644|gunbc|gunbc||256\ndevice-crypto-deployed-digest.env|f|644|gunbc|gunbc||64\n"
  let parsed = tree_metadata_entries_of_stdout(stdout: wire, sub: "", starting_point_expected: false)
  match tree_locus_children_expectation_owned(subdirs: release_locus_tree_subdirs, executables: broker_execs, owner: owner) {
    Absent => false
    Present { value: locus_expected } =>
      match tree_walk_root_expectation_owned(subdirs: release_locus_tree_subdirs, owner: owner) {
        Absent => false
        Present { value: wr_expected } =>
          match tree_spine_expectation_owned(spine: ctl_spine, locus: ctl_locus, owner: owner) {
            Absent => false
            Present { value: spine_expected } =>
              match tree_locus_agreement(
                source_expected: [], source_observed: [],
                locus_children_expected: locus_expected,
                locus_children_observed: parsed,
                walk_root_expected: wr_expected,
                spine_expected: spine_expected,
                spine_observed: broker_complete_spine(owner: owner),
                permitted_extras: approval_broker_sibling_writer_footprint(),
              ) {
                Present { value: _ } => false
                Absent => true
              }
          }
      }
  }
}

// THE PARTITION ITSELF, named and consumed: tree_locus_children_partition keeps expected + permitted and
// refuses the unexpected, returning the kept set and the refusal in one decision.
test fn partition_classifies_expected_permitted_and_unexpected() -> Bool {
  let owner = gnbc()
  match tree_locus_children_expectation_owned(subdirs: release_locus_tree_subdirs, executables: broker_execs, owner: owner) {
    Absent => false
    Present { value: locus_expected } =>
      match tree_walk_root_expectation_owned(subdirs: release_locus_tree_subdirs, owner: owner) {
        Absent => false
        Present { value: wr_expected } =>
          match tree_locus_children_partition(
            locus_children_expected: locus_expected,
            walk_root_expected: wr_expected,
            permitted_extras: approval_broker_sibling_writer_footprint(),
            observed: concat(broker_complete_children(owner: owner), [rentry("rogue", TreeRegular, "755", owner)]),
          ) {
            TreeLocusChildrenPartition { kept: kept, refusal: refusal } =>
              (match refusal { Present { value: _ } => true Absent => false }) && count(kept) == 5
          }
      }
  }
}

// THE WALK PARENTS for the fixed release_locus_tree_subdirs: "src" (parent of "src/v2"), nothing for "dag".
test fn walk_parents_of_the_installed_subs_is_src() -> Bool {
  tree_walk_parents(subs: release_locus_tree_subdirs) == ["src"]
}

// THE SELF-METADATA PARSER reuses the one seven-field grammar; the queried path in %p must match.
test fn self_metadata_parses_directory_and_rejects_mismatch() -> Bool {
  match tree_self_metadata_entry_of_stdout(stdout: "/opt/gunbc|d|755|gunbc|gunbc||4096\n", path: "/opt/gunbc") {
    Absent => false
    Present { value: e } => e.path == "/opt/gunbc" && is_dir(e.kind) && file_mode_octal(mode: e.mode) == "0755"
  }
    && match tree_self_metadata_entry_of_stdout(stdout: "/other|d|755|gunbc|gunbc||4096\n", path: "/opt/gunbc") { Absent => true _ => false }
    && match tree_self_metadata_entry_of_stdout(stdout: "", path: "/x") { Absent => true _ => false }
}

// THE NEW FIND BUILDERS: the direct-children and self-metadata walks the readback runs are the real
// `find` argv, one maxdepth-1 walk and one maxdepth-0 stat, both under the shared seven-field printf
// the parser (tree_metadata_entries_of_stdout / tree_self_metadata_entry_of_stdout) consumes. These
// are the read-only observation commands the production readback dispatches (extdeps/tools/findutils,
// registered in extdeps/exec/command.dag); on a live locus they run over the read-only route -- no
// sudo -- exactly as find_tree_entry_metadata_command already does in the claim above.
test fn direct_children_and_self_find_builders_are_readonly_find_argv() -> Bool {
  let dc = find_direct_children_metadata_command(root: "/locus")
  let dcn = find_direct_children_count_command(root: "/locus")
  let tc = find_tree_entry_count_command(root: "/locus")
  let sf = find_self_metadata_command(path: "/locus")
  (dc.program.invocation as String) == "find"
    && dc.arguments == ["/locus", "-mindepth", "1", "-maxdepth", "1", "-xdev", "-printf", "%P|%y|%m|%u|%g|%l|%s\\n"]
    && dcn.program.invocation as String == "find"
    && dcn.arguments == ["/locus", "-mindepth", "1", "-maxdepth", "1", "-xdev", "-printf", "."]
    && tc.program.invocation as String == "find"
    && tc.arguments == ["/locus", "-xdev", "-printf", "."]
    && (sf.program.invocation as String) == "find"
    && sf.arguments == ["/locus", "-maxdepth", "0", "-xdev", "-printf", "%p|%y|%m|%u|%g|%l|%s\\n"]
    && find_tree_entry_metadata_printf() == "%P|%y|%m|%u|%g|%l|%s\\n"
    && find_self_metadata_printf == "%p|%y|%m|%u|%g|%l|%s\\n"
}

// THE SELF PRINTER REBASES ON %p (the queried path), the DIRECT-CHILDREN PRINTER ON %P (path under the
// root): the two walks differ exactly in that field, and the self parser requires the %p line to carry
// the queried path -- so a self walk cannot be answered by a %P-style line.
test fn self_printer_carries_queried_path_and_rebases_on_percent_p() -> Bool {
  find_self_metadata_printf == "%p|%y|%m|%u|%g|%l|%s\\n"
    && match tree_self_metadata_entry_of_stdout(stdout: "/locus/sub|f|755|root|root||12\n", path: "/locus/sub") {
      Present { value: e } => e.path == "/locus/sub" && file_mode_octal(mode: e.mode) == "0755"
      Absent => false
    }
    // a %P-style line (empty path) is refused by the self parser, not silently accepted
    && match tree_self_metadata_entry_of_stdout(stdout: "|f|755|root|root||12\n", path: "/locus/sub") { Absent => true _ => false }
}

// ===========================================================================
// CAPTURED SRV1 LIVE-LOCUS LISTINGS (read-only capture on srv1 2026-11-23 ~13:2xZ, via sudo find, the
// builders' printf formats verbatim -- the children listings AND the -maxdepth 0 self rows are real
// captured output; the children listings are the -mindepth 1 form production now collects, paired with a
// matching `-printf .` dot string). Each listing is fed through the PRODUCTION checked collector
// (tree_metadata_entries_of_stdout_checked) and the PRODUCTION self-parser (tree_self_metadata_entry_of_stdout) into the ONE agreement authority
// (tree_locus_agreement), with each locus's PRODUCTION roster, footprint and owner. These are the live loci
// a redeploy at the same SHA would re-read -- so AGREE is the false-refuse guard (gap 3), and the executable
// / spine / subtree-root rows are gap 1/2 on real data. The source-tree comparison (source_*) is left empty:
// these captures cover the LOCUS-ROOT observation the readback was missing (gaps 1-3), not the recursive
// content readback that already runs. The starting-point row find prints with an EMPTY %P ("|d|...") is
// present verbatim in every children listing and is skipped by rule (see the claim at the end).
// ===========================================================================

data srv1_broker_base: String = "/opt/gunbc/approval-broker"
data srv1_broker_releases: String = "/opt/gunbc/approval-broker/releases"
data srv1_broker_locus: String = "/opt/gunbc/approval-broker/releases/7711690f3f55ae40d41fbee3fc856e13b65c3c95"
data srv1_microvm_base: String = "/opt/gunbc/microvm-controller"
data srv1_microvm_releases: String = "/opt/gunbc/microvm-controller/releases"
data srv1_microvm_locus: String = "/opt/gunbc/microvm-controller/releases/e1f753b939169c51050f90a2912832b3c5b0b5ae"
data srv1_helper_base: String = "/opt/gunbc/approval-broker-helpers"
data srv1_helper_locus: String = "/opt/gunbc/approval-broker-helpers/66474e06a94499cd062e10290826cccb5a18b70a"

// children listings, as PRODUCTION now collects them: `find <root> -mindepth 1 -maxdepth 1` (the manager's
// option-(b) framing fix), i.e. the srv1 capture with the starting point's own "|d|..." row REMOVED -- find
// under -mindepth 1 does not print the starting point at all, so the child listing carries no empty-%P row
// to skip. The `_dots` fixtures are the matching `-printf .` enumeration (one dot per entry); the collector
// refuses unless the dot count equals the number of printed rows. These represent real srv1 output at this
// shape; a listing whose dots and rows disagree is a framing attack and is refused.
data srv1_broker_children: String = "approval_device_crypto_serve|f|755|briansrls|briansrls||3537656\ndag|d|755|briansrls|briansrls||4096\ndevice-crypto-deployed-digest.env|f|644|briansrls|briansrls||101\ngunbc|f|755|briansrls|briansrls||40996456\n.gunbc-tree-receipt|f|644|briansrls|briansrls||223\nsrc|d|755|briansrls|briansrls||4096\n"
data srv1_broker_children_dots: String = "......"
data srv1_broker_src_children: String = "v2|d|755|briansrls|briansrls||4096\n"
data srv1_broker_src_children_dots: String = "."
data srv1_microvm_children: String = "dag|d|755|root|root||4096\nfirecracker|f|755|root|root||3254360\ngunbc|f|755|root|root||40987856\n.gunbc-tree-receipt|f|644|root|root||142\n.gunbc-vmm-receipt|f|644|root|root||311\nimages|d|755|root|root||4096\njailer|f|755|root|root||1916808\nsrc|d|755|root|root||4096\nworkspace-commissioning-executor.sh|f|755|root|root||3821\nworkspace-commissioning-helper|f|755|root|root||526\n"
data srv1_microvm_children_dots: String = ".........."
data srv1_microvm_src_children: String = "v2|d|755|root|root||4096\n"
data srv1_microvm_src_children_dots: String = "."
data srv1_helper_children: String = "dag|d|755|root|root||4096\ngunbc|f|755|root|root||40133624\n.gunbc-tree-receipt|f|644|root|root||142\nsrc|d|755|root|root||4096\n"
data srv1_helper_children_dots: String = "...."
data srv1_helper_src_children: String = "v2|d|755|root|root||4096\n"
data srv1_helper_src_children_dots: String = "."

// REAL captured find -maxdepth 0 self rows for the production spine [base_root, releases_dir] + locus.
data srv1_broker_base_self: String = "/opt/gunbc/approval-broker|d|755|briansrls|briansrls||4096"
data srv1_broker_releases_self: String = "/opt/gunbc/approval-broker/releases|d|755|briansrls|briansrls||4096"
data srv1_broker_locus_self: String = "/opt/gunbc/approval-broker/releases/7711690f3f55ae40d41fbee3fc856e13b65c3c95|d|755|briansrls|briansrls||4096"
data srv1_microvm_base_self: String = "/opt/gunbc/microvm-controller|d|755|root|root||4096"
data srv1_microvm_releases_self: String = "/opt/gunbc/microvm-controller/releases|d|755|root|root||4096"
data srv1_microvm_locus_self: String = "/opt/gunbc/microvm-controller/releases/e1f753b939169c51050f90a2912832b3c5b0b5ae|d|755|root|root||4096"
data srv1_helper_base_self: String = "/opt/gunbc/approval-broker-helpers|d|755|root|root||4096"
data srv1_helper_locus_self: String = "/opt/gunbc/approval-broker-helpers/66474e06a94499cd062e10290826cccb5a18b70a|d|755|root|root||4096"

fn srv1_root_owner() -> PosixOwnerNames {
  PosixOwnerNames { user: "root" as NonEmptyStr, group: "root" as NonEmptyStr }
}
fn srv1_briansrls_owner() -> PosixOwnerNames {
  PosixOwnerNames { user: "briansrls" as NonEmptyStr, group: "briansrls" as NonEmptyStr }
}

// Parse one REAL captured self row through the production self parser (which insists %p == the queried path).
fn srv1_self(path: String, row: String) -> Optional<TreeMetadataEntry> {
  tree_self_metadata_entry_of_stdout(stdout: join([row, "\n"], ""), path: path)
}

// Drive one locus through the ONE authority. The direct-children and walk-parent (src) listings go
// through the PRODUCTION checked collector (tree_metadata_entries_of_stdout_checked) with their
// independent dot count and starting_point_expected=false (production children use -mindepth 1, so a
// malformed or forged row there refuses, exactly as the live readback). spine = production ancestor dirs;
// spine_observed = the parsed captured self rows for those dirs + the locus. Returns the agreement reason
// (Absent == agreed); a collector refusal is surfaced as the reason.
fn srv1_agree(
  children: String,
  children_dots: String,
  parent_children: String,
  parent_children_dots: String,
  spine: List<String>,
  locus: String,
  spine_observed: List<TreeMetadataEntry>,
  executables: List<String>,
  owner: PosixOwnerNames,
  permitted: List<String>,
) -> Optional<String> {
  match tree_metadata_entries_of_stdout_checked(root: locus, stdout: children, dot_stdout: children_dots, sub: "", starting_point_expected: false) {
    TreeMetadataObservationFailed { reason: r } => Present { value: r }
    TreeMetadataObserved { entries: locus_es } =>
      match tree_metadata_entries_of_stdout_checked(root: join([locus, "/src"], ""), stdout: parent_children, dot_stdout: parent_children_dots, sub: "src", starting_point_expected: false) {
        TreeMetadataObservationFailed { reason: r2 } => Present { value: r2 }
        TreeMetadataObserved { entries: parent_es } =>
          match tree_locus_children_expectation_owned(subdirs: release_locus_tree_subdirs, executables: executables, owner: owner) {
            Absent => Present { value: "locus-children-expectation-unbuildable" }
            Present { value: locus_children_expected } =>
              match tree_walk_root_expectation_owned(subdirs: release_locus_tree_subdirs, owner: owner) {
                Absent => Present { value: "walk-root-expectation-unbuildable" }
                Present { value: walk_root_expected } =>
                  match tree_spine_expectation_owned(spine: spine, locus: locus, owner: owner) {
                    Absent => Present { value: "spine-expectation-unbuildable" }
                    Present { value: spine_expected } =>
                      tree_locus_agreement(
                        source_expected: [],
                        source_observed: [],
                        locus_children_expected: locus_children_expected,
                        locus_children_observed: concat(left: locus_es, right: parent_es),
                        walk_root_expected: walk_root_expected,
                        spine_expected: spine_expected,
                        spine_observed: spine_observed,
                        permitted_extras: permitted,
                      )
                  }
              }
          }
      }
  }
}

// THE SRV1 BROKER LOCUS AGREES: same-byte executables at 0755/briansrls, spine [approval-broker,
// approval-broker/releases] + locus + subtree roots all at the shared mode, and its declared sibling
// (device-crypto env) plus the receipt tolerated. A redeploy at this SHA would re-read exactly this.
test fn srv1_broker_locus_agrees() -> Bool {
  let owner = srv1_briansrls_owner()
  match srv1_self(path: srv1_broker_base, row: srv1_broker_base_self) {
    Absent => false
    Present { value: a } =>
      match srv1_self(path: srv1_broker_releases, row: srv1_broker_releases_self) {
        Absent => false
        Present { value: b } =>
          match srv1_self(path: srv1_broker_locus, row: srv1_broker_locus_self) {
            Absent => false
            Present { value: c } =>
              match srv1_agree(
                children: srv1_broker_children, children_dots: srv1_broker_children_dots,
                parent_children: srv1_broker_src_children, parent_children_dots: srv1_broker_src_children_dots,
                spine: [srv1_broker_base, srv1_broker_releases], locus: srv1_broker_locus, spine_observed: [a, b, c],
                executables: approval_broker_release_locus_executables, owner: owner, permitted: approval_broker_sibling_writer_footprint(),
              ) { Present { value: _ } => false Absent => true }
          }
      }
  }
}

// THE SRV1 MICROVM LOCUS AGREES: all root-owned, with its declared sibling footprint (vmm receipt, images/,
// firecracker, jailer, the two commissioning members) and the receipt tolerated.
test fn srv1_microvm_locus_agrees() -> Bool {
  let owner = srv1_root_owner()
  match srv1_self(path: srv1_microvm_base, row: srv1_microvm_base_self) {
    Absent => false
    Present { value: a } =>
      match srv1_self(path: srv1_microvm_releases, row: srv1_microvm_releases_self) {
        Absent => false
        Present { value: b } =>
          match srv1_self(path: srv1_microvm_locus, row: srv1_microvm_locus_self) {
            Absent => false
            Present { value: c } =>
              match srv1_agree(
                children: srv1_microvm_children, children_dots: srv1_microvm_children_dots,
                parent_children: srv1_microvm_src_children, parent_children_dots: srv1_microvm_src_children_dots,
                spine: [srv1_microvm_base, srv1_microvm_releases], locus: srv1_microvm_locus, spine_observed: [a, b, c],
                executables: [gunbc_release_bin_name], owner: owner, permitted: microvm_controller_sibling_writer_footprint(),
              ) { Present { value: _ } => false Absent => true }
          }
      }
  }
}

// THE SRV1 HELPER LOCUS AGREES: given ONLY the receipt (permitted_extras = []); its listing holds only
// dag, src, gunbc and the receipt. Its production spine is [approval-broker-helpers] + the locus.
test fn srv1_helper_locus_agrees() -> Bool {
  let owner = srv1_root_owner()
  match srv1_self(path: srv1_helper_base, row: srv1_helper_base_self) {
    Absent => false
    Present { value: a } =>
      match srv1_self(path: srv1_helper_locus, row: srv1_helper_locus_self) {
        Absent => false
        Present { value: c } =>
          match srv1_agree(
            children: srv1_helper_children, children_dots: srv1_helper_children_dots,
            parent_children: srv1_helper_src_children, parent_children_dots: srv1_helper_src_children_dots,
            spine: [srv1_helper_base], locus: srv1_helper_locus, spine_observed: [a, c],
            executables: [gunbc_release_bin_name], owner: owner, permitted: [],
          ) { Present { value: _ } => false Absent => true }
      }
  }
}

// THE FALSE-REFUSE GUARD, inverted: the SAME broker listing with ONE extra bare file under src/ (a stray
// sibling of src/v2) REFUSES, naming the path -- a broker/microvm exception never authorizes it.
test fn srv1_broker_extra_under_src_refuses_by_name() -> Bool {
  let owner = srv1_briansrls_owner()
  match srv1_self(path: srv1_broker_base, row: srv1_broker_base_self) {
    Absent => false
    Present { value: a } =>
      match srv1_self(path: srv1_broker_releases, row: srv1_broker_releases_self) {
        Absent => false
        Present { value: b } =>
          match srv1_self(path: srv1_broker_locus, row: srv1_broker_locus_self) {
            Absent => false
            Present { value: c } =>
              match srv1_agree(
                children: srv1_broker_children, children_dots: srv1_broker_children_dots,
                parent_children: join([srv1_broker_src_children, "stray|f|644|briansrls|briansrls||12\n"], ""), parent_children_dots: "..",
                spine: [srv1_broker_base, srv1_broker_releases], locus: srv1_broker_locus, spine_observed: [a, b, c],
                executables: approval_broker_release_locus_executables, owner: owner, permitted: approval_broker_sibling_writer_footprint(),
              ) {
                Absent => false
                Present { value: why } => string_contains(s: why, pattern: "unexpected entry src/stray")
              }
          }
      }
  }
}

// B1 REFUSAL (root): a rogue child at the locus root whose NAME starts with "|" -- a line the delimiter
// grammar cannot name. It is NOT the starting-point record (which is empty %P over exactly 7 fields), so it
// reaches the validated collector, the printed/parsed counts disagree, and the OBSERVATION is REFUSED -- not
// dropped. This is the exact false-pass the reviewer reproduced with `sudo find ... |rogue`.
test fn pipe_named_root_child_refuses_the_observation() -> Bool {
  match tree_metadata_entries_of_stdout_checked(
    root: srv1_broker_locus,
    stdout: join([srv1_broker_children, "|rogue|f|755|root|root||4096\n"], ""),
    dot_stdout: ".......",
    sub: "",
    starting_point_expected: false,
  ) {
    TreeMetadataObserved { entries: _ } => false
    TreeMetadataObservationFailed { reason: r } => string_contains(s: r, pattern: "cannot name") && string_contains(s: r, pattern: "|rogue|f|755|root|root||4096")
  }
}

// B1 REFUSAL (walk parent): the same, under the src walk parent -- "src/|extra" must not vanish.
test fn pipe_named_walk_parent_child_refuses_the_observation() -> Bool {
  match tree_metadata_entries_of_stdout_checked(
    root: join([srv1_broker_locus, "/src"], ""),
    stdout: join([srv1_broker_src_children, "|extra|f|644|briansrls|briansrls||12\n"], ""),
    dot_stdout: "..",
    sub: "src",
    starting_point_expected: false,
  ) {
    TreeMetadataObserved { entries: _ } => false
    TreeMetadataObservationFailed { reason: r } => string_contains(s: r, pattern: "cannot name") && string_contains(s: r, pattern: "|extra|f|644|briansrls|briansrls||12")
  }
}

// THE CLEAN LISTINGS VALIDATE (the guard is not a blanket failure): the real broker children and src
// listings pass the collector+guard and yield exactly the expected real entries (starting point skipped).
test fn clean_srv1_listings_pass_the_validated_collector() -> Bool {
  match tree_metadata_entries_of_stdout_checked(root: srv1_broker_locus, stdout: srv1_broker_children, dot_stdout: srv1_broker_children_dots, sub: "", starting_point_expected: false) {
    TreeMetadataObservationFailed { reason: _ } => false
    TreeMetadataObserved { entries: broker } =>
      count(broker) == 6
        && match tree_metadata_entries_of_stdout_checked(root: join([srv1_broker_locus, "/src"], ""), stdout: srv1_broker_src_children, dot_stdout: srv1_broker_src_children_dots, sub: "src", starting_point_expected: false) {
          TreeMetadataObservationFailed { reason: _ } => false
          TreeMetadataObserved { entries: src } => count(src) == 1 && any(src, e => e.path == "src/v2")
        }
  }
}

// THE STARTING-POINT ROW, handled deliberately, and ONLY where it legitimately occurs: the FULL-subtree
// walk (`find <root>`, starting_point_expected=true) prints the walk root itself as a row with an EMPTY %P
// ("|d|..."). It is the ONLY "|"-leading row that is skipped -- by the narrow predicate (empty path over
// exactly seven fields), NOT a broad "starts with |" filter. Here the 6 real broker children are parsed
// WITH a prepended starting-point row: the starting row is skipped (6 survive, none with an empty path) and
// a "|rogue" child is NOT a starting point (it must reach the collector and be refused).
test fn starting_point_empty_percent_p_row_is_skipped_by_rule() -> Bool {
  let with_start = join(["|d|755|root|root||4096\n", srv1_broker_children], "")
  let parsed = tree_metadata_entries_of_stdout(stdout: with_start, sub: "", starting_point_expected: true)
  count(parsed) == 6
    && !any(parsed, e => e.path == "")
    && any(parsed, e => e.path == "dag")
    && any(parsed, e => e.path == "src")
    && any(parsed, e => e.path == "gunbc")
    && any(parsed, e => e.path == "approval_device_crypto_serve")
    && any(parsed, e => e.path == "device-crypto-deployed-digest.env")
    && any(parsed, e => e.path == ".gunbc-tree-receipt")
    && tree_metadata_line_is_starting_point(line: "|d|755|root|root||4096")
    && !tree_metadata_line_is_starting_point(line: "|rogue|f|755|root|root||4096")
}

// THE WALK PARENTS PER SUB (closes the reviewer's not-checked item): tree_walk_parents yields the parent
// directory for a multicomponent sub and NOTHING for a single-component sub, never the sub itself.
test fn walk_parents_are_the_parent_of_multicomponent_subs_only() -> Bool {
  tree_walk_parents(subs: ["src/v2"]) == ["src"]
    && tree_walk_parents(subs: ["dag"]) == []
    && tree_walk_parents(subs: release_locus_tree_subdirs) == ["src"]
    && !any(tree_walk_parents(subs: release_locus_tree_subdirs), p => p == "dag" || p == "src/v2" || p == "v2")
    && tree_walk_parents(subs: ["src/v2", "src/v2"]) == ["src"]
}

// ============================================================================================
// P2 NEWLINE FRAMING — regressions on REAL `find` output through the PRODUCTION checked
// collector. Fixtures are authentic `find <dir> -mindepth 1 -maxdepth 1 -xdev -printf
// '%P|%y|%m|%u|%g|%l|%s\n'` stdout captured locally, with the matching `-printf .` dot string
// from the independent count command. Names were created byte-exact with python3 (a file/dir
// literally named LF; a file named `x|f|755|u|g||0<LF>foo`). None is elevation, none is srv1/srv2.
// ============================================================================================

// A FILE NAMED WITH A NEWLINE at the locus root: its record's embedded LF makes find print an
// empty line plus an EMPTY-REL row "|f|644|node|node||1". With the skip rule removed (child listing,
// starting_point_expected=false) that row is unnameable -> the naming guard refuses it by text, and
// the row does NOT vanish (dots 5 == rows 5, so the framing guard agrees and naming still fires).
data fr_root_nl_file: String = "\n|f|644|node|node||1\n.gunbc-tree-receipt|f|644|node|node||1\ndag|d|755|node|node||4096\ngunbc|f|755|node|node||1\nsrc|d|755|node|node||4096\n"
test fn newline_named_file_at_root_refuses() -> Bool {
  match tree_metadata_entries_of_stdout_checked(root: srv1_broker_locus, stdout: fr_root_nl_file, dot_stdout: ".....", sub: "", starting_point_expected: false) {
    TreeMetadataObserved { entries: _ } => false
    TreeMetadataObservationFailed { reason: r } => string_contains(s: r, pattern: "cannot name") && string_contains(s: r, pattern: "|f|644|node|node||1")
  }
}

// A DIRECTORY NAMED WITH A NEWLINE at the locus root: same mechanism, the injected row is "|d|...".
data fr_root_nl_dir: String = "\n|d|755|node|node||4096\n.gunbc-tree-receipt|f|644|node|node||1\ndag|d|755|node|node||4096\ngunbc|f|755|node|node||1\nsrc|d|755|node|node||4096\n"
test fn newline_named_directory_at_root_refuses() -> Bool {
  match tree_metadata_entries_of_stdout_checked(root: srv1_broker_locus, stdout: fr_root_nl_dir, dot_stdout: ".....", sub: "", starting_point_expected: false) {
    TreeMetadataObserved { entries: _ } => false
    TreeMetadataObservationFailed { reason: r } => string_contains(s: r, pattern: "cannot name") && string_contains(s: r, pattern: "|d|755|node|node||4096")
  }
}

// A FILE NAMED WITH A NEWLINE under the src walk parent: the injected empty-rel row must refuse there too.
data fr_src_nl_file: String = "v2|d|755|node|node||4096\n\n|f|644|node|node||1\n"
test fn newline_named_file_under_src_refuses() -> Bool {
  match tree_metadata_entries_of_stdout_checked(root: join([srv1_broker_locus, "/src"], ""), stdout: fr_src_nl_file, dot_stdout: "..", sub: "src", starting_point_expected: false) {
    TreeMetadataObserved { entries: _ } => false
    TreeMetadataObservationFailed { reason: r } => string_contains(s: r, pattern: "cannot name") && string_contains(s: r, pattern: "|f|644|node|node||1")
  }
}

// A DIRECTORY NAMED WITH A NEWLINE under the src walk parent.
data fr_src_nl_dir: String = "v2|d|755|node|node||4096\n\n|d|755|node|node||4096\n"
test fn newline_named_directory_under_src_refuses() -> Bool {
  match tree_metadata_entries_of_stdout_checked(root: join([srv1_broker_locus, "/src"], ""), stdout: fr_src_nl_dir, dot_stdout: "..", sub: "src", starting_point_expected: false) {
    TreeMetadataObserved { entries: _ } => false
    TreeMetadataObservationFailed { reason: r } => string_contains(s: r, pattern: "cannot name") && string_contains(s: r, pattern: "|d|755|node|node||4096")
  }
}

// A CRAFTED NAME CONTAINING "|" AND A NEWLINE (`x|f|755|u|g||0<LF>foo`): find prints ONE dot for the
// one entry but the LF splits its record into TWO well-formed rows -- a forged mode-755 owner-u/g file
// "x" plus "foo". Both parse, so only the INDEPENDENT dot count (5 dots vs 6 rows) reveals the forgery.
data fr_root_crafted: String = "x|f|755|u|g||0\nfoo|f|644|node|node||1\n.gunbc-tree-receipt|f|644|node|node||1\ndag|d|755|node|node||4096\ngunbc|f|755|node|node||1\nsrc|d|755|node|node||4096\n"
test fn crafted_pipe_and_newline_name_refuses_by_framing() -> Bool {
  match tree_metadata_entries_of_stdout_checked(root: srv1_broker_locus, stdout: fr_root_crafted, dot_stdout: ".....", sub: "", starting_point_expected: false) {
    TreeMetadataObserved { entries: _ } => false
    TreeMetadataObservationFailed { reason: r } => string_contains(s: r, pattern: "dot enumeration counted") && string_contains(s: r, pattern: "forges extra rows") && string_contains(s: r, pattern: "x|f|755|u|g||0")
  }
}
