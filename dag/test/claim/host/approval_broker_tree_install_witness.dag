data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// SUPPLIED BOUNDARY VALUES: what `find ... -exec sha256sum {} +` prints for a source root and for the
// installed release directory. No exec; the values are the interface's inputs (DESIGN section 3).
data hex_a: String = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
data hex_b: String = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
data hex_c: String = "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"

data source_stdout: String = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa  /src/dag/gunbc/x.dag\nbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb  /src/dag/y.dag\n"

data installed_same_stdout: String = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb  /opt/r/dag/y.dag\naaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa  /opt/r/dag/gunbc/x.dag\n"

data installed_one_differs_stdout: String = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb  /opt/r/dag/y.dag\ncccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc  /opt/r/dag/gunbc/x.dag\n"

fn source_entries() -> List<TreeFileHash> {
  tree_file_hashes_of_stdout(stdout: source_stdout, root: "/src/dag", sub: "dag")
}

test fn parse_rebases_absolute_paths_onto_the_subdirectory() -> Bool {
  let es = source_entries()
  count(es) == 2 && tree_hash_lines(entries: es) == join([hex_a, "  dag/gunbc/x.dag\n", hex_b, "  dag/y.dag\n"], "")
}

test fn same_content_in_a_different_order_agrees() -> Bool {
  tree_entries_agree(
    source: source_entries(),
    installed: tree_file_hashes_of_stdout(stdout: installed_same_stdout, root: "/opt/r/dag", sub: "dag"),
  )
}

// THE DISCRIMINATING RED: one installed file's bytes differ, so the readback must refuse.
test fn one_installed_file_differing_does_not_agree() -> Bool {
  !tree_entries_agree(
    source: source_entries(),
    installed: tree_file_hashes_of_stdout(stdout: installed_one_differs_stdout, root: "/opt/r/dag", sub: "dag"),
  )
}

test fn a_missing_installed_file_does_not_agree() -> Bool {
  !tree_entries_agree(
    source: source_entries(),
    installed: tree_file_hashes_of_stdout(stdout: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb  /opt/r/dag/y.dag\n", root: "/opt/r/dag", sub: "dag"),
  )
}

test fn directories_are_ancestors_parents_first() -> Bool {
  tree_ancestor_directories(files: source_entries()) == ["dag", "dag/gunbc"]
}

fn refused_at(v: ApprovalBrokerTreeInstallVerdict, at: TreeInstallStep) -> Bool {
  match v {
    TreeInstallRefused { step: s, reason: _ } => s == at
    TreeInstallConverged { installed_digest: _, files_installed: _ } => false
  }
}

// INHABITANCE CLAIM ON THE REAL ROUTE: the real function runs the real LocalShell find|sha256sum
// argv against a root that does not exist and must refuse AT the source observation, before any
// sudo install is attempted. Deleting the observation leg makes this claim fail.
test fn the_real_route_refuses_at_source_observe_for_a_missing_source_root() -> Bool {
  refused_at(v: approval_broker_tree_install(
    owner: "gunbc" as NonEmptyStr,
    base_root: "/nonexistent-w6-base",
    source_root: "/nonexistent-w6-source",
    revision: RevisionBoundAtEmission { revision: "0123456789abcdef0123456789abcdef01234567" },
    executables: approval_broker_release_locus_executables,
    transport: one_transport_route(transport: LocalShell),
  ), at: TreeStepSourceObserve)
}

test fn an_unbound_revision_refuses_before_any_observation() -> Bool {
  refused_at(v: approval_broker_tree_install(
    owner: "gunbc" as NonEmptyStr,
    base_root: "/nonexistent-w6-base",
    source_root: "/nonexistent-w6-source",
    revision: RevisionNotInstalled,
    executables: approval_broker_release_locus_executables,
    transport: one_transport_route(transport: LocalShell),
  ), at: TreeStepRevision)
}

// A binary that cannot be hashed on either side is a disagreement (the real LocalShell sha256sum fails),
// and the disagreement names the unobserved side.
test fn a_binary_with_no_readable_hash_does_not_agree() -> Bool {
  match tree_binary_agreement(source_path: "/nonexistent-w6-source/a", installed_path: "/nonexistent-w6-base/a", transport: one_transport_route(transport: LocalShell)) {
    Sha256SideUnobserved { side: SourceSide, cause: _ } => true
    Sha256SideUnobserved { side: InstalledSide, cause: _ } => false
    Sha256Agrees => false
    Sha256Differs => false
  }
}

fn observed_out(stdout: String, success: Bool, stderr: String) -> RunArgvTransportOutcome {
  RunArgvTransportObserved { observed: ShellExecObserved { exit_code: if success { 0 } else { 1 }, success: success, stdout: stdout, stderr: stderr } }
}

fn obs_of(stdout: String) -> Sha256Observation {
  sha256_observation_of_outcome(outcome: observed_out(stdout: stdout, success: true, stderr: ""))
}

fn is_refused(o: Sha256Observation, want: String) -> Bool {
  match o {
    Sha256Unobserved { cause: Sha256TransportRefused { reason: r } } => r == want
    Sha256Unobserved { cause: Sha256RunFailed { stderr: _ } } => false
    Sha256Unobserved { cause: Sha256LineUnparsed { stdout: _ } } => false
    Sha256Observed { digest: _ } => false
  }
}

fn is_failed(o: Sha256Observation, want: String) -> Bool {
  match o {
    Sha256Unobserved { cause: Sha256RunFailed { stderr: e } } => e == want
    Sha256Unobserved { cause: Sha256TransportRefused { reason: _ } } => false
    Sha256Unobserved { cause: Sha256LineUnparsed { stdout: _ } } => false
    Sha256Observed { digest: _ } => false
  }
}

fn is_unparsed(o: Sha256Observation, want: String) -> Bool {
  match o {
    Sha256Unobserved { cause: Sha256LineUnparsed { stdout: t } } => t == want
    Sha256Unobserved { cause: Sha256TransportRefused { reason: _ } } => false
    Sha256Unobserved { cause: Sha256RunFailed { stderr: _ } } => false
    Sha256Observed { digest: _ } => false
  }
}

test fn each_unobserved_cause_is_distinct() -> Bool {
  is_refused(o: sha256_observation_of_outcome(outcome: RunArgvTransportRefused { reason: "no session" }), want: "no session")
    && is_failed(o: sha256_observation_of_outcome(outcome: observed_out(stdout: "", success: false, stderr: "boom")), want: "boom")
    && is_unparsed(o: obs_of(stdout: "garbage"), want: "garbage")
}

test fn two_equal_observations_agree_and_two_different_differ() -> Bool {
  let a = obs_of(stdout: hex_a)
  let same = sha256_observations_agreement(source: a, installed: obs_of(stdout: hex_a))
  let diff = sha256_observations_agreement(source: a, installed: obs_of(stdout: hex_b))
  (match same {
    Sha256Agrees => true
    Sha256Differs => false
    Sha256SideUnobserved { side: _, cause: _ } => false
  }) && (match diff {
    Sha256Differs => true
    Sha256Agrees => false
    Sha256SideUnobserved { side: _, cause: _ } => false
  })
}

test fn an_unobserved_side_disagrees_with_its_cause_preserved() -> Bool {
  let bad = sha256_observation_of_outcome(outcome: observed_out(stdout: "", success: false, stderr: "boom"))
  match sha256_observations_agreement(source: obs_of(stdout: hex_a), installed: bad) {
    Sha256SideUnobserved { side: InstalledSide, cause: Sha256RunFailed { stderr: e } } => e == "boom"
    Sha256SideUnobserved { side: SourceSide, cause: _ } => false
    Sha256SideUnobserved { side: InstalledSide, cause: Sha256TransportRefused { reason: _ } } => false
    Sha256SideUnobserved { side: InstalledSide, cause: Sha256LineUnparsed { stdout: _ } } => false
    Sha256Agrees => false
    Sha256Differs => false
  }
}

// ==================== THE METADATA READ (S2) ====================
// A content hash cannot see entry KINDS: find -type f skips links and directories, so a payload link
// was invisible to both sides of tree_entries_agree. These claims witness the metadata read that
// closes that hole: the parser of find's seven-field lines, the canonical text the readback compares,
// the expectation that fixes kinds/targets/modes/ownership as receipted facts, and the argv rows that
// copy a link AS a link. Supplied boundary values throughout -- no exec.


// One file, one link with a stored target, one directory, and the starting point's OWN row (the
// `%P` field empty) that must be excluded from entries and from the count guard alike.
data metadata_stdout: String = "gunbc/x.dag|f|644|gunbc|gunbc|123|\nlink|l|777|gunbc|gunbc|0|/usr/bin/python3\ndir|d|755|gunbc|gunbc|4096|\n|d|700|root|root|4096|\n"

fn metadata_entries() -> List<TreeMetadataEntry> {
  tree_metadata_entries_of_stdout(stdout: metadata_stdout, sub: "dag")
}

test fn metadata_parse_keeps_kinds_targets_and_rebases_onto_the_subdirectory() -> Bool {
  let es = metadata_entries()
  count(es) == 3
    && tree_metadata_entry_line(entry: es_skip_none_head(es)) == "dag/link|l|777|gunbc|gunbc|0|/usr/bin/python3"
    && tree_metadata_list_contains(lines: list_map(xs: es, f: e => tree_metadata_entry_line(entry: e)), line: "dag/dir|d|755|gunbc|gunbc")
    && !tree_metadata_list_contains(lines: list_map(xs: es, f: e => tree_metadata_entry_line(entry: e)), line: "|d|700|root|root")
}

// THE FIRST ENTRY OF THE PARSED LIST IS THE LINK ONLY AFTER SORTING; take it by a fold that keeps
// the sole SymlinkEntryKind line, so no index operator is needed.
fn es_skip_none_head(es: List<TreeMetadataEntry>) -> TreeMetadataEntry {
  fold(es, init: TreeMetadataEntry { path: "", kind: RegularEntryKind, mode: "", owner: "", group: "" }, f: (acc, e) =>
    match e.kind { SymlinkEntryKind { target: _ } => e, _ => acc })
}

// THE GRAMMAR REFUSES WHAT IT CANNOT NAME: an unknown type char, an empty link target, a non-octal
// mode, and a target carrying the field delimiter (eight fields) all parse to nothing, which the
// count guard in observe turns into a refusal -- never a silently dropped entry.
test fn the_metadata_grammar_refuses_what_it_cannot_name() -> Bool {
  match tree_metadata_entry_of_line(line: "x|q|644|gunbc|gunbc|1|", sub: "dag") { Absent => true, Present { value: _ } => false }
    && match tree_metadata_entry_of_line(line: "x|l|777|gunbc|gunbc|0|", sub: "dag") { Absent => true, Present { value: _ } => false }
    && match tree_metadata_entry_of_line(line: "x|f|6x4|gunbc|gunbc|1|", sub: "dag") { Absent => true, Present { value: _ } => false }
    && match tree_metadata_entry_of_line(line: "x|l|777|gunbc|gunbc|0|a|b", sub: "dag") { Absent => true, Present { value: _ } => false }
    && match tree_metadata_entry_of_line(line: "|d|755|root|root|4096|", sub: "dag") { Absent => true, Present { value: _ } => false }
}

// THE EXPECTATION IS THE INSTALL'S OWN CONTRACT: kinds and link targets survive from the source
// UNCHANGED; modes and ownership come from the shared spellings the install steps pass, never from
// the source's own (the source is the operator's checkout).
test fn the_expectation_fixes_kind_target_shared_mode_and_deploy_owner() -> Bool {
  let src = [
    TreeMetadataEntry { path: "dag/a.dag", kind: RegularEntryKind, mode: "600", owner: "operator", group: "operator" },
    TreeMetadataEntry { path: "dag/link", kind: SymlinkEntryKind { target: "/usr/bin/python3" }, mode: "777", owner: "operator", group: "operator" },
    TreeMetadataEntry { path: "dag/empty-dir", kind: DirectoryEntryKind, mode: "700", owner: "operator", group: "operator" },
  ]
  tree_metadata_lines(entries: tree_installed_expectation(entries: src, owner: "gunbc" as NonEmptyStr))
    == "dag/a.dag|f|644|gunbc|gunbc\ndag/empty-dir|d|755|gunbc|gunbc\ndag/link|l|777|gunbc|gunbc|/usr/bin/python3\n"
}

// THE EMITTED TEXT IS DETERMINISTIC: the same entries, enumerated twice (as the plan and the
// readback each do), digest the same because they SPELL the same -- sorted, newline-terminated.
test fn metadata_lines_are_sorted_and_stable_across_emissions() -> Bool {
  let src = [
    TreeMetadataEntry { path: "dag/z", kind: DirectoryEntryKind, mode: "755", owner: "gunbc", group: "gunbc" },
    TreeMetadataEntry { path: "dag/a", kind: RegularEntryKind, mode: "644", owner: "gunbc", group: "gunbc" },
  ]
  tree_metadata_lines(entries: src) == tree_metadata_lines(entries: [src_skip(src, "dag/z"), src_head(src, "dag/z")])
    && tree_metadata_lines(entries: src) == "dag/a|f|644|gunbc|gunbc\ndag/z|d|755|gunbc|gunbc\n"
}

fn src_head(src: List<TreeMetadataEntry>, wanted: String) -> TreeMetadataEntry {
  fold(src, init: TreeMetadataEntry { path: "", kind: RegularEntryKind, mode: "", owner: "", group: "" }, f: (acc, e) => if e.path == wanted { e } else { acc })
}

fn src_skip(src: List<TreeMetadataEntry>, unwanted: String) -> List<TreeMetadataEntry> {
  fold(src, init: [], f: (acc, e) => if e.path == unwanted { acc } else { acc.append(e) })
}

// THE VANISHING SYMLINK GOES RED: a source link absent from the installed tree, and its evil twin --
// the link silently MATERIALIZED as a regular file by a copy that followed it -- both refuse, naming
// the entry. Before this read, both passed: the hash enumeration never saw the link on either side.
test fn a_vanishing_or_materialized_symlink_is_red() -> Bool {
  let src = [TreeMetadataEntry { path: "dag/link", kind: SymlinkEntryKind { target: "x" }, mode: "777", owner: "operator", group: "operator" }]
  let expected = tree_installed_expectation(entries: src, owner: "gunbc" as NonEmptyStr)
  let vanished: List<TreeMetadataEntry> = []
  let materialized = [TreeMetadataEntry { path: "dag/link", kind: RegularEntryKind, mode: "644", owner: "gunbc", group: "gunbc" }]
  match tree_metadata_disagreement(expected: expected, observed: vanished) {
    Present { value: v1 } =>
      starts_with(s: v1, prefix: "missing entry dag/link|l|")
        && match tree_metadata_disagreement(expected: expected, observed: materialized) {
          Present { value: v2 } => starts_with(s: v2, prefix: "missing entry dag/link|l|")
          Absent => false
        }
    Absent => false
  }
}

// RE-POINTED, RELAXED, OR RE-OWNED ALL REFUSE: the stored target, the shared mode, and the deploy
// owner are each facts the receipt certifies, not accidents of the copy tool.
test fn a_repointed_remodeled_or_reowned_entry_is_red() -> Bool {
  let src = [
    TreeMetadataEntry { path: "dag/link", kind: SymlinkEntryKind { target: "/usr/bin/python3" }, mode: "777", owner: "operator", group: "operator" },
    TreeMetadataEntry { path: "dag/a.dag", kind: RegularEntryKind, mode: "644", owner: "operator", group: "operator" },
  ]
  let expected = tree_installed_expectation(entries: src, owner: "gunbc" as NonEmptyStr)
  let repointed = [
    TreeMetadataEntry { path: "dag/link", kind: SymlinkEntryKind { target: "/tmp/evil" }, mode: "777", owner: "gunbc", group: "gunbc" },
    TreeMetadataEntry { path: "dag/a.dag", kind: RegularEntryKind, mode: "644", owner: "gunbc", group: "gunbc" },
  ]
  let relaxed = [
    TreeMetadataEntry { path: "dag/link", kind: SymlinkEntryKind { target: "/usr/bin/python3" }, mode: "777", owner: "gunbc", group: "gunbc" },
    TreeMetadataEntry { path: "dag/a.dag", kind: RegularEntryKind, mode: "666", owner: "gunbc", group: "gunbc" },
  ]
  let reowned = [
    TreeMetadataEntry { path: "dag/link", kind: SymlinkEntryKind { target: "/usr/bin/python3" }, mode: "777", owner: "root", group: "root" },
    TreeMetadataEntry { path: "dag/a.dag", kind: RegularEntryKind, mode: "644", owner: "gunbc", group: "gunbc" },
  ]
  match tree_metadata_disagreement(expected: expected, observed: repointed) {
    Present { value: _ } => match tree_metadata_disagreement(expected: expected, observed: relaxed) {
      Present { value: _ } => match tree_metadata_disagreement(expected: expected, observed: reowned) {
        Present { value: _ } => match tree_metadata_disagreement(expected: expected, observed: expected) {
          Absent => true
          Present { value: _ } => false
        }
        Absent => false
      }
      Absent => false
    }
    Absent => false
  }
}

// EVERY DIRECTORY THE TREE MUST HOLD: beside the file ancestors, the directories the metadata read
// named -- a directory holding only a link had no file to hang off and the old enumeration never
// made it, so the link's own write died on a missing parent. One sorted, deduped spine.
test fn directory_targets_include_link_and_directory_parents_once_sorted() -> Bool {
  let files = tree_file_hashes_of_stdout(stdout: source_stdout, root: "/src/dag", sub: "dag")
  let metadata = [
    TreeMetadataEntry { path: "dag/only-links/l", kind: SymlinkEntryKind { target: "x" }, mode: "777", owner: "o", group: "o" },
    TreeMetadataEntry { path: "dag/empty-dir", kind: DirectoryEntryKind, mode: "755", owner: "o", group: "o" },
  ]
  join(tree_directory_targets(files: files, metadata: metadata), "\n")
    == "dag\ndag/empty-dir\ndag/gunbc\ndag/only-links"
}

// THE LINK ROWS: cp -P writes the link as the link; chown --no-dereference owns the LINK ITSELF
// (without the flag chown would follow it -- a write-anything primitive over the target).
test fn the_link_rows_spell_cp_no_dereference_then_chown_no_dereference() -> Bool {
  cp_copy_as_link_argv(source: "/src/dag/link", destination: "/opt/r/dag/link") == ["cp", "-P", "/src/dag/link", "/opt/r/dag/link"]
    && chown_no_dereference_argv(owner: ChownOwnerNames(names: PosixOwnerNames(user: "gunbc" as NonEmptyStr, group: "gunbc" as NonEmptyStr)), path: "/opt/r/dag/link")
      == ["/usr/bin/chown", "--no-dereference", "gunbc:gunbc", "/opt/r/dag/link"]
}

// THE FIND ROW THE READ READS: seven printf fields -- the seventh is find's %l, the stored link
// target, which the six-field metadata row of other callers does not carry.
test fn the_entry_metadata_command_carries_the_link_target_field() -> Bool {
  let cmd = find_tree_entry_metadata_command(root: "/src/dag")
  cmd.program.invocation == "find" && cmd.arguments == ["/src/dag", "-xdev", "-printf", "%P|%y|%m|%u|%g|%s|%l\\n"]
}

// THE RECEIPT GROWS BY ONE FIELD, ADDITIVELY: a reader that pins only candidate_revision and
// installed_digest keeps reading what it always read; metadata_digest joins the body in its named
// place, so the certified kinds/targets/modes/ownership are covered by a digest the broker carries.
test fn the_receipt_body_names_all_three_certifications_in_order() -> Bool {
  tree_receipt_body(
    revision: RevisionBoundAtEmission { revision: "0123456789abcdef0123456789abcdef01234567" },
    installed_digest: hex_a,
    metadata_digest: hex_b,
  ) == join([
    "candidate_revision=0123456789abcdef0123456789abcdef01234567\n",
    "installed_digest=", hex_a, "\n",
    "metadata_digest=", hex_b, "\n",
  ], "")
}

test fn the_two_new_steps_have_names() -> Bool {
  tree_install_step_name(step: TreeStepInstallLink) == "install-link"
    && tree_install_step_name(step: TreeStepMetadataReadback) == "metadata-readback"
}
