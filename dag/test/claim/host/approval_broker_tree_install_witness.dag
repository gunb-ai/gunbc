data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// SUPPLIED BOUNDARY VALUES: what `find ... -exec sha256sum {} +` prints for a source root and for the
// installed release directory. No exec; the values are the interface's inputs (gunbc.design_argument::single_authority).
data hex_a: String = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
data hex_b: String = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
data hex_c: String = "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"

data source_stdout: String = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa  /src/dag/gunbc/x.dag\nbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb  /src/dag/y.dag\n"

data installed_same_stdout: String = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb  /opt/r/dag/y.dag\naaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa  /opt/r/dag/gunbc/x.dag\n"

data installed_one_differs_stdout: String = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb  /opt/r/dag/y.dag\ncccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc  /opt/r/dag/gunbc/x.dag\n"

fn source_entries() -> List<TreeFileHash> {
  tree_file_hashes_of_stdout(stdout: source_stdout, root: "/src/dag", sub: "dag")
}

test fn parse_rebases_absolute_paths_onto_the_subdirectory() -> Bool {
  let es = source_entries()
  count(es) == 2 && tree_hash_lines(entries: es) == join([hex_a, "  dag/gunbc/x.dag\n", hex_b, "  dag/y.dag\n"], "")
}

test fn same_content_in_a_different_order_agrees() -> Bool {
  tree_entries_agree(
    source: source_entries(),
    installed: tree_file_hashes_of_stdout(stdout: installed_same_stdout, root: "/opt/r/dag", sub: "dag"),
  )
}

// THE DISCRIMINATING RED: one installed file's bytes differ, so the readback must refuse.
test fn one_installed_file_differing_does_not_agree() -> Bool {
  !tree_entries_agree(
    source: source_entries(),
    installed: tree_file_hashes_of_stdout(stdout: installed_one_differs_stdout, root: "/opt/r/dag", sub: "dag"),
  )
}

test fn a_missing_installed_file_does_not_agree() -> Bool {
  !tree_entries_agree(
    source: source_entries(),
    installed: tree_file_hashes_of_stdout(stdout: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb  /opt/r/dag/y.dag\n", root: "/opt/r/dag", sub: "dag"),
  )
}

test fn directories_are_ancestors_parents_first() -> Bool {
  tree_ancestor_directories(files: source_entries()) == ["dag", "dag/gunbc"]
}

fn refused_at(v: ApprovalBrokerTreeInstallVerdict, at: TreeInstallStep) -> Bool {
  match v {
    TreeInstallRefused { step: s, reason: _ } => s == at
    TreeInstallConverged { installed_digest: _, files_installed: _ } => false
  }
}

// INHABITANCE CLAIM ON THE REAL ROUTE: the real function runs the real LocalShell find|sha256sum
// argv against a root that does not exist and must refuse AT the source observation, before any
// sudo install is attempted. Deleting the observation leg makes this claim fail.
test fn the_real_route_refuses_at_source_observe_for_a_missing_source_root() -> Bool {
  refused_at(v: approval_broker_tree_install(
    owner: "gunbc" as NonEmptyStr,
    locus: release_locus_record(base_root: "/nonexistent-w6-base", revision: RevisionBoundAtEmission { revision: "0123456789abcdef0123456789abcdef01234567" }),
    source_root: "/nonexistent-w6-source",
    executables: approval_broker_release_locus_executables,
    permitted_extras: approval_broker_sibling_writer_footprint(),
    transport: one_transport_route(transport: LocalShell),
  ), at: TreeStepSourceObserve)
}

// THE PLANT'S POSITIVE CONTROL — AT THE SAME INTERFACE the negative control above tests: the source
// observe step. It calls observe_tree_hashes (the exact function tree_install_in_realm runs for the
// source observation) through the same real LocalShell route, with a source root that is PRESENT. The
// root is the RELATIVE ".", i.e. the repository checkout the claim run itself executes from, whose
// `dag` and `src/v2` are the run's own --source-root inputs — so it observes a tree the run already
// requires, with no hand-prepared directory and no dependence on host state (it assumes the claim run's
// working directory is the repository checkout root, the dir from which `dag` and `src/v2` resolve).
// There the real find|sha256sum succeeds over a populated tree, so the observe step answers TreeObserved
// with a NONEMPTY entry list — observed, no refusal (an empty observation would not satisfy the
// installer's next step either). This is the discriminating partner of the refusing control ONE
// INTERFACE OVER: same route, same observe step, the only difference is whether the source root resolves
// to a tree — missing refuses (TreeObservationFailed), present observes (TreeObserved). It runs the
// OBSERVE leg only (no elevated install, no sudo), so it executes in this sandbox next to the refusing
// control, and the wet run dispatches only the local find.
test fn the_real_route_observes_the_present_source_root_at_the_source_observe_interface() -> Bool {
  match observe_tree_hashes(
    root: ".",
    subs: release_locus_tree_subdirs,
    transport: one_transport_route(transport: LocalShell),
  ) {
    TreeObserved { entries: es } => count(es) > 0
    TreeObservationFailed { reason: _ } => false
  }
}

test fn an_unbound_revision_refuses_before_any_observation() -> Bool {
  refused_at(v: approval_broker_tree_install(
    owner: "gunbc" as NonEmptyStr,
    locus: release_locus_record(base_root: "/nonexistent-w6-base", revision: RevisionNotInstalled),
    source_root: "/nonexistent-w6-source",
    executables: approval_broker_release_locus_executables,
    permitted_extras: approval_broker_sibling_writer_footprint(),
    transport: one_transport_route(transport: LocalShell),
  ), at: TreeStepRevision)
}

// A binary that cannot be hashed on either side is a disagreement (the real LocalShell sha256sum fails),
// and the disagreement names the unobserved side.
test fn a_binary_with_no_readable_hash_does_not_agree() -> Bool {
  match tree_binary_agreement(source_path: "/nonexistent-w6-source/a", installed_path: "/nonexistent-w6-base/a", transport: one_transport_route(transport: LocalShell)) {
    Sha256SideUnobserved { side: SourceSide, cause: _ } => true
    Sha256SideUnobserved { side: InstalledSide, cause: _ } => false
    Sha256Agrees => false
    Sha256Differs => false
  }
}

fn observed_out(stdout: String, success: Bool, stderr: String) -> RunArgvTransportOutcome {
  RunArgvTransportObserved { observed: ShellExecObserved { exit_code: if success { 0 } else { 1 }, success: success, stdout: stdout, stderr: stderr } }
}

fn obs_of(stdout: String) -> Sha256Observation {
  sha256_observation_of_outcome(outcome: observed_out(stdout: stdout, success: true, stderr: ""))
}

fn is_refused(o: Sha256Observation, want: String) -> Bool {
  match o {
    Sha256Unobserved { cause: Sha256TransportRefused { reason: r } } => r == want
    Sha256Unobserved { cause: Sha256RunFailed { stderr: _ } } => false
    Sha256Unobserved { cause: Sha256LineUnparsed { stdout: _ } } => false
    Sha256Observed { digest: _ } => false
  }
}

fn is_failed(o: Sha256Observation, want: String) -> Bool {
  match o {
    Sha256Unobserved { cause: Sha256RunFailed { stderr: e } } => e == want
    Sha256Unobserved { cause: Sha256TransportRefused { reason: _ } } => false
    Sha256Unobserved { cause: Sha256LineUnparsed { stdout: _ } } => false
    Sha256Observed { digest: _ } => false
  }
}

fn is_unparsed(o: Sha256Observation, want: String) -> Bool {
  match o {
    Sha256Unobserved { cause: Sha256LineUnparsed { stdout: t } } => t == want
    Sha256Unobserved { cause: Sha256TransportRefused { reason: _ } } => false
    Sha256Unobserved { cause: Sha256RunFailed { stderr: _ } } => false
    Sha256Observed { digest: _ } => false
  }
}

test fn each_unobserved_cause_is_distinct() -> Bool {
  is_refused(o: sha256_observation_of_outcome(outcome: RunArgvTransportRefused { reason: "no session" }), want: "no session")
    && is_failed(o: sha256_observation_of_outcome(outcome: observed_out(stdout: "", success: false, stderr: "boom")), want: "boom")
    && is_unparsed(o: obs_of(stdout: "garbage"), want: "garbage")
}

test fn two_equal_observations_agree_and_two_different_differ() -> Bool {
  let a = obs_of(stdout: hex_a)
  let same = sha256_observations_agreement(source: a, installed: obs_of(stdout: hex_a))
  let diff = sha256_observations_agreement(source: a, installed: obs_of(stdout: hex_b))
  (match same {
    Sha256Agrees => true
    Sha256Differs => false
    Sha256SideUnobserved { side: _, cause: _ } => false
  }) && (match diff {
    Sha256Differs => true
    Sha256Agrees => false
    Sha256SideUnobserved { side: _, cause: _ } => false
  })
}

test fn an_unobserved_side_disagrees_with_its_cause_preserved() -> Bool {
  let bad = sha256_observation_of_outcome(outcome: observed_out(stdout: "", success: false, stderr: "boom"))
  match sha256_observations_agreement(source: obs_of(stdout: hex_a), installed: bad) {
    Sha256SideUnobserved { side: InstalledSide, cause: Sha256RunFailed { stderr: e } } => e == "boom"
    Sha256SideUnobserved { side: SourceSide, cause: _ } => false
    Sha256SideUnobserved { side: InstalledSide, cause: Sha256TransportRefused { reason: _ } } => false
    Sha256SideUnobserved { side: InstalledSide, cause: Sha256LineUnparsed { stdout: _ } } => false
    Sha256Agrees => false
    Sha256Differs => false
  }
}

// ==================== THE METADATA READ (S2) ====================
// A content hash cannot see entry KINDS: find -type f skips links and directories, so a payload link
// was invisible to both sides of tree_entries_agree. These claims witness the metadata read that
// closes that hole: the parser of find's seven-field lines, the canonical text the readback compares,
// the expectation that fixes kinds/targets/modes/ownership as receipted facts, and the argv rows that
// copy a link AS a link. Supplied boundary values throughout -- no exec.


// One file, one link with a stored target, one directory, and the starting point's OWN row (the
// `%P` field empty) that must be excluded from entries and from the count guard alike.
// ── S2: OBSERVED TREE METADATA ───────────────────────────────────────────────
// One fixture carries the cases the carrier must distinguish: a regular file (empty target), a
// symlink (stored target kept verbatim, never resolved), a directory, and a line naming the search
// root ITSELF, which the parse refuses.

data deploy_owner: NonEmptyStr = "gunbc"

data metadata_stdout: String = "gunbc/x.dag|f|644|gunbc|gunbc||123\nlink|l|777|gunbc|gunbc|/usr/bin/python3|16\ndir|d|755|gunbc|gunbc||4096\n|d|700|root|root||4096\n"

fn metadata_entries() -> List<TreeMetadataEntry> {
  tree_metadata_entries_of_stdout(stdout: metadata_stdout, sub: "dag", starting_point_expected: true)
}

// Fixture-side mode spelling, through the SAME posix authority production uses; the all-false
// fallback is visible test scaffolding, never a production default -- an unparseable fixture mode
// shows up as a claim failure, not a silent pass.
// Unwrap the expectation like production does; the Absent arm carries a visibly impossible
// sentinel, so an unreadable shared-mode constant makes every claim that reads it FAIL loudly
// rather than pass vacuously.
fn expectation_of(sources: List<TreeMetadataEntry>) -> List<TreeMetadataEntry> {
  match tree_installed_expectation(entries: sources, owner: deploy_owner) {
    Present { value: xs } => xs
    Absent => [TreeMetadataEntry { path: "EXPECTATION-UNREADABLE", kind: TreeRegular, mode: fm("000"), owner: PosixOwnerNames { user: "x" as NonEmptyStr, group: "x" as NonEmptyStr } }]
  }
}

fn fm(text: String) -> FileMode {
  match file_mode_of_octal_text(text: text) {
    Present { value: m } => m
    Absent => FileMode { owner: PermissionBits { read: false, write: false, execute: false }, group: PermissionBits { read: false, write: false, execute: false }, other: PermissionBits { read: false, write: false, execute: false }, setuid: false, setgid: false, sticky: false }
  }
}

test fn metadata_parse_keeps_kinds_targets_and_rebases_onto_the_subdirectory() -> Bool {
  let es = metadata_entries()
  count(list_map(xs: es, f: e => tree_metadata_entry_line(entry: e))) == 3
    && tree_metadata_entry_line(entry: es_head(es)) == "dag/gunbc/x.dag|f|0644|gunbc|gunbc"
    && tree_metadata_entry_line(entry: es_skip_none_head(es)) == "dag/link|l|0777|gunbc|gunbc|/usr/bin/python3"
}

// THE FIRST PARSED ENTRY: an empty path is not a name find can print (the root line is refused),
// so the empty-path sentinel below cannot collide with a real entry.
fn es_head(es: List<TreeMetadataEntry>) -> TreeMetadataEntry {
  fold(es, init: TreeMetadataEntry { path: "", kind: TreeRegular, mode: fm(""), owner: PosixOwnerNames { user: "x" as NonEmptyStr, group: "x" as NonEmptyStr } }, f: (acc, e) => if acc.path == "" { e } else { acc })
}

fn es_skip_none_head(es: List<TreeMetadataEntry>) -> TreeMetadataEntry {
  fold(es, init: TreeMetadataEntry { path: "", kind: TreeRegular, mode: fm(""), owner: PosixOwnerNames { user: "x" as NonEmptyStr, group: "x" as NonEmptyStr } }, f: (acc, e) => match e.kind { TreeLink { link_target: _l } => e _ => acc })
}

test fn the_metadata_grammar_refuses_what_it_cannot_name() -> Bool {
  tree_metadata_parse_refused(line: "x|q|644|gunbc|gunbc||1")
    && tree_metadata_parse_refused(line: "x|f|6x4|gunbc|gunbc||1")
    && tree_metadata_parse_refused(line: "x|l|777|gunbc|gunbc|a|b|1")
    && tree_metadata_parse_refused(line: "x|l|777|gunbc|gunbc||1")
    && tree_metadata_parse_refused(line: "x|f|644|gunbc|gunbc|oops|1")
    && tree_metadata_parse_refused(line: "|d|755|root|root||4096")
}

fn tree_metadata_parse_refused(line: String) -> Bool {
  match tree_metadata_entry_of_line(line: line, sub: "/x", starting_point_expected: false) {
    Absent => true
    Present { value: _entry } => false
  }
}

test fn the_expectation_fixes_kind_target_shared_mode_and_deploy_owner() -> Bool {
  let sources = [
    TreeMetadataEntry { path: "dag/gunbc/x.dag", kind: TreeRegular, mode: fm("600"), owner: PosixOwnerNames { user: "briansrls" as NonEmptyStr, group: "staff" as NonEmptyStr } },
    TreeMetadataEntry { path: "dag/link", kind: TreeLink { link_target: "../bin/gunbc" as NonEmptyStr }, mode: fm("700"), owner: PosixOwnerNames { user: "briansrls" as NonEmptyStr, group: "staff" as NonEmptyStr } },
    TreeMetadataEntry { path: "dag/lib", kind: TreeDirectory, mode: fm("600"), owner: PosixOwnerNames { user: "briansrls" as NonEmptyStr, group: "staff" as NonEmptyStr } },
  ]
  let expected = expectation_of(sources: sources)
  tree_metadata_lines(entries: expected) == join(["dag/gunbc/x.dag|f|0644|gunbc|gunbc", "\n", "dag/lib|d|0755|gunbc|gunbc", "\n", "dag/link|l|0777|gunbc|gunbc|../bin/gunbc", "\n"], "")
}

test fn metadata_lines_are_sorted_and_stable_across_emissions() -> Bool {
  let src = [
    TreeMetadataEntry { path: "dag/z", kind: TreeRegular, mode: fm("644"), owner: PosixOwnerNames { user: "gunbc" as NonEmptyStr, group: "gunbc" as NonEmptyStr } },
    TreeMetadataEntry { path: "dag/gunbc/x.dag", kind: TreeRegular, mode: fm("644"), owner: PosixOwnerNames { user: "gunbc" as NonEmptyStr, group: "gunbc" as NonEmptyStr } },
    TreeMetadataEntry { path: "dag/link", kind: TreeLink { link_target: "../bin/gunbc" as NonEmptyStr }, mode: fm("777"), owner: PosixOwnerNames { user: "gunbc" as NonEmptyStr, group: "gunbc" as NonEmptyStr } },
  ]
  tree_metadata_lines(entries: src) == tree_metadata_lines(entries: concat(left: src_skip(src: src, unwanted: "dag/link"), right: [src_head(src: src, wanted: "dag/link")]))
    && tree_metadata_lines(entries: src) == tree_metadata_lines(entries: src)
    && tree_metadata_lines(entries: []) == ""
}

fn src_head(src: List<TreeMetadataEntry>, wanted: String) -> TreeMetadataEntry {
  fold(src, init: TreeMetadataEntry { path: "", kind: TreeRegular, mode: fm(""), owner: PosixOwnerNames { user: "x" as NonEmptyStr, group: "x" as NonEmptyStr } }, f: (acc, e) => if e.path == wanted { e } else { acc })
}

fn src_skip(src: List<TreeMetadataEntry>, unwanted: String) -> List<TreeMetadataEntry> {
  fold(src, init: [], f: (acc, e) => if e.path == unwanted { acc } else { acc.append(e) })
}

fn disagreement_names(expected: List<TreeMetadataEntry>, observed: List<TreeMetadataEntry>, needle: String) -> Bool {
  match tree_metadata_disagreement(expected: expected, observed: observed) {
    Absent => false
    Present { value: d } => string_contains(s: d, pattern: needle)
  }
}

fn disagreement_absent(expected: List<TreeMetadataEntry>, observed: List<TreeMetadataEntry>) -> Bool {
  match tree_metadata_disagreement(expected: expected, observed: observed) {
    Absent => true
    Present { value: _d } => false
  }
}

test fn a_vanishing_or_materialized_symlink_is_red() -> Bool {
  let src = [
    TreeMetadataEntry { path: "dag/gunbc/x.dag", kind: TreeRegular, mode: fm("644"), owner: PosixOwnerNames { user: "gunbc" as NonEmptyStr, group: "gunbc" as NonEmptyStr } },
    TreeMetadataEntry { path: "dag/link", kind: TreeLink { link_target: "../bin/gunbc" as NonEmptyStr }, mode: fm("777"), owner: PosixOwnerNames { user: "gunbc" as NonEmptyStr, group: "gunbc" as NonEmptyStr } },
  ]
  let expected = expectation_of(sources: src)
  let vanished = src_skip(src: src, unwanted: "dag/link")
  let materialized = concat(
    left: src_skip(src: src, unwanted: "dag/link"),
    right: [TreeMetadataEntry { path: "dag/link", kind: TreeRegular, mode: fm("777"), owner: PosixOwnerNames { user: "gunbc" as NonEmptyStr, group: "gunbc" as NonEmptyStr } }]
  )
  disagreement_names(expected: expected, observed: vanished, needle: "dag/link")
    && !disagreement_absent(expected: expected, observed: materialized)
    && disagreement_absent(expected: expected, observed: src)
}

test fn a_repointed_remodeled_or_reowned_entry_is_red() -> Bool {
  let src = [
    TreeMetadataEntry { path: "dag/gunbc/x.dag", kind: TreeRegular, mode: fm("644"), owner: PosixOwnerNames { user: "gunbc" as NonEmptyStr, group: "gunbc" as NonEmptyStr } },
    TreeMetadataEntry { path: "dag/link", kind: TreeLink { link_target: "../bin/gunbc" as NonEmptyStr }, mode: fm("777"), owner: PosixOwnerNames { user: "gunbc" as NonEmptyStr, group: "gunbc" as NonEmptyStr } },
  ]
  let expected = expectation_of(sources: src)
  let repointed = concat(
    left: src_skip(src: src, unwanted: "dag/link"),
    right: [TreeMetadataEntry { path: "dag/link", kind: TreeLink { link_target: "/tmp/evil" as NonEmptyStr }, mode: fm("777"), owner: PosixOwnerNames { user: "gunbc" as NonEmptyStr, group: "gunbc" as NonEmptyStr } }]
  )
  let remodeled = concat(
    left: src_skip(src: src, unwanted: "dag/gunbc/x.dag"),
    right: [TreeMetadataEntry { path: "dag/gunbc/x.dag", kind: TreeRegular, mode: fm("777"), owner: PosixOwnerNames { user: "gunbc" as NonEmptyStr, group: "gunbc" as NonEmptyStr } }]
  )
  let reowned = concat(
    left: src_skip(src: src, unwanted: "dag/gunbc/x.dag"),
    right: [TreeMetadataEntry { path: "dag/gunbc/x.dag", kind: TreeRegular, mode: fm("644"), owner: PosixOwnerNames { user: "root" as NonEmptyStr, group: "root" as NonEmptyStr } }]
  )
  disagreement_names(expected: expected, observed: repointed, needle: "dag/link")
    && disagreement_names(expected: expected, observed: remodeled, needle: "dag/gunbc/x.dag")
    && disagreement_names(expected: expected, observed: reowned, needle: "dag/gunbc/x.dag")
}

test fn directory_targets_include_link_and_directory_parents_once_sorted() -> Bool {
  let files = [TreeFileHash { path: "gunbc/x.dag", hex: "aa" }]
  let entries = [
    TreeMetadataEntry { path: "gunbc/x.dag", kind: TreeRegular, mode: fm("644"), owner: PosixOwnerNames { user: "gunbc" as NonEmptyStr, group: "gunbc" as NonEmptyStr } },
    TreeMetadataEntry { path: "gunbc/bin/gunbc", kind: TreeLink { link_target: "../bin/gunbc" as NonEmptyStr }, mode: fm("777"), owner: PosixOwnerNames { user: "gunbc" as NonEmptyStr, group: "gunbc" as NonEmptyStr } },
    TreeMetadataEntry { path: "gunbc/lib", kind: TreeDirectory, mode: fm("755"), owner: PosixOwnerNames { user: "gunbc" as NonEmptyStr, group: "gunbc" as NonEmptyStr } },
  ]
  tree_directory_targets(files: files, metadata: entries) == ["gunbc", "gunbc/bin", "gunbc/lib"]
    && count(tree_symlink_entries(entries: entries)) == 1
    && tree_metadata_lines(entries: tree_symlink_entries(entries: entries)) == "gunbc/bin/gunbc|l|0777|gunbc|gunbc|../bin/gunbc\n"
}

test fn the_link_rows_spell_cp_no_dereference_then_chown_no_dereference() -> Bool {
  let cp = cp_copy_as_link_argv(source: "/repos/acts/gunbc/bin/gunbc", destination: "/target/gunbc/bin/gunbc")
  let co = chown_no_dereference_argv(owner: ChownOwnerNames { names: PosixOwnerNames { user: "gunbc" as NonEmptyStr, group: "gunbc" as NonEmptyStr } }, path: "/target/gunbc/bin/gunbc")
  cp == ["cp", "-P", "/repos/acts/gunbc/bin/gunbc", "/target/gunbc/bin/gunbc"]
    && co == ["/usr/bin/chown", "--no-dereference", "gunbc:gunbc", "/target/gunbc/bin/gunbc"]
}

test fn the_entry_metadata_command_carries_the_target_and_size_fields() -> Bool {
  let cmd = find_tree_entry_metadata_command(root: "/src/dag")
  (cmd.program.invocation as String) == "find" && cmd.arguments == ["/src/dag", "-xdev", "-printf", "%P|%y|%m|%u|%g|%l|%s\\n"]
}

test fn the_receipt_body_certifies_revision_installed_and_metadata_in_one_text() -> Bool {
  let body = tree_receipt_body(revision: RevisionBoundAtEmission { revision: "3f2a1b" as CommitSha }, installed_digest: hex_a, metadata_digest: hex_b)
  body == join(["candidate_revision=3f2a1b", "\ninstalled_digest=", hex_a, "\nmetadata_digest=", hex_b, "\n"], "")
}

test fn the_two_new_steps_have_names() -> Bool {
  tree_install_step_name(step: TreeStepInstallLink) == "install-link"
    && tree_install_step_name(step: TreeStepMetadataReadback) == "metadata-readback"
}

// ── BUG 6 READING ────────────────────────────────────────────────────────────────────────────────
// node://adhoc-3e6e9bfb-d59 (roadmap deploy-intent-owns-artifact-closure), red_control 1: "Two installs
// of the same revision produce the same receipt digest."
//
// A tree install's receipt is tree_receipt_body over two digests: the content digest of the regular-file
// lines (sha256sum of tree_hash_lines) and the content digest of the certified entry-metadata lines
// (sha256sum of tree_metadata_lines). sha256sum is a pure function of its input string, so the receipt
// reproduces between two installs of ONE tree EXACTLY when those two canonical line-spellings reproduce.
//
// BEFORE the fix the tree install emitted each line set in the order `find` happened to walk the tree, so
// two installs of one tree could print two receipts (srv1 lab bug 6, 2026-11-04). host_effect_realize now
// sorts BOTH line sets bytewise on tree_path_total_order, so the two installs of one tree -- here the same
// file set and the same metadata supplied in two OPPOSITE find orders -- yield ONE byte-identical
// installed-digest input, ONE metadata-digest input, and ONE receipt body. This is the reading, and it is
// the bug 6 red control: it turns RED the moment the bytewise sort is removed, because the assertions
// below that the emitted order is the sorted order (not the input order) then fail.
//
// THE READING (the node's handback artifact, stated hermetically). The install command is the one the
// tree already exercises as real data -- find_tree_entry_metadata_command (asserted in
// the_entry_metadata_command_carries_the_target_and_size_fields): `find <root> -xdev -printf
// %P|%y|%m|%u|%g|%l|%s\n`. The candidate revision is threaded as a CommitSha into the two receipts below.
//
// This control does NOT claim to have installed anything on a host (that would be an observation this
// hermetic witness never makes -- gunbc.design_argument::epistemic_humility). What it asserts is the
// invariant that MAKES two installs of one revision reproducible: the receipt is a function of the
// CANONICAL (sorted) line set, not of find's walk order. Two opposite-order finds of one tree
// canonicalise to the same installed and metadata text, so any digest taken of that text -- and so the
// receipt carrying it -- is identical between the installs. That is red_control 1's "same receipt digest".

// One tree -- three files, one directory-less set -- observed in two opposite find orders. The metadata is
// the SAME three entries in the SAME opposite orders; each file is a regular file at mode 0755 owned by
// gunbc, so the only thing that differs between the two installs is the order `find` returned them.
data bug6_files_first: List<TreeFileHash> = [
  TreeFileHash { path: "dag/gunbc/x.dag", hex: hex_a },
  TreeFileHash { path: "bin/gunbc", hex: hex_b },
  TreeFileHash { path: "src/v2/std/bool.dag", hex: hex_c },
]
data bug6_files_second: List<TreeFileHash> = [
  TreeFileHash { path: "src/v2/std/bool.dag", hex: hex_c },
  TreeFileHash { path: "bin/gunbc", hex: hex_b },
  TreeFileHash { path: "dag/gunbc/x.dag", hex: hex_a },
]
// The metadata is the SAME three regular files (mode 0755, owner gunbc) in the two opposite find orders, using
// this file's own fm() helper and PosixOwnerNames constructor (the same idiom the metadata controls above use).
test fn two_installs_of_one_tree_reproduce_one_receipt_digest() -> Bool {
  let a = TreeMetadataEntry { path: "dag/gunbc/x.dag", kind: TreeRegular, mode: fm("755"), owner: PosixOwnerNames { user: "gunbc" as NonEmptyStr, group: "gunbc" as NonEmptyStr } }
  let b = TreeMetadataEntry { path: "bin/gunbc", kind: TreeRegular, mode: fm("755"), owner: PosixOwnerNames { user: "gunbc" as NonEmptyStr, group: "gunbc" as NonEmptyStr } }
  let c = TreeMetadataEntry { path: "src/v2/std/bool.dag", kind: TreeRegular, mode: fm("755"), owner: PosixOwnerNames { user: "gunbc" as NonEmptyStr, group: "gunbc" as NonEmptyStr } }
  let installed_first = tree_hash_lines(entries: bug6_files_first)
  let installed_second = tree_hash_lines(entries: bug6_files_second)
  let metadata_first = tree_metadata_lines(entries: [a, b, c])
  let metadata_second = tree_metadata_lines(entries: [c, b, a])
  // One candidate revision, threaded into both receipts (the node's branch base). The receipt digest is a
  // deterministic function of the canonical line text; here the canonical text stands in for that digest so
  // that text equality ==> receipt equality is the exact thing under claim.
  let revision = RevisionBoundAtEmission { revision: "6f3cc6b38c2" as CommitSha }
  let receipt_first = tree_receipt_body(revision: revision, installed_digest: installed_first, metadata_digest: metadata_first)
  let receipt_second = tree_receipt_body(revision: revision, installed_digest: installed_second, metadata_digest: metadata_second)
  // The canonical (sorted) line sets are equal across the two finds, so the receipts are one text.
  installed_first == installed_second
    && metadata_first == metadata_second
    && receipt_first == receipt_second
    && string_contains(s: receipt_first, pattern: "candidate_revision=6f3cc6b38c2")
    // ...and the emitted order is the sorted order, NOT either observed order: bin/gunbc (hex_b) leads the
    // hashed lines and "bin/gunbc|" leads the metadata, though neither install saw it first.
    && string_contains(s: installed_first, pattern: join([hex_b, "  bin/gunbc\n"], ""))
    && string_contains(s: metadata_first, pattern: "bin/gunbc|")
    && substring(s: installed_first, start: 0, end: 2) == "bb"
    && substring(s: installed_second, start: 0, end: 2) == "bb"
    && substring(s: metadata_first, start: 0, end: 3) == "bin"
    && substring(s: metadata_second, start: 0, end: 3) == "bin"
}

// ===========================================================================
// LOCUS-ROOT READBACK EXTENSION: the gaps closed by the extended observation
// ===========================================================================
// Claims:
//   1. A same-byte executable at the wrong mode (0644 instead of 0755) is caught
//      as a disagreement in the merged expected/observed comparison, even though
//      the content hash agrees (the gap was: executables were only hash-compared).
//   2. A wrong-mode subtree root (e.g. "dag" at 0777 instead of 0755) is caught,
//      which today's readback does not observe (the walk starts inside dag/, not at it).
//   3. Extras at the locus root are tolerated. Decision: the tree install's readback
//      establishes only what the tree install writes. Files placed by other deploy
//      legs (firecracker, images/, .gunbc-vmm-receipt, device-crypto-deployed-digest.env)
//      run AFTER the tree install and persist across reruns. Refusing them would brick
//      a working redeploy. The containment check verifies expected entries exist with
//      correct metadata while tolerating non-tree-install entries.

fn gnbc() -> PosixOwnerNames {
  PosixOwnerNames { user: "gunbc" as NonEmptyStr, group: "gunbc" as NonEmptyStr }
}

fn is_dir(kind: TreeEntryKind) -> Bool {
  match kind { TreeDirectory {} => true _ => false }
}

fn is_regular(kind: TreeEntryKind) -> Bool {
  match kind { TreeRegular {} => true _ => false }
}

// THE EXPECTATION BUILDS executable entries at install_executable_shared_mode (0755)
// and directory entries at install_d_shared_mode for the subtree roots.
test fn locus_children_expectation_names_executables_at_exe_mode() -> Bool {
  let subs = ["dag", "src/v2"]
  let execs = ["gunbc", "gunbc-helper"]
  match tree_locus_children_expectation_owned(subdirs: subs, executables: execs, owner: gnbc()) {
    Absent => false
    Present { value: entries } =>
      count(entries) == 4
      && any(entries, e => e.path == "dag" && is_dir(e.kind))
      && any(entries, e => e.path == "src" && is_dir(e.kind))
      && any(entries, e => e.path == "gunbc" && is_regular(e.kind) && file_mode_octal(mode: e.mode) == "0755")
      && any(entries, e => e.path == "gunbc-helper" && is_regular(e.kind) && file_mode_octal(mode: e.mode) == "0755")
  }
}


// ===========================================================================
// LOCUS-ROOT READBACK: the per-locus partition, exercised through the one
// production agreement authority (tree_locus_agreement), never a copy.
// ===========================================================================
// The four METADATA-NEGATIVE controls (executable mode, executable owner, subtree-root mode, spine mode)
// each (1) build their expectation from the PRODUCTION builders, (2) start from a COMPLETE fixture that
// AGREES and assert that agreement FIRST, then (3) perturb exactly ONE property and require the
// disagreement to name the intended PATH (the metadata line is `path|kind|mode|user|group`, so the path
// pins the row). The partition/roster controls do NOT each carry their own baseline-first step: they assert
// a named refusal (or a required-entry absence) directly, and their positive baseline is the separate
// broker_complete_fixture_agrees / microvm_footprint_tolerates_its_members control that establishes the
// un-perturbed agreement those refusals are a deviation from.
// The broker roster is the production approval_broker_release_locus_executables
// (gunbc + approval_device_crypto_serve); approval_device_crypto_serve is installer-owned
// and REQUIRED, not an extra. The only broker sibling-writer exception is the device-crypto
// env file; the helper locus gets only the receipt.

fn root_owner() -> PosixOwnerNames {
  PosixOwnerNames { user: "root" as NonEmptyStr, group: "root" as NonEmptyStr }
}

fn rentry(path: String, kind: TreeEntryKind, mode: String, owner: PosixOwnerNames) -> TreeMetadataEntry {
  TreeMetadataEntry { path: path, kind: kind, mode: fm(mode), owner: owner }
}

// The broker spine + locus these controls reason about.
data ctl_spine: List<String> = ["/opt/gunbc", "/opt/gunbc/releases"]
data ctl_locus: String = "/opt/gunbc/releases/abc123"
data broker_execs: List<String> = approval_broker_release_locus_executables

// THE COMPLETE, AGREEING BROKER LOCUS-CHILDREN OBSERVATION: subtree roots dag + src, the src/v2 walk
// root, both production executables at 0755, the receipt, and the sibling-writer env file.
fn broker_complete_children(owner: PosixOwnerNames) -> List<TreeMetadataEntry> {
  [
    rentry("dag", TreeDirectory, "755", owner),
    rentry("src", TreeDirectory, "755", owner),
    rentry("src/v2", TreeDirectory, "755", owner),
    rentry("gunbc", TreeRegular, "755", owner),
    rentry("approval_device_crypto_serve", TreeRegular, "755", owner),
    rentry(".gunbc-tree-receipt", TreeRegular, "644", owner),
    rentry("device-crypto-deployed-digest.env", TreeRegular, "644", owner),
  ]
}

fn broker_complete_spine(owner: PosixOwnerNames) -> List<TreeMetadataEntry> {
  [
    rentry("/opt/gunbc", TreeDirectory, "755", owner),
    rentry("/opt/gunbc/releases", TreeDirectory, "755", owner),
    rentry("/opt/gunbc/releases/abc123", TreeDirectory, "755", owner),
  ]
}

// Run the one authority over a broker scenario; returns the agreement reason (Absent == agreed).
fn broker_agree(
  children_observed: List<TreeMetadataEntry>,
  spine_observed: List<TreeMetadataEntry>,
  owner: PosixOwnerNames,
  permitted: List<String>,
) -> Optional<String> {
  match tree_locus_children_expectation_owned(subdirs: release_locus_tree_subdirs, executables: broker_execs, owner: owner) {
    Absent => Present { value: "expectation-unbuildable" }
    Present { value: locus_expected } =>
      match tree_walk_root_expectation_owned(subdirs: release_locus_tree_subdirs, owner: owner) {
        Absent => Present { value: "walkroot-unbuildable" }
        Present { value: wr_expected } =>
          match tree_spine_expectation_owned(spine: ctl_spine, locus: ctl_locus, owner: owner) {
            Absent => Present { value: "spine-unbuildable" }
            Present { value: spine_expected } =>
              tree_locus_agreement(
                source_expected: [], source_observed: [],
                locus_children_expected: locus_expected,
                locus_children_observed: children_observed,
                walk_root_expected: wr_expected,
                spine_expected: spine_expected,
                spine_observed: spine_observed,
                permitted_extras: permitted,
              )
          }
      }
  }
}

// CONTROL: the complete broker locus AGREES (no false refusal of the receipt or the env file), so
// every red control below is attributable to the single perturbation it makes.
test fn broker_complete_fixture_agrees() -> Bool {
  match broker_agree(
    children_observed: broker_complete_children(owner: gnbc()),
    spine_observed: broker_complete_spine(owner: gnbc()),
    owner: gnbc(),
    permitted: approval_broker_sibling_writer_footprint(),
  ) {
    Present { value: _ } => false
    Absent => true
  }
}

// RED CONTROL: same-byte executable at the WRONG MODE (gunbc 0755 -> 0644). Names the gunbc path row.
test fn executable_at_wrong_mode_disagrees() -> Bool {
  let owner = gnbc()
  match broker_agree(children_observed: broker_complete_children(owner: owner), spine_observed: broker_complete_spine(owner: owner), owner: owner, permitted: approval_broker_sibling_writer_footprint()) {
    Present { value: _ } => false
    Absent =>
      let perturbed = [
        rentry("dag", TreeDirectory, "755", owner),
        rentry("src", TreeDirectory, "755", owner),
        rentry("src/v2", TreeDirectory, "755", owner),
        rentry("gunbc", TreeRegular, "644", owner),
        rentry("approval_device_crypto_serve", TreeRegular, "755", owner),
        rentry(".gunbc-tree-receipt", TreeRegular, "644", owner),
        rentry("device-crypto-deployed-digest.env", TreeRegular, "644", owner),
      ]
      match broker_agree(children_observed: perturbed, spine_observed: broker_complete_spine(owner: owner), owner: owner, permitted: approval_broker_sibling_writer_footprint()) {
        Absent => false
        Present { value: why } => string_contains(s: why, pattern: "gunbc|f|0755")
      }
  }
}

// RED CONTROL: same-byte executable at the correct mode but WRONG OWNER (gunbc -> root). Names the row.
test fn executable_at_wrong_owner_disagrees() -> Bool {
  let owner = gnbc()
  match broker_agree(children_observed: broker_complete_children(owner: owner), spine_observed: broker_complete_spine(owner: owner), owner: owner, permitted: approval_broker_sibling_writer_footprint()) {
    Present { value: _ } => false
    Absent =>
      let perturbed = [
        rentry("dag", TreeDirectory, "755", owner),
        rentry("src", TreeDirectory, "755", owner),
        rentry("src/v2", TreeDirectory, "755", owner),
        rentry("gunbc", TreeRegular, "755", root_owner()),
        rentry("approval_device_crypto_serve", TreeRegular, "755", owner),
        rentry(".gunbc-tree-receipt", TreeRegular, "644", owner),
        rentry("device-crypto-deployed-digest.env", TreeRegular, "644", owner),
      ]
      match broker_agree(children_observed: perturbed, spine_observed: broker_complete_spine(owner: owner), owner: owner, permitted: approval_broker_sibling_writer_footprint()) {
        Absent => false
        Present { value: why } => string_contains(s: why, pattern: "gunbc|f|0755")
      }
  }
}

// RED CONTROL: the subtree root `dag` at 0777. Names the dag directory row.
test fn subtree_root_wrong_mode_disagrees() -> Bool {
  let owner = gnbc()
  match broker_agree(children_observed: broker_complete_children(owner: owner), spine_observed: broker_complete_spine(owner: owner), owner: owner, permitted: approval_broker_sibling_writer_footprint()) {
    Present { value: _ } => false
    Absent =>
      let perturbed = [
        rentry("dag", TreeDirectory, "777", owner),
        rentry("src", TreeDirectory, "755", owner),
        rentry("src/v2", TreeDirectory, "755", owner),
        rentry("gunbc", TreeRegular, "755", owner),
        rentry("approval_device_crypto_serve", TreeRegular, "755", owner),
        rentry(".gunbc-tree-receipt", TreeRegular, "644", owner),
        rentry("device-crypto-deployed-digest.env", TreeRegular, "644", owner),
      ]
      match broker_agree(children_observed: perturbed, spine_observed: broker_complete_spine(owner: owner), owner: owner, permitted: approval_broker_sibling_writer_footprint()) {
        Absent => false
        Present { value: why } => string_contains(s: why, pattern: "dag|d|0755")
      }
  }
}

// RED CONTROL: a spine directory (/opt/gunbc) at 0777. Names the spine directory row.
test fn spine_wrong_mode_disagrees() -> Bool {
  let owner = gnbc()
  match broker_agree(children_observed: broker_complete_children(owner: owner), spine_observed: broker_complete_spine(owner: owner), owner: owner, permitted: approval_broker_sibling_writer_footprint()) {
    Present { value: _ } => false
    Absent =>
      let perturbed_spine = [
