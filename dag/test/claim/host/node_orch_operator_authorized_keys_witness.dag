module test.claim.host.node_orch_operator_authorized_keys_witness

// Green-by-execution witness for gunbc.host.node_orch_operator_authorized_keys. It renders each out-of-band
// node-orch operator-account authorized_keys entry and asserts the bytes match the line gentle-crab-832 verified
// live on 2026-11-20 (each host's ~/.ssh/authorized_keys.bak-20261120 holds the pre-edit form); it proves the
// from= source-address restriction is admitted only through the checked constructor; and it folds the typed
// consumer admissions against each entry's shipped option set, so an admission that drifts from its line is
// caught. It also pins the silent-undo hazard: srv2's key is fleet-owned (an operator-account reconcile would
// Remove it unless the keep-set covers it) while srv1's key is not (a reconcile already refuses it).

import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.types { Bool, List, NonEmptyStr, String }
import std.optional { Present, Absent }
import extdeps.ssh.keys {
  AuthorizedKeyEntry,
  NoAgentForwardingOption,
  NoPortForwardingOption,
  NoX11ForwardingOption,
  authorized_key_entry_line,
  authorized_key_from_source_addresses,
}
import gunbc.host.node_orch_operator_authorized_keys {
  NodeOrchOperatorAdmittedOption,
  PortForwardingAdmittedAbsent,
  PortForwardingAdmittedKept,
  TailnetSourceAdmitted,
  node_orch_operator_account_keep_materials,
  node_orch_operator_account_login,
  node_orch_operator_admissions_for,
  node_orch_operator_authorized_key_line,
  node_orch_srv1_authorized_key_entry,
  node_orch_srv1_ssh_key,
  node_orch_srv2_authorized_key_entry,
}
import gunbc.fleet.fleet_ssh_access { node_orch_ssh_key, fleet_authorized_keys }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// The exact live line on srv1's operator account, read 2026-11-20. from= is the shared LAN plus srv2's tailnet
// address; no-port-forwarding is absent (srv2's stream-local docker tunnel needs it).
data srv1_expected_line: String =
  "from=\"192.168.1.0/24,100.73.169.40\",no-agent-forwarding,no-X11-forwarding ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIIQp4ylHo8mQNGwvSg7ftW1LSXNFEPuwVjsDKvdqJnkj node-orch@srv2"

// The exact live line on srv2's operator account, read 2026-11-20. from= is the shared LAN plus srv1's tailnet
// address; no-port-forwarding is kept (the srv2-lan sessions need no forwarding).
data srv2_expected_line: String =
  "from=\"192.168.1.0/24,100.69.18.126\",no-port-forwarding,no-agent-forwarding,no-X11-forwarding ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMIzI+97T4CY1FsAqAcZce4quloDCNAxLXFCoq16G17i node-orch@srv1"

fn fleet_owned_holds(material: NonEmptyStr) -> Bool {
  fold(fleet_authorized_keys, init: false, f: (acc, k) => acc || (k.material == material))
}

fn keep_holds(material: NonEmptyStr) -> Bool {
  fold(node_orch_operator_account_keep_materials(), init: false, f: (acc, x) => acc || (x == material))
}

fn admits_holds(host_label: String, want: NodeOrchOperatorAdmittedOption) -> Bool {
  fold(node_orch_operator_admissions_for(host_label: host_label), init: false, f: (acc, a) => acc || (a.admits == want))
}

// The rendered srv1 entry is byte-for-byte the verified live line, and it is admitted only via the checked
// from= constructor (it is built by authorized_key_from_source_addresses inside the entry fn).
test fn srv1_entry_renders_the_verified_live_line() -> Bool {
  match node_orch_srv1_authorized_key_entry() {
    Absent => false
    Present { value: e } => node_orch_operator_authorized_key_line(entry: e) == srv1_expected_line
  }
}

// The rendered srv2 entry is byte-for-byte the verified live line.
test fn srv2_entry_renders_the_verified_live_line() -> Bool {
  match node_orch_srv2_authorized_key_entry() {
    Absent => false
    Present { value: e } => node_orch_operator_authorized_key_line(entry: e) == srv2_expected_line
  }
}

// The from= guard is load-bearing: an empty set, an embedded double quote, or whitespace (which breaks sshd's
// comma split) each build NO option -- so the quoting-broken line is unwritable, not merely caught.
test fn the_from_constructor_refuses_unquotable_and_empty_sets() -> Bool {
  (match authorized_key_from_source_addresses(patterns: []) {
    Absent => true
    Present { value: _ } => false
  })
    && (match authorized_key_from_source_addresses(patterns: ["10.0.0.1", "bad \"quote\""]) {
      Absent => true
      Present { value: _ } => false
    })
    && (match authorized_key_from_source_addresses(patterns: ["10.0.0.1", "has space"]) {
      Absent => true
      Present { value: _ } => false
    })
}

// The typed admissions match the shipped option sets: srv1's docker-tunnel unit admits port-forwarding ABSENT and
// its line omits no-port-forwarding; srv2's srv1->srv2-lan sessions admit it KEPT and its line carries it; each
// host admits the peer tailnet address in from=. The carrier is folded against the line, not ornamental.
test fn the_admissions_match_the_shipped_option_sets() -> Bool {
  admits_holds(host_label: "srv1", want: PortForwardingAdmittedAbsent)
    && admits_holds(host_label: "srv2", want: PortForwardingAdmittedKept)
    && admits_holds(host_label: "srv1", want: TailnetSourceAdmitted)
    && admits_holds(host_label: "srv2", want: TailnetSourceAdmitted)
    && (match node_orch_srv1_authorized_key_entry() {
      Absent => false
      Present { value: e } => node_orch_operator_authorized_key_line(entry: e).contains("no-port-forwarding") == false
    })
    && (match node_orch_srv2_authorized_key_entry() {
      Absent => false
      Present { value: e } => node_orch_operator_authorized_key_line(entry: e).contains("no-port-forwarding")
    })
}

// The keep-set covers both node-orch materials. srv2's key is fleet-owned (an operator-account reconcile would
// otherwise find it owned-but-not-desired and Remove it -- the silent undo); srv1's key is NOT fleet-owned (a
// reconcile already refuses it). This pins why the keep-set is load-bearing for the srv2 line only.
test fn the_keep_set_covers_both_and_names_the_ownership_hazard() -> Bool {
  let keep = node_orch_operator_account_keep_materials()
  keep.length() == 2
    && keep_holds(material: node_orch_ssh_key.material)
    && keep_holds(material: node_orch_srv1_ssh_key.material)
    && fleet_owned_holds(material: node_orch_ssh_key.material)
    && (fleet_owned_holds(material: node_orch_srv1_ssh_key.material) == false)
    && (node_orch_operator_account_login as String) == "briansrls"
}
