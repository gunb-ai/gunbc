module test.claim.nested_fold_generic_param_emit

import std.nat { Nat }
import std.measure { Measure, Time, time_measure, measure_count }
import std.realization_measurement {
  schedule_batch_critical_path,
  schedule_critical_path_time,
}

test fn witness_flat_fold_resolves_generic_scale() -> Bool {
  let batch = [time_measure(count: 10)]
  measure_count(m: schedule_batch_critical_path(batch_times: batch)) == 10
}

test fn witness_nested_fold_resolves_generic_scale() -> Bool {
  let batches = [
    [time_measure(count: 40), time_measure(count: 5)],
    [time_measure(count: 20)],
  ]
  measure_count(m: schedule_critical_path_time(batch_times: batches)) == 60
}

