module test.claim.runtime_materialization_observation_witness_test

import std.types { Bool, NonEmptyStr }
import gunbc.ollama_runtime_bundle {
  RuntimeMaterializationObservation,
  RuntimeMaterializationAbsent,
  RuntimeMaterializationIncomplete,
  RuntimeMaterializationComplete,
  RuntimeMaterializationObservationRefused,
  RuntimeMaterializationDefect,
  RuntimeRootPresentButEmpty,
  RuntimeExecutableMissing,
  runtime_materialization_defects,
  runtime_materialization_observed_identity,
  runtime_materialization_was_observed,
  ollama_runtime_materialization_identity_for_required_release,
}

fn required_identity() -> NonEmptyStr {
  ollama_runtime_materialization_identity_for_required_release().digest
}

fn corrupted_under_a_correct_root() -> RuntimeMaterializationObservation {
  RuntimeMaterializationIncomplete {
    identity: ollama_runtime_materialization_identity_for_required_release(),
    first_defect: RuntimeExecutableMissing { expected_relative_path: "bin/ollama" as NonEmptyStr },
    further_defects: [],
  }
}

// THE KEYSTONE. A correct path name is not proof of a correct runtime: the root is content-addressed
// by the materialization identity, so its NAME is derivable from the release alone and a directory
// bearing it proves only that something once decided to create it. A partial tree under that name
// is INCOMPLETE -- not absent, and not unobservable.
test fn a_corrupted_extraction_under_a_correct_root_is_incomplete() -> Bool {
  match corrupted_under_a_correct_root() {
    RuntimeMaterializationIncomplete { identity: _, first_defect: _, further_defects: _ } => true
    RuntimeMaterializationAbsent => false
    RuntimeMaterializationComplete { identity: _ } => false
    RuntimeMaterializationObservationRefused { cause: _ } => false
  }
}

// IT IS NOT ABSENCE. Folding it there would report nothing installed while a partial tree sits on
// disk, and the remedies differ -- materialize versus repair. Both contribute no observed member,
// which is exactly why the distinction has to live in the type rather than in the consequence.
test fn incomplete_and_absent_agree_on_the_member_and_differ_as_facts() -> Bool {
  match runtime_materialization_observed_identity(observation: corrupted_under_a_correct_root()) {
    Present { value: _ } => false
    Absent =>
      match runtime_materialization_observed_identity(observation: RuntimeMaterializationAbsent) {
        Present { value: _ } => false
        Absent => runtime_materialization_was_observed(observation: corrupted_under_a_correct_root())
          && runtime_materialization_was_observed(observation: RuntimeMaterializationAbsent)
      }
  }
}

// AND IT IS NOT A REFUSAL, which would be the worse fold: the corruption was SUCCESSFULLY OBSERVED,
// and calling an established fact an inability to establish it is the collapse this lane has found
// at every layer. Refusal is reserved for genuinely not knowing, and only it answers false here.
test fn only_a_refusal_reports_the_runtime_as_unobserved() -> Bool {
  !runtime_materialization_was_observed(
    observation: RuntimeMaterializationObservationRefused {
      cause: "runtime root unreadable: permission denied" as NonEmptyStr,
    },
  )
    && runtime_materialization_was_observed(observation: corrupted_under_a_correct_root())
}

// A complete materialization is the ONLY arm that projects an identity, and it projects the one it
// was observed to hold. Without this the three negative claims above pass on a projection that
// simply never answers.
test fn only_a_complete_materialization_projects_its_identity() -> Bool {
  match runtime_materialization_observed_identity(
    observation: RuntimeMaterializationComplete {
      identity: ollama_runtime_materialization_identity_for_required_release(),
    },
  ) {
    Absent => false
    Present { value: id } => (id.digest as String) == (required_identity() as String)
  }
}

// An incomplete materialization carries at least one defect BY CONSTRUCTION -- head plus tail, so
// "incomplete with nothing wrong" has no constructor. This pins that the accessor agrees with the
// type rather than quietly returning an empty list the type already forbids.
test fn an_incomplete_materialization_always_reports_a_defect() -> Bool {
  length(runtime_materialization_defects(observation: corrupted_under_a_correct_root())) == 1
    && length(runtime_materialization_defects(
      observation: RuntimeMaterializationIncomplete {
        identity: ollama_runtime_materialization_identity_for_required_release(),
        first_defect: RuntimeRootPresentButEmpty,
        further_defects: [RuntimeExecutableMissing { expected_relative_path: "bin/ollama" as NonEmptyStr }],
      },
    )) == 2
}

// The settled arms report no defects, so the accessor is not answering the same way for everything.
test fn a_complete_or_absent_runtime_reports_no_defects() -> Bool {
  length(runtime_materialization_defects(observation: RuntimeMaterializationAbsent)) == 0
    && length(runtime_materialization_defects(
      observation: RuntimeMaterializationComplete {
        identity: ollama_runtime_materialization_identity_for_required_release(),
      },
    )) == 0
}
