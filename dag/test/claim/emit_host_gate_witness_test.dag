module test.claim.emit_host_gate_witness


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn nonempty(s: String) -> Bool {
  s != ""
}

test fn w_rust_fixture_nonempty() -> Bool {
  nonempty(s: tools.emit_host_fixtures.rust_stdout_fixture_source)
}

test fn w_python_fixture_nonempty() -> Bool {
  nonempty(s: tools.emit_host_fixtures.python_stdout_fixture_source)
}

test fn w_go_fixture_nonempty() -> Bool {
  nonempty(s: tools.emit_host_fixtures.go_stdout_fixture_source)
}

test fn w_ts_fixture_nonempty() -> Bool {
  nonempty(s: tools.emit_host_fixtures.ts_host_fixture_source)
}

test fn w_byte_count_is_five() -> Bool {
  byte_size_count(tools.emit_host_fixtures.stdout_byte_count) == 5
}

test fn w_ts_byte_count_is_four() -> Bool {
  byte_size_count(tools.emit_host_fixtures.ts_signed_i32_le_byte_count) == 4
}

