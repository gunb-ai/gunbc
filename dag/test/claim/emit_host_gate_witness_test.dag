module test.claim.emit_host_gate_witness


data live_tree_disposition: LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn nonempty(s: String) -> Bool {
  s != ""
}

fn w_rust_fixture_nonempty() -> Bool {
  nonempty(s: tools.emit_host_fixtures.rust_stdout_fixture_source)
}

fn w_python_fixture_nonempty() -> Bool {
  nonempty(s: tools.emit_host_fixtures.python_stdout_fixture_source)
}

fn w_go_fixture_nonempty() -> Bool {
  nonempty(s: tools.emit_host_fixtures.go_stdout_fixture_source)
}

fn w_ts_fixture_nonempty() -> Bool {
  nonempty(s: tools.emit_host_fixtures.ts_host_fixture_source)
}

fn w_byte_count_is_five() -> Bool {
  std.measure.byte_size_count(tools.emit_host_fixtures.stdout_byte_count) == 5
}

fn w_ts_byte_count_is_four() -> Bool {
  std.measure.byte_size_count(tools.emit_host_fixtures.ts_signed_i32_le_byte_count) == 4
}

test fn emit_host_gate_witnesses() -> Bool {
  w_rust_fixture_nonempty() &&
  w_python_fixture_nonempty() &&
  w_go_fixture_nonempty() &&
  w_ts_fixture_nonempty() &&
  w_byte_count_is_five() &&
  w_ts_byte_count_is_four()
}
