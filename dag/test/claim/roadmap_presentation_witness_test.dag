  ActivityView, NoActiveWork, ActiveWork, ActiveWorkRefused,
  CompletedWork, ActivityUnobservable,
  WorkAttemptFacts, NoActiveAttempt, AttemptUnobservable,
  activity_view_of,
  ActivityAttention, ActivityRoutine, ActivityNeedsUser, ActivityAnomalous,
  ActionAvailability, ActionUnavailable, AvailableAsOverride, ActionAvailable,
