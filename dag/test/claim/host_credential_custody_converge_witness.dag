data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE SUBJECT OF EVERY CLAIM HERE IS ONE PURE INTERFACE, with its inputs SUPPLIED (DESIGN §3, a
// witness discriminates at one interface): the far-side find answers and the cmp/test exits are
// constructed rather than produced by a host. The ROWS, however, are the real roster's rows wherever
// a claim is about admission, so a change to a rostered row's fields reddens here. The execution
// route (fleet SSH, sudo, Secret Manager) has no hermetic seam that returns distinct answers per
// leg; its inhabitance is the dispatched fleet-converge mode's receipt, not a claim in this file.

data controller_row: HostCredentialCustodyRow = host_credential_custody_row(c: ControllerAppKey)

data ntfy_row: HostCredentialCustodyRow = host_credential_custody_row(c: ApprovalNtfyPublisherToken)

fn placed(row: HostCredentialCustodyRow) -> Bool {
  match custody_row_placement(row: row) {
    CustodyPlaced { row: _, key_dir: _, upper_ancestors: _ } => true
    CustodyPlacementRefused { cause: _ } => false
  }
}

// ── the closed roster ───────────────────────────────────────────────────────────────────────────

// POSITIVE CONTROL for admission: every rostered row places. A row that stops placing would be a
// dispatch option that refuses on every run.
test fn every_rostered_row_places() -> Bool {
  all(host_custody_credential_roster, c => placed(row: host_credential_custody_row(c: c)))
}

// The dispatch choice and the selection are one roster read two ways: every option selects the
// credential whose wire it is, and nothing else selects.
test fn every_dispatch_option_selects_its_own_row() -> Bool {
  all(host_custody_credential_roster, c =>
    match select_host_custody_credential(supplied: host_custody_credential_wire(c: c)) {
      HostCustodyCredentialSelected { credential: s } => host_custody_credential_wire(c: s) == host_custody_credential_wire(c: c)
      HostCustodyCredentialUnrostered { supplied: _ } => false
    })
    && length(host_custody_credential_options) == length(host_custody_credential_roster)
}

test fn an_unrostered_credential_word_refuses_rather_than_naming_a_secret() -> Bool {
  match select_host_custody_credential(supplied: "ci-github-app-private-key") {
    HostCustodyCredentialUnrostered { supplied: s } => s == "ci-github-app-private-key"
    HostCustodyCredentialSelected { credential: _ } => false
  }
}

// ── the controller key: its former constants are its row's fields ───────────────────────────────

test fn the_controller_row_is_root_only_0400_in_a_0700_directory() -> Bool {
  let f = custody_file_legs(row: controller_row)
  let d = custody_dir_legs(row: controller_row)
  f.exact_perm == "0400" && f.forbidden_perm == "/077"
    && d.exact_perm == "0700" && d.forbidden_perm == "/077"
    && (f.ownership.user as String) == "root" && (f.ownership.group as String) == "root"
    && (d.ownership.user as String) == "root" && (d.ownership.group as String) == "root"
}

test fn the_controller_key_places_in_its_own_directory_under_etc() -> Bool {
  match custody_row_placement(row: controller_row) {
    CustodyPlaced { row: _, key_dir: d, upper_ancestors: ua } =>
      (d as String) == "/etc/gunbc/microvm-controller" && ua == ["/etc", "/etc/gunbc"]
    CustodyPlacementRefused { cause: _ } => false
  }
}

test fn a_custody_path_under_the_attempt_tree_is_refused() -> Bool {
  let row = HostCredentialCustodyRow {
    credential: controller_row.credential, secret: controller_row.secret,
    path: "/opt/fabric-cells/slot-1/attempts/a1/app.pem" as NonEmptyStr,
    host_scope: controller_row.host_scope,
    file_ownership: controller_row.file_ownership, file_mode: controller_row.file_mode,
    dir_ownership: controller_row.dir_ownership, dir_mode: controller_row.dir_mode,
    export_receipt: controller_row.export_receipt,
    medium: controller_row.medium,
  }
  match custody_row_placement(row: row) {
    CustodyPlacementRefused { cause: CustodyPathInForbiddenTree { path: _ } } => true
    _ => false
  }
}

// ── the ntfy publisher token: a group row, and the directory field that makes it readable ───────

test fn the_ntfy_row_is_0640_root_ntfy_in_a_0750_root_ntfy_directory() -> Bool {
  let f = custody_file_legs(row: ntfy_row)
  let d = custody_dir_legs(row: ntfy_row)
  f.exact_perm == "0640" && f.forbidden_perm == "/037"
    && d.exact_perm == "0750" && d.forbidden_perm == "/027"
    && (f.ownership.user as String) == "root" && (f.ownership.group as String) == "gunbc-ntfy"
    && (d.ownership.group as String) == "gunbc-ntfy"
}

// THE PATH IS THE READ SIDE'S, AND ITS DIRECTORY IS THE SERVER'S CONFIG DIRECTORY.
test fn the_ntfy_token_places_in_the_ntfy_config_directory() -> Bool {
  match custody_row_placement(row: ntfy_row) {
    CustodyPlaced { row: _, key_dir: d, upper_ancestors: ua } =>
      (d as String) == (approval_ntfy_config_dir as String) && ua == ["/etc"]
    CustodyPlacementRefused { cause: _ } => false
  }
}

// ONE DIRECTORY, ONE AUTHORITY -- AND THAT IS WHY THE EQUALITY ROW THAT STOOD HERE IS GONE.
//
// The custody row and gunbc.auth.approval_ntfy_converge NtfyConfigDirectory both ensure
// approval_ntfy_config_dir, and while each named its own octal a test held the two EQUAL so a
// disagreement would not flap the directory on every run. That row was §5's validation standing
// where construction was available: it could only ever report a fork it had no power to prevent.
// Both sides now read gunbc.auth.approval_ntfy_deployment approval_ntfy_dir_mode and the group from
// approval_ntfy_principal_name, so the comparison it made is a value against itself -- redundant,
// and deleted rather than kept as coverage it no longer provides.
//
// WHAT REPLACES IT IS ABOVE, NOT ABSENT. the_ntfy_row_is_0640_root_ntfy_in_a_0750_root_ntfy_directory
// still holds the derived octal against a literal 0750, which is a controlled expected value rather
// than a second authority -- it is the row that would go red if the shared arm were ever changed to
// a mode the ntfy server cannot enter, and it is now the only place that number is asserted.

// ── THE RED CONTROL: a group-readable file under a directory that denies the group traversal ────
//
// The real ntfy row with ONE field changed -- its directory arm narrowed to owner-only -- must
// REFUSE at admission, typed and located, rather than place (the predecessor's constant) or widen
// the directory (an absorbing fallback). The positive control is the_ntfy_token_places_... above:
// the same row, unchanged, places.
test fn a_group_readable_token_under_an_untraversable_directory_refuses() -> Bool {
  let row = HostCredentialCustodyRow {
    credential: ntfy_row.credential, secret: ntfy_row.secret, path: ntfy_row.path,
    host_scope: ntfy_row.host_scope,
    file_ownership: ntfy_row.file_ownership, file_mode: ntfy_row.file_mode,
    dir_ownership: ntfy_row.dir_ownership, dir_mode: DirectoryOwnerOnly,
    export_receipt: ntfy_row.export_receipt,
    medium: ntfy_row.medium,
  }
  match custody_row_placement(row: row) {
    CustodyPlacementRefused { cause: CustodyGroupCannotTraverse { path: p, dir: d, group: g, file_perm: fp, dir_perm: dp } } =>
      (p as String) == "/etc/gunbc-ntfy/publisher-token"
        && (d as String) == "/etc/gunbc-ntfy"
        && (g as String) == "gunbc-ntfy"
        && fp == "0640" && dp == "0700"
        && string_contains(s: custody_placement_refusal_wire(r: CustodyGroupCannotTraverse { path: p, dir: d, group: g, file_perm: fp, dir_perm: dp }), pattern: "denies that group traversal")
    _ => false
  }
}

test fn a_group_readable_token_whose_directory_is_another_group_refuses() -> Bool {
  let row = HostCredentialCustodyRow {
    credential: ntfy_row.credential, secret: ntfy_row.secret, path: ntfy_row.path,
    host_scope: ntfy_row.host_scope,
    file_ownership: ntfy_row.file_ownership, file_mode: ntfy_row.file_mode,
    dir_ownership: PosixOwnerNames { user: "root" as NonEmptyStr, group: "root" as NonEmptyStr },
    dir_mode: ntfy_row.dir_mode,
    export_receipt: ntfy_row.export_receipt,
    medium: ntfy_row.medium,
  }
  match custody_row_placement(row: row) {
    CustodyPlacementRefused { cause: CustodyDirectoryGroupDiffers { path: _, file_group: fg, dir_group: dg } } =>
      (fg as String) == "gunbc-ntfy" && (dg as String) == "root"
    _ => false
  }
}

// ── far-side legs derive from the row ───────────────────────────────────────────────────────────

test fn the_owner_leg_takes_user_and_group_from_the_row() -> Bool {
  custody_find_argv(path: "/p", kind: "f", clause: custody_owner_clause(o: custody_file_legs(row: ntfy_row).ownership))
    == ["find", "/p", "-maxdepth", "0", "-type", "f", "-user", "root", "-group", "gunbc-ntfy"]
}

test fn the_mode_legs_ask_for_the_arm_exactly_and_forbid_its_complement() -> Bool {
  custody_find_argv(path: "/p", kind: "f", clause: custody_perm_clause(perm: custody_file_legs(row: controller_row).exact_perm))
    == ["find", "/p", "-maxdepth", "0", "-type", "f", "-perm", "0400"]
    && custody_perm_clause(perm: custody_file_legs(row: ntfy_row).forbidden_perm) == ["-perm", "/037"]
}

test fn the_directory_ensure_and_the_file_owner_come_from_the_row() -> Bool {
  custody_dir_ensure_argv(row: ntfy_row, dir: "/etc/gunbc-ntfy")
    == ["install", "-d", "-m", "00750", "-o", "root", "-g", "gunbc-ntfy", "/etc/gunbc-ntfy"]
    && custody_file_chown_argv(row: ntfy_row) == ["/usr/bin/chown", "root:gunbc-ntfy", "/etc/gunbc-ntfy/publisher-token"]
}

// ── host scope ──────────────────────────────────────────────────────────────────────────────────

// THE DISCRIMINATING PAIR FOR THE TARGET: a row scoped to one host delivers there whichever executor
// the dispatch placed the run on, and a row for any runner host delivers to the executor itself. If the
// target is re-read off the dispatch, the srv2-executor arm of the ntfy row reddens; if the any-host
// row stops following its executor, the controller arm does.
test fn the_ntfy_token_is_delivered_to_srv1_only() -> Bool {
  let from_srv1 = (custody_target_host(row: ntfy_row, executor: "srv1" as HostIdentity) as String) == "srv1"
  let from_srv2 = (custody_target_host(row: ntfy_row, executor: "srv2" as HostIdentity) as String) == "srv1"
  let controller_follows_executor = (custody_target_host(row: controller_row, executor: "srv2" as HostIdentity) as String) == "srv2"
  from_srv1 && from_srv2 && controller_follows_executor
}

// THE INCIDENT, AS A CLAIM. The Cursor row is scoped to srv2 and srv2 has no runner slots, so the only
// executor that can run it is another host; dispatched from srv1 it must still target srv2 and resolve
// srv2's administrator edge, never srv1's.
test fn the_cursor_row_dispatched_from_srv1_targets_srv2() -> Bool {
  let row = host_credential_custody_row(c: CursorWorkerTurnApiKey)
  match custody_host(host: custody_target_host(row: row, executor: "srv1" as HostIdentity)) {
    CustodyHostSubjectAdmitted { subject: s } => (s.host as String) == (operator_host_srv2 as String)
    CustodyHostSubjectRefused { cause: _ } => false
  }
}

// ── readback verdict ────────────────────────────────────────────────────────────────────────────

data declared_reading: CustodyFindReading = CustodyFindReading { owned_as_declared: true, forbidden_bits: false, exact_mode: true }

data staging_path: String = "/etc/gunbc-ntfy/publisher-token.gunbc-staging"
data staging_name: String = "publisher-token.gunbc-staging"
data cleanup_dir: String = "/etc/gunbc-ntfy"

// THE STAGING READING IS SUPPLIED AS THE VALUE IT IS: classify_staging_residue is pure over a
// listing that SUCCEEDED, so StagingUnobservable belongs to the leg and is supplied directly.
fn staging_from_listing(listing: String) -> StagingResidue {
  classify_staging_residue(path: staging_path, name: staging_name, stdout: listing)
}

data clean_listing: String = "server.yml\npublisher-token"

fn readback_with(file: CustodyFindReading, staging: StagingResidue, content_identical: Bool) -> CustodyReadback {
  CustodyReadback {
    file: classify_custody_path(reading: file),
    dir: classify_custody_path(reading: declared_reading),
    upper_ancestors: PathsRootOnly,
    content: if content_identical { HostFileIdentical } else { HostFileDiffers },
    staging: staging,
    readers: CustodyReadersNotDeclared,
  }
}

fn is_held(r: CustodyReadback) -> Bool {
  match host_credential_custody(row: ntfy_row, readback: r) {
    CustodyHeld => true
    CustodyNotHeld { causes: _ } => false
  }
}

test fn a_declared_identical_token_with_no_staging_is_held() -> Bool {
  is_held(r: readback_with(file: declared_reading, staging: staging_from_listing(listing: clean_listing), content_identical: true))
}

test fn a_wrong_owner_is_not_held_and_names_the_declared_owner() -> Bool {
  let r = readback_with(file: CustodyFindReading { owned_as_declared: false, forbidden_bits: false, exact_mode: true }, staging: staging_from_listing(listing: clean_listing), content_identical: true)
  match host_credential_custody(row: ntfy_row, readback: r) {
    CustodyNotHeld { causes: cs } => any(cs, c => string_contains(s: c, pattern: "WRONG-OWNER (declared owner=root:gunbc-ntfy mode=0640)"))
    CustodyHeld => false
  }
}

test fn forbidden_bits_are_not_held() -> Bool {
  let r = readback_with(file: CustodyFindReading { owned_as_declared: true, forbidden_bits: true, exact_mode: false }, staging: staging_from_listing(listing: clean_listing), content_identical: true)
  !is_held(r: r) && match r.file {
    CustodyPathForbiddenBits => true
    _ => false
  }
}

test fn a_mode_other_than_the_arm_is_not_held() -> Bool {
  let r = readback_with(file: CustodyFindReading { owned_as_declared: true, forbidden_bits: false, exact_mode: false }, staging: staging_from_listing(listing: clean_listing), content_identical: true)
  !is_held(r: r) && match r.file {
    CustodyPathModeNotDeclared => true
    _ => false
  }
}

test fn differing_bytes_are_not_held() -> Bool {
  !is_held(r: readback_with(file: declared_reading, staging: staging_from_listing(listing: clean_listing), content_identical: false))
}

test fn a_surviving_staging_sibling_is_not_held() -> Bool {
  let r = readback_with(file: declared_reading, staging: staging_from_listing(listing: "publisher-token\npublisher-token.gunbc-staging"), content_identical: true)
  !is_held(r: r) && match r.staging {
    StagingResiduePresent { path: _ } => true
    _ => false
  }
}

test fn an_unrunnable_staging_listing_is_unobservable_not_absent() -> Bool {
  let r = readback_with(file: declared_reading, staging: StagingUnobservable { reason: "staging parent listing exit=2 ls: cannot open directory" }, content_identical: true)
  !is_held(r: r) && match r.staging {
    StagingUnobservable { reason: _ } => true
    _ => false
  }
}

// ── the decision before a write ─────────────────────────────────────────────────────────────────

test fn an_identical_file_with_wrong_owner_is_rewritten_not_left() -> Bool {
  match custody_action(dir: CustodyPathAsDeclared, upper_ancestors: PathsRootOnly, content: HostFileIdentical, file: CustodyPathWrongOwner) {
    CustodyWrite => true
    _ => false
  }
}

test fn a_declared_file_is_left_in_place() -> Bool {
  match custody_action(dir: CustodyPathAsDeclared, upper_ancestors: PathsRootOnly, content: HostFileIdentical, file: CustodyPathAsDeclared) {
    CustodyLeaveInPlace => true
    _ => false
  }
}

test fn a_directory_not_as_declared_refuses_before_any_content_write() -> Bool {
  match custody_action(dir: CustodyPathForbiddenBits, upper_ancestors: PathsRootOnly, content: HostFileDiffers, file: CustodyPathAbsent) {
    CustodyActionRefused { reason: _ } => true
    _ => false
  }
}

test fn a_writable_ancestor_refuses_before_any_content_write() -> Bool {
  match custody_action(dir: CustodyPathAsDeclared, upper_ancestors: PathsNotRootOnly { paths: ["/etc"], detail: "" }, content: HostFileDiffers, file: CustodyPathAbsent) {
    CustodyActionRefused { reason: _ } => true
    _ => false
  }
}

// ── the custody subject is a host, independent of slot width (gunbc#11902) ─────────────────────

// THE DISCRIMINATING PAIR: srv2's runner width is unresolved, so the deploy route refuses it while
// custody_host admits it from the spec. If custody is re-coupled to the deploy row, the first reddens.
test fn srv2_resolves_a_custody_subject_although_its_slot_width_is_unresolved() -> Bool {
  match custody_host(host: operator_host_srv2) {
    CustodyHostSubjectAdmitted { subject: s } => (s.host as String) == (operator_host_srv2 as String)
    CustodyHostSubjectRefused { cause: _ } => false
  }
}

test fn the_deploy_route_still_refuses_srv2() -> Bool {
  match runner_host_file_subject(host: operator_host_srv2) {
    RunnerHostFileSubjectRefused { cause: _ } => true
    RunnerHostFileSubjectAdmitted { subject: _ } => false
  }
}

// The ntfy row is scoped to srv1, so srv1 must resolve as a custody subject or the row can never run.
test fn srv1_resolves_a_custody_subject() -> Bool {
  match custody_host(host: "srv1" as HostIdentity) {
    CustodyHostSubjectAdmitted { subject: _ } => true
    CustodyHostSubjectRefused { cause: _ } => false
  }
}

test fn a_host_with_no_runner_spec_is_refused_as_a_custody_subject() -> Bool {
  match custody_host(host: "not-a-fleet-host" as HostIdentity) {
    CustodyHostSubjectRefused { cause: c } => string_contains(s: c, pattern: "no runner host spec")
    CustodyHostSubjectAdmitted { subject: _ } => false
  }
}

// ── staging absence comes from the parent listing ───────────────────────────────────────────────

test fn a_parent_listing_without_the_staging_name_establishes_absence() -> Bool {
  match staging_from_listing(listing: clean_listing) {
    StagingAbsent => true
    _ => false
  }
}

test fn an_empty_parent_listing_is_absence_because_the_parent_was_read() -> Bool {
  match staging_from_listing(listing: "") {
    StagingAbsent => true
    _ => false
  }
}

// ── cleanup is a root mutation, so it carries the same path authority the write does ────────────

fn cleanup_withheld_reason(upper: FleetHostPathMetadata, dir: CustodyPathMetadata, staging: String) -> String {
  match custody_host(host: operator_host_srv2) {
    CustodyHostSubjectRefused { cause: _ } => ""
    CustodyHostSubjectAdmitted { subject: s } =>
      match admit_staging_cleanup(subject: s, upper_ancestors: upper, dir: dir, key_dir: cleanup_dir, staging: staging) {
        StagingCleanupWithheld { reason: r } => r
        StagingCleanupAuthorized { authorization: _ } => ""
      }
  }
}

test fn a_writable_upper_ancestor_withholds_the_staging_cleanup() -> Bool {
  string_contains(s: cleanup_withheld_reason(upper: PathsNotRootOnly { paths: ["/etc"], detail: "" }, dir: CustodyPathAsDeclared, staging: staging_path), pattern: "ancestor")
}

test fn a_directory_not_as_declared_withholds_the_staging_cleanup() -> Bool {
  string_contains(s: cleanup_withheld_reason(upper: PathsRootOnly, dir: CustodyPathForbiddenBits, staging: staging_path), pattern: "not as the row declares")
}

test fn an_unreadable_directory_withholds_the_staging_cleanup() -> Bool {
  string_contains(s: cleanup_withheld_reason(upper: PathsRootOnly, dir: CustodyPathUnobservable { reason: "find leg exit=1" }, staging: staging_path), pattern: "unobservable")
}

test fn a_staging_path_outside_the_admitted_directory_is_withheld() -> Bool {
  string_contains(s: cleanup_withheld_reason(upper: PathsRootOnly, dir: CustodyPathAsDeclared, staging: "/tmp/publisher-token.gunbc-staging"), pattern: "admitted directory")
}

// THE POSITIVE CONTROL: the seal names the exact parent and staging path the leg will run over.
test fn declared_ancestors_and_directory_authorize_the_exact_staging_path() -> Bool {
  match custody_host(host: operator_host_srv2) {
    CustodyHostSubjectRefused { cause: _ } => false
    CustodyHostSubjectAdmitted { subject: s } =>
      match admit_staging_cleanup(subject: s, upper_ancestors: PathsRootOnly, dir: CustodyPathAsDeclared, key_dir: cleanup_dir, staging: staging_path) {
        StagingCleanupAuthorized { authorization: z } => z.staging == staging_path && z.parent == cleanup_dir
        StagingCleanupWithheld { reason: _ } => false
      }
  }
}

// The state key must be usable by the operator-run site without admitting CI job users.
test fn protected_state_key_has_operator_group_custody_outside_job_trees() -> Bool {
  let row = host_credential_custody_row(c: FabricStateWriterKey)
  let f = custody_file_legs(row: row)
  let d = custody_dir_legs(row: row)
  f.exact_perm == "0640" && f.forbidden_perm == "/037"
    && d.exact_perm == "0750" && d.forbidden_perm == "/027"
    && (f.ownership.user as String) == "root" && (f.ownership.group as String) == "gunbc-fabric-state-key"
    && (d.ownership.user as String) == "root" && (d.ownership.group as String) == "gunbc-fabric-state-key"
    && placed(row: row)
}

// ── worker-turn credentials (node adhoc-932f2935-e8e) ───────────────────────────────────────────

// THE CODEX ROW CANNOT BE SPREAD. The same row with its scope widened to any runner host is refused
// at placement, so a second host can never receive the store's lagging copy of a token codex rotated.
// The control is the row as declared, which places.
test fn a_host_authoritative_row_on_any_runner_host_is_refused_at_placement() -> Bool {
  let row = host_credential_custody_row(c: CodexWorkerTurnAuth)
  let widened = HostCredentialCustodyRow {
    credential: row.credential, secret: row.secret, path: row.path,
    host_scope: CustodyAnyRunnerHost,
    file_ownership: row.file_ownership, file_mode: row.file_mode,
    dir_ownership: row.dir_ownership, dir_mode: row.dir_mode,
    export_receipt: row.export_receipt,
    medium: row.medium,
  }
  let refused = match custody_row_placement(row: widened) {
    CustodyPlacementRefused { cause } =>
      match cause {
        CustodyHostAuthoritativeNotSingleHost { path: _ } => true
        _ => false
      }
    CustodyPlaced { row: _, key_dir: _, upper_ancestors: _ } => false
  }
  let declared_places = match custody_row_placement(row: row) {
    CustodyPlaced { row: _, key_dir: kd, upper_ancestors: _ } => (kd as String) == "/etc/gunbc-codex-harness"
    CustodyPlacementRefused { cause: _ } => false
  }
  refused && declared_places
}

// A store-authoritative row widened the same way still places: the refusal is about authority, not
// about the worker-turn rows.
test fn a_store_authoritative_row_on_any_runner_host_still_places() -> Bool {
  let row = host_credential_custody_row(c: CursorWorkerTurnApiKey)
  let widened = HostCredentialCustodyRow {
    credential: row.credential, secret: row.secret, path: row.path,
    host_scope: CustodyAnyRunnerHost,
    file_ownership: row.file_ownership, file_mode: row.file_mode,
    dir_ownership: row.dir_ownership, dir_mode: row.dir_mode,
    export_receipt: row.export_receipt,
    medium: row.medium,
  }
  match custody_row_placement(row: widened) {
    CustodyPlaced { row: _, key_dir: _, upper_ancestors: _ } => true
    CustodyPlacementRefused { cause: _ } => false
  }
}

test fn the_codex_row_is_delivered_only_to_its_custody_host() -> Bool {
  let row = host_credential_custody_row(c: CodexWorkerTurnAuth)
  let from_other = (custody_target_host(row: row, executor: "srv1" as HostIdentity) as String) == (codex_worker_turn_custody_host as String)
  let from_own = (custody_target_host(row: row, executor: codex_worker_turn_custody_host) as String) == (codex_worker_turn_custody_host as String)
  from_other && from_own && (codex_worker_turn_custody_host as String) == (operator_host_srv2 as String)
}

// THE DISCRIMINATING PAIR FOR A DIFFERING HOST FILE. The store-authoritative decision for differing
// bytes is CustodyWrite, which would put a spent token back. Host-authoritative: a file whose refresh
// token did not move is LEFT (it is only fresher in short-lived tokens), and one whose refresh token
// moved is written BACK to the store, never overwritten.
test fn a_differing_host_file_is_left_or_written_back_never_overwritten() -> Bool {
  let base = custody_action(dir: CustodyPathAsDeclared, upper_ancestors: PathsRootOnly, content: HostFileDiffers, file: CustodyPathAsDeclared)
  let base_writes = match base {
    CustodyWrite => true
    _ => false
  }
  let left = match host_authoritative_custody_action(base: base, content: HostFileDiffers, decision: Present { value: CodexHarnessWriteBackNotOwed }) {
    CustodyLeaveInPlace => true
    _ => false
  }
  let written_back = match host_authoritative_custody_action(
    base: base, content: HostFileDiffers,
    decision: Present { value: CodexHarnessWriteBackOwed { payload: "{\"auth_mode\":\"chatgpt\"}" as Secret } },
  ) {
    CustodyWriteBackToStore { payload: _ } => true
    _ => false
  }
  base_writes && left && written_back
}

test fn a_host_file_naming_another_account_refuses() -> Bool {
  let base = custody_action(dir: CustodyPathAsDeclared, upper_ancestors: PathsRootOnly, content: HostFileDiffers, file: CustodyPathAsDeclared)
  match host_authoritative_custody_action(
    base: base, content: HostFileDiffers,
    decision: Present { value: CodexHarnessWriteBackRefused { cause: CodexHarnessReadBackAccountChanged { materialized: "acct-a" as NonEmptyStr, read_back: "acct-b" as NonEmptyStr } } },
  ) {
    CustodyActionRefused { reason: _ } => true
    _ => false
  }
}

// An absent host file is placed from the store CREATE-ONLY (first placement), and a directory that is not as
// declared still refuses before anything: the host-authoritative layer only changes the differing arm.
test fn absent_host_file_is_placed_and_a_bad_directory_still_refuses() -> Bool {
  let absent_base = custody_action(dir: CustodyPathAsDeclared, upper_ancestors: PathsRootOnly, content: gunbc.runner.runner_host_file_converge.HostFileAbsent, file: CustodyPathAbsent)
  let placed = match host_authoritative_custody_action(base: absent_base, content: gunbc.runner.runner_host_file_converge.HostFileAbsent, decision: none) {
    CustodyCreateOnly => true
    _ => false
  }
  let bad_dir = custody_action(dir: CustodyPathForbiddenBits, upper_ancestors: PathsRootOnly, content: HostFileDiffers, file: CustodyPathAsDeclared)
  let still_refused = match host_authoritative_custody_action(base: bad_dir, content: HostFileDiffers, decision: Present { value: CodexHarnessWriteBackNotOwed }) {
    CustodyActionRefused { reason: _ } => true
    _ => false
  }
  placed && still_refused
}

// THE METADATA-REPAIR ROUTE (side-chat P2). Identical bytes with a wrong owner or mode make the
// ordinary decision CustodyWrite, whose store-to-host content write renames the STORE bytes over the
// live file outside the codex turn lock and would lose a refresh that landed in between. A
// host-authoritative row must repair the metadata in place instead, and a store-authoritative row
// keeps the ordinary rewrite.
test fn a_host_authoritative_file_with_wrong_metadata_is_repaired_in_place_never_rewritten() -> Bool {
  let base = custody_action(dir: CustodyPathAsDeclared, upper_ancestors: PathsRootOnly, content: HostFileIdentical, file: CustodyPathForbiddenBits)
  let ordinary_rewrites = match base {
    CustodyWrite => true
    _ => false
  }
  let repaired = match host_authoritative_custody_action(base: base, content: HostFileIdentical, decision: none) {
    CustodyRepairMetadataInPlace => true
    _ => false
  }
  ordinary_rewrites && repaired
}

// A file that is already declared is untouched, host-authoritative or not.
test fn a_declared_host_authoritative_file_is_left_in_place() -> Bool {
  let base = custody_action(dir: CustodyPathAsDeclared, upper_ancestors: PathsRootOnly, content: HostFileIdentical, file: CustodyPathAsDeclared)
  match host_authoritative_custody_action(base: base, content: HostFileIdentical, decision: none) {
    CustodyLeaveInPlace => true
    _ => false
  }
}

// ── the fabric state key's reader set ───────────────────────────────────────────────────────────
//
// WHAT IS EXECUTED HERE (DESIGN 4b rung honesty): the declared set, the getent classification and
// the mutation decision, over supplied getent answers, plus the real row's group. WHAT IS NOT: the
// far-side groupadd/gpasswd/getent legs have no hermetic seam, so their inhabitance is the dispatched
// custody converge's receipt `readers=` line, which the operator applies. The readback is a
// group-database reading; it does not establish that any other principal is refused open of the file,
// and it does not observe ghrunner's hand-made membership of the operator group.

data fabric_reader_declared: CustodyReaderSet? = custody_reader_set(c: FabricStateWriterKey, job_user: "ghrunner" as NonEmptyStr)

test fn the_fabric_key_reader_set_is_the_operator_service_and_the_host_job_user() -> Bool {
  match fabric_reader_declared {
    Present { value: d } =>
      (d.group as String) == "gunbc-fabric-state-key"
        && map(d.members, m => m as String) == ["briansrls", "ghrunner"]
    Absent => false
  }
}

test fn only_the_fabric_key_declares_a_reader_set() -> Bool {
  let others = [ControllerAppKey, ApprovalNtfyPublisherToken, CursorWorkerTurnApiKey, CodexWorkerTurnAuth]
  all(others, c => match custody_reader_set(c: c, job_user: "ghrunner" as NonEmptyStr) {
    Absent => true
    Present { value: _ } => false
  })
}

test fn the_declared_members_read_back_as_declared() -> Bool {
  match classify_custody_readers(declared: fabric_reader_declared, exit_code: 0, stdout: "gunbc-fabric-state-key:x:1500:ghrunner,briansrls\n", stderr: "") {
    CustodyReadersAsDeclared { group: g } => (g as String) == "gunbc-fabric-state-key"
    _ => false
  }
}

test fn an_undeclared_member_refuses_and_nothing_is_mutated() -> Bool {
  let st = classify_custody_readers(declared: fabric_reader_declared, exit_code: 0, stdout: "gunbc-fabric-state-key:x:1500:briansrls,ghrunner,kvmuser\n", stderr: "")
  let named = match st {
    CustodyReadersUnexpectedMember { group: _, unexpected: u } => u == ["kvmuser"]
    _ => false
  }
  let refused = match custody_readers_action(declared: fabric_reader_declared, before: st) {
    CustodyReadersRefused { reason: _ } => true
    _ => false
  }
  named && refused
}

test fn a_missing_member_is_added_without_recreating_the_group() -> Bool {
  let st = classify_custody_readers(declared: fabric_reader_declared, exit_code: 0, stdout: "gunbc-fabric-state-key:x:1500:briansrls\n", stderr: "")
  match custody_readers_action(declared: fabric_reader_declared, before: st) {
    CustodyReadersAdd { group: _, add: a } => a == ["ghrunner"]
    _ => false
  }
}

test fn an_absent_group_is_created_then_populated_with_the_whole_declared_set() -> Bool {
  let st = classify_custody_readers(declared: fabric_reader_declared, exit_code: 2, stdout: "", stderr: "")
  match custody_readers_action(declared: fabric_reader_declared, before: st) {
    CustodyReadersCreateAndAdd { group: _, add: a } => a == ["briansrls", "ghrunner"]
    _ => false
  }
}

test fn an_empty_group_record_reads_as_every_member_missing() -> Bool {
  match classify_custody_readers(declared: fabric_reader_declared, exit_code: 0, stdout: "gunbc-fabric-state-key:x:1500:\n", stderr: "") {
    CustodyReadersMissingMember { group: _, missing: m } => m == ["briansrls", "ghrunner"]
    _ => false
  }
}

// A broken probe is never read as an absent group (which would recreate it) or as a member list.
test fn an_unreadable_group_database_refuses_rather_than_reading_as_absent() -> Bool {
  let failed = classify_custody_readers(declared: fabric_reader_declared, exit_code: 127, stdout: "", stderr: "getent: not found")
  let garbled = classify_custody_readers(declared: fabric_reader_declared, exit_code: 0, stdout: "warning banner", stderr: "")
  let first = match custody_readers_action(declared: fabric_reader_declared, before: failed) {
    CustodyReadersRefused { reason: _ } => true
    _ => false
  }
  let second = match custody_readers_action(declared: fabric_reader_declared, before: garbled) {
    CustodyReadersRefused { reason: _ } => true
    _ => false
  }
  first && second
}

test fn a_row_without_a_declared_set_has_nothing_to_do() -> Bool {
  match custody_readers_action(declared: none, before: CustodyReadersNotDeclared) {
    CustodyReadersNothingToDo => true
    _ => false
  }
}

// The mutation legs append one login; the member list is never replaced.
test fn the_membership_legs_create_idempotently_and_append_never_replace() -> Bool {
  custody_groupadd_argv(group: "gunbc-fabric-state-key" as NonEmptyStr) == ["groupadd", "-f", "--", "gunbc-fabric-state-key"]
    && custody_group_add_member_argv(group: "gunbc-fabric-state-key" as NonEmptyStr, login: "ghrunner") == ["gpasswd", "-a", "ghrunner", "gunbc-fabric-state-key"]
    && custody_getent_group_argv(group: "gunbc-fabric-state-key" as NonEmptyStr) == ["getent", "group", "gunbc-fabric-state-key"]
}

// The readback gates custody: a held file under an unexpected group member is NOT held.
test fn an_unexpected_group_member_makes_custody_not_held_even_when_the_file_is_declared() -> Bool {
  let r = CustodyReadback {
    file: classify_custody_path(reading: declared_reading),
    dir: classify_custody_path(reading: declared_reading),
    upper_ancestors: PathsRootOnly,
    content: HostFileIdentical,
    staging: staging_from_listing(listing: clean_listing),
    readers: CustodyReadersUnexpectedMember { group: "gunbc-fabric-state-key" as NonEmptyStr, unexpected: ["kvmuser"] },
  }
  match host_credential_custody(row: host_credential_custody_row(c: FabricStateWriterKey), readback: r) {
    CustodyNotHeld { causes: cs } => any(cs, c => string_contains(s: c, pattern: "UNEXPECTED-MEMBER"))
    CustodyHeld => false
  }
}

test fn the_gunbai_bot_publication_key_is_0640_root_publication_on_srv1() -> Bool {
  let row = host_credential_custody_row(c: GunbaiBotPublicationAppKey)
  let f = custody_file_legs(row: row)
  (f.exact_perm == "0640")
    && (f.ownership.user as String) == "root"
    && (f.ownership.group as String) == "gunbc-publication"
    && (row.path as String) == "/etc/gunbc/publication/gunbai-bot.pem"
    && match row.host_scope {
      CustodyOnlyOnHost { host: h } => (h as String) == "srv1"
      CustodyAnyRunnerHost => false
    }
}

test fn the_gunbai_bot_publication_key_does_not_owe_an_export_receipt() -> Bool {
  match host_credential_custody_row(c: GunbaiBotPublicationAppKey).export_receipt {
    CustodyExportReceiptNotOwed => true
    CustodyExportReceiptOwed => false
  }
}

test fn the_gunbai_bot_publication_key_reader_set_is_the_publication_principal() -> Bool {
  match custody_reader_set(c: GunbaiBotPublicationAppKey, job_user: "ghrunner" as NonEmptyStr) {
    Present { value: d } =>
      (d.group as String) == "gunbc-publication"
        && map(d.members, m => m as String) == ["gunbc-publication"]
    Absent => false
  }
}

// ── the service-slot App key: tmpfs-only by construction ────────────────────────────────────────

data service_slot_row: HostCredentialCustodyRow = host_credential_custody_row(c: ServiceSlotAppKey)

test fn the_service_slot_key_places_below_run_and_asks_the_host_for_a_noswap_tmpfs() -> Bool {
  match custody_row_placement(row: service_slot_row) {
    CustodyPlaced { row: _, key_dir: d, upper_ancestors: _ } =>
      (d as String) == "/run/gunbc-service-slot"
        && custody_file_legs(row: service_slot_row).medium == CustodyTmpfsNoSwap
        && custody_dir_legs(row: service_slot_row).medium == CustodyTmpfsNoSwap
    CustodyPlacementRefused { cause: _ } => false
  }
}

// THE RED: the same tmpfs-only row moved onto the persistent filesystem is refused before any write.
test fn a_tmpfs_noswap_row_on_the_etc_tree_is_refused_as_outside_its_medium() -> Bool {
  let r = service_slot_row
  let moved = HostCredentialCustodyRow {
    credential: r.credential, secret: r.secret, path: "/etc/gunbc/service-slot/app.pem" as NonEmptyStr,
    host_scope: r.host_scope, file_ownership: r.file_ownership, file_mode: r.file_mode,
    dir_ownership: r.dir_ownership, dir_mode: r.dir_mode, export_receipt: r.export_receipt, medium: r.medium,
  }
  match custody_row_placement(row: moved) {
    CustodyPlacementRefused { cause: CustodyPathOutsideScope { path: _, scope_root: root } } => (root as String) == "/run"
    CustodyPlacementRefused { cause: _ } => false
    CustodyPlaced { row: _, key_dir: _, upper_ancestors: _ } => false
  }
}

// POSITIVE CONTROL: a disk-backed row asks the host nothing about the medium.
test fn a_disk_backed_row_asks_nothing_of_the_mount_table() -> Bool {
  custody_file_legs(row: controller_row).medium == CustodyDiskBacked && controller_row.medium == CustodyDiskBacked
    && service_slot_row.medium == CustodyTmpfsNoSwap
    && (match custody_medium_reading(m: CustodyDiskBacked, mount_table: "", path: "/etc/gunbc/x") { CustodyMediumAsDeclared => true _ => false })
    && custody_mount_table_argv == ["cat", "/proc/self/mountinfo"]
}

// ── the medium is a tmpfs that cannot swap, read from the mount table before the first write ─────

data mount_table_run_plain: String = "20 25 0:21 / /run rw,nosuid,nodev,noexec - tmpfs tmpfs rw,size=3258708k,mode=755\n25 1 8:2 / / rw,relatime - ext4 /dev/sda2 rw,errors=remount-ro"
data mount_table_key_mount_noswap: String = "20 25 0:21 / /run rw,nosuid,nodev,noexec - tmpfs tmpfs rw,size=3258708k,mode=755\n25 1 8:2 / / rw,relatime - ext4 /dev/sda2 rw,errors=remount-ro\n41 20 0:40 / /run/gunbc-service-slot rw,nosuid,nodev - tmpfs tmpfs rw,size=1024k,mode=700,noswap"
data mount_table_key_mount_plain: String = "20 25 0:21 / /run rw,nosuid,nodev,noexec - tmpfs tmpfs rw,size=3258708k,mode=755\n41 20 0:40 / /run/gunbc-service-slot rw,nosuid,nodev - tmpfs tmpfs rw,size=1024k,mode=700"
data service_slot_key_path: String = "/run/gunbc-service-slot/app.pem"

fn service_slot_medium_reading(table: String) -> CustodyMediumReading {
  custody_medium_reading(m: CustodyTmpfsNoSwap, mount_table: table, path: service_slot_key_path)
}

// POSITIVE CONTROL: a tmpfs mounted noswap holds the key path.
test fn a_noswap_tmpfs_holding_the_key_path_is_the_declared_medium() -> Bool {
  match service_slot_medium_reading(table: mount_table_key_mount_noswap) {
    CustodyMediumAsDeclared => true
    CustodyMediumNotDeclared => false
    CustodyMediumUnreadable { reason: _ } => false
  }
}

// THE RED (blocker: tmpfs can swap): the SAME tmpfs fstype WITHOUT noswap -- a kernel older than 6.4 reports
// none -- is not the medium, whether it is the dedicated mount or the host's plain /run.
test fn a_tmpfs_without_noswap_is_not_the_declared_medium() -> Bool {
  (match service_slot_medium_reading(table: mount_table_key_mount_plain) {
    CustodyMediumNotDeclared => true
    CustodyMediumAsDeclared => false
    CustodyMediumUnreadable { reason: _ } => false
  }) && (match service_slot_medium_reading(table: mount_table_run_plain) {
    CustodyMediumNotDeclared => true
    CustodyMediumAsDeclared => false
    CustodyMediumUnreadable { reason: _ } => false
  })
}

// A noswap mount that is NOT the one holding the path (a sibling whose name only shares the prefix) does not
// vouch for it: the plain /run holds the path, so the reading refuses.
test fn a_noswap_sibling_mount_does_not_hold_the_key_path() -> Bool {
  let sibling = "20 25 0:21 / /run rw,nosuid,nodev,noexec - tmpfs tmpfs rw,size=3258708k,mode=755\n41 20 0:40 / /run/gunbc-service-slot2 rw - tmpfs tmpfs rw,size=1024k,noswap"
  match service_slot_medium_reading(table: sibling) {
    CustodyMediumNotDeclared => true
    CustodyMediumAsDeclared => false
    CustodyMediumUnreadable { reason: _ } => false
  }
}

test fn an_undecodable_or_empty_mount_table_is_unreadable_and_never_a_pass() -> Bool {
  (match service_slot_medium_reading(table: "garbage line with no separator") {
    CustodyMediumUnreadable { reason: _ } => true
    CustodyMediumAsDeclared => false
    CustodyMediumNotDeclared => false
  }) && (match service_slot_medium_reading(table: "") {
    CustodyMediumUnreadable { reason: _ } => true
    CustodyMediumAsDeclared => false
    CustodyMediumNotDeclared => false
  })
}

// THE RED (blocker: longest path picks a hidden mount): a noswap tmpfs at .../sub under the slot mount is HIDDEN by
// a plain tmpfs mounted over the slot mount (mount 50, parent 41, same mount point). The longest spelling holding
// the path is the hidden noswap sub-mount; the visible holder is the covering plain tmpfs, so the reading refuses.
data mount_table_covered_noswap: String = "20 25 0:21 / /run rw - tmpfs tmpfs rw\n41 20 0:40 / /run/gunbc-service-slot rw - tmpfs tmpfs rw,noswap\n42 41 0:41 / /run/gunbc-service-slot/sub rw - tmpfs tmpfs rw,noswap\n50 41 0:50 / /run/gunbc-service-slot rw - tmpfs tmpfs rw,size=1024k"

test fn a_noswap_mount_hidden_under_a_covering_mount_does_not_hold_the_path() -> Bool {
  match custody_medium_reading(m: CustodyTmpfsNoSwap, mount_table: mount_table_covered_noswap, path: "/run/gunbc-service-slot/sub/app.pem") {
    CustodyMediumNotDeclared => true
    CustodyMediumAsDeclared => false
    CustodyMediumUnreadable { reason: _ } => false
  }
}

// POSITIVE CONTROL: the same tree with the covering mount noswap too, so the visible holder reports noswap.
test fn a_noswap_covering_mount_holds_the_path() -> Bool {
  let t = "20 25 0:21 / /run rw - tmpfs tmpfs rw\n41 20 0:40 / /run/gunbc-service-slot rw - tmpfs tmpfs rw\n50 41 0:50 / /run/gunbc-service-slot rw - tmpfs tmpfs rw,noswap"
  match custody_medium_reading(m: CustodyTmpfsNoSwap, mount_table: t, path: service_slot_key_path) {
    CustodyMediumAsDeclared => true
    CustodyMediumNotDeclared => false
    CustodyMediumUnreadable { reason: _ } => false
  }
}

// THE RED (hold at 653b4d1d, blocker 1): a noswap mount 41 attached under / and then HIDDEN by a later /run mount 50,
// both children of mount 25 (a mount's parent is the mount holding its point WHEN IT WAS MOUNTED). The visible holder
// of the key path is the plain /run, so the reading refuses; a longest-path choice among siblings reads 41 as noswap.
test fn a_noswap_mount_hidden_by_a_later_sibling_ancestor_does_not_hold_the_path() -> Bool {
  let t = "25 1 8:2 / / rw - ext4 /dev/root rw\n41 25 0:40 / /run/gunbc-service-slot rw - tmpfs tmpfs rw,noswap\n50 25 0:50 / /run rw - tmpfs tmpfs rw"
  match custody_medium_reading(m: CustodyTmpfsNoSwap, mount_table: t, path: service_slot_key_path) {
    CustodyMediumNotDeclared => true
    CustodyMediumAsDeclared => false
    CustodyMediumUnreadable { reason: _ } => false
  }
}

// ADMITTED CONTROL: the same table with ONLY 41.parent changed to 50, the noswap mount made inside the new /run, where it is visible.
test fn the_same_table_with_the_noswap_mount_inside_the_later_run_is_admitted() -> Bool {
  let t = "25 1 8:2 / / rw - ext4 /dev/root rw\n41 50 0:40 / /run/gunbc-service-slot rw - tmpfs tmpfs rw,noswap\n50 25 0:50 / /run rw - tmpfs tmpfs rw"
  match custody_medium_reading(m: CustodyTmpfsNoSwap, mount_table: t, path: service_slot_key_path) {
    CustodyMediumAsDeclared => true
    CustodyMediumNotDeclared => false
    CustodyMediumUnreadable { reason: _ } => false
  }
}

// Unresolvable visibility refuses: two mounts tie over one point with no covering relation.
test fn unresolvable_mount_visibility_is_unreadable_never_a_pass() -> Bool {
  let t = "20 25 0:21 / /run rw - tmpfs tmpfs rw\n41 20 0:40 / /run/gunbc-service-slot rw - tmpfs tmpfs rw,noswap\n42 20 0:41 / /run/gunbc-service-slot rw - tmpfs tmpfs rw,noswap"
  match custody_medium_reading(m: CustodyTmpfsNoSwap, mount_table: t, path: service_slot_key_path) {
    CustodyMediumUnreadable { reason: _ } => true
    CustodyMediumAsDeclared => false
    CustodyMediumNotDeclared => false
  }
}

// RED, through the real result-to-classifier path and into the action fold: a find over the upper ancestors
// that exited nonzero refuses the write whether it printed nothing or printed every path (the latter read as
// root-only and sealed the ancestors). The Differs arm of custody_action writes whatever the FILE metadata
// says -- the write replaces the file wholesale and the readback re-checks it -- so file metadata never
// selects between its arms; what gates it is this ancestors reading, which now refuses.
fn custody_refused(a: CustodyAction) -> Bool {
  match a {
    CustodyActionRefused { reason: _ } => true
    CustodyWrite => false
    CustodyLeaveInPlace => false
    CustodyWriteBackToStore { payload: _ } => false
    CustodyRepairMetadataInPlace => false
    CustodyCreateOnly => false
  }
}

test fn a_failed_ancestor_find_refuses_the_custody_write() -> Bool {
  let paths = ["/etc", "/etc/gunbc"]
  custody_refused(custody_action(dir: CustodyPathAsDeclared, upper_ancestors: classify_root_only_paths(requested: paths, exit_code: 1, stdout: "/etc\n/etc/gunbc\n", stderr: "x"), content: HostFileDiffers, file: CustodyPathAsDeclared))
    && custody_refused(custody_action(dir: CustodyPathAsDeclared, upper_ancestors: classify_root_only_paths(requested: paths, exit_code: 1, stdout: "", stderr: "Permission denied"), content: HostFileDiffers, file: CustodyPathAsDeclared))
    && !custody_refused(custody_action(dir: CustodyPathAsDeclared, upper_ancestors: classify_root_only_paths(requested: paths, exit_code: 0, stdout: "/etc\n/etc/gunbc\n", stderr: ""), content: HostFileDiffers, file: CustodyPathAsDeclared))
}

// RED, composed through the decision converge acts on (custody_decided_action, which converge calls): content
// differs and the file's mode read failed, for a store-authoritative credential. This reached CustodyWrite and
// write_and_own before; it refuses now. Positive: the same with observed metadata writes.
test fn a_differing_file_with_an_unreadable_mode_is_not_written() -> Bool {
  let ancestors = classify_root_only_paths(requested: ["/etc", "/etc/gunbc"], exit_code: 0, stdout: "/etc\n/etc/gunbc\n", stderr: "")
  let unread = CustodyPathUnobservable { reason: "find failed" }
  custody_refused(custody_decided_action(c: ControllerAppKey, readers_refusal: none, base_action: custody_action(dir: CustodyPathAsDeclared, upper_ancestors: ancestors, content: HostFileDiffers, file: unread), content: HostFileDiffers, decision: none))
    && !custody_refused(custody_decided_action(c: ControllerAppKey, readers_refusal: none, base_action: custody_action(dir: CustodyPathAsDeclared, upper_ancestors: ancestors, content: HostFileDiffers, file: CustodyPathModeNotDeclared), content: HostFileDiffers, decision: none))
}
