module test.claim.observation_tty_render_witness_test


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data witness_note: String = "P2 acceptance (docs/plans/progress-observation-design.md section 3b): the TTY renderer is a SIBLING of the CI renderer over the same std.observation carriers, differing only where the medium differs. The witnesses prove the sibling property by execution — the same event drives both surfaces and moves together — plus the TTY-specific facts: a required preamble, in-place repaint derived from attention, inline BlockedOn with named remaining, and a deterministic reward animal on Final. The three upgrades over the reference (durations, Refused vs Failed, recursive escalation) are inherited from the shared carriers, not re-earned."

fn tty_cap() -> std.render.RenderCapability {
  std.render.RenderCapability { color: true, tier: std.symbols.Emoji, cursor_addressable: true }
}

fn pipe_cap() -> std.render.RenderCapability {
  std.render.RenderCapability { color: false, tier: std.symbols.Ascii, cursor_addressable: false }
}

fn tty_entry_subject() -> std.observation.ObservationSubject {
  std.observation.ObservationSubject {
    segments: [
      std.observation.RunSegment { id: "30044816605" as std.types.NonEmptyStr },
      std.observation.BatchSegment { index: 3, label: "witness discovery" as std.types.NonEmptyStr },
      std.observation.EntrySegment { source_path: "dag/test/claim/effect_reach_test.dag" as std.types.NonEmptyStr },
      std.observation.ModuleSegment { module_path: "v2.compiler.normalized_tree" as std.types.NonEmptyStr },
      std.observation.PhaseSegment { name: "typecheck" as std.types.NonEmptyStr }
    ]
  }
}

fn tty_basis() -> std.observation.AttentionBasis {
  std.observation.AttentionBasis { average: std.measure.millisecond(count: 1000), maximum: std.measure.millisecond(count: 5000) }
}

test fn w_preamble_names_what_why_and_how_much() -> Bool {
  let line = gunbc.observation_tty_render.tty_preamble_line(fields: gunbc.observation_tty_render.PreambleFields {
    run_id: "30044816605" as std.types.NonEmptyStr,
    trigger: "pull_request" as std.types.NonEmptyStr,
    diff_summary: "3 files touched" as std.types.NonEmptyStr,
    entry_total: 602
  })
  string_contains(s: line.text, pattern: "30044816605") &&
  string_contains(s: line.text, pattern: "pull_request") &&
  string_contains(s: line.text, pattern: "3 files touched") &&
  string_contains(s: line.text, pattern: "602 entries")
}

test fn w_routine_repaints_in_place_but_anomaly_scrolls() -> Bool {
  gunbc.observation_tty_render.tty_cursor_action(density: std.observation.RoutineCollapsible, attention: std.observation.Ambient, cap: tty_cap()) == std.render.Overwrite &&
  gunbc.observation_tty_render.tty_cursor_action(density: std.observation.RoutineCollapsible, attention: std.observation.Notable, cap: tty_cap()) == std.render.Append &&
  gunbc.observation_tty_render.tty_cursor_action(density: std.observation.AnomalyExpanded, attention: std.observation.Anomaly, cap: tty_cap()) == std.render.Append &&
  gunbc.observation_tty_render.tty_cursor_action(density: std.observation.SummaryAlwaysShown, attention: std.observation.Ambient, cap: tty_cap()) == std.render.Append
}

test fn w_non_addressable_terminal_always_appends() -> Bool {
  gunbc.observation_tty_render.tty_cursor_action(density: std.observation.RoutineCollapsible, attention: std.observation.Ambient, cap: pipe_cap()) == std.render.Append &&
  gunbc.observation_tty_render.tty_cursor_action(density: std.observation.AnomalyExpanded, attention: std.observation.Anomaly, cap: pipe_cap()) == std.render.Append
}

test fn w_refusal_never_repaints_away() -> Bool {
  let refusal = std.observation.ObservationEvent {
    subject: tty_entry_subject(),
    transition: std.observation.Concluded { outcome: std.observation.Refused { diagnostic: "FLOOR-BATCH-OVER-BUDGET" as std.types.NonEmptyStr } },
    durations: std.observation.observation_durations_wall(elapsed: std.measure.nanosecond(count: 2472000000000)),
    rss: std.observation.MeasuredUnavailable { cause: "not sampled" as std.types.NonEmptyStr }
  }
  match gunbc.observation_tty_render.tty_event_emission_under(event: refusal, basis: std.observation.MeasuredValue { value: tty_basis() }, cap: tty_cap()) {
    gunbc.observation_tty_render.TtyEmissionProjected { emission: e } => e.line.attention == std.observation.Anomaly && e.cursor == std.render.Append
    gunbc.observation_tty_render.TtyEmissionRefused { cause: _ } => false
  }
}

test fn w_same_event_drives_both_surfaces() -> Bool {
  let event = std.observation.ObservationEvent {
    subject: tty_entry_subject(),
    transition: std.observation.Concluded { outcome: std.observation.Done },
    durations: std.observation.observation_durations_wall(elapsed: std.measure.nanosecond(count: 230000000)),
    rss: std.observation.MeasuredUnavailable { cause: "not sampled" as std.types.NonEmptyStr }
  }
  match gunbc.observation_tty_render.tty_event_emission_under(event: event, basis: std.observation.MeasuredValue { value: tty_basis() }, cap: tty_cap()) {
    gunbc.observation_tty_render.TtyEmissionProjected { emission: e } =>
      string_contains(s: gunbc.observation_tty_render.tty_render_emission(emission: e, tier: std.symbols.Emoji), pattern: "in 230ms")
    gunbc.observation_tty_render.TtyEmissionRefused { cause: _ } => false
  }
}

test fn w_unavailable_basis_refuses_with_exact_cause() -> Bool {
  let cause = "no signed basis for this subject" as std.types.NonEmptyStr
  let event = std.observation.ObservationEvent {
    subject: tty_entry_subject(),
    transition: std.observation.Concluded { outcome: std.observation.Done },
    durations: std.observation.observation_durations_wall(elapsed: std.measure.nanosecond(count: 230000000)),
    rss: std.observation.MeasuredUnavailable { cause: "not sampled" as std.types.NonEmptyStr }
  }
  match gunbc.observation_tty_render.tty_event_emission_under(event: event, basis: std.observation.MeasuredUnavailable { cause: cause }, cap: tty_cap()) {
    gunbc.observation_tty_render.TtyEmissionProjected { emission: _ } => false
    gunbc.observation_tty_render.TtyEmissionRefused { cause: c } => c == cause
  }
}

test fn w_clean_final_appends_even_when_ambient() -> Bool {
  let event = std.observation.ObservationEvent {
    subject: tty_entry_subject(),
    transition: std.observation.Concluded { outcome: std.observation.Final { shown_failures: 0 } },
    durations: std.observation.observation_durations_wall(elapsed: std.measure.nanosecond(count: 230000000)),
    rss: std.observation.MeasuredUnavailable { cause: "not sampled" as std.types.NonEmptyStr }
  }
  match gunbc.observation_tty_render.tty_event_emission_under(event: event, basis: std.observation.MeasuredValue { value: tty_basis() }, cap: tty_cap()) {
    gunbc.observation_tty_render.TtyEmissionProjected { emission: e } => e.line.attention == std.observation.Ambient && e.cursor == std.render.Append
    gunbc.observation_tty_render.TtyEmissionRefused { cause: _ } => false
  }
}

test fn w_routine_begin_overwrites_on_addressable_tty() -> Bool {
  let event = std.observation.ObservationEvent {
    subject: tty_entry_subject(),
    transition: std.observation.Begin,
    durations: std.observation.observation_durations_wall_unavailable(cause: "not started" as std.types.NonEmptyStr),
    rss: std.observation.MeasuredUnavailable { cause: "not sampled" as std.types.NonEmptyStr }
  }
  match gunbc.observation_tty_render.tty_event_emission_under(event: event, basis: std.observation.MeasuredUnavailable { cause: "basis absent" as std.types.NonEmptyStr }, cap: tty_cap()) {
    gunbc.observation_tty_render.TtyEmissionProjected { emission: e } => e.line.attention == std.observation.Ambient && e.cursor == std.render.Overwrite
    gunbc.observation_tty_render.TtyEmissionRefused { cause: _ } => false
  }
}

test fn w_tty_strict_facade_equals_measured_value_projection() -> Bool {
  let event = std.observation.ObservationEvent {
    subject: tty_entry_subject(),
    transition: std.observation.Concluded { outcome: std.observation.Done },
    durations: std.observation.observation_durations_wall(elapsed: std.measure.nanosecond(count: 230000000)),
    rss: std.observation.MeasuredUnavailable { cause: "not sampled" as std.types.NonEmptyStr }
  }
  let strict = gunbc.observation_tty_render.tty_event_emission(event: event, basis: tty_basis(), cap: tty_cap())
  match gunbc.observation_tty_render.tty_event_emission_under(event: event, basis: std.observation.MeasuredValue { value: tty_basis() }, cap: tty_cap()) {
    gunbc.observation_tty_render.TtyEmissionProjected { emission: projected } => strict == projected
    gunbc.observation_tty_render.TtyEmissionRefused { cause: _ } => false
  }
}

test fn w_nonaddressable_routine_composes_to_plain_append_wire() -> Bool {
  let event = std.observation.ObservationEvent {
    subject: tty_entry_subject(),
    transition: std.observation.Begin,
    durations: std.observation.observation_durations_wall_unavailable(cause: "not started" as std.types.NonEmptyStr),
    rss: std.observation.MeasuredUnavailable { cause: "not sampled" as std.types.NonEmptyStr }
  }
  match gunbc.observation_tty_render.tty_event_emission_under(event: event, basis: std.observation.MeasuredValue { value: tty_basis() }, cap: pipe_cap()) {
    gunbc.observation_tty_render.TtyEmissionRefused { cause: _ } => false
    gunbc.observation_tty_render.TtyEmissionProjected { emission: e } =>
      let rendered = gunbc.observation_tty_render.tty_render_emission(emission: e, tier: std.symbols.Ascii)
      e.cursor == std.render.Append &&
      match extdeps.render.terminal.project_terminal_write(
        prior: extdeps.render.terminal.DynamicLineClosed,
        requested: e.cursor,
        capability: pipe_cap(),
        rendered: rendered
      ) {
        extdeps.render.terminal.TerminalWriteRefused { cause: _ } => false
        extdeps.render.terminal.TerminalWriteProjected { bytes: b, next: n } =>
          b == concat(rendered, extdeps.render.ansi.ansi_line_feed) &&
          n == extdeps.render.terminal.DynamicLineClosed &&
          !string_contains(s: b, pattern: extdeps.render.ansi.ansi_carriage_return) &&
          !string_contains(s: b, pattern: extdeps.render.ansi.ansi_erase_entire_line())
      }
  }
}

test fn w_addressable_refusal_persists_via_exact_closed_append_wire() -> Bool {
  let event = std.observation.ObservationEvent {
    subject: tty_entry_subject(),
    transition: std.observation.Concluded { outcome: std.observation.Refused { diagnostic: "policy" as std.types.NonEmptyStr } },
    durations: std.observation.observation_durations_wall_unavailable(cause: "clock absent" as std.types.NonEmptyStr),
    rss: std.observation.MeasuredUnavailable { cause: "not sampled" as std.types.NonEmptyStr }
  }
  match gunbc.observation_tty_render.tty_event_emission_under(event: event, basis: std.observation.MeasuredUnavailable { cause: "basis absent" as std.types.NonEmptyStr }, cap: tty_cap()) {
    gunbc.observation_tty_render.TtyEmissionRefused { cause: _ } => false
    gunbc.observation_tty_render.TtyEmissionProjected { emission: e } =>
      let rendered = gunbc.observation_tty_render.tty_render_emission(emission: e, tier: std.symbols.Emoji)
      e.cursor == std.render.Append &&
      match extdeps.render.terminal.project_terminal_write(
        prior: extdeps.render.terminal.DynamicLineOpen,
        requested: e.cursor,
        capability: tty_cap(),
        rendered: rendered
      ) {
        extdeps.render.terminal.TerminalWriteRefused { cause: _ } => false
        extdeps.render.terminal.TerminalWriteProjected { bytes: b, next: n } =>
          b == concat(
            extdeps.render.ansi.ansi_carriage_return,
            concat(extdeps.render.ansi.ansi_erase_entire_line(), concat(rendered, extdeps.render.ansi.ansi_line_feed))
          ) &&
          n == extdeps.render.terminal.DynamicLineClosed
      }
  }
}

test fn w_group_line_names_the_current_entry() -> Bool {
  let line = gunbc.observation_tty_render.tty_group_line(active: tty_entry_subject(), k: 214, n: 602, spinner: std.symbols.Spinner0)
  string_contains(s: line.text, pattern: "214 of 602") &&
  string_contains(s: line.text, pattern: "v2.compiler.normalized_tree") &&
  line.attention == std.observation.Ambient
}

test fn w_blocked_line_carries_holder_and_bounded_remaining() -> Bool {
  let bounded = gunbc.observation_tty_render.tty_blocked_line(blocked: std.observation.BlockedOn {
    resource: std.observation.MemoryBudget,
    holders: [tty_entry_subject()],
    remaining: std.observation.RemainingBounded { by: std.measure.millisecond(count: 80000) }
  })
  string_contains(s: bounded.text, pattern: "1 holder(s)") &&
  string_contains(s: bounded.text, pattern: "80 seconds remaining") &&
  bounded.attention == std.observation.Anomaly
}

test fn w_blocked_line_names_why_remaining_is_unknown() -> Bool {
  let unknown = gunbc.observation_tty_render.tty_blocked_line(blocked: std.observation.BlockedOn {
    resource: std.observation.MemoryBudget,
    holders: [tty_entry_subject()],
    remaining: std.observation.RemainingUnknown { cause: "governor exposes no reclaim bound" as std.types.NonEmptyStr }
  })
  string_contains(s: unknown.text, pattern: "no estimate (governor exposes no reclaim bound)") &&
  !string_contains(s: unknown.text, pattern: "remaining")
}

test fn w_reward_animal_is_deterministic_and_degrades_to_a_word() -> Bool {
  let emoji_clean = gunbc.observation_tty_render.tty_final_line(shown_failures: 0, run_index: 3, tier: std.symbols.Emoji)
  let emoji_again = gunbc.observation_tty_render.tty_final_line(shown_failures: 0, run_index: 3, tier: std.symbols.Emoji)
  let ascii_clean = gunbc.observation_tty_render.tty_final_line(shown_failures: 0, run_index: 3, tier: std.symbols.Ascii)
  emoji_clean.text == emoji_again.text &&
  string_contains(s: emoji_clean.text, pattern: "all clean") &&
  emoji_clean.attention == std.observation.Ambient &&
  !string_contains(s: ascii_clean.text, pattern: "🦦")
}

test fn w_final_with_failures_names_them_and_is_anomaly() -> Bool {
  let line = gunbc.observation_tty_render.tty_final_line(shown_failures: 3, run_index: 3, tier: std.symbols.Emoji)
  string_contains(s: line.text, pattern: "3 problems shown") &&
  line.attention == std.observation.Anomaly
}
