module test.claim.map_key_derive_requirement_witness

import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// Executing floor witness for the Eq + Hash CAPABILITY derive of v1.compiler.trait_derive_emit
// (v1_eq_hash_capable_type_names). compile_dag_rust_emit_check is the enrolled consumer: it compiles an
// inline fixture through the real emit path and asserts emitted Rust spellings. THE SUBJECT: a declared
// type derives Eq + Hash exactly when its OWN shape admits it, so a module's emitted bytes do not
// depend on whether some other module of the closure keys a map on it (closure_dependent_module_emission).
// The container Map lowers to im::HashMap, bounded K: Hash + Eq, so a keyed capable type is covered.
// Each row is paired with the control that goes red if the rule is read the old way:
// w_non_key_record_derives_eq_and_hash is the closure-independence claim itself (an UNKEYED capable record
// derives, where it used to stay silent) and w_map_value_position_derives_too the same at the value slot.
// w_float_record_derives_no_hash and w_incapability_propagates_to_holders are the discriminating reds:
// Float has no Eq or Hash row, so the capability fixpoint must refuse to derive on it and on everything
// that reaches it, or an unkeyed record with a float field would stop compiling.
// w_unknown_leaf_is_incapable pins the default: a leaf with no capability row (Json) is incapable, not
// assumed capable. w_fn_field_record_derives_no_hash pins the function-value arm: Rc<dyn Fn> is neither
// Eq nor Hash. A keyed use of an incapable type is a loud rustc E0277 at that leaf, not a derive.
fn w_map_key_record_earns_eq_and_hash() -> Bool {
  compile_dag_rust_emit_check(
    "module map_key_witness.keyed\n\ntype PositionKey {\n  position: Int\n}\n\ntype MemoTable {\n  entries: Map<PositionKey, Int>\n}\n",
    "src/map_key_witness_keyed.rs",
    ["Eq, std::hash::Hash)]\npub struct PositionKey"],
    []
  )
}

fn w_non_key_record_derives_eq_and_hash() -> Bool {
  compile_dag_rust_emit_check(
    "module map_key_witness.unkeyed\n\ntype PlainRecord {\n  position: Int\n}\n\ntype PlainHolder {\n  held: PlainRecord\n}\n",
    "src/map_key_witness_unkeyed.rs",
    ["Eq, std::hash::Hash)]\npub struct PlainRecord"],
    []
  )
}

fn w_map_value_position_derives_too() -> Bool {
  compile_dag_rust_emit_check(
    "module map_key_witness.valued\n\ntype ValueOnly {\n  payload: Int\n}\n\ntype ValueTable {\n  entries: Map<String, ValueOnly>\n}\n",
    "src/map_key_witness_valued.rs",
    ["Eq, std::hash::Hash)]\npub struct ValueOnly"],
    []
  )
}

fn w_map_key_requirement_propagates_to_field_types() -> Bool {
  compile_dag_rust_emit_check(
    "module map_key_witness.propagate\n\ntype InnerLeaf {\n  tag: Int\n}\n\ntype OuterKey {\n  inner: InnerLeaf\n}\n\ntype PropagateTable {\n  entries: Map<OuterKey, Int>\n}\n",
    "src/map_key_witness_propagate.rs",
    [
      "Eq, std::hash::Hash)]\npub struct InnerLeaf",
      "Eq, std::hash::Hash)]\npub struct OuterKey"
    ],
    []
  )
}

fn w_fn_return_type_seeds_the_requirement() -> Bool {
  compile_dag_rust_emit_check(
    "module map_key_witness.returned\n\ntype ReturnedKey {\n  tag: Int\n}\n\nfn empty_returned_table() -> Map<ReturnedKey, Int> {\n  empty_map()\n}\n",
    "src/map_key_witness_returned.rs",
    ["Eq, std::hash::Hash)]\npub struct ReturnedKey"],
    []
  )
}

fn w_nullary_coproduct_key_gains_only_hash() -> Bool {
  compile_dag_rust_emit_check(
    "module map_key_witness.nullary_key\n\ntype ChoiceKey\n  = ChoiceLeft\n  | ChoiceRight\n\ntype ChoiceTable {\n  entries: Map<ChoiceKey, Int>\n}\n",
    "src/map_key_witness_nullary_key.rs",
    ["pub enum ChoiceKey", "Ord, serde::Serialize, serde::Deserialize, std::hash::Hash)]"],
    ["serde::Deserialize, Eq"]
  )
}

fn w_fn_field_record_derives_no_hash() -> Bool {
  compile_dag_rust_emit_check(
    "module map_key_witness.callable\n\ntype CallableKey {\n  step: fn(Int) -> Int\n}\n",
    "src/map_key_witness_callable.rs",
    ["pub struct CallableKey"],
    ["std::hash::Hash"]
  )
}

fn w_float_record_derives_no_hash() -> Bool {
  compile_dag_rust_emit_check(
    "module map_key_witness.floaty\n\ntype FloatRecord {\n  weight: Float\n}\n",
    "src/map_key_witness_floaty.rs",
    ["pub struct FloatRecord"],
    ["std::hash::Hash"]
  )
}

fn w_incapability_propagates_to_holders() -> Bool {
  compile_dag_rust_emit_check(
    "module map_key_witness.holder\n\ntype HeldFloat {\n  weight: Float\n}\n\ntype FloatHolder {\n  held: HeldFloat\n}\n",
    "src/map_key_witness_holder.rs",
    ["pub struct FloatHolder"],
    ["std::hash::Hash"]
  )
}

fn w_unknown_leaf_is_incapable() -> Bool {
  compile_dag_rust_emit_check(
    "module map_key_witness.json\n\ntype JsonRecord {\n  payload: Json\n}\n",
    "src/map_key_witness_json.rs",
    ["pub struct JsonRecord"],
    ["std::hash::Hash"]
  )
}

test fn map_key_record_earns_eq_and_hash() -> Bool {
  w_map_key_record_earns_eq_and_hash()
}

test fn non_key_record_derives_eq_and_hash() -> Bool {
  w_non_key_record_derives_eq_and_hash()
}

test fn map_value_position_derives_too() -> Bool {
  w_map_value_position_derives_too()
}

test fn map_key_requirement_propagates_to_field_types() -> Bool {
  w_map_key_requirement_propagates_to_field_types()
}

test fn fn_return_type_seeds_the_requirement() -> Bool {
  w_fn_return_type_seeds_the_requirement()
}

test fn nullary_coproduct_key_gains_only_hash() -> Bool {
  w_nullary_coproduct_key_gains_only_hash()
}

test fn fn_field_record_derives_no_hash() -> Bool {
  w_fn_field_record_derives_no_hash()
}

test fn float_record_derives_no_hash() -> Bool {
  w_float_record_derives_no_hash()
}

test fn incapability_propagates_to_holders() -> Bool {
  w_incapability_propagates_to_holders()
}

test fn unknown_leaf_is_incapable() -> Bool {
  w_unknown_leaf_is_incapable()
}
