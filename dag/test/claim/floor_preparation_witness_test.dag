module test.claim.floor_preparation_witness


data tested_commit: extdeps.git.object_store.GitObjectId = extdeps.git.object_store.GitSha1ObjectId {
  digest: std.content_hash.Sha1Digest { hex: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }
}

data tested_tree: extdeps.git.object_store.GitObjectId = extdeps.git.object_store.GitSha1ObjectId {
  digest: std.content_hash.Sha1Digest { hex: "1111111111111111111111111111111111111111" }
}

fn discovery_request() -> v2.workflow.floor_discovery.FloorDiscoveryRequest {
  v2.workflow.floor_discovery.FloorDiscoveryRequest {
    subject: v2.workflow.floor_discovery.FloorDiscoverySubject {
      tested_commit: v2.workflow.floor_discovery.floor_discovery_commit_id(object_id: test.claim.floor_preparation_witness.tested_commit),
      tested_tree: v2.workflow.floor_discovery.floor_discovery_tree_id(object_id: test.claim.floor_preparation_witness.tested_tree),
      source_roots: ["dag", "src/v2"],
      execution_authority_source_roots: ["dag", "src/v2"],
      naming_authority_identity: content_hash_atom(value: "floor-preparation-naming-fixture"),
      tool_identity: content_hash_atom(value: "floor-preparation-tool-fixture"),
    },
    scan_dirs: ["dag/test/claim"],
    exclude_substrings: [],
    discovery_scope_dirs: ["dag/test/claim"],
    execution_mode: Hermetic,
  }
}

fn witness_a() -> std.realization_schedule.ScheduleWitnessEntry {
  std.realization_schedule.ScheduleWitnessEntry {
    entry: "dag/test/claim/a_test.dag",
    function: "a",
    kind: CorpusWitnessKind,
  }
}

fn witness_b() -> std.realization_schedule.ScheduleWitnessEntry {
  std.realization_schedule.ScheduleWitnessEntry {
    entry: "dag/test/claim/b_test.dag",
    function: "b",
    kind: ExecutionWitnessKind,
  }
}

fn witness_extra() -> std.realization_schedule.ScheduleWitnessEntry {
  std.realization_schedule.ScheduleWitnessEntry {
    entry: "dag/test/claim/extra_test.dag",
    function: "extra",
    kind: CorpusWitnessKind,
  }
}

fn entry_request(witness: std.realization_schedule.ScheduleWitnessEntry, closure: String) -> v2.workflow.floor_preparation.PreparedFloorEntryRequest {
  v2.workflow.floor_preparation.PreparedFloorEntryRequest {
    witness: witness,
    closure_digest: content_hash_atom(value: closure),
  }
}

fn entry_a() -> v2.workflow.floor_preparation.PreparedFloorEntryRequest {
  entry_request(witness: witness_a(), closure: "closure-a")
}

fn entry_b() -> v2.workflow.floor_preparation.PreparedFloorEntryRequest {
  entry_request(witness: witness_b(), closure: "closure-b")
}

fn request_with(selected: List<v2.workflow.floor_preparation.PreparedFloorEntryRequest>) -> v2.workflow.floor_preparation.PreparedFloorSubjectRequest {
  v2.workflow.floor_preparation.PreparedFloorSubjectRequest {
    discovery: discovery_request(),
    selected: selected,
    policy: v2.workflow.floor_preparation.ResolveSelectedClosuresV1 {},
  }
}

fn canonical_request() -> v2.workflow.floor_preparation.PreparedFloorSubjectRequest {
  request_with(selected: [entry_a(), entry_b()])
}

fn artifact_part(label: String) -> std.materialization_provider.ArtifactPart {
  std.materialization_provider.ArtifactPart {
    digest: content_hash_atom(value: label),
    bytes: byte_size(count: 1),
  }
}

fn artifact_for(entry: v2.workflow.floor_preparation.PreparedFloorEntryRequest) -> std.materialization_provider.MaterializedArtifact {
  std.materialization_provider.ResolvedGraphArtifact {
    request_key: request_key(
      req: v2.workflow.floor_preparation.prepared_floor_entry_artifact_request(
        discovery: discovery_request(),
        entry: entry,
      )
    ),
    resolved_graph: artifact_part(label: concat(entry.witness.entry, ".graph")),
    source_indices: artifact_part(label: concat(entry.witness.entry, ".indices")),
    compile_clean_diagnostic_union: artifact_part(label: concat(entry.witness.entry, ".union")),
  }
}

fn probe_for(entry: v2.workflow.floor_preparation.PreparedFloorEntryRequest) -> v2.workflow.floor_preparation.PreparedFloorEntryProbe {
  let artifact = artifact_for(entry: entry)
  v2.workflow.floor_preparation.PreparedFloorEntryProbe {
    witness: entry.witness,
    probe: std.materialization_provider.ProbeFound {
      artifact: artifact,
      observed_digest: artifact_content_digest(artifact: artifact),
    }
  }
}

test fn exact_prepared_artifact_set_serves() -> Bool {
  let request = test.claim.floor_preparation_witness.canonical_request()
  match v2.workflow.floor_preparation.prepared_floor_subject_serve(
    request: request,
    probes: [probe_for(entry: entry_a()), probe_for(entry: entry_b())],
  ) {
    PreparedFloorSubjectReady { identity: identity, entries: entries } =>
      identity == v2.workflow.floor_preparation.prepared_claim_subject_identity(request: request)
        && entries.count() == 2
        && entries.first().witness.entry == witness_a().entry
    PreparedFloorSubjectRefused { cause: _ } => false
  }
}

fn entries_count(xs: std.algebra.FreeMonoid<std.realization_schedule.ScheduleWitnessEntry>) -> Int {
  xs.count()
}

fn entries_first_entry(
  xs: std.algebra.FreeMonoid<std.realization_schedule.ScheduleWitnessEntry>,
) -> String {
  xs.first().entry
}

test fn missing_prepared_identity_refuses() -> Bool {
  match v2.workflow.floor_preparation.prepared_floor_subject_serve(
    request: test.claim.floor_preparation_witness.canonical_request(),
    probes: [probe_for(entry: entry_a())],
  ) {
    PreparedFloorSubjectRefused { cause: cause } =>
      match cause {
        PreparedFloorMissingProbeIdentities { missing: missing } =>
          entries_count(xs: missing) == 1 && entries_first_entry(xs: missing) == witness_b().entry
        _ => false
      }
    _ => false
  }
}

test fn absent_artifact_is_typed_miss_without_cold_fallback() -> Bool {
  match v2.workflow.floor_preparation.prepared_floor_subject_serve(
    request: request_with(selected: [entry_a()]),
    probes: [v2.workflow.floor_preparation.PreparedFloorEntryProbe { witness: witness_a(), probe: ProbeAbsent }],
  ) {
    PreparedFloorSubjectRefused {
      cause: PreparedFloorProviderRefused {
        witness: witness,
        lookup: ProviderMiss { key: _ },
      }
    } => witness.entry == witness_a().entry
    _ => false
  }
}

test fn wrong_artifact_key_refuses() -> Bool {
  let wrong = artifact_for(entry: entry_b())
  match v2.workflow.floor_preparation.prepared_floor_subject_serve(
    request: request_with(selected: [entry_a()]),
    probes: [v2.workflow.floor_preparation.PreparedFloorEntryProbe {
      witness: witness_a(),
      probe: std.materialization_provider.ProbeFound {
        artifact: wrong,
        observed_digest: artifact_content_digest(artifact: wrong),
      }
    }],
  ) {
    PreparedFloorSubjectRefused {
      cause: PreparedFloorProviderRefused {
        witness: _,
        lookup: ProviderRefusedWrongArtifact { key: _, found_key: _ },
      }
    } => true
    _ => false
  }
}

test fn duplicate_selected_identity_refuses() -> Bool {
  match v2.workflow.floor_preparation.prepared_floor_subject_serve(
    request: request_with(selected: [entry_a(), entry_a()]),
    probes: [probe_for(entry: entry_a())],
  ) {
    PreparedFloorSubjectRefused { cause: cause } =>
      match cause {
        PreparedFloorDuplicateSelectedIdentities { duplicates: duplicates } => entries_count(xs: duplicates) == 2
        _ => false
      }
    _ => false
  }
}

test fn duplicate_probe_identity_refuses() -> Bool {
  match v2.workflow.floor_preparation.prepared_floor_subject_serve(
    request: request_with(selected: [entry_a()]),
    probes: [probe_for(entry: entry_a()), probe_for(entry: entry_a())],
  ) {
    PreparedFloorSubjectRefused { cause: cause } =>
      match cause {
        PreparedFloorDuplicateProbeIdentities { duplicates: duplicates } => entries_count(xs: duplicates) == 2
        _ => false
      }
    _ => false
  }
}

test fn unexpected_probe_identity_refuses() -> Bool {
  let extra = entry_request(witness: witness_extra(), closure: "closure-extra")
  match v2.workflow.floor_preparation.prepared_floor_subject_serve(
    request: request_with(selected: [entry_a()]),
    probes: [probe_for(entry: entry_a()), probe_for(entry: extra)],
  ) {
    PreparedFloorSubjectRefused { cause: cause } =>
      match cause {
        PreparedFloorUnexpectedProbeIdentities { unexpected: unexpected } =>
          entries_count(xs: unexpected) == 1 && entries_first_entry(xs: unexpected) == witness_extra().entry
        _ => false
      }
    _ => false
  }
}

test fn changed_closure_changes_prepared_artifact_set_identity() -> Bool {
  let canonical = v2.workflow.floor_preparation.prepared_claim_subject_identity(
    request: request_with(selected: [entry_a()])
  )
  let changed = v2.workflow.floor_preparation.prepared_claim_subject_identity(
    request: request_with(
      selected: [entry_request(witness: witness_a(), closure: "changed-closure-a")]
    )
  )
  canonical.artifact_set_identity.digest != changed.artifact_set_identity.digest
}

test fn all_floor_preparation_controls_hold() -> Bool {
  exact_prepared_artifact_set_serves()
    && missing_prepared_identity_refuses()
    && absent_artifact_is_typed_miss_without_cold_fallback()
    && wrong_artifact_key_refuses()
    && duplicate_selected_identity_refuses()
    && duplicate_probe_identity_refuses()
    && unexpected_probe_identity_refuses()
    && changed_closure_changes_prepared_artifact_set_identity()
}
