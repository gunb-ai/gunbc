// THE SUPPLIED VALUES BELOW ARE BOUNDARY INPUTS, NOT DERIVED ONES, AND THE PAIRED INHABITANCE CLAIM
// FOR THE REAL PATH IS AN EXECUTING ENTRY POINT RATHER THAN A CLAIM HERE:
// gunbc.instruments.github_app_acquire public_app_record_wire_receipt performs a live GET
// /apps/{app_slug} against a real public App and a live 404 against a slug no App holds, so both the
// 200-decodes-into-GitHubAppPublicRecord arm and the 404-reaches-AppRecordAbsent arm are established
// by execution against GitHub rather than by a record this file authored. That receipt is not
// enrolled in the hermetic floor because it reaches the network; deleting the GetApp operation makes
// it fail, which is the control this note names.
data probe_owner: GitHubUser = GitHubUser { login: "gunb-ai", id: 1, type: Organization }

data declared_permission_wire_map: Map<String, String> = {
  "metadata": "read",
  "contents": "read",
  "issues": "read",
  "pull_requests": "read",
  "checks": "read",
  "actions": "read",
  "workflows": "read",
}

data declared_event_wire_list: List<String> = ["installation", "installation_repositories"]

data census_slug: NonEmptyStr = "gunbc-global-census"

fn public_record(
  slug: String,
  permissions: Map<String, String>,
  events: List<String>,
) -> GitHubAppPublicRecord {
  GitHubAppPublicRecord {
    id: 4242,
    slug: slug,
    node_id: "MDM6QXBwNDI0Mg==",
    name: census_app_name as String,
    html_url: "https://github.com/apps/gunbc-global-census",
    permissions: permissions,
    events: events,
  }
}

data agreeing_record: GitHubAppPublicRecord = public_record(
  slug: "gunbc-global-census",
  permissions: declared_permission_wire_map,
  events: declared_event_wire_list,
)

data acquired_record: GitHubAppAcquisitionRecord = AppAcquired {
  app_id: GitHubAppId { value: 4242 },
  slug: census_slug,
}

// ----- the manifest renders the declared shape -----

test fn w_manifest_renders_every_declared_permission_at_its_wire_name() -> Bool {
  match render_app_manifest(m: census_app_manifest) {
    AppManifestNotRenderable { admission: _ } => false
    AppManifestRendered { document: d } =>
      string_contains(s: d, pattern: "\"default_permissions\": {")
        && string_contains(s: d, pattern: "\"metadata\": \"read\"")
        && string_contains(s: d, pattern: "\"pull_requests\": \"read\"")
        && string_contains(s: d, pattern: "\"workflows\": \"read\"")
        && !string_contains(s: d, pattern: "\"administration\"")
        && !string_contains(s: d, pattern: "\"write\"")
  }
}

test fn w_manifest_renders_hook_events_visibility_and_redirect() -> Bool {
  match render_app_manifest(m: census_app_manifest) {
    AppManifestNotRenderable { admission: _ } => false
    AppManifestRendered { document: d } =>
      string_contains(s: d, pattern: "\"name\": \"gunbc-global-census\"")
        && string_contains(s: d, pattern: "\"hook_attributes\": {\"url\": \"https://github.com/gunb-ai/gunbc/blob/main/DESIGN.md\", \"active\": false}")
        && string_contains(s: d, pattern: "\"default_events\": [\"installation\", \"installation_repositories\"]")
        && string_contains(s: d, pattern: "\"public\": true")
        && string_contains(s: d, pattern: "\"redirect_url\": \"https://gunb.ai/github-app-manifest-return\"")
        && !string_contains(s: d, pattern: "\"setup_url\"")
  }
}

fn manifest_with_permissions(perms: List<GitHubAppPermission>) -> GitHubAppManifest {
  GitHubAppManifest {
    name: census_app_manifest.name,
    url: census_app_manifest.url,
    hook_attributes: census_app_manifest.hook_attributes,
    redirect_url: census_app_manifest.redirect_url,
    callback_urls: census_app_manifest.callback_urls,
    setup_url: census_app_manifest.setup_url,
    description: census_app_manifest.description,
    public: census_app_manifest.public,
    default_events: census_app_manifest.default_events,
    request_oauth_on_install: census_app_manifest.request_oauth_on_install,
    setup_on_update: census_app_manifest.setup_on_update,
    default_permissions: perms,
  }
}

