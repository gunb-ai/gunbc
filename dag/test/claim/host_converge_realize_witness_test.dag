module test.claim.host_converge_realize_witness

import std.logic { Bool }
import std.types { String }
import gunbc.host_converge_realize {
  interpret_converge_knob,
  interpret_host_converge,
  KnobUnimplemented,
  ConvergeHostRefused,
  ConvergeHostInterpreted,
  converge_target_kind_label,
}
import gunbc.host_converge {
  ConvergeKnob,
  HostConverge,
  GunbcSlice,
  FreshStandup,
  BlindApply,
  GunbcPinnedTree,
  DeferToSubmodule,
  NoMembershipProbe,
  gunbc_pinned_tree_desired_label,
  gunbc_root_env_key,
  gunbc_host_gunbc_root_path,
  gunbc_dag_root_submodule_path,
  gunbc_host_ctrl_checkout_path,
  gunbc_ctrl_read_pin_script,
  gunbc_pinned_binary_provenance_policy,
  gunbc_green_place_marker_spec,
  gunbc_dashboard_live_apply_policy,
  SliceProperty,
}
import extdeps.os.systemd { systemd_memory_max_property }
import gunbc.fleet_intent_network { operator_host_srv3 }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn fixture_slice_property_knob() -> ConvergeKnob {
  ConvergeKnob {
    slice: GunbcSlice,
    name: "fixture_slice_cap",
    desired: "100",
    target: SliceProperty {
      unit: "fixture.slice",
      property: systemd_memory_max_property,
      apply_value: "100",
      expected_effective: "100",
    },
    apply_mode: FreshStandup,
    no_op: BlindApply,
  }
}

fn witness_every_knob_target_has_kind_label() -> Bool {
  converge_target_kind_label(t: fixture_slice_property_knob().target) == "SliceProperty"
    && converge_target_kind_label(t: fixture_slice_property_knob().target) != ""
}

fn witness_knob_interpreter_fail_closed_unimplemented() -> Bool {
  match interpret_converge_knob(knob: fixture_slice_property_knob()) {
    KnobUnimplemented { knob_name: name, target_kind: kind, reason: why } =>
      name == "fixture_slice_cap"
        && kind == "SliceProperty"
        && string_contains(s: why, pattern: "Unimplemented per knob target")
    _ => false
  }
}

fn witness_host_converge_refuses_on_first_knob() -> Bool {
  match interpret_host_converge(host_converge: HostConverge {
    identity: operator_host_srv3,
    knobs: [fixture_slice_property_knob()],
    membership: NoMembershipProbe,
  }) {
    ConvergeHostRefused { reason: why } =>
      string_contains(s: why, pattern: "fixture_slice_cap")
    ConvergeHostInterpreted { knob_count: _, stdout: _ } => false
  }
}

fn witness_empty_host_converge_refuses() -> Bool {
  match interpret_host_converge(host_converge: HostConverge {
    identity: operator_host_srv3,
    knobs: [],
    membership: NoMembershipProbe,
  }) {
    ConvergeHostRefused { reason: why } =>
      string_contains(s: why, pattern: "zero knobs")
    ConvergeHostInterpreted { knob_count: _, stdout: _ } => false
  }
}

test fn host_converge_realize_holds() -> Bool {
  witness_every_knob_target_has_kind_label()
    && witness_knob_interpreter_fail_closed_unimplemented()
    && witness_host_converge_refuses_on_first_knob()
    && witness_empty_host_converge_refuses()
}
