module test.claim.host_converge_realize_witness

data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn fixture_slice_property_knob() -> gunbc.host_converge.ConvergeKnob {
  gunbc.host_converge.ConvergeKnob {
    slice: GunbcSlice,
    name: "fixture_slice_cap",
    desired: "100",
    target: gunbc.host_converge.SliceProperty {
      unit: "fixture.slice",
      property: systemd_memory_max_property,
      apply_value: "100",
      expected_effective: "100",
    },
    apply_mode: FreshStandup,
    no_op: BlindApply,
  }
}

test fn witness_every_knob_target_has_kind_label() -> Bool {
  converge_target_kind_label(t: fixture_slice_property_knob().target) == "SliceProperty"
    && converge_target_kind_label(t: fixture_slice_property_knob().target) != ""
}

test fn witness_knob_interpreter_fail_closed_unimplemented() -> Bool {
  match interpret_converge_knob(knob: fixture_slice_property_knob()) {
    KnobUnimplemented { knob_name: name, target_kind: kind, reason: why } =>
      name == "fixture_slice_cap"
        && kind == "SliceProperty"
        && string_contains(s: why, pattern: "Unimplemented per knob target")
    _ => false
  }
}

test fn witness_host_converge_refuses_on_first_knob() -> Bool {
  match interpret_host_converge(host_converge: gunbc.host_converge.HostConverge {
    identity: operator_host_srv3,
    knobs: [fixture_slice_property_knob()],
    membership: NoMembershipProbe,
  }) {
    ConvergeHostRefused { reason: why } =>
      string_contains(s: why, pattern: "fixture_slice_cap")
    ConvergeHostInterpreted { knob_count: _, stdout: _ } => false
  }
}

test fn witness_empty_host_converge_refuses() -> Bool {
  match interpret_host_converge(host_converge: gunbc.host_converge.HostConverge {
    identity: operator_host_srv3,
    knobs: [],
    membership: NoMembershipProbe,
  }) {
    ConvergeHostRefused { reason: why } =>
      string_contains(s: why, pattern: "zero knobs")
    ConvergeHostInterpreted { knob_count: _, stdout: _ } => false
  }
}

fn fixture_per_slot_memory_cap_knob(name: String, dropin_path: String) -> gunbc.host_converge.ConvergeKnob {
  gunbc.host_converge.ConvergeKnob {
    slice: RunnerSlice,
    name: name,
    desired: "1073741824",
    target: gunbc.host_converge.PerSlotMemoryCap {
      dropin_path: dropin_path,
      instance_glob: "actions-runner@*.service",
      property: systemd_memory_max_property,
      bytes_value: "1073741824",
    },
    apply_mode: FreshStandup,
    no_op: BlindApply,
  }
}

test fn witness_single_implemented_knob_still_interprets() -> Bool {
  match interpret_host_converge(host_converge: gunbc.host_converge.HostConverge {
    identity: operator_host_srv3,
    knobs: [fixture_per_slot_memory_cap_knob(name: "cap_a", dropin_path: "/etc/systemd/system/a.d/mem.conf")],
    membership: NoMembershipProbe,
  }) {
    ConvergeHostInterpreted { knob_count: n, stdout: _ } => n == 1
    ConvergeHostRefused { reason: _ } => false
  }
}

test fn witness_multi_knob_script_concatenation_is_refused_not_silently_run() -> Bool {
  match interpret_host_converge(host_converge: gunbc.host_converge.HostConverge {
    identity: operator_host_srv3,
    knobs: [
      fixture_per_slot_memory_cap_knob(name: "cap_a", dropin_path: "/etc/systemd/system/a.d/mem.conf"),
      fixture_per_slot_memory_cap_knob(name: "cap_b", dropin_path: "/etc/systemd/system/b.d/mem.conf"),
    ],
    membership: NoMembershipProbe,
  }) {
    ConvergeHostRefused { reason: why } =>
      string_contains(s: why, pattern: "multi-knob script concatenation refused")
        && string_contains(s: why, pattern: "cap_b")
    ConvergeHostInterpreted { knob_count: _, stdout: _ } => false
  }
}

