module test.claim.card_intake_risk_witness

import extdeps.tcgplayer.catalog {
  CardCondition,
  NearMint,
  LightlyPlayed,
  ModeratelyPlayed,
  ProductSku,
  CategoryCondition,
  SkuSelection,
  SkuMatched,
  SkuUnavailable,
  SkuAmbiguous,
  card_condition_display_name,
  parse_card_condition,
  resolve_condition_id,
  select_sku_for_condition,
}
import gunbc.tools.card_intake {
  CatalogMatch,
  ExactMatch,
  AmbiguousMatch,
  NoMatch,
  RiskReason,
  UnmatchedCard,
  AmbiguousCatalogMatch,
  UnpricedCard,
  HighValue,
  ConditionNotOffered,
  SkuUnavailableForCondition,
  AmbiguousSku,
  IntakeDisposition,
  ReadyToList,
  NeedsReview,
  ConditionListingPlan,
  ListingReady,
  ListingBlocked,
  classify_catalog_match,
  assess_intake,
  assess_sku_listing,
  plan_condition_listing,
}

test fn witness_zero_results_classifies_no_match() -> Bool {
  match classify_catalog_match(total_items: 0, first_product_id: 0) {
    NoMatch => true
    _ => false
  }
}

test fn witness_single_result_classifies_exact_match() -> Bool {
  match classify_catalog_match(total_items: 1, first_product_id: 12345) {
    ExactMatch { product_id: 12345 } => true
    _ => false
  }
}

test fn witness_many_results_classify_ambiguous() -> Bool {
  match classify_catalog_match(total_items: 3, first_product_id: 12345) {
    AmbiguousMatch { candidate_count: 3 } => true
    _ => false
  }
}

test fn witness_cheap_exact_match_is_ready_to_list() -> Bool {
  match assess_intake(
    card_match: ExactMatch { product_id: 12345 },
    market_price: Present { value: 12.5 },
    high_value_threshold: 50.0
  ) {
    ReadyToList => true
    _ => false
  }
}

test fn witness_high_value_card_is_flagged() -> Bool {
  match assess_intake(
    card_match: ExactMatch { product_id: 12345 },
    market_price: Present { value: 120.0 },
    high_value_threshold: 50.0
  ) {
    NeedsReview { reasons: rs } => count(rs) == 1 && any(rs, r => r == HighValue)
    _ => false
  }
}

test fn witness_threshold_price_is_flagged() -> Bool {
  match assess_intake(
    card_match: ExactMatch { product_id: 12345 },
    market_price: Present { value: 50.0 },
    high_value_threshold: 50.0
  ) {
    NeedsReview { reasons: rs } => any(rs, r => r == HighValue)
    _ => false
  }
}

test fn witness_unpriced_card_is_flagged() -> Bool {
  match assess_intake(
    card_match: ExactMatch { product_id: 12345 },
    market_price: none,
    high_value_threshold: 50.0
  ) {
    NeedsReview { reasons: rs } => count(rs) == 1 && any(rs, r => r == UnpricedCard)
    _ => false
  }
}

test fn witness_unmatched_card_is_flagged() -> Bool {
  match assess_intake(
    card_match: NoMatch,
    market_price: Present { value: 3.0 },
    high_value_threshold: 50.0
  ) {
    NeedsReview { reasons: rs } => count(rs) == 1 && any(rs, r => r == UnmatchedCard)
    _ => false
  }
}

test fn witness_ambiguous_high_value_collects_both_reasons() -> Bool {
  match assess_intake(
    card_match: AmbiguousMatch { candidate_count: 4 },
    market_price: Present { value: 200.0 },
    high_value_threshold: 50.0
  ) {
    NeedsReview { reasons: rs } =>
      count(rs) == 2 && any(rs, r => r == AmbiguousCatalogMatch) && any(rs, r => r == HighValue)
    _ => false
  }
}

test fn witness_ready_to_list_disposition() -> Bool {
  let d = ReadyToList
  match d {
    ReadyToList => true
    NeedsReview { reasons: _ } => false
  }
}

test fn witness_needs_review_disposition() -> Bool {
  let d = NeedsReview { reasons: [] |> list_push(HighValue) }
  match d {
    NeedsReview { reasons: rs } => count(rs) == 1 && any(rs, r => r == HighValue)
    ReadyToList => false
  }
}

test fn witness_near_mint_display_name_roundtrip() -> Bool {
  match parse_card_condition(raw: card_condition_display_name(c: NearMint)) {
    Present { value: NearMint } => true
    _ => false
  }
}

test fn witness_uppercase_condition_does_not_decode() -> Bool {
  match parse_card_condition(raw: "NEAR MINT") {
    none => true
    _ => false
  }
}

fn sample_conditions() -> List<CategoryCondition> {
  []
    |> list_push(CategoryCondition { conditionId: 1, name: "Near Mint", abbreviation: none, displayOrder: none })
    |> list_push(CategoryCondition { conditionId: 2, name: "Lightly Played", abbreviation: none, displayOrder: none })
}

fn sample_skus() -> List<ProductSku> {
  []
    |> list_push(ProductSku { skuId: 5001, productId: 100, languageId: 1, printingId: 1, conditionId: 1 })
    |> list_push(ProductSku { skuId: 5002, productId: 100, languageId: 1, printingId: 1, conditionId: 2 })
}

test fn witness_resolve_condition_id_grounds_on_category_response() -> Bool {
  match resolve_condition_id(conditions: sample_conditions(), condition: NearMint) {
    Present { value: 1 } => true
    _ => false
  }
}

test fn witness_resolve_condition_id_absent_when_not_offered() -> Bool {
  match resolve_condition_id(conditions: sample_conditions(), condition: ModeratelyPlayed) {
    none => true
    _ => false
  }
}

test fn witness_select_sku_exact_condition_match() -> Bool {
  match select_sku_for_condition(skus: sample_skus(), condition_id: 2, printing_id: 1, language_id: 1) {
    SkuMatched { sku_id: 5002 } => true
    _ => false
  }
}

test fn witness_select_sku_unavailable_when_printing_absent() -> Bool {
  match select_sku_for_condition(skus: sample_skus(), condition_id: 1, printing_id: 2, language_id: 1) {
    SkuUnavailable => true
    _ => false
  }
}

test fn witness_select_sku_ambiguous_when_duplicate_rows() -> Bool {
  let dupes = sample_skus()
    |> list_push(ProductSku { skuId: 5003, productId: 100, languageId: 1, printingId: 1, conditionId: 1 })
  match select_sku_for_condition(skus: dupes, condition_id: 1, printing_id: 1, language_id: 1) {
    SkuAmbiguous { candidate_count: 2 } => true
    _ => false
  }
}

test fn witness_plan_condition_listing_ready_selects_sku() -> Bool {
  match plan_condition_listing(
    conditions: sample_conditions(),
    skus: sample_skus(),
    condition: NearMint,
    printing_id: 1,
    language_id: 1,
    market_price: Present { value: 10.0 },
    high_value_threshold: 50.0
  ) {
    ListingReady { sku_id: 5001, market_price: _ } => true
    _ => false
  }
}

test fn witness_plan_condition_not_offered_is_blocked() -> Bool {
  match plan_condition_listing(
    conditions: sample_conditions(),
    skus: sample_skus(),
    condition: ModeratelyPlayed,
    printing_id: 1,
    language_id: 1,
    market_price: Present { value: 10.0 },
    high_value_threshold: 50.0
  ) {
    ListingBlocked { disposition: NeedsReview { reasons: rs }, selection: _ } =>
      any(rs, r => r == ConditionNotOffered)
    _ => false
  }
}

test fn witness_plan_high_value_matched_sku_is_blocked() -> Bool {
  match plan_condition_listing(
    conditions: sample_conditions(),
    skus: sample_skus(),
    condition: NearMint,
    printing_id: 1,
    language_id: 1,
    market_price: Present { value: 120.0 },
    high_value_threshold: 50.0
  ) {
    ListingBlocked { disposition: NeedsReview { reasons: rs }, selection: SkuMatched { sku_id: 5001 } } =>
      any(rs, r => r == HighValue)
    _ => false
  }
}

test fn witness_assess_sku_listing_ambiguous_flags_reason() -> Bool {
  match assess_sku_listing(
    selection: SkuAmbiguous { candidate_count: 3 },
    market_price: Present { value: 5.0 },
    high_value_threshold: 50.0
  ) {
    NeedsReview { reasons: rs } => count(rs) == 1 && any(rs, r => r == AmbiguousSku)
    _ => false
  }
}
