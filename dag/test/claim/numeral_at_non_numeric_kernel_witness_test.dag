// THE CONDITION POSITION (gunbc.recurring_failure_mode.condition_position_unjudged_against_bool):
// a match-arm guard and an if condition are declared Bool by the grammar and judged by the same
// relation. The guard RED is the shape gunbc#12814 found (`x if 5`).

fn nkt_guard_int_source() -> String {
  "module nkt.guard_int\n\nimport std.types { Int, Bool }\n\nfn probe(n: Int) -> Int {\n  match n {\n    x if 5 => 1\n    _ => 2\n  }\n}\n"
}

test fn an_int_literal_as_a_match_arm_guard_must_refuse() -> Bool {
  not_inhabited_blocking_count(source: nkt_guard_int_source()) >= 1
}

fn nkt_guard_bool_source() -> String {
  "module nkt.guard_bool\n\nimport std.types { Int, Bool }\n\nfn probe(n: Int) -> Int {\n  match n {\n    x if x > 10 => 1\n    _ => 2\n  }\n}\n"
}

test fn a_bool_match_arm_guard_still_compiles() -> Bool {
  not_inhabited_blocking_count(source: nkt_guard_bool_source()) == 0
    && compile_dag_rust_emit_check(
      nkt_guard_bool_source(),
      "src/nkt_guard_bool.rs",
      [],
      []
    )
}

