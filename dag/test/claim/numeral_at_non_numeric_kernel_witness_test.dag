fn nkt_field_int_source() -> String {
  "module nkt.field_int\n\nimport std.types { Int, Float, Bool, String }\n\ntype Flag { on: Bool }\n\ntype Label { text: String }\n\ntype Count { n: Int }\n\ntype Ratio { r: Float }\n\nfn take_b(b: Bool) -> Bool {\n  b\n}\n\nfn take_s(s: String) -> String {\n  s\n}\n\nfn take_i(i: Int) -> Int {\n  i\n}\n\nfn take_f(f: Float) -> Float {\n  f\n}\n\nfn probe() -> Count {\n  Count { n: 1 }\n}\n"
}

test fn an_int_literal_at_an_int_record_field_still_compiles() -> Bool {
  not_inhabited_blocking_count(source: nkt_field_int_source()) == 0
    && compile_dag_rust_emit_check(
      nkt_field_int_source(),
      "src/nkt_field_int.rs",
      [],
      []
    )
}

