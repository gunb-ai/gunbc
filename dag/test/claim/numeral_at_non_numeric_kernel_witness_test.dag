module test.claim.numeral_at_non_numeric_kernel_witness_test

import gunbc.compile_diagnostic_census {
  CensusObserved,
  CensusNotRunnable,
  census_blocking_rows,
  census_rows_of_class,
  census_total_count,
}
import std.algebra {
  kernel_carrier_admits_numeral,
  algebra_profile_admits_numeral,
  OrderedRingProfile,
  ApproximateFieldProfile,
  BooleanAlgebraProfile,
  FreeMonoidScalarProfile,
  FreeMonoidCollectionProfile,
}

// A NUMERAL INHABITS A DECLARED KERNEL TYPE ONLY WHEN THAT TYPE ADMITS A NUMERAL (DESIGN 4b floor:
// values inhabit declared types; DESIGN 4: a Bool literal is not an Int literal, no implicit route).
// Class row: gunbc.recurring_failure_mode.numeral_admitted_at_every_kernel_declared_type.
// Before the repair v1.compiler.infer declared_realizes_as_kernel_numeric answered Inhabits for an
// Int or Float at ANY kernel-minted declared type. At the positions below the older kernel chain
// already refused the pair, so these REDs pin that the state stays refused; the REDs that were
// silent on main are the condition REDs at the end of this file.
//
// Each RED is one source with exactly one candidate site and asserts at least one blocking refusal
// of the two classes below. The positive control at the end of the file carries every admitted pair
// one term away from a RED, so a blanket refusal of literals or conditions goes red there.
//
// dissolve-on: none -- permanent regression control per DESIGN 4b(4).

// TWO CLASSES REFUSE THIS STATE, AND WHICH ONE DEPENDS ON THE POSITION -- measured, not assumed.
// At the record field, declared return, call argument and list element the older kernel chain
// (v1.compiler.infer kernel_value_declared_type_mismatch) already refused an Int at Bool as a
// TypeMismatch on main, masking the relation's wrong Inhabits; at the call argument and list element
// the relation now refuses as well (DeclaredTypeNotInhabited). At a condition only the relation
// judges. So the oracle counts blocking rows of EITHER class: a RED needs at least one, and a
// control needs zero of both, which keeps -1 (not runnable) out of both arms.
fn not_inhabited_blocking_count(source: String) -> Int {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: rows } =>
      census_total_count(rows: census_blocking_rows(rows: census_rows_of_class(rows: rows, wanted: "DeclaredTypeNotInhabited")))
        + census_total_count(rows: census_blocking_rows(rows: census_rows_of_class(rows: rows, wanted: "TypeMismatch")))
    CensusNotRunnable { cause: _ } => -1
  }
}

fn nkt_field_bool_source() -> String {
  "module nkt.field_bool\n\nimport std.types { Int, Float, Bool, String }\n\ntype Flag { on: Bool }\n\ntype Label { text: String }\n\ntype Count { n: Int }\n\ntype Ratio { r: Float }\n\nfn take_b(b: Bool) -> Bool {\n  b\n}\n\nfn take_s(s: String) -> String {\n  s\n}\n\nfn take_i(i: Int) -> Int {\n  i\n}\n\nfn take_f(f: Float) -> Float {\n  f\n}\n\nfn probe() -> Flag {\n  Flag { on: 1 }\n}\n"
}

test fn an_int_literal_at_a_bool_record_field_must_refuse() -> Bool {
  not_inhabited_blocking_count(source: nkt_field_bool_source()) >= 1
}

fn nkt_arg_bool_source() -> String {
  "module nkt.arg_bool\n\nimport std.types { Int, Float, Bool, String }\n\ntype Flag { on: Bool }\n\ntype Label { text: String }\n\ntype Count { n: Int }\n\ntype Ratio { r: Float }\n\nfn take_b(b: Bool) -> Bool {\n  b\n}\n\nfn take_s(s: String) -> String {\n  s\n}\n\nfn take_i(i: Int) -> Int {\n  i\n}\n\nfn take_f(f: Float) -> Float {\n  f\n}\n\nfn probe() -> Bool {\n  take_b(b: 1)\n}\n"
}

test fn an_int_literal_at_a_bool_call_argument_must_refuse() -> Bool {
  not_inhabited_blocking_count(source: nkt_arg_bool_source()) >= 1
}

