module test.claim.uri_percent_encode_witness

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data witness_negative_scalar: Int = 0 - 1

test fn uri_percent_encode_scalar_e_acute_holds() -> Bool {
  match uri_percent_encode_code_point(cp: 233) {
    UriPercentComponentEncoded(wire) => wire == "%C3%A9"
    UriPercentComponentRefused { cause: _ } => false
  }
}

test fn uri_percent_encode_scalar_euro_holds() -> Bool {
  match uri_percent_encode_code_point(cp: 8364) {
    UriPercentComponentEncoded(wire) => wire == "%E2%82%AC"
    UriPercentComponentRefused { cause: _ } => false
  }
}

test fn uri_percent_encode_scalar_musical_symbol_holds() -> Bool {
  match uri_percent_encode_code_point(cp: 119070) {
    UriPercentComponentEncoded(wire) => wire == "%F0%9D%84%9E"
    UriPercentComponentRefused { cause: _ } => false
  }
}

test fn uri_percent_encode_refuses_surrogate_scalar_holds() -> Bool {
  match uri_percent_encode_code_point(cp: 55296) {
    UriPercentComponentRefused { cause: UriPercentEncodeSurrogateScalarRefused { cp: 55296 } } => true
    UriPercentComponentEncoded(_) => false
    UriPercentComponentRefused { cause: UriPercentEncodeHexNibbleOutOfRange { digit: _ } } => false
    UriPercentComponentRefused { cause: UriPercentEncodeUnicodeScalarOutOfRangeRefused { cp: _ } } => false
    UriPercentComponentRefused { cause: UriPercentEncodeUtf8OctetOutOfRangeRefused { value: _ } } => false
    UriPercentComponentRefused { cause: UriPercentEncodeEmptyInputRefused } => false
  }
}

test fn uri_percent_encode_refuses_code_point_beyond_unicode_max_holds() -> Bool {
  match uri_percent_encode_code_point(cp: 1114112) {
    UriPercentComponentRefused { cause: UriPercentEncodeUnicodeScalarOutOfRangeRefused { cp: 1114112 } } => true
    UriPercentComponentEncoded(_) => false
    UriPercentComponentRefused { cause: UriPercentEncodeHexNibbleOutOfRange { digit: _ } } => false
    UriPercentComponentRefused { cause: UriPercentEncodeSurrogateScalarRefused { cp: _ } } => false
    UriPercentComponentRefused { cause: UriPercentEncodeUtf8OctetOutOfRangeRefused { value: _ } } => false
    UriPercentComponentRefused { cause: UriPercentEncodeEmptyInputRefused } => false
  }
}

test fn uri_percent_encode_refuses_negative_scalar_at_construction_holds() -> Bool {
  match uri_percent_encode_code_point(cp: witness_negative_scalar) {
    UriPercentComponentRefused {
      cause: UriPercentEncodeUnicodeScalarOutOfRangeRefused { cp: c },
    } =>
      c == witness_negative_scalar
    UriPercentComponentEncoded(_) => false
    UriPercentComponentRefused { cause: UriPercentEncodeHexNibbleOutOfRange { digit: _ } } => false
    UriPercentComponentRefused { cause: UriPercentEncodeSurrogateScalarRefused { cp: _ } } => false
    UriPercentComponentRefused { cause: UriPercentEncodeUtf8OctetOutOfRangeRefused { value: _ } } => false
    UriPercentComponentRefused { cause: UriPercentEncodeEmptyInputRefused } => false
  }
}

test fn uri_percent_encode_refuses_directly_constructed_surrogate_scalar_holds() -> Bool {
  match uri_percent_encode_unicode_scalar(scalar: UriUnicodeScalar { cp: 55296 }) {
    UriPercentEncodeRefused { cause: UriPercentEncodeSurrogateScalarRefused { cp: 55296 } } => true
    UriPercentEncodeBuilding { wire: _ } => false
    UriPercentEncodeRefused { cause: UriPercentEncodeHexNibbleOutOfRange { digit: _ } } => false
    UriPercentEncodeRefused { cause: UriPercentEncodeUnicodeScalarOutOfRangeRefused { cp: _ } } => false
    UriPercentEncodeRefused { cause: UriPercentEncodeUtf8OctetOutOfRangeRefused { value: _ } } => false
    UriPercentEncodeRefused { cause: UriPercentEncodeEmptyInputRefused } => false
  }
}

test fn uri_percent_encode_refuses_directly_constructed_above_max_scalar_holds() -> Bool {
  match uri_percent_encode_unicode_scalar(scalar: UriUnicodeScalar { cp: 1114112 }) {
    UriPercentEncodeRefused {
      cause: UriPercentEncodeUnicodeScalarOutOfRangeRefused { cp: 1114112 },
    } => true
    UriPercentEncodeBuilding { wire: _ } => false
    UriPercentEncodeRefused { cause: UriPercentEncodeHexNibbleOutOfRange { digit: _ } } => false
    UriPercentEncodeRefused { cause: UriPercentEncodeSurrogateScalarRefused { cp: _ } } => false
    UriPercentEncodeRefused { cause: UriPercentEncodeUtf8OctetOutOfRangeRefused { value: _ } } => false
    UriPercentEncodeRefused { cause: UriPercentEncodeEmptyInputRefused } => false
  }
}

test fn uri_percent_encode_code_points_joins_fragments_once_holds() -> Bool {
  match uri_percent_encode_code_points(code_points: [233, 8364]) {
    UriPercentComponentEncoded(wire) => wire == "%C3%A9%E2%82%AC"
    UriPercentComponentRefused { cause: _ } => false
  }
}

test fn uri_percent_encode_refuses_empty_code_point_list_holds() -> Bool {
  match uri_percent_encode_code_points(code_points: []) {
    UriPercentComponentRefused { cause: UriPercentEncodeEmptyInputRefused } => true
    UriPercentComponentEncoded(_) => false
    UriPercentComponentRefused { cause: UriPercentEncodeHexNibbleOutOfRange { digit: _ } } => false
    UriPercentComponentRefused { cause: UriPercentEncodeSurrogateScalarRefused { cp: _ } } => false
    UriPercentComponentRefused { cause: UriPercentEncodeUnicodeScalarOutOfRangeRefused { cp: _ } } => false
    UriPercentComponentRefused { cause: UriPercentEncodeUtf8OctetOutOfRangeRefused { value: _ } } => false
  }
}

test fn uri_percent_encode_component_round_trip_unreserved_holds() -> Bool {
  match uri_percent_encode_component(value: "page-1_ok" as NonEmptyStr) {
    UriPercentComponentEncoded(wire) => wire == "page-1_ok"
    UriPercentComponentRefused { cause: _ } => false
  }
}

test fn uri_percent_encode_component_encodes_ascii_reserved_holds() -> Bool {
  match uri_percent_encode_component(value: "a=b&c" as NonEmptyStr) {
    UriPercentComponentEncoded(wire) => wire == "a%3Db%26c"
    UriPercentComponentRefused { cause: _ } => false
  }
}

test fn uri_percent_encode_code_points_e_acute_sequence_holds() -> Bool {
  match uri_percent_encode_code_points(code_points: [233]) {
    UriPercentComponentEncoded(wire) => wire == "%C3%A9"
    UriPercentComponentRefused { cause: _ } => false
  }
}

fn witness_percent_decoded(value: String) -> String {
  match uri_percent_decode_component(value: value) {
    UriPercentComponentDecoded { value: v } => v
    UriPercentDecodeRefused { cause: c } => join(["REFUSED: ", uri_percent_decode_refusal_reason(cause: c)], "")
  }
}

// THE DECODE READS EACH ESCAPE ONCE. An encoded percent sign followed by hex digits stays the
// literal three characters, which is the case a replace-in-sequence decode gets wrong; an
// authorization-code-shaped value decodes its reserved characters in either hex case; a value
// with no escape, and the empty value, are themselves.
test fn uri_percent_decode_reads_each_escape_exactly_once() -> Bool {
  witness_percent_decoded(value: "%252F") == "%2F"
    && witness_percent_decoded(value: "4%2F0AX4-b%3D%2B") == "4/0AX4-b=+"
    && witness_percent_decoded(value: "a%2fb%3d") == "a/b="
    && witness_percent_decoded(value: "plain-code_1") == "plain-code_1"
    && witness_percent_decoded(value: "") == ""
}

// THE DECODE REFUSES WHAT IT CANNOT READ, each with its own cause: a truncated escape, a non-hex
// digit, a control octet and a non-ASCII octet. None passes through as plausible text.
test fn uri_percent_decode_refuses_malformed_and_unadmitted_escapes() -> Bool {
  uri_percent_decode_component(value: "abc%2") == UriPercentDecodeRefused { cause: UriPercentDecodeTruncatedEscape }
    && uri_percent_decode_component(value: "abc%") == UriPercentDecodeRefused { cause: UriPercentDecodeTruncatedEscape }
    && uri_percent_decode_component(value: "%G1") == UriPercentDecodeRefused { cause: UriPercentDecodeNonHexDigit { cp: 71 } }
    && uri_percent_decode_component(value: "a%0D%0Ab") == UriPercentDecodeRefused { cause: UriPercentDecodeOctetNotAdmitted { octet: 13 } }
    && uri_percent_decode_component(value: "%C3%A9") == UriPercentDecodeRefused { cause: UriPercentDecodeOctetNotAdmitted { octet: 195 } }
}
