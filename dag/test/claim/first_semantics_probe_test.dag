module test.claim.first_semantics_probe

import std.logic { Bool }
import std.types { ContentHash, String, Int, List }
import std.content_hash { content_hash_atom }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data empty_strs: List<String> = []
data hashes: List<ContentHash> = [content_hash_atom(value: "h1")]
data empty_hashes: List<ContentHash> = []

fn pure_empty_is_absent() -> Bool {
  match empty_strs.first() {
    Absent => true
    Present { value: v } => false
  }
}

func effect_empty_is_absent() -> Bool {
  match empty_strs.first() {
    Absent => true
    Present { value: v } => false
  }
}

func effect_hash_list_is_optional() -> Bool {
  match hashes.first() {
    Absent => false
    Present { value: v } => true
  }
}

func effect_empty_hash_list_is_absent() -> Bool {
  match empty_hashes.first() {
    Absent => true
    Present { value: v } => false
  }
}
