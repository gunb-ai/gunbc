module test.claim.v1_interpreter_primitive_surface_witness_test

import gunbc.v1_interpreter_primitive_surface {
  FreeCall,
  InterpreterPrimitiveArmId,
  InterpreterPrimitiveDispatchArm,
  form_has_no_shadowed_spelling,
  shadowed_spellings,
  v1_interpreter_cross_form_spellings,
  v1_interpreter_declared_arm_count,
  v1_interpreter_derived_arm_count,
  v1_interpreter_free_call_arms,
  v1_interpreter_method_call_arms,
  v1_interpreter_primitive_arms,
}

test fn derived_free_call_surface_is_populated() -> Bool {
  v1_interpreter_derived_arm_count() > 100
}

test fn derived_surface_includes_its_own_reading_arm() -> Bool {
  v1_interpreter_free_call_arms()
    |> any(r => r.authored_spelling == "interpreter_free_call_arm_rows")
}

test fn alias_spellings_share_one_arm_identity() -> Bool {
  let rows = v1_interpreter_free_call_arms()
  let a = rows |> filter(r => r.authored_spelling == "map_contains_key") |> map(r => r.arm.identity)
  let b = rows |> filter(r => r.authored_spelling == "map_has") |> map(r => r.arm.identity)
  count(a) == 1 && count(b) == 1 && (a |> all(x => b |> any(y => y == x)))
}

test fn free_call_form_has_no_shadowed_spelling() -> Bool {
  form_has_no_shadowed_spelling(rows: v1_interpreter_free_call_arms())
}

test fn method_call_form_shadowing_is_exactly_the_known_lookup_case() -> Bool {
  let s = shadowed_spellings(rows: v1_interpreter_method_call_arms())
  count(s) > 0 && (s |> all(x => x == "lookup"))
}

test fn lookup_carries_three_independent_dispatch_rows() -> Bool {
  count(v1_interpreter_primitive_arms() |> filter(r => r.authored_spelling == "lookup")) == 3
}

test fn shadow_detector_catches_a_planted_duplicate() -> Bool {
  let planted = [
    InterpreterPrimitiveDispatchArm {
      arm: InterpreterPrimitiveArmId { identity: "planted:alpha" },
      form: FreeCall,
      authored_spelling: "alpha",
      realization_module: "planted",
      dispatch_symbol: "planted_dispatch",
    },
    InterpreterPrimitiveDispatchArm {
      arm: InterpreterPrimitiveArmId { identity: "planted:beta" },
      form: FreeCall,
      authored_spelling: "alpha",
      realization_module: "planted",
      dispatch_symbol: "planted_dispatch",
    },
  ]
  !form_has_no_shadowed_spelling(rows: planted) && (shadowed_spellings(rows: planted) |> any(s => s == "alpha"))
}

test fn shadow_detector_admits_a_real_alias_pair() -> Bool {
  let alias = [
    InterpreterPrimitiveDispatchArm {
      arm: InterpreterPrimitiveArmId { identity: "planted:shared" },
      form: FreeCall,
      authored_spelling: "alpha",
      realization_module: "planted",
      dispatch_symbol: "planted_dispatch",
    },
    InterpreterPrimitiveDispatchArm {
      arm: InterpreterPrimitiveArmId { identity: "planted:shared" },
      form: FreeCall,
      authored_spelling: "beta",
      realization_module: "planted",
      dispatch_symbol: "planted_dispatch",
    },
  ]
  form_has_no_shadowed_spelling(rows: alias)
}

test fn lookup_is_dispatched_under_more_than_one_form() -> Bool {
  v1_interpreter_cross_form_spellings() |> any(s => s == "lookup")
}

test fn derived_and_declared_partition_the_surface() -> Bool {
  count(v1_interpreter_primitive_arms()) == v1_interpreter_derived_arm_count() + v1_interpreter_declared_arm_count()
}

data witness_control_pairing_note: String = "THE CONTROLS ARE A PAIR AND NEITHER IS OPTIONAL. shadow_detector_catches_a_planted_duplicate is the discriminating RED: without it a detector that always answered clean would pass both live-corpus witnesses and establish nothing. shadow_detector_admits_a_real_alias_pair is the positive control: two spellings under ONE arm identity is a legitimate alias, so a detector that refused it would be refusing the language rather than the defect. The live witnesses execute against the DERIVED free-call rows, which project the interpreter dispatch itself, so they read the tree rather than a transcript."
