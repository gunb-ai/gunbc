module test.claim.roadmap_dispatch_environment_witness_test


fn git_realization() -> gunbc.roadmap_execution_contract.CapabilityRealization {
  gunbc.roadmap_execution_contract.CapabilityRealization {
    capability: gunbc.roadmap_execution_contract.GitWorkspaceCapability,
    executable: "/usr/bin/git" as std.types.FilePath,
    identity_args: ["--version"],
    identity_contains: "git version" as std.types.NonEmptyStr,
    ensure_policy: gunbc.ensure.EnsureObserveOnly,
  }
}

fn claim_realization() -> gunbc.roadmap_execution_contract.CapabilityRealization {
  gunbc.roadmap_execution_contract.CapabilityRealization {
    capability: gunbc.roadmap_execution_contract.GunbcClaimRunnerCapability,
    executable: "/opt/gunbc/bin/gunbc" as std.types.FilePath,
    identity_args: ["--help"],
    identity_contains: "A causal compiler" as std.types.NonEmptyStr,
    ensure_policy: gunbc.ensure.EnsureObserveOnly,
  }
}

fn admitted_contract() -> WorkItemExecutionContract {
  gunbc.roadmap_execution_contract.ExecutionContract {
    validations: [
      gunbc.roadmap_execution_contract.GunbcClaimValidation {
        entry: "dag/test/claim/example_test.dag" as std.types.FilePath,
        function: "example_holds" as std.types.NonEmptyStr,
      },
    ],
    extra_capabilities: [],
  }
}

fn grounded_receipt(
  realization: gunbc.roadmap_execution_contract.CapabilityRealization,
  evidence: String,
) -> gunbc.roadmap_dispatch_environment.CapabilityEnsureReceipt {
  gunbc.roadmap_dispatch_environment.capability_ensure_receipt(
    realization: realization,
    observation: gunbc.ensure.EnsureObserved { evidence: evidence },
    identity_matches: true,
  )
}

fn grounded_capability(cap: gunbc.roadmap_execution_contract.ExecutionCapability) -> gunbc.roadmap_dispatch_environment.CapabilityEnsureReceipt {
  gunbc.roadmap_dispatch_environment.CapabilityEnsureReceipt {
    capability: cap,
    capability_label: gunbc.roadmap_execution_contract.execution_capability_label(capability: cap),
    executable: "/fixture/executable",
    decision: std.upsert_decision.Noop,
    grounded: true,
    evidence: "fixture identity evidence",
    reason: "",
  }
}

fn platform_grounded_receipts() -> List<gunbc.roadmap_dispatch_environment.CapabilityEnsureReceipt> {
  [
    grounded_receipt(
      realization: git_realization(),
      evidence: "git version 2.39",
    ),
    grounded_capability(cap: gunbc.roadmap_execution_contract.TmuxSessionCapability),
    grounded_capability(cap: gunbc.roadmap_execution_contract.TmuxPipeShellCapability),
    grounded_capability(cap: gunbc.roadmap_execution_contract.TeeEventCaptureCapability),
    grounded_capability(cap: gunbc.roadmap_execution_contract.ProviderEventProjectionCapability),
    grounded_capability(cap: gunbc.roadmap_execution_contract.EnvironmentBindingCapability),
    grounded_capability(cap: gunbc.roadmap_execution_contract.AttemptStateDirectoryCapability),
    grounded_capability(cap: gunbc.roadmap_execution_contract.AttemptCurrentPointerCapability),
  ]
}

fn admitted_fixture() -> gunbc.roadmap_dispatch_environment.DispatchEnvironmentAdmission {
  gunbc.roadmap_dispatch_environment.dispatch_environment_admission_decision(
    contract: admitted_contract(),
    receipts: concat(
      platform_grounded_receipts(),
      [grounded_receipt(
        realization: claim_realization(),
        evidence: "A causal compiler",
      )],
    ),
    validation_summary: "/opt/gunbc/bin/gunbc run --claim-run",
  )
}

test fn all_required_grounded_receipts_admit() -> Bool {
  match admitted_fixture() {
    gunbc.roadmap_dispatch_environment.EnvironmentAdmitted { receipts, validation_summary } =>
      count(receipts) == 9 && validation_summary != ""
    gunbc.roadmap_dispatch_environment.EnvironmentRefused { receipts: _, validation_summary: _, reason: _ } => false
  }
}

test fn missing_capability_realization_refuses() -> Bool {
  let missing = gunbc.roadmap_dispatch_environment.missing_capability_receipt(cap: gunbc.roadmap_execution_contract.GunbcClaimRunnerCapability)
  match gunbc.roadmap_dispatch_environment.dispatch_environment_admission_decision(
    contract: admitted_contract(),
    receipts: concat(platform_grounded_receipts(), [missing]),
    validation_summary: "validation command has no host capability realization",
  ) {
    gunbc.roadmap_dispatch_environment.EnvironmentAdmitted { receipts: _, validation_summary: _ } => false
    gunbc.roadmap_dispatch_environment.EnvironmentRefused { receipts: _, validation_summary: _, reason } =>
      string_contains(s: reason, pattern: "gunbc-claim-runner")
  }
}

test fn observe_only_absence_never_fabricates_apply() -> Bool {
  let receipt = gunbc.roadmap_dispatch_environment.capability_ensure_receipt(
    realization: claim_realization(),
    observation: gunbc.ensure.EnsureAbsent { reason: "gunbc missing" },
    identity_matches: false,
  )
  !receipt.grounded
    && std.upsert_decision.upsert_decision_label(decision: receipt.decision) == "refuse"
    && string_contains(s: receipt.reason, pattern: "gunbc missing")
}

test fn may_apply_without_a_typed_plan_still_refuses() -> Bool {
  let realization = gunbc.roadmap_execution_contract.CapabilityRealization {
    capability: gunbc.roadmap_execution_contract.CargoCapability,
    executable: "/home/briansrls/.cargo/bin/cargo" as std.types.FilePath,
    identity_args: ["--version"],
    identity_contains: "cargo" as std.types.NonEmptyStr,
    ensure_policy: gunbc.ensure.EnsureMayApply,
  }
  let receipt = gunbc.roadmap_dispatch_environment.capability_ensure_receipt(
    realization: realization,
    observation: gunbc.ensure.EnsureAbsent { reason: "cargo missing" },
    identity_matches: false,
  )
  !receipt.grounded
    && std.upsert_decision.upsert_decision_label(decision: receipt.decision) == "refuse"
    && string_contains(s: receipt.reason, pattern: "generic Ensure cannot choose an installer")
}

test fn unspecified_contract_refuses_before_capability_checks() -> Bool {
  match gunbc.roadmap_dispatch_environment.dispatch_environment_admission_decision(
    contract: gunbc.roadmap_execution_contract.ExecutionContractUnspecified,
    receipts: [],
    validation_summary: "execution contract unspecified",
  ) {
    gunbc.roadmap_dispatch_environment.EnvironmentAdmitted { receipts: _, validation_summary: _ } => false
    gunbc.roadmap_dispatch_environment.EnvironmentRefused { receipts, validation_summary: _, reason } =>
      count(receipts) == 0 && string_contains(s: reason, pattern: "will not guess")
  }
}

test fn admission_receipt_is_structured_and_located() -> Bool {
  let wire = gunbc.roadmap_dispatch_environment.dispatch_environment_admission_json(admission: admitted_fixture())
  string_contains(s: wire, pattern: "\"status\": \"admitted\"")
    && string_contains(s: wire, pattern: "\"capability\": \"git-workspace\"")
    && string_contains(
      s: wire,
      pattern: "\"capability\": \"provider-event-projection\"",
    )
    && string_contains(s: wire, pattern: "\"grounded\": true")
}

data empty_validation_contract_refusal_note: String = "review 44043 predicate dissolution. execution_contract_is_specified collapsed the WorkItemExecutionContract coproduct to a Bool, and its two false cases carried ONE refusal reason: an unspecified contract and a specified contract declaring zero validations are different states with different remedies (declare a contract vs. fix the one you declared). The decision now matches the coproduct directly and each state gets its own located diagnostic. This is the arm that had no witness at all before, because the predicate hid it."

test fn empty_validation_contract_refuses_with_its_own_reason() -> Bool {
  match gunbc.roadmap_dispatch_environment.dispatch_environment_admission_decision(
    contract: gunbc.roadmap_execution_contract.ExecutionContract { validations: [], extra_capabilities: [] },
    receipts: [],
    validation_summary: "",
  ) {
    gunbc.roadmap_dispatch_environment.EnvironmentAdmitted { receipts: _, validation_summary: _ } => false
    gunbc.roadmap_dispatch_environment.EnvironmentRefused { receipts: _, validation_summary: _, reason } =>
      string_contains(s: reason, pattern: "declares no validation operations")
        && !string_contains(s: reason, pattern: "will not guess")
  }
}

test fn roadmap_dispatch_environment_keystone_holds() -> Bool {
  empty_validation_contract_refuses_with_its_own_reason()
    && all_required_grounded_receipts_admit()
    && missing_capability_realization_refuses()
    && observe_only_absence_never_fabricates_apply()
    && may_apply_without_a_typed_plan_still_refuses()
    && unspecified_contract_refuses_before_capability_checks()
    && admission_receipt_is_structured_and_located()
}
