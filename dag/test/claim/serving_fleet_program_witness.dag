module test.claim.serving_fleet_program_witness

import std.types { Bool, Int, List, String }
import std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import std.algebra { Cons, Empty, string_contains }
import v2.std.decl_index { DeclFact, decl_facts_at, qualified_name_from_module }
import std.markdown { MarkdownDocument }
import gunbc.plan { plan_projects_committed_markdown }
import gunbc.plan_registry { all_plans }
import extdeps.languages.markdown { serialize_markdown_source }
import gunbc.plans.serving_fleet_program { serving_fleet_program_plan }

// Guards on the serving-fleet umbrella CARRIER (DESIGN section 1: a plan's authority is its
// .dag carrier). The plan is an index, so the claims are about its rows: the body is read
// through the repository's own serializer, every row cites a symbol, and every cited symbol
// resolves in the declaration census. The citation machinery has the shape of
// `test.claim.sfp_home_serving_power_semantics_witness`: the roster is DERIVED from the text
// and every `::` must be covered by it, so narrowing the shape test reddens a conjunct.

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

type SfpPositionScan {
  index: Int
  prev_ends_in_digit: Bool
  found_positional: Bool
}

fn sfp_is_digit(c: String) -> Bool {
  (c != "") && string_contains(s: "0123456789", pattern: c)
}

fn sfp_last_is_digit(s: String) -> Bool {
  sfp_is_digit(c: substring(s: s, start: s.length() - 1, end: s.length()))
}

fn sfp_positional_step(acc: SfpPositionScan, segment: String) -> SfpPositionScan {
  let begins_in_digit = sfp_is_digit(c: substring(s: segment, start: 0, end: 1))
  SfpPositionScan {
    index: acc.index + 1,
    prev_ends_in_digit: sfp_last_is_digit(s: segment),
    found_positional: acc.found_positional || (acc.index > 0 && begins_in_digit && !acc.prev_ends_in_digit)
  }
}

fn sfp_has_positional_citation(t: String) -> Bool {
  fold(
    t.split(delimiter: ":"),
    init: SfpPositionScan { index: 0, prev_ends_in_digit: false, found_positional: false },
    f: sfp_positional_step
  ).found_positional
}

type SfpCitation {
  module_path: String
  decl_name: String
  field_name: String
  has_field: Bool
}

// the pieces of the text that could be citations, split on the delimiters that surround one
fn sfp_pieces(t: String) -> List<String> {
  filter(
    flat_map(t.split(delimiter: "\n"), line =>
      flat_map(line.split(delimiter: " "), word => word.split(delimiter: "`"))),
    w => w != ""
  )
}

fn sfp_char_of(s: String) -> String {
  substring(s: s, start: s.length() - 1, end: s.length())
}

// the shape test. A citation is `module::decl` or `module::decl.field` and NOTHING else:
// exactly one `::` pair, no path separator, no punctuation, no whitespace. The separator is
// removed before the rejection scan because `::` itself contains a colon, which is otherwise
// a reject character -- that bug was live in the first draft of this test and rejected every
// citation, which is the kind of thing a measured roster catches and an assumed one does not.
fn sfp_body_is_clean(body: String) -> Bool {
  !(string_contains(s: body, pattern: "/")
    || string_contains(s: body, pattern: "(")
    || string_contains(s: body, pattern: ")")
    || string_contains(s: body, pattern: "[")
    || string_contains(s: body, pattern: "]")
    || string_contains(s: body, pattern: "{")
    || string_contains(s: body, pattern: "}")
    || string_contains(s: body, pattern: ",")
    || string_contains(s: body, pattern: ";")
    || string_contains(s: body, pattern: "*")
    || string_contains(s: body, pattern: "?")
    || string_contains(s: body, pattern: "=")
    || string_contains(s: body, pattern: "+")
    || string_contains(s: body, pattern: "<")
    || string_contains(s: body, pattern: ">")
    || string_contains(s: body, pattern: "&")
    || string_contains(s: body, pattern: "!")
    || string_contains(s: body, pattern: "\"")
    || string_contains(s: body, pattern: "'")
    || string_contains(s: body, pattern: "~")
    || string_contains(s: body, pattern: "^")
    || string_contains(s: body, pattern: "|")
    || string_contains(s: body, pattern: "#")
    || string_contains(s: body, pattern: "\\")
    || sfp_char_of(s: body) == "."
    || substring(s: body, start: 0, end: 1) == ".")
}

// The shape is matched STRUCTURALLY rather than counted: `a::b` with nothing after the
// second part is exactly one separator. Three arms' worth of `length() == 2 && parts[0]
// != "" ...` was what the first draft did, and indexing is safe-indexing here -- it hands
// back Optional, which infer caught. Matching Cons/Empty is also how the repo reads a
// split apart (`extdeps.linux.proc_pid_stat`, `test.claim.runner.runner_qemu_host_standing`).
// The separator is removed before the rejection scan because `::` itself contains a colon,
// which is otherwise a reject character -- that bug was live in the first draft and rejected
// every citation, which is what a measured roster catches and an assumed one does not.
fn sfp_is_citation_shape(w: String) -> Bool {
  match w.split(delimiter: "::") {
    Cons { head: m, tail: Cons { head: d, tail: Empty } } => m != "" && d != "" && sfp_body_is_clean(body: concat(m, d))
    _ => false
  }
}

// Only ever reached on a string that sfp_is_citation_shape accepted, so the two-arm
// reading is total in practice; the `_` arm exists because a match must be total, and it
// yields the one thing that cannot resolve -- an empty module -- rather than a guess.
fn sfp_parse(w: String) -> SfpCitation {
  // Bound with an explicit element type rather than matched in place: a List produced straight
  // off `split` in a pattern leaves the element type as a bare variable, and `rest.split` then
  // fails to resolve (the receiver's type is T, which establishes no method surface). The repo's
  // own readers annotate the bind -- materialization_store_local.dag does exactly this.
  let parts: List<String> = w.split(delimiter: "::")
  match parts {
    Cons { head: m, tail: Cons { head: rest, tail: Empty } } =>
      {
      let dots: List<String> = rest.split(delimiter: ".")
      match dots {
        Cons { head: d, tail: Cons { head: fld, tail: Empty } } =>
          SfpCitation { module_path: m, decl_name: d, field_name: fld, has_field: true }
        _ => SfpCitation { module_path: m, decl_name: rest, field_name: "", has_field: false }
      }
      }
    _ => SfpCitation { module_path: "", decl_name: "", field_name: "", has_field: false }
  }
}

fn sfp_roster_step(acc: List<String>, w: String) -> List<String> {
  if sfp_is_citation_shape(w) && !any(acc, a => a == w) { Cons { head: w, tail: acc } } else { acc }
}

fn sfp_citation_roster(t: String) -> List<String> {
  fold(sfp_pieces(t), init: Empty {}, f: sfp_roster_step)
}

fn sfp_occurrences(t: String, cite: String) -> Int {
  // n occurrences of a separator produce n+1 pieces, so occurrences = pieces - 1. The
  // obvious `filter(non-empty).length()` undercounts (two occurrences with an empty piece
  // between them give 1, not 2) -- caught by running the roster arithmetic, not by reading it.
  t.split(delimiter: cite).length() - 1
}

// THE POSITIVE CONTROL ON THE DERIVATION ITSELF. Every `::` in the text must be covered by
// the roster; if the shape test ever excludes a real citation, or the roster is narrowed to
// make the claim pass, this conjunct goes red rather than the claim going quietly green.
fn sfp_citation_count_is_conserved(t: String) -> Bool {
  let roster = sfp_citation_roster(t)
  let covered = fold(roster, init: 0, f: (n, cite) => n + sfp_occurrences(t: t, cite: cite))
  let separators = t.split(delimiter: "::").length() - 1
  covered == separators && separators > 20
}

// THE ONE CENSUS KEY PATH. Every census lookup in this module goes through
// `sfp_census_rows`, which parses the citation the way the document writes it and then asks
// `v2.std.decl_index::qualified_name_from_module` — the function that OWNS that key — to
// build it. Three of these lookups used to hand-build the key at the call site and each got it
// wrong in its own way: two passed `Module::Decl` straight in (the census key contains no `::`, so
// such a lookup matches nothing and the claim reddens on a fact that is actually true), and one
// concatenated `module + "." + name` by hand (the key is the module's own qualified name, `v2.`
// prefix kept, built only by `qualified_name_from_module`). A
// key rule restated at each call site rots exactly like this one did; the root list is likewise
// named once, so no site can quietly widen or narrow the population it is querying.
fn sfp_census_pool_roots() -> List<String> {
  ["dag", "src/v1", "src/v2"]
}

fn sfp_census_rows_parsed(c: SfpCitation) -> List<DeclFact> {
  decl_facts_at(
    pool_roots: sfp_census_pool_roots(),
    qualified_name: qualified_name_from_module(module_name: c.module_path, name: c.decl_name)
  )
}

fn sfp_census_rows(cite: String) -> List<DeclFact> {
  sfp_census_rows_parsed(c: sfp_parse(w: cite))
}

// A FIELD is not a declaration, so the census cannot answer for it. Checked instead against
// the declaring file's own text, read with `filesystem_read` at the `rel_path` the census row
// carries -- so the file is the census's, not one this claim guessed. Honest about its reach:
// this proves the field is written as a field line (`  name: Type`) somewhere in that file,
// which is weaker than a name-resolved field lookup, and the two citations that need it are
// `extdeps.gpu.types::GpuModelCatalogRow.tdp_watts` and
// `gunbc.spark.serving_performance_subject::ServingAcceleratorRealization.applied_power_limit`.
fn sfp_citation_resolves(cite: String) -> Bool {
  sfp_census_rows_parsed(c: sfp_parse(w: cite)).length() >= 1
}

fn carrier_text() -> String {
  serialize_markdown_source(doc: MarkdownDocument { blocks: serving_fleet_program_plan.body })
}

fn carrier_is_registered() -> Bool {
  fold(all_plans, init: false, f: (acc, p) => acc || p.slug == "serving-fleet-program")
}

test fn the_carrier_is_registered_and_is_the_only_authority() -> Bool {
  carrier_is_registered()
    && plan_projects_committed_markdown(p: serving_fleet_program_plan) == false
}

test fn the_carrier_cites_symbols_and_never_a_line_number() -> Bool {
  let t = carrier_text()
  t.length() > 4000
    && string_contains(s: t, pattern: "product.fabric.serving_recipe::serving_unit_cost_for_selection")
    && !(string_contains(s: t, pattern: ".dag:")
      || string_contains(s: t, pattern: ".rs:")
      || string_contains(s: t, pattern: "DESIGN.md:")
      || sfp_has_positional_citation(t: t))
}

// Public repository: no endpoint, address or credential vocabulary may appear in the carrier.
test fn the_carrier_names_no_endpoint_or_secret() -> Bool {
  let t = carrier_text()
  t.length() > 4000
    && !(string_contains(s: t, pattern: "http://")
      || string_contains(s: t, pattern: "https://")
      || string_contains(s: t, pattern: ".ts.net")
      || string_contains(s: t, pattern: "sk-"))
}

// Every deliverable row (a line carrying `Standing:`, so a row missing it is counted out and the floor below reddens) names its owner as a resolvable
// symbol, states a standing, says what done means and names its dependency edge. A row whose
// symbol is missing, or an index that lost its rows, goes red.
fn row_lines() -> List<String> {
  filter(carrier_text().split(delimiter: "\n"), l => string_contains(s: l, pattern: "Standing:"))
}

fn row_has_required_parts(l: String) -> Bool {
  string_contains(s: l, pattern: "Standing:")
    && string_contains(s: l, pattern: "Done:")
    && string_contains(s: l, pattern: "Depends on")
}

fn row_cites_a_resolvable_symbol(l: String) -> Bool {
  let cites = sfp_citation_roster(t: l)
  cites.length() >= 1 && all(cites, c => sfp_citation_resolves(cite: c))
}

test fn every_row_has_its_parts_and_cites_a_resolvable_symbol() -> Bool {
  let rows = row_lines()
  rows.length() >= 18
    && all(rows, l => row_has_required_parts(l: l))
    && all(rows, l => row_cites_a_resolvable_symbol(l: l))
}

test fn the_citations_in_the_plan_resolve_against_the_declaration_census() -> Bool {
  let t = carrier_text()
  let roster = sfp_citation_roster(t: t)
  // Negative control: a name the census cannot hold must stay unresolved, so an empty read
  // cannot satisfy the positives vacuously.
  sfp_citation_count_is_conserved(t: t)
    && roster.length() > 20
    && !sfp_citation_resolves(cite: "gunbc.serving.no_such_module::NoSuchSymbol")
    && all(roster, cite => sfp_citation_resolves(cite: cite))
}
