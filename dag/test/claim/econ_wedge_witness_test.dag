test fn w_gitlab_gross_margin_envelope_derived_from_filed_components() -> Bool {
  match gunbc.econ.margin_envelope.derive_margin_envelope_from_filed_facts(
    revenue: extdeps.sec.issuer.gitlab_facts.gitlab_fy2026_revenue,
    profit: extdeps.sec.issuer.gitlab_facts.gitlab_fy2026_gross_profit,
    margin_kind: gunbc.econ.margin_envelope.GrossMargin,
  ) {
    gunbc.econ.margin_envelope.MarginEnvelopeDerived { envelope: env, margin_kind: gunbc.econ.margin_envelope.GrossMargin } =>
      gunbc.econ.margin_envelope.margin_envelope_in_band(
        envelope: env,
        low_bp: gitlab_fy2026_gross_margin_bp_low,
        high_bp: gitlab_fy2026_gross_margin_bp_high,
      )
    _ => false
  }
}

test fn w_gitlab_gross_margin_envelope_red_on_perturbed_gross_profit() -> Bool {
  match extdeps.sec.facts.filed_amount(fact: extdeps.sec.issuer.gitlab_facts.gitlab_fy2026_gross_profit) {
    Present { value: gross_profit } => {
      let perturbed = extdeps.sec.facts.usd_whole_dollars(
        count: extdeps.sec.facts.usd_whole_dollars_count(gross_profit) + 10000000
      )
      match gunbc.econ.margin_envelope.derive_margin_envelope_from_filed_facts(
        revenue: extdeps.sec.issuer.gitlab_facts.gitlab_fy2026_revenue,
        profit: extdeps.sec.facts.FiledMonetaryFact {
          element: gitlab_fy2026_gross_profit.element,
          amount: Filed { amount: perturbed },
          citation: gitlab_fy2026_gross_profit.citation,
        },
        margin_kind: gunbc.econ.margin_envelope.GrossMargin,
      ) {
        gunbc.econ.margin_envelope.MarginEnvelopeDerived { envelope: env, margin_kind: gunbc.econ.margin_envelope.GrossMargin } =>
          !gunbc.econ.margin_envelope.margin_envelope_in_band(
            envelope: env,
            low_bp: gitlab_fy2026_gross_margin_bp_low,
            high_bp: gitlab_fy2026_gross_margin_bp_high,
          )
        _ => false
      }
    }
    _ => false
  }
}

