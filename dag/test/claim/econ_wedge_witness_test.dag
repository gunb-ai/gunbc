test fn w_hetzner_ax41_threads_cited_from_amd_catalog() -> Bool {
  std.measure.hardware_thread_count_value(t: extdeps.pricing.hetzner_dedicated.hetzner_dedicated_server_threads(row: extdeps.pricing.hetzner_dedicated.hetzner_ax41_1_ltd_price)) == std.measure.hardware_thread_count_value(t: ryzen_5_3600_catalog.threads)
    && std.measure.hardware_thread_count_value(t: ryzen_5_3600_catalog.threads) == 12
}

test fn w_github_hetzner_knowable_wedge_derived_with_declared_assumptions() -> Bool {
  match gunbc.econ.knowable_wedge.derive_github_hetzner_ci_minute_wedge(
    umbrella_row: extdeps.pricing.github_actions.github_actions_linux_2core_price,
    floor_row: extdeps.pricing.hetzner_dedicated.hetzner_ax41_1_ltd_price,
    assumptions_input: gunbc.econ.knowable_wedge.WedgeAssumptionsDeclared {
      assumptions: github_hetzner_wedge_assumptions,
    },
  ) {
    gunbc.econ.knowable_wedge.KnowableWedgeComputed { wedge: w } =>
      std.measure.money_per_minute_micros(q: w.umbrella_per_minute) == 6000
        && std.measure.money_per_minute_micros(q: w.cost_floor_per_minute) == std.measure.money_per_minute_micros(q: github_hetzner_wedge_floor_usd_per_minute)
        && std.measure.money_per_minute_micros(q: w.wedge_per_minute) == std.measure.money_per_minute_micros(q: github_hetzner_wedge_spread_usd_per_minute)
    _ => false
  }
}

test fn w_github_hetzner_knowable_wedge_red_on_unknown_assumptions() -> Bool {
  match gunbc.econ.knowable_wedge.derive_github_hetzner_ci_minute_wedge(
    umbrella_row: extdeps.pricing.github_actions.github_actions_linux_2core_price,
    floor_row: extdeps.pricing.hetzner_dedicated.hetzner_ax41_1_ltd_price,
    assumptions_input: gunbc.econ.knowable_wedge.WedgeAssumptionsUnknown,
  ) {
    gunbc.econ.knowable_wedge.KnowableWedgeRefused { cause: gunbc.econ.knowable_wedge.AssumptionsUnknown } => true
    _ => false
  }
}

