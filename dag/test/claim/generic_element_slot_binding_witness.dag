module test.claim.generic_element_slot_binding_witness

// THE CLASS THIS FILE HOLDS OPEN. v1.compiler.infer unify_generic_child_pairs bound a callee's type variable to
// the actual application's ELEMENT SLOT rather than to the type the slot holds. The slot is named by the
// container declaration's own parameter (FreeMonoid's `T`) and carries the argument's type in its inferred, so
// every reader of the substitution that keys on the bound node's name or spelling saw an unbound `T`. Two
// shapes, one link (generic_actual_position_type, moved from v1.compiler.infer to v1.compiler.infer_env
// when the settle family below needed the same read -- v1.compiler.types imports infer_env, so the read
// could not live above either consumer):
//
//   bold-koi-381 (work item adhoc-b5f23a5d-052): `fn(h) { h.digest }` keyed through a generic over
//   `xs: List<Hash>`, `type Hash = Payload`, refused "no field 'digest' on type 'T'" -- the field-access alias
//   chain looks its next declaration up by the bound node's NAME. The sort_by wave hit it over v2.std.node's
//   `type Hash = Fnv1a64Structural` and worked around it with an annotated let.
//
//   smart-tern-402 (#15115): `skip(split(..), n: 1) |> first` left its Present arm undecided -- a kernel-built
//   List's slot is also SPELLED `T`.
//
// A record element escaped by accident (its slot's inferred is the record, found structurally before the
// name), which is why List<Payload> is a control and not a climb.
//
// MEASURED on main 88e8991e557 with the seed built from that tree, and again with this change: both climbs
// refuse on main and compile clean with it; every control compiles clean on both, and the undeclared-field
// arm refuses on both. The v2 control for the same shape is v2.test.claim.compiler.lambda_alias_field_key
// lafk_a_lambda_key_through_an_imported_alias_types_its_field (v2 types it; DESIGN section 7: a seed defect v2
// does not carry forward).
//
// HARNESS PAIRING, as in test.claim.transparent_alias_identity_witness: compile_dag_rust_emit_check returns
// false for more than one reason, so the refusal arm is paired with the same module minus the offending read.

fn slot_prelude() -> String {
  "type Payload {\n  digest: String\n}\n\ntype Hash = Payload\n\nfn sk<Q, K>(xs: List<Q>, key: fn(Q) -> K) -> List<Q> {\n  xs\n}\n\nfn take(p: Payload) -> String {\n  p.digest\n}\n\n"
}

fn slot_source(module_leaf: String, body: String) -> String {
  concat(concat(concat(concat("module slotbind.", module_leaf), "\n\nimport std.types { List, String }\n\n"), slot_prelude()), body)
}

fn slot_alias_key_source() -> String {
  slot_source(module_leaf: "aliaskey", body: "fn keyed(xs: List<Hash>) -> List<Hash> {\n  sk(xs: xs, key: fn(h) { h.digest })\n}\n")
}

fn slot_record_key_source() -> String {
  slot_source(module_leaf: "recordkey", body: "fn keyed(xs: List<Payload>) -> List<Payload> {\n  sk(xs: xs, key: fn(h) { h.digest })\n}\n")
}

fn slot_alias_at_formal_source() -> String {
  slot_source(module_leaf: "aliasformal", body: "fn keyed(xs: List<Hash>) -> List<Hash> {\n  sk(xs: xs, key: fn(h) { take(p: h) })\n}\n")
}

fn slot_alias_undeclared_source() -> String {
  slot_source(module_leaf: "aliasnope", body: "fn keyed(xs: List<Hash>) -> List<Hash> {\n  sk(xs: xs, key: fn(h) { h.nope })\n}\n")
}

fn slot_alias_undeclared_control_source() -> String {
  slot_source(module_leaf: "aliasnope", body: "fn keyed(xs: List<Hash>) -> List<Hash> {\n  sk(xs: xs, key: fn(h) { 1 })\n}\n")
}

// THE UNBOUND-PARAMETER READ: the slot's element is a type variable NOTHING grounds -- a parameter with no
// declaration behind it. Kept identity must not turn this into an acceptance: the field read on a parameter
// that declares no record can never be established, so this refuses with the guard for the same reason it
// refused without one. The arm is the guard's fail-closed side (the descent keeps the slot's identity for an
// unsolved variable; the reader must still refuse the undeclared name), paired with the module-minus-read
// control below so it measures the read and not the harness.
fn slot_unbound_param_field_source() -> String {
  "module slotbind.unboundparam\n\nimport std.types { List, String }\n\nfn sk<Q, K>(xs: List<Q>, key: fn(Q) -> K) -> List<Q> {\n  xs\n}\n\nfn field_on_unbound<T>(xs: List<T>) -> List<T> {\n  sk(xs: xs, key: fn(e) { e.digest })\n}\n"
}

fn slot_unbound_param_control_source() -> String {
  "module slotbind.unboundparam\n\nimport std.types { List, String }\n\nfn sk<Q, K>(xs: List<Q>, key: fn(Q) -> K) -> List<Q> {\n  xs\n}\n\nfn field_on_unbound<T>(xs: List<T>) -> List<T> {\n  sk(xs: xs, key: fn(e) { 1 })\n}\n"
}

fn slot_kernel_split_source() -> String {
  "module slotbind.kernelsplit\n\nimport std.algebra { skip }\nimport std.optional { Present, Absent }\nimport std.types { String, Bool }\n\nfn second_nonempty(s: String) -> Bool {\n  let parts = split(s: s, delimiter: \"/\")\n  match skip(parts, n: 1) |> first {\n    Present { value: v } => v != \"\"\n    Absent => false\n  }\n}\n"
}

fn slot_kernel_split_annotated_source() -> String {
  "module slotbind.kernelsplitann\n\nimport std.algebra { skip }\nimport std.optional { Present, Absent }\nimport std.types { List, String, Bool }\n\nfn second_nonempty(s: String) -> Bool {\n  let parts: List<String> = split(s: s, delimiter: \"/\")\n  match skip(parts, n: 1) |> first {\n    Present { value: v } => v != \"\"\n    Absent => false\n  }\n}\n"
}

// THE CLIMB (bold-koi-381's RED). Refused on main: "no field 'digest' on type 'T'".
test fn a_lambda_key_reads_a_field_through_an_alias_element_test() -> Bool {
  compile_dag_rust_emit_check(slot_alias_key_source(), "src/slotbind_aliaskey.rs", ["keyed"], ["compile_error"])
}

// THE CLIMB (smart-tern-402's RED). Refused on main: the Present arm is undecided.
test fn a_kernel_built_list_binds_a_declared_generic_test() -> Bool {
  compile_dag_rust_emit_check(slot_kernel_split_source(), "src/slotbind_kernelsplit.rs", ["second_nonempty"], ["compile_error"])
}

// CONTROL: the same shape with the slot's type annotated by the author compiles on main too.
test fn a_kernel_built_list_with_an_annotated_let_binds_test() -> Bool {
  compile_dag_rust_emit_check(slot_kernel_split_annotated_source(), "src/slotbind_kernelsplitann.rs", ["second_nonempty"], ["compile_error"])
}

// FAIL-CLOSED SIDE OF THE GENERALIZED GUARD (non-empty-list unsolved slot): an ungrounded parameter's
// element keeps its identity at generic_actual_position_type instead of descending, and the field read on it
// STILL refuses -- nothing grounds it, so no reader can key on it. Guards that keep unsolved identity must
// not become acceptances. A CLIMB for this shape (refused on main, types with the change) is not authorable
// at a field read: an unsolved variable with nothing grounding it has no establishedness to recover, so this
// pair, not a RED, is what the non-empty-list half can assert.
test fn an_unbound_parameter_element_still_refuses_a_field_read_test() -> Bool {
  !compile_dag_rust_emit_check(slot_unbound_param_field_source(), "src/slotbind_unboundparam.rs", [], [])
}

// ITS HARNESS CONTROL: the module without the read compiles with the guard, so the arm above measures the
// read and not the harness.
test fn an_unbound_parameter_module_without_the_read_compiles_test() -> Bool {
  compile_dag_rust_emit_check(slot_unbound_param_control_source(), "src/slotbind_unboundparam.rs", ["field_on_unbound"], ["compile_error"])
}

// CONTROL: a record element, which escaped by accident before this change and must stay clean.
test fn a_lambda_key_reads_a_field_through_a_record_element_test() -> Bool {
  compile_dag_rust_emit_check(slot_record_key_source(), "src/slotbind_recordkey.rs", ["keyed"], ["compile_error"])
}

// CONTROL: the alias element at a declared record formal, judged by the alias identity relation.
test fn an_alias_element_inhabits_its_records_formal_test() -> Bool {
  compile_dag_rust_emit_check(slot_alias_at_formal_source(), "src/slotbind_aliasformal.rs", ["keyed"], ["compile_error"])
}

// POSITIVE CONTROL: the slot is read as its type, not as anything -- a field the record does not declare still
// refuses through the alias element.
test fn an_alias_element_still_refuses_an_undeclared_field_test() -> Bool {
  !compile_dag_rust_emit_check(slot_alias_undeclared_source(), "src/slotbind_aliasnope.rs", [], [])
}

// ITS HARNESS CONTROL: the same module without the undeclared read compiles, so the arm above measures the
// field read and not the harness.
test fn an_alias_element_module_without_the_undeclared_read_compiles_test() -> Bool {
  compile_dag_rust_emit_check(slot_alias_undeclared_control_source(), "src/slotbind_aliasnope.rs", ["keyed"], ["compile_error"])
}

// THE BRANCH-JOIN SHAPE (the last corpus diagnostic). v2.compiler.dependency_demand_census.dag's
// demand_census_add_example joins a branch that returns the list itself against a branch that rebuilds it
// with list_snoc_item, with an equality fold over the same element type in the middle condition; with the
// unguarded arm the else branch's element type arrives at the if-join mangled
// (FreeMonoid<Coproduct(FreeMonoid)>), and the join refuses 'if branches resolve to incompatible types'
// even though both branches are List<QualifiedName> to the author. These probes reproduce the shape without
// the corpus so a join fix is measurable without a full self-host round; the fix is the establishedness
// discipline at the join, the sibling site of generic_actual_position_type (same one rule).
fn slot_branch_join_source() -> String {
  "module slotbind.branchjoin\n\nimport std.algebra { Cons, Empty, FreeMonoid, list_snoc_item, fold_list, length }\nimport std.types { List, String, Bool }\n\ntype Qn = FreeMonoid<String>\n\nfn qn_eq(a: Qn, b: Qn) -> Bool {\n  fold_list(xs: a, empty: false, cons: fn(any, e) { any || (e == \"x\") }) && fold_list(xs: b, empty: false, cons: fn(any, e) { any || (e == \"x\") })\n}\n\nfn has_example(examples: List<Qn>, module: Qn) -> Bool {\n  fold_list(xs: examples, empty: false, cons: fn(any, e) { any || qn_eq(a: e, b: module) })\n}\n\nfn add_example(examples: List<Qn>, module: Qn) -> List<Qn> {\n  if length(xs: examples) >= 2 {\n    examples\n  } else if has_example(examples: examples, module: module) {\n    examples\n  } else {\n    list_snoc_item(xs: examples, item: module)\n  }\n}\n"
}

// ITS HARNESS CONTROL: the same module with the snoc branch replaced by the list itself -- without the
// rebuild the join sees two same-spelled branches, so a refusal of the arm above and a pass here measures
// the rebuild branch, not the harness.
fn slot_branch_join_control_source() -> String {
  "module slotbind.branchjoin\n\nimport std.algebra { Cons, Empty, FreeMonoid, list_snoc_item, fold_list, length }\nimport std.types { List, String, Bool }\n\ntype Qn = FreeMonoid<String>\n\nfn qn_eq(a: Qn, b: Qn) -> Bool {\n  fold_list(xs: a, empty: false, cons: fn(any, e) { any || (e == \"x\") }) && fold_list(xs: b, empty: false, cons: fn(any, e) { any || (e == \"x\") })\n}\n\nfn has_example(examples: List<Qn>, module: Qn) -> Bool {\n  fold_list(xs: examples, empty: false, cons: fn(any, e) { any || qn_eq(a: e, b: module) })\n}\n\nfn add_example(examples: List<Qn>, module: Qn) -> List<Qn> {\n  if length(xs: examples) >= 2 {\n    examples\n  } else if has_example(examples: examples, module: module) {\n    examples\n  } else {\n    examples\n  }\n}\n"
}

// THE CLIMB: both branches are List<Qn> to the author, so the join must accept. (Refused at head 48da33a862c
// before the join fix; measured by the claim run at the binding keen-heron-809 takes on srv1.)
test fn a_branch_join_over_a_rebuilt_alias_list_types_test() -> Bool {
  compile_dag_rust_emit_check(slot_branch_join_source(), "src/slotbind_branchjoin.rs", ["add_example"], ["compile_error"])
}

// ITS CONTROL compiles on both sides of the join fix.
test fn a_branch_join_without_the_rebuild_compiles_test() -> Bool {
  compile_dag_rust_emit_check(slot_branch_join_control_source(), "src/slotbind_branchjoin.rs", ["add_example"], ["compile_error"])
}

// BISECT PROBES for the join failure (round 3): each toggles ONE feature of the reproducer against
// the failing shape, so a run tells which feature the arm trips on -- the fold's equality test, the
// snoc generic call itself, or the multi-branch shape. Qn stays the local alias throughout.
fn slot_join_probe_source(module_name: String, body: String) -> String {
  concat("module ", module_name, "\n\nimport std.algebra { Cons, Empty, FreeMonoid, list_snoc_item, fold_list, length }\nimport std.types { List, String, Bool }\n\ntype Qn = FreeMonoid<String>\n\nfn qn_eq(a: Qn, b: Qn) -> Bool {\n  fold_list(xs: a, empty: false, cons: fn(any, e) { any || (e == \"x\") }) && fold_list(xs: b, empty: false, cons: fn(any, e) { any || (e == \"x\") })\n}\n\nfn has_example(examples: List<Qn>, module: Qn) -> Bool {\n  fold_list(xs: examples, empty: false, cons: fn(any, e) { any || qn_eq(a: e, b: module) })\n}\n\nfn add_example(examples: List<Qn>, module: Qn) -> List<Qn> {\n", body, "\n}\n")
}
// P1: else uses a DIRECT generic snoc call (the failing shape).
fn slot_join_p1_source() -> String {
  slot_join_probe_source(module_name: "slotbind.jp1", body: "  if length(xs: examples) >= 2 {\n    examples\n  } else if has_example(examples: examples, module: module) {\n    examples\n  } else {\n    list_snoc_item(xs: examples, item: module)\n  }")
}

// P2: else calls snoc through a LOCAL GENERIC WRAPPER (is the trip the direct builtin-shaped call or any generic?).
fn slot_join_p2_source() -> String {
  concat(slot_join_probe_source(module_name: "slotbind.jp2", body: "  if length(xs: examples) >= 2 {\n    examples\n  } else if has_example(examples: examples, module: module) {\n    examples\n  } else {\n    qn_snoc(xs: examples, item: module)\n  }"), "\n\nfn qn_snoc<T>(xs: List<T>, item: T) -> List<T> {\n  list_snoc_item(xs: xs, item: item)\n}\n")
}

// P3: no qn_eq in the middle condition (length only) WITH the snoc else (is the fold-equality needed?).
fn slot_join_p3_source() -> String {
  slot_join_probe_source(module_name: "slotbind.jp3", body: "  if length(xs: examples) >= 2 {\n    examples\n  } else if length(xs: examples) == 1 {\n    examples\n  } else {\n    list_snoc_item(xs: examples, item: module)\n  }")
}

// P4: CONCRETE element (String list, snoc of String, no alias) with the full shape (alias required?).
fn slot_join_p4_source() -> String {
  concat("module slotbind.jp4\n\nimport std.algebra { Cons, Empty, FreeMonoid, list_snoc_item, fold_list, length }\nimport std.types { List, String, Bool }\n\nfn s_eq(a: String, b: String) -> Bool {\n  a == b\n}\n\nfn has_example(examples: List<String>, module: String) -> Bool {\n  fold_list(xs: examples, empty: false, cons: fn(any, e) { any || s_eq(a: e, b: module) })\n}\n\nfn add_example(examples: List<String>, module: String) -> List<String> {\n  if length(xs: examples) >= 2 {\n    examples\n  } else if has_example(examples: examples, module: module) {\n    examples\n  } else {\n    list_snoc_item(xs: examples, item: module)\n  }\n}\n")
}

// P5: two-branch if (no else-if chain) with the alias AND snoc (does the chain matter?).
fn slot_join_p5_source() -> String {
  slot_join_probe_source(module_name: "slotbind.jp5", body: "  if has_example(examples: examples, module: module) {\n    examples\n  } else {\n    list_snoc_item(xs: examples, item: module)\n  }")
}

// P6: alias element WITHOUT the equality fold AND without snoc -- the module-only floor (must pass; harness control for P1-P5 shape drift).
fn slot_join_p6_source() -> String {
  slot_join_probe_source(module_name: "slotbind.jp6", body: "  if length(xs: examples) >= 2 {\n    examples\n  } else if has_example(examples: examples, module: module) {\n    examples\n  } else {\n    examples\n  }")
}

test fn join_p1_direct_snoc_alias_test() -> Bool {
  compile_dag_rust_emit_check(slot_join_p1_source(), "src/slotbind_jp1.rs", ["add_example"], ["compile_error"])
}

test fn join_p2_wrapper_snoc_alias_test() -> Bool {
  compile_dag_rust_emit_check(slot_join_p2_source(), "src/slotbind_jp2.rs", ["add_example"], ["compile_error"])
}

test fn join_p3_snoc_no_fold_equality_test() -> Bool {
  compile_dag_rust_emit_check(slot_join_p3_source(), "src/slotbind_jp3.rs", ["add_example"], ["compile_error"])
}

test fn join_p4_concrete_element_full_shape_test() -> Bool {
  compile_dag_rust_emit_check(slot_join_p4_source(), "src/slotbind_jp4.rs", ["add_example"], ["compile_error"])
}

test fn join_p5_two_branch_chain_test() -> Bool {
  compile_dag_rust_emit_check(slot_join_p5_source(), "src/slotbind_jp5.rs", ["add_example"], ["compile_error"])
}

test fn join_p6_module_floor_test() -> Bool {
  compile_dag_rust_emit_check(slot_join_p6_source(), "src/slotbind_jp6.rs", ["add_example"], ["compile_error"])
}
