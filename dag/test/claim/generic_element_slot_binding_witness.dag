module test.claim.generic_element_slot_binding_witness

// THE CLASS THIS FILE HOLDS OPEN. v1.compiler.infer unify_generic_child_pairs bound a callee's type variable to
// the actual application's ELEMENT SLOT rather than to the type the slot holds. The slot is named by the
// container declaration's own parameter (FreeMonoid's `T`) and carries the argument's type in its inferred, so
// every reader of the substitution that keys on the bound node's name or spelling saw an unbound `T`. Two
// shapes, one link (generic_actual_position_type, moved from v1.compiler.infer to v1.compiler.infer_env
// when the settle family below needed the same read -- v1.compiler.types imports infer_env, so the read
// could not live above either consumer):
//
//   bold-koi-381 (work item adhoc-b5f23a5d-052): `fn(h) { h.digest }` keyed through a generic over
//   `xs: List<Hash>`, `type Hash = Payload`, refused "no field 'digest' on type 'T'" -- the field-access alias
//   chain looks its next declaration up by the bound node's NAME. The sort_by wave hit it over v2.std.node's
//   `type Hash = Fnv1a64Structural` and worked around it with an annotated let.
//
//   smart-tern-402 (#15115): `skip(split(..), n: 1) |> first` left its Present arm undecided -- a kernel-built
//   List's slot is also SPELLED `T`.
//
// A record element escaped by accident (its slot's inferred is the record, found structurally before the
// name), which is why List<Payload> is a control and not a climb.
//
// MEASURED on main 88e8991e557 with the seed built from that tree, and again with this change: both climbs
// refuse on main and compile clean with it; every control compiles clean on both, and the undeclared-field
// arm refuses on both. The v2 control for the same shape is v2.test.claim.compiler.lambda_alias_field_key
// lafk_a_lambda_key_through_an_imported_alias_types_its_field (v2 types it; DESIGN section 7: a seed defect v2
// does not carry forward).
//
// HARNESS PAIRING, as in test.claim.transparent_alias_identity_witness: compile_dag_rust_emit_check returns
// false for more than one reason, so the refusal arm is paired with the same module minus the offending read.

fn slot_prelude() -> String {
  "type Payload {\n  digest: String\n}\n\ntype Hash = Payload\n\nfn sk<Q, K>(xs: List<Q>, key: fn(Q) -> K) -> List<Q> {\n  xs\n}\n\nfn take(p: Payload) -> String {\n  p.digest\n}\n\n"
}

fn slot_source(module_leaf: String, body: String) -> String {
  concat(concat(concat(concat("module slotbind.", module_leaf), "\n\nimport std.types { List, String }\n\n"), slot_prelude()), body)
}

fn slot_alias_key_source() -> String {
  slot_source(module_leaf: "aliaskey", body: "fn keyed(xs: List<Hash>) -> List<Hash> {\n  sk(xs: xs, key: fn(h) { h.digest })\n}\n")
}

fn slot_record_key_source() -> String {
  slot_source(module_leaf: "recordkey", body: "fn keyed(xs: List<Payload>) -> List<Payload> {\n  sk(xs: xs, key: fn(h) { h.digest })\n}\n")
}

fn slot_alias_at_formal_source() -> String {
  slot_source(module_leaf: "aliasformal", body: "fn keyed(xs: List<Hash>) -> List<Hash> {\n  sk(xs: xs, key: fn(h) { take(p: h) })\n}\n")
}

fn slot_alias_undeclared_source() -> String {
  slot_source(module_leaf: "aliasnope", body: "fn keyed(xs: List<Hash>) -> List<Hash> {\n  sk(xs: xs, key: fn(h) { h.nope })\n}\n")
}

fn slot_alias_undeclared_control_source() -> String {
  slot_source(module_leaf: "aliasnope", body: "fn keyed(xs: List<Hash>) -> List<Hash> {\n  sk(xs: xs, key: fn(h) { 1 })\n}\n")
}

// THE MAPPED-KEY SHAPE (lively-carp-891's fixture test.fixture.generic_lambda_param_typing.field_read_gap,
// the S2 sort_by -> list_sort_by_key rewrite of v2.std.node bag_hash_digest): the callee RETURNS the key's
// codomain, `List<K>` through std.algebra list_map, so the lambda's return binds K in the same argument fold
// that binds Q from xs. sk above returns xs and never reads K; this pair is what holds the slot read open when
// the lambda also contributes a binding (unify_lambda_solves). The fixture refused "no field 'text' on type
// 'T'" on a seed without generic_actual_position_type (1170b706a63a) and resolves on one with it (50881456fb46).
fn mapped_source(module_leaf: String, body: String) -> String {
  concat(concat(concat("module slotbind.", module_leaf), "\n\nimport std.algebra { list_map }\nimport std.types { List, String }\n\ntype Payload {\n  digest: String\n}\n\ntype Hash = Payload\n\nfn keys_of<Q, K>(xs: List<Q>, key: fn(Q) -> K) -> List<K> {\n  list_map(xs: xs, f: key)\n}\n\n"), body)
}

fn mapped_alias_key_source() -> String {
  mapped_source(module_leaf: "mappedalias", body: "fn digests(xs: List<Hash>) -> List<String> {\n  keys_of(xs: xs, key: fn(h) { h.digest })\n}\n")
}

fn mapped_record_key_source() -> String {
  mapped_source(module_leaf: "mappedrecord", body: "fn digests(xs: List<Payload>) -> List<String> {\n  keys_of(xs: xs, key: fn(h) { h.digest })\n}\n")
}

fn mapped_alias_undeclared_source() -> String {
  mapped_source(module_leaf: "mappednope", body: "fn digests(xs: List<Hash>) -> List<String> {\n  keys_of(xs: xs, key: fn(h) { h.nope })\n}\n")
}

fn mapped_alias_undeclared_control_source() -> String {
  mapped_source(module_leaf: "mappednope", body: "fn digests(xs: List<Hash>) -> List<String> {\n  keys_of(xs: xs, key: fn(h) { \"x\" })\n}\n")
}

// THE UNBOUND-PARAMETER READ: the slot's element is a type variable NOTHING grounds -- a parameter with no
// declaration behind it. Kept identity must not turn this into an acceptance: the field read on a parameter
// that declares no record can never be established, so this refuses with the guard for the same reason it
// refused without one. The arm is the guard's fail-closed side (the descent keeps the slot's identity for an
// unsolved variable; the reader must still refuse the undeclared name), paired with the module-minus-read
// control below so it measures the read and not the harness.
fn slot_unbound_param_field_source() -> String {
  "module slotbind.unboundparam\n\nimport std.types { List, String }\n\nfn sk<Q, K>(xs: List<Q>, key: fn(Q) -> K) -> List<Q> {\n  xs\n}\n\nfn field_on_unbound<T>(xs: List<T>) -> List<T> {\n  sk(xs: xs, key: fn(e) { e.digest })\n}\n"
}

fn slot_unbound_param_control_source() -> String {
  "module slotbind.unboundparam\n\nimport std.types { List, String }\n\nfn sk<Q, K>(xs: List<Q>, key: fn(Q) -> K) -> List<Q> {\n  xs\n}\n\nfn field_on_unbound<T>(xs: List<T>) -> List<T> {\n  sk(xs: xs, key: fn(e) { 1 })\n}\n"
}

fn slot_kernel_split_source() -> String {
  "module slotbind.kernelsplit\n\nimport std.algebra { skip }\nimport std.optional { Present, Absent }\nimport std.types { String, Bool }\n\nfn second_nonempty(s: String) -> Bool {\n  let parts = split(s: s, delimiter: \"/\")\n  match skip(parts, n: 1) |> first {\n    Present { value: v } => v != \"\"\n    Absent => false\n  }\n}\n"
}

fn slot_kernel_split_annotated_source() -> String {
  "module slotbind.kernelsplitann\n\nimport std.algebra { skip }\nimport std.optional { Present, Absent }\nimport std.types { List, String, Bool }\n\nfn second_nonempty(s: String) -> Bool {\n  let parts: List<String> = split(s: s, delimiter: \"/\")\n  match skip(parts, n: 1) |> first {\n    Present { value: v } => v != \"\"\n    Absent => false\n  }\n}\n"
}

// THE CLIMB (bold-koi-381's RED). Refused on main: "no field 'digest' on type 'T'".
test fn a_lambda_key_reads_a_field_through_an_alias_element_test() -> Bool {
  compile_dag_rust_emit_check(slot_alias_key_source(), "src/slotbind_aliaskey.rs", ["keyed"], ["compile_error"])
}

