module test.claim.optional_leaf_instance_join_witness

import gunbc.compile_census_probe { blocking_class_count_for, total_blocking_count_for }
import std.types { Bool, Int, String }
import std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// ONE TYPE, TWO REPRESENTATIONS: `T?` (the payload type carrying CardOptional) and the std.optional
// coproduct `Optional<P>` are the same type exactly when P is identical to T. The relation lives in
// v1.compiler.infer_types node_type_compatible, the one compatibility authority, so every consumer
// of it (the if-join, a let against a declared `T?`) answers alike -- gunbc.recurring_failure_mode
// optional_equality_answers_by_representation.
//
// The pair differs ONLY in the instance's payload, so the difference of blocking totals cancels the
// live-tree baseline. The accept control is the shape of std.source_annotation annotation_gap_in
// (`let c: T? = if n == 0 { Absent } else { <Optional<T>> }`); the refusal twin has the payload
// String against an Int?. Before the bare `Absent` took its expected `T?` as its type the then-branch
// was a kernel Optional whose unbound payload read as a type variable, so the twin was silently
// ACCEPTED: it is the standalone discriminator for that adoption, and it stays enrolled after the
// unbound payload became visible (type_read).

data optional_join_accept_source: String = "module probe_optjoin_same_payload\nimport std.optional { Optional }\nfn wrapped() -> Optional<Int> {\n  Absent\n}\nfn pick(b: Bool) -> Int? {\n  let r: Int? = if b { Absent } else { wrapped() }\n  r\n}\n"
data optional_join_refuse_source: String = "module probe_optjoin_other_payload\nimport std.optional { Optional }\nfn wrapped() -> Optional<String> {\n  Absent\n}\nfn pick(b: Bool) -> Int? {\n  let r: Int? = if b { Absent } else { wrapped() }\n  r\n}\n"

test fn an_optional_leaf_joins_the_optional_instance_at_the_same_payload_and_only_that() -> Bool {
  total_blocking_count_for(source: optional_join_refuse_source) - total_blocking_count_for(source: optional_join_accept_source) == 1
}

// THE OPTIONAL'S OWN NULLARY ARM ONLY. Under an Optional expectation `Absent` is the expected optional
// (expected_decided_variant_type), but a no-payload arm of a USER coproduct is not: `let c: Color? = Red`
// is the coercion the emitter owes a wrap for, and variant_reference_inferred_node refuses it. The
// pair differs only in the elected owner (std.optional versus a user coproduct), so the difference of
// blocking totals is the one refusal the owner gate preserves.
data optional_nullary_accept_source: String = "module probe_nullary_optional_arm\nfn pick() -> Int? {\n  let c: Int? = Absent\n  c\n}\n"
data optional_nullary_refuse_source: String = "module probe_nullary_user_arm\ntype Color = Red | Green\nfn pick() -> Color? {\n  let c: Color? = Red\n  c\n}\n"

test fn only_the_optionals_own_nullary_arm_adopts_an_optional_expectation() -> Bool {
  total_blocking_count_for(source: optional_nullary_refuse_source) - total_blocking_count_for(source: optional_nullary_accept_source) == 1
}
