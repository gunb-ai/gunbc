module test.claim.required_lane_resolution_census_witness

import std.types { String, Bool, List, Int }
import gunbc.required_lane_resolution_census {
  ModuleIdentityPopulation, ModuleIdentityPopulationObserved, ModuleIdentityPopulationRefused,
  LaneResolutionSubject, FloorNominalPreparedSubject, RunEntryClosure, ResolvesNoDagModule,
  LaneResolvedPopulation, ResolutionCensusInputs, ResolutionCensus,
  ResolutionCensusStanding, ResolutionCensusHeld, ResolutionCensusDidNotHold, ResolutionCensusRefused,
  RosterRowStanding, RosterRowResolvedByRequiredLane, RosterRowUnreachedByRequiredLane, RosterRowUnresolvable,
  resolution_census, resolution_census_standing, census_receipt_lines,
}
import extdeps.filesystem.filesystem_io { Filesystem }
import gunbc.required_lane_resolution_census_live {
  LivePopulations, LivePopulationsObserved, LivePopulationsRefused, live_populations,
}

// THE FOLD DISCRIMINATES AT ONE INTERFACE (DESIGN section 3): admitted and resolved populations
// are SUPPLIED here, so every claim is about the join and nothing else. The pairing obligation --
// that the real producers emit these shapes -- is discharged by the two claims at the bottom,
// which call the compiler queries on a two-module fixture root and on the live workflow's roster.

fn floor_lane(modules: List<String>) -> LaneResolvedPopulation {
  LaneResolvedPopulation { job_id: "floor", subject: FloorNominalPreparedSubject {}, modules: modules }
}

fn gate_lane(modules: List<String>) -> LaneResolvedPopulation {
  LaneResolvedPopulation { job_id: "floor", subject: RunEntryClosure { entry_path: "dag/x.dag" }, modules: modules }
}

fn cargo_lane() -> LaneResolvedPopulation {
  LaneResolvedPopulation { job_id: "compiler", subject: ResolvesNoDagModule { reason: "cargo build" }, modules: [] }
}

fn census_of(admitted: List<String>, resolved: List<LaneResolvedPopulation>) -> ResolutionCensus {
  resolution_census(inputs: ResolutionCensusInputs { admitted: admitted, resolved: resolved, roster: [] })
}

// Census over the same supplied populations PLUS an authored roster, so the roster arm is judged
// at the one interface too (DESIGN section 3): nothing here reads the real roster file.
fn census_of_roster(admitted: List<String>, resolved: List<LaneResolvedPopulation>, roster: List<String>) -> ResolutionCensus {
  resolution_census(inputs: ResolutionCensusInputs { admitted: admitted, resolved: resolved, roster: roster })
}

fn same_list(a: List<String>, b: List<String>) -> Bool {
  a == b
}

// How many receipt lines carry this kind+module pair. A line is
// {"kind":"K","module":"M"} in that field order by construction (census_receipt_lines).
fn lines_with(lines: List<String>, k: String, m: String) -> Int {
  let needle = concat(concat("{\"kind\":\"", k), concat("\",\"module\":", concat("\"", concat(m, "\""))))
  lines |> filter(fn(l) { contains(l, needle) }) |> count
}

// An identity resolved by any lane is reached; the rest are unreached, in admitted order.
test fn unreached_is_the_admitted_complement_of_the_lane_union() -> Bool {
  let c = census_of(admitted: ["a", "b", "c", "d"], resolved: [floor_lane(modules: ["a", "b"]), gate_lane(modules: ["b", "c"]), cargo_lane()])
  same_list(a: c.reached, b: ["a", "b", "c"]) && same_list(a: c.unreached, b: ["d"])
}

test fn every_admitted_module_resolved_by_some_lane_holds() -> Bool {
  let c = census_of(admitted: ["a", "b"], resolved: [floor_lane(modules: ["a"]), gate_lane(modules: ["b"])])
  match resolution_census_standing(c: c) {
    ResolutionCensusHeld => count(c.unreached) == 0
    ResolutionCensusDidNotHold { unreached: _ } => false
    ResolutionCensusRefused { cause: _ } => false
  }
}

// THE RED: lanes that resolve nothing leave every admitted module unreached, and the standing
// carries the population rather than a count.
test fn lanes_resolving_nothing_leave_every_admitted_module_unreached() -> Bool {
  let c = census_of(admitted: ["a", "b", "c"], resolved: [floor_lane(modules: []), cargo_lane()])
  match resolution_census_standing(c: c) {
    ResolutionCensusHeld => false
    ResolutionCensusDidNotHold { unreached: u } => same_list(a: u, b: ["a", "b", "c"])
    ResolutionCensusRefused { cause: _ } => false
  }
}

// The denominator is the ingestion's: a resolved identity the ingestion does not admit is
// neither reached nor unreached, and cannot inflate the reached count.
test fn a_resolved_identity_outside_the_admitted_population_is_not_counted() -> Bool {
  let c = census_of(admitted: ["a"], resolved: [floor_lane(modules: ["a", "ghost"])])
  same_list(a: c.reached, b: ["a"]) && count(c.unreached) == 0
}

// One summary line, one line per lane row, one line per ADMITTED identity, one line per
// unreached identity -- so the receipt carries both populations, not only their sizes.
test fn the_receipt_prints_one_line_per_unreached_identity() -> Bool {
  let c = census_of(admitted: ["a", "b", "c"], resolved: [floor_lane(modules: ["a"]), cargo_lane()])
  let lines = census_receipt_lines(c: c)
  count(lines) == 1 + 2 + 3 + 2
    && (lines |> filter(fn(l) { contains(l, "\"kind\":\"unreached\",\"module\":\"b\"") }) |> count) == 1
    && (lines |> filter(fn(l) { contains(l, "\"kind\":\"unreached\",\"module\":\"c\"") }) |> count) == 1
    && (lines |> filter(fn(l) { contains(l, "\"kind\":\"unreached\",\"module\":\"a\"") }) |> count) == 0
    && (lines |> filter(fn(l) { contains(l, "\"kind\":\"summary\"") && contains(l, "\"unreached\":2") }) |> count) == 1
}

// THE TWO ABSENCES COME APART. Three identities reach the receipt in three different kinds:
// "a" is admitted AND reached (an admitted line, no unreached line), "b" is admitted and
// UNREACHED (both lines), and "ghost" is not admitted at all (neither line -- it never entered
// the universe). Before the admitted lines existed, "a" and "ghost" were the same observation:
// absence from the unreached list. A green census and a typo were indistinguishable.
test fn the_receipt_separates_reached_unreached_and_never_admitted() -> Bool {
  let c = census_of(admitted: ["a", "b"], resolved: [floor_lane(modules: ["a", "ghost"])])
  let lines = census_receipt_lines(c: c)
  lines_with(lines: lines, k: "admitted", m: "a") == 1
    && lines_with(lines: lines, k: "admitted", m: "b") == 1
    && lines_with(lines: lines, k: "admitted", m: "ghost") == 0
    && lines_with(lines: lines, k: "unreached", m: "a") == 0
    && lines_with(lines: lines, k: "unreached", m: "b") == 1
    && lines_with(lines: lines, k: "unreached", m: "ghost") == 0
}

// The admitted lines are the denominator's population, in admitted order, and their count is
// what the summary's `"admitted":` field claims -- a reader can check the count against the
// lines rather than trust it.
test fn the_receipt_prints_one_admitted_line_per_admitted_identity() -> Bool {
  let c = census_of(admitted: ["x", "y", "z"], resolved: [floor_lane(modules: ["y"])])
  let lines = census_receipt_lines(c: c)
  let admitted = lines |> filter(fn(l) { contains(l, "\"kind\":\"admitted\"") })
  count(admitted) == 3
    && (admitted |> filter(fn(l) { contains(l, "\"module\":\"x\"") }) |> count) == 1
    && (admitted |> filter(fn(l) { contains(l, "\"module\":\"y\"") }) |> count) == 1
    && (admitted |> filter(fn(l) { contains(l, "\"module\":\"z\"") }) |> count) == 1
    && (lines |> filter(fn(l) { contains(l, "\"kind\":\"summary\"") && contains(l, "\"admitted\":3") }) |> count) == 1
}

// THE AUTHORED ROSTER IS ENUMERATED AT IDENTITY GRAIN. A supplied roster of admitted modules over
// lanes that resolve nothing puts EVERY row in the unreached arm -- named members of the declared
// drop gunbc.rung_drop v1_required_lanes_withdrawn, one receipt line per row by identity. A row a
// lane does resolve stands resolved-by-required-lane (resolution grain, not execution), and `resolved_by` names the (job|subject) route: no parallel
// judgment, the same reached/not-reached fact as every other admitted identity.
fn standing_kind(r: RosterRowStanding) -> String {
  match r {
    RosterRowResolvedByRequiredLane { module: _, resolved_by: _ } => "resolved-by-required-lane"
    RosterRowUnreachedByRequiredLane { module: _ } => "unreached"
    RosterRowUnresolvable { module: _ } => "unresolvable"
  }
}

fn row_module(r: RosterRowStanding) -> String {
  match r {
    RosterRowResolvedByRequiredLane { module: m, resolved_by: _ } => m
    RosterRowUnreachedByRequiredLane { module: m } => m
    RosterRowUnresolvable { module: m } => m
  }
}

fn row_resolved_by(r: RosterRowStanding) -> String {
  match r {
    RosterRowResolvedByRequiredLane { module: _, resolved_by: e } => e |> join(separator: ",")
    RosterRowUnreachedByRequiredLane { module: _ } => ""
    RosterRowUnresolvable { module: _ } => ""
  }
}

fn rows_of_kind(c: ResolutionCensus, kind: String) -> List<String> {
  c.roster_rows |> filter(r => standing_kind(r) == kind) |> map(r => row_module(r))
}

test fn a_supplied_roster_is_enumerated_row_by_row_against_the_lane_union() -> Bool {
  let c = census_of_roster(
    admitted: ["a", "b", "ghost"],
    resolved: [floor_lane(modules: ["a"]), cargo_lane()],
    roster: ["a", "b"])
  count(c.roster_rows) == 2
    && same_list(a: rows_of_kind(c: c, kind: "resolved-by-required-lane"), b: ["a"])
    && same_list(a: rows_of_kind(c: c, kind: "unreached"), b: ["b"])
    && same_list(a: rows_of_kind(c: c, kind: "unresolvable"), b: [])
    && (c.roster_rows |> filter(r => row_module(r) == "a") |> map(r => row_resolved_by(r)) |> join(separator: "|")) == "floor|floor-nominal-prepared-subject"
}

// The receipt prints one `roster` line per authored row, so each row is greppable from the
// instrument output by identity -- a named member of the declared drop, never prose.
test fn the_receipt_prints_one_roster_line_per_authored_row() -> Bool {
  let c = census_of_roster(admitted: ["a", "b", "ghost"], resolved: [cargo_lane()], roster: ["a", "b"])
  let lines = census_receipt_lines(c: c)
  (lines |> filter(l => contains(l, "\"kind\":\"roster\",\"module\":\"a\"") && contains(l, "\"standing\":\"unreached-drop-member\"")) |> count) == 1
    && (lines |> filter(l => contains(l, "\"kind\":\"roster\",\"module\":\"b\"") && contains(l, "\"standing\":\"unreached-drop-member\"")) |> count) == 1
}

// THE DISCRIMINATING CONTROL: a roster row naming a module the ingestion does not admit -- no .dag
// carries that `module` line -- REFUSES the census before the held/did-not-hold judgment, naming
// the row. Without this arm an authored roster could silently lose rows to typos and deletions,
// and the census's answer "every remaining row is a declared drop member" would bound a roster
// nobody authors.
test fn a_roster_row_naming_a_nonexistent_module_refuses_the_census() -> Bool {
  let c = census_of_roster(admitted: ["a"], resolved: [floor_lane(modules: ["a"])], roster: ["a", "no.such.module"])
  match resolution_census_standing(c: c) {
    ResolutionCensusHeld => false
    ResolutionCensusDidNotHold { unreached: _ } => false
    ResolutionCensusRefused { cause: cause } =>
      contains(cause, "no.such.module") && contains(cause, "must name a real module")
  }
}

// The refusal fires even when the rest of the census would HOLD: the unresolvable row outranks the
// unreached judgment, and it outranks an otherwise-green census -- the roster is not decoration.
test fn the_unresolvable_row_refuses_even_when_the_census_otherwise_holds() -> Bool {
  let c = census_of_roster(admitted: ["a"], resolved: [floor_lane(modules: ["a"])], roster: ["a", "gone.without.a.trace"])
  count(c.unreached) == 0
    && match resolution_census_standing(c: c) {
         ResolutionCensusHeld => false
         ResolutionCensusDidNotHold { unreached: _ } => false
         ResolutionCensusRefused { cause: _ } => true
       }
}

// PAIRING, the census to the REAL authored roster (this is the census's product, not a fixture):
// over the live populations -- the same admitted population and lane resolutions the instrument
// entry judges -- every row of `v2.workflow.required_floor` `required_gate_authored_modules`, read
// as DATA so rows added by #15023 arrive without touching this file, enumerates as its own line,
// NO row is unresolvable (each names a module the ingestion admits -- if one stops resolving,
// this claim turns RED, the instrument refuses, and the roster cannot silently shrink), and NO row
// is reached by any required lane's closure today. The resolved-by-required-lane arm is empty by construction of the declared loss:
// the manual required-floor runner is deleted and no required lane resolves a roster module. The
// day a row moves to `resolved-by-required-lane` this claim goes RED and the drop's population shrinks with it --
// that is what makes the census a measurement rather than a certificate.
test fn w_the_authored_required_floor_roster_resolves_and_no_required_lane_reaches_it() -> Bool {
  match live_populations() {
    LivePopulationsRefused { cause: _ } => false
    LivePopulationsObserved { admitted: admitted, resolved: resolved, roster: roster } => {
      let c = resolution_census(inputs: ResolutionCensusInputs { admitted: admitted, resolved: resolved, roster: roster })
      count(roster) > 0
        && count(c.roster_rows) == count(roster)
        && same_list(a: rows_of_kind(c: c, kind: "unresolvable"), b: [])
        && same_list(a: rows_of_kind(c: c, kind: "resolved-by-required-lane"), b: [])
        && count(rows_of_kind(c: c, kind: "unreached")) == count(roster)
    }
  }
}

// PAIRING: the entry-closure query on the real producer, over a two-module fixture root whose
// importer reaches its decoy through an import edge. The closure is exactly those two identities.
test fn w_entry_closure_query_reaches_the_fixture_importer_and_its_import() -> Bool {
  match entry_closure_module_identities(["dag/test/fixture/primitive_egress_decoy"], "dag/test/fixture/primitive_egress_decoy/importer.dag") {
    ModuleIdentityPopulationRefused { cause: _ } => false
    ModuleIdentityPopulationObserved { modules: ms } =>
      same_list(a: ms, b: ["test.fixture.primitive_egress_decoy.decoy", "test.fixture.primitive_egress_decoy.importer"])
  }
}

// PAIRING, the refusing arm: an entry that does not exist is a typed refusal, never an empty
// population read as "resolves nothing".
test fn w_entry_closure_query_refuses_an_absent_entry() -> Bool {
  match entry_closure_module_identities(["dag/test/fixture/primitive_egress_decoy"], "dag/test/fixture/primitive_egress_decoy/absent.dag") {
    ModuleIdentityPopulationRefused { cause: _ } => true
    ModuleIdentityPopulationObserved { modules: _ } => false
  }
}

// PAIRING: the admitted-population query over the same fixture root admits exactly its two
// module identities.
test fn w_source_root_ingest_query_admits_the_fixture_modules() -> Bool {
  match source_root_ingest_module_identities(["dag/test/fixture/primitive_egress_decoy"]) {
    ModuleIdentityPopulationRefused { cause: _ } => false
    ModuleIdentityPopulationObserved { modules: ms } =>
      same_list(a: ms, b: ["test.fixture.primitive_egress_decoy.decoy", "test.fixture.primitive_egress_decoy.importer"])
  }
}

// THE CITED PRODUCER IS NOT A DEAD REFERENCE. The census headers (this module's Rust twin and
// the live entry) name `claim_executor --required-ci` as the command that prints
// `admitted-module-identities`. Since 1f6b4107a046 (#13932, 2026-10-14) deleted the flag while
// 48 files kept citing it, that command exited 2 on an unknown argument, and every reader who
// trusted the header held a lie -- caught only because a head-built census run reached for it.
// This claim pins the pairing at the source: the exact flag the headers cite must be an arm of
// the bin's argument parser, and the bin must print the token the headers promise. A comment
// can rot; this claim makes the rot fail closed.
test fn the_headers_cited_producer_is_parsed_by_the_bin_it_names() -> Bool {
  let bin = filesystem_read(path: "src/v1/stage0/src/bin/claim_executor.rs").content
  bin.contains("claim_executor --required-ci")
    && bin.contains("\"--required-ci\"")
    && bin.contains("admitted-module-identities:")
}

// THE PRODUCER PARSES THE QUERY FORM TOO. The header of `gunbc.required_lane_resolution_census`
// tells a reader to settle a single identity with `claim_executor --required-ci --query-module
// <identity>`; a citation to a flag the binary does not parse is the dead-reference defect this
// PR exists to close (review 84624), so the flag the doc names must exist as a parser arm.
test fn the_query_flag_the_header_names_is_parsed_by_the_bin_it_names() -> Bool {
  let bin = filesystem_read(path: "src/v1/stage0/src/bin/claim_executor.rs").content
  bin.contains("\"--query-module\"") && bin.contains("module-admission:")
}

// THE TYPED STATE EXISTS, WITH ITS EVIDENCE FIELDS. "never admitted" is an arm of
// `ModuleAdmission` carrying the run's SHA and an OPTIONAL deleting commit -- not silence, and
// not an absence a reader derives from two missing lines (DESIGN section 5). `index-refused` is
// the third arm: an identity whose state was never observed is not reported as an absent one.
test fn never_admitted_is_a_typed_arm_carrying_its_evidence() -> Bool {
  let census_rs = filesystem_read(path: "src/v1/stage0/src/cli_run/required_lane_resolution_census.rs").content
  census_rs.contains("pub enum ModuleAdmission")
    && census_rs.contains("NeverAdmitted")
    && census_rs.contains("run_sha")
    && census_rs.contains("deleting_commit")
    && census_rs.contains("IndexRefused")
}

// THE DELETING COMMIT IS DERIVED, NEVER HAND-WRITTEN (the manager's condition). A hard-coded
// 40-hex SHA inside the query would be a hand-written attribution -- the defect class DESIGN
// section 4b calls out (a written-down value posing as an observation). The attribution comes
// from a git pickaxe over the module header plus a parent-contains check, and the instrument
// carries no literal SHA.
test fn the_deleting_commit_is_a_derivation_not_a_written_value() -> Bool {
  let census_rs = filesystem_read(path: "src/v1/stage0/src/cli_run/required_lane_resolution_census.rs").content
  census_rs.contains("\"-S\"")
    && census_rs.contains("\"log\"")
    && census_rs.contains("\"grep\"")
    && census_rs.contains("and_then")
}

// THE RECEIPT AND THE QUERY ARE PAIRED. The census header cannot keep pointing at the typed arm
// if the arm disappears, and the arm cannot drift from what the census calls "admitted": both
// names live in sources that must mention each other.
test fn the_census_header_points_at_the_typed_query_arm() -> Bool {
  let census_dag = filesystem_read(path: "dag/gunbc/required_lane_resolution_census.dag").content
  census_dag.contains("--query-module") && census_dag.contains("never-admitted")
}

// And the pairing the other way, on the printer: the live entry must still import the receipt
// printer it is claimed to run, so a rename that moves the printer away from the entry (leaving
// the header pointing at a function nothing calls) fails here rather than in a head-built run
// nobody schedules.
test fn the_live_entry_still_imports_the_receipt_printer() -> Bool {
  let census_rs = filesystem_read(path: "src/v1/stage0/src/cli_run/required_lane_resolution_census.rs").content
  let live = filesystem_read(path: "dag/gunbc/required_lane_resolution_census_live.dag").content
  census_rs.contains("claim_executor --required-ci")
    && census_rs.contains("admitted-module-identities")
    && live.contains("census_receipt_lines")
}
