module test.claim.fleet_host_budget


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn fixture_cfg() -> extdeps.jobserver.JobserverConfig {
  extdeps.jobserver.JobserverConfig {
    margin: hardware_thread_count(count: 8),
    mem_reserve: byte_size(8589934592),
    mib_per_job: byte_size(1879048192),
  }
}

fn fixture_citation() -> extdeps.jobserver.JobserverCitation {
  extdeps.jobserver.JobserverCited { config: fixture_cfg(), provenance: "fixture: parent-supplied installer knobs" }
}

fn runner_idle_bytes() -> std.measure.ByteSize {
  byte_size(314572800)
}

fn fixture_runner_measured() -> gunbc.fleet_container.FleetContainerType {
  gunbc.fleet_container.GhaRunnerContainer { baseline: gunbc.fleet_container.ContainerBaselineMeasured { idle: idle_memory_envelope(min_bytes: runner_idle_bytes()) } }
}

fn fixture_runner_unmeasured() -> gunbc.fleet_container.FleetContainerType {
  gunbc.fleet_container.GhaRunnerContainer { baseline: ContainerBaselineUnmeasured }
}

fn host_125gib() -> std.measure.ByteSize {
  byte_size(134217728000)
}

fn overhead_16gib() -> std.measure.ByteSize {
  byte_size(17179869184)
}

fn session_slice_fixture() -> std.measure.ByteSize {
  byte_size(40000000000)
}

fn fitting_headroom() -> gunbc.fleet_host_budget.HeadroomPolicy {
  gunbc.fleet_host_budget.HeadroomSet { bytes: byte_size(16106127360) }
}

fn fitting_headroom_bytes() -> std.measure.ByteSize {
  byte_size(16106127360)
}

fn is_unsound(plan: gunbc.fleet_host_budget.FleetHostPlan) -> Bool {
  match plan {
    FleetHostPlanUnsound { reason: _ } => true
    FleetHostPlanDerived { name: _, tree: _, runner_slice_cap: _, effective_build_tokens: _, effective_runner_cpu_cap: _, build_step: _ } => false
  }
}

fn full_plan(
  citation: extdeps.jobserver.JobserverCitation,
  runner: gunbc.fleet_container.FleetContainerType,
  session_slice: std.measure.ByteSize,
  policy: gunbc.fleet_host_budget.HeadroomPolicy,
  oomd: gunbc.ci_floor_measurement.OomdEnforcementEvidence
) -> gunbc.fleet_host_budget.FleetHostPlan {
  fleet_host_plan_for(
    name: "fixture",
    host: host_125gib(),
    overhead: overhead_16gib(),
    nproc: hardware_thread_count(count: 128),
    runner: runner,
    session_slice: session_slice,
    citation: citation,
    policy: policy,
    oomd: oomd
  )
}

fn sound_plan() -> gunbc.fleet_host_budget.FleetHostPlan {
  full_plan(citation: fixture_citation(), runner: fixture_runner_measured(), session_slice: session_slice_fixture(), policy: fitting_headroom(), oomd: OomdEnforced)
}

test fn witness_live_plan_fail_closed() -> Bool {
  is_unsound(plan: fleet_host_plan())
}

test fn witness_jobserver_absent_unsound() -> Bool {
  is_unsound(plan: full_plan(citation: JobserverAbsent, runner: fixture_runner_measured(), session_slice: session_slice_fixture(), policy: fitting_headroom(), oomd: OomdEnforced))
}

test fn witness_runner_baseline_unmeasured_unsound() -> Bool {
  is_unsound(plan: full_plan(citation: fixture_citation(), runner: fixture_runner_unmeasured(), session_slice: session_slice_fixture(), policy: fitting_headroom(), oomd: OomdEnforced))
}

test fn witness_headroom_unset_unsound() -> Bool {
  is_unsound(plan: full_plan(citation: fixture_citation(), runner: fixture_runner_measured(), session_slice: session_slice_fixture(), policy: HeadroomUnset, oomd: OomdEnforced))
}

test fn witness_oomd_unverified_unsound() -> Bool {
  is_unsound(plan: full_plan(citation: fixture_citation(), runner: fixture_runner_measured(), session_slice: session_slice_fixture(), policy: fitting_headroom(), oomd: OomdUnverified))
}

test fn witness_headroom_below_floor_unsound() -> Bool {
  let floor = oomd_actuation_floor(host: host_125gib())
  match resolve_headroom(policy: gunbc.fleet_host_budget.HeadroomSet { bytes: byte_size(1073741824) }, floor: floor) {
    HeadroomUnsound { reason: _ } => true
    HeadroomResolved { bytes: _ } => false
  }
}

test fn witness_headroom_at_or_above_floor_resolved() -> Bool {
  let floor = oomd_actuation_floor(host: host_125gib())
  match resolve_headroom(policy: gunbc.fleet_host_budget.HeadroomSet { bytes: floor }, floor: floor) {
    HeadroomResolved { bytes: b } => byte_size_count(b: b) == byte_size_count(b: floor)
    HeadroomUnsound { reason: _ } => false
  }
}

test fn witness_tokens_memory_bound_binds() -> Bool {
  let cfg = fixture_cfg()
  let tokens = hardware_thread_count_value(t: derive_jobserver_tokens(nproc: hardware_thread_count(count: 128), mem_total: host_125gib(), cfg: cfg))
  tokens > 0 && tokens < 120
}

fn oversized_margin_cfg() -> extdeps.jobserver.JobserverConfig {
  extdeps.jobserver.JobserverConfig {
    margin: hardware_thread_count(count: 64),
    mem_reserve: byte_size(8589934592),
    mib_per_job: byte_size(1879048192),
  }
}

test fn witness_margin_exceeds_nproc_saturates() -> Bool {
  let tokens = hardware_thread_count_value(t: derive_jobserver_tokens(nproc: hardware_thread_count(count: 8), mem_total: host_125gib(), cfg: oversized_margin_cfg()))
  tokens == 0
}

test fn witness_runner_cpu_cap_is_cores_minus_margin() -> Bool {
  match sound_plan() {
    FleetHostPlanDerived { name: _, tree: _, runner_slice_cap: _, effective_build_tokens: _, effective_runner_cpu_cap: cpu, build_step: _ } =>
      hardware_thread_count_value(t: cpu) == 120
    FleetHostPlanUnsound { reason: _ } => false
  }
}

test fn witness_plan_derives_and_conserves() -> Bool {
  match sound_plan() {
    FleetHostPlanDerived { name: _, tree: t, runner_slice_cap: slice, effective_build_tokens: tk, effective_runner_cpu_cap: cpu, build_step: _ } =>
      node_conserves(node: t)
        && hardware_thread_count_value(t: tk) > 0
        && hardware_thread_count_value(t: cpu) > 0
        && byte_size_count(b: slice) > 0
    FleetHostPlanUnsound { reason: _ } => false
  }
}

test fn witness_runner_slice_is_session_worstcase_only() -> Bool {
  let slice = runner_slice_cap(host: host_125gib(), overhead: overhead_16gib(), session_slice: session_slice_fixture(), headroom: fitting_headroom_bytes(), compile_pool: byte_size(0))
  let expected = byte_size_count(b: host_125gib()) - byte_size_count(b: overhead_16gib()) - byte_size_count(b: session_slice_fixture()) - byte_size_count(b: fitting_headroom_bytes())
  byte_size_count(b: slice) == expected
}

test fn witness_runner_slice_excludes_build_pool() -> Bool {
  let cfg = fixture_cfg()
  let slice = runner_slice_cap(host: host_125gib(), overhead: overhead_16gib(), session_slice: session_slice_fixture(), headroom: fitting_headroom_bytes(), compile_pool: byte_size(0))
  let build_pool_bytes = byte_size_count(b: cfg.mib_per_job) * hardware_thread_count_value(t: derive_jobserver_tokens(nproc: hardware_thread_count(count: 128), mem_total: host_125gib(), cfg: cfg))
  let after_session = byte_size_count(b: host_125gib()) - byte_size_count(b: overhead_16gib()) - byte_size_count(b: session_slice_fixture())
  let double_subtract_would_starve = after_session < (build_pool_bytes + byte_size_count(b: fitting_headroom_bytes()))
  byte_size_count(b: slice) > 0 && double_subtract_would_starve
}

test fn witness_host_conserves_exactly() -> Bool {
  let slice = runner_slice_cap(host: host_125gib(), overhead: overhead_16gib(), session_slice: session_slice_fixture(), headroom: fitting_headroom_bytes(), compile_pool: byte_size(0))
  let whole = byte_size_count(b: overhead_16gib()) + byte_size_count(b: session_slice_fixture()) + byte_size_count(b: fitting_headroom_bytes()) + byte_size_count(b: slice)
  whole == byte_size_count(b: host_125gib())
}

test fn witness_tree_conserves() -> Bool {
  let slice = runner_slice_cap(host: host_125gib(), overhead: overhead_16gib(), session_slice: session_slice_fixture(), headroom: fitting_headroom_bytes(), compile_pool: byte_size(0))
  let tree = fleet_host_budget_tree(name: "fixture", host: host_125gib(), overhead: overhead_16gib(), runner_baseline: runner_idle_bytes(), session_slice: session_slice_fixture(), headroom: fitting_headroom_bytes(), runner_slice: slice, compile_pool: byte_size(0))
  node_conserves(node: tree)
}

test fn witness_overcommit_tree_refused() -> Bool {
  let bloated_slice = byte_size(byte_size_count(b: host_125gib()))
  let tree = fleet_host_budget_tree(name: "overcommit", host: host_125gib(), overhead: overhead_16gib(), runner_baseline: runner_idle_bytes(), session_slice: session_slice_fixture(), headroom: fitting_headroom_bytes(), runner_slice: bloated_slice, compile_pool: byte_size(0))
  !node_conserves(node: tree)
}

test fn witness_runner_slice_cap_drift_red_receipt() -> Bool {
  let disk = byte_size(70391285350)
  runner_slice_cap_drifted(disk_cap: disk, effective: CapUnbounded)
    && !runner_slice_cap_drifted(disk_cap: disk, effective: gunbc.ci_floor_measurement.CapEffective { bytes: disk })
    && runner_slice_cap_drifted(disk_cap: disk, effective: gunbc.ci_floor_measurement.CapEffective { bytes: byte_size(55307438489) })
}

