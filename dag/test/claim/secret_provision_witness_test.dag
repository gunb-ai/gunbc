module test.claim.secret_provision_witness

import gunbc.secret_provision {
  SecretProvisionIntent,
  SecretProvisionOutcome,
  SecretProvisionProgress,
  SecretMaterializationPlan,
  SecretMaterializationAction,
  SecretExistenceObservation,
  ProgressMaterialized,
  ProgressAwaitingHuman,
  ProgressRefused,
  CreateSecretThenAddVersion,
  AddVersionToExistingSecret,
  SecretCreatedAndVersioned,
  VersionMaterialized,
  DurabilityReadBackMismatch,
  classify_secret_provision_progress,
  classify_access_token_deficit_resolution,
  classify_secret_materialization_upsert,
  secret_provision_receipt,
  secret_provision_intent,
  secret_provision_human_burden,
  gcp_fleet_secrets_access_token_intervention,
  gcp_fleet_secrets_access_token_intervention_identity,
  fleet_secret_ref,
  generated_payload_password_char_count,
  SecretResourceAbsent,
  SecretResourcePresent,
}
import gunbc.auth.access_token_source {
  AccessTokenDeficitEnsureRefused,
  AccessTokenDeficitUpsertRequired,
  GoogleCloudInteractiveAuthenticationRequired,
}
import extdeps.cloud.gcp.secret_ref { secret_ref_secret_resource, secret_ref_hash_known }
import gunbc.fleet_secrets_config { fleet_secrets_gcp_project }
import std.human_intervention { FleetOnce, DeviceOnce, EveryProvision, human_intervention_count_at }
import std.measure { character_count, character_count_value }
import std.upsert_decision { UpsertClassification, Apply, Absent, Drifted }

data sample_intent: SecretProvisionIntent = secret_provision_intent(
  secret_id: "witness-test-secret",
  payload_password_length: character_count(count: 16),
)

fn outcome_tag(o: SecretProvisionOutcome) -> String {
  match o {
    SecretProvisioned { receipt: _ } => "provisioned"
    SecretProvisionHumanInterventionRequired { intervention: _ } => "human"
    SecretProvisionRefused { cause: _ } => "refused"
  }
}

fn progress_tag(progress: SecretProvisionProgress) -> String {
  outcome_tag(o: classify_secret_provision_progress(progress: progress))
}

// The three outcome arms stay distinct: materialized, human-required, and refused must
// not collapse — the same failure-mode list spark_provisioning guards against.
test fn secret_provision_outcome_arms_stay_distinct() -> Bool {
  let receipt = secret_provision_receipt(
    intent: sample_intent,
    plan: CreateSecretThenAddVersion,
    version_resource: "projects/gunbai-secrets/secrets/witness-test-secret/versions/1",
  )
  let materialized = progress_tag(
    progress: ProgressMaterialized { receipt: receipt },
  )
  let human = progress_tag(
    progress: ProgressAwaitingHuman {
      intervention: gcp_fleet_secrets_access_token_intervention(),
    },
  )
  let refused = progress_tag(
    progress: ProgressRefused {
      cause: DurabilityReadBackMismatch {
        version_resource: "projects/gunbai-secrets/secrets/witness-test-secret/versions/1",
      },
    },
  )

  materialized == "provisioned"
    && human == "human"
    && refused == "refused"
    && materialized != human
    && human != refused
    && materialized != refused
}

// Access-token deficit maps to FleetOnce human intervention, not a refusal — the operator
// authenticates once for the fleet, not once per secret.
test fn access_token_upsert_maps_to_fleet_once_human_intervention() -> Bool {
  match classify_access_token_deficit_resolution(
    resolution: AccessTokenDeficitUpsertRequired {
      plan: GoogleCloudInteractiveAuthenticationRequired {},
    },
  ) {
    ProgressAwaitingHuman { intervention: i } =>
      i.identity == gcp_fleet_secrets_access_token_intervention_identity
        && i.frequency == FleetOnce
    ProgressMaterialized { receipt: _ } => false
    ProgressRefused { cause: _ } => false
  }
}

// Infrastructure failure stays a refusal, never masquerades as a human step.
test fn access_token_refuse_stays_refused_not_human() -> Bool {
  progress_tag(
    progress: classify_access_token_deficit_resolution(
      resolution: AccessTokenDeficitEnsureRefused {
        reason: "gcloud: command not found",
      },
    ),
  ) == "refused"
}

// Human burden is frequency-classified: exactly one FleetOnce step, zero per-provision.
test fn secret_provision_human_burden_is_frequency_classified() -> Bool {
  let burden = secret_provision_human_burden()
  human_intervention_count_at(burden: burden, frequency: FleetOnce) == 1
    && human_intervention_count_at(burden: burden, frequency: DeviceOnce) == 0
    && human_intervention_count_at(burden: burden, frequency: EveryProvision) == 0
}

// Idempotent upsert: absent secret creates, present secret adds version only.
test fn secret_materialization_upsert_is_idempotent() -> Bool {
  let absent = classify_secret_materialization_upsert(
    obs: SecretResourceAbsent,
  )
  let present = classify_secret_materialization_upsert(
    obs: SecretResourcePresent {
      resource_name: "projects/gunbai-secrets/secrets/witness-test-secret",
    },
  )

  match absent {
    UpsertClassification { verdict: Absent, decision: Apply { plan: CreateSecretThenAddVersion } } => true
    UpsertClassification { verdict: _, decision: _ } => false
  }
    && match present {
      UpsertClassification {
        verdict: Drifted,
        decision: Apply { plan: AddVersionToExistingSecret },
      } => true
      UpsertClassification { verdict: _, decision: _ } => false
    }
}

// Opaque identity: the intent carries a SecretRef with HashPending, never a payload value.
test fn secret_provision_intent_identity_is_opaque() -> Bool {
  !secret_ref_hash_known(ref: sample_intent.identity)
    && sample_intent.identity.project == fleet_secrets_gcp_project
    && sample_intent.identity.secret == "witness-test-secret"
    && generated_payload_password_char_count(spec: sample_intent.payload) == 16
    && character_count_value(c: sample_intent.payload.password_length) == 16
}

// Receipt distinguishes first creation from subsequent version materialization.
test fn secret_provision_receipt_action_variants_differ() -> Bool {
  let created = secret_provision_receipt(
    intent: sample_intent,
    plan: CreateSecretThenAddVersion,
    version_resource: "projects/gunbai-secrets/secrets/witness-test-secret/versions/1",
  )
  let versioned = secret_provision_receipt(
    intent: sample_intent,
    plan: AddVersionToExistingSecret,
    version_resource: "projects/gunbai-secrets/secrets/witness-test-secret/versions/2",
  )

  match created.action {
    SecretCreatedAndVersioned { version_resource: v } => v == "projects/gunbai-secrets/secrets/witness-test-secret/versions/1"
    VersionMaterialized { version_resource: _ } => false
  }
    && match versioned.action {
      VersionMaterialized { version_resource: v } => v == "projects/gunbai-secrets/secrets/witness-test-secret/versions/2"
      SecretCreatedAndVersioned { version_resource: _ } => false
    }
}

// Resource name projects through the extdeps SecretRef authority — no local fork.
test fn secret_ref_secret_resource_matches_fleet_ref() -> Bool {
  secret_ref_secret_resource(ref: fleet_secret_ref(secret_id: "bmc-srv3")) ==
    "projects/gunbai-secrets/secrets/bmc-srv3"
}
