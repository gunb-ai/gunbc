  sm_resolved_version_id,
}
import gunbc.secret_provision {
  SecretProvisionReceiptMint,
  ReceiptMinted,
  ReceiptRefusedMalformedIdentity,
  ReceiptRefusedResolvedSecretDisagreesWithIntent,
  SecretProvisionIntent,
  SecretProvisionOutcome,
  SecretProvisionProgress,
  SecretMaterializationPlan,
  SecretMaterializationAction,
  SecretMaterializationContext,
  SecretVersionMaterializationReceipt,
  SecretVersionPayloadObservation,
  ProgressMaterialized,
  ProgressAwaitingHuman,
  ProgressRefused,
  CreateSecretAndInitialVersion,
  AddVersionToExistingSecret,
  SecretCreatedAndVersioned,
  VersionMaterialized,
  DurabilityReadBackMismatch,
  classify_secret_provision_progress,
  classify_secret_materialization,
  secret_provision_receipt,
  secret_provision_intent,
  secret_provision_human_burden,
  gcp_fleet_secrets_wif_binding_intervention,
  gcp_fleet_secrets_wif_binding_intervention_identity,
  fleet_secret_ref,
  generated_payload_password_char_count,
  payload_identity_from_credential,
  SecretContainerAbsent,
  SecretContainerPresentAwaitingAttemptVersion,
  SecretContainerPresent,
  SparkAdministratorCredential,
  SparkFactoryCredential,
  OperatorCapturedInBoxCredential,
  WorkflowGeneratedCredential,
  SecretProvisionAttemptIdentity,
  PayloadIdentity,
  GeneratedPayloadIdentity,
  ObservedPayloadIdentity,
  VersionPayloadMatches,
  compare_payload_identities,
  PayloadIdentityMatch,
