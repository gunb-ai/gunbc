module test.claim.machine_word_octet_typecheck

import std.types { String, Bool, Int }
import v2.std.optional { Present, Absent }
import gunbc.compile_diagnostic_census { CompileDiagnosticCensus, CensusObserved, CensusNotRunnable, census_count_at_key }

// THE OCTET CARRIER IS ONLY A WALL IF THE BAD CALL FAILS TO COMPILE, AND THAT CANNOT BE SHOWN FROM
// THE ACCEPTED CORPUS -- if it were writable there, the tree would not build. DESIGN section 4b is
// explicit that this is not a ceiling: the state is representable as SOURCE HANDED TO THE COMPILER
// BY A FIXTURE, so declining to enrol it would be specification-without-execution.
//
// THIS IS THE SECOND ATTEMPT AND THE SOURCES ARE DELIBERATELY SIMPLER. The first carried record
// literals, which needed brace escaping inside a .dag string, and every claim came back on the
// 0 - 1 not-runnable sentinel -- the harness was not running and the sentinel said so in both
// directions rather than letting the green pass. These sources contain NO record literal and NO
// brace that is not a plain block: the illegal call is made by passing a parameter of the wrong
// declared type, which needs no value to be constructed at all. If this still reports not-runnable,
// the cause is the census in this module rather than anything in the source text.
fn census_of(source: String) -> CompileDiagnosticCensus {
  compile_dag_diagnostic_census(source)
}

// THE COUNT IS SCOPED TO THE PROBE'S OWN SUBJECT, AND THE FIRST CUT OF THIS MODULE WAS NOT.
//
// gunbc.compile_diagnostic_census states it outright: the row set is the WHOLE COMPILE'S, imported
// closure included, so "census_total_count == 0" asserts a property of the CORPUS and is
// permanently false for any fixture that imports a production module -- "a check whose RED is
// unauthorable, which DESIGN 4b names a decoration rather than a weak wall". That is exactly what I
// built and then described as acceptance-asserting, and a review repeated the description back to
// me as a strength. The srv1 receipt at 63bb03a4cf is where it showed: all three claims failed
// together, not because the census refused to run but because an unrelated resolve error elsewhere
// in the corpus put blocking rows in every census this module took.
//
// That module names the two exact forms. This is the first: a count scoped to a diagnostic class
// AND a subject_name. Each probe declares its own module name, so the subject isolates the probe's
// rows from the closure's, and a corpus defect somewhere else no longer decides this verdict.
fn probe_blocking_at(source: String, subject: String, wanted: String) -> Int {
  match census_of(source: source) {
    CensusObserved { rows: rows } =>
      census_count_at_key(rows: rows, diagnostic_class: wanted, subject_name: subject, blocking: true)
    CensusNotRunnable { cause: _ } => 0 - 1
  }
}

// A List<Word> where List<UInt8> is declared. This is the counterexample that motivated naming the
// octet at all: a Word carries a width that may not be eight, and the QualifiedWord carrier this
// replaced let a SANCTIONED Width16 value reach the octet path. It is the surviving RED because
// Word is a record and no composition makes it transparent to UInt8.
data word_list_for_octet_list_red_source: String = "module probe_octet_carrier_word_list\nimport std.machine_word { Word, Width32, WordResult, word_from_octets }\nimport extdeps.toolchain.architecture_profile { BigEndian }\nimport std.types { List }\nfn f(w: List<Word>) -> WordResult { word_from_octets(width: Width32, octets: w, endianness: BigEndian) }\n"

// THE Int-LIST RED IS DELETED, AND WHY IT IS DELETED IS THE FINDING.
//
// It asserted that passing List<Int> where the octet list is declared would refuse. Against the old
// Octet record that was true. Against UInt8 it is FALSE: UInt8 is Compose<UInt, MachineWidth<8>>,
// a phantom transparent to Int at a formal, so that call compiles and SHOULD. Keeping the claim
// would have asserted a wall that does not exist -- the mirror of the decoration DESIGN 4b names,
// a RED that can never fire because the state it forbids is legitimate.
//
// The receipt for the transparency is in the corpus rather than in this reasoning: this lane's own
// witness passed [256, 0, 0] to a List<UInt8> parameter and COMPILED, in the floor run at
// 9ca9d9ab. The out-of-range wall therefore belongs at std.integer uint8_of_int and is claimed
// there, not here.

// THE GREEN CONTROL, load-bearing rather than decorative: two reds alone are satisfied by a compiler
// that has stopped judging argument types, or by a harness reporting a blocking row for everything.
// This takes the SAME route with the RIGHT carrier and must produce nothing.
data octet_list_green_source: String = "module probe_octet_carrier_green\nimport std.machine_word { Width32, WordResult, word_from_octets }\nimport std.integer { UInt8 }\nimport extdeps.toolchain.architecture_profile { BigEndian }\nimport std.types { List }\nfn f(o: List<UInt8>) -> WordResult { word_from_octets(width: Width32, octets: o, endianness: BigEndian) }\n"

test fn a_word_list_does_not_satisfy_the_octet_carrier_holds() -> Bool {
  probe_blocking_at(source: word_list_for_octet_list_red_source, subject: "probe_octet_carrier_word_list", wanted: "TypeMismatch") > 0
}

// THE GREEN CONTROL IS SUBJECT-SCOPED TOO, so it says "this probe produced no TypeMismatch" rather
// than "the corpus is clean". It stays load-bearing: two REDs alone are satisfied by a compiler that
// has stopped judging argument types, and this one takes the same route with the right carrier and
// must produce nothing at its own subject.
test fn the_octet_carrier_route_compiles_holds() -> Bool {
  probe_blocking_at(source: octet_list_green_source, subject: "probe_octet_carrier_green", wanted: "TypeMismatch") == 0
}
