module test.claim.ci_floor_measurement

import std.logic { Bool }
import std.measure { byte_size_count }
import gunbc.ci_floor_measurement {
  gunbc_ci_runner_slot_memory_max_live,
  gunbc_ci_runner_slot_memory_high_live,
  gunbc_ci_runner_slot_ram_speed_ceiling,
  witness_runner_cgroup_cap_lt_dashboard_session_cap,
}

fn witness_runner_cap_lt_session_cap() -> Bool {
  witness_runner_cgroup_cap_lt_dashboard_session_cap()
}

fn witness_ram_speed_ceiling_is_min_of_high_and_max() -> Bool {
  byte_size_count(b: gunbc_ci_runner_slot_ram_speed_ceiling()) <= byte_size_count(b: gunbc_ci_runner_slot_memory_max_live)
    && byte_size_count(b: gunbc_ci_runner_slot_ram_speed_ceiling()) <= byte_size_count(b: gunbc_ci_runner_slot_memory_high_live)
}

test fn ci_floor_measurement_witnesses() -> Bool {
  witness_runner_cap_lt_session_cap()
    && witness_ram_speed_ceiling_is_min_of_high_and_max()
}
