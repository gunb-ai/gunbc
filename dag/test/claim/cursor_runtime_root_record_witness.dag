module test.claim.cursor_runtime_root_record_witness

import std.types { Bool, String, EpochSecs }
import std.algebra { string_contains }
import std.optional { Present, Absent }
import gunbc.compute.attempt_lifecycle { AttemptState, AttemptReserved }
import gunbc.dispatch_credential_snapshot { ClaudeFromSnapshot, CursorFromSnapshot }
import gunbc.dispatch_credential_acquisition {
  CredentialAcquisitionRecord, credential_acquisition_reference, credential_record_decode, credential_record_json,
  CursorAttemptRuntimeRoot, cursor_attempt_runtime_root, cursor_attempt_runtime_home, cursor_attempt_runtime_config,
}

fn cursor_reference() -> String {
  credential_acquisition_reference(identity: "id1", executor: CursorFromSnapshot) as String
}

fn record(word: String, reference: String, root: CursorAttemptRuntimeRoot?) -> CredentialAcquisitionRecord {
  CredentialAcquisitionRecord {
    identity: "id1", node_id: "n", reference: reference, executor_word: word, snapshot_path: "/s",
    belt_unit: "u.service", control_group: "/g", opened_at: 10, launch_deadline: 40,
    cursor_runtime_root: root, state: AttemptReserved,
  }
}

fn decoded_root(text: String) -> String {
  match credential_record_decode(text: text) {
    Absent => "undecodable"
    Present { value: back } => match back.cursor_runtime_root { Present { value: r } => r.base  Absent => "none" }
  }
}

// A record in the format before the field existed (the key set credential_record_json emitted) decodes as
// having no runtime root; srv1 production and lab hold such records.
test fn a_record_in_the_format_before_the_field_decodes_with_no_root() -> Bool {
  decoded_root(text: "{\"identity\":\"id1\",\"node_id\":\"n\",\"reference\":\"id1-claude\",\"executor\":\"claude\",\"snapshot_path\":\"/s\",\"belt_unit\":\"u.service\",\"control_group\":\"/g\",\"opened_at\":10,\"launch_deadline\":40,\"state\":\"reserved\",\"detail\":\"\"}") == "none"
}

test fn a_cursor_root_round_trips_and_derives_its_home_and_config() -> Bool {
  let root = cursor_attempt_runtime_root(instance_root: "/srv/inst", reference: cursor_reference())
  let text = credential_record_json(r: record(word: "cursor", reference: cursor_reference(), root: Present { value: root }))
  decoded_root(text: text) == root.base
    && cursor_attempt_runtime_home(root: root) == join([root.base, "home"], "/")
    && cursor_attempt_runtime_config(root: root) == join([root.base, "config"], "/")
}

test fn an_absent_root_is_omitted_from_the_wire_not_written_as_empty() -> Bool {
  !string_contains(s: credential_record_json(r: record(word: "claude", reference: "id1-claude", root: none)), pattern: "cursor_runtime_root")
}

test fn a_claude_record_cannot_carry_a_root_nor_name_another_attempts() -> Bool {
  let own = cursor_attempt_runtime_root(instance_root: "/srv/inst", reference: cursor_reference())
  let other = cursor_attempt_runtime_root(instance_root: "/srv/inst", reference: "idB-cursor")
  let traversal = CursorAttemptRuntimeRoot { base: "/srv/inst/cursor-attempt-runtime/../../etc/id1-cursor" }
  decoded_root(text: credential_record_json(r: record(word: "claude", reference: "id1-claude", root: Present { value: own }))) == "undecodable"
    && decoded_root(text: credential_record_json(r: record(word: "cursor", reference: cursor_reference(), root: Present { value: other }))) == "undecodable"
    && decoded_root(text: credential_record_json(r: record(word: "cursor", reference: cursor_reference(), root: Present { value: traversal }))) == "undecodable"
}
