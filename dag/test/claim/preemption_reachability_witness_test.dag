module test.claim.preemption_reachability

import v2.std.text { String }
import v2.workflow.required_floor {
  ClaimPreemptionReachability,
  CooperativelyPollable,
  OpaqueHostCallUnbounded,
  ClaimSafetyOutcome,
  CompletedWithinSafetyLimits,
  SafetyInterrupted,
  CompletedPastSafetyLimit,
  claim_safety_outcome,
  claim_safety_outcome_blocks,
  claim_preemption_admission,
  required_floor_claim_cpu_safety_limit_ms,
  required_floor_claim_wall_safety_limit_ms,
  opaque_host_call_grandfather_population,
  grandfather_population_size,
  grandfather_population_has_duplicate,
}
import gunbc.v1_interpreter_opaque_host_call {
  OpaqueHostCallSurfaceGrounded,
  OpaqueHostCallSurfaceUngrounded,
  opaque_host_call_surface,
  opaque_host_call_surface_is_grounded,
  opaque_host_call_surface_contains,
  v1_interpreter_nested_compile_reaches,
}

// PREEMPTION-1 (gunbc#8584 REWORK): floor run 32301212975 recorded
// root_d_checkpoint_scalar_declared_arity_witness_holds reaching a verdict at 60317ms CPU against
// the then-current 5000ms required_floor_claim_cpu_safety_limit_ms, dominated by one
// compile_dag_rust_emit_check call. THE MEASURED RECEIPT IS THE CPU FIGURE AND THE
// VerdictReached/not-SafetyInterrupted FACT, AND NOTHING ELSE. The floor log reported no wall
// figure for this occurrence, so this fixture invents none: observed_wall_ms is set to 100, a
// value that cannot trip any wall limit this repository has carried, so the CPU arm is the sole
// cause of the classification under test.
//
// THIS SENTENCE HAS NOW ROTTED TWICE, WHICH IS WHY THE FIXTURE WAS CHANGED RATHER THAN THE PROSE
// CORRECTED A SECOND TIME. It first read comfortably inside the 10000ms wall limit; the 2026-08-27
// ceiling work invalidated that, and the correction asserted the limit had moved to 2000ms and that
// the fixture value exercised the wall branch. BOTH HALVES WERE FALSE ON THE DAY THEY LANDED: the
// wall limit was whatever required_floor_claim_wall_safety_limit_ms held, not 2000, and the fixture
// value EQUALLED it -- int_gt is strict, so it never exercised the wall branch. THE THIRD ROT IS
// PRE-EMPTED HERE: this sentence carried the live figure, the same transcription that produced rots
// one and two, so the number is dropped and the constant named; a reader who needs the value reads
// the function. The witness stayed green throughout because the CPU figure trips the same arm on
// its own; only the sentence was wrong. Found by review 57138.
//
// THE STRUCTURAL DEFECT BEHIND BOTH ROTS, and the reason for the 100: a fixture input equal to a
// live constant is coupled to that constant silently. Holding the limit's own value, this fixture
// sat one edit away from changing its own subject -- lower the wall limit below that value and the
// wall arm starts firing, the classification is reached for a different reason, and every
// assertion here still passes. A fixture chosen to isolate one clock must carry a value for the
// other that cannot participate at any setting, which 100 buys and any value near the limit cannot.

test fn w_root_d_shape_derives_completed_past_safety_limit_with_opaque_host_preemption() -> Bool {
  match claim_safety_outcome(
    reached_verdict: true,
    observed_cpu_ms: 60317,
    observed_wall_ms: 100,
    cpu_limit_ms: required_floor_claim_cpu_safety_limit_ms(),
    wall_limit_ms: required_floor_claim_wall_safety_limit_ms(),
    raised_by: "",
    preemption: OpaqueHostCallUnbounded { operation: "compile_dag_rust_emit_check" },
  ) {
    CompletedWithinSafetyLimits => false
    SafetyInterrupted { raised_by: _, elapsed_cpu_at_least: _, elapsed_wall_at_least: _ } => false
    CompletedPastSafetyLimit { observed_cpu: cpu, observed_wall: _, preemption: p } =>
      (cpu == 60317)
        && match p {
          CooperativelyPollable => false
          OpaqueHostCallUnbounded { operation: op } => (op) == "compile_dag_rust_emit_check"
        }
  }
}

// BINDING CONSTRAINT: a completed-past-limit occurrence blocks exactly as an interrupt does -- no
// amount of later completion converts a missed interrupt into successful enforcement. This is the
// discriminating half: it would pass if claim_safety_outcome_blocks silently returned false for
// CompletedPastSafetyLimit, so it is asserted directly rather than folded into the shape test
// above.

test fn w_completed_past_safety_limit_blocks() -> Bool {
  claim_safety_outcome_blocks(
    CompletedPastSafetyLimit {
      observed_cpu: 60317,
      observed_wall: 100,
      preemption: OpaqueHostCallUnbounded { operation: "compile_dag_rust_emit_check" },
    }
  ) == true
}

// BINDING CONSTRAINT: root_d was terminal -- it completed -- and must never be relabelled
// SafetyInterrupted. reached_verdict is the one fact the derivation switches on; this asserts that
// a claim which never reached a verdict (a genuine interrupt) is classified SafetyInterrupted and
// NOT CompletedPastSafetyLimit, so the two terminal-but-over-limit and non-terminal cases cannot be
// silently swapped by an edit to claim_safety_outcome.

test fn w_genuine_interrupt_is_not_relabelled_completed() -> Bool {
  match claim_safety_outcome(
    reached_verdict: false,
    observed_cpu_ms: 5200,
    observed_wall_ms: 5200,
    cpu_limit_ms: required_floor_claim_cpu_safety_limit_ms(),
    wall_limit_ms: required_floor_claim_wall_safety_limit_ms(),
    raised_by: "CpuDeadlineRaised",
    preemption: CooperativelyPollable,
  ) {
    CompletedWithinSafetyLimits => false
    CompletedPastSafetyLimit { observed_cpu: _, observed_wall: _, preemption: _ } => false
    SafetyInterrupted { raised_by: r, elapsed_cpu_at_least: cpu, elapsed_wall_at_least: _ } =>
      ((r) == "CpuDeadlineRaised") && (cpu == 5200)
  }
}

test fn w_genuine_interrupt_blocks_too() -> Bool {
  claim_safety_outcome_blocks(
    SafetyInterrupted {
      raised_by: "CpuDeadlineRaised",
      elapsed_cpu_at_least: 5200,
      elapsed_wall_at_least: 5200,
    }
  ) == true
}

data red_control_note: String = "THE DISCRIMINATION CONTROL: an ordinary claim safely inside both limits must reach CompletedWithinSafetyLimits and must not block. This asserts the opposite direction of the three above, so a derivation collapsed to a constant CompletedPastSafetyLimit or a constant blocks=true would not pass silently."

test fn w_within_limits_does_not_block() -> Bool {
  match claim_safety_outcome(
    reached_verdict: true,
    observed_cpu_ms: 42,
    observed_wall_ms: 42,
    cpu_limit_ms: required_floor_claim_cpu_safety_limit_ms(),
    wall_limit_ms: required_floor_claim_wall_safety_limit_ms(),
    raised_by: "",
    preemption: CooperativelyPollable,
  ) {
    SafetyInterrupted { raised_by: _, elapsed_cpu_at_least: _, elapsed_wall_at_least: _ } => false
    CompletedPastSafetyLimit { observed_cpu: _, observed_wall: _, preemption: _ } => false
    CompletedWithinSafetyLimits => true
  } && (claim_safety_outcome_blocks(CompletedWithinSafetyLimits) == false)
}

// THE MIGRATION WALL, both arms. compile_dag_rust_emit_check is a declared member of the opaque
// host-call population and is admitted; a hypothetical operation that does not meet the
// population's criterion is refused; cooperative reachability is always admitted, the case the
// safety limits genuinely protect. These three exercise the wall's SHAPE against fixture inputs;
// the four below exercise it against the live dispatch surface.

test fn w_grandfathered_operation_is_admitted() -> Bool {
  claim_preemption_admission(OpaqueHostCallUnbounded { operation: "compile_dag_rust_emit_check" }) == true
}

test fn w_new_opaque_operation_is_refused() -> Bool {
  claim_preemption_admission(OpaqueHostCallUnbounded { operation: "some_unmeasured_new_host_call" }) == false
}

test fn w_cooperatively_pollable_is_always_admitted() -> Bool {
  claim_preemption_admission(CooperativelyPollable) == true
}

// ── THE POPULATION IS GROUNDED, AND THE WALL IS JUDGED AGAINST THE LIVE SURFACE ─────────────
//
// WHAT THESE ADD OVER THE THREE ABOVE. The migration wall's two arms were previously exercised
// against one hand-typed string that is admitted and one invented string
// (`some_unmeasured_new_host_call`) that is refused. Neither input is joined to anything: the
// admitted spelling could name an operation the seed no longer dispatches and every assertion here
// would still pass, and the refused spelling names something that cannot occur, so the refusal arm
// had never been shown against a REAL host operation. These four close both ends.

// BINDING CONSTRAINT: every declared member resolves in the seed's dispatch-surface authority, as
// a FreeCall arm. This is the discriminating half of the grounding -- rename or delete an arm in
// `gunbc.v1_interpreter_primitive_surface` (which is itself drift-gated against the generated
// lookup tables) and this goes red, where the prior hand-typed literal stayed green.
test fn w_opaque_host_call_surface_is_grounded_in_the_dispatch_roster() -> Bool {
  opaque_host_call_surface_is_grounded() == true
}

// BINDING CONSTRAINT: the v2-tower population this module's wall reads and the std-tower authority
// that derives it name the SAME operations, joined at identity in BOTH directions. A count
// comparison would pass on two lists that disagree member-for-member; a one-way containment would
// pass on a projection that silently dropped a member. So the join is an injection plus
// cardinality plus distinctness -- grounded-surface subset-of the wall's population by ADMISSION
// per member, the wall's population duplicate-free, and the two sizes equal -- which forces set
// equality rather than merely agreeing totals. The tower gap that forces two spellings is
// recorded on `opaque_host_call_population_authority_dissolves_on`; this is what keeps it from
// becoming parallel-representation debt in the meantime.
test fn w_grandfather_population_matches_the_grounded_surface() -> Bool {
  match opaque_host_call_surface() {
    OpaqueHostCallSurfaceUngrounded { unresolved: _, not_free_call: _ } => false
    OpaqueHostCallSurfaceGrounded { operations: ops } =>
      (ops |> all(o =>
        claim_preemption_admission(OpaqueHostCallUnbounded { operation: o }) == true
      ))
        && (grandfather_population_has_duplicate(
              population: opaque_host_call_grandfather_population()
            ) == false)
        && (grandfather_population_size(population: opaque_host_call_grandfather_population())
              == count(ops))
        && (count(ops) == count(v1_interpreter_nested_compile_reaches()))
  }
}

// BINDING CONSTRAINT, AND THIS IS THE ONE THE PRIOR REVISION GOT WRONG. Seven arms that reach the
// identical unpollable dispatch shape were REFUSED by the wall, because the population had been
// declared over the single operation a floor run happened to catch over its limit. Refusing a
// live, corpus-exercised operation is not a conservative default here: the wall's `false` says
// "this operation is not covered by the declared drop", which was the false statement. One of the
// seven is asserted by name so the correction cannot be silently reverted to the measured-only
// reading.
test fn w_a_second_nested_compile_operation_is_admitted() -> Bool {
  claim_preemption_admission(
    OpaqueHostCallUnbounded { operation: "install_or_consume_floor_compile_clean_gate_receipt" }
  ) == true
}

// BINDING CONSTRAINT: the refusal arm, exercised against a REAL live `free_call.*` operation that
// does not meet the criterion, rather than against a fabricated name. `filesystem_read` is
// dispatched by the seed today and reaches no nested compile, so it must be refused -- which is
// what shows the wall discriminates on the criterion and has not collapsed to "admit every host
// operation" as the population grew from one member to eight.
test fn w_a_live_non_nested_compile_operation_is_still_refused() -> Bool {
  (claim_preemption_admission(OpaqueHostCallUnbounded { operation: "filesystem_read" }) == false)
    && (opaque_host_call_surface_contains(operation: "filesystem_read") == false)
}
