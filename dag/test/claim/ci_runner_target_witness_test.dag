module test.claim.ci_runner_target_witness


fn witness_fleet_target_projects_fleet_derivation() -> Bool {
  gunbc.ci_runner_target.ci_runner_target_spec(target: gunbc.ci_runner_target.FleetSelfHosted) == gunbc.runner_spec_from_offer.gunbc_ci_runner_spec()
}

fn witness_selected_target_projects_fleet() -> Bool {
  gunbc.ci_runner_target.gunbc_ci_selected_runner_spec() == gunbc.ci_runner_target.ci_runner_target_spec(target: gunbc.ci_runner_target.FleetSelfHosted)
}

fn witness_ubicloud_target_projects_catalog_label() -> Bool {
  match gunbc.ci_runner_target.ci_runner_target_spec(target: gunbc.ci_runner_target.UbicloudRunner { row: extdeps.cloud.ubicloud.ubicloud_standard_16_arm_catalog }) {
    extdeps.github.actions.SelfHosted { labels: ls } => ls.length() == 1 && ls.first() == "ubicloud-standard-16-arm"
    _ => false
  }
}

fn witness_github_private_target_projects_hosted_scalar_variant() -> Bool {
  match gunbc.ci_runner_target.ci_runner_target_spec(target: gunbc.ci_runner_target.GithubHostedRunner { row: extdeps.github.hosted_runners.github_hosted_ubuntu_2404_arm_private_catalog }) {
    extdeps.github.actions.HostedRunner { label: l } => extdeps.languages.yaml.gha_workflow.runner_label_string(label: l) == "ubuntu-24.04-arm"
    _ => false
  }
}

fn witness_runner_yaml_forms_discriminate_hosted_vs_label_routed() -> Bool {
  let hosted = extdeps.languages.yaml.gha_workflow.runner_yaml(spec: gunbc.ci_runner_target.ci_runner_target_spec(target: gunbc.ci_runner_target.GithubHostedRunner { row: extdeps.github.hosted_runners.github_hosted_ubuntu_2404_arm_private_catalog }))
  let label_routed = extdeps.languages.yaml.gha_workflow.runner_yaml(spec: gunbc.ci_runner_target.ci_runner_target_spec(target: gunbc.ci_runner_target.UbicloudRunner { row: extdeps.cloud.ubicloud.ubicloud_standard_16_arm_catalog }))
  hosted == extdeps.languages.yaml.types.yaml_string(s: "ubuntu-24.04-arm")
    && label_routed == extdeps.languages.yaml.gha_workflow.string_list_flow(items: ["ubicloud-standard-16-arm"])
    && hosted != extdeps.languages.yaml.gha_workflow.string_list_flow(items: ["ubuntu-24.04-arm"])
}

fn witness_fleet_regime_is_slot_carved_with_throttle_line() -> Bool {
  match gunbc.ci_runner_target.ci_runner_target_memory_regime(target: gunbc.ci_runner_target.FleetSelfHosted) {
    gunbc.ci_runner_target.SlotCarved { desired: d } =>
      let high = std.measure.byte_size_count(b: d.memory_high)
      let max = std.measure.byte_size_count(b: d.memory_max)
      high == 16106127360 && high < max
    gunbc.ci_runner_target.WholeMachine { ram: _ } => false
  }
}

fn witness_cloud_regime_is_whole_machine() -> Bool {
  match gunbc.ci_runner_target.ci_runner_target_memory_regime(target: gunbc.ci_runner_target.UbicloudRunner { row: extdeps.cloud.ubicloud.ubicloud_standard_16_arm_catalog }) {
    gunbc.ci_runner_target.SlotCarved { desired: _ } => false
    gunbc.ci_runner_target.WholeMachine { ram: r } => std.measure.byte_size_count(b: r) == 48000000000
  }
}

fn witness_ubicloud_arm_family_holds_cited_ratio() -> Bool {
  let arm_rows = v2.std.algebra.filter(
    extdeps.cloud.ubicloud.ubicloud_runner_catalog(),
    predicate: fn(gunbc.plans.md_helpers.row) { string_contains(s: gunbc.plans.md_helpers.row.runs_on_label, pattern: "-arm") }
  )
  v2.std.algebra.length(arm_rows) == 5
    && fold(arm_rows, init: true, f: fn(acc, gunbc.plans.md_helpers.row) {
        acc && std.measure.byte_size_count(b: gunbc.plans.md_helpers.row.memory_bytes) == std.measure.hardware_thread_count_value(t: gunbc.plans.md_helpers.row.vcpus) * 3000000000
      })
}

fn witness_github_visibility_axis_discriminates() -> Bool {
  let private_bytes = std.measure.byte_size_count(b: extdeps.github.hosted_runners.github_hosted_ubuntu_2404_arm_private_catalog.memory_bytes)
  let public_bytes = std.measure.byte_size_count(b: extdeps.github.hosted_runners.github_hosted_ubuntu_2404_arm_public_catalog.memory_bytes)
  private_bytes < public_bytes
}

fn witness_selected_regime_is_slot_carved() -> Bool {
  match gunbc.ci_runner_target.ci_runner_target_memory_regime(target: gunbc.ci_runner_target.selected_ci_runner_target()) {
    gunbc.ci_runner_target.SlotCarved { desired: _ } => true
    gunbc.ci_runner_target.WholeMachine { ram: _ } => false
  }
}

test fn ci_runner_target_witnesses() -> Bool {
  witness_fleet_target_projects_fleet_derivation()
    && witness_selected_target_projects_fleet()
    && witness_selected_regime_is_slot_carved()
    && witness_ubicloud_target_projects_catalog_label()
    && witness_github_private_target_projects_hosted_scalar_variant()
    && witness_runner_yaml_forms_discriminate_hosted_vs_label_routed()
    && witness_fleet_regime_is_slot_carved_with_throttle_line()
    && witness_cloud_regime_is_whole_machine()
    && witness_ubicloud_arm_family_holds_cited_ratio()
    && witness_github_visibility_axis_discriminates()
}
