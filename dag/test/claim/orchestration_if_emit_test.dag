module test.claim.orchestration_if_emit

data orch_if_golden_note: String = "Hand-authored goldens below are independent of the orch_* grammar row spellings in src/v2/extdeps/languages/bash.dag: byte tests compare the emitter against these literals so a row/segment/emitter regression cannot go green by perturbing both sides at once (#6467 pattern)."

fn orch_if_streq_empty_then_golden() -> String {
  "if [ -z \"$1\" ]; then verdict=absent; fi"
}

fn orch_if_streq_empty_then_intent() -> v2.std.orchestration.PipelineStep {
  v2.std.orchestration.If {
    cond: v2.std.orchestration.StrEmpty { operand: "\"$1\"" },
    then_: v2.std.orchestration.Pipeline {
      steps: [
        v2.std.orchestration.Do {
          run: v2.std.orchestration.Run {
            command: "verdict=absent",
            env: Empty,
            redirect: v2.std.collection.Absent,
            capture: v2.std.collection.Absent
          }
        }
      ],
      on_failure: v2.std.orchestration.FailFast
    },
    else_: v2.std.collection.Absent
  }
}

fn orch_if_streq_empty_then_perturbed_intent() -> v2.std.orchestration.PipelineStep {
  v2.std.orchestration.If {
    cond: v2.std.orchestration.StrEmpty { operand: "\"$2\"" },
    then_: v2.std.orchestration.Pipeline {
      steps: [
        v2.std.orchestration.Do {
          run: v2.std.orchestration.Run {
            command: "verdict=absent",
            env: Empty,
            redirect: v2.std.collection.Absent,
            capture: v2.std.collection.Absent
          }
        }
      ],
      on_failure: v2.std.orchestration.FailFast
    },
    else_: v2.std.collection.Absent
  }
}

fn orch_if_streq_else_golden() -> String {
  "if [ \"$1\" = \"$2\" ]; then verdict=converged; else verdict=drifted; fi"
}

fn orch_if_streq_else_intent() -> v2.std.orchestration.PipelineStep {
  v2.std.orchestration.If {
    cond: v2.std.orchestration.StrEq { lhs: "\"$1\"", rhs: "\"$2\"" },
    then_: v2.std.orchestration.Pipeline {
      steps: [
        v2.std.orchestration.Do {
          run: v2.std.orchestration.Run {
            command: "verdict=converged",
            env: Empty,
            redirect: v2.std.collection.Absent,
            capture: v2.std.collection.Absent
          }
        }
      ],
      on_failure: v2.std.orchestration.FailFast
    },
    else_: v2.std.collection.Present {
      value: v2.std.orchestration.Pipeline {
        steps: [
          v2.std.orchestration.Do {
            run: v2.std.orchestration.Run {
              command: "verdict=drifted",
              env: Empty,
              redirect: v2.std.collection.Absent,
              capture: v2.std.collection.Absent
            }
          }
        ],
        on_failure: v2.std.orchestration.FailFast
      }
    }
  }
}

fn orch_if_exit_zero_negated_golden() -> String {
  "if ! mkdir -p \"$7\"; then echo missing; fi"
}

fn orch_if_exit_zero_negated_intent() -> v2.std.orchestration.PipelineStep {
  v2.std.orchestration.If {
    cond: v2.std.orchestration.Not {
      inner: v2.std.orchestration.ExitZero {
        run: v2.std.orchestration.Run {
          command: "mkdir -p \"$7\"",
          env: Empty,
          redirect: v2.std.collection.Absent,
          capture: v2.std.collection.Absent
        }
      }
    },
    then_: v2.std.orchestration.Pipeline {
      steps: [
        v2.std.orchestration.Do {
          run: v2.std.orchestration.Run {
            command: "echo missing",
            env: Empty,
            redirect: v2.std.collection.Absent,
            capture: v2.std.collection.Absent
          }
        }
      ],
      on_failure: v2.std.orchestration.FailFast
    },
    else_: v2.std.collection.Absent
  }
}

fn orch_if_run_redirect_ignore_fail_golden() -> String {
  "if (cd \"$checkout\" && git fetch --prune origin) >/dev/null 2>&1 || true; then echo ok; fi"
}

fn orch_if_run_redirect_ignore_fail_intent() -> v2.std.orchestration.PipelineStep {
  v2.std.orchestration.If {
    cond: v2.std.orchestration.ExitZero {
      run: v2.std.orchestration.Run {
        command: "(cd \"$checkout\" && git fetch --prune origin)",
        env: Empty,
        redirect: v2.std.collection.Present { value: v2.std.orchestration.DiscardAll },
        capture: v2.std.collection.Present { value: v2.std.orchestration.IgnoreFail }
      }
    },
    then_: v2.std.orchestration.Pipeline {
      steps: [
        v2.std.orchestration.Do {
          run: v2.std.orchestration.Run {
            command: "echo ok",
            env: Empty,
            redirect: v2.std.collection.Absent,
            capture: v2.std.collection.Absent
          }
        }
      ],
      on_failure: v2.std.orchestration.FailFast
    },
    else_: v2.std.collection.Absent
  }
}

fn orch_if_log_matches_golden() -> String {
  "if grep -qiE 'EAGAIN|Resource temporarily unavailable' \"$BUILD_LOG\"; then echo retry; fi"
}

fn orch_if_log_matches_intent() -> v2.std.orchestration.PipelineStep {
  v2.std.orchestration.If {
    cond: v2.std.orchestration.LogMatches {
      source: "\"$BUILD_LOG\"",
      pattern: "EAGAIN|Resource temporarily unavailable"
    },
    then_: v2.std.orchestration.Pipeline {
      steps: [
        v2.std.orchestration.Do {
          run: v2.std.orchestration.Run {
            command: "echo retry",
            env: Empty,
            redirect: v2.std.collection.Absent,
            capture: v2.std.collection.Absent
          }
        }
      ],
      on_failure: v2.std.orchestration.FailFast
    },
    else_: v2.std.collection.Absent
  }
}

fn orch_if_and_tests_golden() -> String {
  "if [ -n \"$ctrl_pin\" ] && [ -n \"$dag_pin\" ]; then pin_ok=1; fi"
}

fn orch_if_and_tests_intent() -> v2.std.orchestration.PipelineStep {
  v2.std.orchestration.If {
    cond: v2.std.orchestration.And {
      lhs: v2.std.orchestration.StrNonempty { operand: "\"$ctrl_pin\"" },
      rhs: v2.std.orchestration.StrNonempty { operand: "\"$dag_pin\"" }
    },
    then_: v2.std.orchestration.Pipeline {
      steps: [
        v2.std.orchestration.Do {
          run: v2.std.orchestration.Run {
            command: "pin_ok=1",
            env: Empty,
            redirect: v2.std.collection.Absent,
            capture: v2.std.collection.Absent
          }
        }
      ],
      on_failure: v2.std.orchestration.FailFast
    },
    else_: v2.std.collection.Absent
  }
}

test fn orch_if_streq_empty_then_holds() -> Bool {
  match v2.compiler.emit_orchestration.orch_emit_step(s: orch_if_streq_empty_then_intent(), medium: v2.extdeps.languages.bash_orchestration_emit.bash_orchestration_emit_medium()) {
    Accepted { value: source, diagnostics: dg } =>
      (source.carried == orch_if_streq_empty_then_golden()) && (dg == v2.std.diagnostic.None)
    Rejected { diagnostics: _ } => false
  }
}

test fn orch_if_streq_empty_then_has_teeth_holds() -> Bool {
  match v2.compiler.emit_orchestration.orch_emit_step(s: orch_if_streq_empty_then_perturbed_intent(), medium: v2.extdeps.languages.bash_orchestration_emit.bash_orchestration_emit_medium()) {
    Accepted { value: source, diagnostics: _ } =>
      source.carried != orch_if_streq_empty_then_golden()
    Rejected { diagnostics: _ } => false
  }
}

test fn orch_if_streq_else_holds() -> Bool {
  match v2.compiler.emit_orchestration.orch_emit_step(s: orch_if_streq_else_intent(), medium: v2.extdeps.languages.bash_orchestration_emit.bash_orchestration_emit_medium()) {
    Accepted { value: source, diagnostics: dg } =>
      (source.carried == orch_if_streq_else_golden()) && (dg == v2.std.diagnostic.None)
    Rejected { diagnostics: _ } => false
  }
}

test fn orch_if_exit_zero_negated_holds() -> Bool {
  match v2.compiler.emit_orchestration.orch_emit_step(s: orch_if_exit_zero_negated_intent(), medium: v2.extdeps.languages.bash_orchestration_emit.bash_orchestration_emit_medium()) {
    Accepted { value: source, diagnostics: dg } =>
      (source.carried == orch_if_exit_zero_negated_golden()) && (dg == v2.std.diagnostic.None)
    Rejected { diagnostics: _ } => false
  }
}

test fn orch_if_run_redirect_ignore_fail_holds() -> Bool {
  match v2.compiler.emit_orchestration.orch_emit_step(s: orch_if_run_redirect_ignore_fail_intent(), medium: v2.extdeps.languages.bash_orchestration_emit.bash_orchestration_emit_medium()) {
    Accepted { value: source, diagnostics: dg } =>
      (source.carried == orch_if_run_redirect_ignore_fail_golden()) && (dg == v2.std.diagnostic.None)
    Rejected { diagnostics: _ } => false
  }
}

test fn orch_if_log_matches_holds() -> Bool {
  match v2.compiler.emit_orchestration.orch_emit_step(s: orch_if_log_matches_intent(), medium: v2.extdeps.languages.bash_orchestration_emit.bash_orchestration_emit_medium()) {
    Accepted { value: source, diagnostics: dg } =>
      (source.carried == orch_if_log_matches_golden()) && (dg == v2.std.diagnostic.None)
    Rejected { diagnostics: _ } => false
  }
}

test fn orch_if_and_tests_holds() -> Bool {
  match v2.compiler.emit_orchestration.orch_emit_step(s: orch_if_and_tests_intent(), medium: v2.extdeps.languages.bash_orchestration_emit.bash_orchestration_emit_medium()) {
    Accepted { value: source, diagnostics: dg } =>
      (source.carried == orch_if_and_tests_golden()) && (dg == v2.std.diagnostic.None)
    Rejected { diagnostics: _ } => false
  }
}

