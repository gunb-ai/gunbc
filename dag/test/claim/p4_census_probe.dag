module test.claim.p4_census_probe

import std.types { Bool, Int, List, String }
import v2.std.decl_index { DeclFact, decl_facts }

// TEMPORARY probe, deleted before merge. Establishes, before the claim is written:
// the separator the census uses in qualified_name, whether `test fn` declarations
// appear in it at all (two carrier citations are test fns), and whether a dag claim
// can pool src/v1 (four citations are v1.* checks whose authority .dag lives there).
// One read per pool, bound once: the repo's own precedent warns that repeated
// decl_facts calls took a witness "past any bound".
data p4_facts_dag_v2: List<DeclFact> = decl_facts(pool_roots: ["dag", "src/v2"])
data p4_facts_with_v1: List<DeclFact> = decl_facts(pool_roots: ["dag", "src/v1", "src/v2"])

// the precedent's own membership test, verbatim in shape
fn p4_count(facts: List<DeclFact>, qualified: String) -> Int {
  facts.filter(f => f.qualified_name == qualified).length()
}

fn probe_dotted_spelling_resolves() -> Bool {
  p4_count(facts: p4_facts_with_v1, qualified: "gunbc.spark.serving_performance_subject.accelerator_axis_reading") == 1
}

fn probe_double_colon_spelling_resolves() -> Bool {
  p4_count(facts: p4_facts_with_v1, qualified: "gunbc.spark.serving_performance_subject::accelerator_axis_reading") == 1
}

fn probe_test_fn_is_census_visible() -> Bool {
  p4_count(facts: p4_facts_with_v1, qualified: "test.claim.spark.serving_performance_subject_witness_test.w_workstation_and_server_pro6000_are_different_accelerator_subjects") == 1
}

fn probe_v1_visible_with_v1_root() -> Bool {
  p4_count(facts: p4_facts_with_v1, qualified: "v1.compiler.infer.sole_constructor_construction_diags") == 1
}

fn probe_v1_visible_without_v1_root() -> Bool {
  p4_count(facts: p4_facts_dag_v2, qualified: "v1.compiler.infer.sole_constructor_construction_diags") == 1
}

// NEGATIVE CONTROL: the module #14463 has not landed must stay absent, so a claim
// built on this census cannot be satisfied by a phantom.
fn probe_unmerged_module_stays_absent() -> Bool {
  p4_count(facts: p4_facts_with_v1, qualified: "gunbc.serving.home_serving_power_policy.HomeServingPowerAdmission") == 0
}

// the population must be substantive, or every negative above is vacuous
fn probe_population_is_substantive() -> Bool {
  p4_facts_with_v1.length() > 1000
}
