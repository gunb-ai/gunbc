module test.claim.vllm.vllm_engram_layout_witness

import std.types { Bool, List, Int }
import std.nat { Nat }
import v2.std.optional { Present, Absent }
import extdeps.vllm.engram_layout {
  vllm_engram_is_prime, vllm_engram_head_sizes, vllm_engram_rank_rows, vllm_engram_sum,
  vllm_engram_every_rank_has_heads,
}
import extdeps.deepseek.deepseek_v4_1_flash { deepseek_v4_1_flash_engram }

// THE DERIVATION AGAINST THE PUBLISHER'S INDEPENDENT FACT. vLLM's layout is recomputed from the
// config facts extdeps.deepseek.deepseek_v4_1_flash carries (layer count, max n-gram, heads, vocab);
// config.json's unpadded_embeddings are the published table rows. Each layer's derived head sizes
// must sum to exactly its published rows -- a derivation that drifted from upstream's prime draw
// would miss by at least one bucket.
fn w_live_head_sizes() -> List<List<Int>> {
  vllm_engram_head_sizes(
    layer_count: length(deepseek_v4_1_flash_engram.layer_ids),
    max_ngram_size: deepseek_v4_1_flash_engram.max_ngram_size,
    n_heads: deepseek_v4_1_flash_engram.n_heads,
    vocab_size: deepseek_v4_1_flash_engram.vocab_size,
  )
}

test fn the_derived_head_sizes_sum_to_the_published_table_rows() -> Bool {
  let sizes = w_live_head_sizes()
  length(sizes) == 2
    && all(sizes, l => length(l) == 24)
    && map(sizes, l => vllm_engram_sum(xs: l)) == deepseek_v4_1_flash_engram.unpadded_embeddings
}

// RED: the same draw with the `seen` set reset per layer (a plausible misreading of upstream) gives
// layer 14 layer 1's primes, and its sum is no longer the published layer-14 row count.
test fn a_draw_that_reuses_primes_across_layers_misses_the_published_rows() -> Bool {
  let one_layer = vllm_engram_head_sizes(layer_count: 1, max_ngram_size: deepseek_v4_1_flash_engram.max_ngram_size, n_heads: deepseek_v4_1_flash_engram.n_heads, vocab_size: deepseek_v4_1_flash_engram.vocab_size)
  match get(xs: deepseek_v4_1_flash_engram.unpadded_embeddings, index: 1) {
    Present { value: layer14 } => all(one_layer, l => vllm_engram_sum(xs: l) != layer14)
    Absent => false
  }
}

// TP4: each rank owns six contiguous hash heads; the ranges tile the table with no gap or overlap.
test fn tp4_rank_ranges_tile_each_layer_contiguously() -> Bool {
  all(w_live_head_sizes(), l => {
    let rows = vllm_engram_rank_rows(head_sizes: l, tp_size: 4)
    length(rows) == 4
      && all(rows, r => r.start < r.end)
      && match first(rows) { Present { value: r0 } => r0.start == 0  Absent => false }
      && match first(reverse(rows)) { Present { value: r3 } => r3.end == vllm_engram_sum(xs: l)  Absent => false }
      && all(zip(rows, rows |> skip(n: 1)), p => p.first.end == p.second.start)
  }) && vllm_engram_every_rank_has_heads(n_hash_cols: 24, tp_size: 4)
    && !vllm_engram_every_rank_has_heads(n_hash_cols: 3, tp_size: 4)
}

test fn the_primality_test_agrees_with_small_cases() -> Bool {
  vllm_engram_is_prime(n: 2) && vllm_engram_is_prime(n: 37) && vllm_engram_is_prime(n: 16000057)
    && !vllm_engram_is_prime(n: 1) && !vllm_engram_is_prime(n: 16000000) && !vllm_engram_is_prime(n: 25326001)
}
