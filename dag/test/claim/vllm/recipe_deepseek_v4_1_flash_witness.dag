module test.claim.vllm.recipe_deepseek_v4_1_flash_witness

import std.types { Bool, String, List, NonEmptyStr }
import std.roster_frontier {
  FrontierRow, frontier_rows_well_formed, frontier_rows_keyed_roster_build, frontier_path_subjects,
}
import std.keyed_roster { KeyedRosterBuilt, KeyedRosterBuildDuplicateKey }
import std.decl_ref { DeclarationRef, WholeDeclaration, declaration_ref_display_key }
import extdeps.uri { uri_wire }
import extdeps.vllm.recipe_deepseek_v4_1_flash {
  vllm_recipe_deepseek_v4_1_flash_tokenizer_mode,
  vllm_recipe_deepseek_v4_1_flash_tool_call_parser,
  vllm_recipe_deepseek_v4_1_flash_reasoning_parser,
  vllm_recipe_deepseek_v4_1_flash_frontier,
  vllm_recipe_deepseek_v4_1_flash_revision,
  vllm_recipe_deepseek_v4_1_flash_source_path,
  vllm_recipe_deepseek_v4_1_flash_source_blob_locator,
  extdeps_external_authority_anchor,
}

data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn recipe_decl_key(decl_name: String) -> String {
  declaration_ref_display_key(ref: DeclarationRef {
    module_path: "extdeps.vllm.recipe_deepseek_v4_1_flash" as NonEmptyStr,
    decl_name: decl_name as NonEmptyStr,
    field: WholeDeclaration,
  })
}

fn frontier_keys_contain(rows: List<FrontierRow>, decl_name: String) -> Bool {
  let want = recipe_decl_key(decl_name: decl_name)
  any(frontier_path_subjects(rows: rows), k => k == want)
}

test fn recipe_flags_share_one_vllm_spelling_and_the_frontier_names_all_three() -> Bool {
  (vllm_recipe_deepseek_v4_1_flash_tokenizer_mode as String)
      == (vllm_recipe_deepseek_v4_1_flash_tool_call_parser as String)
    && (vllm_recipe_deepseek_v4_1_flash_tool_call_parser as String)
      == (vllm_recipe_deepseek_v4_1_flash_reasoning_parser as String)
    && (vllm_recipe_deepseek_v4_1_flash_tokenizer_mode as String) == "deepseek_v41"
    && frontier_rows_well_formed(rows: vllm_recipe_deepseek_v4_1_flash_frontier)
    && match frontier_rows_keyed_roster_build(rows: vllm_recipe_deepseek_v4_1_flash_frontier) {
      KeyedRosterBuilt { rows: built } => (built |> count) == 3
      KeyedRosterBuildDuplicateKey { key: _, first: _, duplicate: _ } => false
    }
    && frontier_keys_contain(rows: vllm_recipe_deepseek_v4_1_flash_frontier, decl_name: "vllm_recipe_deepseek_v4_1_flash_tokenizer_mode")
    && frontier_keys_contain(rows: vllm_recipe_deepseek_v4_1_flash_frontier, decl_name: "vllm_recipe_deepseek_v4_1_flash_tool_call_parser")
    && frontier_keys_contain(rows: vllm_recipe_deepseek_v4_1_flash_frontier, decl_name: "vllm_recipe_deepseek_v4_1_flash_reasoning_parser")
}

test fn recipe_anchor_is_the_recipes_repo_commit_not_the_mutable_site() -> Bool {
  let loc = vllm_recipe_deepseek_v4_1_flash_source_blob_locator() as String
  let wired = uri_wire(uri: extdeps_external_authority_anchor.uri) as String
  (vllm_recipe_deepseek_v4_1_flash_revision as String) == "798d4ed3885fa2e9b812a43d19fe057769af2399"
    && (vllm_recipe_deepseek_v4_1_flash_source_path as String) == "models/deepseek-ai/DeepSeek-V4.1-Flash.yaml"
    && loc.contains("798d4ed3885fa2e9b812a43d19fe057769af2399")
    && loc.contains("models/deepseek-ai/DeepSeek-V4.1-Flash.yaml")
    && !loc.contains("recipes.vllm.ai")
    && wired == join(["https://", loc], "")
}
