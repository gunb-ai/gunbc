module test.claim.png_stored_encoding_witness

import std.types { Int, List, String }
import std.optional { Absent, Present }
import std.logic { Bool }
import std.bytes { bytes_octets, utf8_encode_bytes }
import std.bitwise { nibble_values }
import extdeps.color.srgb { Srgb8 }
import extdeps.standards.rfc_1950 { rfc_1950_adler32 }
import extdeps.standards.rfc_1951 { rfc_1951_stored_stream }
import extdeps.w3c.png {
  PngIndexedImage, PngPaletteEntry, PngEncoded, PngRefused, PngRowWidth, PngIndexOutsidePalette, PngPaletteOctetOutOfRange,
  png_crc32, png_encode,
}
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn png_witness_ascii(s: String) -> List<Int> {
  bytes_octets(b: utf8_encode_bytes(s: s))
}

// ═══ CHECKSUMS AGAINST PUBLISHED VALUES ═══
//
// 0xCBF43926 is CRC-32/ISO-HDLC's published check value over "123456789" (the CRC catalogue's
// `check`, the same polynomial PNG Annex D names). 0xAE426082 is the CRC every PNG's IEND chunk
// carries, since IEND's data is empty. 0x11E60398 is Adler-32 over "Wikipedia", the worked example
// of the algorithm RFC 1950 section 8.2 defines.
test fn crc32_matches_the_published_check_values() -> Bool {
  png_crc32(octets: png_witness_ascii(s: "123456789")) == 3421780262 && png_crc32(octets: png_witness_ascii(s: "IEND")) == 2923585666
}

test fn adler32_matches_the_worked_example() -> Bool {
  rfc_1950_adler32(octets: png_witness_ascii(s: "Wikipedia")) == 300286872 && rfc_1950_adler32(octets: []) == 1
}

// ═══ STORED BLOCKS SPLIT AT THE 16-BIT LENGTH ═══

data png_witness_sixteen_to_the_fourth: List<Int> = fold(nibble_values(), init: [], f: (a, w) =>
  fold(nibble_values(), init: a, f: (b, x) =>
    fold(nibble_values(), init: b, f: (c, y) =>
      fold(nibble_values(), init: c, f: (d, z) => d |> list_push(z)))))

fn png_witness_at(s: List<Int>, i: Int) -> Int {
  match get(s, i) {
    Present { value } => value
    Absent => -1
  }
}

// 65536 octets are one full block of 65535 (not final) and one block of 1 (final); an empty input
// is one empty final block.
test fn a_stream_longer_than_one_block_splits_at_65535() -> Bool {
  let s = rfc_1951_stored_stream(octets: png_witness_sixteen_to_the_fourth)
  count(s) == 65536 + 10
    && png_witness_at(s: s, i: 0) == 0 && png_witness_at(s: s, i: 1) == 255 && png_witness_at(s: s, i: 2) == 255
    && png_witness_at(s: s, i: 3) == 0 && png_witness_at(s: s, i: 4) == 0
    && png_witness_at(s: s, i: 65540) == 1 && png_witness_at(s: s, i: 65541) == 1 && png_witness_at(s: s, i: 65542) == 0
    && png_witness_at(s: s, i: 65543) == 254 && png_witness_at(s: s, i: 65544) == 255
    && rfc_1951_stored_stream(octets: []) == [1, 0, 0, 255, 255]
}

// ═══ A WHOLE FILE, BYTE FOR BYTE ═══
//
// The oracle is the same image written by Python's zlib and struct (an independent CRC, Adler-32 and
// chunk writer), which `file` identifies as "PNG image data, 2 x 1, 8-bit colormap, non-interlaced"
// and whose IDAT zlib.decompress reads back as the scanline [0, 0, 1].
data png_witness_stone_and_clear_ink: List<PngPaletteEntry> = [
  PngPaletteEntry { color: Srgb8 { r: 244, g: 241, b: 236 }, alpha: 255 },
  PngPaletteEntry { color: Srgb8 { r: 15, g: 15, b: 15 }, alpha: 0 },
]

data png_witness_two_by_one_oracle: List<Int> = [137, 80, 78, 71, 13, 10, 26, 10, 0, 0, 0, 13, 73, 72, 68, 82, 0, 0, 0, 2, 0, 0, 0, 1, 8, 3, 0, 0, 0, 195, 252, 143, 184, 0, 0, 0, 6, 80, 76, 84, 69, 244, 241, 236, 15, 15, 15, 222, 226, 35, 206, 0, 0, 0, 2, 116, 82, 78, 83, 255, 0, 229, 183, 48, 74, 0, 0, 0, 14, 73, 68, 65, 84, 120, 1, 1, 3, 0, 252, 255, 0, 0, 1, 0, 4, 0, 2, 11, 33, 139, 113, 0, 0, 0, 0, 73, 69, 78, 68, 174, 66, 96, 130]

test fn a_two_pixel_image_is_the_reference_file() -> Bool {
  match png_encode(image: PngIndexedImage { width: 2, height: 1, palette: png_witness_stone_and_clear_ink, rows: [[0, 1]] }) {
    PngEncoded { octets } => octets == png_witness_two_by_one_oracle
    PngRefused { cause: _ } => false
  }
}

// ═══ REFUSALS ═══

fn png_witness_refuses_row_width() -> Bool {
  match png_encode(image: PngIndexedImage { width: 2, height: 2, palette: png_witness_stone_and_clear_ink, rows: [[0, 1], [0]] }) {
    PngRefused { cause } => match cause {
      PngRowWidth { row, declared, actual } => row == 1 && declared == 2 && actual == 1
      _ => false
    }
    PngEncoded { octets: _ } => false
  }
}

fn png_witness_refuses_index_outside_palette() -> Bool {
  match png_encode(image: PngIndexedImage { width: 2, height: 1, palette: png_witness_stone_and_clear_ink, rows: [[0, 2]] }) {
    PngRefused { cause } => match cause {
      PngIndexOutsidePalette { row } => row == 0
      _ => false
    }
    PngEncoded { octets: _ } => false
  }
}

fn png_witness_refuses_out_of_range_alpha() -> Bool {
  match png_encode(image: PngIndexedImage { width: 1, height: 1, palette: [PngPaletteEntry { color: Srgb8 { r: 0, g: 0, b: 0 }, alpha: 256 }], rows: [[0]] }) {
    PngRefused { cause } => match cause {
      PngPaletteOctetOutOfRange => true
      _ => false
    }
    PngEncoded { octets: _ } => false
  }
}

test fn malformed_images_refuse_with_a_located_cause() -> Bool {
  png_witness_refuses_row_width() && png_witness_refuses_index_outside_palette() && png_witness_refuses_out_of_range_alpha()
}
