module test.claim.replacement_cut_witness

// Arrived on main carrying explicit imports, stripped on merge into the
// namespace cut. The rationale they carried -- that a module this new is in
// nobody else's closure, so bare references would not bind -- is exactly the
// pool-membership coincidence this lane removes: the closure is now derived
// from the references themselves, so a reference IS the dependency edge.

fn nes(s: String) -> std.types.NonEmptyStr { s as std.types.NonEmptyStr }

fn covered_consumer() -> gunbc.replacement_cut.BoundaryConsumer {
  gunbc.replacement_cut.BoundaryConsumer {
    consumer: test.claim.replacement_cut_witness.nes(s: "surviving external interface"),
    disposition: gunbc.replacement_cut.RetainSameContract {
      justification: test.claim.replacement_cut_witness.nes(s: "supported public surface"),
      coverage: gunbc.replacement_cut.Covered { by: test.claim.replacement_cut_witness.nes(s: "new fold root") },
    },
  }
}

fn open_consumer() -> gunbc.replacement_cut.BoundaryConsumer {
  gunbc.replacement_cut.BoundaryConsumer {
    consumer: test.claim.replacement_cut_witness.nes(s: "surviving invariant consumer"),
    disposition: gunbc.replacement_cut.RetainChangedContract {
      terminal_contract: test.claim.replacement_cut_witness.nes(s: "narrowed terminal contract"),
      justification: test.claim.replacement_cut_witness.nes(s: "invariant survives with narrower surface"),
      coverage: gunbc.replacement_cut.CoverageOpen,
    },
  }
}

fn undecided_consumer() -> gunbc.replacement_cut.BoundaryConsumer {
  gunbc.replacement_cut.BoundaryConsumer { consumer: test.claim.replacement_cut_witness.nes(s: "undispositioned caller"), disposition: gunbc.replacement_cut.Undecided }
}

fn retired_consumer() -> gunbc.replacement_cut.BoundaryConsumer {
  gunbc.replacement_cut.BoundaryConsumer {
    consumer: test.claim.replacement_cut_witness.nes(s: "workaround built to compensate for x"),
    disposition: gunbc.replacement_cut.Retire { reason: test.claim.replacement_cut_witness.nes(s: "only justification was x itself") },
  }
}

fn replaced_consumer() -> gunbc.replacement_cut.BoundaryConsumer {
  gunbc.replacement_cut.BoundaryConsumer {
    consumer: test.claim.replacement_cut_witness.nes(s: "old dispatch client"),
    disposition: gunbc.replacement_cut.ReplacedByY { new_authority: test.claim.replacement_cut_witness.nes(s: "y boundary authority") },
  }
}

fn evidence_consumer() -> gunbc.replacement_cut.BoundaryConsumer {
  gunbc.replacement_cut.BoundaryConsumer {
    consumer: test.claim.replacement_cut_witness.nes(s: "discriminating refusal witness"),
    disposition: gunbc.replacement_cut.EvidenceOnly {
      surviving_claim: test.claim.replacement_cut_witness.nes(s: "refusal y still claims"),
      reenrolled_witness: test.claim.replacement_cut_witness.nes(s: "witness re-enrolled against y"),
    },
  }
}

fn dispositioned_evidence() -> std.types.List<gunbc.replacement_cut.EvidenceDisposition> {
  [
    gunbc.replacement_cut.ReenrollAgainstY {
      evidence: test.claim.replacement_cut_witness.nes(s: "surviving discriminating witness"),
      surviving_claim: test.claim.replacement_cut_witness.nes(s: "refusal y still claims"),
    },
    gunbc.replacement_cut.RetireEvidence {
      evidence: test.claim.replacement_cut_witness.nes(s: "witness whose only subject was retired behavior"),
      retired_subject: test.claim.replacement_cut_witness.nes(s: "behavior deliberately rejected by y"),
      retirement_reason: test.claim.replacement_cut_witness.nes(s: "the subject claim is retired with the behavior"),
    },
  ]
}

fn typed_oracle() -> gunbc.replacement_cut.ExternalXAnswer {
  gunbc.replacement_cut.ExternalXRoles { roles: [gunbc.replacement_cut.ExternalDifferentialOracle, gunbc.replacement_cut.HistoricalMeasurementSource] }
}

fn two_region() -> std.types.List<std.types.NonEmptyStr> { [test.claim.replacement_cut_witness.nes(s: "x root module"), test.claim.replacement_cut_witness.nes(s: "x internal helper")] }

fn cut_full(
  consumers: std.types.List<gunbc.replacement_cut.BoundaryConsumer>,
  region: std.types.List<std.types.NonEmptyStr>,
  evidence: std.types.List<gunbc.replacement_cut.EvidenceDisposition>,
  new_root: String,
  oracle: gunbc.replacement_cut.ExternalXAnswer,
) -> gunbc.replacement_cut.ReplacementCut {
  gunbc.replacement_cut.ReplacementCut {
    identity: "cut-fixture" as gunbc.replacement_cut.ReplacementCutId,
    old_root_consumer: test.claim.replacement_cut_witness.nes(s: "old floor step"),
    subject: test.claim.replacement_cut_witness.nes(s: "exact subject population"),
    contract: test.claim.replacement_cut_witness.nes(s: "complete contract including refusals"),
    new_root: test.claim.replacement_cut_witness.nes(s: new_root),
    why_not_higher: gunbc.replacement_cut.OutermostBoundary,
    covered_region: region,
    boundary_census: gunbc.replacement_cut.ConsumersEnumerated { consumers: consumers },
    external_x: oracle,
    evidence_dispositions: evidence,
  }
}

fn cut_with(
  consumers: std.types.List<gunbc.replacement_cut.BoundaryConsumer>,
  region: std.types.List<std.types.NonEmptyStr>,
  evidence: std.types.List<gunbc.replacement_cut.EvidenceDisposition>,
) -> gunbc.replacement_cut.ReplacementCut {
  cut_full(consumers: consumers, region: region, evidence: evidence, new_root: "new fold root", oracle: typed_oracle())
}

fn causes_of(admission: gunbc.replacement_cut.PlanAdmission) -> std.types.List<gunbc.replacement_cut.CutRefusalCause> {
  match admission {
    PlanAdmitted { admitted: _ } => []
    gunbc.replacement_cut.PlanRefused { causes: cs } => cs
  }
}

fn cause_matches(c: gunbc.replacement_cut.CutRefusalCause, tag: String, subject: String) -> Bool {
  match c {
    UndispositionedConsumer { consumer: w } => tag == "undispositioned-consumer" && (w as String) == subject
    UncoveredSurvivingConsumer { consumer: w } => tag == "uncovered-surviving" && (w as String) == subject
    UndispositionedEvidence { evidence: w } => tag == "undispositioned-evidence" && (w as String) == subject
    CoveredByOldRoot { consumer: w } => tag == "covered-by-old-root" && (w as String) == subject
    ReplacementNamesOldRoot { consumer: w } => tag == "replacement-names-old-root" && (w as String) == subject
    ConsumerDuplicated { consumer: w } => tag == "consumer-duplicated" && (w as String) == subject
    EvidenceDuplicated { evidence: w } => tag == "evidence-duplicated" && (w as String) == subject
    RegionMemberDuplicated { member: w } => tag == "region-member-duplicated" && (w as String) == subject
    EnumeratedCensusEmpty => tag == "enumerated-census-empty" && subject == ""
    ExternalRolesEnumeratedEmpty => tag == "external-roles-enumerated-empty" && subject == ""
    EmptyCoveredRegion => tag == "empty-covered-region" && subject == ""
    NewRootEqualsOldRoot => tag == "new-root-equals-old-root" && subject == ""
    SelfReferentialDescent => tag == "self-referential-descent" && subject == ""
  }
}

fn causes_include(causes: std.types.List<gunbc.replacement_cut.CutRefusalCause>, tag: String, subject: String) -> Bool {
  fold(causes, init: false, f: fn(acc, c) { acc || cause_matches(c: c, tag: tag, subject: subject) })
}

test fn fully_dispositioned_cut_admits_with_exact_counts() -> Bool {
  let admission = gunbc.replacement_cut.admit_replacement_cut_plan(cut: cut_with(
    consumers: [covered_consumer(), replaced_consumer(), test.claim.replacement_cut_witness.evidence_consumer(), retired_consumer()],
    region: two_region(),
    evidence: dispositioned_evidence(),
  ))
  match admission {
    PlanAdmitted { admitted: a } =>
      a.retained_count == 1 && a.replaced_count == 1 && a.evidence_only_count == 1
        && a.retired_count == 1 && a.covered_region_count == 2
    gunbc.replacement_cut.PlanRefused { causes: _ } => false
  }
}

test fn admitted_verdict_is_bound_to_the_plan_it_judged() -> Bool {
  let plan = cut_with(
    consumers: [covered_consumer()],
    region: two_region(),
    evidence: dispositioned_evidence(),
  )
  let mutated = cut_with(
    consumers: [covered_consumer()],
    region: two_region(),
    evidence: [],
  )
  match gunbc.replacement_cut.admit_replacement_cut_plan(cut: plan) {
    PlanAdmitted { admitted: a } =>
      gunbc.replacement_cut.admitted_matches_plan(admitted: a, cut: plan) && !gunbc.replacement_cut.admitted_matches_plan(admitted: a, cut: mutated)
    gunbc.replacement_cut.PlanRefused { causes: _ } => false
  }
}

test fn undecided_consumer_blocks_the_cut() -> Bool {
  let causes = test.claim.replacement_cut_witness.causes_of(admission: gunbc.replacement_cut.admit_replacement_cut_plan(cut: cut_with(
    consumers: [covered_consumer(), undecided_consumer()],
    region: two_region(),
    evidence: dispositioned_evidence(),
  )))
  std.types.list_length(items: causes) == 1
    && causes_include(causes: causes, tag: "undispositioned-consumer", subject: "undispositioned caller")
}

test fn surviving_consumer_without_coverage_refuses() -> Bool {
  let causes = test.claim.replacement_cut_witness.causes_of(admission: gunbc.replacement_cut.admit_replacement_cut_plan(cut: cut_with(
    consumers: [open_consumer()],
    region: two_region(),
    evidence: dispositioned_evidence(),
  )))
  std.types.list_length(items: causes) == 1
    && causes_include(causes: causes, tag: "uncovered-surviving", subject: "surviving invariant consumer")
}

test fn undecided_evidence_blocks_the_cut() -> Bool {
  let causes = test.claim.replacement_cut_witness.causes_of(admission: gunbc.replacement_cut.admit_replacement_cut_plan(cut: cut_with(
    consumers: [covered_consumer()],
    region: two_region(),
    evidence: [gunbc.replacement_cut.EvidenceUndecided { evidence: test.claim.replacement_cut_witness.nes(s: "parked witness") }],
  )))
  std.types.list_length(items: causes) == 1
    && causes_include(causes: causes, tag: "undispositioned-evidence", subject: "parked witness")
}

test fn retired_consumer_needs_no_coverage() -> Bool {
  let admission = gunbc.replacement_cut.admit_replacement_cut_plan(cut: cut_with(
    consumers: [retired_consumer()],
    region: two_region(),
    evidence: dispositioned_evidence(),
  ))
  match admission {
    PlanAdmitted { admitted: a } =>
      a.retained_count == 0 && a.replaced_count == 0 && a.evidence_only_count == 0 && a.retired_count == 1
    gunbc.replacement_cut.PlanRefused { causes: _ } => false
  }
}

test fn a_cut_that_deletes_nothing_is_not_a_cut() -> Bool {
  let causes = test.claim.replacement_cut_witness.causes_of(admission: gunbc.replacement_cut.admit_replacement_cut_plan(cut: cut_with(
    consumers: [covered_consumer()],
    region: [],
    evidence: dispositioned_evidence(),
  )))
  std.types.list_length(items: causes) == 1
    && causes_include(causes: causes, tag: "empty-covered-region", subject: "")
}

test fn every_cause_is_counted_not_first_wins() -> Bool {
  let causes = test.claim.replacement_cut_witness.causes_of(admission: gunbc.replacement_cut.admit_replacement_cut_plan(cut: cut_with(
    consumers: [undecided_consumer(), open_consumer()],
    region: [],
    evidence: [gunbc.replacement_cut.EvidenceUndecided { evidence: test.claim.replacement_cut_witness.nes(s: "parked witness") }],
  )))
  std.types.list_length(items: causes) == 4
    && causes_include(causes: causes, tag: "undispositioned-consumer", subject: "undispositioned caller")
    && causes_include(causes: causes, tag: "uncovered-surviving", subject: "surviving invariant consumer")
    && causes_include(causes: causes, tag: "undispositioned-evidence", subject: "parked witness")
    && causes_include(causes: causes, tag: "empty-covered-region", subject: "")
}

test fn new_root_equal_to_old_root_refuses() -> Bool {
  let causes = test.claim.replacement_cut_witness.causes_of(admission: gunbc.replacement_cut.admit_replacement_cut_plan(cut: cut_full(
    consumers: [covered_consumer()],
    region: two_region(),
    evidence: dispositioned_evidence(),
    new_root: "old floor step",
    oracle: typed_oracle(),
  )))
  causes_include(causes: causes, tag: "new-root-equals-old-root", subject: "")
}

test fn coverage_by_the_old_root_is_fallback_wearing_a_disposition() -> Bool {
  let fallback_consumer = gunbc.replacement_cut.BoundaryConsumer {
    consumer: test.claim.replacement_cut_witness.nes(s: "consumer leaning on x"),
    disposition: gunbc.replacement_cut.RetainSameContract {
      justification: test.claim.replacement_cut_witness.nes(s: "claims retention"),
      coverage: gunbc.replacement_cut.Covered { by: test.claim.replacement_cut_witness.nes(s: "old floor step") },
    },
  }
  let causes = test.claim.replacement_cut_witness.causes_of(admission: gunbc.replacement_cut.admit_replacement_cut_plan(cut: cut_with(
    consumers: [fallback_consumer],
    region: two_region(),
    evidence: dispositioned_evidence(),
  )))
  std.types.list_length(items: causes) == 1
    && causes_include(causes: causes, tag: "covered-by-old-root", subject: "consumer leaning on x")
}

test fn replacement_naming_the_old_root_refuses() -> Bool {
  let circular = gunbc.replacement_cut.BoundaryConsumer {
    consumer: test.claim.replacement_cut_witness.nes(s: "circular client"),
    disposition: gunbc.replacement_cut.ReplacedByY { new_authority: test.claim.replacement_cut_witness.nes(s: "old floor step") },
  }
  let causes = test.claim.replacement_cut_witness.causes_of(admission: gunbc.replacement_cut.admit_replacement_cut_plan(cut: cut_with(
    consumers: [circular],
    region: two_region(),
    evidence: dispositioned_evidence(),
  )))
  std.types.list_length(items: causes) == 1
    && causes_include(causes: causes, tag: "replacement-names-old-root", subject: "circular client")
}

test fn duplicate_consumer_refuses_even_when_dispositions_agree() -> Bool {
  let causes = test.claim.replacement_cut_witness.causes_of(admission: gunbc.replacement_cut.admit_replacement_cut_plan(cut: cut_with(
    consumers: [retired_consumer(), retired_consumer()],
    region: two_region(),
    evidence: dispositioned_evidence(),
  )))
  std.types.list_length(items: causes) == 1
    && causes_include(causes: causes, tag: "consumer-duplicated", subject: "workaround built to compensate for x")
}

test fn duplicate_evidence_subject_refuses() -> Bool {
  let causes = test.claim.replacement_cut_witness.causes_of(admission: gunbc.replacement_cut.admit_replacement_cut_plan(cut: cut_with(
    consumers: [covered_consumer()],
    region: two_region(),
    evidence: [
      gunbc.replacement_cut.ReenrollAgainstY { evidence: test.claim.replacement_cut_witness.nes(s: "one witness"), surviving_claim: test.claim.replacement_cut_witness.nes(s: "claim a") },
      gunbc.replacement_cut.RetireEvidence {
        evidence: test.claim.replacement_cut_witness.nes(s: "one witness"),
        retired_subject: test.claim.replacement_cut_witness.nes(s: "claim a"),
        retirement_reason: test.claim.replacement_cut_witness.nes(s: "contradicts the reenroll row"),
      },
    ],
  )))
  std.types.list_length(items: causes) == 1
    && causes_include(causes: causes, tag: "evidence-duplicated", subject: "one witness")
}

test fn duplicate_region_member_refuses() -> Bool {
  let causes = test.claim.replacement_cut_witness.causes_of(admission: gunbc.replacement_cut.admit_replacement_cut_plan(cut: cut_with(
    consumers: [covered_consumer()],
    region: [test.claim.replacement_cut_witness.nes(s: "x root module"), test.claim.replacement_cut_witness.nes(s: "x root module")],
    evidence: dispositioned_evidence(),
  )))
  std.types.list_length(items: causes) == 1
    && causes_include(causes: causes, tag: "region-member-duplicated", subject: "x root module")
}

test fn enumerated_empty_census_refuses_but_declared_empty_admits() -> Bool {
  let ambiguous = gunbc.replacement_cut.admit_replacement_cut_plan(cut: cut_with(
    consumers: [],
    region: two_region(),
    evidence: dispositioned_evidence(),
  ))
  let declared = gunbc.replacement_cut.ReplacementCut {
    identity: "cut-dead-region" as gunbc.replacement_cut.ReplacementCutId,
    old_root_consumer: test.claim.replacement_cut_witness.nes(s: "old floor step"),
    subject: test.claim.replacement_cut_witness.nes(s: "exact subject population"),
    contract: test.claim.replacement_cut_witness.nes(s: "complete contract including refusals"),
    new_root: test.claim.replacement_cut_witness.nes(s: "new fold root"),
    why_not_higher: gunbc.replacement_cut.OutermostBoundary,
    covered_region: two_region(),
    boundary_census: gunbc.replacement_cut.BoundaryDeclaredEmpty { basis: test.claim.replacement_cut_witness.nes(s: "no live consumer reaches this region; census by execution") },
    external_x: gunbc.replacement_cut.NoExternalOracleRequired { justification: test.claim.replacement_cut_witness.nes(s: "dead region needs no differential oracle") },
    evidence_dispositions: [],
  }
  causes_include(causes: test.claim.replacement_cut_witness.causes_of(admission: ambiguous), tag: "enumerated-census-empty", subject: "")
    && (match gunbc.replacement_cut.admit_replacement_cut_plan(cut: declared) {
      PlanAdmitted { admitted: a } => a.retained_count == 0 && a.covered_region_count == 2
      gunbc.replacement_cut.PlanRefused { causes: _ } => false
    })
}

test fn empty_external_role_list_refuses_but_justified_no_oracle_admits() -> Bool {
  let ambiguous = gunbc.replacement_cut.admit_replacement_cut_plan(cut: cut_full(
    consumers: [covered_consumer()],
    region: two_region(),
    evidence: dispositioned_evidence(),
    new_root: "new fold root",
    oracle: gunbc.replacement_cut.ExternalXRoles { roles: [] },
  ))
  let justified = gunbc.replacement_cut.admit_replacement_cut_plan(cut: cut_full(
    consumers: [covered_consumer()],
    region: two_region(),
    evidence: dispositioned_evidence(),
    new_root: "new fold root",
    oracle: gunbc.replacement_cut.NoExternalOracleRequired { justification: test.claim.replacement_cut_witness.nes(s: "boundary compared by construction, no differential run") },
  ))
  causes_include(causes: test.claim.replacement_cut_witness.causes_of(admission: ambiguous), tag: "external-roles-enumerated-empty", subject: "")
    && std.types.list_length(items: test.claim.replacement_cut_witness.causes_of(admission: ambiguous)) == 1
    && (match justified {
      PlanAdmitted { admitted: a } => a.covered_region_count == 2
      gunbc.replacement_cut.PlanRefused { causes: _ } => false
    })
}

test fn self_referential_descent_refuses() -> Bool {
  let cut = gunbc.replacement_cut.ReplacementCut {
    identity: "cut-self" as gunbc.replacement_cut.ReplacementCutId,
    old_root_consumer: test.claim.replacement_cut_witness.nes(s: "b0 boundary"),
    subject: test.claim.replacement_cut_witness.nes(s: "exact subject population"),
    contract: test.claim.replacement_cut_witness.nes(s: "complete contract including refusals"),
    new_root: test.claim.replacement_cut_witness.nes(s: "b1"),
    why_not_higher: gunbc.replacement_cut.DescendedFromRefusedCut {
      parent_cut: "cut-self" as gunbc.replacement_cut.ReplacementCutId,
      refusal_summary: test.claim.replacement_cut_witness.nes(s: "claims its own refusal as license"),
    },
    covered_region: two_region(),
    boundary_census: gunbc.replacement_cut.ConsumersEnumerated { consumers: [covered_consumer()] },
    external_x: typed_oracle(),
    evidence_dispositions: [],
  }
  causes_include(causes: test.claim.replacement_cut_witness.causes_of(admission: gunbc.replacement_cut.admit_replacement_cut_plan(cut: cut)), tag: "self-referential-descent", subject: "")
}

test fn descended_cut_names_its_parent_by_typed_identity() -> Bool {
  let cut = gunbc.replacement_cut.ReplacementCut {
    identity: "cut-b0" as gunbc.replacement_cut.ReplacementCutId,
    old_root_consumer: test.claim.replacement_cut_witness.nes(s: "b0 boundary"),
    subject: test.claim.replacement_cut_witness.nes(s: "exact subject population"),
    contract: test.claim.replacement_cut_witness.nes(s: "complete contract including refusals"),
    new_root: test.claim.replacement_cut_witness.nes(s: "b1"),
    why_not_higher: gunbc.replacement_cut.DescendedFromRefusedCut {
      parent_cut: "cut-a0" as gunbc.replacement_cut.ReplacementCutId,
      refusal_summary: test.claim.replacement_cut_witness.nes(s: "escaping consumer q0 uncovered"),
    },
    covered_region: two_region(),
    boundary_census: gunbc.replacement_cut.ConsumersEnumerated { consumers: [covered_consumer()] },
    external_x: typed_oracle(),
    evidence_dispositions: [],
  }
  match cut.why_not_higher {
    DescendedFromRefusedCut { parent_cut: p, refusal_summary: r } =>
      (p as String) == "cut-a0" && (r as String) == "escaping consumer q0 uncovered"
    OutermostBoundary => false
    DescentParentUnauthored { intended_parent_boundary: _, basis: _ } => false
  }
}

fn is_admitted(a: gunbc.replacement_cut.PlanAdmission) -> Bool {
  match a {
    PlanAdmitted { admitted: _ } => true
    gunbc.replacement_cut.PlanRefused { causes: _ } => false
  }
}

fn cut_answering(identity: String, answer: gunbc.replacement_cut.HigherBoundaryAnswer) -> gunbc.replacement_cut.ReplacementCut {
  gunbc.replacement_cut.ReplacementCut {
    identity: identity as gunbc.replacement_cut.ReplacementCutId,
    old_root_consumer: test.claim.replacement_cut_witness.nes(s: "b0 boundary"),
    subject: test.claim.replacement_cut_witness.nes(s: "exact subject population"),
    contract: test.claim.replacement_cut_witness.nes(s: "complete contract including refusals"),
    new_root: test.claim.replacement_cut_witness.nes(s: "b1"),
    why_not_higher: answer,
    covered_region: two_region(),
    boundary_census: gunbc.replacement_cut.ConsumersEnumerated { consumers: [covered_consumer()] },
    external_x: typed_oracle(),
    evidence_dispositions: [],
  }
}

// The honest state a real first subject lands in: not outermost, and no cut has
// been authored at the boundary above. It admits, and it carries no identifier
// that could be mistaken for a resolvable join.
test fn unauthored_parent_boundary_admits_without_naming_an_id() -> Bool {
  let cut = cut_answering(
    identity: "cut-interpreter",
    answer: gunbc.replacement_cut.DescentParentUnauthored {
      intended_parent_boundary: test.claim.replacement_cut_witness.nes(s: "the engine cut through the v1 driver region"),
      basis: test.claim.replacement_cut_witness.nes(s: "no cut authored at that boundary by any lane"),
    },
  )
  test.claim.replacement_cut_witness.is_admitted(a: gunbc.replacement_cut.admit_replacement_cut_plan(cut: cut))
    && match cut.why_not_higher {
      DescentParentUnauthored { intended_parent_boundary: b, basis: _ } =>
        (b as String) == "the engine cut through the v1 driver region"
      OutermostBoundary => false
      DescendedFromRefusedCut { parent_cut: _, refusal_summary: _ } => false
    }
}

// The new arm's self-reference: naming your own old root as the boundary above
// you is the same incoherence SelfReferentialDescent already names.
test fn descent_parent_unauthored_naming_its_own_root_refuses() -> Bool {
  let causes = test.claim.replacement_cut_witness.causes_of(admission: gunbc.replacement_cut.admit_replacement_cut_plan(cut: cut_answering(
    identity: "cut-self-boundary",
    answer: gunbc.replacement_cut.DescentParentUnauthored {
      intended_parent_boundary: test.claim.replacement_cut_witness.nes(s: "b0 boundary"),
      basis: test.claim.replacement_cut_witness.nes(s: "claims the boundary it is cutting is also the boundary above it"),
    },
  )))
  std.types.list_length(items: causes) == 1
    && causes_include(causes: causes, tag: "self-referential-descent", subject: "")
}

// POSITIVE CONTROL for the two declared-gap probes below: admission is not
// vacuous. Without this, ␀132␀ carries no information.
test fn probe_control_refuses_undecided() -> Bool {
  !test.claim.replacement_cut_witness.is_admitted(a: gunbc.replacement_cut.admit_replacement_cut_plan(cut: cut_with(
    consumers: [undecided_consumer()],
    region: two_region(),
    evidence: dispositioned_evidence(),
  )))
}

// DECLARED GAP, enrolled so it is counted rather than rediscovered: parent_cut
// is an unjoined reference and a parent that exists nowhere is admitted. This
// test asserts the gap. It goes RED when a cut registry makes the reference
// joinable -- which is the next-rung trigger firing, not a regression.
test fn probe_admits_nonexistent_parent() -> Bool {
  test.claim.replacement_cut_witness.is_admitted(a: gunbc.replacement_cut.admit_replacement_cut_plan(cut: cut_answering(
    identity: "cut-b0",
    answer: gunbc.replacement_cut.DescendedFromRefusedCut {
      parent_cut: "cut-that-exists-nowhere-in-any-tree-zzz" as gunbc.replacement_cut.ReplacementCutId,
      refusal_summary: test.claim.replacement_cut_witness.nes(s: "a parent never authored cannot have refused anything"),
    },
  )))
}

// SCOPE, not a gap: plan admission judges the authored plan's internal
// coherence, never the world, so a well-formed OutermostBoundary claim admits
// whether or not a higher boundary exists in fact.
test fn probe_admits_outermost_claim() -> Bool {
  test.claim.replacement_cut_witness.is_admitted(a: gunbc.replacement_cut.admit_replacement_cut_plan(cut: cut_answering(
    identity: "cut-outermost",
    answer: gunbc.replacement_cut.OutermostBoundary,
  )))
}
