module test.claim.replacement_cut_witness

// Imported from the definer rather than left as bare references, per the
// accidental-coverage class the import-strip diagnosis names: a module this
// new is in nobody else's closure, so bare references would not bind.
import std.types { String, NonEmptyStr, Bool, Int, List, list_length }
import std.decl_ref { DeclarationRef, decl_ref, declaration_ref_eq }
import gunbc.replacement_cut {
  ReplacementCutId,
  CoverageClaim, Covered, CoverageOpen,
  ConsumerDisposition,
  RetainSameContract, RetainChangedContract, ReplacedByY, EvidenceOnly, Retire, Undecided,
  BoundaryConsumer,
  BoundaryCensus, ConsumersEnumerated, BoundaryDeclaredEmpty,
  HigherBoundaryAnswer, OutermostBoundary, DescendedFromRefusedCut, DescentParentUnauthored,
  EvidenceDisposition, ReenrollAgainstY, ReplaceEvidence, RetireEvidence, EvidenceUndecided,
  ExternalXRole, BootstrapProducer, ExternalDifferentialOracle, MechanicalCorpusRewriter, HistoricalMeasurementSource,
  ExternalXAnswer, ExternalXRoles, NoExternalOracleRequired,
  ReplacementCut,
  CutRefusalCause,
  UndispositionedConsumer, UncoveredSurvivingConsumer, UndispositionedEvidence,
  CoveredByOldRoot, ReplacementNamesOldRoot,
  ConsumerDuplicated, EvidenceDuplicated, RegionMemberDuplicated,
  EnumeratedCensusEmpty, ExternalRolesEnumeratedEmpty, EmptyCoveredRegion, NewRootEqualsOldRoot, SelfReferentialDescent,
  AdmittedReplacementCutPlan,
  PlanAdmission, PlanAdmitted, PlanRefused,
  admit_replacement_cut_plan, admitted_matches_plan,
  CutRegistration, RegisteredExactCut, RegisteredCutRemeasureRequired,
  CutRegistryStanding, CutRegistryAdmitted, CutRegistryRefused,
  CutRegistryRefusalCause, RegistryDuplicateCutId, RegistryParentAbsent, RegistryParentRemeasureRequired,
  LegacyConsumerSurveyRow, LegacyReplacementSurvey,
  admit_cut_registry,
}

fn nes(s: String) -> NonEmptyStr { s as NonEmptyStr }

// Fixture identities. The carrier now keys the boundary relation on consumer x consumed-authority,
// so a fixture must name BOTH sides; a synthetic module path keeps these out of any real namespace.
fn fixture_ref(name: String) -> DeclarationRef {
  decl_ref(module_path: "fixture.replacement_cut", decl_name: name)
}

fn fixture_authority() -> DeclarationRef {
  decl_ref(module_path: "fixture.replacement_cut", decl_name: "old_root_declaration")
}

fn other_authority() -> DeclarationRef {
  decl_ref(module_path: "fixture.replacement_cut", decl_name: "other_old_root_declaration")
}

fn covered_consumer() -> BoundaryConsumer {
  BoundaryConsumer {
    consumer: fixture_ref(name: "surviving external interface"), consumed_old_authority: fixture_authority(),
    disposition: RetainSameContract {
      justification: nes(s: "supported public surface"),
      coverage: Covered { by: nes(s: "new fold root") },
    },
  }
}

fn open_consumer() -> BoundaryConsumer {
  BoundaryConsumer {
    consumer: fixture_ref(name: "surviving invariant consumer"), consumed_old_authority: fixture_authority(),
    disposition: RetainChangedContract {
      terminal_contract: nes(s: "narrowed terminal contract"),
      justification: nes(s: "invariant survives with narrower surface"),
      coverage: CoverageOpen,
    },
  }
}

fn undecided_consumer() -> BoundaryConsumer {
  BoundaryConsumer { consumer: fixture_ref(name: "undispositioned caller"), consumed_old_authority: fixture_authority(), disposition: Undecided }
}

fn retired_consumer() -> BoundaryConsumer {
  BoundaryConsumer {
    consumer: fixture_ref(name: "workaround built to compensate for x"), consumed_old_authority: fixture_authority(),
    disposition: Retire { reason: nes(s: "only justification was x itself") },
  }
}

fn replaced_consumer() -> BoundaryConsumer {
  BoundaryConsumer {
    consumer: fixture_ref(name: "old dispatch client"), consumed_old_authority: fixture_authority(),
    disposition: ReplacedByY { new_authority: nes(s: "y boundary authority") },
  }
}

fn evidence_consumer() -> BoundaryConsumer {
  BoundaryConsumer {
    consumer: fixture_ref(name: "discriminating refusal witness"), consumed_old_authority: fixture_authority(),
    disposition: EvidenceOnly {
      surviving_claim: nes(s: "refusal y still claims"),
      reenrolled_witness: nes(s: "witness re-enrolled against y"),
    },
  }
}

fn dispositioned_evidence() -> List<EvidenceDisposition> {
  [
    ReenrollAgainstY {
      evidence: nes(s: "surviving discriminating witness"),
      surviving_claim: nes(s: "refusal y still claims"),
    },
    RetireEvidence {
      evidence: nes(s: "witness whose only subject was retired behavior"),
      retired_subject: nes(s: "behavior deliberately rejected by y"),
      retirement_reason: nes(s: "the subject claim is retired with the behavior"),
    },
  ]
}

fn typed_oracle() -> ExternalXAnswer {
  ExternalXRoles { roles: [ExternalDifferentialOracle, HistoricalMeasurementSource] }
}

fn two_region() -> List<DeclarationRef> { [fixture_ref(name: "x_root_module"), fixture_ref(name: "x_internal_helper")] }

fn cut_full(
  consumers: List<BoundaryConsumer>,
  region: List<DeclarationRef>,
  evidence: List<EvidenceDisposition>,
  new_root: String,
  oracle: ExternalXAnswer,
) -> ReplacementCut {
  ReplacementCut {
    identity: "cut-fixture" as ReplacementCutId,
    old_root_consumer: nes(s: "old floor step"),
    subject: nes(s: "exact subject population"),
    contract: nes(s: "complete contract including refusals"),
    new_root: nes(s: new_root),
    why_not_higher: OutermostBoundary,
    covered_region: region,
    boundary_census: ConsumersEnumerated { consumers: consumers },
    external_x: oracle,
    evidence_dispositions: evidence,
  }
}

fn cut_with(
  consumers: List<BoundaryConsumer>,
  region: List<DeclarationRef>,
  evidence: List<EvidenceDisposition>,
) -> ReplacementCut {
  cut_full(consumers: consumers, region: region, evidence: evidence, new_root: "new fold root", oracle: typed_oracle())
}

fn causes_of(admission: PlanAdmission) -> List<CutRefusalCause> {
  match admission {
    PlanAdmitted { admitted: _ } => []
    PlanRefused { causes: cs } => cs
  }
}

fn cause_matches(c: CutRefusalCause, tag: String, subject: String) -> Bool {
  match c {
    UndispositionedConsumer { consumer: w } => tag == "undispositioned-consumer" && declaration_ref_eq(a: w, b: fixture_ref(name: subject))
    UncoveredSurvivingConsumer { consumer: w } => tag == "uncovered-surviving" && declaration_ref_eq(a: w, b: fixture_ref(name: subject))
    UndispositionedEvidence { evidence: w } => tag == "undispositioned-evidence" && (w as String) == subject
    CoveredByOldRoot { consumer: w } => tag == "covered-by-old-root" && declaration_ref_eq(a: w, b: fixture_ref(name: subject))
    ReplacementNamesOldRoot { consumer: w } => tag == "replacement-names-old-root" && declaration_ref_eq(a: w, b: fixture_ref(name: subject))
    ConsumerDuplicated { consumer: w } => tag == "consumer-duplicated" && declaration_ref_eq(a: w, b: fixture_ref(name: subject))
    EvidenceDuplicated { evidence: w } => tag == "evidence-duplicated" && (w as String) == subject
    RegionMemberDuplicated { member: w } => tag == "region-member-duplicated" && declaration_ref_eq(a: w, b: fixture_ref(name: subject))
    EnumeratedCensusEmpty => tag == "enumerated-census-empty" && subject == ""
    ExternalRolesEnumeratedEmpty => tag == "external-roles-enumerated-empty" && subject == ""
    EmptyCoveredRegion => tag == "empty-covered-region" && subject == ""
    NewRootEqualsOldRoot => tag == "new-root-equals-old-root" && subject == ""
    SelfReferentialDescent => tag == "self-referential-descent" && subject == ""
  }
}

fn causes_include(causes: List<CutRefusalCause>, tag: String, subject: String) -> Bool {
  fold(causes, init: false, f: fn(acc, c) { acc || cause_matches(c: c, tag: tag, subject: subject) })
}

test fn fully_dispositioned_cut_admits_with_exact_counts() -> Bool {
  let admission = admit_replacement_cut_plan(cut: cut_with(
    consumers: [covered_consumer(), replaced_consumer(), evidence_consumer(), retired_consumer()],
    region: two_region(),
    evidence: dispositioned_evidence(),
  ))
  match admission {
    PlanAdmitted { admitted: a } =>
      a.retained_count == 1 && a.replaced_count == 1 && a.evidence_only_count == 1
        && a.retired_count == 1 && a.covered_region_count == 2
    PlanRefused { causes: _ } => false
  }
}

test fn admitted_verdict_is_bound_to_the_plan_it_judged() -> Bool {
  let plan = cut_with(
    consumers: [covered_consumer()],
    region: two_region(),
    evidence: dispositioned_evidence(),
  )
  let mutated = cut_with(
    consumers: [covered_consumer()],
    region: two_region(),
    evidence: [],
  )
  match admit_replacement_cut_plan(cut: plan) {
    PlanAdmitted { admitted: a } =>
      admitted_matches_plan(admitted: a, cut: plan) && !admitted_matches_plan(admitted: a, cut: mutated)
    PlanRefused { causes: _ } => false
  }
}

test fn undecided_consumer_blocks_the_cut() -> Bool {
  let causes = causes_of(admission: admit_replacement_cut_plan(cut: cut_with(
    consumers: [covered_consumer(), undecided_consumer()],
    region: two_region(),
    evidence: dispositioned_evidence(),
  )))
  list_length(items: causes) == 1
    && causes_include(causes: causes, tag: "undispositioned-consumer", subject: "undispositioned caller")
}

test fn surviving_consumer_without_coverage_refuses() -> Bool {
  let causes = causes_of(admission: admit_replacement_cut_plan(cut: cut_with(
    consumers: [open_consumer()],
    region: two_region(),
    evidence: dispositioned_evidence(),
  )))
  list_length(items: causes) == 1
    && causes_include(causes: causes, tag: "uncovered-surviving", subject: "surviving invariant consumer")
}

test fn undecided_evidence_blocks_the_cut() -> Bool {
  let causes = causes_of(admission: admit_replacement_cut_plan(cut: cut_with(
    consumers: [covered_consumer()],
    region: two_region(),
    evidence: [EvidenceUndecided { evidence: nes(s: "parked witness") }],
  )))
  list_length(items: causes) == 1
    && causes_include(causes: causes, tag: "undispositioned-evidence", subject: "parked witness")
}

test fn retired_consumer_needs_no_coverage() -> Bool {
  let admission = admit_replacement_cut_plan(cut: cut_with(
    consumers: [retired_consumer()],
    region: two_region(),
    evidence: dispositioned_evidence(),
  ))
  match admission {
    PlanAdmitted { admitted: a } =>
      a.retained_count == 0 && a.replaced_count == 0 && a.evidence_only_count == 0 && a.retired_count == 1
    PlanRefused { causes: _ } => false
  }
}

test fn a_cut_that_deletes_nothing_is_not_a_cut() -> Bool {
  let causes = causes_of(admission: admit_replacement_cut_plan(cut: cut_with(
    consumers: [covered_consumer()],
    region: [],
    evidence: dispositioned_evidence(),
  )))
  list_length(items: causes) == 1
    && causes_include(causes: causes, tag: "empty-covered-region", subject: "")
}

test fn every_cause_is_counted_not_first_wins() -> Bool {
  let causes = causes_of(admission: admit_replacement_cut_plan(cut: cut_with(
    consumers: [undecided_consumer(), open_consumer()],
    region: [],
    evidence: [EvidenceUndecided { evidence: nes(s: "parked witness") }],
  )))
  list_length(items: causes) == 4
    && causes_include(causes: causes, tag: "undispositioned-consumer", subject: "undispositioned caller")
    && causes_include(causes: causes, tag: "uncovered-surviving", subject: "surviving invariant consumer")
    && causes_include(causes: causes, tag: "undispositioned-evidence", subject: "parked witness")
    && causes_include(causes: causes, tag: "empty-covered-region", subject: "")
}

test fn new_root_equal_to_old_root_refuses() -> Bool {
  let causes = causes_of(admission: admit_replacement_cut_plan(cut: cut_full(
    consumers: [covered_consumer()],
    region: two_region(),
    evidence: dispositioned_evidence(),
    new_root: "old floor step",
    oracle: typed_oracle(),
  )))
  causes_include(causes: causes, tag: "new-root-equals-old-root", subject: "")
}

test fn coverage_by_the_old_root_is_fallback_wearing_a_disposition() -> Bool {
  let fallback_consumer = BoundaryConsumer {
    consumer: fixture_ref(name: "consumer leaning on x"), consumed_old_authority: fixture_authority(),
    disposition: RetainSameContract {
      justification: nes(s: "claims retention"),
      coverage: Covered { by: nes(s: "old floor step") },
    },
  }
  let causes = causes_of(admission: admit_replacement_cut_plan(cut: cut_with(
    consumers: [fallback_consumer],
    region: two_region(),
    evidence: dispositioned_evidence(),
  )))
  list_length(items: causes) == 1
    && causes_include(causes: causes, tag: "covered-by-old-root", subject: "consumer leaning on x")
}

test fn replacement_naming_the_old_root_refuses() -> Bool {
  let circular = BoundaryConsumer {
    consumer: fixture_ref(name: "circular client"), consumed_old_authority: fixture_authority(),
    disposition: ReplacedByY { new_authority: nes(s: "old floor step") },
  }
  let causes = causes_of(admission: admit_replacement_cut_plan(cut: cut_with(
    consumers: [circular],
    region: two_region(),
    evidence: dispositioned_evidence(),
  )))
  list_length(items: causes) == 1
    && causes_include(causes: causes, tag: "replacement-names-old-root", subject: "circular client")
}

test fn duplicate_consumer_refuses_even_when_dispositions_agree() -> Bool {
  let causes = causes_of(admission: admit_replacement_cut_plan(cut: cut_with(
    consumers: [retired_consumer(), retired_consumer()],
    region: two_region(),
    evidence: dispositioned_evidence(),
  )))
  list_length(items: causes) == 1
    && causes_include(causes: causes, tag: "consumer-duplicated", subject: "workaround built to compensate for x")
}

test fn duplicate_evidence_subject_refuses() -> Bool {
  let causes = causes_of(admission: admit_replacement_cut_plan(cut: cut_with(
    consumers: [covered_consumer()],
    region: two_region(),
    evidence: [
      ReenrollAgainstY { evidence: nes(s: "one witness"), surviving_claim: nes(s: "claim a") },
      RetireEvidence {
        evidence: nes(s: "one witness"),
        retired_subject: nes(s: "claim a"),
        retirement_reason: nes(s: "contradicts the reenroll row"),
      },
    ],
  )))
  list_length(items: causes) == 1
    && causes_include(causes: causes, tag: "evidence-duplicated", subject: "one witness")
}

test fn duplicate_region_member_refuses() -> Bool {
  let causes = causes_of(admission: admit_replacement_cut_plan(cut: cut_with(
    consumers: [covered_consumer()],
    region: [fixture_ref(name: "x_root_module"), fixture_ref(name: "x_root_module")],
    evidence: dispositioned_evidence(),
  )))
  list_length(items: causes) == 1
    && causes_include(causes: causes, tag: "region-member-duplicated", subject: "x_root_module")
}

test fn enumerated_empty_census_refuses_but_declared_empty_admits() -> Bool {
  let ambiguous = admit_replacement_cut_plan(cut: cut_with(
    consumers: [],
    region: two_region(),
    evidence: dispositioned_evidence(),
  ))
  let declared = ReplacementCut {
    identity: "cut-dead-region" as ReplacementCutId,
    old_root_consumer: nes(s: "old floor step"),
    subject: nes(s: "exact subject population"),
    contract: nes(s: "complete contract including refusals"),
    new_root: nes(s: "new fold root"),
    why_not_higher: OutermostBoundary,
    covered_region: two_region(),
    boundary_census: BoundaryDeclaredEmpty { basis: nes(s: "no live consumer reaches this region; census by execution") },
    external_x: NoExternalOracleRequired { justification: nes(s: "dead region needs no differential oracle") },
    evidence_dispositions: [],
  }
  causes_include(causes: causes_of(admission: ambiguous), tag: "enumerated-census-empty", subject: "")
    && (match admit_replacement_cut_plan(cut: declared) {
      PlanAdmitted { admitted: a } => a.retained_count == 0 && a.covered_region_count == 2
      PlanRefused { causes: _ } => false
    })
}

test fn empty_external_role_list_refuses_but_justified_no_oracle_admits() -> Bool {
  let ambiguous = admit_replacement_cut_plan(cut: cut_full(
    consumers: [covered_consumer()],
    region: two_region(),
    evidence: dispositioned_evidence(),
    new_root: "new fold root",
    oracle: ExternalXRoles { roles: [] },
  ))
  let justified = admit_replacement_cut_plan(cut: cut_full(
    consumers: [covered_consumer()],
    region: two_region(),
    evidence: dispositioned_evidence(),
    new_root: "new fold root",
    oracle: NoExternalOracleRequired { justification: nes(s: "boundary compared by construction, no differential run") },
  ))
  causes_include(causes: causes_of(admission: ambiguous), tag: "external-roles-enumerated-empty", subject: "")
    && list_length(items: causes_of(admission: ambiguous)) == 1
    && (match justified {
      PlanAdmitted { admitted: a } => a.covered_region_count == 2
      PlanRefused { causes: _ } => false
    })
}

test fn self_referential_descent_refuses() -> Bool {
  let cut = ReplacementCut {
    identity: "cut-self" as ReplacementCutId,
    old_root_consumer: nes(s: "b0 boundary"),
    subject: nes(s: "exact subject population"),
    contract: nes(s: "complete contract including refusals"),
    new_root: nes(s: "b1"),
    why_not_higher: DescendedFromRefusedCut {
      parent_cut: "cut-self" as ReplacementCutId,
      refusal_summary: nes(s: "claims its own refusal as license"),
    },
    covered_region: two_region(),
    boundary_census: ConsumersEnumerated { consumers: [covered_consumer()] },
    external_x: typed_oracle(),
    evidence_dispositions: [],
  }
  causes_include(causes: causes_of(admission: admit_replacement_cut_plan(cut: cut)), tag: "self-referential-descent", subject: "")
}

test fn descended_cut_names_its_parent_by_typed_identity() -> Bool {
  let cut = ReplacementCut {
    identity: "cut-b0" as ReplacementCutId,
    old_root_consumer: nes(s: "b0 boundary"),
    subject: nes(s: "exact subject population"),
    contract: nes(s: "complete contract including refusals"),
    new_root: nes(s: "b1"),
    why_not_higher: DescendedFromRefusedCut {
      parent_cut: "cut-a0" as ReplacementCutId,
      refusal_summary: nes(s: "escaping consumer q0 uncovered"),
    },
    covered_region: two_region(),
    boundary_census: ConsumersEnumerated { consumers: [covered_consumer()] },
    external_x: typed_oracle(),
    evidence_dispositions: [],
  }
  match cut.why_not_higher {
    DescendedFromRefusedCut { parent_cut: p, refusal_summary: r } =>
      (p as String) == "cut-a0" && (r as String) == "escaping consumer q0 uncovered"
    OutermostBoundary => false
    DescentParentUnauthored { intended_parent_boundary: _, basis: _ } => false
  }
}

fn is_admitted(a: PlanAdmission) -> Bool {
  match a {
    PlanAdmitted { admitted: _ } => true
    PlanRefused { causes: _ } => false
  }
}

fn cut_answering(identity: String, answer: HigherBoundaryAnswer) -> ReplacementCut {
  ReplacementCut {
    identity: identity as ReplacementCutId,
    old_root_consumer: nes(s: "b0 boundary"),
    subject: nes(s: "exact subject population"),
    contract: nes(s: "complete contract including refusals"),
    new_root: nes(s: "b1"),
    why_not_higher: answer,
    covered_region: two_region(),
    boundary_census: ConsumersEnumerated { consumers: [covered_consumer()] },
    external_x: typed_oracle(),
    evidence_dispositions: [],
  }
}

// The honest state a real first subject lands in: not outermost, and no cut has
// been authored at the boundary above. It admits, and it carries no identifier
// that could be mistaken for a resolvable join.
test fn unauthored_parent_boundary_admits_without_naming_an_id() -> Bool {
  let cut = cut_answering(
    identity: "cut-interpreter",
    answer: DescentParentUnauthored {
      intended_parent_boundary: nes(s: "the engine cut through the v1 driver region"),
      basis: nes(s: "no cut authored at that boundary by any lane"),
    },
  )
  is_admitted(a: admit_replacement_cut_plan(cut: cut))
    && match cut.why_not_higher {
      DescentParentUnauthored { intended_parent_boundary: b, basis: _ } =>
        (b as String) == "the engine cut through the v1 driver region"
      OutermostBoundary => false
      DescendedFromRefusedCut { parent_cut: _, refusal_summary: _ } => false
    }
}

// The new arm's self-reference: naming your own old root as the boundary above
// you is the same incoherence SelfReferentialDescent already names.
test fn descent_parent_unauthored_naming_its_own_root_refuses() -> Bool {
  let causes = causes_of(admission: admit_replacement_cut_plan(cut: cut_answering(
    identity: "cut-self-boundary",
    answer: DescentParentUnauthored {
      intended_parent_boundary: nes(s: "b0 boundary"),
      basis: nes(s: "claims the boundary it is cutting is also the boundary above it"),
    },
  )))
  list_length(items: causes) == 1
    && causes_include(causes: causes, tag: "self-referential-descent", subject: "")
}

// POSITIVE CONTROL for the two declared-gap probes below: admission is not
// vacuous. Without this, "it admits" carries no information.
test fn probe_control_refuses_undecided() -> Bool {
  !is_admitted(a: admit_replacement_cut_plan(cut: cut_with(
    consumers: [undecided_consumer()],
    region: two_region(),
    evidence: dispositioned_evidence(),
  )))
}

// DECLARED GAP, enrolled so it is counted rather than rediscovered: parent_cut
// is an unjoined reference and a parent that exists nowhere is admitted. This
// test asserts the gap. It goes RED when a cut registry makes the reference
// joinable -- which is the next-rung trigger firing, not a regression.
test fn probe_admits_nonexistent_parent() -> Bool {
  is_admitted(a: admit_replacement_cut_plan(cut: cut_answering(
    identity: "cut-b0",
    answer: DescendedFromRefusedCut {
      parent_cut: "cut-that-exists-nowhere-in-any-tree-zzz" as ReplacementCutId,
      refusal_summary: nes(s: "a parent never authored cannot have refused anything"),
    },
  )))
}

// SCOPE, not a gap: plan admission judges the authored plan's internal
// coherence, never the world, so a well-formed OutermostBoundary claim admits
// whether or not a higher boundary exists in fact.
test fn probe_admits_outermost_claim() -> Bool {
  is_admitted(a: admit_replacement_cut_plan(cut: cut_answering(
    identity: "cut-outermost",
    answer: OutermostBoundary,
  )))
}

// ---------------------------------------------------------------------------
// Relation-key controls. The boundary relation is consumer x consumed-authority,
// and these two are the pair that establishes it is really a PAIR: the same
// consumer twice under one authority is a duplicate, and the same consumer under
// two different authorities is not. Without the second, keying on the consumer
// alone would pass the first and let one disposition answer for two dependencies.
// ---------------------------------------------------------------------------

fn same_consumer_one_authority() -> List<BoundaryConsumer> {
  [
    BoundaryConsumer {
      consumer: fixture_ref(name: "shared caller"), consumed_old_authority: fixture_authority(),
      disposition: Retire { reason: nes(s: "leaves with x") },
    },
    BoundaryConsumer {
      consumer: fixture_ref(name: "shared caller"), consumed_old_authority: fixture_authority(),
      disposition: Retire { reason: nes(s: "leaves with x") },
    },
  ]
}

fn same_consumer_two_authorities() -> List<BoundaryConsumer> {
  [
    BoundaryConsumer {
      consumer: fixture_ref(name: "shared caller"), consumed_old_authority: fixture_authority(),
      disposition: Retire { reason: nes(s: "leaves with x") },
    },
    BoundaryConsumer {
      consumer: fixture_ref(name: "shared caller"), consumed_old_authority: other_authority(),
      disposition: Retire { reason: nes(s: "a different dependency of the same caller") },
    },
  ]
}

test fn one_consumer_twice_under_one_authority_is_a_duplicate() -> Bool {
  let causes = causes_of(admission: admit_replacement_cut_plan(cut: cut_with(
    consumers: same_consumer_one_authority(),
    region: two_region(),
    evidence: dispositioned_evidence(),
  )))
  causes_include(causes: causes, tag: "consumer-duplicated", subject: "shared caller")
}

test fn one_consumer_under_two_authorities_is_two_relations_not_a_duplicate() -> Bool {
  let causes = causes_of(admission: admit_replacement_cut_plan(cut: cut_with(
    consumers: same_consumer_two_authorities(),
    region: two_region(),
    evidence: dispositioned_evidence(),
  )))
  !causes_include(causes: causes, tag: "consumer-duplicated", subject: "shared caller")
}

// ---------------------------------------------------------------------------
// Registry controls. These fire the parent-existence rung that
// replacement_cut_unjoined_parent_rung_note declared, and they discriminate the
// three parent states rather than collapsing them into present/absent.
// ---------------------------------------------------------------------------

fn fixture_survey() -> LegacyReplacementSurvey {
  LegacyReplacementSurvey {
    old_root_consumer: nes(s: "coarse old root"),
    subject: nes(s: "coarse subject"),
    contract: nes(s: "coarse contract"),
    new_root: nes(s: "coarse new root"),
    why_not_higher: OutermostBoundary,
    covered_region_labels: [nes(s: "some module")],
    consumer_rows: [
      LegacyConsumerSurveyRow {
        consumer_label: nes(s: "some module or binary"),
        disposition: Retire { reason: nes(s: "recorded at module grain") },
      },
    ],
    external_x: NoExternalOracleRequired { justification: nes(s: "historical record only") },
    evidence_rows: [],
    measured_revision: nes(s: "deadbeef"),
    limitation: nes(s: "module-or-binary grain sample"),
  }
}

fn registration_admitting_cut(identity: String, parent: HigherBoundaryAnswer) -> CutRegistration {
  RegisteredExactCut {
    cut: ReplacementCut {
      identity: identity as ReplacementCutId,
      old_root_consumer: nes(s: "old floor step"),
      subject: nes(s: "exact subject population"),
      contract: nes(s: "complete contract including refusals"),
      new_root: nes(s: "new fold root"),
      why_not_higher: parent,
      covered_region: two_region(),
      boundary_census: ConsumersEnumerated { consumers: [retired_consumer()] },
      external_x: NoExternalOracleRequired { justification: nes(s: "no oracle needed") },
      evidence_dispositions: dispositioned_evidence(),
    },
  }
}

fn remeasure_registration(identity: String) -> CutRegistration {
  RegisteredCutRemeasureRequired {
    identity: identity as ReplacementCutId,
    prior_survey: fixture_survey(),
    reason: nes(s: "authored at a coarser grain than the exact carrier requires"),
  }
}

fn descends_from(parent: String) -> HigherBoundaryAnswer {
  DescendedFromRefusedCut {
    parent_cut: parent as ReplacementCutId,
    refusal_summary: nes(s: "parent boundary refused"),
  }
}

fn registry_causes(standing: CutRegistryStanding) -> List<CutRegistryRefusalCause> {
  match standing {
    CutRegistryAdmitted { exact_count: _, remeasure_required_count: _ } => []
    CutRegistryRefused { causes: cs } => cs
  }
}

fn registry_cause_matches(c: CutRegistryRefusalCause, tag: String, subject: String) -> Bool {
  match c {
    RegistryDuplicateCutId { identity: i } =>
      tag == "duplicate-id" && (i as String) == subject
    RegistryParentAbsent { cut: _, named_parent: p } =>
      tag == "parent-absent" && (p as String) == subject
    RegistryParentRemeasureRequired { cut: _, named_parent: p } =>
      tag == "parent-remeasure-required" && (p as String) == subject
  }
}

fn registry_includes(causes: List<CutRegistryRefusalCause>, tag: String, subject: String) -> Bool {
  fold(causes, init: false, f: fn(acc, c) { acc || registry_cause_matches(c: c, tag: tag, subject: subject) })
}

test fn a_registry_of_distinct_cuts_is_admitted_and_counts_both_arms() -> Bool {
  match admit_cut_registry(rs: [
    registration_admitting_cut(identity: "cut-a", parent: OutermostBoundary),
    remeasure_registration(identity: "cut-b"),
  ]) {
    CutRegistryAdmitted { exact_count: e, remeasure_required_count: r } => e == 1 && r == 1
    CutRegistryRefused { causes: _ } => false
  }
}

// THE RUNG THIS FIRES: before the registry, a branded string named any parent at all and the plan
// was admitted, sealed and digest-bound. This is the discriminating RED.
test fn a_parent_naming_no_registered_cut_refuses() -> Bool {
  let causes = registry_causes(standing: admit_cut_registry(rs: [
    registration_admitting_cut(identity: "cut-a", parent: descends_from(parent: "cut-that-exists-nowhere")),
  ]))
  registry_includes(causes: causes, tag: "parent-absent", subject: "cut-that-exists-nowhere")
}

// AND THE STATE BETWEEN present AND absent: descent claims the parent REFUSED, which a coarse
// survey cannot establish. Reporting this as ParentAbsent would say the boundary is unknown when it
// is merely unmeasured, and those have different remedies.
test fn a_parent_resolving_only_to_a_remeasurement_obligation_refuses_distinctly() -> Bool {
  let causes = registry_causes(standing: admit_cut_registry(rs: [
    registration_admitting_cut(identity: "cut-a", parent: descends_from(parent: "cut-legacy")),
    remeasure_registration(identity: "cut-legacy"),
  ]))
  registry_includes(causes: causes, tag: "parent-remeasure-required", subject: "cut-legacy")
    && !registry_includes(causes: causes, tag: "parent-absent", subject: "cut-legacy")
}

test fn a_parent_resolving_to_an_exact_cut_is_admitted() -> Bool {
  match admit_cut_registry(rs: [
    registration_admitting_cut(identity: "cut-a", parent: descends_from(parent: "cut-parent")),
    registration_admitting_cut(identity: "cut-parent", parent: OutermostBoundary),
  ]) {
    CutRegistryAdmitted { exact_count: e, remeasure_required_count: _ } => e == 2
    CutRegistryRefused { causes: _ } => false
  }
}

test fn an_exact_and_a_remeasurement_registration_sharing_an_id_refuse() -> Bool {
  let causes = registry_causes(standing: admit_cut_registry(rs: [
    registration_admitting_cut(identity: "cut-same", parent: OutermostBoundary),
    remeasure_registration(identity: "cut-same"),
  ]))
  registry_includes(causes: causes, tag: "duplicate-id", subject: "cut-same")
    && list_length(items: causes) == 1
}

// THE COUNT IS THE ASSERTION HERE, and it is enrolled because it was wrong before review caught it:
// the fold used to re-fire for every occurrence of a duplicated id, so three registrations sharing
// one identity produced three causes for one defect. `registry_includes` passed either way, which is
// exactly why a membership-only witness could not see it. One duplicated identity is one defect no
// matter how many rows carry it, so N rows yield N-1 causes and never N.
test fn a_duplicated_identity_yields_one_cause_per_extra_row_not_one_per_row() -> Bool {
  let two = registry_causes(standing: admit_cut_registry(rs: [
    registration_admitting_cut(identity: "cut-dup", parent: OutermostBoundary),
    remeasure_registration(identity: "cut-dup"),
  ]))
  let three = registry_causes(standing: admit_cut_registry(rs: [
    registration_admitting_cut(identity: "cut-dup", parent: OutermostBoundary),
    remeasure_registration(identity: "cut-dup"),
    remeasure_registration(identity: "cut-dup"),
  ]))
  list_length(items: two) == 1 && list_length(items: three) == 2
}

// DescentParentUnauthored stays truthful while no exact parent exists: it names a boundary and
// carries no id, so there is nothing for the registry to resolve and nothing to refuse.
test fn descent_parent_unauthored_needs_no_registered_parent() -> Bool {
  match admit_cut_registry(rs: [
    registration_admitting_cut(identity: "cut-a", parent: DescentParentUnauthored {
      intended_parent_boundary: nes(s: "an outer boundary nobody has authored"),
      basis: nes(s: "no cut is authored there"),
    }),
  ]) {
    CutRegistryAdmitted { exact_count: e, remeasure_required_count: r } => e == 1 && r == 0
    CutRegistryRefused { causes: _ } => false
  }
}
