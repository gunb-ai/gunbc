module test.claim.replacement_cut_witness

// Arrived on main carrying explicit imports, stripped on merge into the
// namespace cut. The rationale they carried -- that a module this new is in
// nobody else's closure, so bare references would not bind -- is exactly the
// pool-membership coincidence this lane removes: the closure is now derived
// from the references themselves, so a reference IS the dependency edge.

fn nes(s: String) -> NonEmptyStr { s as NonEmptyStr }

fn covered_consumer() -> BoundaryConsumer {
  BoundaryConsumer {
    consumer: nes(s: "surviving external interface"),
    disposition: RetainSameContract {
      justification: nes(s: "supported public surface"),
      coverage: Covered { by: nes(s: "new fold root") },
    },
  }
}

fn open_consumer() -> BoundaryConsumer {
  BoundaryConsumer {
    consumer: nes(s: "surviving invariant consumer"),
    disposition: RetainChangedContract {
      terminal_contract: nes(s: "narrowed terminal contract"),
      justification: nes(s: "invariant survives with narrower surface"),
      coverage: CoverageOpen,
    },
  }
}

fn undecided_consumer() -> BoundaryConsumer {
  BoundaryConsumer { consumer: nes(s: "undispositioned caller"), disposition: Undecided }
}

fn retired_consumer() -> BoundaryConsumer {
  BoundaryConsumer {
    consumer: nes(s: "workaround built to compensate for x"),
    disposition: Retire { reason: nes(s: "only justification was x itself") },
  }
}

fn replaced_consumer() -> BoundaryConsumer {
  BoundaryConsumer {
    consumer: nes(s: "old dispatch client"),
    disposition: ReplacedByY { new_authority: nes(s: "y boundary authority") },
  }
}

fn evidence_consumer() -> BoundaryConsumer {
  BoundaryConsumer {
    consumer: nes(s: "discriminating refusal witness"),
    disposition: EvidenceOnly {
      surviving_claim: nes(s: "refusal y still claims"),
      reenrolled_witness: nes(s: "witness re-enrolled against y"),
    },
  }
}

fn dispositioned_evidence() -> List<EvidenceDisposition> {
  [
    ReenrollAgainstY {
      evidence: nes(s: "surviving discriminating witness"),
      surviving_claim: nes(s: "refusal y still claims"),
    },
    RetireEvidence {
      evidence: nes(s: "witness whose only subject was retired behavior"),
      retired_subject: nes(s: "behavior deliberately rejected by y"),
      retirement_reason: nes(s: "the subject claim is retired with the behavior"),
    },
  ]
}

fn typed_oracle() -> ExternalXAnswer {
  ExternalXRoles { roles: [ExternalDifferentialOracle, HistoricalMeasurementSource] }
}

fn two_region() -> List<NonEmptyStr> { [nes(s: "x root module"), nes(s: "x internal helper")] }

fn cut_full(
  consumers: List<BoundaryConsumer>,
  region: List<NonEmptyStr>,
  evidence: List<EvidenceDisposition>,
  new_root: String,
  oracle: ExternalXAnswer,
) -> ReplacementCut {
  ReplacementCut {
    identity: "cut-fixture" as ReplacementCutId,
    old_root_consumer: nes(s: "old floor step"),
    subject: nes(s: "exact subject population"),
    contract: nes(s: "complete contract including refusals"),
    new_root: nes(s: new_root),
    why_not_higher: OutermostBoundary,
    covered_region: region,
    boundary_census: ConsumersEnumerated { consumers: consumers },
    external_x: oracle,
    evidence_dispositions: evidence,
  }
}

fn cut_with(
  consumers: List<BoundaryConsumer>,
  region: List<NonEmptyStr>,
  evidence: List<EvidenceDisposition>,
) -> ReplacementCut {
  cut_full(consumers: consumers, region: region, evidence: evidence, new_root: "new fold root", oracle: typed_oracle())
}

fn causes_of(admission: PlanAdmission) -> List<CutRefusalCause> {
  match admission {
    PlanAdmitted { admitted: _ } => []
    PlanRefused { causes: cs } => cs
  }
}

fn cause_matches(c: CutRefusalCause, tag: String, subject: String) -> Bool {
  match c {
    UndispositionedConsumer { consumer: w } => tag == "undispositioned-consumer" && (w as String) == subject
    UncoveredSurvivingConsumer { consumer: w } => tag == "uncovered-surviving" && (w as String) == subject
    UndispositionedEvidence { evidence: w } => tag == "undispositioned-evidence" && (w as String) == subject
    CoveredByOldRoot { consumer: w } => tag == "covered-by-old-root" && (w as String) == subject
    ReplacementNamesOldRoot { consumer: w } => tag == "replacement-names-old-root" && (w as String) == subject
    ConsumerDuplicated { consumer: w } => tag == "consumer-duplicated" && (w as String) == subject
    EvidenceDuplicated { evidence: w } => tag == "evidence-duplicated" && (w as String) == subject
    RegionMemberDuplicated { member: w } => tag == "region-member-duplicated" && (w as String) == subject
    EnumeratedCensusEmpty => tag == "enumerated-census-empty" && subject == ""
    ExternalRolesEnumeratedEmpty => tag == "external-roles-enumerated-empty" && subject == ""
    EmptyCoveredRegion => tag == "empty-covered-region" && subject == ""
    NewRootEqualsOldRoot => tag == "new-root-equals-old-root" && subject == ""
    SelfReferentialDescent => tag == "self-referential-descent" && subject == ""
  }
}

fn causes_include(causes: List<CutRefusalCause>, tag: String, subject: String) -> Bool {
  fold(causes, init: false, f: fn(acc, c) { acc || cause_matches(c: c, tag: tag, subject: subject) })
}

test fn fully_dispositioned_cut_admits_with_exact_counts() -> Bool {
  let admission = admit_replacement_cut_plan(cut: cut_with(
    consumers: [covered_consumer(), replaced_consumer(), evidence_consumer(), retired_consumer()],
    region: two_region(),
    evidence: dispositioned_evidence(),
  ))
  match admission {
    PlanAdmitted { admitted: a } =>
      a.retained_count == 1 && a.replaced_count == 1 && a.evidence_only_count == 1
        && a.retired_count == 1 && a.covered_region_count == 2
    PlanRefused { causes: _ } => false
  }
}

test fn admitted_verdict_is_bound_to_the_plan_it_judged() -> Bool {
  let plan = cut_with(
    consumers: [covered_consumer()],
    region: two_region(),
    evidence: dispositioned_evidence(),
  )
  let mutated = cut_with(
    consumers: [covered_consumer()],
    region: two_region(),
    evidence: [],
  )
  match admit_replacement_cut_plan(cut: plan) {
    PlanAdmitted { admitted: a } =>
      admitted_matches_plan(admitted: a, cut: plan) && !admitted_matches_plan(admitted: a, cut: mutated)
    PlanRefused { causes: _ } => false
  }
}

test fn undecided_consumer_blocks_the_cut() -> Bool {
  let causes = causes_of(admission: admit_replacement_cut_plan(cut: cut_with(
    consumers: [covered_consumer(), undecided_consumer()],
    region: two_region(),
    evidence: dispositioned_evidence(),
  )))
  list_length(items: causes) == 1
    && causes_include(causes: causes, tag: "undispositioned-consumer", subject: "undispositioned caller")
}

test fn surviving_consumer_without_coverage_refuses() -> Bool {
  let causes = causes_of(admission: admit_replacement_cut_plan(cut: cut_with(
    consumers: [open_consumer()],
    region: two_region(),
    evidence: dispositioned_evidence(),
  )))
  list_length(items: causes) == 1
    && causes_include(causes: causes, tag: "uncovered-surviving", subject: "surviving invariant consumer")
}

test fn undecided_evidence_blocks_the_cut() -> Bool {
  let causes = causes_of(admission: admit_replacement_cut_plan(cut: cut_with(
    consumers: [covered_consumer()],
    region: two_region(),
    evidence: [EvidenceUndecided { evidence: nes(s: "parked witness") }],
  )))
  list_length(items: causes) == 1
    && causes_include(causes: causes, tag: "undispositioned-evidence", subject: "parked witness")
}

test fn retired_consumer_needs_no_coverage() -> Bool {
  let admission = admit_replacement_cut_plan(cut: cut_with(
    consumers: [retired_consumer()],
    region: two_region(),
    evidence: dispositioned_evidence(),
  ))
  match admission {
    PlanAdmitted { admitted: a } =>
      a.retained_count == 0 && a.replaced_count == 0 && a.evidence_only_count == 0 && a.retired_count == 1
    PlanRefused { causes: _ } => false
  }
}

test fn a_cut_that_deletes_nothing_is_not_a_cut() -> Bool {
  let causes = causes_of(admission: admit_replacement_cut_plan(cut: cut_with(
    consumers: [covered_consumer()],
    region: [],
    evidence: dispositioned_evidence(),
  )))
  list_length(items: causes) == 1
    && causes_include(causes: causes, tag: "empty-covered-region", subject: "")
}

test fn every_cause_is_counted_not_first_wins() -> Bool {
  let causes = causes_of(admission: admit_replacement_cut_plan(cut: cut_with(
    consumers: [undecided_consumer(), open_consumer()],
    region: [],
    evidence: [EvidenceUndecided { evidence: nes(s: "parked witness") }],
  )))
  list_length(items: causes) == 4
    && causes_include(causes: causes, tag: "undispositioned-consumer", subject: "undispositioned caller")
    && causes_include(causes: causes, tag: "uncovered-surviving", subject: "surviving invariant consumer")
    && causes_include(causes: causes, tag: "undispositioned-evidence", subject: "parked witness")
    && causes_include(causes: causes, tag: "empty-covered-region", subject: "")
}

test fn new_root_equal_to_old_root_refuses() -> Bool {
  let causes = causes_of(admission: admit_replacement_cut_plan(cut: cut_full(
    consumers: [covered_consumer()],
    region: two_region(),
    evidence: dispositioned_evidence(),
    new_root: "old floor step",
    oracle: typed_oracle(),
  )))
  causes_include(causes: causes, tag: "new-root-equals-old-root", subject: "")
}

test fn coverage_by_the_old_root_is_fallback_wearing_a_disposition() -> Bool {
  let fallback_consumer = BoundaryConsumer {
    consumer: nes(s: "consumer leaning on x"),
    disposition: RetainSameContract {
      justification: nes(s: "claims retention"),
      coverage: Covered { by: nes(s: "old floor step") },
    },
  }
  let causes = causes_of(admission: admit_replacement_cut_plan(cut: cut_with(
    consumers: [fallback_consumer],
    region: two_region(),
    evidence: dispositioned_evidence(),
  )))
  list_length(items: causes) == 1
    && causes_include(causes: causes, tag: "covered-by-old-root", subject: "consumer leaning on x")
}

test fn replacement_naming_the_old_root_refuses() -> Bool {
  let circular = BoundaryConsumer {
    consumer: nes(s: "circular client"),
    disposition: ReplacedByY { new_authority: nes(s: "old floor step") },
  }
  let causes = causes_of(admission: admit_replacement_cut_plan(cut: cut_with(
    consumers: [circular],
    region: two_region(),
    evidence: dispositioned_evidence(),
  )))
  list_length(items: causes) == 1
    && causes_include(causes: causes, tag: "replacement-names-old-root", subject: "circular client")
}

test fn duplicate_consumer_refuses_even_when_dispositions_agree() -> Bool {
  let causes = causes_of(admission: admit_replacement_cut_plan(cut: cut_with(
    consumers: [retired_consumer(), retired_consumer()],
    region: two_region(),
    evidence: dispositioned_evidence(),
  )))
  list_length(items: causes) == 1
    && causes_include(causes: causes, tag: "consumer-duplicated", subject: "workaround built to compensate for x")
}

test fn duplicate_evidence_subject_refuses() -> Bool {
  let causes = causes_of(admission: admit_replacement_cut_plan(cut: cut_with(
    consumers: [covered_consumer()],
    region: two_region(),
    evidence: [
      ReenrollAgainstY { evidence: nes(s: "one witness"), surviving_claim: nes(s: "claim a") },
      RetireEvidence {
        evidence: nes(s: "one witness"),
        retired_subject: nes(s: "claim a"),
        retirement_reason: nes(s: "contradicts the reenroll row"),
      },
    ],
  )))
  list_length(items: causes) == 1
    && causes_include(causes: causes, tag: "evidence-duplicated", subject: "one witness")
}

test fn duplicate_region_member_refuses() -> Bool {
  let causes = causes_of(admission: admit_replacement_cut_plan(cut: cut_with(
    consumers: [covered_consumer()],
    region: [nes(s: "x root module"), nes(s: "x root module")],
    evidence: dispositioned_evidence(),
  )))
  list_length(items: causes) == 1
    && causes_include(causes: causes, tag: "region-member-duplicated", subject: "x root module")
}

test fn enumerated_empty_census_refuses_but_declared_empty_admits() -> Bool {
  let ambiguous = admit_replacement_cut_plan(cut: cut_with(
    consumers: [],
    region: two_region(),
    evidence: dispositioned_evidence(),
  ))
  let declared = ReplacementCut {
    identity: "cut-dead-region" as ReplacementCutId,
    old_root_consumer: nes(s: "old floor step"),
    subject: nes(s: "exact subject population"),
    contract: nes(s: "complete contract including refusals"),
    new_root: nes(s: "new fold root"),
    why_not_higher: OutermostBoundary,
    covered_region: two_region(),
    boundary_census: BoundaryDeclaredEmpty { basis: nes(s: "no live consumer reaches this region; census by execution") },
    external_x: NoExternalOracleRequired { justification: nes(s: "dead region needs no differential oracle") },
    evidence_dispositions: [],
  }
  causes_include(causes: causes_of(admission: ambiguous), tag: "enumerated-census-empty", subject: "")
    && (match admit_replacement_cut_plan(cut: declared) {
      PlanAdmitted { admitted: a } => a.retained_count == 0 && a.covered_region_count == 2
      PlanRefused { causes: _ } => false
    })
}

test fn empty_external_role_list_refuses_but_justified_no_oracle_admits() -> Bool {
  let ambiguous = admit_replacement_cut_plan(cut: cut_full(
    consumers: [covered_consumer()],
    region: two_region(),
    evidence: dispositioned_evidence(),
    new_root: "new fold root",
    oracle: ExternalXRoles { roles: [] },
  ))
  let justified = admit_replacement_cut_plan(cut: cut_full(
    consumers: [covered_consumer()],
    region: two_region(),
    evidence: dispositioned_evidence(),
    new_root: "new fold root",
    oracle: NoExternalOracleRequired { justification: nes(s: "boundary compared by construction, no differential run") },
  ))
  causes_include(causes: causes_of(admission: ambiguous), tag: "external-roles-enumerated-empty", subject: "")
    && list_length(items: causes_of(admission: ambiguous)) == 1
    && (match justified {
      PlanAdmitted { admitted: a } => a.covered_region_count == 2
      PlanRefused { causes: _ } => false
    })
}

test fn self_referential_descent_refuses() -> Bool {
  let cut = ReplacementCut {
    identity: "cut-self" as ReplacementCutId,
    old_root_consumer: nes(s: "b0 boundary"),
    subject: nes(s: "exact subject population"),
    contract: nes(s: "complete contract including refusals"),
    new_root: nes(s: "b1"),
    why_not_higher: DescendedFromRefusedCut {
      parent_cut: "cut-self" as ReplacementCutId,
      refusal_summary: nes(s: "claims its own refusal as license"),
    },
    covered_region: two_region(),
    boundary_census: ConsumersEnumerated { consumers: [covered_consumer()] },
    external_x: typed_oracle(),
    evidence_dispositions: [],
  }
  causes_include(causes: causes_of(admission: admit_replacement_cut_plan(cut: cut)), tag: "self-referential-descent", subject: "")
}

test fn descended_cut_names_its_parent_by_typed_identity() -> Bool {
  let cut = ReplacementCut {
    identity: "cut-b0" as ReplacementCutId,
    old_root_consumer: nes(s: "b0 boundary"),
    subject: nes(s: "exact subject population"),
    contract: nes(s: "complete contract including refusals"),
    new_root: nes(s: "b1"),
    why_not_higher: DescendedFromRefusedCut {
      parent_cut: "cut-a0" as ReplacementCutId,
      refusal_summary: nes(s: "escaping consumer q0 uncovered"),
    },
    covered_region: two_region(),
    boundary_census: ConsumersEnumerated { consumers: [covered_consumer()] },
    external_x: typed_oracle(),
    evidence_dispositions: [],
  }
  match cut.why_not_higher {
    DescendedFromRefusedCut { parent_cut: p, refusal_summary: r } =>
      (p as String) == "cut-a0" && (r as String) == "escaping consumer q0 uncovered"
    OutermostBoundary => false
  }
}
