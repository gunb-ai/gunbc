module test.claim.stage0_rust_source_lifecycle_scaffold_witness

import gunbc.stage0_rust_source_lifecycle_scaffold {
  ManifestStateScaffoldOk,
  ManifestStateScaffoldRefused,
  MeasuredClaimsUnclassified,
  MeasuredCountInconsistent,
  MeasuredHandMaintainedGrew,
  MeasuredNewlyUnclassified,
  RustManifestMeasured,
  RustManifestUnmeasured,
  UnmeasuredTrackedManifest,
  behavioral_oracle_carrier_ref,
  classified_residue_disjoint_holds,
  derived_cargo_bin_paths_disjoint_from_residue_holds,
  derived_cargo_bin_paths_in_authority_join_holds,
  derived_generated_hand_disjoint_holds,
  derived_generated_stage0_repo_paths,
  duplicate_exact_paths_zero_holds,
  file_grain_paths_avoid_discovery_prefix_holds,
  generated_authority_subset_of_derived_holds,
  generated_repo_paths_cover_authority_holds,
  generated_stage0_files_authority_ref,
  lifecycle_row_well_formed,
  lifecycle_row_well_formed_query_scaffold,
  list_paths_all_unique,
  manifest_state_verdict_scaffold_holds,
  partition_crate_paths_complete_holds,
  path_occurrence_count,
  residue_row,
  rust_source_manifest_state,
  rust_source_manifest_state_verdict,
  rust_source_manifest_state_verdict_query_scaffold,
  stage0_cargo_bin_manifest_authority_ref,
  stage0_rust_lifecycle_scaffold_join_mechanical_checks_holds,
  stage0_rust_lifecycle_scaffold_mechanical_checks_holds,
  stage0_rust_source_lifecycle_scaffold_note
}
import gunbc.stage0_emit_model { generated_stage0_file_count }
import std.disposition { Scaffold, SingleAuthority }
import v2.std.algebra { length }
import v2.std.text { String }

data stage0_rust_source_lifecycle_scaffold_witness_note: String = "Stage0 lifecycle SCAFFOLD witnesses: honest interim instrument; RustSourceManifestState queries consume rust_source_manifest_state_verdict (review 44325 predicate dissolution)."

test fn scaffold_note_declares_scaffold_not_live_instrument() -> Bool {
  string_contains(s: stage0_rust_source_lifecycle_scaffold_note, pattern: "SCAFFOLD")
    && string_contains(s: stage0_rust_source_lifecycle_scaffold_note, pattern: "NOT the live ZeroHandMaintainedRust")
}

test fn scaffold_manifest_state_verdict_query_is_scaffold_disposition() -> Bool {
  match rust_source_manifest_state_verdict_query_scaffold {
    Scaffold { dissolves_to: SingleAuthority, bind: _ } => true
    _ => false
  }
}

test fn scaffold_lifecycle_row_well_formed_query_is_scaffold_disposition() -> Bool {
  match lifecycle_row_well_formed_query_scaffold {
    Scaffold { dissolves_to: SingleAuthority, bind: _ } => true
    _ => false
  }
}

test fn scaffold_manifest_state_defaults_unmeasured() -> Bool {
  match rust_source_manifest_state {
    RustManifestUnmeasured { awaiting: _ } => true
    _ => false
  }
}

test fn scaffold_manifest_state_default_verdict_refuses_unmeasured() -> Bool {
  match rust_source_manifest_state_verdict(state: rust_source_manifest_state) {
    ManifestStateScaffoldRefused { cause: UnmeasuredTrackedManifest { awaiting: _ } } => true
    ManifestStateScaffoldOk => false
    ManifestStateScaffoldRefused { cause: _ } => false
  }
}

test fn scaffold_join_mechanical_checks_holds() -> Bool {
  stage0_rust_lifecycle_scaffold_join_mechanical_checks_holds()
}

test fn scaffold_mechanical_checks_red_while_manifest_unmeasured() -> Bool {
  !stage0_rust_lifecycle_scaffold_mechanical_checks_holds()
    && !manifest_state_verdict_scaffold_holds()
}

test fn scaffold_generated_paths_match_authority_count_holds() -> Bool {
  length(xs: derived_generated_stage0_repo_paths()) == generated_stage0_file_count()
}

test fn w_scaffold_generated_hand_disjoint_holds() -> Bool {
  derived_generated_hand_disjoint_holds()
}

test fn scaffold_classified_residue_disjoint_holds() -> Bool {
  classified_residue_disjoint_holds()
}

test fn scaffold_generated_authority_bidirectional_holds() -> Bool {
  generated_repo_paths_cover_authority_holds() && generated_authority_subset_of_derived_holds()
}

test fn scaffold_partition_crate_paths_complete_holds() -> Bool {
  partition_crate_paths_complete_holds()
}

test fn scaffold_duplicate_exact_paths_zero_holds() -> Bool {
  duplicate_exact_paths_zero_holds()
}

test fn scaffold_file_grain_avoids_discovery_prefix_holds() -> Bool {
  file_grain_paths_avoid_discovery_prefix_holds()
}

test fn scaffold_cargo_manifest_ref_populated_holds() -> Bool {
  stage0_cargo_bin_manifest_authority_ref.module_path == "v1_compiler.cli_run"
    && stage0_cargo_bin_manifest_authority_ref.decl_name == "stage0_cargo_bin_repo_paths_from_manifest"
}

test fn scaffold_cargo_bins_in_authority_join_holds() -> Bool {
  derived_cargo_bin_paths_in_authority_join_holds()
}

test fn scaffold_cargo_bins_disjoint_from_residue_holds() -> Bool {
  derived_cargo_bin_paths_disjoint_from_residue_holds()
}

test fn scaffold_authority_refs_populated_holds() -> Bool {
  !(generated_stage0_files_authority_ref.module_path == "")
    && behavioral_oracle_carrier_ref.decl_name == "compiler_module_behavioral_transport_roster"
}

test fn scaffold_measured_ratchet_red_control_newly_unclassified_reds() -> Bool {
  match rust_source_manifest_state_verdict(
    state: RustManifestMeasured {
      tracked_count: 1,
      classified_file_grain_count: 1,
      unclassified_count: 0,
      newly_unclassified: 1,
      stale_lifecycle_rows: 0,
      duplicate_exact_paths: 0,
      hand_maintained_count: 0,
      hand_maintained_prior_count: 0
    }
  ) {
    ManifestStateScaffoldRefused { cause: MeasuredNewlyUnclassified { count: _ } } => true
    _ => false
  }
}

test fn scaffold_measured_ratchet_red_control_hand_maintained_growth_reds() -> Bool {
  match rust_source_manifest_state_verdict(
    state: RustManifestMeasured {
      tracked_count: 1,
      classified_file_grain_count: 1,
      unclassified_count: 0,
      newly_unclassified: 0,
      stale_lifecycle_rows: 0,
      duplicate_exact_paths: 0,
      hand_maintained_count: 2,
      hand_maintained_prior_count: 1
    }
  ) {
    ManifestStateScaffoldRefused { cause: MeasuredHandMaintainedGrew { prior: _, current: _ } } => true
    _ => false
  }
}

test fn scaffold_unmeasured_cannot_claim_zero_unclassified_red_control() -> Bool {
  match rust_source_manifest_state_verdict(
    state: RustManifestMeasured {
      tracked_count: 1,
      classified_file_grain_count: 0,
      unclassified_count: 1,
      newly_unclassified: 0,
      stale_lifecycle_rows: 0,
      duplicate_exact_paths: 0,
      hand_maintained_count: 0,
      hand_maintained_prior_count: 0
    }
  ) {
    ManifestStateScaffoldRefused { cause: MeasuredClaimsUnclassified { count: _ } } => true
    _ => false
  }
}

test fn scaffold_measured_ratchet_red_control_inconsistent_counts_reds() -> Bool {
  match rust_source_manifest_state_verdict(
    state: RustManifestMeasured {
      tracked_count: 0,
      classified_file_grain_count: 1,
      unclassified_count: 0,
      newly_unclassified: 0,
      stale_lifecycle_rows: 0,
      duplicate_exact_paths: 0,
      hand_maintained_count: 0,
      hand_maintained_prior_count: 0
    }
  ) {
    ManifestStateScaffoldRefused { cause: MeasuredCountInconsistent { tracked: _, classified: _, unclassified: _ } } =>
      true
    _ => false
  }
}

test fn scaffold_residue_red_control_empty_dissolve_on_reds() -> Bool {
  !lifecycle_row_well_formed(
    row: residue_row(
      path: "synthetic/unclassified.rs",
      reason: "red control",
      dissolve_on: ""
    )
  )
}

test fn scaffold_residue_red_control_duplicate_path_reds() -> Bool {
  let paths = [
    "src/v1/stage0/src/bootstrap_stage0_crate_layout_generated.rs",
    "src/v1/stage0/src/bootstrap_stage0_crate_layout_generated.rs"
  ]
  !list_paths_all_unique(paths: paths)
    && path_occurrence_count(
      paths: paths,
      needle: "src/v1/stage0/src/bootstrap_stage0_crate_layout_generated.rs"
    ) == 2
}
