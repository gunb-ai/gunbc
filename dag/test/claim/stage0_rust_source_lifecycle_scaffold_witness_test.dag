module test.claim.stage0_rust_source_lifecycle_scaffold_witness

data stage0_rust_source_lifecycle_scaffold_witness_note: String = "Stage0 lifecycle scaffold witnesses after the PR B host activation. The live observation must inhabit RustManifestObserved with path evidence; typed host refusals remain distinct inputs to the existing verdict. The lifecycle classification is still an honest scaffold and may remain red on the repository-wide unclassified population."

test fn scaffold_note_declares_scaffold_not_live_instrument() -> Bool {
  string_contains(s: gunbc.stage0_rust_source_lifecycle_scaffold.stage0_rust_source_lifecycle_scaffold_note, pattern: "SCAFFOLD")
    && string_contains(s: gunbc.stage0_rust_source_lifecycle_scaffold.stage0_rust_source_lifecycle_scaffold_note, pattern: "NOT the live ZeroHandMaintainedRust")
}

test fn scaffold_manifest_state_verdict_query_is_scaffold_disposition() -> Bool {
  match gunbc.stage0_rust_source_lifecycle_scaffold.rust_source_manifest_state_verdict_query_scaffold {
    Scaffold { dissolves_to: std.disposition.SingleAuthority, bind: _ } => true
    _ => false
  }
}

test fn scaffold_lifecycle_row_well_formed_query_is_scaffold_disposition() -> Bool {
  match gunbc.stage0_rust_source_lifecycle_scaffold.lifecycle_row_well_formed_query_scaffold {
    Scaffold { dissolves_to: std.disposition.SingleAuthority, bind: _ } => true
    _ => false
  }
}

test fn scaffold_note_cites_zero_hand_maintained_rust_roadmap_row() -> Bool {
  string_contains(s: gunbc.stage0_rust_source_lifecycle_scaffold.stage0_rust_source_lifecycle_scaffold_note, pattern: "observation prerequisite")
    && string_contains(s: gunbc.stage0_rust_source_lifecycle_scaffold.stage0_rust_source_lifecycle_scaffold_note, pattern: "v1-honest-frontier")
}


test fn scaffold_host_observation_hand_rust_receipt_is_bounded() -> Bool {
  let refs = gunbc.stage0_rust_host_observation.stage0_rust_observation_seed_growth_justification.hand_authored_declarations
  let named = refs |> map(r => r.decl_name)
  let expected = [
    "Stage0CargoManifestBinParse",
    "Stage0CargoBinManifestParseRefusal",
    "stage0_cargo_bin_paths_from_manifest_text",
    "parse_stage0_cargo_manifest_bin_paths",
    "stage0_cargo_manifest_parser_tests",
    "eval_builtin_inner"
  ]
  v2.std.algebra.length(xs: refs) == 6
    && string_contains(
      s: gunbc.stage0_rust_host_observation.stage0_rust_observation_seed_growth_justification.reason,
      pattern: "impl std::fmt::Display for Stage0CargoBinManifestParseRefusal"
    )
    && (refs |> all(r => !(r.module_path == "") && !(r.decl_name == "")))
    && (expected |> all(e => named |> v2.std.algebra.any(n => n == e)))
    && gunbc.stage0_rust_host_observation.stage0_rust_observation_seed_growth_justification.owning_dissolution_lane as String == "v1-hand-queue-drain"
    && match gunbc.stage0_rust_host_observation.stage0_cargo_manifest_parser_seed_scaffold {
      Scaffold { dissolves_to: std.disposition.RealizationDispatch, bind: bind } =>
        bind.module_path == "v1_compiler.cli_run"
          && bind.decl_name == "parse_stage0_cargo_manifest_bin_paths"
      _ => false
    }
    && match gunbc.stage0_rust_host_observation.stage0_cargo_manifest_projection_seed_scaffold {
      Scaffold { dissolves_to: std.disposition.RealizationDispatch, bind: bind } =>
        bind.module_path == "v1_compiler.v1_interpreter"
          && bind.decl_name == "eval_builtin_inner"
      _ => false
    }
}


