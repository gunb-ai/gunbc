test fn scaffold_disposition_population_excludes_exactly_the_registry_overlap_paths() -> Bool {
  let disposition_count = length(xs: derived_hand_maintained_disposition_repo_paths())
  let layout_count = length(xs: derived_hand_maintained_stage0_repo_paths())
  let overlap_count = length(xs: generated_artifact_layout_overlap_repo_paths())
  disposition_count == layout_count - overlap_count
}
