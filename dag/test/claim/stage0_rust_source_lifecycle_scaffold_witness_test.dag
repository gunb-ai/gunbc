test fn scaffold_disposition_population_excludes_exactly_the_registry_overlap_paths() -> Bool {
  let disposition_count = v2.std.algebra.length(xs: gunbc.stage0_rust_source_lifecycle_scaffold.derived_hand_maintained_disposition_repo_paths())
  let layout_count = v2.std.algebra.length(xs: gunbc.stage0_rust_source_lifecycle_scaffold.derived_hand_maintained_stage0_repo_paths())
  let overlap_count = v2.std.algebra.length(xs: gunbc.stage0_rust_source_lifecycle_scaffold.generated_artifact_layout_overlap_repo_paths())
  disposition_count == layout_count - overlap_count
}

data w_generated_derivation_probe_tracked: std.types.List<String> = [
  "src/v1/stage0/src/cli_run.rs",
  "src/v1/stage0/src/v1_interpreter_dispatch_generated.rs",
  "src/v1/stage0/src/cssl_seed_linked_closure_assembly.rs",
  "src/v1/stage0/src/w_probe_emitted_module.rs",
  "src/v1/stage0/src/module_path_index/index.rs",
  "src/v1/stage0/tests/w_probe_harness.rs",
  "src/v1/stage0/src/w_probe_not_rust.toml"
]

test fn scaffold_generated_population_is_the_unclaimed_direct_children_of_the_stage0_root() -> Bool {
  gunbc.stage0_rust_source_lifecycle_scaffold.derived_generated_stage0_repo_paths(tracked_paths: w_generated_derivation_probe_tracked)
    == ["src/v1/stage0/src/w_probe_emitted_module.rs"]
}

test fn scaffold_generated_population_responds_to_the_observed_tree() -> Bool {
  v2.std.algebra.length(xs: gunbc.stage0_rust_source_lifecycle_scaffold.derived_generated_stage0_repo_paths(tracked_paths: [])) == 0
    && v2.std.algebra.length(
      xs: gunbc.stage0_rust_source_lifecycle_scaffold.derived_generated_stage0_repo_paths(
        tracked_paths: w_generated_derivation_probe_tracked
      )
    ) == 1
}

test fn scaffold_generated_population_is_disjoint_from_every_claiming_authority() -> Bool {
  !v2.std.algebra.any(
    xs: gunbc.stage0_rust_source_lifecycle_scaffold.derived_generated_stage0_repo_paths(
      tracked_paths: w_generated_derivation_probe_tracked
    ),
    predicate: fn(path) {
      gunbc.stage0_rust_source_lifecycle_scaffold.path_in_list(path: path, paths: gunbc.stage0_rust_source_lifecycle_scaffold.derived_hand_maintained_stage0_repo_paths())
        || path_in_list(path: path, paths: gunbc.stage0_rust_source_lifecycle_scaffold.generated_artifact_stage0_src_repo_paths())
        || path_in_list(path: path, paths: gunbc.stage0_rust_source_lifecycle_scaffold.residue_lifecycle_repo_paths())
    }
  )
}
