test fn scaffold_disposition_population_excludes_exactly_the_registry_overlap_paths() -> Bool {
  let disposition_count = length(xs: derived_hand_maintained_disposition_repo_paths())
  let layout_count = length(xs: derived_hand_maintained_stage0_repo_paths())
  let overlap_count = length(xs: generated_artifact_layout_overlap_repo_paths())
  disposition_count == layout_count - overlap_count
}

// The discriminating RED for DerivedUnclassifiedTracked, and its arm-separating control.
//
// These two use the SAME planted path and differ only in whether it is also in
// prior_tracked_rust_repo_paths. That is the entire difference between the two unclassified arms,
// so a single fold that collapsed them -- or a reordering that let the newly arm swallow the
// standing one -- turns exactly one of these red. Before this pair, no executing input reached
// DerivedUnclassifiedTracked at all: every constructor added its extra path to tracked alone, and
// count_newly_unclassified_tracked is checked first.
// The planted path is deliberately NOT a direct child of src/v1/stage0/src/.
//
// #8674 derives the generated population as the COMPLEMENT of the claiming rosters over direct
// children of the stage0 src root (derived_generated_stage0_repo_paths -> stage0_src_direct_child_rust_path
// && !claimed). So a planted direct child is classified GENERATED by construction, and can never
// reach either unclassified arm -- which is what turned this pair red on the #8674 merge. Planting
// under stage0/tests keeps the path genuinely unclaimed by every roster, which is the condition
// these two witnesses exist to discriminate. It is also a real family: the 026a709a71 live
// measurement put 14 of its 137 unclassified paths under src/v1/stage0/tests.
data standing_unclassified_planted_path: String = "src/v1/stage0/tests/planted_standing_unclassified.rs"

test fn scaffold_standing_unclassified_reds_on_derived_unclassified_tracked() -> Bool {
  match rust_source_manifest_state_verdict(
    observation: witness_standing_unclassified_observation(
      planted_path: standing_unclassified_planted_path
    )
  ) {
    ManifestStateScaffoldRefused { cause: DerivedUnclassifiedTracked { count: count } } => count == 1
    _ => false
  }
}

test fn scaffold_same_planted_path_when_new_reaches_the_newly_arm_instead() -> Bool {
  match rust_source_manifest_state_verdict(
    observation: witness_observation_covering_lifecycle_plus_extra(
      extra_path: standing_unclassified_planted_path
    )
  ) {
    ManifestStateScaffoldRefused { cause: DerivedNewlyUnclassified { count: count } } => count == 1
    _ => false
  }
}

// The rung declaration is a machine-consumed fact about what this carrier does and does not
// guarantee, so it is asserted rather than left as prose someone can quietly soften. The three
// figures below are the executed measurement the row rests on; if the row is edited to claim a
// climb it did not make, this goes red.
test fn scaffold_unclassified_axis_rung_is_declared_with_measurement_and_trigger() -> Bool {
  string_contains(s: unclassified_axis_rung_note, pattern: "RUNG DROP, DECLARED")
    && string_contains(s: unclassified_axis_rung_note, pattern: "DECLARED RUNG: mitigatable")
    && string_contains(s: unclassified_axis_rung_note, pattern: "UNCLASSIFIED=137")
    && string_contains(s: unclassified_axis_rung_note, pattern: "026a709a71636d60df325f9183b78febff22901d")
    && string_contains(s: unclassified_axis_rung_note, pattern: "NEXT-RUNG TRIGGER")
    && string_contains(s: unclassified_axis_rung_note, pattern: "executing consumer")
    && !(dissolution_description(condition: unclassified_axis_rung_restoration) == "")
}

// THESE THREE PROBES ASSERTED THE COMPLEMENT DERIVATION AND ARE REWRITTEN, NOT DELETED. They
// tested #8674's rule -- "a direct child of the stage0 root that no authority claims IS
// generated" -- which was a property of PATH SHAPE. The generated population is now what the
// emitter DECLARED it produced, so the same three questions get asked of the declaration: does it
// intersect the observed tree, does it respond to the declaration rather than to path shape, and
// does a direct child the emitter did not declare stay unclassified. The last is the one the rung
// drop had to give up and is the reason this PR exists.
data w_generated_derivation_probe_tracked: List<String> = [
  "src/v1/stage0/src/cli_run.rs",
  "src/v1/stage0/src/v1_interpreter_dispatch_generated.rs",
  "src/v1/stage0/src/cssl_seed_linked_closure_assembly.rs",
  "src/v1/stage0/src/w_probe_emitted_module.rs",
  "src/v1/stage0/src/w_probe_unregistered_hand_file.rs",
  "src/v1/stage0/src/module_path_index/index.rs",
  "src/v1/stage0/tests/w_probe_harness.rs"
]

// The declaration names one path IN the tree and one path that is NOT, so the intersection is
// observable rather than incidental.
data w_generated_derivation_probe_declared: List<String> = [
  "src/v1/stage0/src/w_probe_emitted_module.rs",
  "src/v1/stage0/src/w_probe_declared_but_absent_from_tree.rs"
]

test fn scaffold_generated_population_is_the_declaration_intersected_with_the_observed_tree() -> Bool {
  derived_generated_stage0_repo_paths(
    emitted_stage0_repo_paths: w_generated_derivation_probe_declared,
    tracked_paths: w_generated_derivation_probe_tracked
  ) == ["src/v1/stage0/src/w_probe_emitted_module.rs"]
}

test fn scaffold_generated_population_responds_to_the_declaration_not_to_path_shape() -> Bool {
  length(
    xs: derived_generated_stage0_repo_paths(
      emitted_stage0_repo_paths: [],
      tracked_paths: w_generated_derivation_probe_tracked
    )
  ) == 0
    && length(
      xs: derived_generated_stage0_repo_paths(
        emitted_stage0_repo_paths: w_generated_derivation_probe_declared,
        tracked_paths: w_generated_derivation_probe_tracked
      )
    ) == 1
}

// THE DISCRIMINATING CASE THE RUNG DROP GAVE UP. `w_probe_unregistered_hand_file.rs` is a direct
// child of the stage0 source root that no authority claims. Under the complement it was
// "generated" by definition and could never surface; under the declaration the emitter does not
// name it, so it is not generated -- which is what lets DerivedNewlyUnclassified fire on a direct
// child again. The probe is the same tracked list as above, so a regression that reinstated the
// complement would turn this red while leaving the two tests above green.
test fn scaffold_unregistered_direct_child_is_not_generated_under_the_declaration() -> Bool {
  !path_in_list(
    path: "src/v1/stage0/src/w_probe_unregistered_hand_file.rs",
    paths: derived_generated_stage0_repo_paths(
      emitted_stage0_repo_paths: w_generated_derivation_probe_declared,
      tracked_paths: w_generated_derivation_probe_tracked
    )
  )
}
