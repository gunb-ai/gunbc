// #8674'S DECLARED RUNG DROP IS DISSOLVED HERE, AND THE BLOCK THAT DECLARED IT IS DELETED RATHER
// THAN AMENDED. It read, in part: "RESTORATION TRIGGER the observation carrier gains the
// emitted-path population (the same set required_regen_host generated_basenames_from_emit already
// computes), at which point the subject returns to a direct child and this block deletes." That
// trigger has fired. `v1.compiler.emit_rust` now declares its produced population at rest
// (`src/v1/stage0/src/emitted_population.rs`), `gunbc.stage0_rust_host_observation` reads it at
// the revision, and `derived_generated_stage0_repo_paths` selects the tracked paths that
// declaration names instead of taking the complement of the crate-layout claim.
//
// So the two controls below are back on a DIRECT CHILD of `src/v1/stage0/src/`, which is the
// subject the drop had to give up: under the complement a direct child nobody claimed was
// "generated" by definition, and the refusal could never fire on it again. Under the declaration
// a path the emitter did not produce is unclassified wherever it sits.
// THE NEW REFUSAL GETS ITS OWN DISCRIMINATING RED, because a refusal arm with no executing
// evidence is the specification-without-execution trap DESIGN 5 names, and this one guards the
// exact deficit #8674's rung drop was declared over. If the emitted-population manifest cannot be
// read, this module cannot separate "the emitter produces this" from "nobody registered this",
// and the honest answer is a typed, located, countable line-stop -- NOT a quiet fall back to the
// crate-layout complement, which would reinstate the deficit while reporting a verdict and zero
// its own firing rate by construction.
//
// The discriminating pair is the same observation differing in ONE field: with the evidence
// unobserved it refuses on that cause; with the identical tracked list and a confirmed population
// naming it, it does not. So the control fails if the arm is deleted AND if the arm is widened to
// fire on anything else.
data emit_evidence_probe_tracked: List<String> = ["src/v1/stage0/src/cli_run.rs"]

fn emit_evidence_probe_observation(evidence: EmitPopulationEvidence) -> RustSourceHostObservation {
  RustManifestObserved {
    repository_revision: "deadbeef",
    manifest_content_identity: Fnv1a64Structural { digest: "abc1230000000000" },
    tracked_rust_repo_paths: emit_evidence_probe_tracked,
    prior_tracked_rust_repo_paths: emit_evidence_probe_tracked,
    cargo_bin_repo_paths: ["src/v1/stage0/src/main.rs"],
    emit_population_evidence: evidence
  }
}

test fn scaffold_unobserved_emit_population_refuses_rather_than_falling_back() -> Bool {
  match rust_source_manifest_state_verdict(
    observation: emit_evidence_probe_observation(
      evidence: EmitPopulationUnobserved { detail: "probe: manifest unreadable at revision" }
    )
  ) {
    ManifestStateScaffoldRefused { cause: EmitPopulationUnobservedEvidence { detail: detail } } =>
      detail == "probe: manifest unreadable at revision"
    _ => false
  }
}

test fn scaffold_confirmed_emit_population_does_not_take_the_unobserved_arm() -> Bool {
  match rust_source_manifest_state_verdict(
    observation: emit_evidence_probe_observation(
      evidence: EmitPopulationConfirmed { emitted_stage0_repo_paths: emit_evidence_probe_tracked }
    )
  ) {
    ManifestStateScaffoldRefused { cause: EmitPopulationUnobservedEvidence { detail: _ } } => false
    _ => true
  }
}

