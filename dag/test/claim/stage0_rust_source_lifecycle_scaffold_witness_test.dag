test fn scaffold_residue_red_control_duplicate_path_reds() -> Bool {
  let paths = [
    "src/v1/stage0/src/bootstrap_stage0_crate_layout_generated.rs",
    "src/v1/stage0/src/bootstrap_stage0_crate_layout_generated.rs"
  ]
  !gunbc.stage0_rust_source_lifecycle_scaffold.list_paths_all_unique(paths: paths)
    && std.keyed_roster.path_occurrence_count(
      paths: paths,
      target: "src/v1/stage0/src/bootstrap_stage0_crate_layout_generated.rs"
    ) == 2
}

