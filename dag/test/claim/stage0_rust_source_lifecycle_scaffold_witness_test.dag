// Constructs the empty condition through the NON-LITERAL path deliberately.
// The literal form `unbound_dissolution(description: "")` is now refused at
// compile (the parameter is NonEmptyStr), which is the wall. Refinement at
// non-literal positions is still deferred, so that gap is exactly what the
// downstream well-formedness guard defends -- and this control has to reach it
// through the gap in order to keep proving the guard works (DESIGN 4b(4):
// production machinery dissolves on a climb, the evidence stays enrolled).
fn synthetic_nonliteral_text(text: String) -> std.types.NonEmptyStr {
  concat(text, "")
}

fn synthetic_empty_condition(text: String) -> std.dissolution.DissolutionCondition {
  unbound_dissolution(description: synthetic_nonliteral_text(text: text))
}

test fn scaffold_residue_red_control_empty_dissolve_on_reds() -> Bool {
  !lifecycle_row_well_formed(
    row: gunbc.stage0_rust_source_lifecycle_scaffold.residue_row(
      path: "synthetic/unclassified.rs",
      reason: "red control",
      dissolution: synthetic_empty_condition(text: "")
    )
  )
}

