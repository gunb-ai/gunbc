// THE SUBJECT PATH OF THE NEXT TWO RED CONTROLS MOVED INTO A SUBDIRECTORY, AND THAT IS A
// DECLARED RUNG DROP, NOT A FIXTURE TIDY-UP. Both formerly used a direct child of the stage0
// source root (`unclassified.rs`, `synthetic_untracked.rs`) to prove that a tracked path no
// authority names refuses as DerivedNewlyUnclassified. With the generated population derived as
// the complement of the crate-layout claim, a direct child nobody claims is now GENERATED by
// definition, so that exact subject can no longer refuse here and both controls went red on the
// floor. Declared per DESIGN 4b(3): PREVIOUS RUNG mechanically preventable for any tracked stage0
// path; TEMPORARY RUNG mechanically preventable for every tracked path EXCEPT a direct child of
// src/v1/stage0/src/; REASON no at-rest .dag fact carries the emit population, so this module
// cannot separate "the emitter produces this" from "nobody registered this"; BOUNDED POPULATION
// direct children of the stage0 source root only -- subdirectories, other src/v1 trees and
// dag/tools are unaffected, which is why the controls stay executing rather than being deleted;
// COVERED MEANWHILE by claim_executor --required-regen, whose committed_not_emitted refusal
// decides exactly the dropped population against the real emit and is enrolled in witnesses.yml;
// RESTORATION TRIGGER the observation carrier gains the emitted-path population (the same set
// required_regen_host generated_basenames_from_emit already computes), at which point the
// subject returns to a direct child and this block deletes.
test fn scaffold_observed_ratchet_red_control_newly_unclassified_reds() -> Bool {
  match rust_source_manifest_state_verdict(
    observation: RustManifestObserved {
      repository_revision: "deadbeef",
      manifest_content_identity: Fnv1a64Structural { digest: "abc1230000000000" },
      tracked_rust_repo_paths: [
        "src/v1/stage0/src/module_path_index/unclassified.rs",
        "src/v1/stage0/src/cli_run.rs",
        "src/v1/stage0/src/main.rs"
      ],
      prior_tracked_rust_repo_paths: [
        "src/v1/stage0/src/cli_run.rs",
        "src/v1/stage0/src/main.rs"
      ],
      cargo_bin_repo_paths: ["src/v1/stage0/src/main.rs"]
    }
  ) {
    ManifestStateScaffoldRefused { cause: DerivedNewlyUnclassified { count: _ } } => true
    _ => false
  }
}

