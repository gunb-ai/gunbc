// ORDER UPDATED, NOT WEAKENED. This is a list equality, so it asserts the derived ORDER as well
// as the membership, and the order is a projection of the registration families in
// v2.compiler.self_host.stage0_crate_layout: the overlap is a filter over
// derived_hand_maintained_stage0_repo_paths, which follows hand_maintained_stage0_filenames.
// v1_interpreter_dispatch_generated moved from the scaffold family to the wet-actuator family
// where its actual producer lives, which puts it after bootstrap rather than before it. Membership
// and count are unchanged. The equality is kept rather than relaxed to a set comparison because
// the ordering IS derived and deterministic, so asserting it catches strictly more; a set
// comparison here would be a quieter assertion bought with no fact.
test fn scaffold_generated_artifact_layout_overlap_repo_paths_is_exactly_v1_interpreter_dispatch() -> Bool {
  generated_artifact_layout_overlap_repo_paths() == [bootstrap_stage0_crate_layout_generated_repo_path, v1_interpreter_dispatch_generated_repo_path]
}

