test fn scaffold_v1_interpreter_dispatch_generated_disposition_is_emit_from_generated_artifact_emit_authority() -> Bool {
  any(
    xs: generated_artifact_stage0_src_disposition_rows(),
    predicate: fn(row) {
      row.path == v1_interpreter_dispatch_generated_repo_path
        && length(xs: row.maintenance_dispositions) == 1
        && any(
          xs: row.maintenance_dispositions,
          predicate: fn(disposition) {
            match disposition {
              EmitFrom { authority: authority } =>
                authority.module_path == "gunbc.generated_artifact_emit"
                  && authority.decl_name == "artifact_generate"
              _ => false
            }
          }
        )
    }
  )
}

