test fn scaffold_note_cites_zero_hand_maintained_rust_roadmap_row() -> Bool {
  string_contains(s: stage0_rust_source_lifecycle_scaffold_note, pattern: "observation prerequisite")
    && string_contains(s: stage0_rust_source_lifecycle_scaffold_note, pattern: "v1-honest-frontier")
}


test fn scaffold_host_observation_hand_rust_receipt_is_bounded() -> Bool {
  let refs = stage0_rust_observation_seed_growth_justification.hand_authored_declarations
  let named = refs |> map(r => r.decl_name)
  let expected = [
    "Stage0CargoManifestBinParse",
    "Stage0CargoBinManifestParseRefusal",
    "stage0_cargo_bin_paths_from_manifest_text",
    "parse_stage0_cargo_manifest_bin_paths",
    "stage0_cargo_manifest_parser_tests",
    "eval_builtin_inner"
  ]
  length(xs: refs) == 6
    && string_contains(
      s: stage0_rust_observation_seed_growth_justification.reason,
      pattern: "impl std::fmt::Display for Stage0CargoBinManifestParseRefusal"
    )
    && (refs |> all(r => !(r.module_path == "") && !(r.decl_name == "")))
    && (expected |> all(e => named |> any(n => n == e)))
    && stage0_rust_observation_seed_growth_justification.owning_dissolution_lane as String == "v1-hand-queue-drain"
    && match stage0_cargo_manifest_parser_seed_scaffold {
      Scaffold { dissolves_to: RealizationDispatch, bind: bind } =>
        bind.module_path == "v1_compiler.cli_run"
          && bind.decl_name == "parse_stage0_cargo_manifest_bin_paths"
      _ => false
    }
    && match stage0_cargo_manifest_projection_seed_scaffold {
      Scaffold { dissolves_to: RealizationDispatch, bind: bind } =>
        bind.module_path == "v1_compiler.v1_interpreter"
          && bind.decl_name == "eval_builtin_inner"
      _ => false
    }
}


