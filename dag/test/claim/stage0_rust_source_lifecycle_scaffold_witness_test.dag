test fn scaffold_observed_ratchet_red_control_newly_unclassified_reds() -> Bool {
  match rust_source_manifest_state_verdict(
    observation: gunbc.stage0_rust_host_observation.RustManifestObserved {
      repository_revision: "deadbeef",
      manifest_content_identity: std.content_hash.Fnv1a64Structural { digest: "abc1230000000000" },
      tracked_rust_repo_paths: [
        "src/v1/stage0/src/unclassified.rs",
        "src/v1/stage0/src/cli_run.rs",
        "src/v1/stage0/src/main.rs"
      ],
      prior_tracked_rust_repo_paths: [
        "src/v1/stage0/src/cli_run.rs",
        "src/v1/stage0/src/main.rs"
      ],
      cargo_bin_repo_paths: ["src/v1/stage0/src/main.rs"]
    }
  ) {
    ManifestStateScaffoldRefused { cause: DerivedNewlyUnclassified { count: _ } } => true
    _ => false
  }
}

