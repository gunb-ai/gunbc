module test.claim.fleet_host_assembly_witness

import std.types { Bool, String }
import product.placement_supply {
  ChassisContainsHost,
  HostContainsComponent,
  PhysicalContainment,
  RackContainsPlacement,
  RoomContainsRack,
  SiteContainsRoom,
  physical_asset_identity_eq,
}
import gunbc.fleet_host_assembly {
  chassis_srv1,
  chassis_srv2,
  srv_assembly_components,
  srv_assembly_containments,
  board_srv1,
  processor_srv1,
  ComponentAcquiredFromLot,
  ComponentAcquisitionUnrecorded,
  every_board_component_is_from_the_four_board_lot,
  every_cooler_component_is_from_its_lot,
  every_recorded_component_lot_is_admitted,
  assembly_covers_component_roster,
  assembly_containments_join,
}
import gunbc.fleet_intent_network { operator_host_srv2, operator_host_srv3, operator_host_srv4 }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn first_containment_is_chassis(c: PhysicalContainment) -> Bool {
  match c {
    ChassisContainsHost { chassis: _, host: _ } => true
    SiteContainsRoom { site: _, room: _ } => false
    RoomContainsRack { room: _, rack: _ } => false
    RackContainsPlacement { rack: _, asset: _ } => false
    HostContainsComponent { host: _, component: _ } => false
  }
}

test fn w_every_srv_component_purchase_is_an_obligation() -> Bool {
  every_recorded_component_lot_is_admitted(rows: srv_assembly_components)
    && every_board_component_is_from_the_four_board_lot(rows: srv_assembly_components)
    && every_cooler_component_is_from_its_lot(rows: srv_assembly_components)
    && assembly_covers_component_roster(rows: srv_assembly_components)
    && assembly_containments_join(rows: srv_assembly_components, containments: srv_assembly_containments)
    && match srv_assembly_containments.first() {
      Absent => false
      Present { value: c } => first_containment_is_chassis(c: c)
    }
}

// THE CHASSIS EDGE MUST BE THE RIGHT EDGE, not merely present. Admitting ChassisContainsHost in
// the row fold could have been a hole: a fold that accepts "some chassis edge exists anywhere"
// would pass a roster whose chassis is bound to the WRONG host. This varies exactly that - the
// real containments discharge, and a containment list whose srv1 chassis edge names srv2's host
// does not.
test fn w_a_chassis_edge_to_the_wrong_host_does_not_discharge() -> Bool {
  assembly_containments_join(rows: srv_assembly_components, containments: srv_assembly_containments)
    && !assembly_containments_join(
      rows: srv_assembly_components,
      containments: [
        ChassisContainsHost { chassis: chassis_srv1, host: operator_host_srv2 },
        ChassisContainsHost { chassis: chassis_srv2, host: operator_host_srv2 },
        ChassisContainsHost { chassis: chassis_srv3, host: operator_host_srv3 },
        ChassisContainsHost { chassis: chassis_srv4, host: operator_host_srv4 },
      ]
    )
}

test fn w_omitting_a_rostered_component_refuses_cover() -> Bool {
  assembly_covers_component_roster(rows: srv_assembly_components)
    && !assembly_covers_component_roster(rows: srv_assembly_components.skip(n: 1))
}

test fn w_boards_and_processors_are_present() -> Bool {
  srv_assembly_components.any(row => physical_asset_identity_eq(a: row.component, b: board_srv1))
    && srv_assembly_components.any(row => physical_asset_identity_eq(a: row.component, b: processor_srv1))
    && srv_assembly_components.all(row => match row.acquisition {
      ComponentAcquiredFromLot { lot: _ } => true
      ComponentAcquisitionUnrecorded { read_obligation: o } => (o as String).length() > 0
    })
}
