// WHAT THESE WITNESSES COVER AND WHAT THEY DO NOT, stated first because the gap is the reason to
// read them carefully. The subject is the PURE half of gunbc.repo_ruleset: the desired
// declaration, the wire projections, and the divergence fold turning an observation into a
// verdict. Every one runs over values authored in this file, so they are SubstrateInputsOnly and
// execute in the hermetic floor.
//
// THEY SAY NOTHING ABOUT THE LIVE RULESET. Whether GitHub's ruleset currently agrees with desired
// is a fact about the world, answerable only by the read gunbc.repo_ruleset `verify` performs, and
// a witness asserting it from here would assert a value it never observed. That read was executed
// by hand while landing this change -- green against the live ruleset, and RED with a planted
// extra desired context, refusing with `required context missing:` and exit 1 -- and it is a route
// somebody runs, not a gate, as the module's own annotation says. Conflating the two would be the
// rung inflation DESIGN section 4b forbids: these witnesses establish that the verdict fold is
// correct, never that the ruleset is.

// THE FACT THE WHOLE CHANGE EXISTS FOR. If this ever goes red, the required context and the job
// that publishes it have forked, which is the failure that leaves a check permanently pending
// rather than red.
test fn w_the_one_required_context_is_the_aggregation_job() -> Bool {
  length(desired_required_contexts()) == 1
    && any(desired_required_contexts(), c => c == witness_floor_workflow_job_id)
}

// THE PUT IS WHOLE-RULESET, SO THE DESIRED RULES MUST CARRY THE BRANCH PROTECTIONS TOO. A desired
// roster that named only the status-check rule would DELETE deletion and non_fast_forward on the
// first apply -- silently, with a 200 -- so this is a negative about what an apply would destroy,
// not a restatement of the declaration.
test fn w_desired_rules_carry_the_history_protections_as_well_as_the_gate() -> Bool {
  let rules = desired_ruleset_rules()
  length(rules) == 4
    && any(rules, r => r.type == "deletion")
    && any(rules, r => r.type == "non_fast_forward")
    && any(rules, r => r.type == "required_status_checks")
    && any(rules, r => r.type == "merge_queue")
}

// THE CONTEXT IS PINNED TO THE APP THAT PUBLISHES IT. Without the integration id any actor with
// commit-status write could publish a green check under this context name.
test fn w_the_required_context_is_pinned_to_the_actions_app() -> Bool {
  match required_status_check_standing(rules: desired_ruleset_rules()) {
    RequiredStatusChecks { contexts: c, strict: s, do_not_enforce_on_create: d } =>
      length(c) == 1
        && s == desired_strict_required_status_checks_policy
        && d == desired_do_not_enforce_on_create
    _ => false
  }
  && all(
       filter(desired_ruleset_rules(), r => r.type == "required_status_checks"),
       r => all(match r.parameters.required_status_checks {
         Present { value: checks } => checks
         Absent => []
       }, chk => chk.integration_id == github_actions_app_integration_id))
}

// THE CONDITION TARGETS THE DEFAULT BRANCH BY ALIAS, NOT BY NAME. A literal branch name here would
// fork with the repository's own default_branch and go quiet the day it is renamed.
test fn w_the_condition_names_the_default_branch_alias() -> Bool {
  let conds = desired_ruleset_conditions()
  length(conds.ref_name.include) == 1
    && any(conds.ref_name.include, i => i == default_branch_ref_alias)
    && length(conds.ref_name.exclude) == 0
}

fn desired_shaped_standing() -> RequiredStatusCheckStanding {
  required_status_check_standing(rules: desired_ruleset_rules())
}

fn divergences_against_desired(
  name: String,
  enforcement: RulesetEnforcement,
  target: RulesetTarget,
  bypass: ReaderBypassStanding,
  include: List<String>,
  exclude: List<String>,
  rule_types: List<RulesetRuleType>,
  standing: RequiredStatusCheckStanding,
  merge_queue: MergeQueueStanding,
) -> List<RulesetDivergence> {
  observed_ruleset_divergences_for(
    goal: desired_repo_ruleset_goal(),
    name: name,
    enforcement: enforcement,
    target: target,
    bypass: bypass,
    include: include,
    exclude: exclude,
    rule_types: rule_types,
    standing: standing,
    merge_queue: merge_queue,
  )
}

fn divergences_of_desired_shaped_observation() -> List<RulesetDivergence> {
  divergences_against_desired(
    name: gunbc_passing_ci_ruleset_name,
    enforcement: RulesetActive,
    target: BranchTarget,
    bypass: ThisReaderCannotBypass,
    include: [default_branch_ref_alias],
    exclude: [],
    rule_types: desired_ruleset_rule_types(),
    standing: desired_shaped_standing(),
    merge_queue: desired_merge_queue_standing(),
  )
}

// THE POSITIVE CONTROL. An observation shaped exactly like desired must produce NO divergences --
// without it, every red below would be equally produced by a fold that refuses everything.
test fn w_a_desired_shaped_observation_diverges_in_nothing() -> Bool {
  length(divergences_of_desired_shaped_observation()) == 0
}

// THE DISCRIMINATING REDS, one per way the required context can stop gating. Each perturbs ONE
// field of the observation the positive control above passes, so a green here is a claim about
// that field rather than about the fold being non-empty.
test fn w_RED_enforcement_below_active_is_a_divergence() -> Bool {
  length(divergences_against_desired(
    name: gunbc_passing_ci_ruleset_name,
    enforcement: RulesetEvaluate,
    target: BranchTarget,
    bypass: ThisReaderCannotBypass,
    include: [default_branch_ref_alias],
    exclude: [],
    rule_types: desired_ruleset_rule_types(),
    standing: desired_shaped_standing(),
    merge_queue: desired_merge_queue_standing(),
  )) == 1
}

fn divergences_for_bypass(bypass: ReaderBypassStanding) -> List<RulesetDivergence> {
  divergences_against_desired(
    name: gunbc_passing_ci_ruleset_name,
    enforcement: RulesetActive,
    target: BranchTarget,
    bypass: bypass,
    include: [default_branch_ref_alias],
    exclude: [],
    rule_types: desired_ruleset_rule_types(),
    standing: desired_shaped_standing(),
    merge_queue: desired_merge_queue_standing(),
  )
}

test fn w_RED_a_reader_that_may_bypass_is_a_divergence() -> Bool {
  length(divergences_for_bypass(bypass: ThisReaderCanBypassAlways)) == 1
    && length(divergences_for_bypass(bypass: ThisReaderCanBypassPullRequestsOnly)) == 1
}

// THE THREE NON-`never` STANDINGS DO NOT RENDER ALIKE, the assertion review 56496's finding
// needed: before the split, all three produced one static sentence, so a witness counting
// divergences stayed green over the collapse. Counting is what a wildcard defeats; DISCRIMINATING
// catches it. The two documented grants must name WHICH grant, and an unrecognized standing must
// carry the raw string GitHub sent -- the only thing that says what to extend the parser with, and
// a static sentence discards it.
test fn w_RED_the_three_non_never_bypass_standings_render_differently() -> Bool {
  let always = render_divergences(ds: divergences_for_bypass(bypass: ThisReaderCanBypassAlways))
  let prs = render_divergences(ds: divergences_for_bypass(bypass: ThisReaderCanBypassPullRequestsOnly))
  let unknown = render_divergences(ds: divergences_for_bypass(
    bypass: UnrecognizedReaderBypassStanding { raw: "some_new_standing" },
  ))
  string_contains(s: always, pattern: "always")
    && string_contains(s: prs, pattern: "pull_requests_only")
    && always != prs
    && string_contains(s: unknown, pattern: "some_new_standing")
    && string_contains(s: unknown, pattern: "unrecognized")
    && !string_contains(s: unknown, pattern: "may bypass")
    && length(divergences_for_bypass(bypass: UnrecognizedReaderBypassStanding { raw: "x" })) == 1
}

// AN EXTRA REQUIRED CONTEXT IS DRIFT IN THE ADDITIVE DIRECTION, which is the half an Ensured
// ownership would have been blind to. "witnesses is the ONE required context" is a claim about
// the roster, not only about membership.
test fn w_RED_an_extra_required_context_is_a_divergence() -> Bool {
  let extra = required_status_check_standing(rules: [
    required_status_checks_rule(
      checks: [
        required_status_check_row(
          context: witness_floor_workflow_job_id,
          integration_id: github_actions_app_integration_id,
        ),
        required_status_check_row(
          context: "some-other-context",
          integration_id: github_actions_app_integration_id,
        ),
      ],
      strict: desired_strict_required_status_checks_policy,
      do_not_enforce_on_create: desired_do_not_enforce_on_create,
    ),
  ])
  let ds = divergences_against_desired(
    name: gunbc_passing_ci_ruleset_name,
    enforcement: RulesetActive,
    target: BranchTarget,
    bypass: ThisReaderCannotBypass,
    include: [default_branch_ref_alias],
    exclude: [],
    rule_types: desired_ruleset_rule_types(),
    standing: extra,
    merge_queue: desired_merge_queue_standing(),
  )
  length(ds) == 1 && string_contains(s: render_divergences(ds: ds), pattern: "some-other-context")
}

// NO STATUS-CHECK RULE AT ALL AND AN EMPTY CONTEXT ROSTER MUST NOT RENDER ALIKE. This is the
// empty-observation narrow: both would be [] under a projection that returned a bare roster, and
// only one of them means "the ruleset lost the rule that gates".
test fn w_RED_an_absent_status_check_rule_is_its_own_divergence() -> Bool {
  let ds = divergences_against_desired(
    name: gunbc_passing_ci_ruleset_name,
    enforcement: RulesetActive,
    target: BranchTarget,
    bypass: ThisReaderCannotBypass,
    include: [default_branch_ref_alias],
    exclude: [],
    rule_types: filter(desired_ruleset_rule_types(), t => ruleset_rule_type_wire_label(t: t) != "required_status_checks"),
    standing: NoRequiredStatusChecksRule,
    merge_queue: desired_merge_queue_standing(),
  )
  let empty_roster = divergences_against_desired(
    name: gunbc_passing_ci_ruleset_name,
    enforcement: RulesetActive,
    target: BranchTarget,
    bypass: ThisReaderCannotBypass,
    include: [default_branch_ref_alias],
    exclude: [],
    rule_types: desired_ruleset_rule_types(),
    standing: required_status_check_standing(rules: [
      required_status_checks_rule(
        checks: [],
        strict: desired_strict_required_status_checks_policy,
        do_not_enforce_on_create: desired_do_not_enforce_on_create,
      ),
    ]),
    merge_queue: desired_merge_queue_standing(),
  )
  string_contains(s: render_divergences(ds: ds), pattern: "no required_status_checks rule")
    && string_contains(s: render_divergences(ds: ds), pattern: "rule absent: required_status_checks")
    && !string_contains(s: render_divergences(ds: empty_roster), pattern: "no required_status_checks rule")
    && string_contains(s: render_divergences(ds: empty_roster), pattern: "required context missing")
}

// MORE THAN ONE STATUS-CHECK RULE IS A REFUSAL, NOT A MERGE. Two rules means the upstream shape
// moved and this module's reading of which roster gates is no longer established.
test fn w_RED_two_status_check_rules_refuse_rather_than_merging() -> Bool {
  let ds = divergences_against_desired(
    name: gunbc_passing_ci_ruleset_name,
    enforcement: RulesetActive,
    target: BranchTarget,
    bypass: ThisReaderCannotBypass,
    include: [default_branch_ref_alias],
    exclude: [],
    rule_types: desired_ruleset_rule_types(),
    standing: MultipleRequiredStatusChecksRules { count: 2 },
    merge_queue: desired_merge_queue_standing(),
  )
  length(ds) == 1
    && string_contains(s: render_divergences(ds: ds), pattern: "more than one required_status_checks rule")
}


// THE MERGE-QUEUE HALF. The proposal is DECLARED and NOT ACTUATED, and these witnesses assert both
// halves of that sentence separately, because getting either wrong is the whole risk: a proposal
// nobody can see, or a proposal a converge run quietly applies to a live repository.

// THE SIGN-OFF GATE. Unsigned desire projects no merge_queue rule. This corpus is SignedOff,
// so the projection converge sends carries the signed policy's rule.
test fn w_the_signed_policy_is_projected_as_a_merge_queue_rule() -> Bool {
  let signed = match desired_merge_queue {
    MergeQueueUnsigned { proposal: _, awaiting: _ } => false
    MergeQueueSignedOff { policy: _, ruling: r } => (r as String) != ""
  }
  let has_policy = match desired_merge_queue_policy() {
    Absent => false
    Present { value: _ } => true
  }
  let has_rule = any(desired_ruleset_rule_types(), t =>
    ruleset_rule_type_wire_label(t: t) == "merge_queue")
  signed && has_policy && has_rule
}

// AND IT IS NOT A VACUOUS GATE: the proposal it holds back is the one the lane argued for. If this
// goes red, the row above is gating something other than what the module's annotation describes.
test fn w_the_held_proposal_is_the_allgreen_squash_one() -> Bool {
  let p = merge_queue_floor_aligned_policy()
  merge_queue_grouping_strategy_wire_label(g: p.grouping_strategy) == "ALLGREEN"
    && merge_queue_merge_method_wire_label(m: p.merge_method) == "SQUASH"
    && merge_queue_entry_count_value(p.max_entries_to_merge) == 1
}

// THE DECLARED BUILD CONCURRENCY IS THE OPERATOR'S 3. The commissioning bound of 1 dissolved
// when that raise landed; this witness refuses a silent walk back to 1.
test fn w_the_declared_build_concurrency_is_the_operators_three() -> Bool {
  merge_queue_entry_count_value(merge_queue_floor_aligned_policy().max_entries_to_build) == 3
}

// THE TIMEOUT IS AN ORDERING, NOT A NUMBER, and this is the trap the assertion exists for. A queue
// whose check response timeout sits BELOW the repository's own execution envelope dequeues runs
// that were going to pass -- it manufactures queue failures out of slow greens. Asserting the
// ordering rather than 210 means raising the floor lane's timeout cannot silently invert it; a
// literal here would have gone stale on that edit with nothing going red.
test fn w_the_queue_timeout_is_never_below_the_floors_execution_envelope() -> Bool {
  match desired_merge_queue_policy() {
    Absent => false
    Present { value: p } =>
      minute_count(p.check_response_timeout) > minute_count(witness_floor_lane_timeout)
        && !merge_queue_timeout_below_floor(policy: p)
  }
}

test fn w_RED_a_timeout_at_or_below_the_floor_envelope_is_below_floor() -> Bool {
  merge_queue_timeout_below_floor(policy: MergeQueuePolicy {
    grouping_strategy: AllGreenGrouping,
    merge_method: QueueSquash,
    check_response_timeout: minute(count: 90),
    max_entries_to_build: merge_queue_entry_count(count: 1),
    max_entries_to_merge: merge_queue_entry_count(count: 1),
    min_entries_to_merge: merge_queue_entry_count(count: 1),
    min_entries_to_merge_wait: minute(count: 1),
  })
}

// A LIVE QUEUE NOBODY SIGNED OFF IS REPORTED. This is the web-form change the module exists to stop
// being invisible, and it must name WHICH guarantee the live queue provides -- an undeclared
// HEADGREEN queue and an undeclared ALLGREEN one are different facts.
fn divergences_with_live_queue(standing: MergeQueueStanding) -> List<RulesetDivergence> {
  divergences_against_desired(
    name: gunbc_passing_ci_ruleset_name,
    enforcement: RulesetActive,
    target: BranchTarget,
    bypass: ThisReaderCannotBypass,
    include: [default_branch_ref_alias],
    exclude: [],
    rule_types: [DeletionRule, NonFastForwardRule, RequiredStatusChecksRule, MergeQueueRule],
    standing: desired_shaped_standing(),
    merge_queue: standing,
  )
}

fn live_queue(grouping: MergeQueueGroupingStrategy) -> MergeQueueStanding {
  MergeQueueConfigured {
    grouping_strategy: grouping,
    merge_method: merge_queue_floor_aligned_policy().merge_method,
    check_response_timeout: merge_queue_floor_aligned_policy().check_response_timeout,
    max_entries_to_build: merge_queue_floor_aligned_policy().max_entries_to_build,
    max_entries_to_merge: merge_queue_floor_aligned_policy().max_entries_to_merge,
    min_entries_to_merge: merge_queue_floor_aligned_policy().min_entries_to_merge,
    min_entries_to_merge_wait: merge_queue_floor_aligned_policy().min_entries_to_merge_wait,
  }
}

test fn w_RED_a_headgreen_queue_drifts_from_the_signed_allgreen_policy() -> Bool {
  let allgreen = render_divergences(ds: divergences_with_live_queue(standing: live_queue(grouping: AllGreenGrouping)))
  let headgreen = render_divergences(ds: divergences_with_live_queue(standing: live_queue(grouping: HeadGreenGrouping)))
  string_contains(s: headgreen, pattern: "HEADGREEN")
    && string_contains(s: headgreen, pattern: "ALLGREEN")
    && !string_contains(s: allgreen, pattern: "HEADGREEN")
}

// A merge_queue RULE WHOSE PARAMETERS DID NOT ARRIVE COMPLETE REFUSES AND NAMES WHAT IS MISSING,
// rather than reading a default. The rule TAG says which fields to expect and the OPTIONALS say
// whether they came, so the two together are what keeps a truncated response from presenting as a
// configured queue with zeroes in it -- absent and zero are different observations, and only the
// optional carries that difference. Naming the missing fields is the point: a bare refusal would
// stop the read without telling the reader which part of the response never arrived.
test fn w_RED_an_incomplete_merge_queue_rule_refuses_and_names_the_missing_fields() -> Bool {
  let standing = merge_queue_standing(rules: [
    RulesetRuleWire {
      type: ruleset_rule_type_wire_label(t: MergeQueueRule),
      parameters: RulesetRuleParametersWire {
        strict_required_status_checks_policy: none,
        do_not_enforce_on_create: none,
        required_status_checks: none,
        check_response_timeout_minutes: Present { value: 210 },
        grouping_strategy: none,
        max_entries_to_build: Present { value: 1 },
        max_entries_to_merge: Present { value: 1 },
        merge_method: Present { value: "SQUASH" },
        min_entries_to_merge: Present { value: 1 },
        min_entries_to_merge_wait_minutes: none,
      },
    },
  ])
  let rendered = render_divergences(ds: divergences_with_live_queue(standing: standing))
  string_contains(s: rendered, pattern: "did not carry")
    && string_contains(s: rendered, pattern: "grouping_strategy")
    && string_contains(s: rendered, pattern: "min_entries_to_merge_wait_minutes")
    && !string_contains(s: rendered, pattern: "merge_method")
}

// THE required_status_checks CONSTRUCTOR CARRIES NO merge_queue PARAMETERS. Reading THAT rule
// as a queue standing must find no queue -- not an incomplete one.
test fn w_the_required_status_checks_rule_reads_back_as_no_queue() -> Bool {
  match merge_queue_standing(rules: filter(desired_ruleset_rules(), r => r.type != "merge_queue")) {
    NoMergeQueueRule => true
    _ => false
  }
}

// A merge_queue RULE AS A FIXTURE, so a truncated or HEADGREEN projection stays authorable
// independently of `desired_ruleset_rules`. Production projects through `merge_queue_rule`.
fn fixture_merge_queue_rule(strategy: String, max_build: Int) -> RulesetRuleWire {
  RulesetRuleWire {
    type: ruleset_rule_type_wire_label(t: MergeQueueRule),
    parameters: RulesetRuleParametersWire {
      strict_required_status_checks_policy: none,
      do_not_enforce_on_create: none,
      required_status_checks: none,
      check_response_timeout_minutes: Present { value: minute_count(merge_queue_floor_aligned_policy().check_response_timeout) },
      grouping_strategy: Present { value: strategy },
      max_entries_to_build: Present { value: max_build },
      max_entries_to_merge: Present { value: merge_queue_entry_count_value(merge_queue_floor_aligned_policy().max_entries_to_merge) },
      merge_method: Present { value: "SQUASH" },
      min_entries_to_merge: Present { value: merge_queue_entry_count_value(merge_queue_floor_aligned_policy().min_entries_to_merge) },
      min_entries_to_merge_wait_minutes: Present { value: minute_count(merge_queue_floor_aligned_policy().min_entries_to_merge_wait) },
    },
  }
}

// SIGNING OFF WITHOUT WIRING THE PROJECTION STOPS THE LINE. The corpus is SignedOff and
// projected; the RED is a fixture that keeps the policy and drops the merge_queue rule.
test fn w_RED_signing_off_without_wiring_the_projection_refuses_to_actuate() -> Bool {
  match signed_desire_projection_refusal_for(
    policy: Present { value: merge_queue_floor_aligned_policy() },
    rules: filter(desired_ruleset_rules(), r => r.type != "merge_queue"),
  ) {
    Present { value: cause } =>
      string_contains(s: cause, pattern: "never clear")
        && string_contains(s: cause, pattern: "no merge_queue rule is projected")
    Absent => false
  }
}

// THE POSITIVE CONTROL THAT MAKES THE WALL A CHECK AND NOT A CONSTANT. A projection carrying a
// merge_queue rule whose seven parameters equal the signed policy is admitted. Without this arm the
// refusal could be `always refuse when signed` and every RED above would still pass.
test fn w_a_projection_carrying_the_signed_policy_is_admitted() -> Bool {
  match signed_desire_projection_refusal_for(
    policy: Present { value: merge_queue_floor_aligned_policy() },
    rules: desired_ruleset_rules(),
  ) {
    Absent => true
    Present { value: _ } => false
  }
}

// THE RULE TYPE IS NOT THE POLICY, WHICH IS THE WHOLE REASON THE ROSTER WAS THE WRONG SUBJECT. This
// projection carries a merge_queue rule -- the type roster is satisfied and the old check passed on
// exactly this input -- and it configures the queue GitHub was NOT signed off for. The refusal
// names the field, the declared value and the projected one.
test fn w_RED_a_projected_queue_with_the_wrong_strategy_refuses_and_names_the_field() -> Bool {
  match signed_desire_projection_refusal_for(
    policy: Present { value: merge_queue_floor_aligned_policy() },
    rules: append(filter(desired_ruleset_rules(), r => r.type != "merge_queue"), items: [fixture_merge_queue_rule(strategy: "HEADGREEN", max_build: 1)]),
  ) {
    Present { value: cause } =>
      string_contains(s: cause, pattern: "projected grouping_strategy is HEADGREEN")
        && string_contains(s: cause, pattern: "declares ALLGREEN")
    Absent => false
  }
}

// A NUMERIC PARAMETER DRIFTS TOO. Declared max_entries_to_build is the operator's 3; a
// projection sending 5 under that sign-off is the ruling silently reversed, and it refuses
// with both numbers rather than a Bool.
test fn w_RED_a_projected_queue_with_a_drifted_entry_count_refuses_with_both_numbers() -> Bool {
  match signed_desire_projection_refusal_for(
    policy: Present { value: merge_queue_floor_aligned_policy() },
    rules: append(filter(desired_ruleset_rules(), r => r.type != "merge_queue"), items: [fixture_merge_queue_rule(strategy: "ALLGREEN", max_build: 5)]),
  ) {
    Present { value: cause } =>
      string_contains(s: cause, pattern: "projected max_entries_to_build is 5")
        && string_contains(s: cause, pattern: "declares 3")
    Absent => false
  }
}

// TWO PROJECTED QUEUE RULES ARE AMBIGUOUS RATHER THAN THE FIRST ONE WINNING.
test fn w_RED_two_projected_merge_queue_rules_refuse_as_ambiguous() -> Bool {
  match signed_desire_projection_refusal_for(
    policy: Present { value: merge_queue_floor_aligned_policy() },
    rules: append(desired_ruleset_rules(), items: [
      fixture_merge_queue_rule(strategy: "ALLGREEN", max_build: 1),
      fixture_merge_queue_rule(strategy: "ALLGREEN", max_build: 1),
    ]),
  ) {
    Present { value: cause } => string_contains(s: cause, pattern: "more than one merge_queue rule")
    Absent => false
  }
}

// THE TYPE ROSTER IS DERIVED FROM THE RULES AND NOT AUTHORED BESIDE THEM. Appending a rule to the
// projection must move the roster with no second edit; the literal it replaced could not.
test fn w_the_desired_type_roster_is_derived_from_the_projected_rules() -> Bool {
  length(desired_ruleset_rule_types()) == length(desired_ruleset_rules())
}

// THE POSITIVE CONTROL: an unsigned desire is not a refusal, or converge would be dead today.
test fn w_an_unsigned_desire_does_not_trip_the_sign_off_refusal() -> Bool {
  match signed_desire_projection_refusal_for(
    policy: none,
    rules: filter(desired_ruleset_rules(), r => r.type != "merge_queue"),
  ) {
    Absent => true
    Present { value: _ } => false
  }
}

test fn w_RED_an_unsigned_desire_with_a_projected_queue_is_undetermined() -> Bool {
  match signed_desire_projection_refusal_for(policy: none, rules: desired_ruleset_rules()) {
    Present { value: cause } => string_contains(s: cause, pattern: "unsigned")
    Absent => false
  }
}

// TWO merge_queue RULES REFUSE RATHER THAN PICKING ONE, the same shape as the status-check rule.
test fn w_RED_two_merge_queue_rules_refuse_rather_than_merging() -> Bool {
  string_contains(
    s: render_divergences(ds: divergences_with_live_queue(standing: MultipleMergeQueueRules { count: 2 })),
    pattern: "more than one merge_queue rule",
  )
}

data witness_live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// verify REPORTS THE ACTOR IT WOULD HAVE DELETED. A refusal on its own stops nothing useful here:
// it declines to answer and tells nobody the grant is there, so the operator learns that something
// is wrong without learning WHAT. This is the reporting half of the pair whose other half is the
// unobserved-roster arm below -- an observed actor is named, an unobservable roster is an unknown --
// and it is a divergence rather than an unknown precisely because the actor WAS seen.
test fn w_RED_verify_reports_an_undeclared_bypass_actor() -> Bool {
  string_contains(
    s: render_divergences(ds: bypass_actor_unexpected_divergences(roster: BypassRosterObserved {
      actors: [RulesetBypassActor { actor_type: "Team", actor_id: 7, bypass_mode: "always" }],
    })),
    pattern: "undeclared bypass actor present: Team/7 mode=always",
  )
}

// AN UNOBSERVED ROSTER IS REPORTED AS UNKNOWN RATHER THAN AS NOTHING, and -- since this module
// moved onto std.goal_assessment -- rather than as a DIVERGENCE. Reporting silence would collapse
// "we could not see whether a bypass exists" into "no bypass exists", the one distinction the
// reader-versus-roster split exists to keep. Reporting it as a divergence, which is what the
// earlier repair did, keeps the fact visible while misfiling it as a proved mismatch.
//
// So both halves are asserted here: the unknown IS produced and named, and the divergence fold
// does NOT also carry it. Without the second half the fact could be represented twice, and a later
// consumer folding over deviations would count an unread fact as drift.
test fn w_RED_an_unobserved_bypass_roster_is_an_unknown_and_not_a_divergence() -> Bool {
  let roster = bypass_roster_unavailable_from_get(reader: "some-reader" as NonEmptyStr)
  string_contains(s: render_unknowns(us: ruleset_unknowns(roster: roster)), pattern: "CANNOT SEE")
    && string_contains(s: render_unknowns(us: ruleset_unknowns(roster: roster)), pattern: "some-reader")
    && length(bypass_actor_unexpected_divergences(roster: roster)) == 0
}

// THE POSITIVE CONTROL: an observed empty roster contributes NO divergence, so verify does not
// invent a finding on a ruleset that genuinely grants no bypass.
test fn w_the_bypass_roster_carries_a_signed_ruling() -> Bool {
  match desired_bypass_roster {
    BypassRosterUnsigned { awaiting: _ } => false
    BypassRosterSignedOff { actors: as_, ruling: r } =>
      length(as_) == 1 && (r as String) != ""
  }
}

test fn w_the_declared_bypass_roster_contributes_no_divergence() -> Bool {
  length(bypass_actor_unexpected_divergences(roster: BypassRosterObserved { actors: desired_bypass_actors() })) == 0
}

test fn w_RED_an_empty_observed_roster_misses_the_declared_maintain_bypass() -> Bool {
  string_contains(
    s: render_divergences(ds: bypass_actor_unexpected_divergences(roster: BypassRosterObserved { actors: [] })),
    pattern: "declared bypass actor missing",
  )
}

test fn w_RED_a_declared_required_check_absent_from_the_required_lane_roster_refuses() -> Bool {
  length(required_contexts_declaration_refusals(contexts: ["not-on-the-roster"])) == 1
    && length(required_contexts_declaration_refusals(contexts: desired_required_contexts())) == 0
}

fn ensure_fixture(enforcement: RulesetEnforcement, roster: BypassActorRosterObservation) -> RulesetObservation {
  RulesetObserved {
    name: gunbc_passing_ci_ruleset_name,
    enforcement: enforcement,
    target: BranchTarget,
    bypass: ThisReaderCannotBypass,
    include: [default_branch_ref_alias],
    exclude: [],
    rule_types: desired_ruleset_rule_types(),
    standing: desired_shaped_standing(),
    merge_queue: desired_merge_queue_standing(),
    bypass_roster: roster,
  }
}

test fn w_RED_an_undeclared_live_rule_refuses_apply() -> Bool {
  match repo_ruleset_ensure_decision(observed: RulesetObserved {
    name: gunbc_passing_ci_ruleset_name,
    enforcement: RulesetActive,
    target: BranchTarget,
    bypass: ThisReaderCannotBypass,
    include: [default_branch_ref_alias],
    exclude: [],
    rule_types: append(desired_ruleset_rule_types(), items: [PullRequestRule]),
    standing: desired_shaped_standing(),
    merge_queue: desired_merge_queue_standing(),
    bypass_roster: BypassRosterObserved { actors: desired_bypass_actors() },
  }) {
    Refuse { reason: r } => string_contains(s: r, pattern: "undeclared rule present")
    Noop => false
    Apply { plan: _ } => false
  }
}

test fn w_RED_an_undetermined_desire_refuses_apply() -> Bool {
  match repo_ruleset_ensure_decision_for(
    observed: ensure_fixture(
      enforcement: RulesetEvaluate,
      roster: BypassRosterObserved { actors: desired_bypass_actors() },
    ),
    policy: Present { value: merge_queue_floor_aligned_policy() },
    rules: filter(desired_ruleset_rules(), r => r.type != "merge_queue"),
  ) {
    Refuse { reason: r } =>
      string_contains(s: r, pattern: "undetermined")
        && string_contains(s: r, pattern: "WHICH ONE IS THE DESIRE")
    Noop => false
    Apply { plan: _ } => false
  }
}

test fn w_a_live_shaped_observation_is_ensure_noop() -> Bool {
  match repo_ruleset_ensure_decision(observed: ensure_fixture(
    enforcement: RulesetActive,
    roster: BypassRosterObserved { actors: desired_bypass_actors() },
  )) {
    Noop => true
    Apply { plan: _ } => false
    Refuse { reason: _ } => false
  }
}

test fn w_RED_an_unobservable_bypass_roster_refuses_apply_rather_than_assuming() -> Bool {
  match repo_ruleset_ensure_decision(observed: ensure_fixture(
    enforcement: RulesetEvaluate,
    roster: bypass_roster_unavailable_from_get(reader: "fixture-reader" as NonEmptyStr),
  )) {
    Refuse { reason: r } => string_contains(s: r, pattern: "unobservable")
    Noop => false
    Apply { plan: _ } => false
  }
}

test fn w_RED_an_unreadable_readback_is_not_treated_as_satisfied() -> Bool {
  !ruleset_observation_satisfies_goal(observed: RulesetUnreadable {
    cause: RulesetReadTransportRefused { cause: "fixture post-apply get refused" as NonEmptyStr },
  })
}

test fn w_RED_readback_that_still_diverges_is_not_treated_as_satisfied() -> Bool {
  !ruleset_observation_satisfies_goal(observed: ensure_fixture(
    enforcement: RulesetEvaluate,
    roster: BypassRosterObserved { actors: desired_bypass_actors() },
  ))
    && match repo_ruleset_ensure_decision(observed: ensure_fixture(
      enforcement: RulesetEvaluate,
      roster: BypassRosterObserved { actors: desired_bypass_actors() },
    )) {
      Apply { plan: _ } => true
      Noop => false
      Refuse { reason: _ } => false
    }
}
