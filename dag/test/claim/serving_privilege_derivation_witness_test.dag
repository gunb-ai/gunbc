module test.claim.serving_privilege_derivation_witness_test


fn automation() -> gunbc.spark.serving_realization.SystemPrincipal {
  gunbc.spark.serving_realization.NamedPrincipal { login: "gunbc-automation" as std.types.NonEmptyStr }
}

fn target_as(actor: gunbc.spark.serving_realization.SystemPrincipal) -> gunbc.spark.serving_realization.ServingDeploymentTarget {
  gunbc.spark.serving_realization.ServingDeploymentTarget {
    actor: actor,
    unit_name: "gunbc-inference.service" as std.types.NonEmptyStr,
    unit_path: "/etc/systemd/system/gunbc-inference.service" as std.types.NonEmptyStr,
    staged_unit_path: "/home/gunbc-automation/gunbc-inference.service" as std.types.NonEmptyStr,
    runtime_package: "ollama" as std.types.NonEmptyStr,
  }
}

// THE CLAIM THE WHOLE MODEL EXISTS FOR, and the one a hand-drawn table cannot make. Privilege is a
// RELATIONSHIP between actor and subject, not a property of the effect -- so running the SAME
// realization as root must require no grant at all. A table asserting "WriteSystemUnitFile is
// privileged" answers this wrongly, because it never mentions who is acting.
test fn w_the_same_realization_needs_no_grant_when_the_actor_owns_what_it_mutates() -> Bool {
  let as_root = length(gunbc.spark.serving_realization.realization_escalated_commands(realization: gunbc.spark.serving_realization.SystemUnitRealization, target: target_as(gunbc.spark.serving_realization.RootPrincipal)))
  let as_automation = length(gunbc.spark.serving_realization.realization_escalated_commands(realization: gunbc.spark.serving_realization.SystemUnitRealization, target: target_as(automation())))
  as_root == 0 && as_automation > 0
}

// THE OWNERSHIP FACT IS WHAT DECIDES IT, asserted directly so the derivation cannot be satisfied by
// a function that merely varies with the actor for some other reason.
test fn w_escalation_follows_ownership_of_the_mutated_subject() -> Bool {
  let e = gunbc.spark.serving_realization.WriteSystemUnitFile
  let owner = gunbc.spark.serving_realization.subject_owner(subject: gunbc.spark.serving_realization.effect_mutation_subject(effect: e, actor: automation()))
  match owner {
    gunbc.spark.serving_realization.RootPrincipal =>
      gunbc.spark.serving_realization.effect_requires_escalation(effect: e, actor: automation())
        && !gunbc.spark.serving_realization.effect_requires_escalation(effect: e, actor: gunbc.spark.serving_realization.RootPrincipal)
    gunbc.spark.serving_realization.NamedPrincipal { login: _ } => false
  }
}

// AN ACTOR-OWNED SUBJECT NEEDS NOTHING, and this is where the model beats the table on a case the
// table gets wrong by omission rather than by error: MaterializeModelArtifact writes a store the serving
// account already owns, and a user unit lives in that account's own registry. Neither belongs in a
// sudoers file for ANY actor that owns them.
test fn w_effects_on_actor_owned_subjects_never_escalate() -> Bool {
  !gunbc.spark.serving_realization.effect_requires_escalation(effect: gunbc.spark.serving_realization.MaterializeModelArtifact, actor: automation())
    && !gunbc.spark.serving_realization.effect_requires_escalation(effect: gunbc.spark.serving_realization.WriteUserUnitFile, actor: automation())
    && !gunbc.spark.serving_realization.effect_requires_escalation(effect: gunbc.spark.serving_realization.EnableUserUnit, actor: automation())
    && !gunbc.spark.serving_realization.effect_requires_escalation(effect: gunbc.spark.serving_realization.RunContainerAsOwnUser, actor: automation())
}

// ROOT-OWNED SUBJECTS ESCALATE FOR A NAMED ACTOR, the positive control without which the claim above
// is satisfied by a function that never escalates.
test fn w_root_owned_subjects_escalate_for_a_named_actor() -> Bool {
  gunbc.spark.serving_realization.effect_requires_escalation(effect: gunbc.spark.serving_realization.InstallRuntimePackage, actor: automation())
    && gunbc.spark.serving_realization.effect_requires_escalation(effect: gunbc.spark.serving_realization.GrantContainerRuntimeAccess, actor: automation())
    && gunbc.spark.serving_realization.effect_requires_escalation(effect: gunbc.spark.serving_realization.EnableLingerForOwnAccount, actor: automation())
}

// THE GRANT TRACKS THE EFFECT POPULATION. A realization declaring fewer escalating effects gets a
// strictly smaller grant -- the relationship a hardcoded list cannot have, because its size is a
// property of the author's typing rather than of the model.
test fn w_a_realization_with_fewer_escalating_effects_gets_a_smaller_grant() -> Bool {
  let system_grant = length(gunbc.spark.serving_realization.realization_escalated_commands(realization: gunbc.spark.serving_realization.SystemUnitRealization, target: target_as(automation())))
  let container_grant = length(gunbc.spark.serving_realization.realization_escalated_commands(realization: gunbc.spark.serving_realization.RootlessContainerRealization, target: target_as(automation())))
  container_grant < system_grant && container_grant > 0
}

// THE GRANT RENDERS ITS TARGET, not a constant. A grant naming the wrong unit is one sudo would
// silently never match -- a failure that looks like a permissions problem forever.
test fn w_grant_renders_the_supplied_target() -> Bool {
  let lines = gunbc.spark.serving_realization.realization_sudoers_grant_lines(realization: gunbc.spark.serving_realization.SystemUnitRealization, target: target_as(automation()))
  fold(lines, init: false, f: fn(acc, l) {
    acc || string_contains(s: l, pattern: "gunbc-inference.service")
  })
}

// RED CONTROL: no grant line may carry a shell metacharacter or wildcard. A sudoers entry is a
// capability grant, and one loose token converts "may restart this unit" into "may become root".
test fn red_control_no_grant_line_carries_shell_or_wildcard() -> Bool {
  let lines = gunbc.spark.serving_realization.realization_sudoers_grant_lines(realization: gunbc.spark.serving_realization.SystemUnitRealization, target: target_as(automation()))
  fold(lines, init: true, f: fn(acc, l) {
    acc
      && !string_contains(s: l, pattern: "*")
      && !string_contains(s: l, pattern: ";")
      && !string_contains(s: l, pattern: "&")
      && !string_contains(s: l, pattern: "|")
      && !string_contains(s: l, pattern: "$")
      && !string_contains(s: l, pattern: "`")
  })
}

// RED CONTROL: an effect that does not escalate contributes no command even though it HAS an
// actuation. This is the arm that keeps the grant from quietly including everything a realization
// does -- the fold must consult escalation, not merely concatenate actuations.
test fn red_control_non_escalating_effects_contribute_no_grant_line() -> Bool {
  let actuation = length(match gunbc.spark.serving_realization.effect_actuation(effect: gunbc.spark.serving_realization.EnableLingerForOwnAccount, target: target_as(gunbc.spark.serving_realization.RootPrincipal)) { gunbc.spark.serving_realization.ActuatedByEscalation { commands: c } => c gunbc.spark.serving_realization.ActuatedByOwnerDirectly => Empty })
  let granted = length(gunbc.spark.serving_realization.realization_escalated_commands(realization: gunbc.spark.serving_realization.UserUnitRealization, target: target_as(gunbc.spark.serving_realization.RootPrincipal)))
  actuation > 0 && granted == 0
}

// THE RESULT THE WHOLE MODEL WAS BUILT TO PRODUCE: a user-unit serving install, run by the named
// automation account, needs exactly ONE escalated command -- enable-linger -- and that command is
// already granted on both Sparks. So the shortfall against the observed grant population is empty
// and the plan is applicable with no administrator credential. This is DERIVED here, not asserted:
// nothing in the model says "serving needs no privilege".
test fn w_user_unit_serving_needs_no_new_privilege_against_the_observed_grant() -> Bool {
  let target = target_as(gunbc.spark.serving_realization.NamedPrincipal { login: "gunbc-automation" as std.types.NonEmptyStr })
  let observed = automation_grants(commands: ["/usr/bin/loginctl enable-linger gunbc-automation" as std.types.NonEmptyStr])
  gunbc.spark.serving_realization.applicable_without_administrator(shortfall: gunbc.spark.serving_realization.escalation_shortfall(
    realization: gunbc.spark.serving_realization.UserUnitRealization, subject_host: "srv5", expected_credential: std.content_hash.content_hash_of_value(value: "fleet-automation-key" as std.types.NonEmptyStr), target: target, observed: observed))
}

// THE DISCRIMINATING CONTROL. Same realization, same actor, an observed grant population that does
// NOT hold linger -- the state a freshly built Spark is in. It must report the missing command
// rather than proceeding, or the join above is measuring nothing.
test fn w_the_same_install_is_refused_when_linger_is_not_granted() -> Bool {
  let target = target_as(gunbc.spark.serving_realization.NamedPrincipal { login: "gunbc-automation" as std.types.NonEmptyStr })
  !gunbc.spark.serving_realization.applicable_without_administrator(shortfall: gunbc.spark.serving_realization.escalation_shortfall(
    realization: gunbc.spark.serving_realization.UserUnitRealization, subject_host: "srv5",
    expected_credential: std.content_hash.content_hash_of_value(value: "fleet-automation-key" as std.types.NonEmptyStr), target: target,
    observed: automation_grants(commands: [])))
}

// AN UNOBSERVED GRANT POPULATION IS NOT AN EMPTY ONE. Reading "we could not see the grants" as
// "there are none" would authorize an install the real host refuses.
test fn w_an_unobserved_grant_population_does_not_authorize_the_install() -> Bool {
  let target = target_as(gunbc.spark.serving_realization.NamedPrincipal { login: "gunbc-automation" as std.types.NonEmptyStr })
  !gunbc.spark.serving_realization.applicable_without_administrator(shortfall: gunbc.spark.serving_realization.escalation_shortfall(
    realization: gunbc.spark.serving_realization.UserUnitRealization, subject_host: "srv5",
    expected_credential: std.content_hash.content_hash_of_value(value: "fleet-automation-key" as std.types.NonEmptyStr), target: target,
    observed: gunbc.spark.serving_realization.GrantPopulationUnobserved { host: "srv5", principal: "gunbc-automation" as std.types.NonEmptyStr, cause: "sudo -n -l could not be reached" as std.types.NonEmptyStr }))
}

// THE PACKAGED RUNTIME STILL COSTS ROOT, which is what proves the closure effect changed the
// derivation rather than the derivation being insensitive to it.
test fn w_the_packaged_runtime_still_requires_escalation() -> Bool {
  gunbc.spark.serving_realization.effect_requires_escalation(effect: gunbc.spark.serving_realization.InstallRuntimePackage, actor: gunbc.spark.serving_realization.NamedPrincipal { login: "gunbc-automation" as std.types.NonEmptyStr })
    && !gunbc.spark.serving_realization.effect_requires_escalation(effect: gunbc.spark.serving_realization.InstallOwnedRuntimeClosure, actor: gunbc.spark.serving_realization.NamedPrincipal { login: "gunbc-automation" as std.types.NonEmptyStr })
}


fn automation_grants(commands: List<std.types.NonEmptyStr>) -> gunbc.spark.serving_realization.ObservedGrantPopulation {
  gunbc.spark.serving_realization.GrantPopulationObserved {
    host: "srv5",
    principal: "gunbc-automation" as std.types.NonEmptyStr,
    credential_identity: std.content_hash.content_hash_of_value(value: "fleet-automation-key" as std.types.NonEmptyStr),
    commands: commands,
  }
}
