module test.claim.artifact_store_witness

data live_tree_disposition: LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data artifact_store_witness_note: String = "P2 pure-spec ACCEPT witnesses: put/get/evict receipts with discriminating REDs - a mutated key input never serves the old artifact (stale-never-served), budget breach evicts least-recent WITH the eviction counted in the receipt, and a store cannot be constructed over a provider whose declared eviction is not std.materialization_ladder.SpacePacked (the eviction field's first behavioral reader, audit F5)."

data spacepacked_provider: CacheProvider = std.materialization_ladder.provider_row(
  id: "artifact-store-test",
  scope: [],
  coverage: std.materialization_ladder.CoversAllComputations,
  tier: std.materialization_ladder.ArtifactTier { keying: ContentKeyed },
  eviction: std.materialization_ladder.SpacePacked { budget: "test budget label" }
)

data scopeexit_provider: CacheProvider = std.materialization_ladder.provider_row(
  id: "scoped-provider-test",
  scope: [],
  coverage: std.materialization_ladder.CoversAllComputations,
  tier: std.materialization_ladder.ReferenceTier,
  eviction: std.materialization_ladder.ScopeExit
)

fn test_store() -> std.artifact_store.ArtifactStore {
  match std.artifact_store.store_over_provider(provider: spacepacked_provider, budget: std.measure.byte_size(count: 100)) {
    std.artifact_store.StoreReady { store: s } => s
    std.artifact_store.StoreRefusedEviction { provider_id: _, declared: _ } => std.artifact_store.ArtifactStore { budget: std.measure.byte_size(count: 0), next_ordinal: 1, rows: [] }
  }
}

fn key_of(toolchain: String) -> std.types.ContentHash {
  std.artifact_store.artifact_key_hash(key: std.artifact_store.ArtifactKey {
    closure_digest: std.content_hash.content_hash_atom(value: "closure-digest-fixture"),
    emitter_identity: "v1-seed",
    target_language: "rust",
    toolchain: toolchain
  })
}

test fn store_construction_reads_eviction_holds() -> Bool {
  let ok = match std.artifact_store.store_over_provider(provider: spacepacked_provider, budget: std.measure.byte_size(count: 100)) {
    std.artifact_store.StoreReady { store: _ } => true
    std.artifact_store.StoreRefusedEviction { provider_id: _, declared: _ } => false
  }
  let refused = match std.artifact_store.store_over_provider(provider: scopeexit_provider, budget: std.measure.byte_size(count: 100)) {
    std.artifact_store.StoreReady { store: _ } => false
    std.artifact_store.StoreRefusedEviction { provider_id: pid, declared: _ } => pid == "scoped-provider-test"
  }
  ok && refused
}

test fn store_hit_and_stale_never_served_holds() -> Bool {
  let k1 = key_of(toolchain: "1.93.0")
  let k2 = key_of(toolchain: "1.94.0")
  let put1 = std.artifact_store.store_put(store: test_store(), key: k1, artifact_bytes: std.measure.byte_size(count: 40))
  let hit = match std.artifact_store.store_get(store: put1.store, key: k1) {
    std.artifact_store.StoreHit { store: _, row: r } => r.key == k1
    std.artifact_store.StoreMiss { store: _ } => false
  }
  let mutated_input_misses = match std.artifact_store.store_get(store: put1.store, key: k2) {
    std.artifact_store.StoreHit { store: _, row: _ } => false
    std.artifact_store.StoreMiss { store: _ } => true
  }
  hit && mutated_input_misses && (k1 == k2) == false
}

test fn store_budget_evicts_least_recent_counted_holds() -> Bool {
  let ka = key_of(toolchain: "a")
  let kb = key_of(toolchain: "b")
  let kc = key_of(toolchain: "c")
  let s1 = std.artifact_store.store_put(store: test_store(), key: ka, artifact_bytes: std.measure.byte_size(count: 40)).store
  let s2 = std.artifact_store.store_put(store: s1, key: kb, artifact_bytes: std.measure.byte_size(count: 40)).store
  let touched = match std.artifact_store.store_get(store: s2, key: ka) {
    std.artifact_store.StoreHit { store: s, row: _ } => s
    std.artifact_store.StoreMiss { store: s } => s
  }
  let receipt = std.artifact_store.store_put(store: touched, key: kc, artifact_bytes: std.measure.byte_size(count: 40))
  let evicted_is_least_recent = receipt.evicted == [kb]
  let within_budget = std.artifact_store.store_bytes_used(store: receipt.store) <= std.measure.measure_count(m: receipt.store.budget)
  let survivors_hit = match std.artifact_store.store_get(store: receipt.store, key: ka) {
    std.artifact_store.StoreHit { store: _, row: _ } => true
    std.artifact_store.StoreMiss { store: _ } => false
  }
  evicted_is_least_recent && within_budget && survivors_hit
}

test fn store_no_eviction_under_budget_holds() -> Bool {
  let receipt = std.artifact_store.store_put(store: test_store(), key: key_of(toolchain: "solo"), artifact_bytes: std.measure.byte_size(count: 40))
  receipt.evicted == []
}
