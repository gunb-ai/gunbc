import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// P2 pure-spec ACCEPT witnesses: put/get/evict receipts with discriminating REDs - a mutated key
// input never serves the old artifact (stale-never-served), identical files and argv under a
// changed resolved build toolchain OR changed admitted environment select different effective
// native workspaces, budget breach evicts least-recent WITH the eviction counted in the receipt,
// and a store cannot be constructed over a provider that did not declare the byte ceiling it is
// being sized by (the retention field's first behavioral reader, audit F5). The budget is DERIVED
// from the provider, so the fixtures can no longer declare an unobserved ceiling and be handed an
// exact number anyway; each refusal names its own cause because the remedies differ.

data byte_bounded_provider: CacheProvider = provider_row(
  id: "artifact-store-test",
  scope: [],
  coverage: CoversAllComputations,
  tier: ArtifactTier { keying: ContentKeyed },
  retention: persistent_retention(capacity: CapacityBounded { limit: ByteCapacity { limit: ExactLimit { value: byte_size(count: 100) } }, at_capacity: ReplaceExisting { strategy: LeastRecentlyUsed } })
)

data scopeexit_provider: CacheProvider = provider_row(
  id: "scoped-provider-test",
  scope: [],
  coverage: CoversAllComputations,
  tier: ReferenceTier,
  retention: scope_released_retention(capacity: CapacityUnbounded)
)

fn test_store() -> ArtifactStore {
  match store_over_provider(provider: byte_bounded_provider) {
    StoreReady { store: s } => s
    StoreRefusedRetention { provider_id: _, declared: _, cause: _ } => ArtifactStore { budget: byte_size(count: 0), next_ordinal: 1, rows: [] }
  }
}

fn key_of(toolchain: String) -> ContentHash {
  artifact_key_hash(key: ArtifactKey {
    closure_digest: content_hash_atom(value: "closure-digest-fixture"),
    emitter_identity: "v1-seed",
    target_language: "rust",
    toolchain: toolchain
  })
}

fn structural_resolved_build_context_identity(context: ResolvedBuildContext) -> ContentHash {
  match resolved_build_context_identity_outcome(context: context) {
    ResolvedBuildContextIdentityPresent { identity: id } => id
    ResolvedBuildContextIdentityRefusedCrypto { component: _, identity: _ } =>
      as_content_hash_structural(
        structural: content_hash_atom(value: "artifact-store-witness-unexpected-crypto-refusal")
      )
  }
}

fn structural_toolchain_identity(context: ResolvedBuildContext) -> ContentHash {
  match toolchain_identity_outcome(context: context) {
    ToolchainIdentityPresent { identity: id } => id
    ToolchainIdentityRefusedCrypto { component: _, identity: _ } =>
      as_content_hash_structural(
        structural: content_hash_atom(value: "artifact-store-witness-unexpected-crypto-refusal")
      )
  }
}

fn observed_tool(tool_name: String, observed_identity: String) -> ObservedToolIdentity {
  ObservedToolIdentity {
    tool_name: tool_name,
    observed_identity: as_content_hash_structural(
      structural: content_hash_atom(value: observed_identity)
    )
  }
}

fn legacy_toolchain_identity(
  cargo_observed_identity: Fnv1a64Structural,
  rustc_observed_identity: Fnv1a64Structural,
) -> ContentHash {
  as_content_hash_structural(
    structural: content_hash_combine_structural(
      left: content_hash_combine_structural(
        left: content_hash_atom(value: "emit-host-resolved-build-toolchain-v1"),
        right: cargo_observed_identity,
      ),
      right: rustc_observed_identity,
    )
  )
}

// The budget is now DERIVED, so this asserts the number the store sized itself
// by rather than that construction merely succeeded. Under the old shape both
// halves passed while the provider declared EffectiveLimitUnobserved and the
// caller supplied 100 — the contradiction the split exists to make unwritable.
test fn store_budget_is_derived_from_the_provider_not_the_caller() -> Bool {
  match store_over_provider(provider: byte_bounded_provider) {
    StoreReady { store: s } => s.budget == byte_size(count: 100)
    StoreRefusedRetention { provider_id: _, declared: _, cause: _ } => false
  }
}

test fn scope_released_provider_is_refused_with_the_scope_cause() -> Bool {
  match store_over_provider(provider: scopeexit_provider) {
    StoreReady { store: _ } => false
    StoreRefusedRetention { provider_id: pid, declared: _, cause: c } =>
      (pid == "scoped-provider-test") && (c == ProviderScopeReleased)
  }
}

// Each remaining refusal cause gets its own control, because the whole point of
// splitting StoreRefusedRetention into causes is that the remedies differ.
test fn entry_capped_provider_is_refused_for_the_unit_not_the_ceiling() -> Bool {
  let entry_capped = provider_row(
    id: "entry-capped-test",
    scope: [],
    coverage: CoversAllComputations,
    tier: ArtifactTier { keying: ContentKeyed },
    retention: persistent_retention(capacity: CapacityBounded {
      limit: EntryCountCapacity { limit: ExactLimit { value: 512 } },
      at_capacity: ReplaceExisting { strategy: LeastRecentlyUsed }
    })
  )
  match store_over_provider(provider: entry_capped) {
    StoreReady { store: _ } => false
    StoreRefusedRetention { provider_id: _, declared: _, cause: c } => c == CapacityUnitMismatch
  }
}

test fn unobserved_byte_value_is_refused_rather_than_defaulted() -> Bool {
  let value_unknown = provider_row(
    id: "value-unobserved-test",
    scope: [],
    coverage: CoversAllComputations,
    tier: ArtifactTier { keying: ContentKeyed },
    retention: persistent_retention(capacity: CapacityBounded {
      limit: ByteCapacity { limit: EffectiveLimitUnobserved },
      at_capacity: ReplaceExisting { strategy: LeastRecentlyUsed }
    })
  )
  match store_over_provider(provider: value_unknown) {
    StoreReady { store: _ } => false
    StoreRefusedRetention { provider_id: _, declared: _, cause: c } => c == CapacityValueUnobserved
  }
}

// The LRU realization may not be built over a provider that refuses new stores
// instead of replacing — it would silently evict where the row says it should
// have declined. This is the at_capacity field's first behavioral reader.
test fn refuse_new_store_provider_is_not_realized_as_lru() -> Bool {
  let refuses_new = provider_row(
    id: "refuse-new-test",
    scope: [],
    coverage: CoversAllComputations,
    tier: ArtifactTier { keying: ContentKeyed },
    retention: persistent_retention(capacity: CapacityBounded {
      limit: ByteCapacity { limit: ExactLimit { value: byte_size(count: 100) } },
      at_capacity: RefuseNewStore
    })
  )
  match store_over_provider(provider: refuses_new) {
    StoreReady { store: _ } => false
    StoreRefusedRetention { provider_id: _, declared: _, cause: c } => c == RefuseNewStoreUnsupported
  }
}

test fn store_hit_and_stale_never_served_holds() -> Bool {
  let k1 = key_of(toolchain: "1.93.0")
  let k2 = key_of(toolchain: "1.94.0")
  store_put_fold(
    outcome: store_put(store: test_store(), key: k1, artifact_bytes: byte_size(count: 40)),
    did_not_fit: (a, b) => false,
    admitted: fn(put1_store, evicted) {
      let hit = match store_get(store: put1_store, key: k1) {
        StoreHit { store: _, row: r } => r.key == k1
        StoreMiss { store: _ } => false
      }
      let mutated_input_misses = match store_get(store: put1_store, key: k2) {
        StoreHit { store: _, row: _ } => false
        StoreMiss { store: _ } => true
      }
      hit && mutated_input_misses && (k1 == k2) == false
    }
  )
}

test fn native_realization_toolchain_change_cold_rebuild_holds() -> Bool {
  let fixed_inputs: List<ArtifactRealizationInput> = [
    ArtifactRealizationInput {
      identity: "workspace:src/main.rs",
      content_digest: content_hash_atom(value: "fn main() {}")
    },
    ArtifactRealizationInput {
      identity: "build-argv",
      content_digest: content_hash_atom(value: "cargo build --release")
    },
  ]
  let fixed_realization = native_cache_realization_workspace_root(
    workspace_root: "/tmp/gunbc_toolchain_identity/outer-key",
    realization_digest: artifact_realization_digest(inputs: fixed_inputs)
  )
  let before_resolved_context = ResolvedBuildContext {
    observed_tool_identities: [
      observed_tool(tool_name: "cargo", observed_identity: "cargo 1.93.0 -Vv"),
      observed_tool(tool_name: "rustc", observed_identity: "rustc 1.93.0 -vV"),
    ],
    environment_identity: as_content_hash_structural(structural: content_hash_atom(value: "fixed environment")),
    cargo_configuration_identity: as_content_hash_structural(structural: content_hash_atom(value: "fixed cargo configuration"))
  }
  let after_resolved_context = ResolvedBuildContext {
    observed_tool_identities: [
      observed_tool(tool_name: "cargo", observed_identity: "cargo 1.93.0 -Vv"),
      observed_tool(tool_name: "rustc", observed_identity: "rustc 1.94.0 -vV"),
    ],
    environment_identity: as_content_hash_structural(structural: content_hash_atom(value: "fixed environment")),
    cargo_configuration_identity: as_content_hash_structural(structural: content_hash_atom(value: "fixed cargo configuration"))
  }
  let before_context = structural_resolved_build_context_identity(context: before_resolved_context)
  let after_context = structural_resolved_build_context_identity(context: after_resolved_context)
  let cargo_before = match observed_tool_identity(context: before_resolved_context, tool_name: "cargo") {
    ObservedToolIdentityFound { row } => row.observed_identity == as_content_hash_structural(
      structural: content_hash_atom(value: "cargo 1.93.0 -Vv")
    )
    ObservedToolIdentityMissing { tool_name: _ } => false
    ObservedToolIdentityDuplicate { tool_name: _, count: _ } => false
  }
  let rustc_changed = match observed_tool_identity(context: after_resolved_context, tool_name: "rustc") {
    ObservedToolIdentityFound { row } => row.observed_identity == as_content_hash_structural(
      structural: content_hash_atom(value: "rustc 1.94.0 -vV")
    )
    ObservedToolIdentityMissing { tool_name: _ } => false
    ObservedToolIdentityDuplicate { tool_name: _, count: _ } => false
  }
  let derived_receipt = legacy_toolchain_identity(
    cargo_observed_identity: content_hash_atom(value: "cargo 1.93.0 -Vv"),
    rustc_observed_identity: content_hash_atom(value: "rustc 1.93.0 -vV"),
  )
  let unchanged_build_receipt = structural_toolchain_identity(context: before_resolved_context) == derived_receipt
  let before = native_cache_resolved_build_context_workspace_root(
    realization_workspace_root: fixed_realization,
    resolved_build_context_identity: before_context
  )
  let after = native_cache_resolved_build_context_workspace_root(
    realization_workspace_root: fixed_realization,
    resolved_build_context_identity: after_context
  )
  cargo_before && rustc_changed && (before_context != after_context) && unchanged_build_receipt && before != after
}

test fn observed_tool_identity_missing_and_duplicate_refuse() -> Bool {
  let missing_context = ResolvedBuildContext {
    observed_tool_identities: [
      observed_tool(tool_name: "cargo", observed_identity: "cargo 1.93.0 -Vv"),
      observed_tool(tool_name: "rustc", observed_identity: "rustc 1.93.0 -vV"),
    ],
    environment_identity: as_content_hash_structural(structural: content_hash_atom(value: "fixed environment")),
    cargo_configuration_identity: as_content_hash_structural(structural: content_hash_atom(value: "fixed cargo configuration"))
  }
  let duplicate_context = ResolvedBuildContext {
    observed_tool_identities: [
      observed_tool(tool_name: "cargo", observed_identity: "cargo 1.93.0 -Vv"),
      observed_tool(tool_name: "cargo", observed_identity: "cargo 1.94.0 -Vv"),
    ],
    environment_identity: as_content_hash_structural(structural: content_hash_atom(value: "fixed environment")),
    cargo_configuration_identity: as_content_hash_structural(structural: content_hash_atom(value: "fixed cargo configuration"))
  }
  let missing = match observed_tool_identity(context: missing_context, tool_name: "clippy") {
    ObservedToolIdentityMissing { tool_name: n } => (n as String) == "clippy"
    ObservedToolIdentityDuplicate { tool_name: _, count: _ } => false
    ObservedToolIdentityFound { row: _ } => false
  }
  let duplicate = match observed_tool_identity(context: duplicate_context, tool_name: "cargo") {
    ObservedToolIdentityDuplicate { tool_name: n, count: _ } => (n as String) == "cargo"
    ObservedToolIdentityMissing { tool_name: _ } => false
    ObservedToolIdentityFound { row: _ } => false
  }
  missing && duplicate
}

data witness_sha256_hex: String = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"

test fn resolved_build_context_identity_refuses_sha256_observed_tool() -> Bool {
  let sha256_identity = match sha256_hex_digest(hex: witness_sha256_hex) {
    Present { value: digest } => as_content_hash_cryptographic(digest: digest)
    Absent =>
      as_content_hash_structural(structural: content_hash_atom(value: "witness-setup-failed"))
  }
  let context = ResolvedBuildContext {
    observed_tool_identities: [
      ObservedToolIdentity {
        tool_name: "cargo",
        observed_identity: sha256_identity
      }
    ],
    environment_identity: as_content_hash_structural(
      structural: content_hash_atom(value: "env")
    ),
    cargo_configuration_identity: as_content_hash_structural(
      structural: content_hash_atom(value: "cargo-config")
    ),
  }
  match resolved_build_context_identity_outcome(context: context) {
    ResolvedBuildContextIdentityRefusedCrypto { component: c, identity: i } =>
      (c as String) == "cargo" && content_hash_family(hash: i) == Sha256Family
    ResolvedBuildContextIdentityPresent { identity: _ } => false
  }
}

test fn derived_aggregate_matches_legacy_aggregate_for_unchanged_build() -> Bool {
  let context = ResolvedBuildContext {
    observed_tool_identities: [
      observed_tool(tool_name: "cargo", observed_identity: "cargo 1.93.0 -Vv"),
      observed_tool(tool_name: "rustc", observed_identity: "rustc 1.93.0 -vV"),
    ],
    environment_identity: as_content_hash_structural(structural: content_hash_atom(value: "fixed environment")),
    cargo_configuration_identity: as_content_hash_structural(structural: content_hash_atom(value: "fixed cargo configuration"))
  }
  structural_toolchain_identity(context: context) == legacy_toolchain_identity(
    cargo_observed_identity: content_hash_atom(value: "cargo 1.93.0 -Vv"),
    rustc_observed_identity: content_hash_atom(value: "rustc 1.93.0 -vV"),
  )
}

test fn native_realization_environment_change_cold_rebuild_holds() -> Bool {
  let fixed_realization = native_cache_realization_workspace_root(
    workspace_root: "/tmp/gunbc_environment_identity/outer-key",
    realization_digest: as_content_hash_structural(
      structural: content_hash_atom(value: "fixed files and build argv")
    )
  )
  let before_context = structural_resolved_build_context_identity(context: ResolvedBuildContext {
    observed_tool_identities: [
      observed_tool(tool_name: "cargo", observed_identity: "fixed cargo and rustc"),
      observed_tool(tool_name: "rustc", observed_identity: "fixed cargo and rustc"),
    ],
    environment_identity: as_content_hash_structural(structural: content_hash_atom(value: "RUSTFLAGS=-Copt-level=2")),
    cargo_configuration_identity: as_content_hash_structural(structural: content_hash_atom(value: "fixed cargo configuration"))
  })
  let after_context = structural_resolved_build_context_identity(context: ResolvedBuildContext {
    observed_tool_identities: [
      observed_tool(tool_name: "cargo", observed_identity: "fixed cargo and rustc"),
      observed_tool(tool_name: "rustc", observed_identity: "fixed cargo and rustc"),
    ],
    environment_identity: as_content_hash_structural(structural: content_hash_atom(value: "RUSTFLAGS=-Copt-level=3")),
    cargo_configuration_identity: as_content_hash_structural(structural: content_hash_atom(value: "fixed cargo configuration"))
  })
  let before = native_cache_resolved_build_context_workspace_root(
    realization_workspace_root: fixed_realization,
    resolved_build_context_identity: before_context
  )
  let after = native_cache_resolved_build_context_workspace_root(
    realization_workspace_root: fixed_realization,
    resolved_build_context_identity: after_context
  )
  before != after
}

test fn store_budget_evicts_least_recent_counted_holds() -> Bool {
  let ka = key_of(toolchain: "a")
  let kb = key_of(toolchain: "b")
  let kc = key_of(toolchain: "c")
  store_put_fold(
    outcome: store_put(store: test_store(), key: ka, artifact_bytes: byte_size(count: 40)),
    did_not_fit: (a, b) => false,
    admitted: fn(s1, e1) {
  store_put_fold(
    outcome: store_put(store: s1, key: kb, artifact_bytes: byte_size(count: 40)),
    did_not_fit: (a, b) => false,
    admitted: fn(s2, e2) {
  let touched = match store_get(store: s2, key: ka) {
    StoreHit { store: s, row: _ } => s
    StoreMiss { store: s } => s
  }
  store_put_fold(
    outcome: store_put(store: touched, key: kc, artifact_bytes: byte_size(count: 40)),
    admitted: fn(packed, evicted) {
      let evicted_is_least_recent = evicted == [kb]
      let within_budget = store_bytes_used(store: packed) <= measure_count(m: packed.budget)
      let survivors_hit = match store_get(store: packed, key: ka) {
        StoreHit { store: _, row: _ } => true
        StoreMiss { store: _ } => false
      }
      evicted_is_least_recent && within_budget && survivors_hit
    },
    did_not_fit: (a, b) => false
  )
    }
  )
    }
  )
}

test fn store_no_eviction_under_budget_holds() -> Bool {
  store_put_evicted_keys(
    outcome: store_put(store: test_store(), key: key_of(toolchain: "solo"), artifact_bytes: byte_size(count: 40))
  ) == []
}

// The discriminating receipt for store_put's totality repair: an artifact larger than the whole
// budget must be a DidNotFit VALUE and must leave the store untouched. Before the repair these
// assertions were all false in the same direction - the oversized put reported success, its evicted
// list named the key just put, and against a warm store it had already discarded the valid rows.
// The warm case is asserted separately from the cold one because only the warm case exposes the
// DESTRUCTION: a cold oversized put merely returned an empty store it had also started with, so a
// cold-only witness would have gone green against the destructive implementation.

fn oversize_store() -> ArtifactStore {
  ArtifactStore { budget: byte_size(count: 100), next_ordinal: 1, rows: [] }
}

test fn store_put_oversized_artifact_does_not_fit_holds() -> Bool {
  let outcome = store_put(store: oversize_store(), key: key_of(toolchain: "oversize"), artifact_bytes: byte_size(count: 500))
  (store_put_is_admitted(outcome: outcome) == false)
    && (store_put_evicted_keys(outcome: outcome) == [])
}

test fn store_put_oversized_artifact_never_evicts_itself_holds() -> Bool {
  let k = key_of(toolchain: "oversize-self")
  let evicted = store_put_evicted_keys(
    outcome: store_put(store: oversize_store(), key: k, artifact_bytes: byte_size(count: 500))
  )
  (evicted |> any(e => e == k)) == false
}

test fn store_put_oversized_artifact_preserves_warm_rows_holds() -> Bool {
  let survivor = key_of(toolchain: "warm-survivor")
  store_put_fold(
    outcome: store_put(store: oversize_store(), key: survivor, artifact_bytes: byte_size(count: 40)),
    did_not_fit: (a, b) => false,
    admitted: fn(warmed, e) {
      let outcome = store_put(store: warmed, key: key_of(toolchain: "oversize-warm"), artifact_bytes: byte_size(count: 500))
      let still_there = match store_get(store: warmed, key: survivor) {
        StoreHit { store: _, row: _ } => true
        StoreMiss { store: _ } => false
      }
      (store_put_is_admitted(outcome: outcome) == false)
        && (store_put_evicted_keys(outcome: outcome) == [])
        && still_there
    }
  )
}

test fn store_put_artifact_exactly_at_budget_is_admitted_holds() -> Bool {
  store_put_is_admitted(
    outcome: store_put(store: oversize_store(), key: key_of(toolchain: "exact"), artifact_bytes: byte_size(count: 100))
  )
}

// THE ONE CONSTRUCTION OF A STORE FROM A CEILING, AND THE DOOR THAT JUDGES A PROVIDER AGAINST IT (M1.c
// landing unit L5a): artifact_store_for_ceiling and store_over_provider_resolved. The ceiling is
// ASKED of its one home, gunbc.materialization_store_capacity, for a witness root -- the only root
// whose ceiling a fixture may choose -- so every store below is sized by a StoreCeiling that home
// answered, never by a ByteSize written here. The route this replaces, a caller's ByteSize sizing the
// store the occupancy seeds, has no spelling any more: the seed takes a built store and no budget, and
// the construction and the door take only a StoreCeiling, which is sole_constructor, so a literal one
// outside its home is a compile-time SoleConstructorViolation (the class's wall is enrolled by
// test.claim.guarantee_probe_corpus_witness_test sole_constructor_forged_literal_red_refuses). What
// that does NOT close, and these claims do not assert: a hand-built ArtifactStore record, which is an
// open type, and a WitnessScratchRoot's fixture ceiling, which is a caller's number by design and is
// admitted only under /tmp/gunbc_*. The claim over the local store's constant catalog row, which the
// commit path relies on, is not here yet: it lands with that row's retention in landing unit L5b
// (std.artifact_store artifact_store_for_ceiling's leading comment names it).

fn ceiling_derived_provider_with(id: String, capacity: CapacityPolicy) -> CacheProvider {
  provider_row(
    id: id,
    scope: [],
    coverage: CoversAllComputations,
    tier: ArtifactTier { keying: ContentKeyed },
    retention: persistent_retention(capacity: capacity)
  )
}

data ceiling_derived_provider: CacheProvider = ceiling_derived_provider_with(
  id: "ceiling-derived-test",
  capacity: CapacityBounded {
    limit: ByteCapacity { limit: RuntimeDerivedLimit { authority: materialization_store_byte_ceiling_authority } },
    at_capacity: ReplaceExisting { strategy: LeastRecentlyUsed }
  }
)

fn witness_root_ceiling(bytes: Int) -> StoreCeiling? {
  match materialization_store_byte_ceiling(root: WitnessScratchRoot { root: "/tmp/gunbc_artifact_store_witness", ceiling: byte_size(count: bytes) }) {
    StoreCeilingDeclared { ceiling: c } => Present { value: c }
    StoreCeilingUndeclared { root_path: _ } => none
  }
}

fn resolved_with_witness_ceiling(provider: CacheProvider, bytes: Int) -> StoreConstruction? {
  match witness_root_ceiling(bytes: bytes) {
    Present { value: c } => Present { value: store_over_provider_resolved(provider: provider, resolved: c) }
    Absent => none
  }
}

fn ceiling_store_is_empty_and_sized(bytes: Int) -> Bool {
  match witness_root_ceiling(bytes: bytes) {
    Present { value: c } =>
      let s = artifact_store_for_ceiling(ceiling: c)
      s.budget == byte_size(count: bytes) && (s.rows |> count) == 0 && s.next_ordinal == 1
    Absent => false
  }
}

fn resolved_is_the_ceiling_store(provider: CacheProvider, bytes: Int) -> Bool {
  match witness_root_ceiling(bytes: bytes) {
    Present { value: c } =>
      store_over_provider_resolved(provider: provider, resolved: c) == StoreReady { store: artifact_store_for_ceiling(ceiling: c) }
    Absent => false
  }
}

fn resolved_refuses_with(provider: CacheProvider, cause: StoreRefusalCause) -> Bool {
  match resolved_with_witness_ceiling(provider: provider, bytes: 100) {
    Present { value: construction } => match construction {
      StoreReady { store: _ } => false
      StoreRefusedRetention { provider_id: _, declared: _, cause: c } => c == cause
    }
    Absent => false
  }
}

// THE ONE CONSTRUCTION IS SIZED BY THE CEILING ITS HOME ANSWERED, and the store is empty and counts
// from ordinal 1. Two ceilings, two budgets. RED if the construction sized the store by a constant,
// started it holding rows, or started its counter anywhere but 1.
test fn the_ceiling_store_is_empty_and_sized_by_its_ceiling() -> Bool {
  ceiling_store_is_empty_and_sized(bytes: 100) && ceiling_store_is_empty_and_sized(bytes: 7)
}

// THE DOOR ANSWERS EXACTLY THE ONE CONSTRUCTION. A provider whose ceiling is the store ceiling's home
// passes every check, and the door's answer is StoreReady with the very store artifact_store_for_ceiling
// builds from the same ceiling, compared whole. Two ceilings. RED if the door built a store of its own
// that differs from that construction in any field, or refused a limit it exists to resolve. This is
// what keeps a store the commit builds without the door equal to the store the door would answer.
test fn the_resolved_door_answers_the_one_ceiling_construction() -> Bool {
  resolved_is_the_ceiling_store(provider: ceiling_derived_provider, bytes: 100)
    && resolved_is_the_ceiling_store(provider: ceiling_derived_provider, bytes: 7)
}

// WITHOUT ITS CEILING THE SAME PROVIDER BUILDS NO STORE: the unresolved door still answers
// CapacityValueUnresolved. RED if that door took a number from anywhere but the ceiling's home.
test fn without_its_ceiling_a_ceiling_derived_provider_refuses_as_unresolved() -> Bool {
  match store_over_provider(provider: ceiling_derived_provider) {
    StoreReady { store: _ } => false
    StoreRefusedRetention { provider_id: pid, declared: _, cause: c } =>
      (pid == "ceiling-derived-test") && (c == CapacityValueUnresolved)
  }
}

// A CEILING RESOLVES ONLY THE AUTHORITY IT IS. A provider whose byte limit names a different deriving
// authority is refused, not sized by the store ceiling. RED if the resolved arm ignored the authority.
test fn a_ceiling_does_not_resolve_a_limit_another_authority_derives() -> Bool {
  let other_authority = ceiling_derived_provider_with(
    id: "other-authority-test",
    capacity: CapacityBounded {
      limit: ByteCapacity { limit: RuntimeDerivedLimit { authority: DeclarationRef {
        module_path: "gunbc.typed_module_cache_capacity",
        decl_name: "typed_module_cache_entry_cap",
        field: WholeDeclaration
      } } },
      at_capacity: ReplaceExisting { strategy: LeastRecentlyUsed }
    }
  )
  resolved_refuses_with(provider: other_authority, cause: CapacityAuthorityMismatch)
}

// A PROVIDER THAT STATES ITS EXACT CEILING TAKES NO RESOLVED ONE BESIDE IT: two numbers for one bound
// is refused, whichever is larger. RED if the resolved door let either number win silently.
test fn a_resolved_ceiling_beside_an_exact_limit_refuses() -> Bool {
  resolved_refuses_with(provider: byte_bounded_provider, cause: ResolvedCeilingBesideExactLimit)
}

// THE RESOLVED DOOR MAKES EVERY CHECK store_over_provider MAKES, before any value is consulted and
// before it answers the one construction. One claim per refusal, each RED if the resolved door
// skipped that check.
test fn the_resolved_door_still_refuses_a_scope_released_provider() -> Bool {
  let scoped = provider_row(
    id: "scoped-ceiling-derived-test",
    scope: [],
    coverage: CoversAllComputations,
    tier: ArtifactTier { keying: ContentKeyed },
    retention: scope_released_retention(capacity: CapacityBounded {
      limit: ByteCapacity { limit: RuntimeDerivedLimit { authority: materialization_store_byte_ceiling_authority } },
      at_capacity: ReplaceExisting { strategy: LeastRecentlyUsed }
    })
  )
  resolved_refuses_with(provider: scoped, cause: ProviderScopeReleased)
}

test fn the_resolved_door_still_refuses_an_entry_count_ceiling() -> Bool {
  let entry_capped = ceiling_derived_provider_with(
    id: "entry-capped-ceiling-derived-test",
    capacity: CapacityBounded {
      limit: EntryCountCapacity { limit: RuntimeDerivedLimit { authority: materialization_store_byte_ceiling_authority } },
      at_capacity: ReplaceExisting { strategy: LeastRecentlyUsed }
    }
  )
  resolved_refuses_with(provider: entry_capped, cause: CapacityUnitMismatch)
}

test fn the_resolved_door_still_refuses_a_provider_that_refuses_new_stores() -> Bool {
  let refuses_new = ceiling_derived_provider_with(
    id: "refuse-new-ceiling-derived-test",
    capacity: CapacityBounded {
      limit: ByteCapacity { limit: RuntimeDerivedLimit { authority: materialization_store_byte_ceiling_authority } },
      at_capacity: RefuseNewStore
    }
  )
  resolved_refuses_with(provider: refuses_new, cause: RefuseNewStoreUnsupported)
}

// artifact_store_with_occupancy (M1.c landing unit L5a): the store a persistent commit rebuilds from
// the entries it finds on disk, seeded into a store already built -- here exactly the construction
// L5b's commit makes, artifact_store_for_ceiling over a witness root's ceiling, with no provider. The
// rows are supplied values: the census that observes them is landing unit L5b's, and the
// real-filesystem run of that census is its inhabitance claim, owed there.

fn occupancy_witness_row(toolchain: String, bytes: Int) -> ArtifactOccupancyRow {
  ArtifactOccupancyRow { key: key_of(toolchain: toolchain), apparent_file_bytes: byte_size(count: bytes) }
}

// Absent when the ceiling's home declared no ceiling for the witness root, so every claim below FAILS
// then rather than running over a store nothing derived.
fn occupancy_witness_ceiling_store() -> ArtifactStore? {
  match witness_root_ceiling(bytes: 100) {
    Present { value: c } => Present { value: artifact_store_for_ceiling(ceiling: c) }
    Absent => none
  }
}

fn occupancy_witness_store(occupancy: List<ArtifactOccupancyRow>) -> ArtifactStore? {
  match occupancy_witness_ceiling_store() {
    Present { value: s } => Present { value: artifact_store_with_occupancy(store: s, occupancy: occupancy) }
    Absent => none
  }
}

fn occupancy_witness_ordinal_of(store: ArtifactStore, key: ContentHash) -> Int {
  fold(store.rows, init: 0, f: (acc, r) => if r.key == key { r.last_use_ordinal } else { acc })
}

fn occupancy_witness_evicted_by_putting(store: ArtifactStore, toolchain: String, bytes: Int) -> List<ContentHash> {
  store_put_evicted_keys(outcome: store_put(store: store, key: key_of(toolchain: toolchain), artifact_bytes: byte_size(count: bytes)))
}

// ROWS IN RECENCY ORDER, LEAST RECENT FIRST: over the empty store artifact_store_for_ceiling built,
// the i-th observed row takes ordinal i + 1, the next ordinal is one past the last, the budget is the
// ceiling and the bytes are the rows' apparent file bytes. RED if ordinals were assigned in reverse,
// from 0, or left to a caller, if next_ordinal could collide with an observed row, or if seeding
// replaced the store's budget.
test fn occupancy_rows_become_a_store_in_recency_order() -> Bool {
  match occupancy_witness_store(occupancy: [occupancy_witness_row(toolchain: "old", bytes: 10), occupancy_witness_row(toolchain: "mid", bytes: 20), occupancy_witness_row(toolchain: "new", bytes: 30)]) {
    Present { value: store } =>
      occupancy_witness_ordinal_of(store: store, key: key_of(toolchain: "old")) == 1
        && occupancy_witness_ordinal_of(store: store, key: key_of(toolchain: "mid")) == 2
        && occupancy_witness_ordinal_of(store: store, key: key_of(toolchain: "new")) == 3
        && store.next_ordinal == 4
        && (store.rows |> count) == 3
        && store.budget == byte_size(count: 100)
        && store_bytes_used(store: store) == 60
    Absent => false
  }
}

// SEEDING CONTINUES THE STORE'S OWN COUNTER AND KEEPS WHAT IT HELD: a row the store already carries
// keeps its ordinal and stays least recent, observed rows follow it, and the budget is untouched. RED
// if seeding restarted ordinals at 1 (an observed row would tie the held one), dropped the held row,
// or re-sized the store.
test fn occupancy_seeding_continues_the_store_s_own_ordinals() -> Bool {
  match occupancy_witness_ceiling_store() {
    Present { value: empty } => store_put_fold(
      outcome: store_put(store: empty, key: key_of(toolchain: "held"), artifact_bytes: byte_size(count: 40)),
      did_not_fit: (a, b) => false,
      admitted: fn(held_store, evicted) {
        let seeded = artifact_store_with_occupancy(store: held_store, occupancy: [occupancy_witness_row(toolchain: "a", bytes: 10), occupancy_witness_row(toolchain: "b", bytes: 20)])
        occupancy_witness_ordinal_of(store: seeded, key: key_of(toolchain: "held")) == 1
          && occupancy_witness_ordinal_of(store: seeded, key: key_of(toolchain: "a")) == 2
          && occupancy_witness_ordinal_of(store: seeded, key: key_of(toolchain: "b")) == 3
          && seeded.next_ordinal == 4
          && (seeded.rows |> count) == 3
          && seeded.budget == held_store.budget
      }
    )
    Absent => false
  }
}

// THE OBSERVED ORDER IS THE ORDER EVICTION CONSULTS: the same two entries listed in opposite orders
// lose opposite victims to the same put. RED if construction ignored position (both orders would
// evict the same key) or evicted the most recent.
test fn occupancy_order_decides_the_eviction_victim() -> Bool {
  let a_then_b = occupancy_witness_store(occupancy: [occupancy_witness_row(toolchain: "a", bytes: 40), occupancy_witness_row(toolchain: "b", bytes: 40)])
  let b_then_a = occupancy_witness_store(occupancy: [occupancy_witness_row(toolchain: "b", bytes: 40), occupancy_witness_row(toolchain: "a", bytes: 40)])
  match a_then_b {
    Present { value: ab } => match b_then_a {
      Present { value: ba } =>
        occupancy_witness_evicted_by_putting(store: ab, toolchain: "c", bytes: 40) == [key_of(toolchain: "a")]
          && occupancy_witness_evicted_by_putting(store: ba, toolchain: "c", bytes: 40) == [key_of(toolchain: "b")]
      Absent => false
    }
    Absent => false
  }
}

// A SERVE'S RECENCY TOUCH SURVIVES THE REBUILD: after a get bumps the least recent observed entry, the
// next put evicts the other one. This is the hermetic half of the spec's wet witness (commit A and
// B, touch A, add C: only B is evicted). RED if the constructed store's ordinals did not interleave
// with store_get's (A would be evicted despite the touch).
test fn a_touched_occupancy_row_survives_the_next_eviction() -> Bool {
  match occupancy_witness_store(occupancy: [occupancy_witness_row(toolchain: "a", bytes: 40), occupancy_witness_row(toolchain: "b", bytes: 40)]) {
    Present { value: observed } => match store_get(store: observed, key: key_of(toolchain: "a")) {
      StoreHit { store: touched, row: _ } =>
        occupancy_witness_evicted_by_putting(store: touched, toolchain: "c", bytes: 40) == [key_of(toolchain: "b")]
      StoreMiss { store: _ } => false
    }
    Absent => false
  }
}

// OVER-CEILING OCCUPANCY IS KEPT, NOT REPLAYED: 180 observed bytes under a 100-byte ceiling build a
// store holding all three rows, and the ONE put that follows evicts least-recent rows until the store
// is within the ceiling, every eviction counted in that put's receipt. RED under per-row replay: a
// store_put per observed row would already have evicted a and b during construction, so the store
// would hold one row and the put's receipt would count no eviction at all.
test fn over_ceiling_occupancy_is_kept_until_the_one_put_evicts_it() -> Bool {
  match occupancy_witness_store(occupancy: [occupancy_witness_row(toolchain: "a", bytes: 60), occupancy_witness_row(toolchain: "b", bytes: 60), occupancy_witness_row(toolchain: "c", bytes: 60)]) {
    Present { value: store } =>
      let kept_all = (store.rows |> count) == 3 && store_bytes_used(store: store) == 180
      kept_all && store_put_fold(
        outcome: store_put(store: store, key: key_of(toolchain: "d"), artifact_bytes: byte_size(count: 10)),
        did_not_fit: (a, b) => false,
        admitted: (packed, evicted) =>
          evicted == [key_of(toolchain: "a"), key_of(toolchain: "b")]
            && store_bytes_used(store: packed) == 70
            && store_bytes_used(store: packed) <= measure_count(m: packed.budget)
      )
    Absent => false
  }
}

// AN ARTIFACT LARGER THAN THE CEILING DOES NOT FIT, EVEN OVER AN OVER-CEILING STORE, AND EVICTS
// NOTHING. RED if the put reached eviction before the fit test (it would have dropped observed rows
// for an artifact that cannot be stored).
test fn over_ceiling_occupancy_evicts_nothing_for_an_artifact_that_does_not_fit() -> Bool {
  match occupancy_witness_store(occupancy: [occupancy_witness_row(toolchain: "a", bytes: 60), occupancy_witness_row(toolchain: "b", bytes: 60)]) {
    Present { value: store } =>
      let outcome = store_put(store: store, key: key_of(toolchain: "huge"), artifact_bytes: byte_size(count: 101))
      store_put_fold(
        outcome: outcome,
        admitted: (s, e) => false,
        did_not_fit: (a, b) => a == byte_size(count: 101) && b == byte_size(count: 100)
      ) && store_put_evicted_keys(outcome: outcome) == []
    Absent => false
  }
}
