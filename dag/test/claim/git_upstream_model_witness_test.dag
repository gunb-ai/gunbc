      match extdeps.git.object_store.git_decode_object_id_text(
        format: extdeps.git.object_store.GitObjectFormatSha1,
        text: "1d3a06547c706bd0f75b130edecf4832295bba6b",
      ) {
        extdeps.git.object_store.GitObjectIdTextDecoded { oid } => oid == sha1_blob_regular
        extdeps.git.object_store.GitObjectIdTextRefused { cause: _ } => false
      }
    _ => false
  }
}

