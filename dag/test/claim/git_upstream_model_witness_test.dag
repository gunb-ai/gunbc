test fn witness_git_symbolic_ref_dereferences_without_losing_symbolic_identity() -> Bool {
  match extdeps.git.object_store.git_model_update_ref_exact(
    repo: git_fixture_repository(),
    name: "HEAD",
    new_oid: sha1_next_commit,
    expected_old: sha1_parent_commit,
  ) {
    extdeps.git.object_store.GitRefTransitionModeled { repository, transition } =>
      transition.requested_name == "HEAD"
        && transition.advanced_name == "refs/heads/main"
        && repository.refs == [
          extdeps.git.object_store.GitRefRecord {
            name: "refs/heads/main",
            target: extdeps.git.object_store.DirectTarget { oid: sha1_next_commit },
          },
          extdeps.git.object_store.GitRefRecord {
            name: "HEAD",
            target: extdeps.git.object_store.SymbolicTarget { ref_name: "refs/heads/main" },
          },
        ]
    _ => false
  }
}

test fn witness_git_symbolic_ref_cycle_refuses_without_mutation() -> Bool {
  let repo = git_fixture_repository()
  let cyclic = extdeps.git.object_store.GitRepositoryState {
    object_format: repo.object_format,
    objects: repo.objects,
    unavailable: repo.unavailable,
    refs: [
      extdeps.git.object_store.GitRefRecord {
        name: "HEAD",
        target: extdeps.git.object_store.SymbolicTarget { ref_name: "refs/meta/loop" },
      },
      extdeps.git.object_store.GitRefRecord {
        name: "refs/meta/loop",
        target: extdeps.git.object_store.SymbolicTarget { ref_name: "HEAD" },
      },
    ],
    index: repo.index,
    worktree: repo.worktree,
  }
  match extdeps.git.object_store.git_model_update_ref_exact(
    repo: cyclic,
    name: "HEAD",
    new_oid: sha1_next_commit,
    expected_old: sha1_parent_commit,
  ) {
    extdeps.git.object_store.GitRefAdvanceSymbolicCycle { repository, name, chain } =>
      repository == cyclic
        && name == "HEAD"
        && chain == ["HEAD", "refs/meta/loop", "HEAD"]
    _ => false
  }
}

test fn witness_git_r0_declares_later_transport_boundaries() -> Bool {
  extdeps.git.object_store.git_r0_unsupported_boundary == [
    extdeps.git.object_store.GitAttributesTransformExecution,
    extdeps.git.object_store.GitCleanSmudgeFilterExecution,
    extdeps.git.object_store.GitPackDeltaTransport,
    extdeps.git.object_store.GitShallowFetchNegotiation,
    extdeps.git.object_store.GitMultiRefTransactionExecution,
  ]
}
