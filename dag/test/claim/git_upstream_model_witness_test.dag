data sha1_blob_regular: GitObjectId = GitSha1ObjectId {
  digest: "1d3a06547c706bd0f75b130edecf4832295bba6b",
}

data sha1_blob_executable: GitObjectId = GitSha1ObjectId {
  digest: "e5224d533ef27b001224859a9b36696846a7e7fe",
}

data sha1_blob_symlink: GitObjectId = GitSha1ObjectId {
  digest: "ea786ff2cf69cdc0e487ad1cea3b8bd361eb66a3",
}

data sha1_subtree: GitObjectId = GitSha1ObjectId {
  digest: "b4039bf87f95684a5b63d40de54df03ee50c3784",
}

data sha1_empty_tree: GitObjectId = GitSha1ObjectId {
  digest: "4b825dc642cb6eb9a060e54bf8d69288fbee4904",
}

data sha1_empty_blob: GitObjectId = GitSha1ObjectId {
  digest: "e69de29bb2d1d6434b8b29ae775ad8c2e48c5391",
}

data sha1_gitlink: GitObjectId = GitSha1ObjectId {
  digest: "01659456264276d57ab43c410b6f15eb60892634",
}

data sha1_root_tree: GitObjectId = GitSha1ObjectId {
  digest: "d0cb4d7effa07dbdd7c6585c72413fc4ce06bee1",
}

data sha1_parent_commit: GitObjectId = GitSha1ObjectId {
  digest: "bd91a9ea7a010de8add58bf259276d8787545846",
}

data sha1_next_commit: GitObjectId = GitSha1ObjectId {
  digest: "0ec5705ce5bb4c179eeae463a64b69e75e0963b8",
}

data sha1_tag: GitObjectId = GitSha1ObjectId {
  digest: "d70b9ebe6a9f36bb261192c53c95da287aa71302",
}

data sha1_absent_commit: GitObjectId = GitSha1ObjectId {
  digest: "cccccccccccccccccccccccccccccccccccccccc",
}

data sha1_promisor_missing: GitObjectId = GitSha1ObjectId {
  digest: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
}

data sha256_object: GitObjectId = GitSha256ObjectId {
  digest: "cd12b0326b0ea9f272a6dc91e21e490f4cee87b47e6bffa03801420cf81f6bab",
}

fn git_r0_fixture_expected_readback_receipt() -> String {
  "sha1_blobs=grounded|sha256_blob=grounded|tree_modes=100644,100755,120000,040000,160000|non_ascii_path=preserved|index_entries=6|ref_cas=advanced|stale=refused|missing_target=refused|tag_type=tag|fsck=ok"
}

test fn witness_git_execution_receipt_binds_modeled_object_identities() -> Bool {
  let receipt = git_r0_fixture_expected_readback_receipt()
  string_contains(s: receipt, pattern: "sha1_blobs=grounded")
    && string_contains(s: receipt, pattern: "sha256_blob=grounded")
    && string_contains(
      s: receipt,
      pattern: "tree_modes=100644,100755,120000,040000,160000",
    )
    && string_contains(s: receipt, pattern: "ref_cas=advanced")
    && string_contains(s: receipt, pattern: "stale=refused")
    && string_contains(s: receipt, pattern: "missing_target=refused")
}

data fixture_author: GitAuthor = GitAuthor {
  name: "A. U. Thor",
  email: "author@example.invalid",
  timestamp: "946684800 +0000",
}

data path_regular: GitPath = GitPath { octets: [114, 101, 97, 100, 109, 101] }
data path_executable: GitPath = GitPath { octets: [114, 117, 110] }
data path_symlink: GitPath = GitPath { octets: [108, 105, 110, 107] }
data path_subtree: GitPath = GitPath { octets: [115, 114, 99] }
data path_subtree_member: GitPath = GitPath {
  octets: [115, 114, 99, 47, 107, 101, 101, 112],
}
data path_gitlink: GitPath = GitPath { octets: [118, 101, 110, 100, 111, 114] }
data path_non_ascii: GitPath = GitPath {
  octets: [195, 191, 46, 100, 97, 103],
}
data path_non_utf8: GitPath = GitPath { octets: [255, 46, 100, 97, 103] }

fn fixture_wire_entries() -> List<GitTreeWireEntry> {
  [
    GitTreeWireEntry {
      mode: "120000",
      object_type: "blob",
      oid: sha1_blob_symlink,
      path: path_symlink,
    },
    GitTreeWireEntry {
      mode: "100644",
      object_type: "blob",
      oid: sha1_blob_regular,
      path: path_regular,
    },
    GitTreeWireEntry {
      mode: "100755",
      object_type: "blob",
      oid: sha1_blob_executable,
      path: path_executable,
    },
    GitTreeWireEntry {
      mode: "040000",
      object_type: "tree",
      oid: sha1_subtree,
      path: path_subtree,
    },
    GitTreeWireEntry {
      mode: "160000",
      object_type: "commit",
      oid: sha1_gitlink,
      path: path_gitlink,
    },
    GitTreeWireEntry {
      mode: "100644",
      object_type: "blob",
      oid: sha1_blob_regular,
      path: path_non_ascii,
    },
  ]
}

fn fixture_tree() -> Tree {
  Tree {
    entries: [
      SymlinkEntry { path: path_symlink, oid: sha1_blob_symlink },
      RegularBlobEntry { path: path_regular, oid: sha1_blob_regular },
      ExecutableBlobEntry { path: path_executable, oid: sha1_blob_executable },
      SubtreeEntry { path: path_subtree, oid: sha1_subtree },
      GitlinkEntry { path: path_gitlink, oid: sha1_gitlink },
      RegularBlobEntry { path: path_non_ascii, oid: sha1_blob_regular },
    ],
  }
}

fn fixture_content_address(
  oid: GitObjectId,
  object: StoreObject,
) -> GitContentAddressReceipt {
  GitContentAddressReceipt {
    oid: oid,
    object_type: store_object_kind(object: object),
    canonical_size: git_store_object_canonical_size(object: object),
    canonical_subject: object,
    producer: GitHashObjectObserved {
      git_version: "git version 2.39.5",
      object_format: GitObjectFormatSha1,
    },
  }
}

fn fixture_stored_object(
  oid: GitObjectId,
  object: StoreObject,
) -> StoredObject {
  StoredObject {
    content_address: fixture_content_address(oid: oid, object: object),
    object: object,
  }
}

fn fixture_objects() -> List<StoredObject> {
  [
    fixture_stored_object(
      oid: sha1_blob_regular,
      object: ObjectBlob {
        blob: Blob {
          content: octets_bytes(o: [115, 111, 117, 114, 99, 101]),
        }
      },
    ),
    fixture_stored_object(
      oid: sha1_blob_executable,
      object: ObjectBlob {
        blob: Blob {
          content: octets_bytes(o: [114, 117, 110]),
        }
      },
    ),
    fixture_stored_object(
      oid: sha1_blob_symlink,
      object: ObjectBlob {
        blob: Blob {
          content: octets_bytes(o: [114, 101, 97, 100, 109, 101]),
        }
      },
    ),
    fixture_stored_object(
      oid: sha1_subtree,
      object: ObjectTree {
        tree: Tree {
          entries: [
            RegularBlobEntry {
              path: GitPath { octets: [107, 101, 101, 112] },
              oid: sha1_empty_blob,
            },
          ],
        }
      },
    ),
    fixture_stored_object(
      oid: sha1_empty_blob,
      object: ObjectBlob {
        blob: Blob {
          content: octets_bytes(o: []),
        }
      },
    ),
    fixture_stored_object(
      oid: sha1_empty_tree,
      object: ObjectTree { tree: Tree { entries: [] } },
    ),
    fixture_stored_object(
      oid: sha1_gitlink,
      object: ObjectCommit {
        commit: Commit {
          tree: sha1_empty_tree,
          parents: [],
          author: fixture_author,
          committer: fixture_author,
          message: "gitlink",
        }
      },
    ),
    fixture_stored_object(
      oid: sha1_root_tree,
      object: ObjectTree { tree: fixture_tree() },
    ),
    fixture_stored_object(
      oid: sha1_parent_commit,
      object: ObjectCommit {
        commit: Commit {
          tree: sha1_root_tree,
          parents: [],
          author: fixture_author,
          committer: fixture_author,
          message: "parent",
        }
      },
    ),
    fixture_stored_object(
      oid: sha1_next_commit,
      object: ObjectCommit {
        commit: Commit {
          tree: sha1_root_tree,
          parents: [sha1_parent_commit],
          author: fixture_author,
          committer: fixture_author,
          message: "next",
        }
      },
    ),
    fixture_stored_object(
      oid: sha1_tag,
      object: ObjectTag {
        tag: AnnotatedTag {
          target: sha1_parent_commit,
          target_type: CommitObj,
          name: "v0",
          tagger: fixture_author,
          message: "bounded annotated tag",
        }
      },
    ),
  ]
}

fn fixture_repository() -> GitRepositoryState {
  let decoded = fixture_tree()
  GitRepositoryState {
    object_format: GitObjectFormatSha1,
    objects: fixture_objects(),
    unavailable: [
      GitPromisorObjectUnavailable {
        oid: sha1_promisor_missing,
        promisor: "origin",
      },
    ],
    refs: [
      GitRefRecord {
        name: "refs/heads/main",
        target: DirectTarget { oid: sha1_parent_commit },
      },
      GitRefRecord {
        name: "HEAD",
        target: SymbolicTarget { ref_name: "refs/heads/main" },
      },
    ],
    index: [
      GitIndexEntry {
        path: path_symlink,
        entry: SymlinkEntry { path: path_symlink, oid: sha1_blob_symlink },
        stage: GitIndexStageNormal,
      },
      GitIndexEntry {
        path: path_regular,
        entry: RegularBlobEntry { path: path_regular, oid: sha1_blob_regular },
        stage: GitIndexStageNormal,
      },
      GitIndexEntry {
        path: path_executable,
        entry: ExecutableBlobEntry { path: path_executable, oid: sha1_blob_executable },
        stage: GitIndexStageNormal,
      },
      GitIndexEntry {
        path: path_subtree_member,
        entry: RegularBlobEntry { path: path_subtree_member, oid: sha1_empty_blob },
        stage: GitIndexStageNormal,
      },
      GitIndexEntry {
        path: path_gitlink,
        entry: GitlinkEntry { path: path_gitlink, oid: sha1_gitlink },
        stage: GitIndexStageNormal,
      },
      GitIndexEntry {
        path: path_non_ascii,
        entry: RegularBlobEntry { path: path_non_ascii, oid: sha1_blob_regular },
        stage: GitIndexStageNormal,
      },
    ],
    worktree: [
      GitWorktreeRegular {
        path: path_regular,
        executable: false,
        content: octets_bytes(o: [115, 111, 117, 114, 99, 101]),
      },
      GitWorktreeRegular {
        path: path_executable,
        executable: true,
        content: octets_bytes(o: [114, 117, 110]),
      },
      GitWorktreeRegular {
        path: path_non_ascii,
        executable: false,
        content: octets_bytes(o: [115, 111, 117, 114, 99, 101]),
      },
      GitWorktreeRegular {
        path: path_subtree_member,
        executable: false,
        content: octets_bytes(o: []),
      },
      GitWorktreeSymlink {
        path: path_symlink,
        target: octets_bytes(o: [114, 101, 97, 100, 109, 101]),
      },
    ],
  }
}

test fn witness_git_tree_modes_and_raw_paths_decode_without_collapse() -> Bool {
  match git_decode_tree(entries: fixture_wire_entries()) {
    GitTreeDecodeRefused { cause: _ } => false
    GitTreeDecoded { entries } =>
      entries == fixture_tree().entries
        && match git_decode_tree(entries: [
          GitTreeWireEntry {
            mode: "100644",
            object_type: "blob",
            oid: sha1_blob_regular,
            path: path_non_utf8,
          },
        ]) {
          GitTreeDecoded { entries: raw_entries } =>
            match raw_entries.first() {
              Present { value: RegularBlobEntry { path, oid: _ } } =>
                path == path_non_utf8
              _ => false
            }
          GitTreeDecodeRefused { cause: _ } => false
        }
  }
}

test fn witness_git_ls_tree_z_wire_decodes_into_mode_path_and_identity_rows() -> Bool {
  let nul = from_code_point(0)
  let text = concat(
    join(
      [
        "120000",
        "blob",
        git_object_id_content_hash(oid: sha1_blob_symlink) as String,
        "link",
        "100644",
        "blob",
        git_object_id_content_hash(oid: sha1_blob_regular) as String,
        "readme",
        "100755",
        "blob",
        git_object_id_content_hash(oid: sha1_blob_executable) as String,
        "run",
        "040000",
        "tree",
        git_object_id_content_hash(oid: sha1_subtree) as String,
        "src",
        "160000",
        "commit",
        git_object_id_content_hash(oid: sha1_gitlink) as String,
        "vendor",
        "100644",
        "blob",
        git_object_id_content_hash(oid: sha1_blob_regular) as String,
        concat(from_code_point(255), ".dag"),
      ],
      nul,
    ),
    nul,
  )
  match git_decode_ls_tree_z(
    payload: utf8_encode_bytes(s: text),
    format: GitObjectFormatSha1,
  ) {
    GitLsTreeZDecoded { entries } => entries == fixture_wire_entries()
    GitLsTreeZRefused { cause: _ } => false
  }
}

test fn witness_git_ls_tree_z_preserves_non_utf8_path_octets() -> Bool {
  let nul = from_code_point(0)
  let header = concat(
    join(
      [
        "100644",
        "blob",
        git_object_id_content_hash(oid: sha1_blob_regular) as String,
      ],
      nul,
    ),
    nul,
  )
  let payload = octets_bytes(
    o: append(
      bytes_octets(b: utf8_encode_bytes(s: header)),
      items: [255, 46, 100, 97, 103, 0],
    ),
  )
  match git_decode_ls_tree_z(
    payload: payload,
    format: GitObjectFormatSha1,
  ) {
    GitLsTreeZDecoded { entries } =>
      entries == [
        GitTreeWireEntry {
          mode: "100644",
          object_type: "blob",
          oid: sha1_blob_regular,
          path: path_non_utf8,
        },
      ]
    GitLsTreeZRefused { cause: _ } => false
  }
}

test fn witness_git_ls_files_stage_z_observes_mode_identity_stage_and_raw_path() -> Bool {
  let nul = from_code_point(0)
  let header = concat(
    join(
      [
        "100644",
        git_object_id_content_hash(oid: sha1_blob_regular) as String,
        "0",
      ],
      nul,
    ),
    nul,
  )
  let payload = octets_bytes(
    o: append(
      bytes_octets(b: utf8_encode_bytes(s: header)),
      items: [255, 46, 100, 97, 103, 0],
    ),
  )
  match git_decode_ls_files_stage_z(
    payload: payload,
    format: GitObjectFormatSha1,
  ) {
    GitLsFilesStageZDecoded { entries } =>
      entries == [
        GitIndexEntry {
          path: path_non_utf8,
          entry: RegularBlobEntry {
            path: path_non_utf8,
            oid: sha1_blob_regular,
          },
          stage: GitIndexStageNormal,
        },
      ]
    GitLsFilesStageZRefused { cause: _ } => false
  }
}

test fn witness_git_bounded_fixture_projects_declared_fragment() -> Bool {
  let repo = fixture_repository()
  match git_project_repository(repo: repo, tree_oid: sha1_root_tree) {
    GitProjectionRefused { cause: _ } => false
    GitProjected { projection } =>
      projection.object_format == GitObjectFormatSha1
        && count(projection.tree_entries) == 6
        && count(projection.tags) == 1
        && count(projection.index) == 6
        && count(projection.worktree) == 5
  }
}

fn fixture_read_back_observation() -> GitR0ReadBackObservation {
  let repo = fixture_repository()
  GitR0ReadBackObservation {
    git_version: "git version 2.39.5",
    object_format: GitObjectFormatSha1,
    tree_oid: sha1_root_tree,
    tree_entries: fixture_wire_entries(),
    tag_oids: [sha1_tag],
    refs: repo.refs,
    index: repo.index,
    worktree: repo.worktree,
    unavailable: repo.unavailable,
  }
}

test fn witness_git_readback_comparison_rejects_perturbed_observation() -> Bool {
  match git_project_repository(repo: fixture_repository(), tree_oid: sha1_root_tree) {
    GitProjectionRefused { cause: _ } => false
    GitProjected { projection } =>
      let observed = fixture_read_back_observation()
      let perturbed = GitR0ReadBackObservation {
        git_version: observed.git_version,
        object_format: observed.object_format,
        tree_oid: sha1_absent_commit,
        tree_entries: observed.tree_entries,
        tag_oids: observed.tag_oids,
        refs: observed.refs,
        index: observed.index,
        worktree: observed.worktree,
        unavailable: observed.unavailable,
      }
      match git_verify_independent_read_back(
        projection: projection,
        observation: perturbed,
      ) {
        GitReadBackMismatch { axis: _ } => true
        GitReadBackVerified { observation: _ } => false
      }
  }
}

test fn witness_git_mode_object_mismatch_refuses() -> Bool {
  match git_decode_tree(entries: [
    GitTreeWireEntry {
      mode: "100755",
      object_type: "commit",
      oid: sha1_gitlink,
      path: path_executable,
    },
  ]) {
    GitTreeDecodeRefused { cause: _ } => true
    GitTreeDecoded { entries: _ } => false
  }
}

test fn witness_git_annotated_tag_remains_a_tag_object() -> Bool {
  let tags = fixture_objects() |> filter(o => stored_object_oid(stored: o) == sha1_tag)
  match tags.first() {
    Present { value } => store_object_kind(object: value.object) == TagObj
    Absent => false
  }
}

test fn witness_git_object_format_is_part_of_identity() -> Bool {
  !(sha1_blob_regular == sha256_object)
    && git_object_id_format(oid: sha1_blob_regular) == GitObjectFormatSha1
    && git_object_id_format(oid: sha256_object) == GitObjectFormatSha256
}

test fn witness_git_promisor_missing_never_decodes_as_empty_object() -> Bool {
  match git_lookup_object(repo: fixture_repository(), oid: sha1_promisor_missing) {
    ObjectPromisorUnavailable { oid, promisor } =>
      oid == sha1_promisor_missing && promisor == "origin"
    _ => false
  }
}

test fn witness_git_content_address_kind_mismatch_refuses_as_corrupt() -> Bool {
  let repo = fixture_repository()
  let object = ObjectBlob {
    blob: Blob {
      content: octets_bytes(o: [115, 111, 117, 114, 99, 101]),
    }
  }
  let observed = fixture_content_address(
    oid: sha1_blob_regular,
    object: object,
  )
  let forged = StoredObject {
    content_address: GitContentAddressReceipt {
      oid: observed.oid,
      object_type: TagObj,
      canonical_size: observed.canonical_size,
      canonical_subject: observed.canonical_subject,
      producer: observed.producer,
    },
    object: object,
  }
  let invalid = GitRepositoryState {
    object_format: repo.object_format,
    objects: append(
      repo.objects |> filter(object =>
        !(stored_object_oid(stored: object) == sha1_blob_regular)
      ),
      items: [forged],
    ),
    unavailable: repo.unavailable,
    refs: repo.refs,
    index: repo.index,
    worktree: repo.worktree,
  }
  match git_lookup_object(repo: invalid, oid: sha1_blob_regular) {
    ObjectCorrupt { oid, reason: _ } => oid == sha1_blob_regular
    _ => false
  }
}

test fn witness_git_content_address_binds_subject_and_canonical_size() -> Bool {
  let repo = fixture_repository()
  let observed_subject = ObjectBlob {
    blob: Blob {
      content: octets_bytes(o: [115, 111, 117, 114, 99, 101]),
    }
  }
  let receipt = fixture_content_address(
    oid: sha1_blob_regular,
    object: observed_subject,
  )
  let different_object = ObjectBlob {
    blob: Blob {
      content: octets_bytes(o: [114, 117, 110]),
    }
  }
  let subject_mismatch = StoredObject {
    content_address: receipt,
    object: different_object,
  }
  let size_mismatch = StoredObject {
    content_address: GitContentAddressReceipt {
      oid: receipt.oid,
      object_type: receipt.object_type,
      canonical_size: byte_size(count: 99),
      canonical_subject: receipt.canonical_subject,
      producer: receipt.producer,
    },
    object: observed_subject,
  }
  let without_original = repo.objects |> filter(object =>
    !(stored_object_oid(stored: object) == sha1_blob_regular)
  )
  let subject_repo = GitRepositoryState {
    object_format: repo.object_format,
    objects: append(without_original, items: [subject_mismatch]),
    unavailable: repo.unavailable,
    refs: repo.refs,
    index: repo.index,
    worktree: repo.worktree,
  }
  let size_repo = GitRepositoryState {
    object_format: repo.object_format,
    objects: append(without_original, items: [size_mismatch]),
    unavailable: repo.unavailable,
    refs: repo.refs,
    index: repo.index,
    worktree: repo.worktree,
  }
  match git_lookup_object(repo: subject_repo, oid: sha1_blob_regular) {
    ObjectCorrupt { oid, reason: _ } =>
      oid == sha1_blob_regular
        && match git_lookup_object(repo: size_repo, oid: sha1_blob_regular) {
          ObjectCorrupt { oid: sized_oid, reason: _ } =>
            sized_oid == sha1_blob_regular
          _ => false
        }
    _ => false
  }
}

test fn witness_git_exact_old_oid_transition_model_preserves_expected_state() -> Bool {
  match git_model_update_ref_exact(
    repo: fixture_repository(),
    name: "refs/heads/main",
    new_oid: sha1_next_commit,
    expected_old: sha1_parent_commit,
  ) {
    GitRefTransitionModeled { repository, transition } =>
      transition.expected_old == sha1_parent_commit
        && transition.new == sha1_next_commit
        && match git_resolve_direct_ref(repo: repository, name: "refs/heads/main") {
          RefResolved { oid } => oid == sha1_next_commit
          _ => false
        }
    _ => false
  }
}

test fn witness_git_duplicate_ref_names_refuse_exact_transition() -> Bool {
  let repo = fixture_repository()
  let duplicate = GitRepositoryState {
    object_format: repo.object_format,
    objects: repo.objects,
    unavailable: repo.unavailable,
    refs: append(
      repo.refs,
      items: [
        GitRefRecord {
          name: "refs/heads/main",
          target: DirectTarget { oid: sha1_next_commit },
        },
      ],
    ),
    index: repo.index,
    worktree: repo.worktree,
  }
  match git_model_update_ref_exact(
    repo: duplicate,
    name: "refs/heads/main",
    new_oid: sha1_next_commit,
    expected_old: sha1_parent_commit,
  ) {
    GitRefAdvanceDuplicate { repository, name, count } =>
      repository == duplicate
        && name == "refs/heads/main"
        && count == 2
        && match git_resolve_direct_ref(
          repo: repository,
          name: "refs/heads/main",
        ) {
          RefDuplicate { name: duplicate_name, count: duplicate_count } =>
            duplicate_name == name && duplicate_count == count
          _ => false
        }
    _ => false
  }
}

test fn witness_git_stale_expected_oid_refuses_without_mutation() -> Bool {
  let repo = fixture_repository()
  match git_model_update_ref_exact(
    repo: repo,
    name: "refs/heads/main",
    new_oid: sha1_next_commit,
    expected_old: sha1_blob_regular,
  ) {
    GitRefAdvanceStale { repository, name: _, expected_old, observed } =>
      expected_old == sha1_blob_regular
        && observed == sha1_parent_commit
        && repository == repo
        && match git_resolve_direct_ref(repo: repository, name: "refs/heads/main") {
          RefResolved { oid } => oid == sha1_parent_commit
          _ => false
        }
    _ => false
  }
}

test fn witness_git_missing_new_object_refuses_without_mutation() -> Bool {
  let repo = fixture_repository()
  match git_model_update_ref_exact(
    repo: repo,
    name: "refs/heads/main",
    new_oid: sha1_absent_commit,
    expected_old: sha1_parent_commit,
  ) {
    GitRefAdvanceTargetUnavailable { repository, oid, lookup: _ } =>
      repository == repo
        && oid == sha1_absent_commit
        && match git_resolve_direct_ref(repo: repository, name: "refs/heads/main") {
          RefResolved { oid: observed } => observed == sha1_parent_commit
          _ => false
        }
    _ => false
  }
}

test fn witness_git_mismatched_object_format_refuses_without_mutation() -> Bool {
  let repo = fixture_repository()
  match git_model_update_ref_exact(
    repo: repo,
    name: "refs/heads/main",
    new_oid: sha256_object,
    expected_old: sha1_parent_commit,
  ) {
    GitRefAdvanceFormatMismatch { repository, repository_format, oid } =>
      repository == repo
        && repository_format == GitObjectFormatSha1
        && oid == sha256_object
    _ => false
  }
}

test fn witness_git_symbolic_ref_is_not_silently_advanced_as_direct() -> Bool {
  match git_model_update_ref_exact(
    repo: fixture_repository(),
    name: "HEAD",
    new_oid: sha1_next_commit,
    expected_old: sha1_parent_commit,
  ) {
    GitRefAdvanceSymbolic { repository: _, name, target } =>
      name == "HEAD" && target == "refs/heads/main"
    _ => false
  }
}

test fn witness_git_r0_declares_later_transport_boundaries() -> Bool {
  git_r0_unsupported_boundary == [
    GitAttributesTransformExecution,
    GitCleanSmudgeFilterExecution,
    GitPackDeltaTransport,
    GitShallowFetchNegotiation,
    GitMultiRefTransactionExecution,
  ]
}
