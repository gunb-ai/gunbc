test fn witness_git_caller_asserted_well_formed_wrong_oid_never_admits() -> Bool {
  let repo = git_fixture_repository()
  let subject = extdeps.git.object_store.ObjectBlob {
    blob: extdeps.git.object_store.Blob {
      content: std.bytes.octets_bytes(o: [115, 111, 117, 114, 99, 101]),
    }
  }
  match extdeps.git.object_store.git_store_object_canonical_hash_input(object: subject) {
    extdeps.git.object_store.GitCanonicalHashInputRefused { cause: _ } => false
    extdeps.git.object_store.GitCanonicalHashInputReady { bytes } =>
      let asserted = extdeps.git.object_store.StoredObject {
        oid: sha1_blob_executable,
        content_address: extdeps.git.object_store.GitHashObjectObserved {
          git_version: "caller-authored",
          object_format: extdeps.git.object_store.GitObjectFormatSha1,
          canonical_input: bytes,
          observed_oid: sha1_blob_executable,
          producer: extdeps.git.object_store.GitHashObjectCallerAssertion,
        },
        object: subject,
      }
      let invalid = extdeps.git.object_store.GitRepositoryState {
        object_format: repo.object_format,
        objects: append(
          repo.objects |> filter(object =>
            !(extdeps.git.object_store.stored_object_oid(stored: object) == sha1_blob_executable)
          ),
          items: [asserted],
        ),
        unavailable: repo.unavailable,
        refs: repo.refs,
        index: repo.index,
        worktree: repo.worktree,
      }
      match extdeps.git.object_store.git_decode_repository(repo: invalid) {
        extdeps.git.object_store.GitRepositoryDecodeRefused {
          cause: extdeps.git.object_store.GitRepositoryStoredObjectUnadmitted { oid },
        } => oid == sha1_blob_executable
        _ => false
      }
  }
}

test fn witness_git_tree_reference_must_be_present_or_promisor_declared() -> Bool {
  let repo = git_fixture_repository()
  let missing = extdeps.git.object_store.GitRepositoryState {
    object_format: repo.object_format,
    objects: repo.objects |> filter(object =>
      !(extdeps.git.object_store.stored_object_oid(stored: object) == sha1_subtree)
    ),
    unavailable: append(
      repo.unavailable,
      items: [
        extdeps.git.object_store.GitUnexpectedObjectMissing { oid: sha1_subtree },
      ],
    ),
    refs: repo.refs,
    index: repo.index,
    worktree: repo.worktree,
  }
  match extdeps.git.object_store.git_decode_repository(repo: missing) {
    extdeps.git.object_store.GitRepositoryDecodeRefused {
      cause: extdeps.git.object_store.GitRepositoryPointerUnexpectedlyMissing {
        origin: _,
        target,
      },
    } => target == sha1_subtree
    _ => false
  }
}

test fn witness_git_promisor_declared_tree_reference_stays_partial() -> Bool {
  let repo = git_fixture_repository()
  let partial = extdeps.git.object_store.GitRepositoryState {
    object_format: repo.object_format,
    objects: repo.objects |> filter(object =>
      !(extdeps.git.object_store.stored_object_oid(stored: object) == sha1_subtree)
    ),
    unavailable: append(
      repo.unavailable,
      items: [
        extdeps.git.object_store.GitPromisorObjectUnavailable {
          oid: sha1_subtree,
          promisor: "origin",
        },
      ],
    ),
    refs: repo.refs,
    index: repo.index,
    worktree: repo.worktree,
  }
  match extdeps.git.object_store.git_decode_repository(repo: partial) {
    extdeps.git.object_store.GitRepositoryDecoded { repository: _ } => true
    _ => false
  }
}

test fn witness_git_branch_ref_to_corrupt_object_refuses_repository() -> Bool {
  let repo = git_fixture_repository()
  let corrupt = extdeps.git.object_store.GitRepositoryState {
    object_format: repo.object_format,
    objects: repo.objects,
    unavailable: append(
      repo.unavailable,
      items: [
        extdeps.git.object_store.GitCorruptObject {
          oid: sha1_absent_commit,
          reason: "fixture-corrupt-object",
        },
      ],
    ),
    refs: repo.refs |> map(record =>
      if record.name == "refs/heads/main" {
        extdeps.git.object_store.GitRefRecord {
          name: record.name,
          target: extdeps.git.object_store.DirectTarget { oid: sha1_absent_commit },
        }
      } else {
        record
      }
    ),
    index: repo.index,
    worktree: repo.worktree,
  }
  match extdeps.git.object_store.git_decode_repository(repo: corrupt) {
    extdeps.git.object_store.GitRepositoryDecodeRefused {
      cause: extdeps.git.object_store.GitRepositoryPointerCorrupt {
        origin: _,
        target,
        reason,
      },
    } =>
      target == sha1_absent_commit
        && reason == "fixture-corrupt-object"
    _ => false
  }
}

test fn witness_git_exact_old_oid_transition_model_preserves_expected_state() -> Bool {
  match extdeps.git.object_store.git_model_update_ref_exact(
    repo: git_fixture_repository(),
    name: "refs/heads/main",
    new_oid: sha1_next_commit,
    expected_old: sha1_parent_commit,
  ) {
    extdeps.git.object_store.GitRefTransitionModeled { repository, transition } =>
      transition.requested_name == "refs/heads/main"
        && transition.advanced_name == "refs/heads/main"
        && transition.expected_old == sha1_parent_commit
        && transition.new == sha1_next_commit
        && match extdeps.git.object_store.git_resolve_direct_ref(repo: repository, name: "refs/heads/main") {
          extdeps.git.object_store.RefResolved { oid } => oid == sha1_next_commit
          _ => false
        }
    _ => false
  }
}

test fn witness_git_duplicate_ref_names_refuse_exact_transition() -> Bool {
  let repo = git_fixture_repository()
  let duplicate = extdeps.git.object_store.GitRepositoryState {
    object_format: repo.object_format,
    objects: repo.objects,
    unavailable: repo.unavailable,
    refs: append(
      repo.refs,
      items: [
        extdeps.git.object_store.GitRefRecord {
          name: "refs/heads/main",
          target: extdeps.git.object_store.DirectTarget { oid: sha1_next_commit },
        },
      ],
    ),
    index: repo.index,
    worktree: repo.worktree,
  }
  match extdeps.git.object_store.git_model_update_ref_exact(
    repo: duplicate,
    name: "refs/heads/main",
    new_oid: sha1_next_commit,
    expected_old: sha1_parent_commit,
  ) {
    extdeps.git.object_store.GitRefAdvanceRepositoryInvalid {
      repository,
      cause: extdeps.git.object_store.GitRepositoryDuplicateRef { name, count },
    } =>
      repository == duplicate
        && name == "refs/heads/main"
        && count == 2
        && match extdeps.git.object_store.git_resolve_direct_ref(
          repo: repository,
          name: "refs/heads/main",
        ) {
          extdeps.git.object_store.RefDuplicate { name: duplicate_name, count: duplicate_count } =>
            duplicate_name == name && duplicate_count == count
          _ => false
        }
    _ => false
  }
}

test fn witness_git_stale_expected_oid_refuses_without_mutation() -> Bool {
  let repo = git_fixture_repository()
  match extdeps.git.object_store.git_model_update_ref_exact(
    repo: repo,
    name: "refs/heads/main",
    new_oid: sha1_next_commit,
    expected_old: sha1_blob_regular,
  ) {
    extdeps.git.object_store.GitRefAdvanceStale { repository, name: _, expected_old, observed } =>
      expected_old == sha1_blob_regular
        && observed == sha1_parent_commit
        && repository == repo
        && match extdeps.git.object_store.git_resolve_direct_ref(repo: repository, name: "refs/heads/main") {
          extdeps.git.object_store.RefResolved { oid } => oid == sha1_parent_commit
          _ => false
        }
    _ => false
  }
}

test fn witness_git_missing_new_object_refuses_without_mutation() -> Bool {
  let repo = git_fixture_repository()
  match extdeps.git.object_store.git_model_update_ref_exact(
    repo: repo,
    name: "refs/heads/main",
