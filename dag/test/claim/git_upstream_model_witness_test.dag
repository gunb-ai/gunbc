  ]) {
    extdeps.git.object_store.GitTreeDecodeRefused { cause: _ } => true
    extdeps.git.object_store.GitTreeDecoded { entries: _ } => false
  }
}

test fn witness_git_annotated_tag_remains_a_tag_object() -> Bool {
  let tags = fixture_objects() |> filter(o => extdeps.git.object_store.stored_object_oid(stored: o) == sha1_tag)
  match tags.first() {
    Present { value } => extdeps.git.object_store.store_object_kind(object: value.object) == extdeps.git.TagObj
    Absent => false
  }
}

test fn witness_git_object_format_is_part_of_identity() -> Bool {
  !(sha1_blob_regular == sha256_object)
    && extdeps.git.object_store.git_object_id_format(oid: sha1_blob_regular) == extdeps.git.object_store.GitObjectFormatSha1
    && extdeps.git.object_store.git_object_id_format(oid: sha256_object) == extdeps.git.object_store.GitObjectFormatSha256
}

test fn witness_git_promisor_missing_never_decodes_as_empty_object() -> Bool {
  match extdeps.git.object_store.git_lookup_object(repo: git_fixture_repository(), oid: sha1_promisor_missing) {
    extdeps.git.object_store.ObjectPromisorUnavailable { oid, promisor } =>
      oid == sha1_promisor_missing && promisor == "origin"
    _ => false
  }
}

test fn witness_git_content_address_kind_mismatch_refuses_repository_decode() -> Bool {
  let repo = git_fixture_repository()
  let observed_object = extdeps.git.object_store.ObjectBlob {
    blob: extdeps.git.object_store.Blob {
      content: std.bytes.octets_bytes(o: [115, 111, 117, 114, 99, 101]),
    }
  }
  let observed = fixture_content_address(
    oid: sha1_blob_regular,
    object: observed_object,
  )
  let forged = extdeps.git.object_store.StoredObject {
    oid: sha1_blob_regular,
    content_address: observed,
    object: extdeps.git.object_store.ObjectTag {
      tag: extdeps.git.object_store.AnnotatedTag {
        target: sha1_parent_commit,
        target_type: extdeps.git.CommitObj,
        name: "forged",
        tagger: fixture_author,
        message: std.bytes.utf8_encode_bytes(s: "forged\n"),
      }
    },
  }
  let invalid = extdeps.git.object_store.GitRepositoryState {
    object_format: repo.object_format,
    objects: append(
      repo.objects |> filter(object =>
        !(extdeps.git.object_store.stored_object_oid(stored: object) == sha1_blob_regular)
      ),
      items: [forged],
    ),
    unavailable: repo.unavailable,
    refs: repo.refs,
    index: repo.index,
    worktree: repo.worktree,
  }
  match extdeps.git.object_store.git_lookup_object(repo: invalid, oid: sha1_blob_regular) {
    extdeps.git.object_store.ObjectRepositoryInvalid {
      cause: extdeps.git.object_store.GitRepositoryStoredObjectUnadmitted { oid },
    } => oid == sha1_blob_regular
    _ => false
  }
}

test fn witness_git_content_address_binds_observed_oid_and_exact_hash_input() -> Bool {
  let repo = git_fixture_repository()
  let observed_subject = extdeps.git.object_store.ObjectBlob {
    blob: extdeps.git.object_store.Blob {
      content: std.bytes.octets_bytes(o: [115, 111, 117, 114, 99, 101]),
    }
  }
  let receipt = fixture_content_address(
    oid: sha1_blob_regular,
    object: observed_subject,
  )
  let observation_grounded = match receipt {
    extdeps.git.object_store.GitHashObjectObserved {
      git_version: _,
      object_format,
      canonical_input,
      observed_oid,
      producer,
    } =>
      object_format == extdeps.git.object_store.GitObjectFormatSha1
        && observed_oid == sha1_blob_regular
        && match producer {
          extdeps.git.object_store.GitHashObjectCliExecuted {
            attempt: _,
            exit_code,
            stdout_oid,
          } =>
            exit_code == 0 && stdout_oid == observed_oid
          extdeps.git.object_store.GitHashObjectCallerAssertion => false
        }
        && std.bytes.bytes_octets(b: canonical_input) == [
          98, 108, 111, 98, 32, 54, 0,
          115, 111, 117, 114, 99, 101,
        ]
    extdeps.git.object_store.GitHashObjectObservationUnavailable { cause: _ } => false
  }
  let different_object = extdeps.git.object_store.ObjectBlob {
    blob: extdeps.git.object_store.Blob {
      content: std.bytes.octets_bytes(o: [114, 101, 97, 100, 109, 101]),
    }
  }
  let input_mismatch = extdeps.git.object_store.StoredObject {
    oid: sha1_blob_regular,
    content_address: receipt,
    object: different_object,
  }
  let oid_mismatch = extdeps.git.object_store.StoredObject {
    oid: sha1_blob_executable,
    content_address: fixture_content_address(
      oid: sha1_blob_regular,
      object: observed_subject,
    ),
    object: observed_subject,
  }
  let without_original = repo.objects |> filter(object =>
    !(extdeps.git.object_store.stored_object_oid(stored: object) == sha1_blob_regular)
  )
  let input_repo = extdeps.git.object_store.GitRepositoryState {
    object_format: repo.object_format,
    objects: append(without_original, items: [input_mismatch]),
    unavailable: repo.unavailable,
    refs: repo.refs,
    index: repo.index,
    worktree: repo.worktree,
  }
  let oid_repo = extdeps.git.object_store.GitRepositoryState {
    object_format: repo.object_format,
    objects: append(
      repo.objects |> filter(object =>
        !(extdeps.git.object_store.stored_object_oid(stored: object) == sha1_blob_executable)
      ),
      items: [oid_mismatch],
    ),
    unavailable: repo.unavailable,
    refs: repo.refs,
    index: repo.index,
    worktree: repo.worktree,
  }
  match extdeps.git.object_store.git_lookup_object(repo: input_repo, oid: sha1_blob_regular) {
    extdeps.git.object_store.ObjectRepositoryInvalid {
      cause: extdeps.git.object_store.GitRepositoryStoredObjectUnadmitted { oid },
    } =>
      observation_grounded
        && oid == sha1_blob_regular
        && match extdeps.git.object_store.git_lookup_object(repo: oid_repo, oid: sha1_blob_executable) {
          extdeps.git.object_store.ObjectRepositoryInvalid {
            cause: extdeps.git.object_store.GitRepositoryStoredObjectUnadmitted {
              oid: sized_oid,
            },
          } =>
            sized_oid == sha1_blob_executable
          _ => false
        }
    _ => false
  }
}

test fn witness_git_duplicate_stored_identity_refuses_without_list_order() -> Bool {
  let repo = git_fixture_repository()
  let conflicting = extdeps.git.object_store.StoredObject {
    oid: sha1_blob_regular,
    content_address: fixture_content_address(
      oid: sha1_blob_regular,
      object: extdeps.git.object_store.ObjectBlob {
        blob: extdeps.git.object_store.Blob {
          content: std.bytes.octets_bytes(o: [100, 105, 102, 102, 101, 114, 101, 110, 116]),
        }
      },
    ),
    object: extdeps.git.object_store.ObjectBlob {
      blob: extdeps.git.object_store.Blob {
        content: std.bytes.octets_bytes(o: [100, 105, 102, 102, 101, 114, 101, 110, 116]),
      }
    },
  }
  let duplicate = extdeps.git.object_store.GitRepositoryState {
    object_format: repo.object_format,
    objects: append(repo.objects, items: [conflicting]),
    unavailable: repo.unavailable,
    refs: repo.refs,
    index: repo.index,
    worktree: repo.worktree,
  }
  match extdeps.git.object_store.git_decode_repository(repo: duplicate) {
    extdeps.git.object_store.GitRepositoryDecodeRefused {
      cause: extdeps.git.object_store.GitRepositoryDuplicateStoredObject { oid },
    } => oid == sha1_blob_regular
    _ => false
  }
}

