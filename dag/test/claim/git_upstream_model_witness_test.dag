test fn witness_git_ls_files_stage_z_path_containing_space_and_tab_survives_intact() -> Bool {
  let space = " "
  let tab = from_code_point(9)
  let header = concat(
    join(
      [
        "100644",
        extdeps.git.object_store.git_object_id_wire_hex(oid: sha1_empty_blob) as String,
        "0",
      ],
      space,
    ),
    tab,
  )
  let raw_path_octets = [104, 97, 115, 32, 115, 112, 97, 99, 101, 9, 116, 97, 98, 46, 116, 120, 116]
  let payload = std.bytes.octets_bytes(
    o: append(
      std.bytes.bytes_octets(b: std.bytes.utf8_encode_bytes(s: header)),
      items: append(raw_path_octets, items: [0]),
    ),
  )
  match extdeps.git.object_store.git_decode_ls_files_stage_z(
    payload: payload,
    format: extdeps.git.object_store.GitObjectFormatSha1,
  ) {
    extdeps.git.object_store.GitLsFilesStageZDecoded { entries } =>
      match entries {
        std.algebra.Cons { head: extdeps.git.object_store.GitIndexEntry { mode, oid, stage, path }, tail: std.algebra.Empty } =>
          mode == extdeps.git.object_store.GitRegularBlobMode
            && oid == sha1_empty_blob
            && stage == extdeps.git.object_store.GitIndexStageNormal
            && extdeps.git.object_store.git_path_octets(path: path) == raw_path_octets
        _ => false
      }
    extdeps.git.object_store.GitLsFilesStageZRefused { cause: _ } => false
  }
}

test fn witness_git_bounded_fixture_projects_declared_fragment() -> Bool {
  let repo = git_fixture_repository()
  match extdeps.git.object_store.git_project_repository(repo: repo, tree_oid: sha1_root_tree) {
    extdeps.git.object_store.GitProjectionRefused { cause: _ } => false
    extdeps.git.object_store.GitProjected { projection } =>
      projection.object_format == extdeps.git.object_store.GitObjectFormatSha1
        && count(projection.tree_entries) == 6
        && count(projection.tags) == 1
        && count(projection.index) == 6
        && count(projection.worktree) == 5
  }
}

fn git_r0_fixture_read_back_observation() -> extdeps.git.object_store.GitR0ReadBackObservation {
  let repo = git_r0_fixture_repository()
  extdeps.git.object_store.GitR0ReadBackObservation {
    git_version: "git version 2.39.5",
    object_format: extdeps.git.object_store.GitObjectFormatSha1,
    tree_oid: sha1_root_tree,
    tree_entries: fixture_wire_entries(),
    tag_oids: [sha1_tag],
    refs: repo.refs,
    index: repo.index,
    worktree: repo.worktree,
    unavailable: repo.unavailable,
  }
}

fn fixture_read_back_observation() -> extdeps.git.object_store.GitR0ReadBackObservation {
  git_r0_fixture_read_back_observation()
}

test fn witness_git_empty_commit_and_tag_messages_are_representable() -> Bool {
  let empty = std.bytes.octets_bytes(o: [])
  let commit = extdeps.git.object_store.ObjectCommit {
    commit: extdeps.git.object_store.Commit {
      tree: sha1_empty_tree,
      parents: [],
      author: fixture_author,
      committer: fixture_author,
      message: empty,
    }
  }
  let tag = extdeps.git.object_store.ObjectTag {
    tag: extdeps.git.object_store.AnnotatedTag {
      target: sha1_parent_commit,
      target_type: extdeps.git.CommitObj,
      name: "empty-message",
      tagger: fixture_author,
      message: empty,
    }
  }
  match extdeps.git.object_store.git_store_object_canonical_hash_input(object: commit) {
    extdeps.git.object_store.GitCanonicalHashInputReady { bytes: _ } =>
      match extdeps.git.object_store.git_store_object_canonical_hash_input(object: tag) {
        extdeps.git.object_store.GitCanonicalHashInputReady { bytes: _ } => true
        extdeps.git.object_store.GitCanonicalHashInputRefused { cause: _ } => false
      }
    extdeps.git.object_store.GitCanonicalHashInputRefused { cause: _ } => false
  }
}

test fn witness_git_readback_comparison_rejects_perturbed_observation() -> Bool {
  match extdeps.git.object_store.git_project_repository(repo: git_fixture_repository(), tree_oid: sha1_root_tree) {
    extdeps.git.object_store.GitProjectionRefused { cause: _ } => false
    extdeps.git.object_store.GitProjected { projection } =>
      let observed = fixture_read_back_observation()
      let perturbed = extdeps.git.object_store.GitR0ReadBackObservation {
        git_version: observed.git_version,
        object_format: observed.object_format,
        tree_oid: sha1_absent_commit,
        tree_entries: observed.tree_entries,
        tag_oids: observed.tag_oids,
        refs: observed.refs,
        index: observed.index,
        worktree: observed.worktree,
        unavailable: observed.unavailable,
      }
      match extdeps.git.object_store.git_verify_independent_read_back(
        projection: projection,
        observation: perturbed,
      ) {
        extdeps.git.object_store.GitReadBackMismatch { axis: _ } => true
        extdeps.git.object_store.GitReadBackVerified { observation: _ } => false
      }
  }
}

test fn witness_git_mode_object_mismatch_refuses() -> Bool {
  match extdeps.git.object_store.git_decode_tree(entries: [
