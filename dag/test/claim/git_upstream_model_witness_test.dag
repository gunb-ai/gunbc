  }
}

test fn witness_git_mismatched_object_format_refuses_without_mutation() -> Bool {
  let repo = git_fixture_repository()
  match extdeps.git.object_store.git_model_update_ref_exact(
    repo: repo,
    name: "refs/heads/main",
    new_oid: sha256_object,
    expected_old: sha1_parent_commit,
  ) {
    extdeps.git.object_store.GitRefAdvanceFormatMismatch { repository, repository_format, oid } =>
      repository == repo
        && repository_format == extdeps.git.object_store.GitObjectFormatSha1
        && oid == sha256_object
    _ => false
