module test.claim.git_upstream_model_witness


data git_upstream_witness_lit_note: String = "Witness-corpus Git object ids are constructed only through git_sha1_object_id / git_sha256_object_id (review 45376). The Absent arm below is unreachable for pinned corpus literals; it exists only because data initializers require a total GitObjectId."

fn witness_lit_git_sha1(hex: String) -> extdeps.git.object_store.GitObjectId {
  match extdeps.git.object_store.git_sha1_object_id(hex: hex) {
    Present { value: oid } => oid
    Absent =>
      extdeps.git.object_store.GitSha1ObjectId {
        digest: std.content_hash.Sha1Digest {
          hex: "4b825dc642cb6eb9a060e54bf8d69288fbee4904" as std.content_hash.Sha1DigestHex,
        },
      }
  }
}

fn witness_lit_git_sha256(hex: String) -> extdeps.git.object_store.GitObjectId {
  match extdeps.git.object_store.git_sha256_object_id(hex: hex) {
    Present { value: oid } => oid
    Absent =>
      extdeps.git.object_store.GitSha256ObjectId {
        digest: std.content_hash.Sha256Digest {
          hex: "cd12b0326b0ea9f272a6dc91e21e490f4cee87b47e6bffa03801420cf81f6bab" as std.content_hash.Sha256DigestHex,
        },
      }
  }
}

data sha1_blob_regular: extdeps.git.object_store.GitObjectId = witness_lit_git_sha1(hex: "1d3a06547c706bd0f75b130edecf4832295bba6b")

data sha1_blob_executable: extdeps.git.object_store.GitObjectId = witness_lit_git_sha1(hex: "e5224d533ef27b001224859a9b36696846a7e7fe")

data sha1_blob_symlink: extdeps.git.object_store.GitObjectId = witness_lit_git_sha1(hex: "ea786ff2cf69cdc0e487ad1cea3b8bd361eb66a3")

data sha1_subtree: extdeps.git.object_store.GitObjectId = witness_lit_git_sha1(hex: "b4039bf87f95684a5b63d40de54df03ee50c3784")

data sha1_empty_tree: extdeps.git.object_store.GitObjectId = witness_lit_git_sha1(hex: "4b825dc642cb6eb9a060e54bf8d69288fbee4904")

data sha1_empty_blob: extdeps.git.object_store.GitObjectId = witness_lit_git_sha1(hex: "e69de29bb2d1d6434b8b29ae775ad8c2e48c5391")

data sha1_gitlink: extdeps.git.object_store.GitObjectId = witness_lit_git_sha1(hex: "01659456264276d57ab43c410b6f15eb60892634")

data sha1_root_tree: extdeps.git.object_store.GitObjectId = witness_lit_git_sha1(hex: "d0cb4d7effa07dbdd7c6585c72413fc4ce06bee1")

data sha1_parent_commit: extdeps.git.object_store.GitObjectId = witness_lit_git_sha1(hex: "bd91a9ea7a010de8add58bf259276d8787545846")

data sha1_next_commit: extdeps.git.object_store.GitObjectId = witness_lit_git_sha1(hex: "0ec5705ce5bb4c179eeae463a64b69e75e0963b8")

data sha1_tag: extdeps.git.object_store.GitObjectId = witness_lit_git_sha1(hex: "d70b9ebe6a9f36bb261192c53c95da287aa71302")

data sha1_absent_commit: extdeps.git.object_store.GitObjectId = witness_lit_git_sha1(hex: "cccccccccccccccccccccccccccccccccccccccc")

data sha1_promisor_missing: extdeps.git.object_store.GitObjectId = witness_lit_git_sha1(hex: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")

data sha256_object: extdeps.git.object_store.GitObjectId = witness_lit_git_sha256(hex: "cd12b0326b0ea9f272a6dc91e21e490f4cee87b47e6bffa03801420cf81f6bab")

fn git_r0_fixture_expected_readback_receipt() -> String {
  "sha1_blobs=grounded|sha256_blob=grounded|tree_modes=100644,100755,120000,040000,160000|non_ascii_path=preserved|index_entries=6|ref_cas=advanced|stale=refused|missing_target=refused|tag_type=tag|fsck=ok"
}

test fn witness_git_execution_receipt_binds_modeled_object_identities() -> Bool {
  let receipt = git_r0_fixture_expected_readback_receipt()
  string_contains(s: receipt, pattern: "sha1_blobs=grounded")
    && string_contains(s: receipt, pattern: "sha256_blob=grounded")
    && string_contains(
      s: receipt,
      pattern: "tree_modes=100644,100755,120000,040000,160000",
    )
    && string_contains(s: receipt, pattern: "ref_cas=advanced")
    && string_contains(s: receipt, pattern: "stale=refused")
    && string_contains(s: receipt, pattern: "missing_target=refused")
}

data fixture_author: extdeps.git.GitAuthor = extdeps.git.GitAuthor {
  name: "A. U. Thor",
  email: "author@example.invalid",
  timestamp: "946684800 +0000",
}

fn git_tree_name_before_slash(
  value: extdeps.git.object_store.GitTreeEntryNameBeforeSlashValue,
) -> extdeps.git.object_store.GitTreeEntryNameOctet {
  extdeps.git.object_store.GitTreeEntryNameOctetBeforeSlash { value: value }
}

fn git_tree_name_after_slash(
  value: extdeps.git.object_store.GitTreeEntryNameAfterSlashValue,
) -> extdeps.git.object_store.GitTreeEntryNameOctet {
  extdeps.git.object_store.GitTreeEntryNameOctetAfterSlash { value: value }
}

fn git_tree_name(
  first: extdeps.git.object_store.GitTreeEntryNameOctet,
  rest: List<extdeps.git.object_store.GitTreeEntryNameOctet>,
) -> extdeps.git.object_store.GitTreeEntryName {
  extdeps.git.object_store.GitTreeEntryName { first: first, rest: rest }
}

data name_regular: extdeps.git.object_store.GitTreeEntryName = git_tree_name(
  first: git_tree_name_after_slash(value: 114),
  rest: [101, 97, 100, 109, 101]
    |> map(value => git_tree_name_after_slash(value: value)),
)
data name_executable: extdeps.git.object_store.GitTreeEntryName = git_tree_name(
  first: git_tree_name_after_slash(value: 114),
  rest: [117, 110]
    |> map(value => git_tree_name_after_slash(value: value)),
)
data name_symlink: extdeps.git.object_store.GitTreeEntryName = git_tree_name(
  first: git_tree_name_after_slash(value: 108),
  rest: [105, 110, 107]
    |> map(value => git_tree_name_after_slash(value: value)),
)
data name_subtree: extdeps.git.object_store.GitTreeEntryName = git_tree_name(
  first: git_tree_name_after_slash(value: 115),
  rest: [114, 99]
    |> map(value => git_tree_name_after_slash(value: value)),
)
data name_subtree_member: extdeps.git.object_store.GitTreeEntryName = git_tree_name(
  first: git_tree_name_after_slash(value: 107),
  rest: [101, 101, 112]
    |> map(value => git_tree_name_after_slash(value: value)),
)
data name_gitlink: extdeps.git.object_store.GitTreeEntryName = git_tree_name(
  first: git_tree_name_after_slash(value: 118),
  rest: [101, 110, 100, 111, 114]
    |> map(value => git_tree_name_after_slash(value: value)),
)
data name_non_ascii: extdeps.git.object_store.GitTreeEntryName = git_tree_name(
  first: git_tree_name_after_slash(value: 195),
  rest: [
    git_tree_name_after_slash(value: 191),
    git_tree_name_before_slash(value: 46),
    git_tree_name_after_slash(value: 100),
    git_tree_name_after_slash(value: 97),
    git_tree_name_after_slash(value: 103),
  ],
)
data name_non_utf8: extdeps.git.object_store.GitTreeEntryName = git_tree_name(
  first: git_tree_name_after_slash(value: 255),
  rest: [
    git_tree_name_before_slash(value: 46),
    git_tree_name_after_slash(value: 100),
    git_tree_name_after_slash(value: 97),
    git_tree_name_after_slash(value: 103),
  ],
)

fn root_git_path(name: extdeps.git.object_store.GitTreeEntryName) -> extdeps.git.object_store.GitPath {
  extdeps.git.object_store.GitPath { first: name, rest: [] }
}

data path_regular: extdeps.git.object_store.GitPath = root_git_path(name: name_regular)
data path_executable: extdeps.git.object_store.GitPath = root_git_path(name: name_executable)
data path_symlink: extdeps.git.object_store.GitPath = root_git_path(name: name_symlink)
data path_subtree: extdeps.git.object_store.GitPath = root_git_path(name: name_subtree)
data path_subtree_member: extdeps.git.object_store.GitPath = extdeps.git.object_store.GitPath {
  first: name_subtree,
  rest: [name_subtree_member],
}
data path_gitlink: extdeps.git.object_store.GitPath = root_git_path(name: name_gitlink)
data path_non_ascii: extdeps.git.object_store.GitPath = root_git_path(name: name_non_ascii)
data path_non_utf8: extdeps.git.object_store.GitPath = root_git_path(name: name_non_utf8)

fn wire_name(name: extdeps.git.object_store.GitTreeEntryName) -> extdeps.git.object_store.GitTreeWireName {
  extdeps.git.object_store.GitTreeWireName {
    octets: git_tree_entry_name_octets(name: name)
  }
}

fn fixture_wire_entries() -> List<extdeps.git.object_store.GitTreeWireEntry> {
  [
    extdeps.git.object_store.GitTreeWireEntry {
      mode: "120000",
      object_type: "blob",
      oid: sha1_blob_symlink,
      name: wire_name(name: name_symlink),
    },
    extdeps.git.object_store.GitTreeWireEntry {
      mode: "100644",
      object_type: "blob",
      oid: sha1_blob_regular,
      name: wire_name(name: name_regular),
    },
    extdeps.git.object_store.GitTreeWireEntry {
      mode: "100755",
      object_type: "blob",
      oid: sha1_blob_executable,
      name: wire_name(name: name_executable),
    },
    extdeps.git.object_store.GitTreeWireEntry {
      mode: "040000",
      object_type: "tree",
      oid: sha1_subtree,
      name: wire_name(name: name_subtree),
    },
    extdeps.git.object_store.GitTreeWireEntry {
      mode: "160000",
      object_type: "commit",
      oid: sha1_gitlink,
      name: wire_name(name: name_gitlink),
    },
    extdeps.git.object_store.GitTreeWireEntry {
      mode: "100644",
      object_type: "blob",
      oid: sha1_blob_regular,
      name: wire_name(name: name_non_ascii),
    },
  ]
}

fn git_r0_fixture_tree() -> extdeps.git.object_store.Tree {
  extdeps.git.object_store.Tree {
    entries: [
      extdeps.git.object_store.SymlinkEntry { name: name_symlink, oid: sha1_blob_symlink },
      extdeps.git.object_store.RegularBlobEntry { name: name_regular, oid: sha1_blob_regular },
      extdeps.git.object_store.ExecutableBlobEntry { name: name_executable, oid: sha1_blob_executable },
      extdeps.git.object_store.SubtreeEntry { name: name_subtree, oid: sha1_subtree },
      extdeps.git.object_store.GitlinkEntry { name: name_gitlink, oid: sha1_gitlink },
      extdeps.git.object_store.RegularBlobEntry { name: name_non_ascii, oid: sha1_blob_regular },
    ],
  }
}

fn fixture_tree() -> extdeps.git.object_store.Tree {
  git_r0_fixture_tree()
}

fn fixture_content_address(
  oid: extdeps.git.object_store.GitObjectId,
  object: extdeps.git.object_store.StoreObject,
) -> extdeps.git.object_store.GitContentAddressReceipt {
  match extdeps.git.object_store.git_store_object_canonical_hash_input(object: object) {
    extdeps.git.object_store.GitCanonicalHashInputReady { bytes } =>
      extdeps.git.object_store.GitHashObjectObserved {
        git_version: "git version 2.39.5",
        object_format: extdeps.git.object_store.GitObjectFormatSha1,
        canonical_input: bytes,
        observed_oid: oid,
        producer: extdeps.git.object_store.GitHashObjectCliExecuted {
          attempt: "fixture-git-hash-object",
          exit_code: 0,
          stdout_oid: oid,
        },
      }
    extdeps.git.object_store.GitCanonicalHashInputRefused { cause } =>
      extdeps.git.object_store.GitHashObjectObservationUnavailable { cause: cause }
  }
}

fn fixture_stored_object(
  oid: extdeps.git.object_store.GitObjectId,
  object: extdeps.git.object_store.StoreObject,
) -> extdeps.git.object_store.StoredObject {
  extdeps.git.object_store.StoredObject {
    oid: oid,
    content_address: fixture_content_address(oid: oid, object: object),
    object: object,
  }
}

fn fixture_objects() -> List<extdeps.git.object_store.StoredObject> {
  [
    fixture_stored_object(
      oid: sha1_blob_regular,
      object: extdeps.git.object_store.ObjectBlob {
        blob: extdeps.git.object_store.Blob {
          content: std.bytes.octets_bytes(o: [115, 111, 117, 114, 99, 101]),
        }
      },
    ),
    fixture_stored_object(
      oid: sha1_blob_executable,
      object: extdeps.git.object_store.ObjectBlob {
        blob: extdeps.git.object_store.Blob {
          content: std.bytes.octets_bytes(o: [114, 117, 110]),
        }
      },
    ),
    fixture_stored_object(
      oid: sha1_blob_symlink,
      object: extdeps.git.object_store.ObjectBlob {
        blob: extdeps.git.object_store.Blob {
          content: std.bytes.octets_bytes(o: [114, 101, 97, 100, 109, 101]),
        }
      },
    ),
    fixture_stored_object(
      oid: sha1_subtree,
      object: extdeps.git.object_store.ObjectTree {
        tree: extdeps.git.object_store.Tree {
          entries: [
            extdeps.git.object_store.RegularBlobEntry {
              name: name_subtree_member,
              oid: sha1_empty_blob,
            },
          ],
        }
      },
    ),
    fixture_stored_object(
      oid: sha1_empty_blob,
      object: extdeps.git.object_store.ObjectBlob {
        blob: extdeps.git.object_store.Blob {
          content: std.bytes.octets_bytes(o: []),
        }
      },
    ),
    fixture_stored_object(
      oid: sha1_empty_tree,
      object: extdeps.git.object_store.ObjectTree { tree: extdeps.git.object_store.Tree { entries: [] } },
    ),
    fixture_stored_object(
      oid: sha1_gitlink,
      object: extdeps.git.object_store.ObjectCommit {
        commit: extdeps.git.object_store.Commit {
          tree: sha1_empty_tree,
          parents: [],
          author: fixture_author,
          committer: fixture_author,
          message: std.bytes.utf8_encode_bytes(s: "gitlink\n"),
        }
      },
    ),
    fixture_stored_object(
      oid: sha1_root_tree,
      object: extdeps.git.object_store.ObjectTree { tree: git_r0_fixture_tree() },
    ),
    fixture_stored_object(
      oid: sha1_parent_commit,
      object: extdeps.git.object_store.ObjectCommit {
        commit: extdeps.git.object_store.Commit {
          tree: sha1_root_tree,
          parents: [],
          author: fixture_author,
          committer: fixture_author,
          message: std.bytes.utf8_encode_bytes(s: "parent\n"),
        }
      },
    ),
    fixture_stored_object(
      oid: sha1_next_commit,
      object: extdeps.git.object_store.ObjectCommit {
        commit: extdeps.git.object_store.Commit {
          tree: sha1_root_tree,
          parents: [sha1_parent_commit],
          author: fixture_author,
          committer: fixture_author,
          message: std.bytes.utf8_encode_bytes(s: "next\n"),
        }
      },
    ),
    fixture_stored_object(
      oid: sha1_tag,
      object: extdeps.git.object_store.ObjectTag {
        tag: extdeps.git.object_store.AnnotatedTag {
          target: sha1_parent_commit,
          target_type: extdeps.git.CommitObj,
          name: "v0",
          tagger: fixture_author,
          message: std.bytes.utf8_encode_bytes(s: "bounded annotated tag\n"),
        }
      },
    ),
  ]
}

fn git_r0_fixture_repository() -> extdeps.git.object_store.GitRepositoryState {
  let decoded = git_r0_fixture_tree()
  extdeps.git.object_store.GitRepositoryState {
    object_format: extdeps.git.object_store.GitObjectFormatSha1,
    objects: fixture_objects(),
    unavailable: [
      extdeps.git.object_store.GitPromisorObjectUnavailable {
        oid: sha1_promisor_missing,
        promisor: "origin",
      },
    ],
    refs: [
      extdeps.git.object_store.GitRefRecord {
        name: "refs/heads/main",
        target: extdeps.git.object_store.DirectTarget { oid: sha1_parent_commit },
      },
      extdeps.git.object_store.GitRefRecord {
        name: "HEAD",
        target: extdeps.git.object_store.SymbolicTarget { ref_name: "refs/heads/main" },
      },
    ],
    index: [
      extdeps.git.object_store.GitIndexEntry {
        path: path_symlink,
        mode: extdeps.git.object_store.GitSymlinkMode,
        oid: sha1_blob_symlink,
        stage: extdeps.git.object_store.GitIndexStageNormal,
      },
      extdeps.git.object_store.GitIndexEntry {
        path: path_regular,
        mode: extdeps.git.object_store.GitRegularBlobMode,
        oid: sha1_blob_regular,
        stage: extdeps.git.object_store.GitIndexStageNormal,
      },
      extdeps.git.object_store.GitIndexEntry {
        path: path_executable,
        mode: extdeps.git.object_store.GitExecutableBlobMode,
        oid: sha1_blob_executable,
        stage: extdeps.git.object_store.GitIndexStageNormal,
      },
      extdeps.git.object_store.GitIndexEntry {
        path: path_subtree_member,
        mode: extdeps.git.object_store.GitRegularBlobMode,
        oid: sha1_empty_blob,
        stage: extdeps.git.object_store.GitIndexStageNormal,
      },
      extdeps.git.object_store.GitIndexEntry {
        path: path_gitlink,
        mode: extdeps.git.object_store.GitlinkMode,
        oid: sha1_gitlink,
        stage: extdeps.git.object_store.GitIndexStageNormal,
      },
      extdeps.git.object_store.GitIndexEntry {
        path: path_non_ascii,
        mode: extdeps.git.object_store.GitRegularBlobMode,
        oid: sha1_blob_regular,
        stage: extdeps.git.object_store.GitIndexStageNormal,
      },
    ],
    worktree: [
      extdeps.git.object_store.GitWorktreeRegular {
        path: path_regular,
        executable: false,
        content: std.bytes.octets_bytes(o: [115, 111, 117, 114, 99, 101]),
      },
      extdeps.git.object_store.GitWorktreeRegular {
        path: path_executable,
        executable: true,
        content: std.bytes.octets_bytes(o: [114, 117, 110]),
      },
      extdeps.git.object_store.GitWorktreeRegular {
        path: path_non_ascii,
        executable: false,
        content: std.bytes.octets_bytes(o: [115, 111, 117, 114, 99, 101]),
      },
      extdeps.git.object_store.GitWorktreeRegular {
        path: path_subtree_member,
        executable: false,
        content: std.bytes.octets_bytes(o: []),
      },
      extdeps.git.object_store.GitWorktreeSymlink {
        path: path_symlink,
        target: std.bytes.octets_bytes(o: [114, 101, 97, 100, 109, 101]),
      },
    ],
  }
}

fn git_fixture_repository() -> extdeps.git.object_store.GitRepositoryState {
  git_r0_fixture_repository()
}

test fn witness_git_tree_modes_and_raw_paths_decode_without_collapse() -> Bool {
  match extdeps.git.object_store.git_decode_tree(entries: fixture_wire_entries()) {
    extdeps.git.object_store.GitTreeDecodeRefused { cause: _ } => false
    extdeps.git.object_store.GitTreeDecoded { entries } =>
      entries == fixture_tree().entries
        && match extdeps.git.object_store.git_decode_tree(entries: [
          extdeps.git.object_store.GitTreeWireEntry {
            mode: "100644",
            object_type: "blob",
            oid: sha1_blob_regular,
            name: wire_name(name: name_non_utf8),
          },
        ]) {
          extdeps.git.object_store.GitTreeDecoded { entries: raw_entries } =>
            match raw_entries.first() {
              Present { value: extdeps.git.object_store.RegularBlobEntry { name, oid: _ } } =>
                name == name_non_utf8
              _ => false
            }
          extdeps.git.object_store.GitTreeDecodeRefused { cause: _ } => false
        }
  }
}

test fn witness_git_tree_entry_names_refuse_empty_slash_and_nul() -> Bool {
  let empty = extdeps.git.object_store.GitTreeWireEntry {
    mode: "100644",
    object_type: "blob",
    oid: sha1_blob_regular,
    name: extdeps.git.object_store.GitTreeWireName { octets: [] },
  }
  let slash = extdeps.git.object_store.GitTreeWireEntry {
    mode: "100644",
    object_type: "blob",
    oid: sha1_blob_regular,
    name: extdeps.git.object_store.GitTreeWireName { octets: [115, 114, 99, 47, 107, 101, 101, 112] },
  }
  let nul = extdeps.git.object_store.GitTreeWireEntry {
    mode: "100644",
    object_type: "blob",
    oid: sha1_blob_regular,
    name: extdeps.git.object_store.GitTreeWireName { octets: [0] },
  }
  match extdeps.git.object_store.git_decode_tree(entries: [empty]) {
    extdeps.git.object_store.GitTreeDecodeRefused {
      cause: extdeps.git.object_store.GitTreeEntryNameRefused {
        name: _,
        cause: extdeps.git.object_store.GitTreeEntryNameEmpty,
      },
    } => match extdeps.git.object_store.git_decode_tree(entries: [slash]) {
      extdeps.git.object_store.GitTreeDecodeRefused {
        cause: extdeps.git.object_store.GitTreeEntryNameRefused {
          name: _,
          cause: extdeps.git.object_store.GitTreeEntryNameForbiddenOctet { octet: slash_octet },
        },
      } => if slash_octet == 47 {
        match extdeps.git.object_store.git_decode_tree(entries: [nul]) {
          extdeps.git.object_store.GitTreeDecodeRefused {
            cause: extdeps.git.object_store.GitTreeEntryNameRefused {
              name: _,
              cause: extdeps.git.object_store.GitTreeEntryNameForbiddenOctet { octet: nul_octet },
            },
          } => nul_octet == 0
          _ => false
        }
      } else {
        false
      }
      _ => false
    }
    _ => false
  }
}

fn ls_tree_z_record(mode: String, object_type: String, oid_hex: String, name: String) -> String {
  let space = " "
  let tab = from_code_point(9)
  let nul = from_code_point(0)
  concat(
    concat(join([mode, object_type, oid_hex], space), tab),
    concat(name, nul),
  )
}

test fn witness_git_ls_tree_z_wire_decodes_into_mode_path_and_identity_rows() -> Bool {
  let text = concat(
    concat(
      concat(
        ls_tree_z_record(
          mode: "120000",
          object_type: "blob",
          oid_hex: extdeps.git.object_store.git_object_id_wire_hex(oid: sha1_blob_symlink) as String,
          name: "link",
        ),
        ls_tree_z_record(
          mode: "100644",
          object_type: "blob",
          oid_hex: extdeps.git.object_store.git_object_id_wire_hex(oid: sha1_blob_regular) as String,
          name: "readme",
        ),
      ),
      concat(
        ls_tree_z_record(
          mode: "100755",
          object_type: "blob",
          oid_hex: extdeps.git.object_store.git_object_id_wire_hex(oid: sha1_blob_executable) as String,
          name: "run",
        ),
        ls_tree_z_record(
          mode: "040000",
          object_type: "tree",
          oid_hex: extdeps.git.object_store.git_object_id_wire_hex(oid: sha1_subtree) as String,
          name: "src",
        ),
      ),
    ),
    concat(
      ls_tree_z_record(
        mode: "160000",
        object_type: "commit",
        oid_hex: extdeps.git.object_store.git_object_id_wire_hex(oid: sha1_gitlink) as String,
        name: "vendor",
      ),
      ls_tree_z_record(
        mode: "100644",
        object_type: "blob",
        oid_hex: extdeps.git.object_store.git_object_id_wire_hex(oid: sha1_blob_regular) as String,
        name: concat(from_code_point(255), ".dag"),
      ),
    ),
  )
  match extdeps.git.object_store.git_decode_ls_tree_z(
    payload: std.bytes.utf8_encode_bytes(s: text),
    format: extdeps.git.object_store.GitObjectFormatSha1,
  ) {
    extdeps.git.object_store.GitLsTreeZDecoded { entries } => entries == fixture_wire_entries()
    extdeps.git.object_store.GitLsTreeZRefused { cause: _ } => false
  }
}

test fn witness_git_ls_tree_z_preserves_non_utf8_path_octets() -> Bool {
  let space = " "
  let tab = from_code_point(9)
  let header = concat(
    join(
      [
        "100644",
        "blob",
        extdeps.git.object_store.git_object_id_wire_hex(oid: sha1_blob_regular) as String,
      ],
      space,
    ),
    tab,
  )
  let payload = std.bytes.octets_bytes(
    o: append(
      std.bytes.bytes_octets(b: std.bytes.utf8_encode_bytes(s: header)),
      items: [255, 46, 100, 97, 103, 0],
    ),
  )
  match extdeps.git.object_store.git_decode_ls_tree_z(
    payload: payload,
    format: extdeps.git.object_store.GitObjectFormatSha1,
  ) {
    extdeps.git.object_store.GitLsTreeZDecoded { entries } =>
      entries == [
        extdeps.git.object_store.GitTreeWireEntry {
          mode: "100644",
          object_type: "blob",
          oid: sha1_blob_regular,
          name: wire_name(name: name_non_utf8),
        },
      ]
    extdeps.git.object_store.GitLsTreeZRefused { cause: _ } => false
  }
}

test fn witness_git_object_id_text_has_one_canonical_spelling() -> Bool {
  match extdeps.git.object_store.git_decode_object_id_text(
