module test.claim.host_phase_status

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data modeled_phase_fixture: PhaseDisposition = PhaseDisposition {
  authorities: [
    DeclarationRef {
      module_path: "gunbc.host_phase_status",
      decl_name: "host_phase_verdict_from",
      field: WholeDeclaration,
    },
  ],
  gaps: [],
}

data unmodeled_phase_fixture: PhaseDisposition = PhaseDisposition {
  authorities: [],
  gaps: [
    PhaseGap {
      gap_id: "session-placement-enrollment-authority",
      missing: "typed placement authority",
      refusal: "host_standup:P4:session-placement-enrollment:unmodeled — refuse until placement enrollment has a .dag authority",
    },
  ],
}

data partial_phase_fixture: PhaseDisposition = PhaseDisposition {
  authorities: modeled_phase_fixture.authorities,
  gaps: [
    PhaseGap {
      gap_id: "partial-apply",
      missing: "live actuator",
      refusal: "host_standup:fixture:partial-apply — modeled comparison exists but apply is absent",
    },
  ],
}

fn cell_fixture(
  label: String,
  disposition: PhaseDisposition,
  observation: ObservationVerdict?,
) -> HostPhaseCellStatus {
  HostPhaseCellStatus {
    cell: HostPhaseCell { host: operator_host_srv3, phase_label: label },
    disposition: disposition,
    observation: observation,
  }
}

data witness_no_producer_is_unknown_note: String = "THE fail-closed conjunct. A phase with no live observation producer must derive UnknownRefused — the arm that says 'we have no way to ask this host'. If it ever derives Converged, the status matrix reports a subsumption that was never observed, and every count built on it (remaining work, coverage) silently becomes fiction. This is the same defect class as a stats probe that auto-starts the server it is measuring (#7213 Finding 2): evidence manufactured by the act of looking."

test fn witness_no_producer_derives_unknown_not_converged() -> Bool {
  match host_phase_verdict_from(observation: none) {
    UnknownRefused => true
    Converged => false
    std.upsert_decision.Absent => false
    Drifted => false
    Conflict => false
    Inaccessible => false
  }
}

data witness_orthogonality_note: String = "The model and observation axes must stay independent. PhaseDisposition is authorities × gaps, so four important combinations remain representable: model-complete+converged, model-complete+inaccessible, gap+unknown, and partial+converged. The last means live state happens to match even though the model cannot reproduce it; a fused enum would falsely round that cell green."

test fn witness_modeled_and_observed_axes_are_independent() -> Bool {
  let modeled_inaccessible = cell_fixture(
    label: "P1b:build-cache-provision",
    disposition: modeled_phase_fixture,
    observation: Present { value: std.upsert_decision.Inaccessible },
  )
  let unmodeled_converged = cell_fixture(
    label: "prefix:os-install-actuated",
    disposition: unmodeled_phase_fixture,
    observation: Present { value: std.upsert_decision.Converged },
  )
  let unmodeled_unknown = cell_fixture(
    label: "P4:session-placement-enrollment",
    disposition: unmodeled_phase_fixture,
    observation: none,
  )
  let partial_converged = cell_fixture(
    label: "prefix:bmc-fan-policy-converge",
    disposition: partial_phase_fixture,
    observation: Present { value: std.upsert_decision.Converged },
  )
  host_phase_cell_is_model_complete(c: modeled_inaccessible)
    && !host_phase_cell_is_converged(c: modeled_inaccessible)
    && host_phase_cell_has_live_producer(c: modeled_inaccessible)
    && !host_phase_cell_is_model_complete(c: unmodeled_converged)
    && host_phase_cell_is_converged(c: unmodeled_converged)
    && host_phase_cell_has_live_producer(c: unmodeled_converged)
    && !host_phase_cell_is_model_complete(c: unmodeled_unknown)
    && !host_phase_cell_is_converged(c: unmodeled_unknown)
    && !host_phase_cell_has_live_producer(c: unmodeled_unknown)
    && host_phase_cell_has_authority(c: partial_converged)
    && host_phase_cell_has_model_gap(c: partial_converged)
    && !host_phase_cell_is_model_complete(c: partial_converged)
    && host_phase_cell_is_converged(c: partial_converged)
}

data witness_producer_refusal_is_coverage_note: String = "A producer that RAN and honestly refused is coverage; no producer at all is not. The distinction is load-bearing because the two have different owners — a refusing producer is a reach or observation defect to fix, an absent producer is a model to build — and the first version of this module conflated them by reading coverage off the verdict instead of off the observation's presence."

test fn witness_refusing_producer_still_counts_as_coverage() -> Bool {
  let refused = cell_fixture(
    label: "prefix:os-install-actuated",
    disposition: unmodeled_phase_fixture,
    observation: Present { value: std.upsert_decision.UnknownRefused },
  )
  let absent = cell_fixture(
    label: "prefix:os-install-actuated",
    disposition: unmodeled_phase_fixture,
    observation: none,
  )
  host_phase_cell_has_live_producer(c: refused)
    && !host_phase_cell_has_live_producer(c: absent)
}

test fn witness_unreachable_and_unknown_stay_distinct() -> Bool {
  !observation_verdict_eq(a: std.upsert_decision.Inaccessible, b: std.upsert_decision.UnknownRefused)
    && observation_verdict_eq(a: std.upsert_decision.Inaccessible, b: std.upsert_decision.Inaccessible)
}

data witness_widen_red_control_note: String = "The discriminating RED control, built on the PATH-shadow / DaemonUnsupervised precedent: the forbidden absorbing fallback is modeled as its own sketch (host_phase_verdict_absorbing_fallback_widen_sketch fabricates Converged when no observation exists), the gate REJECTS the sketch's output, and the authority's output PASSES the same gate. The perturbation is independent of the property checked, so this cannot pass tautologically — an authority that quietly acquired the widen arm would be rejected by the gate it currently satisfies."

test fn witness_red_control_widen_on_absent_rejected_by_gate() -> Bool {
  let widened = host_phase_verdict_absorbing_fallback_widen_sketch(observation: none)
  let authority = host_phase_verdict_from(observation: none)
  observation_verdict_eq(a: widened, b: std.upsert_decision.Converged)
    && !host_phase_verdict_gate_accepts(verdict: widened, observation: none)
    && host_phase_verdict_gate_accepts(verdict: authority, observation: none)
}

data departed_host_fixture: HostIdentity = "srv-departed" as HostIdentity

data witness_reconcile_non_vacuous_note: String = "The membership instantiation must be exercised on a NON-DEGENERATE diff, or it is an instantiation nobody has tested. The live fleet produces only Modified and Unchanged hunks today (no host has left), so the Removed arm — a cell observed for a host absent from fleet_intent — is supplied synthetically here. All three outcomes are asserted in one reconcile: a departed host's cell tears down (cells are Owned, so R5 permits it rather than refusing), an unconverged cell upserts, and a cell already at the desired state produces no hunk at all."

test fn witness_reconcile_covers_upsert_teardown_and_noop() -> Bool {
  let at_desired = cell_fixture(
    label: "P3:green-place-readiness",
    disposition: modeled_phase_fixture,
    observation: Present { value: std.upsert_decision.Converged },
  )
  let unconverged = cell_fixture(
    label: "P1b:build-cache-provision",
    disposition: modeled_phase_fixture,
    observation: none,
  )
  let desired_unconverged = HostPhaseCellStatus {
    cell: unconverged.cell,
    disposition: modeled_phase_fixture,
    observation: Present { value: std.upsert_decision.Converged },
  }
  let departed = HostPhaseCellStatus {
    cell: HostPhaseCell { host: departed_host_fixture, phase_label: "P1b:build-cache-provision" },
    disposition: modeled_phase_fixture,
    observation: Present { value: std.upsert_decision.Converged },
  }
  let plan = host_phase_reconcile(
    desired: [at_desired, desired_unconverged],
    observed: [at_desired, unconverged, departed],
  )
  plan.actions.length() == 2
    && membership_upsert_count(plan: plan) == 1
    && membership_teardown_count(plan: plan) == 1
    && membership_refusal_count(plan: plan) == 0
}

data witness_matrix_shape_note: String = "Shape assertions over the derived matrix, pinned to the spine and the enrolled fleet rather than to hand-copied numbers: the matrix is exactly (hosts x spine steps), so it cannot silently drop a phase or a host. The coverage count is the honest measure of the live-observation frontier — one cell has a real producer today, (srv3, prefix:os-install-actuated) — and that number is what items 2 and 3 of the lane exist to raise. Pinning it means adding a producer is a VISIBLE, counted event that must update this witness, never a silent improvement nobody can point at."

test fn witness_matrix_is_hosts_times_spine() -> Bool {
  let cells = host_fleet_phase_matrix(hosts: fleet_subsumption_hosts).length()
  let expected = fleet_subsumption_hosts.length() * host_standup_spine.length()
  cells == expected
}

test fn witness_live_observation_frontier_is_one_cell() -> Bool {
  host_phase_observation_coverage_count(hosts: fleet_subsumption_hosts) == 1
}

test fn witness_model_incomplete_cells_track_spine_gap_phases() -> Bool {
  let incomplete = host_phase_model_incomplete_count(hosts: fleet_subsumption_hosts)
  let expected = fleet_subsumption_hosts.length() * host_standup_gap_phase_count()
  incomplete == expected
}

data witness_remaining_work_note: String = "Remaining work is the reconcile's own upsert count, and it must equal every cell that is not already at the FULL desired state — modeled AND converged. Asserting it against an independently computed count is what stops the reconcile from silently retiring cells: if desired ever weakened to 'converged, disposition ignored', srv3's installed-but-unmodeled OS cell would drop out of the count and the lane would look one item closer to done than it is."

test fn witness_remaining_work_counts_every_unfinished_cell() -> Bool {
  let remaining = host_phase_remaining_work_count(hosts: fleet_subsumption_hosts)
  let total = host_fleet_phase_matrix(hosts: fleet_subsumption_hosts).length()
  let finished = host_phase_finished_cell_count(hosts: fleet_subsumption_hosts)
  remaining == total - finished
}
