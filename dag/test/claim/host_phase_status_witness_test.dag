module test.claim.host_phase_status

import gunbc.srv3_os_install_diagnostic { srv3_install_hang_no_router_lease_ms }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data modeled_phase_fixture: PhaseDisposition = ModeledCompose {
  authorities: [
    DeclarationRef {
      module_path: "gunbc.host_phase_status",
      decl_name: "host_phase_verdict_from",
      field: WholeDeclaration,
    },
  ]
}

data unmodeled_phase_fixture: PhaseDisposition = DeclaredGap {
  interim_realization: "ctrl:scripts/session-dashboard/lib/spawn_placement.mjs",
  refusal: "host_standup:P4:session-placement-enrollment:unmodeled — refuse until placement enrollment has a .dag authority",
}

fn cell_fixture(
  label: String,
  disposition: PhaseDisposition,
  observation: ObservationVerdict?,
) -> HostPhaseCellStatus {
  HostPhaseCellStatus {
    cell: HostPhaseCell { host: operator_host_srv3, phase_label: label },
    disposition: disposition,
    observation: observation,
  }
}

data witness_no_producer_is_unknown_note: String = "THE fail-closed conjunct. A phase with no live observation producer must derive UnknownRefused — the arm that says 'we have no way to ask this host'. If it ever derives Converged, the status matrix reports a subsumption that was never observed, and every count built on it (remaining work, coverage) silently becomes fiction. This is the same defect class as a stats probe that auto-starts the server it is measuring (#7213 Finding 2): evidence manufactured by the act of looking."

test fn witness_no_producer_derives_unknown_not_converged() -> Bool {
  match host_phase_verdict_from(observation: none) {
    UnknownRefused => true
    Converged => false
    std.upsert_decision.Absent => false
    Drifted => false
    Conflict => false
    Inaccessible => false
  }
}

data witness_orthogonality_note: String = "The two axes must stay independent, and this is the conjunct that CAUGHT them being fused. The cell type was first written as a sum (StatusUnmodeled | StatusObserved), so a DeclaredGap phase discarded its observation — and the one cell CARRYING AN OBSERVATION today, (srv3, prefix:os-install-actuated), is a DeclaredGap phase, so coverage computed as zero with a real Converged verdict one branch away. Four combinations must all be representable and distinct: modeled+converged (done), modeled+inaccessible (srv1/srv2 build-cache — a finished model the host refuses to answer for), unmodeled+unknown (ordinary remaining work), and unmodeled+converged (the host is in the desired condition by means the model cannot reproduce — srv3's OS install). A fused enum has to round the middle two to something false."

test fn witness_modeled_and_observed_axes_are_independent() -> Bool {
  let modeled_inaccessible = cell_fixture(
    label: "P1b:build-cache-provision",
    disposition: modeled_phase_fixture,
    observation: Present { value: std.upsert_decision.Inaccessible },
  )
  let unmodeled_converged = cell_fixture(
    label: "prefix:os-install-actuated",
    disposition: unmodeled_phase_fixture,
    observation: Present { value: std.upsert_decision.Converged },
  )
  let unmodeled_unknown = cell_fixture(
    label: "P4:session-placement-enrollment",
    disposition: unmodeled_phase_fixture,
    observation: none,
  )
  host_phase_cell_is_modeled(c: modeled_inaccessible)
    && !host_phase_cell_is_converged(c: modeled_inaccessible)
    && host_phase_cell_has_live_producer(c: modeled_inaccessible)
    && !host_phase_cell_is_modeled(c: unmodeled_converged)
    && host_phase_cell_is_converged(c: unmodeled_converged)
    && host_phase_cell_has_live_producer(c: unmodeled_converged)
    && !host_phase_cell_is_modeled(c: unmodeled_unknown)
    && !host_phase_cell_is_converged(c: unmodeled_unknown)
    && !host_phase_cell_has_live_producer(c: unmodeled_unknown)
}

data witness_producer_refusal_is_coverage_note: String = "A producer that RAN and honestly refused is coverage; no producer at all is not. The distinction is load-bearing because the two have different owners — a refusing producer is a reach or observation defect to fix, an absent producer is a model to build — and the first version of this module conflated them by reading coverage off the verdict instead of off the observation's presence."

test fn witness_refusing_producer_still_counts_as_coverage() -> Bool {
  let refused = cell_fixture(
    label: "prefix:os-install-actuated",
    disposition: unmodeled_phase_fixture,
    observation: Present { value: std.upsert_decision.UnknownRefused },
  )
  let absent = cell_fixture(
    label: "prefix:os-install-actuated",
    disposition: unmodeled_phase_fixture,
    observation: none,
  )
  host_phase_cell_has_live_producer(c: refused)
    && !host_phase_cell_has_live_producer(c: absent)
}

test fn witness_unreachable_and_unknown_stay_distinct() -> Bool {
  !observation_verdict_eq(a: std.upsert_decision.Inaccessible, b: std.upsert_decision.UnknownRefused)
    && observation_verdict_eq(a: std.upsert_decision.Inaccessible, b: std.upsert_decision.Inaccessible)
}

data witness_widen_red_control_note: String = "The discriminating RED control, built on the PATH-shadow / DaemonUnsupervised precedent: the forbidden absorbing fallback is modeled as its own sketch (host_phase_verdict_absorbing_fallback_widen_sketch fabricates Converged when no observation exists), the gate REJECTS the sketch's output, and the authority's output PASSES the same gate. The perturbation is independent of the property checked, so this cannot pass tautologically — an authority that quietly acquired the widen arm would be rejected by the gate it currently satisfies."

test fn witness_red_control_widen_on_absent_rejected_by_gate() -> Bool {
  let widened = host_phase_verdict_absorbing_fallback_widen_sketch(observation: none)
  let authority = host_phase_verdict_from(observation: none)
  observation_verdict_eq(a: widened, b: std.upsert_decision.Converged)
    && !host_phase_verdict_gate_accepts(verdict: widened, observation: none)
    && host_phase_verdict_gate_accepts(verdict: authority, observation: none)
}

data departed_host_fixture: HostIdentity = "srv-departed" as HostIdentity

data witness_reconcile_non_vacuous_note: String = "The membership instantiation must be exercised on a NON-DEGENERATE diff, or it is an instantiation nobody has tested. The live fleet produces only Modified and Unchanged hunks today (no host has left), so the Removed arm — a cell observed for a host absent from fleet_intent — is supplied synthetically here. All three outcomes are asserted in one reconcile: a departed host's cell tears down (cells are Owned, so R5 permits it rather than refusing), an unconverged cell upserts, and a cell already at the desired state produces no hunk at all."

test fn witness_reconcile_covers_upsert_teardown_and_noop() -> Bool {
  let at_desired = cell_fixture(
    label: "P3:green-place-readiness",
    disposition: modeled_phase_fixture,
    observation: Present { value: std.upsert_decision.Converged },
  )
  let unconverged = cell_fixture(
    label: "P1b:build-cache-provision",
    disposition: modeled_phase_fixture,
    observation: none,
  )
  let desired_unconverged = HostPhaseCellStatus {
    cell: unconverged.cell,
    disposition: modeled_phase_fixture,
    observation: Present { value: std.upsert_decision.Converged },
  }
  let departed = HostPhaseCellStatus {
    cell: HostPhaseCell { host: departed_host_fixture, phase_label: "P1b:build-cache-provision" },
    disposition: modeled_phase_fixture,
    observation: Present { value: std.upsert_decision.Converged },
  }
  let plan = host_phase_reconcile(
    desired: [at_desired, desired_unconverged],
    observed: [at_desired, unconverged, departed],
  )
  plan.actions.length() == 2
    && membership_write_count(plan: plan) == 1
    && membership_removal_count(plan: plan) == 1
    && membership_refusal_count(plan: plan) == 0
}

data witness_matrix_shape_note: String = "Shape assertions over the derived matrix, pinned to the spine and the enrolled fleet rather than to hand-copied numbers: the matrix is an exact identity join over (host x the obligations that host's participation selects), duplicate-free and covering exactly the enrolled roster, so it cannot silently drop a phase or a host — nor hand a host an obligation its participation does not own, which the former rectangle count could not see. The coverage count is the frontier's CURRENT measure, and it is not yet an honest one — corrected 2026-08-09 in the same change that landed witness_covered_cell_verdict_is_selected_by_authorship_alone below. Exactly one cell carries an observation today, (srv3, prefix:os-install-actuated), and that observation is AUTHORED rather than execution-backed: it derives from srv3_post_install_lease_table_fixture, and no effect in the tree produces a DhcpLeaseTableObservation. So the count reads one where the executed population is zero, and raising it is what items 2 and 3 of the lane exist to do. Pinning it means adding a producer is a VISIBLE, counted event that must update this witness, never a silent improvement nobody can point at."

// An exact identity join, not a product. Every enrollment contributes exactly the obligations its
// own participation selects — program_step_count over assimilation_program_for — so a host whose
// participation claims four of the spine's steps contributes four cells, never the full spine. The
// former assertion was enrollments.length() * host_standup_spine.length(), which is a count
// equality over a rectangle: it could not distinguish a correct matrix from one that gave every
// host every step, and DESIGN.md §5 rules that completeness is an identity join, not a count.
test fn witness_matrix_is_exact_join_over_participation_programs() -> Bool {
  let matrix = host_fleet_phase_matrix(enrollments: fleet_subsumption_enrollments)
  let matched = filter(
    fleet_subsumption_enrollments,
    e => {
      let owed = program_step_count(program: assimilation_program_for(intent: e))
      let got = filter(matrix, c => c.cell.host == e.host).length()
      got == owed
    },
  )
  matched.length() == fleet_subsumption_enrollments.length()
}

// Re-derived DELIBERATELY on the join-4 flip (run 31300640122): the executed fleet reach
// probe landed a receipt row for all six targets, and each row feeds BOTH P0 deduction
// cells — so the frontier is the authored srv3 cell plus 2 cells per probed host,
// DERIVED from the probe target roster rather than pinned as a tree-copied literal.
test fn witness_live_observation_frontier_is_one_cell() -> Bool {
  host_phase_observation_coverage_count(enrollments: fleet_subsumption_enrollments) == 1 + 2 * fleet_reach_probe_targets.length()
}

// Cross-check between two independent producers over the same cells rather than a rectangle: the
// counter walks the enrollments, the join filters the derived matrix by disposition. A rectangle
// assertion here would go green even if the gap steps landed on the wrong hosts.
test fn witness_unmodeled_cells_track_spine_gaps() -> Bool {
  let matrix = host_fleet_phase_matrix(enrollments: fleet_subsumption_enrollments)
  let gap_cells = filter(
    matrix,
    c => match c.disposition {
      DeclaredGap { interim_realization: _, refusal: _ } => true
      ModeledCompose { authorities: _ } => false
    },
  )
  host_phase_unmodeled_count(enrollments: fleet_subsumption_enrollments) == gap_cells.length()
}

data witness_remaining_work_note: String = "Remaining work is the reconcile's own upsert count, and it must equal every cell that is not already at the FULL desired state — modeled AND converged. Asserting it against an independently computed count is what stops the reconcile from silently retiring cells: if desired ever weakened to 'converged, disposition ignored', srv3's installed-but-unmodeled OS cell would drop out of the count and the lane would look one item closer to done than it is."

test fn witness_remaining_work_counts_every_unfinished_cell() -> Bool {
  let remaining = host_phase_remaining_work_count(enrollments: fleet_subsumption_enrollments)
  let total = host_fleet_phase_matrix(enrollments: fleet_subsumption_enrollments).length()
  let finished = host_phase_finished_cell_count(enrollments: fleet_subsumption_enrollments)
  remaining == total - finished
}


data witness_program_scoping_note: String = "HOST-0 acceptance. The refactor's whole risk is that program scoping quietly CHANGES the runner fleet while looking tidy, so the identity conjunct is asserted rather than argued: a CI-participation enrollment must select the entire spine, because every phase authored to date exists to serve runner hosts. The complementary conjunct is the one the refactor exists for -- an inference enrollment must not carry a single runner or BMC obligation. Both are needed: the first alone would pass a no-op, the second alone would pass a refactor that broke srv1 through srv4."

data synthetic_inference_enrollment: HostEnrollmentIntent = HostEnrollmentIntent {
  host: operator_host_srv3,
  participation: inference_serving_enrollment_participation,
}

data synthetic_ci_enrollment: HostEnrollmentIntent = HostEnrollmentIntent {
  host: operator_host_srv3,
  participation: ci_runner_enrollment_participation,
}

fn cell_label_is_runner_only(c: HostPhaseCellStatus) -> Bool {
  let l = c.cell.phase_label
  l == "prefix:bmc-credential-converge" || l == "prefix:os-install-mechanism" || l == "prefix:os-install-actuated" || l == "P1:runner-deploy-slot" || l == "P1b:build-cache-provision" || l == "P1c:codex-runtime-provision" || l == "P3:green-place-readiness" || l == "P4:session-placement-enrollment"
}

fn cell_label_is_shared(c: HostPhaseCellStatus) -> Bool {
  let l = c.cell.phase_label
  l == "P0:host-identity-converge" || l == "P0:reach-secrets-network" || l == "P2:compute-fabric-enroll" || l == "P5:assimilation-complete-gate"
}

test fn witness_ci_program_selects_the_whole_spine() -> Bool {
  let selected = program_step_count(program: assimilation_program_for(intent: synthetic_ci_enrollment))
  selected == host_standup_spine.length()
}

test fn witness_inference_program_is_strictly_smaller_than_the_spine() -> Bool {
  let inference = program_step_count(program: assimilation_program_for(intent: synthetic_inference_enrollment))
  inference > 0 && inference < host_standup_spine.length()
}

data synthetic_reordered_enrollment: HostEnrollmentIntent = HostEnrollmentIntent {
  host: operator_host_srv3,
  participation: [InferenceServingParticipation, CiRunnerParticipation],
}

data synthetic_forward_order_enrollment: HostEnrollmentIntent = HostEnrollmentIntent {
  host: operator_host_srv3,
  participation: [CiRunnerParticipation, InferenceServingParticipation],
}

data synthetic_duplicated_enrollment: HostEnrollmentIntent = HostEnrollmentIntent {
  host: operator_host_srv3,
  participation: [CiRunnerParticipation, CiRunnerParticipation, InferenceServingParticipation],
}

data witness_participation_set_semantics_note: String = "Participation is a set wearing a list's carrier, so the three enrollments below must be one program under BOTH readings -- the steps they select and the identity they derive. Selection was already order-blind and duplicate-blind because step_serves_any asks only whether SOME participation claims a step; identity was not, and joined whatever the caller happened to write. These conjuncts are the discriminating controls for that repair: each one reds against the pre-repair identity derivation, which is what distinguishes a real construction wall from a canonicalization function nobody calls."

test fn witness_participation_order_does_not_change_program_identity() -> Bool {
  let forward = assimilation_program_for(intent: synthetic_forward_order_enrollment)
  let reversed = assimilation_program_for(intent: synthetic_reordered_enrollment)
  forward.identity == reversed.identity
    && program_step_count(program: forward) == program_step_count(program: reversed)
}

test fn witness_duplicate_participation_is_identity_neutral() -> Bool {
  let once = assimilation_program_for(intent: synthetic_forward_order_enrollment)
  let twice = assimilation_program_for(intent: synthetic_duplicated_enrollment)
  once.identity == twice.identity
    && program_step_count(program: once) == program_step_count(program: twice)
}

test fn witness_distinct_participation_changes_identity_and_obligations() -> Bool {
  let ci = assimilation_program_for(intent: synthetic_ci_enrollment)
  let inference = assimilation_program_for(intent: synthetic_inference_enrollment)
  let both = assimilation_program_for(intent: synthetic_forward_order_enrollment)
  ci.identity != inference.identity
    && both.identity != ci.identity
    && program_step_count(program: inference) < program_step_count(program: ci)
}

data witness_identity_is_exactly_canonical_note: String = "The DISCRIMINATING control, and the reason the three conjuncts above are not satisfied by any function that merely returns a constant. It pins the derived identity to an independently authored literal rather than to another projection of the same computation, and the literal is what the canonical roster REQUIRES it to be, not what the current code was measured to emit. Pre-repair, the duplicated enrollment joined its raw list and derived 'ci-runner+ci-runner+inference-serving'; this conjunct asserts that exact string is NOT the identity while the canonical two-label form IS. So it reds against the derivation this change replaced, which is what makes the repair a wall rather than a canonicalization helper sitting beside a still-writable path."

test fn witness_program_identity_is_exactly_the_canonical_projection() -> Bool {
  let duplicated = assimilation_program_for(intent: synthetic_duplicated_enrollment)
  let reordered = assimilation_program_for(intent: synthetic_reordered_enrollment)
  (duplicated.identity as String) == "ci-runner+inference-serving"
    && (reordered.identity as String) == "ci-runner+inference-serving"
    && (duplicated.identity as String) != "ci-runner+ci-runner+inference-serving"
    && (reordered.identity as String) != "inference-serving+ci-runner"
}

test fn witness_single_participation_identities_are_distinct_labels() -> Bool {
  (assimilation_program_for(intent: synthetic_ci_enrollment).identity as String) == "ci-runner"
    && (assimilation_program_for(intent: synthetic_inference_enrollment).identity as String) == "inference-serving"
}

test fn witness_every_participation_is_in_the_canonical_roster() -> Bool {
  fleet_participation_in_canonical_roster(p: CiRunnerParticipation)
    && fleet_participation_in_canonical_roster(p: InferenceServingParticipation)
}

test fn witness_inference_enrollment_carries_no_runner_or_bmc_obligation() -> Bool {
  let cells = host_phase_cells_for_enrollment(intent: synthetic_inference_enrollment)
  let forbidden = filter(cells, c => cell_label_is_runner_only(c: c))
  forbidden.length() == 0
}

test fn witness_inference_enrollment_keeps_the_shared_obligations() -> Bool {
  let cells = host_phase_cells_for_enrollment(intent: synthetic_inference_enrollment)
  let shared = filter(cells, c => cell_label_is_shared(c: c))
  shared.length() == 4 && cells.length() == 4
}

test fn witness_every_spine_step_is_claimed_by_some_participation() -> Bool {
  let unclaimed = filter(host_standup_spine, s => !step_serves_participation(step: s, wanted: CiRunnerParticipation) && !step_serves_participation(step: s, wanted: InferenceServingParticipation))
  unclaimed.length() == 0
}

// The runner control the scope requires: enrolling the Sparks must not change what a CI-runner
// enrollment owes. Each runner enrollment still contributes exactly its own program, and that
// program is still the whole spine — asserted per enrollment, so it stays true no matter how many
// non-runner hosts join the roster.
test fn witness_program_scoping_preserves_the_runner_fleet_matrix() -> Bool {
  let matrix = host_fleet_phase_matrix(enrollments: fleet_subsumption_enrollments)
  let runners = filter(
    fleet_subsumption_enrollments,
    e => {
      let owed = program_step_count(program: assimilation_program_for(intent: e))
      owed == host_standup_spine.length()
    },
  )
  let intact = filter(
    runners,
    e => filter(matrix, c => c.cell.host == e.host).length() == host_standup_spine.length(),
  )
  runners.length() == 4 && intact.length() == runners.length()
}

test fn witness_fleet_matrix_has_no_duplicated_cells() -> Bool {
  let matrix = host_fleet_phase_matrix(enrollments: fleet_subsumption_enrollments)
  let duplicated = filter(
    matrix,
    c => filter(matrix, d => host_phase_cell_key(c: d) == host_phase_cell_key(c: c)).length() > 1,
  )
  duplicated.length() == 0
}

test fn witness_matrix_hosts_are_exactly_the_enrolled_roster() -> Bool {
  let matrix = host_fleet_phase_matrix(enrollments: fleet_subsumption_enrollments)
  let covered = filter(
    fleet_subsumption_hosts,
    h => filter(matrix, c => c.cell.host == h).length() > 0,
  )
  let stray = filter(
    matrix,
    c => filter(fleet_subsumption_hosts, h => h == c.cell.host).length() == 0,
  )
  covered.length() == fleet_subsumption_hosts.length() && stray.length() == 0
}

// The Spark enrollment itself, stated at the grain it is actually known: srv5 and srv6 are
// ENROLLED as InferenceServingParticipation, which selects exactly four shared obligations and no
// runner-only one. Enrolled is not converged — every one of these eight cells is honestly
// unobserved, and nothing here claims identity convergence, reach, compute enrolment, or serving.
test fn witness_enrolled_sparks_carry_exactly_the_shared_obligations() -> Bool {
  let matrix = host_fleet_phase_matrix(enrollments: fleet_subsumption_enrollments)
  let sparks = filter(
    matrix,
    c => c.cell.host == operator_host_srv5 || c.cell.host == operator_host_srv6,
  )
  let shared = filter(sparks, c => cell_label_is_shared(c: c))
  let runner_only = filter(sparks, c => cell_label_is_runner_only(c: c))
  sparks.length() == 8 && shared.length() == 8 && runner_only.length() == 0
}

// The unobserved half of the same claim, kept separate so a future producer landing on a Spark
// cell reds this witness instead of silently upgrading the sentence above.
// Re-derived on the join-4 flip: the executed probe observed BOTH P0 cells on each
// Spark at the modeled endpoint (ProbeHostKeyUnenrolled -> Inaccessible — observed,
// NOT satisfied), and every non-P0 Spark cell stays unobserved. The witness now pins
// that exact split so a producer landing on any further Spark cell still reds here.
test fn witness_enrolled_spark_cells_are_all_unobserved() -> Bool {
  let matrix = host_fleet_phase_matrix(enrollments: fleet_subsumption_enrollments)
  let sparks = filter(
    matrix,
    c => c.cell.host == operator_host_srv5 || c.cell.host == operator_host_srv6,
  )
  let observed = filter(
    sparks,
    c => match c.observation {
      Present { value: _ } => true
      Absent => false
    },
  )
  let observed_p0 = filter(
    observed,
    c => (c.cell.phase_label == "P0:reach-secrets-network" || c.cell.phase_label == "P0:host-identity-converge")
      && match c.observation {
        Present { value: v } => v == Inaccessible
        Absent => false
      },
  )
  observed.length() == 4 && observed_p0.length() == 4
}

// Non-vacuity guard for the gap join above: if the spine carried no DeclaredGap step at all, that
// witness would compare zero against zero and pass while proving nothing.
test fn witness_spine_actually_carries_gap_phases() -> Bool {
  host_standup_gap_phase_count() > 0
}

// Positive control for the Spark witness above: cell_label_is_runner_only must actually match
// something, or "the Sparks carry no runner-only obligation" is satisfied by a predicate that
// matches nothing. The runner hosts are where those obligations live.
test fn witness_runner_only_obligations_exist_on_runner_hosts() -> Bool {
  let matrix = host_fleet_phase_matrix(enrollments: fleet_subsumption_enrollments)
  let runner_only = filter(matrix, c => cell_label_is_runner_only(c: c))
  let on_sparks = filter(
    runner_only,
    c => c.cell.host == operator_host_srv5 || c.cell.host == operator_host_srv6,
  )
  runner_only.length() > 0 && on_sparks.length() == 0
}

data witness_authored_observation_note: String = "THE SIBLING OF THE NOTE ABOVE, and the one the frontier does not yet catch. That note forbids evidence manufactured by the ACT OF LOOKING; this pair catches evidence manufactured by AUTHORING. host_phase_observation_coverage_count is designated by the frontier note as the number that measures the observation debt, and it counts a cell as covered exactly when host_phase_cell_has_live_producer holds -- which tests only that the observation is Present, never that anything executed to produce it. The single Present cell today, (srv3, prefix:os-install-actuated), derives its Converged verdict from srv3_post_install_lease_table_fixture, a data constant in gunbc.network_identity_subsumption whose one dynamic row carries the placeholder MAC 00:00:00:00:00:00. So the metric that measures the debt currently overstates coverage by its entire population. The frontier note states the rule this violates in its own words -- 'a cell earns a row here when an effect produces its verdict by execution' -- which is why the defect is worth an executing control rather than a correction in prose: the rule was already written down and was not enforceable, and no lens or witness would have reddened if a second host were wired in the same way. That is the exact move Spark collector-fact enrollment would have made for srv5 and srv6, which is how this was found."

// THE DISCRIMINATING CONTROL. Both lease tables are authored data constants, and the verdict is a
// pure function of WHICH ONE is wired into the frontier: the pre-install table (BMC row only)
// refuses, the post-install fixture (BMC row plus a synthetic OS-up row) converges. Nothing about
// the live tree participates in that difference. Note the disposition this whole module declares --
// SubstrateInputsOnly, meaning it reads no live tree at all -- and it still computes a Converged
// "live observation". An execution-backed observation could not be reproduced under that
// disposition; an authored one is reproduced exactly.
// EXACTLY Absent, not merely "some non-Converged arm". Under StallWithinBudget the deduction
// contract for an observed table with no os-up row is Absent specifically; Drifted, Conflict,
// Inaccessible and UnknownRefused each denote a DIFFERENT regression, and a test that accepted
// any of them would stay green through all four.
test fn witness_covered_cell_verdict_is_selected_by_authorship_alone() -> Bool {
  let converged = deduce_os_install_actuation_verdict(
    obs: srv3_post_install_lease_observation,
    fleet_slot: operator_host_srv3,
    stall: StallWithinBudget,
  )
  let refused = deduce_os_install_actuation_verdict(
    obs: srv3_pre_install_lease_observation,
    fleet_slot: operator_host_srv3,
    stall: StallWithinBudget,
  )
  let converged_is_converged = match converged { Converged => true, std.upsert_decision.Absent => false, Drifted => false, Conflict => false, Inaccessible => false, UnknownRefused => false }
  let refused_is_exactly_absent = match refused { Converged => false, std.upsert_decision.Absent => true, Drifted => false, Conflict => false, Inaccessible => false, UnknownRefused => false }
  converged_is_converged && refused_is_exactly_absent
}

// The covered population stated as an IDENTITY JOIN rather than a count, so this does not become a
// tree-copied snapshot: the set of cells the coverage metric counts is exactly the one cell whose
// verdict the control above shows to be authored. If a genuinely executed producer is ever wired,
// this reds and must be re-derived deliberately -- which is the point.
// Join-4 flip: the rest of the covered population must be EXACTLY the probe-deduced
// P0 cells — identity grain, not a widened count.
// The PRODUCTION metric itself, not a rebuilt filter beside it. host_phase_observation_coverage_count
// is the subject of this finding, so a control that never calls it proves nothing about the number
// anyone actually reads.
// Exactly one. This is not a tree-copied roster: the PR's factual claim is that the ENTIRE covered
// population is this single authored cell, so the assertion must fail the moment that stops holding
// -- including when a genuinely executed producer is wired, which is the outcome this lane wants.
test fn witness_every_covered_cell_today_is_the_authored_one() -> Bool {
  let covered = filter(
    host_fleet_phase_matrix(enrollments: fleet_subsumption_enrollments),
    c => host_phase_cell_has_live_producer(c: c),
  )
  let authored = filter(
    covered,
    c => c.cell.host == operator_host_srv3 && c.cell.phase_label == "prefix:os-install-actuated",
  )
  let probe_deduced = filter(
    covered,
    c => c.cell.phase_label == "P0:reach-secrets-network" || c.cell.phase_label == "P0:host-identity-converge",
  )
  let metric = host_phase_observation_coverage_count(enrollments: fleet_subsumption_enrollments)
  metric == covered.length()
    && covered.length() == authored.length() + probe_deduced.length()
    && authored.length() == 1
    && probe_deduced.length() == 2 * fleet_reach_probe_targets.length()
}
