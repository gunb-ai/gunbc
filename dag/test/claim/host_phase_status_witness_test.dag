module test.claim.host_phase_status

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data modeled_phase_fixture: PhaseDisposition = ModeledCompose {
  authorities: [
    DeclarationRef {
      module_path: "gunbc.host_phase_status",
      decl_name: "host_phase_status_from",
      field: WholeDeclaration,
    },
  ]
}

data unmodeled_phase_fixture: PhaseDisposition = DeclaredGap {
  interim_realization: "ctrl:scripts/session-dashboard/lib/spawn_placement.mjs",
  refusal: "host_standup:P4:session-placement-enrollment:unmodeled — refuse until placement enrollment has a .dag authority",
}

data witness_no_producer_is_unknown_note: String = "THE fail-closed conjunct. A modeled phase with no live observation producer must derive UnknownRefused — the arm that says 'we have no way to ask this host'. If it ever derives Converged, the status matrix reports a subsumption that was never observed, and every count built on it (remaining work, coverage) silently becomes fiction. This is the same defect class as a stats probe that auto-starts the server it is measuring (#7213 Finding 2): evidence manufactured by the act of looking."

fn witness_no_producer_derives_unknown_not_converged() -> Bool {
  match host_phase_status_from(disposition: modeled_phase_fixture, observation: none) {
    StatusObserved { verdict: UnknownRefused } => true
    StatusObserved { verdict: _ } => false
    StatusUnmodeled { refusal: _ } => false
  }
}

fn witness_unmodeled_phase_is_not_an_observation() -> Bool {
  match host_phase_status_from(disposition: unmodeled_phase_fixture, observation: none) {
    StatusUnmodeled { refusal: r } => string_contains(s: r, pattern: "refuse until")
    StatusObserved { verdict: _ } => false
  }
}

data witness_orthogonality_note: String = "The two axes must stay independent: a phase can be FULLY MODELED and still Inaccessible on a given host — which is exactly srv1 and srv2 for the build-cache phase today, where the model is complete and the hosts refuse every fleet credential. A single fused status enum could not represent that cell, and would have to round it to either 'modeled' (hiding the live failure, which is how the stale status table read) or 'gap' (slandering a model that is finished). This conjunct pins the cell that proves the axes are separable."

fn witness_modeled_phase_can_be_inaccessible() -> Bool {
  match host_phase_status_from(
    disposition: modeled_phase_fixture,
    observation: Present { value: Inaccessible },
  ) {
    StatusObserved { verdict: Inaccessible } => true
    StatusObserved { verdict: _ } => false
    StatusUnmodeled { refusal: _ } => false
  }
}

fn witness_unreachable_and_unknown_stay_distinct() -> Bool {
  !observation_verdict_eq(a: Inaccessible, b: UnknownRefused)
    && observation_verdict_eq(a: Inaccessible, b: Inaccessible)
}

data witness_widen_red_control_note: String = "The discriminating RED control, built on the PATH-shadow / DaemonUnsupervised precedent: the forbidden absorbing fallback is modeled as its own sketch (host_phase_status_absorbing_fallback_widen_sketch fabricates Converged when no observation exists), the gate REJECTS the sketch's output, and the authority's output PASSES the same gate. The perturbation is independent of the property checked, so this cannot pass tautologically — an authority that quietly acquired the widen arm would be rejected by the gate it currently satisfies."

fn witness_red_control_widen_on_absent_rejected_by_gate() -> Bool {
  match host_phase_status_absorbing_fallback_widen_sketch(
    disposition: modeled_phase_fixture,
    observation: none,
  ) {
    StatusObserved { verdict: Converged } => true
    StatusObserved { verdict: _ } => false
    StatusUnmodeled { refusal: _ } => false
  } && !host_phase_status_gate_accepts(
      status: host_phase_status_absorbing_fallback_widen_sketch(
        disposition: modeled_phase_fixture,
        observation: none,
      ),
      observation: none,
    )
    && host_phase_status_gate_accepts(
      status: host_phase_status_from(disposition: modeled_phase_fixture, observation: none),
      observation: none,
    )
}

data departed_host_fixture: HostIdentity = "srv-departed" as HostIdentity

fn departed_cell_fixture() -> HostPhaseCellStatus {
  HostPhaseCellStatus {
    cell: HostPhaseCell { host: departed_host_fixture, phase_label: "P1b:build-cache-provision" },
    status: StatusObserved { verdict: Converged },
  }
}

data witness_reconcile_non_vacuous_note: String = "The membership instantiation must be exercised on a NON-DEGENERATE diff, or it is an instantiation nobody has tested. The live fleet produces only Modified and Unchanged hunks today (no host has left), so the Removed arm — a cell observed for a host absent from fleet_intent — is supplied synthetically here. All three arms are asserted in one reconcile: a departed host's cell tears down (cells are Owned, so R5 permits it rather than refusing), an unconverged cell upserts, and a converged cell produces no hunk at all."

fn witness_reconcile_covers_added_modified_and_removed() -> Bool {
  let converged_cell = HostPhaseCellStatus {
    cell: HostPhaseCell { host: operator_host_srv3, phase_label: "P3:green-place-readiness" },
    status: StatusObserved { verdict: Converged },
  }
  let unconverged_cell = HostPhaseCellStatus {
    cell: HostPhaseCell { host: operator_host_srv3, phase_label: "P1b:build-cache-provision" },
    status: StatusObserved { verdict: UnknownRefused },
  }
  let desired_unconverged = HostPhaseCellStatus {
    cell: unconverged_cell.cell,
    status: StatusObserved { verdict: Converged },
  }
  let plan = host_phase_reconcile(
    desired: [converged_cell, desired_unconverged],
    observed: [converged_cell, unconverged_cell, departed_cell_fixture()],
  )
  plan.actions.length() == 2
    && membership_upsert_count(plan: plan) == 1
    && membership_teardown_count(plan: plan) == 1
    && membership_refusal_count(plan: plan) == 0
}

data witness_matrix_shape_note: String = "Shape assertions over the derived matrix, pinned to the spine and the enrolled fleet rather than to hand-copied numbers: the matrix is exactly (hosts x spine steps), so it cannot silently drop a phase or a host. The coverage count is the honest measure of the live-observation frontier — one cell has a real producer today ((srv3, prefix:os-install-actuated)), and that number is what items 2 and 3 of the lane exist to raise. Pinning it means adding a producer is a VISIBLE, counted event that must update this witness, never a silent improvement nobody can point at."

fn witness_matrix_is_hosts_times_spine() -> Bool {
  let cells = host_fleet_phase_matrix(hosts: fleet_subsumption_hosts).length()
  let expected = fleet_subsumption_hosts.length() * host_standup_spine.length()
  cells == expected
}

fn witness_live_observation_frontier_is_one_cell() -> Bool {
  host_phase_observation_coverage_count(hosts: fleet_subsumption_hosts) == 1
}

fn witness_unmodeled_cells_track_spine_gaps() -> Bool {
  let unmodeled = host_phase_unmodeled_count(hosts: fleet_subsumption_hosts)
  let expected = fleet_subsumption_hosts.length() * host_standup_gap_phase_count()
  unmodeled == expected
}

fn witness_remaining_work_excludes_nothing_silently() -> Bool {
  let remaining = host_phase_remaining_work_count(hosts: fleet_subsumption_hosts)
  let total = host_fleet_phase_matrix(hosts: fleet_subsumption_hosts).length()
  let converged = host_phase_converged_cell_count(hosts: fleet_subsumption_hosts)
  remaining == total - converged
}

test fn host_phase_status_witnesses() -> Bool {
  witness_no_producer_derives_unknown_not_converged()
    && witness_unmodeled_phase_is_not_an_observation()
    && witness_modeled_phase_can_be_inaccessible()
    && witness_unreachable_and_unknown_stay_distinct()
    && witness_red_control_widen_on_absent_rejected_by_gate()
    && witness_reconcile_covers_added_modified_and_removed()
    && witness_matrix_is_hosts_times_spine()
    && witness_live_observation_frontier_is_one_cell()
    && witness_unmodeled_cells_track_spine_gaps()
    && witness_remaining_work_excludes_nothing_silently()
}

fn debug_coverage_count() -> Int {
  host_phase_observation_coverage_count(hosts: fleet_subsumption_hosts)
}

fn debug_srv3_verdict_rank() -> Int {
  observation_verdict_rank(v: srv3_post_install_actuation_verdict(elapsed: millisecond(count: 0)))
}

fn debug_actuated_label_present() -> Bool {
  filter(host_standup_spine, s => (s.label as String) == "prefix:os-install-actuated").length() == 1
}
