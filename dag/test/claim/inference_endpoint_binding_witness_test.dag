module test.claim.inference_endpoint_binding_witness_test

import std.types { String, NonEmptyStr, Bool }
import extdeps.time.rfc3339 { Rfc3339Timestamp }
import gunbc.inference_endpoint_binding {
  DialledEndpoint,
  EndpointHostJoin,
  JoinAssertedBy,
  JoinObservedFromResponse,
  endpoint_host_join_wire,
  ollama_native_wire_surface,
}

fn tunnel_join() -> EndpointHostJoin {
  JoinAssertedBy {
    asserter: "operator workstation ssh tunnel" as NonEmptyStr,
    basis: "ssh -N -L 11435:127.0.0.1:11434 to spark-a3ee" as NonEmptyStr,
    asserted_at: "2026-08-22T19:00:00Z" as Rfc3339Timestamp,
  }
}

// THE ARM THIS TYPE EXISTS FOR: an asserted join must never report as observed. If this flips, a
// receipt claims the response identified its server -- which on an identically-converged fleet no
// response can do.
test fn a_asserted_join_is_not_observed() -> Bool {
  match tunnel_join() {
    JoinAssertedBy { asserter: _, basis: _, asserted_at: _ } => true
    JoinObservedFromResponse { per_host_marker: _ } => false
  }
}

test fn b_observed_join_is_observed() -> Bool {
  match JoinObservedFromResponse { per_host_marker: "spark-a3ee" as NonEmptyStr } {
    JoinAssertedBy { asserter: _, basis: _, asserted_at: _ } => false
    JoinObservedFromResponse { per_host_marker: _ } => true
  }
}

// The two arms must not render alike: a reader of the receipt has to be able to tell an assertion
// from an observation without consulting the type.
test fn c_join_arms_render_distinctly() -> Bool {
  endpoint_host_join_wire(j: tunnel_join())
    != endpoint_host_join_wire(
         j: JoinObservedFromResponse { per_host_marker: "spark-a3ee" as NonEmptyStr },
       )
}

// An asserted join must carry its asserter into the wire, or the receipt records a claim with
// nobody attached to it.
test fn d_asserted_wire_names_its_asserter() -> Bool {
  string_contains(s: endpoint_host_join_wire(j: tunnel_join()), pattern: "operator workstation ssh tunnel")
}

// The dialled URL is a transport fact and must survive into the carrier unchanged -- it is the one
// thing a tunnelled receipt can honestly state about where the request went. The port here is the
// tunnel's LOCAL forward, which is exactly the case the type exists to keep apart from the host.
test fn e_dialled_endpoint_carries_its_url() -> Bool {
  let d = DialledEndpoint {
    url: "http://127.0.0.1:11435" as NonEmptyStr,
    wire_surface: ollama_native_wire_surface,
  }
  d.url as String == "http://127.0.0.1:11435"
}

// THE GROUNDING WITNESS: the wire surface must name the upstream authority that owns the API, not a
// label minted here. If this module ever re-mints a product enum, or points at a module that does
// not own an endpoint surface, this goes red.
test fn f_wire_surface_names_the_upstream_endpoint_authority() -> Bool {
  let m = ollama_native_wire_surface.module_path as String
  let n = ollama_native_wire_surface.decl_name as String
  if m == "extdeps.ollama.api" {
    n == "OllamaEndpoint"
  } else {
    false
  }
}
