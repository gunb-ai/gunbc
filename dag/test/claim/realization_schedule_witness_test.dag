module test.claim.realization_schedule_witness



data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data live_tree_disposition_correction_note: String = "Corrected 2026-07-29: the SubstrateInputsOnly stamp was FALSE and lying_substrate_inputs_only_stamp_census caught it — this file's import closure reaches the live-read carrier home v2.compiler.self_host through the v2.workflow.ci_floor_plan import. That import is intentional and stays: the witness compares against cheap_floor_gate_step_labels at its single authority rather than copying the label list (DESIGN §3), so the reach is real even though the rows themselves build synthetic schedules. The census answers reach structurally, which is its precision frontier, not an absorption; the fail-closed reading is ReadsLiveTree (never-skip), since a predict-skipped live-tree row is a selection fail-open."

data synthetic_target: ContentHash = content_hash_of_value(value: "realization-schedule-witness-v1")
data compile_gate_fn: String = "dag_compile_clean_gate_passes"
data gate_entry: String = "dag/tools/floor_effect_gate_witness.dag"

fn synthetic_correct_schedule() -> List<List<Runnable>> {
  [
    [
      RunnableSingleClaim { entry: gate_entry, function: "cheap_claim_pool_gate_passes", profile: runnable_resource_profile_negligible() },
      RunnableSingleClaim { entry: gate_entry, function: "extdeps_external_authority_gate_passes", profile: runnable_resource_profile_negligible() },
      RunnableSingleClaim { entry: gate_entry, function: "generated_artifact_drift_gate_passes", profile: runnable_resource_profile_negligible() }
    ],
    [RunnableSingleClaim { entry: gate_entry, function: compile_gate_fn, profile: runnable_resource_profile_negligible() }],
    [
      RunnableDiscoveryBatch {
        source_roots: ["dag"]
        scan_dirs: []
        explicit_entries: []
        node_frontier_selection: SelectionOff
        profile: runnable_resource_profile_negligible()
        exclude_substrings: []
        discovery_scope_dirs: []
      },
      RunnableSingleClaim { entry: gate_entry, function: "emit_host_gate_passes", profile: runnable_resource_profile_negligible() }
    ]
  ]
}

fn synthetic_correct_plan() -> RealizationPlan {
  RealizationPlan {
    target: synthetic_target
    objective: RealizationObjective { goals: [] }
    schedule: synthetic_correct_schedule()
    total: cost_account_predicted_zero()
  }
}

fn perturbed_schedule_wrong_order(correct: List<List<Runnable>>) -> List<List<Runnable>> {
  [
    correct.skip(n: 1).first(),
    correct.first()
  ]
}

test fn witness_schedule_lens_green_on_synthetic_plan() -> Bool {
  match v2.lens.schedule_lens.schedule_lens_verdict_for_ci_floor_ordinary(
    plan: synthetic_correct_plan(),
    compile_gate_fn: compile_gate_fn,
    cheap_gate_labels: cheap_floor_gate_step_labels()
  ) {
    Holds => true
    Violation { diagnostic: _ } => false
    NotApplicable { diagnostic: _ } => false
    Unrealized { diagnostic: _ } => false
  }
}

test fn witness_schedule_lens_red_when_corpus_runs_first_on_synthetic() -> Bool {
  let perturbed = RealizationPlan {
    target: synthetic_target
    objective: RealizationObjective { goals: [] }
    schedule: perturbed_schedule_wrong_order(correct: synthetic_correct_schedule())
    total: cost_account_predicted_zero()
  }
  match v2.lens.schedule_lens.schedule_lens_verdict_for_ci_floor_ordinary(
    plan: perturbed,
    compile_gate_fn: compile_gate_fn,
    cheap_gate_labels: cheap_floor_gate_step_labels()
  ) {
    Holds => false
    Violation { diagnostic: _ } => true
    NotApplicable { diagnostic: _ } => false
    Unrealized { diagnostic: _ } => false
  }
}
