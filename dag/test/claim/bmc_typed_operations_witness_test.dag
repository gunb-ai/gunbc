test fn exit_zero_service_probe_requires_exact_active_token() -> Bool {
  match extdeps.bmc.openbmc_fan_control.openbmc_service_active_result(
    remote: extdeps.ssh.password_session.PasswordSshExecResult {
      exit_code: 0,
      success: true,
      stdout: "activating\n",
      stderr: "",
    },
  ) {
    OpenBmcBoolRefused { reason } =>
      reason == "service-active response is not the expected active or inactive shape; observed stdout: activating"
    _ => false
  }
}
