module test.claim.bmc_typed_operations_witness

import extdeps.bmc.openbmc_fan_control {
  OpenBmcCollectionMany,
  OpenBmcCollectionOne,
  OpenBmcCollectionZero,
  OpenBmcSensorServicesObserved,
  OpenBmcSensorValueAbsent,
  OpenBmcSensorValueRefused,
  OpenBmcTachAtOrAboveThreshold,
  OpenBmcTachBelowThreshold,
  OpenBmcTachHealthObserved,
  OpenBmcWarningLowThreshold,
  openbmc_collection_from_values,
  openbmc_object_mapper_services_rec,
  openbmc_sensor_integer_projection_result,
  openbmc_sensor_threshold_result,
  openbmc_tach_health_from_floor,
}
import extdeps.ssh.password_session { PasswordSshExecResult }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.measure { rpm, rpm_count }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn object_mapper_zero_cardinality_is_preserved() -> Bool {
  match openbmc_collection_from_values(values: []) {
    OpenBmcCollectionZero => true
    _ => false
  }
}

test fn object_mapper_one_cardinality_is_preserved() -> Bool {
  match openbmc_collection_from_values(
    values: ["xyz.openbmc_project.Hwmon-1"],
  ) {
    OpenBmcCollectionOne { value: selected_service } =>
      selected_service == "xyz.openbmc_project.Hwmon-1"
    _ => false
  }
}

test fn duplicate_object_mapper_matches_remain_many() -> Bool {
  match openbmc_collection_from_values(
    values: [
      "xyz.openbmc_project.Hwmon-1",
      "xyz.openbmc_project.Hwmon-2",
    ],
  ) {
    OpenBmcCollectionMany { values } => values.length() == 2
    _ => false
  }
}

test fn failed_threshold_transport_cannot_become_threshold_unstated() -> Bool {
  match openbmc_sensor_threshold_result(
    remote: PasswordSshExecResult {
      exit_code: 255,
      success: false,
      stdout: "",
      stderr: "SSH host identity verification failed",
    },
  ) {
    OpenBmcSensorValueRefused { reason } =>
      reason == "SSH host identity verification failed"
    _ => false
  }
}

test fn failed_sensor_projection_cannot_become_absent() -> Bool {
  match openbmc_sensor_integer_projection_result(
    success: false,
    value: "",
    stderr: "malformed OpenBMC JSON",
  ) {
    OpenBmcSensorValueRefused { reason } => reason == "malformed OpenBMC JSON"
    _ => false
  }
}

test fn successful_empty_sensor_projection_is_absent() -> Bool {
  match openbmc_sensor_integer_projection_result(
    success: true,
    value: "",
    stderr: "",
  ) {
    OpenBmcSensorValueAbsent => true
    _ => false
  }
}

test fn tach_below_controller_threshold_is_not_healthy() -> Bool {
  match openbmc_tach_health_from_floor(
    sensor: "FAN4",
    reading: rpm(899),
    minimum: rpm(900),
    source: OpenBmcWarningLowThreshold,
  ) {
    OpenBmcTachHealthObserved {
      health: OpenBmcTachBelowThreshold {
        sensor,
        reading_rpm,
        minimum_rpm,
        source: _,
      },
    } => sensor == "FAN4" && rpm_count(reading_rpm) == 899 && rpm_count(minimum_rpm) == 900
    _ => false
  }
}

test fn tach_at_controller_threshold_is_healthy() -> Bool {
  match openbmc_tach_health_from_floor(
    sensor: "FAN4",
    reading: rpm(900),
    minimum: rpm(900),
    source: OpenBmcWarningLowThreshold,
  ) {
    OpenBmcTachHealthObserved {
      health: OpenBmcTachAtOrAboveThreshold {
        sensor,
        reading_rpm,
        minimum_rpm,
        source: _,
      },
    } => sensor == "FAN4" && rpm_count(reading_rpm) == 900 && rpm_count(minimum_rpm) == 900
    _ => false
  }
}
