module test.claim.bmc_typed_operations_witness

data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

test fn object_mapper_zero_cardinality_is_preserved() -> Bool {
  match extdeps.bmc.openbmc_fan_control.openbmc_collection_from_values(values: []) {
    OpenBmcCollectionZero => true
    _ => false
  }
}

test fn object_mapper_one_cardinality_is_preserved() -> Bool {
  match extdeps.bmc.openbmc_fan_control.openbmc_collection_from_values(
    values: ["xyz.openbmc_project.Hwmon-1"],
  ) {
    OpenBmcCollectionOne { value: selected_service } =>
      selected_service == "xyz.openbmc_project.Hwmon-1"
    _ => false
  }
}

test fn duplicate_object_mapper_matches_remain_many() -> Bool {
  match extdeps.bmc.openbmc_fan_control.openbmc_collection_from_values(
    values: [
      "xyz.openbmc_project.Hwmon-1",
      "xyz.openbmc_project.Hwmon-2",
    ],
  ) {
    OpenBmcCollectionMany { values } => values.length() == 2
    _ => false
  }
}

test fn failed_threshold_transport_cannot_become_threshold_unstated() -> Bool {
  match extdeps.bmc.openbmc_fan_control.openbmc_sensor_threshold_result(
    remote: extdeps.ssh.password_session.PasswordSshExecResult {
      exit_code: 255,
      success: false,
      stdout: "",
      stderr: "SSH host identity verification failed",
    },
  ) {
    OpenBmcSensorValueRefused { reason } =>
      reason == "SSH host identity verification failed"
    _ => false
  }
}

// These two took `success: Bool` and an untyped `value`/`stderr` triple until the sensor path moved
// onto the jq invocation layer. They now state the SAME two requirements against the typed jq
// outcome: a refusal must not decay into absence, and an empty successful projection must not decay
// into a refusal. The requirement is unchanged; only what carries it is, which is why these are
// re-enrolled rather than retired (DESIGN section 3 -- evidence for a surviving claim survives the
// representation that used to hold it).
test fn failed_sensor_projection_cannot_become_absent() -> Bool {
  match extdeps.bmc.openbmc_fan_control.openbmc_sensor_integer_projection_result(
    outcome: extdeps.tools.jq.JqExecutionRefused { exit_code: 2, stderr: "malformed OpenBMC JSON" },
  ) {
    OpenBmcSensorValueRefused { reason } => reason == "malformed OpenBMC JSON"
    _ => false
  }
}

test fn successful_empty_sensor_projection_is_absent() -> Bool {
  match extdeps.bmc.openbmc_fan_control.openbmc_sensor_integer_projection_result(
    outcome: extdeps.tools.jq.JqOutputAbsent,
  ) {
    OpenBmcSensorValueAbsent => true
    _ => false
  }
}

// The third state, which the old triple could not express at all: a PRESENT projection carrying a
// number is an observation. Added with the migration because the outcome type made it stateable.
test fn present_numeric_sensor_projection_is_observed() -> Bool {
  match extdeps.bmc.openbmc_fan_control.openbmc_sensor_integer_projection_result(
    outcome: extdeps.tools.jq.JqOutputPresent { text: "42" },
  ) {
    OpenBmcSensorValueObserved { value } => value == 42
    _ => false
  }
}

test fn tach_below_controller_threshold_is_not_healthy() -> Bool {
  match extdeps.bmc.openbmc_fan_control.openbmc_tach_health_from_floor(
    sensor: "FAN4",
    reading: std.measure.rpm(899),
    minimum: std.measure.rpm(900),
    source: extdeps.bmc.openbmc_fan_control.OpenBmcWarningLowThreshold,
  ) {
    OpenBmcTachHealthObserved {
      health: extdeps.bmc.openbmc_fan_control.OpenBmcTachBelowThreshold {
        sensor,
        reading_rpm,
        minimum_rpm,
        source: _,
      },
    } => sensor == "FAN4" && std.measure.rpm_count(reading_rpm) == 899 && std.measure.rpm_count(minimum_rpm) == 900
    _ => false
  }
}

test fn tach_at_controller_threshold_is_healthy() -> Bool {
  match extdeps.bmc.openbmc_fan_control.openbmc_tach_health_from_floor(
    sensor: "FAN4",
    reading: std.measure.rpm(900),
    minimum: std.measure.rpm(900),
    source: extdeps.bmc.openbmc_fan_control.OpenBmcWarningLowThreshold,
  ) {
    OpenBmcTachHealthObserved {
      health: extdeps.bmc.openbmc_fan_control.OpenBmcTachAtOrAboveThreshold {
        sensor,
        reading_rpm,
        minimum_rpm,
        source: _,
      },
    } => sensor == "FAN4" && std.measure.rpm_count(reading_rpm) == 900 && std.measure.rpm_count(minimum_rpm) == 900
    _ => false
  }
}

test fn tach_health_sensor_accessor_covers_every_arm() -> Bool {
  extdeps.bmc.openbmc_fan_control.openbmc_tach_health_sensor(
    health: extdeps.bmc.openbmc_fan_control.OpenBmcTachThresholdUnstated {
      sensor: "FAN1",
      reason: "threshold absent",
    },
  ) == "FAN1"
    && extdeps.bmc.openbmc_fan_control.openbmc_tach_health_sensor(
      health: extdeps.bmc.openbmc_fan_control.OpenBmcTachBelowThreshold {
        sensor: "FAN2",
        reading_rpm: std.measure.rpm(899),
        minimum_rpm: std.measure.rpm(900),
        source: extdeps.bmc.openbmc_fan_control.OpenBmcWarningLowThreshold,
      },
    ) == "FAN2"
    && extdeps.bmc.openbmc_fan_control.openbmc_tach_health_sensor(
      health: extdeps.bmc.openbmc_fan_control.OpenBmcTachAtOrAboveThreshold {
        sensor: "FAN3",
        reading_rpm: std.measure.rpm(900),
        minimum_rpm: std.measure.rpm(900),
        source: extdeps.bmc.openbmc_fan_control.OpenBmcWarningLowThreshold,
      },
    ) == "FAN3"
}

test fn path_transport_whitespace_becomes_one_typed_path() -> Bool {
  match extdeps.bmc.openbmc_fan_control.openbmc_path_result(
    remote: extdeps.ssh.password_session.PasswordSshExecResult {
      exit_code: 0,
      success: true,
      stdout: "  /usr/share/swampd/config-asrr.json\n",
      stderr: "",
    },
  ) {
    OpenBmcPathObserved { path } =>
      path == "/usr/share/swampd/config-asrr.json"
    _ => false
  }
}

test fn multiple_nonempty_paths_are_refused() -> Bool {
  match extdeps.bmc.openbmc_fan_control.openbmc_path_result(
    remote: extdeps.ssh.password_session.PasswordSshExecResult {
      exit_code: 0,
      success: true,
      stdout: "/usr/share/swampd/config.json\n/usr/share/swampd/config-asrr.json\n",
      stderr: "",
    },
  ) {
    OpenBmcPathRefused { reason: _ } => true
    _ => false
  }
}

test fn empty_path_transport_is_refused() -> Bool {
  match extdeps.bmc.openbmc_fan_control.openbmc_path_result(
    remote: extdeps.ssh.password_session.PasswordSshExecResult {
      exit_code: 0,
      success: true,
      stdout: "\n",
      stderr: "",
    },
  ) {
    OpenBmcPathRefused { reason: _ } => true
    _ => false
  }
}

test fn zone_failsafe_transport_becomes_typed_bool() -> Bool {
  match extdeps.bmc.openbmc_fan_control.openbmc_zone_failsafe_result(
    remote: extdeps.ssh.password_session.PasswordSshExecResult {
      exit_code: 0,
      success: true,
      stdout: "b true\n",
      stderr: "",
    },
  ) {
    OpenBmcBoolObserved { value } => value
    _ => false
  }
}

test fn wrong_busctl_type_cannot_become_zone_failsafe_bool() -> Bool {
  match extdeps.bmc.openbmc_fan_control.openbmc_zone_failsafe_result(
    remote: extdeps.ssh.password_session.PasswordSshExecResult {
      exit_code: 0,
      success: true,
      stdout: "s true\n",
      stderr: "",
    },
  ) {
    OpenBmcBoolRefused { reason: _ } => true
    _ => false
  }
}

test fn disk_usage_transport_becomes_typed_byte_size() -> Bool {
  match extdeps.bmc.openbmc_fan_control.openbmc_disk_usage_result(
    remote: extdeps.ssh.password_session.PasswordSshExecResult {
      exit_code: 0,
      success: true,
      stdout: "Filesystem 1024-blocks Used Available Capacity Mounted on\n/dev/root 10000 7500 2500 75% /\n",
      stderr: "",
    },
  ) {
    OpenBmcByteSizeObserved { value } => std.measure.byte_size_count(value) == 2560000
    _ => false
  }
}

test fn utc_epoch_seconds_become_epoch_milliseconds() -> Bool {
  match extdeps.bmc.openbmc_fan_control.openbmc_epoch_result(
    remote: extdeps.ssh.password_session.PasswordSshExecResult {
      exit_code: 0,
      success: true,
      stdout: "1722345678\n",
      stderr: "",
    },
  ) {
    OpenBmcInstantObserved { observed_at } => observed_at == 1722345678000
    _ => false
  }
}

test fn false_path_probe_is_observed_not_transport_refused() -> Bool {
  match extdeps.bmc.openbmc_fan_control.openbmc_path_probe_result(
    remote: extdeps.ssh.password_session.PasswordSshExecResult {
      exit_code: 1,
      success: false,
      stdout: "",
      stderr: "",
    },
  ) {
    OpenBmcBoolObserved { value } => !value
    _ => false
  }
}

test fn exit_one_path_probe_with_stderr_is_refused() -> Bool {
  match extdeps.bmc.openbmc_fan_control.openbmc_path_probe_result(
    remote: extdeps.ssh.password_session.PasswordSshExecResult {
      exit_code: 1,
      success: false,
      stdout: "",
      stderr: "test: /usr/share/swampd/config.json: permission denied",
    },
  ) {
    OpenBmcBoolRefused { reason } =>
      reason == "test: /usr/share/swampd/config.json: permission denied"
    _ => false
  }
}

test fn ssh_failure_cannot_masquerade_as_false_path_probe() -> Bool {
  match extdeps.bmc.openbmc_fan_control.openbmc_path_probe_result(
    remote: extdeps.ssh.password_session.PasswordSshExecResult {
      exit_code: 255,
      success: false,
      stdout: "",
      stderr: "SSH host identity verification failed",
    },
  ) {
    OpenBmcBoolRefused { reason } =>
      reason == "SSH host identity verification failed"
    _ => false
  }
}

test fn inconsistent_success_projection_is_refused() -> Bool {
  match extdeps.bmc.openbmc_fan_control.openbmc_path_probe_result(
    remote: extdeps.ssh.password_session.PasswordSshExecResult {
      exit_code: 0,
      success: false,
      stdout: "",
      stderr: "inconsistent transport projection",
    },
  ) {
    OpenBmcBoolRefused { reason } => reason == "inconsistent transport projection"
    _ => false
  }
}

test fn inactive_service_is_observed_not_transport_refused() -> Bool {
  match extdeps.bmc.openbmc_fan_control.openbmc_service_active_result(
    remote: extdeps.ssh.password_session.PasswordSshExecResult {
      exit_code: 3,
      success: false,
      stdout: "inactive\n",
      stderr: "",
    },
  ) {
    OpenBmcBoolObserved { value } => !value
    _ => false
  }
}

test fn exit_three_service_probe_with_stderr_is_refused() -> Bool {
  match extdeps.bmc.openbmc_fan_control.openbmc_service_active_result(
    remote: extdeps.ssh.password_session.PasswordSshExecResult {
      exit_code: 3,
      success: false,
      stdout: "inactive\n",
      stderr: "systemctl: failed to query unit state",
    },
  ) {
    OpenBmcBoolRefused { reason } =>
      reason == "systemctl: failed to query unit state"
    _ => false
  }
}

test fn failed_service_state_is_preserved_in_refusal() -> Bool {
  match extdeps.bmc.openbmc_fan_control.openbmc_service_active_result(
    remote: extdeps.ssh.password_session.PasswordSshExecResult {
      exit_code: 3,
      success: false,
      stdout: "failed\n",
      stderr: "",
    },
  ) {
    OpenBmcBoolRefused { reason } =>
      reason == "service-active response is not the expected active or inactive shape; observed stdout: failed"
    _ => false
  }
}

test fn nonzero_exit_cannot_become_observed_path_when_success_flag_is_true() -> Bool {
  match extdeps.bmc.openbmc_fan_control.openbmc_path_result(
    remote: extdeps.ssh.password_session.PasswordSshExecResult {
      exit_code: 255,
      success: true,
      stdout: "/usr/share/swampd/config.json\n",
      stderr: "",
    },
  ) {
    OpenBmcPathRefused { reason } =>
      reason == "path transport did not report exit-zero success"
    _ => false
  }
}

test fn nonzero_exit_cannot_become_observed_zone_when_success_flag_is_true() -> Bool {
  match extdeps.bmc.openbmc_fan_control.openbmc_zone_failsafe_result(
    remote: extdeps.ssh.password_session.PasswordSshExecResult {
      exit_code: 255,
      success: true,
      stdout: "b false\n",
      stderr: "",
    },
  ) {
    OpenBmcBoolRefused { reason } =>
      reason == "zone failsafe transport did not report exit-zero success"
    _ => false
  }
}

test fn nonzero_exit_cannot_become_observed_disk_when_success_flag_is_true() -> Bool {
  match extdeps.bmc.openbmc_fan_control.openbmc_disk_usage_result(
    remote: extdeps.ssh.password_session.PasswordSshExecResult {
      exit_code: 255,
      success: true,
      stdout: "Filesystem 1K-blocks Used Available Use%\n/dev/root 1000 100 900 10%\n",
      stderr: "",
    },
  ) {
    OpenBmcByteSizeRefused { reason } =>
