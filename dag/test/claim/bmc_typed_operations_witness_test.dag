test fn nonzero_exit_cannot_become_observed_time_when_success_flag_is_true() -> Bool {
  match extdeps.bmc.openbmc_fan_control.openbmc_epoch_result(
    remote: extdeps.ssh.password_session.PasswordSshExecResult {
      exit_code: 255,
      success: true,
      stdout: "1722345678\n",
      stderr: "",
    },
  ) {
    OpenBmcInstantRefused { reason } =>
      reason == "UTC timestamp transport did not report exit-zero success"
    _ => false
