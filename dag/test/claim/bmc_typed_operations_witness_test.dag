module test.claim.bmc_typed_operations_witness

import extdeps.bmc.openbmc_fan_control {
  OpenBmcCollectionMany,
  OpenBmcCollectionOne,
  OpenBmcCollectionZero,
  OpenBmcBoolObserved,
  OpenBmcBoolRefused,
  OpenBmcByteSizeObserved,
  OpenBmcInstantObserved,
  OpenBmcPathObserved,
  OpenBmcPathRefused,
  OpenBmcSensorServicesObserved,
  OpenBmcSensorValueAbsent,
  OpenBmcSensorValueRefused,
  OpenBmcTachAtOrAboveThreshold,
  OpenBmcTachBelowThreshold,
  OpenBmcTachHealthObserved,
  OpenBmcWarningLowThreshold,
  openbmc_collection_from_values,
  openbmc_disk_usage_result,
  openbmc_epoch_result,
  openbmc_object_mapper_services_rec,
  openbmc_sensor_integer_projection_result,
  openbmc_sensor_threshold_result,
  openbmc_tach_health_from_floor,
  openbmc_path_result,
  openbmc_path_probe_result,
  openbmc_service_active_result,
  openbmc_zone_failsafe_result,
}
import extdeps.ssh.password_session { PasswordSshExecResult }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.measure { byte_size_count, rpm, rpm_count }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn object_mapper_zero_cardinality_is_preserved() -> Bool {
  match openbmc_collection_from_values(values: []) {
    OpenBmcCollectionZero => true
    _ => false
  }
}

test fn object_mapper_one_cardinality_is_preserved() -> Bool {
  match openbmc_collection_from_values(
    values: ["xyz.openbmc_project.Hwmon-1"],
  ) {
    OpenBmcCollectionOne { value: selected_service } =>
      selected_service == "xyz.openbmc_project.Hwmon-1"
    _ => false
  }
}

test fn duplicate_object_mapper_matches_remain_many() -> Bool {
  match openbmc_collection_from_values(
    values: [
      "xyz.openbmc_project.Hwmon-1",
      "xyz.openbmc_project.Hwmon-2",
    ],
  ) {
    OpenBmcCollectionMany { values } => values.length() == 2
    _ => false
  }
}

test fn failed_threshold_transport_cannot_become_threshold_unstated() -> Bool {
  match openbmc_sensor_threshold_result(
    remote: PasswordSshExecResult {
      exit_code: 255,
      success: false,
      stdout: "",
      stderr: "SSH host identity verification failed",
    },
  ) {
    OpenBmcSensorValueRefused { reason } =>
      reason == "SSH host identity verification failed"
    _ => false
  }
}

test fn failed_sensor_projection_cannot_become_absent() -> Bool {
  match openbmc_sensor_integer_projection_result(
    success: false,
    value: "",
    stderr: "malformed OpenBMC JSON",
  ) {
    OpenBmcSensorValueRefused { reason } => reason == "malformed OpenBMC JSON"
    _ => false
  }
}

test fn successful_empty_sensor_projection_is_absent() -> Bool {
  match openbmc_sensor_integer_projection_result(
    success: true,
    value: "",
    stderr: "",
  ) {
    OpenBmcSensorValueAbsent => true
    _ => false
  }
}

test fn tach_below_controller_threshold_is_not_healthy() -> Bool {
  match openbmc_tach_health_from_floor(
    sensor: "FAN4",
    reading: rpm(899),
    minimum: rpm(900),
    source: OpenBmcWarningLowThreshold,
  ) {
    OpenBmcTachHealthObserved {
      health: OpenBmcTachBelowThreshold {
        sensor,
        reading_rpm,
        minimum_rpm,
        source: _,
      },
    } => sensor == "FAN4" && rpm_count(reading_rpm) == 899 && rpm_count(minimum_rpm) == 900
    _ => false
  }
}

test fn tach_at_controller_threshold_is_healthy() -> Bool {
  match openbmc_tach_health_from_floor(
    sensor: "FAN4",
    reading: rpm(900),
    minimum: rpm(900),
    source: OpenBmcWarningLowThreshold,
  ) {
    OpenBmcTachHealthObserved {
      health: OpenBmcTachAtOrAboveThreshold {
        sensor,
        reading_rpm,
        minimum_rpm,
        source: _,
      },
    } => sensor == "FAN4" && rpm_count(reading_rpm) == 900 && rpm_count(minimum_rpm) == 900
    _ => false
  }
}

test fn path_transport_whitespace_becomes_one_typed_path() -> Bool {
  match openbmc_path_result(
    remote: PasswordSshExecResult {
      exit_code: 0,
      success: true,
      stdout: "  /usr/share/swampd/config-asrr.json\n",
      stderr: "",
    },
  ) {
    OpenBmcPathObserved { path } =>
      path == "/usr/share/swampd/config-asrr.json"
    _ => false
  }
}

test fn empty_path_transport_is_refused() -> Bool {
  match openbmc_path_result(
    remote: PasswordSshExecResult {
      exit_code: 0,
      success: true,
      stdout: "\n",
      stderr: "",
    },
  ) {
    OpenBmcPathRefused { reason: _ } => true
    _ => false
  }
}

test fn zone_failsafe_transport_becomes_typed_bool() -> Bool {
  match openbmc_zone_failsafe_result(
    remote: PasswordSshExecResult {
      exit_code: 0,
      success: true,
      stdout: "b true\n",
      stderr: "",
    },
  ) {
    OpenBmcBoolObserved { value } => value
    _ => false
  }
}

test fn wrong_busctl_type_cannot_become_zone_failsafe_bool() -> Bool {
  match openbmc_zone_failsafe_result(
    remote: PasswordSshExecResult {
      exit_code: 0,
      success: true,
      stdout: "s true\n",
      stderr: "",
    },
  ) {
    OpenBmcBoolRefused { reason: _ } => true
    _ => false
  }
}

test fn disk_usage_transport_becomes_typed_byte_size() -> Bool {
  match openbmc_disk_usage_result(
    remote: PasswordSshExecResult {
      exit_code: 0,
      success: true,
      stdout: "Filesystem 1024-blocks Used Available Capacity Mounted on\n/dev/root 10000 7500 2500 75% /\n",
      stderr: "",
    },
  ) {
    OpenBmcByteSizeObserved { value } => byte_size_count(value) == 2560000
    _ => false
  }
}

test fn utc_epoch_seconds_become_epoch_milliseconds() -> Bool {
  match openbmc_epoch_result(
    remote: PasswordSshExecResult {
      exit_code: 0,
      success: true,
      stdout: "1722345678\n",
      stderr: "",
    },
  ) {
    OpenBmcInstantObserved { observed_at } => observed_at == 1722345678000
    _ => false
  }
}

test fn false_path_probe_is_observed_not_transport_refused() -> Bool {
  match openbmc_path_probe_result(
    remote: PasswordSshExecResult {
      exit_code: 1,
      success: false,
      stdout: "",
      stderr: "",
    },
  ) {
    OpenBmcBoolObserved { value } => !value
    _ => false
  }
}

test fn ssh_failure_cannot_masquerade_as_false_path_probe() -> Bool {
  match openbmc_path_probe_result(
    remote: PasswordSshExecResult {
      exit_code: 255,
      success: false,
      stdout: "",
      stderr: "SSH host identity verification failed",
    },
  ) {
    OpenBmcBoolRefused { reason } =>
      reason == "SSH host identity verification failed"
    _ => false
  }
}

test fn inconsistent_success_projection_is_refused() -> Bool {
  match openbmc_path_probe_result(
    remote: PasswordSshExecResult {
      exit_code: 0,
      success: false,
      stdout: "",
      stderr: "inconsistent transport projection",
    },
  ) {
    OpenBmcBoolRefused { reason } => reason == "inconsistent transport projection"
    _ => false
  }
}

test fn inactive_service_is_observed_not_transport_refused() -> Bool {
  match openbmc_service_active_result(
    remote: PasswordSshExecResult {
      exit_code: 3,
      success: false,
      stdout: "inactive\n",
      stderr: "",
    },
  ) {
    OpenBmcBoolObserved { value } => !value
    _ => false
  }
}
