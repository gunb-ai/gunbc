module test.claim.yaml_multiline_block_witness


data live_tree_disposition: LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn witness_top_level_multiline_is_block_literal() -> Bool {
  let test.claim.roadmap_authority.out = extdeps.languages.yaml.emit.serialize_yaml(v: extdeps.languages.yaml.types.yaml_string(s: "l1\nl2"))
  (test.claim.roadmap_authority.out == "|\n  l1\n  l2\n") &&
    (test.claim.roadmap_authority.out != "l1\nl2\n")
}

fn witness_multiline_sequence_element_is_block_literal() -> Bool {
  let test.claim.roadmap_authority.out = extdeps.languages.yaml.emit.serialize_yaml(v: extdeps.languages.yaml.types.yaml_mapping(entries: [
    extdeps.languages.yaml.types.kv(key: "items", value: extdeps.languages.yaml.types.yaml_sequence(elements: [extdeps.languages.yaml.types.yaml_string(s: "l1\nl2")]))
  ]))
  (test.claim.roadmap_authority.out == "items:\n  - |\n    l1\n    l2\n") &&
    (test.claim.roadmap_authority.out != "items: [l1\nl2]\n")
}

fn witness_multiline_mapping_value_still_block_literal() -> Bool {
  let test.claim.roadmap_authority.out = extdeps.languages.yaml.emit.serialize_yaml(v: extdeps.languages.yaml.types.yaml_mapping(entries: [
    extdeps.languages.yaml.types.kv(key: "run", value: extdeps.languages.yaml.types.yaml_string(s: "l1\nl2"))
  ]))
  test.claim.roadmap_authority.out == "run: |\n  l1\n  l2\n"
}

fn witness_no_embedded_newline_in_any_position() -> Bool {
  let top = extdeps.languages.yaml.emit.serialize_yaml(v: extdeps.languages.yaml.types.yaml_string(s: "a\nb"))
  let seq = extdeps.languages.yaml.emit.serialize_yaml(v: extdeps.languages.yaml.types.yaml_sequence(elements: [extdeps.languages.yaml.types.yaml_string(s: "a\nb")]))
  (top == "|\n  a\n  b\n") &&
    (seq == "- |\n  a\n  b\n")
}

test fn yaml_multiline_block_keystone_holds() -> Bool {
  witness_top_level_multiline_is_block_literal() &&
    witness_multiline_sequence_element_is_block_literal() &&
    witness_multiline_mapping_value_still_block_literal() &&
    witness_no_embedded_newline_in_any_position()
}
