module test.claim.uefi_boot_install_decision


test fn srv4_diagnoses_network_needs_dhcp_and_acts() -> Bool {
  let sit = gunbc.uefi_boot_install_decision.diagnose_boot_install(env: gunbc.srv4_uefi_observed.srv4_uefi_observed_environment)
  let is_needs_dhcp = match sit {
    gunbc.uefi_boot_install_decision.NetworkUpNeedsDhcp { interface: i } => i == "eth2"
    InstallMediaReady { boot_file: _ } => false
    NetworkReady { interface: _ } => false
    NoBootSourceAvailable { reason: _ } => false
  }
  let action = gunbc.uefi_boot_install_decision.decide_boot_install(situation: sit, goal: gunbc.uefi_boot_install_decision.InstalledFleetNode)
  let cmds_have_dhcp = match gunbc.uefi_boot_install_decision.boot_install_commands(action: action) {
    Present { value: cs } => string_contains(s: extdeps.firmware.uefi_shell.uefi_shell_script(commands: cs), pattern: "ifconfig -s eth2 dhcp")
    Absent => false
  }
  let not_refused = match action { gunbc.uefi_boot_install_decision.RefuseNoSource { reason: _ } => false, _ => true }
  is_needs_dhcp && cmds_have_dhcp && not_refused
}

test fn srv4_never_dhcps_the_link_local_nic() -> Bool {
  let action = gunbc.uefi_boot_install_decision.decide_boot_install(
    situation: gunbc.uefi_boot_install_decision.diagnose_boot_install(env: gunbc.srv4_uefi_observed.srv4_uefi_observed_environment),
    goal: gunbc.uefi_boot_install_decision.InstalledFleetNode,
  )
  match gunbc.uefi_boot_install_decision.boot_install_commands(action: action) {
    Present { value: cs } => !string_contains(s: extdeps.firmware.uefi_shell.uefi_shell_script(commands: cs), pattern: "ifconfig -s eth0 dhcp")
    Absent => false
  }
}

data no_source_env: extdeps.firmware.uefi_shell.UefiShellEnvironment = extdeps.firmware.uefi_shell.UefiShellEnvironment {
  mappings: [],
  boot_options: [],
  interfaces: [
    extdeps.firmware.uefi_shell.UefiNetworkInterface { name: "eth0", media: extdeps.firmware.uefi_shell.MediaDisconnected, ipv4: "0.0.0.0" },
  ],
}

test fn no_source_fails_closed() -> Bool {
  let sit = gunbc.uefi_boot_install_decision.diagnose_boot_install(env: no_source_env)
  let action = gunbc.uefi_boot_install_decision.decide_boot_install(situation: sit, goal: gunbc.uefi_boot_install_decision.InstalledFleetNode)
  let no_commands = match gunbc.uefi_boot_install_decision.boot_install_commands(action: action) {
    Present { value: _ } => false
    Absent => true
  }
  let is_refused = match action { gunbc.uefi_boot_install_decision.RefuseNoSource { reason: _ } => true, _ => false }
  is_refused && no_commands
}
