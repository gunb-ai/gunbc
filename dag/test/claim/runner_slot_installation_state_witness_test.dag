module test.claim.runner_slot_installation_state_witness

import std.logic { Bool }
import gunbc.runner_incarnation {
  RunnerSlotInstallationState,
  SlotAbsent,
  SlotMaterializedNotActive,
  SlotCurrentlyActive,
  runner_slot_add_requires_incarnation_replace,
  runner_slot_installation_is_ready_to_activate,
  runner_slot_installation_is_converged,
  runner_slot_installation_must_not_reextract,
}

test fn witness_never_activated_materialized_is_ready() -> Bool {
  runner_slot_installation_is_ready_to_activate(
    state: SlotMaterializedNotActive {
      install_tree_complete: true,
      unit_active: false,
      stale_runner_dot_present: false,
    },
  )
}

test fn witness_stale_runner_dot_does_not_block_activation() -> Bool {
  runner_slot_installation_is_ready_to_activate(
    state: SlotMaterializedNotActive {
      install_tree_complete: true,
      unit_active: false,
      stale_runner_dot_present: true,
    },
  )
    && !runner_slot_add_requires_incarnation_replace(
      state: SlotMaterializedNotActive {
        install_tree_complete: true,
        unit_active: false,
        stale_runner_dot_present: true,
      },
    )
}

test fn witness_materialized_not_active_must_not_reextract_when_complete() -> Bool {
  runner_slot_installation_must_not_reextract(
    state: SlotMaterializedNotActive {
      install_tree_complete: true,
      unit_active: false,
      stale_runner_dot_present: true,
    },
  )
}

test fn witness_absent_is_not_ready_and_may_fetch() -> Bool {
  !runner_slot_installation_is_ready_to_activate(state: SlotAbsent {})
    && !runner_slot_installation_must_not_reextract(state: SlotAbsent {})
}

test fn witness_active_unit_is_converged_not_ready() -> Bool {
  !runner_slot_installation_is_ready_to_activate(
    state: SlotMaterializedNotActive {
      install_tree_complete: true,
      unit_active: true,
      stale_runner_dot_present: true,
    },
  )
    && runner_slot_installation_is_converged(
      state: SlotMaterializedNotActive {
        install_tree_complete: true,
        unit_active: true,
        stale_runner_dot_present: true,
      },
    )
}

test fn witness_currently_active_is_converged() -> Bool {
  runner_slot_installation_is_converged(state: SlotCurrentlyActive {})
}
