module test.claim.compile_pool_ensure_wiring_witness

import gunbc.host_toolchain_ensure { host_toolchain_ensure_effect, CompilePool }
// IMPORTED FOR LOADING, NOT FOR BINDING, and the distinction is what this import is here to record.
// Names in this corpus resolve by global uniqueness across the modules a run has LOADED -- an import
// list does not bind them, which is why the other ten witnesses below reference symbols no import
// names and resolve fine. But a module enters the load graph only by being imported by something in
// the entry's closure, and gunbc.host_compile_pool_provision is a LEAF entry point: like its siblings
// gunbc.host_build_cache_provision and gunbc.srv3_os_install_actuator_toolchain_ensure, nothing in the
// corpus imports it. Without this line its symbols are absent rather than unbound, and the entry-point
// witness fails with NoSuchFunction -- measured, not reasoned: that is exactly how it failed under
// `gunbc run` before this import was added, while the same witness passed under the floor, which
// prepares one subject over all 3873 modules and therefore loads it anyway.
import gunbc.host_compile_pool_provision {
  provision_compile_pool_effect_for_host,
  provision_compile_pool_routes_through_host_effect_apply,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// WHAT THIS MODULE IS FOR: gunbc.compile_pool_ensure was proven over fixtures and computed by nothing --
// its only caller was its own test module -- so an admission named as the wall between a host and an
// unbounded compile pool was green without ever being asked a question. These witnesses assert the parts of
// the wiring that make it reachable, and the parts of the observation that decide what it is asked.

// REACHABILITY, not shape: the entrypoint a person or a converge pass actually calls must produce the effect,
// and the effect must resolve to a cell that dispatches to the realizer. Asserting the arm exists on the
// coproduct would prove nothing -- it existed before this change too, with nothing routing to it.
test fn witness_compile_pool_kind_produces_the_effect() -> Bool {
  match host_toolchain_ensure_effect(kind: CompilePool, host: "srv1" as HostIdentity) {
    EnsureCompilePoolSlice {} => true
    _ => false
  }
}

// THE ENTRY POINT EXISTS AND SELECTS THIS KIND. Without this the CompilePool arm is reachable from the
// dispatcher and the dispatcher reachable from nobody -- which is the same unreachability this module
// exists to close, moved one layer out. It asserts the production func's own effect selection rather
// than re-asserting the dispatcher's, so deleting provision_compile_pool reds here.
test fn witness_production_entry_point_selects_the_compile_pool_effect() -> Bool {
  match provision_compile_pool_effect_for_host(host: "srv1" as HostIdentity) {
    EnsureCompilePoolSlice {} => provision_compile_pool_routes_through_host_effect_apply()
    _ => false
  }
}

// THE UNIT FILE IS NO LONGER A PROGRAM, so these assert an argv VECTOR rather than substrings in a shell
// body. That is a stronger claim than the pair they replace: a substring assertion over a program cannot
// tell a word from text that happens to contain it, and both of the old witnesses would have passed on a
// body that spelled the right characters inside the wrong quoting. Word identity has no such gap.
//
// RED IS AUTHORABLE for each: re-fusing the publish into one string, dropping sudo, changing the mode away
// from the declared authority, or reaching for restart all change a word this compares by equality.
test fn witness_publish_is_typed_words_and_never_a_program() -> Bool {
  let argv = compile_pool_slice_publish_argv(slice_unit: gunbc_managed_compile_pool_slice)
  (argv ==
    [
      "sudo",
      "-n",
      "install",
      "-m",
      "0644",
      concat("/tmp/", gunbc_managed_compile_pool_slice as String),
      concat("/etc/systemd/system/", gunbc_managed_compile_pool_slice as String),
    ])
    && (any(argv, w => string_contains(s: w, pattern: " ")) == false)
    && (any(argv, w => string_contains(s: w, pattern: ">")) == false)
}

// THE MODE IS THE DECLARED AUTHORITY'S, NOT A LITERAL SPELLED TWICE. The vector above pins "0644" as the
// value a reader can see; this pins that the value CAME FROM compile_pool_slice_file_mode, so editing the
// authority moves the argv rather than leaving two spellings to drift apart.
test fn witness_publish_mode_is_read_from_the_declared_authority() -> Bool {
  any(
    compile_pool_slice_publish_argv(slice_unit: gunbc_managed_compile_pool_slice),
    w => w == compile_pool_slice_file_mode as String,
  )
}

// START, NEVER RESTART: stopping a slice kills every process in it (systemd.slice(5)), so a restart here
// would terminate the compilers the pool exists to hold.
test fn witness_start_argv_starts_and_never_restarts_the_slice() -> Bool {
  let argv = compile_pool_privileged_argv(argv: systemctl_start_argv(unit: gunbc_managed_compile_pool_slice))
  (argv == ["sudo", "-n", "systemctl", "start", gunbc_managed_compile_pool_slice as String])
    && (any(argv, w => w == "restart") == false)
}

// THE STAGING PATH IS INSIDE THE SCOPE THE SEAL IS GIVEN, and the negative is the point: a path outside it
// must REFUSE rather than write. Without the second half this would pass on a seal that admitted anything.
test fn witness_staging_seal_admits_its_scope_and_refuses_outside_it() -> Bool {
  let inside = typed_remote_file_write_seal(
    path: compile_pool_slice_staging_path(slice_unit: gunbc_managed_compile_pool_slice) as FilePath,
    content: "[Slice]\n",
    allowed_scope: compile_pool_slice_staging_scope(),
  )
  let outside = typed_remote_file_write_seal(
    path: "/etc/systemd/system/gunbc-compile.slice" as FilePath,
    content: "[Slice]\n",
    allowed_scope: compile_pool_slice_staging_scope(),
  )
  match inside {
    TypedRemoteFileWriteAdmitted { write: _ } =>
      match outside {
        TypedRemoteFileWriteAdmissionRefused { cause: _ } => true
        _ => false
      }
    _ => false
  }
}

// PUBLICATION IS TWO STEPS AND THE SECOND ONE IS A RENAME. install(1) opens its destination
// O_CREAT|O_TRUNC -- measured on this fleet: same inode before and after -- so publishing straight to the
// system path would let it pass through a truncated state that a concurrent systemd read can see. The
// staged read-back cannot catch that, because it proves the STAGED copy while systemd opens the PUBLISHED
// one. So install lands the bytes at a sibling incoming name and mv -f renames within the directory.
test fn witness_publication_renames_rather_than_truncating_the_destination() -> Bool {
  let publish = compile_pool_slice_publish_argv(slice_unit: gunbc_managed_compile_pool_slice)
  let rename = compile_pool_slice_rename_argv(slice_unit: gunbc_managed_compile_pool_slice)
  let dest = concat("/etc/systemd/system/", gunbc_managed_compile_pool_slice as String)
  let incoming = concat(dest, ".gunbc-incoming")
  (any(publish, w => w == dest) == false)
    && any(publish, w => w == incoming)
    && (rename == ["sudo", "-n", "mv", "-f", incoming, dest])
}

// THE RENAME MUST BE WITHIN ONE DIRECTORY OR IT IS NOT ATOMIC. rename(2) across filesystems degrades to
// copy-and-unlink, which reopens the window the two-step publish closes. Deriving the incoming name as a
// suffix on the destination makes same-directory structural, and this asserts that derivation rather than
// trusting it: a future edit relocating staging to /tmp or a scratch dir reds here.
test fn witness_incoming_name_is_a_sibling_of_the_destination() -> Bool {
  let dest = compile_pool_slice_system_path(slice_unit: gunbc_managed_compile_pool_slice)
  let incoming = compile_pool_slice_incoming_path(slice_unit: gunbc_managed_compile_pool_slice)
  starts_with(s: incoming, prefix: concat(dest, "."))
    && (string_contains(s: incoming, pattern: "/tmp") == false)
}

fn compile_pool_witness_intent() -> HostEffectIntent {
  HostEffectIntent {
    target: HostOs { node: srv1_host },
    effect: EnsureCompilePoolSlice {},
    evidence: host_effect_identity_evidence,
    transport: SshShell { ssh_host: "srv1" as NonEmptyStr },
    privilege_denial: none,
  }
}

// THE TRANSPORT NARROWING, ASSERTED RATHER THAN DESCRIBED. The typed write needs the SshTarget and the
// sealed context, so SshShell must refuse where the deleted shell body would have run. This is the one
// behaviour this conversion REMOVES, so it is the one a reader is most entitled to see enforced.
test fn witness_unanchored_transport_refuses_instead_of_installing() -> Bool {
  match realize_ensure_compile_pool_slice(
    transport: SshShell { ssh_host: "srv1" as NonEmptyStr },
    effect_intent: compile_pool_witness_intent(),
  ) {
    NotConverged { reason: r, applied: _ } =>
      string_contains(s: r, pattern: "FleetSshExecutionContext")
        && string_contains(s: r, pattern: "No unit written")
    _ => false
  }
}

test fn witness_compile_pool_effect_routes_to_the_host_cell() -> Bool {
  match resolve_host_effect_cell(target: HostOs { node: srv1_host }, effect: EnsureCompilePoolSlice {}) {
    EnsureCompilePoolSliceOnHost { node: _ } => true
    _ => false
  }
}

// The BMC arm is the discriminating negative: a slice is an in-band systemd fact, so a Redfish target must
// refuse rather than resolve. Without it the routing witness above would pass on a fold that resolved
// everything to the same cell.
test fn witness_compile_pool_effect_refuses_a_bmc_target() -> Bool {
  match resolve_host_effect_cell(target: BmcController { node: srv1_host }, effect: EnsureCompilePoolSlice {}) {
    IncompatibleCell { reason: why } => string_contains(s: why, pattern: "EnsureCompilePoolSlice")
    _ => false
  }
}

// THE LIVE TOPOLOGY TRIPWIRE, and it reads the REAL gunbc_compile_pool_placement rather than a fixture, so it
// is a claim about this fleet. It asserts a REFUSAL today: the row is CompilePoolInRunnerSlots, so no host has
// a managed slice and every convergence attempt refuses naming that row. When the row flips to
// CompilePoolSliceDeclared this witness reds -- deliberately, in the same change that shrinks runner_pool --
// and at that point it becomes an assertion that the pool converges rather than being deleted.
test fn witness_live_topology_refuses_the_slice_ensure() -> Bool {
  let a = admit_ensure_compile_pool_slice(
    topology: gunbc_compile_pool_placement,
    sizing: compile_pool_bytes_for(
      placement: gunbc_compile_pool_placement,
      nproc: hardware_thread_count(count: 128),
      host: byte_size(134317047808),
      citation: jobserver_config,
    ),
    cache_placement: ServerPlacementAbsent,
    observed: CompilePoolSliceAbsent { slice_unit: gunbc_managed_compile_pool_slice },
  )
  match a {
    EnsureCompilePoolRefused { reason: r } =>
      match r {
        EnsurePoolTopologyUndeclared { detail: d } =>
          string_contains(s: d as String, pattern: "gunbc_compile_pool_placement")
        _ => false
      }
    _ => false
  }
}

// INFINITY IS NOT A SIZE, AND THIS IS THE RED THAT MATTERS MOST IN THE OBSERVATION. `systemctl show
// --property=MemoryMax --value` answers `infinity` both for a unit the manager never heard of and for a
// loaded slice with no ceiling. Reading either as a magnitude would let a slice with NO LIMIT be reported as
// a sized pool, which is the unbounded charge the managed slice exists to replace -- reported as its own
// remedy. The refusal is what keeps the two apart.
test fn witness_unbounded_memory_max_is_not_read_as_a_size() -> Bool {
  match compile_pool_limit_of_capture(
    slice_unit: gunbc_managed_compile_pool_slice,
    property_name: "MemoryMax",
    capture: SystemdPropertyCaptured { value: "infinity" },
  ) {
    CompilePoolLimitRefused { observation: o } =>
      match o {
        CompilePoolObservationUnavailable { reason: _ } => true
        _ => false
      }
    CompilePoolLimitBytes { bytes: _ } => false
  }
}

// The paired positive control: a real byte count must decode, or the refusal above would be satisfied by a
// decoder that refuses everything.
test fn witness_numeric_memory_max_decodes_to_bytes() -> Bool {
  match compile_pool_limit_of_capture(
    slice_unit: gunbc_managed_compile_pool_slice,
    property_name: "MemoryMax",
    capture: SystemdPropertyCaptured { value: "17179869184" },
  ) {
    CompilePoolLimitBytes { bytes: b } => byte_size_count(b: b) == 17179869184
    CompilePoolLimitRefused { observation: _ } => false
  }
}

// A read that could not run is UNAVAILABLE, never ABSENT. The two have opposite remedies -- install the slice
// versus fix the reach -- and folding an unreadable manager into "the slice is not there" would send a
// converger to write a unit on a host it cannot see.
test fn witness_unreadable_property_is_unavailable_not_absent() -> Bool {
  match compile_pool_limit_of_capture(
    slice_unit: gunbc_managed_compile_pool_slice,
    property_name: "MemoryMax",
    capture: SystemdPropertyCaptureRefused { reason: "systemctl show exited unsuccessfully" },
  ) {
    CompilePoolLimitRefused { observation: o } =>
      match o {
        CompilePoolObservationUnavailable { reason: _ } => true
        CompilePoolSliceAbsent { slice_unit: _ } => false
        CompilePoolSliceObserved { slice_unit: _, limits: _ } => false
      }
    CompilePoolLimitBytes { bytes: _ } => false
  }
}

// The load-state argv the transport materializes must be the argv extdeps.systemd.systemctl declares. Without
// this the operation could drift from its own authority and every reading above would be of the wrong unit.
test fn witness_load_state_operation_argv_matches_its_authority() -> Bool {
  systemctl_show_load_state_operation_argv_matches_transport(unit: gunbc_managed_compile_pool_slice)
}
