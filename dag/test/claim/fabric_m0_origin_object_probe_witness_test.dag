module test.claim.fabric_m0_origin_object_probe_witness

import std.types { Bool, NonEmptyStr }
import std.process { exit_ok }
import std.content_hash { content_hash_eq_cryptographic }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import gunbc.fabric_m0_origin_readback {
  OriginReadingOutcome,
  OriginReadingTaken,
  OriginReadingUnavailable,
  OriginObjectStaged,
  OriginObjectAbsent,
  OriginFetchUnavailable,
  origin_reading_digest,
  read_origin_staged_file,
}
import gunbc.fabric_m0_commit {
  ManifestRead,
  ManifestNotFound,
  ManifestReadUnavailable,
  manifest_read_of_origin_fetch,
}
import tools.fabric_m0_origin_object_probe {
  canary_identity,
  absent_key,
  fetch_absent_instrument,
  canary_exit_from_origin_fetch,
  canary_exit_is_zero,
}

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data fixture_staged_manifest: NonEmptyStr = "dag/test/fixture/fabric_m0_origin_readback/staged_manifest.txt"

fn read_outcome() -> OriginReadingOutcome {
  read_origin_staged_file(staged_path: fixture_staged_manifest)
}

test fn the_canary_identity_is_named() -> Bool {
  canary_identity == "gunbc.fabric-m0.canary:1"
}

test fn fetch_absent_is_the_named_executing_instrument() -> Bool {
  fetch_absent_instrument == "tools.fabric_m0_origin_object_probe.fetch_absent"
}

test fn an_absent_origin_object_is_manifest_not_found() -> Bool {
  match manifest_read_of_origin_fetch(fetch: OriginObjectAbsent { key: absent_key }) {
    ManifestNotFound => true
    ManifestRead { reading: _ } => false
    ManifestReadUnavailable { cause: _ } => false
  }
}

test fn an_unavailable_origin_fetch_is_manifest_read_unavailable() -> Bool {
  match manifest_read_of_origin_fetch(fetch: OriginFetchUnavailable { key: absent_key, cause: "origin unbound" }) {
    ManifestReadUnavailable { cause } => cause == "origin unbound"
    ManifestRead { reading: _ } => false
    ManifestNotFound => false
  }
}

test fn a_staged_fetch_carries_the_reading_the_fetch_holds() -> Bool {
  match read_outcome() {
    OriginReadingUnavailable { staged_path: _, cause: _ } => false
    OriginReadingTaken { reading: r } =>
      match manifest_read_of_origin_fetch(fetch: OriginObjectStaged { key: absent_key, reading: r }) {
        ManifestRead { reading: observed } =>
          content_hash_eq_cryptographic(left: origin_reading_digest(reading: observed), right: origin_reading_digest(reading: r))
        ManifestNotFound => false
        ManifestReadUnavailable { cause: _ } => false
      }
  }
}

// fetch_absent's live arm: origin says the never-written key is absent, this canary does not PUT,
// so the publication is pending and the process exit is non-zero. ActionRequired is not Success.
test fn fetch_absent_pending_exits_nonzero() -> Bool {
  exit_ok(e: canary_exit_from_origin_fetch(fetch: OriginObjectAbsent { key: absent_key })) == false
    && (canary_exit_is_zero(fetch: OriginObjectAbsent { key: absent_key }) == false)
}

test fn an_unavailable_fetch_exits_nonzero() -> Bool {
  canary_exit_is_zero(fetch: OriginFetchUnavailable { key: absent_key, cause: "origin unbound" }) == false
}
