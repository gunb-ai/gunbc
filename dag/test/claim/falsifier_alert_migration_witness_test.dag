  match floor_component_receipt_decode_with(
    text: "{\"schema\":\"floor-component-receipt/v1\",\"workflow_name\":42,\"run_id\":\"1\",\"head_sha\":\"abc\",\"component_count\":0,\"affected_set_cold_control\":null,\"selection_degradation\":null,\"unsuccessful_components\":[],\"components\":[]}",
    expected_schema: alert_expected_schema
  ) {
    ReceiptMemberMalformed { member: m, detail: _ } => m == "workflow_name"
    _ => false
