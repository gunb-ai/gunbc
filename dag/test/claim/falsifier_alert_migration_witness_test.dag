data workflow_path_claim_note: String = "The display name and the file path are asserted as SEPARATE refusals because they are separate facts: a workflow can be renamed without moving, and a file can be moved without being renamed. A wall that checked only the name would admit a run of a different file that had been given the expected name."

fn event_with_path(path: String) -> String {
  concat(concat(
    "{\"action\":\"completed\",\"repository\":{\"full_name\":\"gunb-ai/gunbc\"},\"workflow_run\":{\"id\":31000000010,\"workflow_id\":161803,\"path\":\"",
    path), "\",\"name\":\"affected-set-falsifier\",\"conclusion\":\"failure\",\"html_url\":\"https://x\",\"run_started_at\":\"2026-08-06T00:00:00Z\",\"head_sha\":\"0123456789abcdef0123456789abcdef01234567\",\"head_branch\":\"main\",\"head_repository\":{\"full_name\":\"gunb-ai/gunbc\"},\"event\":\"schedule\"}}")
}

test fn the_trust_wall_refuses_an_impostor_file_wearing_the_expected_name() -> Bool {
  match falsifier_alert_admit(observation: workflow_run_event_from_json(text: event_with_path(path: ".github/workflows/attacker.yml"))) {
    AlertRefusedWorkflowPathNotObserved { observed: o, expected: _ } =>
      o == ".github/workflows/attacker.yml"
    _ => false
  }
}

test fn the_trust_wall_admits_the_expected_workflow_file() -> Bool {
  match falsifier_alert_admit(observation: workflow_run_event_from_json(text: event_with_path(path: ".github/workflows/falsifier.yml"))) {
    AlertAdmitted { event: _ } => true
    _ => false
  }
}

data malformed_state_claim_note: String = "The load-bearing claim of item B: a malformed marker must NOT reach any notify arm, because every notify arm is followed by a write that would overwrite the corrupt marker and destroy the only record of when the incident began."

test fn a_malformed_state_marker_refuses_instead_of_starting_a_new_incident() -> Bool {
  let d = falsifier_alert_notification_decision(
    now: 9999999,
    decoding: falsifier_alert_state_from_payload(payload: "{\"first_red\":\"not-a-number\",\"signature\":\"x\"}"),
    signature: "a:b:c" as NonEmptyStr
  )
  match d {
    RefuseMalformedState { detail: _ } => true
    _ => false
  }
}

test fn an_absent_state_marker_still_initiates_typed_state() -> Bool {
  match falsifier_alert_notification_decision(
    now: 9999999,
    decoding: StateAbsent,
    signature: "a:b:c" as NonEmptyStr
  ) {
    NotifyFirstRed => true
    _ => false
  }
}

data receipt_strictness_claim_note: String = "Item C's claims. The count check is the one worth naming: the decoder previously IGNORED the wire component_count and recomputed it from the array, which is the recompute-instead-of-check pattern — it cannot disagree with itself, so it can never report that the producer and its own array are inconsistent. Checking the declared value against the decoded one is what makes the field mean anything."

fn receipt_with(component_count: String, components: String, unsuccessful: String) -> String {
  concat(concat(concat(concat(
    "{\"schema\":\"floor-component-receipt/v1\",\"workflow_name\":\"affected-set-falsifier\",\"run_id\":\"31000000001\",\"head_sha\":\"0123456789abcdef0123456789abcdef01234567\",\"component_count\":",
    component_count), ",\"affected_set_cold_control\":null,\"selection_degradation\":null,\"unsuccessful_components\":"),
    unsuccessful), concat(",\"components\":", concat(components, "}")))
}

data one_component: String = "{\"index\":6,\"label\":\"witness discovery\",\"outcome\":\"failed\",\"error\":\"claim is false\",\"output\":\"\",\"failure_mode\":\"WitnessRed\"}"

data one_done_component: String = "{\"index\":6,\"label\":\"witness discovery\",\"outcome\":\"done\",\"failure_mode\":\"none\"}"

test fn a_declared_component_count_that_disagrees_with_the_array_refuses() -> Bool {
  match floor_component_receipt_decode_with(
    text: receipt_with(component_count: "7", components: concat(concat("[", one_done_component), "]"), unsuccessful: "[]"),
    expected_schema: alert_expected_schema
  ) {
    ReceiptComponentCountMismatch { declared: d, decoded: n } => d == "7" && n == 1
    _ => false
  }
}

test fn an_agreeing_component_count_decodes() -> Bool {
  match floor_component_receipt_decode_with(
    text: receipt_with(component_count: "1", components: concat(concat("[", one_done_component), "]"), unsuccessful: "[]"),
    expected_schema: alert_expected_schema
  ) {
    ReceiptDecoded { document: doc } => doc.component_count == 1
    _ => false
  }
}

test fn duplicate_unsuccessful_component_identities_refuse() -> Bool {
  let two = concat(concat(concat("[", one_component), concat(",", one_component)), "]")
  match floor_component_receipt_decode_with(
    text: receipt_with(component_count: "2", components: concat(concat(concat("[", one_component), concat(",", one_component)), "]"), unsuccessful: two),
    expected_schema: alert_expected_schema
  ) {
    ReceiptUnsuccessfulComponentIdentityNotUnique { count: n } => n == 2
    _ => false
  }
}

test fn the_alert_summary_decodes_the_four_signature_fields() -> Bool {
  match floor_component_receipt_decode_with(
    text: receipt_with(component_count: "1", components: concat(concat("[", one_component), "]"), unsuccessful: concat(concat("[", one_component), "]")),
    expected_schema: alert_expected_schema
  ) {
    ReceiptDecoded { document: doc } =>
      match doc.unsuccessful_summaries.first() {
        Present { value: sm } =>
          sm.index == 6
            && (sm.label as String) == "witness discovery"
            && summary_outcome_is_unsuccessful(s: sm)
            && floor_component_failure_mode_tag(m: sm.failure_mode) == "WitnessRed"
        Absent => false
      }
    _ => false
  }
}

test fn an_unsuccessful_component_missing_failure_mode_refuses_located() -> Bool {
  let no_mode = "{\"index\":6,\"label\":\"witness discovery\",\"outcome\":\"failed\"}"
  match floor_component_receipt_decode_with(
    text: receipt_with(component_count: "1", components: concat(concat("[", no_mode), "]"), unsuccessful: concat(concat("[", no_mode), "]")),
    expected_schema: alert_expected_schema
  ) {
    ReceiptMemberAbsent { member: m } => m == "failure_mode"
    _ => false
  }
}

test fn a_required_auxiliary_member_absent_refuses_rather_than_becoming_null() -> Bool {
  match floor_component_receipt_decode_with(
