data pair_and_strict_number_claims_note: String = "The operator's live-head items B and C. Every fixture below carries two individually VALID typed values, or a numeric lexeme JSON is happy to call a number — so each one decoded cleanly under the previous revision and would have flowed into routing and incident identity."

test fn an_impossible_outcome_and_mode_pair_refuses_even_though_both_are_typed() -> Bool {
  match decode_receipt_with_component(component: "{\"index\":6,\"label\":\"x\",\"outcome\":\"done\",\"failure_mode\":\"WitnessRed\"}") {
    ReceiptMemberMalformed { member: m, detail: _ } => m == "outcome"
    _ => false
  }
}

test fn a_failed_outcome_claiming_no_failure_mode_refuses() -> Bool {
  match decode_receipt_with_component(component: "{\"index\":6,\"label\":\"x\",\"outcome\":\"failed\",\"error\":\"e\",\"output\":\"\",\"failure_mode\":\"none\"}") {
    ReceiptMemberMalformed { member: m, detail: _ } => m == "outcome"
    _ => false
  }
}

test fn the_unrecorded_mode_keeps_its_broader_relationship() -> Bool {
  let c = "{\"index\":6,\"label\":\"x\",\"outcome\":\"failed\",\"error\":\"e\",\"output\":\"\",\"failure_mode\":\"unrecorded\"}"
  match floor_component_receipt_decode_with(
    text: receipt_with(component_count: "1", components: concat(concat("[", c), "]"), unsuccessful: concat(concat("[", c), "]")),
    expected_schema: alert_expected_schema
  ) {
    ReceiptDecoded { document: _ } => true
    _ => false
  }
}

test fn a_failed_outcome_output_is_read_rather_than_fabricated() -> Bool {
  match floor_component_receipt_decode_with(
    text: receipt_with(
      component_count: "1",
      components: "[{\"index\":6,\"label\":\"x\",\"outcome\":\"failed\",\"error\":\"e\",\"output\":\"the real captured output\",\"failure_mode\":\"WitnessRed\"}]",
      unsuccessful: "[{\"index\":6,\"label\":\"x\",\"outcome\":\"failed\",\"error\":\"e\",\"output\":\"the real captured output\",\"failure_mode\":\"WitnessRed\"}]"
    ),
    expected_schema: alert_expected_schema
  ) {
    ReceiptDecoded { document: doc } =>
      match doc.unsuccessful_summaries.first() {
        Present { value: sm } =>
          match sm.outcome {
            ComponentConcluded { outcome: o } =>
              match o {
                Failed { error: _, output: out } => out == "the real captured output"
                _ => false
              }
            ComponentNotConcluded => false
          }
        Absent => false
      }
    _ => false
  }
}

test fn a_failed_outcome_missing_its_output_member_refuses() -> Bool {
  match decode_receipt_with_component(component: "{\"index\":6,\"label\":\"x\",\"outcome\":\"failed\",\"error\":\"e\",\"failure_mode\":\"WitnessRed\"}") {
    ReceiptMemberMalformed { member: m, detail: _ } => m == "outcome"
    _ => false
  }
}

data strict_natural_claims_note: String = "Four lexemes JSON calls numbers and a cardinal index cannot be. Under parse_int each produced a value — a truncation, a wrong magnitude, or a negative position — with nothing marking the input as outside what the field means."

