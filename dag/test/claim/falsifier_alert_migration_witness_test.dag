data component_summary_strictness_note: String = "The component summary's string fields get the same numeric-plant treatment as the event envelope, because they are the same class and were the residue review 49571 found: one decoder served all four fields and widened numbers on all four while the note beside it claimed only index did. Each plant replaces a value in place — not appended as a duplicate — for the reason the event plants record."

fn component_with(index: String, label: String, outcome: String, mode: String) -> String {
  concat(concat(concat(concat(concat(concat(concat(
    "{\"index\":", index), ",\"label\":"), label), ",\"outcome\":"), outcome), ",\"failure_mode\":"), concat(mode, "}"))
}

data csum_valid_index: String = "6"
data csum_valid_label: String = "\"witness discovery\""
data csum_valid_outcome: String = "\"done\""
data csum_valid_mode: String = "\"none\""

fn decode_receipt_with_component(component: String) -> FloorComponentReceiptDecoding {
  floor_component_receipt_decode_with(
    text: receipt_with(
      component_count: "1",
      components: concat(concat("[", component), "]"),
      unsuccessful: "[]"
    ),
    expected_schema: alert_expected_schema
  )
}

fn component_numeric_plant_refuses_at(field: String) -> Bool {
  let c = if field == "label" {
    component_with(index: csum_valid_index, label: plant_number, outcome: csum_valid_outcome, mode: csum_valid_mode)
  } else if field == "outcome" {
    component_with(index: csum_valid_index, label: csum_valid_label, outcome: plant_number, mode: csum_valid_mode)
  } else {
    component_with(index: csum_valid_index, label: csum_valid_label, outcome: csum_valid_outcome, mode: plant_number)
  }
  match decode_receipt_with_component(component: c) {
    ReceiptMemberMalformed { member: m, detail: _ } => m == field
    _ => false
  }
}

test fn a_numeric_component_label_refuses_located() -> Bool {
  component_numeric_plant_refuses_at(field: "label")
}

test fn a_numeric_component_outcome_refuses_located() -> Bool {
  component_numeric_plant_refuses_at(field: "outcome")
}

test fn a_numeric_component_failure_mode_refuses_located() -> Bool {
  component_numeric_plant_refuses_at(field: "failure_mode")
}

test fn the_component_index_still_accepts_its_numeric_wire_form() -> Bool {
  match decode_receipt_with_component(component: component_with(index: csum_valid_index, label: csum_valid_label, outcome: csum_valid_outcome, mode: csum_valid_mode)) {
    ReceiptDecoded { document: doc } =>
      match doc.component_summaries.first() {
        Present { value: sm } => sm.index == 6
        Absent => false
      }
    _ => false
  }
}

data operator_strict_boundary_claims_note: String = "The operator verdict's four decision-grain corrections, each asserted on the arm that was NOT already working. Every one of these fixtures decoded cleanly before the corrections landed, which is the whole point: the boundary guaranteed the fields were PRESENT and it did not guarantee they MEANT anything, and presence is invisible to a witness that only ever feeds well-formed input."

data component_with_text_index: String = "{\"index\":\"6\",\"label\":\"witness discovery\",\"outcome\":\"done\",\"failure_mode\":\"none\"}"

test fn a_text_component_index_refuses_rather_than_being_read_as_an_identity() -> Bool {
  match decode_receipt_with_component(component: component_with_text_index) {
    ReceiptMemberMalformed { member: m, detail: _ } => m == "index"
