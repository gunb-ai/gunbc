data population_join_claims_note: String = "The identity join, asserted in BOTH directions, because the two failures are not symmetric in consequence. A row listed as unsuccessful that is not failing over-reports and is merely noisy; a failing row MISSING from the list under-reports, and the alert then tells an operator that a component is fine while the receipt beside it says otherwise. The second is the one a uniqueness check could never see, so it is the one written first."

test fn a_failing_component_omitted_from_the_unsuccessful_list_refuses() -> Bool {
  match floor_component_receipt_decode_with(
    text: receipt_with(component_count: "1", components: concat(concat("[", one_component), "]"), unsuccessful: "[]"),
    expected_schema: alert_expected_schema
  ) {
    ReceiptUnsuccessfulPopulationMismatch { listed: l, derived: d } => l == 0 && d == 1
    _ => false
  }
}

test fn a_successful_component_listed_as_unsuccessful_refuses() -> Bool {
  match floor_component_receipt_decode_with(
    text: receipt_with(component_count: "1", components: concat(concat("[", one_done_component), "]"), unsuccessful: concat(concat("[", one_done_component), "]")),
    expected_schema: alert_expected_schema
  ) {
    ReceiptUnsuccessfulPopulationMismatch { listed: l, derived: d } => l == 1 && d == 0
    _ => false
  }
}

test fn an_unsuccessful_row_naming_an_absent_component_refuses() -> Bool {
  let ghost = "{\"index\":99,\"label\":\"never ran\",\"outcome\":\"failed\",\"error\":\"e\",\"output\":\"\",\"failure_mode\":\"WitnessRed\"}"
  match floor_component_receipt_decode_with(
    text: receipt_with(component_count: "1", components: concat(concat("[", one_component), "]"), unsuccessful: concat(concat("[", ghost), "]")),
    expected_schema: alert_expected_schema
  ) {
    ReceiptUnsuccessfulPopulationMismatch { listed: _, derived: _ } => true
    _ => false
  }
}

test fn the_matching_population_decodes() -> Bool {
  match floor_component_receipt_decode_with(
    text: receipt_with(component_count: "1", components: concat(concat("[", one_component), "]"), unsuccessful: concat(concat("[", one_component), "]")),
    expected_schema: alert_expected_schema
  ) {
    ReceiptDecoded { document: doc } => count(doc.unsuccessful_summaries) == 1 && count(doc.component_summaries) == 1
    _ => false
  }
}

