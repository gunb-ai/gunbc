module test.claim.roadmap_closing_contract_authoring_witness_test

import std.types { Bool, String, NonEmptyStr, FilePath, Int }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import gunbc.roadmap_model { RoadmapNodeId }
import gunbc.roadmap_execution_contract {
  WorkItemExecutionContract,
  ExecutionContract,
  ExecutionContractUnspecified,
  ValidationOperation,
  GunbcClaimValidation,
  CargoTestValidation,
  CargoFmtValidation,
  ClosingContractAuthoringValidation,
  CapabilityRealization,
  DispatchHostEnvironment,
  GunbcClaimRunnerCapability,
  closing_contract_authoring_contract,
  validation_operation_command,
}
import gunbc.ensure { EnsureObserveOnly }
import gunbc.roadmap_validation_oracle {
  ValidationOracleRef,
  OracleObservation,
  OracleFound,
  OracleMissing,
  OracleAmbiguous,
  OracleDependsOnUnpinnedOracle,
}
import std.content_hash { content_hash_atom }
import gunbc.roadmap_closing_contract_authoring {
  ClosingContractAuthoringVerdict,
  ClosingContractAuthored,
  ClosingContractTargetNotDeclared,
  ClosingContractTargetUnspecified,
  ClosingContractTargetClosesNothing,
  ClosingContractTargetClosesItself,
  ClosingContractTargetOracleIncomplete,
  closing_contract_verdict_for_observed,
  closing_contract_authoring_verdict,
  closing_contract_authored,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data closing_contract_authoring_witness_note: String = "EVERY REFUSAL ARM FIRES ON A PLANTED INPUT, and the arms are planted rather than found because the point of this predicate is that it discriminates. The oracle observations are supplied as a parameter to closing_contract_verdict_for_observed, so a missing oracle and an ambiguous one are authored here rather than depending on a file that happens to be absent from the tree — which would be a fixture whose red is a property of the checkout instead of the predicate. The one arm read against the LIVE authority is ClosingContractTargetNotDeclared, because a name no node carries cannot be planted any other way, and its positive control sits beside it so the pair cannot both be satisfied by a predicate that always refuses."

fn target() -> RoadmapNodeId { "example-node" as RoadmapNodeId }

fn resolving_validation() -> ValidationOperation {
  GunbcClaimValidation {
    entry: "dag/test/claim/example_test.dag" as FilePath,
    function: "example_holds" as NonEmptyStr,
  }
}

fn resolving_oracle() -> ValidationOracleRef {
  ValidationOracleRef {
    entry: "dag/test/claim/example_test.dag" as FilePath,
    function: "example_holds" as NonEmptyStr,
  }
}

fn found_observation() -> OracleObservation {
  OracleFound {
    oracle: resolving_oracle(),
    identity: content_hash_atom(value: "example-oracle" as NonEmptyStr),
  }
}

fn authored_contract() -> WorkItemExecutionContract {
  ExecutionContract {
    validations: [resolving_validation()],
    extra_capabilities: [],
  }
}

test fn a_resolving_contract_closes_its_target() -> Bool {
  match closing_contract_verdict_for_observed(
    node: target(),
    contract: authored_contract(),
    observations: [found_observation()],
  ) {
    ClosingContractAuthored { target: t } => (t as String) == "example-node"
    ClosingContractTargetNotDeclared { target: _ } => false
    ClosingContractTargetUnspecified { target: _ } => false
    ClosingContractTargetClosesNothing { target: _ } => false
    ClosingContractTargetClosesItself { target: _ } => false
    ClosingContractTargetOracleIncomplete { target: _, blocking: _ } => false
  }
}

test fn an_unspecified_contract_refuses() -> Bool {
  match closing_contract_verdict_for_observed(
    node: target(),
    contract: ExecutionContractUnspecified,
    observations: [],
  ) {
    ClosingContractTargetUnspecified { target: t } => (t as String) == "example-node"
    ClosingContractAuthored { target: _ } => false
    ClosingContractTargetNotDeclared { target: _ } => false
    ClosingContractTargetClosesNothing { target: _ } => false
    ClosingContractTargetClosesItself { target: _ } => false
    ClosingContractTargetOracleIncomplete { target: _, blocking: _ } => false
  }
}

test fn a_contract_with_no_validation_refuses_separately() -> Bool {
  match closing_contract_verdict_for_observed(
    node: target(),
    contract: ExecutionContract { validations: [], extra_capabilities: [] },
    observations: [],
  ) {
    ClosingContractTargetClosesNothing { target: t } => (t as String) == "example-node"
    ClosingContractAuthored { target: _ } => false
    ClosingContractTargetNotDeclared { target: _ } => false
    ClosingContractTargetUnspecified { target: _ } => false
    ClosingContractTargetClosesItself { target: _ } => false
    ClosingContractTargetOracleIncomplete { target: _, blocking: _ } => false
  }
}

test fn a_target_closed_by_another_closing_contract_task_refuses() -> Bool {
  match closing_contract_verdict_for_observed(
    node: target(),
    contract: closing_contract_authoring_contract(target: "some-other-node" as NonEmptyStr),
    observations: [found_observation()],
  ) {
    ClosingContractTargetClosesItself { target: t } => (t as String) == "example-node"
    ClosingContractAuthored { target: _ } => false
    ClosingContractTargetNotDeclared { target: _ } => false
    ClosingContractTargetUnspecified { target: _ } => false
    ClosingContractTargetClosesNothing { target: _ } => false
    ClosingContractTargetOracleIncomplete { target: _, blocking: _ } => false
  }
}

test fn a_validation_whose_oracle_is_missing_refuses() -> Bool {
  match closing_contract_verdict_for_observed(
    node: target(),
    contract: authored_contract(),
    observations: [
      OracleMissing {
        oracle: resolving_oracle(),
        detail: "planted: the entry declares no such function",
      },
    ],
  ) {
    ClosingContractTargetOracleIncomplete { target: t, blocking } =>
      (t as String) == "example-node"
        && match blocking {
          OracleMissing { oracle: _, detail: _ } => true
          OracleFound { oracle: _, identity: _ } => false
          OracleAmbiguous { oracle: _, declaration_count: _ } => false
          OracleDependsOnUnpinnedOracle { oracle: _, imports: _ } => false
        }
    ClosingContractAuthored { target: _ } => false
    ClosingContractTargetNotDeclared { target: _ } => false
    ClosingContractTargetUnspecified { target: _ } => false
    ClosingContractTargetClosesNothing { target: _ } => false
    ClosingContractTargetClosesItself { target: _ } => false
  }
}

test fn a_validation_whose_oracle_is_ambiguous_refuses() -> Bool {
  match closing_contract_verdict_for_observed(
    node: target(),
    contract: authored_contract(),
    observations: [
      OracleAmbiguous { oracle: resolving_oracle(), declaration_count: 2 },
    ],
  ) {
    ClosingContractTargetOracleIncomplete { target: _, blocking: _ } => true
    ClosingContractAuthored { target: _ } => false
    ClosingContractTargetNotDeclared { target: _ } => false
    ClosingContractTargetUnspecified { target: _ } => false
    ClosingContractTargetClosesNothing { target: _ } => false
    ClosingContractTargetClosesItself { target: _ } => false
  }
}

test fn an_undeclared_target_refuses_against_the_live_authority() -> Bool {
  match closing_contract_authoring_verdict(target: "no-such-roadmap-node") {
    ClosingContractTargetNotDeclared { target: t } => t == "no-such-roadmap-node"
    ClosingContractAuthored { target: _ } => false
    ClosingContractTargetUnspecified { target: _ } => false
    ClosingContractTargetClosesNothing { target: _ } => false
    ClosingContractTargetClosesItself { target: _ } => false
    ClosingContractTargetOracleIncomplete { target: _, blocking: _ } => false
  }
}

test fn the_validation_projects_the_target_into_its_argv() -> Bool {
  match validation_operation_command(
    validation: ClosingContractAuthoringValidation {
      target: "example-node" as NonEmptyStr,
    },
    environment: DispatchHostEnvironment {
      realizations: [
        CapabilityRealization {
          capability: GunbcClaimRunnerCapability,
          executable: "/opt/gunbc/bin/gunbc" as FilePath,
          identity_args: ["--help"],
          identity_contains: "A causal compiler" as NonEmptyStr,
          ensure_policy: EnsureObserveOnly,
        },
      ],
    },
  ) {
    Present { value: command } =>
      join(command.args, " ")
        == "run --source-root dag --source-root src/v2 --entry dag/gunbc/roadmap_closing_contract_authoring.dag --function closing_contract_authored --arg target=example-node --claim-run"
    Absent => false
  }
}

test fn roadmap_closing_contract_authoring_keystone_holds() -> Bool {
  a_resolving_contract_closes_its_target()
    && an_unspecified_contract_refuses()
    && a_contract_with_no_validation_refuses_separately()
    && a_target_closed_by_another_closing_contract_task_refuses()
    && a_validation_whose_oracle_is_missing_refuses()
    && a_validation_whose_oracle_is_ambiguous_refuses()
    && an_undeclared_target_refuses_against_the_live_authority()
    && the_validation_projects_the_target_into_its_argv()
}
