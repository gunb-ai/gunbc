}

test fn inhabitance_occupy_create_failure_leaves_p() -> Bool {
  let dir = shell.Mktemp.DirWithTemplate(template: "/tmp/cred-occ.XXXXXX").path
  let snap = join([dir, "/P"], "")
  let planted = Filesystem.WriteCreateNew(path: snap, content: "secret-bytes\n")
  let locked = shell.Chmod.RecursiveReadOnly(path: dir)
  let occupied = credential_occupy_tombstone(path: snap)
  let after = Filesystem.Read(path: snap)
  let _ = shell.Chmod.RecursiveWritable(path: dir)
  planted.success && locked.success && after.success && after.content == "secret-bytes\n"
    && match occupied {
      CredentialOccupyFailed { detail: _ } => true
      CredentialOccupied => false
    }
}

test fn inhabitance_open_writes_the_observed_cgroup() -> Bool {
  match observe_producer_identity() {
    ProducerUnidentified { detail: _ } => false
    ProducerIdentified { control_group: cg, belt_unit: unit } => {
      let root = shell.Mktemp.DirWithTemplate(template: "/tmp/cred-inh.XXXXXX").path
      let record = CredentialAcquisitionRecord {
        identity: "inh",
        node_id: "node-cred-acq",
        reference: credential_acquisition_reference(identity: "inh", executor: ClaudeFromSnapshot) as String,
        executor: AttemptClaude,
        snapshot_path: join([root, "/P"], ""),
        belt_unit: unit,
        control_group: cg,
        opened_at: 1,
        launch_deadline: 10,
        state: AttemptReserved,
      }
      match fx_credentials(instance_root: root) {
  Absent => false
  Present { value: slots } =>
match credential_open(credentials: slots, record: record) {
        AttemptAdvanced { state: _, generation: _ } => {
          let slot = Filesystem.Read(path: join([fx_slots_dir(instance_root: root), "/", record.reference, ".1"], ""))
          slot.success && string_contains(s: slot.content, pattern: cg)
        }
        _ => false
      }
  }
    }
  }
}

// CURSOR RUNTIME ROOT CLEANUP TABLE (side-chat ruling): every exit that never launches a child removes the
// attempt's root with its tombstone, a launched child keeps it, and A attempt's cleanup cannot reach B's.
// Stands in for deploy: the shared parent is an instance directory the deployment ensures at 0700. A parent
// already planted by a control (EEXIST) is left exactly as planted.
// Stands in for deploy: the shared parent is an instance directory the deployment ensures at 0700. A parent
// already planted by a control (EEXIST) is left exactly as planted.
fn fx_cursor_parent(instance_root: String) -> String {
  let _ = shell.Mkdir.Parents(path: fx_slots_dir(instance_root: instance_root) as FilePath)
  match fx_credentials(instance_root: instance_root) {
    Present { value: credentials } => cursor_attempt_runtime_parent(credentials: credentials) as String
    none => join([instance_root, "/gunbc-c-roadmap2-store-unmintable"], "")
  }
}

fn fx_cursor_root(instance_root: String, reference: String) -> CursorAttemptRuntimeRoot? {
  let _ = shell.Mkdir.Parents(path: fx_slots_dir(instance_root: instance_root) as FilePath)
  match fx_credentials(instance_root: instance_root) {
    Present { value: credentials } => Present { value: cursor_attempt_runtime_root(credentials: credentials, reference: reference as NonEmptyStr) }
    none => none
  }
}

// A STABLE temporary instance root: claims that compare two spellings of the same root (HOME= and
// XDG_CONFIG_HOME= against the words of the command) must see one root, so this is a fixed path the store is
// minted over rather than a fresh mktemp per call.
fn fx_witness_stable_root(label: String) -> String {
  join(["/tmp/gunbc-c-roadmap2-cursor-", label], "")
}

fn fx_cursor_taken(instance_root: FilePath, custody_dir: String, attempt_key: String) -> TakenCredentialSnapshot? {
  let _ = shell.Mkdir.NewOwnerOnly(path: fx_cursor_parent(instance_root: instance_root as String) as FilePath)
  fx_cursor_attempted(instance_root: instance_root, custody_dir: custody_dir, attempt_key: attempt_key)
}

fn fx_cursor_attempted(instance_root: FilePath, custody_dir: String, attempt_key: String) -> TakenCredentialSnapshot? {
  let attempt = fx_temp_attempt(instance_root: instance_root, attempt_key: attempt_key, node_id: "node-cursor-root")
  match credential_register_then_take(attempt: attempt, executor: CursorFromSnapshot, custody: fx_planted_custody(dir: custody_dir)) {
    DispatchSnapshotRefused { reason: _ } => none
    DispatchSnapshotTaken { snapshot } => Present { value: snapshot }
  }
}

// The runtime root's PATH for an instance and attempt key, taken through the one witness route (fx_cursor_root).
// An unmintable store yields a name no fold will ever accept -- not a different root's real path -- so every
// claim below that compares against it reads false rather than reading a success from the wrong directory.
fn fx_root(instance_root: FilePath, attempt_key: String) -> String {
  match fx_cursor_root(instance_root: (instance_root as String) as String, reference: credential_acquisition_reference(identity: attempt_key, executor: CursorFromSnapshot) as String) {
    Present { value: root } => root.base
    none => join([instance_root as String, "/gunbc-c-roadmap2-credential-store-unmintable"], "")
  }
}

// THE MODE ROW IS READ, AND THE PROOF IS THE MODE THE CREATED DIRECTORY ACTUALLY CARRIES. The create
// (gunbc.dispatch_credential_acquisition credential_create_cursor_runtime_root) asks mkdir for the octal of
// cursor_attempt_runtime_slots.mode rather than spelling an arm, and the demanded-directory target
// (cursor_attempt_runtime_directory) reads the same row; this claim mints a Cursor attempt the production
// way and reads the created root's mode back through stat. Change the row and both this claim and the
// directory target move together -- that is the "changing the mode changes both" leg of the declaration
// control, and it is why the row carries a mode at all instead of every caller re-deciding one.
test fn the_runtime_root_is_created_at_the_mode_the_declaration_carries() -> Bool {
  let instance_root = shell.Mktemp.DirWithTemplate(template: "/tmp/cur-mode.XXXXXX").path
  let custody_dir = shell.Mktemp.DirWithTemplate(template: "/tmp/cur-mode-custody.XXXXXX").path
  match fx_cursor_taken(instance_root: instance_root, custody_dir: custody_dir as String, attempt_key: "curmodeA00000001") {
    Absent => false
    Present { value: _ } =>
      match coreutils_stat_path_mode(path: fx_root(instance_root: instance_root, attempt_key: "curmodeA00000001") as NonEmptyStr) {
        PathModeObserved { path: _, mode } => file_mode_octal(mode: mode) == declared_directory_mode_octal(m: cursor_attempt_runtime_slots.mode)
        PathModeUnobservable { path: _, reason: _ } => false
      }
  }
}

fn fx_marker(instance_root: FilePath, attempt_key: String) -> String {
  join([fx_root(instance_root: instance_root, attempt_key: attempt_key), "/home/marker"], "")
}

fn fx_marker_present(instance_root: FilePath, attempt_key: String) -> Bool {
  Filesystem.Read(path: fx_marker(instance_root: instance_root, attempt_key: attempt_key)).success
}

// The attempt's record and the store it was read from: the seal and observation controls act through that
// store, so the runtime root they judge is the one its mint derived from the same instance.
type FxSlot { credentials: CredentialAcquisitionStore, record: CredentialAcquisitionRecord }

fn fx_slot(instance_root: FilePath, attempt_key: String) -> FxSlot? {
  match fx_credentials(instance_root: instance_root as String) {
    Absent => none
    Present { value: credentials } =>
      match credential_slot_record(credentials: credentials, reference: credential_acquisition_reference(identity: attempt_key, executor: CursorFromSnapshot)) {
        Absent => none
        Present { value: record } => Present { value: FxSlot { credentials: credentials, record: record } }
      }
  }
}

// A seal through a store minted over an isolated directory, for the controls whose record registers no root.
fn fx_seal_in_fresh_store(record: CredentialAcquisitionRecord, drain: RecordedCgroupDrain) -> CredentialSealReceipt {
  match fx_credentials(instance_root: shell.Mktemp.DirWithTemplate(template: "/tmp/cred-seal.XXXXXX").path as String) {
    Absent => CredentialSealFailed { detail: "fixture: the credential store could not be minted" }
    Present { value: credentials } => credential_seal_after_terminate(record: record, drain: drain, credentials: credentials)
  }
}

test fn inhabitance_claude_attempt_has_no_runtime_root() -> Bool {
  match credential_attempt_executor_for(executor: ClaudeFromSnapshot) {
    AttemptClaude => true
    AttemptCursor { runtime_root: _ } => false
  }
}

test fn inhabitance_lost_launch_removes_cursor_root_and_spares_another_attempts() -> Bool {
  let instance_root = shell.Mktemp.DirWithTemplate(template: "/tmp/cur-lost.XXXXXX").path
  let custody_dir = shell.Mktemp.DirWithTemplate(template: "/tmp/cur-lost-custody.XXXXXX").path
  let _ = shell.Mkdir.Parents(path: fx_slots_dir(instance_root: instance_root as String) as FilePath)
  match fx_credentials(instance_root: instance_root as String) {
    Absent => false
    Present { value: slots } => {
  match fx_cursor_taken(instance_root: instance_root, custody_dir: custody_dir as String, attempt_key: "curlostA0000001") {
    Absent => false
    Present { value: a } =>
      match fx_cursor_taken(instance_root: instance_root, custody_dir: custody_dir as String, attempt_key: "curlostB0000001") {
        Absent => false
        Present { value: _ } => {
          let _ = Filesystem.Write(path: fx_marker(instance_root: instance_root, attempt_key: "curlostA0000001"), content: "x")
          let _ = Filesystem.Write(path: fx_marker(instance_root: instance_root, attempt_key: "curlostB0000001"), content: "x")
          let reference = credential_acquisition_reference(identity: "curlostA0000001", executor: CursorFromSnapshot)
          match credential_terminate(credentials: slots, reference: reference, expected: cas_generation_first(), verdict: AttemptRecovered, detail: "fixture", reader: reader_ended()) {
            AttemptAdvanced { state: _, generation: _ } =>
              match credential_begin_launch_or_discard(credentials: slots, reference: reference, expected: cas_generation_first(), snapshot: a) {
                LaunchLostSnapshotDiscarded =>
                  credential_snapshot_is_tombstone(text: Filesystem.Read(path: taken_credential_snapshot_path(snapshot: a) as String).content)
                    && !fx_marker_present(instance_root: instance_root, attempt_key: "curlostA0000001")
                    && fx_marker_present(instance_root: instance_root, attempt_key: "curlostB0000001")
                LaunchLostDiscardFailed { reason: _ } => false
                CredentialLaunchAdmitted => false
              }
            _ => false
          }
        }
      }
  }
    }
  }
}

test fn inhabitance_admitted_launch_preserves_the_root_until_a3_seals() -> Bool {
  let instance_root = shell.Mktemp.DirWithTemplate(template: "/tmp/cur-live.XXXXXX").path
  let custody_dir = shell.Mktemp.DirWithTemplate(template: "/tmp/cur-live-custody.XXXXXX").path
  let _ = shell.Mkdir.Parents(path: fx_slots_dir(instance_root: instance_root as String) as FilePath)
  match fx_cursor_taken(instance_root: instance_root, custody_dir: custody_dir as String, attempt_key: "curlive00000001") {
    Absent => false
    Present { value: snapshot } => {
      let _ = Filesystem.Write(path: fx_marker(instance_root: instance_root, attempt_key: "curlive00000001"), content: "x")
      match credential_admit_reader_or_discard(snapshot: snapshot) {
        CredentialLaunchAdmitted => fx_marker_present(instance_root: instance_root, attempt_key: "curlive00000001")
        LaunchLostSnapshotDiscarded => false
        LaunchLostDiscardFailed { reason: _ } => false
      }
    }
  }
}

// FULL PATH of the side-chat ruling: a pre-existing root (and an owner-marker-shaped directory planted in
// it) is refused at creation, and A3 recovery past the deadline with the producer drained leaves BOTH in
// place, because losing create-only means this attempt never owned the root.
test fn inhabitance_a_pre_existing_cursor_root_is_refused_and_a3_never_removes_it() -> Bool {
  let instance_root = shell.Mktemp.DirWithTemplate(template: "/tmp/cur-pre.XXXXXX").path
  let custody_dir = shell.Mktemp.DirWithTemplate(template: "/tmp/cur-pre-custody.XXXXXX").path
  let _ = shell.Mkdir.Parents(path: fx_slots_dir(instance_root: instance_root as String) as FilePath)
  match fx_credentials(instance_root: instance_root as String) {
    Absent => false
    Present { value: slots } => {
  let key = "curpre000000001"
  let planted = fx_marker(instance_root: instance_root, attempt_key: key)
  let _ = shell.Mkdir.Parents(path: belt_path_parent_dir(path: planted) as FilePath)
  let _ = Filesystem.Write(path: planted, content: "x")
  let owner_shaped = join([fx_root(instance_root: instance_root, attempt_key: key), "/owner-", credential_acquisition_reference(identity: key, executor: CursorFromSnapshot) as String, "-1"], "")
  let _ = shell.Mkdir.Parents(path: owner_shaped as FilePath)
  let _ = shell.Chmod.OwnerOnlyDirectory(path: fx_root(instance_root: instance_root, attempt_key: key) as FilePath)
  let _ = shell.Chmod.OwnerOnlyDirectory(path: fx_cursor_parent(instance_root: (instance_root as String) as String) as FilePath)
  match fx_cursor_taken(instance_root: instance_root, custody_dir: custody_dir as String, attempt_key: key) {
    Present { value: _ } => false
    Absent =>
      match fx_slot(instance_root: instance_root, attempt_key: key) {
        Absent => false
        Present { value: slot } => {
          let rec = slot.record
          let sealed = credential_seal_after_terminate(record: rec, drain: drain_ended(path: RecordedPathEmpty), credentials: slot.credentials)
          let survives_immediate = fx_marker_present(instance_root: instance_root, attempt_key: key)
            && !shell.Mkdir.NewOwnerOnly(path: owner_shaped as FilePath).success
            && match sealed {
              CredentialSealed { path: _ } => true
              _ => false
            }
          // The real recovery route, one second past the record's own launch deadline, with the reader ended. The
          // record names this process's own (live) cgroup, so the first sweep terminates the slot and defers the
          // seal as owed; the repeat sweep reads the terminal slot and decides the root: NotOwned, never removed.
          let recovered = credential_recover_slot(credentials: slots, reference: rec.reference as NonEmptyStr, now: rec.launch_deadline + 1, reader: reader_ended())
          let repeated = credential_recover_slot(credentials: slots, reference: rec.reference as NonEmptyStr, now: rec.launch_deadline + 1, reader: reader_ended())
          survives_immediate
            && fx_marker_present(instance_root: instance_root, attempt_key: key)
            && !shell.Mkdir.NewOwnerOnly(path: owner_shaped as FilePath).success
            && match observe_cursor_runtime_root_fact(record: rec, credentials: slot.credentials) {
              CursorRuntimeRootNotOwned { detail: _ } => true
              _ => false
            }
            && match recovered {
              CredentialSlotKept { text: t } => string_contains(s: t, pattern: join(["owed ", rec.reference, ": "], ""))
              CredentialSlotClosed { text: _ } => false
              CredentialSlotFailed { text: _ } => false
            }
            && match repeated {
              CredentialSlotKept { text: t } => string_contains(s: t, pattern: ": sealed")
              CredentialSlotClosed { text: _ } => false
              CredentialSlotFailed { text: _ } => false
            }
        }
      }
  }
    }
  }
}

// An owned root is removed by A3 once, and the repeat sweep reads it Absent: a real no-op, not a second rm.
test fn inhabitance_a3_removes_an_owned_root_and_the_repeat_is_a_no_op() -> Bool {
  let instance_root = shell.Mktemp.DirWithTemplate(template: "/tmp/cur-own.XXXXXX").path
  let custody_dir = shell.Mktemp.DirWithTemplate(template: "/tmp/cur-own-custody.XXXXXX").path
  let _ = shell.Mkdir.Parents(path: fx_slots_dir(instance_root: instance_root as String) as FilePath)
  let key = "curown000000001"
  match fx_cursor_taken(instance_root: instance_root, custody_dir: custody_dir as String, attempt_key: key) {
    Absent => false
    Present { value: snapshot } =>
      match fx_slot(instance_root: instance_root, attempt_key: key) {
        Absent => false
        Present { value: slot } => {
          let rec = slot.record
          let owned_before = match observe_cursor_runtime_root_fact(record: rec, credentials: slot.credentials) {
            CursorRuntimeRootOwned => true
            _ => false
          }
          let first = credential_seal_after_terminate(record: rec, drain: drain_ended(path: RecordedPathEmpty), credentials: slot.credentials)
          let second = credential_seal_after_terminate(record: rec, drain: drain_ended(path: RecordedPathEmpty), credentials: slot.credentials)
          owned_before
            && !Filesystem.Read(path: fx_root(instance_root: instance_root, attempt_key: key)).success
            && credential_snapshot_is_tombstone(text: Filesystem.Read(path: taken_credential_snapshot_path(snapshot: snapshot) as String).content)
            && match first { CredentialSealed { path: _ } => true  _ => false }
            && match second { CredentialSealed { path: _ } => true  _ => false }
        }
      }
  }
}

// A symlink at the shared parent is refused at creation and recovery, and the link's target survives.
test fn inhabitance_a_symlinked_runtime_parent_is_refused_and_its_target_survives() -> Bool {
  let instance_root = shell.Mktemp.DirWithTemplate(template: "/tmp/cur-link.XXXXXX").path
  let foreign = shell.Mktemp.DirWithTemplate(template: "/tmp/cur-link-foreign.XXXXXX").path
  let custody_dir = shell.Mktemp.DirWithTemplate(template: "/tmp/cur-link-custody.XXXXXX").path
  let _ = shell.Mkdir.Parents(path: fx_slots_dir(instance_root: instance_root as String) as FilePath)
  let key = "curlink00000001"
  let reference = credential_acquisition_reference(identity: key, executor: CursorFromSnapshot) as String
  let victim = join([foreign, "/", reference, "/keep"], "")
  let _ = shell.Mkdir.Parents(path: belt_path_parent_dir(path: victim) as FilePath)
  let _ = Filesystem.Write(path: victim, content: "foreign")
  let linked = shell.Exec.RunArgv(program: "/bin/ln", arguments: ["-sfnT", "--", foreign, fx_cursor_parent(instance_root: (instance_root as String) as String)])
  match fx_cursor_taken(instance_root: instance_root, custody_dir: custody_dir as String, attempt_key: key) {
    Present { value: _ } => false
    Absent =>
      match fx_slot(instance_root: instance_root, attempt_key: key) {
        Absent => false
        Present { value: slot } => {
          let rec = slot.record
          let sealed = credential_seal_after_terminate(record: rec, drain: drain_ended(path: RecordedPathEmpty), credentials: slot.credentials)
          linked.exit_code == 0
            && Filesystem.Read(path: victim).content == "foreign"
            && match sealed {
              CredentialSealed { path: _ } => false
              _ => true
            }
        }
      }
  }
}

// Needs a non-root uid: a root runner ignores the read-only mode, so BuildBuddy reads this FAIL; run it on a non-root host.
// A root that cannot be removed must not keep the plaintext snapshot alive: the snapshot is tombstoned and
// only the root is reported owed.
test fn inhabitance_a_failed_root_removal_still_tombstones_the_snapshot() -> Bool {
  let instance_root = shell.Mktemp.DirWithTemplate(template: "/tmp/cur-fail.XXXXXX").path
  let custody_dir = shell.Mktemp.DirWithTemplate(template: "/tmp/cur-fail-custody.XXXXXX").path
  let _ = shell.Mkdir.Parents(path: fx_slots_dir(instance_root: instance_root as String) as FilePath)
  let key = "curfail00000001"
  match fx_cursor_taken(instance_root: instance_root, custody_dir: custody_dir as String, attempt_key: key) {
    Absent => false
    Present { value: snapshot } =>
      match fx_slot(instance_root: instance_root, attempt_key: key) {
        Absent => false
        Present { value: slot } => {
          let rec = slot.record
          let home = join([fx_root(instance_root: instance_root, attempt_key: key), "/home"], "")
          let _ = Filesystem.Write(path: fx_marker(instance_root: instance_root, attempt_key: key), content: "x")
          let locked = shell.Chmod.RecursiveReadOnly(path: home)
          let sealed = credential_seal_after_terminate(record: rec, drain: drain_ended(path: RecordedPathEmpty), credentials: slot.credentials)
          let _ = shell.Chmod.RecursiveWritable(path: home)
          locked.success
            && credential_snapshot_is_tombstone(text: Filesystem.Read(path: taken_credential_snapshot_path(snapshot: snapshot) as String).content)
            && match sealed {
              CredentialCleanupOwed { reason: r } => string_contains(s: r, pattern: "could not be removed")
              _ => false
            }
        }
      }
  }
}

// Needs a non-root uid (a root runner ignores both modes): run it on a non-root host.
// The snapshot and the root are independent releases: when BOTH fail, the seal keeps both causes.
test fn inhabitance_a_snapshot_failure_and_a_root_failure_keep_both_causes() -> Bool {
  let instance_root = shell.Mktemp.DirWithTemplate(template: "/tmp/cur-both.XXXXXX").path
  let custody_dir = shell.Mktemp.DirWithTemplate(template: "/tmp/cur-both-custody.XXXXXX").path
  let _ = shell.Mkdir.Parents(path: fx_slots_dir(instance_root: instance_root as String) as FilePath)
  let key = "curboth00000001"
  match fx_cursor_taken(instance_root: instance_root, custody_dir: custody_dir as String, attempt_key: key) {
    Absent => false
    Present { value: snapshot } =>
      match fx_slot(instance_root: instance_root, attempt_key: key) {
        Absent => false
        Present { value: slot } => {
          let rec = slot.record
          let _ = Filesystem.Write(path: taken_credential_snapshot_path(snapshot: snapshot) as String, content: "plaintext")
          let snapshot_locked = shell.Exec.RunArgv(program: "/bin/chmod", arguments: ["0500", instance_root])
          let home = join([fx_root(instance_root: instance_root, attempt_key: key), "/home"], "")
          let _ = Filesystem.Write(path: fx_marker(instance_root: instance_root, attempt_key: key), content: "x")
          let root_locked = shell.Chmod.RecursiveReadOnly(path: home)
          let sealed = credential_seal_after_terminate(record: rec, drain: drain_ended(path: RecordedPathEmpty), credentials: slot.credentials)
          let _ = shell.Chmod.RecursiveWritable(path: home)
          let _ = shell.Chmod.OwnerOnlyDirectory(path: instance_root as FilePath)
          snapshot_locked.exit_code == 0
            && root_locked.success
            && match sealed {
              CredentialSealFailed { detail: d } =>
                string_contains(s: d, pattern: "mktemp in the snapshot directory failed")
                  && string_contains(s: d, pattern: "could not be removed")
              _ => false
            }
        }
      }
  }
}

// Needs a non-root uid. A removal that fails partway must leave the owner marker: the root still reads
// Owned and stays owed, and the retry converges to Absent.
test fn inhabitance_a_partially_failed_removal_keeps_the_root_owned_and_owed() -> Bool {
  let instance_root = shell.Mktemp.DirWithTemplate(template: "/tmp/cur-part.XXXXXX").path
  let custody_dir = shell.Mktemp.DirWithTemplate(template: "/tmp/cur-part-custody.XXXXXX").path
  let _ = shell.Mkdir.Parents(path: fx_slots_dir(instance_root: instance_root as String) as FilePath)
  let key = "curpart00000001"
  match fx_cursor_taken(instance_root: instance_root, custody_dir: custody_dir as String, attempt_key: key) {
    Absent => false
    Present { value: _ } =>
      match fx_slot(instance_root: instance_root, attempt_key: key) {
        Absent => false
        Present { value: slot } => {
          let rec = slot.record
          let home = join([fx_root(instance_root: instance_root, attempt_key: key), "/home"], "")
          let _ = Filesystem.Write(path: fx_marker(instance_root: instance_root, attempt_key: key), content: "x")
          let locked = shell.Chmod.RecursiveReadOnly(path: home)
          let first = credential_seal_after_terminate(record: rec, drain: drain_ended(path: RecordedPathEmpty), credentials: slot.credentials)
          let _ = shell.Chmod.RecursiveWritable(path: home)
          let after = observe_cursor_runtime_root_fact(record: rec, credentials: slot.credentials)
          let second = credential_seal_after_terminate(record: rec, drain: drain_ended(path: RecordedPathEmpty), credentials: slot.credentials)
          let converged = observe_cursor_runtime_root_fact(record: rec, credentials: slot.credentials)
          locked.success
            && match first {
              CredentialCleanupOwed { reason: r } => string_contains(s: r, pattern: "could not be removed")
              _ => false
            }
            && match after {
              CursorRuntimeRootOwned => true
              _ => false
            }
            && match second {
              CredentialSealed { path: _ } => true
              _ => false
            }
            && match converged {
              CursorRuntimeRootAbsent => true
              _ => false
            }
        }
      }
  }
}

// The fd-relative program opens the BASE no-follow too: a symlink standing where the attempt's base should
// be (the parent is a real directory) is refused and its target, marker included, survives.
test fn inhabitance_a_symlinked_base_is_refused_and_its_target_survives() -> Bool {
  let instance_root = shell.Mktemp.DirWithTemplate(template: "/tmp/cur-blink.XXXXXX").path
  let foreign = shell.Mktemp.DirWithTemplate(template: "/tmp/cur-blink-foreign.XXXXXX").path
  let custody_dir = shell.Mktemp.DirWithTemplate(template: "/tmp/cur-blink-custody.XXXXXX").path
  let _ = shell.Mkdir.Parents(path: fx_slots_dir(instance_root: instance_root as String) as FilePath)
  let key = "curblink0000001"
  let _ = shell.Mkdir.Parents(path: fx_cursor_parent(instance_root: instance_root as String) as FilePath)
  let victim = join([foreign, "/keep"], "")
  let _ = Filesystem.Write(path: victim, content: "foreign")
  let linked = shell.Exec.RunArgv(program: "/bin/ln", arguments: ["-sfnT", "--", foreign, fx_root(instance_root: instance_root, attempt_key: key)])
  match fx_cursor_taken(instance_root: instance_root, custody_dir: custody_dir as String, attempt_key: key) {
    Present { value: _ } => false
    Absent =>
      match fx_slot(instance_root: instance_root, attempt_key: key) {
        Absent => false
        Present { value: slot } => {
          let rec = slot.record
          let sealed = credential_seal_after_terminate(record: rec, drain: drain_ended(path: RecordedPathEmpty), credentials: slot.credentials)
          linked.exit_code == 0
            && Filesystem.Read(path: victim).content == "foreign"
            && match observe_cursor_runtime_root_fact(record: rec, credentials: slot.credentials) {
              CursorRuntimeRootAncestryRefused { detail: _ } => true
              _ => false
            }
            && match sealed {
              CredentialSealed { path: _ } => false
              _ => true
            }
        }
      }
  }
}

// A symlink planted INSIDE the owned base is unlinked, never followed: the directory it points at keeps its file.
test fn inhabitance_removal_unlinks_a_planted_inner_symlink_without_following_it() -> Bool {
  let instance_root = shell.Mktemp.DirWithTemplate(template: "/tmp/cur-inner.XXXXXX").path
  let foreign = shell.Mktemp.DirWithTemplate(template: "/tmp/cur-inner-foreign.XXXXXX").path
  let custody_dir = shell.Mktemp.DirWithTemplate(template: "/tmp/cur-inner-custody.XXXXXX").path
  let _ = shell.Mkdir.Parents(path: fx_slots_dir(instance_root: instance_root as String) as FilePath)
  let key = "curinner0000001"
  let victim = join([foreign, "/keep"], "")
  let _ = Filesystem.Write(path: victim, content: "foreign")
  match fx_cursor_taken(instance_root: instance_root, custody_dir: custody_dir as String, attempt_key: key) {
    Absent => false
    Present { value: _ } =>
      match fx_slot(instance_root: instance_root, attempt_key: key) {
        Absent => false
        Present { value: slot } => {
          let rec = slot.record
          let linked = shell.Exec.RunArgv(program: "/bin/ln", arguments: ["-sfnT", "--", foreign, join([fx_root(instance_root: instance_root, attempt_key: key), "/home/escape"], "")])
          let sealed = credential_seal_after_terminate(record: rec, drain: drain_ended(path: RecordedPathEmpty), credentials: slot.credentials)
          linked.exit_code == 0
            && Filesystem.Read(path: victim).content == "foreign"
            && !Filesystem.Read(path: fx_marker(instance_root: instance_root, attempt_key: key)).success
            && match sealed {
              CredentialSealed { path: _ } => true
              _ => false
            }
        }
      }
  }
}

// Needs a non-root uid (a root runner reads any mode). A 0000 instance root fails the FIRST listing
// (the parent entry), the one reachable Unreadable arm: owed, never sealed, the base survives. The tombstone
// is owned by inhabitance_a_failed_root_removal_still_tombstones_the_snapshot (P lives under this root).
// The parent-listing and marker-listing Unreadable arms are I/O-grade only: the level rule is an allowlist of
// modes, none of which makes a directory unlistable to its owner, so they have no non-root fixture and
// claim no control.
test fn inhabitance_an_unlistable_instance_root_is_owed_never_sealed() -> Bool {
  let instance_root = shell.Mktemp.DirWithTemplate(template: "/tmp/cur-unlp.XXXXXX").path
  let custody_dir = shell.Mktemp.DirWithTemplate(template: "/tmp/cur-unlp-custody.XXXXXX").path
  let _ = shell.Mkdir.Parents(path: fx_slots_dir(instance_root: instance_root as String) as FilePath)
  let key = "curunlp00000001"
  match fx_cursor_taken(instance_root: instance_root, custody_dir: custody_dir as String, attempt_key: key) {
    Absent => false
    Present { value: _ } =>
      match fx_slot(instance_root: instance_root, attempt_key: key) {
        Absent => false
        Present { value: slot } => {
          let rec = slot.record
          let target = instance_root as String
          let closed = shell.Exec.RunArgv(program: "/bin/chmod", arguments: ["000", target])
          let fact = observe_cursor_runtime_root_fact(record: rec, credentials: slot.credentials)
          let sealed = credential_seal_after_terminate(record: rec, drain: drain_ended(path: RecordedPathEmpty), credentials: slot.credentials)
          let _ = shell.Exec.RunArgv(program: "/bin/chmod", arguments: ["700", target])
          let base_was_absent = shell.Mkdir.NewOwnerOnly(path: fx_root(instance_root: instance_root, attempt_key: key) as FilePath).success
          closed.exit_code == 0
            && !base_was_absent
            && match fact {
              CursorRuntimeRootUnreadable { detail: _ } => true
              _ => false
            }
            && match sealed {
              CredentialSealed { path: _ } => false
              _ => true
            }
        }
      }
  }
}

// Needs a non-root uid. A base at mode 0000 is positively observed as not an owner-only 0700 directory: the ancestry-refused arm, owed, never sealed, the base survives and the snapshot is tombstoned.
test fn inhabitance_a_base_that_is_not_owner_only_is_refused_and_owed() -> Bool {
  let instance_root = shell.Mktemp.DirWithTemplate(template: "/tmp/cur-nobo.XXXXXX").path
  let custody_dir = shell.Mktemp.DirWithTemplate(template: "/tmp/cur-nobo-custody.XXXXXX").path
  let _ = shell.Mkdir.Parents(path: fx_slots_dir(instance_root: instance_root as String) as FilePath)
  let key = "curnobo00000001"
  match fx_cursor_taken(instance_root: instance_root, custody_dir: custody_dir as String, attempt_key: key) {
    Absent => false
    Present { value: snapshot } =>
      match fx_slot(instance_root: instance_root, attempt_key: key) {
        Absent => false
        Present { value: slot } => {
          let rec = slot.record
          let target = fx_root(instance_root: instance_root, attempt_key: key)
          let closed = shell.Exec.RunArgv(program: "/bin/chmod", arguments: ["000", target])
          let fact = observe_cursor_runtime_root_fact(record: rec, credentials: slot.credentials)
          let sealed = credential_seal_after_terminate(record: rec, drain: drain_ended(path: RecordedPathEmpty), credentials: slot.credentials)
          let _ = shell.Exec.RunArgv(program: "/bin/chmod", arguments: ["700", target])
          let base_was_absent = shell.Mkdir.NewOwnerOnly(path: fx_root(instance_root: instance_root, attempt_key: key) as FilePath).success
          closed.exit_code == 0
            && !base_was_absent
            && credential_snapshot_is_tombstone(text: Filesystem.Read(path: taken_credential_snapshot_path(snapshot: snapshot) as String).content)
            && match fact {
              CursorRuntimeRootAncestryRefused { detail: _ } => true
              _ => false
            }
            && match sealed {
              CredentialSealed { path: _ } => false
              _ => true
            }
        }
      }
  }
}

// A pre-existing group/other-writable shared parent is refused by the level rule, never adopted or chmodded
// (the umask of the caller must not decide this: creation uses an explicit mode).
test fn inhabitance_a_pre_existing_writable_parent_is_refused_not_repaired() -> Bool {
  let instance_root = shell.Mktemp.DirWithTemplate(template: "/tmp/cur-wpar.XXXXXX").path
  let custody_dir = shell.Mktemp.DirWithTemplate(template: "/tmp/cur-wpar-custody.XXXXXX").path
  let _ = shell.Mkdir.Parents(path: fx_slots_dir(instance_root: instance_root as String) as FilePath)
  let parent = fx_cursor_parent(instance_root: instance_root as String)
  let _ = shell.Mkdir.Parents(path: parent as FilePath)
  let _ = shell.Chmod.WorldWritableDirectory(path: parent as FilePath)
  match fx_cursor_taken(instance_root: instance_root, custody_dir: custody_dir as String, attempt_key: "curwpar00000001") {
    Present { value: _ } => false
    Absent => !Filesystem.Read(path: fx_marker(instance_root: instance_root, attempt_key: "curwpar00000001")).success
  }
}

// The parent is deployment's, never the attempt's: an absent parent is refused and nothing is created.
test fn inhabitance_an_absent_runtime_parent_is_refused_and_nothing_is_created() -> Bool {
  let instance_root = shell.Mktemp.DirWithTemplate(template: "/tmp/cur-nopar.XXXXXX").path
  let custody_dir = shell.Mktemp.DirWithTemplate(template: "/tmp/cur-nopar-custody.XXXXXX").path
  let _ = shell.Mkdir.Parents(path: fx_slots_dir(instance_root: instance_root as String) as FilePath)
  match fx_cursor_attempted(instance_root: instance_root, custody_dir: custody_dir as String, attempt_key: "curnopar0000001") {
    Present { value: _ } => false
    Absent => shell.Mkdir.NewOwnerOnly(path: fx_cursor_parent(instance_root: instance_root as String) as FilePath).success
  }
}

// An unsafe (world-writable, not sticky) instance root is refused before the base is created under it. The
// parent is planted first (deploy's), so only the instance-root level of the ancestry can refuse.
test fn inhabitance_an_unsafe_instance_root_is_refused_with_nothing_created_under_it() -> Bool {
  let instance_root = shell.Mktemp.DirWithTemplate(template: "/tmp/cur-unsafe.XXXXXX").path
  let custody_dir = shell.Mktemp.DirWithTemplate(template: "/tmp/cur-unsafe-custody.XXXXXX").path
  let _ = shell.Mkdir.Parents(path: fx_slots_dir(instance_root: instance_root as String) as FilePath)
  let planted = shell.Mkdir.NewOwnerOnly(path: fx_cursor_parent(instance_root: instance_root as String) as FilePath)
  let opened = shell.Chmod.WorldWritableDirectory(path: instance_root as FilePath)
  let key = "curunsafe000001"
  let attempted = fx_cursor_attempted(instance_root: instance_root, custody_dir: custody_dir as String, attempt_key: key)
  let base_absent = shell.Mkdir.NewOwnerOnly(path: fx_root(instance_root: instance_root, attempt_key: key) as FilePath).success
  planted.success && opened.success && base_absent
    && match attempted {
      Present { value: _ } => false
      Absent => true
    }
}

// THE ROWS THAT NEED A USER SYSTEMD MANAGER, run on a host that has one: gunbc test
// //gunbc/instruments:credential-acquisition-systemd-rows (gunbc.instrument_targets), dispatched to the fleet's
// self-hosted runners through instrument-dispatch.yml. These rows start real transient units through
// `systemd-run --user` and so cannot run where there is no user manager (a session container, BuildBuddy). The
// manager is PROBED first by executing systemd-run itself: a refusal answers no observation (exit 2) with the
// probe's own output, and no row runs. A row that fails answers exit 1. The roster names exactly the rows whose
// evaluation spawns systemd-run; a new such row joins it here (a row missing from it would still run under
// --claim-run, so omission costs coverage on the systemd host, never a false green).
type SystemdRow { name: String, held: Bool }

fn systemd_user_manager_probe() -> String {
  let probe = shell.Exec.RunArgv(
    program: "/usr/bin/systemd-run",
    arguments: ["--user", "--wait", "--collect", "--quiet", "-p", "Delegate=yes", "/bin/true"],
  )
  if probe.exit_code == 0 {
    ""
  } else {
    join(["systemd-run --user --wait refused (exit ", to_string(value: probe.exit_code), "): ", trim(s: probe.stdout), " ", trim(s: probe.stderr)], "")
  }
}

fn credential_acquisition_systemd_rows_wire() -> CliWireResponse {
  let refusal = systemd_user_manager_probe()
  if refusal != "" {
    CliWirePrintable { bytes: join(["credential-acquisition-systemd-rows: no observation: ", refusal], ""), exit: ExitFailure { code: 2, reason: "the user systemd manager refused a probe unit" } }
  } else {
    let rows = [
    SystemdRow { name: "row_3a_sigstop_own_scope_preserves", held: row_3a_sigstop_own_scope_preserves() },
    SystemdRow { name: "row_d_sigkill_inside_window_preserves_reserved", held: row_d_sigkill_inside_window_preserves_reserved() },
    SystemdRow { name: "row_r_launching_drained_scope_may_close", held: row_r_launching_drained_scope_may_close() },
    SystemdRow { name: "row_l_live_scope_populated_preserves", held: row_l_live_scope_populated_preserves() },
    SystemdRow { name: "row_m_drained_producer_live_reader_preserves", held: row_m_drained_producer_live_reader_preserves() },
    SystemdRow { name: "row_m_reaped_pane_exit_record_seals", held: row_m_reaped_pane_exit_record_seals() },
    SystemdRow { name: "row_m_teardown_writes_exit_record_then_recovery_seals", held: row_m_teardown_writes_exit_record_then_recovery_seals() },
    SystemdRow { name: "row_m_teardown_refuses_when_exit_record_write_fails", held: row_m_teardown_refuses_when_exit_record_write_fails() },
    SystemdRow { name: "row_m_teardown_normal_exit_writes_status_then_recovery_seals", held: row_m_teardown_normal_exit_writes_status_then_recovery_seals() },
    SystemdRow { name: "row_p_populated_preserves", held: row_p_populated_preserves() },
    SystemdRow { name: "row_p_prime_empty_after_stop_may_seal", held: row_p_prime_empty_after_stop_may_seal() },
    SystemdRow { name: "row_p_triple_child_cgroup_leftover_preserves", held: row_p_triple_child_cgroup_leftover_preserves() },
    SystemdRow { name: "row_pf_fork_after_second_scope_preserves", held: row_pf_fork_after_second_scope_preserves() },
    SystemdRow { name: "row_o_terminal_owed_retries_until_drained", held: row_o_terminal_owed_retries_until_drained() },
    ]
    let report = join(map(rows, r => join([if r.held { "PASS " } else { "FAIL " }, r.name], "")), "\n")
    let failed = fold(rows, init: 0, f: (acc, r) => if r.held { acc } else { acc + 1 })
    if failed == 0 {
      CliWirePrintable { bytes: join([report, "\ncredential-acquisition-systemd-rows: ", to_string(value: rows.length()), "/", to_string(value: rows.length()), " held"], ""), exit: ExitSuccess }
    } else {
      CliWirePrintable { bytes: join([report, "\ncredential-acquisition-systemd-rows: ", to_string(value: failed), " of ", to_string(value: rows.length()), " did not hold"], ""), exit: ExitFailure { code: 1, reason: "a systemd credential row did not hold" } }
    }
  }
}
