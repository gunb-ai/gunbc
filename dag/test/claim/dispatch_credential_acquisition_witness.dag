fn rec(state: AttemptState, deadline: EpochSecs, snapshot_path: String, control_group: String) -> CredentialAcquisitionRecord {
  CredentialAcquisitionRecord {
    identity: "id1",
    reference: credential_acquisition_reference(identity: "id1", executor: ClaudeFromSnapshot) as String,
    executor_word: "claude",
    snapshot_path: snapshot_path,
    belt_unit: "gunbc-roadmap-belt.service",
    control_group: control_group,
    opened_at: 10,
    launch_deadline: deadline,
    state: state,
  }
}

fn drain_ended(path: RecordedCgroupPathStanding) -> RecordedCgroupDrain {
  recorded_cgroup_drain(path: path)
}

fn credential_open_was_refused(t: AttemptTransition) -> Bool {
  match t {
    AttemptTransitionRefused { detail: d } =>
      string_contains(s: d, pattern: "the attempt declared a launch deadline")
    AttemptLostRace { expected: _, observed: _ } => false
    AttemptAdvanced { state: _, generation: _ } => false
  }
}

fn unique_token() -> String {
  fold(
    split(
      s: trim(s: shell.Exec.RunArgv(
        program: "/usr/bin/basename",
        arguments: [shell.Mktemp.DirWithTemplate(template: "/tmp/credtokXXXXXX").path as String],
      ).stdout),
      delimiter: ".",
    ),
    init: "",
    f: (acc, part) => part,
  )
}

fn wet_service_unit(prefix: String) -> String {
  join([prefix, "-", unique_token()], "")
}

fn systemd_run_user_service(unit: String) -> Int {
  systemd_run_user_argv(
    unit: unit,
    properties: ["-p", "Delegate=yes"],
    program: "/bin/sleep",
    arguments: ["90"],
  )
}

fn systemd_run_user_argv(unit: String, properties: List<String>, program: String, arguments: List<String>) -> Int {
  shell.Exec.RunArgv(
    program: "/usr/bin/systemd-run",
    arguments: concat(concat(["--user", "--collect", join(["--unit=", unit], "")], properties), concat([program], arguments)),
  ).exit_code
}

fn systemd_user_control_group(unit: String) -> String {
  trim(s: shell.Exec.RunArgv(
    program: "/usr/bin/systemctl",
    arguments: ["--user", "show", "-p", "ControlGroup", "--value", unit],
  ).stdout)
}

fn systemd_user_main_pid(unit: String) -> String {
  trim(s: shell.Exec.RunArgv(
    program: "/usr/bin/systemctl",
    arguments: ["--user", "show", "-p", "MainPID", "--value", unit],
  ).stdout)
}

fn systemd_user_active_state(unit: String) -> String {
  trim(s: shell.Exec.RunArgv(
    program: "/usr/bin/systemctl",
    arguments: ["--user", "show", "-p", "ActiveState", "--value", unit],
  ).stdout)
}

fn systemd_user_stop(unit: String) -> Int {
  shell.Exec.RunArgv(program: "/usr/bin/systemctl", arguments: ["--user", "stop", unit]).exit_code
}

fn wet_service_live(unit: String) -> Bool {
  systemd_user_active_state(unit: unit) == "active"
    && systemd_user_control_group(unit: unit) != ""
    && systemd_user_main_pid(unit: unit) != ""
    && systemd_user_main_pid(unit: unit) != "0"
}

fn start_wet_sleep(prefix: String) -> String {
  start_wet_argv(
    prefix: prefix,
    properties: ["-p", "Delegate=yes"],
    program: "/bin/sleep",
    arguments: ["90"],
  )
}

fn start_wet_argv(prefix: String, properties: List<String>, program: String, arguments: List<String>) -> String {
  let unit = wet_service_unit(prefix: prefix)
  if systemd_run_user_argv(unit: unit, properties: properties, program: program, arguments: arguments) != 0 {
    ""
  } else if !wet_service_live(unit: unit) {
    let _ = systemd_user_stop(unit: unit)
    ""
  } else {
    unit
  }
}

fn systemd_user_exec_main_start_monotonic(unit: String) -> String {
  trim(s: shell.Exec.RunArgv(
    program: "/usr/bin/systemctl",
    arguments: ["--user", "show", "-p", "ExecMainStartTimestampMonotonic", "--value", unit],
  ).stdout)
}

fn proc_starttime_jiffies(pid: String) -> String {
  trim(s: shell.Exec.RunArgv(
    program: "/bin/sh",
    arguments: ["-c", join(["python3 -c 'import sys; p=sys.argv[1]; t=open(\"/proc/\"+p+\"/stat\").read(); print(t.split(\")\",1)[1].split()[19])' ", pid], "")],
  ).stdout)
}

fn clock_ticks_per_sec() -> Int {
  match parse_int(s: trim(s: shell.Exec.RunArgv(program: "/usr/bin/getconf", arguments: ["CLK_TCK"]).stdout)) {
    Absent => 0
    Present { value: hz } => hz
  }
}

fn jiffies_after_monotonic_us(jiffies: String, monotonic_us: String) -> Bool {
  match parse_int(s: jiffies) {
    Absent => false
    Present { value: j } =>
      match parse_int(s: monotonic_us) {
        Absent => false
        Present { value: mono } => {
          let hz = clock_ticks_per_sec()
          hz > 0 && ((j * 1000000) / hz) > mono
        }
      }
  }
}

fn first_pid_started_after(procs_body: String, monotonic_us: String) -> String {
  fold(
    split(s: procs_body, delimiter: "\n"),
    init: "",
    f: (acc, line) => {
      let pid = trim(s: line)
      if acc != "" {
        acc
      } else if pid == "" {
        acc
      } else if jiffies_after_monotonic_us(jiffies: proc_starttime_jiffies(pid: pid), monotonic_us: monotonic_us) {
        pid
      } else {
        acc
      }
    },
  )
}

test fn row_h_happy_path_register_launch_tombstone() -> Bool {
  match observe_producer_identity() {
    ProducerUnidentified { detail: _ } => false
    ProducerIdentified { control_group: cg, belt_unit: unit } => {
      let root = shell.Mktemp.DirWithTemplate(template: "/tmp/cred-h.XXXXXX").path
      let snap = join([root, "/P"], "")
      if !Filesystem.WriteCreateNew(path: snap, content: "secret\n").success {
        false
      } else {
      let record = CredentialAcquisitionRecord {
        identity: "h1",
        reference: credential_acquisition_reference(identity: "h1", executor: ClaudeFromSnapshot) as String,
        executor_word: "claude",
        snapshot_path: snap,
        belt_unit: unit,
        control_group: cg,
        opened_at: 1,
        launch_deadline: 2,
        state: AttemptReserved,
      }
      match attempt_open_payload(root: root as NonEmptyStr, record: record, codec: credential_acquisition_codec()) {
        AttemptAdvanced { state: _, generation: g1 } =>
          match attempt_begin_launch_payload(root: root as NonEmptyStr, reference: record.reference as NonEmptyStr, expected: g1, codec: credential_acquisition_codec()) {
            AttemptAdvanced { state: _, generation: _ } =>
              match credential_occupy_tombstone(path: snap) {
                CredentialOccupied => credential_snapshot_is_tombstone(text: Filesystem.Read(path: snap).content)
                CredentialOccupyFailed { detail: _ } => false
              }
            _ => false
          }
        _ => false
      }
      }
    }
  }
}

test fn row_t_reserved_past_deadline_may_close() -> Bool {
  let dir = shell.Mktemp.DirWithTemplate(template: "/tmp/cred-t.XXXXXX").path
  let snap = join([dir, "/P"], "")
  if !Filesystem.WriteCreateNew(path: snap, content: "secret\n").success {
    false
  } else {
    let record = rec(state: AttemptReserved, deadline: 10, snapshot_path: snap, control_group: "/x")
    match credential_recovery_decide(record: record, drain: drain_ended(path: RecordedPathEmpty), now: 20) {
      CredentialRecoveryPreserve { reason: _ } => false
      CredentialRecoverySealNow { reason: _ } => false
      CredentialRecoveryMayClose { reason: _ } =>
        match credential_seal_after_terminate(record: record, drain: drain_ended(path: RecordedPathEmpty)) {
          CredentialSealed { path: p } =>
            p == snap && credential_snapshot_is_tombstone(text: Filesystem.Read(path: snap).content)
          CredentialSealFailed { detail: _ } => false
          CredentialCleanupOwed { reason: _ } => false
        }
    }
  }
}

test fn row_3a_sigstop_own_scope_preserves() -> Bool {
  let instance = shell.Mktemp.DirWithTemplate(template: "/tmp/cred-3a.XXXXXX").path
  let snap = join([instance, "/P"], "")
  let slots = credential_acquisition_slots_root(instance_root: instance)
  let _ = shell.Mkdir.Parents(path: slots as FilePath)
  let unit = start_wet_sleep(prefix: "cred-wet-3a")
  if unit == "" {
    false
  } else {
    let cg = systemd_user_control_group(unit: unit)
    let main = systemd_user_main_pid(unit: unit)
    let record = rec(state: AttemptReserved, deadline: 15, snapshot_path: snap, control_group: cg)
    match attempt_open_payload(root: slots, record: record, codec: credential_acquisition_codec()) {
      AttemptAdvanced { state: _, generation: _ } => {
        let stopped = shell.Exec.RunArgv(program: "/bin/kill", arguments: ["-STOP", main])
        let first = credential_recover_slot(root: slots, reference: record.reference as NonEmptyStr, now: 20)
        let after_first = Filesystem.Read(path: snap)
        let no_tomb = !after_first.success || !credential_snapshot_is_tombstone(text: after_first.content)
        let _ = shell.Exec.RunArgv(program: "/bin/kill", arguments: ["-CONT", main])
        let _ = systemd_user_stop(unit: unit)
        let second = credential_recover_slot(root: slots, reference: record.reference as NonEmptyStr, now: 21)
        stopped.exit_code == 0 && no_tomb
          && match first {
            CredentialSlotKept { text: t } => string_contains(s: t, pattern: "owed")
            CredentialSlotClosed { text: _ } => false
            CredentialSlotFailed { text: _ } => false
          }
          && match second {
            CredentialSlotClosed { text: _ } => credential_snapshot_is_tombstone(text: Filesystem.Read(path: snap).content)
            CredentialSlotKept { text: _ } => false
            CredentialSlotFailed { text: _ } => false
          }
      }
      AttemptTransitionRefused { detail: d } => {
        let _ = systemd_user_stop(unit: unit)
        credential_open_was_refused(t: AttemptTransitionRefused { detail: d }) && false
      }
      AttemptLostRace { expected: _, observed: _ } => {
        let _ = systemd_user_stop(unit: unit)
        false
      }
    }
  }
}

test fn row_3b_record_round_trip() -> Bool {
  let r = rec(state: AttemptReserved, deadline: 40, snapshot_path: "/tmp/cred-p", control_group: "/gunbc.slice/x.service")
  match credential_record_decode(text: credential_record_json(r: r)) {
    Present { value: back } => back.reference == r.reference && back.control_group == r.control_group && back.belt_unit == r.belt_unit
    Absent => false
  }
}

test fn row_d_sigkill_inside_window_preserves_reserved() -> Bool {
  let instance = shell.Mktemp.DirWithTemplate(template: "/tmp/cred-d.XXXXXX").path
  let snap = join([instance, "/P"], "")
  let slots = credential_acquisition_slots_root(instance_root: instance)
  let _ = shell.Mkdir.Parents(path: slots as FilePath)
  let holder = join(["printf secret > ", snap, "; exec 3<", snap, "; while :; do :; done"], "")
  let unit = start_wet_argv(
    prefix: "cred-wet-d",
    properties: ["-p", "Delegate=yes"],
    program: "/bin/sh",
    arguments: ["-c", holder],
  )
  if unit == "" {
    false
  } else {
    let cg = systemd_user_control_group(unit: unit)
    let main = systemd_user_main_pid(unit: unit)
    let record = rec(state: AttemptReserved, deadline: 15, snapshot_path: snap, control_group: cg)
    match attempt_open_payload(root: slots, record: record, codec: credential_acquisition_codec()) {
      AttemptAdvanced { state: _, generation: _ } => {
        let stopped = shell.Exec.RunArgv(program: "/bin/kill", arguments: ["-STOP", main])
        let first = credential_recover_slot(root: slots, reference: record.reference as NonEmptyStr, now: 20)
        let after_first = Filesystem.Read(path: snap)
        let no_tomb = after_first.success && !credential_snapshot_is_tombstone(text: after_first.content)
        let _ = shell.Exec.RunArgv(program: "/bin/kill", arguments: ["-CONT", main])
        let _ = systemd_user_stop(unit: unit)
        let second = credential_recover_slot(root: slots, reference: record.reference as NonEmptyStr, now: 21)
        stopped.exit_code == 0 && no_tomb
          && match first {
            CredentialSlotKept { text: t } => string_contains(s: t, pattern: "owed")
            CredentialSlotClosed { text: _ } => false
            CredentialSlotFailed { text: _ } => false
          }
          && match second {
            CredentialSlotClosed { text: _ } => credential_snapshot_is_tombstone(text: Filesystem.Read(path: snap).content)
            CredentialSlotKept { text: _ } => false
            CredentialSlotFailed { text: _ } => false
          }
      }
      AttemptTransitionRefused { detail: d } => {
        let _ = systemd_user_stop(unit: unit)
        credential_open_was_refused(t: AttemptTransitionRefused { detail: d }) && false
      }
      AttemptLostRace { expected: _, observed: _ } => {
        let _ = systemd_user_stop(unit: unit)
        false
      }
    }
  }
}

test fn row_w_reserved_inside_window_preserves() -> Bool {
  match credential_recovery_decide(record: rec(state: AttemptReserved, deadline: 100, snapshot_path: "/tmp/cred-p", control_group: "/x"), drain: drain_ended(path: RecordedPathEmpty), now: 20) {
    CredentialRecoveryPreserve { reason: r } => string_contains(s: r, pattern: "W:")
    CredentialRecoveryMayClose { reason: _ } => false
    CredentialRecoverySealNow { reason: _ } => false
  }
}

test fn row_r_launching_drained_scope_may_close() -> Bool {
  let unit = start_wet_sleep(prefix: "cred-wet-r")
  if unit == "" {
    false
  } else {
    let cg = systemd_user_control_group(unit: unit)
    let _ = systemd_user_stop(unit: unit)
    match credential_recovery_decide(
      record: rec(state: AttemptLaunching, deadline: 10, snapshot_path: "/tmp/cred-p", control_group: cg),
      drain: recorded_cgroup_drain(path: observe_recorded_cgroup_path(control_group: cg)),
      now: 20,
    ) {
      CredentialRecoveryMayClose { reason: _ } => true
      CredentialRecoveryPreserve { reason: _ } => false
      CredentialRecoverySealNow { reason: _ } => false
    }
  }
}

test fn row_l_live_scope_populated_preserves() -> Bool {
  let unit = start_wet_sleep(prefix: "cred-wet-l")
  if unit == "" {
