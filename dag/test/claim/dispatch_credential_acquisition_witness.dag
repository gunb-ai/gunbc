  let reference = credential_acquisition_reference(identity: attempt.attempt_key, executor: ClaudeFromSnapshot)
  match credential_register_then_take(attempt: attempt, executor: ClaudeFromSnapshot, custody: fx_planted_custody(dir: custody_dir as String)) {
    DispatchSnapshotRefused { reason: _ } => false
    DispatchSnapshotTaken { snapshot } =>
      match credential_terminate(
        credentials: slots,
        reference: reference,
        expected: cas_generation_first(),
        verdict: AttemptRecovered,
