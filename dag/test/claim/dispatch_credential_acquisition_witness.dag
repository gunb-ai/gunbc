  let instance_root = shell.Mktemp.DirWithTemplate(template: "/tmp/cred-reg.XXXXXX").path
  let custody_dir = shell.Mktemp.DirWithTemplate(template: "/tmp/cred-reg-custody.XXXXXX").path
  let _ = shell.Mkdir.Parents(path: fx_slots_dir(instance_root: instance_root as String) as FilePath)
  match fx_credentials(instance_root: instance_root as String) {
    Absent => false
    Present { value: slots } => {
  let attempt = fx_temp_attempt(instance_root: instance_root, attempt_key: "regtake00000001", node_id: "node-cred-acq-reg")
  let reference = credential_acquisition_reference(identity: attempt.attempt_key, executor: ClaudeFromSnapshot)
  match credential_register_then_take(attempt: attempt, executor: ClaudeFromSnapshot, custody: fx_planted_custody(dir: custody_dir as String)) {
    DispatchSnapshotRefused { reason: _ } => false
    DispatchSnapshotTaken { snapshot: _ } => {
      let slot = Filesystem.Read(path: join([fx_slots_dir(instance_root: instance_root as String), "/", reference as String, ".1"], ""))
      slot.success && string_contains(s: slot.content, pattern: "reserved")
    }
  }
    }
  }
}

test fn inhabitance_lost_admission_discards_snapshot() -> Bool {
  let instance_root = shell.Mktemp.DirWithTemplate(template: "/tmp/cred-lost.XXXXXX").path
  let custody_dir = shell.Mktemp.DirWithTemplate(template: "/tmp/cred-lost-custody.XXXXXX").path
  let _ = shell.Mkdir.Parents(path: fx_slots_dir(instance_root: instance_root as String) as FilePath)
  match fx_credentials(instance_root: instance_root as String) {
    Absent => false
    Present { value: slots } => {
  let attempt = fx_temp_attempt(instance_root: instance_root, attempt_key: "lostadm00000001", node_id: "node-cred-acq-lost")
  let reference = credential_acquisition_reference(identity: attempt.attempt_key, executor: ClaudeFromSnapshot)
  match credential_register_then_take(attempt: attempt, executor: ClaudeFromSnapshot, custody: fx_planted_custody(dir: custody_dir as String)) {
    DispatchSnapshotRefused { reason: _ } => false
    DispatchSnapshotTaken { snapshot } =>
      match credential_terminate(
        credentials: slots,
        reference: reference,
        expected: cas_generation_first(),
        verdict: AttemptRecovered,
        detail: "fixture terminate before admission",
        reader: reader_ended(),
      ) {
        AttemptAdvanced { state: _, generation: _ } =>
          match credential_admit_reader_or_discard(snapshot: snapshot) {
            LaunchLostSnapshotDiscarded => credential_snapshot_is_tombstone(text: Filesystem.Read(path: taken_credential_snapshot_path(snapshot: snapshot) as String).content)
            LaunchLostDiscardFailed { reason: _ } => false
            CredentialLaunchAdmitted => false
          }
        _ => false
      }
  }
    }
  }
}

