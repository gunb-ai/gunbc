}

test fn row_r_launching_drained_scope_may_close() -> Bool {
  let unit = start_wet_sleep(prefix: "cred-wet-r")
  if unit == "" {
    false
  } else {
    let cg = systemd_user_control_group(unit: unit)
    let _ = systemd_user_stop(unit: unit)
    match credential_recovery_decide(
      record: rec(state: AttemptLaunching, deadline: 10, snapshot_path: "/tmp/cred-p", control_group: cg),
      drain: recorded_cgroup_drain(path: observe_recorded_cgroup_path(control_group: cg)),
      now: 20,
      reader: reader_ended(),
    root: CursorRuntimeRootNotRegistered,
  ) {
      CredentialRecoveryMayClose { reason: _ } => true
      CredentialRecoveryPreserve { reason: _ } => false
      CredentialRecoverySealNow { reason: _ } => false
    }
  }
}

test fn row_l_live_scope_populated_preserves() -> Bool {
  let unit = start_wet_sleep(prefix: "cred-wet-l")
  if unit == "" {
    false
  } else {
    let cg = systemd_user_control_group(unit: unit)
    let standing = observe_recorded_cgroup_path(control_group: cg)
    let _ = systemd_user_stop(unit: unit)
    match standing { RecordedPathPopulated => true  _ => false }
  }
}

test fn row_m_live_tmux_pane_no_unit_preserves() -> Bool {
  let token = unique_token()
  let session = join(["cred-wet-m-", token], "")
  let sock = join([shell.Mktemp.DirWithTemplate(template: "/tmp/cred-tmux.XXXXXX").path, "/sock"], "")
  let started = shell.Exec.RunArgv(
    program: "/usr/bin/tmux",
    arguments: ["-S", sock, "new-session", "-d", "-s", session, "/bin/sleep", "90"],
  )
  if started.exit_code != 0 {
    false
  } else {
    let pid = trim(s: shell.Exec.RunArgv(program: "/usr/bin/tmux", arguments: ["-S", sock, "list-panes", "-t", session, "-F", "#\{pane_pid\}"]).stdout)
    let raw = Filesystem.Read(path: join(["/proc/", pid, "/cgroup"], ""))
    if pid == "" || !raw.success {
      let _ = shell.Exec.RunArgv(program: "/usr/bin/tmux", arguments: ["-S", sock, "kill-session", "-t", session])
      false
    } else {
      let cg = trim(s: shell.Exec.RunArgv(program: "/bin/sh", arguments: ["-c", join(["awk -F: '$1==0\{print $3}' /proc/", pid, "/cgroup"], "")]).stdout)
      if cg == "" {
        let _ = shell.Exec.RunArgv(program: "/usr/bin/tmux", arguments: ["-S", sock, "kill-session", "-t", session])
        false
      } else {
        let standing = observe_recorded_cgroup_path(control_group: cg)
        let _ = shell.Exec.RunArgv(program: "/usr/bin/tmux", arguments: ["-S", sock, "kill-session", "-t", session])
        match standing { RecordedPathPopulated => true  _ => false }
      }
    }
  }
}

test fn row_launching_drained_live_reader_preserves() -> Bool {
  match credential_recovery_decide(
    record: rec(state: AttemptLaunching, deadline: 10, snapshot_path: "/tmp/cred-p", control_group: "/x"),
    drain: drain_ended(path: RecordedPathEmpty),
    now: 20,
    reader: reader_running(),
    root: CursorRuntimeRootNotRegistered,
  ) {
    CredentialRecoveryPreserve { reason: r } => string_contains(s: r, pattern: "reader still live")
    CredentialRecoveryMayClose { reason: _ } => false
    CredentialRecoverySealNow { reason: _ } => false
  }
}

test fn row_m_drained_producer_live_reader_preserves() -> Bool {
  let instance_root = shell.Mktemp.DirWithTemplate(template: "/tmp/cred-mprime.XXXXXX").path
  let snap = join([instance_root, "/P"], "")
  let _ = shell.Mkdir.Parents(path: fx_slots_dir(instance_root: instance_root) as FilePath)
  match fx_credentials(instance_root: instance_root) {
    Absent => false
    Present { value: slots } => {
  if !Filesystem.WriteCreateNew(path: snap, content: "secret\n").success {
    false
  } else {
    let attempt = fx_temp_attempt(instance_root: instance_root, attempt_key: "mprime000000001", node_id: "node-cred-acq-m")
    let producer = start_wet_sleep(prefix: "cred-wet-mprime")
    if producer == "" {
      false
    } else {
      let cg = systemd_user_control_group(unit: producer)
      let record = CredentialAcquisitionRecord {
        identity: attempt.attempt_key,
        node_id: attempt.node.node as String,
        reference: credential_acquisition_reference(identity: attempt.attempt_key, executor: ClaudeFromSnapshot) as String,
        executor: AttemptClaude,
        snapshot_path: snap,
        belt_unit: producer,
        control_group: cg,
        opened_at: 10,
        launch_deadline: 15,
        state: AttemptReserved,
      }
      let session = join(["gunbc-dispatch-", attempt.node.node as String], "")
      let _ = fx_kill_vendor_session(instance: attempt.instance, session: session)
      let started = fx_start_vendor_pane(instance: attempt.instance, session: session, inner_argv: ["/bin/sleep", "90"])
      if started != 0 {
        let _ = fx_kill_vendor_session(instance: attempt.instance, session: session)
        let _ = systemd_user_stop(unit: producer)
        false
      } else {
        let pid = trim(s: shell.Exec.RunArgv(
          program: "/usr/bin/tmux",
          arguments: concat(
            tmux_server_scope_argv(scope: attempt.instance.tmux_server),
            ["list-panes", "-t", session, "-F", "#\{pane_pid\}"],
          ),
        ).stdout)
        let stopped = shell.Exec.RunArgv(program: "/bin/kill", arguments: ["-STOP", pid])
        match credential_open(credentials: slots, record: record) {
          AttemptTransitionRefused { detail: _ } => {
            let _ = fx_kill_vendor_session(instance: attempt.instance, session: session)
            let _ = systemd_user_stop(unit: producer)
            false
          }
          AttemptLostRace { expected: _, observed: _ } => {
            let _ = fx_kill_vendor_session(instance: attempt.instance, session: session)
            let _ = systemd_user_stop(unit: producer)
            false
          }
          AttemptAdvanced { state: _, generation: g } =>
            match credential_begin_launch(credentials: slots, reference: record.reference as NonEmptyStr, expected: g) {
              AttemptTransitionRefused { detail: _ } => {
                let _ = fx_kill_vendor_session(instance: attempt.instance, session: session)
                let _ = systemd_user_stop(unit: producer)
                false
              }
              AttemptLostRace { expected: _, observed: _ } => {
                let _ = fx_kill_vendor_session(instance: attempt.instance, session: session)
                let _ = systemd_user_stop(unit: producer)
                false
              }
              AttemptAdvanced { state: _, generation: _ } => {
                let _ = systemd_user_stop(unit: producer)
                let first_reader = belt_credential_reader_for(
                  instance: attempt.instance,
                  node_id: attempt.node.node as String,
                  attempt_key: attempt.attempt_key,
                )
                let first = credential_recover_slot(credentials: slots, reference: record.reference as NonEmptyStr, now: 20, reader: first_reader)
                let after_first = Filesystem.Read(path: snap)
                let kept = stopped.exit_code == 0 && after_first.success && !credential_snapshot_is_tombstone(text: after_first.content)
                  && match first {
                    CredentialSlotKept { text: t } => string_contains(s: t, pattern: "reader still live") || string_contains(s: t, pattern: "launching")
                    CredentialSlotClosed { text: _ } => false
                    CredentialSlotFailed { text: _ } => false
                  }
                let _ = shell.Exec.RunArgv(program: "/bin/kill", arguments: ["-KILL", pid])
                let second_reader = belt_credential_reader_for(
                  instance: attempt.instance,
                  node_id: attempt.node.node as String,
                  attempt_key: attempt.attempt_key,
                )
                let second = credential_recover_slot(credentials: slots, reference: record.reference as NonEmptyStr, now: 21, reader: second_reader)
                let _ = fx_kill_vendor_session(instance: attempt.instance, session: session)
                kept && match second {
                  CredentialSlotClosed { text: _ } => credential_snapshot_is_tombstone(text: Filesystem.Read(path: snap).content)
                  CredentialSlotKept { text: _ } => false
                  CredentialSlotFailed { text: _ } => false
                }
              }
            }
        }
      }
    }
  }
    }
  }
}

test fn row_m_reaped_pane_exit_record_seals() -> Bool {
  let instance_root = shell.Mktemp.DirWithTemplate(template: "/tmp/cred-mreap.XXXXXX").path
  let snap = join([instance_root, "/P"], "")
  let _ = shell.Mkdir.Parents(path: fx_slots_dir(instance_root: instance_root) as FilePath)
  match fx_credentials(instance_root: instance_root) {
    Absent => false
    Present { value: slots } => {
  if !Filesystem.WriteCreateNew(path: snap, content: "secret\n").success {
    false
  } else {
    let attempt = fx_temp_attempt(instance_root: instance_root, attempt_key: "mreap0000000001", node_id: "node-cred-acq-mreap")
    let producer = start_wet_sleep(prefix: "cred-wet-mreap")
    if producer == "" {
      false
    } else {
      let cg = systemd_user_control_group(unit: producer)
      let record = CredentialAcquisitionRecord {
        identity: attempt.attempt_key,
        node_id: attempt.node.node as String,
        reference: credential_acquisition_reference(identity: attempt.attempt_key, executor: ClaudeFromSnapshot) as String,
        executor: AttemptClaude,
        snapshot_path: snap,
        belt_unit: producer,
        control_group: cg,
        opened_at: 10,
        launch_deadline: 15,
        state: AttemptReserved,
      }
      let session = join(["gunbc-dispatch-", attempt.node.node as String], "")
      let _ = fx_kill_vendor_session(instance: attempt.instance, session: session)
      let started = fx_start_vendor_pane(instance: attempt.instance, session: session, inner_argv: ["/bin/sleep", "90"])
      if started != 0 {
        let _ = fx_kill_vendor_session(instance: attempt.instance, session: session)
        let _ = systemd_user_stop(unit: producer)
        false
      } else {
        let pid = trim(s: shell.Exec.RunArgv(
          program: "/usr/bin/tmux",
          arguments: concat(
            tmux_server_scope_argv(scope: attempt.instance.tmux_server),
            ["list-panes", "-t", session, "-F", "#\{pane_pid\}"],
          ),
        ).stdout)
        match credential_open(credentials: slots, record: record) {
          AttemptTransitionRefused { detail: _ } => {
            let _ = fx_kill_vendor_session(instance: attempt.instance, session: session)
            let _ = systemd_user_stop(unit: producer)
            false
          }
          AttemptLostRace { expected: _, observed: _ } => {
            let _ = fx_kill_vendor_session(instance: attempt.instance, session: session)
            let _ = systemd_user_stop(unit: producer)
            false
          }
          AttemptAdvanced { state: _, generation: g } =>
            match credential_begin_launch(credentials: slots, reference: record.reference as NonEmptyStr, expected: g) {
              AttemptTransitionRefused { detail: _ } => {
                let _ = fx_kill_vendor_session(instance: attempt.instance, session: session)
                let _ = systemd_user_stop(unit: producer)
                false
              }
              AttemptLostRace { expected: _, observed: _ } => {
                let _ = fx_kill_vendor_session(instance: attempt.instance, session: session)
                let _ = systemd_user_stop(unit: producer)
                false
              }
              AttemptAdvanced { state: _, generation: _ } => {
                let _ = systemd_user_stop(unit: producer)
                let _ = shell.Exec.RunArgv(program: "/bin/kill", arguments: ["-KILL", pid])
                let noted = attempt_exit_record_put_vendor_pane_death(
                  instance_root: attempt.instance.instance_root as String,
                  node_id: attempt.node.node as String,
                  attempt_key: attempt.attempt_key,
                  death: VendorPaneSignaled { signal: 9 },
                )
                let _ = fx_kill_vendor_session(instance: attempt.instance, session: session)
                let reaped = belt_credential_reader_for(
                  instance: attempt.instance,
                  node_id: attempt.node.node as String,
                  attempt_key: attempt.attempt_key,
                )
                let closed = credential_recover_slot(credentials: slots, reference: record.reference as NonEmptyStr, now: 21, reader: reaped)
                match noted {
                  AttemptExitRecordPutFailed { reason: _ } => false
                  AttemptExitRecordPutOk => match closed {
                    CredentialSlotClosed { text: _ } =>
                      fx_exit_record_found(
                        instance_root: attempt.instance.instance_root as String,
                        node_id: attempt.node.node as String,
                        attempt_key: attempt.attempt_key,
                      ) && match reaped {
                        CredentialReaderEnded => credential_snapshot_is_tombstone(text: Filesystem.Read(path: snap).content)
                        CredentialReaderRunning => false
                        CredentialReaderUnobserved { detail: _ } => false
                      }
                    CredentialSlotKept { text: _ } => false
                    CredentialSlotFailed { text: _ } => false
                  }
                }
              }
            }
        }
      }
    }
  }
    }
  }
}

