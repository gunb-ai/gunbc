                let _ = fx_kill_vendor_session(instance: attempt.instance, session: session)
                let _ = systemd_user_stop(unit: producer)
                false
              }
              AttemptAdvanced { state: _, generation: _ } => {
                let _ = systemd_user_stop(unit: producer)
                let _ = Filesystem.WriteCreateNew(path: flag, content: "go\n")
                let _ = shell.Exec.RunArgv(program: "/bin/sleep", arguments: ["1"])
                let torn = belt_actuate_teardown_for_instance(
                  instance: attempt.instance,
                  session_name: session,
                )
                let recorded = fx_exit_record_found(
                  instance_root: attempt.instance.instance_root as String,
                  node_id: attempt.node.node as String,
                  attempt_key: attempt.attempt_key,
                )
                let reader = belt_credential_reader_for(
                  instance: attempt.instance,
                  node_id: attempt.node.node as String,
                  attempt_key: attempt.attempt_key,
                )
                let closed = credential_recover_slot(credentials: slots, reference: record.reference as NonEmptyStr, now: 21, reader: reader)
                let _ = fx_kill_vendor_session(instance: attempt.instance, session: session)
                match torn {
                  TeardownFailed { session_name: _, detail: _ } => false
                  ReapedSession { session_name: _ } =>
                    recorded && match closed {
                      CredentialSlotClosed { text: _ } => credential_snapshot_is_tombstone(text: Filesystem.Read(path: snap).content)
                      CredentialSlotKept { text: _ } => false
                      CredentialSlotFailed { text: _ } => false
                    }
                }
              }
            }
        }
      }
    }
  }
    }
  }
}

test fn row_u_empty_control_group_is_unreadable() -> Bool {
  match observe_recorded_cgroup_path(control_group: "") {
    RecordedPathUnreadable { detail: d } => string_contains(s: d, pattern: "empty ControlGroup")
    _ => false
  }
}

test fn row_p_populated_preserves() -> Bool {
  let unit = start_wet_sleep(prefix: "cred-wet-p")
  if unit == "" {
    false
  } else {
    let cg = systemd_user_control_group(unit: unit)
    let standing = observe_recorded_cgroup_path(control_group: cg)
    let _ = systemd_user_stop(unit: unit)
    match standing { RecordedPathPopulated => true  _ => false }
  }
}

test fn row_p_prime_empty_after_stop_may_seal() -> Bool {
  let unit = start_wet_sleep(prefix: "cred-wet-pprime")
  if unit == "" {
    false
  } else {
    let cg = systemd_user_control_group(unit: unit)
    let main = systemd_user_main_pid(unit: unit)
    let killed = shell.Exec.RunArgv(program: "/bin/kill", arguments: ["-KILL", main])
    let standing = observe_recorded_cgroup_path(control_group: cg)
    let _ = systemd_user_stop(unit: unit)
    killed.exit_code == 0 && match standing { RecordedPathEmpty => true  _ => false }
  }
}

test fn row_p_double_self_cgroup_still_populated() -> Bool {
  match observe_self_control_group() {
    Absent => false
    Present { value: cg } =>
      if cg == "" {
        false
      } else {
        match observe_recorded_cgroup_path(control_group: cg) {
          RecordedPathPopulated => true
          _ => false
        }
      }
  }
}

test fn row_p_triple_child_cgroup_leftover_preserves() -> Bool {
  let unit = start_wet_sleep(prefix: "cred-wet-ptriple")
  if unit == "" {
    false
  } else {
    let cg = systemd_user_control_group(unit: unit)
    let child = join([cgroup_v2_mount_point as String, cg, "/cred-child"], "")
    let made = shell.Mkdir.Parents(path: child as FilePath)
    let pid = systemd_user_main_pid(unit: unit)
    let moved = Filesystem.Write(path: join([child, "/cgroup.procs"], ""), content: join([pid, "\n"], ""))
    if !made.success || !moved.success {
      let _ = systemd_user_stop(unit: unit)
      false
    } else {
      let standing = observe_recorded_cgroup_path(control_group: cg)
      let _ = systemd_user_stop(unit: unit)
      match standing { RecordedPathPopulated => true  _ => false }
    }
  }
}

test fn row_pf_fork_after_second_scope_preserves() -> Bool {
  let survivor = "trap \"/bin/sleep 300 >/dev/null 2>&1 & exit 0\" USR1; while :; do :; done"
  let unit_a = start_wet_argv(
    prefix: "cred-wet-pf-a",
    properties: ["-p", "Delegate=yes", "-p", "KillMode=process"],
    program: "/bin/sh",
    arguments: ["-c", survivor],
  )
  if unit_a == "" {
    false
  } else {
    let cg_a = systemd_user_control_group(unit: unit_a)
    let pid_a = systemd_user_main_pid(unit: unit_a)
    let unit_b = start_wet_sleep(prefix: "cred-wet-pf-b")
    if unit_b == "" || pid_a == "" || pid_a == "0" || cg_a == "" {
      let _ = systemd_user_stop(unit: unit_a)
      let _ = systemd_user_stop(unit: unit_b)
      false
    } else {
      let b_mono = systemd_user_exec_main_start_monotonic(unit: unit_b)
      let _ = shell.Exec.RunArgv(program: "/bin/kill", arguments: ["-USR1", pid_a])
      let _ = shell.Exec.RunArgv(program: "/bin/sleep", arguments: ["0.3"])
      let procs = Filesystem.Read(path: join([cgroup_v2_mount_point as String, cg_a, "/cgroup.procs"], "")).content
      let child = first_pid_started_after(procs_body: procs, monotonic_us: b_mono)
      let main_after = systemd_user_main_pid(unit: unit_a)
      if child == "" || (main_after != "" && main_after != "0") {
        let _ = systemd_user_stop(unit: unit_a)
        let _ = systemd_user_stop(unit: unit_b)
        false
      } else {
        let standing = observe_recorded_cgroup_path(control_group: cg_a)
        let _ = shell.Exec.RunArgv(program: "/bin/kill", arguments: ["-9", child])
        let _ = systemd_user_stop(unit: unit_a)
        let _ = systemd_user_stop(unit: unit_b)
        match standing { RecordedPathPopulated => true  _ => false }
      }
    }
  }
}

test fn row_o_terminal_owed_retries_until_drained() -> Bool {
  let instance = shell.Mktemp.DirWithTemplate(template: "/tmp/cred-o.XXXXXX").path
  let snap = join([instance, "/P"], "")
  let _ = shell.Mkdir.Parents(path: fx_slots_dir(instance_root: instance) as FilePath)
  match fx_credentials(instance_root: instance) {
    Absent => false
    Present { value: slots } => {
  let unit = start_wet_sleep(prefix: "cred-wet-o")
  if unit == "" {
    false
  } else {
    let cg = systemd_user_control_group(unit: unit)
    let record = rec(state: AttemptReserved, deadline: 15, snapshot_path: snap, control_group: cg)
    match credential_open(credentials: slots, record: record) {
      AttemptAdvanced { state: _, generation: g } =>
        match credential_terminate(
          credentials: slots,
          reference: record.reference as NonEmptyStr,
          expected: g,
          verdict: AttemptRecovered,
          detail: "fixture terminal for owed retry",
          reader: reader_ended(),
        ) {
          AttemptAdvanced { state: _, generation: _ } => {
            let _ = Filesystem.Write(path: snap, content: "secret\n")
            let first = credential_recover_slot(credentials: slots, reference: record.reference as NonEmptyStr, now: 20, reader: reader_ended())
            let after_first = Filesystem.Read(path: snap)
            let owed = after_first.success && after_first.content == "secret\n"
              && match first {
                CredentialSlotKept { text: t } => string_contains(s: t, pattern: "owed")
                CredentialSlotClosed { text: _ } => false
                CredentialSlotFailed { text: _ } => false
              }
            let _ = systemd_user_stop(unit: unit)
            let second = credential_recover_slot(credentials: slots, reference: record.reference as NonEmptyStr, now: 21, reader: reader_ended())
            owed && match second {
              CredentialSlotClosed { text: _ } => credential_snapshot_is_tombstone(text: Filesystem.Read(path: snap).content)
              CredentialSlotKept { text: _ } => false
              CredentialSlotFailed { text: _ } => false
            }
          }
          AttemptTransitionRefused { detail: _ } => {
            let _ = systemd_user_stop(unit: unit)
            false
          }
          AttemptLostRace { expected: _, observed: _ } => {
            let _ = systemd_user_stop(unit: unit)
            false
          }
        }
      AttemptTransitionRefused { detail: d } => {
        let _ = systemd_user_stop(unit: unit)
        credential_open_was_refused(t: AttemptTransitionRefused { detail: d }) && false
      }
      AttemptLostRace { expected: _, observed: _ } => {
        let _ = systemd_user_stop(unit: unit)
        false
      }
    }
  }
    }
  }
}

test fn row_e_unreadable_preserves() -> Bool {
  match credential_recovery_decide(
    record: rec(state: AttemptLaunching, deadline: 10, snapshot_path: "/tmp/cred-p", control_group: "/x"),
    drain: drain_ended(path: RecordedPathUnreadable { detail: "EIO" }),
    now: 20,
    reader: reader_ended(),
    root: CursorRuntimeRootNotRegistered,
  ) {
    CredentialRecoveryPreserve { reason: r } => string_contains(s: r, pattern: "EIO")
    CredentialRecoveryMayClose { reason: _ } => false
    CredentialRecoverySealNow { reason: _ } => false
  }
}

test fn row_f_seal_not_owed_when_populated() -> Bool {
  match fx_seal_in_fresh_store(
    record: rec(state: AttemptLaunching, deadline: 10, snapshot_path: "/tmp/cred-p", control_group: "/x"),
    drain: drain_ended(path: RecordedPathPopulated),
  ) {
    CredentialCleanupOwed { reason: _ } => true
    CredentialSealed { path: _ } => false
    CredentialSealFailed { detail: _ } => false
  }
}

test fn row_b_two_references_do_not_share_a_slot() -> Bool {
  let root = shell.Mktemp.DirWithTemplate(template: "/tmp/cred-acq.XXXXXX").path
  let a = rec(state: AttemptReserved, deadline: 100, snapshot_path: "/tmp/cred-a", control_group: "/x")
  let b = CredentialAcquisitionRecord {
    identity: "id2", node_id: "node-cred-acq", reference: credential_acquisition_reference(identity: "id2", executor: CursorFromSnapshot) as String,
    executor: AttemptCursor { runtime_root: CursorRuntimeRootUnregistered }, snapshot_path: "/tmp/cred-b", belt_unit: "u",
    control_group: "/y", opened_at: 10, launch_deadline: 100, state: AttemptReserved,
  }
  match fx_credentials(instance_root: root) {
  Absent => false
  Present { value: slots } =>
match credential_open(credentials: slots, record: a) {
    AttemptAdvanced { state: _, generation: _ } =>
      match credential_open(credentials: slots, record: b) {
        AttemptAdvanced { state: _, generation: _ } => a.reference != b.reference
        _ => false
      }
    _ => false
  }
  }
}

test fn row_c_second_open_of_same_reference_loses() -> Bool {
  let root = shell.Mktemp.DirWithTemplate(template: "/tmp/cred-acq.XXXXXX").path
  match fx_credentials(instance_root: root) {
  Absent => false
  Present { value: slots } => {
  let opened = credential_open(credentials: slots, record: rec(state: AttemptReserved, deadline: 100, snapshot_path: "/tmp/cred-p", control_group: "/x"))
  let again = credential_open(credentials: slots, record: rec(state: AttemptReserved, deadline: 100, snapshot_path: "/tmp/cred-p", control_group: "/x"))
  match opened {
    AttemptAdvanced { state: _, generation: _ } =>
      match again {
        AttemptLostRace { expected: e, observed: _ } => string_contains(s: e, pattern: "absent")
        _ => false
      }
    _ => false
  }
  }
  }
}

