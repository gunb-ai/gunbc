test fn row_m_teardown_refuses_when_exit_record_write_fails() -> Bool {
  let instance_root = shell.Mktemp.DirWithTemplate(template: "/tmp/cred-mro.XXXXXX").path
  let snap = join([instance_root, "/P"], "")
  let _ = shell.Mkdir.Parents(path: fx_slots_dir(instance_root: instance_root) as FilePath)
  if !Filesystem.WriteCreateNew(path: snap, content: "secret\n").success {
    false
  } else {
    let attempt = fx_temp_attempt(instance_root: instance_root, attempt_key: "mro000000000001", node_id: "node-cred-acq-mro")
    let producer = start_wet_sleep(prefix: "cred-wet-mro")
    if producer == "" {
      false
    } else {
      let session = join(["gunbc-dispatch-", attempt.node.node as String], "")
      let _ = fx_kill_vendor_session(instance: attempt.instance, session: session)
      let started = fx_start_vendor_pane(instance: attempt.instance, session: session, inner_argv: ["/bin/sleep", "90"])
      if started != 0 || !fx_write_current_attempt_key(
        instance: attempt.instance,
        node_id: attempt.node.node as String,
        attempt_key: attempt.attempt_key,
      ) {
        let _ = fx_kill_vendor_session(instance: attempt.instance, session: session)
        let _ = systemd_user_stop(unit: producer)
        false
      } else {
        let pid = trim(s: shell.Exec.RunArgv(
          program: "/usr/bin/tmux",
          arguments: concat(
            tmux_server_scope_argv(scope: attempt.instance.tmux_server),
            ["list-panes", "-t", session, "-F", "#\{pane_pid\}"],
          ),
        ).stdout)
        let inbox = attempt_exit_inbox_dir(instance_root: attempt.instance.instance_root as String)
        let locked = shell.Exec.RunArgv(program: "/bin/chmod", arguments: ["0555", inbox])
        let _ = systemd_user_stop(unit: producer)
        let _ = shell.Exec.RunArgv(program: "/bin/kill", arguments: ["-KILL", pid])
        let torn = belt_actuate_teardown_for_instance(
          instance: attempt.instance,
          session_name: session,
        )
        let kept = fx_pane_present(instance: attempt.instance, session: session)
        let _ = shell.Exec.RunArgv(program: "/bin/chmod", arguments: ["0755", inbox])
        let _ = fx_kill_vendor_session(instance: attempt.instance, session: session)
        locked.exit_code == 0 && kept && match torn {
          TeardownFailed { session_name: _, detail: d } => string_contains(s: d, pattern: "exit record write failed")
          ReapedSession { session_name: _ } => false
        }
      }
    }
  }
}

