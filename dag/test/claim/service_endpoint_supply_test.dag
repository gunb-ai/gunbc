// dag/test/claim/service_endpoint_supply_test.dag — WITNESS: a service `config endpoint:`
// that names an OPERATION INPUT means THAT INPUT, in all three readers that answer it.
//
// THE DEFECT THIS WITNESS KEEPS OUT. `dispatch_rest` (src/v1/stage0/src/v1_interpreter.rs) resolves
// `svc_endpoint` with `find_service_config_string(..., param_env, ctx)` -- it EVALUATES the config
// value in the CALLED OPERATION'S PARAMETER ENVIRONMENT, so `endpoint: request_url` where
// `request_url` is that operation's own declared `String` input is a legal spelling whose value is
// the argument at the call. Before this cut the other two readers disagreed with it and with each
// other: the lens (`v1.compiler.infer`, `infer_service_config_properties`) judged the value in
// MODULE scope and refused that spelling with `undefined variable`, and the Rust emitter
// (`v1.compiler.emit_rust`) read only a string literal and otherwise fell through to the transport
// `base_url` and then to the `http://localhost` placeholder -- so the same declaration compiled to a
// host its interpretation never used, with no refusal anywhere. That is the
// `response_format_variant_silently_read_as_json` family: one declaration, two routes, silent
// divergence.
//
// WHAT LOCKS IT. All three questions now come from ONE authority,
// `v1.compiler.infer_service.service_endpoint_supply`, and this file executes it on PARSED fixtures
// (not hand-built trees): the supply for each spelling, the emitter's base expression for the same
// declaration, and the lens's own verdict by running the real pipeline over the fixture source with
// `v1.compiler.compile.compile_sources`. The CONTROLS are what make it a witness rather than a
// description: a name that is NOT a declared input of every rest operation must still be refused by
// the lens exactly as before, and it must NOT be admitted by the supply; a service whose rest
// operations disagree gets no binding at all; and reverting either consumer to its own reading of
// the config value turns a case red.
//
// Run:
//   gunbc run --source-root dag --source-root src/v1 --source-root src/v2 \
//     --claim-run \
//     --entry dag/test/claim/service_endpoint_supply_test.dag \
//     --function literal_endpoint_is_a_literal_holds
module test.claim.service_endpoint_supply_test



import extdeps.languages.dag.syntax { dag_parse_environment }


import std.types { String, Bool }


import std.occurrence_identity { OccurrenceSynthetic }


import v1.compiler.tokenize { tokenize }


import v1.compiler.parse { parse_with_table, ParseWithTableResult }


import v1.std.core {
  build_newline_index, empty_intern_table, NewlineIndex, Node, module_items, diagnostic_to_message,
  no_span, NoConnective, Required, NoExprData, NotAModuleItem, Unmarked
}


import v1.compiler.artifact { Rust }


import v1.compiler.compile { compile_sources, SourceFile }


import v1.compiler.infer_items { item_kind, ServiceItem }


import v1.compiler.infer_service {
  service_endpoint_supply, service_operation_items,
  ServiceEndpointSupply,
  EndpointNotDeclared, EndpointLiteral, EndpointOperationParameter, EndpointModuleExpression, EndpointParameterNameUnbound
}


import v1.compiler.emit_rust { emit_rest_url_base, emit_rest_url_line }
import test.claim.service_endpoint_supply_fixtures {
  endpoint_fixture_file,
  literal_endpoint_source,
  parameter_endpoint_source,
  parameter_missing_from_one_operation_source,
  parameter_wrong_type_source,
  member_access_endpoint_source,
  config_without_endpoint_source,
  no_rest_operation_source,
  shadowed_parameter_endpoint_source
}

// FIXTURE ACCESS. A fixture that does not parse is a broken fixture, not a green claim: the module
// node is demanded, and `none` here makes every case using it fail rather than pass vacuously.

fn parse_fixture(source: String) -> ParseWithTableResult {
  parse_with_table(
    tokens: tokenize(source: source, file: endpoint_fixture_file, env: dag_parse_environment),
    source_indices: source_index_map(source: source),
    intern_table: empty_intern_table(),
  )
}




fn parsed_module(source: String) -> Node {
  let parsed = parse_fixture(source: source)
  match parsed.result.module {
    Present { value: m } => m
    Absent => leaf_node_marker()
  }
}

// A node that is definitely NOT a service, so a failed parse cannot be mistaken for one: every
// later filter finds no service item and the case reports false.


fn leaf_node_marker() -> Node {
  Node { ident: Absent, occurrence_identity: OccurrenceSynthetic, name: "__parse_failed__", span: no_span(), ident_span: no_span(), children: [], connective: NoConnective, params: [], inferred: none, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, module_item_kind: NotAModuleItem, declaration_marker: Unmarked, declaration: none, expr_data: NoExprData }
}



fn source_index_map(source: String) -> Map<String, NewlineIndex> {
  map_insert(empty_map(), endpoint_fixture_file, build_newline_index(file: endpoint_fixture_file, source: source))
}



fn fixture_service(source: String) -> Node {
  match module_items(n: parsed_module(source: source)) |> filter(i => item_kind(item: i) == ServiceItem) |> first() {
    Present { value: s } => s
    Absent => leaf_node_marker()
  }
}



fn supply(source: String) -> ServiceEndpointSupply {
  service_endpoint_supply(service: fixture_service(source: source), operations: service_operation_items(service: fixture_service(source: source)), source_indices: source_index_map(source: source))
}

// THE EMITTER AGREES. The base expression for the parameter spelling is the operation's own input,
// rendered through the same target-aware ident renderer that spells it in the method signature; for
// every other spelling it is still the struct's own field. Reverting `emit_rest_url_base` to its own
// reading of the config value turns both cases red.


test fn the_emitter_takes_the_base_from_the_input_it_bound_holds() -> Bool {
  emit_rest_url_base(service_item: fixture_service(source: parameter_endpoint_source), source_indices: source_index_map(source: parameter_endpoint_source)) == "request_url"
}



test fn the_emitter_keeps_the_struct_field_for_every_other_spelling_holds() -> Bool {
  emit_rest_url_base(service_item: fixture_service(source: literal_endpoint_source), source_indices: source_index_map(source: literal_endpoint_source)) == "self.base_url"
    && emit_rest_url_base(service_item: fixture_service(source: parameter_missing_from_one_operation_source), source_indices: source_index_map(source: parameter_missing_from_one_operation_source)) == "self.base_url"
}

// THE URL LINE COMPOSES THE WAY THE INTERPRETER COMPOSES IT: base, then path, with the base being
// the value the operation's input carries. This is the interpreter/emitter differential that is
// checkable without a network: the emitted statement names the parameter, and no longer the field
// that would have carried the `http://localhost` placeholder.



fn diagnostic_messages(source: String) -> List<String> {
  compile_sources(sources: [SourceFile { path: endpoint_fixture_file, content: source }], target: Rust).diagnostics
    |> map(d => diagnostic_to_message(d: d.diagnostic))
}



fn mentions_undefined_variable(messages: List<String>, name: String) -> Bool {
  messages |> any(m => string_contains(s: m, needle: name) && string_contains(s: m, needle: "undefined"))
}

// THE FIXTURES PARSE. If a grammar change makes one of these unparseable, every claim below would
// go red for the wrong reason; this one says which one, and keeps `none` from reading as agreement.


test fn fixtures_parse_to_module_nodes_holds() -> Bool {
  (module_items(n: parsed_module(source: parameter_endpoint_source)) |> count > 0)
    && (module_items(n: parsed_module(source: literal_endpoint_source)) |> count > 0)
    && (module_items(n: parsed_module(source: parameter_missing_from_one_operation_source)) |> count > 0)
    && (module_items(n: parsed_module(source: parameter_wrong_type_source)) |> count > 0)
    && (module_items(n: parsed_module(source: member_access_endpoint_source)) |> count > 0)
    && (module_items(n: parsed_module(source: no_rest_operation_source)) |> count > 0)
    && (module_items(n: parsed_module(source: shadowed_parameter_endpoint_source)) |> count > 0)
}



test fn literal_endpoint_is_a_literal_holds() -> Bool {
  match supply(source: literal_endpoint_source) {
    EndpointLiteral { value: v } => v == "https://sts.googleapis.com"
    _ => false
  }
}

// THE ADMISSION ITSELF: two rest operations, both declaring the input, one spelling.


test fn endpoint_naming_every_rest_operations_input_binds_to_that_input_holds() -> Bool {
  match supply(source: parameter_endpoint_source) {
    EndpointOperationParameter { name: name, declared_type: _ } => name == "request_url"
    _ => false
  }
}

// CONTROL: declared on one rest operation only -- no binding. The answer carries the offending
// name and no list of the operations that lack it: the lens refuses by falling through rather
// than by reporting, so nothing reads such a list, and the located diagnostic naming those
// operations arrives with the diagnostic that will read them. (review 91080 finding 2)


test fn endpoint_naming_one_operations_input_is_refused_holds() -> Bool {
  match supply(source: parameter_missing_from_one_operation_source) {
    EndpointParameterNameUnbound { name: name } => name == "request_url"
    _ => false
  }
}

// CONTROL: declared, but not as `String`.


test fn endpoint_naming_a_non_string_input_is_refused_holds() -> Bool {
  match supply(source: parameter_wrong_type_source) {
    EndpointParameterNameUnbound { name: name } => name == "request_url"
    _ => false
  }
}

// CONTROL: an expression that is not a bare identifier keeps today's judgment. Name-scoped, not
// expression-wide -- this is the case that stops the admission from sliding into "any expression".


test fn member_access_endpoint_is_not_bound_to_an_input_holds() -> Bool {
  match supply(source: member_access_endpoint_source) {
    EndpointModuleExpression => true
    _ => false
  }
}

// CONTROL: with no rest operation, nothing reads a base URL, so the declaration binds nothing and
// keeps the judgment it has today.


test fn endpoint_naming_an_input_of_a_service_with_no_rest_operation_binds_nothing_holds() -> Bool {
  match supply(source: no_rest_operation_source) {
    EndpointModuleExpression => true
    _ => false
  }
}

// CONTROL: parameter beats module scope, which is what the interpreter's param-env evaluation does.


test fn a_parameter_shadowing_a_module_value_of_the_same_name_wins_holds() -> Bool {
  match supply(source: shadowed_parameter_endpoint_source) {
    EndpointOperationParameter { name: name, declared_type: _ } => name == "request_url"
    _ => false
  }
}


// THE URL LINE COMPOSES THE WAY THE INTERPRETER COMPOSES IT: base, then path, with the base being
// the value the operation's input carries. This is the interpreter/emitter differential that is
// checkable without a network: the emitted statement names the parameter, and no longer the field
// that would have carried the `http://localhost` placeholder.


test fn the_emitted_url_line_reads_the_parameter_and_not_the_field_holds() -> Bool {
  let service = fixture_service(source: parameter_endpoint_source)
  let base = emit_rest_url_base(service_item: service, source_indices: source_index_map(source: parameter_endpoint_source))
  match first(service.children) {
    Present { value: op } =>
      match op.transport {
        Present { value: transport } => {
          let line = emit_rest_url_line(transport: transport, op_name: "GetToken", base: base, source_indices: source_index_map(source: parameter_endpoint_source))
          string_contains(s: line, needle: "request_url") && !string_contains(s: line, needle: "self.base_url")
        }
        Absent => false
      }
    Absent => false
  }
}

// THE ABSENT ENDPOINT -- a `config` block that omits `endpoint` PARSES, and parse_config_fields
// mints the property with an empty name (the fixture's comment names the path). That minted empty
// literal is the only route to this answer. The lens then leaves the field deferred and the emitter
// keeps its transport/default base, both unchanged by this cut.


test fn the_authority_reports_the_absent_endpoint_for_a_config_without_one_holds() -> Bool {
  service_endpoint_supply(
    service: fixture_service(source: config_without_endpoint_source),
    operations: service_operation_items(service: fixture_service(source: config_without_endpoint_source)),
    source_indices: source_index_map(source: config_without_endpoint_source)
  ) is EndpointNotDeclared
}


