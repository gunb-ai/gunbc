module test.claim.kernel_float_binary64_denotation_witness_test

import std.types { Bool, Int, List, String }
import std.bit { Bit }
import std.algebra { Ordering, Less, Equal, Greater }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import extdeps.standards.ieee_754_2019 {
  BinaryInterchangeEncoding, EncodingAdmission, EncodingAdmitted, EncodingRefused,
  BiasedExponentFieldWidth, TrailingSignificandFieldWidth, binary32, binary64,
  binary_interchange_encoding, class, compare_quiet, Ordered, Unordered,
  QuietNaN, SignalingNaN, PositiveSubnormal, NegativeZero, PositiveNormal, PositiveInfinity
}
import std.kernel_type_name { KernelTypeNameAdmitted, NotAKernelTypeName, kernel_type_name }
import std.kernel_type_denotation {
  KernelTypeDenotationAdmission, KernelTypeDenotationAdmitted, KernelTypeDenotationRefused,
  KernelTypeDenotation, BinaryInterchangeFormatMeaning,
  kernel_type_denotation_row, kernel_type_denotation_rows, kernel_type_denotation_rows_admitted
}
import extdeps.languages.rust.primitives {
  RustFloatBinding, RustFloatBindingHolds, RustFloatBindingDisagrees, RustFloatBindingUndenoted,
  RustFloatBindingNoPrimitive, RustFloatBindingNotAKernelName, rust_f64_binding, rust_float_binding_verdict
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// KERNEL Float DENOTES binary64, AND RUST f64 IS CHECKED AGAINST THAT DENOTATION. The route claims
// run the production rows (kernel_type_denotation_rows, rust_f64_binding); the REDs plant a row at
// the one interface that takes rows as a parameter, so each refusal is discriminated by the plant
// alone. The binary64 claims build encodings through the admitting constructor, never the record.

fn bits(b: Bit, n: Int) -> List<Bit> {
  if n <= 0 { [] } else { concat([b], bits(b: b, n: n - 1)) }
}

fn admitted(a: EncodingAdmission) -> Bool {
  match a {
    EncodingAdmitted { encoding: _ } => true
    EncodingRefused { refusal: _ } => false
  }
}

// Fields are w = 11 and t = 52 for binary64. A test encoding that fails admission is a defect in
// the claim, so the fallback is a signaling NaN, which no ordered claim below can accept.
fn enc(s: Bit, e: List<Bit>, t: List<Bit>) -> BinaryInterchangeEncoding {
  match binary_interchange_encoding(format: binary64, s: s, e: e, t: t) {
    EncodingAdmitted { encoding: x } => x
    EncodingRefused { refusal: _ } => BinaryInterchangeEncoding { format: binary64, s: false, e: bits(b: true, n: 11), t: concat(bits(b: false, n: 51), [true]) }
  }
}

// 1.0 = E 01111111111, T 0; 2.0 = E 10000000000, T 0.
fn one() -> BinaryInterchangeEncoding { enc(s: false, e: concat([false], bits(b: true, n: 10)), t: bits(b: false, n: 52)) }
fn two() -> BinaryInterchangeEncoding { enc(s: false, e: concat([true], bits(b: false, n: 10)), t: bits(b: false, n: 52)) }
fn minus_one() -> BinaryInterchangeEncoding { enc(s: true, e: concat([false], bits(b: true, n: 10)), t: bits(b: false, n: 52)) }
fn plus_zero() -> BinaryInterchangeEncoding { enc(s: false, e: bits(b: false, n: 11), t: bits(b: false, n: 52)) }
fn minus_zero() -> BinaryInterchangeEncoding { enc(s: true, e: bits(b: false, n: 11), t: bits(b: false, n: 52)) }
fn plus_infinity() -> BinaryInterchangeEncoding { enc(s: false, e: bits(b: true, n: 11), t: bits(b: false, n: 52)) }
fn minus_infinity() -> BinaryInterchangeEncoding { enc(s: true, e: bits(b: true, n: 11), t: bits(b: false, n: 52)) }
fn max_finite() -> BinaryInterchangeEncoding { enc(s: false, e: concat(bits(b: true, n: 10), [false]), t: bits(b: true, n: 52)) }
fn smallest_subnormal() -> BinaryInterchangeEncoding { enc(s: false, e: bits(b: false, n: 11), t: concat(bits(b: false, n: 51), [true])) }
fn quiet_nan() -> BinaryInterchangeEncoding { enc(s: false, e: bits(b: true, n: 11), t: concat([true], bits(b: false, n: 51))) }
fn signaling_nan() -> BinaryInterchangeEncoding { enc(s: false, e: bits(b: true, n: 11), t: concat(bits(b: false, n: 51), [true])) }

fn is_ordered_as(a: BinaryInterchangeEncoding, b: BinaryInterchangeEncoding, expected: Ordering) -> Bool {
  match compare_quiet(a: a, b: b) {
    Ordered { ordering: o } => o == expected
    Unordered => false
  }
}

fn is_unordered(a: BinaryInterchangeEncoding, b: BinaryInterchangeEncoding) -> Bool {
  match compare_quiet(a: a, b: b) {
    Ordered { ordering: _ } => false
    Unordered => true
  }
}

// ---- the denotation and the Rust binding, production route ----

test fn w_production_denotation_rows_are_all_kernel_names() -> Bool  {
  kernel_type_denotation_rows_admitted(rows: kernel_type_denotation_rows)
}

test fn w_rust_f64_holds_against_what_float_denotes() -> Bool  {
  rust_float_binding_verdict(b: rust_f64_binding, denotations: kernel_type_denotation_rows) == RustFloatBindingHolds
}

// ---- REDs at the denotation interface ----

test fn w_planted_float_denotes_binary32_refuses_f64() -> Bool  {
  let planted = [kernel_type_denotation_row(kernel_name: "Float", meaning: BinaryInterchangeFormatMeaning { format: binary32 })]
  match rust_float_binding_verdict(b: rust_f64_binding, denotations: planted) {
    RustFloatBindingDisagrees { kernel_name: k, target_name: t } => k.name == "Float" && t == "f64"
    _ => false
  }
}

test fn w_non_kernel_name_key_is_refused() -> Bool  {
  match kernel_type_denotation_row(kernel_name: "Real", meaning: BinaryInterchangeFormatMeaning { format: binary64 }) {
    KernelTypeDenotationRefused { refusal: NotAKernelTypeName { name: n } } => n == "Real"
    _ => false
  }
}

test fn w_kernel_type_name_admits_only_rostered_names() -> Bool  {
  let float_admitted = match kernel_type_name(name: "Float") {
    KernelTypeNameAdmitted { kernel_name: k } => k.name == "Float"
    NotAKernelTypeName { name: _ } => false
  }
  let binary64_refused = match kernel_type_name(name: "Binary64") {
    NotAKernelTypeName { name: n } => n == "Binary64"
    KernelTypeNameAdmitted { kernel_name: _ } => false
  }
  float_admitted && binary64_refused
}

test fn w_table_with_a_non_kernel_key_is_not_admitted() -> Bool  {
  let planted = [kernel_type_denotation_row(kernel_name: "Float64", meaning: BinaryInterchangeFormatMeaning { format: binary64 })]
  kernel_type_denotation_rows_admitted(rows: planted) == false
}

test fn w_undenoted_kernel_name_refuses_the_binding() -> Bool  {
  match rust_float_binding_verdict(b: rust_f64_binding, denotations: []) {
    RustFloatBindingUndenoted { kernel_name: k } => k.name == "Float"
    _ => false
  }
}

test fn w_binding_to_an_absent_primitive_refuses() -> Bool  {
  let planted = RustFloatBinding {
    kernel_name: kernel_type_name(name: "Float"), target_name: "f80", authority: rust_f64_binding.authority,
    radix: 2, mantissa_digits: 53, max_exp: 1024, min_exp: -1021
  }
  match rust_float_binding_verdict(b: planted, denotations: kernel_type_denotation_rows) {
    RustFloatBindingNoPrimitive { target_name: t } => t == "f80"
    _ => false
  }
}

// ---- binary64 encoding admission (§3.4 widths) ----

test fn w_encoding_with_ten_bit_exponent_field_refuses() -> Bool  {
  match binary_interchange_encoding(format: binary64, s: false, e: bits(b: false, n: 10), t: bits(b: false, n: 52)) {
    EncodingRefused { refusal: BiasedExponentFieldWidth { expected_w: w, observed: o } } => w == 11 && o == 10
    _ => false
  }
}

test fn w_encoding_with_short_trailing_significand_refuses() -> Bool  {
  match binary_interchange_encoding(format: binary64, s: false, e: bits(b: false, n: 11), t: bits(b: false, n: 23)) {
    EncodingRefused { refusal: TrailingSignificandFieldWidth { expected_t: t, observed: o } } => t == 52 && o == 23
    _ => false
  }
}

test fn w_every_named_value_is_admitted() -> Bool  {
  admitted(a: binary_interchange_encoding(format: binary64, s: false, e: bits(b: true, n: 11), t: concat([true], bits(b: false, n: 51))))
    && admitted(a: binary_interchange_encoding(format: binary64, s: false, e: concat(bits(b: true, n: 10), [false]), t: bits(b: true, n: 52)))
}

// ---- §5.7.2 class ----

test fn w_class_separates_quiet_and_signaling_nan() -> Bool  {
  class(x: quiet_nan()) == QuietNaN && class(x: signaling_nan()) == SignalingNaN
}

test fn w_class_names_subnormal_zero_normal_infinity() -> Bool  {
  class(x: smallest_subnormal()) == PositiveSubnormal
    && class(x: minus_zero()) == NegativeZero
    && class(x: one()) == PositiveNormal
    && class(x: plus_infinity()) == PositiveInfinity
}

// ---- §5.11 comparison: NaN is unordered, never ordered ----

test fn w_nan_is_unordered_against_every_operand() -> Bool  {
  is_unordered(a: quiet_nan(), b: one())
    && is_unordered(a: one(), b: signaling_nan())
    && is_unordered(a: quiet_nan(), b: quiet_nan())
    && is_unordered(a: plus_infinity(), b: quiet_nan())
}

test fn w_finite_order_follows_value() -> Bool  {
  is_ordered_as(a: one(), b: two(), expected: Less)
    && is_ordered_as(a: two(), b: one(), expected: Greater)
    && is_ordered_as(a: minus_one(), b: one(), expected: Less)
    && is_ordered_as(a: minus_one(), b: minus_zero(), expected: Less)
}

test fn w_signed_zeros_compare_equal() -> Bool  {
  is_ordered_as(a: plus_zero(), b: minus_zero(), expected: Equal)
}

test fn w_infinities_bound_every_finite_value() -> Bool  {
  is_ordered_as(a: max_finite(), b: plus_infinity(), expected: Less)
    && is_ordered_as(a: minus_infinity(), b: minus_one(), expected: Less)
    && is_ordered_as(a: smallest_subnormal(), b: plus_zero(), expected: Greater)
}

test fn w_binding_keyed_on_a_non_kernel_name_refuses() -> Bool  {
  let planted = RustFloatBinding {
    kernel_name: kernel_type_name(name: "Float64"), target_name: "f64", authority: rust_f64_binding.authority,
    radix: 2, mantissa_digits: 53, max_exp: 1024, min_exp: -1021
  }
  match rust_float_binding_verdict(b: planted, denotations: kernel_type_denotation_rows) {
    RustFloatBindingNotAKernelName { name: n } => n == "Float64"
    _ => false
  }
}
