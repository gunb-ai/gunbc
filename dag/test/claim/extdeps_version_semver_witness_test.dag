module test.claim.extdeps_version_semver

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn semver_identity_1_2_3() -> SemVerIdentity { "1.2.3" }
fn semver_constraint_caret() -> SemVerConstraint { "^1.2" }
fn semver_identity_1_0_0() -> SemVerIdentity { "1.0.0" }
fn semver_constraint_one() -> SemVerConstraint { "1" }

fn semver_1_0_0() -> SemVerVersion {
  SemVerVersion {
    major: 1,
    minor: 0,
    patch: 0,
    pre_release: [],
    build: []
  }
}

fn semver_1_0_0_alpha() -> SemVerVersion {
  SemVerVersion {
    major: 1,
    minor: 0,
    patch: 0,
    pre_release: [SemVerAlphanumericIdentifier { label: "alpha" }],
    build: []
  }
}

fn semver_1_0_0_alpha_1() -> SemVerVersion {
  SemVerVersion {
    major: 1,
    minor: 0,
    patch: 0,
    pre_release: [SemVerAlphanumericIdentifier { label: "alpha" }, SemVerNumericIdentifier { value: 1 }],
    build: []
  }
}

fn semver_1_0_0_alpha_0() -> SemVerVersion {
  SemVerVersion {
    major: 1,
    minor: 0,
    patch: 0,
    pre_release: [SemVerNumericIdentifier { value: 0 }, SemVerAlphanumericIdentifier { label: "alpha" }, SemVerNumericIdentifier { value: 1 }],
    build: []
  }
}

fn semver_1_0_0_build_1() -> SemVerVersion {
  SemVerVersion {
    major: 1,
    minor: 0,
    patch: 0,
    pre_release: [],
    build: [SemVerNumericIdentifier { value: 1 }]
  }
}

test fn w_semver_identity_inhabits_version_identity() -> Bool {
  semver_identity_1_2_3() == "1.2.3"
}

test fn w_semver_constraint_inhabits_version_constraint() -> Bool {
  semver_constraint_caret() == "^1.2"
}

test fn w_identity_distinct_from_constraint() -> Bool {
  semver_identity_1_0_0() != semver_constraint_one()
}

test fn w_semver_scheme_equality_compare() -> Bool {
  semver_scheme.compare("1.0.0", "1.0.0") == std.algebra.Equal
}

test fn w_semver_scheme_wire_label_ordering() -> Bool {
  semver_scheme.compare("1.0.0", "2.0.0") == std.algebra.Less
}

test fn w_semver_compare_identifier_numeric_less_than_alphanumeric() -> Bool {
  match semver_compare_identifier(
    a: SemVerNumericIdentifier { value: 1 },
    b: SemVerAlphanumericIdentifier { label: "alpha" }
  ) {
    Less => true
    _ => false
  }
}

test fn w_semver_version_label_core() -> Bool {
  semver_version_label(v: semver_1_0_0()) == "1.0.0"
}

test fn w_semver_version_label_pre_release() -> Bool {
  semver_version_label(v: semver_1_0_0_alpha_0()) == "1.0.0-0.alpha.1"
}

test fn w_semver_version_label_build_ignored_in_compare() -> Bool {
  semver_version_label(v: semver_1_0_0_build_1()) == "1.0.0+1"
    && semver_compare(a: semver_1_0_0(), b: semver_1_0_0_build_1()) == std.algebra.Equal
}

test fn w_semver_compare_pre_release_less_than_release() -> Bool {
  match semver_compare(a: semver_1_0_0_alpha_1(), b: semver_1_0_0()) {
    Less => true
    _ => false
  }
}

test fn w_semver_compare_pre_release_longer_set_greater() -> Bool {
  match semver_compare(a: semver_1_0_0_alpha(), b: semver_1_0_0_alpha_1()) {
    Less =>
      match semver_compare(a: semver_1_0_0_alpha_1(), b: semver_1_0_0_alpha()) {
        Greater => true
        _ => false
      }
    _ => false
  }
}

test fn w_semver_compare_major_minor_patch() -> Bool {
  let older = SemVerVersion { major: 1, minor: 2, patch: 3, pre_release: [], build: [] }
  let newer = SemVerVersion { major: 1, minor: 2, patch: 4, pre_release: [], build: [] }
  match semver_compare(a: older, b: newer) {
    Less =>
      match semver_compare(a: newer, b: older) {
        Greater => true
        _ => false
      }
    _ => false
  }
}

test fn w_semver_to_version_identity() -> Bool {
  semver_to_version_identity(v: semver_1_0_0()) == "1.0.0"
}

// ---------------------------------------------------------------------------
// SCHEME-LEVEL SEMVER PRECEDENCE — SemVer 2.0.0 §11
// (https://semver.org/#spec-item-11, the rule the module's
// extdeps_external_authority_anchor attests). These pin `semver_scheme.compare`
// — the wire surface a VersionScheme consumer calls — against the cited rule:
// precedence is decided by major, then minor, then patch NUMERICALLY; a
// pre-release version has LOWER precedence than the release; pre-release
// identifiers compare numeric < alphanumeric, numerics numerically, alphanumeric
// lexically in ASCII sort order, and a larger identifier set ranks higher when
// the shared prefix is equal; build metadata is ignored.
// ---------------------------------------------------------------------------

test fn w_semver_scheme_minor_numeric_not_lexical() -> Bool {
  semver_scheme.compare("1.10.0", "1.9.0") == std.algebra.Greater
}

test fn w_semver_scheme_release_above_pre_release() -> Bool {
  semver_scheme.compare("1.0.0", "1.0.0-alpha") == std.algebra.Greater
}

test fn w_semver_scheme_numeric_identifier_lower_than_alphanumeric() -> Bool {
  semver_scheme.compare("1.0.0-9", "1.0.0-2x") == std.algebra.Less
}

test fn w_semver_scheme_numeric_identifiers_compare_numerically() -> Bool {
  semver_scheme.compare("2.0.0-rc.10", "2.0.0-rc.2") == std.algebra.Greater
    && semver_scheme.compare("1.0.0-2", "1.0.0-10") == std.algebra.Less
}

test fn w_semver_scheme_build_metadata_ignored() -> Bool {
  semver_scheme.compare("1.0.0+a", "1.0.0+b") == std.algebra.Equal
}

test fn w_semver_scheme_larger_pre_release_set_greater() -> Bool {
  semver_scheme.compare("1.0.0-alpha.1", "1.0.0-alpha") == std.algebra.Greater
}

// A label produced by the typed model's own serializer must order the way the typed compare
// orders the version it labels.
test fn w_semver_scheme_identity_round_trip_label() -> Bool {
  match semver_compare(a: semver_1_0_0_alpha_1(), b: semver_1_0_0()) {
    Less =>
      semver_scheme.compare(
        semver_to_version_identity(v: semver_1_0_0_alpha_1()),
        semver_to_version_identity(v: semver_1_0_0())
      ) == std.algebra.Less
    _ => false
  }
}

// §11 defines precedence over VALID versions. A label outside the grammar keeps the scheme total
// through the documented lexical fallback, and the fallback is pinned so it cannot drift
// silently.
test fn w_semver_scheme_out_of_grammar_label_refuses_precedence() -> Bool {
  semver_scheme.compare("1.02.3", "1.2.3") == std.algebra.Less
}

