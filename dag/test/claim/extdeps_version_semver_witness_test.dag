module test.claim.extdeps_version_semver

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn semver_identity_1_2_3() -> SemVerIdentity { "1.2.3" }
fn semver_constraint_caret() -> SemVerConstraint { "^1.2" }
fn semver_identity_1_0_0() -> SemVerIdentity { "1.0.0" }
fn semver_constraint_one() -> SemVerConstraint { "1" }

fn semver_1_0_0() -> SemVerVersion {
  SemVerVersion {
    major: [49],
    minor: [48],
    patch: [48],
    pre_release: [],
    build: []
  }
}

fn semver_1_0_0_alpha() -> SemVerVersion {
  SemVerVersion {
    major: [49],
    minor: [48],
    patch: [48],
    pre_release: [SemVerAlphanumericIdentifier { label: "alpha" }],
    build: []
  }
}

fn semver_1_0_0_alpha_1() -> SemVerVersion {
  SemVerVersion {
    major: [49],
    minor: [48],
    patch: [48],
    pre_release: [SemVerAlphanumericIdentifier { label: "alpha" }, SemVerNumericIdentifier { digits: [49] }],
    build: []
  }
}

fn semver_1_0_0_alpha_0() -> SemVerVersion {
  SemVerVersion {
    major: [49],
    minor: [48],
    patch: [48],
    pre_release: [SemVerNumericIdentifier { digits: [48] }, SemVerAlphanumericIdentifier { label: "alpha" }, SemVerNumericIdentifier { digits: [49] }],
    build: []
  }
}

fn semver_1_0_0_build_1() -> SemVerVersion {
  SemVerVersion {
    major: [49],
    minor: [48],
    patch: [48],
    pre_release: [],
    build: [SemVerNumericIdentifier { digits: [49] }]
  }
}

test fn w_semver_identity_inhabits_version_identity() -> Bool {
  semver_identity_1_2_3() == "1.2.3"
}

test fn w_semver_constraint_inhabits_version_constraint() -> Bool {
  semver_constraint_caret() == "^1.2"
}

test fn w_identity_distinct_from_constraint() -> Bool {
  semver_identity_1_0_0() != semver_constraint_one()
}

test fn w_semver_scheme_equality_compare() -> Bool {
  match semver_scheme.compare("1.0.0", "1.0.0") {
    VersionCompared { ordering: v } => v == std.algebra.Equal
    VersionComparisonRefused { side: _, identity: _, cause: _ } => false
  }
}

test fn w_semver_scheme_wire_label_ordering() -> Bool {
  match semver_scheme.compare("1.0.0", "2.0.0") {
    VersionCompared { ordering: v } => v == std.algebra.Less
    VersionComparisonRefused { side: _, identity: _, cause: _ } => false
  }
}

test fn w_semver_compare_identifier_numeric_less_than_alphanumeric() -> Bool {
  match semver_compare_identifier(
    a: SemVerNumericIdentifier { digits: [49] },
    b: SemVerAlphanumericIdentifier { label: "alpha" }
  ) {
    Less => true
    _ => false
  }
}

test fn w_semver_version_label_core() -> Bool {
  semver_version_label(v: semver_1_0_0()) == "1.0.0"
}

test fn w_semver_version_label_pre_release() -> Bool {
  semver_version_label(v: semver_1_0_0_alpha_0()) == "1.0.0-0.alpha.1"
}

test fn w_semver_version_label_build_ignored_in_compare() -> Bool {
  semver_version_label(v: semver_1_0_0_build_1()) == "1.0.0+1"
    && semver_compare(a: semver_1_0_0(), b: semver_1_0_0_build_1()) == std.algebra.Equal
}

test fn w_semver_compare_pre_release_less_than_release() -> Bool {
  match semver_compare(a: semver_1_0_0_alpha_1(), b: semver_1_0_0()) {
    Less => true
    _ => false
  }
}

test fn w_semver_compare_pre_release_longer_set_greater() -> Bool {
  match semver_compare(a: semver_1_0_0_alpha(), b: semver_1_0_0_alpha_1()) {
    Less =>
      match semver_compare(a: semver_1_0_0_alpha_1(), b: semver_1_0_0_alpha()) {
        Greater => true
        _ => false
      }
    _ => false
  }
}

test fn w_semver_compare_major_minor_patch() -> Bool {
  let older = SemVerVersion { major: [49], minor: [50], patch: [51], pre_release: [], build: [] }
  let newer = SemVerVersion { major: [49], minor: [50], patch: [52], pre_release: [], build: [] }
  match semver_compare(a: older, b: newer) {
    Less =>
      match semver_compare(a: newer, b: older) {
        Greater => true
        _ => false
      }
    _ => false
  }
}

test fn w_semver_to_version_identity() -> Bool {
  semver_to_version_identity(v: semver_1_0_0()) == "1.0.0"
}

// ---------------------------------------------------------------------------
// SCHEME-LEVEL SEMVER PRECEDENCE — SemVer 2.0.0 §11
// (https://semver.org/#spec-item-11, the rule the module's
// extdeps_external_authority_anchor attests). These pin `semver_scheme.compare`
// — the wire surface a VersionScheme consumer calls — against the cited rule:
// precedence is decided by major, then minor, then patch NUMERICALLY; a
// pre-release version has LOWER precedence than the release; pre-release
// identifiers compare numeric < alphanumeric, numerics numerically, alphanumeric
// lexically in ASCII sort order, and a larger identifier set ranks higher when
// the shared prefix is equal; build metadata is ignored.
// ---------------------------------------------------------------------------

test fn w_semver_scheme_minor_numeric_not_lexical() -> Bool {
  match semver_scheme.compare("1.10.0", "1.9.0") {
    VersionCompared { ordering: v } => v == std.algebra.Greater
    VersionComparisonRefused { side: _, identity: _, cause: _ } => false
  }
}

test fn w_semver_scheme_release_above_pre_release() -> Bool {
  match semver_scheme.compare("1.0.0", "1.0.0-alpha") {
    VersionCompared { ordering: v } => v == std.algebra.Greater
    VersionComparisonRefused { side: _, identity: _, cause: _ } => false
  }
}

test fn w_semver_scheme_numeric_identifier_lower_than_alphanumeric() -> Bool {
  match semver_scheme.compare("1.0.0-9", "1.0.0-2x") {
    VersionCompared { ordering: v } => v == std.algebra.Less
    VersionComparisonRefused { side: _, identity: _, cause: _ } => false
  }
}

test fn w_semver_scheme_numeric_identifiers_compare_numerically() -> Bool {
  match semver_scheme.compare("2.0.0-rc.10", "2.0.0-rc.2") {
    VersionCompared { ordering: v } => v == std.algebra.Greater
    VersionComparisonRefused { side: _, identity: _, cause: _ } => false
  }
}

test fn w_semver_scheme_numeric_identifiers_compare_numerically_wide() -> Bool {
  match semver_scheme.compare("1.0.0-2", "1.0.0-10") {
    VersionCompared { ordering: v } => v == std.algebra.Less
    VersionComparisonRefused { side: _, identity: _, cause: _ } => false
  }
}

test fn w_semver_scheme_build_metadata_ignored() -> Bool {
  match semver_scheme.compare("1.0.0+a", "1.0.0+b") {
    VersionCompared { ordering: v } => v == std.algebra.Equal
    VersionComparisonRefused { side: _, identity: _, cause: _ } => false
  }
}

test fn w_semver_scheme_larger_pre_release_set_greater() -> Bool {
  match semver_scheme.compare("1.0.0-alpha.1", "1.0.0-alpha") {
    VersionCompared { ordering: v } => v == std.algebra.Greater
    VersionComparisonRefused { side: _, identity: _, cause: _ } => false
  }
}

// A label produced by the typed model's own serializer must order the way the typed compare
// orders the version it labels.
test fn w_semver_scheme_identity_round_trip_label() -> Bool {
  match semver_compare(a: semver_1_0_0_alpha_1(), b: semver_1_0_0()) {
    Less =>
      match semver_scheme.compare(
        semver_to_version_identity(v: semver_1_0_0_alpha_1()),
        semver_to_version_identity(v: semver_1_0_0())
      ) {
        VersionCompared { ordering: v } => v == std.algebra.Less
        VersionComparisonRefused { side: _, identity: _, cause: _ } => false
      }
    _ => false
  }
}

// §11 defines precedence over VALID versions, so a label outside the §2 grammar is a LOCATED
// refusal: the carrier names the failing side, the label, and the cause. The refusal itself is
// pinned: the scheme must not fabricate an order for a pair the grammar does not cover.
test fn w_semver_scheme_out_of_grammar_label_refuses_precedence() -> Bool {
  match semver_scheme.compare("1.02.3", "1.2.3") {
    VersionComparisonRefused { side: side, identity: i, cause: _ } => side == LeftOperand && i == "1.02.3"
    VersionCompared { ordering: _ } => false
  }
}


// §9: "Numeric identifiers MUST NOT include leading zeroes." An all-digit pre-release identifier
// with a leading zero is neither numeric (§9) nor alphanumeric (the §2 grammar requires an
// alphanumeric identifier to contain a non-digit), so the LABEL is out of grammar: it must refuse,
// never rank lexically under the numeric-identifier-vs-alphanumeric rule of §11.
test fn w_semver_pre_release_leading_zero_numeric_label_refuses() -> Bool {
  match semver_scheme.compare("1.0.0-01", "1.0.0-1") {
    VersionComparisonRefused { side: side, identity: i, cause: _ } => side == LeftOperand && i == "1.0.0-01"
    VersionCompared { ordering: _ } => false
  }
}

// The refusal's cause is HONEST: it names the grammar, not a specific defect the label may not
// have ("1.02.3" fails on the core minor field, not on a pre-release identifier — a cause
// claiming a leading-zero pre-release identifier would be fabricated).
test fn w_semver_refusal_cause_names_the_grammar_not_a_specific_defect() -> Bool {
  match semver_scheme.compare("1.02.3", "1.2.3") {
    VersionComparisonRefused { side: _, identity: _, cause: c } =>
      c == "label does not satisfy the SemVer 2.0.0 version grammar, so section 11 precedence is undefined for it"
    VersionCompared { ordering: _ } => false
  }
}

// §10 permits leading zeroes in build metadata ("1.0.0+0130"), so the permissive arm must keep
// parsing them; the pre-release refusal must not leak into build identifiers. Build is ignored
// by §11, so the pair is Equal.
test fn w_semver_build_leading_zero_identifier_still_parses() -> Bool {
  match semver_scheme.compare("1.0.0+0130", "1.0.0") {
    VersionCompared { ordering: v } => v == Equal
    VersionComparisonRefused { side: _, identity: _, cause: _ } => false
  }
}

// §2 is X.Y.Z with no trailing delimiter: "1.2.3." must refuse, never lose the dot and rank.
// The old last-field handling split on the dot first and recursed onto the empty suffix, so
// the dot vanished and the label ranked as 1.2.3 — a fabricated order for an out-of-grammar
// label (review 76945). The repair makes the last field consume the whole remainder, so the
// leftover delimiter fails the numeric run.
test fn w_semver_core_refuses_trailing_delimiter_label() -> Bool {
  match semver_scheme.compare("1.2.3.", "1.2.3") {
    VersionComparisonRefused { side: side, identity: i, cause: _ } =>
      side == LeftOperand && i == "1.2.3."
    VersionCompared { ordering: _ } => false
  }
}

// A numeric field must refuse at the STEP that crosses the Int bound, through
// std.checked_arithmetic's authority — not wrap first and hope the Nat check notices. The
// old unchecked accumulation wrapped 20 nines into a small positive Int that passed
// checked_int_to_nat and minted a wrong precedence (review 76945); under the repair this
// label refuses, so no ordering can be fabricated from it.
// A numeric component has NO size limit in section 2 or 9, so a 20-nines field is a valid
// label, not an out-of-grammar one: it must compare by its digits, at any width (side chat
// review 5427723272). The comparison path carries digits as code points — length is the
// magnitude, then ASCII digit order — so no machine-integer conversion can refuse or wrap it.
test fn w_semver_core_wide_numeric_field_compares_numerically() -> Bool {
  match semver_scheme.compare("1.99999999999999999999.0", "1.2.0") {
    VersionCompared { ordering: Greater } => true
    _ => false
  }
}

// The same no-limit rule for numeric pre-release identifiers: 99999999999999999999 is a valid
// numeric identifier and must rank above 1.0.0-2.
test fn w_pre_release_wide_numeric_identifier_compares_numerically() -> Bool {
  match semver_scheme.compare("1.0.0-99999999999999999999", "1.0.0-2") {
    VersionCompared { ordering: Greater } => true
    _ => false
  }
}

// Build metadata is validated text with no numeric conversion on any path: a 20-nines build
// identifier parses, and since section 10 is ignored by the precedence, the label compares
// Equal to the bare version.
test fn w_build_wide_numeric_identifier_is_valid_and_ignored() -> Bool {
  match semver_scheme.compare("1.0.0+99999999999999999999", "1.0.0") {
    VersionCompared { ordering: Equal } => true
    _ => false
  }
}
