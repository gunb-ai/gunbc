module test.claim.dispatch_credential_snapshot_seal_witness

import std.types { Bool, Int, String }
import gunbc.compile_census_probe { blocking_subject_count_for, total_blocking_count_for }

// A TAKEN CREDENTIAL SNAPSHOT IS EARNED BY THE TAKE AND CANNOT BE SPELLED. gunbc.dispatch_credential_snapshot
// TakenCredentialSnapshot is sole_constructor, and the Claude and Cursor launch builders take it rather
// than a path, so a module that wants a launch for a snapshot no take wrote has to spell the record --
// as a literal, as a cast, or nested inside the carrier the selection hands to the spawn -- and each
// spelling is a located compile refusal. Each RED asserts EXACTLY ONE refusal on the subject; the GREEN
// asserts that a foreign module carrying a taken snapshot from the take's result to the carrier draws
// ZERO refusals on the subject (a census that did not run answers -1, never 0) and adds no blocking
// diagnostic of its own. The census counts the whole compile, imported closure included
// (gunbc.compile_diagnostic_census CompileDiagnosticCensus), so "of its own" is a comparison against
// a baseline module importing the same closure and doing nothing, never a total against zero. So the
// seal refuses the forgeries and not the legitimate route. The carrier is a record, not a coproduct
// variant, because variant construction does not reach the seed's sole_constructor check
// (test.claim.sole_constructor_completeness_audit_probe_test f13).

fn seal_violations(source: String) -> Int {
  blocking_subject_count_for(source: source, wanted_class: "SoleConstructorViolation", wanted_subject: "TakenCredentialSnapshot")
}

data forged_literal_source: String = "module probe_snapshot_forged_literal\nimport std.types { NonEmptyStr }\nimport gunbc.dispatch_credential_snapshot { TakenCredentialSnapshot, CredentialSnapshotSubject }\nfn forged(s: CredentialSnapshotSubject, p: NonEmptyStr) -> TakenCredentialSnapshot {\n  TakenCredentialSnapshot { subject: s, path: p }\n}\n"

data forged_cast_source: String = "module probe_snapshot_forged_cast\nimport std.types { NonEmptyStr }\nimport gunbc.dispatch_credential_snapshot { TakenCredentialSnapshot }\nfn forged(p: NonEmptyStr) -> TakenCredentialSnapshot {\n  p as TakenCredentialSnapshot\n}\n"

data forged_nested_source: String = "module probe_snapshot_forged_nested\nimport std.types { NonEmptyStr }\nimport gunbc.dispatch_credential_snapshot { TakenCredentialSnapshot, CredentialSnapshotSubject, AttemptCredentialSnapshot, CredentialSnapshotHeld }\nfn forged(s: CredentialSnapshotSubject, p: NonEmptyStr) -> AttemptCredentialSnapshot {\n  CredentialSnapshotHeld { snapshot: TakenCredentialSnapshot { subject: s, path: p } }\n}\n"

data lawful_carry_source: String = "module probe_snapshot_lawful_carry\nimport std.types { NonEmptyStr }\nimport std.optional { Present }\nimport gunbc.dispatch_credential_snapshot { CredentialSnapshotSubject, DispatchCredentialSnapshot, DispatchSnapshotTaken, DispatchSnapshotRefused, AttemptCredentialSnapshot, CredentialSnapshotHeld, NoCredentialSnapshot, dispatch_credential_snapshot_take, taken_credential_snapshot_path }\nfn carried(subject: CredentialSnapshotSubject, source: NonEmptyStr, snapshot: NonEmptyStr) -> AttemptCredentialSnapshot {\n  match dispatch_credential_snapshot_take(subject: subject, source: source, snapshot: snapshot) {\n    DispatchSnapshotTaken { snapshot: s } => CredentialSnapshotHeld { snapshot: s }\n    DispatchSnapshotRefused { reason: _ } => NoCredentialSnapshot\n  }\n}\nfn path_of(d: DispatchCredentialSnapshot) -> NonEmptyStr? {\n  match d {\n    DispatchSnapshotTaken { snapshot: s } => Present { value: taken_credential_snapshot_path(snapshot: s) }\n    DispatchSnapshotRefused { reason: _ } => none\n  }\n}\n"

test fn a_forged_snapshot_literal_is_refused_at_compile() -> Bool {
  seal_violations(source: forged_literal_source) == 1
}

test fn a_forged_snapshot_cast_is_refused_at_compile() -> Bool {
  seal_violations(source: forged_cast_source) == 1
}

test fn a_forged_snapshot_nested_in_the_selection_carrier_is_refused_at_compile() -> Bool {
  seal_violations(source: forged_nested_source) == 1
}

data closure_baseline_source: String = "module probe_snapshot_closure_baseline\nimport std.types { NonEmptyStr }\nimport std.optional { Present }\nimport gunbc.dispatch_credential_snapshot { CredentialSnapshotSubject }\nfn baseline(s: CredentialSnapshotSubject, p: NonEmptyStr) -> NonEmptyStr? {\n  Present { value: p }\n}\n"

test fn a_foreign_module_carrying_a_taken_snapshot_is_not_refused_by_the_seal() -> Bool {
  let baseline = total_blocking_count_for(source: closure_baseline_source)
  seal_violations(source: lawful_carry_source) == 0
    && baseline >= 0
    && total_blocking_count_for(source: lawful_carry_source) == baseline
}
