module test.claim.secret_provision_actuator_witness

import std.types { Bool, String, NonEmptyStr }
import extdeps.crypto.hash { Digest, Sha256, Sha512, sha256_digest, sha512_digest }
import extdeps.cloud.gcp.secret_manager { SmResolvedVersionIdentity }
import gunbc.secret_provision_actuator {
  created_resource_names_requested_secret,
  checked_digest, creation_may_be_retried, creation_outcome_name,
  SecretCreationRefused, SecretCreationOutcomeUnknown,
  addition_may_be_retried, addition_outcome_name,
  VersionAdditionRefused, VersionAdditionOutcomeUnknown, VersionAddedButUnverified,
}

// sha256sum's wrapper never validates the hex it prints, so this guard is the only wall between a
// malformed line and a digest the whole provisioning chain will treat as an identity.
test fn a_malformed_hex_is_not_a_sha256_identity() -> Bool {
  match checked_digest(observed: sha256_digest(hex: "not-a-digest" as NonEmptyStr)) {
    Absent => true
    Present { value: _ } => false
  }
}

test fn a_well_formed_sha256_hex_is_accepted() -> Bool {
  match checked_digest(
    observed: sha256_digest(
      hex: "3b1f8c2ad4e5906172b83c4de5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718" as NonEmptyStr),
  ) {
    Absent => false
    Present { value: _ } => true
  }
}

// A SHA-512 digest is well-formed and is still not this identity; the arm is guarded rather than
// assumed precisely so a widened producer cannot become a silent mis-identity.
test fn a_sha512_digest_is_refused_even_though_it_is_well_formed() -> Bool {
  match checked_digest(
    observed: sha512_digest(
      hex: "3b1f8c2ad4e5906172b83c4de5f60718293a4b5c6d7e8f90a1b2c3d4e5f607183b1f8c2ad4e5906172b83c4de5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718" as NonEmptyStr),
  ) {
    Absent => true
    Present { value: _ } => false
  }
}

// The arm a caller is most tempted to fold into failure is the one that must never be retried: a
// CreateSecret whose outcome is unknown may already have landed at the service.
test fn an_unknown_creation_outcome_is_never_retried() -> Bool {
  creation_may_be_retried(o: SecretCreationOutcomeUnknown { cause: "no response arrived" as NonEmptyStr }) == false
    && creation_may_be_retried(o: SecretCreationRefused { cause: "permission denied" as NonEmptyStr }) == true
}

test fn creation_outcome_arms_stay_distinct() -> Bool {
  creation_outcome_name(o: SecretCreationRefused { cause: "x" as NonEmptyStr }) == "refused"
    && creation_outcome_name(o: SecretCreationOutcomeUnknown { cause: "x" as NonEmptyStr }) == "unknown"
}

// A version that LANDED and then failed its read-back is the most dangerous arm to collapse into
// failure: the version exists and holds content this attempt did not intend, so writing again would
// add a second wrong version on top of the first.
test fn a_version_that_landed_but_failed_verification_is_never_retried() -> Bool {
  addition_may_be_retried(
    o: VersionAddedButUnverified {
      version: "projects/p/secrets/s/versions/1" as SmResolvedVersionIdentity,
      cause: "read-back payload differed" as NonEmptyStr,
    },
  ) == false
}

// And only the arm whose cause the caller can address is retryable, so the predicate discriminates
// rather than answering false for everything.
test fn only_a_refused_addition_may_be_retried() -> Bool {
  addition_may_be_retried(o: VersionAdditionRefused { cause: "permission denied" as NonEmptyStr }) == true
    && addition_may_be_retried(o: VersionAdditionOutcomeUnknown { cause: "no response" as NonEmptyStr }) == false
    && addition_outcome_name(o: VersionAdditionOutcomeUnknown { cause: "x" as NonEmptyStr }) == "unknown"
}

// A RESOURCE FOR THE REQUESTED SECRET IS ACCEPTED, and a resource for a NEIGHBOURING secret is not.
// The second is the discriminating case: "printer-01-lan-access-code" is a prefix of nothing here,
// but a suffix check that compared bare ids rather than the "/secrets/" segment would accept
// ".../secrets/not-printer-02-lan-access-code" for "printer-02-lan-access-code", so the arm below
// exists to keep that spelling of the check red.
fn the_requested_secrets_own_resource_is_accepted() -> Bool {
  created_resource_names_requested_secret(
    name: "projects/gunbai-secrets/secrets/printer-02-lan-access-code",
    secret_id: "printer-02-lan-access-code" as NonEmptyStr)
}

fn a_resource_for_a_different_secret_is_refused() -> Bool {
  created_resource_names_requested_secret(
    name: "projects/gunbai-secrets/secrets/printer-01-lan-access-code",
    secret_id: "printer-02-lan-access-code" as NonEmptyStr) == false
}

fn a_secret_whose_id_merely_ends_with_the_requested_one_is_refused() -> Bool {
  created_resource_names_requested_secret(
    name: "projects/gunbai-secrets/secrets/not-printer-02-lan-access-code",
    secret_id: "printer-02-lan-access-code" as NonEmptyStr) == false
}
