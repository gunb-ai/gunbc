module test.claim.secret_provision_actuator_witness

import std.types { Bool, String, NonEmptyStr }
import extdeps.crypto.hash { Digest, Sha256, Sha512, sha256_digest, sha512_digest }
import gunbc.secret_provision_actuator {
  checked_digest, creation_may_be_retried, creation_outcome_name,
  SecretCreationRefused, SecretCreationOutcomeUnknown,
}

// sha256sum's wrapper never validates the hex it prints, so this guard is the only wall between a
// malformed line and a digest the whole provisioning chain will treat as an identity.
test fn a_malformed_hex_is_not_a_sha256_identity() -> Bool {
  match checked_digest(observed: sha256_digest(hex: "not-a-digest" as NonEmptyStr)) {
    Absent => true
    Present { value: _ } => false
  }
}

test fn a_well_formed_sha256_hex_is_accepted() -> Bool {
  match checked_digest(
    observed: sha256_digest(
      hex: "3b1f8c2ad4e5906172b83c4de5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718" as NonEmptyStr),
  ) {
    Absent => false
    Present { value: _ } => true
  }
}

// A SHA-512 digest is well-formed and is still not this identity; the arm is guarded rather than
// assumed precisely so a widened producer cannot become a silent mis-identity.
test fn a_sha512_digest_is_refused_even_though_it_is_well_formed() -> Bool {
  match checked_digest(
    observed: sha512_digest(
      hex: "3b1f8c2ad4e5906172b83c4de5f60718293a4b5c6d7e8f90a1b2c3d4e5f607183b1f8c2ad4e5906172b83c4de5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718" as NonEmptyStr),
  ) {
    Absent => true
    Present { value: _ } => false
  }
}

// The arm a caller is most tempted to fold into failure is the one that must never be retried: a
// CreateSecret whose outcome is unknown may already have landed at the service.
test fn an_unknown_creation_outcome_is_never_retried() -> Bool {
  creation_may_be_retried(o: SecretCreationOutcomeUnknown { cause: "no response arrived" as NonEmptyStr }) == false
    && creation_may_be_retried(o: SecretCreationRefused { cause: "permission denied" as NonEmptyStr }) == true
}

test fn creation_outcome_arms_stay_distinct() -> Bool {
  creation_outcome_name(o: SecretCreationRefused { cause: "x" as NonEmptyStr }) == "refused"
    && creation_outcome_name(o: SecretCreationOutcomeUnknown { cause: "x" as NonEmptyStr }) == "unknown"
}
