module test.claim.keyed_roster_witness

import std.keyed_row { KeyedRow }
import std.key_relation { SubjectKey }
import std.change { keyed_merge_row_lists }
import std.keyed_roster {
  KeyedRosterBuildDuplicateKey,
  KeyedRosterBuilt,
  KeyedRosterDuplicateKey,
  KeyedRosterInserted,
  KeyedRosterInvalidRoster,
  keyed_roster_build,
  keyed_roster_index,
  keyed_roster_index_operations,
  keyed_roster_index_occurrences,
  keyed_roster_locate_duplicate,
  keyed_roster_distinct,
  keyed_roster_duplicated,
  keyed_roster_contains,
  keyed_roster_insert,
  keyed_roster_locate_duplicate,
  keyed_roster_union,
}
import std.optional { Absent, Present }
import std.roster_frontier { FrontierRow, PathSubject, decl_field_ref, decl_ref, frontier_row_decl, frontier_rows_keyed_roster_build, frontier_rows_well_formed }
import std.dissolution { unbound_dissolution }
import std.types { Bool, String, List }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// Lane 4 witnesses (generated-file conflict policy charter,
// docs/plans/generated-file-conflict-policy.md on session/crisp-bat-830): construction refuses a
// repeated path key with a typed KeyedRosterDuplicateKey / KeyedRosterBuildDuplicateKey carrying
// key + both colliding rows (located, not a bare Bool). keyed_roster_union models the git
// clean-merge failure mode: two branches each append disjoint rows admit; overlapping path keys
// refuse. keyed_merge_row_lists is the deliberate contrast (silent first-wins, reconcile grain).
// Per-PR admission: enrolled on commit_gate_roster (GithubActionsCiJob) plus affected-set discovery
// when dag/std/ or enrolled roster carriers change.

type FixtureGrant {
  path: String
  audience: String
}

fn fixture_grant(path: String, audience: String) -> FixtureGrant {
  FixtureGrant { path: path, audience: audience }
}

fn fixture_key_eq(a: SubjectKey<String>, b: SubjectKey<String>) -> Bool {
  a == b
}

fn fixture_row(path: String, audience: String) -> KeyedRow<SubjectKey<String>, FixtureGrant> {
  KeyedRow {
    row_key: SubjectKey { subject: path },
    value: fixture_grant(path: path, audience: audience),
  }
}

fn fixture_rows_unique() -> List<KeyedRow<SubjectKey<String>, FixtureGrant>> {
  [
    fixture_row(path: "dag/gunbc/a.dag", audience: "repo"),
    fixture_row(path: "dag/gunbc/b.dag", audience: "repo"),
  ]
}

fn fixture_rows_duplicate_path() -> List<KeyedRow<SubjectKey<String>, FixtureGrant>> {
  [
    fixture_row(path: "dag/gunbc/publication_grant.dag", audience: "world"),
    fixture_row(path: "dag/gunbc/publication_grant.dag", audience: "repo"),
  ]
}

fn fixture_frontier_rows_unique() -> List<FrontierRow> {
  [
    FrontierRow {
      subject: PathSubject { path: "synthetic/a.dag::f" },
      reason: "r1",
      dissolution: unbound_dissolution(description: "d1"),
    },
    FrontierRow {
      subject: PathSubject { path: "synthetic/b.dag::g" },
      reason: "r2",
      dissolution: unbound_dissolution(description: "d2"),
    },
  ]
}

fn fixture_frontier_rows_duplicate_path() -> List<FrontierRow> {
  [
    FrontierRow {
      subject: PathSubject { path: "synthetic/a.dag::f" },
      reason: "r1",
      dissolution: unbound_dissolution(description: "d1"),
    },
    FrontierRow {
      subject: PathSubject { path: "synthetic/a.dag::f" },
      reason: "r2",
      dissolution: unbound_dissolution(description: "d2"),
    },
  ]
}

fn fixture_branch_a_rows() -> List<KeyedRow<SubjectKey<String>, FixtureGrant>> {
  [
    fixture_row(path: "dag/gunbc/alpha.dag", audience: "world"),
    fixture_row(path: "dag/gunbc/beta.dag", audience: "world"),
  ]
}

fn fixture_branch_b_disjoint_rows() -> List<KeyedRow<SubjectKey<String>, FixtureGrant>> {
  [
    fixture_row(path: "dag/gunbc/gamma.dag", audience: "repo"),
    fixture_row(path: "dag/gunbc/delta.dag", audience: "repo"),
  ]
}

fn fixture_branch_b_overlap_rows() -> List<KeyedRow<SubjectKey<String>, FixtureGrant>> {
  [
    fixture_row(path: "dag/gunbc/alpha.dag", audience: "repo"),
    fixture_row(path: "dag/gunbc/epsilon.dag", audience: "repo"),
  ]
}

test fn keyed_roster_two_branch_union_disjoint_keys_admits() -> Bool {
  match keyed_roster_union(
    left: fixture_branch_a_rows(),
    right: fixture_branch_b_disjoint_rows()) {
    KeyedRosterBuilt { rows: _ } => true
    KeyedRosterBuildDuplicateKey { key: _, first: _, duplicate: _ } => false
  }
}

test fn keyed_roster_two_branch_union_overlap_refuses_red_control() -> Bool {
  match keyed_roster_union(
    left: fixture_branch_a_rows(),
    right: fixture_branch_b_overlap_rows()) {
    KeyedRosterBuilt { rows: _ } => false
    KeyedRosterBuildDuplicateKey { key: _, first: _, duplicate: _ } => true
  }
}

test fn keyed_roster_two_branch_union_locates_overlap() -> Bool {
  match keyed_roster_union(
    left: fixture_branch_a_rows(),
    right: fixture_branch_b_overlap_rows()) {
    KeyedRosterBuildDuplicateKey { key: k, first: f, duplicate: d } =>
      k.subject == "dag/gunbc/alpha.dag"
        && f.value.audience == "world"
        && d.value.audience == "repo"
    KeyedRosterBuilt { rows: _ } => false
  }
}

test fn keyed_roster_build_admits_unique_paths() -> Bool {
  match keyed_roster_build(incomings: fixture_rows_unique()) {
    KeyedRosterBuilt { rows: _ } => true
    KeyedRosterBuildDuplicateKey { key: _, first: _, duplicate: _ } => false
  }
}

test fn keyed_roster_build_refuses_duplicate_path_red_control() -> Bool {
  match keyed_roster_build(incomings: fixture_rows_duplicate_path()) {
    KeyedRosterBuilt { rows: _ } => false
    KeyedRosterBuildDuplicateKey { key: _, first: _, duplicate: _ } => true
  }
}

test fn keyed_roster_insert_refuses_second_same_path() -> Bool {
  let first = fixture_row(path: "dag/gunbc/x.dag", audience: "repo")
  let second = fixture_row(path: "dag/gunbc/x.dag", audience: "world")
  match keyed_roster_insert(rows: [first], incoming: second) {
    KeyedRosterInserted { rows: _ } => false
    KeyedRosterDuplicateKey { key: _, existing: _, incoming: _ } => true
    KeyedRosterInvalidRoster { key: _, first: _, duplicate: _ } => false
  }
}

test fn keyed_roster_insert_admits_distinct_paths() -> Bool {
  let first = fixture_row(path: "dag/gunbc/x.dag", audience: "repo")
  let second = fixture_row(path: "dag/gunbc/y.dag", audience: "world")
  match keyed_roster_insert(rows: [first], incoming: second) {
    KeyedRosterInserted { rows: _ } => true
    KeyedRosterDuplicateKey { key: _, existing: _, incoming: _ } => false
    KeyedRosterInvalidRoster { key: _, first: _, duplicate: _ } => false
  }
}

test fn frontier_rows_keyed_build_admits_distinct_decl_fields() -> Bool {
  match frontier_rows_keyed_roster_build(
    rows: [
      frontier_row_decl(
        ref: decl_ref(module_path: "synthetic.mod", decl_name: "HostConfig"),
        reason: "whole-decl row",
        dissolution: unbound_dissolution(description: "d1"),
      ),
      frontier_row_decl(
        ref: decl_field_ref(
          module_path: "synthetic.mod",
          decl_name: "HostConfig",
          field_name: "memory_swap",
        ),
        reason: "field-level row",
        dissolution: unbound_dissolution(description: "d2"),
      ),
    ],
  ) {
    KeyedRosterBuilt { rows: _ } => true
    KeyedRosterBuildDuplicateKey { key: _, first: _, duplicate: _ } => false
  }
}

test fn frontier_rows_keyed_build_admits_distinct_paths() -> Bool {
  match frontier_rows_keyed_roster_build(rows: fixture_frontier_rows_unique()) {
    KeyedRosterBuilt { rows: _ } => true
    KeyedRosterBuildDuplicateKey { key: _, first: _, duplicate: _ } => false
  }
}

test fn frontier_rows_keyed_build_refuses_duplicate_path_red_control() -> Bool {
  match frontier_rows_keyed_roster_build(rows: fixture_frontier_rows_duplicate_path()) {
    KeyedRosterBuilt { rows: _ } => false
    KeyedRosterBuildDuplicateKey { key: _, first: _, duplicate: _ } => true
  }
}

test fn frontier_rows_keyed_build_requires_well_formed_and_unique() -> Bool {
  frontier_rows_well_formed(rows: fixture_frontier_rows_unique())
    && match frontier_rows_keyed_roster_build(rows: fixture_frontier_rows_unique()) {
      KeyedRosterBuilt { rows: _ } => true
      KeyedRosterBuildDuplicateKey { key: _, first: _, duplicate: _ } => false
    }
    && match frontier_rows_keyed_roster_build(rows: fixture_frontier_rows_duplicate_path()) {
      KeyedRosterBuilt { rows: _ } => false
      KeyedRosterBuildDuplicateKey { key: _, first: _, duplicate: _ } => true
    }
}

test fn merge_row_lists_silently_skips_duplicate_contrast_control() -> Bool {
  let left = fixture_rows_unique()
  let right = [fixture_row(path: "dag/gunbc/a.dag", audience: "other")]
  let merged = keyed_merge_row_lists(left: left, right: right, key_eq: fixture_key_eq)
  length(xs: merged) == 2
    && match keyed_roster_build(incomings: concat(left, right)) {
      KeyedRosterBuilt { rows: _ } => false
      KeyedRosterBuildDuplicateKey { key: _, first: _, duplicate: _ } => true
    }
}

test fn keyed_roster_build_locates_first_duplicate() -> Bool {
  match keyed_roster_build(incomings: fixture_rows_duplicate_path()) {
    KeyedRosterBuildDuplicateKey { key: k, first: f, duplicate: d } =>
      k.subject == "dag/gunbc/publication_grant.dag"
        && f.value.audience == "world"
        && d.value.audience == "repo"
    KeyedRosterBuilt { rows: _ } => false
  }
}

test fn keyed_roster_insert_locates_duplicate() -> Bool {
  let existing = fixture_row(path: "dag/gunbc/x.dag", audience: "repo")
  let incoming = fixture_row(path: "dag/gunbc/x.dag", audience: "world")
  match keyed_roster_insert(rows: [existing], incoming: incoming) {
    KeyedRosterDuplicateKey { key: k, existing: e, incoming: i } =>
      k.subject == "dag/gunbc/x.dag" && e.value.audience == "repo" && i.value.audience == "world"
    KeyedRosterInserted { rows: _ } => false
    KeyedRosterInvalidRoster { key: _, first: _, duplicate: _ } => false
  }
}

test fn keyed_roster_insert_refuses_preexisting_duplicate_roster_red_control() -> Bool {
  let incoming = fixture_row(path: "dag/gunbc/new.dag", audience: "repo")
  match keyed_roster_insert(
    rows: fixture_rows_duplicate_path(),
    incoming: incoming) {
    KeyedRosterInserted { rows: _ } => false
    KeyedRosterDuplicateKey { key: _, existing: _, incoming: _ } => false
    KeyedRosterInvalidRoster { key: _, first: _, duplicate: _ } => true
  }
}

test fn keyed_roster_insert_locates_preexisting_duplicate_roster() -> Bool {
  let incoming = fixture_row(path: "dag/gunbc/new.dag", audience: "repo")
  match keyed_roster_insert(
    rows: fixture_rows_duplicate_path(),
    incoming: incoming) {
    KeyedRosterInvalidRoster { key: k, first: f, duplicate: d } =>
      k.subject == "dag/gunbc/publication_grant.dag"
        && f.value.audience == "world"
        && d.value.audience == "repo"
    KeyedRosterInserted { rows: _ } => false
    KeyedRosterDuplicateKey { key: _, existing: _, incoming: _ } => false
  }
}

// ---- K4 pins: locate_duplicate reports the duplicated key with the EARLIEST first occurrence.

fn kr(k: String, tag: String) -> KeyedRow<SubjectKey<String>, FixtureGrant> {
  fixture_row(path: k, audience: tag)
}

test fn locate_duplicate_abba_reports_a_with_first_and_last() -> Bool {
  match keyed_roster_locate_duplicate(rows: [kr(k: "a", tag: "0"), kr(k: "b", tag: "1"), kr(k: "b", tag: "2"), kr(k: "a", tag: "3")]) {
    Present { value: e } => e.key.subject == "a" && e.first.value.audience == "0" && e.duplicate.value.audience == "3"
    Absent => false
  }
}

test fn locate_duplicate_baab_reports_b() -> Bool {
  match keyed_roster_locate_duplicate(rows: [kr(k: "b", tag: "0"), kr(k: "a", tag: "1"), kr(k: "a", tag: "2"), kr(k: "b", tag: "3")]) {
    Present { value: e } => e.key.subject == "b" && e.first.value.audience == "0" && e.duplicate.value.audience == "3"
    Absent => false
  }
}

test fn locate_duplicate_abab_reports_a_second_at_2() -> Bool {
  match keyed_roster_locate_duplicate(rows: [kr(k: "a", tag: "0"), kr(k: "b", tag: "1"), kr(k: "a", tag: "2"), kr(k: "b", tag: "3")]) {
    Present { value: e } => e.key.subject == "a" && e.first.value.audience == "0" && e.duplicate.value.audience == "2"
    Absent => false
  }
}

test fn locate_duplicate_unique_is_absent_red_control() -> Bool {
  match keyed_roster_locate_duplicate(rows: fixture_rows_unique()) {
    Present { value: _ } => false
    Absent => true
  }
}

test fn build_abba_refuses_on_b_the_first_conflicting_insert() -> Bool {
  match keyed_roster_build(incomings: [kr(k: "a", tag: "0"), kr(k: "b", tag: "1"), kr(k: "b", tag: "2"), kr(k: "a", tag: "3")]) {
    KeyedRosterBuildDuplicateKey { key: k, first: f, duplicate: d } =>
      k.subject == "b" && f.value.audience == "1" && d.value.audience == "2"
    KeyedRosterBuilt { rows: _ } => false
  }
}

// ---- Total index: never refuses; order, distinct, duplicated, membership, ALL occurrences.

test fn total_index_three_way_repeat_reports_three_occurrences() -> Bool {
  let index = keyed_roster_index(rows: [kr(k: "a", tag: "0"), kr(k: "b", tag: "1"), kr(k: "a", tag: "2"), kr(k: "a", tag: "3")])
  count(keyed_roster_index_occurrences(index: index, key: SubjectKey { subject: "a" })) == 3
    && count(keyed_roster_index_occurrences(index: index, key: SubjectKey { subject: "b" })) == 1
    && count(keyed_roster_index_occurrences(index: index, key: SubjectKey { subject: "z" })) == 0
    && count(keyed_roster_distinct(index: index)) == 2
    && count(keyed_roster_duplicated(index: index)) == 1
    && keyed_roster_contains(index: index, key: SubjectKey { subject: "b" })
    && !keyed_roster_contains(index: index, key: SubjectKey { subject: "z" })
}

test fn total_index_occurrences_keep_authored_order() -> Bool {
  let index = keyed_roster_index(rows: [kr(k: "a", tag: "0"), kr(k: "a", tag: "1"), kr(k: "a", tag: "2")])
  let occ = keyed_roster_index_occurrences(index: index, key: SubjectKey { subject: "a" })
  count(occ) == 3
    && match occ |> first { Present { value: r } => r.value.audience == "0"  Absent => false }
    && match occ |> reverse |> first { Present { value: r } => r.value.audience == "2"  Absent => false }
}

test fn total_index_duplicated_lists_each_repeating_key_once_in_repeat_order() -> Bool {
  let index = keyed_roster_index(rows: [kr(k: "a", tag: "0"), kr(k: "b", tag: "1"), kr(k: "b", tag: "2"), kr(k: "a", tag: "3"), kr(k: "b", tag: "4")])
  let dups = keyed_roster_duplicated(index: index)
  count(dups) == 2
    && match dups |> first { Present { value: k } => k.subject == "b"  Absent => false }
    && match dups |> reverse |> first { Present { value: k } => k.subject == "a"  Absent => false }
}

test fn total_index_operations_are_linear_in_rows() -> Bool {
  let index = keyed_roster_index(rows: fixture_rows_unique())
  keyed_roster_index_operations(index: index) == 2 + 2 + 2 + 2
}

// ---- INJECTIVITY red: values that collide as display strings stay distinct as SubjectKeys.
test fn subject_key_keeps_path_and_decl_subjects_distinct_though_strings_collide() -> Bool {
  let path_row = FrontierRow {
    subject: PathSubject { path: "a.b::f" },
    reason: "r1",
    dissolution: unbound_dissolution(description: "d1"),
  }
  let decl_row = frontier_row_decl(
    ref: decl_ref(module_path: "a.b", decl_name: "f"),
    reason: "r2",
    dissolution: unbound_dissolution(description: "d2"),
  )
  match frontier_rows_keyed_roster_build(rows: [path_row, decl_row]) {
    KeyedRosterBuilt { rows: _ } => true
    KeyedRosterBuildDuplicateKey { key: _, first: _, duplicate: _ } => false
  }
}

// ---- K2 pins ported to the SubjectKey API (expected values unchanged from #13946).
fn rows_abba() -> List<KeyedRow<SubjectKey<String>, FixtureGrant>> {
  [kr(k: "a", tag: "first"), kr(k: "b", tag: "first"), kr(k: "b", tag: "second"), kr(k: "a", tag: "second")]
}

// (3) a successful build keeps authored order, pinned in both directions.
test fn keyed_roster_build_keeps_authored_order_of_rows() -> Bool {
  match keyed_roster_build(incomings: [kr(k: "a", tag: "repo"), kr(k: "b", tag: "repo")]) {
    KeyedRosterBuilt { rows: rows } =>
      map(rows, r => r.row_key.subject) == ["a", "b"]
        && match keyed_roster_build(incomings: [kr(k: "b", tag: "repo"), kr(k: "a", tag: "repo")]) {
          KeyedRosterBuilt { rows: rows2 } => map(rows2, r => r.row_key.subject) == ["b", "a"]
          KeyedRosterBuildDuplicateKey { key: _, first: _, duplicate: _ } => false
        }
    KeyedRosterBuildDuplicateKey { key: _, first: _, duplicate: _ } => false
  }
}

// (4) a duplicate key is refused even when the colliding VALUES are equal.
test fn keyed_roster_build_refuses_duplicate_key_even_when_values_equal() -> Bool {
  match keyed_roster_build(incomings: [kr(k: "a", tag: "first"), kr(k: "b", tag: "same"), kr(k: "b", tag: "same"), kr(k: "a", tag: "second")]) {
    KeyedRosterBuildDuplicateKey { key: k, first: f, duplicate: d } =>
      k.subject == "b" && f.value.audience == "same" && d.value.audience == "same"
    KeyedRosterBuilt { rows: _ } => false
  }
}

// (5) an already-invalid roster is refused BEFORE the incoming insert is handled (precheck precedes
// the incoming-key lookup), including when the incoming also collides.
test fn keyed_roster_insert_into_already_invalid_roster_refused_before_insert() -> Bool {
  match keyed_roster_insert(rows: rows_abba(), incoming: kr(k: "c", tag: "repo")) {
    KeyedRosterInvalidRoster { key: k, first: _, duplicate: _ } => k.subject == "a"
    KeyedRosterInserted { rows: _ } => false
    KeyedRosterDuplicateKey { key: _, existing: _, incoming: _ } => false
  }
    && match keyed_roster_insert(rows: rows_abba(), incoming: kr(k: "a", tag: "incoming")) {
      KeyedRosterInvalidRoster { key: k, first: _, duplicate: _ } => k.subject == "a"
      KeyedRosterInserted { rows: _ } => false
      KeyedRosterDuplicateKey { key: _, existing: _, incoming: _ } => false
    }
}

// distinct == [a, b], duplicated == [b, a] on the index of [a, b, b, a] (the K2 index facts).
test fn index_of_abba_reports_distinct_ab_and_duplicated_ba() -> Bool {
  let index = keyed_roster_index(rows: rows_abba())
  map(keyed_roster_distinct(index: index), k => k.subject) == ["a", "b"]
    && map(keyed_roster_duplicated(index: index), k => k.subject) == ["b", "a"]
}
