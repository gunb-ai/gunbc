}

// WRONG POSITION: .second of ApPair<Int, String> is String, declared Int at ap_int. Accepted while the projection kept the bare B.
test fn arity_n_red_pair_projection_wrong_position() -> Bool {
  gan_blocking_count(source: gan_red_pair_projection_wrong_position_source) > 0
}

// CALLEE NAMES: the callee spells its parameters X, Y, not the declaration's A, B; the projection must still be String at ap_int.
test fn arity_n_red_pair_projection_renamed_params() -> Bool {
  gan_blocking_count(source: gan_red_pair_projection_renamed_params_source) > 0
}

// NAME CAPTURE: the callee returns ApPair<B, A> over its own A, B, so .first is the callee B (String) and must refuse at ap_int.
test fn arity_n_red_pair_projection_permuted() -> Bool {
  gan_blocking_count(source: gan_red_pair_projection_permuted_source) > 0
}

// CENSUS:1087 SHAPE: a valid program; the alias sits only in the type argument of the ACTUAL xs, compared at an if/else join. Refused while T binds the alias expansion with its arguments lost.
test fn arity_n_red_alias_type_argument_actual() -> Bool {
  gan_blocking_count(source: gan_red_alias_type_argument_actual_source) == 0
}

// DROPPED ALIAS ARGS: IntBox takes no parameters, so IntBox<String> must refuse; the applied arguments must not be dropped silently.
test fn arity_n_red_alias_applied_args_dropped() -> Bool {
  gan_blocking_count(source: gan_red_alias_applied_args_dropped_source) > 0
}

