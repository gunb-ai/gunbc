data gan_cas_closure_source: String = "module arity_probe_mod\n\nimport std.content_hash \{ ContentHash \}\nimport std.durable_compare_and_set \{ CasSlotVersion, CasGeneration \}\nimport gunbc.roadmap.roadmap_event_log \{ RoadmapEventId \}\n\nfn ap_k(x: Int) -> Int \{ x \}\n"

