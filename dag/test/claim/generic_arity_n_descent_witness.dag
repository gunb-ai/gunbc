fn gan_census(source: String) -> CompileDiagnosticCensus {
  compile_dag_diagnostic_census(source)
}

fn gan_unobserved() -> CompileDiagnosticCensus {
  CensusNotRunnable { cause: "no census" as NonEmptyStr }
}

// Both sides observed, then the blocking histograms agree key by key. Anything unobserved is false.
fn gan_same_blocking(base: CompileDiagnosticCensus, other: CompileDiagnosticCensus) -> Bool {
  match base {
    CensusObserved { rows: b } => match other {
      CensusObserved { rows: o } => census_blocking_histograms_equal(a: b, b: o)
      CensusNotRunnable { cause: _ } => false
    }
    CensusNotRunnable { cause: _ } => false
  }
}

// Occurrences of one blocking (class, subject) key added by `red` over `green`.
fn gan_added_at(red: List<CompileDiagnosticCensusRow>, green: List<CompileDiagnosticCensusRow>, class: String, subject: String) -> Int {
  census_count_at_key(rows: red, diagnostic_class: class, subject_name: subject, blocking: true) - census_count_at_key(rows: green, diagnostic_class: class, subject_name: subject, blocking: true)
}

fn gan_added_total(red: List<CompileDiagnosticCensusRow>, green: List<CompileDiagnosticCensusRow>) -> Int {
  census_total_count(rows: census_blocking_rows(rows: red)) - census_total_count(rows: census_blocking_rows(rows: green))
}

// The argument-compatibility refusal of a call: the located DeclaredTypeNotInhabited at the argument for `param`.
fn gan_param_subject(param: String) -> String {
  "direct call argument for parameter '" + param + "'"
}

// Both sides observed; `red` adds exactly one blocking occurrence over `green`, DeclaredTypeNotInhabited at `param`.
fn gan_refused_arg(green: CompileDiagnosticCensus, red: CompileDiagnosticCensus, param: String) -> Bool {
  match green {
    CensusObserved { rows: g } => match red {
      CensusObserved { rows: r } =>
        (gan_added_total(red: r, green: g) == 1)
          && (gan_added_at(red: r, green: g, class: "DeclaredTypeNotInhabited", subject: gan_param_subject(param: param)) == 1)
      CensusNotRunnable { cause: _ } => false
    }
    CensusNotRunnable { cause: _ } => false
  }
}

// As gan_refused_arg, plus the TypeMismatch whose subject is the offending type `got`: exactly two added occurrences.
fn gan_refused_arg_with_mismatch(green: CompileDiagnosticCensus, red: CompileDiagnosticCensus, param: String, got: String) -> Bool {
  match green {
    CensusObserved { rows: g } => match red {
      CensusObserved { rows: r } =>
        (gan_added_total(red: r, green: g) == 2)
          && (gan_added_at(red: r, green: g, class: "TypeMismatch", subject: got) == 1)
          && (gan_added_at(red: r, green: g, class: "DeclaredTypeNotInhabited", subject: gan_param_subject(param: param)) == 1)
      CensusNotRunnable { cause: _ } => false
    }
    CensusNotRunnable { cause: _ } => false
  }
}

