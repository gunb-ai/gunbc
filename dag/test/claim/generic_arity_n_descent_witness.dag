module test.claim.generic_arity_n_descent_witness

import gunbc.compile_diagnostic_census { CompileDiagnosticCensus, CensusObserved, CensusNotRunnable, census_blocking_rows }

// A MULTI-PARAMETER GENERIC BINDS ITS TYPE ARGUMENTS POSITIONALLY. unify_generics descended only
// when formal and actual each had exactly one child, so Map<K, V>, FinitelySupportedFunction<K, V>
// and a user ApPair<A, B> bound nothing: map_lookup over Map<String, String> yielded Optional<V>
// with V unbound, and an unbound V is accepted everywhere (Int formal, .zzz). MECHANISM:
// unify_generic_child_pairs unifies equal-arity children pairwise. Each red source is accepted
// without that arm and refused with it; each control is accepted by both. The census reports typed
// rows, so a probe refusing for a typo reads as a different row count than the one expected.
// ap_slot / ap_brand_slot is the #14354 control: a generic bound to a brand must stay that brand.
// dissolve-on: never -- permanent regression control for arity-N binding.

fn gan_blocking_count(source: String) -> Int {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: rows } => count(census_blocking_rows(rows: rows))
    CensusNotRunnable { cause: _ } => -1
  }
}

data gan_red_lookup_source: String = "module arity_probe_mod\n\nimport std.algebra \{ FreeMonoid, list_head, FinitelySupportedFunction, map_lookup, map_insert \}\nimport std.optional \{ Optional \}\nimport std.types \{ NonEmptyStr \}\n\ntype ApBrand = NonEmptyStr where brand(\"ApBrand\")\ntype ApPair<A, B> \{ first: A second: B \}\ntype ApMapBox<K, V> \{ m: Map<K, V> \}\ntype ApFsfBox<K, V> \{ f: FinitelySupportedFunction<K, V> \}\ntype ApSlot<T> \{ generation: Int value: T \}\n\nfn ap_int(x: Int) -> Int \{ x \}\nfn ap_str(x: String) -> String \{ x \}\nfn ap_mk_pair<A, B>(a: A, b: B) -> ApPair<A, B> \{ ApPair \{ first: a, second: b \} \}\nfn ap_mk_map_box<K, V>(m: Map<K, V>) -> ApMapBox<K, V> \{ ApMapBox \{ m: m \} \}\nfn ap_mk_fsf_box<K, V>(f: FinitelySupportedFunction<K, V>) -> ApFsfBox<K, V> \{ ApFsfBox \{ f: f \} \}\nfn ap_mk_slot<T>(v: T) -> ApSlot<T> \{ ApSlot \{ generation: 1, value: v \} \}\n\nfn ap_f(m: Map<String, String>, k: String) -> Int \{\n  match map_lookup(m: m, key: k) \{ Present \{ value: v \} => ap_int(x: v) Absent => 0 \}\n\}\n"

data gan_red_lookup_field_source: String = "module arity_probe_mod\n\nimport std.algebra \{ FreeMonoid, list_head, FinitelySupportedFunction, map_lookup, map_insert \}\nimport std.optional \{ Optional \}\nimport std.types \{ NonEmptyStr \}\n\ntype ApBrand = NonEmptyStr where brand(\"ApBrand\")\ntype ApPair<A, B> \{ first: A second: B \}\ntype ApMapBox<K, V> \{ m: Map<K, V> \}\ntype ApFsfBox<K, V> \{ f: FinitelySupportedFunction<K, V> \}\ntype ApSlot<T> \{ generation: Int value: T \}\n\nfn ap_int(x: Int) -> Int \{ x \}\nfn ap_str(x: String) -> String \{ x \}\nfn ap_mk_pair<A, B>(a: A, b: B) -> ApPair<A, B> \{ ApPair \{ first: a, second: b \} \}\nfn ap_mk_map_box<K, V>(m: Map<K, V>) -> ApMapBox<K, V> \{ ApMapBox \{ m: m \} \}\nfn ap_mk_fsf_box<K, V>(f: FinitelySupportedFunction<K, V>) -> ApFsfBox<K, V> \{ ApFsfBox \{ f: f \} \}\nfn ap_mk_slot<T>(v: T) -> ApSlot<T> \{ ApSlot \{ generation: 1, value: v \} \}\n\nfn ap_f(m: Map<String, String>, k: String) -> Int \{\n  match map_lookup(m: m, key: k) \{ Present \{ value: v \} => v.zzz Absent => 0 \}\n\}\n"

