test fn arity_n_ctl_cas_slot_version_brand() -> Bool {
  gan_same_blocking(base: gan_census(source: gan_fx_cas_base), other: gan_census(source: gan_ctl_cas_slot_source))
}

test fn arity_n_ctl_cas_unobserved_census_does_not_pass() -> Bool {
  !gan_same_blocking(base: gan_unobserved(), other: gan_unobserved())
    && !gan_same_blocking(base: gan_census(source: gan_fx_cas_base), other: gan_unobserved())
    && !gan_same_blocking(base: gan_unobserved(), other: gan_census(source: gan_fx_cas_base))
}

test fn arity_n_ctl_cas_added_diagnostic_does_not_pass() -> Bool {
  !gan_same_blocking(base: gan_census(source: gan_fx_cas_base), other: gan_census(source: gan_fx_cas_added_diag))
}

