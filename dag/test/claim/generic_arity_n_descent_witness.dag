module test.claim.generic_arity_n_descent_witness

import gunbc.compile_diagnostic_census { CompileDiagnosticCensus, CensusObserved, CensusNotRunnable, census_blocking_rows }

// A MULTI-PARAMETER GENERIC BINDS ITS TYPE ARGUMENTS POSITIONALLY. unify_generics descended only
// when formal and actual each had exactly one child, so Map<K, V>, FinitelySupportedFunction<K, V>
// and a user ApPair<A, B> bound nothing: map_lookup over Map<String, String> yielded Optional<V>
// with V unbound, and an unbound V is accepted everywhere (Int formal, .zzz). MECHANISM:
// unify_generic_child_pairs unifies equal-arity children pairwise.
//
// THREE KINDS OF CLAIM, each judged differently:
//  - arity_n_red_*: five sources accepted without the arm and refused with it (the base revert
//    shows them failing). They assert only that SOME blocking row exists (> 0), so a typo would
//    satisfy them; their discrimination is the revert, not the assertion. All five bind String,
//    String, which cannot show WHICH argument a variable received.
//  - arity_n_ctl_*: accepted sources, asserting zero blocking rows, except the head-mismatch
//    controls (> 0) which pin that a real head mismatch is refused by ordinary compatibility.
//  - arity_n_pos_* / arity_n_else_* / arity_n_ctl_cas_*: keyed. The census counts the WHOLE compile,
//    import closure included, so each compares a source to a baseline that differs on one axis
//    using census_blocking_histograms_equal (key and multiplicity, both directions) or
//    censuses_differ_by_exactly_the_target_key (one extra blocking occurrence, of the named class), and requires
//    CensusObserved on both sides; CensusNotRunnable is a refusal, never a pass.
// POSITION: arity_n_pos_* pass ApPair<Int, String> to ap_second_of / ap_first_of; a position swap in
// unify_generic_child_pairs flips both the accepted and the refused consumer.
// ap_slot / ap_brand_slot is the #14354 control: a generic bound to a brand must stay that brand.
// dissolve-on: never -- permanent regression control for arity-N binding.

fn gan_blocking_count(source: String) -> Int {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: rows } => count(census_blocking_rows(rows: rows))
    CensusNotRunnable { cause: _ } => -1
  }
}

data gan_red_lookup_source: String = "module arity_probe_mod\n\nimport std.algebra \{ FreeMonoid, list_head, FinitelySupportedFunction, map_lookup, map_insert \}\nimport std.optional \{ Optional \}\nimport std.types \{ NonEmptyStr \}\n\ntype ApBrand = NonEmptyStr where brand(\"ApBrand\")\ntype ApPair<A, B> \{ first: A second: B \}\ntype ApMapBox<K, V> \{ m: Map<K, V> \}\ntype ApFsfBox<K, V> \{ f: FinitelySupportedFunction<K, V> \}\ntype ApSlot<T> \{ generation: Int value: T \}\n\nfn ap_int(x: Int) -> Int \{ x \}\nfn ap_str(x: String) -> String \{ x \}\nfn ap_mk_pair<A, B>(a: A, b: B) -> ApPair<A, B> \{ ApPair \{ first: a, second: b \} \}\nfn ap_mk_map_box<K, V>(m: Map<K, V>) -> ApMapBox<K, V> \{ ApMapBox \{ m: m \} \}\nfn ap_mk_fsf_box<K, V>(f: FinitelySupportedFunction<K, V>) -> ApFsfBox<K, V> \{ ApFsfBox \{ f: f \} \}\nfn ap_mk_slot<T>(v: T) -> ApSlot<T> \{ ApSlot \{ generation: 1, value: v \} \}\n\nfn ap_f(m: Map<String, String>, k: String) -> Int \{\n  match map_lookup(m: m, key: k) \{ Present \{ value: v \} => ap_int(x: v) Absent => 0 \}\n\}\n"

data gan_red_lookup_field_source: String = "module arity_probe_mod\n\nimport std.algebra \{ FreeMonoid, list_head, FinitelySupportedFunction, map_lookup, map_insert \}\nimport std.optional \{ Optional \}\nimport std.types \{ NonEmptyStr \}\n\ntype ApBrand = NonEmptyStr where brand(\"ApBrand\")\ntype ApPair<A, B> \{ first: A second: B \}\ntype ApMapBox<K, V> \{ m: Map<K, V> \}\ntype ApFsfBox<K, V> \{ f: FinitelySupportedFunction<K, V> \}\ntype ApSlot<T> \{ generation: Int value: T \}\n\nfn ap_int(x: Int) -> Int \{ x \}\nfn ap_str(x: String) -> String \{ x \}\nfn ap_mk_pair<A, B>(a: A, b: B) -> ApPair<A, B> \{ ApPair \{ first: a, second: b \} \}\nfn ap_mk_map_box<K, V>(m: Map<K, V>) -> ApMapBox<K, V> \{ ApMapBox \{ m: m \} \}\nfn ap_mk_fsf_box<K, V>(f: FinitelySupportedFunction<K, V>) -> ApFsfBox<K, V> \{ ApFsfBox \{ f: f \} \}\nfn ap_mk_slot<T>(v: T) -> ApSlot<T> \{ ApSlot \{ generation: 1, value: v \} \}\n\nfn ap_f(m: Map<String, String>, k: String) -> Int \{\n  match map_lookup(m: m, key: k) \{ Present \{ value: v \} => v.zzz Absent => 0 \}\n\}\n"

data gan_red_user_map_source: String = "module arity_probe_mod\n\nimport std.algebra \{ FreeMonoid, list_head, FinitelySupportedFunction, map_lookup, map_insert \}\nimport std.optional \{ Optional \}\nimport std.types \{ NonEmptyStr \}\n\ntype ApBrand = NonEmptyStr where brand(\"ApBrand\")\ntype ApPair<A, B> \{ first: A second: B \}\ntype ApMapBox<K, V> \{ m: Map<K, V> \}\ntype ApFsfBox<K, V> \{ f: FinitelySupportedFunction<K, V> \}\ntype ApSlot<T> \{ generation: Int value: T \}\n\nfn ap_int(x: Int) -> Int \{ x \}\nfn ap_str(x: String) -> String \{ x \}\nfn ap_mk_pair<A, B>(a: A, b: B) -> ApPair<A, B> \{ ApPair \{ first: a, second: b \} \}\nfn ap_mk_map_box<K, V>(m: Map<K, V>) -> ApMapBox<K, V> \{ ApMapBox \{ m: m \} \}\nfn ap_mk_fsf_box<K, V>(f: FinitelySupportedFunction<K, V>) -> ApFsfBox<K, V> \{ ApFsfBox \{ f: f \} \}\nfn ap_mk_slot<T>(v: T) -> ApSlot<T> \{ ApSlot \{ generation: 1, value: v \} \}\n\nfn ap_f(m: Map<String, String>) -> Int \{\n  ap_int(x: ap_mk_map_box(m: m).m)\n\}\n"

data gan_red_user_fsf_source: String = "module arity_probe_mod\n\nimport std.algebra \{ FreeMonoid, list_head, FinitelySupportedFunction, map_lookup, map_insert \}\nimport std.optional \{ Optional \}\n\ntype ApPair<A, B> \{ first: A second: B \}\ntype ApBox<A, B> = ApBoth \{ first: A second: B \} | ApNone\n\nfn ap_int(x: Int) -> Int \{ x \}\nfn ap_str(x: String) -> String \{ x \}\nfn ap_second_of<A, B>(p: ApPair<A, B>) -> B \{ p.second \}\nfn ap_fsf_look<K, V>(f: FinitelySupportedFunction<K, V>, k: K) -> V? \{ f.get(k) \}\nfn ap_box_of<A, B>(p: ApPair<A, B>) -> ApBox<A, B> \{ ApBoth \{ first: p.first, second: p.second \} \}\n\nfn ap_f(f: FinitelySupportedFunction<String, String>) -> Int \{\n  match ap_fsf_look(f: f, k: \"a\") \{ Present \{ value: v \} => ap_int(x: v) Absent => 0 \}\n\}\n"

