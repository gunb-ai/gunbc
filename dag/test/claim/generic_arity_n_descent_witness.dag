data gan_ctl_brand_slot_source: String = "module arity_probe_mod\n\nimport std.algebra \{ FreeMonoid, list_head, FinitelySupportedFunction, map_lookup, map_insert \}\nimport std.optional \{ Optional \}\nimport std.types \{ NonEmptyStr \}\n\ntype ApBrand = NonEmptyStr where brand(\"ApBrand\")\ntype ApPair<A, B> \{ first: A second: B \}\ntype ApMapBox<K, V> \{ m: Map<K, V> \}\ntype ApFsfBox<K, V> \{ f: FinitelySupportedFunction<K, V> \}\ntype ApSlot<T> \{ generation: Int value: T \}\n\nfn ap_int(x: Int) -> Int \{ x \}\nfn ap_str(x: String) -> String \{ x \}\nfn ap_mk_pair<A, B>(a: A, b: B) -> ApPair<A, B> \{ ApPair \{ first: a, second: b \} \}\nfn ap_mk_map_box<K, V>(m: Map<K, V>) -> ApMapBox<K, V> \{ ApMapBox \{ m: m \} \}\nfn ap_mk_fsf_box<K, V>(f: FinitelySupportedFunction<K, V>) -> ApFsfBox<K, V> \{ ApFsfBox \{ f: f \} \}\nfn ap_mk_slot<T>(v: T) -> ApSlot<T> \{ ApSlot \{ generation: 1, value: v \} \}\n\nfn ap_f(b: ApBrand) -> ApBrand \{\n  ap_mk_slot(v: b).value\n\}\n"

data gan_ctl_cas_slot_source: String = "module arity_probe_mod\n\nimport std.content_hash \{ ContentHash \}\nimport std.durable_compare_and_set \{ CasSlotVersion, CasGeneration \}\nimport gunbc.roadmap.roadmap_event_log \{ RoadmapEventId \}\n\nfn ap_f(g: CasGeneration, c: ContentHash, id: RoadmapEventId) -> CasSlotVersion<RoadmapEventId> \{\n  CasSlotVersion \{ generation: g, content: c, value: id \}\n\}\n\nfn ap_h(g: CasGeneration, c: ContentHash, id: RoadmapEventId) -> RoadmapEventId \{\n  CasSlotVersion \{ generation: g, content: c, value: id \}.value\n\}\n"

test fn arity_n_ctl_cas_slot_version_brand() -> Bool {
  gan_blocking_count(source: gan_ctl_cas_slot_source) == 0
}

