}

test fn arity_n_else_pair_matched_head_accepted() -> Bool {
  gan_same_blocking(base: gan_census(source: gan_fx_else_pair_base), other: gan_census(source: gan_fx_else_pair_mapbox_green))
}

// OPEN, observed accepted: Map<K, V> formal against an Optional<Int> actual, and List<T> formal against a Map actual,
// compile with no blocking diagnostic beyond the matched-head fixture. These pin the current silent acceptance, not a wall;
// they flip when the PR-2 refusal of a generic still free after binding lands.
test fn arity_n_else_map_formal_optional_actual_open_accepted() -> Bool {
  gan_same_blocking(base: gan_census(source: gan_fx_else_map_opt_green), other: gan_census(source: gan_fx_else_map_opt_red))
}

test fn arity_n_else_list_formal_map_actual_open_accepted() -> Bool {
  gan_same_blocking(base: gan_census(source: gan_fx_else_list_map_green), other: gan_census(source: gan_fx_else_list_map_red))
}

