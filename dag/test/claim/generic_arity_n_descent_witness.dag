fn gan_census(source: String) -> CompileDiagnosticCensus {
  compile_dag_diagnostic_census(source)
}

fn gan_unobserved() -> CompileDiagnosticCensus {
  CensusNotRunnable { cause: "no census" as NonEmptyStr }
}

// Both sides observed, then the blocking histograms agree key by key. Anything unobserved is false.
fn gan_same_blocking(base: CompileDiagnosticCensus, other: CompileDiagnosticCensus) -> Bool {
  match base {
    CensusObserved { rows: b } => match other {
      CensusObserved { rows: o } => census_blocking_histograms_equal(a: b, b: o)
      CensusNotRunnable { cause: _ } => false
    }
    CensusNotRunnable { cause: _ } => false
  }
}

// The red side exceeds the green by exactly one blocking occurrence in total, and that occurrence is of `class`.
// The subject is not asserted: the shared closure cancels in the differential, and class identity is the claim.
fn gan_one_more_blocking_of_class(red: List<CompileDiagnosticCensusRow>, green: List<CompileDiagnosticCensusRow>, class: String) -> Bool {
  let rb = census_blocking_rows(rows: red)
  let gb = census_blocking_rows(rows: green)
  (census_total_count(rows: rb) - census_total_count(rows: gb) == 1)
    && (census_total_count(rows: census_rows_of_class(rows: rb, wanted: class)) - census_total_count(rows: census_rows_of_class(rows: gb, wanted: class)) == 1)
}

// Both sides observed, then `red` exceeds `green` by exactly one blocking occurrence, of `class`.
fn gan_refused_at(green: CompileDiagnosticCensus, red: CompileDiagnosticCensus, class: String) -> Bool {
  match green {
    CensusObserved { rows: g } => match red {
      CensusObserved { rows: r } => gan_one_more_blocking_of_class(red: r, green: g, class: class)
      CensusNotRunnable { cause: _ } => false
    }
    CensusNotRunnable { cause: _ } => false
  }
}

