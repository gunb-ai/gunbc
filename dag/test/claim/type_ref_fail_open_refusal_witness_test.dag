module test.claim.type_ref_fail_open_refusal_witness

import gunbc.compile_diagnostic_census {
  CompileDiagnosticCensus,
  CensusObserved,
  CensusNotRunnable,
  census_blocking_rows,
  census_rows_of_class,
  census_total_count
}
import gunbc.type_ref_binding_authority_debt {
  type_ref_binding_authority_debt_dissolve_trigger,
  type_ref_binding_authority_debt_hand_rust_receipt,
  type_ref_binding_authority_debt_hand_rust_plan_anchor,
  type_ref_binding_authority_debt_hand_rust_loc_delta_net,
  type_ref_census_sha,
  type_ref_debt_roster_freeze_state,
  Frozen,
  ProvisionalUnfrozen,
  type_ref_roster_regenerator_choice,
  type_ref_roster_pure_regen_dissolve_trigger,
  type_ref_roster_host_effect_classify_procedure_note,
  type_ref_roster_host_effect_classify_optional_trigger,
  type_ref_debt_freeze_early_receipt,
  type_ref_debt_freeze_census_receipt,
  type_ref_debt_freeze_vs_provisional_delta_note,
  type_ref_debt_site_disposition_note
}
import std.types { String, Bool }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data type_ref_fail_open_witness_note: String = "import-strip section 14.1 acceptance probes as synthetic census sources (same observation surface as compile_diagnostic_census_witness). Row 1 GREEN (own import from std.content_hash). Rows 3/4/5 RED blocking UnresolvedType: absent-from-pool, pool-present bare unreachable, and pool-present qualified unreachable share one refusal shape. Row 2 (transitive) stays a fixture-level control under dag/test/fixture/type_ref_fail_open_probe — advisory UnlistedImportUse is orthogonal. Admission predicate is type_ref_has_binding_authority (swappable; interim import/local)."

fn census_of(source: String) -> CompileDiagnosticCensus {
  compile_dag_diagnostic_census(source)
}

fn unresolved_blocking_count(source: String) -> Int {
  match census_of(source: source) {
    CensusObserved { rows: rows } =>
      census_total_count(
        rows: census_rows_of_class(
          rows: census_blocking_rows(rows: rows),
          wanted: "UnresolvedType"
        )
      )
    CensusNotRunnable { cause: _ } => 0 - 1
  }
}

data row1_own_import_source: String = "module type_ref_row1\nimport std.content_hash { ContentHash }\nfn f(x: ContentHash) -> ContentHash { x }\n"

data row3_absent_source: String = "module type_ref_row3\nfn f(x: NoSuchTypeNameAnywhereZzz) -> NoSuchTypeNameAnywhereZzz { x }\n"

data row4_bare_pool_present_source: String = "module type_ref_row4\nfn f(x: ContentHash) -> ContentHash { x }\n"

data row5_qualified_pool_present_source: String = "module type_ref_row5\nfn f(x: std.content_hash.ContentHash) -> std.content_hash.ContentHash { x }\n"

test fn row1_own_import_stays_green() -> Bool {
  unresolved_blocking_count(source: row1_own_import_source) == 0
}

test fn row3_absent_is_blocking_unresolved_type() -> Bool {
  unresolved_blocking_count(source: row3_absent_source) >= 1
}

test fn row4_bare_pool_present_unreachable_matches_row3_shape() -> Bool {
  unresolved_blocking_count(source: row4_bare_pool_present_source) >= 1
}

test fn row5_qualified_pool_present_unreachable_matches_row3_shape() -> Bool {
  unresolved_blocking_count(source: row5_qualified_pool_present_source) >= 1
}

test fn debt_dissolve_trigger_names_n2() -> Bool {
  string_contains(s: type_ref_binding_authority_debt_dissolve_trigger, pattern: "N2 containment")
}

test fn hand_rust_receipt_names_deleted_scaffold_path() -> Bool {
  string_contains(s: type_ref_binding_authority_debt_hand_rust_receipt, pattern: "HAND-RUST GATE receipt")
    && string_contains(s: type_ref_binding_authority_debt_hand_rust_receipt, pattern: "cli_run_type_ref_binding_authority_debt_admission")
    && string_contains(s: type_ref_binding_authority_debt_hand_rust_receipt, pattern: "DELETE")
    && string_contains(s: type_ref_binding_authority_debt_hand_rust_receipt, pattern: "N2")
}

test fn hand_rust_receipt_plan_anchor_and_loc_are_checkable() -> Bool {
  string_contains(
    s: type_ref_binding_authority_debt_hand_rust_plan_anchor,
    pattern: "import-strip-witness-discovery-cascade-diagnosis.md"
  ) && type_ref_binding_authority_debt_hand_rust_loc_delta_net > 0
}

test fn dissolve_trigger_names_cli_run_hand_rust_transport() -> Bool {
  string_contains(
    s: type_ref_binding_authority_debt_dissolve_trigger,
    pattern: "CLI_RUN_TYPE_REF_BINDING_AUTHORITY_DEBT_ADMISSION_SCAFFOLD_MARKER"
  )
}

test fn census_sha_is_pinned_on_carrier() -> Bool {
  string_contains(s: type_ref_census_sha, pattern: "f531ba548d01fd70d9b8eb825b17f542578ce485")
}

test fn freeze_state_is_frozen() -> Bool {
  match type_ref_debt_roster_freeze_state {
    Frozen => true
    ProvisionalUnfrozen => false
  }
}

test fn regenerator_declared_offline_authoring_tool() -> Bool {
  string_contains(s: type_ref_roster_regenerator_choice, pattern: "CHOICE (b)")
    && string_contains(s: type_ref_roster_regenerator_choice, pattern: "OFFLINE AUTHORING TOOL")
    && string_contains(s: type_ref_roster_regenerator_choice, pattern: "NEVER invoked from CI")
    && string_contains(s: type_ref_roster_regenerator_choice, pattern: "SINGLE AUTHORITY")
    && string_contains(s: type_ref_roster_regenerator_choice, pattern: "HALF 2")
}

test fn pure_regen_single_authority_is_offline_python() -> Bool {
  string_contains(s: type_ref_roster_pure_regen_dissolve_trigger, pattern: "RETRACTED")
    && string_contains(s: type_ref_roster_pure_regen_dissolve_trigger, pattern: "review 47277")
    && string_contains(s: type_ref_roster_pure_regen_dissolve_trigger, pattern: "SINGLE AUTHORITY")
    && string_contains(s: type_ref_roster_pure_regen_dissolve_trigger, pattern: "regenerate_from_census.py")
    && string_contains(s: type_ref_roster_pure_regen_dissolve_trigger, pattern: "never keep both")
}

test fn host_effect_classify_is_procedure_not_scaffold() -> Bool {
  string_contains(s: type_ref_roster_host_effect_classify_procedure_note, pattern: "not a Scaffold")
    && string_contains(s: type_ref_roster_host_effect_classify_procedure_note, pattern: "No dissolve-on")
    && string_contains(s: type_ref_roster_host_effect_classify_optional_trigger, pattern: "OPTIONAL only")
    && string_contains(s: type_ref_roster_host_effect_classify_optional_trigger, pattern: "not a dissolve obligation")
}

test fn freeze_early_receipt_names_revealed_229_retired_0() -> Bool {
  string_contains(s: type_ref_debt_freeze_early_receipt, pattern: "229 pre-existing sites")
    && string_contains(s: type_ref_debt_freeze_early_receipt, pattern: "retired_delta = 0")
}

test fn freeze_census_receipt_pins_2854() -> Bool {
  string_contains(s: type_ref_debt_freeze_census_receipt, pattern: "2854")
    && string_contains(s: type_ref_debt_freeze_census_receipt, pattern: "3506")
    && string_contains(s: type_ref_debt_freeze_census_receipt, pattern: "dup_extra = 652")
}

test fn freeze_vs_provisional_delta_closes_at_699() -> Bool {
  string_contains(s: type_ref_debt_freeze_vs_provisional_delta_note, pattern: "988 − 289 = +699")
    && string_contains(s: type_ref_debt_freeze_vs_provisional_delta_note, pattern: "435 pure-mint")
    && string_contains(s: type_ref_debt_freeze_vs_provisional_delta_note, pattern: "zero-tolerance")
}

test fn incidental_outside_subset_is_by_subset_rule_not_construction() -> Bool {
  string_contains(s: type_ref_debt_site_disposition_note, pattern: "incidental BY SUBSET RULE")
    && string_contains(s: type_ref_debt_site_disposition_note, pattern: "almost certainly")
    && (string_contains(s: type_ref_debt_site_disposition_note, pattern: "BY CONSTRUCTION") == false)
}
