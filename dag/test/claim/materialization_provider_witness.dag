// The attack codex review 44278 named, now closed by construction and exercised on BOTH doors: the
// bytes at the key are the v1 shape (graph + source_indices, NO compile-clean diagnostic union), so
// the realization's read-back is witness_v1_shape_digest. The caller submits an artifact whose
// carried roster claims all three outputs — under the old label-beside-digest shape that roster
// satisfied artifact_completeness and the door answered BindingOk, admitting bytes that could green
// a red. Because the content digest is now DERIVED from the carried parts, claiming a part the
// bytes do not hold changes the derivation, so the forgery is no longer self-consistent and lands
// on the wrong-content refusal instead. The paired positive control below (same artifact, its OWN
// derived digest) shows the refusal is discriminating rather than a blanket red: the honest
// complete artifact still serves and still admits.

test fn red_forged_output_roster_refuses_as_wrong_content_on_serve() -> Bool {
  let forged = provider_serve(
    req: witness_closure_request(),
    probe: minted_in_process(
      req: witness_closure_request(),
      artifact: witness_complete_closure_artifact(),
      observed_digest: witness_v1_shape_digest()
    )
  )
  lookup_is_refused_wrong_content(l: forged) && (lookup_is_hit(l: forged) == false)
}

test fn red_forged_output_roster_refuses_as_wrong_content_on_admit() -> Bool {
  let a = provider_admit(
    store: witness_empty_store(budget_count: 1000),
    req: witness_closure_request(),
    artifact: witness_complete_closure_artifact(),
    observed_digest: witness_v1_shape_digest()
  )
  admission_is_refused_wrong_content_write(a: a) && (admission_is_admitted(a: a) == false)
}

test fn carried_roster_is_the_content_digest_preimage() -> Bool {
  (witness_closure_digest() == witness_v1_shape_digest()) == false
    && (witness_closure_digest() == artifact_content_digest(artifact: witness_complete_closure_artifact()))
}

// codex review 44300, and it is a distinct attack from the one below: keep every part DIGEST
// identical and understate only the BYTE COUNTS. Under the earlier preimage — (id, digest) per part
// — the derived content digest was unchanged, so the read-back still matched, BindingOk was
// returned, and the understated size was trusted by the budget check and handed to store_put. The
// earlier witness did not reach this: it varied the parts themselves, so it exercised a different
// path. These vary bytes ALONE, holding every digest fixed, which is the discriminating input the
// previous test set lacked. With bytes inside the preimage the understated artifact is refused
// wrong-content; the honest one at the same budget is admitted, so the pair discriminates rather
// than going blanket red.

fn witness_size_understated_closure_artifact() -> MaterializedArtifact {
  ResolvedGraphArtifact {
    request_key: request_key(req: witness_closure_request()),
    resolved_graph: ArtifactPart { digest: content_hash_atom(value: "closure-graph-1"), bytes: byte_size(count: 6) },
    source_indices: ArtifactPart { digest: content_hash_atom(value: "closure-indices-1"), bytes: byte_size(count: 2) },
    compile_clean_diagnostic_union: ArtifactPart { digest: content_hash_atom(value: "closure-diagnostics-1"), bytes: byte_size(count: 1) }
  }
}

fn witness_hash_list_contains(xs: List<Fnv1a64Structural>, wanted: Fnv1a64Structural) -> Bool {
  xs |> fold(init: false, f: (acc, x) => acc || (x == wanted))
}

fn witness_carries_the_canonical_three_digests(a: MaterializedArtifact) -> Bool {
  let ds = artifact_carried_outputs(artifact: a) |> map(o => o.digest)
  (ds.count() == 3)
    && witness_hash_list_contains(xs: ds, wanted: content_hash_atom(value: "closure-graph-1"))
    && witness_hash_list_contains(xs: ds, wanted: content_hash_atom(value: "closure-indices-1"))
    && witness_hash_list_contains(xs: ds, wanted: content_hash_atom(value: "closure-diagnostics-1"))
}

test fn understated_bytes_alone_hold_every_part_digest_fixed() -> Bool {
  witness_carries_the_canonical_three_digests(a: witness_complete_closure_artifact())
    && witness_carries_the_canonical_three_digests(a: witness_size_understated_closure_artifact())
    && (measure_count(m: artifact_bytes(artifact: witness_size_understated_closure_artifact())) == 9)
    && (measure_count(m: artifact_bytes(artifact: witness_complete_closure_artifact())) == 100)
}

test fn red_understated_bytes_are_inside_the_authenticated_preimage() -> Bool {
  let understated_digest = artifact_content_digest(artifact: witness_size_understated_closure_artifact())
  (understated_digest == witness_closure_digest()) == false
}

test fn red_understated_bytes_alone_are_refused_wrong_content_not_admitted() -> Bool {
  let understated = provider_admit(
    store: witness_empty_store(budget_count: 50),
    req: witness_closure_request(),
    artifact: witness_size_understated_closure_artifact(),
    observed_digest: witness_closure_digest()
  )
  let honest_at_the_same_budget = provider_admit(
    store: witness_empty_store(budget_count: 1000),
    req: witness_closure_request(),
    artifact: witness_complete_closure_artifact(),
    observed_digest: witness_closure_digest()
  )
  admission_is_refused_wrong_content_write(a: understated)
    && (admission_is_admitted(a: understated) == false)
    && admission_is_admitted(a: honest_at_the_same_budget)
}

// The fourth instance of the one defect (parent finding, after reviews 44175 / 44265 / 44278): artifact_bytes was a caller-authored field that request_artifact_binding never verified and structurally COULD not verify, while provider_admit_bound branched the budget check on it and handed the same number to store_put as the stored size. So the 7406 construction wall — store_put refuses when the artifact exceeds the budget — was a wall against an honest caller only: an understated size walked past ProviderBudgetExhausted, was admitted, and then corrupted store_bytes_used for every subsequent eviction decision. The size is now folded over the carried parts, exactly parallel to the digest, so the roster is the preimage of both. The witnesses below show what that buys: the size IS the parts fold, and the only way to derive a smaller size is to shrink the parts — which changes the digest and is caught by the read-back comparison the door already runs. Understating the size is therefore not a bypass, it is the wrong-content refusal.
test fn artifact_size_is_the_carried_parts_fold() -> Bool {
  (measure_count(m: artifact_bytes(artifact: witness_complete_closure_artifact())) == 100)
    && (measure_count(m: artifact_bytes(artifact: witness_v1_shape_closure_artifact())) == 85)
}

test fn red_understating_the_size_lands_on_wrong_content_not_a_budget_bypass() -> Bool {
  let honest = provider_admit(
    store: witness_empty_store(budget_count: 90),
    req: witness_closure_request(),
    artifact: witness_complete_closure_artifact(),
    observed_digest: witness_closure_digest()
  )
  let understated = provider_admit(
    store: witness_empty_store(budget_count: 90),
    req: witness_closure_request(),
    artifact: witness_v1_shape_closure_artifact(),
    observed_digest: witness_closure_digest()
  )
  admission_is_budget_exhausted(a: honest)
    && (admission_is_admitted(a: honest) == false)
    && admission_is_refused_wrong_content_write(a: understated)
    && (admission_is_admitted(a: understated) == false)
}

// Blocker 1 (operator review): the typecheck key must BE the existing std.interface_summary authority, not a second definition of typed-module identity. These execute the equivalence rather than asserting it — the contract's derived key is compared against typed_module_key(module_key(...)) computed independently here from the same ingredients, and the RED shows a changed direct-import interface hash moves BOTH in step, which is what makes them one authority rather than two that happen to agree on one input.
test fn typecheck_request_key_is_the_existing_typed_module_key_authority() -> Bool {
  let independently = typed_module_key(
    interface_key: module_key(
      source_hash: content_hash_atom(value: "module-source-1"),
      direct_import_interface_hashes: [witness_import_a()]
    ),
    compiler_identity: content_hash_atom(value: "compiler-identity-1")
  )
  request_key(req: witness_typecheck_request()) == as_content_hash_structural(structural: independently)
}

test fn red_typecheck_key_tracks_the_authority_when_an_import_changes() -> Bool {
  let independently_changed = typed_module_key(
    interface_key: module_key(
      source_hash: content_hash_atom(value: "module-source-1"),
      direct_import_interface_hashes: [witness_import_a_changed()]
    ),
    compiler_identity: content_hash_atom(value: "compiler-identity-1")
  )
  (request_key(req: witness_typecheck_request_changed_input()) == as_content_hash_structural(structural: independently_changed))
    && ((request_key(req: witness_typecheck_request()) == as_content_hash_structural(structural: independently_changed)) == false)
}

// Blocker 2 (operator review): omission, not forgery. The digest-preimage work made lying
// impossible; these show omitting is now impossible too. A complete resolved-graph artifact reaches
// its union through a REQUIRED field, so the v1 shape can no longer be spelled as a
// ResolvedGraphArtifact at all — it is only expressible as the named LegacyIncompleteArtifact
// variant, which is exactly the v1 resolved-graph disk-hit refuse arm (its disk tier deleted on
// 2026-10-03). The completeness check is therefore still LIVE rather
// than inert: it is what measures that legacy variant, and the refusal below is reached by
// execution.

test fn complete_artifact_reaches_its_union_through_a_required_field() -> Bool {
  let ids = artifact_carried_outputs(artifact: witness_complete_closure_artifact()) |> map(o => o.id)
  (ids.count() == 3)
    && output_list_contains(xs: ids, wanted: output_compile_clean_diagnostic_union)
    && (artifact_kind(artifact: witness_complete_closure_artifact()) == resolved_graph_artifact_kind)
}

test fn v1_incompleteness_is_a_named_variant_not_a_missing_list_element() -> Bool {
  let legacy = witness_v1_shape_closure_artifact()
  let ids = artifact_carried_outputs(artifact: legacy) |> map(o => o.id)
  (artifact_kind(artifact: legacy) == resolved_graph_artifact_kind)
    && (ids.count() == 2)
    && (output_list_contains(xs: ids, wanted: output_compile_clean_diagnostic_union) == false)
}

test fn completeness_holds_when_all_required_outputs_are_carried() -> Bool {
  completeness_is_complete(c: artifact_completeness(
    required: request_required_outputs(req: witness_closure_request()),
    carried: artifact_carried_outputs(artifact: witness_complete_closure_artifact())
  ))
}

