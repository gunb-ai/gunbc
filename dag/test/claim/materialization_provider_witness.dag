// PAIR: six_judgment_contracts_join_the_cache_identity_kinds (specimen: contract kind and
// occurrence grain against std.cache_identity / OccurrencePersistenceContract, not against the
// request_* aliases) with provider_serve_completeness_reads_the_judgment_contract (inhabitance).
// Bypass of the inhabitance: provider_serve that does not use the contract roster greens a
// v1-shape resolve artifact. A family omitted from request_judgment_contract fails to typecheck.
test fn six_judgment_contracts_join_the_cache_identity_kinds() -> Bool {
  let reqs = witness_six_artifact_request_families()
  let expected = [
    parse_source_artifact_kind,
    typed_module_artifact_kind,
    resolved_graph_artifact_kind,
    native_compiler_artifact_kind,
    native_test_universe_artifact_kind,
    native_module_verdict_bundle_artifact_kind
  ]
  let kinds = reqs |> map(r => request_judgment_contract(req: r).demand_identity.kind)
  let joined = expected |> filter(k => (kinds |> filter(x => x == k) |> count()) == 1) |> count()
  let left_only = expected |> filter(k => (kinds |> filter(x => x == k) |> count()) == 0) |> count()
  let right_only = kinds |> filter(k => (expected |> filter(x => x == k) |> count()) == 0) |> count()
  let typecheck_outputs = request_judgment_contract(req: witness_typecheck_request()).result.required_persisted_outputs
  let interface_semantic = (typecheck_outputs |> filter(o =>
    o.id == output_typed_module_interface && o.occurrence_contract == SemanticOnly
  ) |> count()) == 1
  let diagnostics_scoped = (typecheck_outputs |> filter(o =>
    o.id == output_typecheck_diagnostics && o.occurrence_contract == Scoped
  ) |> count()) == 1
  (expected.count() == 6)
    && (kinds.count() == 6)
    && (joined == 6)
    && (left_only == 0)
    && (right_only == 0)
    && interface_semantic
    && diagnostics_scoped
    && (request_judgment_contract(req: witness_native_compiler_request()).demand_nature == IdempotentEffect)
    && (request_judgment_contract(req: witness_verdict_bundle_request()).demand_nature == IdempotentEffect)
    && (request_judgment_contract(req: witness_native_compiler_request()).result.carries_effect_requests_receipts == false)
    && (request_judgment_contract(req: witness_verdict_bundle_request()).result.carries_effect_requests_receipts == false)
}

test fn provider_serve_completeness_reads_the_judgment_contract() -> Bool {
  let req = witness_closure_request()
  let required = request_required_outputs(req: req)
  let refused = provider_serve(
    req: req,
    probe: minted_in_process(
      req: witness_closure_request(),
      artifact: witness_v1_shape_closure_artifact(),
      observed_digest: witness_v1_shape_digest()
    )
  )
  let missing = lookup_refused_incomplete_missing(l: refused)
  (required.count() == 3)
    && (missing.count() == 1)
    && output_list_contains(xs: required, wanted: output_compile_clean_diagnostic_union)
    && output_list_contains(xs: missing, wanted: output_compile_clean_diagnostic_union)
    && (lookup_is_hit(l: refused) == false)
}

fn demand_identity_canonical_c1_lossy(demand: DemandIdentity) -> NonEmptyStr {
  demand.declared_inputs |> fold(
    init: concat(concat(demand.kind as String, ":"), identity_component_index_fingerprint(component: demand.subject).digest as String),
    f: (acc, i) => concat(concat(concat(acc, ":"), i.ref as String), concat(":", identity_component_index_fingerprint(component: i.component).digest as String))
  ) as NonEmptyStr
}

fn refused_has(xs: List<RefusedIdentityComponent>, wanted: NonEmptyStr) -> Bool {
  xs |> any(x => (x.ref as String) == (wanted as String))
}

fn refused_is_fingerprint(xs: List<RefusedIdentityComponent>, wanted: NonEmptyStr) -> Bool {
  xs |> any(x => (x.ref as String) == (wanted as String) && match x.cause {
    ComponentStructuralFingerprintRefused => true
    ComponentFamilyNotAdmitted => false
  })
}

// THE STRICT RULE, AT THE FAMILIES THAT STILL CARRY FINGERPRINTS, READ OFF THE REFUSAL ITSELF. A parse
// request's subject and its compiler input are structural fingerprints, so the persistent scope
// refuses the request an address -- and the value evaluation_store_address RETURNS carries both
// components with the standing that refused each. The in-process scope, where a collision costs a
// preimage comparison, refuses neither: a rule that refused every scope would pass the first half
// alone.
test fn a_structural_fingerprint_component_is_refused_a_persistent_address_by_name() -> Bool {
  let in_process = evaluation_store_refused_components(req: witness_parse_request(), scope: InProcessIndexScope)
  let cross_run = evaluation_store_refused_components(req: witness_parse_request(), scope: CrossRunScope)
  (in_process |> count()) == 0
    && (cross_run |> count()) == 2
    && (match evaluation_store_address(req: witness_parse_request()) {
      Admitted { address: _ } => false
      IdentityComponentsRefused { components: refused, scope: _ } =>
        (refused |> count()) == 2
          && refused_is_fingerprint(xs: refused, wanted: evaluation_identity_subject_ref)
          && refused_is_fingerprint(xs: refused, wanted: "compiler_binary_identity")
    })
    && (match evaluation_store_address(req: witness_typecheck_request()) {
      Admitted { address: _ } => false
      IdentityComponentsRefused { components: refused, scope: _ } => refused_has(xs: refused, wanted: evaluation_identity_subject_ref)
    })
}

fn standing_tag(row: EvaluationIdentityComponentRow, git_rows: List<EvaluationIdentityComponentRow>) -> String {
  match identity_component_persistent_standing(row: row, git_rows: git_rows) {
    ComponentAdmitted { admission: a } => match a {
      ComponentAdmittedForScope => "admitted"
      ComponentUpstreamObjectIdentity => "upstream"
    }
    ComponentRefused { cause: c } => match c {
      ComponentStructuralFingerprintRefused => "fingerprint"
      ComponentFamilyNotAdmitted => "not_admitted"
    }
  }
}

// WHICH COMPONENTS A PERSISTENT SCOPE ADMITS, ONE NAMED MEMBER PER ARM -- AND A LABEL IS NOT PROVENANCE.
// Text and a SHA-256 digest are admitted. A bare SHA-1 digest is not. A git object identity is
// admitted ONLY when the typed request lists that same component under that same ref: the list here
// is what request_git_object_rows derives from a request's GitObjectId fields. The same SHA-1
// wearing git's relation name but absent from that list -- a relabelled digest -- is refused; so is
// one listed under a different ref. A fingerprint is refused whatever it is wearing.
test fn persistent_component_standing_is_decided_by_the_typed_request_and_the_family() -> Bool {
  let sha1 = match sha1_hex_digest(hex: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa") {
    Present { value: d } => as_content_hash_sha1(digest: d)
    Absent => as_content_hash_structural(structural: content_hash_atom(value: "unreachable-sha1-fixture"))
  }
  let sha256 = match sha256_hex_digest(hex: "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855") {
    Present { value: d } => as_content_hash_cryptographic(digest: d)
    Absent => as_content_hash_structural(structural: content_hash_atom(value: "unreachable-sha256-fixture"))
  }
  let fingerprint = as_content_hash_structural(structural: content_hash_atom(value: "a-fingerprint"))
  let git_component = identity_upstream_object_component(relation: git_object_identity_relation, hash: sha1)
  let typed = [EvaluationIdentityComponentRow { ref: "tree", component: git_component }]
  let none_typed: List<EvaluationIdentityComponentRow> = []
  standing_tag(row: EvaluationIdentityComponentRow { ref: "t", component: identity_text_component(content: "rustc 1.90.0") }, git_rows: none_typed) == "admitted"
    && standing_tag(row: EvaluationIdentityComponentRow { ref: "d", component: identity_digest_component(hash: sha256) }, git_rows: none_typed) == "admitted"
    && standing_tag(row: EvaluationIdentityComponentRow { ref: "d", component: identity_digest_component(hash: sha1) }, git_rows: typed) == "not_admitted"
    && standing_tag(row: EvaluationIdentityComponentRow { ref: "tree", component: git_component }, git_rows: typed) == "upstream"
    && standing_tag(row: EvaluationIdentityComponentRow { ref: "tree", component: git_component }, git_rows: none_typed) == "not_admitted"
    && standing_tag(row: EvaluationIdentityComponentRow { ref: "other", component: git_component }, git_rows: typed) == "not_admitted"
    && standing_tag(row: EvaluationIdentityComponentRow { ref: "tree", component: identity_upstream_object_component(relation: "some.other.relation", hash: sha1) }, git_rows: typed) == "not_admitted"
    && standing_tag(row: EvaluationIdentityComponentRow { ref: "d", component: identity_digest_component(hash: fingerprint) }, git_rows: none_typed) == "fingerprint"
    && standing_tag(row: EvaluationIdentityComponentRow { ref: "tree", component: identity_upstream_object_component(relation: git_object_identity_relation, hash: fingerprint) }, git_rows: typed) == "fingerprint"
}

fn independent_fixture_sha256(hex: String) -> ContentHash {
  match sha256_hex_digest(hex: hex) {
    Present { value: d } => as_content_hash_cryptographic(digest: d)
    Absent => as_content_hash_structural(structural: content_hash_atom(value: "unreachable-independent-fixture"))
  }
}

fn independent_bundle_request(module_hex: String) -> ArtifactRequest {
  NativeModuleVerdictBundleRequest(NativeModuleVerdictBundleSubject {
    route_binary_identity: independent_fixture_sha256(hex: "1111111111111111111111111111111111111111111111111111111111111111"),
    module_identity: independent_fixture_sha256(hex: module_hex),
    canonical_module_import_closure_identity: independent_fixture_sha256(hex: "3333333333333333333333333333333333333333333333333333333333333333"),
    ordered_test_identity_population: independent_fixture_sha256(hex: "4444444444444444444444444444444444444444444444444444444444444444"),
    eval_interpretation_identity: independent_fixture_sha256(hex: "5555555555555555555555555555555555555555555555555555555555555555")
  })
}

// THE REAL DERIVATION AGAINST A DIGEST ESTABLISHED OUTSIDE THIS CORPUS. This is the pairing claim for
// every witness that supplies its address digest (addressed_request_with_supplied_digest): it runs
// evaluation_store_address itself, SHA-256 included, and compares the result with a literal that was
// produced by writing the canonical preimage out by hand from the encoding's definition and hashing
// it with an independent SHA-256. So it holds only if the encoder, the component order and the
// digest all agree with that outside derivation; comparing two paths through this corpus's own
// derivation could not show that. The red: one changed digit in one component is a different
// address. The same program is a case of gunbc.instruments native_materialization_store_closure,
// which will execute it as emitted code once that instrument's closure builds.
test fn the_store_address_is_the_independently_derived_sha256_of_the_canonical_preimage() -> Bool {
  let expected = "sha256:3f3d732486089ae8bb1e1a22f3e2a7dc81a94dad93087c0f58d3b7c1adcb0a01"
  let address_wire = store_address_wire(req: independent_bundle_request(module_hex: "2222222222222222222222222222222222222222222222222222222222222222"))
  let changed_wire = store_address_wire(req: independent_bundle_request(module_hex: "2222222222222222222222222222222222222222222222222222222222222223"))
  address_wire == expected && (changed_wire == expected) == false && starts_with(s: changed_wire, prefix: "sha256:")
}

fn store_address_wire(req: ArtifactRequest) -> String {
  match evaluation_store_address(req: req) {
    Admitted { address: a } => serialize_content_hash(hash: evaluation_store_address_digest(address: a)) as String
    IdentityComponentsRefused { components: _, scope: _ } => "refused"
  }
}

fn component_arm_canonical(c: IdentityComponent) -> String {
  demand_identity_canonical(demand: DemandIdentity {
    kind: parse_source_artifact_kind,
    subject: c,
    declared_inputs: [DeclaredInput { ref: "x", component: c }]
  }) as String
}

fn demand_canonical_round_trips(encoded: String) -> Bool {
  match demand_identity_decode(encoded: encoded) {
    Present { value: d } => (demand_identity_canonical(demand: d) as String) == encoded
    Absent => false
  }
}

// THE THREE ARMS ENCODE APART AND DECODE BACK. The same sixty-four hex digits as text, as a SHA-256
// digest and as a git object identity are three different components, so their encodings differ
// pairwise; and each decodes to an identity whose re-encoding is the text it was read from.
test fn identity_component_arms_encode_apart_and_round_trip() -> Bool {
  let hex = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
  let sha256 = match sha256_hex_digest(hex: hex) {
    Present { value: d } => as_content_hash_cryptographic(digest: d)
    Absent => as_content_hash_structural(structural: content_hash_atom(value: "unreachable-sha256-fixture"))
  }
  let as_text = component_arm_canonical(c: identity_text_component(content: hex as NonEmptyStr))
  let as_digest = component_arm_canonical(c: identity_digest_component(hash: sha256))
  let as_git = component_arm_canonical(c: identity_upstream_object_component(relation: git_object_identity_relation, hash: sha256))
  (as_text == as_digest) == false
    && (as_text == as_git) == false
    && (as_digest == as_git) == false
    && demand_canonical_round_trips(encoded: as_text)
    && demand_canonical_round_trips(encoded: as_digest)
    && demand_canonical_round_trips(encoded: as_git)
}

test fn persist_sha1_bucket_is_typed_family_refused() -> Bool {
  match admit_hash_family_for_scope(family: Sha1Family, scope: PersistentStoreScope) {
    FamilyNotAdmittedForRelation { family: _, scope: _ } =>
      (request_key(req: witness_parse_request()) == as_content_hash_structural(
        structural: content_hash_atom(value: "evaluation_store_address_refused")
      )) == false
    HashFamilyAdmittedForScope { family: _, scope: _ } => false
    StructuralFingerprintRefusedAsStoreKey { family: _, scope: _ } => false
  }
}

test fn in_process_probe_same_bucket_foreign_identity_is_not_a_hit() -> Bool {
  let req = witness_parse_request()
  let foreign_req = ParseModuleRequest {
    source_digest: content_hash_atom(value: "module-source-foreign"),
    compiler: witness_compiler()
  }
  let artifact = ParsedArtifact {
    request_key: request_key(req: req),
    parse_tree: witness_graph_part(),
    parse_diagnostics: witness_indices_part()
  }
  let digest = request_key(req: req)
  let served_substituted = provider_serve(
    req: req,
    probe: minted_in_process(req: foreign_req, artifact: artifact, observed_digest: digest)
  )
  lookup_is_refused_evaluation_preimage_mismatch(l: served_substituted)
    && (lookup_is_hit(l: served_substituted) == false)
    && lookup_is_hit(l: provider_serve(
      req: witness_closure_request(),
      probe: minted_in_process(
        req: witness_closure_request(),
        artifact: witness_complete_closure_artifact(),
        observed_digest: witness_closure_digest()
      )
    ))
    && (content_hash_family(hash: digest) == Fnv1a64StructuralFamily)
    && (content_hash_family(hash: request_key(req: foreign_req)) == Fnv1a64StructuralFamily)
}

test fn in_process_fnv_producer_observation_is_declared_frontier() -> Bool {
  dissolution_description(condition: in_process_fnv_producer_observation_frontier).length() > 0
}

test fn demand_canonical_encoding_is_injective_and_c1_lossy_collapses() -> Bool {
  let h1 = content_hash_atom(value: "p1")
  let h2 = content_hash_atom(value: "p2")
  let h3 = content_hash_atom(value: "p3")
  let a = DemandIdentity {
    kind: parse_source_artifact_kind,
    subject: identity_structural_component(digest: content_hash_atom(value: "subj")),
    declared_inputs: [
      DeclaredInput { ref: "a", component: identity_structural_component(digest: h1) },
      DeclaredInput { ref: concat("b:", concat(h2.digest as String, ":c")) as NonEmptyStr, component: identity_structural_component(digest: h3) }
    ]
  }
  let b = DemandIdentity {
    kind: parse_source_artifact_kind,
    subject: identity_structural_component(digest: content_hash_atom(value: "subj")),
    declared_inputs: [
      DeclaredInput { ref: concat("a:", concat(h1.digest as String, ":b")) as NonEmptyStr, component: identity_structural_component(digest: h2) },
      DeclaredInput { ref: "c", component: identity_structural_component(digest: h3) }
    ]
  }
  let hostile = DemandIdentity {
    kind: parse_source_artifact_kind,
    subject: identity_structural_component(digest: content_hash_atom(value: "subj")),
    declared_inputs: [DeclaredInput { ref: "a:/ %\n1111deadbeef12", component: identity_structural_component(digest: h1) }]
  }
  let decoded_a = demand_identity_decode(encoded: demand_identity_canonical(demand: a) as String)
  let decoded_hostile = demand_identity_decode(encoded: demand_identity_canonical(demand: hostile) as String)
  ((demand_identity_canonical(demand: a) as String) == (demand_identity_canonical(demand: b) as String)) == false
    && (demand_identity_canonical_c1_lossy(demand: a) as String) == (demand_identity_canonical_c1_lossy(demand: b) as String)
    && match decoded_a {
      Absent => false
      Present { value: d } => (d.declared_inputs |> count()) == 2 && match get(xs: d.declared_inputs, index: 0) {
        Absent => false
        Present { value: i } => (i.ref as String) == "a"
      }
    }
    && match decoded_hostile {
      Absent => false
      Present { value: d } => match get(xs: d.declared_inputs, index: 0) {
        Absent => false
        Present { value: i } => (i.ref as String) == "a:/ %\n1111deadbeef12"
      }
    }
}

test fn structural_fingerprint_refuses_as_cross_run_store_key() -> Bool {
  let refused = admit_hash_family_for_scope(family: Fnv1a64StructuralFamily, scope: CrossRunScope)
  let store_refused = admit_hash_family_for_scope(family: Fnv1a64StructuralFamily, scope: PersistentStoreScope)
  let admitted = admit_hash_family_for_scope(family: Sha256Family, scope: CrossRunScope)
  let index_ok = admit_hash_family_for_scope(family: Fnv1a64StructuralFamily, scope: InProcessIndexScope)
  let sha1 = admit_hash_family_for_scope(family: Sha1Family, scope: PersistentStoreScope)
  match refused {
    StructuralFingerprintRefusedAsStoreKey { family: _, scope: _ } =>
      match store_refused {
        StructuralFingerprintRefusedAsStoreKey { family: _, scope: _ } =>
          match admitted {
            HashFamilyAdmittedForScope { family: _, scope: _ } =>
              match index_ok {
                HashFamilyAdmittedForScope { family: _, scope: _ } =>
                  match sha1 {
                    FamilyNotAdmittedForRelation { family: _, scope: _ } => true
                    HashFamilyAdmittedForScope { family: _, scope: _ } => false
                    StructuralFingerprintRefusedAsStoreKey { family: _, scope: _ } => false
                  }
                StructuralFingerprintRefusedAsStoreKey { family: _, scope: _ } => false
                FamilyNotAdmittedForRelation { family: _, scope: _ } => false
              }
            StructuralFingerprintRefusedAsStoreKey { family: _, scope: _ } => false
            FamilyNotAdmittedForRelation { family: _, scope: _ } => false
          }
        HashFamilyAdmittedForScope { family: _, scope: _ } => false
        FamilyNotAdmittedForRelation { family: _, scope: _ } => false
      }
    HashFamilyAdmittedForScope { family: _, scope: _ } => false
    FamilyNotAdmittedForRelation { family: _, scope: _ } => false
  }
}

test fn evaluation_result_binding_same_eval_different_content_is_conflict() -> Bool {
  let eval = request_evaluation_identity(req: witness_parse_request())
  let bucket = as_content_hash_structural(structural: content_hash_atom(value: "shared-fnv-bucket"))
  let left = result_content_identity(bucket: bucket, canonical_preimage: "result-a" as NonEmptyStr)
  let right = result_content_identity(bucket: bucket, canonical_preimage: "result-b" as NonEmptyStr)
  let binding = EvaluationResultBinding { evaluation_identity: eval, result_content_identity: left }
  let conflict = evaluation_result_binding_outcome(binding: binding, observed: right)
  let same = evaluation_result_binding_outcome(binding: binding, observed: left)
  let sha = match sha256_hex_digest(hex: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa") {
    Absent => as_content_hash_structural(structural: content_hash_atom(value: "fallback"))
    Present { value: d } => as_content_hash_cryptographic(digest: d)
  }
  let cross = evaluation_result_binding_outcome(
    binding: binding,
    observed: result_content_identity(bucket: sha, canonical_preimage: "result-a" as NonEmptyStr)
  )
  match conflict {
    EvaluationContentConflict { binding: _, observed: _ } =>
      match same {
        EvaluationResultConsistent =>
          match cross {
            EvaluationResultHashFamilyIncomparable { left: _, right: _ } => true
            EvaluationResultConsistent => false
            EvaluationContentConflict { binding: _, observed: _ } => false
            EvaluationResultUnverifiable { cause: _ } => false
          }
        EvaluationContentConflict { binding: _, observed: _ } => false
        EvaluationResultHashFamilyIncomparable { left: _, right: _ } => false
        EvaluationResultUnverifiable { cause: _ } => false
      }
    EvaluationResultConsistent => false
    EvaluationResultHashFamilyIncomparable { left: _, right: _ } => false
    EvaluationResultUnverifiable { cause: _ } => false
  }
}

test fn evaluation_result_binding_same_preimage_different_bucket_is_unverifiable() -> Bool {
  let eval = request_evaluation_identity(req: witness_parse_request())
  let pre = "same-result-preimage" as NonEmptyStr
  let left = result_content_identity(
    bucket: as_content_hash_structural(structural: content_hash_atom(value: "bucket-a")),
    canonical_preimage: pre
  )
  let right = result_content_identity(
    bucket: as_content_hash_structural(structural: content_hash_atom(value: "bucket-b")),
    canonical_preimage: pre
  )
  let binding = EvaluationResultBinding { evaluation_identity: eval, result_content_identity: left }
  match evaluation_result_binding_outcome(binding: binding, observed: right) {
    EvaluationResultUnverifiable { cause: _ } => true
    EvaluationResultConsistent => false
    EvaluationContentConflict { binding: _, observed: _ } => false
    EvaluationResultHashFamilyIncomparable { left: _, right: _ } => false
  }
}

test fn two_parses_occurrence_qualification_is_an_explicit_frontier() -> Bool {
  let d = dissolution_description(condition: two_parses_occurrence_qualification_frontier)
  (d.contains("v2.compiler.parse") || d.contains("tokenize"))
    && d.contains("OccurrenceIdAllocator")
    && d.contains("split-on-whitespace")
}

