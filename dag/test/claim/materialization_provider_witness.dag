fn lookup_is_refused_evaluation_preimage_mismatch(l: ProviderLookup) -> Bool {
  lookup_fold(
    l: l,
    hit: (a, i) => false,
    miss: k => false,
    kind_mismatch: (k, r, f) => false,
    wrong_artifact: (k, fk) => false,
    wrong_content: (k, r, o) => false,
    cross_family: (k, f) => false,
    incomplete: (k, m) => false,
    evaluation_preimage_mismatch: (k, e, f) => true,
    store_address_refused: (k, f, sc) => false,
    unqualified_persisted_format: k => false
  )
}

fn lookup_is_refused_unqualified_persisted_format(l: ProviderLookup) -> Bool {
  lookup_fold(
    l: l,
    hit: (a, i) => false,
    miss: k => false,
    kind_mismatch: (k, r, f) => false,
    wrong_artifact: (k, fk) => false,
    wrong_content: (k, r, o) => false,
    cross_family: (k, f) => false,
    incomplete: (k, m) => false,
    evaluation_preimage_mismatch: (k, e, f) => false,
    store_address_refused: (k, f, sc) => false,
    unqualified_persisted_format: k => true
  )
}

// Model-scoped witnesses for the std.materialization_provider contract (parent mandate 6B + rework
// blockers, PR 7385): every outcome arm exercised by execution on BOTH doors. RED directions
// covered: wrong-content refusal (poisoned payload must refuse, never hit/admit), declared-input
// miss (a changed declared input keys apart, and a stale artifact a sloppy backend returns anyway
// refuses as wrong-artifact — on serve AND on admit), kind-mismatch refusal on both doors (blocker
// 2 — a matching key with a mismatched kind is a malformed pre-contract artifact), identity DERIVED
// not asserted (blocker 3 plus review 44265 — the doors take no ComputationIdentity parameter at
// all, so a caller cannot assert a grade; the served grade comes from the binding, and every non-Ok
// binding derives IdentityUnknown with a located cause), and admission-weakening (blocker 1 —
// provider_admit derives required outputs from the request; the v1-shape incomplete artifact cannot
// be admitted against ResolveClosureRequest). Post-44175 the request is a coproduct, so the
// witnesses construct request VARIANTS and read kind/outputs through the derivations — an
// under-specified obligation roster is unrepresentable, which is why no witness can even express
// the weakened-roster attack any more; the chained-eviction witness folds the first admission
// instead of projecting a store from its refusal arms (the deleted admission_store). The v1-shape
// incomplete artifact (graph+source_indices, no compile-clean diagnostic union) is the modeled form
// of the v1 resolved-graph disk-hit refuse arm, which was the contract's first named consumer target
// until that disk tier was deleted on 2026-10-03.

fn witness_compiler() -> DeclaredInput {
  compiler_identity_input(digest: content_hash_atom(value: "compiler-identity-1"))
}

fn witness_import_a() -> InterfaceHash {
  content_hash_atom(value: "interface-a")
}

fn witness_import_a_changed() -> InterfaceHash {
  content_hash_atom(value: "interface-a-changed")
}

fn witness_typecheck_request() -> ArtifactRequest {
  TypecheckModuleRequest {
    source_digest: content_hash_atom(value: "module-source-1"),
    direct_import_interfaces: [witness_import_a()],
    compiler: witness_compiler()
  }
}

fn witness_typecheck_request_changed_input() -> ArtifactRequest {
  TypecheckModuleRequest {
    source_digest: content_hash_atom(value: "module-source-1"),
    direct_import_interfaces: [witness_import_a_changed()],
    compiler: witness_compiler()
  }
}

fn witness_closure_request() -> ArtifactRequest {
  ResolveClosureRequest {
    closure_digest: content_hash_atom(value: "closure-1"),
    compiler: witness_compiler()
  }
}

fn witness_part(payload: String, bytes: Int) -> ArtifactPart {
  ArtifactPart { digest: content_hash_atom(value: payload), bytes: byte_size(count: bytes) }
}

fn witness_labelled_part(id: ArtifactOutputId, payload: String, bytes: Int) -> CarriedOutput {
  CarriedOutput { id: id, digest: content_hash_atom(value: payload), bytes: byte_size(count: bytes) }
}

fn witness_graph_part() -> ArtifactPart {
  witness_part(payload: "closure-graph-1", bytes: 60)
}

fn witness_indices_part() -> ArtifactPart {
  witness_part(payload: "closure-indices-1", bytes: 25)
}

fn witness_union_part() -> ArtifactPart {
  witness_part(payload: "closure-diagnostics-1", bytes: 15)
}

fn witness_complete_closure_artifact() -> MaterializedArtifact {
  ResolvedGraphArtifact {
    request_key: request_key(req: witness_closure_request()),
    resolved_graph: witness_graph_part(),
    source_indices: witness_indices_part(),
    compile_clean_diagnostic_union: witness_union_part()
  }
}

fn witness_v1_shape_closure_artifact() -> MaterializedArtifact {
  LegacyIncompleteArtifact {
    kind: resolved_graph_artifact_kind,
    request_key: request_key(req: witness_closure_request()),
    carried_outputs: [
      witness_labelled_part(id: output_resolved_graph, payload: "closure-graph-1", bytes: 60),
      witness_labelled_part(id: output_source_indices, payload: "closure-indices-1", bytes: 25)
    ]
  }
}

fn witness_kind_forged_closure_artifact() -> MaterializedArtifact {
  ParsedArtifact {
    request_key: request_key(req: witness_closure_request()),
    parse_tree: witness_graph_part(),
    parse_diagnostics: witness_indices_part()
  }
}

fn witness_closure_digest() -> ContentHash {
  artifact_content_digest(artifact: witness_complete_closure_artifact())
}

fn witness_v1_shape_digest() -> ContentHash {
  artifact_content_digest(artifact: witness_v1_shape_closure_artifact())
}

fn minted_in_process(
  req: ArtifactRequest,
  artifact: MaterializedArtifact,
  observed_digest: ContentHash
) -> ProviderProbe {
  in_process_materialization(req: req, artifact: artifact, observed_digest: observed_digest)
}

fn witness_good_probe() -> ProviderProbe {
  minted_in_process(
    req: witness_closure_request(),
    artifact: witness_complete_closure_artifact(),
    observed_digest: witness_closure_digest()
  )
}

fn witness_stale_typed_artifact() -> MaterializedArtifact {
  TypedModuleArtifact {
    request_key: request_key(req: witness_typecheck_request()),
    typed_module_interface: witness_part(payload: "typed-payload-1", bytes: 6),
    typecheck_diagnostics: witness_part(payload: "typed-diagnostics-1", bytes: 4)
  }
}

fn witness_stale_typed_digest() -> ContentHash {
  artifact_content_digest(artifact: witness_stale_typed_artifact())
}

fn witness_empty_store(budget_count: Int) -> ArtifactStore {
  ArtifactStore { at_capacity: ReplaceExisting { strategy: LeastRecentlyUsed }, budget: byte_size(count: budget_count), next_ordinal: 1, rows: [] }
}

test fn request_kinds_ground_on_cache_identity_rows() -> Bool {
  let parse_req = ParseModuleRequest {
    source_digest: content_hash_atom(value: "module-source-1"),
    compiler: witness_compiler()
  }
  (request_kind(req: parse_req) == parse_source_artifact_kind)
    && (request_kind(req: witness_typecheck_request()) == typed_module_artifact_kind)
    && (request_kind(req: witness_closure_request()) == resolved_graph_artifact_kind)
}

// THE VERDICT REQUEST IS THE PARSE REQUEST PROJECTED, NOT A SECOND IDENTITY: subject and declared inputs are
// read from the parse contract, so they cannot disagree; only the kind and the required parts differ, so
// the two keys are apart (a verdict is never served as a tree) and the verdict carries no tree part.
fn witness_parse_tree_request() -> ArtifactRequest {
  ParseModuleRequest { source_digest: content_hash_atom(value: "module-source-1"), compiler: witness_compiler() }
}

fn witness_parse_verdict_request() -> ArtifactRequest {
  ParseVerdictRequest { source_digest: content_hash_atom(value: "module-source-1"), compiler: witness_compiler() }
}

test fn a_parse_verdict_request_shares_the_parse_requests_subject_and_inputs() -> Bool {
  (request_declared_inputs(req: witness_parse_tree_request()) == request_declared_inputs(req: witness_parse_verdict_request()))
    && (request_kind(req: witness_parse_verdict_request()) == parse_verdict_artifact_kind)
    && (request_kind(req: witness_parse_tree_request()) == parse_source_artifact_kind)
    && (request_judgment_contract(req: witness_parse_tree_request()).demand_identity.subject == request_judgment_contract(req: witness_parse_verdict_request()).demand_identity.subject)
}

test fn a_parse_verdict_requires_the_verdict_and_diagnostics_and_no_tree() -> Bool {
  let outs = request_required_outputs(req: witness_parse_verdict_request())
  output_list_contains(xs: outs, wanted: output_parse_verdict)
    && output_list_contains(xs: outs, wanted: output_parse_diagnostics)
    && (output_list_contains(xs: outs, wanted: output_parse_tree) == false)
    && output_list_contains(xs: request_required_outputs(req: witness_parse_tree_request()), wanted: output_parse_tree)
}

test fn a_parse_verdict_request_keys_apart_from_the_parse_request() -> Bool {
  (request_key(req: witness_parse_tree_request()) == request_key(req: witness_parse_verdict_request())) == false
}

test fn a_parse_verdict_changes_key_when_the_parser_input_changes() -> Bool {
  let a = ParseVerdictRequest { source_digest: content_hash_atom(value: "module-source-1"), compiler: witness_compiler() }
  let b = ParseVerdictRequest { source_digest: content_hash_atom(value: "module-source-2"), compiler: witness_compiler() }
  (request_key(req: a) == request_key(req: b)) == false
}

test fn request_key_is_deterministic() -> Bool {
  request_key(req: witness_typecheck_request()) == request_key(req: witness_typecheck_request())
}

test fn declared_input_identity_is_in_the_key() -> Bool {
  (request_key(req: witness_typecheck_request()) == request_key(req: witness_typecheck_request_changed_input())) == false
}

test fn request_kind_is_in_the_key() -> Bool {
  let parse_req = ParseModuleRequest {
    source_digest: content_hash_atom(value: "shared-subject"),
    compiler: witness_compiler()
  }
  let closure_req = ResolveClosureRequest {
    closure_digest: content_hash_atom(value: "shared-subject"),
    compiler: witness_compiler()
  }
  (request_key(req: parse_req) == request_key(req: closure_req)) == false
}

test fn complete_verified_artifact_serves_as_hit() -> Bool {
  lookup_is_hit(l: provider_serve(
    req: witness_closure_request(),
    probe: witness_good_probe()
  ))
}

test fn absent_probe_is_a_miss() -> Bool {
  lookup_is_miss(l: provider_serve(
    req: witness_closure_request(),
    probe: ProbeAbsent
  ))
}

test fn red_kind_mismatch_refuses_even_on_matching_key_and_content() -> Bool {
  let forged = provider_serve(
    req: witness_closure_request(),
    probe: minted_in_process(
      req: witness_closure_request(),
      artifact: witness_kind_forged_closure_artifact(),
      observed_digest: witness_closure_digest()
    )
  )
  lookup_is_refused_kind_mismatch(l: forged) && (lookup_is_hit(l: forged) == false)
}

test fn red_declared_input_miss_stale_artifact_refuses_as_wrong_artifact() -> Bool {
  let stale = provider_serve(
    req: witness_typecheck_request_changed_input(),
    probe: minted_in_process(
      req: witness_typecheck_request_changed_input(),
      artifact: witness_stale_typed_artifact(),
      observed_digest: witness_stale_typed_digest()
    )
  )
  lookup_is_refused_wrong_artifact(l: stale) && (lookup_is_hit(l: stale) == false)
}

test fn red_wrong_content_refuses_never_hits() -> Bool {
  let poisoned = provider_serve(
    req: witness_closure_request(),
    probe: minted_in_process(
      req: witness_closure_request(),
      artifact: witness_complete_closure_artifact(),
      observed_digest: Fnv1a64(content_hash_atom(value: "closure-payload-corrupt"))
    )
  )
  lookup_is_refused_wrong_content(l: poisoned) && (lookup_is_hit(l: poisoned) == false)
}

test fn red_sha256_at_fnv1a64_seam_refuses_without_alias() -> Bool {
  match sha256_hex_digest(
    hex: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  ) {
    Present { value: sha_a } =>
      match sha256_hex_digest(
        hex: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
      ) {
        Present { value: sha_b } => {
          let refused_a = serve_resolved_graph_stored_disk_probe(
            closure_digest: as_content_hash_cryptographic(digest: sha_a),
            compiler_digest: as_content_hash_structural(structural: content_hash_atom(value: "compiler-identity-1")),
            stored_request_key: as_content_hash_structural(structural: content_hash_atom(value: "closure-1")),
            stored_semantic_digest: witness_closure_digest(),
            graph_digest: as_content_hash_structural(structural: content_hash_atom(value: "closure-graph-1")),
            graph_bytes: byte_size(count: 60),
            indices_digest: as_content_hash_structural(structural: content_hash_atom(value: "closure-indices-1")),
            indices_bytes: byte_size(count: 25),
            union_digest: as_content_hash_structural(structural: content_hash_atom(value: "closure-diagnostics-1")),
            union_bytes: byte_size(count: 15)
          )
          let refused_b = serve_resolved_graph_stored_disk_probe(
            closure_digest: as_content_hash_cryptographic(digest: sha_b),
            compiler_digest: as_content_hash_structural(structural: content_hash_atom(value: "compiler-identity-1")),
            stored_request_key: as_content_hash_structural(structural: content_hash_atom(value: "closure-1")),
            stored_semantic_digest: witness_closure_digest(),
            graph_digest: as_content_hash_structural(structural: content_hash_atom(value: "closure-graph-1")),
            graph_bytes: byte_size(count: 60),
            indices_digest: as_content_hash_structural(structural: content_hash_atom(value: "closure-indices-1")),
            indices_bytes: byte_size(count: 25),
            union_digest: as_content_hash_structural(structural: content_hash_atom(value: "closure-diagnostics-1")),
            union_bytes: byte_size(count: 15)
          )
          lookup_is_refused_cross_family_content_hash(l: refused_a)
            && lookup_is_refused_cross_family_content_hash(l: refused_b)
            && (lookup_is_hit(l: refused_a) == false)
            && (lookup_is_hit(l: refused_b) == false)
            && (refused_a != refused_b)
        }
        Absent => false
      }
    Absent => false
  }
}

test fn stored_disk_probe_admitted_fnv_parts_refuse_unqualified_persisted_format() -> Bool {
  let fnv = as_content_hash_structural(structural: content_hash_atom(value: "closure-fnv-1"))
  lookup_is_refused_unqualified_persisted_format(l: serve_resolved_graph_stored_disk_probe(
    closure_digest: fnv,
    compiler_digest: as_content_hash_structural(structural: content_hash_atom(value: "compiler-identity-1")),
    stored_request_key: fnv,
    stored_semantic_digest: fnv,
    graph_digest: as_content_hash_structural(structural: content_hash_atom(value: "closure-graph-1")),
    graph_bytes: byte_size(count: 60),
    indices_digest: as_content_hash_structural(structural: content_hash_atom(value: "closure-indices-1")),
    indices_bytes: byte_size(count: 25),
    union_digest: as_content_hash_structural(structural: content_hash_atom(value: "closure-diagnostics-1")),
    union_bytes: byte_size(count: 15)
  ))
    && lookup_is_refused_unqualified_persisted_format(l: serve_resolved_graph_incomplete_stored_disk_probe(
      closure_digest: fnv,
      compiler_digest: as_content_hash_structural(structural: content_hash_atom(value: "compiler-identity-1")),
      stored_request_key: fnv,
      graph_digest: as_content_hash_structural(structural: content_hash_atom(value: "closure-graph-1")),
      graph_bytes: byte_size(count: 60),
      indices_digest: as_content_hash_structural(structural: content_hash_atom(value: "closure-indices-1")),
      indices_bytes: byte_size(count: 25)
    ))
}

test fn incomplete_v1_shape_artifact_refuses_naming_the_diagnostic_union() -> Bool {
  let refused = provider_serve(
    req: witness_closure_request(),
    probe: minted_in_process(
      req: witness_closure_request(),
      artifact: witness_v1_shape_closure_artifact(),
      observed_digest: witness_v1_shape_digest()
    )
  )
  let missing = lookup_refused_incomplete_missing(l: refused)
  (missing.count() == 1)
    && output_list_contains(xs: missing, wanted: output_compile_clean_diagnostic_union)
    && (lookup_is_hit(l: refused) == false)
}

test fn admission_within_budget_is_admitted_without_eviction() -> Bool {
  let a = provider_admit(
    store: witness_empty_store(budget_count: 1000),
    req: witness_closure_request(),
    artifact: witness_complete_closure_artifact(),
    observed_digest: witness_closure_digest()
  )
  admission_is_admitted(a: a) && (admission_evicted_keys(a: a).count() == 0)
}

test fn admission_over_budget_evicts_least_recent_and_counts_it() -> Bool {
  let store0 = witness_empty_store(budget_count: 150)
  let first_artifact = witness_complete_closure_artifact()
  let first_key = request_key(req: witness_closure_request())
  let second_request = ResolveClosureRequest {
    closure_digest: content_hash_atom(value: "closure-2"),
    compiler: witness_compiler()
  }
  let second_artifact = ResolvedGraphArtifact {
    request_key: request_key(req: second_request),
    resolved_graph: witness_part(payload: "closure-graph-2", bytes: 60),
    source_indices: witness_part(payload: "closure-indices-2", bytes: 25),
    compile_clean_diagnostic_union: witness_part(payload: "closure-diagnostics-2", bytes: 15)
  }
  let first_admit = provider_admit(
    store: store0,
    req: witness_closure_request(),
    artifact: first_artifact,
    observed_digest: witness_closure_digest()
  )
  admission_fold(
    a: first_admit,
    admitted: fn(warmed, first_evicted) {
      let second_admit = provider_admit(
        store: warmed,
        req: second_request,
        artifact: second_artifact,
        observed_digest: artifact_content_digest(artifact: second_artifact)
      )
      let evicted = admission_evicted_keys(a: second_admit)
      admission_is_admitted(a: second_admit)
        && (first_evicted.count() == 0)
        && (evicted.count() == 1)
        && (evicted |> fold(init: false, f: (acc, k) => acc || (k == first_key)))
    },
    kind_mismatch_write: (r, f) => false,
    wrong_artifact_write: (k, fk) => false,
    wrong_content_write: (r, o) => false,
    incomplete_write: m => false,
    budget_exhausted: (n, b) => false,
    capacity_exhausted: (n, a) => false,
    policy_refused: c => false
  )
}

test fn retained_provider_reports_capacity_without_eviction() -> Bool {
  let artifact = witness_complete_closure_artifact()
  let store = ArtifactStore { budget: artifact_bytes(artifact: artifact), at_capacity: RefuseNewStore, next_ordinal: 1, rows: [] }
  let req = ResolveClosureRequest { closure_digest: content_hash_atom(value: "another-closure"), compiler: witness_compiler() }
  let next = ResolvedGraphArtifact {
    request_key: request_key(req: req),
    resolved_graph: witness_part(payload: "next-graph", bytes: 60),
    source_indices: witness_part(payload: "next-indices", bytes: 25),
    compile_clean_diagnostic_union: witness_part(payload: "next-diagnostics", bytes: 15),
  }
  admission_fold(
    a: provider_admit(store: store, req: witness_closure_request(), artifact: artifact, observed_digest: artifact_content_digest(artifact: artifact)),
    admitted: (held, evicted) => {
      let refused = provider_admit(store: held, req: req, artifact: next, observed_digest: artifact_content_digest(artifact: next))
      count(evicted) == 0 && refused == ProviderCapacityExhausted { needed: artifact_bytes(artifact: next), available: byte_size(count: 0) }
        && count(admission_evicted_keys(a: refused)) == 0
    },
    kind_mismatch_write: (r, f) => false,
    wrong_artifact_write: (k, fk) => false,
    wrong_content_write: (r, o) => false,
    incomplete_write: m => false,
    budget_exhausted: (n, b) => false,
    capacity_exhausted: (n, a) => false,
    policy_refused: c => false,
  )
}

test fn admission_of_oversized_artifact_is_budget_exhausted() -> Bool {
  let a = provider_admit(
