module test.claim.cable_plant_assessment_witness

import std.types { Bool, List, NonEmptyStr }
import extdeps.ethernet.link_mode { ieee_100gbase_cr2 }
import extdeps.transceiver.sff_8636 {
  sff8636_nominal_rate_from_byte140,
  transceiver_identifier_from_byte, sff8636_encoding_from_byte,
}
import product.cable_leg_observation {
  CableLegObservation, SecondaryObserved, cable_leg_observation,
  ExtendedRateObserved,
}
import product.cable_plant_assessment {
  CablePlant, cable_plant, CableLegReading, LegNeverRead, LegReadingTaken,
  CablePlantObserved, CablePlantReceipt, CableLegOutcome,
  PlantHoldsNoLegs,
  inspect_cable_plant,
}
import std.goal_assessment {
  GoalInspected, GoalObservationRefused,
  GoalSatisfied, GoalDiverged, GoalIndeterminate, GoalAssessmentRefused,
}
import v2.std.algebra { non_empty_to_list }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

// GREEN BY EXECUTION FOR THE INSTALLED PLANT. The order gates answer "should this be bought"; this
// answers "is what is in the racks still what we need", and on this fleet today the honest answer
// is no. The witness holds that no, so a later change cannot quietly turn the running fabric green.
data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// The FS QDD-400G-4QPC015 leg as read off the delivered cable on 2026-09-08 (`ethtool -m raw on`,
// spark-a3ee and spark-ac79, identical): identifier 11h, primary extended compliance 0Bh, secondary
// compliance 00h, encoding 8, byte 140 at the FFh escape resolving through byte 222 = 6Ah.
data delivered_fs_leg: CableLegObservation = cable_leg_observation(
  identifier: transceiver_identifier_from_byte(code: 17),
  primary_compliance_code: 11,
  secondary_compliance: SecondaryObserved { code: 0 },
  encoding: sff8636_encoding_from_byte(code: 8),
  nominal_rate: sff8636_nominal_rate_from_byte140(code: 255),
  extended_rate: ExtendedRateObserved { code: 106 })

// The same copper with the coding the rail actually needs: secondary 40h is SFF-8024's
// 50GBASE-CR / 100GBASE-CR2 / 200GBASE-CR4 row.
data correctly_coded_leg: CableLegObservation = cable_leg_observation(
  identifier: transceiver_identifier_from_byte(code: 17),
  primary_compliance_code: 11,
  secondary_compliance: SecondaryObserved { code: 64 },
  encoding: sff8636_encoding_from_byte(code: 8),
  nominal_rate: sff8636_nominal_rate_from_byte140(code: 255),
  extended_rate: ExtendedRateObserved { code: 106 })

data installed_plant: CablePlant = cable_plant(
  plant: "spark fabric, CRS812 QSFP-DD breakout legs" as NonEmptyStr,
  required_mode: ieee_100gbase_cr2,
  readings: [
    LegReadingTaken { endpoint: "qsfp56-dd-1-1" as NonEmptyStr, observation: delivered_fs_leg },
    LegReadingTaken { endpoint: "qsfp56-dd-1-3" as NonEmptyStr, observation: delivered_fs_leg },
  ],
)

data repaired_plant: CablePlant = cable_plant(
  plant: "spark fabric, CRS812 QSFP-DD breakout legs" as NonEmptyStr,
  required_mode: ieee_100gbase_cr2,
  readings: [
    LegReadingTaken { endpoint: "qsfp56-dd-1-1" as NonEmptyStr, observation: correctly_coded_leg },
    LegReadingTaken { endpoint: "qsfp56-dd-1-3" as NonEmptyStr, observation: correctly_coded_leg },
  ],
)

data partially_read_plant: CablePlant = cable_plant(
  plant: "spark fabric, CRS812 QSFP-DD breakout legs" as NonEmptyStr,
  required_mode: ieee_100gbase_cr2,
  readings: [
    LegReadingTaken { endpoint: "qsfp56-dd-1-1" as NonEmptyStr, observation: correctly_coded_leg },
    LegNeverRead { endpoint: "qsfp56-dd-1-3" as NonEmptyStr },
  ],
)

// THE MIXED FIXTURE. One leg is read and is mis-coded; another was never read. The first cut
// refused the whole observation here and discarded the proved mis-coding.
data one_miscoded_one_unread_plant: CablePlant = cable_plant(
  plant: "spark fabric, CRS812 QSFP-DD breakout legs" as NonEmptyStr,
  required_mode: ieee_100gbase_cr2,
  readings: [
    LegReadingTaken { endpoint: "qsfp56-dd-1-1" as NonEmptyStr, observation: delivered_fs_leg },
    LegNeverRead { endpoint: "qsfp56-dd-1-3" as NonEmptyStr },
  ],
)

data empty_plant: CablePlant = cable_plant(
  plant: "a rack nobody has cabled yet" as NonEmptyStr,
  required_mode: ieee_100gbase_cr2,
  readings: [],
)

// THE CENTRAL WITNESS: the fabric as it stands does not converge, and the refusal names the legs.
test fn the_installed_plant_does_not_converge() -> Bool {
  match inspect_cable_plant(subject: installed_plant) {
    GoalObservationRefused { subject: s, goal: g, request: rq, cause: c } => false
    GoalInspected { subject: s, goal: g, request: rq, observed: o, assessment: a } =>
      match a {
        GoalDiverged { deviations: ds } => list_length(items: non_empty_to_list(xs: ds)) == 2
        GoalSatisfied { evidence: e } => false
        GoalIndeterminate { known_deviations: kd, unknowns: u } => false
        GoalAssessmentRefused { cause: c } => false
      }
  }
}

// THE POSITIVE CONTROL. Without it the refusal above could be produced by a plant that never
// converges for any input, which would make the wall decoration rather than a check.
test fn a_correctly_coded_plant_converges() -> Bool {
  match inspect_cable_plant(subject: repaired_plant) {
    GoalObservationRefused { subject: s, goal: g, request: rq, cause: c } => false
    GoalInspected { subject: s, goal: g, request: rq, observed: o, assessment: a } =>
      match a {
        GoalSatisfied { evidence: e } => e.legs_read == 2
        GoalDiverged { deviations: ds } => false
        GoalIndeterminate { known_deviations: kd, unknowns: u } => false
        GoalAssessmentRefused { cause: c } => false
      }
  }
}

// AN UNREAD LEG IS AN UNKNOWN, NOT A FAILED READ AND NOT A LEG TO DROP. This is still the
// discriminating input for the absorbing fallback -- a plant reported over its read subset would
// converge here, because the leg that WAS read is correctly coded -- but the honest answer is
// indeterminate, carrying the endpoint nobody measured.
test fn one_unread_leg_is_an_unknown_and_not_a_failed_read() -> Bool {
  match inspect_cable_plant(subject: partially_read_plant) {
    GoalObservationRefused { subject: s, goal: g, request: rq, cause: c } => false
    GoalInspected { subject: s, goal: g, request: rq, observed: o, assessment: a } =>
      match a {
        GoalIndeterminate { known_deviations: kd, unknowns: u } =>
          list_length(items: kd) == 0 && u.head.endpoint == ("qsfp56-dd-1-3" as NonEmptyStr)
        GoalSatisfied { evidence: e } => false
        GoalDiverged { deviations: ds } => false
        GoalAssessmentRefused { cause: c2 } => false
      }
  }
}

// THE CONTROL THAT PROVES THE FOURTH ARM DOES REAL WORK. A mis-coded leg and an unread leg must
// both be reported: the unknown does not suppress the proved deviation. Under the shape this
// replaces the whole observation refused and the mis-coding was never reported.
test fn a_miscoded_leg_and_an_unread_leg_are_reported_together() -> Bool {
  match inspect_cable_plant(subject: one_miscoded_one_unread_plant) {
    GoalObservationRefused { subject: s, goal: g, request: rq, cause: c } => false
    GoalInspected { subject: s, goal: g, request: rq, observed: o, assessment: a } =>
      match a {
        GoalIndeterminate { known_deviations: kd, unknowns: u } =>
          list_length(items: kd) == 1 && u.head.endpoint == ("qsfp56-dd-1-3" as NonEmptyStr)
        GoalSatisfied { evidence: e } => false
        GoalDiverged { deviations: ds } => false
        GoalAssessmentRefused { cause: c2 } => false
      }
  }
}

// A SUBJECT WITH NOTHING IN IT DOES NOT CONVERGE, and the reason is that there is no denominator to
// assess against -- an ill-formed question, not a read that failed. Zero legs agree trivially, and a
// green derived from an empty population is the vacuous pass DESIGN section 5 refuses.
test fn an_empty_plant_refuses_the_assessment() -> Bool {
  match inspect_cable_plant(subject: empty_plant) {
    GoalObservationRefused { subject: s, goal: g, request: rq, cause: c } => false
    GoalInspected { subject: s, goal: g, request: rq, observed: o, assessment: a } =>
      match a {
        GoalAssessmentRefused { cause: c2 } =>
          match c2 { PlantHoldsNoLegs { required: r } => true }
        GoalSatisfied { evidence: e } => false
        GoalDiverged { deviations: ds } => false
        GoalIndeterminate { known_deviations: kd, unknowns: u } => false
      }
  }
}

// THE REFUSAL CARRIES THE ENDPOINTS, not just a count: an operator reading this needs to know which
// port to walk to. A refusal that said only "the plant diverges" would be a diagnostic without a
// location, which is the half of fail-closed DESIGN section 5 asks for by name.
test fn the_refusal_names_the_diverging_endpoints() -> Bool {
  match inspect_cable_plant(subject: installed_plant) {
    GoalObservationRefused { subject: s, goal: g, request: rq, cause: c } => false
    GoalInspected { subject: s, goal: g, request: rq, observed: o, assessment: a } =>
      match a {
        GoalDiverged { deviations: ds } => ds.head.endpoint == ("qsfp56-dd-1-1" as NonEmptyStr)
        GoalSatisfied { evidence: e } => false
        GoalIndeterminate { known_deviations: kd, unknowns: u } => false
        GoalAssessmentRefused { cause: c } => false
      }
  }
}
