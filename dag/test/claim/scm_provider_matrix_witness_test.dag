  azure_hot_gzrs_write_operations,
  azure_hot_lrs_tier0,
  azure_hot_lrs_tier_50tb,
  azure_hot_lrs_tier_500tb,
  azure_hot_lrs_write_operations,
  azure_hot_read_operations,
  evaluate_reliability,
