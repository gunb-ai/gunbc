import gunbc.econ.scm_serving_model {
  BasisAssumed,
  ProviderQuote,
  ProviderQuoteRefused,
  ProviderQuoted,
  RequestsBilled,
  RequestsIncludedAtNoCharge,
  ScmWorkloadProfile,
  profile_at_user_count,
