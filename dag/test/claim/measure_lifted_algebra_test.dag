module test.claim.measure_lifted_algebra


data live_tree_disposition: LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn scale_fraction_exact_holds() -> Bool {
  std.measure.byte_size_count(b: std.measure.measure_scale_fraction_floor(m: std.measure.byte_size(10), num: 4, den: 5)) == 8
}

fn scale_fraction_floors_not_rounds_holds() -> Bool {
  std.measure.byte_size_count(b: std.measure.measure_scale_fraction_floor(m: std.measure.byte_size(7), num: 1, den: 2)) == 3
}

fn scale_fraction_zero_den_is_zero_holds() -> Bool {
  std.measure.byte_size_count(b: std.measure.measure_scale_fraction_floor(m: std.measure.byte_size(100), num: 4, den: 0)) == 0
}

fn fit_count_exact_holds() -> Bool {
  std.measure.measure_fit_count_floor(capacity: std.measure.byte_size(10), each: std.measure.byte_size(5)) == 2
}

fn fit_count_floors_not_rounds_holds() -> Bool {
  std.measure.measure_fit_count_floor(capacity: std.measure.byte_size(7), each: std.measure.byte_size(2)) == 3
}

fn fit_count_zero_divisor_is_zero_holds() -> Bool {
  std.measure.measure_fit_count_floor(capacity: std.measure.byte_size(7), each: std.measure.byte_size(0)) == 0
}

fn scale_fraction_generic_over_quantity_holds() -> Bool {
  std.measure.hertz_count(h: std.measure.measure_scale_fraction_floor(m: std.measure.hertz(9), num: 2, den: 4)) == 4
}

fn fit_count_generic_over_quantity_holds() -> Bool {
  std.measure.measure_fit_count_floor(capacity: std.measure.hertz(9), each: std.measure.hertz(4)) == 2
}

fn scale_fraction_ceil_exact_holds() -> Bool {
  std.measure.byte_size_count(b: std.measure.measure_scale_fraction_ceil(m: std.measure.byte_size(8), num: 1, den: 4)) == 2
}

fn scale_fraction_ceil_rounds_up_holds() -> Bool {
  std.measure.byte_size_count(b: std.measure.measure_scale_fraction_ceil(m: std.measure.byte_size(7), num: 1, den: 2)) == 4
    && std.measure.byte_size_count(b: std.measure.measure_scale_fraction_floor(m: std.measure.byte_size(7), num: 1, den: 2)) == 3
}

fn scale_fraction_ceil_remainder_to_one_holds() -> Bool {
  std.measure.byte_size_count(b: std.measure.measure_scale_fraction_ceil(m: std.measure.byte_size(10), num: 1, den: 4)) == 3
}

fn scale_fraction_ceil_zero_den_is_whole_holds() -> Bool {
  std.measure.byte_size_count(b: std.measure.measure_scale_fraction_ceil(m: std.measure.byte_size(100), num: 4, den: 0)) == 400
}

fn scale_fraction_ceil_generic_over_quantity_holds() -> Bool {
  std.measure.hertz_count(h: std.measure.measure_scale_fraction_ceil(m: std.measure.hertz(9), num: 1, den: 2)) == 5
}

test fn measure_lifted_algebra_witnesses() -> Bool {
  scale_fraction_exact_holds()
    && scale_fraction_floors_not_rounds_holds()
    && scale_fraction_zero_den_is_zero_holds()
    && fit_count_exact_holds()
    && fit_count_floors_not_rounds_holds()
    && fit_count_zero_divisor_is_zero_holds()
    && scale_fraction_generic_over_quantity_holds()
    && fit_count_generic_over_quantity_holds()
    && scale_fraction_ceil_exact_holds()
    && scale_fraction_ceil_rounds_up_holds()
    && scale_fraction_ceil_remainder_to_one_holds()
    && scale_fraction_ceil_zero_den_is_whole_holds()
    && scale_fraction_ceil_generic_over_quantity_holds()
}
