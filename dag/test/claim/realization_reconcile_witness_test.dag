module test.claim.realization_reconcile_witness

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn is_share(m: Materialization) -> Bool {
  match m {
    Share => true
    Recompute => false
    Memoize => false
  }
}

fn step_create_if_absent(field: String) -> RealizedStep {
  RealizedStep {
    shape: CreateEffect { cause: std.effects.CreateIfAbsent { key_source: InputField { field: field } } },
    placement: LocalInProcess,
    materialization: Recompute,
    cost: cost_account_predicted_zero()
  }
}

fn step_post_always() -> RealizedStep {
  RealizedStep {
    shape: CreateEffect { cause: PostAlways },
    placement: LocalInProcess,
    materialization: Recompute,
    cost: cost_account_predicted_zero()
  }
}

fn has_exactly_one_share<S>(steps: List<RealizedStep<S>>) -> Bool {
  (steps |> filter(e => is_share(m: e.materialization)) |> length) == 1
}

fn has_no_share<S>(steps: List<RealizedStep<S>>) -> Bool {
  (steps |> filter(e => is_share(m: e.materialization)) |> length) == 0
}

test fn witness_same_keysource_collapses_to_share() -> Bool {
  let out = std.realization.reconcile(steps: [
    step_create_if_absent(field: "id"),
    step_create_if_absent(field: "id")
  ])
  (out |> length) == 1 && has_exactly_one_share(steps: out)
}

test fn witness_different_keysource_does_not_collapse() -> Bool {
  let out = std.realization.reconcile(steps: [
    step_create_if_absent(field: "id"),
    step_create_if_absent(field: "other")
  ])
  (out |> length) == 2 && has_no_share(steps: out)
}

test fn witness_post_always_never_collapses() -> Bool {
  let out = std.realization.reconcile(steps: [ step_post_always(), step_post_always() ])
  (out |> length) == 2 && has_no_share(steps: out)
}

