module test.claim.observability_channel_routing

import std.types { Bool }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import extdeps.observability { ChannelCannotObserve, InBand, NetworkInventory, OutOfBand, ProcessorInventory, RoutedTo, StorageInventory, route_observation }
import extdeps.bmc.endpoint { AmiMegaRac, OpenBmc }
import extdeps.bmc.openbmc { HostStorageBlind, HostStorageEnumerable }
import gunbc.bmc_implementation_dispatch {
  HostStorageVisibilityKnown,
  HostStorageVisibilityUnobserved,
  bmc_firmware_host_storage_visibility,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn out_of_band_cannot_observe_storage() -> Bool {
  match route_observation(channel: OutOfBand, class: StorageInventory) {
    ChannelCannotObserve { channel: _, class: _ } => true
    RoutedTo { channel: _ } => false
  }
}

test fn in_band_observes_storage() -> Bool {
  match route_observation(channel: InBand, class: StorageInventory) {
    RoutedTo { channel: c } =>
      match c {
        InBand => true
        OutOfBand => false
      }
    ChannelCannotObserve { channel: _, class: _ } => false
  }
}

test fn out_of_band_observes_power_and_processor() -> Bool {
  match route_observation(channel: OutOfBand, class: PowerDraw) {
    RoutedTo { channel: _ } => true
    ChannelCannotObserve { channel: _, class: _ } => false
  }
    && match route_observation(channel: OutOfBand, class: ProcessorInventory) {
      RoutedTo { channel: _ } => true
      ChannelCannotObserve { channel: _, class: _ } => false
    }
}

test fn out_of_band_cannot_observe_network() -> Bool {
  match route_observation(channel: OutOfBand, class: NetworkInventory) {
    ChannelCannotObserve { channel: _, class: _ } => true
    RoutedTo { channel: _ } => false
  }
}

test fn out_of_band_storage_blindness_grounded_in_openbmc_finding() -> Bool {
  match bmc_firmware_host_storage_visibility(family: OpenBmc) {
    HostStorageVisibilityKnown { visibility: v } =>
      match v {
        HostStorageBlind =>
          match route_observation(channel: OutOfBand, class: StorageInventory) {
            ChannelCannotObserve { channel: _, class: _ } => true
            RoutedTo { channel: _ } => false
          }
        HostStorageEnumerable => false
      }
    HostStorageVisibilityUnobserved { family: _ } => false
  }
}

// The MegaRAC finding is unmeasured, and the dispatcher must say so rather
// than inherit OpenBMC's blindness or assume enumerability.
test fn megarac_storage_visibility_is_unobserved() -> Bool {
  match bmc_firmware_host_storage_visibility(family: AmiMegaRac) {
    HostStorageVisibilityUnobserved { family: f } => f == AmiMegaRac
    HostStorageVisibilityKnown { visibility: _ } => false
  }
}
