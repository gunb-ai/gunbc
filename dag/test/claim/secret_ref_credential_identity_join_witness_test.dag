module test.claim.secret_ref_credential_identity_join_witness

import std.types { Bool, NonEmptyStr }
import extdeps.cloud.gcp.gcp { GcpProjectId }
import extdeps.cloud.gcp.secret_ref { SecretRef, HashPending }
import extdeps.cloud.gcp.secret_manager { SmResolvedVersionIdentity }
import gunbc.auth.secret_ref_credential { resolved_identity_matches_request }

// THE JOIN THAT KEEPS AN ANSWER ABOUT THE QUESTION. fetch_secret_ref_credential requests an exact
// version and, before this check, handed back whatever payload came home while merely REPORTING the
// identity it was told. These rows exist because that check sits inside an effectful function where
// no witness can reach it, and an unreachable wall is the inert check 4b names.
data requested_ref: SecretRef = SecretRef {
  project: "gunbai-secrets" as GcpProjectId,
  secret: "printer-02-lan-access-code" as NonEmptyStr,
  version: "1" as NonEmptyStr,
  hash_state: HashPending,
}

fn the_identity_that_was_asked_for_is_accepted() -> Bool {
  resolved_identity_matches_request(
    identity: "projects/gunbai-secrets/secrets/printer-02-lan-access-code/versions/1" as SmResolvedVersionIdentity,
    requested: requested_ref)
}

// A DIFFERENT VERSION OF THE RIGHT SECRET IS THE MOTIVATING CASE. This is what a provider surprise
// or a wiring defect actually looks like: the container is right, the bytes are real, and they are
// the wrong generation of the credential. Before the join this returned Ready.
fn a_different_version_of_the_same_secret_is_refused() -> Bool {
  resolved_identity_matches_request(
    identity: "projects/gunbai-secrets/secrets/printer-02-lan-access-code/versions/2" as SmResolvedVersionIdentity,
    requested: requested_ref) == false
}

fn a_different_secret_in_the_same_project_is_refused() -> Bool {
  resolved_identity_matches_request(
    identity: "projects/gunbai-secrets/secrets/printer-01-lan-access-code/versions/1" as SmResolvedVersionIdentity,
    requested: requested_ref) == false
}

// THE CROSS-PROJECT ROW, because a suffix-shaped comparison would accept it and one already did
// elsewhere in this tree. Same secret id, same version, foreign project.
fn the_same_secret_and_version_in_a_foreign_project_is_refused() -> Bool {
  resolved_identity_matches_request(
    identity: "projects/someone-elses-project/secrets/printer-02-lan-access-code/versions/1" as SmResolvedVersionIdentity,
    requested: requested_ref) == false
}
