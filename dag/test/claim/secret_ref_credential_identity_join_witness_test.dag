module test.claim.secret_ref_credential_identity_join_witness

import std.types { Bool, NonEmptyStr, String }
import extdeps.cloud.gcp.gcp { GcpProjectId }
import extdeps.cloud.gcp.secret_ref {
  SecretRef, HashPending, gcp_resource_names_this_secret,
  SecretRefVersionResolution,
  SecretRefVersionResolvedExact,
  SecretRefVersionResolvedAlias,
  SecretRefVersionResolutionRefused,
  resolve_returned_version,
  latest_alias_literal,
}
import extdeps.cloud.gcp.secret_manager {
  SmResolvedVersionIdentity, sm_resolved_version_secret_resource,
  SmVersionSecretProjected, SmVersionSecretNotAVersionResource,
}
import gunbc.auth.github_gcp_federation { fleet_secrets_project_number }


// THE JOIN IS EXERCISED AT ITS OWN AUTHORITY. resolve_returned_version is where the accepted
// resource names are built, so that is the one interface these rows discriminate at; the credential
// fetch that consumes it sits inside an effectful function where no witness can reach, and an
// unreachable wall is the inert check 4b names.
fn join_admits_returned_identity(
  identity: SmResolvedVersionIdentity,
  requested: SecretRef,
) -> Bool {
  match resolve_returned_version(
    returned: identity,
    ref: requested,
    project_number: fleet_secrets_project_number
  ) {
    SecretRefVersionResolutionRefused { requested: _, returned: _ } => false
    SecretRefVersionResolvedExact { version: _ } => true
    SecretRefVersionResolvedAlias { alias: _, version: _ } => true
  }
}

// AND THE ARM MATTERS, NOT ONLY THE VERDICT. An alias admitted through the exact-version comparison
// would be a different mechanism reaching the same answer, so the alias rows below assert WHICH arm
// answered and what version it says was served -- otherwise a relaxation of the exact comparison
// would read as a pass for alias semantics it never implemented.
fn join_is_alias_serving(
  identity: SmResolvedVersionIdentity,
  requested: SecretRef,
  served: String,
) -> Bool {
  match resolve_returned_version(
    returned: identity,
    ref: requested,
    project_number: fleet_secrets_project_number
  ) {
    SecretRefVersionResolutionRefused { requested: _, returned: _ } => false
    SecretRefVersionResolvedExact { version: _ } => false
    SecretRefVersionResolvedAlias { alias: alias, version: v } =>
      (v as String) == served && (alias as String) == (latest_alias_literal as String)
  }
}

fn join_is_exact_serving(
  identity: SmResolvedVersionIdentity,
  requested: SecretRef,
  served: String,
) -> Bool {
  match resolve_returned_version(
    returned: identity,
    ref: requested,
    project_number: fleet_secrets_project_number
  ) {
    SecretRefVersionResolutionRefused { requested: _, returned: _ } => false
    SecretRefVersionResolvedAlias { alias: _, version: _ } => false
    SecretRefVersionResolvedExact { version: v } => (v as String) == served
  }
}

// THE JOIN THAT KEEPS AN ANSWER ABOUT THE QUESTION. fetch_secret_ref_credential requests an exact
// version and, before this check, handed back whatever payload came home while merely REPORTING the
// identity it was told. These rows exist because that check sits inside an effectful function where
// no witness can reach it, and an unreachable wall is the inert check 4b names.
data requested_ref: SecretRef = SecretRef {
  project: "gunbai-secrets" as GcpProjectId,
  secret: "printer-02-lan-access-code" as NonEmptyStr,
  version: "1" as NonEmptyStr,
  hash_state: HashPending,
}

test fn the_identity_that_was_asked_for_is_accepted() -> Bool {
  join_admits_returned_identity(
    identity: "projects/gunbai-secrets/secrets/printer-02-lan-access-code/versions/1" as SmResolvedVersionIdentity,
    requested: requested_ref)
}

// A DIFFERENT VERSION OF THE RIGHT SECRET IS THE MOTIVATING CASE. This is what a provider surprise
// or a wiring defect actually looks like: the container is right, the bytes are real, and they are
// the wrong generation of the credential. Before the join this returned Ready.
test fn a_different_version_of_the_same_secret_is_refused() -> Bool {
  join_admits_returned_identity(
    identity: "projects/gunbai-secrets/secrets/printer-02-lan-access-code/versions/2" as SmResolvedVersionIdentity,
    requested: requested_ref) == false
}

test fn a_different_secret_in_the_same_project_is_refused() -> Bool {
  join_admits_returned_identity(
    identity: "projects/gunbai-secrets/secrets/printer-01-lan-access-code/versions/1" as SmResolvedVersionIdentity,
    requested: requested_ref) == false
}

// THE CROSS-PROJECT ROW, because a suffix-shaped comparison would accept it and one already did
// elsewhere in this tree. Same secret id, same version, foreign project.
test fn the_same_secret_and_version_in_a_foreign_project_is_refused() -> Bool {
  join_admits_returned_identity(
    identity: "projects/someone-elses-project/secrets/printer-02-lan-access-code/versions/1" as SmResolvedVersionIdentity,
    requested: requested_ref) == false
}

// THE SPELLING THE SERVICE ACTUALLY ANSWERS IN, measured rather than assumed: AccessVersion returns
// "projects/582015116396/secrets/<id>/versions/<n>" for a request addressed by project ID. Every
// row above uses the ID form because that is what the REQUEST carries, so all of them were green
// while the join refused every real response. This row is the one that closes that gap.
test fn the_project_number_spelling_of_the_requested_version_is_accepted() -> Bool {
  join_admits_returned_identity(
    identity: "projects/582015116396/secrets/printer-02-lan-access-code/versions/1" as SmResolvedVersionIdentity,
    requested: requested_ref)
}

// AND A FOREIGN PROJECT NUMBER IS STILL REFUSED, so accepting a second spelling does not become
// accepting any project that happens to be written in digits.
test fn a_foreign_project_number_version_is_refused() -> Bool {
  join_admits_returned_identity(
    identity: "projects/999999999999/secrets/printer-02-lan-access-code/versions/1" as SmResolvedVersionIdentity,
    requested: requested_ref) == false
}

// A DIFFERENT VERSION IN THE NUMBER SPELLING IS STILL REFUSED -- the wrong-generation case must not
// be lost when the project spelling is relaxed.
test fn a_different_version_in_the_number_spelling_is_refused() -> Bool {
  join_admits_returned_identity(
    identity: "projects/582015116396/secrets/printer-02-lan-access-code/versions/2" as SmResolvedVersionIdentity,
    requested: requested_ref) == false
}

// THE MATERIALIZATION JOIN, WITNESSED AT THE GRAIN A FIXTURE CAN REACH.
//
// verification_names_secret takes a VerifiedVersionForAttempt, which is sole_constructor -- no
// fixture can mint one, because possessing it IS the evidence that this process performed the write
// and read it back. That seal is correct and it is also why the function had no witness at all,
// which is how the project-number spelling bug survived three separate repairs and reached a live
// run: the join is unreachable from a test, so nothing went red.
//
// What IS authorable is the whole content of the join with the seal removed: take the version
// identity AddVersion actually returns -- the project NUMBER spelling -- project the secret resource
// out of it, and ask whether it names the secret a caller ADDRESSED by project ID. That composition
// is what the fixed function computes, and the number-spelling case is the discriminating one: it
// was false before the fix and is true after.
data addversion_returned_identity: SmResolvedVersionIdentity = "projects/582015116396/secrets/printer-02-lan-access-code/versions/1" as SmResolvedVersionIdentity

fn projected_secret_resource_names_request(
  identity: SmResolvedVersionIdentity,
  desired: SecretRef,
) -> Bool {
  match sm_resolved_version_secret_resource(identity: identity) {
    SmVersionSecretNotAVersionResource { supplied: _ } => false
    SmVersionSecretProjected { secret_resource: r } =>
      gcp_resource_names_this_secret(
        returned: r as String,
        project: desired.project,
        project_number: fleet_secrets_project_number,
        secret: desired.secret)
  }
}

test fn the_number_spelling_addversion_returns_joins_the_id_spelling_request() -> Bool {
  projected_secret_resource_names_request(
    identity: addversion_returned_identity, desired: requested_ref)
}

// THE POSITIVE CONTROL IN THE OTHER SPELLING, so a join that somehow accepted only the number form
// would not read as a pass. Both fully-qualified spellings of THIS project are one secret.
test fn the_id_spelling_also_joins_the_same_request() -> Bool {
  projected_secret_resource_names_request(
    identity: "projects/gunbai-secrets/secrets/printer-02-lan-access-code/versions/1" as SmResolvedVersionIdentity,
    desired: requested_ref)
}

// THE DISCRIMINATING RED THAT SEPARATES THIS FROM A SUFFIX COMPARISON. A suffix check would have
// made the live run pass too, and would accept every foreign project that happens to hold a secret
// of the same name -- which on a credential path is a cross-project read.
test fn a_foreign_project_number_does_not_join_this_request() -> Bool {
  !projected_secret_resource_names_request(
    identity: "projects/999999999999/secrets/printer-02-lan-access-code/versions/1" as SmResolvedVersionIdentity,
    desired: requested_ref)
}

test fn another_secret_in_this_project_does_not_join_this_request() -> Bool {
  !projected_secret_resource_names_request(
    identity: "projects/582015116396/secrets/printer-01-lan-access-code/versions/1" as SmResolvedVersionIdentity,
    desired: requested_ref)
}

// ---------------------------------------------------------------------------
// The alias request, which had no row here at all and is why this shipped
// ---------------------------------------------------------------------------

// BOTH ROWS OF THE HOST CREDENTIAL CUSTODY ROSTER REQUEST `latest`, and every row above requests an
// exact number, so the whole exact-comparison join was green while the path that actually runs
// refused every real response. Secret Manager admits `latest` in the version segment of a request
// and ANSWERS in a resolved number, so the answer matches neither spelling the old predicate built.
data latest_ref: SecretRef = SecretRef {
  project: "gunbai-secrets" as GcpProjectId,
  secret: "printer-02-lan-access-code" as NonEmptyStr,
  version: "latest" as NonEmptyStr,
  hash_state: HashPending,
}

// CONTROL 3: latest -> returned N, admitted THROUGH ALIAS SEMANTICS. The arm is asserted, not just
// the verdict: a comparison relaxed until a number matched would answer true here through the exact
// arm and this row would still go red.
test fn an_alias_request_resolves_to_the_number_the_service_served() -> Bool {
  join_is_alias_serving(
    identity: "projects/582015116396/secrets/printer-02-lan-access-code/versions/7" as SmResolvedVersionIdentity,
    requested: latest_ref,
    served: "7")
}

test fn an_alias_request_resolves_in_the_id_spelling_too() -> Bool {
  join_is_alias_serving(
    identity: "projects/gunbai-secrets/secrets/printer-02-lan-access-code/versions/7" as SmResolvedVersionIdentity,
    requested: latest_ref,
    served: "7")
}

// CONTROL 4 IN THE ALIAS SPELLING. The alias relaxes WHICH GENERATION answered, never WHICH SECRET,
// so a foreign project and a foreign secret are refused exactly as they are for an exact request.
// Without these two rows the alias arm would be a cross-project read on a credential path.
test fn an_alias_request_refuses_a_foreign_project_number() -> Bool {
  !join_admits_returned_identity(
    identity: "projects/999999999999/secrets/printer-02-lan-access-code/versions/7" as SmResolvedVersionIdentity,
    requested: latest_ref)
}

test fn an_alias_request_refuses_a_foreign_project_id() -> Bool {
  !join_admits_returned_identity(
    identity: "projects/someone-elses-project/secrets/printer-02-lan-access-code/versions/7" as SmResolvedVersionIdentity,
    requested: latest_ref)
}

test fn an_alias_request_refuses_another_secret_in_this_project() -> Bool {
  !join_admits_returned_identity(
    identity: "projects/582015116396/secrets/printer-01-lan-access-code/versions/7" as SmResolvedVersionIdentity,
    requested: latest_ref)
}

// THE ALIAS ECHOED BACK IS NOT A RESOLUTION. If the service returned ".../versions/latest" the
// answer would name no generation at all, so admitting it would put an unresolved moving target in
// the receipt as though it were the record of what was spent -- the fabricated plausible output §5
// forbids. An unresolved segment is refused even though the project and the secret are right.
test fn an_alias_request_refuses_the_alias_echoed_back() -> Bool {
  !join_admits_returned_identity(
    identity: "projects/582015116396/secrets/printer-02-lan-access-code/versions/latest" as SmResolvedVersionIdentity,
    requested: latest_ref)
}

// AND AN EXACT REQUEST NEVER TAKES THE ALIAS ARM. Control 1 restated at arm grain: the exact rows
// above assert a verdict, and this one asserts that the verdict came from the exact comparison, so
// an implementation that admitted every numeric answer as an alias resolution reads red.
test fn an_exact_request_is_served_through_the_exact_arm() -> Bool {
  join_is_exact_serving(
    identity: "projects/582015116396/secrets/printer-02-lan-access-code/versions/1" as SmResolvedVersionIdentity,
    requested: requested_ref,
    served: "1")
}

test fn an_exact_request_is_not_an_alias_resolution() -> Bool {
  !join_is_alias_serving(
    identity: "projects/582015116396/secrets/printer-02-lan-access-code/versions/1" as SmResolvedVersionIdentity,
    requested: requested_ref,
    served: "1")
}

// THE ALIAS ARM DOES NOT LEAK INTO THE EXACT ONE. Control 2 under the new type: a request for
// version 1 answered with version 2 is still refused, and it must not become admissible merely
// because the resolver now knows how to accept a number for some requests.
test fn an_exact_request_answered_with_another_number_is_still_refused() -> Bool {
  !join_is_exact_serving(
    identity: "projects/582015116396/secrets/printer-02-lan-access-code/versions/2" as SmResolvedVersionIdentity,
    requested: requested_ref,
    served: "2")
    && !join_admits_returned_identity(
         identity: "projects/582015116396/secrets/printer-02-lan-access-code/versions/2" as SmResolvedVersionIdentity,
         requested: requested_ref)
}

// A MALFORMED IDENTITY IS REFUSED IN BOTH SPELLINGS, so the projection this join now performs
// cannot fabricate a segment out of a name that carries none.
test fn a_name_that_is_not_a_version_resource_is_refused_for_both_selectors() -> Bool {
  !join_admits_returned_identity(
    identity: "projects/gunbai-secrets/secrets/printer-02-lan-access-code" as SmResolvedVersionIdentity,
    requested: requested_ref)
    && !join_admits_returned_identity(
         identity: "projects/gunbai-secrets/secrets/printer-02-lan-access-code" as SmResolvedVersionIdentity,
         requested: latest_ref)
}
