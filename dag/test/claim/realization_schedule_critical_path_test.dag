module test.claim.realization_schedule_critical_path

data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

test fn witness_parallel_batch_takes_max_not_sum() -> Bool {
  let batch = [
    nanosecond(count: 100),
    nanosecond(count: 5),
  ]
  let critical = schedule_batch_critical_path(batch_times: batch)
  let summed = time_measure_list_total(times: batch)
  nanosecond_count(n: critical) == 100
    && nanosecond_count(n: summed) == 105
    && nanosecond_count(n: critical) != nanosecond_count(n: summed)
}

test fn witness_sequential_batches_add_critical_paths() -> Bool {
  let batches = [
    [nanosecond(count: 50)],
    [
      nanosecond(count: 100),
      nanosecond(count: 5),
    ],
  ]
  nanosecond_count(n: schedule_critical_path_time(batch_times: batches)) == 150
}

test fn witness_measured_total_uses_critical_path_basis() -> Bool {
  let batches = [
    [
      nanosecond(count: 200),
      nanosecond(count: 10),
    ],
  ]
  let account = cost_account_measured_from_schedule_critical_path(batch_times: batches)
  match account.basis {
    Measured =>
      cost_account_time_count(account: account) == 200
    Predicted => false
  }
}

test fn witness_nat_ordering_supports_max() -> Bool {
  match std.nat.nat_compare(a: 7, b: 3) {
    Greater => std.nat.nat_max(a: 7, b: 3) == 7
    _ => false
  }
}

