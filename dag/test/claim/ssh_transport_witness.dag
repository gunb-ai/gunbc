module test.claim.ssh_transport_witness

import std.types { Bool, NonEmptyStr }
import std.types { Bool, NonEmptyStr }
import extdeps.ssh.mock_corpus { ssh_session_mock_case_exec_script }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data ssh_exec_script_remote_receiver: NonEmptyStr = "bash -s"

// THE ARGV-EMBED BUDGET CLAIM LIVED HERE TOO AND IT WAS THE SAME CLAIM, NOT A SIBLING OF ONE.
//
// `witness_apply_script_stays_under_argv_embed_budget` stood in this module and in
// test.claim.shell_exec_run_argv_embed_witness as BYTE-IDENTICAL bodies — same spec, same plan,
// same `host_exec_arg_max_strlen` budget, same conjunction — and its own annotation said so
// ("same move as test.claim.shell_exec_run_argv_embed_witness"). That is one fact with two
// authorities, which DESIGN section 3 forbids, and the required floor measured the duplication
// exactly: run 34888954422 records both at 194,291 eval steps and 962ms, to the step.
//
// IT IS DELETED HERE AND KEPT THERE, because the fact is about the APPLY EMISSION against the
// exec argv limit — `extdeps.exec.exec_arg_limit`, which that module already owns as its subject —
// and nothing in it is ssh-specific. What IS ssh-specific is the transport shape, and that is
// what the two claims below assert: the ExecScript operation is enrolled in the mock corpus, and
// its remote receiver is `bash -s` rather than argv embedding. Neither depends on script size,
// which is precisely why the budget claim added nothing here: an ssh transport that streams the
// script over stdin is correct for arbitrary sizes.
//
// NOTHING IN THE DELETED ROW'S HISTORY IS DROPPED WITH IT. Its receipt — that pre-belt-B the live
// apply genuinely EXCEEDED MAX_ARG_STRLEN because it embedded the emitted server.js, which is what
// made the stdin transport load-bearing, and that belt B (PR 6940) dissolved that premise and
// flipped the clause into a regression wall — is carried in full on the surviving row.

test fn witness_exec_script_mock_enrolled() -> Bool {
  ssh_session_mock_case_exec_script.operation == "ExecScript"
    && ssh_session_mock_case_exec_script.operation_key == "ssh.Session.ExecScript"
}

test fn witness_exec_script_receiver_is_bash_dash_s() -> Bool {
  ssh_exec_script_remote_receiver == "bash -s"
}

