module test.claim.operation_realization_witness_test

import std.types { Bool, Int, List, NonEmptyStr, String }
import std.materialization_ladder { Frame, SharedStateFrame }
import std.effect_grant {
  Read, Write, ServiceOpTree, NamespacePosition,
  ModeledRealization, LifecycleByConstruction, Grant, Envelope,
}
import v2.std.operation_argv { OperationRef }
import v2.std.operation_realization {
  OperationRealization, OperationBinding, OperationCall, OperationStep, DispatchRecord,
  OperationObserved, OperationWorkerKilled, ShellObserved,
  DispatchObserved, DispatchUnbound, DispatchWorkerKilled,
}
import v2.std.witness_evaluation {
  WitnessEvaluationFrame, WitnessReturned, WitnessRefused, WitnessInterrupted,
  evaluate_in_witness_frame, witness_diagnostic_rendered_reason, witness_evaluation_frame_active,
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import extdeps.transports.shell { ShellProcessExited }
import extdeps.tools.sleep { sleep_delay_seconds_second_carrier_projection }
import std.measure { second }
import extdeps.filesystem.filesystem_io { Filesystem }
import extdeps.bmc.ipmi_chassis_control {
  ChassisPowerObservation, ChassisPowerRead, ChassisStatusUndecodable, ChassisUnreadable,
  chassis_observation, ipmitool_chassis_status_power_line,
}
import gunbc.machine_intake_oob_boot_handoff { read_chassis_power }
import gunbc.bmc_model {
  BmcWorld, BmcPowerOn, BmcPowerOff, BmcScheduledEvent, BmcAcPowerLost, bmc_power_is_on, bmc_web_world_untouched,
}
import gunbc.bmc_dry_realization {
  bmc_dry_realization, bmc_ipmi_operation, bmc_chassis_power_control_handler,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE ENTRY-BOUND MODELED OPERATION REALIZATION, EXERCISED THROUGH THE REAL DISPATCHER. Every subject
// below issues real extdeps.bmc operations -- directly, or through the production helper
// gunbc.machine_intake_oob_boot_handoff read_chassis_power, which issues ChassisStatus and runs the
// production decoder chassis_observation on what comes back. Nothing here constructs a decoded
// judgment: the model renders stdout and the production decoder reads it. Each claim asserts the
// ROUTE the dispatcher logged, not only the answer.
data realization_identity: NonEmptyStr = "bmc-dry-witness" as NonEmptyStr

fn modeled_grant(service: String, verb: std.effect_grant.Verb) -> Grant {
  Grant {
    verb: verb
    root: NamespacePosition { tree: ServiceOpTree { service: service }, path: [] }
    binding: ModeledRealization { realization: realization_identity as String }
    lifecycle: LifecycleByConstruction
  }
}

fn modeled_frame(realization: OperationRealization<BmcWorld>) -> WitnessEvaluationFrame<BmcWorld> {
  WitnessEvaluationFrame {
    envelope: Envelope {
      frame: Frame { name: "operation-realization-witness", kind: SharedStateFrame }
      grants: [
        modeled_grant(service: "diagnostic.ipmi.Tool", verb: Read),
        modeled_grant(service: "diagnostic.ipmi.Tool", verb: Write),
        modeled_grant(service: "sleep.Delay", verb: Write),
      ]
    }
    rest_fixtures: []
    realization: Present { value: realization }
  }
}

fn world(power_on: Bool) -> BmcWorld {
  BmcWorld { power: if power_on { BmcPowerOn } else { BmcPowerOff }, pending: [], fired: [], web: bmc_web_world_untouched }
}

fn read_power() -> ChassisPowerObservation {
  read_chassis_power(bmc_host: "bmc.test.invalid" as NonEmptyStr, username: "operator" as NonEmptyStr, password_file: "/nonexistent/credential" as NonEmptyStr)
}

fn power_control(action: NonEmptyStr) -> Bool {
  diagnostic.ipmi.Tool.ChassisPowerControl(
    bmc_host: "bmc.test.invalid" as NonEmptyStr,
    username: "operator" as NonEmptyStr,
    password_file: "/nonexistent/credential" as NonEmptyStr,
    action: action,
  ).success
}

fn route_operations(route: List<DispatchRecord>) -> List<String> {
  map(route, r => r.invocation.at.operation)
}

fn observed_on(o: ChassisPowerObservation) -> Bool {
  match o {
    ChassisPowerRead { power_on: on } => on
    _ => false
  }
}

fn observed_off(o: ChassisPowerObservation) -> Bool {
  match o {
    ChassisPowerRead { power_on: on } => !on
    _ => false
  }
}

fn every_record_observed(route: List<DispatchRecord>) -> Bool {
  all(route, r => match r.outcome { DispatchObserved { observation: _ } => true _ => false })
}

fn refused_with(reason_part: String, result_reason: String) -> Bool {
  string_contains(s: result_reason, pattern: reason_part)
}

// THE ENCODER ROUND-TRIPS THROUGH THE PRODUCTION DECODER. The line the dry adapter renders for each
// power state, fed to chassis_observation, reads back as that state -- so the dry route decodes by the
// same decoder a physical read reaches, and a rendering the decoder cannot read would red here first.
test fn the_status_rendering_round_trips_through_the_production_decoder() -> Bool {
  observed_on(o: chassis_observation(success: true, stdout: ipmitool_chassis_status_power_line(power_on: true)))
    && observed_off(o: chassis_observation(success: true, stdout: ipmitool_chassis_status_power_line(power_on: false)))
}

// A READ IS ANSWERED FROM THE WORLD AND DECODED BY THE PRODUCTION HELPER. Both power states are run so
// a realization that ignored its state could not pass, and the route shows exactly one ChassisStatus
// dispatched to this realization.
test fn a_dry_status_read_is_decoded_by_the_production_helper() -> Bool {
  let off = evaluate_in_witness_frame(
    frame: modeled_frame(realization: bmc_dry_realization(identity: realization_identity, initial: world(power_on: false))),
    subject: fn(_scope) { read_power() }
  )
  let on = evaluate_in_witness_frame(
    frame: modeled_frame(realization: bmc_dry_realization(identity: realization_identity, initial: world(power_on: true))),
    subject: fn(_scope) { read_power() }
  )
  (match off {
    WitnessReturned { value, route } =>
      observed_off(o: value) && route_operations(route: route) == ["ChassisStatus"] && every_record_observed(route: route)
        && all(route, r => r.realization == (realization_identity as String))
    _ => false
  }) && (match on {
    WitnessReturned { value, route } => observed_on(o: value) && route_operations(route: route) == ["ChassisStatus"]
    _ => false
  })
}

// THE DECODER IS UNDER TEST, NOT BYPASSED. A realization whose status handler prints a value the
// decoder does not recognise yields the decoder's own Undecodable arm through read_chassis_power: the
// verdict comes from production code reading scripted stdout, so no handler can hand back a decision.
fn unknown_status_handler(state: BmcWorld, call: OperationCall) -> OperationStep<BmcWorld> {
  OperationObserved {
    observation: ShellObserved { observation: ShellProcessExited { exit_code: 0, stdout: "System Power         : unknown\n", stderr: "" } },
    state: state,
    elapsed_seconds: 1,
  }
}

test fn an_unrecognised_rendering_reaches_the_decoders_own_refusal() -> Bool {
  let realization = OperationRealization {
    identity: realization_identity,
    initial: world(power_on: true),
    bindings: [OperationBinding { at: bmc_ipmi_operation(operation: "ChassisStatus"), handler: unknown_status_handler }],
    advance: fn(s, now) { s },
  }
  match evaluate_in_witness_frame(frame: modeled_frame(realization: realization), subject: fn(_scope) { read_power() }) {
    WitnessReturned { value } => match value {
      ChassisStatusUndecodable { cause: _ } => true
      _ => false
    }
    _ => false
  }
}

// A WRITE CHANGES THE WORLD AND A LATER READ OBSERVES IT, in the order the subject issued them, and the
// frame returns the world the model ended in.
test fn a_write_transitions_the_world_and_a_later_read_observes_it() -> Bool {
  let result = evaluate_in_witness_frame(
    frame: modeled_frame(realization: bmc_dry_realization(identity: realization_identity, initial: world(power_on: false))),
    subject: fn(_scope) {
      let before = read_power()
      let accepted = power_control(action: "on" as NonEmptyStr)
      let after = read_power()
      observed_off(o: before) && accepted && observed_on(o: after)
    }
  )
  match result {
    WitnessReturned { value, route, state } =>
      value
        && route_operations(route: route) == ["ChassisStatus", "ChassisPowerControl", "ChassisStatus"]
        && map(route, r => r.ordinal) == [0, 1, 2]
        && match state { Present { value: w } => bmc_power_is_on(world: w) Absent => false }
    _ => false
  }
}

fn loss_fired_and_none_pending(w: BmcWorld) -> Bool {
  count(w.fired) == 1 && count(w.pending) == 0
}

// AN EVENT HAPPENS DURING A QUIET WAIT. The world is on with AC loss scheduled at t=3; the subject reads
// (t 0 -> 1), sleeps five seconds through the production sleep helper (t 1 -> 6), and reads again. The
// loss fired during the sleep with no operation issued at t=3, and the second read observes it.
test fn a_scheduled_event_fires_during_a_quiet_wait() -> Bool {
  let initial = BmcWorld { power: BmcPowerOn, pending: [BmcScheduledEvent { at_seconds: 3, event: BmcAcPowerLost {} }], fired: [], web: bmc_web_world_untouched }
  let result = evaluate_in_witness_frame(
    frame: modeled_frame(realization: bmc_dry_realization(identity: realization_identity, initial: initial)),
    subject: fn(_scope) {
      let first = read_power()
      let waited = sleep_delay_seconds_second_carrier_projection(duration: second(count: 5))
      let second_read = read_power()
      observed_on(o: first) && waited && observed_off(o: second_read)
    }
  )
  match result {
    WitnessReturned { value, route, state } =>
      value
        && route_operations(route: route) == ["ChassisStatus", "Seconds", "ChassisStatus"]
        && map(route, r => r.completed_at) == [1, 6, 7]
        && match state { Present { value: w } => loss_fired_and_none_pending(w: w) Absent => false }
    _ => false
  }
}

// AN OPERATION THE REALIZATION DOES NOT BIND REFUSES, AND NOTHING ELSE ANSWERS IT. SensorList is
// covered by the grant and PUBLISHES a hermetic mock case (extdeps.bmc.mock_corpus), so a fallback to
// the mock layer would answer it; the frame refuses instead, and the route records the unbound
// dispatch after the read that preceded it.
test fn an_unbound_operation_refuses_and_is_not_mocked() -> Bool {
  let result = evaluate_in_witness_frame(
    frame: modeled_frame(realization: bmc_dry_realization(identity: realization_identity, initial: world(power_on: true))),
    subject: fn(_scope) {
      let first = read_power()
      let sensors = diagnostic.ipmi.Tool.SensorList(bmc_host: "bmc.test.invalid" as NonEmptyStr)
      sensors.success
    }
  )
  match result {
    WitnessRefused { diagnostic, route } =>
      refused_with(reason_part: "OperationNotBound", result_reason: witness_diagnostic_rendered_reason(diagnostic: diagnostic))
        && route_operations(route: route) == ["ChassisStatus", "SensorList"]
        && match route.skip(n: 1).first() { Present { value: r } => match r.outcome { DispatchUnbound { cause: _ } => true _ => false } Absent => false }
    _ => false
  }
}

// THE CHECKOUT-INPUT CARVE-OUT DOES NOT ESCAPE THE FRAME. Under plain hermetic execution a readonly
// Filesystem.Read of a committed checkout path is a REAL read; under a modeled realization no grant
// covers Filesystem, so the same read refuses as uncovered.
test fn a_checkout_read_is_not_an_escape_from_the_frame() -> Bool {
  match evaluate_in_witness_frame(
    frame: modeled_frame(realization: bmc_dry_realization(identity: realization_identity, initial: world(power_on: true))),
    subject: fn(_scope) { count(filesystem_read_checkout_probe()) > 0 }
  ) {
    WitnessRefused { diagnostic } =>
      refused_with(reason_part: "OperationUncovered", result_reason: witness_diagnostic_rendered_reason(diagnostic: diagnostic))
    _ => false
  }
}

fn filesystem_read_checkout_probe() -> String {
  Filesystem.Read(path: "DESIGN.md").content
}

// A MALFORMED REALIZATION REFUSES BEFORE THE SUBJECT RUNS: one identity bound twice, and one binding
// whose identity names a file that does not declare the operation. The subject would return true, so a
// green here can only come from admission refusing it, and the route is empty.
test fn a_duplicate_binding_refuses_before_the_subject_runs() -> Bool {
  let realization = OperationRealization {
    identity: realization_identity,
    initial: world(power_on: true),
    bindings: [
      OperationBinding { at: bmc_ipmi_operation(operation: "ChassisPowerControl"), handler: bmc_chassis_power_control_handler },
      OperationBinding { at: bmc_ipmi_operation(operation: "ChassisPowerControl"), handler: bmc_chassis_power_control_handler },
    ],
    advance: fn(s, now) { s },
  }
  match evaluate_in_witness_frame(frame: modeled_frame(realization: realization), subject: fn(_scope) { true }) {
    WitnessRefused { diagnostic, route } =>
      refused_with(reason_part: "binds one operation identity twice", result_reason: witness_diagnostic_rendered_reason(diagnostic: diagnostic))
        && count(route) == 0
    _ => false
  }
}

test fn a_binding_to_an_undeclared_identity_refuses_before_the_subject_runs() -> Bool {
  let misplaced = OperationRef { path: "dag/extdeps/bmc/ipmi_chassis_control.dag", service: "diagnostic.ipmi.Tool", operation: "ChassisStatus" }
  let realization = OperationRealization {
    identity: realization_identity,
    initial: world(power_on: true),
    bindings: [OperationBinding { at: misplaced, handler: unknown_status_handler }],
    advance: fn(s, now) { s },
  }
  match evaluate_in_witness_frame(frame: modeled_frame(realization: realization), subject: fn(_scope) { true }) {
    WitnessRefused { diagnostic, route } =>
      refused_with(reason_part: "resolves to no declared operation", result_reason: witness_diagnostic_rendered_reason(diagnostic: diagnostic))
        && count(route) == 0
    _ => false
  }
}

// THE WORKER IS KILLED AFTER THE EFFECT AND BEFORE THE REPLY. The power-on commits (the world is on)
// and no reply ever reaches the subject, so the frame answers WitnessInterrupted -- never a manufactured
// return -- carrying the committed world and a route that ends at the killed dispatch. The enclosing
// witness is the supervisor: it resumes a SECOND attempt from that world in a new frame, and the
// resumed attempt reads before it writes and finds the host already on.
fn killed_after_power_on(state: BmcWorld, call: OperationCall) -> OperationStep<BmcWorld> {
  OperationWorkerKilled { committed: true, state: BmcWorld { power: BmcPowerOn, pending: state.pending, fired: state.fired, web: state.web } }
}

test fn a_killed_worker_is_interrupted_and_a_resumed_attempt_reconciles() -> Bool {
  let realization = OperationRealization {
    identity: realization_identity,
    initial: world(power_on: false),
    bindings: [
      OperationBinding { at: bmc_ipmi_operation(operation: "ChassisStatus"), handler: fn(s, c) { OperationObserved { observation: ShellObserved { observation: ShellProcessExited { exit_code: 0, stdout: ipmitool_chassis_status_power_line(power_on: bmc_power_is_on(world: s)), stderr: "" } }, state: s, elapsed_seconds: 1 } } },
      OperationBinding { at: bmc_ipmi_operation(operation: "ChassisPowerControl"), handler: killed_after_power_on },
    ],
    advance: fn(s, now) { s },
  }
  let first = evaluate_in_witness_frame(
    frame: modeled_frame(realization: realization),
    subject: fn(_scope) {
      let before = read_power()
      let accepted = power_control(action: "on" as NonEmptyStr)
      accepted
    }
  )
  match first {
    WitnessInterrupted { at, route, state } => {
      let resumed = evaluate_in_witness_frame(
        frame: modeled_frame(realization: bmc_dry_realization(identity: realization_identity, initial: state)),
        subject: fn(_scope) { read_power() }
      )
      at.invocation.at.operation == "ChassisPowerControl"
        && match at.outcome { DispatchWorkerKilled { committed: c } => c _ => false }
        && route_operations(route: route) == ["ChassisStatus", "ChassisPowerControl"]
        && bmc_power_is_on(world: state)
        && match resumed {
          WitnessReturned { value, route } => observed_on(o: value) && route_operations(route: route) == ["ChassisStatus"]
          _ => false
        }
    }
    _ => false
  }
}

// A HANDLER RECEIVES NO EFFECT CONTEXT. A handler that issues an operation -- here the sleep, which the
// realization does bind -- refuses rather than dispatching it, so a handler cannot reach live I/O even
// through an operation the frame would otherwise answer.
fn effectful_status_handler(state: BmcWorld, call: OperationCall) -> OperationStep<BmcWorld> {
  let waited = sleep_delay_seconds_second_carrier_projection(duration: second(count: 1))
  OperationObserved {
    observation: ShellObserved { observation: ShellProcessExited { exit_code: 0, stdout: ipmitool_chassis_status_power_line(power_on: waited), stderr: "" } },
    state: state,
    elapsed_seconds: 1,
  }
}

test fn a_handler_that_issues_an_operation_refuses() -> Bool {
  let realization = OperationRealization {
    identity: realization_identity,
    initial: world(power_on: true),
    bindings: [OperationBinding { at: bmc_ipmi_operation(operation: "ChassisStatus"), handler: effectful_status_handler }],
    advance: fn(s, now) { s },
  }
  match evaluate_in_witness_frame(frame: modeled_frame(realization: realization), subject: fn(_scope) { read_power() }) {
    WitnessRefused { diagnostic } =>
      refused_with(reason_part: "handlers receive no effect context", result_reason: witness_diagnostic_rendered_reason(diagnostic: diagnostic))
    _ => false
  }
}

// THE REALIZATION DOES NOT OUTLIVE ITS FRAME.
test fn the_realization_does_not_escape_its_frame() -> Bool {
  let inside = evaluate_in_witness_frame(
    frame: modeled_frame(realization: bmc_dry_realization(identity: realization_identity, initial: world(power_on: true))),
    subject: fn(_scope) { witness_evaluation_frame_active() }
  )
  (match inside { WitnessReturned { value } => value _ => false }) && !witness_evaluation_frame_active()
}
