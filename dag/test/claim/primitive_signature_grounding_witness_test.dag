module test.claim.primitive_signature_grounding_witness_test


data primitive_signature_grounding_witness_note: String = "Executing evidence that a primitive's arity and parameter types are GROUNDED -- read back through one authority -- rather than transcribed beside it. There is deliberately no witness asserting that the semantic contract AGREES with the algebra template: under projection there is one set of bytes, so disagreement has no spelling and such a check would be permanently green by construction, which DESIGN 4b names as worse than absent because it gets cited as coverage. The claims below are the ones whose RED an author can actually produce."

// ---------------------------------------------------------------------------
// (a) TOTALITY. Every derived contract resolves to exactly one signature.
// ---------------------------------------------------------------------------

test fn w_every_algebra_grounded_contract_resolves_a_signature() -> Bool {
  algebra_grounded_signatures_all_resolve()
}

// NON-VACUITY, WITHOUT A SNAPSHOT. A fold over zero rows is vacuously true, so the totality
// claim above needs an anchor -- but the anchor may not be a count copied out of the current
// tree. DESIGN section 5's oracle ruling is explicit that a measurement taken from the same
// tree is not an oracle: adding any legitimate algebra template row would red such a check
// with no change-related meaning, and automating its update would collapse it to
// measure() == measure(). This states the SELF-DENOMINATING identity instead -- the derived
// population is exactly the template population, both sides read from the one authority, so a
// new template row moves both and a derivation that dropped a profile reds it.
test fn w_derived_population_is_exactly_the_algebra_template_population() -> Bool {
  algebra_grounded_semantic_contract_count() == (std.algebra.all_algebra_field_templates() |> count)
}

// The non-vacuity anchor proper, as a CONTROLLED FIXTURE: input and expected population are
// both authored here, neither is measured from the corpus, so the assertion carries
// information no matter what the tree contains. This is what keeps the identity above from
// being satisfiable by two empty sides.
fn controlled_fixture_rows() -> List<std.algebra.AlgebraFieldTemplate> {
  [
    { name: "fixture_nullary", param_types: [], return_type: std.algebra.ReceiverSelf, size_effect: none, cost_shape: none, callback_element_position: none },
    { name: "fixture_unary", param_types: [std.algebra.ReceiverSelf], return_type: std.algebra.ReceiverSelf, size_effect: none, cost_shape: none, callback_element_position: none },
    { name: "fixture_binary", param_types: [std.algebra.ReceiverSelf, std.algebra.ReceiverKey], return_type: std.algebra.ReceiverSelf, size_effect: none, cost_shape: none, callback_element_position: none }
  ]
}

fn fixture_arity_label(name: String) -> String {
  match algebra_signature_from_candidates(canonical_name: name as NonEmptyStr, candidates: controlled_fixture_rows()) {
    SignatureResolved { parameters: ps, result: _ } => concat("arity:", v1.compiler.emit_core_support.to_string(ps |> count))
    SignatureAmbiguousOnProfile { canonical_name: _, candidate_count: _ } => "ambiguous"
    SignatureAbsentFromProfile { canonical_name: _ } => "absent"
    SignatureNotGrounded { reason: _ } => "not_grounded"
  }
}

test fn w_every_row_of_a_controlled_fixture_resolves_to_its_authored_arity() -> Bool {
  fixture_arity_label(name: "fixture_nullary") == "arity:0"
    && fixture_arity_label(name: "fixture_unary") == "arity:1"
    && fixture_arity_label(name: "fixture_binary") == "arity:2"
    && fixture_arity_label(name: "fixture_absent") == "absent"
}

// THE HAND-AUTHORED GROUNDINGS. Every declared PrimitiveDefinition must either resolve or say
// NotGrounded; an Absent or Ambiguous means someone typed a (name, profile) pair that upstream
// no longer honours. This is the claim the derived-population fold CANNOT make, because these
// profiles are typed by a human rather than derived. Its RED is authorable and has already
// occurred in the wild: map_keys and map_values moved from PartialFunction to
// FinitelySupportedFunction upstream, which turns any stale grounding into a silent Absent.
test fn w_every_declared_grounding_still_resolves_or_says_ungrounded() -> Bool {
  declared_definition_groundings_all_dispose()
}

// ---------------------------------------------------------------------------
// (b) THE PROJECTION IS A FUNCTION, AND THE KEY IS A PAIR.
//
// This is the load-bearing witness of the change. Measured over the 87 rows, 21 of the 59
// distinct names carry more than one template and four disagree in what they take, so a
// projection keyed on canonical_name alone would have to pick one silently. These two
// assertions go RED the moment someone "simplifies" the key back to a bare name, because
// the two readings of `get` would then have to collapse into one.
// ---------------------------------------------------------------------------

fn second_param_label(profile: std.algebra.AlgebraProfile) -> String {
  let c = std.primitive_identity.PrimitiveSemanticContract {
    canonical_name: "get" as NonEmptyStr,
    signature: GroundedInAlgebraTemplate { profile: profile }
  }
  match primitive_signature(contract: c) {
    SignatureResolved { parameters: ps, result: _ } =>
      match ps |> v2.std.algebra.skip(1) |> first {
        Present { value: gunbc.plans.md_helpers.p } =>
          match gunbc.plans.md_helpers.p {
            std.algebra.NamedTemplate { name: n } => concat("named:", n)
            std.algebra.ReceiverKey => "receiver_key"
            _ => "other_template"
          }
        Absent => "missing"
      }
    SignatureAmbiguousOnProfile { canonical_name: _, candidate_count: _ } => "ambiguous"
    SignatureAbsentFromProfile { canonical_name: _ } => "absent"
    SignatureNotGrounded { reason: _ } => "not_grounded"
  }
}

test fn w_get_takes_an_index_on_a_list_and_a_key_on_a_map() -> Bool {
  second_param_label(profile: std.algebra.FreeMonoidCollectionProfile) == "named:Int"
    && second_param_label(profile: std.algebra.PartialFunctionProfile) == "receiver_key"
}

// Arity is compared through a label rather than through Optional equality, so the two states
// this pair exists to keep apart -- "no arity" and "arity zero" -- are compared as distinct
// values rather than relying on how an Optional happens to compare.
fn arity_label(contract: std.primitive_identity.PrimitiveSemanticContract) -> String {
  match primitive_arity(contract: contract) {
    Present { value: n } => concat("arity:", v1.compiler.emit_core_support.to_string(n))
    Absent => "no_arity"
  }
}

// `member` disagrees in ARITY across profiles, not merely in parameter type -- the sharpest
// form of the same finding, and the one a name-keyed projection could not represent at all.
test fn w_member_has_a_different_arity_on_each_profile() -> Bool {
  let boolean_member = std.primitive_identity.PrimitiveSemanticContract {
    canonical_name: "member" as NonEmptyStr,
    signature: GroundedInAlgebraTemplate { profile: std.algebra.FinitePowerSetProfile }
  }
  let pointwise_member = std.primitive_identity.PrimitiveSemanticContract {
    canonical_name: "member" as NonEmptyStr,
    signature: GroundedInAlgebraTemplate { profile: std.algebra.PointwisePowerCollectionProfile }
  }
  arity_label(contract: boolean_member) == "arity:2"
    && arity_label(contract: pointwise_member) == "arity:1"
}

// ---------------------------------------------------------------------------
// THE REFUSAL ARMS, each with an authorable RED.
// ---------------------------------------------------------------------------

// A grounding whose (canonical_name, profile) pair carries no template refuses rather than
// resolving to something. This is the RED behind the totality claim above.
test fn w_a_name_absent_from_its_profile_refuses() -> Bool {
  let bogus = std.primitive_identity.PrimitiveSemanticContract {
    canonical_name: "no_such_primitive" as NonEmptyStr,
    signature: GroundedInAlgebraTemplate { profile: std.algebra.PartialFunctionProfile }
  }
  match primitive_signature(contract: bogus) {
    SignatureAbsentFromProfile { canonical_name: n } => n == bogus.canonical_name
    SignatureResolved { parameters: _, result: _ } => false
    SignatureAmbiguousOnProfile { canonical_name: _, candidate_count: _ } => false
    SignatureNotGrounded { reason: _ } => false
  }
}

// AMBIGUITY IS UNOCCUPIED BUT REACHABLE, and this fixture is why the resolver takes its
// candidates as a parameter. Measured: zero duplicate names within any of the eight profiles
// today, so nothing in the live corpus lands here -- but the template lists are hand-authored
// and a repeated row is writable, so the arm is a quiet guard rather than a dead one. Planting
// the duplicate is the RED that keeps it from being a decoration.
test fn w_two_templates_of_one_name_on_one_profile_refuse() -> Bool {
  let planted: List<std.algebra.AlgebraFieldTemplate> = [
    { name: "dup", param_types: [std.algebra.ReceiverSelf], return_type: std.algebra.ReceiverSelf, size_effect: none, cost_shape: none, callback_element_position: none },
    { name: "dup", param_types: [std.algebra.ReceiverSelf, std.algebra.ReceiverSelf], return_type: std.algebra.ReceiverSelf, size_effect: none, cost_shape: none, callback_element_position: none }
  ]
  match algebra_signature_from_candidates(canonical_name: "dup" as NonEmptyStr, candidates: planted) {
    SignatureAmbiguousOnProfile { canonical_name: _, candidate_count: n } => n == 2
    SignatureResolved { parameters: _, result: _ } => false
    SignatureAbsentFromProfile { canonical_name: _ } => false
    SignatureNotGrounded { reason: _ } => false
  }
}

// The positive control for the arm above: one row of that name on that list resolves. Without
// this, a resolver that refused EVERYTHING would satisfy the refusal test.
test fn w_one_template_of_one_name_resolves() -> Bool {
  let planted: List<std.algebra.AlgebraFieldTemplate> = [
    { name: "dup", param_types: [std.algebra.ReceiverSelf, std.algebra.ReceiverSelf], return_type: std.algebra.ReceiverSelf, size_effect: none, cost_shape: none, callback_element_position: none }
  ]
  match algebra_signature_from_candidates(canonical_name: "dup" as NonEmptyStr, candidates: planted) {
    SignatureResolved { parameters: ps, result: _ } => (ps |> count) == 2
    SignatureAmbiguousOnProfile { canonical_name: _, candidate_count: _ } => false
    SignatureAbsentFromProfile { canonical_name: _ } => false
    SignatureNotGrounded { reason: _ } => false
  }
}

// ---------------------------------------------------------------------------
// ARITY IS DERIVED, AND AN UNRESOLVED SIGNATURE HAS NO ARITY RATHER THAN ZERO.
//
// This pair is the discriminating one: a resolver that fabricated a zero for an unresolved
// signature would pass every claim above and fail here. A primitive taking no arguments and a
// primitive whose signature did not resolve are different facts, and `none` is the only
// spelling that keeps them apart.
// ---------------------------------------------------------------------------

test fn w_an_ungrounded_contract_has_no_arity_not_zero() -> Bool {
  let ungrounded = std.primitive_identity.PrimitiveSemanticContract {
    canonical_name: "fold_list" as NonEmptyStr,
    signature: SignatureUngrounded { reason: "spelling fork" as NonEmptyStr }
  }
  arity_label(contract: ungrounded) == "no_arity"
    && match primitive_signature(contract: ungrounded) {
         SignatureNotGrounded { reason: _ } => true
         SignatureResolved { parameters: _, result: _ } => false
         SignatureAmbiguousOnProfile { canonical_name: _, candidate_count: _ } => false
         SignatureAbsentFromProfile { canonical_name: _ } => false
       }
}

// The other side of the same pair: a genuinely nullary primitive DOES report zero, so `none`
// above is a real absence rather than the resolver being unable to count.
test fn w_a_nullary_primitive_reports_arity_zero() -> Bool {
  let ordered_zero = std.primitive_identity.PrimitiveSemanticContract {
    canonical_name: "bottom" as NonEmptyStr,
    signature: GroundedInAlgebraTemplate { profile: std.algebra.BooleanAlgebraProfile }
  }
  arity_label(contract: ordered_zero) == "arity:0"
}
