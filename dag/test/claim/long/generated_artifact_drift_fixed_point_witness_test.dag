module test.claim.long.generated_artifact_drift_fixed_point_witness

import gunbc.generated_artifact {
  GeneratedArtifact, CiYamlArtifact,
  committed_generated_artifacts, artifact_path,
}
import gunbc.generated_artifact_emit { ArtifactGenerated, ArtifactGenerationRefused, artifact_generate }
import extdeps.filesystem.filesystem_io { Filesystem }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data generated_artifact_drift_fixed_point_long_note: String = "Rehomed from dag/test/claim/generated_artifact_drift_test.dag (operator 5-second rule, 2026-08-03): witness_committed_is_fixed_point and its RED control read REAL committed bytes off disk (Filesystem.Read, ReadsLiveTree) and regenerate every committed artifact — measured 1005ms warm on srv_fleet_arm64 (witness_row_cost_basis.tsv) but flaked at 5004ms in falsifier discovery-corpus batch 1 under host contention (run 30550328673, BudgetExceeded). The fast witnesses (registry completeness, per-artifact generate-to-generate RED, policy rows) stay per-PR discovered in the parent file. Enrolled on falsifier_substrate_long_lane_entries (nightly falsifier batch 6, 180s eval budget). Local recipe: claim_batch --source-root dag --source-root src/v2 --entry dag/test/claim/long/generated_artifact_drift_fixed_point_witness_test.dag --functions witness_committed_is_fixed_point,witness_committed_fixed_point_red_control. Dissolve-on: eval lands under gunbc_ci_fast_lane_witness_eval_budget on a measured cold run and re-enrolls per-PR discovery."

data fixed_point_witness_note: String = "Fixed-point / byte-idempotence leg (ci-chores P0, 2026-07-22): witness_committed_is_fixed_point reads the REAL committed bytes off disk (Filesystem.Read, ReadsLiveTree) and asserts a fresh artifact_generate reproduces them byte-for-byte for every committed artifact. This is the executable form of `regen yields zero diff` — the property the automated chore commit relies on. It differs from witness_per_artifact_red_receipts (which compares generate-to-generate and so is blind to a committed-vs-generated mismatch such as the missing-trailing-newline defect P0 chased). RED control: witness_committed_fixed_point_red_control perturbs the read bytes and requires the equality to fail, so a false-green fixed point is unwritable."

data perturb: String = "\n# gunbc-generated-artifact-drift-receipt-perturb"

fn artifact_drifted(a: GeneratedArtifact, committed: String) -> Bool {
  match artifact_generate(a: a) {
    ArtifactGenerationRefused { reason: _ } => true
    ArtifactGenerated { content } => !(committed == content)
  }
}

fn artifact_committed_matches(a: GeneratedArtifact) -> Bool {
  let committed = Filesystem.Read(path: artifact_path(a: a))
  committed.success && !artifact_drifted(a: a, committed: committed.content)
}

test fn witness_committed_is_fixed_point() -> Bool {
  count(committed_generated_artifacts()) > 0
    && all(committed_generated_artifacts(), a => artifact_committed_matches(a: a))
}

test fn witness_committed_fixed_point_red_control() -> Bool {
  let a = CiYamlArtifact
  let committed = Filesystem.Read(path: artifact_path(a: a))
  committed.success
    && artifact_drifted(a: a, committed: concat(committed.content, perturb))
}
