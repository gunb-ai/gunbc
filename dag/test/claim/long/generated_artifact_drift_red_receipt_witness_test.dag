module test.claim.long.generated_artifact_drift_red_receipt_witness

import gunbc.generated_artifact {
  GeneratedArtifact,
  committed_generated_artifacts,
}
import gunbc.generated_artifact_emit { ArtifactGenerated, ArtifactGenerationRefused, artifact_generate }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data generated_artifact_drift_red_receipt_long_note: String = "Rehomed from dag/test/claim/generated_artifact_drift_test.dag (operator 5-second rule, shared CI floor item 0, 2026-08-04). WHY REMEDY 1 (share one producer) DOES NOT APPLY: witness_per_artifact_red_receipts folds committed_generated_artifacts and, per artifact, runs artifact_red_receipt — a positive-and-negative pair (clean generate must NOT drift; concat(content, perturb) MUST drift). The population is heterogeneous: CiYaml, FalsifierYaml, Gitignore, Gitattributes, Roadmap, Design, GithooksPrePush, GithooksPreCommit, Plan — nine distinct generator-times-drift-detection checks, not one upstream fact recomputed nine times. WHY REMEDY 2 (narrow subject) IS A COVERAGE LOSS: dropping any generator drops that artifact's perturb-sensitive drift property, not a harmless grain tweak. PRECEDENT (same file, operator ruling 2026-08-03): fixed_point_witness_long_lane_note — witness_committed_is_fixed_point rehomed to long/ for the same 5-second rule (measured 1005ms warm, flaked 5004ms under falsifier host contention); drift gate run_generated_artifact_drift_gate_body still reads the same bytes inline. THIS WITNESS: measured 4350ms then 4776ms on consecutive green main runs (95.5 percent of per-PR budget). COVERAGE PRESERVED PER-PR: tools.generated_artifact_gate still runs artifact_red_receipt_ok inline. Enrolled falsifier_substrate_long_lane_entries (180s eval budget). Dissolve-on: measured cold eval under gunbc_ci_fast_lane_witness_eval_budget re-enrolls per-PR discovery."

data perturb: String = "\n# gunbc-generated-artifact-drift-receipt-perturb"

fn artifact_drifted(a: GeneratedArtifact, committed: String) -> Bool {
  match artifact_generate(a: a) {
    ArtifactGenerationRefused { reason: _ } => true
    ArtifactGenerated { content } => !(committed == content)
  }
}

fn artifact_red_receipt(a: GeneratedArtifact) -> Bool {
  match artifact_generate(a: a) {
    ArtifactGenerationRefused { reason: _ } => false
    ArtifactGenerated { content } =>
      !artifact_drifted(a: a, committed: content)
        && artifact_drifted(a: a, committed: concat(content, perturb))
  }
}

test fn witness_per_artifact_red_receipts() -> Bool {
  count(committed_generated_artifacts()) > 0
    && all(committed_generated_artifacts(), a => artifact_red_receipt(a: a))
}
