fn credential_refused_unprinted(script: TransportScript?) -> Bool {
  let r = run_script(script: script)
  r.ran && !r.success
    && string_contains(s: r.stdout, pattern: "title=release-bins CredentialInBuildEnvironment::")
    && !string_contains(s: r.stdout, pattern: release_bins_credential_sentinel)
}

test fn release_bins_RED_registry_token_refuses_and_is_never_printed() -> Bool  {
  credential_refused_unprinted(script: script_registry_token)
}

test fn release_bins_RED_named_registry_token_refuses_and_is_never_printed() -> Bool  {
  credential_refused_unprinted(script: script_named_registry_token)
}

// ── Producer status: a producer that prints part of its output and then fails stops the key ────
test fn release_bins_RED_partial_print_then_failing_producer_publishes_no_key() -> Bool  {
  let r = run_script(script: script_partial_print_rustc)
  r.ran && !r.success && !string_contains(s: r.stdout, pattern: "release-bins request key")
}

// The candidate's retention is a duration authored in whole days; the emitted retention-days is that
// duration converted at the GitHub boundary, and it is the one day fleet-desired needs.
test fn the_candidate_retention_is_whole_days_and_emits_one_day() -> Bool  {
  compiler_pair_candidate_retention_is_whole_days() && compiler_pair_candidate_retention_whole_days() == 1
}
