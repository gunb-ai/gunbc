  release_bins_key_statements, fleet_release_bins_product, release_bins_pack_statements, release_bins_outcome_statements,
  release_bins_consumer_statements, release_bins_download_dir, release_bins_main_lookup_ref, lookup_decode_statements,
  release_bins_dispatch_lookup_ref, release_bins_dispatch_scope_ref_env,
