  bash_build_assign, bash_build_with_redir_to_file, bash_build_and_then, bash_build_word_cmdsubst,
  bash_build_if_else, bash_build_stmt_list_from_nodes, bash_build_pipe,
}

// RETAINED EXECUTING CONTROLS for gunbc.fleet_release_bins_key (review 5332304117). Each claim runs
// the SAME runner statements the fleet-converge workflow runs -- emitted by v2.workflow.bash_emit and
// handed to bash through release_bins_transport -- after a hermetic fixture: a temporary git checkout,
// fake rustc/cargo/cc/ld/ldd on PATH, and fake pack members. Nothing downloaded is executed and
// nothing outside the fixture's temporary directory is written; an EXIT trap removes that directory
// on every path, including the refusals. Each refusal claim is paired with a
// positive over the same fixture, and asserts the refusal BY NAME, so a claim cannot go green through
// a different refusal than the one it exists to exercise. They execute on the required floor's
// local-repo wet lane (v2.workflow.local_repo_wet_terminal local_repo_wet_schedule): bash, tar, git,
// jq and sha256sum over the fixture directory, no network, no cargo, no remote host.
data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn fx(t: String) -> Node { lit(t: t) }

fn in_t(path: String) -> Node { words(ws: [var(n: "T"), lit(t: path)]) }

fn write_file(path: Node, lines: List<String>) -> Node {
  bash_build_with_redir_to_file(inner: cmd(ws: concat([fx(t: "printf"), fx(t: "%s\\n")], map(lines, l => fx(t: l)))), path: path)
}

fn fake_tool(name: String, lines: List<String>) -> List<Node> {
  [
    write_file(path: in_t(path: join(["/bin/", name], "")), lines: concat(["#!/bin/sh"], lines)),
    cmd(ws: [fx(t: "chmod"), fx(t: "+x"), in_t(path: join(["/bin/", name], ""))]),
  ]
}

// The fixture: every variable the runners read, refused-override names cleared so the host running
// the claim cannot leak them in, and a committed tree with fake members in target/release.
// The runner's own credential-shaped variables (release_bins_credential_pattern) are cleared too, and
// the temp root is pinned under /tmp rather than wherever TMPDIR points: both are premises about the
// runner (gunbc.recurring_failure_mode wet_witness_keyed_to_the_runner_not_its_subject), and left in
// place a runner exporting a registry token, or a TMPDIR under a home holding .cargo/config.toml,
// turned every positive claim into CredentialInBuildEnvironment or AncestorCargoConfigPresent. The
// RED claims that export a credential or plant an ancestor config do so after this, so they still
// discriminate.
// The checkout and environment every claim needs; fixture() adds the fake toolchain the key runner
// probes, which the pack and lookup claims never reach.
fn fixture_env() -> List<Node> {
  seq(parts: [
    [
      assign_sub(name: "T", body: cmdl(ls: ["mktemp", "-d", "/tmp/gunbc_release_bins.XXXXXX"])),
      cmdl(ls: ["trap", "rm -rf \"$T\"", "EXIT"]),
      cmdl(ls: ["unset", "RUSTC", "RUSTC_WORKSPACE_WRAPPER", "RUSTC_WRAPPER", "CARGO_TARGET_DIR", "CARGO_BUILD_TARGET", "CARGO_BUILD_TARGET_DIR", "CARGO_BUILD_RUSTC", "CARGO_BUILD_RUSTC_WRAPPER", "CARGO_BUILD_RUSTC_WORKSPACE_WRAPPER"]),
      cmd(ws: [lit(t: "unset"), bash_build_word_cmdsubst(body: bash_build_pipe(
        left: bash_build_pipe(left: cmdl(ls: ["env"]), right: cmd(ws: [lit(t: "grep"), lit(t: "-oE"), lit(t: release_bins_credential_pattern)])),
        right: cmdl(ls: ["cut", "-d=", "-f1"]),
      ))]),
      cmd(ws: [fx(t: "mkdir"), fx(t: "-p"), in_t(path: "/bin"), in_t(path: "/rt"), in_t(path: "/ws/target/release")]),
      cmd(ws: [fx(t: "export"), words(ws: [fx(t: "RUNNER_TEMP="), in_t(path: "/rt")])]),
      cmd(ws: [fx(t: "export"), words(ws: [fx(t: "GITHUB_OUTPUT="), in_t(path: "/rt/output")])]),
      cmd(ws: [fx(t: "export"), words(ws: [fx(t: "GITHUB_ENV="), in_t(path: "/rt/env")])]),
      cmd(ws: [fx(t: "touch"), in_t(path: "/rt/output"), in_t(path: "/rt/env")]),
      cmdl(ls: ["export", "GITHUB_REF=refs/heads/main", "GITHUB_RUN_ID=1", "GITHUB_RUN_ATTEMPT=1"]),
      cmd(ws: [fx(t: "export"), words(ws: [fx(t: "CARGO_BIN="), in_t(path: "/bin/cargo")])]),
      cmd(ws: [fx(t: "export"), words(ws: [fx(t: "PATH="), in_t(path: "/bin:"), var(n: "PATH")])]),
    ],
    [
      cmd(ws: [fx(t: "cd"), in_t(path: "/ws")]),
      cmdl(ls: ["git", "init", "-q"]),
      write_file(path: fx(t: "src.txt"), lines: ["fixture source"]),
      cmdl(ls: ["git", "add", "src.txt"]),
      cmdl(ls: ["git", "-c", "user.email=fixture@example.invalid", "-c", "user.name=fixture", "commit", "-qm", "fixture"]),
    ],
  ])
}

fn fixture() -> List<Node> {
  seq(parts: [
    fixture_env(),
    fake_tool(name: "rustc", lines: ["echo 'rustc 1.93.0 (fixture)'", "echo 'host: aarch64-unknown-linux-gnu'"]),
    fake_tool(name: "cargo", lines: ["echo 'cargo 1.93.0 (fixture)'"]),
    fake_tool(name: "cc", lines: ["echo 'cc (fixture) 14'"]),
    fake_tool(name: "ld", lines: ["echo 'GNU ld (fixture) 2.44'"]),
    fake_tool(name: "ldd", lines: ["echo 'ldd (fixture) 2.41'"]),
  ])
}

// Fake pack members, only for the claims whose subject is a pack.
fn fixture_members() -> List<Node> {
  [
    bash_build_with_redir_to_file(
      inner: bash_build_pipe(
        left: cmdl(ls: ["printf", "#!/bin/sh\nexit 0\n"]),
        right: cmd(ws: concat([fx(t: "tee")], map(ci_floor_required_artifact_names(), m => fx(t: join(["target/release/", m], ""))))),
      ),
      path: fx(t: "/dev/null"),
    ),
    cmd(ws: concat([fx(t: "chmod"), fx(t: "+x")], map(ci_floor_required_artifact_names(), m => fx(t: join(["target/release/", m], ""))))),
  ]
}

// THE KEY IS SUPPLIED, NOT RE-DERIVED, for claims whose subject is downstream of it (DESIGN section 3,
// a witness discriminates at one interface): a preimage naming this checkout's source closure is
// written where the key runner would write it, and the key is its digest, so the pack, restore,
// consumer and lookup runners see exactly the inputs the key runner hands them. The key runner's own
// behaviour is the subject of the key claims below, which execute it for real.
fn supplied_key() -> List<Node> {
  seq(parts: [
    [assign_sub(name: "ROOT", body: cmdl(ls: ["git", "rev-parse", "--show-toplevel"]))],
    source_closure_statements(),
    [
      bash_build_assign(name: "EXPECTED", value: words(ws: [var(n: "RUNNER_TEMP"), fx(t: join(["/", release_bins_preimage_name, ".expected"], ""))])),
      bash_build_with_redir_to_file(
        inner: cmd(ws: [fx(t: "printf"), fx(t: "kind=fixture\nsource_closure=%s\n"), var(n: "SOURCE_CLOSURE")]),
        path: var(n: "EXPECTED"),
      ),
      bash_build_with_redir_to_file(inner: cmd(ws: [fx(t: "sha256sum"), var(n: "EXPECTED")]), path: in_t(path: "/preimage.sum")),
      assign_sub(name: "SUPPLIED_DIGEST", body: cmd(ws: [fx(t: "cut"), fx(t: "-c"), fx(t: "1-64"), in_t(path: "/preimage.sum")])),
      cmd(ws: [fx(t: "export"), words(ws: [fx(t: "RELEASE_BINS_KEY=release-bins-"), var(n: "SUPPLIED_DIGEST")])]),
    ],
  ])
}

// Produce: key, then pack the fixture members, then keep the entry as the store.
fn produced_store() -> List<Node> {
  seq(parts: [
    fixture_env(),
    fixture_members(),
    supplied_key(),
    release_bins_pack_statements(product: fleet_release_bins_product()),
    [cmd(ws: [fx(t: "cp"), fx(t: "-r"), fx(t: release_bins_staging_dir), in_t(path: "/store")])],
  ])
}

// Repack the stored archive after `edit` (statements run with the members extracted in $T/re).
fn repack(edit: List<Node>, names: List<String>) -> List<Node> {
  seq(parts: [
    [
      cmd(ws: [fx(t: "mkdir"), fx(t: "-p"), in_t(path: "/re")]),
      cmd(ws: [fx(t: "tar"), fx(t: "-xzf"), in_t(path: join(["/store/", ci_release_bins_archive_name], "")), fx(t: "-C"), in_t(path: "/re")]),
    ],
    edit,
    [cmd(ws: concat([fx(t: "tar"), fx(t: "-czf"), in_t(path: join(["/store/", ci_release_bins_archive_name], "")), fx(t: "-C"), in_t(path: "/re")], map(names, n => fx(t: n))))],
  ])
}

// A CLAIM JOINS ALREADY-EMITTED PARTS. Every part below is emitted once as module data -- the fixture,
// the runners, each mutation -- so the fold's cost is shared across claims and a claim's own work is
// joining texts and running them (the required floor judges new witnesses on that marginal work).
fn run_script(script: TransportScript?) -> ShellRun {
  match script {
    Present { value: script } => {
      let r = shell.Exec.Run(script: script, expect: ExpectFailure)
      ShellRun { ran: true, success: r.success, stdout: r.stdout }
    }
    Absent => ShellRun { ran: false, success: false, stdout: "" }
  }
}

type ShellRun { ran: Bool, success: Bool, stdout: String }

fn refused_as(script: TransportScript?, refusal: String) -> Bool {
  let r = run_script(script: script)
  r.ran && !r.success && string_contains(s: r.stdout, pattern: join(["title=release-bins ", refusal, "::"], ""))
}

fn succeeded_with(script: TransportScript?, marker: String) -> Bool {
  let r = run_script(script: script)
  r.ran && r.success && string_contains(s: r.stdout, pattern: marker)
}

fn e(statements: List<Node>) -> Outcome<String> { release_bins_emitted(statements: statements) }

// ── THE SHARED PARTS, each emitted once ────────────────────────────────────────────────────────
data part_produced_store: Outcome<String> = e(statements: produced_store())
data part_fixture: Outcome<String> = e(statements: fixture())
data part_fixture_env: Outcome<String> = e(statements: fixture_env())
data part_key: Outcome<String> = e(statements: release_bins_key_statements(product: fleet_release_bins_product()))
data part_restore_prep: Outcome<String> = e(statements: [
  cmd(ws: [fx(t: "rm"), fx(t: "-rf"), fx(t: release_bins_staging_dir), fx(t: "target")]),
  cmd(ws: [fx(t: "cp"), fx(t: "-r"), in_t(path: "/store"), fx(t: release_bins_staging_dir)]),
  cmdl(ls: ["export", "LOOKUP_STANDING=present", "LOOKUP_ENTRY=fixture", "CACHE_HIT=true"]),
])
data part_outcome: Outcome<String> = e(statements: release_bins_outcome_statements(product: fleet_release_bins_product()))
// THE DOWNLOAD LANDS WHERE THE DOWNLOAD STEP PUTS IT, under the runner temp root, and never in the
// checkout (gunbc.fleet_release_bins_key release_bins_download_dir). The positive control therefore
// also shows that the consumer reads from there: a consumer reading the checkout root finds nothing and
// refuses ConsumerFileMissing.
data part_consume_prep: Outcome<String> = e(statements: [
  cmd(ws: [fx(t: "rm"), fx(t: "-rf"), fx(t: "target")]),
  cmd(ws: [fx(t: "mkdir"), fx(t: "-p"), words(ws: [var(n: "RUNNER_TEMP"), fx(t: join(["/", release_bins_download_dir], ""))])]),
  cmd(ws: [fx(t: "cp"), in_t(path: join(["/store/", release_bins_preimage_name], "")), in_t(path: join(["/store/", release_bins_manifest_name], "")), in_t(path: join(["/store/", ci_release_bins_archive_name], "")), words(ws: [var(n: "RUNNER_TEMP"), fx(t: join(["/", release_bins_download_dir, "/"], ""))])]),
])
data part_consumer: Outcome<String> = e(statements: release_bins_consumer_statements(product: fleet_release_bins_product()))
data part_supplied_key: Outcome<String> = e(statements: supplied_key())
data part_decode: Outcome<String> = e(statements: concat(
  concat([cmdl(ls: ["export", "STANDING=absent", "ENTRY=none"])], lookup_decode_statements(r: release_bins_main_lookup_ref())),
  [cmd(ws: [fx(t: "echo"), words(ws: [fx(t: "decoded standing="), var(n: "STANDING")])])],
))
// THE ENVIRONMENT CLAIMS' SUBJECT IS THE ENVIRONMENT READ: the preimage carries its digest verbatim
// (environment=sha256:<digest>), so two environments key apart exactly when their digests differ.
data part_environment: Outcome<String> = e(statements: concat(
  [assign_sub(name: "ROOT", body: cmdl(ls: ["git", "rev-parse", "--show-toplevel"]))],
  release_bins_environment_statements(),
))
data part_first_key: Outcome<String> = e(statements: [
  bash_build_with_redir_to_file(inner: cmd(ws: [fx(t: "echo"), var(n: "AXIS_ENVIRONMENT_DIGEST")]), path: in_t(path: "/key1")),
])
data part_second_key_compare: Outcome<String> = e(statements: [
  bash_build_with_redir_to_file(inner: cmd(ws: [fx(t: "echo"), var(n: "AXIS_ENVIRONMENT_DIGEST")]), path: in_t(path: "/key2")),
  bash_build_if_else(
    cond: cmd(ws: [fx(t: "cmp"), fx(t: "-s"), in_t(path: "/key1"), in_t(path: "/key2")]),
    then_body: bash_build_stmt_list_from_nodes(stmts: [cmdl(ls: ["echo", "keys equal"])]),
    else_body: bash_build_stmt_list_from_nodes(stmts: [cmdl(ls: ["echo", "keys differ"])]),
  ),
])

fn restore_after(mutation: Outcome<String>) -> List<Outcome<String>> {
  [part_produced_store, mutation, part_restore_prep, part_outcome]
}

fn consume_after(mutation: Outcome<String>) -> List<Outcome<String>> {
  [part_produced_store, mutation, part_consume_prep, part_consumer]
}

fn key_twice(first: Outcome<String>, second: Outcome<String>) -> List<Outcome<String>> {
  [part_fixture, first, part_environment, part_first_key, second, part_environment, part_second_key_compare]
}

fn decode_answer(body: Outcome<String>) -> List<Outcome<String>> {
  [part_fixture_env, part_supplied_key, body, part_decode]
}

fn answer_body(body: String) -> Outcome<String> {
  e(statements: [bash_build_with_redir_to_file(inner: cmdl(ls: ["printf", "%s", body]), path: fx(t: release_bins_lookup_file(r: release_bins_main_lookup_ref())))])
}

fn exports(assignments: List<String>) -> Outcome<String> {
  e(statements: [cmdl(ls: concat(["export"], assignments))])
}

data part_no_mutation: Outcome<String> = e(statements: [cmdl(ls: [":", "no-op"])])

// Each claim's complete script is its own datum, so the join is shared fill and a claim's own work
// is running the script and reading its output.
data script_registry_token: TransportScript? = release_bins_transport(parts: [part_fixture, env_registry_token, part_key])
data script_named_registry_token: TransportScript? = release_bins_transport(parts: [part_fixture, env_named_registry_token, part_key])
data script_partial_print_rustc: TransportScript? = release_bins_transport(parts: [part_fixture, env_partial_print_rustc, part_key])
data script_restore_positive_promotes_verified_members: TransportScript? = release_bins_transport(parts: restore_after(mutation: part_no_mutation))
data script_consumer_positive_promotes_verified_members: TransportScript? = release_bins_transport(parts: consume_after(mutation: part_no_mutation))
data script_RED_restore_malformed_manifest_line_with_altered_member_refuses: TransportScript? = release_bins_transport(parts: restore_after(mutation: mutation_malformed_line_and_altered_gunbc))
data script_RED_consumer_malformed_manifest_line_with_altered_member_refuses: TransportScript? = release_bins_transport(parts: consume_after(mutation: mutation_malformed_line_and_altered_gunbc))
data script_RED_restore_altered_member_with_valid_manifest_refuses: TransportScript? = release_bins_transport(parts: restore_after(mutation: mutation_altered_gunbc))
data script_RED_restore_symlink_member_refuses: TransportScript? = release_bins_transport(parts: restore_after(mutation: mutation_symlinked_gunbc_with_matching_digest))
data script_RED_consumer_symlink_member_refuses: TransportScript? = release_bins_transport(parts: consume_after(mutation: mutation_symlinked_gunbc_with_matching_digest))
data script_RED_restore_extra_member_refuses: TransportScript? = release_bins_transport(parts: restore_after(mutation: mutation_extra_member))
data script_RED_consumer_extra_member_refuses: TransportScript? = release_bins_transport(parts: consume_after(mutation: mutation_extra_member))
data script_RED_restore_duplicate_member_refuses: TransportScript? = release_bins_transport(parts: restore_after(mutation: mutation_duplicate_member))
data script_RED_consumer_duplicate_member_refuses: TransportScript? = release_bins_transport(parts: consume_after(mutation: mutation_duplicate_member))
data script_lookup_valid_empty_answer_is_absence: TransportScript? = release_bins_transport(parts: decode_answer(body: body_valid_empty))
data script_RED_lookup_count_without_rows_refuses: TransportScript? = release_bins_transport(parts: decode_answer(body: body_count_without_rows))
data script_RED_lookup_truncated_answer_refuses: TransportScript? = release_bins_transport(parts: decode_answer(body: body_truncated))
data script_RED_lookup_count_disagreeing_with_rows_refuses: TransportScript? = release_bins_transport(parts: decode_answer(body: body_count_disagreeing))
data script_RED_lookup_wrong_shape_row_refuses: TransportScript? = release_bins_transport(parts: decode_answer(body: body_wrong_shape_row))
data script_RED_lookup_value_stream_refuses: TransportScript? = release_bins_transport(parts: decode_answer(body: body_value_stream))
data script_RED_lookup_two_documents_refuses: TransportScript? = release_bins_transport(parts: decode_answer(body: body_two_documents))
data script_unchanged_inputs_key_equally: TransportScript? = release_bins_transport(parts: key_twice(first: env_none, second: env_none))
data script_release_opt_level_override_changes_the_key: TransportScript? = release_bins_transport(parts: key_twice(first: env_opt_level_0, second: env_opt_level_3))
data script_multiline_rustflags_keys_apart_from_its_first_line: TransportScript? = release_bins_transport(parts: key_twice(first: env_rustflags_one_line, second: env_rustflags_two_lines))
data script_RED_compiler_override_refuses: TransportScript? = release_bins_transport(parts: [part_fixture, env_rustc_override, part_key])
data script_RED_ancestor_cargo_config_refuses: TransportScript? = release_bins_transport(parts: [part_fixture, env_ancestor_config, part_key])

// ── P1-1: a malformed manifest line cannot hide an altered member ──────────────────────────────
data malformed_gunbc_line_edit: String = "s/^[0-9a-f]{64}  gunbc$/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx  gunbc/"

data mutation_malformed_line_and_altered_gunbc: Outcome<String> = e(statements: concat(
  [cmd(ws: [fx(t: "sed"), fx(t: "-i"), fx(t: "-E"), fx(t: malformed_gunbc_line_edit), in_t(path: join(["/store/", release_bins_manifest_name], ""))])],
  repack(edit: [write_file(path: in_t(path: "/re/gunbc"), lines: ["#!/bin/sh", "echo altered"])], names: ci_floor_required_artifact_names()),
))

data mutation_altered_gunbc: Outcome<String> = e(statements: repack(
  edit: [write_file(path: in_t(path: "/re/gunbc"), lines: ["#!/bin/sh", "echo altered"])],
  names: ci_floor_required_artifact_names(),
))

test fn release_bins_restore_positive_promotes_verified_members() -> Bool  {
  succeeded_with(script: script_restore_positive_promotes_verified_members, marker: "ReleaseBinsReuseReceipt")
}

test fn release_bins_consumer_positive_promotes_verified_members() -> Bool  {
  succeeded_with(script: script_consumer_positive_promotes_verified_members, marker: "")
}

test fn release_bins_RED_restore_malformed_manifest_line_with_altered_member_refuses() -> Bool  {
  refused_as(script: script_RED_restore_malformed_manifest_line_with_altered_member_refuses, refusal: "ManifestMalformed")
}

test fn release_bins_RED_consumer_malformed_manifest_line_with_altered_member_refuses() -> Bool  {
  refused_as(script: script_RED_consumer_malformed_manifest_line_with_altered_member_refuses, refusal: "ManifestMalformed")
}

test fn release_bins_RED_restore_altered_member_with_valid_manifest_refuses() -> Bool  {
  refused_as(script: script_RED_restore_altered_member_with_valid_manifest_refuses, refusal: "MemberDigestMismatch")
}

// ── P1-2: the pack is exactly the roster of self-contained executable regular files ─────────────
// The link's target is a copy of the member's own bytes, so its digest already matches the manifest:
// only the member's TYPE is wrong, which is exactly what the claim exists to discriminate.
data mutation_symlinked_gunbc_with_matching_digest: Outcome<String> = e(statements: repack(
  edit: [
    cmd(ws: [fx(t: "cp"), in_t(path: "/re/gunbc"), in_t(path: "/outside")]),
    cmd(ws: [fx(t: "rm"), in_t(path: "/re/gunbc")]),
    cmd(ws: [fx(t: "ln"), fx(t: "-s"), in_t(path: "/outside"), in_t(path: "/re/gunbc")]),
  ],
  names: ci_floor_required_artifact_names(),
))

data mutation_extra_member: Outcome<String> = e(statements: repack(
  edit: [write_file(path: in_t(path: "/re/extra"), lines: ["#!/bin/sh"]), cmd(ws: [fx(t: "chmod"), fx(t: "+x"), in_t(path: "/re/extra")])],
  names: concat(ci_floor_required_artifact_names(), ["extra"]),
))

data mutation_duplicate_member: Outcome<String> = e(statements: repack(edit: [], names: concat(ci_floor_required_artifact_names(), ["gunbc"])))

test fn release_bins_RED_restore_symlink_member_refuses() -> Bool  {
  refused_as(script: script_RED_restore_symlink_member_refuses, refusal: "MemberNotRegularFile")
}

test fn release_bins_RED_consumer_symlink_member_refuses() -> Bool  {
  refused_as(script: script_RED_consumer_symlink_member_refuses, refusal: "MemberNotRegularFile")
}

test fn release_bins_RED_restore_extra_member_refuses() -> Bool  {
  refused_as(script: script_RED_restore_extra_member_refuses, refusal: "PackListingNotRoster")
}

test fn release_bins_RED_consumer_extra_member_refuses() -> Bool  {
  refused_as(script: script_RED_consumer_extra_member_refuses, refusal: "PackListingNotRoster")
}

test fn release_bins_RED_restore_duplicate_member_refuses() -> Bool  {
  refused_as(script: script_RED_restore_duplicate_member_refuses, refusal: "PackListingNotRoster")
}

test fn release_bins_RED_consumer_duplicate_member_refuses() -> Bool  {
  refused_as(script: script_RED_consumer_duplicate_member_refuses, refusal: "PackListingNotRoster")
}

// ── P2-3: only one complete, admitted-shape cache-API answer decides standing ───────────────────
data body_valid_empty: Outcome<String> = answer_body(body: "{\"total_count\":0,\"actions_caches\":[]}")
data body_count_without_rows: Outcome<String> = answer_body(body: "{\"total_count\": 1}")
data body_truncated: Outcome<String> = answer_body(body: "{\"total_count\": 1,")
data body_count_disagreeing: Outcome<String> = answer_body(body: "{\"total_count\": 1, \"actions_caches\": []}")
data body_wrong_shape_row: Outcome<String> = answer_body(body: "{\"total_count\":1,\"actions_caches\":[{\"x\":{\"key\":\"k\"},\"key\":5,\"ref\":\"refs/heads/main\"}]}")
data body_value_stream: Outcome<String> = answer_body(body: "\"absent\"\n\"present\"")
data body_two_documents: Outcome<String> = answer_body(body: "{\"total_count\":0,\"actions_caches\":[]}\n{\"total_count\":0,\"actions_caches\":[]}")

