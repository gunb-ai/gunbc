module test.claim.long.reference_closure_equivalence

import std.dissolution { DissolutionCondition, unbound_dissolution }

import v2.lens.module_graph { no_paths, module_graph_exclude_substrings }
import gunbc.ci_layer_roots { witness_layer_roots }

// The entry imports only v2.std.node, so its closure is v2.std.node's import closure. Re-derived
// 2026-10-01 from v2.lens.module_graph dependency_closure_live_excluding (import facts plus
// collector-derived edges) at gunbc#12910. The previous golden listed an older, wider import envelope
// (std.primitives, v2.std.algebra, collection, diagnostic, logic, node_query, witness) that the entry no
// longer imports; it went stale unseen because this module did not resolve (witness_layer_roots was
// used bare). Each member below is reached by a declared import edge:
//   v2.std.node                        <- the entry
//   std.algebra, v2.std.optional, std.occurrence_identity, std.decl_ref, std.disposition,
//   std.content_hash                   <- v2.std.node
//   std.error_primitives, std.dissolution, std.types
//                                      <- reached transitively from v2.std.node's imports
data expected_conformance_closure: FreeMonoid<String> = [
  "dag/test/claim/module_graph/conformance_imports_only.dag",
  "src/v2/std/node.dag",
  "dag/std/algebra.dag",
  "src/v2/std/optional.dag",
  "dag/std/occurrence_identity.dag",
  "dag/std/decl_ref.dag",
  "dag/std/disposition.dag",
  "dag/std/content_hash.dag",
  "dag/std/error_primitives.dag",
  "dag/std/dissolution.dag",
  "dag/std/types.dag"
]

data conformance_entry: String = "dag/test/claim/module_graph/conformance_imports_only.dag"

data conformance_import_envelope_disposition: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "v2.test.manual.coproduct_reflection_conformance",
    decl_name: "reflect_connective_type",
    field: WholeDeclaration
  }
}

data conformance_import_envelope_dissolution_note: String = "conformance_imports_only.dag mirrors coproduct_reflection_conformance_test.dag import envelope only (no extra imports — closure goldens stay byte-identical). v2 parse_module rejects test fn bodies today, so equivalence gates use this pipeline-parseable stub. Dissolves when parse_module accepts fn bodies (repoint conformance_entry to src/v2/test/claim/manual/coproduct_reflection_conformance_test.dag) or when a shared import-envelope fixture subsumes both."

data bogus_never_referenced: String = "src/v2/std/__bogus_never_referenced__.dag"

// B2 safety wall (operator, sharp-bee-290): resolution RESULTS are preserved when the module graph
// is derived from reference sites instead of import declarations. reference_closure_live reads the
// one edge producer (v2.lens.module_graph dependency_resolution_facts_live: import facts plus
// collector-derived references) and must match the declared golden here and import_closure_live
// (witnessed in import_closure_live_test.dag on the same golden).
// reference_dependency_facts_match_import_facts_at_path on the conformance entry checks that the
// producer's edges for that entry name exactly its imports. The parse-tree census that used to
// stand here was retired with v2.lens.reference_deps reference_sites_from_parsed_module. Drift
// control and import/reference mismatch RED controls are folded into
// reference_closure_b2_safety_wall_holds.

fn string_eq(a: String, b: String) -> Bool {
  a == b
}

fn set_subset(xs: FreeMonoid<String>, ys: FreeMonoid<String>) -> Bool {
  for_all(xs: xs, predicate: fn(x) { contains(xs: ys, item: x, eq: string_eq) })
}

fn set_equal(xs: FreeMonoid<String>, ys: FreeMonoid<String>) -> Bool {
  set_subset(xs: xs, ys: ys) && set_subset(xs: ys, ys: xs)
}

fn import_conformance_closure() -> FreeMonoid<String> {
  import_closure_live(entry_path: conformance_entry, pool_roots: witness_layer_roots)
}

fn reference_conformance_closure_outcome() -> Outcome<FreeMonoid<String>> {
  v2.lens.reference_deps.reference_closure_live(entry_path: conformance_entry, pool_roots: witness_layer_roots)
}

test fn reference_closure_b2_safety_wall_holds() -> Bool {
  let parsed_entry_census_ok = v2.lens.reference_deps.reference_dependency_facts_match_import_facts_at_path(
    rel_path: conformance_entry,
    pool_roots: witness_layer_roots,
    exclude_substrings: module_graph_exclude_substrings
  )
  match v2.lens.reference_deps.reference_closure_ingest_refusal_witness() {
    Rejected { diagnostics: _ } =>
      match reference_conformance_closure_outcome() {
        Accepted { value: reference_closure, diagnostics: _ } =>
          let with_bogus = list_snoc_item(xs: expected_conformance_closure, item: bogus_never_referenced)
          let declared_without_entry = fold_list(
            xs: expected_conformance_closure,
            empty: no_paths,
            cons: fn(acc, p) {
              if string_eq(a: p, b: conformance_entry) {
                acc
              } else {
                list_snoc_item(xs: acc, item: p)
              }
            }
          )
          parsed_entry_census_ok
            && set_equal(xs: import_conformance_closure(), ys: declared_without_entry) == false
            && set_equal(xs: reference_closure, ys: expected_conformance_closure)
            && set_equal(xs: reference_closure, ys: with_bogus) == false
        Rejected { diagnostics: _ } => false
      }
    Accepted { value: _, diagnostics: _ } => false
  }
}

data conformance_import_envelope_dissolve_on: DissolutionCondition = unbound_dissolution(description: "v2 parse_module accepts test fn bodies, at which point the equivalence gates stop needing the import-envelope-only mirror conformance_imports_only.dag and it deletes with this row")
