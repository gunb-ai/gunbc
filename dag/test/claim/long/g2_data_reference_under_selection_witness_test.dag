module test.claim.long.g2_data_reference_under_selection_witness_test

// Expected-red control for G2 under-selection through data declarations
// (work item adhoc-8026d859-7e4).
//
// INVALID STATE: a witness body that reaches a live-read carrier only through a
// DATA declaration's initializer — here, scaffold_disposition_census_fixture_pool_is_nonempty
// -> scaffold_disposition_census_pool_facts -> decl_facts — is classified as if it
// did not read the tree. G2's walk population is List<FnArrowDecl>, so the data hop
// is never followed and the carrier is invisible.
//
// WHY LocalRead (not Refused) IS THE HARM: LocalRead is the strongest "safe to skip"
// verdict the selection seam has. On 341d3203bc2 the live path returned
// LiveReadSelectionClassified { LocalRead }, not LiveReadSelectionRefused — measured
// by a discriminating triple that is NOT enrolled here (LocalRead-as-contract would
// enshrine the defect; DESIGN §5 / floor_witness_run_disposition). Refused would have
// been fail-closed and licensed nothing; LocalRead licenses a skip and presents as a
// faster green floor. That is under-selection.
//
// DISSOLVE-ON: when computation reachability follows data initializers as well as
// function bodies, this witness goes green; its ExplicitWitnessAdmission
// QuarantineProbeExpectRed row deletes in the same change (un-quarantine); the
// unchanged witness remains as the permanent regression control (DESIGN §4b(4)).


data g2_data_reference_under_selection_note: String = "Asserts the DESIRED classification: the specimen is a runtime/live read because its body reaches decl_facts through a data initializer. Observed on 341d3203bc2 (includes #8140): LiveReadSelectionClassified { LocalRead } via v2.lens.live_read_classification.live_read_selection_manifest_live — not Refused. That LocalRead licenses a skip today; this witness therefore fails until the traversal repair lands, and is admitted QuarantineProbeExpectRed / ExpectAssertionFalse so the red is agreement rather than ambient discovery failure.

POOL NARROWING (cost, stated rather than silent): specimen_pool_roots is [dag/test/claim, dag/test/fixture/scaffold_disposition_census], not the production whole pool [dag, src/v2]. v2.lens.live_read_classification.live_read_selection_manifest_live still mints WholeTreeFactSubject nullarily — this call does not author a completeness label beside a chosen fact list (whole_tree_subject_mint_site_law). The roots are narrowed for cost: measured eval wall for this specimen at the narrow pool is about 14s (~13953ms wall on release claim_batch), which already exceeds the 5s FastLaneEvalBudget thread-CPU lane and is why the admission row declares SubstrateLongLaneEvalBudget. The claim under test is TRAVERSAL (data declarations absent from the FnArrowDecl walk population), not pool breadth — the specimen entry, its data hop, and the decl_facts callee all live inside the narrowed roots, and carriers match by callee text rather than by home-module membership in the pool. A future reader must treat the narrowing as a stated bound: if a repair ever turns out to be pool-sensitive, re-measure at full pool rather than reading a green here as whole-tree evidence.

FULL-POOL CONFIRMATION (one-shot, not enrolled): the same specimen with pool_roots=[dag, src/v2] also returned LiveReadSelectionClassified { LocalRead } (probe classification_is_local PASS; wall≈214304ms). So the under-selection is not an artifact of the narrow roots. The enrolled witness keeps the narrow pool because ~14s vs ~214s is the cost of what the permanent control needs to prove."

data specimen_entry_path: String = "dag/test/claim/scaffold_disposition_census_fixture_witness_test.dag"

data specimen_fn_name: String = "scaffold_disposition_census_fixture_pool_is_nonempty"

// WHY THIS POOL IS NOT NARROWABLE, so the next reader costing it does not re-derive the answer
// (census 2026-08-18; operator ruling, not authorized on cost grounds).
//
// dag/test/claim is READ -- but for exactly ONE file, this witness's own specimen entry
// (specimen_entry_path). It costs 838 files / 6,643,760 bytes, 99.7% of this pool, and the
// required floor pays it once per ROW because run_required_floor builds a fresh InterpContext per
// claim. That is the largest single waste measured in the pool-roots census.
//
// It is still not worth fixing. The blocker is that pool roots are DIRECTORY-grained
// (corpus_dag_files_for_roots walks a root only `if root_path.is_dir()`), and no directory
// contains this specimen and nothing else. Making a root able to name a file is a change to the
// corpus-walk seam every pool in the repository shares, and the census found it would buy exactly
// this one specimen -- a seam change for a single row. If file-grain roots ever land for an
// independent reason, narrowing this list to the specimen file is a one-line follow-up.
data specimen_pool_roots: List<String> = [
  "dag/test/claim",
  "dag/test/fixture/scaffold_disposition_census"
]

data specimen_requests: List<v2.lens.live_read_classification.LiveReadSelectionRequest> = [
  v2.lens.live_read_classification.LiveReadSelectionRequest {
    entry_path: specimen_entry_path,
    fn_name: specimen_fn_name
  }
]

fn specimen_projection() -> v2.std.live_read.LiveReadSelectionProjection {
  match v2.std.algebra.list_head(
    xs: v2.lens.live_read_classification.live_read_selection_manifest_live(
      requests: specimen_requests,
      pool_roots: specimen_pool_roots,
      importer_roots: specimen_pool_roots,
      exclude_substrings: []
    )
  ) {
    HeadFound { value: row } => row.projection
    HeadAbsent =>
      v2.std.live_read.LiveReadSelectionRefused {
        cause: "manifest produced no rows for the specimen request"
      }
  }
}

test fn specimen_classifies_as_runtime_read() -> Bool {
  match specimen_projection() {
    LiveReadSelectionClassified { classification: c } =>
      v2.lens.live_read_classification.classification_has_runtime_read(classification: c)
    LiveReadSelectionRefused { cause: _ } => false
  }
}

// THE DISCRIMINATING HALF OF THE PAIR, and the reason one witness was not enough.
// specimen_classifies_as_runtime_read is false in TWO states that are opposites on
// the safety axis: Classified{LocalRead}, which is the strongest safe-to-skip verdict
// the selection seam has and is therefore the harm, and Refused, which is fail-closed
// and licenses nothing. A single Bool cannot separate them, so on its own the
// UNDER-selection claim would rest on the note beside it — and no Accepted program can
// read a note (DESIGN 4c). This claim carries the other bit, so the pair has a unique
// signature per reachable state:
//
//   Classified{LocalRead}   -> (false, false)  today; both red, so the red is agreement
//   Classified{RuntimeRead} -> (true,  true)   after the traversal repair; both rows delete
//   Refused{cause}          -> (false, true)   this claim greens ALONE
//
// That third row is why the polarity is worth the second evaluation: a drift from
// LocalRead to Refused is a real change of state with a different remedy, and it would
// otherwise be invisible because the first claim stays red either way. Greening alone
// makes it a StaleKnownRed refusal against its own admission row, which is the loud,
// typed, located signal the floor already knows how to route.
//
// It is admitted expected-red rather than landing as an ordinary green witness because
// it costs the same ~14s evaluation as its sibling, and the long-eval budget is coupled
// to expected-red across today's population (exact_witness_admission_witness_test
// every_declared_long_budget_row_is_also_expected_red_today). Asserting the desired
// state keeps this inside that population instead of retiring that claim.
test fn specimen_does_not_classify_as_local_read() -> Bool {
  match specimen_projection() {
    LiveReadSelectionClassified { classification: c } =>
      match c {
        LocalRead => false
        RuntimeRead { carriers: _ } => true
      }
    LiveReadSelectionRefused { cause: _ } => true
  }
}
