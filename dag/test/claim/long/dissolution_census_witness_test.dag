module test.claim.long.dissolution_census_witness_test

// Breadth-preserving half of the dissolution-census split (DESIGN.md
// "witness cost derives from purpose", operator ruling 2026-08-04): the
// fold_frontier_expiry mechanism and the construction-wall checks are proven
// on a planted fixture, per-PR, in
// test.claim.dissolution_census_mechanism_witness_test. This file carries
// only the properties whose subject IS the live census_closure_frontier_rows
// roster and cannot be proven on synthetic data. Enrolled on the falsifier
// FalsifierSubstrateLongLane cadence (gunbc.ci_layer_roots
// falsifier_substrate_long_lane_rows), not per-PR fast-lane discovery.
import gunbc.census_closure_frontier { census_closure_frontier_rows }
import gunbc.dissolution_census {
  dissolution_census_report,
  dissolution_census_holds,
  dissolution_census_total,
  frontier_rows_bound_count,
}
import std.roster_frontier { frontier_rows_well_formed }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn census_counters_exhaustively_partition_the_rows() -> Bool {
  let r = dissolution_census_report()
  (r.unbound_count + r.pending_count + r.fired_still_present_count) == length(xs: census_closure_frontier_rows())
}

test fn bound_and_unbound_partition_the_same_rows() -> Bool {
  let r = dissolution_census_report()
  let bound = frontier_rows_bound_count(rows: census_closure_frontier_rows())
  bound == (r.pending_count + r.fired_still_present_count)
    && (bound + r.unbound_count) == dissolution_census_total()
}

test fn census_holds_on_the_live_roster() -> Bool {
  dissolution_census_holds()
    && frontier_rows_well_formed(rows: census_closure_frontier_rows())
}

test fn nothing_is_fired_and_still_present_today() -> Bool {
  dissolution_census_report().fired_still_present_count == 0
}
