module test.claim.long.dissolution_census_witness_test

// Breadth-preserving half of the dissolution-census split (DESIGN.md
// "witness cost derives from purpose", operator ruling 2026-08-04): the
// fold_frontier_expiry mechanism and the construction-wall checks are proven
// on a planted fixture, per-PR, in
// test.claim.dissolution_census_mechanism_witness_test. This file carries
// only the properties whose subject IS the live gunbc.census_closure_frontier.census_closure_frontier_rows
// roster and cannot be proven on synthetic data. Enrolled on the falsifier
// FalsifierSubstrateLongLane cadence (gunbc.ci_layer_roots
// falsifier_substrate_long_lane_rows), not per-PR fast-lane discovery.

data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

test fn census_counters_exhaustively_partition_the_rows() -> Bool {
  let r = gunbc.dissolution_census.dissolution_census_report()
  (r.unbound_count + r.pending_count + r.fired_still_present_count) == length(xs: gunbc.census_closure_frontier.census_closure_frontier_rows())
}

test fn bound_and_unbound_partition_the_same_rows() -> Bool {
  let r = gunbc.dissolution_census.dissolution_census_report()
  let bound = gunbc.dissolution_census.frontier_rows_bound_count(rows: gunbc.census_closure_frontier.census_closure_frontier_rows())
  bound == (r.pending_count + r.fired_still_present_count)
    && (bound + r.unbound_count) == gunbc.dissolution_census.dissolution_census_total()
}

test fn census_holds_on_the_live_roster() -> Bool {
  gunbc.dissolution_census.dissolution_census_holds()
    && std.roster_frontier.frontier_rows_well_formed(rows: gunbc.census_closure_frontier.census_closure_frontier_rows())
}

test fn nothing_is_fired_and_still_present_today() -> Bool {
  gunbc.dissolution_census.dissolution_census_report().fired_still_present_count == 0
}
