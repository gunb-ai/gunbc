module test.claim.long.namespace_graft_body_dissolution_witness_test

import v2.std.text { String }
import v2.std.logic { Bool }
import v2.std.algebra { fold_list }
import v2.std.collection { Absent, List, Present, optional_absent, optional_present }
import v2.std.node { Node, Symbol }
import v2.std.grammar { ParseTree, node_atom_identity_optional }
import v2.std.diagnostic { Diagnostic, NonEmptyDiagnostics }
import v2.std.compilers.lexing { lex_artifact_semantic_tokens }
import v2.compiler.tokenize { lex_walk_artifact }
import v2.compiler.parse { parse_module, ParseArtifact }
import v2.compiler.normalize { normalize }
import v2.extdeps.languages.dag { dag_lex_rules, dag_grammar }

// Empty flatten with surviving top-level-item alternatives reconstructs a declaration forest
// (operator ruling msg_d18a55de). Type-only and type+fn source must ACCEPT through tokenize/parse/
// normalize and must not carry namespace_graft_body_dissolved_refused. Header-only still accepts.
// Lost forest (top_level_item wrapper, no unit) still refuses — that RED is the synthetic in
// graft_shape_test, because source cannot author a unit-less wrapper.

fn artifact_tree(artifact: ParseArtifact) -> ParseTree {
  artifact.tree
}

// The graft rejection flows through rejected_with_pending, which PREPENDS the pending
// accepted-carrier diagnostics (wrapper-retained bodies) to the rejection — the head-masking shape
// the sweep's first_located_cause already skips. The assertion is therefore containment: the
// refusal CARRIES the guard's typed reason, wherever the pending carriers put it.
fn rejection_reasons(source: String) -> List<Symbol> {
  match lex_walk_artifact(source: chars(s: source), file: ^graft_guard_probe, rules: dag_lex_rules()) {
    v2.std.diagnostic.Rejected { diagnostics: _ } => no_reasons()
    v2.std.diagnostic.Accepted { value: a, diagnostics: _ } =>
      match parse_module(tokens: lex_artifact_semantic_tokens(artifact: a), grammar: dag_grammar()) {
        v2.std.diagnostic.Rejected { diagnostics: _ } => no_reasons()
        v2.std.diagnostic.Accepted { value: artifact, diagnostics: _ } =>
          match normalize(parse_tree: artifact_tree(artifact: artifact)) {
            v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => no_reasons()
            v2.std.diagnostic.Rejected { diagnostics: d } => all_reasons(d: d)
          }
      }
  }
}

fn no_reasons() -> List<Symbol> {
  []
}

fn diagnostic_reason(d: Diagnostic) -> Symbol {
  d.reason
}

fn all_reasons(d: NonEmptyDiagnostics) -> List<Symbol> {
  fold_list(xs: d.tail, empty: [diagnostic_reason(d: d.head)], cons: fn(acc, item) {
    concat(acc, [diagnostic_reason(d: item)])
  })
}

fn reasons_contain(reasons: List<Symbol>, sym: Symbol) -> Bool {
  fold_list(xs: reasons, empty: false, cons: fn(acc, r) {
    acc || (r == sym)
  })
}

fn normalize_accepts(source: String) -> Bool {
  match lex_walk_artifact(source: chars(s: source), file: ^graft_guard_probe, rules: dag_lex_rules()) {
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
    v2.std.diagnostic.Accepted { value: a, diagnostics: _ } =>
      match parse_module(tokens: lex_artifact_semantic_tokens(artifact: a), grammar: dag_grammar()) {
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
        v2.std.diagnostic.Accepted { value: artifact, diagnostics: _ } =>
          match normalize(parse_tree: artifact_tree(artifact: artifact)) {
            v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => true
            v2.std.diagnostic.Rejected { diagnostics: _ } => false
          }
      }
  }
}

fn normalized_tree_optional(source: String) -> Node? {
  match lex_walk_artifact(source: chars(s: source), file: ^graft_guard_probe, rules: dag_lex_rules()) {
    v2.std.diagnostic.Rejected { diagnostics: _ } => optional_absent()
    v2.std.diagnostic.Accepted { value: a, diagnostics: _ } =>
      match parse_module(tokens: lex_artifact_semantic_tokens(artifact: a), grammar: dag_grammar()) {
        v2.std.diagnostic.Rejected { diagnostics: _ } => optional_absent()
        v2.std.diagnostic.Accepted { value: artifact, diagnostics: _ } =>
          match normalize(parse_tree: artifact_tree(artifact: artifact)) {
            v2.std.diagnostic.Rejected { diagnostics: _ } => optional_absent()
            v2.std.diagnostic.Accepted { value: n, diagnostics: _ } => optional_present(value: normalized_root_node(t: n))
          }
      }
  }
}

fn normalized_root_node(t: v2.compiler.normalized_tree.NormalizedTree) -> Node {
  t.root
}

fn tree_contains_atom(n: Node, sym: Symbol) -> Bool {
  match node_atom_identity_optional(node: n) {
    Present { value: id } =>
      match id == sym {
        true => true
        false => children_contain_atom(n: n, sym: sym)
      }
    Absent => children_contain_atom(n: n, sym: sym)
  }
}

fn edge_target_node(e: v2.std.node.Edge) -> Node {
  e.target
}

fn children_contain_atom(n: Node, sym: Symbol) -> Bool {
  fold_list(xs: n.children, empty: false, cons: fn(acc, e) {
    acc || tree_contains_atom(n: edge_target_node(e: e), sym: sym)
  })
}

data mixed_type_fn_source: String = "module graft_guard_probe\n\ntype G1 = A1 | B1\n\nfn g1(x: Int) -> Int { x }\n"

data type_only_source: String = "module m\n\ntype A { x: Int }\n"

data lowered_body_source: String = "module graft_guard_probe\n\ndata d3: LiveTreeDisposition = SubstrateInputsOnly\n\nfn g3() -> List<Int> {\n  fold_list(xs: [1, 2], empty: Empty, cons: fn(acc, item) {\n    list_append(left: [item], right: acc)\n  })\n}\n"

data header_only_source: String = "module graft_guard_probe\n"

test fn witness_type_fn_module_grafts() -> Bool {
  normalize_accepts(source: mixed_type_fn_source)
    && !reasons_contain(
      reasons: rejection_reasons(source: mixed_type_fn_source),
      sym: ^namespace_graft_body_dissolved_refused
    )
}

test fn witness_type_only_module_grafts() -> Bool {
  normalize_accepts(source: type_only_source)
    && !reasons_contain(
      reasons: rejection_reasons(source: type_only_source),
      sym: ^namespace_graft_body_dissolved_refused
    )
}

test fn witness_lowered_body_module_still_grafts() -> Bool {
  normalize_accepts(source: lowered_body_source)
    && (match normalized_tree_optional(source: lowered_body_source) {
      Present { value: n } => tree_contains_atom(n: n, sym: ^list_append)
      Absent => false
    })
}

test fn witness_header_only_module_still_accepts() -> Bool {
  normalize_accepts(source: header_only_source)
}
