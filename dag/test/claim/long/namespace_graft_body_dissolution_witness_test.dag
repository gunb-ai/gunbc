module test.claim.long.namespace_graft_body_dissolution_witness_test


data namespace_graft_body_dissolution_witness_note: String = "The empty-observation narrow refused at the graft (operator ruling msg_d18a55de, 2026-08-10): namespace_graft's body collector dissolved every declaration of a type-decl-carrying module into childless atoms and reported the module as declaration-free — v2.compiler.normalize.normalize then ACCEPTED a hollow module shell, so a loud sugar refusal two commits earlier had become a silent drop (the §4b(3) rung demotion declared in gunbc#8080's body). module_header_containment_graft now REFUSES (namespace_graft_body_dissolved_refused) when the collected body is empty while the pre-graft tree carries top-level declarations. The discriminant is declaration PRESENCE, so a genuinely declaration-free module keeps its legitimate empty body. This guard covers total dissolution only; partial-drop fidelity belongs to the deeper graft repair. Controls: the formerly-hollow shapes now refuse WITH THE EXACT GUARD REASON asserted (discriminating them from the well_formed rejection class), a lowered-body module still grafts and its normalized tree still carries its declarations (asserted non-vacuously), and a header-only module still accepts."

fn artifact_tree(artifact: v2.compiler.parse.ParseArtifact) -> v2.std.grammar.ParseTree {
  artifact.tree
}

// The graft rejection flows through rejected_with_pending, which PREPENDS the pending
// accepted-carrier diagnostics (wrapper-retained bodies) to the rejection — the same
// head-masking shape the sweep's first_located_cause already skips. The assertion is
// therefore containment: the refusal CARRIES the guard's typed reason, wherever the
// pending carriers put it.
fn rejection_reasons(source: String) -> List<v2.std.node.Symbol> {
  match v2.compiler.tokenize.lex_walk_artifact(source: source, file: ^graft_guard_probe, rules: v2.extdeps.languages.dag.dag_lex_rules()) {
    Rejected { diagnostics: _ } => no_reasons()
    Accepted { value: a, diagnostics: _ } =>
      match v2.compiler.parse.parse_module(tokens: v2.std.compilers.lexing.lex_artifact_semantic_tokens(artifact: a), grammar: v2.extdeps.languages.dag.dag_grammar()) {
        Rejected { diagnostics: _ } => no_reasons()
        Accepted { value: artifact, diagnostics: _ } =>
          match v2.compiler.normalize.normalize(parse_tree: test.claim.long.namespace_graft_body_dissolution_witness_test.artifact_tree(artifact: artifact)) {
            Accepted { value: _, diagnostics: _ } => no_reasons()
            Rejected { diagnostics: d } => test.claim.long.namespace_graft_body_dissolution_witness_test.all_reasons(d: d)
          }
      }
  }
}

fn no_reasons() -> List<v2.std.node.Symbol> {
  []
}

fn diagnostic_reason(d: v2.std.diagnostic.Diagnostic) -> v2.std.node.Symbol {
  d.reason
}

fn all_reasons(d: v2.std.diagnostic.NonEmptyDiagnostics) -> List<v2.std.node.Symbol> {
  v2.std.algebra.fold_list(xs: d.tail, empty: [test.claim.long.namespace_graft_body_dissolution_witness_test.diagnostic_reason(d: d.head)], cons: fn(acc, item) {
    concat(acc, [test.claim.long.namespace_graft_body_dissolution_witness_test.diagnostic_reason(d: item)])
  })
}

fn reasons_contain(reasons: List<v2.std.node.Symbol>, sym: v2.std.node.Symbol) -> Bool {
  v2.std.algebra.fold_list(xs: reasons, empty: false, cons: fn(acc, r) {
    acc || (r == sym)
  })
}

fn normalize_accepts(source: String) -> Bool {
  match v2.compiler.tokenize.lex_walk_artifact(source: source, file: ^graft_guard_probe, rules: v2.extdeps.languages.dag.dag_lex_rules()) {
    Rejected { diagnostics: _ } => false
    Accepted { value: a, diagnostics: _ } =>
      match v2.compiler.parse.parse_module(tokens: v2.std.compilers.lexing.lex_artifact_semantic_tokens(artifact: a), grammar: v2.extdeps.languages.dag.dag_grammar()) {
        Rejected { diagnostics: _ } => false
        Accepted { value: artifact, diagnostics: _ } =>
          match v2.compiler.normalize.normalize(parse_tree: test.claim.long.namespace_graft_body_dissolution_witness_test.artifact_tree(artifact: artifact)) {
            Accepted { value: _, diagnostics: _ } => true
            Rejected { diagnostics: _ } => false
          }
      }
  }
}

fn normalized_tree_optional(source: String) -> v2.std.node.Node? {
  match v2.compiler.tokenize.lex_walk_artifact(source: source, file: ^graft_guard_probe, rules: v2.extdeps.languages.dag.dag_lex_rules()) {
    Rejected { diagnostics: _ } => v2.std.optional.optional_absent()
    Accepted { value: a, diagnostics: _ } =>
      match v2.compiler.parse.parse_module(tokens: v2.std.compilers.lexing.lex_artifact_semantic_tokens(artifact: a), grammar: v2.extdeps.languages.dag.dag_grammar()) {
        Rejected { diagnostics: _ } => v2.std.optional.optional_absent()
        Accepted { value: artifact, diagnostics: _ } =>
          match v2.compiler.normalize.normalize(parse_tree: test.claim.long.namespace_graft_body_dissolution_witness_test.artifact_tree(artifact: artifact)) {
            Rejected { diagnostics: _ } => v2.std.optional.optional_absent()
            Accepted { value: n, diagnostics: _ } => v2.std.optional.optional_present(value: normalized_root_node(t: n))
          }
      }
  }
}

fn normalized_root_node(t: v2.compiler.normalized_tree.NormalizedTree) -> v2.std.node.Node {
  t.root
}

fn tree_contains_atom(n: v2.std.node.Node, sym: v2.std.node.Symbol) -> Bool {
  match v2.std.grammar.node_atom_identity_optional(node: n) {
    Present { value: id } =>
      match id == sym {
        true => true
        false => children_contain_atom(n: n, sym: sym)
      }
    v2.std.optional.Absent => children_contain_atom(n: n, sym: sym)
  }
}

fn edge_target_node(e: v2.std.node.Edge) -> v2.std.node.Node {
  e.target
}

fn children_contain_atom(n: v2.std.node.Node, sym: v2.std.node.Symbol) -> Bool {
  v2.std.algebra.fold_list(xs: n.children, empty: false, cons: fn(acc, e) {
    acc || tree_contains_atom(n: edge_target_node(e: e), sym: sym)
  })
}

data mixed_type_fn_source: String = "module graft_guard_probe\n\ntype G1 = A1 | B1\n\nfn g1(x: Int) -> Int {\n  let w = x\n  w\n}\n"

data type_only_source: String = "module graft_guard_probe\n\ntype G2 = A2 | B2\n"

data lowered_body_source: String = "module graft_guard_probe\n\ndata d3: LiveTreeDisposition = SubstrateInputsOnly\n\nfn g3() -> List<Int> {\n  v2.std.algebra.fold_list(xs: [1, 2], empty: Empty, cons: fn(acc, item) {\n    list_append(left: [item], right: acc)\n  })\n}\n"

data header_only_source: String = "module graft_guard_probe\n"

test fn witness_type_fn_module_dissolution_refuses_RED() -> Bool {
  test.claim.long.namespace_graft_body_dissolution_witness_test.reasons_contain(reasons: rejection_reasons(source: mixed_type_fn_source), sym: ^namespace_graft_body_dissolved_refused)
}

test fn witness_type_only_module_dissolution_refuses_RED() -> Bool {
  test.claim.long.namespace_graft_body_dissolution_witness_test.reasons_contain(reasons: rejection_reasons(source: type_only_source), sym: ^namespace_graft_body_dissolved_refused)
}

test fn witness_lowered_body_module_still_grafts() -> Bool {
  normalize_accepts(source: lowered_body_source)
    && (match normalized_tree_optional(source: lowered_body_source) {
      Present { value: n } => tree_contains_atom(n: n, sym: ^list_append)
      v2.std.optional.Absent => false
    })
}

test fn witness_header_only_module_still_accepts() -> Bool {
  normalize_accepts(source: header_only_source)
}
